\section*{Majorana Expansion of Two-Particle Operators (Organized Form)}

The operator $H = \frac{1}{2}\sum V_{jklm} a_j^\dagger a_k^\dagger a_l a_m$
expands in Majoranas as:

\subsection*{1. Degree-0 Term ($\mathbf{1}$)}

\begin{equation*}
H_0 = -\frac{1}{32}\sum_{j,k} V_{jkjk} \mathbf{1} 
\end{equation*}

\subsection*{2. Degree-2 Terms ($c_\protect\mu c_\protect\nu$)}

\begin{equation*}
H_2 = -\frac{1}{16}\sum_{j,k,m} \Big[ (V_{jkjm} + V_{kjjm})c_{2k-1}c_{2m-1}
+ (V_{jmjk} + V_{jmkj})c_{2k}c_{2m} \Big]
\end{equation*}

\subsection*{3. Degree-4 Terms ($c_\protect\mu c_\protect\nu c_\protect\rho %
c_\protect\sigma$)}

\begin{align*}
H_{4}=\frac{1}{32}\sum_{j,k,l,m}\Big[& \left\{ \underbrace{%
(V_{jklm}-V_{kjlm}-V_{jkml}+V_{kjml})}%
_{A_{jklm}}c_{2j-1}c_{2k-1}c_{2l-1}c_{2m-1}\right.  \\
+& \underbrace{(V_{jklm}-V_{kjlm}-V_{jkml}+V_{kjml})}%
_{A_{jklm}}c_{2j}c_{2k}c_{2l}c_{2m} \\
+& \underbrace{i(V_{jklm}+V_{kjlm})}_{B_{jklm}}c_{2j-1}c_{2k-1}c_{2l}c_{2m}
\\
-& \underbrace{i(V_{jklm}+V_{jkml})}_{C_{jklm}}c_{2j-1}c_{2k}c_{2l-1}c_{2m}
\\
& \left. \overset{}{+\text{(12 other grouped terms with similar coefficients)%
}}\right\} \Big]
\end{align*}%
\begin{equation*}
H_{4}=\frac{1}{32}\sum_{j,k,l,m}\Bigg[
\end{equation*}

\noindent \textbf{1. Original Terms (4 terms)}:

\begin{itemize}
\item $A_{jklm} \equiv V_{jklm} - V_{kjlm} - V_{jkml} + V_{kjml}$ (fully
antisymmetric)

\item $B_{jklm} \equiv i(V_{jklm} + V_{kjlm})$ (symmetric in $j,k$)

\item $C_{jklm}\equiv i(V_{jklm}+V_{jkml})$ (symmetric in $l,m$) 
\begin{align*}
& 1.\
(V_{jklm}-V_{kjlm}-V_{jkml}+V_{kjml})\,A_{jklm}%
\,c_{2j-1}c_{2k-1}c_{2l-1}c_{2m-1} \\
& 2.\
(V_{jklm}-V_{kjlm}-V_{jkml}+V_{kjml})\,A_{jklm}\,c_{2j}c_{2k}c_{2l}c_{2m} \\
& 3.\ i(V_{jklm}+V_{kjlm})\,B_{jklm}\,c_{2j-1}c_{2k-1}c_{2l}c_{2m} \\
& 4.\ -i(V_{jklm}+V_{jkml})\,C_{jklm}\,c_{2j-1}c_{2k}c_{2l-1}c_{2m}
\end{align*}
\end{itemize}

\noindent\textbf{2. Additional 12 Terms}: 
\begin{align*}
&5.\ i(V_{jklm} + V_{mljk}) \, D_{jklm} \, c_{2j-1}c_{2k}c_{2l}c_{2m-1} \\
&6.\ i(V_{jklm} - V_{mlkj}) \, E_{jklm} \, c_{2j}c_{2k-1}c_{2l-1}c_{2m} \\
&7.\ (V_{jklm} + V_{lmjk} - V_{kjlm} - V_{mlkj}) \, F_{jklm} \,
c_{2j-1}c_{2k}c_{2l-1}c_{2m} \\
&8.\ (V_{jklm} - V_{kjlm} + V_{lmjk} - V_{mlkj}) \, G_{jklm} \,
c_{2j}c_{2k-1}c_{2l}c_{2m-1} \\
&9.\ (V_{jklm} + V_{kjml} - V_{jkml} - V_{kjlm}) \, H_{jklm} \,
c_{2j}c_{2k}c_{2l-1}c_{2m-1} \\
&10.\ (V_{jklm} - V_{kjml} + V_{mljk} - V_{lmkj}) \, I_{jklm} \,
c_{2j-1}c_{2k-1}c_{2l}c_{2m} \\
&11.\ i(V_{jklm} + V_{kjlm} + V_{lmjk} + V_{mlkj}) \, J_{jklm} \,
c_{2j}c_{2k-1}c_{2l-1}c_{2m-1} \\
&12.\ i(V_{jklm} - V_{kjlm} - V_{lmjk} + V_{mlkj}) \, K_{jklm} \,
c_{2j-1}c_{2k}c_{2l}c_{2m-1} \\
&13.\ (V_{jklm} + V_{kjml} + V_{lmjk} + V_{mlkj}) \, L_{jklm} \,
c_{2j-1}c_{2k}c_{2l-1}c_{2m} \\
&14.\ (V_{jklm} - V_{kjml} - V_{lmjk} + V_{mlkj}) \, M_{jklm} \,
c_{2j}c_{2k-1}c_{2l}c_{2m} \\
&15.\ i(V_{jklm} + V_{kjlm} - V_{jkml} - V_{mlkj}) \, N_{jklm} \,
c_{2j-1}c_{2k-1}c_{2l-1}c_{2m} \\
&16.\ i(V_{jklm} - V_{kjlm} + V_{jkml} - V_{mlkj}) \, O_{jklm} \,
c_{2j}c_{2k}c_{2l}c_{2m-1}
\end{align*}

\subsection*{Special Cases}

1. \textbf{Density-Density} ($j=k$, $l=m$): 
\begin{equation*}
H = \frac{1}{32}\sum_{j,l} V_{jjll} \Big[ -\mathbf{1} +
c_{2j-1}c_{2j}c_{2l-1}c_{2l} \Big]
\end{equation*}

2. \textbf{Exchange} ($j=m$, $k=l$): 
\begin{equation*}
H = \frac{1}{32}\sum_{j,k} V_{jkkj} \Big[ c_{2j-1}c_{2k}c_{2k-1}c_{2j} + 
\text{(degree-2 terms)} \Big]
\end{equation*}

