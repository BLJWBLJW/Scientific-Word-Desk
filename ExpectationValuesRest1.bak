$\mathcal{F}_{1x\mathbb{C}}$ can then be given a Hilbert space structure by
defining an inner product $\left\langle \left. \cdot\right\vert
\cdot\right\rangle _{\mathcal{F}_{1x\mathbb{C}}}$as 
\begin{equation}
\left\langle \left. a\right\vert b\right\rangle _{\mathcal{F}_{1x\mathbb{C}%
}}=\left( \left. a\right\vert b\right) _{\mathcal{F}_{1}}+i\left\{ \left.
a\right\vert b\right\} _{\mathcal{F}_{1x}}=\left( \left. a\right\vert
b\right) _{\mathcal{F}_{1}}+i\left( \left. a\right\vert \widehat{J_{2rx}}%
b\right) _{\mathcal{F}_{1}}.
\end{equation}
The unitary group based on $\left\langle \left. \cdot\right\vert
\cdot\right\rangle _{\mathcal{F}_{1\mathbb{C}}}$ is given by 
\begin{equation}
\left\{ \left. u\in\mathcal{B}\left( \mathcal{F}_{1\mathbb{C}}\right)
\right\vert \left\langle \left. u\left( a\right) \right\vert u\left(
b\right) \right\rangle _{\mathcal{F}_{1\mathbb{C}}}=\left\langle \left.
a\right\vert b\right\rangle _{\mathcal{F}_{1\mathbb{C}}}\forall a,b\in 
\mathcal{F}_{1\mathbb{C}}\right\} ,
\end{equation}
which leads to 
\begin{align}
\left\langle \left. u\left( a\right) \right\vert u\left( b\right)
\right\rangle _{\mathcal{F}_{1\mathbb{C}}} & =\left( \left. t\left( a\right)
\right\vert t\left( b\right) \right) _{\mathcal{F}_{1}}+i\left\{ \left.
t\left( a\right) \right\vert t\left( b\right) \right\} _{\mathcal{F}%
_{1x}}=\left( \left. t\left( a\right) \right\vert t\left( b\right) \right) _{%
\mathcal{F}_{1}}+i\left\{ \left. t\left( a\right) \right\vert t\left(
b\right) \right\} _{\mathcal{F}_{1x}} \\
& =\left( \left. a\right\vert t^{\dagger}tb\right) _{\mathcal{F}%
_{1}}+i\left( \left. a\right\vert t^{\dagger}\widehat{J_{2rx}}tb\right) _{%
\mathcal{F}_{1}} \\
& =\left( \left. a\right\vert b\right) _{\mathcal{F}_{1}}+i\left( \left.
a\right\vert \widehat{J_{2rx}}b\right) _{\mathcal{F}_{1}},
\end{align}
so that 
\begin{equation}
t^{\dagger}t=I_{\mathcal{F}_{1}}\in\mathcal{B}\left( \mathcal{F}_{1}\right)
;t^{\dagger}\widehat{J_{2rx}}t=\widehat{J_{2rx}}
\end{equation}
i.e. $t\in O\left( 2r,\mathbb{R}\right) \cap Sp\left( 2r,\mathbb{R}\right) ,$
hence 
\begin{equation}
U\left( r\right) =O\left( 2r,\mathbb{R}\right) \cap Sp\left( 2r,\mathbb{R}%
\right) .
\end{equation}

As vector spaces 
\begin{gather}
\mathcal{F}_{1x\mathbb{C}}=\mathcal{F}_{1y\mathbb{C}}\quad \\
\mathcal{F}_{1x\mathbb{R}}\cong\mathcal{F}_{1y\mathbb{R}}\quad \\
\forall\text{bases }\left\{ x,y\right\} ,
\end{gather}
but as complex Hilbert spaces it is not always true that $\mathcal{F}_{1x%
\mathbb{C}}=\mathcal{F}_{1y\mathbb{C}}$ in terms of unitary equivalence i.e.%
\begin{align}
\left\langle \left. u\left( a\right) \right\vert u\left( b\right)
\right\rangle _{\mathcal{F}_{1\mathbb{C}}} & =\left( \left. t\left( a\right)
\right\vert t\left( b\right) \right) _{\mathcal{F}_{1}}+i\left\{ \left.
t\left( a\right) \right\vert t\left( b\right) \right\} _{\mathcal{F}%
_{1x}}=\left( \left. t\left( a\right) \right\vert t\left( b\right) \right) _{%
\mathcal{F}_{1}}+i\left\{ \left. t\left( a\right) \right\vert t\left(
b\right) \right\} _{\mathcal{F}_{1x}} \\
& =\left( \left. a\right\vert t^{\dagger}tb\right) _{\mathcal{F}%
_{1}}+i\left( \left. a\right\vert t^{\dagger}\widehat{J_{2rx}}tb\right) _{%
\mathcal{F}_{1}}=\left( \left. a\right\vert b\right) _{\mathcal{F}%
_{1}}+i\left( \left. a\right\vert t^{\dagger}\widehat{J_{2rx}}tb\right) _{%
\mathcal{F}_{1}}.
\end{align}%
\begin{equation}
\widehat{J_{2rt}}=t^{\dagger}\widehat{J_{2rx}}t
\end{equation}
If $t$ $\in Sp\left( 2r,\mathbb{R}\right) $ then 
\begin{equation}
\widehat{J_{2rt}}=\widehat{J_{2rx}}.
