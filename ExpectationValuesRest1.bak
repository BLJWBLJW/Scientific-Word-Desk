\section{Polynomial *-Algebras}

Let $\left\{ I_{\mathcal{A}},\left\{ \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert 1\leq j_{1}<\cdots <j_{p}\leq 2r\right\} \right\} $ be
a basis for a complex algebra $\mathcal{A}_{finite}$, generated by $\left\{
\left. I_{\mathcal{A}},x_{j}\right\vert 1\leq j\leq 2r\right\} ,$ i.e.  
\begin{equation}
\mathcal{A}_{finite}=\mathbb{C}\text{-}\limfunc{linspan}\limfunc{poly}%
\left\{ \left. I_{\mathcal{A}},x_{j}\right\vert 1\leq j\leq 2r\right\} 
\end{equation}%
and the linear span is limited to all \emph{finite} complex linear
combination of products of the generators of $\mathcal{A}_{finite},$ i.e. by
finite complex polynomials of the generators even when $r=\infty $. Note
that in general we are limiting consideration to algebras where the
generators satisfy certain relationships. We also use the set of formal
linear maps (ignoring continuity and boundness) $T\in \mathcal{L}\left( 
\mathcal{A}\right) $ acting in $\mathcal{A}$ i.e. 
\begin{align}
T& :\mathcal{A\longrightarrow A} \\
T(\alpha A+\beta B)& =\alpha T(A)+\beta T(B);\alpha ,\beta \in \mathbb{C}%
,A,B\in \mathcal{A}.
\end{align}%
Complex algebras can always be generated by even dimensional real agebras of
twice the generator dimension and the introduction of a complex structure,
so we don't have to always consider complex algebras.

We assume or limit to the case where there exists a unique bounded linear
functional $\mathit{\limfunc{tr}}\in\mathcal{A}_{finite}^{d}$ that is a 
\emph{normalized faithful tracial} state i.e. 
\begin{align}
\mathit{\limfunc{tr}}\left( I_{\mathcal{A}}\right) & =1 \\
\mathit{\limfunc{tr}}\left( \xi^{\dagger}\xi\right) & =0\Leftrightarrow\xi=0
\\
\mathit{\limfunc{tr}}\left( AB\right) & =\mathit{\limfunc{tr}}\left(
BA\right) \forall A,B \\
\mathit{\limfunc{tr}} & :\mathcal{A\longrightarrow}\mathbb{C}.
\end{align}

\paragraph{Digression on Tracial States}

Consider normalized traces on the finite dimensional algebras $\left\{ 
\mathcal{A}_{j}\right\} $ given by 
\begin{equation}
\left. \mathit{\limfunc{tr}}\right. _{j}=\left( \dim\mathcal{A}_{j}\right)
^{-1}\left. \func{Tr}\right. _{j},
\end{equation}
and the algebraic direct sum of these algebras 
\begin{equation}
\mathcal{A}_{dir}=\bigoplus\limits_{1\leq j\leq m}\mathcal{A}_{j}.
\end{equation}
Clearly $\left. \mathit{\limfunc{tr}}\right. _{j}$ are states of $\mathcal{A}%
_{j}$ as they are postive linear functionals and 
\begin{equation}
\left. \mathit{\limfunc{tr}}\right. _{j}\left\{ I_{j}\right\} =\left( \dim%
\mathcal{A}_{j}\right) ^{-1}\left. \func{Tr}\right. _{j}\left\{
I_{j}\right\} =1.
\end{equation}

\emph{Note that direct sums of algebras are different to direct sums of
vector spaces as the full }$\left( \sum_{1\leq j\leq m}\dim V_{j}\right) $ 
\emph{dimensional vector space }$V$ \emph{can be expressed as the vector
space direct sum } \emph{\ }%
\begin{equation}
V=V_{dir}=\bigoplus\limits_{1\leq j\leq m}V_{j},
\end{equation}
\emph{but the full }$\left( \sum_{1\leq j\leq m}\dim\mathcal{A}_{j}\right) $%
\emph{\ dimensional algebra }$\mathcal{A}$\emph{\ cannot be expressed as }%
\begin{equation}
\mathcal{A}_{dir}=\bigoplus\limits_{1\leq j\leq m}\mathcal{A}_{j}.
\end{equation}
It is easy to see that $\mathcal{A}_{dir}\subseteq\mathcal{A}$\emph{\ }as a
semi-simple subalgebra.

One can introduce the mutually orthogonal self adjoint projectors $\equiv$
self adjoint idempotents $\left\{ P_{j}\right\} $ in $\mathcal{A}_{dir}$
i.e. 
\begin{align}
P_{j}P_{k} & =P_{j}\delta_{jk}, \\
I_{\mathcal{A}_{j}} & =\left. P_{j}\right\vert _{\mathcal{A}_{j}},
\end{align}
associated with the subalgebras $\left\{ \mathcal{A}_{j}\right\} ,$ which
are two sided ideals $\left\{ P_{j}\mathcal{A}_{dir}P_{j}\right\} $ in $%
\mathcal{A}_{dir}.$ Left and right ideals are defined by $\left\{ P_{j}%
\mathcal{A}_{dir}\right\} $ and $\left\{ \mathcal{A}_{dir}P_{j}\right\} $
respectively. Faithful normal tracial states $\left. \mathit{\limfunc{tr}}%
\right. _{j}$ can be extended to $\mathcal{A}_{dir}$ by defining the \emph{%
non faithful normal tracial states }$f_{\mathit{\limfunc{tr}}j}$ as \emph{\ }
\begin{equation}
f_{\mathit{\limfunc{tr}}j}\left( A\right) =\mathit{\limfunc{tr}}\left\{
AP_{j}\right\} =\left( \dim\mathcal{A}_{j}\right) ^{-1}\func{Tr}\left\{
AP_{j}\right\} =\left( \dim\mathcal{A}_{j}\right) ^{-1}\left. \func{Tr}%
\right. _{j}\left\{ AP_{j}\right\} ,\quad A\in\mathcal{A}_{dir},
\end{equation}
such that 
\begin{equation}
f_{\mathit{\limfunc{tr}}j}\left( A\right) =\left\{ 
\begin{array}{c}
\left. \mathit{\limfunc{tr}}\right. _{j}\left\{ A\right\} =\left( \dim%
\mathcal{A}_{j}\right) ^{-1}\left. \func{Tr}\right. _{j}\left\{ A\right\} 
\text{ if }A\in\mathcal{A}_{j} \\ 
0\text{ if }A\notin\mathcal{A}_{j}%
\end{array}
\right. ,
\end{equation}
and 
\begin{align}
f_{\mathit{\limfunc{tr}}j}\left( I_{\mathcal{A}_{dir}}\right) & =f_{\mathit{%
\limfunc{tr}}j}\left( \sum_{1\leq k\leq m}P_{k}\right) =\mathit{\limfunc{tr}}%
\left\{ \left( \sum_{1\leq k\leq m}P_{k}\right) P_{j}\right\} =\func{Tr}%
\left\{ \left( \sum_{1\leq k\leq m}P_{k}\right) \left( \left( \dim\mathcal{A}%
_{j}\right) ^{-1}P_{j}\right) \right\} \\
& =\left( \dim\mathcal{A}_{j}\right) ^{-1}\func{Tr}\left\{ P_{j}\right\}
=\left( \dim\mathcal{A}_{j}\right) ^{-1}\left. \func{Tr}\right. _{j}\left\{
I_{j}\right\} =1,
\end{align}
where $\func{Tr}$ is the unnormalized trace on $\mathcal{A}\supset\mathcal{A}%
_{dir}.$

One can define a \emph{faithful tracial} state $\mathit{\limfunc{tr}}$ as a
convex sum of the the tracial states $\left\{ f_{\mathit{\limfunc{tr}}%
j}\right\} $ as 
\begin{equation}
\mathit{\limfunc{tr}}=\sum_{1\leq j\leq m}\alpha_{j}f_{\mathit{\limfunc{tr}}%
j};\sum_{1\leq j\leq m}\alpha_{j}=1,0\leq \alpha_{j}\leq1
\end{equation}
and 
\begin{equation}
\mathit{\limfunc{tr}}\left\{ I\right\} =\sum_{1\leq j\leq m}\alpha _{j}f_{%
\mathit{\limfunc{tr}}j}\left\{ I\right\} =\sum_{1\leq j\leq m}\alpha_{j}f_{%
\mathit{\limfunc{tr}}j}\left\{ \sum_{1\leq k\leq m}P_{k}\right\}
=\sum_{1\leq j,k\leq m}\alpha_{j}\delta_{jk}=\sum_{1\leq j\leq
m}\alpha_{j}=1.
\end{equation}
If $m>1$ then $\mathit{\limfunc{tr}}$ is not an extreme point of the convex
set of states, $\mathcal{S}\left( \mathcal{A}_{dir}\right) ,$ of $\mathcal{A}%
_{dir},$ though it is a faithful normal tracial state$.$

Every element of $\mathcal{A}_{dir}$ can be expanded as 
\begin{equation}
A=\sum_{1\leq j\leq m}P_{j}AP_{j}.
\end{equation}
In particular a normal state, $f_{D_{j}},$ can be defined as 
\begin{align}
f_{D_{j}}\left( A\right) & =\mathit{\limfunc{tr}}\left\{ A\left( \dim%
\mathcal{A}_{j}\right) D_{j}\right\} =\mathit{\limfunc{tr}}\left\{
P_{j}AP_{j}\left( \dim\mathcal{A}_{j}\right) D_{j}\right\} =f_{\mathit{%
\limfunc{tr}}j}\left( P_{j}AP_{j}\left( \dim \mathcal{A}_{j}\right)
D_{j}\right) \\
& =\left( \dim\mathcal{A}_{j}\right) \left. \mathit{\limfunc{tr}}\right.
_{j}\left\{ P_{j}AP_{j}D_{j}\right\} =\left. \func{Tr}\right. _{j}\left\{
P_{j}AP_{j}D_{j}\right\} ,
\end{align}
where 
\begin{equation}
D_{j}=P_{j}D_{j}P_{j}=P_{j}D_{j}=D_{j}P_{j},
\end{equation}
and 
\begin{equation}
f_{\mathit{\limfunc{tr}}j}\left\{ D_{j}\right\} =\mathit{\limfunc{tr}}%
\left\{ \left( \dim\mathcal{A}_{j}\right) D_{j}\right\} =\left( \dim\mathcal{%
A}_{j}\right) \left. \mathit{\limfunc{tr}}\right. _{j}\left\{ D_{j}\right\} =%
\func{Tr}\left\{ D_{j}\right\} =1.
\end{equation}

\paragraph{End of Digression}

The adjoint operation is defined in terms of complex conjugation and
reversion i.e. 
\begin{equation}
\left( \xi_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right) ^{\dagger }=%
\overline{\xi}_{j_{1}\cdots j_{p}}x_{j_{p}}\cdots x_{j_{1}}
\end{equation}
and 
\begin{equation}
x_{j}^{\dagger}=x_{j};1\leq j\leq2r.
\end{equation}
The trace $\left\langle \left\langle \cdot\right\rangle \right\rangle _{0}$
is faithful i.e. 
\begin{equation}
\left\langle \left\langle \xi^{\dagger}\xi\right\rangle \right\rangle
_{0}=0\Longleftrightarrow\xi=0,
\end{equation}
as%
\begin{align}
\xi^{\dagger}\xi & =\left( \xi_{0}I_{\mathcal{A}}+\sum_{1\leq
p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\xi_{j_{1}\cdots
j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right) ^{\dagger}\left( \xi_{0}I_{\mathcal{A}%
}+\sum_{1\leq q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq2r}\xi_{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}\right) \\
& =\left\vert \xi_{0}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq p,q\leq
2r}\sum_{\substack{ 1\leq j_{1}<\cdots<j_{p}\leq2r \\ 1\leq k_{1}<\cdots
<k_{q}\leq2r}}\overline{\xi}_{j_{1}\cdots j_{p}}\xi_{k_{1}\cdots
k_{q}}x_{j_{p}}\cdots x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}} \\
& =\left( \left\vert \xi_{0}\right\vert ^{2}+\left\langle \left\langle
\xi_{r}^{\dagger}\xi_{r}\right\rangle \right\rangle _{0}\right) I_{\mathcal{A%
}}+\sum_{1\leq q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq2r}\Xi_{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}
\end{align}
this becomes 
\begin{equation}
\left\vert \left\langle \left\langle \xi^{\dagger}\xi\right\rangle
\right\rangle _{0}\right\vert ^{2}=\left( \left\vert \xi_{0}\right\vert
^{2}+\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle
\right\rangle _{0}\right) =0\Longleftrightarrow\xi=0
\end{equation}
i.e. 
\begin{equation}
\sum_{1\leq q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq2r}\Xi_{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}=0.
\end{equation}
The scalar term of $\xi_{r}^{\dagger}\xi_{r}$ is given by 
\begin{align}
\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle
\right\rangle _{0} & =\sum_{1\leq p\leq2r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}\overline{\xi}_{j_{1}\cdots j_{p}}\xi_{j_{1}\cdots
j_{p}}x_{j_{p}}\cdots x_{j_{1}}x_{j_{1}}\cdots x_{j_{p}}=\sum_{1\leq p\leq2r}%
\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\overline{\xi}%
_{j_{1}\cdots j_{p}}\xi_{j_{1}\cdots j_{p}} \\
& =\sum_{1\leq p\leq2r}\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots<j_{p}\leq
2r}\left\vert \xi_{j_{1}\cdots j_{p}}\right\vert ^{2},
\end{align}
which shows that 
\begin{equation}
\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle
\right\rangle _{0}\geq0
\end{equation}
and 
\begin{equation}
\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle
\right\rangle _{0}=0\Longleftrightarrow\xi_{r}=0.
\end{equation}
This reasoning can be extended to $\xi$ to obtain 
\begin{equation}
\left\langle \left\langle \xi^{\dagger}\xi\right\rangle \right\rangle
_{0}=0\Longleftrightarrow\xi=0,
\end{equation}
which shows that 
\begin{equation}
\mathit{\limfunc{tr}}\left( \xi^{\dagger}\xi\right) =0\Leftrightarrow \xi=0
\end{equation}
and thus the $\mathit{\limfunc{tr}}$ functional is faithful.

$\lceil$Note that 
\begin{equation}
\mathit{\limfunc{tr}}\left( x_{j}\right) =0,
\end{equation}
\begin{equation}
x_{j}\neq0,
\end{equation}%
\begin{equation}
\mathit{\limfunc{tr}}\left( x_{j}^{\dagger}x_{j}\right) =\left\langle
\left\langle x_{j}^{\dagger}x_{j}\right\rangle \right\rangle _{0}=\frac{1}{2}%
\neq0
\end{equation}
$\rfloor$

$\lceil$If $\kappa$ is positive 
\begin{equation}
\left\langle \left\langle \kappa\right\rangle \right\rangle _{0}=\mathit{%
\limfunc{tr}}\left\{ \left\langle \left\langle \kappa \right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\kappa_{r}\right\} \geq0.
\end{equation}
If 
\begin{equation}
\left\langle \left\langle \kappa\right\rangle \right\rangle _{0}=0
\end{equation}
then 
\begin{equation}
\mathit{\limfunc{tr}}\left\{ \left\langle \left\langle \kappa \right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\kappa_{r}\right\} =\mathit{\limfunc{tr}}%
\left\{ \kappa_{r}\right\} =0,
\end{equation}
more over from the preceeding 
\begin{equation}
\kappa_{r}=0.
\end{equation}
A simple example is given by 
\begin{align}
\eta & =c_{1}x_{1}-c_{2}x_{2} \\
\eta^{\dagger}\eta & =\frac{1}{2}\left( \left\vert c_{1}\right\vert
^{2}+\left\vert c_{2}\right\vert ^{2}\right) I_{\mathcal{A}}-\bar{c}%
_{1}c_{2}x_{1}x_{2}-\bar{c}_{2}c_{1}x_{2}x_{1}=\frac{1}{2}\left( \left\vert
c_{1}\right\vert ^{2}+\left\vert c_{2}\right\vert ^{2}\right) I_{\mathcal{A}%
}+\left( \bar{c}_{2}c_{1}-\bar{c}_{1}c_{2}\right) x_{1}x_{2} \\
& =\frac{1}{2}\left( \left\vert c_{1}\right\vert ^{2}+\left\vert
c_{2}\right\vert ^{2}\right) I_{\mathcal{A}}+2i\func{Im}\left( \bar{c}%
_{2}c_{1}\right) x_{1}x_{2}.
\end{align}
$\rfloor$

All positive elements can be expressed as the products 
\begin{align}
\kappa & =\xi^{\dagger}\xi=\left( \left\langle \left\langle \xi\right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq p\leq2r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}\xi_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots
x_{j_{p}}\right) ^{\dagger}\left( \left\langle \left\langle \xi\right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq q\leq2r}\sum_{1\leq
k_{1}<\cdots<k_{q}\leq 2r}\xi_{k_{1}\cdots k_{q}}x_{k_{1}}\cdots
x_{k_{q}}\right) \\
& =\left\vert \left\langle \left\langle \xi\right\rangle \right\rangle
_{0}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq p,q\leq2r}\sum _{\substack{ %
1\leq j_{1}<\cdots<j_{p}\leq2r \\ 1\leq k_{1}<\cdots<k_{q}\leq 2r}}\overline{%
\xi}_{j_{1}\cdots j_{p}}\xi_{k_{1}\cdots k_{q}}x_{j_{p}}\cdots
x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}}
\end{align}
so that%
\begin{equation}
\mathit{\limfunc{tr}}\left\{ \xi^{\dagger}\xi\right\} =\left\vert
\left\langle \left\langle \xi\right\rangle \right\rangle _{0}\right\vert
^{2}+\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\left\vert
\xi_{j_{1}\cdots j_{q}}\right\vert ^{2}\in\mathbb{R}^{+}
\end{equation}
and thus defines a positive definite inner product in $\mathcal{A}.$ (One
has to use $^{\dagger}$ and not $^{t}$ as $\mathit{\limfunc{tr}}\left(
\xi^{t}\xi\right) $ is not neccesarily real. Of course one could start with
a real algebra and construct a complex algebra by cannonical
complexifications, then $^{t}$ would be appropiate. $^{\dagger}$ produces a
hermitian inner product, while $^{t}$ a complex symmetric one.)

Positive elements that belong to $\mathcal{F}_{\left( 4\right) }$ formed
from elements of $\mathcal{F}_{\left( 2\right) }$ have the following form:
letting 
\begin{equation}
\eta=\left\langle \left\langle \xi\right\rangle \right\rangle _{0}\in\mathbb{%
C}
\end{equation}
one observes 
\begin{align}
\kappa & =\xi^{\dagger}\xi=\left\vert \eta\right\vert ^{2}I_{\mathcal{A}%
}+\sum_{\substack{ 1\leq p,q\leq2r \\ 0\leq p+q\leq4}}\sum_{\substack{ 1\leq
j_{1}<\cdots<j_{p}\leq2r \\ 1\leq k_{1}<\cdots<k_{q}\leq2r}}\overline{\xi }%
_{j_{1}\cdots j_{p}}\xi_{k_{1}\cdots k_{q}}x_{j_{p}}\cdots
x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}} \\
& =\left\vert \eta\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq
2r}\left( \bar{\eta}\overline{\xi}_{j_{1}}+\eta\xi_{j_{1}}\right)
x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq2r}\left( \eta\xi_{j_{1}j_{2}}-\bar{%
\eta }\overline{\xi}_{j_{1}j_{2}}\right) x_{j_{1}}x_{j_{2}} \\
& +\sum_{1\leq j_{1}<j_{2}<j_{3}\leq2r}\left( \eta\xi_{j_{1}j_{2}j_{3}}-\bar{%
\eta}\overline{\xi}_{j_{1}j_{2}j_{3}}\right)
x_{j_{1}}x_{j_{2}}x_{j_{3}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\left( 
\bar{\eta }\overline{\xi}_{j_{1}j_{2}j_{3}j_{4}}+\eta%
\xi_{j_{1}j_{2}j_{3}j_{4}}\right) x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\sum_{1\leq j_{1},j_{2}\leq2r}\overline{\xi}_{j_{1}}%
\xi_{j_{2}}x_{j_{1}}x_{j_{2}}+\frac{1}{4}\sum_{\substack{ 1\leq j_{1}\neq
j_{2}\leq2r \\ 1\leq j_{3}\neq j_{4}\leq2r}}\overline{\xi}%
_{j_{1}j_{2}}\xi_{j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\frac{1}{2}\sum_{\substack{ 1\leq j_{2},j_{3}\leq2r \\ 1\leq j_{1}\leq 2r
}}\overline{\xi}_{j_{1}}\xi_{j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\frac {1%
}{2}\sum_{\substack{ 1\leq j_{1},j_{2}\leq2r \\ 1\leq j_{1}\leq2r}}%
\xi_{j_{1}}\bar{\xi}_{j_{2}j_{3}}x_{j_{2}}x_{j_{3}}x_{j_{1}} \\
& +\frac{1}{6}\sum_{\substack{ 1\leq j_{2},j_{3},j_{4}\leq2r \\ 1\leq
j_{1}\leq2r}}\overline{\xi}_{j_{1}}%
\xi_{j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}+\frac{1}{6}\sum
_{\substack{ 1\leq j_{2},j_{3},j_{4}\leq2r \\ 1\leq j_{1}\leq2r}}\xi_{j_{1}}%
\bar{\xi}_{j_{2}j_{3}j_{4}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{1}}
\end{align}%
\begin{equation}
\xi_{k_{1}\cdots k_{q}}=0\text{ if }k_{m}=k_{l}\text{ for any }1\leq m\neq
l\leq q
\end{equation}%
\begin{align}
\xi^{\dagger}\xi & =\left\vert \eta\right\vert ^{2}I_{\mathcal{A}%
}+\sum_{1\leq j_{1}\leq2r}\left( \bar{\eta}\overline{\xi}_{j_{1}}+\eta
\xi_{j_{1}}\right) x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq2r}\left( \eta
\xi_{j_{1}j_{2}}-\bar{\eta}\overline{\xi}_{j_{1}j_{2}}\right)
x_{j_{1}}x_{j_{2}} \\
& +\sum_{1\leq j_{1}<j_{2}<j_{3}\leq2r}\left( \eta\xi_{j_{1}j_{2}j_{3}}-\bar{%
\eta}\overline{\xi}_{j_{1}j_{2}j_{3}}\right)
x_{j_{1}}x_{j_{2}}x_{j_{3}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\left( 
\bar{\eta }\overline{\xi}_{j_{1}j_{2}j_{3}j_{4}}+\eta%
\xi_{j_{1}j_{2}j_{3}j_{4}}\right) x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\sum_{1\leq j_{1},j_{2}\leq2r}\overline{\xi}_{j_{1}}%
\xi_{j_{2}}x_{j_{1}}x_{j_{2}}+\frac{1}{4}\sum_{1\leq
j_{1},j_{2},j_{3},j_{4}\leq2r}\overline{\xi }_{j_{1}j_{2}}%
\xi_{j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\frac{1}{2}\sum_{1\leq j_{1},j_{2},j_{3}\leq2r}\overline{\xi}%
_{j_{1}}\xi_{j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\frac{1}{2}\sum_{1\leq
j_{1},j_{2},j_{3}\leq2r}\xi_{j_{1}}\bar{\xi}%
_{j_{2}j_{3}}x_{j_{2}}x_{j_{3}}x_{j_{1}} \\
& +\frac{1}{6}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq2r}\overline{\xi}%
_{j_{1}}\xi_{j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}+\frac{1}{6}%
\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq2r}\xi_{j_{1}}\bar{\xi}%
_{j_{2}j_{3}j_{4}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{1}} \\
& =\lambda_{0}I_{\mathcal{A}}+\sum_{1\leq
j_{1}\leq2r}\lambda_{j_{1}}x_{j_{1}}+\sum_{1\leq
j_{1}<j_{2}\leq2r}\lambda_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}+\sum_{1\leq
j_{1}<j_{2}<j_{3}\leq2r}%
\lambda_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\sum_{1\leq
j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\lambda
_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}.
\end{align}%
\begin{align}
\xi^{\dagger}\xi & =\left( \left\vert \eta\right\vert ^{2}+\sum_{1\leq
j_{1}\leq2r}\left\vert \xi_{j_{1}}\right\vert ^{2}+\sum_{1\leq
j_{1}<,j_{2}\leq2r}\left\vert \xi_{j_{1}j_{2}}\right\vert ^{2}\right) I_{%
