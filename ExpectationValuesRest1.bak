In general one has 
\begin{equation}
A^{\dagger}A=\sum_{0\leq m,n\leq2r}A_{m}^{\dagger}A_{n}=\sum_{0\leq m,n\leq
2r}\sum_{j=0}^{\min\left( m,n\right) }\left\langle
A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{equation}

Need to consider 
\begin{equation}
A_{0}^{\dagger}A_{4},A_{4}^{\dagger}A_{0},A_{1}^{\dagger}A_{3},A_{3}^{%
\dagger }A_{1},A_{2}^{\dagger}A_{2},\cdots
\end{equation}%
\begin{align}
A_{2}^{\dagger}A_{2} & =\sum_{\substack{ 1\leq j_{1}<j_{2}\leq2r \\ 1\leq
j_{3}<j_{4}\leq2r}}\bar{A}_{2j_{1}j_{2}}A_{2j_{3}j_{4}}\left\{
x_{j_{2}}\wedge x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}\right.  \notag \\
& -\Delta_{j_{2}j_{3}}x_{j_{1}}\wedge
