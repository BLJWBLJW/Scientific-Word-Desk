j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\left( \overline{\xi}_{j_{1}j_{2}}\xi
_{j_{3}j_{4}}-\overline{\xi}_{j_{1}j_{3}}\xi_{j_{2}j_{4}}+\overline{\xi }%
_{j_{1}j_{4}}\xi_{j_{2}j_{3}}\right) x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\frac{1}{2}\sum_{1\leq j_{1},j_{2},j_{3}\leq2r}\overline{\xi}%
_{j_{1}}\xi_{j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\frac{1}{2}\sum_{1\leq
j_{1},j_{2},j_{3}\leq2r}\xi_{j_{1}}\bar{\xi}%
_{j_{2}j_{3}}x_{j_{2}}x_{j_{3}}x_{j_{1}} \\
& +\frac{1}{6}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq2r}\overline{\xi}%
_{j_{1}}\xi_{j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}+\frac{1}{6}%
\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq2r}\xi_{j_{1}}\bar{\xi}%
_{j_{2}j_{3}j_{4}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{1}} \\
& =\lambda_{0}I_{\mathcal{A}}+\sum_{1\leq
j_{1}\leq2r}\lambda_{j_{1}}x_{j_{1}}+\sum_{1\leq
j_{1}<j_{2}\leq2r}\lambda_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}+\sum_{1\leq
j_{1}<j_{2}<j_{3}\leq2r}%
\lambda_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\sum_{1\leq
j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\lambda
_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}.
