\subsection{Hamiltonians and Time Evolutions}

In the vacuum representation the expectation value of a one particle
Hamiltonian is given by 
\begin{align}
& \left\langle \left. \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( a_{j}^{\dagger}\right) \right\vert \Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left( \widehat{H}\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right) \right\rangle =\limfunc{tr}\left\{ a_{j}\widehat{H}%
\left( a_{j}^{\dagger}\right) \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} =E_{j}\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} \\
& =\limfunc{tr}\left\{ a_{j}\left( Ha_{j}^{\dagger}-a_{j}^{\dagger }H\right)
\left\vert \phi\right\rangle \left\langle \phi\right\vert \right\} =\limfunc{%
tr}\left\{ a_{j}Ha_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} -\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger}H\left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} \\
& =\limfunc{tr}\left\{ a_{j}Ha_{j}^{\dagger}\left\vert \phi \right\rangle
\left\langle \phi\right\vert \right\} =E_{j}\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} =E_{j},
\end{align}
as 
\begin{equation}
H\left\vert \phi\right\rangle \left\langle \phi\right\vert =0,
\end{equation}
which also means that $\Pi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( \widehat{u}\right) $ and $\Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left( \widehat{H}\right) $
are well defined. Thus 
\begin{equation}
\limfunc{tr}\left\{ A\right\} =2^{-r}\limfunc{Tr}\left\{ A\right\} ,
\end{equation}%
\begin{equation}
\left\langle \left. \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( a_{j}^{\dagger}\right) \right\vert \Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left( \widehat{H}\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right) \right\rangle =\left\langle \left. \varphi
_{j}\right\vert H\varphi_{j}\right\rangle .
\end{equation}
and 
\begin{align}
\left\langle \left. \varphi_{j}\right\vert H\varphi_{j}\right\rangle &
=E_{j}=\func{Tr}\left\{ H\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{j}\right\vert \right\} =\func{Tr}\left\{ Ha_{j}^{\dagger}\left\vert
\phi\right\rangle \left\langle \phi\right\vert a_{j}\right\} =\func{Tr}%
\left\{ a_{j}Ha_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} \\
& =\func{Tr}\left\{ \left(
a_{j}Ha_{j}^{\dagger}-a_{j}a_{j}^{\dagger}H\right) \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right\} =\func{Tr}\left\{
a_{j}\widehat{H}\left( a_{j}^{\dagger}\right) \left\vert \phi\right\rangle
\left\langle \phi\right\vert \right\} \\
& =\left\langle \left. \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( a_{j}^{\dagger}\right) \right\vert \Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left( \widehat{H}\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right) \right\rangle .
\end{align}
A time evolution in $\mathcal{H}^{1}$ is given by 
\begin{equation}
\left\vert \psi\left( t\right) \right\rangle =u\left( t\right) \left\vert
\psi\right\rangle =e^{-iHt}\left\vert \psi\right\rangle
\end{equation}
and in $\mathcal{F}$ by 
\begin{equation}
A\left( t\right) =\widehat{u}\left( t\right) \left( A\right) =u\left(
t\right) Au\left( t\right) ^{\dagger}=e^{-iHt}Ae^{iHt}=\exp\left\{ -i\func{%
adj}\left( H\right) \right\} \left( A\right) ,
\end{equation}
where 
\begin{equation}
\widehat{H}\left( A\right) =\func{adj}\left( H\right) \left( A\right) =\left[
H,A\right] .
\end{equation}
This gives 
\begin{align}
u\left( t\right) a_{j}^{\dagger}u\left( t\right) ^{\dagger} &
=a_{j}^{\dagger}\left( u\left( t\right) \varphi_{j}\right) =\Gamma\left(
u\left( t\right) \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert u\left( t\right) ^{\dagger}\right) \\
\widehat{H}\left( a_{j}^{\dagger}\right) & =\left[ H,a_{j}^{\dagger }\right]
=a_{j}^{\dagger}\left( H\varphi_{j}\right) =\Gamma\left( H\left\vert
\varphi_{j}\right\rangle \left\langle \phi\right\vert -\left\vert
\varphi_{j}\right\rangle \left\langle \phi\right\vert H\right) ,
\end{align}
which shows 
\begin{align}
H\varphi_{j} & =E_{j}\varphi_{j} \\
\widehat{H}\left( \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert \right) & =E_{j}\left\vert \varphi_{j}\right\rangle
\left\langle \phi\right\vert \\
\widehat{H}\left( a_{j}^{\dagger}\right) & =E_{j}a_{j}^{\dagger}.
\end{align}
$\lceil$

\begin{align}
\left[ \sum_{1\leq j\leq r}E_{j}a_{j}^{\dagger}a_{j},a_{k}^{\dagger}\right]
& =\sum_{1\leq j\leq r}E_{j}\left[ a_{j}^{\dagger}a_{j},a_{k}^{\dagger }%
\right] =\sum_{1\leq j\leq r}E_{j}\left(
a_{j}^{\dagger}a_{j}a_{k}^{\dagger}-a_{k}^{\dagger}a_{j}^{\dagger}a_{j}%
\right) =E_{k}\left(
a_{k}^{\dagger}a_{k}a_{k}^{\dagger}-a_{k}^{\dagger}a_{k}^{\dagger}a_{k}%
\right) =E_{k}a_{k}^{\dagger} \\
& =a^{\dagger}\left( E_{k}\varphi_{k}\right) =a^{\dagger}\left(
H\varphi_{k}\right) =E_{k}a^{\dagger}\left( \varphi_{k}\right) .
\end{align}%
\begin{equation}
e^{-iHt}a_{k}^{\dagger}e^{iHt}=e^{-iE_{k}t}a_{k}^{\dagger}
\end{equation}
$\rfloor$

The states $\left\{ \left. a_{j}^{\dagger}a_{j}\right\vert 1\leq j\leq
r\right\} $ and $\left\{ \left. a_{j}a_{j}^{\dagger}\right\vert 1\leq j\leq
r\right\} $ are stationary and $\left\{ \left.
a_{j}^{\dagger},a_{j}\right\vert 1\leq j\leq r\right\} $ are eigen operators
of $\widehat{H}$ i.e. 
\begin{align}
\widehat{u}\left( t\right) \left( a_{j}^{\dagger}a_{j}\right) &
=a_{j}^{\dagger}a_{j};\widehat{u}\left( t\right) \left(
a_{j}a_{j}^{\dagger}\right) =a_{j}a_{j}^{\dagger} \\
\left[ H,a_{j}^{\dagger}a_{j}\right] & =\left[ H,a_{j}a_{j}^{\dagger }\right]
=0 \\
\widehat{H}\left( a_{j}^{\dagger}\right) & =E_{j}a_{j}^{\dagger};1\leq j\leq
r \\
\widehat{H}\left( a_{j}\right) & =-E_{j}a_{j};1\leq j\leq r.
\end{align}
Hence%
\begin{align}
\left\langle a_{j}^{\dagger}\left\vert \widehat{H}a_{j}^{\dagger}\right.
\right\rangle _{\mathcal{F}} & =\limfunc{tr}\left\{ a_{j}\left[
H,a_{j}^{\dagger}\right] \right\} =\limfunc{tr}\left\{ a_{j}\left(
Ha_{j}^{\dagger}-a_{j}^{\dagger}H\right) \right\} =\limfunc{tr}\left\{
a_{j}Ha_{j}^{\dagger}\right\} -\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger}H\right\} \\
& =\limfunc{tr}\left\{ Ha_{j}^{\dagger}a_{j}\right\} -\limfunc{tr}\left\{
Ha_{j}a_{j}^{\dagger}\right\} =E_{j}\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger}\right\} =\limfunc{tr}\left\{
Ha_{j}^{\dagger}a_{j}\right\} -\limfunc{tr}\left\{ H\left(
1-a_{j}^{\dagger}a_{j}\right) \right\} =2\limfunc{tr}\left\{
Ha_{j}^{\dagger}a_{j}\right\} -\limfunc{tr}\left\{ H\right\} \\
& \Rightarrow\frac{\left\langle a_{j}^{\dagger}\left\vert \widehat{H}%
a_{j}^{\dagger}\right. \right\rangle _{\mathcal{F}}}{\left\langle
a_{j}^{\dagger}\left\vert a_{j}^{\dagger}\right. \right\rangle _{\mathcal{F}}%
}=E_{j}.
\end{align}
However 
\begin{equation}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left( 
\widehat{H}\right) \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( a_{j}^{\dagger}\right) =\Phi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(
Ha_{j}^{\dagger}-a_{j}^{\dagger}H\right) =\Phi_{\left\vert \phi\right\rangle
\left\langle \phi\right\vert }\left( Ha_{j}^{\dagger}\right)
=\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
H\right) \Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert
}\left( a_{j}^{\dagger}\right) =E_{j}\Phi_{\left\vert \phi\right\rangle
\left\langle \phi\right\vert }\left( a_{j}^{\dagger}\right)
\end{equation}
as 
\begin{equation}
\left\langle \left. \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( a_{j}^{\dagger}H\right) \right\vert \Phi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left( a_{j}^{\dagger
}H\right) \right\rangle =\limfunc{tr}\left\{ Ha_{j}a_{j}^{\dagger
}H\left\vert \phi\right\rangle \left\langle \phi\right\vert \right\} =0
\end{equation}
i.e. 
\begin{equation}
a_{j}^{\dagger}H\in\ker\Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }
\end{equation}
and%
\begin{equation}
\left\langle \left. \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( Ha_{j}^{\dagger}\right) \right\vert \Phi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left( Ha_{j}^{\dagger
}\right) \right\rangle =\limfunc{tr}\left\{ a_{j}HHa_{j}^{\dagger
}\left\vert \phi\right\rangle \left\langle \phi\right\vert \right\} \neq0.
\end{equation}
On the other hand 
\begin{equation}
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}\right) =0
\end{equation}
i.e. 
\begin{equation}
a_{j}\in\ker\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }
\end{equation}
thus 
\begin{equation}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left( 
\widehat{H}\right) \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( a_{j}\right) =0,
\end{equation}
so the eigenvalues $\left\{ -E_{j}\right\} $ associated with $\left\{
a_{j}\right\} $ are eliminated and 
\begin{equation}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left( 
\widehat{H}\right) =\Pi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left( H\right) .
\end{equation}
\label{rep check}

\section{Bra Ket Operators $\in\mathcal{B}\left( \mathcal{A}_{HS}\right) $}

The Hilbert space $\mathcal{A}_{HS}$ is defined by the closure of $\mathcal{A%
}_{0}$ $\left( \text{the analog of finite rank operators}\right) $ in the
norm given by 
\begin{equation}
\left\Vert A\right\Vert _{HS}=\left( \limfunc{tr}\left\{ A^{\dagger
}A\right\} \right) ^{\frac{1}{2}}=\left\langle \left. A\right\vert
A\right\rangle _{\mathcal{A}}^{\frac{1}{2}}=\left( \left\langle \left\langle
A^{\dagger}A\right\rangle \right\rangle _{0}\right) ^{\frac{1}{2}}
\end{equation}
or equivalently by the GNS\ carrier space defined by the faithful tracial
state $\limfunc{tr},$ i.e. by $\Phi_{\limfunc{tr}}\left( \mathcal{A}%
^{c}\right) .$ The representation $\Pi_{\limfunc{tr}}\left( \mathcal{A}%
^{c}\right) $ of $\mathcal{A}^{c}$ on $\Phi_{\limfunc{tr}}\left( \mathcal{A}%
^{c}\right) \equiv\mathcal{A}_{HS}$ is contained in $\mathcal{B}\left( 
\mathcal{A}_{HS}\right) $ and it is probably true that $\mathcal{B}\left( 
\mathcal{A}_{HS}\right) \cong\mathcal{A}^{w}$ as $w^{\ast}$-algebras.

By redefining the norms of $\left\{ x_{j}\right\} $ one can define an
orthonormal basis of $\Phi_{\limfunc{tr}}\left( \mathcal{A}^{c}\right) $ as $%
\left\{ \Phi_{\mathit{\limfunc{tr}}}\left( I_{\mathcal{A}}\right) ,\left\{
\left. \Phi_{\mathit{\limfunc{tr}}}\left( x_{j_{1}}\cdots x_{j_{p}}\right)
\right\vert 1\leq j_{1}<\cdots<j_{p}\leq2r\right\} ;1\leq p\leq2r\right\} $
and $\mathcal{A}_{HS}$ as $\left\{ I_{\mathcal{A}},\left\{ \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert 1\leq j_{1}<\cdots<j_{p}\leq2r\right\}
;1\leq p\leq2r\right\} $, but note that there is no difference between $%
\Phi_{\limfunc{tr}}\left( \mathcal{A}^{c}\right) $ and $\mathcal{A}_{HS}$ so
we shall denote the Hilbert space as $\mathcal{A}_{HS}$ from now on. So as
vectors in $\mathcal{A}_{HS}$ one has the identity 
\begin{equation}
A\equiv\Phi_{\mathit{\limfunc{tr}}}\left( A\right) .
\end{equation}
A resolution of the identity $I_{\mathcal{A}_{HS}}\in\mathcal{B}\left( 
\mathcal{A}_{HS}\right) ,$ (One should observe that the action of $I_{%
\mathcal{A}}$ and $I_{\mathcal{A}_{HS}}$ on $\mathcal{A}_{HS}$ are
identical), is thus given by 
\begin{equation}
I_{\mathcal{A}_{HS}}=\left\vert I_{\mathcal{A}}\right\rangle \left\langle I_{%
\mathcal{A}}\right\vert +\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \left\langle
x_{j_{1}}\cdots x_{j_{p}}\right\vert ,
\end{equation}
note that 
\begin{equation}
\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \equiv x_{j_{1}}\cdots
x_{j_{p}},
\end{equation}
leading to the vector expansion 
\begin{align}
A & =I_{\mathcal{A}_{HS}}A=\left( \left\vert I_{\mathcal{A}}\right\rangle
\left\langle I_{\mathcal{A}}\right\vert +\sum_{1\leq p\leq2r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle x_{j_{1}}\cdots x_{j_{p}}\right\vert \right) A \\
& =\left\vert I_{\mathcal{A}}\right\rangle \left\langle \left. I_{\mathcal{A}%
}\right\vert A\right\rangle _{\mathcal{A}}+\sum_{1\leq p\leq 2r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert A\right\rangle _{%
\mathcal{A}} \\
& =\left\vert I_{\mathcal{A}}\right\rangle \limfunc{tr}\left\{ A\right\}
+\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq 2r}\left\vert
x_{j_{1}}\cdots x_{j_{p}}\right\rangle \limfunc{tr}\left\{ x_{j_{p}}\cdots
x_{j_{1}}A\right\} \\
& =\limfunc{tr}\left\{ A\right\} I_{\mathcal{A}}+\sum_{1\leq p\leq
2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\limfunc{tr}\left\{ x_{j_{p}}\cdots
x_{j_{1}}A\right\} x_{j_{1}}\cdots x_{j_{p}} \\
& =\left\langle \left\langle A\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\left\langle
\left\langle x_{j_{p}}\cdots x_{j_{1}}A\right\rangle \right\rangle
_{0}x_{j_{1}}\cdots x_{j_{p}}.
\end{align}
Thus one can make the identifications 
\begin{equation}
\left\langle A\right\rangle _{p}=\sum_{1\leq j_{1}<\cdots<j_{p}\leq
2r}\left\langle \left\langle x_{j_{p}}\cdots x_{j_{1}}A\right\rangle
\right\rangle _{0}x_{j_{1}}\cdots x_{j_{p}}=\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}A_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots
x_{j_{p}};0\leq p\leq2r
\end{equation}

Any nuclear operator $T\in\mathcal{B}\left( \mathcal{A}_{HS}\right) $ can be
expressed as 
\begin{equation}
T=\sum_{0\leq p,q\leq2r}\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ %
0\leq k_{1}<\cdots<k_{q}\leq2r}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle T_{j_{1}\cdots j_{p}k_{1}\cdots k_{q}}\left\langle
x_{k_{1}}\cdots x_{k_{q}}\right\vert =\sum_{0\leq p,q\leq2r}\sum_{\substack{ %
0\leq j_{1}<\cdots <j_{p}\leq2r \\ 0\leq k_{1}<\cdots<k_{q}\leq2r}}%
\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \left\langle \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert T\left( x_{k_{1}}\cdots
x_{k_{q}}\right) \right\rangle _{\mathcal{A}}\left\langle x_{k_{1}}\cdots
x_{k_{q}}\right\vert ,
\end{equation}
where 
\begin{equation}
T_{j_{1}\cdots j_{p}k_{1}\cdots k_{q}}=\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert T\left( x_{k_{1}}\cdots x_{k_{q}}\right) \right\rangle
_{\mathcal{A}}
\end{equation}
and any operator belonging to $\mathcal{B}\left( \mathcal{A}_{HS}\right) $
can be obtained by taking the strong operator limit of sequences of nuclear
operators.

In particular left multiplication operators $A_{L}$acting as 
\begin{equation}
A_{L}(B)=AB
\end{equation}
belonging to $\mathcal{B}\left( \mathcal{A}_{HS}\right) $ can be thought of
as $\Pi_{\mathit{\limfunc{tr}}}\left( A\right) $ (as $\left\{ \Pi_{\mathit{%
\limfunc{tr}}}\left( A\right) \right\} $ are always well defined)$,$ hence 
\begin{equation}
\Pi_{\mathit{\limfunc{tr}}}\left( A\right) \Phi _{\mathit{\limfunc{tr}}%
}\left( B\right) =\Phi _{\mathit{\limfunc{tr}}}\left( AB\right) =\Pi _{%
\mathit{\limfunc{tr}}}\left( AB\right) \Phi _{\mathit{\limfunc{tr}}}\left(
I_{\mathcal{A}}\right) .
\end{equation}
This leads to 
\begin{align}
\left( x_{l_{1}}\cdots x_{l_{m}}\right) _{L} & =\sum_{0\leq p,q\leq2r}\sum
_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ 0\leq k_{1}<\cdots<k_{q}\leq2r
}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}%
}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert \left(
x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots x_{k_{q}}\right)
\right\rangle _{\mathcal{A}}\left\langle x_{k_{1}}\cdots x_{k_{q}}\right\vert
\\
& =\sum_{0\leq p,q\leq2r}\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ %
0\leq k_{1}<\cdots<k_{q}\leq2r}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert x_{l_{1}}\cdots x_{l_{m}}x_{k_{1}}\cdots
x_{k_{q}}\right\rangle \left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle x_{k_{1}}\cdots x_{k_{q}}\right\vert
\end{align}
and 
\begin{equation}
A_{L}=\sum_{0\leq p,q,m\leq2r}\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r
\\ 0\leq k_{1}<\cdots<k_{q}\leq2r \\ 0\leq l_{1}<\cdots<l_{m}\leq 2r}}%
A_{l_{1}\cdots l_{m}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{%
\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert \left(
x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots x_{k_{q}}\right)
\right\rangle _{\mathcal{A}}\left\langle x_{k_{1}}\cdots
x_{k_{q}}\right\vert .
\end{equation}
Thus the action of $A_{L}$ on $\mathcal{A}_{HS}$ is given by 
\begin{align}
A_{L}\left( x_{i_{1}}\cdots x_{i_{t}}\right) & =\sum_{0\leq p,q,m\leq 2r}\sum
_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ 0\leq k_{1}<\cdots
<k_{q}\leq2r \\ 0\leq l_{1}<\cdots<l_{m}\leq2r}}A_{l_{1}\cdots
l_{m}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}%
}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert \left(
x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots x_{k_{q}}\right)
\right\rangle _{\mathcal{A}}\left\langle \left. x_{k_{1}}\cdots
x_{k_{q}}\right\vert x_{i_{1}}\cdots x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{0\leq p,m\leq2r}\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ %
0\leq l_{1}<\cdots<l_{m}\leq2r}}A_{l_{1}\cdots l_{m}}\left\vert
x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert \left( x_{l_{1}}\cdots x_{l_{m}}\right)
_{L}\left( x_{i_{1}}\cdots x_{i_{t}}\right) \right\rangle _{\mathcal{A}} \\
& =\sum_{0\leq p,m\leq2r}\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ %
0\leq l_{1}<\cdots<l_{m}\leq2r}}A_{l_{1}\cdots l_{m}}\left\vert
x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert x_{l_{1}}\cdots
x_{l_{m}}x_{i_{1}}\cdots x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{0\leq m\leq2r}\sum_{0\leq l_{1}<\cdots<l_{m}\leq2r}A_{l_{1}\cdots
l_{m}}\left\vert x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle =\sum_{0\leq m\leq2r}\left( \sum_{0\leq
l_{1}<\cdots<l_{m}\leq2r}A_{Ll_{1}\cdots l_{m}}x_{l_{1}}\cdots
x_{l_{m}}\right) x_{i_{1}}\cdots x_{i_{t}}
\end{align}
which can formally be extended to $\mathcal{A}^{w}.$

Hence multiplication in $\mathcal{A}$ can then be expressed as 
\begin{align}
A_{L}\left( B\right) & =A_{L}\left( \sum_{\substack{ 0\leq
i_{1}<\cdots<i_{t}\leq2r \\ 0\leq t\leq2r}}B_{i_{1}\cdots
i_{t}}x_{i_{1}}\cdots x_{i_{t}}\right) \\
& =\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ 0\leq k_{1}<\cdots
<k_{q}\leq2r \\ 0\leq l_{1}<\cdots<l_{m}\leq2r \\ 0\leq
i_{1}<\cdots<i_{t}\leq2r \\ 0\leq p,q,m,t\leq2r}}A_{l_{1}\cdots
l_{m}}B_{i_{1}\cdots i_{t}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
_{\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert
\left( x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots
x_{k_{q}}\right) \right\rangle _{\mathcal{A}}\left\langle \left.
x_{k_{1}}\cdots x_{k_{q}}\right\vert x_{i_{1}}\cdots x_{i_{t}}\right\rangle
_{\mathcal{A}} \\
& =\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ 0\leq l_{1}<\cdots
<l_{m}\leq2r \\ 0\leq i_{1}<\cdots<i_{t}\leq2r \\ 0\leq p,m,t\leq2r}}%
A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots i_{t}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert \left( x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left(
x_{i_{1}}\cdots x_{i_{t}}\right) \right\rangle _{\mathcal{A}} \\
& =\sum_{\substack{ 0\leq j_{1}<\cdots<j_{p}\leq2r \\ 0\leq l_{1}<\cdots
<l_{m}\leq2r \\ 0\leq i_{1}<\cdots<i_{t}\leq2r \\ 0\leq p,m,t\leq2r}}%
A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots i_{t}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r \\ 0\leq i_{1}<\cdots
<i_{t}\leq2r \\ 0\leq m,t\leq2r}}A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots
i_{t}}\left\vert x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle =\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r \\ %
0\leq i_{1}<\cdots<i_{t}\leq2r \\ 0\leq m,t\leq2r}}A_{l_{1}\cdots
l_{m}}B_{i_{1}\cdots i_{t}}x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots x_{i_{t}}
\end{align}

\paragraph{Orthogonal Projection Operators}

\begin{equation}
\left\vert \widetilde{x_{j_{1}}\cdots x_{j_{p}}}\right\rangle \left\langle 
\widetilde{x_{j_{1}}\cdots x_{j_{p}}}\right\vert \left\vert \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\rangle \left\langle \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\vert =\left\vert \widetilde{x_{j_{1}}\cdots
x_{j_{p}}}\right\rangle \left\langle \widetilde{x_{j_{1}}\cdots x_{j_{p}}}%
\right\vert \limfunc{tr}\left\{ \widetilde{x_{j_{p}}\cdots x_{j_{1}}}%
\widetilde{x_{j_{1}}\cdots x_{j_{p}}}\right\} =\left\vert \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\rangle \left\langle \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\vert
\end{equation}
Are all projectors of the form

\begin{equation}
\sum_{0\leq p,q\leq2r}\left\vert \sum_{\substack{ 0\leq
j_{1}<\cdots<j_{p}\leq2r}}c_{j_{1}\cdots j_{p}}\widetilde{x_{j_{1}}\cdots
x_{j_{p}}}\right\rangle \left\langle \sum_{\substack{ 0\leq
k_{1}<\cdots<k_{q}\leq 2r}}c_{j_{1}\cdots j_{p}}\widetilde{x_{k_{1}}\cdots
x_{k_{q}}}\right\vert
\end{equation}
In particular 
\begin{equation}
f_{D}\left( \left\vert \widetilde{x_{j_{1}}x_{j_{2}}}\right\rangle
\left\langle \widetilde{x_{j_{1}}x_{j_{2}}}\right\vert \right) =\limfunc{tr}%
\left\{ \left\vert \widetilde{x_{j_{1}}x_{j_{2}}}\right\rangle \left\langle 
\widetilde{x_{j_{1}}x_{j_{2}}}\right\vert D\right\} =\left\langle \left. 
\widetilde{x_{j_{1}}x_{j_{2}}}\right\vert D\widetilde{x_{j_{1}}x_{j_{2}}}%
\right\rangle
\end{equation}

\subsection{Second Quantization of the Clifford Algebra $\mathcal{F}%
=\bigwedge\mathcal{F}_{1}$}

One can construct a basis of $\mathcal{L}\left( \mathcal{F}\right) $ from
second quantized operators $\left\{ \mathfrak{a}_{j}^{\dagger},\mathfrak{a}%
_{j};1\leq j\leq2r\right\} $ defined by 
\begin{align}
\mathfrak{a}_{j} & =\left\vert I_{\mathcal{F}}\right\rangle \left\langle
x_{j}\right\vert +\sum_{1\leq N\leq\infty}\sum_{1\leq j\neq j_{1}<\cdots
<j_{N}\leq\infty}\left\vert x_{j_{1}}\cdots x_{j_{N}}\right\rangle
\left\langle x_{j}x_{j_{1}}\cdots x_{j_{N}}\right\vert  \notag \\
& =\sum_{0\leq N\leq\infty}\sum_{1\leq j\neq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert x_{j_{1}}\cdots x_{j_{N}}\right\rangle \left\langle
x_{j}x_{j_{1}}\cdots x_{j_{N}}\right\vert  \notag \\
& =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}\sqrt{%
\left( N+1\right) }\left\vert x_{j_{1}}\wedge\cdots\wedge
x_{j_{N}}\right\rangle \left\langle x_{j}\wedge x_{j_{1}}\wedge\cdots\wedge
x_{j_{N}}\right\vert ,
\end{align}
where $\left\{ I_{\mathcal{F}},x_{j_{1}},\cdots,x_{j_{2r}}\right\} $
generate $\mathcal{F}.$

\subsubsection{Example}

\begin{align}
& \mathfrak{a}_{1}=\left\vert I_{\mathcal{F}}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}\right\vert +\left\vert x_{2}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{%
\mathcal{F}}\left\langle x_{1}x_{3}\right\vert +\left\vert
x_{2}x_{3}\right\rangle _{\mathcal{F}}\left\langle x_{1}x_{2}x_{3}\right\vert
\\
& \left( \mathfrak{a}_{1}\right) ^{2}= \\
& \left( \left\vert I_{\mathcal{F}}\right\rangle _{\mathcal{F}}\left\langle
x_{1}\right\vert +\left\vert x_{2}\right\rangle _{\mathcal{F}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}x_{3}\right\vert +\left\vert x_{2}x_{3}\right\rangle _{%
\mathcal{F}}\left\langle x_{1}x_{2}x_{3}\right\vert \right) \left(
\left\vert I_{\mathcal{F}}\right\rangle _{\mathcal{F}}\left\langle
x_{1}\right\vert +\left\vert x_{2}\right\rangle _{\mathcal{F}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}x_{3}\right\vert +\left\vert x_{2}x_{3}\right\rangle _{%
\mathcal{F}}\left\langle x_{1}x_{2}x_{3}\right\vert \right) =0
\end{align}%
\begin{align}
\mathfrak{a}_{1}\mathfrak{a}_{2} & =\left( \left\vert I_{\mathcal{F}%
}\right\rangle _{\mathcal{F}}\left\langle x_{1}\right\vert +\left\vert
x_{2}\right\rangle _{\mathcal{F}}\left\langle x_{1}x_{2}\right\vert
+\left\vert x_{3}\right\rangle _{\mathcal{F}}\left\langle
x_{1}x_{3}\right\vert +\left\vert x_{2}x_{3}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}x_{2}x_{3}\right\vert \right) \\
& \left( \left\vert I_{\mathcal{F}}\right\rangle _{\mathcal{F}}\left\langle
x_{2}\right\vert +\left\vert x_{1}\right\rangle _{\mathcal{F}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}x_{3}\right\vert +\left\vert x_{1}x_{3}\right\rangle _{%
\mathcal{F}}\left\langle x_{1}x_{2}x_{3}\right\vert \right) \\
& =\left\vert I_{\mathcal{F}}\right\rangle _{\mathcal{F}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{F}%
}\left\langle x_{1}x_{2}x_{3}\right\vert \\
& \Rightarrow\mathfrak{a}_{1}\mathfrak{a}_{2}=-\mathfrak{a}_{2}\mathfrak{a}%
_{1}.
\end{align}

The annihilation property

\begin{equation}
\mathfrak{a}_{k}\left\vert I_{\mathcal{F}}\right\rangle =0;1\leq k\leq2r
\end{equation}
wrt the vacuum state $\left\vert I_{\mathcal{F}}\right\rangle $ is
demonstrated by%
\begin{equation}
\mathfrak{a}_{k}\left\vert I_{\mathcal{F}}\right\rangle =\sum_{0\leq
N\leq\infty}\sum_{1\leq k\neq j_{1}<\cdots<j_{N}\leq\infty}\left\vert
x_{j_{1}}\cdots x_{j_{N}}\right\rangle _{\mathcal{F}}\left\langle
x_{k}x_{j_{1}}\cdots x_{j_{N}}\right\vert \left\vert I_{\mathcal{F}%
}\right\rangle =0,
\end{equation}
as 
\begin{equation}
\left\langle x_{k}x_{j_{1}}\cdots x_{j_{N}}\left\vert I_{\mathcal{F}}\right.
\right\rangle =\limfunc{tr}\left\{ x_{k}x_{j_{1}}\cdots x_{j_{N}}\right\}
=\left\langle \left\langle x_{k}x_{j_{1}}\cdots x_{j_{N}}I\right\rangle
\right\rangle _{0}=0.
\end{equation}
The creation property is demonstrated by 
\begin{equation}
\mathfrak{a}_{k}^{\dagger}\left\vert I_{\mathcal{F}}\right\rangle
=\left\vert x_{k}\right\rangle _{\mathcal{F}}\left\langle I_{\mathcal{F}%
}\right\vert \left\vert I_{\mathcal{F}}\right\rangle +\sum_{1\leq
N\leq\infty}\sum_{1\leq k\neq j_{1}<\cdots<j_{N}\leq\infty}\left\vert
x_{j}x_{j_{1}}\cdots x_{j_{N}}\right\rangle _{\mathcal{F}}\left\langle
x_{j_{1}}\cdots x_{j_{N}}\right\vert \left\vert I_{\mathcal{F}}\right\rangle
=\left\vert x_{k}\right\rangle
\end{equation}

$\lceil$%
\begin{align}
x_{j}\wedge x_{k} & =\frac{1}{2}\left[ x_{j},x_{k}\right] \\
\left\vert x_{j}\wedge x_{k}\right\rangle & =\sqrt{2}\left[ x_{j},x_{k}%
\right] =\frac{1}{\sqrt{2}}x_{j}\wedge x_{k}
\end{align}
$\rfloor$

The second quantization operators $\left\{ \mathfrak{a}_{j}^{\dagger },%
\mathfrak{a}_{j}\right\} $ can be considered as the images of the maps 
\begin{align}
\mathfrak{a}^{\dagger},\mathfrak{a} & :\mathcal{F}_{1}\rightarrow \mathcal{B}%
\left( \mathcal{F}\right) \\
\mathfrak{a}^{\dagger}\left( \sum_{1\leq j\leq2r}\zeta_{j}x_{j}\right) &
=\sum_{1\leq j\leq2r}\zeta_{j}\mathfrak{a}^{\dagger}\left( x_{j}\right)
=\sum_{1\leq j\leq2r}\zeta_{j}\mathfrak{a}_{j}^{\dagger} \\
\mathfrak{a}\left( \sum_{1\leq j\leq2r}\zeta_{j}x_{j}\right) & =\sum_{1\leq
j\leq2r}\overline{\zeta}_{j}\mathfrak{a}\left( x_{j}\right) =\sum_{1\leq
j\leq2r}\overline{\zeta}_{j}\mathfrak{a}_{j} \\
& \left\{ \left. \zeta_{j}\in\mathbb{C}\right\vert 1\leq j\leq2r\right\} .
\end{align}

If one completes $\mathcal{F}_{0}$ in the trace norm one obtains the Hilbert
space $\mathcal{F}_{HS}$ and the operator norm can be defined in $\mathcal{L}%
\left( \mathcal{F}\right) $ to obtain the VNA\ algebra $\mathcal{B}\left( 
\mathcal{F}\right) $ and any operator $\mathfrak{A}$ in $\mathfrak{F}\equiv%
\mathcal{B}\left( \mathcal{F}\right) \equiv\tbigwedge \left( \mathfrak{F}%
_{1}\right) $ can be expanded as 
\begin{equation}
\mathfrak{A}=\sum_{1\leq p,q\leq2r}\sum_{\substack{ 1\leq j_{1}<\cdots
<j_{p}\leq2r \\ 1\leq k_{1}<\cdots<k_{q}\leq2r}}\mathfrak{A}_{\mathfrak{a}%
j_{1}\cdots j_{p}k_{q}\cdots k_{1}}\mathfrak{a}_{j_{1}}^{\dagger}\cdots%
\mathfrak{a}_{j_{p}}^{\dagger}\mathfrak{a}_{k_{1}}\cdots\mathfrak{a}%
_{k_{q}}=\sum_{0\leq p\leq4r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq4r}\mathfrak{A%
}_{\mathfrak{x}j_{1}\cdots j_{p}k_{q}\cdots k_{1}}\mathfrak{x}_{j_{1}\cdots}.%
\mathfrak{x}_{j_{p}}.
\end{equation}
$\mathfrak{F}$ contains as subalgebras the sets of left, right and mixed
multiplication operators formed by elements of $\mathcal{F}.$

The algebra, $\mathfrak{F},$ which is a Clifford algebra, is the universal
covering algebra of $O\left( 4r+1,\mathbb{C}\right) $ and contains, in
particular, representations of $O\left( 4r+1,\mathbb{C}\right) ,O\left( 4r,%
\mathbb{C}\right) $ as \emph{inner automorphisms} of $\mathfrak{F}\equiv%
\mathcal{B}\left( \mathcal{F}\right) .$

The group $O\left( 4r+1,\mathbb{C}\right) $ acts in an irreducible way on $%
\mathfrak{F}_{1}\oplus\mathfrak{F}_{2}$ i.e. 
\begin{equation}
O\left( 4r+1,\mathbb{C}\right) :\mathfrak{F}_{1}\oplus\mathfrak{F}%
_{2}\rightarrow\mathfrak{F}_{1}\oplus\mathfrak{F}_{2},
\end{equation}
while $O\left( 4r,\mathbb{C}\right) $ is reducible 
\begin{align}
O\left( 4r,\mathbb{C}\right) & :\mathfrak{F}_{1}\rightarrow\mathfrak{F}_{1}
\\
O\left( 4r,\mathbb{C}\right) & :\mathfrak{F}_{2}\rightarrow\mathfrak{F}_{2}.
\end{align}
It is trivial that 
\begin{align}
O\left( 4r+1,\mathbb{C}\right) & :\mathfrak{F}_{0}\rightarrow \mathfrak{F}%
_{0} \\
O\left( 4r,\mathbb{C}\right) & :\mathfrak{F}_{0}\rightarrow\mathfrak{F}_{0}.
\end{align}

The operators $\left\{ \mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k};1\leq
j,k\leq2r\right\} $ form a basis for the Lie algebra $gl\left( 2r,\mathbb{C}%
\right) $ as 
\begin{align}
\left[ \mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k},\mathfrak{a}_{l}^{\dagger }%
\mathfrak{a}_{m}\right] & =\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}%
\mathfrak{a}_{l}^{\dagger}\mathfrak{a}_{m}-\mathfrak{a}_{l}^{\dagger }%
\mathfrak{a}_{m}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}=\mathfrak{a}%
_{j}^{\dagger}\left( \delta_{kl}-\mathfrak{a}_{l}^{\dagger}\mathfrak{a}%
_{k}\right) \mathfrak{a}_{m}-\mathfrak{a}_{l}^{\dagger}\left( \delta _{mj}-%
\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{m}\right) \mathfrak{a}_{k} \\
& =\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{m}\delta_{kl}-\mathfrak{a}%
_{j}^{\dagger}\mathfrak{a}_{l}^{\dagger}\mathfrak{a}_{k}\mathfrak{a}_{m}-%
\mathfrak{a}_{l}^{\dagger}\mathfrak{a}_{k}\delta_{mj}+\mathfrak{a}%
_{l}^{\dagger}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{m}\mathfrak{a}_{k} \\
& =\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{m}\delta_{kl}-\mathfrak{a}%
_{l}^{\dagger}\mathfrak{a}_{k}\delta_{mj}.
\end{align}
After noting that 
\begin{align}
\left[ \mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k},\mathfrak{a}_{l}^{\dagger }%
\right] & =\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\mathfrak{a}%
_{l}^{\dagger}-\mathfrak{a}_{l}^{\dagger}\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}=\mathfrak{a}_{j}^{\dagger}\left( \delta_{kl}-\mathfrak{a}%
_{l}^{\dagger}\mathfrak{a}_{k}\right) -\mathfrak{a}_{l}^{\dagger}\mathfrak{a}%
_{j}^{\dagger}\mathfrak{a}_{k}=\mathfrak{a}_{j}^{\dagger}\delta_{kl} \\
\left[ \mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k},\mathfrak{a}_{l}\right] &
=\left( \left( \left[ \mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k},\mathfrak{a}%
_{l}\right] \right) ^{\dagger}\right) ^{\dagger}=\left( \left[ \mathfrak{a}%
_{l}^{\dagger},\mathfrak{a}_{k}^{\dagger}\mathfrak{a}_{j}\right] \right)
^{\dagger}=\left( -\mathfrak{a}_{k}^{\dagger}\delta_{jl}\right) ^{\dagger}=-%
\mathfrak{a}_{k}\delta_{jl}
\end{align}
one observes%
\begin{align}
& \exp\left\{ \tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}%
\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}^{\dagger}\exp\left\{ -\tsum
\limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}%
_{k}\right\} \\
& =\left( I+\tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}%
\mathfrak{a}_{k}+\frac{1}{2}\left( \tsum \limits_{1\leq j,k\leq2r}z_{jk}%
\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\right) ^{2}+\cdots\right) 
\mathfrak{a}_{l}^{\dagger}\left( I-\tsum \limits_{1\leq j,k\leq2r}z_{jk}%
\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}+\frac{1}{2}\left( \tsum
\limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}%
_{k}\right) ^{2}+\cdots\right) \\
& =\exp\left\{ adj\left( \tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger}\mathfrak{a}_{k}\right) \right\} \mathfrak{a}%
_{l}^{\dagger}=\exp\left\{ \left[ \tsum \limits_{1\leq j,k\leq2r}z_{jk}%
\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k},\right] \right\} \mathfrak{a}%
_{l}^{\dagger}=\exp\left\{ \tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger}\delta_{kl}\right\} \\
& =\mathfrak{a}_{l}^{\dagger}+\tsum \limits_{1\leq j,k\leq2r}z_{jk}\left[ 
\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k},\mathfrak{a}_{l}^{\dagger}\right]
+\frac{1}{2}\tsum \limits_{\substack{ 1\leq j_{1},j_{2}\leq2r \\ 1\leq
k_{1},k_{2}\leq2r}}z_{j_{1}k_{1}}z_{j_{2}k_{2}}\left[ \mathfrak{a}%
_{j_{2}}^{\dagger}\mathfrak{a}_{k_{2}},\left[ \mathfrak{a}_{j_{1}}^{\dagger}%
\mathfrak{a}_{k_{1}},\mathfrak{a}_{l}^{\dagger}\right] \right] \\
& +\frac{1}{3!}\tsum \limits_{\substack{ 1\leq j_{1},j_{2}\leq2r \\ 1\leq
k_{1},k_{2}\leq2r}}z_{j_{1}k_{1}}z_{j_{2}k_{2}}z_{j_{3}k_{3}}\left[ 
\mathfrak{a}_{j_{3}}^{\dagger}\mathfrak{a}_{k_{3}},\left[ \mathfrak{a}%
_{j_{2}}^{\dagger }\mathfrak{a}_{k_{2}},\left[ \mathfrak{a}_{j_{1}}^{\dagger}%
\mathfrak{a}_{k_{1}},\mathfrak{a}_{l}^{\dagger}\right] \right] \right]
+\cdots \\
& =\mathfrak{a}_{l}^{\dagger}+\tsum \limits_{1\leq j_{1}\leq2r}z_{j_{1}l}%
\mathfrak{a}_{j_{1}}^{\dagger}+\frac{1}{2}\tsum \limits_{\substack{ 1\leq
j_{1},j_{2}\leq2r \\ 1\leq k_{2}\leq 2r}}z_{j_{1}l}z_{j_{2}k_{2}}\left[ 
\mathfrak{a}_{j_{2}}^{\dagger}\mathfrak{a}_{k_{2}},\mathfrak{a}%
_{j_{1}}^{\dagger}\right] +\frac{1}{3!}\tsum \limits_{\substack{ 1\leq
j_{1},j_{2},j_{3}\leq2r \\ 1\leq k_{2},k_{3}\leq2r}}%
z_{j_{1}l}z_{j_{2}k_{2}}z_{j_{3}k_{3}}\left[ \mathfrak{a}_{j_{3}}^{\dagger }%
\mathfrak{a}_{k_{3}},\left[ \mathfrak{a}_{j_{2}}^{\dagger}\mathfrak{a}%
_{k_{2}},\mathfrak{a}_{j_{1}}^{\dagger}\right] \right] +\cdots \\
& =\mathfrak{a}_{l}^{\dagger}+\tsum \limits_{1\leq j_{1}\leq2r}z_{j_{1}l}%
\mathfrak{a}_{j_{1}}^{\dagger}+\frac{1}{2}\tsum \limits_{1\leq
j_{1},j_{2}\leq2r}z_{j_{1}l}z_{j_{2}j_{1}}\mathfrak{a}_{j_{2}}^{\dagger}+%
\frac{1}{3!}\tsum \limits_{1\leq
j_{1},j_{2},j_{3}\leq2r}z_{j_{1}l}z_{j_{2}j_{1}}z_{j_{3}j_{2}}\mathfrak{a}%
_{j_{3}}^{\dagger}+\cdots \\
& =\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}_{j_{1}}^{\dagger}\left( e^{%
\mathbf{Z}}\right) _{j_{1}l}
\end{align}

i.e. 
\begin{align}
& \exp\left\{ \tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}%
\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}^{\dagger}\exp\left\{ -\tsum
\limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}%
_{k}\right\} =\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}%
_{j_{1}}^{\dagger}\left( e^{\mathbf{Z}}\right) _{j_{1}l} \\
& \mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{l}^{\dagger }\mathfrak{g%
}\left( \mathbf{z}\right) ^{-1}=\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}%
_{j_{1}}^{\dagger}\left( e^{\mathbf{Z}}\right) _{j_{1}l}=\tsum
\limits_{1\leq j_{1}\leq2r}\mathfrak{a}_{j_{1}}^{\dagger}\mathcal{R}%
_{a}\left( \mathfrak{g}\left( \mathbf{z}\right) \right) _{j_{1}l},
\end{align}
where 
\begin{align}
\mathfrak{g}\left( \mathbf{z}\right) & =\exp\left\{ \tsum \limits_{1\leq
j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\right\} \\
\mathfrak{g}\left( -\mathbf{z}\right) & =\exp\left\{ -\tsum \limits_{1\leq
j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\right\} =%
\mathfrak{g}\left( \mathbf{z}\right) ^{-1}
\end{align}
The adjoint of this gives 
\begin{equation}
\mathfrak{g}\left( \mathbf{z}\right) ^{\dagger}=\exp\left\{ \tsum
\limits_{1\leq j,k\leq2r}\overline{z}_{jk}\mathfrak{a}_{k}^{\dagger}%
\mathfrak{a}_{j}\right\} =\exp\left\{ \tsum \limits_{1\leq j,k\leq2r}%
\overline{z}_{kj}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\right\}
=\exp\left\{ \tsum \limits_{1\leq j,k\leq2r}\overline{z}_{kj}\mathfrak{a}%
_{j}^{\dagger}\mathfrak{a}_{k}\right\} =\exp\left\{ \tsum \limits_{1\leq
j,k\leq2r}\left( \mathbf{z}^{\dagger}\right) _{kj}\mathfrak{a}_{k}^{\dagger }%
\mathfrak{a}_{j}\right\} =\mathfrak{g}\left( \mathbf{z}^{\dagger}\right) ,
\end{equation}
leading to 
\begin{align}
& \mathfrak{g}\left( \mathbf{z}\right) ^{-\dagger}\mathfrak{a}_{l}\mathfrak{g%
}\left( \mathbf{z}\right) ^{\dagger}=\left( \exp\left\{ \tsum \limits_{1\leq
j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\right\} \mathfrak{%
a}_{l}^{\dagger}\exp\left\{ -\tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a%
}_{j}^{\dagger}\mathfrak{a}_{k}\right\} \right) ^{\dagger }=\exp\left\{
-\tsum \limits_{1\leq j,k\leq2r}\overline{z}_{jk}\mathfrak{a}_{k}^{\dagger}%
\mathfrak{a}_{j}\right\} \mathfrak{a}_{l}\exp\left\{ \tsum \limits_{1\leq
j,k\leq2r}\overline{z}_{jk}\mathfrak{a}_{k}^{\dagger}\mathfrak{a}_{j}\right\}
\\
& =\exp\left\{ -\tsum \limits_{1\leq j,k\leq2r}\left( \mathbf{z}%
^{\dagger}\right) _{kj}\mathfrak{a}_{k}^{\dagger }\mathfrak{a}_{j}\right\} 
\mathfrak{a}_{l}\exp\left\{ \tsum \limits_{1\leq j,k\leq2r}\left( \mathbf{z}%
^{\dagger}\right) _{kj}\mathfrak{a}_{k}^{\dagger }\mathfrak{a}_{j}\right\}
=\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}_{j_{1}}\overline{\left( e^{%
\mathbf{z}}\right) }_{j_{1}l}=\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}%
_{j_{1}}\overline{\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}\right)
\right) }_{j_{1}l} \\
& \equiv\exp\left\{ \tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger}\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}\exp\left\{ \tsum
\limits_{1\leq j,k\leq2r}-z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}%
_{k}\right\} =\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}_{j_{1}}\left(
e^{-\mathbf{z}^{\dagger}}\right) _{j_{1}l}
\end{align}
i.e. 
\begin{align}
& \exp\left\{ \tsum \limits_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}%
\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}\exp\left\{ \tsum \limits_{1\leq
j,k\leq2r}-z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}_{k}\right\} =\tsum
\limits_{1\leq j_{1}\leq2r}\mathfrak{a}_{j_{1}}\left( e^{-\mathbf{z}%
^{\dagger}}\right) _{j_{1}l} \\
& \mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{l}\mathfrak{g}\left( 
\mathbf{z}\right) ^{-1}=\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}%
_{j_{1}}\left( e^{-\mathbf{z}^{\dagger}}\right) _{j_{1}l}=\tsum
\limits_{1\leq j_{1}\leq2r}\mathfrak{a}_{j_{1}}\mathcal{R}_{a}\left( 
\mathfrak{g}\left( -\mathbf{z}^{\dagger}\right) \right) _{j_{1}l}.
\end{align}
This gives 
\begin{align}
& \mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{l}^{\dagger }\mathfrak{a%
}_{k}\mathfrak{g}\left( \mathbf{z}\right) ^{-1}=\mathfrak{g}\left( \mathbf{z}%
\right) \mathfrak{a}_{l}^{\dagger}\mathfrak{g}\left( \mathbf{z}\right) ^{-1}%
\mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{k}\mathfrak{g}\left( 
\mathbf{z}\right) ^{-1}=\tsum \limits_{1\leq j_{1}\leq2r}\mathfrak{a}%
_{j_{1}}^{\dagger}\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}\right)
\right) _{j_{1}l}\tsum \limits_{1\leq j_{2}\leq2r}\mathfrak{a}_{j_{2}}%
\mathcal{R}_{a}\left( \mathfrak{g}\left( -\mathbf{z}^{\dagger}\right)
\right) _{j_{2}k} \\
& =\tsum \limits_{1\leq j_{1},j_{2}\leq2r}\mathfrak{a}_{j_{1}}^{\dagger}%
\mathfrak{a}_{j_{2}}\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}%
\right) \right) _{j_{1}l}\mathcal{R}_{a}\left( \mathfrak{g}\left( -\mathbf{z}%
^{\dagger}\right) \right) _{j_{2}k}=\tsum \limits_{1\leq j_{1},j_{2}\leq2r}%
\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}\right) \right)
_{lj_{1}}^{t}\mathfrak{a}_{j_{1}}^{\dagger}\mathfrak{a}_{j_{2}}\mathcal{R}%
_{a}\left( \mathfrak{g}\left( -\mathbf{z}^{\dagger}\right) \right) _{j_{2}k}.
\end{align}
$\lceil$From the preceding 
\begin{equation}
T\mathfrak{a}_{l}^{\dagger}T^{-1}=\tsum \limits_{1\leq i\leq2r}\mathfrak{a}%
_{i}^{\dagger}T_{il}=\tsum \limits_{1\leq i\leq2r}\mathfrak{a}_{i}^{\dagger}%
\mathcal{R}_{a}\left( T\right) _{il}
\end{equation}%
\begin{equation}
T^{-\dagger}\mathfrak{a}_{k}T^{\dagger}=\tsum \limits_{1\leq j\leq2r}%
\mathfrak{a}_{j}\overline{T}_{jk}\Rightarrow T\mathfrak{a}_{l}T^{-1}=\tsum
\limits_{1\leq j\leq2r}\mathfrak{a}_{j}T_{jk}^{-\dagger}
\end{equation}%
\begin{align}
T\mathfrak{a}_{l}^{\dagger}\mathfrak{a}_{k}T^{-1} & =T\mathfrak{a}%
_{l}^{\dagger}T^{-1}T\mathfrak{a}_{k}T^{-1}=\tsum \limits_{1\leq i\leq2r}%
\mathfrak{a}_{i}^{\dagger}T_{il}\tsum \limits_{1\leq j\leq2r}\mathfrak{a}%
_{j}T_{jk}^{-\dagger} \\
& =\tsum \limits_{1\leq i,j\leq2r}\mathfrak{a}_{i}^{\dagger}\mathfrak{a}%
_{j}T_{il}T_{jk}^{-\dagger}=\tsum \limits_{1\leq i,j\leq2r}T_{li}^{t}%
\mathfrak{a}_{i}^{\dagger}\mathfrak{a}_{j}T_{jk}^{-\dagger}
\end{align}
$\rfloor$

Thus 
\begin{align}
GL\left( 2r,\mathbb{C}\right) & :\mathfrak{f}_{+}\rightarrow \mathfrak{f}_{+}
\\
GL\left( 2r,\mathbb{C}\right) & :\mathfrak{f}_{-}\rightarrow \mathfrak{f}_{-}
\\
\mathfrak{F}_{1} & =\mathfrak{f}_{+}\oplus\mathfrak{f}_{-}.
\end{align}
This group does not leave invariant real decompositions via inner
automorphisms as can be seen by considering 
\begin{equation}
\mathfrak{g}\left( \mathbf{z}\right) \left( \mathfrak{a}_{j}^{\dagger }+%
\mathfrak{a}_{j}\right) \mathfrak{g}\left( \mathbf{z}\right) ^{-1}=\tsum
\limits_{1\leq j_{1}\leq2r}\left\{ \mathfrak{a}_{j_{1}}^{\dagger}\left( e^{%
\mathbf{z}}\right) _{j_{1}j}+\mathfrak{a}_{j_{1}}\left( e^{-\mathbf{z}%
^{\dagger}}\right) _{j_{1}j}\right\} ,
\end{equation}
which only equals 
\begin{equation}
\tsum \limits_{1\leq j_{1}\leq2r}\left\{ \mathfrak{a}_{j_{1}}^{\dagger}+%
\mathfrak{a}_{j_{1}}\right\} \left( e^{\mathbf{z}}\right) _{j_{1}j}
\end{equation}
if 
\begin{equation}
\mathbf{z=}-\mathbf{z}^{\dagger},
\end{equation}
i.e. 
\begin{equation}
\mathfrak{g}\left( \mathbf{z}\right) \in U\left( 2r\right) ,
\end{equation}
which are star inner automorphism's, while $\mathfrak{g}\left( \mathbf{z}%
\right) \left( \mathfrak{a}_{j}^{\dagger}+\mathfrak{a}_{j}\right) \mathfrak{g%
}\left( \mathbf{z}\right) ^{-1}$ are inner automorhisms but not star ones.
However $\mathfrak{g}\left( \mathbf{z}\right) \left( \mathfrak{a}%
_{j}^{\dagger}+\mathfrak{a}_{j}\right) \mathfrak{g}\left( \mathbf{z}\right)
^{-1}\in\mathcal{F}.$ ??The groups $GL\left( 2r,\mathbb{R}\right) $ and $%
Sp\left( 2r,\mathbb{R}\right) $ do not leave invariant real decompositions
via inner automorphisms, though $O\left( 2r,\mathbb{R}\right) $ does??.

The action of $O\left( 4r+1,\mathbb{C}\right) $ on $\mathcal{F}_{\left(
2\right) }$ is given by 
\begin{align}
& \exp\left\{ \sum_{1\leq j<k\leq2r}\left( z_{+jk}\mathfrak{a}_{j}^{\dagger}%
\mathfrak{a}_{k}^{\dagger}+z_{-jk}\mathfrak{a}_{j}\mathfrak{a}_{k}\right)
+\sum_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}%
_{k}+\sum_{1\leq j\leq2r}\left( z_{+j}\mathfrak{a}_{j}^{\dagger }\mathfrak{+}%
z_{-j}\mathfrak{a}_{j}\right) +zI_{\mathcal{F}}\right\} A\times \\
& \exp\left\{ -\sum_{1\leq j<k\leq2r}\left( z_{+jk}\mathfrak{a}_{j}^{\dagger}%
\mathfrak{a}_{k}^{\dagger}+z_{-jk}\mathfrak{a}_{j}\mathfrak{a}_{k}\right)
+\sum_{1\leq j,k\leq2r}z_{jk}\mathfrak{a}_{j}^{\dagger}\mathfrak{a}%
_{k}+\sum_{1\leq j\leq2r}\left( z_{+j}\mathfrak{a}_{j}^{\dagger}\mathfrak{+}%
z_{-j}\mathfrak{a}_{j}\right) +zI_{\mathcal{F}}\right\} =B \\
& A,B\in\mathcal{F}_{\left( 2\right) }
\end{align}
The representation matrices wrt to the real basis $\left\{ I_{\mathcal{F}%
},\left\{ \left. x_{j}\right\vert 1\leq j\leq2r\right\} ,\left\{ \left.
x_{j}x_{k}\right\vert 1\leq j<k\leq2r\right\} \right\} $ are of the form 
\begin{align}
T\left( I_{\mathcal{F}},\mathbf{x,x\wedge x}\right) & =\left( I_{\mathcal{F}%
},\mathbf{x,x\wedge x}\right) \mathcal{R}_{x}\left( T\right) \\
\mathcal{R}_{x}\left( T\right) & =\left( 
\begin{array}{ccc}
\overset{\underset{\leftrightarrow}{1}}{\alpha} & \overset{\underset{%
\leftrightarrow}{2r}}{\mathbf{\beta}} & \overset{\underset{\leftrightarrow}{%
r\left( 2r-1\right) }}{\mathbf{\gamma}} \\ 
\mathbf{\delta} & \mathbf{\varepsilon} & \mathbf{\zeta} \\ 
\epsilon & \mathbf{\eta} & \mathbf{\theta}%
\end{array}
\right) \\
T & =\sum\left\{ \left\vert x_{j}\right\rangle \left\langle x_{k}\right\vert
\varepsilon_{jk}+\left\vert x_{j}x_{k}\right\rangle \left\langle
x_{l}x_{m}\right\vert \theta_{jklm}+\left\vert x_{j}\right\rangle
\left\langle x_{l}x_{m}\right\vert \zeta_{jlm}+\left\vert
x_{j}x_{k}\right\rangle \left\langle x_{l}\right\vert \eta_{jkl}+\left\vert
I_{\mathcal{F}}\right\rangle \left\langle x_{k}\right\vert
\delta_{k}+\left\vert x_{j}\right\rangle \left\langle I_{\mathcal{F}%
}\right\vert \beta _{j}+\left\vert I_{\mathcal{F}}\right\rangle \left\langle
x_{l}x_{m}\right\vert \gamma_{lm}\right. \\
& \left. \left\vert x_{j}x_{k}\right\rangle \left\langle I_{\mathcal{F}%
}\right\vert \epsilon_{jk}\right\} +\left\vert I_{\mathcal{F}}\right\rangle
\left\langle I_{\mathcal{F}}\right\vert \alpha
\end{align}

The group $GL\left( 4r,\mathbb{C}\right) $ is reducibly represented on $%
\mathfrak{F}\equiv\mathcal{B}\left( \mathcal{F}\right) \equiv\tbigwedge 
\mathfrak{F}_{1}$ as 
\begin{equation}
GL\left( 4r,\mathbb{C}\right) :\tbigwedge \nolimits^{n}\mathfrak{F}%
_{1}\rightarrow\tbigwedge \nolimits^{n}\mathfrak{F}_{1}.
\end{equation}

\subsubsection{Symplectic Group $Sp\left( 2r,\mathbb{C}\right) $}

Every element $g\in\mathcal{F}_{2}$ induce a complex antisymmetric bilinear
forms 
\begin{align}
g & :\mathcal{F}_{1}\times\mathcal{F}_{1}\rightarrow\mathbb{C} \\
g\left( v_{1},v_{2}\right) & =-g\left( v_{2},v_{1}\right)
\end{align}
by the hermitian inner product%
\begin{equation}
g_{h}\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{ g^{\dagger }\left(
v_{1}\wedge v_{2}\right) \right\} =\left\langle \left. g\right\vert
v_{1}\wedge v_{2}\right\rangle _{\mathcal{F}}=\left\langle \left\langle
g^{\dagger}\left( v_{1}\wedge v_{2}\right) \right\rangle \right\rangle _{0},
\end{equation}
by the complex symmetric inner product 
\begin{equation}
g_{a}\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{ g^{t}\left( v_{1}\wedge
v_{2}\right) \right\} =\left( \left. g\right\vert v_{1}\wedge v_{2}\right) _{%
\mathcal{F}}=\left\langle \left\langle g^{t}\left( v_{1}\wedge v_{2}\right)
\right\rangle \right\rangle _{0}
\end{equation}
or by 
\begin{equation}
g\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{ g\left( v_{1}\wedge
v_{2}\right) \right\} =\left\langle \left\langle g\left( v_{1}\wedge
v_{2}\right) \right\rangle \right\rangle _{0}.
\end{equation}
The forms $g,g_{h},g_{a}$ are determined by their values on the orthonormal
basis $\left\{ \left. x_{j}\right\vert 1\leq j\leq2r\right\} $ i.e. 
\begin{align}
& g_{h}\left( x_{j},x_{k}\right) =\left\langle \left\langle g^{\dagger
}\left( x_{j}\wedge x_{k}\right) \right\rangle \right\rangle _{0}=\frac {1}{2%
}\sum_{1\leq l\neq m\leq2r}\bar{g}_{lm}\left\langle \left\langle
x_{m}x_{l}x_{j}x_{k}\right\rangle \right\rangle _{0} \\
& =\frac{1}{2}\sum_{1\leq l\neq m\leq2r}\bar{g}_{lm}\left(
\delta_{km}\delta_{lj}-\delta_{jm}\delta_{lk}\right) =\frac{1}{2}\left( \bar{%
g}_{jk}-\bar{g}_{kj}\right) =\bar{g}_{jk} \\
& g_{a}\left( x_{j},x_{k}\right) =g_{jk} \\
& g\left( x_{j},x_{k}\right) =-g_{jk}
\end{align}
One can define an injection 
\begin{equation}
M:\mathcal{F}_{2}\rightarrow\mathcal{B}\left( \mathcal{F}_{1}\right)
\end{equation}%
\begin{equation*}
g=\sum_{1\leq j<k\leq2r}g_{jk}x_{j}\wedge x_{k}=\sum_{1\leq
j<k\leq2r}g_{jk}x_{j}x_{k}\longleftrightarrow M\left( g\right) =\frac{1}{2}%
\sum_{1\leq j,k\leq2r}g_{jk}\left\vert x_{j}\right\rangle _{\mathcal{F}%
}\left\langle x_{k}\right\vert ;g_{kj}=-g_{jk},1\leq j\leq k\leq2r, 
\end{equation*}
such that 
\begin{equation}
\left\langle \left. x_{j}\right\vert M\left( g\right) x_{k}\right\rangle _{%
\mathcal{F}}=g_{jk}=g_{a}\left( x_{j},x_{k}\right) .
\end{equation}
$\lceil$%
\begin{align}
\left\langle \left. g\right\vert h\right\rangle _{\mathcal{F}} & =\frac {1}{4%
}\sum_{\substack{ 1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}\overline{g}%
_{jk}h_{lm}\left\langle \left\langle x_{k}x_{j}x_{l}x_{m}\right\rangle
\right\rangle _{0}=\frac{1}{4}\sum_{\substack{ 1\leq j,k\leq2r \\ 1\leq
l,m\leq2r}}\overline{g}_{jk}h_{lm}\left( \delta_{jl}\delta_{km}-\delta
_{jm}\delta_{kl}\right) \\
& =\sum_{_{1\leq j<k\leq2r}}\overline{g}_{jk}h_{jk}=\mathbf{g}^{\dagger }%
\mathbf{h} \\
& =\frac{1}{2}\sum_{_{1\leq j,k\leq2r}}\overline{g}_{jk}h_{jk}=\frac{1}{2}%
\sum_{_{1\leq j,k\leq2r}}\mathbb{G}_{kj}^{\dagger}h_{jk}=\frac{1}{2}\func{Tr}%
\left\{ \mathbb{G}^{\dagger}\mathbb{H}\right\}
\end{align}%
\begin{align}
\left( \left. g\right\vert h\right) _{\mathcal{F}} & =\frac{1}{4}\sum
_{\substack{ 1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}g_{jk}h_{lm}\left\langle
x_{k}x_{j}x_{l}x_{m}\right\rangle _{0}=\frac{1}{4}\sum_{\substack{ 1\leq
j,k\leq2r \\ 1\leq l,m\leq2r}}g_{jk}h_{lm}\left(
\delta_{jl}\delta_{km}-\delta_{jm}\delta_{kl}\right) \\
& =\sum_{_{1\leq j<k\leq2r}}g_{jk}h_{jk}=\mathbf{g}^{t}\mathbf{h} \\
& =\frac{1}{2}\sum_{_{1\leq j,k\leq2r}}g_{jk}h_{jk}=\frac{1}{2}\sum_{_{1\leq
j,k\leq2r}}\mathbb{G}_{kj}^{t}h_{jk}=\frac{1}{2}\func{Tr}\left\{ \mathbb{G}%
^{t}\mathbb{H}\right\}
\end{align}%
\begin{align}
g_{h}\left( v_{1},v_{2}\right) & =\left\langle \left. g\right\vert
v_{1}\wedge v_{2}\right\rangle _{\mathcal{F}}=\frac{1}{2}\sum_{\substack{ %
1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}\overline{g}_{kj}v_{1l}v_{2m}\left%
\langle \left\langle x_{j}x_{k}x_{l}x_{m}\right\rangle \right\rangle _{0} \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}%
\overline {g}_{kj}v_{1l}v_{2m}\left(
\delta_{jm}\delta_{kl}-\delta_{jl}\delta _{km}\right) =\frac{1}{2}\sum
_{\substack{ 1\leq j,k\leq2r \\ 1\leq l,m\leq 2r}}\left( \overline{g}%
_{kj}v_{1k}v_{2j}-\overline{g}_{kj}v_{1j}v_{2k}\right) =\sum_{\substack{ %
1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}v_{1k}\overline{g}_{kj}v_{2j}=\mathbf{v}%
_{1}^{t}\overline{\mathbb{G}}\mathbf{v}_{2}
\end{align}%
\begin{align}
g_{a}\left( v_{1},v_{2}\right) & =\left( \left. g\right\vert v_{1}\wedge
v_{2}\right) _{\mathcal{F}}=\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq2r \\ %
1\leq l,m\leq2r}}g_{kj}v_{1l}v_{2m}\left\langle \left\langle
x_{j}x_{k}x_{l}x_{m}\right\rangle \right\rangle _{0} \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}%
g_{kj}v_{1l}v_{2m}\left(
\delta_{jm}\delta_{kl}-\delta_{jl}\delta_{km}\right) =\frac{1}{2}\sum
_{\substack{ 1\leq j,k\leq2r \\ 1\leq l,m\leq2r}}\left(
g_{kj}v_{1k}v_{2j}-g_{kj}v_{1j}v_{2k}\right) =\sum_{\substack{ 1\leq
j,k\leq2r \\ 1\leq l,m\leq2r}}v_{1k}g_{kj}v_{2j}=\mathbf{v}_{1}^{t}\mathbb{G}%
\mathbf{v}_{2}
\end{align}
$\rfloor$

The complex antisymmetric matrix 
\begin{equation}
\mathbb{G}\equiv\left\{ \left. g_{jk}\right\vert 1\leq j,k\leq2r\right\}
\end{equation}
\emph{cannot} always be diagonalized, unless it is real, though it always
has eigenvalues $\left\{ \left. 0,\lambda_{j},-\lambda_{j}\right\vert 1\leq
j\leq2p\right\} .$

A realization of $Sp\left( 2r,\mathbb{C}\right) $ is given by 
\begin{align}
Sp\left( 2r,\mathbb{C}\right) & \cong\left\{ \left. T\in\mathcal{B}\left( 
\mathcal{F}_{1}\right) \right\vert g_{a}\left( T\left( v_{1}\right) ,T\left(
v_{2}\right) \right) =g_{a}\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{
g^{t}\left( T\left( v_{1}\right) \right) \wedge\left( T\left( v_{2}\right)
\right) \right\} \right. \\
& \left. =\left\langle g^{t}\left( T\left( v_{1}\right) \right) \wedge\left(
T\left( v_{2}\right) \right) \right\rangle _{0}=\left( \left. g\right\vert
v_{1}\wedge v_{2}\right) _{\mathcal{F}}\right\}
\end{align}
$\lceil$One should check 
\begin{align}
T & \notin\limfunc{Inn}\left\{ \mathcal{F}\right\} \\
T\left( v_{1}\right) & \neq tv_{1}t^{-1}
\end{align}%
\begin{align}
\left( T\wedge T\right) \left( v_{1}\wedge v_{2}\right) & =\left(
Tv_{1}\right) \wedge\left( Tv_{2}\right) \\
\text{ is it possible }\left( T\wedge T\right) & \notin\mathcal{F},\text{
but }\left( T\wedge T\right) \left( g\right) =tgt^{t}.
\end{align}
$\rfloor$%
\begin{equation}
\wedge^{2}:\mathcal{B}\left( \mathcal{F}_{1}\right) \rightarrow \mathcal{B}%
\left( \mathcal{F}_{2}\right)
\end{equation}%
\begin{equation*}
\left( \wedge^{2}T\right) \left( v_{1}\wedge v_{2}\right) =\left( T\wedge
T\right) \left( v_{1}\wedge v_{2}\right) =\left( Tv_{1}\right) \wedge\left(
Tv_{2}\right) 
\end{equation*}%
\begin{align}
\left( \wedge^{2}T\right) & =T\wedge T:\mathcal{F}_{2}\rightarrow \mathcal{F}%
_{2} \\
& \equiv\left( \wedge^{2}T\right) =T\wedge T\in\mathcal{B}\left( \mathcal{F}%
_{2}\right) \\
& \equiv\left( \wedge^{2}T\right) =T\wedge T\in\mathcal{B}\left( \mathcal{B}%
\left( \mathcal{F}_{1}\right) \right)
\end{align}

\paragraph{Various formulations of evaluations of transformed $g$}

\begin{equation}
\left( \left. g\right\vert \left( Tv_{1}\right) \wedge\left( Tv_{2}\right)
\right) _{\mathcal{F}}=\left( \left. g\right\vert \left( T\wedge T\right)
\left( v_{1}\wedge v_{2}\right) \right) _{\mathcal{F}}=\left( \left. \left(
T\wedge T\right) ^{t}g\right\vert \left( v_{1}\wedge v_{2}\right) \right) _{%
\mathcal{F}}
\end{equation}

\subparagraph{Matrix Product Form}

\begin{align}
& \left( \left. g\right\vert \left( Tv_{1}\right) \wedge\left( Tv_{2}\right)
\right) _{\mathcal{F}}=\limfunc{tr}\left\{ g^{t}\left( Tv_{1}\right)
\wedge\left( Tv_{2}\right) \right\} =\frac{1}{2}\sum_{\substack{ 1\leq
j,k,l,m\leq2r \\ j\neq k,l\neq m}}\mathcal{R}_{x}\left( g\right) _{jk}%
\mathcal{R}_{x}\left( Tv_{1}\right) _{l}\mathcal{R}_{x}\left( Tv_{2}\right)
_{m}\left\langle x_{k}x_{j}x_{l}x_{m}\right\rangle _{0} \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k,l,m\leq2r \\ j\neq k,l\neq m}}%
\mathcal{R}_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{l}%
\mathcal{R}_{x}\left( Tv_{2}\right) _{m}\left( \delta_{km}\delta
_{jl}-\delta_{kl}\delta_{jm}\right) \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq2r \\ j\neq k}}\left\{ \mathcal{R%
}_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{j}\mathcal{R}%
_{x}\left( Tv_{2}\right) _{k}-\mathcal{R}_{x}\left( g\right) _{jk}\mathcal{R}%
_{x}\left( Tv_{1}\right) _{k}\mathcal{R}_{x}\left( Tv_{2}\right) _{j}\right\}
\\
& =\frac{1}{2}\sum_{1\leq j,k\leq2r}\left\{ \mathcal{R}_{x}\left(
Tv_{1}\right) _{j}\mathcal{R}_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left(
Tv_{2}\right) _{k}-\mathcal{R}_{x}\left( Tv_{2}\right) _{j}\mathcal{R}%
_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{k}\right\} \\
& =\sum_{1\leq j,k\leq2r}\mathcal{R}_{x}\left( Tv_{1}\right) _{j}\mathcal{R}%
_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{2}\right) _{k}=\mathcal{R}%
_{x}\left( Tv_{1}\right) ^{t}\mathcal{R}_{x}\left( g\right) \mathcal{R}%
_{x}\left( Tv_{2}\right) =\mathcal{R}_{x}\left( v_{1}\right) ^{t}\mathcal{R}%
_{x}\left( T\right) ^{t}\mathcal{R}_{x}\left( g\right) \mathcal{R}_{x}\left(
T\right) \mathcal{R}_{x}\left( v_{2}\right) ,
\end{align}
where the connection with the dot product form is given by 
\begin{align}
& \left( \mathcal{R}_{x}\left( T\right) ^{t}\mathcal{R}_{x}\left( g\right) 
\mathcal{R}_{x}\left( T\right) \right) _{jk}=\frac{1}{2}\sum_{1\leq
l,m\leq2r}\mathcal{R}_{x}\left( T\right) _{jl}^{t}\mathcal{R}_{x}\left(
g\right) _{lm}\mathcal{R}_{x}\left( T\right) _{mk} \\
& =\sum_{1\leq j<l\leq2r}\left( \mathcal{R}_{x}\left( T\wedge T\right)
\right) _{jklm}\mathcal{R}_{x}\left( g\right) _{lm}=\sum_{1\leq j<l\leq
2r}\left( \mathcal{R}_{x}\left( \wedge^{2}T\right) \right) _{jklm}\mathcal{R}%
_{x}\left( g\right) _{lm}.
\end{align}
The representation of the antisymmetric operator tensor product is given by 
\begin{align}
& TgT^{t}=\frac{1}{4}\sum_{\substack{ 1\leq j,k,l,m\leq2r \\ j\neq l,k\neq m
}}\mathcal{R}_{x}\left( T\right) _{kj}g_{jl}\mathcal{R}_{x}\left( T\right)
_{lm}x_{k}x_{m}=\frac{1}{4}\sum_{\substack{ 1\leq j,k,l,m\leq 2r \\ j\neq
l,k\neq m}}\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left(
T\right) _{lm}g_{jl}x_{k}x_{m} \\
& =\frac{1}{4}\sum_{\substack{ 1\leq j,k,l,m\leq2r \\ j\neq l,k\neq m}}%
\mathcal{R}_{x}\left( T\right) _{kj}g_{jl}\mathcal{R}_{x}\left( T\right)
_{lm}x_{k}x_{m} \\
& =\frac{1}{4}\sum_{\substack{ 1\leq k<m\leq2r \\ 1\leq j<l\leq2r}}\left( 
\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left( T\right) _{lm}-%
\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}_{x}\left( T\right) _{lk}-%
\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( T\right) _{jm}+%
\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left( T\right)
_{jk}\right) g_{jl}x_{k}x_{m} \\
& =\sum_{\substack{ 1\leq k<m\leq2r \\ 1\leq j<l\leq2r}}\left( \mathcal{R}%
_{x}\left( T\right) \wedge\mathcal{R}_{x}\left( T\right) \right)
_{kmjl}g_{jl}x_{k}x_{m} \\
& \left( \mathcal{R}_{x}\left( T\right) \wedge\mathcal{R}_{x}\left( T\right)
\right) _{kmjl}=\frac{1}{4}\left( \mathcal{R}_{x}\left( T\right) _{kj}%
\mathcal{R}_{x}\left( T\right) _{lm}-\mathcal{R}_{x}\left( T\right) _{mj}%
\mathcal{R}_{x}\left( T\right) _{lk}-\mathcal{R}_{x}\left( T\right) _{kl}%
\mathcal{R}_{x}\left( T\right) _{jm}+\mathcal{R}_{x}\left( T\right) _{ml}%
\mathcal{R}_{x}\left( T\right) _{jk}\right) .
\end{align}
Giving%
\begin{equation}
\left( T\wedge T\right) \left( v_{1}\wedge v_{2}\right) =\left( \mathbf{x}%
\wedge\mathbf{x}\right) \left( \mathcal{R}_{x}\left( T\right) \wedge\mathcal{%
R}_{x}\left( T\right) \right) \left( \mathcal{R}_{x}\left( v_{1}\right)
\wedge\mathcal{R}_{x}\left( v_{2}\right) \right) ,
\end{equation}
where%
\begin{equation}
\left( \mathcal{R}_{x}\left( v_{1}\right) \wedge\mathcal{R}_{x}\left(
v_{2}\right) \right) _{jl}=\frac{1}{2}\left( \mathcal{R}_{x}\left(
v_{1}\right) _{j}\mathcal{R}_{x}\left( v_{2}\right) _{l}-\mathcal{R}%
_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left( v_{1}\right) _{l}\right) =%
\frac{1}{2}\left( \mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}%
_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left( v_{1}\right) _{l}\mathcal{%
R}_{x}\left( v_{2}\right) _{j}\right) .
\end{equation}
Thus%
\begin{align}
& \mathcal{R}_{x}\left( \left( T\wedge T\right) \left( v_{1}\wedge
v_{2}\right) \right) _{jk}=\sum_{1\leq j<l\leq2r}\mathcal{R}_{x}\left(
T\wedge T\right) _{kmjl}\mathcal{R}_{x}\left( v_{1}\wedge v_{2}\right) _{jl}
\\
& =\sum_{1\leq j<l\leq2r}\left( \mathcal{R}_{x}\left( T\right) \wedge%
\mathcal{R}_{x}\left( T\right) \right) _{kmjl}\left( \mathcal{R}_{x}\left(
v_{1}\right) \wedge\mathcal{R}_{x}\left( v_{2}\right) \right) _{jl} \\
& =\sum_{1\leq j,l\leq2r}\frac{1}{4}\left( \mathcal{R}_{x}\left( T\right)
_{kj}\mathcal{R}_{x}\left( T\right) _{lm}-\mathcal{R}_{x}\left( T\right)
_{mj}\mathcal{R}_{x}\left( T\right) _{lk}-\mathcal{R}_{x}\left( T\right)
_{kl}\mathcal{R}_{x}\left( T\right) _{jm}+\mathcal{R}_{x}\left( T\right)
_{ml}\mathcal{R}_{x}\left( T\right) _{jk}\right) \times \\
& \frac{1}{2}\left( \mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}%
_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{%
R}_{x}\left( v_{1}\right) _{l}\right)
\end{align}%
\begin{align}
& =\frac{1}{8}\sum_{1\leq j,l\leq2r}\left\{ \mathcal{R}_{x}\left( T\right)
_{kj}\mathcal{R}_{x}\left( T\right) _{lm}\mathcal{R}_{x}\left( v_{1}\right)
_{j}\mathcal{R}_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left( T\right)
_{mj}\mathcal{R}_{x}\left( T\right) _{lk}\mathcal{R}_{x}\left( v_{1}\right)
_{j}\mathcal{R}_{x}\left( v_{2}\right) _{l}\right. \\
& -\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( T\right) _{jm}%
\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left( v_{2}\right)
_{l}+\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left( T\right) _{jk}%
\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left( v_{2}\right)
_{l} \\
& -\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left( T\right) _{lm}%
\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left( v_{1}\right)
_{l}+\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}_{x}\left( T\right) _{lk}%
\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left( v_{1}\right)
_{l} \\
& \left. \mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( T\right)
_{jm}\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left(
v_{1}\right) _{l}-\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left(
T\right) _{jk}\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left(
v_{1}\right) _{l}\right\}
\end{align}%
\begin{align}
& =\frac{1}{8}\sum_{1\leq j,l\leq2r}\left\{ \mathcal{R}_{x}\left( T\right)
_{kj}\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left( T\right)
_{ml}^{t}\mathcal{R}_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left(
T\right) _{mj}\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left(
T\right) _{kl}^{t}\mathcal{R}_{x}\left( v_{2}\right) _{l}\right. \\
& -\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( v_{2}\right)
_{l}\mathcal{R}_{x}\left( T\right) _{mj}^{t}\mathcal{R}_{x}\left(
v_{1}\right) _{j}+\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left(
v_{2}\right) _{l}\mathcal{R}_{x}\left( T\right) _{kj}^{t}\mathcal{R}%
_{x}\left( v_{1}\right) _{j} \\
& -\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left( v_{2}\right)
_{j}\mathcal{R}_{x}\left( T\right) _{ml}^{t}\mathcal{R}_{x}\left(
v_{1}\right) _{l}+\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}_{x}\left(
v_{1}\right) _{j}\mathcal{R}_{x}\left( T\right) _{kl}^{t}\mathcal{R}%
_{x}\left( v_{2}\right) _{l} \\
& \left. \mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left(
v_{1}\right) _{l}\mathcal{R}_{x}\left( T\right) _{mj}^{t}\mathcal{R}%
_{x}\left( v_{2}\right) _{j}-\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}%
_{x}\left( v_{1}\right) _{l}\mathcal{R}_{x}\left( T\right) _{kj}^{t}\mathcal{%
R}_{x}\left( v_{2}\right) _{j}\right\} .
\end{align}

\subsection{Orthogonal Projections}

The projection condition is 
\begin{equation}
P^{2}=P;P=P^{\dagger}
\end{equation}
giving%
\begin{equation}
\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r \\ 0\leq
i_{1}<\cdots<i_{t}\leq2r \\ 0\leq m,t\leq2r}}P_{l_{1}\cdots
l_{m}}P_{i_{1}\cdots i_{t}}x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}=\sum_{\substack{ 0\leq j_{1}<\cdots<j_{n}\leq2r \\ 0\leq n\leq2r}}%
P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
and%
\begin{equation}
\sum_{\substack{ 0\leq j_{1}<\cdots<j_{n}\leq2r \\ 0\leq n\leq2r}}%
P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}}=\sum_{\substack{ 0\leq
j_{1}<\cdots<j_{n}\leq2r \\ 0\leq n\leq2r}}\overline{P}_{i_{1}\cdots
i_{n}}x_{j_{n}}\cdots x_{j_{1}}.
\end{equation}

$\lceil$%
\begin{align}
P_{1}x_{1} & =\left( P_{1}x_{1}\right) ^{\dagger}=\overline{P_{1}}%
x_{1}\Rightarrow P_{1}\in\mathbb{R} \\
P_{12}x_{1}x_{2} & =\left( P_{12}x_{1}x_{2}\right) ^{\dagger}=-\overline{%
P_{12}}x_{1}x_{2}\Rightarrow P_{12}=ip_{12};p_{12}\in\mathbb{R} \\
P_{123}x_{1}x_{2}x_{3} & =\left( P_{123}x_{1}x_{2}x_{3}\right) ^{\dagger }=%
\overline{P_{123}}x_{3}x_{2}x_{1}=-\overline{P_{123}}x_{1}x_{2}x_{3}%
\Rightarrow P_{123}=ip_{123};p_{123}\in\mathbb{R} \\
P_{1234}x_{1}x_{2}x_{3}x_{4} & =\left( P_{1234}x_{1}x_{2}x_{3}x_{4}\right)
^{\dagger}=\overline{P_{1234}}x_{4}x_{3}x_{2}x_{1}=\overline{P_{1234}}%
x_{1}x_{2}x_{3}x_{4}\Rightarrow P_{1234}=\overline{P_{1234}}\Rightarrow
P_{1234}\in\mathbb{R}
\end{align}
$\rfloor$

The first condition gives 
\begin{align}
& \sum_{0\leq j_{1}<\cdots<j_{n}\leq2r}P_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots
x_{j_{n}}=\left\langle \sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r \\ %
0\leq i_{1}<\cdots<i_{t}\leq2r \\ 0\leq m,t\leq2r}}P_{l_{1}\cdots
l_{m}}P_{i_{1}\cdots i_{t}}x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{n} \\
& =\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r \\ 0\leq i_{1}<\cdots
<i_{t}\leq2r \\ 0\leq m,t\leq2r}}P_{l_{1}\cdots l_{m}}P_{i_{1}\cdots
i_{t}}\left\langle x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{n},
\end{align}
while the second condition gives 
\begin{equation}
\left( P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger
}=P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}},
\end{equation}
i.e. 
\begin{equation}
\overline{P}_{i_{1}\cdots i_{n}}x_{j_{n}}\cdots x_{j_{1}}=P_{i_{1}\cdots
i_{n}}x_{j_{1}}\cdots x_{j_{n}}.
\end{equation}
As 
\begin{equation}
x_{j_{n}}\cdots x_{j_{1}}=\left( -1\right) ^{\binom{n-1}{2}}x_{j_{1}}\cdots
x_{j_{n}}=e^{\frac{n\left( n-1\right) }{2}\pi i}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
and 
\begin{equation}
P_{i_{1}\cdots i_{n}}=\left\vert P_{i_{1}\cdots i_{n}}\right\vert
e^{i\theta}.
\end{equation}
Then 
\begin{equation}
\overline{P}_{i_{1}\cdots i_{n}}x_{j_{n}}\cdots x_{j_{1}}=P_{i_{1}\cdots
i_{n}}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
gives 
\begin{equation}
\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{-i\theta}e^{\frac{n\left(
n-1\right) }{2}\pi i}x_{j_{1}}\cdots x_{j_{n}}=\left\vert P_{i_{1}\cdots
i_{n}}\right\vert e^{i\theta}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
leading to 
\begin{equation}
e^{-i\theta}e^{\frac{n\left( n-1\right) }{2}\pi i}=e^{i\theta}
\end{equation}
i.e%
\begin{align}
e^{\frac{n\left( n-1\right) }{2}\pi i} & =e^{2i\theta} \\
\theta & =\frac{n\left( n-1\right) }{4}\pi,
\end{align}
hence 
\begin{equation}
P_{i_{1}\cdots i_{n}}=\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{\frac{%
n\left( n-1\right) }{4}i\pi}.
\end{equation}
Checking this gives 
\begin{align}
\overline{P}_{i_{1}\cdots i_{n}}x_{j_{n}}\cdots x_{j_{1}} & =P_{i_{1}\cdots
i_{n}}x_{j_{1}}\cdots x_{j_{n}} \\
\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{-\frac{n\left( n-1\right) }{4}%
i\pi}e^{\frac{n\left( n-1\right) }{2}\pi i}x_{j_{1}}\cdots x_{j_{n}} &
=\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{\frac{n\left( n-1\right) }{4}%
i\pi}x_{j_{1}}\cdots x_{j_{n}} \\
e^{\frac{n\left( n-1\right) }{4}\pi i} & =e^{\frac{n\left( n-1\right) }{4}%
i\pi},
\end{align}
which confirms the value of $P_{i_{1}\cdots i_{n}}.$

