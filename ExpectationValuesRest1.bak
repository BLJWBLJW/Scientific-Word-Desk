& +\Delta_{j_{1}j_{3}}x_{j_{2}}\wedge
x_{j_{4}}-\Delta_{j_{1}j_{4}}x_{j_{2}}\wedge x_{j_{3}}  \notag \\
& +\left. \Delta_{j_{2}j_{4}}\Delta_{j_{1}j_{3}}I_{\mathcal{F}%
}-\Delta_{j_{2}j_{3}}\Delta_{j_{1}j_{4}}I_{\mathcal{F}}\right\} .
\end{align}
Products of higher order terms can only occur if they cannot cancel out,
consider 
\begin{align}
A_{4}^{\dagger}A_{4} & =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r
\\ 1\leq j_{5}<j_{6}\,<j_{7}<j_{8}\leq2r}}\bar{A}%
_{4j_{1}j_{2}j_{3}j_{4}}A_{4j_{5}j_{6}j_{7}j_{8}}\left\{ x_{j_{4}}\wedge
x_{j_{3}}\wedge x_{j_{2}}\wedge x_{j_{1}}\wedge x_{j_{5}}\wedge
x_{j_{6}}\wedge x_{j_{7}}\wedge x_{j_{8}}\right. \\
& +\sum_{\sigma\in S_{8}/\left( S_{2}\times S_{6}\right) }\pi\left(
\sigma\right) \Delta_{j_{\sigma\left( 1\right) }j_{\sigma\left( 2\right)
}}x_{j_{\sigma\left( 3\right) }}\wedge x_{j_{\sigma\left( 4\right) }}\wedge
