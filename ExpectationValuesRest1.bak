\begin{equation}
P=P_{0}I_{\mathcal{A}}+\sum_{1\leq m\leq2r}P_{m}.
\end{equation}
giving%
\begin{align}
P^{2} & =P^{\dagger}P=\sum_{0\leq m,n\leq2r}P_{m}P_{n}=\left\Vert
P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq
m\leq2r}P_{m}+\sum_{1\leq m,n\leq2r}P_{m}P_{n} \\
& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq
m\leq2r}P_{m}+\sum_{1\leq m,n\leq2r}\sum_{j=0}^{\min\left( m,n\right)
}\left\langle P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{align}
As%
\begin{equation}
P=P_{0}+\sum_{1\leq m\leq2r}P_{m}
\end{equation}
one has%
\begin{align}
P_{0} & =\left\Vert P\right\Vert _{HS}^{2} \\
P_{m} & =2P_{0}P_{m}+\left\langle \sum_{1\leq
m,n\leq2r}\sum_{j=0}^{\min\left( m,n\right) }\left\langle
P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}\right\rangle _{m}.
\end{align}
$\lceil$%
\begin{align}
\left\langle A_{r}B_{s}\right\rangle _{r+s-2j} & =\left( -1\right)
^{rs-j}\left\langle B_{s}A_{r}\right\rangle _{r+s-2j} \\
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j} & =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j}
\end{align}%
\begin{align}
m,n\text{ even } & \Rightarrow mn\text{ even }\left( 2s\right)
^{2}=4s^{2}\Rightarrow\pi\left( mn-j\right) =\pi\left( j\right) \Rightarrow
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}=\left( -1\right)
^{j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
m\text{ even,}n\text{ odd} & \Rightarrow mn\text{ even }\left( 2s\right)
\left( 2s+1\right) =2\left( 2s^{2}+s\right) \Rightarrow\pi\left( mn-j\right)
=\pi\left( j\right) \Rightarrow\left\langle P_{m}P_{n}\right\rangle
_{m+n-2j}=\left( -1\right) ^{j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j}
\\
m\text{ odd,}n\text{ odd} & \Rightarrow mn\text{ odd }\left( 2s+1\right)
^{2}=4s^{2}+4s+1\Rightarrow\pi\left( mn-j\right) =\pi\left( j+1\right)
\Rightarrow\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}=\left( -1\right)
^{j+1}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j}
\end{align}%
\begin{align}
P^{2} & =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq
m\leq4}P_{m}+\sum_{1\leq m,n\leq4}P_{m}P_{n} \\
& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\left(
P_{1}+P_{2}+P_{3}+P_{4}\right) +P_{1}P_{1}+P_{2}P_{2}+P_{3}P_{3}+P_{4}P_{4}
\\
&
+P_{1}P_{2}+P_{1}P_{3}+P_{1}P_{4}+P_{2}P_{3}+P_{2}P_{4}+P_{3}P_{4}+P_{2}P_{1}+P_{3}P_{1}+P_{4}P_{1}+P_{3}P_{2}+P_{4}P_{2}+P_{4}P_{3}
\end{align}
$\rfloor$

and%
\begin{equation}
\left\Vert P\right\Vert _{HS}^{2}=\left\langle \sum_{\substack{ 0\leq
l_{1}<\cdots<l_{m}\leq2r \\ 0\leq i_{1}<\cdots<i_{t}\leq2r \\ 0\leq m,t\leq
2r}}\overline{P}_{l_{1}\cdots l_{m}}P_{i_{1}\cdots i_{t}}\left(
x_{l_{1}}\cdots x_{l_{m}}\right) ^{\dagger}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{0}=\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r
\\ 0\leq m\leq2r}}\overline{P}_{l_{1}\cdots l_{m}}P_{l_{1}\cdots l_{m}}.
\end{equation}
The general formula is 
\begin{equation}
\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq m\leq
2r}P_{m}+\sum_{1\leq m,n\leq2r}\sum_{j=0}^{\min\left( m,n\right)
}\left\langle P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{equation}
giving

\begin{enumerate}
\item $m=0$%
\begin{equation}
P_{0}=p_{0}I_{\mathcal{A}}\,=\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r
\\ 0\leq m\leq4}}\left\vert P\right\vert _{l_{1}\cdots l_{m}}^{2}I_{\mathcal{%
A}}=\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}.
