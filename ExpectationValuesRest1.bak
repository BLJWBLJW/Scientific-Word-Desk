\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j} & =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{2}P_{4}\right\rangle _{4+2-0} & =\left( -1\right)
^{8-0}\left\langle P_{4}P_{2}\right\rangle _{6}=\left\langle
P_{4}P_{2}\right\rangle _{6}
\end{align}
hence 
\begin{equation}
P_{6}=0=2\left\langle P_{2}P_{4}\right\rangle _{6}+\left\langle
P_{3}P_{3}\right\rangle _{6}+\left\langle P_{4}P_{4}\right\rangle _{6}
\end{equation}

\item $m=7$%
\begin{equation}
P_{7}=0=\sum_{1\leq m,n\leq4}\sum_{j=0}^{\min\left( m,n\right) }\left\langle
P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\left\langle
P_{3}P_{4}\right\rangle _{7}+\left\langle P_{4}P_{3}\right\rangle _{7}
\end{equation}%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j} & =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{3}P_{4}\right\rangle _{4+3-0} & =\left( -1\right)
^{12-0}\left\langle P_{4}P_{3}\right\rangle _{7}=\left\langle
P_{4}P_{3}\right\rangle _{7}
\end{align}
hence 
\begin{equation}
P_{7}=0=2\left\langle P_{3}P_{4}\right\rangle _{7}
\end{equation}

\item $m=8$%
\begin{equation}
P_{8}=0=\left\langle P_{4}P_{4}\right\rangle _{8}.
\end{equation}
Since we are only interested in gauge invariant projectors 
\begin{align}
P & =P_{0}+P_{2}+P_{4}=P^{2} \\
& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}P_{2}+2\left%
\langle P_{2}P_{4}\right\rangle _{2}+\left\langle P_{2}P_{2}\right\rangle
_{2}+\left\langle P_{4}P_{4}\right\rangle _{2} \\
& +2P_{0}P_{4}+\left\langle P_{2}P_{2}\right\rangle _{4},
\end{align}
giving 
\begin{align}
& 2P_{0}P_{2}-P_{2}+2\left\langle P_{2}P_{4}\right\rangle _{2}+\left\langle
P_{2}P_{2}\right\rangle _{2}+\left\langle P_{4}P_{4}\right\rangle _{2}=0 \\
& 2P_{0}P_{4}-P_{4}+\left\langle P_{2}P_{2}\right\rangle _{4}+\left\langle
P_{4}P_{4}\right\rangle _{4}=0 \\
& 2\left\langle P_{2}P_{4}\right\rangle _{6}+\left\langle
P_{4}P_{4}\right\rangle _{6}=0 \\
& \left\langle P_{4}P_{4}\right\rangle _{8}=0 \\
& P_{0}=\left\Vert P\right\Vert _{HS}I_{\mathcal{A}}.
\end{align}
The various products are given by 
\begin{align}
& P_{2}P_{2}=\sum_{\substack{ 1\leq j_{1}<j_{2}\leq2r \\ 1\leq
j_{3}<j_{4}\leq2r}}P_{2j_{1}j_{2}}P_{2j_{3}j_{4}}\left\{ x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\right.  \notag \\
& -\Delta_{j_{1}j_{3}}x_{j_{2}}\wedge
x_{j_{4}}+\Delta_{j_{1}j_{4}}x_{j_{2}}\wedge x_{j_{3}}  \notag \\
& +\Delta_{j_{2}j_{3}}x_{j_{1}}\wedge
x_{j_{4}}-\Delta_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}  \notag \\
& +\left. \Delta_{j_{1}j_{4}}\Delta_{j_{2}j_{3}}I_{\mathcal{F}%
}-\Delta_{j_{1}j_{3}}\Delta_{j_{2}j_{4}}I_{\mathcal{F}}\right\} .
\end{align}%
\begin{align}
P_{4}P_{2} & =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r \\ 1\leq
j_{5}<j_{6}\leq2r}}P_{4j_{1}j_{2}j_{3}j_{4}}P_{2j_{5}j_{6}}\left\{
x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}\right.  \notag \\
& +\sum_{\sigma\in S_{6}/\left( S_{4}\times S_{2}\right) }\pi\left(
\sigma\right) \Delta_{j_{\sigma\left( 1\right) }j_{\sigma\left( 2\right)
}}x_{j_{\sigma\left( 3\right) }}\wedge x_{j_{\sigma\left( 4\right) }}\wedge
x_{j_{\sigma\left( 5\right) }}\wedge x_{j_{\sigma\left( 6\right) }}  \notag
\\
& +\sum_{\sigma\in S_{6}/\left( S_{4}\times S_{4}\right) }\pi\left(
\sigma\right) \limfunc{Pf}\left( \mathbf{\Delta}_{j_{\sigma\left( 1\right)
}j_{\sigma\left( 2\right) }j_{\sigma\left( 3\right) }j_{\sigma\left(
4\right) }}\right) x_{j_{\sigma\left( 5\right) }}\wedge x_{j_{\sigma\left(
6\right) }}  \notag \\
& +\left. \limfunc{Pf}\left( \mathbf{\Delta}%
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) I_{\mathcal{F}}\right\} .
\end{align}%
\begin{align}
P_{4}P_{4} & =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r \\ 1\leq
j_{5}<j_{6}\,<j_{7}<j_{8}\leq2r}}%
P_{4j_{1}j_{2}j_{3}j_{4}}P_{4j_{5}j_{6}j_{7}j_{8}}\left\{ x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge
x_{j_{6}}\wedge x_{j_{7}}\wedge x_{j_{8}}\right. \\
& +\sum_{\sigma\in S_{8}/\left( S_{2}\times S_{6}\right) }\pi\left(
\sigma\right) \Delta_{j_{\sigma\left( 1\right) }j_{\sigma\left( 2\right)
}}x_{j_{\sigma\left( 3\right) }}\wedge x_{j_{\sigma\left( 4\right) }}\wedge
x_{j_{\sigma\left( 5\right) }}\wedge x_{j_{\sigma\left( 6\right) }}\wedge
x_{j_{\sigma\left( 7\right) }}\wedge x_{j_{\sigma\left( 8\right) }} \\
& +\sum_{\sigma\in S_{8}/\left( S_{4}\times S_{4}\right) }\pi\left(
\sigma\right) \limfunc{Pf}\left( \mathbf{\Delta}_{j_{\sigma\left( 1\right)
}j_{\sigma\left( 2\right) }j_{\sigma\left( 3\right) }j_{\sigma\left(
4\right) }}\right) x_{j_{\sigma\left( 5\right) }}\wedge x_{j_{\sigma\left(
6\right) }}\wedge x_{j_{\sigma\left( 7\right) }}\wedge x_{j_{\sigma\left(
8\right) }} \\
& +\left. \sum_{\sigma\in S_{8}/\left( S_{6}\times S_{2}\right) }\pi\left(
\sigma\right) \limfunc{Pf}\left( \mathbf{\Delta}_{j_{\sigma\left( 1\right)
}j_{\sigma\left( 2\right) }j_{\sigma\left( 3\right) }j_{\sigma\left(
4\right) }j_{\sigma\left( 5\right) }j_{\sigma\left( 6\right) }}\right)
x_{j_{\sigma\left( 7\right) }}\wedge x_{j_{\sigma\left( 8\right) }}+\limfunc{%
Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}j_{7}j_{8}}\right)
I_{\mathcal{F}}\right\} .
\end{align}
\end{enumerate}

\section{Positivity Constraints}

\begin{theorem}
A partial state $f_{\left( 4\right) }$ defined on $\mathcal{F}_{\left(
4\right) }$ can be extended to a state $f$ of $\mathcal{F}$ if and only if 
\begin{equation}
0\leq f_{\left( 4\right) }\left( P\right) \leq1\quad\forall P\in \Pr\left\{ 
\mathcal{F}_{\left( 4\right) }\right\} ,
\end{equation}
where $\Pr\left\{ \mathcal{F}_{\left( 4\right) }\right\} $ is the set of
orthogonal projections (orthogonal idempotents $\equiv$ self adjoint
idempotents) belonging to $\mathcal{F}_{\left( 4\right) }.$
\end{theorem}

If $f_{\left( 4\right) }$ is a normal partial state 
\begin{equation}
f_{\left( 4\right) }\left( P\right) =\limfunc{tr}\left\{ PD_{\left( 4\right)
}\right\} =\limfunc{tr}\left\{ P\left( I_{\mathcal{F}%
}+d_{1}+d_{2}+d_{3}+d_{4}\right) \right\}
\end{equation}
and if $f_{\left( 4\right) }$ is gauge invariant normal state 
\begin{equation}
f_{\left( 4\right) }\left( P\right) =\limfunc{tr}\left\{ PD_{\left( 4\right)
}\right\} =\limfunc{tr}\left\{ P\left( I_{\mathcal{F}}+d_{2}+d_{4}\right)
\right\} =\limfunc{tr}\left\{ P_{0}I_{\mathcal{F}}+P_{2}d_{2}+P_{4}d_{4}%
\right\} =P_{0}+\limfunc{tr}\left\{ P_{2}d_{2}+P_{4}d_{4}\right\} .
\end{equation}
A gauge invariant partial state can be extended iff 
\begin{equation}
D_{\left( 4\right) }=\left\langle QQ^{\dagger}\right\rangle
_{0}+\left\langle QQ^{\dagger}\right\rangle _{2}+\left\langle QQ^{\dagger
}\right\rangle _{4},
\end{equation}
for \emph{some }$Q$ (there could be many $Q^{\prime}s$ defining the same $%
D_{\left( 4\right) }),$ where in general 
\begin{equation}
Q=\sum_{0\leq j\leq2r}\left\langle Q\right\rangle _{j}.
\end{equation}
Orthogonal idempotents/projections are positive thus 
\begin{equation}
P=pp^{\dagger}
\end{equation}
thus for normal partial states 
\begin{equation}
f_{\left( 4\right) }\left( P\right) =\left\langle \left\langle PD_{\left(
4\right) }\right\rangle \right\rangle _{0}=\limfunc{tr}\left\{ PD_{\left(
4\right) }\right\} =\limfunc{tr}\left\{ pp^{\dagger }D_{\left( 4\right)
}\right\} =\limfunc{tr}\left\{ p^{\dagger }D_{\left( 4\right) }p\right\}
=\left\langle \left. p\right\vert D_{\left( 4\right) }p\right\rangle _{%
\mathcal{F}}.
\end{equation}
and 
\begin{equation}
0\leq\left\langle \left. p\right\vert D_{\left( 4\right) }p\right\rangle _{%
\mathcal{F}}\leq1.
\end{equation}
If 
\begin{equation}
P\in\Pr\left\{ \mathcal{F}_{\left( 4\right) }\right\} \Leftrightarrow p\in%
\mathcal{F}_{\left( 4\right) }
\end{equation}
then the positivity (representability) constraint becomes 
\begin{equation}
0\leq\left\langle \left. p\right\vert D_{\left( 4\right) }p\right\rangle _{%
\mathcal{F}}\leq1\forall p\in\limfunc{pr}\left\{ \mathcal{F}_{\left(
4\right) }\right\} .
\end{equation}
Also%
\begin{equation}
\limfunc{tr}\left\{ P\right\} =\limfunc{tr}\left\{ pp^{\dagger }\right\} =%
\limfunc{tr}\left\{ p^{\dagger}p\right\} =\left\Vert p\right\Vert _{HS}^{2}
\end{equation}
For gauge invariant states one only needs to consider even order components
of $P$%
\begin{equation}
\left\Vert P\right\Vert _{HS}^{2}=P_{0}^{2}+\left\langle \left\langle
P\right\rangle \right\rangle _{2}+\left\langle \left\langle P\right\rangle
\right\rangle _{4}=\left\langle \left\langle P\right\rangle \right\rangle
_{0}+\left\langle \left\langle P\right\rangle \right\rangle
_{2}+\left\langle \left\langle P\right\rangle \right\rangle
_{4}=P_{0}^{2}+\left\langle \left\langle P_{2}^{2}\right\rangle
\right\rangle _{0}+\left\langle \left\langle P_{4}^{2}\right\rangle
\right\rangle _{0}
\end{equation}
and%
\begin{equation}
0\leq\left\Vert p\right\Vert _{HS}^{2}\leq1,
\end{equation}
We also have 
\begin{align}
\left\langle \left\langle PD_{\left( 4\right) }\right\rangle \right\rangle
_{0} & =\limfunc{tr}\left\{ PD_{\left( 4\right) }\right\} =P_{0}+\limfunc{tr}%
\left\{ \left\langle pp^{\dagger}\right\rangle _{2}d_{2}+\left\langle
pp^{\dagger}\right\rangle _{4}d_{4}\right\} =P_{0}+\limfunc{tr}\left\{
\left\langle pp^{\dagger}\right\rangle _{2}d_{2}+\left\langle
pp^{\dagger}\right\rangle _{4}d_{4}\right\} \\
& =P_{0}+\limfunc{tr}\left\{ \left\langle pp^{\dagger}\right\rangle
_{2}\left\langle QQ^{\dagger}\right\rangle _{2}+\left\langle pp^{\dagger
}\right\rangle _{4}\left\langle QQ^{\dagger}\right\rangle _{4}\right\}
\end{align}
Note 
\begin{align}
\limfunc{tr}\left\{ \left\langle pp^{\dagger}\right\rangle _{2}d_{2}\right\}
& =\left\langle \left\langle \left\langle pp^{\dagger }\right\rangle
_{2}d_{2}\right\rangle \right\rangle _{0}=\limfunc{tr}\left\{ \left\langle
pp^{\dagger}\right\rangle _{2}\left\langle QQ^{\dagger }\right\rangle
_{2}\right\} =\left\langle \left\langle \left\langle
pp^{\dagger}\right\rangle _{2}\left\langle QQ^{\dagger}\right\rangle
_{2}\right\rangle \right\rangle _{0}\neq0\text{ in general} \\
\limfunc{tr}\left\{ \left\langle pp^{\dagger}\right\rangle _{4}d_{4}\right\}
& =\left\langle \left\langle \left\langle pp^{\dagger }\right\rangle
_{4}d_{4}\right\rangle \right\rangle _{0}=\limfunc{tr}\left\{ \left\langle
pp^{\dagger}\right\rangle _{4}\left\langle QQ^{\dagger }\right\rangle
_{4}\right\} =\left\langle \left\langle \left\langle
pp^{\dagger}\right\rangle _{4}\left\langle QQ^{\dagger}\right\rangle
_{4}\right\rangle \right\rangle _{0}\neq0\text{ in general}
\end{align}
If $p=p^{2}=p^{\dagger}$ and $p$ is order of $4$ then 
\begin{equation}
\left\langle \left\langle p^{\dagger}Dp\right\rangle \right\rangle
_{0}=\left\langle \left\langle pD\right\rangle \right\rangle
_{0}=\left\langle \left\langle pD_{\left( 4\right) }\right\rangle
\right\rangle _{0}=\left\langle \left\langle p^{\dagger}D_{\left( 4\right)
}p\right\rangle \right\rangle _{0}=p_{0}+\limfunc{tr}\left\{
p_{2}\left\langle QQ^{\dagger}\right\rangle _{2}\right\} +\limfunc{tr}%
\left\{ p_{4}\left\langle QQ^{\dagger}\right\rangle _{4}\right\} .
\end{equation}

$\lceil$ Projection operations correspond to singular transformations, and
we now see that

these are represented by products of null multivectors in $\mathbb{R}_{n,n}$

This is sufficient to ensure that singular transformations can also be
represented by an even product of

vectors, some of which may now be null.

\begin{equation}
\frac{1}{\sqrt{2}}\left( x_{j}-ix_{j+r}\right) \frac{1}{\sqrt{2}}\left(
x_{j}-ix_{j+r}\right) =\frac{1}{2}\left( 1-1\right) =0
\end{equation}
$\rfloor$

\subsubsection{Bra Ket Projectors}

\begin{equation}
\left\vert Q\right\rangle _{\mathcal{A}}\left\langle Q\right\vert \notin%
\mathcal{A}
\end{equation}%
\begin{equation}
\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle
x_{j_{1}}\cdots x_{j_{p}}\right\vert \notin\mathcal{A}
\end{equation}

\section{Generation of the Geometric Algebra}

It is always true that 
\begin{equation}
\mathcal{F}=\tbigwedge \left( \mathcal{F}_{1}\right) ,
\end{equation}
if $\mathcal{F}_{1}$ is even dimensional it can be expressed in terms of a
self adjoint orthogonal basis $\left\{ \left. x_{j}\right\vert 1\leq
j\leq2r\right\} $ that leads to a direct sum decomposition%
\begin{equation}
\mathcal{F}_{1}=\mathbf{x}_{1}\oplus\mathbf{x}_{2}.
\end{equation}
This basis can be used to construct a non self adjoint nilpotent basis $%
\left\{ \left. b_{j}^{\dagger},b_{j}\right\vert 1\leq j\leq r\right\} ,$
that is orthogonal wrt $\left\langle \left. a\right\vert b\right\rangle _{%
\mathcal{F}}=\left\langle \left\langle a^{\dagger}b\right\rangle
\right\rangle ,$ but isotropic wrt $\left( \left. a\right\vert b\right) _{%
\mathcal{F}}=\left\langle \left\langle ab\right\rangle \right\rangle _{0},$%
which produces the direct sum decomposition 
\begin{equation}
\mathcal{F}_{1}=\mathbf{b}^{\dagger}\oplus\mathbf{b}\equiv\mathcal{F}%
_{b10}\oplus\mathcal{F}_{b01}\equiv\left( \mathbf{x}_{1}+i\mathbf{x}%
_{2}\right) \oplus\left( \mathbf{x}_{1}-i\mathbf{x}_{2}\right) .
\end{equation}
These bases are related by the transformation 
\begin{align}
K_{2rx}\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) & =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \mathcal{R}_{x}\left( K_{x}\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \mathbb{K}_{x}^{\dagger} \\
& =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbf{x}_{1}-i\mathbf{x}_{2} & \mathbf{x}_{1}+i\mathbf{x}_{2}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)
\end{align}
and are defined in terms of the action of the complexification $\widehat{%
J_{x}}.$ The spaces $\mathcal{F}_{b10},\mathcal{F}_{b10},\mathbf{b}^{\dagger}
$ and $\mathbf{b}$ are each closed under real linear combinations, while $%
\mathbf{b}^{\dagger}$ and $\mathbf{b}$ are also closed complex linear
combinations. The isotropic decomposition corresponds to the real bivector
(real geminal) complexification 
\begin{equation}
J_{x}\equiv g_{x}=\sum_{1\leq j\leq r}x_{j}x_{j+r}
\end{equation}
as 
\begin{align}
\widehat{J_{x}}\left( \left( x_{k}+ix_{k+r}\right) \right) & =\left[
\sum_{1\leq j\leq r}x_{j}x_{j+r},\left( x_{k}+ix_{k+r}\right) \right]
=i\left( x_{k}+ix_{k+r}\right) \\
\widehat{J_{x}}\left( \left( x_{k}-ix_{k+r}\right) \right) & =\left[
\sum_{1\leq j\leq r}x_{j}x_{j+r},\left( x_{k}-ix_{k+r}\right) \right]
=-i\left( x_{k}-ix_{k+r}\right) ,
\end{align}
leading to 
\begin{align}
i\widehat{J_{x}}\left( \left( x_{k}+ix_{k+r}\right) \right) & =\widehat{%
\mathcal{N}_{a}}\left( \left( x_{k}+ix_{k+r}\right) \right) =-\left(
x_{k}+ix_{k+r}\right) \\
i\widehat{J_{x}}\left( \left( x_{k}-ix_{k+r}\right) \right) & =\widehat{%
\mathcal{N}_{a}}\left( \left( x_{k}-ix_{k+r}\right) \right) =\left(
x_{k}-ix_{k+r}\right) ,
\end{align}
and 
\begin{align}
\widehat{J_{x}}\left( x_{k}\right) & =-x_{k+r} \\
\widehat{J_{x}}\left( x_{k+r}\right) & =x_{k}.
\end{align}
$\lceil$%
\begin{align}
& \left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,x_{1}\right]
=x_{1}x_{3}x_{1}+x_{2}x_{4}x_{1}-x_{1}x_{1}x_{3}-x_{1}x_{2}x_{4}=-\frac{1}{2}%
x_{3}-\frac{1}{2}x_{3}=-x_{3} \\
& \left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,x_{2}\right]
=x_{1}x_{3}x_{3}+x_{2}x_{4}x_{3}-x_{3}x_{1}x_{3}-x_{3}x_{2}x_{4}=\frac{1}{2}%
x_{1}+\frac{1}{2}x_{1}=x_{1}
\end{align}%
\begin{align}
\left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}+ix_{3}\right) %
\right] & =x_{1}x_{3}\left( x_{1}+ix_{3}\right) +x_{2}\left(
x_{1}+ix_{3}\right) -\left( x_{1}+ix_{3}\right) x_{1}x_{3}-\left(
x_{1}+ix_{3}\right) x_{2}x_{4}=-x_{3}+ix_{1}=i\left( x_{1}+ix_{3}\right) \\
\left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}-ix_{3}\right) %
\right] & =x_{1}x_{3}\left( x_{1}-ix_{3}\right) +x_{2}\left(
x_{1}-ix_{3}\right) -\left( x_{1}-ix_{3}\right) x_{1}x_{3}-\left(
x_{1}-ix_{3}\right) x_{2}x_{4}=-x_{3}-ix_{1}=-i\left( x_{1}-ix_{3}\right)
\end{align}%
\begin{align}
\left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}+ix_{3}\right) %
\right] & =i\left( x_{1}+ix_{3}\right) \\
\left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}-ix_{3}\right) %
\right] & =-i\left( x_{1}-ix_{3}\right)
\end{align}
$\rfloor$

Note that $K_{x}\in U\left( \mathcal{F}_{1}\right) \subset\mathcal{B}\left( 
\mathcal{F}_{1}\right) $ and \emph{cannot} be expressed as $\func{adj}\left(
k\right) ,$where $k\in\mathcal{F}_{\left( 2\right) \text{ }}$i.e$.$this
group cannot be realized as inner autmorphism generated the Lie algebra $%
\mathcal{F}_{\left( 2\right) \text{ }}.$ \#\#\#\#\#\#\#\#\#

The space $\mathbf{x}_{1}$ can be viewed as a $r$-dimensional complex space
by taking complex linear combinations of $\left\{ \left. x_{j}\right\vert
1\leq j\leq r\right\} $ i.e. 
\begin{equation}
\mathbf{x}_{1\mathbb{C}}=\mathbb{C-}\limfunc{linspan}\left\{ \left.
x_{j}\right\vert 1\leq j\leq r\right\} =\mathbf{x}_{1}\oplus_{\mathbb{C}}i%
\mathbf{x}_{1}=\mathbf{x}_{1}\oplus_{\mathbb{C}}\widehat{J_{x}}\mathbf{x}%
_{1}\cong\mathbf{x}_{1}\oplus_{\mathbb{C}}\mathbf{x}_{2}.
\end{equation}
This produces a $2r$-dimensional real space 
\begin{equation}
\mathbf{x}_{1\mathbb{R}}=\mathbb{R-}\limfunc{linspan}\left\{ \left.
x_{j},ix_{j}\right\vert 1\leq j\leq r\right\} ,
\end{equation}
which can be expressed as the real direct sum 
\begin{equation}
\mathbf{x}_{1\mathbb{R}}=\mathbf{x}_{1}\oplus_{\mathbb{R}}i\mathbf{x}_{1}=%
\mathbf{x}_{1}\oplus_{\mathbb{R}}\widehat{J_{x}}\mathbf{x}_{1}\cong\mathbf{x}%
_{1}\oplus_{\mathbb{R}}\mathbf{x}_{2},
\end{equation}
leading to 
\begin{equation}
\mathcal{F}_{1\mathbb{R}}\cong\mathbf{x}_{1\mathbb{R}}\oplus_{\mathbb{R}}%
\mathbf{x}_{2\mathbb{R}}.
\end{equation}
The spaces $\mathbf{x}_{2\mathbb{C}}$ and $\mathbf{x}_{2\mathbb{R}}$ can be
defined in a similar manner. The $2r$-complex space $\mathcal{F}_{1}$ can be
expressed as the complex direct sum 
\begin{equation}
\mathcal{F}_{1}\cong\mathcal{F}_{1\mathbb{C}}=\mathbf{x}_{1\mathbb{C}%
}\oplus_{\mathbb{C}}\mathbf{x}_{2\mathbb{C}}=\mathbf{x}_{1\mathbb{C}}\oplus_{%
\mathbb{R}}\mathbf{x}_{2\mathbb{C}}=\mathbf{x}_{1\mathbb{R}}\oplus_{\mathbb{C%
}}\mathbf{x}_{2\mathbb{R}}.
\end{equation}
(This space of course generates a $4r$-dimensional real space which we do
not use)

The geminal and associated complexification have cannonicl representations 
\begin{gather}
\widehat{J_{x}}\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \mathbb{J}_{x}=\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) ;\widehat{J_{x}}\in\mathcal{B}\left( \mathcal{F}_{1\mathbb{R}}\right)
\\
g_{x}\left( \left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \wedge\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \right) =g_{x}\left( 
\begin{array}{ccc}
\mathbf{x}_{1}\wedge\mathbf{x}_{1} & \mathbf{x}_{1}\wedge\mathbf{x}_{2} & 
\mathbf{x}_{2}\wedge\mathbf{x}_{2}%
\end{array}
\right) =\left( 
\begin{array}{ccc}
\mathbf{x}_{1}\wedge\mathbf{x}_{1} & \mathbf{x}_{1}\wedge\mathbf{x}_{2} & 
\mathbf{x}_{2}\wedge\mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{c}
\mathbf{0} \\ 
\mathbf{1} \\ 
\mathbf{0}%
\end{array}
\right) \\
g_{x}\in\mathcal{F}_{2\mathbb{R}}\subset\mathcal{F}_{2},\,\widehat{J_{x}}\in%
\mathcal{B}_{a}\left( \mathcal{F}_{1\mathbb{R}}\right) \subset \mathcal{B}%
\left( \mathcal{F}_{1\mathbb{R}}\right) .
\end{gather}
The correspondence $g_{x}\longleftrightarrow\widehat{J_{x}}$ displays the
isomorphism 
\begin{equation}
\mathcal{F}_{2\mathbb{R}x}\cong\mathcal{B}_{a}\left( \mathcal{F}_{1\mathbb{R}%
}\right) .
\end{equation}
The representation of the complexification has the properties%
\begin{align}
\mathbb{J}_{x}^{2} & =-\mathbb{I}_{\mathcal{F}_{1}}=\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) =\left( 
\begin{array}{cc}
-\mathbb{I}_{r} & \mathbb{O} \\ 
\mathbb{O} & -\mathbb{I}_{r}%
\end{array}
\right) \\
\mathbb{J}_{x}^{t}\mathbb{J}_{x} & =\mathbb{J}_{x}\mathbb{J}_{x}^{t}=\mathbb{%
I}_{\mathcal{F}_{1}}=\left( 
\begin{array}{cc}
\mathbb{O} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{I}_{r}%
\end{array}
\right) ,
\end{align}
i.e. $\widehat{J_{x}},\mathbb{J}_{x}\in O\left( 2r,\mathbb{R}\right) $ is a
complex structure. Moreover it defines a symplectic (antisymmetric bilinear)
form $\left\{ \left. a\right\vert b\right\} _{\mathcal{F}_{1x}}$ on the real
vector space $\mathcal{F}_{1\mathbb{R}x}$ by 
\begin{equation}
\left\{ \left. a\right\vert b\right\} _{\mathcal{F}_{1x}}=\left( a\left\vert 
\widehat{J_{x}}\right. b\right) _{\mathcal{F}_{1}},
\end{equation}
where 
\begin{equation}
\left( \left. a\right\vert \widehat{J_{2rx}}b\right) _{\mathcal{F}%
_{1}}=\left. \left( \left. a\right\vert \widehat{J_{x}}b\right) \right\vert
_{_{\mathcal{F}}},
\end{equation}
from the inner product 
\begin{equation}
\left( \left. a\right\vert b\right) _{\mathcal{F}_{1}}=\left\langle
\left\langle ab\right\rangle \right\rangle _{0}.
\end{equation}
In terms of real matrix representations 
\begin{equation}
\left\{ \left. a\right\vert b\right\} _{\mathcal{F}_{1x}}=\left( 
\begin{array}{cc}
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \left( 
\begin{array}{c}
\mathbf{b}^{\dagger} \\ 
\mathbf{b}%
\end{array}
\right) =\left( 
\begin{array}{cc}
-\mathbf{a} & \mathbf{a}^{\dagger}%
\end{array}
\right) \left( 
\begin{array}{c}
\mathbf{b}^{\dagger} \\ 
\mathbf{b}%
\end{array}
\right) =\left( \mathbf{a}^{\dagger}\right) ^{t}\mathbf{b}^{\dagger }-%
\mathbf{a}^{t}\mathbf{b}^{\dagger}.
\end{equation}
The complex structure $\widehat{J_{x}}$ is left invariant by $O\left( r,%
\mathbb{R}\right) $ 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbb{A}^{t} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{A}^{t}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{A} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{A}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{A}^{t} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{A}^{t}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{A} \\ 
-\mathbb{A} & \mathbb{O}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) .
\end{equation}
The symplectic form $\left\{ \left. \cdot\right\vert \cdot\right\} _{%
\mathcal{F}_{1x}}$ defines the symplectic group $Sp\left( 2r,\mathbb{R}%
\right) $ by 
\begin{equation}
Sp\left( 2r,\mathbb{R}\right) =\left\{ \left. T\in\mathcal{B}\left( \mathcal{%
F}_{1\mathbb{R}}\right) \right\vert \left\{ \left. Ta\right\vert Tb\right\}
_{\mathcal{F}_{1x}}=\left\{ \left. a\right\vert b\right\} _{\mathcal{F}%
_{1x}}\right\} ,
\end{equation}
which gives in terms of representations 
\begin{equation}
\mathbb{T}_{x}^{t}\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \mathbb{T}_{x}=\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) .
\end{equation}

General transformations of the bases that preserve the CAR are given by 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U} & \overline{\mathbb{V}} \\ 
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)
\end{equation}%
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{y}_{+} & \mathbf{y}_{-}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & \func{Im}\left( \mathbb{V+U}\right) \\ 
\func{Im}\left( \mathbb{V}-\mathbb{U}\right) & \func{Re}\left( \mathbb{U-V}%
\right)%
\end{array}
\right) .
\end{equation}
If $\mathbb{V=O}$ 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{O} \\ 
\mathbb{O} & \overline{\mathbb{U}}%
\end{array}
\right) ,
\end{equation}
the direct sum decomposition 
\begin{equation}
\mathbf{b}^{\dagger}\oplus\mathbf{b}
\end{equation}
is maintained and 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{O} \\ 
\mathbb{O} & \overline{\mathbb{U}}%
\end{array}
\right) \in U\left( r\right) .
\end{equation}
However 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & \func{Im}\left( \mathbb{V+U}\right) \\ 
\func{Im}\left( \mathbb{V}-\mathbb{U}\right) & \func{Re}\left( \mathbb{U-V}%
\right)%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U}\right) & \func{Im}\left( \mathbb{U}\right) \\ 
-\func{Im}\left( \mathbb{U}\right) & \func{Re}\left( \mathbb{U}\right)%
\end{array}
\right)
\end{equation}
and the direct sum decomposition 
\begin{equation}
\mathbf{b}^{\dagger}\oplus\mathbf{b}
\end{equation}
is not in general maintained, unless 
\begin{equation}
\func{Im}\left( \mathbb{U}\right) =\mathbb{O},
\end{equation}
i.e. 
\begin{equation}
\left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U}\right) & \mathbb{O} \\ 
\mathbb{O} & \func{Re}\left( \mathbb{U}\right)%
\end{array}
\right) \in O\left( r,\mathbb{R}\right) .
\end{equation}

$\lceil$Example for $\func{Im}\left( \mathbb{U}\right) \neq\mathbb{O}$%
\begin{align}
\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) & =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}} & 0 \\ 
0 & e^{-i\boldsymbol{\theta}}%
\end{array}
\right) =\left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}}\mathbf{b}^{\dagger} & e^{-i\boldsymbol{\theta}}%
\mathbf{b}%
\end{array}
\right) \\
\left( 
\begin{array}{cc}
\mathbf{y}_{+} & \mathbf{y}_{-}%
\end{array}
\right) & =\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}}\mathbf{b}^{\dagger}+e^{-i\boldsymbol{\theta}}%
\mathbf{b} & ie^{i\boldsymbol{\theta}}\mathbf{b}^{\dagger}-ie^{-i\boldsymbol{%
\theta}}\mathbf{b}%
\end{array}
\right) \\
& =\left[ \left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) \right] \left[ \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & \mathbb{I} \\ 
-i\mathbb{I} & i\mathbb{I}%
\end{array}
\right) \left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}} & 0 \\ 
0 & e^{-i\boldsymbol{\theta}}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) \right] \\
& =\left[ \left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) \right] \left[ \frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{I} & \mathbb{I} \\ 
-i\mathbb{I} & i\mathbb{I}%
\end{array}
\right) \left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}} & ie^{i\boldsymbol{\theta}} \\ 
e^{-i\boldsymbol{\theta}} & -ie^{-i\boldsymbol{\theta}}%
\end{array}
\right) \right] \\
& =\left( 
\begin{array}{cc}
\mathbf{x}_{+} & \mathbf{x}_{-}%
\end{array}
\right) \frac{1}{2}\left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}}+e^{-i\boldsymbol{\theta}} & i\left( e^{i\boldsymbol{%
\theta}}\mathbb{-}e^{-i\boldsymbol{\theta}}\right) \\ 
i\left( e^{-i\boldsymbol{\theta}}\mathbb{-}e^{i\boldsymbol{\theta}}\right) & 
e^{i\boldsymbol{\theta}}+e^{-i\boldsymbol{\theta}}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{+} & \mathbf{x}_{-}%
\end{array}
\right) \left( 
\begin{array}{cc}
\cos\boldsymbol{\theta} & \sin\boldsymbol{\theta} \\ 
-\sin\boldsymbol{\theta} & \cos\boldsymbol{\theta}%
\end{array}
\right) ,
\end{align}
as%
\begin{align}
2\cos\theta & =e^{i\theta}+e^{-i\theta} \\
2\sin\theta & =i\left( e^{i\theta}-e^{-i\theta}\right) .
\end{align}
$\rfloor$

\bigskip

Hence 
\begin{align}
\mathcal{F} & =\tbigwedge \mathcal{F}_{1}=\tbigwedge \left( \mathbf{b}%
^{\dagger}\oplus\mathbf{b}\right) =\tbigwedge \mathbf{b}^{\dagger}\otimes%
\tbigwedge \mathbf{b} \\
\mathcal{F} & =\tbigwedge \mathcal{F}_{1}=\tbigwedge \left( \mathbf{x}%
_{1}\oplus\mathbf{x}_{2}\right) =\tbigwedge \mathbf{x}_{1}\otimes\tbigwedge 
\mathbf{x}_{2}.
\end{align}
$\lceil K_{2rx}$ is unitary $\in U\left( 2r\right) $ i.e. 
\begin{align}
\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right) & =\frac{1}{2}\left( 
\begin{array}{cc}
2\mathbb{I}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & 2\mathbb{I}_{r}%
\end{array}
\right) =\mathbb{I}_{2r} \\
\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) & =\frac{1}{2}\left( 
\begin{array}{cc}
2\mathbb{I}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & 2\mathbb{I}_{r}%
\end{array}
\right) =\mathbb{I}_{2r}
\end{align}
and left invariant by the unitary group $U\left( r\right) $ i.e. 
\begin{align}
& \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger}%
\end{array}
\right) \\
& =\left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right) \mathbb{I}_{2r}\left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger}%
\end{array}
\right) =\mathbb{I}_{2r}
\end{align}
and%
\begin{align*}
& \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{U}_{r} \\ 
-i\mathbb{U}_{r} & i\mathbb{U}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger}%
\end{array}
\right) \\
& =\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{U}_{r}\mathbb{U}_{r}^{\dagger} \\ 
-i\mathbb{U}_{r}\mathbb{U}_{r}^{\dagger} & i\mathbb{I}_{r}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) .
\end{align*}
$\rfloor\lceil$%
\begin{align}
& \frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) \\
& =\frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{U}_{r} & i\mathbb{U}_{r} \\ 
\mathbb{U}_{r} & -i\mathbb{U}_{r}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right)
\end{align}%
\begin{equation}
\left[ \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}
\right) ,\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) \right] =\mathbb{O}_{2r}
\end{equation}
$\rfloor$

Different decompositions are determined by the coset 
\begin{equation}
\left[ O\left( 2r,\mathbb{R}\right) /U\left( r\right) \right] \left[ U\left(
r\right) /O\left( r,\mathbb{R}\right) \right]
\end{equation}%
\begin{equation}
O\left( 2r,\mathbb{R}\right) \supset U\left( r\right) \supset O\left( r,%
\mathbb{R}\right)
\end{equation}%
\begin{align}
\mathcal{R}_{x}\left( O\left( r,\mathbb{R}\right) \right) & =\left( 
\begin{array}{cc}
\cos\boldsymbol{\theta} & \mathbb{O} \\ 
\mathbb{O} & \cos\boldsymbol{\theta}%
\end{array}
\right) \\
\mathcal{R}_{x}\left( U\left( r\right) \right) & =\left( 
\begin{array}{cc}
\cos\boldsymbol{\theta} & \sin\boldsymbol{\theta} \\ 
-\sin\boldsymbol{\theta} & \cos\boldsymbol{\theta}%
\end{array}
\right) \\
\mathcal{R}_{x}\left( O\left( 2r,\mathbb{R}\right) \right) & =\left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & \func{Im}\left( \mathbb{V+U}\right) \\ 
\func{Im}\left( \mathbb{V}-\mathbb{U}\right) & \func{Re}\left( \mathbb{U-V}%
\right)%
\end{array}
\right) .
\end{align}

\subsection{Complexification of $\mathcal{F}_{1x\mathbb{R}}$}

The space $\mathcal{F}_{1x\mathbb{R}}$ can be complexified to give $\mathcal{%
F}_{1x\mathbb{C}}$ by introducing the definition 
\begin{equation}
ia\equiv\widehat{J_{2rx}^{t}}a=-\widehat{J_{2rx}}a;a\in\mathcal{F}_{1x%
\mathbb{R}}
\end{equation}
and $\widehat{J_{2rx}}$ is defined as above. Hence $\mathcal{F}_{1x\mathbb{C}%
}$ is given as 
\begin{equation}
\mathcal{F}_{1x\mathbb{C}}=\left\{ \left. a=\left( a_{1},a_{2}\right)
\right\vert a=a_{1}+a_{2}\right\} =\left\{ \left. a_{1}+ia_{2}\right\vert
a=a_{1}+a_{2}\right\}
\end{equation}
and%
\begin{equation}
i\left( a_{1}+ia_{2}\right) =ia_{1}-a_{2}=-a_{2}+ia_{1}\equiv\left(
-a_{2},a_{1}\right)
\end{equation}%
\begin{equation}
-\widehat{J_{2rx}}a=-\widehat{J_{2rx}}\left( a_{1},a_{2}\right) =\left(
-a_{2},a_{1}\right)
\end{equation}
$\lceil$%
\begin{equation}
\widehat{J_{2rx}}a=\widehat{J_{2rx}}\left( \mathbf{x}_{1}\mathbf{x}%
_{2}\right) \left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{a}_{2}%
\end{array}
\right) =\left( \mathbf{x}_{1}\mathbf{x}_{2}\right) \mathbb{J}_{2rx}\left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{a}_{2}%
\end{array}
\right) =\left( \mathbf{x}_{1}\mathbf{x}_{2}\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right) \left( 
