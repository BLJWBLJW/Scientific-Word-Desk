	publisher = {ACS},
	month = {29 March 2001},
	year = {2001},
	keywords = {Atom-ion reactions; Ion-molecule reactions; Quantum theory; Electron nuclear dynamics; Time-dependent nonadiabatic approach; Molecular processes; ENDyne code; Nuclei classical particles; Electrons complex spin unrestricted determinant; Ion-atom reactive collisions; Ion-molecule reactive collisions; Full quantum mechanical treatment},
	language = {English},
	abstract = {The electron nuclear dynamics (END) theory is a time-dependent, nonadiabatic approach to molecular processes. It has been implemented in the ENDyne code at the level of approximation that treats the nuclei as classical particles and represents the electrons with a single complex spin unrestricted determinant. This level of theory has been successfully applied to a wide range of ion-atom and ion-molecule reactive collisions. In this paper the extensions of the END theory are outlined in some detail through a hierarchy of approximations to the level of full quantum mechanical treatment of all participating particles.}
}

