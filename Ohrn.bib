	keywords = {Quantum statistical mechanics; Macroscopic systems; Ordering; Order indices; Reduced density matrices; Microscopic properties; Boson systems; Fermion systems; Time-dependent indices; Nonequilibrium processes; Mid-range order; Stability conditions; Two-velocity motion},
	language = {English},
	abstract = {In A.J. Coleman and V.I. Yukalov: Mod. Phys. Lett. B, 5, 1679 (1991) and Nuovo Cimento B, 107, 535 (1992) we introduced order indices of reduced density matrices as a tool to connect macroscopic and microscopic properties of physical systems. In the present paper, we give a definition of order indices which is independent of the representation of the density matrices and is valid for both fermion and boson systems and for all types of order: short, mid and long range. Time-dependent indices are introduced to permit discussion of non-equilibrium processes. Special attention is devoted to the study of mid-range order and the corresponding stability conditions. Mid-range order is examined both in a system at rest and in a system with two-velocity motion.}
}

@article{Ohrn93,
