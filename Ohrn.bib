	volume = {48},
	number = {2},
	pages = {1093-7},
	month = {Aug. 1993},
	year = {1993},
	keywords = {Atomic structure; Molecular energy level calculations; Spin-orbit interactions; Thouless coherent state; 1/K expansion; Many-electron problem; Spin-orbital basis; Hamiltonian; Unitary group; Coherence group; Global symmetry; Dynamical variables; Complex state parameters; Flat generalized phase space; Energy functional; Power series},
	language = {English},
	abstract = {The many-electron problem in a spin-orbital basis of rank K, with a Hamiltonian exhibiting the unitary group U(K) (the coherence group), global symmetry is treated as a detailed example of the technique often referred to as the 1/K expansion. This approach introduces a free parameter K, which is a measure of the number of dynamical variables and usually also invokes coherent states associated with the coherence group. The authors choose the Thouless coherent state, transform the complex state parameters so that they exhibit the structure of a flat generalized phase space, and analyze the corresponding energy functional as a power series in 1/K. The limit of large K and that of a large number of electrons are discussed and compared to the expected classical limit.}
}

