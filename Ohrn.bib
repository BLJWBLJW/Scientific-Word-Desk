	journal = {Physical Review A [Atomic, Molecular, and Optical Physics]},
	volume = {56},
	number = {6},
	pages = {4996-5003},
	publisher = {APS through AIP},
	month = {Dec. 1997},
	year = {1997},
	keywords = {Hydrogen compounds; Lithium compounds; Photoexcitation; Quantum optics; Vibrational states; Electron nuclear dynamics theory; LiH; HF; Intense IR laser field; Time-dependent external field; Full electron nuclear coupling terms; Dynamical equations; Vibrational excitations; Simple diatomics; Electron-field coupling; Molecular dynamics; Quantum wave-packet calculations; Nonadiabatic electron-nuclear coupling terms; Vibrational dynamics; Born-Oppenheimer approximation; Photoexcitation},
	language = {English},
	abstract = {The electron nuclear dynamics theory (END) extended to include a time-dependent external field is briefly described. The dynamical equations, in addition to the full electron nuclear coupling terms, now also contain the interactions of both the nuclei and the electrons with the external field. This extended END theory is applied to the study of vibrational excitations of the simple diatomics HF and LiH. The END results using an intense infrared laser field are compared with those of molecular dynamics as well as those from quantum wave-packet calculations. While the effect of the nonadiabatic electron-nuclear coupling terms on the vibrational dynamics is negligible for the chosen application, the electron-field coupling has a significant impact.}
}

@article{Coleman97,
	author = {A.J. Coleman},
	title = {The AGP model for fermion systems},
	journal = {International Journal of Quantum Chemistry},
	volume = {63},
	number = {1},
	pages = {23-30},
	publisher = {Wiley},
	month = {15 May 1997},
	year = {1997},
	keywords = {Eigenvalues and eigenfunctions; Fermion systems; AGP model; Fermion systems; Mathematically rigorous treatment; Antisymmetrized geminal power model; Single Slater determinant; Highly correlated wave function; First-order reduced density matrix; Evenly degenerate eigenvalues; One-particle properties; Second-order density matrix; Anomalous Green's function; Antisymmetrised geminal power state energy},
	language = {English},
	abstract = {A mathematically rigorous treatment of the antisymmetrized geminal power (AGP) model is given. The model is advocated as an extremely flexible tool for studying a wide variety of fermion systems, characterized by a single Slater determinant, on the one hand, or Yang's most highly correlated wave function, on the other. When the first-order reduced density matrix of the actual system has eigenvalues which are evenly degenerate, the model can treat one-particle properties exactly. A formula is obtained for the precise energy of an AGP state in the Born-Oppenheimer approximation. An estimate is given of the error which occurs when the second-order density matrix of an AGP state is approximated by the widely used expression involving the so-called anomalous Green's function.}
}

@article{Coleman73,
