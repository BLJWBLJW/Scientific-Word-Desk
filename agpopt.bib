  month = {15 Sept. 1985},
  year = 1985,
  title = {Calculation of spectroscopic properties of the ground and excited
          states of Be/sub 2/ according to the antisymmetrized geminal power
          (AGP) based excitation propagator},
  journal = {J. Chem. Phys.},
  volume = 83,
  number = 6,
  pages = {2965-71},
  abstract = {The ground and excited states of the beryllium dimer are
             calculated using the antisymmetrized geminal power-Tamm Dancoff
             approximation (AGP-TDA) that produces the excited states from a
