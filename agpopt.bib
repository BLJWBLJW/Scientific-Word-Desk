@ARTICLE{Dobaczewski00,
  author = {J. Dobaczewski},
  month = {July 2000},
  year = 2000,
  title = {Generalization of the Bloch-Messiah-Zumino theorem},
  journal = {Phys. Rev. C [Nucl. Phys.]},
  volume = 62,
  number = 1,
  pages = {017301/1-4},
  publisher = {APS through AIP},
  abstract = {It is shown how to construct a basis in which two arbitrary
             complex antisymmetric matrices C and C' acquire simultaneously
             canonical forms. The present construction is not restricted by
             any conditions on the properties of the C/sup +/C' matrix.
             Canonical bases pertaining to the generator-coordinate-method
             treatment of many-fermion systems are discussed.},
  keywords = {BCS theory; Fermion systems; Matrix algebra;
             Bloch-Messiah-Zumino theorem; Complex antisymmetric matrices;
             Canonical bases; Generator-coordinate-method; Many-fermion
             systems; Antisymmetric matrices},
  language = {English}
}
@ARTICLE{Sangfelt87,
  author = {E. Sangfelt and R.R. Chowdhury and B. Weiner and Y. {\"O}hrn},
  month = {15 April 1987},
  year = 1987,
  title = {Generalized Tamm-Dancoff approximation (GTDA) and random-phase
          approximation (GRPA) calculations on LiH, Be, and Li/sub 2/},
  journal = {J. Chem. Phys.},
  volume = 86,
  number = 8,
  pages = {4523-30},
  abstract = {The theory for polarization propagator calculations based on a
             correlated reference state in the form of a spin singlet
             restricted antisymmetrized geminal power (AGP) is discussed.
             Particular attention is paid to the calculation of excitation
             energies and transition moments for the molecules over all
             internuclear separations, i.e., not just single point vertical
             energies, which is done in standard RPA or in higher-order
             treatments using perturbation methods. Simple applications to the
             Be atom, and the LiH and Li/sub 2/ molecules are used to
             illustrate how this simple correlated state, which completely
             determined by the choice of orbital basis (i.e., no choice of
             configurations is necessary), can cure the notorious consistency
             problems and the instabilities against the breaking of symmetry,
             which plague standard RPA based on a Hartree-Fock (HF) single
             determinantal reference state.},
  keywords = {Atomic structure; Beryllium; Lithium; Lithium compounds;
             Molecular energy level calculations; RPA calculations;
             Generalised Tamm-Dancoff approximation; Generalised random-phase
             approximation; Symmetry breaking; Hartree-Fock state; Eigenvalue
             problem; Polarization propagator calculations; Correlated
             reference state; Spin singlet restricted antisymmetrized geminal
             power; Excitation energies; Transition moments; Internuclear
             separations; Orbital basis; Consistency problems; Instabilities;
             Single determinantal reference state; Be; Li/sub 2/; LiH},
  language = {English}
}
@ARTICLE{Weiner87,
  author = {B. Weiner and Y. {\"O}hrn},
  month = {29 Jan. 1987},
  year = 1987,
  title = {Correlated electronic states of the LiH molecule studied with the
          polarization propagator},
  journal = {J. Phys. Chem.},
  volume = 91,
  number = 3,
  pages = {563-70},
  abstract = {The polarization propagator technique with an antisymmetrized
             geminal power reference is briefly outlined in its spin singlet
             restricted form and applied to the study of the X/sup 1/ sigma
             /sup +/ and the A/sup 1/ Sigma /sup +/ states of LiH at various
             internuclear separations. Emphasis is put on a pictorial and
             qualitative description of the quite complex correlated
             electronic states, which show the expected charge distributions
             in the bonding region as well as at separation.},
  keywords = {Bonds [chemical]; Lithium compounds; Molecular electronic
             states; X/sup 1/ Sigma /sup +/ states; Electronic states;
             Polarization propagator; Spin singlet; A/sup 1/ Sigma /sup +/
             states; Internuclear separations; Charge distributions; Bonding
             region; LiH},
  language = {English}
}
@ARTICLE{Weiner85,
