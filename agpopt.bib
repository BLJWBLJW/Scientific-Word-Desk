@ARTICLE{Silver69,
  author = {D. M. Silver},
  month = {15 June 1969},
  year = 1969,
  title = {Natural orbital expansion of interacting geminals},
  journal = {J. Chem. Phys.},
  volume = 50,
  number = 12,
  pages = {5108-16},
  abstract = {An antisymmetrized product of 'interacting' geminals is proposed
             for the form of a many-electron wavefunction. The interacting
             geminals are given a natural orbital expansion where the natural
             orbitals of the geminals are also natural orbitals of the total
             wavefunction. This ansatz is more general than the strongly and
             weakly orthogonal geminal and identical geminal models and
             includes them as particular cases. However, the use of the
             interacting geminal wavefunction is not significantly more
             complicated for the purpose of calculations. Different
             constraints on the geminal occupation coefficients define the
             various geminal models and more than one model can be
             incorporated into a single wavefunction.},
  keywords = {Orbital calculation methods;},
  language = {English}
}
