             Antisymmetrized geminal power; Excitation propagator;
             Antisymmetrized geminal power-Tamm Dancoff approximation;
             Correlated reference ground state; Excitation propagator},
  language = {English}
}
@ARTICLE{Weiner85b,
  author = {B. Weiner and H. A. Kurtz},
  month = {June 1985},
  year = 1985,
  title = {The antisymmetrized geminal power approximation to the excitation
          propagator},
  journal = {Int. J. Quantum Chem.},
  volume = 27,
  number = 6,
  pages = {469-80},
  abstract = {A consistent propagator approximation, denoted as the excitation
             propagator, is introduced. This propagator describes excitations
             between N-particle states and its approximation has properties
             required of consistent random phase approximation schemes.
             Several properties of this propagator are explored when based on
             a generalized antisymmetrized geminal power wavefunction. How
             singularities in the metric occur and how to remove them is
             discussed in detail. The excitation propagator is also contrasted
             with the principal (polarization) propagator.},
  keywords = {Molecular energy level calculations; Principal polarisation
             propagator; Random phase approximation; Random phase
             approximation; Linearised time dependent Hartree-Fock method;
             Vacuum state; Referenc e state; Antisymmetrized geminal power
             approximation; Excitation propagator; Propagator approximation;
             N-particle states; Random phase approximation; Antisymmetrized
             geminal power wavefunction; Singularities; Metric},
  language = {English}
}
