\section{ Canonical Coordinates}

\begin{theorem}
If $\mathbf{c}$ is a $2s\times 2s$ complex antisymmetric matrix then there
exists a unitary matrix $\mathbb{T}$ such that 
\begin{equation}
\mathbb{T}\mathbf{c}\mathbb{T}^{t}=\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\zeta } \\ 
-\mathbf{\zeta } & \mathbf{0}%
\end{array}%
\right) 
\end{equation}%
where 
\begin{equation}
\mathbf{\zeta =}\left( 
\begin{array}{ccc}
\zeta _{1} & 0 & 0 \\ 
0 & \ddots  & 0 \\ 
0 & 0 & \zeta _{s}%
\end{array}%
\right) ;\qquad \zeta _{j}\in \mathbb{C},\quad 1\leq j\leq s
\end{equation}

\begin{proof}
We first note some relationships implied by the antisymmetry of $\mathbf{c}$%
\begin{equation}
\mathbf{c}^{\dagger }\mathbf{c\,=-c}^{\ast }\mathbf{c}=\left( \mathbf{cc}%
^{\dagger }\right) ^{t}=\mathbf{\,}\left( \mathbf{cc}^{\dagger }\right)
^{\ast }  \label{cc}
\end{equation}%
(so $\mathbf{c}$ is not a normal operator in general) and one by the
associativity of matrix product 
\begin{equation}
\mathbf{c}\left( \mathbf{c}^{\dagger }\mathbf{c}\right) =\left( \mathbf{cc}%
^{\dagger }\right) \mathbf{c}
\end{equation}%
which by using eq. $\left( \ref{cc}\right) $ gives 
\begin{equation}
\left( \mathbf{cc}^{\dagger }\right) \mathbf{c=c}\left( \mathbf{cc}^{\dagger
}\right) ^{\ast }  \label{cr}
\end{equation}%
Then we introduce $\mathbf{c}_{U}\mathbf{c}_{U}^{\dagger }$ through the
definition 
\begin{eqnarray}
\mathbf{c} &=&\mathbb{U}\mathbf{c}_{U}\mathbb{U}^{t} \\
\mathbf{c}_{U} &=&\mathbb{U}^{\dagger }\mathbf{c}\mathbb{U}^{\ast }
\end{eqnarray}%
where $\mathbb{U}$ is any unitary matrix and obtain that 
\begin{eqnarray}
\mathbf{cc}^{\dagger } &=&\mathbb{U}\mathbf{c}_{U}\mathbb{U}^{t}\mathbb{U}%
^{\ast }\mathbf{c}_{U}^{\dagger }\mathbb{U}^{\dagger }=\mathbb{U}\mathbf{c}%
_{U}\mathbf{c}_{U}^{\dagger }\mathbb{U}^{\dagger }  \notag \\
\mathbf{c}_{U}\mathbf{c}_{U}^{\dagger } &=&\mathbb{U}^{\dagger }\mathbf{cc}%
^{\dagger }\mathbb{U}
\end{eqnarray}%
and as $\mathbf{c}_{U}$ is also antisymmetric 
\begin{equation}
\mathbf{c}_{U}\mathbf{c}_{U}^{\dagger }=-\mathbf{c}_{U}\mathbf{c}_{U}^{\ast
}=\left( \mathbf{c}_{U}^{\dagger }\mathbf{c}_{U}\right) ^{t}=\mathbf{\,}%
\left( \mathbf{c}_{U}^{\dagger }\mathbf{c}_{U}\right) ^{\ast }.
\end{equation}%
Hence we have that 
\begin{equation}
\left( \mathbf{cc}^{\dagger }\right) \mathbf{c-c}\left( \mathbf{cc}^{\dagger
}\right) ^{\ast }=\left( \mathbf{c}_{U}\mathbf{c}_{U}^{\dagger }\right) 
\mathbf{c}_{U}-\mathbf{c}_{U}\left( \mathbf{c}_{U}\mathbf{c}_{U}^{\dagger
}\right) ^{\ast }=0  \label{cu}
\end{equation}%
We can choose $\mathbb{U}$ to diagonalize the hermitian matrix $\mathbf{cc}%
^{\dagger }$ i.e.%
\begin{equation}
\mathbb{U}^{\dagger }\mathbf{cc}\mathbb{^{\dagger }U}=\left( 
\begin{array}{ccc}
n_{1} & 0 & 0 \\ 
0 & \ddots & 0 \\ 
0 & 0 & n_{r}%
\end{array}%
\right) =\mathbf{c}_{U}\mathbf{c}_{U}^{\dagger };\qquad n_{j}\geq 0\quad
1\leq j\leq r=2s.
\end{equation}%
Note that the eigenvectors $\left\{ u_{j}\right\} $ are only defined
uniquely up to an overall complex phase factor and linear combinations of
vectors associated to degenerate eigenvalues. $\lceil $The eigenvalues $%
\left\{ n_{j}\right\} $ are at least doubly degenerate.$\rfloor $ Now using
the relationships in eq. $\left( \ref{cu}\right) $ for this $\mathbf{c}_{U}$
we obtain%
\begin{equation}
\sum_{1\leq j\leq r}\left\{ n_{i}\delta _{ij}c_{Ujk}-c_{Uij}n_{j}\delta
_{jk}\right\} =0\Rightarrow \left( n_{i}-n_{k}\right) c_{Uik}=0;\qquad 1\leq
i,k\leq r
\end{equation}%
which shows that 
\begin{equation}
n_{k}\neq n_{i}\Rightarrow c_{Uik}=0;\qquad \qquad 1\leq i,k\leq r
\end{equation}%
Thus the matrix $\mathbf{c}_{U}$ breaks into submatrices $\left\{ \mathbb{C}%
_{\kappa };1\leq \kappa \leq p\right\} $ corresponding to groups of $%
n^{\prime }s$ that are equal. Consider the partitioning of $\left\{ 1,\ldots
,r\right\} $ into $p$ groups that correspond to equal $n^{\prime }s$ i.e. $%
\left\{ \left\{ \sigma \left( 1\right) ,\ldots ,\sigma \left( m_{1}\right)
\right\} ,\cdots ,\left\{ \sigma \left( m_{p-1}+1\right) ,\ldots \sigma
\left( r\right) \right\} \right\} $ where $\sigma $ is a permutation of $%
\left\{ 1,\ldots ,r\right\} $ and 
\begin{eqnarray}
n_{\sigma \left( 1\right) } &=&n_{\sigma \left( 2\right) }=\cdots =n_{\sigma
\left( m_{1}\right) }=\eta _{1}  \notag \\
&&\vdots  \notag \\
n_{\sigma \left( m_{p-1}+1\right) } &=&n_{\sigma \left( m_{p-1}+2\right)
}=\cdots =n_{\sigma \left( r\right) }=\eta _{p}
\end{eqnarray}%
then the matrix $\mathbf{c}_{U}$ has the block diagonal form 
\begin{equation}
\mathbf{c}_{U}=\left( 
\begin{array}{cccc}
\mathbb{C}_{1} & \mathbf{O} & \cdots & \mathbf{O} \\ 
\mathbf{O} & \ddots & \mathbf{O} & \vdots \\ 
\vdots & \mathbf{O} & \ddots & \mathbf{O} \\ 
\mathbf{O} & \cdots & \mathbf{O} & \mathbb{C}_{p}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathbb{C}_{\kappa }\mathbb{C}_{\kappa }^{\dagger }=\eta _{\kappa }\mathbb{I}%
_{d\left( \kappa \right) };\quad 1\leq \kappa \leq p
\end{equation}%
where $d\left( \kappa \right) $ is the dimension of $\kappa ^{th}$-block.

If $\eta _{\kappa }=0$ then 
\begin{equation}
\sum_{k\in \left\{ \sigma \left( m_{\kappa -1}+1\right) ,\ldots \sigma
\left( m_{\kappa }\right) \right\} }c_{\kappa ik}c_{\kappa jk}^{\ast
}=0\qquad \forall i,j\in \left\{ \sigma \left( m_{\kappa -1}+1\right)
,\ldots ,\sigma \left( m_{\kappa }\right) \right\}
\end{equation}%
so in particular 
\begin{equation}
\sum_{k\in \left\{ \sigma \left( m_{\kappa -1}+1\right) ,\ldots \sigma
\left( m_{\kappa }\right) \right\} }\left| c_{\kappa jk}\right| ^{2}=0\qquad
\forall j\in \left\{ \sigma \left( m_{\kappa -1}+1\right) ,\ldots ,\sigma
\left( m_{\kappa }\right) \right\}
\end{equation}%
which implies that $c_{\kappa jk}=0\quad \forall j,k\in \left\{ \sigma
\left( m_{\kappa -1}+1\right) ,\ldots ,\sigma \left( m_{\kappa }\right)
\right\} $.

If $\eta _{\kappa }\neq 0$ then $\mathbb{B}_{\kappa }=\frac{1}{\sqrt{\eta
_{\kappa }}}\mathbb{C}_{\kappa }$ is a $d\left( \kappa \right) \times
d\left( \kappa \right) $ antisymmetric unitary matrix and 
\begin{eqnarray}
\mathbb{B}_{\kappa }^{\dagger }\mathbb{B}_{\kappa } &=&\mathbb{B}_{\kappa }%
\mathbb{B}_{\kappa }^{\dagger }=\mathbb{I}_{d\left( \kappa \right) }  \notag
\\
&\Rightarrow &\mathbb{B}_{\kappa }^{\ast }\mathbb{B}_{\kappa }=\mathbb{B}%
_{\kappa }\mathbb{B}_{\kappa }^{\ast }
\end{eqnarray}%
i.e. $\left[ \mathbb{B}_{\kappa },\mathbb{B}_{\kappa }^{\ast }\right] =0$
thus the matrices $\left\{ \mathbb{N}_{\kappa },\mathbb{M}_{\kappa }\right\} 
$ defined as 
\begin{eqnarray}
\mathbb{N}_{\kappa } &=&\frac{1}{2}\left\{ \mathbb{B}_{\kappa }+\mathbb{B}%
_{\kappa }^{\ast }\right\}  \notag \\
\mathbb{M}_{\kappa } &=&\frac{-i}{2}\left\{ \mathbb{B}_{\kappa }-\mathbb{B}%
_{\kappa }^{\ast }\right\}
\end{eqnarray}%
so that 
\begin{equation}
\mathbb{B}_{\kappa }=\mathbb{N}_{\kappa }+i\mathbb{M}_{\kappa }
\end{equation}%
are real antisymmetric and \emph{commute }with each other. These matrices
can be simultaneously transformed into the canonical forms 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\alpha }_{\kappa } \\ 
-\mathbf{\alpha }_{\kappa } & \mathbf{0}%
\end{array}%
\right) \text{ and }\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\beta }_{\kappa } \\ 
-\mathbf{\beta }_{\kappa } & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
by a real orthogonal transformation $\mathbb{O}_{\kappa }$, where 
\begin{equation}
\mathbf{\alpha }_{\kappa }=\left( 
\begin{array}{ccc}
\alpha _{\kappa 1} & 0 & 0 \\ 
0 & \ddots & 0 \\ 
0 & 0 & \alpha _{\kappa d\left( \kappa \right) }%
\end{array}%
\right) \text{ and }\mathbf{\beta }_{\kappa }=\left( 
\begin{array}{ccc}
\beta _{\kappa 1} & 0 & 0 \\ 
0 & \ddots & 0 \\ 
0 & 0 & \beta _{\kappa d\left( \kappa \right) }%
\end{array}%
\right)
\end{equation}%
The same transformation thus acts on $\mathbb{B}_{\kappa }$ to produce 
\begin{equation}
\mathbb{O}_{\kappa }^{t}\mathbb{B}_{\kappa }\mathbb{O}_{\kappa }=\mathbb{O}%
_{\kappa }^{t}\left\{ \mathbb{N}_{\kappa }+i\mathbb{M}_{\kappa }\right\} 
\mathbb{O}_{\kappa }=\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\alpha }_{\kappa }+i\mathbf{\beta }_{\kappa } \\ 
-\left( \mathbf{\alpha }_{\kappa }+i\mathbf{\beta }_{\kappa }\right) & 
\mathbf{0}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{0} & e^{i\mathbf{\theta }_{\kappa }} \\ 
-e^{i\mathbf{\theta }_{\kappa }} & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
and thus%
\begin{equation}
\mathbb{O}_{\kappa }^{t}\mathbb{C}_{\kappa }\mathbb{O}_{\kappa }=\eta
_{\kappa }^{\frac{1}{2}}\left( 
\begin{array}{cc}
\mathbf{0} & e^{i\mathbf{\theta }_{\kappa }} \\ 
-e^{i\mathbf{\theta }_{\kappa }} & \mathbf{0}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{0} & \eta _{\kappa }^{\frac{1}{2}}e^{i\mathbf{\theta }_{\kappa }} \\ 
-\eta _{\kappa }^{\frac{1}{2}}e^{i\mathbf{\theta }_{\kappa }} & \mathbf{0}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\zeta }_{\kappa } \\ 
-\mathbf{\zeta }_{\kappa } & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
(which is valid even when $\eta _{\kappa }=0$) $\lceil $Note that $\mathbf{%
\theta }_{\kappa }\equiv \left( \theta _{\kappa 1},\ldots ,\theta _{\kappa
d\left( \kappa \right) }\right) $ and $\theta _{\kappa i}\neq \theta
_{\kappa j}$ in general$\rfloor $ where 
\begin{equation}
\mathbf{\zeta }_{\kappa }=\left( 
\begin{array}{ccc}
\zeta _{\kappa 1} & 0 & 0 \\ 
0 & \ddots & 0 \\ 
0 & 0 & \zeta _{\kappa d\left( \kappa \right) }%
\end{array}%
\right) .
\end{equation}%
This allows us to define 
\begin{equation}
\mathbb{O=}\left( 
\begin{array}{ccc}
\mathbb{O}_{1} & \mathbf{0} & \mathbf{0} \\ 
\mathbf{0} & \ddots & \mathbf{0} \\ 
\mathbf{0} & \mathbf{0} & \mathbb{O}_{p}%
\end{array}%
\right)
\end{equation}%
and see that 
\begin{equation}
\mathbb{O}^{t}\mathbf{c}_{U}\mathbb{O}=\left( 
\begin{array}{ccc}
\begin{array}{cc}
\mathbf{0} & \mathbf{\zeta }_{1} \\ 
-\mathbf{\zeta }_{1} & \mathbf{0}%
\end{array}
& \mathbf{0} & \mathbf{0} \\ 
\mathbf{0} & \ddots & \mathbf{0} \\ 
\mathbf{0} & \mathbf{0} & 
\begin{array}{cc}
\mathbf{0} & \mathbf{\zeta }_{p} \\ 
-\mathbf{\zeta }_{p} & \mathbf{0}%
\end{array}%
\end{array}%
\right)  \label{cor1}
\end{equation}%
and by rearranging the columns of $\mathbb{O}$ to produce $\widetilde{%
\mathbb{O}}$ we obtain 
\begin{equation}
\widetilde{\mathbb{O}}^{t}\mathbf{c}_{U}\widetilde{\mathbb{O}}=\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\zeta } \\ 
-\mathbf{\zeta } & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
and hence using $\mathbf{c}_{U}=\mathbb{U}^{\dagger }\mathbf{c}\mathbb{U}%
^{\ast }$ we conclude that 
\begin{equation}
\mathbb{T}\mathbf{c}\mathbb{T}^{t}=\widetilde{\mathbb{O}}^{t}\mathbb{U}%
^{\dagger }\mathbf{c}\mathbb{U}^{\ast }\widetilde{\mathbb{O}}=\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\zeta } \\ 
-\mathbf{\zeta } & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
and define $\mathbb{T}$ as the unitary matrix 
\begin{equation}
\mathbb{T}=\widetilde{\mathbb{O}}^{t}\mathbb{U}^{\dagger }
\end{equation}%
where $\mathbb{TT}^{\dagger }=\mathbb{T^{\dagger }T=I}_{r}$.

\begin{corollary}
If $\mathbf{c}$ is a $2s\times 2s$ complex antisymmetric matrix then there
exists a unitary matrix $\mathbb{S}$ such that 
\begin{equation}
\mathbb{S}\mathbf{c}\mathbb{S}^{\,t}=\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\eta }^{\frac{1}{2}} \\ 
-\mathbf{\eta }^{\frac{1}{2}} & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
where 
\begin{equation}
\mathbf{\eta }^{\frac{1}{2}}=\left( 
\begin{array}{ccc}
\eta _{1}^{\frac{1}{2}} & 0 & 0 \\ 
0 & \ddots & 0 \\ 
0 & 0 & \eta _{s}^{\frac{1}{2}}%
\end{array}%
\right) ;\qquad \eta _{j}^{\frac{1}{2}}\in \mathbb{R},\quad 1\leq j\leq s
\end{equation}

\begin{proof}
Using eq. $\left( \ref{cor1}\right) $ we can define $\mathbb{S}$ as 
\begin{equation}
\mathbb{S=VT}
\end{equation}%
where 
\begin{equation}
\mathbb{V}=\left( 
\begin{array}{cc}
\mathbf{0} & e^{i\frac{\mathbf{\theta }}{2}} \\ 
e^{i\frac{\mathbf{\theta }}{2}} & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathbb{S}^{\dagger }\mathbb{S=SS}^{\dagger }\mathbb{=I}_{r}
\end{equation}
\end{proof}
\end{corollary}
\end{proof}
\end{theorem}

\section{Construction of $\mathbb{O}_{\protect\kappa }$ and Phase Factors}

We first observe some decompositions of $\mathbb{B}$, which is a
antisymmetric unitary matrix, 
\begin{equation}
\mathbb{B}_{\kappa }=\func{Re}\mathbb{B}_{\kappa }+i\func{Im}\mathbb{B}%
_{\kappa }=\mathbb{N}_{\kappa }+i\mathbb{M}_{\kappa }
\end{equation}%
where 
\begin{eqnarray}
\func{Re}\mathbb{B}_{\kappa } &=&\frac{1}{2}\left\{ \mathbb{B}_{\kappa }+%
\mathbb{B}_{\kappa }^{\dagger }\right\}  \notag \\
\func{Im}\mathbb{B}_{\kappa } &=&\frac{-i}{2}\left\{ \mathbb{B}_{\kappa }-%
\mathbb{B}_{\kappa }^{\dagger }\right\}  \notag \\
\mathbb{N}_{\kappa } &=&\frac{1}{2}\left\{ \mathbb{B}_{\kappa }+\mathbb{B}%
_{\kappa }^{\ast }\right\}  \notag \\
\mathbb{M}_{\kappa } &=&\frac{-i}{2}\left\{ \mathbb{B}_{\kappa }-\mathbb{B}%
_{\kappa }^{\ast }\right\}
\end{eqnarray}%
Hence 
\begin{subequations}
\begin{eqnarray}
\func{Re}\mathbb{B}_{\kappa } &=&i\mathbb{M}_{\kappa }  \notag \\
\func{Im}\mathbb{B}_{\kappa } &=&-i\mathbb{N}_{\kappa }  \label{anti_sa}
\end{eqnarray}%
and 
\end{subequations}
\begin{eqnarray}
\mathbb{N}_{\kappa } &=&-\mathbb{N}_{\kappa }^{t}\text{ and }\mathbb{M}%
_{\kappa }=-\mathbb{M}_{\kappa }^{t}  \notag \\
\mathbb{N}_{\kappa } &=&\mathbb{N}_{\kappa }^{\ast }\text{ and }\mathbb{M}%
_{\kappa }=\mathbb{M}_{\kappa }^{\ast }
\end{eqnarray}%
We can drop the subscript $\kappa $ as it plays no role in the
considerations of this section.

As $\mathbb{B}$ is unitary 
\begin{equation}
\mathbb{B}=e^{i\mathbf{\Omega }}=\cos \mathbf{\Omega }+i\sin \mathbf{\Omega }
\end{equation}%
where 
\begin{eqnarray}
\mathbf{\Omega } &=&\mathbf{\Omega }^{\dagger }  \notag \\
\cos \mathbf{\Omega } &\mathbf{=}&\left( \cos \mathbf{\Omega }\right)
^{\dagger }=\func{Re}\mathbb{B}  \notag \\
\sin \mathbf{\Omega } &\mathbf{=}&\left( \sin \mathbf{\Omega }\right)
^{\dagger }=\func{Im}\mathbb{B}
\end{eqnarray}%
and can be diagonalized to give 
\begin{eqnarray}
\mathbb{V}^{\dagger }\mathbb{BV} &\mathbb{=}&\left( 
\begin{array}{cccc}
e^{i\omega _{1}} & 0 & \cdots & 0 \\ 
0 & \ddots &  & \vdots \\ 
\vdots &  & \ddots & 0 \\ 
0 & \cdots & 0 & e^{i\omega _{2d}}%
\end{array}%
\right)  \notag \\
&=&\left( 
\begin{array}{cccc}
\cos \omega _{1}+i\sin \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots &  & \vdots \\ 
\vdots &  & \ddots & 0 \\ 
0 & \cdots & 0 & \cos \omega _{2d}+i\sin \omega _{2d}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cccc}
\mu _{1}+i\nu _{1} & 0 & \cdots & 0 \\ 
0 & \ddots &  & \vdots \\ 
\vdots &  & \ddots & 0 \\ 
0 & \cdots & 0 & \mu _{2d}+i\nu _{2d}%
\end{array}%
\right)
\end{eqnarray}%
We note that 
\begin{equation}
\mathbb{BB}^{\dagger }=\mathbb{B}^{\dagger }\mathbb{B=I}
\end{equation}%
so that 
\begin{equation}
\left[ \mathbb{B},\mathbb{B}^{\dagger }\right] =\mathbb{O}
\end{equation}%
showing that $\mathbb{B}$ is a \emph{normal }operator, thus its self adjoint
real and imaginary parts $\left\{ \func{Re}\mathbb{B},\func{Im}\mathbb{B}%
\right\} $ commute i.e. 
\begin{equation}
\text{ }\left[ \func{Re}\mathbb{B},\func{Im}\mathbb{B}\right] =\mathbb{O}
\end{equation}%
and can be simultaneously diagonalized to bring $\mathbb{B}$ to diagonal
form.

In order to construct the unitary transformation that diagonalizes $\mathbb{B%
}$ we need only diagonalize $\func{Re}\mathbb{B}$ $\lceil $We assert the
theorem that if $\mathbb{V}^{\dagger }\left( \mathbb{U+U}^{\dagger }\right) 
\mathbb{V}$ is diagonal then so is $\mathbb{V}^{\dagger }\left( \mathbb{U-U}%
^{\dagger }\right) \mathbb{V}$ if $\mathbb{U\mathbb{U}^{\dagger }=\mathbb{U}%
^{\dagger }U=I}$ and $\mathbb{VV^{\dagger }=V^{\dagger }V=I\rfloor }$ 
\begin{eqnarray}
\mathbb{V}^{\dagger }\func{Re}\mathbb{BV} &\mathbb{=}&\left( 
\begin{array}{cccc}
\cos \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \cos \omega _{2d}%
\end{array}%
\right)  \notag \\
&=&\left( 
\begin{array}{cccc}
\mu _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \mu _{2d}%
\end{array}%
\right)
\end{eqnarray}%
as then Im$\mathbb{B=}\sin \mathbf{\Omega }$ is given by 
\begin{equation}
\sin \mathbf{\Omega }=\mathbb{V}\left( 
\begin{array}{cccc}
\sin \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \sin \omega _{2d}%
\end{array}%
\right) \mathbb{V}^{\dagger }
\end{equation}%
so that 
\begin{eqnarray}
\mathbb{V}^{\dagger }\sin \mathbf{\Omega }\mathbb{V} &\mathbf{=}&\left( 
\begin{array}{cccc}
\sin \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \sin \omega _{2d}%
\end{array}%
\right)  \notag \\
&=&\left( 
\begin{array}{cccc}
\nu _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \nu _{2d}%
\end{array}%
\right)
\end{eqnarray}%
and $\mathbb{B}$ by 
\begin{eqnarray}
\mathbb{B} &\mathbb{=V}&\left( 
\begin{array}{cccc}
\cos \omega _{1}+i\sin \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \cos \omega _{2d}+i\sin \omega _{2d}%
\end{array}%
\right) \mathbb{V}^{\dagger }  \notag \\
&=&\mathbb{V}\left( 
\begin{array}{cccc}
\mu _{1}+i\nu _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \mu _{2d}+i\nu _{2d}%
\end{array}%
\right) \mathbb{V}^{\dagger }
\end{eqnarray}%
which shows it is diagonalized by $\mathbb{V}$. The angles $\left\{ \omega
_{j}\right\} $ are given by 
\begin{equation}
\omega _{j}=\cos ^{-1}\mu _{j}
\end{equation}%
where $\left\{ \mu _{j}\right\} $ are the eigenvalues of $\func{Re}\mathbb{B}
$

We have that 
\begin{eqnarray}
\mathbb{V}^{\dagger }\func{Re}\mathbb{BV} &=&\mathbb{V}^{\dagger }\cos 
\mathbf{\Omega }\mathbb{V}=\mathbb{V}^{\dagger }\left( i\mathbb{M}\right) 
\mathbb{V}=\left( 
\begin{array}{cccc}
\cos \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \cos \omega _{2d}%
\end{array}%
\right) =\mathbf{\mu }  \notag \\
\mathbb{V}^{\dagger }\func{Im}\mathbb{BV} &=&\mathbb{V}^{\dagger }\sin 
\mathbf{\Omega }\mathbb{V}=\mathbb{V}^{\dagger }\left( -i\mathbb{N}\right) 
\mathbb{V}=\left( 
\begin{array}{cccc}
\sin \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \sin \omega _{2d}%
\end{array}%
\right) =\mathbf{\nu }
\end{eqnarray}%
and thus 
\begin{eqnarray}
\mathbb{V}^{\dagger }\mathbb{BV} &=&\mathbb{V}^{\dagger }\left( \cos \mathbf{%
\Omega +}i\sin \mathbf{\Omega }\right) \mathbb{V}=\mathbb{V}^{\dagger
}\left( i\mathbb{M+N}\right) \mathbb{V}  \notag \\
&=&\left( 
\begin{array}{cccc}
\cos \omega _{1}+i\sin \omega _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & 0 & \vdots \\ 
\vdots & 0 & \ddots & 0 \\ 
0 & \cdots & 0 & \cos \omega _{2d}+i\sin \omega _{2d}%
\end{array}%
\right)  \notag \\
&=&\mathbf{\mu }+i\mathbf{\nu }
\end{eqnarray}%
where $\left\{ \nu _{j}\right\} $ are the eigenvalues of $\func{Im}\mathbb{B}
$. Noting that $\left\{ \func{Re}\mathbb{B},\func{Im}\mathbb{B}\right\} $
are self adjoint \emph{and purely imaginary }matrices and $\left\{ \mathbb{M}%
,\mathbb{N}\right\} $ are real antisymmetric matrices related to $\left\{ 
\func{Re}\mathbb{B},\func{Im}\mathbb{B}\right\} $ by eq. $\left( \ref%
{anti_sa}\right) $ we can construct a real ortho normal basis $\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \equiv \left\{ \left\vert \mathbf{s}_{j}\right\rangle ;1\leq j\leq
2d\right\} $ where 
\begin{eqnarray}
\left( \left\vert \mathbf{s}_{1d}\right\rangle \right) &=&\left( \left\vert
s_{1}\right\rangle \cdots \left\vert s_{d}\right\rangle \right)  \notag \\
\left( \left\vert \mathbf{s}_{2d}\right\rangle \right) &=&\left( \left\vert
s_{1+d}\right\rangle \cdots \left\vert s_{2d}\right\rangle \right)
\end{eqnarray}%
and 
\begin{eqnarray}
\left\vert s_{j}\right\rangle &=&\frac{1}{\sqrt{2}}\left( \left\vert
v_{j}\right\rangle +\left\vert v_{j}^{\ast }\right\rangle \right) =\sqrt{2}%
\func{Re}\left\vert v_{j}\right\rangle  \notag \\
\left\vert s_{j+s}\right\rangle &=&\frac{-i}{\sqrt{2}}\left( \left(
\left\vert v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right)
\right) =\sqrt{2}\func{Im}\left\vert v_{j}\right\rangle
\end{eqnarray}%
where $\left\{ \left\vert v_{j}\right\rangle \right\} $ are the columns of $%
\mathbb{V}$ in which $\left\{ \mathbb{M},\mathbb{N}\right\} $ are skew
diagonal i.e.%
\begin{equation}
\mathbb{M}=\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbf{0} & -i\mathbf{\mu } \\ 
i\mathbf{\mu } & \mathbf{0}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\vert \mathbf{s}_{1d}\right\rangle \\ 
\left\vert \mathbf{s}_{2d}\right\rangle%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathbb{N}=\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbf{0} & i\mathbf{\nu } \\ 
-i\mathbf{\nu } & \mathbf{0}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\vert \mathbf{s}_{1d}\right\rangle \\ 
\left\vert \mathbf{s}_{2d}\right\rangle%
\end{array}%
\right)
\end{equation}%
where $\left\{ \left\vert s_{j}\right\rangle \right\} $ are the columns of
the real orthogonal matrix $\mathbb{O\equiv }\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) $, leading to 
\begin{eqnarray}
\mathbb{B} &=&\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \left\{ \left( 
\begin{array}{cc}
\mathbf{0} & i\mathbf{\nu } \\ 
-i\mathbf{\nu } & \mathbf{0}%
\end{array}%
\right) +i\left( 
\begin{array}{cc}
\mathbf{0} & -i\mathbf{\mu } \\ 
i\mathbf{\mu } & \mathbf{0}%
\end{array}%
\right) \right\} \left( 
\begin{array}{c}
\left\vert \mathbf{s}_{1d}\right\rangle \\ 
\left\vert \mathbf{s}_{2d}\right\rangle%
\end{array}%
\right) \\
&\mathbb{=}&\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \left\{ \left( 
\begin{array}{cc}
\mathbf{0} & -i\left( -\mathbf{\nu +}i\mathbf{\mu }\right) \\ 
i\left( -\mathbf{\nu +}i\mathbf{\mu }\right) & \mathbf{0}%
\end{array}%
\right) \right\} \left( 
\begin{array}{c}
\left\vert \mathbf{s}_{1d}\right\rangle \\ 
\left\vert \mathbf{s}_{2d}\right\rangle%
\end{array}%
\right) \\
&\equiv &\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \left\{ \left( 
\begin{array}{cc}
\mathbf{0} & -i\mathbf{\eta } \\ 
i\mathbf{\eta } & \mathbf{0}%
\end{array}%
\right) \right\} \left( 
\begin{array}{c}
\left\vert \mathbf{s}_{1d}\right\rangle \\ 
\left\vert \mathbf{s}_{2d}\right\rangle%
\end{array}%
\right)
\end{eqnarray}%
where $\eta _{j}=-\nu _{j}+i\mu _{j}=-\sin \omega _{j}+i\cos \omega
_{j}=ie^{i\omega _{j}}$. This shows that 
\begin{equation}
\mathbb{O}^{t}\mathbb{BO=}\left( 
\begin{array}{cc}
\mathbf{0} & \mathbf{\eta } \\ 
-\mathbf{\eta } & \mathbf{0}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{0} & ie^{i\mathbf{\omega }} \\ 
-ie^{i\mathbf{\omega }} & \mathbf{0}%
\end{array}%
\right)
\end{equation}%
where $\omega _{j}=\cos ^{-1}\mu _{j}$.

The transformation form the $\left\{ \left\vert s_{j}\right\rangle ;1\leq
j\leq 2d\right\} $ basis to the $\left\{ \left\vert v_{j}\right\rangle
;1\leq j\leq 2d\right\} $ basis can be expressed as 
\begin{equation}
\left( 
\begin{array}{cc}
\left\vert \mathbf{v}\right\rangle & \left\vert \mathbf{v}^{\ast
}\right\rangle%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\left\vert \mathbf{s}_{1d}\right\rangle & \left\vert \mathbf{s}%
_{2d}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{d} & \mathbb{I}_{d} \\ 
i\mathbb{I}_{d} & -i\mathbb{I}_{d}%
\end{array}%
\right)
\end{equation}

