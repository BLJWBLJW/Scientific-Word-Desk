2r}e_{j_{1}}\wedge e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\operatorname{Pf}%
\left\{  \Xi_{\left\vert EE\right\rangle }\left(  g\right)  \left(  j_{1}%
j_{2}j_{3}j_{4}\right)  \right\}
