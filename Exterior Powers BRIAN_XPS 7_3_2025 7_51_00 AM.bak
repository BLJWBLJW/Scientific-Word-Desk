\begin{remark}
The action of the symmetric group $S_{3}$ on

\begin{enumerate}
\item $\left\{  1,2,3\right\}  $ produces the unodered sets that are not equal
as ordered sets (but are equal as sets)
\begin{equation}
S_{3}\left\{  \left(  1,2,3\right)  \right\}  =\left\{  \left\{  \left\{
1,2,3\right\}  ,\left\{  2,1,3\right\}  ,\left\{  1,3,2\right\}  ,\left\{
2,3,1\right\}  ,\left\{  3,1,2\right\}  ,\left\{  3,2,1\right\}  \right\}
\right\}  .
\end{equation}


\item $\left\{  1,2,3,4\right\}  $ produces the unodered sets that are not
equal as ordered sets (but are equal as sets)
\begin{gather}
S_{3}\left\{  \left(  1,2,3,4\right)  \right\}  =\left\{  \left\{
1,2,3,4\right\}  ,\left\{  1,2,4,3\right\}  ,\left\{  1,4,2,3\right\}
,\left\{  4,1,2,3\right\}  ,\left\{  2,1,3,4\right\}  ,\left\{
2,1,4,3\right\}  ,\left\{  2,4,1,3\right\}  ,\right. \\
\left\{  4,2,1,3\right\}  ,\left\{  1,3,2,4\right\}  ,\left\{
1,3,4,2\right\}  ,\left\{  1,4,3,2\right\}  ,\left\{  4,1,3,2\right\}
,\left\{  2,3,1,4\right\}  ,\left\{  2,3,4,1\right\}  ,\left\{
2,4,3,1\right\}  ,\\
\qquad\qquad\left.  \left\{  4,2,3,1\right\}  ,\left\{  3,1,2,4\right\}
,\left\{  3,1,4,2\right\}  ,\left\{  3,4,1,2\right\}  ,\left\{
4,3,1,2\right\}  ,\left\{  3,2,1,4\right\}  ,\left\{  3,2,4,1\right\}
,\left\{  3,4,2,1\right\}  ,\left\{  4,3,2,1\right\}  \right\}  .
\end{gather}

\end{enumerate}
\end{remark}

\begin{lemma}%
\begin{equation}
DC_{n,m}^{r}\overset{\text{set}}{=}DC_{m,n}^{r}\text{ but }DC_{n,m}%
^{r}\overset{\text{ordered set}}{\neq}DC_{m,n}^{r},\quad n+m=p\leq r
\end{equation}

\end{lemma}

\begin{proof}
Consider
\begin{equation}
\mathbb{N}_{1}^{6}=\left\{  1,\cdots,6\right\}
\end{equation}
then if $\sigma\in DC_{2,4}^{6}\subset S_{6}$%
\begin{align}
DC_{2,4}^{6}\left\{  \mathbb{N}_{1}^{6}\right\}   &  =\left\{
\overset{}{\left\{  \overset{}{\left\{  1,2\right\}  ,\left\{
3,4,5,6\right\}  }\right\}  ,\left\{  \overset{}{\left\{  1,3\right\}
,\left\{  2,4,5,6\right\}  }\right\}  ,\left\{  \overset{}{\left\{
1,4\right\}  ,\left\{  2,3,5,6\right\}  }\right\}  ,\left\{
\overset{}{\left\{  1,5\right\}  ,\left\{  2,3,4,6\right\}  }\right\}
,\left\{  \overset{}{\left\{  1,6\right\}  ,\left\{  2,3,4,5\right\}
}\right\}  ,}\right. \\
&  \qquad\qquad\qquad\qquad\qquad\quad\left\{  \overset{}{\left\{
2,3\right\}  ,\left\{  1,4,5,6\right\}  }\right\}  ,\left\{
\overset{}{\left\{  2,4\right\}  ,\left\{  1,3,5,6\right\}  }\right\}
,\left\{  \overset{}{\left\{  2,5\right\}  ,\left\{  1,3,4,6\right\}
}\right\}  ,\left\{  \overset{}{\left\{  2,6\right\}  ,\left\{
1,3,4,5\right\}  }\right\}  ,\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\quad\left\{
\overset{}{\left\{  3,4\right\}  ,\left\{  1,2,5,6\right\}  }\right\}
,\left\{  \overset{}{\left\{  3,5\right\}  ,\left\{  1,2,4,6\right\}
}\right\}  ,\left\{  \overset{}{\left\{  3,6\right\}  ,\left\{
1,2,4,5\right\}  }\right\}  ,\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\quad\left\{  \overset{}{\left\{  4,5\right\}
,\left\{  1,2,3,6\right\}  }\right\}  ,\left\{  \overset{}{\left\{
4,6\right\}  ,\left\{  1,2,3,5\right\}  }\right\}  ,\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.
\overset{}{\left\{  \overset{}{\left\{  5,6\right\}  ,\left\{
1,2,3,4\right\}  }\right\}  }\right\}  ,
\end{align}
while
\begin{align}
&  DC_{4,2}^{6}\left\{  \mathbb{N}_{1}^{6}\right\} \\
&  =\left\{  \overset{}{\left\{  \overset{}{\left\{  3,4,5,6\right\}
,}\left\{  1,2\right\}  \right\}  ,\left\{  \overset{}{\left\{
2,4,5,6\right\}  ,}\left\{  1,3\right\}  \right\}  ,\left\{
\overset{}{\left\{  2,3,5,6\right\}  },\left\{  1,4\right\}  \right\}
,\left\{  \overset{}{\left\{  2,3,4,6\right\}  ,}\left\{  1,5\right\}
\right\}  ,\left\{  \overset{}{\left\{  2,3,4,5\right\}  },\left\{
1,6\right\}  \right\}  ,}\right. \\
&  \qquad\qquad\qquad\qquad\qquad\quad\left\{  \overset{}{\left\{
1,4,5,6\right\}  ,}\left\{  2,3\right\}  \right\}  ,\left\{
\overset{}{\left\{  1,3,5,6\right\}  },\left\{  2,4\right\}  \right\}
,\left\{  \overset{}{\left\{  1,3,4,6\right\}  ,\left\{  2,5\right\}
}\right\}  ,\left\{  \overset{}{\left\{  1,3,4,5\right\}  ,\left\{
2,6\right\}  }\right\}  ,\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\quad\left\{
\overset{}{\left\{  1,2,5,6\right\}  ,\left\{  3,4\right\}  }\right\}
,\left\{  \overset{}{\left\{  1,2,4,6\right\}  },\left\{  3,5\right\}
\right\}  ,\left\{  \overset{}{\left\{  1,2,4,5\right\}  },\left\{
3,6\right\}  \right\}  ,\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\quad\left\{  \overset{}{\left\{  1,2,3,6\right\}
},\left\{  4,5\right\}  \right\}  ,\left\{  \overset{}{\left\{
1,2,3,5\right\}  },\left\{  4,6\right\}  \right\}  ,\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.
\overset{}{\left\{  \overset{}{\left\{  1,2,3,4\right\}  },\left\{
5,6\right\}  \right\}  }\right\}  ,
\end{align}
which are equal as a set (sets in general do not depend on the order of their
elements unless they are \emph{ordered sets} i.e. sets with an additional property/structure).
\end{proof}

\begin{remark}
The preceeding refers to $\mathbb{N}_{1}^{6}=\left\{  1,2,3,4,5,6\right\}  ,$
but we could also consider $\mathbb{N}_{2}^{7}=\left\{  2,3,4,5,6,7\right\}
.$
\end{remark}

\begin{remark}%
\begin{equation}
\#\left\{  DC_{k}^{n}\left\{  \mathbb{N}_{1}^{n}\right\}  \right\}  =\left\{
\begin{array}
[c]{c}%
\binom{n}{k},k\neq\frac{n}{2}\\
\frac{1}{2}\binom{n}{k},k=\frac{n}{2}%
\end{array}
\right.  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\#\left\{  DC_{2}^{6}\left\{  \mathbb{N}_{1}^{6}\right\}  \right\}  =\binom
{6}{2}=15.\
\end{equation}

\end{remark}

\begin{example}
The set of disjoint sets of ordered pairs $DC_{2}^{4}\left\{  \mathbb{N}%
_{1}^{4}\right\}  $ selected from $\mathbb{N}_{1}^{4}$ is
\begin{gather}
DC_{2}^{4}\left\{  \mathbb{N}_{1}^{4}\right\}  =\left\{  \overset{}{\left\{
\overset{}{\left\{  1,2\right\}  ,\left\{  3,4\right\}  }\right\}  ,\left\{
\overset{}{\left\{  1,3\right\}  ,\left\{  2,4\right\}  }\right\}  ,\left\{
\overset{}{\left\{  1,4\right\}  ,\left\{  2,3\right\}  }\right\}  }\right\}
\\
\#\left\{  DC_{2}^{4}\left\{  \mathbb{N}_{1}^{4}\right\}  \right\}  =\frac
{1}{2}\binom{4}{2}=3,
\end{gather}
where
\begin{equation}
DC_{2}^{4}=\left\{  \sigma_{1},\sigma_{2},\sigma_{3}\right\}
\end{equation}
and%
\begin{align}
\sigma_{1}\left(  \left\{  1,2,3,4\right\}  \right)   &  =\left\{
\overset{}{\left\{  1,2\right\}  ,\left\{  3,4\right\}  }\right\} \\
\sigma_{2}\left(  \left\{  1,2,3,4\right\}  \right)   &  =\left\{
\overset{}{\left\{  1,3\right\}  ,\left\{  2,4\right\}  }\right\} \\
\sigma_{3}\left(  \left\{  1,2,3,4\right\}  \right)   &  =\left\{
\overset{}{\left\{  1,4\right\}  ,\left\{  2,3\right\}  }\right\}  .
\end{align}

\end{example}

\begin{example}
The set of disjoint sets of ordered pairs $DC_{2}^{4}\left\{  \mathbb{N}%
_{2}^{5}\right\}  $ selected from $\mathbb{N}_{2}^{5}$ is
\begin{gather}
DC_{2}^{4}\left\{  \mathbb{N}_{2}^{5}\right\}  =\left\{  \overset{}{\left\{
\overset{}{\left\{  2,3\right\}  ,\left\{  4,5\right\}  }\right\}  ,\left\{
\overset{}{\left\{  2,4\right\}  ,\left\{  4,5\right\}  }\right\}  ,\left\{
\overset{}{\left\{  2,5\right\}  ,\left\{  3,4\right\}  }\right\}  }\right\}
\\
\#\left\{  DC_{2}^{4}\left\{  \mathbb{N}_{2}^{5}\right\}  \right\}  =\frac
{1}{2}\binom{4}{2}=3,
\end{gather}
where
\begin{equation}
DC_{2}^{4}=\left\{  \sigma_{1},\sigma_{2},\sigma_{3}\right\}
\end{equation}
and%
\begin{align}
\sigma_{1}\left(  \left\{  2,3,4,5\right\}  \right)   &  =\left\{
\overset{}{\left\{  2,3\right\}  ,\left\{  4,5\right\}  }\right\} \\
\sigma_{2}\left(  \left\{  2,3,4,5\right\}  \right)   &  =\left\{
\overset{}{\left\{  2,4\right\}  ,\left\{  4,5\right\}  }\right\} \\
\sigma_{3}\left(  \left\{  2,3,4,5\right\}  \right)   &  =\left\{
\overset{}{\left\{  2,5\right\}  ,\left\{  3,4\right\}  }\right\}  .
\end{align}

\end{example}

\begin{example}
\begin{enumerate}
\item
\begin{align}
\sigma_{j}  &  \in C_{2}^{3};1\leq j\leq\binom{3}{2}\\
C_{2}^{3}  &  =\left\{  \left.  \overset{}{\sigma_{j}}\right\vert 1\leq
j\leq\binom{3}{2}=3\right\} \\
C_{2}^{3}  &  :\mathbb{N}_{1}^{3}\rightarrow\left\{  \left\{  1,2\right\}
,\left\{  1,3\right\}  ,\left\{  2,3\right\}  \right\}  =\left\{
\overset{}{\left\{  \overset{}{\sigma_{1}\left(  1\right)  ,\sigma_{1}\left(
2\right)  }\right\}  ,\left\{  \overset{}{\sigma_{2}\left(  1\right)
,\sigma_{2}\left(  3\right)  }\right\}  ,\left\{  \overset{}{\sigma_{3}\left(
2\right)  ,\sigma_{3}\left(  3\right)  }\right\}  }\right\}  .
\end{align}


\item
\begin{align}
\sigma_{j}  &  \in C_{2}^{3};1\leq j\leq\binom{3}{2}\\
C_{2}^{3}  &  =\left\{  \left.  \overset{}{\sigma_{j}}\right\vert 1\leq
j\leq\binom{3}{2}=3\right\} \\
C_{2}^{3}  &  :\mathbb{N}_{4}^{6}\rightarrow\left\{  \left\{  4,5\right\}
,\left\{  4,6\right\}  ,\left\{  5,6\right\}  \right\}  =\left\{
\overset{}{\left\{  \overset{}{\sigma_{1}\left(  4\right)  ,\sigma_{1}\left(
5\right)  }\right\}  ,\left\{  \overset{}{\sigma_{2}\left(  4\right)
,\sigma_{2}\left(  5\right)  }\right\}  ,\left\{  \overset{}{\sigma_{3}\left(
4\right)  ,\sigma_{3}\left(  5\right)  }\right\}  }\right\}  .
\end{align}

\end{enumerate}
\end{example}

\begin{lemma}
\emph{This is an important identity relating summation subscripts to
permutation subscripts \label{summation subscripts to permutation subscripts}
}%
\begin{equation}
\sum_{\substack{1\leq j_{1}<\cdots<j_{p}\leq2r\\1\leq j_{p+1}<\cdots
<j_{p+q}\leq2r}}F_{j_{1}\cdots j_{p}j_{p+1}\cdots j_{p+q}}=\sum_{\sigma\in
DC_{p,q}^{2r}}F_{\sigma\left(  1\right)  \cdots\sigma\left(  p+q\right)  }.
\end{equation}

\end{lemma}

\begin{proof}
Let $r=4,$ $p=2,q=4$

\begin{enumerate}
\item
\begin{gather}
\sum_{\substack{1\leq j_{1}<j_{2}\leq8\\1\leq j_{3}<\cdots<j_{6}\leq
8}}F_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\\
\parallel\\
=F_{123456}+F_{123457}+F_{123458}+F_{123467}+F_{123468}+F_{123478}%
+F_{123567}\\
\qquad\qquad\quad+F_{123568}+F_{123578}+F_{124567}+F_{124568}+F_{124578}%
+F_{125678}\\
\ddots\qquad\qquad\qquad\vdots\\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad+F_{783456}.
\end{gather}


\item
\begin{align}
\sigma &  \in DC_{2,4}^{8}\\
\#\left\{  DC_{2}^{8}\right\}   &  =\binom{8}{2}\binom{8}{4}=28\times70=1960.
\end{align}


\item
\begin{align}
\sigma_{1}\left(  \left\{  1,2,3,4,5,6\right\}  \right)   &  =\left\{
\left\{  1,2\right\}  ,\left\{  3,4,5,6\right\}  \right\} \\
\sigma_{2}\left(  \left\{  1,2,3,4,5,6\right\}  \right)   &  =\left\{
\left\{  1,2\right\}  ,\left\{  3,4,5,7\right\}  \right\} \\
&  \vdots\\
\sigma_{1960}\left(  \left\{  1,2,3,4,5,6\right\}  \right)   &  =\left\{
\left\{  7,8\right\}  ,\left\{  3,4,5,6\right\}  \right\}  .
\end{align}

\end{enumerate}
\end{proof}

\section{Geminals and Pfaffians}

\label{06/29/2025}

\begin{enumerate}
\item The geminal ($\equiv$ bivector)
\begin{equation}
g=\sum_{1\leq j<k\leq2s}\left(  e_{j}\wedge e_{k}\right)  \mathcal{R}_{e\wedge
e}\left(  g\right)  _{jk}=\frac{1}{2}\sum_{1\leq j,k\leq s}\left(  e_{j}\wedge
e_{k}\right)  \mathcal{R}_{e\wedge e}\left(  g\right)  _{jk}=\left(
\begin{array}
[c]{ccc}%
e_{1}\wedge e_{2} & \cdots & e_{2s-1}\wedge e_{2s}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e\wedge e}\left(  g\right)  _{12}\\
\vdots\\
\mathcal{R}_{e\wedge e}\left(  g\right)  _{2s-12s}%
\end{array}
\right)  .
\end{equation}


\begin{notation}%
\begin{equation}
g_{jk}=\mathcal{R}_{e\wedge e}\left(  g\right)  _{jk}%
\end{equation}

\end{notation}

\item The geminal square \label{geminal square}%
\begin{align}
g^{2}  &  =g\wedge g=\frac{1}{2^{2}}\sum_{1\leq j_{1},j_{2}\leq2s}\left(
e_{j_{1}}\wedge e_{j_{2}}\right)  g_{j_{1}j_{2}}\wedge\sum_{1\leq j_{3}%
,j_{4}\leq2s}\left(  e_{j_{3}}\wedge e_{j_{4}}\right)  g_{j_{3}j_{4}}=\frac
{1}{2^{2}}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  g_{j_{1}j_{2}}g_{j_{3}j_{4}%
}\\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \left(  g_{j_{1}j_{2}%
}g_{j_{3}j_{4}}-g_{j_{1}j_{3}}g_{j_{2}j_{4}}+g_{j_{1}j_{4}}g_{j_{2}j_{3}%
}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \left(  \sum_{\sigma\in
DC_{2,2}^{2s}}\pi\left(  \sigma\right)  g_{\sigma\left(  j_{1}\right)
\sigma\left(  j_{2}\right)  }g_{\sigma\left(  j_{3}\right)  \sigma\left(
j_{4}\right)  }\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \operatorname{Pf}\left(
g_{j_{1}j_{2}},g_{j_{1}j_{3}},g_{j_{1}j_{4}},g_{j_{2}j_{3}},g_{j_{2}j_{4}%
},g_{j_{3}j_{4}}\right) \\
&  \equiv\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \operatorname{Pf}\left(
\mathbb{G}\left(  \overset{}{\left\{  j_{1},j_{2},j_{3},j_{4}\right\}
,\left\{  j_{1},j_{2},j_{3},j_{4}\right\}  }\right)  \right) \\
&  \equiv\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \operatorname{Pf}\left(
\mathbb{G}\left(  j_{1},j_{2},j_{3},j_{4}\right)  \right) \\
&  \equiv\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2s}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \operatorname{Pf}\left(
\mathbb{G}:j_{1},j_{2},j_{3},j_{4}\right)  .
\end{align}


\item Let $s=2$

\begin{enumerate}
\item
\begin{equation}
DC_{2,2}^{4}\left\{  \mathbb{N}_{1}^{4}\right\}  =\left\{  \overset{}{\left\{
\overset{}{\left\{  1,2\right\}  ,\left\{  3,4\right\}  }\right\}  ,\left\{
\overset{}{\left\{  1,3\right\}  ,\left\{  2,4\right\}  }\right\}  ,\left\{
\overset{}{\left\{  1,4\right\}  ,\left\{  2,3\right\}  }\right\}  }\right\}
.
\end{equation}


\item
\begin{equation}
C_{2}^{4}\left\{  \mathbb{N}_{1}^{4}\right\}  =C_{2}^{4}\left\{  \left\{
1,2,3,4\right\}  \right\}  \equiv\left\{  \left.  \sigma_{j}\in C_{2}%
^{4}\right\vert 1\leq j\leq6\right\}  :\mathbb{N}_{1}^{4}=\left\{  \left\{
1,2\right\}  ,\left\{  3,4\right\}  ,\left\{  1,3\right\}  ,\left\{
2,4\right\}  ,\left\{  1,4\right\}  ,\left\{  2,3\right\}  \right\}  ,
\end{equation}


i.e.
\begin{equation}
\left\{  \left.  \sigma_{j}\in C_{2}^{4}\right\vert 1\leq j\leq6\right\}
:\mathbb{N}_{1}^{4}=\left\{  \left\{  1,2\right\}  ,\left\{  3,4\right\}
,\left\{  1,3\right\}  ,\left\{  2,4\right\}  ,\left\{  1,4\right\}  ,\left\{
2,3\right\}  \right\}  .
\end{equation}


\item
\begin{align}
C_{2}^{4}  &  :\left\{  \left.  \sigma_{j}\in C_{2}^{4}\right\vert 1\leq
j\leq3\right\}  \equiv\left\{  \mathbb{N}_{1}^{3}\right\}  =\left\{
\sigma_{1}\left\{  1,2,3\right\}  ,\sigma_{2}\left\{  1,2,3\right\}
,\sigma_{3}\left\{  1,2,3\right\}  \right\}  =\left\{  \left\{  1,2\right\}
,\left\{  1,3\right\}  ,\left\{  2,3\right\}  \right\} \\
C_{2}^{4}  &  :\left\{  \left.  \sigma_{j}\in C_{2}^{4}\right\vert 1\leq
j\leq3\right\}  \equiv\left\{  \mathbb{N}_{2}^{4}\right\}  =\left\{
\sigma_{1}\left\{  2,3,4\right\}  ,\sigma_{2}\left\{  2,3,4\right\}
,\sigma_{3}\left\{  2,3,4\right\}  \right\}  =\left\{  \left\{  2,3\right\}
,\left\{  2,4\right\}  ,\left\{  3,4\right\}  \right\}  ,
\end{align}
i.e.%
\begin{equation}
\sigma_{k}\left(  \left\{  j_{1},j_{2}\right\}  \right)  =\left\{
j_{\sigma_{k}\left(  1\right)  },j_{\sigma_{k}\left(  2\right)  }\right\}
;\quad1\leq k\leq3
\end{equation}
giving%
\begin{align}
\sigma_{1}  &  :\mathbb{N}_{1}^{3}\rightarrow\left\{  1,2\right\} \\
\sigma_{2}  &  :\mathbb{N}_{1}^{3}\rightarrow\left\{  1,3\right\} \\
\sigma_{3}  &  :\mathbb{N}_{1}^{3}\rightarrow\left\{  2,3\right\}
\end{align}
and%
\begin{align}
\sigma_{1}  &  :\mathbb{N}_{2}^{4}\rightarrow\left\{  2,3\right\} \\
\sigma_{2}  &  :\mathbb{N}_{2}^{4}\rightarrow\left\{  2,4\right\} \\
\sigma_{3}  &  :\mathbb{N}_{2}^{4}\rightarrow\left\{  3,4\right\}  .
\end{align}

\end{enumerate}

\item The second order \emph{pfaffian minor} can be expressed as
\begin{gather}
\operatorname{Pf}\left(  \mathbb{G}:j_{1},j_{2},j_{3},j_{4}\right)
\equiv\operatorname{Pf}\left(  \overset{}{\mathbb{G}\left(  \left\{
j_{1},j_{2},j_{3},j_{4}\right\}  ,\left\{  j_{1},j_{2},j_{3},j_{4}\right\}
\right)  }\right) \\
\operatorname{Pf}\left\{  \left(
\begin{array}
[c]{cccc}%
0 & g_{j_{1}j_{2}} & g_{j_{1}j_{3}} & g_{j_{1}j_{4}}\\
-g_{j_{1}j_{2}} & 0 & g_{j_{2}j_{3}} & g_{j_{2}j_{4}}\\
-g_{j_{1}j_{3}} & -g_{j_{2}j_{3}} & 0 & g_{j_{3}j_{4}}\\
-g_{j_{1}j_{4}} & -g_{j_{2}j_{4}} & -g_{j_{3}j_{4}} & 0
\end{array}
\right)  \right\} \\
\parallel\\
\operatorname{Pf}\left(  g_{j_{1}j_{2}},g_{j_{1}j_{3}},g_{j_{1}j_{4}}%
,g_{j_{2}j_{3}},g_{j_{2}j_{4}},g_{j_{3}j_{4}}\right) \\
\parallel\\
g_{j_{1}j_{2}}g_{j_{3}j_{4}}-g_{j_{1}j_{3}}g_{j_{2}j_{4}}+g_{j_{1}j_{4}%
}g_{j_{2}j_{3}}.
\end{gather}


\item The block submatrix%
\begin{equation}
\mathbb{G}\left(  J,J\right)  =\mathbb{G}\left(  \left\{  j_{1},j_{2}%
,j_{3},j_{4}\right\}  ,\left\{  j_{1},j_{2},j_{3},j_{4}\right\}  \right)
\end{equation}
is defined by
\begin{gather}
\mathbb{G}\left(  J,J\right)  =\mathbb{G}\left(  \overset{}{\left\{
j_{1},\cdots,j_{2n}\right\}  ,\left\{  j_{1},\cdots,j_{2n}\right\}  }\right)
\\
\parallel\\
\left(
\begin{array}
[c]{cccccc}%
\mathrm{0} & \mathrm{g}_{1,2} & \mathrm{g}_{1,3} & \mathrm{\cdots} &
\mathrm{g}_{1,2s-1} & \mathrm{g}_{1,2s}\\
\mathrm{-g}_{1,2} & 0 & g_{j_{1}j_{2}} & \cdots & g_{j_{1}j_{2n}} &
\mathrm{g}_{2,2s}\\
\mathrm{-g}_{1,3} & -g_{j_{1}j_{2}} & \ddots & \cdots & \vdots &
\mathrm{\vdots}\\
\mathrm{\vdots} & \vdots & \cdots & \ddots & g_{j_{2n-1}j_{2n}} &
\mathrm{g}_{2s-3,r}\\
\mathrm{-g}_{2,2s-1} & -g_{j_{1}j_{2n}} & \cdots & -g_{j_{2n-1}j_{2n}} & 0 &
\mathrm{g}_{2s-1,r}\\
\mathrm{-g}_{1,2s} & \mathrm{\cdots} & \mathrm{\cdots} & \mathrm{\cdots} &
\mathrm{-g}_{2s-1,r} & \mathrm{0}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
0 & g_{j_{1}j_{2}} & \cdots & g_{j_{1}j_{2n}}\\
-g_{j_{1}j_{2}} & \ddots & \cdots & g_{j_{2}j_{2n}}\\
\vdots & \cdots & \cdots & \vdots\\
\vdots & \vdots & \ddots & g_{j_{2n-1}j_{2n}}\\
-g_{j_{1}j_{2n}} & \cdots & -g_{j_{2n-1}j_{2n}} & 0
\end{array}
\right)  ,
\end{gather}
where roman font denotes elements that are deleted from the original matrix.

\item The geminal cube%
\begin{align}
g^{3}  &  =g\wedge g\wedge g=\frac{1}{2^{3}}\left(  \sum_{1\leq j_{1}%
,j_{2}\leq2s}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)  g_{j_{1}j_{2}}\right)
\wedge\left(  \sum_{1\leq j_{3},j_{4}\leq2s}\left(  e_{j_{3}}\wedge e_{j_{4}%
}\right)  g_{j_{3}j_{4}}\right)  \wedge\left(  \sum_{1\leq j_{5},j_{6}\leq
2s}\left(  e_{j_{5}}\wedge e_{j_{6}}\right)  g_{j_{5}j_{6}}\right) \\
&  =\frac{1}{2^{3}}\sum_{1\leq j_{1},j_{2},j_{3},j_{4},j_{5},j_{6}\leq
2s}\left(  e_{j_{1}}\wedge e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge
e_{j_{5}}\wedge e_{j_{6}}\right)  g_{j_{1}j_{2}}g_{j_{3}j_{4}}g_{j_{5}j_{6}}\\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}\leq2s}\left(  e_{j_{1}%
}\wedge e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge
e_{j_{6}}\right)  \left(  \left(  g_{j_{1}j_{2}}g_{j_{3}j_{4}}-g_{j_{1}j_{3}%
}g_{j_{2}j_{4}}+g_{j_{2}j_{4}}g_{j_{1}j_{3}}\right)  g_{j_{5}j_{6}}\right. \\
&  +\left(  g_{j_{1}j_{2}}g_{j_{5}j_{6}}-g_{j_{1}j_{5}}g_{j_{2}j_{6}}%
+g_{j_{2}j_{6}}g_{j_{1}j_{5}}\right)  g_{j_{3}j_{4}}+\left(  g_{j_{3}j_{4}%
}g_{j_{5}j_{6}}-g_{j_{3}j_{5}}g_{j_{4}j_{6}}+g_{j_{4}j_{6}}g_{j_{3}j_{5}%
}\right)  g_{j_{1}j_{2}}\\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}\leq2s}\left(  e_{j_{1}%
}\wedge e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge
e_{j_{6}}\right)  \operatorname{Pf}\left(  g_{j_{1}j_{2}},g_{j_{1}j_{3}%
},g_{j_{1}j_{4}},g_{j_{1}j_{5}},g_{j_{1}j_{6}},g_{j_{2}j_{3}},g_{j_{2}j_{4}%
},g_{j_{2}j_{5}},g_{j_{2}j_{6}},g_{j_{3}j_{4}},\right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  g_{j_{3}j_{4}},g_{j_{3}%
j_{5}},g_{j_{3}j_{6}},g_{j_{4}j_{5}},g_{j_{4}j_{6}},g_{j_{5}j_{6}}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}\leq2s}\left(  e_{j_{1}%
}\wedge e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge
e_{j_{6}}\right)  \operatorname{Pf}\left(  \overset{}{\mathcal{R}_{e}\left(
G\right)  \left(  \left\{  j_{1},j_{2},j_{3},j_{4},j_{5},j_{6}\right\}
,\left\{  j_{1},j_{2},j_{3},j_{4},j_{5},j_{6}\right\}  \right)  }\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}\leq2s}\left(  e_{j_{1}%
}\wedge e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge
e_{j_{6}}\right)  \operatorname{Pf}\left(  \overset{}{\mathcal{R}_{e}\left(
G\right)  :\left\{  j_{1},j_{2},j_{3},j_{4},j_{5},j_{6}\right\}  }\right)  ,
\end{align}
where%
\begin{equation}
\mathcal{R}_{e}\left(  G\right)  =\mathbb{G}.
\end{equation}
\label{Geminal Power Expansion in terms of Compound Pfaffians}
\end{enumerate}

\begin{theorem}
Geminal power expansion theorem
\begin{equation}
g^{n}=\sum_{1\leq j_{1}<\cdots<j_{2n}\leq2s}\left(  e_{j_{1}}\wedge e_{j_{2}%
}\cdots e_{j_{2n-1}}\wedge e_{j_{2n}}\right)  \operatorname{Pf}\left(
\mathbb{G}\left(  j_{1},\cdots,j_{2n}\right)  \right)  ,
\end{equation}
where
\begin{equation}
\operatorname{Pf}\left(  \mathbb{G}\left(  j_{1},\cdots,j_{2n}\right)
\right)  =\sum_{\sigma\in DC_{2,2n-2}^{2r}}\pi\left(  \sigma\right)
g_{\sigma\left(  j_{1}\right)  \sigma\left(  j_{2}\right)  }\cdots
g_{\sigma\left(  j_{2n-1}\right)  \sigma\left(  j_{2n}\right)  }.
\end{equation}

\end{theorem}

\begin{remark}
Note that $\left\{  \left.  e_{j_{1}}\wedge\cdots\wedge e_{j_{2n}}\right\vert
1\leq j_{1}<\cdots<j_{2n}\leq2s\right\}  $ are not normalized.
\end{remark}

\label{Bi and Sesqui Linear Forms}

\subsubsection{Bi and Sesqui Linear Forms}

\begin{notation}
\emph{Covariant} array of basis vectors (which are \emph{contravariant}
vectors)
\begin{equation}
\left(  \mathbf{e}\right)  \equiv\left(  \longleftarrow\mathbf{e\rightarrow
}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)
\end{equation}
and \emph{Contravariant} array of basis vectors (which are
\underline{\emph{also}}\emph{ contravariant} vectors)%
\begin{equation}
\left(
\begin{array}
[c]{c}%
\uparrow\\
\mathbf{e}\\
\downarrow
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{r}%
\end{array}
\right)  .
\end{equation}

\end{notation}

\begin{remark}
The Hilbert space $\mathcal{H}^{1}$ has conbs $\left\{  \left\vert
\mathbf{e}\right\rangle \right\}  $ that lead to resolutions
\begin{equation}
v=\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \mathcal{R}_{e}\left(
v\right)  _{j}%
\end{equation}
i.e.
\begin{equation}
v=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  v\right)  ,
\end{equation}
where $\mathcal{R}_{e}\left(  v\right)  $ is the $r\times1$ matrix i.e. a $r$
complex dimensional column vector
\begin{equation}
\mathcal{R}_{e}\left(  v\right)  =\left(
\begin{array}
[c]{c}%
\left\langle \left.  e_{1}\right\vert v\right\rangle \\
\vdots\\
\left\langle \left.  e_{r}\right\vert v\right\rangle
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{remark}
The representation $\mathcal{R}_{e}$ is an isometric isomorphism
\begin{equation}
\mathcal{R}_{e}:\mathcal{H}^{1}\rightarrow\mathbb{C}^{r},
\end{equation}
hence
\begin{equation}
\mathcal{R}_{e}^{-1}:\mathbb{C}^{r}\rightarrow\mathcal{H}^{1},
\end{equation}
is also an isometric isomorphism.
\end{remark}

\begin{remark}
The representation $\mathcal{R}_{e}$ can be extended to an \emph{algebraic
isomorphism, which we also denote by }$\mathcal{R}_{e}$\emph{ }
\begin{equation}
\mathcal{R}_{e}:\mathcal{B}\left(  \mathcal{H}^{1}\right)  \rightarrow
\mathcal{B}\left(  \mathbb{C}^{r}\right)  .
\end{equation}

\end{remark}

\begin{remark}
$\mathcal{R}_{e}\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}%
^{1}\right)  \right)  $ is not in general a star mapping i.e.
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  \neq\mathcal{R}_{e}\left(
A\right)  ^{\dagger}%
\end{equation}
\underline{\emph{unless}} $\left(  \mathbf{e}\right)  $ is a $\left\langle
\left.  {}\right\vert \right\rangle $-conb.
\end{remark}

\begin{definition}
A \emph{sesquilinear} form is a generalization of a bilinear form. A
\emph{bilinear} form is linear in each of its arguments, but a sesquilinear
form allows one of the arguments to be "twisted" in a semilinear manner, thus
the name; which originates from the Latin numerical prefix sesqui- meaning
"one and a half".
\end{definition}

\begin{definition}
A bilinear or sesquilinear form $B\left(  \cdot,\cdot\right)  $ defined on a
vector space $V$
\begin{equation}
B:V\times V\rightarrow\mathbb{F}%
\end{equation}
is \emph{non degenerative} $\operatorname*{Iff}$
\begin{equation}
B\left(  v,w\right)  =0\quad\forall w\in V\,\Rightarrow v=0,
\end{equation}
otherwise it is \emph{degenerate}.
\end{definition}

\begin{definition}
A vector $v\in V$ is \emph{isotropic} wrt a bilinear or sesquilinear form
$B\left(  \cdot,\cdot\right)  $ if $B\left(  v,v\right)  =0.$
\end{definition}

\begin{definition}
A quadratic, bilinear or sesquilinear form $B\left(  \cdot,\cdot\right)  $
over a field $\mathbb{F}$ is said to be \emph{isotropic} if there is a
non-zero vector on which the form evaluates to zero. Otherwise the quadratic
form is \emph{anisotropic.}
\end{definition}

\begin{notation}
We use $V$ to denote a vector space with no other structure, while we use
$\mathcal{H}$ or $\mathcal{H}^{1}$ to denote Hilbert spaces.
\end{notation}

\begin{remark}
As $\mathcal{H}^{1}$ is a Hilbert space it has by definition an associated
\emph{non degenerate sesquilinear} \emph{and} \emph{anisotropic bilinear inner
product} $\left\langle \left.  {}\right\vert \right\rangle $%
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle :\mathcal{H}^{1}%
\times\mathcal{H}^{1}\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\left\langle \left.  u\right\vert v\right\rangle =\overline{\left\langle
\left.  v\right\vert u\right\rangle }.
\end{equation}

\end{remark}

This bilinear form defines $r\times r$ positive definite hermitian metric
matrices $\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle $
i.e.
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\dagger
}=\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ,
\end{equation}
giving
\begin{equation}
\left\langle \left.  u\right\vert v\right\rangle =\sum_{1\leq j,k\leq
r}\overline{\mathcal{R}_{e}\left(  u\right)  _{j}}\left\langle \left.
e_{j}\right\vert e_{k}\right\rangle \mathcal{R}_{e}\left(  v\right)
_{k}=\mathcal{R}_{e}\left(  u\right)  ^{\dagger}\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  v\right)
=\overline{\left\langle \left.  v\right\vert u\right\rangle }\in\mathbb{C}.
\end{equation}


\begin{remark}
The adjoint map
\begin{gather}
\dagger:\mathcal{B}\left(  \mathcal{H}^{1}\right)  \rightarrow\mathcal{B}%
\left(  \mathcal{H}^{1}\right) \\
\dagger\left(  A\right)  =A^{\dagger}%
\end{gather}
is an anti linear map i.e. $\dagger\in\mathcal{B}_{anti}\left(  \mathcal{B}%
\left(  \mathcal{H}^{1}\right)  \right)  $ and an anti homomorphism i.e.
\begin{equation}
\dagger\left(  AB\right)  =\left(  AB\right)  ^{\dagger}=B^{\dagger}%
A^{\dagger}=\dagger\left(  B\right)  \dagger\left(  A\right)
\end{equation}
and can be defined intrinsically in a $c^{\ast}$-algebra $\mathcal{A\cong
B}\left(  \mathcal{H}^{1}\right)  $ as well as by the inner product
$\left\langle \left.  {}\right\vert \right\rangle $ in $\mathcal{B}\left(
\mathcal{H}^{1}\right)  $ i.e.
\begin{equation}
\left\langle \left.  A^{\dagger}v\right\vert w\right\rangle =\left\langle
\left.  v\right\vert Aw\right\rangle \quad\forall w\in\mathcal{H}^{1}\text{
and }v\in\mathcal{H}^{1},
\end{equation}
which \emph{depends} on the non degeneracy of $\left\langle \left.
{}\right\vert \right\rangle .$
\end{remark}

\begin{remark}
The \emph{matrix} adjoint map
\begin{gather}
\dagger:\mathcal{M}\left(  n,n,\mathbb{C}\right)  \rightarrow\mathcal{M}%
\left(  n,n,\mathbb{C}\right) \\
\dagger\left(  \mathbb{A}\right)  =\mathbb{A}^{\dagger}%
\end{gather}
is defined as
\begin{equation}
A_{kj}=\overline{A_{jk}},\quad1\leq j,k\leq n.
\end{equation}

\end{remark}

\begin{remark}
\emph{The inner product in an a Hilbert space is not unique. This can easily
be seen by considering a given Hilbert space inner product }$\left\langle
\left.  {}\right\vert \right\rangle $ and defining for non singular operators
$A\in GL\left(  \mathcal{H}^{1}\right)  \subset\mathcal{B}\left(
\mathcal{H}^{1}\right)  $ new inner products \emph{ }%
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\left\langle \left.
v\right\vert A^{\dagger}Aw\right\rangle \quad\forall v,w\in\mathcal{H}^{1}.
\end{equation}

\end{remark}

\begin{theorem}
The $\left\langle \left.  {}\right\vert \right\rangle _{A}$-adjoint
$B^{\dagger_{A}}$ is a similarity transformation of $B^{\dagger}$ i.e.
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{theorem}

\begin{proof}
As%
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert w\right\rangle _{A}%
=\left\langle \left.  v\right\vert Bw\right\rangle _{A}%
\end{equation}
then by definition
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert A^{\dagger}Aw\right\rangle
=\left\langle \left.  v\right\vert A^{\dagger}ABw\right\rangle
\end{equation}
hence
\begin{equation}
A^{\dagger}AB^{\dagger_{A}}=B^{\dagger}A^{\dagger}A
\end{equation}
and
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{proof}

\subsubsection{Singular Valid Decompositions. \label{SVD}}

\begin{remark}
\begin{enumerate}
\item The standard Hilbert space overlap (i.e. the $\left\langle \left.
{}\right\vert \right\rangle $-overlap) between the vectors $v$ and $w$ in
terms of representations and matrices wrt a \emph{non} orthonoromal basis
$\left(  \mathbf{e}\right)  $ is given by
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle =\mathcal{R}_{e}\left(
v\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle \mathcal{R}_{e}\left(  w\right)  =\left\langle \left.
v\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right\vert
w\right\rangle =\mathcal{M}_{e}\left(  v\right)  ^{\dagger}\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}%
_{e}\left(  w\right)  .
\end{equation}


\item The nonstanderd Hilbert space $\left\langle \left.  {}\right\vert
\right\rangle _{A}$-overlap induced by between the vectors $v$ and $w$ in
terms of representations and matrices wrt an $\left\langle \left.
{}\right\vert \right\rangle $-orthonormal basis $\left(  \widetilde{\mathbf{e}%
}\right)  \equiv\left\vert \widetilde{\mathbf{e}}\right\rangle $ is given by
$\left\langle \left.  {}\right\vert \right\rangle _{A}$-inner product as
\begin{gather}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\left\langle \left.
v\right\vert A^{\dagger}Aw\right\rangle =\mathcal{R}_{\widetilde{e}}\left(
v\right)  ^{\dagger}\mathcal{R}_{\widetilde{e}}\left(  A\right)  ^{\dagger
}\mathcal{R}_{\widetilde{e}}\left(  A\right)  \mathcal{R}_{\widetilde{e}%
}\left(  w\right)  =\mathcal{R}_{\widetilde{e}}\left(  v\right)  ^{\dagger
}\left\langle \left.  A\mathbf{\widetilde{e}}\right\vert
A\mathbf{\widetilde{e}}\right\rangle \mathcal{R}_{\widetilde{e}}\left(
w\right) \\
=\mathcal{R}_{\widetilde{e}}\left(  v\right)  ^{\dagger}\mathcal{R}%
_{\widetilde{e}}\left(  A^{\dagger}A\right)  \mathcal{R}_{\widetilde{e}%
}\left(  v\right)  =\mathcal{M}_{\widetilde{e}}\left(  v\right)  ^{\dagger
}\mathcal{M}_{\widetilde{e}}\left(  A^{\dagger}A\right)  \mathcal{M}%
_{\widetilde{e}}\left(  v\right)
\end{gather}


\item Relationship between the symmetrical orthonormalized conb $\left\vert
\widetilde{\mathbf{e}}\right\rangle $ and the corresponding general basis
$\left\vert \mathbf{e}\right\rangle $

\begin{enumerate}
\item
\begin{equation}
\left\vert \widetilde{\mathbf{e}}\right\rangle =\left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-\frac{1}{2}}=T_{\widetilde{e}e}\left\vert \mathbf{e}%
\right\rangle
\end{equation}


\item
\begin{equation}
\left\vert \widetilde{\mathbf{e}}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac{1}{2}}=\left\vert
\mathbf{e}\right\rangle =T_{\widetilde{e}e}^{-1}\left\vert
\widetilde{\mathbf{e}}\right\rangle .
\end{equation}

\end{enumerate}

\item The transformation can be expressed as
\begin{equation}
T_{\widetilde{e}e}=\left\vert \widetilde{\mathbf{e}}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert =\left\vert \widetilde{\mathbf{e}}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{\frac{1}{2}}\left\langle \widetilde{\mathbf{e}}\right\vert =\left\vert
\widetilde{\mathbf{e}}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-\frac{1}{2}}\left\langle \widetilde{\mathbf{e}%
}\right\vert
\end{equation}
and its action on

\begin{enumerate}
\item basis elements $\left(  \mathbf{e}\right)  $ as
\begin{equation}
T_{\widetilde{e}e}\left\vert \mathbf{e}\right\rangle =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-\frac{1}{2}}=\left\vert \widetilde{\mathbf{e}%
}\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle =\left\vert \widetilde{\mathbf{e}}\right\rangle
\end{equation}


\item vectors $v$
\begin{align}
v  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
v=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  v\right)
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  v\right) \\
v  &  =\left\vert \widetilde{\mathbf{e}}\right\rangle \left\langle
\widetilde{\mathbf{e}}\right\vert v=\left\vert \widetilde{\mathbf{e}%
}\right\rangle \mathcal{M}_{\widetilde{e}}\left(  v\right)  =\left\vert
\widetilde{\mathbf{e}}\right\rangle \mathcal{R}_{\widetilde{e}}\left(
v\right)
\end{align}


\item as
\begin{align}
T_{\widetilde{e}e}\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{\widetilde{e}}\left(  v\right)   &  =\left\vert \widetilde{\mathbf{e}%
}\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle \mathcal{R}_{\widetilde{e}}\left(  v\right)
=\left\vert \widetilde{\mathbf{e}}\right\rangle \mathcal{R}_{\widetilde{e}%
}\left(  v\right) \\
T_{\widetilde{e}e}\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{\widetilde{e}}\left(  v\right)   &  =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}\mathcal{R}_{\widetilde{e}}\left(  v\right)  .
\end{align}

\end{enumerate}

\item The relationship between the $\left(  \mathbf{e}\right)  $ and $\left(
\widetilde{\mathbf{e}}\right)  $ representations of $v$ are

\begin{enumerate}
\item
\begin{gather}
v=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  v\right)
=\left\vert \widetilde{\mathbf{e}}\right\rangle \mathcal{R}_{\widetilde{e}%
}\left(  v\right)  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac{1}{2}}\mathcal{R}%
_{\widetilde{e}}\left(  v\right) \\
\mathcal{R}_{e}\left(  v\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-\frac{1}{2}}\mathcal{R}_{\widetilde{e}}\left(
v\right) \\
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac
{1}{2}}\mathcal{R}_{e}\left(  v\right)  =\mathcal{R}_{\widetilde{e}}\left(
v\right)  =\mathcal{M}_{\widetilde{e}}\left(  v\right)
\end{gather}


\item
\begin{gather}
v=\left\vert \widetilde{\mathbf{e}}\right\rangle \mathcal{R}_{\widetilde{e}%
}\left(  v\right)  =\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
v\right)  =T_{\widetilde{e}e}\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{\widetilde{e}}\left(  v\right)  =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}\mathcal{R}_{\widetilde{e}}\left(  v\right) \\
\mathcal{R}_{e}\left(  v\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-\frac{1}{2}}\mathcal{R}_{\widetilde{e}}\left(
v\right)  =\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-\frac{1}{2}}\mathcal{M}_{\widetilde{e}}\left(  v\right)  .
\end{gather}


\item
\begin{equation}
\mathcal{R}_{e}\left(  v\right)  ^{\dagger}\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  w\right)
=\mathcal{R}_{\widetilde{e}}\left(  v\right)  ^{\dagger}\mathcal{R}%
_{\widetilde{e}}\left(  A^{\dagger}A\right)  \mathcal{R}_{\widetilde{e}%
}\left(  w\right)  =\mathcal{R}_{e}\left(  v\right)  ^{\dagger}\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac{1}{2}%
}\mathcal{R}_{\widetilde{e}}\left(  A^{\dagger}A\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac{1}{2}}\mathcal{R}%
_{e}\left(  w\right)  .
\end{equation}
where one \emph{defines}
\begin{equation}
\mathcal{R}_{\widetilde{e}}\left(  A^{\dagger}A\right)  =\mathcal{M}%
_{\widetilde{e}}\left(  A^{\dagger}A\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle .
\end{equation}


\item As%
\begin{equation}
\left\vert \widetilde{\mathbf{e}}\right\rangle =\left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-\frac{1}{2}}.
\end{equation}
one obtains
\begin{equation}
A^{\dagger}A=\left\vert \widetilde{\mathbf{e}}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle \left\langle
\widetilde{\mathbf{e}}\right\vert =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert ,
\end{equation}
i.e.
\begin{equation}
A^{\dagger}A=\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert .
\end{equation}


\item The SVD of $A^{\dagger}A\in\mathcal{B}_{0}\left(  \mathcal{H}%
^{1}\right)  $ is
\begin{equation}
A^{\dagger}A=U\Sigma\left(  A^{\dagger}A\right)  U^{\dagger}.
\end{equation}


\item The \emph{spectral} decomposition of $A^{\dagger}A\in\mathcal{B}%
_{0}\left(  \mathcal{H}^{1}\right)  $ is%
\begin{equation}
A^{\dagger}A=\sum_{1\leq j\leq n}\left\vert \alpha_{j}\right\rangle
\Sigma\left(  A^{\dagger}A\right)  _{jj}\left\langle \alpha_{j}\right\vert
=\left\vert \mathbf{\alpha}\right\rangle \mathcal{R}_{\alpha}\left(
A^{\dagger}A\right)  \left\langle \mathbf{\alpha}\right\vert =\left\vert
\mathbf{\alpha}\right\rangle \left\langle \mathbf{\alpha}\right\vert
A^{\dagger}A\left\vert \mathbf{\alpha}\right\rangle \left\langle
\mathbf{\alpha}\right\vert =\left\vert \mathbf{\alpha}\right\rangle
\mathcal{M}_{\alpha}\left(  A^{\dagger}A\right)  \left\langle \mathbf{\alpha
}\right\vert ,
\end{equation}
where the set of eigenvectors $\left\vert \mathbf{\alpha}\right\rangle $ is a
conb of $\mathcal{H}^{1}$ and $\left\{  \left.  \Sigma\left(  A^{\dagger
}A\right)  _{jj}\right\vert 1\leq j\leq r\right\}  $ are the eigenvalues of
$A^{\dagger}A.$ Hence the SVD of $A^{\dagger}A$ \underline{\emph{is the}}
specral decomposition of $A^{\dagger}A.$

\item Let $\left\vert \mathbf{a}\right\rangle $ be the \emph{conjugate
vectors} of $A^{\dagger}A$ i.e.
\begin{equation}
\left\langle \mathbf{a}\right\vert A^{\dagger}A\left\vert \mathbf{a}%
\right\rangle =\mathbb{I}_{n}%
\end{equation}
then

\item the representation matrix $\mathcal{R}_{a}\left(  A^{\dagger}A\right)  $
and the matrix $\mathcal{M}_{a}\left(  A^{\dagger}A\right)  $ are related by
\begin{equation}
\mathcal{R}_{a}\left(  A^{\dagger}A\right)  =\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{M}_{a}\left(
A^{\dagger}A\right)  =\left\langle \left.  \mathbf{a}\right\vert
\mathbf{a}\right\rangle ^{-1}.
\end{equation}


\item $A^{\dagger}A$ can be expressed in terms of its conjugate vectors as
\begin{equation}
A^{\dagger}A\ =\left\vert \mathbf{a}\right\rangle \left\langle \mathbf{a}%
\right\vert \left\vert \mathbf{a}\right\rangle ^{-1}\left\langle
\mathbf{a}\right\vert A^{\dagger}A\left\vert \mathbf{a}\right\rangle
\left\langle \mathbf{a}\right\vert \left\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert =\left(  \left\vert \mathbf{a}%
\right\rangle \left\langle \mathbf{a}\right\vert \left\vert \mathbf{a}%
\right\rangle ^{-1}\right)  \left(  \left\langle \mathbf{a}\right\vert
\left\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}\right\vert
\right)  =\left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-2}\left\langle \mathbf{a}%
\right\vert .
\end{equation}


\item Hence as
\begin{equation}
A^{\dagger}A=\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert
\end{equation}
one obtains
\begin{equation}
\left\vert \mathbf{e}\right\rangle =\left\vert \mathbf{a}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1},
\end{equation}
which is confirmed by

\item defining a new basis $\left\vert \mathbf{a}^{\#}\right\rangle $ by
\begin{equation}
\left\vert \mathbf{a}^{\#}\right\rangle =\left\vert \mathbf{a}\right\rangle
\left\langle \mathbf{a}\right\vert \left\vert \mathbf{a}\right\rangle ^{-1}%
\end{equation}
then
\begin{equation}
A^{\dagger}A\ =\left\vert \mathbf{a}^{\#}\right\rangle \left\langle
\mathbf{a}^{\#}\right\vert =\sum_{1\leq j\leq r}\left\vert a_{j}%
^{\#}\right\rangle \left\langle a_{j}^{\#}\right\vert
\end{equation}
and
\begin{equation}
\left\langle \left.  \mathbf{a}^{\#}\right\vert \mathbf{a}^{\#}\right\rangle
=\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}%
\end{equation}
hence
\begin{equation}
\left\vert \mathbf{a}^{\#}\right\rangle =\left\vert \mathbf{e}\right\rangle .
\end{equation}


\item The transformation from the conjugate basis $\left\vert \mathbf{a}%
\right\rangle $ to the eigen basis $\left\vert \mathbf{\alpha}\right\rangle $
\begin{equation}
T_{\alpha a}=\left\vert \mathbf{\alpha}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert :\left\vert \mathbf{a}\right\rangle \rightarrow\left\vert
\mathbf{\alpha}\right\rangle
\end{equation}
is
\begin{gather}
T_{\alpha a}\left\vert \mathbf{a}\right\rangle =\left\vert \mathbf{\alpha
}\right\rangle =\left\vert \mathbf{a}\right\rangle \mathcal{R}_{a}\left(
T_{\alpha a}\right)  =\left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert \left\vert \mathbf{\alpha}\right\rangle \\
\Downarrow
\end{gather}%
\begin{gather}
\mathcal{R}_{a}\left(  T_{\alpha a}\right)  =\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert \left\vert \mathbf{\alpha}\right\rangle \\
\Downarrow\\
\mathcal{M}_{a}\left(  T_{\alpha a}\right)  =\left\langle \mathbf{a}%
\right\vert T_{\alpha a}\left\vert \mathbf{a}\right\rangle =\left\langle
\mathbf{a}\right\vert \left\vert \mathbf{\alpha}\right\rangle .
\end{gather}


\item The transformation from the eigen basis $\left\vert \mathbf{\alpha
}\right\rangle $ to the conjugate basis $\left\vert \mathbf{a}\right\rangle $
\begin{equation}
T_{a\alpha}=\left\vert \mathbf{a}\right\rangle \left\langle \mathbf{\alpha
}\right\vert :\left\vert \mathbf{\alpha}\right\rangle \rightarrow\left\vert
\mathbf{a}\right\rangle
\end{equation}
is%
\begin{equation}
T_{a\alpha}\left\vert \mathbf{\alpha}\right\rangle =\left\vert \mathbf{a}%
\right\rangle =\left\vert \mathbf{\alpha}\right\rangle \mathcal{R}_{\alpha
}\left(  T_{a\alpha}\right)  =\left\vert \mathbf{\alpha}\right\rangle
\left\langle \mathbf{\alpha}\right\vert \left\vert \mathbf{\alpha
}\right\rangle ^{-1}\left\langle \mathbf{\alpha}\right\vert \left\vert
\mathbf{a}\right\rangle =\left\vert \mathbf{\alpha}\right\rangle \left\langle
\mathbf{\alpha}\right\vert \left\vert \mathbf{a}\right\rangle ,
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{\alpha}\left(  T_{ae}\right)  =\left\langle \mathbf{\alpha
}\right\vert \left\vert \mathbf{a}\right\rangle =\mathcal{M}_{\alpha}\left(
T_{ae}\right)  .
\end{equation}


\item The inverse relationships are confirmed by
\begin{align}
T_{\alpha a}T_{a\alpha}  &  =\left\vert \mathbf{\alpha}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert \left\vert \mathbf{a}\right\rangle
\left\langle \mathbf{\alpha}\right\vert =\left\vert \mathbf{\alpha
}\right\rangle \left\langle \mathbf{\alpha}\right\vert =I_{\mathcal{H}^{1}}\\
T_{a\alpha}T_{\alpha a}  &  =\left\vert \mathbf{a}\right\rangle \left\langle
\mathbf{\alpha}\right\vert \left\vert \mathbf{\alpha}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert =\left\vert \mathbf{a}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert =I_{\mathcal{H}^{1}}.
\end{align}


\item The spectral expansion and SVD of $A^{\dagger}A$ are the same%
\begin{equation}
A^{\dagger}A=U^{\dagger}\Sigma\left(  A^{\dagger}A\right)  U=\sum_{1\leq j\leq
n}\left\vert a_{j}\right\rangle \mathcal{R}_{a}\left(  \Sigma\left(
A^{\dagger}A\right)  \right)  _{jj}\left\langle a_{j}\right\vert \
\end{equation}
this gives

\item
\begin{gather}
\sum_{1\leq j\leq n}\left\vert \alpha_{j}\right\rangle \mathcal{R}_{a}\left(
\Sigma\left(  A^{\dagger}A\right)  \right)  _{jj}\left\langle \alpha
_{j}\right\vert \left(  \left\vert \alpha_{k}\right\rangle \mathcal{R}%
_{a}\left(  \Sigma\left(  A^{\dagger}A\right)  \right)  _{kk}^{-\frac{1}{2}%
}\right)  =\left\vert \alpha_{k}\right\rangle \mathcal{R}_{a}\left(
\Sigma\left(  A^{\dagger}A\right)  \right)  _{kk}^{\frac{1}{2}}\\
\Downarrow\\
\left(  \left\langle \alpha_{l}\right\vert \mathcal{R}_{a}\left(
\Sigma\left(  A^{\dagger}A\right)  \right)  _{ll}^{-\frac{1}{2}}\right)
A^{\dagger}A\left(  \left\vert \alpha_{k}\right\rangle \mathcal{R}_{a}\left(
\Sigma\left(  A^{\dagger}A\right)  \right)  _{kk}^{-\frac{1}{2}}\right)
=\left(  \left\langle \alpha_{l}\right\vert \mathcal{R}_{a}\left(
\Sigma\left(  A^{\dagger}A\right)  \right)  _{kk}^{-\frac{1}{2}}\right)
\left(  \left\vert \alpha_{k}\right\rangle \mathcal{R}_{a}\left(
\Sigma\left(  A^{\dagger}A\right)  \right)  _{kk}^{\frac{1}{2}}\right)
=\delta_{lk}\\
1\leq l,k\leq n
\end{gather}
hence the conjugate vectors in terms of the eigenvectors are
\begin{equation}
\left\vert a_{k}\right\rangle =\left(  \left\vert \alpha_{k}\right\rangle
\mathcal{R}_{a}\left(  \Sigma\left(  A^{\dagger}A\right)  \right)
_{kk}^{-\frac{1}{2}}\right)  ,\,1\leq k\leq r,
\end{equation}
i.e.%
\begin{equation}
\left\vert \mathbf{a}\right\rangle =\left\vert \mathbf{\alpha}\right\rangle
\Sigma\left(  A^{\dagger}A\right)  ^{-\frac{1}{2}}%
\end{equation}
and thus the eigenvectors vectors in terms of the conjugate are
\begin{equation}
\left\vert \mathbf{\alpha}\right\rangle =\left\vert \mathbf{a}\right\rangle
\Sigma\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}.
\end{equation}

\end{enumerate}

\item This should be compared to the \emph{symmetrical orthonormalized} basis
$\left\vert \widetilde{\mathbf{a}}\right\rangle $ produced by the conjugate
vectors that is produced by
\begin{equation}
\left\vert \widetilde{\mathbf{a}}\right\rangle =\left\vert \mathbf{a}%
\right\rangle \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-\frac{1}{2}},
\end{equation}
which is different.

\item Consider the conjugate vectors $\left\vert \mathbf{a}\right\rangle $
\begin{equation}
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
_{A^{\dagger}A}=\mathbb{I}_{r}=\left\langle \left.  \mathbf{a}\right\vert
A^{\dagger}A\mathbf{a}\right\rangle
\end{equation}
then%
\begin{equation}
A^{\dagger}A=\left(  \left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert \right)  A^{\dagger}A\left(  \left\vert \mathbf{a}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert \right)  =\left\vert \mathbf{a}%
\right\rangle \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\left\langle \mathbf{a}\right\vert =\left\vert
\mathbf{a}\right\rangle \left\langle \left.  \mathbf{a}\right\vert
\mathbf{a}\right\rangle ^{-2}\left\langle \mathbf{a}\right\vert ,
\end{equation}
which is confirmed by%
\begin{equation}
\left\langle \mathbf{a}\right\vert \left(  \left\vert \mathbf{a}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-2}\left\langle \mathbf{a}\right\vert \right)  \left\vert \mathbf{a}%
\right\rangle =\mathbb{I}_{r}.
\end{equation}


\begin{enumerate}
\item The Hilbert space inner product $\left\langle \left.  {}\right\vert
\right\rangle $ of $v,w\in\mathcal{H}^{1}$ can be expressed using the
conjugate vectors $\left\vert \mathbf{a}\right\rangle $ and the symmetrical
orthonormalized basis $\left\vert \widetilde{\mathbf{a}}\right\rangle $
conjugate vectors as%
\begin{align}
\left\langle \left.  v\right\vert w\right\rangle  &  =\;\mathcal{R}_{a}\left(
v\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle \mathcal{R}_{a}\left(  w\right)  \;\;\,=\;\mathcal{M}_{a}\left(
v\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\mathcal{M}_{a}\left(  w\right) \\
&  =\mathcal{R}_{\widetilde{a}}\left(  v\right)  ^{\dagger}\mathcal{R}%
_{\widetilde{a}}\left(  A^{\dagger}A\right)  \mathcal{R}_{\widetilde{a}%
}\left(  w\right)  =\mathcal{M}_{\widetilde{a}}\left(  v\right)  ^{\dagger
}\mathcal{M}_{\widetilde{a}}\left(  A^{\dagger}A\right)  \mathcal{M}%
_{\widetilde{a}}\left(  w\right)  .
\end{align}


\item The Hilbert space inner product $\left\langle \left.  v\right\vert
w\right\rangle _{A}$ of $v,w\in\mathcal{H}^{1}$ can be expressed using the
symmetrical orthonormalized basis $\left\vert \widetilde{\mathbf{a}%
}\right\rangle $ conjugate vectors as%
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\mathcal{R}%
_{\widetilde{a}}\left(  v\right)  ^{\dagger}\mathcal{R}_{\widetilde{a}}\left(
A^{\dagger}A\right)  \mathcal{R}_{\widetilde{a}}\left(  w\right)
=\mathcal{M}_{\widetilde{a}}\left(  v\right)  ^{\dagger}\mathcal{M}%
_{\widetilde{a}}\left(  A^{\dagger}A\right)  \mathcal{M}_{\widetilde{a}%
}\left(  w\right)  =\mathcal{M}_{\widetilde{a}}\left(  v\right)  ^{\dagger
}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\mathcal{M}_{\widetilde{a}}\left(  w\right)  =\mathcal{R}_{\widetilde{a}%
}\left(  v\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert
\mathbf{a}\right\rangle ^{-1}\mathcal{R}_{\widetilde{a}}\left(  w\right)  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{theorem}%
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\left\langle \left.
\mathbf{a}\right\vert v\right\rangle ^{\dagger}\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-2}\left\langle \left.
\mathbf{a}\right\vert w\right\rangle .
\end{equation}

\end{theorem}

\begin{proof}
Symmetric orthonormalized conjugate directions $\left\vert
\widetilde{\mathbf{a}}\right\rangle $ are given as
\begin{equation}
\left\vert \widetilde{\mathbf{a}}\right\rangle =\left\vert \mathbf{a}%
\right\rangle \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-\frac{1}{2}}%
\end{equation}
the matrix of vectors wrt to this basis are
\begin{equation}
\mathcal{M}_{\widetilde{a}}\left(  v\right)  =\left\langle \left.
\widetilde{\mathbf{a}}\right\vert v\right\rangle =\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-\frac{1}{2}}\left\langle
\left.  \mathbf{a}\right\vert v\right\rangle
\end{equation}
leading to
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\mathcal{M}%
_{\widetilde{a}}\left(  v\right)  ^{\dagger}\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{M}_{\widetilde{a}%
}\left(  w\right)  =\left\langle \left.  \mathbf{a}\right\vert v\right\rangle
^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-\frac{1}{2}}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-\frac{1}{2}}\left\langle \left.  \mathbf{a}\right\vert
w\right\rangle =\left\langle \left.  \mathbf{a}\right\vert v\right\rangle
^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-2}\left\langle \left.  \mathbf{a}\right\vert w\right\rangle ,
\end{equation}
and thus the theorem. This should be compared to
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle =\mathcal{M}_{a}\left(
v\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\mathcal{M}_{a}\left(  w\right)  .
\end{equation}


\begin{remark}%
\begin{equation}
\left\langle \left.  \mathbf{a}\right\vert v\right\rangle ^{\dagger
}=\left\langle \left.  v\right\vert \mathbf{a}\right\rangle
\end{equation}

\end{remark}
\end{proof}

\begin{theorem}
$B^{\dagger_{A}}$ is a similarity transformation of $B^{\dagger}$ i.e.
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{theorem}

\begin{proof}
As%
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert w\right\rangle _{A}%
=\left\langle \left.  v\right\vert Bw\right\rangle _{A}%
\end{equation}
then by definition
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert A^{\dagger}Aw\right\rangle
=\left\langle \left.  v\right\vert A^{\dagger}ABw\right\rangle
\end{equation}
hence
\begin{equation}
A^{\dagger}AB^{\dagger_{A}}=B^{\dagger}A^{\dagger}A
\end{equation}
and
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{proof}

\begin{remark}
The $1\times r$ matrix $\mathcal{M}_{e}\left(  v\right)  =\left\langle \left.
\mathbf{e}\right\vert v\right\rangle $ of the vector $v$ generated by an
arbitary basis $\left(  \mathbf{e}\right)  $ is related to the metric matrix
by%
\begin{gather}
v=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  v\right) \\
\Downarrow\\
\left\langle \mathbf{e}\right\vert \left\vert v\right\rangle =\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
v\right) \\
\Downarrow\\
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \left.  \mathbf{e}\right\vert v\right\rangle =\mathcal{R}%
_{e}\left(  v\right)  .
\end{gather}
This can also be oberved by using the resolution of the identity
\begin{gather}
v=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
v=\left(  \mathbf{e}\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
v\right\rangle =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right) \\
\mathcal{R}_{e}\left(  v\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
v\right\rangle =\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\mathcal{M}_{e}\left(  v\right)  .
\end{gather}

\end{remark}

\begin{definition}
\emph{Bilinear complex symmetric nondegenrate inner product} $\left(  \left.
{}\right\vert \right)  $
\begin{equation}
\left(  \left.  {}\right\vert \right)  :\mathcal{H}^{1}\times\mathcal{H}%
^{1}\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\left(  \left.  u\right\vert v\right)  =\left(  \left.  v\right\vert u\right)
.
\end{equation}

\end{definition}

\begin{remark}
$\left(  \left.  {}\right\vert \right)  $ \emph{does not} define a metric as

A metric $d$ on a set $X$ is a function (called distance function or simply
distance)%
\begin{equation}
d:X\times\ X\rightarrow\mathbb{R}%
\end{equation}


such that for all $x,y,z\in X$ one has

\begin{enumerate}
\item identity of points%
\begin{equation}
d(x,y)=0\Longleftrightarrow x=y
\end{equation}


\item symmetry%
\begin{equation}
d(x,y)=d(y,x)
\end{equation}


\item triangle inequality%
\begin{equation}
d(x,z)\leq d(x,y)+d(y,z).
\end{equation}
\qquad\qquad\ \qquad
\end{enumerate}
\end{remark}

\begin{remark}
The $r\times r$ \emph{matrices} $\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  $ for any basis $\left(  \mathbf{e}\right)  $ are complex
symmetric i.e.
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{t}=\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  .
\end{equation}
giving%
\begin{equation}
\left(  \left.  u\right\vert v\right)  =\sum_{1\leq j,k\leq r}\mathcal{R}%
_{e}\left(  u\right)  _{j}\left(  \left.  e_{j}\right\vert e_{k}\right)
\mathcal{R}_{e}\left(  v\right)  _{k}=\mathcal{R}_{e}\left(  u\right)
^{t}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  v\right)  =\left(  \left.  v\right\vert u\right)  \in\mathbb{C}.
\end{equation}

\end{remark}

\begin{notation}
\begin{enumerate}
\item A basis $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ is
denoted by $\left(  \longleftarrow\mathbf{e\rightarrow}\right)  \equiv\left(
\mathbf{e}\right)  .$

\item If the basis is also $\left\langle \left.  {}\right\vert \right\rangle
$-orthonormal then it is denoted by $\left\vert \mathbf{e}\right\rangle .$

\item If the basis is also $\left(  \left.  {}\right\vert \right)
$-orthonormal then it is denoted by $\left\vert \mathbf{e}\right)  .$
\end{enumerate}
\end{notation}

\begin{lemma}
(W. GRAGG,\thinspace A. BUNSE-GERSTNER; Journal of Computational and Applied
Mathematics 21 (1988) 41-54.) The \emph{complex symmetric} \emph{matrix}%
\begin{equation}
\mathbb{A}\in\mathcal{M}\left(  r,r,\mathbb{C}\right)
\end{equation}
has a SVD
\begin{equation}
\mathbb{A}=\mathbb{U}_{A}^{t}\mathbf{\Sigma}_{A}\mathbb{U}_{A}=\left(
\begin{array}
[c]{ccc}%
\mathbf{u}_{A1}^{t} & \cdots & \mathbf{u}_{Ar}^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{cccc}%
\sigma_{A1} & 0 & \cdots & 0\\
\vdots & \ddots & \vdots & \vdots\\
\vdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \sigma_{A2r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{u}_{A1}\\
\vdots\\
\mathbf{u}_{Ar}%
\end{array}
\right)  =\sum_{1\leq j\leq r}\mathbf{u}_{Aj}^{t}\sigma_{Aj}\mathbf{u}_{Aj},
\end{equation}
where $\mathbb{U}_{\mathbf{e}}$ is a unitary matrix i.e.
\begin{equation}
\mathbb{U}_{A}\mathbb{U}_{A}^{\dagger}=\mathbb{U}_{A}^{\dagger}\mathbb{U}%
_{A}=\mathbb{I}_{r}%
\end{equation}
and the proper values are positive i.e.
\begin{equation}
\sigma_{Aj}\geq0,\quad1\leq j\leq r.
\end{equation}

\end{lemma}

\begin{lemma}
The abstract form of this theorem in $\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  $ is
\begin{equation}
A=u_{A}^{t}\Sigma\left(  A\right)  u_{A},
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
A=A^{t},
\end{equation}


\item
\begin{equation}
\Sigma_{A}\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{+},u_{A}\in U\left(
\mathcal{H}^{1}\right)  \text{ and }u_{A}^{t}\text{ is defined by }\left(
\left.  {}\right\vert \right)
\end{equation}
and

\item $\Sigma\left(  A\right)  $ is a positive operator that belongs to a
maximal abelian subalgebra of $\mathcal{B}\left(  \mathcal{H}^{1}\right)  .$
\end{enumerate}
\end{lemma}

\begin{remark}
Let $\left\vert \mathbf{e}\right\rangle $ and $\left\vert \mathbf{f}%
\right\rangle $ be two different conbs and define
\begin{equation}
\Sigma_{e\sigma}=\sum_{1\leq j\leq r}\sigma_{j}\left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert
\end{equation}
and
\begin{equation}
\Sigma_{f\eta}=\sum_{1\leq j\leq r}\eta_{j}\left\vert f_{j}\right\rangle
\left\langle f_{j}\right\vert
\end{equation}
then in general
\begin{equation}
\left[  \Sigma_{e\sigma},\Sigma_{f\eta}\right]  \neq0
\end{equation}
as
\begin{align}
\Sigma_{e\sigma}\Sigma_{f\eta}  &  =\sum_{1\leq j,k\leq n}\sigma_{j}\eta
_{j}\left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle f_{j}\right\vert \\
\Sigma_{f\eta}\Sigma_{e\sigma}  &  =\sum_{1\leq j,k\leq n}\sigma_{j}\eta
_{j}\left\vert f_{j}\right\rangle \left\langle f_{j}\right\vert \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert ,
\end{align}
i.e. \emph{belong to different maximal abelian subalgebras}.
\end{remark}

\begin{definition}
Generalized matrix inverse%
\begin{equation}
\mathbb{A}^{-1}=\,\,\mathbb{U}_{A}^{\dagger}\mathbf{\Sigma}\left(  A\right)
^{-1}\overline{\mathbb{U}_{A}},
\end{equation}
where
\begin{equation}
\sigma_{Aj}^{-1}=\left\{
\begin{array}
[c]{c}%
\sigma_{Aj}^{-1}\text{ if }\sigma_{Aj}\neq0\\
0\text{ if }\sigma_{Aj}=0
\end{array}
\right.  ,\quad1\leq j\leq r.
\end{equation}

\end{definition}

\begin{lemma}
$\mathbb{A}^{-1}$ is the generalized inverse of $\mathbb{A}$
\end{lemma}

\begin{proof}%
\begin{align}
\mathbb{AA}^{-1}  &  =\left(  \mathbb{U}_{A}^{t}\mathbf{\Sigma}\left(
A\right)  \mathbb{U}_{A}\right)  \left(  \mathbb{U}_{A}^{\dagger
}\mathbf{\Sigma}\left(  A\right)  ^{-1}\overline{\mathbb{U}_{A}}\right)
=\mathbb{U}_{A}^{t}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \overline{\mathbb{U}_{A}}=\mathbb{P}_{\operatorname*{Range}\left(
\mathbb{A}\right)  }\\
\mathbb{A}^{-1}\mathbb{A}  &  =\left(  \mathbb{U}_{A}^{\dagger}\mathbf{\Sigma
}\left(  A\right)  ^{-1}\overline{\mathbb{U}_{A}}\right)  \left(
\mathbb{U}_{A}^{t}\mathbf{\Sigma}\left(  A\right)  \mathbb{U}_{A}\right)
=\mathbb{U}_{A}^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \mathbb{U}_{A}=\mathbb{P}_{\operatorname*{Range}\left(
\mathbb{A}^{-1}\right)  },
\end{align}
where $\mathbb{P}_{\operatorname*{Range}\left(  \mathbb{A}\right)  }$ and
$\mathbb{P}_{\operatorname*{Range}\left(  \mathbb{A}^{-1}\right)  }$ are
orthogonal projectors (but not orthogonal to each other), which is shown by
\begin{equation}
\mathbb{U}_{A}^{t}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \overline{\mathbb{U}_{A}}\mathbb{U}_{A}^{t}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \overline{\mathbb{U}_{A}}=\mathbb{U}_{A}^{t}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \overline{\mathbb{U}_{A}}%
\end{equation}
and%
\begin{equation}
\mathbb{U}_{A}^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \mathbb{U}_{A}\mathbb{U}_{A}^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \mathbb{U}_{A}=\mathbb{U}_{A}^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-\eta} & \mathbb{O}_{r-\eta,\eta}\\
\mathbb{O}_{r-\eta,\eta}^{\dagger} & \mathbb{O}_{\eta}%
\end{array}
\right)  \mathbb{U}_{A}.
\end{equation}
Hence $\mathbb{A}^{-1}$ satisfies the generalized inverse condition
\begin{equation}
\mathbb{AA}^{-1}\mathbb{A=A}%
\end{equation}
and is in fact the \emph{psuedo inverse} of $\mathbb{A}.$
\end{proof}

\begin{example}
The overlap matrix $\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ has a SVD
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\mathbb{U}%
_{\mathbf{e}}^{t}\mathbf{\Sigma}_{\mathbf{e}}\mathbb{U}_{\mathbf{e}}=\left(
\begin{array}
[c]{ccc}%
\mathbf{u}_{e1}^{t} & \cdots & \mathbf{u}_{e2r}^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{cccc}%
\sigma_{e1} & 0 & \cdots & 0\\
\vdots & \ddots & \vdots & \vdots\\
\vdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \sigma_{er}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{u}_{e1}\\
\vdots\\
\mathbf{u}_{er}%
\end{array}
\right)  =\sum_{1\leq j\leq r}\mathbf{u}_{ej}^{t}\sigma_{ej}\mathbf{u}_{ej},
\end{equation}
where $\mathbb{U}_{\mathbf{e}}$ is a unitary matrix i.e.
\begin{equation}
\mathbb{U}_{\mathbf{e}}\mathbb{U}_{\mathbf{e}}^{\dagger}=\mathbb{U}%
_{\mathbf{e}}^{\dagger}\mathbb{U}_{\mathbf{e}}=\mathbb{I}_{r}.
\end{equation}

\end{example}

\begin{example}
The adjoint of the complex symmetric overlap matrix $\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  $
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{\dagger}%
=\mathbb{U}_{\mathbf{e}}^{\dagger}\mathbf{\Sigma}_{\mathbf{e}}\overline
{\mathbb{U}_{\mathbf{e}}},
\end{equation}
which gives
\begin{align}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{\dagger}\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)   &  =\mathbb{U}_{\mathbf{e}%
}^{\dagger}\mathbf{\Sigma}_{\mathbf{e}}\overline{\mathbb{U}_{\mathbf{e}}%
}\mathbb{U}_{\mathbf{e}}^{t}\mathbf{\Sigma}_{\mathbf{e}}\mathbb{U}%
_{\mathbf{e}}=\mathbb{U}_{\mathbf{e}}^{\dagger}\mathbf{\Sigma}_{\mathbf{e}%
}^{2}\mathbb{U}_{\mathbf{e}}\\
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{\dagger}  &  =\mathbb{U}%
_{\mathbf{e}}^{t}\mathbf{\Sigma}_{\mathbf{e}}\mathbb{U}_{\mathbf{e}}%
\mathbb{U}_{\mathbf{e}}^{\dagger}\mathbf{\Sigma}_{\mathbf{e}}\overline
{\mathbb{U}_{\mathbf{e}}}=\mathbb{U}_{\mathbf{e}}^{t}\mathbf{\Sigma
}_{\mathbf{e}}^{2}\overline{\mathbb{U}_{\mathbf{e}}}%
\end{align}
and hence
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{\dagger}\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\overline{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{\dagger}}%
\end{equation}
so in general it is not a normal matrix i.e.%
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{\dagger}\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  \neq\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{\dagger}.
\end{equation}

\end{example}

\begin{corollary}%
\begin{equation}
\mathbf{\Sigma}_{\mathbf{e}}=\overline{\mathbb{U}_{\mathbf{e}}}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \mathbb{U}_{\mathbf{e}}^{\dagger
}=\mathbb{U}_{\mathbf{e}}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  \mathbb{U}_{\mathbf{e}}^{t}%
\end{equation}
where%
\begin{equation}
\mathbb{U}_{\mathbf{e}}\mathbb{U}_{\mathbf{e}}^{\dagger}=\mathbb{U}%
_{\mathbf{e}}^{\dagger}\mathbb{U}_{\mathbf{e}}=\mathbb{I}_{r}.
\end{equation}

\end{corollary}

\begin{proof}%
\begin{equation}
\overline{\mathbb{U}_{\mathbf{e}}\mathbb{U}_{\mathbf{e}}^{\dagger}}%
=\overline{\mathbb{U}_{\mathbf{e}}^{\dagger}\mathbb{U}_{\mathbf{e}}}%
=\overline{\mathbb{U}_{\mathbf{e}}}\mathbb{U}_{\mathbf{e}}^{t}=\mathbb{U}%
_{\mathbf{e}}^{t}\overline{\mathbb{U}_{\mathbf{e}}}=\mathbb{I}_{r}.
\end{equation}

\end{proof}

\begin{lemma}
The metric matrix $\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  $
of the complex symmetric bilinear form $\left(  \left.  \cdot\right\vert
\cdot\right)  $ is nonsingular $\operatorname*{Iff}$ $\sigma_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  j}>0,\quad1\leq j\leq r$.

\begin{corollary}%
\begin{equation}
\mathcal{R}_{e}\left(  e_{j}\right)  =\mathbf{e}_{j}=\sigma_{ej}^{\frac{1}{2}%
}\mathbf{u}_{ej}\text{ and }e_{j}=\sigma_{ej}^{\frac{1}{2}}u_{ej}%
\end{equation}
where
\end{corollary}

\begin{enumerate}
\item
\begin{equation}
\mathbb{U}_{\mathbf{e}}\mathbb{U}_{\mathbf{e}}^{\dagger}=\mathbb{I}%
_{r}=\mathbb{U}_{\mathbf{e}}^{\dagger}\mathbb{U}_{\mathbf{e}}.
\end{equation}


\item
\begin{equation}
\mathbf{\Sigma}_{\mathbf{e}}=\left(
\begin{array}
[c]{cccc}%
\sigma_{e1} & 0 & \cdots & 0\\
0 & \ddots & \vdots & \vdots\\
\vdots & \vdots & \ddots & 0\\
0 & \cdots & 0 & \sigma_{er}%
\end{array}
\right)  ,\quad\sigma_{e1}\geq\cdots\geq\sigma_{er}>0,\quad1\leq j\leq r.
\end{equation}


\item
\begin{equation}
\mathbf{u}_{ej}=\left(
\begin{array}
[c]{c}%
u_{ej1}\\
\vdots\\
u_{ejr}%
\end{array}
\right)  \in\mathbb{C}^{r},\quad1\leq j\leq r.
\end{equation}


\item Let
\begin{equation}
\mathbb{Q}_{e}=\mathbf{\Sigma}_{\mathbf{e}}^{\frac{1}{2}}\mathbb{U}%
_{\mathbf{e}}%
\end{equation}
then
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\left(  \left.
\mathcal{R}_{e}\left(  \mathbf{e}\right)  \right\vert \mathcal{R}_{e}\left(
\mathbf{e}\right)  \right)  =\mathbb{Q}_{e}^{t}\mathbb{Q}_{e}.
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \overset{}{\left(  \mathbf{e}\right)  }\right)
=\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  e_{1}\right)  & \cdots & \mathcal{R}_{e}\left(
e_{r}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathbf{e}_{1} & \cdots & \mathbf{e}_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
e_{11}\\
\vdots\\
e_{1r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
e_{r1}\\
\vdots\\
e_{rr}%
\end{array}
\right)
\end{array}
\right)  =\mathbb{Q}_{e}.
\end{equation}


\item As%
\begin{equation}
\mathbb{Q}_{e}^{-t}\left(  \mathbb{Q}_{e}^{t}\mathbb{Q}_{e}\right)
\mathbb{Q}_{e}^{-1}=\mathbb{I}_{r}%
\end{equation}
one can define
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
\mathbf{f}_{1} & \cdots & \mathbf{f}_{2r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
f_{11}\\
\vdots\\
f_{1r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
f_{2r1}\\
\vdots\\
f_{rr}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathbf{q}_{1} & \cdots & \mathbf{q}_{r}%
\end{array}
\right)  =\mathbb{Q}_{e}^{-1}%
\end{equation}
giving
\begin{equation}
\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  =\left(  \left.
\mathcal{R}_{e}\left(  \mathbf{f}\right)  \right\vert \mathcal{R}_{e}\left(
\mathbf{f}\right)  \right)  =\mathbb{Q}_{e}^{-t}\left(  \mathbb{Q}_{e}%
^{t}\mathbb{Q}_{e}\right)  \mathbb{Q}_{e}^{-1}=\mathbb{I}_{r},
\end{equation}
hence $\mathbf{f}$ is a $\left(  \left.  {}\right\vert \right)  $-conb.

\item The \emph{Column Space} (also called the range or image) of a matrix
$\mathbb{A}$ is the span (set of all possible linear combinations) of its
column vectors. The column space of a matrix is the \emph{image }%
$\emph{\equiv}$\emph{ range} of the corresponding matrix transformation. The
\emph{Row Space} of a matrix $\mathbb{A}$ is the span of its row vectors:

\begin{enumerate}
\item The $\operatorname*{Rank}$ of a matrix $\mathbb{A}$ is defined by
\begin{equation}
\operatorname*{Rank}(\mathbb{A})=\dim(\operatorname*{Rowsp}(\mathbb{A}%
))=\dim(\operatorname*{Colsp}(\mathbb{A})).
\end{equation}


\item $\operatorname*{Rank}(\mathbb{A})$ $=$ the maximum number of linearly
independent rows or columns of $\mathbb{A}.$
\end{enumerate}
\end{enumerate}
\end{lemma}

\begin{corollary}
If the proper values of $\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  $ are all unity then
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\mathbb{U}%
_{\mathbf{e}}^{t}\mathbb{U}_{\mathbf{e}}.
\end{equation}

\end{corollary}

\begin{corollary}
Let $r=2s$ then if $\left(  \mathbf{e}\right)  $ is $\left(  \left.
{}\right\vert \right)  $-orthonormal then $\mathbb{U}_{\mathbf{e}}\in O\left(
2s,\mathbb{C}\right)  .$
\end{corollary}

\begin{corollary}
Let $r=2s$ then if $\left(  \mathbf{e}\right)  $ is $\left(  \left.
{}\right\vert \right)  $-orthonormal \emph{and} $\left\langle \left.
{}\right\vert \right\rangle $-orthonormal then $\mathbb{U}_{\mathbf{e}}\in
O\left(  2s,\mathbb{C}\right)  \cap U\left(  2s\right)  =O\left(
2s,\mathbb{R}\right)  .$
\end{corollary}

\begin{lemma}
Let $r=2s$ then then $\mathbb{A\in}\mathcal{M}\left(  2s,2s,\mathbb{C}\right)
$ then if $\operatorname*{Rank}(\mathbb{A})=2s$ then $\mathbb{A}$ is non
singular i.e. $\operatorname{Ker}\left(  \mathbb{A}\right)  =\phi$ and in
finite dimensions $\mathbb{A}^{-1}$ exists.
\end{lemma}

\begin{corollary}
Let $\mathbb{Q}_{e}$ be defined as in the preceding then

\begin{enumerate}
\item $\mathbb{Q}_{e}^{-1}$ and $\mathbb{Q}_{e}^{-t}$ exist and are well defined.

\item $\left(  \mathbb{Q}_{e}^{t}\mathbb{Q}_{e}\right)  ^{-1}=$ $\mathbb{Q}%
_{e}^{-1}\mathbb{Q}_{e}^{-t}$ $=\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}$ exists and is well defined.
\end{enumerate}
\end{corollary}

\begin{corollary}%
\begin{equation}
\mathbf{\Sigma}_{\mathbf{e}}^{-\frac{1}{2}}\overline{\mathbb{U}_{\mathbf{e}}%
}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathbb{U}%
_{\mathbf{e}}\mathbf{\Sigma}_{\mathbf{e}}^{-\frac{1}{2}}=\mathbb{I}_{r},
\end{equation}
where
\begin{equation}
\left(  \mathbb{U}_{\mathbf{e}}\mathbf{\Sigma}_{\mathbf{e}}^{-\frac{1}{2}%
}\right)  ^{-1}=\,\,\mathbf{\Sigma}_{\mathbf{e}}^{\frac{1}{2}}\mathbb{U}%
_{\mathbf{e}}^{-1}=\mathbf{\Sigma}_{\mathbf{e}}^{\frac{1}{2}}\mathbb{U}%
_{\mathbf{e}}^{\dagger}=\,\,\mathbf{\Sigma}_{\mathbf{e}}^{\frac{1}{2}%
}\overline{\mathbb{U}}_{\mathbf{e}}^{t}=\left(  \overline{\mathbb{U}%
}_{\mathbf{e}}\mathbf{\Sigma}_{\mathbf{e}}^{\frac{1}{2}}\right)  ^{t}.
\end{equation}

\end{corollary}

\begin{remark}
Recall%
\begin{equation}
\left(  \left.  u\right\vert u\right)  =\left(  \left.  \mathcal{R}_{e}\left(
u\right)  \right\vert \mathcal{R}_{e}\left(  u\right)  \right)  =\sum_{1\leq
j,k\leq2r}\mathcal{R}_{e}\left(  u\right)  _{j}\left(  \left.  e_{j}%
\right\vert e_{k}\right)  \mathcal{R}_{e}\left(  u\right)  _{k}=\mathcal{R}%
_{e}\left(  u\right)  ^{t}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  \mathcal{R}_{e}\left(  u\right)  \in\mathbb{C}.
\end{equation}

\end{remark}

\begin{example}
$r=1$%
\[
\left(  \left.  \overset{}{\mathcal{R}_{e}\left(  u\right)  }\right\vert
\mathcal{R}_{e}\left(  u\right)  \right)  =\left(  \left.  \left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
1 & i
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
1 & i
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)  =0,
\]
hence $\left(  \left.  {}\right\vert \right)  $ is \emph{isotropic} and
$\left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)  $ is an isotropic vector.
\end{example}

\begin{remark}
$\left(  \left.  {}\right\vert \right)  $ is \emph{isotropic \textbf{but}
nondegenerate. }
\end{remark}

\begin{remark}
The $1\times r$ matrix $\left(  \left.  \mathbf{e}\right\vert v\right)  $ of
the vector $v$ is related to the matrix $\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  $ by
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert v\right)  =\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)
=\sum_{1\leq j\leq r}\mathbf{u}_{ej}\sigma_{ej}\mathbf{u}_{ej}^{t}%
\mathcal{R}_{e}\left(  v\right)  ,
\end{equation}
i.e.
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\sum_{1\leq j\leq
r}\mathbf{u}_{ej}\sigma_{ej}\mathbf{u}_{ej}^{t}.
\end{equation}

\end{remark}

\begin{remark}
The inverse of the \emph{operator} representation $\mathcal{R}_{e}$
\begin{equation}
\mathcal{R}_{e}^{-1}\left(  \mathbf{u}_{ej}\right)  =u_{ej},\,1\leq j\leq r.
\end{equation}

\end{remark}

\begin{remark}
The inverse of the \emph{vector} representation $\mathcal{R}_{e}$%
\begin{equation}
\mathcal{R}_{e}^{-1}\left(  \mathbf{v}\right)  =v=\sum_{1\leq j\leq r}%
u_{ej}\mathcal{R}_{e}\left(  v\right)  _{j}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\langle \left.  u_{ej}\right\vert u_{ek}\right\rangle _{\mathcal{H}^{1}%
}=\left\langle \left.  \mathbf{u}_{ej}\right\vert \mathbf{u}_{ek}\right\rangle
_{\mathbb{C}^{2r}}=\delta_{jk},\,1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert v\right)  =\left(  \overset{}{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}}\right)  \left\langle
\left.  \mathbf{e}\right\vert v\right\rangle .
\end{equation}

\end{lemma}

\begin{lemma}
If $\left(  \mathbf{e}\right)  $ is a basis for $\mathcal{H}^{1}$ then the
matrix $\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ is non singular.
\end{lemma}

\subparagraph{Inverses of metric matrices.}

Hilbert space metric matrices are hermitian thus can be expressed as
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\mathbb{U}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
_{d}\mathbb{U}^{\dagger},
\end{equation}
where $\mathbb{U\in}U\left(  r\right)  $ and $\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle _{d}$ is a diagonal matrix
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
_{djj}=\varepsilon_{j}\in\mathbb{R},\,1\leq j\leq r.
\end{equation}
One can thus expand $\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle $ as
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\sum\limits_{1\leq j\leq r}\left\vert \mathbf{u}_{j}\right\rangle
\varepsilon_{j}\left\langle \mathbf{u}_{j}\right\vert =\sum\limits_{1\leq
j\leq r}\mathbf{u}_{j}\otimes\mathbf{u}_{j}^{\dagger}\varepsilon_{j},
\end{equation}
where the columns of $\mathbb{U}$ is made up of the orthonormal eigenvectors
$\left\{  \left.  \mathbf{u}_{j}\right\vert \,1\leq j\leq r\right\}  $ of
$\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle $ i.e.

\begin{enumerate}
\item
\begin{align}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
\mathbf{u}_{j}  &  =\varepsilon_{j}\mathbf{u}_{j},\,1\leq j\leq r\\
\left\langle \left.  \mathbf{u}_{j}\right\vert \mathbf{u}_{k}\right\rangle  &
=\delta_{jk},\,1\leq j,k\leq r
\end{align}


\item
\begin{equation}
\mathbb{U}=\left(
\begin{array}
[c]{ccc}%
\mathbf{u}_{1} & \cdots & \mathbf{u}_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
u_{11}\\
\vdots\\
u_{r1}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
u_{1r}\\
\vdots\\
u_{rr}%
\end{array}
\right)
\end{array}
\right)
\end{equation}


\item
\begin{equation}
\left\vert \mathbf{u}_{j}\right\rangle \left\langle \mathbf{u}_{k}\right\vert
=\mathbf{u}_{j}\otimes\mathbf{u}_{k}^{\dagger}=\left(
\begin{array}
[c]{c}%
u_{1\ j}\\
\vdots\\
u_{rj}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{ccc}%
\overline{u_{1k}} & \cdots & \overline{u_{rk}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
u_{1j}\left(
\begin{array}
[c]{ccc}%
\overline{u_{1k}} & \cdots & \overline{u_{rk}}%
\end{array}
\right) \\
\vdots\\
u_{rj}\left(
\begin{array}
[c]{ccc}%
\overline{u_{1k}} & \cdots & \overline{u_{rk}}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
u_{1j}\overline{u_{1k}} & \cdots & u_{1j}\overline{u_{rk}}\\
\vdots & \ddots & \vdots\\
u_{rj}\overline{u_{1k}} & \cdots & u_{r1}\overline{u_{rk}}%
\end{array}
\right)
\end{equation}
$.$
\end{enumerate}

The metric matrix $\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle $ also has the spectral expansion
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\sum\limits_{1\leq j\leq r}\varepsilon_{j}\mathbb{P}_{j},
\end{equation}
where the orthogonal projectors $\mathbb{P}_{j}\in\mathcal{M}\left(
r,r,\mathbb{C}\right)  $ and
\begin{gather}
\sum\limits_{1\leq j\leq r}\mathbb{P}_{j}=\mathbb{I}_{r}\\
\mathbb{P}_{j_{1}}\mathbb{P}_{j_{2}}=\mathbb{P}_{j_{1}}\delta_{j_{1}j_{2}%
},\,\\
1\leq j\leq r.
\end{gather}
The projections $\mathbb{P}_{j},1\leq j\leq r$ can be expressed in terms of
the unitary transformation $\mathbb{U}$ as
\begin{equation}
\mathbb{P}_{j}=\left\vert \mathbf{u}_{j}\right\rangle \left\langle
\mathbf{u}_{j}\right\vert =\mathbf{u}_{j}\otimes\mathbf{u}_{j}^{\dagger
}=\left(
\begin{array}
[c]{c}%
u_{1\ j}\\
\vdots\\
u_{rj}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{ccc}%
\overline{u_{1j}} & \cdots & \overline{u_{rj}}%
\end{array}
\right)  ,1\leq j\leq r
\end{equation}


\begin{remark}
The unitary matrices $\mathbb{U}$ are unique $\operatorname*{Iff}$ the
spectrum $\sigma\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle \right)  $ is non degenerate.
\end{remark}

\begin{enumerate}
\item The inverse of the metric matrix $\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle $ is given by
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}=\mathbb{U}\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle _{d}\right)  ^{-1}\mathbb{U}^{\dagger}=\sum
\limits_{1\leq j\leq r}\varepsilon_{j}^{-1}\mathbb{P}_{j}%
\end{equation}


\item The square root of the metric matrix $\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle $ is given by
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac
{1}{2}}=\mathbb{U}\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle _{d}\right)  ^{\frac{1}{2}}\mathbb{U}^{\dagger}%
=\sum\limits_{1\leq j\leq r}\varepsilon_{j}^{\frac{1}{2}}\mathbb{P}_{j}%
\end{equation}
and is unique as $\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle $ is positive definite.

\item The inverse square root of the metric matrix $\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle $ is given by
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}=\mathbb{U}\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle _{d}\right)  ^{-\frac{1}{2}}\mathbb{U}^{\dagger}%
=\sum\limits_{1\leq j\leq r}\varepsilon_{j}^{-\frac{1}{2}}\mathbb{P}_{j}%
\end{equation}
and is unique as $\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle $ is positive definite.
\end{enumerate}

\subparagraph{Symmetric Orthonormalization
\label{Symmetric Orthonormalization}}

The transformations $T_{fe},T_{ef}\in GL\left(  \mathcal{H}^{1}\right)  $
between any two given bases $\left(  \mathbf{e}\right)  $ and $\left(
\mathbf{f}\right)  $ is given by
\begin{align}
T_{fe}  &  :\left\vert \mathbf{e}\right\rangle \rightarrow\left\vert
\mathbf{f}\right\rangle \\
\left\vert \mathbf{f}\right\rangle  &  =T_{fe}\left\vert \mathbf{e}%
\right\rangle \\
T_{fe}  &  =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert
\end{align}
and the inverse%
\begin{align}
T_{ef}  &  :\left\vert \mathbf{f}\right\rangle \rightarrow\left\vert
\mathbf{e}\right\rangle \\
\left\vert \mathbf{e}\right\rangle  &  =T_{ef}\left\vert \mathbf{f}%
\right\rangle \\
T_{ef}  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert .
\end{align}
By definition
\begin{equation}
T_{fe}=T_{ef}^{-1}%
\end{equation}
and
\begin{equation}
T_{ef}=T_{fe}^{-1},
\end{equation}
which is confirmed by
\begin{equation}
T_{ef}T_{fe}=\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =I_{\mathcal{H}^{1}}%
\end{equation}
and
\begin{equation}
T_{fe}T_{ef}=\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =I_{\mathcal{H}^{1}}.
\end{equation}


\begin{remark}
Orthonormalizing a given basis is not unique, as all basis are $U\left(
r\right)  $-equivalent.
\end{remark}

The symmetric transformation between a basis $\left(  \mathbf{e}\right)  $ and
an orthonormalized basis $\left\vert \widetilde{\mathbf{e}}\right\rangle $
(Symmetric Orthonormalization) is given by
\begin{align}
T_{\widetilde{e}e}  &  :\left\vert \mathbf{e}\right\rangle \rightarrow
\left\vert \widetilde{\mathbf{e}}\right\rangle =\left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-\frac{1}{2}}\\
\left\vert \widetilde{\mathbf{e}}\right\rangle  &  =T_{\widetilde{e}%
e}\left\vert \mathbf{e}\right\rangle \\
T_{\widetilde{e}e}  &  =\left\vert \widetilde{\mathbf{e}}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{3}{2}}\left\langle \mathbf{e}\right\vert ,
\end{align}
which is confirmed by%
\begin{equation}
\left\langle \widetilde{\mathbf{e}}\right\vert \left\vert
\widetilde{\mathbf{e}}\right\rangle =\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-\frac{1}{2}}\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac{1}{2}}=I_{\mathcal{H}%
^{1}}.
\end{equation}


\begin{remark}
$\left\vert \widetilde{\mathbf{e}}\right\rangle $ is unique if $\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac{1}{2}}$ is unique.
\end{remark}

One can also consider the transformations between the orthonormalized basis
$\left(  \widetilde{\mathbf{e}}\right)  $ and $\left(  \widetilde{\mathbf{f}%
}\right)  $ which is given by
\begin{align}
T_{\widetilde{f}\widetilde{e}}  &  :\left\vert \widetilde{\mathbf{e}%
}\right\rangle \rightarrow\left\vert \widetilde{\mathbf{f}}\right\rangle \\
T_{\widetilde{f}\widetilde{e}}  &  =\left\vert \widetilde{\mathbf{f}%
}\right\rangle \left\langle \widetilde{\mathbf{e}}\right\vert
\end{align}
and%
\begin{align}
T_{\widetilde{e}\widetilde{f}}  &  :\left\vert \widetilde{\mathbf{f}%
}\right\rangle \rightarrow\left\vert \widetilde{\mathbf{e}}\right\rangle \\
T_{\widetilde{e}\widetilde{f}}  &  =\left\vert \widetilde{\mathbf{e}%
}\right\rangle \left\langle \widetilde{\mathbf{f}}\right\vert .
\end{align}


The SVD of the bases transformations

\begin{enumerate}
\item $T_{fe}$ $\in GL\left(  \mathcal{H}^{1}\right)  $ gives
\begin{equation}
T_{fe}=U_{T_{fe}}\Sigma_{d}\left(  T_{fe}\right)  W_{T_{fe}},\quad U_{T_{fe}%
},W_{T_{fe}}\in U\left(  \mathcal{H}^{1}\right)  .
\end{equation}


\item $T_{fe}^{-1}\in GL\left(  \mathcal{H}^{1}\right)  $ gives
\begin{equation}
T_{fe}^{-1}=W_{T_{fe}}^{\dagger}\Sigma_{d}\left(  T_{fe}\right)
^{-1}U_{T_{fe}}^{\dagger}.
\end{equation}


\item $T_{\widetilde{f}\widetilde{e}}\in GL\left(  \mathcal{H}^{1}\right)  $
gives
\begin{equation}
T_{\widetilde{f}\widetilde{e}}=U_{T_{\widetilde{f}\widetilde{e}}}\Sigma
_{d}\left(  T_{\widetilde{f}\widetilde{e}}\right)  W_{T_{\widetilde{f}%
\widetilde{e}}},\quad U_{T_{\widetilde{f}\widetilde{e}}},W_{T_{\widetilde{f}%
\widetilde{e}}}\in U\left(  \mathcal{H}^{1}\right)  .
\end{equation}


\item $T_{\widetilde{f}\widetilde{e}}^{-1}\in GL\left(  \mathcal{H}%
^{1}\right)  $ gives
\begin{equation}
T_{\widetilde{f}\widetilde{e}}^{-1}=W_{T_{fe}}^{\dagger}\Sigma_{d}\left(
T_{\widetilde{f}\widetilde{e}}\right)  ^{-1}\widetilde{T_{fe}}U_{T_{fe}%
}^{\dagger}.
\end{equation}

\end{enumerate}

\begin{remark}%
\begin{equation}
T_{\widetilde{f}\widetilde{e}}=\left\vert \widetilde{\mathbf{f}}\right\rangle
\Sigma_{d}\left(  T_{\widetilde{f}\widetilde{e}}\right)  \left\langle
\widetilde{\mathbf{e}}\right\vert =\sum_{1\leq j\leq r}\left\vert
\widetilde{f_{j}}\right\rangle \sigma_{j}\left(  T_{\widetilde{f}%
\widetilde{e}}\right)  \left\langle \widetilde{e_{j}}\right\vert .
\end{equation}

\end{remark}

The connection between the representation matrix $\mathcal{R}_{e}\left(
T_{fe}\right)  ,$ the matrix $\mathcal{M}_{e}\left(  T_{fe}\right)  $ and the
operator expansions $T_{fe}$ of can be expressed using the product of the
resolution of the identities
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert ,
\end{equation}
giving

\begin{enumerate}
\item
\begin{align}
T_{fe}  &  =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert T_{fe}\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \equiv\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(
T_{fe}\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \\
&  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\end{align}


\item
\begin{align}
T_{fe}  &  =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert T_{fe}\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert \equiv\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\mathcal{M}_{f}\left(
T_{fe}\right)  \left\langle \left.  \mathbf{f}\right\vert \mathbf{f}%
\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert \\
&  =\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}%
\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert
\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert =\left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert
\end{align}


\item
\begin{align}
T_{ef}  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert T_{ef}\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert \equiv\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\mathcal{M}_{f}\left(
T_{ef}\right)  \left\langle \left.  \mathbf{f}\right\vert \mathbf{f}%
\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert \\
&  =\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}%
\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert
\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert =\left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert
\end{align}


\item
\begin{align}
T_{ef}  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert T_{ef}\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \equiv\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(
T_{ef}\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \\
&  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert .
\end{align}
The connection between the representation matrix $\mathcal{R}_{e}\left(
T_{fe}\right)  $%
\begin{equation}
T_{fe}\left\vert \mathbf{e}\right\rangle =\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  T_{fe}\right)
\end{equation}
and the matrix $\mathcal{M}_{e}\left(  T_{fe}\right)  $ of $T_{fe}$ is given
by
\begin{equation}
\left(  \overset{}{\left\langle \mathbf{e}\right\vert T_{fe}\left\vert
\mathbf{e}\right\rangle =\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  T_{fe}\right)  }\right)
\equiv\left(  \overset{}{\mathcal{M}_{e}\left(  T_{fe}\right)  =\left\langle
\mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  T_{fe}\right)  }\right)  \Longleftrightarrow\left(
\overset{}{\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}%
\right\rangle ^{-1}\mathcal{M}_{e}\left(  T_{fe}\right)  =\mathcal{R}%
_{e}\left(  T_{fe}\right)  }\right)  .
\end{equation}

\end{enumerate}

\begin{remark}
$T_{fe}$ can be expressed wrt the bases $\left(  \mathbf{e}\right)  $ and
$\left(  \mathbf{f}\right)  $ as
\begin{equation}
T_{fe}=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
T_{fe}\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\end{equation}
and%
\begin{equation}
T_{fe}=\left\vert \mathbf{f}\right\rangle \mathcal{R}_{f}\left(
T_{fe}\right)  \left\langle \left.  \mathbf{f}\right\vert \mathbf{f}%
\right\rangle ^{-1}\left\langle \mathbf{f}\right\vert .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{M}_{e}\left(  T_{fe}\right)  =\left\langle \mathbf{e}\right\vert
T_{fe}\left\vert \mathbf{e}\right\rangle =\left\langle \mathbf{e}\right\vert
\left\vert \mathbf{f}\right\rangle ,
\end{equation}
hence
\begin{equation}
T_{fe}=\left\vert \mathbf{e}\right\rangle \left(  \overset{}{\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\left.  \mathbf{e}\right\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}}\right)  \left\langle
\mathbf{e}\right\vert .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\vert \mathbf{f}\right\rangle =T_{fe}\left\vert \mathbf{e}\right\rangle
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  T_{fe}\right)
=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  T_{fe}\right)  =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle
\end{equation}
hence
\begin{equation}
\mathcal{R}_{e}\left(  T_{fe}\right)  =\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{f}\right\rangle .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
T_{fe}=\left\vert \mathbf{e}\right\rangle \left(  \overset{}{\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert T_{fe}\left\vert \mathbf{e}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}}\right)
\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle \left(
\overset{}{\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\mathcal{M}_{e}\left(  T_{fe}\right)  \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}}\right)  \left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right\rangle \left(  \overset{}{\mathcal{R}%
_{e}\left(  T_{fe}\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}}\right)  \left\langle \mathbf{e}\right\vert .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{M}_{e}\left(  T_{fe}\right)  =\left\langle \mathbf{e}\right\vert
T_{fe}\left\vert \mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{f}\right\rangle ,
\end{equation}
hence one confirms%
\begin{equation}
T_{fe}=\left\vert \mathbf{e}\right\rangle \left(  \overset{}{\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\left.  \mathbf{e}\right\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}}\right)  \left\langle
\mathbf{e}\right\vert .
\end{equation}

\end{remark}

\begin{remark}
$\lceil$recall

\begin{enumerate}
\item
\begin{equation}
T_{fe}\left\vert \mathbf{e}\right\rangle =\left\vert \mathbf{f}\right\rangle
\end{equation}


\item
\begin{equation}
T_{fe}=\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\end{equation}


\item
\begin{equation}
T_{ef}T_{fe}\left\vert \mathbf{e}\right\rangle =T_{ef}\left\vert
\mathbf{f}\right\rangle =\left\vert \mathbf{e}\right\rangle
\end{equation}


\item
\begin{equation}
T_{fe}T_{ef}\left\vert \mathbf{f}\right\rangle =T_{fe}\left\vert
\mathbf{e}\right\rangle =\left\vert \mathbf{f}\right\rangle
\end{equation}


\item
\begin{equation}
T_{ef}T_{fe}=\left\vert \mathbf{f}\right\rangle R_{f}\left(  T_{ef}\right)
\left\langle \left.  \mathbf{f}\right\vert \mathbf{e}\right\rangle
R_{e}\left(  T_{fe}\right)  \left\langle \mathbf{e}\right\vert =I_{\mathcal{H}%
^{1}}%
\end{equation}


\item
\begin{equation}
T_{ef}=T_{fe}^{-1}%
\end{equation}
$\rfloor$
\end{enumerate}
\end{remark}

\begin{enumerate}
\item One can normalize the positive definite metric matrix
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\dagger}%
\end{equation}
$\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle $ by
\emph{symmetric orthonormalization}
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-\frac
{1}{2}}=\mathbb{I}_{r}%
\end{equation}
leading to $\left\langle \left.  {}\right\vert \right\rangle $-orthonormal vectors

\item The metric operator $\Delta_{e}$ is defined by
\begin{equation}
\Delta_{e}\left\vert \widetilde{\mathbf{e}}\right\rangle =\left\vert
\widetilde{\mathbf{e}}\right\rangle \mathcal{R}_{\widetilde{e}}\left(
\Delta_{e}\right)  =\left\vert \widetilde{\mathbf{e}}\right\rangle
\mathbf{\Delta}_{e}=\left\vert \widetilde{\mathbf{e}}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
\end{equation}
giving%
\begin{equation}
\left\langle \widetilde{\mathbf{e}}\right\vert \Delta_{e}\left\vert
\widetilde{\mathbf{e}}\right\rangle =\mathbf{\Delta}_{e}=\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle =\mathcal{R}_{\widetilde{e}%
}\left(  \Delta_{e}\right)
\end{equation}
so that%
\begin{equation}
\Delta_{e}^{\frac{1}{2}}\left\vert \widetilde{\mathbf{e}}\right\rangle
=\left\vert \widetilde{\mathbf{e}}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac{1}{2}}=\left\vert
\mathbf{e}\right\rangle .
\end{equation}


\item This gives%
\begin{equation}
\left\vert \widetilde{\mathbf{e}}\right\rangle =\left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-\frac{1}{2}}=\Delta_{e}^{-\frac{1}{2}}\left\vert
\mathbf{e}\right\rangle
\end{equation}
and
\begin{equation}
\left\langle \left.  \widetilde{\mathbf{e}}\right\vert \widetilde{\mathbf{e}%
}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert \Delta_{e}%
^{-1}\mathbf{e}\right\rangle =\mathbb{I}_{r}%
\end{equation}
i.e. $\left(  \mathbf{e}\right)  $ are the \emph{conjugate directions} of
$\Delta_{e}^{-1}$ and $\mathcal{R}_{\widetilde{e}}\left(  \Delta_{e}\right)
^{-1}=\mathcal{R}_{\widetilde{e}}\left(  \Delta_{e}^{-1}\right)
=\mathbf{\Delta}_{e}^{-1}=\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}.$

\begin{remark}
The conjugate directions are unique if the spectrum of the inverse $\Delta
_{e}^{-1}$ of the metric matrix $\Delta_{e}$ is non degenerate otherwise
unitay transformations of the degenerate directions are still conjugate directions.
\end{remark}

\item The transformation between the orthonormal bases $\left(
\widetilde{\mathbf{f}}\right)  $ and $\left(  \widetilde{\mathbf{e}}\right)  $ are

\begin{enumerate}
\item
\begin{gather}
T_{\widetilde{f}\widetilde{e}}=\left\vert \widetilde{\mathbf{f}}\right\rangle
\left\langle \widetilde{\mathbf{e}}\right\vert =\sum_{1\leq j\leq n}\left\vert
\widetilde{f_{j}}\right\rangle \left\langle \widetilde{e_{j}}\right\vert
=\sum_{1\leq j\leq n}\left\vert \Delta_{f}^{-\frac{1}{2}}f_{j}\right\rangle
\left\langle \Delta_{e}^{-\frac{1}{2}}e_{j}\right\vert =\sum_{1\leq j\leq
n}\left\vert f_{j}\right\rangle \mathcal{R}_{f}\left(  \Delta_{f}^{-\frac
{1}{2}}\right)  \mathcal{R}_{e}\left(  \Delta_{e}^{-\frac{1}{2}}\right)
\left\langle e_{j}\right\vert \\
=\left\vert \mathbf{f}\right\rangle \mathcal{R}_{f}\left(  \Delta_{f}%
^{-\frac{1}{2}}\right)  \left(  \mathcal{R}_{e}\left(  \Delta_{e}^{-\frac
{1}{2}}\right)  \right)  \left\langle \mathbf{e}\right\vert =\left\vert
\mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{f}\right\rangle ^{-\frac{1}{2}}\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-\frac{1}{2}}\left\langle \mathbf{e}%
\right\vert
\end{gather}


\item
\begin{equation}
\left\vert \widetilde{\mathbf{f}}\right\rangle \left\langle
\widetilde{\mathbf{e}}\right\vert =\left\vert \mathbf{f}\right\rangle
\left\langle \left.  \mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-\frac
{1}{2}}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-\frac{1}{2}}\left\langle \mathbf{e}\right\vert =\Delta_{f}^{-\frac{1}{2}%
}\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert
\Delta_{e}^{-\frac{1}{2}}%
\end{equation}


\item
\begin{equation}
\Delta_{f}^{\frac{1}{2}}\left\vert \widetilde{\mathbf{f}}\right\rangle
\left\langle \widetilde{\mathbf{e}}\right\vert \Delta_{e}^{\frac{1}{2}%
}=\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert ,
\end{equation}
which is shown by
\end{enumerate}

\item
\begin{align}
\left\langle \left.  \widetilde{\mathbf{f}}\right\vert \widetilde{\mathbf{f}%
}\right\rangle  &  =\left\langle \left.  \Delta_{f}^{-\frac{1}{2}}%
\mathbf{f}\right\vert \Delta_{f}^{-\frac{1}{2}}\mathbf{f}\right\rangle
=\left(  \mathcal{R}_{f}\left(  \Delta_{f}^{-\frac{1}{2}}\right)  \right)
^{\dagger}\left\langle \left.  \mathbf{f}\right\vert \mathbf{f}\right\rangle
\mathcal{R}_{f}\left(  \Delta_{f}^{-\frac{1}{2}}\right)  =\mathbb{I}_{r}.\\
\left\langle \left.  \widetilde{\mathbf{e}}\right\vert \widetilde{\mathbf{e}%
}\right\rangle  &  =\left\langle \left.  \Delta_{e}^{-\frac{1}{2}%
}\widetilde{\mathbf{e}}\right\vert \Delta_{e}^{-\frac{1}{2}}%
\widetilde{\mathbf{e}}\right\rangle =\left(  \mathcal{R}_{e}\left(  \Delta
_{e}^{-\frac{1}{2}}\right)  \right)  ^{\dagger}\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
\Delta_{e}^{-\frac{1}{2}}\right)  =\mathbb{I}_{r}.
\end{align}


\item In particular
\begin{equation}
\left\vert \widetilde{e_{j}}\right\rangle \left\langle \left.  e_{j}%
\right\vert e_{j}\right\rangle ^{\frac{1}{2}}=\left\vert e_{j}\right\rangle
,\,1\leq j\leq r
\end{equation}


\item Transformations $T_{fe}$ and $T_{fe}^{-1}$
\begin{equation}
T_{fe}:\left(  \mathbf{e}\right)  \rightarrow\left(  \mathbf{f}\right)
\end{equation}
and
\begin{equation}
T_{fe}^{-1}:\left(  \mathbf{f}\right)  \rightarrow\left(  \mathbf{e}\right)
\end{equation}
can be expressed as
\begin{equation}
T_{fe}=\left\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
=\left\vert \mathbf{f}\right\rangle \mathbf{\Delta}_{e}^{-1}\left\langle
\mathbf{e}\right\vert
\end{equation}
and
\begin{equation}
T_{fe}^{-1}=\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =\left\vert \mathbf{e}\right\rangle \mathbf{\Delta}_{f}%
^{-1}\left\langle \mathbf{f}\right\vert ,
\end{equation}
which is confirmed by%
\begin{align}
T_{fe}T_{fe}^{-1}  &  =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =I_{\mathcal{H}^{1}}\\
T_{fe}^{-1}T_{fe}  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =I_{\mathcal{H}^{1}}.
\end{align}
This can be compared to the SVDs
\begin{align}
T_{fe}  &  =\left\vert \mathbf{f}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =\left\vert \widetilde{\mathbf{f}}\right\rangle \left\langle
\left.  \mathbf{f}\right\vert \mathbf{f}\right\rangle ^{\frac{1}{2}%
}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{\frac{1}{2}}\left\langle \widetilde{\mathbf{e}}\right\vert =\left\vert
\widetilde{\mathbf{f}}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{f}\right\rangle ^{\frac{1}{2}}\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-\frac{1}{2}}\left\langle
\widetilde{\mathbf{e}}\right\vert \\
&  =\sum_{1\leq j\leq r}\left\vert \widetilde{f_{j}}\right\rangle \left\langle
\left.  f_{j}\right\vert f_{j}\right\rangle ^{\frac{1}{2}}\left\langle \left.
e_{j}\right\vert e_{j}\right\rangle ^{-\frac{1}{2}}\left\langle
\widetilde{e_{j}}\right\vert =\sum_{1\leq j\leq r}\left\vert \widetilde{f_{j}%
}\right\rangle \sigma\left(  T_{fe}\right)  _{j}\left\langle \widetilde{e_{j}%
}\right\vert
\end{align}
and%
\begin{align}
T_{fe}^{-1}  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\left\langle \mathbf{f}%
\right\vert =\left\vert \widetilde{\mathbf{e}}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{\frac{1}{2}%
}\left\langle \left.  \mathbf{f}\right\vert \mathbf{f}\right\rangle
^{-1}\left\langle \left.  \mathbf{f}\right\vert \mathbf{f}\right\rangle
^{\frac{1}{2}}\left\langle \widetilde{\mathbf{f}}\right\vert =\left\vert
\widetilde{\mathbf{e}}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{\frac{1}{2}}\left\langle \left.  \mathbf{f}%
\right\vert \mathbf{f}\right\rangle ^{-\frac{1}{2}}\left\langle
\widetilde{\mathbf{f}}\right\vert \\
&  =\sum_{1\leq j\leq r}\left\vert \widetilde{e_{j}}\right\rangle \left\langle
\left.  e_{j}\right\vert e_{j}\right\rangle ^{\frac{1}{2}}\left\langle \left.
f_{j}\right\vert f_{j}\right\rangle ^{-\frac{1}{2}}\left\langle
\widetilde{f_{j}}\right\vert =\sum_{1\leq j\leq r}\left\vert \widetilde{f_{j}%
}\right\rangle \sigma\left(  T_{fe}^{-1}\right)  _{j}\left\langle
\widetilde{e_{j}}\right\vert .
\end{align}


\item The metric matrix $\left\langle \left.  \widetilde{\mathbf{e}%
}\right\vert \widetilde{\mathbf{e}}\right\rangle $, which is by construction
the unit matrix $\mathbb{I}_{r}$ can be expressed as the matrix of the metric
operator $\Delta_{e}^{-1}$
\begin{equation}
\left\langle \left.  \widetilde{\mathbf{e}}\right\vert \widetilde{\mathbf{e}%
}\right\rangle =\left\langle \left.  \overset{}{\mathbf{e}}\right\vert
\Delta_{e}^{-1}\mathbf{e}\right\rangle =\mathbb{I}_{2r},
\end{equation}
where
\begin{equation}
\Delta_{e}^{-\frac{1}{2}}=\left\vert \widetilde{\mathbf{e}}\right\rangle
\left\langle \mathbf{e}\right\vert .
\end{equation}


\item If one defines a new inner product $\left\langle \left.  {}\right\vert
\right\rangle _{\Delta_{e}^{-1}}$ in terms of the inner product $\left\langle
\left.  {}\right\vert \right\rangle $ by
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{\Delta_{e}^{-1}%
}=\left\langle \left.  \overset{}{v}\right\vert \Delta_{e}^{-1}w\right\rangle
\end{equation}
then the basis $\left(  \mathbf{e}\right)  $ is a conb wrt $\left\langle
\left.  {}\right\vert \right\rangle _{\Delta_{e}^{-1}}$ i.e.
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
_{\Delta_{e}^{-1}}=\mathbb{I}_{r}.
\end{equation}


\item One \underline{cannot} normalize the complex symmetric non singular
matrix
\[
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{t}%
\]
\emph{by symmetric orthonormalization}
\[
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-\frac{1}{2}%
}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-\frac{1}{2}}=\mathbb{I}_{r},
\]
as \emph{in general one cannot} \emph{uniquely} define the square root of a
complex symmetric matrix since in general it is not positive definite, however
one can orthonormalize by using the SVD\ 

\item
\begin{gather}
\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  }%
^{t}\left(  \mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  }^{t}\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }\mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }\right)  \mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }=\left(  \mathbf{\Sigma}_{\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  }^{-\frac{1}{2}}\overline{\mathbb{U}_{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  }}\right)  \left(
\mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  }%
^{t}\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}\mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}\right)  \left(  \mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{\dagger}\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  }^{-\frac{1}{2}}\right) \\
=\left(  \mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}^{\dagger}\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{-\frac{1}{2}}\right)  ^{t}\left(  \mathbb{U}_{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  }^{t}\mathbf{\Sigma}_{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  }\mathbb{U}_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  }\right)  \left(  \mathbb{U}_{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  }^{\dagger}\mathbf{\Sigma
}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  }^{-\frac{1}{2}%
}\right)  =\mathbb{I}_{r},
\end{gather}
i.e.
\begin{equation}
\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}=\mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}^{\dagger}\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{-\frac{1}{2}},
\end{equation}


\item leading to $\left(  \left.  {}\right\vert \right)  $-orthonormal vectors%
\begin{equation}
\left\vert \mathbf{f}\right)  =V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }\left\vert \mathbf{e}\right)  =\left\vert \mathbf{e}%
\right)  \mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}.
\end{equation}


\item In particular%
\begin{equation}
\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  =\left(  \left.
\overset{}{V_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}\mathbf{e}}\right\vert V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }\mathbf{e}\right)  =\mathbb{V}_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  }^{t}\left(  \left.
\overset{}{\mathbf{e}}\right\vert \mathbf{e}\right)  \mathbb{V}_{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  }=\mathbb{I}_{r}%
\end{equation}
and
\begin{equation}
\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  =\left(  \left.
\overset{}{\mathbf{e}}\right\vert V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{t}V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }\mathbf{e}\right)  .
\end{equation}


\item Product of resolutions of identity%
\begin{equation}
\left\vert \mathbf{f}\right)  \left(  \left.  \mathbf{f}\right\vert
\mathbf{f}\right)  ^{-1}\left(  \mathbf{f}\right\vert \left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert
\end{equation}


\item If one defines a new inner product $\left(  \left.  {}\right\vert
\right)  _{V_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  }%
^{t}V_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  }}$ in terms
of the inner product $\left(  \left.  {}\right\vert \right)  $ by
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{V_{\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  }^{t}V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }}=\left(  \left.  \overset{}{v}\right\vert V_{\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  }^{t}V_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  }w\right)
\end{equation}
then the basis $\left(  \mathbf{e}\right)  $ is a conb wrt $\left(  \left.
{}\right\vert \right)  _{V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{t}V_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }}$ i.e.
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  _{V_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  }^{t}V_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  }}=\mathbb{I}_{r}.
\end{equation}


\item The matrix $\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }$ is not unitary
\begin{gather}
\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}^{\dagger}=\mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  }^{\dagger}\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{-1}\mathbb{U}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }\\
\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
}^{\dagger}\mathbb{V}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  }=\mathbf{\Sigma}_{\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  }^{-\frac{1}{2}}\mathbb{U}_{\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  }\mathbb{U}_{\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  }^{\dagger}\mathbf{\Sigma}_{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  }^{-\frac{1}{2}}=\mathbf{\Sigma
}_{\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  }^{-1}.
\end{gather}

\end{enumerate}

\begin{notation}
Covariant array of basis vectors (which are contravariant vectors)
\begin{equation}
\left(  \longleftarrow\mathbf{e\rightarrow}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{2r}%
\end{array}
\right)  =\left\vert \mathbf{e}\right)  =\left\vert \mathbf{e}\right\rangle
\end{equation}
and Contravariant array of basis vectors (which are also contravariant
vectors)%
\begin{equation}
\left(
\begin{array}
[c]{c}%
\uparrow\\
\mathbf{e}\\
\downarrow
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{2r}%
\end{array}
\right)  =\left(  \mathbf{e}\right\vert =\left\langle \mathbf{e}\right\vert .
\end{equation}

\end{notation}

\begin{remark}
The Resolutions of identity

\begin{enumerate}
\item
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \equiv\left(  \longleftarrow\mathbf{e\rightarrow}\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert
\end{equation}
and

\item
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
\equiv\left(  \longleftarrow\mathbf{e\rightarrow}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert ,
\end{equation}
produce vector expansions

\item
\begin{equation}
v=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
v=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}%
\right\vert v\right\rangle \equiv\left(  \longleftarrow\mathbf{e\rightarrow
}\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \left.  \mathbf{e}\right\vert v\right\rangle =\left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  v\right)
\end{equation}
and

\item
\begin{equation}
v=\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert v=\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \left.  \mathbf{e}\right\vert v\right)  \equiv\left(
\longleftarrow\mathbf{e\rightarrow}\right)  \left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  ^{-1}\left(  \left.  \mathbf{e}\right\vert
v\right)  =\left\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{notation}%
\begin{equation}
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right)  =\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
\end{equation}
and
\begin{equation}
\left(  \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle =\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  .
\end{equation}

\end{notation}

are the same as
\begin{equation}
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right)  =\left\langle
\mathbf{e}\right\vert \left(
\begin{array}
[c]{c}%
\uparrow\\
\mathbf{e}\\
\downarrow
\end{array}
\right)
\end{equation}
and
\begin{equation}
\left(  \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle =\left(
\mathbf{e}\right\vert \left(
\begin{array}
[c]{c}%
\uparrow\\
\mathbf{e}\\
\downarrow
\end{array}
\right)  .
\end{equation}


\begin{remark}
The product of the resolution of identities generated by the inner products
are
\begin{equation}
\left(  \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert }\right)  \left(  \overset{}{\left\vert \mathbf{e}\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}%
\right\vert }\right)  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle \left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert =\left\vert
\overset{}{\mathbf{e}}\right\rangle \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \overset{}{\mathbf{e}}\right\vert
=I_{\mathcal{H}^{1}}%
\end{equation}
and
\begin{equation}
\left(  \overset{}{\left\vert \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
}\right)  \left(  \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert }\right)  =\left\vert \mathbf{e}\right\rangle \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert =\left\vert
\overset{}{\mathbf{e}}\right\rangle \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \overset{}{\mathbf{e}}\right\vert
=I_{\mathcal{H}^{1}}%
\end{equation}
as expected.
\end{remark}

\begin{remark}
The resolution of the identities are projectors
\begin{equation}
\left(  \left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\right)  \left(  \left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \right)  =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert
\end{equation}
and%
\begin{equation}
\left(  \left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert \right)  \left(
\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert \right)  =\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert
\end{equation}
as expected.
\end{remark}

\begin{remark}
The representation $\mathcal{R}_{e}$ is generated by these resolution of the
identities as
\begin{equation}
v=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}%
\right\vert v\right\rangle =\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  v\right)
\end{equation}
and%
\begin{equation}
v=\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \left.  \mathbf{e}\right\vert v\right)
=\left\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)
\end{equation}
gives
\begin{equation}
\mathcal{R}_{e}\left(  v\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
v\right\rangle =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \left.  \mathbf{e}\right\vert v\right)  .
\end{equation}

\end{remark}

\begin{lemma}
The representation $\mathcal{R}_{e}\left(  v\right)  $ of vectors
$v\in\mathcal{H}^{1}$ is given by
\begin{equation}
\mathcal{R}_{e}\left(  v\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
v\right\rangle =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \left.  \mathbf{e}\right\vert v\right)  .
\end{equation}

\end{lemma}

\begin{proof}
This follows from $\left(  \longleftarrow\mathbf{e\rightarrow}\right)  $ being
a complete basis and the resolution of the identities.
\end{proof}

\begin{remark}%
\begin{gather}
\left(  \longleftarrow\mathbf{e\rightarrow}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.
\mathbf{e}\right\vert v\right\rangle =\left(  \longleftarrow
\mathbf{e\rightarrow}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \left.  \mathbf{e}\right\vert v\right) \\
\Downarrow\\
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \left.  \mathbf{e}\right\vert v\right\rangle =\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \left.
\mathbf{e}\right\vert v\right) \\
\Downarrow\\
\left(  \left.  \mathbf{e}\right\vert v\right)  =\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}%
\right\vert v\right\rangle .
\end{gather}
Let
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\mathbb{I}_{r}%
\end{equation}
then
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert v\right)  =\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \left\langle \left.  \mathbf{e}%
\right\vert v\right\rangle =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)  .
\end{equation}

\end{remark}

\begin{remark}
This is consistent with
\begin{equation}
\left(  \left.  v\right\vert v\right)  =\mathcal{R}_{e}\left(  v\right)
^{t}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  v\right)  .
\end{equation}

\end{remark}

\begin{lemma}
The Hilbert space inner product $\left\langle \left.  {}\right\vert
\right\rangle $ is \emph{anisotropic \underline{\emph{and}} non degenerate
i.e. }%
\begin{equation}
\left\langle \left.  v\right\vert v\right\rangle =0\Leftrightarrow v=0.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{gather}
\left\langle \left.  v\right\vert v\right\rangle =\mathcal{R}_{e}\left(
v\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle \mathcal{R}_{e}\left(  v\right)  =0\Leftrightarrow
\mathcal{R}_{e}\left(  v\right)  =0\text{ as }\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle >0\text{ and }\ker\left(
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle \right)
=\phi\\
\mathcal{R}_{e}\left(  v\right)  =0\Rightarrow v=0\text{ as }\mathcal{R}%
_{e}\text{ is an isomorphism.}%
\end{gather}

\end{proof}

\begin{lemma}
The complex symmetric bilinear form $\left(  \left.  {}\right\vert \right)  $
is \emph{isotropic \underline{\emph{but non}} degenerate i.e.}
\begin{equation}
\left(  \left.  v\right\vert v\right)  =0\nRightarrow v=0,
\end{equation}
while
\begin{equation}
\left(  \left.  v\right\vert w\right)  =0,\,\forall w\in\mathcal{H}%
^{1}\Rightarrow v=0.
\end{equation}

\end{lemma}

\begin{proof}
Consider%
\begin{equation}
\left(  \left.  v\right\vert v\right)  =\left(
\begin{array}
[c]{cc}%
1 & i
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)  =1-1=0,
\end{equation}
so
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \ngeqq0,
\end{equation}
however
\begin{equation}
\ker\left\{  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
\right\}  =\phi
\end{equation}
so $\left(  \left.  {}\right\vert \right)  $ is non degenerate.
\end{proof}

\begin{definition}
The \emph{adjoint} " $\dagger"$ is defined by the cannonical inner product
$\left\langle \left.  {}\right\vert \right\rangle $ in $\mathcal{H}^{1}$ i.e.
the inner product that defines $\mathcal{H}^{1},$ by
\begin{equation}
\left\langle \left.  A^{\dagger}v\right\vert w\right\rangle =\left\langle
\left.  v\right\vert Aw\right\rangle \quad\forall w\in\mathcal{H}^{1}\text{
and }v\in\mathcal{H}^{1},
\end{equation}
which depends on the non degeneracy of $\left\langle \left.  {}\right\vert
\right\rangle .$
\end{definition}

\begin{notation}
$\left\langle \left.  {}\right\vert \right\rangle $ is the sesquilinear inner
product that defines a Hilbert space $\mathcal{H}^{1}$. Orthonormality is
defined wrt $\left\langle \left.  {}\right\vert \right\rangle $ and which
produces the set of conbs $\left\vert e\right\rangle =\left\{  \left.
\overset{}{\left\vert \mathbf{e}\right\rangle }\right\vert \left\langle
\mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle =\mathbb{I}%
_{n}\right\}  =\left\{  \left.  u\left\vert \mathbf{e}\right\rangle
\right\vert u\in U\left(  \mathcal{H}^{1}\right)  \right\}  ,$ where
$\left\vert \mathbf{e}\right\rangle =\left\vert e_{1},\cdots,e_{n}%
\right\rangle .$ In particular when $\mathcal{H}^{1}=\mathbb{C}^{n}$ one
chooses a canonical basis
\begin{equation}
\left\vert \mathbf{e}\right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
1\\
0\\
\vdots\\
0
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
1
\end{array}
\right)  \right\rangle .
\end{equation}

\end{notation}

\begin{notation}
The matrix adjoint $\mathbb{A}^{\dagger}$ of a matrix $\mathbb{A}%
\in\mathcal{M}\left(  n,n,\mathbb{C}\right)  $ is defined as
\begin{equation}
\left(  \mathbb{A}^{\dagger}\right)  _{jk}=\overline{\left(  \mathbb{A}%
\right)  _{kj}},\quad1\leq j,k\leq n.
\end{equation}

\end{notation}

\begin{lemma}
The definition of adjoint " $\dagger$" is $U\left(  \mathcal{H}^{1}\right)  $ invariant.
\end{lemma}

\begin{lemma}
The representation $\mathcal{R}_{e}\left(  A^{\dagger}\right)  $ of the
adjoint $A^{\dagger}$ is related to the matrix adjoint by%
\begin{equation}
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A^{\dagger}\right)  \left\langle \mathbf{e}\right\vert
\left\vert \mathbf{e}\right\rangle ^{-1}=\mathcal{R}_{e}\left(  A\right)
^{\dagger}.
\end{equation}

\end{lemma}

\begin{proof}
The representations wrt to a basis $\left(  \mathbf{e}\right)  $ can be
expressed as
\begin{align}
A\left(  \mathbf{e}\right)   &  \equiv A\left\vert \mathbf{e}\right\rangle
=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \equiv\left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A\right) \\
A^{\dagger}\left(  \mathbf{e}\right)   &  \equiv A^{\dagger}\left\vert
\mathbf{e}\right\rangle =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(
A^{\dagger}\right)  \equiv\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  A^{\dagger}\right)
\end{align}
the matrices wrt the inner product $\left(  \left.  {}\right\vert \right)  $
are
\begin{align}
\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A\right)   &
=\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A\right) \\
\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A^{\dagger}\right)
&  =\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A^{\dagger}\right)
\end{align}

\end{proof}

The matrices of an operator and its adjoint are related to the representation
matrices by
\begin{equation}
\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A^{\dagger}\right)
=\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A\right)  ^{\dagger
}=\mathcal{R}_{e}\left(  A\right)  ^{\dagger}\left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{e}\right\rangle
\end{equation}
giving
\begin{equation}
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\mathcal{R}_{e}\left(  A\right)
^{\dagger}\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}%
\right\rangle
\end{equation}
and hence%
\begin{gather}
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A^{\dagger}\right)  \left\langle \mathbf{e}\right\vert
\left\vert \mathbf{e}\right\rangle ^{-1}=\mathcal{R}_{e}\left(  A\right)
^{\dagger}\\
\Updownarrow\\
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left\langle \mathbf{e}\right\vert
\left\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(  A\right)
^{\dagger}\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}%
\right\rangle .
\end{gather}


\begin{corollary}%
\begin{equation}
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A^{\dagger}\right)  ^{\dagger}\left\langle
\mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle ^{-1}=\mathcal{R}%
_{e}\left(  A\right)  .
\end{equation}

\end{corollary}

\begin{corollary}
$\mathcal{R}_{e}$ is a star transformation i.e.
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\mathcal{R}_{e}\left(  A\right)
^{\dagger}%
\end{equation}
if $\left(  \mathbf{e}\right)  $ is a conb.
\end{corollary}

\begin{notation}
$\left(  \left.  {}\right\vert \right)  $ is the chosen canonical complex
symmetric inner product in a Hilbert space $\mathcal{H}^{1}$. \emph{C}omplex
symmetric \emph{o}rthonormality is defined wrt $\left(  \left.  {}\right\vert
\right)  $ and hence the set of conbs $\left\vert e\right)  =\left\{  \left.
\left\vert \mathbf{e}\right)  \right\vert \left(  \mathbf{e}\right\vert
\left\vert \mathbf{e}\right)  =\mathbb{I}_{r}\right\}  =\left\{  \left.
\overset{}{o\left\vert \mathbf{e}\right)  }\right\vert o\in O\left(
\mathcal{H}^{1}\right)  \right\}  ,$ where $\left\vert \mathbf{e}\right)
=\left\vert e_{1},\cdots,e_{r}\right)  .$ In particular when $\mathcal{H}%
^{1}=\mathbb{C}^{r}$ and $O\left(  \mathcal{H}^{1}\right)  =O\left(
r,\mathbb{C}\right)  $ one chooses a canonical basis
\begin{equation}
\left\vert \mathbf{e}\right)  =\left\vert \left(
\begin{array}
[c]{c}%
1\\
0\\
\vdots\\
0
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
1
\end{array}
\right)  \right)  .
\end{equation}

\end{notation}

\begin{definition}
The \emph{transpose} " $t$" is defined by the chosen canonical complex
symmetric inner product $\left(  \left.  {}\right\vert \right)  $ in
$\mathcal{H}^{1}$ by
\begin{equation}
\left(  \left.  A^{t}v\right\vert w\right)  =\left(  \left.  v\right\vert
Aw\right)  \quad\forall w\in\mathcal{H}^{1}\text{ and }v\in\mathcal{H}^{1},
\end{equation}
which depends on the \emph{non }degeneracy of $\left(  \left.  {}\right\vert
\right)  .$
\end{definition}

\paragraph{Dual Spaces \label{Dual Spaces}}

\begin{notation}
\begin{enumerate}
\item Matrix tensor product of row vectors $\mathbf{e,e}^{d}$
\begin{gather}
\left(  \mathbf{e}\right)  \mathbf{\otimes}\left(  \mathbf{e}^{d}\right)
=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \mathbf{\otimes}\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{1}^{d}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}\mathbf{\otimes}e_{1}^{d} & \cdots & e_{1}\mathbf{\otimes}e_{r}^{d}\\
\vdots & \ddots & \vdots\\
e_{r}\mathbf{\otimes}e_{1}^{d} & \cdots & e_{r}\mathbf{\otimes}e_{r}^{d}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(  e_{1},e_{1}^{d}\right)  & \cdots & \left(  e_{1},e_{r}^{d}\right) \\
\vdots & \ddots & \vdots\\
\left(  e_{r},e_{1}^{d}\right)  & \cdots & \left(  e_{r},e_{r}^{d}\right)
\end{array}
\right) \\
\in\mathcal{M}\left(  r,r,V\otimes V^{d}\right)  ,
\end{gather}
where $\left\{  \left.  e_{j},e_{j}^{d}\right\vert 1\leq j\leq r\right\}  $
are themselves contragradient vectors i.e. column vectors.

\item Matrix tensor product of row vectors $\mathbf{e}^{d}\mathbf{,e}$%
\begin{gather}
\left(  \mathbf{e}^{d}\right)  \mathbf{\otimes}\left(  \mathbf{e}\right)
=\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  \mathbf{\otimes}\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\mathbf{\otimes}e_{1} & \cdots & e_{1}^{d}\mathbf{\otimes}e_{r}\\
\vdots & \ddots & \vdots\\
e_{r}^{d}\mathbf{\otimes}e_{1} & \cdots & e_{r}^{d}\mathbf{\otimes}e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(  e_{1}^{d},e_{1}\right)  & \cdots & \left(  e_{1}^{d},e_{r}\right) \\
\vdots & \ddots & \vdots\\
\left(  e_{r}^{d},e_{r}\right)  & \cdots & \left(  e_{r}^{d},e_{r}\right)
\end{array}
\right) \\
\in\mathcal{M}\left(  r,r,V^{d}\otimes V\right)  ,
\end{gather}
where $\left\{  \left.  e_{j}^{d},e_{j}\right\vert 1\leq j\leq r\right\}  $
are themselves contragradient vectors i.e. column vectors.

\begin{definition}
\emph{Matrix Valued Dot} product of the \emph{matrix tensor product} of row
vectors in terms of the scalar values of dual functionals on vectors
\begin{gather}
\left(  \mathbf{e}^{d}\right)  ^{t}\cdot\left(  \mathbf{e}\right)
\overset{\text{def}}{=}\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right)  \mathbf{\cdot}\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  ==\left(
\begin{array}
[c]{ccc}%
\left\langle e_{1}^{d},e_{1}\right\rangle  & \cdots & \left\langle e_{1}%
^{d},e_{r}\right\rangle \\
\vdots & \ddots & \vdots\\
\left\langle e_{r}^{d},e_{r}\right\rangle  & \cdots & \left\langle e_{r}%
^{d},e_{r}\right\rangle
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  e_{1}\right)  & \cdots & e_{1}^{d}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
e_{r}^{d}\left(  e_{r}\right)  & \cdots & e_{r}^{d}\left(  e_{r}\right)
\end{array}
\right)  =\mathbb{I}_{r}\\
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)
\end{gather}

\end{definition}

\item \emph{Matrix Valued Dot} product of the tensor product of row vectors in
terms of the scalar values of \emph{double }dual functionals defined by the
scalar values of vectors on dual functionals
\begin{gather}
\left(  \mathbf{e}\right)  ^{t}\cdot\left(  \mathbf{e}^{d}\right)
\overset{\text{def}}{=}\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{r}%
\end{array}
\right)  \mathbf{\cdot}\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left\langle e_{1},e_{1}^{d}\right\rangle  & \cdots & \left\langle e_{1}%
,e_{r}^{d}\right\rangle \\
\vdots & \ddots & \vdots\\
\left\langle e_{r},e_{r}^{d}\right\rangle  & \cdots & \left\langle e_{r}%
,e_{r}^{d}\right\rangle
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{dd}\left(  e_{1}^{d}\right)  & \cdots & e_{1}^{dd}\left(  e_{r}%
^{d}\right) \\
\vdots & \ddots & \vdots\\
e_{r}^{dd}\left(  e_{r}^{d}\right)  & \cdots & e_{r}^{dd}\left(  e_{r}%
^{d}\right)
\end{array}
\right)  =\mathbb{I}_{r}\\
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)
\end{gather}


\begin{definition}
\emph{Operator Valued Dot} product of the tensor product of row vectors
\begin{gather}
\left(  \mathbf{e}\right)  \#\left(  \mathbf{e}^{d}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \mathbf{\#}\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{e}%
\end{array}
\right)  =\operatorname{Tr}\left\{  \left(
\begin{array}
[c]{ccc}%
\left[  e_{1}e_{1}^{d}\right]  & \cdots & \left[  e_{1}e_{r}^{d}\right] \\
\vdots & \ddots & \vdots\\
\left[  e_{r}e_{1}^{d}\right]  & \cdots & \left[  e_{r}e_{r}^{d}\right]
\end{array}
\right)  \right\}  =\sum_{1\leq j\leq r}\left[  e_{j}e_{j}^{d}\right]
=I_{V}\\
\in\mathcal{M}\left(  1,1,\mathcal{L}\left(  V\right)  \right)  \equiv
\mathcal{L}\left(  V\right)  .
\end{gather}

\end{definition}

\item This gives
\begin{equation}
\left(  \mathbf{a}\right)  \#\left(  \mathbf{e}^{d}\right)  ^{t}=\sum_{1\leq
j\leq r}\left[  a_{j}e_{j}^{d}\right]  ,
\end{equation}
where
\begin{equation}
a_{j}\in V,\quad1\leq j\leq r.
\end{equation}

\end{enumerate}
\end{notation}

\begin{remark}
Existence and uniqueness: The dual set always exists and gives an injection
from $V$ into $V^{d}$, namely the mapping that sends $v_{j}$ to $v_{j}^{d}$.
This says, in particular, that the dual space has dimension greater or equal
to that of $V$.
\end{remark}

\begin{remark}
However, the dual set of an infinite-dimensional $V$ does not span its dual
space $V^{d}$. For example, consider the map w in $V^{d}$ from $V$ into the
underlying scalars $\mathbb{F}$ given by
\begin{equation}
w(v_{j})=1
\end{equation}
for all $j$. This map is clearly nonzero on all $v_{j}$. If $w$ were a finite
linear combination of the dual basis vectors $\left\{  v_{j}\right\}  $, say
\begin{equation}
w=\sum_{j\in K}\U{3b1} _{j}v^{j}%
\end{equation}
for a finite subset $K$ of $I$, then for any $k$ not in $K$,
\begin{equation}
w(v_{j})=\sum_{j\in K}\U{3b1} _{j}v^{j}\left(  v_{k}\right)  =0
\end{equation}
contradicting the definition of $w$. So, this $w$ does not lie in the span of
the dual set.
\end{remark}

\begin{remark}
The dual of an infinite-dimensional space has greater dimensionality (this
being a greater infinite cardinality) than the original space has, and thus
these cannot have a basis with the same indexing set. However, dual sets of
vectors $\left\{  \mathbf{e}^{d}\right\}  $ exist, which define subspaces
$\mathcal{K}_{e}^{d}$ of the dual isomorphic to the original space. Further,
for topological vector spaces, a continuous dual space can be defined, in
which case a dual basis may exist.
\end{remark}

\begin{definition}
The complex linear map $\digamma_{\left(  {}\right)  }$
\begin{equation}
\digamma_{\left(  {}\right)  }:V\rightarrow V^{d}%
\end{equation}
given by%
\begin{equation}
\digamma_{\left(  {}\right)  }\left(  w\right)  =\digamma_{\left(  w\right)  }%
\end{equation}
where%
\begin{equation}
\digamma_{\left(  w\right)  }\left(  v\right)  =\left(  \left.  w\right\vert
v\right)  \quad\forall v\in V.
\end{equation}

\end{definition}

\begin{lemma}
A dual basis $\left(  \mathbf{e}^{d}\right)  $ is given by
\begin{equation}
\left(  \mathbf{e}^{d}\right)  =\digamma_{\left(  {}\right)  }\left(
\mathbf{e}\right)  =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert .
\end{equation}

\end{lemma}

\begin{definition}
The antilinear $\equiv$ conjugate map $\digamma_{\left\langle {}\right\rangle
}$%
\begin{equation}
\digamma_{\left\langle {}\right\rangle }:V\rightarrow V^{d}%
\end{equation}
given by%
\begin{equation}
\digamma_{\left\langle {}\right\rangle }\left(  w\right)  =\digamma
_{\left\langle w\right\rangle }%
\end{equation}
where%
\begin{equation}
\digamma_{\left\langle w\right\rangle }\left(  v\right)  =\left\langle \left.
w\right\vert v\right\rangle \quad\forall v\in V.
\end{equation}

\end{definition}

\begin{lemma}
A dual basis $\left(  \mathbf{e}^{d}\right)  $ is given by
\begin{equation}
\left(  \mathbf{e}^{d}\right)  =\digamma_{\left\langle {}\right\rangle
}\left(  \mathbf{e}\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\end{equation}

\end{lemma}

\begin{remark}
In the finite dimensional case $\left(  \mathbf{e}^{d}\right)  $ is unique for
$\left(  \mathbf{e}\right)  $ and the preceding lemmas show that this unique
biorthogonal basis $\left(  \mathbf{e}^{d}\right)  $ can be expressed in many ways.
\end{remark}

\begin{lemma}
In finite dimensional cases $V^{d}\cong V$, while in infinite dimensions $V$
is isomorphic to a subspaces $\mathcal{K}_{e}^{d}\subset V^{d}$ spanned by
dual bases $\left(  \mathbf{e}^{d}\right)  $ of $V.$
\end{lemma}

\begin{lemma}
The tensor product $V\otimes V^{d}$ is isomorpic to the space of linear
endomorphisms $\mathcal{L}\left(  V\right)  $ (not neccesarily continuous or
bounded) i.e.
\begin{equation}
V\otimes V^{d}\cong\mathcal{L}\left(  V\right)
\end{equation}
and
\begin{equation}
\Xi_{VV^{d}}:V\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
is a complex linear isomorphism.
\end{lemma}

\begin{proof}
The isomorphism given by
\begin{equation}
\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  =E_{jk}\in\mathcal{L}%
\left(  V\right)  ,\quad1\leq j,k\leq r,
\end{equation}
where $\left\{  \left.  E_{jk}\right\vert 1\leq j,k\leq r\right\}  $ are
operators defined by
\begin{equation}
\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  \left(  v\right)
=E_{jk}\left(  v\right)  =\left(  e_{k}^{d}\left(  v\right)  \right)
e_{j},\quad1\leq j,k\leq r.
\end{equation}

\end{proof}

\begin{notation}%
\begin{equation}
\left(  \mathbf{e}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}\equiv
\Xi_{VV^{d}}\left(  \mathbf{e}\otimes\mathbf{e}^{d}\right)
\end{equation}

\end{notation}

\begin{remark}
\begin{enumerate}
\item Product rule
\begin{equation}
E_{jk}E_{lm}=E_{jm}.
\end{equation}


\item Idempotency
\begin{equation}
E_{jj}E_{jj}=E_{jj}^{2}=E_{jj}.
\end{equation}


\item Partial isometry
\begin{equation}
E_{jk}E_{kj}=E_{jj}.
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
Let $A\in\mathcal{L}\left(  V\right)  $ then:

\begin{enumerate}
\item The operator $A\ $produces the vectors $\left(  \mathbf{a}\right)  $
when acting on the basis $\left(  \mathbf{e}\right)  $
\begin{equation}
A=A\left(  \mathbf{e}\right)  =\left(  \mathbf{a}\right)  .
\end{equation}


\item The representation of $A$ is the matrix $\mathcal{R}_{e}\left(
A\right)  \in\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ given by
\begin{equation}
A\left(  \mathbf{e}\right)  =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(
A\right)  =\left(  \mathbf{a}\right)  ,
\end{equation}
where
\begin{equation}
\left(  \mathbf{a}\right)  =\left(  a_{1},\cdots,a_{r}\right)
\end{equation}
and
\begin{equation}
a_{j}=Ae_{j}\quad1\leq j\leq r.
\end{equation}


\item The operator $A\in\mathcal{L}\left(  A\right)  $ can be expanded as

\begin{enumerate}
\item In terms of super vectors
\begin{equation}
A=A\left(  \mathbf{e}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}=\left(
\mathbf{a}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}.
\end{equation}


\item In terms of the operators $\left\{  \left.  E_{jk}\right\vert 1\leq
j,k\leq r\right\}  $ and the map $\Xi_{VV^{d}}$
\begin{align}
A  &  =\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  A\right)  _{jk}%
=\sum_{1\leq j,k\leq r}\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)
\mathcal{R}_{e}\left(  A\right)  _{jk}\\
&  =\Xi_{VV^{d}}\left(  \sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}%
^{d}\right)  \mathcal{R}_{e}\left(  A\right)  _{jk}\right)  =\Xi_{VV^{d}%
}\left(  \sum_{1\leq j,k\leq r}\left(  e_{j}\mathcal{R}_{e}\left(  A\right)
_{jk}\otimes e_{k}^{d}\right)  \right)  ,
\end{align}
which gives
\begin{equation}
A=\Xi_{VV^{d}}\left(  \sum_{1\leq j,k\leq r}\left(  e_{j}\mathcal{R}%
_{e}\left(  A\right)  _{jk}\otimes e_{k}^{d}\right)  \right)  =\Xi_{VV^{d}%
}\left(  \sum_{1\leq k\leq r}a_{k}\otimes e_{k}^{d}\right)  .
\end{equation}


\item In terms of the tensor product and the map $\Xi_{VV^{d}}$
\begin{align}
A  &  =\Xi_{VV^{d}}\left(  A\left(  \mathbf{e}\right)  \mathbf{\otimes}\left(
\mathbf{e}^{d}\right)  \right)  =\Xi_{VV^{d}}\left(  \left(  \mathbf{a}%
\right)  \mathbf{\otimes}\left(  \mathbf{e}^{d}\right)  \right)  =\Xi_{VV^{d}%
}\left(  \left(  \left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)
\right)  \mathbf{\otimes}\left(  \mathbf{e}^{d}\right)  \right) \\
&  =\Xi_{VV^{d}}\left(  \sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}%
^{d}\right)  \mathcal{R}_{e}\left(  A\right)  _{jk}\right)  =\sum_{1\leq
j,k\leq r}\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}%
_{e}\left(  A\right)  _{jk}.
\end{align}

\end{enumerate}

\item The matrix $\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  $ of
$A$ wrt the complex symmetric inner product $\left(  \left.  {}\right\vert
\right)  $ and basis $\left(  \mathbf{e}\right)  $ is defined as
\begin{equation}
\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  =\left(  \mathbf{e}%
\right\vert A\left\vert \mathbf{e}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  _{jk}=\left(  \left.
e_{j}\right\vert Ae_{k}\right)  \quad1\leq j,k\leq r.
\end{equation}


\item The expansion of $A$ using the resolution of the identity
\begin{equation}
I_{V}=\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert =\left\vert
\mathbf{e}^{b}\right)  \left(  \mathbf{e}\right\vert
\end{equation}
is%
\begin{equation}
A=\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert A\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert =\left\vert \mathbf{e}\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\mathcal{M}_{\left\vert
e\right)  }\left(  A\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert .
\end{equation}


\item The action of $A\ $ on the basis $\left(  \mathbf{e}\right)  $ is
\begin{equation}
A\left(  \mathbf{e}\right)  =\left(  \mathbf{a}\right)  =\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert A\left\vert \mathbf{e}\right)  =\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  .
\end{equation}


\item Hence the representation matrix $\mathcal{R}_{e}\left(  A\right)  $ and
matrix $\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  $ of $A$ are
related by
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert A\left\vert
\mathbf{e}\right)  =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  .
\end{equation}


\item This gives
\begin{equation}
A=\left\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}%
\right\vert ,
\end{equation}


\item which is confirmed by
\begin{equation}
A=\left\vert \mathbf{e}\right)  \left(  \overset{}{\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\mathcal{M}_{\left\vert
e\right)  }\left(  A\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}}\right)  \left(  \mathbf{e}\right\vert .
\end{equation}


\item The matrix $\mathcal{M}_{\left\vert e\right\rangle }\left(  A\right)  $
of $A$ wrt the sesquilinear inner product $\left\langle \left.  {}\right\vert
\right\rangle $ and basis $\left(  \mathbf{e}\right)  $ is defined as
\begin{equation}
\mathcal{M}_{\left\vert e\right\rangle }\left(  A\right)  =\left\langle
\left.  \mathbf{e}\right\vert A\mathbf{e}\right\rangle ,
\end{equation}
where
\begin{equation}
\mathcal{M}_{\left\vert e\right\rangle }\left(  A\right)  _{jk}=\left\langle
\left.  e_{j}\right\vert Ae_{k}\right\rangle \quad1\leq j,k\leq r.
\end{equation}


\item The expansion of $A$ using the resolution of the identity
\begin{equation}
I_{V}=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
=\left\vert \mathbf{e}^{b}\right\rangle \left\langle \mathbf{e}\right\vert
\end{equation}
is%
\begin{equation}
A=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}%
\right\vert A\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{\left\vert e\right\rangle }\left(
A\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert .
\end{equation}


\item The action of $A\ $ on the basis $\left(  \mathbf{e}\right)  $ is
\begin{equation}
A\left(  \mathbf{e}\right)  =\left(  \mathbf{a}\right)  =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
A\mathbf{e}\right\rangle =\left\vert \mathbf{e}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}%
_{\left\vert e\right\rangle }\left(  A\right)  .
\end{equation}


\item Hence the representation $\mathcal{R}_{e}\left(  A\right)  $ and matrix
$\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  $ of $A$ are related by
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
A\mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{\left\vert e\right\rangle }\left(
A\right)
\end{equation}


\item giving
\begin{equation}
A=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  A\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\end{equation}


\item which is confirmed by
\begin{equation}
A=\left(  \mathbf{e}\right)  \left(  \overset{}{\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{\left\vert
e\right\rangle }\left(  A\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}}\right)  \left\langle \mathbf{e}\right\vert .
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
There are \underline{\emph{many}} injections of $V\otimes V$ into $V\otimes
V^{d}$ producing an injection $\Xi_{VV^{d}}$ of $V\otimes V^{d}$ into
$\mathcal{L}\left(  V\right)  $ induced by linear and antilinear injections
$:V\rightarrow V^{d}.$ In particular $\digamma_{e\left(  \left.  {}\right\vert
\right)  },\digamma_{e\left\langle \left.  {}\right\vert \right\rangle },$
which are induced by $\left(  \left.  {}\right\vert \right)  $ and
$\left\langle \left.  {}\right\vert \right\rangle $ respectively.

\begin{remark}
In finite dimensions there is no dependence on the basis $\left(
\mathbf{e}\right)  $ and for convenience we sometimes drop the explicit dependence.
\end{remark}

\begin{enumerate}
\item $\Xi_{VV^{d}}$
\begin{equation}
\Xi_{VV^{d}}:V\otimes\digamma_{\left(  \left.  {}\right\vert \right)  }\left(
V\right)  \rightarrow\mathcal{L}\left(  V\right)
\end{equation}
induced by $\digamma_{\left(  \left.  {}\right\vert \right)  }$ by
\begin{equation}
\Xi_{VV^{d}}\left(  \mathbf{e}\otimes\digamma_{\left(  \left.  {}\right\vert
\right)  }\left(  \mathbf{e}\right)  \right)  =\left\vert \mathbf{e}\right)
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(
\mathbf{e}\right\vert \in\mathcal{M}\left(  r,r,\mathcal{L}\left(  V\right)
\right)  ,
\end{equation}
where $\left(  \mathbf{e}\right)  $ and $\left(  \mathbf{e}^{d}\right)  =$
$\digamma_{\left(  \left.  {}\right\vert \right)  }\left(  \left\vert
\mathbf{e}\right)  ^{b}\right)  $ are dual bases. Hence

\begin{enumerate}
\item
\begin{gather*}
\Xi_{VV^{d}}\left(  A\right)  =\Xi_{VV^{d}}\left(  A\left(  \mathbf{e}\right)
\otimes\left(  \mathbf{e}^{d}\right)  \right)  =\Xi_{VV^{d}}\left(  A\left(
\mathbf{e}\right)  \otimes\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}\left(  \mathbf{e}\right\vert \right)  =\Xi_{VV^{d}}\left(
\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \otimes\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}%
\right\vert \right)  =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(
A\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert \\
=\left\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  ^{-1}\mathcal{M}_{\left\vert e\right)  }\left(
A\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert =A.
\end{gather*}


\item
\begin{equation}
\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  =\left(  \left.
\mathbf{e}\right\vert A\mathbf{e}\right)  =\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  =\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  .
\end{equation}

\end{enumerate}

\item $\Xi_{VV}$ induced by $\digamma_{\left\langle \mathbf{e}\right\rangle }$
by the sesquilinear nondegenerate inner product $\left\langle \left.
{}\right\vert \right\rangle $
\begin{equation}
\Xi_{VV}:V\otimes V\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
induced by $\digamma_{\left\langle {}\right\rangle }$ by
\begin{equation}
\Xi_{VV}\left(  \mathbf{e}\otimes\digamma_{\left\langle {}\right\rangle
}\left(  \mathbf{e}\right)  \right)  =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert \in\mathcal{M}\left(  r,r,\mathcal{L}%
\left(  V\right)  \right)  ,
\end{equation}
where $\left(  \mathbf{e}\right)  $ and $\left(  \mathbf{e}^{d}\right)  =$
$\left(  \digamma_{\left\langle \mathbf{e}\right\rangle }\right)  $ are dual
bases. Hence

\begin{enumerate}
\item
\begin{gather*}
\Xi_{VV}\left(  A\right)  =\Xi_{VV^{d}}\left(  A\left(  \mathbf{e}\right)
\otimes\left(  \mathbf{e}^{d}\right)  \right)  =\Xi_{VV}\left(  A\left(
\mathbf{e}\right)  \otimes\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right)
=\Xi_{VV}\left(  \left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)
\otimes\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert \right)  =\left(  \mathbf{e}\right)
\mathcal{R}_{e}\left(  A\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \\
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert =A
\end{gather*}


\item
\begin{equation}
\mathcal{M}_{\left\vert e\right\rangle }\left(  A\right)  =\left\langle
\left.  \mathbf{e}\right\vert A\mathbf{e}\right\rangle =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  A\right)  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{notation}
The matrix transpose $\mathbb{A}^{t}$ of a matrix $\mathbb{A}\in
\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ is defined as
\begin{equation}
\left(  \mathbb{A}^{t}\right)  _{jk}=\left(  \mathbb{A}\right)  _{kj}%
,\quad1\leq j,k\leq r.
\end{equation}

\end{notation}

\begin{lemma}
The representation $\mathcal{R}_{e}\left(  A^{t}\right)  $ of the transpose
$A^{t}$ is related to the matrix transpose of the representation matrix by
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A^{t}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}=\mathcal{R}_{e}\left(  A\right)  ^{t}.
\end{equation}


\begin{proof}
The representations wrt to a basis $\left(  \mathbf{e}\right)  $ can be
expressed as
\begin{align}
A\left(  \mathbf{e}\right)   &  \equiv A\left\vert \mathbf{e}\right)  =\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \equiv\left\vert
\mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right) \\
A^{t}\left(  \mathbf{e}\right)   &  \equiv A^{t}\left\vert \mathbf{e}\right)
=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A^{t}\right)
\equiv\left\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A^{t}\right)
\end{align}
the matrices of $A$ and $A^{t}$ wrt the inner product $\left(  \left.
{}\right\vert \right)  $ and their representations are related by
\begin{align}
\mathcal{M}_{\left\vert e\right)  }\left(  A\right)   &  =\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right) \\
\mathcal{M}_{\left\vert e\right)  }\left(  A^{t}\right)   &  =\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}_{e}\left(  A^{t}\right)
.
\end{align}
The matrices of an operator and its transpose are related to its
representation matrices by
\begin{equation}
\mathcal{M}_{\left\vert e\right)  }\left(  A^{t}\right)  =\mathcal{M}%
_{\left\vert e\right)  }\left(  A\right)  ^{t}=\mathcal{R}_{e}\left(
A\right)  ^{t}\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
\end{equation}
giving
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A^{t}\right)  =\mathcal{R}_{e}\left(  A\right)  ^{t}\left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)
\end{equation}
and hence%
\begin{gather}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A^{t}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}=\mathcal{R}_{e}\left(  A\right)  ^{t}\\
\Updownarrow\\
\mathcal{R}_{e}\left(  A^{t}\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  .
\end{gather}

\end{proof}
\end{lemma}

\begin{corollary}
Representation of the transpose of the transpose%
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A^{t}\right)  ^{t}\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}=\mathcal{R}_{e}\left(  A\right)  .
\end{equation}

\end{corollary}

\begin{lemma}
Given that
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  ^{\dagger}=\overline{\mathcal{R}_{e}\left(
A\right)  ^{t}}%
\end{equation}


\begin{enumerate}
\item
\begin{equation}
\text{If }A=A^{t}\text{ then }\mathcal{R}_{e}\left(  A\right)  ^{t}%
=\mathcal{R}_{e}\left(  A\right)
\end{equation}


\item
\begin{equation}
\text{If }A=A^{\dagger}\text{ then }\mathcal{R}_{e}\left(  A\right)
^{\dagger}=\mathcal{R}_{e}\left(  A\right)  .
\end{equation}

\end{enumerate}
\end{lemma}

\begin{remark}
Transpose of orthogonal projectors
\begin{equation}
\left(  \left.  \overset{}{\left(  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  ^{t}e_{k}}\right\vert e_{l}\right)  =\left(  \left.
\overset{}{e_{k}}\right\vert \left(  \overset{}{\left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert }\right)  e_{l}\right)  =\left(  \left.
\overset{}{e_{k}}\right\vert e_{j}\right)  \delta_{jl}%
\end{equation}
giving in particular%
\begin{equation}
\left(  \left.  \left(  \overset{}{\left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert }\right)  ^{t}e_{j}\right\vert e_{j}\right)  =\left(  \left.
\overset{}{e_{j}}\right\vert \left(  \overset{}{\left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert }\right)  e_{j}\right)  =\left(  \left.
\overset{}{e_{j}}\right\vert e_{j}\right)  =\left(  \left.
\overset{\overset{}{}}{e_{j}}\right\vert \left(  \overset{}{\left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert }\right)  e_{j}\right)  .
\end{equation}

\end{remark}

\begin{remark}
Let $\left\vert \mathbf{e}\right\rangle $ be a conb then
\begin{align}
\left(  \left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert \right)
\left\vert \mathbf{e}\right\rangle  &  =\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right) \\
\left(  \left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert \right)
^{t}\left\vert \mathbf{e}\right\rangle  &  =\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  ^{t}=\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  ^{\dagger}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{R}_{e}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  =\mathcal{R}_{e}\left(  \left\vert e_{j}%
\right\rangle \left\langle e_{j}\right\vert \right)  ^{t}=\mathcal{R}%
_{e}\left(  \left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert
\right)  ^{\dagger}.
\end{equation}

\end{remark}

\begin{remark}
Let $\left(  \mathbf{e}\right)  $ be a bases then%
\begin{equation}
\left(  \mathbf{e}^{b}\right)  =\left(  \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}=\left(  \mathbf{e}\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}%
\end{equation}
and
\begin{equation}
\left(  \mathbf{e}^{d}\right)  =\digamma_{e}\left\{  \left(  \mathbf{e}%
^{b}\right)  \right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{R}_{e}\left(  A^{t}\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  .
\end{equation}%
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(
A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle .
\end{equation}

\end{remark}

\begin{remark}
Let $A=A^{\dagger}$ then
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(
A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle =\mathcal{R}_{e}\left(  A\right)  .
\end{equation}

\end{remark}

\begin{remark}
Let $A=A^{t}$ then
\begin{equation}
\mathcal{R}_{e}\left(  A^{t}\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  =\mathcal{R}_{e}\left(  A\right)  .
\end{equation}

\end{remark}

\begin{definition}
The set of $\mathcal{P}_{e}=\left\{  \left.  P_{e_{j}}\right\vert 1\leq k\leq
r\right\}  $ orthogonal projectors onto vectors $\left\{  \left.
e_{j}\right\vert 1\leq j\leq r\right\}  $%
\begin{equation}
P_{e_{j}}e_{k}=\delta_{jk}e_{j},\quad1\leq j,k\leq r
\end{equation}

\end{definition}

\begin{definition}%
\begin{equation}
P_{\left\vert e_{j}\right\rangle }=\left\vert e_{j}\right\rangle \left\langle
e_{j}^{b}\right\vert
\end{equation}%
\begin{equation}
P_{\left\vert e_{j}\right)  }=\left\vert e_{j}\right)  \left(  e_{j}%
^{b}\right\vert
\end{equation}%
\begin{equation}
P_{\left(  e_{j}\right)  }=\Xi_{VV^{d}}\left(  e_{j}\otimes e_{j}^{d}\right)
.
\end{equation}

\end{definition}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
P_{\left\vert e_{j}\right\rangle }\left(  e_{k}\right)  =\left\vert
e_{j}\right\rangle \left\langle e_{j}^{b}\right\vert \left(  e_{k}\right)
=e_{k}\left\langle \left.  e_{j}^{b}\right\vert e_{k}\right\rangle
=e_{j}\delta_{jk}%
\end{equation}


\item
\begin{equation}
P_{\left\vert e_{j}\right\rangle }\left(  v\right)  =P_{\left\vert
e_{j}\right\rangle }\left(  \sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(
v\right)  _{j}\right)  =P_{\left\vert e_{j}\right\rangle }\left(  \left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert v\right)  =P_{\left\vert e_{j}\right\rangle
}\left(  \left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.
\mathbf{e}\right\vert v\right\rangle \right)  =e_{j}\mathcal{R}_{e}\left(
v\right)  _{j}%
\end{equation}


\item
\begin{equation}
P_{\left\vert e_{j}\right)  }\left(  e_{k}\right)  =\left\vert e_{j}\right)
\left(  e_{j}^{b}\right\vert \left(  e_{k}\right)  =e_{k}\left(  \left.
e_{j}^{b}\right\vert e_{k}\right)  =e_{j}\delta_{jk}%
\end{equation}


\item
\begin{equation}
P_{\left\vert e_{j}\right\rangle }\left(  v\right)  =P_{\left\vert
e_{j}\right\rangle }\left(  \sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(
v\right)  _{j}\right)  =P_{\left\vert e_{j}\right\rangle }\left(  \left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert v\right)
\end{equation}


\item
\begin{equation}
P_{\left(  e_{j}\right)  }\left(  e_{k}\right)  =e_{j}^{d}\left(
e_{k}\right)  =e_{j}\delta_{jk}.
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
Using the resolution of the identities one obtains

\begin{enumerate}
\item
\begin{align}
\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert v  &  =v=\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)  =\sum_{1\leq j\leq r}%
e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}\\
\mathcal{R}_{e}\left(  v\right)   &  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \left.  \mathbf{e}\right\vert v\right)  ,
\end{align}


\item
\begin{align}
\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert v  &
=v=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)  =\sum_{1\leq
j\leq r}e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}\\
\mathcal{R}_{e}\left(  v\right)   &  =\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}%
\right\vert v\right\rangle
\end{align}
and thus

\item
\begin{equation}
\mathcal{R}_{e}\left(  v\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
v\right\rangle =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \left.  \mathbf{e}\right\vert v\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{lemma}%
\begin{equation}
P_{\left(  e_{j}\right)  }\equiv P_{e_{j}}=P_{\left\vert e_{j}\right)
}=P_{\left\vert e_{j}\right\rangle }.
\end{equation}

\end{lemma}

\begin{remark}
\begin{enumerate}
\item
\begin{enumerate}
\item
\begin{equation}
\left\vert e_{j}\right\rangle \left\langle e_{j}^{b}\right\vert ^{2}%
e_{k}=\left\vert e_{j}\right\rangle \left\langle e_{j}^{b}\right\vert
\left\vert e_{j}\right\rangle \left\langle e_{j}^{b}\right\vert e_{k}%
=\left\vert e_{j}\right\rangle \left\langle e_{j}^{b}\right\vert e_{j}%
\delta_{jk}=e_{j}\delta_{jk}%
\end{equation}


\item
\begin{equation}
\left\vert e_{j}\right)  \left(  e_{j}^{b}\right\vert ^{2}e_{k}=\left\vert
e_{j}\right)  \left(  e_{j}^{b}\right\vert \left\vert e_{j}\right)  \left(
e_{j}^{b}\right\vert e_{k}=\left\vert e_{j}\right)  \left(  e_{j}%
^{b}\right\vert e_{j}\delta_{jk}=e_{j}\delta_{jk}%
\end{equation}


\item
\begin{equation}
P_{e_{j}}=\left\vert e_{j}\right\rangle \left\langle e_{j}^{b}\right\vert
=\sum_{1\leq k\leq r}\left\vert e_{j}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle _{jk}^{-1}\left\langle
e_{k}\right\vert =\left(  \left\vert e_{j}\right\rangle \left\langle e_{j}%
^{b}\right\vert \right)  ^{\dagger}=P_{e_{j}}^{\dagger}%
\end{equation}


\item
\begin{equation}
P_{e_{j}}=\left\vert e_{j}\right)  \left(  e_{j}^{b}\right\vert =\sum_{1\leq
k\leq r}\left\vert e_{j}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  _{jk}^{-1}\left(  e_{k}\right\vert =\left(  \left\vert
e_{j}\right)  \left(  e_{j}^{b}\right\vert \right)  ^{t}=P_{e_{j}}^{t}%
\end{equation}


\item
\begin{equation}
\left(  \left.  \overset{}{\left(  \left\vert e_{l}\right)  \left(  e_{l}%
^{b}\right\vert \right)  }e_{j}\right\vert e_{k}\right)  =\left(  \left.
\overset{}{e_{k}}\right\vert \left(  \left\vert e_{l}\right)  \left(
e_{l}^{b}\right\vert \right)  e_{j}\right)  =\left(  \left.  \overset{}{e_{k}%
}\right\vert e_{l}\right)  \delta_{lj}=\delta_{kl}\delta_{lj}%
\end{equation}


\item
\begin{equation}
\left(  \left.  \overset{}{\left(  \left\vert e_{l}\right)  \left(  e_{l}%
^{b}\right\vert \right)  ^{t}}e_{j}\right\vert e_{k}\right)  =\left(  \left.
\overset{}{e_{j}}\right\vert \left(  \left\vert e_{l}\right)  \left(
e_{l}^{b}\right\vert \right)  e_{k}\right)  =\left(  \left.  e_{j}\right\vert
e_{l}\right)  \delta_{lk}=\delta_{kl}\delta_{lj}%
\end{equation}


\item
\begin{equation}
\left(  \left.  \overset{}{\left(  \left\vert e_{l}\right)  \left(  e_{l}%
^{b}\right\vert \right)  }e_{j}\right\vert e_{k}\right)  =\left(  \left.
\overset{}{\left(  \left\vert e_{l}\right)  \left(  e_{l}^{b}\right\vert
\right)  ^{t}}e_{j}\right\vert e_{k}\right)
\end{equation}
hence
\begin{equation}
\left\vert e_{l}\right)  \left(  e_{l}^{b}\right\vert =\left(  \left\vert
e_{l}\right)  \left(  e_{l}^{b}\right\vert \right)  ^{t}%
\end{equation}


\item
\begin{equation}
\left\langle \left.  \overset{}{\left(  \left\vert e_{l}\right\rangle
\left\langle e_{l}^{b}\right\vert \right)  }e_{j}\right\vert e_{k}%
\right\rangle =\left\langle \left.  \overset{}{e_{k}}\right\vert \left(
\left\vert e_{l}\right\rangle \left\langle e_{l}^{b}\right\vert \right)
e_{j}\right\rangle =\left\langle \left.  \overset{}{e_{k}}\right\vert
e_{l}\right\rangle \delta_{lj}=\delta_{kl}\delta_{lj}%
\end{equation}


\item
\begin{equation}
\left\langle \left.  \overset{}{\left(  \left\vert e_{l}\right\rangle
\left\langle e_{l}^{b}\right\vert \right)  ^{\dagger}}e_{j}\right\vert
e_{k}\right\rangle =\left\langle \left.  \overset{}{e_{j}}\right\vert \left(
\left\vert e_{l}\right\rangle \left\langle e_{l}^{b}\right\vert \right)
e_{k}\right\rangle =\left\langle \left.  e_{j}\right\vert e_{l}\right\rangle
\delta_{lk}=\delta_{kl}\delta_{lj}%
\end{equation}


\item
\begin{equation}
\left\langle \left.  \overset{}{\left(  \left\vert e_{l}\right\rangle
\left\langle e_{l}^{b}\right\vert \right)  }e_{j}\right\vert e_{k}%
\right\rangle =\left\langle \left.  \overset{}{\left(  \left\vert
e_{l}\right\rangle \left\langle e_{l}^{b}\right\vert \right)  ^{\dagger}}%
e_{j}\right\vert e_{k}\right\rangle
\end{equation}
hence
\begin{equation}
\left\vert e_{l}\right\rangle \left\langle e_{l}^{b}\right\vert =\left(
\left\vert e_{l}\right\rangle \left\langle e_{l}^{b}\right\vert \right)
^{\dagger}%
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{lemma}
The set of projectors $\left\{  \left.  P_{e_{j}}\right\vert 1\leq k\leq
r\right\}  $ is unique.
\end{lemma}

\begin{proof}
The bases $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ and
$\left\{  \left.  e_{j}^{d}\right\vert 1\leq j\leq r\right\}  $ are unique.
\end{proof}

\begin{theorem}
The projectors $\left\{  \left.  P_{e_{j}}=\Xi_{VV^{d}}\left(  e_{j}\otimes
e_{j}^{d}\right)  =E_{jj}=\left\vert e_{j}\right)  \left(  e_{j}^{\left(
b\right)  }\right\vert =\left\vert e_{j}\right\rangle \left\langle
e_{j}^{\left\langle b\right\rangle }\right\vert \right\vert 1\leq j\leq
r\right\}  $ are
\end{theorem}

\begin{enumerate}
\item $\left(  \left.  {}\right\vert \right)  $-symmetric i.e.
\begin{equation}
P_{e_{j}}=P_{e_{j}}^{t},\,1\leq j\leq r
\end{equation}
and

\item $\left\langle \left.  {}\right\vert \right\rangle $-self adjoint i.e.
\begin{equation}
P_{e_{j}}=P_{e_{j}}^{\dagger},\,1\leq j\leq r.
\end{equation}

\end{enumerate}

\begin{proof}
$\left\{  \left.  \Xi_{VV^{d}}\left(  e_{j}\otimes e_{j}^{d}\right)
\right\vert 1\leq j\leq r\right\}  $ are $\left(  \left.  {}\right\vert
\right)  $-symmetric and $\left\langle \left.  {}\right\vert \right\rangle
$-self adjoint as seen in the preceding.
\end{proof}

\begin{lemma}%
\begin{equation}
E_{jk}=\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  =\left\vert
e_{j}\right)  \left(  e_{k}^{\left(  b\right)  }\right\vert =\left\vert
e_{j}\right\rangle \left\langle e_{k}^{\left\langle b\right\rangle
}\right\vert ,1\leq j,k\leq r\,
\end{equation}

\end{lemma}

\begin{lemma}
The adjoints and transposes of $\left\{  \left.  E_{jk}\right\vert 1\leq j\neq
k\leq r\right\}  $ are given by
\begin{equation}
\left(  \left\vert e_{j}\right)  \left(  e_{k}^{\left(  b\right)  }\right\vert
\right)  ^{t}=\left\vert e_{k}\right)  \left(  e_{j}^{\left(  b\right)
}\right\vert ,1\leq j\neq k\leq r\,
\end{equation}
and
\begin{equation}
\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}^{\left\langle
b\right\rangle }\right\vert \right)  ^{\dagger}=\left\vert e_{k}\right\rangle
\left\langle e_{j}^{\left\langle b\right\rangle }\right\vert ,1\leq j\neq
k\leq r\,,
\end{equation}
where
\begin{equation}
E_{jk}=\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  =\left\vert
e_{j}\right)  \left(  e_{k}^{\left(  b\right)  }\right\vert =\left\vert
e_{j}\right\rangle \left\langle e_{k}^{\left\langle b\right\rangle
}\right\vert ,1\leq j\neq k\leq r\,
\end{equation}
and thus are partial isometries.
\end{lemma}

\begin{lemma}
In general
\begin{equation}
\left(  \left\vert e_{j}\right)  \left(  e_{k}^{\left(  b\right)  }\right\vert
\right)  ^{t}\neq\left(  \left\vert e_{j}\right\rangle \left\langle
e_{k}^{\left\langle b\right\rangle }\right\vert \right)  ^{\dagger}.
\end{equation}

\end{lemma}

\begin{remark}
\begin{enumerate}
\item
\begin{enumerate}
\item By definition
\begin{equation}
\left(  \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{l}\otimes e_{m}^{d}\right)
}e_{j}\right\vert e_{k}\right)  =\left(  \left.  \overset{}{\left\vert
e_{l}\right)  \left(  e_{m}^{\left(  b\right)  }\right\vert }e_{j}\right\vert
e_{k}\right)  =\left(  \left.  \overset{}{e_{k}}\right\vert e_{l}\right)
\delta_{lj}=\delta_{mj}\delta_{kl}%
\end{equation}
hence
\begin{equation}
\left(  \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{m}\otimes e_{l}^{d}\right)
}e_{j}\right\vert e_{k}\right)  =\left(  \left.  \overset{}{\left\vert
e_{m}\right)  \left(  e_{l}^{\left(  b\right)  }\right\vert }e_{j}\right\vert
e_{k}\right)  =\left(  \left.  \overset{}{e_{k}}\right\vert e_{m}\right)
\delta_{lj}=\delta_{km}\delta_{lj},
\end{equation}
while
\begin{equation}
\left(  \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{l}\otimes e_{m}^{d}\right)
^{t}}e_{j}\right\vert e_{k}\right)  =\left(  \left.  \overset{\overset{}{}%
}{e_{j}}\right\vert \left\vert e_{l}\right)  \left(  e_{m}^{\left(  b\right)
}\right\vert e_{k}\right)  =\left(  \left.  \overset{}{e_{j}}\right\vert
e_{l}\right)  \delta_{lj}=\delta_{mk}\delta_{jl}%
\end{equation}
thus
\begin{equation}
\left(  \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{m}\otimes e_{l}^{d}\right)
}e_{j}\right\vert e_{k}\right)  =\left(  \left.  \overset{}{\Xi_{VV^{d}%
}\left(  e_{l}\otimes e_{m}^{d}\right)  ^{t}}e_{j}\right\vert e_{k}\right)
\end{equation}
and hence
\begin{equation}
E_{jk}^{t}=E_{kj}.
\end{equation}


\item By definition
\begin{equation}
\left\langle \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{l}\otimes e_{m}%
^{d}\right)  }e_{j}\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{}{\left\vert e_{l}\right)  \left(  e_{m}^{\left(  b\right)
}\right\vert }e_{j}\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{}{e_{k}}\right\vert e_{l}\right\rangle \delta_{lj}=\delta_{mj}%
\delta_{kl}%
\end{equation}
hence
\begin{equation}
\left\langle \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{m}\otimes e_{l}%
^{d}\right)  }e_{j}\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{}{\left\vert e_{m}\right)  \left(  e_{l}^{\left(  b\right)
}\right\vert }e_{j}\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{}{e_{k}}\right\vert e_{m}\right\rangle \delta_{lj}=\delta_{km}%
\delta_{lj},
\end{equation}
while
\begin{equation}
\left\langle \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{l}\otimes e_{m}%
^{d}\right)  ^{t}}e_{j}\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{\overset{}{}}{e_{j}}\right\vert \left\vert e_{l}\right)  \left(
e_{m}^{\left(  b\right)  }\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{}{e_{j}}\right\vert e_{l}\right\rangle \delta_{lj}=\delta_{mk}%
\delta_{jl}%
\end{equation}
thus
\begin{equation}
\left\langle \left.  \overset{}{\Xi_{VV^{d}}\left(  e_{m}\otimes e_{l}%
^{d}\right)  }e_{j}\right\vert e_{k}\right\rangle =\left\langle \left.
\overset{}{\Xi_{VV^{d}}\left(  e_{l}\otimes e_{m}^{d}\right)  ^{t}}%
e_{j}\right\vert e_{k}\right\rangle
\end{equation}
and hence
\begin{equation}
E_{jk}^{\dagger}=E_{kj}.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}%
\begin{equation}
\varphi^{d}=\sum_{1\leq j\leq r}e_{j}^{d}\mathcal{R}_{e^{d}}\left(
\varphi^{d}\right)  _{j}=\sum_{1\leq j\leq r}e_{j}^{d}\mathcal{R}_{e}\left(
\varphi\right)  _{j}%
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{e^{d}}\left(  \varphi^{d}\right)  _{j}=\mathcal{R}_{e}\left(
\varphi\right)  _{j},\,1\leq j\leq r,
\end{equation}
which defines $\digamma_{e}$ i.e.%
\begin{align}
\varphi^{d}  &  =\digamma_{e}\left(  \varphi\right) \\
\mathcal{R}_{e^{d}}\left(  \varphi^{d}\right)  _{j}  &  =\mathcal{R}%
_{e}\left(  \varphi\right)  _{j},\,1\leq j\leq r.
\end{align}

\end{remark}

\begin{corollary}
The projectors $\left\{  \left.  P_{\varphi}=\Xi_{VV^{d}}\left(
\varphi\otimes\varphi^{d}\right)  =\left\vert \varphi\right)  \left(
\varphi^{\left(  b\right)  }\right\vert =\left\vert \varphi\right\rangle
\left\langle \varphi^{\left\langle b\right\rangle }\right\vert \right\vert
1\leq j\leq r\right\}  $ are $\left(  \left.  {}\right\vert \right)
$-symmetric and $\left\langle \left.  {}\right\vert \right\rangle $-self
adjoint i.e.
\begin{equation}
P_{\varphi}=P_{\varphi}^{t}=P_{\varphi}^{\dagger},\,1\leq j\leq r.
\end{equation}

\end{corollary}

\begin{proof}
The expansion of $\varphi\otimes\varphi^{d}$
\begin{equation}
\varphi\otimes\varphi^{d}=\sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}%
^{d}\right)  \mathcal{R}_{e}\left(  \varphi\right)  _{j}\mathcal{R}_{e^{d}%
}\left(  \varphi^{d}\right)  _{k}%
\end{equation}
gives
\begin{equation}
\Xi_{VV^{d}}\left(  \varphi\otimes\varphi^{d}\right)  =\sum_{1\leq j,k\leq
r}\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}_{e}\left(
\varphi\right)  _{j}\mathcal{R}_{e^{d}}\left(  \varphi^{d}\right)  _{k}%
=\sum_{1\leq j,k\leq r}\left\vert e_{j}\right)  \left(  e_{k}^{\left(
b\right)  }\right\vert \mathcal{R}_{e}\left(  \varphi\right)  _{j}%
\mathcal{R}_{e^{d}}\left(  \varphi^{d}\right)  _{k}=\sum_{1\leq j,k\leq
r}\left\vert e_{j}\right\rangle \left\langle e_{k}^{\left\langle
b\right\rangle }\right\vert \mathcal{R}_{e}\left(  \varphi\right)
_{j}\mathcal{R}_{e^{d}}\left(  \varphi^{d}\right)  _{k}.
\end{equation}
and
\begin{equation}
\Xi_{VV^{d}}\left(  \varphi\otimes\varphi^{d}\right)  ^{t}=\sum_{1\leq j,k\leq
r}\left\vert e_{k}\right)  \left(  e_{j}^{\left(  b\right)  }\right\vert
\mathcal{R}_{e}\left(  \varphi\right)  _{j}\mathcal{R}_{e^{d}}\left(
\varphi^{d}\right)  _{k}=\sum_{1\leq j,k\leq r}\left\vert e_{k}\right)
\left(  e_{j}^{\left(  b\right)  }\right\vert \mathcal{R}_{e^{d}}\left(
\varphi^{d}\right)  _{j}\mathcal{R}_{e}\left(  \varphi\right)  _{k}%
=\sum_{1\leq j,k\leq r}\left\vert e_{j}\right)  \left(  e_{k}^{\left(
b\right)  }\right\vert \mathcal{R}_{e^{d}}\left(  \varphi^{d}\right)
_{k}\mathcal{R}_{e}\left(  \varphi\right)  _{j}%
\end{equation}
hence
\begin{equation}
\Xi_{VV^{d}}\left(  \varphi\otimes\varphi^{d}\right)  =\Xi_{VV^{d}}\left(
\varphi\otimes\varphi^{d}\right)  ^{t}.
\end{equation}

\end{proof}

\begin{remark}
\emph{Sesqui linear inner products in a Hilbert space are not unique. This can
easily be seen by considering a canonical non degenerate sesqui linear inner
product }$\left\langle \left.  {}\right\vert \right\rangle $ \emph{and
defining new inner products} by using non singular operators $A\in GL\left(
\mathcal{H}^{1}\right)  \subset\mathcal{B}\left(  \mathcal{H}^{1}\right)  $
\emph{ }%
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\left\langle \left.
v\right\vert A^{\dagger}Aw\right\rangle \quad\forall v,w\in\mathcal{H}^{1}.
\end{equation}

\end{remark}

\begin{remark}
\emph{Symmetric inner products in a complex vector space are not unique. This
can easily by considering a canonical complex symmetric non degenerate inner
product }$\left(  \left.  {}\right\vert \right)  $ and \emph{defining new
inner products} by using non singular operators $A\in GL\left(  \mathcal{H}%
^{1}\right)  \subset\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ \emph{ }%
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{A}=\left(  \left.  v\right\vert
A^{t}Aw\right)  \quad\forall v,w\in\mathcal{H}^{1}.
\end{equation}

\end{remark}

\begin{theorem}
All positive sesqui linear forms
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle _{A}:\mathcal{H}^{1}%
\times\mathcal{H}^{1}\rightarrow\mathbb{C}%
\end{equation}
can be expressed as
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{A}=\left\langle \left.
v\right\vert A^{\dagger}Aw\right\rangle \,\forall v,w\in\mathcal{H}^{1},
\end{equation}
where $A$ is invertible i.e. $A\in GL\left(  \mathcal{H}^{1}\right)  $.
\end{theorem}

\begin{corollary}%
\begin{equation}
\left\langle \left.  v\right\vert A^{\dagger}Aw\right\rangle =\mathcal{R}%
_{e}\left(  v\right)  \mathcal{R}_{e}\left(  A\right)  ^{\dagger}\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
A\right)  \mathcal{R}_{e}\left(  w\right)  .
\end{equation}

\end{corollary}

\begin{corollary}
If $\left\vert \mathbf{e}\right\rangle $ is a $\left\langle \left.
{}\right\vert \right\rangle $-conb i.e.
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\mathbb{I}_{r}%
\end{equation}
then
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
_{A}=\left\langle \left.  \mathbf{e}\right\vert A^{\dagger}A\mathbf{e}%
\right\rangle =\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(
A^{\dagger}A\right)  =\mathcal{R}_{\mathbf{e}}\left(  A^{\dagger}\right)
\mathcal{R}_{\mathbf{e}}\left(  A\right)  =\mathcal{R}_{\mathbf{e}}\left(
A\right)  ^{\dagger}\mathcal{R}_{\mathbf{e}}\left(  A\right)  =\mathcal{M}%
_{\left\vert \mathbf{e}\right\rangle }\left(  A^{\dagger}\right)
\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A\right)
=\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A\right)  ^{\dagger
}\mathcal{M}_{\left\vert \mathbf{e}\right\rangle }\left(  A\right)  .
\end{equation}

\end{corollary}

\begin{theorem}
All complex symmetric non degenerate bilinear forms
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{A}:\mathcal{H}^{1}\times
\mathcal{H}^{1}\rightarrow\mathbb{C}%
\end{equation}
can be expressed as
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{A}=\left(  \left.  v\right\vert
A^{t}Aw\right)  \,\forall v,w\in\mathcal{H}^{1},
\end{equation}
where $A$ is invertible i.e. $A\in GL\left(  \mathcal{H}^{1}\right)  .$
\end{theorem}

\begin{corollary}%
\begin{equation}
\left(  \left.  v\right\vert A^{t}Aw\right)  =\mathcal{R}_{e}\left(  v\right)
\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  \mathcal{R}_{e}\left(
w\right)  .
\end{equation}

\end{corollary}

\begin{corollary}
If $\left\vert \mathbf{e}\right)  $ is a $\left(  \left.  {}\right\vert
\right)  $-conb i.e.
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\mathbb{I}_{r}%
\end{equation}
then
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  _{A}=\left(  \left.
\mathbf{e}\right\vert A^{t}A\mathbf{e}\right)  =\mathcal{M}_{\left\vert
\mathbf{e}\right)  }\left(  A^{t}A\right)  =\mathcal{R}_{\mathbf{e}}\left(
A^{t}\right)  \mathcal{R}_{\mathbf{e}}\left(  A\right)  =\mathcal{R}%
_{\mathbf{e}}\left(  A\right)  ^{t}\mathcal{R}_{\mathbf{e}}\left(  A\right)
=\mathcal{M}_{\left\vert \mathbf{e}\right)  }\left(  A^{t}\right)
\mathcal{M}_{\left\vert \mathbf{e}\right)  }\left(  A\right)  =\mathcal{M}%
_{\left\vert \mathbf{e}\right)  }\left(  A\right)  ^{t}\mathcal{M}_{\left\vert
\mathbf{e}\right)  }\left(  A\right)  .
\end{equation}

\end{corollary}

\begin{definition}
$\left\langle \left.  {}\right\vert \right\rangle _{A}$-adjoint%
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert w\right\rangle _{A}%
=\left\langle \left.  B^{\dagger_{A}}v\right\vert A^{\dagger}Aw\right\rangle
=\left\langle \left.  A^{\dagger}AB^{\dagger_{A}}v\right\vert w\right\rangle
=\left\langle \left.  v\right\vert Bw\right\rangle _{A}=\left\langle \left.
v\right\vert A^{\dagger}ABw\right\rangle \quad\forall w\in\mathcal{H}%
^{1}\text{ and }v\in\mathcal{H}^{1},
\end{equation}
i.e.
\begin{equation}
A^{\dagger}AB^{\dagger_{A}}=B^{\dagger}A^{\dagger}A\Longleftrightarrow
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{definition}

\begin{theorem}
$B^{\dagger_{A}}$ is a similarity transformation of $B^{\dagger}$ i.e.
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{theorem}

\begin{proof}
As%
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert w\right\rangle _{A}%
=\left\langle \left.  v\right\vert Bw\right\rangle _{A}%
\end{equation}
then by definition
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}v\right\vert A^{\dagger}Aw\right\rangle
=\left\langle \left.  v\right\vert A^{\dagger}ABw\right\rangle
\end{equation}
hence
\begin{equation}
A^{\dagger}AB^{\dagger_{A}}=B^{\dagger}A^{\dagger}A
\end{equation}
and
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{proof}

\begin{definition}
$\left(  \left.  {}\right\vert \right)  _{A}$-transpose
\begin{equation}
\left(  \left.  B^{t_{A}}v\right\vert w\right)  _{A}=\left(  \left.
v\right\vert Bw\right)  _{A}=\left(  \left.  v\right\vert A^{t}ABw\right)
\quad\forall w\in\mathcal{H}^{1}\text{ and }v\in\mathcal{H}^{1},
\end{equation}
i.e.
\begin{equation}
A^{t}AB^{t_{A}}=B^{t}A^{t}A\Longleftrightarrow B^{t_{A}}=\left(
A^{t}A\right)  ^{-1}B^{t}\left(  A^{t}A\right)  .
\end{equation}

\end{definition}

\begin{theorem}
$B^{t_{A}}$ is a similarity transformation of $B^{t}$ i.e.
\begin{equation}
B^{t_{A}}=\left(  A^{t}A\right)  ^{-1}B^{t}\left(  A^{t}A\right)  .
\end{equation}

\end{theorem}

\begin{proof}
As%
\begin{equation}
\left(  \left.  B^{t_{A}}v\right\vert w\right)  _{A}=\left(  \left.
v\right\vert Bw\right)  _{A}%
\end{equation}
then by definition
\begin{equation}
\left(  \left.  B^{\dagger_{A}}v\right\vert A^{t}Aw\right)  =\left(  \left.
v\right\vert A^{t}ABw\right)
\end{equation}
hence
\begin{equation}
A^{t}AB^{t_{A}}=B^{t}A^{t}A
\end{equation}
and
\begin{equation}
B^{t_{A}}=\left(  A^{t}A\right)  ^{-1}B^{t}\left(  A^{t}A\right)  .
\end{equation}


\begin{remark}
Recall that the representation $\mathcal{R}_{e}\left(  B^{\dagger}\right)  $
of $B^{\dagger}$ is given by
\begin{equation}
\mathcal{R}_{e}\left(  B^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(
B^{\dagger}\right)  ,
\end{equation}
which gives
\begin{align}
\mathcal{R}_{e}\left(  B^{\dagger}\right)   &  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(
B^{\dagger}\right)  =\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)  ^{\dagger}\\
&  =\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\mathcal{M}_{e}\left(  B\right)  =\mathcal{R}_{e}\left(  B\right)  ,
\end{align}
showing that the $\mathcal{R}_{e}$ representation of the canonical adjoint
$B^{\dagger}$of $B$ is not the matrix adjoint of the $\mathcal{R}_{e}$
representation of $B$ so $\mathcal{R}_{e}$ is not a star map unless
$\left\vert \mathbf{e}\right\rangle $ is a conb i.e.
\begin{equation}
\mathcal{R}_{e}\left(  B\right)  ^{\dagger}=\mathcal{M}_{e}\left(  B\right)
^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\neq\mathcal{R}_{e}\left(  B^{\dagger}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The matrix adjoint of the $\mathcal{R}_{e}$ representation of $B$ is
\begin{equation}
\mathcal{R}_{e}\left(  B\right)  ^{\dagger}=\mathcal{M}_{e}\left(  B\right)
^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1},
\end{equation}
which gives%
\begin{equation}
\mathcal{R}_{e}\left(  B\right)  ^{\dagger}\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle =\mathcal{M}_{e}\left(  B\right)
^{\dagger}.
\end{equation}

\end{remark}
\end{proof}

\begin{lemma}
The \emph{matrix} of the adjoint is the adjoint of the matrix
\begin{equation}
\mathcal{M}_{e}\left(  B^{\dagger}\right)  =\mathcal{M}_{e}\left(  B\right)
^{\dagger}.
\end{equation}

\end{lemma}

\begin{proof}
As the inner product $\left\langle \left.  {}\right\vert \right\rangle $ is
sesquilinear
\begin{equation}
\mathcal{M}_{e}\left(  B^{\dagger}\right)  =\left\langle \mathbf{e}\right\vert
B^{\dagger}\left\vert \mathbf{e}\right\rangle =\left\langle B\mathbf{e}%
\right\vert \left\vert \mathbf{e}\right\rangle =\left\langle \mathbf{e}%
\right\vert \left\vert B\mathbf{e}\right\rangle ^{\dagger}=\mathcal{M}%
_{e}\left(  B\right)  ^{\dagger}.
\end{equation}

\end{proof}

\begin{theorem}
The representation matrix of the adjoint is a similarity transform of the
adjoint of the representation matrix
\begin{equation}
\mathcal{R}_{e}\left(  B^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(
B\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle .
\end{equation}

\end{theorem}

\begin{proof}
The resolution of the identity%
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert
\end{equation}
gives
\begin{equation}
B=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
B\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)  \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert
\end{equation}
and
\begin{equation}
B\left\vert \mathbf{e}\right\rangle =\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  B\right)  \Longleftrightarrow\mathcal{M}_{e}\left(
B\right)  =\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}%
\right\rangle \mathcal{R}_{e}\left(  B\right)
\end{equation}
hence
\begin{equation}
B=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  B\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert .
\end{equation}
Recall that the representation matrix $\mathcal{R}_{e}\left(  B\right)  $ of
$B$ is given by
\begin{equation}
\mathcal{R}_{e}\left(  B\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)
\end{equation}

\end{proof}

The identity
\begin{equation}
\mathcal{M}_{e}\left(  B^{\dagger}\right)  =\mathcal{M}_{e}\left(  B\right)
^{\dagger}%
\end{equation}
gives
\begin{equation}
\mathcal{R}_{e}\left(  B^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(
B\right)  ^{\dagger}%
\end{equation}
and hence
\begin{equation}
\mathcal{R}_{e}\left(  B^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(
B\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle .
\end{equation}


\begin{theorem}
The $\left\langle \left.  {}\right\vert \right\rangle $-orthonormal
representation $\mathcal{R}_{\widetilde{a}}\left(  B^{\dagger_{A}}\right)  $
wrt a conb $\left\vert \widetilde{\mathbf{a}}\right\rangle $ of the
$\left\langle \left.  {}\right\vert \right\rangle _{A}$ adjoint $B^{\dagger
_{A}}$of $B$ is the same as the representation $\mathcal{R}_{a}\left(
B^{\dagger}\right)  $ wrt a basis $\left(  \mathbf{a}\right)  $ with metric
$A^{\dagger}A$ i.e.%
\begin{equation}
\mathcal{R}_{\widetilde{a}}\left(  B^{\dagger_{A}}\right)  =\mathcal{R}%
_{\widetilde{a}}\left(  A^{\dagger}A\right)  ^{-1}\mathcal{R}_{\widetilde{a}%
}\left(  B^{\dagger}\right)  \mathcal{R}_{\widetilde{a}}\left(  A^{\dagger
}A\right)  ,
\end{equation}
where
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)  .
\end{equation}

\end{theorem}

\begin{proof}%
\begin{equation}
\mathcal{R}_{\widetilde{a}}\left(  A^{\dagger}A\right)  =\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle
\end{equation}


\begin{remark}
If $B$ is self adjoint then
\begin{equation}
B=B^{\dagger}\Leftrightarrow\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)  =\mathcal{M}%
_{e}\left(  B\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\Leftrightarrow\left[  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1},\mathcal{M}_{e}\left(
B\right)  \right]  =0.
\end{equation}

\end{remark}
\end{proof}

\begin{theorem}
Let $\left\vert \mathbf{a}\right\rangle $ be the conjugate vectors of
$A^{\dagger}A$ then%
\begin{equation}
B^{\dagger_{A}}=\left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{R}_{a}\left(
B\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\,\left\langle \mathbf{a}\right\vert .
\end{equation}

\end{theorem}

\begin{proof}%
\begin{align}
B^{\dagger_{A}}  &  =B^{\dagger}A^{\dagger}A=\left(  \left\vert \mathbf{a}%
\right\rangle \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\left\langle \mathbf{a}\right\vert \right)  B^{\dagger
}\left(  \left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert \right)  A^{\dagger}A\left\vert \mathbf{a}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert \\
&  =\left\vert \mathbf{a}\right\rangle \left\langle \left.  \mathbf{a}%
\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{M}_{a}\left(  B^{\dagger
}\right)  \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert A^{\dagger}A\left\vert \mathbf{a}%
\right\rangle \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\left\langle \mathbf{a}\right\vert \\
&  =\left\vert \mathbf{a}\right\rangle \left\langle \left.  \mathbf{a}%
\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{M}_{a}\left(  B^{\dagger
}\right)  \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert \\
&  =\left\vert \mathbf{a}\right\rangle \left\langle \left.  \mathbf{a}%
\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{R}_{a}\left(  B\right)
^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert .
\end{align}

\end{proof}

\begin{notation}
\begin{enumerate}
\item $\left(  \mathbf{a}\right)  $ are abstract vectors, $\left(
\mathrm{a}\right)  $ are numerical vectors i.e. representations,

\item giving resolutions of the identity
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert \equiv I_{\mathbb{C}^{r}}=\left\vert \mathrm{a}\right\rangle
\left\langle \left.  \mathrm{a}\right\vert \mathrm{a}\right\rangle
^{-1}\left\langle \mathrm{a}\right\vert .
\end{equation}


\item Explicitly they are related by
\begin{align}
\mathcal{R}_{e}\left(  A\right)   &  =\mathbb{A}=\left(
\begin{array}
[c]{ccc}%
a_{11} & \cdots & a_{1r}\\
\vdots & \ddots & \vdots\\
a_{n1} & \cdots & a_{rr}%
\end{array}
\right)  \equiv\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
a_{11}\\
\vdots\\
a_{r1}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
a_{1r}\\
\vdots\\
a_{rr}%
\end{array}
\right)
\end{array}
\right)  \equiv\left(
\begin{array}
[c]{ccc}%
\mathrm{a}_{1} & \mathrm{\cdots} & \mathrm{a}_{r}%
\end{array}
\right) \\
\mathrm{a}_{j}  &  =\mathcal{R}_{e}\left(  a_{j}\right) \\
\left\vert \mathbf{a}\right\rangle  &  \equiv\left(  \mathbf{a}\right)
=\left\vert a_{1}\cdots a_{r}\right\rangle \equiv\left(  a_{1}\cdots
a_{r}\right) \\
\left\vert \mathrm{a}\right\rangle  &  \equiv\left(  \mathrm{a}\right)
=\left\vert \mathrm{a}_{1}\mathrm{\cdots a}_{r}\right\rangle \equiv\left(
\mathrm{a}_{1}\mathrm{\cdots a}_{r}\right) \\
a_{j}  &  \in\mathcal{H}^{1},\quad\mathcal{R}_{e}\left(  a_{j}\right)
\in\mathbb{C}^{r},\quad\mathrm{a}_{kj}=\mathcal{R}_{e}\left(  a_{j}\right)
_{k}\in\mathbb{C}.
\end{align}


\item Representations and expansions of vectors and operators
\begin{align}
v  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
v=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{a}%
\right\vert v\right\rangle =\left\vert \mathbf{e}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}%
_{e}\left(  v\right) \\
B  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
B\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert =\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)  \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  B\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \\
B\left\vert \mathbf{e}\right\rangle  &  =\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  B\right) \\
&  \left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
=\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right) \\
\mathcal{R}_{e}\left(  B\right)   &  =\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B\right)  .
\end{align}

\end{enumerate}
\end{notation}

\begin{lemma}
The unitary transformation from the conb $\left\vert \mathbf{e}\right\rangle $
to the conb $\left\vert \mathbf{f}\right\rangle $ can be expressed as the sum
of \emph{partial isometries}
\begin{equation}
u_{fe}=\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert
=\sum_{1\leq j\leq n}\left\vert f_{j}\right\rangle \left\langle e_{j}%
\right\vert
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\sum_{1\leq j\leq n}\left\vert f_{j}\right\rangle \left\langle e_{j}%
\right\vert \left\vert e_{k}\right\rangle =\left\vert f_{k}\right\rangle .
\end{equation}

\end{proof}

\begin{corollary}
\emph{Any unitary transformation can expressed as a sum of partial
isometries.}
\end{corollary}

The unitary transformation
\[
\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert
=u_{fe}\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  u_{fe}\right)
\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\mathcal{M}_{e}\left(  \left\vert \mathbf{f}\right\rangle \left\langle
\mathbf{e}\right\vert \right)  \left\langle \mathbf{e}\right\vert
\]
from the conb $\left\vert \mathbf{e}\right\rangle $ to the conb $\left\vert
\mathbf{f}\right\rangle $ produces the representation
\begin{equation}
\mathcal{R}_{e}\left(  \left\vert \mathbf{f}\right\rangle \left\langle
\mathbf{e}\right\vert \right)  =\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle =\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle =\mathcal{M}_{e}\left(  \left\vert \mathbf{f}%
\right\rangle \left\langle \mathbf{e}\right\vert \right)
\end{equation}
and the inverse transformation from the conb $\left\vert \mathbf{f}%
\right\rangle $ to the conb $\left\vert \mathbf{e}\right\rangle $
\begin{equation}
u_{ef}=\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert
=u_{fe}^{\dagger}%
\end{equation}
gives the representation
\begin{equation}
\mathcal{R}_{f}\left(  \left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{f}\right\vert \right)  =\left\langle \mathbf{f}\right\vert \left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{f}\right\vert \left\vert
\mathbf{f}\right\rangle =\left\langle \mathbf{f}\right\vert \left\vert
\mathbf{e}\right\rangle =\mathcal{M}_{f}\left(  \left\vert \mathbf{e}%
\right\rangle \left\langle \mathbf{f}\right\vert \right)
\end{equation}
so that
\begin{align}
\mathcal{R}_{f}\left(  \left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{f}\right\vert \right)   &  =\mathcal{R}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)  ^{\dagger
}\\
\mathcal{M}_{f}\left(  \left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{f}\right\vert \right)   &  =\mathcal{M}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)  ^{\dagger
}.
\end{align}


\begin{remark}%
\begin{equation}
\mathcal{R}_{f}\left(  \left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{f}\right\vert \right)  =\mathcal{R}_{e}\left(  \left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{f}\right\vert \right)  .
\end{equation}

\end{remark}

and%
\begin{align}
\left\langle \mathbf{e}\right\vert \left(  \overset{}{\left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert }\right)
\left\vert \mathbf{e}\right\rangle  &  =\mathcal{M}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)
=\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle \\
\left\langle \mathbf{f}\right\vert \left(  \overset{}{\left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert }\right)
\left\vert \mathbf{f}\right\rangle  &  =\mathcal{M}_{f}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)
=\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle .
\end{align}
Non singularity of $A^{\dagger},A$ and $A^{\dagger}A$
\begin{equation}
\left(  \ker\left\{  A^{\dagger}A\right\}  =\phi\Leftrightarrow\ker\left\{
A^{\dagger}\right\}  =\phi\Leftrightarrow\ker\left\{  A\right\}  =\phi\right)
\equiv\left(  \ker\left\{  \mathcal{R}_{e}\left(  A\right)  ^{\dagger
}\mathcal{R}_{e}\left(  A\right)  \right\}  =\phi\Leftrightarrow\ker\left\{
\mathcal{R}_{e}\left(  A\right)  ^{\dagger}\right\}  =\phi\Leftrightarrow
\ker\left\{  \mathcal{R}_{e}\left(  A\right)  \right\}  =\phi\right)  ,
\end{equation}
gives
\begin{equation}
A^{\dagger}A\left\vert \alpha_{j}\right\rangle =\sigma_{j}\left\vert
\alpha_{j}\right\rangle ,\quad\sigma_{j}>0,\quad1\leq j\leq r
\end{equation}
and the eigenvectors $\left\{  \left.  \alpha_{j}\right\vert 1\leq j\leq
r\right\}  $ of $A$ can be used as a $\left\langle \left.  {}\right\vert
\right\rangle $-conb for $\mathcal{H}^{1}.$The eigenvectors of $A^{\dagger}A$
are $\left\langle \left.  {}\right\vert \right\rangle _{A}$-orthogonal but not
in general $\left\langle \left.  {}\right\vert \right\rangle _{A}$-normalized
i.e.
\begin{equation}
\left\langle \left.  \alpha_{j}\right\vert \alpha_{k}\right\rangle
_{A}=\left\langle \left.  \alpha_{j}\right\vert A^{\dagger}A\alpha
_{k}\right\rangle =\left\langle \left.  \alpha_{j}\right\vert \sigma_{k\alpha
k}\right\rangle =\sigma_{k}\delta_{jk},\quad1\leq j,k\leq r.
\end{equation}
Transformation $u_{ae}$ from $\left\vert \mathbf{e}\right\rangle $ basis to
$\left\vert \mathbf{\alpha}\right\rangle $ basis can be expanded as a sum of
partial isometries
\begin{equation}
u_{ae}=\sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle \left\langle
e_{j}\right\vert .
\end{equation}
Transformation $u_{ae}^{\dagger}=$ $u_{ea}$ from $\left\vert \mathbf{\alpha
}\right\rangle $ basis to $\left\vert \mathbf{e}\right\rangle $ basis can be
expanded as a sum of partial isometries
\begin{equation}
u_{ae}^{\dagger}=u_{ea}=\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle
\left\langle \alpha_{j}\right\vert .
\end{equation}
The matrix elements of the $\left\vert e\right\rangle $-representation of the
unitary operator $u_{ae}$ are
\begin{equation}
\mathcal{R}_{e}\left(  u_{ae}\right)  _{lk}=\left\langle e_{l}\right\vert
\left(  \sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  \left\vert e_{k}\right\rangle =\left\langle
e_{l}\right\vert \sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle
\delta_{jk}=\left\langle e_{l}\right\vert \left(  \overset{}{\left\vert
\alpha_{k}\right\rangle \left\langle e_{k}\right\vert }\right)  \left\vert
e_{k}\right\rangle =\left\langle e_{l}\right\vert \left\vert \alpha
_{k}\right\rangle =\mathcal{R}_{e}\left(  \alpha_{k}\right)  _{l}.
\end{equation}
Hence the representation $\mathcal{R}_{e}\left(  \left\vert \alpha
_{j}\right\rangle \left\langle e_{j}\right\vert \right)  $ of the partial
isometries $\left\vert \alpha_{j}\right\rangle \left\langle e_{j}\right\vert $
give rise to the columns of the representation of the unitary operator
$u_{ae}$
\begin{equation}
\mathcal{R}_{e}\left(  \left\vert \alpha_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  _{lk}=\left\langle e_{l}\right\vert \left\vert
\alpha_{k}\right\rangle =\mathcal{R}_{e}\left(  \alpha_{k}\right)  _{l}.
\end{equation}
The operator $A^{\dagger}A$ acts on vectors in the following manner
\begin{align}
A^{\dagger}A\left\vert \alpha_{j}\right\rangle  &  =\left\vert \mathbf{e}%
\right\rangle \mathcal{M}_{e}\left(  A^{\dagger}A\right)  \left\langle
\mathbf{e}\right\vert \left\vert \alpha_{j}\right\rangle \\
\left(  \mathcal{M}_{e}\left(  A^{\dagger}A\right)  \left\langle
\mathbf{e}\right\vert \left\vert \alpha_{j}\right\rangle \right)  _{l}  &
=\sum_{1\leq k\leq r}\mathcal{M}_{e}\left(  A^{\dagger}A\right)
_{lk}\mathcal{R}_{e}\left(  \alpha_{j}\right)  _{k}.
\end{align}
The columns of the $\left\vert e\right\rangle $-representation matrix of
$u_{ae}$ wrt $\left\vert \mathbf{e}\right\rangle $ are the $\left\vert
e\right\rangle $-representations $\left\{  \left.  \mathcal{R}_{e}\left(
\alpha_{j}\right)  \right\vert 1\leq j\leq n\right\}  $ of the eigenvectors
$\left\{  \left.  \alpha_{j}\right\vert 1\leq j\leq n\right\}  $ of
$A^{\dagger}A$ i.e.
\begin{equation}
\mathcal{R}_{e}\left(  u_{ae}\right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  u_{ae}\right)  _{11}\\
\vdots\\
\mathcal{R}_{e}\left(  u_{ae}\right)  _{r1}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  u_{ae}\right)  _{1r}\\
\vdots\\
\mathcal{R}_{e}\left(  u_{ae}\right)  _{rr}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  \alpha_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  \alpha_{1}\right)  _{r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  \alpha_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  \alpha_{r}\right)  _{n}%
\end{array}
\right)
\end{array}
\right)  .
\end{equation}
Using the resolutions of the identity $A^{\dagger}A$ can be expanded as
\begin{equation}
A^{\dagger}A=\left\vert \mathbf{\alpha}\right\rangle \left\langle
\mathbf{\alpha}\right\vert A^{\dagger}A\left\vert \mathbf{\alpha}\right\rangle
\left\langle \mathbf{\alpha}\right\vert =\sum_{1\leq j\leq r}\left\vert
\alpha_{j}\right\rangle \left\langle \alpha_{j}\right\vert \sigma_{j}%
=\sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle \sigma_{j}\left\langle
\alpha_{j}\right\vert =\left\vert \mathbf{\alpha}\right\rangle \Sigma
_{A}\left\langle \mathbf{\alpha}\right\vert =\left\vert \mathbf{\alpha
}\right\rangle \mathcal{M}_{\alpha}\left(  A^{\dagger}A\right)  \left\langle
\mathbf{\alpha}\right\vert =\left\vert \mathbf{\alpha}\right\rangle
\mathcal{R}_{\alpha}\left(  A^{\dagger}A\right)  \left\langle \mathbf{\alpha
}\right\vert
\end{equation}
and
\begin{equation}
A^{\dagger}A=\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert A^{\dagger}A\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert \mathcal{R}_{e}\left(  a\right)  _{jk}%
=\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \mathcal{R}_{e}\left(
a\right)  _{jk}\left\langle e_{k}\right\vert =\left\vert \mathbf{e}%
\right\rangle \mathcal{M}_{e}\left(  A^{\dagger}A\right)  \left\langle
\mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  A^{\dagger}A\right)  \left\langle \mathbf{e}\right\vert .
\end{equation}
The eigenvalue problem for $A^{\dagger}A$ can be expressed as
\begin{gather}
A^{\dagger}A\left\vert \alpha_{j}\right\rangle =\sum_{1\leq k\leq r}%
A^{\dagger}A\left\vert e_{k}\right\rangle \mathcal{R}_{e}\left(  \alpha
_{j}\right)  _{k}=\sum_{1\leq k\leq r}\sigma_{j}\left\vert e_{k}\right\rangle
\mathcal{R}_{e}\left(  \alpha_{j}\right)  _{k}=\sum_{1\leq k\leq r}\sigma
_{j}\left\vert e_{k}\right\rangle \left\langle \left.  e_{k}\right\vert
\alpha_{j}\right\rangle \\
=\sum_{1\leq k\leq r}\sigma_{j}\left\vert e_{k}\right\rangle \left\langle
\left.  e_{k}\right\vert \left\vert \alpha_{j}\right\rangle \left\langle
e_{k}\right\vert e_{j}\right\rangle =\sum_{1\leq k\leq r}\sigma_{j}\left\vert
e_{k}\right\rangle \left\langle \left.  e_{k}\right\vert \left\vert \alpha
_{j}\right\rangle \left\langle e_{k}\right\vert e_{j}\right\rangle \\
A^{\dagger}A\left\vert \alpha_{j}\right\rangle =\sum_{1\leq k\leq r}\sigma
_{j}\left\vert e_{k}\right\rangle \left\langle \left.  e_{k}\right\vert
\left\vert \alpha_{j}\right\rangle \left\langle e_{k}\right\vert
e_{j}\right\rangle ,
\end{gather}
which leads to
\begin{equation}
A^{\dagger}Au_{ae}=\sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle
\left\langle \alpha_{j}\right\vert \sigma_{j}\left(  \sum_{1\leq k\leq
r}\left\vert \alpha_{k}\right\rangle \left\langle e_{k}\right\vert \right)
=\sum_{1\leq j,k\leq r}\left\vert \alpha_{j}\right\rangle \left\langle
\alpha_{j}\right\vert \left\vert a_{k}\right\rangle \left\langle
e_{k}\right\vert \sigma_{j}=\sum_{1\leq j,k\leq r}\left\vert \alpha
_{j}\right\rangle \delta_{jk}\left\langle e_{k}\right\vert \sigma_{j}%
=\sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle \left\langle
e_{j}\right\vert \sigma_{j}.
\end{equation}
The representation of the unitary transformation $u_{ae}$ of between the basis
$\left\vert \mathbf{e}\right\rangle $ and $\left\vert \mathbf{\alpha
}\right\rangle $ is
\begin{equation}
\mathcal{R}_{e}\left(  u_{\alpha e}\right)  _{lk}=\left\langle e_{l}%
\right\vert \left(  \sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\rangle
\left\langle e_{j}\right\vert \right)  \left\vert e_{k}\right\rangle
=\left\langle e_{l}\right\vert \sum_{1\leq j\leq r}\left\vert \alpha
_{j}\right\rangle \delta_{jk}=\left\langle e_{l}\right\vert \left(
\overset{}{\left\vert \alpha_{k}\right\rangle \left\langle e_{k}\right\vert
}\right)  \left\vert e_{k}\right\rangle =\left\langle e_{l}\right\vert
\left\vert \alpha_{k}\right\rangle =\mathcal{R}_{e}\left(  \alpha_{k}\right)
_{l}.
\end{equation}
The operator $A^{\dagger}A$ is diagonalized by the unitary transformation
$u_{ae}$ which is shown by
\begin{gather}
A^{\dagger}Au_{ae}=A^{\dagger}A\left(  \sum_{1\leq j\leq r}\left\vert
\alpha_{j}\right\rangle \left\langle e_{j}\right\vert \right)  =\sum_{1\leq
j\leq r}A^{\dagger}A\left\vert \alpha_{j}\right\rangle \left\langle
e_{j}\right\vert =\sum_{1\leq j\leq r}\sigma_{j}\left\vert \alpha
_{j}\right\rangle \left\langle e_{j}\right\vert \\
\Downarrow\\
u_{\alpha e}^{\dagger}A^{\dagger}Au_{\alpha e}=\sum_{1\leq j\leq r}\sigma
_{j}u_{\alpha e}^{\dagger}\left\vert a_{j}\right\rangle \left\langle
e_{j}\right\vert =\sum_{1\leq j\leq r}\sigma_{j}\left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert \\
\Updownarrow\\
u_{\alpha e}\left(  u_{\alpha e}^{\dagger}A^{\dagger}Au_{\alpha e}\right)
u_{\alpha e}^{\dagger}=A^{\dagger}A=\sum_{1\leq j\leq r}\sigma_{j}\left\vert
u_{\alpha e}e_{j}\right\rangle \left\langle u_{\alpha e}e_{j}\right\vert
=\sum_{1\leq j\leq r}\sigma_{j}\left\vert \alpha_{j}\right\rangle \left\langle
\alpha_{j}\right\vert .
\end{gather}


\begin{remark}
\begin{enumerate}
\item
\begin{equation}
A^{\dagger}=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
A^{\dagger}\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert =\left(  \left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \right)  ^{\dagger}=\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\mathcal{R}_{e}\left(  A\right)  ^{\dagger}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(
A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\,\left\langle \mathbf{e}\right\vert .
\end{equation}


\item
\begin{equation}
A^{\dagger}A=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
A^{\dagger}A\right)  \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert =\left(  \left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A^{\dagger}A\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert \right)  ^{\dagger}=\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(  A^{\dagger}A\right)
^{\dagger}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\mathcal{M}_{e}\left(  A^{\dagger}A\right)  ^{\dagger
}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\,\left\langle \mathbf{e}\right\vert .
\end{equation}


\item
\begin{align}
B^{\dagger_{A}}  &  =B^{\dagger}A^{\dagger}A=\left\vert \mathbf{e}%
\right\rangle \mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger}A\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert =\left(  \left\vert \mathbf{e}%
\right\rangle \mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger}A\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert \right)  ^{\dagger}=\left\vert
\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger
}A\right)  ^{\dagger}\left\langle \mathbf{e}\right\vert \\
&  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{M}_{e}\left(  B^{\dagger
}A^{\dagger}A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\,\left\langle \mathbf{e}\right\vert
\end{align}


\item
\begin{equation}
B^{\dagger_{A}}=B^{\dagger}A^{\dagger}A=\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger}A\right)  \left\langle
\mathbf{e}\right\vert =\left(  \left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger}A\right)  \left\langle
\mathbf{e}\right\vert \right)  ^{\dagger}=\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger}A\right)  ^{\dagger}\left\langle
\mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{M}%
_{e}\left(  B^{\dagger}A^{\dagger}A\right)  ^{\dagger}\,\left\langle
\mathbf{e}\right\vert
\end{equation}
hence
\begin{equation}
B^{\dagger_{A}}=\left\vert \mathbf{e}\right\rangle \left(
\overset{}{\mathcal{R}_{e}\left(  B^{\dagger}A^{\dagger}A\right)  \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}}\right)
\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle \left(
\overset{}{\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\mathcal{M}_{e}\left(  B^{\dagger}A^{\dagger}A\right)  ^{\dagger
}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}%
}\right)  \,\left\langle \mathbf{e}\right\vert .
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
The adjoints wrt different inner products have the properties
\begin{equation}
B^{\dagger}=\left\vert \mathbf{a}\right\rangle \mathcal{R}_{a}\left(
B^{\dagger}\right)  \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\left\langle \mathbf{a}\right\vert =\left(  \left\vert
\mathbf{a}\right\rangle \mathcal{R}_{a}\left(  B\right)  \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}%
\right\vert \right)  ^{\dagger}=\left\vert \mathbf{a}\right\rangle
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\mathcal{R}_{a}\left(  B\right)  ^{\dagger}\left\langle \mathbf{a}%
\right\vert =\left\vert \mathbf{a}\right\rangle \left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{M}_{a}\left(
B\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}%
\right\rangle ^{-1}\,\left\langle \mathbf{a}\right\vert .
\end{equation}
and
\begin{align}
B^{\dagger_{A}}  &  =\left\vert \mathbf{a}\right\rangle \mathcal{R}_{a}\left(
B^{\dagger_{A}}\right)  \left\langle \left.  \mathbf{a}\right\vert
\mathbf{a}\right\rangle ^{-1}\left\langle \mathbf{a}\right\vert =\left\vert
\mathbf{a}\right\rangle \mathcal{R}_{a}\left(  B^{\dagger}A^{\dagger}A\right)
\left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert =\left\vert \mathbf{a}\right\rangle
\left(  \mathcal{R}_{a}\left(  B\right)  ^{\dagger}\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\right)  \left\langle
\mathbf{a}\right\vert =\left\vert \mathbf{a}\right\rangle \left(  \left\langle
\left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\mathcal{M}%
_{a}\left(  B\right)  ^{\dagger}\left\langle \left.  \mathbf{a}\right\vert
\mathbf{a}\right\rangle ^{-1}\right)  \,\left\langle \mathbf{a}\right\vert \\
&  =\left(  \left\vert \mathbf{a}\right\rangle \mathcal{R}_{a}\left(
B\right)  \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\left\langle \mathbf{a}\right\vert \right)  ^{\dagger_{A}}=\left\vert
\mathbf{a}\right\rangle \left\langle \left.  \mathbf{a}\right\vert
\mathbf{a}\right\rangle ^{-1}\mathcal{R}_{a}\left(  B\right)  ^{\dagger_{A}%
}\left\langle \mathbf{a}\right\vert =\left\vert \mathbf{a}\right\rangle
\left(  \left\langle \left.  \mathbf{a}\right\vert \mathbf{a}\right\rangle
^{-1}\mathcal{M}_{a}\left(  B\right)  ^{\dagger_{A}}\left\langle \left.
\mathbf{a}\right\vert \mathbf{a}\right\rangle ^{-1}\right)  \,\left\langle
\mathbf{a}\right\vert .
\end{align}

\end{remark}

\begin{remark}
Let $\rho=A^{-1}v$
\begin{equation}
\left\langle \left.  B^{\dagger_{A}}\rho\right\vert w\right\rangle
_{A}=\left\langle \left.  \rho\right\vert A^{\dagger}ABw\right\rangle
=\left\langle \left.  A\rho\right\vert ABw\right\rangle =\left\langle \left.
v\right\vert ABw\right\rangle =\left\langle \left.  B^{\dagger}A^{\dagger
}v\right\vert w\right\rangle
\end{equation}

\end{remark}

\begin{remark}
As%
\begin{equation}
B^{\dagger_{A}}=\left(  A^{\dagger}A\right)  ^{-1}B^{\dagger}\left(
A^{\dagger}A\right)
\end{equation}
one obtains
\begin{equation}
B^{\dagger_{A}}=B^{\dagger}A^{\dagger}A\Rightarrow\left(  A^{\dagger}A\right)
^{\frac{1}{2}}B^{\dagger_{A}}\left(  A^{\dagger}A\right)  ^{-\frac{1}{2}%
}=\left(  A^{\dagger}A\right)  ^{-\frac{1}{2}}B^{\dagger}\left(  A^{\dagger
}A\right)  ^{\frac{1}{2}}.
\end{equation}

\end{remark}

\begin{definition}
Transpose%
\begin{equation}
\left(  \left.  B^{t_{A}}v\right\vert w\right)  _{A}=\left(  \left.
v\right\vert Bw\right)  _{A}=\left(  \left.  v\right\vert A^{t}ABw\right)
\quad\forall w\in\mathcal{H}^{1}\text{ and }v\in\mathcal{H}^{1},
\end{equation}
i.e.
\begin{align}
\left(  \left.  B^{t_{A}}v\right\vert w\right)  _{A}  &  =\left(  \left.
v\right\vert Bw\right)  _{A}=\left(  \left.  v\right\vert A^{t}ABw\right)
=\left(  \left.  \left(  A^{t}AB\right)  ^{\dagger}v\right\vert w\right) \\
B^{t_{A}}  &  =B^{t}A^{t}A.
\end{align}

\end{definition}

\begin{remark}%
\begin{equation}
\mathcal{R}_{e}\left(  X\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\mathcal{M}_{\left\vert \mathbf{e}\right)  }\left(
X\right)
\end{equation}
hence%
\begin{equation}
\mathcal{R}_{e}\left(  X^{t_{A}}\right)  =\mathcal{R}_{e}\left(  X^{t}%
A^{t}A\right)  =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\mathcal{M}_{\left\vert \mathbf{e}\right)  }\left(  X^{t}A^{t}A\right)
=\left(  \mathcal{M}_{\left\vert \mathbf{e}\right)  }\left(  \left\vert
\mathbf{e}\right)  \left(  \mathbf{e}\right\vert \right)  \right)
^{-1}\mathcal{M}_{\left\vert \mathbf{e}\right)  }\left(  X^{t}A^{t}A\right)  .
\end{equation}

\end{remark}

\begin{remark}
The representation $\mathcal{R}_{e}\left(  A\right)  $ of operators
$A\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ are produced by considering
the resolutions of the identity
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \equiv\left(  \longleftarrow\mathbf{e\rightarrow}\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert ,
\end{equation}
and
\begin{equation}
I_{\mathcal{H}^{1}}=\left\vert \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
\equiv\left(  \longleftarrow\mathbf{e\rightarrow}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert ,
\end{equation}
where%
\begin{equation}
A\left(  \longleftarrow\mathbf{e\rightarrow}\right)  =\left(  \longleftarrow
\mathbf{e\rightarrow}\right)  \mathcal{R}_{e}\left(  A\right)
\end{equation}
giving
\begin{align}
A  &  =\left\langle \mathbf{e}\right\vert A\left(  \longleftarrow
\mathbf{e\rightarrow}\right)  =\left\langle \left.  \mathbf{e}\right\vert
A\mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A\right) \\
A  &  =\left(  \mathbf{e}\right\vert A\left(  \longleftarrow
\mathbf{e\rightarrow}\right)  =\left(  \left.  \mathbf{e}\right\vert
A\mathbf{e}\right)  =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
\mathcal{R}_{e}\left(  A\right)  .
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \left.  A^{t}\mathbf{e}\right\vert \mathbf{e}\right)  =\left(  \left.
\mathbf{e}\right\vert A\mathbf{e}\right)  =\left(  \left.  A\mathbf{e}%
\right\vert \mathbf{e}\right)  =\left(  \left.  \mathbf{e}\right\vert
A^{t}\mathbf{e}\right)  .
\end{equation}

\end{remark}

\begin{lemma}
The transpose and adjoints of the matrices $\mathcal{M}_{\left(  e\right)
}\left(  A\right)  $ and $\mathcal{M}_{\left\langle e\right\rangle }\left(
A\right)  $ of operators $A\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ wrt
the forms $\left(  \left.  {}\right\vert \right)  $ and $\left\langle \left.
{}\right\vert \right\rangle $ have the property
\begin{equation}
\mathcal{M}_{\left\vert e\right)  }\left(  A^{t}\right)  =\left(  \left.
\mathbf{e}\right\vert A^{t}\mathbf{e}\right)  =\left(  \left.  \mathbf{e}%
\right\vert A\mathbf{e}\right)  ^{t}=\mathcal{M}_{\left\vert e\right)
}\left(  A\right)  ^{t}%
\end{equation}
and
\begin{equation}
\mathcal{M}_{\left\vert e\right\rangle }\left(  A^{\dagger}\right)
=\left\langle \left.  \mathbf{e}\right\vert A^{\dagger}\mathbf{e}\right\rangle
=\left\langle \left.  \mathbf{e}\right\vert A\mathbf{e}\right\rangle
^{\dagger}=\mathcal{M}_{\left\vert e\right\rangle }\left(  A\right)
^{\dagger}.
\end{equation}

\end{lemma}

\begin{proof}
\begin{enumerate}
\item
\begin{align}
\mathcal{M}_{\left\vert e\right)  }\left(  A\right)  _{jk}  &  =\left(
\left.  \mathbf{e}\right\vert A\mathbf{e}\right)  _{jk}=\left(  \left.
e_{j}\right\vert Ae_{k}\right) \\
\left(  \left.  \mathbf{e}\right\vert A^{t}\mathbf{e}\right)  _{jk}  &
=\left(  \left.  e_{j}\right\vert A^{t}e_{k}\right)  =\left(  \left.
Ae_{j}\right\vert e_{k}\right)  =\left(  \left.  e_{k}\right\vert
Ae_{j}\right)  =\left(  \left.  \mathbf{e}\right\vert A\mathbf{e}\right)
_{kj}=\left(  \left.  \mathbf{e}\right\vert A\mathbf{e}\right)  _{jk}^{t}%
\end{align}


\item
\begin{align}
\mathcal{M}_{\left\vert e\right\rangle }\left(  A\right)  _{jk}  &
=\left\langle \left.  \mathbf{e}\right\vert A\mathbf{e}\right\rangle
_{jk}=\left\langle \left.  e_{j}\right\vert Ae_{k}\right\rangle \\
\left\langle \left.  \mathbf{e}\right\vert A^{\dagger}\mathbf{e}\right\rangle
_{jk}  &  =\left\langle \left.  e_{j}\right\vert A^{\dagger}e_{k}\right\rangle
=\left\langle \left.  Ae_{j}\right\vert e_{k}\right\rangle =\overline
{\left\langle \left.  e_{k}\right\vert Ae_{j}\right\rangle }=\overline
{\left\langle \left.  \mathbf{e}\right\vert A\mathbf{e}\right\rangle _{kj}%
}=\left\langle \left.  \mathbf{e}\right\vert A\mathbf{e}\right\rangle
_{jk}^{\dagger}.
\end{align}

\end{enumerate}
\end{proof}

\begin{remark}
Representation of $A\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ in terms
of the form matrices
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
A\mathbf{e}\right\rangle =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}\left(  \left.  \mathbf{e}\right\vert A\mathbf{e}\right)  .
\end{equation}

\end{remark}

\begin{lemma}
Representations of the transpose and adjoint in terms of the transpose and
adjoints of their representations
\begin{equation}
\mathcal{R}_{e}\left(  A^{t}\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(
A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
A\mathbf{e}\right\rangle =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}\left(  \left.  \mathbf{e}\right\vert A\mathbf{e}\right)
\end{equation}


\begin{enumerate}
\item The operator $A$ has the resolution
\begin{align}
A  &  =\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert A\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert \\
A\left(  \mathbf{e}\right)   &  =\left\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A\right)  =\left(  \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
A\left\vert \mathbf{e}\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left(  \mathbf{e}\right\vert \left\vert
\mathbf{e}\right)  =\left(  \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left(  \mathbf{e}%
\right\vert A\left\vert \mathbf{e}\right)
\end{align}
hence the transpose $\mathcal{R}_{e}\left(  A\right)  ^{t}$ of the
representation $\mathcal{R}_{e}\left(  A\right)  $ of $A$ satisfies
\begin{align}
\mathcal{R}_{e}\left(  A\right)  ^{t}  &  =\left(  \mathbf{e}\right\vert
A\left\vert \mathbf{e}\right)  ^{t}\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}=\left(  \mathbf{e}\right\vert A^{t}\left\vert
\mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\\
\left(  \mathbf{e}\right\vert A^{t}\left\vert \mathbf{e}\right)   &
=\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  .
\end{align}
The operator $A^{t}$ has the resolution%
\begin{equation}
A^{t}=\left(  \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert A^{t}\left\vert
\mathbf{e}\right\rangle \left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}\left(  \mathbf{e}\right\vert
\end{equation}
and resolution
\begin{equation}
A^{t}\left(  \mathbf{e}\right)  =\left(  \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A^{t}\right)  =\left(  \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
A^{t}\left\vert \mathbf{e}\right\rangle \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert \left\vert
\mathbf{e}\right)  =\left(  \mathbf{e}\right)  \left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
A^{t}\left\vert \mathbf{e}\right)
\end{equation}
showing that
\begin{equation}
\mathcal{R}_{e}\left(  A^{t}\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert A^{t}\left\vert
\mathbf{e}\right)  =\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  .
\end{equation}


\item The operator $A$ has the resolution wrt any basis $\left(
\mathbf{e}\right)  $
\begin{align}
A  &  =\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
A\left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \\
A\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A\right)  =\left(  \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert A\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{e}\right\rangle =\left(  \mathbf{e}\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert A\left\vert \mathbf{e}\right\rangle
\end{align}
hence the adjoint $\mathcal{R}_{e}\left(  A\right)  ^{\dagger}$ of the
representation $\mathcal{R}_{e}\left(  A\right)  $ of $A$ satisfies
\begin{align}
\mathcal{R}_{e}\left(  A\right)  ^{\dagger}  &  =\left\langle \mathbf{e}%
\right\vert A\left\vert \mathbf{e}\right\rangle ^{\dagger}\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}=\left\langle
\mathbf{e}\right\vert A^{\dagger}\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\\
\left\langle \mathbf{e}\right\vert A^{\dagger}\left\vert \mathbf{e}%
\right\rangle  &  =\mathcal{R}_{e}\left(  A\right)  ^{\dagger}\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle .
\end{align}
The operator $A^{\dagger}$ has both the resolution%
\begin{equation}
A^{\dagger}=\left(  \mathbf{e}\right)  \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
A^{\dagger}\left\vert \mathbf{e}\right\rangle \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert
\end{equation}
and
\begin{equation}
A^{\dagger}\left(  \mathbf{e}\right)  =\left(  \mathbf{e}\right)
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left(  \mathbf{e}\right)
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}\left\langle \mathbf{e}\right\vert A^{\dagger}\left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \left\vert
\mathbf{e}\right\rangle =\left(  \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert A^{\dagger}\left\vert \mathbf{e}\right\rangle
\end{equation}
showing that
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}%
\right\vert A^{\dagger}\left\vert \mathbf{e}\right\rangle =\left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}%
_{e}\left(  A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle .
\end{equation}

\end{enumerate}
\end{proof}

\begin{remark}
The transformation between $\left\langle \left.  {}\right\vert \right\rangle $
and $\left(  \left.  {}\right\vert \right)  $ complete basis
\begin{align}
\left\vert \mathbf{e}\right)   &  =\left(  \left\vert \mathbf{e}\right)
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(
\mathbf{e}\right\vert \right)  \left\vert \mathbf{e}\right\rangle \\
\left\vert \mathbf{e}\right\rangle  &  =\left(  \left\vert \mathbf{e}%
\right\rangle \left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right)  \left\vert
\mathbf{e}\right)
\end{align}
and by definition
\begin{align}
\left(  \mathbf{e}\right\vert  &  =\left\vert \mathbf{e}\right)  ^{t}=\left(
\mathbf{e}\right)  ^{t}\\
\left\langle \mathbf{e}\right\vert  &  =\left\vert \mathbf{e}\right\rangle
^{\dagger}=\left(  \mathbf{e}\right)  ^{\dagger}%
\end{align}
hence
\begin{align}
\left(  \mathbf{e}\right\vert  &  =\left(  \mathbf{e}\right\vert \left(
\left\vert \mathbf{e}\right)  \left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert \right) \\
\left\langle \mathbf{e}\right\vert  &  =\left\langle \mathbf{e}\right\vert
\left(  \left\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert
\right)  .
\end{align}

\end{remark}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{e}\left(  e_{j}\right)  =\mathcal{R}_{e}\left(  \left\vert
e_{j}\right)  \right)  =\mathcal{R}_{e}\left(  \left\vert e_{j}\right\rangle
\right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  e_{j}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  e_{j}\right)  _{r}%
\end{array}
\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \left(  e_{j}\right\vert \right)  =\mathcal{R}%
_{e}\left(  \left\vert e_{j}\right)  ^{t}\right)  =\mathcal{R}_{e}\left(
\left\vert e_{j}\right)  \right)  ^{t}=\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  e_{j}\right)  _{1} & \cdots & \mathcal{R}_{e}\left(
e_{j}\right)  _{r}%
\end{array}
\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \left\langle e_{j}\right\vert \right)  =\mathcal{R}%
_{e}\left(  \left\vert e_{j}\right\rangle ^{\dagger}\right)  =\mathcal{R}%
_{e}\left(  \left\vert e_{j}\right\rangle \right)  ^{\dagger}=\left(
\begin{array}
[c]{ccc}%
\overline{\mathcal{R}_{e}\left(  e_{j}\right)  _{1}} & \cdots & \overline
{\mathcal{R}_{e}\left(  e_{j}\right)  _{r}}%
\end{array}
\right)  .
\end{equation}


\item
\begin{align}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle  &
=\left\langle \left.  \mathcal{R}_{e}\left(  \mathbf{e}\right)  \right\vert
\mathcal{R}_{e}\left(  \mathbf{e}\right)  \right\rangle =\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  \mathcal{R}_{e}\left(  e_{1}\right)  \right\vert
\mathcal{R}_{e}\left(  e_{1}\right)  \right\rangle  & \cdots & \left\langle
\left.  \mathcal{R}_{e}\left(  e_{1}\right)  \right\vert \mathcal{R}%
_{e}\left(  e_{r}\right)  \right\rangle \\
\vdots & \ddots & \vdots\\
\left\langle \left.  \mathcal{R}_{e}\left(  e_{r}\right)  \right\vert
\mathcal{R}_{e}\left(  e_{1}\right)  \right\rangle  & \cdots & \left\langle
\left.  \mathcal{R}_{e}\left(  e_{r}\right)  \right\vert \mathcal{R}%
_{e}\left(  e_{r}\right)  \right\rangle
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\sum\limits_{1\leq j\leq r}\overline{\mathcal{R}_{e}\left(  e_{1}\right)
_{j}}\mathcal{R}_{e}\left(  e_{1}\right)  _{j} & \cdots & \sum\limits_{1\leq
j\leq r}\overline{\mathcal{R}_{e}\left(  e_{1}\right)  _{j}}\mathcal{R}%
_{e}\left(  e_{r}\right)  _{j}\\
\vdots & \ddots & \vdots\\
\sum\limits_{1\leq j\leq r}\overline{\mathcal{R}_{e}\left(  e_{r}\right)
_{j}}\mathcal{R}_{e}\left(  e_{1}\right)  _{j} & \cdots & \sum\limits_{1\leq
j\leq r}\overline{\mathcal{R}_{e}\left(  e_{r}\right)  _{j}}\mathcal{R}%
_{e}\left(  e_{r}\right)  _{j}%
\end{array}
\right)  .
\end{align}


\item
\begin{align}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)   &  =\left(  \left.
\mathcal{R}_{e}\left(  \mathbf{e}\right)  \right\vert \mathcal{R}_{e}\left(
\mathbf{e}\right)  \right)  =\left(
\begin{array}
[c]{ccc}%
\left(  \left.  \mathcal{R}_{e}\left(  e_{1}\right)  \right\vert
\mathcal{R}_{e}\left(  e_{1}\right)  \right)  & \cdots & \left(  \left.
\mathcal{R}_{e}\left(  e_{1}\right)  \right\vert \mathcal{R}_{e}\left(
e_{r}\right)  \right) \\
\vdots & \ddots & \vdots\\
\left(  \left.  \mathcal{R}_{e}\left(  e_{r}\right)  \right\vert
\mathcal{R}_{e}\left(  e_{1}\right)  \right)  & \cdots & \left(  \left.
\mathcal{R}_{e}\left(  e_{r}\right)  \right\vert \mathcal{R}_{e}\left(
e_{r}\right)  \right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\sum\limits_{1\leq j\leq r}\mathcal{R}_{e}\left(  e_{1}\right)  _{j}%
\mathcal{R}_{e}\left(  e_{1}\right)  _{j} & \cdots & \sum\limits_{1\leq j\leq
r}\mathcal{R}_{e}\left(  e_{1}\right)  _{j}\mathcal{R}_{e}\left(
e_{r}\right)  _{j}\\
\vdots & \ddots & \vdots\\
\sum\limits_{1\leq j\leq r}\mathcal{R}_{e}\left(  e_{r}\right)  _{j}%
\mathcal{R}_{e}\left(  e_{1}\right)  _{j} & \cdots & \sum\limits_{1\leq j\leq
r}\mathcal{R}_{e}\left(  e_{r}\right)  _{j}\mathcal{R}_{e}\left(
e_{r}\right)  _{j}%
\end{array}
\right)  .
\end{align}

\end{enumerate}
\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{R}_{e}\left(  \left(  \mathbf{e}\right)  \right)  =\mathcal{R}%
_{e}\left(  \left\vert \mathbf{e}\right\rangle \right)  =\mathcal{R}%
_{e}\left(  \left\vert \mathbf{e}\right)  \right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  e_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  e_{1}\right)  _{r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  e_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  e_{r}\right)  _{r}%
\end{array}
\right)
\end{array}
\right)
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\left(  \left.  e_{j}\right\vert e_{k}\right)   &  =\left(  \left.
\mathcal{R}_{e}\left(  e_{j}\right)  \right\vert \mathcal{R}_{e}\left(
e_{k}\right)  \right)  =\operatorname{Tr}\left\{  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  e_{j}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  e_{j}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  e_{k}\right)  _{1} & \cdots & \mathcal{R}_{e}\left(
e_{k}\right)  _{r}%
\end{array}
\right)  \right\}  =\mathcal{R}_{e}\left(  e_{j}\right)  ^{t}\mathcal{R}%
_{e}\left(  e_{k}\right) \\
\left\langle \left.  e_{k}\right\vert e_{k}\right\rangle  &  =\left\langle
\left.  \mathcal{R}_{e}\left(  e_{k}\right)  \right\vert \mathcal{R}%
_{e}\left(  e_{k}\right)  \right\rangle ==\operatorname{Tr}\left\{  \left(
\begin{array}
[c]{c}%
\overline{\mathcal{R}_{e}\left(  e_{j}\right)  _{1}}\\
\vdots\\
\overline{\mathcal{R}_{e}\left(  e_{j}\right)  _{r}}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  e_{k}\right)  _{1} & \cdots & \mathcal{R}_{e}\left(
e_{k}\right)  _{r}%
\end{array}
\right)  \right\}  =\mathcal{R}_{e}\left(  e_{j}\right)  ^{\dagger}%
\mathcal{R}_{e}\left(  e_{k}\right)
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  =\mathcal{R}%
_{e}\left(  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  \right)
=\left(  \left.  \mathcal{R}_{e}\left(  \mathbf{e}\right)  \right\vert
\mathcal{R}_{e}\left(  \mathbf{e}\right)  \right)  =\mathcal{R}_{e}\left(
\left(  \mathbf{e}\right)  \right)  ^{t}\mathcal{R}_{e}\left(  \left(
\mathbf{e}\right)  \right)
\end{equation}
and%
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\mathcal{R}_{e}\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle \right)  =\left\langle \left.  \mathcal{R}_{e}\left(
\mathbf{e}\right)  \right\vert \mathcal{R}_{e}\left(  \mathbf{e}\right)
\right\rangle =\mathcal{R}_{e}\left(  \left(  \mathbf{e}\right)  \right)
^{\dagger}\mathcal{R}_{e}\left(  \left(  \mathbf{e}\right)  \right)  ,
\end{equation}
where $\mathcal{R}_{e}\left(  \left(  \mathbf{e}\right)  \right)
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  .$
\end{remark}

\begin{remark}
Matrix representations of resolution of identities

\begin{enumerate}
\item
\begin{equation}
\mathbb{I}_{r}=\mathcal{R}_{e}\left(  I_{\mathcal{H}^{1}}\right)
=\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right\rangle \left\langle
\left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\left\langle
\mathbf{e}\right\vert \right)  =\mathcal{R}_{e}\left(  \left\vert
\mathbf{e}\right\rangle \right)  \mathcal{R}_{e}\left(  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\right)  \mathcal{R}%
_{e}\left(  \left\langle \mathbf{e}\right\vert \right)  =\mathcal{R}%
_{e}\left(  \left\vert \mathbf{e}\right\rangle \right)  \left(  \mathcal{R}%
_{e}\left(  \overset{}{\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle }\right)  \right)  ^{-1}\mathcal{R}_{e}\left(
\left\vert \mathbf{e}\right\rangle \right)  ^{\dagger}%
\end{equation}


\item
\begin{equation}
\mathbb{I}_{r}=\mathcal{R}_{e}\left(  I_{\mathcal{H}^{1}}\right)
=\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right)  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \mathbf{e}\right\vert
\right)  =\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right)  \right)
\mathcal{R}_{e}\left(  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  ^{-1}\right)  \mathcal{R}_{e}\left(  \left(  \mathbf{e}\right\vert
\right)  =\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right)  \right)
\left(  \mathcal{R}_{e}\left(  \overset{}{\left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  }\right)  \right)  ^{-1}\mathcal{R}_{e}\left(
\left\vert \mathbf{e}\right)  \right)  ^{t}%
\end{equation}


\item Note that

\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right\rangle \right)
=\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right)  \right)  =\mathcal{R}%
_{e}\left(  \left(  \mathbf{e}\right)  \right)  ,
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle \right)  =\mathcal{R}_{e}\left(  \left\vert
\mathbf{e}\right\rangle \right)  ^{\dagger}\mathcal{R}_{e}\left(  \left\vert
\mathbf{e}\right\rangle \right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}%
\right)  \right)  =\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right)
\right)  ^{t}\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right)  \right)
\end{equation}
but in general

\item
\begin{equation}
\mathcal{R}_{e}\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle \right)  \neq\mathcal{R}_{e}\left(  \left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  \right)  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{corollary}
For $\left\vert \mathbf{e}\right\rangle $-conb's and $\left\vert
\mathbf{e}\right)  $-conb's
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\,\mathcal{R}_{e}\left(  A\right)
^{\dagger},
\end{equation}
and
\begin{equation}
\mathcal{R}_{e}\left(  A^{t}\right)  =\,\mathcal{R}_{e}\left(  A\right)  ^{t}.
\end{equation}

\end{corollary}

\begin{remark}
The values $\left\langle \left.  u\right\vert v\right\rangle $ and $\left(
\left.  u\right\vert v\right)  $ do not depend on the choice of conb $\left(
\mathbf{e}\right)  \equiv\left(  \longleftarrow\mathbf{e\rightarrow}\right)
.$
\end{remark}

\subsubsection{Invariance Groups \label{Invariance Groups}}

\begin{definition}
Invariance Groups:The groups $U\left(  \mathcal{H}^{1}\right)  $ and $O\left(
\mathcal{H}^{1},\mathbb{C}\right)  $ leave $\left\langle \left.  {}\right\vert
\right\rangle $ and $\left(  \left.  {}\right\vert \right)  $ invariant
respectively i.e.%
\begin{align}
\left\langle \left.  u\left(  a\right)  \right\vert u\left(  b\right)
\right\rangle  &  =\left\langle \left.  a\right\vert b\right\rangle ,\quad
a,b\in\mathcal{H}^{1},\quad u\in U\left(  \mathcal{H}^{1}\right) \\
\left(  \left.  v\left(  a\right)  \right\vert v\left(  b\right)  \right)   &
=\left(  \left.  a\right\vert b\right)  ,\quad a,b\in\mathcal{H}^{1},\quad
v\in O\left(  \mathcal{H}^{1},\mathbb{C}\right)  .
\end{align}

\end{definition}

\begin{lemma}%
\begin{equation}
u\in U\left(  \mathcal{H}^{1}\right)  \Longleftrightarrow u^{\dagger
}u=uu^{\dagger}=I_{\mathcal{H}^{1}}.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left\langle \left.  u\left(  a\right)  \right\vert u\left(  b\right)
\right\rangle =\left\langle \left.  u^{\dagger}u\left(  a\right)  \right\vert
b\right\rangle =\left\langle \left.  a\right\vert b\right\rangle ,\forall
a,b\in\mathcal{H}^{1}%
\end{equation}
and left inverses equals right inverses.
\end{proof}

\begin{lemma}%
\begin{equation}
v\in O\left(  \mathcal{H}^{1},\mathbb{C}\right)  \Longleftrightarrow
v^{t}v=vv^{t}=I_{\mathcal{H}^{1}}.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left(  \left.  v\left(  a\right)  \right\vert v\left(  b\right)  \right)
=\left(  \left.  v^{t}v\left(  a\right)  \right\vert b\right)  =\left(
\left.  a\right\vert b\right)  ,\forall a,b\in\mathcal{H}^{1}%
\end{equation}
and left inverses equals right inverses.
\end{proof}

\begin{remark}
If $r=2s$%
\begin{equation}
U\left(  \mathcal{H}^{1}\right)  \cap O\left(  \mathcal{H}^{1},\mathbb{C}%
\right)  =O\left(  \mathcal{H}^{1},\mathbb{R}\right)
\end{equation}
and
\begin{equation}
O\left(  \mathcal{H}^{1},\mathbb{R}\right)  \cong O\left(  2s,\mathbb{R}%
\right)  .
\end{equation}

\end{remark}

\begin{remark}
By definition
\begin{equation}
O\left(  \mathcal{H}^{1},\mathbb{R}\right)  \subset O\left(  \mathcal{H}%
^{1},\mathbb{C}\right)  \text{ and }O\left(  \mathcal{H}^{1},\mathbb{R}%
\right)  \subset U\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{remark}

\begin{remark}
In the case of the Hilbert space $\mathcal{F}_{1}$ i.e. replacing
$\mathcal{H}^{1}$ by $\mathcal{F}_{1},$ where
\begin{equation}
\mathcal{F}_{1}\cong\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\end{equation}
one obtains the real orthogonal group
\begin{equation}
O\left(  \mathcal{F}_{1},\mathbb{R}\right)  \cong O\left(  2r,\mathbb{R}%
\right)
\end{equation}
that is constituted by canonical transformations $\in O\left(  2r,\mathbb{R}%
\right)  \subset U\left(  2r\right)  $ i.e. unitary transformations that
preserve the CAR, while the complex orthogonal group $O\left(  \mathcal{F}%
_{1},\mathbb{C}\right)  \cong O\left(  2r,\mathbb{C}\right)  $ is constituted
by transformations that preserve the complex Clifford Algebra structure of
$\mathcal{F}$.
\end{remark}

\begin{remark}
If $\left\vert \mathbf{e}\right\rangle $ is a $\left\langle \left.
{}\right\vert \right\rangle $-conb so is $\left\vert u\mathbf{e}\right\rangle
\equiv u\left\vert \mathbf{e}\right\rangle $ for $u\in U\left(  \mathcal{H}%
^{1}\right)  $ i.e. all $\left\langle \left.  {}\right\vert \right\rangle
$-conbs of $\mathcal{H}^{1}$ are contained in the orbit
\begin{equation}
\mathfrak{O}\left\{  U\left(  \mathcal{H}^{1}\right)  \right\}  =\left\{
\left.  \left\vert u\mathbf{e}\right\rangle \right\vert u\in U\left(
\mathcal{H}^{1}\right)  ,\left\vert \mathbf{e}\right\rangle \text{ any
}\left\langle \left.  {}\right\vert \right\rangle \text{-conb of }%
\mathcal{H}^{1}\right\}  ,
\end{equation}
which is also a $U\left(  \mathcal{H}^{1}\right)  $-homogeneous manifold.
\end{remark}

\begin{remark}
If $\left\vert \mathbf{f}\right)  $ is a $\left(  \left.  {}\right\vert
\right)  $-conb so is $\left\vert v\mathbf{f}\right)  \equiv v\left\vert
\mathbf{f}\right)  $ for $v\in O\left(  \mathcal{H}^{1},\mathbb{C}\right)  $
i.e. all $\left(  \left.  {}\right\vert \right)  $-conbs of $\mathcal{H}^{1}$
are contained in the orbit
\begin{equation}
\mathfrak{O}\left\{  O\left(  \mathcal{H}^{1},\mathbb{C}\right)  \right\}
=\left\{  \left.  \left\vert u\mathbf{f}\right\rangle \right\vert u\in
U\left(  \mathcal{H}^{1}\right)  ,\left\vert \mathbf{f}\right\rangle \text{
any }\left(  \left.  {}\right\vert \right)  \text{-conb of }\mathcal{H}%
^{1}\right\}  ,
\end{equation}
which is also a $O\left(  \mathcal{H}^{1},\mathbb{R}\right)  $-homogeneous manifold.
\end{remark}

\begin{remark}
The bases contained in the orbits $\mathfrak{O}\left\{  U\left(
\mathcal{H}^{1}\right)  \right\}  $ and $\mathfrak{O}\left\{  O\left(
\mathcal{H}^{1},\mathbb{C}\right)  \right\}  $ are bases of $\mathcal{H}^{1}$
i.e.
\begin{equation}
\left\vert \mathbf{e}\right\rangle =\left(  \mathbf{e}\right)  \text{ and
}\left\vert \mathbf{f}\right\rangle =\left(  \mathbf{f}\right)  .
\end{equation}

\end{remark}

\begin{remark}
In $\mathbb{C}^{r}$ the basis $\left(  \overset{}{\mathcal{R}_{b}\left(
\mathbf{b}\right)  }\right)  =\left\{  \left(
\begin{array}
[c]{c}%
1\\
0\\
\vdots\\
0
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
1
\end{array}
\right)  \right\}  $ is both a $\left\langle \left.  {}\right\vert
\right\rangle $-conb and $\left(  \left.  {}\right\vert \right)  $-conb, hence
both the orbits $\mathcal{R}_{b}\left\{  \mathfrak{O}\left\{
\overset{}{U\left(  \mathcal{H}^{1}\right)  }\right\}  \right\}  $ and
$\mathcal{R}_{b}\left\{  \mathfrak{O}\left\{  \overset{}{O\left(
\mathcal{H}^{1},\mathbb{C}\right)  }\right\}  \right\}  $ can be generated
from the single basis $\left(  \overset{}{\mathcal{R}_{b}\left(
\mathbf{b}\right)  }\right)  .$
\end{remark}

\begin{remark}%
\begin{equation}
b_{j}=\left(  \longleftarrow\mathbf{b\rightarrow}\right)  \mathcal{R}%
_{b}\left(  b_{j}\right)  =\left(  \longleftarrow\mathbf{b\rightarrow}\right)
\left(
\begin{array}
[c]{c}%
\vdots\\
\delta_{jk}\\
\vdots
\end{array}
\right)  ,\quad1\leq k\leq2r;\quad1\leq j\leq2r
\end{equation}

\end{remark}

\subsubsection{Distinct Complex Conjugations
\label{Distinct Complex Conjugations}}

\begin{remark}
Complex conjugations $\sigma_{b}\in\mathcal{B}_{anti}\left(  \mathcal{H}%
^{1}\right)  $ \emph{are} invariant to $O\left(  \mathcal{H}^{1}%
,\mathbb{R}\right)  ,$ \emph{but not} to $\frac{O\left(  \mathcal{H}%
^{1},\mathbb{C}\right)  }{O\left(  \mathcal{H}^{1},\mathbb{R}\right)  }$ nor
$\frac{U\left(  \mathcal{H}^{1}\right)  }{O\left(  \mathcal{H}^{1}%
,\mathbb{R}\right)  }$ or in general $\frac{GL\left(  \mathcal{H}^{1}\right)
}{O\left(  \mathcal{H}^{1},\mathbb{R}\right)  }$ i.e.
\begin{equation}
o\left(  \sigma_{b}\right)  =\sigma_{b},\quad o\in O\left(  \mathcal{H}%
^{1},\mathbb{R}\right)  ,
\end{equation}
thus they are both $\left\langle \left.  {}\right\vert \right\rangle $ and
$\left(  \left.  {}\right\vert \right)  $ invariant.
\end{remark}

\begin{remark}
The set of all distinct complex conjugations is thus generated by
\begin{equation}
\left\{  \left.  \overset{}{c\left(  \sigma_{b}\right)  }\right\vert c\in
\frac{GL\left(  \mathcal{H}^{1}\right)  }{O\left(  \mathcal{H}^{1}%
,\mathbb{R}\right)  },\text{ where }\left(  \mathbf{b}\right)  \text{ is a
fixed basis of }\mathcal{H}^{1}\right\}  .
\end{equation}

\end{remark}

\begin{remark}
$O\left(  \mathcal{H}^{1},\mathbb{R}\right)  $ generates equivalence classes
$\left[  \mathbf{b}\right]  _{\left\langle \left.  {}\right\vert \right\rangle
}$ and $\left[  \mathbf{b}\right]  _{\left(  \left.  {}\right\vert \right)  }$
of the orbits $\mathfrak{O}\left\{  U\left(  \mathcal{H}^{1}\right)  \right\}
$ and $\mathfrak{O}\left\{  O\left(  \mathcal{H}^{1},\mathbb{C}\right)
\right\}  $ by the equivalence relationships
\begin{equation}
\left(  \mathbf{b}\right)  \overset{O\left(  \mathcal{H}^{1},\mathbb{R}%
\right)  }{{\Huge \backsim}}\left(  \mathbf{b}^{\prime}\right)
\Longleftrightarrow\mathbf{b}=o\mathbf{b}^{\prime},o\in O\left(
\mathcal{H}^{1},\mathbb{R}\right)  .
\end{equation}

\end{remark}

\begin{remark}
One can always construct a $\left(  \left.  {}\right\vert \right)  $-conb from
a $\left\langle \left.  {}\right\vert \right\rangle $-conb by
orthonormalization e.g. let
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
=\mathbb{I}_{r}%
\end{equation}
then
\begin{equation}
\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  =\mathbb{I}_{r},
\end{equation}
where
\begin{equation}
\mathbf{f}=\left(  \mathbf{f}\right)  =V_{\left(  \left.  e\right\vert
e\right)  }\left(  \mathbf{e}\right)  .
\end{equation}
Hence
\begin{equation}
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle =V_{\left(
\left.  e\right\vert e\right)  }^{\dagger}V_{\left(  \left.  e\right\vert
e\right)  }.
\end{equation}

\end{remark}

\begin{remark}
recall%
\begin{equation}
\mathcal{R}_{e}\left(  A^{t}\right)  =\left(  \left.  \mathbf{e}\right\vert
\mathbf{e}\right)  ^{-1}\mathcal{R}_{e}\left(  A\right)  ^{t}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{e}\left(  A^{\dagger}\right)  =\left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\mathcal{R}_{e}\left(
A\right)  ^{\dagger}\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ,
\end{equation}
If
\begin{equation}
\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  =\mathbb{I}_{r}%
\end{equation}
then
\begin{equation}
\mathcal{R}_{f}\left(  A^{t}\right)  =\mathcal{R}_{f}\left(  A\right)  ^{t}%
\end{equation}
and
\begin{equation}
\mathcal{R}_{f}\left(  A^{\dagger}\right)  =\left\langle \left.
\mathbf{f}\right\vert \mathbf{f}\right\rangle ^{-1}\mathcal{R}_{f}\left(
A\right)  ^{\dagger}\left\langle \left.  \mathbf{f}\right\vert \mathbf{f}%
\right\rangle =\left(  V_{\left(  \left.  e\right\vert e\right)  }^{\dagger
}V_{\left(  \left.  e\right\vert e\right)  }\right)  ^{-1}\mathcal{R}%
_{f}\left(  A\right)  ^{\dagger}\left(  V_{\left(  \left.  e\right\vert
e\right)  }^{\dagger}V_{\left(  \left.  e\right\vert e\right)  }\right)  .
\end{equation}

\end{remark}

\begin{remark}
If
\begin{equation}
\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  =\mathbb{I}_{r}%
\end{equation}
then
\begin{equation}
\left(  \left.  o\mathbf{f}\right\vert o\mathbf{f}\right)  =\left(  \left.
\mathbf{f}\right\vert o^{t}o\mathbf{f}\right)  =\left(  \left.  \mathbf{f}%
\right\vert oo^{t}\mathbf{f}\right)  =\mathbb{I}_{r}%
\end{equation}
and
\begin{equation}
\left(  \left.  o\mathbf{f}\right\vert o\mathbf{f}\right)  =\mathbb{O}%
^{t}\left(  \left.  \mathbf{f}\right\vert \mathbf{f}\right)  \mathbb{O}%
=\mathbb{O}^{t}\mathbb{O}=\mathbb{OO}^{t}=\mathbb{I}_{r}%
\end{equation}
i.e.%
\begin{equation}
\mathbb{O}\in O\left(  r,\mathbb{C}\right)  .
\end{equation}

\end{remark}

\subsection{Products of Different Geminals}

\begin{remark}
The vector space $\mathcal{H}^{1}$ produces the vector space of geminals
$\left\vert g\right\rangle \in\mathcal{H}^{2}=%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1}$ which is invariant under the action of the general linear
group $GL\left(  \mathcal{H}^{1}\right)  $ and hence any of its subgroups.
\end{remark}

The non canonical form of the exterior product $g_{1}\wedge g_{2}$ of geminals
$g_{1},g_{2}$ can be expressed as
\begin{align}
g_{1}\wedge g_{2}  &  =\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge
e_{j_{2}}\right)  g_{1j_{1}j_{2}}\wedge\sum_{1\leq j_{3}<j_{4}\leq r}\left(
e_{j_{3}}\wedge e_{j_{4}}\right)  g_{2j_{3}j_{4}}=\sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq j_{3}<j_{4}\leq r}}\left(  e_{j_{1}}\wedge e_{j_{2}%
}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  g_{1j_{1}j_{2}}g_{2j_{3}j_{4}}\\
=  &  \sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq r}\left\{  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\sum_{\sigma\in DC_{2,2}^{4}}%
\pi\left(  \sigma\right)  g_{1\sigma\left(  j_{1}\right)  \sigma\left(
j_{2}\right)  }g_{2\sigma\left(  j_{3}\right)  \sigma\left(  j_{4}\right)
}\right\} \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq r}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \left(  \overset{}{g_{1j_{1}%
j_{2}}g_{2j_{3}j_{4}}-g_{1j_{1}j_{3}}g_{2j_{2}j_{4}}+g_{1j_{1}j_{4}}%
g_{2j_{2}j_{3}}}+\,\,g_{1j_{3}j_{4}}g_{2j_{1}j_{2}}-g_{1j_{2}j_{4}}%
g_{2j_{1}j_{3}}+g_{1j_{2}j_{3}}g_{2j_{1}j_{4}}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq r}\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \operatorname{Pf}\left\{
\mathcal{R}_{e}\left(  \overset{}{G_{12}\left(  \overset{}{\left\{
j_{1},j_{2},j_{3},j_{4}\right\}  }\right)  }\right)  \right\}  ,
\end{align}
where $G_{12}$ is the image of $g_{1}\wedge g_{2}$ i.e.
\begin{equation}
G_{12}=\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  g_{1}\wedge g_{2}\right)
.
\end{equation}
$.$

\begin{enumerate}
\item
\begin{example}
$n=2$%
\begin{gather}
\#\left(  S_{2}\right)  =2!=2\\
S_{2}\left\{  \left\{  1,2\right\}  \right\}  =\left\{  \left\{  1,2\right\}
,\left\{  2,1\right\}  \right\} \\
C_{2}^{2}\left\{  \left\{  1,2\right\}  \right\}  =\left\{  \left\{
1,2\right\}  \right\}
\end{gather}

\end{example}

\begin{example}
$n=3$

Subscript combinations :%
\begin{gather}
\#\left(  S_{3}\right)  =3!=6\\
S_{3}\left\{  \left\{  1,2,3\right\}  \right\}  =\left\{  \left\{
1,2,3\right\}  ,\left\{  2,1,3\right\}  ,\left\{  1,3,2\right\}  ,\left\{
2,3,1\right\}  ,\left\{  3,1,2\right\}  ,\left\{  3,2,1\right\}  \right\} \\
C_{3}^{3}\left\{  \left\{  1,2,3\right\}  \right\}  =\left\{  \left\{
1,2,3\right\}  \right\}
\end{gather}

\end{example}

\begin{example}
$n=4$

Subscript combinations :

\begin{enumerate}
\item
\begin{equation}
\#\left(  S_{4}\right)  =4!=24
\end{equation}%
\begin{gather}
S_{4}\left\{  \left\{  1,2,3,4\right\}  \right\}  =\left\{  \left\{
1,2,3,4\right\}  ,\left\{  1,3,2,4\right\}  ,\left\{  1,4,2,3\right\}
,\left\{  2,3,1,4\right\}  ,\left\{  2,4,1,3\right\}  ,\left\{
3,4,1,2\right\}  \right\} \\
\vdots\\
S_{4}\left\{  \left\{  3,4,5,6\right\}  \right\}  =\left\{  \left\{
3,4,5,6\right\}  ,\left\{  3,5,4,6\right\}  ,\left\{  3,6,4,5\right\}
,\left\{  4,5,3,6\right\}  ,\left\{  4,6,3,5\right\}  ,\left\{
5,6,3,4\right\}  \right\}
\end{gather}%
\begin{equation}
C_{4}^{4}\left\{  \left\{  1,2,3,4\right\}  \right\}  =\left\{  \left\{
1,2,3,4\right\}  \right\}
\end{equation}


\item
\begin{gather}
C_{4}^{6}\left\{  \left\{  1,2,3,4,5,6\right\}  \right\}  =\left\{  \left\{
1,2,3,4\right\}  ,\left\{  1,2,3,5\right\}  ,\left\{  1,2,3,6\right\}
,\left\{  1,2,4,5\right\}  ,\left\{  1,2,4,6\right\}  ,\left\{
1,2,5,6\right\}  ,\right. \\
\left.  \left\{  1,3,4,5\right\}  ,\left\{  1,3,4,6\right\}  ,\left\{
1,3,5,6\right\}  ,\left\{  1,4,5,6\right\}  ,\left\{  2,3,4,5\right\}
,\left\{  2,3,4,6\right\}  ,\left\{  2,3,5,6\right\}  ,\left\{
2,4,5,6\right\}  ,\left\{  3,4,5,6\right\}  \right\} \\
\#\left(  C_{4}^{6}\left\{  \left\{  1,2,3,4,5,6\right\}  \right\}  \right)
=\binom{6}{4}=15
\end{gather}


\item
\begin{gather}
DC_{2,2}^{6}\left\{  \left\{  1,2,3,4\right\}  \right\}  =\left\{  \left\{
\left\{  1,2,3,4\right\}  ,\left\{  1,3,2,4\right\}  ,\left\{
1,4,2,3\right\}  ,\left\{  2,3,1,4\right\}  ,\left\{  2,4,1,3\right\}
,\left\{  3,4,1,2\right\}  \right\}  \right\}  ;\\
\#\left(  DC_{2,2}^{6}\left\{  \left\{  1,2,3,4\right\}  \right\}  \right)
=\binom{6}{2}=15\quad\\
\vdots\\
DC_{2,2}^{6}\left\{  \left\{  3,4,5,6\right\}  \right\}  =\left\{  \left\{
\left\{  3,4,5,6\right\}  ,\left\{  3,5,4,6\right\}  ,\left\{
3,6,4,5\right\}  ,\left\{  4,5,3,6\right\}  ,\left\{  4,6,3,5\right\}
,\left\{  5,6,3,4\right\}  \right\}  \right\}  ;\\
\#\left(  DC_{2,2}^{6}\left\{  \left\{  3,4,5,6\right\}  \right\}  \right)
=\binom{6}{2}=15
\end{gather}


\item
\begin{align}
g_{1}\wedge g_{2}  &  =\sum_{1\leq j_{1}<j_{2}\leq6}\left(  e_{j_{1}}\wedge
e_{j_{2}}\right)  g_{1j_{1}j_{2}}\wedge\sum_{1\leq j_{3}<j_{4}\leq6}\left(
e_{j_{3}}\wedge e_{j_{4}}\right)  g_{2j_{3}j_{4}}=\sum_{\substack{1\leq
j_{1}<j_{2}\leq6\\1\leq j_{3}<j_{4}\leq6}}\left(  e_{j_{1}}\wedge e_{j_{2}%
}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  g_{1j_{1}j_{2}}g_{2j_{3}j_{4}}\\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq6}\left\{  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\sum_{\sigma\in DC_{2,2}^{4}}%
\pi\left(  \sigma\right)  g_{1\sigma\left(  j_{1}\right)  \sigma\left(
j_{2}\right)  }g_{2\sigma\left(  j_{3}\right)  \sigma\left(  j_{4}\right)
}\right\} \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq6}\left(  e_{j_{1}}\wedge e_{j_{2}%
}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \left(  \overset{}{\left(
g_{1j_{1}j_{2}}g_{2j_{3}j_{4}}-g_{1j_{1}j_{3}}g_{2j_{2}j_{4}}+g_{1j_{1}j_{4}%
}g_{2j_{2}j_{3}}\right)  }+\,\,\left(  g_{1j_{3}j_{4}}g_{2j_{1}j_{2}%
}-g_{1j_{2}j_{4}}g_{2j_{1}j_{3}}+g_{1j_{2}j_{3}}g_{2j_{1}j_{4}}\right)
\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq6}\left(  e_{j_{1}}\wedge e_{j_{2}%
}\wedge e_{j_{3}}\wedge e_{j_{4}}\right)  \operatorname{Pf}\left\{
\overset{}{G_{12}\left(  \left\{  j_{1},j_{2},j_{3},j_{4}\right\}  \right)
}\right\}
\end{align}


\item
\begin{equation}
\operatorname{Pf}\left\{  G_{12}\left(  \left\{  j_{1},j_{2},j_{3}%
,j_{4}\right\}  \right)  \right\}  =\left(  g_{1j_{1}j_{2}}g_{2j_{3}j_{4}%
}-g_{1j_{1}j_{3}}g_{2j_{2}j_{4}}+g_{1j_{1}j_{4}}g_{2j_{2}j_{3}}\right)
\end{equation}


\item
\begin{gather}
\operatorname{Pf}\left\{  G_{12}\left(  \left\{  j_{1},j_{2},j_{3}%
,j_{4}\right\}  \right)  \right\}  =\operatorname{Pf}\left\{  \left(
\begin{array}
[c]{cccc}%
0 & g_{1j_{1}j_{2}} & g_{1j_{1}j_{3}} & g_{1j_{1}j_{4}}\\
-g_{1j_{1}j_{2}} & 0 & g_{2j_{2}j_{3}} & g_{2j_{2}j_{4}}\\
-g_{1j_{1}j_{3}} & -g_{2j_{2}j_{3}} & 0 & g_{2j_{3}j_{4}}\\
-g_{1j_{1}j_{4}} & -g_{2j_{2}j_{4}} & -g_{2j_{3}j_{4}} & 0
\end{array}
\right)  \right\} \\
\parallel\\
\left(  g_{1j_{1}j_{2}}g_{2j_{3}j_{4}}-g_{1j_{1}j_{3}}g_{2j_{2}j_{4}%
}+g_{1j_{1}j_{4}}g_{2j_{2}j_{3}}\right)  +\left(  g_{1j_{2}j_{3}}%
g_{2j_{1}j_{4}}-g_{1j_{2}j_{4}}g_{2j_{1}j_{3}}+g_{1j_{3}j_{4}}g_{2j_{1}j_{2}%
}\right) \\
=\operatorname{Pf}\left(  g_{1j_{1}j_{2}},g_{1j_{1}j_{3}},g_{1j_{1}j_{4}%
},g_{2j_{2}j_{3}},g_{2j_{2}j_{4}},g_{2j_{3}j_{4}}\right)  +\operatorname{Pf}%
\left(  g_{2j_{1}j_{2}},g_{2j_{1}j_{3}},g_{2j_{1}j_{4}},g_{1j_{2}j_{3}%
},g_{1j_{2}j_{4}},g_{1j_{3}j_{4}}\right) \\
=\operatorname{Pf}\left\{  \mathbb{G}_{12}\left(  \left\{  j_{1},j_{2}%
,j_{3},j_{4}\right\}  \right)  \right\}  +\operatorname{Pf}\left\{
\mathbb{G}_{21}\left(  \left\{  j_{1},j_{2},j_{3},j_{4}\right\}  \right)
\right\}  .
\end{gather}


\item
\begin{equation}
\mathcal{R}_{e}\left(  G_{1}\otimes G_{2}\right)  =\left(
\begin{array}
[c]{ccccc}%
\mathbb{O} & g_{112}\mathbb{G}_{2} & \cdots & \cdots & g_{116}\mathbb{G}_{2}\\
g_{121}\mathbb{G}_{2} & \mathbb{O} & \vdots & \vdots & \vdots\\
\vdots & \vdots & \mathbb{O} & \vdots & \vdots\\
\vdots & \vdots & \vdots & \mathbb{O} & g_{156}\mathbb{G}_{2}\\
g_{161}\mathbb{G}_{2} & \cdots & \cdots & g_{165}\mathbb{G}_{2} & \mathbb{O}%
\end{array}
\right)
\end{equation}


\item
\begin{align}
\mathcal{R}_{e}\left(  G_{1}\oplus G_{2}\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbb{G}_{1} & \mathbb{O}\\
\mathbb{O} & \mathbb{G}_{2}%
\end{array}
\right) \\
\mathcal{R}_{e}\left(  G_{2}\oplus G_{1}\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbb{G}_{2} & \mathbb{O}\\
\mathbb{O} & \mathbb{G}_{1}%
\end{array}
\right)  .
\end{align}


\item
\begin{equation}
\mathcal{R}_{e}\left(  G_{1}\otimes G_{2}\right)  \in\mathcal{B}\left(
\mathbb{C}^{6}\otimes\mathbb{C}^{6}\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{B}\left(  \mathbb{C}^{6}\otimes\mathbb{C}^{6}\right)  \supset
\mathcal{B}\left(  \mathbb{C}^{6}\wedge\mathbb{C}^{6}\right)  \equiv
\mathcal{B}\left(  \bigwedge\nolimits^{2}\mathbb{C}^{6}\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  g\right)  \in\bigwedge\nolimits^{2}\mathbb{C}^{6}.
\end{equation}

\end{enumerate}
\end{example}

\item Geminals commute%
\begin{equation}
g_{1}\wedge g_{2}=g_{2}\wedge g_{1}%
\end{equation}


\item Canonical form%
\begin{equation}
g_{1}\wedge g_{2}=\sum_{\substack{1\leq j_{1}\leq s_{1}\\1\leq j_{2}\leq
s_{2}}}\alpha_{1j_{1}}\beta_{1j_{1}}\left(  c_{1j_{2}}\wedge c_{1j_{2}+s_{1}%
}\wedge d_{2j_{2}}\wedge d_{2j_{2}+s_{2}}\right)  .
\end{equation}


\item
\begin{align}
\mathcal{R}_{e}\left(  g_{1}\right)   &  =\mathcal{R}_{e}\left(
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}^{-1}\left(  G_{1}\right)  \right) \\
\mathcal{R}_{e}\left(  g_{2}\right)   &  =\mathcal{R}_{e}\left(
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}^{-1}\left(  G_{2}\right)  \right)  .
\end{align}

\end{enumerate}

\subsubsection{The Pfaffian of Skew Linear Transformations
\label{The Pfaffian of Skew Linear Transformations}}

\begin{enumerate}
\item Vectors $v\in V$ can be expanded as
\begin{equation}
\left\vert v\right\rangle =\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert \left\vert v\right\rangle =\left\vert \mathbf{f}%
\right\rangle \left\langle \mathbf{f}\right\vert \left\vert v\right\rangle
\end{equation}
wrt a conbs $\left(  \mathbf{e}\right)  $ and $\left(  \mathbf{f}\right)  .$

\item Using the resolution of identities $\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert $ and $\left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{f}\right\vert $ belonging to $\mathcal{B}\left(
V\right)  $ one can construct unitray transformations $u$ between conb
$\left\vert \mathbf{e}\right\rangle $ and $\left\vert \mathbf{f}\right\rangle
$
\begin{align}
\left\vert \mathbf{e}\right\rangle  &  =\left\vert u^{\dagger}\mathbf{f}%
\right\rangle \equiv u^{\dagger}\left\vert \mathbf{f}\right\rangle =\left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert \left\vert
\mathbf{e}\right\rangle =\left\vert \mathbf{f}\right\rangle \mathcal{R}%
_{f}\left(  u^{\dagger}\right) \\
\left\vert \mathbf{f}\right\rangle  &  =\left\vert u\mathbf{e}\right\rangle
\equiv u\left\vert \mathbf{e}\right\rangle =\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  u\right)
\end{align}
i.e.%
\begin{gather}
\mathcal{R}_{e}\left(  u\right)  =\left\langle \mathbf{e}\right\vert
\left\vert \mathbf{f}\right\rangle \\
\mathcal{R}_{f}\left(  u^{\dagger}\right)  =\left\langle \mathbf{f}\right\vert
\left\vert \mathbf{e}\right\rangle =\mathcal{R}_{f}\left(  u\right)
^{\dagger}.
\end{gather}


\item Using the resolution of identities $\left\vert \mathbf{ee}\right\rangle
\left\langle \mathbf{ee}\right\vert $ and $\left\vert \mathbf{ff}\right\rangle
\left\langle \mathbf{ff}\right\vert $ belonging to $\mathcal{B}\left(
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\right)  $ a geminal $\left\vert g\right\rangle $ can be expanded as
\begin{equation}
\left\vert g\right\rangle =\left\vert \mathbf{ee}\right\rangle \left\langle
\mathbf{ee}\right\vert \left\vert g\right\rangle =\left\vert \mathbf{ff}%
\right\rangle \left\langle \mathbf{ff}\right\vert \left\vert g\right\rangle
\end{equation}%
\begin{equation}
\left\vert g\right\rangle =\left\vert \mathbf{ff}\right\rangle \mathcal{R}%
_{f}\left(  g\right)  =\left\vert \mathbf{ee}\right\rangle \mathcal{R}%
_{e}\left(  g\right)  ,
\end{equation}
i.e.%
\begin{align}
\mathcal{R}_{f}\left(  g\right)   &  =\left\langle \mathbf{ff}\right\vert
\left\vert g\right\rangle \\
\mathcal{R}_{e}\left(  g\right)   &  =\left\langle \mathbf{ee}\right\vert
\left\vert g\right\rangle .
\end{align}


\item Using the resolution of identities $\left\vert \mathbf{ee}\right\rangle
\left\langle \mathbf{ee}\right\vert $ and $\left\vert \mathbf{ff}\right\rangle
\left\langle \mathbf{ff}\right\vert $ belonging to $\mathcal{B}\left(
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\right)  $ one can construct unitray transformations $\boxtimes^{2}u$ between
conb $\left\vert \mathbf{ee}\right\rangle $ and $\left\vert \mathbf{ff}%
\right\rangle $
\begin{equation}
\left\vert \left(  u\mathbf{e}\right)  \left(  u\mathbf{e}\right)
\right\rangle =\left(  \boxtimes^{2}u\right)  \left\vert \mathbf{ee}%
\right\rangle =\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{e}\left(
\boxtimes^{2}u\right)  =\left\vert \mathbf{ee}\right\rangle \left\langle
\mathbf{ee}\right\vert \left\vert \mathbf{ff}\right\rangle
\end{equation}
giving
\begin{equation}
\mathcal{R}_{e}\left(  \boxtimes^{2}u\right)  =\left\langle \mathbf{ee}%
\right\vert \left\vert \mathbf{ff}\right\rangle .
\end{equation}


\begin{example}
\begin{enumerate}
\item
\begin{align}
\left(  \mathbf{e}\right)   &  =\left(  e_{1},e_{2}\right) \\
\left(  \mathbf{ee}\right)   &  =\left(  e_{1}e_{2}\right) \\
\left\vert e_{1}e_{2}\right\rangle  &  =\frac{1}{\sqrt{2}}\left(  e_{1}\otimes
e_{2}-e_{2}\otimes e_{1}\right) \\
e_{1}\wedge e_{2}  &  =\frac{1}{2}\left(  e_{1}\otimes e_{2}-e_{2}\otimes
e_{1}\right)  =\sqrt{2}\left\vert e_{1}e_{2}\right\rangle
\end{align}


\item
\begin{gather}
\left\vert ue_{1}ue_{2}\right\rangle =\frac{1}{\sqrt{2}}\left(  \left(
ue_{1}\right)  \otimes\left(  ue_{2}\right)  -\left(  ue_{2}\right)
\otimes\left(  ue_{1}\right)  \right)  =\sqrt{2}\left(  \frac{1}{2}\left(
ue_{1}\right)  \otimes\left(  ue_{2}\right)  -\left(  ue_{2}\right)
\otimes\left(  ue_{1}\right)  \right) \\
=\frac{1}{\sqrt{2}}\left(  \left(  e_{1}u_{11}+e_{2}u_{21}\right)
\otimes\left(  e_{1}u_{12}+e_{2}u_{22}\right)  \right)  -\frac{1}{\sqrt{2}%
}\left(  \left(  e_{1}u_{12}+e_{2}u_{22}\right)  \otimes\left(  e_{1}%
u_{11}+e_{2}u_{21}\right)  \right) \\
=\frac{1}{\sqrt{2}}\left(  e_{1}u_{11}\otimes e_{1}u_{12}+e_{1}u_{11}\otimes
e_{2}u_{22}+e_{2}u_{21}\otimes e_{1}u_{12}+e_{2}u_{21}\otimes e_{2}%
u_{22}\right. \\
-\left.  \left(  e_{1}u_{12}\otimes e_{1}u_{11}+e_{1}u_{12}\otimes e_{2}%
u_{21}+e_{2}u_{22}\otimes e_{1}u_{11}+e_{2}u_{22}\otimes e_{2}u_{21}\right)
\right) \\
=\frac{1}{\sqrt{2}}\left(  e_{1}\otimes e_{2}u_{11}u_{22}-e_{1}\otimes
e_{2}u_{12}u_{21}+e_{2}\otimes e_{1}u_{21}u_{12}-e_{2}\otimes e_{1}%
u_{22}u_{11}\right) \\
=\frac{1}{\sqrt{2}}\left(  e_{1}\otimes e_{2}\left(  u_{11}u_{22}-u_{12}%
u_{21}\right)  +e_{2}\otimes e_{1}\left(  u_{21}u_{12}-u_{22}u_{11}\right)
\right) \\
=\frac{1}{\sqrt{2}}\left(  e_{1}\otimes e_{2}+e_{2}\otimes e_{1}\right)
\left(  u_{21}u_{12}-u_{22}u_{11}\right)  =\frac{1}{\sqrt{2}}\left(
e_{1}\otimes e_{2}+e_{2}\otimes e_{1}\right)  \det\left(
\begin{array}
[c]{cc}%
u_{11} & u_{12}\\
u_{21} & u_{22}%
\end{array}
\right)  .
\end{gather}

\end{enumerate}
\end{example}

\item
\begin{align}
\left(  \mathbf{e}\right)   &  =\left(  e_{1},e_{2},e_{3}\right)  =\left\vert
\mathbf{e}\right\rangle \\
\left(  \mathbf{ee}\right)   &  =\left(  e_{1}e_{2},e_{1}e_{3},e_{2}%
e_{3}\right)  =\left\vert \mathbf{ee}\right\rangle \\
\left\vert e_{j}e_{k}\right\rangle  &  =\frac{1}{\sqrt{2}}\left(  e_{j}\otimes
e_{k}-e_{k}\otimes e_{j}\right)  ,\quad1\leq j<k\leq3.
\end{align}

\end{enumerate}

\begin{definition}
\label{k-th compound matrix}The $k^{th}${\large \thinspace compound matrix}
$\mathfrak{C}_{k}\left(  A\right)  $ of a $p\times q$ is a matrix $A$ is
defined as follows:
\end{definition}

\begin{remark}
\begin{enumerate}
\item If $k>\min(p,q)$, then $\mathfrak{C}_{k}\left(  A\right)  $ is the
unique $0\,\times\,0$ matrix.

\item Otherwise, $\mathfrak{C}_{k}\left(  A\right)  $ has size $\binom{p}%
{k}\times\binom{q}{k}$. Its rows and columns are indexed by $k$-element
subsets $I$ of $\{1,...,p\}$ and $k$-element subsets $J$ of $\{1,...,q\}$ in
their lexicographic order. The entry corresponding to subsets $I$ and $J$ is
the \emph{minor} $\det\left\{  A\left(  I,J\right)  \right\}  $.
\end{enumerate}
\end{remark}

\begin{remark}%
\begin{align}
&  \frac{1}{\sqrt{2}}\left(  \left(  ue_{1}\right)  \otimes\left(
ue_{2}\right)  -\left(  ue_{2}\right)  \otimes\left(  ue_{1}\right)  \right)
=\sqrt{2}\left(  \frac{1}{2}\left(  ue_{1}\right)  \otimes\left(
ue_{2}\right)  -\left(  ue_{2}\right)  \otimes\left(  ue_{1}\right)  \right)
\\
&  =\frac{1}{\sqrt{2}}\left(  \left(  e_{1}u_{11}+e_{2}u_{21}+e_{3}%
u_{31}\right)  \otimes\left(  e_{1}u_{12}+e_{2}u_{22}+e_{3}u_{32}\right)
\right)  -\frac{1}{\sqrt{2}}\left(  \left(  e_{1}u_{12}+e_{2}u_{22}%
+e_{3}u_{32}\right)  \otimes\left(  e_{1}u_{11}+e_{2}u_{21}+e_{3}%
u_{31}\right)  \right)
\end{align}%
\begin{equation}
\parallel
\end{equation}%
\begin{align}
\sum_{1\leq k_{1}<k_{2}\leq3}\left\vert e_{k_{1}}e_{k_{2}}\right\rangle
\mathfrak{C}_{k}\left(  \mathbb{U}\right)  _{k_{1}k_{2}j_{1}j_{2}}  &
=\sum_{1\leq k_{1}<k_{2}\leq3}\left\vert e_{k_{1}}e_{k_{2}}\right\rangle
\det\left\{  \mathbb{U}\left(  \left\{  k_{1},k_{2}\right\}  ,\left\{
j_{1},j_{2}\right\}  \right)  \right\}  =\sum_{1\leq j_{1}<j_{2}\leq
3}\left\vert e_{k_{1}}e_{k_{2}}\right\rangle \left(  u_{k_{1}j_{1}}%
u_{k_{2}j_{2}}-u_{k_{1}j_{2}}u_{k_{2}j_{1}}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}\leq3}\left\vert e_{k_{1}}e_{k_{2}}\right\rangle
\left\vert
\begin{array}
[c]{cc}%
u_{k_{1}j_{1}} & u_{k_{1}j_{2}}\\
u_{k_{2}j_{1}} & u_{k_{2}j_{2}}%
\end{array}
\right\vert
\end{align}%
\begin{align}
&  \parallel\\
e_{1}u_{11}\otimes\left(  e_{1}u_{12}+e_{2}u_{22}+e_{3}u_{32}\right)   &
=e_{1}u_{11}\otimes e_{1}u_{12}+\emph{e}_{1}\emph{u}_{11}\emph{\otimes e}%
_{2}\emph{u}_{22}+e_{1}u_{11}\otimes e_{3}u_{32}\\
e_{2}u_{21}\otimes\left(  e_{1}u_{12}+e_{2}u_{22}+e_{3}u_{32}\right)   &
=\emph{e}_{2}\emph{u}_{21}\emph{\otimes e}_{1}\emph{u}_{12}+e_{2}u_{21}\otimes
e_{2}u_{22}+e_{2}u_{21}\otimes e_{3}u_{32}\\
e_{3}u_{31}\otimes\left(  e_{1}u_{12}+e_{2}u_{22}+e_{3}u_{32}\right)   &
=e_{3}u_{31}\otimes e_{1}u_{12}+e_{3}u_{31}\otimes e_{2}u_{22}+e_{3}%
u_{31}\otimes e_{3}u_{32}%
\end{align}%
\begin{equation}
\mid
\end{equation}%
\begin{align}
e_{1}u_{12}\otimes\left(  e_{1}u_{11}+e_{2}u_{21}+e_{3}u_{31}\right)   &
=e_{1}u_{12}\otimes e_{1}u_{11}+\emph{e}_{1}\emph{u}_{12}\emph{\otimes e}%
_{2}\emph{u}_{21}+e_{1}u_{12}\otimes e_{3}u_{31}\\
e_{2}u_{22}\otimes\left(  e_{1}u_{11}+e_{2}u_{21}+e_{3}u_{31}\right)   &
=\emph{e}_{2}\emph{u}_{22}\emph{\otimes e}_{1}\emph{u}_{11}+e_{2}u_{21}\otimes
e_{2}u_{21}+e_{2}u_{21}\otimes e_{3}u_{31}\\
e_{3}u_{32}\otimes\left(  e_{1}u_{11}+e_{2}u_{21}+e_{3}u_{31}\right)   &
=e_{3}u_{32}\otimes e_{1}u_{11}+e_{3}u_{31}\otimes e_{2}u_{21}+e_{3}%
u_{31}\otimes e_{3}u_{31}%
\end{align}%
\begin{equation}
\parallel
\end{equation}%
\begin{align}
&  \emph{e}_{1}\emph{u}_{11}\emph{\otimes e}_{2}\emph{u}_{22}+e_{1}%
u_{11}\otimes e_{3}u_{32}+\emph{e}_{2}\emph{u}_{21}\emph{\otimes e}%
_{1}\emph{u}_{12}+e_{2}u_{21}\otimes e_{3}u_{32}+e_{3}u_{31}\otimes
e_{1}u_{12}+e_{3}u_{31}\otimes e_{2}u_{22}\\
&  -\emph{e}_{1}\emph{u}_{12}\emph{\otimes e}_{2}\emph{u}_{21}-e_{1}%
u_{12}\otimes e_{3}u_{31}-\emph{e}_{2}\emph{u}_{22}\emph{\otimes e}%
_{1}\emph{u}_{11}-e_{2}u_{21}\otimes e_{3}u_{31}-e_{3}u_{32}\otimes
e_{1}u_{11}-e_{3}u_{31}\otimes e_{2}u_{21}%
\end{align}%
\begin{equation}
\parallel
\end{equation}%
\begin{align}
&  \left(  \emph{e}_{1}\emph{\otimes e}_{2}-\emph{e}_{2}\emph{\otimes e}%
_{1}\right)  \emph{u}_{22}\emph{u}_{11}+\left(  \emph{e}_{2}\emph{\otimes
e}_{1}-\emph{e}_{1}\emph{\otimes e}_{2}\right)  \emph{u}_{12}\emph{u}%
_{21}+e_{2}u_{21}\otimes e_{3}u_{32}+e_{1}u_{11}\otimes e_{3}u_{32}%
+e_{3}u_{31}\otimes e_{1}u_{12}+e_{3}u_{31}\otimes e_{2}u_{22}\\
&  -e_{1}u_{12}\otimes e_{3}u_{31}-e_{2}u_{21}\otimes e_{3}u_{31}-e_{3}%
u_{32}\otimes e_{1}u_{11}-e_{3}u_{31}\otimes e_{2}u_{21}%
\end{align}%
\begin{gather}
\text{ multiplying by the normalization constant }\\
\parallel
\end{gather}%
\begin{align}
\frac{1}{\sqrt{2}}  &  \left(  \emph{e}_{1}\emph{\otimes e}_{2}-\emph{e}%
_{2}\emph{\otimes e}_{1}\right)  \left(  \emph{u}_{22}\emph{u}_{11}%
-\emph{u}_{12}\emph{u}_{21}\right)  +e_{2}u_{21}\otimes e_{3}u_{32}%
+e_{1}u_{11}\otimes e_{3}u_{32}+e_{3}u_{31}\otimes e_{1}u_{12}+e_{3}%
u_{31}\otimes e_{2}u_{22}\\
&  -e_{1}u_{12}\otimes e_{3}u_{31}-e_{2}u_{21}\otimes e_{3}u_{31}-e_{3}%
u_{32}\otimes e_{1}u_{11}-e_{3}u_{31}\otimes e_{2}u_{21}.
\end{align}
Hence

\begin{enumerate}
\item
\begin{gather}
\det\left\{  \mathbb{U}\left(  \left\{  k_{1},k_{2}\right\}  ,\left\{
j_{1},j_{2}\right\}  \right)  \right\}  =\det\left\{  \mathcal{R}_{e}\left(
u\boxtimes u\right)  \left(  \left\{  k_{1},k_{2}\right\}  ,\left\{
j_{1},j_{2}\right\}  \right)  \right\} \\
\parallel\\
\mathcal{R}_{e}\left(  u\boxtimes u\right)  _{k_{1}k_{2}j_{1}j_{2}}=\left(
u_{k_{1}j_{1}}u_{k_{2}j_{2}}-u_{k_{2}j_{1}}u_{k_{1}j_{2}}\right)
=\det\left\{  \left(
\begin{array}
[c]{cc}%
u_{k_{1}j_{1}} & u_{k_{1}j_{2}}\\
u_{k_{2}j_{1}} & u_{k_{2}j_{2}}%
\end{array}
\right)  \right\}  =\left\vert
\begin{array}
[c]{cc}%
u_{k_{1}j_{1}} & u_{k_{1}j_{2}}\\
u_{k_{2}j_{1}} & u_{k_{2}j_{2}}%
\end{array}
\right\vert \\
\parallel\\
\mathcal{R}_{e}\left(  u\right)  _{k_{1}j_{1}}\mathcal{R}_{e}\left(  u\right)
_{k_{2}j_{2}}-\mathcal{R}_{e}\left(  u\right)  _{k_{2}j_{1}}\mathcal{R}%
_{e}\left(  u\right)  _{k_{1}j_{2}}=\det\left\{  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{e}\left(  u\right)  _{k_{1}j_{1}} & \mathcal{R}_{e}\left(
u\right)  _{k_{1}j_{2}}\\
\mathcal{R}_{e}\left(  u\right)  _{k_{2}j_{1}} & \mathcal{R}_{e}\left(
u\right)  _{k_{2}j_{2}}%
\end{array}
\right)  \right\}  =\left\vert
\begin{array}
[c]{cc}%
\mathcal{R}_{e}\left(  u\right)  _{k_{1}j_{1}} & \mathcal{R}_{e}\left(
u\right)  _{k_{1}j_{2}}\\
\mathcal{R}_{e}\left(  u\right)  _{k_{2}j_{1}} & \mathcal{R}_{e}\left(
u\right)  _{k_{2}j_{2}}%
\end{array}
\right\vert
\end{gather}
and
\begin{equation}
\left(  u\boxtimes u\right)  \left\vert \mathbf{ee}\right\rangle =\left\vert
u\mathbf{e}u\mathbf{e}\right\rangle =\left\vert \mathbf{ee}\right\rangle
\mathcal{R}_{e}\left(  u\boxtimes u\right)  =\left\vert \mathbf{ee}%
\right\rangle \mathcal{R}_{e}\left(  u\boxtimes u\right)  =\left\vert
\mathbf{ee}\right\rangle \mathfrak{C}_{2}\left(  \mathcal{R}_{e}\left(
u\right)  \right)  .
\end{equation}


\item Geminals $\left\vert g\right\rangle $ can be expanded as%
\begin{equation}
\left\vert g\right\rangle =\left\vert \mathbf{ff}\right\rangle \left\langle
\mathbf{ff}\right\vert \left\vert g\right\rangle =\left\vert \mathbf{ff}%
\right\rangle \mathcal{R}_{f}\left(  g\right)  =\left\vert u\mathbf{e}%
u\mathbf{e}\right\rangle \mathcal{R}_{f}\left(  g\right)  =u\boxtimes
u\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{f}\left(  g\right)
=\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{e}\left(  u\boxtimes
u\right)  \mathcal{R}_{f}\left(  g\right)  =\left\vert \mathbf{ee}%
\right\rangle \mathcal{R}_{e}\left(  g\right)
\end{equation}
hence
\begin{equation}
\mathcal{R}_{e}\left(  g\right)  =\mathcal{R}_{e}\left(  u\boxtimes u\right)
\mathcal{R}_{f}\left(  g\right)  .
\end{equation}


\item Transformation between decomposable bases of geminal space
\begin{align}
u\boxtimes u  &  =\left\vert \mathbf{ff}\right\rangle \left\langle
\mathbf{ee}\right\vert \\
\mathcal{R}_{e}\left(  u\boxtimes u\right)   &  =\left\langle \mathbf{ee}%
\right\vert \left\vert \mathbf{ff}\right\rangle ,
\end{align}
gives explicitly

\item
\begin{gather}
\left(  u\boxtimes u\right)  g=\left(  u\boxtimes u\right)  \left\vert
\mathbf{ee}\right\rangle \left\langle \mathbf{ee}\right\vert g=\left(
u\boxtimes u\right)  \left\vert \mathbf{ee}\right\rangle \mathcal{R}%
_{e}\left(  g\right)  =\left(  \mathbf{ee}\right)  \mathcal{R}_{e}\left(
u\boxtimes u\right)  \mathcal{R}_{e}\left(  g\right)  =\left(  \mathbf{ee}%
\right)  \mathcal{R}_{e}\left(  u\boxtimes u\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  g\right)  _{12}\\
\mathcal{R}_{e}\left(  g\right)  _{13}\\
\mathcal{R}_{e}\left(  g\right)  _{23}%
\end{array}
\right) \\
\parallel\\
g=\left\vert \mathbf{ff}\right\rangle \left\langle \mathbf{ff}\right\vert
g=\left(  \mathbf{ff}\right)  \mathcal{R}_{f}\left(  g\right)  =\left(
\mathbf{ff}\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  g\right)  _{12}\\
\mathcal{R}_{f}\left(  g\right)  _{13}\\
\mathcal{R}_{f}\left(  g\right)  _{23}%
\end{array}
\right) \\
\Downarrow\\
\mathcal{R}_{f}\left(  g\right)  =\mathcal{R}_{e}\left(  u\boxtimes u\right)
\mathcal{R}_{e}\left(  g\right)  =\left(
\begin{array}
[c]{ccc}%
\left\vert
\begin{array}
[c]{cc}%
u_{11} & u_{12}\\
u_{21} & u_{22}%
\end{array}
\right\vert  & \left\vert
\begin{array}
[c]{cc}%
u_{11} & u_{13}\\
u_{21} & u_{23}%
\end{array}
\right\vert  & \left\vert
\begin{array}
[c]{cc}%
u_{12} & u_{13}\\
u_{22} & u_{23}%
