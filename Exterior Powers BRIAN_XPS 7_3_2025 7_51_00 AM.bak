}\right\rangle \left\langle e_{j_{1}}\right\vert \right)  \mathcal{R}%
_{e}\left(  g\right)  _{j_{1}j_{2}}\\
=\sum_{1\leq j_{1},j_{2}\leq2r}\left\vert e_{j_{1}}\right\rangle \left\langle
e_{j_{2}}\right\vert \mathcal{R}_{e}\left(  g\right)  _{j_{1}j_{2}}%
;\quad\mathcal{R}_{e}\left(  g\right)  _{j_{2}j_{1}}=-\mathcal{R}_{e}\left(
