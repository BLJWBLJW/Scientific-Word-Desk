\section{Grassmann Product}

In general the dimension $\dim\left\{  V\right\}  $ of the underlying
\emph{complex} vector \emph{Banach} space $V$ is $r.$

\begin{notation}
\begin{enumerate}
\item $\mathcal{L}\left(  V\right)  $ is the space of linear operators acting
in $V.$

\item If $V$ is even dimensional then $r=2s.$

\item If $V$ has a Hilbert space structure given by a sesquilinear
$\left\langle \left.  {}\right\vert \right\rangle $ it is denoted by
$\mathcal{H}$ or $\mathcal{H}^{1}.$

\item Often we consider direct sum vector spaces of the form
\begin{equation}
\mathcal{V}=V\oplus V^{d}%
\end{equation}
that have dimension $\dim\left\{  \mathcal{V}\right\}  =2r,$ where $V^{d}$ is
the dual of $V$ (this could be the algebraic dual or a topological dual)$.$

\item $\left\langle \left.  {}\right\vert \right\rangle $ is the standard
sesquilinear form on the Hilbert space $\mathcal{H}^{1},$ defining the
space$.$

\item $\left(  \left.  {}\right\vert \right)  $ is the standard complex
symmetric form on a vector space $V.$

\begin{enumerate}
\item The form $\left(  \left.  {}\right\vert \right)  $ can be considered as
an element $s^{d}$ $\in$ $%
%TCIMACRO{\tbigvee \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigvee\nolimits^{2}}
%EndExpansion
V^{d}.$
\end{enumerate}

\item If $r=2s$ then $\left\{  \left.  {}\right\vert \right\}  $ denotes the
standard symplectic form on a vector space $V$

\begin{enumerate}
\item The form$\left\{  \left.  {}\right\vert \right\}  $ can be considered as
an element $g^{d}$ $\in$ $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V^{d}.$
\end{enumerate}

\item A general basis of $V$ is denoted by $\left(  \mathbf{e}\right)  $
\begin{equation}
\left(  \mathbf{e}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  .
\end{equation}


\item A biorthogonal dual basis $\left(  \mathbf{e}^{d}\right)  $
\begin{equation}
\left(  \mathbf{e}^{d}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)
\end{equation}
of $V^{d}$ dual to $\left(  \mathbf{e}\right)  $ that are produced by the
injection $\digamma_{e}$ i.e. $\digamma_{e}\left\{  \left(  \mathbf{e}\right)
\right\}  =\left(  \mathbf{e}^{d}\right)  .$

\item A sesquilinear $\left\langle \left.  {}\right\vert \right\rangle $-conb
of $\mathcal{H}^{1}$ is denoted by $\left\vert \mathbf{e}\right\rangle .$

\item A sesquilinear $\left\langle \left.  {}\right\vert \right\rangle
$-biorthogonal bases to $\left\vert \mathbf{e}\right\rangle $ of
$\mathcal{H}^{1}$ is denoted by $\left\vert \mathbf{e}^{b}\right\rangle $ that
produces a dual basis i.e. $\left(  \mathbf{e}^{d}\right)  =\digamma
_{\left\vert e\right\rangle }\left\{  \left\vert \mathbf{e}^{b}\right\rangle
\right\}  $

\begin{enumerate}
\item The $\left\langle \left.  {}\right\vert \right\rangle $-biorthogonal
bases $\left\vert \mathbf{e}^{b}\right\rangle $ is given by
\begin{equation}
\left\vert \mathbf{e}^{b}\right\rangle =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}=\left(  \mathbf{e}\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}.
\end{equation}


\item This gives%
\begin{align}
\mathbf{e}^{d}\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}^{d}\right)
^{t}\cdot\left(  \mathbf{e}\right)  =\left\langle \left.  \mathbf{e}%
^{b}\right\vert \mathbf{e}\right\rangle =\left\langle \mathbf{e}%
^{b}\right\vert \cdot\left\vert \mathbf{e}\right\rangle =\left(
\begin{array}
[c]{c}%
\left\langle e_{1}^{b}\right\vert \\
\vdots\\
\left\langle e_{r}^{b}\right\vert
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right\rangle  & \cdots & \left\vert e_{r}\right\rangle
\end{array}
\right) \\
&  =\left\langle \left(  \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\right\vert \cdot\left\vert
\mathbf{e}\right\rangle =\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right)
\left\vert \mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle =\mathbb{I}_{r}.
\end{align}

\end{enumerate}

\item A complex symmetric $\left(  \left.  {}\right\vert \right)  $-conb of
$\mathcal{H}^{1}$ is denoted by $\left\vert \mathbf{e}\right)  .$

\begin{enumerate}
\item The $\left(  \left.  {}\right\vert \right)  $-biorthogonal bases
$\left\vert \mathbf{e}^{b}\right)  $ is given by
\begin{equation}
\left\vert \mathbf{e}^{b}\right)  =\left\vert \mathbf{e}\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}.
\end{equation}


\item This gives%
\begin{align}
\mathbf{e}^{d}\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}^{d}\right)
^{t}\cdot\left(  \mathbf{e}\right)  =\left(  \left.  \mathbf{e}^{b}\right\vert
\mathbf{e}\right)  =\left(  \mathbf{e}^{b}\right\vert \cdot\left\vert
\mathbf{e}\right)  =\left(
\begin{array}
[c]{c}%
\left(  e_{1}^{b}\right\vert \\
\vdots\\
\left(  e_{r}^{b}\right\vert
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right)  & \cdots & \left\vert e_{r}\right)
\end{array}
\right) \\
&  =\left\langle \left(  \mathbf{e}\right)  \left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  ^{-1}\right\vert \cdot\left\vert \mathbf{e}%
\right)  =\left(  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert \right)  \left\vert \mathbf{e}\right)
=\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  =\mathbb{I}_{r}.
\end{align}

\end{enumerate}

\item A complex symmetric $\left(  \left.  {}\right\vert \right)
$-biorthogonal bases to $\left\vert \mathbf{e}\right)  $ of $\mathcal{H}^{1}$
is denoted by $\left\vert \mathbf{e}^{b}\right)  $ that produces a dual basis
i.e. $\left(  \mathbf{e}^{d}\right)  =\digamma_{\left\vert e\right)  }\left\{
\left\vert \mathbf{e}^{b}\right)  \right\}  .$

\item Dyadic basis of $\mathcal{L}\left(  V\right)  $%
\begin{gather}
\left(  \mathbf{E}\right)  =\left(  \left[  \mathbf{ee}^{d}\right]  \right)
=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \diamond\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathbf{e}e_{1}^{d} & \cdots & \mathbf{e}e_{r}^{d}%
\end{array}
\right) \\
=\left(
\begin{array}
[c]{ccc}%
e_{1}\mathbf{e}^{d} & \cdots & e_{r}\mathbf{e}^{d}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left[  e_{1}e_{1}^{d}\right]  & \cdots & \left[  e_{r}e_{r}^{d}\right]
\end{array}
\right)  ,
\end{gather}
where "$\#"$ denotes the product
\begin{equation}
e_{j}\#e_{k}^{d}=\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  =\left[
e_{j}e_{k}^{d}\right]  ,
\end{equation}
where%
\begin{equation}
\Xi_{VV^{d}}:V\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
is defined later and in infinite dimensions depends on $\left(  \mathbf{e}%
\right)  $.

\item Representations

\begin{enumerate}
\item $\mathcal{R}_{e}$ the representation of vectors $\in V$ wrt the basis
$\left(  \mathbf{e}\right)  .$

\item $\mathcal{R}_{e}$ the \emph{matrix} representation of operators
$\in\mathcal{L}\left(  V\right)  $ wrt the basis $\left(  \mathbf{e}\right)
.$

\item $\mathcal{R}_{ee^{d}}$ the \emph{vector} representation of operators
$\in\mathcal{L}\left(  V\right)  $ wrt the elementary operator basis $\left(
\mathbf{E}\right)  =\left(  \mathbf{ee}^{d}\right)  .$

\item $\mathcal{R}_{\otimes^{n}e}$ the representation of tensors
$\in{\large \otimes}^{n}V$ wrt the basis $\left(  {\large \otimes}%
^{n}\mathbf{e}\right)  .$

\item $\mathcal{R}_{\wedge^{n}e}$ the representation of tensors $\in
{\LARGE \wedge}^{n}V$ wrt the basis $\left(  {\LARGE \wedge}^{n}%
\mathbf{e}\right)  .$

\item $\mathcal{R}_{\vee^{n}e}$ the representation of tensors $\in
{\LARGE \vee}^{n}V$ wrt the basis $\left(  {\LARGE \vee}^{n}\mathbf{e}\right)
$
\end{enumerate}

\item Representation matrices of operators $A\in\mathcal{L}\left(  V\right)
$
\begin{gather}
\mathcal{R}_{e}\left(  A\right)  =\left(  \mathbf{e}^{d}\right)
^{t}A\mathbf{e}=\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  ^{t}A\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right)  A\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right) \\
\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  e_{1}\right)  & \cdots & e_{1}^{d}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
e_{r}^{d}\left(  e_{1}\right)  & \cdots & e_{r}^{d}\left(  e_{r}\right)
\end{array}
\right)  \mathcal{R}_{e}\left(  A\right)  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \mathcal{R}_{e}\left(  A\right)  =\mathcal{R}_{e}\left(  A\right)
=\mathcal{M}_{e^{d}e}\left(  A\right)  ,
\end{gather}
where the matrix of $A$ is
\begin{equation}
\mathcal{M}_{e^{d}e}\left(  A\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  Ae_{1}\right)  & \cdots & e_{1}^{d}\left(  Ae_{r}\right) \\
\vdots & \ddots & \vdots\\
e_{r}^{d}\left(  Ae_{1}\right)  & \cdots & e_{r}^{d}\left(  Ae_{r}\right)
\end{array}
\right)  =\left(  \mathbf{e}^{d}\right)  ^{t}A\mathbf{e.}%
\end{equation}


\item The resolution of the identity $I_{V}$
\begin{equation}
\left(  \mathbf{e}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right)  =I_{V}=\sum_{1\leq j\leq r}\left[  e_{j}e_{j}^{d}\right]
=\sum_{1\leq j\leq r}e_{j}e_{j}^{d}.
\end{equation}


\item The metric matrix $S\left(  \mathbf{f}^{d},\mathbf{e}\right)  $
\begin{equation}
S\left(  \mathbf{f}^{d},\mathbf{e}\right)  =\left(  \mathbf{f}^{d}\right)
^{t}\mathbf{e}=\left(
\begin{array}
[c]{c}%
f_{1}^{d}\\
\vdots\\
f_{r}^{d}%
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
f_{1}^{d}\\
\vdots\\
f_{r}^{d}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
f_{1}^{d}\left(  e_{1}\right)  & \cdots & f_{1}^{d}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
f_{r}^{d}\left(  e_{1}\right)  & \cdots & f_{r}^{d}\left(  e_{r}\right)
\end{array}
\right)  .
\end{equation}


\item Expansion of operators $A$ using the resolution of the identity $\left(
\mathbf{e}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}$ one obtains
\begin{gather}
A=\left(  \mathbf{e}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}A\left(
\mathbf{e}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}=\left(  \mathbf{e}%
\right)  \mathcal{R}_{e}\left(  A\right)  \left(  \mathbf{e}^{d}\right)
^{t}=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \mathcal{R}_{e}\left(  A\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right) \\
=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \#\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  \mathcal{R}_{ee^{d}}\left(  A\right)  =\left(  \mathbf{ee}%
^{d}\right)  \mathcal{R}_{ee^{d}}\left(  A\right)  =\left(  \mathbf{E}\right)
\mathcal{R}_{ee^{d}}\left(  A\right)  .
\end{gather}

\end{enumerate}
\end{notation}

\begin{definition}
An adjoint map "$\dagger"\in\mathcal{L}\left(  \mathcal{L}\left(  V\right)
\right)  $ in $\mathcal{L}\left(  V\right)  $
\begin{equation}
\dagger:\mathcal{L}\left(  V\right)  \rightarrow\mathcal{L}\left(  V\right)
\end{equation}
is an \emph{antilinear} involution and an \emph{anti isomorphism}.
\end{definition}

\begin{definition}
A transpose map "$t"\in\mathcal{L}\left(  \mathcal{L}\left(  V\right)
\right)  $ in $\mathcal{L}\left(  V\right)  $%
\begin{equation}
t:\mathcal{L}\left(  V\right)  \rightarrow\mathcal{L}\left(  V\right)
\end{equation}
is a \emph{linear involution} and an \emph{anti isomorphism}.
\end{definition}

\begin{theorem}
\begin{enumerate}
\item Each adjoint operation can be associated with a \emph{unique sesquiliner
form} $\left\langle \left.  {}\right\vert \right\rangle $ acting in $V\times
V.$

\item Each transpose operation can be associated with a unique complex
symmetric form $\left(  \left.  {}\right\vert \right)  $ acting in $V\times
V.$
\end{enumerate}
\end{theorem}

\begin{remark}
There are many adjoint and transpose operations each corresponding to
different second order forms.
\end{remark}

\begin{lemma}
$\left[  \text{Greub}\right]  $ Let $\dim\left\{  V\right\}  =\dim\left\{
W\right\}  =r$ then any vector $a_{2}\in V\otimes W$ can be expanded
\underline{\emph{non uniquely}} as
\begin{equation}
a_{2}=\sum_{1\leq j\leq p<r}v_{j}{\small \otimes}w_{j},
\end{equation}
where $\left\{  \left.  v_{j}\right\vert 1\leq j\leq r\right\}  $ and
$\left\{  \left.  w_{j}\right\vert 1\leq j\leq r\right\}  $ are bases for
$\mathcal{V}$ and $\mathcal{W}$ respectively and $p$ is the rank of $a_{2}$.
\end{lemma}

\begin{remark}
Let $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ and $\left\{
\left.  f_{j}\right\vert 1\leq j\leq r\right\}  $ be bases for $\mathcal{V}$
then the operators $M\in\mathcal{L}\left(  \mathcal{V}\right)  $ and
$M^{\dagger}\in\mathcal{L}\left(  \mathcal{V}\right)  $ can be expanded as
\begin{equation}
M=\sum_{1\leq j,k\leq r}\left[  e_{j}f_{k}^{d}\right]  \mathcal{R}_{ef}\left(
M\right)  _{jk}%
\end{equation}
and
\begin{equation}
M^{\dagger}=\sum_{1\leq j,k\leq r}\left[  f_{j}e_{k}^{d}\right]
\mathcal{R}_{fu}\left(  M^{\dagger}\right)  _{jk},
\end{equation}
where
\begin{equation}
\mathcal{R}_{fe}\left(  M^{\dagger}\right)  =\mathcal{R}_{ef}\left(  M\right)
^{\dagger}%
\end{equation}
and
\begin{equation}
\left[  e_{j}f_{k}^{d}\right]  =\left[  f_{j}e_{k}^{d}\right]  ^{\dagger}.
\end{equation}

\end{remark}

\begin{theorem}
If
\begin{equation}
Mv_{k}=\U{3c3} _{k}u_{k}\in\mathcal{W},\quad1\leq k\leq r
\end{equation}
and
\begin{equation}
M^{\dagger}u_{k}=\U{3c3} _{k}v_{k}\in\mathcal{V},\quad1\leq k\leq r,
\end{equation}
where
\begin{gather}
\mathcal{V}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
v_{j}\right\vert 1\leq j\leq r\right\} \\
\mathcal{W}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
u_{j}\right\vert 1\leq j\leq r\right\} \\
\left\Vert v_{j}\right\Vert _{\mathcal{V}}=\left\Vert u_{j}\right\Vert
_{\mathcal{W}}=1,\,\U{3c3} _{k}\geq0,\quad1\leq j\leq r,
\end{gather}
then

\begin{enumerate}
\item $M$ has the singular valued expansion
\begin{equation}
M=U\U{3a3} V^{\dagger}=\sum_{1\leq j\leq r}\left[  u_{j}v_{j}^{d}\right]
\U{3c3} _{j}%
\end{equation}
and

\item $M^{\dagger}$ has the singular valued expansion%
\begin{equation}
M^{\dagger}=V\U{3a3} ^{\dagger}U^{\dagger}=\sum_{1\leq k\leq r}\left[
v_{k}u_{k}^{d}\right]  \U{3c3} _{k}.
\end{equation}

\end{enumerate}
\end{theorem}

\begin{proof}%
\begin{equation}
Mv_{k}=\sum_{1\leq j\leq r}\U{3c3} _{j}\left[  u_{j}v_{j}^{d}\right]  \left(
v_{k}\right)  =\U{3c3} _{k}u_{k}%
\end{equation}
and
\begin{equation}
M^{\dagger}u_{k}=\sum_{1\leq j\leq r}\U{3c3} _{j}\left[  v_{j}u_{j}%
^{d}\right]  \left(  u_{k}\right)  =\U{3c3} _{k}v_{k}.
\end{equation}

\end{proof}

\begin{corollary}%
\begin{equation}
M^{\dagger}Mv_{k}=\U{3c3} _{k}^{2}v_{k}%
\end{equation}
and
\begin{equation}
MM^{\dagger}u_{k}=\U{3c3} _{k}^{2}u_{k}%
\end{equation}
for
\begin{equation}
1\leq k\leq r.
\end{equation}

\end{corollary}

%

\begin{equation}
M^{\dagger}Mv_{k}=\U{3c3} _{k}M^{\dagger}u_{k}=\U{3c3} _{k}^{2}v_{k}%
\end{equation}
and
\begin{equation}
MM^{\dagger}u_{k}=\U{3c3} _{k}Mv_{k}=\U{3c3} _{k}^{2}u_{k}.
\end{equation}


\begin{remark}
\begin{enumerate}
\item Often we are considering the case where $\mathcal{V=W}$ and often
consider the Hilbert space case where $\mathcal{V}^{d}\overset{\text{anti}%
}{\cong}\mathcal{V},$ where $v^{d}=\left\langle v\right\vert ,$which should be
compared to $\mathcal{V}^{d}\cong\mathcal{V}$ through $v^{d}=\left(
v\right\vert .$

\item The representations follow the same pattern%
\begin{equation}
\mathcal{R}_{e}\left(  M^{\dagger}M\right)  \mathcal{R}_{e}\left(
v_{k}\right)  =\mathcal{R}_{e}\left(  M^{\dagger}\right)  \mathcal{R}%
_{e}\left(  M\right)  \mathcal{R}_{e}\left(  v_{k}\right)  =\U{3c3} _{k}%
^{2}\mathcal{R}_{e}\left(  v_{k}\right)
\end{equation}
and

\item
\begin{equation}
\mathcal{R}_{e}\left(  MM^{\dagger}\right)  \mathcal{R}_{e}\left(
u_{k}\right)  =\mathcal{R}_{e}\left(  M\right)  \mathcal{R}_{e}\left(
M^{\dagger}\right)  \mathcal{R}_{e}\left(  u_{k}\right)  =\U{3c3} _{k}%
^{2}\mathcal{R}_{e}\left(  u_{k}\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{R}_{e}\left(  V^{\dagger}\right)  \mathcal{R}_{e}\left(  M^{\dagger
}M\right)  \mathcal{R}_{e}\left(  V\right)  =\mathbf{\sigma}_{e}%
^{2}=\mathcal{R}_{v}\left(  M^{\dagger}M\right)  ,
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{v}\left(  M^{\dagger}M\right)  _{jk}=\sigma_{j}^{2}\delta_{jk}.
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  V\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  V\right)  _{11} & \cdots & \mathcal{R}_{e}\left(
V\right)  _{1r}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  V\right)  _{r1} & \cdots & \mathcal{R}_{e}\left(
V\right)  _{rr}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  v_{1}\right)  _{1} & \cdots & \mathcal{R}_{e}\left(
v_{r}\right)  _{1}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  v_{1}\right)  _{r} & \cdots & \mathcal{R}_{e}\left(
v_{r}\right)  _{r}%
\end{array}
\right)
\end{equation}


\item
\begin{equation}
V=\sum_{1\leq j,k\leq r}\left[  e_{j}e_{k}^{d}\right]  \mathcal{R}_{e}\left(
V\right)  _{jk}%
\end{equation}
where the matrix elements are given by
\begin{equation}
e_{p}^{d}\left(  Ve_{q}\right)  =e_{p}^{d}\left(  \sum_{1\leq j,k\leq
r}\left[  e_{j}e_{k}^{d}\right]  \left(  e_{q}\right)  \mathcal{R}_{e}\left(
V\right)  _{jk}\right)  =\sum_{1\leq j,k\leq r}e_{p}^{d}\left(  e_{j}\right)
e_{k}^{d}\left(  e_{q}\right)  \mathcal{R}_{e}\left(  V\right)  _{jk}%
=\mathcal{R}_{e}\left(  V\right)  _{pq}.
\end{equation}


\item \emph{Column expansion} in terms of eigenvectors $\left\{  \left.
v_{p}\right\vert 1\leq p\leq r\right\}  $ of $M^{\dagger}M$%
\begin{equation}
\mathfrak{C}_{e}\left(  V\right)  _{k}=\sum_{1\leq j\leq n}\left[  v_{j}%
v_{k}^{d}\right]  \mathcal{R}_{e}\left(  V\right)  _{jk}\in\mathcal{L}\left(
\mathcal{V}\right)  ,\quad1\leq k\leq p=\min(m,n),
\end{equation}
which in the Hilbert space case becomes
\begin{equation}
V=\sum_{1\leq p\leq r}\sum_{1\leq q\leq r}\left[  v_{p}e_{q}^{d}\right]
=\sum_{1\leq p\leq r}\sum_{1\leq q\leq r}\left\vert v_{p}\right\rangle
\left\langle e_{q}\right\vert .
\end{equation}


\item The expansion coefficients of the eigenvectors $\left\{  \left.
v_{p}\right\vert 1\leq p\leq r\right\}  $ of $M^{\dagger}M$ and the matrix
elements of $V$ wrt the basis $\left\{  \left.  e_{j}\right\vert 1\leq j\leq
r\right\}  $
\begin{equation}
e_{j}^{d}\left(  \left[  v_{p}e_{q}^{d}\right]  \left(  e_{k}\right)  \right)
=e_{j}^{d}\left(  v_{p}\right)  \delta_{qk}=\mathcal{R}_{e}\left(
v_{p}\right)  _{j}\delta_{qk}=\mathcal{R}_{e}\left(  V\right)  _{jk}%
\delta_{qk},\quad1\leq q\leq r.
\end{equation}


\item Unitary transformation $T_{ve}$ from the basis $\left\{  \left.
e_{j}\right\vert 1\leq j\leq r\right\}  $ to the bases $\left\{  \left.
v_{p}\right\vert 1\leq j\leq r\right\}  $ is the sum of partial isometries
\begin{equation}
T_{ve}=\left[  \mathbf{ve}^{d}\right]  =\left\vert \mathbf{v}\right\rangle
\left\langle \mathbf{e}\right\vert =\sum_{1\leq j,k\leq r}\left[  v_{j}%
e_{k}^{d}\right]  =\sum_{1\leq j,k\leq r}\left\vert v_{j}\right\rangle
\left\langle e_{k}\right\vert
\end{equation}
i.e.%
\begin{equation}
T_{ve}=V
\end{equation}
as%
\begin{equation}
V=\sum_{1\leq p\leq r}\sum_{1\leq q\leq r}\left[  v_{p}e_{q}^{d}\right]
=\sum_{1\leq p\leq r}\sum_{1\leq q\leq r}\left\vert v_{p}\right\rangle
\left\langle e_{q}\right\vert
\end{equation}
and has the $\mathcal{R}_{e}$ representation
\begin{align}
\mathcal{R}_{e}\left(  T_{ve}\right)   &  =\left\langle \mathbf{e}\right\vert
\left\vert \mathbf{v}\right\rangle \left\langle \mathbf{e}\right\vert
\left\vert \mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{v}\right\rangle \\
\mathcal{R}_{e}\left(  T_{ve}\right)  _{pq}  &  =\left\langle e_{p}\right\vert
\sum_{1\leq j,k\leq r}\left\vert v_{j}\right\rangle \left\langle
e_{k}\right\vert \left\vert e_{q}\right\rangle =\sum_{1\leq j,k\leq
r}\left\langle e_{p}\right\vert \left\vert v_{j}\right\rangle \delta_{kq}%
=\sum_{1\leq j\leq r}\left\langle e_{p}\right\vert \left\vert v_{j}%
\right\rangle =\sum_{1\leq j\leq r}\mathcal{R}_{e}\left(  v_{j}\right)  _{p}%
\end{align}
and the $\mathcal{R}_{v}$ representation
\begin{align}
\mathcal{R}_{v}\left(  T_{ve}\right)   &  =\left\langle \mathbf{v}\left\vert
\left\vert \mathbf{v}\right\rangle \left\langle \mathbf{e}\right\vert \right.
\mathbf{v}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{v}\right\rangle \\
\mathcal{R}_{v}\left(  T_{ve}\right)  _{pq}  &  =\left\langle \left.
e_{p}\right\vert v_{q}\right\rangle ,
\end{align}
which are identical. The columns of $\mathcal{R}_{e}\left(  T_{ev}\right)  $
are
\begin{equation}
\left\langle \left.  e_{p}\right\vert v_{q}\right\rangle ,\quad1\leq p\leq r
\end{equation}
i.e.
\begin{equation}
\left(
\begin{array}
[c]{c}%
\left\langle \left.  e_{1}\right\vert v_{q}\right\rangle \\
\vdots\\
\left\langle \left.  e_{r}\right\vert v_{q}\right\rangle
\end{array}
\right)  ,\quad1\leq p\leq r.
\end{equation}


\item $V$ can be expanded in the $\left(  \mathbf{e}\right)  $ and $\left(
\mathbf{v}\right)  $ bases as
\begin{align}
V  &  =\sum_{1\leq j,k\leq r}\left[  e_{j}e_{k}^{d}\right]  \mathcal{R}%
_{e}\left(  V\right)  _{jk}=\sum_{1\leq j,k\leq r}\left\vert e_{j}%
\right\rangle \left\langle e_{k}\right\vert \mathcal{R}_{e}\left(  V\right)
_{jk}=\sum_{1\leq j,k\leq r}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \left\langle \left.  e_{j}\right\vert Ve_{k}\right\rangle \\
&  =\sum_{1\leq j,k\leq r}\left[  v_{j}v_{k}^{d}\right]  \mathcal{R}%
_{v}\left(  V\right)  _{jk}=\sum_{1\leq j,k\leq r}\left\vert v_{j}%
\right\rangle \left\langle v_{k}\right\vert \mathcal{R}_{v}\left(  V\right)
_{jk}=\sum_{1\leq j,k\leq r}\left\vert v_{j}\right\rangle \left\langle
v_{k}\right\vert \left\langle \left.  v_{j}\right\vert Vv_{k}\right\rangle
\end{align}
and the transformation between these bases expansions is given by

\begin{enumerate}
\item
\begin{gather}
\left(  \sum_{1\leq p\leq r}\left\vert v_{p}\right\rangle \left\langle
e_{p}\right\vert \right)  \left(  \sum_{1\leq j,k\leq r}\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert \left\langle \left.
e_{j}\right\vert Ve_{k}\right\rangle \right)  \left(  \sum_{1\leq q\leq
r}\left\vert e_{q}\right\rangle \left\langle v_{q}\right\vert \right)
=\sum_{1\leq j,k\leq r}\left\vert v_{p}\right\rangle \left\langle \left.
e_{p}\right\vert Ve_{q}\right\rangle \left\langle v_{q}\right\vert \\
\mathcal{R}_{v}\left(  V\right)  _{pq}=\sum_{1\leq j,k\leq r}\mathcal{R}%
_{e}\left(  T_{ev}\right)  _{pj}\mathcal{R}_{e}\left(  V\right)
_{jk}\mathcal{R}_{e}\left(  T_{ev}^{\dagger}\right)  _{kq}=\sum_{1\leq j,k\leq
r}\left\vert v_{p}\right\rangle \left\langle \left.  e_{p}\right\vert
Ve_{q}\right\rangle \left\langle v_{q}\right\vert .
\end{gather}


\item
\begin{equation}
\mathcal{R}_{v}\left(  V\right)  _{lm}=\left\langle \left.  v_{l}\right\vert
Vv_{m}\right\rangle =\left\langle \left.  \overset{\overset{}{}}{v_{l}%
}\right\vert \sum_{1\leq j,k\leq r}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \left\langle \left.  e_{j}\right\vert Ve_{k}\right\rangle
v_{m}\right\rangle =\sum_{1\leq j,k\leq r}\left\langle \left.  v_{l}%
\right\vert e_{j}\right\rangle \left\langle \left.  e_{j}\right\vert
Ve_{k}\right\rangle \left\langle e_{k}\right\vert \left\vert v_{m}%
\right\rangle =\sum_{1\leq j,k\leq r}\left\langle \left.  v_{l}\right\vert
e_{j}\right\rangle \mathcal{R}_{e}\left(  V\right)  _{jk}\left\langle
e_{k}\right\vert \left\vert v_{m}\right\rangle
\end{equation}


\item
\begin{equation}
\mathcal{R}_{v}\left(  V\right)  =\mathcal{R}_{e}\left(  T_{ev}\right)
\mathcal{R}_{e}\left(  V\right)  \mathcal{R}_{e}\left(  T_{ev}^{\dagger
}\right)  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{enumerate}
The spectral theorem:
\end{enumerate}
\end{remark}

\begin{theorem}
The \emph{spectral expansion} of compact normal operators $A\in\mathcal{L}%
\left(  \mathcal{V}\right)  $ is given by
\begin{equation}
A=\sum_{1\leq j\leq r}z_{j}\left[  a_{j}a_{j}^{d}\right]  =\sum_{1\leq j\leq
r}\left[  a_{j}a_{j}^{d}\right]  \mathcal{R}_{a}\left(  A\right)  _{jj},\quad
z_{j}\in\operatorname*{Spec}\left\{  A\right\}  \subseteq\mathbb{C},
\end{equation}
where $\left\{  \left.  \left[  a_{j}a_{j}^{d}\right]  \right\vert 1\leq j\leq
r\right\}  $ are projection operators onto the eigen subspaces generated by
the eigenvectors $\left\{  \left.  a_{j}\right\vert 1\leq j\leq r\right\}  $
of $A.$
\end{theorem}

\begin{corollary}%
\begin{equation}
A=\sum_{1\leq k,l\leq r}\left[  e_{k}e_{l}^{d}\right]  \mathcal{R}_{e}\left(
A\right)  _{kl},
\end{equation}
where
\end{corollary}

\begin{enumerate}
\item The $\mathcal{R}_{e}$ representation is related to the $\mathcal{R}_{a}$
representation%
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\mathcal{R}_{e}\left(  U\right)
\mathcal{R}_{a}\left(  A\right)  \mathcal{R}_{e}\left(  U^{\dagger}\right)
\end{equation}


\item where
\begin{equation}
U=\left[  \mathbf{e\cdot a}^{d}\right]  =\sum_{1\leq j\leq r}\left[
e_{j}a_{j}^{d}\right]
\end{equation}
and

\item $\left(  \mathbf{a}\right)  $ are the eigenvectors of $A.$
\end{enumerate}

\begin{proof}
Let
\begin{equation}
a_{j}=\sum_{1\leq j\leq r}e_{k}\mathcal{R}_{e}\left(  a_{j}\right)
\end{equation}
then
\begin{align}
A  &  =\sum_{1\leq j\leq r}\left[  a_{j}a_{j}^{d}\right]  \mathcal{R}%
_{a}\left(  A\right)  _{jj}=\sum_{1\leq j\leq r}\left[  \sum_{1\leq k\leq
r}e_{k}\mathcal{R}_{e}\left(  a_{j}\right)  _{k}\left(  \sum_{1\leq l\leq
r}e_{l}\mathcal{R}_{e}\left(  a_{j}\right)  _{l}\right)  ^{d}\right]
\mathcal{R}_{a}\left(  A\right)  _{jj}\\
&  =\sum_{1\leq j,k,l\leq r}\left[  e_{k}\mathcal{R}_{e}\left(  a_{j}\right)
_{k}e_{l}^{d}\mathcal{R}_{e}\left(  a_{j}\right)  _{l}\right]  \mathcal{R}%
_{a}\left(  A\right)  _{jj}=\sum_{1\leq j,k,l\leq r}\left[  e_{k}e_{l}%
^{d}\right]  \mathcal{R}_{e}\left(  a_{j}\right)  _{k}\mathcal{R}_{a}\left(
A\right)  _{jj}\mathcal{R}_{e}\left(  a_{j}\right)  _{l}\\
&  =\sum_{1\leq j,k,l\leq r}\left[  e_{k}e_{l}^{d}\right]  \mathcal{R}%
_{e}\left(  U\right)  _{kj}\mathcal{R}_{a}\left(  A\right)  _{jj}%
\mathcal{R}_{e}\left(  U\right)  _{lj}=\sum_{1\leq j,k,l\leq r}\left[
e_{k}e_{l}^{d}\right]  \mathcal{R}_{e}\left(  U\right)  _{kj}\mathcal{R}%
_{a}\left(  A\right)  _{jj}\mathcal{R}_{e}\left(  U^{\dagger}\right)  _{jl}\\
&  =\sum_{1\leq k,l\leq r}\left[  e_{k}e_{l}^{d}\right]  \mathcal{R}%
_{e}\left(  A\right)  _{kl}.
\end{align}
where
\begin{equation}
U=\left[  \mathbf{e\cdot a}^{d}\right]  =\sum_{1\leq j\leq r}\left[
e_{j}a_{j}^{d}\right]  .
\end{equation}

\end{proof}

\begin{remark}
Consider a normal operator $A\geq0\in\mathcal{L}\left(  \mathcal{V}\right)  $
then%
\begin{align}
A  &  =\int_{\operatorname*{Spec}\left(  A\right)  }\U{3c3} ^{2}dP_{A}\left(
\U{3c3} \right)  \overset{\text{If }A\text{ is compact}}{=}\sum_{1\leq k\leq
r}\U{3c3} _{k}^{2}P\left(  A\right)  _{k}\\
P\left(  A\right)  _{k}a_{j}  &  =a_{k}\delta_{jk}\\
U_{A}  &  =\int_{\operatorname*{Spec}\left(  A\right)  }e^{i\theta}%
dP_{A}\left(  \theta\right)  \overset{\text{If }A\text{ is compact}}{=}%
\sum_{1\leq k\leq r}e^{i\theta_{k}}P\left(  A\right)  _{k}\\
U_{A}P\left(  A\right)  _{j}  &  =e^{i\theta_{j}}P\left(  A\right)  _{j}\\
U_{A}^{\dagger}AU_{A}  &  =\sum_{1\leq j\leq r}e^{-i\theta_{j}}P\left(
A\right)  _{j}\sum_{1\leq k\leq r}\U{3c3} _{k}^{2}P\left(  A\right)  _{k}%
\sum_{1\leq l\leq r}e^{i\theta_{l}}P\left(  A\right)  _{l}=\sum_{1\leq k\leq
r}\U{3c3} _{k}^{2}P\left(  A\right)  _{k}.
\end{align}

\end{remark}

\begin{remark}
Unitary operators are normal and thus have spectral expansions.
\end{remark}

\begin{corollary}
The \emph{spectral expansions} of $M^{\dagger}M$ and $MM^{\dagger}$ are given
by
\begin{equation}
M^{\dagger}M=\sum_{1\leq k\leq r}\left[  v_{k}v_{k}^{d}\right]  \U{3c3}
_{k}^{2}=\sum_{1\leq k\leq r}\U{3c3} _{k}^{2}P\left(  M^{\dagger}M\right)
_{k}%
\end{equation}
and
\begin{equation}
MM^{\dagger}=\sum_{1\leq k\leq r}\left[  w_{k}w_{k}^{d}\right]  \U{3c3}
_{k}^{2}=\sum_{1\leq k\leq r}\U{3c3} _{k}^{2}P\left(  MM^{\dagger}\right)
_{k}.
\end{equation}

\end{corollary}

\begin{corollary}%
\begin{equation}
V^{\dagger}M^{\dagger}MV=M^{\dagger}M=\sum_{1\leq k\leq r}\left[  v_{k}%
v_{k}^{d}\right]  \U{3c3} _{k}^{2}%
\end{equation}
and%
\begin{equation}
U^{\dagger}MM^{\dagger}U=MM^{\dagger}=\sum_{1\leq k\leq r}\left[  w_{k}%
w_{k}^{d}\right]  \U{3c3} _{k}^{2}.
\end{equation}

\end{corollary}

\begin{proof}
Use the spectral expansions of $M^{\dagger}M$ and $MM^{\dagger}.$
\end{proof}

\begin{lemma}
Assuming the SVD
\begin{equation}
M=U\Sigma V^{\dagger}%
\end{equation}
then
\begin{equation}
\left(  M^{\dagger}M=V\Sigma^{\dagger}\Sigma V^{\dagger}\right)
\Longleftrightarrow\left(  V^{\dagger}M^{\dagger}MV=\Sigma^{\dagger}%
\Sigma\right)
\end{equation}
and
\begin{equation}
\left(  MM^{\dagger}=U\Sigma\Sigma^{\dagger}U^{\dagger}\right)
\Longleftrightarrow\left(  U^{\dagger}MM^{\dagger}U=\Sigma\Sigma^{\dagger
}\right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
M^{\dagger}M=V\Sigma^{\dagger}U^{\dagger}U\Sigma V^{\dagger}=V\Sigma^{\dagger
}\Sigma V^{\dagger}%
\end{equation}
and
\begin{equation}
MM^{\dagger}=U\Sigma V^{\dagger}V\Sigma^{\dagger}U^{\dagger}=U\Sigma
\Sigma^{\dagger}U^{\dagger}%
\end{equation}

\end{proof}

\begin{corollary}%
\begin{equation}
\Sigma^{\dagger}\Sigma=\sum_{1\leq k\leq r}\left[  v_{k}v_{k}^{d}\right]
\U{3c3} _{k}^{2}=\sum_{1\leq k\leq r}\U{3c3} _{k}^{2}P\left(  M^{\dagger
}M\right)  _{k}%
\end{equation}
and
\begin{equation}
\Sigma\Sigma^{\dagger}=\sum_{1\leq k\leq r}\left[  u_{k}u_{k}^{d}\right]
\U{3c3} _{k}^{2}=\sum_{1\leq k\leq r}\U{3c3} _{k}^{2}P\left(  MM^{\dagger
}\right)  _{k}.
\end{equation}

\end{corollary}

\begin{lemma}
Any operator $X\in\mathcal{L}\left(  \mathcal{V}\right)  $ can be expanded as
\begin{equation}
X=\sum_{1\leq j,k\leq r}\left[  e_{j}f_{k}^{d}\right]  \mathcal{R}_{ef^{d}%
}\left(  X\right)  _{jk}%
\end{equation}

\end{lemma}

\begin{theorem}
Let $M\in\mathcal{L}\left(  \mathcal{V}\right)  $ be compact then it has a
\emph{singular expansion} in terms of left and right singular vectors
$\left\{  \left.  v_{j},u_{j}\right\vert 1\leq j\leq r\right\}  $ and singular
values $\left\{  \left.  \U{3c3} _{j}\right\vert 1\leq j\leq r\right\}  $
given by
\begin{equation}
M=\sum_{1\leq j\leq r}\left[  v_{j}u_{j}^{d}\right]  \U{3c3} _{j}.
\end{equation}

\end{theorem}

\begin{proof}%
\begin{equation}
M^{\dagger}M=\sum_{1\leq k\leq r}\left[  v_{k}u_{k}^{d}\right]  \U{3c3}
_{k}\sum_{1\leq j\leq r}\left[  u_{j}v_{j}^{d}\right]  \U{3c3} _{j}%
=\sum_{1\leq j\leq r}\left[  v_{j}v_{j}^{d}\right]  \U{3c3} _{j}^{2}%
\end{equation}
and
\begin{equation}
MM^{\dagger}=\sum_{1\leq k\leq r}\left[  u_{k}v_{k}^{d}\right]  \U{3c3}
_{k}\sum_{1\leq j\leq r}\left[  v_{j}u_{j}^{d}\right]  \U{3c3} _{j}%
=\sum_{1\leq j\leq r}\left[  u_{j}u_{j}^{d}\right]  \U{3c3} _{j}^{2}.
\end{equation}

\end{proof}

%

\begin{align}
M  &  =U\U{3a3} V^{\dagger}\\
&  \parallel
\end{align}%
\begin{gather*}
\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq k_{3}\leq m}}\left[  u_{j_{1}%
}w_{j_{2}}^{d}\right]  \left[  u_{j_{3}}v_{j_{3}}\right]  \left[  v_{k_{2}%
}^{d}v_{k_{3}}\right]  \mathcal{R}_{u}\left(  U\right)  _{j_{1}j_{2}%
}\mathcal{R}_{uv^{d}}\left(  \U{3a3} \right)  _{j_{2}j_{2}}\mathcal{R}_{v^{d}%
}\left(  V^{d}\right)  _{j_{2}k_{3}}\\
\parallel\\
\sum_{\substack{1\leq j_{1}\leq n\\1\leq k_{3}\leq m}}\left[  u_{j_{1}%
}v_{k_{3}}\right]  \sum_{1\leq j_{2}\leq\min\left(  n,m\right)  }%
\mathcal{R}_{u}\left(  U\right)  _{j_{1}j_{2}}\U{3c3} _{j_{2}}\mathcal{R}%
_{v^{d}}\left(  V^{d}\right)  _{j_{2}k_{3}}.
\end{gather*}


\begin{remark}
The SVD of $M\in\mathcal{L}\left(  V\right)  $ is given by
\begin{equation}
M=V\Sigma W^{\dagger},
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
V=\sum_{1\leq j_{1},j_{2}\leq r}\left[  a_{j_{1}}a_{j_{2}}^{d}\right]
\mathcal{R}_{a}\left(  V\right)  _{j_{1}j_{2}}%
\end{equation}


\item
\begin{equation}
\Sigma=\sum_{1\leq j_{1}\leq r}\left[  a_{j_{1}}a_{j_{1}}^{d}\right]
\mathcal{R}_{a}\left(  \U{3a3} \right)  _{j_{1}j_{1}}%
\end{equation}


\item
\begin{equation}
W^{\dagger}=\sum_{1\leq j_{1},j_{2}\leq r}\left[  a_{j_{1}}a_{j_{2}}%
^{d}\right]  \mathcal{R}_{a}\left(  V^{\dagger}\right)  _{j_{1}j_{2}}%
\end{equation}


\item
\begin{align}
VV^{\dagger}  &  =V^{\dagger}V=WW^{\dagger}=W^{\dagger}W=I_{V}\\
\Sigma &  =\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}=\Sigma^{\dagger}%
\end{align}
and

\item is unique up unitary transformations $\Upsilon$ that leave $\Sigma$
invariant i.e.
\begin{equation}
\Upsilon\Sigma\Upsilon^{\dagger}=\Sigma.
\end{equation}
An operator is normal if
\begin{equation}
\left[  A^{\dagger},A\right]  =0.
\end{equation}


\item If an operator $A\ $is normal then one can apply the spectral theorem to
obtain the spectral decomposition
\begin{equation}
A=\int_{\operatorname*{Spec}\left\{  A\right\}  }zdP_{A}\left(  z\right)  .
\end{equation}


\item For \emph{any normal operator} $A\ $one has
\begin{equation}
A^{\dagger}A=AA^{\dagger}=\int_{\operatorname*{Spec}\left\{  A\right\}
}\left\vert z\right\vert ^{2}dP_{A}\left(  z\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
Using the SVD
\begin{equation}
A=V\Sigma W^{\dagger}=V\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}W^{\dagger}%
\end{equation}
of $A$ one obtains
\begin{align}
A^{\dagger}A  &  =W\Sigma V^{\dagger}V\Sigma W^{\dagger}=W\Sigma^{2}%
W^{\dagger}\equiv W\left(  A^{\dagger}A\right)  W^{\dagger}\\
AA^{\dagger}  &  =V\Sigma W^{\dagger}W\Sigma V^{\dagger}=V\Sigma^{2}%
V^{\dagger}\equiv V\left(  AA^{\dagger}\right)  V^{\dagger}%
\end{align}%
\begin{equation}
\Downarrow
\end{equation}%
\begin{align}
W^{\dagger}A^{\dagger}AW  &  =\Sigma^{2}\\
V^{\dagger}AA^{\dagger}V  &  =\Sigma^{2}%
\end{align}%
\begin{equation}
\Downarrow
\end{equation}%
\begin{equation}
W^{\dagger}A^{\dagger}AW=V^{\dagger}AA^{\dagger}V
\end{equation}%
\begin{equation}
\Downarrow
\end{equation}%
\begin{equation}
VW^{\dagger}A^{\dagger}AWV^{\dagger}=\left(  WV^{\dagger}\right)  ^{\dagger
}A^{\dagger}A\left(  WV^{\dagger}\right)  =AA^{\dagger}%
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
A^{\dagger}AAA^{\dagger}  &  =A^{\dagger}A^{2}A^{\dagger}\\
AA^{\dagger}A^{\dagger}A  &  =AA^{2\dagger}A
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
A=V\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}W^{\dagger},
\end{equation}%
\begin{equation}
A^{\dagger}=W\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}V^{\dagger}=V^{\prime
}\left(  AA^{\dagger}\right)  ^{\frac{1}{2}}W^{^{\prime}\dagger}%
\end{equation}%
\begin{equation}
\Downarrow
\end{equation}%
\begin{equation}
\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}=W^{\dagger}V^{\prime}\left(
AA^{\dagger}\right)  ^{\frac{1}{2}}W^{^{\prime}\dagger}V
\end{equation}

\end{remark}

\begin{remark}
The positive operator $\Sigma$ has the spectral expansion
\begin{equation}
\Sigma=\int_{\alpha\in\operatorname*{Spec}\left(  \Sigma\right)  }%
\alpha\left(  d\left[  P\left(  \Sigma\right)  \right]  \right)  \left(
\alpha\right)  \overset{\Sigma\in\mathcal{B}_{00}\left(  V\right)  }{=}%
\sum_{1\leq j\leq r}\alpha_{j}P\left(  \Sigma\right)  _{j}.
\end{equation}
In the compact case
\begin{equation}
\alpha_{j}=\mathcal{R}_{a}\left(  \Sigma\right)  _{jj},
\end{equation}
where the representation $\mathcal{R}_{a}$ is induced by the basis $\left(
\mathbf{a}\right)  $ of eigenvectors of $A^{\dagger}A$ i.e.
\begin{equation}
\Sigma\left(  \mathbf{a}\right)  =\left(  A^{\dagger}A\right)  ^{\frac{1}{2}%
}\left(  \mathbf{a}\right)  =\left(  \mathbf{a}\right)  \mathcal{R}_{a}\left(
\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}\right)  .
\end{equation}

\end{remark}

\begin{remark}
Hence
\begin{equation}
A=V\sum_{1\leq j\leq r}\alpha_{j}P\left(  \Sigma\right)  _{j}W^{\dagger}%
=\sum_{1\leq j\leq r}\alpha_{j}\left[  VP\left(  \Sigma\right)  _{j}\right]
\left[  P\left(  \Sigma\right)  _{j}W^{\dagger}\right]  =\sum_{1\leq j\leq
r}\alpha_{j}\left[  VP\left(  \Sigma\right)  _{j}\right]  \left[  WP\left(
\Sigma\right)  _{j}\right]  ^{\dagger}%
\end{equation}

\end{remark}

\begin{corollary}
Using the map (defined later)
\begin{equation}
\Xi_{VV}^{-1}:\mathcal{L}\left(  V\right)  \rightarrow V\otimes V
\end{equation}
one obtains the tensor $a_{2}$%
\begin{equation}
a_{2}=\Xi_{VV}^{-1}\left(  A\right)  =\sum_{1\leq j\leq r}\Xi_{VV}^{-1}\left(
\sum_{1\leq j\leq r}\alpha_{j}\left[  VP\left(  \Sigma\right)  _{j}\right]
\left[  P\left(  \Sigma\right)  _{j}W^{\dagger}\right]  \right)  =\sum_{1\leq
j\leq r}\alpha_{j}v_{j}{\small \otimes}w_{j},
\end{equation}
and the tensor $a_{2}$ can be expanded as
\begin{equation}
a_{2}=\sum_{1\leq j\leq r}\alpha_{j}v_{j}{\small \otimes}w_{j}\equiv
\sum_{1\leq j\leq r}\alpha_{j}\left(  a_{2}\right)  v\left(  a_{2}\right)
_{j}{\small \otimes}w\left(  a_{2}\right)  _{j},
\end{equation}
however in these expansions $\left\{  \left.  v_{j}{\small ,}w_{j}\right\vert
1\leq j\leq r\right\}  $ \underline{are non unique} if $\operatorname*{Spec}%
\left\{  \Sigma\right\}  \equiv$ $\operatorname*{Spec}\left\{  \left(
A^{\dagger}A\right)  ^{\frac{1}{2}}\right\}  $ is degenerate.
\end{corollary}

\begin{corollary}%
\begin{equation}
A=\Xi_{VV}\left(  a_{2}\right)  .
\end{equation}

\end{corollary}

\begin{remark}%
\begin{align}
VP\left(  \Sigma\right)  _{j}  &  =V\left\vert a_{j}\right\rangle \left\langle
a_{j}\right\vert =\left\vert Va_{j}\right\rangle \left\langle a_{j}\right\vert
=\left\vert Va_{j}\right\rangle a_{j}^{d}=\left[  \left(  Va_{j}\right)
a_{j}^{d}\right]  =E_{\left(  Va_{j}\right)  a_{j}^{d}}\\
\left(  WP\left(  \Sigma\right)  _{j}\right)  ^{\dagger}  &  =\left\vert
a_{j}\right\rangle \left\langle a_{j}\right\vert W^{\dagger}=\left\vert
a_{j}\right\rangle \left\langle Wa_{j}\right\vert =\left[  a_{j}\left(
Wa_{j}\right)  ^{d}\right]  =E_{a_{j}\left(  Wa_{j}\right)  ^{d}}%
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
a_{2}=\sum_{1\leq j\leq r}\alpha_{j}v_{j}{\small \otimes}w_{j}=\sum_{1\leq
j\leq r}\alpha_{j}\left(  Va_{j}\right)  {\small \otimes}\left(
Wa_{j}\right)  ,
\end{equation}
where
\begin{align}
v_{j}  &  =v\left(  a_{2}\right)  _{j}=Va_{j}\\
w_{j}  &  =w\left(  a_{2}\right)  _{j}=Wa_{j}\\
1  &  \leq j\leq r.
\end{align}

\end{remark}

\begin{definition}
Elementary operators $E_{jk}\in\mathcal{L}\left(  V\right)  ,\,1\leq j,k\leq
r$ are defined by
\begin{equation}
E_{jk}\left(  v\right)  =\left(  e_{k}^{d}\left(  v\right)  \right)
e_{j}=e_{j}e_{k}^{d}\left(  v\right)  =\left[  e_{j}e_{k}^{d}\right]  \left(
v\right)  =\left\langle e_{k}^{d},v\right\rangle e_{j}=e_{j}\mathcal{R}%
_{e}\left(  v\right)  _{k},\,1\leq j,k\leq r.
\end{equation}

\end{definition}

\begin{notation}%
\begin{equation}
\left[  e_{j}e_{k}^{d}\right]  \equiv E_{jk}%
\end{equation}
so that
\begin{equation}
\left[  e_{j}e_{k}^{d}\right]  \left(  v\right)  \equiv e_{j}e_{k}^{d}\left(
v\right)  =E_{jk}\left(  v\right)  =\left\langle e_{k}^{d},v\right\rangle
e_{j}%
\end{equation}
and generalized elementary operators $E_{vw}$ by
\begin{equation}
vw^{d}\equiv\left[  vw^{d}\right]  \equiv E_{vw}%
\end{equation}
where
\begin{equation}
vw^{d}\left(  x\right)  =\left[  vw^{d}\right]  \left(  x\right)
=E_{vw}\left(  v\right)  =\left\langle w^{d},x\right\rangle v.
\end{equation}

\end{notation}

\begin{remark}
$e_{j}e_{k}^{d}$ and $vw^{d}$ are the pointwise products of a vector and a
linear functional.
\end{remark}

\begin{remark}
Generalized elementary operators have the products
\begin{equation}
E_{v_{1}w_{1}}E_{v_{2}w_{2}}=v_{1}w_{1}^{d}v_{2}w_{2}^{d}=v_{1}w_{1}%
^{d}\left(  v_{2}\right)  w_{2}^{d}=w_{1}^{d}\left(  v_{2}\right)  v_{1}%
w_{2}^{d}=w_{1}^{d}\left(  v_{2}\right)  E_{v_{1}w_{2}},
\end{equation}
which gives
\begin{equation}
E_{v_{1}w_{1}}E_{v_{1}w_{1}}=w_{1}^{d}\left(  v_{1}\right)  E_{v_{1}w_{1}},
\end{equation}
and
\begin{equation}
E_{v_{1}v_{1}}^{2}=E_{v_{1}v_{1}}E_{v_{1}v_{1}}=v_{1}^{d}\left(  v_{1}\right)
E_{v_{1}v_{1}}=E_{v_{1}v_{1}}.
\end{equation}

\end{remark}

\begin{remark}
In particular elementary operators $\left\{  \left.  E_{jk}\right\vert 1\leq
j,k\leq r\right\}  $ have the products
\begin{equation}
E_{jk}E_{lm}=\delta_{kl}E_{jm},1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{lemma}
The adjoint $\left(  E_{v_{1}w_{1}}\right)  ^{\dagger}$ of $E_{v_{1}w_{1}}$ is
given by
\begin{equation}
\left(  E_{v_{1}w_{1}}\right)  ^{\dagger}=E_{w_{1}v_{1}}%
\end{equation}
in particular
\begin{equation}
\left(  E_{v_{1}v_{1}}\right)  ^{\dagger}=E_{v_{1}v_{1}}.
\end{equation}

\end{lemma}

\begin{lemma}
$E_{v_{1}w_{1}}$ are partial isometries%
\begin{equation}
\left(  E_{v_{1}w_{1}}\right)  ^{\dagger}E_{v_{1}w_{1}}=E_{w_{1}v_{1}}%
E_{v_{1}w_{1}}=E_{w_{1}w_{1}}=E_{w_{1}w_{1}}^{2}.
\end{equation}

\end{lemma}

\begin{remark}
Self adjoint idempotents $\equiv$ orthogonal projectors are partial isometries.
\end{remark}

\begin{remark}
The representation $\mathcal{R}_{e}\left(  A\right)  $ of $A\in\mathcal{L}%
\left(  V\right)  \ wrt$ the basis $\left(  \mathbf{e}\right)  $ is produced
by
\begin{align}
A\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A\right) \\
\left(  \mathbf{e}^{d}\right)  ^{t}\left(  A\left(  \mathbf{e}\right)
\right)   &  =\left[  \left(  \mathbf{e}^{d}\right)  ^{t}\left(
\mathbf{e}\right)  \right]  \mathcal{R}_{e}\left(  A\right)  =\mathcal{R}%
_{e}\left(  A\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  Ae_{1}\right)  & \cdots & e_{1}^{d}\left(  Ae_{r}\right) \\
\vdots & \ddots & \vdots\\
e_{r}^{d}\left(  Ae_{1}\right)  & \cdots & e_{r}^{d}\left(  Ae_{r}\right)
\end{array}
\right)  .
\end{align}

\end{remark}

\begin{remark}
The $k^{th}$ \emph{row} of $A$ is $\mathcal{R}_{e}\left(  A\right)  ^{k}=$
$\left\{  \left.  e_{k}^{d}\left(  Ae_{j}\right)  \right\vert 1\leq j\leq
r\right\}  $ and $j^{th}$ \emph{column} is $\mathcal{R}_{e}\left(  A\right)
_{j}=$ $\left\{  \left.  e_{k}^{d}\left(  Ae_{j}\right)  \right\vert 1\leq
k\leq r\right\}  .$
\end{remark}

\begin{remark}
$A$ has the dyadic expansion
\begin{equation}
A=\sum_{1\leq j,k\leq r}\left[  e_{j}e_{k}^{d}\right]  \mathcal{R}_{e}\left(
A\right)  _{jk}=\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}_{e}\left(  A\right)
_{jk}e_{k}^{d}=\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k\leq r}\mathcal{R}%
_{e}\left(  A\right)  _{jk}e_{k}^{d}=\sum_{1\leq j\leq r}\left[  e_{j}%
a_{j}^{d}\right]  ,
\end{equation}
where the vectors $a_{j}^{d}\in V^{d}$ have the expansion
\begin{equation}
a_{j}^{d}=\sum_{1\leq k\leq r}e_{k}^{d}\mathcal{R}_{e}\left(  A\right)
_{jk}=\sum_{1\leq k\leq r}e_{k}^{d}\mathcal{R}_{e}\left(  A\right)  _{jk}.
\end{equation}
The expansion of $A$ is also given by the dyadic expansion
\begin{equation}
A=\sum_{1\leq j,k\leq r}\left[  e_{j}e_{k}^{d}\right]  \mathcal{R}_{e}\left(
A\right)  _{jk}=\sum_{1\leq j,k\leq r}\left[  e_{j}e_{k}^{d}\right]
\mathcal{R}_{e}\left(  A\right)  _{jk}=\sum_{1\leq k\leq r}\sum_{1\leq j\leq
r}e_{j}\mathcal{R}_{e}\left(  A\right)  _{jk}e_{k}^{d}=\sum_{1\leq k\leq
r}\left[  a_{k}e_{k}^{d}\right]  ,
\end{equation}
where the vectors $a_{k}\in V$ have the expansion%
\begin{equation}
a_{k}=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  A\right)  _{jk},
\end{equation}
hence
\begin{equation}
A=\sum_{1\leq k\leq r}\left[  a_{k}e_{k}^{d}\right]  =\sum_{1\leq j\leq
r}\left[  e_{j}a_{j}^{d}\right]  .
\end{equation}

\end{remark}

\begin{remark}
$A\in\mathcal{L}\left(  V\right)  $ can be expanded in $e$-\emph{column form}
as
\begin{equation}
A=\sum_{1\leq k\leq r}\sum_{1\leq j\leq r}\left[  e_{j}e_{k}^{d}\right]
\mathcal{R}_{e}\left(  A\right)  _{jk}=\sum_{1\leq k\leq r}\mathfrak{C}%
_{e}\left(  A\right)  _{k},
\end{equation}
where $\mathfrak{C}_{e}\left(  A\right)  _{k}$ $\in\mathcal{L}\left(
V\right)  $ are the $e$-\emph{column} operators of $A$
\begin{equation}
\mathfrak{C}_{e}\left(  A\right)  _{k}=\sum_{1\leq j\leq r}\left[  e_{j}%
e_{k}^{d}\right]  \mathcal{R}_{e}\left(  A\right)  _{jk}%
\end{equation}
and $e$-\emph{row form} as
\begin{equation}
A=\sum_{1\leq j\leq r}\sum_{1\leq k\leq r}\left[  e_{j}e_{k}^{d}\right]
\mathcal{R}_{e}\left(  A\right)  _{jk}=\sum_{1\leq j\leq r}\mathfrak{R}%
_{e}\left(  A\right)  _{j},
\end{equation}
where $\mathfrak{R}_{e}\left(  A\right)  _{k}$ $\in\mathcal{L}\left(
V\right)  $ are the $e$-\emph{row} operators of $A$
\begin{equation}
\mathfrak{R}_{e}\left(  A\right)  _{j}=\sum_{1\leq k\leq r}\left[  e_{j}%
e_{k}^{d}\right]  \mathcal{R}_{e}\left(  A\right)  _{jk}.
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item $\mathcal{R}_{e}\left(  \mathfrak{C}_{e}\left(  A\right)  _{k}\right)  $
are the columns of $\mathcal{R}_{e}\left(  A\right)  $
\begin{equation}
\mathfrak{C}_{e}\left(  A\right)  _{k}\left(  \mathbf{e}\right)  =\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  \mathfrak{C}_{e}\left(  A\right)
_{k}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  \mathfrak{C}_{e}\left(  A\right)  _{k}\right)
_{pq}=\mathcal{R}_{e}\left(  A\right)  _{pq}\delta_{kq},\quad1\leq p\leq r
\end{equation}
and

\item $\mathcal{R}_{e}\left(  \mathfrak{R}_{e}\left(  A\right)  _{k}\right)  $
are the rows of $\mathcal{R}_{e}\left(  A\right)  $%
\begin{equation}
\mathfrak{R}_{e}\left(  A\right)  _{k}\left(  \mathbf{e}\right)  =\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  \mathfrak{R}_{e}\left(  A\right)
_{k}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  \mathfrak{R}_{e}\left(  A\right)  _{k}\right)
_{pq}=\mathcal{R}_{e}\left(  A\right)  _{pq}\delta_{kp},\quad1\leq q\leq r.
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}%
\begin{equation}
\left(  \mathbf{ee}^{d}\right)  =\left(
\begin{array}
[c]{ccccccc}%
e_{1}e_{1}^{d} & \cdots & e_{1}e_{r}^{d} & \cdots & e_{r}e_{1}^{d} & \cdots &
e_{r}e_{r}^{d}%
\end{array}
\right)
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
A=\left(  \mathbf{ee}^{d}\right)  \mathcal{R}_{ee^{d}}\left(  A\right)
\equiv\left(  \left[  \mathbf{ee}^{d}\right]  \right)  \mathcal{R}_{ee^{d}%
}\left(  A\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{ee^{d}}\left(  A\right)  _{jk}=\mathcal{R}_{e}\left(  A\right)
_{jk}\equiv\mathcal{R}_{e}\left(  A\right)  _{k}^{j},\quad1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{lemma}
The map $\Xi_{VV^{d}}$ from the mixed tensor product $V\otimes V^{d}$ to
linear operators $\mathcal{L}\left(  V\right)  $ acting in $V$
\begin{equation}
\Xi_{VV^{d}}:V\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
given by
\begin{equation}
v\otimes w^{d}\rightarrow vw^{d}%
\end{equation}
is a $\mathbb{C}$-linear isomorphism.
\end{lemma}

\begin{definition}
The injective map $\Theta_{V^{d}V}$ from the tensor product $V\otimes V$ to
the mixed tensor product $V\otimes V^{d}$
\begin{equation}
\Theta_{V^{d}V}:V\otimes V\rightarrow V\otimes V^{d}%
\end{equation}
is defined by
\begin{equation}
\Theta_{V^{d}V}=I_{V}\otimes\digamma_{e}.
\end{equation}
and has the effect
\begin{equation}
\Theta_{V^{d}V}\left(  v\otimes w\right)  =\left[  I_{V}\otimes\digamma
_{e}\right]  \left(  v\otimes w\right)  =v\otimes\digamma_{e}\left(  w\right)
=v\otimes w^{d}.
\end{equation}

\end{definition}

\begin{definition}
The map $\Theta_{V^{d}V}$ can be composed with $\Xi_{VV^{d}}$ to produce the
map $\Xi_{VV}$ that acts in $V\otimes V$ to produce operators acting in $V$
i.e.
\begin{equation}
\Xi_{VV}:V\otimes V\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
and in particular produces generalized elementary operators $E_{vw}%
\in\mathcal{L}\left(  V\right)  $ by
\begin{equation}
\Xi_{VV}\left(  v\otimes w\right)  =\left[  \Xi_{VV^{d}}\circ\Theta_{V^{d}%
V}\right]  \left(  v\otimes w\right)  =\Xi_{VV^{d}}\left(  v\otimes
w^{d}\right)  =E_{vw}=vw^{d}\equiv\left[  vw^{d}\right]  \in\mathcal{L}\left(
V\right)  .
\end{equation}

\end{definition}

\begin{remark}
This can be generalized to produce \emph{any} operator $A\in\mathcal{L}\left(
V\right)  $ by
\begin{equation}
\Xi_{VV}\left(  \sum_{1\leq j\leq r}v_{j}\otimes w_{j}\right)  =\sum_{1\leq
j\leq r}v_{j}w_{j}^{d}=\sum_{1\leq j\leq r}v_{j}\digamma_{e}\left(
w_{j}\right)
\end{equation}

\end{remark}

\begin{lemma}
Let $\digamma_{e}=\digamma_{\left\vert e\right\rangle }$ then
\begin{equation}
\Xi_{V\left\vert V\right\rangle }:V\otimes V\rightarrow\mathcal{L}\left(
V\right)  .
\end{equation}
is \emph{sesquilinear} i.e.
\begin{equation}
\Xi_{V\left\vert V\right\rangle }\left(  \alpha v_{1}+\beta v_{2},w\right)
=\alpha\Xi_{V\left\vert V\right\rangle }\left(  v_{1},w\right)  +\beta
\Xi_{V\left\vert V\right\rangle }\left(  v_{2},w\right)
\end{equation}
and%
\begin{equation}
\Xi_{V\left\vert V\right\rangle }\left(  v,\alpha w_{1}+\beta w_{2}\right)
=\sigma\left(  \alpha\right)  \Xi_{V\left\vert V\right\rangle }\left(
v,w_{1}\right)  +\sigma\left(  \beta\right)  \Xi_{V\left\vert V\right\rangle
}\left(  v,w_{2}\right)  .
\end{equation}

\end{lemma}

\begin{remark}
The conjugations $\sigma$
\begin{align}
\sigma &  :\mathbb{C\rightarrow C}\\
\sigma\left(  z\right)   &  =\left\{
\begin{array}
[c]{c}%
\overline{z}\\
z
\end{array}
\right.  .
\end{align}
If $\sigma=id$ then sesqulinear $\rightarrow$ linear.
\end{remark}

\begin{remark}
The rows of the representation matrix $\mathcal{R}_{e}\left(  A\right)  $ are
given in terms of the representations of the dual vectors $\left\{  \left.
a_{l}^{d}\right\vert 1\leq l\leq r\right\}  ,$ which we call the \emph{row
vectors} of $A,$ as
\begin{equation}
e_{l}^{d}\left(  A\left(  \mathbf{e}\right)  \right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  A\right)  _{l1} & \cdots & \mathcal{R}_{e}\left(
A\right)  _{lr}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  a_{l}\right)  _{1} & \cdots & \mathcal{R}_{e}\left(
a_{l}\right)  _{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  Ae_{1}\right)  & \cdots & e_{1}^{d}\left(  Ae_{r}\right)
\end{array}
\right)  =\mathcal{R}_{e^{d}}\left(  a_{l}^{d}\right)  ,
\end{equation}
while the columns are given in terms of the representations of the vectors,
which we call the \emph{column vectors} of $A,$ $\left\{  \left.
a_{m}\right\vert 1\leq m\leq r\right\}  $ as
\begin{equation}
\mathbf{e}^{d}\left(  A\left(  e_{m}\right)  \right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  A\right)  _{1m}\\
\vdots\\
\mathcal{R}_{e}\left(  A\right)  _{rm}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  a_{m}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  a_{m}\right)  _{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\left(  Ae_{1}\right) \\
\vdots\\
e_{r}^{d}\left(  Ae_{1}\right)
\end{array}
\right)  =\mathcal{R}_{e}\left(  a_{m}\right)  .
\end{equation}

\end{remark}

\begin{remark}
Recall
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\mathcal{M}_{e^{d}e}\left(  A\right)
=\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  Ae_{1}\right)  & \cdots & e_{1}^{d}\left(  Ae_{r}\right) \\
\vdots & \ddots & \vdots\\
e_{r}^{d}\left(  Ae_{1}\right)  & \cdots & e_{r}^{d}\left(  Ae_{r}\right)
\end{array}
\right)  =\left(  \mathbf{e}^{d}\right)  ^{t}A\left(  \mathbf{e}\right)
\mathbf{.}%
\end{equation}

\end{remark}

\begin{remark}
The resolution of the identity
\begin{equation}
\mathbf{e}\left(  \mathbf{e}^{d}\right)  ^{t}=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right)  =I_{V}=\sum_{1\leq j\leq r}e_{j}e_{j}^{d}%
\end{equation}
can be used in obtaining the representation of the SVD of $A$, where

\begin{enumerate}
\item The SVD of $A$ is expressed as
\begin{equation}
A=V\left(  A\right)  \Sigma\left(  A\right)  W\left(  A\right)  ^{\dagger},
\end{equation}
where
\begin{equation}
V\left(  A\right)  ^{\dagger}V\left(  A\right)  =W\left(  A\right)  ^{\dagger
}W\left(  A\right)  =I_{V}%
\end{equation}
and
\begin{equation}
\Sigma\left(  A\right)  =\sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\vert
P\left(  A^{\dagger}A\right)  _{j},\quad\alpha_{j}^{2}\in\operatorname*{Spec}%
\left(  A^{\dagger}A\right)  .
\end{equation}


\item For convenience we set

\begin{enumerate}
\item
\begin{align}
V\left(  A\right)   &  =V\\
W\left(  A\right)   &  =W\\
\Sigma\left(  A\right)   &  =\left(  A^{\dagger}A\right)  ^{\frac{1}{2}%
}=\Sigma=\sum_{1\leq j\leq r}\alpha_{j}P\left(  \Sigma\right)  _{j}%
=\sum_{1\leq j\leq r}\alpha_{j}P\left(  \left(  A^{\dagger}A\right)
^{\frac{1}{2}}\right)  _{j}=\sum_{1\leq j\leq r}\alpha_{j}P\left(  A^{\dagger
}A\right)  _{j}%
\end{align}
one obtains

\item
\begin{align}
A^{\dagger}A  &  =W\Sigma^{\dagger}V^{\dagger}V\Sigma W^{\dagger}%
=W\Sigma^{\dagger}\Sigma W^{\dagger}=W\sum_{1\leq j\leq r}\alpha_{j}%
^{2}P\left(  A^{\dagger}A\right)  _{j}W^{\dagger}=\sum_{1\leq j\leq r}%
\alpha_{j}^{2}WP\left(  A^{\dagger}A\right)  _{j}W^{\dagger}\\
AA^{\dagger}  &  =V\Sigma W^{\dagger}W\Sigma^{\dagger}V^{\dagger}%
=V\Sigma\Sigma^{\dagger}V^{\dagger}=V\sum_{1\leq j\leq r}\alpha_{j}%
^{2}P\left(  AA^{\dagger}\right)  _{j}V^{\dagger}=\sum_{1\leq j\leq r}%
\alpha_{j}^{2}VP\left(  AA^{\dagger}\right)  _{j}V^{\dagger}%
\end{align}
giving%
\begin{align}
\Sigma^{\dagger}\Sigma &  =W^{\dagger}\left(  A^{\dagger}A\right)  ^{\frac
{1}{2}}W\\
\Sigma\Sigma^{\dagger}  &  =V^{\dagger}\left(  AA^{\dagger}\right)  ^{\frac
{1}{2}}V.
\end{align}

\end{enumerate}

\item and hence the spectral expansions

\begin{enumerate}
\item
\begin{equation}
\sum_{1\leq j\leq r}\alpha_{k}E_{a_{k}a_{k}^{d}}=\mathcal{K}^{\dagger}\left(
\Sigma^{\dagger}\Sigma\right)  \mathcal{K}=\mathcal{K}^{\dagger}W^{\dagger
}\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}W\mathcal{K}=\mathcal{W}^{\dagger
}\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}\mathcal{W}%
\end{equation}


\item
\begin{equation}
\sum_{1\leq j\leq r}\alpha_{k}E_{b_{k}b_{k}^{d}}=\mathcal{J}^{\dagger}\left(
\Sigma\Sigma^{\dagger}\right)  \mathcal{J}=\mathcal{J}^{\dagger}V^{\dagger
}\left(  AA^{\dagger}\right)  ^{\frac{1}{2}}V\mathcal{J}=\mathcal{V}^{\dagger
}\left(  AA^{\dagger}\right)  ^{\frac{1}{2}}\mathcal{V},
\end{equation}
where
\begin{equation}
\alpha_{k}\geq0,\quad1\leq k\leq r.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
Hence the \emph{columns} of $\mathcal{R}_{e}\left(  W\right)  $ determine the
eigenvectors of $A^{\dagger}A$ and the \emph{columns} of $\mathcal{R}%
_{e}\left(  V\right)  $ determine the eigenvectors of $AA^{\dagger}.$
\end{remark}

\begin{lemma}
The spectrums $\sigma\left(  A^{\dagger}A\right)  $ and $\sigma\left(
AA^{\dagger}\right)  $ are identical i.e.
\begin{equation}
\sigma\left(  A^{\dagger}A\right)  =\sigma\left(  AA^{\dagger}\right)  .
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{equation}
A^{\dagger}Aa_{k}=\alpha_{k}a_{k},\quad1\leq k\leq r
\end{equation}
and
\begin{equation}
AA^{\dagger}b_{k}=\alpha_{k}b_{k},\quad1\leq k\leq r.
\end{equation}

\end{corollary}

\begin{enumerate}
\item[4] Using the resolution of the identity $I_{V}=\mathbf{e}\left(
\mathbf{e}^{d}\right)  ^{t}$ one obtains
\begin{equation}
A=\left(  \mathbf{e}\right)  \left[  \left(  \mathbf{e}^{d}\right)
^{t}V\mathbf{e}\right]  \left[  \left(  \mathbf{e}^{d}\right)  ^{t}%
\Sigma\mathbf{e}\right]  \left[  \left(  \mathbf{e}^{d}\right)  ^{t}%
W\mathbf{e}\right]  ^{\dagger}\left(  \mathbf{e}^{d}\right)  ^{t}=\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  V\right)  \mathcal{R}_{e}\left(
\Sigma\right)  \mathcal{R}_{e}\left(  W\right)  ^{\dagger}\left(
\mathbf{e}^{d}\right)  ^{t}.
\end{equation}
giving
\begin{equation}
A=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  V\Sigma W^{\dagger
}\right)  \left(  \mathbf{e}^{d}\right)  ^{t}=\left(  \mathbf{e}\right)
\left(  \mathbf{e}^{d}\right)  \mathcal{R}_{ee^{d}}\left(  V\Sigma W^{\dagger
}\right)  =\left(  \mathbf{ee}^{d}\right)  \mathcal{R}_{ee^{d}}\left(  V\Sigma
W^{\dagger}\right)  =\left(  \mathbf{E}\right)  \mathcal{R}_{ee^{d}}\left(
V\Sigma W^{\dagger}\right)  ,
\end{equation}

\end{enumerate}

\begin{remark}


\begin{enumerate}
\item[5] and the expansions
\begin{align}
A  &  =\mathbf{e}^{t}\left[  \mathbf{e}^{d}A\mathbf{e}^{t}\right]
\mathbf{e}^{d}=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)
\left(  \mathbf{e}^{d}\right)  ^{t}\\
V  &  =\mathbf{e}^{t}\left[  \mathbf{e}^{d}V\mathbf{e}^{t}\right]
\mathbf{e}^{d}=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  V\right)
\left(  \mathbf{e}^{d}\right)  ^{t}\\
W  &  =\mathbf{e}^{t}\left[  \mathbf{e}^{d}W\mathbf{e}^{t}\right]
\mathbf{e}^{d}=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  W\right)
\left(  \mathbf{e}^{d}\right)  ^{t}\\
\Sigma &  =\mathbf{e}^{t}\left[  \mathbf{e}^{d}\Sigma\mathbf{e}^{t}\right]
\mathbf{e}^{d}=\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(
\Sigma\right)  \left(  \mathbf{e}^{d}\right)  ^{t}.
\end{align}


\item[6] The SVD of $A$ gives
\begin{equation}
\Sigma=V^{\dagger}AW.
\end{equation}


\item[7] The representations of $\Sigma$

\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{e}\left(  \Sigma\right)  =\mathcal{R}_{e}\left(  V\right)
^{\dagger}\mathcal{R}_{e}\left(  A\right)  \mathcal{R}_{e}\left(  W\right)
\end{equation}
$\mathcal{R}_{e}\left(  \Sigma\right)  $ is \emph{not} a diagonal matrix
unless $\left(  \mathbf{e}\right)  =\left(  \mathbf{a}\right)  ,$

\item while%
\begin{equation}
\mathcal{R}_{a}\left(  \Sigma\right)  =\mathcal{R}_{a}\left(  V\right)
^{\dagger}\mathcal{R}_{a}\left(  A\right)  \mathcal{R}_{a}\left(  W\right)
\end{equation}
\emph{is} a diagonal matrix.
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
The general decomposition
\begin{equation}
A=V^{\prime}\Sigma^{\prime}W^{\prime\dagger},
\end{equation}
with
\begin{equation}
V^{\prime\dagger}V^{\prime}=W^{\prime\dagger}W^{\prime}=I_{V}%
\end{equation}
is highly non unique, while the SVD of $A$
\begin{equation}
A=V\left(  A\right)  \Sigma\left(  A\right)  W\left(  A\right)  ^{\dagger},
\end{equation}
is produced in the special case when $\Sigma\left(  A\right)  $ is positive
i.e.
\begin{equation}
\Sigma\left(  A\right)  =\int_{\mathbb{R}_{+}}xdP\left(  \Sigma\left(
A\right)  ,x\right)  ,
\end{equation}
which gives in the compact case $A\in\mathcal{B}_{00}\left(  A\right)  $
\begin{equation}
\Sigma\left(  A\right)  =\sum_{1\leq j\leq r}\alpha_{j}P\left(  \Sigma\left(
A\right)  \right)  _{j}=\sum_{1\leq j\leq r}\alpha_{j}a_{j}a_{j}^{d}%
=\sum_{1\leq j\leq r}\alpha_{j}E_{a_{j}a_{j}^{d}},\quad\alpha_{j}\geq
0,\quad1\leq j\leq r.
\end{equation}

\end{remark}

\begin{lemma}
The SVD of $A\in\mathcal{B}_{00}\left(  A\right)  \ $is given by
\begin{equation}
A=V\left(  A\right)  \Sigma\left(  A\right)  W\left(  A\right)  ^{\dagger},
\end{equation}
where $V\left(  A\right)  $ and $W\left(  A\right)  $ are unitary i.e.
\begin{equation}
V\left(  A\right)  V\left(  A\right)  ^{\dagger}=V\left(  A\right)  ^{\dagger
}V\left(  A\right)  =W\left(  A\right)  W\left(  A\right)  ^{\dagger}=W\left(
A\right)  ^{\dagger}W\left(  A\right)  =I_{A}%
\end{equation}
and
\begin{equation}
\Sigma\left(  A\right)  =\sum_{1\leq j\leq r}E_{a_{j}a_{j}^{d}}\mathcal{R}%
_{a}\left(  \Sigma\left(  A\right)  \right)  _{jj}=\sum_{1\leq j\leq r}%
\alpha_{j}E_{a_{j}a_{j}^{d}},
\end{equation}
where $\left\{  \left.  a_{j}\right\vert 1\leq j\leq r\right\}  $ are the
eigenvectors of $\Sigma\left(  A\right)  .$ This SVD is unique up to
degeneracies in the spectrum $\sigma\left(  \Sigma\left(  A\right)  \right)
\equiv\operatorname*{Spec}\left\{  \Sigma\left(  A\right)  \right\}  $ that
produces different $V\left(  A\right)  ^{\prime}s$ and $W\left(  A\right)
^{\prime}s$ i.e. up to unitary transformations $\Upsilon\left(  A\right)  $
\begin{equation}
\Upsilon\left(  A\right)  \Sigma\left(  A\right)  \Upsilon\left(  A\right)
^{\dagger}=\Sigma\left(  A\right)
\end{equation}
leading to
\begin{equation}
V\left(  A\right)  \Sigma\left(  A\right)  W\left(  A\right)  ^{\dagger
}=V\left(  A\right)  \Upsilon\left(  A\right)  \Sigma\left(  A\right)
\Upsilon\left(  A\right)  ^{\dagger}W\left(  A\right)  ^{\dagger}.
\end{equation}

\end{lemma}

\begin{theorem}
Any nuclear operator $A\in\mathcal{B}_{00}\left(  V\right)  $ can be expanded
as
\begin{equation}
A=\sum_{1\leq j\leq r}\mathcal{R}_{a}\left(  \Sigma\right)  _{jj}v_{j}%
w_{j}^{d}\equiv\sum_{1\leq j\leq r}v_{j}\mathcal{R}_{a}\left(  \Sigma\right)
_{jj}w_{j}^{d},
\end{equation}
where
\begin{equation}
\mathcal{R}_{a}\left(  \Sigma\right)  _{jj}\in\mathbb{R}^{+},\quad v_{j}\in
V,\quad w_{j}^{d}\in V^{d}.
\end{equation}

\end{theorem}

\begin{proof}
The operators $V,\Sigma$ and $W$ can be expanded as

\begin{enumerate}
\item
\begin{equation}
V\mathbf{\ }=\sum_{1\leq j\leq r}v_{j}v_{j}^{d}=\sum_{1\leq k\leq r}\left(
v_{k}e_{k}^{d}\right)
\end{equation}


\item
\begin{equation}
W\mathbf{\ }=\sum_{1\leq j\leq r}w_{j}w_{j}^{d}=\sum_{1\leq k\leq r}\left(
w_{k}e_{k}^{d}\right)
\end{equation}


\item
\begin{equation}
\Sigma=\sum_{1\leq j\leq r}a_{j}a_{j}^{d}\mathcal{R}_{a}\left(  \Sigma\right)
_{jj}%
\end{equation}
giving

\item
\begin{align}
A  &  =V\Sigma W=\sum_{1\leq j\leq r}a_{j}v_{j}^{d}\sum_{1\leq k\leq r}%
a_{k}a_{k}^{d}\mathcal{R}_{a}\left(  \Sigma\right)  _{kk}\sum_{1\leq l\leq
r}w_{l}a_{l}^{d}\\
&  =\sum_{1\leq j,l,k\leq r}\mathcal{R}_{a}\left(  \Sigma\right)  _{kk}%
a_{j}v_{j}^{d}a_{k}a_{k}^{d}w_{l}a_{l}^{d}\\
&  =\sum_{1\leq j,l,k\leq r}\mathcal{R}_{a}\left(  \Sigma\right)  _{kk}%
a_{j}\left(  v_{k}^{d}\right)  a_{k}a_{k}^{d}\left(  w_{l}\right)  a_{l}^{d}\\
&  =\sum_{1\leq j,l,k\leq r}\left(  a_{k}a_{l}^{d}\right)  a_{j}\left(
v_{k}^{d}\right)  \mathcal{R}_{a}\left(  \Sigma\right)  _{kk}a_{k}^{d}\left(
w_{l}\right) \\
&  =\sum_{1\leq j,l,k\leq r}\left(  a_{k}a_{l}^{d}\right)  \mathcal{R}%
_{a}\left(  v_{k}\right)  _{j}\mathcal{R}_{a}\left(  \Sigma\right)
_{kk}\mathcal{R}_{a}\left(  w_{l}^{d}\right)  _{k}\\
&  =\sum_{1\leq j,l,k\leq r}\mathcal{R}_{a}\left(  v_{k}\right)  _{j}\left(
a_{k}a_{l}^{d}\right)  \mathcal{R}_{a}\left(  w_{l}^{d}\right)  _{k}%
\mathcal{R}_{a}\left(  \Sigma\right)  _{kk}\\
&  =\sum_{1\leq k\leq r}\left(  \sum_{1\leq j\leq r}\mathcal{R}_{a}\left(
v_{k}\right)  _{j}a_{k}\sum_{1\leq l\leq r}\mathcal{R}_{a}\left(  w_{l}%
^{d}\right)  _{k}a_{l}^{d}\right)  \mathcal{R}_{a}\left(  \Sigma\right)
_{kk}\\
&  =\sum_{1\leq k\leq r}\left(  v_{k}w_{k}^{d}\right)  \mathcal{R}_{a}\left(
\Sigma\right)  _{kk}%
\end{align}
i.e.%
\begin{equation}
A=\sum_{1\leq j\leq r}\mathcal{R}_{a}\left(  \Sigma\right)  _{jj}v_{j}%
w_{j}^{d}%
\end{equation}
that proves the thereom and also gives
\begin{equation}
\mathcal{R}_{a}\left(  A\right)  =\sum_{1\leq j\leq r}\mathcal{R}_{a}\left(
\Sigma\right)  _{jj}\mathcal{R}_{a}\left(  v_{j}w_{j}^{d}\right)  =\sum_{1\leq
j\leq r}\mathcal{R}_{a}\left(  \Sigma\right)  _{jj}\mathcal{R}_{a}\left(
v_{j}\right)  \mathcal{R}_{a}\left(  w_{j}^{d}\right)  =\sum_{1\leq j\leq
r}\mathcal{R}_{a}\left(  \Sigma\right)  _{jj}\mathcal{R}_{a}\left(
v_{j}\right)  \mathcal{R}_{a}\left(  w_{j}\right)  ^{d}.
\end{equation}

\end{enumerate}
\end{proof}

\begin{corollary}
A nuclear operator $A\in\mathcal{B}_{00}\left(  V\right)  \subseteq
\mathcal{L}\left(  V\right)  $ can be expanded as
\begin{equation}
A=\sum_{1\leq j\leq r}\widetilde{v_{j}}\widetilde{w}_{j}^{d}.
\end{equation}

\end{corollary}

\begin{proof}
$A$ has the SVD
\begin{equation}
A=V\Sigma W=V\Sigma^{\frac{1}{2}}\Sigma^{\frac{1}{2}}W=\widetilde{V}%
\widetilde{W},
\end{equation}
through which one can define $\widetilde{V}$ and $\widetilde{W}$ and hence the
sum $\sum_{1\leq j\leq r}\widetilde{v_{j}}\widetilde{w}_{j}^{d}.$
\end{proof}

\begin{definition}
Any complex vector space $V$ has a corresponding dual vector space $V^{d}$ (or
just dual space for short) consisting of all $\mathbb{C}$-linear forms on $V$
together with the vector space structure of pointwise addition and scalar
multiplication by constants.
\end{definition}

\begin{definition}
The dual space as defined above is defined for all vector spaces, and to avoid
ambiguity may also be called the \emph{algebraic }dual space. When defined for
a topological vector space, there is a \emph{subspace of the dual space},
corresponding to \emph{continuous} linear functionals, called a
\emph{continuous dual space, which depends on an imposed topology}.
\end{definition}

\begin{definition}
In linear algebra, given a vector space $V$ with a basis $B$ of vectors
indexed by an index set $I$ (the cardinality of $I$ is the dimensionality of
$V$), the dual set of $B$ is a set $B^{d}$ of vectors in the dual space
$V^{d}$ with the same index set $I$ such that $B$ and $B^{d}$ form a
\underline{\emph{biorthogonal}} system i.e
\begin{equation}
e_{j}^{d}\left(  e_{k}\right)  =\delta_{jk},\quad j,k\in I.
\end{equation}
The dual set is always linearly independent but does not necessarily span
$V^{d}$. If it does span $V^{d}$, then $B^{d}$ is called the \emph{dual basis}
or \emph{reciprocal basis} for the basis $B$.
\end{definition}

\begin{notation}%
\begin{equation}
\left\langle v^{d},w\right\rangle =v^{d}\left(  w\right)  .
\end{equation}

\end{notation}

\begin{notation}
Dual basis
\begin{equation}
\left(  \mathbf{e}^{d}\right)  =\left\{  \left.  e_{j}^{d}\right\vert
e_{j}^{d}\left(  e_{k}\right)  =\left\langle e_{j}^{d},e_{k}\right\rangle
=\delta_{jk},\quad j,k\in I\right\}  .
\end{equation}

\end{notation}

\begin{definition}
A linear transformation $T$ from a vector space $V$ to a vector space $W$ is
called an \emph{isomorphism of vector spaces} if $T$ is both \emph{injective}
and \emph{surjective}.
\end{definition}

\begin{remark}
If $V$ is infinite dimensional there are many dual sets $B^{d}$ that span
subspaces $K\left\{  B\right\}  $ of $V^{d}$ with corresponding dual bases
$\left(  \mathbf{e}^{d}\right)  _{K\left(  B\right)  }$, which are isomorphic
to $V$ i.e. $V$ can be embedded \emph{into} $V^{d}$ by $\emph{injections}$
$\digamma_{e}$ in many ways.
\end{remark}

\begin{notation}
We denote these injections as
\begin{equation}
\digamma_{e}:V\rightarrow K\left\{  B\right\}  \subset V^{d}.
\end{equation}

\end{notation}

\begin{remark}
These injections are given by
\begin{equation}
v^{d}=\digamma_{e}\left(  v\right)  =\digamma_{e}\left(  \sum_{1\leq j\leq
r}e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}\right)  =\sum_{1\leq j\leq
r}\digamma_{e}\left(  e_{j}\right)  \mathcal{R}_{e}\left(  v\right)  _{j}%
=\sum_{1\leq j\leq r}e_{j}^{d}\mathcal{R}_{e}\left(  v\right)  _{j},
\end{equation}
which can be recast as
\begin{equation}
v^{d}=\digamma_{e}\left(  v\right)  =\digamma_{e}\left(  \overset{}{\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  v\right)  }\right)  =\left(
\mathbf{e}^{d}\right)  \mathcal{R}_{e^{d}}\left(  v\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{e^{d}}\left(  v\right)  =\mathcal{R}_{e}\left(  v\right)  ,
\end{equation}
which in fact defines $\digamma_{e}.$
\end{remark}

\begin{example}
\begin{enumerate}
\item Let $\digamma_{e}=\digamma_{\left\vert e\right)  }$ then
\begin{equation}
v^{d}=\digamma_{\left\vert e\right)  }\left(  v\right)  =\digamma_{\left\vert
e\right)  }\left(  \overset{}{\left(  \left\vert \mathbf{e}\right)  \right)
\mathcal{R}_{e}\left(  v\right)  }\right)  =\left(  \left(  \mathbf{e}%
^{b}\right\vert \right)  \mathcal{R}_{e}\left(  v\right)  =\left(  \left(
\mathbf{e}\right\vert \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\right)  \mathcal{R}_{e}\left(  v\right)  .
\end{equation}


\item Let $\digamma_{e}=\digamma_{\left\vert e\right\rangle }$ then
\begin{equation}
v^{d}=\digamma_{\left\vert e\right\rangle }\left(  v\right)  =\digamma
_{\left\vert e\right\rangle }\left(  \overset{}{\left(  \left\vert
\mathbf{e}\right\rangle \right)  \mathcal{R}_{e}\left(  v\right)  }\right)
=\left(  \left\langle \mathbf{e}\right\vert \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\right)  \mathcal{R}%
_{e}\left(  v\right)  .
\end{equation}


\item Let $\digamma_{e}=\digamma_{\left\vert e\right)  }$ then
\begin{align}
v^{d}\wedge w^{d}  &  =\digamma_{\left\vert e\wedge e\right)  }\left(  v\wedge
w\right)  =\digamma_{\left\vert e\wedge e\right)  }\left(  \overset{}{\left(
\left\vert \mathbf{e\wedge e}\right)  \right)  \mathcal{R}_{e}\left(
v\mathbf{\wedge}w\right)  }\right)  =\left(  \left(  \mathbf{e}^{b}%
\wedge\mathbf{e}^{b}\right\vert \right)  \mathcal{R}_{\left(  e\wedge
e\right)  }\left(  v\mathbf{\wedge}w\right) \\
&  =\left(  \left(  \mathbf{e\wedge e}\right\vert \left(  \left.
\mathbf{e\wedge e}\right\vert \mathbf{e\wedge e}\right)  ^{-1}\right)
\mathcal{R}_{\left(  e\wedge e\right)  }\left(  v\mathbf{\wedge}w\right)  .
\end{align}


\item Let $\digamma_{e}=\digamma_{\left\vert e\right\rangle }$ then
\begin{align}
v^{d}\wedge w^{d}  &  =\digamma_{\left\vert e\wedge e\right\rangle }\left(
v\wedge w\right)  =\digamma_{\left\vert e\wedge e\right\rangle }\left(
\overset{}{\left(  \left\vert \mathbf{e\wedge e}\right\rangle \right)
\mathcal{R}_{e}\left(  v\mathbf{\wedge}w\right)  }\right)  =\left(
\left\langle \mathbf{e}^{b}\wedge\mathbf{e}^{b}\right\vert \right)
\mathcal{R}_{\left(  e\wedge e\right)  }\left(  v\mathbf{\wedge}w\right) \\
&  =\left(  \left\langle \mathbf{e}^{b}\wedge\mathbf{e}^{b}\right\vert
\left\langle \left.  \mathbf{e\wedge e}\right\vert \mathbf{e\wedge
e}\right\rangle ^{-1}\right)  \mathcal{R}_{\left(  e\wedge e\right)  }\left(
v\mathbf{\wedge}w\right)  .
\end{align}

\end{enumerate}
\end{example}

\begin{example}
The map $\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }$ between the
tensor product $\otimes^{2}V$ and the mixed tensor product $V\otimes V^{d}$%
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }:V\otimes V\rightarrow
V\otimes V^{d}%
\end{equation}
is given by
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }=I_{V}\otimes\digamma_{e}.
\end{equation}

\end{example}

\begin{definition}
\begin{enumerate}
\item
\begin{enumerate}
\item The inverse $\Theta^{-1}$ between the mixed tensor product $V\otimes
V^{d}$ and the tensor product $\otimes^{2}V$
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }^{-1}:V\otimes
V^{d}\rightarrow V\otimes V
\end{equation}
given by
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }^{-1}=I_{V}\otimes
\digamma_{e}^{-1}.
\end{equation}


\item The map $\Theta_{d}$ between the tensor product $\otimes^{2}V^{d}$ and
the mixed tensor product $V\otimes V^{d}$%
\begin{equation}
\Theta_{\left(  V^{d}V^{d}\right)  \left(  VV^{d}\right)  }:V^{d}\otimes
V^{d}\rightarrow V\otimes V^{d}%
\end{equation}
given by
\begin{equation}
\Theta_{\left(  V^{d}V^{d}\right)  \left(  VV^{d}\right)  }=\digamma_{e}%
^{-1}\otimes I_{V}.
\end{equation}


\item The inverse $\Theta_{\left(  V^{d}V^{d}\right)  \left(  VV^{d}\right)
}^{-1}$ between the mixed tensor product $V\otimes V^{d}$ and the tensor
product $\otimes^{2}V^{d}$
\begin{equation}
\Theta_{\left(  V^{d}V^{d}\right)  \left(  VV^{d}\right)  }^{-1}:V\otimes
V^{d}\rightarrow V^{d}\otimes V^{d}%
\end{equation}
given by
\begin{equation}
\Theta_{\left(  V^{d}V^{d}\right)  \left(  VV^{d}\right)  }^{-1}=\digamma
_{e}\otimes I_{V}.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{definition}

\begin{remark}
Let
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }:V\otimes V\rightarrow
V\otimes V^{d}%
\end{equation}
and
\begin{equation}
a_{2}=\sum_{1\leq j\leq r}\alpha_{j}v_{j}{\small \otimes}w_{j}\equiv
\sum_{1\leq j\leq r}\alpha_{j}\left(  a_{2}\right)  v\left(  a_{2}\right)
_{j}{\small \otimes}w\left(  a_{2}\right)  _{j},
\end{equation}
then
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }^{-1}\left(  a_{2}\right)
=\left[  I_{V}\otimes\digamma_{e}\right]  \left(  a_{2}\right)  =\left(
I_{V}\otimes\digamma_{e}\right)  \left(  \sum_{1\leq j\leq r}\alpha_{j}%
v_{j}{\small \otimes}w_{j}\right)  =\sum_{1\leq j\leq r}\alpha_{j}%
v_{j}{\small \otimes}\digamma_{e}\left(  w_{j}\right)  =\sum_{1\leq j\leq
r}\alpha_{j}v_{j}{\small \otimes}w_{j}^{d}%
\end{equation}
and
\begin{equation}
\Xi_{VV}\left(  a_{2}\right)  =\Xi_{VV^{d}}\left(  \Theta_{\left(  VV\right)
\left(  VV^{d}\right)  }\left(  a_{2}\right)  \right)  =\sum_{1\leq j\leq
r}\alpha_{j}v_{j}w_{j}^{d}.
\end{equation}

\end{remark}

\begin{example}
Let
\begin{equation}
\digamma_{e}=\digamma_{\left\vert e\right\rangle }%
\end{equation}
and
\begin{equation}
a_{2}=\sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}\right)  \mathcal{R}%
_{\otimes^{2}e}\left(  a_{2}\right)  _{jk}=\sum_{1\leq j\leq r}\alpha_{j}%
v_{j}{\small \otimes}w_{j}%
\end{equation}
then
\begin{align}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }^{-1}\left(  a_{2}\right)
&  =\left[  I_{V}\otimes\digamma_{\left\vert e\right\rangle }\right]  \left(
a_{2}\right)  =\left[  I_{V}\otimes\digamma_{\left\vert e\right\rangle
}\right]  \left(  \sum_{1\leq j\leq r}\alpha_{j}v_{j}{\small \otimes}%
w_{j}\right)  =\sum_{1\leq j\leq r}\alpha_{j}v_{j}{\small \otimes}%
\digamma_{\left\vert e\right\rangle }\left(  w_{j}\right)  =\sum_{1\leq j\leq
r}\alpha_{j}\left\vert v_{j}\right\rangle {\small \otimes}\left\langle
w_{j}\right\vert \\
&  =\left[  I_{V}\otimes\digamma_{e}\right]  \left(  \sum_{1\leq j,k\leq
r}\left(  e_{j}\otimes e_{k}\right)  \mathcal{R}_{\otimes^{2}e}\left(
a_{2}\right)  _{jk}\right)  =\sum_{1\leq j,k\leq r}\left(  \left\vert
e_{j}\right\rangle \otimes\left\langle e_{k}\right\vert \right)
\mathcal{R}_{\otimes^{2}e}\left(  a_{2}\right)  _{jk}%
\end{align}
and
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }\left(  a_{2}\right)
=\Xi_{VV^{d}}\left(  \Theta_{\left(  VV\right)  \left(  VV^{d}\right)
}\left(  a_{2}\right)  \right)  =\sum_{1\leq j\leq r}\alpha_{j}\left\vert
v_{j}\right\rangle \left\langle w_{j}\right\vert =\sum_{1\leq j,k\leq
r}\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \mathcal{R}%
_{\otimes^{2}e}\left(  a_{2}\right)  _{jk}.
\end{equation}

\end{example}

\begin{lemma}
Complex bilinear forms $\mathfrak{b}\in\mathcal{BL}\left(  V\right)  $%
\begin{equation}
\mathfrak{b}:V\times V\rightarrow\mathbb{C}%
\end{equation}
have the following properties
\begin{equation}
\mathfrak{b}\left(  x_{1},x_{2}\right)  =\left\langle b^{d},x_{1}\otimes
x_{2}\right\rangle =\left\langle \left[  \otimes^{2}\digamma_{e}\right]
\left(  b\right)  ,x_{1}\otimes x_{2}\right\rangle =\left\langle \digamma
_{e}\left(  x_{1}\right)  \otimes\digamma_{e}\left(  x_{2}\right)
,b\right\rangle =\left\langle x_{1}^{d}\otimes x_{2}^{d},b\right\rangle ,
\end{equation}
where $x_{1}\otimes x_{2}\in\bigotimes\nolimits^{2}V,\,x_{1}^{d}\otimes
x_{2}^{d}\in\bigotimes\nolimits^{2}V^{d},\,b^{d}\in V^{d}\otimes V^{d}%
$,$\,b\in V\otimes V$ and $\otimes^{2}\digamma_{e}=\digamma_{e}\otimes
\digamma_{e}.$
\end{lemma}

\begin{proof}
By considering decomposable elements of the dual determined by the injection
$\digamma_{e}\quad$
\begin{equation}
b^{d}\left(  x_{1}\otimes x_{2}\right)  \overset{\bigtriangleup}{=}\left(
x_{1}^{d}\otimes x_{2}^{d}\right)  \left(  b\right)  =\left\langle \otimes
^{2}\digamma_{e}\left(  b\right)  ,x_{1}\otimes x_{2}\right\rangle .
\end{equation}

\end{proof}

\begin{definition}
Elemenraty bilinear functionals
\begin{equation}
\mathfrak{e}_{jk}:V\times V\rightarrow\mathbb{C}%
\end{equation}
by%
\begin{equation}
\mathfrak{e}_{jk}\left(  e_{l},e_{m}\right)  =\delta_{jl}\delta_{km}%
,\quad1\leq j,k\leq r.
\end{equation}

\end{definition}

\begin{lemma}
Values of elemenraty bilinear functionals
\begin{equation}
\mathfrak{e}_{jk}\left(  x_{1},x_{2}\right)  =\left\langle e_{j}^{d}\otimes
e_{k}^{d},x_{1}\otimes x_{2}\right\rangle =\left\langle e_{j}^{d}%
,x_{1}\right\rangle \left\langle e_{k}^{d},x_{2}\right\rangle =e_{j}%
^{d}\left(  x_{1}\right)  e_{k}^{d}\left(  x_{2}\right)  .
\end{equation}

\end{lemma}

\begin{remark}%
\begin{equation}
b^{d}=\sum_{1\leq j,k\leq r}\left(  e_{j}^{d}\otimes e_{k}^{d}\right)
\mathcal{R}_{e\otimes e}\left(  b\right)  _{jk}.
\end{equation}

\end{remark}

\begin{corollary}
Let $b\in%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
V^{d}$ then $\mathfrak{b\in}\mathcal{BL}\left(  V\right)  $
\begin{align}
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =\left\langle b^{d},x_{1}\otimes
x_{2}\right\rangle =\sum_{1\leq j,k\leq r}\mathfrak{e}_{jk}\left(  x_{1}%
,x_{2}\right)  \mathcal{R}_{e}\left(  b\right)  _{jk}=\left\langle \sum_{1\leq
j,k\leq r}e_{j}^{d}\otimes e_{k}^{d}\mathcal{R}_{e\otimes e}\left(  b\right)
_{jk},x_{1}\otimes x_{2}\right\rangle \\
&  =\sum_{1\leq j,k\leq r}\mathcal{R}_{e\otimes e}\left(  b\right)
_{jk}\left\langle e_{j}^{d}\otimes e_{k}^{d},x_{1}\otimes x_{2}\right\rangle
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e\otimes e}\left(  b\right)
_{jk}\left\langle e_{j}^{d},x_{1}\right\rangle \left\langle e_{k}^{d}%
,x_{2}\right\rangle =\sum_{1\leq j,k\leq r}\mathcal{R}_{e\otimes e}\left(
b\right)  _{jk}e_{j}^{d}\left(  x_{1}\right)  e_{k}^{d}\left(  x_{2}\right)  ,
\end{align}
i.e.%
\begin{equation}
\mathfrak{b=}\sum_{1\leq j,k\leq r}\mathfrak{e}_{jk}\mathcal{R}_{e\otimes
e}\left(  b\right)  _{jk}.
\end{equation}

\end{corollary}

\subsection{Induced Transformations}

\begin{remark}
\label{Induced Transformations}
\end{remark}

\begin{notation}
The \emph{tensor algebra} $\mathcal{T}\left(  V\right)  $ generated by the
vector space $V$ is
\begin{equation}
\mathcal{T}\left(  \overset{}{V}\right)  =\bigotimes\left(  \overset{}{V}%
\right)  =\bigoplus\limits_{0\leq n\leq\infty}\left(  \overset{}{%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
V}\right)  .
\end{equation}

\end{notation}

\begin{notation}
The s\emph{ymmetric tensor algebra} $\mathcal{S}\left(  V\right)  $ generated
by the vector space $V$ is
\begin{equation}
\mathcal{S}\left(  \overset{}{V}\right)  =\bigvee\left(  \overset{}{V}\right)
=\bigoplus\limits_{0\leq n\leq\infty}\left(  \overset{}{{\Huge \vee}^{n}%
V}\right)  .
\end{equation}

\end{notation}

\begin{notation}
The \emph{antisymmetric tensor algebra} $\mathcal{A}\left(  V\right)  $
generated by the vector space $V$ is
\begin{equation}
\mathcal{A}\left(  \overset{}{V}\right)  =\bigwedge\left(  \overset{}{V}%
\right)  =\bigoplus\limits_{0\leq n\leq2r}\left(  \overset{}{{\Huge \wedge
}^{n}V}\right)  .
\end{equation}

\end{notation}

\begin{definition}
\begin{enumerate}
\item The $n^{th}$ order symmetrizer $\mathcal{S}_{n}\in\mathcal{B}\left(
\overset{}{%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
V}\right)  $ is given by
\begin{equation}
\mathcal{S}_{n}=\frac{1}{n!}\sum_{\sigma\in S_{n}}P_{\sigma}.
\end{equation}


\item The full symmetrizer $\mathcal{S}\in\mathcal{B}\left(  \bigotimes\left(
\overset{}{V}\right)  \right)  $
\begin{equation}
\mathcal{S}=%
%TCIMACRO{\tbigoplus _{0\leq n\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus_{0\leq n\leq\infty}}
%EndExpansion
\mathcal{S}_{n}%
\end{equation}

\end{enumerate}
\end{definition}

\begin{definition}
\begin{enumerate}
\item The $n^{th}$ order antisymmetrizer $\mathcal{A}_{n}\in\mathcal{B}\left(
\overset{}{%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
V}\right)  $ is given by
\begin{equation}
\mathcal{A}_{n}=\frac{1}{n!}\sum_{\sigma\in S_{n}}\pi\left(  \sigma\right)
P_{\sigma}.
\end{equation}


\item The full antisymmetrizer $\mathcal{A}\in\mathcal{B}\left(
\bigotimes\left(  \overset{}{V}\right)  \right)  $
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus _{0\leq n\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus_{0\leq n\leq\infty}}
%EndExpansion
\mathcal{A}_{n}.
\end{equation}

\end{enumerate}
\end{definition}

\begin{remark}
Linear operators $Y\in\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  $ acting in the antisymmetric tensor
algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $ are given by
\begin{equation}
Y=\mathcal{A}\left(  X\right)  \mathcal{A},
\end{equation}
where $X\in\mathcal{B}\left(
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  $ .
\end{remark}

\begin{remark}
Linear operators $Y\in\mathcal{B}\left(
%TCIMACRO{\tbigvee }%
%BeginExpansion
{\textstyle\bigvee}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  $ acting in the symmetric tensor
algebra $%
%TCIMACRO{\tbigvee }%
%BeginExpansion
{\textstyle\bigvee}
%EndExpansion
\left(  \overset{}{V}\right)  $ are given by
\begin{equation}
Y=\mathcal{S}\left(  X\right)  \mathcal{S},
\end{equation}
where $X\in\mathcal{B}\left(
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  .$
\end{remark}

\begin{definition}
of the induced tensor product transformation $"{\large \otimes}\left(
X_{1},\cdots,X_{n}\right)  "\in\mathcal{B}\left(  \overset{}{%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
V}\right)  $ of $X_{1},\cdots,X_{n}\in\mathcal{B}\left(  V\right)  .$
\begin{equation}
{\large \otimes}\left(  X_{1},\cdots,X_{n}\right)  \left(  v_{1}\otimes
\cdots\otimes v_{n}\right)  =\left[  X_{1}\otimes\cdots\otimes X_{n}\right]
\left(  v_{1}\otimes\cdots\otimes v_{n}\right)  =X_{1}v_{1}\otimes
\cdots\otimes X_{n}v_{n},
\end{equation}
which gives the special case%
\begin{equation}
\otimes^{n}X_{1}\left(  v_{1}\otimes\cdots\otimes v_{n}\right)  \left(
v_{1}\otimes\cdots\otimes v_{n}\right)  ={\large \otimes}\left(  X_{1}%
,\cdots,X_{1}\right)  \left(  v_{1}\otimes\cdots\otimes v_{n}\right)  =\left[
X_{1}\otimes\cdots\otimes X_{1}\right]  \left(  v_{1}\otimes\cdots\otimes
v_{n}\right)  =X_{1}v_{1}\otimes\cdots\otimes X_{1}v_{n}.
\end{equation}

\end{definition}

\begin{definition}
of the induced symmetric tensor product transformation ${\large \boxdot}%
^{n}\left(  X_{1},\cdots,X_{n}\right)  \in\mathcal{B}\left(  \overset{}{%
%TCIMACRO{\tbigvee \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigvee\nolimits^{n}}
%EndExpansion
V}\right)  $ of $X_{1},\cdots,X_{n}\in\mathcal{B}\left(  V\right)  $
\begin{equation}
\boxdot^{n}\left(  X_{1},\cdots,X_{n}\right)  \left(  v_{1}\vee\cdots\vee
v_{n}\right)  =\left[  X_{1}\boxdot\cdots\boxdot X_{n}\right]  \left(
v_{1}\vee\cdots\vee v_{n}\right)  =X_{1}v_{1}\vee\cdots\vee X_{n}v_{n},
\end{equation}
which gives the special case
\begin{equation}
\left(  \boxdot^{n}X\right)  \left(  v_{1}\vee\cdots\vee v_{n}\right)
=\left[  X_{1}\boxdot\cdots\boxdot X_{1}\right]  \left(  v_{1}\vee\cdots\vee
v_{n}\right)  =X_{1}v_{1}\vee\cdots\vee X_{1}v_{n}.
\end{equation}

\end{definition}

\begin{definition}
of the induced antisymmetric tensor product transformation $\boxtimes
^{n}\left(  X_{1},\cdots,X_{n}\right)  \in\mathcal{B}\left(  \overset{}{%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
V}\right)  $ of $X_{1},\cdots,X_{n}\in\mathcal{B}\left(  V\right)  $
\begin{equation}
\boxtimes^{n}\left(  X_{1},\cdots,X_{n}\right)  \left(  v_{1}\wedge
\cdots\wedge v_{n}\right)  =\left[  X_{1}\boxtimes\cdots\boxtimes
X_{n}\right]  \left(  v_{1}\wedge\cdots\wedge v_{n}\right)  =X_{1}v_{1}%
\wedge\cdots\wedge X_{n}v_{n},
\end{equation}
which gives the special case
\begin{equation}
\left(  \boxtimes^{n}X\right)  \left(  v_{1}\wedge\cdots\wedge v_{n}\right)
=\left[  X_{1}\boxtimes\cdots\boxtimes X_{1}\right]  \left(  v_{1}\wedge
\cdots\wedge v_{n}\right)  =X_{1}v_{1}\wedge\cdots\wedge X_{1}v_{n}.
\end{equation}

\end{definition}

\begin{definition}
Of the induced multiplication $\otimes\in$ $\mathcal{B}\left(
\begin{array}
[c]{c}%
\mathcal{B}\left(
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  ,\mathcal{B}\left(
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  \times\mathcal{B}\left(
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \overset{}{V}\right)  \right) \\
\end{array}
\right)  $ in the space of operators $\mathcal{B}\left(
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  $ acting in the antisymmetric tensor
algebra $%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  V\right)  $
\begin{equation}
\left[  X_{1}\otimes\cdots\otimes X_{n}\right]  \left(  v_{1}\otimes
\cdots\otimes v_{n}\right)  =X_{1}v_{1}\otimes\cdots\otimes X_{n}v_{n},
\end{equation}
which gives the special case
\begin{equation}
\left(  \otimes^{n}X_{1}\right)  \left(  v_{1}\otimes\cdots\otimes
v_{n}\right)  =\left[  X_{1}\otimes\cdots\otimes X_{1}\right]  \left(
v_{1}\otimes\cdots\otimes v_{n}\right)  =X_{1}v_{1}\otimes\cdots\otimes
X_{1}v_{n}.
\end{equation}

\end{definition}

\begin{definition}
Of the induced multiplication $\boxdot$ $\in$ $\mathcal{B}\left(
\mathcal{B}\left(
%TCIMACRO{\tbigvee }%
%BeginExpansion
{\textstyle\bigvee}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  ,\mathcal{B}\left(
%TCIMACRO{\tbigvee }%
%BeginExpansion
{\textstyle\bigvee}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  \times\mathcal{B}\left(
%TCIMACRO{\tbigvee }%
%BeginExpansion
{\textstyle\bigvee}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  \right)  $in the space of operators
$\mathcal{B}\left(
%TCIMACRO{\tbigvee }%
%BeginExpansion
{\textstyle\bigvee}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  $ acting in the antisymmetric tensor
algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $
\begin{equation}
\left[  X_{1}\boxdot\cdots\boxdot X_{n}\right]  \left(  v_{1}\vee\cdots\vee
v_{n}\right)  =X_{1}v_{1}\vee\cdots\vee X_{n}v_{n},
\end{equation}
which gives the special case
\begin{equation}
\left(  \boxdot^{n}X_{1}\right)  \left(  v_{1}\vee\cdots\vee v_{n}\right)
=\left[  X_{1}\boxdot\cdots\boxdot X_{1}\right]  \left(  v_{1}\vee\cdots\vee
v_{n}\right)  =X_{1}v_{1}\vee\cdots\vee X_{1}v_{n}.
\end{equation}

\end{definition}

\begin{definition}
Of the induced multiplication $\boxtimes$ $\in\mathcal{B}\left(
\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  ,\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  \times\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  \right)  $ in the space of operators
$\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  \right)  $ acting in the antisymmetric tensor
algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $
\begin{equation}
\left[  X_{1}\boxtimes\cdots\boxtimes X_{n}\right]  \left(  v_{1}\wedge
\cdots\wedge v_{n}\right)  =X_{1}v_{1}\wedge\cdots\wedge X_{n}v_{n},
\end{equation}
which gives the special case
\begin{equation}
\left(  \boxtimes^{n}X_{1}\right)  \left(  v_{1}\wedge\cdots\wedge
v_{n}\right)  =\left[  X_{1}\boxtimes\cdots\boxtimes X_{1}\right]  \left(
v_{1}\wedge\cdots\wedge v_{n}\right)  =X_{1}v_{1}\wedge\cdots\wedge X_{1}%
v_{n}.
\end{equation}

\end{definition}

\subsection{Bilinear Forms}

\begin{lemma}
Complex symmetric bilinear forms $\mathfrak{s\in}\mathcal{SL}\left(  V\right)
\subset\mathcal{BL}\left(  V\right)  $%
\begin{equation}
\mathfrak{s}:V\times V\rightarrow\mathbb{C}%
\end{equation}
have the following properties
\begin{equation}
\mathfrak{s}\left(  x_{1},x_{2}\right)  =\left\langle x_{1}^{d}\vee x_{2}%
^{d},s\right\rangle =\left\langle s^{d},x_{1}\vee x_{2}\right\rangle
\equiv\left\langle \digamma_{e}\left(  x_{1}\right)  \vee\digamma_{e}\left(
x_{2}\right)  ,s\right\rangle =\left\langle \left[  \boxdot^{2}\digamma
_{e}\right]  \left(  s\right)  ,x_{1}\vee x_{2}\right\rangle ,
\end{equation}
where $x_{1}\vee x_{2}\in\bigvee\nolimits^{2}V,\,x_{1}^{d}\vee x_{2}^{d}%
\in\bigvee\nolimits^{2}V^{d},\,s^{d}\in V^{d}\vee V^{d},\,b\in V\vee V$ and
$\boxdot^{2}\digamma_{e}=\digamma_{e}\boxdot\digamma_{e}.$
\end{lemma}

\begin{proof}
By considering decomposable elements of the dual determined by the injection
$\digamma_{e}\quad$
\begin{equation}
s^{d}\left(  x_{1}\vee x_{2}\right)  \overset{\bigtriangleup}{=}\left(
x_{1}^{d}\vee x_{2}^{d}\right)  \left(  s\right)  =\left\langle \left[
\boxdot^{2}\digamma_{e}\right]  \left(  s\right)  ,x_{1}\vee x_{2}%
\right\rangle .
\end{equation}

\end{proof}

\begin{lemma}
Complex antisymmetric bilinear forms $\mathfrak{g}\in\mathcal{AS}\left(
V\right)  $%
\begin{equation}
\mathfrak{g}:V\times V\rightarrow\mathbb{C}%
\end{equation}
have the following properties
\begin{equation}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle g^{d},x_{1}\wedge
x_{2}\right\rangle =\left\langle \left[  \boxtimes^{2}\digamma_{e}\right]
\left(  g\right)  ,x_{1}\wedge x_{2}\right\rangle =\left\langle \digamma
_{e}\left(  x_{1}\right)  \wedge\digamma_{e}\left(  x_{2}\right)
,g\right\rangle =\left\langle x_{1}^{d}\wedge x_{2}^{d},g\right\rangle ,
\end{equation}
where $x_{1}\wedge x_{2}\in\bigwedge\nolimits^{2}V,$\thinspace\ $x_{1}%
^{d}\wedge x_{2}^{d}\in\bigwedge\nolimits^{2}V^{d}\,,\,g^{d}\in V^{d}\wedge
V^{d},\,g\in V\wedge V$ and $\boxtimes^{2}\digamma_{e}=\digamma_{e}%
\boxtimes\digamma_{e}.$
\end{lemma}

\begin{proof}
By considering decomposable elements of the dual determined by the injection
$\digamma_{e}\quad$
\begin{equation}
g\left(  x_{1}\wedge x_{2}\right)  =\left\langle \digamma_{e}\left(  g\right)
,x_{1}\wedge x_{2}\right\rangle \overset{\bigtriangleup}{=}\left(  x_{1}%
^{d}\wedge x_{2}^{d}\right)  \left(  g\right)  .
\end{equation}

\end{proof}

\begin{definition}
The \emph{complex linear }map $\Xi_{VV^{d}}$
\begin{equation}
\Xi_{VV^{d}}:V\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)  ,
\end{equation}
is given by
\begin{equation}
\Xi_{VV^{d}}\left(  w\otimes\eta^{d}\right)  =T_{w\otimes\eta^{d}}%
\end{equation}
and
\begin{equation}
\Xi_{VV^{d}}\left(  w\otimes\eta^{d}\right)  \left(  v\right)  =T_{w\otimes
\eta^{d}}\left(  v\right)  =\left\langle \eta^{d},v\right\rangle w=\eta
^{d}\left(  v\right)  w,\quad\forall v,w\in V,\,\forall\eta^{d}\in V^{d}.
\end{equation}

\end{definition}

\begin{lemma}
The tensor product $V\otimes V^{d}$ is algebraicaly isomorphic to the space of
\emph{linear} endomorphisms $\mathcal{L}\left(  V\right)  $ (not neccesarily
continuous or bounded) i.e.
\begin{equation}
V\otimes V^{d}\cong\mathcal{L}\left(  V\right)
\end{equation}
through $\Xi_{VV^{d}}.$
\end{lemma}

\begin{proof}
By construction.
\end{proof}

\begin{corollary}
The action of $\Xi_{VV^{d}}$ on decomposable tensor products $\left\{  \left.
e_{j}\otimes e_{k}^{d}\right\vert 1\leq j,k\leq r\right\}  $ is given by
\begin{equation}
\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  =E_{jk}\in\mathcal{L}%
\left(  V\right)  ,\quad1\leq j,k\leq r,
\end{equation}
where $\left\{  \left.  E_{jk}\right\vert 1\leq j,k\leq r\right\}  $ are
\emph{elementary operators} defined by
\begin{equation}
\Xi_{VV^{d}}\left(  e_{j}\otimes e_{k}^{d}\right)  \left(  v\right)
=E_{jk}\left(  v\right)  =\left(  e_{k}^{d}\left(  v\right)  \right)
e_{j}=\left\langle e_{k}^{d},v\right\rangle e_{j}=e_{j}\mathcal{R}_{e}\left(
v\right)  _{k},\quad1\leq j,k\leq r
\end{equation}
and
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}.
\end{equation}

\end{corollary}

\begin{notation}%
\begin{equation}
\Xi_{VV^{d}}\left\{  \left(  \mathbf{e}\right)  \otimes\left(  \mathbf{e}%
^{d}\right)  \right\}  =\left(  \mathbf{E}\right)  .
\end{equation}

\end{notation}

\begin{remark}%
\begin{equation}
I_{V}\otimes\digamma_{e}\equiv\Theta_{\left(  VV\right)  \left(
VV^{d}\right)  }:V\otimes V\rightarrow V\otimes V^{d}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\Theta_{\left(  VV\right)  \left(  VV^{d}\right)  }\left(  v\otimes w\right)
=v\otimes\digamma_{e}\left(  w\right)  =\left[  I_{V}\otimes\digamma
_{e}\right]  \left(  \sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}\right)
\mathcal{R}_{e}\left(  v\right)  _{j}\sigma_{\digamma_{e}}\left(
\mathcal{R}_{e}\left(  w\right)  _{k}\right)  \right)  =\sum_{1\leq j,k\leq
r}\left(  e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}_{e}\left(  v\right)
_{j}\sigma_{\digamma_{e}}\left(  \mathcal{R}_{e}\left(  w\right)  _{k}\right)
,
\end{equation}
where $\sigma_{\digamma_{e}}$ is the conjugation associated with $\digamma
_{e}.$
\end{remark}

\begin{definition}%
\begin{equation}
\Xi_{VV}:V\otimes V\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
by
\begin{equation}
\Xi_{VV}=\Xi_{VV^{d}}\circ\Theta_{\left(  VV^{d}\right)  \left(  VV\right)
}=\Upsilon\circ\left(  I_{V}\otimes\digamma_{e}\right)  .
\end{equation}

\end{definition}

\begin{definition}%
\begin{equation}
\Xi_{V^{d}V^{d}}:V^{d}\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
by
\begin{equation}
\Xi_{VV^{d}}=\Upsilon\circ\left(  \digamma_{e}^{-1}\otimes I_{V^{d}}\right)  .
\end{equation}

\end{definition}

\begin{example}%
\begin{equation}
\Omega_{e}^{d}\left(  v^{d},w^{d}\right)  =\left[  \Upsilon\circ\left(
\digamma_{e}^{-1}\otimes I_{V^{d}}\right)  \right]  \left(  v^{d}\otimes
w^{d}\right)  =\Upsilon\left(  v\otimes w^{d}\right)  =E_{vw}.
\end{equation}
In particular
\begin{equation}
\Omega_{e}^{d}\left(  e_{j}^{d},e_{k}^{d}\right)  =\left[  \Upsilon
\circ\left(  \digamma_{e}^{-1}\otimes I_{V^{d}}\right)  \right]  \left(
e_{j}^{d}\otimes e_{k}^{d}\right)  =\Upsilon\left(  e_{j}\otimes e_{k}%
^{d}\right)  =E_{jk}.
\end{equation}

\end{example}

\begin{example}
Consider the operators $B\in\mathcal{L}\left(  V\right)  $
\begin{equation}
B=\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  B\right)  _{jk}%
\end{equation}
then
\begin{align}
B  &  =\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  B\right)  _{jk}%
=\sum_{1\leq j,k\leq r}\Omega_{e}^{d}\left(  e_{j}^{d},e_{k}^{d}\right)
\mathcal{R}_{e}\left(  B\right)  _{jk}=\sum_{1\leq j,k\leq r}\Xi_{VV^{d}%
}\left(  e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}_{e}\left(  B\right)
_{jk}=\sum_{1\leq j,k\leq r}\Xi_{VV^{d}}\left(  \left(  e_{j}\otimes e_{k}%
^{d}\right)  \mathcal{R}_{e}\left(  B\right)  _{jk}\right) \\
&  =\Xi_{VV^{d}}\left(  \overset{}{\left[  \digamma_{e}^{-1}\otimes I_{V^{d}%
}\right]  \left(  b^{d}\right)  }\right)  =\Xi_{VV^{d}}\left(  \left[
\digamma_{e}^{-1}\otimes I_{V^{d}}\right]  \left(  \sum_{1\leq j,k\leq r}%
e_{j}^{d}\otimes e_{k}^{d}\mathcal{R}_{e}\left(  B\right)  _{jk}\right)
\right) \\
&  =\Xi_{VV^{d}}\left(  \sum_{1\leq j,k\leq r}\Omega_{e}^{d}\left(  e_{j}%
^{d},e_{k}^{d}\right)  \mathcal{R}_{e}\left(  B\right)  _{jk}\right)
=\Xi_{VV^{d}}\left(  \sum_{1\leq j,k\leq r}\Omega_{e}^{d}\left(  e_{j}%
^{d},e_{k}^{d}\right)  \mathcal{R}_{e}\left(  B\right)  _{jk}\right)  .
\end{align}

\end{example}

\begin{example}
The values of bilinear forms $\mathfrak{b}$
\begin{align}
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =\left\langle b^{d},x_{1}\otimes
x_{2}\right\rangle =\left\langle \sum_{1\leq j,k\leq r}e_{j}^{d}\otimes
e_{k}^{d}\mathcal{R}_{e\otimes e}\left(  b^{d}\right)  _{jk},x_{1}\otimes
x_{2}\right\rangle =\sum_{1\leq j,k\leq r}\left\langle e_{j}^{d}\otimes
e_{k}^{d},x_{1}\otimes x_{2}\right\rangle \mathcal{R}_{e\otimes e}\left(
b^{d}\right)  _{jk}\\
&  =\sum_{1\leq j,k\leq r}e_{j}^{d}\left(  x_{1}\right)  e_{k}^{d}\left(
x_{2}\right)  \mathcal{R}_{e\otimes e}\left(  b^{d}\right)  _{jk}=\sum_{1\leq
j,k\leq r}\left\langle e_{j}^{d},x_{1}\right\rangle \left\langle e_{k}%
^{d},x_{2}\right\rangle \mathcal{R}_{e\otimes e}\left(  b^{d}\right)
_{jk}=\sum_{1\leq j,k\leq r}\mathcal{R}_{e\otimes e}\left(  b^{d}\right)
_{jk}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}_{e}\left(
x_{2}\right)  _{k}.
\end{align}%
\begin{equation}
\mathfrak{b}\left(  x_{1},x_{2}\right)  =\left\langle b^{d},x_{1}\otimes
x_{2}\right\rangle =\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  b\right)
_{jk}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}_{e}\left(
x_{2}\right)  _{k}=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  x_{1}\right)
_{j}\mathcal{R}_{e}\left(  B\right)  _{jk}\mathcal{R}_{e}\left(  x_{2}\right)
_{k}=\left\langle b^{d},x_{1}\otimes x_{2}\right\rangle
\end{equation}

\end{example}

\begin{example}
Matrix elements of operators $B\in\mathcal{L}\left(  V\right)  $
\begin{equation}
\left\langle x_{1}^{d},Bx_{2}\right\rangle =x_{1}^{d}\left(  Bx_{2}\right)
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e^{d}}\left(  x_{1}^{d}\right)
_{j}\mathcal{R}_{e}\left(  B\right)  _{jk}\mathcal{R}_{e}\left(  x_{2}\right)
_{k}=\sum_{1\leq j,k\leq r}\left\langle x_{1}^{d},e_{j}\right\rangle
\left\langle e_{j}^{d},Be_{k}\right\rangle \left\langle e_{k}^{d}%
,x_{2}\right\rangle ,
\end{equation}
where
\begin{gather}
\mathcal{R}_{e}\left(  B\right)  _{jk}=\left\langle e_{j}^{d},Be_{k}%
\right\rangle \\
\mathcal{R}_{e}\left(  x_{2}\right)  _{j}=\left\langle e_{j}^{d}%
,x_{2}\right\rangle =e_{j}^{d}\left(  x_{2}\right) \\
\mathcal{R}_{e^{d}}\left(  x_{1}^{d}\right)  _{j}=\left\langle x_{1}^{d}%
,e_{j}\right\rangle =x_{1}^{d}\left(  e_{j}\right)  =e_{j}^{d}\left(
x_{1}\right)  =\mathcal{R}_{e}\left(  x_{1}\right)  _{j}.
\end{gather}

\end{example}

\begin{remark}
Compare to
\begin{align}
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =\left\langle b^{d},x_{1}\otimes
x_{2}\right\rangle =\sum_{1\leq j,k\leq r}\mathfrak{e}_{jk}\left(  x_{1}%
,x_{2}\right)  \mathcal{R}_{e^{d}\otimes e^{d}}\left(  b^{d}\right)
_{jk}=\left\langle \sum_{1\leq j,k\leq r}e_{j}^{d}\otimes e_{k}^{d}%
\mathcal{R}_{e^{d}\otimes e^{d}}\left(  b^{d}\right)  _{jk},x_{1}\otimes
x_{2}\right\rangle \\
&  =\sum_{1\leq j,k\leq r}\mathcal{R}_{e^{d}\otimes e^{d}}\left(
b^{d}\right)  _{jk}\left\langle e_{j}^{d}\otimes e_{k}^{d},x_{1}\otimes
x_{2}\right\rangle =\sum_{1\leq j,k\leq r}\mathcal{R}_{e^{d}\otimes e^{d}%
}\left(  b^{d}\right)  _{jk}\left\langle e_{j}^{d},x_{1}\right\rangle
\left\langle e_{k}^{d},x_{2}\right\rangle \\
&  =\sum_{1\leq j,k\leq r}\mathcal{R}_{e^{d}\otimes e^{d}}\left(
b^{d}\right)  _{jk}e_{j}^{d}\left(  x_{1}\right)  e_{k}^{d}\left(
x_{2}\right)  =\sum_{1\leq j,k\leq r}\mathcal{R}_{e^{d}\otimes e^{d}}\left(
b^{d}\right)  _{jk}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}%
_{e}\left(  x_{2}\right)  _{k}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\mathfrak{b}\left(  x_{1},x_{2}\right)  =\left\langle b^{d},x_{1}\otimes
x_{2}\right\rangle =\left\langle x_{1}^{d},Bx_{2}\right\rangle =\left\langle
x_{1}^{d},\Omega_{e}^{d}\left(  b^{d}\right)  x_{2}\right\rangle ,
\end{equation}
which gives
\begin{equation}
\mathcal{R}_{e^{d}\otimes e^{d}}\left(  b^{d}\right)  _{jk}=\mathcal{R}%
_{e}\left(  B\right)  _{jk}=\mathcal{R}_{e}\left(  \Omega_{e}^{d}\left(
b^{d}\right)  \right)  _{jk}\quad1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{example}%
\begin{align}
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =\left[  \sum_{1\leq j,k\leq
r}\left(  e_{j}^{d}\otimes e_{k}^{d}\right)  \mathcal{R}_{e^{d}\otimes e^{d}%
}\left(  b^{d}\right)  _{jk}\right]  \left(  x_{1},x_{2}\right)  =\left[
\sum_{1\leq j,k\leq r}\left(  e_{j}^{d}\otimes e_{k}^{d}\right)
\mathcal{R}_{e^{d}\otimes e^{d}}\left(  \left[  \otimes^{2}\digamma_{e}%
^{-1}\right]  \left(  b^{d}\right)  \right)  _{jk}\right]  \left(  x_{1}%
,x_{2}\right) \\
&  =\left[  \sum_{1\leq j,k\leq r}\left(  e_{j}^{d}\otimes e_{k}^{d}\right)
\mathit{C}_{\digamma_{e}}\left(  \mathcal{R}_{e\otimes e}\left(  b\right)
_{jk}\right)  \right]  \left(  x_{1},x_{2}\right)  .
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\Omega_{e}^{d}\left(  v^{d}\otimes w^{d}\right)  =\Omega_{e}^{d}\left(
\overset{}{\left[  \digamma_{e}^{-1}\otimes I_{V}\right]  \left(  v^{d}\otimes
w^{d}\right)  }\right)  =\Xi_{VV^{d}}\left(  \sum_{1\leq j,k\leq r}\left(
e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}_{e}\left(  v\right)  _{j}%
\mathit{C}_{\digamma_{e}}\left(  \mathcal{R}_{e}\left(  w\right)  _{k}\right)
\right)  =\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  v\right)
_{j}\mathit{C}_{\digamma_{e}}\left(  \mathcal{R}_{e}\left(  w\right)
_{k}\right)  .
\end{equation}

\end{remark}

\begin{example}%
\begin{align}
x_{1}^{d}\left(  x_{2}\right)   &  =\left\langle \left.  \overline{x_{1}%
}\right\vert x_{2}\right\rangle =\left(  \left.  x_{1}\right\vert
x_{2}\right)  =\sum_{1\leq j\leq r}\mathcal{R}_{e}\left(  x_{1}\right)
_{j}\mathcal{R}_{e}\left(  x_{2}\right)  _{j}\\
x_{1}^{d}\left(  Bx_{2}\right)   &  =\left\langle \left.  \overline{x_{1}%
}\right\vert Bx_{2}\right\rangle =\left(  \left.  x_{1}\right\vert
Bx_{2}\right)  =\sum_{1\leq j\leq r}\mathcal{R}_{e}\left(  x_{1}\right)
_{j}\mathcal{R}_{e}\left(  Bx_{2}\right)  _{j}=\sum_{1\leq j,k\leq
r}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}_{e}\left(  B\right)
_{jk}\mathcal{R}_{e}\left(  x_{2}\right)  _{k}\\
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =b^{d}\left(  x_{1}\otimes
x_{2}\right)  =\sum_{1\leq j,k\leq r}\mathcal{R}_{\otimes^{2}e^{d}}\left(
b^{d}\right)  _{jk}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}%
_{e}\left(  x_{2}\right)  _{k}=\sum_{1\leq j,k\leq r}\mathcal{R}_{\otimes
^{2}e}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(  x_{1}\right)
_{j}\mathcal{R}_{e}\left(  x_{2}\right)  _{k}\\
&  =\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}%
\mathcal{R}_{\otimes^{2}e}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(
x_{2}\right)  _{k}=\left(  \left.  b\right\vert x_{1}\otimes x_{2}\right)
=\left\langle \left.  \overline{b}\right\vert x_{1}\otimes x_{2}\right\rangle
\\
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =b^{d}\left(  x_{1}\otimes
x_{2}\right)  =\Theta\left(  b^{\#}\right)  \left(  x_{1}\otimes x_{2}\right)
=x_{1}^{d}\left(  Bx_{2}\right)  =x_{1}^{d}\left(  Bx_{2}\right)
\end{align}%
\begin{equation}
\Theta:V\otimes V^{d}\rightarrow V^{d}\otimes V^{d}.
\end{equation}%
\begin{align}
b^{\#}  &  =\sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}^{d}\right)
\mathcal{R}_{e\otimes e^{d}}\left(  b^{\#}\right)  _{jk}=\sum_{1\leq j,k\leq
r}\left(  e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}_{e^{d}\otimes e^{d}%
}\left(  b^{d}\right)  _{jk}\\
\Theta\left(  b^{\#}\right)   &  =\sum_{1\leq j,k\leq r}\left(  e_{j}%
^{d}\otimes e_{k}^{d}\right)  \mathcal{R}_{e^{d}\otimes e^{d}}\left(
b^{d}\right)  _{jk}\\
\Theta &  =\digamma_{e}\otimes I_{V}%
\end{align}

\end{example}

\begin{example}%
\begin{align}
\mathfrak{b}\left(  x_{1},x_{2}\right)   &  =\sum_{1\leq j,k\leq r}\left(
e_{j}\otimes e_{k}\right\vert \left\vert x_{1}\otimes x_{2}\right)
\mathcal{R}_{\otimes^{2}\left\vert e\right)  }\left(  b\right)  _{jk}%
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}%
\mathcal{R}_{e}\left(  x_{2}\right)  _{k}\mathcal{R}_{\otimes^{2}\left\vert
e\right)  }\left(  b\right)  _{jk}\\
&  =\sum_{1\leq j,k\leq r}\left\langle e_{j}\otimes e_{k}\right\vert
\left\vert x_{1}\otimes x_{2}\right\rangle \overline{\mathcal{R}_{\otimes
^{2}\left\vert e\right\rangle }\left(  b\right)  _{jk}}=\sum_{1\leq j,k\leq
r}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}_{e}\left(
x_{2}\right)  _{k}\overline{\mathcal{R}_{\otimes^{2}\left\vert e\right\rangle
}\left(  b\right)  _{jk}}\\
&  =\left\langle x_{1}^{d},Bx_{2}\right\rangle =\sum_{1\leq j,k\leq
r}\mathcal{R}_{e}\left(  x_{1}\right)  _{j}\mathcal{R}_{e}\left(
x_{2}\right)  _{k}\mathcal{R}_{e}\left(  B\right)  _{jk}\\
&  =\left\langle x_{1}^{d},Bx_{2}\right\rangle =\sum_{1\leq j,k\leq
r}\overline{\mathcal{R}_{e}\left(  x_{1}\right)  _{j}}\mathcal{R}_{e}\left(
x_{2}\right)  _{k}\mathcal{R}_{e}\left(  B\right)  _{jk}.
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\left\langle \varepsilon^{d},v\right\rangle \in\mathbb{C}%
\end{equation}%
\begin{equation}
\left\langle \varepsilon^{d}\otimes\varrho^{d},v\otimes w\right\rangle
\in\mathbb{C}%
\end{equation}%
\begin{equation}
\left\langle \varepsilon^{d}\otimes\varrho^{d},\Omega_{e}\left(  v\otimes
w\right)  \right\rangle =\left\langle \Omega_{e}^{d}\left(  \varepsilon
^{d}\otimes\varrho^{d}\right)  ,v\otimes w\right\rangle \in\mathbb{C}%
\end{equation}%
\begin{align}
\Omega_{e}  &  :V\otimes V\rightarrow\mathcal{L}\left(  V\right) \\
\Omega_{e}\left(  v\otimes w\right)   &  =T_{vw}%
\end{align}%
\begin{equation}
\Omega_{e}^{d}:\mathcal{L}\left(  V\right)  ^{d}\rightarrow V^{d}\otimes V^{d}%
\end{equation}%
\begin{equation}
\Omega_{e}^{d}\left(  T_{vw}^{d}\right)  =v^{d}\otimes w^{d}=T_{vw}\circ
\Omega_{e}%
\end{equation}%
\begin{equation}
\mathfrak{b}\left(  v,w\right)  =\left\langle b^{d},v\otimes w\right\rangle
=\left\langle \left(  \otimes^{2}\digamma_{e}\right)  \left(  b\right)
,v\otimes w\right\rangle
\end{equation}%
\begin{equation}
\mathfrak{e}_{jk}\left(  v,w\right)  =\left\langle e_{jk}^{d},v\otimes
w\right\rangle =\left\langle \left(  \otimes^{2}\digamma_{e}\right)  \left(
e_{jk}\right)  ,v\otimes w\right\rangle
\end{equation}%
\begin{align}
e_{jk}  &  =e_{j}\otimes e_{k}\\
e_{jk}^{d}  &  =e_{j}^{d}\otimes e_{k}^{d}%
\end{align}%
\begin{equation}
E_{jk}=\Upsilon\left(  e_{j}\otimes e_{k}^{d}\right)  =\Upsilon\left(
e_{j}\otimes\digamma_{e}\left(  e_{k}\right)  \right)  =\Upsilon\left(
\digamma_{e}^{-1}\left(  e_{j}^{d}\right)  \otimes e_{k}^{d}\right)
=\Omega_{e}\left(  e_{j}\otimes e_{k}\right)  =\Omega_{e}^{d}\left(  e_{j}%
^{d}\otimes e_{k}^{d}\right)
\end{equation}
i.e.%
\begin{equation}
\Omega_{e}=\Upsilon\circ\left(  I_{V}\otimes\digamma_{e}\right)
\end{equation}%
\begin{equation}
E_{vw}=\Upsilon\left(  v\otimes w^{d}\right)  =\Upsilon\left(  v\otimes
\digamma_{e}\left(  w\right)  \right)  =\Upsilon\left(  \left[
\overset{}{I_{V}\otimes\digamma_{e}}\right]  \left(  v\otimes w\right)
\right)  =\left[  \Upsilon\circ\left(  \overset{}{I_{V}\otimes\digamma_{e}%
}\right)  \right]  \left(  v\otimes w\right)  =\Omega_{e}\left(  v\otimes
w\right)
\end{equation}%
\begin{equation}
v\otimes\digamma_{e}\left(  w\right)  =\sum_{1\leq j\leq r}e_{j}%
\mathcal{R}_{e}\left(  v\right)  _{j}\otimes\digamma_{e}\left(  w\right)
=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}\otimes
\digamma_{e}\left(  \sum_{1\leq k\leq r}e_{k}\mathcal{R}_{e}\left(  w\right)
_{k}\right)  =\sum_{1\leq j,k\leq r}\left(  e_{j}\otimes\digamma_{e}\left(
e_{k}\right)  \right)  \mathcal{R}_{e}\left(  v\right)  _{j}\mathfrak{c}%
_{\digamma_{e}}\left(  \mathcal{R}_{e}\left(  w\right)  _{k}\right)
\end{equation}%
\begin{equation}
\mathfrak{c}_{\digamma_{e}}\left(  z\right)  =\left\{
\begin{array}
[c]{c}%
z\text{ if }\digamma_{e}\text{ is }\mathbb{C}\text{-linear}\\
\overline{z}\text{if }\digamma_{e}\text{ is }\mathbb{C}\text{-anti linear}%
\end{array}
\right.
\end{equation}%
\begin{equation}
B=\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  B\right)  _{jk}%
=\sum_{1\leq j,k\leq r}\Omega_{e}\left(  e_{j}\otimes e_{k}\right)
\mathcal{R}_{e}\left(  B\right)  _{jk}%
\end{equation}

\end{remark}

\begin{lemma}
One can construct injections $\Omega_{e}$ from the tensor product $V\otimes V$
to the space of linear transformations $\mathcal{L}\left(  V\right)  $ acting
in $V$ i.e.
\begin{equation}
\Omega_{e}:V\otimes V\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
defined by
\begin{equation}
E_{v_{1}v_{2}}=\Omega_{e}\left(  \left(  v_{1},v_{2}\right)  \right)
=\Omega_{e}\left(  v_{1}\otimes v_{2}\right)  =\Xi_{VV^{d}}\left(
v_{1}\otimes\digamma_{e}\left(  v_{2}\right)  \right)  ,
\end{equation}
where $v_{1},v_{2}\in V.$
\end{lemma}

\begin{proof}
Consider the dual tensor product spaces $\bigotimes\nolimits^{2}V=V\otimes V$
and $\bigotimes\nolimits^{2}V^{d}=V^{d}\otimes V^{d}$ and elements $b$ $\in$
$V\otimes V=\bigotimes\nolimits^{2}V$ given by
\begin{equation}
b=\sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}\right)  \mathcal{R}%
_{\otimes^{2}e}\left(  b\right)  _{jk}%
\end{equation}
and complex bilinear functionals $\mathfrak{b}\in\mathcal{BL}\left(  V\right)
$ can be defined by
\begin{gather}
\mathfrak{b}\left(  v_{1},v_{2}\right)  =\left\langle b,v_{1}\otimes
v_{2}\right\rangle =\left\langle \sum_{1\leq j,k\leq r}\left(  e_{j}%
^{d}\otimes e_{k}^{d}\right)  \mathcal{R}_{\otimes^{2}e^{d}}\left(  b\right)
_{jk},v_{1}\otimes v_{2}\right\rangle \\
=\left\langle \sum_{1\leq j,k\leq r}\left(  e_{j}^{d}\otimes e_{k}^{d}\right)
\mathcal{R}_{\otimes^{2}e^{d}}\left(  b\right)  _{jk},\sum_{1\leq j,k\leq
r}\left(  e_{j}\otimes e_{k}\right)  \mathcal{R}_{e}\left(  v_{1}\right)
_{j}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\right\rangle \\
=\sum_{1\leq j,k\leq r}\sum_{1\leq l,m\leq r}\left\langle \overset{}{\left(
e_{j}^{d}\otimes e_{k}^{d}\right)  ,\left(  e_{l}\otimes e_{m}\right)
}\right\rangle \mathcal{R}_{\otimes^{2}e^{d}}\left(  b\right)  _{jk}%
\mathcal{R}_{e}\left(  v_{1}\right)  _{l}\mathcal{R}_{e}\left(  v_{2}\right)
_{m}\\
=\sum_{1\leq j,k\leq r}\sum_{1\leq l,m\leq r}\delta_{jl}\delta_{km}%
\mathcal{R}_{\otimes^{2}e^{d}}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(
v_{1}\right)  _{l}\mathcal{R}_{e}\left(  v_{2}\right)  _{m}\\
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  v_{1}\right)  _{j}%
\mathcal{R}_{\otimes^{2}e^{d}}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(
v_{2}\right)  _{k}\\
=\mathcal{R}_{e}\left(  v_{1}\right)  ^{t}\mathcal{R}_{e}\left(  B\right)
\mathcal{R}_{e}\left(  v_{2}\right)  ,
\end{gather}
where%
\begin{equation}
\mathcal{R}_{e^{d}}\left(  B\right)  _{jk}=\mathcal{R}_{\otimes^{2}e^{d}%
}\left(  b\right)  _{jk},\text{ }1\leq j,k\leq r,
\end{equation}
defines the operator $B=\Omega_{e}\left(  b\right)  \in\mathcal{L}\left(
V\right)  $ given by
\begin{equation}
B=\sum_{1\leq j,k\leq r}\left(  e_{j}\otimes e_{k}^{d}\right)  \mathcal{R}%
_{e}\left(  B\right)  _{jk}=\Omega_{e}\left(  \sum_{1\leq j,k\leq r}\left(
e_{j}\otimes e_{k}\right)  \mathcal{R}_{e^{d}\otimes e^{d}}\left(  b\right)
_{jk}\right)  =\Omega_{e}\left(  b\right)  .
\end{equation}

\end{proof}

\begin{notation}%
\begin{equation}
E_{v_{1}v_{2}}=\Omega_{e}\left(  \left(  v_{1},v_{2}\right)  \right)
=\Omega_{e}\left(  v_{1}\otimes v_{2}\right)  =\Xi_{VV^{d}}\left(
v_{1}\otimes\digamma_{\left\vert e\right)  }\left(  v_{2}\right)  \right)
\equiv\left\vert v_{1}\right)  \left(  v_{2}^{b}\right\vert ,
\end{equation}%
\begin{equation}
E_{v_{1}v_{2}}=\Omega_{e}\left(  \left(  v_{1},v_{2}\right)  \right)
=\Omega_{e}\left(  v_{1}\otimes v_{2}\right)  =\Xi_{VV^{d}}\left(
v_{1}\otimes\digamma_{\left\vert e\right\rangle }\left(  v_{2}\right)
\right)  \equiv\left\vert v_{1}\right\rangle \left\langle v_{2}^{b}\right\vert
,
\end{equation}

\end{notation}

\begin{remark}
Recall
\begin{equation}
\Omega_{e}:V\otimes V\rightarrow\mathcal{L}\left(  V\right)  .
\end{equation}
is defined by%
\begin{equation}
\Omega_{e}\left(  v_{1}\otimes v_{2}\right)  =\Xi_{VV^{d}}\left(  v_{1}%
\otimes\digamma_{e}\left(  v_{2}\right)  \right)
\end{equation}
and
\begin{equation}
\mathfrak{b}\left(  v_{1},v_{2}\right)  =\left\langle b^{d},v_{1}\otimes
v_{2},\right\rangle =\left\langle \digamma_{e}\left(  b\right)  ,v_{1}\otimes
v_{2}\right\rangle .
\end{equation}

\end{remark}

\begin{definition}
A quadratic form over a field $\mathbb{F}$ is a map
\begin{equation}
q:V\rightarrow\mathbb{F}%
\end{equation}
from a finite-dimensional $\mathbb{F}$-vector space to $\mathbb{F}$ such that
\begin{equation}
q(av)=a^{2}q(v),\,\forall a\in\mathbb{F},v\in V
\end{equation}
and the function%
\begin{equation}
\left(  \left.  u\right\vert v\right)  _{q}=q(u+v)-q(u)-q(v)
\end{equation}
is bilinear.
\end{definition}

\begin{remark}
More concretely, an $r$-ary quadratic form over a field $\mathbb{F}$ is a
homogeneous polynomial of degree $2$ in $r$ variables with coefficients in
$\mathbb{F}$%
\begin{equation}
q(x_{1},\ldots\ ,x_{r})=\sum_{1\leq j,k\leq r}Q_{jk}x_{j}x_{k},\,\quad
Q_{jk},x_{j},x_{k}\in\mathbb{F}.
\end{equation}
This formula may be rewritten using matrices: let\textbf{ }$\mathbf{x}$ be the
column vector with components coefficients $x_{1},\ldots\ ,x_{r}$ and
$\mathbb{Q}$ $=\left\{  Q_{jk}\right\}  \in\mathcal{M}\left(  r,r,\mathbb{F}%
\right)  $ be the $r\times r$ matrix over $\mathbb{F}$ whose entries are the
coefficients of $\mathbb{Q}$. Then%
\begin{equation}
q\left(  \mathbf{x,x}\right)  =\mathbf{x}^{t}\mathbb{Q}\mathbf{x.}%
\end{equation}

\end{remark}

\begin{remark}
$q$ can be extended to a bilinear form $\left(  \left.  {}\right\vert \right)
_{q}$
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{q}:V\times V\rightarrow\mathbb{F}%
\end{equation}
by
\begin{equation}
\left(  \left.  \mathbf{x}_{1}\right\vert \mathbf{x}_{2}\right)
_{q}=\mathbf{x}_{1}^{t}\mathbb{Q}\mathbf{x}_{2}%
\end{equation}
so that
\begin{equation}
\left(  \left.  \mathbf{x}_{1}\right\vert \mathbf{x}_{2}\right)  _{q}%
=\sum_{1\leq j,k\leq r}Q_{jk}x_{1j}x_{2k}.
\end{equation}

\end{remark}

\subsection{Skew Symmetric Functions}

\begin{definition}
The action of a permutation $\sigma$ on a \emph{multilinear} function $\Phi$
is
\begin{equation}
\sigma\left(  \Phi\left(  x_{1},\cdots,x_{n}\right)  \right)  =\Phi\left(
x_{\sigma\left(  1\right)  },\cdots,x_{\sigma\left(  n\right)  }\right)
;\quad\sigma\in S_{n},\,x_{j}\in V,1\leq j\leq n,
\end{equation}
where
\begin{equation}
\Phi:\overset{n}{\overbrace{V\times\cdots\times V}}\,\rightarrow\mathbb{C}.
\end{equation}

\end{definition}

\begin{definition}
$\Phi$ is skew symmetric if
\begin{equation}
\sigma\left(  \Phi\left(  x_{1},\cdots,x_{n}\right)  \right)  =\pi\left(
\sigma\right)  \Phi\left(  x_{1},\cdots,x_{n}\right)  ,
\end{equation}
where
\begin{equation}
\pi\left(  \sigma\right)  =\left\{
\begin{array}
[c]{c}%
\quad\quad1\text{ if }\sigma\text{ is even, i.e. }\sigma\text{ can be factored
as an even number of transpositions }\\
-1\text{ if }\sigma\text{ is odd, i.e. }\sigma\text{ can be factored as an odd
number of transpositions}%
\end{array}
\right.  .
\end{equation}

\end{definition}

Let $\left\vert \Psi\right\rangle \in{\LARGE \wedge}^{n}V$ then
\begin{equation}
\left\vert \Psi\right\rangle =\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\left\vert
e_{j_{1}}\cdots e_{j_{n}}\right\rangle c_{j_{1}\cdots j_{n}}=\sum_{1\leq
j_{1}<\cdots<j_{n}\leq r}\left\vert e_{j_{1}}\cdots e_{j_{n}}\right\rangle
\mathcal{R}_{\wedge^{n}e}\left(  \Psi\right)  _{j_{1}\cdots j_{n}},
\end{equation}
where%
\begin{equation}
c_{j_{1}\cdots j_{n}}\left(  \Psi\right)  =\left\langle e_{j_{1}}^{d}%
\wedge\cdots\wedge e_{j_{n}}^{d},\Psi\right\rangle =\left(  e_{j_{1}}%
^{d}\wedge\cdots\wedge e_{j_{n}}^{d}\right)  \left(  \Psi\right)
=\mathcal{R}_{\wedge^{n}e}\left(  \Psi\right)  _{j_{1}\cdots j_{n}},
\end{equation}
$\left\{  \left.  e_{j_{1}}^{d}\wedge\cdots\wedge e_{j_{n}}^{d}\right\vert
1\leq j_{1}<\cdots<j_{n}\leq r\right\}  $ is a basis of ${\LARGE \wedge}%
^{n}V^{d}$ and any vector $x_{k}\in V$ can be expanded
\begin{equation}
x_{k}=\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle e_{j}^{d}\left(
x_{k}\right)  =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle
\mathcal{R}_{e}\left(  x_{k}\right)  _{j},\quad x_{k}\in V.
\end{equation}


Let $\left\vert \Psi\right\rangle \in{\LARGE \wedge}^{n}\mathcal{H}^{1}$ then
\begin{equation}
\left\vert \Psi\right\rangle =\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\left\vert
e_{j_{1}}\cdots e_{j_{n}}\right\rangle c_{j_{1}\cdots j_{n}}=\sum_{1\leq
j_{1}<\cdots<j_{n}\leq r}\left\vert e_{j_{1}}\cdots e_{j_{n}}\right\rangle
\mathcal{R}_{\wedge^{n}e}\left(  \Psi\right)  _{j_{1}\cdots j_{n}},
\end{equation}
where%
\begin{equation}
c_{j_{1}\cdots j_{n}}=\mathcal{R}_{\wedge^{n}e}\left(  \Psi\right)
_{j_{1}\cdots j_{n}}=\left\langle \left.  e_{j_{1}}\cdots e_{j_{n}}\right\vert
\Psi\right\rangle .
\end{equation}


The overlap of $\Psi$ with decomposable elements of the $n^{th}$-grade
elements $\left\{  x_{1}^{d}\wedge\cdots\wedge x_{n}^{d}\right\}  $ of the
dual exterior algebra ${\LARGE \wedge}\left(  V^{d}\right)  $ produce skew
symmetric functions that can be expanded as
\begin{gather}
\Psi\left(  x_{1}^{d},\cdots,x_{n}^{d}\right)  =\left\langle x_{1}^{d}%
\wedge\cdots\wedge x_{n}^{d},\Psi\right\rangle =\left\langle \left(
\sum_{1\leq j_{1}\leq r}e_{j_{1}}^{d}x_{j_{1}1}\right)  \wedge\cdots
\wedge\left(  \sum_{1\leq j_{n}\leq r}e_{j_{n}}^{d}x_{j_{n}n}\right)
,\Psi\right\rangle \\
=\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\left\langle e_{j_{1}}^{d}\wedge
\cdots\wedge e_{j_{n}}^{d},\Psi\right\rangle \mathcal{R}_{\wedge^{n}e}\left(
\Psi\right)  _{j_{1}\cdots j_{n}}%
\end{gather}
and defines skew symmetric $n$-ary multilinear functionals
\begin{equation}
\Psi\left(  x_{1}^{d},\cdots,x_{n}^{d}\right)  =\left\langle x_{1}^{d}%
\wedge\cdots\wedge x_{n}^{d},\Psi\right\rangle =\left(  x_{1}^{d}\wedge
\cdots\wedge x_{n}^{d}\right)  \left(  \overset{}{\Psi}\right)  .
\end{equation}


\begin{remark}
The transformation from the vector space $V$ to its dual $V^{d}$
\begin{equation}
e_{j}^{d}=\digamma_{e}\left(  e_{j}\right)  ,
\end{equation}
where $\digamma_{e}$ may be linear or antilinear.
\end{remark}

\begin{remark}
One can observe the following equalities between scalr products
\begin{align}
\left(  e_{j}\otimes e_{k}\right)  ^{d}  &  =\left(  e_{j}^{d}\otimes
e_{k}^{d}\right) \\
\left[  \overset{}{e_{j}^{d}\otimes e_{k}^{d}}\right]  \left(
\overset{}{v\otimes w}\right)   &  =e_{j}^{d}\left(  v\right)  \otimes
e_{k}^{d}\left(  w\right)  =v^{d}\left(  e_{j}\right)  \otimes w^{d}\left(
e_{k}\right) \\
\left[  \overset{}{e_{j}^{d}\otimes e_{k}^{d}}\right]  \left(
\overset{}{v^{d}\otimes w}\right)   &  =e_{j}\left(  v^{d}\right)  \otimes
e_{k}^{d}\left(  w\right)  =v^{d}\left(  e_{j}\right)  \otimes w^{d}\left(
e_{k}\right) \\
\left[  \overset{}{e_{j}^{d}\otimes e_{k}^{d}}\right]  \left(
\overset{}{v\otimes w^{d}}\right)   &  =e_{j}^{d}\left(  v\right)  \otimes
e_{k}\left(  w^{d}\right)  =v^{d}\left(  e_{j}\right)  \otimes w^{d}\left(
e_{k}\right)
\end{align}

\end{remark}

\begin{remark}
The map $\Omega_{e}$ from the tensor product to the space of linear opeators
on $V$
\begin{equation}
\Xi_{VV^{d}}:V\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
is given by
\begin{equation}
E_{j_{1}j_{2}}\left(  v\right)  =\left[  \overset{}{e_{j_{1}}}\right]  \left(
\overset{}{\left(  e_{j_{2}}^{d}\right)  }\left(  v\right)  \right)  ,
\end{equation}
i.e.
\begin{equation}
V\otimes V^{d}\left(  e_{j_{1}}\otimes e_{j_{2}}^{d}\right)  =E_{j_{1}j_{2}}%
\end{equation}
and
\begin{equation}
\Xi_{VV^{d}}:V\otimes V\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
is given by
\begin{equation}
E_{j_{1}j_{2}}\left(  v\right)  =\left[  \overset{}{e_{j_{1}}}\right]  \left(
\left(  \overset{}{\digamma_{e}\left(  e_{j_{2}}\right)  }\right)  \left(
v\right)  \right)  ,
\end{equation}
i.e.
\begin{equation}
\Xi_{VV}\left(  e_{j_{1}}\otimes e_{j_{2}}\right)  =\Xi_{VV^{d}}\left(
e_{j_{1}}\otimes e_{j_{2}}^{d}\right)  =E_{j_{1}j_{2}}.
\end{equation}

\end{remark}

\begin{remark}
Note that $\digamma_{e}$ may be anti linear, hence $\Xi_{VV^{d}}$ sesquilinear.
\end{remark}

\begin{remark}
The action of the general operator $E_{w_{1}w_{2}}$ is given by
\begin{equation}
E_{w_{1}w_{2}}\left(  v\right)  =\left[  \sum_{1\leq j_{1}\leq r}%
\overset{}{e_{j_{1}}}\mathcal{R}_{e}\left(  w_{1}\right)  _{j_{1}}\right]
\left(  \left(  \overset{}{\digamma_{e}\left(  \sum_{1\leq j_{2}\leq
r}e_{j_{2}}\mathcal{R}_{e}\left(  w_{2}\right)  \right)  }\right)  \left(
v\right)  \right)  .
\end{equation}

\end{remark}

\begin{remark}
Hence the action of the operators $E_{w_{1}w_{2}}$ by
\begin{gather}
E_{w_{1}w_{2}}\left(  v\right)  =\left[  w_{1}\right]  \left(  w_{2}%
^{d}\left(  v\right)  \right)  =\left[  w_{1}\right]  \left(  \digamma
_{e}\left(  w_{2}\right)  \left(  v\right)  \right)  =\sum_{1\leq j_{1}%
,j_{2}\leq r}\left[  \overset{}{e_{j_{1}}}\right]  \mathcal{R}_{e}\left(
w_{1}\right)  _{j_{1}}\left(  e_{j_{2}}^{d}\right)  \left(  \overset{}{v}%
\right)  \mathcal{R}_{e}\left(  \digamma_{e}\left(  w_{2}\right)  \right)
_{j_{2}}\\
=\sum_{1\leq j_{1},j_{2}\leq r}\left[  \overset{}{e_{j_{1}}}\right]  \left(
\left(  e_{j_{2}}^{d}\right)  \left(  \overset{}{v}\right)  \right)
\mathcal{R}_{e}\left(  w_{1}\right)  _{j_{1}}\mathcal{R}_{e}\left(
\digamma_{e}\left(  w_{2}\right)  \right)  _{j_{2}}=\sum_{1\leq j_{1}%
,j_{2}\leq r}\left[  \overset{}{e_{j_{1}}}\right]  \mathcal{R}_{e}\left(
w_{1}\right)  _{j_{1}}\mathcal{R}_{e}\left(  v\right)  _{j_{2}}\mathcal{R}%
_{e}\left(  \digamma_{e}\left(  w_{2}\right)  \right)  _{j_{2}}.
\end{gather}
$\lceil$%
\begin{equation}
\left\vert w_{1}\right\rangle \left\langle w_{2}\right\vert \left\vert
v\right\rangle =\sum_{1\leq j_{1},j_{2}\leq r}\left\vert e_{j_{1}%
}\right\rangle \mathcal{R}_{e}\left(  w_{1}\right)  _{j_{1}}\overline
{\mathcal{R}_{e}\left(  w_{2}\right)  _{j_{2}}}\mathcal{R}_{e}\left(
v\right)  _{j_{2}}=\sum_{1\leq j_{1}\leq r}\left\vert e_{j_{1}}\right\rangle
\mathcal{R}_{e}\left(  w_{1}\right)  _{j_{1}}\sum_{1\leq j_{2}\leq r}%
\overline{\mathcal{R}_{e}\left(  w_{2}\right)  _{j_{2}}}\mathcal{R}_{e}\left(
v\right)  _{j_{2}}.
\end{equation}
$\rfloor$
\end{remark}

\begin{remark}%
\begin{align}
A\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  A\right) \\
\mathcal{R}_{e}\left(  A\right)  _{jk}  &  =\left\langle e_{j}^{d}%
,Ae_{k}\right\rangle =e_{j}^{d}\left(  Ae_{k}\right)  =e_{j}^{d}\left(
\sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left(  A\right)  _{lk}\right)
=\mathcal{R}_{e}\left(  A\right)  _{jk}\\
&  k\text{ labels columns; }j\text{ labels rows.}%
\end{align}

\end{remark}

\begin{remark}
Any operator $A$ can be expanded as
\begin{equation}
A=\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  A\right)  _{jk}.
\end{equation}

\end{remark}

\begin{remark}
The matrix elements of the elementary matrices $E_{jk}$ are
\begin{equation}
\left[  e_{l}^{d}\right]  \left(  E_{jk}e_{m}\right)  =\left(  \left[
e_{l}^{d}\right]  \left(  e_{j}\right)  \right)  \left(  \left[  e_{k}%
^{d}\right]  \left(  e_{m}\right)  \right)  =\delta_{lj}\delta_{km}.
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item The $\mathcal{R}_{e}$ representation $\mathcal{R}_{e}\left(  A\right)  $
of the operator $A$ is given by
\begin{equation}
A\left(  \mathbf{e}\right)  =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(
A\right)
\end{equation}


\item producing the matrices
\begin{equation}
\mathcal{M}_{e}\left(  A\right)  =\mathbf{e}^{d}\left(  A\left(
\mathbf{e}\right)  \right)  =\mathbf{e}^{d}\left(  \left(  \mathbf{e}\right)
\mathcal{R}_{e}\left(  A\right)  \right)  =\mathbf{e}^{d}\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  A\right)  =\mathcal{R}_{e}\left(
A\right)  ,
\end{equation}


\item which have matrix elements
\begin{equation}
e_{l}^{d}\left(  Ae_{m}\right)  =e_{l}^{d}\left(  \sum_{1\leq j,k\leq r}%
E_{jk}\mathcal{R}_{e}\left(  A\right)  _{jk}e_{m}\right)  =\sum_{1\leq j,k\leq
r}\delta_{lj}\delta_{km}\mathcal{R}_{e}\left(  A\right)  _{jk}=\mathcal{R}%
_{e}\left(  A\right)  _{lm}=\mathcal{M}_{\left(  e\right)  }\left(  A\right)
_{lm}.
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}%
\begin{equation}
\Xi_{VV}\left(  e_{j_{1}}\otimes e_{j_{2}}\right)  =\Xi_{VV^{d}}\left(
e_{j_{1}}\otimes e_{j_{2}}^{d}\right)  =E_{j_{1}j_{2}},
\end{equation}
and the coefficients of the $\mathcal{R}_{e}$ representation of vector a
$x_{1}\in V$ is given by
\[
\left[  \overset{}{e_{k}^{d}}\right]  \left(  \Xi_{VV^{d}}\left(  \sum_{1\leq
j\leq r}x_{1}\otimes e_{j}^{d}\right)  \left(  e_{l}\right)  \right)
=\left\langle e_{k}^{d},\Xi_{VV^{d}}\left(  \sum_{1\leq j\leq r}x_{1}\otimes
e_{j}^{d}\right)  \left(  e_{l}\right)  \right\rangle =\left\langle e_{k}%
^{d},\sum_{1\leq j\leq r}e_{j}^{d}\left(  e_{l}\right)  x_{1}\right\rangle
=\left\langle e_{k}^{d},x_{1}\right\rangle =\mathcal{R}_{e}\left(
x_{1}\right)  _{j_{k}}.
\]

\end{remark}

\begin{remark}
In general the products of elementary operators are given by
\begin{equation}
E_{jk}E_{lm}=E_{jm}\delta_{kl},
\end{equation}
which in particular gives
\begin{align}
E_{jk}E_{km}  &  =E_{jm}\\
E_{jk}E_{kj}  &  =E_{jj}\\
E_{jj}^{2}  &  =E_{jj}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
E_{jk}e_{l}=e_{j}\delta_{kl}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
e_{m}^{d}\left(  E_{jk}e_{l}\right)  =e_{m}^{d}\left(  e_{j}\right)
\delta_{kl}=\delta_{mj}\delta_{kl}.
\end{equation}

\end{remark}

\begin{definition}
Embeddings $\mathfrak{V}_{e}$
\begin{equation}
\mathfrak{V}_{e}:\mathcal{P}\left(  V\right)  \rightarrow\mathcal{L}\left(
V\right)
\end{equation}
of \emph{ordered sets} $\mathfrak{S}_{p}\in\mathcal{P}\left(  V\right)  $ of
vectors $v\in V$ into the space $\mathcal{L}\left(  V\right)  $ of linear
operators acting in $V$ is defined by
\begin{equation}
\mathcal{V}_{ep}=\mathfrak{V}_{e}\left(  \mathfrak{S}_{p}\right)  =\sum
_{1\leq\kappa\leq p}\sum_{1\leq j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(
v_{\kappa}\right)  _{j}\in\mathcal{L}\left(  V\right)  ,
\end{equation}
where
\begin{equation}
\mathfrak{S}_{p}=\left\{  v_{1},\cdots,v_{p}\right\}  \in\mathcal{P}\left(
V\right)  .
\end{equation}

\end{definition}

\begin{remark}
The $\mathcal{R}_{e}$ representation matrices of $\mathcal{V}_{e\kappa
}=\mathfrak{V}_{e}\left(  \left\{  \mathfrak{\nu}_{\kappa}\right\}  \right)
=\mathfrak{V}_{e}\left(  \mathfrak{S}_{1}\right)  ,$ where $\mathfrak{S}%
_{1}=\left\{  \mathfrak{\nu}_{\kappa}\right\}  $ have the form

\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{e}\left(  \sum_{1\leq j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(
v_{\kappa}\right)  _{j}\right)  _{ml}=e_{m}^{d}\left(  \left(  \sum_{1\leq
j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(  v_{\kappa}\right)  _{j}\right)
e_{l}\right)  =\sum_{1\leq j\leq r}e_{m}^{d}\left(  \overset{}{E_{j\kappa
}e_{l}}\right)  \mathcal{R}_{e}\left(  v_{\kappa}\right)  _{j}=\sum_{1\leq
j\leq r}\delta_{mj}\delta_{\kappa l}\mathcal{R}_{e}\left(  v_{\kappa}\right)
_{j}=\delta_{\kappa l}\mathcal{R}_{e}\left(  v_{\kappa}\right)  _{m},
\end{equation}


\item which are concretely expressed as the matrix with one nonzero column
\begin{equation}
\mathcal{R}_{e}\left(  \sum_{1\leq j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(
v_{\kappa}\right)  _{j}\right)  =\overset{\longleftarrow\longleftarrow
\longleftarrow\longleftarrow\longleftarrow\longleftarrow\longleftarrow
\longleftarrow\longleftarrow\longleftarrow\longleftarrow\longleftarrow
\qquad\qquad\qquad\qquad{\LARGE \kappa}\qquad\qquad\qquad\qquad\rightarrow
\rightarrow\rightarrow\rightarrow\rightarrow\rightarrow\rightarrow
\rightarrow\rightarrow\rightarrow\rightarrow\rightarrow\rightarrow
\rightarrow}{\left(
\begin{array}
[c]{ccccccc}%
\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v_{\kappa}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v_{\kappa}\right)  _{r}%
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)
\end{array}
\right)  }.
\end{equation}

\end{enumerate}
\end{remark}

\begin{definition}
The \emph{column operators} $C_{\kappa}\left(  A\right)  \in\mathcal{L}\left(
V\right)  $ derived from the operator $A\in\mathcal{L}\left(  V\right)  $ are
defined by
\begin{equation}
C_{\kappa}\left(  A\right)  =AE_{\kappa\kappa}=\sum_{1\leq j,k\leq r}%
E_{jk}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}E_{\kappa\kappa}=\sum_{1\leq
j,k\leq r}E_{jk}E_{\kappa\kappa}\mathcal{R}_{e}\left(  A\right)  _{j\kappa
}=\sum_{1\leq j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(  A\right)  _{j\kappa
}=\sum_{1\leq j,k\leq r}E_{j\kappa}\mathcal{R}_{e}\left(  C_{\kappa}\left(
A\right)  \right)  _{jk},
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  C_{\kappa}\left(  A\right)  \right)  =\left(
\begin{array}
[c]{ccccccc}%
\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  A\right)  _{1\kappa}\\
\vdots\\
\mathcal{R}_{e}\left(  A\right)  _{r\kappa}%
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0
\end{array}
\right)
\end{array}
\right)  .
\end{equation}

\end{definition}

\begin{definition}
$q$ dimensional idempotent operators $E\left(  K_{\sigma\left(  q\right)
}\right)  $
\begin{equation}
E\left(  K_{\sigma\left(  q\right)  }\right)  =\sum_{\kappa\in K_{\sigma
\left(  q\right)  }}E_{\kappa\kappa},
\end{equation}
where
\begin{equation}
K_{\sigma\left(  q\right)  }=\left\{  \kappa_{1},\cdots,\kappa_{\sigma\left(
q\right)  }\right\}  \in\mathcal{P}_{q}\left\{  \mathbb{N}\right\}
\subset\mathcal{P}\left\{  \mathbb{N}\right\}  .
\end{equation}

\end{definition}

\begin{remark}
Column block operators are constructed by
\begin{align}
A\sum_{\kappa\in K_{\sigma\left(  q\right)  }}E_{\kappa\kappa}  &  =AE\left(
K\right)  =\sum_{1\leq j,k\leq r}\sum_{\kappa\in K_{\sigma\left(  q\right)  }%
}E_{jk}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}E_{\kappa\kappa}=\sum_{1\leq
j,k\leq r}\sum_{\kappa\in K_{\sigma\left(  q\right)  }}E_{jk}E_{\kappa\kappa
}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}\\
&  =\sum_{1\leq j,k\leq r}\sum_{\kappa\in K_{\sigma\left(  q\right)  }}%
E_{jk}\delta_{k\kappa}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}=\sum_{1\leq
j\leq r}\sum_{\kappa\in K_{\sigma\left(  q\right)  }}E_{j\kappa}%
\mathcal{R}_{e}\left(  A\right)  _{j\kappa}.
\end{align}

\end{remark}

\begin{definition}
The column block operators $CB\left(  A\right)  _{K}$ $\in\mathcal{L}\left(
V\right)  $ derived from the operator $A\in\mathcal{L}\left(  V\right)  $ are
defined by
\begin{gather}
CB_{K_{\sigma\left(  q\right)  }}\left(  A\right)  =AE\left(  K_{\sigma\left(
q\right)  }\right)  =A\sum_{\kappa\in K_{\sigma\left(  q\right)  }}%
E_{\kappa\kappa}=\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  A\right)
_{jk}\sum_{\kappa\in K_{\sigma\left(  q\right)  }}E_{\kappa\kappa}=\sum_{1\leq
j,k\leq r}\sum_{\kappa\in K_{\sigma\left(  q\right)  }}E_{jk}E_{\kappa\kappa
}\mathcal{R}_{e}\left(  A\right)  _{jk}\\
=\sum_{1\leq j\leq r}\sum_{\kappa\in K_{\sigma\left(  q\right)  }}E_{j\kappa
}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}=\sum_{1\leq j\leq r}%
E_{jk}\mathcal{R}_{e}\left(  CB_{K_{\sigma\left(  q\right)  }}\left(
A\right)  \right)  _{jk}.
\end{gather}

\end{definition}

\begin{definition}
The row operators $R\left(  A\right)  _{\iota}$ $\in\mathcal{L}\left(
V\right)  $ derived from the operator $A\in\mathcal{L}\left(  V\right)  $ are
defined by%
\begin{equation}
R_{\iota}\left(  A\right)  =E_{\iota\iota}A=\sum_{1\leq j,k\leq r}%
E_{\iota\iota}E_{jk}\mathcal{R}_{e}\left(  A\right)  _{jk}=\sum_{1\leq k\leq
r}E_{\iota k}\mathcal{R}_{e}\left(  A\right)  _{\iota\kappa}=\sum_{1\leq
j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  R\left(  A\right)  _{\iota}\right)
_{jk},
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  R_{\iota}\left(  A\right)  \right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{ccc}%
\qquad0\qquad & \cdots & \qquad0\quad
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{ccc}%
\qquad0\qquad & \cdots & \qquad0\quad
\end{array}
\right) \\
\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  A\right)  _{\iota1} & \cdots & \mathcal{R}_{e}\left(
A\right)  _{\iota r}%
\end{array}
\right) \\
\left(
\begin{array}
[c]{ccc}%
\qquad0\qquad & \cdots & \qquad0\quad
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{ccc}%
\qquad0\qquad & \cdots & \qquad0\quad
\end{array}
\right)
\end{array}
\right)  .
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
\sum_{1\leq j\leq q}E_{\iota_{j}\iota_{j}}A=\sum_{1\leq j\leq q}E_{\iota
_{j}\iota_{j}}\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  A\right)
_{j\kappa}=\sum_{1\leq j,k\leq r}\sum_{1\leq l\leq q}E_{\iota_{j}\iota_{j}%
}E_{jk}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}=\sum_{1\leq j,k\leq r}%
\sum_{1\leq l\leq q}E_{\iota_{j}k}\delta_{\iota_{l}j}\mathcal{R}_{e}\left(
A\right)  _{j\kappa}=\sum_{1\leq j\leq r}\sum_{1\leq l\leq q}E_{\kappa_{l}%
j}\mathcal{R}_{e}\left(  A\right)  _{j\kappa}%
\end{equation}

\end{remark}

\begin{definition}
The row block operators $RB_{K_{\sigma\left(  q\right)  }}\left(  A\right)  $
$\in\mathcal{L}\left(  V\right)  $ derived from the operator $A\in
\mathcal{L}\left(  V\right)  $ are defined by%
\begin{gather}
RB_{K_{\sigma\left(  p\right)  }}\left(  A\right)  =E\left(  K_{\sigma\left(
p\right)  }\right)  A=\sum_{\iota\in K_{\sigma\left(  p\right)  }}R_{\iota
}\left(  A\right)  =\sum_{\iota\in K_{\sigma\left(  p\right)  }}E_{\iota\iota
}A=\sum_{\iota\in K_{\sigma\left(  p\right)  }}\sum_{1\leq j,k\leq r}%
E_{\iota\iota}E_{jk}\mathcal{R}_{e}\left(  A\right)  _{jk}=\sum_{\iota\in
K_{\sigma\left(  p\right)  }}\sum_{1\leq k\leq r}E_{\iota k}\mathcal{R}%
_{e}\left(  A\right)  _{\iota\kappa}\\
=\sum_{\iota\in K_{\sigma\left(  p\right)  }}\sum_{1\leq j,k\leq r}%
E_{jk}\mathcal{R}_{e}\left(  R\left(  A\right)  _{\iota}\right)  _{jk}%
=\sum_{1\leq j,k\leq r}E_{jk}\mathcal{R}_{e}\left(  RB_{K_{\sigma\left(
p\right)  }}\left(  A\right)  \right)  _{jk}.
\end{gather}

\end{definition}

\begin{definition}
The block submatrix $\mathbb{M}\left(  \text{rows},\text{columns}\right)
=\mathbb{M}\left(  J_{\sigma\left(  p\right)  },K_{\sigma\left(  q\right)
}\right)  =\mathbb{M}\left(  \left\{  j_{1},\cdots,j_{p}\right\}  ,\left\{
k_{1},\cdots,k_{q}\right\}  \right)  \in\mathbb{\mathcal{M}}\left(
p,q,\mathbb{C}\right)  $%
\begin{equation}
\mathbb{M}\left(  J_{\sigma\left(  p\right)  },K_{\mu\left(  q\right)
}\right)  =\mathbb{M}\left(  \left\{  j_{\sigma\left(  1\right)  }%
,\cdots,j_{\sigma\left(  p\right)  }\right\}  ,\left\{  k_{\mu\left(
1\right)  },\cdots,k_{\mu_{\left(  q\right)  }}\right\}  \right)  =\left(
\begin{array}
[c]{ccc}%
m_{j_{\sigma\left(  1\right)  }k_{\mu\left(  1\right)  }} & \cdots &
m_{j_{\sigma\left(  1\right)  }k_{\mu_{\left(  q\right)  }}}\\
\vdots & \ddots & \vdots\\
\vdots & \ddots & \vdots\\
m_{j_{\sigma\left(  p\right)  }k_{\mu\left(  1\right)  }} & \cdots &
m_{j_{\sigma\left(  p\right)  }k_{\mu_{\left(  q\right)  }}}%
\end{array}
\right)
\end{equation}
of the matrix $\mathbb{M\in\mathcal{M}}\left(  m,n,\mathbb{C}\right)  $
\begin{equation}
\mathbb{M}=\left(
\begin{array}
[c]{ccc}%
m_{11} & \cdots & m_{1n}\\
\vdots & \ddots & \vdots\\
\vdots & \ddots & \vdots\\
m_{m1} & \cdots & m_{mn}%
\end{array}
\right)
\end{equation}
is defined by selecting the rows $J_{\sigma\left(  p\right)  }=\left\{
j_{\sigma\left(  1\right)  },\cdots,j_{\sigma\left(  p\right)  }\right\}  $
and the columns $K_{\mu\left(  q\right)  }=\left\{  k_{\mu\left(  1\right)
},\cdots,k_{\mu_{\left(  q\right)  }}\right\}  $ from the matrix $\mathbb{M}$.
\end{definition}

\begin{definition}
Restricted operators $A\left(  J_{\sigma\left(  p\right)  },K_{\mu\left(
q\right)  }\right)  \in\mathcal{L}\left(  V\right)  $ are defined by
\begin{equation}
A\left(  J_{\sigma\left(  p\right)  },K_{\mu\left(  q\right)  }\right)
=E\left(  J_{\sigma\left(  p\right)  }\right)  AE\left(  K_{\mu\left(
q\right)  }\right)  =\sum_{\iota\in J_{\sigma\left(  p\right)  },\kappa\in
K_{\mu\left(  q\right)  }}E_{\iota\iota}AE_{\kappa\kappa}%
\end{equation}

\end{definition}

\begin{remark}%
\begin{align}
\mathcal{R}_{e}\left(  A\right)  \left(  J_{\sigma\left(  p\right)  }%
,K_{\mu\left(  q\right)  }\right)   &  \in\mathbb{\mathcal{M}}\left(
p,q,\mathbb{C}\right) \\
\mathcal{R}_{e}\left(  A\right)   &  \in\mathbb{\mathcal{M}}\left(
r,r,\mathbb{C}\right) \\
\mathcal{R}_{e}\left(  A\left(  J_{r},K_{r}\right)  \right)   &
\in\mathbb{\mathcal{M}}\left(  r,r,\mathbb{C}\right)  .
\end{align}

\end{remark}

\begin{lemma}
$\left(  p,q\right)  $ submatrices $A\left(  J_{\sigma\left(  p\right)
},K_{\mu\left(  q\right)  }\right)  $ of $A$ are representations of $\left(
p,q\right)  $-restricted operators i.e.
\begin{equation}
\left[  \mathcal{R}_{e}\left(  A\right)  \right]  \left(  J_{\sigma\left(
p\right)  },K_{\mu\left(  q\right)  }\right)  =\mathcal{R}_{e}\left(  A\left(
J_{\sigma\left(  p\right)  },K_{\mu\left(  q\right)  }\right)  \right)
=\mathcal{R}_{e}\left(  E\left(  J_{\sigma\left(  p\right)  }\right)
AE\left(  K_{\mu\left(  q\right)  }\right)  \right)  .
\end{equation}

\end{lemma}

\begin{corollary}
Matrix elements of representation matrices are representations of $\left(
1,1\right)  $-restricted operators i.e.
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  \left(  J_{\sigma\left(  1\right)  }%
,K_{\mu\left(  1\right)  }\right)  \leftrightarrow\mathcal{R}_{e}\left(
A\left(  J_{\sigma\left(  1\right)  },K_{\mu\left(  1\right)  }\right)
\right)  =\mathcal{R}_{e}\left(  E\left(  J_{\sigma\left(  1\right)  }\right)
AE\left(  K_{\mu\left(  1\right)  }\right)  \right)  =\mathcal{R}_{e}\left(
A\right)  _{j_{\sigma\left(  1\right)  }k_{\mu\left(  1\right)  }}.
\end{equation}

\end{corollary}

\begin{definition}
Let $\mathfrak{S}_{r}$ denote a set of $r$ vectors i.e.
\begin{equation}
\mathfrak{S}_{r}=\left\{  x_{1},\cdots,x_{r}\right\}  \in\mathcal{P}\left(
V\right)  .
\end{equation}
and $\sigma\in S_{r}$ then
\end{definition}

\begin{remark}
\begin{enumerate}
\item the action of the permutations $\sigma$ on the set of vectors
$\mathfrak{S}_{r},$ $\sigma:\mathfrak{S}_{r}\rightarrow\mathfrak{S}%
_{\sigma\left(  r\right)  }=\left\{  x_{\sigma\left(  1\right)  }%
,\cdots,x_{\sigma\left(  r\right)  }\right\}  $

producing

\item subsets $\mathfrak{S}_{\sigma\left(  p\right)  }$ of vectors
\begin{equation}
\mathfrak{S}_{\sigma\left(  p\right)  }=\left\{  x_{\sigma\left(  1\right)
},\cdots,x_{\sigma\left(  p\right)  }\right\}
\end{equation}
and

\item the operators $X_{e\sigma\left(  p\right)  }\in\mathcal{L}\left(
V\right)  $%
\begin{equation}
X_{e\sigma\left(  p\right)  }=\mathfrak{V}_{e}\left(  \mathfrak{S}%
_{\sigma\left(  p\right)  }\right)
\end{equation}
and

\item the representations
\begin{equation}
\mathbb{X}_{e\sigma\left(  p\right)  }=\mathcal{R}_{e}\left(  X_{e\sigma
\left(  p\right)  }\right)  .
\end{equation}


\item The operator $X_{e\sigma\left(  p\right)  }$ based on the vectors
$\left\{  x_{\kappa}\left\vert \kappa\in K_{\sigma\left(  p\right)  }\right.
\right\}  $is defined as
\begin{equation}
X_{e\sigma\left(  p\right)  }=\mathfrak{V}_{e}\left(  \mathfrak{S}%
_{\sigma\left(  p\right)  }\right)  =\sum_{\kappa\in K_{\sigma\left(
p\right)  }}\sum_{1\leq j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(  x_{\kappa
}\right)  _{j}\in\mathcal{L}\left(  V\right)  ,
\end{equation}
where the $\mathcal{R}_{e}$ representation of the vectors $\left\{  x_{k}\in
V,\quad1\leq k\leq r\right\}  $ is given by

\item
\begin{equation}
x_{k}\left(  \mathbf{e}\right)  =\left(  \mathbf{e}\right)  \mathcal{R}%
_{\wedge^{1}e}\left(  x_{k}\right)  =\left(  \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  x_{k}\right)  ,\quad1\leq k\leq r,
\end{equation}
where

\item
\begin{equation}
\mathcal{R}_{\wedge^{1}e}\left(  x_{k}\right)  _{j_{k}}=\left\langle e_{j_{k}%
}^{d},x_{k}\right\rangle =\frac{1}{1!}\det\left(  \overset{}{\mathbb{X}%
_{er}\left(  \left\{  j_{k}\right\}  ,\left\{  k\right\}  \right)  }\right)  ,
\end{equation}
and the matrix

\item $\mathcal{M}_{e}\left(  X_{r}\right)  \equiv\mathbb{X}_{er}%
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ is defined by
\begin{equation}
\mathfrak{V}_{e}\left(  \mathcal{R}_{e}\left(  X_{r}\right)  \right)
=\mathcal{R}_{e}\left(  \mathfrak{V}_{e}\left(  \mathfrak{S}_{\sigma\left(
r\right)  }\right)  \right)  =\mathbb{X}_{er}=\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{1}\right)  _{r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{r}\right)  _{r}%
\end{array}
\right)
\end{array}
\right)  ,
\end{equation}
where

\item the set $\mathcal{R}_{e}\left(  \mathfrak{S}_{\sigma\left(  r\right)
}\right)  $ of vectors is
\begin{equation}
\mathcal{R}_{e}\left(  \mathfrak{S}_{\sigma\left(  r\right)  }\right)
=\left\{  \mathcal{R}_{e}\left(  x_{1}\right)  ,\cdots,\mathcal{R}_{e}\left(
x_{r}\right)  \right\}
\end{equation}
and

\item
\begin{equation}
X_{e\sigma\left(  p\right)  }=\sum_{\kappa\in K_{\sigma\left(  p\right)  }%
}\sum_{1\leq j\leq r}E_{j\kappa}\mathcal{R}_{e}\left(  x_{\kappa}\right)
_{j}.
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  X_{e\sigma\left(  2\right)  }\right)  =\mathbb{X}%
_{e\sigma\left(  2\right)  }=\left(
\begin{array}
[c]{cc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{\sigma\left(  1\right)  }\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{\sigma\left(  1\right)  }\right)  _{r}%
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{\sigma\left(  2\right)  }\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{\sigma\left(  2\right)  }\right)  _{r}%
\end{array}
\right)
\end{array}
\right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  X_{e\sigma\left(  n\right)  }\right)  =\mathbb{X}%
_{e\sigma\left(  n\right)  }=\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{\sigma\left(  1\right)  }\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{\sigma\left(  1\right)  }\right)  _{r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{\sigma\left(  n\right)  }\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{\sigma\left(  n\right)  }\right)  _{r}%
\end{array}
\right)
\end{array}
\right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  X_{er}\right)  =\mathbb{X}_{er}=\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{1}\right)  _{r}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{r}\right)  _{r}%
\end{array}
\right)
\end{array}
\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
The $\mathcal{R}_{\otimes^{2}e}$ representation of the elementary operators
$E_{j_{1}j_{2}}$
\begin{equation}
E_{j_{1}j_{2}}\left(  \mathbf{e}\right)  =\left(  \mathbf{e}\right)
\mathcal{R}_{e}\left(  E_{j_{1}j_{2}}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  E_{j_{1}j_{2}}\right)  =\mathcal{M}_{\left(  e\right)
}\left(  E_{j_{1}j_{2}}\right)  =\left\langle \left(  \mathbf{e}^{d}\right)
,E_{j_{1}j_{2}}\left(  \mathbf{e}\right)  \right\rangle ,
\end{equation}
hence
\begin{equation}
\left[  e_{k_{1}}^{d}\right]  \left(  E_{j_{1}j_{2}}\left(  e_{k_{2}}\right)
\right)  =\left\langle e_{k_{1}}^{d},E_{j_{1}j_{2}}\left(  e_{k_{2}}\right)
\right\rangle =\mathcal{R}_{e}\left(  E_{j_{1}j_{2}}\right)  _{k_{1}k_{2}%
}=\mathcal{M}_{\left(  e\right)  }\left(  E_{j_{1}j_{2}}\right)  _{k_{1}k_{2}%
}=\delta_{k_{1}j_{1}}\delta_{j_{2}k_{2}}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left[  x_{1}\otimes x_{2}\right]  \left(  \otimes^{2}\mathbf{e}\right)
=\left[  \otimes^{2}\mathbf{e}\right]  \mathcal{R}_{\otimes^{2}e}\left(
x_{1}\otimes x_{2}\right)  =\left[  \otimes^{2}\mathbf{e}\right]
\mathcal{R}_{e}\left(  x_{1}\right)  \otimes\mathcal{R}_{e}\left(
x_{2}\right)
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{\otimes^{2}e}\left(  x_{1}\otimes x_{2}\right)  _{j_{1}j_{2}%
}=\mathcal{R}_{e}\left(  x_{1}\right)  _{j_{1}}\otimes\mathcal{R}_{e}\left(
x_{2}\right)  _{j_{2}}.
\end{equation}

\end{remark}

\begin{remark}
The $\mathcal{R}_{\wedge^{2}e}$ representation of the exterior product vector
$x_{1}\wedge x_{2}$ is given by
\begin{align}
\mathcal{R}_{\wedge^{2}e}\left(  x_{1}\wedge x_{2}\right)  _{j_{1}j_{2}}  &
=\left\langle e_{j_{1}}^{d}\wedge e_{j_{2}}^{d},x_{1}\wedge x_{2}\right\rangle
=\frac{1}{2!}\det\left(  \mathbb{X}\left(  \overset{}{\left\{  j_{1}%
,j_{2}\right\}  ,\left\{  1,2\right\}  },\right)  \right)  =\frac{1}%
{4}\left\langle \left(  e_{j_{1}}^{d}\otimes e_{j_{2}}^{d}-e_{j_{2}}%
^{d}\otimes e_{j_{1}}^{d}\right)  ,\left(  x_{1}\otimes x_{2}-x_{2}\otimes
x_{1}\right)  \right\rangle \\
&  =\frac{1}{4}\left(  \left\langle e_{j_{1}}^{d}\otimes e_{j_{2}}^{d}%
,x_{1}\otimes x_{2}\right\rangle -\left\langle e_{j_{1}}^{d}\otimes e_{j_{2}%
}^{d},x_{2}\otimes x_{1}\right\rangle -\left\langle e_{j_{2}}^{d}\otimes
e_{j_{1}}^{d},x_{1}\otimes x_{2}\right\rangle +\left\langle e_{j_{2}}%
^{d}\otimes e_{j_{1}}^{d},x_{2}\otimes x_{1}\right\rangle \right) \\
&  =\frac{1}{4}\left(  \mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{1}\otimes
x_{2}\right)  \right)  _{j_{1}j_{2}}-\mathcal{R}_{\otimes^{2}e}\left(  \left(
x_{2}\otimes x_{1}\right)  \right)  _{j_{1}j_{2}}+\left(  \mathcal{R}%
_{\otimes^{2}e}\left(  \left(  x_{1}\otimes x_{2}\right)  \right)
_{j_{2}j_{1}}-\mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{2}\otimes
x_{1}\right)  \right)  _{j_{2}j_{1}}\right)  \right) \\
&  =\frac{1}{4}\left(  \mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{1}\wedge
x_{2}\right)  \right)  _{j_{1}j_{2}}-\mathcal{R}_{\otimes^{2}e}\left(  \left(
x_{1}\wedge x_{2}\right)  \right)  _{j_{2}j_{1}}\right)  =\frac{1}%
{2}\mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{1}\wedge x_{2}\right)
\right)  _{j_{1}j_{2}}=\mathcal{R}_{\wedge^{2}e}\left(  \left(  x_{1}\wedge
x_{2}\right)  \right)  _{j_{1}j_{2}},
\end{align}
where%
\begin{align}
\mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{1}\wedge x_{2}\right)  \right)
_{j_{1}j_{2}}  &  =\frac{1}{2}\left\langle e_{j_{1}}^{d}\otimes e_{j_{2}}%
^{d},\left(  x_{1}\otimes x_{2}-x_{2}\otimes x_{1}\right)  \right\rangle \\
&  =\frac{1}{2}\left(  \mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{1}\otimes
x_{2}\right)  \right)  _{j_{1}j_{2}}-\mathcal{R}_{\otimes^{2}e}\left(  \left(
x_{2}\otimes x_{1}\right)  \right)  _{j_{1}j_{2}}\right)  =\frac{1}{2}\left(
\mathcal{R}_{e}\left(  x_{1}\right)  _{j_{1}}\otimes\mathcal{R}_{e}\left(
x_{2}\right)  _{j_{2}}-\mathcal{R}_{e}\left(  x_{2}\right)  _{j_{1}}%
\otimes\mathcal{R}_{e}\left(  x_{1}\right)  _{j_{2}}\right)  .
\end{align}

\end{remark}

\begin{remark}
The $\mathcal{R}_{\otimes^{2}e}$ representation of the exterior product vector
$x_{1}\wedge x_{2}$ is given by
\begin{equation}
\mathcal{R}_{\otimes^{2}e}\left(  \left(  x_{1}\wedge x_{2}\right)  \right)
_{j_{1}j_{2}}=\frac{1}{2}\left(  \mathcal{R}_{e}\left(  x_{1}\right)  _{j_{1}%
}\otimes\mathcal{R}_{e}\left(  x_{2}\right)  _{j_{2}}-\mathcal{R}_{e}\left(
x_{2}\right)  _{j_{1}}\otimes\mathcal{R}_{e}\left(  x_{1}\right)  _{j_{2}%
}\right)  =\frac{1}{2}\det\left(  \mathbb{X}_{2}\left(  \left\{  j_{1}%
,j_{2}\right\}  ,\left\{  1,2\right\}  \right)  \right)  .
\end{equation}

\end{remark}

\begin{remark}
The $\mathcal{R}_{\wedge^{n}e}$ representation of the exterior product vector
$x_{1}\wedge\cdots\wedge x_{n}$ is given by
\begin{align}
\mathcal{R}_{\wedge^{n}e}\left(  x_{1}\wedge\cdots\wedge x_{n}\right)
_{j_{1}\cdots j_{n}}  &  =\left\langle e_{j_{1}}^{d}\wedge\cdots\wedge
e_{j_{n}}^{d},x_{1}\wedge\cdots\wedge x_{n}\right\rangle =\frac{1}{n!}%
\det\left(  \mathbb{X}_{n}\left(  \left\{  j_{1},\cdots,j_{n}\right\}
,\overset{}{\left\{  1,\cdots,n\right\}  ,}\right)  \right) \\
&  =\frac{1}{n!}\det\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{1}\right)  _{j_{1}}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{1}\right)  _{j_{n}}%
\end{array}
\right)  & \cdots & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  x_{n}\right)  _{j_{1}}\\
\vdots\\
\mathcal{R}_{e}\left(  x_{n}\right)  _{j_{n}}%
\end{array}
\right)
\end{array}
\right) \\
&  =\frac{1}{n!}\left(  \overset{}{\mathcal{R}_{e}\left(  P_{j_{1}\cdots
j_{n}}\left(  x_{1}\right)  \right)  \wedge\cdots\wedge\mathcal{R}_{e}\left(
P_{j_{1}\cdots j_{n}}\left(  x_{n}\right)  \right)  }\right)  ,
\end{align}
where
\begin{equation}
\mathcal{R}_{e}\left(  P_{j_{1}\cdots j_{n}}\left(  x_{1}\right)  \right)
_{k}=0\text{ if }k\notin\left\{  j_{1},\cdots,j_{n}\right\}
\end{equation}
and the idempotents $\equiv$ projectors $P_{j_{1}\cdots j_{n}}$ are defined
as
\begin{equation}
P_{j_{1}\cdots j_{n}}=E_{j_{1}\cdots j_{n}j_{1}\cdots j_{n}}.
\end{equation}

\end{remark}

\begin{example}%
\begin{align}
\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\left\langle \left.  e_{1}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{1}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{1}\right\vert v_{3}\right\rangle \\
\left\langle \left.  e_{2}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{2}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{2}\right\vert v_{2}\right\rangle \\
\left\langle \left.  e_{3}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{3}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{3}\right\vert v_{3}\right\rangle
\end{array}
\right)   &  =\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  e_{1}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{1}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{1}\right\vert v_{3}\right\rangle \\
\left\langle \left.  e_{2}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{2}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{2}\right\vert v_{2}\right\rangle \\
0 & 0 & 0
\end{array}
\right) \\
\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  e_{1}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{1}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{1}\right\vert v_{3}\right\rangle \\
\left\langle \left.  e_{2}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{2}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{2}\right\vert v_{2}\right\rangle \\
\left\langle \left.  e_{3}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{3}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{3}\right\vert v_{3}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  e_{1}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{1}\right\vert v_{2}\right\rangle  & 0\\
\left\langle \left.  e_{2}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{2}\right\vert v_{2}\right\rangle  & 0\\
\left\langle \left.  e_{3}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{3}\right\vert v_{2}\right\rangle  & 0
\end{array}
\right) \\
\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  e_{1}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{1}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{1}\right\vert v_{3}\right\rangle \\
\left\langle \left.  e_{2}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{2}\right\vert v_{2}\right\rangle  & \left\langle \left.
e_{2}\right\vert v_{2}\right\rangle \\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  e_{1}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{1}\right\vert v_{2}\right\rangle  & 0\\
\left\langle \left.  e_{2}\right\vert v_{1}\right\rangle  & \left\langle
\left.  e_{2}\right\vert v_{2}\right\rangle  & 0\\
0 & 0 & 0
\end{array}
\right)
\end{align}

\end{example}

\begin{remark}%
\begin{align}
&  x_{1}\wedge\cdots\wedge x_{n}=\frac{1}{n!}\sum_{\sigma\in S_{n}}\left(
-1\right)  ^{\pi\left(  \sigma\right)  }x_{\sigma\left(  1\right)  }%
\otimes\cdots\otimes x_{\sigma\left(  n\right)  }=\frac{1}{n!}\sum_{\sigma\in
S_{n}}\left(  -1\right)  ^{\pi\left(  \sigma\right)  }\left(  \sum_{1\leq
j_{1}\leq r}e_{j_{1}}x_{\sigma\left(  1\right)  j_{1}}\right)  \otimes
\cdots\otimes\left(  \sum_{1\leq j_{n}\leq r}e_{j_{n}}x_{\sigma\left(
n\right)  j_{n}}\right) \\
&  =\frac{1}{n!}\sum_{\sigma\in S_{n}}\left(  -1\right)  ^{\pi\left(
\sigma\right)  }\sum_{1\leq j_{1},\cdots,,j_{n}\leq r}\left(  e_{j_{1}}%
\otimes\cdots\otimes e_{j_{n}}\right)  \mathcal{R}_{e}\left(  x_{\sigma\left(
1\right)  }\right)  _{j_{1}}\cdots\mathcal{R}_{e}\left(  x_{\sigma\left(
n\right)  }\right)  _{j_{n}}\\
&  =\sum_{1\leq j_{1},\cdots,,j_{n}\leq r}\left(  e_{j_{1}}\otimes
\cdots\otimes e_{j_{n}}\right)  \frac{1}{n!}\sum_{\sigma\in S_{n}}\left(
-1\right)  ^{\pi\left(  \sigma\right)  }\mathcal{R}_{e}\left(  x_{\sigma
\left(  1\right)  }\right)  _{j_{1}}\cdots\mathcal{R}_{e}\left(
x_{\sigma\left(  n\right)  }\right)  _{j_{n}}\\
&  =\sum_{1\leq j_{1},\cdots,,j_{n}\leq r}\left(  e_{j_{1}}\otimes
\cdots\otimes e_{j_{n}}\right)  \frac{1}{n!}\det\left(  \mathbb{X}_{n}\left(
\left\{  j_{1},\cdots,j_{n}\right\}  ,\left\{  1,\cdots,n\right\}  \right)
\right)  .
\end{align}

\end{remark}

\subsection{Geminals}

Geminals $g$ are elements of the Hilbert space $\bigwedge\nolimits^{2}%
\mathcal{H}^{1}$ and their overlaps with arbitary decomposable elements
$x_{1}\wedge x_{2}$ of elements of $\bigwedge\nolimits^{2}\mathcal{H}^{1}$
form \emph{bilinear} antisymmetric $\equiv$ skew symmetric functionals
$\mathfrak{g}\in\mathcal{AL}\left(  \mathcal{H}^{1}\right)  \subset
\mathcal{BL}\left(  \mathcal{H}^{1}\right)  \cong\bigwedge\nolimits^{2}%
\mathcal{H}^{d1}$
\begin{equation}
\mathfrak{g}:\mathcal{H}^{1}\times\mathcal{H}^{1}\rightarrow\mathbb{C}%
\end{equation}
defined by

\begin{definition}%
\begin{align}
\mathfrak{g}\left(  x_{1},x_{2}\right)   &  =\left\langle \left.  g\right\vert
x_{1}\wedge x_{2}\right\rangle =\left\langle \left.  \overset{\overset{}{}%
}{g}\right\vert \sum_{1\leq j_{1}\leq r}\left\vert e_{j_{1}}\right\rangle
x_{1j_{1}}\wedge\sum_{1\leq j_{2}\leq r}\left\vert e_{j_{2}}\right\rangle
x_{2j_{2}}\right\rangle =\sum_{1\leq j_{1}\leq r}\sum_{1\leq j_{2}\leq
r}\left\langle \left.  \overset{\overset{}{}}{g}\right\vert \left\vert
e_{j_{1}}\right\rangle \wedge\left\vert e_{j_{2}}\right\rangle \right\rangle
x_{1j_{1}}x_{2j_{2}}\\
&  =\sum_{1\leq j_{1},j_{2}\leq r}\left\langle \left.  \overset{\overset{}{}%
}{g}\right\vert e_{j_{1}}\wedge e_{j_{2}}\right\rangle x_{1j_{1}}x_{2j_{2}%
}=\sum_{1\leq j_{1}<j_{2}\leq r}\left\langle \left.  \overset{\overset{}{}%
}{g}\right\vert e_{j_{1}}\wedge e_{j_{2}}\right\rangle \left(  x_{1j_{1}%
}x_{2j_{2}}-x_{1j_{2}}x_{2j_{1}}\right)  =-\mathfrak{g}\left(  x_{2}%
,x_{1}\right)  .
\end{align}
The geminal $\left\vert g^{d}\right\rangle $ can be expanded in terms of any
conb $\left\vert \mathbf{e}^{d}\mathbf{e}^{d}\right\rangle \equiv
{\Large \wedge}^{2}\mathbf{e}^{d}$ of $\bigwedge\nolimits^{2}\mathcal{H}^{d1}$
as
\begin{align}
\left\vert g^{d}\right\rangle  &  =\left\langle g\right\vert =\digamma
_{\left\vert e\right\rangle }\left(  \left\vert g\right\rangle \right)
=\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}^{d}\wedge e_{j_{2}}%
^{d}\right)  \mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\sum_{1\leq
j_{1}<j_{2}\leq r}\sqrt{2}\left\vert e_{j_{1}}e_{j_{2}}\right\rangle
\mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}\leq r}\sqrt{2}\left\vert e_{j_{1}}e_{j_{2}%
}\right\rangle \left\langle \left.  \overset{\overset{}{}}{g}\right\vert
e_{j_{1}}\wedge e_{j_{2}}\right\rangle =\sum_{1\leq j_{1}<j_{2}\leq r}\sqrt
{2}\left\vert e_{j_{1}}e_{j_{2}}\right\rangle \mathcal{R}_{\wedge^{2}e}\left(
g\right)  _{j_{1}j_{2}},
\end{align}
where $\left\vert \mathbf{e}\right\rangle $ is a conb of $V.$
\end{definition}

\begin{remark}%
\begin{equation}
g=\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)
\left[  \left(  e_{j_{1}}^{d}\wedge e_{j_{2}}^{d}\right)  \right]  \left(
g\right)
\end{equation}
and
\begin{equation}
\mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\left[  \left(  e_{j_{1}}%
^{d}\wedge e_{j_{2}}^{d}\right)  \right]  \left(  g\right)  .
\end{equation}

\end{remark}

\begin{remark}
In general for $g$ $\in\bigwedge\nolimits^{2}V,$ one has
\begin{gather}
g=\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)
\mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\sum_{1\leq j_{1}<j_{2}\leq
r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)  \left[  e_{j_{1}}^{d}\wedge
e_{j_{2}}^{d}\right]  \left(  g\right)  =\sum_{1\leq j_{1}<j_{2}\leq r}\left(
e_{j_{1}}\wedge e_{j_{2}}\right)  \left[  \overset{}{\digamma_{\left\vert
e\right\rangle }\left(  g\right)  }\right]  \left(  \overset{}{e_{j_{1}}\wedge
e_{j_{2}}}\right)  g\\
=\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)
\left\langle \left.  \overset{\overset{}{}}{g}\right\vert e_{j_{1}}\wedge
e_{j_{2}}\right\rangle =\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge
e_{j_{2}}\right)  \mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{j_{1}j_{2}}.
\end{gather}
and the values of $\mathfrak{g}$ are formed by the overlaps of $g$ with
decomposable elements of $\bigwedge\nolimits^{2}V$.
\end{remark}

\begin{notation}
$g,\left\vert g\right)  ,\left\vert g\right\rangle $ denotes elements of
$\bigwedge\nolimits^{2}\mathcal{H}^{1}.$
\end{notation}

\begin{remark}
If $V$ is a Hilbert space i.e. $V=\mathcal{H}^{1}$ then%
\begin{equation}
g=\left\vert g\right\rangle =\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}%
}\wedge e_{j_{2}}\right)  \mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)
=\sum_{1\leq j_{1}<j_{2}\leq r}\sqrt{2}\left\vert e_{j_{1}}e_{j_{2}%
}\right\rangle \mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\sum_{1\leq
j_{1}<j_{2}\leq r}\sqrt{2}\left\vert e_{j_{1}}e_{j_{2}}\right\rangle
\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{j_{1}j_{2}},
\end{equation}
and $\mathfrak{g}$ denotes the skew symmetric $\equiv$ antisymmetric
multilinear functionals
\begin{gather}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle \left.  x_{1}\wedge
x_{2}\right\vert g\right\rangle =\left\langle \left.  \overset{\overset{}{}%
}{x_{1}\wedge x_{2}}\right\vert \sum_{1\leq j<k\leq r}e_{j}\wedge
e_{k}\mathcal{R}_{e}\left(  g\right)  \right\rangle =\left\langle \left.
\overset{\overset{}{}}{x_{1}\wedge x_{2}}\right\vert \sum_{1\leq j<k\leq
r}\left\vert e_{j}e_{k}\right\rangle \mathcal{R}_{\wedge^{2}\left\vert
e\right\rangle }\left(  g\right)  _{jk}\right\rangle \\
=\sum_{1\leq j<k\leq r}\overline{\mathcal{R}_{\wedge^{2}\left\vert
e\right\rangle }\left(  x_{1}\wedge x_{2}\right)  }_{jk}\mathcal{R}%
_{\wedge^{2}\left\vert e\right\rangle }\left(  g\right)  _{jk},
\end{gather}
formed by the overlaps of $g$ with decomposable elements of $\bigwedge
\nolimits^{2}\mathcal{H}^{1}$ i.e. where
\begin{equation}
\mathfrak{g}:\mathcal{H}^{1}\times\mathcal{H}^{1}\rightarrow\mathbb{C}.
\end{equation}

\end{remark}

\begin{definition}
Each \emph{non degenerate} geminal $g$ defines a \emph{non degenerate
Symplectic bilinear} form $\left\{  \left.  {}\right\vert \right\}  _{g}$%
\begin{equation}
\left\{  \left.  {}\right\vert \right\}  _{g}:\mathcal{H}^{1}\times
\mathcal{H}^{1}\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\left\{  \left.  {}\right\vert \right\}  _{g}=\mathfrak{g}\left(  x_{1}%
,x_{2}\right)  .
\end{equation}
As $g$ is nondegenerate $\left\{  \left.  {}\right\vert \right\}  _{g}$ is
nondegenerate, though it is \emph{totally isotropic}.
\end{definition}

\begin{remark}
All \emph{symplectic bilinear} forms defined in $\mathcal{H}^{1}$ are
generated by $g\in\bigwedge\nolimits^{2}\mathcal{H}^{1}.$
\end{remark}

\begin{definition}
The standard non degenerate complex symmetric bilinear form defined in $V$ is
\emph{denoted by} $\left(  \left.  {}\right\vert \right)  $ i.e.
\begin{equation}
\left(  \left.  {}\right\vert \right)  :V\times V\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\left(  \left.  x_{1}\right\vert x_{2}\right)  =\left(  \left.  x_{2}%
\right\vert x_{1}\right)  .
\end{equation}
One can define a \emph{transpose} $"t"$ operation wrt $\left(  \left.
{}\right\vert \right)  $ as
\begin{equation}
t:\mathcal{L}\left(  V\right)  \rightarrow\mathcal{L}\left(  V\right)  ,
\end{equation}
where $\mathcal{L}\left(  V\right)  $ is the set of linear endomorphisms
acting in $V$ by
\begin{equation}
\left(  \left.  B^{t}x_{1}\right\vert x_{2}\right)  =\left(  \left.
x_{1}\right\vert Bx_{2}\right)  \quad\forall x_{2}\in V,\,x_{1}\in V.
\end{equation}

\end{definition}

\begin{definition}
$B\in\mathcal{L}\left(  V\right)  $ is complex symmetric if
\begin{equation}
B=B^{t}.
\end{equation}

\end{definition}

\begin{remark}
The set of symmetric transformations generates a complex linear space%
\begin{equation}
\mathcal{L}_{sym}\left(  V\right)  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  B=B^{t}\right\vert B\in\mathcal{L}\left(  V\right)  \right\}
.
\end{equation}

\end{remark}

\begin{definition}
$B$ is complex \emph{antisymmetric }$\equiv$ \emph{skew symmetric }if
\begin{equation}
B=-B^{t}.
\end{equation}

\end{definition}

\begin{remark}
The set of antsymmetric transformations generates a complex linear space%
\begin{equation}
\mathcal{L}_{anti}\left(  V\right)  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  B=-B^{t}\right\vert B\in\mathcal{L}\left(  V\right)
\right\}  .
\end{equation}

\end{remark}

\begin{theorem}
If $r=2s$ the complex vector spaces $\mathcal{L}_{anti}\left(  V\right)  $ and
$\bigwedge\nolimits^{2}V$ are isomorphic i.e.
\begin{equation}
\mathcal{L}_{anti}\left(  V\right)  \cong\bigwedge\nolimits^{2}V,
\end{equation}
where the isomorphism
\begin{equation}
\Xi_{VV}:\bigwedge\nolimits^{2}V\rightarrow\mathcal{L}_{anti}\left(  V\right)
\end{equation}
is defined by
\begin{equation}
\left(  \left.  v\right\vert \Xi_{VV}\left(  g\right)  w\right)  =\left(
\left.  v\right\vert Gw\right)  =\left(  \left.  v\right\vert w\right)
_{g}=\mathfrak{g}\left(  v,w\right)  =\left(  \left.  v\wedge w\right\vert
g\right)  ,\quad\forall v,w\in V.
\end{equation}
.
\end{theorem}

\begin{remark}%
\begin{equation}
G=\Xi_{VV}\left(  g\right)  \text{ and }G=-G^{t}.
\end{equation}

\end{remark}

\begin{theorem}
The complex vector spaces $\mathcal{L}_{sym}\left(  V\right)  $ and
$\bigvee\nolimits^{2}V$ are isomorphic i.e.
\begin{equation}
\mathcal{L}_{sym}\left(  V\right)  \cong\bigvee\nolimits^{2}V,
\end{equation}
where the isomorphism
\begin{equation}
\Xi_{VV}:\bigvee\nolimits^{2}V\rightarrow\mathcal{L}_{sym}\left(  V\right)
\end{equation}
is defined by
\begin{equation}
\left(  \left.  v\right\vert \Xi_{VV}\left(  g\right)  w\right)  =\left(
\left.  v\right\vert Sw\right)  =\left(  \left.  v\right\vert w\right)
_{s}=\mathfrak{s}\left(  v,w\right)  =\left(  \left.  v\vee w\right\vert
s\right)  ,\quad\forall v,w\in V.
\end{equation}

\end{theorem}

\begin{remark}
For a general vector space $V$ one has
\begin{equation}
\mathfrak{g}:V\times V\rightarrow\mathbb{C},
\end{equation}
where $\mathfrak{g}$ is given by
\begin{equation}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left[  \digamma_{e}\left(  g\right)
\right]  \left(  x_{1}\wedge x_{2}\right)
\end{equation}
for $g\in\bigwedge\nolimits^{2}V$ that can be expanded as
\begin{equation}
g=\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)
\mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\frac{1}{2}\sum_{1\leq
j_{1},j_{2}\leq r}\left(  e_{j_{1}}\otimes e_{j_{2}}-e_{j_{2}}\otimes
e_{j_{1}}\right)  \mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\frac{1}%
{2}\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\otimes e_{j_{2}}-e_{j_{2}%
}\otimes e_{j_{1}}\right)  \mathcal{R}_{\wedge^{2}e}\left(  g\right)
_{j_{1}j_{2}}.
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item Representation of geminals%
\begin{equation}
g=\left(  \mathbf{e}\wedge\mathbf{e}\right)  \mathcal{R}_{e_{2}}\left(
g\right)  .
\end{equation}


\item The duality injection
\begin{equation}
g^{d}=\left(  \digamma_{e}\boxtimes\digamma_{e}\right)  \left(  g\right)  .
\end{equation}


\item Representation of dual geminals
\begin{equation}
g^{d}=\left(  \mathbf{e}^{d}\wedge\mathbf{e}^{d}\right)  \mathcal{R}%
_{e_{2}^{d}}\left(  g\right)  .
\end{equation}


\item Representation of vectors
\begin{equation}
x=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  x\right)  _{j}=\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  x\right)
\end{equation}


\item The duality injection
\begin{equation}
x^{d}=\digamma_{e}\left(  x\right)  .
\end{equation}


\item Representation of dual vectors
\begin{equation}
x^{d}=\sum_{1\leq j\leq r}e_{j}^{d}\mathcal{R}_{e}\left(  x^{d}\right)
_{j}=\left(  \mathbf{e}^{d}\right)  \mathcal{R}_{e}\left(  x^{d}\right)
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
The injection
\begin{equation}
\digamma_{e}:V\rightarrow V^{d}%
\end{equation}
is given by
\begin{equation}
x^{d}=\digamma_{e}\left(  x\right)
\end{equation}
where
\begin{equation}
x=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  x\right)  _{j}=\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  x\right)
\end{equation}
and
\begin{equation}
x^{d}=\digamma_{e}\left(  x\right)  =\sum_{1\leq j\leq r}e_{j}^{d}%
\mathcal{R}_{e}\left(  x\right)  _{j}=\left(  \mathbf{e}^{d}\right)
\mathcal{R}_{e}\left(  x\right)
\end{equation}
i.e the injection is defined by
\begin{equation}
\mathcal{R}_{e}\left(  x\right)  =\mathcal{R}_{e^{d}}\left(  x\right)  .
\end{equation}

\end{remark}

\begin{remark}
Using the injection $\digamma_{e}$ induced by of $V$ into $V^{d}$ one obtains
the induced map $\digamma_{e}\otimes\digamma_{e}$
\begin{equation}
\digamma_{e}\otimes\digamma_{e}:V\otimes V\rightarrow V^{d}\otimes V^{d},
\end{equation}
and%
\begin{equation}
\digamma_{e}\boxtimes\digamma_{e}:\bigwedge\nolimits^{2}V\rightarrow
\bigwedge\nolimits^{2}V,
\end{equation}
where%
\begin{equation}
\digamma_{e}\boxtimes\digamma_{e}=\mathcal{A}_{2}\left(  \digamma_{e}%
\otimes\digamma_{e}\right)  \mathcal{A}_{2}.
\end{equation}

\end{remark}

\begin{remark}
Antisymmetric bilinear functionals%
\begin{equation}
\mathfrak{g}:V\times V\rightarrow\mathbb{C}%
\end{equation}
are given by%
\begin{equation}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left[  \left(  \otimes^{2}%
\digamma_{e}\left(  g\right)  \right)  \right]  \left(  x_{1}\otimes
x_{2}\right)  =\left[  \left(  \boxtimes^{2}\digamma_{e}\left(  g\right)
\right)  \right]  \left(  x_{1}\wedge x_{2}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The values of $\mathfrak{g}$ can be expressed as
\begin{gather}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle \,\left[  \left(
\boxtimes^{2}\digamma_{e}\right)  \left(  g\right)  \right]  ,x_{1}\wedge
x_{2}\right\rangle =\left\langle \sum_{1\leq j<k\leq r}\left(  e_{j}^{d}\wedge
e_{k}^{d}\right)  \left(  \overset{}{\mathcal{R}_{e^{d}\wedge e^{d}}\left(
\left(  \boxtimes^{2}\digamma_{e}\right)  \left(  g\right)  \right)  }\right)
_{jk},x_{1}\wedge x_{2}\right\rangle \\
=\left\langle \sum_{1\leq j<k\leq r}\left(  e_{j}^{d}\wedge e_{k}^{d}\right)
\left(  \overset{}{\mathcal{R}_{e^{d}\wedge e^{d}}\left(  \left(
\boxtimes^{2}\digamma_{e}\right)  \left(  g\right)  \right)  }\right)
_{jk},\sum_{1\leq l<m\leq r}\left(  e_{j}\wedge e_{k}\right)  \left(
\overset{}{\mathcal{R}_{e\wedge e}\left(  x_{1}\wedge x_{2}\right)  }\right)
_{lm}\right\rangle \\
=\sum_{1\leq j<k\leq r}\sum_{1\leq l<m\leq r}\left\langle \left(  e_{j}%
^{d}\wedge e_{k}^{d}\right)  ,\overset{}{\left(  e_{j}\wedge e_{k}\right)
}\right\rangle \left(  \overset{}{\mathcal{R}_{e^{d}\wedge e^{d}}\left(
\left(  \boxtimes^{2}\digamma_{e}\right)  \left(  g\right)  \right)  }\right)
_{jk}\left(  \overset{}{\mathcal{R}_{e\wedge e}\left(  x_{1}\wedge
x_{2}\right)  }\right)  _{lm}\\
=\sum_{1\leq j<k\leq r}\sum_{1\leq l<m\leq r}\delta_{\left(  jk\right)
\left(  lm\right)  }\left(  \overset{}{\mathcal{R}_{e^{d}\wedge e^{d}}\left(
\left(  \boxtimes^{2}\digamma_{e}\right)  \left(  g\right)  \right)  }\right)
_{jk}\left(  \overset{}{\mathcal{R}_{e\wedge e}\left(  x_{1}\wedge
x_{2}\right)  }\right)  _{lm}=\sum_{1\leq j<k\leq r}\left(
\overset{}{\mathcal{R}_{e^{d}\wedge e^{d}}\left(  \left(  \boxtimes
^{2}\digamma_{e}\right)  \left(  g\right)  \right)  }\right)  _{jk}\left(
\overset{}{\mathcal{R}_{e\wedge e}\left(  x_{1}\wedge x_{2}\right)  }\right)
_{jk}%
\end{gather}

\end{remark}

\begin{definition}
The injection $\digamma_{\left\vert {}\right)  }$
\begin{equation}
\digamma_{\left\vert e\right)  }:V\rightarrow V^{d}%
\end{equation}
induced by the complex symmetric inner product $\left(  \left.  {}\right\vert
\right)  $ is defined by%
\begin{equation}
\digamma_{\left\vert e\right)  }\left(  v\right)  \left(  w\right)  =\left(
\left.  v\right\vert w\right)  \,=\left(  \left.  w\right\vert v\right)
\quad\forall w\in V.
\end{equation}

\end{definition}

\begin{notation}%
\begin{equation}
\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}^{b}\right\vert
\equiv\Xi_{VV}\left\{  \left(  \mathbf{e}\right)  \otimes\left(
\digamma_{\left\vert e\right\rangle }\left\{  \mathbf{e}\right\}  \right)
\right\}
\end{equation}

\end{notation}

\begin{notation}%
\begin{equation}
\left\vert \mathbf{e}\right)  \left(  \mathbf{e}^{b}\right\vert \equiv\Xi
_{VV}\left\{  \left(  \mathbf{e}\right)  \otimes\left(  \digamma_{\left\vert
e\right)  }\left\{  \mathbf{e}\right\}  \right)  \right\}
\end{equation}

\end{notation}

\begin{remark}
It self evident that $\digamma_{\left\vert e\right)  }$ is $\mathbb{C}$-linear.
\end{remark}

\begin{remark}
Using the injection $\digamma_{e}=\digamma_{\left\vert e\right)  }$ induced by
the complex symmetric bilinear inner product $\left(  \left.  {}\right\vert
\right)  $%
\begin{equation}
\digamma_{\left\vert e\right)  }\otimes\digamma_{\left\vert e\right)
}:V\otimes V\rightarrow V^{d}\otimes V^{d}%
\end{equation}
induced by
\begin{equation}
\digamma_{\left\vert e\right)  }:V\rightarrow V^{d}%
\end{equation}
one obtains
\begin{equation}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle \left[  \digamma
_{\left\vert e\right)  }\left(  g\right)  \right]  ,x_{1}\wedge x_{2}%
\right\rangle =\left(  \left.  g\right\vert x_{1}\wedge x_{2}\right)
\end{equation}
and the values of $\mathfrak{g}$ expressed as
\begin{gather}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle \digamma_{\left\vert
e\right)  }\left(  g\right)  ,\,\overset{}{x_{1}\wedge x_{2}}\right\rangle
=\left(  \left.  \overset{}{g}\right\vert x_{1}\wedge x_{2}\right)  =\left(
\left.  \sum_{1\leq j_{1}<j_{2}\leq r}e_{j}\wedge e_{k}\mathcal{R}_{\wedge
^{2}e}\left(  g\right)  _{j_{1}j_{2}}\right\vert \overset{}{\overset{}{x_{1}%
\wedge x_{2}}}\right) \\
=\left(  \left.  \sum_{1\leq j_{1}<j_{2}\leq r}e_{j}\wedge e_{k}%
\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{j_{1}j_{2}}\right\vert
\overset{}{\overset{}{x_{1}\wedge x_{2}}}\right)  =\sum_{1\leq j<k\leq
r}\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{jk}\mathcal{R}_{\wedge^{2}%
e}\left(  x_{1}\wedge x_{2}\right)  _{jk}%
\end{gather}
formed by the $\left(  \left.  {}\right\vert \right)  $-overlaps of $g$ with
decomposable elements of $\bigwedge\nolimits^{2}V$.
\end{remark}

\begin{definition}
The \emph{anti linear injection} $\digamma_{\left\vert {}\right\rangle }$%
\begin{equation}
\digamma_{\left\vert {}\right\rangle }:V\rightarrow V^{d}%
\end{equation}
by%
\begin{equation}
\digamma_{\left\vert {}\right\rangle }\left(  v\right)  \left(  w\right)
=\left\langle \left.  v\right\vert w\right\rangle \,\quad\forall w\in V.
\end{equation}

\end{definition}

\begin{remark}
Using the \emph{anti linear injection} $\digamma_{e}=\digamma_{\left\vert
{}\right)  }$ induced by the complex symmetric bilinear inner product $\left(
\left.  {}\right\vert \right)  $%
\begin{equation}
\otimes^{2}\digamma_{\left\vert {}\right)  }=\digamma_{\left\vert {}\right)
}\otimes\digamma_{\left\vert {}\right)  }:V\otimes V\rightarrow V^{d}\otimes
V^{d}%
\end{equation}
induced by
\begin{equation}
\digamma_{\left\vert {}\right)  }:V\rightarrow V^{d}.
\end{equation}

\end{remark}

\begin{definition}
of the antisymmetric bilinear form $\mathfrak{g\in\mathcal{AL}\left(
\mathcal{H}^{1}\right)  }\subset\mathcal{BL}\left(  \mathcal{H}^{1}\right)  $
\begin{equation}
\mathfrak{g:}\mathcal{H}^{1}\times\mathcal{H}^{1}\rightarrow\mathbb{C}%
\end{equation}
by
\begin{equation}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left[  \boxtimes^{2}\digamma
_{\left\vert {}\right\rangle }\left(  g\right)  \right]  \left(  x_{1}\wedge
x_{2}\right)  =\left(  \overset{}{\left(  \digamma_{\left\vert {}\right\rangle
}\boxtimes\digamma_{\left\vert {}\right\rangle }\right)  \left(  g\right)
}\right)  \left(  x_{1}\wedge x_{2}\right)  =g^{d}\left(  x_{1}\wedge
x_{2}\right)  =\left\langle \left.  g\right\vert x_{1}\wedge x_{2}%
\right\rangle .
\end{equation}

\end{definition}

\begin{remark}
For a Hilbert space $\mathcal{H}^{1}$ equipped with a sesquilinear form
$\left\langle \left.  {}\right\vert \right\rangle $ one has
\begin{align}
g  &  \equiv\left\vert g\right\rangle =\sum_{1\leq j_{1}<j_{2}\leq r}\left(
e_{j_{1}}\wedge e_{j_{2}}\right)  \mathcal{R}_{\wedge^{2}e}\left(  g\right)
_{j_{1}j_{2}}=\sum_{1\leq j_{1}<j_{2}\leq r}\left\vert e_{j_{1}}\wedge
e_{j_{2}}\right\rangle \mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{j_{1}%
j_{2}}=\sum_{1\leq j_{1}<j_{2}\leq r}\left\vert e_{j_{1}}\wedge e_{j_{2}%
}\right\rangle \left\langle \left.  e_{j_{1}}^{b}\wedge e_{j_{2}}%
^{b}\right\vert g\right\rangle \\
&  =\sum_{1\leq j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)
\mathfrak{g}\left(  e_{j_{1}}^{b},e_{j_{2}}^{b}\right)  =\sum_{1\leq
j_{1}<j_{2}\leq r}\left(  e_{j_{1}}\wedge e_{j_{2}}\right)  \mathfrak{g}%
\left(  e_{j_{1}}^{b},e_{j_{2}}^{b}\right)  ,
\end{align}
where%
\begin{equation}
\mathfrak{g}\left(  e_{j_{1}},e_{j_{2}}\right)  =\left\langle \left.
g\right\vert e_{j_{1}}\wedge e_{j_{2}}\right\rangle =\mathcal{R}_{\wedge^{2}%
e}\left(  g\right)  _{j_{1}j_{2}}.
\end{equation}

\end{remark}

\begin{definition}
$\mathfrak{g}$ denotes a skew symmetric $\equiv$ antisymmetric \emph{bilinear}
functional
\begin{equation}
\mathfrak{g}:V\times V\rightarrow\mathbb{C}%
\end{equation}
defined by
\begin{gather}
\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle \left.  g\right\vert
x_{1}\wedge x_{2}\right\rangle =\left\langle \left.  \sum_{1\leq j<k\leq
r}\left(  e_{j}^{b}\wedge e_{k}^{b}\right)  \mathcal{R}_{\wedge^{2}e^{b}%
}\left(  g\right)  _{j_{1}j_{2}}\right\vert \overset{\overset{}{}}{x_{1}\wedge
x_{2}}\right\rangle \\
=\left\langle \left.  \sum_{1\leq j<k\leq r}\left(  e_{j}^{b}\wedge e_{k}%
^{b}\right)  \mathcal{R}_{\wedge^{2}e^{b}}\left(  g\right)  _{jk}\right\vert
\sum_{1\leq j<k\leq r}\left(  e_{j}\wedge e_{k}\right)  \mathcal{R}%
_{\wedge^{2}e}\left(  x_{1}\wedge x_{2}\right)  _{jk}\right\rangle
=\sum_{1\leq j<k\leq r}\overline{\mathcal{R}_{\wedge^{2}e^{b}}\left(
g\right)  _{jk}}\mathcal{R}_{\wedge^{2}e}\left(  x_{1}\wedge x_{2}\right)
_{jk},
\end{gather}
formed by the $\left\langle \left.  {}\right\vert \right\rangle $-overlaps of
$g$ with decomposable elements of $\bigwedge\nolimits^{2}V$.
\end{definition}

\begin{remark}
Any geminal $g\in\bigwedge\nolimits^{2}V$ can be expressed in
\emph{cannonical} form as%
\begin{equation}
g=\sum_{1\leq j\leq s}c_{j}\left(  g\right)  \left(  e\left(  g\right)
_{j}\wedge e\left(  g\right)  _{j+s}\right)  =\sum_{1\leq j\leq s}e^{c}\left(
g\right)  _{j}\wedge e^{c}\left(  g\right)  _{j+s}=\frac{1}{2}\sum_{1\leq
j\leq s}\left(  e^{c}\left(  g\right)  _{j}\otimes e^{c}\left(  g\right)
_{j+s}-e^{c}\left(  g\right)  _{j+s}\otimes e^{c}\left(  g\right)
_{j}\right)  ,
\end{equation}
where
\begin{equation}
c_{j}\left(  g\right)  =\left\langle e^{d}\left(  g\right)  _{j}\wedge
e^{d}\left(  g\right)  _{j+s},g\right\rangle =\left\langle g,e^{d}\left(
g\right)  _{j}\wedge e^{d}\left(  g\right)  _{j+s}\right\rangle =\mathfrak{g}%
\left(  e^{d}\left(  g\right)  _{j},e^{d}\left(  g\right)  _{j+s}\right)
,\quad e^{d}\left(  g\right)  _{j}\in V,\quad1\leq j\leq r
\end{equation}
and the weighted basis $e^{c}\left(  g\right)  $ that depends on $g$ is
defined by
\begin{align}
e^{c}\left(  g\right)  _{j}  &  =c_{j}\left(  g\right)  ^{\frac{1}{2}}e\left(
g\right)  _{j}\\
e^{c}\left(  g\right)  _{j+s}  &  =c_{j}\left(  g\right)  ^{\frac{1}{2}%
}e\left(  g\right)  _{j+s}\\
1  &  \leq j\leq s.
\end{align}

\end{remark}

\begin{definition}
The\emph{ }$\left(  \left.  {}\right\vert \right)  $-biorthogonal\emph{ }basis
$\left\vert e\left(  g\right)  ^{b}\right)  $ of $V,$ where $\left\{
\left\vert e\left(  g\right)  _{j}^{b}\right)  \in V,1\leq j\leq s\right\}  $
is defined by
\begin{align}
\left\vert e\left(  g\right)  _{j}^{b}\right)   &  =c_{j}\left(  g\right)
^{-\frac{1}{2}}e\left(  g\right)  _{j}\\
\left\vert e\left(  g\right)  _{j+s}^{b}\right)   &  =c_{j}\left(  g\right)
^{-\frac{1}{2}}e\left(  g\right)  _{j+s}\\
1  &  \leq j\leq s.
\end{align}
is $\left(  \left.  {}\right\vert \right)  $-biorthogonal to $\left(  e\left(
g\right)  \right)  $ i.e.
\begin{equation}
\left(  e\left(  g\right)  ^{b}\left\vert \overset{}{e\left(  g\right)
}\right.  \right)  =\mathbb{I}_{2s}.
\end{equation}
Hence
\begin{equation}
\left\vert e\left(  g\right)  ^{b}\right)  =\left\vert e\left(  g\right)
\right)  \left(  \left.  e\left(  g\right)  \right\vert e\left(  g\right)
\right)  ^{-1}.
\end{equation}

\end{definition}

\begin{remark}
This should be compared to the $\left(  \left.  {}\right\vert \right)
$-\emph{orthonormal} basis $\left\vert e^{s}\left(  g\right)  \right)  \subset
V$
\begin{equation}
\left\vert e^{s}\left(  g\right)  \right)  =\left\vert e\left(  g\right)
\right)  \left(  \left.  e\left(  g\right)  \right\vert e\left(  g\right)
\right)  ^{-\frac{1}{2}}%
\end{equation}
giving%
\begin{equation}
\left(  \left.  e^{s}\left(  g\right)  \right\vert e^{s}\left(  g\right)
\right)  =\left(  \left.  e\left(  g\right)  \right\vert e\left(  g\right)
\right)  ^{-\frac{1}{2}}\left(  \left.  e\left(  g\right)  \right\vert
e\left(  g\right)  \right)  \left(  \left.  e\left(  g\right)  \right\vert
e\left(  g\right)  \right)  ^{-\frac{1}{2}}=\mathbb{I}_{2s}%
\end{equation}
and the $\left(  \left.  {}\right\vert \right)  $-biorthogonal basis
$\left\vert e^{b}\left(  g\right)  \right)  \subset V$
\begin{equation}
\left\vert e^{b}\left(  g\right)  \right)  =\left(  e\left(  g\right)
\right)  \left\langle \left.  e\left(  g\right)  \right\vert e\left(
g\right)  \right\rangle ^{-1},
\end{equation}
where $\left\{  \left\vert e^{b}\left(  g\right)  _{j}\right)  \in V,1\leq
j\leq s\right\}  .$
\end{remark}

\begin{remark}
In the case $V=\mathcal{H}^{1}$%
\begin{gather}
g=\sum_{1\leq j\leq s}c_{j}\left(  g\right)  \left\vert e\left(  g\right)
_{j}e\left(  g\right)  _{j+s}\right\rangle =\sqrt{2}\sum_{1\leq j\leq s}%
c_{j}\left(  g\right)  e\left(  g\right)  _{j}\wedge e\left(  g\right)
_{j+s}=\sqrt{2}\sum_{1\leq j\leq s}e^{c}\left(  g\right)  _{j}\wedge
e^{c}\left(  g\right)  _{j+s}\\
=\frac{1}{\sqrt{2}}\sum_{1\leq j\leq s}\left(  e^{c}\left(  g\right)
_{j}\otimes e^{c}\left(  g\right)  _{j+s}-e^{c}\left(  g\right)  _{j+s}\otimes
e^{c}\left(  g\right)  _{j}\right)
\end{gather}
and the \emph{canonical basis} is again defined as
\begin{align}
e^{c}\left(  g\right)  _{j}  &  =c_{j}\left(  g\right)  ^{\frac{1}{2}}e\left(
g\right)  _{j}\\
e^{c}\left(  g\right)  _{j+s}  &  =c_{j}\left(  g\right)  ^{\frac{1}{2}%
}e\left(  g\right)  _{j+s}\\
1  &  \leq j\leq s.
\end{align}

\end{remark}

\begin{remark}
This should be compared to the $\left\langle \left.  {}\right\vert
\right\rangle $-orthonormal basis $\left\vert e^{s}\left(  g\right)
\right\rangle $
\begin{equation}
\left\vert e^{s}\left(  g\right)  \right\rangle =\left\vert e\left(  g\right)
\right\rangle \left\langle \left.  e\left(  g\right)  \right\vert e\left(
g\right)  \right\rangle ^{-\frac{1}{2}}\equiv\left(  e\left(  g\right)
\right)  \left\langle \left.  e\left(  g\right)  \right\vert e\left(
g\right)  \right\rangle ^{-\frac{1}{2}}%
\end{equation}
giving%
\begin{equation}
\left\langle \left.  e^{s}\left(  g\right)  \right\vert e^{s}\left(  g\right)
\right\rangle =\left\langle \left.  e^{s}\left(  g\right)  \right\vert
e^{s}\left(  g\right)  \right\rangle ^{-\frac{1}{2}}\left\langle \left.
e^{s}\left(  g\right)  \right\vert e^{s}\left(  g\right)  \right\rangle
\left\langle \left.  e^{s}\left(  g\right)  \right\vert e^{s}\left(  g\right)
\right\rangle ^{-\frac{1}{2}}=\mathbb{I}_{2s}%
\end{equation}
and the $\left\langle \left.  {}\right\vert \right\rangle $-biorthogonal basis
$\left\vert e^{b}\left(  g\right)  \right\rangle $
\begin{equation}
\left\vert e^{b}\left(  g\right)  \right\rangle =\left(  e^{s}\left(
g\right)  \right)  \left\langle \left.  e^{s}\left(  g\right)  \right\vert
e^{s}\left(  g\right)  \right\rangle ^{-1}%
\end{equation}
where $\left\{  \left\vert e^{b}\left(  g\right)  _{j}\right\rangle
\in\mathcal{H}^{1},1\leq j\leq s\right\}  .$
\end{remark}

The image of the cannonical form
\begin{equation}
\Omega\left(  g\right)  =J_{g}%
\end{equation}
has the representation
\begin{equation}
\Omega\left(  g\right)  \left(  e\left(  g\right)  \right)  =\left(  e\left(
g\right)  \right)  \mathcal{R}_{e\left(  g\right)  }\left(  \Omega\left(
g\right)  \right)  ,
\end{equation}
The representation on the $\left(  e\left(  g\right)  \right)  $ basis is
given by
\begin{equation}
\left(  e\left(  g\right)  \right\vert \left\vert \Omega\left(  g\right)
e\left(  g\right)  \right)  =\left(  \left.  e\left(  g\right)  \right\vert
e\left(  g\right)  \right)  \mathcal{R}_{e\left(  g\right)  }\left(
\Omega\left(  g\right)  \right)  .
\end{equation}
The representation matrix $\mathcal{R}_{e\left(  g\right)  }\left(
\Omega\left(  g\right)  \right)  $ can be expressed in terms of the matrix
$\left(  e\left(  g\right)  \right\vert \left\vert \Omega\left(  g\right)
e\left(  g\right)  \right)  $ by
\begin{equation}
\mathcal{R}_{e\left(  g\right)  }\left(  \Omega\left(  g\right)  \right)
=\left(  \left.  e\left(  g\right)  \right\vert e\left(  g\right)  \right)
^{-1}\left(  e\left(  g\right)  \right\vert \left\vert \Omega\left(  g\right)
e\left(  g\right)  \right)  ,
\end{equation}
which can also be expressed in terms of the matrix $\left(  \left.  e\left(
g\right)  ^{d}\right\vert \Omega\left(  g\right)  e\left(  g\right)  \right)
$ as
\begin{equation}
\mathcal{R}_{e\left(  g\right)  }\left(  \Omega\left(  g\right)  \right)
=\left(  \left.  e^{d}\left(  g\right)  \right\vert \Omega\left(  g\right)
e\left(  g\right)  \right)  .
\end{equation}
The representation wrt the reciporical$\equiv$dual basis is given by
\begin{align}
\Omega\left(  g\right)  \left(  e^{d}\left(  g\right)  \right)   &  =\left(
e^{d}\left(  g\right)  \right)  \mathcal{R}_{e\left(  g\right)  ^{d}}\left(
\Omega\left(  g\right)  \right) \\
\left(  \left.  e\left(  g\right)  ^{d}\right\vert \Omega\left(  g\right)
e\left(  g\right)  ^{d}\right)   &  =\left(  \left.  e\left(  g\right)
^{d}\right\vert e\left(  g\right)  ^{d}\right)  \mathcal{R}_{e\left(
g\right)  }\left(  \Omega\left(  g\right)  \right)
\end{align}
giving
\begin{equation}
\mathcal{R}_{e\left(  g\right)  }\left(  \Omega\left(  g\right)  \right)
=\left(  \left.  e\left(  g\right)  ^{d}\right\vert e\left(  g\right)
^{d}\right)  ^{-1}\left(  \left.  e\left(  g\right)  ^{d}\right\vert
\Omega\left(  g\right)  e\left(  g\right)  ^{d}\right)  .
\end{equation}


\begin{remark}
As%
\begin{equation}
e\left(  g\right)  ^{d}=\mathbf{c}\left(  g\right)  ^{-\frac{1}{2}}%
\mathbf{e}\left(  g\right)
\end{equation}
one obtains
\begin{equation}
\left(  \left.  e\left(  g\right)  ^{d}\right\vert e\left(  g\right)
^{d}\right)  =\left(  \left.  \mathbf{c}\left(  g\right)  ^{-\frac{1}{2}%
}\mathbf{e}\left(  g\right)  \right\vert \mathbf{c}\left(  g\right)
^{-\frac{1}{2}}\mathbf{e}\left(  g\right)  \right)  =\mathbf{c}\left(
g\right)  ^{-1}\left(  \left.  \mathbf{e}\left(  g\right)  \right\vert
\mathbf{e}\left(  g\right)  \right)  .
\end{equation}

\end{remark}

The matrix $\left(  \left.  e\left(  g\right)  _{j}^{d}\right\vert
\Omega\left(  g\right)  e\left(  g\right)  _{k}^{d}\right)  $ of
$\Omega\left(  g\right)  $ in the reciporical basis is given by
\begin{equation}
\left(  \left.  e\left(  g\right)  _{j}^{d}\right\vert \Omega\left(  g\right)
e\left(  g\right)  _{k}^{d}\right)  =\mathfrak{g}\left(  e\left(  g\right)
_{j}^{d},e\left(  g\right)  _{k}^{d}\right)  ,\quad1\leq j<k\leq2s,
\end{equation}
where the geminal $g$ expressed in the canonical basis $\left(  e\left(
g\right)  \right)  $ is
\begin{equation}
g=\sum_{1\leq j\leq s}e\left(  g\right)  _{j}\wedge e\left(  g\right)  _{j+s}%
\end{equation}
giving%
\begin{equation}
\mathfrak{g}\left(  e\left(  g\right)  _{j}^{d},e\left(  g\right)  _{k}%
^{d}\right)  =\left\langle \left.  e\left(  g\right)  _{j}^{d},e\left(
g\right)  _{k}^{d}\right\vert g\right\rangle =\left\langle \left.
\overset{\overset{}{}}{e\left(  g\right)  _{j}^{d}\wedge e\left(  g\right)
_{k}^{d}}\right\vert \sum_{1\leq l\leq s}e\left(  g\right)  _{l}\wedge
e\left(  g\right)  _{l+s}\right\rangle =\delta_{jl}\delta_{kl+s},,\quad1\leq
j,k\leq2s
\end{equation}
and the matrices $\mathcal{R}_{e\left(  g\right)  ^{d}}\left(  \Omega\left(
g\right)  \right)  =$ $\mathcal{M}_{e\left(  g\right)  ^{d}}\left(
\Omega\left(  g\right)  \right)  $ as
\begin{equation}
\mathcal{R}_{e\left(  g\right)  ^{d}}\left(  \Omega\left(  g\right)  \right)
=\mathcal{M}_{e\left(  g\right)  ^{d}}\left(  \Omega\left(  g\right)  \right)
=\left(
\begin{array}
[c]{cc}%
\mathbb{O} & \mathbb{I}_{s}\\
-\mathbb{I}_{s} & \mathbb{O}%
\end{array}
\right)  =\mathbb{J}_{2s}\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  .
\end{equation}


\begin{lemma}
$g\in\bigwedge\nolimits^{2}V,$ where $\operatorname*{Rank}\left(  g\right)
=s$ and $\dim\left\{  V\right\}  =r=2s,$ defines a complex structure $J_{g}$
on the $\mathbb{C}$-vector space $V.$
\end{lemma}

\begin{proof}
From the preceding.
\end{proof}

\begin{lemma}
The representations $\mathcal{R}_{\wedge^{2}e}\left(  g\right)  $ and
$\mathcal{R}_{\otimes^{2}e}\left(  g\right)  $ of geminals $g$ is given by
\begin{align}
g  &  =\left(  \mathbf{e}\wedge\mathbf{e}\right)  \mathcal{R}_{\wedge^{2}%
e}\left(  g\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}\wedge e_{2} & \cdots & e_{r-1}\wedge e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{12}\\
\vdots\\
\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{r-1r}%
\end{array}
\right) \\
&  =\left(  \mathbf{e}\otimes\mathbf{e}\right)  \mathcal{R}_{\otimes^{2}%
e}\left(  g\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}\otimes e_{2} & \cdots & e_{r-1}\otimes e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\otimes^{2}e}\left(  g\right)  _{11}\\
\vdots\\
\mathcal{R}_{\otimes^{2}e}\left(  g\right)  _{r-1r}%
\end{array}
\right)  ,
\end{align}
where
\begin{equation}
\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{jk}=\frac{1}{2}\sum_{1\leq
j<k\leq r}\left(  \mathcal{R}_{\otimes^{2}e}\left(  g\right)  _{jk}%
-\mathcal{R}_{\otimes^{2}e}\left(  g\right)  _{kj}\right)  .
\end{equation}

\end{lemma}

\begin{theorem}
Geminals $g$ can be expanded in canonical form as
\begin{equation}
g=\sum_{1\leq j\leq s}e\left(  g\right)  _{j}\wedge e\left(  g\right)
_{j+s}=\frac{1}{2}\sum_{1\leq j\leq s}\left\{  e\left(  g\right)  _{j}\otimes
e\left(  g\right)  _{j+s}-e\left(  g\right)  _{j+s}\otimes e\left(  g\right)
_{j}\right\}  .
\end{equation}

\end{theorem}

\begin{proof}
In the sequel we examine the isomorphism
\begin{equation}
\Xi_{VV^{d}}:V\otimes V^{d}\rightarrow\mathcal{L}\left(  V\right)
\end{equation}
defined by
\begin{equation}
\Xi_{VV^{d}}\left(  e\left(  g\right)  _{j}\otimes e\left(  g\right)  _{k}%
^{d}\right)  =E\left(  g\right)  _{jk}\in\mathcal{L}\left(  V\right)
,\quad1\leq j,k\leq r,
\end{equation}
where $\left\{  \left.  E\left(  g\right)  _{jk}\right\vert 1\leq j,k\leq
r\right\}  $ are operators defined by
\begin{equation}
\Xi_{VV^{d}}\left(  e\left(  g\right)  _{j}\otimes e\left(  g\right)  _{k}%
^{d}\right)  \left(  v\right)  =E\left(  g\right)  _{jk}\left(  v\right)
=\left(  e\left(  g\right)  _{k}^{d}\left(  v\right)  \right)  e\left(
g\right)  _{j},\quad1\leq j,k\leq r.
\end{equation}
giving%
\begin{equation}
E\left(  g\right)  _{jk}E\left(  g\right)  _{lm}=E\left(  g\right)
_{jm}\delta_{kl}.
\end{equation}
This shows that $E\left(  g\right)  _{jj}$ are idempotents $\equiv$ projectors
i.e.
\begin{equation}
E\left(  g\right)  _{jj}E\left(  g\right)  _{jj}=E\left(  g\right)  _{jj}%
^{2}=E\left(  g\right)  _{jj},\quad1\leq j,k\leq r.
\end{equation}


\begin{remark}
Complex structures \label{Complex structures}
\begin{equation}
J_{g}=\Xi_{VV^{d}}\left(  g\right)  =\Xi_{VV^{d}}\left(  \frac{1}{2}%
\sum_{1\leq j\leq s}\left\{  e\left(  g\right)  _{j}\otimes e\left(  g\right)
_{j+s}-e\left(  g\right)  _{j+s}\otimes e\left(  g\right)  _{j}\right\}
\right)  =\frac{1}{2}\sum_{1\leq j\leq s}\left\{  E\left(  g\right)
_{jj+s}-E\left(  g\right)  _{j+sj}\right\}
\end{equation}
do not depend on the norms of the vectors $\left\{  \left.  e\left(  g\right)
_{j}^{d}\right\vert 1\leq j\leq2s\right\}  $ nor $\left\{  \left.  e\left(
g\right)  _{j}\right\vert 1\leq j\leq2s\right\}  .$
\end{remark}
\end{proof}

$\lceil$%
\begin{align}
J_{g}^{2}  &  =\sum_{1\leq j\leq s}\sum_{1\leq k\leq s}\left\{  E\left(
g\right)  _{jj+s}-E\left(  g\right)  _{j+sj}\right\}  \left\{  E\left(
g\right)  _{kk+s}-E\left(  g\right)  _{k+sk}\right\} \\
&  =\sum_{1\leq j\leq s}\sum_{1\leq k\leq s}\left\{  E\left(  g\right)
_{jj+s}E\left(  g\right)  _{kk+s}-E\left(  g\right)  _{jj+s}E\left(  g\right)
_{k+sk}-E\left(  g\right)  _{j+sj}E\left(  g\right)  _{kk+s}+E\left(
g\right)  _{j+sj}E\left(  g\right)  _{kk+s}\right\} \\
&  =\sum_{1\leq j\leq s}\left\{  -E\left(  g\right)  _{jj+s}+E\left(
g\right)  _{j+sj}\right\}  =-J_{g}%
\end{align}
$\rfloor$

\begin{definition}
If $r=2s$ the image operator $G=\Xi_{VV^{d}}\left(  g\right)  $ defines a
\emph{complex symplectic} form
\begin{equation}
\left\{  x_{1},x_{2}\right\}  _{G}=\left(  \left.  x_{1}\right\vert
Gx_{2}\right)  .
\end{equation}

\end{definition}

\begin{remark}
All complex symmetric operators $S\in\mathcal{L}\left(  V\right)  $ can be
expressed in product form as
\begin{equation}
S=Q^{t}Q.
\end{equation}

\end{remark}

\begin{remark}
All complex antisymmetric operators $S\in\mathcal{L}\left(  V\right)  $ can be
expressed in product form as
\begin{equation}
S=Q^{t}J_{g}Q,
\end{equation}
where
\begin{equation}
J_{g}=-J_{g}^{t}.
\end{equation}

\end{remark}

\begin{remark}
All positive operators $S\in\mathcal{L}\left(  V\right)  $ can be expressed in
product form as
\begin{equation}
S=Q^{\dagger}Q.
\end{equation}

\end{remark}

\begin{notation}
Complex symmetric bilinear forms $\mathcal{SL}\left(  V\right)  \subset
\mathcal{BL}\left(  V\right)  $%
\begin{align}
\mathcal{SL}\left(  V\right)   &  =\left\{  \left.  \mathfrak{s}%
_{S}\right\vert \mathfrak{s}_{S}:V\times V\rightarrow\mathbb{C},\right. \\
&  \left.  \mathfrak{s}_{S}\left(  \alpha_{1}v_{1}+a_{2}v_{2},\beta_{1}%
w_{1}+\beta_{2}w_{2}\right)  =\alpha_{1}\beta_{1}\mathfrak{s}_{S}\left(
v_{1},w_{1}\right)  +\alpha_{1}\beta_{2}\mathfrak{s}_{S}\left(  v_{1}%
,w_{2}\right)  +\alpha_{2}\beta_{1}\mathfrak{s}_{S}\left(  v_{2},w_{1}\right)
+\alpha_{2}\beta_{2}\mathfrak{s}_{S}\left(  v_{2},w_{2}\right)  \right\}  .
\end{align}

\end{notation}

\begin{notation}
Sequilinear forms $\mathcal{SQL}\left(  V\right)  $%
\begin{align}
\mathcal{SQL}\left(  V\right)   &  =\left\{  \left.  \mathfrak{s}%
_{SL}\right\vert \mathfrak{s}_{SL}:V\times V\rightarrow\mathbb{C},\right. \\
&  \left.  \mathfrak{s}_{SL}\left(  \alpha_{1}v_{1}+a_{2}v_{2},\beta_{1}%
w_{1}+\beta_{2}w_{2}\right)  =\overline{\alpha_{1}}\beta_{1}\mathfrak{s}%
_{SL}\left(  v_{1},w_{1}\right)  +\overline{\alpha_{1}}\beta_{2}%
\mathfrak{s}_{SL}\left(  v_{1},w_{2}\right)  +\overline{\alpha_{2}}\beta
_{1}\mathfrak{s}_{SL}\left(  v_{2},w_{1}\right)  +\overline{\alpha_{2}}%
\beta_{2}\mathfrak{s}_{SL}\left(  v_{2},w_{2}\right)  \right\}  .
\end{align}

\end{notation}

Later we shall prove the theorem

\begin{theorem}
\begin{enumerate}
\item \emph{All} nondegenerate complex symmetric bilinear forms $\mathfrak{s}%
_{S}\in\mathcal{SL}\left(  V\right)  $ can be expressed as
\begin{equation}
\mathfrak{s}_{S}\left(  x_{1},x_{2}\right)  =\left(  \left.  x_{1}\right\vert
Sx_{2}\right)  ,\quad S=S^{t},\,S\in GL\left(  V\right)  .
\end{equation}


\item All nondegenerate $\left(  \text{complex antisymmetric bilinear
forms}\right)  $ $\equiv$ $\left(  \text{symplectic forms if }r=2s\right)  $
$\mathfrak{a}_{G}\equiv$ $\mathfrak{a}_{g}$ can be expressed as
\begin{equation}
\mathfrak{a}_{G}\left(  x_{1},x_{2}\right)  =\left(  \left.  x_{1}\right\vert
x_{2}\right)  _{G}=\left(  \left.  x_{1}\right\vert Gx_{2}\right)  =\left(
\left.  x_{1}\right\vert Gx_{2}\right)  ,\quad G=-G^{t},G\in GL\left(
V\right)
\end{equation}
and

\item in terms of geminals
\begin{equation}
\mathfrak{a}_{G}\left(  x_{1},x_{2}\right)  =\mathfrak{a}_{\Omega\left(
g\right)  }\left(  x_{1},x_{2}\right)  \equiv\mathfrak{a}_{g}\left(
x_{1},x_{2}\right)  =\mathfrak{g}\left(  x_{1},x_{2}\right)  =\left\langle
\left.  x_{1}\wedge x_{2}\right\vert g\right\rangle .
\end{equation}

\end{enumerate}
\end{theorem}

\begin{lemma}
The product of commuting $G,K$ antisymmetric operators
\begin{equation}
\left[  G,K\right]  =0
\end{equation}
that are symmetric then $GK$ and \ $KG$ are symmetric i.e.
\begin{equation}
GK=\left(  GK\right)  ^{t}%
\end{equation}
and
\begin{equation}
KG=\left(  KG\right)  ^{t}.
\end{equation}

\end{lemma}

\begin{theorem}
Let $r=2s$ and $G,K\in GL\left(  V\right)  $ be antisymmetric operators that
commute then all \emph{nondegenerate} complex \emph{symmetric} bilinear forms
can be expressed as
\begin{equation}
\left(  \left.  x_{1}\right\vert x_{2}\right)  _{GK}=\left(  \left.
x_{1}\right\vert GKx_{2}\right)  .
\end{equation}

\end{theorem}

\begin{corollary}%
\begin{equation}
\left(  \left.  x_{1}\right\vert GKx_{2}\right)  =\left(  \left.
x_{1}\right\vert Kx_{2}\right)  _{G}=\left\{  x_{1},Kx_{2}\right\}
_{G}=\left\{  x_{1},Gx_{2}\right\}  _{K}.
\end{equation}

\end{corollary}

\begin{theorem}
All nondegenerate antisymmetric bilinear forms
\begin{equation}
\mathfrak{a}_{G}\left(  x_{1},x_{2}\right)  =\left\{  x_{1},x_{2}\right\}
_{G}=\left(  \left.  x_{1}\right\vert Gx_{2}\right)  =\left(  \left.
x_{1}\right\vert x_{2}\right)  _{G},\quad G=-G^{t},G\in GL\left(  V\right)  .
\end{equation}

\end{theorem}

\begin{remark}
Let $\left\langle \left.  {}\right\vert \right\rangle $ be a non degenerate
sesquilinear form defined in $V$ i.e.
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle :V\times V\rightarrow
\mathbb{C},
\end{equation}
where
\begin{equation}
\left\langle \left.  x_{1}\right\vert x_{2}\right\rangle =\overline
{\left\langle \left.  x_{2}\right\vert x_{1}\right\rangle }.
\end{equation}

\end{remark}

\begin{definition}
One can define an adjoint operation $"\dagger"$ wrt $\left\langle \left.
{}\right\vert \right\rangle $ as
\begin{equation}
\dagger:\mathcal{L}\left(  V\right)  \rightarrow\mathcal{L}\left(  V\right)  ,
\end{equation}
where $\mathcal{L}\left(  V\right)  $ is the set of linear endomorphisms
acting in $V$ by
\begin{equation}
\left\langle \left.  B^{\dagger}x_{1}\right\vert x_{2}\right\rangle
=\left\langle \left.  x_{1}\right\vert Bx_{2}\right\rangle \quad\forall
x_{2}\in V,\,x_{1}\in V.
\end{equation}

\end{definition}

\begin{notation}
Sesqilinear bilinear forms $\mathfrak{h}$ can be expressed in terms of the
Hilbert space inner product as
\begin{equation}
\mathfrak{h}\left(  v,w\right)  =\left\langle \left.  v\right\vert
w\right\rangle ,\quad v,w\in V.
\end{equation}

\end{notation}

\begin{remark}
The set of self adjoint transformations $\mathcal{L}_{sa}\left(  V\right)  $
generates a \emph{real} linear space.
\end{remark}

\begin{remark}
The set of anti self adjoint transformations $\mathcal{L}_{asa}\left(
V\right)  $ generates a \emph{real} linear space.
\end{remark}

\begin{remark}
The product of commuting self adjoint operators is self adjoint i.e. if
$A,B\in\mathcal{L}_{sa}\left(  V\right)  $ or $A,B\in\mathcal{L}_{asa}\left(
V\right)  $ and
\begin{equation}
\left[  A,B\right]  =0
\end{equation}
then $AB\in\mathcal{L}_{sa}\left(  V\right)  .$
\end{remark}

\begin{example}
Consider \emph{commuting} even dimensional complex antisymmetric matrices
\begin{equation}
\mathbb{A},\mathbb{B}\in\mathcal{M}\left(  2s,2s,\mathbb{C}\right)
\end{equation}


\begin{enumerate}
\item They can always be brought simultaneously to cannonical form
\begin{align}
\mathbb{O}^{t}\mathbb{AO}  &  =\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{s} & -\mathbf{\alpha}_{d}\mathbb{I}_{s}\\
\mathbf{\alpha}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}%
\end{array}
\right) \\
\mathbb{O}^{t}\mathbb{BO}  &  =\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{s} & \mathbf{\beta}_{d}\mathbb{I}_{s}\\
-\mathbf{\beta}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}%
\end{array}
\right)
\end{align}
by an orthogonal transformation $\mathbb{O}\in O\left(  2s,\mathbb{C}\right)
$.

\item They can also be diagonalized simultaneously by a unitary transformation
$\mathbb{W}\in U\left(  2s\right)  $ i.e.
\begin{equation}
\mathbb{W}^{\dagger}\mathbb{AW}=i\left(
\begin{array}
[c]{cc}%
\mathbf{\gamma}_{d} & \mathbb{O}_{s}\\
\mathbb{O}_{s} & -\mathbf{\gamma}_{d}%
\end{array}
\right)  ,\quad\mathbf{\gamma}_{d}\in\mathcal{M}\left(  s,\mathbb{R}\right)
_{+}%
\end{equation}
and
\begin{equation}
\mathbb{W}^{\dagger}\mathbb{BW}=i\left(
\begin{array}
[c]{cc}%
\mathbf{\eta}_{d} & \mathbb{O}_{s}\\
\mathbb{O}_{s} & -\mathbf{\eta}_{d}%
\end{array}
\right)  \quad\mathbf{\eta}_{d}\in\mathcal{M}\left(  s,\mathbb{R}\right)
_{+}.
\end{equation}


\item As they commute their product is \emph{complex symmetric}
\begin{gather}
\mathbb{W}^{\dagger}\mathbb{AW\mathbb{W}^{\dagger}\mathbb{BW=W}^{\dagger
}\mathbb{A\mathbb{BW}}=}\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{s} & -\mathbf{\alpha}_{d}\mathbb{I}_{s}\\
\mathbf{\alpha}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{s} & \beta\mathbb{I}_{s}\\
-\beta\mathbb{I}_{s} & \mathbb{O}_{s}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\alpha}_{d}\mathbf{\beta}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}\\
\mathbb{O}_{s} & \mathbf{\alpha\beta}\mathbb{I}_{s}%
\end{array}
\right)  ,\\
\mathbb{\mathbb{W}^{\dagger}\mathbb{BWW}^{\dagger}\mathbb{AW=W}^{\dagger
}\mathbb{BAW}=}\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{s} & \mathbf{\beta}_{d}\mathbb{I}_{s}\\
-\mathbf{\beta}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{s} & \mathbf{\beta}_{d}\mathbb{I}_{s}\\
-\mathbf{\beta}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\beta}_{d}\mathbf{\alpha}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}\\
\mathbb{O}_{s} & \mathbf{\beta}_{d}\mathbf{\alpha}_{d}\mathbb{I}_{s}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\alpha}_{d}\mathbf{\beta}_{d}\mathbb{I}_{s} & \mathbb{O}_{s}\\
\mathbb{O}_{s} & \mathbf{\alpha}_{d}\mathbf{\beta}_{d}\mathbb{I}_{s}%
\end{array}
\right) \\
\quad\mathbf{\alpha}_{d},\mathbf{\beta}_{d}\in\mathcal{M}\left(
s,\mathbb{R}\right)  _{+}.
\end{gather}

\end{enumerate}
\end{example}

\begin{theorem}
Any nonsingular \emph{doubly degenerate }complex symmetric operator can be
expressed as the product of two commuting nonsingular complex antisymmetric operators.
\end{theorem}

\begin{proof}%
\begin{align}
A  &  =i\left(  \sum_{1\leq j\leq s}\alpha_{j}\left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{j}\right\vert -\left\vert
\varphi_{j+s}\right\rangle \left\langle \varphi_{j+s}\right\vert \right) \\
B  &  =i\left(  \sum_{1\leq j\leq s}\beta_{j}\left\vert \varphi_{j}%
\right\rangle \left\langle \varphi_{j}\right\vert -\left\vert \varphi
_{j+s}\right\rangle \left\langle \varphi_{j+s}\right\vert \right)
\end{align}
giving%
\begin{align}
AB  &  =-\sum_{1\leq j,k\leq s}\alpha_{j}\beta_{k}\left(  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{j}\right\vert -\left\vert
\varphi_{j+s}\right\rangle \left\langle \varphi_{j+s}\right\vert \right)
\left(  \left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{k}\right\vert -\left\vert \varphi_{k+s}\right\rangle \left\langle
\varphi_{k+s}\right\vert \right) \\
&  =-\sum_{1\leq j\leq s}\alpha_{j}\beta_{j}\left(  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{j}\right\vert +\left\vert
\varphi_{j+s}\right\rangle \left\langle \varphi_{j+s}\right\vert \right)  .
\end{align}

\end{proof}

\begin{theorem}
Any \underline{\emph{doubly degenerate}} complex symmetric $2s\times2s$ matrix
can be expressed as the product of two complex antisymmetric $2s\times2s$ matrices.
\end{theorem}

\begin{example}
Of the expansion of the square of geminals
\begin{equation}
\left\vert \Psi_{4}\right\rangle =\left\vert \Psi_{2}\right\rangle
^{2}=\left\vert \Psi_{2}\right\rangle \wedge\left\vert \Psi_{2}\right\rangle
=\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq r}\left\vert e_{j_{1}}e_{j_{2}%
}e_{j_{3}}e_{j_{4}}\right\rangle \operatorname{Pf}\left\{  \Omega\left(
\Psi_{2}\right)  \left(  \left\{  j_{1}j_{2}\right\}  ,\left\{  j_{3}%
j_{4}\right\}  \right)  \right\}  .
\end{equation}

\end{example}

\begin{example}
$n=4,r=6$%
\[
\binom{6}{4}=\binom{6}{2}=15
\]%
\begin{gather}
\left(  \overset{}{\left\vert \Psi_{2}\right\rangle \wedge\left\vert \Psi
_{2}\right\rangle }\right)  \left(  \overset{}{x_{1},x_{2},x_{3},x_{4}%
}\right)  =\Psi_{4}\left(  x_{1},x_{2},x_{3},x_{4}\right)  =\left\langle
\left.  \overset{}{x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}}\right\vert
\Psi_{4}\right\rangle \\
=\left\langle \left.  \sum_{1\leq j_{1}\leq6}\left\vert e_{j_{1}}\right\rangle
x_{j_{1}1}\wedge\sum_{1\leq j_{2}\leq6}\left\vert e_{j_{2}}\right\rangle
x_{j_{2}2}\wedge\sum_{1\leq j3\leq6}\left\vert e_{j_{3}}\right\rangle
x_{j_{3}3}\wedge\sum_{1\leq j_{4}\leq6}\left\vert e_{j_{4}}\right\rangle
x_{j_{4}4}\right\vert \Psi_{4}\right\rangle \\
=\sum_{1\leq j_{1}<\cdots<j_{4}\leq6}\left\langle \left.  \left\vert e_{j_{1}%
}\right\rangle \wedge\left\vert e_{j_{2}}\right\rangle \wedge\left\vert
e_{j_{3}}\right\rangle \wedge\left\vert e_{j_{4}}\right\rangle \right\vert
\Psi_{4}\right\rangle x_{j_{1}1}x_{j_{2}2}x_{j_{3}3}x_{j_{4}4}=\sqrt{4!}%
\sum_{1\leq j_{1}<\cdots<j_{4}\leq6}\left\langle \left.  e_{j_{1}}e_{j_{2}%
}e_{j_{3}}e_{j_{4}}\right\vert \Psi_{4}\right\rangle x_{j_{1}1}x_{j_{2}%
2}x_{j_{3}3}x_{j_{4}4}\\
=\sqrt{4!}\sum_{\substack{1\leq j_{1}<\cdots<j_{4}\leq6\\1\leq k_{1}%
<\cdots<k_{4}\leq6}}\left\langle \left.  \overset{\overset{}{}}{e_{j_{1}%
}e_{j_{2}}e_{j_{3}}e_{j_{4}}}\right\vert \sum_{1\leq k_{1}<k_{2}<k_{3}%
<k_{4}\leq6}\left\vert e_{k_{1}}e_{k_{2}}e_{k_{3}}e_{k_{4}}\right\rangle
\right\rangle x_{j_{1}1}x_{j_{2}2}x_{j_{3}3}x_{j_{4}4}\operatorname{Pf}%
\left\{  \Omega\left(  \Psi_{2}\right)  \left(  \left\{  k_{1}k_{2}\right\}
,\left\{  k_{3}k_{4}\right\}  \right)  \right\} \\
=\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq6}\left\langle \left.  x_{1}\wedge
x_{2}\wedge x_{3}\wedge x_{4}\right\vert e_{j_{1}}e_{j_{2}}e_{j_{3}}e_{j_{4}%
}\right\rangle \operatorname{Pf}\left\{  \Omega\left(  \Psi_{2}\right)
\left(  \left\{  j_{1}j_{2}\right\}  ,\left\{  j_{3}j_{4}\right\}  \right)
\right\} \\
=\sqrt{4!}\sum_{1\leq j_{1}<\cdots<j_{4}\leq6}\det\left\{  \left(
\mathbf{x}_{1}\mathbf{x}_{2}\mathbf{x}_{3}\mathbf{x}_{4}\right)  \left(
\overset{}{\left\{  j_{1}j_{2}\right\}  ,\left\{  j_{3}j_{4}\right\}
}\right)  \right\}  \operatorname{Pf}\left\{  \Omega\left(  \Psi_{2}\right)
\left(  \overset{}{\left\{  j_{1}j_{2}\right\}  ,\left\{  j_{3}j_{4}\right\}
}\right)  \right\}  .
\end{gather}
The value of the subscripts are
\begin{equation}
\left\{  j_{1}j_{2}\right\}  ,\left\{  j_{3}j_{4}\right\}  =\left\{  \left\{
12\right\}  ,\left\{  34\right\}  \right\}  ,\left\{  \left\{  13\right\}
,\left\{  24\right\}  \right\}  ,\left\{  \left\{  14\right\}  ,\left\{
23\right\}  \right\}  .
\end{equation}

\end{example}

\begin{definition}
The set of $n$-variable multilinear antisymmetric functions form a vector
space $A^{n}\left(  V\right)  .$
\end{definition}

\begin{definition}
Grassmann Product of antisymmetric functions is
\begin{equation}
\Psi_{1}\wedge\Psi_{2}=\frac{\left(  p+q\right)  !}{p!q!}\mathcal{A}%
_{n}\left(  \Psi_{1}{\small \cdot}\Psi_{2}\right)  ,
\end{equation}
where
\begin{equation}
\left(  \Psi_{1}{\small \cdot}\Psi_{2}\right)  \left(  x_{1},\cdots
,x_{n}\right)  =\Psi_{1}\left(  x_{1},\cdots,x_{p}\right)  \Psi_{2}\left(
x_{p+1},\cdots,x_{n}\right)
\end{equation}
and $p+q=n.$
\end{definition}

Explicity this definition gives%
\begin{equation}
\left(  \Psi_{1}\wedge\Psi_{2}\right)  \left(  x_{1},\cdots,x_{n}\right)
=\frac{1}{p!q!}\sum_{\sigma\in S_{n}}\sigma\left(  \pi\right)  \Psi_{1}\left(
x_{\sigma\left(  1\right)  },\cdots,x_{\sigma\left(  p\right)  }\right)
\Psi_{2}\left(  x_{\sigma\left(  p+1\right)  },\cdots,x_{\sigma\left(
n\right)  }\right)  .
\end{equation}


\begin{remark}
The sets
\begin{equation}
\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(  p\right)  \right\}
\text{ and }\left\{  \sigma\left(  p+1\right)  ,\cdots,\sigma\left(  n\right)
\right\}
\end{equation}
are disjoint.
\end{remark}

\begin{remark}
One can generalize
\begin{equation}
\left(  \Psi_{1}\wedge\Psi_{2}\right)  \left(  x_{j_{1}},\cdots,x_{j_{n}%
}\right)  =\frac{1}{p!q!}\sum_{\sigma\in S_{n}}\sigma\left(  \pi\right)
\Psi_{1}\left(  x_{j_{\sigma\left(  1\right)  }},\cdots,x_{j_{\sigma\left(
p\right)  }}\right)  \Psi_{2}\left(  x_{j_{\sigma\left(  p+1\right)  }}%
,\cdots,x_{j_{\sigma\left(  n\right)  }}\right)  .
\end{equation}
with different initial sets of natural numbers
\begin{equation}
\left\{  1,\cdots,n\right\}  \rightarrow\left\{  j_{1},\cdots,j_{n}\right\}
\subset\mathbb{N}^{n}%
\end{equation}
and consider disjoint subsets $\left\{  \left\{  j_{\sigma\left(  1\right)
},\cdots,j_{\sigma\left(  p\right)  }\right\}  ,\left\{  j_{\sigma\left(
p+1\right)  },\cdots,j_{\sigma\left(  n\right)  }\right\}  \right\}  $
obtained from $\left\{  j_{1},\cdots,j_{n}\right\}  $.
\end{remark}

\begin{remark}%
\begin{equation}
\Psi_{1}\wedge\Psi_{2}=\left(  -1\right)  ^{pq}\Psi_{2}\wedge\Psi_{1}.
\end{equation}

\end{remark}

\begin{definition}
The Grassmann Algebra $\mathcal{A}\left(  V\right)  $ over $V$ is a graded
associative algebra
\begin{equation}
\mathcal{A}\left(  V\right)  =\sum_{0\leq n\leq r}\mathcal{A}^{n}\left(
V\right)  .
\end{equation}

\end{definition}

\begin{theorem}%
\begin{equation}
\mathcal{A}\left(  V\right)  \cong\bigwedge\left(  V^{d}\right)  .
\end{equation}

\end{theorem}

\section{Exterior Powers}

\begin{definition}
A \emph{set }is the mathematical model for a collection of different things. A
set contains \emph{elements} or \emph{members}, which can be mathematical
objects of any kind: numbers, symbols, points in space, lines, other
geometrical shapes, variables, or even other sets. The set with no element is
the empty set; a set with a single element is a singleton. A set may have a
finite number of elements or be an infinite set. Two sets are equal if they
have precisely the same elements. \emph{Note that order in the display of the
sets does not matter for equality.}
\end{definition}

\begin{remark}
The ordering of the elements in a set is irrelevant. \emph{In contrast,} in a
sequence, a tuple, or a permutation of a set, the ordering of the terms
matters, so such sets have additional structure.
\end{remark}

\begin{example}
As a set
\begin{equation}
S=\left\{  1,2,3,4\right\}  =\left\{  2,3,4,1\right\}  .
\end{equation}

\end{example}

\begin{definition}
T\emph{he Power set (or Powerset)}, $\mathcal{P}\left(  S\right)  $ of a set
$S$ is the set of all \emph{strictly ordered} (i.e. any permutation of a set
is counted as the same set) subsets of $S$, including the empty set and $S$ itself.
\end{definition}

\begin{notation}
The cardenality $\#\left\{  \left(  \mathcal{P}S\right)  \right\}  $ of the
power set $\mathcal{P}\left(  S\right)  $ is denoted by $2^{\#\left(
\mathcal{S}\right)  }$
\end{notation}

If $\#\left\{  \mathcal{S}\right\}  =n<\infty$ then
\begin{equation}
\#\left\{  \mathcal{P}\left(  S\right)  \right\}  =2^{n}.
\end{equation}


\begin{example}%
\begin{gather}
S=\left\{  1,2,3,4\right\}  ,\quad\#\left\{  S\right\}  =4\\
\#\left\{  \mathcal{P}\left(  S\right)  \right\}  =2^{4}=16\\
\mathcal{P}\left(  S\right)  =\left\{  \overset{}{\left\{  {}\right\}
,\left\{  1\right\}  ,\left\{  2\right\}  ,\left\{  3\right\}  ,\left\{
4\right\}  ,\left\{  1,2\right\}  ,\left\{  1,3\right\}  ,\left\{
1,4\right\}  ,\left\{  2,3\right\}  ,\left\{  2,4\right\}  ,\left\{
3,4\right\}  ,\left\{  1,2,3\right\}  ,\left\{  1,2,4\right\}  ,\left\{
1,3,4\right\}  ,\left\{  2,3,4\right\}  ,\left\{  1,2,3,4\right\}  }\right\}
.
\end{gather}

\end{example}

\begin{example}
of some sets of \emph{disjoint subsets} $DC\left\{  S\right\}  $ of
$\mathcal{P}\left(  S\right)  $
\begin{equation}
\left\{  \overset{}{\left\{  1,2\right\}  ,\left\{  3,4\right\}  }\right\}
\end{equation}
and%
\begin{equation}
\left\{  \overset{}{\left\{  1\right\}  ,\left\{  2,3,4\right\}  }\right\}  .
\end{equation}

\end{example}

\begin{remark}
The power set $\mathcal{P}\left(  S\right)  $ of a set $S$, together with the
operations of \emph{union, intersection and complement}, can be viewed as the
prototypical example of a \emph{Boolean algebra}. In fact, one can show that
\emph{any finite} Boolean algebra \emph{is isomorphic }to the Boolean algebra
of the power set of a finite set.
\end{remark}

\subsection{Combinations and Permutations}

\begin{definition}
A \emph{permutation} $\sigma\in\operatorname*{Map}\left\{  S\right\}  \equiv$
$\operatorname*{Map}\left\{  S,S\right\}  $ of a set $S$ is defined as a
\emph{bijection} from $S$ to itself i.e.%
\begin{equation}
\sigma:S\rightarrow S
\end{equation}
The number of permutations of $n$ distinct objects is $n$ factorial, written
as $n!$
\end{definition}

\begin{example}
Let $S=\mathbb{N}^{n}$ then $\sigma$ is a map of $n$-tuples of natural numbers
to $n$-tuples of natural numbers i.e.
\begin{equation}
\sigma:\mathbb{N}^{n}\rightarrow\mathbb{N}^{n}%
\end{equation}
given by
\begin{equation}
\sigma\left(  \left\{  1,\cdots,n\right\}  \right)  =\left\{  \sigma\left(
1\right)  ,\cdots,\sigma\left(  n\right)  \right\}  ;\quad1\leq\sigma\left(
j\right)  \neq\sigma\left(  k\right)  \leq n\text{ when }1\leq j\neq k\leq n,
\end{equation}
where the components of $\sigma$ also denoted by $\sigma$ map natural numbers
to natural numbers i.e.
\begin{equation}
\sigma:\mathbb{N}\rightarrow\mathbb{N}.
\end{equation}

\end{example}

\begin{remark}
In the finite case a \emph{permutation} $\sigma:S\rightarrow S$ induces a map
$\sigma:\mathcal{P}\left(  S\right)  \rightarrow\mathcal{P}\left(  S\right)  $
by
\begin{equation}
\sigma\left(  \left\{  n_{1},\cdots,n_{m}\right\}  \right)  =\left\{
\sigma\left(  n_{1}\right)  ,\cdots,\sigma\left(  n_{m}\right)  \right\}
;\quad n_{j}\in\mathbb{N}\quad1\leq j\leq m,\,1\leq m\leq\#\left\{  S\right\}
,
\end{equation}
where order of the resultant sets matters i.e. sets with the same elements are
different if the order of the elements are different.
\end{remark}

\begin{example}
In the set
\begin{equation}
S=\left\{  1,\cdots,7\right\}
\end{equation}
permutations $\sigma$ change the order of the elements of the set e.g.
\begin{equation}
\sigma\left(  \left\{  1,\cdots,7\right\}  \right)  =\left\{  \sigma\left(
1\right)  ,\cdots,\sigma\left(  7\right)  \right\}  =\left\{
1,2,3,7,6,5,4\right\}  ,
\end{equation}
but viewed as a set, $S$ is unchanged.

The power set of $S$ is%
\begin{equation}
\mathcal{P}\left(  S\right)  =\left\{  \phi,\left\{  1\right\}  ,\cdots
,\left\{  7\right\}  ,\left\{  1,2\right\}  ,\left\{  1,3\right\}
,\cdots,\left\{  6,7\right\}  ,\cdots,\left\{  1,\cdots,7\right\}  \right\}
\end{equation}
and the induced permutation is
\begin{equation}
\sigma\left(  \mathcal{P}\left(  \left\{  1,\cdots,7\right\}  \right)
\right)  =\left\{  \phi,\left\{  \sigma\left(  1\right)  \right\}
,\cdots,\left\{  \sigma\left(  7\right)  \right\}  ,\left\{  \sigma\left(
1\right)  ,\sigma\left(  2\right)  \right\}  ,\left\{  \sigma\left(  1\right)
,\sigma\left(  3\right)  \right\}  ,\cdots,\left\{  \sigma\left(  6\right)
,\sigma\left(  7\right)  \right\}  ,\cdots,\left\{  \sigma\left(  1\right)
,\cdots,\sigma\left(  7\right)  \right\}  \right\}  ,
\end{equation}
which changes the order of the power set.
\end{example}

\begin{remark}
The symbol $\sigma$ can viewd as denoting maps
\begin{align}
&  :S\rightarrow S\\
&  :S\rightarrow\mathcal{P}\left(  S\right) \\
&  :\mathcal{P}\left(  S\right)  \rightarrow\mathcal{P}\left(  S\right)
\end{align}

\end{remark}

\begin{definition}
$k$-\emph{permutations} $\sigma\in P_{k}^{n}$ are maps
\begin{equation}
\sigma:S\rightarrow\mathcal{P}_{Pk}\left(  S\right)
\end{equation}
that selects $k$ members of $S$ and \emph{depends on} the order of $S$, where
$\mathcal{P}_{Pk}\left(  S\right)  $ is the set of subsets of $S$ of
cardenality $k$ and does not \emph{depend on} order$.$ The cardenality
$\#\left\{  \mathcal{P}_{Pk}\left(  S\right)  \right\}  $ is the number of
ways of selecting $k$ objects from $n$ objects and is given by
\begin{equation}
\#\left\{  \mathcal{P}_{Pk}\left(  S\right)  \right\}  =\#\left\{  P_{k}%
^{n}\right\}  =\frac{n!}{\left(  n-k\right)  !}.
\end{equation}

\end{definition}

\begin{remark}
A $k$-permutation is the choice of $k$ things from a set of $n$ things where
the order of the \emph{result} \emph{does not matter}.
\end{remark}

\begin{example}
Let $\#\left(  S\right)  =4$
\begin{equation}
S=\left\{  1,2,3,4\right\}
\end{equation}
and
\begin{equation}
k=2
\end{equation}
then
\begin{equation}
\#\left(  P_{2}^{4}\right)  =\frac{4!}{2!}=\frac{4\times3\times2\times
1}{2\times1}=12
\end{equation}
and
\begin{equation}
\mathcal{P}_{P2}\left\{  \left\{  1,2,3,4\right\}  \right\}  =\left\{
\overset{}{\left\{  1,2\right\}  ,\left\{  1,3\right\}  ,\left\{  1,4\right\}
,\left\{  2,3\right\}  ,\left\{  2,4\right\}  ,\left\{  3,4\right\}  ,\left\{
2,1\right\}  ,\left\{  3,1\right\}  ,\left\{  4,1\right\}  ,\left\{
3,2\right\}  ,\left\{  4,2\right\}  ,\left\{  4,3\right\}  }\right\}  .
\end{equation}
The subsets in the result $\mathcal{P}_{P2}\left\{  \left\{  1,2,3,4\right\}
\right\}  $ \emph{depend on order} i.e. $\left\{  1,2,3,4\right\}
\neq\left\{  2,1,3,4\right\}  $ but not dependent on different arrangements
$\equiv$ odering of $S$ i.e. $\left\{  3,1,4,2\right\}  $ produce the same results.
\end{example}

\begin{definition}
\emph{Combinations}, $\sigma\in C_{k}^{n}$ are maps
\begin{equation}
\sigma:S\rightarrow\mathcal{P}_{Ck}\left(  S\right)  \subset\mathcal{P}\left(
S\right)  ,
\end{equation}
that selects $k$ members of $S$ and the order of the result\emph{ does
matter}. The cardenality $\#\left\{  \mathcal{P}_{Ck}\left(  S\right)
\right\}  $ is the number of ways of selecting $k$ objects in an ordered
fashion from $n$ objects and is given by
\begin{equation}
\#\left\{  \mathcal{P}_{Ck}\left(  S\right)  \right\}  =\#\left\{  C_{k}%
^{n}\right\}  =\frac{n!}{\left(  n-k\right)  !k!}.
\end{equation}

\end{definition}

\begin{remark}
These cardenalities are also known as \emph{binomial coefficients} and are
denoted by $\binom{n}{k}.$
\end{remark}

\begin{example}
Let $\#\left\{  S\right\}  =4$
\begin{equation}
S=\left\{  1,2,3,4\right\}
\end{equation}
and
\begin{equation}
k=2
\end{equation}
then
\begin{equation}
\#\left\{  C_{2}^{4}\right\}  =\frac{4!}{2!2!}=6
\end{equation}
and
\begin{equation}
\mathcal{P}_{C2}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{  \left\{
1,2\right\}  ,\left\{  1,3\right\}  ,\left\{  1,4\right\}  ,\left\{
2,3\right\}  ,\left\{  2,4\right\}  ,\left\{  3,4\right\}  \right\}  .
\end{equation}
The subsets in the result $\mathcal{P}_{C2}\left\{  \left\{  1,2,3,4\right\}
\right\}  $ \emph{depend on order} and $\left\{  1,2\right\}  =\left\{
2,1\right\}  .$
\end{example}

\begin{notation}
\begin{enumerate}
\item Sets $\mathbb{N}^{m}$ $=\,\overset{m}{\overbrace{\mathbb{N\times
\cdots\times N}}}$ of $m$ natural numbers $\mathbb{N}$
\begin{equation}
\mathbb{N}^{m}=\left\{  \left.  \left(  n_{1},\cdots.n_{m}\right)  \right\vert
n_{j}\in\mathbb{N},1\leq j\leq m\right\}  .
\end{equation}


\item Sets $\mathbb{N}_{d}^{m}$ $\subset\mathbb{N}^{m}$ of $m$ distinct
natural numbers $\mathbb{N}$ i.e.
\begin{equation}
\mathbb{N}_{d}^{m}=\left\{  \left.  \left(  n_{1},\cdots.n_{m}\right)
\right\vert n_{j}\neq n_{k}\in\mathbb{N},1\leq j\neq k\leq m\right\}  .
\end{equation}


\item Sets of \emph{ordered} natural numbers
\begin{equation}
\mathbb{N}_{p}^{>m}=\left\{  n_{p},\cdots,n_{m}\right\}  \in\mathbb{N}%
^{m-p+1},\quad1\leq p\leq m,\quad n_{p}<\cdots<n_{m},\quad0<\left(  n_{j}%
\in\mathbb{N}\right)  <\infty,1\leq j\leq m.
\end{equation}


In particular
\begin{equation}
\mathbb{N}^{>m}=\mathbb{N}_{1}^{>m}=\left\{  n_{1},\cdots,n_{m}\right\}
\in\mathbb{N}^{m},\quad n_{1}<\cdots<n_{m},\quad0<\left(  n_{j}\in
\mathbb{N}\right)  <\infty,1\leq j\leq m.
\end{equation}


\item Sets of \emph{unordered} natural numbers%
\begin{equation}
\mathbb{N}_{p}^{m}=\left\{  n_{p},\cdots,n_{m}\right\}  \in\mathbb{N}%
^{m-p+1},\quad1\leq p\leq m,\quad0<\left(  n_{j}\in\mathbb{N}\right)
<\infty,1\leq j\leq m.
\end{equation}


In particular
\begin{equation}
\mathbb{N}^{m}\equiv\mathbb{N}_{1}^{m}=\left\{  n_{1},\cdots,n_{m}\right\}
\in\mathbb{N}^{m},\quad0<\left(  n_{j}\in\mathbb{N}\right)  <\infty,1\leq
j\leq m.
\end{equation}


\item The set of permutations $\sigma\in S_{m}\subset\operatorname*{Map}%
\left\{  \mathbb{N}^{m},\mathbb{N}^{m}\right\}  \equiv\operatorname*{Map}%
\left\{  \mathbb{N}^{m}\right\}  $ of $m$ objects $\left\{  \mathfrak{o}%
_{1},\cdots,\mathfrak{o}_{m}\right\}  \in\mathfrak{o}^{m}\leftrightarrow
\left\{  1,\cdots,m\right\}  \in\mathbb{N}^{m}$ are bijections
\begin{equation}
\sigma:\mathbb{N}^{m}\rightarrow\mathbb{N}^{m},
\end{equation}
where
\begin{equation}
\sigma\left(  \left\{  n_{1},\cdots,n_{m}\right\}  \right)  =\left\{
\sigma\left(  n_{1}\right)  ,\cdots,\sigma\left(  n_{m}\right)  \right\}
=\left\{  n_{\sigma\left(  1\right)  },\cdots,n_{\sigma\left(  m\right)
}\right\}  ,
\end{equation}
i.e.%
\begin{equation}
\sigma\left(  n_{k}\right)  =n_{\sigma\left(  k\right)  },\quad1\leq k\leq m.
\end{equation}


\item In particular
\begin{equation}
\sigma\left(  \left\{  1,\cdots,m\right\}  \right)  =\left\{  \sigma\left(
1\right)  ,\cdots,\sigma\left(  m\right)  \right\}  .
\end{equation}


\item The set of permutations $S_{m}$ has a group structure and is called the
$m^{th}$ Symmetric group and has order $\#\left(  S_{m}\right)  $ given by
\begin{equation}
\#\left(  S_{m}\right)  =m!
\end{equation}


\item The \emph{group action} of $S_{m}$ on $\mathbb{N}^{m}$ i.e. the
representation induced by $\mathbb{N}^{m}$ is given by
\begin{equation}
\sigma\left(  \left\{  n_{1},\cdots,n_{m}\right\}  \right)  =\left\{
\sigma\left(  n_{1}\right)  ,\cdots,\sigma\left(  n_{m}\right)  \right\}
=\left\{  n_{\sigma\left(  1\right)  },\cdots,n_{\sigma\left(  m\right)
}\right\}
\end{equation}


\begin{enumerate}
\item
\begin{equation}
\sigma_{1}\left(  \left\{  n_{1},\cdots,n_{m}\right\}  \right)  =\left\{
\sigma_{1}\left(  n_{1}\right)  ,\cdots,\sigma_{1}\left(  n_{m}\right)
\right\}  =\left\{  n_{\sigma_{1}\left(  1\right)  },\cdots,n_{\sigma
_{1}\left(  m\right)  }\right\}
\end{equation}
and%
\begin{equation}
\sigma_{2}\left(  \left\{  n_{1},\cdots,n_{m}\right\}  \right)  =\left\{
\sigma_{2}\left(  n_{1}\right)  ,\cdots,\sigma_{2}\left(  n_{m}\right)
\right\}  =\left\{  n_{\sigma_{2}\left(  1\right)  },\cdots,n_{\sigma
_{2}\left(  m\right)  }\right\}  .
\end{equation}


\item The group action of $S_{m}$ on $\mathbb{N}^{m}$ is given by
\begin{equation}
\left(  \sigma_{1}\sigma_{2}\right)  \left(  \left\{  n_{1},\cdots
,n_{m}\right\}  \right)  =\sigma_{1}\left\{  \sigma_{2}\left(  n_{1}\right)
,\cdots,\sigma_{2}\left(  n_{m}\right)  \right\}  =\left\{  n_{\left(
\sigma_{1}\sigma_{2}\right)  \left(  1\right)  },\cdots,n_{\left(  \sigma
_{1}\sigma_{2}\right)  \left(  m\right)  }\right\}  .
\end{equation}

\end{enumerate}

\item Ordered subsets $\mathbb{N}_{q}^{>p}\in\mathcal{P}\left\{
\mathbb{N}_{1}^{>m}\right\}  $ of natural numbers contained in $\mathbb{N}%
_{1}^{>m}=\left\{  1,2,\cdots,m\right\}  $ are
\begin{equation}
\mathbb{N}_{q}^{>p}=\left\{  p,\cdots,q\right\}  ,\quad1\leq p<q\leq m,\quad
p,q\in\mathbb{N}.
\end{equation}


\item One can denote \emph{the results }$\equiv$ $\operatorname*{Range}\left(
\sigma\right)  $ of $k$-permutations and $k$-combinations restricted to
$\mathbb{N}_{1}^{n}$ by $C_{k}^{n}\left\{  \mathbb{N}_{1}^{n}\right\}  $ and
$P_{k}^{n}\left\{  \mathbb{N}_{1}^{n}\right\}  .$

\item The set of subsets contained in the \emph{range} of the $k$-permutations
$\sigma\in C_{k}^{n}$ acting on $\mathbb{N}_{1}^{n}$ is $\left\{  \left.
\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(  k\right)  \right\}
\right\vert \sigma:\mathbb{N}_{1}^{n}\rightarrow\mathbb{N}_{1}^{n},\,\sigma\in
C_{k}^{n}\right\}  .$

\item \label{Disjoint Combinations}

\begin{definition}
Disjoint Combinations $DC_{m,n}^{r}$ is the set of $n$-permutations $\sigma$
that produce \emph{disjoint sets} of $m$ \emph{ordered} objects $\left\{
\sigma\left(  1\right)  ,\cdots,\sigma\left(  m\right)  \right\}  $and $n$
\emph{ordered} objects $\left\{  \sigma\left(  m+1\right)  ,\cdots
,\sigma\left(  m+n\right)  \right\}  $ selected from a set of \emph{ordered}
$r$ objects and is defined by
\begin{align}
DC_{m,n}^{r}\left\{  \left\{  1,\cdots,r\right\}  \right\}   &  =\left\{
\left.  \overset{}{\left\{  \overset{}{\sigma\left(  1\right)  ,\cdots
,\sigma\left(  m\right)  }\right\}  ,\left\{  \overset{}{\left\{
1,\cdots,r\right\}  \ominus\left\{  \sigma\left(  1\right)  ,\cdots
,\sigma\left(  m\right)  \right\}  }\right\}  }\right\vert \sigma\in
S_{r}\right\} \\
&  =\left\{  \left.  \overset{}{\left\{  \overset{}{\sigma\left(  1\right)
,\cdots,\sigma\left(  m\right)  }\right\}  ,\left\{  \overset{}{\eta_{\sigma
}\left(  m+1\right)  ,\cdots,\eta_{\sigma}\left(  m+n\right)  }\right\}
}\right\vert \sigma,\eta_{\sigma}\in S_{r}\right\}  ,
\end{align}
i.e.
\begin{equation}
\left\{  \overset{}{\eta_{\sigma}\left(  m+1\right)  ,\cdots,\eta_{\sigma
}\left(  m+n\right)  }\right\}  =\left\{  \overset{}{\left\{  1,\cdots
,r\right\}  \ominus\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(
m\right)  \right\}  }\right\}  .
\end{equation}

\end{definition}

\item The sets $\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(
m\right)  \right\}  $ and $\left\{  \eta_{\sigma}\left(  m+1\right)
,\cdots,\eta_{\sigma}\left(  m+n\right)  \right\}  $ are disjoint as
\begin{equation}
\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(  m\right)  \right\}
\cap\left\{  \eta_{\sigma}\left(  m+1\right)  ,\cdots,\eta_{\sigma}\left(
m+n\right)  \right\}  =\phi
\end{equation}


\item The set of subsets $DC_{m,n}^{r}\left\{  \mathbb{N}_{1}^{r}\right\}
\subset\mathcal{P}\left(  \mathbb{N}_{1}^{r}\right)  $ produced by the results
of the $r$-permutations $\sigma,\eta_{\sigma}\in DC_{m,n}^{r}$ $\subset S_{r}$
on $\mathbb{N}_{1}^{r}$ is%
\begin{equation}
DC_{m,n}^{r}\left\{  \mathbb{N}_{1}^{r}\right\}  =\left\{  \left.  \left\{
\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(  m\right)  \right\}
,\left\{  \sigma,\eta_{\sigma}\left(  m+1\right)  ,\cdots,\sigma,\eta_{\sigma
}\left(  m+n\right)  \right\}  \right\}  \right\vert \sigma\in DC_{m,n}%
^{r};\,\sigma:\mathbb{N}_{1}^{r}\rightarrow\mathbb{N}_{1}^{r}\right\}
\end{equation}
and the cardenality of the set $DC_{m,n}^{r}\left\{  \mathbb{N}_{1}%
^{r}\right\}  $ is
\begin{equation}
\#\left\{  DC_{m,n}^{r}\left\{  \mathbb{N}_{1}^{n}\right\}  \right\}
=\binom{r}{m}\binom{r-m}{n}.
\end{equation}


\item In comparrison consider the \emph{non disjoint} combinations produced by
the identity permutation $\sigma$
\begin{align}
\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(  m\right)  \right\}
\cap\left\{  1,\cdots,m\right\}   &  =\left\{  1,\cdots,m\right\} \\
\left\{  \sigma\left(  m+1\right)  ,\cdots,\sigma\left(  m+n\right)  \right\}
\cap\left\{  m+1,\cdots,m+n\right\}   &  =\left\{  m+1,\cdots,m+n\right\}  .
\end{align}

\end{enumerate}
\end{notation}

\begin{remark}
Any permutation can be expressed as the product of \emph{disjoint}
\emph{cycles} (more precisely: cycles with \emph{disjoint orbits}); such
cycles commute with each other, and the expression of the permutation is
unique up to the order of the cycles.
\end{remark}

\begin{definition}
A \emph{transposition} is an exchange of two elements of an ordered list with
all others staying the same. A transposition is therefore a permutation of two elements.
\end{definition}

\begin{theorem}
The symmetric group $S_{n}$ on $\{1,2,\ldots,n\}$ is generated by
\emph{transpositions} $\left\{  \tau_{12},\tau_{23},\cdots,\tau_{n-1n}%
\right\}  \equiv\left\{  (1,2),(2,3),\ldots,(n-1,n)\right\}  ,$ which form a
subset of permutations\emph{.}
\end{theorem}

\begin{definition}
The difference $"-"$ of two sets, written $A-B$ is the set of all elements of
$A$ that are not elements of $B$.
\end{definition}

\begin{example}
$A=\{1,2,3,4,5\}$ and $B=\{3,4,5,6,7,8\}$%
\begin{align}
A-B  &  =\{1,2,3,4,5\}-\{3,4,5,6,7,8\}=\{1,2\}\\
B-A  &  =\{3,4,5,6,7,8\}-\{1,2,3,4,5\}=\{6,7,8\}.
\end{align}

\end{example}

\begin{remark}
Set difference $"-"$is \underline{\emph{not}}\emph{ a commutative} operation.
\end{remark}

\begin{definition}
The symmetric difference of the sets $A$ and $B$ is commonly denoted by
$A\ominus B$ , or $A\triangle\U{2061} B$ , and is also known as the
\emph{disjunctive union}, is the set of elements \emph{which are in either of
the sets, but not in their intersection i.e. elements not in common}.
\end{definition}

\begin{definition}
The symmetric difference can also be expressed as
\begin{equation}
A\ominus B=A\cup B-A\cap B.
\end{equation}

\end{definition}

\begin{example}
Let $A=\{1,2,3\}$ and $B=\{3,4\}.$ The symmetric difference $\{1,2,3\}\ominus
\{3,4\}$ of the sets $\{1,2,3\}$ and $\{3,4\}$ i.e.
\begin{equation}
\{1,2,3\}\ominus\{3,4\}=\{1,2,4\}
\end{equation}

\end{example}

\begin{example}
Let $A=\{1,2,3\}$ and $B=\{3,4\}$%
\begin{align}
A\cup B  &  =\left\{  1,2,3,4\right\} \\
A\cap B  &  =\left\{  3\right\} \\
A\ominus B  &  =A\cup B-A\cap B\\
&  =\left\{  1,2,3,4\right\}  -\left\{  3\right\} \\
&  =\{1,2,4\}\\
&  =B\ominus A\\
A-B  &  =\{1,2\}\\
B-A  &  =\{4\}.
\end{align}

\end{example}

\begin{definition}
If $A\subset B$ the \emph{compliment} $A^{c}$ of $A$ inside $B$ are those
elements of $B$ not belonging to $A.$
\end{definition}

\begin{definition}
The \emph{relative complement} $B\setminus A$ of $A\subset B$ with respect to
a set $B$, also termed the set difference of $B$ and $A$, written $B\setminus
A$ , is the set of elements in $B$ that are not in $A$.
\end{definition}

\begin{definition}
The symmetric difference can also be e xpressed in terms of \emph{relative
complements i.e. }
\begin{equation}
A\ominus B=\left(  A\setminus B\right)  \cup\left(  B\setminus A\right)
\end{equation}
and
\begin{equation}
A\ominus B=\left.  \left(  A\cup B\right)  \right\backslash \left(  A\cap
B\right)  .
\end{equation}

\end{definition}

\begin{remark}
The symmetric difference is \emph{commutative and associative}.
\end{remark}

\begin{remark}
The sets $\left\{  1,2\right\}  $ and $\left\{  2,1\right\}  $ are identical
as sets. If the sets have an order relation, e.g. lexigraphical order, the two
\emph{ordered} sets are different.
\end{remark}

\begin{remark}
An \emph{order relationship} in $S$ is defined by a subset $\mathcal{R}$ of
the cartesian product $S\times S$ i.e.
\begin{equation}
x\,\mathcal{R\,}y\Leftrightarrow\left(  x,y\right)  \in\mathcal{R}\subset
S\times S.
\end{equation}

\end{remark}

\begin{remark}
A combination $\sigma$ is an ordered permutation
\begin{equation}
\left\{  \sigma\in C_{3}^{9}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}
\right)  \right\}  \equiv\left\{  \left.  \sigma\in C_{3}^{9}\right\vert
\sigma:\left\{  1,2,3,4,5,6,7,8,9\right\}  \rightarrow\mathcal{P}_{3}\left(
\left\{  1,2,3,4,5,6,7,8,9\right\}  \right)  \right\}  ,
\end{equation}
where%
\begin{align}
\mathcal{P}_{3}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)   &
=\left\{  \left\{  1,2,3\right\}  ,\cdots,\left\{  7,8,9\right\}  \right\}
,\\
\#\left\{  \mathcal{P}_{3}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)
\right\}   &  =\binom{9}{3}=\ \frac{9\times8\times7}{1\times2\times3}%
=12\times7=84.
\end{align}

\end{remark}

\begin{definition}
The set of disjoint permutations of rank $7$ produced by permuations of rank
$3$ and $4,$ $\mathcal{P}_{3,4}^{7}\left(  \left\{  1,2,3,4,5,6,7\right\}
\right)  \subset\mathcal{P}\left(  \left\{  1,2,3,4,5,6,7\right\}  \right)  ,$
is defined as
\begin{align}
&  \mathcal{P}_{3,4}^{7}\left(  \left\{  1,2,3,4,5,6,7\right\}  \right)
=\left\{  \overset{}{\left\{  1,2,3\right\}  ,\left\{  1,2,4\right\}
,\left\{  1,2,5\right\}  ,\left\{  1,2,6\right\}  ,\left\{  1,2,7\right\}
,\left\{  2,3,4\right\}  ,\left\{  2,3,5\right\}  ,\left\{  2,3,6\right\}
,\left\{  2,3,7\right\}  },\right. \\
&  \left.  \overset{}{\left\{  3,4,5\right\}  ,\left\{  3,4,6\right\}
,\left\{  3,4,7\right\}  ,\left\{  4,5,6\right\}  ,\left\{  4,5,7\right\}
,\left\{  5,6,7\right\}  }\right\}  \cup\left\{  \overset{}{\left\{
4,5,6,7\right\}  ,\left\{  3,5,6,7\right\}  ,\left\{  3,4,6,7\right\}
},\cdots,\overset{}{\left\{  1,2,3,4\right\}  }\right\} \\
&  =\left\{  \overset{}{\left\{  \overset{}{\left\{  1,2,3\right\}
,\cdots,\left\{  5,6,7\right\}  }\right\}  }\right\}  \cup\left\{  \left\{
\overset{}{\left\{  1,2,3,4,5,6,7\right\}  \ominus\left\{  1,2,3\right\}
}\right\}  ,\cdots,\overset{}{\left\{  \overset{}{\left\{
1,2,3,4,5,6,7\right\}  \ominus\left\{  5,6,7\right\}  }\right\}  }\right\}  ,
\end{align}
where
\begin{equation}
\left\{  1,2,3,4,5,6,7\right\}  \ominus\left\{  1,2,3\right\}  =\left\{
4,5,6,7\right\}  .
\end{equation}

\end{definition}

\begin{definition}%
\begin{equation}
\mathcal{P}_{m,n}^{r}\left(  \left\{  \mathbb{N}_{1}^{r}\right\}  \right)
=DC_{m,n}^{r}\left\{  \mathbb{N}_{1}^{n}\right\}  =\left\{  \left.  \left\{
\overset{}{\sigma\left(  1\right)  ,\cdots,\sigma\left(  m\right)  }\right\}
\cup\left\{  \overset{}{\left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(
n\right)  \right\}  \ominus\left\{  \sigma\left(  1\right)  ,\cdots
,\sigma\left(  m\right)  \right\}  }\right\}  \right\vert \sigma\in
S_{r}\right\}  .
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
DC_{m,n}^{r}\subset C_{m}^{r}.
\end{equation}

\end{remark}

\begin{notation}%
\begin{equation}
DC_{m}^{r}\equiv DC_{m,1}^{r}.
\end{equation}

\end{notation}

\begin{remark}%
\begin{equation}
\left\{  \sigma\in C_{3,4}^{7}\left(  \left\{  1,2.3\right\}  ,\left\{
4,5,6,7\right\}  \right)  \right\}  \equiv\left\{  \left.  \sigma\in
C_{3,4}^{7}\right\vert \sigma:\left\{  1,2,3,4,5,6,7\right\}  \rightarrow
\mathcal{P}_{7,3}^{7}\left(  \left\{  1,2,3,4,5,6,7\right\}  \right)
\right\}  .
\end{equation}

\end{remark}

\begin{lemma}
Equivalence of an ordered sum and the sum over ordered sets of sequences
\begin{equation}
\sum_{1\leq j_{1}<\cdots<j_{7}\leq9}e_{j_{1}}\wedge e_{j_{2}}\wedge e_{j_{3}%
}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge e_{j_{6}}\wedge e_{j_{7}}=\sum_{\mu\in
C_{7}^{9}\left(  \mathbb{N}^{9}\right)  }e_{\mu\left(  1\right)  }\wedge
e_{\mu\left(  2\right)  }\wedge e_{\mu\left(  3\right)  }\wedge e_{\mu\left(
4\right)  }\wedge e_{\mu\left(  5\right)  }\wedge e_{\mu\left(  6\right)
}\wedge e_{\mu\left(  7\right)  }%
\end{equation}

\end{lemma}

\begin{proof}
Enumerate the possible values of $\left\{  j_{1},\cdots,j_{7}\left\vert 1\leq
j_{1}<\cdots<j_{7}\leq9\right.  \right\}  $ and $\left\{  \mu\left(  1\right)
,\cdots,\mu\left(  7\right)  \left\vert \mu\in C_{7}^{9}\left(  \mathbb{N}%
^{9}\right)  \right.  \right\}  $
\end{proof}

\begin{remark}
The subset of rank $7$ of the power set of $\left\{
1,2,3,4,5,6,7,8,9\right\}  $
\begin{align}
\mathcal{P}_{7}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)   &
=\left\{  \left\{  1,2,3,4,5,6,7\right\}  ,\cdots,\left\{
3,4,5,6,7,8,9\right\}  \right\}  ,\\
\#\left\{  \mathcal{P}_{7}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)
\right\}   &  =\binom{9}{7}=\ \frac{9\times8}{1\times2}=36.
\end{align}

\end{remark}

\begin{remark}
Let $m<n,$ and $m+n\leq r$%
\begin{align}
\sigma\left(  \left\{  1,\cdots,r\right\}  \right)   &  =\left\{
\sigma\left(  1\right)  ,\cdots,\sigma\left(  r\right)  \right\}  \quad
\sigma\in S_{r}\\
\sigma\left(  \left\{  1,\cdots,m\right\}  \right)   &  =\left\{
\sigma\left(  1\right)  ,\cdots,\sigma\left(  m\right)  \right\}  \quad
\sigma\in C_{m}^{r}\subset S_{r}\\
\sigma\left(  \left\{  m+1,\cdots,m+n\right\}  \right)   &  =\left\{
\sigma\left(  m+1\right)  ,\cdots,\sigma\left(  m+n\right)  \right\}
\quad\sigma\in C_{n}^{r}\subset S_{r}\\
\sigma\left(  \left\{  1,\cdots,m\right\}  ,\left\{  m+1,\cdots,m+n\right\}
\right)   &  =\left\{  \left\{  \sigma\left(  1\right)  ,\cdots,\sigma\left(
m\right)  \right\}  ,\left\{  \sigma\left(  m+1\right)  ,\cdots,\sigma\left(
m+n\right)  \right\}  \right\}  \quad\sigma\in C_{m,n}^{r}\subset S_{r}\\
\left\{  j_{1},\cdots,j_{m}\right\}   &  =\left\{  \sigma\left(  1\right)
,\cdots,\sigma\left(  m\right)  \right\}  =\sigma\left(  \left\{
1,\cdots,m\right\}  \right)  ,\quad1\leq j_{1}<\cdots<j_{m}\leq r\\
&  =\left(  \lambda\mu\right)  \left(  \left\{  1,\cdots,m\right\}  \right)
=\lambda\left(  \left\{  \mu\left(  1\right)  ,\cdots,\mu\left(  m\right)
\right\}  \right)  =\left\{  \left(  \lambda\mu\right)  \left(  1\right)
,\cdots,\left(  \lambda\mu\right)  \left(  m\right)  \right\}  =\left\{
\lambda\left(  \mu\left(  1\right)  \right)  ,\cdots,\lambda\left(  \mu\left(
m\right)  \right)  \right\} \\
&  =\left\{  \lambda\left(  k_{1}\right)  ,\cdots,\lambda\left(  k_{m}\right)
\right\}  .
\end{align}

\end{remark}

\begin{remark}
One gets the same result from $\sigma$ acting on $\left\{  1,\cdots,m\right\}
\in\mathcal{P}\left(  \mathbb{N}\right)  \equiv$ $\left(  1,\cdots,m\right)
\in\mathbb{N}$ as $\lambda$ acting on $\left\{  k_{1},\cdots,k_{m}\right\}
\in\mathcal{P}\left(  \mathbb{N}\right)  \equiv\left(  k_{1},\cdots
,k_{m}\right)  \in\mathbb{N}$ i.e.
\begin{equation}
\sigma\left(  \left\{  1,\cdots,m\right\}  \right)  =\lambda\left(  \left\{
k_{1},\cdots,k_{m}\right\}  \right)  ,
\end{equation}
i.e. $S_{m}$ acts homogeneously in $\mathbb{N}^{m}$ and $\mathcal{P}\left(
\mathbb{N}\right)  .$
\end{remark}

\begin{remark}
Consider the product
\begin{equation}
\sum_{\substack{1\leq j_{1}<\cdots<j_{3}\leq9\\1\leq j_{4}<\cdots<j_{7}\leq
9}}\left(  e_{j_{1}}\wedge e_{j_{2}}\wedge e_{j_{3}}\right)  X_{j_{1}%
j_{2}j_{3}}\wedge\left(  e_{j_{4}}\wedge e_{j_{5}}\wedge e_{j_{6}}\wedge
e_{j_{7}}\right)  Y_{j_{4}j_{5}j_{6}j_{7}}.
\end{equation}

\end{remark}

\begin{remark}
For clarity and emphasis
\begin{equation}
\sigma\in DC_{3,4}^{7}\equiv\sigma\in DC_{3,4}^{7}\left\{  \left\{
j_{1},j_{2},j_{3}\right\}  ,\left\{  j_{4},j_{5},j_{6},j_{7}\right\}
\right\}
\end{equation}
even though $DC_{3,4}^{7}\left\{  \left\{  j_{1},j_{2},j_{3}\right\}
,\left\{  j_{4},j_{5},j_{6},j_{7}\right\}  \right\}  $ is the \emph{range }of
the action of all the permutations $\sigma\in DC_{3,4}^{7}$ when they act on
the \emph{domain} $\left\{  j_{1},j_{2},j_{3},j_{4},j_{5},j_{6},j_{7}\right\}
.$
\end{remark}

\begin{lemma}
The coefficient of a particular expansion vector $\left(  e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge e_{j_{6}%
}\wedge e_{j_{7}}\right)  $ for $1\leq j_{1}<\cdots<j_{7}$ $\leq9$ is
\begin{equation}
\sum_{\sigma\in DC_{3,4}^{7}\left\{  \left\{  j_{1},j_{2},j_{3}\right\}
,\left\{  j_{4},j_{5},j_{6},j_{7}\right\}  \right\}  }\pi\left(
\sigma\right)  X_{\sigma\left(  j_{1}\right)  \sigma\left(  j_{2}\right)
\sigma\left(  j_{3}\right)  }Y_{\sigma\left(  j_{4}\right)  \sigma\left(
j_{5}\right)  \sigma\left(  j_{6}\right)  \sigma\left(  j_{7}\right)  }%
\end{equation}
and
\begin{equation}
\#\left\{  DC_{3,4}^{9}\right\}  =\binom{7}{3}=105.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{gather}
\sum_{\substack{1\leq j_{1}<\cdots<j_{3}\leq9\\1\leq j_{4}<\cdots<j_{7}\leq
9}}\left(  e_{j_{1}}\wedge e_{j_{2}}\wedge e_{j_{3}}\right)  X_{j_{1}%
j_{2}j_{3}}\wedge\left(  e_{j_{4}}\wedge e_{j_{5}}\wedge e_{j_{6}}\wedge
e_{j_{7}}\right)  Y_{j_{4}j_{5}j_{6}j_{7}}\\
\parallel\\
\sum_{\sigma\in C_{3}^{9}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)
}\left(  e_{\sigma\left(  1\right)  }\wedge e_{\sigma\left(  2\right)  }\wedge
e_{\sigma\left(  3\right)  }\right)  X_{\sigma\left(  1\right)  \sigma\left(
2\right)  \sigma\left(  3\right)  }\wedge\sum_{\eta\in C_{4}^{9}\left(
\left\{  1,2,3,4,5,6,7,8,9\right\}  \right)  }\left(  e_{\eta\left(  4\right)
}\wedge e_{\eta\left(  5\right)  }\wedge e_{\left(  \eta6\right)  }\wedge
e_{\eta\left(  7\right)  }\right)  Y_{\eta\left(  4\right)  \eta\left(
5\right)  \eta\left(  6\right)  \eta\left(  7\right)  }\\
\parallel\\
\sum_{\sigma\in C_{3}^{9}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)
}\sum_{\eta\in C_{4}^{9}\left(  \left\{  1,2,3,4,5,6,7,8,9\right\}  \right)
}\left(  e_{\sigma\left(  1\right)  }\wedge e_{\sigma\left(  2\right)  }\wedge
e_{\sigma\left(  3\right)  }\right)  \wedge\left(  e_{\eta\left(  4\right)
}\wedge e_{\eta\left(  5\right)  }\wedge e_{\eta\left(  6\right)  }\wedge
e_{\eta\left(  7\right)  }\right)  X_{\sigma\left(  1\right)  \sigma\left(
2\right)  \sigma\left(  3\right)  }Y_{\eta\left(  4\right)  \eta\left(
5\right)  \eta\left(  6\right)  \eta\left(  7\right)  }\\
\parallel\\
\sum_{\sigma\in C_{7}^{9}}e_{\sigma\left(  1\right)  }\wedge e_{\sigma\left(
2\right)  }\wedge e_{\sigma\left(  3\right)  }\wedge e_{\sigma\left(
4\right)  }\wedge e_{\sigma\left(  5\right)  }\wedge e_{\sigma\left(
6\right)  }\wedge e_{\sigma\left(  7\right)  }\underset{\sigma\left(  \left\{
1,2,3,4,5,6,7\right\}  \right)  \text{ is a fixed ordered subset of }\left\{
1,2,3,4,5,6,7,8,9\right\}  }{\underbrace{\sum_{\mu\in C_{3}^{7}}\pi\left(
\mu\right)  X_{\mu\left(  \sigma\left(  1\right)  \right)  \mu\left(
\sigma\left(  2\right)  \right)  \mu\left(  \sigma\left(  3\right)  \right)
}Y_{\mu\left(  \sigma\left(  4\right)  \right)  \mu\left(  \sigma\left(
5\right)  \right)  \mu\left(  \sigma\left(  6\right)  \right)  \mu\left(
\sigma\left(  7\right)  \right)  }}}.
\end{gather}

\end{proof}

\begin{example}
$m=3,n=4,r=9$ then

