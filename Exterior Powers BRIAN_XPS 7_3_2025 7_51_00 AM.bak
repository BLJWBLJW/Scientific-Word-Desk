\begin{gather}
\left(  \sqrt{2}\right)  ^{3}\sum_{1\leq j_{1},j_{2},j_{3}\leq2}\left\vert
e_{1j_{1}}\wedge e_{1j_{1}\boldsymbol{+}2}\wedge e_{2j_{2}}\wedge
e_{2j_{2}\boldsymbol{+}2}\wedge e_{3j_{3}}\wedge e_{3j_{3}\boldsymbol{+}%
2}\right\rangle \lambda_{j_{1}1}\lambda_{j_{2}2}\lambda_{j_{3}3}\\
\parallel\\
2\sqrt{2}\left(  \overset{}{\left\vert e_{11}\wedge e_{13}\wedge e_{21}\wedge
e_{21}\wedge e_{31}\wedge e_{31}\right\rangle \lambda_{11}\lambda_{12}%
\lambda_{13}+\left\vert e_{11}\wedge e_{13}\wedge e_{21}\wedge e_{21}\wedge
e_{32}\wedge e_{34}\right\rangle \lambda_{11}\lambda_{12}\lambda_{23}}\right.
\\
+\left\vert e_{11}\wedge e_{13}\wedge e_{22}\wedge e_{24}\wedge e_{31}\wedge
e_{32}\right\rangle \lambda_{11}\lambda_{22}\lambda_{13}+\left\vert
e_{11}\wedge e_{13}\wedge e_{22}\wedge e_{24}\wedge e_{32}\wedge
e_{34}\right\rangle \lambda_{11}\lambda_{22}\lambda_{23}\\
+\left\vert e_{12}\wedge e_{14}\wedge e_{21}\wedge e_{21}\wedge e_{31}\wedge
e_{31}\right\rangle \lambda_{21}\lambda_{12}\lambda_{13}+\left\vert
e_{12}\wedge e_{14}\wedge e_{21}\wedge e_{21}\wedge e_{32}\wedge
e_{34}\right\rangle \lambda_{21}\lambda_{12}\lambda_{23}\\
+\left.  \overset{}{\left\vert e_{12}\wedge e_{14}\wedge e_{22}\wedge
e_{24}\wedge e_{31}\wedge e_{32}\right\rangle \lambda_{21}\lambda_{22}%
\lambda_{13}+\left\vert e_{12}\wedge e_{14}\wedge e_{22}\wedge e_{24}\wedge
e_{32}\wedge e_{34}\right\rangle \lambda_{21}\lambda_{22}\lambda_{23}}\right)
.
\end{gather}


\item
\begin{align}
g_{1}\wedge g_{2}\wedge g_{3}  &  =\Xi_{\left\vert EE\right\rangle }%
^{-1}\left(  G_{1}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{2}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(  G_{3}\right)
\\
&  =\operatorname{Pf}\left(  G_{1},G_{3},G_{3}\right)  e\equiv
\operatorname{Pf}\left(  \Xi_{\left\vert EE\right\rangle }\left(
g_{1}\right)  ,\Xi_{\left\vert EE\right\rangle }\left(  g_{2}\right)
,\Xi_{\left\vert EE\right\rangle }\left(  g_{2}\right)  \right)
e\equiv\operatorname{Pf}\left(  g_{1},g_{2},g_{2}\right)  e.
\end{align}


\item Non canonical expansion for $r=2,n=3,2r=4$
\begin{align*}
g_{1}\wedge g_{2}\wedge g_{3}  &  =\Xi_{\left\vert EE\right\rangle }%
^{-1}\left(  G_{1}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{2}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{3}\right)  =\frac{1}{2^{3}}\left(  \sqrt{2}\right)  ^{3}\sum_{1\leq
j_{1},j_{2},j_{3},j_{4},j_{5},j_{6}\leq4}\left\vert e_{j_{1}}\wedge e_{j_{2}%
}\wedge e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge e_{j_{6}}\right\rangle
g_{j_{1}j_{2}1}g_{j_{3}j_{4}2}g_{j_{5}j_{6}3}\\
&  =\frac{1}{2^{3}}\left(  \sqrt{2}\right)  ^{3}\sum_{1\leq j_{1}<j_{2}%
<j_{3}<j_{4}<j_{5}<j_{6}\leq4}\left\vert e_{j_{1}}\wedge e_{j_{2}}\wedge
e_{j_{3}}\wedge e_{j_{4}}\wedge e_{j_{5}}\wedge e_{j_{6}}\right\rangle
\sum_{\sigma\in DC_{2}^{4}}\left(  g_{j_{\sigma\left(  1\right)  }%
j_{\sigma\left(  2\right)  }1}g_{j_{\sigma\left(  3\right)  }j_{\sigma\left(
4\right)  }2}g_{j_{\sigma\left(  5\right)  }j_{\sigma\left(  6\right)  }%
3}\right)  =0.
\end{align*}


\item
\begin{align}
g_{1}\wedge g_{2}\wedge g_{3}  &  =\frac{1}{2^{3}}\left(  \sqrt{2}\right)
^{3}\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}\leq4}\left\vert
e_{j_{1}j_{2}}\wedge e_{j_{3}j_{4}}\wedge e_{j_{5}j_{6}}\right\rangle
\sum_{\sigma\in DC_{2}^{4}}\left(  g_{j_{\sigma\left(  1\right)  }%
j_{\sigma\left(  2\right)  }1}g_{j_{\sigma\left(  3\right)  }j_{\sigma\left(
4\right)  }2}g_{j_{\sigma\left(  5\right)  }j_{\sigma\left(  6\right)  }%
3}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}\leq4}\left\vert
e_{j_{1}j_{2}}\wedge e_{j_{3}j_{4}}\wedge e_{j_{5}j_{6}}\right\rangle
\operatorname{Pf}\left(  G_{1},G_{2},G_{3}:\left\{  j_{1},j_{2},j_{3}%
,j_{4},j_{5},j_{6}\right\}  \right)  =0
\end{align}

\end{enumerate}
\end{example}

\begin{example}
Non Canonical basis for $r=2,n=2,2r=4$

\begin{enumerate}
\item Geminal $g_{1}$
\begin{equation}
g_{1}=g_{121}\left\vert e_{1}\wedge e_{2}\right\rangle +g_{131}\left\vert
e_{1}\wedge e_{3}\right\rangle +g_{141}\left\vert e_{1}\wedge e_{4}%
\right\rangle +g_{231}\left\vert e_{2}\wedge e_{3}\right\rangle +g_{241}%
\left\vert e_{2}\wedge e_{4}\right\rangle +g_{341}\left\vert e_{3}\wedge
e_{4}\right\rangle
\end{equation}


\item The product $g_{1}\wedge g_{2}$
\begin{align}
g_{1}\wedge g_{2}  &  =\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{1}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{2}\right)  =\frac{1}{2^{2}}\left(  \sqrt{2}\right)  ^{2}\sum_{1\leq
j_{1},j_{2},j_{3},j_{4}\leq4}\left\vert e_{j_{1}}\wedge e_{j_{2}}\wedge
e_{j_{3}}\wedge e_{j_{4}}\right\rangle g_{1\left(  j_{1}j_{2}\right)
}g_{2\left(  j_{3}j_{4}\right)  }\\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq4}\left\vert e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right\rangle \frac{1}{2}\sum
_{\sigma\in DC_{2}^{4}}\left(  g_{1\left(  j_{\sigma\left(  1\right)
}j_{\sigma\left(  2\right)  }\right)  }g_{2\left(  j_{\sigma\left(  3\right)
}j_{\sigma\left(  4\right)  }\right)  }\right)
\end{align}
hence
\begin{align}
g_{1}\wedge g_{2}  &  =\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{1}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(  G_{2}\right)
\\
&  =\left(  g_{121}\left\vert e_{1}\wedge e_{2}\right\rangle +g_{131}%
\left\vert e_{1}\wedge e_{3}\right\rangle +g_{141}\left\vert e_{1}\wedge
e_{4}\right\rangle +g_{231}\left\vert e_{2}\wedge e_{3}\right\rangle
+g_{241}\left\vert e_{2}\wedge e_{4}\right\rangle +g_{341}\left\vert
e_{3}\wedge e_{4}\right\rangle \right) \\
&  \wedge\left(  g_{122}\left\vert e_{1}\wedge e_{2}\right\rangle
+g_{132}\left\vert e_{1}\wedge e_{3}\right\rangle +g_{142}\left\vert
e_{1}\wedge e_{4}\right\rangle +g_{232}\left\vert e_{2}\wedge e_{3}%
\right\rangle +g_{242}\left\vert e_{2}\wedge e_{4}\right\rangle +g_{342}%
\left\vert e_{3}\wedge e_{4}\right\rangle \right) \\
&  =\,+g_{121}\left\vert e_{1}\wedge e_{2}\right\rangle \wedge\left(
g_{342}\left\vert e_{3}\wedge e_{4}\right\rangle \right)  +g_{131}\left\vert
e_{1}\wedge e_{3}\right\rangle \wedge\left(  g_{242}\left\vert e_{2}\wedge
e_{4}\right\rangle \right) \\
&  +g_{141}\left\vert e_{1}\wedge e_{4}\right\rangle \wedge\left(
g_{231}\left\vert e_{2}\wedge e_{3}\right\rangle \right)  +g_{231}\left\vert
e_{2}\wedge e_{3}\right\rangle \wedge\left(  g_{141}\left\vert e_{1}\wedge
e_{4}\right\rangle \right) \\
&  +g_{241}\left\vert e_{2}\wedge e_{4}\right\rangle \wedge\left(
g_{131}\left\vert e_{1}\wedge e_{3}\right\rangle \right)  +g_{341}\left\vert
e_{3}\wedge e_{4}\right\rangle \wedge\left(  g_{121}\left\vert e_{1}\wedge
e_{2}\right\rangle \right)  ,
\end{align}
factoring out the $\left\vert e_{1}\wedge e_{2}\wedge e_{3}\wedge
e_{4}\right\rangle $ term gives
\begin{align}
&  g_{1}\wedge g_{2}=\left(  \,g_{121}\left\vert e_{1}\wedge e_{2}%
\right\rangle \wedge g_{342}\left\vert e_{3}\wedge e_{4}\right\rangle
+g_{131}\left\vert e_{1}\wedge e_{3}\right\rangle \wedge g_{342}\left\vert
e_{3}\wedge e_{4}\right\rangle +g_{141}\left\vert e_{1}\wedge e_{4}%
\right\rangle \wedge g_{232}\left\vert e_{2}\wedge e_{3}\right\rangle \right.
\\
&  +\left.  g_{231}\left\vert e_{2}\wedge e_{3}\right\rangle \wedge
g_{142}\left\vert e_{1}\wedge e_{4}\right\rangle +g_{241}\left\vert
e_{2}\wedge e_{4}\right\rangle \wedge g_{132}\left\vert e_{1}\wedge
e_{3}\right\rangle +g_{341}\left\vert e_{3}\wedge e_{4}\right\rangle \wedge
g_{122}\left\vert e_{1}\wedge e_{2}\right\rangle \right) \\
&  =\left\vert e_{1}\wedge e_{2}\wedge e_{3}\wedge e_{4}\right\rangle \left(
g_{121}g_{342}-g_{131}g_{242}+g_{141}g_{232}+g_{231}g_{142}-g_{241}%
g_{132}+g_{341}g_{122}\right) \\
&  =\left\vert e_{1}\wedge e_{2}\wedge e_{3}\wedge e_{4}\right\rangle
\operatorname{Pf}\left\{  G\left(  g_{1},g_{2}\right)  \right\} \\
&  =\left\vert e_{1}\wedge e_{2}\wedge e_{3}\wedge e_{4}\right\rangle
\operatorname{Pf}\left\{  G\left(  \left(  g_{121},g_{131},g_{231}\right)
,\left(  g_{122},g_{132},g_{232}\right)  \right)  \right\}  .
\end{align}


\item
\begin{align}
\operatorname{Pf}\left\{  G\left(  g_{1},g_{2}\right)  \right\}   &
=\operatorname{Pf}\left\{  G\left(  \left(  g_{121},g_{131},g_{231}\right)
,\left(  g_{122},g_{132},g_{232}\right)  \right)  \right\} \\
&  =\left(  g_{121}g_{342}-g_{131}g_{242}+g_{141}g_{232}+g_{231}%
g_{142}-g_{241}g_{132}+g_{341}g_{122}\right)
\end{align}

\end{enumerate}
\end{example}

\begin{example}
If $g_{1}=g_{2}$ then
\begin{gather}
\operatorname{Pf}\left\{  G\left(  g,g\right)  \right\}  =\operatorname{Pf}%
\left\{  G\left(  g\right)  \right\}  =\operatorname{Pf}\left\{
\Xi_{\left\vert EE\right\rangle }\left(  g\right)  \right\}
=\operatorname{Pf}\left\{  G\left(  \left(  g_{12},g_{13},g_{23}\right)
\right)  \right\}  =\operatorname{Pf}\left\{  \Xi_{\left\vert EE\right\rangle
}\left(  g\right)  \left(  \left\{  1,2,3\right\}  ,\left\{  1,2,3\right\}
\right)  \right\} \\
=\frac{1}{2}\left(  g_{12}g_{34}-g_{13}g_{24}+g_{14}g_{23}+g_{23}g_{14}%
-g_{24}g_{13}+g_{34}g_{12}\right) \\
=\left(  g_{12}g_{34}-g_{13}g_{24}+g_{14}g_{23}\right)  .
\end{gather}

\end{example}

\begin{example}
Canonical basis for $r=2,n=2,2r=4$ for identical geminals
\begin{gather}
g\wedge g=\frac{1}{2^{2}}\left(  \sqrt{2}\right)  ^{2}\sum_{1\leq j_{1}%
,j_{3}\leq2}\left\vert e_{j_{1}}\wedge e_{j_{1}+2}\wedge e_{j_{2}}\wedge
e_{j_{2}+2}\right\rangle \lambda_{j_{1}}\lambda_{j_{2}}\\
\parallel\\
\frac{1}{2}\left(  \overset{}{\left\vert e_{1}\wedge e_{3}\wedge e_{1}\wedge
e_{3}\right\rangle \lambda_{1}\lambda_{1}+\left\vert e_{1}\wedge e_{3}\wedge
e_{2}\wedge e_{4}\right\rangle \lambda_{1}\lambda_{2}}\right. \\
+\\
+\left.  \overset{}{\left\vert e_{2}\wedge e_{4}\wedge e_{1}\wedge
e_{3}\right\rangle \lambda_{2}\lambda_{1}+\left\vert e_{2}\wedge e_{4}\wedge
e_{2}\wedge e_{4}\right\rangle \lambda_{2}\lambda_{2}}\right) \\
\parallel\\
\lambda_{1}\lambda_{2}\left\vert e_{1}\wedge e_{3}\wedge e_{2}\wedge
e_{4}\right\rangle =\operatorname{Pf}\left\{  G\left(  g,g\right)  \right\}
\left\vert e_{1}\wedge e_{3}\wedge e_{2}\wedge e_{4}\right\rangle
=\operatorname{Pf}\left\{  \Omega\left(  g\right)  \right\}  \left\vert
e_{1}\wedge e_{3}\wedge e_{2}\wedge e_{4}\right\rangle \\
=\operatorname{Pf}\left\{  \mathbb{G}\right\}  \left\vert e_{1}\wedge
e_{3}\wedge e_{2}\wedge e_{4}\right\rangle =\operatorname{Pf}\left\{
\mathcal{R}_{e}\left(  G\right)  \right\}  \left\vert e_{1}\wedge e_{3}\wedge
e_{2}\wedge e_{4}\right\rangle \\
\Downarrow\\
\operatorname{Pf}_{e_{1}\wedge e_{3}\wedge e_{2}\wedge e_{4}}\left\{
\mathbb{G}\right\}  =\lambda_{1}\lambda_{2}\equiv\operatorname{Pf}%
_{e_{1}\wedge e_{3}\wedge e_{2}\wedge e_{4}}\left\{  \left(
\begin{array}
[c]{cccc}%
0 & 0 & \lambda_{1} & 0\\
0 & 0 & 0 & \lambda_{2}\\
-\lambda_{1} & 0 & 0 & 0\\
0 & -\lambda_{2} & 0 & 0
\end{array}
\right)  \right\}  =\lambda_{1}\lambda_{2}%
\end{gather}
where%
\begin{equation}
e=\left\vert e_{1}\wedge e_{3}\wedge e_{2}\wedge e_{4}\right\rangle
\end{equation}
and
\begin{equation}
\left\{  \mathbf{e}\right\}  =\left\{  e_{1},e_{3},e_{2},e_{4}\right\}  .
\end{equation}
The representation $\mathcal{R}_{e}\left(  \Xi_{\left\vert EE\right\rangle
}\left(  g\right)  \right)  $ is
\begin{equation}
\mathcal{R}_{e}\left(  \Xi_{\left\vert EE\right\rangle }\left(  g\right)
\right)  =\left(
\begin{array}
[c]{cccc}%
0 & 0 & \lambda_{1} & 0\\
0 & 0 & 0 & \lambda_{2}\\
-\lambda_{1} & 0 & 0 & 0\\
0 & -\lambda_{2} & 0 & 0
\end{array}
\right)
\end{equation}
and the determinant is
\begin{equation}
\det\left\{  \mathcal{R}_{e}\left(  \Xi_{\left\vert EE\right\rangle }\left(
g\right)  \right)  \right\}  =\lambda_{1}\left\vert
\begin{array}
[c]{ccc}%
0 & 0 & \lambda_{2}\\
-\lambda_{1} & 0 & 0\\
0 & -\lambda_{2} & 0
\end{array}
\right\vert =\lambda_{1}\lambda_{2}\left\vert
\begin{array}
[c]{cc}%
-\lambda_{1} & 0\\
0 & -\lambda_{2}%
\end{array}
\right\vert =\left(  \lambda_{1}\lambda_{2}\right)  ^{2}.
\end{equation}

\end{example}

\begin{example}
Canonical basis for $r=3,n=2,2r=6$ for identical geminals

\begin{enumerate}
\item
\begin{gather}
g\wedge g=\frac{1}{2^{2}}2\sum_{1\leq j_{1},j_{2}\leq3}e_{j_{1}}\wedge
e_{j_{1}+3}\wedge e_{j_{2}}\wedge e_{j_{2}+3}\lambda_{j_{1}}\lambda_{j_{2}}\\
\parallel\\
\frac{1}{2}\left(
\begin{array}
[c]{c}%
e_{1}\wedge e_{4}\wedge e_{1}\wedge e_{4}\lambda_{1}\lambda_{1}\\
+e_{1}\wedge e_{4}\wedge e_{2}\wedge e_{5}\lambda_{1}\lambda_{2}\\
+e_{1}\wedge e_{4}\wedge e_{3}\wedge e_{6}\lambda_{1}\lambda_{3}\\
+e_{2}\wedge e_{5}\wedge e_{1}\wedge e_{4}\lambda_{2}\lambda_{1}\\
+e_{2}\wedge e_{5}\wedge e_{2}\wedge e_{5}\lambda_{2}\lambda_{2}\\
+e_{2}\wedge e_{5}\wedge e_{3}\wedge e_{6}\lambda_{2}\lambda_{3}\\
+e_{3}\wedge e_{6}\wedge e_{1}\wedge e_{4}\lambda_{3}\lambda_{1}\\
+e_{3}\wedge e_{6}\wedge e_{2}\wedge e_{5}\lambda_{3}\lambda_{2}\\
+e_{3}\wedge e_{6}\wedge e_{3}\wedge e_{6}\lambda_{3}\lambda_{3}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{c}%
0\\
+e_{1}\wedge e_{4}\wedge e_{2}\wedge e_{5}\lambda_{1}\lambda_{2}\\
+e_{1}\wedge e_{4}\wedge e_{3}\wedge e_{6}\lambda_{1}\lambda_{3}\\
+e_{2}\wedge e_{5}\wedge e_{1}\wedge e_{4}\lambda_{2}\lambda_{1}\\
0\\
+e_{2}\wedge e_{5}\wedge e_{3}\wedge e_{6}\lambda_{2}\lambda_{3}\\
+e_{3}\wedge e_{6}\wedge e_{1}\wedge e_{4}\lambda_{3}\lambda_{1}\\
+e_{3}\wedge e_{6}\wedge e_{2}\wedge e_{5}\lambda_{3}\lambda_{2}\\
0
\end{array}
\right) \\
\parallel\\
\left(  e_{1}\wedge e_{4}\wedge e_{2}\wedge e_{5}\right)  \lambda_{1}%
\lambda_{2}+\left(  e_{1}\wedge e_{4}\wedge e_{3}\wedge e_{6}\right)
\lambda_{1}\lambda_{3}+\left(  e_{2}\wedge e_{5}\wedge e_{3}\wedge
e_{6}\right)  \lambda_{2}\lambda_{3}\\
\parallel\\
\left(  e_{1}\wedge e_{4}\wedge e_{2}\wedge e_{5}\right)  \operatorname{Pf}%
\left\{  \Xi_{\left\vert EE\right\rangle }\left(  g\right)  \left(  12\right)
\right\}  +\left(  e_{1}\wedge e_{4}\wedge e_{3}\wedge e_{6}\right)
\operatorname{Pf}\left\{  \Xi_{\left\vert EE\right\rangle }\left(  g\right)
\left(  13\right)  \right\}  +\left(  e_{2}\wedge e_{5}\wedge e_{3}\wedge
e_{6}\right)  \operatorname{Pf}\left\{  \Xi_{\left\vert EE\right\rangle
}\left(  g\right)  \left(  23\right)  \right\}
\end{gather}


\item The basis
\begin{equation}
\left\{  \mathbf{e}\right\}  =\left\{  e_{1},e_{2},e_{3},e_{4},e_{5}%
,e_{6}\right\}
\end{equation}
has the orientation
\begin{equation}
e=\left\vert e_{1}\wedge e_{4}\wedge e_{2}\wedge e_{5}\wedge e_{3}\wedge
e_{6}\right\rangle =+1
\end{equation}


\item The representation $\mathbb{G}=\mathcal{R}_{e}\left(  \Xi_{\left\vert
EE\right\rangle }\left(  g\right)  \right)  $ is
\begin{equation}
\mathcal{R}_{e}\left(  \Xi_{\left\vert EE\right\rangle }\left(  g\right)
\right)  =\left(
\begin{array}
[c]{cccccc}%
0 & 0 & 0 & \lambda_{1} & 0 & 0\\
0 & 0 & 0 & 0 & \lambda_{2} & 0\\
0 & 0 & 0 & 0 & 0 & \lambda_{3}\\
-\lambda_{1} & 0 & 0 & 0 & 0 & 0\\
0 & -\lambda_{2} & 0 & 0 & 0 & 0\\
0 & 0 & -\lambda_{3} & 0 & 0 & 0
\end{array}
\right)
\end{equation}


\item The Pfaffians of the submatrices are
\begin{align}
\operatorname{Pf}\left(  \mathbb{G}:1,4,2,5\right)   &  =\operatorname{Pf}%
\left\{  \Xi_{\left\vert EE\right\rangle }\left(  g\right)  \left(  12\right)
\right\}  =\lambda_{1}\lambda_{2}\\
\operatorname{Pf}\left(  \mathbb{G}:1,4,3,6\right)   &  =\operatorname{Pf}%
\left\{  \Xi_{\left\vert EE\right\rangle }\left(  g\right)  \left(  13\right)
\right\}  =\lambda_{1}\lambda_{3}\\
\operatorname{Pf}\left(  \mathbb{G}:2,5,3,6\right)   &  =\operatorname{Pf}%
\left\{  \Xi_{\left\vert EE\right\rangle }\left(  g\right)  \left(  23\right)
\right\}  =\lambda_{2}\lambda_{3}%
\end{align}

\end{enumerate}
\end{example}

\begin{definition}
Symmetrized product $\odot_{S}$ of operators $\left\{  \left.  A_{j}%
\in\mathcal{B}\left(  V\right)  \right\vert 1\leq j\leq n\right\}  $
\begin{equation}
A_{1}\odot_{S}\cdots\odot_{S}A_{n}=\frac{1}{n!}\sum_{\sigma\in S_{n}}%
A_{\sigma\left(  1\right)  }\cdots A_{\sigma\left(  n\right)  }.
\end{equation}

\end{definition}

\begin{remark}
The product produced by the symmetrized product $\odot_{S}$is different from
the Jordan product $\ast$
\begin{equation}
A_{1}\odot_{S}A_{2}\odot_{S}A_{3}=\frac{1}{6}\left(  A_{1}A_{2}A_{3}%
+A_{2}A_{1}A_{3}+A_{1}A_{3}A_{2}+A_{3}A_{1}A_{2}+A_{2}A_{3}A_{1}+A_{3}%
A_{2}A_{1}\right)
\end{equation}
compared to
\begin{align}
A_{1}\ast A_{2}\ast A_{3}  &  =\left\{  A_{1},\left\{  A_{2},A_{3}\right\}
\right\}  =\left\{  A_{1},\left(  A_{2}A_{3}+A_{3}A_{2}\right)  \right\}
=A_{1}\left(  A_{2}A_{3}+A_{3}A_{2}\right)  +\left(  A_{2}A_{3}+A_{3}%
A_{2}\right)  A_{1}\\
&  =A_{1}A_{2}A_{3}+A_{1}A_{3}A_{2}+A_{2}A_{3}A_{1}+A_{3}A_{2}A_{1}.
\end{align}


\begin{definition}
Antisymmetrized product $\odot_{A}$ of operators $\left\{  \left.  A_{j}%
\in\mathcal{B}\left(  E\right)  \right\vert 1\leq j\leq n\right\}  $
\begin{equation}
A_{1}\odot_{A}\cdots\odot_{A}A_{n}=\frac{1}{n!}\sum_{\sigma\in S_{n}}%
\pi\left(  \sigma\right)  A_{\sigma\left(  1\right)  }\cdots A_{\sigma\left(
n\right)  }.
\end{equation}

\end{definition}
\end{remark}

\begin{remark}%
\begin{equation}
\left(  A_{1}\odot_{S}A_{2}\odot_{S}A_{3}\right)  ^{t}=A_{3}^{t}\odot_{S}%
A_{2}^{t}\odot_{S}A_{1}^{t}=A_{1}^{t}\odot_{S}A_{2}^{t}\odot_{S}A_{3}^{t}%
\end{equation}
If $A=A^{t}$ then
\begin{equation}
\left(  A_{1}\odot_{S}A_{2}\odot_{S}A_{3}\right)  ^{t}=A_{1}\odot_{S}%
A_{2}\odot_{S}A_{3}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  A_{1}\odot_{S}A_{2}\odot_{S}A_{3}\right)  ^{\dagger}=A_{3}^{\dagger
}\odot_{S}A_{2}^{\dagger}\odot_{S}A_{1}^{\dagger}=A_{1}^{\dagger}\odot
_{S}A_{2}^{\dagger}\odot_{S}A_{3}^{\dagger}%
\end{equation}
If $A=A^{\dagger}$ then
\begin{equation}
\left(  A_{1}\odot_{S}A_{2}\odot_{S}A_{3}\right)  ^{\dagger}=A_{1}\odot
_{S}A_{2}\odot_{S}A_{3}%
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
\Xi_{\left\vert EE\right\rangle }:%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
E\rightarrow\mathcal{B}\left(  E\right)  ,\quad\Xi_{\left\vert EE\right\rangle
}\in\mathcal{B}\left(
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
E,\mathcal{B}\left(  E\right)  \right)  .
\end{equation}


\item
\begin{equation}
\Xi_{\left\vert E\otimes E\right\rangle }:%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
E\rightarrow\mathcal{B}\left(  E\right)  ,\quad\Xi_{\left\vert EE\right\rangle
}\in\mathcal{B}\left(
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
E,\mathcal{B}\left(  E\right)  \right)  .
\end{equation}


\item
\begin{equation}
\Xi_{\left\vert EE\right\rangle }\in\mathcal{B}\left(
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
E,\mathcal{B}\left(  E\right)  \right)  \subset\mathcal{B}\left(
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
E,\mathcal{B}\left(  E\right)  \right)  .
\end{equation}


\item
\begin{align}
g  &  =\sum_{1\leq j<k\leq r}\left\vert e_{j}e_{k}\right\rangle \mathcal{R}%
_{e}\left(  g\right)  _{jk},\quad g\in%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
E\subset%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
E\\
G  &  =\sum_{1\leq j<k\leq r}\left(  \left\vert \overset{}{e_{j}}\right\rangle
\left\langle \overset{}{e_{k}}\right\vert -\left\vert \overset{}{e_{k}%
}\right\rangle \left\langle \overset{}{e_{j}}\right\vert \right)
\mathcal{R}_{e}\left(  G\right)  _{jk},\quad G\in\mathcal{B}_{antisym}\left(
E\right)  \subset\mathcal{B}\left(  E\right)  .
\end{align}


\item
\begin{align}
\Xi_{\left\vert EE\right\rangle }\left(  g\right)   &  =\Xi_{\left\vert
EE\right\rangle }\left(  \sum_{1\leq j<k\leq r}\left\vert e_{j}e_{k}%
\right\rangle \mathcal{R}_{e}\left(  g\right)  _{jk}\right)  =\sum_{1\leq
j<k\leq r}\Xi_{\left\vert EE\right\rangle }\left(  \left\vert e_{j}%
e_{k}\right\rangle \right)  \mathcal{R}_{e}\left(  g\right)  _{jk}\\
&  =\sum_{1\leq j<k\leq r}\left(  \left\vert \overset{}{e_{j}}\right\rangle
\left\langle \overset{}{e_{k}}\right\vert -\left\vert \overset{}{e_{k}%
}\right\rangle \left\langle \overset{}{e_{j}}\right\vert \right)
\mathcal{R}_{e}\left(  g\right)  _{jk}=\sum_{1\leq j<k\leq r}\left(
\left\vert \overset{}{e_{j}}\right\rangle \left\langle \overset{}{e_{k}%
}\right\vert -\left\vert \overset{}{e_{k}}\right\rangle \left\langle
\overset{}{e_{j}}\right\vert \right)  \mathcal{R}_{e}\left(  G\right)  _{jk}\\
&  =\sum_{1\leq j,k\leq r}\left(  \left\vert \overset{}{e_{j}}\right\rangle
\left\langle \overset{}{e_{k}}\right\vert \right)  \mathcal{R}_{e}\left(
G\right)  _{jk}.
\end{align}


\item
\begin{align}
\mathcal{R}_{e}\left(  G\right)  _{jk}  &  =-\mathcal{R}_{e}\left(  G\right)
_{kj}\\
\mathcal{R}_{e}\left(  g\right)  _{jk}  &  =-\mathcal{R}_{e}\left(  g\right)
_{kj}\\
1  &  \leq j,k\leq r.
\end{align}


\item
\begin{align}
\mathcal{R}_{e}\left(  G\right)   &  \in\mathcal{M}_{antisym}\left(
r,r,\mathbb{C}\right)  \subset\mathcal{M}\left(  r,r,\mathbb{C}\right) \\
\mathcal{R}_{e}\left(  g\right)   &  \in\mathcal{M}\left(  1,\binom{r}%
{2},\mathbb{C}\right)  \subset\mathcal{M}\left(  1,r^{2},\mathbb{C}\right)  .
\end{align}

\end{enumerate}
\end{remark}

\begin{remark}%
\begin{align}
g_{1}\wedge g_{2}  &  =\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{1}\right)  \wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{2}\right)  =\frac{1}{2^{2}}\left(  \sqrt{2}\right)  ^{2}\sum_{1\leq
j_{1},j_{2},j_{3},j_{4}\leq4}\left\vert e_{j_{1}}\wedge e_{j_{2}}\wedge
e_{j_{3}}\wedge e_{j_{4}}\right\rangle \mathcal{R}_{e}\left(  g_{1}\right)
_{j_{1}j_{2}}\mathcal{R}_{e}\left(  g\right)  _{j_{3}j_{4}}\\
&  =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq4}\left\vert e_{j_{1}}\wedge
e_{j_{2}}\wedge e_{j_{3}}\wedge e_{j_{4}}\right\rangle \frac{1}{2}\sum
_{\sigma\in DC_{2}^{4}}\left(  \mathcal{R}_{e}\left(  g_{1}\right)
_{j_{\sigma\left(  1\right)  }j_{\sigma\left(  2\right)  }}\mathcal{R}%
_{e}\left(  g_{2}\right)  _{j_{\sigma\left(  3\right)  }j_{\sigma\left(
4\right)  }}\right)  .
\end{align}

\end{remark}

\begin{remark}
\begin{enumerate}
\item
\begin{align}
\Xi_{\left\vert EE\right\rangle }\left(  g_{1}\right)  \otimes\Xi_{\left\vert
EE\right\rangle }\left(  g_{2}\right)   &  =\sum_{1\leq j_{1},k_{1}\leq
r}\left(  \left\vert \overset{}{e_{j_{1}}}\right\rangle \left\langle
\overset{}{e_{k_{1}}}\right\vert \right)  \mathcal{R}_{e}\left(  G_{1}\right)
_{j_{1}k_{1}}\otimes\sum_{1\leq j_{2},k_{2}\leq r}\left(  \left\vert
\overset{}{e_{j_{2}}}\right\rangle \left\langle \overset{}{e_{k_{2}}%
}\right\vert \right)  \mathcal{R}_{e}\left(  G_{2}\right)  _{j_{2}k_{2}}\\
&  =\sum_{1\leq j_{1},k_{1},j_{2},k_{2}\leq r}\left(  \left\vert
\overset{}{e_{j_{1}}}\right\rangle \left\langle \overset{}{e_{k_{1}}%
}\right\vert \otimes\left\vert \overset{}{e_{j_{2}}}\right\rangle \left\langle
\overset{}{e_{k_{2}}}\right\vert \right)  \left(  \mathcal{R}_{e}\left(
G_{1}\right)  _{j_{1}k_{1}}\otimes\mathcal{R}_{e}\left(  G_{2}\right)
_{j_{2}k_{2}}\right) \\
&  =\sum_{1\leq j_{1},k_{1},j_{2},k_{2}\leq r}\left(  \left\vert
\overset{}{e_{j_{1}}}\right\rangle \left\langle \overset{}{e_{k_{1}}%
}\right\vert \otimes\left\vert \overset{}{e_{j_{2}}}\right\rangle \left\langle
\overset{}{e_{k_{2}}}\right\vert \right)  \left(  \mathcal{R}_{e}\left(
G_{1}\right)  \otimes\mathcal{R}_{e}\left(  G_{2}\right)  \right)
_{j_{1}j_{2}k_{1}k_{2}}\\
&  =\sum_{1\leq j_{1},k_{1},j_{2},k_{2}\leq r}\left(  \left\vert
\overset{}{e_{j_{1}}}\right\rangle \left\langle \overset{}{e_{k_{1}}%
}\right\vert \otimes\left\vert \overset{}{e_{j_{2}}}\right\rangle \left\langle
\overset{}{e_{k_{2}}}\right\vert \right)  \mathcal{R}_{e}\left(  G_{1}\otimes
G_{2}\right)  _{j_{1}j_{2}k_{1}k_{2}}\\
&  =\sum_{1\leq j_{1},k_{1},j_{2},k_{2}\leq r}\left\vert \overset{}{e_{j_{1}}%
}\otimes e_{j_{2}}\right\rangle \left\langle \overset{}{e_{k_{1}}}\otimes
e_{k_{2}}\right\vert \mathcal{R}_{e}\left(  G_{1}\otimes G_{2}\right)
_{j_{1}j_{2}k_{1}k_{2}}.
\end{align}


\item
\begin{equation}
\Xi_{\left\vert EE\right\rangle }\left(  g_{1}\right)  \otimes\Xi_{\left\vert
EE\right\rangle }\left(  g_{2}\right)  =\left(  \Xi_{\left\vert
EE\right\rangle }\otimes\Xi_{\left\vert EE\right\rangle }\right)  \left(
g_{1}\wedge g_{2}\right)  =\left(  \Xi_{\left\vert EE\right\rangle }\otimes
\Xi_{\left\vert EE\right\rangle }\right)  \left(  \mathcal{A}_{4}\left(
g_{1}\otimes g_{2}\right)  \right)  \in\mathcal{B}\left(  E\otimes E\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{A}_{2}g=g.
\end{equation}


\item
\begin{equation}
\mathcal{A}_{4}\left(  \mathcal{A}_{2}g_{1}\otimes\mathcal{A}_{2}g_{2}\right)
=\sum_{\sigma\in S_{4}\left/  \left(  S_{2}\times S_{2}\right)  \right.  }%
\pi\left(  \sigma\right)  g_{1\sigma\left(  1\right)  \sigma\left(  2\right)
}g_{1\sigma\left(  3\right)  \sigma\left(  4\right)  }e_{\sigma\left(
1\right)  }\otimes e_{\sigma\left(  2\right)  }\otimes e_{\sigma\left(
3\right)  }\otimes e_{\sigma\left(  4\right)  }.
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
Let $G_{j}=\Xi_{\left\vert EE\right\rangle }\left(  g_{j}\right)  ,\,1\leq
j\leq2$ then
\begin{equation}
\left(  G_{1}G_{2}\right)  ^{t}=G_{2}G_{1}\neq G_{1}G_{2}.
\end{equation}

\end{remark}

