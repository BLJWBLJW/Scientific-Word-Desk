\right\rangle \left\langle c_{2}\right\vert \left(  \mathcal{R}_{c}\left(
u\right)  _{12}\overline{\mathcal{R}_{c}\left(  u\right)  _{22}}%
-\mathcal{R}_{c}\left(  u\right)  _{22}\overline{\mathcal{R}_{c}\left(
u\right)  _{12}}\right)  \\
\parallel\\
\left\vert c_{1}\right\rangle \left\langle c_{1}\right\vert
2i\operatorname{Im}\left(  \mathcal{R}_{c}\left(  u\right)  _{11}%
\overline{\mathcal{R}_{c}\left(  u\right)  _{21}}\right)  +\left\vert
c_{1}\right\rangle \left\langle c_{2}\right\vert \left(  \mathcal{R}%
_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(  u\right)  _{22}%
}-\mathcal{R}_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(
u\right)  _{11}}\right)  \\
+\left\vert c_{2}\right\rangle \left\langle c_{1}\right\vert \left(
