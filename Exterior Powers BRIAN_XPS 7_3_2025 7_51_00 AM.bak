\begin{remark}%
\begin{equation}
g_{1}\wedge\cdots\wedge g_{m}\in%
%TCIMACRO{\tbigwedge \nolimits^{2m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2m}}
%EndExpansion
V.
\end{equation}

\end{remark}

\begin{definition}
Now fix a basis vector $a$ of $%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
V$ , where $\dim\left\{  V\right\}  =n$ $=2m$ and set
\begin{equation}
g_{1}\wedge\cdots\wedge g_{m}=\mathcal{\Xi}_{\left\vert VV\right\rangle }%
^{-1}\left(  G_{1}\right)  \wedge\cdots\wedge\mathcal{\Xi}_{\left\vert
VV\right\rangle }^{-1}\left(  G_{m}\right)  =\frac{1}{\left\Vert a\right\Vert
^{2}}\operatorname{Pf}\left(  \left\{  G_{1},\cdots,G_{m}\right\}  \right)
a\equiv\frac{1}{\left\Vert a\right\Vert ^{2}}\operatorname{Pf}\left(  \left\{
g_{1},\cdots,g_{m}\right\}  \right)  a.
\end{equation}
The scalar $\operatorname{Pf}\left(  \left\{  G_{1},\cdots,G_{m}\right\}
\right)  $ is called the Pfaffian of the operators $\left\{  G_{1}%
,\cdots,G_{m}\right\}  $. Since every two elements $\left\{  g_{j}%
,g_{k}\right\}  $ commute, it follows that
\begin{equation}
\operatorname{Pf}:\overset{m}{\overbrace{%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\times\cdots\times%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V}\,\,}\rightarrow\mathbb{C}%
\end{equation}
is a \emph{symmetric} $m$-linear function.
\end{definition}

\begin{definition}
The Pfaffian of a single skew transformation $G$ is
\begin{equation}
\operatorname{Pf}\left(  G\right)  =\frac{1}{m!}\operatorname{Pf}\left(
\overset{m}{\overbrace{G,\cdots,G}}\right)
\end{equation}
and can expressed as
\begin{equation}
\operatorname{Pf}\left(  G\right)  =\left\langle \left.  \Xi_{\left\vert
VV\right\rangle }^{-1}\left(  G\right)  ^{m}\right\vert a\right\rangle ,\quad
a\in%
%TCIMACRO{\tbigwedge \nolimits^{2m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2m}}
%EndExpansion
V.
\end{equation}

\end{definition}

\begin{proposition}
1:If $\mathfrak{\tau}$ is an isometry of $V$, then
\begin{equation}
\operatorname{Pf}\left(  \mathfrak{\tau}G_{1}\mathfrak{\tau}^{-1}%
,\cdots,\mathfrak{\tau}G_{n}\mathfrak{\tau}^{-1}\right)  =\det\left(
\mathfrak{\tau}\right)  \operatorname{Pf}\left(  G_{1},\cdots,G_{n}\right)
\end{equation}

\end{proposition}

\begin{proposition}
2:Let $a$ and $b$ be basis vectors of $V$. Then%
\begin{equation}
\operatorname{Pf}_{a}\left(  G\right)  \operatorname{Pf}_{b}\left(  G\right)
=\left\langle \left.  a\right\vert b\right\rangle \det\left(  G\right)  .
\end{equation}

\end{proposition}

\begin{corollary}%
\begin{equation}
\operatorname{Pf}_{a}\left(  G\right)  ^{2}=\left\Vert a\right\Vert ^{2}%
\det\left(  G\right)  .
\end{equation}

\end{corollary}

\subsubsection{Direct Sums}

Let $E$ and $F$ be inner product spaces. Then an inner product is induced in
the direct sum $E\oplus F$ by%
\begin{equation}
\left\langle \left.  x_{1}\oplus y_{1}\right\vert x_{2}\oplus y_{2}%
\right\rangle =\left\langle \left.  x_{1}\right\vert y_{1}\right\rangle
+\left\langle \left.  x_{2}\right\vert y_{2}\right\rangle
\end{equation}


Let the maps%

\begin{align}
i_{E}  &  :E\rightarrow E\oplus F\\
i_{F}  &  :F\rightarrow E\oplus F
\end{align}
and
\begin{align}
\pi_{E}  &  :E\oplus F\rightarrow E\\
\pi_{F}  &  :E\oplus F\rightarrow F
\end{align}
denote the natural inclusions and projections.

\begin{proposition}
3:Let $E$ and $F$ be inner product spaces of dimensions $2p$ and $2q$
respectively, choose basis vectors $a$ and $b$ for ${\LARGE \wedge}^{2p}E$ and
${\LARGE \wedge}^{2q}F$ then
\begin{equation}
\operatorname{Pf}_{a\oplus b}\left(  G_{E}\oplus G_{F}\right)
=\operatorname{Pf}_{a}\left(  G_{E}\right)  \operatorname{Pf}_{b}\left(
G_{F}\right)  ,\quad G_{E}\in\mathcal{B}_{as}\left(  E\right)  ,G_{F}%
\in\mathcal{B}_{as}\left(  F\right)  .
\end{equation}

\end{proposition}

\subsubsection{ Euclidean Spaces}

\begin{definition}
A \emph{Euclidean }vector space is a finite-dimensional inner product space
over the real numbers.
\end{definition}

\begin{definition}
An Affine space $A$ is a set $\left\{  A\right\}  $ together with a vector
space $A$ and a transitive and free action of the additive group
$A_{\boldsymbol{+}}$ of $A$ on the set $\left\{  A\right\}  $. The elements of
the affine space $A$ are called points. The vector space $A$ is said to be
associated to the affine space, and its elements are called vectors,
translations, or sometimes free vectors.
\end{definition}

\begin{definition}
Let $V$ be a finite dimensional real vector space and let $\mathbf{b}_{1}$ and
$\mathbf{b}_{2}$ be two ordered bases for $V$. It is a standard result in
linear algebra that there exists a unique linear transformation
$A:V\rightarrow V$ that takes $\mathbf{b}_{1}$ to $\mathbf{b}_{2}$. The bases
$\mathbf{b}_{1}$ and $\mathbf{b}_{2}$ are said to have the same
\emph{orientation} (or be consistently oriented) if $A$ has a positive
determinant; otherwise they have opposite orientations. The property of having
the same orientation defines an equivalence relation on the set of all ordered
bases for $V$. If $V$ is non-zero, there are precisely two equivalence classes
determined by this relation. An orientation on $V$ is an assignment of $+1$ to
one equivalence class and $-1$ to the other.
\end{definition}

Let $E$ be an oriented Euclidean space of dimension $n=2m$ and let $e$ be the
unique unit vector in ${\LARGE \wedge}^{2m}E$ which represents the
orientation. Then we set the value of the Pfaffian of the skew linear
transformations $\left\{  \left.  G_{j}\right\vert 1\leq j\leq n\right\}  $%
\begin{equation}
\operatorname{Pf}_{e}\left(  \left\{  G_{1},\cdots,G_{m}\right\}  \right)
=\left\langle \left.  e\right\vert \Xi_{\left\vert EE\right\rangle }%
^{-1}\left(  G_{1}\right)  \wedge\cdots\wedge\Xi_{\left\vert EE\right\rangle
}^{-1}\left(  G_{m}\right)  \right\rangle ;\quad G_{j}\in\mathcal{B}%
_{asa}\left(  E\right)  ,1\leq j\leq m
\end{equation}
and in particular
\begin{equation}
\operatorname{Pf}_{e}\left(  G\right)  =\frac{1}{m!}\operatorname{Pf}%
_{e}\left(  \left\{  \overset{m}{\overbrace{G,\cdots,G}}\right\}  \right)
=\left\langle \left.  \overset{}{e}\right\vert \Xi_{\left\vert EE\right\rangle
}^{-1}\left(  G\right)  \wedge\cdots\wedge\Xi_{\left\vert EE\right\rangle
}^{-1}\left(  G\right)  \right\rangle ;\quad G\in\mathcal{B}_{asa}\left(
E\right)  .
\end{equation}


Observe that if the orientation of $E$ is reversed then $\operatorname{Pf}%
_{e}$ is changed to $-\operatorname{Pf}_{e}$.

\begin{remark}
The Pfaffian is invariant under proper rotations.
\end{remark}

\begin{remark}
The square of the Pfaffian of a linear transformation is the determinant of
the linear tansformation i.e.
\begin{equation}
\operatorname{Pf}_{e}\left(  G\right)  ^{2}=\det\left(  G\right)  ;\quad
G\in\mathcal{B}_{as}\left(  E\right)  .
\end{equation}

\end{remark}

\begin{remark}
The Pfaffian of a direct sum is the products of the Pfaffians of the operators
in the direct sum i.e
\begin{equation}
\operatorname{Pf}_{e\oplus e}\left(  G_{1}\oplus G_{2}\right)
=\operatorname{Pf}_{e}\left(  G_{1}\right)  \operatorname{Pf}_{e}\left(
G_{2}\right)  ,\quad G_{1},G_{2}\in\mathcal{B}_{asa}\left(  E\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \overset{\bigtriangleup
}{=}\sqrt{2}\left\vert \varphi_{j_{1}}\wedge\varphi_{j_{2}}\right\rangle ,
\end{equation}
The cononical form of a geminal $g_{k}\in%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
E$ is
\begin{equation}
g_{k}=\sqrt{2}\sum_{1\leq j\leq r}\left\vert e_{kj}\wedge e_{kj+r}%
\right\rangle \lambda_{jk}=\sum_{1\leq j\leq r}\left\vert e_{kj}%
e_{kj+r}\right\rangle \lambda_{kj},\,\lambda_{kj}\in\mathbb{R}_{\boldsymbol{+}%
},1\leq j\leq r.
\end{equation}
The isometric real vector space isomorphism
\begin{equation}
\Xi_{\left\vert EE\right\rangle }^{-1}:\mathcal{B}_{asa}\left(  E\right)
\rightarrow%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
E
\end{equation}
is given by
\begin{equation}
\Xi_{\left\vert EE\right\rangle }^{-1}\left(  \sum_{1\leq j,k\leq2r}%
g_{jk}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
\right)  \right)  =\sum_{1\leq j<k\leq2r}g_{jk}\left\vert e_{j}e_{k}%
\right\rangle ,
\end{equation}
so that
\begin{align}
\Xi_{\left\vert EE\right\rangle }\left(  g_{k}\right)   &  =G_{k}\\
\Xi_{\left\vert EE\right\rangle }^{-1}\left(  G_{k}\right)   &  =g_{k}.
\end{align}

\end{remark}

\begin{remark}
Let $\left\{  \mathbf{e}_{k}\right\}  $ be canonical bases for $\left\{
g_{k}\right\}  $ then
\begin{equation}
\mathcal{R}_{e}\left(  \Xi_{\left\vert EE\right\rangle }\left(  g_{k}\right)
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \mathbf{\lambda}_{k}\\
-\mathbf{\lambda}_{k} & \mathbb{O}_{r}%
\end{array}
\right)  =\mathcal{R}_{e}\left(  G_{k}\right)  .
\end{equation}
By definition
\begin{equation}
g_{1}\wedge\cdots\wedge g_{n}=\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{1}\right)  \wedge\cdots\wedge\Xi_{\left\vert EE\right\rangle }^{-1}\left(
G_{n}\right)  =\operatorname{Pf}\left(  \left\{  G_{1},\cdots,G_{n}\right\}
\right)  e\equiv\operatorname{Pf}\left(  \left\{  g_{1},\cdots,g_{n}\right\}
\right)  e,
\end{equation}
where
\begin{equation}
e=\left\vert e_{1}\cdots e_{n}\right\rangle
\end{equation}
gives
\begin{align}
g_{1}\wedge\cdots\wedge g_{n}  &  =\Xi_{\left\vert EE\right\rangle }%
^{-1}\left(  G_{1}\right)  \wedge\cdots\wedge\Xi_{\left\vert EE\right\rangle
}^{-1}\left(  G_{n}\right)  =\left(  \sqrt{2}\right)  ^{n}\sum_{1\leq
j_{1}\leq r}\left\vert e_{1j_{1}}\wedge e_{1j_{1}+r}\right\rangle
\lambda_{j_{1}1}\wedge\cdots\wedge\sum_{1\leq j_{n}\leq r}\left\vert
e_{nj_{n}}\wedge e_{nj_{n}+r}\right\rangle \lambda_{j_{n}n}\\
&  =\left(  \sqrt{2}\right)  ^{n}\sum_{1\leq j_{1}\leq r}\left\vert e_{1j_{1}%
}\wedge e_{1j_{1}+r}\right\rangle \wedge\cdots\wedge\sum_{1\leq j_{n}\leq
r}\left\vert e_{nj_{n}}\wedge e_{nj_{n}+r}\right\rangle \lambda_{j_{1}1}%
\cdots\lambda_{j_{n}n}\\
&  =\left(  \sqrt{2}\right)  ^{n}\sum_{1\leq j_{1},\cdots,,j_{n}\leq
r}\left\vert e_{1j_{1}}\wedge e_{1j_{1}+r}\wedge\cdots\wedge e_{nj_{n}}\wedge
e_{nj_{n}+r}\right\rangle \lambda_{j_{1}1}\cdots\lambda_{j_{n}n}\\
&  =\left(  \sqrt{2}\right)  ^{n}\sum_{1\leq j_{1}<\cdots<j_{n}\leq
r}\left\vert e_{1j_{1}}\wedge e_{1j_{1}+r}\wedge\cdots\wedge e_{nj_{n}}\wedge
e_{nj_{n}+r}\right\rangle \operatorname{Pf}\left(  \lambda_{j_{1}1}%
,\cdots,\lambda_{j_{n}n}\right)  .
\end{align}

\end{remark}

