\item In terms of the full tensor product basis
\begin{align}
\mathcal{R}_{e}^{\otimes}\left(  \mathcal{A}_{2}\right)  _{k_{1}k_{2}%
j_{1}j_{2}}  &  =\left\langle e_{k_{1}}\otimes e_{k_{2}}\left\vert \frac{1}%
{2}\sum_{\sigma\in S_{2}}\pi\left(  \sigma\right)  P_{\sigma}\right.
e_{j_{1}}\otimes e_{j_{2}}\right\rangle =\left\langle e_{k_{1}}\otimes
e_{k_{2}}\left\vert \frac{1}{2}\sum_{\sigma\in S_{2}}\pi\left(  \sigma\right)
\right.  e_{j_{\sigma\left(  1\right)  }}\otimes e_{j_{\sigma\left(  2\right)
}}\right\rangle \\
&  =\left\langle e_{k_{1}}\otimes e_{k_{2}}\left\vert \frac{1}{2}\left(
e_{j_{1}}\otimes e_{j_{2}}-e_{j_{2}}\otimes e_{j_{1}}\right)  \right.
\right\rangle =\frac{1}{2}\left(  \delta_{k_{1}j_{1}}\delta_{k_{2}j_{2}%
}-\delta_{k_{1}j_{2}}\delta_{k_{2}j_{1}}\right)  ,\quad1\leq k_{1},k_{2}%
,j_{1},j_{2}\leq3
\end{align}
which gives

