j_{3}j_{4}\right)  \right\}  \right)  \wedge\left(  \sum_{1\leq j_{1}%
<j_{2}<j_{3}\leq2r}e_{j_{1}}\wedge e_{j_{2}}\wedge e_{j_{3}}\operatorname{Pf}%
