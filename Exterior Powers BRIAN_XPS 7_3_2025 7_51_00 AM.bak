\rightarrow\mathcal{B}_{asym}\left(  \mathcal{H}^{1}\right) \\
\overset{\backsim}{u}  &  :\mathcal{B}_{sym}\left(  \mathcal{H}^{1}\right)
\rightarrow\mathcal{B}_{sym}\left(  \mathcal{H}^{1}\right)  .
\end{align}

\end{enumerate}
\end{remark}

