\mathbf{e\otimes e}\right\rangle \mathcal{R}_{f}^{\otimes}\left(
\mathcal{A}_{2}\right)  \mathcal{R}_{e}^{\otimes}\left(  g\right)
\end{equation}


\item
\begin{equation}
\left\vert \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right\rangle \left\langle \overset{}{\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert }\right\vert
G=\left\vert \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right\rangle \left\langle \overset{}{\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert }\right\vert
\Upsilon\left(  g\right)  =\left\vert \overset{}{\left\vert \mathbf{e}%
\right\rangle \left\langle \mathbf{e}\right\vert }\right\rangle \mathcal{R}%
_{e}^{\otimes}\left(  \Upsilon\left(  g\right)  \right)
\end{equation}

\end{enumerate}

\begin{lemma}
$\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ can be expressed as the complex
direct sum
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  =\mathcal{B}_{asym}\left(
\mathcal{H}^{1}\right)  \underset{\mathbb{C}}{\oplus}\mathcal{B}_{sym}\left(
\mathcal{H}^{1}\right)  .
\end{equation}

\end{lemma}

\begin{remark}%
\begin{equation}
uv_{1}\otimes uv_{2}=\left(  u\otimes u\right)  \left(  v_{1}\otimes
v_{2}\right)  .
\end{equation}

\end{remark}

\begin{definition}%
\begin{align}
\overset{\wedge}{u}\left(  X\right)   &  =uXu^{\dagger},\quad\overset{\wedge
}{u}\,\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right)
\\
\overset{\backsim}{u}\left(  X\right)   &  =uXu^{t},\quad\overset{\backsim
}{u}\,\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right)
\\
\overset{\#}{u}\left(  X\right)   &  =uXu,\quad\overset{\#}{u}\,\in
\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right)  .
\end{align}

\end{definition}

\begin{remark}%
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  =\mathcal{B}_{sa}\left(
\mathcal{H}^{1}\right)  \underset{\mathbb{R}}{\oplus}\mathcal{B}_{asa}\left(
\mathcal{H}^{1}\right)  .
\end{equation}

\end{remark}

