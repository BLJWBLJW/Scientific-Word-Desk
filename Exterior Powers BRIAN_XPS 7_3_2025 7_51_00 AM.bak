\item Using the resolution of identities $\left\vert \overset{}{\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert }\right\rangle
\left\langle \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right\vert $ and $\left\vert \overset{}{\left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert }\right\rangle
\left\langle \overset{}{\left\vert \mathbf{f}\right\rangle \left\langle
\mathbf{f}\right\vert }\right\vert $ an operator $\left\vert A\right\rangle $
can be expanded as a \emph{vector} as
\begin{equation}
\left\vert A\right\rangle =\left\vert \overset{}{\left\vert \mathbf{e}%
\right\rangle \left\langle \mathbf{e}\right\vert }\right\rangle \left(
\left\langle \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right\vert \left\vert \overset{}{A}\right\rangle
\right)  =\left\vert \overset{}{\left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{f}\right\vert }\right\rangle \left(  \left\langle
\overset{}{\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}%
\right\vert }\right\vert \left\vert \overset{}{A}\right\rangle \right)  .
\end{equation}


\item Using the resolution of identities $\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert $ and $\left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{f}\right\vert $ an operator $A$ can be expanded as a
vector as%
\begin{equation}
A=\left(  \left\vert \overset{}{\mathbf{e}}\right\rangle \left\langle
\overset{}{\mathbf{e}}\right\vert \right)  A\left(  \left\vert
\overset{}{\mathbf{e}}\right\rangle \left\langle \overset{}{\mathbf{e}%
}\right\vert \right)  =\left\vert \overset{}{\mathbf{e}}\right\rangle
\left\langle \left.  \overset{}{\mathbf{e}}\right\vert A\mathbf{e}%
\right\rangle \left\langle \overset{}{\mathbf{e}}\right\vert =\left(
\left\vert \overset{}{\mathbf{f}}\right\rangle \left\langle
\overset{}{\mathbf{f}}\right\vert \right)  A\left(  \left\vert
\overset{}{\mathbf{f}}\right\rangle \left\langle \overset{}{\mathbf{f}%
}\right\vert \right)  =\left\vert \overset{}{\mathbf{f}}\right\rangle
\left\langle \left.  \overset{}{\mathbf{f}}\right\vert A\mathbf{f}%
\right\rangle \left\langle \overset{}{\mathbf{f}}\right\vert .
\end{equation}


\item Change of basis of $V$ induces change of basis of $\mathcal{B}\left(
V\right)  $ and $\mathcal{B}_{asa}\left(  V\right)  $
\begin{gather}
\Xi_{VV^{d}}\left(  g\right)  =\sum_{1\leq j_{1},j_{2}\leq2r}\left\vert
e_{j_{1}}\right\rangle \left\langle e_{j_{2}}\right\vert \mathcal{R}%
_{e}\left(  g\right)  _{j_{1}j_{2}}=\sum_{1\leq j_{1},j_{2}\leq2r}\frac{1}%
{2}\left(  \left\vert e_{j_{1}}\right\rangle \left\langle e_{j_{2}}\right\vert
-\left\vert e_{j_{2}}\right\rangle \left\langle e_{j_{1}}\right\vert \right)
\mathcal{R}_{e}\left(  g\right)  _{j_{1}j_{2}}\\
=\sum_{1\leq j_{1},j_{2}\leq2r}\frac{1}{2}\left(  \left\vert f_{j_{1}%
}\right\rangle \left\langle f_{j_{2}}\right\vert -\left\vert f_{j_{2}%
}\right\rangle \left\langle f_{j_{1}}\right\vert \right)  \left(
\mathcal{R}_{e}\left(  u\right)  ^{\dagger}\mathcal{R}_{e}\left(  g\right)
\mathcal{R}_{e}\left(  u\right)  \right)  _{j_{1}j_{2}}=\sum_{1\leq
j_{1},j_{2}\leq2r}\left\vert f_{j_{1}}\right\rangle \left\langle f_{j_{2}%
}\right\vert \mathcal{R}_{f}\left(  g\right)  _{j_{1}j_{2}}.
\end{gather}


\item Change of basis of $V$ produces the change of basis of $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$
\begin{align}
\Xi_{VV^{d}}\left(  g\right)   &  =\Xi_{VV^{d}}\left(  \sum_{1\leq j_{1}%
<j_{2}\leq2r}\left\vert f_{j_{1}}f_{j_{2}}\right\rangle \mathcal{R}_{f}\left(
g\right)  _{j_{1}j_{2}}\right)  =\Xi_{VV^{d}}\left(  \frac{1}{2}\sum_{1\leq
j_{1},j_{2}\leq2r}\left\vert f_{j_{1}}f_{j_{2}}\right\rangle \mathcal{R}%
_{f}\left(  g\right)  _{j_{1}j_{2}}\right) \\
&  =\Xi_{VV^{d}}\left(  \frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq2r}\left\vert
f_{j_{1}}f_{j_{2}}\right\rangle \left(  \mathcal{R}_{e}\left(  u\right)
^{t}\mathcal{R}_{e}\left(  g\right)  \mathcal{R}_{e}\left(  u\right)  \right)
_{j_{1}j_{2}}\right) \\
&  =\sum_{1\leq j_{1},j_{2}\leq2r}\frac{1}{2}\left(  \left\vert f_{j_{1}%
}\right\rangle \left\langle f_{j_{2}}\right\vert -\left\vert f_{j_{2}%
}\right\rangle \left\langle f_{j_{1}}\right\vert \right)  \left(
\mathcal{R}_{e}\left(  u\right)  ^{t}\mathcal{R}_{e}\left(  g\right)
\mathcal{R}_{e}\left(  u\right)  \right)  _{j_{1}j_{2}}=\sum_{1\leq
j_{1},j_{2}\leq2r}\left\vert f_{j_{1}}\right\rangle \left\langle f_{j_{2}%
}\right\vert \left(  \mathcal{R}_{e}\left(  u\right)  ^{t}\mathcal{R}%
_{e}\left(  g\right)  \mathcal{R}_{e}\left(  u\right)  \right)  _{j_{1}j_{2}}%
\end{align}


\item The action of the unitary group $U\left(  2r\right)  $ on $\mathcal{B}%
\left(  V\right)  $ and $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$ produces different representations
\begin{equation}
\sum_{1\leq j_{1},j_{2}\leq2r}\frac{1}{2}\left(  \left\vert f_{j_{1}%
}\right\rangle \left\langle f_{j_{2}}\right\vert -\left\vert f_{j_{2}%
}\right\rangle \left\langle f_{j_{1}}\right\vert \right)  \left(
\mathcal{R}_{e}\left(  u\right)  ^{\dagger}\mathcal{R}_{e}\left(  g\right)
\mathcal{R}_{e}\left(  u\right)  \right)  _{j_{1}j_{2}}\neq\sum_{1\leq
j_{1},j_{2}\leq2r}\frac{1}{2}\left(  \left\vert f_{j_{1}}\right\rangle
\left\langle f_{j_{2}}\right\vert -\left\vert f_{j_{2}}\right\rangle
\left\langle f_{j_{1}}\right\vert \right)  \left(  \mathcal{R}_{e}\left(
u\right)  ^{t}\mathcal{R}_{e}\left(  g\right)  \mathcal{R}_{e}\left(
u\right)  \right)  _{j_{1}j_{2}},
\end{equation}
i.e.%
\begin{equation}
\Xi_{VV^{d}}\left(  \left(  \overset{}{u\boxtimes u}\right)  \left(  g\right)
\right)  \neq\widehat{u}\left(  \overset{}{\Xi_{VV^{d}}\left(  g\right)
}\right)  ,\quad u\in U\left(  2r\right)  .
\end{equation}


\item However%
\begin{equation}
\Xi_{VV^{d}}\left(  \left(  \overset{}{o\boxtimes o}\right)  \left(  g\right)
\right)  =\widehat{o}\left(  \overset{}{\Xi_{VV^{d}}\left(  g\right)
}\right)  ,\quad o\in O\left(  2r,\mathbb{R}\right)  .
\end{equation}

\end{enumerate}

\begin{definition}
Real vector space of self adjoint operators
\begin{equation}
\mathcal{B}_{sa}\left(  V\right)  =\mathbb{R}\text{-}\operatorname*{linspan}%
\left\{  \left.  A\right\vert A=A^{\dagger}\right\}  .
\end{equation}

\end{definition}

\begin{definition}
Real vector space of anti self adjoint operators
\begin{equation}
\mathcal{B}_{asa}\left(  V\right)  =\mathbb{R}\text{-}\operatorname*{linspan}%
\left\{  \left.  A\right\vert A=-A^{\dagger}\right\}  .
\end{equation}

\end{definition}

\begin{definition}
Complex vector space of symmetric operators
\begin{equation}
\mathcal{B}_{sym}\left(  V\right)  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  A\right\vert A=A^{t}\right\}  .
\end{equation}

\end{definition}

\begin{definition}
Complex vector space of anti symmetric operators
\begin{equation}
\mathcal{B}_{antisym}\left(  V\right)  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  A\right\vert A=-A^{t}\right\}  .
\end{equation}

\end{definition}

\begin{remark}
Spectral expansion of self adjoint operators
\begin{equation}
A=A^{\dagger}\Rightarrow A=\int_{x\in\mathbb{R}}xdP_{\left\langle
A\right\rangle }\left(  x\right)  .
\end{equation}
In the discrete case
\begin{equation}
A=A^{\dagger}\in\mathcal{B}_{0sa}\left(  V\right)  \Rightarrow A=\sum_{1\leq
j\leq r}\lambda_{j}\left\vert f_{j}\right\rangle \left\langle f_{j}\right\vert
,\quad\lambda_{j}\in\mathbb{R}.
\end{equation}

\end{remark}

\begin{remark}
Spectral expansion of anti self adjoint operators
\begin{equation}
A=-A^{\dagger}\Rightarrow A=\int_{x\in\mathbb{R}}ixdP_{\left\langle
A\right\rangle }\left(  x\right)  .
\end{equation}
In the discrete case
\begin{equation}
A=-A^{\dagger}\in\mathcal{B}_{0asa}\left(  V\right)  \Rightarrow A=\sum_{1\leq
j\leq r}i\lambda_{j}\left\vert f_{j}\right\rangle \left\langle f_{j}%
\right\vert ,\quad\lambda_{j}\in\mathbb{R}.
\end{equation}

\end{remark}

\begin{remark}
Spectral expansion of normal symmetric operators. In the discrete case
\begin{equation}
A=A^{t}\Rightarrow A=\int_{z\in\mathbb{C}}zdP_{\left(  A\right)  }\left(
z\right)  .
\end{equation}
In the discrete case%
\begin{equation}
A=A^{t}\in\mathcal{B}_{0antisym}\left(  V\right)  \Rightarrow A=\sum_{1\leq
j\leq r}z_{j}\left\vert f_{j}\right)  \left(  f_{j}\right\vert ,\quad z_{j}%
\in\mathbb{C}.
\end{equation}

\end{remark}

\begin{remark}
Spectral expansion of normal anti symmetric operators
\begin{equation}
A=-A^{t}\Rightarrow A=\int_{z\in\mathbb{C}}z\left\{  dP_{\left(  A\right)
}\left(  z\right)  -dP_{\left(  A\right)  }\left(  -z\right)  \right\}  .
\end{equation}
In the discrete case
\begin{equation}
A=-A^{t}\in\mathcal{B}_{0antisym}\left(  V\right)  \Rightarrow A=\sum_{1\leq
j\leq p\leq r}z_{j}\left\{  \left\vert f_{j}\right)  \left(  f_{j}\right\vert
-\left\vert f_{j+p}\right)  \left(  f_{j+p}\right\vert \right\}  ,\quad
z_{j}\in\mathbb{C}.
\end{equation}

\end{remark}

\begin{lemma}
If $A\neq0\in\mathcal{B}_{asa}\left(  V\right)  $ or $\mathcal{B}_{sa}\left(
V\right)  $%
\begin{equation}
\operatorname{Tr}\left\{  A^{\dagger}A\right\}  >0.
\end{equation}

\end{lemma}

\begin{proof}
For $A\neq0\in\mathcal{B}_{asa}\left(  V\right)  $ or $\mathcal{B}_{sa}\left(
V\right)  $%
\begin{equation}
\operatorname{Tr}\left\{  A^{\dagger}A\right\}  =\int_{x\in\mathbb{R}}%
x^{2}dP_{A}\left(  x\right)  =\int_{x\in\mathbb{R}}-i^{2}x^{2}dP_{A}\left(
x\right)  >0.
\end{equation}

\end{proof}

\begin{lemma}
If $A\in\mathcal{B}_{antisym}\left(  V\right)  $ then
\begin{equation}
\operatorname{Tr}\left\{  A\right\}  =0.
\end{equation}

\end{lemma}

\begin{remark}
\begin{enumerate}
\item Complex vector space
\begin{equation}
V=\mathbb{C}-\operatorname*{linspan}\left\{  \left\vert e_{1}\right\rangle
,\cdots,\left\vert e_{r}\right\rangle \right\}  =\mathbb{C}%
-\operatorname*{linspan}\left\{  \left.  \left\vert e_{j}\right\rangle
\right\vert 1\leq j\leq r\right\}  .
\end{equation}


\item Nuclear operators acting in $V$%
\begin{equation}
\mathcal{B}_{00}\left(  V\right)  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
\right\vert 1\leq j,k\leq r\right\}  .
\end{equation}


\item The operators $\left\{  \left.  \left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert \right\vert 1\leq j,k\leq r\right\}  $ are
partial isometries%
\begin{equation}
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert ^{\dagger
}\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert =\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert =\left\vert e_{k}\right\rangle \left\langle
e_{k}\right\vert .
\end{equation}


\item
\begin{equation}
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert
e_{l}\right\rangle \left\langle e_{m}\right\vert =\left\vert e_{j}%
\right\rangle \left\langle e_{m}\right\vert \delta_{kl},\quad1\leq j,k,l,m\leq
r
\end{equation}


\item $\mathcal{B}_{00}\left(  V\right)  $ can be generated by self adjoint
and anti self adjoint bases
\begin{equation}
\mathcal{B}_{00}\left(  V\right)  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left\{  \left.  \left(  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert +\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  ,\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
\right\vert 1\leq j<k\leq r\right\}  ,\left\{  \left.  \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert \right\vert 1\leq j\leq
r\right\}  \right\}  .
\end{equation}


\item The operators
\begin{equation}
\left\{  \left\{  \left.  \left(  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert +\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  ,\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
\right\vert 1\leq j\leq k\leq r\right\}  ,\left\{  \left.  \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert \right\vert 1\leq j\leq
r\right\}  \right\}
\end{equation}
are partial isometries as%
\begin{gather}
\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
+\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
^{\dagger}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
+\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  =\left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \left(  \left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \right)  =\left(  \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{k}\right\vert \right) \\
\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
^{\dagger}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
=-\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert -\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  =-\left(
-\left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert -\left\vert
e_{k}\right\rangle \left\langle e_{k}\right\vert \right)  =\left(  \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{k}\right\vert \right)  .
\end{gather}


\begin{enumerate}
\item
\begin{equation}
\mathcal{B}_{00sa}\left(  V\right)  \cong\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\{  \left.  \left(  \left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \right)  \right\vert 1\leq j<k\leq
r\right\}  ,\left\{  \left.  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right\vert 1\leq j\leq r\right\}  \right\}  \equiv
\mathcal{B}_{sa}\left(  V\right)  _{e}.
\end{equation}


\item
\begin{align}
\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
+\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \left(
\left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert +\left\vert
e_{m}\right\rangle \left\langle e_{l}\right\vert \right)   &  =\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert e_{l}\right\rangle
\left\langle e_{m}\right\vert +\left\vert e_{k}\right\rangle \left\langle
e_{j}\right\vert \left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert
+\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert
e_{m}\right\rangle \left\langle e_{l}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \left\vert e_{m}\right\rangle
\left\langle e_{l}\right\vert \\
&  =\left\vert e_{j}\right\rangle \left\langle e_{m}\right\vert \delta
_{kl}+\left\vert e_{k}\right\rangle \left\langle e_{m}\right\vert \delta
_{jl}+\left\vert e_{j}\right\rangle \left\langle e_{l}\right\vert \delta
_{km}+\left\vert e_{k}\right\rangle \left\langle e_{l}\right\vert \delta
_{jm}\\
\left(  \left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert
+\left\vert e_{m}\right\rangle \left\langle e_{l}\right\vert \right)  \left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)   &  =\left\vert
e_{l}\right\rangle \left\langle e_{m}\right\vert \left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert +\left\vert e_{m}\right\rangle \left\langle
e_{l}\right\vert \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
+\left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert \left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert +\left\vert e_{m}%
\right\rangle \left\langle e_{l}\right\vert \left\vert e_{k}\right\rangle
\left\langle e_{j}\right\vert \\
&  =\left\vert e_{l}\right\rangle \left\langle e_{k}\right\vert \delta
_{jm}+\left\vert e_{m}\right\rangle \left\langle e_{k}\right\vert \delta
_{lj}+\left\vert e_{l}\right\rangle \left\langle e_{j}\right\vert \delta
_{km}+\left\vert e_{m}\right\rangle \left\langle e_{j}\right\vert \delta_{lk}.
\end{align}


\item
\begin{equation}
\mathcal{B}_{00asa}\left(  V\right)  \cong\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \left(  \left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert -\left\vert e_{k}\right\rangle \left\langle
e_{j}\right\vert \right)  \right\vert 1\leq j<k\leq r\right\}  \equiv
\mathcal{B}_{asa}\left(  V\right)  _{e}.
\end{equation}


\item
\begin{align}
\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \left(
\left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert -\left\vert
e_{m}\right\rangle \left\langle e_{l}\right\vert \right)   &  =\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert e_{l}\right\rangle
\left\langle e_{m}\right\vert -\left\vert e_{k}\right\rangle \left\langle
e_{j}\right\vert \left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert
-\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert
e_{m}\right\rangle \left\langle e_{l}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \left\vert e_{m}\right\rangle
\left\langle e_{l}\right\vert \\
&  =\left\vert e_{j}\right\rangle \left\langle e_{m}\right\vert \delta
_{kl}-\left\vert e_{k}\right\rangle \left\langle e_{m}\right\vert \delta
_{jl}-\left\vert e_{j}\right\rangle \left\langle e_{l}\right\vert \delta
_{km}+\left\vert e_{k}\right\rangle \left\langle e_{l}\right\vert \delta
_{jm}\\
\left(  \left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert
-\left\vert e_{m}\right\rangle \left\langle e_{l}\right\vert \right)  \left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert -\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)   &  =\left\vert
e_{l}\right\rangle \left\langle e_{m}\right\vert \left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert -\left\vert e_{m}\right\rangle \left\langle
e_{l}\right\vert \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert \left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert +\left\vert e_{m}%
\right\rangle \left\langle e_{l}\right\vert \left\vert e_{k}\right\rangle
\left\langle e_{j}\right\vert \\
&  =\left\vert e_{l}\right\rangle \left\langle e_{k}\right\vert \delta
_{jm}-\left\vert e_{m}\right\rangle \left\langle e_{k}\right\vert \delta
_{lj}-\left\vert e_{l}\right\rangle \left\langle e_{j}\right\vert \delta
_{km}+\left\vert e_{m}\right\rangle \left\langle e_{j}\right\vert \delta_{lk}.
\end{align}


\item
\begin{align}
\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
+\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \left(
\left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert -\left\vert
e_{m}\right\rangle \left\langle e_{l}\right\vert \right)   &  =\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert e_{l}\right\rangle
\left\langle e_{m}\right\vert +\left\vert e_{k}\right\rangle \left\langle
e_{j}\right\vert \left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert
-\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \left\vert
e_{m}\right\rangle \left\langle e_{l}\right\vert -\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \left\vert e_{m}\right\rangle
\left\langle e_{l}\right\vert \\
&  =\left\vert e_{j}\right\rangle \left\langle e_{m}\right\vert \delta
_{kl}+\left\vert e_{k}\right\rangle \left\langle e_{m}\right\vert \delta
_{jl}-\left\vert e_{j}\right\rangle \left\langle e_{l}\right\vert \delta
_{km}-\left\vert e_{k}\right\rangle \left\langle e_{l}\right\vert \delta
_{jm}\\
\left(  \left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert
-\left\vert e_{m}\right\rangle \left\langle e_{l}\right\vert \right)  \left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)   &  =\left\vert
e_{l}\right\rangle \left\langle e_{m}\right\vert \left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert -\left\vert e_{m}\right\rangle \left\langle
e_{l}\right\vert \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
+\left\vert e_{l}\right\rangle \left\langle e_{m}\right\vert \left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert -\left\vert e_{m}%
\right\rangle \left\langle e_{l}\right\vert \left\vert e_{k}\right\rangle
\left\langle e_{j}\right\vert \\
&  =\left\vert e_{l}\right\rangle \left\langle e_{k}\right\vert \delta
_{jm}-\left\vert e_{m}\right\rangle \left\langle e_{k}\right\vert \delta
_{lj}+\left\vert e_{l}\right\rangle \left\langle e_{j}\right\vert \delta
_{km}-\left\vert e_{m}\right\rangle \left\langle e_{j}\right\vert \delta_{lk}.
\end{align}

\end{enumerate}

\item The unitary group $U\left(  V\right)  $ is generated by the Lie algebra
$u\left(  V\right)  =\mathcal{B}_{asa}\left(  V\right)  =i\mathcal{B}%
_{sa}\left(  V\right)  $ i.e.
\begin{equation}
U\left(  V\right)  =\exp\left\{  \mathcal{B}_{asa}\left(  V\right)  \right\}
=\exp\left\{  i\mathcal{B}_{sa}\left(  V\right)  \right\}  ,
\end{equation}
where the derived real spaces $\mathcal{B}_{asa}\left(  V\right)  $ and
$i\mathcal{B}_{sa}\left(  V\right)  $ from $\mathcal{B}\left(  V\right)  $ are
bases independent.

\item $u\left(  \mathbb{\lambda}\right)  \in U\left(  V\right)  $ can be
expanded as
\begin{align}
u\left(  \mathbb{\lambda}\right)   &  =\exp\left\{  i\sum_{1\leq j,k\leq
r}\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  _{jk}\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert \right\} \\
&  =\exp\left\{  \sum_{1\leq j,k\leq r}\left(  i\operatorname{Re}\left(
\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  _{jk}\right)
-\operatorname{Im}\left(  \mathcal{R}_{e}\left(  \mathbb{\lambda}\right)
_{jk}\right)  \right)  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \right\} \\
&  =\exp\left\{  \sum_{1\leq j,k\leq r}i\operatorname{Re}\left(
\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  _{jk}\right)  \left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert -\sum_{1\leq j,k\leq
r}\operatorname{Im}\left(  \mathcal{R}_{e}\left(  \mathbb{\lambda}\right)
_{jk}\right)  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
\right\} \\
&  =\exp\left\{  \sum_{1\leq j<k\leq r}i\operatorname{Re}\left(
\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  _{jk}\right)  \left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  +\sum_{1\leq j\leq
r}i\operatorname{Re}\left(  \mathcal{R}_{e}\left(  \mathbb{\lambda}\right)
_{jj}\right)  \left(  \left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert \right)  -\sum_{1\leq j<k\leq r}\operatorname{Im}\left(
\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  _{jk}\right)  \left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert -\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \right\}  ,
\end{align}
where
\begin{gather}
\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  ^{\dagger}=\mathcal{R}%
_{e}\left(  \mathbb{\lambda}\right)  \text{ i.e. }\mathcal{R}_{e}\left(
\mathbb{\lambda}\right)  _{jk}=\overline{\mathcal{R}_{e}\left(
\mathbb{\lambda}\right)  _{kj}}\\
\Downarrow\\
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  \mathbb{\lambda}\right)
_{jk}\right)  =\operatorname{Re}\left(  \mathcal{R}_{e}\left(  \mathbb{\lambda
}\right)  _{kj}\right)  \quad\&\quad\operatorname{Im}\left(  \mathcal{R}%
_{e}\left(  \mathbb{\lambda}\right)  _{jk}\right)  =-\operatorname{Im}\left(
\mathcal{R}_{e}\left(  \mathbb{\lambda}\right)  _{kj}\right) \\
\quad1\leq j,k\leq r.
\end{gather}


\item The coset factorization gives
\begin{equation}
u\left(  \mathbb{\lambda}\right)  =u\left(  \mathbb{\eta}\right)
=\exp\left\{  i\sum_{1\leq j<k\leq r}\mathbb{\eta}_{jk}\left(  \left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \right)  \right\}  \exp\left\{
\sum_{1\leq j\leq r}i\mathbb{\eta}_{j}\left(  \left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert \right)  \right\}  \exp\left\{  \sum_{1\leq
j>k\leq r}\mathbb{\eta}_{jk}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert -\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  \right\}  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{notation}
The set $\mathfrak{B}\left(  V\right)  $ of conbs of the Hilbert space $V$
\begin{equation}
\mathfrak{B}\left(  V\right)  =\left\{  \left.  \overset{}{\left\vert
\mathbf{e}\right\rangle }\right\vert \left\vert \mathbf{e}\right\rangle \text{
a conb of }V\right\}  .
\end{equation}

\end{notation}

\begin{enumerate}
\item The set of conbs $\mathfrak{B}\left(  V\right)  $ of $V$ is closed under
the action of the unitary group $U\left(  V\right)  \subset\mathcal{B}\left(
V\right)  .$

\item Each conb $\left\vert \mathbf{e}\right\rangle \in\mathfrak{B}\left(
V\right)  $ produces a real Hilbert space
\begin{equation}
V_{\mathbb{R}e}=\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left\vert
\mathbf{e}\right\rangle \right\}  \equiv\mathbb{R}\text{-}%
\operatorname*{linspan}\left\{  \left\vert e_{1}\right\rangle ,\cdots
,\left\vert e_{2}\right\rangle \right\}  .
\end{equation}


\item The real Hilbert spaces are isometrically isomorphic i.e.
\begin{equation}
V_{\mathbb{R}e}\cong V_{\mathbb{R}f}\quad\forall\left\vert \mathbf{e}%
\right\rangle ,\left\vert \mathbf{f}\right\rangle \in\mathfrak{B}\left(
V\right)  .
\end{equation}


\begin{definition}
Equivalence relationship between conbs $\left\vert \mathbf{e}\right\rangle
\in$ $\mathfrak{B}\left(  V\right)  $ of $V$
\begin{equation}
\left(  \overset{}{\left\vert \mathbf{e}\right\rangle \sim\left\vert
\mathbf{f}\right\rangle }\right)  \text{ }\Leftrightarrow\left(
\overset{}{u\in O\left(  V\right)  \cong O\left(  2r,\mathbb{R}\right)
\Rightarrow u\left\vert \mathbf{e}\right\rangle =\left\vert \mathbf{f}%
\right\rangle }\right)
\end{equation}
produces equivalence classes $\left[  \left\vert \mathbf{e}\right\rangle
\right]  $ of bases $\left\{  \left\vert \mathbf{e}\right\rangle \right\}  $
of $V.$
\end{definition}

\begin{notation}
The set of equivalence classes of bases $\left[  \left\vert \mathbf{e}%
\right\rangle \right]  $ of $V$
\begin{equation}
\left[  \mathfrak{B}\left(  V\right)  \right]  \equiv\left\{
\overset{}{\left.  \left[  \left\vert \mathbf{e}\right\rangle \right]
\right\vert \left\vert \mathbf{e}\right\rangle \in\mathfrak{B}\left(
V\right)  }\right\}  .
\end{equation}

\end{notation}

\begin{lemma}
The set of equivalence classes of bases is generated by the coset
$\frac{U\left(  V\right)  }{O\left(  V\right)  }$
\begin{equation}
\left[  \mathfrak{B}\left(  V\right)  \right]  =\left\{  \left.
\overset{}{T\left[  \left\vert \mathbf{e}\right\rangle \right]  }\right\vert
T\in\frac{U\left(  V\right)  }{O\left(  V\right)  }\right\}  .
\end{equation}

\end{lemma}

\item In finite dimensions
\begin{align}
V  &  \cong\mathbb{C}^{r}\\
\mathcal{B}\left(  V\right)   &  \cong\mathcal{B}\left(  \mathbb{C}^{r}\right)
\\
V_{\mathbb{R}e}  &  \cong\mathbb{R}^{r}\\
U\left(  V\right)   &  \cong U\left(  r\right) \\
O\left(  V\right)   &  \cong O\left(  r,\mathbb{R}\right)  .
\end{align}


\item The unitary group $U\left(  V\right)  $ contains the orthogonal groups
$\left\{  \left.  \overset{}{O\left(  V_{\mathbb{R}e}\right)  }:\left[
\left\vert \mathbf{e}\right\rangle \right]  \rightarrow\left[  \left\vert
\mathbf{e}\right\rangle \right]  \right\vert \left[  \left\vert \mathbf{e}%
\right\rangle \right]  \in\left[  \mathfrak{B}\left(  V\right)  \right]
\right\}  ,$ i.e.
\begin{equation}
U\left(  V\right)  \supset O\left(  V_{\mathbb{R}e}\right)  .
\end{equation}


\item Left coset factorization%
\begin{equation}
\left(  U\left(  V\right)  =\frac{U\left(  V\right)  }{O\left(  V_{\mathbb{R}%
e}\right)  }O\left(  V_{\mathbb{R}e}\right)  \right)  \cong\left(  U\left(
2s\right)  =\frac{U\left(  2s\right)  }{O\left(  2s,\mathbb{R}\right)
}O\left(  2s,\mathbb{R}\right)  \right)
\end{equation}
gives
\begin{equation}
u\left(  \mathbb{\eta}\right)  =\exp\left\{  i\mathbb{\eta}_{>}\right\}
\exp\left\{  i\mathbb{\eta}_{d}\right\}  \exp\left\{  \mathbb{\eta}%
_{<}\right\}  \in\frac{U\left(  V\right)  }{O\left(  V_{\mathbb{R}e}\right)
}O\left(  V_{\mathbb{R}e}\right)  ,
\end{equation}
where
\begin{equation}
\mathbb{\eta}_{>},\mathbb{\eta}_{d}\in\mathcal{B}_{sa}\left(  V\right)
,\,\mathbb{\eta}_{<}\in\mathcal{B}_{asa}\left(  V\right)  \text{.}%
\end{equation}


\item Using the coset factorization
\begin{gather}
u\left(  \mathbb{\lambda}\right)  =u\left(  \mathbb{\eta}\right)
=\Lambda\left(  \mathbb{\eta}\right)  o\left(  \mathbb{\eta}\right)  =\left(
\exp\left\{  i\mathbb{\eta}_{>}\right\}  \exp\left\{  i\mathbb{\eta}%
_{d}\right\}  \right)  \exp\left\{  \mathbb{\eta}_{<}\right\} \\
\parallel\\
\left(  \exp\left\{  i\sum_{1\leq j<k\leq r}\mathbb{\eta}_{jk}\left(
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \right)  \right\}
\exp\left\{  i\sum_{1\leq j\leq r}\mathbb{\eta}_{j}\left(  \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert \right)  \right\}  \right)
\exp\left\{  \sum_{1\leq j>k\leq r}\mathbb{\eta}_{jk}\left(  \left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert -\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \right)  \right\}  ,
\end{gather}
where $\mathbb{\eta}_{>}$ and $\mathbb{\eta}_{d}$ are self adjoint
\begin{equation}
\mathbb{\eta}_{<j_{1}j_{2}}=\mathbb{\eta}_{j_{1}j_{2}}=\mathbb{\eta}%
_{<j_{2}j_{1}}\in\mathbb{R},\,1\leq j<k\leq r
\end{equation}
and $\mathbb{\eta}_{<}$ is anti self adjoint%
\begin{equation}
\mathbb{\eta}_{<j_{1}j_{2}}=\mathbb{\eta}_{j_{1}j_{2}}=-\mathbb{\eta}%
_{<j_{2}j_{1}}\in\mathbb{R},\,1\leq j<k\leq r.
\end{equation}

\end{enumerate}

\begin{remark}
The set of equivalence classes $\left[  \left\vert \mathbf{e}\right\rangle
\right]  $ of conbs of $V$ can be parameterized by $\mathbb{\eta\in R}%
^{\frac{r\left(  r+1\right)  }{2}}$ and hence the coset $\frac{U\left(
V\right)  }{O\left(  V\right)  },$ producing a manifold $\left\vert
\mathbf{e}\left(  \mathbb{\eta}\right)  \right\rangle $ of conbs
\begin{equation}
\left\vert \mathbf{e}\left(  \mathbb{\eta}\right)  \right\rangle
=\Lambda\left(  \mathbb{\eta}\right)  \left\vert \mathbf{e}\right\rangle
=\exp\left\{  i\sum_{1\leq j<k\leq r}\mathbb{\eta}_{jk}\left(  \left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert +\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \right)  \right\}  \exp\left\{
i\sum_{1\leq j\leq r}\mathbb{\eta}_{j}\left(  \left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert \right)  \right\}  \left\vert \mathbf{e}%
\right\rangle .
\end{equation}

\end{remark}

\begin{remark}
$\left\vert \mathbf{e}\left(  \mathbb{\eta}\right)  \right\rangle $ induces
the bases $\left\vert \mathbf{e}\left(  \mathbb{\eta}\right)  \right\rangle
\left\langle \mathbf{e}\left(  \mathbb{\eta}\right)  \right\vert
_{sa},\left\vert \mathbf{e}\left(  \mathbb{\eta}\right)  \right\rangle
\left\langle \mathbf{e}\left(  \mathbb{\eta}\right)  \right\vert _{asa}$ and
$\left\vert \mathbf{e}\left(  \mathbb{\eta}\right)  \mathbf{e}\left(
\mathbb{\eta}\right)  \right\rangle $ in $\mathcal{B}_{sa}\left(  V\right)
,\mathcal{B}_{asa}\left(  V\right)  $ and $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$ respectively.
\end{remark}

\begin{remark}
$O\left(  V,\mathbb{R}\right)  \subset U\left(  V\right)  $ produces the
mutually \emph{disjoint} orbits

\begin{enumerate}
\item
\begin{equation}
\mathfrak{O}_{asa}\left(  G\right)  =\left\{  \left.  \Lambda\left(
\mathbb{\eta}\right)  G\Lambda\left(  \mathbb{\eta}\right)  ^{\dagger
}\right\vert G\in\mathcal{B}_{asa}\left(  V\right)  ,\Lambda\left(
\mathbb{\eta}\right)  \in\mathcal{R}_{\mathcal{B}\left(  V\right)  }\left(
\frac{U\left(  V\right)  }{O\left(  V\right)  }\right)  ,\mathbb{\eta\in
R}^{\frac{r\left(  r+1\right)  }{2}}\right\}
\end{equation}
in $\mathcal{B}_{asa}\left(  V\right)  $ i.e.
\begin{equation}
\mathfrak{O}_{asa}\left(  G\right)  \cap\mathfrak{O}_{asa}\left(  G^{\prime
}\right)  =\phi
\end{equation}
and

\item
\begin{equation}
\mathfrak{O}_{sa}\left(  H\right)  =\left\{  \left.  \Lambda\left(
\mathbb{\eta}\right)  H\Lambda\left(  \mathbb{\eta}\right)  ^{\dagger
}\right\vert H\in\mathcal{B}_{sa}\left(  V\right)  ,\Lambda\left(
\mathbb{\eta}\right)  \in\mathcal{R}_{\mathcal{B}\left(  V\right)  }\left(
\frac{U\left(  V\right)  }{O\left(  V\right)  }\right)  ,\mathbb{\eta\in
R}^{\frac{r\left(  r+1\right)  }{2}}\right\}
\end{equation}
in $\mathcal{B}_{sa}\left(  V\right)  $ i.e.
\begin{equation}
\mathfrak{O}_{sa}\left(  G\right)  \cap\mathfrak{O}_{sa}\left(  G^{\prime
}\right)  =\phi.
\end{equation}


\item The orbits $\mathfrak{O}_{asa}\left(  G\right)  $ and $\mathfrak{O}%
_{sa}\left(  H\right)  $ are disjoint i.e
\begin{equation}
\mathfrak{O}_{asa}\left(  G\right)  \cap\mathfrak{O}_{asa}\left(  G\right)
=\phi.
\end{equation}


\item $O\left(  V\right)  $ leaves the orbits invariant (permutes the elements
of the orbit) i.e.
\begin{equation}
O\left(  V\right)  :\mathfrak{O}_{sa}\left(  G\right)  \rightarrow
\mathfrak{O}_{sa}\left(  G\right)
\end{equation}
and
\begin{equation}
O\left(  V\right)  :\mathfrak{O}_{asa}\left(  G\right)  \rightarrow
\mathfrak{O}_{asa}\left(  G\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
The orbit of $U\left(  V\right)  \cong U\left(  2m\right)  $ is $V$ i.e. $V$
is a homogeneous manifold for $U\left(  V\right)  ,$ while the orbits
$\left\{  \mathfrak{O}_{asa}\left(  G\right)  \right\}  $ and $\left\{
\mathfrak{O}_{sa}\left(  G\right)  \right\}  $ are homogeneous manifolds for
$O\left(  V,\mathbb{R}\right)  \cong O\left(  2m,\mathbb{R}\right)  .$
\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{R}_{V}\left(  O\left(  V,\mathbb{R}\right)  \right)  \subset
\mathcal{R}_{V}\left(  U\left(  V\right)  \right)
\end{equation}

\end{remark}

\begin{remark}
As $V$ is complex Hilbert space there is no unique complex symmetric bilinear
form defined and thus no natural definition of $O\left(  V\right)  ,$ however
one can utilize $\mathcal{B}\left(  V\right)  $ and the complex Lie algebras
generated by $\left\{  \left.  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \right\vert 1\leq j,k\leq n\right\}  $ to produce $so\left(
V\right)  $ and hence $SO\left(  V\right)  .$
\end{remark}

\begin{remark}
If we consider the Clifford algebra $\mathcal{F}$ then one can intrinsically
define $O\left(  V\right)  $ as well as there is a unique complex symmetric
bilinear form defined in $\mathcal{F}$.
\end{remark}

\begin{lemma}%
\begin{equation}
O\left(  V,\mathbb{R}\right)  =O\left(  V,\mathbb{C}\right)  \cap U\left(
V\right)  .
\end{equation}

\end{lemma}

\begin{definition}%
\begin{equation}
\mathcal{B}_{asa}\left(  V\right)  =\left\{  \left.  A\in\mathcal{B}\left(
V\right)  \right\vert A=-A^{\dagger}\right\}
\end{equation}

\end{definition}

\begin{lemma}
$\mathcal{B}_{asa}\left(  V\right)  $ is a real vector space.
\end{lemma}

\subsubsection{Correspondence between Dual spaces and Operators
\label{Correspondence between Dual spaces and Operators}}

\begin{remark}
The maps $\mathcal{\Xi}_{VV}$ and $\mathcal{\Xi}_{VV^{d}}$ produce the
elementary operators $\left\{  \left.  E_{jk}\right\vert E_{jk}\in
\mathcal{B}\left(  V\right)  ,\quad1\leq j,k\leq r\right\}  $
\[
E_{jk}=\mathcal{\Xi}_{VV}\left(  e_{j}\otimes e_{k}\right)  =\mathcal{\Xi
}_{VV^{d}}\left(  e_{j}\otimes\digamma_{e}\left(  e_{k}\right)  \right)
,\,E_{jk}\in\mathcal{B}\left(  V\right)  ,\quad1\leq j,k\leq r.
\]

\end{remark}

\begin{remark}%
\begin{align}
\mathcal{\Xi}_{VV^{d}}  &  :V\otimes V^{d}\rightarrow\mathcal{L}\left(
V\right) \\
\digamma_{e}  &  :V\rightarrow V^{d}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
e_{j}\wedge e_{k}=\frac{1}{2}\left(  e_{j}\otimes e_{k}-e_{k}\otimes
e_{j}\right)  ,\quad1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{remark}
The injections $\digamma_{e}$
\begin{equation}
\digamma_{e}:V\rightarrow V^{d}%
\end{equation}
can be actualized as the complex linear maps $\digamma_{\left\vert e\right)
}$ or the complex anti linear maps $\digamma_{\left\vert e\right\rangle }$ by
\begin{equation}
e_{j}^{d}=\digamma_{\left\vert e\right)  }\left(  e_{j}\right)  =\left(
e_{j}^{b}\right\vert =\sum_{1\leq k\leq r}\left(  e_{k}\right\vert \left(
\left.  e_{k}\right\vert e_{j}\right)  ^{-1},\quad1\leq j\leq r
\end{equation}
and
\begin{equation}
e_{j}^{d}=\digamma_{\left\vert e\right\rangle }\left(  e_{j}\right)
=\left\langle e_{j}^{b}\right\vert =\sum_{1\leq k\leq r}\left\langle
e_{k}\right\vert \left\langle \left.  e_{k}\right\vert e_{j}\right\rangle
^{-1},\quad1\leq j\leq r.
\end{equation}
resulting in complex linear maps $\mathcal{\Xi}_{VV^{d}}$ and complex anti
linear maps $\mathcal{\Xi}_{VV}.$
\end{remark}

\begin{definition}
A complex linear injection $\mathcal{\Xi}_{\left\vert VV\right)  }$
\begin{equation}
\mathcal{\Xi}_{VV}:%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\rightarrow\mathcal{B}_{ooantisym}\left(  V\right)
\end{equation}
through its action on any $\left(  \left.  {}\right\vert \right)  $-conb
$\left\{  \left.  \left\vert e_{j}\right)  \right\vert 1\leq j\leq r\right\}
$ i.e. $\left\{  \left.  \left(  e_{j}^{b}\right\vert =\left(  e_{j}%
\right\vert \right\vert 1\leq j\leq r\right\}  $ by
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right)  }\left(  e_{j}\wedge e_{k}\right)
=\frac{1}{2}\left(  \left\vert e_{j}\right)  \left(  e_{k}\right\vert
-\left\vert e_{k}\right)  \left(  e_{j}\right\vert \right)  ,\quad1\leq
j,k\leq r.
\end{equation}
The action of $\mathcal{\Xi}_{\left\vert VV\right)  }$ on general elements
$v_{1}\wedge v_{2}\in%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$ is
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right)  }\left(  v_{1}\wedge v_{2}\right)
=\frac{1}{2}\left(  \left\vert v_{1}\right)  \left(  \digamma_{\left\vert
e\right)  }\left(  v_{2}\right)  \right\vert -\left\vert v_{2}\right)  \left(
\digamma_{\left\vert e\right)  }\left(  v_{1}\right)  \right\vert \right)  .
\end{equation}

\end{definition}

\begin{example}%
\begin{align}
\mathcal{\Xi}_{\left\vert VV\right)  }\left(  g\right)   &  =\mathcal{\Xi
}_{VV}\left(  \sum_{1\leq j<k\leq r}\mathcal{R}_{\wedge^{2}e}\left(  g\right)
_{_{jk}}\left(  \overset{}{e_{j}\wedge e_{k}}\right)  \right)  =\mathcal{\Xi
}_{VV^{d}}\left(  \sum_{1\leq j<k\leq r}\mathcal{R}_{\wedge^{2}e}\left(
g\right)  _{_{jk}}\left(  \overset{}{e_{j}\wedge e_{k}^{b}}\right)  \right) \\
&  =\sum_{1\leq j<k\leq r}g_{jk}\frac{1}{2}\left(  \left\vert e_{j}\right)
\left(  e_{k}^{b}\right\vert -\left\vert e_{k}\right)  \left(  e_{j}%
^{b}\right\vert \right)  .
\end{align}

\end{example}

\begin{definition}
A complex anti linear injection $\mathcal{\Xi}_{\left\vert VV\right\rangle }$
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }:%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\rightarrow\mathcal{B}_{ooasa}\left(  V\right)
\end{equation}
through its action on any $\left\langle \left.  {}\right\vert \right\rangle
$-conb $\left\{  \left.  \left\vert e_{j}\right\rangle \right\vert 1\leq j\leq
r\right\}  $ i.e. $\left\{  \left.  \left\langle e_{j}^{b}\right\vert
=\left\langle e_{j}\right\vert \right\vert 1\leq j\leq r\right\}  $ by
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  e_{j}\wedge e_{k}\right)
=\frac{1}{2}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}%
\right\vert -\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  ,\quad1\leq j,k\leq r.
\end{equation}
The action of $\mathcal{\Xi}_{\left\vert VV\right\rangle }$ on general
elements $v_{1}\wedge v_{2}\in%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$ is
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  v_{1}\wedge v_{2}\right)
=\frac{1}{2}\left(  \left\vert v_{1}\right\rangle \left\langle \digamma
_{\left\vert e\right\rangle }\left(  v_{2}\right)  \right\vert -\left\vert
v_{2}\right\rangle \left\langle \digamma_{\left\vert e\right\rangle }\left(
v_{1}\right)  \right\vert \right)  .
\end{equation}

\end{definition}

\begin{example}%
\begin{align}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  g\right)   &
=\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  \sum_{1\leq j<k\leq
r}\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{_{jk}}\left(  \overset{}{e_{j}%
\wedge e_{k}}\right)  \right)  =\mathcal{\Xi}_{\left\vert VV\right\rangle
}\left(  \sum_{1\leq j<k\leq r}\mathcal{R}_{\wedge^{2}e}\left(  g\right)
_{_{jk}}\left(  \overset{}{e_{j}\wedge e_{k}^{b}}\right)  \right) \\
&  =\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  \sum_{1\leq j<k\leq
r}\mathcal{R}_{\wedge^{2}e}\left(  g\right)  _{_{jk}}\left(  \overset{}{e_{j}%
\wedge e_{k}^{b}}\right)  \right)  =\sum_{1\leq j<k\leq r}g_{jk}\frac{1}%
{2}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}^{b}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}^{b}\right\vert \right)  .
\end{align}

\end{example}

\begin{theorem}
$\mathcal{\Xi}_{\left\vert VV\right\rangle }$ can be extended to a \emph{real}
Hilbert space isometric isomorphisms $\mathcal{\Xi}_{\left\vert
VV\right\rangle }$
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }:%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\rightarrow\mathcal{B}_{2asa}\left(  V\right)
\end{equation}
and
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }:%
%TCIMACRO{\tbigvee \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigvee\nolimits^{2}}
%EndExpansion
V\rightarrow\mathcal{B}_{2sa}\left(  V\right)
\end{equation}

\end{theorem}

\begin{proof}
Orthonormality
\end{proof}

\begin{remark}
\begin{enumerate}
\item
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert -\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \right)  ^{\dagger}\left(  \left\vert
e_{j_{2}}\right\rangle \left\langle e_{k_{2}}\right\vert -\left\vert e_{k_{2}%
}\right\rangle \left\langle e_{j_{2}}\right\vert \right)  \right\}
=-\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert -\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \right)  \left(  \left\vert e_{j_{2}%
}\right\rangle \left\langle e_{k_{2}}\right\vert -\left\vert e_{k_{2}%
}\right\rangle \left\langle e_{j_{2}}\right\vert \right)  \right\} \\
=-\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert \left\vert e_{j_{2}}\right\rangle
\left\langle e_{k_{2}}\right\vert -\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \left\vert e_{j_{2}}\right\rangle
\left\langle e_{k_{2}}\right\vert -\left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert \left\vert e_{k_{2}}\right\rangle
\left\langle e_{j_{2}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \left\vert e_{k_{2}}\right\rangle
\left\langle e_{j_{2}}\right\vert \right)  \right\} \\
=-\left(  \delta_{k_{2}j_{1}}\delta_{k_{1}j_{2}}-\delta_{j_{1}j_{2}}%
\delta_{k_{1}k_{2}}-\delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}+\delta_{k_{2}j_{1}%
}\delta_{k_{1}j_{2}}\right) \\
=2\left(  \delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}-\delta_{k_{2}j_{1}}%
\delta_{k_{1}j_{2}}\right)  ,\quad1\leq j_{1}<k_{1}\leq2r.
\end{gather}


\item
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \right)  ^{\dagger}\left(  \left\vert
e_{j_{2}}\right\rangle \left\langle e_{k_{2}}\right\vert +\left\vert e_{k_{2}%
}\right\rangle \left\langle e_{j_{2}}\right\vert \right)  \right\}
=\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \right)  \left(  \left\vert e_{j_{2}%
}\right\rangle \left\langle e_{k_{2}}\right\vert +\left\vert e_{k_{2}%
}\right\rangle \left\langle e_{j_{2}}\right\vert \right)  \right\} \\
=\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert \left\vert e_{j_{2}}\right\rangle
\left\langle e_{k_{2}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \left\vert e_{j_{2}}\right\rangle
\left\langle e_{k_{2}}\right\vert +\left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert \left\vert e_{k_{2}}\right\rangle
\left\langle e_{j_{2}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \left\vert e_{k_{2}}\right\rangle
\left\langle e_{j_{2}}\right\vert \right)  \right\} \\
=\left(  \delta_{k_{2}j_{1}}\delta_{k_{1}j_{2}}+\delta_{j_{1}j_{2}}%
\delta_{k_{1}k_{2}}+\delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}+\delta_{k_{2}j_{1}%
}\delta_{k_{1}j_{2}}\right) \\
=2\left(  \delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}+\delta_{k_{2}j_{1}}%
\delta_{k_{1}j_{2}}\right)  ,\quad1\leq j_{1}\leq k_{1}\leq2r.
\end{gather}


\item
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \right)  ^{\dagger}\left(  \left\vert
e_{j_{2}}\right\rangle \left\langle e_{k_{2}}\right\vert -\left\vert e_{k_{2}%
}\right\rangle \left\langle e_{j_{2}}\right\vert \right)  \right\}
=\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \right)  \left(  \left\vert e_{j_{2}%
}\right\rangle \left\langle e_{k_{2}}\right\vert -\left\vert e_{k_{2}%
}\right\rangle \left\langle e_{j_{2}}\right\vert \right)  \right\} \\
=\operatorname{Tr}\left\{  \left(  \left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert \left\vert e_{j_{2}}\right\rangle
\left\langle e_{k_{2}}\right\vert +\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \left\vert e_{j_{2}}\right\rangle
\left\langle e_{k_{2}}\right\vert -\left\vert e_{j_{1}}\right\rangle
\left\langle e_{k_{1}}\right\vert \left\vert e_{k_{2}}\right\rangle
\left\langle e_{j_{2}}\right\vert -\left\vert e_{k_{1}}\right\rangle
\left\langle e_{j_{1}}\right\vert \left\vert e_{k_{2}}\right\rangle
\left\langle e_{j_{2}}\right\vert \right)  \right\} \\
=\left(  \delta_{k_{2}j_{1}}\delta_{k_{1}j_{2}}+\delta_{j_{1}j_{2}}%
\delta_{k_{1}k_{2}}-\delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}-\delta_{k_{2}j_{1}%
}\delta_{k_{1}j_{2}}\right)  =0,\quad1\leq j_{1}<k_{1}\leq2r.
\end{gather}

\end{enumerate}
\end{remark}

\begin{example}
\emph{Self adjoint} partial isometry in $\mathcal{B}\left(  \mathbb{C}%
^{2}\right)  $

\begin{enumerate}
\item
\begin{align}
\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
a\\
b
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
b\\
a
\end{array}
\right)  =\lambda\left(
\begin{array}
[c]{c}%
a\\
b
\end{array}
\right) \\
&  \Rightarrow b=\lambda a\quad\&\quad a=\lambda b\\
&  \Rightarrow\frac{a}{b}=\frac{b}{a}\\
&  \Rightarrow a^{2}=b^{2}\\
&  \Rightarrow a=\pm b
\end{align}


\item this gives the representation of normalized eigenvectors associated with
eigenvalues $\left\{  -1,1\right\}  $%
\begin{align}
\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
1
\end{array}
\right)   &  =\left(  1\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
1
\end{array}
\right) \\
\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
-1
\end{array}
\right)   &  =\left(  -1\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
-1
\end{array}
\right)  ,
\end{align}


\item that corresponds to the following operators and vectors in
$\mathcal{B}\left(  V\right)  $ and $V$
\begin{align}
\left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert +\left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert  &  =\left\vert
f_{1}\right\rangle \left\langle f_{1}\right\vert -\left\vert f_{2}%
\right\rangle \left\langle f_{2}\right\vert \\
\left\vert f_{1}\right\rangle  &  =\frac{1}{\sqrt{2}}\left(  \left\vert
e_{1}\right\rangle +\left\vert e_{2}\right\rangle \right) \\
\left\vert f_{1}\right\rangle  &  =\frac{1}{\sqrt{2}}\left(  \left\vert
e_{1}\right\rangle -\left\vert e_{2}\right\rangle \right)  .
\end{align}

\end{enumerate}
\end{example}

\begin{example}
\emph{Anti self adjoint }partial isometry
\end{example}

\begin{remark}
\begin{enumerate}
\item
\begin{align}
\left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
a\\
b
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
b\\
-a
\end{array}
\right)  =\lambda\left(
\begin{array}
[c]{c}%
a\\
b
\end{array}
\right) \\
&  \Rightarrow b=\lambda a\quad\&\quad a=-\lambda b\\
&  \Rightarrow\frac{a}{b}=-\frac{b}{a}\\
&  \Rightarrow a^{2}=-b^{2}\\
&  \Rightarrow a=\pm ib
\end{align}


\item this gives the representation of normalized eigenvectors associated with
eigenvalues $\left\{  -1,1\right\}  $%
\begin{align}
\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right)   &  =\left(  1\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
i
\end{array}
\right) \\
\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
-i
\end{array}
\right)   &  =\left(  -1\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
1\\
-i
\end{array}
\right)  ,
\end{align}


\item that corresponds to the following operators and vectors in
$\mathcal{B}\left(  V\right)  $ and $V$%
\begin{align}
\left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert +\left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert  &  =\left\vert
h_{1}\right\rangle \left\langle h_{1}\right\vert -\left\vert h_{2}%
\right\rangle \left\langle h_{2}\right\vert \\
\left\vert h_{1}\right\rangle  &  =\frac{1}{\sqrt{2}}\left(  \left\vert
e_{1}\right\rangle +i\left\vert e_{2}\right\rangle \right) \\
\left\vert h_{2}\right\rangle  &  =\frac{1}{\sqrt{2}}\left(  \left\vert
e_{1}\right\rangle -i\left\vert e_{2}\right\rangle \right) \\
\left\vert h_{1}\right\rangle  &  =\overline{\left\vert h_{2}\right\rangle }.
\end{align}


\begin{example}
$r=1$%
\begin{equation}
\mathcal{B}_{00}\left(  V\right)  =\mathcal{B}\left(  V\right)  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left(  \left\vert e_{1}\right\rangle
\left\langle e_{1}\right\vert +\left\vert e_{2}\right\rangle \left\langle
e_{2}\right\vert \right)  ,\left(  \left\vert e_{1}\right\rangle \left\langle
e_{1}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert
\right)  ,\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
,\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert \right\}
\end{equation}


\begin{enumerate}
\item Squares of self adjoint and anti self adjoint partial isometry basis
elements%
\begin{align}
\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)  ^{2}  &
=\left(  \overset{}{\left\vert e_{1}\right\rangle \left\langle e_{2}%
\right\vert +\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
}\right)  \left(  \overset{}{\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert +\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
}\right)  =\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert \\
\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)  ^{2}  &
=\left(  \overset{}{\left\vert e_{1}\right\rangle \left\langle e_{2}%
\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
}\right)  \left(  \overset{}{\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
}\right)  =-\left(  \left\vert e_{1}\right\rangle \left\langle e_{1}%
\right\vert +\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert
\right) \\
\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert ^{2}  &
=\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert \\
\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert ^{2}  &
=\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert .
\end{align}


\item Anti Self Adjoint basis element $\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert $ is a partial isometry
\begin{equation}
\left(  \overset{}{\left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert }\right)
^{\dagger}\left(  \overset{}{\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
}\right)  =\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert .
\end{equation}


\item Self Adjoint basis $\left\{  \left\vert e_{1}\right\rangle \left\langle
e_{1}\right\vert ,\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert
,\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)
\right\}  $ are partial isometries
\begin{align}
\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert ^{2}  &
=\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert \\
\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert ^{2}  &
=\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert
\end{align}
(which are also orthogonal projections) and%
\begin{align}
\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)
^{\dagger}  &  =\left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert +\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right) \\
\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)  ^{2}  &
=\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert +\left\vert
e_{2}\right\rangle \left\langle e_{2}\right\vert \\
\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)
^{\dagger}\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)   &
=\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert +\left\vert
e_{2}\right\rangle \left\langle e_{2}\right\vert .
\end{align}


\item $HS\ $-Normalization%
\begin{equation}
\left\langle \left.  \left(  \overset{}{\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert +\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert }\right)  \right\vert \left(  \overset{}{\left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert +\left\vert e_{2}%
\right\rangle \left\langle e_{1}\right\vert }\right)  \right\rangle _{HS}=2
\end{equation}


\item $HS\ $-Normalization%
\begin{equation}
\left\langle \left.  \left(  \overset{}{\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert }\right)  \right\vert \left(  \overset{}{\left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert -\left\vert e_{2}%
\right\rangle \left\langle e_{1}\right\vert }\right)  \right\rangle _{HS}=2
\end{equation}
as%
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  ^{\dagger}\left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =\operatorname{Tr}\left\{  \left(  \left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \right)  \left(  \left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert -\left\vert e_{2}%
\right\rangle \left\langle e_{1}\right\vert \right)  \right\} \\
=\operatorname{Tr}\left\{  \left(  \left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert +\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert \left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =2.
\end{gather}


\item Overlap
\begin{equation}
\left\langle \left.  \left(  \overset{}{\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert }\right)  \right\vert \left(  \overset{}{\left\vert
e_{1}\right\rangle \left\langle e_{3}\right\vert -\left\vert e_{3}%
\right\rangle \left\langle e_{1}\right\vert }\right)  \right\rangle _{HS}=0
\end{equation}
as%
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  ^{\dagger}\left(  \left\vert e_{1}\right\rangle \left\langle
e_{3}\right\vert -\left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =\operatorname{Tr}\left\{  \left(  \left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \right)  \left(  \left\vert
e_{1}\right\rangle \left\langle e_{3}\right\vert -\left\vert e_{3}%
\right\rangle \left\langle e_{1}\right\vert \right)  \right\} \\
=\operatorname{Tr}\left\{  \left(  \left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \left\vert e_{1}\right\rangle \left\langle e_{3}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \left\vert
e_{3}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \left\vert e_{1}\right\rangle
\left\langle e_{3}\right\vert +\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert \left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =0
\end{gather}


\item Overlap%
\begin{equation}
\left\langle \left.  \left(  \overset{}{\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert }\right)  \right\vert \left(  \overset{}{\left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert +\left\vert e_{2}%
\right\rangle \left\langle e_{1}\right\vert }\right)  \right\rangle _{HS}=0
\end{equation}
as%
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  ^{\dagger}\left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert +\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =\operatorname{Tr}\left\{  \left(  \left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \right)  \left(  \left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert +\left\vert e_{2}%
\right\rangle \left\langle e_{1}\right\vert \right)  \right\} \\
=\operatorname{Tr}\left\{  \left(  \left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert \left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =0.
\end{gather}


\item Overlap%
\begin{equation}
\left\langle \left.  \left(  \overset{}{\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert }\right)  \right\vert \left(  \overset{}{\left\vert
e_{1}\right\rangle \left\langle e_{3}\right\vert +\left\vert e_{3}%
\right\rangle \left\langle e_{1}\right\vert }\right)  \right\rangle _{HS}=0
\end{equation}
as%
\begin{gather}
\operatorname{Tr}\left\{  \left(  \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\right)  ^{\dagger}\left(  \left\vert e_{1}\right\rangle \left\langle
e_{3}\right\vert +\left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =-\operatorname{Tr}\left\{  \left(  \left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \right)  \left(  \left\vert
e_{1}\right\rangle \left\langle e_{3}\right\vert +\left\vert e_{3}%
\right\rangle \left\langle e_{1}\right\vert \right)  \right\} \\
=-\operatorname{Tr}\left\{  \left(  \left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \left\vert e_{1}\right\rangle \left\langle e_{3}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \left\vert
e_{3}\right\rangle \left\langle e_{1}\right\vert -\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert \left\vert e_{1}\right\rangle
\left\langle e_{3}\right\vert -\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert \left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert
\right)  \right\}  =0.
\end{gather}

\end{enumerate}
\end{example}

\item Metric Matrix elements in $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$%
\begin{align}
&  \left\langle \left.  e_{j_{2}}\wedge e_{k_{2}}\right\vert e_{j_{1}}\wedge
e_{k_{1}}\right\rangle =\frac{1}{4}\left\langle \left.  \left(  e_{j_{2}%
}\otimes e_{k_{2}}-e_{k_{2}}\otimes e_{j_{2}}\right)  \right\vert \left(
e_{j_{1}}\otimes e_{k_{1}}-e_{k_{1}}\otimes e_{j_{1}}\right)  \right\rangle \\
&  =\frac{1}{4}\left\{  \left\langle \left.  e_{j_{2}}\otimes e_{k_{2}%
}\right\vert e_{j_{1}}\otimes e_{k_{1}}\right\rangle -\left\langle \left.
e_{j_{2}}\otimes e_{k_{2}}\right\vert e_{k_{1}}\otimes e_{j_{1}}\right\rangle
-\left\langle \left.  e_{k_{2}}\otimes e_{j_{2}}\right\vert e_{j_{1}}\otimes
e_{k_{1}}\right\rangle +\left\langle \left.  e_{k_{2}}\otimes e_{j_{2}%
}\right\vert e_{k_{1}}\otimes e_{j_{1}}\right\rangle \right\} \\
&  =\frac{1}{4}\left\{  \delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}-\delta
_{k_{2}j_{1}}\delta_{k_{1}j_{2}}-\delta_{k_{2}j_{1}}\delta_{k_{1}j_{2}}%
+\delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}\right\}  =\frac{1}{2}\left\{
\delta_{j_{1}j_{2}}\delta_{k_{1}k_{2}}-\delta_{k_{2}j_{1}}\delta_{k_{1}j_{2}%
}\right\}  .
\end{align}


\item Orthonormal vectors in $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$
\begin{equation}
\left\vert e_{j_{1}}e_{k_{1}}\right\rangle =\sqrt{2}\left\vert e_{j_{1}}\wedge
e_{k_{1}}\right\rangle .
\end{equation}
\label{Correspondence between Operatotrs and Geminals}
\end{enumerate}
\end{remark}

\begin{definition}
\emph{Real} linear Hilbert space isometric isomorphism $\mathcal{\Xi
}_{\left\vert VV\right\rangle }^{-1}$
\begin{gather}
\mathcal{\Xi}_{\left\vert VV\right\rangle }^{-1}:\mathcal{B}_{asa}\left(
V\right)  \rightarrow%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\\
\mathcal{\Xi}_{\left\vert VV\right\rangle }^{-1}\left(  \overset{}{\left\vert
v_{1}\right\rangle \left\langle v_{2}\right\vert -\left\vert v_{2}%
\right\rangle \left\langle v_{1}\right\vert }\right)  =2\left\vert v_{1}\wedge
v_{2}\right\rangle
\end{gather}

\end{definition}

\begin{remark}
\begin{enumerate}
\item Let
\begin{equation}
B=\sum_{1\leq j,k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  B\right)  _{jk}%
\end{equation}
then one can define an anti self adjoint element $A$ by
\begin{align}
A  &  =B-B^{\dagger}=\sum_{1\leq j,k\leq n}\left\vert e_{j}\right\rangle
\left\langle e_{k}\right\vert \mathcal{R}_{e}\left(  B\right)  _{jk}%
-\sum_{1\leq j,k\leq n}\left\vert e_{k}\right\rangle \left\langle
e_{j}\right\vert \overline{\mathcal{R}_{e}\left(  B\right)  }_{jk}\\
&  =\sum_{1\leq j,k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  B\right)  _{jk}-\sum_{1\leq j,k\leq
n}\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \mathcal{R}%
_{e}\left(  B^{\dagger}\right)  _{kj}\\
&  =\sum_{1\leq j,k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  B\right)  _{jk}-\sum_{1\leq j,k\leq
n}\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \mathcal{R}%
_{e}\left(  B^{\dagger}\right)  _{jk}\\
&  =\sum_{1\leq j,k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \left(  \mathcal{R}_{e}\left(  B\right)  _{jk}-\mathcal{R}%
_{e}\left(  B^{\dagger}\right)  _{jk}\right)  =\sum_{1\leq j,k\leq
n}\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \mathcal{R}%
_{e}\left(  B-B^{\dagger}\right)  _{jk}=\sum_{1\leq j,k\leq n}\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert \mathcal{R}_{e}\left(
A\right)  _{jk}\\
&  =\sum_{1\leq j<k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  B-B^{\dagger}\right)  _{jk}%
+\sum_{1\leq j>k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  B-B^{\dagger}\right)  _{jk}\\
&  =\sum_{1\leq j,k\leq n}\left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  B-B^{\dagger}\right)  _{jk},
\end{align}
which is equivalent to
\begin{equation}
A=B-B^{\dagger}=\left\vert \overset{}{\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert }\right\rangle \left\langle
\overset{}{\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert }\right\vert \left\vert \overset{}{A}\right\rangle =\left\vert
\overset{}{\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert _{a}}\right\rangle \left\langle \overset{}{\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert }_{a}\right\vert
\left\vert \overset{}{A}\right\rangle ,
\end{equation}
where
\begin{equation}
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert _{a}=\frac
{1}{\sqrt{2}}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}%
\right\vert -\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  ,\,1\leq j<k\leq2m.
\end{equation}


\item Every $G$ $\in\mathcal{B}_{asa}\left(  V\right)  $ determines an element
$\left\vert g\right\rangle =\mathcal{\Xi}_{\left\vert VV\right\rangle }%
^{-1}\left(  G\right)  \in%
%TCIMACRO{\tbigwedge ^{2}}%
%BeginExpansion
{\textstyle\bigwedge^{2}}
%EndExpansion
V$ by
\begin{gather}
\mathcal{\Xi}_{\left\vert VV\right\rangle }:%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V\rightarrow\mathcal{B}_{asa}\left(  V\right) \\
\mathcal{\Xi}_{\left\vert VV\right\rangle }^{-1}\left(  G\right)
=\mathcal{\Xi}_{\left\vert VV\right\rangle }^{-1}\left(  \sum_{1\leq
j<k\leq2m}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
\mathcal{R}_{e}\left(  g\right)  _{jk}\right)  =\sum_{1\leq j<k\leq
2m}\left\vert e_{j}\wedge e_{k}\right\rangle \mathcal{R}_{e}\left(  g\right)
_{jk}=\sqrt{2}\sum_{1\leq j<k\leq2m}\left\vert e_{j}e_{k}\right\rangle
\mathcal{R}_{e}\left(  g\right)  _{jk}=\left\vert g\right\rangle ,
\end{gather}
where
\begin{equation}
\mathcal{R}_{e}\left(  g\right)  _{kj}=\left\{
\begin{array}
[c]{c}%
-\mathcal{R}_{e}\left(  g\right)  _{jk},\,1\leq j<k\leq2m\\
\,\,\,0,\quad1\leq j=k\leq2m
\end{array}
\right.
\end{equation}
so that $\mathcal{R}_{e}\left(  G\right)  _{jk}=-\mathcal{R}_{e}\left(
g\right)  _{jk},\,1\leq j,k\leq2m.$

\item The operator $G$ $\in\mathcal{B}_{asa}\left(  V\right)  $ can be
expanded as \label{06/30/2025 copy(1)}
\begin{equation}
G=\left\vert \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert _{a}}\right\rangle \left\langle \overset{}{\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert }_{a}\right\vert
\left\vert \overset{}{G}\right\rangle
\end{equation}
and the action of the real \emph{vector space isomorphism} $\mathcal{\Xi
}_{\left\vert VV\right\rangle }^{-1}$
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }^{-1}:\mathcal{B}_{asa}\left(
V\right)  \rightarrow%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V
\end{equation}
expressed as
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }^{-1}\left(  \overset{}{\left\vert
\overset{}{\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert _{a}}\right\rangle \left\langle \left.  \overset{}{\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert }_{a}\right\vert
\overset{}{G}\right\rangle }\right)  =\left\vert \overset{}{\mathbf{ee}%
}\right\rangle \left\langle \left.  \overset{}{\mathbf{ee}}\right\vert
\overset{}{g}\right\rangle =\left\vert \overset{}{\mathbf{ee}}\right\rangle
\left\langle \left.  \overset{}{\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert _{a}}\right\vert \overset{}{G}\right\rangle
,
\end{equation}
i.e.
\begin{equation}
\left\langle \left.  \overset{}{\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert }_{a}\right\vert \overset{}{G}\right\rangle
=\left\langle \left.  \overset{}{\mathbf{ee}}\right\vert \overset{}{g}%
\right\rangle .
\end{equation}


\item Transformations of Bra and Kets
\begin{align}
\left\vert e_{j}\right\rangle  &  =\sum_{1\leq p\leq n}\left\vert
f_{p}\right\rangle u_{pj}\\
\left\langle e_{j}\right\vert  &  =\sum_{1\leq p\leq n}u_{jp}^{\dagger
}\left\langle f_{p}\right\vert \\
\left\vert e_{k}\right\rangle  &  =\sum_{1\leq q\leq n}\left\vert
f_{q}\right\rangle u_{qk}\\
\left\langle e_{k}\right\vert  &  =\sum_{1\leq q\leq n}u_{kq}^{\dagger
}\left\langle f_{q}\right\vert .
\end{align}


\item
\begin{align}
A  &  =\sum_{1\leq j<k\leq n}\left(  \sum_{1\leq p\leq n}\left\vert
f_{p}\right\rangle u_{pj}\sum_{1\leq q\leq n}\left\langle f_{q}\right\vert
\overline{u_{qk}}-\sum_{1\leq q\leq n}\left\vert f_{q}\right\rangle u_{qk}%
\sum_{1\leq p\leq n}\left\langle f_{p}\right\vert \overline{u_{pj}}\right)
\mathcal{R}_{e}\left(  A\right)  _{jk}\\
&  =\frac{1}{2}\sum_{1\leq j,k\leq n}\sum_{\substack{1\leq p\leq n\\1\leq
q\leq n}}\left(  u_{pj}\left\vert f_{p}\right\rangle \left\langle
f_{q}\right\vert \overline{u_{qk}}-u_{qk}\left\vert f_{q}\right\rangle
\left\langle f_{p}\right\vert \overline{u_{pj}}\right)  \mathcal{R}_{e}\left(
A\right)  _{jk}\\
&  =\frac{1}{2}\sum_{\substack{1\leq p\leq n\\1\leq q\leq n}}\sum_{1\leq
j,k\leq n}\left(  u_{pj}\left\vert f_{p}\right\rangle \left\langle
f_{q}\right\vert \overline{u_{qk}}-u_{qk}\left\vert f_{q}\right\rangle
\left\langle f_{p}\right\vert \overline{u_{pj}}\right)  \mathcal{R}_{e}\left(
A\right)  _{jk}\\
&  =\frac{1}{2}\sum_{\substack{1\leq p\leq n\\1\leq q\leq n}}\sum_{1\leq
j,k\leq n}\left(  u_{pj}\left\vert f_{p}\right\rangle \left\langle
f_{q}\right\vert \overline{u_{qk}}\mathcal{R}_{e}\left(  A\right)
_{jk}-u_{qk}\left\vert f_{q}\right\rangle \left\langle f_{p}\right\vert
\overline{u_{pj}}\mathcal{R}_{e}\left(  A\right)  _{jk}\right) \\
&  =\frac{1}{2}\sum_{\substack{1\leq p\leq n\\1\leq q\leq n}}\sum_{1\leq
j,k\leq n}\left(  \left\vert f_{p}\right\rangle \left\langle f_{q}\right\vert
\overline{u_{qk}}\mathcal{R}_{e}\left(  A\right)  _{jk}u_{pj}-\left\vert
f_{q}\right\rangle \left\langle f_{p}\right\vert \overline{u_{pj}}%
\mathcal{R}_{e}\left(  A\right)  _{jk}u_{qk}\right) \\
&  =\frac{1}{2}\sum_{\substack{1\leq p\leq n\\1\leq q\leq n}}\left(
\left\vert f_{p}\right\rangle \left\langle f_{q}\right\vert \sum_{1\leq
j,k\leq n}\overline{u_{qk}}\mathcal{R}_{e}\left(  A\right)  _{jk}%
u_{pj}-\left\vert f_{q}\right\rangle \left\langle f_{p}\right\vert \sum_{1\leq
j,k\leq n}u_{qk}\mathcal{R}_{e}\left(  A\right)  _{jk}\overline{u_{pj}%
}\right)  .
\end{align}

\end{enumerate}
\end{remark}

\begin{remark}
The map $\mathcal{\Xi}_{\left\vert VV\right\rangle }$ is not complex linear
but is real linear i.e.

\begin{enumerate}
\item
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  z_{1}g_{1}+z_{2}%
g_{2}\right)  \neq z_{1}\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(
g_{1}\right)  +z_{2}\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(
g_{2}\right)  ,\text{ unless }z_{1},z_{2}\in\mathbb{R}.
\end{equation}


\item
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  z_{1}g_{1}\right)  \neq
z_{1}\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  g_{1}\right)
\end{equation}


\item
\begin{equation}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  z_{1}\left\vert e_{1}\wedge
e_{2}\right\rangle \right)  =z_{1}\left(  \left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \right)
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
Expansion of geminals
\begin{gather}
\left\vert g\right\rangle =\sum_{1\leq j<k\leq2m}\left\vert f_{j}%
f_{k}\right\rangle \mathcal{R}_{f}\left(  g\right)  _{jk}=\sum_{1\leq
j<k\leq2m}\left\vert ue_{j}ue_{k}\right\rangle \mathcal{R}_{f}\left(
g\right)  _{jk}=\frac{1}{2}\sum_{1\leq j,k\leq2m}\sum_{1\leq p,q\leq
2m}\left\vert e_{p}e_{q}\right\rangle \mathcal{R}_{e}\left(  u\right)
_{pj}\mathcal{R}_{e}\left(  u\right)  _{qk}\mathcal{R}_{f}\left(  g\right)
_{jk}\\
=\frac{1}{2}\sum_{1\leq j,k\leq2m}\sum_{1\leq p,q\leq2m}\left\vert e_{p}%
e_{q}\right\rangle \mathcal{R}_{e}\left(  u\right)  _{pj}\mathcal{R}%
_{f}\left(  g\right)  _{jk}\mathcal{R}_{e}\left(  u\right)  _{kq}^{t}%
=\sum_{1\leq p<q\leq2m}\left\vert e_{p}e_{q}\right\rangle \mathcal{R}%
_{e}\left(  g\right)  _{pq},
\end{gather}
hence
\begin{equation}
\mathcal{R}_{e}\left(  g\right)  _{pq}=\sum_{1\leq j,k\leq2m}\mathcal{R}%
_{e}\left(  u\right)  _{pj}\mathcal{R}_{f}\left(  g\right)  _{jk}%
\mathcal{R}_{e}\left(  u\right)  _{kq}^{t},
\end{equation}
i.e.%
\begin{equation}
R_{e}\left(  g\right)  =R_{e}\left(  u\right)  R_{f}\left(  g\right)
R_{e}\left(  u\right)  ^{t}.
\end{equation}

\end{remark}

\begin{notation}
Bases of $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$%
\begin{equation}
\left\vert \mathbf{ee}\right\rangle =\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}e_{2}\right\rangle  & \cdots & \left\vert e_{n-1}%
e_{n}\right\rangle
\end{array}
\right)  .
\end{equation}

\end{notation}

\begin{remark}
Expansions of geminals
\end{remark}

\begin{enumerate}
\item Orthonormal bases of $%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$ are related by
\begin{equation}
\left\vert \mathbf{ff}\right\rangle =\left\vert \left(  u\mathbf{e}%
_{1}\right)  \left(  u\mathbf{e}_{2}\right)  \right\rangle =\left(  u\boxtimes
u\right)  \left\vert \mathbf{e}_{1}\mathbf{e}_{2}\right\rangle =\left\vert
\mathbf{ee}\right\rangle \mathcal{R}_{e}\left(  u\boxtimes u\right)
\end{equation}


\item giving%
\begin{equation}
g=\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{e}\left(  g\right)
=\sqrt{2}\left\vert \mathbf{e}\wedge\mathbf{e}\right\rangle \mathcal{R}%
_{e}\left(  g\right)  =\left\vert \mathbf{ff}\right\rangle \mathcal{R}%
_{f}\left(  g\right)  =\sqrt{2}\left\vert \mathbf{f}_{1}\wedge\mathbf{f}%
_{2}\right\rangle \mathcal{R}_{f}\left(  g\right)  =\sqrt{2}\left\vert
\mathbf{f}_{1}\wedge\mathbf{f}_{2}\right\rangle \mathcal{R}_{e}\left(
u\right)  ^{t}\mathcal{R}_{e}\left(  g\right)  \mathcal{R}_{e}\left(
u\right)
\end{equation}


\item and%
\begin{equation}
g=\left\vert \mathbf{ff}\right\rangle \mathcal{R}_{f}\left(  g\right)
=\left(  u\boxtimes u\right)  \left\vert \mathbf{ee}\right\rangle
\mathcal{R}_{f}\left(  g\right)  =\left\vert \mathbf{ee}\right\rangle
\mathcal{R}_{e}\left(  u\boxtimes u\right)  \mathcal{R}_{f}\left(  g\right)
=\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{e}\left(  g\right)
=\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{e}\left(  u\right)
\mathcal{R}_{f}\left(  g\right)  \mathcal{R}_{e}\left(  u\right)  ^{t}.
\end{equation}


\item Hence
\begin{equation}
\mathcal{R}_{e}\left(  u\boxtimes u\right)  \mathcal{R}_{f}\left(  g\right)
=\mathcal{R}_{e}\left(  u\right)  \mathcal{R}_{f}\left(  g\right)
R_{e}\left(  u\right)  ^{t}.
\end{equation}

\end{enumerate}

\begin{remark}
Resolution of the identity%
\begin{equation}
I_{V}=\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert
=\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert
\end{equation}

\end{remark}

\begin{remark}
Different representation of operators
\begin{align}
\mathcal{R}_{e}\left(  A\right)   &  =\left\langle \left.  \mathbf{e}%
\right\vert A\mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}%
\right\vert \mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
A\mathbf{f}\right\rangle \left\langle \left.  \mathbf{f}\right\vert
\mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{f}\right\rangle \mathcal{R}_{f}\left(  A\right)  \left\langle \left.
\mathbf{f}\right\vert \mathbf{e}\right\rangle \\
\mathcal{R}_{f}\left(  A\right)   &  =\left\langle \left.  \mathbf{f}%
\right\vert A\mathbf{f}\right\rangle =\left\langle \left.  \mathbf{f}%
\right\vert \mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
A\mathbf{e}\right\rangle \left\langle \left.  \mathbf{e}\right\vert
\mathbf{f}\right\rangle =\left\langle \left.  \mathbf{f}\right\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{f}\right\rangle \\
A  &  =\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert
A\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert
=\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert
A\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert .
\end{align}

\end{remark}

\begin{remark}
Basis transformation
\begin{align}
\left\vert \mathbf{e}\right\rangle  &  =\left\vert u\mathbf{f}\right\rangle
=u\left\vert \mathbf{f}\right\rangle =\left\vert \mathbf{f}\right\rangle
\mathcal{R}_{f}\left(  u\right) \\
\left\vert \mathbf{f}\right\rangle  &  =\left\vert u^{\dagger}\mathbf{e}%
\right\rangle =u^{\dagger}\left\vert \mathbf{e}\right\rangle =\left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  u^{\dagger}\right)  =\left\vert
\mathbf{e}\right\rangle \mathcal{R}_{e}\left(  u\right)  ^{\dagger}.
\end{align}

\end{remark}

\begin{remark}
Transformation matrices%
\begin{align}
\left\vert \mathbf{e}\right\rangle  &  =\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{f}\right\vert \left\vert \mathbf{f}\right\rangle
=\left\vert \mathbf{f}\right\rangle \mathcal{R}_{f}\left(  u\right)
=\left\vert \mathbf{f}\right\rangle \mathcal{R}_{f}\left(  \left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{f}\right\vert \right)  \quad\\
\text{i.e.\quad}\mathcal{R}_{f}\left(  u\right)   &  =\mathcal{R}_{f}\left(
\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{f}\right\vert \right)
=\left\langle \left.  \mathbf{f}\right\vert \left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{f}\right\vert \mathbf{f}\right\rangle =\left\langle
\left.  \mathbf{f}\right\vert \mathbf{e}\right\rangle \\
\left\vert \mathbf{f}\right\rangle  &  =\left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  u^{\dagger}\right)
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)  \quad\\
\text{i.e.\quad}\mathcal{R}_{e}\left(  u^{\dagger}\right)   &  =\mathcal{R}%
_{e}\left(  u\right)  ^{\dagger}=\mathcal{R}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)
=\mathcal{R}_{e}\left(  u\right)  ^{\dagger}=\left\langle \left.
\mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle \left\langle
\mathbf{e}\right\vert \mathbf{e}\right\rangle =\left\langle \left.
\mathbf{e}\right\vert \mathbf{f}\right\rangle .
\end{align}

\end{remark}

\begin{remark}
Bra and Ket transformations

\begin{enumerate}
\item
\begin{align}
\left\vert f_{j}\right\rangle  &  =\left\vert ue_{j}\right\rangle =\sum_{1\leq
p\leq n}\left\vert e_{p}\right\rangle u_{pj}=\sum_{1\leq p\leq n}\left\vert
e_{p}\right\rangle \mathcal{R}_{e}\left(  u\right)  _{pj}\\
\left\langle f_{k}\right\vert  &  =\sum_{1\leq q\leq n}\left\langle
e_{q}u_{qk}\right\vert =\sum_{1\leq q\leq n}\overline{u_{qk}}\left\langle
e_{q}\right\vert =\sum_{1\leq q\leq n}\overline{\mathcal{R}_{e}\left(
u\right)  }_{qk}\left\langle e_{q}\right\vert =\sum_{1\leq q\leq
n}\left\langle e_{q}\right\vert \mathcal{R}_{e}\left(  u\right)
_{kq}^{\dagger}%
\end{align}


\item
\begin{align}
\left\vert \mathbf{f}\right\rangle  &  =u\left\vert \mathbf{e}\right\rangle
\equiv\left\vert u\mathbf{e}\right\rangle =\left\vert \mathbf{e}\right\rangle
\mathcal{R}_{e}\left(  u\right)  =\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right\rangle  & \cdots & \left\vert e_{n}\right\rangle
\end{array}
\right)  \mathcal{R}_{e}\left(  u\right)  =\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right\rangle  & \cdots & \left\vert e_{n}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  u\right)  _{11} & \cdots & \mathcal{R}_{e}\left(
u\right)  _{1n}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  u\right)  _{n1} & \cdots & \mathcal{R}_{e}\left(
u\right)  _{nn}%
\end{array}
\right) \\
\left\langle \mathbf{f}\right\vert  &  =\left\langle u\mathbf{e}\right\vert
=u^{\dagger}\left\langle \mathbf{e}\right\vert =\mathcal{R}_{e}\left(
u\right)  ^{\dagger}\left\langle \mathbf{e}\right\vert =\mathcal{R}_{e}\left(
u\right)  ^{\dagger}\left(
\begin{array}
[c]{c}%
\left\langle e_{1}\right\vert \\
\vdots\\
\left\langle e_{n}\right\vert
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  u\right)  _{11} & \cdots & \mathcal{R}_{e}\left(
u\right)  _{1n}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  u\right)  _{n1} & \cdots & \mathcal{R}_{e}\left(
u\right)  _{nn}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{c}%
\left\langle e_{1}\right\vert \\
\vdots\\
\left\langle e_{n}\right\vert
\end{array}
\right)
\end{align}


\item Let $A\in\mathcal{B}\left(  V\right)  $ then
\begin{gather}
A=\sum_{1\leq j,k\leq n}\left\vert f_{j}\right\rangle \left\langle
f_{k}\right\vert \mathcal{R}_{f}\left(  A\right)  _{jk}=\sum_{1\leq j,k\leq
n}\left\vert ue_{j}\right\rangle \left\langle ue_{k}\right\vert \mathcal{R}%
_{f}\left(  A\right)  _{jk}=\sum_{1\leq p,q\leq n}\sum_{1\leq j,k\leq
n}\left\vert e_{p}\right\rangle \left\langle e_{q}\right\vert \mathcal{R}%
_{e}\left(  u\right)  _{pj}\mathcal{R}_{f}\left(  A\right)  _{jk}%
\mathcal{R}_{e}\left(  u\right)  _{kq}^{\dagger}\\
=\sum_{1\leq p,q\leq n}\left\vert e_{p}\right\rangle \left\langle
e_{q}\right\vert \left(  \mathcal{R}_{e}\left(  u\right)  \mathcal{R}%
_{f}\left(  A\right)  \mathcal{R}_{e}\left(  u\right)  ^{\dagger}\right)
_{pq}=\sum_{1\leq p,q\leq n}\sum_{1\leq j,k\leq n}\left\vert e_{p}%
\right\rangle \left\langle e_{q}\right\vert \mathcal{R}_{e}\left(  A\right)
_{pq},
\end{gather}
hence
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\mathcal{R}_{e}\left(  u\right)
\mathcal{R}_{f}\left(  A\right)  \mathcal{R}_{e}\left(  u\right)  ^{\dagger}.
\end{equation}


\item This gives
\begin{equation}
\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert
=\widehat{u}\left(  \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right)  =\left\vert u\mathbf{e}\right\rangle
\left\langle u\mathbf{e}\right\vert =u\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert u^{\dagger}=\left\vert \mathbf{e}%
\right\rangle \left\langle \mathbf{e}\right\vert ,
\end{equation}
as
\begin{equation}
\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}\right\vert
=u\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert
u^{\dagger}=\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}%
\right\vert \mathcal{R}_{e}\left(  u\right)  \mathcal{R}_{f}\left(  A\right)
\mathcal{R}_{e}\left(  u\right)  ^{\dagger}=\left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert \mathcal{R}_{e}\left(  u\right)
\mathbb{I}_{n}\mathcal{R}_{e}\left(  u\right)  ^{\dagger}=\left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert .
\end{equation}


\item Let $g\in%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
V$ then
\begin{align}
\left\vert g\right\rangle  &  =\left\vert \mathbf{ff}\right\rangle
\mathcal{R}_{f}\left(  g\right)  =\sum_{1\leq j<k\leq2m}\left\vert f_{j}%
f_{k}\right\rangle \mathcal{R}_{f}\left(  g\right)  _{jk}=\left\vert \left(
u\mathbf{e}\right)  \left(  u\mathbf{e}\right)  \right\rangle \mathcal{R}%
_{f}\left(  g\right) \\
&  =\sum_{1\leq j<k\leq2m}\left\vert e_{j}e_{k}\right\rangle \left(
R_{e}\left(  u\right)  R_{f}\left(  g\right)  R_{e}\left(  u\right)
^{t}\right)  _{jk}=\sum_{1\leq j<k\leq2m}\left\vert e_{j}e_{k}\right\rangle
\mathcal{R}_{e}\left(  g\right)  _{jk}=\left\vert \mathbf{ee}\right\rangle
\mathcal{R}_{e}\left(  g\right)  ,
\end{align}
hence%
\begin{equation}
\mathcal{R}_{e}\left(  g\right)  =R_{e}\left(  u\right)  R_{f}\left(
g\right)  R_{e}\left(  u\right)  ^{t}.
\end{equation}


\item
\begin{gather}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  g\right)  =\mathcal{\Xi
}_{\left\vert VV\right\rangle }\left(  \left\vert \mathbf{ff}\right\rangle
\mathcal{R}_{f}\left(  g\right)  \right)  =\mathcal{\Xi}_{\left\vert
VV\right\rangle }\left(  \sum_{1\leq j<k\leq2m}\left\vert f_{j}f_{k}%
\right\rangle \mathcal{R}_{f}\left(  g\right)  _{jk}\right) \\
=\sum_{1\leq j<k\leq2m}\left(  \left\vert f_{j}\right\rangle \left\langle
f_{k}\right\vert -\left\vert f_{k}\right\rangle \left\langle f_{j}\right\vert
\right)  \mathcal{R}_{f}\left(  g\right)  _{jk}=\sum_{1\leq j<k\leq2m}\left\{
\left\vert f_{j}\right\rangle \left\langle f_{k}\right\vert \mathcal{R}%
_{f}\left(  g\right)  _{jk}-\left\vert f_{k}\right\rangle \left\langle
f_{j}\right\vert \mathcal{R}_{f}\left(  g\right)  _{jk}\right\} \\
=\sum_{1\leq j<k\leq2m}\left\{  \left\vert f_{j}\right\rangle \left\langle
f_{k}\right\vert \mathcal{R}_{f}\left(  g\right)  _{jk}-\left\vert
f_{k}\right\rangle \left\langle f_{j}\right\vert \mathcal{R}_{f}\left(
g\right)  _{kj}^{t}\right\}  =\frac{1}{2}\left\{  \sum_{1\leq j,k\leq
2m}\left\vert f_{j}\right\rangle \left\langle f_{k}\right\vert \mathcal{R}%
_{f}\left(  g\right)  _{jk}-\sum_{1\leq j,k\leq2m}\left\vert f_{k}%
\right\rangle \left\langle f_{j}\right\vert \mathcal{R}_{f}\left(  g\right)
_{kj}^{t}\right\}  .
\end{gather}


\item
\begin{gather}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  g\right)  =\mathcal{\Xi
}_{\left\vert VV\right\rangle }\left(  \left\vert \mathbf{ee}\right\rangle
\mathcal{R}_{e}\left(  g\right)  \right)  =\mathcal{\Xi}_{\left\vert
VV\right\rangle }\left(  \sum_{1\leq j<k\leq2m}\left\vert e_{j}e_{k}%
\right\rangle \mathcal{R}_{e}\left(  g\right)  _{jk}\right) \\
=\sum_{1\leq j<k\leq2m}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert -\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  \mathcal{R}_{e}\left(  g\right)  _{jk}=\sum_{1\leq j<k\leq2m}\left\{
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \mathcal{R}%
_{e}\left(  g\right)  _{jk}-\left\vert e_{k}\right\rangle \left\langle
e_{j}\right\vert \mathcal{R}_{e}\left(  g\right)  _{jk}\right\} \\
=\sum_{1\leq j<k\leq2m}\left\{  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert \mathcal{R}_{e}\left(  g\right)  _{jk}-\left\vert
e_{k}\right\rangle \left\langle e_{j}\right\vert \mathcal{R}_{e}\left(
g\right)  _{kj}^{t}\right\}  =\frac{1}{2}\left\{  \sum_{1\leq j,k\leq
2m}\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert \mathcal{R}%
_{e}\left(  g\right)  _{jk}-\sum_{1\leq j,k\leq2m}\left\vert e_{k}%
\right\rangle \left\langle e_{j}\right\vert \mathcal{R}_{e}\left(  g\right)
_{kj}^{t}\right\}  .
\end{gather}


\item
\begin{gather}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  g\right)  =\sum_{1\leq
j,k\leq2m}\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
\mathcal{R}_{e}\left(  g\right)  _{jk}=\sum_{1\leq j,k\leq2m}\left\vert
f_{j}\right\rangle \left\langle f_{k}\right\vert \mathcal{R}_{f}\left(
g\right)  _{jk}\\
=\left\vert \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right\rangle \mathcal{R}_{e}\left(  g\right)
=\left\vert \overset{}{\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{e}\right\vert }\right\rangle \mathcal{R}_{e}\left(  u\right)
\mathcal{R}_{f}\left(  g\right)  R_{e}\left(  u\right)  ^{t}=\left\vert
\overset{}{\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}%
\right\vert }\right\rangle \mathcal{R}_{f}\left(  g\right)  =\left\vert
\overset{}{\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{f}%
\right\vert }\right\rangle \mathcal{R}_{f}\left(  u^{\dagger}\right)
\mathcal{R}_{e}\left(  g\right)  R_{f}\left(  u^{\dagger}\right)  ^{t}.
\end{gather}


\item
\begin{align}
\mathcal{\Xi}_{\left\vert VV\right\rangle }\left(  g\right)   &  =\sum_{1\leq
j<k\leq2m}\left(  \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
-\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert \right)
\mathcal{R}_{e}\left(  g\right)  _{jk}=\sum_{1\leq j<k\leq2m}\left(
\sum_{1\leq p\leq n}\left\vert f_{p}\right\rangle u_{pj}\sum_{1\leq q\leq
n}\left\langle f_{q}\right\vert \overline{u_{qk}}-\sum_{1\leq q\leq
n}\left\vert f_{q}\right\rangle u_{qk}\sum_{1\leq p\leq n}\left\langle
f_{p}\right\vert \overline{u_{pj}}\right)  \mathcal{R}_{e}\left(  g\right)
_{jk}\\
&  =\sum_{1\leq j<k\leq2m}\sum_{\substack{1\leq p\leq n\\1\leq q\leq
n}}\left(  u_{pj}\left\vert f_{p}\right\rangle \left\langle f_{q}\right\vert
\overline{u_{qk}}-u_{qk}\left\vert f_{q}\right\rangle \left\langle
f_{p}\right\vert \overline{u_{pj}}\right)  \mathcal{R}_{e}\left(  g\right)
_{jk}\\
&  =\sum_{1\leq j<k\leq2m}\sum_{\substack{1\leq p\leq n\\1\leq q\leq
n}}\left(  \mathcal{R}_{e}\left(  u\right)  _{jp}^{t}\left\vert f_{p}%
\right\rangle \left\langle f_{q}\right\vert \overline{\mathcal{R}_{e}\left(
u\right)  }_{qk}-\mathcal{R}_{e}\left(  u\right)  _{qk}^{t}\left\vert
f_{q}\right\rangle \left\langle f_{p}\right\vert \overline{\mathcal{R}%
_{e}\left(  u\right)  }_{pj}\right)  \mathcal{R}_{e}\left(  g\right)  _{jk}\\
&  =\sum_{1\leq j<k\leq2m}\sum_{\substack{1\leq p\leq n\\1\leq q\leq
n}}\left\{  \left\vert f_{p}\right\rangle \left\langle f_{q}\right\vert
\overline{\mathcal{R}_{e}\left(  u\right)  }_{qk}\mathcal{R}_{e}\left(
g\right)  _{jk}\mathcal{R}_{e}\left(  u\right)  _{jp}^{t}-\left\vert
f_{q}\right\rangle \left\langle f_{p}\right\vert \overline{\mathcal{R}%
_{e}\left(  u\right)  }_{pj}\mathcal{R}_{e}\left(  g\right)  _{jk}%
\mathcal{R}_{e}\left(  u\right)  _{kq}^{t}\right\}  .
\end{align}

\end{enumerate}
\end{remark}

\begin{remark}
Using the parameteriztion of conbs produced by unitary transformations of a
fixed reference basis gives

\begin{enumerate}
\item
\begin{equation}
\left\vert g\right\rangle =\left\vert \overset{}{\mathbf{e\left(
\mathbf{0}\right)  e}\left(  \mathbf{0}\right)  }\right\rangle \left\langle
\left.  \overset{}{\mathbf{e\left(  \mathbf{0}\right)  e}\left(
\mathbf{0}\right)  }\right\vert \overset{}{g}\right\rangle =\sum_{1\leq
j<k\leq2m}\left\vert e_{j}e_{k}\right\rangle \mathcal{R}_{e}\left(  g\right)
_{jk}%
\end{equation}


\item
\begin{equation}
\left\vert g\right\rangle =\left\vert \overset{}{\mathbf{e\left(
\mathbf{\eta}\right)  e}\left(  \mathbf{\eta}\right)  }\right\rangle
\left\langle \left.  \overset{}{\mathbf{e\left(  \mathbf{\eta}\right)
e}\left(  \mathbf{\eta}\right)  }\right\vert \overset{}{g}\right\rangle
=\sum_{1\leq j<k\leq2m}\left\vert e\left(  \mathbf{\eta}\right)  _{j}e\left(
\mathbf{\eta}\right)  _{k}\right\rangle \mathcal{R}_{e}\left(  g\right)
_{jk}=\sum_{1\leq j<k\leq2m}\left\vert e\left(  \mathbf{\lambda}\right)
_{j}e\left(  \mathbf{\lambda}\right)  _{k}\right\rangle \mathcal{R}_{e}\left(
g\right)  _{jk}%
\end{equation}


\item
\begin{equation}
G\mathbf{\left(  \mathbf{\eta}\right)  }=\mathcal{\Xi}_{\left\vert
VV\right\rangle }\left(  g,\mathbf{\eta}\right)  =\mathcal{\Xi}_{\left\vert
VV\right\rangle }\left(  \left\vert \overset{}{\mathbf{e\left(  \mathbf{\eta
}\right)  e}\left(  \mathbf{\eta}\right)  }\right\rangle \left\langle \left.
\overset{}{\mathbf{e\left(  \mathbf{\eta}\right)  e}\left(  \mathbf{\eta
}\right)  }\right\vert \overset{}{g}\right\rangle \right)
=\overset{}{\left\vert \overset{}{\left\vert \mathbf{e}\left(  \mathbf{\eta
}\right)  \right\rangle \left\langle \mathbf{e}\left(  \mathbf{\eta}\right)
\right\vert _{a}}\right\rangle \left\langle \left.  \overset{}{\left\vert
\mathbf{e}\left(  \mathbf{\eta}\right)  \right\rangle \left\langle
\mathbf{e}\left(  \mathbf{\eta}\right)  \right\vert }_{a}\right\vert
\overset{}{G}\left(  \mathbf{0}\right)  \right\rangle }%
\end{equation}


\item
\begin{align}
\left\vert g\right\rangle  &  =\mathcal{\Xi}_{\left\vert VV\right\rangle
}^{-1}\left(  G\mathbf{\left(  \mathbf{\eta}\right)  }\right)  =\mathcal{\Xi
}_{\left\vert VV\right\rangle }^{-1}\left(  \overset{}{\left\vert
\overset{}{\left\vert \mathbf{e}\left(  \mathbf{\eta}\right)  \right\rangle
\left\langle \mathbf{e}\left(  \mathbf{\eta}\right)  \right\vert _{a}%
}\right\rangle \left\langle \left.  \overset{}{\left\vert \mathbf{e}\left(
\mathbf{\eta}\right)  \right\rangle \left\langle \mathbf{e}\left(
\mathbf{\eta}\right)  \right\vert }_{a}\right\vert \overset{}{G}\left(
\mathbf{0}\right)  \right\rangle }\right) \\
&  =\left\vert \overset{}{\mathbf{e\left(  \mathbf{\eta}\right)  e}\left(
\mathbf{\eta}\right)  }\right\rangle \left\langle \left.
\overset{}{\mathbf{e\left(  \mathbf{\eta}\right)  e}\left(  \mathbf{\eta
}\right)  }\right\vert \overset{}{g}\right\rangle =\left\vert
\overset{}{\mathbf{e\left(  \mathbf{\eta}\right)  e}\left(  \mathbf{\eta
}\right)  }\right\rangle \left\langle \left.  \overset{}{\left\vert
\mathbf{e}\left(  \mathbf{\eta}\right)  \right\rangle \left\langle
\mathbf{e}\left(  \mathbf{\eta}\right)  \right\vert _{a}}\right\vert
\overset{}{G}\left(  \mathbf{0}\right)  \right\rangle
\end{align}

\end{enumerate}
\end{remark}

\begin{lemma}%
\begin{equation}
\left\vert v\right\rangle \neq e^{i\theta}\left\vert v\right\rangle \text{
unless }\theta=2n\pi
\end{equation}

\end{lemma}

\begin{proof}%
\begin{gather}
\left\Vert \left(  \left\vert v\right\rangle -e^{i\theta}\left\vert
v\right\rangle \right)  \right\Vert ^{2}=\left\langle \left.  \left(
\left\vert v\right\rangle -e^{i\theta}\left\vert v\right\rangle \right)
\right\vert \left(  \left\vert v\right\rangle -e^{i\theta}\left\vert
v\right\rangle \right)  \right\rangle \\
=\left\langle \left.  v\right\vert v\right\rangle -\left\langle \left.
v\right\vert e^{i\theta}v\right\rangle -\left\langle \left.  e^{i\theta
}\left\vert v\right\rangle \right\vert v\right\rangle +\left\langle \left.
e^{i\theta}v\right\vert e^{i\theta}v\right\rangle \\
=\left\langle \left.  v\right\vert v\right\rangle -e^{i\theta}\left\langle
\left.  v\right\vert v\right\rangle -e^{-i\theta}\left\langle \left.
v\right\vert v\right\rangle +\left\langle \left.  v\right\vert v\right\rangle
\\
=\left(  2-\left(  e^{i\theta}+e^{-i\theta}\right)  \right)  \left\langle
\left.  v\right\vert v\right\rangle \\
=\left(  2-\left(  \overset{}{\cos\left(  \theta\right)  -i\sin\left(
\theta\right)  +\cos\left(  -\theta\right)  -i\sin\left(  -\theta\right)
}\right)  \right)  \left\langle \left.  v\right\vert v\right\rangle \\
=2\left(  1-\cos\left(  \theta\right)  \right)  \left\langle \left.
v\right\vert v\right\rangle \blacksquare
\end{gather}

\end{proof}

\begin{remark}
Consider

\begin{enumerate}
\item
\begin{gather}
g=\sum_{1\leq j<k\leq4}\left\vert e_{j}\wedge e_{k}\right\rangle
\mathcal{R}_{e}\left(  g\right)  _{jk}\\
\parallel\\
\left\vert e_{1}\wedge e_{2}\right\rangle \mathcal{R}_{e}\left(  g\right)
_{12}+\left\vert e_{1}\wedge e_{3}\right\rangle \mathcal{R}_{e}\left(
g\right)  _{13}+\left\vert e_{1}\wedge e_{4}\right\rangle \mathcal{R}%
_{e}\left(  g\right)  _{14}+\left\vert e_{2}\wedge e_{3}\right\rangle
\mathcal{R}_{e}\left(  g\right)  _{23}+\left\vert e_{2}\wedge e_{4}%
\right\rangle \mathcal{R}_{e}\left(  g\right)  _{jk}+\left\vert e_{3}\wedge
e_{4}\right\rangle \mathcal{R}_{e}\left(  g\right)  _{34}\\
\parallel\\
\left\vert c_{1}\wedge c_{2}\right\rangle \mathcal{R}_{c}\left(  g\right)
_{12}+\left\vert c_{3}\wedge c_{4}\right\rangle \mathcal{R}_{c}\left(
g\right)  _{34}%
\end{gather}
and

\item 

\begin{enumerate}
\item
\begin{gather}
G=\sum_{1\leq j<k\leq4}\left(  \left\vert e_{j}\right\rangle \left\langle
e_{k}\right\vert -\left\vert e_{k}\right\rangle \left\langle e_{j}\right\vert
\right)  \mathcal{R}_{e}\left(  g\right)  _{jk}\\
\parallel\\
\left(  \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \right)
\mathcal{R}_{e}\left(  g\right)  _{12}+\left(  \left\vert e_{1}\right\rangle
\left\langle e_{3}\right\vert -\left\vert e_{3}\right\rangle \left\langle
e_{1}\right\vert \right)  \mathcal{R}_{e}\left(  g\right)  _{13}+\left(
\left\vert e_{1}\right\rangle \left\langle e_{4}\right\vert -\left\vert
e_{4}\right\rangle \left\langle e_{1}\right\vert \right)  \mathcal{R}%
_{e}\left(  g\right)  _{14}\\
+\left(  \left\vert e_{2}\right\rangle \left\langle e_{3}\right\vert
-\left\vert e_{3}\right\rangle \left\langle e_{2}\right\vert \right)
\mathcal{R}_{e}\left(  g\right)  _{23}+\left(  \left\vert e_{2}\right\rangle
\left\langle e_{4}\right\vert -\left\vert e_{4}\right\rangle \left\langle
e_{2}\right\vert \right)  \mathcal{R}_{e}\left(  g\right)  _{24}+\left(
\left\vert e_{3}\right\rangle \left\langle e_{4}\right\vert -\left\vert
e_{4}\right\rangle \left\langle e_{3}\right\vert \right)  \mathcal{R}%
_{e}\left(  g\right)  _{34}\\
\parallel\\
\left(  \left\vert c_{1}\right\rangle \left\langle c_{2}\right\vert
-\left\vert c_{2}\right\rangle \left\langle c_{1}\right\vert \right)
\mathcal{R}_{c}\left(  g\right)  _{12}+\left(  \left\vert c_{3}\right\rangle
\left\langle c_{4}\right\vert -\left\vert c_{4}\right\rangle \left\langle
c_{3}\right\vert \right)  \mathcal{R}_{c}\left(  g\right)  _{34}%
\end{gather}


\item The spectral decomposition of $G$\ is given by
\begin{equation}
G=\sum_{1\leq j\leq4}\left\vert c_{j}\right\rangle \left\langle c_{j}%
\right\vert \mathcal{R}_{c}\left(  g\right)  _{jj},
\end{equation}
where
\begin{equation}
\mathbb{V}^{\dagger}\mathcal{R}_{e}\left(  g\right)  \mathbb{V}=\mathcal{R}%
_{c}\left(  g\right)  \Leftrightarrow\mathcal{R}_{e}\left(  g\right)
\mathbb{V}=\mathbb{V}\mathcal{R}_{c}\left(  g\right)
\end{equation}
i.e. 

\item
\begin{align}
& \left(
\begin{array}
[c]{cccc}%
\mathcal{R}_{e}\left(  v\right)  _{11} & \mathcal{R}_{e}\left(  v\right)
_{12} & \mathcal{R}_{e}\left(  v\right)  _{13} & \mathcal{R}_{e}\left(
v\right)  _{14}\\
\mathcal{R}_{e}\left(  v\right)  _{21} & \mathcal{R}_{e}\left(  v\right)
_{22} & \mathcal{R}_{e}\left(  v\right)  _{23} & \mathcal{R}_{e}\left(
v\right)  _{23}\\
\mathcal{R}_{e}\left(  v\right)  _{31} & \mathcal{R}_{e}\left(  v\right)
_{32} & \mathcal{R}_{e}\left(  v\right)  _{33} & \mathcal{R}_{e}\left(
v\right)  _{33}\\
\mathcal{R}_{e}\left(  v\right)  _{41} & \mathcal{R}_{e}\left(  v\right)
_{42} & \mathcal{R}_{e}\left(  v\right)  _{44} & \mathcal{R}_{e}\left(
v\right)  _{44}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cccc}%
0 & \mathcal{R}_{e}\left(  g\right)  _{12} & \mathcal{R}_{e}\left(  g\right)
_{13} & \mathcal{R}_{e}\left(  g\right)  _{14}\\
-\mathcal{R}_{e}\left(  g\right)  _{12} & 0 & \mathcal{R}_{e}\left(  g\right)
_{23} & \mathcal{R}_{e}\left(  g\right)  _{24}\\
-\mathcal{R}_{e}\left(  g\right)  _{13} & -\mathcal{R}_{e}\left(  g\right)
_{23} & 0 & \mathcal{R}_{e}\left(  g\right)  _{34}\\
-\mathcal{R}_{e}\left(  g\right)  _{14} & -\mathcal{R}_{e}\left(  g\right)
_{24} & -\mathcal{R}_{e}\left(  g\right)  _{34} & 0
\end{array}
\right)  \\
& \times\left(
\begin{array}
[c]{cccc}%
\mathcal{R}_{e}\left(  v\right)  _{11} & \mathcal{R}_{e}\left(  v\right)
_{12} & \mathcal{R}_{e}\left(  v\right)  _{13} & \mathcal{R}_{e}\left(
v\right)  _{14}\\
\mathcal{R}_{e}\left(  v\right)  _{21} & \mathcal{R}_{e}\left(  v\right)
_{22} & \mathcal{R}_{e}\left(  v\right)  _{23} & \mathcal{R}_{e}\left(
v\right)  _{23}\\
\mathcal{R}_{e}\left(  v\right)  _{31} & \mathcal{R}_{e}\left(  v\right)
_{32} & \mathcal{R}_{e}\left(  v\right)  _{33} & \mathcal{R}_{e}\left(
v\right)  _{33}\\
\mathcal{R}_{e}\left(  v\right)  _{41} & \mathcal{R}_{e}\left(  v\right)
_{42} & \mathcal{R}_{e}\left(  v\right)  _{44} & \mathcal{R}_{e}\left(
v\right)  _{44}%
\end{array}
\right)  \\
& =^{\dagger}\left(
\begin{array}
[c]{cccc}%
\mathcal{R}_{e}\left(  g\right)  _{11} & 0 & 0 & 0\\
0 & \mathcal{R}_{e}\left(  g\right)  _{22} & 0 & 0\\
0 & 0 & \mathcal{R}_{e}\left(  g\right)  _{33} & 0\\
0 & 0 & 0 & \mathcal{R}_{e}\left(  g\right)  _{44}%
\end{array}
\right)
\end{align}

\end{enumerate}

\item Let
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\left\vert f_{1}\right\rangle  & \left\vert f_{2}\right\rangle
\end{array}
\right)  =u\left(
\begin{array}
[c]{cc}%
\left\vert c_{1}\right\rangle  & \left\vert c_{2}\right\rangle
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left\vert c_{1}\right\rangle  & \left\vert c_{2}\right\rangle
\end{array}
\right)  \mathcal{R}_{c}\left(  u\right)  ,
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
u^{\dagger}u=I_{2}\Leftrightarrow\mathcal{R}_{c}\left(  u\right)  ^{\dagger
}\mathcal{R}_{c}\left(  u\right)  =\mathbb{I}_{2}%
\end{equation}
and

\item
\begin{equation}
\det\left(  u\right)  =\det\left(  \mathcal{R}_{c}\left(  u\right)  \right)
=e^{i\theta\left(  u\right)  }%
\end{equation}
so that
\begin{align}
\left\vert f_{1}\right\rangle  &  =\left\vert c_{1}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{11}+\left\vert c_{2}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{21}\\
\left\vert f_{2}\right\rangle  &  =\left\vert c_{1}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{12}+\left\vert c_{2}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{22}.
\end{align}

\end{enumerate}

\item
\begin{gather}
\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  u\right)  _{11} & \mathcal{R}_{c}\left(  u\right)
_{12}\\
\mathcal{R}_{c}\left(  u\right)  _{21} & \mathcal{R}_{c}\left(  u\right)
_{22}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  u\right)  _{11} & \mathcal{R}_{c}\left(  u\right)
_{12}\\
\mathcal{R}_{c}\left(  u\right)  _{21} & \mathcal{R}_{c}\left(  u\right)
_{22}%
\end{array}
\right)  ^{\dagger}=\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  u\right)  _{11} & \mathcal{R}_{c}\left(  u\right)
_{12}\\
\mathcal{R}_{c}\left(  u\right)  _{21} & \mathcal{R}_{c}\left(  u\right)
_{22}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\overline{\mathcal{R}_{c}\left(  u\right)  _{11}} & \overline{\mathcal{R}%
_{c}\left(  u\right)  _{21}}\\
\overline{\mathcal{R}_{c}\left(  u\right)  _{12}} & \overline{\mathcal{R}%
_{c}\left(  u\right)  _{22}}%
\end{array}
\right)  \\
\parallel\\
\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(
u\right)  _{11}}+\mathcal{R}_{c}\left(  u\right)  _{12}\overline
{\mathcal{R}_{c}\left(  u\right)  _{12}} & \mathcal{R}_{c}\left(  u\right)
_{11}\overline{\mathcal{R}_{c}\left(  u\right)  _{21}}+\mathcal{R}_{c}\left(
u\right)  _{12}\overline{\mathcal{R}_{c}\left(  u\right)  _{22}}\\
\mathcal{R}_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(
u\right)  _{11}}+\mathcal{R}_{c}\left(  u\right)  _{22}\overline
{\mathcal{R}_{c}\left(  u\right)  _{12}} & \mathcal{R}_{c}\left(  u\right)
_{21}\overline{\mathcal{R}_{c}\left(  u\right)  _{21}}+\mathcal{R}_{c}\left(
u\right)  _{22}\overline{\mathcal{R}_{c}\left(  u\right)  _{22}}%
\end{array}
\right)  \\
\parallel\\
\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)
\end{gather}


\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(
u\right)  _{11}}+\mathcal{R}_{c}\left(  u\right)  _{12}\overline
{\mathcal{R}_{c}\left(  u\right)  _{12}}=1\Leftrightarrow\mathcal{R}%
_{c}\left(  u\right)  _{12}\overline{\mathcal{R}_{c}\left(  u\right)  _{12}%
}=1-\mathcal{R}_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(
u\right)  _{11}}%
\end{equation}


\item
\begin{equation}
\mathcal{R}_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(
u\right)  _{21}}+\mathcal{R}_{c}\left(  u\right)  _{12}\overline
{\mathcal{R}_{c}\left(  u\right)  _{22}}=0\Leftrightarrow\mathcal{R}%
_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(  u\right)  _{21}%
}=-\mathcal{R}_{c}\left(  u\right)  _{12}\overline{\mathcal{R}_{c}\left(
u\right)  _{22}}%
\end{equation}


\item
\begin{equation}
\mathcal{R}_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(
u\right)  _{11}}+\mathcal{R}_{c}\left(  u\right)  _{22}\overline
{\mathcal{R}_{c}\left(  u\right)  _{12}}=0\Leftrightarrow\mathcal{R}%
_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(  u\right)  _{11}%
}=-\mathcal{R}_{c}\left(  u\right)  _{22}\overline{\mathcal{R}_{c}\left(
u\right)  _{12}}%
\end{equation}


\item
\begin{equation}
\mathcal{R}_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(
u\right)  _{21}}+\mathcal{R}_{c}\left(  u\right)  _{22}\overline
{\mathcal{R}_{c}\left(  u\right)  _{22}}=1\Leftrightarrow\mathcal{R}%
_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(  u\right)  _{21}%
}=1-\mathcal{R}_{c}\left(  u\right)  _{22}\overline{\mathcal{R}_{c}\left(
u\right)  _{22}}%
\end{equation}

\end{enumerate}

\item
\begin{equation}
\mathcal{R}_{c}\left(  u\right)  =\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  u\right)  _{11} & \mathcal{R}_{c}\left(  u\right)
_{12}\\
\mathcal{R}_{c}\left(  u\right)  _{21} & \mathcal{R}_{c}\left(  u\right)
_{22}%
\end{array}
\right)  =\mathcal{R}_{c}\left(  e^{i\lambda}\right)  =\exp i\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  \lambda\right)  _{11} & \mathcal{R}_{c}\left(
\lambda\right)  _{12}\\
\mathcal{R}_{c}\left(  \lambda\right)  _{21} & \mathcal{R}_{c}\left(
\lambda\right)  _{22}%
\end{array}
\right)
\end{equation}


\item
\begin{align}
\det\left(  \overset{}{\mathcal{R}_{c}\left(  u\right)  }\right)   &
=\det\left(  \overset{}{\mathcal{R}_{c}\left(  e^{i\lambda}\right)  }\right)
=e^{i\operatorname*{Tr}\left(  \lambda\right)  }\\
\det\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  u\right)  _{11} & \mathcal{R}_{c}\left(  u\right)
_{12}\\
\mathcal{R}_{c}\left(  u\right)  _{21} & \mathcal{R}_{c}\left(  u\right)
_{22}%
\end{array}
\right)   &  =\det\left(  \exp i\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  \lambda\right)  _{11} & \mathcal{R}_{c}\left(
\lambda\right)  _{12}\\
\mathcal{R}_{c}\left(  \lambda\right)  _{21} & \mathcal{R}_{c}\left(
\lambda\right)  _{22}%
\end{array}
\right)  \right)  =\exp\left(  i\operatorname*{Tr}\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{c}\left(  \lambda\right)  _{11} & \mathcal{R}_{c}\left(
\lambda\right)  _{12}\\
\mathcal{R}_{c}\left(  \lambda\right)  _{21} & \mathcal{R}_{c}\left(
\lambda\right)  _{22}%
\end{array}
\right)  \right)  ,
\end{align}
which can be seen by considering the diagonal form of $u$ obtained form the
spectral decomposition where

\begin{enumerate}
\item are the eigenvalues of $u$
\begin{equation}
\left\{  \xi_{1},\xi_{2}\right\}  =\left\{  e^{i\tau_{1}},e^{i\tau_{2}%
}\right\}
\end{equation}
and

\item are the eigenvalues of $\lambda$
\begin{equation}
\left\{  \tau_{1},\tau_{2}\right\}
\end{equation}
then

\item
\begin{equation}
\det\left(  \overset{}{\mathcal{R}_{c}\left(  u\right)  }\right)  =\det\left(
\overset{}{\exp i\mathcal{R}_{c}\left(  \lambda\right)  }\right)  =%
%TCIMACRO{\tprod \limits_{1\leq j\leq2}}%
%BeginExpansion
{\textstyle\prod\limits_{1\leq j\leq2}}
%EndExpansion
\left(  \xi_{j}\right)  =%
%TCIMACRO{\tprod \limits_{1\leq j\leq2}}%
%BeginExpansion
{\textstyle\prod\limits_{1\leq j\leq2}}
%EndExpansion
\left(  e^{\tau_{j}}\right)  =\exp\left(
%TCIMACRO{\tsum \limits_{1\leq j\leq2}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq2}}
%EndExpansion
\tau_{j}\right)  =\exp\left(  i\overset{}{\operatorname*{Tr}\left(
\mathcal{R}_{c}\left(  \lambda\right)  \right)  }\right)  .
\end{equation}

\end{enumerate}

\item If $u\in SU\left(  2\right)  $ then
\begin{equation}
\det\left(  u\right)  =1
\end{equation}
and
\begin{equation}
\operatorname*{Tr}\left(  \lambda\right)  =0
\end{equation}


\begin{enumerate}
\item
\[
\det\left(  \overset{}{\mathcal{R}_{c}\left(  u\right)  }\right)  =\left(
\overset{}{\mathcal{R}_{c}\left(  u\right)  _{11}\mathcal{R}_{c}\left(
u\right)  _{22}-\mathcal{R}_{c}\left(  u\right)  _{12}\mathcal{R}_{c}\left(
u\right)  _{21}}\right)
\]


\item
\begin{equation}
\operatorname*{Tr}\left(  \overset{}{\mathcal{R}_{c}\left(  \lambda\right)
}\right)  =\mathcal{R}_{c}\left(  \lambda\right)  _{11}+\mathcal{R}_{c}\left(
\lambda\right)  _{22}%
\end{equation}


\item
\begin{equation}
\operatorname*{Tr}\left(  \overset{}{\mathcal{R}_{c}\left(  \lambda\right)
}\right)  =0\Leftrightarrow\mathcal{R}_{c}\left(  \lambda\right)
_{11}=-\mathcal{R}_{c}\left(  \lambda\right)  _{22}%
\end{equation}

\end{enumerate}

\item Then

\begin{enumerate}
\item
\begin{align}
\left\vert f_{1}\wedge f_{2}\right\rangle  &  =\left\vert \left(
\overset{}{\left\vert c_{1}\right\rangle \mathcal{R}_{c}\left(  u\right)
_{11}+\left\vert c_{2}\right\rangle \mathcal{R}_{c}\left(  u\right)  _{12}%
}\right)  \wedge\left(  \overset{}{\left\vert c_{1}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{21}+\left\vert c_{2}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{22}}\right)  \right\rangle \\
&  =\left\vert \left(  \overset{}{\left\vert c_{1}\wedge c_{2}\right\rangle
\mathcal{R}_{c}\left(  u\right)  _{11}\mathcal{R}_{c}\left(  u\right)
_{22}+\left\vert c_{2}\wedge c_{1}\right\rangle \mathcal{R}_{c}\left(
u\right)  _{12}}\mathcal{R}_{c}\left(  u\right)  _{21}\right)  \right\rangle
\\
&  =\left\vert \overset{}{c_{1}\wedge c_{2}}\right\rangle \left(
\overset{}{\mathcal{R}_{c}\left(  u\right)  _{11}\mathcal{R}_{c}\left(
u\right)  _{22}-\mathcal{R}_{c}\left(  u\right)  _{12}\mathcal{R}_{c}\left(
u\right)  _{21}}\right)  \\
&  =\left\vert \overset{}{c_{1}\wedge c_{2}}\right\rangle \det\left(
\mathcal{R}_{c}\left(  u\right)  \right)  =\left\vert \overset{}{c_{1}\wedge
c_{2}}\right\rangle e^{i\theta\left(  u\right)  }.
\end{align}


\begin{lemma}%
\begin{equation}
\left\vert f_{1}\wedge f_{2}\right\rangle =\left\vert c_{1}\wedge
c_{2}\right\rangle \text{ }\operatorname*{Iff}\text{ }u\in SU\left(  2\right)
\end{equation}
and
\end{lemma}
\end{enumerate}

\item \label{07/02/2025}%
\begin{gather}
\left(  \overset{}{\left\vert f_{1}\right\rangle \left\langle f_{2}\right\vert
-\left\vert f_{2}\right\rangle \left\langle f_{1}\right\vert }\right)
=-\left(  \overset{}{\left\vert f_{1}\right\rangle \left\langle f_{2}%
\right\vert -\left\vert f_{2}\right\rangle \left\langle f_{1}\right\vert
}\right)  ^{\dagger}\\
\parallel\\
\overset{}{%
\begin{array}
[c]{c}%
\left\vert \left(  \overset{}{\left\vert c_{1}\right\rangle \mathcal{R}%
_{c}\left(  u\right)  _{11}+\left\vert c_{2}\right\rangle \mathcal{R}%
_{c}\left(  u\right)  _{12}}\right)  \right\rangle \left\langle \left(
\overset{}{\left\vert c_{1}\right\rangle \mathcal{R}_{c}\left(  u\right)
_{21}+\left\vert c_{2}\right\rangle \mathcal{R}_{c}\left(  u\right)  _{22}%
}\right)  \right\vert \\
-\left\vert \left(  \overset{}{\left\vert c_{1}\right\rangle \mathcal{R}%
_{c}\left(  u\right)  _{21}+\left\vert c_{2}\right\rangle \mathcal{R}%
_{c}\left(  u\right)  _{22}}\right)  \right\rangle \left\langle \left(
\overset{}{\left\vert c_{1}\right\rangle \mathcal{R}_{c}\left(  u\right)
_{11}+\left\vert c_{2}\right\rangle \mathcal{R}_{c}\left(  u\right)  _{12}%
}\right)  \right\vert
\end{array}
}\\
\parallel\\
\left\vert c_{1}\right\rangle \left\langle c_{1}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(  u\right)  _{21}%
}+\left\vert c_{1}\right\rangle \left\langle c_{2}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(  u\right)  _{22}%
}+\left\vert c_{2}\right\rangle \left\langle c_{1}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{12}\overline{\mathcal{R}_{c}\left(  u\right)  _{21}%
}+\left\vert c_{2}\right\rangle \left\langle c_{2}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{12}\overline{\mathcal{R}_{c}\left(  u\right)  _{22}}\\
-\left\vert c_{1}\right\rangle \left\langle c_{1}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(  u\right)  _{11}%
}-\left\vert c_{1}\right\rangle \left\langle c_{2}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{21}\overline{\mathcal{R}_{c}\left(  u\right)  _{12}%
}-\left\vert c_{2}\right\rangle \left\langle c_{1}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{22}\overline{\mathcal{R}_{c}\left(  u\right)  _{11}%
}-\left\vert c_{2}\right\rangle \left\langle c_{2}\right\vert \mathcal{R}%
_{c}\left(  u\right)  _{22}\overline{\mathcal{R}_{c}\left(  u\right)  _{12}}\\
\parallel\\
\left\vert c_{1}\right\rangle \left\langle c_{1}\right\vert \left(
\mathcal{R}_{c}\left(  u\right)  _{11}\overline{\mathcal{R}_{c}\left(
u\right)  _{21}}-\mathcal{R}_{c}\left(  u\right)  _{21}\overline
