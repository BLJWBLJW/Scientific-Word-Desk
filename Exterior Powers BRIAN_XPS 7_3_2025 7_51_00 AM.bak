\item Transformation between the $\left\langle {}\right\rangle $-conb's
$\left\vert \mathbf{e}\right\rangle $ and $\left\vert \mathbf{f}\right\rangle
$

\begin{enumerate}
\item
\begin{equation}
\left(  \mathbf{f}\right)  =u\left(  \mathbf{e}\right)  =\left(
u\mathbf{e}\right)  =\left\vert \mathbf{f}\right\rangle \left\langle
\mathbf{e}\right\vert \left(  \mathbf{e}\right)  =\left\vert \mathbf{f}%
\right\rangle \left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}%
\right\rangle =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)  =\left(
\mathbf{e}\right)  \left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle =\left(  \mathbf{e}\right)  \mathcal{R}_{e}\left(
u\right)
\end{equation}
i.e.%
\begin{gather}
u=\left\vert \mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \\
\mathcal{R}_{e}\left(  u\right)  =\mathcal{R}_{e}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)
=\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
=\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle \\
\mathcal{R}_{f}\left(  u\right)  =\mathcal{R}_{f}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)
=\left\langle \mathbf{f}\right\vert \left\vert \mathbf{f}\right\rangle
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle
=\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle \\
i.e.\mathcal{R}_{e}\left(  u\right)  =\mathcal{R}_{f}\left(  u\right)  .
\end{gather}


\item Transformation $u_{fe}$ between the $\left\langle {}\right\rangle
$-conb's $\left\vert \mathbf{f}\right\rangle $ and $\left\vert \mathbf{e}%
\right\rangle $%
\begin{equation}
\left(  \mathbf{e}\right)  =u^{\dagger}\left(  \mathbf{f}\right)  =\left(
u^{\dagger}\mathbf{f}\right)  =\left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{f}\right\vert \left(  \mathbf{f}\right)  =\left\vert \mathbf{e}%
\right\rangle \left\langle \mathbf{f}\right\vert \left\vert \mathbf{f}%
\right\rangle =\left(  \mathbf{f}\right)  \mathcal{R}_{f}\left(  \left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{f}\right\vert \right)  =\left(
\mathbf{f}\right)  \left\langle \mathbf{f}\right\vert \left\vert
\mathbf{e}\right\rangle =\left(  \mathbf{f}\right)  \mathcal{R}_{f}\left(
u^{\dagger}\right)  =\left(  \mathbf{f}\right)  \mathcal{R}_{f}\left(
u\right)  ^{\dagger}%
\end{equation}
i.e.%
\begin{gather}
u^{\dagger}=\left\vert \mathbf{e}\right\rangle \left\langle \mathbf{f}%
\right\vert \\
\mathcal{R}_{e}\left(  u^{\dagger}\right)  =\mathcal{R}_{e}\left(  u\right)
^{\dagger}=\mathcal{R}_{e}\left(  \left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{f}\right\vert \right)  =\left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{e}\right\rangle \left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{e}\right\rangle =\left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{e}\right\rangle \\
\mathcal{R}_{f}\left(  u^{\dagger}\right)  =\mathcal{R}_{f}\left(  u\right)
^{\dagger}=\mathcal{R}_{f}\left(  \left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{f}\right\vert \right)  =\left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{e}\right\rangle \left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{f}\right\rangle =\left\langle \mathbf{f}%
\right\vert \left\vert \mathbf{e}\right\rangle \\
i.e.\mathcal{R}_{e}\left(  u\right)  ^{\dagger}=\mathcal{R}_{f}\left(
u\right)  ^{\dagger}.
\end{gather}


\item Transformation matrix between the $\left\langle {}\right\rangle $-conb's
$\left\vert \mathbf{e\otimes e}\right\rangle $ and $\left\vert
\mathbf{f\otimes f}\right\rangle $%
\begin{equation}
u\mathbf{\otimes}u=\left(  \left\vert \mathbf{f}\right\rangle \left\langle
\mathbf{e}\right\vert \right)  \mathbf{\otimes}\left(  \left\vert
\mathbf{f}\right\rangle \left\langle \mathbf{e}\right\vert \right)
=\left\vert \mathbf{f\otimes f}\right\rangle \left\langle \mathbf{e\otimes
e}\right\vert
\end{equation}
as
\begin{equation}
\left(  \mathbf{f\otimes f}\right)  =\left\vert \mathbf{f\otimes
f}\right\rangle \left\langle \mathbf{e\otimes e}\right\vert \left(
\mathbf{e\otimes e}\right)  .
\end{equation}


\item Transformation matrix between the $\left\langle {}\right\rangle $-conb's
$\left\vert \mathbf{f\otimes f}\right\rangle $ and $\left\vert
\mathbf{e\otimes e}\right\rangle $%
\begin{equation}
\left(  u\mathbf{\otimes}u\right)  ^{\dagger}=\left(  \left\vert
\mathbf{e}\right\rangle \left\langle \mathbf{f}\right\vert \right)
\mathbf{\otimes}\left(  \left\vert \mathbf{e}\right\rangle \left\langle
\mathbf{f}\right\vert \right)  =\left\vert \mathbf{e\otimes e}\right\rangle
\left\langle \mathbf{f\otimes f}\right\vert
\end{equation}
as
\begin{equation}
\left(  \mathbf{e\otimes e}\right)  =\left\vert \mathbf{e\otimes
e}\right\rangle \left\langle \mathbf{f\otimes f}\right\vert \left(
\mathbf{f\otimes f}\right)  .
\end{equation}


\item Representations of the transformation matrix between the $\left\langle
{}\right\rangle $-conb's $\left\vert \mathbf{e\otimes e}\right\rangle $ and
$\left\vert \mathbf{f\otimes f}\right\rangle $
\begin{equation}
\left(  \mathbf{f\otimes f}\right)  =u\mathbf{\otimes}u\left(
\mathbf{e\otimes e}\right)  =\left(  u\mathbf{e\otimes}u\mathbf{e}\right)
=\left\vert \mathbf{e\otimes e}\right\rangle \left\langle \mathbf{e\otimes
e}\right\vert u\mathbf{\otimes}u\left(  \mathbf{e\otimes e}\right)
=\left\vert \mathbf{e\otimes e}\right\rangle \left\langle \left.
\mathbf{e\otimes e}\right\vert u\mathbf{\otimes}u\mathbf{e\otimes
e}\right\rangle =\left(  \mathbf{e\otimes e}\right)  \mathcal{R}_{e}^{\otimes
}\left(  u\mathbf{\otimes}u\right)
\end{equation}
i.e.
\begin{gather}
u\mathbf{\otimes}u=\left\vert \mathbf{f\otimes f}\right\rangle \left\langle
\mathbf{e\otimes e}\right\vert \\
\left(  \mathbf{f\otimes f}\right)  =u\mathbf{\otimes}u\left(
\mathbf{e\otimes e}\right)  =\left(  \mathbf{e\otimes e}\right)
\mathcal{R}_{e}^{\otimes}\left(  u\mathbf{\otimes}u\right) \\
\mathcal{R}_{e}^{\otimes}\left(  u\mathbf{\otimes}u\right)  =\left\langle
\mathbf{e\otimes e}\right\vert \left\vert \mathbf{f\otimes f}\right\rangle .
\end{gather}


\item Transformation of the matrix representations of operators belonging to
$\mathcal{B}\left(  \mathcal{H}^{1}\mathbf{\otimes}\mathcal{H}^{1}\right)
\cong\mathcal{B}\left(  \mathbb{C}^{2r}\mathbf{\otimes}\mathbb{C}^{2r}\right)
$ produced by the transformation between $\left\langle \left.  {}\right\vert
\right\rangle $-conb $\left\vert \mathbf{e\otimes e}\right\rangle $ to the
$\left\langle \left.  {}\right\vert \right\rangle $-conb $\left\vert
\mathbf{f\otimes f}\right\rangle $%
\begin{align}
T  &  =\left\vert \mathbf{e\otimes e}\right\rangle \left\langle
\mathbf{e\otimes e}\right\vert T\left\vert \mathbf{e\otimes e}\right\rangle
\left\langle \mathbf{e\otimes e}\right\vert =\left\vert \mathbf{e\otimes
e}\right\rangle \mathcal{R}_{e}^{\otimes}\left(  T\right)  \left\langle
\mathbf{e\otimes e}\right\vert \\
T  &  =\left\vert \mathbf{f\otimes f}\right\rangle \left\langle
\mathbf{f\otimes f}\right\vert T\left\vert \mathbf{f\otimes f}\right\rangle
\left\langle \mathbf{f\otimes f}\right\vert =\left\vert \mathbf{f\otimes
f}\right\rangle \mathcal{R}_{f}^{\otimes}\left(  T\right)  \left\langle
\mathbf{f\otimes f}\right\vert \\
&  =\left\vert \mathbf{f\otimes f}\right\rangle \left\langle \mathbf{e\otimes
e}\right\vert \left(  u\mathbf{\otimes}u\right)  ^{\dagger}T\left(
u\mathbf{\otimes}u\right)  \left\vert \mathbf{e\otimes e}\right\rangle
\left\langle \mathbf{f\otimes f}\right\vert \\
&  =\left\vert \mathbf{f\otimes f}\right\rangle \mathcal{R}_{e}^{\otimes
}\left(  \left(  u\mathbf{\otimes}u\right)  ^{\dagger}T\left(
u\mathbf{\otimes}u\right)  \right)  \left\langle \mathbf{f\otimes
f}\right\vert =\left\vert \mathbf{f\otimes f}\right\rangle \mathcal{R}%
_{e}^{\otimes}\left(  u\mathbf{\otimes}u\right)  ^{\dagger}\mathcal{R}%
_{e}^{\otimes}\left(  T\right)  \mathcal{R}_{e}^{\otimes}\left(
u\mathbf{\otimes}u\right)  \left\langle \mathbf{f\otimes f}\right\vert
\end{align}
hence
\begin{equation}
\mathcal{R}_{f}^{\otimes}\left(  T\right)  =\mathcal{R}_{e}^{\otimes}\left(
u\mathbf{\otimes}u\right)  ^{\dagger}\mathcal{R}_{e}^{\otimes}\left(
T\right)  \mathcal{R}_{e}^{\otimes}\left(  u\mathbf{\otimes}u\right)  .
\end{equation}

\end{enumerate}

\item Operator representation of geminals $g$%
\begin{gather}
G=\Upsilon\left(  g\right)  =\left(  \left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert \right)  \mathcal{R}_{e}\left(
\Upsilon\left(  g\right)  \right)  =\left(  \left\vert \mathbf{e}\right\rangle
\left\langle \mathbf{e}\right\vert \right)  \left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  g\right)  _{11}\\
\vdots\\
\mathcal{R}_{e}\left(  g\right)  _{31}%
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  g\right)  _{12}\\
\vdots\\
\mathcal{R}_{e}\left(  g\right)  _{32}%
\end{array}
\right)  & \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  g\right)  _{13}\\
\vdots\\
\mathcal{R}_{e}\left(  g\right)  _{33}%
\end{array}
\right)
\end{array}
\right) \\
=\left(  \left\vert \mathbf{e}\right\rangle \left\langle \mathbf{e}\right\vert
\right)  \left(
\begin{array}
[c]{ccc}%
0 & \mathcal{R}_{e}\left(  g\right)  _{12} & \mathcal{R}_{e}\left(  g\right)
_{13}\\
-\mathcal{R}_{e}\left(  g\right)  _{13} & 0 & \mathcal{R}_{e}\left(  g\right)
_{23}\\
-\mathcal{R}_{e}\left(  g\right)  _{13} & -\mathcal{R}_{e}\left(  g\right)
_{23} & 0
\end{array}
\right)
\end{gather}
where

\item
\begin{gather}
\left\vert g\right\rangle =\left\langle \mathbf{ee}\right\vert \mathcal{R}%
_{e}^{\wedge}\left(  g\right)  =\left\langle \mathbf{e\otimes e}\right\vert
\mathcal{R}_{e}^{\otimes}\left(  g\right)  =\sum_{1\leq j<k\leq3}\left\vert
e_{j}e_{k}\right\rangle \mathcal{R}_{e}\left(  g\right)  _{jk}=\frac{1}{2}%
\sum_{1\leq j,k\leq3}\left\vert e_{j}e_{k}\right\rangle \mathcal{R}_{e}\left(
g\right)  _{jk}\\
\text{where }\frac{1}{2}\left(  \mathcal{R}_{e}^{\otimes}\left(  g\right)
_{jk}-\mathcal{R}_{e}^{\otimes}\left(  g\right)  _{kj}\right)  =\mathcal{R}%
_{e}^{\wedge}\left(  g\right)  _{jk}=\mathcal{R}_{e}\left(  g\right)
_{jk},\quad1\leq j<k\leq3\\
\text{and }\mathcal{R}_{e}^{\otimes}\left(  g\right)  _{jj}=0,\quad1\leq
j\leq3
\end{gather}
explicitly giving
\begin{align}
&  \frac{1}{2}\sum_{1\leq j,k\leq3}\left\vert e_{j}\otimes e_{k}\right\rangle
\mathcal{R}_{e}^{\otimes}\left(  g\right)  _{jk}=\frac{1}{2}\left(  \left\vert
e_{1}\otimes e_{1}\right\rangle \mathcal{R}_{e}^{\otimes}\left(  g\right)
_{11}+\left\vert e_{1}\otimes e_{2}\right\rangle \mathcal{R}_{e}^{\otimes
}\left(  g\right)  _{12}+\left\vert e_{1}\otimes e_{3}\right\rangle
\mathcal{R}_{e}^{\otimes}\left(  g\right)  _{13}+\left\vert e_{2}\otimes
e_{1}\right\rangle \mathcal{R}_{e}^{\otimes}\left(  g\right)  _{21}\right. \\
&  \left.  +\left\vert e_{2}\otimes e_{2}\right\rangle \mathcal{R}%
_{e}^{\otimes}\left(  g\right)  _{22}+\left\vert e_{2}\otimes e_{3}%
\right\rangle \mathcal{R}_{e}^{\otimes}\left(  g\right)  _{23}+\left\vert
e_{3}\otimes e_{1}\right\rangle \mathcal{R}_{e}^{\otimes}\left(  g\right)
_{31}+\left\vert e_{3}\otimes e_{2}\right\rangle \mathcal{R}_{e}^{\otimes
}\left(  g\right)  _{32}+\left\vert e_{3}\otimes e_{3}\right\rangle
\mathcal{R}_{e}^{\otimes}\left(  g\right)  _{33}\right)  .
\end{align}

\end{enumerate}
\end{remark}

\begin{enumerate}
\item Geminals $g=\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}^{-1}\left(  G\right)
=$ $\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}^{-1}\left(  \Xi_{\mathcal{H}%
^{1}\mathcal{H}^{1d}}\left(  g\right)  \right)  $ can be expanded as
\begin{equation}
\left\vert g\right\rangle =\left\vert \mathbf{f\otimes f}\right\rangle
\left\langle \mathbf{f\otimes f}\right\vert \left\vert g\right\rangle
=\left\vert \mathbf{f\otimes f}\right\rangle \mathcal{R}_{f}^{\otimes}\left(
g\right)  =\left\vert \mathbf{f\otimes f}\right\rangle \Omega\left(
\overset{}{\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}%
\right\rangle ^{t}\Upsilon\left(  \overset{}{\left\langle \mathbf{e\otimes
e}\right\vert \left\vert g\right\rangle }\right)  \left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{f}\right\rangle }\right)  =\left\vert
\mathbf{f\otimes f}\right\rangle \Omega\left(  \overset{}{\left\langle
\mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle ^{t}G\left\langle
\mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle }\right)  ,
\end{equation}
i.e.%
\begin{equation}
\mathcal{R}_{f}^{\otimes}\left(  g\right)  =\left\langle \mathbf{f\otimes
f}\right\vert \left\vert g\right\rangle =\Omega\left(  \overset{}{\mathcal{R}%
_{e}\left(  u\right)  ^{t}\Upsilon\left(  \overset{}{\mathcal{R}_{e}\left(
g\right)  }\right)  \mathcal{R}_{e}\left(  u\right)  }\right)  =\Omega\left(
\overset{}{\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}%
\right\rangle ^{t}\Upsilon\left(  \overset{}{\left\langle \mathbf{e\otimes
e}\right\vert \left\vert g\right\rangle }\right)  \left\langle \mathbf{e}%
\right\vert \left\vert \mathbf{f}\right\rangle }\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  u\right)  ^{t}\Upsilon\left(  \overset{}{\mathcal{R}%
_{e}\left(  g\right)  }\right)  \mathcal{R}_{e}\left(  u\right)  =\left\langle
\mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle ^{t}\Upsilon\left(
\overset{}{\left\langle \mathbf{e\otimes e}\right\vert \left\vert
g\right\rangle }\right)  \left\langle \mathbf{e}\right\vert \left\vert
\mathbf{f}\right\rangle .
\end{equation}


\item
\begin{equation}
\left\vert g\right\rangle =\left\vert \mathbf{ff}\right\rangle \mathcal{R}%
_{f}\left(  g\right)  =\left\vert \mathbf{ee}\right\rangle \mathcal{R}%
_{e}\left(  \boxtimes^{2}u\right)  \left(  \overset{}{\mathcal{R}_{e}\left(
g\right)  }\right)  ,
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{f}\left(  g\right)  =\mathcal{R}_{e}\left(  \boxtimes
^{2}u\right)  \left(  \overset{}{\mathcal{R}_{e}\left(  g\right)  }\right)
=\Omega\left(  \overset{}{\mathcal{R}_{e}\left(  u\right)  ^{t}\mathcal{R}%
_{e}\left(  g\right)  \mathcal{R}_{e}\left(  u\right)  }\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \boxtimes^{2}u\right)  =\boxtimes^{2}\left(
\left\langle \mathbf{e}\right\vert \left\vert \mathbf{f}\right\rangle \right)
=\boxtimes^{2}\left(  \mathcal{R}_{e}\left(  u\right)  \right)  .
\end{equation}


\begin{enumerate}
\item
\begin{equation}
g=\mathcal{A}_{2}g
\end{equation}


\item
\begin{equation}
\left\vert \mathbf{ee}\right\rangle \left\langle \mathbf{ee}\right\vert
g=\left\vert \mathbf{ee}\right\rangle \mathcal{R}_{\wedge e}\left(  g\right)
\end{equation}


\item
