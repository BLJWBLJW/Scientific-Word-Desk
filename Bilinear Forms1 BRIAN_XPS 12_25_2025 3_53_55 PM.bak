\begin{theorem}
\begin{equation}
A^{t_{\rho }}=\left( \overset{}{S_{\rho \sigma }^{t_{\sigma }}S_{\rho \sigma
}}\right) ^{-1}A^{t_{\sigma }}\left( \overset{}{S_{\rho \sigma }^{t_{\sigma
}}S_{\rho \sigma }}\right) .
\end{equation}
\end{theorem}

\bigskip

\begin{proof}
\begin{gather}
\left( \left. Av\right\vert w\right) _{\rho \rho }=\left( \left.
v\right\vert A^{t_{\rho }}w\right) _{\rho \rho } \\
\parallel \\
\left( \left. \overset{}{Av}\right\vert \left( \overset{}{S_{\rho \sigma
}^{t_{\sigma }}S_{\rho \sigma }}\right) w\right) _{\sigma \sigma }=\left(
\left. \overset{}{\left( \overset{}{S_{\rho \sigma }^{t_{\sigma }}S_{\rho
\sigma }}\right) Av}\right\vert w\right) _{\sigma \sigma } \\
\parallel \\
\left( \left. \overset{}{v}\right\vert A^{t_{\sigma }}\left( \overset{}{%
S_{\rho \sigma }^{t_{\sigma }}S_{\rho \sigma }}\right) w\right) _{\sigma
\sigma }=\left( \left. \overset{\overset{}{}}{v}\right\vert \left( \overset{}%
{S_{\rho \sigma }^{t_{\sigma }}S_{\rho \sigma }}\right) A^{t_{\rho
}}w\right) _{\sigma \sigma } \\
S_{\rho \sigma }^{-t_{\sigma }}A^{t_{\sigma }}S_{\rho \sigma }^{t_{\sigma
}}=S_{\rho \sigma }A^{t_{\rho }}S_{\rho \sigma }^{-1} \\
A^{t_{\sigma }}\left( \overset{}{S_{\rho \sigma }^{t_{\sigma }}S_{\rho
\sigma }}\right) =\left( \overset{}{S_{\rho \sigma }^{t_{\sigma }}S_{\rho
\sigma }}\right) A^{t_{\rho }} \\
A^{t_{\sigma }}=\left( \overset{}{S_{\rho \sigma }^{t_{\sigma }}S_{\rho
\sigma }}\right) A^{t_{\rho }}\left( \overset{}{S_{\rho \sigma }^{t_{\sigma
}}S_{\rho \sigma }}\right) ^{-1}
\end{gather}
\end{proof}

\begin{definition}
\begin{equation}
\Delta _{\rho \sigma }=S_{\rho \sigma }^{t_{\sigma }}S_{\rho \sigma }.
\end{equation}
\end{definition}

\begin{remark}
Recall the change of basis is 
\begin{eqnarray}
\left( 
\begin{array}{c}
\rho _{1} \\ 
\vdots \\ 
\rho _{r}%
\end{array}%
\right) &=&S_{\rho \sigma }\left( 
\begin{array}{c}
\sigma _{1} \\ 
\vdots \\ 
\sigma _{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
S_{\rho \sigma }\sigma _{1} \\ 
\vdots \\ 
S_{\rho \sigma }\sigma _{r}%
\end{array}%
\right) =\mathcal{R}_{\sigma }\left( S_{\rho \sigma }\right) ^{t}\left( 
\begin{array}{c}
\sigma _{1} \\ 
\vdots \\ 
\sigma _{r}%
\end{array}%
\right) \\
\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) &=&S_{\rho \sigma }\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
S_{\rho \sigma }\sigma _{1} & \cdots & S_{\rho \sigma }\sigma _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \mathcal{R}_{\sigma }\left( S_{\rho \sigma }\right) .
\end{eqnarray}
\end{remark}

\begin{lemma}
If $A$ is $t_{\rho }$-symmetric $\limfunc{Iff}$ it is $t_{\sigma }$-symmetric

\begin{proof}
\begin{eqnarray}
\left( \left. v\right\vert w\right) _{\sigma \sigma } &=&\left( \left.
v\right\vert S_{\rho \sigma }^{t_{\rho }}S_{\rho \sigma }w\right) _{\rho
\rho }=\left( \left. S_{\rho \sigma }^{t_{\rho }}v\right\vert S_{\rho \sigma
}w\right) _{\rho \rho } \\
\left( \left. A^{t_{\sigma }}v\right\vert w\right) _{\sigma \sigma }
&=&\left( \left. v\right\vert Aw\right) _{\sigma \sigma } \\
\left( \left. A^{t_{\sigma }}v\right\vert S_{\rho \sigma }^{t_{\rho
}}S_{\rho \sigma }w\right) _{\rho \rho } &=&\left( \left. v\right\vert
S_{\rho \sigma }^{t_{\rho }}S_{\rho \sigma }Aw\right) _{\rho \rho } \\
\left( \left. A^{t_{\sigma }}v\right\vert S_{\rho \sigma }^{t_{\rho
}}S_{\rho \sigma }w\right) _{\rho \rho } &=&\left( \left. S_{\rho \sigma
}^{t_{\rho }}A^{t_{\sigma }}v\right\vert S_{\rho \sigma }w\right) _{\rho
\rho }=
\end{eqnarray}
\end{proof}
\end{lemma}

\begin{remark}
One should note that 
\begin{equation}
t_{\rho }\in \mathcal{L}\left( V\right)
\end{equation}%
while%
\begin{equation}
t\in \mathcal{L}\left( V^{d},V\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
b_{\rho \rho }\left( v,w\right) =b_{\rho \rho }\left( v\otimes w\right)
\end{equation}%
\begin{eqnarray}
b_{\rho \rho }\left( v,Tw\right) &=&b_{\rho \rho }\left( v\otimes Tw\right)
=b_{\rho \rho }\left( \left( I_{V^{d}}\otimes T\right) \left( v\otimes
w\right) \right) =\left( I_{V^{d}}\otimes T\right) ^{t}b_{\rho \rho }\left(
\left( v\otimes w\right) \right) =b_{\rho \rho }\left( \left( T^{t_{\rho
}}\otimes I_{V^{d}}\right) \left( v\otimes w\right) \right) =\left(
T^{t_{\rho }}\otimes I_{V^{d}}\right) ^{t}b_{\rho \rho }\left( \left(
v\otimes w\right) \right) \\
\left( I_{V^{d}}\otimes T\right) ^{t} &=&\left( T^{t_{\rho }}\otimes
I_{V^{d}}\right) ^{t}\Leftrightarrow I_{V^{d}}\otimes T=T^{t_{\rho }}\otimes
I_{V^{d}} \\
b_{\rho \rho }\left( T^{t_{\rho }}v,w\right) &=&b_{\rho \rho }\left(
T^{t_{\rho }}v\otimes w\right) =b_{\rho \rho }\left( \left( T^{t_{\rho
}}\otimes I_{V^{d}}\right) \left( v\otimes w\right) \right) \\
b_{\rho \rho }\left( \left( T^{t_{\rho }}\otimes I_{V^{d}}\right) \left(
v\otimes w\right) \right) &=&b_{\rho \rho }\left( \left( I_{V^{d}}\otimes
T\right) \left( v\otimes w\right) \right) \\
\left( T^{t_{\rho }}\otimes I_{V^{d}}\right) ^{t}b_{\rho \rho }\left( \left(
v\otimes w\right) \right) &=&\left( I_{V^{d}}\otimes T\right) ^{t}b_{\rho
\rho }\left( \left( v\otimes w\right) \right)
\end{eqnarray}%
\begin{eqnarray}
b_{\rho \rho }\left( v,T^{t_{\rho }}w\right) &=&b_{\rho \rho }\left(
v\otimes T^{t_{\rho }}w\right) =b_{\rho \rho }\left( \left( I_{V^{d}}\otimes
T^{t_{\rho }}\right) \left( v\otimes w\right) \right) \\
b_{\rho \rho }\left( \left( T^{t_{\rho }}\right) ^{t_{\rho }}v,w\right)
&=&b_{\rho \rho }\left( \left( \left( T^{t_{\rho }}\right) ^{t_{\rho
}}v\right) \otimes w\right) =b_{\rho \rho }\left( \left( \left( T^{t_{\rho
}}\right) ^{t_{\rho }}\otimes I_{V^{d}}\right) \left( v\otimes w\right)
\right) \\
b_{\rho \rho }\left( \left( \left( T^{t_{\rho }}\right) ^{t_{\rho }}\otimes
I_{V^{d}}\right) \left( v\otimes w\right) \right) &=&b_{\rho \rho }\left(
\left( I_{V^{d}}\otimes T^{t_{\rho }}\right) \left( v\otimes w\right) \right)
\\
\left( \left( T^{t_{\rho }}\right) ^{t_{\rho }}\otimes I_{V^{d}}\right)
^{t}b_{\rho \rho }\left( \left( v\otimes w\right) \right) &=&\left(
I_{V^{d}}\otimes \left( T^{t_{\rho }}\right) ^{t_{\rho }}\right) ^{t}b_{\rho
\rho }\left( \left( v\otimes w\right) \right)
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{eqnarray*}
b_{\sigma \sigma }\left( v,w\right) &=&b_{\rho \rho }\left( Tv,Tw\right)
=b_{\rho \rho }\left( Tv\otimes Tw\right) =b_{\rho \rho }\left( \left(
T\otimes T\right) \left( v\otimes w\right) \right) \\
&=&b_{\rho \rho }\left( v,T^{t_{\rho }}Tw\right) =b_{\rho \rho }\left(
Tv\otimes Tw\right) =b_{\rho \rho }\left( \left( I_{V}\otimes T^{t_{\rho
}}T\right) \left( v\otimes w\right) \right)
\end{eqnarray*}
\end{remark}

\begin{remark}
\begin{eqnarray}
b_{\sigma \sigma }\left( v,w\right) &=&b_{\rho \rho }\left( Tv,Tw\right)
=\sum_{1\leq l\leq r}\rho _{dj}\left( Tv\right) \rho _{dj}\left( Tw\right)
=\sum_{1\leq l\leq r}\left( T^{t}\rho _{dj}\right) \left( v\right) \left(
T^{t}\rho _{dj}\right) \left( w\right) =\left( T^{t}\otimes T^{t}\right)
\left( \sum_{1\leq l\leq r}\left( \rho _{dj}\otimes \rho _{dj}\right)
\right) \left( v\otimes w\right)  \notag \\
&=&\sum_{1\leq j,l,k\leq r}\left( \rho _{dk}\mathcal{R}\left( T^{t}\right)
_{kj}\right) \left( v\right) \left( \rho _{dl}\mathcal{R}\left( T^{t}\right)
_{lj}\right) \left( w\right) =\left( \mathcal{R}\left( T\right)
_{jk}\sum_{1\leq j,l,k\leq r}\left( \rho _{dk}\otimes \rho _{dl}\right)
\left( v\otimes w\right) \right) \mathcal{R}\left( T^{t}\right) _{lj}.
\end{eqnarray}
\end{remark}

\begin{definition}
The \emph{overlap matrix} $\mathbb{S}_{\rho \sigma \boldsymbol{e}}=\left(
\left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho \sigma }$ of
the inner product $\left( \left. {}\right\vert \right) _{\rho \sigma }$ wrt
a basis $\left( \boldsymbol{e}\right) $ is given by 
\begin{equation}
\mathcal{R}_{e}\left( S_{\rho \sigma }\right) _{jk}=\left( \mathbb{S}_{\rho
\sigma \boldsymbol{e}}\right) _{jk}=\left( \left. e_{j}\right\vert
e_{k}\right) _{\rho \sigma }=\sum_{1\leq l\leq r}\rho _{dj}\left(
e_{j}\right) \sigma _{dj}\left( e_{k}\right) ,\quad 1\leq j,k\leq r,
\end{equation}%
where $S_{\rho \sigma }$ is the overlap operator 
\begin{equation}
S_{\rho \sigma }=\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}\rho _{j}\left[ \sigma _{bj}\right] .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\mathbb{S}_{\rho \sigma \boldsymbol{e}}=\left[ \left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{dr}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\left( \left\vert
v\right\vert S_{\rho \sigma }w\right) ,
\end{equation}%
where 
\begin{gather}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
v\right) ^{t}\mathcal{R}_{e}\left( w\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) _{1} & \cdots & \mathcal{R}_{e}\left(
v\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( v\right) & \cdots & e_{br}\left( v\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1}\left( w\right) \\ 
\vdots \\ 
e_{br}\left( w\right)%
\end{array}%
\right) \\
=\sum_{1\leq l\leq r}e_{bl}\left( v\right) e_{bl}\left( w\right) =\left(
\sum_{1\leq l\leq r}\left( e_{bl}\otimes e_{bl}\right) \right) \left(
w\otimes v\right) .
\end{gather}
\end{remark}

\begin{theorem}
\begin{equation}
\sum_{1\leq l\leq r}\left( e_{bl}\otimes e_{bl}\right) \left( w\otimes
v\right) =\sum_{1\leq l\leq r}\left( f_{bl}\otimes f_{bl}\right) \left(
w\otimes v\right)
\end{equation}

\begin{proof}
\begin{eqnarray}
\left( \left. w\right\vert v\right) _{e_{b}e_{b}} &=&\sum_{1\leq l\leq
r}\left( e_{bl}\otimes e_{bl}\right) \left( w\otimes v\right) =\sum_{1\leq
l\leq r}e_{bl}\left( w\right) e_{bl}\left( v\right) =\sum_{1\leq l\leq r}%
\mathcal{R}_{e}\left( w\right) _{l}\mathcal{R}_{e}\left( v\right) _{l} \\
\left( \left. w\right\vert v\right) _{f_{b}f_{b}} &=&\sum_{1\leq l\leq
r}\left( f_{bl}\otimes f_{bl}\right) \left( w\otimes v\right) =\sum_{1\leq
l\leq r}f_{bl}\left( w\right) f_{bl}\left( v\right) =\sum_{1\leq l\leq r}%
\mathcal{R}_{f}\left( w\right) _{l}\mathcal{R}_{f}\left( v\right) _{l}
\end{eqnarray}%
\begin{equation}
\left( \sum_{1\leq l\leq r}\left( e_{bl}\otimes e_{bl}\right) \right) \left(
w\otimes v\right) =\sum_{1\leq l\leq r}\left( S_{f_{b}e_{b}}f_{bl}\otimes
S_{f_{b}e_{b}}f_{bl}\right) \left( w\otimes v\right) =\left( \overset{}{%
\left( \overset{}{S_{f_{b}e_{b}}\otimes S_{f_{b}e_{b}}}\right) \left(
\sum_{1\leq l\leq r}\overset{}{f_{bl}\otimes f_{bl}}\right) }\right) \left(
w\otimes v\right)
\end{equation}%
\begin{equation}
\left( \overset{}{S_{f_{b}e_{b}}\otimes S_{f_{b}e_{b}}}\right) \left(
\sum_{1\leq l\leq r}\overset{}{f_{bl}\otimes f_{bl}}\right) =\sum_{1\leq
j,k,p,q\leq r}\left( \overset{}{S_{f_{b}e_{b}}\otimes S_{f_{b}e_{b}}}\right)
_{jkpq}\left( \sum_{1\leq l\leq r}\overset{}{f_{bl}\otimes f_{bl}}\right)
_{pq}
\end{equation}%
\begin{eqnarray}
\left( \overset{}{S_{f_{b}e_{b}}\otimes S_{f_{b}e_{b}}}\right) \left( 
\overset{}{f_{bl}\otimes f_{bl}}\right) &=&\left( S_{f_{b}e_{b}}\overset{}{%
f_{bl}\otimes S_{f_{b}e_{b}}f_{bl}}\right) =\left( \sum_{1\leq j,k\leq r}%
\overset{}{f_{bj}\mathcal{R}_{f}\left( S_{f_{b}e_{b}}\right) _{jl}\otimes
S_{f_{b}e_{b}}f_{bk}}\mathcal{R}_{f}\left( S_{f_{b}e_{b}}\right)
_{kl}\right) =\sum_{1\leq j,k\leq r}f_{bj}\otimes f_{bk}\mathcal{R}%
_{f}\left( S_{f_{b}e_{b}}\right) _{jl}\mathcal{R}_{f}\left(
S_{f_{b}e_{b}}\right) _{kl} \\
&=&\sum_{1\leq j,k\leq r}\mathcal{R}_{f}\left( S_{f_{b}e_{b}}\right)
_{lj}^{t}f_{bj}\otimes f_{bk}\mathcal{R}_{f}\left( S_{f_{b}e_{b}}\right)
_{kl}
\end{eqnarray}%
\begin{eqnarray}
\sum_{1\leq l\leq r}\left( e_{bl}\left[ f_{bbl}\right] \right) &=&\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right] \\
\left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( \left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right) \right) &=&\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \\
\mathcal{R}_{f}\left( \left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right) \right) &=&\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right)
\end{eqnarray}%
\begin{equation}
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) =\left( \left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \right) \otimes \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right)
\end{equation}%
\begin{equation}
\sum_{1\leq l\leq r}e_{bl}\left( v\right) e_{bl}\left( w\right) =\sum_{1\leq
l\leq r}\left( e_{bl}\otimes e_{bl}\right) \left( w\otimes v\right)
=\sum_{1\leq l\leq r}f_{bl}\left( v\right) f_{bl}\left( w\right)
=\sum_{1\leq l\leq r}\left( f_{bl}\otimes f_{bl}\right) \left( w\otimes
v\right) =
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
\begin{equation}
\left( \left\vert v\right\vert w\right) _{\rho \sigma }=\sum_{1\leq l\leq
r}\rho _{bj}\left( v\right) \sigma _{bj}\left( w\right)
\end{equation}
\end{remark}

\begin{definition}
Let $\left( \mathbf{e}\right) $ be a basis of $V,$ then the \emph{rank} of
the \emph{pre} inner product $\left( \left\vert {}\right\vert \right) _{\rho
\sigma }$ is:

\begin{enumerate}
\item 
\begin{equation}
\limfunc{Rank}\left\{ \left( \left\vert {}\right\vert \right) _{\rho \sigma
}\right\} =\#\text{ number of linearly independent columns of }\left(
\left\vert \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho \sigma }.
\end{equation}

\item 
\begin{equation}
\limfunc{Rank}\left\{ \left( \left\vert \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho \sigma }\right\} =\#\ \text{of non zero \textbf{%
singular} values of }\left( \left\vert \boldsymbol{e}\right\vert \boldsymbol{%
e}\right) _{\rho \sigma }.
\end{equation}

\item The minimal $p$ such that 
\begin{equation}
b_{\rho \sigma }=\sum_{1\leq j\leq p}\U{3c6} _{dj}\otimes \U{3c8} _{dj}\text{
with }\U{3c6} _{dj}\in V^{d},\U{3c8} _{dj}\in W^{d}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
$\left( \left\vert {}\right\vert \right) _{\rho \sigma }$ is \textbf{non
degenerate} $\limfunc{Iff}$ 
\begin{equation}
\limfunc{Rank}\left\{ \left( \left\vert {}\right\vert \right) _{\rho \sigma
}\right\} =r.
\end{equation}
\end{definition}

\begin{lemma}
Inner products can be decomposed into a sum of \emph{elementary} $\equiv $ 
\emph{simple} pre inner products $\equiv $ inner products that have rank $1$ 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=b_{\rho \sigma }\left(
v,w\right) =\left[ \Xi _{\left( V\otimes V\right) ^{d}}\left( \sum_{1\leq
l\leq r}\rho _{bj}\otimes \sigma _{bj}\right) \right] \left( v\otimes
w\right) =\left( \sum_{1\leq l\leq r}\left[ \Xi _{\left( V\otimes V\right)
^{d}}\left( \rho _{bj}\otimes \sigma _{bj}\right) \right] \right) \left(
v\otimes w\right) =\sum_{1\leq l\leq r}\left( \left\vert v\right\vert
w\right) _{\rho _{j}\sigma _{j}}=\sum_{1\leq l\leq r}\rho _{bj}\left(
v\right) \otimes \sigma _{bj}\left( w\right) .
\end{equation}

\begin{proof}
From Greubs Theorem.
\end{proof}
\end{lemma}

\begin{lemma}
Inner products are non degenerate in a $r$-dimensional vector space $%
\limfunc{Iff}$ their \emph{rank} is $r.$
\end{lemma}

\begin{remark}
Dual elements $x_{dk}$ and $e_{dj}$ can be expressed in terms of inner
products by 
\begin{eqnarray}
x_{dk}\left( e_{j}\right) &=&\left( \left\vert x_{k}\right\vert e_{j}\right)
_{\rho \sigma } \\
e_{dj}\left( x_{k}\right) &=&\left( \left\vert e_{j}\right\vert x_{k}\right)
_{\rho \sigma }
\end{eqnarray}%
\textbf{so if }$\left( \left. e_{j}\right\vert x_{k}\right) $\textbf{\ is
symmetric then }%
\begin{equation}
e_{dj}\left( x_{k}\right) =x_{dk}\left( e_{j}\right) .
\end{equation}
\end{remark}

\begin{remark}
In general 
\begin{equation}
\left( \left\vert e_{j}\right\vert x_{k}\right) _{\rho \sigma }=e_{dj}\left(
x_{k}\right) =e_{dj}\left( \sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left(
x_{k}\right) _{l}\right) \neq \mathcal{R}_{e}\left( x_{k}\right) _{j}
\end{equation}%
and 
\begin{equation}
\left( \left\vert x_{k}\right\vert e_{j}\right) _{\rho \sigma
}=e_{bbj}\left( x_{bk}\right) =x_{bk}\left( e_{j}\right) =\left( \sum_{1\leq
l\leq r}x_{bk}\left( e_{l}\right) \mathcal{R}_{e}\left( e_{j}\right)
_{l}\right) =\left( \sum_{1\leq l\leq r}x_{bk}\left( e_{l}\right)
e_{bl}\left( e_{j}\right) \right) =\mathcal{R}_{e_{bb}}\left( x_{bk}\right)
_{j}\neq \left( \left\vert e_{j}\right\vert x_{k}\right) ,
\end{equation}%
\emph{which are not equal}.
\end{remark}

\begin{remark}
In general 
\begin{equation}
e_{bj}\left( x_{k}\right) =\left( \left\vert e_{bj}\right\vert x_{k}\right)
_{\rho \sigma }=e_{bj}\left( \sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left(
x_{k}\right) _{l}\right) =\mathcal{R}_{e}\left( x_{k}\right) _{j}
\end{equation}%
and 
\begin{equation*}
\left( \boldsymbol{e}_{b}\right) ^{t}=\left( \overset{}{\left( \overset{}{%
b\left( \boldsymbol{e}\right) }\right\vert _{\rho \sigma }}\right)
^{t}=\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
\sigma }^{-1}\left( \boldsymbol{e}\right\vert _{\rho \sigma }=\left( 
\begin{array}{c}
\left( b\left( e\right) _{1}\right\vert \\ 
\vdots \\ 
\left( b\left( e\right) _{r}\right\vert%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( e_{b1}\right\vert \\ 
\vdots \\ 
\left( e_{br}\right\vert%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{r}\right\vert e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{r}\right\vert%
\end{array}%
\right) \in \mathfrak{B}\left( V^{d}\right) .
\end{equation*}
\end{remark}

\begin{lemma}
If $b_{\rho \sigma }$ is non degenrate then it defines an injection%
\begin{equation}
\mathfrak{i}_{V^{d}V}:V\rightarrow V^{d}
\end{equation}%
by 
\begin{equation}
\mathfrak{i}_{V^{d}V}\left( v\right) =b_{\rho \sigma }\left( v,\cdot \right)
.
\end{equation}
\end{lemma}

\begin{remark}
By Greubs theorem for $A\in \mathcal{L}\left( V\right) $ one obtains the
dyadic expansion 
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{br}%
\end{array}%
\right) \right] .
\end{equation}
\end{remark}

\section{Transpose}

\begin{definition}
%TCIMACRO{\hyperref{Transpose}{}{}{#Transpose} }%
%BeginExpansion
\msihyperref{Transpose}{}{}{#Transpose}
%EndExpansion
The map $t\in \mathcal{L}\left( \mathcal{L}\left( V\right) \right) $ 
\begin{equation}
t:\mathcal{L}\left( V\right) \rightarrow \mathcal{L}\left( V^{d}\right)
\end{equation}%
produces \textbf{the} \textbf{Transpose} $A^{t}\in \mathcal{L}\left(
V\right) $ of $A$%
\begin{equation}
A=\sum_{1\leq j\leq r}x_{j}\left[ y_{dj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{d1} \\ 
\vdots \\ 
y_{dr}%
\end{array}%
\right) \right] .
\end{equation}%
by 
\begin{equation}
A^{t}=\sum_{1\leq j\leq r}y_{dj}\left[ x_{ddj}\right] =\left( 
\begin{array}{ccc}
y_{d1} & \cdots & y_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{dd1} \\ 
\vdots \\ 
x_{ddr}%
\end{array}%
\right) \right]
\end{equation}%
i.e. 
\begin{equation}
\left( \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{d1} \\ 
\vdots \\ 
y_{dr}%
\end{array}%
\right) \right] \right) ^{t}=\left( 
\begin{array}{ccc}
y_{d1} & \cdots & y_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{dd1} \\ 
\vdots \\ 
x_{ddr}%
\end{array}%
\right) \right] .
\end{equation}
\end{definition}

\subsection{Sub Space Decompositions.}

A vector space $V$ can be decomposed into a direct sum of two complimentray
subspaces $U$ and $W$ where

\begin{definition}
Complimentary Subspaces: Let 
\begin{equation}
V=U\oplus W
\end{equation}%
such that 
\begin{equation}
U\cap W=\phi
\end{equation}%
and thus 
\begin{equation}
V=U+W
\end{equation}%
then the subspaces $U$ and $W$ are complimentray to each other i.e.%
\begin{equation}
U^{c}=W
\end{equation}%
and 
\begin{equation}
W^{c}=U.
\end{equation}
\end{definition}

Complimentary subspaces are not unique e.g. consider the two following
direct sum decompositions of $\mathbb{R}^{2}$ 
\begin{equation}
V=\mathbb{R}\text{-}\func{linspan}\left\{ \left( 1,0\right) \right\} \oplus 
\mathbb{R}\text{-}\func{linspan}\left\{ \left( 0,1\right) \right\} =U\oplus
W_{1}
\end{equation}%
and 
\begin{equation}
V=\mathbb{R}\text{-}\func{linspan}\left\{ \left( 1,0\right) \right\} \oplus 
\mathbb{R}\text{-}\func{linspan}\left\{ \left( 1,1\right) \right\} =U\oplus
W_{2}
\end{equation}%
so both $W_{1}$ and $W_{2}$ are complientary subspaces to $U.$

\begin{remark}
Both of sets of vectors $\left\{ \left( 1,0\right) ,\left( 0,1\right)
\right\} $ and $\left\{ \left( 1,0\right) ,\left( 1,1\right) \right\} $ form
bases of $\mathbb{R}^{2}$ as both are linearly independent sets i.e. 
\begin{gather}
c_{1}\left( 1,0\right) +c_{2}\left( 1,1\right) =0 \\
\Updownarrow \\
c_{1}+c_{2}=0 \\
c_{2}=0 \\
\Updownarrow \\
c_{1}=0\text{ and }c_{2}=0
\end{gather}%
and 
\begin{equation}
V=\mathbb{R}\text{-}\func{linspan}\left\{ \left( 0,1\right) \right\} \neq 
\mathbb{R}\text{-}\func{linspan}\left\{ \left( 1,1\right) \right\} .
\end{equation}%
However 
\begin{eqnarray}
\left( a,b\right) &=&c_{1}\left( 1,0\right) +c_{2}\left( 1,1\right) =\left(
c_{1}+c_{2},c_{2}\right) \\
a &=&c_{1}+c_{2}=c_{1}+b\Leftrightarrow c_{1}=a-b \\
b &=&c_{2}
\end{eqnarray}%
and 
\begin{equation}
\left( a,b\right) =\left( a-b\right) \left( 1,0\right) +b\left( 1,1\right)
,\,a,b\in \mathbb{R}.
\end{equation}
\end{remark}

\subsubsection{Projectors onto subspaces}

\begin{definition}
Projectors $P\in \mathcal{L}\left( V\right) $ are idempotents $P\in \limfunc{%
Idem}\left\{ V\right\} ,$ i.e. 
\begin{equation}
P^{2}=P.
\end{equation}
\end{definition}

\begin{definition}
If $P\in \mathcal{L}\left( V\right) $ is a projector then its complimentary
projector $P^{c}$ is defined by 
\begin{equation}
P^{c}=I_{V}-P.
\end{equation}
\end{definition}

\begin{remark}
It is easy to see that $P^{c}$ is a projector by 
\begin{equation}
\left( P^{c}\right) ^{2}=\left( I-P\right) ^{2}=I-2P+P=I-P=P^{c}.
\end{equation}
\end{remark}

\begin{lemma}
The projectors $P$ and $P^{c}$ are \emph{orthogonal} to each other i.e. 
\begin{equation}
PP^{c}=P^{c}P=0.
\end{equation}

\begin{proof}
\begin{equation}
P^{c}P=\left( I-P\right) P=0
\end{equation}%
and 
\begin{equation}
PP^{c}=P\left( I-P\right) =0.
\end{equation}
\end{proof}
\end{lemma}

\begin{remark}
The general concept of orthogonality in a vector space $V$ involves its dual 
$V^{d}$ and is defined by
\end{remark}

\begin{definition}
The orthogonal compliment $U^{\bot }\subset V^{d}$ of $U\subset V$ 
\begin{equation}
U^{\bot }=\left\{ \left. f\right\vert f\left( v\right) =0,\;\forall v\in
U,\;f\in V^{d}\right\} .
\end{equation}%
This leads to the definition
\end{definition}

\begin{definition}
The double orthogonal compliment $^{\bot }U^{\bot }\subset V$ of $U\subset V$
by 
\begin{equation}
^{\bot }U^{\bot }=\left\{ \left. v\right\vert f\left( v\right) =0,\;\forall
v\in U,\;\forall f\in U^{\bot _{d}}\right\} .
\end{equation}
\end{definition}

\begin{remark}
In finite dimensions 
\begin{equation}
^{\bot }U^{\bot }=U.
\end{equation}
\end{remark}

\begin{definition}
The projector $P_{U}$ corresponds to a subspace $U\subset V$ if 
\begin{equation}
P_{U}U=U,
\end{equation}%
i.e. 
\begin{equation}
\limfunc{Ran}\left\{ P_{U}\right\} =\limfunc{Image}\left\{ P_{U}\right\} =U.
\end{equation}
\end{definition}

The projectors $P_{U}$ are not unique and one defines the equivalence class
of projectors by

\begin{definition}
The euqivalence class $\mathfrak{p}_{U}$ of projectors onto the subspace $U$
is defined by 
\begin{equation}
\mathfrak{p}_{U}=\left\{ \left. P_{U}\right\vert P_{U}U=U,\;P_{U}\in 
\limfunc{Idem}\left\{ V\right\} \right\} .
\end{equation}
\end{definition}

\begin{remark}
Different direct sum decompositions of $V$ wrt a subspace $U$ are given by 
\begin{equation}
V=U\oplus P_{U}^{c}V=P_{U}U\oplus P_{U}^{c}V,
\end{equation}%
where $P_{U}\in \mathfrak{p}_{U}.$ Different $P_{U}$ 's give different $%
V^{c} $ 's.
\end{remark}

\begin{remark}
The projectors form a resolution of the identity. 
\begin{equation}
I_{V}=P_{U}\oplus P_{U}^{c}.
\end{equation}
\end{remark}

\begin{example}
\begin{enumerate}
\item Let $P=\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) $ and $P^{c}=I-P=\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) $ then

\begin{enumerate}
\item 
\begin{eqnarray}
P\left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) =\left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) \\
P^{2} &=&\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) ^{2}=\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) =P
\end{eqnarray}%
then

\item 
\begin{equation}
P^{c}=\mathbb{I}_{2}-P=\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 1%
\end{array}%
\right) -\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) =\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) .
\end{equation}

\item 
\begin{eqnarray}
P^{c}\left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) \left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) =\left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) \\
\left( P^{c}\right) ^{2} &=&\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) ^{2}=\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) =P^{c}.
\end{eqnarray}
\end{enumerate}

\item Let

\begin{enumerate}
\item 
\begin{equation}
P=\left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right) \text{ then }P^{c}=\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 1%
\end{array}%
\right) -\left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right) =\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 1%
\end{array}%
\right)
\end{equation}
then

\item 
\begin{eqnarray}
P\left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) =\left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) \\
P^{2} &=&\left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right) ^{2}=\left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right) \left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right) =\left( 
\begin{array}{cc}
1 & -1 \\ 
0 & 0%
\end{array}%
\right)
\end{eqnarray}

\item 
\begin{eqnarray}
\text{ }P^{c}\left( 
\begin{array}{c}
1 \\ 
1%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 1%
\end{array}%
\right) \left( 
\begin{array}{c}
1 \\ 
1%
\end{array}%
\right) =\left( 
\begin{array}{c}
1 \\ 
1%
\end{array}%
\right) \\
\left( \text{ }P^{c}\right) ^{2} &=&\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 1%
\end{array}%
\right) ^{2}=\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 1%
\end{array}%
\right) \left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 1%
\end{array}%
\right) =\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 1%
\end{array}%
\right) =\text{ }P^{c}.
\end{eqnarray}
\end{enumerate}
\end{enumerate}
\end{example}

\subsubsection{Dualizing Maps \label{12/14/2025}}

\begin{remark}
\begin{enumerate}
\item 
\begin{enumerate}
\item Recall the double dual map $d_{2}=\iota _{V^{dd}V}\in \mathcal{L}%
\left( V^{dd},V\right) $ is defined by 
\begin{equation}
d_{2}\left( x\right) =x_{dd},
\end{equation}%
where 
\begin{equation}
d_{2}\left( x\right) \left( v\right) =\left[ x_{ddj}\right] \left(
v_{d}\right) =x_{ddj}\left( v_{d}\right) =v_{d}\left( x\right) ,
\end{equation}%
i.e. 
\begin{equation}
x_{dd}\left( v_{d}\right) =v_{d}\left( x\right) ,\,\forall v_{d}\in V^{d}
\end{equation}%
and

\item the biorthogonalizing map $b$ 
\begin{equation}
b\left( x\right) =x_{b},
\end{equation}%
is defined by 
\begin{eqnarray}
x_{b}\left( x\right) &=&1,\,x_{b}\in V^{d},\,x\in V \\
x_{b}\left( x^{c}\right) &=&0,x^{c}\in V^{d}\ominus \left\{ x\right\} .
\end{eqnarray}%
The map $b$ \textbf{is} \textbf{not} \textbf{linear} on vectors $v\in V$ as 
\begin{eqnarray}
b\left( c_{1}x_{1}+c_{2}x_{2}\right) &=&c_{1}b\left( x_{1}\right)
+c_{2}b\left( x_{2}\right) \\
\left( \overset{}{c_{1}b\left( x_{1}\right) +c_{2}b\left( x_{2}\right) }%
\right) \left( \overset{}{v}\right) &=&c_{1}b\left( x_{1}\right) \left(
v\right) +c_{2}b\left( x_{2}\right) \left( v\right) \\
c_{1}b\left( x_{1}\right) \left( v\right) +c_{2}b\left( x_{2}\right) \left(
v\right) &=&\left\{ 
\begin{array}{c}
v=x_{1}\Rightarrow \left( c_{1}b\left( x_{1}\right) +c_{2}b\left(
x_{2}\right) \right) \left( x_{1}\right) =c_{1} \\ 
v=x_{2}\Rightarrow \left( c_{1}b\left( x_{1}\right) +c_{2}b\left(
x_{2}\right) \right) \left( x_{2}\right) =c_{2} \\ 
v\neq x_{1},x_{2}\Rightarrow \left( c_{1}b\left( x_{1}\right) +c_{2}b\left(
x_{2}\right) \right) \left( v\right) =0%
\end{array}%
\right. ,
\end{eqnarray}%
while 
\begin{equation}
\left[ b\left( c_{1}x_{1}+c_{2}x_{2}\right) \right] \left( x_{1}\right) =%
\left[ b\left( c_{1}x_{1}+c_{2}x_{2}\right) \right] \left( x_{2}\right) =0.
\end{equation}%
The difference between $x_{d_{e}}=b_{e}\left( x\right) $, $%
x_{d_{e}}=d_{e}\left( x\right) $, $x_{d_{f_{d}}d_{e}}=d_{f_{d}}\left(
d_{e}\left( x\right) \right) $ and $x_{dd}=d_{2}\left( x\right) :$
\end{enumerate}

\item Let $\left( \boldsymbol{f}_{d}\right) $ be \textbf{any} basis of $%
V^{d} $ then the basis $\left( \boldsymbol{e}_{b}\right) $ of $V^{d}$ is
biorthogonal to the basis $\left( \boldsymbol{e}\right) $ o $V$ where 
\begin{equation}
\left( \overset{}{\boldsymbol{e}_{b}}\right) =\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \equiv \left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}%
\right) }\right) ^{-1}\left( \overset{}{\boldsymbol{f}_{d}}\right) .
\end{equation}%
\begin{equation}
\Updownarrow
\end{equation}%
\begin{equation}
\left( \overset{}{\boldsymbol{e}_{b}}\right) ^{t}=\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}=\left( \overset{}{\boldsymbol{f}_{d}}\right) ^{t}\left( 
\overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-t}.
\end{equation}

\begin{remark}
The construction $b\in \hom \left\{ \mathfrak{B}\left( V^{d}\right) ,%
\mathfrak{B}\left( V\right) \right\} $ does not depend on what basis is used
for $V^{d}$ i.e. 
\begin{equation}
b_{e}\left( \boldsymbol{e}\right) =\left( \overset{}{\boldsymbol{e}_{b}}%
\right) =\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }%
\right) ^{-1}\left( \overset{}{\boldsymbol{f}_{d}}\right) =\left( \overset{}{%
\boldsymbol{h}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left( \overset{%
}{\boldsymbol{h}_{d}}\right) ,\;\forall \left( \boldsymbol{f}_{d}\right)
,\left( \boldsymbol{h}_{d}\right) \in \mathfrak{B}\left( V^{d}\right) .
\end{equation}
\end{remark}

\begin{remark}
The effect of the maps $b_{e}$ on individual basis elements is 
\begin{equation}
b_{e}\left( e_{j}\right) =e_{bj}=\sum_{1\leq k\leq r}\left( \overset{}{%
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right)
_{jk}^{-1}f_{dk}=\sum_{1\leq k\leq r}\left( \overset{}{\boldsymbol{h}%
_{d}\left( \boldsymbol{e}\right) }\right) _{jk}^{-1}h_{dk}.
\end{equation}
\end{remark}

\begin{remark}
\begin{enumerate}
\item $b_{e}\left( \boldsymbol{x}\right) $ is \textbf{not biorthogonal} to $%
\left( \boldsymbol{x}\right) $ unless $\left( \boldsymbol{x}\right) =$ $%
\left( \boldsymbol{e}\right) $.

\item $b_{e}\left( \boldsymbol{x}\right) $ is \textbf{not equal} to $%
b_{f}\left( \boldsymbol{x}\right) $ unless $\left( \boldsymbol{e}\right) =$ $%
\left( \boldsymbol{f}\right) $.
\end{enumerate}
\end{remark}

\item On individual vectors $v\in V$ the map to a biorthogonal vector $%
b_{e}\left( v\right) $ does depend on the basis $\left( \boldsymbol{f}%
_{d}\right) $ used for $V^{d}$ i.e.

\begin{enumerate}
\item 
\begin{eqnarray}
b_{e}\left( v\right) &=&\left( \overset{}{\boldsymbol{f}_{d}}\right)
^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }%
\right) ^{-t}\left( \overset{}{\mathcal{R}_{e}\left( v\right) }\right)
=\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v\right) _{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v\right) _{r}%
\end{array}%
\right) ,
\end{eqnarray}

\item which can be recast as 
\begin{gather}
b_{e}\left( v\right) =b_{e}\left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) \right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =b_{e}\left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1}\left( v\right) \\ 
\vdots \\ 
e_{br}\left( v\right)%
\end{array}%
\right) \right) \\
=b_{e}\left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \overset{}{v}\right) \right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1}\left( v\right) \\ 
\vdots \\ 
e_{br}\left( v\right)%
\end{array}%
\right) =\left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \right) \left( \overset{}{v}\right) .
\end{gather}

\begin{lemma}
\begin{equation}
d_{e}=b_{e}
\end{equation}
\end{lemma}

\begin{proof}
as 
\begin{equation}
b_{e}\left( v\right) =\sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e}\left(
v\right) _{k}=\sum_{1\leq k\leq r}e_{bk}\left[ e_{bk}\right] \left( v\right)
\end{equation}%
and 
\begin{equation}
d_{e}\left( v\right) =\sum_{1\leq k\leq r}e_{bk}\left[ e_{bk}\right] \left(
v\right) =\sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e}\left( v\right) _{k}
\end{equation}
thus 
\begin{equation}
d_{e}=b_{e}.\blacksquare
\end{equation}
\end{proof}
\end{enumerate}

\item There is \textbf{no} single dualizing map $d,$ one can however
construct maps $d_{e}:V\rightarrow V^{d}$ that depend on bases $\left( 
\boldsymbol{e}\right) $ of $V$, so there is no single $x_{d}\in V^{d}$
corresponding to $x\in V$ i.e. 
\begin{equation}
d_{e}\left( v\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \overset{}{v}\right) ,
\end{equation}%
which is based on biorthogonalization maps $b_{e}\in \mathcal{L}\left(
V^{d},V\right) $ 
\begin{equation}
b_{e}:\left( \boldsymbol{e}\right) \rightarrow \left( \boldsymbol{e}%
_{b}\right)
\end{equation}%
and are in fact identical to $d_{e}$ i.e. 
\begin{equation}
b_{e}\left( v\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( v\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \overset{}{v}\right) .
\end{equation}

\item One can consider maps $V^{d}\rightarrow V^{dd}$ in the same manner.
\end{enumerate}
\end{remark}

\subsubsection{Matrix Representations of $A$ and $A^{t}$ \label{Matrix
Representations of A and its Transpose}}

\begin{enumerate}
\item The matrix representations of $A$ and $A^{t}$ wrt bases $\left( 
\boldsymbol{e}\right) $ and $\left( \boldsymbol{e}_{b}\right) $ of $V$ and $%
V^{d}$ are

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{d1} \\ 
\vdots \\ 
y_{dr}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{d1}\left( e_{1}\right) & \cdots & y_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{dr}\left( e_{1}\right) & \cdots & y_{dr}\left( e_{r}\right)%
\end{array}%
\right) .
\end{equation}

\item 
\begin{gather}
\mathcal{R}_{e_{b}}\left( A^{t}\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
y_{d1} & \cdots & y_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{dd1} \\ 
\vdots \\ 
x_{ddr}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( y_{d1}\right) & \cdots & e_{bb1}\left( y_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( y_{d1}\right) & \cdots & e_{bbr}\left( y_{dr}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{dd1}\left( e_{b1}\right) & \cdots & x_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{ddr}\left( e_{b1}\right) & \cdots & x_{ddr}\left( e_{br}\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) ^{t}.
\end{gather}
\end{enumerate}

\item The transpose $\mathcal{R}_{e}\left( A\right) ^{t}$ of the
representation $\mathcal{R}_{e}\left( A\right) $ of $A$ is 
\begin{eqnarray}
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) ^{t} \\
&=&\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{br}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{r}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{br}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{r}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \\
&=&\left( \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \right) ^{t}.
\end{eqnarray}

\item \textbf{In general} $\mathcal{R}_{e}\left( A^{t}\right) =\mathcal{R}%
_{e}\left( A\right) ^{t}.$ Which can be seen from

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{br}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{r}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right)
\end{equation}%
and

\item 
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( y_{b1}\right) & \cdots & e_{bb1}\left( y_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( y_{b1}\right) & \cdots & e_{bbr}\left( y_{br}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{bb1}\left( e_{b1}\right) & \cdots & x_{bb1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{bbr}\left( e_{b1}\right) & \cdots & x_{bbr}\left( e_{br}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{br}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{1}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right)
\end{equation}%
and observes that 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\mathcal{R}_{e}\left( A^{t}\right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{remark}
\bigskip In the preceding we used duality induced by biorthogonality to
obtain 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( y_{1}\right) & \cdots & e_{br}\left( y_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
y_{bb1}\left( e_{b1}\right) & \cdots & y_{bbr}\left( e_{b1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{bb1}\left( e_{br}\right) & \cdots & y_{bbr}\left( e_{br}\right)%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{br}\left( e_{1}\right) & \cdots & x_{br}\left( e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( x_{b1}\right) & \cdots & e_{bb1}\left( x_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( x_{b1}\right) & \cdots & e_{bbr}\left( x_{br}\right)%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
By definition 
\begin{eqnarray}
x_{bj}\left( e_{k}\right) &=&\left( \left. \mathfrak{b}\left( x_{j}\right)
\right\vert e_{k}\right) \\
e_{bk}\left( x_{j}\right) &=&\left( \left. \mathfrak{b}\left( e_{j}\right)
\right\vert x_{k}\right) .
\end{eqnarray}
\end{remark}

\begin{theorem}
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\mathcal{R}_{e}\left( A\right) ^{t}.
\end{equation}

\begin{proof}
From the preceding.
\end{proof}
\end{theorem}

\begin{remark}
\begin{gather}
A=\sum_{1\leq j\leq r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{br}%
\end{array}%
\right) \right] \\
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] ,
\end{gather}%
hence 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) .
\end{equation}
\end{remark}

\section{Inner Product and Transpose}

\subsection{Change of Basis}

\subsubsection{$\left( \boldsymbol{\protect\sigma }\right) $ and $\left( 
\boldsymbol{\protect\rho }\right) $ basis}

\begin{enumerate}
\item Transformation operators $S_{\rho \sigma }\in \mathcal{L}\left(
V\right) $ from the $\left( \boldsymbol{\sigma }\right) $ basis to the $%
\left( \boldsymbol{\rho }\right) $ basis of $V$ are given by 
\begin{eqnarray}
S_{\rho \sigma } &=&\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}\rho _{j}\left[ \sigma _{bj}\right] \\
S_{\rho \sigma }^{-1} &=&\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\rho _{b1} \\ 
\vdots \\ 
\rho _{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}\sigma _{j}\left[ \rho _{bj}\right]
=S_{\sigma \rho }.
\end{eqnarray}

\item Representations $\mathcal{R}_{\rho }\left( S_{\rho \sigma }\right) $
and $\mathcal{R}_{\sigma }\left( S_{\rho \sigma }\right) $ of $S_{\rho
\sigma }$ are given by 
\begin{equation}
\mathcal{R}_{\rho }\left( S_{\rho \sigma }\right) =\left[ \left( 
\begin{array}{c}
\rho _{b1} \\ 
\vdots \\ 
\rho _{br}%
\end{array}%
\right) \right] \left( \overset{}{\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] }\right) \left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{\sigma }\left( S_{\rho \sigma }\right) =\left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] \left( \overset{}{\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] }\right) \left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right)
\end{equation}%
giving 
\begin{gather}
\mathbb{S}_{\rho \sigma }=\mathcal{R}_{\rho }\left( S_{\rho \sigma }\right) =%
\mathcal{R}_{\sigma }\left( S_{\rho \sigma }\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\sigma _{b1}\left( \rho _{1}\right) & \cdots & \sigma _{b1}\left( \rho
_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\sigma _{br}\left( \rho _{1}\right) & \cdots & \sigma _{br}\left( \rho
_{r}\right)%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
\rho _{b1} \\ 
\vdots \\ 
\rho _{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) .
\end{gather}

\item In super vector notation%
\begin{eqnarray}
\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\sigma _{b1}\left( \rho _{1}\right) & \cdots & \sigma _{b1}\left( \rho
_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\sigma _{br}\left( \rho _{1}\right) & \cdots & \sigma _{br}\left( \rho
_{r}\right)%
\end{array}%
\right) .
\end{eqnarray}

\item The change of basis $\left( \boldsymbol{\sigma }\right) $ to $\left( 
\boldsymbol{\rho }\right) $ is given by 
\begin{equation}
\left( \boldsymbol{\rho }\right) ^{t}=S_{\rho \sigma }\left( \boldsymbol{%
\sigma }\right) ^{t}=\left( \boldsymbol{\sigma }\right) ^{t}\mathcal{R}%
_{\sigma }\left( S_{\rho \sigma }\right) =\left( \boldsymbol{\sigma }\right)
^{t}\mathbb{S}_{\rho \sigma }.
\end{equation}

\item Representations $\mathcal{R}_{\rho }\left( T\right) $ and $\mathcal{R}%
_{\sigma }\left( T\right) $ of $T$ are related by 
\begin{equation}
T\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) =T\left( \boldsymbol{\rho }\right) ^{t}=\left( \boldsymbol{\rho }%
\right) ^{t}\mathcal{R}_{\rho }\left( T\right) =T\left[ S_{\rho \sigma }%
\right] \left( \boldsymbol{\sigma }\right) ^{t}=\left( \boldsymbol{\rho }%
\right) ^{t}\mathbb{S}_{\rho \sigma }^{-1}\mathcal{R}_{\sigma }\left(
T\right) \mathbb{S}_{\rho \sigma }
\end{equation}%
hence the change of basis $\left( \boldsymbol{\sigma }\right) $ to $\left( 
\boldsymbol{\rho }\right) $ produces the change of representation 
\begin{equation}
\mathcal{R}_{\rho }\left( T\right) =\mathbb{S}_{\rho \sigma }^{-1}\mathcal{R}%
_{\sigma }\left( T\right) \mathbb{S}_{\rho \sigma }.
\end{equation}

\item Representations $\mathcal{R}_{\rho }\left( v\right) $ and $\mathcal{R}%
_{\sigma }\left( v\right) $ of $v$ are related by 
\begin{equation}
v=\left( \boldsymbol{\rho }\right) ^{t}\mathcal{R}_{\rho }\left( v\right)
=\left( \boldsymbol{\sigma }\right) ^{t}\mathcal{R}_{\sigma }\left( v\right)
=S_{\rho \sigma }\left( \boldsymbol{\sigma }\right) ^{t}\mathcal{R}_{\rho
}\left( v\right) =\left( \boldsymbol{\sigma }\right) ^{t}\mathbb{S}_{\rho
\sigma }\mathcal{R}_{\rho }\left( v\right)
\end{equation}%
hence the change of basis $\left( \boldsymbol{\sigma }\right) $ to $\left( 
\boldsymbol{\rho }\right) $ produces the change of representation 
\begin{equation}
\mathcal{R}_{\sigma }\left( v\right) =\mathbb{S}_{\rho \sigma }\mathcal{R}%
_{\rho }\left( v\right) \Leftrightarrow \mathbb{S}_{\rho \sigma }^{-1}%
\mathcal{R}_{\sigma }\left( v\right) =\mathcal{R}_{\rho }\left( v\right) .
\end{equation}
\end{enumerate}

\begin{remark}
Resolutions of the identity produce representations and expansions of
vectors $v$ and operators $T$
\end{remark}

\begin{enumerate}
\item 
\begin{remark}
\begin{enumerate}
\item Using the Resolution of the identity%
\begin{equation}
I_{V}=\left\vert \overset{}{\boldsymbol{\rho }}\right) ^{t}\left( \overset{}{%
\mathfrak{b}\left( \boldsymbol{\rho }\right) }\right\vert
\end{equation}%
one obtains

\item Dyadic expansions 
\begin{equation}
T=I_{V}TI_{V}=\left\vert \overset{}{\boldsymbol{\rho }}\right) ^{t}\left( 
\mathfrak{b}\left( \boldsymbol{\rho }\right) \left\vert \overset{}{T%
\boldsymbol{\rho }}\right) \right) \left( \overset{}{\mathfrak{b}\left( 
\boldsymbol{\rho }\right) }\right\vert =\left\vert \overset{}{\boldsymbol{%
\rho }}\right) ^{t}\mathcal{R}_{\rho }\left( T\right) \left( \overset{}{%
\mathfrak{b}\left( \boldsymbol{\rho }\right) }\right\vert
\end{equation}

\item Operator Representations 
\begin{equation}
T\left\vert \overset{}{\boldsymbol{\rho }}\right) ^{t}=I_{V}T=\left\vert 
\overset{}{\boldsymbol{\rho }}\right) ^{t}\left( \left. \overset{}{\mathfrak{%
b}\left( \boldsymbol{\rho }\right) }\right\vert \overset{}{T\boldsymbol{\rho 
}}\right) =\left\vert \overset{}{\boldsymbol{\rho }}\right) ^{t}\mathcal{R}%
_{\rho }\left( T\right)
\end{equation}

\item Vector Representations 
\begin{equation}
v=I_{V}v=\left\vert \overset{}{\boldsymbol{\rho }}\right) ^{t}\left( \left. 
\overset{}{\mathfrak{b}\left( \boldsymbol{\rho }\right) }\right\vert \overset%
{}{v}\right) =\left\vert \overset{}{\boldsymbol{\rho }}\right) ^{t}\mathcal{R%
}_{\rho }\left( v\right)
\end{equation}
\end{enumerate}
\end{remark}
\end{enumerate}

\begin{remark}
Any operator $T_{\alpha \beta }\in \mathcal{L}\left( V\right) $ can be
expanded by Greubs theorem 
\begin{equation}
T_{\alpha \beta }=\sum_{1\leq j\leq r}\alpha _{j}\left[ \beta _{dj}\right]
=\sum_{1\leq j,k,l\leq r}e_{k}\left[ e_{bl}\right] A_{kj}B_{dlj}=\sum_{1\leq
j,k,l\leq r}e_{k}\left[ e_{bl}\right] \left( \mathbb{AB}_{d}^{t}\right)
_{kl}=\sum_{1\leq j,k,l\leq r}e_{k}\left[ e_{bl}\right] \left( \mathcal{R}%
_{e}\left( A\right) \mathcal{R}_{e_{b}}\left( B_{d}\right) ^{t}\right)
_{kl}=\sum_{1\leq j,k,l\leq r}e_{k}\left( \overset{}{\mathcal{R}_{e}\left(
A\right) \mathcal{R}_{e_{b}}\left( B_{d}\right) ^{t}}\right) _{kl}\left[
e_{bl}\right] ,
\end{equation}%
where $A\in \mathcal{L}\left( V\right) $ and $B\in \mathcal{L}\left(
V^{d}\right) .$
\end{remark}

\subsubsection{General Bases}

\begin{enumerate}
\item Transformation operators $S_{ef}\in \mathcal{L}\left( V\right) $ from
the $\left( \boldsymbol{f}\right) $ basis to the $\left( \boldsymbol{e}%
\right) $ basis of $V$ are given by 
\begin{eqnarray}
S_{ef} &=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}\left[ f_{bj}\right] \\
S_{ef}^{-1} &=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}f_{j}\left[ e_{bj}\right] =S_{fe}.
\end{eqnarray}

\item Representations $\mathcal{R}_{e}\left( S_{ef}\right) $ and $\mathcal{R}%
_{f}\left( S_{ef}\right) $ of $S_{ef}$ can be expressed as 
\begin{gather}
\mathbb{S}_{ef} \\
\parallel \\
\mathcal{R}_{e}\left( S_{ef}\right) =\mathcal{R}_{f}\left( S_{ef}\right)
=\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) .
\end{gather}

\item Expressing $\left( \boldsymbol{\rho }\right) $ in terms of a general
basis $\left( \boldsymbol{e}\right) $ on obtains 
\begin{equation}
\left( \boldsymbol{\rho }\right) =S_{\rho e}\left( \boldsymbol{e}\right)
=\left( \boldsymbol{e}\right) \mathbb{S}_{\rho e}=\left( \boldsymbol{e}%
\right) \mathcal{R}_{e}\left( S_{\rho e}\right)
\end{equation}%
i.e. 
\begin{equation}
\left( 
\begin{array}{ccc}
\rho _{1} & \cdots & \rho _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( \rho _{1}\right) & \cdots & e_{b1}\left( \rho _{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( \rho _{1}\right) & \cdots & e_{br}\left( \rho _{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. \rho _{1}\right\vert e_{r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \rho _{r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. \rho _{r}\right\vert e_{r}\right) _{\rho \sigma }%
\end{array}%
\right) .
\end{equation}

\begin{enumerate}
\item The effect of change of basis on representations of vectors is given by%
\begin{equation}
\mathcal{R}_{\rho }\left( v\right) =\mathbb{S}_{\rho e}\mathcal{R}_{e}\left(
v\right) =\mathcal{R}_{e}\left( S_{\rho e}\right) \mathcal{R}_{e}\left(
v\right) .
\end{equation}

\item The effect of change of basis on representations of operators is given
by 
\begin{equation}
\mathcal{R}_{\rho }\left( T\right) =\mathbb{S}_{\rho e}\mathcal{R}_{e}\left(
T\right) \mathbb{S}_{\rho e}^{-1}=\mathcal{R}_{e}\left( S_{\rho e}\right) 
\mathcal{R}_{e}\left( T\right) \mathcal{R}_{e}\left( S_{\rho e}\right) ^{-1}
\end{equation}%
and

\item their effect on operators acting on vectors%
\begin{equation}
\mathcal{R}_{\rho }\left( Tv\right) =\mathcal{R}_{\rho }\left( T\right) 
\mathcal{R}_{\rho }\left( v\right) =\left( \mathcal{R}_{e}\left( S_{\rho
e}\right) \mathcal{R}_{e}\left( T\right) \mathcal{R}_{e}\left( S_{\rho
e}\right) ^{-1}\right) \left( \mathcal{R}_{e}\left( S_{\rho e}\right) 
\mathcal{R}_{e}\left( v\right) \right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\subsection{Inner Products}

The maps $d_{\rho \sigma }\in \mathcal{L}\left( V^{d},V\right) $ \label{maps
from a vector space to its dual defined by dual second rank tensors} that
map elements of the vector space $V$ to its dual $V^{d}$ can be constructed
from non degenerate elements of the dual tensor product space $V^{d}\otimes
V^{d}$ by

\begin{enumerate}
\item 
\begin{definition}
Dualizing maps $d_{\rho \sigma }\in \mathcal{L}\left( V^{d},V\right) $%
\begin{equation}
v_{d\rho \sigma }=d_{\rho \sigma }\left( v\right) =\sum_{1\leq j\leq r}\left[
\rho _{dj}\otimes \sigma _{dj}\right] \left( v\otimes \left( \cdot \right)
\right) =\sum_{1\leq j\leq r}\rho _{dj}\left( v\right) \sigma _{dj}\left(
\cdot \right) ,
\end{equation}%
where $\left( \mathbf{\rho }_{d}\right) $ and $\left( \mathbf{\sigma }%
_{d}\right) $ are bases of $V^{d}.$
\end{definition}

\begin{lemma}
$d_{\rho \sigma }\in \mathcal{L}\left( V^{d},V\right) $ are injections

\begin{proof}
$d_{\rho \sigma }$ is an injection if 
\begin{equation}
\ker \left( d_{\rho \sigma }\right) =\phi ,
\end{equation}%
where%
\begin{equation}
\ker \left( d_{\rho \sigma }\right) =\left\{ v\left\vert \sum_{1\leq j\leq
r}\rho _{dj}\left( v\right) \sigma _{dj}\left( w\right) =0\quad \forall w\in
V,\,v\in V\right. \right\} .
\end{equation}%
If 
\begin{equation}
\sum_{1\leq j\leq r}\rho _{dj}\left( v\right) \sigma _{dj}\left( w\right)
=0\quad \forall w\in V
\end{equation}%
then 
\begin{equation}
\sum_{1\leq j\leq r}\rho _{dj}\left( v\right) \sigma _{dj}=0
\end{equation}%
and 
\begin{equation}
v=0,
\end{equation}%
hence $d_{\rho \sigma }\in \mathcal{L}\left( V^{d},V\right) $ is an
injection.$\blacksquare $

\begin{corollary}
The inverse on the range $d_{\rho \sigma }^{-1}\in \mathcal{L}\left(
V,V^{d}\right) $ is an injection fron the $\limfunc{Ran}\left( d_{\rho
\sigma }\right) $ i.e. 
\begin{equation}
d_{\rho \sigma }^{-1}\left( v_{d\rho \sigma }\right) =d_{\rho \sigma
}^{-1}\left( \sum_{1\leq j\leq r}\left[ \rho _{j}\otimes \sigma _{j}\right]
\left( v\otimes \left( \cdot \right) \right) \right) =v.
\end{equation}
\end{corollary}
\end{proof}
\end{lemma}

\begin{definition}
\begin{eqnarray}
\left( \sigma _{j}\right\vert _{\rho \sigma }\left( w\right) &=&\sigma
_{dj}\left( w\right) \quad \forall w\in V \\
\left( \rho _{j}\right\vert _{\rho \sigma }\left( v\right) &=&\rho
_{dj}\left( v\right) \quad \forall v\in V.
\end{eqnarray}
\end{definition}

\item In general%
\begin{equation}
d_{\rho \sigma }^{-1}\left( \left( \gamma \right\vert _{\rho \sigma }\right)
=\left\vert \gamma \right) _{\rho \sigma }
\end{equation}%
so in particular 
\begin{eqnarray}
d_{\rho \sigma }^{-1}\left( \left( \sigma _{j}\right\vert _{\rho \sigma
}\right) &=&\left\vert \sigma _{j}\right) _{\rho \sigma } \\
d_{\rho \sigma }^{-1}\left( \left( \rho _{j}\right\vert _{\rho \sigma
}\right) &=&\left\vert \rho _{j}\right) _{\rho \sigma }
\end{eqnarray}%
and 
\begin{eqnarray}
d_{\rho \sigma }\left( \left\vert \sigma _{j}\right) _{\rho \sigma }\right)
&=&\left( \sigma _{j}\right\vert _{\rho \sigma } \\
d_{\rho \sigma }\left( \left\vert \rho _{j}\right) _{\rho \sigma }\right)
&=&\left( \rho _{j}\right\vert _{\rho \sigma }.
\end{eqnarray}

\item \textbf{Inner products }$\left( \left. {}\right\vert \right) _{\rho
\sigma }$ \textbf{are defined by non degenerate dual tensors }$T_{d\rho
\sigma }\in $ $V^{d}\otimes V^{d}$ \label{Inner products are defined by dual
tensors} 
\begin{equation}
T_{d\rho \sigma }\left( v\otimes w\right) =\left( \left. v\right\vert
w\right) _{\rho \sigma }=\sum_{1\leq j\leq r}\left[ \rho _{dj}\otimes \sigma
_{dj}\right] \left( v\otimes w\right) =\sum_{1\leq j\leq r}\rho _{dj}\left(
v\right) \sigma _{dj}\left( w\right) =\sum_{1\leq j\leq r}\left( \left. \rho
_{j}\right\vert v\right) _{\rho \sigma }\left( \left. \sigma _{j}\right\vert
w\right) _{\rho \sigma }.
\end{equation}

\item In terms of operators belonging to $\mathcal{L}\left( V\right) $ \label%
{operators belonging to L(V)} 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\sum_{1\leq j\leq r}\rho
_{dj}\left( v\right) \sigma _{dj}\left( w\right) =\sum_{1\leq j\leq r}\left[
d_{\rho \sigma }\left( v\right) \right] \left( \rho \right) \sigma
_{dj}\left( w\right) =\left( \overset{\overset{}{}}{v}\right\vert _{\rho
\sigma }\left( \left( \sum_{1\leq j\leq r}\left\vert \rho _{j}\right) _{\rho
\sigma }\left( \sigma _{j}\right\vert _{\rho \sigma }\right) \left\vert 
\overset{}{w}\right) _{\rho \sigma }\right) =\sum_{1\leq j\leq r}\left(
\left. v\right\vert \rho _{j}\right) _{\rho \sigma }\left( \left. \sigma
_{j}\right\vert w\right) _{\rho \sigma }.
\end{equation}

\begin{remark}
\begin{equation}
\Xi \left( \overset{}{T_{d\rho \sigma }}\right) =\Xi \left( \sum_{1\leq
j\leq r}\rho _{dj}\otimes \sigma _{dj}\right) =\sum_{1\leq j\leq r}d_{\rho
\sigma }^{-1}\left( \rho _{dj}\right) \otimes \sigma _{dj}.
\end{equation}
\end{remark}
\end{enumerate}

\subsection{Matrix Form of Inner Product}

\subsubsection{Matrix Inner Products}

Expansion of vectors and operators wrt bases $\left( \boldsymbol{e}\right) $
and $\left( \boldsymbol{f}\right) $

\begin{definition}
Representations are defined by 
\begin{eqnarray}
v &=&\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( v\right) \\
T &=&\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( T\right) =\left( 
\boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( T\right)
\end{eqnarray}
\end{definition}

\begin{remark}
Representations and dyadic forms can be produced by utilizing resolutions of
the identity%
\begin{equation}
I_{V}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right)
\end{equation}
by 
\begin{eqnarray}
v &=&I_{V}v=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right)
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right) \\
v &=&I_{V}v=\left( \boldsymbol{f}\right) \mathcal{R}_{f}\left( v\right)
=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) v=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( T\right) \\
T &=&I_{V}TI_{V}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) T\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( T\right)
\left( \boldsymbol{e}_{b}\right) \\
T &=&I_{V}TI_{V}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) T\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{f}\left( T\right) _{11} & \cdots & \mathcal{R}_{f}\left(
T\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f}\left( T\right) _{r1} & \cdots & \mathcal{R}_{f}\left(
T\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( T\right)
\left( \boldsymbol{f}_{b}\right) .
\end{eqnarray}
\end{remark}

\begin{remark}
The change of basis operator $S_{ef}=\left( \boldsymbol{e}\right) ^{t}\left[
\left( \boldsymbol{f}_{b}\right) \right] \in \mathcal{L}\left( V\right) $ 
\begin{equation}
S_{ef}:\left( \boldsymbol{f}\right) \rightarrow \left( \boldsymbol{e}\right)
\end{equation}%
so that 
\begin{equation}
\left( \boldsymbol{e}\right) ^{t}=S_{ef}\left( \boldsymbol{f}\right)
^{t}=\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( S_{ef}\right)
\end{equation}%
of $V$ from $\left( \boldsymbol{f}\right) $ to $\left( \boldsymbol{e}\right) 
$ is given by
\end{remark}

\begin{equation}
S_{ef}=I_{V}S_{ef}I_{V}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) S_{ef}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{ef}\right) _{11} & \cdots & \mathcal{R}_{e}\left(
S_{ef}\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{ef}\right) _{r1} & \cdots & \mathcal{R}_{e}\left(
S_{ef}\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
S_{ef}=I_{V}S_{ef}I_{V}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) S_{ef}\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{f}\left( S_{ef}\right) _{11} & \cdots & \mathcal{R}_{f}\left(
S_{ef}\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f}\left( S_{ef}\right) _{r1} & \cdots & \mathcal{R}_{f}\left(
S_{ef}\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) .
\end{equation}

\begin{remark}
The action of $\left( S_{ef}\right) $ can be expressed as 
\begin{equation}
\left( S_{ef}\right) \left( \boldsymbol{f}\right) ^{t}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{f}\left( S_{ef}\right) _{11} & \cdots & \mathcal{R}_{f}\left(
S_{ef}\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f}\left( S_{ef}\right) _{r1} & \cdots & \mathcal{R}_{f}\left(
S_{ef}\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
The representation $\mathcal{R}_{e}$ of $S_{ef}$ is given by 
\begin{gather}
\mathcal{R}_{e}\left( S_{ef}\right) =\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) S_{ef}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{b}\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{bb1}\left( f_{b1}\right) & \cdots & e_{bb1}\left( f_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( f_{b1}\right) & \cdots & e_{bbr}\left( f_{br}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right)
\end{gather}%
and 
\begin{gather}
\mathcal{R}_{f}\left( S_{ef}\right) =\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) S_{ef}\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{b}\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{bb1}\left( f_{b1}\right) & \cdots & e_{bb1}\left( f_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( f_{b1}\right) & \cdots & e_{bbr}\left( f_{br}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( S_{ef}\right) =\mathcal{R}_{f}\left( S_{ef}\right) .
\end{equation}
\end{remark}

\subsubsection{Change of Basis $\left( \boldsymbol{f}\right) $ to $\left( 
\boldsymbol{e}\right) $}

The change of basis 
\begin{equation}
\left( \boldsymbol{e}\right) ^{t}=\left( S_{ef}\right) \left( \boldsymbol{f}%
\right) ^{t}=\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left(
S_{ef}\right)
\end{equation}%
produces the change of representations 
\begin{equation}
v=I_{V}v=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right)
=\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( v\right) =\left( 
\boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( S_{ef}\right) \mathcal{R}%
_{e}\left( v\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left(
S_{ef}\right) \mathcal{R}_{e}\left( v\right)
\end{equation}%
leading to 
\begin{eqnarray}
\mathcal{R}_{f}\left( v\right) &=&\mathcal{R}_{e}\left( S_{ef}\right) 
\mathcal{R}_{e}\left( v\right) \\
\mathcal{R}_{e}\left( S_{ef}\right) ^{-1}\mathcal{R}_{f}\left( v\right) &=&%
\mathcal{R}_{e}\left( v\right) .
\end{eqnarray}%
The change of representation of operators $T\in \mathcal{L}\left( V\right) $
are given by 
\begin{eqnarray}
Tv\left( \boldsymbol{e}\right) ^{t} &=&\left( \boldsymbol{e}\right) ^{t}%
\mathcal{R}_{e}\left( Tv\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}%
_{e}\left( T\right) \mathcal{R}_{e}\left( v\right) =\left( \boldsymbol{f}%
\right) ^{t}\mathcal{R}_{f}\left( S_{ef}\right) \mathcal{R}_{e}\left(
T\right) \mathcal{R}_{e}\left( v\right) =\left( \boldsymbol{f}\right) ^{t}%
\mathcal{R}_{e}\left( S_{ef}\right) \mathcal{R}_{e}\left( T\right) \mathcal{R%
}_{e}\left( v\right) \\
&=&\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left( S_{ef}\right) 
\mathcal{R}_{e}\left( T\right) \mathcal{R}_{e}\left( S_{ef}\right) ^{-1}%
\mathcal{R}_{e}\left( S_{ef}\right) \mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( T\right) \mathcal{R}%
_{f}\left( v\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left(
Tv\right)
\end{eqnarray}%
leading to 
\begin{gather}
\mathcal{R}_{f}\left( T\right) =\mathcal{R}_{e}\left( S_{ef}\right) \mathcal{%
R}_{e}\left( T\right) \mathcal{R}_{e}\left( S_{ef}\right) ^{-1} \\
\mathcal{R}_{e}\left( S_{ef}\right) ^{-1}\mathcal{R}_{f}\left( T\right) 
\mathcal{R}_{e}\left( S_{ef}\right) =\mathcal{R}_{e}\left( T\right) .
\end{gather}

Hence 
\begin{eqnarray}
Tv\left( \boldsymbol{e}\right) ^{t} &=&\left( \boldsymbol{e}\right) ^{t}%
\mathcal{R}_{e}\left( Tv\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}%
_{e}\left( T\right) \mathcal{R}_{e}\left( v\right) =\left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( S_{ef}\right) ^{-1}\mathcal{R}_{f}\left(
T\right) \mathcal{R}_{e}\left( S_{ef}\right) \mathcal{R}_{e}\left(
S_{ef}\right) ^{-1}\mathcal{R}_{f}\left( v\right) =\left( \boldsymbol{f}%
\right) ^{t}\mathcal{R}_{f}\left( Tv\right) \\
Tv\left( \boldsymbol{f}\right) ^{t} &=&\left( \boldsymbol{f}\right) ^{t}%
\mathcal{R}_{f}\left( Tv\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}%
_{f}\left( T\right) \mathcal{R}_{f}\left( v\right) =\left( \boldsymbol{f}%
\right) ^{t}\mathcal{R}_{e}\left( S_{ef}\right) \mathcal{R}_{e}\left(
T\right) \mathcal{R}_{e}\left( S_{ef}\right) ^{-1}\mathcal{R}_{e}\left(
S_{ef}\right) \mathcal{R}_{e}\left( v\right) =\left( \boldsymbol{e}\right)
^{t}\mathcal{R}_{e}\left( Tv\right)
\end{eqnarray}

\subsubsection{Inner Products}

\begin{eqnarray}
\left( \left. v\right\vert w\right) _{S_{1}} &=&\left( \left. v\right\vert
S_{1}w\right) =\mathcal{R}_{e}\left( v\right) ^{t}\mathcal{R}_{e}\left(
S_{1}\right) \mathcal{R}_{e}\left( w\right) =\mathcal{R}_{f}\left( v\right)
^{t}\mathcal{R}_{f}\left( S_{1}\right) \mathcal{R}_{f}\left( w\right) \\
\left( \left. v\right\vert w\right) &=&\mathcal{R}_{e}\left( v\right) ^{t}%
\mathcal{R}_{e}\left( w\right) =\mathcal{R}_{f}\left( v\right) ^{t}\mathcal{R%
}_{f}\left( w\right)
\end{eqnarray}

\subsubsection{Transposes}

\begin{gather}
\left( \left. T^{t_{1}}v\right\vert w\right) _{S_{1}}=\left( \left.
T^{t_{1}}v\right\vert S_{1}w\right) \\
=\left( \left. v\right\vert Tw\right) _{S_{1}}=\left( \left. v\right\vert
S_{1}Tw\right) \\
=\left( \mathcal{R}_{e}\left( T\right) ^{t_{1}}v\right) ^{t}\mathbb{S}_{1}w=%
\mathcal{R}_{e}\left( v\right) ^{t}\left( \mathcal{R}_{e}\left( T\right)
^{t_{1}}\right) ^{t}\mathbb{S}_{1}\mathcal{R}_{e}\left( w\right) =\mathcal{R}%
_{e}\left( v\right) ^{t}\mathbb{S}_{1}\mathcal{R}_{e}\left( T\right) 
\mathcal{R}_{e}\left( w\right)
\end{gather}%
giving%
\begin{gather}
\left( \left( \mathbb{T}^{t_{1}}\right) ^{t}\mathbb{S}_{1}=\mathbb{S}_{1}%
\mathbb{T}\right) \Leftrightarrow \left( \left( \mathbb{T}^{t_{1}}\right)
^{t}=\mathbb{S}_{1}\mathbb{TS}_{1}^{-1}\right) \Leftrightarrow \mathbb{T}%
^{t_{1}}=\mathbb{S}_{1}^{-t}\mathbb{T}^{t}\mathbb{S}_{1}^{t} \\
\left( \left. T^{t}v\right\vert w\right) =\left( \left. v\right\vert
Tw\right) =\left( \mathbb{T}^{t}v\right) ^{t}w=v^{t}\mathbb{T}w
\end{gather}

In terms of super vectors and coordinates \label{Matrix Form of Inner
Products} 
\begin{gather}
\left( \left. v\right\vert w\right) _{\rho \sigma } \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( v\right) _{1} & \cdots & \mathcal{R}_{\rho }\left(
v\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\rho _{d1} \\ 
\vdots \\ 
\rho _{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\sigma }\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\sigma }\left( w\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( v\right) _{1} & \cdots & \mathcal{R}_{\rho }\left(
v\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\rho _{d1}\left( \sigma _{1}\right) & \cdots & \rho _{d1}\left( \sigma
_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\rho _{dr}\left( \sigma _{1}\right) & \cdots & \rho _{dr}\left( \sigma
_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\sigma }\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\sigma }\left( w\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( v\right) _{1} & \cdots & \mathcal{R}_{\rho }\left(
v\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{1}\right\vert \sigma _{r}\right) _{\rho \sigma
} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{r}\right\vert \sigma _{r}\right) _{\rho \sigma
}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\sigma }\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\sigma }\left( w\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\mathcal{R}_{\rho }\left( v\right) ^{t}\mathbb{S}_{\rho \sigma }\mathcal{R}%
_{\sigma }\left( w\right)
\end{gather}

\subsection{Transposes Induced by Inner Products}

The effect of the operator $T^{t_{\rho \sigma }}\in \mathcal{L}\left(
V\right) $ on vectors inside the $\left( \left. {}\right\vert \right) _{\rho
\sigma }$ inner product is 
\begin{gather}
\left( \left. T^{t_{\rho \sigma }}v\right\vert w\right) _{\rho \sigma } \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}v\right) _{1} & \cdots & 
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}v\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\rho _{d1} \\ 
\vdots \\ 
\rho _{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\sigma }\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\sigma }\left( w\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}v\right) _{1} & \cdots & 
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}v\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
