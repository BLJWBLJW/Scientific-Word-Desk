\subsection{Operators Inside Inner Products in $V$}

\begin{enumerate}
\item 
\begin{definition}
$T^{\#}\in \mathcal{L}\left( V\right) $ by%
\begin{equation}
\left( \left. T^{\#}v\right\vert w\right) _{\rho \sigma }=\left( \left.
v\right\vert Tw\right) _{\rho \sigma }\quad \forall w\in V,\,v\in V,
\end{equation}
\end{definition}

\item The value of the RHS inner product is 
\begin{eqnarray}
\left( \left. v\right\vert Tw\right) _{\rho \sigma } &=&\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( v\right) _{1} & \cdots & \mathcal{R}_{\rho }\left(
v\right) _{1}%
