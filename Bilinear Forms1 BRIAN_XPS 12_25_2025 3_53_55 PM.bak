\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
\textbf{Observe that operators act from the left on BOTH row and column
supervectors.}
\end{remark}

\begin{theorem}
\textbf{No matter the symmetry of } $\left( \left. \cdot \right\vert \cdot
\right) _{\rho \sigma }$ the matrix representation of an opertor acting in
the first argument is the transpose of the representation of the operator
i.e. 
\begin{equation}
\left( \left. Tv\right\vert w\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
T\right) ^{t}\mathcal{R}_{e}\left( v\right) ^{t}\left( \left. \mathbf{e}%
\right\vert \mathbf{e}\right) _{\rho \sigma }\mathcal{R}_{e}\left( w\right) ,
\end{equation}%
where 
\begin{equation}
\left( \left. v\right\vert Tw\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
v\right) ^{t}\left( \left. \mathbf{e}\right\vert \mathbf{e}\right) _{\rho
\sigma }\mathcal{R}_{e}\left( T\right) \mathcal{R}_{e}\left( w\right) .
\end{equation}

\begin{proof}
\begin{equation}
\left( \left. Tv\right\vert w\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
Tv\right) ^{t}\left( \left. \mathbf{e}\right\vert \mathbf{e}\right) _{\rho
\sigma }\mathcal{R}_{e}\left( w\right) =\left( \overset{}{\mathcal{R}%
_{e}\left( v\right) \mathcal{R}_{e}\left( T\right) }\right) ^{t}\mathbb{S}%
_{\rho \sigma e}\mathcal{R}_{e}\left( w\right) =\mathcal{R}_{e}\left(
T\right) ^{t}\mathcal{R}_{e}\left( v\right) ^{t}\mathbb{S}_{\rho \sigma e}%
\mathcal{R}_{e}\left( w\right) .
\end{equation}%
and 
\begin{equation}
\left( \left. v\right\vert Tw\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
v\right) ^{t}\left( \left. \mathbf{e}\right\vert \mathbf{e}\right) _{\rho
\sigma }\mathcal{R}_{e}\left( Tw\right) =\mathcal{R}_{e}\left( v\right)
^{t}\left( \left. \mathbf{e}\right\vert \mathbf{e}\right) _{\rho \sigma }%
\mathcal{R}_{e}\left( T\right) \mathcal{R}_{e}\left( w\right) .\blacksquare
\end{equation}
\end{proof}
\end{theorem}

\subsubsection{\textbf{The Dualizing Maps }$d_{\protect\rho \protect\sigma }$
\textbf{\label{dualizing map}}}

\begin{definition}
The \textbf{dualizing maps }$d_{\rho \sigma }\in \mathcal{L}\left(
W^{d},W\right) $ 
\begin{equation}
d_{\rho \sigma }:W\rightarrow W^{d}
\end{equation}%
is defined by 
\begin{equation}
d_{\rho \sigma }\left( w\right) =\left( w\right\vert _{\rho \sigma
}\,\forall w\in W.
\end{equation}
\end{definition}

\begin{notation}
The \textbf{dual bases} $\left\{ \left( \boldsymbol{e}_{d\rho \sigma
}\right) ,\left( \boldsymbol{e}\right) \right\} $ of $W^{d}$ and $W$ is
given by in terms of the inner product $\left( \left. \boldsymbol{\cdot }%
\right\vert \boldsymbol{\cdot }\right) _{\rho \sigma }$ by 
\begin{equation*}
\left( \boldsymbol{e}_{d\rho \sigma }\right) =\left( \overset{}{d_{\rho
\sigma }\left( \boldsymbol{e}\right) }\right) =\left( \boldsymbol{e}%
\right\vert _{\rho \sigma }=\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) =\left( \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \right\vert _{\rho \sigma }=\left[ \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \right] _{\rho \sigma }\in \mathfrak{B}\left( W^{d}\right) ,
\end{equation*}%
note that they are defined as super column vectors.
\end{notation}

\begin{remark}
In general the basis $\left( \boldsymbol{e}_{d\rho \sigma }\right) \equiv
\left( d_{\rho \sigma }\left( \boldsymbol{e}\right) \right) $ is \textbf{not}
$\left( \left. \boldsymbol{\cdot }\right\vert \boldsymbol{\cdot }\right)
_{\rho \sigma }$-biorthogonal to $\left( \boldsymbol{e}\right) .$
\end{remark}

\begin{notation}
\begin{equation}
\left( \boldsymbol{e}_{d\rho \sigma }\right) ^{t}=\left( 
\begin{array}{ccc}
d_{\rho \sigma }\left( e_{1}\right) & \cdots & d_{\rho \sigma }\left(
e_{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{d\rho \sigma 1} & \cdots & e_{d\rho \sigma 2r}%
\end{array}%
\right) =\left( \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \right\vert _{\rho \sigma }.
\end{equation}
\end{notation}

\subsubsection{\textbf{The Biorthogonalizing Maps }$\mathfrak{b}_{\protect%
\rho \protect\sigma }$ \label{The Biorthogonalizing Map}}

The biorthogonalizing maps $\mathfrak{b}_{\rho \sigma }$ are defined by 
\begin{equation}
\mathfrak{b}_{\rho \sigma }:W\rightarrow W
\end{equation}

\begin{definition}
Using the inner product $\left( \left. \boldsymbol{\cdot }\right\vert 
\boldsymbol{\cdot }\right) _{\rho \sigma }$ the \textbf{biorthogonal basis} $%
\left( \mathfrak{b}\left( \boldsymbol{e}\right) _{\rho \sigma }\right) $ of $%
W$ to $\left( \boldsymbol{e}\right) $ is defined by 
\begin{equation*}
\left( \overset{}{\mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}\right) }%
\right) =\left( 
\begin{array}{c}
\mathfrak{b}_{\rho \sigma }\left( e_{1}\right) \\ 
\vdots \\ 
\mathfrak{b}_{\rho \sigma }\left( e_{2r}\right)%
\end{array}%
\right) =\mathbb{S}_{\rho \sigma e}^{-t}\left( \mathbf{e}\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \in \mathfrak{B}\left( W\right) .
\end{equation*}
\end{definition}

\begin{remark}
Hence the row vector form of biorthogonalization is 
\begin{equation}
\left( \overset{}{\mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}\right) }%
\right) ^{t}=\left( 
\begin{array}{ccc}
\mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}\right) _{1} & \cdots & 
\mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}\right) _{2r}%
\end{array}%
\right) =\left( \mathbb{S}_{\rho \sigma e}^{-t}\left( \mathbf{e}\right)
\right) ^{t}=\left( \mathbf{e}\right) ^{t}\mathbb{S}_{\rho \sigma
e}^{-1}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-1}\in \mathfrak{B}\left( W\right) .
\end{equation}
\end{remark}

\begin{definition}
The \textbf{biorthogonalizing maps \label{biorthogonalizing map} }$\mathfrak{%
b}_{\rho \sigma }\in \mathcal{L}\left( W\right) $ 
\begin{equation}
\mathfrak{b}_{\rho \sigma }:W\rightarrow W
\end{equation}%
are defined by 
\begin{equation}
\mathfrak{b}_{\rho \sigma }\left( w\right) =S_{\rho \sigma e}^{-1}\left\vert
w\right) _{\rho \sigma }\,=w\,\forall w\in W.
\end{equation}
\end{definition}

\begin{theorem}
The basis $\left( \mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}\right)
\right) \in \mathfrak{B}\left( W\right) $ are $\left( \left. {}\right\vert
\right) _{\rho \sigma }$-biorthogonal to $\left( \boldsymbol{e}\right) ,$

\begin{proof}
\begin{gather}
\mathbb{I}_{2r}=\left( \left. \overset{}{\left( \overset{}{\mathfrak{b}%
_{\rho \sigma }\left( \boldsymbol{e}\right) }\right) ^{t}}\right\vert \left( 
\boldsymbol{e}\right) ^{t}\right) _{\rho \sigma }=\left( \left. \overset{}{%
\left( \overset{}{\mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}\right) }%
\right) ^{t}}\right\vert \left( \boldsymbol{e}\right) ^{t}\right) _{\rho
\sigma }=\left( \left. \overset{}{\left( \boldsymbol{e}\right) ^{t}\left( 
\mathbb{S}_{\rho \sigma e}\right) ^{-t}}\right\vert \left( \boldsymbol{e}%
\right) ^{t}\right) _{\rho \sigma }=\mathbb{S}_{\rho \sigma e}^{-1}\left(
\left. \overset{}{\left( \boldsymbol{e}\right) ^{t}}\right\vert \left( 
\boldsymbol{e}\right) ^{t}\right) _{\rho \sigma }=\left( \left. \overset{}{%
\left( \boldsymbol{e}\right) ^{t}}\right\vert \left( \boldsymbol{e}\right)
^{t}\right) _{\rho \sigma }^{-1}\left( \left. \overset{}{\left( \boldsymbol{e%
}\right) ^{t}}\right\vert \left( \boldsymbol{e}\right) ^{t}\right) _{\rho
\sigma } \\
\parallel \\
\left( \left. \left( \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \right) ^{t}\right\vert \left( \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \right) ^{t}\right) _{\rho \sigma }=\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-1}\left( \left. \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) ^{t}\right\vert \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) ^{t}\right) _{\rho \sigma } \\
\parallel \\
\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-1}\left( \left. \overset{\overset{}{\overset{}{}}}{\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) }\right\vert \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) ^{t}\right) _{\rho \sigma }=\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) .
\end{gather}
\end{proof}
\end{theorem}

\begin{remark}
\begin{equation}
I_{2r}=\left( \overset{}{\mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}%
\right) }\right) ^{t}\left( \boldsymbol{e}\right) ==\left( 
\begin{array}{ccc}
\mathfrak{b}_{\rho \sigma }\left( e_{1}\right) & \cdots & \mathfrak{b}_{\rho
\sigma }\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right)
\end{equation}
\end{remark}

\subsubsection{\textbf{The Dual Biorthogonalizing Map }$b_{\protect\rho 
\protect\sigma }$ \label{The Dual Biorthogonalizing Map}}

The dual biorthogonalizing map $b_{\rho \sigma }$ is defined by 
\begin{equation}
b_{\rho \sigma }:W\rightarrow W^{d}
\end{equation}

\begin{definition}
The dual biorthogonal maps $b_{\rho \sigma }\in \mathcal{L}\left(
W,W^{d}\right) $ are defined by 
\begin{equation}
b_{\rho \sigma }\left( e_{j}\right) =\left( e_{j}\right\vert _{\rho \sigma
},\quad 1\leq j\leq 2r,
\end{equation}%
where $\left( \mathbf{e}\right) $ is any basis of $W.$
\end{definition}

\begin{definition}
The \emph{biorthogonal dual basis} $\left( \boldsymbol{e}_{b\rho \sigma
}\right) \in \mathfrak{B}\left( W^{d}\right) $ wrt $\left( \left. 
\boldsymbol{\cdot }\right\vert \boldsymbol{\cdot }\right) _{\rho \sigma }$
is defined in column vector form by%
\begin{equation}
b_{\rho \sigma }\left( \boldsymbol{e}\right) =\left( \boldsymbol{e}_{b\rho
\sigma }\right) =\left( \mathfrak{b}_{\rho \sigma }\left( \boldsymbol{e}%
\right) \right\vert =\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}%
\right) _{\rho \sigma }^{-1}\left( \boldsymbol{e}\right\vert _{\rho \sigma
}=\left( 
\begin{array}{c}
b_{\rho \sigma }\left( e\right) _{1} \\ 
\vdots \\ 
b_{\rho \sigma }\left( e\right) _{2r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \mathfrak{b}_{\rho \sigma }\left( e\right) _{1}\right\vert \\ 
\vdots \\ 
\left( \mathfrak{b}_{\rho \sigma }\left( e\right) _{2r}\right\vert%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \in \mathfrak{B}\left( W^{d}\right) .
\end{equation}
\end{definition}

\begin{remark}
The bases $\left( \boldsymbol{e}_{b}\right) $ and $\left( \boldsymbol{e}%
\right) $ are $\left( \left. \boldsymbol{\cdot }\right\vert \boldsymbol{%
\cdot }\right) _{\rho \sigma }$-biorthogonal as they satisfy the
biorthogonality conditions

\begin{enumerate}
\item The identity matrix 
\begin{equation}
\mathbb{I}_{2r}=\left( \left. \overset{}{\mathfrak{b}\left( \left( 
\boldsymbol{e}\right) ^{t}\right) }\right\vert \left( \boldsymbol{e}\right)
^{t}\right) _{\rho \sigma }=\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho \sigma }^{-1}\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho \sigma }
\end{equation}%
remember 
\begin{equation}
\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho \sigma
}\equiv \left( \left. \left( \boldsymbol{e}\right) ^{i}\right\vert \left( 
\boldsymbol{e}\right) ^{i}\right) _{\rho \sigma }
\end{equation}%
and

\item the identity operator 
\begin{equation*}
I_{2r}=\left\vert \boldsymbol{e}\right) _{\rho \sigma }\left( \mathfrak{b}%
_{\rho \sigma }\left( \boldsymbol{e}\right) \right\vert =\left\vert 
\boldsymbol{e}\right) _{\rho \sigma }\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho \sigma }^{-1}\left( \boldsymbol{e}\right\vert
_{\rho \sigma }=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) .
\end{equation*}
\end{enumerate}
\end{remark}

\begin{remark}
The transpose $\left( \boldsymbol{e}_{b}\right) ^{t}$ of the dual $\left( 
\boldsymbol{e}_{b}\right) $ basis super vector is 
\begin{gather}
\left( \boldsymbol{e}_{b}\right) ^{t}=\left( \overset{}{\left( b\left( 
\boldsymbol{e}\right) \right\vert }_{\rho \sigma }\right) ^{t}=\left( 
\overset{}{\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right)
_{\rho \sigma }^{-1}\left( \boldsymbol{e}\right\vert }_{\rho \sigma }\right)
^{t}=\left( 
\begin{array}{ccc}
\left( b_{\rho \sigma }\left( e\right) _{1}\right\vert & \cdots & \left(
b_{\rho \sigma }\left( e\right) _{2r}\right\vert%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
d_{\rho \sigma }\left( e\right) _{1} & \cdots & d_{\rho \sigma }\left(
e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-t}=\left( 
\begin{array}{ccc}
\left( e_{1}\right\vert _{\rho \sigma } & \cdots & \left( e_{2r}\right\vert
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-t}\in \mathfrak{B}\left( W^{d}\right) .
\end{gather}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{R}_{e}\left( S_{\rho \sigma e}\right) =\mathcal{R}_{e}\left(
\sum_{1\leq j\leq 2r}e_{j}\left[ d\left( e\right) _{j}\right] \right)
=\left( \boldsymbol{e}_{b}\right\vert \left( \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \right] \right) \left\vert \boldsymbol{e}\right) =\left( \left. 
\boldsymbol{e}\right\vert \boldsymbol{e}\right) =\mathbb{S}_{e}.
\end{equation}
\end{remark}

\begin{notation}
In the following we drop the explicit denotion of the dependence of the
inner product on the super dual vectors $\mathbf{\rho }_{d}$ and $\mathbf{%
\sigma }_{d}$ and allow it to be implicitly implied.
\end{notation}

Using the bilinear form $\left( \left. {}\right\vert \right) $ one obtains
the following expansions for an operator $A\in \mathcal{L}\left( W\right) $

\begin{enumerate}
\item 
\begin{eqnarray}
A &=&\left\vert \boldsymbol{x}\right) \left( \boldsymbol{y}\right\vert
=\sum_{1\leq j\leq 2r}\left\vert x_{j}\right) \left( y_{j}\right\vert
=\left( 
\begin{array}{ccc}
\left\vert x_{1}\right) & \cdots & \left\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( y_{1}\right\vert \\ 
\vdots \\ 
\left( y_{2r}\right\vert%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) &=&\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
\left\vert x_{1}\right) & \cdots & \left\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( y_{1}\right\vert \\ 
\vdots \\ 
\left( y_{2r}\right\vert%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert x_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right)
\end{eqnarray}%
and the transpose $A^{t}$

\item 
\begin{eqnarray}
A^{t} &=&\left\vert \boldsymbol{y}\right) \left( \boldsymbol{x}\right\vert
=\sum_{1\leq j\leq 2r}\left\vert y_{j}\right) \left( x_{j}\right\vert
=\left( 
\begin{array}{ccc}
\left\vert y_{1}\right) & \cdots & \left\vert y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( x_{1}\right\vert \\ 
\vdots \\ 
\left( x_{2r}\right\vert%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A^{t}\right) &=&\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
\left\vert y_{1}\right) & \cdots & \left\vert y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( x_{1}\right\vert \\ 
\vdots \\ 
\left( x_{2r}\right\vert%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert x_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right)
\end{eqnarray}

\item The representations are 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}

\begin{eqnarray}
\mathcal{R}_{e}\left( A^{t}\right) &=&\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) ,
\end{eqnarray}%
which can be recast as

\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right)
\end{equation}%
\begin{eqnarray}
\mathcal{R}_{e}\left( A^{t}\right) &=&\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert y_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert y_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. x_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
x_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. x_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
x_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert x_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) ,
\end{eqnarray}

\item \textbf{If the inner product is symmetric} then \textbf{\ }%
\begin{equation}
\mathbb{S}_{ee}=\mathbb{S}_{ee}^{t}
\end{equation}%
and \textbf{\ }%
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\mathcal{R}_{e}\left( A\right) ^{t}.
\end{equation}

\item \textbf{If the inner product is antisymmetric }then%
\begin{equation}
\mathbb{S}_{ee}=-\mathbb{S}_{ee}^{t}.
\end{equation}%
\textbf{\ }
\end{enumerate}

\subsection{Symmetric and Antisymmetric Inner Products in the Real Even
Dimensional Space $W$}

\subsubsection{\textbf{Symmetric Inner Products}}

\begin{theorem}
Any non degenerate symmetric inner product $s_{d}$ can be expanded as 
\begin{equation*}
s_{d}=\sum_{1\leq j,k\leq 2r}e_{bj}\otimes e_{bk}\mathcal{R}_{e_{b}}\left(
s_{d}\right) _{jk}=\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right)
_{j}b\left( u\right) _{j}\otimes b\left( u\right) _{j}=\sum_{1\leq j\leq
2r}\sigma \left( s_{d}\right) _{j}\left( u_{j}\right\vert \otimes \left(
u_{j}\right\vert ,
\end{equation*}%
where 
\begin{equation}
\mathcal{R}_{e_{b}}\left( s_{d}\right) _{jk}=\mathcal{R}_{e_{b}}\left(
s_{d}\right) _{kj},\quad 1\leq j,k\leq 2r,
\end{equation}%
i,e, 
\begin{equation}
\mathcal{R}_{e_{b}}\left( s_{d}\right) ^{t}=\mathcal{R}_{e_{b}}\left(
s_{d}\right)
\end{equation}%
and 
\begin{equation}
\sigma \left( s_{d}\right) _{j}\neq 0\in \mathbb{R},\quad 1\leq j\leq 2r.
\end{equation}

\begin{proof}
This can be deduced as $\mathcal{R}_{e_{b}}\left( s_{d}\right) $ is a real
symmetric which can be transformed to a diagonal matrix $\mathbb{\mathcal{R}}%
_{\sigma \left( s_{d}\right) }\left( s_{d}\right) $ 
\begin{equation}
\mathbb{U}^{t}\mathcal{R}_{e_{b}}\left( s_{d}\right) \mathbb{U}\,\,\mathbb{=%
\mathcal{R}}_{\sigma \left( s_{d}\right) }\left( s_{d}\right) =\left( 
\begin{array}{cccc}
\mathbb{\mathcal{R}}_{\sigma \left( s_{d}\right) }\left( s_{d}\right) _{11}
& \cdots & 0 & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & \mathbb{\mathcal{R}}_{\sigma \left( s_{d}\right) }\left(
s_{d}\right) _{2r2r}%
\end{array}%
\right) .
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
s_{d}\left( v,w\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right)
_{j}b\left( u\right) _{j}\otimes b\left( u\right) _{j}\left( v\otimes
w\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}b\left(
u\right) _{j}\left( v\right) \otimes b\left( u\right) _{j}\left( w\right)
=\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}\left( \left.
u_{j}\right\vert v\right) \left( \left. u_{j}\right\vert w\right)
\end{equation}

\item 
\begin{equation}
s_{d}\left( w,v\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right)
_{j}b\left( u\right) _{j}\otimes b\left( u\right) _{j}\left( w\otimes
v\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}b\left(
u\right) _{j}\left( w\right) \otimes b\left( u\right) _{j}\left( v\right)
=\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}\left( \left.
u_{j}\right\vert w\right) \left( \left. u_{j}\right\vert v\right) ,
\end{equation}%
which confirms $\left( \left. {}\right\vert \right) $ is symmetric i.e.%
\begin{equation}
s_{d}\left( v,w\right) =s_{d}\left( w,v\right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{definition}
\begin{enumerate}
\item If the inner product $s_{d}$ has the property 
\begin{equation}
\sigma \left( s_{d}\right) _{j}>0\in \mathbb{R},\quad 1\leq j\leq 2r
\end{equation}%
then it is \emph{positive definite.}

\item If the inner product $s_{d}$ has the property 
\begin{equation}
\sigma \left( s_{d}\right) _{j}\geq 0\text{ and }\sigma \left( s_{d}\right)
_{j}=0\in \mathbb{R},\quad \text{for some }1\leq j\leq 2r
\end{equation}%
then it is \emph{positive semi definite.}
\end{enumerate}
\end{definition}

\begin{lemma}
If a symmetric inner product $s_{d}$ is positive semi definite then it is
degenerate.
\end{lemma}

\subsubsection{\textbf{Antisymmetric Inner Products}}

\begin{theorem}
Any non degenerate antisymmetric inner product $a_{d}$ can be expanded as%
\begin{gather*}
a_{d}=\sum_{1\leq j,k\leq 2r}e_{bj}\otimes e_{bk}\mathcal{R}_{e_{b}}\left(
a_{d}\right) _{jk}=\sum_{1\leq j\leq r}\sigma \left( a_{d}\right)
_{j}b\left( v\right) _{j}\wedge b\left( v\right) _{j+r} \\
=\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}%
\left\{ b\left( v\right) _{j}\otimes b\left( v\right) _{j+r}-b\left(
v\right) _{j+r}\otimes b\left( v\right) _{j}\right\} =\sum_{1\leq j\leq
r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}\left\{ \left(
v_{j}\right\vert \otimes \left( v_{j+r}\right\vert -\left(
v_{j+r}\right\vert \otimes \left( v_{j}\right\vert \right\} ,
\end{gather*}%
where 
\begin{equation}
\mathcal{R}_{e_{b}}\left( a_{d}\right) _{jk}=-\mathcal{R}_{e_{b}}\left(
a_{d}\right) _{kj};\quad 1\leq j,k\leq 2r
\end{equation}%
and 
\begin{equation}
\sigma \left( a_{d}\right) _{j}>0\in \mathbb{R},\quad 1\leq j\leq r.
\end{equation}
\end{theorem}

\begin{proof}
This can be deduced as $\mathcal{R}_{e_{b}}\left( a_{d}\right) $ is an even
dimensional real antisymmetric matrix which can be transformed to a
canonical antisymmetric matrix $\mathbb{\mathcal{R}}_{\sigma \left(
a_{d}\right) }\left( a_{d}\right) $ 
\begin{equation}
\mathbb{V}^{t}\mathcal{R}_{e_{b}}\left( a_{d}\right) \mathbb{V}\,\,\mathbb{=%
\mathcal{R}}_{\sigma \left( a_{d}\right) }\left( a_{d}\right) =\left( 
\begin{array}{cc}
\mathbb{O} & \left( 
\begin{array}{cccc}
\mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left( a_{d}\right) _{11}
& 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & \mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left(
a_{d}\right) _{rr}%
\end{array}%
\right) \\ 
\left( 
\begin{array}{cccc}
-\mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left( a_{d}\right) _{11}
& 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & -\mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left(
a_{d}\right) _{rr}%
\end{array}%
\right) & \mathbb{O}%
\end{array}%
\right)
\end{equation}
\end{proof}

\begin{remark}
These dual bilinear forms define inner products in $W.$
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{eqnarray}
a_{d}\left( v,w\right) &=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}%
\frac{1}{\sqrt{2}}\left\{ b\left( u\right) _{j}\otimes b\left( u\right)
_{j+r}-b\left( u\right) _{j+r}\otimes b\left( u\right) _{j}\right\} \left(
v\otimes w\right) \\
&=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}%
\left\{ b\left( u\right) _{j}\left( v\right) b\left( u\right) _{j+r}\left(
w\right) -b\left( u\right) _{j+r}\left( w\right) b\left( u\right) _{j}\left(
v\right) \right\} =\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1%
}{\sqrt{2}}\left\{ \left( \left. u_{j}\right\vert v\right) \left( \left.
u_{j+r}\right\vert w\right) -\left( \left. u_{j+r}\right\vert v\right)
\left( \left. u_{j}\right\vert w\right) \right\}
\end{eqnarray}

\item 
\begin{eqnarray}
a_{d}\left( w,v\right) &=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}%
\frac{1}{\sqrt{2}}\left\{ b\left( u\right) _{j}\otimes b\left( u\right)
_{j+r}-b\left( u\right) _{j+r}\otimes b\left( u\right) _{j}\right\} \left(
w\otimes v\right) \\
&=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}%
\left\{ b\left( u\right) _{j}\left( w\right) b\left( u\right) _{j+r}\left(
v\right) -b\left( u\right) _{j+r}\left( v\right) b\left( u\right) _{j}\left(
w\right) \right\} =\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1%
}{\sqrt{2}}\left\{ \left( \left. u_{j}\right\vert w\right) \left( \left.
u_{j+r}\right\vert v\right) -\left( \left. u_{j+r}\right\vert w\right)
\left( \left. u_{j}\right\vert v\right) \right\}
\end{eqnarray}%
which confirms $\left( \left. {}\right\vert \right) $ is antisymmetric i.e.%
\begin{equation}
a_{d}\left( v,w\right) =-a_{d}\left( w,v\right) .
\end{equation}
\end{enumerate}
\end{remark}

\subsubsection{\textbf{More on Inner products in} $W$}

\begin{definition}
Symmetric Inner Products 
\begin{equation}
\left( \left. v\right\vert w\right) _{s}=s_{d}\left( v\otimes w\right)
=s_{d}\left( v,w\right)
\end{equation}
\end{definition}

\begin{definition}
Antisymmetric Inner Products 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{a}=a_{d}\left( v\otimes w\right)
=a_{d}\left( v,w\right)
\end{equation}
\end{definition}

\begin{definition}
Positive Definite Inner Products 
\begin{equation}
\left( \left. v\right\vert v\right) _{p}=s_{d}\left( v\otimes v\right)
=s_{d}\left( v,v\right) >0\,\forall v\in W
\end{equation}
\end{definition}

\begin{theorem}
\begin{equation}
\left( \left. v\right\vert v\right) _{p}>0\,\forall v\in W\Rightarrow \left(
\left. v\right\vert w\right) _{p}\neq 0\,\forall ,w\in W,v\in W.
\end{equation}
\end{theorem}

\begin{theorem}
Any inner product can be expressed as a sum of a symmetric and antisymmetric
inner products i.e. 
\begin{equation}
\left( \left. {}\right\vert \right) =\left( \left. {}\right\vert \right)
_{s}+\left( \left. {}\right\vert \right) _{a}.
\end{equation}
\end{theorem}

\begin{theorem}
An inner product $\left( \left. {}\right\vert \right) $ can have \textbf{no}
symmetry but still be positive.

\begin{proof}
Any second rank tensor can be expressed as a unique sum of a symmetric and
an antisymmetric tensor. thus 
\begin{equation}
\left( \left. {}\right\vert \right) =\left( \left. {}\right\vert \right)
_{s}+\left( \left. {}\right\vert \right) _{a}.
\end{equation}%
and observe that 
\begin{equation}
\left( \left. v\right\vert v\right) =\left( \left. v\right\vert v\right)
_{s}+\left( \left. v\right\vert v\right) _{a}=\left( \left. v\right\vert
v\right) _{s}\geq 0.
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{v} & \mathbf{v}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O}_{r} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{v} \\ 
\mathbf{v}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-\mathbf{v} & \mathbf{v}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{v} \\ 
\mathbf{v}%
\end{array}%
\right) =0
\end{equation}
\end{remark}

\begin{example}
The symmetric and antisymmetric parts of the matrix $\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) $ are 
\begin{eqnarray}
\frac{1}{2}\left( \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) +\left( 
\begin{array}{cc}
1 & 0 \\ 
2 & 1%
\end{array}%
\right) \right) &=&\left( 
\begin{array}{cc}
1 & 1 \\ 
1 & 1%
\end{array}%
\right) \\
\frac{1}{2}\left( \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) -\left( 
\begin{array}{cc}
1 & 0 \\ 
2 & 1%
\end{array}%
\right) \right) &=&\left( 
\begin{array}{cc}
0 & 1 \\ 
-1 & 0%
\end{array}%
\right) .
\end{eqnarray}
\end{example}

\begin{example}
Consider the matrix 
\begin{equation}
\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right)
\end{equation}%
generated by the symmetric and antisymmetric parts 
\begin{equation}
\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) =\left( 
\begin{array}{cc}
1 & 1 \\ 
1 & 1%
\end{array}%
\right) +\left( 
\begin{array}{cc}
0 & 1 \\ 
-1 & 0%
\end{array}%
\right) .
\end{equation}%
as%
\begin{equation}
\left( 
\begin{array}{cc}
v_{1} & v_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
1 & 1 \\ 
1 & 1%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
v_{1}+v_{2} & v_{1}+v_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( v_{1}+v_{2}\right) ^{2}.
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{cc}
v_{1} & v_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
0 & 2 \\ 
-2 & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-2v_{2} & 2v_{1}%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =0
\end{equation}%
hence 
\begin{equation}
\left( 
\begin{array}{cc}
v_{1} & v_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( v_{1}+v_{2}\right) ^{2}.
\end{equation}%
{}
\end{example}

\begin{remark}
~For a \emph{real symmetric} $n\times n$ matrix $A$, the following are
equivalent:

\begin{enumerate}
\item $A$ is positive semidefinite:%
\begin{equation}
x^{t}Ax\geq 0\,\forall x\in \mathbb{R}^{n}
\end{equation}

\item All eigenvalues of $A$ are $\geq 0$.

\item All principal minors $\left( \text{minors that have euqual number of
rows and columns formed from rows and columns anywhere in the matrix}\right) 
$ of $A$ are $\geq 0$.
\end{enumerate}
\end{remark}

\begin{remark}
Sylvester's criterion does not apply to non-symmetric matrices. The
criterion requires a matrix to be symmetric (or Hermitian) to determine if
it is positive definite by checking that all of its leading principal minors
are positive. For a non-symmetric matrix, the condition for positive
definiteness is equivalent to its symmetric part 
\begin{equation}
A+A^{t}
\end{equation}
being positive definite, and this symmetric part can then be tested with
Sylvester's criterion.~
\end{remark}

\begin{theorem}
If $A$ is a real non symmetric matrix then $A$ is positive semidefinite $%
\limfunc{Iff}$ all the principal minors of the symmetric part of the $A$ are
positive.
\end{theorem}

\begin{theorem}
If $A$ is a real symmetric matrix then $A$ is positive semidefinite $%
\limfunc{Iff}$ the \textbf{leading }principal minors of $A$ are positive.
\end{theorem}

\subsection{Imaginary Units}

\begin{definition}
An imaginary $\equiv $ Complex unit $J\in \mathcal{L}\left( W\right) $ is
defined by the two conditions

\begin{enumerate}
\item 
\begin{equation}
J=-J^{t}
\end{equation}%
and

\item 
\begin{equation}
J^{2}=-I_{W}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{theorem}
Any antisymmetric bilinear form $J_{d}\in W^{d}\otimes W^{d},$ (thus belongs
to $W^{d}\wedge W^{d}),$ defines a complex unit $J\in \mathcal{L}\left(
W\right) $ by the mapping 
\begin{equation}
\Xi :W^{d}\otimes W^{d}\rightarrow W\otimes W^{d}\rightarrow \mathcal{L}%
\left( W\right) .
\end{equation}
\end{theorem}

\begin{remark}
Recall the resolutions of the identity 
\begin{gather}
I_{W}=\sum_{1\leq j\leq 2r}x_{j}\left[ x_{bj}\right] =\sum_{1\leq j\leq
2r}y_{j}\left[ y_{bj}\right] \\
\parallel \\
\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \\
\parallel \\
\left( \boldsymbol{x}\right) ^{t}\left( \left[ \boldsymbol{x}_{b}\right]
\right) =\left( \boldsymbol{y}\right) ^{t}\left( \left[ \boldsymbol{y}_{b}%
\right] \right) ,
\end{gather}%
where $\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\} $ and $\left\{
\left. y_{j}\right\vert 1\leq j\leq 2r\right\} $ are linearly independent
set of vectors belonging to $V$ and $\left\{ \left. x_{bj}\right\vert 1\leq
j\leq 2r\right\} $ and $\left\{ \left. y_{bj}\right\vert 1\leq j\leq
2r\right\} $ are linearly independent set of vectors belonging to $V^{d}$
biorthogonal to $\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\} $
and $\left\{ \left. y_{j}\right\vert 1\leq j\leq 2r\right\} .$
\end{remark}

\subsubsection{\textbf{Change of} \textbf{Representations}}

\begin{enumerate}
\item The change of basis $\left( \boldsymbol{x}\right) \rightarrow \left( 
\boldsymbol{y}\right) $ operator $S_{yx}$ is given by%
\begin{equation}
S_{yx}=\left( \boldsymbol{y}\right) ^{t}\left( \left[ \boldsymbol{x}_{b}%
\right] \right) ,
\end{equation}%
which has a matrix representation $\mathcal{R}_{x}\left( S_{yx}\right) $ wrt
the $\left( \boldsymbol{x}\right) $ basis given by 
\begin{equation}
\mathcal{R}_{x}\left( S_{yx}\right) =\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{y}\right) ^{t}\left( %
\left[ \boldsymbol{x}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( y_{1}\right) & \cdots & x_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( y_{1}\right) & \cdots & x_{b2r}\left( y_{2e}\right)%
\end{array}%
\right) .
\end{equation}

\item The change of basis $\left( \boldsymbol{y}\right) \rightarrow \left( 
\boldsymbol{x}\right) $ operator $S_{xy}$ is given by%
\begin{equation}
S_{xy}=\left( \boldsymbol{x}\right) ^{t}\left( \left[ \boldsymbol{y}_{b}%
\right] \right) ,
\end{equation}%
which has a matrix representation $\mathcal{R}_{y}\left( S_{xy}\right) $ wrt
the $\left( \boldsymbol{y}\right) $ basis given by 
\begin{equation}
\mathcal{R}_{y}\left( S_{xy}\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{x}\right) ^{t}\left( %
\left[ \boldsymbol{y}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
y_{b1}\left( x_{1}\right) & \cdots & y_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( x_{1}\right) & \cdots & y_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) .
\end{equation}

\item Note that 
\begin{eqnarray}
\mathcal{R}_{x}\left( S_{yx}\right) &=&\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{y}\right) ^{t}\left( %
\left[ \boldsymbol{x}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( y_{1}\right) & \cdots & x_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( y_{1}\right) & \cdots & x_{b2r}\left( y_{2e}\right)%
\end{array}%
\right) \\
\mathcal{R}_{y}\left( S_{yx}\right) &=&\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{y}\right) ^{t}\left( %
\left[ \boldsymbol{x}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( y_{1}\right) & \cdots & x_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( y_{1}\right) & \cdots & x_{b2r}\left( y_{2e}\right)%
\end{array}%
\right)
\end{eqnarray}

i.e. the representations wrt the \emph{two bases are the same}. 
\begin{equation}
\mathcal{R}_{x}\left( S_{yx}\right) =\mathcal{R}_{y}\left( S_{yx}\right) .
\end{equation}

\item The transformations $S_{xy}$ and $S_{yx}$ are inverses of each other
i.e. 
\begin{equation}
S_{yx}^{-1}=S_{xy}
\end{equation}

\item Recall 
\begin{equation}
S_{yx}\left( \boldsymbol{x}\right) ^{t}=\left( \boldsymbol{x}\right) ^{t}%
\mathcal{R}_{x}\left( S_{yx}\right)
\end{equation}%
and 
\begin{equation}
S_{xy}\left( \boldsymbol{y}\right) ^{t}=\left( \boldsymbol{y}\right) ^{t}%
\mathcal{R}_{y}\left( S_{xy}\right) .
\end{equation}
\end{enumerate}

\subsection{\textbf{Properties of Complex Units}}

\subsubsection{Negative Involutions Does \textbf{NOT} Imply Antisymmetry 
\label{Negative Involutions Does NOT Imply Antisymmetry}}

\begin{example}
\begin{enumerate}
\item Let us examine the $2\times 2$ case. Consider: 
\begin{equation*}
\mathbb{B}=%
\begin{pmatrix}
1 & 2 \\ 
-1 & -1%
\end{pmatrix}%
.
\end{equation*}

\item Verification that $\mathbb{B}^{2}=-\mathbb{I}$ 
\begin{equation*}
\mathbb{B}^{2}=%
\begin{pmatrix}
1 & 2 \\ 
-1 & -1%
\end{pmatrix}%
\begin{pmatrix}
1 & 2 \\ 
-1 & -1%
\end{pmatrix}%
=%
\begin{pmatrix}
1-2 & 2-2 \\ 
-1+1 & -2+1%
\end{pmatrix}%
=%
\begin{pmatrix}
-1 & 0 \\ 
0 & -1%
\end{pmatrix}%
=-I_{2}.
\end{equation*}

\item Check for Anti-symmetry

\begin{enumerate}
\item The transpose is: 
\begin{equation*}
\mathbb{B}^{t}=%
\begin{pmatrix}
1 & -1 \\ 
2 & -1%
\end{pmatrix}%
.
\end{equation*}

\item Compare with $-\mathbb{B}$: 
\begin{equation*}
-\mathbb{B}=%
\begin{pmatrix}
-1 & -2 \\ 
1 & 1%
\end{pmatrix}%
.
\end{equation*}

\item Clearly 
\begin{equation}
\mathbb{B}^{t}\neq -\mathbb{B},
\end{equation}%
so $\mathbb{B}$ is not anti-symmetric.
\end{enumerate}
\end{enumerate}
\end{example}

\begin{remark}
By Greubs theorem the operator $J$ can be expressed in Dyadic and SVD form
as 
\begin{gather}
J=\left( \boldsymbol{x}\right) ^{t}\left[ \left( \boldsymbol{y}_{b}\right) %
\right] =\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( \boldsymbol{u%
}_{x}\right) ^{t}\mathcal{R}_{e}\left( \lambda _{xy}\right) \left[ \left( 
\boldsymbol{v}_{yb}\right) \right] =\sum_{1\leq j\leq 2r}u_{j}\mathcal{R}%
_{e}\left( \lambda _{xy}\right) _{j}\left[ v_{bj}\right] =\Xi
_{VV^{d}}\left( b_{\rho \sigma }\right) =U\lambda V=\left( \boldsymbol{e}%
\right) ^{t}\left( \overset{}{\mathcal{R}_{e}\left( U_{x}\right) \mathcal{R}%
_{e}\left( \lambda _{xy}\right) \mathcal{R}_{e}\left( V_{y}\right) }\right) %
\left[ \left( \boldsymbol{e}_{b}\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
u_{x1} & \cdots & u_{x2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( \lambda _{xy}\right) _{11} & \cdots & \mathbb{O} \\ 
\vdots & \ddots & \vdots \\ 
\mathbb{O} & \cdots & \mathcal{R}_{e}\left( \lambda _{xy}\right) _{2r2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
v_{yb1} \\ 
\vdots \\ 
v_{yb2r}%
\end{array}%
\right) \right] ,
\end{gather}%
where 
\begin{equation}
\left( 
\begin{array}{ccc}
u_{x1} & \cdots & u_{x2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( U_{x}\right) _{11} & \cdots & \mathcal{R}_{e}\left(
U_{x}\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( U_{x}\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
U_{x}\right) _{2r2r}%
\end{array}%
\right)
\end{equation}%
and%
\begin{equation}
\left( 
\begin{array}{c}
v_{yb1} \\ 
\vdots \\ 
v_{yb2r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( V_{y}\right) _{11} & \cdots & \mathcal{R}_{e}\left(
V_{y}\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( V_{y}\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
V_{y}\right) _{2r2r}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{enumerate}
\item The representations $\mathcal{R}_{y}\left( J\right) $ and $\mathcal{R}%
_{x}\left( J\right) $ of $J$ wrt the $\left( \boldsymbol{x}\right) $ and $%
\left( \boldsymbol{y}\right) $ bases are equal 
\begin{eqnarray}
\mathcal{R}_{y}\left( J\right) &=&\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] J\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \\
\mathcal{R}_{x}\left( J\right) &=&\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] J\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) .
\end{eqnarray}%
This produces

\item the square $\mathcal{R}_{x}\left( J\right) ^{2}$ of the representation 
$\mathcal{R}_{x}\left( J\right) $ 
\begin{equation}
\mathcal{R}_{x}\left( J\right) ^{2}=\mathcal{R}_{y}\left( J\right) ^{2}=%
\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\textbf{The operator form of this FALSE theorem is }

\begin{theorem}
If $J\in \mathcal{L}\left( W\right) $ and 
\begin{equation}
J^{2}=-I_{W}
\end{equation}%
then 
\begin{equation}
J^{t}=-J.
\end{equation}
\end{theorem}

\begin{enumerate}
\item 
\begin{gather}
J^{2} \\
\parallel \\
\sum_{1\leq j,k\leq 2r}\left( \overset{}{x_{j}\left[ y_{bj}\right] }\right)
\left( \overset{}{x_{k}\left[ y_{bk}\right] }\right) =\sum_{1\leq j,k\leq
2r}x_{j}\left( \overset{}{y_{bj}\left( x_{k}\right) }\right) \left[ y_{bk}%
\right] =-I_{W} \\
\parallel \\
\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( x_{1}\right) & \cdots & y_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( x_{1}\right) & \cdots & y_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \\
\parallel \\
-\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] =-\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] =-I_{W}
\end{gather}%
showing that

\item 
\begin{gather}
\left( \overset{}{\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) }\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] =-I_{W} \\
\Downarrow \\
\left( \overset{}{\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) }\right) =-\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right)
\end{gather}

\item Recall 
\begin{equation}
J=\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right]
\end{equation}%
producing the transpose $J^{t}$ 
\begin{gather}
J^{t}=\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \\
\parallel \\
-\left( \overset{}{\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) }\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \\
\parallel \\
-\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right]
\end{gather}%
showing that $J$ is antisymmetric i.e. 
\begin{equation}
J^{t}=-J.\blacksquare
\end{equation}
\end{enumerate}

\subsubsection{Correspondence between Antisymmetric Tensors and
Antisymmetric Operators}

Recall that the map $\Xi _{WW^{d}}$ 
\begin{equation}
\Xi _{WW^{d}}:W\otimes W^{d}\rightarrow \mathcal{L}\left( W\right)
\end{equation}%
is given by 
\begin{equation}
\Xi _{WW^{d}}\left( b_{xy_{b}}\right) =\sum_{1\leq j\leq 2r}x_{j}\left[
y_{bj}\right] .
\end{equation}

\begin{lemma}
If a tensor $g\in W\otimes W^{d}$ is antisymmetric i.e. 
\begin{equation}
\left( \sum_{1\leq j\leq 2r}v_{j}\otimes w_{bj}\right) ^{t}=\sum_{1\leq
j\leq 2r}w_{j}\otimes v_{bj}=-\sum_{1\leq j\leq 2r}v_{j}\otimes w_{bj}
\end{equation}%
then it can be expressed in cannonical form as 
\begin{equation}
g=\sum_{1\leq j\leq r}\left( \overset{}{x_{j}\otimes x_{bj+r}-x_{j+r}\otimes
x_{bj}}\right) .
\end{equation}
\end{lemma}

\begin{theorem}
An antisymmetric tensor $\mathcal{J}_{x}\in W\otimes W^{d}$%
\begin{equation}
\mathcal{J}_{x}=\sum_{1\leq j\leq r}\left( \overset{}{x_{j}\otimes
x_{bj+r}-x_{j+r}\otimes x_{bj}}\right)
\end{equation}%
corresponds to an antisymmetric operator $J_{x}=-J_{x}^{t}$ by 
\begin{equation}
J_{x}=\Xi _{WW^{d}}\left( \mathcal{J}_{x}\right) =\Xi _{WW^{d}}\left(
\sum_{1\leq j\leq r}\left( \overset{}{x_{j}\otimes x_{bj+r}-x_{j+r}\otimes
x_{bj}}\right) \right) =\sum_{1\leq j\leq r}\left( \overset{}{x_{j}\left[
x_{bj+r}\right] -x_{j+r}\left[ x_{bj}\right] }\right) .
\end{equation}

\begin{proof}
\begin{equation}
\left( \sum_{1\leq j\leq r}\left( \overset{}{x_{j}\left[ x_{bj+r}\right]
-x_{j+r}\left[ x_{bj}\right] }\right) \right) ^{t}=\sum_{1\leq j\leq
r}\left( \overset{}{x_{j+r}\left[ x_{bj}\right] -x_{j}\left[ x_{bj+r}\right] 
}\right)
\end{equation}%
\begin{gather}
\left( \sum_{1\leq j\leq r}\left( \overset{}{x_{j}\left[ x_{bj+r}\right]
-x_{j+r}\left[ x_{bj}\right] }\right) \right) \left( \sum_{1\leq k\leq
r}\left( \overset{}{x_{k}\left[ x_{bk+r}\right] -x_{k+r}\left[ x_{bk}\right] 
}\right) \right) =\sum_{1\leq j,k\leq r}\left\{ -x_{j}\left[ x_{bj+r}\right]
\left( x_{k+r}\right) \left[ x_{bk}\right] -x_{j+r}\left[ x_{bj}\right]
\left( x_{k}\right) \left[ x_{bk+r}\right] \right\} \\
=-\sum_{1\leq j\leq r}\left\{ x_{j}\left[ x_{bj}\right] +x_{j+r}\left[
x_{bj+r}\right] \right\} =-I_{W}
\end{gather}
\end{proof}
\end{theorem}

\subsection{Complex Cojugate Spaces from Real Spaces}

\begin{itemize}
\item Let $V_{\mathbb{R}}$ be a real vector space and $J\in \mathcal{L}%
\left( V_{\mathbb{R}}\right) $ such that 
\begin{equation}
J^{2}=-I_{V_{\mathbb{R}}}
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{e}\left( J\right) =-\mathcal{R}_{e}\left( J\right) ^{t}
\end{equation}%
\begin{eqnarray}
J &=&\sum_{1\leq j\leq r}v_{j}\otimes w_{bj}\longleftrightarrow \sum_{1\leq
j\leq r}v_{j}\left[ w_{bj}\right] \\
J^{t} &=&\sum_{1\leq j\leq r}w_{j}\otimes v_{bj}\longleftrightarrow
\sum_{1\leq j\leq r}w_{j}\left[ v_{bj}\right]
\end{eqnarray}%
\begin{eqnarray}
\left[ e_{bk}\right] J &=&\sum_{1\leq j\leq r}e_{bk}\left( v_{j}\right)
\otimes w_{bj}\left( e_{l}\right) \longleftrightarrow \sum_{1\leq j\leq
r}e_{bk}\left( v_{j}\right) w_{bj}\left( e_{l}\right) \\
J^{t} &=&\sum_{1\leq j\leq r}e_{bk}\left( w\right) _{j}\otimes \left(
v_{bj}\right) \left( e_{l}\right) \longleftrightarrow \sum_{1\leq j\leq
r}e_{bk}\left( w_{j}\right) \left( v_{bj}\right) \left( e_{l}\right)
=\sum_{1\leq j\leq r}w_{bbj}\left( e_{bl}\right) e_{bbk}\left( v_{dj}\right)
\end{eqnarray}
\end{itemize}

\section{Constructing Pre-Hilbert Spaces from Tensor Products}

\subsection{The Fundamental Construction}

Starting from a complex vector space $V$ and its conjugate $\overline{V}$,
we construct a pre-Hilbert space via the tensor product $\overline{V}\otimes
V$. Elements are finite sums: 
\begin{equation}
b_{\overline{v}\mathbf{w}}=\sum_{i}\overline{v_{i}}\otimes w_{i}\quad \text{%
where }\overline{v_{i}}\in V,w_{i}\in V.
\end{equation}

\subsection{Defining the Inner Product}

\subsubsection{Approach A: Existing Inner Product}

If $V$ has an inner product $\langle \cdot, \cdot \rangle_V$, define: 
\begin{equation}
\langle \overline{u} \otimes v, \overline{x} \otimes y \rangle = \langle u,
x \rangle_V \cdot \langle v, y \rangle_V,
\end{equation}
extended linearly.

\subsubsection{Approach B: Positive Semi-Definite Elements}

\begin{theorem}
An element $A\in \overline{V}\otimes V$ is \textbf{positive semi-definite}
if: 
\begin{equation}
A=\sum_{i}\overline{v_{i}}\otimes v_{i}
\end{equation}%
for finite collections $v_{i}\in V$.
\end{theorem}

Given such $A$, define an inner product on $V$: 
\begin{equation}
\langle x,y\rangle _{A}=\text{Tr}((\overline{\overline{x}}\otimes y)\circ A),
\end{equation}%
where $\overline{\overline{x}}\otimes y$ is interpreted as the rank-one
operator $z\mapsto \langle z,y\rangle x$.

\subsection{Finite-Dimensional Example}

For $V = \mathbb{C}^n$:

\begin{itemize}
\item $\overline{V} \otimes V \cong M_n(\mathbb{C})$ (complex matrices)

\item Positive semi-definite elements correspond to positive semi-definite
matrices $P$

\item Induced inner product: $\langle x, y \rangle_P = y^\dagger P x$
\end{itemize}

\section{Emergent Quantum Mechanics}

\subsection{Algebraic Foundation of Quantum Theory}

Quantum mechanics can be constructed from purely algebraic structures:

\begin{itemize}
\item Start with complex vector space $V$ (potential states)

\item Physical states: positive elements $\rho \in \overline{V} \otimes V$
with $\text{Tr}(\rho) = 1$

\item Observables: self-adjoint elements of $\overline{V} \otimes V$

\item Hilbert spaces emerge via completion of the induced pre-Hilbert
structure
\end{itemize}

\subsection{State-Dependent Geometry}

Each state $\rho $ defines its own Hilbert space $\mathcal{H}_{\rho }$ via: 
\begin{equation}
\langle x,y\rangle _{\rho }=\text{Tr}((\overline{\overline{x}}\otimes
y)\circ \rho ).
\end{equation}

This suggests that quantum geometry is fundamentally state-dependent.

\subsection{Physical Interpretation}

\begin{itemize}
\item $V$: Space of ket vectors $|\psi\rangle$

\item $\overline{V}$: Space of bra vectors $\langle\phi|$

\item $\overline{V} \otimes V$: Space of operators (density matrices)

\item Inner product on $\overline{V} \otimes V$ corresponds to
Hilbert-Schmidt inner product
\end{itemize}

\subsection{Mathematical Framework: GNS Construction}

The Gelfand-Naimark-Segal (GNS) construction formalizes this approach:

\begin{itemize}
\item Start with $*$-algebra $\mathcal{A} = \overline{V} \otimes V$

\item State $\omega: \mathcal{A} \to \mathbb{C}$ with $\omega(A^\dagger A)
\geq 0$

\item GNS construction yields Hilbert space $H_\omega$ and representation
\end{itemize}

\section{Theoretical Implications}

\subsection{Conceptual Advantages}

\begin{itemize}
\item \textbf{More fundamental}: Complex vector space structure is more
primitive than Hilbert space structure

\item \textbf{State-dependent geometry}: Different physical situations may
require different Hilbert spaces

\item \textbf{Unified treatment}: Pure and mixed states are elements of the
same space $\overline{V} \otimes V$

\item \textbf{Foundational clarity}: May resolve measurement problem and
inform quantum gravity approaches
\end{itemize}

\subsection{Relation to Algebraic Quantum Field Theory}

This approach aligns with Haag-Kastler algebraic quantum field theory:

\begin{itemize}
\item Local observables form $C^*$-algebras

\item Hilbert spaces emerge via representation theory

\item Background independence naturally accommodated
\end{itemize}

\section{Conclusion}

We have demonstrated that quantum mechanics can be fundamentally formulated
starting from a complex vector space $V$, with Hilbert space structures
emerging naturally through:

\begin{itemize}
\item The tensor product construction $\overline{V} \otimes V$

\item Positive semi-definite elements defining inner products

\item Physical states inducing specific Hilbert space geometries

\item The GNS construction providing mathematical rigor
\end{itemize}

This algebraic approach suggests that the traditional Hilbert space
formulation of quantum mechanics may be emergent rather than fundamental,
with deep implications for quantum foundations and quantum gravity.

