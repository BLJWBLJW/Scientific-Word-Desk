\right) \\
\parallel
\end{gather}%
\begin{gather}
\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( Tv\right) _{1} & \cdots & \mathcal{R}_{\rho
}\left( v\right) _{r}%
