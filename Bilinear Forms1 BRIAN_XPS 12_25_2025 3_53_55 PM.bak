\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
