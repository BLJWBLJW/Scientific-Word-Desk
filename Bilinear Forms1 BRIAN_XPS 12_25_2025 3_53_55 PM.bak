Hence

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{1}\right\vert \sigma _{r}\right) _{\rho \sigma
} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma
}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{\sigma }\left( T\right) _{11} & \cdots & \mathcal{R}_{\sigma
}\left( T\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\sigma }\left( T\right) _{r1} & \cdots & \mathcal{R}_{\sigma
}\left( T\right) _{rr}%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) _{11} & \cdots & 
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) _{r1} & \cdots & 
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{1}\right\vert \sigma _{r}\right) _{\rho \sigma
} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma
}%
\end{array}%
\right)
\end{equation}%
giving

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{1}\right\vert \sigma _{r}\right) _{\rho \sigma
} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma
}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{\sigma }\left( T\right) _{11} & \cdots & \mathcal{R}_{\sigma
}\left( T\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\sigma }\left( T\right) _{r1} & \cdots & \mathcal{R}_{\sigma
}\left( T\right) _{rr}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\left( \left. \rho _{1}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{1}\right\vert \sigma _{r}\right) _{\rho \sigma
} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma } & 
\cdots & \left( \left. \rho _{r}\right\vert \sigma _{1}\right) _{\rho \sigma
}%
\end{array}%
\right) ^{-1}=\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho }\left( T^{\#}\right) _{11} & \cdots & \mathcal{R}_{\rho
}\left( T^{\#}\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\rho }\left( T^{\#}\right) _{r1} & \cdots & \mathcal{R}_{\rho
}\left( T^{\#}\right) _{rr}%
\end{array}%
\right) ,
\end{equation}%
i.e.

\item 
\begin{equation}
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) =\mathbb{S}_{\rho
\sigma }^{-1}\mathcal{R}_{\sigma }\left( T\right) ^{t}\mathbb{S}_{\rho
\sigma }
\end{equation}%
thus the representation$\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma
}}\right) $ of $T^{t_{\rho \sigma }}$ (which depends on $\rho _{d}$ and $%
\sigma _{d})$ is the transpose of the representation $\mathcal{R}_{\rho
}\left( T\right) $ of $T$

\item 
\begin{equation}
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) =\mathcal{R}_{\rho
}\left( T\right) ^{t}
\end{equation}%
as 
\begin{equation}
\mathcal{R}_{\rho }\left( T\right) ^{t}=\mathbb{S}_{\rho \sigma }^{-1}%
\mathcal{R}_{\sigma }\left( T\right) ^{t}\mathbb{S}_{\rho \sigma }.
\end{equation}
\end{enumerate}

\begin{theorem}
The inner product $\left( \left. {}\right\vert \right) _{\rho \sigma }$
defines transposes $T^{t_{\rho \sigma }}\in \mathcal{L}\left( V\right) $ of
operators $T\in \mathcal{L}\left( V\right) $ by 
\begin{equation}
\left( \left. T^{t_{\rho \sigma }}v\right\vert w\right) _{\rho \sigma
}=\left( \left. v\right\vert Tw\right) _{\rho \sigma }\quad \forall w\in
V,\,v\in V
\end{equation}%
such that 
\begin{equation}
\mathcal{R}_{\rho }\left( T^{t_{\rho \sigma }}\right) =\mathcal{R}_{\rho
}\left( T\right) ^{t}.
\end{equation}

\begin{proof}
From the preceding. $\blacksquare $
\end{proof}
\end{theorem}

\begin{remark}
Thus one can define \emph{transposes }$t_{\rho \sigma }\in \mathcal{L}\left(
V\right) $ 
\begin{equation}
t_{\rho \sigma }:\mathcal{L}\left( V\right) \rightarrow \mathcal{L}\left(
V\right)
\end{equation}%
from all non degenerate second rank dual tensors $T_{d\rho \sigma }\in
V^{d}\otimes V^{d}$%
\begin{equation}
T_{d\rho \sigma }=\sum_{1\leq j\leq r}\rho _{dj}\otimes \sigma _{dj}.
\end{equation}
\end{remark}

\begin{remark}
Lets collect together some information:

\begin{enumerate}
\item The dual vectors $\rho _{dj}$ and $\sigma _{dj}$ can expanded wrt the
dual basis $\left( \boldsymbol{e}_{d}\right) $ of $V^{d}$ 
\begin{eqnarray}
\rho _{dj} &=&\sum_{1\leq k\leq r}e_{dk}\mathcal{R}_{e_{d}}\left( \rho
_{dj}\right) _{k}=\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{r}%
\end{array}%
\right) \\
\sigma _{dj} &=&\sum_{1\leq k\leq r}e_{dk}\mathcal{R}_{e_{d}}\left( \sigma
_{dj}\right) _{k}=\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \sigma _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \sigma _{dj}\right) _{r}%
\end{array}%
\right) .
\end{eqnarray}

\item The dualizing maps $d_{\rho \sigma }\in \mathcal{L}\left(
V^{d},V\right) $%
\begin{equation}
e_{d_{\rho \sigma }j}=\left( e_{j}\right\vert _{\rho \sigma }=d_{\rho \sigma
}\left( e_{j}\right) .
\end{equation}

\item The biorthogonal dualizing maps $\mathfrak{b}_{\rho \sigma }\in 
\mathcal{L}\left( V^{d},V\right) $%
\begin{equation}
e_{b_{\rho \sigma }j}=\left( \mathfrak{b}\left( e_{j}\right) \right\vert
_{\rho \sigma }=\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}%
\right) ^{-1}\left( e_{j}\right\vert _{\rho \sigma }=b_{\rho \sigma }\left(
e_{j}\right) .
\end{equation}

\item Expansion of a second rank dual tensor $T_{d\rho \sigma }$

\begin{enumerate}
\item In terms of its canonical bases $\left( \boldsymbol{\rho }_{d}\right) $
and $\left( \boldsymbol{\sigma }_{d}\right) $ of $V^{d}$ 
\begin{gather}
T_{d\rho \sigma } \\
\parallel \\
\left( 
\begin{array}{ccc}
\rho _{d1} & \cdots & \rho _{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sigma _{d1} \\ 
\vdots \\ 
\sigma _{dr}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{cc}
\rho _{d1}\cdots & \rho _{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{11} & \cdots & \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{r1} & \cdots & \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sigma _{d1} \\ 
\vdots \\ 
\sigma _{dr}%
\end{array}%
\right) ,
\end{gather}%
where 
\begin{equation}
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right) =%
\mathbb{I}_{r}.
\end{equation}

\item In terms of general bases $\left( \boldsymbol{e}_{d}\right) $ and $%
\left( \boldsymbol{f}_{d}\right) $ of $V^{d}$ 
\begin{gather}
T_{d\rho \sigma }=\sum_{1\leq j\leq r}\rho _{dj}\otimes \sigma _{dj}=\left( 
\begin{array}{ccc}
\rho _{d1} & \cdots & \rho _{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sigma _{d1} \\ 
\vdots \\ 
\sigma _{dr}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( \rho _{d1}\right) _{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( \rho _{dr}\right) _{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{d1}\right) _{r} & \cdots & \mathcal{R}%
_{e_{d}}\left( \rho _{dr}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( \sigma _{d1}\right) _{1} & \cdots & \mathcal{R}%
_{f_{d}}\left( \sigma _{dr}\right) _{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f_{d}}\left( \sigma _{d1}\right) _{r} & \cdots & \mathcal{R}%
_{f_{d}}\left( \sigma _{dr}\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( \overset{}{\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) }\right) \left( \overset{}{\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( \rho _{d1}\right) _{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( \rho _{dr}\right) _{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{d1}\right) _{r} & \cdots & \mathcal{R}%
_{e_{d}}\left( \rho _{dr}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( \sigma _{d1}\right) _{1} & \cdots & \mathcal{R}%
_{f_{d}}\left( \sigma _{dr}\right) _{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f_{d}}\left( \sigma _{d1}\right) _{r} & \cdots & \mathcal{R}%
_{f_{d}}\left( \sigma _{dr}\right) _{r}%
\end{array}%
\right) }\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{d1}\otimes f_{d1} & \cdots & e_{dr}\otimes f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}f_{d}}\left( T_{d\rho \sigma }\right) _{1111} & \cdots & 
\mathcal{R}_{e_{d}f_{d}}\left( T_{d\rho \sigma }\right) _{111rr} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}f_{d}}\left( T_{d\rho \sigma }\right) _{rr11} & \cdots & 
\mathcal{R}_{e_{d}f_{d}}\left( T_{d\rho \sigma }\right) _{rrrr}%
\end{array}%
\right) .
\end{gather}

\item Changes of basis of $V^{d}$ are given by

\begin{enumerate}
\item 
\begin{equation}
\left( \boldsymbol{\rho }_{d}\right) ^{t}=S_{\rho _{d}e_{d}}\left( 
\boldsymbol{e}_{d}\right) ^{t}=\left( \boldsymbol{e}_{d}\right) ^{t}\mathcal{%
R}_{e_{d}}\left( S_{\rho _{d}e_{d}}\right) =\left( \boldsymbol{e}_{d}\right)
^{t}\mathbb{S}_{\rho _{d}e_{d}}.
\end{equation}%
and

\item 
\begin{equation}
\left( \boldsymbol{\sigma }_{d}\right) ^{t}=S_{\sigma _{d}f_{d}}\left( 
\boldsymbol{f}_{d}\right) ^{t}=\left( \boldsymbol{f}_{d}\right) ^{t}\mathcal{%
R}_{e_{d}}\left( S_{\sigma _{d}f_{d}}\right) =\left( \boldsymbol{f}%
_{d}\right) ^{t}\mathbb{S}_{\sigma _{d}f_{d}}.
\end{equation}
\end{enumerate}

\item Changes of basis of $V^{d}\otimes V^{d}$ are given by%
\begin{equation}
\left( \boldsymbol{\rho }_{d}\otimes \boldsymbol{\sigma }_{d}\right)
^{t}=\left( \boldsymbol{e}_{d}\otimes \boldsymbol{f}_{d}\right) ^{t}\left( 
\mathbb{S}_{\rho _{d}e_{d}}\otimes \mathbb{S}_{\sigma _{d}f_{d}}\right)
=\left( \boldsymbol{e}_{d}\otimes \boldsymbol{f}_{d}\right) ^{t}\left( 
\mathcal{R}_{e_{d}}\left( S_{\rho _{d}e_{d}}\right) \otimes \mathcal{R}%
_{e_{d}}\left( S_{\sigma _{d}f_{d}}\right) \right) =\left( \boldsymbol{e}%
_{d}\otimes \boldsymbol{f}_{d}\right) ^{t}\mathcal{R}_{e_{d}}\left( S_{\rho
_{d}e_{d}}\otimes S_{\sigma _{d}f_{d}}\right)
\end{equation}%
Representations $\mathcal{R}_{\rho \otimes \sigma }\left( T\right) $ and $%
\mathcal{R}_{e\otimes f}\left( T\right) $ of $T\in \mathcal{L}\left(
V^{d}\otimes V^{d}\right) $ wrt the~bases $\left( \boldsymbol{e}_{d}\otimes 
\boldsymbol{f}_{d}\right) $ and $\left( \boldsymbol{\rho }_{d}\otimes 
\boldsymbol{\sigma }_{d}\right) $ are 
\begin{eqnarray}
T\left( \overset{}{\left( \boldsymbol{e}_{d}\otimes \boldsymbol{f}%
_{d}\right) ^{t}}\right) &=&T\left( 
\begin{array}{ccc}
e_{d1}\otimes f_{d1} & \cdots & e_{dr}\otimes f_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{d1}\otimes f_{d1} & \cdots & e_{dr}\otimes f_{dr}%
\end{array}%
\right) \mathcal{R}_{e_{d}\otimes f_{d}}\left( \overset{}{T}\right) \\
T\left( \overset{}{\left( \boldsymbol{\rho }_{d}\otimes \boldsymbol{\sigma }%
_{d}\right) ^{t}}\right) &=&T\left( 
\begin{array}{ccc}
\rho _{d1}\otimes \sigma _{d1} & \cdots & \rho _{dr}\otimes \sigma _{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\rho _{d1}\otimes \sigma _{d1} & \cdots & \rho _{dr}\otimes \sigma _{dr}%
\end{array}%
\right) \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( \overset{}{T}%
\right) ,
\end{eqnarray}%
which produces the change of representation 
\begin{equation}
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( \overset{}{T}\right)
=\left( \overset{}{\mathbb{S}_{\rho _{d}e_{d}}\otimes \mathbb{S}_{\sigma
_{d}f_{d}}}\right) \mathcal{R}_{e_{d}\otimes f_{d}}\left( \overset{}{T}%
\right) \left( \overset{}{\mathbb{S}_{\rho _{d}e_{d}}\otimes \mathbb{S}%
_{\sigma _{d}f_{d}}}\right) ^{-1}=\mathcal{R}_{e_{d}\otimes f_{d}}\left( 
\overset{}{S_{\rho _{d}e_{d}}\otimes S_{\sigma _{d}f_{d}}}\right) \mathcal{R}%
_{e_{d}\otimes f_{d}}\left( \overset{}{T}\right) \mathcal{R}_{e_{d}\otimes
f_{d}}\left( \overset{}{S_{\rho _{d}e_{d}}\otimes S_{\sigma _{d}f_{d}}}%
\right) ^{-1}.
\end{equation}
\end{enumerate}

\item Expansion of a second rank dual tensor wrt a basis $\left( \boldsymbol{%
e}_{d}\otimes \boldsymbol{f}_{d}\right) $ 
\begin{equation}
T_{d\rho \sigma }=T_{d\rho \sigma }\left( \boldsymbol{e}_{d}\otimes 
\boldsymbol{f}_{d}\right) =\sum_{1\leq k,l\leq r}e_{dk}\otimes f_{dl}%
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right)
_{kl}=\sum_{1\leq j\leq r}\sum_{1\leq k,l\leq r}e_{dk}\otimes f_{dl}\mathcal{%
R}_{e_{d}}\left( \rho _{dj}\right) _{k}\mathcal{R}_{f_{d}}\left( \sigma
_{dj}\right) _{l}=\sum_{1\leq k,l\leq r}e_{dk}\otimes f_{dl}\mathcal{R}%
_{e_{d}\otimes f_{d}}\left( \sum_{1\leq j\leq r}\rho _{dj}\otimes \sigma
_{dj}\right) _{kl}.
\end{equation}%
In super vector notation

\begin{enumerate}
\item wrt a $\left( \boldsymbol{e}_{d}\otimes \boldsymbol{f}_{d}\right) $
basis 
\begin{gather}
T_{d\rho \sigma }=\sum_{1\leq ,j,k\leq r}\left( e_{dk}\otimes f_{dl}\right) 
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right)
_{kl}=\sum_{1\leq ,j,k\leq r}e_{dj}\otimes \mathcal{R}_{e_{d}\otimes
f_{d}}\left( T_{d\rho \sigma }\right) _{jk}f_{dk}=\sum_{1\leq ,j,k\leq
r}\left( e_{dj}\otimes f_{dk}\right) \mathcal{R}_{e_{d}\otimes f_{d}}\left(
T_{d\rho \sigma }\right) _{jk} \\
\parallel \\
\left( 
\begin{array}{cc}
e_{d1}\cdots & e_{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right) _{11} & 
\cdots & \mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right)
_{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right) _{r1} & 
\cdots & \mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right)
_{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) .
\end{gather}

\item wrt the $\left( \boldsymbol{\rho }_{d}\otimes \boldsymbol{\sigma }%
_{d}\right) $ basis%
\begin{gather}
T_{d\rho \sigma }=\sum_{1\leq ,j,k\leq r}\left( \rho _{dj}\otimes \sigma
_{dk}\right) \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{jk}=\sum_{1\leq ,j,k\leq r}\rho _{dj}\otimes \mathcal{R}%
_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right) _{jk}\sigma
_{dk}=\sum_{1\leq ,j,k\leq r}\left( \rho _{dj}\otimes \sigma _{dk}\right) 
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{jk}=\sum_{1\leq ,j,\leq r}\rho _{dj}\otimes \sigma _{dj} \\
\parallel \\
\left( 
\begin{array}{cc}
\rho _{d1}\cdots & \rho _{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{11} & \cdots & \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{r1} & \cdots & \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sigma _{d1} \\ 
\vdots \\ 
\sigma _{dr}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{cc}
\rho _{d1}\cdots & \rho _{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sigma _{d1} \\ 
\vdots \\ 
\sigma _{dr}%
\end{array}%
\right) ,
\end{gather}%
where 
\begin{equation}
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
=\left( 
\begin{array}{ccc}
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{11} & \cdots & \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho \sigma }\right)
_{r1} & \cdots & \mathcal{R}_{\rho _{d}\otimes \sigma _{d}}\left( T_{d\rho
\sigma }\right) _{rr}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}%
and in general 
\begin{equation}
\left( 
\begin{array}{cc}
e_{d1}\cdots & e_{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}\otimes e_{d}}\left( T_{d\rho \sigma }\right) _{11} & 
\cdots & \mathcal{R}_{e_{d}\otimes e_{d}}\left( T_{d\rho \sigma }\right)
_{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}\otimes e_{d}}\left( T_{d\rho \sigma }\right) _{r1} & 
\cdots & \mathcal{R}_{e_{d}\otimes e_{d}}\left( T_{d\rho \sigma }\right)
_{rr}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
e_{d1}\cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right) _{11} & 
\cdots & \mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right)
_{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right) _{r1} & 
\cdots & \mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right)
_{rr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) .
\end{equation}%
The individual components of $T_{d\rho \sigma }$ are

\item 
\begin{eqnarray}
\rho _{dj}\otimes \sigma _{dj} &=&\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}}\left( \sigma _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{d}}\left( \sigma _{dj}\right) _{r}%
\end{array}%
\right) \\
&=&\left( \overset{}{\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) }\right) \left( \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}}\left( \sigma _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{d}}\left( \sigma _{dj}\right) _{r}%
\end{array}%
\right) \right) .
\end{eqnarray}

\item 
\begin{gather}
T_{d\rho \sigma } \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{d1}\otimes f_{d1} & \cdots & e_{dr}\otimes f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}\otimes f_{d}}\left( T_{d\rho \sigma }\right) _{rr}%
\end{array}%
\right) \\
\parallel \\
\sum_{1\leq j\leq r}\left\{ \left( 
\begin{array}{ccc}
e_{d1}\otimes f_{d1} & \cdots & e_{dr}\otimes f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{1}\mathcal{R}_{f_{d}}\left(
\sigma _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{r}\mathcal{R}_{f_{d}}\left(
\sigma _{dj}\right) _{r}%
\end{array}%
\right) \right\} =\left( 
\begin{array}{ccc}
e_{d1}\otimes f_{d1} & \cdots & e_{dr}\otimes f_{dr}%
\end{array}%
\right) \left( \sum_{1\leq j\leq r}\left\{ \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho _{dj}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}}\left( \sigma _{dj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{d}}\left( \sigma _{dj}\right) _{r}%
\end{array}%
\right) \right\} \right)
\end{gather}
\end{enumerate}

\item The mapping $\Xi _{VV^{d}V^{d}V^{d}}\in \mathcal{L}\left( V\otimes
V^{d},V^{d}\otimes V^{d}\right) $ produces mixed tensors from dual tensors 
\begin{equation}
\Xi _{VV^{d}V^{d}V^{d}}\left( T_{d\rho \sigma }\right) =\sum_{1\leq j\leq
r}d_{\rho \sigma }^{-1}\left( \rho _{dj}\right) \otimes \sigma _{dj}
\end{equation}

\item The mapping $\Xi _{\mathcal{L}\left( V\right) VV^{d}}\in \mathcal{L}%
\left( \mathcal{L}\left( V\right) ,V\otimes V^{d}\right) $ produces
operators belonging to $\mathcal{L}\left( V\right) $ from mixed tensors and
can be composed with the preceding map to form a map from dual tensors to
operators acting in a vector space $V$ 
\begin{equation}
\Xi _{\mathcal{L}\left( V\right) VV^{d}}\left( \overset{}{\Xi
_{VV^{d}V^{d}V^{d}}\left( T_{d\rho \sigma }\right) }\right) =\left( \Xi _{%
\mathcal{L}\left( V\right) VV^{d}}\circ \Xi _{VV^{d}V^{d}V^{d}}\right)
\left( \overset{}{T_{d\rho \sigma }}\right) =\Xi _{\mathcal{L}\left(
V\right) VV^{d}}\left( \overset{}{T_{d\rho \sigma }}\right) =\sum_{1\leq
j\leq r}d_{\rho \sigma }^{-1}\left( \rho _{dj}\right) \left[ \sigma _{dj}%
\right] .
\end{equation}%
In super vector notation%
\begin{equation}
\Xi _{\mathcal{L}\left( V\right) VV^{d}}\left( \overset{}{T_{d\rho \sigma }}%
\right) =\left( 
\begin{array}{ccc}
d_{\rho \sigma }^{-1}\left( \rho _{d1}\right) & \cdots & d_{\rho \sigma
}^{-1}\left( \rho _{dr}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{d1} \\ 
\vdots \\ 
\sigma _{dr}%
\end{array}%
\right) \right]
\end{equation}
\end{enumerate}
\end{remark}

\subsection{Real Even Dimensional Vector Spaces $W$}

Consider a real even dimensional vector space $W$ of dimension 
\begin{equation}
\dim \left\{ W\right\} =2r.
\end{equation}%
By Greubs theorem for $A\in \mathcal{L}\left( W\right) $ one obtains the
dyadic expansion 
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] .
\end{equation}

\begin{definition}
\textbf{of the} \textbf{Transpose} $A^{t}\in \mathcal{L}\left( W\right) $ of 
$A\ $is 
\begin{equation}
A^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] =\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] .
\end{equation}
\end{definition}

\begin{remark}
If $A\in \mathcal{L}\left( W_{2},W_{1}\right) $ then 
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] ,
\end{equation}%
and $A^{t}\in \mathcal{L}\left( W_{1},W_{2}\right) $ 
\begin{equation}
A^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] ,
\end{equation}%
where 
\begin{equation}
W_{1}=\mathbb{R}\text{-}\func{linspan}\left\{ \left. y_{j}\right\vert 1\leq
j\leq 2r\right\}
\end{equation}%
and 
\begin{equation}
W_{2}=\mathbb{R}\text{-}\func{linspan}\left\{ \left. x_{j}\right\vert 1\leq
j\leq 2r\right\} .
\end{equation}
\end{remark}

\subsection{The Dualizing Map $d$}

\begin{definition}
\textbf{The \underline{\textbf{Operator}} Dualizing Map \label{The operator
dualizing map} }$"d"\in \mathcal{L}\left( \mathcal{L}\left( W^{d}\right) ,%
\mathcal{L}\left( W\right) \right) $ 
\begin{equation}
d:\mathcal{L}\left( W\right) \rightarrow \mathcal{L}\left( W^{d}\right)
\end{equation}%
produces the dual $d\left( T\right) $ of the transformation of $T\in 
\mathcal{L}\left( W\right) $ \label{The dual transformation} $d\left(
T\right) \in \mathcal{L}\left( W^{d}\right) $ by 
\begin{equation}
d\left( T\right) \rho \left( v\right) =\rho \left( Tv\right) \,\quad \forall
v\in W,\forall \rho \in W^{d},\quad T\in \mathcal{L}\left( W\right) .
\end{equation}%
The operator dualizing map is independent of inner products. This is
identical to the definition of the 
%TCIMACRO{\hyperref{Transpose}{}{}{#Transpose} }%
%BeginExpansion
\msihyperref{Transpose}{}{}{#Transpose}
%EndExpansion
given earlier.
\end{definition}

\begin{definition}
\textbf{Vector Dualizing Maps} \label{Vector Dualizing Maps} $d_{\rho \sigma
}\in \mathcal{L}\left( W^{d},W\right) $ producing dual vectors 
\begin{equation}
v_{d\rho \sigma }=d_{\rho \sigma }\left( v\right)
\end{equation}%
of vectors $v$ \textbf{wrt the bilinear form} $b_{\rho \sigma }\in
W^{d}\otimes W^{d}$ are defined by 
\begin{equation}
v_{d\rho \sigma }\left( w\right) =b_{\rho \sigma }\left( v,w\right) \quad
\forall w\in W,\,v\in W.
\end{equation}%
The vector dualizing maps are not independent of inner products.

\begin{remark}
If $T\in \mathcal{L}\left( W_{2},W_{1}\right) $ i.e. 
\begin{equation}
T:W_{1}\rightarrow W_{2}
\end{equation}%
then the dual map is in the reverse dual direction i.e. 
\begin{equation}
d\left( T\right) :W_{2}^{d}\rightarrow W_{1}^{d}.
\end{equation}
\end{remark}
\end{definition}

\begin{remark}
The dual mappings $d\left( T\right) $ and its transpose $d\left( T\right)
^{t}$ can be expanded as 
\begin{equation}
d\left( T\right) =\sum_{1\leq j\leq 2r}y_{bj}\left[ x_{bbj}\right]
\rightarrow \sum_{1\leq j\leq 2r}y_{bj}\left[ x_{j}\right]
\end{equation}%
and 
\begin{equation}
d\left( T\right) ^{t}=\sum_{1\leq j\leq 2r}x_{bj}\left[ y_{bbj}\right]
\rightarrow \sum_{1\leq j\leq 2r}x_{bj}\left[ y_{j}\right] ,
\end{equation}%
which should be compared to the expansions of $A$ and $A^{t}$%
\begin{equation}
T=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right]
\end{equation}
\end{remark}

and 
\begin{equation}
T^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] ,
\end{equation}%
that in general act on different spaces and are thus unequal.

\begin{remark}
\begin{enumerate}
\item The representation of a transformation $T\in \mathcal{L}\left(
W\right) $ is given by 
\begin{eqnarray}
T\rho &\equiv &\left\vert T\rho \right) _{\rho \sigma }=\left\vert \mathbf{e}%
\right) _{\rho \sigma }\mathcal{R}_{e}\left( T\rho \right) =\left\vert 
\mathbf{e}\right) _{\rho \sigma }\mathcal{R}_{e}\left( T\right) \mathcal{R}%
_{e}\left( \rho \right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( T\rho \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( T\rho \right) _{2r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{2r2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( \rho \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( \rho \right) _{2r}%
\end{array}%
\right)
\end{eqnarray}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( T\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{2r2r}%
\end{array}%
\right) .
\end{equation}

\item If $T\in \mathcal{L}\left( W\right) $ then $d\left( T\right) \in 
\mathcal{L}\left( W^{d}\right) $ and is related to the dualizing maps $%
\left\{ d_{\rho \sigma }\in \mathcal{L}\left( W^{d},W\right) \right\} $ by 
\begin{equation}
\left[ \overset{}{d\left( T\right) \left( \overset{}{d_{\rho \sigma }\left(
\rho \right) }\right) }\right] \left( v\right) =\left[ \overset{}{d_{\rho
\sigma }\left( \rho \right) }\right] \left( Tv\right) =\left[ \left( T\rho
\right\vert _{\rho \sigma }\right] \left( v\right) =\left[ d\left( T\right)
\left( \rho \right\vert _{\rho \sigma }\right] \left( v\right) =\left[
\left( \rho \right\vert _{\rho \sigma }\right] \left( Tv\right) =\left(
\left. \overset{}{T\rho }\right\vert v\right) _{\rho \sigma }\quad \forall
v\in W,\,\forall \rho _{d}\in W^{d},\,T\in \mathcal{L}\left( W\right) .
\end{equation}

\item The dualizing maps $\left\{ d_{\rho \sigma }\in \mathcal{L}\left(
W^{d},W\right) \right\} $ have the following effect on tranformed vectors $%
\left\vert T\rho \right) _{\rho \sigma }$ 
\begin{eqnarray}
d_{\rho \sigma }\left( w\right) &=&d_{\rho \sigma }\left( T\rho \right)
=d\left( T\right) d_{\rho \sigma }\left( \rho \right) =d\left( T\right)
\left( \rho \right\vert _{\rho \sigma }=\left( T\rho \right\vert _{\rho
\sigma }=\left( \boldsymbol{e}_{d}\right\vert _{\rho \sigma }\mathcal{R}%
_{e_{b}}\left( T\right) \mathcal{R}_{e_{b}}\left( \rho \right) \\
&=&\left( 
\begin{array}{ccc}
\left( e_{1}\right\vert _{\rho \sigma } & \cdots & \left( e_{2r}\right\vert
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( T\rho \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( T\rho \right) _{2r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\left( e_{1}\right\vert _{\rho \sigma } & \cdots & \left( e_{2r}\right\vert
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( T\right) _{11} & \cdots & \mathcal{R}%
_{e_{d}}\left( T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( T\right) _{2r1} & \cdots & \mathcal{R}%
_{e_{d}}\left( T\right) _{2r2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( \rho \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( \rho \right) _{2r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\left( e_{1}\right\vert _{\rho \sigma } & \cdots & \left( e_{2r}\right\vert
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{2r2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( \rho \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( \rho \right) _{2r}%
\end{array}%
\right) ,
\end{eqnarray}%
showing that 
\begin{equation}
\mathcal{R}_{e_{d}}\left( d\left( T\right) \right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{2r2r}%
\end{array}%
\right) .
\end{equation}

\item The inner product form of the transformed dualized vector $\rho $ can
be expressed as

\begin{enumerate}
\item The effect of the linear functional $\left( T\rho \right\vert _{\rho
\sigma }$ induced by the vector $T\rho $ can be expressed in terms of the
inner product $\left( \left. {}\right\vert \right) _{\rho \sigma }$ by 
\begin{equation}
\left( \left. T\rho \right\vert v\right) _{\rho \sigma }=\left[ \left( T\rho
\right\vert _{\rho \sigma }\right] \left( v\right) =\left[ \overset{}{%
d\left( T\right) \left( \overset{}{d_{\rho \sigma }\left( \rho \right) }%
\right) }\right] \left( v\right) ,
\end{equation}%
which

\item can be expressed in super vector form as 
\begin{equation}
\left( \left. \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( T\rho \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( T\rho \right) _{2r}%
\end{array}%
\right) \right\vert \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right) \right)
\end{equation}

and 
\begin{equation}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\rho \right) _{1} & \cdots & \mathcal{R}_{e}\left(
T\rho \right) _{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right) .
\end{equation}%
This can be expressed in matrix form as

\item 
\begin{gather}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( T\right) _{11} & \cdots & \mathcal{R}%
_{e_{d}}\left( T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( T\right) _{2r1} & \cdots & \mathcal{R}%
_{e_{d}}\left( T\right) _{2r2r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( \rho \right) _{1} & \cdots & \mathcal{R}_{e}\left(
\rho \right) _{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( T\right) _{11} & \cdots & \mathcal{R}%
_{e_{d}}\left( T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( T\right) _{2r1} & \cdots & \mathcal{R}%
_{e_{d}}\left( T\right) _{2r2r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( \rho \right) _{1} & \cdots & \mathcal{R}_{e}\left(
\rho \right) _{2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right)
\end{gather}

\item 
\begin{gather}
d\left( T\right) \left( \rho \right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \mathcal{R}_{e}\left( v\right) =d\left( T\right) \left( \rho
\right\vert _{\rho \sigma }\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \left\vert v\right) _{\rho \sigma } \\
\parallel \\
\mathcal{R}_{e}\left( d\left( T\right) \right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( \rho \right) _{1} & \cdots & \mathcal{R}_{e}\left(
\rho \right) _{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right)
\end{gather}
\end{enumerate}

\item 
\begin{equation}
\mathcal{R}_{e_{d}}\left( d\left( T\right) \right) =\mathcal{R}_{e}\left(
T\right) ^{t}
\end{equation}
\end{enumerate}
\end{remark}

\subsection{Representations of Transpose and Dual Maps \label%
{Representations of Transpose and Dual Maps}}

\subsubsection{Transpose Maps}

The matrix representations $\mathcal{R}_{e}\left( A\right) $ and $\mathcal{R}%
_{e}\left( A^{t}\right) $ of the operators $A$ and $A^{t}$ wrt a basis $%
\left( \boldsymbol{e}\right) $ of $W$ are

\begin{enumerate}
\item $\mathcal{R}_{e}\left( A\right) $%
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\item $\mathcal{R}_{e}\left( A^{t}\right) $%
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) ,
\end{equation}

\item which one can compare to $\mathcal{R}_{e}\left( A\right) ^{t}$ 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) .
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\subsubsection{Dual Maps}

The matrix represenations $\mathcal{R}_{e}\left( d\left( A\right) \right) $
and $\mathcal{R}_{e}\left( d\left( A\right) ^{t}\right) $ of the operators $%
d\left( A\right) $ and $d\left( A\right) ^{t}$ wrt a basis $\left( 
\boldsymbol{e}\right) $ of $W$ are

\begin{enumerate}
\item $\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) $%
\begin{gather}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bb2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
y_{b1} & \cdots & y_{b2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{bb1} \\ 
\vdots \\ 
x_{bb2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{b2r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
e_{bb1}\left( y_{b1}\right) & \cdots & e_{bb1}\left( y_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bb2r}\left( y_{b1}\right) & \cdots & e_{bb2r}\left( y_{b2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{bb1}\left( e_{b1}\right) & \cdots & x_{bb1}\left( e_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{bb2r}\left( e_{b1}\right) & \cdots & x_{bb2r}\left( e_{b2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) ,
\end{equation}%
which should be compared to 
\begin{gather}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) ^{t} \\
=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) =\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) .
\end{gather}

\item $\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) $%
\begin{gather}
\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bb2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
x_{b1} & \cdots & x_{b2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{bb1} \\ 
\vdots \\ 
y_{bb2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{b2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( x_{b1}\right) & \cdots & e_{bb1}\left( x_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bb2r}\left( x_{b1}\right) & \cdots & e_{bb2r}\left( x_{b2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{bb1}\left( e_{b1}\right) & \cdots & y_{bb1}\left( e_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{bb2r}\left( e_{b1}\right) & \cdots & y_{bb2r}\left( e_{b2r}\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b1}\left( e_{2r}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( y_{2r}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b1}\left( e_{2r}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( y_{2r}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\item Compare to $\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) ^{t}$ 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) ^{t}=\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\paragraph{\textbf{Comparing transpose and dual representations}}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right)
\end{equation}
\end{enumerate}

\begin{enumerate}
\item Dual mappings produce transposed matrices \label{Dual mappings produce
transposed matrices} 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) ^{t}
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b1}\left( e_{2r}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( y_{2r}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A^{t}\right) ^{t}
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) ^{t}=\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{theorem}
\textbf{The representation matrix of the dual of the operator }$A$\textbf{\
wrt the dual biorthogonal basis }$\left( \boldsymbol{e}_{b}\right) $\textbf{%
\ is the transpose of the matrix of the operator wrt the basis} $\left( 
\boldsymbol{e}_{b}\right) .$\label{Representation of Dual Operator} 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\mathcal{R}_{e}\left(
A\right) ^{t}.
\end{equation}

\begin{proof}
From the preceding.
\end{proof}
\end{theorem}

\begin{corollary}
\begin{equation}
d\left( A\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) =\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) ^{t}\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) .
\end{equation}
\end{corollary}

\subsection{Bilinear Forms Defined in $W$}

One can equip $W$ with a \emph{non degenerate} bilinear forms $\left( \left.
{}\right\vert \right) _{\rho \sigma }\equiv \left( \left. {}\right\vert
\right) \in W^{d}\otimes W^{d}$ for $\rho _{b}$,$\sigma _{b}\in W^{d}$ 
\begin{equation}
\left( \left. {}\right\vert \right) \equiv \left( \left. {}\right\vert
\right) _{\rho \sigma }:W\times W\rightarrow \mathbb{R}
\end{equation}%
that in general \emph{do not} have any symmetry i.e. $\left( \left.
v\right\vert w\right) $ is unrelated to $\left( \left. w\right\vert v\right)
.$

\begin{notation}
\begin{equation}
\left( \left. {}\right\vert \right) _{\rho \sigma }\equiv \left( \left.
{}\right\vert \right) .
\end{equation}
\end{notation}

\begin{definition}
\textbf{\ }A form $\left( \left. {}\right\vert \right) _{\rho \sigma }$ is
non degenerate if 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=0\quad \forall w\in
W\Leftrightarrow v=0.
\end{equation}
\end{definition}

\begin{theorem}
A non degenrate bilinear form $\left( \left. {}\right\vert \right) _{\rho
\sigma }\in W^{d}\otimes W^{d}$ can be expanded as 
\begin{equation}
\left( \left. {}\right\vert \right) =\left( \left. {}\right\vert \right)
_{\rho \sigma }=\sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj},
\end{equation}%
whose action is defined by 
\begin{equation}
\left( \left. v\right\vert w\right) =\left( \left. v\right\vert w\right)
_{\rho \sigma }=\sum_{1\leq j\leq 2r}\left[ \overset{}{\rho _{bj}\otimes
\sigma _{bj}}\right] \left( v\otimes w\right) =\sum_{1\leq j\leq 2r}\rho
_{bj}\left( v\right) \sigma _{bj}\left( w\right) .
\end{equation}
\end{theorem}

\begin{remark}
\begin{equation}
\sum_{1\leq j\leq 2r}\rho _{bj}\left( v\right) \sigma _{bj}\left( w\right)
=\left( \left. \rho \right\vert v\right) _{\rho \sigma }\left( \left. \sigma
\right\vert w\right) _{\rho \sigma }.
\end{equation}
\end{remark}

\begin{remark}
Note that $\left( \left. {}\right\vert \right) _{\rho \sigma }$ being non
degenerate still allows in particular 
\begin{equation}
\left( \left. v\right\vert v\right) _{\rho \sigma }=0
\end{equation}%
and in general 
\begin{equation}
\left( \left. v\right\vert v\right) _{\rho \sigma }=\left\{ 
\begin{array}{c}
>0 \\ 
=0 \\ 
<0%
\end{array}%
\right. .
\end{equation}
\end{remark}

\begin{lemma}
\emph{Non degenerate} bilinear forms define inner products in $W.$
\end{lemma}

\begin{definition}
Dual vectors in terms of the inner product $\left( \left. {}\right\vert
\right) _{\rho \sigma }$ 
\begin{equation}
v_{d}=\left( v\right\vert _{\rho \sigma }
\end{equation}%
by 
\begin{equation}
\left( v\right\vert _{\rho \sigma }\left( w\right) =v_{d}\left( w\right)
=\left( \left. v\right\vert w\right) _{\rho \sigma },\quad \forall w\in W.
\end{equation}
\end{definition}

\begin{definition}
\textbf{\ }The orthogonal compliment to the vector $v$ is the subspace $%
W_{\left( \left. {}\right\vert \right) }^{\bot _{v}}$ which is defined as 
\begin{equation}
W_{\left( \left. {}\right\vert \right) }^{\bot _{v}}=\left\{ \left. \overset{%
}{w}\right\vert \left( \left. \overset{}{v}\right\vert w\right) _{\rho
\sigma }=0,w\in W\right\} .
\end{equation}
\end{definition}

\begin{remark}
Direct sum decomposition of $W$ in terms of orthogonal subspaces to a vector 
\begin{equation}
W=W_{\left( \left. {}\right\vert \right) }^{\bot _{v}}\oplus \left\{
v\right\}
\end{equation}
\end{remark}

\begin{definition}
The Invariance Group $G_{\rho \sigma }\subset $ $GL\left( W\right) $ of a
form $\left( \left. {}\right\vert \right) _{\rho \sigma }$ is defined by 
\begin{equation}
G_{\rho \sigma }=\left\{ \left. \overset{}{T\in GL\left( W\right) }%
\right\vert \left( \left. Tv\right\vert Tw\right) _{\rho \sigma }=\left(
\left. v\right\vert w\right) _{\rho \sigma }\right\} .
\end{equation}
\end{definition}

\begin{remark}
\begin{eqnarray}
\left( \left. Tv\right\vert Tw\right) _{\rho \sigma } &=&\sum_{1\leq j\leq
2r}\rho _{bj}\left( Tv\right) \sigma _{bj}\left( Tw\right) =\sum_{1\leq
j\leq 2r}d\left( T\right) \rho _{bj}\left( v\right) d\left( T\right) \sigma
_{bj}\left( w\right) \\
&=&\left( \overset{}{d\left( T\right) \otimes d\left( T\right) }\right)
\left( \sum_{1\leq j\leq 2r}\rho _{bj}\left( v\right) \sigma _{bj}\left(
w\right) \right) =\left( \left( \overset{}{d\left( T\right) \otimes d\left(
T\right) }\right) \left( \sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma
_{bj}\right) \right) \left( v\otimes w\right) =\left( \left. v\right\vert
w\right) _{\rho \sigma }
\end{eqnarray}%
i.e. 
\begin{equation}
\left( \overset{}{d\left( T\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj}\right) =\sum_{1\leq
j\leq 2r}\rho _{bj}\otimes \sigma _{bj},
\end{equation}%
so $a_{2d}=\sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj}$ is an
eigenvector of $\left( \overset{}{d\left( T\right) \otimes d\left( T\right) }%
\right) $ with eigenvalue $+1.$
\end{remark}

\begin{remark}
General transformations $\mathfrak{T}_{AB}\in \mathcal{L}\left( W^{d}\otimes
W^{d}\right) $ 
\begin{equation}
\mathfrak{T}_{AB}\mathfrak{:}W^{d}\otimes W^{d}\rightarrow W^{d}\otimes W^{d}
\end{equation}%
between dual tensors \label{transformation between dual tensors}%
\begin{equation}
b_{\mathbf{\rho \sigma }}=\mathbf{\rho }^{t}\mathbf{\sigma }=\left( 
\begin{array}{ccc}
\rho _{b1} & \cdots & \rho _{b2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{b2r}%
\end{array}%
\right)
\end{equation}
is given by 
\begin{equation}
T_{\widetilde{\mathbf{\rho \sigma }}}=\widetilde{b_{\mathbf{\rho \sigma }}}=%
\mathfrak{T}_{AB}\left( b_{\mathbf{\rho \sigma }}\right) =\mathfrak{T}%
_{AB}\left( \sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj}\right)
=\sum_{1\leq j\leq 2r}A_{j}\rho _{bj}\otimes B_{j}\sigma _{bj}=\sum_{1\leq
j\leq 2r}\left( A_{j}\otimes B_{j}\right) \left( \rho _{bj}\otimes \sigma
_{bj}\right) .
\end{equation}
\end{remark}

\begin{remark}
All tensors $a_{2d}\in W^{d}\times $ $W^{d}$ can be expressed as 
\begin{equation}
a_{2d}=\sum_{1\leq j\leq \limfunc{Rank}\left( A_{2d}\right) }\rho
_{bj}\otimes \sigma _{bj}
\end{equation}%
for some $\left\{ \left. \rho _{bj},\sigma _{bj}\right\vert 1\leq j\leq 
\limfunc{Rank}\left( a_{2d}\right) \leq 2r\right\} $
\end{remark}

\begin{lemma}
If 
\begin{equation}
\limfunc{Rank}\left( a_{2d}\right) =2r
\end{equation}%
then $a_{2d}$ is \emph{non degenerate.}
\end{lemma}

\begin{remark}
The transformation 
\begin{equation}
\left( \left. T\cdot \right\vert T\cdot \right) _{\rho \sigma }=\left( 
\overset{}{d\left( T\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\left( \cdot \right) \sigma _{bj}\left( \cdot
\right) \right)
\end{equation}%
is a special case of the general transformation.
\end{remark}

\begin{remark}
$\left( \left. {}\right\vert \right) _{\rho \sigma }$-normalized vectors $v$
are given by 
\begin{equation}
\left( \left. v\right\vert v\right) _{\rho \sigma }=1,
\end{equation}%
where 
\begin{equation}
v=\frac{\left\vert \widetilde{v}\right) _{\rho \sigma }}{\sqrt{\left( \left. 
\widetilde{v}\right\vert \widetilde{v}\right) _{\rho \sigma }}}.
\end{equation}
\end{remark}

\begin{remark}
$\left( \left. {}\right\vert \right) _{\rho \sigma }$-normalized $v_{b}$ are
given by 
\begin{equation}
v_{b}=\frac{\left( \widetilde{v}\right\vert _{\rho \sigma }}{\sqrt{\left(
\left. \widetilde{v}\right\vert \widetilde{v}\right) _{\rho \sigma }}}.
\end{equation}
\end{remark}

\begin{lemma}
Let $T\in \mathcal{L}\left( W\right) $ then 
\begin{equation}
\left( \left. \cdot \right\vert \cdot \right) _{d\left( T\right) \left( \rho
\right) d\left( T\right) \left( \sigma \right) }=\left( \left. T\cdot
\right\vert T\cdot \right) _{\rho \sigma }.
\end{equation}

\begin{proof}
\begin{equation}
\left( \left. T\cdot \right\vert T\cdot \right) _{\rho \sigma }=\left( 
\overset{}{d\left( T\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\left( \cdot \right) \sigma _{bj}\left( \cdot
\right) \right) =\sum_{1\leq j\leq 2r}\left( \overset{}{d\left( T\right)
\left( \rho _{bj}\right) }\right) \left( \cdot \right) \left( \overset{}{%
d\left( T\right) \left( \sigma _{bj}\right) }\right) \left( \cdot \right)
=\sum_{1\leq j\leq 2r}\rho _{bj}\left( T\cdot \right) \sigma _{bj}\left(
T\cdot \right) .
\end{equation}
\end{proof}
\end{lemma}

\begin{definition}
The equivalence class of inner products $\left[ \left( \left. \cdot
\right\vert \cdot \right) _{\rho \sigma }\right] $ generated by the inner
product $\left( \left. \cdot \right\vert \cdot \right) _{\rho \sigma }$ is
defined by 
\begin{equation}
\left[ \left( \left. \cdot \right\vert \cdot \right) _{\rho \sigma }\right]
=\left\{ \left. \left( \left. \cdot \right\vert \cdot \right) _{\rho \sigma
}=\,\overset{}{\left( \left. T\cdot \right\vert T\cdot \right) _{\rho \sigma
}}\right\vert T\in \mathcal{L}\left( W\right) \right\}
\end{equation}%
so that 
\begin{equation}
\left( \left. \cdot \right\vert \cdot \right) _{\rho _{1}\sigma
_{1}}\thicksim \left( \left. \cdot \right\vert \cdot \right) _{\rho
_{2}\sigma _{2}}
\end{equation}%
if $\exists T\in \mathcal{L}\left( W\right) $ such that 
\begin{equation}
\left( \left. \cdot \right\vert \cdot \right) _{\rho _{2}\sigma _{2}}=\left(
\left. T\cdot \right\vert T\cdot \right) _{\rho _{2}\sigma _{2}}.
\end{equation}
\end{definition}

\begin{theorem}
All inner products on $W$ are given by 
\begin{equation}
\left( A\mathbf{\rho }\right) ^{t}\otimes \left( B\mathbf{\sigma }\right)
\equiv \left( A\mathbf{\rho }\right) ^{t}\left( B\mathbf{\sigma }\right) =%
\mathfrak{T}_{AB}\left( \sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma
_{bj}\right) =\sum_{1\leq j\leq 2r}A_{j}\rho _{bj}\otimes B_{j}\sigma
_{bj}=\sum_{1\leq j\leq 2r}\left( A_{j}\otimes B_{j}\right) \left( \rho
_{bj}\otimes \sigma _{bj}\right) =\sum_{1\leq j\leq 2r}A_{j}\rho
_{bj}\otimes B_{j}\sigma _{bj}=\sum_{1\leq j\leq 2r}\left( A\rho \right)
_{bj}\otimes \left( B\sigma \right) _{bj}=\left( \left. \cdot \right\vert
\cdot \right) _{\left( A\rho \right) \left( B\sigma \right) },
\end{equation}%
where $A_{j},B_{j}\in \mathcal{L}\left( W^{d}\right) $
\end{theorem}

\begin{remark}
In particular transformations generated by \emph{decomposable elements} of $%
W^{d}\otimes W^{d}$ are given by 
\begin{equation}
\left( \left. S\cdot \right\vert T\cdot \right) _{\rho \sigma }=\left( 
\overset{}{d\left( S\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\left( \cdot \right) \sigma _{bj}\left( \cdot
\right) \right) =\sum_{1\leq j\leq 2r}\rho _{bj}\left( S\cdot \right) \sigma
_{bj}\left( T\cdot \right) .
\end{equation}
\end{remark}

\section{Biorthogonal Bases}

\subsection{The Overlap Matrix}

\begin{definition}
The overlap matrix $\mathbb{S}_{\rho \sigma e}=\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho \sigma }$ wrt $\left( \left.
{}\right\vert \right) _{\rho \sigma }$ is defined by 
\begin{equation}
\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho \sigma
}=\left( \left. \overset{}{\left( \boldsymbol{e}\right) ^{t}}\right\vert
\left( \boldsymbol{e}\right) ^{t}\right) _{\rho \sigma }=\left( \left. 
\overset{}{\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) }\right\vert \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) \right) _{\rho \sigma }\equiv \left( \left. \overset{}{\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) }\right\vert \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \right) _{\rho \sigma }.
\end{equation}
\end{definition}

\begin{definition}
The dual functionals $d_{\rho \sigma }\left( e_{j}\right) =\left(
e_{j}\right\vert _{\rho \sigma }\in W^{d},1\leq j\leq 2r$ are defined by the
inner product $\left( \left. {}\right\vert \right) _{\rho \sigma }$ by 
\begin{equation}
\left( e_{j}\right\vert _{\rho \sigma }\left( v\right) =\left( \left.
e_{j}\right\vert v\right) _{\rho \sigma },\quad \forall v\in W,\,1\leq j\leq
2r.
\end{equation}
\end{definition}

\begin{remark}
Let $\left( \mathbf{e}\right) =\left\{ \left. e_{j}\right\vert 1\leq j\leq
2r\right\} $ be a basis of $W$ then the \textbf{overlap matrix} $\mathbb{S}%
_{\rho \sigma e}$ is the representation $\mathcal{R}_{e}\left( S_{\rho
\sigma e}\right) $ of the \textbf{overlap operator} $S_{\rho \sigma e}\in 
\mathcal{L}\left( W\right) $ \label{overlap operator} 
\begin{equation}
S_{\rho \sigma e}=\left( \overset{}{\left\vert \boldsymbol{e}\right) _{\rho
\sigma }}\right) ^{t}\left( \overset{}{\left( \mathbf{e}\right\vert _{\rho
\sigma }}\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
d_{\rho \sigma }\left( e_{1}\right) \\ 
\vdots \\ 
d_{\rho \sigma }\left( e_{2r}\right)%
\end{array}%
\right) \right]
\end{equation}%
wrt the basis $\left( \mathbf{e}\right) $ is given by 
\begin{equation}
\mathbb{S}_{\rho \sigma ee}=\left( \left. \left( \boldsymbol{e}\right)
^{t}\right\vert \left( \boldsymbol{e}\right) ^{t}\right) _{\rho \sigma
}\equiv \left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
\sigma }=\left[ \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
The inner product $\left( \left. \cdot \right\vert \cdot \right) _{\rho
\sigma }$ can be analysed through the following expressions:

\begin{enumerate}
\item The matrix and scalar form of the general inner product $\left( \left.
\cdot \right\vert \cdot \right) _{\rho \sigma }$ are

\begin{enumerate}
\item unexpanded form%
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\left( \left. \overset{}{%
\left( \mathbf{e}\right) ^{t}\mathcal{R}_{e}\left( v\right) }\right\vert
\left( \mathbf{e}\right) ^{t}\mathcal{R}_{e}\left( w\right) \right) _{\rho
\sigma }.
\end{equation}

\item scalar form%
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\sum_{1\leq j,k\leq 2r}%
\mathcal{R}_{e}\left( v\right) _{j}\left( \left. e_{j}\right\vert
e_{k}\right) _{\rho \sigma }\mathcal{R}_{e}\left( w\right) _{k}.
\end{equation}

\item matrix form%
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
v\right) ^{t}\left( \left. \mathbf{e}\right\vert \mathbf{e}\right) _{\rho
\sigma }\mathcal{R}_{e}\left( w\right) .
\end{equation}
\end{enumerate}

\item In super vector notation the inner product can be expressed as

\begin{enumerate}
\item 
\begin{gather}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\left( \left. \overset{}{%
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right) }\right\vert \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{2r}%
\end{array}%
\right) \right) _{\rho \sigma } \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) _{1} & \cdots & \mathcal{R}_{e}\left(
v\right) _{2r}%
\end{array}%
\right) \left( \left. \overset{}{\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) }\right\vert \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \right) _{\rho \sigma }\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{2r}%
\end{array}%
\right) .
\end{gather}

\item 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) _{1} & \cdots & \mathcal{R}_{e}\left(
v\right) _{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{2r}%
\end{array}%
\right) \right] _{\rho \sigma }\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{2r}%
\end{array}%
\right) .
\end{equation}

\item 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) _{1} & \cdots & \mathcal{R}_{e}\left(
v\right) _{2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert e_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{2r}%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\item \textbf{The matrix form of the inner product should be emphasized} 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=\mathcal{R}_{e}\left(
v\right) ^{t}\left( \left. \mathbf{e}\right\vert \mathbf{e}\right) _{\rho
\sigma }\mathcal{R}_{e}\left( w\right) =\mathcal{R}_{e}\left( v\right) ^{t}%
\mathbb{S}_{\rho \sigma e}\mathcal{R}_{e}\left( w\right) =\mathcal{R}%
_{e}\left( v\right) ^{t}\mathcal{R}_{e}\left( S_{\rho \sigma }\right) 
\mathcal{R}_{e}\left( w\right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{notation}
Note that 
\begin{equation}
\left\vert e_{j}\right) _{\rho \sigma }\equiv \left\vert e_{j}\right) ,\quad
1\leq j\leq 2r
\end{equation}%
i.e. the vectors in $W$ \emph{do not }depend on the inner product $\left(
\left. \cdot \right\vert \cdot \right) _{\rho \sigma }.$
\end{notation}

\begin{remark}
The representation of vectors and operators wrt the basis $\left( \mathbf{e}%
\right) $ are given by

\begin{enumerate}
\item 
\begin{enumerate}
\item The action of operators on vectors in terms of super vectors and
scalar matrices 
\begin{eqnarray}
Tv &=&T\left( \overset{}{\mathbf{e}}\right) ^{t}\mathcal{R}_{e}\left(
v\right) =\sum_{1\leq j,k\leq 2r}e_{j}\mathcal{R}_{e}\left( T\right) _{jk}%
\mathcal{R}_{e}\left( v\right) _{k}=\left( \mathbf{e}\right) \mathcal{R}%
_{e}\left( T\right) \mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{2r2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right) \\
Tw &=&T\left( \overset{}{\mathbf{e}}\right) ^{t}\mathcal{R}_{e}\left(
w\right) =\sum_{1\leq j,k\leq 2r}e_{j}\mathcal{R}_{e}\left( T\right) _{jk}%
\mathcal{R}_{e}\left( w\right) _{k}=\left( \mathbf{e}\right) \mathcal{R}%
_{e}\left( T\right) \mathcal{R}_{e}\left( w\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{11} & \cdots & \mathcal{R}_{e}\left(
T\right) _{12r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{2r1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{2r2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{2r}%
\end{array}%
\right) .
\end{eqnarray}

\item The representation of vectors in terms of super vectors and scalar
column vectors 
\begin{eqnarray}
v &=&\sum_{1\leq j\leq 2r}e_{j}\mathcal{R}_{e}\left( v\right) _{j}=\left( 
\overset{}{\mathbf{e}}\right) ^{t}\mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{2r}%
\end{array}%
\right) \\
w &=&\sum_{1\leq j\leq 2r}e_{j}\mathcal{R}_{e}\left( w\right) _{j}=\left( 
\overset{}{\mathbf{e}}\right) ^{t}\mathcal{R}_{e}\left( w\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) _{2r}%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}

\item The action of the overlap operator $S_{\rho \sigma e}\in \mathcal{L}%
\left( W\right) $ 
\begin{gather}
\left\vert S_{\rho \sigma e}e_{k}\right) \\
\parallel \\
\,\text{row super vector form} \\
\sum_{1\leq j\leq 2r}e_{j}\mathcal{R}_{e}\left( S_{\rho \sigma e}\right)
_{jk} \\
\parallel \\
\,\text{column super vector form} \\
\sum_{1\leq j\leq 2r}\mathcal{R}_{e}\left( S_{\rho \sigma e}\right)
_{jk}e_{j}=\sum_{1\leq j\leq 2r}\mathcal{R}_{e}\left( S_{\rho \sigma
e}\right) _{kj}^{t}e_{j}
\end{gather}
in super vector notation

\begin{enumerate}
\item 
\begin{eqnarray}
S_{\rho \sigma e}\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
S_{\rho \sigma e}\left\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left\vert S_{\rho \sigma e}e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \mathcal{R}_{e}\left( S_{\rho \sigma e}\right) \\
&\Updownarrow & \\
\left( 
\begin{array}{c}
\left\vert S_{\rho \sigma e}e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert S_{\rho \sigma e}e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) &=&S_{\rho \sigma e}\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\mathcal{R}_{e}\left( S_{\rho \sigma e}\right) ^{t}\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ,
\end{eqnarray}%
which is worth emphasizing

\item 
\begin{gather}
S_{\rho \sigma e}\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \mathcal{R}_{e}\left( S_{\rho \sigma e}\right) \\
\Updownarrow \\
S_{\rho \sigma e}\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left\vert S_{\rho \sigma e}e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert S_{\rho \sigma e}e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\mathcal{R}_{e}\left( S_{\rho \sigma e}\right) ^{t}\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) .
\end{gather}

\begin{remark}
\underline{\textbf{Observe}}\textbf{\ that the action of the overlap
operator from the left on a column super vector producecs the \underline{%
\textbf{transpose}} representation. }
\end{remark}

\item The dualization mapping $d$ gives 
\begin{equation}
d\left( \left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) \right) =\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) .
\end{equation}

\item From the theorem \ref{Representation of Dual Operator} 
\begin{equation}
d\left( S_{\rho \sigma e}\right) \left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{d2r}%
\end{array}%
\right) =\mathcal{R}_{e_{d}}\left( d\left( S_{\rho \sigma e}\right) \right)
^{t}\left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{d2r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( S_{\rho \sigma e}\right) \left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{d2r}%
\end{array}%
\right) .
\end{equation}

\item 
\begin{equation}
d\left( 
\begin{array}{c}
\left\vert S_{\rho \sigma e}e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert eS_{\rho \sigma e2r}\right) _{\rho \sigma }%
\end{array}%
\right) =d\left( S_{\rho \sigma e}\right) d\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =d\left( S_{\rho \sigma e}\right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) =\mathcal{R}_{e_{d}}\left( d\left( S_{\rho \sigma e}\right) \right)
^{t}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) =\mathcal{R}_{e}\left( S_{\rho \sigma e}\right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho \sigma } \\ 
\vdots \\ 
\left( e_{2r}\right\vert _{\rho \sigma }%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\item The action of the inverse overlap operator is 
\begin{equation}
S_{\rho \sigma e}^{-1}\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert S_{\rho \sigma e}^{-1}e_{1}\right) _{\rho \sigma } & \cdots & 
\left\vert S_{\rho \sigma e}^{-1}e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \mathcal{R}_{e}\left( S_{\rho \sigma e}^{-1}\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) _{\rho \sigma } & \cdots & \left\vert e_{2r}\right)
_{\rho \sigma }%
\end{array}%
\right) \mathcal{R}_{e}\left( S_{\rho \sigma e}\right) ^{-1}
\end{equation}%
and gives%
\begin{equation}
S_{\rho \sigma e}^{-1}\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left\vert S_{\rho \sigma e}^{-1}e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert S_{\rho \sigma e}^{-1}e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) =\mathcal{R}_{e}\left( S_{\rho \sigma e}\right) ^{-t}\left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
\vdots \\ 
\left\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) .
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{b}_{\rho \sigma }\left( \left( 
\begin{array}{c}
\left\vert e_{1}\right) _{\rho \sigma } \\ 
