\begin{document}

\title{The Algebraic Foundations of Quantum Mechanics: From Vector Spaces to
Hilbert Spaces}
\author{Assistant}
\date{\today }

\begin{abstract}
This manuscript explores the fundamental mathematical structures underlying
quantum mechanics, demonstrating how Hilbert space structures emerge
naturally from complex vector spaces through tensor products with their
conjugate spaces. We show that the inner product, observables, and quantum
states can all be derived from purely algebraic constructions, suggesting
that the traditional Hilbert space formulation may be emergent rather than
fundamental.
\end{abstract}

\maketitle

\part{Hilbert Spaces}

\section{Hilbert Space Inner Product as a Linear Functional}

\subsection{The Riesz Representation Theorem}

\begin{remark}
The \textbf{Riesz Representation Theorem}, establishes that in a Hilbert
space $\mathcal{H}$, every continuous linear functional $\varphi :\mathcal{H}%
\rightarrow \mathbb{C}$ is uniquely represented by an inner product with a
specific vector i.e. for every continuous \emph{linear }functional $\varphi
\in \mathcal{H}^{d}$, there exists a unique vector $y_{\varphi }\in \mathcal{%
H}$ such that: 
\begin{equation}
\varphi (x)=\left\langle \left. y_{\varphi }\right\vert x\right\rangle _{%
\mathcal{H}}\quad \text{for all }x\in \mathcal{H}.
\end{equation}
\end{remark}

\section{Complex Conjugate Vector Spaces}

\subsection{Definition and Structure}

For any complex vector space $V$, its \textbf{complex conjugate space} $%
\overline{V}$ is defined as:

\begin{enumerate}
\item Same underlying set as $V$

\item Same vector addition: 
\begin{equation}
u+_{\overline{V}}v=u+_{V}v
\end{equation}

\item \emph{Conjugate scalar multiplication: }%
\begin{equation}
\alpha \cdot _{\overline{V}}v=\overline{\alpha }\cdot _{V}v
\end{equation}
i.e. scalar multiplication is anti linear.
\end{enumerate}

\section{Tensor Product Construction of Hilbert Space Inner Product}

The inner product map $\left\langle \left. \cdot \right\vert \cdot
\right\rangle _{\mathcal{H}}:\mathcal{H}\times \mathcal{H}\rightarrow 
\mathbb{C}$ is a sesquilinear map that can be expressed as a single linear
functional by packaging the two input vectors into the tensor product $%
\overline{\mathcal{H}}\otimes \mathcal{H}$, where $\overline{\mathcal{H}}$
denotes the conjugate Hilbert space.

Define a linear functional 
\begin{equation}
F:\overline{\mathcal{H}}\otimes \mathcal{H}\rightarrow \mathbb{C}
\end{equation}%
on simple tensors by: 
\begin{equation}
F(\overline{\overline{x}}\otimes y)=\left\langle \left. x\right\vert
y\right\rangle _{\mathcal{H}},
\end{equation}%
extended linearly to all of $\overline{\mathcal{H}}\otimes \mathcal{H}$,
where $\overline{\overline{x}}\in \overline{\mathcal{H}}$ and $\overline{%
\overline{x}}_{e}=\sigma _{e}\left( x\right) $ for some basis $\left( 
\boldsymbol{e}\right) $.

\begin{remark}
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=\sum_{1\leq
j\leq r}\overline{\mathcal{R}_{e}\left( x\right) }\mathcal{R}_{e}\left(
y\right) =\sum_{1\leq j\leq r}\mathcal{R}_{e}\left( \sigma _{e}\left(
x\right) \right) \mathcal{R}_{e}\left( y\right) =\sum_{1\leq j\leq r}%
\mathcal{R}_{f}\left( \sigma _{f}\left( x\right) \right) \mathcal{R}%
_{f}\left( y\right) ,
\end{equation}%
where $\left( \mathbf{e}\right) $ and $\left( \mathbf{f}\right) $ are conbs.
\end{remark}

\subsubsection{Change of Basis of Hilbert Spaces}

\begin{remark}
The change of bases $\left( \mathbf{f}\right) \rightarrow \left( \mathbf{e}%
\right) $ of Hilbert space $\mathcal{H}$ is produced by the unitary operator 
$S_{ef}\in \mathcal{B}\left( \mathcal{H}\right) $ 
\begin{equation}
S_{ef}:\left( \mathbf{f}\right) \rightarrow \left( \mathbf{e}\right) ,
\end{equation}%
given by the sum of partial isometries 
\begin{equation}
S_{ef}=\left\vert \boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}%
\right\vert =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle
f_{j}\right\vert .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
S_{ef}^{\dagger }S_{ef}=\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle
\left\langle e_{j}\right\vert \sum_{1\leq j\leq r}\left\vert
e_{j}\right\rangle \left\langle f_{j}\right\vert =I_{\mathcal{H}%
}=\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle
f_{j}\right\vert \sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle
\left\langle e_{j}\right\vert =S_{ef}S_{ef}^{\dagger }.
\end{equation}
\end{remark}

\subsubsection{Change of Hilbert Space Representations $\mathcal{R}%
_{f}\rightarrow \mathcal{R}_{e}.$}

\begin{remark}
\begin{enumerate}
\item The representations of vector are defined by 
\begin{equation}
v=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) .
\end{equation}

\item The change of vector representations are given by%
\begin{gather}
v=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle e_{1}\right\vert \\ 
\vdots \\ 
\left\langle e_{r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right)
\end{gather}%
hence

\item the transformation from $\mathcal{R}_{f}$ to the $\mathcal{R}_{e}$
representation is given by 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) .
\end{equation}

\item In a more abstract notation 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( f_{1}\right) & \cdots & e_{br}\left( f_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( f_{r}\right) & \cdots & e_{br}\left( f_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) _{r}%
\end{array}%
\right) .
\end{equation}

\item Examining the transformation $S_{ef}$ 
\begin{equation}
S_{ef}=\left\vert \boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}%
\right\vert =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle f_{1}\right\vert \\ 
\vdots \\ 
\left\langle f_{r}\right\vert%
\end{array}%
\right)
\end{equation}%
in more detail:

\begin{enumerate}
\item The action of $S_{ef}$ on the basis $\left( \boldsymbol{f}\right) $ is
given by 
\begin{gather}
\left\vert \boldsymbol{e}\right\rangle =S_{ef}\left\vert \boldsymbol{f}%
\right\rangle =\left\vert \boldsymbol{e}\right\rangle \left\langle 
\boldsymbol{f}\right\vert \left\vert \boldsymbol{f}\right\rangle \\
\parallel \\
\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle f_{1}\right\vert \\ 
\vdots \\ 
\left\langle f_{r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. f_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. f_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) .
\end{gather}

\item The representation $\mathcal{R}_{e}\left( S_{ef}\right) $ of $S_{ef}$
wrt the basis $\left( \boldsymbol{e}\right) $ is given by%
\begin{gather}
S_{ef}\left\vert \boldsymbol{e}\right\rangle =S_{ef}^{2}\left\vert 
\boldsymbol{f}\right\rangle =\left\vert \boldsymbol{e}\right\rangle
\left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{e}%
\right\rangle \left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{f%
}\right\rangle =\left\vert \boldsymbol{e}\right\rangle \left\langle 
\boldsymbol{f}\right\vert \left\vert \boldsymbol{e}\right\rangle =\left\vert 
\boldsymbol{e}\right\rangle \mathcal{R}_{e}\left( S_{ef}\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle f_{1}\right\vert \\ 
\vdots \\ 
\left\langle f_{r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. f_{r}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right) \\
\Updownarrow \\
\left\langle \boldsymbol{e}\right\vert S_{ef}\left\vert \boldsymbol{e}%
\right\rangle =\left\langle \boldsymbol{e}\right\vert \left\vert \boldsymbol{%
e}\right\rangle \left\langle \boldsymbol{f}\right\vert \left\vert 
\boldsymbol{e}\right\rangle =\left\langle \boldsymbol{f}\right\vert
\left\vert \boldsymbol{e}\right\rangle =\left\langle \boldsymbol{e}%
\right\vert \left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left(
S_{ef}\right) =\mathcal{R}_{e}\left( S_{ef}\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( S_{ef}\right) =\left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. f_{r}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right) .
\end{equation}

\item The representation $\mathcal{R}_{f}\left( S_{ef}\right) $ of $S_{ef}$
wrt the basis $\left( \boldsymbol{f}\right) $ is given by%
\begin{gather}
S_{ef}\left\vert \boldsymbol{f}\right\rangle =\left\vert \boldsymbol{f}%
\right\rangle \mathcal{R}_{f}\left( S_{ef}\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle f_{1}\right\vert \\ 
\vdots \\ 
\left\langle f_{r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{f}\left( S_{ef}\right) _{11} & \cdots & \mathcal{R}_{f}\left(
S_{ef}\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f}\left( S_{ef}\right) _{r1} & \cdots & \mathcal{R}_{f}\left(
S_{ef}\right) _{rr}%
\end{array}%
\right) \\
\Updownarrow \\
\left\langle \boldsymbol{f}\right\vert S_{ef}\left\vert \boldsymbol{f}%
\right\rangle =\left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{%
e}\right\rangle \left\langle \boldsymbol{f}\right\vert \left\vert 
\boldsymbol{f}\right\rangle =\left\langle \boldsymbol{f}\right\vert
\left\vert \boldsymbol{e}\right\rangle =\mathcal{R}_{f}\left( S_{ef}\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{f}\left( S_{ef}\right) =\left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. f_{r}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right) .
\end{equation}%
Hence

\item 
\begin{equation}
\mathcal{R}_{e}\left( S_{ef}\right) =\mathcal{R}_{f}\left( S_{ef}\right)
=\left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{e}%
\right\rangle
\end{equation}

\item This equality originates from the equality of the representations of
the identity i.e. 
\begin{gather}
\left\vert \boldsymbol{e}\right\rangle =\left\vert \boldsymbol{e}%
\right\rangle \mathbb{I}_{r}=\left\vert \boldsymbol{e}\right\rangle \mathcal{%
R}_{e}\left( I_{r}\right) =I_{r}\left\vert \boldsymbol{e}\right\rangle \\
\parallel \\
\left( \overset{}{\left\vert \boldsymbol{e}\right\rangle =\left\vert 
\boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}\right\vert
\left\vert \boldsymbol{f}\right\rangle =\left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{e%
}\right\rangle }\right) \equiv \left( \overset{}{S_{ef}\left\vert 
\boldsymbol{f}\right\rangle =\left\vert \boldsymbol{e}\right\rangle
\left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{f}%
\right\rangle =\left\vert \boldsymbol{f}\right\rangle \mathcal{R}_{f}\left(
S_{ef}\right) }\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle f_{1}\right\vert \\ 
\vdots \\ 
\left\langle f_{r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. f_{r}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert f_{1}\right\rangle & \cdots & \left\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle f_{1}\right\vert \\ 
\vdots \\ 
\left\langle f_{r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}%
\right) .
\end{gather}
\end{enumerate}
\end{enumerate}
\end{remark}

\subsection{Hilbert Space Conjugations}

\begin{remark}
Conjugations from different equivalence classes produce different $\overline{%
\overline{x}}=\sigma _{e}\left( x\right) ,$ but $\left\langle x\right\vert
\equiv \left\langle \left. x\right\vert \cdot \right\rangle _{\mathcal{H}%
}=\digamma \left( \left\vert x\right\rangle \right) \in \mathcal{H}^{d},$
where%
\begin{equation}
\digamma :\mathcal{H\rightarrow H}^{d}
\end{equation}%
\emph{is unique}.
\end{remark}

\begin{remark}
This construction successfully expresses the inner product as: 
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=F(\overline{%
\overline{x}}\otimes y)=F(\sigma _{e}\left( x\right) \otimes y)=F(\digamma
\left( x\right) \otimes y).
\end{equation}
\end{remark}

\begin{remark}
For \emph{every basis} $\left( \boldsymbol{e}\right) $%
\begin{eqnarray}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}
&=&\left\langle \left. x\right\vert I_{\mathcal{H}}y\right\rangle _{\mathcal{%
H}}=\left\langle \left. \overset{\overset{}{}}{x}\right\vert \sum_{1\leq
k\leq r}\left\vert e_{k}\right\rangle \left\langle e_{k}\right\vert
y\right\rangle _{\mathcal{H}}=\sum_{1\leq k\leq r}\left\langle \left.
x\right\vert e_{k}\right\rangle _{\mathcal{H}}\left\langle \left.
e_{k}\right\vert y\right\rangle _{\mathcal{H}}=\sum_{1\leq k\leq r}\overline{%
\left\langle \left. e_{k}\right\vert x\right\rangle }_{\mathcal{H}%
}\left\langle \left. e_{k}\right\vert y\right\rangle _{\mathcal{H}} \\
&=&\sum_{1\leq k\leq r}\overline{\mathcal{R}_{e}\left( x\right) _{k}}%
\mathcal{R}_{e}\left( y\right) _{k}=\sum_{1\leq k\leq r}\mathcal{R}%
_{e}\left( \sigma _{e}\left( x\right) \right) _{k}\mathcal{R}_{e}\left(
y\right) _{k}=F(\sigma _{e}\left( x\right) \otimes y)
\end{eqnarray}%
thus one can choose any $\sigma _{e}$ and thus $\overline{\overline{x}}%
_{e}=\sigma _{e}\left( x\right) $ produces the same $\left\langle
x\right\vert $ i.e. 
\begin{equation}
\sigma :\mathfrak{B}\left( \mathcal{H}\right) \times \mathcal{H}\rightarrow 
\overline{\mathcal{H}}
\end{equation}%
and%
\begin{equation}
\sigma _{e}\left( x\right) =\sigma \left( \left( \overset{}{\boldsymbol{e}}%
\right) ,\left\vert \overset{}{x}\right\rangle \right) =\sigma _{f}\left(
x\right) =\sigma \left( \left( \overset{}{\boldsymbol{f}}\right) ,\left\vert 
\overset{}{x}\right\rangle \right) =\left\langle x\right\vert
\end{equation}%
hence%
\begin{equation}
\ker \left\{ \sigma \right\} =\left\{ \sigma _{e}\left( x\right) -\sigma
_{f}\left( x\right) \right\} \times \left\vert x\right\rangle ,\,\left( 
\boldsymbol{e}\right) ,\left( \boldsymbol{f}\right) \in \mathfrak{B}\left( 
\mathcal{H}\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=\left( \left.
\sigma _{e}\left( x\right) \right\vert y\right) =\left( \left. y\right\vert
\sigma _{e}\left( x\right) \right) .
\end{equation}
\end{remark}

\subsection{Dirac Bra-Ket Notation}

\begin{itemize}
\item Vectors $y\in \mathcal{H}$ are%
\begin{equation}
\emph{\ kets}:|y\rangle
\end{equation}

\item Continuous linear functionals on $\mathcal{H}$ are 
\begin{equation}
\emph{bras}:\langle \varphi |
\end{equation}

\item The inner product is 
\begin{equation}
\langle x|y\rangle =\left\langle \left. x\right\vert y\right\rangle _{%
\mathcal{H}}
\end{equation}

\item The operator $|x\rangle \langle y|$ corresponds to the tensor product 
\begin{equation}
x\otimes \overline{y}\in \mathcal{H}\otimes \overline{\mathcal{H}},
\end{equation}%
by $\Xi _{\mathcal{H}\overline{\mathcal{H}}}\in \mathcal{L}\left( \mathcal{B}%
\left( \mathcal{H}\right) ,\mathcal{H}\otimes \overline{\mathcal{H}}\right) $
\begin{equation}
\Xi _{\mathcal{H}\overline{\mathcal{H}}}:\mathcal{H\otimes \overline{%
\mathcal{H}}\rightarrow L}\left( \mathcal{H}\right)
\end{equation}

given by 
\begin{equation}
\Xi _{\mathcal{H}\overline{\mathcal{H}}}\left( \overline{x}\otimes \overline{%
y}\right) =|x\rangle \langle y|.
\end{equation}
\end{itemize}

\subsection{Key Mathematical Properties of Conjugate Spaces}

While $V$ and $\overline{V}$ share the same dimension and are isomorphic as
real vector spaces, they \emph{differ fundamentally} as complex vector
spaces:

\begin{itemize}
\item The identity map $\text{id}:V\rightarrow \overline{V}$ is \emph{%
conjugate-linear}, not $\mathbb{C}$-linear

\item Natural conjugate-linear isomorphism: $V^{d}\cong V^{\sigma _{e}},$
note that a complex conjugate space $V^{\sigma _{e}}$ \emph{is not} a
complex vector space as

\begin{itemize}
\item $\left\{ \sigma _{e}\right\} $ are complex conjugations defined in $V$
associated with bases $\left( \mathbf{e}\right) $ off $V,$ a complex
cojugation of the vector space $V$ is given by 
\begin{equation}
V^{\sigma _{e}}=\sigma _{e}\left( V\right) .
\end{equation}

\item $V^{\sigma _{e}}$ is \emph{not} a complex cojugate space as it is
complex linear.
\end{itemize}

\item Tensor product behavior: $\overline{V}\otimes W\cong \overline{%
V\otimes \overline{W}}$

\item Functorial properties make this an involutive functor on the category
of complex vector spaces
\end{itemize}

\subsection{Isomorphism Conditions of Conjugate Spaces}

$V\cong \overline{V}$ as complex vector spaces if and only if there exists a
conjugate-linear automorphism $\mathcal{J}:V\rightarrow V$ with $\mathcal{J}%
^{2}=\,$id. Important cases include:

\begin{itemize}
\item Real vector spaces (trivial complex structure)

\item The Canonical Complexifications of real spaces: 
\begin{equation}
V_{\mathbb{C}}=W\otimes _{\mathbb{R}}\mathbb{C}=W\otimes _{\mathbb{R}%
}\left\{ 1,i\right\} =W\oplus _{\mathbb{R}}iW.
\end{equation}

\item All Hilbert spaces (via Riesz representation)\thinspace .
\end{itemize}

\part{General Vector Spaces \label{GENERAL VECTOR SPACES}}

\section{Dual Tensors $\mathfrak{b}\in V^{d}\otimes V^{d}$}

\subsection{Dual Spaces}

\begin{definition}
Let $V$ be a $\mathbb{F}$-vector space then its dual $V^{d}$ is the space of 
$\mathbb{F}$-linear functionals defined on $V$ i.e. 
\begin{equation}
V^{d}=\mathbb{F}\text{-}\func{linspan}\left\{ \left. f\right\vert f\left(
z_{1}v_{1}+z_{2}v_{2}\right) =z_{1}f\left( v_{1}\right) +z_{2}f\left(
v_{2}\right) ,\,\,f\left( v\right) \in \mathbb{F},\,z_{1},z_{2}\in \mathbb{F}%
,\,\,\forall v,v_{1},v_{2}\in V\right\} .
\end{equation}
\end{definition}

\begin{remark}
In infinite dimensions linear functionals can be unbounded $\equiv $
discontinuous wrt topologies placed on $V$ then continuous linear functional
form a subset of all linear functionals defined on $V.$
\end{remark}

\begin{notation}
Often we will denote elements of a dual space by a subscript $"d"$ i.e. $%
v_{d}\in V^{d}$ and $v_{dd}\in V^{dd}.$
\end{notation}

\begin{definition}
Let $\left( \boldsymbol{e}\right) =\left\{ \left. e_{j}\right\vert 1\leq
j\leq r\right\} $ be a basis of $V$ then one can define a set of
biorthogonal linear functionals $\left\{ \left. e_{bj}\in V^{d}\right\vert
1\leq j\leq r\right\} $ that in general span \emph{a subspace} of $V^{d}$ by 
\begin{equation}
e_{bj}\left( e_{k}\right) =\delta _{jk},\,1\leq j\leq r,
\end{equation}%
i.e. 
\begin{equation}
\left[ \overset{}{\left( \boldsymbol{e}_{b}\right) }\right] \left( \overset{}%
{\boldsymbol{e}_{b}}\right) ^{t}=\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( e_{1}\right) & \cdots & e_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( e_{1}\right) & \cdots & e_{br}\left( e_{r}\right)%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}
\end{definition}

\begin{notation}
\begin{enumerate}
\item Evaluation%
\begin{equation}
\left[ w_{d}\right] \left( v\right) =w_{d}\left( v\right) .
\end{equation}

\item Tensor product 
\begin{equation}
\left( w_{d}\right) \left( v\right) =w_{d}\otimes v.
\end{equation}
\end{enumerate}
\end{notation}

\subsection{Transpose \label{Transpose}}

\begin{definition}
The transpose $A^{t}\in \mathcal{L}\left( V^{d}\right) $ of an operator $%
A\in \mathcal{L}\left( V\right) $ is defined by%
\begin{equation}
A^{t}\circ l_{d}=l_{d}\circ A\quad \forall l_{d}\in V^{d}
\end{equation}%
i.e. the transpose $A^{t}$ is the induced \emph{dual transformation} $%
d\left( A\right) $ of $A$ 
\begin{equation}
d\left( A\right) l_{d}\left( v\right) =A^{t}l_{d}\left( v\right)
=l_{d}\left( Av\right) ,\quad \forall v\in V,\quad \text{ }\forall l_{d}\in
V^{d},
\end{equation}%
where the linear dualizing map $d\in \mathcal{L}\left( \overset{}{\mathcal{L}%
\left( V^{d}\right) ,\mathcal{L}\left( V\right) }\right) .$
\end{definition}

\begin{definition}
\label{General Transpose Definition} One can generalize this definition to $%
d\in \mathcal{L}\left( \overset{}{\mathcal{L}\left( V^{d},W^{d}\right) ,%
\mathcal{L}\left( W,V\right) }\right) ,$ consider $A\in \mathcal{L}\left(
W,V\right) ,$ i.e. 
\begin{equation}
A:V\rightarrow W
\end{equation}%
then the action of the induced dual map $d\left( A\right) \equiv A^{t}\in $ $%
\mathcal{L}\left( V^{d},W^{d}\right) $ is in the opposite direction i.e. 
\begin{equation}
d\left( A\right) :W^{d}\rightarrow V^{d}
\end{equation}%
is defined by 
\begin{equation}
\left[ d\left( A\right) f_{w}\right] \left( v\right) =f_{w}\left( Av\right)
,\;\forall v\in V,
\end{equation}%
i.e. 
\begin{equation}
f_{V}=\left[ d\left( A\right) f_{w}\right] ,
\end{equation}%
where $f_{w}\in W^{d}$ and $f_{V}\in V^{d}.$
\end{definition}

One can recast this definition in dyadic form by

\begin{definition}
\label{General Transpose Definition in Dyadic Form} Consider the general
mapping $A\in \mathcal{L}\left( W,V\right) $ that can be be expressed in
dyadic form as 
\begin{equation}
A=\sum_{1\leq j\leq r}w_{j}\left[ v_{dj}\right]
\end{equation}%
then its \textbf{transpose} $A^{t}\in \mathcal{L}\left( V^{d},W^{d}\right) $
is%
\begin{equation}
A^{t}=\sum_{1\leq j\leq r}v_{dj}\left[ d_{2}\left( w_{j}\right) \right] ,
\end{equation}%
where $d_{2}$ is the embedding map o $V$ into $V^{dd}.$
\end{definition}

\begin{remark}
A linear functional $l_{d}\in V^{d}$

\begin{enumerate}
\item Can be expressed in terms of a dual biorthogonal basis $\left( 
\boldsymbol{e}_{b}\right) $ to $\left( \boldsymbol{e}\right) $ by 
\begin{equation}
l_{d}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\mathcal{R}_{e_{b}}\left( l_{d}\right) ^{t}\left[ \overset{}%
{\left( \boldsymbol{e}_{b}\right) }\right]
\end{equation}%
that acts on vectors $v\in V$ by 
\begin{eqnarray}
l_{d}\left( v\right) &=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \overset{}{v}\right) \\
&=&\left( 
\begin{array}{ccc}
e_{bb1}\left( l_{d}\right) & \cdots & e_{bbr}\left( l_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1}\left( v\right) \\ 
\vdots \\ 
e_{br}\left( v\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) ,
\end{eqnarray}%
where 
%TCIMACRO{\hyperref{Double Dual}{}{}{#Double Dual} }%
%BeginExpansion
\msihyperref{Double Dual}{}{}{#Double Dual}
%EndExpansion
$\left( \boldsymbol{e}_{bb}\right) $ of the basis $\left( \boldsymbol{e}%
\right) $ is given by the injection $\iota _{V^{dd}V}\equiv d_{2}$ 
\begin{equation}
e_{bbj}=d_{2}\left( e_{j}\right) =\iota _{V^{dd}V}\left( e_{j}\right)
;\;1\leq j\leq r
\end{equation}%
and

\item is non degenerate i.e. 
\begin{equation}
l_{d}\left( v\right) =0\quad \forall v\in V\Leftrightarrow l_{d}=0.
\end{equation}

\item The bases $\left( \boldsymbol{e}_{bb}\right) ,\left( \boldsymbol{e}%
_{b}\right) $ and $\left( \boldsymbol{e}\right) $ are biorthogonal. The
details of biorthogonalization are analyzed in detail in the section 
%TCIMACRO{\hyperref{biorthogonalization}{}{}{#Biorthogonalizing Maps}}%
%BeginExpansion
\msihyperref{biorthogonalization}{}{}{#Biorthogonalizing Maps}%
%EndExpansion
.
\end{enumerate}
\end{remark}

\begin{definition}
Biorthogonalization maps $b_{e}\in \limfunc{Map}\left( \mathfrak{B}\left(
V^{d}\right) ,\mathfrak{B}\left( V\right) \right) $ 
\begin{equation}
b_{e}:\mathfrak{B}\left( V\right) \rightarrow \mathfrak{B}\left( V^{d}\right)
\end{equation}%
by 
\begin{equation}
\left( \boldsymbol{e}_{b}\right) =b_{e}\left\{ \left( \boldsymbol{e}\right)
\right\} .
\end{equation}%
See details of their construction at 
%TCIMACRO{\hyperref{Biorthogonalization Maps}{}{}{#Biorthogonalizing Maps} }%
%BeginExpansion
\msihyperref{Biorthogonalization Maps}{}{}{#Biorthogonalizing Maps}
%EndExpansion
and 
%TCIMACRO{%
%\hyperref{Construction of a Biorthogonal Basis}{}{}{#Construction of a Biorthogonal Basis}}%
%BeginExpansion
\msihyperref{Construction of a Biorthogonal Basis}{}{}{#Construction of a Biorthogonal Basis}%
%EndExpansion
.
\end{definition}

\begin{notation}
\begin{equation}
\left( \boldsymbol{e}_{b}\right) =\left( \boldsymbol{e}_{b_{e}}\right)
=b_{e}\left( \boldsymbol{e}\right) .
\end{equation}
\end{notation}

\begin{remark}
The following emphasizes the action of linear functionals in terms of basis
expansions by 
\begin{eqnarray}
l_{d}\left( v\right) &=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\mathcal{R}_{e_{b}}\left( l_{d}\right) ^{t}\mathcal{R}_{e}\left(
v\right) .
\end{eqnarray}
\end{remark}

\begin{notation}
$\left( \boldsymbol{e}_{bb}\right) $ is a basis of the subspace $\iota
_{V^{dd}V}\left\{ V\right\} \subseteq V^{dd}$ that is biorthogonal to the
basis $\left( \boldsymbol{e}_{b}\right) $ of the subspace $\iota
_{V^{d}V}\left\{ V\right\} \subseteq V^{d}$ that itself is biorthogonal to
the basis $\left( \boldsymbol{e}\right) $ $V.$
\end{notation}

\begin{theorem}
Let the operator $A\in \mathcal{L}\left( V\right) $ then it can be expressed
by the dyadic expansion 
\begin{equation}
A=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}\left[ f_{dj}\right] .
\end{equation}%
Its transpose $d\left( A\right) =A^{t}\in \mathcal{L}\left( V^{d}\right) $
defined by the dualizing map $d\in \mathcal{L}\left( \mathcal{L}\left(
V^{d}\right) ,\mathcal{L}\left( V\right) \right) $ 
\begin{equation}
d\left( A\right) \circ l_{d}=l_{d}\circ A
\end{equation}%
is equal to its transpose $A^{t}$ defined by the dyadic expansion 
\begin{equation}
A^{t}=\sum_{1\leq j\leq r}v_{dj}\left[ d_{2}\left( w_{j}\right) \right] ,
\end{equation}
i.e. 
\begin{equation}
d\left( A\right) =A^{t}=\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}f_{dj}\left[ d_{2}\left( e_{j}\right) %
\right]
\end{equation}%
i.e. 
\begin{equation}
\left( \sum_{1\leq j\leq r}e_{j}\left[ f_{dj}\right] \right)
^{t}=\sum_{1\leq j\leq r}f_{dj}\left[ d_{2}\left( e_{j}\right) \right] .
\end{equation}
\end{theorem}

\begin{notation}
Vectors with subscripts $"b"$are vectors in the dual spaces produced from
vectors in $V$ via $b_{e}$ maps, vectors with subscripts $"d"$ are any
vectors in the dual spaces. Vectors with subscripts $d_{e}$ are the same as
vectors with subscripts $b_{e}$ i.e. $d_{e}=b_{e},$ and depend on the basis
used in their definition$.$ Vectors produced by the double dual imbedding do
not depend on bases.
\end{notation}

\begin{proof}
Consider linear functionals given by 
\begin{equation}
l_{d}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right)
\end{equation}%
then \label{12/17/2025}%
\begin{gather*}
l_{d}\circ A=l_{d}\circ \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right) \\
=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( l_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( l_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( l_{d}\right) & \cdots & e_{bbr}\left( l_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right)
\end{gather*}%
and 
\begin{gather}
A^{t}\circ l_{d}=\left( \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right) \left( \overset{}{l_{d}}\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{bb1}\left( l_{d}\right) \\ 
\vdots \\ 
e_{bbr}\left( l_{d}\right)%
\end{array}%
\right) \\
=l_{d}\circ \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right) .
\end{gather}%
Thus 
\begin{equation}
A^{t}=\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right]
\end{equation}%
when 
\begin{equation}
A=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] .\blacksquare
\end{equation}
\end{proof}

\section{Biorthogonal Basis}

\subsection{Construction of a Biorthogonal Basis to $\left( \boldsymbol{e}%
\right) $ \label{Construction of a Biorthogonal Basis}}

\begin{remark}
Biorthogonal basis: Let $\left( \boldsymbol{f}_{d}\right) $ be \textbf{any}
basis of $V^{d}$ then the \emph{overlap matrix} between $\left( \boldsymbol{f%
}_{d}\right) $ and $\left( \boldsymbol{e}\right) $ is 
\begin{equation}
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) =\left( \boldsymbol{f}%
_{d}\right) ^{t}\left( \boldsymbol{e}\right) =\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ,
\end{equation}%
which can be used to produce a \textbf{biorthogonal basis} $\left( 
\boldsymbol{e}_{b}\right) $ to $\left( \boldsymbol{e}\right) $ expressed in
terms of the basis $\left( \boldsymbol{f}_{d}\right) $ by defining 
\begin{equation}
\left( \overset{}{\boldsymbol{e}_{b}}\right) =\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \equiv \left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}%
\right) }\right) ^{-1}\left( \overset{}{\boldsymbol{f}_{d}}\right) ,
\end{equation}%
that has the property 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cccc}
1 & 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & 1%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}%
This shows that $\left( \boldsymbol{e}_{b}\right) $ is indeed biorthogonal
to $\left( \boldsymbol{e}\right) $ i.e. 
\begin{gather}
\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{gather}%
Hence 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{e}_{b}\right) ^{t}=\left( \boldsymbol{f}_{d}\right)
^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }%
\right) ^{-t}.
\end{equation}
\end{remark}

\begin{notation}
Recall that the subscript $"d"$ means that $x_{d}\in V^{d},$ while the
subscript $"d_{e}"$ in $x_{d_{e}}$ is \textbf{the result} of the dualizing
map $d_{e}\in \mathcal{L}\left( V^{d},V\right) $ acting on $x.$ The
subscript $"b"$ in $\left( \boldsymbol{e}_{b}\right) $ means $"b_{e}"$ i.e. $%
\left( \boldsymbol{e}_{b}\right) =$ $\left( \boldsymbol{e}_{b_{e}}\right) .$
In general $\left( \boldsymbol{e}_{b_{e}}\right) \neq \left( \boldsymbol{e}%
_{b_{f}}\right) $ i.e. biorthogonalization is always wrt to a given basis$.$ 
%TCIMACRO{%
%\hyperref{Analysis of Biorthogonalizing Maps. $\ $}{}{}{#Biorthogonalizing Maps}}%
%BeginExpansion
\msihyperref{Analysis of Biorthogonalizing Maps. $\ $}{}{}{#Biorthogonalizing Maps}%
%EndExpansion
\end{notation}

\subsection{Basis Transformation of Dual Space}

\begin{remark}
The basis transformation of the dual space map $S_{e_{b}f_{d}}\in \mathcal{L}%
\left( V^{d}\right) $%
\begin{equation}
S_{e_{b}f_{d}}:\left( \boldsymbol{f}_{d}\right) ^{t}\rightarrow \left( 
\boldsymbol{e}_{b}\right) ^{t},
\end{equation}%
i.e. 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =S_{e_{b}f_{d}}\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
S_{e_{b}f_{d}}f_{d1} & \cdots & S_{e_{b}f_{d}}f_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) ,
\end{equation}%
is expressed by 
\begin{equation}
\left( \boldsymbol{e}_{b}\right) ^{t}=S_{e_{b}f_{d}}\left( \boldsymbol{f}%
_{d}\right) ^{t}=\left( \boldsymbol{f}_{d}\right) ^{t}\mathcal{R}%
_{f_{d}}\left( S_{e_{b}f_{d}}\right) .
\end{equation}%
Hence the basis transformation $S_{e_{b}f_{d}}$ can be expressed in dyadic
form as 
\begin{equation}
S_{e_{b}f_{d}}=\left( \boldsymbol{e}_{b}\right) ^{t}\left[ \left( 
\boldsymbol{f}_{bd}\right) \right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{bd1} \\ 
\vdots \\ 
f_{bdr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{bj}\left[ f_{bdj}\right]
\end{equation}%
and its represenation wrt the $\left( \boldsymbol{f}_{d}\right) $ basis is
given by 
\begin{equation}
\mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) =\left[ \left( 
\begin{array}{c}
f_{bd1} \\ 
\vdots \\ 
f_{bdr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{bd1}\left( e_{b1}\right) & \cdots & f_{bd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{bdr}\left( e_{b1}\right) & \cdots & f_{bdr}\left( e_{br}\right)%
\end{array}%
\right) ,
\end{equation}%
which is confirmed by 
\begin{eqnarray}
\mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) &=&\left[ \left( 
\begin{array}{c}
f_{bd1} \\ 
\vdots \\ 
f_{bdr}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{bd1} \\ 
\vdots \\ 
f_{bdr}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \\
&=&\left[ \left( 
\begin{array}{c}
f_{bd1} \\ 
\vdots \\ 
f_{bdr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{bd1}\left( e_{b1}\right) & \cdots & f_{bd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{bdr}\left( e_{b1}\right) & \cdots & f_{bdr}\left( e_{br}\right)%
\end{array}%
\right) ,
\end{eqnarray}%
where $f_{bdj}\in V^{dd},\quad 1\leq j\leq r$ and $\left( \boldsymbol{f}%
_{bd}\right) $ is a basis of $V^{dd}$ biorthogonal to $\left( \boldsymbol{f}%
_{d}\right) .$
\end{remark}

\begin{remark}
On the other hand 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =S_{e_{b}f_{d}}\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right)
\end{equation}%
gives 
\begin{gather}
\mathbb{I}_{r}=\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] S_{e_{b}f_{d}}\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) \\
=\left( 
\begin{array}{ccc}
e_{bb1}\left( f_{d1}\right) & \cdots & e_{bb1}\left( f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( f_{d1}\right) & \cdots & e_{bbr}\left( f_{dr}\right)%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) ,
\end{gather}%
which shows that the $\mathcal{R}_{f_{d}}$ representation of the basis
transformation map is 
\begin{equation}
\mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( f_{d1}\right) & \cdots & e_{bb1}\left( f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( f_{d1}\right) & \cdots & e_{bbr}\left( f_{dr}\right)%
\end{array}%
\right) ^{=1}=\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}.
\end{equation}
\end{remark}

\begin{remark}
This can also be seen by 
\begin{gather}
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \\
\parallel \\
S_{e_{b}f_{d}}\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) =\left( \boldsymbol{e}_{b}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{bd}\right) \right] \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( \overset{}{\left( \boldsymbol{e}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{f}_{bd}\right) \right] }\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}
\end{gather}%
and hence%
\begin{equation}
\mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) =\mathcal{R}_{f_{d}}\left( 
\overset{}{\left( \boldsymbol{e}_{b}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{bd}\right) \right] }\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}=\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) ^{-t},
\end{equation}%
which confirms the previous results which can summerized in the following
lemma
\end{remark}

\begin{lemma}
\begin{equation}
\mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) =\mathcal{R}_{f_{d}}\left( 
\overset{}{\left( \boldsymbol{e}_{b}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{bd}\right) \right] }\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}=\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) ^{-t}.
\end{equation}
\end{lemma}

\begin{remark}
The inverse tranformation $S_{e_{b}f_{d}}^{-1}$ $=S_{f_{d}e_{b}}$ (the
subscript $f_{d}e_{b}$ is reversed to $e_{b}f_{d})$ is given by 
\begin{gather}
\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) =S_{e_{b}f_{d}}^{-1}\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =S_{f_{d}e_{b}}\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{t} \\
=\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( S_{f_{d}e_{b}}\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( S_{e_{b}f_{d}}^{-1}\right)
\end{gather}%
leading to 
\begin{equation}
\mathcal{R}_{e_{b}}\left( S_{f_{d}e_{b}}\right) =\mathcal{R}_{e_{b}}\left(
S_{e_{b}f_{d}}^{-1}\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{t}=\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) ^{t}
\end{equation}%
and 
\begin{equation}
S_{f_{d}e_{b}}=\left( \boldsymbol{f}_{d}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{bb}\right) \right] =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}f_{dj}\left[ e_{bbj}\right] .
\end{equation}%
This is confirmed by 
\begin{eqnarray}
\mathcal{R}_{e_{b}}\left( S_{f_{d}e_{b}}\right) &=&\mathcal{R}_{e_{b}}\left(
S_{e_{b}f_{d}}^{-1}\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e_{bb1}\left( f_{d1}\right) & \cdots & e_{bb1}\left( f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( f_{d1}\right) & \cdots & e_{bbr}\left( f_{dr}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{d1}\left( e_{r}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{t}.
\end{eqnarray}
\end{remark}

\subsection{Resolutions of The Identity}

\begin{remark}
Resolutions of the Identity $I_{V}$ are given by 
\begin{equation}
\left( \overset{}{\boldsymbol{e}}\right) ^{t}\left[ \overset{}{\left( 
\boldsymbol{e}_{b}\right) }\right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] =I_{V}
\end{equation}%
$\left( \text{noting that }b\equiv b_{e}\right) $ as 
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) =\sum_{1\leq j\leq
r}e_{j}\left( \overset{}{e_{bj}\left( v\right) }\right)
\end{equation}%
and 
\begin{equation}
\left( \sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] \right) \left( \overset{%
}{v}\right) =\sum_{1\leq j\leq r}e_{j}\left( \overset{}{e_{bj}\left(
v\right) }\right) =\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right)
\end{equation}%
thus 
\begin{equation}
\left( \sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] \right) \left( \overset{%
}{v}\right) =v,\quad \forall v\in V.
\end{equation}
\end{remark}

\begin{remark}
Analogously a Resolution of the Identity $I_{V^{d}}$ is given by 
\begin{equation}
\left( \overset{}{\boldsymbol{e}_{b}}\right) ^{t}\left[ \overset{}{\left( 
\boldsymbol{e}_{bb}\right) }\right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{bj}\left[ e_{bbj}\right] =I_{V^{d}}.
\end{equation}
\end{remark}

\begin{definition}
of $S_{e_{d}f_{d}}\in \mathcal{L}\left( V^{d}\right) $ of transformations of
dual space bases from $\left( \boldsymbol{f}_{d}\right) $ to $\left( 
\boldsymbol{e}_{d}\right) $ by 
\begin{equation}
\left( \boldsymbol{e}_{d}\right) ^{t}=\left( \overset{}{S_{e_{d}f_{d}}}%
\right) \left( \boldsymbol{f}_{d}\right) ^{t}=\left( \boldsymbol{f}%
_{d}\right) ^{t}\mathcal{R}_{f_{d}}\left( S_{e_{d}f_{d}}\right) .
\end{equation}
\end{definition}

\begin{remark}
In particular the transformation from the basis $\left( \boldsymbol{f}%
_{d}\right) $ of $V^{d}$ to the biorthogonal bases $\left( \boldsymbol{e}%
_{b}\right) $ of $V^{d}$ to the basis $\left( \boldsymbol{e}\right) $ of $V$ 
\begin{gather}
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}=\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right] \right) ^{-t} \\
\parallel \\
\left( \boldsymbol{e}_{b}\right) ^{t}=S_{e_{b}f_{d}}\left( \boldsymbol{f}%
_{d}\right) ^{t}=\left( \boldsymbol{f}_{d}\right) ^{t}\mathcal{R}%
_{f_{d}}\left( S_{e_{b}f_{d}}\right) ,
\end{gather}%
so 
\begin{equation}
\mathcal{R}_{f_{d}}\left( S_{e_{b}f_{d}}\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}=\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}%
\right) }\right) ^{-t}.
\end{equation}
\end{remark}

\subsection{Biorthogonalizing Maps $b_{e}$ \label{Biorthogonalizing Maps}}

\begin{remark}
\label{Forms of Basis Transfformation Maps} Recall

\begin{enumerate}
\item 
\begin{enumerate}
\item The basis transformation map $S_{ef}\in \mathcal{L}\left( V\right) $
from $\left( \boldsymbol{f}\right) $ to $\left( \boldsymbol{e}\right) $ can
be expressed, while emphasizing its matrix, as 
\begin{gather}
S_{ef}=\sum_{1\leq j\leq r}e_{j}\left[ f_{bj}\right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \\
\Downarrow \\
\mathcal{M}_{f}\left( S_{ef}\right) =\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) .
\end{gather}%
This gives 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right)
\end{equation}

\item The basis transformation $S_{ef}$ map $S_{ef}\in \mathcal{L}\left(
V\right) $ can be expressed, while emphasizing its matrix represenation, as 
\begin{gather}
S_{ef}\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( S_{ef}\right) \\
\Downarrow \\
\mathcal{M}_{f}\left( S_{ef}\right) =\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] S_{ef}\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( S_{ef}\right) =\mathcal{R}_{f}\left(
S_{ef}\right) \\
\parallel \\
\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right)
\end{gather}%
This gives 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right)
\end{equation}

\item The basis transformation $S_{ef}$ can be expressed using resolutions
of the identity 
\begin{equation}
I_{V}=\sum_{1\leq j\leq r}f_{j}\left[ f_{bj}\right] .
\end{equation}%
as%
\begin{equation}
S_{ef}\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( S_{ef}\right) =\left( \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) .
\end{equation}%
This gives the transformation of basis 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( S_{ef}\right)
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
f_{1} \\ 
\vdots \\ 
f_{r}%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\item The inverse transformation $S_{ef}^{-1}=S_{fe}$ is obtained by
interchanging $f$ and $e.$
\end{enumerate}
\end{remark}

\subparagraph{Construction of Biorthogonalization Maps $b_{e}$}

\begin{definition}
Biorthogonalizing maps $b_{e}\in \mathcal{L}\left( V^{d},V\right) ,$ where $%
\left( \boldsymbol{e}\right) \in \mathfrak{B}\left( V\right) $ 
\begin{equation}
b_{e}:V\rightarrow V^{d}
\end{equation}%
are defined by 
\begin{equation}
b_{e}\left( e_{j}\right) =e_{bj},\,1\leq j\leq r,
\end{equation}%
i.e. 
\begin{equation}
b_{e}\left( \boldsymbol{e}\right) =\left( \boldsymbol{e}_{b}\right) .
\end{equation}
\end{definition}

\begin{remark}
Basis transformation 
\begin{equation}
V\rightarrow V
\end{equation}%
is 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{1} \\ 
\vdots \\ 
f_{r}%
\end{array}%
\right) \Leftrightarrow \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
f_{1} \\ 
\vdots \\ 
f_{r}%
\end{array}%
\right) ,
\end{equation}%
which should be contrasted to biorthogonalization 
%TCIMACRO{%
%\hyperref{biorthogonalization }{}{}{#Difference between basis transformation and biorthogonalized basis}}%
%BeginExpansion
\msihyperref{biorthogonalization }{}{}{#Difference between basis transformation and biorthogonalized basis}%
%EndExpansion
\end{remark}

\begin{remark}
Basis transformation 
\begin{equation}
V^{d}\rightarrow V^{d}
\end{equation}%
is 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{bb1}\left( e_{b1}\right) & \cdots & f_{bb1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{bbr}\left( e_{b1}\right) & \cdots & f_{bbr}\left( e_{br}\right)%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \Leftrightarrow \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{bb1}\left( e_{b1}\right) & \cdots & f_{bb1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{bbr}\left( e_{b1}\right) & \cdots & f_{bbr}\left( e_{br}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
\label{12/19/2025}
\end{remark}

\begin{enumerate}
\item 
\begin{equation}
f_{bbj}\left( e_{bk}\right) =e_{bk}\left( d_{2}^{-1}\left( f_{bbj}\right)
\right)
\end{equation}

\item 
\begin{equation}
v\overset{d_{2}}{\rightarrow }v_{dd}=d_{2}\left( v\right) \quad \text{where }%
l_{d}\left( v\right) =v_{dd}\left( \text{ }l_{d}\right) \;\forall l_{d}\in
V^{d}
\end{equation}

\item 
\begin{equation}
f=d_{2}^{-1}\left( f_{bbj}\right) \overset{d_{2}}{\rightarrow }%
f_{bbj}=d_{2}\left( d_{2}^{-1}\left( f_{bbj}\right) \right) \quad \text{%
where }l_{d}\left( d_{2}^{-1}\left( f_{bbj}\right) \right) =f_{bbj}\left( 
\text{ }l_{d}\right) \;\forall l_{d}\in V^{d}
\end{equation}

\item 
\begin{eqnarray}
f_{bj} &=&b_{f}\left( f_{j}\right) \\
f_{bbj} &=&b_{f_{b}}\left( b_{f}\left( f_{j}\right) \right) =\left(
b_{f_{b}}\circ b_{f}\right) \left( f_{j}\right)
\end{eqnarray}
\end{enumerate}

\subparagraph{Inner Product Form of Duality \label{Inner Product Form of
Duality}}

\begin{enumerate}
\item Inner products $\left( \left. {}\right\vert \right) _{\rho _{d}\sigma
_{d}}$ and the corresponding dual tensors $\beta _{d_{\rho _{d}\sigma
_{d}}}\in V^{d}\otimes V^{d}$ and their action can be expressed as 
\begin{eqnarray}
\beta _{d_{\rho _{d}\sigma _{d}}} &=&\left( \left. {}\right\vert \right)
_{\rho _{d}\sigma _{d}}=\sum_{1\leq j\leq r}\rho _{jd}\otimes \sigma
_{jd},\quad \rho _{jd},\sigma _{jd}\in V^{d} \\
\beta _{d}\left( \xi ,v\right) &=&\beta _{d}\left( \xi \otimes v\right)
=\left( \left. \xi \right\vert v\right) _{\rho _{d}\sigma _{d}}=\sum_{1\leq
j\leq r}\rho _{jd}\left( \xi \right) \sigma _{jd}\left( v\right) ,\quad
\forall \xi ,v\in V.
\end{eqnarray}

\item Given an inner product $\left( \left. {}\right\vert \right) _{\rho
_{d}\sigma _{d}}$ one can form linear functionals $v_{d_{\rho _{d}\sigma
_{d}}}\in V^{d}$ by the maps $d_{\rho \sigma }\in \mathcal{L}\left(
V^{d},V\right) $ based on the dual bilinear form $\beta _{\rho _{d}\sigma
_{d}},$ where%
\begin{equation}
\beta _{\rho _{d}\sigma _{d}}\in V^{d}\otimes V^{d}
\end{equation}%
and are given by \emph{bases} $\left\{ \left. \rho _{dj}\right\vert 1\leq
j\leq r\right\} $ and $\left\{ \left. \sigma _{dj}\right\vert 1\leq j\leq
r\right\} $ of $V^{d}$ as 
\begin{equation}
\beta _{\rho _{d}\sigma _{d}}=\sum_{1\leq j\leq r}\rho _{dj}\otimes \sigma
_{dj}.
\end{equation}%
The linear functionals $v_{d_{\rho _{d}\sigma _{d}}}$ are \textbf{bra}
vectors $\left( v\right\vert _{\rho _{d}\sigma _{d}}$ that act as 
\begin{equation}
\left( v\right\vert _{\rho _{d}\sigma _{d}}\left( w\right) =v_{d_{\rho
\sigma }}\left( w\right) =\left[ d_{\rho \sigma }\left( v\right) \right]
\left( w\right) =\left( \left. v\right\vert w\right) _{\rho \sigma
}=\sum_{1\leq j\leq r}\rho _{jd}\left( v\right) \sigma _{jd}\left( w\right)
\quad \forall w\in V,
\end{equation}%
where the linear functionals are explicitly given by the expansion 
\begin{equation}
\left( v\right\vert _{\rho _{d}\sigma _{d}}=\sum_{1\leq j\leq r}\rho
_{jd}\left( v\right) \sigma _{jd}.
\end{equation}

\item \textbf{ket }vectors 
\begin{equation}
\left\vert v\right) _{\rho _{d}\sigma _{d}}=\left\vert v\right)
\end{equation}%
are any vector $v\in V$ and do not depend on the bases $\left\{ \rho
_{d},\sigma _{d}\right\} .$

\item The dual vector 
\begin{equation}
v_{d_{\rho \sigma }}=\left( v\right\vert _{\rho _{d}\sigma _{d}}=d_{\rho
_{d}\sigma _{d}}\left( v\right) \in V^{d}
\end{equation}%
and the biorthogonal vector 
\begin{equation}
b_{v}\left( v\right) \in V^{d}
\end{equation}%
associated with the vector $v$ are different. This can be seen by considering

\begin{enumerate}
\item the dual basis 
\begin{equation}
d_{\rho _{d}\sigma _{d}}\left\{ \left( \boldsymbol{e}\right) \right\}
=\left( \boldsymbol{e}\right\vert _{\rho _{d}\sigma _{d}}
\end{equation}%
that has overlap matrix wrt $\left( \left. {}\right\vert \right) _{\rho
_{d}\sigma _{d}}$

\item 
\begin{equation}
\left[ d_{\rho _{d}\sigma _{d}}\left\{ \left( \boldsymbol{e}\right) \right\} %
\right] \left( \boldsymbol{e}\right) ^{t}=\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}
\end{equation}%
and

\item be expanded as 
\begin{equation}
d_{\rho _{d}\sigma _{d}}\left( e_{j}\right) =\left( e_{j}\right\vert _{\rho
_{d}\sigma _{d}}=\sum_{1\leq j\leq r}\rho _{jd}\left( e_{j}\right) \sigma
_{jd},
\end{equation}%
which obviously \textbf{depends on} $\left\{ \rho _{d},\sigma _{d}\right\} ,$
while

\item biorthogonal dual vectors $b_{e}\left\{ \left( \boldsymbol{e}\right)
\right\} $ 
\begin{equation}
b_{e}\left\{ \left( \boldsymbol{e}\right) \right\} =\left( \left. 
\boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma
_{d}}^{-1}\left( \boldsymbol{e}\right\vert _{\rho _{d}\sigma _{d}}
\end{equation}%
that satisfy the biorthogonal condition

\item 
\begin{equation}
\left[ b_{e}\left\{ \left( \boldsymbol{e}\right) \right\} \right] \left( 
\boldsymbol{e}\right) ^{t}=\mathbb{I}_{r}=\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left. 
\boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}},
\end{equation}%
\textbf{do not depend} on $\left\{ \rho _{d},\sigma _{d}\right\} $ and 

\item can be expanded as 
\begin{equation}
b_{e}\left( e_{k}\right) =\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( e_{k}\right\vert
_{\rho _{d}\sigma _{d}}=\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e%
}\right) _{\rho _{d}\sigma _{d}}^{-1}\sum_{1\leq j\leq r}\rho _{jd}\left(
e_{k}\right) \sigma _{jd}.
\end{equation}

\item The action of biorthogonal dual vectors on vectors $v\in V$ is 
\begin{eqnarray}
b_{e}\left( e_{k}\right) \left( v\right)  &=&\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left(
e_{k}\right\vert _{\rho _{d}\sigma _{d}}\left( v\right) =\left( \left. 
\boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma
_{d}}^{-1}\sum_{1\leq j\leq r}\rho _{jd}\left( e_{k}\right) \sigma
_{jd}\left( v\right)  \\
&=&\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
_{d}\sigma _{d}}^{-1}\sum_{1\leq j\leq r}\left( \left. e_{k}\right\vert
v\right) _{\rho _{d}\sigma _{d}}=\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( e_{k}\right\vert
_{\rho _{d}\sigma _{d}}\left( v\right) =\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left.
e_{k}\right\vert v\right) _{\rho _{d}\sigma _{d}},
\end{eqnarray}%
i.e. 
\begin{equation}
b_{e}\left( e_{k}\right) \left( v\right) =\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left.
e_{k}\right\vert v\right) _{\rho _{d}\sigma _{d}},
\end{equation}%
which produces the representation of $\mathcal{R}_{e}\left( v\right) $ of $v$
that can be also be expressed as 
\begin{gather}
\mathcal{R}_{e}\left( v\right) =b_{e}\left( \boldsymbol{e}\right) \left(
v\right) =\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right)
_{\rho _{d}\sigma _{d}}^{-1}\left( \boldsymbol{e}\right\vert _{\rho
_{d}\sigma _{d}}\left( v\right) =\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left. \boldsymbol{e%
}\right\vert v\right) _{\rho _{d}\sigma _{d}} \\
\parallel  \\
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( \left. e_{1}\right\vert v\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( \left. e_{r}\right\vert v\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \left. \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e_{1}\right)
\right\vert v\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( \left. \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e_{1}\right)
\right\vert v\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right)  \\
\parallel  \\
\mathcal{R}_{e}\left( v\right) =\mathcal{R}_{e}\left( S_{\rho _{d}\sigma
_{d}ee}\right) ^{-1}\left( \left. \boldsymbol{e}\right\vert v\right) _{\rho
_{d}\sigma _{d}},
\end{gather}%
where the biorthogonalizing operator  $\mathfrak{b}_{\rho _{d}\sigma
_{d}}\in \mathcal{L}\left( V\right) $ is defined by 
\begin{equation}
\left( \left. \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( \boldsymbol{e}%
\right) \right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}=\left[
b_{e}\left( \boldsymbol{e}\right) \right] \left( \boldsymbol{e}\right) =%
\mathbb{I}_{r}.
\end{equation}

\item In general biorthogonal dual vectors $b_{e}\left( v\right) \in V^{d}$ 
\emph{are not} equal to the dual of vectors $d_{\rho _{d}\sigma _{d}}\left(
v\right) \in V^{d}$  as in general  
\begin{equation}
b_{e}\left\{ \boldsymbol{e}\right\} \neq d_{\rho _{d}\sigma _{d}}\left\{ 
\boldsymbol{e}\right\} 
\end{equation}%
and thus. 
\begin{equation}
b_{e}\left( e_{j}\right) \neq d_{\rho _{d}\sigma _{d}}\left( e_{j}\right)
,\quad 1\leq j\leq r
\end{equation}%
in more detail 
\begin{equation}
\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
_{d}\sigma _{d}}^{-1}\sum_{1\leq j\leq r}\rho _{jd}\left( e_{j}\right)
\sigma _{jd}\neq \sum_{1\leq j\leq r}\rho _{jd}\left( e_{j}\right) \sigma
_{jd},
\end{equation}%
which are only equal if 
\begin{equation}
\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
_{d}\sigma _{d}}^{-1}=\mathbb{I}_{r}.
\end{equation}
\end{enumerate}

\item A vector $v\in V$ can be expanded wrt a basis $\left( \boldsymbol{e}%
\right) $ as 
\begin{equation}
v=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right) =\left( 
\overset{}{\left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma
_{d}}^{t}\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right)
_{\rho _{d}\sigma _{d}}^{-1}\left( \boldsymbol{e}\right\vert _{\rho
_{d}\sigma _{d}}}\right) \left( v\right) =\left\vert \boldsymbol{e}\right)
_{\rho _{d}\sigma _{d}}^{t}\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left. \boldsymbol{e%
}\right\vert \boldsymbol{v}\right) _{\rho _{d}\sigma _{d}},
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( v\right) =\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left. \boldsymbol{e%
}\right\vert \boldsymbol{v}\right) _{\rho _{d}\sigma _{d}}=\left( \left. 
\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( \boldsymbol{e}\right) \right\vert 
\boldsymbol{v}\right) _{\rho _{d}\sigma _{d}}
\end{equation}
\end{enumerate}

where

\begin{enumerate}
\item 
\begin{enumerate}
\item the term in paranthesis is a resolutions of the identity 
\begin{equation}
\left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{t}\left( \left. 
\boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma
_{d}}^{-1}\left( \boldsymbol{e}\right\vert _{\rho _{d}\sigma _{d}}=I_{V},
\end{equation}

\item 
\begin{equation}
\left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}=\left( \boldsymbol{e%
}\right) ,\quad \forall \left\{ \rho _{d},\sigma _{d}\right\} 
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( v\right) =\left( \left. \mathfrak{b}_{\rho _{d}\sigma
_{d}}\left( \boldsymbol{e}\right) \right\vert \boldsymbol{v}\right) _{\rho
_{d}\sigma _{d}}=\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}%
\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{v}\right) _{\rho _{d}\sigma _{d}}
\end{equation}

\item Basis transformation $\left( \boldsymbol{e}\right) \rightarrow \left( 
\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( \boldsymbol{e}\right) \right) $  
\begin{equation}
\left( 
\begin{array}{ccc}
\left\vert \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e_{1}\right) \right)  & 
\cdots  & \left\vert \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e_{r}\right)
\right) 
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) \left( \left. \overset{}{\boldsymbol{e}}\right\vert \boldsymbol{e}%
\right) _{\rho _{d}\sigma _{d}}^{-1}
\end{equation}

which \textbf{does depend} on $\left\{ \rho _{d},\sigma _{d}\right\} $.

\item In super vector notation 
\begin{gather}
v=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( \left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) \right) \left( \overset{}{v}\right)  \\
\\
=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( \left. e_{1}\right\vert v\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( \left. e_{r}\right\vert v\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right)  \\
\Rightarrow \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( \left. e_{1}\right\vert v\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( \left. e_{r}\right\vert v\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ,
\end{gather}%
which we emphasize again \textbf{does not} depend on $\left\{ \rho
_{d},\sigma _{d}\right\} $ even though the notation suggests it does.
\end{enumerate}

\item The representations $\mathcal{R}_{e}$ and $\mathcal{R}_{\mathfrak{b}%
_{\rho _{d}\sigma _{d}}\left( e\right) }$ are related by   
\begin{gather}
v=\left( 
\begin{array}{ccc}
\left\vert \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e_{1}\right) \right)  & 
\cdots  & \left\vert \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e_{r}\right)
\right) 
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e\right) }\left(
v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e\right) }\left(
v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right)  \\
=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\mathcal{R}_{\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e\right) }\left(
v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e\right) }\left(
v\right) _{r}%
\end{array}%
\right)  \\
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\mathcal{R}_{\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e\right) }\left(
v\right) _{1} \\ 
\vdots  \\ 
\mathcal{R}_{\mathfrak{b}_{\rho _{d}\sigma _{d}}\left( e\right) }\left(
v\right) _{r}%
\end{array}%
\right) .
\end{gather}

\item The resolution of the identity property is confirmed by 
\begin{equation}
\left( \overset{}{\left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma
_{d}}\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
_{d}\sigma _{d}}^{-1}\left( \boldsymbol{e}\right\vert _{\rho _{d}\sigma _{d}}%
}\right) \left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}=\left\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}.
\end{equation}

\item The biothogonalization map $b_{e}\in \mathcal{L}\left( V^{d},V\right) $
is defined as 
\begin{equation}
b_{e}:\left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}\rightarrow
\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
_{d}\sigma _{d}}^{-1}\left( \boldsymbol{e}\right\vert _{\rho _{d}\sigma
_{d}},
\end{equation}%
i.e. 
\begin{equation}
b_{e}\left( \left\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}\right)
=\left( \mathfrak{b}_{\rho _{d}\sigma _{d}}\left( \boldsymbol{e}\right)
\right\vert _{\rho _{d}\sigma _{d}}.
\end{equation}%
\textbf{which is independent of} $\left\{ \rho _{d},\sigma _{d}\right\} .$

\item In super vector form 
\begin{gather}
b_{e}\left( \left( 
\begin{array}{c}
\left\vert e_{1}\right)  \\ 
\vdots  \\ 
\left\vert e_{r}\right) 
\end{array}%
\right) \right) =\left( 
\begin{array}{c}
b_{e}\left( \left\vert e_{1}\right) \right)  \\ 
\vdots  \\ 
b_{e}\left( \left\vert e_{r}\right) \right) 
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \mathfrak{b}_{e}\left( e_{1}\right) \right\vert _{\rho _{d}\sigma
_{d}} \\ 
\vdots  \\ 
\left( \mathfrak{b}_{e}\left( e_{r}\right) \right\vert _{\rho _{d}\sigma
_{d}}%
\end{array}%
\right)  \\
\parallel  \\
\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) .
\end{gather}

\item The maps $\mathfrak{b}_{e\rho _{d}\sigma _{d}}\in \mathcal{L}\left(
