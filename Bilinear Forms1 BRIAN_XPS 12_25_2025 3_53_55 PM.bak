\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert e_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert f_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{1}\right\vert f_{2r}\right) _{\rho \sigma } \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert f_{1}\right) _{\rho \sigma } & \cdots & 
\left( \left. e_{2r}\right\vert f_{2r}\right) _{\rho \sigma }%
\end{array}%
\right) \left( 
\begin{array}{c}
