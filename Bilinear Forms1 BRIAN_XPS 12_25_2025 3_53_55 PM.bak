so%
\begin{equation}
\mathcal{R}_{e}\left( \mathfrak{b}_{e\rho _{d}\sigma _{d}}\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}t}=\mathcal{M}_{ee}\left( S_{ee}\right) ^{-t}.
\end{equation}

\item One can also express the overlap matrix $\left[ b_{e}\left( 
\boldsymbol{e}\right) \right] \left( \boldsymbol{e}\right) ^{t}=\left(
\left. \mathfrak{b}_{e\rho _{d}\sigma _{d}}\left( \boldsymbol{e}\right)
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}$ in super vector
form that displays the biorthogonality condition as 
\begin{gather}
