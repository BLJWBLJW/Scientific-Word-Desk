which \textbf{do depend on} $\left\{ \rho _{d},\sigma _{d}\right\} $.

\item The map $b_{e}$ can be defined in terms of \textbf{any} $\left\{ \rho
_{d},\sigma _{d}\right\} $ as 
\begin{equation}
\left( 
\begin{array}{ccc}
b_{e}\left( \left\vert \overset{}{e_{1}}\right) \right)  & \cdots  & 
b_{e}\left( \left\vert \overset{}{e_{r}}\right) \right) 
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \overset{}{\mathfrak{b}_{e\rho _{d}\sigma _{d}}\left( e_{1}\right) }%
\right\vert _{\rho _{d}\sigma _{d}} & \cdots  & \left( \overset{}{\mathfrak{b%
}_{e\rho _{d}\sigma _{d}}\left( e_{r}\right) }\right\vert _{\rho _{d}\sigma
_{d}}%
\end{array}%
\right) 
\end{equation}

\item The map $\tau _{kb}\in \mathcal{L}\left( V^{d},V\right) $ that changes
ket to bra 
\begin{equation}
\tau _{kb}:\left\vert {}\right) \rightarrow \left( {}\right\vert 
\end{equation}%
is \emph{linear, }hence 
\begin{equation}
\mathfrak{b}_{e\rho _{d}\sigma _{d}}\left\{ \overset{}{d_{\rho _{d}\sigma
_{d}}\left\{ \left( \overset{}{\boldsymbol{e}}\right) \right\} }\right\}
=b_{e}\left\{ \left( \overset{}{\boldsymbol{e}}\right) \right\} =d_{\rho
_{d}\sigma _{d}}\left\{ \overset{}{\mathfrak{b}_{e\rho _{d}\sigma
_{d}}\left\{ \left\{ \left( \overset{}{\boldsymbol{e}}\right) \right\}
\right\} }\right\} ,
\end{equation}%
which gives 
\begin{equation}
b_{e}=\mathfrak{b}_{e\rho _{d}\sigma _{d}}\circ d_{\rho _{d}\sigma
_{d}}=d_{\rho _{d}\sigma _{d}}\circ \mathfrak{b}_{e\rho _{d}\sigma _{d}}
\end{equation}%
i.e. 
\begin{equation}
\mathfrak{b}_{e\rho _{d}\sigma _{d}}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \mathfrak{b}_{e}\left( e_{1}\right) \right\vert _{\rho _{d}\sigma
_{d}} \\ 
\vdots  \\ 
\left( \mathfrak{b}_{e}\left( e_{1}\right) \right\vert _{\rho _{d}\sigma
_{d}}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ,
\end{equation}%
where we have used the same symbol $\mathfrak{b}_{e\rho _{d}\sigma _{d}}$ to
denote the maps belonging to $\mathcal{L}\left( V\right) $ and $\mathcal{L}%
\left( V^{d}\right) $

\item Biorthogonality is confirmed by 
\begin{equation}
\left[ \left( 
\begin{array}{c}
\left( \mathfrak{b}_{e}\left( e_{1}\right) \right\vert _{\rho _{d}\sigma
_{d}} \\ 
\vdots  \\ 
\left( \mathfrak{b}_{e}\left( e_{1}\right) \right\vert _{\rho _{d}\sigma
_{d}}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{2r}\right) 
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{2r}\right) 
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}

\item In general one can define $b_{e}\left( f_{j}\right) $ as 
\begin{equation}
f_{b_{e}j}=b_{e}\left( f_{j}\right) =\left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( f_{j}\right\vert
_{\rho _{d}\sigma _{d}}
\end{equation}%
giving 
\begin{equation}
b_{e}\left( f_{j}\right) \left( w\right) =\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \left.
f_{j}\right\vert w\right) _{\rho _{d}\sigma _{d}}
\end{equation}%
which should be compared 
\begin{equation}
f_{d_{\rho \sigma }j}\left( w\right) =d_{\rho \sigma }\left( f_{j}\right)
\left( w\right) =\left( \left. f_{j}\right\vert w\right) _{\rho _{d}\sigma
_{d}}
\end{equation}

\item The inverse $b_{e}^{-1}$ is defined by 
\begin{equation}
b_{e}^{-1}\left\{ b_{e}\left\{ \left( \boldsymbol{e}\right) \right\}
\right\} =b_{e}^{-1}\left\{ \left( \left. \boldsymbol{e}\right\vert 
\boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( \boldsymbol{e}%
\right\vert _{\rho _{d}\sigma _{d}}\right\} =\left\vert \boldsymbol{e}%
\right) 
\end{equation}

\item Dualizing maps $d_{\rho _{d}\sigma _{d}}\in \mathcal{L}\left(
V^{d},V\right) $

\begin{enumerate}
\item 
\begin{equation}
d_{\rho _{d}\sigma _{d}}:V\rightarrow V^{d}
\end{equation}%
are given by%
\begin{equation}
d_{\rho _{d}\sigma _{d}}\left( \xi \right) =\left( \xi \right\vert _{\rho
_{d}\sigma _{d}}
\end{equation}%
in detail

\item the dual vectors $\xi _{d\rho _{d}\sigma _{d}}\in V^{d}$ corresponding
to $\xi $ are equal to the bras $\left( \xi \right\vert _{\rho _{d}\sigma
_{d}}\in V^{d}$ can be expanded 
\begin{equation}
\left( \xi \right\vert _{\rho _{d}\sigma _{d}}=\xi _{d_{\rho _{d}\sigma
_{d}}}=d_{\rho _{d}\sigma _{d}}\left( \xi \right) =\left( \left. \xi
\right\vert \cdot \right) _{\rho _{d}\sigma _{d}}\equiv \left( \xi
\right\vert _{\rho _{d}\sigma _{d}}\left( \cdot \right) \equiv \left(
\sum_{1\leq j\leq r}\rho _{jd}\otimes \sigma _{jd}\right) \left( \overset{}{%
\xi \otimes \cdot }\right) =\sum_{1\leq j\leq r}\rho _{jd}\left( \xi \right)
\sigma _{jd}\left( \cdot \right) ,\text{ for fixed }\xi \in V
\end{equation}%
and have values%
\begin{equation}
\left( \xi \right\vert _{\rho _{d}\sigma _{d}}\left( v\right) =\xi _{d_{\rho
_{d}\sigma _{d}}}\left( v\right) =d_{\rho _{d}\sigma _{d}}\left( \xi \right)
\left( v\right) =\left( \left. \xi \right\vert v\right) _{\rho _{d}\sigma
_{d}}\equiv \left( \sum_{1\leq j\leq r}\rho _{jd}\otimes \sigma _{jd}\right)
\left( \overset{}{\xi \otimes v}\right) =\sum_{1\leq j\leq r}\rho
_{jd}\left( \xi \right) \sigma _{jd}\left( v\right) ,\quad \forall v\in V,%
\text{ for fixed }\xi \in V.
\end{equation}
\end{enumerate}

\item Biorthogonal vectors are given by%
\begin{equation}
b_{e}\left( v\right) =\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}%
\right) _{\rho _{d}\sigma _{d}}^{-1}\left( v\right\vert _{\rho _{d}\sigma
_{d}}=\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right) _{\rho
_{d}\sigma _{d}}^{-1}\left( v\right\vert _{\rho _{d}\sigma _{d}}
\end{equation}%
\begin{equation}
v_{b_{e}}=b_{e}\left\{ v\right\} =b_{e}\left\{ \left( \boldsymbol{e}\right) 
\mathcal{R}_{e}\left( v\right) \right\} =\left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( 
\boldsymbol{e}\right\vert _{\rho _{d}\sigma _{d}}\equiv b_{e}:\left\vert
v\right) _{\rho _{d}\sigma _{d}}\rightarrow \left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}}^{-1}\left( 
\boldsymbol{e}\right\vert _{\rho _{d}\sigma _{d}}
\end{equation}%
\begin{equation}
b_{e}\left( v\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left[ \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}}\left( v\right)  \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}\left( v\right) 
\end{array}%
\right) 
\end{equation}

\item Double dualizing maps $d_{2\rho _{d}\sigma _{d}}\in \mathcal{L}\left(
V^{dd},V\right) $

\begin{enumerate}
\item 
\begin{equation}
d_{2\rho _{d}\sigma _{d}}:V\rightarrow V^{dd}
\end{equation}%
are given by%
\begin{equation}
v_{dd\rho _{d}\sigma _{d}}=d_{2\rho _{d}\sigma _{d}}\left( v\right) =\left(
\left. \cdot \right\vert v\right) _{\rho _{d}\sigma _{d}}=\left( \cdot
\right) \left\vert v\right) _{\rho _{d}\sigma _{d}}\equiv \left\vert
v\right) _{\rho _{d}\sigma _{d}}
\end{equation}%
in detail

\item 
\begin{gather}
\left\vert v_{dd}\right) _{\rho _{d}\sigma _{d}}\left( \cdot \right)
=v_{dd_{\rho _{d}\sigma _{d}}}=d_{2\rho _{d}\sigma _{d}}\left( v\right)
=\left( \left. \cdot \right\vert v\right) _{\rho _{d}\sigma _{d}}\equiv
\left( \cdot \right) \left\vert v\right) _{\rho _{d}\sigma _{d}}\equiv
\left( \sum_{1\leq j\leq r}\rho _{jd}\otimes \sigma _{jd}\right) \left( 
\overset{}{\left( \cdot \right) \otimes v}\right) =\sum_{1\leq j\leq r}\rho
_{jd}\left( \cdot \right) \sigma _{jd}\left( v\right) ,\text{ for fixed }%
v\in V \\
\left\vert v\right) _{\rho _{d}\sigma _{d}}\left( \xi _{d_{\rho _{d}\sigma
_{d}}}\right) =v_{dd_{\rho _{d}\sigma _{d}}}\left( \xi _{d_{\rho _{d}\sigma
_{d}}}\right) =d_{2\rho _{d}\sigma _{d}}\left( v\right) \left( \xi _{d_{\rho
_{d}\sigma _{d}}}\right) =\left( \left. \xi \right\vert v\right) _{\rho
_{d}\sigma _{d}}\equiv \left( \xi \right\vert _{\rho _{d}\sigma _{d}}\left(
v\right)  \\
=\left( \sum_{1\leq j\leq r}\rho _{jd}\otimes \sigma _{jd}\right) \left( 
\overset{}{\xi \otimes v}\right) =\sum_{1\leq j\leq r}\rho _{jd}\left( \xi
\right) \sigma _{jd}\left( v\right) ,\quad \forall \xi \in V,\text{ for
fixed }v\in V
\end{gather}
\end{enumerate}
\end{enumerate}

and 
\begin{equation}
d_{2}\left( \left\vert v\right) _{\rho _{d}\sigma _{d}}\right) \left( \left(
\xi \right\vert _{\rho _{d}\sigma _{d}}\right) =\left( \left. \xi
\right\vert v\right) _{\rho _{d}\sigma _{d}}=d_{2}\left( v\right) \left(
\left( \xi \right\vert _{\rho _{d}\sigma _{d}}\right) =\left( \xi
\right\vert _{\rho _{d}\sigma _{d}}\left( v\right) =\left( \left. \xi
\right\vert v\right) _{\rho _{d}\sigma _{d}}.
\end{equation}

\begin{enumerate}
\item Operators $d_{\rho _{d}\sigma _{d}}\in \mathcal{L}\left( V\right) $%
\begin{equation}
\left\vert v_{k}\right) _{\rho _{d}\sigma _{d}}\left( \xi _{l}\right\vert
_{\rho _{d}\sigma _{d}}=\sum_{1\leq j\leq r}\rho _{jd}\left( \cdot \right)
\sigma _{jd}\left( v_{k}\right) \sum_{1\leq m\leq r}\rho _{m}\left( \xi
_{l}\right) \sigma _{dm}\left( \cdot \right)
\end{equation}%
\begin{eqnarray}
\left( \xi \right\vert _{\rho _{d}\sigma _{d}}\left( \cdot \right)
&=&d_{\rho _{d}\sigma }\left( \xi \right) \left( \cdot \right) =\left(
\sum_{1\leq j\leq r}\rho _{j}\otimes \sigma _{dj}\right) \left( \xi \overset{%
}{\otimes }\cdot \right) =\sum_{1\leq j\leq r}\rho _{j}\left( \xi \right)
\sigma _{dj}\left( \cdot \right) = \\
\left( \xi \right\vert _{\rho _{d}\sigma _{d}}\left( v\right) &=&d_{\rho
_{d}\sigma }\left( \xi \right) \left( v\right) =\left( \sum_{1\leq j\leq
r}\rho _{j}\otimes \sigma _{dj}\right) \left( \overset{}{\xi \otimes v}%
\right) =\sum_{1\leq j\leq r}\rho _{j}\left( \xi \right) \sigma _{dj}\left(
v\right) =
\end{eqnarray}
\end{enumerate}

\begin{remark}
In the following one can use \textbf{any} basis $\left( \boldsymbol{f}%
_{d}\right) $ of $V^{d}$ thus in order to make a direct connection with $V$
we choose $\left( \boldsymbol{f}_{b}\right) =d_{f}\left\{ \left( \boldsymbol{%
f}\right) \right\} .$
\end{remark}

\begin{remark}
In super operator notation biorthogonal bases $\left( \boldsymbol{e}%
_{b}\right) $ produce biorthogonalizing maps $b_{e}\in \mathcal{L}\left(
V^{d},V\right) $ i.e. 
\begin{gather}
b_{e} \\
\parallel \\
\left( \boldsymbol{e}_{b}\right) ^{t}\left( \boldsymbol{e}_{b}\right)
=\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{bj}\left[ e_{bj}\right] \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}\left[ \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right]
\end{gather}%
\begin{gather}
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) {\LARGE \Delta }_{f_{d}e}^{-1}\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right]
\end{gather}%
for any basis $\left( \boldsymbol{f}_{d}\right) $ of $V^{d},$ where
\end{remark}

\begin{definition}
The symmetric matrix ${\LARGE \Delta }_{f_{b}e}$ is defined by 
\begin{equation}
{\LARGE \Delta }_{f_{b}e}=\boldsymbol{f}_{b}\left( \boldsymbol{e}\right) 
\boldsymbol{f}_{b}\left( \boldsymbol{e}\right) ^{t}=\left( \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left( \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) ^{t}.
\end{equation}
\end{definition}

\begin{remark}
This gives that biorthogonalizing maps $b_{e}\in \mathcal{L}\left(
V^{d},V\right) ,$ $\left( \boldsymbol{e}_{b}\right) =b_{e}\left( \boldsymbol{%
e}\right) $ can be expanded as%
\begin{gather}
b_{e} \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \\
\parallel
\end{gather}%
\begin{equation}
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) {\LARGE \Delta }_{f_{b}e}^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] .
\end{equation}
\end{remark}

\begin{remark}
One can also get this result by expanding the map $b_{e}$ by 
\begin{gather}
b_{e} \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left( \left( \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left( \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) ^{t}\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left( \left( \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left[ \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right]
\end{gather}%
\begin{gather}
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( \sum_{1\leq j\leq r}e_{j}\left[ e_{j}\right] \right)
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right]
\end{gather}%
\begin{gather}
\parallel \\
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) {\LARGE \Delta }_{f_{b}e}^{-1}\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] ,
\end{gather}%
showing that 
\begin{equation}
{\LARGE \Delta }_{f_{b}e}=\left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( \sum_{1\leq j\leq r}e_{j}\left[ e_{j}\right] \right)
\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\subparagraph{The Inverse Maps $b_{e}^{-1}\in \mathcal{L}\left(
V,V^{d}\right) $}

\begin{definition}
The inverse map $b_{e}^{-1}$ is defined by 
\begin{equation}
b_{e}^{-1}=\left( \sum_{1\leq j\leq r}e_{bj}\left[ e_{bj}\right] \right)
^{-1}=\sum_{1\leq j\leq r}e_{j}\left[ e_{bbj}\right]
\end{equation}
\end{definition}

\begin{remark}
The following shows that they are inverses of each other

\begin{enumerate}
\item 
\begin{equation}
b_{e}^{-1}b_{e}\in \mathcal{L}\left( V\right) =\sum_{1\leq j\leq r}e_{j}%
\left[ e_{bbj}\right] \sum_{1\leq j\leq r}e_{bj}\left[ e_{bj}\right]
=\sum_{1\leq j,k\leq r}e_{j}\left[ e_{bbj}\right] e_{bk}\left[ e_{bk}\right]
=\sum_{1\leq j,k\leq r}e_{j}\left( \overset{}{e_{bbj}\left( e_{bk}\right) }%
\right) \left[ e_{bk}\right] =\sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right]
=I_{V}
\end{equation}

\item 
\begin{equation}
b_{e}b_{e}^{-1}\in \mathcal{L}\left( V^{d}\right) =\sum_{1\leq j\leq r}e_{bj}%
\left[ e_{bj}\right] \sum_{1\leq j\leq r}e_{j}\left[ e_{bbj}\right]
=\sum_{1\leq j,k\leq r}e_{bk}\left[ e_{bk}\right] e_{j}\left[ e_{bbj}\right]
=\sum_{1\leq j,k\leq r}e_{bk}\left( \overset{}{e_{bk}\left( e_{j}\right) }%
\right) \left[ e_{bbk}\right] =\sum_{1\leq j\leq r}e_{bj}\left[ e_{bbj}%
\right] =I_{V^{d}}
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
A basis $\left( \boldsymbol{e}_{bb}\right) $ in $V^{dd}$ biorthogonal to a
basis $\left( \boldsymbol{e}_{b}\right) $ in $V^{d}$ is given by 
\begin{equation}
\left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{dd1}\left( e_{b1}\right) & \cdots & f_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{ddr}\left( e_{b1}\right) & \cdots & f_{ddr}\left( e_{br}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \Leftrightarrow \left( \boldsymbol{e}_{bb}\right) =\left( \overset{}{%
\boldsymbol{f}_{dd}\left( \boldsymbol{e}_{b}\right) }\right) ^{-1}\left( 
\boldsymbol{f}_{dd}\right) ,
\end{equation}%
for any basis $\left( \boldsymbol{f}_{dd}\right) $ of $V^{dd}.$ We choose
the basis $\left( \boldsymbol{e}_{bb}\right) $ as we want to form a map $%
\left( \boldsymbol{e}_{b}\right) \rightarrow \left( \boldsymbol{e}\right) $
where $d_{2}\left( \boldsymbol{e}\right) =\left( \boldsymbol{e}_{bb}\right)
. $
\end{remark}

\begin{remark}
\begin{equation}
\left( \boldsymbol{e}\right) ^{t}\left( \boldsymbol{e}_{bb}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}\left[ e_{bbj}\right]
\end{equation}
\end{remark}

\begin{remark}
Recall change of basis \label{118/20252} 
\begin{gather}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b1} \\ 
\vdots \\ 
f_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{gather}%
and 
\begin{gather}
\left( 
\begin{array}{ccc}
e_{bb1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{bb1} & \cdots & f_{bbr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{gather}
\end{remark}

\begin{remark}
The inverses $b_{e}^{-1}\in \mathcal{L}\left( V,V^{d}\right) $ are given by
when choosing the basis $\left( \boldsymbol{f}_{bb}\right) $ of $V^{dd}$ 
\begin{gather}
b_{e}^{-1} \\
\parallel \\
\left( \boldsymbol{e}\right) ^{t}\left( \boldsymbol{e}_{bb}\right) =\left( 
\boldsymbol{e}\right) ^{t}\left( d_{2}\left( \boldsymbol{e}\right) \right)
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}\left[ e_{bbj}\right] =\sum_{1\leq
j\leq r}e_{j}\left[ d_{2}\left( e\right) _{j}\right] \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{ccc}
f_{bb1}\left( e_{b1}\right) & \cdots & f_{bb1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{bbr}\left( e_{b1}\right) & \cdots & f_{bbr}\left( e_{br}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{bb1} \\ 
\vdots \\ 
f_{bbr}%
\end{array}%
\right) \right]
\end{gather}%
one obtains 
\begin{equation}
\parallel
\end{equation}%
\begin{gather}
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{ccc}
f_{bb1}\left( e_{b1}\right) & \cdots & f_{bb1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{bbr}\left( e_{b1}\right) & \cdots & f_{bbr}\left( e_{br}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{ccc}
e_{b1}\left( f_{1}\right) & \cdots & e_{b1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( f_{1}\right) & \cdots & e_{br}\left( f_{r}\right)%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \boldsymbol{e}_{d}\left( \boldsymbol{e}\right) \boldsymbol{f}%
_{d}\left( \boldsymbol{e}\right) ^{t}\left( \left( 
\begin{array}{ccc}
e_{b1}\left( f_{d1}\right) & \cdots & e_{b1}\left( f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( f_{d1}\right) & \cdots & e_{br}\left( f_{dr}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
f_{b1}\left( e_{1}\right) & \cdots & f_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{br}\left( e_{1}\right) & \cdots & f_{br}\left( e_{r}\right)%
\end{array}%
\right) \right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \right] .
\end{gather}%
\begin{equation}
{\LARGE \Delta }_{f_{d}e}=\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) 
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) ^{t}=\left( \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left( \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) ^{t}.
\end{equation}
\end{remark}

\begin{remark}
Recall that the injective embedding $d_{2}\in \mathcal{L}\left(
V^{dd},V\right) $ 
\begin{equation}
d_{2}\equiv \iota _{V^{dd}V}:V\rightarrow V^{dd}
\end{equation}%
of $V$ into $V^{dd}$ $is$ given by 
\begin{equation}
\boldsymbol{f}_{d}\left( v\right) =d_{2}\left( v\right) \left( f_{d}\right)
,\,\forall f_{d}\in V^{d},\,v\in V.
\end{equation}
\end{remark}

\begin{remark}
The representation of vectors $v$ 
\begin{gather}
v=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right]
\left( v\right) =\left( \boldsymbol{e}\right) ^{t}\boldsymbol{e}_{b}\left(
v\right) \\
=\left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{\boldsymbol{f%
}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left( \overset{}{%
\boldsymbol{f}_{d}\left( v\right) }\right) =\left( \overset{}{\boldsymbol{e}}%
\right) ^{t}\left( \overset{}{\left( \boldsymbol{f}_{d}\right) ^{t}\left( 
\boldsymbol{e}\right) }\right) ^{-1}\left( \overset{}{\boldsymbol{f}%
_{d}\left( v\right) }\right) \\
=\left[ \left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{%
\left( \boldsymbol{f}_{d}\right) ^{t}\left( \boldsymbol{e}\right) }\right)
^{-1}\left( \overset{}{\boldsymbol{f}_{d}}\right) \right] \left( v\right) =%
\left[ \left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{%
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left( \overset{%
}{\boldsymbol{f}_{d}}\right) \right] \left( v\right) .
\end{gather}
\end{remark}

\begin{remark}
It is idempotent 
\begin{equation}
\left[ \left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{%
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left( \overset{%
}{\boldsymbol{f}_{d}}\right) \right] \left[ \left( \overset{}{\boldsymbol{e}}%
\right) ^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) 
}\right) ^{-1}\left( \overset{}{\boldsymbol{f}_{d}}\right) \right] =\left( 
\overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{\boldsymbol{f}%
_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left( \overset{}{\boldsymbol{%
f}_{d}}\right)
\end{equation}%
and the dimension of its range is $r$
\end{remark}

\begin{theorem}
Any continuous surjective linear idempotent acting on a topological vector
space is equal to the identity operator of that space.
\end{theorem}

\begin{theorem}
$V$ is isomorphic to its injection $\iota _{V^{dd}V}\left( V\right) $ in $%
V^{dd}.$
\end{theorem}

\begin{lemma}
The change of basis transformation $S_{fe}\in \mathcal{L}\left( V\right) $
of $V$ from $\left( \boldsymbol{e}\right) $ to $\left( \boldsymbol{f}\right) 
$ is given by 
\begin{equation}
S_{fe}=\left( \overset{}{\boldsymbol{f}}\right) ^{t}\left( \boldsymbol{h}%
_{d}\left( \overset{}{\boldsymbol{e}}\right) \right) ^{-1}\left[ \overset{}{%
\boldsymbol{h}_{d}}\right] ,
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=S_{fe}\left( \boldsymbol{e}\right) ^{t},
\end{equation}%
where $\left( \boldsymbol{h}_{d}\right) $ \textbf{is any basis} of $V^{d}.$

\begin{remark}
The only thing that makes this transformation chnage the basis $\left( 
\boldsymbol{e}\right) $ to $\left( \boldsymbol{f}\right) $ is factor $\left( 
\boldsymbol{e}\right) $ the basis $\left( \boldsymbol{h}_{d}\right) $ is
arbitary, the action on another basis $\left( \boldsymbol{x}\right) $ does
not change it to $\left( \boldsymbol{f}\right) .$
\end{remark}

\begin{proof}
\begin{equation}
S_{fe}\left( \overset{}{\boldsymbol{e}}\right) ^{t}=\left( \overset{}{%
\boldsymbol{f}}\right) ^{t}\left( \left[ \left( \overset{}{\boldsymbol{h}_{d}%
}\right) \right] \left( \overset{}{\boldsymbol{e}}\right) ^{t}\right) ^{-1}%
\left[ \overset{}{\boldsymbol{h}_{d}}\right] \left( \overset{}{\boldsymbol{e}%
}\right) ^{t}=\left( \overset{}{\boldsymbol{f}}\right) ^{t}\left( 
\boldsymbol{h}_{d}\left( \overset{}{\boldsymbol{e}}\right) \right)
^{-1}\left( \boldsymbol{h}_{d}\left( \overset{}{\boldsymbol{e}}\right)
\right) =\left( \overset{}{\boldsymbol{f}}\right) ^{t}.
\end{equation}%
Hence 
\begin{equation}
v=\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( v\right) =\left( 
\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right)
\end{equation}
\end{proof}
\end{lemma}

\begin{remark}
This produces

\begin{enumerate}
\item $b_{e}\in \mathcal{L}\left( V^{d},V\right) $%
\begin{equation}
b_{e}=\left( \overset{}{\boldsymbol{e}_{b}}\right) ^{t}\left( \overset{}{%
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left[ \left( 
\overset{}{\boldsymbol{f}_{d}}\right) \right] =\left( \overset{}{\boldsymbol{%
f}_{d}}\right) ^{t}{\LARGE \Delta }_{f_{d}e}^{-1}\left[ \left( \overset{}{%
\boldsymbol{f}_{d}}\right) \right] ,
\end{equation}%
where 
\begin{equation}
{\LARGE \Delta }_{f_{d}e}=\boldsymbol{f}_{d}\left( \boldsymbol{e}\right)
\end{equation}%
and

\item $b_{e}^{-1}\in \mathcal{L}\left( V,V^{d}\right) $%
\begin{equation}
b_{e}^{-1}=\left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{%
\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left[ \left( 
\overset{}{\boldsymbol{f}_{dd}}\right) \right] =\left( \overset{}{%
\boldsymbol{f}_{dd}}\right) ^{t}{\LARGE \Delta }_{f_{d}e}^{-1}\left[ \left( 
\overset{}{\boldsymbol{f}_{dd}}\right) \right] .
\end{equation}
\end{enumerate}
\end{remark}

\begin{example}
\begin{equation}
b_{e}\left( v\right) =\left( \overset{}{\boldsymbol{e}_{b}}\right)
^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }%
\right) ^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{d}}\right) \right]
\left( v\right) =\left( \overset{}{\boldsymbol{e}_{b}}\right) ^{t}\left( 
\overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}%
\mathcal{R}_{f}
\end{equation}
\end{example}

\begin{remark}
\begin{eqnarray}
b_{e}b_{e}^{-1} &\in &\mathcal{L}\left( V^{d}\right) =\left( \overset{}{%
\boldsymbol{e}_{b}}\right) ^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( 
\boldsymbol{e}\right) }\right) ^{-1}\left[ \left( \overset{}{\boldsymbol{f}%
_{d}}\right) \right] \left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( 
\overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}%
\left[ \left( \overset{}{\boldsymbol{f}_{dd}}\right) \right] =\left( \overset%
{}{\boldsymbol{e}_{b}}\right) ^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( 
\boldsymbol{e}\right) }\right) ^{-1}\left[ \left( \overset{}{\boldsymbol{f}%
_{dd}}\right) \right] \\
&=&\left( \overset{}{\boldsymbol{f}_{d}}\right) ^{t}{\LARGE \Delta }%
_{f_{d}e}^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{d}}\right) \right]
\left( \overset{}{\boldsymbol{f}_{dd}}\right) ^{t}{\LARGE \Delta }%
_{f_{d}e}^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{dd}}\right) \right]
\end{eqnarray}%
\begin{eqnarray}
b_{e}^{-1}b_{e} &\in &\mathcal{L}\left( V\right) =\left( \overset{}{%
\boldsymbol{e}}\right) ^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( 
\boldsymbol{e}\right) }\right) ^{-1}\left[ \left( \overset{}{\boldsymbol{f}%
_{dd}}\right) \right] \left( \overset{}{\boldsymbol{e}_{b}}\right)
^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }%
\right) ^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{d}}\right) \right]
=\left( \overset{}{\boldsymbol{e}}\right) ^{t}\left( \overset{}{\boldsymbol{f%
}_{d}\left( \boldsymbol{e}\right) }\right) ^{-1}\left[ \left( \overset{}{%
\boldsymbol{f}_{dd}}\right) \right] \left( \overset{}{\boldsymbol{e}_{b}}%
\right) ^{t}\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) 
}\right) ^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{d}}\right) \right] \\
&=&\left( \overset{}{\boldsymbol{f}_{dd}}\right) ^{t}{\LARGE \Delta }%
_{f_{d}e}^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{dd}}\right) \right]
\left( \overset{}{\boldsymbol{f}_{d}}\right) ^{t}{\LARGE \Delta }%
_{f_{d}e}^{-1}\left[ \left( \overset{}{\boldsymbol{f}_{d}}\right) \right]
\end{eqnarray}
\end{remark}

\begin{remark}
The $\left( \boldsymbol{e}\right) $ in terms of the basis $\left( 
\boldsymbol{f}\right) $ 
\begin{gather}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}=\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right] \right) ^{-t} \\
\parallel \\
\left( \boldsymbol{e}_{b}\right) ^{t}=S_{e_{b}f_{d}}\left( \boldsymbol{f}%
_{d}\right) ^{t}=\left( \boldsymbol{f}_{d}\right) ^{t}\mathcal{R}%
_{f_{d}}\left( S_{e_{b}f_{d}}\right) ,
\end{gather}
\end{remark}

\begin{remark}
\begin{enumerate}
\item Note that 
\begin{equation}
\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) .
\end{equation}

\item The map $b_{e}\in \mathcal{L}\left( V^{d},V\right) $ is given by 
\begin{equation}
b_{e}=\sum_{1\leq j\leq r}e_{bj}\left[ e_{bj}\right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) {\LARGE \Delta }_{fe}^{-1}\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \mathcal{R}_{f_{d}}\left( S_{fe}\right) \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] ,
\end{equation}%
where 
\begin{equation}
{\LARGE \Delta }_{fe}=\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{t}=\boldsymbol{f}\left( \boldsymbol{e}_{d}\right) \left( 
\boldsymbol{f}\left( \boldsymbol{e}_{d}\right) \right) ^{t}=\mathcal{R}%
_{f_{d}}\left( S_{f_{d}e_{d}}\right) .
\end{equation}

\item The inverse $b_{e}^{-1}\in \mathcal{L}\left( V,V^{d}\right) $ of $%
b_{e} $ is given by%
\begin{equation}
b_{e}^{-1}=\sum_{1\leq k\leq r}e_{k}\left[ e_{bbk}\right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) {\LARGE \Delta }_{f_{d}e_{d}}^{-1}\left[ \left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \right] .
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
In some more detail the inverse relationship 
\begin{equation}
b_{e}^{-1}\left( \boldsymbol{e}_{b}\right) =\left( \boldsymbol{e}\right)
\end{equation}%
gives 
\begin{equation}
\left( \overset{}{b_{e}b_{e}^{-1}}\right) \left( \overset{}{\boldsymbol{e}%
_{b}}\right) =b_{e}\left( \boldsymbol{e}\right) =\boldsymbol{e}_{b},\quad
b_{e}b_{e}^{-1}\in \mathcal{L}\left( V^{d}\right) ,
\end{equation}%
where 
\begin{equation}
b_{e}b_{e}^{-1}=\sum_{1\leq j\leq r}e_{bj}\left[ e_{bj}\right] \sum_{1\leq
k\leq r}e_{k}\left[ e_{bbk}\right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( e_{1}\right) & \cdots & e_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( e_{1}\right) & \cdots & e_{br}\left( e_{r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =I_{V^{d}}
\end{equation}%
and 
\begin{equation}
\left( \overset{}{b_{e}^{-1}b_{e}}\right) \left( \overset{}{\boldsymbol{e}}%
\right) =b_{e}^{-1}\left( \boldsymbol{e}_{b}\right) =\left( \boldsymbol{e}%
\right) ,\quad b_{e}^{-1}b_{e}\in \mathcal{L}\left( V\right) ,
\end{equation}%
where%
\begin{equation}
b_{e}^{-1}b_{e}=\sum_{1\leq k\leq r}e_{k}\left[ e_{bbk}\right] \sum_{1\leq
j\leq r}e_{bj}\left[ e_{bj}\right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{bb1}\left( e_{b1}\right) & \cdots & e_{bb1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bbr}\left( e_{b1}\right) & \cdots & e_{bbr}\left( e_{br}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] =I_{V}.
\end{equation}
\end{remark}

\begin{remark}
\begin{gather}
\left( \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) ^{t}=\left[ \left( 
\begin{array}{c}
e_{dd1} \\ 
\vdots \\ 
e_{ddr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{dd1}\left( f_{d1}\right) & \cdots & e_{dd1}\left( f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( f_{d1}\right) & \cdots & e_{ddr}\left( f_{dr}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{dd1}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{d1}\left( e_{r}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{t}
\end{gather}
\end{remark}

\begin{definition}
\begin{gather}
\boldsymbol{\Delta }_{f_{d}e} \\
\parallel \\
\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right)
\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right)
^{t}=\left( \left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left( \left[ \left( 
\begin{array}{c}
e_{dd1} \\ 
\vdots \\ 
e_{ddr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \right) \\
\parallel \\
\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right)
\left( \overset{}{\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) }\right)
^{t}=\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{dd1} \\ 
\vdots \\ 
e_{ddr}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \left( \sum_{1\leq j\leq r}e_{j}\left[ e_{ddj}\right]
\right) \left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] S_{ee_{dd}}\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{d1}\left( S_{ee_{dd}}f_{d1}\right) & \cdots & f_{d1}\left(
S_{ee_{dd}}f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( S_{ee_{dd}}f_{d1}\right) & \cdots & f_{dr}\left(
S_{ee_{dd}}f_{dr}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( S_{ee_{dd}}f_{d1}\right) \left( {}\right) & \cdots & 
f_{d1}\left( S_{ee_{dd}}f_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( S_{ee_{dd}}f_{d1}\right) & \cdots & f_{dr}\left(
S_{ee_{dd}}f_{dr}\right)%
\end{array}%
\right)
\end{gather}%
so $\boldsymbol{\Delta }_{f_{d}e}$ is a symmetric matrix but not positive
unless $\boldsymbol{f}_{d}\left( \boldsymbol{e}\right) $ is real.
\end{definition}

\begin{remark}
\begin{equation}
\end{equation}%
$\left( 
\begin{array}{ccc}
e_{1}\left( e_{1}\right) & \cdots & e_{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{r}\left( e_{1}\right) & \cdots & e_{r}\left( e_{r}\right)%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}%
\end{array}%
\right) \right] \mathbb{S}_{ee}\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \boldsymbol{f}_{d}\mathbb{S}_{ee}\boldsymbol{f}_{d}^{t}=\sum_{1\leq
j,k\leq r}f_{dj}\left( \mathbb{S}_{ee}\right) _{jk}f_{dk},$
\end{remark}

\begin{remark}
\begin{equation}
b_{e}=\left( \boldsymbol{e}_{b}\right) ^{t}\left( \boldsymbol{e}_{b}\right)
=\left( \boldsymbol{f}_{d}\right) ^{t}\boldsymbol{\Delta }%
_{f_{d}e}^{-1}\left( \boldsymbol{f}_{d}\right) ,
\end{equation}%
which does not depend on $\left( \boldsymbol{f}_{d}\right) .$
\end{remark}

\begin{remark}
$b_{e}$ can act on other bases
\end{remark}

\begin{theorem}
$b_{e}\in \mathcal{L}\left( V^{d},V\right) $ are injections.
\end{theorem}

\begin{remark}
One can define the spaces $V^{d}\otimes V^{d}$ and $V\otimes V^{d}$ and $%
\mathcal{L}\left( V\right) $ hence using biorthogonal bases.
\end{remark}

\begin{definition}
Let $b_{\rho \sigma }\in V^{d}\otimes V^{d}$ be second order dual tensors
given by 
\begin{equation}
b_{\rho \sigma }=\sum_{1\leq j,k\leq r}e_{bj}\otimes e_{bk}\mathcal{R}%
_{e_{b}e_{b}}\left( b_{\rho \sigma }\right) =\sum_{1\leq j\leq r}\kappa
_{j}\rho _{bj}\otimes \sigma _{bj},
\end{equation}%
where 
\begin{equation}
\kappa _{j}=\left\{ 
\begin{array}{c}
1\text{ for }j\leq \limfunc{Rank}\left( b_{\rho \sigma }\right) \\ 
0\text{ for }j>\limfunc{Rank}\left( b_{\rho \sigma }\right)%
\end{array}%
\right. ,
\end{equation}%
then the map $\Xi _{\mathcal{L}\left( V\right) V^{2d}}\in \mathcal{L}\left( 
\mathcal{L}\left( V\right) ,V^{d}\otimes V^{d}\right) $ 
\begin{equation}
\Xi _{\mathcal{L}\left( V\right) V^{2d}}:V^{d}\otimes V^{d}\rightarrow
V\otimes V^{d}\rightarrow \mathcal{L}\left( V\right)
\end{equation}%
is given by 
\begin{equation}
\Xi _{\mathcal{L}\left( V\right) V^{2d}}\left( b_{\rho \sigma }\right)
=\sum_{1\leq j\leq r}\kappa _{j}\rho _{j}\left[ \sigma _{bj}\right] ,
\end{equation}%
where 
\begin{equation}
\left( \overset{}{\Xi _{\mathcal{L}\left( V\right) V^{2d}}\left( b_{\rho
\sigma }\right) }\right) \left( v\right) =\left( \sum_{1\leq j\leq r}\kappa
_{j}\rho _{j}\left[ \sigma _{bj}\right] \right) \left( v\right) =\sum_{1\leq
j\leq r}\kappa _{j}\rho _{j}\sigma _{bj}\left( v\right) =\sum_{1\leq j\leq
r}\kappa _{j}\rho _{j}\sigma _{bj}\left( v\right) ,\,\forall v\in V
\end{equation}%
and 
\begin{equation}
\rho _{j}=\left( \Xi _{\mathcal{L}\left( V\right) V^{2d}}\left( b_{\rho
\sigma }\right) \right) ^{-1}\left( \rho _{bj}\right) ,\,1\leq j\leq r,
\end{equation}%
where $\left( \Xi _{\mathcal{L}\left( V\right) V^{2d}}\left( b_{\rho \sigma
}\right) \right) ^{-1}$ is the generalized inverse of $\Xi _{\mathcal{L}%
\left( V\right) V^{2d}}\left( b_{\rho \sigma }\right) .$
\end{definition}

\begin{lemma}
Let $b_{e_{b}e_{b}}\in V^{d}\otimes V^{d}$ be 
\begin{equation}
b_{e_{b}e_{b}}=\sum_{1\leq j\leq r}e_{bj}\otimes e_{bj}
\end{equation}%
then it can be mapped into the identity operator $I_{V}\in \mathcal{L}\left(
V\right) $ 
\begin{equation}
\Xi _{\mathcal{L}\left( V\right) V^{2d}}\left( b_{e_{b}e_{b}}\right)
=\sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] =I_{V}.
\end{equation}

\begin{proof}
\begin{equation}
v=\left( \sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] \right) \left(
\sum_{1\leq k\leq r}e_{k}\mathcal{R}_{e}\left( v\right) _{k}\right)
=\sum_{1\leq j,k\leq r}e_{j}\left[ e_{bj}\right] \left( e_{k}\right) 
\mathcal{R}_{e}\left( v\right) _{k}=\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}%
_{e}\left( v\right) _{k}=v\,\quad \forall v\in V.
\end{equation}
\end{proof}
\end{lemma}

\label{Canonical Symmetric Inner Product}

\subsection{Canonical Symmetric Inner Product}

\begin{theorem}
One can define a \emph{Symmetric Bi Linear InnerProduct} $\left( \left.
{}\right\vert \right) _{\eta _{d}}$ by choosing a basis $\left( \boldsymbol{%
\eta }_{d}\right) $ of $V^{d}$ then construct a bilinear function from
second order dual tensors $b_{\eta _{d}\eta _{d}}\in V^{d}\times V^{d}$ 
\begin{equation}
\left( \left. {}\right\vert \right) _{\eta _{d}}:V\times V\rightarrow 
\mathbb{C}
\end{equation}%
in $V$ by 
\begin{equation}
\left( \left. v\right\vert w\right) _{\eta _{d}}=\left( \left. v\right\vert
w\right) _{\eta _{d}\eta _{d}}=\left( \sum_{1\leq j\leq r}\eta _{dj}\otimes
\eta _{dj}\right) \left( v\otimes w\right) ==\sum_{1\leq j\leq r}\eta
_{dj}\left( v\right) \eta _{dj}\left( w\right) ,\quad \forall \left( 
\boldsymbol{\eta }_{d}\right) \in \mathfrak{B}\left( V^{d}\right) ,\quad
\forall v,w\in V.
\end{equation}
\end{theorem}

\begin{proof}
\begin{equation}
\left( \left. v\right\vert w\right) _{\eta _{d}}=\left( \sum_{1\leq j\leq
r}\eta _{dj}\otimes \eta _{dj}\right) \left( v\otimes w\right) =\sum_{1\leq
j\leq r}\eta _{dj}\left( v\right) \eta _{dj}\left( w\right)
\end{equation}%
and 
\begin{equation}
\left( \left. w\right\vert v\right) _{\eta _{d}}=\left( \sum_{1\leq j\leq
r}\eta _{dj}\otimes \eta _{dj}\right) \left( w\otimes v\right) =\sum_{1\leq
j\leq r}\eta _{dj}\left( w\right) \eta _{dj}\left( v\right) =\sum_{1\leq
j\leq r}\eta _{bj}\left( v\right) \eta _{bj}\left( w\right) =\left( \left.
v\right\vert w\right) _{\eta _{d}}.\blacksquare
\end{equation}
\end{proof}

\subsubsection{Dualizing Maps \label{Dualizing Maps}}

\begin{definition}
\emph{Dualizing Maps} $d_{\eta _{d}}\in \mathcal{L}\left( V^{d},V\right) $ 
\begin{equation}
d_{\eta _{d}}:V\rightarrow V^{d}
\end{equation}%
by%
\begin{equation}
\left[ \overset{}{d_{\eta _{d}}\left( v\right) }\right] \left( w\right)
=v_{d}\left( w\right) =\left( v\right\vert _{\eta _{d}}\left( w\right)
=\sum_{1\leq j\leq r}\eta _{dj}\left( \overset{}{v}\right) \eta _{dj}\left(
w\right) ,\quad v\in V,\,\forall w\in V,
\end{equation}%
so that the image of $v\in V$ is the dual vector $d_{\eta _{d}}\left(
v\right) \in V^{d}$ given by 
\begin{equation}
d_{\eta _{d}}\left( v\right) =\sum_{1\leq j\leq r}\eta _{dj}\left( \overset{}%
{v}\right) \eta _{dj}.
\end{equation}
\end{definition}

\begin{lemma}
\emph{Dualizing maps} $d_{\eta _{d}}\in \mathcal{L}\left( V^{d},V\right) $
are \emph{injective} i.e. \label{12/17/2025x} 
\begin{equation}
\ker \left( d_{\eta _{d}}\right) =\phi .
\end{equation}

\begin{proof}
Fix $v_{1}$ and $v_{2}$ then $\forall w\in V$ 
\begin{equation}
\sum_{1\leq j\leq r}\eta _{dj}\left( \overset{}{v_{1}}\right) \eta
_{dj}\left( w\right) -\sum_{1\leq j\leq r}\eta _{dj}\left( \overset{}{v_{2}}%
\right) \eta _{dj}\left( w\right) =\sum_{1\leq j\leq r}\left( \eta
_{dj}\left( v_{1}\right) \eta _{dj}\left( w\right) -\eta _{dj}\left(
v_{2}\right) \eta _{dj}\left( w\right) \right) =\sum_{1\leq j\leq r}\left(
\eta _{dj}\left( v_{1}\right) -\eta _{dj}\left( v_{2}\right) \right) \eta
_{dj}\left( w\right)
\end{equation}%
hence 
\begin{equation}
\sum_{1\leq j\leq r}\left( \eta _{dj}\left( v_{1}\right) -\eta _{dj}\left(
v_{2}\right) \right) =0
\end{equation}%
and thus 
\begin{equation}
v_{1}=v_{2}.\blacksquare
\end{equation}
\end{proof}
\end{lemma}

\begin{remark}
\label{Double Dual} These maps should be contrasted with \emph{the} \emph{%
Double Dualizing Map} $d_{2}=d_{V^{dd}V}\in \mathcal{L}\left(
V^{dd},V\right) $ defined as
\end{remark}

\begin{definition}
\begin{equation}
d_{2}=d_{V^{dd}V}:V\rightarrow V^{dd}
\end{equation}%
by 
\begin{equation}
v_{dd}\left( w_{d}\right) =d_{V^{dd}V}\left( v\right) \left( w_{d}\right)
=w_{d}\left( v\right) \quad \forall w_{d}\in V^{d}.
\end{equation}
\end{definition}

\begin{lemma}
$d_{2}=d_{V^{dd}V}d_{V^{dd}V}$ is an injection.
\end{lemma}

\begin{remark}
Let $\left( \boldsymbol{f}\right) \in \mathfrak{B}\left( V\right) $ then 
\begin{equation}
\left( \boldsymbol{f}_{dd}\right) =\left( \overset{}{d_{2}\left( \boldsymbol{%
f}\right) }\right) .
\end{equation}
\end{remark}

\begin{remark}
This map should be contrasted with the \emph{Double Dualizing Map} $%
d_{V^{ddd}V^{d}}\in \mathcal{L}\left( V^{ddd},V^{d}\right) $ defined as:
\end{remark}

\begin{definition}
\begin{equation}
d_{V^{ddd}V^{d}}:V^{d}\rightarrow V^{ddd}
\end{equation}%
by 
\begin{equation}
v_{ddd}\left( w_{dd}\right) =d_{V^{ddd}V^{d}}\left( v_{d}\right) \left(
w_{dd}\right) =w_{dd}\left( v_{d}\right) \quad \forall w_{dd}\in V^{dd}.
\end{equation}
\end{definition}

\begin{lemma}
$d_{V^{ddd}V^{d}}$ is an injection.
\end{lemma}

\begin{remark}
Let $\left( \boldsymbol{f}_{d}\right) \in \mathfrak{B}\left( V\right) $ then 
\begin{equation}
\left( \boldsymbol{f}_{ddd}\right) =\left( \overset{}{d_{V^{ddd}V^{d}}\left( 
\boldsymbol{f}_{d}\right) }\right) .
\end{equation}
\end{remark}

\paragraph{Biorthogonal bases of $V^{dd}$ and $V^{d}$ \label{Biorthogonal
basis of the dual and double dual}}

\begin{remark}
Let $\left( \boldsymbol{e}\right) $ be a basis of $V$ then $\left( 
\boldsymbol{e}_{dd}\right) =\left( d_{V^{dd}V}\left( \overset{}{\boldsymbol{e%
}}\right) \right) $ is a basis of $\limfunc{Ran}\left\{ d_{V^{dd}V}\right\} $
and we can defined a matrix 
\begin{equation}
\boldsymbol{e}_{dd}\left( \boldsymbol{e}_{b}\right) =\left( \boldsymbol{e}%
_{dd}\right) ^{t}\left( \boldsymbol{e}_{b}\right) =\left[ \left( 
\begin{array}{c}
e_{dd1} \\ 
\vdots \\ 
e_{ddr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{dd1}\left( e_{b1}\right) & \cdots & e_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( e_{b1}\right) & \cdots & e_{ddr}\left( e_{br}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( e_{1}\right) & \cdots & e_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( e_{1}\right) & \cdots & e_{br}\left( e_{r}\right)%
\end{array}%
\right) =\mathbb{I}_{r.},
\end{equation}%
so the basis $\left( \boldsymbol{e}_{dd}\right) $ is biorthogonal to $\left( 
\boldsymbol{e}_{b}\right) $ i.e. $\left( \boldsymbol{e}_{bb}\right) =$ $%
\left( \boldsymbol{e}_{dd}\right) $ as 
\begin{gather}
\left( 
\begin{array}{ccc}
e_{dd1}\left( e_{b1}\right) & \cdots & e_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( e_{b1}\right) & \cdots & e_{ddr}\left( e_{br}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e_{dd1} \\ 
\vdots \\ 
e_{ddr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{dd1}\left( e_{b1}\right) & \cdots & e_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( e_{b1}\right) & \cdots & e_{ddr}\left( e_{br}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
e_{dd1}\left( e_{b1}\right) & \cdots & e_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( e_{b1}\right) & \cdots & e_{ddr}\left( e_{br}\right)%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{cccc}
1 & 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & 1%
\end{array}%
\right) =\mathbb{I}_{r.}
\end{gather}
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\left( 
\begin{array}{c}
e_{bd1} \\ 
\vdots \\ 
e_{bdr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{dd1}\left( e_{b1}\right) & \cdots & e_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( e_{b1}\right) & \cdots & e_{ddr}\left( e_{br}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e_{dd1} \\ 
\vdots \\ 
e_{ddr}%
\end{array}%
\right) \Leftrightarrow \left( \boldsymbol{e}_{bd}\right) =\left( \overset{}{%
\boldsymbol{e}_{dd}\left( \boldsymbol{e}_{b}\right) }\right) ^{-1}\left( 
\boldsymbol{e}_{dd}\right)
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{bd1} & \cdots & e_{bdr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{dd1} & \cdots & e_{ddr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{dd1}\left( e_{b1}\right) & \cdots & e_{dd1}\left( e_{br}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{ddr}\left( e_{b1}\right) & \cdots & e_{ddr}\left( e_{br}\right)%
\end{array}%
\right) ^{-t}\Leftrightarrow \left( \boldsymbol{e}_{bd}\right) ^{t}=\left( 
\boldsymbol{e}_{dd}\right) ^{t}\left( \overset{}{\boldsymbol{e}_{dd}\left( 
\boldsymbol{e}_{b}\right) }\right) ^{-t}
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
\label{Difference between basis transformation and biorthogonalized basis}
In more general notation for any basis $\left( \boldsymbol{f}_{dd}\right) $
of $V^{dd}:$

\begin{enumerate}
\item A basis $\left( \boldsymbol{h}_{bd}\right) $ in $V^{dd}$ biorthogonal
to a basis $\left( \boldsymbol{h}_{d}\right) $ in $V^{d}$ is given by 
\begin{equation}
\left( 
\begin{array}{c}
h_{bd1} \\ 
\vdots \\ 
h_{bdr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{dd1}\left( h_{d1}\right) & \cdots & f_{dd1}\left( h_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{ddr}\left( h_{d1}\right) & \cdots & f_{ddr}\left( h_{dr}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \Leftrightarrow \left( \boldsymbol{h}_{bd}\right) =\left( \overset{}{%
\boldsymbol{f}_{dd}\left( \boldsymbol{h}_{d}\right) }\right) ^{-1}\left( 
\boldsymbol{f}_{dd}\right) ,
\end{equation}%
for any basis $\left( \boldsymbol{f}_{dd}\right) $ of $V^{dd}.$ Its
transpose $\left( \boldsymbol{h}_{bd}\right) ^{t}$ is given by

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
h_{bd1} & \cdots & h_{bdr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{dd1} & \cdots & f_{ddr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{dd1}\left( h_{d1}\right) & \cdots & f_{dd1}\left( h_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{ddr}\left( h_{d1}\right) & \cdots & f_{ddr}\left( h_{dr}\right)%
\end{array}%
\right) ^{-t}\Leftrightarrow \left( \boldsymbol{h}_{bd}\right) ^{t}=\left( 
\boldsymbol{f}_{dd}\right) ^{t}\left( \overset{}{\boldsymbol{f}_{dd}\left( 
\boldsymbol{h}_{d}\right) }\right) ^{-t}.
\end{equation}%
THIS SHOWS THAT $\left( \boldsymbol{h}_{bd}\right) $ IS NOT A BASIS
TRANSFORMATION OF THE BASIS $\left( \boldsymbol{f}_{dd}\right) ,$ which is
given by 
\begin{equation}
\left( 
\begin{array}{ccc}
h_{dd1} & \cdots & h_{ddr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{dd1} & \cdots & f_{ddr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{dd1}\left( h_{d1}\right) & \cdots & f_{dd1}\left( h_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{ddr}\left( h_{d1}\right) & \cdots & f_{ddr}\left( h_{dr}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{dd1} & \cdots & f_{ddr}%
\end{array}%
\right) \mathcal{R}_{f_{dd}}\left( S_{h_{dd}f_{dd}}\right) .
\end{equation}

\begin{remark}
Note that the basis $\left( \boldsymbol{h}_{dd}\right) $ is \textbf{any}
basis of $V^{dd}$ that is not in general related to the basis $\left( 
\boldsymbol{h}_{d}\right) ,$of $V^{d},$ while $\left( \boldsymbol{h}%
_{bd}\right) ,$ which is not equal to $\left( \boldsymbol{h}_{bd}\right) ,$
is \textbf{a particular} basis of $V^{dd}$ that is biorthogonal to the basis 
$\left( \boldsymbol{h}_{d}\right) $ of $V^{d}.$
\end{remark}

\item The following shows that $\left( \boldsymbol{h}_{bd}\right) $ is
biorthogonal to $\left( \boldsymbol{h}_{d}\right) $

\begin{enumerate}
\item 
\begin{equation}
\left[ \left( 
\begin{array}{c}
h_{bd1} \\ 
\vdots \\ 
h_{bdr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
h_{d1} & \cdots & h_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{dd1}\left( h_{d1}\right) & \cdots & f_{dd1}\left( h_{dr}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{ddr}\left( h_{d1}\right) & \cdots & f_{ddr}\left( h_{dr}\right)%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{dd1} \\ 
\vdots \\ 
f_{ddr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
h_{d1} & \cdots & h_{dr}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}%
and

\item that one can form a resolution of the identity 
\begin{equation}
\left( 
\begin{array}{ccc}
h_{d1} & \cdots & h_{dr}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
h_{bd1} \\ 
\vdots \\ 
h_{bdr}%
\end{array}%
\right) \right] =\dsum_{1\leq j\leq r}h_{dj}\left[ h_{bdj}\right] =I_{V^{d}}.
\end{equation}
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{definition}
The overlap matrix $\mathbb{S}_{\eta _{d}e}$ formed by the baiss $\left( 
\boldsymbol{e}\right) $ of $V$ wrt the inner product $\left( \left.
{}\right\vert \right) _{\eta _{d}}$ has matrix elements given by%
\begin{equation}
\mathbb{S}_{\eta _{d}kl}=\left( \left. e_{k}\right\vert e_{l}\right) _{\eta
_{d}}=\left( \overset{}{e_{k}}\right\vert _{\eta _{d}}\left( \overset{}{e_{l}%
}\right) =\left( \sum_{1\leq j\leq r}\eta _{dj}\left( e_{k}\right) \eta
_{dj}\right) \left( \overset{}{e_{l}}\right) =\sum_{1\leq j\leq r}\eta
_{dj}\left( e_{k}\right) \eta _{dj}\left( e_{l}\right) ,
\end{equation}%
which can be written in super vector form as 
\begin{equation}
\mathbb{S}_{\eta _{d}}=\left( \left( \boldsymbol{e}\right\vert _{\eta
_{d}}\right) \left( \left\vert \boldsymbol{e}\right) \right) ^{t}=\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\eta _{d}} \\ 
\vdots \\ 
\left( e_{r}\right\vert _{\eta _{d}}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ,
\end{equation}%
where the dual vectors $\left\{ \left( \overset{}{e_{k}}\right\vert _{\eta
_{d}},1\leq k\leq r\right\} $ are defined by 
\begin{equation}
d_{\eta _{d}}\left( e_{k}\right) =e_{dk}=\left( \overset{}{e_{k}}\right\vert
_{\eta _{d}}=\sum_{1\leq j\leq r}\eta _{dj}\left( \overset{}{e_{k}}\right) %
\left[ \eta _{dj}\right] .
\end{equation}
\end{definition}

\begin{definition}
Biorthogonalizing maps $\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\in 
\mathcal{L}\left( V^{d}\right) $ 
\begin{equation}
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}:V^{d}\rightarrow V^{d}
\end{equation}%
by%
\begin{equation}
\left( 
\begin{array}{c}
v_{b1} \\ 
\vdots \\ 
v_{br}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\left( \overset{}{v_{d1}}\right)
\\ 
\vdots \\ 
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\left( \overset{}{v_{dr}}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
v_{d1} \\ 
\vdots \\ 
v_{dr}%
\end{array}%
\right) .
\end{equation}
\end{definition}

\begin{remark}
In particular%
\begin{equation}
\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\left( \overset{}{e_{d1}}\right)
\\ 
\vdots \\ 
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\left( \overset{}{e_{dr}}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{dr}%
\end{array}%
\right)
\end{equation}%
so that 
\begin{gather}
\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\left( \overset{}{e_{d1}}\right)
\\ 
\vdots \\ 
\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\left( \overset{}{e_{dr}}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\eta _{d}} \\ 
\vdots \\ 
\left( e_{r}\right\vert _{\eta _{d}}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) \\
\parallel \\
\mathbb{I}_{r}
\end{gather}
\end{remark}

\begin{definition}
Biorthogonalizing maps $\mathfrak{b}_{\eta _{d}e_{b}e}\in \mathcal{L}\left(
V\right) $%
\begin{equation}
\mathfrak{b}_{\eta _{d}e_{b}e}:V\rightarrow V
\end{equation}%
by%
\begin{equation}
\left( 
\begin{array}{c}
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{v_{1}}\right) \\ 
\vdots \\ 
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{v_{r}}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
v_{1} \\ 
\vdots \\ 
v_{r}%
\end{array}%
\right) .
\end{equation}
\end{definition}

\begin{remark}
The biorthogonalization map $b_{\eta _{d}e_{b}e}\in \mathcal{L}\left(
V^{d},V\right) $ is given by the two compositions

\begin{enumerate}
\item 
\begin{equation}
b_{\eta _{d}e_{b}e}=d_{\eta _{d}}\circ \mathfrak{b}_{\eta _{d}e_{b}e}
\end{equation}

\item 
\begin{equation}
b_{\eta _{d}e_{b}e}=\widetilde{\mathfrak{b}_{\eta _{d}e_{b}e}}\circ d_{\eta
_{d}}.
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
In particular%
\begin{equation}
\left( 
\begin{array}{c}
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{v_{1}}\right) \\ 
\vdots \\ 
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{v_{r}}\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{e_{d1}}\right) \\ 
\vdots \\ 
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{e_{dr}}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) .
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{c}
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{v_{1}}\right) \\ 
\vdots \\ 
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{v_{r}}\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left\vert \mathfrak{b}_{\eta _{d}e_{b}e}\left( e_{1}\right) \right) _{e_{d}}
\\ 
\vdots \\ 
\left\vert \mathfrak{b}_{\eta _{d}e_{b}e}\left( e_{r}\right) \right) _{e_{d}}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{\left\vert e_{1}\right)
_{e_{d}}}\right) \\ 
\vdots \\ 
\mathfrak{b}_{\eta _{d}e_{b}e}\left( \overset{}{\left\vert e_{r}\right)
_{e_{d}}}\right)%
\end{array}%
\right)
\end{equation}
\end{remark}

\begin{remark}
$\left( \boldsymbol{e}_{b}\right) $ is biorthogonal to $\left( \boldsymbol{e}%
\right) $ 
\begin{gather}
\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( e_{b1}\right\vert \\ 
\vdots \\ 
\left( e_{br}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \mathfrak{b}_{\eta _{d}e_{b}e}\left( e_{1}\right) \right\vert \\ 
\vdots \\ 
\left( \mathfrak{b}_{\eta _{d}e_{b}e}\left( e_{r}\right) \right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e_{dk1} \\ 
\vdots \\ 
e_{dkr}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{1}\right\vert e_{r}\right) _{\eta _{d}} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\eta _{d}} & \cdots & \left(
\left. e_{r}\right\vert e_{r}\right) _{\eta _{d}}%
\end{array}%
\right) \\
\parallel \\
\mathbb{I}_{r}
\end{gather}
\end{remark}

\begin{remark}
\begin{gather}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) _{1} & \cdots & \mathcal{R}_{e}\left(
v\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{b1}\left( v\right) & \cdots & e_{br}\left( v\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1}\left( v\right) \\ 
\vdots \\ 
e_{br}\left( v\right)%
\end{array}%
\right) \\
\parallel \\
\left( \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( v\right) \right) ^{t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \left( v\right)
\end{gather}
\end{remark}

\begin{remark}
\begin{equation}
w_{d}=w_{de_{d}e_{d}}=d_{de_{d}e_{d}}\left( w\right) =\sum_{1\leq j\leq r} 
\left[ e_{dj}\otimes e_{dj}\right] \left( w\otimes \left( \cdot \right)
\right) =\sum_{1\leq j\leq r}e_{dj}\left( w\right) e_{dj}\left( \cdot
\right) ,
\end{equation}%
hence 
\begin{equation}
e_{dk}=\sum_{1\leq j\leq r}\left[ e_{dj}\otimes e_{dj}\right] \left(
e_{k}\otimes \left( \cdot \right) \right) =\sum_{1\leq j\leq r}e_{dj}\left(
e_{k}\right) e_{dj}\left( \cdot \right)
\end{equation}%
and 
\begin{equation}
f_{dk}=\sum_{1\leq j\leq r}\left[ e_{dj}\otimes e_{dj}\right] \left(
f_{k}\otimes \left( \cdot \right) \right) =\sum_{1\leq j\leq r}e_{dj}\left(
f_{k}\right) e_{dj}\left( \cdot \right)
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left( \left. v\right\vert w\right) =\sum_{1\leq j\leq r}e_{bj}\left(
v\right) e_{bj}\left( w\right) =\sum_{1\leq j\leq r}v_{d}\left( e_{j}\right) 
\left[ e_{bj}\right] \left( w\right)
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
I_{V}=\sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] =\sum_{1\leq j\leq
r}e_{j}\left[ e_{bj}\right]
\end{equation}%
\begin{equation}
I_{V}=\sum_{1\leq j\leq r}e_{j}\left[ e_{bj}\right] =\sum_{1\leq j\leq
r}f_{j}\left[ f_{bj}\right]
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left( \boldsymbol{e}\right) ^{t}=S_{ef}\left( \boldsymbol{f}\right)
^{t}=\left( \boldsymbol{e}\right) ^{t}\left[ \boldsymbol{f}_{b}\right]
\left( \boldsymbol{f}\right) ^{t}
\end{equation}
\end{remark}

\subsection{SVD and Dyadic Expansions of Operators}

\begin{enumerate}
\item The components of a \emph{simple} (i.e. \emph{rank 1} ) \emph{%
decomposable} second \emph{order} dual tensor $b_{\rho _{j}\sigma _{j}}\in
V^{d}\otimes V^{d}$ are given in terms of a biorthogonal bases $\left\{
\left( \boldsymbol{e}_{b}\right) ,\left( \boldsymbol{e}\right) \right\} $ by

\begin{enumerate}
\item 
\begin{equation}
b_{\rho _{j}\sigma _{j}}=\rho _{bj}\otimes \sigma _{bj}=\sum_{1\leq k,l\leq
r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k}%
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{l}=\sum_{1\leq k,l\leq
r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho
_{bj}\otimes \sigma _{bj}\right) _{kl}=\sum_{1\leq k,l\leq r}e_{bk}\otimes
e_{bl}\left( \overset{}{\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) \otimes 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) }\right) _{kl},
\end{equation}%
where

\item 
\begin{eqnarray}
\rho _{bj} &=&\sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e_{b}}\left( \rho
_{bj}\right) _{kj}\in V^{d} \\
\sigma _{bj} &=&\sum_{1\leq l\leq r}e_{bl}\mathcal{R}_{e_{b}}\left( \sigma
_{bj}\right) _{lj}\in V^{d}
\end{eqnarray}%
they
\end{enumerate}

\item combine together to form a dual tensor $b_{\rho \sigma }\in
V^{d}\otimes V^{d}$

\begin{enumerate}
\item $b_{\rho \sigma }$ can be expanded as 
\begin{gather}
b_{\rho \sigma }=\sum_{1\leq l\leq r}\rho _{bj}\otimes \sigma
_{bj}=\sum_{1\leq j\leq p\leq r}\left( \sum_{1\leq k,l\leq r}e_{bk}\otimes
e_{bl}\mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{kl}\right) =\sum_{1\leq j\leq p\leq r}\left( \sum_{1\leq k,l\leq
r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k}%
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{l}\right) \\
=\sum_{1\leq j\leq p\leq r}\left( \sum_{1\leq k,l\leq r}e_{bk}\otimes
e_{bl}\left( \overset{}{\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) \otimes 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) }\right) _{kl}\right)
=\sum_{1\leq k,l\leq r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}\otimes
e_{b}}\left( b_{\rho \sigma }\right) _{kl}=\left( 
\begin{array}{ccc}
e_{b1}\otimes e_{b1} & \cdots & e_{br}\otimes e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) _{rr}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
e_{b1}\otimes e_{b1} & \cdots & e_{br}\otimes e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sum_{1\leq j\leq p\leq r}\mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho
_{bj}\otimes \sigma _{bj}\right) _{11} \\ 
\vdots \\ 
\sum_{1\leq j\leq p\leq r}\mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho
_{bj}\otimes \sigma _{bj}\right) _{rr}%
\end{array}%
\right) =\sum_{1\leq j\leq p\leq r}\left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{r}%
\end{array}%
\right) \right) \otimes \left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{r}%
\end{array}%
\right) \right)
\end{gather}

\item $b_{\rho \sigma }$ can also be expanded as%
\begin{eqnarray}
b_{\rho \sigma } &=&\sum_{1\leq l\leq r}\rho _{bj}\otimes \sigma
_{bj}=\left( 
\begin{array}{ccc}
\rho _{b1} & \cdots & \rho _{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{1} & 
\cdots & \sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e_{b}}\left( \rho
_{bj}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sum_{1\leq l\leq r}e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{1}
\\ 
\vdots \\ 
\sum_{1\leq l\leq r}e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{r}%
\end{array}%
\right) \\
&=&\sum_{1\leq k,l\leq r}\left( 
\begin{array}{ccc}
e_{bk}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k1} & \cdots & e_{bk}%
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{kr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{l1} \\ 
\vdots \\ 
e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{lr}%
\end{array}%
\right) \\
&=&\sum_{1\leq k,l\leq r}\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{11} & \cdots & \mathcal{R}%
_{e_{b}}\left( \rho _{bj}\right) _{r1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{r1} & \cdots & \mathcal{R}%
_{e_{b}}\left( \rho _{bj}\right) _{rr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{11} & \cdots & \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{l1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{lr} & \cdots & \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{rr}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \\
&=&\left( \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{11} & \cdots & \mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho _{bj}\otimes
\sigma _{bj}\right) _{kl} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{kl} & \cdots & \mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho _{bj}\otimes
\sigma _{bj}\right) _{rr}%
\end{array}%
\right) \\
&=&\left( \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{1}\otimes \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{1} & \cdots & \mathcal{R}_{e_{b}}\left(
\rho _{bj}\right) _{1}\otimes \mathcal{R}_{e_{b}}\left( \sigma _{bj}\right)
_{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{r}\otimes \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{1} & \cdots & \mathcal{R}_{e_{b}}\left(
\rho _{bj}\right) _{r}\otimes \mathcal{R}_{e_{b}}\left( \sigma _{bj}\right)
_{r}%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}

\item $b_{\rho \sigma }$ can be mapped into an operator $\Xi _{VV^{d}}\left(
b_{\rho \sigma }\right) \in \mathcal{L}\left( V\right) $ by 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\Xi _{VV^{d}}\left( \sum_{1\leq
k,l\leq r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}\otimes e_{b}}\left( b_{\rho
\sigma }\right) _{kl}\right) =\sum_{1\leq k,l\leq r}e_{k}\otimes \left[
e_{bl}\right] \mathcal{R}_{e_{b}\otimes e_{b}}\left( b_{\rho \sigma }\right)
_{kl}=\sum_{1\leq k,l\leq r}e_{k}\otimes \left[ e_{bl}\right] \mathcal{R}%
_{e_{b}\otimes e_{b}}\left( \sum_{1\leq j\leq p}\rho _{bj}\otimes \sigma
_{bj}\right) _{kl},
\end{equation}

\item where 
\begin{equation}
\mathcal{R}_{e_{b}\otimes e_{b}}\left( b_{\rho \sigma }\right)
_{kl}=\sum_{1\leq j\leq p}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k}%
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{l}=\sum_{1\leq j\leq p}%
\mathcal{R}_{e_{b}\otimes e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{kl}.
\end{equation}

\item The operator $\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) $ has the
expansion 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\left( \boldsymbol{e}%
_{b}\right) ^{t}\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) \left[
\left( \boldsymbol{e}\right) \right] .
\end{equation}

\item The matrix $\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) $ can
always be brought to SVD form i.e 
\begin{equation}
\mathcal{R}_{e_{b}\otimes e_{b}}\left( b_{\rho \sigma }\right) =\mathbb{U}%
_{\rho \sigma }\U{3a3} _{\rho \sigma }\mathbb{V}_{\rho \sigma }^{\dagger },
\end{equation}%
where

\begin{enumerate}
\item $\mathbb{U}$ is an $m\times m$ unitary matrix, which can be enlarged
by 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{O}_{m\left( n-m\right) } \\ 
\mathbb{O}_{\left( n-m\right) m} & \mathbb{U}^{c}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
\mathbb{UU}^{\dagger }=\mathbb{I}_{m}
\end{equation}%
and 
\begin{equation}
\mathbb{U}^{c}\mathbb{U}^{c\dagger }=\mathbb{I}_{\left( n-m\right) },
\end{equation}%
where obviously $\mathbb{U}^{c}$ is non unique.

\item $\U{3a3} $ is an $m\times n$ rectangular diagonal matrix with the
singular values $\lambda _{i}\geq 0$ on its diagonal. $\U{3a3} $ can be
enlarged to a $n\times n$ matrix by adding zero entries.

\item $\mathbb{V}$ is an $n\times n$ unitary matrix.

\item $n\geq m$ as $n=\dim \left\{ \limfunc{Dom}\left( \Xi _{VV^{d}}\left(
b_{\rho \sigma }\right) \right) \right\} $ and $m=\dim \left\{ \limfunc{Ran}%
\left( \Xi _{VV^{d}}\left( b_{\rho \sigma }\right) \right) \right\} .$
\end{enumerate}

\item Hence using the expanded matrices 
\begin{equation}
\mathcal{R}_{e_{b}}\left( \overset{}{\Xi _{VV^{d}}\left( b_{\rho \sigma
}\right) }\right) =\mathcal{R}_{e_{b}}\left( \overset{}{\left( \boldsymbol{e}%
\right) ^{t}\mathbb{U}_{\rho }\U{3a3} _{\rho \sigma }\mathbb{V}_{\sigma
}^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right] }\right) =%
\mathcal{R}_{e_{b}}\left( \overset{}{\left( \boldsymbol{u}_{\rho }\right)
^{t}\U{3a3} _{\rho \sigma }\left[ \left( \boldsymbol{v}_{\sigma b}\right) %
\right] }\right) =\mathcal{R}_{e_{b}}\left( \overset{}{\left( \rho \right)
^{t}\left[ \left( \boldsymbol{\sigma }_{b}\right) \right] }\right) ,
\end{equation}%
one obtains the operator $\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) \in 
\mathcal{L}\left( V\right) $ 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\left( \boldsymbol{e}\right)
^{t}\mathbb{U}_{\rho }\U{3a3} _{\rho \sigma }\mathbb{V}_{\sigma }^{\dagger }%
\left[ \left( \boldsymbol{e}_{b}\right) \right] =\left( \boldsymbol{u}_{\rho
}\right) ^{t}\U{3a3} _{\rho \sigma }\left[ \left( \boldsymbol{v}_{\sigma
b}\right) \right] =\left( \rho \right) ^{t}\left[ \left( \boldsymbol{\sigma }%
_{b}\right) \right] ,
\end{equation}%
where the unitary transformations define $\left( \boldsymbol{u}_{\rho
}\right) \in V$ and $\left( \boldsymbol{v}_{\sigma b}\right) \in V^{d}$ by 
\begin{equation}
\left( \boldsymbol{u}_{\rho }\right) ^{t}=\left( \boldsymbol{e}\right) ^{t}%
\mathbb{U}_{\rho }
\end{equation}%
and 
\begin{equation}
\left[ \left( \boldsymbol{v}_{\sigma b}\right) \right] =\mathbb{V}_{\sigma
}^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right] .
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\left( \boldsymbol{u}_{\rho }\right) ^{t}\left[ \left( \boldsymbol{v}%
_{b}\right) \right] =\left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }%
\mathbb{V}_{\sigma }^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) %
\right]
\end{equation}%
\begin{equation}
\left[ \left( \boldsymbol{v}_{b}\right) \right] \left( \boldsymbol{u}_{\rho
}\right) ^{t}=\mathbb{V}_{\sigma }^{\dagger }\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }
\end{equation}

\item 
\begin{eqnarray}
\left( \boldsymbol{u}_{\rho }\right) ^{t} &=&\left( \boldsymbol{e}\right)
^{t}\mathbb{U}_{\rho }\Leftrightarrow \left( \boldsymbol{u}_{\rho }\right) =%
\mathbb{U}_{\rho }^{t}\left( \boldsymbol{e}\right) \\
\left( \boldsymbol{v}_{\sigma b}\right) &=&\mathbb{V}_{\sigma }^{\dagger
}\left( \boldsymbol{e}_{b}\right) \Leftrightarrow \left( \boldsymbol{v}%
_{\sigma b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\overline{%
\mathbb{V}_{\sigma }}
\end{eqnarray}

\item $\left\{ \left( \boldsymbol{u}\right) ,\left( \boldsymbol{u}%
_{b}\right) \right\} $ and $\left\{ \left( \boldsymbol{v}\right) ,\left( 
\boldsymbol{v}_{b}\right) \right\} $ \emph{are biorthogonal bases} i.e. 
\begin{eqnarray}
\left( \boldsymbol{u}_{\rho }\right) ^{t}\left[ \left( \boldsymbol{u}_{\rho
b}\right) \right] &=&\left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }%
\mathbb{U}_{\rho }^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right]
=\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =I_{n} \\
\left( \boldsymbol{v}_{\sigma }\right) ^{t}\left[ \left( \boldsymbol{v}%
_{\sigma b}\right) \right] &=&\left( \boldsymbol{e}\right) ^{t}\mathbb{V}%
_{\sigma }\mathbb{V}_{\sigma }^{\dagger }\left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( \boldsymbol{e}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{b}\right) \right] =I_{n}
\end{eqnarray}%
and 
\begin{eqnarray}
\left[ \left( \boldsymbol{u}_{\rho b}\right) \right] \left( \boldsymbol{u}%
_{\rho }\right) ^{t} &=&\left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }%
\mathbb{U}_{\rho }^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right]
=\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =\mathbb{I}_{n} \\
\left[ \left( \boldsymbol{v}_{\sigma b}\right) \right] \left( \boldsymbol{v}%
_{\sigma }\right) ^{t} &=&\mathbb{V}_{\sigma }^{\dagger }\left[ \left( 
\boldsymbol{e}_{b}\right) \right] \left( \boldsymbol{e}\right) ^{t}\mathbb{V}%
_{\sigma }=\left[ \left( \boldsymbol{e}_{b}\right) \right] \left( 
\boldsymbol{e}\right) ^{t}=\mathbb{I}_{n}.
\end{eqnarray}
\end{enumerate}

\item 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =U\lambda V=\left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( U\right) \mathcal{R}_{e}\left( \lambda
\right) \mathcal{R}_{e}\left( V\right) \left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{m}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathbb{U}_{\rho 11} & \cdots & \mathbb{U}_{\rho 1m} \\ 
\vdots & \ddots & \vdots \\ 
\mathbb{U}_{\rho m1} & \cdots & \mathbb{U}_{\rho mm}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\boldsymbol{\lambda }_{\left( m,m\right) } & \mathbb{O}_{m\left( n-m\right) }
\\ 
\mathbb{O}_{\left( n-m\right) n} & \mathbb{O}_{n-m},_{n-m}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathbb{V}_{\sigma 11} & \cdots & \mathbb{V}_{\sigma 1n} \\ 
\vdots & \ddots & \vdots \\ 
\mathbb{V}_{\sigma n1} & \cdots & \mathbb{V}_{\sigma nn}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{bn}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
\boldsymbol{\lambda }_{\left( m,m\right) }=\left( 
\begin{array}{cccc}
\lambda _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \cdots & 0 \\ 
0 & \cdots & 0 & \lambda _{m}%
\end{array}%
\right) .
\end{equation}

\item This SVD expression can be extended to singular operators by 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\left( 
\begin{array}{ccc}
u_{\rho 1} & \cdots & u_{\rho n}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\boldsymbol{\lambda }_{\left( m,m\right) } & \mathbb{O}_{m\left( n-m\right) }
\\ 
\mathbb{O}_{\left( n-m\right) n} & \mathbb{O}_{n-m},_{n-m}%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{\sigma b1} \\ 
\vdots \\ 
v_{\sigma bn}%
\end{array}%
\right) =\left( \boldsymbol{u}_{\rho }\right) ^{t}\mathcal{R}_{e}\left(
\lambda \right) \left[ \left( \boldsymbol{v}_{\sigma b}\right) \right]
=\left( \rho \right) ^{t}\left[ \left( \boldsymbol{\sigma }_{b}\right) %
\right] ,
\end{equation}%
where we have enlarged the range space by appending the vectors $\left\{
u_{\rho m+1,\cdots ,}u_{\rho n}\right\} .$
\end{enumerate}

\section{Inner Products}

Let $V$ be a complex $r$-dimensional vector space where 
\begin{equation}
\dim \left\{ V\right\} =r.
\end{equation}

\begin{remark}
\begin{enumerate}
\item The embeding (injection) $\mathfrak{i}_{V^{dd}V}$ of $V$ into $V^{dd}$
through the basis $\left( \boldsymbol{e}\right) $ is given by the identities 
\begin{equation}
e_{ddj}\left( y_{bk}\right) \overset{\Delta }{=}y_{dk}\left( e_{j}\right)
,\quad 1\leq j,k\leq r.
\end{equation}

\item The embeding (injection) $\mathfrak{i}_{V^{ddd}V^{dd}}$ of $V^{d}$
into $V^{ddd}$ through the basis $\left( \boldsymbol{e}\right) $ is given by
the identities 
\begin{equation}
e_{dddj}\left( y_{ddk}\right) \overset{\Delta }{=}y_{ddk}\left(
e_{dj}\right) ,\quad 1\leq j,k\leq r.
\end{equation}
\end{enumerate}
\end{remark}

\begin{definition}
In general \emph{all bilinear forms} $\left( \left\vert {}\right\vert
\right) _{\rho \sigma }\in \mathfrak{Bil}\left( V\right) $ are defined by 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=b_{\rho \sigma }\left(
v,w\right) =\left[ \Xi _{\left( V\otimes V\right) ^{d}}\left( b_{\rho \sigma
}\right) \right] \left( v\otimes w\right) \equiv b_{\rho \sigma }^{d},\quad %
\left[ \Xi _{\left( V\otimes V\right) ^{d}}\left( b_{\rho \sigma }\right) %
\right] \in \left( V\otimes V\right) ^{d}=\limfunc{linfunc}\left\{ V\otimes
V\right\} ,
\end{equation}%
where the map betwen the space of bilinear forms $\mathfrak{Bil}\left(
V\right) $ and the dual space of second rank tensors is denoted by 
\begin{equation}
\Xi _{\left( V\otimes V\right) ^{d}}:\mathfrak{Bil}\left( V\right)
\rightarrow \left( V\otimes V\right) ^{d}.
\end{equation}
\end{definition}

\begin{definition}
\emph{Bilinear forms} $\left( \left. {}\right\vert \right) _{\rho \sigma
}\in \mathfrak{Bil}\left( V\right) $ are \emph{pre} \emph{inner product} in $%
V$
\end{definition}

\begin{definition}
\emph{Non degenerate} \emph{bilinear forms} $\left( \left. {}\right\vert
\right) _{\rho \sigma }\in \mathfrak{Bil}\left( V\right) $ are \emph{inner
product} in $V.$
\end{definition}

\begin{definition}
Standard Bi Linear forms $b_{\rho \rho }\in \mathfrak{SBil}\left( V\right) $
defined on $V$ are 
\begin{equation}
b_{\rho \rho }=\sum_{1\leq l\leq r}\rho _{dj}\otimes \rho _{dj}
\end{equation}%
with values 
\begin{equation}
b_{\rho \rho }\left( v,w\right) =\sum_{1\leq l\leq r}\rho _{dj}\left(
v\right) \rho _{dj}\left( w\right) .
\end{equation}
\end{definition}

\begin{definition}
Standard Inner products $\left( \left\vert {}\right\vert \right) _{\rho \rho
}\in \mathfrak{SBil}\left( V\right) $ defined on $V$ are%
\begin{equation}
\left( \left\vert {}\right\vert \right) _{\rho \rho }=b_{\rho \rho }.
\end{equation}
\end{definition}

\begin{lemma}
Standard bilinear forms and inner products are symmetric.

\begin{proof}
self evident from 
\begin{equation}
b_{\rho \rho }\left( v,w\right) =\sum_{1\leq l\leq r}\rho _{dj}\left(
v\right) \rho _{dj}\left( w\right) .
\end{equation}
\end{proof}
\end{lemma}

\begin{definition}
Let $T\in \mathcal{L}\left( V\right) $ then the $\rho $\emph{-transpose} of $%
T^{t_{\rho }}$ is defined by 
\begin{equation}
\left( \left. T^{t_{\rho }}v\right\vert w\right) _{\rho \rho }=\left( \left.
v\right\vert Tw\right) _{\rho \rho }\quad \forall w\in V,\,\text{for any }%
v\in V,
\end{equation}%
which can be equivalently stated as 
\begin{equation}
\left( \left. T^{t_{\rho }}v\right\vert w\right) _{\rho \rho }=\left( \left.
v\right\vert Tw\right) _{\rho \rho }\quad \forall v,w\in V.
\end{equation}
\end{definition}

\begin{lemma}
$t_{\rho }\in \mathcal{L}\left( V\right) $ is an involution i.e. 
\begin{equation}
\left( \overset{}{\left( T^{t_{\rho }}\right) ^{t_{\rho }}}\right) \left( 
\overset{}{v}\right) =v,
\end{equation}%
i.e. 
\begin{equation}
\left( T^{t_{\rho }}\right) ^{t_{\rho }}=I_{V}.
\end{equation}
\end{lemma}

\begin{definition}
An operator $A\in \mathcal{L}\left( V\right) $ is $t_{\rho }$\emph{-symmetric%
} if 
\begin{equation}
A^{t_{\rho }}=A.
\end{equation}
\end{definition}

\begin{theorem}
All standard inner products $\left( \left. {}\right\vert \right) _{\sigma
\sigma }$ are related to the standard inner product $\left( \left.
{}\right\vert \right) _{\rho \rho }$ by a $t_{\rho }$-symmetric operators $%
S_{\rho \sigma }^{t_{\rho }}S_{\rho \sigma }\in \mathcal{L}\left( V\right) $
i.e. 
\begin{equation}
\left( \left. v\right\vert w\right) _{\sigma \sigma }=\left( \left.
v\right\vert S_{\rho \sigma }^{t_{\rho }}S_{\rho \sigma }w\right) _{\rho
\rho }.
\end{equation}

\begin{proof}
The inner products $\left( \left. {}\right\vert \right) _{\sigma \sigma }$
and $\left( \left. {}\right\vert \right) _{\rho \rho }$ are defined by 
\begin{eqnarray}
\left( \left. v\right\vert w\right) _{\sigma \sigma } &=&\sum_{1\leq j\leq
r}\sigma _{dj}\left( v\right) \sigma _{dj}\left( w\right) \\
\left( \left. v\right\vert w\right) _{\rho \rho } &=&\sum_{1\leq j\leq
r}\rho _{dj}\left( v\right) \rho _{dj}\left( w\right) .
\end{eqnarray}%
The dual space bases $\left( \boldsymbol{\rho }_{d}\right) $ and $\left( 
\boldsymbol{\sigma }_{d}\right) $ are related by 
\begin{equation}
\left( \boldsymbol{\rho }_{d}\right) ^{t}=S_{\rho _{d}\sigma _{d}}\left( 
\boldsymbol{\sigma }_{d}\right) ^{t}.
\end{equation}%
This gives 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \rho }=\sum_{1\leq j\leq r}\rho
_{dj}\left( v\right) \rho _{dj}\left( w\right) =\left( \left. v\right\vert
w\right) _{\rho \rho }=\sum_{1\leq j\leq r}S_{\rho _{d}\sigma _{d}}\sigma
_{dj}\left( v\right) S_{\rho _{d}\sigma _{d}}\sigma _{dj}\left( w\right)
\end{equation}%
Using 
\begin{equation}
d\left( A\right) f=fA
\end{equation}%
one obtains 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \rho }=\sum_{1\leq j\leq
r}S_{\rho _{d}\sigma _{d}}\sigma _{dj}\left( v\right) S_{\rho _{d}\sigma
_{d}}\sigma _{dj}\left( w\right) =\sum_{1\leq j\leq r}\sigma _{dj}\left(
S_{\rho \sigma }v\right) \sigma _{dj}\left( S_{\rho \sigma }w\right) =\left(
\left. S_{\rho \sigma }v\right\vert S_{\rho \sigma }w\right) _{\sigma \sigma
}=\left( \left. v\right\vert S_{\rho \sigma }^{t_{\sigma }}S_{\rho \sigma
}w\right) _{\sigma \sigma },
\end{equation}%
where 
\begin{equation}
S_{\rho _{d}\sigma _{d}}=d\left( S_{\rho \sigma }\right)
\end{equation}%
i.e. 
\begin{equation}
\left( \left. {}\right\vert \right) _{\rho \rho }=\left( \left. \overset{%
\overset{}{}}{\cdot }\right\vert \left( \overset{}{S_{\rho _{d}\sigma
_{d}}^{t_{\sigma }}S_{\rho _{d}\sigma _{d}}}\right) \cdot \right) _{\sigma
\sigma }\blacksquare
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
Representations of vectors are given by 
\begin{eqnarray}
v &=&\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\sigma }\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\sigma }\left( v\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sigma _{1b}\left( v\right) \\ 
\vdots \\ 
\sigma _{1r}\left( v\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\sigma _{1b} \\ 
\vdots \\ 
\sigma _{1r}%
\end{array}%
\right) \right] \left( v\right) \\
&=&\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
\sigma _{1b} \\ 
\vdots \\ 
\sigma _{1r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \right) ^{-1}\left[ \left( 
\begin{array}{c}
\sigma _{1b} \\ 
\vdots \\ 
\sigma _{1r}%
\end{array}%
\right) \right] \left( v\right) =\left( 
\begin{array}{ccc}
\sigma _{1} & \cdots & \sigma _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. \sigma _{1}\right\vert \sigma _{1}\right) _{\rho \rho } & 
\cdots & \left( \left. \sigma _{1}\right\vert \sigma _{r}\right) _{\rho \rho
} \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. \sigma _{r}\right\vert \sigma _{1}\right) _{\rho \rho } & 
\cdots & \left( \left. \sigma _{r}\right\vert \sigma _{r}\right) _{\rho \rho
}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\sigma _{1}\left( v\right) \\ 
\vdots \\ 
\sigma _{1}\left( v\right)%
\end{array}%
\right) ,
\end{eqnarray}%
which can be recast as 
\begin{equation}
v=\left( \boldsymbol{\sigma }\right) ^{t}\mathcal{R}_{\sigma }\left(
v\right) =\left( \boldsymbol{\sigma }\right) ^{t}\left[ \boldsymbol{\sigma }%
_{b}\right] \left( v\right) =\left( \overset{}{\boldsymbol{\sigma }}\right)
^{t}\left( \overset{}{\boldsymbol{\sigma }_{d}\left( \boldsymbol{\sigma }%
\right) }\right) ^{-1}\left[ \overset{}{\boldsymbol{\sigma }_{d}}\right]
\left( v\right) =\left( \overset{}{\boldsymbol{\sigma }}\right) ^{t}\left( 
\overset{}{\left. \boldsymbol{\sigma }\right\vert \boldsymbol{\sigma }}%
\right) _{\rho \rho }^{-1}\left[ \overset{}{\boldsymbol{\sigma }_{d}}\right]
\left( v\right) .
\end{equation}
\end{remark}

\begin{remark}
Change of basis gives

\begin{enumerate}
