\right) \right\vert \boldsymbol{e}\right) _{\rho _{d}\sigma _{d}} \\
\parallel  \\
\left[ \left( 
\begin{array}{c}
\left( \mathfrak{b}_{e\rho _{d}\sigma _{d}}\left( e_{1}\right) \right\vert
_{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( \mathfrak{b}_{e\rho _{d}\sigma _{d}}\left( e_{r}\right) \right\vert
_{\rho _{d}\sigma _{d}}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right)  \\
\parallel  \\
\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{1}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\left( \left. e_{r}\right\vert e_{1}\right) _{\rho _{d}\sigma _{d}} & \cdots 
& \left( \left. e_{r}\right\vert e_{r}\right) _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) ^{\boldsymbol{-}1}\left[ \left( 
\begin{array}{c}
\left( e_{1}\right\vert _{\rho _{d}\sigma _{d}} \\ 
\vdots  \\ 
\left( e_{r}\right\vert _{\rho _{d}\sigma _{d}}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
\left\vert e_{1}\right)  & \cdots  & \left\vert e_{r}\right) 
\end{array}%
\right) =\mathbb{I}_{r}.
\end{gather}
\end{enumerate}

\item In row form 
\begin{gather}
\left( \left\vert \overset{}{\mathfrak{b}_{e\rho _{d}\sigma _{d}}\left( 
