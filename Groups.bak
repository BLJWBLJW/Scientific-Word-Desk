where
\begin{equation}
L_{1}\left(  X_{e}\right)  =\sum_{1\leq n\leq4}\binom{n}{1}L_{n}^{1}\left(
X_{en}\right)  =\binom{1}{1}L_{1}^{1}\left(  X_{e1}\right)  +\binom{2}{1}%
L_{2}^{1}\left(  X_{e2}\right)  +\binom{3}{1}L_{3}^{1}\left(  X_{e3}\right)
+\binom{4}{1}L_{4}^{1}\left(  X_{e4}\right)
\end{equation}
and $\ker\left\{  L_{1}\right\}  $ has direct sum expansions
\begin{align}
\ker\left\{  L_{1}\right\}   &  =\ker\left\{  L_{1}\right\}  _{0d}\oplus
\ker\left\{  L_{1}\right\}  _{1d}\oplus\ker\left\{  L_{1}\right\}  _{2d}%
\oplus\ker\left\{  L_{1}\right\}  _{3d}\oplus\ker\left\{  L_{1}\right\}
_{4d}\\
&  =\ker\left\{  L_{1}^{1}\right\}  \oplus\ker\left\{  L_{2}^{1}\right\}
\oplus\ker\left\{  L_{3}^{1}\right\}  \oplus\ker\left\{  L_{4}^{1}\right\}  ,
\end{align}
where
\begin{equation}
\ker\left\{  L_{n}^{1}\right\}  =%
%TCIMACRO{\tbigoplus \limits_{0\leq j\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq j\leq4}}
%EndExpansion
\ker\left\{  L_{n}^{p}\right\}  _{jd};\,1\leq n\leq r.
\end{equation}


\begin{enumerate}
\item Zero difference%
\begin{align}
\ker\left\{  L_{1}\right\}  _{0d}  &  =\mathcal{B}_{1}\left(  \mathbb{C}%
^{16}\right)  _{e0d}\cap\ker\left\{  L_{1}\right\}  =\operatorname*{linspan}%
\left\{  \left(  \left\vert 12\right\rangle \left\langle 12\right\vert
-\left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
24\right\rangle \left\langle 24\right\vert +\left\vert 34\right\rangle
\left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 23\right\vert +\left\vert 24\right\rangle
\left\langle 24\right\vert ,\left(  \mathbf{2}\right)  \right)  \right\}
\end{align}
giving%
\begin{equation}
\dim\left\{  \ker\left\{  L_{1}\right\}  _{0d}\right\}  =2.
\end{equation}


