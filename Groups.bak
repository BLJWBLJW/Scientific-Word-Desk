\begin{example}
$r=3,p=2,\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0}  &  =\left\{  \left.
zI_{\mathcal{H}^{2}}\right\vert z\neq0\in\mathbb{C}\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }  &
=\left\{  \left(  \left\vert 12\right\rangle \left\langle 12\right\vert
-\left\vert 13\right\rangle \left\langle 13\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
23\right\rangle \left\langle 23\right\vert \right)  \right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1-2\right)  }  &
=\left\{  \left\vert 12\right\rangle \left\langle 13\right\vert ,\left\vert
12\right\rangle \left\langle 23\right\vert ,\left\vert 13\right\rangle
\left\langle 12\right\vert ,\left\vert 13\right\rangle \left\langle
23\right\vert ,\left\vert 23\right\rangle \left\langle 12\right\vert
,\left\vert 23\right\rangle \left\langle 13\right\vert \right\}
\end{align}
and%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0}^{c}=sl\left(
2,\mathbb{C}\right)  .
\end{equation}

\end{example}

\begin{remark}
All projectors belonging to $\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  $
can be expressed as
\begin{gather}
P=\mathcal{B}_{1}\text{-}\lim\limits_{r\rightarrow\infty}\sum_{1\leq
j\leq\kappa}\left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{j}\right\vert \\
1\leq\kappa\leq r.
\end{gather}

\end{remark}

\begin{remark}
Linearly independent projectors when $\kappa=r$
\begin{equation}
\alpha\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{j}\right\vert +\beta\sum_{1\leq j\leq r}\left\vert \psi
_{j}\right\rangle \left\langle \psi_{j}\right\vert =0\Rightarrow\alpha=-\beta
\end{equation}%
\begin{equation}
\alpha\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{j}\right\vert +\beta\left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert =0\Rightarrow\alpha=\beta=0
\end{equation}%
\begin{equation}
I-\left(  I-\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert
\right)  =\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert
\end{equation}%
\begin{equation}
\alpha\left(  I-P\right)  +\beta I=0\Rightarrow\alpha+\beta=0\quad
\&\quad\alpha=0\Rightarrow\beta=0.
\end{equation}

\end{remark}

\begin{remark}
$\left\{  \left.  P\left(  r\right)  \right\vert 1\leq r\leq\infty\right\}  $
are \emph{sequential Approximate Identities} in $\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  $, where
\begin{equation}
P\left(  r\right)  =\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{j}\right\vert .
\end{equation}

\end{remark}

\begin{lemma}
If $X\in\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  ,$ and
$\operatorname{Tr}\left\{  X\right\}  \in\left(  -\infty,0\right)  \cup\left(
0,\infty\right)  ,$ where $\dim\left\{  \mathcal{H}^{1}\right\}  =r\in\left[
0,\infty\right]  $ then $X\notin\operatorname{Ker}\left\{  \operatorname{Tr}%
_{\mathcal{H}^{1}}\right\}  $ and
\begin{equation}
X=X_{0}+X_{T0},
\end{equation}
where
\begin{equation}
X_{T0}\in\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}%
}\right\}
\end{equation}
and
\begin{equation}
X_{0}\notin\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}%
}\right\}  .
\end{equation}

\end{lemma}

\begin{lemma}
$X_{0}$ and $X_{T0}$ are linearly independent
\end{lemma}

\begin{proof}%
\begin{align}
\alpha X_{0}+\beta X_{T0}  &  =0\Rightarrow\alpha X_{0}=-\beta X_{T0}\\
\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  X_{0}\right\}   &  \neq
0\Rightarrow\alpha=0\\
&  \Rightarrow\beta X_{T0}=0\\
\text{ }X_{T0}  &  \neq0\text{ }\Rightarrow\beta=0
\end{align}
hence
\begin{equation}
\alpha X_{0}+\beta X_{T0}=0\Rightarrow\alpha=\beta=0
\end{equation}
and $X_{0}$ and $X_{T0}$ are linearly independent.
\end{proof}

\begin{lemma}%
\begin{equation}
X=\sum_{1\leq j\leq r}\lambda_{j}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{j}\right\vert =X_{0}+\sum_{1\leq j\leq r}\left(
\lambda_{j}-\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  X\right\}  \right)
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{j}\right\vert
=X_{0}+X_{T0},
\end{equation}
where
\begin{equation}
X_{T0}=\sum_{1\leq j\leq r}\left(  \lambda_{j}-\operatorname{Tr}%
_{\mathcal{H}^{1}}\left\{  X\right\}  \right)  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{j}\right\vert .
\end{equation}

\end{lemma}

\begin{remark}
If $r<\infty$
\begin{equation}
X_{0}=\frac{\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  X\right\}  }%
{\dim\left\{  \mathcal{H}^{1}\right\}  }I_{\mathcal{H}^{1}}.
\end{equation}

\end{remark}

\begin{lemma}
If $r=\infty$%
\begin{equation}
P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
^{c}}=P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }%
-P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }%
\end{equation}
\emph{is not a projector}.
\end{lemma}

\begin{proof}%
\begin{align}
\left(  P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }%
-P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
}\right)  ^{2}  &  =P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
}+P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
}-\left(  P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }%
P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
}+P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
}P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }\right) \\
&  =P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }+P_{\operatorname{Ker}%
\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }-P_{\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  }P_{\operatorname{Ker}\left\{
\operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }-P_{\operatorname{Ker}\left\{
\operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }\\
&  =P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }-P_{\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  }P_{\operatorname{Ker}\left\{
\operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }.
\end{align}
If $P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }-P_{\operatorname{Ker}%
\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }$ is idempotent i.e.
\[
P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }-P_{\operatorname{Ker}%
\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }=P_{\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  }+P_{\operatorname{Ker}\left\{
\operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }-P_{\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  }P_{\operatorname{Ker}\left\{  \operatorname{Tr}%
_{\mathcal{H}^{1}}\right\}  }-P_{\operatorname{Ker}\left\{  \operatorname{Tr}%
_{\mathcal{H}^{1}}\right\}  }P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
}%
\]
then
\begin{align}
2P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }
&  =P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }P_{\operatorname{Ker}%
\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }+P_{\operatorname{Ker}%
\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }P_{\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  }=P_{\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  }P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}%
^{1}}\right\}  }+P_{\operatorname{Ker}\left\{  \operatorname{Tr}%
_{\mathcal{H}^{1}}\right\}  }\\
&  \Rightarrow P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}%
^{1}}\right\}  }=P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
}P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }%
\end{align}
If $r<\infty$ then
\begin{equation}
\left(  I_{\mathcal{H}^{1}}-P_{\operatorname{Ker}\left\{  \operatorname{Tr}%
_{\mathcal{H}^{1}}\right\}  }\right)  ^{2}=I_{\mathcal{H}^{1}}%
+P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
}-2P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}
}=I_{\mathcal{H}^{1}}-P_{\operatorname{Ker}\left\{  \operatorname{Tr}%
_{\mathcal{H}^{1}}\right\}  }.
\end{equation}

\end{proof}

\begin{remark}
$P_{\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  }$ and
$P_{\operatorname{Ker}\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }$
are basis independent hence
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{c}=\left\{  \left.
zP_{\operatorname{Tr}_{\mathcal{H}^{1}}}\right\vert z\in\mathbb{C}\right\}
\end{equation}
\newline and
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  _{\ker\left\{  \operatorname{Tr}_{\mathcal{H}^{1}}\right\}  }.
\end{equation}

\end{remark}

\subparagraph{Expansion Maps}

\begin{definition}
The orthogonal complement $V^{\bot}$ of $V$ in the dual space $\mathcal{V}%
^{d}$ is defined by
\begin{equation}
V^{\bot}=\left\{  \left.  y\right\vert \left\langle y,x\right\rangle =0\forall
x\in V\subset\mathcal{V},y\in\mathcal{V}^{d}\right\}  .
\end{equation}

\end{definition}

\begin{remark}
Let
\begin{equation}
L:\mathcal{B}_{1}\left(  \mathcal{V}\right)  \rightarrow\mathcal{B}_{1}\left(
\mathcal{V}\right)
\end{equation}
and
\begin{equation}
V=\ker\left\{  L\right\}
\end{equation}
then $\forall x\in\ker\left\{  L\right\}  \equiv V$
\begin{equation}
\left\langle y,L\left(  x\right)  \right\rangle =\left\langle L^{d}\left(
y\right)  ,x\right\rangle =0
\end{equation}
thus
\begin{equation}
V^{\bot}=\operatorname{Ran}\left\{  L^{d}\right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}  =\ker\left\{  L_{n}%
^{p}\right\}  ^{\bot}.
\end{equation}

\end{remark}

From the definition of $\Gamma_{p}^{n}$ it follows that the ranges of the
expansion maps $\left\{  \left.  \Gamma_{p}^{n}\right\vert 0\leq p\leq
n\right\}  $ are a nested sequence of subspaces which are related by
\begin{equation}
0_{\binom{r}{n}}\subseteq\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}
\subseteq\cdots\subseteq\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}
\subseteq\operatorname{Ran}\left\{  \Gamma_{p+1}^{n}\right\}  \subseteq
\cdots\subseteq\operatorname{Ran}\left\{  \Gamma_{n-1}^{n}\right\}
\subseteq\operatorname{Ran}\left\{  \Gamma_{n}^{n}\right\}  =\mathcal{B}%
\left(  \mathcal{H}^{n}\right)  ;0\leq p\leq n,
\end{equation}
which allows one to define subspaces
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(
p-1\right)  }=\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}
\ominus\operatorname{Ran}\left\{  \Gamma_{p-1}^{n}\right\}  =\ker\left\{
L_{n}^{p}\right\}  ^{\bot}\ominus\ker\left\{  L_{n}^{p-1}\right\}  ^{\bot
};1\leq p\leq n.
\end{equation}


\begin{example}
$r=4:$The nuclear space $\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  $ is
generated by
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  =\operatorname*{linspan}%
\left\{  \left\vert 1\right\rangle \left\langle 1\right\vert ,\left\vert
1\right\rangle \left\langle 2\right\vert ,\left\vert 1\right\rangle
\left\langle 3\right\vert ,\left\vert 1\right\rangle \left\langle 4\right\vert
,\left\vert 2\right\rangle \left\langle 1\right\vert ,\left\vert
2\right\rangle \left\langle 2\right\vert ,\left\vert 2\right\rangle
\left\langle 3\right\vert ,\left\vert 2\right\rangle \left\langle 4\right\vert
,\left\vert 3\right\rangle \left\langle 1\right\vert ,\left\vert
3\right\rangle \left\langle 2\right\vert ,\left\vert 3\right\rangle
\left\langle 3\right\vert ,\left\vert 3\right\rangle \left\langle 4\right\vert
,\left\vert 4\right\rangle \left\langle 1\right\vert ,\left\vert
4\right\rangle \left\langle 2\right\vert ,\left\vert 4\right\rangle
\left\langle 3\right\vert ,\left\vert 4\right\rangle \left\langle 4\right\vert
\right\}  ,
\end{equation}
which gives
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{2}\right)  =\boxplus^{2}\mathcal{B}%
_{00}\left(  \mathcal{H}^{1}\right)  =\,\,\mathcal{B}_{00}\left(  \wedge
^{2}\mathcal{H}^{1}\right)  .
\end{equation}

\end{example}

\begin{example}
$\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $ and $\mathcal{B}\left(
\mathcal{H}^{2}\right)  $ have the direct sum decompositions
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\,\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(  2\right)  }%
\end{equation}
and
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{2}\right)  =\,\mathcal{B}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}\left(  \mathcal{H}^{2}\right)
_{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}\left(
\mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(  2\right)  },
\end{equation}
where
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{2}\right)  _{\left(  2\right)  -\left(
1\right)  }=\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
2\right)  -\left(  1\right)  }\right)  ^{\bot}=\operatorname{Ran}\left\{
\Gamma_{2}^{2}\right\}  \ominus\operatorname{Ran}\left\{  \Gamma_{1}%
^{2}\right\}  =\ker\left\{  L_{2}^{2}\right\}  ^{\bot}\ominus\ker\left\{
L_{2}^{1}\right\}  ^{\bot}=\left(  \ker\left\{  L_{2}^{1}\right\}  \ominus
\ker\left\{  L_{2}^{2}\right\}  \right)  ^{\bot}%
\end{equation}
and
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(
0\right)  }=\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
1\right)  -\left(  0\right)  }\right)  ^{\bot}=\operatorname{Ran}\left\{
\Gamma_{1}^{2}\right\}  \ominus\operatorname{Ran}\left\{  \Gamma_{0}%
^{2}\right\}  =\ker\left\{  L_{2}^{1}\right\}  ^{\bot}\ominus\ker\left\{
L_{2}^{0}\right\}  ^{\bot}=\left(  \ker\left\{  L_{2}^{0}\right\}  \ominus
\ker\left\{  L_{2}^{1}\right\}  \right)  ^{\bot}.
\end{equation}

\end{example}

\begin{example}
Recall
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(  2\right)
}=\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0}\oplus\left(
\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}
\right)  \oplus\ker\left\{  L_{2}^{1}\right\}  ,
\end{equation}
where%
\begin{align*}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(
2\right)  }  &  \equiv\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2}%
=\ker\left\{  L_{2}^{1}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{\left(  \left(  1\right)  -\left(  2\right)  \right)  2d}%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  \left(
1\right)  -\left(  2\right)  \right)  1d}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\left(  \left(  1\right)  -\left(  2\right)
\right)  0d}\\
&  =\operatorname*{linspan}\left\{  \left\vert 12\right\rangle \left\langle
34\right\vert ,\left\vert 13\right\rangle \left\langle 24\right\vert
,\left\vert 14\right\rangle \left\langle 23\right\vert ,\left\vert
23\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 13\right\vert ,\left\vert 34\right\rangle \left\langle
12\right\vert ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\}
^{\dagger}\\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right)  \right. \\
&  \left.  \left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert +\left\vert 24\right\rangle \left\langle
24\right\vert ,\left(  \mathbf{2}\right)  \right\}  .
\end{align*}
and%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0\right)  -\left(
1\right)  }  &  \equiv\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{1}%
=\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}
=\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  \left(  0\right)
-\left(  1\right)  \right)  1d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{\left(  \left(  0\right)  -\left(  1\right)  \right)  0d}\\
&  =\,\operatorname*{linspan}\left\{  \left(  \left\vert 13\right\rangle
\left\langle 23\right\vert +\left\vert 14\right\rangle \left\langle
24\right\vert \right)  ,\left(  \left\vert 12\right\rangle \left\langle
23\right\vert -\left\vert 14\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 12\right\rangle \left\langle 24\right\vert +\left\vert
13\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \quad\left(  \left\vert 12\right\rangle \left\langle 13\right\vert
+\left\vert 24\right\rangle \left\langle 34\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert +\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\\
&  \quad\left(  \left\vert 13\right\rangle \left\langle 23\right\vert
-\left\vert 14\right\rangle \left\langle 24\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 23\right\vert +\left\vert
14\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
12\right\rangle \left\langle 24\right\vert -\left\vert 13\right\rangle
\left\langle 34\right\vert \right)  ,\\
&  \,\,\,\,\,\left.  \left(  \left\vert 12\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 13\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{12}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert \right)  +\left(  \left\vert 24\right\rangle \left\langle
24\right\vert -\left\vert 34\right\rangle \left\langle 34\right\vert \right)
,\right. \\
&  .\left.  \,\left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert \right)  +\left(
\left\vert 23\right\rangle \left\langle 23\right\vert -\left\vert
24\right\rangle \left\langle 24\right\vert \right)  ,\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  ,\left(  \mathbf{3}\right)  \right\}  .
\end{align}

\end{example}

\begin{example}
Perpendicular subspaces: Directly from the expansion map $\Gamma_{1}^{2}$ one
obtains
\begin{gather}
\operatorname{Ran}\left\{  \Gamma_{1}^{2}\right\}  =\ker\left\{  L_{2}%
^{1}\right\}  ^{\bot}=\Gamma_{1}^{2}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  \right) \\
=\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left\vert 1\right\rangle \left\langle 1\right\vert \boxtimes I_{\mathcal{H}%
^{1}},\left\vert 1\right\rangle \left\langle 2\right\vert \boxtimes
I_{\mathcal{H}^{1}},\left\vert 1\right\rangle \left\langle 3\right\vert
\boxtimes I_{\mathcal{H}^{1}},\left\vert 1\right\rangle \left\langle
4\right\vert \boxtimes I_{\mathcal{H}^{1}},\\
\left\vert 2\right\rangle \left\langle 1\right\vert \boxtimes I_{\mathcal{H}%
^{1}},\left\vert 2\right\rangle \left\langle 2\right\vert \boxtimes
I_{\mathcal{H}^{1}},\left\vert 2\right\rangle \left\langle 3\right\vert
\boxtimes I_{\mathcal{H}^{1}},\left\vert 2\right\rangle \left\langle
4\right\vert \boxtimes I_{\mathcal{H}^{1}},\\
\left\vert 3\right\rangle \left\langle 1\right\vert \boxtimes I_{\mathcal{H}%
^{1}},\left\vert 3\right\rangle \left\langle 2\right\vert \boxtimes
I_{\mathcal{H}^{1}},\left\vert 3\right\rangle \left\langle 3\right\vert
\boxtimes I_{\mathcal{H}^{1}},\left\vert 3\right\rangle \left\langle
4\right\vert \boxtimes I_{\mathcal{H}^{1}},\\
\left\vert 4\right\rangle \left\langle 1\right\vert \boxtimes I_{\mathcal{H}%
^{1}},\left\vert 4\right\rangle \left\langle 2\right\vert \boxtimes
I_{\mathcal{H}^{1}},\left\vert 4\right\rangle \left\langle 3\right\vert
\boxtimes I_{\mathcal{H}^{1}},\left\vert 4\right\rangle \left\langle
4\right\vert \boxtimes I_{\mathcal{H}^{1}}%
\end{array}
\right\}  =\\
\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left(  \left\vert 12\right\rangle \left\langle 12\right\vert +\left\vert
13\right\rangle \left\langle 13\right\vert +\left\vert 14\right\rangle
\left\langle 14\right\vert \right)  ,\,\left(  \left\vert 13\right\rangle
\left\langle 23\right\vert +\left\vert 14\right\rangle \left\langle
24\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle \left\langle
23\right\vert +\left\vert 14\right\rangle \left\langle 34\right\vert \right)
,\,\left(  \left\vert 12\right\rangle \left\langle 24\right\vert -\left\vert
13\right\rangle \left\langle 34\right\vert \right)  ,\\
\left(  \left\vert 23\right\rangle \left\langle 13\right\vert +\left\vert
24\right\rangle \left\langle 14\right\vert \right)  ,\,\left(  \left\vert
12\right\rangle \left\langle 12\right\vert +\left\vert 23\right\rangle
\left\langle 23\right\vert +\left\vert 24\right\rangle \left\langle
24\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle \left\langle
13\right\vert +\left\vert 24\right\rangle \left\langle 34\right\vert \right)
,\,\left(  \left\vert 12\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\\
\left(  \left\vert 34\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 12\right\vert \right)  ,\,\left(  \left\vert
13\right\rangle \left\langle 12\right\vert +\left\vert 34\right\rangle
\left\langle 24\right\vert \right)  ,\,\left(  \left\vert 13\right\rangle
\left\langle 13\right\vert +\left\vert 23\right\rangle \left\langle
23\right\vert +\left\vert 34\right\rangle \left\langle 34\right\vert \right)
,\,\left(  \left\vert 13\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 24\right\vert \right)  ,\\
\left(  \left\vert 34\right\rangle \left\langle 13\right\vert +\left\vert
24\right\rangle \left\langle 12\right\vert \right)  ,\,\left(  \left\vert
14\right\rangle \left\langle 12\right\vert -\left\vert 34\right\rangle
\left\langle 23\right\vert \right)  ,\,\left(  \left\vert 14\right\rangle
\left\langle 13\right\vert +\left\vert 24\right\rangle \left\langle
23\right\vert \right)  ,\,\left(  \left\vert 14\right\rangle \left\langle
14\right\vert +\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right)
\end{array}
,\left(  \mathbf{16}\right)  \right\}  .
\end{gather}
This should be compared to the \emph{finite dimensional} direct sum
decomposition of $\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $ given by
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\ker\left\{  L_{2}%
^{1}\right\}  ^{\bot}\oplus\ker\left\{  L_{2}^{1}\right\}  ,
\end{equation}
(in finite dimensions $\ker\left\{  L_{2}^{1}\right\}  ^{\bot}=\ker\left\{
L_{2}^{1}\right\}  ^{c}),$ where
\begin{align}
\ker\left\{  L_{2}^{1}\right\}  ^{\bot}  &  =\,\operatorname*{linspan}\left\{
\left(  \left\vert 13\right\rangle \left\langle 23\right\vert +\left\vert
14\right\rangle \left\langle 24\right\vert \right)  ,\,\left(  \left\vert
12\right\rangle \left\langle 23\right\vert -\left\vert 14\right\rangle
\left\langle 34\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle
\left\langle 24\right\vert +\left\vert 13\right\rangle \left\langle
34\right\vert \right)  ,\right. \\
&  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert +\left\vert
24\right\rangle \left\langle 34\right\vert \right)  ,\,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 34\right\vert \right)  ,\,\left(  \left\vert 13\right\rangle
\left\langle 14\right\vert +\left\vert 23\right\rangle \left\langle
24\right\vert \right)  ,\\
&  \left(  \left\vert 13\right\rangle \left\langle 23\right\vert -\left\vert
14\right\rangle \left\langle 24\right\vert \right)  ,\,\left(  \left\vert
12\right\rangle \left\langle 23\right\vert +\left\vert 14\right\rangle
\left\langle 34\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle
\left\langle 24\right\vert -\left\vert 13\right\rangle \left\langle
34\right\vert \right)  ,\\
&  \,\left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 24\right\rangle \left\langle 34\right\vert \right)  ,\,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{12}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert \right)  +\left(  \left\vert 24\right\rangle \left\langle
24\right\vert -\left\vert 34\right\rangle \left\langle 34\right\vert \right)
,\right. \\
&  \left.  \,\left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert \right)  +\left(
\left\vert 23\right\rangle \left\langle 23\right\vert -\left\vert
24\right\rangle \left\langle 24\right\vert \right)  ,\,\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  ,\left(  \mathbf{3}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left\vert 12\right\rangle
\left\langle 12\right\vert +\left\vert 13\right\rangle \left\langle
13\right\vert +\left\vert 14\right\rangle \left\langle 14\right\vert
+\left\vert 23\right\rangle \left\langle 23\right\vert +\left\vert
24\right\rangle \left\langle 24\right\vert +\left\vert 34\right\rangle
\left\langle 34\right\vert ,\left(  \mathbf{1}\right)  \right\}
\end{align}
and
\begin{align*}
\ker\left\{  L_{2}^{1}\right\}   &  =\operatorname*{linspan}\left\{
\left\vert 12\right\rangle \left\langle 34\right\vert ,\left\vert
13\right\rangle \left\langle 24\right\vert ,\left\vert 14\right\rangle
\left\langle 23\right\vert ,\left\vert 23\right\rangle \left\langle
14\right\vert ,\left\vert 24\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 12\right\vert ,\left(  \mathbf{6}%
\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\}
^{\dagger}\\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 23\right\vert +\left\vert 24\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{2}\right)  \right\}  .
\end{align*}

\end{example}

\begin{example}%
