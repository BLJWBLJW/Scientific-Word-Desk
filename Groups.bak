\end{equation}


\begin{example}
$n=4,r=6$%
\begin{align}
\Gamma^{4}\left(  X_{e}\right)   &  =\binom{4}{0}\Gamma_{0}^{4}\left(
X_{e0}\right)  +\binom{4}{1}\Gamma_{1}^{4}\left(  X_{e1}\right)  +\binom{4}%
{2}\Gamma_{2}^{4}\left(  X_{e12}\right)  +\binom{4}{3}\Gamma_{3}^{4}\left(
