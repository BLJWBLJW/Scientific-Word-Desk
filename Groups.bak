\left(  \left\vert 13\right\rangle \left\langle 23\right\vert +\left\vert
14\right\rangle \left\langle 24\right\vert \right)  ,\,\left(  \left\vert
12\right\rangle \left\langle 23\right\vert +\left\vert 14\right\rangle
\left\langle 34\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle
\left\langle 24\right\vert -\left\vert 13\right\rangle \left\langle
34\right\vert \right)  ,\\
\left(  \left\vert 23\right\rangle \left\langle 13\right\vert +\left\vert
24\right\rangle \left\langle 14\right\vert \right)  ,\,\left(  \left\vert
12\right\rangle \left\langle 13\right\vert +\left\vert 24\right\rangle
\left\langle 34\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle
\left\langle 14\right\vert -\left\vert 23\right\rangle \left\langle
34\right\vert \right)  ,\\
\left(  \left\vert 34\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 12\right\vert \right)  ,\,\left(  \left\vert
13\right\rangle \left\langle 12\right\vert +\left\vert 34\right\rangle
\left\langle 24\right\vert \right)  ,\,\left(  \left\vert 13\right\rangle
\left\langle 14\right\vert +\left\vert 23\right\rangle \left\langle
24\right\vert \right)  ,\\
\left(  \left\vert 34\right\rangle \left\langle 13\right\vert +\left\vert
24\right\rangle \left\langle 12\right\vert \right)  ,\,\left(  \left\vert
14\right\rangle \left\langle 12\right\vert -\left\vert 34\right\rangle
\left\langle 23\right\vert \right)  ,\,\left(  \left\vert 14\right\rangle
\left\langle 13\right\vert +\left\vert 24\right\rangle \left\langle
23\right\vert \right)  ,
\end{array}
,\left(  \mathbf{12}\right)  \right\}  .
\end{equation}
and
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)
1d}=\operatorname{Ran}\left\{  \Gamma_{1}^{2}\right\}  _{1d}\cap
\mathcal{B}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }.
\end{equation}


\item
\begin{equation}
\operatorname{Ran}\left\{  \Gamma_{0}^{2}\right\}  _{0d}%
=\operatorname*{linspan}\left\{  \left\vert 12\right\rangle \left\langle
12\right\vert +\left\vert 13\right\rangle \left\langle 13\right\vert
+\left\vert 14\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 23\right\vert +\left\vert 24\right\rangle
\left\langle 24\right\vert +\left\vert 34\right\rangle \left\langle
34\right\vert ,\left(  \mathbf{1}\right)  \right\}
\end{equation}
and
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{2}\right)  _{00d}=\operatorname{Ran}\left\{
\Gamma_{0}^{2}\right\}  _{0d}\cap\mathcal{B}\left(  \mathcal{H}^{2}\right)
_{0}.
\end{equation}


\begin{enumerate}
\item
\begin{equation}
\operatorname{Ran}\left\{  \Gamma_{0}^{1}\right\}  _{0d}%
=\operatorname*{linspan}\left\{  \left(  \left\vert 1\right\rangle
\left\langle 1\right\vert +\left\vert 2\right\rangle \left\langle 2\right\vert
+\left\vert 3\right\rangle \left\langle 3\right\vert +\left\vert
4\right\rangle \left\langle 4\right\vert \right)  ,\left(  \mathbf{1}\right)
\right\}
\end{equation}


\item
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{00d}=\operatorname{Ran}\left\{
\Gamma_{0}^{1}\right\}  _{0d}\cap\mathcal{B}\left(  \mathcal{H}^{1}\right)
_{0}=\operatorname*{linspan}\left\{  \left(  \left\vert 1\right\rangle
\left\langle 1\right\vert +\left\vert 2\right\rangle \left\langle 2\right\vert
+\left\vert 3\right\rangle \left\langle 3\right\vert +\left\vert
4\right\rangle \left\langle 4\right\vert \right)  ,\left(  \mathbf{1}\right)
\right\}
\end{equation}


\item
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{10d}=\operatorname{Ran}\left\{
\Gamma_{0}^{1}\right\}  _{0d}\cap\mathcal{B}\left(  \mathcal{H}^{1}\right)
=\operatorname*{linspan}\left\{  \left(  \left\vert 1\right\rangle
\left\langle 1\right\vert -\left\vert 2\right\rangle \left\langle 2\right\vert
\right)  ,\left(  \left\vert 2\right\rangle \left\langle 2\right\vert
-\left\vert 3\right\rangle \left\langle 3\right\vert \right)  ,\left(
\left\vert 3\right\rangle \left\langle 3\right\vert -\left\vert 4\right\rangle
\left\langle 4\right\vert \right)  ,\left(  \mathbf{3}\right)  \right\}
\end{equation}


\item
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{11d}=\operatorname*{linspan}%
\left\{  \left\vert 1\right\rangle \left\langle 2\right\vert ,\left\vert
1\right\rangle \left\langle 3\right\vert ,\left\vert 1\right\rangle
\left\langle 4\right\vert ,\left\vert 2\right\rangle \left\langle 1\right\vert
,\left\vert 2\right\rangle \left\langle 3\right\vert ,\left\vert
2\right\rangle \left\langle 4\right\vert ,\left\vert 3\right\rangle
\left\langle 1\right\vert ,\left\vert 3\right\rangle \left\langle 2\right\vert
,\left\vert 3\right\rangle \left\langle 4\right\vert ,\left\vert
4\right\rangle \left\langle 1\right\vert ,\left\vert 4\right\rangle
\left\langle 2\right\vert ,\left\vert 4\right\rangle \left\langle 3\right\vert
,\left(  \mathbf{16}\right)  \right\}  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{example}

