_{\mathbb{R}}}\left(  \left(  v_{r}\oplus_{\mathbb{R}}v_{i}\right)  \right)
\right)  =\frac{1}{2}\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(
v_{r}\oplus_{\mathbb{R}}v_{i}\right)  -_{\mathbb{R}}\left(  \left(
v_{r}\oplus_{\mathbb{R}}\left(  -v_{i}\right)  \right)  \right) \\
&  =\frac{1}{2}\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  2v_{i}\right)
=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  v_{i}\right)  .
\end{align}


\item
\begin{align}
\operatorname{Re}_{\mathfrak{e}}\left\{  \mathfrak{v}\right\}   &  =\frac
{1}{2}\left(  \mathfrak{v}_{1}\mathfrak{e}_{1}+\mathfrak{v}_{2}\mathfrak{e}%
_{2}+\mathfrak{v}_{3}\mathfrak{e}_{3}+\mathfrak{v}_{4}\mathfrak{e}_{4}%
+\sigma_{\mathfrak{e}}\left(  \mathfrak{v}_{1}\mathfrak{e}_{1}+\mathfrak{v}%
_{2}\mathfrak{e}_{2}+\mathfrak{v}_{3}\mathfrak{e}_{3}+\mathfrak{v}%
_{4}\mathfrak{e}_{4}\right)  \right) \\
\mathcal{R}_{\mathfrak{e}}\left(  \operatorname{Re}_{\mathfrak{e}}\left\{
\mathfrak{v}\right\}  \right)   &  =\left(
\begin{array}
[c]{cccc}%
\mathfrak{e}_{1} & \mathfrak{e}_{2} & \mathfrak{e}_{3} & \mathfrak{e}_{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
v_{r1}\\
v_{r2}\\
v_{r3}\\
v_{r4}%
