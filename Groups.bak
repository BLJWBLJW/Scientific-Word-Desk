\right)  2d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
\left(  1\right)  -\left(  2\right)  \right)  1d}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\left(  \left(  1\right)  -\left(  2\right)
\right)  0d}\\
