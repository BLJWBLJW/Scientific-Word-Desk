v_{r1},v_{r2},v_{r3},v_{r4},v_{i1},v_{i2},v_{i3},v_{i4}\in\mathbb{R}%
,\quad\mathfrak{v}_{1},\mathfrak{v}_{2},\mathfrak{v}_{3},\mathfrak{v}_{4}%
\in\mathbb{C}.
