&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 14\right\vert -\left\vert
