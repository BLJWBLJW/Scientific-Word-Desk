^{1}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{0}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{0}\\
&  \equiv\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  _{0}%
,\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0},\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0},\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)
_{0},\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{0}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  1\right)
}  &  =%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq4}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{1}=\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  _{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)
_{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{1}\\
&  =\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1},\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{1},\mathcal{B}_{1}\left(  \mathcal{H}%
^{3}\right)  _{1},\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{1}\right)
\\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  2\right)
}  &  =%
%TCIMACRO{\tbigoplus \limits_{2\leq n\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{2\leq n\leq4}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{2}=\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{2}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{3}\right)  _{2}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{2}\\
&  =\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2},\mathcal{B}%
_{1}\left(  \mathcal{H}^{3}\right)  _{2},\mathcal{B}_{1}\left(  \mathcal{H}%
^{4}\right)  _{2}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  3\right)
}  &  =%
%TCIMACRO{\tbigoplus \limits_{3\leq n\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{3\leq n\leq4}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{3}=\mathcal{B}_{1}\left(
\mathcal{H}^{3}\right)  _{3}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{4}\right)  _{3}\\
&  \left(  \mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{3},\mathcal{B}%
_{1}\left(  \mathcal{H}^{4}\right)  _{3}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  4\right)
}  &  =%
%TCIMACRO{\tbigoplus \limits_{4\leq n\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{4\leq n\leq4}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{4}=\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{4}%
\end{align}
and
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  0\right)
}^{c}=\left\{  \left.  X-\frac{1}{16}\operatorname{Tr}\left\{  X\right\}
I_{16}\right\vert X\in\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  \right\}
=\left\{  \left.  X-\operatorname{Tr}\left\{  X\right\}  \right\vert
X\in\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  \right\}  .
\end{equation}
The $\Upsilon$ map has the effect%
\begin{align}
&  \left(
\begin{array}
[c]{c}%
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
\end{array}
\right)  \overset{\Upsilon}{\rightarrow}\left(
\begin{array}
[c]{c}%
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  0\right)
}\\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  1\right)
}\\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  2\right)
}\\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  3\right)
}\\
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  4\right)
}%
\end{array}
\right) \\
&  L\left(  X_{e}\right)  =L\left(  X_{e}\right)  =\,\overset{\uparrow
}{\underset{\downarrow}{n}}\overset{\longleftarrow p\rightarrow}{\left(
\begin{array}
[c]{ccccc}%
L_{0}^{0} & L_{1}^{0} & L_{2}^{0} & L_{3}^{0} & L_{4}^{0}\\
0 & L_{1}^{1} & \binom{2}{1}L_{2}^{1} & \binom{3}{1}L_{3}^{1} & \binom{4}%
{1}L_{4}^{1}\\
\vdots & \ddots & L_{2}^{2} & \binom{3}{2}L_{3}^{2} & \binom{4}{2}L_{4}^{2}\\
\vdots & \cdots & \ddots & L_{3}^{3} & \binom{4}{3}L_{4}^{3}\\
0 & \cdots & \cdots & 0 & L_{4}^{4}%
\end{array}
\right)  }\left(
\begin{array}
[c]{c}%
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right) \\
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
\end{array}
\right)
\end{align}
The expansion map in the standard decomposition is given by
\begin{align}
\Gamma\left(  X_{e}\right)   &  =\Gamma\left(  X_{e}\right)
=\,\overset{\uparrow}{\underset{\downarrow}{n}}\overset{\longleftarrow
p\rightarrow}{\left(
\begin{array}
[c]{ccccc}%
\Gamma_{0}^{0} & 0 & \cdots & \cdots & 0\\
\Gamma_{0}^{1} & \Gamma_{1}^{1} & 0 & \cdots & 0\\
\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \Gamma_{2}^{2} & 0 & \vdots\\
\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & \binom{3}{2}\Gamma_{2}^{3} &
\Gamma_{3}^{3} & 0\\
\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}\Gamma_{2}^{4} &
\binom{4}{3}\Gamma_{3}^{4} & \Gamma_{4}^{4}%
\end{array}
\right)  }\left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e12}\\
X_{e123}\\
X_{e124}%
\end{array}
\right) \\
\left(  \Gamma_{0}\left(  X_{e}\right)  ,\cdots,\Gamma_{4}\left(
X_{e}\right)  \right)   &  =\left(  \Gamma_{0}^{0}\left(  X_{e0}\right)
,\cdots,\sum\limits_{0\leq p\leq n}\binom{n}{p}\Gamma_{p}^{4}\left(
X_{ep\cdots n}\right)  ,\cdots,\sum\limits_{0\leq p\leq4}\binom{4}{p}%
\Gamma_{p}^{4}\left(  X_{ep\cdots4}\right)  \right)
\end{align}
giving%
\begin{align}
\Gamma_{0}\left(  X_{e}\right)   &  =\Gamma_{0}^{0}\left(  X_{e0}\right)
=\Gamma_{0}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  =\left\vert \phi\right\rangle \left\langle
\phi\right\vert \\
\Gamma_{1}\left(  X_{e}\right)   &  =\sum\limits_{0\leq p\leq1}\binom{4}%
{p}\Gamma_{p}^{4}\left(  X_{ep\cdots4}\right)  =\binom{4}{0}\Gamma_{0}%
^{4}\left(  X_{e0}\right)  +\binom{4}{1}\Gamma_{1}^{4}\left(  X_{e1}\right)
=\Gamma_{0}^{4}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  +4\Gamma_{1}^{4}\left(  X_{e1}\right) \\
\Gamma_{2}\left(  X_{e}\right)   &  =\sum\limits_{0\leq p\leq2}\binom{4}%
{p}\Gamma_{p}^{4}\left(  X_{ep\cdots4}\right)  =\binom{4}{0}\Gamma_{0}%
^{4}\left(  X_{e0}\right)  +\binom{4}{1}\Gamma_{1}^{4}\left(  X_{e1}\right)
+\binom{4}{2}\Gamma_{2}^{4}\left(  X_{e2}\right)  =\Gamma_{0}^{4}\left(
\left\vert \phi\right\rangle \left\langle \phi\right\vert \right)
+4\Gamma_{1}^{4}\left(  X_{e1}\right)  +4\Gamma_{2}^{4}\left(  X_{e2}\right)
\\
\Gamma_{3}\left(  X_{e}\right)   &  =\sum\limits_{0\leq p\leq3}\binom{4}%
{p}\Gamma_{p}^{4}\left(  X_{ep\cdots4}\right)  =\binom{4}{0}\Gamma_{0}%
^{4}\left(  X_{e0}\right)  +\binom{4}{1}\Gamma_{1}^{4}\left(  X_{e1}\right)
+\binom{4}{2}\Gamma_{2}^{4}\left(  X_{e2}\right)  +\binom{4}{3}\Gamma_{3}%
^{4}\left(  X_{e3}\right) \\
&  =\Gamma_{0}^{4}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  +4\Gamma_{1}^{4}\left(  X_{e1}\right)  +6\Gamma
_{2}^{4}\left(  X_{e12}\right)  +4\Gamma_{3}^{4}\left(  X_{e123}\right) \\
\Gamma_{4}\left(  X_{e}\right)   &  =\sum\limits_{0\leq p\leq4}\binom{4}%
{p}\Gamma_{p}^{4}\left(  X_{ep\cdots4}\right)  =\binom{4}{0}\Gamma_{0}%
^{4}\left(  X_{e0}\right)  +\binom{4}{1}\Gamma_{1}^{4}\left(  X_{e1}\right)
+\binom{4}{2}\Gamma_{2}^{4}\left(  X_{e12}\right)  +\binom{4}{3}\Gamma_{3}%
^{4}\left(  X_{e123}\right)  +\binom{4}{4}\Gamma_{4}^{4}\left(  X_{e1234}%
\right) \\
&  =\Gamma_{0}^{4}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  +4\Gamma_{1}^{4}\left(  X_{e1}\right)  +6\Gamma
_{2}^{4}\left(  X_{e12}\right)  +4\Gamma_{3}^{4}\left(  X_{e123}\right)
+\Gamma_{4}^{4}\left(  X_{e1234}\right)  .
\end{align}

\end{example}

\begin{example}
The decomposition
\begin{equation}
\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e0}=\mathcal{B}_{1}\left(
\wedge\mathbb{C}^{4}\right)  _{e}=\mathcal{B}_{1}\left(  \wedge\mathbb{C}%
^{4}\right)  _{e0}\oplus\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)
_{e1}\oplus\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e2}%
\oplus\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e3}\oplus
\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e4}%
\end{equation}
gives

\begin{enumerate}
\item Non zero trace operators $\ker\left\{  L_{0}\right\}  ^{c}$that are
given by
\begin{align}
\ker\left\{  L_{0}\right\}  ^{c}=  &  \mathcal{B}_{1}\left(  \mathbb{C}%
^{16}\right)  _{e0}=\ker\left\{  L_{0}^{0}\right\}  ^{c}\oplus\ker\left\{
L_{1}^{0}\right\}  ^{c}\oplus\ker\left\{  L_{2}^{0}\right\}  ^{c}\oplus
\ker\left\{  L_{3}^{0}\right\}  ^{c}\oplus\ker\left\{  L_{4}^{0}\right\}
^{c}\\
&  =\operatorname*{linspan}\left\{  \left(  \left\vert 1234\right\rangle
\left\langle 1234\right\vert \right)  ,\frac{1}{4}\left(  \overset{}{\left(
\left\vert 123\right\rangle \left\langle 123\right\vert +\left\vert
124\right\rangle \left\langle 124\right\vert +\left\vert 134\right\rangle
\left\langle 134\right\vert +\left\vert 234\right\rangle \left\langle
234\right\vert \right)  }\right.  \right. \\
&  \left.  \frac{1}{6}\left(  \left\vert 12\right\rangle \left\langle
12\right\vert +\left\vert 13\right\rangle \left\langle 13\right\vert
+\left\vert 14\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 23\right\vert +\left\vert 24\right\rangle
\left\langle 24\right\vert +\left\vert 34\right\rangle \left\langle
34\right\vert \right)  \right)  ,\left(  \frac{1}{4}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert +\left\vert 2\right\rangle
\left\langle 2\right\vert +\left\vert 3\right\rangle \left\langle 3\right\vert
+\left\vert 4\right\rangle \left\langle 4\right\vert \right)  \right)  ,\\
&  \left.  \left\vert \phi\right\rangle \left\langle \phi\right\vert \right\}
\end{align}
so that
\begin{equation}
\dim\left\{  \mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e0}\right\}  =5.
\end{equation}


\begin{remark}%
\begin{align}
L,L_{p}  &  :\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}%
\rightarrow\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}\nonumber\\
L\left(  X_{e}\right)   &  =\sum_{0\leq p\leq r}L_{p}\left(  X_{e}\right)
=\sum_{0\leq p\leq n\leq r}\binom{n}{p}L_{n}^{p}\left(  X_{en}\right) \\
L_{p}\left(  X_{e}\right)   &  =\sum_{0\leq n\leq r}\binom{n}{p}L_{n}%
^{p}\left(  X_{en}\right)  .
\end{align}

\end{remark}

\item $\ker\left\{  L_{0}\right\}  $ is given by
\begin{equation}
\ker\left\{  L_{0}\right\}  =\left\{  \left.  L_{0}\left(  X_{e}\right)
=0\right\vert X_{e}\in\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)
_{e}\right\}  ,
\end{equation}
where%
\begin{equation}
L_{0}\left(  X_{e}\right)  =\sum_{0\leq n\leq4}\binom{n}{0}L_{n}^{0}\left(
X_{en}\right)  =\binom{0}{0}L_{0}^{0}\left(  X_{e0}\right)  +\binom{1}{0}%
L_{1}^{0}\left(  X_{e1}\right)  +\binom{2}{0}L_{2}^{0}\left(  X_{e2}\right)
+\binom{3}{0}L_{3}^{0}\left(  X_{e3}\right)  +\binom{4}{0}L_{4}^{0}\left(
X_{e4}\right)
\end{equation}
and $\ker\left\{  L_{0}\right\}  $ has direct sum expansions
\begin{align}
\ker\left\{  L_{0}\right\}   &  =\ker\left\{  L_{0}\right\}  _{0d}\oplus
\ker\left\{  L_{0}\right\}  _{1d}\oplus\ker\left\{  L_{0}\right\}  _{2d}%
\oplus\ker\left\{  L_{0}\right\}  _{3d}\oplus\ker\left\{  L_{0}\right\}
_{4d}\\
&  =\ker\left\{  L_{1}^{0}\right\}  \oplus\ker\left\{  L_{2}^{0}\right\}
\oplus\ker\left\{  L_{3}^{0}\right\}  \oplus\ker\left\{  L_{4}^{0}\right\}  ,
\end{align}
where
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  =%
%TCIMACRO{\tbigoplus \limits_{0\leq j\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq j\leq4}}
%EndExpansion
\ker\left\{  L_{n}^{0}\right\}  _{jd};\,0\leq n\leq4.
\end{equation}


\begin{enumerate}
