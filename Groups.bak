\begin{example}%
\begin{align}
\mathfrak{H}_{\mathfrak{H}_{\mathbb{R}}}  &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \mathfrak{e}_{1},\mathfrak{e}_{2}%
,\mathfrak{e}_{3},\mathfrak{e}_{4}\right\} \\
\mathfrak{H}_{\mathfrak{H}_{\mathbb{R}}^{\bot}}  &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  i\mathfrak{e}_{1},i\mathfrak{e}_{2}%
,i\mathfrak{e}_{3},i\mathfrak{e}_{4}\right\}  .
\end{align}

\end{example}
\end{remark}

\begin{remark}
The maps $\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}},\mathcal{C}_{U}$ and
$\mathcal{C}_{U^{\prime}}$ are $\mathbb{R}$-linear.
\end{remark}

\begin{remark}%
\begin{gather}
\left(
\begin{array}
[c]{c}%
v_{r1}\\
v_{r2}\\
v_{r3}\\
v_{r4}\\
v_{i1}\\
v_{i2}\\
v_{i3}\\
v_{i4}%
\end{array}
\right)  \in\mathcal{R}_{e}\left(  \mathfrak{H}_{2\mathfrak{H}_{\mathbb{R}}%
}\right)  ;\quad\left(
\begin{array}
[c]{c}%
v_{r1}\\
v_{r2}\\
v_{r3}\\
v_{r4}%
\end{array}
\right)  \in\mathcal{R}_{e}\left(  \mathfrak{H}_{\mathbb{R}}\right)
,\quad\left(
\begin{array}
[c]{c}%
v_{i1}\\
v_{i2}\\
v_{i3}\\
v_{i4}%
\end{array}
\right)  \in\mathcal{R}_{e}\left(  \mathfrak{H}_{\mathbb{R}}^{\prime}\right)
;\\
\left(
\begin{array}
[c]{c}%
v_{r1}\\
v_{r2}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
v_{r3}\\
v_{r4}%
\end{array}
\right)  \in U;\quad\left(
\begin{array}
[c]{c}%
v_{r1}\\
v_{r2}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
v_{r3}\\
v_{r4}%
\end{array}
\right)  \in U^{\prime}%
\end{gather}

\end{remark}

\begin{example}
The conjugation $\sigma_{\mathfrak{H}_{U}}\in\mathcal{B}_{\mathbb{R}}\left(
\mathfrak{H}_{U}\right)  $ defined on the complex hilbert space $\mathfrak{H}%
_{U}$
\begin{equation}
\sigma_{\mathfrak{H}_{U}}:\mathfrak{H}_{U}\rightarrow\mathfrak{H}_{U}%
\end{equation}
is related to the conjugation $\sigma_{U}\in\mathcal{B}\left(  \mathfrak{H}%
_{\mathbb{R}}\right)  $ in the $r=2$ case by
\begin{align}
\sigma_{\mathfrak{H}_{U}}\left(  \mathfrak{e}_{1}\right)   &  =\overline
{\mathfrak{e}_{1}}^{\mathfrak{e}}=\overline{\mathcal{C}_{U}\left(  e_{1}%
+J_{U}e_{3}\right)  }^{\mathfrak{e}}=\overline{\mathfrak{e}_{1}}%
^{\mathfrak{e}}=\mathcal{C}_{U}\left(  \sigma_{U}\left(  e_{1}+J_{U}%
e_{3}\right)  \right) \\
\sigma_{\mathfrak{H}_{U}}\left(  \mathfrak{e}_{2}\right)   &  =\overline
{\mathfrak{e}_{2}}^{\mathfrak{e}}=\overline{\mathcal{C}_{U}\left(  e_{2}%
+J_{U}e_{4}\right)  }^{\mathfrak{e}}=\overline{\mathfrak{e}_{2}}%
^{\mathfrak{e}}=\mathcal{C}_{U}\left(  \sigma_{U}\left(  e_{2}+J_{U}%
e_{4}\right)  \right)  .
\end{align}

\end{example}

\begin{example}
The conjugation $\sigma_{\mathfrak{e}}\equiv\sigma_{\mathfrak{H}_{\mathbb{C}}%
}\in\mathcal{B}_{\mathbb{R}}\left(  \mathfrak{H}_{\mathfrak{H}_{\mathbb{R}}%
}\right)  \equiv\mathcal{B}_{\mathbb{R}}\left(  \mathfrak{H}_{\mathbb{C}%
}\right)  $ defined on the complex hilbert space $\mathfrak{H}_{\mathfrak{H}%
_{\mathbb{R}}}\equiv\mathfrak{H}_{\mathbb{C}}$
\begin{equation}
\sigma_{\mathfrak{e}}\equiv\sigma_{\mathfrak{H}_{\mathbb{C}}}:\mathfrak{H}%
_{\mathbb{C}}\rightarrow\mathfrak{H}_{\mathbb{C}}%
\end{equation}
is related to the conjugation $\sigma_{\mathfrak{H}_{\mathfrak{R}}}%
\in\mathcal{B}\left(  \mathfrak{H}_{\mathfrak{H}_{\mathbb{R}}}\oplus
_{\mathbb{R}}\mathfrak{H}_{\mathfrak{H}_{\mathbb{R}}}\right)  $ in the $r=2$
case by
\begin{align}
\sigma_{\mathfrak{H}_{\mathbb{C}}}\left(  \mathfrak{e}_{1}\right)   &
=\overline{\mathfrak{e}_{1}}^{\mathfrak{e}}=\overline{\mathcal{C}%
_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{1}+J_{\mathfrak{H}_{\mathbb{R}}}%
e_{5}\right)  }^{\mathfrak{e}}=\overline{\mathfrak{e}_{1}}^{\mathfrak{e}%
}=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  \sigma_{\mathfrak{H}%
_{\mathbb{R}}}\left(  e_{1}+J_{\mathfrak{H}_{\mathbb{R}}}e_{5}\right)  \right)
\\
\sigma_{\mathfrak{H}_{\mathbb{C}}}\left(  \mathfrak{e}_{2}\right)   &
=\overline{\mathfrak{e}_{2}}^{\mathfrak{e}}=\overline{\mathcal{C}%
_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{2}+J_{\mathfrak{H}_{\mathbb{R}}}%
e_{6}\right)  }^{\mathfrak{e}}=\overline{\mathfrak{e}_{2}}^{\mathfrak{e}%
}=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  \sigma_{\mathfrak{H}%
_{\mathbb{R}}}\left(  e_{2}+J_{\mathfrak{H}_{\mathbb{R}}}e_{6}\right)  \right)
\\
\sigma_{\mathfrak{H}_{\mathbb{C}}}\left(  \mathfrak{e}_{3}\right)   &
=\overline{\mathfrak{e}_{3}}^{\mathfrak{e}}=\overline{\mathcal{C}%
_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{3}+J_{\mathfrak{H}_{\mathbb{R}}}%
e_{7}\right)  }^{\mathfrak{e}}=\overline{\mathfrak{e}_{3}}^{\mathfrak{e}%
}=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  \sigma_{\mathfrak{H}%
_{\mathbb{R}}}\left(  e_{1}+J_{\mathfrak{H}_{\mathbb{R}}}e_{7}\right)  \right)
\\
\sigma_{\mathfrak{H}_{\mathbb{C}}}\left(  \mathfrak{e}_{4}\right)   &
=\overline{\mathfrak{e}_{4}}^{\mathfrak{e}}=\overline{\mathcal{C}%
_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{4}+J_{\mathfrak{H}_{\mathbb{R}}}%
e_{8}\right)  }^{\mathfrak{e}}=\overline{\mathfrak{e}_{4}}^{\mathfrak{e}%
}=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  \sigma_{\mathfrak{H}%
_{\mathbb{R}}}\left(  e_{1}+J_{\mathfrak{H}_{\mathbb{R}}}e_{8}\right)
\right)
\end{align}

\end{example}

\begin{example}
In the real space $\mathfrak{H}_{\mathbb{R}}$ one has
\begin{align}
J_{U}\sigma_{U}\left(  e_{1}\right)   &  =e_{3}\\
J_{U}\sigma_{U}\left(  e_{2}\right)   &  =e_{4}\\
J_{U}\sigma_{U}\left(  e_{3}\right)   &  =-e_{1}\\
J_{U}\sigma_{U}\left(  e_{4}\right)   &  =-e_{2}%
\end{align}
hence%
\begin{equation}
J_{U}\sigma_{U}=-\sigma_{U}J_{U}\equiv\left\{  J_{U},\sigma_{U}\right\}
\equiv\left[  J_{U},\sigma_{U}\right]  _{+},
\end{equation}
which is consistent with
\begin{equation}
J_{U}=\left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert +\left\vert
e_{4}\right\rangle \left\langle e_{2}\right\vert -\left(  \left\vert
e_{1}\right\rangle \left\langle e_{3}\right\vert +\left\vert e_{2}%
\right\rangle \left\langle e_{4}\right\vert \right)
\end{equation}%
\begin{equation}
\sigma_{U}=\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert -\left(
\left\vert e_{3}\right\rangle \left\langle e_{3}\right\vert +\left\vert
e_{4}\right\rangle \left\langle e_{4}\right\vert \right)  .
\end{equation}
$\lceil$confirmed by
\begin{align}
J_{U}\sigma_{U}  &  =\left(  \left\vert e_{3}\right\rangle \left\langle
e_{1}\right\vert +\left\vert e_{4}\right\rangle \left\langle e_{2}\right\vert
-\left(  \left\vert e_{1}\right\rangle \left\langle e_{3}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{4}\right\vert \right)  \right)
\left(  \left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert -\left(
\left\vert e_{3}\right\rangle \left\langle e_{3}\right\vert +\left\vert
e_{4}\right\rangle \left\langle e_{4}\right\vert \right)  \right) \\
&  =\left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert +\left\vert
e_{4}\right\rangle \left\langle e_{2}\right\vert +\left\vert e_{1}%
\right\rangle \left\langle e_{3}\right\vert -\left\vert e_{2}\right\rangle
\left\langle e_{4}\right\vert \\
\sigma_{U}J_{U}  &  =\left(  \left\vert e_{1}\right\rangle \left\langle
e_{1}\right\vert +\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert
-\left(  \left\vert e_{3}\right\rangle \left\langle e_{3}\right\vert
+\left\vert e_{4}\right\rangle \left\langle e_{4}\right\vert \right)  \right)
\left(  \left\vert e_{3}\right\rangle \left\langle e_{1}\right\vert
+\left\vert e_{4}\right\rangle \left\langle e_{2}\right\vert -\left(
\left\vert e_{1}\right\rangle \left\langle e_{3}\right\vert +\left\vert
e_{2}\right\rangle \left\langle e_{4}\right\vert \right)  \right) \\
&  =-\left\vert e_{1}\right\rangle \left\langle e_{3}\right\vert +\left\vert
e_{2}\right\rangle \left\langle e_{4}\right\vert +\left\vert e_{1}%
\right\rangle \left\langle e_{3}\right\vert -\left\vert e_{4}\right\rangle
\left\langle e_{2}\right\vert .
\end{align}
$\rfloor$
\end{example}

