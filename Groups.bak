0 & 0 & 0 & 1 & 0 & 0 & 0 & i
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{4} & i\mathbb{I}_{4}%
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathfrak{H}_{U}=\mathbb{C\otimes}_{\mathbb{R}}U=\mathcal{C}_{U}\left(
U\oplus_{\mathbb{R}}U\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\mathfrak{H}_{\mathbb{C}}  &  =\mathbb{C\otimes}_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(
\overset{}{\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}}\right) \\
&  =\mathfrak{H}_{U}\oplus_{\mathbb{C}}\mathfrak{H}_{U}\cong\mathfrak{H}%
_{U}\oplus_{\mathbb{C}}\sigma_{\mathfrak{e}}\left(  \mathfrak{H}_{U}\right)
\cong\mathfrak{H}_{U}\oplus_{\mathbb{C}}\mathfrak{H}_{U}^{d}\\
&  \cong\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(
\overset{}{\operatorname{Re}_{\mathfrak{e}}\left\{  \mathfrak{H}_{\mathbb{C}%
}\right\}  \oplus_{\mathbb{R}}\operatorname{Im}_{\mathfrak{e}}\left\{
\mathfrak{H}_{\mathbb{C}}\right\}  }\right)  .
\end{align}

\end{remark}

\begin{remark}
In this example $\left\{  ie_{j},1\leq j\leq4\right\}  $ are fixed symbols the
symbol "$i$" has no algebriac properties -it is just part of a name.
\end{remark}

\begin{remark}%
\begin{equation}
\mathfrak{H}_{\mathbb{R}}+_{\mathbb{C}}\mathfrak{H}_{\mathbb{R}}%
\neq\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{C}}\mathfrak{H}_{\mathbb{R}}%
\end{equation}
as
\begin{equation}
\mathfrak{H}_{\mathbb{R}}\cap\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}%
_{\mathbb{R}}%
\end{equation}
and the vector sum $+_{\mathbb{C}}$only equals the direct sum $\oplus
_{\mathbb{C}}$ if the subspaces were disjoint.
\end{remark}

\subsubsection{External Complexification in Terms of Internal
Complexification}

\begin{enumerate}
\item The real tensor product $\otimes_{\mathbb{R}},$ where $\lambda
\in\mathbb{R},$ $v_{1},v_{2}\in\mathfrak{H}_{\mathbb{R}}$ and the complex
tensor product $\otimes_{\mathbb{C}},$ where $\lambda\in\mathbb{C},$
$v_{1},v_{2}\in\mathfrak{H}_{\mathbb{C}}$ are defined by
\begin{gather}
\left(  v_{1},v_{3}\right)  +\left(  v_{2},v_{3}\right)  \sim\left(
v_{1}+v_{2},v_{3}\right) \\
\left(  v_{1},v_{2}\right)  +\left(  v_{1},v_{3}\right)  \sim\left(
v_{1},v_{2}+v_{3}\right) \\
\lambda\left(  v_{1},v_{2}\right)  \sim\left(  \lambda v_{1},v_{2}\right)
\sim\left(  v_{1},\lambda v_{2}\right) \\
\lambda\in\mathbb{F}=\mathbb{R},\mathbb{C}.
\end{gather}


\item The real direct sum $\oplus_{\mathbb{R}},$ where $\lambda\in\mathbb{R},$
$v_{1},v_{2}\in\mathfrak{H}_{\mathbb{R}}$ and the complex direct sum
$\oplus_{\mathbb{C}}$where $\lambda\in\mathbb{C},$ $v_{1},v_{2}\in
\mathfrak{H}_{\mathbb{C}}$ are defined by%
\begin{gather}
\left(  v_{1},v_{3}\right)  +\left(  v_{2},v_{3}\right)  \sim\left(
v_{1}+v_{2},v_{3}\right) \\
\left(  v_{1},v_{2}\right)  +\left(  v_{1},v_{3}\right)  \sim\left(
v_{1},v_{2}+v_{3}\right) \\
\lambda\left(  v_{1},v_{2}\right)  \sim\left(  \lambda v_{1},\lambda
v_{2}\right) \\
\lambda\in\mathbb{F}=\mathbb{R},\mathbb{C}.
\end{gather}


\begin{remark}
The only difference between the tensor product and the direct sum definition
is the action of the scalar $\lambda.$
\end{remark}
\end{enumerate}

\subsubsection{External Tensor Product to Direct Sum:}

$\,$Here the space $\mathfrak{H}_{\mathbb{R}},$ (where $\dim\left\{
\mathfrak{H}_{\mathbb{R}}\right\}  =2r),$ acts like the chosen subspace $U,$
i.e. $U=\mathfrak{H}_{\mathbb{R}},$ (where now $\dim\left\{  U\right\}  =2r),$
in the preceding i.e. standard compexification of a vector space $V$ via
tensor product with $\mathbb{C}$ is equivalent to embedding $V$ in
$V\oplus_{\mathbb{R}}V$ and using $V$ as the subspace generating the
complexification $J_{V}$ i.e.

\begin{example}
\begin{enumerate}
\item for $r=2$%
\begin{equation}
J_{\mathfrak{H}_{\mathbb{R}}}=\left\vert e_{5}\right\rangle \left\langle
e_{1}\right\vert +\left\vert e_{6}\right\rangle \left\langle e_{2}\right\vert
+\left\vert e_{7}\right\rangle \left\langle e_{3}\right\vert +\left\vert
e_{8}\right\rangle \left\langle e_{4}\right\vert -\left(  \left\vert
e_{1}\right\rangle \left\langle e_{5}\right\vert +\left\vert e_{2}%
\right\rangle \left\langle e_{6}\right\vert +\left\vert e_{3}\right\rangle
\left\langle e_{7}\right\vert +\left\vert e_{4}\right\rangle \left\langle
e_{8}\right\vert \right)  ,
\end{equation}


\item for $r=1$%
\begin{equation}
J_{\mathfrak{H}_{\mathbb{R}}}=\left\vert e_{3}\right\rangle \left\langle
e_{1}\right\vert +\left\vert e_{4}\right\rangle \left\langle e_{2}\right\vert
-\left(  \left\vert e_{1}\right\rangle \left\langle e_{3}\right\vert
+\left\vert e_{2}\right\rangle \left\langle e_{4}\right\vert \right)  .
\end{equation}


\item The complexification $J_{\mathfrak{H}_{\mathbb{R}}}\in\mathcal{B}\left(
\mathfrak{H}_{\mathbb{R}}\right)  ,$ induced by $\mathfrak{H}_{\mathbb{R}}$ is
defined by
\begin{equation}
J_{\mathfrak{H}_{\mathbb{R}}}=\sum_{1\leq j\leq2r}\left\{  \left\vert
e_{j+2r}\right\rangle \left\langle e_{j}\right\vert -\left\vert e_{j}%
\right\rangle \left\langle e_{j+2r}\right\vert \right\}
\end{equation}
and
\begin{equation}
\mathfrak{H}_{\mathbb{C}}\cong\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}%
}J_{\mathfrak{H}_{\mathbb{R}}}\mathfrak{H}_{\mathbb{R}},
\end{equation}
via the $\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}$ map. This induces a complex
unit
\begin{align}
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}\right)   &
=iI_{2r}\\
iI_{2r}  &  \in\mathcal{B}_{\mathbb{R}}\left(  \mathfrak{H}_{\mathbb{C}%
}\right)  .
\end{align}

\end{enumerate}
\end{example}

\begin{enumerate}
\item[4] The conjugation $\sigma_{\mathfrak{H}_{\mathbb{R}}}\in$
$\mathcal{B}\left(  \mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}%
\mathfrak{H}_{\mathbb{R}}\right)  $ induced by $\mathfrak{H}_{\mathbb{R}}$ is
defined by%
\begin{equation}
\sigma_{U}=\sum_{1\leq j\leq2r}\left\{  \left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert -\left\vert e_{j+2r}\right\rangle \left\langle
e_{j+2r}\right\vert \right\}  .
\end{equation}

\end{enumerate}

\begin{example}
\begin{enumerate}


\item[5] This induces a conjugation $\sigma_{\mathfrak{e}}\in\mathcal{B}%
_{\mathbb{R}}\left(  \mathfrak{H}_{\mathbb{C}}\right)  ,$ where%
\begin{equation}
C_{\mathfrak{H}_{\mathbb{R}}}\left(  \sigma_{\mathfrak{H}_{\mathbb{R}}%
}\right)  =\sigma_{\mathfrak{e}}%
\end{equation}
and is defined by $\equiv$%
\begin{equation}
\sigma_{\mathfrak{e}}=\sum_{1\leq j\leq2r}\left\{  \left\vert \mathfrak{e}%
_{j}\right\rangle \left\langle \mathfrak{e}_{j}\right\vert -\left\vert
i\mathfrak{e}_{j}\right\rangle \left\langle i\mathfrak{e}_{j}\right\vert
\right\}  .
\end{equation}


\item[6] The conjugation $\sigma_{U}$ $\in$ $\mathcal{B}\left(  \mathfrak{H}%
_{\mathbb{R}}\right)  $ induced by $U$ is defined by
\begin{equation}
\sigma_{\mathfrak{H}_{\mathbb{R}}}=\sum_{1\leq j\leq r}\left\{  \left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert -\left\vert e_{j+r}%
\right\rangle \left\langle e_{j+r}\right\vert \right\}  .
\end{equation}


\item[7] This induces a conjugation $\sigma_{\mathfrak{e}}\in\mathcal{B}%
_{\mathbb{R}}\left(  \mathfrak{H}_{U}\right)  ,$ where
\begin{equation}
C_{U}\left(  \sigma_{U}\right)  =\sigma_{\mathfrak{e}}.
\end{equation}
and is defined by
\begin{equation}
\sigma_{\mathfrak{e}}=\sum_{1\leq j\leq r}\left\{  \left\vert \mathfrak{e}%
_{j}\right\rangle \left\langle \mathfrak{e}_{j}\right\vert -\left\vert
i\mathfrak{e}_{j}\right\rangle \left\langle i\mathfrak{e}_{j}\right\vert
\right\}  .
\end{equation}


\item[8] The induced conjugation $\sigma_{\mathfrak{e}}\in\mathcal{B}%
_{\mathbb{R}}\left(  \mathfrak{H}_{\mathbb{C}}\right)  $ has the effect
\begin{equation}
\sigma_{\mathfrak{e}}\left(  \mathfrak{v}\right)  =\sigma_{\mathfrak{e}%
}\left(  \mathfrak{v}_{\mathfrak{e}r}+\mathfrak{v}_{\mathfrak{e}i}\right)
=\sigma_{\mathfrak{e}}\left(  \operatorname{Re}_{\mathfrak{e}}\left(
\mathfrak{v}\right)  +i\operatorname{Im}_{\mathfrak{e}}\left(  \mathfrak{v}%
\right)  \right)  =\operatorname{Re}_{\mathfrak{e}}\left(  \mathfrak{v}%
\right)  -i\operatorname{Im}_{\mathfrak{e}}\left(  \mathfrak{v}\right)
=\mathfrak{v}_{\mathfrak{e}r}-\mathfrak{v}_{\mathfrak{e}i}.
\end{equation}


\begin{remark}
In order to avoid confusion one should probably index conjugations by the the
space they act on not by the basis that inuces them i.e.
\begin{align}
\sigma_{\mathfrak{H}_{\mathbb{C}}}  &  \equiv\sigma_{\mathfrak{e}}\text{ for
external complexification }\\
\sigma_{\mathfrak{H}_{U}}  &  \equiv\sigma_{\mathfrak{e}}\text{ for internal
complexification.}%
\end{align}

\end{remark}
\end{enumerate}
\end{example}

\begin{example}
The internal complexification of $\mathfrak{H}_{\mathbb{R}}$ induced by the
subspace $U$ in the $r=2$ is given by
\begin{align}
\mathcal{C}_{U}\left(  e_{1}\right)   &  =\mathfrak{e}_{1}\\
\mathcal{C}_{U}\left(  e_{2}\right)   &  =\mathfrak{e}_{2}\\
\mathcal{C}_{U}\left(  e_{3}\right)   &  =i\mathfrak{e}_{1}\\
\mathcal{C}_{U}\left(  e_{4}\right)   &  =i\mathfrak{e}_{2}.
\end{align}

\end{example}

\begin{example}%
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathbb{R}\text{-}\operatorname*{linspan}\left\{
\left.  e_{j}\right\vert 1\leq j\leq2r\right\}  ,
\end{equation}
then the \emph{external} complexification producing
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathbb{C\otimes}_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}%
\end{equation}
corresponds to $U=\mathfrak{H}_{\mathbb{R}}$ in the direct sum
\begin{equation}
\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}%
}=\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}J_{\mathfrak{H}_{\mathbb{R}}%
}\mathfrak{H}_{\mathbb{R}},
\end{equation}
i.e.
\begin{equation}
U=U^{\prime}=\mathfrak{H}_{\mathbb{R}}.
\end{equation}
In the case of $r=2$
\begin{equation}
\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}%
}=\mathbb{R}\text{-}\operatorname*{linspan}\left\{  e_{1},e_{2},e_{3}%
,e_{4},e_{5},e_{6},e_{7},e_{8}\right\}  .
\end{equation}
and%
\begin{align}
\mathbb{C}\text{-}\dim\left\{  \mathfrak{H}_{\mathbb{C}}\right\}   &  =2r=4\\
\mathbb{R}\text{-}\dim\left\{  \mathfrak{H}_{\mathbb{C}}\right\}   &  =4r=8\\
\mathbb{R}\text{-}\dim\left\{  \mathfrak{H}_{\mathbb{R}}\right\}   &  =2r=4.
\end{align}
The basis $\left\{  e_{5},e_{6},e_{7},e_{8}\right\}  $ is a copy of the basis
$\left\{  e_{1},e_{2},e_{3},e_{4}\right\}  .$

\begin{enumerate}
\item
\begin{lemma}%
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathbb{C}\otimes_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}=C_{\mathfrak{H}_{\mathbb{R}}}\left(  \mathfrak{H}_{\mathbb{R}%
}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}\right)  =C_{\mathfrak{H}%
_{\mathbb{R}}}\left(  \mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}%
}J_{\mathfrak{H}_{\mathbb{R}}}\mathfrak{H}_{\mathbb{R}}\right)  =\mathfrak{H}%
_{\mathbb{R}}\oplus_{\mathbb{R}}i\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}%
_{\mathbb{R}}+_{\mathbb{R}}i\mathfrak{H}_{\mathbb{R}}.
\end{equation}

\end{lemma}

\begin{proof}
The tensor product can be expanded in terms of a direct sum as
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathbb{C}\otimes_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}=\left\{  1,i\right\}  \otimes_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}=1\otimes\mathfrak{H}_{\mathbb{R}}+_{\mathbb{R}}i\otimes
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathbb{R}}+_{\mathbb{R}}%
i\mathfrak{H}_{\mathbb{R}}.
\end{equation}
The complexification map $C_{\mathfrak{H}_{\mathbb{R}}}$
\begin{equation}
C_{\mathfrak{H}_{\mathbb{R}}}:\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}%
}\mathfrak{H}_{\mathbb{R}}\rightarrow\mathfrak{H}_{\mathbb{C}}%
\end{equation}
is given by its action on a basis
\begin{align}
C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j}\right)   &  =\mathfrak{e}_{j}%
;\quad1\leq j\leq2r\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j}\right)   &  =i\mathfrak{e}%
_{j-2r};\quad2r+1\leq j\leq4r\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}%
e_{j}\right)   &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j+2r}\right)
=i\mathfrak{e}_{j};\quad1\leq j\leq2r..
\end{align}


\begin{example}
$r=2$%
\begin{align}
C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j}\right)   &  =\mathfrak{e}_{j}%
;\quad1\leq j\leq4\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j}\right)   &  =i\mathfrak{e}%
_{j-4};\quad5\leq j\leq8\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}%
e_{j}\right)   &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j+4}\right)
=i\mathfrak{e}_{j};\quad1\leq j\leq4.
\end{align}
i.e.%
\begin{align}
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}%
e_{1}\right)   &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{5}\right)
=i\mathfrak{e}_{1}\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}%
e_{2}\right)   &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{6}\right)
=i\mathfrak{e}_{2}\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}%
e_{3}\right)   &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{7}\right)
=i\mathfrak{e}_{3}\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  J_{\mathfrak{H}_{\mathbb{R}}}%
e_{4}\right)   &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{8}\right)
=i\mathfrak{e}_{4}.
\end{align}

\end{example}

\begin{corollary}%
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}_{\mathfrak{H}_{\mathbb{R}}}.
\end{equation}

\end{corollary}

\begin{remark}
Complex multiplication in the direct sum is given by
\begin{align}
\mathfrak{v}  &  \in1\otimes v_{r}+_{\mathbb{R}}i\otimes\mathfrak{v}%
_{i};\,v\in\mathbb{C}\otimes_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}%
},\mathfrak{\,v}_{r},v_{i}\in\mathfrak{H}_{\mathbb{R}}\\
z  &  =\operatorname{Re}\left\{  z\right\}  +i\operatorname{Im}\left\{
z\right\} \\
z\mathfrak{v}  &  =\left(  \operatorname{Re}\left\{  z\right\}  \mathfrak{v}%
_{r}-\operatorname{Im}\left\{  z\right\}  \mathfrak{v}_{i}\right)  +i\left(
\operatorname{Re}\left\{  z\right\}  \mathfrak{v}_{i}+\operatorname{Im}%
\left\{  z\right\}  \mathfrak{v}_{r}\right)  ,
\end{align}
where
\begin{align}
\mathfrak{v}  &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right) \\
\mathfrak{v}_{r}  &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  v_{r}\right)
\leftrightarrow\operatorname{Re}_{\mathfrak{e}}\left(  \mathfrak{v}\right)
=\operatorname{Re}_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right) \\
\mathfrak{v}_{i}  &  =C_{\mathfrak{H}_{\mathbb{R}}}\left(  v_{i}\right)
\leftrightarrow\operatorname{Im}_{\mathfrak{e}}\left(  \mathfrak{v}\right)
=\operatorname{Im}_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)  .
\end{align}

\end{remark}
\end{proof}

\begin{remark}
The definition of $\mathfrak{H}_{\mathbb{C}}$ \emph{is basis} independent i.e.
one can choose any basis of $\mathfrak{H}_{\mathbb{R}}$ and $\mathbb{C}$ and
get the same space $\mathfrak{H}_{\mathbb{C}}.$
\end{remark}

\item The real symmetric inner product in $\mathfrak{H}_{\mathbb{R}}$ wrt the
conb $\left\{  \left.  e_{j}\right\vert 1\leq j\leq2r\right\}  $ is given by
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{\mathfrak{H}_{\mathbb{R}}%
}=\sum_{1\leq j,k\leq2r}\mathcal{R}_{\mathfrak{e}}\left(  v\right)
_{j}\mathcal{R}_{\mathfrak{e}}\left(  w\right)  _{k}\left\langle \left.
e_{j}\right\vert e_{k}\right\rangle _{\mathfrak{H}_{\mathbb{R}}}=\sum_{1\leq
j,k\leq2r}\mathcal{R}_{\mathfrak{e}}\left(  v\right)  _{j}\mathcal{R}%
_{\mathfrak{e}}\left(  w\right)  _{j}%
\end{equation}
and is representation (i.e. conb) independent.

\item The representation of bases elements of $\mathfrak{H}_{\mathbb{C}}$ is
given by
\begin{align}
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
e_{j}\right)  \right)   &  =\mathcal{R}_{\mathfrak{e}}\left(  \mathfrak{e}%
_{j}\right)  =\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}%
}\right)  \left(  \mathcal{R}_{e}\left(  e_{j}\right)  \right)  ;\quad1\leq
j\leq r\\
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
e_{j}\right)  \right)   &  =i\mathcal{R}_{\mathfrak{e}}\left(  \mathfrak{e}%
_{j-2r}\right)  =i\mathcal{R}_{e}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\right)
\left(  \mathcal{R}_{e}\left(  e_{j}\right)  \right)  ;\quad r+1\leq j\leq2r
\end{align}
and%
\begin{equation}
\mathcal{R}_{e}\left(  e_{j}\right)  =\mathcal{R}_{e}\left(  J_{\mathfrak{H}%
_{\mathbb{R}}}\left(  e_{j-2r}\right)  \right)  =\mathcal{R}_{e}\left(
J_{\mathfrak{H}_{\mathbb{R}}}\right)  \mathcal{R}_{e}\left(  e_{j-2r}\right)
;\quad r+1\leq j\leq2r.
\end{equation}


\item One can consider the representations wrt the bases $\left\{  \left.
\mathfrak{e}_{j}\right\vert 1\leq j\leq2r\right\}  $ of $\mathfrak{H}%
_{\mathbb{C}}$ and $\left\{  \left.  e_{j}\right\vert 1\leq j\leq2r\right\}  $
of $\mathfrak{H}_{\mathbb{R}}$ in the $r=2$ case
\begin{equation}
\mathcal{R}_{\mathfrak{e}}\left(  \mathfrak{H}_{\mathbb{C}}\right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \mathcal{R}_{\mathfrak{e}%
}\left(  \mathfrak{e}_{1}\right)  ,\mathcal{R}_{\mathfrak{e}}\left(
\mathfrak{e}_{2}\right)  ,\mathcal{R}_{\mathfrak{e}}\left(  \mathfrak{e}%
_{3}\right)  ,\mathcal{R}_{\mathfrak{e}}\left(  \mathfrak{e}_{4}\right)
\right\}  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\}
\end{equation}
and
\begin{equation}
\mathcal{R}_{e}\left(  \mathfrak{H}_{\mathbb{R}}\right)  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \mathcal{R}_{e}\left(  e_{1}\right)
,\mathcal{R}_{e}\left(  e_{2}\right)  ,\mathcal{R}_{e}\left(  e_{3}\right)
,\mathcal{R}_{e}\left(  e_{4}\right)  \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\}  ,
\end{equation}
hence the representations \emph{are identical}.

\begin{remark}
The space $\mathfrak{H}_{\mathbb{C}}$ which is the \emph{external
}complexification of $\mathfrak{H}_{\mathbb{R}}$ is also the \emph{internal}
complexification of $\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}%
\mathfrak{H}_{\mathbb{R}}$ by the subspace $\mathfrak{H}_{\mathbb{R}}$ so in
the $r=2$ case
\begin{equation}
\mathbb{C}\text{-}\dim\left\{  \mathfrak{H}_{\mathbb{C}}\right\}
=\mathbb{R}\text{-}\dim\left\{  \mathfrak{H}_{\mathbb{R}}\right\}  =4,
\end{equation}
while
\begin{equation}
\mathbb{R}\text{-}\dim\left\{  \mathfrak{H}_{\mathbb{C}}\right\}  =8.
\end{equation}

\end{remark}

\item In the $r=2$ case the complexification $J_{\mathfrak{H}_{\mathbb{R}}}$
and conjugation $\sigma_{\mathfrak{H}_{\mathbb{R}}}\in\mathcal{B}\left(
\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}\right)
$ and have representations belonging to $\mathcal{M}\left(  8,\mathbb{R}%
\right)  $
\begin{align}
\mathcal{R}_{e}\left(  J_{\mathfrak{H}_{\mathbb{R}}}\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbb{O} & -\mathbb{I}_{4}\\
\mathbb{I}_{4} & \mathbb{O}%
\end{array}
\right) \\
\mathcal{R}_{e}\left(  \sigma_{\mathfrak{H}_{\mathbb{R}}}\right)   &  =\left(
%
\begin{array}
[c]{cc}%
\mathbb{I}_{4} & \mathbb{O}\\
\mathbb{O} & -\mathbb{I}_{4}%
\end{array}
\right)  .
\end{align}


\item In the $r=2$ case the "complexification" $J_{\mathfrak{H}_{\mathbb{C}}}$
and conjugation $\sigma_{\mathfrak{e}}\in\mathcal{B}_{\mathbb{R}}\left(
\mathfrak{H}_{\mathbb{C}}\right)  $ and have representations belonging to
$\mathcal{M}\left(  4,\mathbb{C}\right)  $%
\begin{align}
\mathcal{R}_{\mathfrak{e}}\left(  J_{\mathfrak{H}_{\mathbb{C}}}\right)   &
=\left(
\begin{array}
[c]{cc}%
\mathbb{O} & -\mathbb{I}_{2}\\
\mathbb{I}_{2} & \mathbb{O}%
\end{array}
\right) \\
\mathcal{R}_{\mathfrak{e}}\left(  \sigma_{\mathfrak{e}}\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{2} & \mathbb{O}\\
\mathbb{O} & -\mathbb{I}_{2}%
\end{array}
\right)  .
\end{align}


\item In the $r=2$ case%
\begin{align}
\mathcal{R}_{\mathfrak{e}}\left(  J_{\mathfrak{H}_{\mathbb{C}}}\right)   &
=\left\vert \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\vert \\
&  -\left(  \left\vert \left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  \right\vert \right)  .
\end{align}


\item In the $r=2$ case%
\begin{align}
\mathcal{R}_{\mathfrak{e}}\left(  \sigma_{\mathfrak{e}}\right)   &
=\left\vert \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  \right\vert \\
&  -\left(  \left\vert \left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\vert \right)  .
\end{align}


\item In the $r=2$ case%
\begin{align}
J_{\mathfrak{H}_{\mathbb{C}}}  &  =\left\vert \mathfrak{e}_{1}\right\rangle
\left\langle \mathfrak{e}_{3}\right\vert +\left\vert \mathfrak{e}%
_{2}\right\rangle \left\langle \mathfrak{e}_{4}\right\vert -\left(  \left\vert
\mathfrak{e}_{3}\right\rangle \left\langle \mathfrak{e}_{1}\right\vert
+\left\vert \mathfrak{e}_{4}\right\rangle \left\langle \mathfrak{e}%
_{2}\right\vert \right) \\
\sigma_{\mathfrak{H}_{\mathbb{C}}}  &  =\sigma_{\mathfrak{e}}=\left\vert
\mathfrak{e}_{1}\right\rangle \left\langle \mathfrak{e}_{1}\right\vert
+\left\vert \mathfrak{e}_{2}\right\rangle \left\langle \mathfrak{e}%
_{2}\right\vert -\left(  \left\vert \mathfrak{e}_{3}\right\rangle \left\langle
\mathfrak{e}_{3}\right\vert +\left\vert \mathfrak{e}_{4}\right\rangle
\left\langle \mathfrak{e}_{4}\right\vert \right)  .
\end{align}


\item In the $r=2$ case%
\begin{align}
&  \mathcal{R}_{\mathfrak{e}}\left(  \sigma_{\mathfrak{e}}\left(
\mathfrak{v}\right)  \right)  =\mathcal{R}_{\mathfrak{e}}\left(
\sigma_{\mathfrak{e}}\left(  \mathfrak{v}_{1}e_{1}+\mathfrak{v}_{2}%
e_{1}+\mathfrak{v}_{3}e_{3}+\mathfrak{v}_{4}e_{4}\right)  \right) \\
&  =\mathcal{R}_{\mathfrak{e}}\left(  \sigma_{\mathfrak{e}}\left(  \left(
\operatorname{Re}\left(  \mathfrak{v}_{1}\right)  +i\operatorname{Re}\left(
\mathfrak{v}_{1}\right)  \right)  e_{1}+\left(  \operatorname{Re}\left(
\mathfrak{v}_{2}\right)  +i\operatorname{Re}\left(  \mathfrak{v}_{2}\right)
\right)  e_{2}+\left(  \operatorname{Re}\left(  \mathfrak{v}_{3}\right)
+i\operatorname{Re}\left(  \mathfrak{v}_{3}\right)  \right)  e_{3}+\left(
\operatorname{Re}\left(  \mathfrak{v}_{4}\right)  +i\operatorname{Re}\left(
\mathfrak{v}_{4}\right)  \right)  e_{4}\right)  \right) \\
&  =\mathcal{R}_{\mathfrak{e}}\left(  \sigma_{\mathfrak{e}}\left(  \left(
v_{1}+iv_{5}\right)  e_{1}+\left(  v_{2}+iv_{6}\right)  e_{2}+\left(
v_{3}+iv_{7}\right)  e_{3}+\left(  v_{4}+iv_{8}\right)  e_{4}\right)  \right)
\\
&  =\mathcal{R}_{\mathfrak{e}}\left(  \left(  v_{1}-iv_{5}\right)
e_{1}+\left(  v_{2}-iv_{6}\right)  e_{2}+\left(  v_{3}-iv_{7}\right)
e_{3}+\left(  v_{4}-iv_{8}\right)  e_{4}\right) \\
&  =\mathcal{R}_{\mathfrak{e}}\left(  v_{1}e_{1}+v_{2}e_{2}+v_{3}e_{3}%
+v_{4}e_{4}\right)  -i\mathcal{R}_{\mathfrak{e}}\left(  v_{5}e_{1}+v_{6}%
e_{2}+v_{7}e_{3}+v_{8}e_{4}\right) \\
&  =\left(
\begin{array}
[c]{cccc}%
e_{1} & e_{2} & e_{3} & e_{4}%
\end{array}
\right)  \left(  \left(
\begin{array}
[c]{c}%
v_{1}\\
v_{2}\\
v_{3}\\
v_{4}%
\end{array}
\right)  -i\left(
\begin{array}
[c]{c}%
v_{5}\\
v_{6}\\
v_{7}\\
v_{8}%
\end{array}
\right)  \right)  \in\mathbb{C\otimes}_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}.
\end{align}


\item In the $r=2$ case%
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{\mathfrak{H}_{\mathbb{C}}%
}=\sum_{1\leq j,k\leq4}\overline{\mathcal{R}_{\mathfrak{e}}\left(  v\right)
}_{j}\mathcal{R}_{\mathfrak{e}}\left(  w\right)  _{k}\left\langle \left.
\mathfrak{e}_{j}\right\vert \mathfrak{e}_{k}\right\rangle _{\mathfrak{H}%
_{\mathbb{C}}}=\sum_{1\leq j\leq4}\overline{\mathcal{R}_{\mathfrak{e}}\left(
v\right)  }_{j}\mathcal{R}_{\mathfrak{e}}\left(  w\right)  _{j}.
\end{equation}


\item In the $r=2$ case%
\begin{align}
&  C_{\mathfrak{H}_{\mathbb{R}}}:\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}%
}\mathfrak{H}_{\mathbb{R}}\rightarrow\mathfrak{H}_{\mathbb{C}}=\mathbb{C}%
\otimes_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathbb{R}%
}+_{\mathbb{C}}i\mathfrak{H}_{\mathbb{R}}\\
C_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)   &  =C_{\mathfrak{H}%
_{\mathbb{R}}}\left(  \sum_{1\leq j\leq8}\mathcal{R}_{e}\left(  v\right)
_{j}e_{j}\right)  =\sum_{1\leq j\leq8}\mathcal{R}_{e}\left(  v\right)
_{j}C_{\mathfrak{H}_{\mathbb{R}}}\left(  e_{j}\right)  =\sum_{1\leq j\leq
4}\mathcal{R}_{e}\left(  v\right)  _{j}\mathfrak{e}_{j}+i\sum_{1\leq j\leq
4}\mathcal{R}_{e}\left(  v\right)  _{j+2}\mathfrak{e}_{j}\\
&  =\sum_{1\leq j\leq4}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}%
+\mathcal{R}_{e}\left(  v\right)  _{j+2}i\mathfrak{e}_{j}\right)  =\sum_{1\leq
j\leq4}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}+i\mathcal{R}_{e}\left(
v\right)  _{j+2}\right)  \mathfrak{e}_{j}=\sum_{1\leq j\leq4}\mathcal{R}%
_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)  \right)
_{j}%
\end{align}
hence
\begin{equation}
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
v\right)  \right)  _{j}=\mathcal{R}_{e}\left(  v\right)  _{j}+i\mathcal{R}%
_{e}\left(  v\right)  _{j+4};\quad1\leq j\leq4,
\end{equation}
i.e.%
\begin{align}
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
v\right)  \right)  _{1}  &  =\mathcal{R}_{e}\left(  v\right)  _{1}%
+i\mathcal{R}_{e}\left(  v\right)  _{5}\\
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
v\right)  \right)  _{2}  &  =\mathcal{R}_{e}\left(  v\right)  _{2}%
+i\mathcal{R}_{e}\left(  v\right)  _{6}\\
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
v\right)  \right)  _{3}  &  =\mathcal{R}_{e}\left(  v\right)  _{3}%
+i\mathcal{R}_{e}\left(  v\right)  _{7}\\
\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
v\right)  \right)  _{4}  &  =\mathcal{R}_{e}\left(  v\right)  _{4}%
+i\mathcal{R}_{e}\left(  v\right)  _{8}.
\end{align}


\begin{definition}%
\begin{equation}
\mathfrak{H}_{2\mathbb{R}}=\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}%
}\mathfrak{H}_{\mathbb{R}}%
\end{equation}

\end{definition}

\item The inner product in $\mathfrak{H}_{\mathbb{C}}$ can be expressed in
terms of the inner product $\left\langle \left.  {}\right\vert \right\rangle
_{\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}}$ and
symplectic product $\left\{  ,\right\}  _{\mathfrak{H}_{\mathbb{R}}%
\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}}$ in as
\begin{align}
\left\langle \left.  C_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)
\right\vert C_{\mathfrak{H}_{\mathbb{R}}}\left(  w\right)  \right\rangle
_{\mathfrak{H}_{\mathbb{C}}}  &  =\sum_{1\leq j\leq4}\overline{\mathcal{R}%
_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)  \right)
}_{j}\mathcal{R}_{\mathfrak{e}}\left(  C_{\mathfrak{H}_{\mathbb{R}}}\left(
w\right)  \right)  _{j}\\
&  =\sum_{1\leq j\leq4}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}%
\mathcal{R}_{e}\left(  w\right)  _{j}+\mathcal{R}_{e}\left(  v\right)
_{j+4}\mathcal{R}_{e}\left(  w\right)  _{j+4}\right)  +i\sum_{1\leq j\leq
4}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}\mathcal{R}_{e}\left(
w\right)  _{j+4}-\mathcal{R}_{e}\left(  v\right)  _{j+4}\mathcal{R}_{e}\left(
w\right)  _{j}\right) \\
&  =\left(  \left\langle \left.  v_{r}\right\vert w_{r}\right\rangle
_{\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}%
}+\left\langle \left.  v_{i}\right\vert w_{i}\right\rangle _{\mathfrak{H}%
_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}}\right)  +i\left(
\left\langle \left.  v_{r}\right\vert w_{i}\right\rangle _{\mathfrak{H}%
_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}}-\left\langle
\left.  v_{i}\right\vert w_{r}\right\rangle _{\mathfrak{H}_{\mathbb{R}}%
\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}}\right)  ,
\end{align}
where
\begin{equation}
\left\{  v,w\right\}  _{\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}%
}\mathfrak{H}_{\mathbb{R}}}=\left\langle \left.  v_{r}\right\vert
w_{i}\right\rangle _{\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}%
\mathfrak{H}_{\mathbb{R}}}-\left\langle \left.  v_{i}\right\vert
w_{r}\right\rangle _{\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}%
\mathfrak{H}_{\mathbb{R}}}.
\end{equation}

\end{enumerate}
\end{example}

\begin{remark}%
\begin{gather}
2\operatorname{Re}_{\mathfrak{e}}\left\{  \mathfrak{v}\right\}  =\mathfrak{v}%
+\sigma_{\mathfrak{e}}\left(  \mathfrak{v}\right)  =2\operatorname{Re}%
_{\mathfrak{e}}\left\{  \mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(
v\right)  \right\}  =\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)
+\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  \sigma_{\mathfrak{H}%
_{\mathbb{R}}}\left(  v\right)  \right) \\
2i\operatorname{Im}_{\mathfrak{e}}\left\{  \mathfrak{v}\right\}
=\mathfrak{v}-\sigma_{\mathfrak{e}}\left(  \mathfrak{v}\right)
=2i\operatorname{Im}_{\mathfrak{e}}\left\{  \mathcal{C}_{\mathfrak{H}%
_{\mathbb{R}}}\left(  v\right)  \right\}  =\mathcal{C}_{\mathfrak{H}%
_{\mathbb{R}}}\left(  v\right)  -\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}%
}\left(  \sigma_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)  \right) \\
\mathfrak{v}\in\mathfrak{H}_{\mathbb{C}},v\in\mathfrak{H}_{\mathbb{R}}%
\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}.
\end{gather}

\end{remark}

\begin{remark}
$\mathfrak{H}_{\mathbb{C}}$ is the external complexification of $\mathfrak{H}%
_{\mathbb{R}}$ which is equal to the internal complexification of
$\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}$
induced by $\mathfrak{H}_{\mathbb{R}}$
\begin{align}
\mathfrak{H}_{\mathbb{C}}  &  =\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(
\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}\right)
\\
\dim\left\{  \mathfrak{H}_{\mathbb{C}}\right\}   &  =2r,\quad\dim\left\{
\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}_{\mathbb{R}}\right\}
=4r.
\end{align}

\end{remark}

\begin{remark}%
\begin{align}
\operatorname{Re}_{\mathfrak{e}}\left\{  \mathfrak{H}_{\mathbb{C}}\right\}
&  =\left\{  \left.  \mathfrak{v}+\sigma_{\mathfrak{e}}\left(  \mathfrak{v}%
\right)  \right\vert \mathfrak{v\in H}_{\mathbb{C}}\right\} \\
&  =\left\{  \left.  v+\sigma_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)
\right\vert v\in\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}\right\} \\
i\operatorname{Im}_{\mathfrak{e}}\left\{  \mathfrak{H}_{\mathbb{C}}\right\}
&  =\left\{  \left.  \mathfrak{v}-\sigma_{\mathfrak{e}}\left(  \mathfrak{v}%
\right)  \right\vert \mathfrak{v\in H}_{\mathbb{C}}\right\} \\
&  =\left\{  \left.  v-\sigma_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)
\right\vert v\in\mathfrak{H}_{\mathbb{R}}\oplus_{\mathbb{R}}\mathfrak{H}%
_{\mathbb{R}}\right\}
\end{align}

\end{remark}

\begin{remark}%
\begin{align}
\operatorname{Re}_{\mathfrak{e}}\left\{  \mathfrak{H}_{\mathbb{C}}\right\}
&  =\mathfrak{H}_{\mathbb{R}}\\
i\operatorname{Im}_{\mathfrak{e}}\left\{  \mathfrak{H}_{\mathbb{C}}\right\}
&  =\mathfrak{H}_{\mathbb{R}}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\operatorname{Re}_{\mathfrak{e}}\left\{
\mathfrak{H}_{\mathbb{C}}\right\}  +_{\mathbb{R}}i\operatorname{Im}%
_{\mathfrak{e}}\left\{  \mathfrak{H}_{\mathbb{C}}\right\}  .
\end{equation}


\begin{example}
$r=2;2r=4$

\begin{enumerate}
\item
\begin{gather}
\mathfrak{v}=\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  v\right)  =\left(
%
\begin{array}
[c]{cccc}%
\mathfrak{e}_{1} & \mathfrak{e}_{2} & \mathfrak{e}_{3} & \mathfrak{e}_{4}%
\end{array}
\right)  \mathcal{R}_{\mathfrak{e}}\left(  \mathfrak{v}\right)  =\left(
\begin{array}
