\begin{remark}%
\begin{equation}
\left(
\begin{array}
[c]{cccccccc}%
1 & 0 & 0 & 0 & i & 0 & 0 & 0\\
0 & 1 & 0 & 0 & 0 & i & 0 & 0\\
