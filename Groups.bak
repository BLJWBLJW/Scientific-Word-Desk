v_{r}\oplus_{\mathbb{R}}v_{i}\right)  \right)  \right)  =\frac{1}%
{2}\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  v_{r}\oplus_{\mathbb{R}%
}v_{i}\right)  -_{\mathbb{R}}\left(  \left(  v_{r}\oplus_{\mathbb{R}}\left(
-v_{i}\right)  \right)  \right) \\
&  =\frac{1}{2}\mathcal{C}_{\mathfrak{H}_{\mathbb{R}}}\left(  2v_{i}\right)  .
\end{align}

