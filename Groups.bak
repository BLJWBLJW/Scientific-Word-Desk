,\right. \\
&  \left(  \left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
14\right\rangle \left\langle 14\right\vert \right)  -\left(  \left\vert
23\right\rangle \left\langle 23\right\vert -\left\vert 24\right\rangle
\left\langle 24\right\vert \right)  ,\,\left(  \left\vert 13\right\rangle
\left\langle 13\right\vert -\left\vert 14\right\rangle \left\langle
14\right\vert \right)  +\left(  \left\vert 23\right\rangle \left\langle
23\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert \right)
,\\
&  \left.  \left(  \left\vert 14\right\rangle \left\langle 14\right\vert
-\left\vert 23\right\rangle \left\langle 23\right\vert \right)  ,\left(
\mathbf{5}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left\vert 12\right\rangle
\left\langle 13\right\vert ,\left\vert 12\right\rangle \left\langle
14\right\vert ,\left\vert 12\right\rangle \left\langle 23\right\vert
,\left\vert 12\right\rangle \left\langle 24\right\vert ,\left\vert
13\right\rangle \left\langle 12\right\vert ,\left\vert 13\right\rangle
\left\langle 14\right\vert ,\left\vert 13\right\rangle \left\langle
23\right\vert ,\left\vert 13\right\rangle \left\langle 34\right\vert ,\right.
\\
&  \left\vert 14\right\rangle \left\langle 12\right\vert ,\left\vert
14\right\rangle \left\langle 13\right\vert ,\left\vert 14\right\rangle
\left\langle 24\right\vert ,\left\vert 14\right\rangle \left\langle
34\right\vert ,\left\vert 23\right\rangle \left\langle 12\right\vert
,\left\vert 23\right\rangle \left\langle 13\right\vert ,\left\vert
23\right\rangle \left\langle 24\right\vert ,\left\vert 23\right\rangle
\left\langle 34\right\vert ,\\
&  \left.  \left\vert 24\right\rangle \left\langle 12\right\vert ,\left\vert
24\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 23\right\vert ,\left\vert 24\right\rangle \left\langle
34\right\vert ,\left\vert 34\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 14\right\vert ,\left\vert
34\right\rangle \left\langle 23\right\vert ,\left\vert 34\right\rangle
\left\langle 24\right\vert ,\left(  \mathbf{24}\right)  \right\}  .\\
&  \oplus\operatorname*{linspan}\left\{  \left\vert 12\right\rangle
\left\langle 34\right\vert ,\left\vert 13\right\rangle \left\langle
24\right\vert ,\left\vert 14\right\rangle \left\langle 23\right\vert
,\left\vert 23\right\rangle \left\langle 14\right\vert ,\left\vert
24\right\rangle \left\langle 13\right\vert ,\left\vert 34\right\rangle
\left\langle 12\right\vert ,\left(  \mathbf{6}\right)  \right\} \\
&  =\left\{  \left.  \operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}X\right\}  =0\right\vert 1\leq j_{1}<j_{2}%
,k_{1}<k_{2}\leq4,X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}
,
\end{align}
leading to the kernal difference space

\item $\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}
$%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }  &
=\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)
1d}\oplus\,\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
0-1\right)  0d}\,\text{\thinspace}=\ker\left\{  L_{2}^{0}\right\}  \ominus
\ker\left\{  L_{2}^{1}\right\} \\
&  =\,\operatorname*{linspan}\left\{  \left(  \left\vert 13\right\rangle
\left\langle 23\right\vert +\left\vert 14\right\rangle \left\langle
24\right\vert \right)  ,\left(  \left\vert 12\right\rangle \left\langle
23\right\vert -\left\vert 14\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 12\right\rangle \left\langle 24\right\vert +\left\vert
13\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \quad\left(  \left\vert 12\right\rangle \left\langle 13\right\vert
+\left\vert 24\right\rangle \left\langle 34\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert +\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\\
&  \quad\left(  \left\vert 13\right\rangle \left\langle 23\right\vert
-\left\vert 14\right\rangle \left\langle 24\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 23\right\vert +\left\vert
14\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
12\right\rangle \left\langle 24\right\vert -\left\vert 13\right\rangle
\left\langle 34\right\vert \right)  ,\\
&  \,\,\,\,\,\left.  \left(  \left\vert 12\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 13\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{12}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert \right)  +\left(  \left\vert 24\right\rangle \left\langle
24\right\vert -\left\vert 34\right\rangle \left\langle 34\right\vert \right)
,\right. \\
&  .\left.  \,\left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert \right)  +\left(
\left\vert 23\right\rangle \left\langle 23\right\vert -\left\vert
24\right\rangle \left\langle 24\right\vert \right)  ,\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  ,\left(  \mathbf{3}\right)  \right\}  .
\end{align}

\end{enumerate}
\end{example}

\begin{remark}
This shows that
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }%
\cong\ker\left\{  L_{1}^{0}\right\}  .
\end{equation}

\end{remark}

\begin{remark}
The difference of kernal space contains Ket-Bras that are $0,1,$or $2$ differences.
\end{remark}

\begin{lemma}
Expansion maps can be expresssd as iterated maps
\begin{equation}
\Gamma_{p}^{n}=\Gamma_{n-1}^{n}\circ\Gamma_{n-2}^{n-1}\circ\cdots\circ
\Gamma_{p+1}^{p+2}\circ\Gamma_{p}^{p+1},
\end{equation}
i.e.
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{p}\right)  \overset{\Gamma_{p}^{n}%
}{\rightarrow}\mathcal{B}\left(  \mathcal{H}^{n}\right)  =\mathcal{B}\left(
\mathcal{H}^{p}\right)  \overset{\Gamma_{p}^{p+1}}{\rightarrow}\mathcal{B}%
\left(  \mathcal{H}^{p+1}\right)  \overset{\Gamma_{p+1}^{p+2}}{\rightarrow
}\cdots\overset{\Gamma_{n-2}^{n-1}}{\rightarrow}\mathcal{B}\left(
\mathcal{H}^{n-1}\right)  \overset{\Gamma_{n-1}^{n}}{\rightarrow}%
\mathcal{B}\left(  \mathcal{H}^{n}\right)  .
\end{equation}

\end{lemma}

\begin{example}%
\begin{align}
\Gamma_{2}^{n}  &  :\mathcal{B}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{n}\right) \\
\Gamma_{2}^{n}  &  =\Gamma_{n-1}^{n}\circ\Gamma_{n-2}^{n-1}\circ\cdots
\circ\Gamma_{2}^{3}.
\end{align}

\end{example}

From the definition of $L_{n}^{p}$ it follows that the kernals of the
contraction maps are a nested sequence of subspaces which are related by
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \supseteq\ker\left\{  L_{n}%
^{0}\right\}  \supseteq\cdots\supseteq\ker\left\{  L_{n}^{p}\right\}
\supseteq\ker\left\{  L_{n}^{p+1}\right\}  \supseteq\cdots\supseteq
\ker\left\{  L_{n}^{n-1}\right\}  \supseteq\ker\left\{  L_{n}^{n}\right\}
;0\leq p\leq n,
\end{equation}
which allows one to define the \emph{"pure part"} trace class subspaces
\begin{gather}
\ker\left\{  L_{n}^{p-1}\right\}  \supseteq\ker\left\{  L_{n}^{p}\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  \left(  p-1\right)
-p\right)  }\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}%
=\ker\left\{  L_{n}^{p-1}\right\}  \ominus\ker\left\{  L_{n}^{p}\right\} \\
1\leq p\leq n,
\end{gather}
i.e.%
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  ^{c_{1}}=\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  \ominus\ker\left\{  L_{n}^{0}\right\}  =\left\{  \left.
L_{n}^{0}\left(  X\right)  \neq0\right\vert X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  \right\}
\end{equation}
and
\begin{align}
\ker\left\{  L_{n}^{0}\right\}   &  =\ker\left\{  \operatorname{Tr}%
_{\mathcal{H}^{n}}\right\}  =\left\{  \left.  \operatorname{Tr}_{\mathcal{H}%
^{n}}\left\{  X\right\}  =0\right\vert X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  \right\} \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\cup\\
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{0-1}  &  =\ker\left\{
L_{n}^{0}\right\}  \ominus\ker\left\{  L_{n}^{1}\right\}  =\left\{  \left.
L_{n}^{2}\left(  X\right)  \neq0,L_{n}^{1}\left(  X\right)  =0\right\vert
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\} \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\cup\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\,\,\,\,\vdots\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\cup\\
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  n-1\right)  -\left(
n-2\right)  }  &  =\ker\left\{  L_{n}^{n-2}\right\}  \ominus\ker\left\{
L_{n}^{n-1}\right\}  =\left\{  \left.  L_{n}^{n-1}\left(  X\right)
\neq0,L_{n}^{n-2}\left(  X\right)  =0\right\vert X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  \right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  n-1\right)  -n}  &
=\ker\left\{  L_{n}^{n-1}\right\}  \ominus\ker\left\{  L_{n}^{n}\right\}
=\left\{  \left.  L_{n}^{n}\left(  X\right)  \neq0,L_{n}^{n-1}\left(
X\right)  =0\right\vert X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\right\}  .
\end{align}


\begin{definition}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{0}=\ker\left\{  L_{n}%
^{0}\right\}  ^{c}.
\end{equation}
\qquad
\end{definition}

\begin{example}%
\begin{align}
L_{2}^{2}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right) \\
L_{2}^{1}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right) \\
L_{2}^{0}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  =\mathbb{C}\\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)   &  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{2}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{0-1}\oplus\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}},
\end{align}
where%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2}  &  =\ker\left\{
L_{2}^{1}\right\}  \ominus\ker\left\{  L_{2}^{2}\right\}  =\left\{  \left.
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\vert L_{2}%
^{1}\left(  X\right)  =0\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }  &
=\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}
=\left\{  \left.  X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\right\vert L_{2}^{0}\left(  X\right)  =0\right\}  \ominus\left\{  \left.
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\vert L_{2}%
^{1}\left(  X\right)  =0\right\} \\
\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}  &  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \ominus\ker\left\{  L_{2}^{0}\right\}  =\left\{
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}  \ominus\left\{
\left.  X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\vert
L_{2}^{0}\left(  X\right)  =0\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)   &  =\ker\left\{  L_{2}%
^{0}\right\}  ^{c_{1}}\oplus\ker\left\{  L_{2}^{0}\right\}  =\ker\left\{
L_{2}^{0}\right\}  ^{c}\oplus\left(  \left(  \ker\left\{  L_{2}^{0}\right\}
\ominus\ker\left\{  L_{2}^{1}\right\}  \right)  \oplus\left(  \ker\left\{
L_{2}^{1}\right\}  \ominus\ker\left\{  L_{2}^{2}\right\}  \right)  \right) \\
&  =\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}\oplus\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2}\right) \\
&  =\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2}.
\end{align}

\end{example}

\begin{example}
In finite dimensions
\begin{align}
&  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\ker\left\{  L_{1}%
^{0}\right\}  ^{c_{1}}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
_{\left(  0-1\right)  }\\
&  \ker\left\{  L_{1}^{0}\right\}  ^{c_{1}}=\left\{  \left.  X\right\vert
\operatorname{Tr}\left\{  X\right\}  \neq0,X\in\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  \right\}  =\left\{  \left.  zI_{\mathcal{H}^{1}%
}\right\vert z\neq0\right\} \\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0-1\right)
}=\left\{  \left.  X-\frac{1}{r}\operatorname{Tr}\left\{  X\right\}
I_{\mathcal{H}^{1}}\right\vert X\in\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  \right\}  =\left\{  \left.  X\right\vert \operatorname{Tr}%
\left\{  X\right\}  =0,X\in\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(
0-1\right)  0d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(
0-1\right)  1d}\\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0-1\right)
0d}=\operatorname*{linspan}\left\{  \left.  \left\vert j\right\rangle
\left\langle j\right\vert -\right\vert \left\vert j+1\right\rangle
\left\langle j+1\right\vert 1\leq j\leq r-1\right\} \\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0-1\right)
1d}=\operatorname*{linspan}\left\{  \left.  \left\vert j\right\rangle
\left\langle k\right\vert \right\vert 1\leq j\neq k\leq r\right\}  .
\end{align}

\end{example}

\begin{example}
$r=2$%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0-1\right)  }  &
=\ker\left\{  L_{1}^{0}\right\}  ^{c_{1}}=\left\{  \left.  X-\frac{1}%
{2}\operatorname{Tr}\left\{  X\right\}  I_{2}\right\vert X\in\mathcal{B}%
_{1}\left(  \mathbb{C}^{2}\right)  \right\}  =\left\{  \left(
\begin{array}
[c]{cc}%
x_{11}-\frac{1}{2}\left(  x_{11}+x_{22}\right)  & x_{12}\\
x_{21} & x_{22}-\frac{1}{2}\left(  x_{11}+x_{22}\right)
\end{array}
\right)  \right\} \\
&  =\left\{  \left.  X-\operatorname{Tr}\left\{  X\right\}  \right\vert
X\in\mathcal{B}_{1}\left(  \mathbb{C}^{2}\right)  \right\}  =\left\{  \left(
\begin{array}
[c]{cc}%
x_{11} & x_{12}\\
x_{21} & x_{22}%
\end{array}
\right)  -\left(  x_{11}+x_{22}\right)  \right\}
\end{align}
and%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}  &  =\mathbb{C}%
-\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}  &  =\mathbb{C}%
-\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \right\} \\
\ker\left\{  L_{1}^{0}\right\}  ^{c_{1}}  &  =\mathbb{C}%
-\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right\}  .
\end{align}

\end{example}

\begin{example}
$n=1,r=4$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\ker\left\{  L_{1}%
^{0}\right\}  ^{c_{1}}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
_{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1},
\end{equation}
where%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}  &
=\operatorname*{linspan}\left\{  \left\vert 1\right\rangle \left\langle
2\right\vert ,\left\vert 1\right\rangle \left\langle 3\right\vert ,\left\vert
1\right\rangle \left\langle 4\right\vert ,\left\vert 2\right\rangle
\left\langle 3\right\vert ,\left\vert 2\right\rangle \left\langle 4\right\vert
,\left\vert 3\right\rangle \left\langle 4\right\vert ,\left\vert
2\right\rangle \left\langle 1\right\vert ,\left\vert 3\right\rangle
\left\langle 1\right\vert ,\left\vert 4\right\rangle \left\langle 1\right\vert
,\left\vert 3\right\rangle \left\langle 2\right\vert ,\left\vert
4\right\rangle \left\langle 2\right\vert ,\left\vert 4\right\rangle
\left\langle 3\right\vert \right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}  &
=\operatorname*{linspan}\left\{  \left\vert 1\right\rangle \left\langle
1\right\vert -\left\vert 2\right\rangle \left\langle 2\right\vert ,\left\vert
2\right\rangle \left\langle 2\right\vert -\left\vert 3\right\rangle
\left\langle 3\right\vert ,\left\vert 3\right\rangle \left\langle 3\right\vert
-\left\vert 4\right\rangle \left\langle 4\right\vert \right\}  .
\end{align}

\end{example}

\begin{example}
$n=2,r=4$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2},
\end{equation}
where

\begin{enumerate}
\item
\begin{align*}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2}  &  \equiv\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1-2\right)  }=\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1-2\right)  2d}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1-2\right)  1d}%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1-2\right)
0d}=\ker\left\{  L_{2}^{1}\right\} \\
&  =\operatorname*{linspan}\left\{  \left\vert 12\right\rangle \left\langle
34\right\vert ,\left\vert 13\right\rangle \left\langle 24\right\vert
,\left\vert 14\right\rangle \left\langle 23\right\vert ,\left\vert
23\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 13\right\vert ,\left\vert 34\right\rangle \left\langle
12\right\vert ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\}
^{\dagger}\\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right)  \right. \\
&  \left.  \left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert +\left\vert 24\right\rangle \left\langle
24\right\vert ,\left(  \mathbf{2}\right)  \right\}  .
\end{align*}


\item
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{1}  &  \equiv\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  }=\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)  1d}\oplus
\,\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0-1\right)
0d}\,\text{\thinspace}=\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{
L_{2}^{1}\right\} \\
&  =\,\operatorname*{linspan}\left\{  \left(  \left\vert 13\right\rangle
\left\langle 23\right\vert +\left\vert 14\right\rangle \left\langle
24\right\vert \right)  ,\left(  \left\vert 12\right\rangle \left\langle
23\right\vert -\left\vert 14\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 12\right\rangle \left\langle 24\right\vert +\left\vert
13\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \quad\left(  \left\vert 12\right\rangle \left\langle 13\right\vert
+\left\vert 24\right\rangle \left\langle 34\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert +\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\\
&  \quad\left(  \left\vert 13\right\rangle \left\langle 23\right\vert
-\left\vert 14\right\rangle \left\langle 24\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 23\right\vert +\left\vert
14\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
12\right\rangle \left\langle 24\right\vert -\left\vert 13\right\rangle
\left\langle 34\right\vert \right)  ,\\
&  \,\,\,\,\,\left.  \left(  \left\vert 12\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 13\right\rangle \left\langle 14\right\vert +\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{12}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert \right)  +\left(  \left\vert 24\right\rangle \left\langle
24\right\vert -\left\vert 34\right\rangle \left\langle 34\right\vert \right)
,\right. \\
&  .\left.  \,\left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert \right)  +\left(
\left\vert 23\right\rangle \left\langle 23\right\vert -\left\vert
24\right\rangle \left\langle 24\right\vert \right)  ,\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  ,\left(  \mathbf{3}\right)  \right\}  .
\end{align}


\item
\begin{equation}
\ker\left\{  L_{2}^{0}\right\}  ^{c}\equiv\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}=\left\{  \left.  zI_{\mathcal{H}^{2}}\right\vert
z\neq0\in\mathbb{C}\right\}  .
\end{equation}

\end{enumerate}
\end{example}

\begin{example}
$n=4,r=4$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{4}\right)  _{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
_{2}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{3}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{4}%
\end{equation}%
\begin{align}
&  \mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  3-4\right)
}\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{4}=\phi\\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  2-3\right)
}\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{3}=\phi\\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  1-2\right)
}\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{2}=\phi\\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  0-1\right)
}\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{1}=\phi\\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{0}\equiv\ker\left\{
L_{4}^{0}\right\}  ^{c}=\left\{  \left.  zI_{\mathcal{H}^{2}}\right\vert
z\neq0\in\mathbb{C}\right\}  .
\end{align}

\end{example}

\begin{example}%
\begin{align}
X  &  =X_{\left(  2\right)  }+X_{\left(  1\right)  }+X_{\left(  0\right)  }\\
L_{2}^{2}\left(  X\right)   &  =X\\
L_{2}^{1}\left(  X_{\left(  2\right)  }\right)   &  =0\\
L_{2}^{0}\left(  X_{\left(  1\right)  }\right)   &  =0
\end{align}
and
\begin{align}
L_{2}^{2}\left(  X_{\left(  2\right)  }+X_{\left(  1\right)  }+X_{\left(
0\right)  }\right)   &  =X_{\left(  2\right)  }+X_{\left(  1\right)
}+X_{\left(  0\right)  }=\operatorname{Ran}\left\{  L_{2}^{2}\right\} \\
L_{2}^{1}\left(  X_{\left(  2\right)  }+X_{\left(  1\right)  }+X_{\left(
0\right)  }\right)   &  =X_{\left(  1\right)  }+X_{\left(  0\right)
}=\operatorname{Ran}\left\{  L_{2}^{1}\right\} \\
L_{2}^{0}\left(  X_{\left(  2\right)  }+X_{\left(  1\right)  }+X_{\left(
0\right)  }\right)   &  =X_{\left(  0\right)  }=\operatorname{Ran}\left\{
L_{2}^{0}\right\}
\end{align}

\end{example}

\begin{proposition}%
\begin{equation}
L_{n}^{0}\left(  X_{p}\right)  =0;1\leq p\leq n,1\leq n\leq r.
\end{equation}

\end{proposition}

\begin{corollary}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)
-q}\subset\ker L_{n}^{p};1\leq p\leq n,p+1\leq q\leq n,1\leq n\leq r
\end{equation}

\end{corollary}

\begin{proposition}%
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  =%
%TCIMACRO{\tbigoplus \limits_{p+1\leq q\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{p+1\leq q\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)  -q}.
\end{equation}

\end{proposition}

\begin{proposition}%
\begin{equation}%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)  -q}%
\cong\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  =%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  q-1\right)  -q}.
\end{equation}

\end{proposition}

Taking the compliment of the nested subspace of kernals one obtains
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  ^{c_{1}}\subseteq\cdots\subseteq\ker\left\{
L_{n}^{p}\right\}  ^{c_{1}}\subseteq\ker\left\{  L_{n}^{p+1}\right\}  ^{c_{1}%
}\subseteq\cdots\subseteq\ker\left\{  L_{n}^{n-1}\right\}  ^{c_{1}}%
\subseteq\ker\left\{  L_{n}^{n}\right\}  ^{c_{1}};0\leq p\leq n,
\end{equation}


\begin{remark}%
\begin{align}
\ker\left\{  L_{n}^{n}\right\}  ^{c_{1}}  &  =\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right) \\
\ker\left\{  L_{n}^{0}\right\}  ^{c}  &  =\left\{  \left.  zI_{\binom{r}{n}%
}\right\vert z\neq0\right\}  .
\end{align}

\end{remark}

\begin{lemma}
The contraction map $L_{n}^{p}$ is injective \emph{on} $\left(  \ker\left\{
L_{n}^{p}\right\}  \right)  ^{c_{1}}$ $\subseteq\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  $ i.e.
\begin{equation}
L_{n}^{p}:%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)
-q}\rightarrow%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  q-1\right)
-q}=\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
\end{equation}
is $1-1.$
\end{lemma}

\begin{corollary}
The contraction map $L_{n}^{p}$ is a vector space isomorphism \emph{on}
$\left(  \ker\left\{  L_{n}^{p}\right\}  \right)  ^{c_{1}}$ i.e.%
\begin{equation}
L_{n}^{p}:%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)
-q}\rightarrow%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  q-1\right)
-q}=\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  .
\end{equation}

\end{corollary}

\begin{remark}
$\left\{  \left.  L_{n}^{p}\right\vert 0\leq p\leq n,0\leq n\leq r\right\}  $
are \emph{linear star} mappings
\begin{equation}
L_{n}^{p}\left(  X^{\dagger}\right)  =L_{n}^{p}\left(  X\right)  ^{\dagger
};0\leq p\leq n,0\leq n\leq r,
\end{equation}
but \emph{not algebra homomorphisms} i.e in general
\begin{equation}
L_{n}^{p}\left(  XY\right)  \neq L_{n}^{p}\left(  X\right)  L_{n}^{p}\left(
Y\right)  ;0\leq p\leq n,0\leq n\leq r.
\end{equation}

\end{remark}

\begin{remark}
The sequence of contraction maps
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \overset{L_{n}^{n-1}%
}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{n-1}\right)
\overset{L_{n-1}^{n-2}}{\rightarrow}\cdots\overset{L_{2}^{1}}{\rightarrow
}\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \overset{L_{1}^{0}%
}{\rightarrow}\mathbb{C}%
\end{equation}
$\left\{  \left.  L_{n}^{n-1}\right\vert 0\leq n\leq r\right\}  $ is
\emph{NOT} exact. A sequence is exact if
\begin{equation}
\operatorname{Ran}\left\{  f_{k}\right\}  =\ker\left\{  f_{k+1}\right\}
\end{equation}
and
\begin{equation}
\operatorname{Ran}\left\{  L_{n}^{n-1}\right\}  \neq\ker\left\{  L_{n-1}%
^{n-2}\right\}
\end{equation}
as%
\begin{align}
\operatorname{Ran}\left\{  L_{n}^{n-1}\right\}   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n-1}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n-1}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n-1}\right)  _{\left(  q-1\right)  -q}\\
\ker\left\{  L_{n-1}^{n-2}\right\}   &  =\mathcal{B}_{1}\left(  \mathcal{H}%
^{n-1}\right)  _{\left(  n-2\right)  -\left(  n-1\right)  }.
\end{align}

\end{remark}

\begin{example}
Let $r=4,n=2$ then $\left\{  \left.  \mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{p}\right\vert 0\leq p\leq2\right\}  $ the sequence of maps
gives%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\left(  1-2\right)  }\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\left(  0-1\right)  }\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\overset{L_{2}^{1}}{\rightarrow}\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0-1\right)  }\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}\overset{L_{1}%
^{0}}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)
\end{equation}
and%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)   &  \cong\ker\left\{  L_{2}%
^{1}\right\}  ^{c_{1}}\\
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)   &  \cong\ker\left\{  L_{1}%
^{0}\right\}  ^{c_{1}}.
\end{align}
The subspaces are given explicitly by

\begin{enumerate}
\item
\begin{align*}
