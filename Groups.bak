\begin{lemma}
The subspaces
\begin{equation}
\left\{  \left.  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
l-\left(  l+1\right)  \right)  kd}\right\vert 0\leq l\leq n,0\leq k\leq
n\right\}
\end{equation}
are \emph{not invaraint to the group }$U\left(  r\right)  ,$while the
subspaces
\begin{equation}
\left\{  \left.  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
l-\left(  l+1\right)  \right)  }\right\vert 0\leq l\leq n\right\}
\end{equation}
are.
\end{lemma}
\end{enumerate}
\end{remark}

\begin{enumerate}
\item $\bigskip\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}$ wrt
\emph{a particular basis} is a subspace of commuting traceless operators
generated by the self adjoint partial isometries.

\item \bigskip Such operators produced by different bases do not commute in
general as%
\begin{align}
&  \left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert -\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert \right)
\left(  \left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert -\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert \right) \\
&  \neq\left(  \left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert -\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert \right)  \left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert -\left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert \right)  .
\end{align}


\item \bigskip The Irreducible Unitary/Spinor Decomposition of $\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  $ in terms of equivalence classes is
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\ker\left\{  L_{2}%
^{0}\right\}  ^{c_{1}}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{1}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2},
\end{equation}
which is in terms of concrete Ket-Bra subspaces%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\ker\left\{  L_{2}%
^{0}\right\}  ^{c_{1}}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{2}.
\end{equation}

\end{enumerate}

\begin{example}
\begin{enumerate}
\item
\begin{enumerate}
\item Operators with non zero trace in \emph{finite }dimensions are given by
\[
\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}\equiv\left\{  \left.  zP_{\binom
{4}{2}}\right\vert z\in\mathbb{C}\right\}  =\left\{  \left\{  \left.
zP_{6}\right\vert z\neq0\in\mathbb{C}\right\}  \right\}  ,
\]
where "$^{c_{1}}"$ denotes compliment in $\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  $ giving%
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\ker\left\{  L_{2}%
^{0}\right\}  ^{c_{1}}\oplus\ker\left\{  L_{2}^{0}\right\} \\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}\right\}  =1.
\end{gather}


\item If $r<\infty$ then
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{2}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  =\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}\oplus
\ker\left\{  L_{2}^{0}\right\}  .
\end{equation}


\item If $r=\infty$ then
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{2}\right)   &  \supset\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  =\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}%
\cup\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0\right)
-\left(  1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{\left(  1\right)  -\left(  2\right)  }\\
&  =\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}\cup\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{2}\right)
\end{align}

\end{enumerate}

\begin{remark}
In infinite dimensions $\ker\left\{  L_{2}^{0}\right\}  $ \emph{does not have}
a complement in $\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $ thus the
\emph{set} $\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}$ is not a closed subspace
wrt the trace class norm.
\end{remark}

\item for $r=4$%
\begin{align}
\dim\left\{  \mathcal{B}\left(  \mathcal{H}^{2}\right)  \right\}   &
=\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}
=36=\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  ^{c}\right\}  \oplus
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0}\right\}
\oplus\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{1}\right\}  \oplus\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{2}\right\} \\
&  =1+5+24+6=36.
\end{align}


\item If $X\in\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}$ then
\begin{equation}
\operatorname{Tr}\left\{  X\right\}  \in\left(  -\infty,0\right)  \cup\left(
0,\infty\right)  .
\end{equation}


\item If $r=4$
\begin{equation}
\ker\left\{  L_{2}^{0}\right\}  ^{c_{1}}=\operatorname*{linspan}\left\{
\left\vert 12\right\rangle \left\langle 12\right\vert +\left\vert
13\right\rangle \left\langle 13\right\vert +\left\vert 14\right\rangle
\left\langle 14\right\vert +\left\vert 23\right\rangle \left\langle
23\right\vert +\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right\}  .
\end{equation}

\end{enumerate}
\end{example}

\begin{remark}
The \emph{closure (the set plus all limit points)} of the finite rank
operators $\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  $ wrt trace class
norm is the trace class operators $\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  $ i.e.
\begin{equation}
\overline{\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  }^{\left\Vert
{}\right\Vert _{1}}=\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\end{equation}
all of which have finite trace. The limit points of $\mathcal{B}_{00}\left(
\mathcal{H}^{n}\right)  $ wrt $\left\Vert {}\right\Vert _{1}$ include the
boundary points $\partial_{1}\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  $
of $\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  $ wrt $\left\Vert
{}\right\Vert _{1},$ $\left(  \text{points who have neighbourhoods that are
not completlty contained in }\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)
.\text{ }\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  \text{ is the
interior of }\overline{\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)
}^{\left\Vert {}\right\Vert _{1}}\right)  .$
\end{remark}

\begin{remark}
The closure $\overline{\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  }^{s}$
of $\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  $ wrt the strong operator
topology is $\mathcal{B}\left(  \mathcal{H}^{n}\right)  .$ The boundary points
$\partial_{s}\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  $ of
$\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  $ wrt strong operator
topology do not have a trace (it is undefined or infinite). (However there
could also be \emph{interior points} of $\overline{\mathcal{B}_{00}\left(
\mathcal{H}^{n}\right)  }^{s}=\mathcal{B}\left(  \mathcal{H}^{n}\right)  $
that are not trace class e.g the identity operator).
\end{remark}

\begin{remark}
$\mathcal{B}\left(  \mathcal{H}^{n}\right)  /\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  $ are the operators that have infinite or undefined trace.
\end{remark}

\begin{remark}
The closures $\overline{\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  }%
_{p}^{\left\Vert {}\right\Vert }$ and $\overline{\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  }_{p}^{s}$ of the \emph{traceless} subspaces
$\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}$ wrt the operator norm
$\left\Vert {}\right\Vert $ and the strong operator topology \emph{could}
contain operators t\emph{hat do NOT have trace zero!}
\end{remark}

\begin{remark}
\emph{Any} operator $X\in\mathcal{F}$ can be expanded as a strongly convergent
sums
\begin{equation}
X=s-\lim\limits_{r\rightarrow\infty}\left\{  z_{ro}I_{\mathcal{F}}+\sum_{1\leq
n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}z_{rj_{1}\cdots j_{n}}x_{j_{1}%
}\cdots x_{j_{n}}\right\}
\end{equation}
and
\begin{equation}
X=s-\lim\limits_{r\rightarrow\infty}\left\{  \eta_{ro}I_{\mathcal{F}}%
+\sum_{\substack{0\leq n\leq r\\0\leq m\leq r\\\text{excluding }n=m=0}%
}\sum_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}<\cdots<k_{nm}\leq
r}}\eta_{rj_{1}\cdots j_{n}k_{1}\cdots k_{m}}a_{j_{1}}^{\dagger}\cdots
a_{j_{n}}^{\dagger}a_{k_{m}}\cdots a_{k_{1}}\right\}  .
\end{equation}

\end{remark}

\begin{remark}
The transformation between the two bases is not in general strongly continuous
unless $X\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  .$
\end{remark}

\begin{remark}
Any operator $X\in\mathcal{F}$ can be expanded as a strongly convergent sums%
\begin{equation}
X=s-\lim\limits_{r\rightarrow\infty}\left\{  \sum_{\substack{0\leq n\leq
r\\0\leq m\leq r}}\sum_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq
k_{1}<\cdots<k_{nm}\leq r}}x_{rj_{1}\cdots j_{n}k_{1}\cdots k_{m}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{m}%
}\cdots\varphi_{k_{1}}\right\vert \right\}  .
\end{equation}

\end{remark}

\begin{remark}
This can be restated in a more abstract form in terms of partial isometries
and orthogonal projectors as
\begin{equation}
X=s-\lim\limits_{r\rightarrow\infty}\left\{  \sum_{\substack{0\leq n\leq
r\\0\leq m\leq r}}\sum_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq
k_{1}<\cdots<k_{nm}\leq r}}x_{rj_{1}\cdots j_{n}k_{1}\cdots k_{m}}%
u_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}\right\}  ,
\end{equation}
where $\left\{  \left.  u_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}\right\vert
1\leq j_{1}<\cdots<j_{n}\leq r,1\leq k_{1}<\cdots<k_{nm}\leq r,0\leq n\leq
r,0\leq m\leq r\right\}  $ are partial isometries and $\left\{  \left.
u_{j_{1}\cdots j_{n}j_{1}\cdots j_{n}}\right\vert 1\leq j_{1}<\cdots<j_{n}\leq
r,,0\leq n\leq r\right\}  $ are in fact projectors such that
\begin{align}
u_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}\left(  u_{j_{1}\cdots j_{n}k_{1}\cdots
k_{m}}\right)  ^{\dagger}  &  =u_{j_{1}\cdots j_{n}j_{1}\cdots j_{n}}\\
\left(  u_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}\right)  ^{\dagger}%
u_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}  &  =u_{k_{1}\cdots k_{m}k_{1}\cdots
k_{m}}\\
\left(  u_{j_{1}\cdots j_{n}j_{1}\cdots j_{n}}\right)  ^{2}  &  =u_{j_{1}%
\cdots j_{n}j_{1}\cdots j_{n}}=\left(  u_{j_{1}\cdots j_{n}j_{1}\cdots j_{n}%
}\right)  ^{\dagger}\\
\left(  u_{k_{1}\cdots k_{m}k_{1}\cdots k_{m}}\right)  ^{2}  &  =u_{k_{1}%
\cdots k_{m}k_{1}\cdots k_{m}}=\left(  u_{k_{1}\cdots k_{m}k_{1}\cdots k_{m}%
}\right)  ^{\dagger}.
\end{align}

\end{remark}

\begin{remark}
Since a Banach space X is a vector space, it must possess a \emph{Hamel}%
$\equiv$vector space basis, i.e., a subset $\left\{  x_{\gamma}\right\}  $
whose finite linear span of all of $X$, which has the property that every
finite subcollection is linearly independent. Any element $x\in X$ can
therefore be written as some finite linear combination of $x_{\gamma}$.
However even a seperable infinite dimensional Banch space it would require an
uncountable Hamel basis. Moreover the proof of existance for arbitary infinte
dimensional spaces requires the axiom of choice (in fact the statement
"\"{e}very vector space has a hamel basis" is equivalent to the axiom of
choice). Hence for most Banach space there is no constructive method of
producing a Hamel basis.
\end{remark}

\begin{remark}
More useful than a \emph{Hamel} basis is a \emph{countable} sequence $\left\{
x_{\gamma}\right\}  $ such that every element $x\in X$ can be written as some
unique linear combination $x=\sum_{n}c_{n}x_{n}$. This leads to the following definition.
\end{remark}

\begin{enumerate}
\item A sequence $\left\{  x_{n}\right\}  $ in a Banach space $X$ is a basis
for $X$ if $\exists$ unique scalars $c_{n}$ such that $x=\sum_{n}c_{n}x_{n}.$

\item A basis$\left\{  x_{n}\right\}  $ is a non conditional basis if the
series converges unconditionally for each $x\in X$.

\item A basis $\left\{  x_{n}\right\}  $is an absolutely convergent basis if
the series converges absolutely for each $x\in X$.

\item A basis $\left\{  x_{n}\right\}  $ is a bounded basis if $\left\{
x_{\gamma}\right\}  $ is norm-bounded both above and below, i.e., if
$0<\left\Vert x_{\gamma}\right\Vert <1$.

\item A basis $\left\{  x_{n}\right\}  $ is a normalized basis iff $x_{\gamma
}$ is normalized, i.e, if $\left\Vert x_{n}\right\Vert =1$ for every $n$.
\end{enumerate}

\begin{definition}
A sequence $\left\{  x_{\gamma}\right\}  $ in a Banach space $X$ is a Schauder
basis for $X$ Schauder basis of $X$ if for every $x\in X$,%
\begin{equation}
x=\sum_{n}x_{n}^{d}\left(  x_{n}\right)  x_{n}%
\end{equation}
where $\left\{  x_{n}^{d}\right\}  $ are biorthogonal functionals belonging to
the dual space $X^{d}$ associated with $\left\{  x_{n}\right\}  .$ A basis
$\left\{  x_{n}\right\}  $ is a \emph{Schauder} basis if each coefficient
functional $x_{n}^{d}\left(  {}\right)  $ is continuous.

\begin{remark}
a Schauder basis or countable basis is similar to the usual (Hamel) basis of a
vector space;\emph{ the difference} is that Hamel bases use linear
combinations that are \emph{finite sums}, while for Schauder bases they may be
infinite sums. This makes Schauder bases more suitable for the analysis of
infinite-dimensional topological vector spaces including Banach spaces.
\end{remark}

\begin{remark}%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{pd}\\
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)   &  =\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(
p+1\right)  }\\
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(
p+1\right)  }  &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq p+1}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq p+1}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{pqd}\\
\ker\left\{  L_{n}^{p}\right\}   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq p}}
%EndExpansion
\ker\left\{  L_{n}^{p}\right\}  _{qd}%
\end{align}

\end{remark}
\end{definition}

\begin{definition}%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{pd}  &
=\operatorname*{linspan}\left\{  \left\{  \left.  \left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert \right\vert \right.  \left\{  g_{1},\cdots
,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}  =\left\{
i_{1},\cdots,i_{p}\right\}  \right\} \\
1  &  \leq g_{1}<\cdots<g_{p}\leq r,1\leq h_{1}<\cdots<h_{p}\leq r,0\leq p\leq
n.
\end{align}

\end{definition}

\begin{definition}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{pqd}=\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)  }%
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{qd};\quad0\leq q\leq p.
\end{equation}

\end{definition}

\begin{definition}%
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  _{qd}=\ker\left\{  L_{n}^{p}\right\}
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{qd};\quad0\leq q\leq p.
\end{equation}

\end{definition}

\begin{example}
$n=4,p=3,r=8$%
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{40}=%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq0}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq0}}
%EndExpansion
\operatorname*{linspan}\left\{  \left\{  \left.  \left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{4}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{4}}\right\vert \right\vert \right.  \left\{  g_{1},\cdots
,g_{4}\right\}  \cap\left\{  h_{1},\cdots,h_{4}\right\}  =\left\{
i_{1},\cdots,i_{q}\right\}  \right\} \\
=\operatorname*{linspan}\left\{  \left\{  \left.  \left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{4}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{4}}\right\vert \right\vert \right.  \left\{  g_{1},\cdots
,g_{4}\right\}  \cap\left\{  h_{1},\cdots,h_{4}\right\}  =\left\{
g_{1},\cdots,g_{4}\right\}  \right\} \\
1\leq g_{1}<\cdots<g_{4}\leq8,1\leq h_{1}<\cdots<h_{4}\leq8,0\leq p\leq4.
\end{gather}

\end{example}

\begin{theorem}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\ker\left\{  L_{n}%
^{0}\right\}  ^{c_{1}}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p},
\end{equation}
where for $1\leq p\leq n$
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p-1\right)  -p}%
\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}=\ker\left\{
L_{n}^{p-1}\right\}  \ominus\ker\left\{  L_{n}^{p}\right\}  .
\end{equation}

\end{theorem}

\begin{proof}%
\begin{align}
&
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}=%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\left(  \ker\left\{  L_{n}^{p-1}\right\}  \ominus\ker\left\{  L_{n}%
^{p}\right\}  \right)  =\ker\left\{  L_{n}^{0}\right\}  \ominus\ker\left\{
L_{n}^{1}\right\}  \oplus\ker\left\{  L_{n}^{1}\right\}  \ominus\ker\left\{
L_{n}^{2}\right\}  \oplus\\
&  \left.  \cdots\right.  \oplus\ker\left\{  L_{n}^{n-2}\right\}  \ominus
\ker\left\{  L_{n}^{n-1}\right\}  \oplus\ker\left\{  L_{n}^{n-1}\right\}
\ominus\ker\left\{  L_{n}^{n}\right\}  =\ker\left\{  L_{n}^{0}\right\}
\ominus\ker\left\{  L_{n}^{n}\right\}  =\ker\left\{  L_{n}^{0}\right\}
\end{align}
hence%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\ker\left\{  L_{n}%
^{0}\right\}  ^{c_{1}}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}.
\end{equation}

\end{proof}

\begin{corollary}%
\begin{equation}
X=X_{c_{1}}+\sum_{1\leq p\leq n}X_{\left(  p\right)  },
\end{equation}
where
\begin{equation}
X_{\left(  p\right)  }\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}%
\end{equation}
and
\begin{equation}
X_{c_{1}}=\operatorname{Tr}\left\{  X_{c_{1}}\right\}  \widehat{X_{c_{1}}},
\end{equation}
where
\begin{equation}
\operatorname{Tr}\left\{  \widehat{X_{c_{1}}}\right\}  =1.
\end{equation}

\end{corollary}

\begin{remark}
Neither $\ker\left\{  L_{n}^{0}\right\}  $ nor $\ker\left\{  L_{n}%
^{0}\right\}  ^{c_{1}}$ \emph{are} ideals, but they are algebraic subpaces.
$\ker\left\{  L_{n}^{0}\right\}  $ is also topological subspace.
\end{remark}

\begin{remark}
$\ker\left\{  L_{n}^{0}\right\}  ^{c_{1}}$ is not a closed subspace when
$r=\infty.$
\end{remark}

\begin{remark}
When $r=\infty$ the difference $P_{\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  }-P_{\ker\left\{  L_{n}^{0}\right\}  }$is not a projector and
$\ker\left\{  L_{n}^{0}\right\}  ^{c_{1}}$ is a non closed subspace.
\end{remark}

\begin{conjecture}
The sequences
\begin{equation}
\left\{  \left.  \widehat{X_{c_{1r}}}\right\vert 1\leq r\leq\infty\right\}
\text{ form approximate identities.}%
\end{equation}

\end{conjecture}

\begin{remark}
$U\left(  \mathcal{H}_{\mathcal{F}}\right)  $ transforms H-S orthonormal
Ket-Bras into H-S orthonormal Ket-Bras
\begin{equation}
\left\vert \Psi_{j}\right\rangle \left\langle \Psi_{k}\right\vert =u\left\vert
\Phi_{j}\right\rangle \left\langle \Phi_{k}\right\vert u^{\dagger};\quad u\in
U\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}
If $u\in U\left(  \mathcal{H}^{1}\right)  $ the \emph{degree} of the Ket-Bra
is conserved.
\end{remark}

\begin{theorem}
If $u\in U\left(  \mathcal{H}^{1}\right)  $ then the degree of the following
Ket-Bra operators
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{pd}  &
=\operatorname*{linspan}\left\{  \left\{  \left.  u\left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert u^{\dagger}\right\vert \right.  \left\{
g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}  =\left\{
i_{1},\cdots,i_{p}\right\}  \right\} \\
1  &  \leq g_{1}<\cdots<g_{p}\leq r,1\leq h_{1}<\cdots<h_{p}\leq r,0\leq p\leq
n.
\end{align}
is maintained.
\end{theorem}

