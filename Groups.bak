\begin{gather}
\mathfrak{H}_{\mathbb{R}}=\left\{  \left.  v+\sigma_{U}\left(  v\right)
\right\vert v\in\mathfrak{H}_{\mathbb{R}}\right\}  \oplus_{\mathbb{R}}\left\{
\left.  v-\sigma_{U}\left(  v\right)  \right\vert v\in\mathfrak{H}%
_{\mathbb{R}}\right\}  =\left\{  \left.  v+\sigma_{U}\left(  v\right)
\right\vert v\in\mathfrak{H}_{\mathbb{R}}\right\}  +_{\mathbb{R}}\left\{
\left.  v-\sigma_{U}\left(  v\right)  \right\vert v\in\mathfrak{H}%
_{\mathbb{R}}\right\} \\
=U\oplus_{\mathbb{R}}U^{\prime}.
\end{gather}

\end{enumerate}

\item The space $\mathfrak{H}_{\mathbb{R}}$ can be chosen in several ways in
general
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=U_{1}\oplus_{\mathbb{R}}U_{2},
\end{equation}
where
\begin{equation}
\dim\left\{  U_{1}\right\}  =\dim\left\{  U_{2}\right\}
\end{equation}
$U_{1}$ and $U_{2}$ do not have to be related in any manner. A possible choice
is
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=U\oplus_{\mathbb{R}}U^{\bot},
\end{equation}
where orthogonality $\bot$ is defined by the inner product in $U\oplus
_{\mathbb{R}}U^{\bot}$ induced from $U.$ The general decompositions induces
the complex spaces
\begin{equation}
\mathfrak{H}_{U_{1}}=\mathcal{C}_{U_{1}}\left(  \mathfrak{H}_{\mathbb{R}%
}\right)  =\mathcal{C}_{U_{1}}\left(  U_{1}\oplus_{\mathbb{R}}J_{U_{1}}%
U_{1}\right)
\end{equation}
and
\begin{equation}
\mathfrak{H}_{U_{2}}=\mathcal{C}_{U_{2}}\left(  \mathfrak{H}_{\mathbb{R}%
}\right)  =\mathcal{C}_{U}\left(  U_{2}\oplus_{\mathbb{R}}J_{U_{2}}%
U_{2}\right)  .
\end{equation}
The space $U_{1}$ could be equal to $U_{2},$ or be completlty disjoint to
$U_{1},$ or be the dual space $U_{1}^{d}$ of $U_{1}.$ If $U_{1}\cap
U_{2}=\left\{  0\right\}  $ then
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=U_{1}\oplus_{\mathbb{R}}U_{2}=U_{1}+_{\mathbb{R}%
}U_{2}.
\end{equation}

\end{enumerate}
\end{example}

\begin{lemma}
The eigenspaces of $\sigma_{U}$ are given by
\begin{align}
\sigma_{U_{1}}\left(  U_{1}\right)   &  =U_{1}\\
\sigma_{U_{1}}\left(  U_{2}\right)   &  =-U_{2},
\end{align}
i.e. $U_{1}$ is the space formed by the degenerate eigenvectors associated
with eigenvalue $1$ and $U_{2}$ is the space formed by the degenerate
eigenvectors associated with eigenvalue -$1,$ so that
\begin{equation}
\sigma_{U_{1}}=P_{U_{1}}-P_{U_{2}},
\end{equation}
where
\begin{equation}
P_{U_{1}}+P_{U_{2}}=I_{\mathfrak{H}_{\mathbb{R}}}.
\end{equation}

\end{lemma}

\begin{lemma}
The real Hilbert space $\mathfrak{H}_{\mathbb{R}}$
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=U_{1}\oplus_{\mathbb{R}}U_{2},
\end{equation}
has the following properties
\begin{equation}
\mathfrak{H}_{\mathbb{R}}\cong U_{1}\oplus_{\mathbb{R}}\sigma_{U_{1}}\left(
U_{1}\right)  \cong U_{2}\oplus_{\mathbb{R}}\sigma_{U_{2}}\left(
U_{2}\right)  ,
\end{equation}
and%
\begin{equation}
\mathfrak{H}_{\mathbb{R}}\overset{\mathbb{R}}{\cong}\mathfrak{H}_{U_{1}%
}=\mathcal{C}_{U_{1}}\left(  \mathfrak{H}_{\mathbb{R}}\right)
\overset{\mathbb{R}}{\cong}U_{1}\oplus_{\mathbb{R}}J_{U_{1}}\left(
U_{1}\right)  .
\end{equation}

\end{lemma}

\begin{definition}
$\mathcal{X}$ is a $c^{\ast}$-algebra generation map if
\begin{equation}
\mathcal{X}:\mathfrak{H}_{\mathbb{R}}\rightarrow\mathcal{A},
\end{equation}
where $\mathcal{X}$ is $\mathbb{R}$-linear, $\mathcal{A}$ is a $c^{\ast}%
$-algebra and $\mathfrak{H}_{\mathbb{R}}$ is a reference Hilbert space and
\begin{equation}
\mathcal{X}\left(  \sigma_{U_{1}}\left(  w\right)  \right)  =\mathcal{X}%
\left(  w\right)  ^{\dagger};w\in\mathfrak{H}_{\mathbb{R}}.
\end{equation}

\end{definition}

\begin{lemma}%
\begin{equation}
\text{If }w\in U_{1}\text{ then }\mathcal{X}\left(  \sigma_{U_{1}}\left(
w\right)  \right)  =\mathcal{X}\left(  w\right)  ^{\dagger}=\mathcal{X}\left(
w\right)  .
\end{equation}

\end{lemma}

\begin{definition}
$\mathcal{X}$ is a \emph{Clifford Algebra} generation map if%
\begin{equation}
\left[  \mathcal{X}\left(  w_{1}\right)  ,\mathcal{X}\left(  w_{2}\right)
\right]  _{+}=\left(  \left.  w_{1}\right\vert w_{2}\right)  _{\mathfrak{H}%
_{\mathbb{C}}}I_{\mathcal{A}}.
\end{equation}

\end{definition}

\begin{lemma}
The invariance group of the Clifford Algebra generation map $\mathcal{X}$ is
$O\left(  2r,\mathbb{C}\right)  \equiv O\left(  \mathfrak{H}_{\mathbb{C}%
},\mathbb{R}\right)  .$
\end{lemma}

\begin{definition}
$\mathcal{X}$ is a \emph{CAR} Algebra generation map if%
\begin{equation}
\left[  \mathcal{X}\left(  w_{1}\right)  ,\mathcal{X}\left(  w_{2}\right)
\right]  _{+}=\left(  \left.  w_{1}\right\vert w_{2}\right)  _{\mathfrak{H}%
_{\mathbb{R}}}I_{\mathcal{A}}.
\end{equation}

\end{definition}

\begin{lemma}
The invariance group of the CAR Algebra generation map $\mathcal{X}$ is
$O\left(  2r,\mathbb{R}\right)  \equiv O\left(  \mathfrak{H}_{\mathbb{R}%
},\mathbb{R}\right)  $
\end{lemma}

\begin{remark}%
\begin{equation}
\left[  \mathcal{X}\left(  w_{1}\right)  ,\mathcal{X}\left(  w_{2}\right)
\right]  _{+}=\left\langle \left.  \mathcal{C}_{U_{1}}\left(  v_{1}\right)
\right\vert \mathcal{C}_{U_{1}}\left(  v_{2}\right)  \right\rangle
_{\mathfrak{H}}I_{\mathcal{A}}.
\end{equation}

\end{remark}

\begin{definition}
One can define creation and annihilation operators by
\begin{align}
\Phi^{\dagger}\left(  \left\vert w\right\rangle \right)   &  =\Phi\left(
\left\vert w\right\rangle \right)  ^{\dagger}=\frac{1}{\sqrt{2}}\left(
\mathcal{X}\left(  \left\vert w\right\rangle \right)  -i\mathcal{X}\left(
J_{U_{1}}\left\vert w\right\rangle \right)  \right) \\
\Phi\left(  \left\vert w\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
\mathcal{X}\left(  \left\vert w\right\rangle \right)  +i\mathcal{X}\left(
J_{U_{1}}\left\vert w\right\rangle \right)  \right)  .
\end{align}

\end{definition}

\begin{lemma}
A CAR algebra is a real Clifford Algebra.
\end{lemma}

\begin{remark}
The CAR's are invariant to $O\left(  2r,\mathbb{R}\right)  $ and thus can be
expressed as real Clifford algebra. This is profound as all real (at least
finite dimensional) can be expressed as tensor product of \emph{EIGHT }basic
real Clifford algebras. Are Pauli type objects (e.g. electrons) related to
geometry is geometry related to Pauli type objects.
\end{remark}

\subsection{Group Representations}

The General Linear group $GL\left(  2r,\mathbb{C}\right)  $ acts on
$\mathcal{F}_{1}$ by
\begin{equation}
\Pi_{\mathcal{F}_{1}}\left(  g\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
A & B\\
C & D
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathcal{R}_{x}\left(  g\right)  ,
\end{equation}


where
\begin{equation}
\left(
\begin{array}
[c]{cc}%
A & B\\
C & D
\end{array}
\right)  \in GL\left(  2r,\mathbb{C}\right)  .
\end{equation}
In the special case $K\in U\left(  2r,\mathbb{C}\right)  $ one has
\begin{equation}
\Pi_{\mathcal{F}_{1}}\left(  K\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  \mathcal{R}_{y}\left(  K\right)
\end{equation}
that give conjugate representations of $GL\left(  2r,\mathbb{C}\right)  $ by
\begin{align}
\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ^{\dagger}=\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
A & B\\
C & D
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathcal{R}_{x}\left(  g\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
A & B\\
C & D
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ^{\dagger}\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathcal{R}_{\mathbf{a}}\left(  g\right)  .
\end{align}


\begin{remark}
$\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  $ and $\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  $ do not have to be self adjoint bases, but could be.
\end{remark}

\begin{remark}
The questions to be answered are:
\end{remark}

\begin{itemize}
\item When do $\left\{  \mathbf{b}^{\dagger},\mathbf{b}\right\}  $ satisfy CAR

\item What happens when $r=\infty$ are $\Pi_{\mathcal{F}_{1}}\left(  K\right)
$ and $\Pi_{\mathcal{F}_{1}}\left(  g\right)  $ bounded.

\item When are $\Pi_{\mathcal{F}_{1}}\left(  g\right)  $ inner automorphisms
of $\mathcal{F}.$

\item When are they $\ast$ automorphisms.

\begin{theorem}
$T_{1}\in\Pi_{\mathcal{F}_{1}}\left(  GL\left(  r,\mathbb{C}\right)  \right)
\subset$ $\mathcal{B}\left(  \mathcal{F}_{1}\right)  $ act as inner
automorphisms, but not in general $\ast$ inner automorphisms e.g.
\begin{gather}
a^{\dagger}\left(  T_{1}v_{1}\right)  =\exp\left\{
%TCIMACRO{\tsum _{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum_{1\leq j\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  t\right)  _{jk}a^{\dagger}\left(  e_{j}\right)
a\left(  e_{k}\right)  \right\}  a^{\dagger}\left(  v_{1}\right)  \exp\left\{
-%
%TCIMACRO{\tsum _{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum_{1\leq j\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  t\right)  _{jk}a^{\dagger}\left(  e_{j}\right)
a\left(  e_{k}\right)  \right\}  =%
%TCIMACRO{\tsum _{1\leq j,k\leq r}}%
%BeginExpansion
{\textstyle\sum_{1\leq j,k\leq r}}
%EndExpansion
a^{\dagger}\left(  e_{j}\right)  \mathcal{R}_{e}\left(  T\right)
_{jk}\mathcal{R}_{e}\left(  v\right)  _{k}\\
T_{1}:\mathfrak{a}^{\dagger}\rightarrow\mathfrak{a}^{\dagger}\cong%
\mathcal{H}^{1}\rightarrow\mathcal{H}^{1}.
\end{gather}


\begin{remark}
$\dim\left\{  \mathcal{F}_{1}\right\}  =2r$ and the preceding group \emph{is}
$GL\left(  r,\mathbb{C}\right)  \subset GL\left(  2r,\mathbb{C}\right)  $ and
not $GL\left(  2r,\mathbb{C}\right)  .$
\end{remark}
\end{theorem}

\item The map\texttt{ }
\begin{equation}
T:\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}%
\end{equation}
can be analyzed in terms of direct sum decompositions
\begin{align}
T  &  :\mathfrak{x}_{1}\oplus\mathfrak{x}_{2}\rightarrow\mathfrak{s}_{1}%
\oplus\mathfrak{s}_{2}\\
T  &  :\mathfrak{x}_{1}\rightarrow T_{11}\mathfrak{x}_{1}+T_{12}%
\mathfrak{x}_{2}=T_{1}\mathfrak{x}_{1}=\mathfrak{s}_{1}\\
T  &  :\mathfrak{x}_{2}\rightarrow T_{21}\mathfrak{x}_{1}+T_{22}%
\mathfrak{x}_{2}=T_{2}\mathfrak{x}_{2}=\mathfrak{s}_{2}%
\end{align}
i.e.
\begin{align}
T\mathfrak{x}_{1}  &  =T_{1}\mathfrak{x}_{1}=\mathfrak{s}_{1}\\
T\mathfrak{x}_{2}  &  =T_{2}\mathfrak{x}_{2}=\mathfrak{s}_{2},
\end{align}
where $T$ can expressed as
\begin{equation}
T=\left(
\begin{array}
[c]{cc}%
T_{11} & T_{12}\\
T_{21} & T_{22}%
\end{array}
\right)  .
\end{equation}


Although we will in primarily focus on the case where $\left\{  \mathfrak{x}%
_{1},\mathfrak{x}_{2}\right\}  $ are self adjoint, other cases such as
$\mathfrak{x}_{2}=\mathfrak{x}_{1}^{\dagger}$ or mixed types of bases

could be considered. Both real and complex linear combinations of bases can be
considered leading to real or complex vector spaces.

\item A special case of the direct sum decomposition is when
\begin{equation}
\mathfrak{x}_{2}\cong\mathfrak{x}_{1}^{d},
\end{equation}
i.e.%
\begin{equation}
\mathcal{F}_{1}=\mathfrak{x}_{1}\oplus\mathfrak{x}_{1}^{d}%
\end{equation}
then
\begin{align}
\mathcal{B}\left(  \mathfrak{x}_{1}\right)   &  \equiv\mathcal{B}\left(
\mathfrak{x}_{1},\mathfrak{x}_{1}\right)  \cong\mathfrak{x}_{1}\otimes
\mathfrak{x}_{1}^{d}\\
\mathcal{B}_{a}\left(  \mathfrak{x}_{1}\right)   &  \subset\mathcal{B}\left(
\mathfrak{x}_{1}\right)  \cong\wedge^{2}\left(  \mathfrak{x}_{1}\right)  .
\end{align}

\end{itemize}

The dual space $\mathfrak{x}_{1}^{d}$ is the linear space of linear
functionals
\begin{equation}
f:\mathfrak{x}_{1}\rightarrow\mathbb{C}\text{ or }\mathbb{R}%
\end{equation}
depending on whether $\mathfrak{x}_{1}$ is a complex or real linear space.
Linear functionals can be formed from inner products in $\mathcal{F}_{1}$ e.g.
the complex symmetric inner product, \emph{which is not positive definite}
\begin{align}
\left(  \left.  \cdot\right\vert \cdot\right)   &  :\mathcal{F}_{1}%
\times\mathcal{F}_{1}\rightarrow\mathbb{C}\\
\left(  \left.  a\right\vert b\right)   &  =\left\langle ab\right\rangle
_{0}=\left\langle ba\right\rangle _{0}=\left(  \left.  b\right\vert a\right)
\end{align}
and the hermitian inner product, \emph{which is positive definite}
\begin{align}
\left\langle \left.  \cdot\right\vert \cdot\right\rangle  &  :\mathcal{F}%
_{1}\times\mathcal{F}_{1}\rightarrow\mathbb{C}\\
\left\langle \left.  a\right\vert b\right\rangle  &  =\left\langle a^{\dagger
}b\right\rangle _{0}=\overline{\left\langle b^{\dagger}a\right\rangle _{0}%
}=\overline{\left\langle \left.  b\right\vert a\right\rangle }.
\end{align}
However if $\mathfrak{x}_{1}$is generated by the self adjoint basis $\left\{
\left.  x_{j}\right\vert 1\leq j\leq r\right\}  $ then $\mathfrak{x}_{2}$
\emph{is not the dual space} of $\mathfrak{x}_{1}$ through the inner product
$\left(  \left.  \cdot\right\vert \cdot\right)  ,$ \emph{but it is} in the
totally non self adjoint case $\left\{  \mathfrak{a}^{\dagger},\mathfrak{a}%
\right\}  ,$ i.e.
\begin{align}
\left(  \left.  \frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right)  \right\vert
\frac{1}{\sqrt{2}}\left(  x_{k}-ix_{k+r}\right)  \right)   &  =\frac{1}%
{2}\left\{  \left(  \left.  x_{j}\right\vert x_{k}\right)  -\left(  \left.
x_{j}\right\vert ix_{k+r}\right)  +\left(  \left.  ix_{j+r}\right\vert
x_{k}\right)  -\left(  \left.  ix_{j+r}\right\vert ix_{k+r}\right)  \right\}
\\
&  =\left(  \left.  \frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right)
\right\vert \frac{1}{\sqrt{2}}\left(  x_{k}+ix_{k+r}\right)  \right)
=\delta_{jk}\\
\left(  \left.  \frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right)  \right\vert
\frac{1}{\sqrt{2}}\left(  x_{k}+ix_{k+r}\right)  \right)   &  =\frac{1}%
{2}\left\{  \left(  \left.  x_{j}\right\vert x_{k}\right)  +\left(  \left.
x_{j}\right\vert ix_{k+r}\right)  +\left(  \left.  ix_{j+r}\right\vert
x_{k}\right)  +\left(  \left.  ix_{j+r}\right\vert ix_{k+r}\right)  \right\}
=0\\
\left(  \left.  \frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right)  \right\vert
\frac{1}{\sqrt{2}}\left(  x_{k}-ix_{k+r}\right)  \right)   &  =\frac{1}%
{2}\left\{  \left(  \left.  x_{j}\right\vert x_{k}\right)  -\left(  \left.
x_{j}\right\vert ix_{k+r}\right)  -\left(  \left.  ix_{j+r}\right\vert
x_{k}\right)  +\left(  \left.  ix_{j+r}\right\vert ix_{k+r}\right)  \right\}
=0,
\end{align}
which can be equivently expressed as
\begin{align}
\left(  \left.  a_{j}^{\dagger}\right\vert a_{k}\right)   &  =\left(  \left.
a_{k}\right\vert a_{j}^{\dagger}\right)  =\delta_{jk};1\leq j,k\leq r\\
\left(  \left.  a_{j}^{\dagger}\right\vert a_{k}^{\dagger}\right)   &
=\left(  \left.  a_{k}^{\dagger}\right\vert a_{j}^{\dagger}\right)  =\left(
\left.  a_{k}\right\vert a_{j}\right)  =\left(  \left.  a_{j}\right\vert
a_{k}\right)  =0;1\leq j,k\leq r.
\end{align}


\begin{remark}
This shows that the subspaces $\mathfrak{a}^{\dagger}$and $\mathfrak{a}$ are
\emph{isotropic} wrt $\left(  \left.  \cdot\right\vert \cdot\right)  $ and
\emph{dual} spaces wrt $\left(  \left.  \cdot\right\vert \cdot\right)  $ in
\emph{contrast} to the subspaces $\mathfrak{x}_{1}\mathfrak{\ }$and
$\mathfrak{x}_{2}.$
\end{remark}

The complex inner product $\left(  \left.  \cdot\right\vert \cdot\right)  $
\emph{is isotropic} i.e. non definite on the complex space as
\begin{equation}
\left(  \left.  v\right\vert v\right)  =0
\end{equation}
for some $v\in\mathcal{F}_{1},$ and it is not even real valued$.$ If we
consider the real space generated by a self adjoint bases then $\left(
\left.  \cdot\right\vert \cdot\right)  $ is positive definite. Using isotropic
subspaces one obtains
\begin{align}
\mathcal{B}\left(  \mathfrak{a}^{\dagger}\right)   &  \equiv\mathcal{B}\left(
\mathfrak{a}^{\dagger},\mathfrak{a}^{\dagger}\right)  \cong\mathfrak{a}%
^{\dagger}\otimes\mathfrak{a}\\
\wedge^{2}\left(  \mathfrak{a}^{\dagger}\right)   &  \cong\mathcal{B}%
_{a}\left(  \mathfrak{a}^{\dagger}\right)  \subset\mathcal{B}\left(
\mathfrak{a}^{\dagger}\right)
\end{align}
and
\begin{equation}
\mathcal{F}=\wedge\left(  \mathfrak{a}^{\dagger}\oplus\mathfrak{a}\right)
=\wedge\left(  \mathfrak{a}^{\dagger}\right)  \otimes\wedge\left(
\mathfrak{a}\right)  \cong\mathcal{B}\left(  \wedge\left(  \mathfrak{a}%
^{\dagger}\right)  \right)  .
\end{equation}
The last relationship includes the identity
\begin{equation}
\mathcal{F}=\mathcal{B}\left(  \wedge\left(  \mathfrak{a}^{\dagger}\right)
\right)  ,
\end{equation}
which is the generalization of the original Fock algebra construction
\begin{equation}
\mathcal{F}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}
when
\begin{equation}
\mathcal{H}_{\mathcal{F}}=\wedge\left(  \mathcal{H}^{1}\right)  .
\end{equation}


One can always find non self adjoint sets of generators that are non isotropic
wrt $\left(  \left.  \cdot\right\vert \cdot\right)  $ generated by self
adjoint ones that are isotropic thus one can always perform the standard Fock
algebra construction. \emph{However note that} the \emph{criteria} for a
$\emph{Fock}$ $\emph{representation}$ is the \emph{existance of a vacuum
vector in the vector space representation that the operator representation
acts on. Thus }Fock algebras \emph{do not always produce Fock representations.
}

\begin{remark}
\emph{Notice the difference} between a \emph{Fock Algebra} and a \emph{Fock
Representation!}!
\end{remark}

\begin{theorem}
$\boxtimes T,\,T\in\mathcal{B}\left(  \mathcal{F}_{1}\right)  $ is a
\emph{Grassmann/Exterior algebra} mapping
\begin{equation}
\left(  \left(  \boxtimes T\right)  \left(  x_{j}\right)  \right)
\wedge\left(  \left(  \boxtimes T\right)  \left(  x_{k}\right)  \right)
=\left(  T\boxtimes T\right)  \left(  x_{j}\wedge x_{k}\right)  =\left(
\boxtimes T\right)  \left(  x_{j}\wedge x_{k}\right)
\end{equation}
as
\begin{equation}
\left(  \boxtimes T\right)  \left(  x_{j}\wedge x_{k}\right)  =\left(
\boxtimes^{2}T\right)  \left(  x_{j}\wedge x_{k}\right)  =\left(
Tx_{j}\right)  \wedge\left(  Tx_{k}\right)  =\left(  \left(  \boxtimes
T\right)  \left(  x_{j}\right)  \right)  \wedge\left(  \left(  \boxtimes
T\right)  \left(  x_{k}\right)  \right)  ,
\end{equation}
\emph{but not a Clifford algebra} mapping as in general
\begin{equation}
\left(  \left.  x_{j}\right\vert x_{k}\right)  =0\nRightarrow\left(  \left.
Tx_{j}\right\vert Tx_{k}\right)  =0,
\end{equation}
so in general
\begin{equation}
\left(  \boxtimes T\right)  \left(  x_{j}x_{k}\right)  \neq\left(  \left(
\boxtimes T\right)  \left(  x_{j}\right)  \right)  \circ\left(  \left(
\boxtimes T\right)  \left(  x_{k}\right)  \right)  .
\end{equation}

\end{theorem}

\begin{itemize}
\item $\mathcal{F}$ can be expressed in various forms as a vector space as
\begin{equation}
\mathcal{F}=\wedge\left(  \mathcal{F}_{1}\right)  =\mathcal{B}\left(
\wedge\left(  \mathfrak{x}_{1}\right)  \right)  =\wedge\left(  \mathfrak{x}%
_{1}\mathfrak{\oplus x}_{2}\right)  =\wedge\left(  \mathfrak{x}_{1}\right)
\otimes\wedge\left(  \mathfrak{x}_{2}\right)  ,
\end{equation}
which can be endowered with the exterior product $"\wedge"$ or with the
Geometric/Clifford/Operator product $"\circ"$.

\begin{enumerate}
\item Mappings of $\mathcal{F}$ can be expressed in various forms as%
\begin{align}
\left(  \boxtimes T\right)  \left(  \mathcal{F}\right)   &  =\left(  \boxtimes
T\right)  \left(  \wedge\left(  \mathcal{F}_{1}\right)  \right)
=\wedge\left(  T\left(  \mathcal{F}_{1}\right)  \right)  =\wedge\left(  \wedge
T\left(  \mathfrak{x}_{1}\mathfrak{\oplus x}_{2}\right)  \right)
=\wedge\left(  T_{1}\mathfrak{x}_{1}\mathfrak{\oplus}T_{2}\mathfrak{x}%
_{2}\right) \\
&  =\left(  \boxtimes T_{1}\left(  \mathfrak{x}_{1}\right)  \right)
\mathfrak{\otimes}\left(  \boxtimes T_{2}\left(  \mathfrak{x}_{2}\right)
\right)  =\left(  \boxtimes T_{1}\right)  \mathfrak{\otimes}\left(  \boxtimes
T_{2}\right)  \left(  \left(  \wedge\mathfrak{x}_{1}\right)  \mathfrak{\otimes
}\left(  \mathfrak{\wedge x}_{2}\right)  \right) \\
&  =\wedge\left(  \mathfrak{s}_{1}\mathfrak{\oplus s}_{2}\right)
=\wedge\mathfrak{s}_{1}\mathfrak{\otimes\wedge s}_{2},
\end{align}


\item
\begin{align}
\left(  \boxtimes T\right)  \left(  \mathcal{F}\right)   &  =\left(  \boxtimes
T\right)  \left(  \mathcal{B}\left(  \wedge\left(  \mathfrak{x}_{1}\right)
\right)  \right)  =\left(  \boxtimes T\right)  \left(  \wedge\left(
\mathfrak{x}_{1}\right)  \otimes\wedge\left(  \mathfrak{x}_{2}\right)  \right)
\\
&  =\left(  \left(  \boxtimes T_{1}\right)  \left(  \wedge\left(
\mathfrak{x}_{1}\right)  \right)  \right)  \otimes\left(  \left(  \boxtimes
T_{2}\right)  \left(  \wedge\left(  \mathfrak{x}_{1}\right)  \right)  \right)
=\left(  \boxtimes T_{1}\right)  \left(  \wedge\left(  \left(  \mathfrak{x}%
_{1}\right)  \otimes\wedge\left(  \mathfrak{x}_{1}\right)  \right)  \right)
\left(  \boxtimes T_{2}\right)  ^{t},
\end{align}


\item
\begin{gather}
\mathcal{F}=\wedge\left(  T\left(  \mathcal{F}_{1}\right)  \right)
=\boxtimes\left(  T\right)  \left(  \wedge\left(  \mathcal{H}^{1}\right)
\right)  =\boxtimes\left(  T\right)  \left(  \wedge\left(  \mathfrak{f}_{\rho
}^{\dagger}\right)  \right)  =\wedge\left(  \wedge T\left(  \mathfrak{f}%
_{\rho}\mathfrak{\oplus f}_{\rho}^{\dagger}\right)  \right) \\
=\boxtimes T\left(  \wedge\left(  \mathfrak{f}_{\rho}^{\dagger}\right)
\otimes\wedge\left(  \mathfrak{f}_{\rho}\right)  \right)  =\wedge\left(
T\mathfrak{f}_{\rho}^{\dagger}\right)  \otimes\wedge\left(  T\mathfrak{f}%
_{\rho}\right)  \equiv\wedge\left(  T_{1}\mathfrak{f}_{\rho}^{\dagger}\right)
\otimes\wedge\left(  T_{2}\mathfrak{f}_{\rho}\right) \\
=\boxtimes\left(  T_{1}\right)  \left(  \wedge\left(  \mathfrak{f}_{\rho
}^{\dagger}\right)  \otimes\wedge\left(  \mathfrak{f}_{\rho}\right)  \right)
\left(  \boxtimes\left(  T_{2}\right)  \right)  ^{t}=\left(  \boxtimes\left(
T_{1}\right)  \otimes\boxtimes\left(  T_{2}\right)  \right)  \left(
\wedge\left(  \mathfrak{f}_{\rho}^{\dagger}\right)  \otimes\wedge\left(
\mathfrak{f}_{\rho}\right)  \right)  ,\\
T\in\mathcal{B}\left(  \mathfrak{f}_{\rho}\mathfrak{\oplus f}_{\rho}^{\dagger
}\right)  ,\boxtimes\left(  T\right)  \in\mathcal{B}\left(  \mathcal{F}%
\right)  ,\wedge\left(  \mathfrak{f}_{\rho}^{\dagger}\right)  \otimes
\wedge\left(  \mathfrak{f}_{\rho}\right)  \equiv\mathcal{B}\left(
\mathcal{F}\right)  =\mathcal{B}\left(  \wedge\left(  \mathcal{F}_{1}\right)
\right)  =\mathcal{B}\left(  \mathcal{B}\left(  \wedge\left(  \mathfrak{f}%
_{\rho}^{\dagger}\right)  \right)  \right) \\
T\equiv\left(  T_{11},T_{12},T_{21},T_{22}\right)  \equiv\left(  T_{1}%
,T_{2}\right)  ,T_{jk}\in\mathcal{B}\left(  \mathfrak{f}_{\rho j}%
\mathfrak{,f}_{\rho k}\right)  .
\end{gather}

\end{enumerate}

\item One should analyze
\begin{equation}
\left(
\begin{array}
[c]{cc}%
T_{11} & T_{12}\\
T_{21} & T_{22}%
\end{array}
\right)
\end{equation}
in terms of \emph{complete} positivity and positivity.
\end{itemize}

\subsubsection{Dual Banach Spaces}

$\mathcal{F}_{1}$ and $\mathcal{F}_{2}$ are complex Banach spaces that have
Banach space duals $\mathcal{F}_{1}^{d}$ and $\mathcal{F}_{2}^{d}.$

\begin{itemize}
\item
\begin{itemize}
\item The duality is expressed as
\begin{equation}
\left\langle w^{d},v\right\rangle \in\mathbb{C},
\end{equation}
where $\left\langle ,\right\rangle $ is a $\mathbb{C}$-bilinear on
\begin{equation}
\mathcal{F}_{1}^{d}\times\mathcal{F}_{1}\text{ and }\mathcal{F}_{2}^{d}%
\times\mathcal{F}_{2}.
\end{equation}


\item Elements of $\mathcal{F}_{1}^{d}$ and $\mathcal{F}_{1}$ are denoted by
$\left\langle w^{d}\right\vert $ and $\left\vert v\right\rangle $ respectively
or just $w^{d}$ and $v$.

\item $\mathcal{F}_{1}^{d}$ is a complex Banach spaces that has a Banach space
dual $\mathcal{F}_{1}^{dd}$, therefore $\mathcal{F}_{1}^{d}$ is a predual as
is $\mathcal{F}_{1}.$

\item This \emph{double duality} is expressed as
\begin{equation}
\left\langle y^{dd},w^{d}\right\rangle \in\mathbb{C},
\end{equation}
where $\left\langle ,\right\rangle $ is a $\mathbb{C}$-bilinear on
\begin{equation}
\mathcal{F}_{1}^{dd}\times\mathcal{F}_{1}^{d}\text{ }.
\end{equation}


\item If $y^{dd}\in$ $\mathcal{F}_{1}^{dd}$ is the image of $v\in
\mathcal{F}_{1}$ then
\begin{equation}
\left\langle y^{dd},w^{d}\right\rangle =\left\langle w^{d},v\right\rangle .
\end{equation}


\item Elements of $\mathcal{F}_{1}^{dd}$ and $\mathcal{F}_{1}^{d}$ are denoted
by $\left\langle y^{dd}\right\vert $ and $\left\vert w^{d}\right\rangle $
respectively or just $y^{dd}$ and $v^{d}$.
\end{itemize}

\begin{definition}
The bases $\left\{  \left.  v_{j}^{d}\right\vert 1\leq j\leq2r\right\}
,\left\{  \left.  v_{j}\right\vert 1\leq j\leq2r\right\}  $ are
\emph{Biorthogonal} for the dual spaces $\left\langle \mathcal{F}_{1}%
^{d},\mathcal{F}_{1}\right\rangle $ if
\begin{equation}
\left\langle v_{j}^{d},v_{k}\right\rangle =\delta_{jk};\quad1\leq j,k\leq2r.
\end{equation}

\end{definition}

\begin{definition}
The bases $\left\{  \left.  v_{j}^{dd}\right\vert 1\leq j\leq2r\right\}
,\left\{  \left.  v_{j}^{d}\right\vert 1\leq j\leq2r\right\}  $ are
\emph{Biorthogonal} for the dual spaces $\left\langle \mathcal{F}_{1}%
^{dd},\mathcal{F}_{1}^{d}\right\rangle $ if
\begin{equation}
\left\langle v_{j}^{dd},v_{k}^{d}\right\rangle =\delta_{jk};\quad1\leq
j,k\leq2r.
\end{equation}

\end{definition}

\begin{definition}
The metric matrix of bases $\left\{  \left.  w_{j}^{d}\right\vert 1\leq
j\leq2r\right\}  $ of $\mathcal{F}_{1}^{d}$ and $\left\{  \left.  v_{j}%
^{d}\right\vert 1\leq j\leq2r\right\}  $ of $\mathcal{F}_{1}$ is
$\mathbb{S}_{w^{d}v}\in\mathcal{M}\left(  2r,\mathbb{C}\right)  ,$ where
\begin{equation}
\left(  \mathbb{S}_{w^{d}v}\right)  _{jk}=\left\langle \left\langle w_{j}%
^{d}\right\vert ,\left\vert v_{k}\right\rangle \right\rangle \equiv
\left\langle w_{j}^{d},v_{k}\right\rangle ;\quad1\leq j,k\leq2r.
\end{equation}

\end{definition}

\begin{definition}
The dual embedding maps $D_{d}$ and $D$ based on the bases $\left\{  \left.
v_{j}^{dd}\right\vert 1\leq j\leq2r\right\}  ,\left\{  \left.  v_{j}%
^{d}\right\vert 1\leq j\leq2r\right\}  $ and $\left\{  \left.  v_{j}%
\right\vert 1\leq j\leq2r\right\}  \ $are
\begin{align}
D  &  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}^{d}\\
v_{k}^{d}  &  =D\left(  v_{k}\right)  ;\quad1\leq j\leq2r
\end{align}
and%
\begin{align}
D_{d}  &  :\mathcal{F}_{1}^{d}\rightarrow\mathcal{F}_{1}^{dd}\\
v_{k}^{dd}  &  =D_{d}\left(  v_{k}^{d}\right)  \quad1\leq j\leq2r.
\end{align}


\begin{notation}
In general the action of the maps $D$ and $D_{d}$ are
\begin{align}
p^{d}  &  =D\left(  p\right)  ;\quad p\in\mathcal{F}_{1},\quad p^{d}%
\in\mathcal{F}_{1}^{d}.\\
p^{dd}  &  =D_{d}\left(  p^{d}\right)  ;\quad p^{d}\in\mathcal{F}_{1}%
^{d},\quad p^{dd}\in\mathcal{F}_{1}^{dd}.
\end{align}

\end{notation}
\end{definition}

\begin{definition}
The \emph{transpose} $T^{d}\in\mathcal{B}\left(  \mathcal{F}_{1}^{d}\right)  $
of the map $T\in\mathcal{B}\left(  \mathcal{F}_{1}\right)  $ is defined by
\begin{equation}
\left\langle T^{d}\left(  w^{d}\right)  ,v\right\rangle =\left\langle
w^{d},T\left(  v\right)  \right\rangle \quad\forall v\in\mathcal{F}_{1}.
\end{equation}

\end{definition}

\begin{definition}
This extends the dual map $D$ from $\mathcal{B}\left(  \mathcal{F}%
_{1},\mathcal{F}_{1}^{d}\right)  $ to $\mathcal{B}\left(  \mathcal{B}\left(
\mathcal{F}_{1}\right)  ,\mathcal{B}\left(  \mathcal{F}_{1}^{d}\right)
\right)  $ by
\begin{equation}
D\left(  T\right)  =T^{d}.
\end{equation}

\end{definition}

\begin{remark}
The representations $\mathcal{R}_{v}$ and $\mathcal{R}_{v^{d}}$ of $x$ are
given by
\begin{equation}
\mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)  =\sum_{1\leq
k\leq2r}\left\vert v_{k}\right\rangle \mathcal{R}_{v}\left(  \left\vert
x\right\rangle \right)  _{k}%
\end{equation}
and%
\begin{equation}
\mathcal{R}_{v}\left(  \left\langle x\right\vert \right)  =D\left(  \left\vert
x\right\rangle \right)  =D\left(  \sum_{1\leq k\leq2r}\left\vert
v_{k}\right\rangle \mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)
_{k}\right)  =\left(  \sum_{1\leq k\leq2r}D\left(  \left\vert v_{k}%
\right\rangle \right)  \mathcal{R}_{v}\left(  \left\vert x\right\rangle
\right)  _{k}\right)  =\sum_{1\leq k\leq2r}\left\langle v_{k}^{d}\right\vert
\mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)  _{k}=\sum_{1\leq
k\leq2r}\left\langle v_{k}^{d}\right\vert \mathcal{R}_{v^{d}}\left(
\left\langle x\right\vert \right)  _{k},
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)  _{k}=\mathcal{R}%
_{v^{d}}\left(  \left\langle x\right\vert \right)  _{k}.
\end{equation}

\end{remark}

\begin{remark}
The dual of \emph{column (contravariant) vectors} are \emph{row (covariant)
vectors}%
\begin{gather}
\left\langle x^{d},y\right\rangle =\left\langle D\left(  x\right)
,y\right\rangle =\left\langle \sum_{1\leq k\leq2r}D\left(  \left\vert
v_{k}\right\rangle \mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)
_{k}\right)  ,\sum_{1\leq l\leq2r}\left\vert v_{l}\right\rangle \mathcal{R}%
_{v}\left(  \left\vert y\right\rangle \right)  _{l}\right\rangle =\left\langle
\sum_{1\leq k\leq2r}\left\langle v_{k}^{d}\right\vert \mathcal{R}_{v}\left(
\left\langle x\right\vert \right)  _{k},\sum_{1\leq l\leq2r}\left\vert
v_{l}\right\rangle \mathcal{R}_{v}\left(  \left\vert y\right\rangle \right)
_{l}\right\rangle \\
=\sum_{1\leq k\leq2r}\sum_{1\leq l\leq2r}\mathcal{R}_{v}\left(  \left\langle
x^{d}\right\vert \right)  _{k}\left\langle \left\langle v_{k}^{d}\right\vert
,\left\vert v_{l}\right\rangle \right\rangle \mathcal{R}_{v}\left(  \left\vert
y\right\rangle \right)  _{l}=\sum_{1\leq k\leq2r}\sum_{1\leq l\leq
2r}\mathcal{R}_{v^{d}}\left(  \left\langle x^{d}\right\vert \right)
_{k}\left(  \mathbb{S}_{v^{d}v}\right)  _{kl}\mathcal{R}_{v}\left(  \left\vert
y\right\rangle \right)  _{l}\\
=\mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)  ^{t}\mathbb{S}%
_{v^{d}v}\mathcal{R}_{v}\left(  \left\vert y\right\rangle \right)  ,
\end{gather}
i.e.
\begin{equation}
\mathcal{R}_{v^{d}}\left(  \left\langle x^{d}\right\vert \right)
=\mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)  ^{t}.
\end{equation}

\end{remark}

\begin{remark}
Transformation between basis is given by
\begin{equation}
T_{wv}\left\vert \mathbf{v}\right\rangle =\left\vert \mathbf{v}\right\rangle
\mathcal{R}_{v}\left(  T_{wv}\right)  =\left\vert \mathbf{w}\right\rangle
\end{equation}
i.e.%
\begin{equation}
T_{wv}\left\vert v_{j}\right\rangle =\left\vert w_{j}\right\rangle
=\sum_{1\leq k\leq2r}\left\vert v_{k}\right\rangle \mathcal{R}_{v}\left(
T_{wv}\right)  _{kj}.
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\mathcal{R}_{v^{d}}\left(  \left\langle x^{d}\right\vert \right)
=\mathcal{R}_{v^{d}}\left(  D\left(  \left\vert x\right\rangle \right)
\right)  =\mathcal{R}_{v}\left(  \left\vert x\right\rangle \right)  ^{t}.
\end{equation}

\end{lemma}

\begin{definition}
The Dual transformation $D\in\mathcal{B}\left(  \mathcal{B}\left(
\mathcal{F}_{1}\right)  ,\mathcal{B}\left(  \mathcal{F}_{1}^{d}\right)
\right)  $ can also be defined by
\begin{equation}
D\left(  Tv\right)  =T^{d}D\left(  v\right)  .
\end{equation}

\end{definition}

\begin{lemma}
The representation of the transformation between bases of the dual space
\begin{equation}
T_{wv}^{d}\left\langle \mathbf{v}^{d}\right\vert =\left\langle \mathbf{v}%
^{d}\right\vert \mathcal{R}_{v^{d}}\left(  T_{wv}\right)  =\left\langle
\mathbf{w}^{d}\right\vert
\end{equation}
is the transpose of the representation of the transformation between basis of
the primary space i.e.%
\begin{equation}
\mathcal{R}_{v^{d}}\left(  T_{wv}^{d}\right)  =\left(  \mathcal{R}_{v}\left(
T_{wv}\right)  \right)  ^{t}.
\end{equation}

\end{lemma}

\begin{remark}
This applies to the complex case as well. \qquad\qquad\qquad\qquad\qquad
\end{remark}

\begin{proof}
By definition $\left\langle D\left(  T_{vw}w\right)  ,v\right\rangle
=\left\langle T_{vw}^{d}D\left(  w\right)  ,v\right\rangle =$ $\left\langle
D\left(  w\right)  ,T_{vw}v\right\rangle $ then
\begin{equation}
\mathcal{R}_{v^{d}}\left(  \left\langle \left(  T_{vw}v\right)  ^{d}%
\right\vert \right)  =\mathcal{R}_{v^{d}}\left(  D\left(  \left\vert
T_{vw}\left(  v\right)  \right\rangle \right)  \right)  =\mathcal{R}%
_{v}\left(  \left\vert T_{vw}\left(  v\right)  \right\rangle \right)
^{t}=\mathcal{R}_{v}\left(  \left\vert \left(  v\right)  \right\rangle
\right)  ^{t}\mathcal{R}_{v}\left(  T_{vw}\right)  ^{t}.
\end{equation}


Let $\left\{  \left.  v_{j}^{d}\right\vert 1\leq j\leq2r\right\}  ,$ $\left\{
\left.  v_{j}\right\vert 1\leq j\leq2r\right\}  $ and $\left\{  \left.
w_{j}^{d}\right\vert 1\leq j\leq2r\right\}  ,$ $\left\{  \left.
w_{j}\right\vert 1\leq j\leq2r\right\}  $ be biorthogonal bases in
$\left\langle \mathcal{F}_{1}^{d},\mathcal{F}_{1}\right\rangle $ then one
obtains the resolution of the identity
\begin{equation}
I_{\mathcal{F}_{1}}=\sum_{1\leq j\leq2r}\left\vert v_{j}\right\rangle
\left\langle v_{j}^{d}\right\vert =\sum_{1\leq j\leq2r}\left\vert
w_{j}\right\rangle \left\langle w_{j}^{d}\right\vert ,
\end{equation}
showing that any $x\in\mathcal{F}_{1}$ can be expanded as
\begin{equation}
\left\vert x\right\rangle =\sum_{1\leq j\leq2r}\left\vert v_{j}\right\rangle
\left\langle v_{j}^{d}\right\vert \left\vert x\right\rangle =\sum_{1\leq
j\leq2r}\left\vert v_{j}\right\rangle x_{vj}=\sum_{1\leq j\leq2r}\left\vert
w_{j}\right\rangle \left\langle w_{j}^{d}\right\vert \left\vert x\right\rangle
=\sum_{1\leq j\leq2r}\left\vert w_{j}\right\rangle x_{wj}%
\end{equation}
giving
\begin{equation}
\left\langle x^{d}\right\vert =D\left(  \left\vert x\right\rangle \right)
=D\left(  \sum_{1\leq j\leq2r}\left\vert v_{j}\right\rangle x_{vj}\right)
=D\left(  \sum_{1\leq j\leq2r}\left\vert w_{j}\right\rangle x_{wj}\right)
=\sum_{1\leq j\leq2r}D\left(  \left\vert v_{j}\right\rangle \right)
x_{vj}=\sum_{1\leq j\leq2r}D\left(  \left\vert w_{j}\right\rangle \right)
x_{wj}%
\end{equation}
thus the definition of the dual vector $\left\langle x^{d}\right\vert $ does
not depend on the biorthogonal bases used.
\end{proof}
\end{itemize}

\begin{remark}%
\begin{equation}
T^{t}=\left(  \sum_{1\leq j\leq2r}\left\vert v_{j}\right\rangle \left\langle
v_{j}^{d}\right\vert T\sum_{1\leq k\leq2r}\left\vert v_{k}\right\rangle
\left\langle v_{k}^{d}\right\vert \right)  ^{t}=\left(  \sum_{1\leq j,k\leq
2r}\left\vert v_{j}\right\rangle T_{jk}\left\langle v_{k}^{d}\right\vert
\right)  ^{t}=\sum_{1\leq j,k\leq2r}\left\vert v_{k}\right\rangle
T_{jk}\left\langle v_{j}^{d}\right\vert =T^{d}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\langle w^{d},v\right\rangle =w^{d}\left(  v\right)  =\left\langle
D\left(  w\right)  ,v\right\rangle =\left\langle v^{dd},w^{d}\right\rangle
=\left\langle D_{d}\left(  D\left(  v\right)  \right)  ,w^{d}\right\rangle
=\left\langle D_{d}\left(  D\left(  v\right)  \right)  ,w^{d}\right\rangle
=v^{dd}\left(  w^{d}\right)  ,
\end{equation}
which can also be expressed as
\begin{equation}
w\left(  v\right)  =v\left(  w\right)  .
\end{equation}

\end{remark}

\begin{itemize}
\item
\begin{itemize}
\item The double dual contains the original space i.e.
\begin{equation}
\mathcal{F}_{1}^{dd}\supseteq\mathcal{F}_{1}\text{ i.e. }y^{dd}\left(
w^{d}\right)  =v^{d}\left(  y\right)  .
\end{equation}


\item Kets and Bras belonging to various dual spaces are denoted by
\begin{equation}
\left\vert v\right\rangle \in\mathcal{F}_{1};\quad\,\left\langle
w^{d}\right\vert \,\in\mathcal{F}_{1}^{d};\quad\left\langle w^{d}\right\vert
\,\in\mathcal{F}_{1}^{dd};\quad\left\vert z^{ddd}\right\rangle \in
\mathcal{F}_{1}^{ddd}\,\neq\mathcal{F}_{1}^{d}.
\end{equation}


\item
\begin{equation}
w^{d}\left(  y\right)  =\left\langle w^{d},y\right\rangle =\left\langle
w^{d},v\right\rangle =v^{dd}\left(  w^{d}\right)
\end{equation}

\end{itemize}

\item The bounded nondegenerate bilinear form $\left\langle ,\right\rangle $
\begin{equation}
\left\langle ,\right\rangle :\mathcal{F}_{1}^{d}\times\mathcal{F}%
_{1}\rightarrow\mathbb{C}%
\end{equation}
defines dual maps $T^{d}\in\mathcal{B}\left(  \mathcal{F}_{1}^{d}\right)  $
by
\begin{equation}
\left\langle T^{d}w^{d},v\right\rangle =\left\langle w^{d},Tv\right\rangle
\quad\forall v\in\mathcal{F}_{1}%
\end{equation}
and
\begin{equation}
\left\langle ,\right\rangle :\mathcal{F}_{1}^{dd}\times\mathcal{F}_{1}%
^{d}\rightarrow\mathbb{C}%
\end{equation}
defines dual maps $T^{dd}\in\mathcal{B}\left(  \mathcal{F}_{1}^{dd}\right)  $
by
\begin{equation}
\left\langle T^{dd}y^{dd},w^{d}\right\rangle =\left\langle y^{dd},T^{d}%
w^{d}\right\rangle \quad\forall w^{d}\in\mathcal{F}_{1}^{d}.
\end{equation}


\item $\mathcal{F}_{1}$ is contained in $\mathcal{F}_{1}^{dd}$ as a non closed
subspace. Obviously it is closed in the Banach space topology of
$\mathcal{F}_{1}$ but not the Banach space topology of $\mathcal{F}_{1}^{dd}$
unless $\mathcal{F}_{1}$ is a \emph{reflexive} Banach space.

\item If $\mathcal{F}_{1}^{d}$ and $\mathcal{F}_{1}$ have bases than one can
construct \emph{biorthogonal bases} $\left\{  \left.  v_{j}^{d}\right\vert
1\leq j\leq2r\right\}  ,$ $\left\{  \left.  v_{j}\right\vert 1\leq
j\leq2r\right\}  $ such that
\begin{equation}
v_{k}^{d}\left(  v_{j}\right)  =\left\langle v_{k}^{d},y_{j}\right\rangle
=\delta_{jk};\quad1\leq j,k\leq2r.
\end{equation}


\begin{remark}
In the case of operators acting on a Hilbert space $\mathcal{H}_{\mathcal{F}}$
the space $\mathcal{F}_{1}$ is closed wrt the operator topology in
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $, $\mathcal{F}_{1}^{d}$
in the linear functional topology $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  ^{d}$ and the predual $\mathcal{F}_{1d}$ in the trace
class topology of $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  $.
The nuclear space $\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
is dense within these spaces wrt bounded linear functionals on operators,
operator and trace class norm topologies.
\end{remark}

\begin{remark}
Recall the decompositions
\begin{equation}
\mathcal{F}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =%
%TCIMACRO{\tbigoplus \limits_{m,n=0}^{r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{m,n=0}^{r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{m},\mathcal{H}^{n}\right)  =%
%TCIMACRO{\tbigoplus \limits_{n=0}^{2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{n=0}^{2r}}
%EndExpansion
\mathcal{F}_{n}=%
%TCIMACRO{\tbigoplus \limits_{m,n=0}^{r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{m,n=0}^{r}}
%EndExpansion
\mathcal{A}_{mn}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\mathcal{F}_{0}  &  =\mathcal{A}_{00}\\
\mathcal{F}_{1}  &  =\mathcal{A}_{10}\oplus_{\mathbb{C}}\mathcal{A}_{01}\\
\mathcal{F}_{2}  &  =\mathcal{A}_{20}\oplus_{\mathbb{C}}\mathcal{A}_{11}%
\oplus_{\mathbb{C}}\mathcal{A}_{02}=%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{F}_{1}.
\end{align}

\end{remark}

\item One can form \emph{biorthogonal bases} $\left\{  \left.  v_{j}%
^{dd}\right\vert 1\leq j\leq2r\right\}  ,\left\{  \left.  v_{j}^{d}\right\vert
1\leq j\leq2r\right\}  .$

\item Ket-Bra operators from Dual Banach spaces
\[
v\otimes w^{d}\equiv\left\vert y\right\rangle \left\langle w^{d}\right\vert
\text{ }%
\]
are operators $\in\mathcal{B}\left(  \mathcal{F}_{1}\right)  ,$ where
$w^{d}\in\mathcal{F}_{1}^{d}$ and $v\in\mathcal{F}_{1}$ and%
\begin{equation}
y^{dd}\otimes w^{d}\equiv\left\vert y^{dd}\right\rangle \left\langle
w^{d}\right\vert \text{ }%
\end{equation}
are operators $\in\mathcal{B}\left(  \mathcal{F}_{1}^{d}\right)  ,$ where
$w^{d}\in\mathcal{F}_{1}^{d}$ and $v\in\mathcal{F}_{1}^{dd}.$

\item Operator product in $\mathcal{B}\left(  \mathcal{F}_{1}\right)  $%
\begin{equation}
\left\vert y_{j_{1}}\right\rangle \left\langle v_{k_{1}}^{d}\right\vert
\left\vert y_{j_{2}}\right\rangle \left\langle v_{k_{2}}^{d}\right\vert
=\left\langle v_{k_{1}}^{d},y_{j_{2}}\right\rangle \left\vert y_{j_{1}%
}\right\rangle \left\langle v_{k_{2}}^{d}\right\vert .
\end{equation}
Operator product in $\mathcal{B}\left(  \mathcal{F}_{1}^{d}\right)  $%
\begin{equation}
\left\vert v_{k_{1}}^{d}\right\rangle \left\langle y_{j_{1}}^{dd}\right\vert
\left\vert v_{k_{2}}^{d}\right\rangle \left\langle y_{j_{2}}^{dd}\right\vert
=\left\langle y_{j_{2}}^{d},v_{k_{1}}^{dd}\right\rangle \left\vert v_{k_{2}%
}^{d}\right\rangle \left\langle y_{j_{1}}^{dd}\right\vert .
\end{equation}


\begin{definition}
Generalized traces
\begin{align}
\operatorname{Tr}\left\{  \left\vert v\right\rangle \left\langle
w^{d}\right\vert \right\}   &  =w^{d}\left(  y\right)  =v\left(  w^{d}\right)
=\operatorname{Tr}\left\{  \left\vert w^{d}\right\rangle \left\langle
v\right\vert \right\} \\
w^{d}  &  \in\mathcal{F}_{1}^{d},v\in\mathcal{F}_{1}\subset\mathcal{F}%
_{1}^{dd}.
\end{align}
and%
\begin{align}
\operatorname{Tr}\left\{  \left\vert v^{d}\right\rangle \left\langle
w^{dd}\right\vert \right\}   &  =w^{dd}\left(  y^{d}\right)  =v^{d}\left(
w^{dd}\right)  =\operatorname{Tr}\left\{  \left\vert w^{dd}\right\rangle
\left\langle v^{d}\right\vert \right\} \\
w^{dd}  &  \in\mathcal{F}_{1}^{dd},v^{d}\in\mathcal{F}_{1}^{d}\subset
\mathcal{F}_{1}.
\end{align}

\end{definition}

\item Recall biorthogonality between geminal basis is given by
\begin{align}
\left\langle v_{j}^{d}v_{k}^{d}\right\vert \left\vert v_{l}v_{m}\right\rangle
&  =2\left\langle v_{j}^{d}\wedge v_{k}^{d}\right\vert \left\vert v_{l}\wedge
v_{m}\right\rangle =2\frac{1}{4}\left\langle v_{j}^{d}\otimes v_{k}^{d}%
-v_{k}^{d}\otimes v_{j}^{d}\right\vert \left\vert v_{l}\otimes v_{m}%
-v_{m}\otimes v_{l}\right\rangle \\
&  =\frac{1}{2}\left(  \left\langle v_{j}^{d}\otimes v_{k}^{d}\right\vert
\left\vert v_{l}\otimes v_{m}\right\rangle -\left\langle v_{j}^{d}\otimes
v_{k}^{d}\right\vert \left\vert v_{m}\otimes v_{l}\right\rangle -\left\langle
v_{k}^{d}\otimes v_{j}^{d}\right\vert \left\vert v_{l}\otimes v_{m}%
\right\rangle +\left\langle v_{k}^{d}\otimes v_{j}^{d}\right\vert \left\vert
v_{m}\otimes v_{l}\right\rangle \right) \\
&  =\frac{1}{2}\left(  \delta_{jl}\delta_{km}-\delta_{jm}\delta_{kl}%
-\delta_{kl}\delta_{jm}+\delta_{km}\delta_{jl}\right)  =\left(  \delta
_{jl}\delta_{km}-\delta_{jm}\delta_{kl}\right)
\end{align}


\item An antisymmetric complex antisymmetric bilinear forms $g\in
\mathcal{BL}\left(  \mathcal{F}_{1}\times\mathcal{F}_{1}\right)  $ on the
Banach space $\mathcal{F}_{1}$
\begin{equation}
g:\mathcal{F}_{1}\times\mathcal{F}_{1}\rightarrow\mathbb{C}%
\end{equation}
are defined by

\begin{definition}%
\begin{gather}
g\left(  w_{1},w_{2}\right)  =-g\left(  w_{2},w_{1}\right)  =\sum_{1\leq j\leq
r}c_{gj}\left\langle v_{j}^{d}v_{j+r}^{d}\right\vert \left\vert w_{1}\wedge
w_{2}\right\rangle \\
=\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{  v_{j}^{d}\left(
w_{1}\right)  v_{j+r}^{d}\left(  w_{2}\right)  -v_{j}^{d}\left(  w_{2}\right)
v_{j+r}^{d}\left(  w_{1}\right)  \right\} \\
v_{j}^{d},v_{j+r}^{d}\in\mathcal{F}_{1}^{d},\quad w_{1},w_{2}\in
\mathcal{F}_{1},\quad c_{gj}\in\mathbb{R}_{+}%
\end{gather}

\end{definition}

\begin{definition}
By definition
\begin{equation}
\left\langle g^{d}\right\vert =\sum_{1\leq j\leq r}c_{gj}\left\langle
v_{j}^{d}v_{j+r}^{d}\right\vert =\sqrt{2}\sum_{1\leq j\leq r}c_{gj}%
\left\langle v_{j}^{d}\wedge v_{j+r}^{d}\right\vert
\end{equation}

\end{definition}

\item The norm of the bilinear function $g$ is given by
\begin{equation}
\left\Vert g\right\Vert =\sup\limits_{\substack{\left\Vert v_{1}\right\Vert
=\left\Vert v_{2}\right\Vert =1\\v_{1},v_{2}\in\mathcal{F}_{1}}}\left\{
\left\vert \overset{}{g\left(  v_{1},v_{2}\right)  }\right\vert \right\}  .
\end{equation}


\begin{lemma}
The norm in $\mathcal{F}_{2}$ is equal to the norm in $\mathcal{BL}\left(
\mathcal{F}_{1}\times\mathcal{F}_{1}\right)  .$\emph{ }
\end{lemma}

Bilinear forms correspond to

\begin{enumerate}
\item \emph{ Dual Geminal Operators} $\left\langle g^{d}\right\vert $
belonging to $\mathcal{F}_{2}^{d}$ which are associated to $g$ by%
\begin{equation}
\left\langle g^{d}\right\vert =\sqrt{2}\sum_{1\leq j\leq r}c_{gj}v_{j}%
^{d}\wedge v_{j+r}^{d}=\sum_{1\leq j\leq r}c_{gj}\left\langle v_{j}^{d}%
v_{j+r}^{d}\right\vert
\end{equation}
and the value of the bilinear form can be expressed as
\begin{gather}
g\left(  u,w\right)  =\left\langle g^{d}\right\vert \left\vert w_{1}\wedge
w_{2}\right\rangle =\sum_{1\leq j\leq r}c_{gj}\left\langle v_{j}^{d}%
v_{j+r}^{d}\right\vert \left\vert u\wedge w\right\rangle =\sum_{1\leq j\leq
r}\sum_{1\leq k,l\leq2r}c_{gj}\left\langle v_{j}^{d}v_{j+r}^{d}\right\vert
\left\vert v_{k}v_{l}\right\rangle u_{k}w_{l}\\
=\sum_{1\leq j\leq r}\sum_{1\leq k,l\leq2r}c_{gj}\left(  \delta_{jk}%
\delta_{j+rl}-\delta_{j+rk}\delta_{jl}\right)  u_{k}w_{l}=\sum_{1\leq j\leq
r}\sum_{1\leq k,l\leq2r}\left\{  c_{gj}\delta_{jk}\delta_{j+rl}u_{k}%
w_{l}-c_{gj}\delta_{j+rk}\delta_{jl}u_{k}w_{l}\right\} \\
=\sum_{1\leq j\leq r}\sum_{1\leq k,l\leq2r}c_{gj}\left\{  \delta_{jk}%
\delta_{j+rl}-\delta_{j+rk}\delta_{jl}\right\}  u_{k}w_{l}=\sum_{1\leq j\leq
r}c_{gj},
\end{gather}
which can be expressed as
\begin{gather}
g\left(  u,w\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{u}_{1} & \mathbf{u}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{w}_{1}\\
\mathbf{w}_{2}%
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cc}%
-\mathbf{u}_{2}^{t}\boldsymbol{c}_{g} & \mathbf{u}_{1}^{t}\boldsymbol{c}_{g}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{w}_{1}\\
\mathbf{w}_{2}%
\end{array}
\right)  =-\mathbf{u}_{2}^{t}\boldsymbol{c}_{g}\mathbf{w}_{1}+\mathbf{u}%
_{1}^{t}\boldsymbol{c}_{g}\mathbf{w}_{2}=\mathbf{u}_{1}^{t}\boldsymbol{c}%
_{g}\mathbf{w}_{2}-\mathbf{u}_{2}^{t}\boldsymbol{c}_{g}\mathbf{w}_{1}\\
=\sum_{1\leq j\leq r}\left\{  \mathbf{u}_{1j}\boldsymbol{c}_{gjk}%
\mathbf{w}_{2k}-\mathbf{u}_{2j}\boldsymbol{c}_{gjk}\mathbf{w}_{1k}\right\}  .
\end{gather}


\item In the Hilbert space case
\begin{gather}
\left\langle g\right\vert =\sum_{1\leq j\leq r}c_{gj}\left\langle v_{j}%
^{d}v_{j+r}^{d}\right\vert =\left\vert g\right\rangle =\sum_{1\leq j\leq
r}c_{gj}\left\vert v_{j}^{d}v_{j+r}^{d}\right\rangle \\
\Xi\left(  g\right)  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{
\left\vert v_{j}\right\rangle \left\langle v_{j+r}\right\vert -\left\vert
v_{j+r}\right\rangle \left\langle v_{j}\right\vert \right\} \\
\left\vert v_{j}\right\rangle \in\mathcal{F}_{1},\quad\left\langle
v_{j}\right\vert \in\mathcal{F}_{1}%
\end{gather}
Hence in this case the complex linear map
\begin{equation}
\Upsilon:\mathcal{F}_{2}\rightarrow\mathcal{B}\left(  \mathcal{F}_{1}\right)
\end{equation}
is given by%
\begin{gather}
\Upsilon\left(  \sum_{1\leq j\leq r}c_{gj}\left\vert v_{j}^{d}v_{j+r}%
^{d}\right\rangle \right)  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}%
c_{gj}\left\{  \left\vert v_{j}\right\rangle \left\langle v_{j+r}\right\vert
-\left\vert v_{j+r}\right\rangle \left\langle v_{j}\right\vert \right\} \\
\text{i.e. }\Upsilon\left(  \left\vert g\right\rangle \right)  =\Xi\left(
g\right)  .
\end{gather}


\item \emph{Geminal Operators }$\left\vert g\right\rangle $ belonging to
$\mathcal{F}_{2}$ correspondsing to $g$%
\begin{equation}
\left\vert g\right\rangle =\sqrt{2}\sum_{1\leq j\leq r}c_{gj}v_{j}\wedge
v_{j+r}=\sum_{1\leq j\leq r}c_{gj}\left\vert v_{j}v_{j+r}\right\rangle .
\end{equation}


\item \emph{Geminal Operators }$\Xi\left(  g\right)  $ belonging to
$\mathcal{B}\left(  \mathcal{F}_{1}\right)  $ correspondsing to $g$
\begin{gather}
\Xi\left(  g\right)  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{
\left\vert v_{j}^{dd}\right\rangle \left\langle v_{j+r}^{d}\right\vert
-\left\vert v_{j+r}^{dd}\right\rangle \left\langle v_{j}^{d}\right\vert
\right\} \\
\left\vert v_{j}^{dd}\right\rangle \in\mathcal{F}_{1}^{dd},\quad\left\langle
v_{j}^{d}\right\vert \in\mathcal{F}_{1}^{d}%
\end{gather}


\item The representation $\mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)
$ of $\Xi\left(  g\right)  $ is
\begin{equation}
\mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  .
\end{equation}


\item Matrix elements are given by
\begin{align}
\left\langle w_{1}^{d},\Xi\left(  g\right)  \left\vert w_{2}\right\rangle
\right\rangle  &  =\Xi\left(  g\right)  _{w_{1}w_{2}}=\frac{1}{\sqrt{2}}%
\sum_{1\leq j\leq r}c_{gj}\left\{  \left\langle \overset{}{w_{1}^{d}%
}\right\vert \left\{  \left\vert \overset{}{v_{j}^{dd}}\right\rangle
\left\langle \overset{}{v_{j+r}^{d}}\right\vert -\left\vert \overset{}{v_{j+r}%
^{dd}}\right\rangle \left\langle \overset{}{v_{j}^{d}}\right\vert \right\}
\left\vert \overset{\overset{}{}}{w_{2}}\right\rangle \right\} \\
&  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{  \left\langle
v_{j}^{dd}\right\vert \left\vert w_{1}^{d}\right\rangle \left\langle
v_{j+r}^{d}\right\vert \left\vert w_{2}\right\rangle -\left\langle
v_{j+r}^{dd}\right\vert \left\vert w_{1}^{d}\right\rangle \left\langle
v_{j}^{d}\right\vert \left\vert w_{2}\right\rangle \right\} \\
&  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{  \left\langle
w_{1}^{d}\right\vert \left\vert v_{j}\right\rangle \left\langle v_{j+r}%
^{d}\right\vert \left\vert w_{2}\right\rangle -\left\langle w_{1}%
^{d}\right\vert \left\vert v_{j+r}\right\rangle \left\langle v_{j}%
^{d}\right\vert \left\vert w_{2}\right\rangle \right\} \\
&  =g\left(  w_{1},w_{2}\right)  .
\end{align}
If one considers $\Xi\left(  g\right)  \in\mathcal{B}\left(  \mathcal{F}%
_{1}^{dd}\right)  $ then
\begin{equation}
\left\langle w^{d},\Xi\left(  g\right)  v\right\rangle =v\left(  \Xi\left(
g\right)  w^{d}\right)  .
\end{equation}


\item The map $\Upsilon$
\begin{equation}
\Upsilon:\mathcal{F}_{2}^{d}\rightarrow\mathcal{B}_{anti}\left(
\mathcal{F}_{1}\right)  \subset\mathcal{B}\left(  \mathcal{F}_{1}\right)
\end{equation}
is a Banach space isomorphism.

\item
\begin{equation}
g\left(  \eta_{1},\eta_{2}\right)  =\left\langle g^{d},\eta_{1}\wedge\eta
_{2}\right\rangle =\operatorname{Tr}\left\{  \Xi\left(  g\right)  \left\vert
\eta_{1}\right\rangle \left\langle \eta_{2}^{d}\right\vert \right\}
=\left\langle \eta_{2}^{d},\Xi\left(  g\right)  \eta_{1}\right\rangle ;\quad
v_{1}\in\mathcal{F}_{1}\subset\mathcal{F}_{1}^{dd},\quad\eta_{2}^{d}%
\in\mathcal{F}_{1}^{d}.
\end{equation}


\item The representation of $\Xi\left(  g\right)  $ is given by
\begin{equation}
\Xi\left(  g\right)  \left\vert v_{1},\cdots,v_{2r}\right\rangle =\left\vert
v_{1},\cdots,v_{2r}\right\rangle \mathcal{R}_{v}\left(  \Xi\left(  g\right)
\right)  .
\end{equation}
givng the matrix
\begin{align}
\mathcal{M}_{v}\left(  \Xi\left(  g\right)  \right)   &  =\left\langle
v_{1}^{d},\cdots,v_{2r}^{d}\right\vert \Xi\left(  g\right)  \left\vert
v_{1},\cdots,v_{2r}\right\rangle =\left\langle v_{1}^{e},\cdots,v_{^{e}%
2r}\right\vert \left\vert v_{1},\cdots,v_{2r}\right\rangle \mathcal{R}%
_{v}\left(  \Xi\left(  g\right)  \right) \\
&  =\mathbb{S}_{v}\mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)  .
\end{align}


\item The resolution of the Identity $I_{\mathcal{F}_{1}}\in\mathcal{B}\left(
\mathcal{F}_{1}\right)  $ is given by
\begin{equation}
I_{\mathcal{F}_{1}}=\sum_{1\leq j\leq2r}\left\vert y_{j}\right\rangle
\left\langle y_{j}^{d}\right\vert ,
\end{equation}
where $\left\{  \left.  v_{j}\right\vert 1\leq j\leq2r\right\}  $ and
$\left\{  \left.  y_{j}^{d}\right\vert 1\leq j\leq2r\right\}  $ are
biorthogonal bases.

\item Using this resolution of the identity one obtains
\begin{gather}
\Xi\left(  g\right)  \left\vert \mathbf{v}\right\rangle =\left(
I_{\mathcal{F}_{1}}\circ\Xi\left(  g\right)  \right)  \left\vert
\mathbf{v}\right\rangle =\sum_{1\leq j\leq2r}\left\vert y_{j}\right\rangle
\left\langle v_{j}^{d}\right\vert \Xi\left(  g\right)  \left\vert v_{1}%
,\cdots,v_{2r}\right\rangle =\left\vert v_{1},\cdots,v_{2r}\right\rangle
\left\langle \left.  \mathbf{v}^{d}\right\vert \Xi\left(  g\right)
\mathbf{v}\right\rangle \\
=\sum_{1\leq j\leq2r}\left\vert y_{j}\right\rangle \left\langle v_{j}%
^{d}\right\vert \left\vert v_{1},\cdots,v_{2r}\right\rangle \mathcal{R}%
_{v}\left(  \Xi\left(  g\right)  \right)  =\left\vert v_{1},\cdots
,v_{2r}\right\rangle \mathbb{S}_{v}\left(  \mathbf{v}^{d},\mathbf{v}\right)
\mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)  =\left\vert
\mathbf{v}\right\rangle \mathbb{S}_{v}\left(  \mathbf{v}^{d},\mathbf{v}%
\right)  \mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)  .
\end{gather}
hence
\begin{equation}
\left\langle \left.  \mathbf{v}^{d}\right\vert \Xi\left(  g\right)
\mathbf{v}\right\rangle =M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)
\in\mathcal{M}\left(  2r,\mathbb{C}\right)  =\mathbb{S}_{v}\left(
\mathbf{v}^{d},\mathbf{v}\right)  \mathcal{R}_{v}\left(  \Xi\left(  g\right)
\right)
\end{equation}
giving
\begin{equation}
\mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)  =\left(  \mathbb{S}%
\left(  \mathbf{v}^{d},\mathbf{v}\right)  \right)  ^{-1}M_{v^{d}v}\left(
\Xi\left(  g\right)  \right)  .
\end{equation}

\end{enumerate}

\item As%
\begin{equation}
g\left(  \eta_{1},\eta_{2}\right)  =\left\langle g^{d},\eta_{1}\wedge\eta
_{2}\right\rangle =\operatorname{Tr}\left\{  \Xi\left(  g\right)  \left\vert
\eta_{1}\right\rangle \left\langle \eta_{2}^{d}\right\vert \right\}
=\left\langle \eta_{2}^{d},\Xi\left(  g\right)  \eta_{1}\right\rangle ;\quad
v_{1}\in\mathcal{F}_{1}\subset\mathcal{F}_{1}^{dd},\quad\eta_{2}^{d}%
\in\mathcal{F}_{1}^{d}%
\end{equation}
one obtains
\begin{equation}
g\left(  \eta_{1},\eta_{2}\right)  =\left\langle \eta_{1}^{d},\Xi\left(
g\right)  \eta_{1}\right\rangle =\mathcal{R}_{v}\left(  \eta_{2}\right)
^{t}M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)  \mathcal{R}_{v}\left(
\eta_{1}\right)  .
\end{equation}


\item
\begin{align}
\left\langle v_{k}^{d}\right\vert \Xi\left(  g\right)  \left\vert
v_{l}\right\rangle  &  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{
\left\langle v_{k}^{d}\right\vert \left\vert v_{j}\right\rangle \left\langle
v_{j+r}^{d}\right\vert -\left\langle v_{k}^{d}\right\vert \left\vert
v_{j+r}\right\rangle \left\langle v_{j}^{d}\right\vert \right\}  \left\vert
\overset{}{v_{l}}\right\rangle =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}%
c_{gj}\left\{  \left\langle v_{k}^{d}\right\vert \overset{}{\left\vert
y_{j}\right\rangle \left\langle v_{j+r}^{d}\right\vert \left\vert
v_{l}\right\rangle -\left\langle v_{k}^{d}\right\vert \left\vert
y_{j+r}\right\rangle \left\langle v_{j}^{d}\right\vert }\left\vert
v_{l}\right\rangle \right\} \\
&  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{  \delta_{kj}%
\delta_{j+rl}-\delta_{kj+r}\delta_{jl}\right\}  ;\quad1\leq k,l\leq2r.
\end{align}


\item
\begin{equation}
M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)  =\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cccccc}%
0 & 0\cdots0 & 0 & c_{g1} & 0\cdots0 & 0\\
0 & \ddots & \vdots & \vdots & \ddots & 0\\
0 & 0\cdots0 & 0 & 0 & 0\cdots0 & c_{gr}\\
-c_{g1} & 0\cdots0 & 0 & 0 & 0\cdots0 & 0\\
\vdots & \ddots & \vdots & \vdots & \ddots & \vdots\\
0 & 0\cdots0 & -c_{gr} & 0 & 0\cdots0 & 0
\end{array}
\right)  =\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  ,
\end{equation}
where
\begin{equation}
\boldsymbol{c}_{g}=\left(
\begin{array}
[c]{ccc}%
c_{g1} & 0\cdots0 & 0\\
\vdots & \ddots & 0\\
0 & 0\cdots0 & c_{gr}%
\end{array}
\right)  .
\end{equation}


\item Hilbert Schmidt norm of $\Xi\left(  g\right)  $ is equal to the Hilbert
space norm of $\left\vert g\right\rangle $ as
\begin{gather}
\operatorname{Tr}\left\{  M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)
^{t}M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)  \right\}  =\\
\operatorname{Tr}\left\{  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  ^{t}\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  \right\}  =\frac{1}{2}\operatorname{Tr}\left\{  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & -\boldsymbol{c}_{g}\\
\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  \right\} \\
=\frac{1}{2}\operatorname{Tr}\left\{  \boldsymbol{c}_{g}^{2}+\boldsymbol{c}%
_{g}^{2}\right\}  =\operatorname{Tr}\left\{  \boldsymbol{c}_{g}^{2}\right\}
=\left\Vert \left\vert g\right\rangle \right\Vert _{\mathcal{F}_{1}}^{2}.
\end{gather}


\item
\begin{align}
g\left(  \eta_{1},\eta_{2}\right)   &  =\left\langle \eta_{1}^{d},\Xi\left(
g\right)  \eta_{1}\right\rangle =\mathcal{R}_{v}\left(  \eta_{2}\right)
^{t}M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)  \mathcal{R}_{v}\left(
\eta_{1}\right)  =\mathcal{R}_{v}\left(  \eta_{2}\right)  ^{t}\mathcal{R}%
_{v}\left(  \Xi\left(  g\right)  \right)  \mathcal{R}_{v}\left(  \eta
_{1}\right) \\
&  =\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cccccc}%
\eta_{21} & \cdots & \cdots & \cdots & \cdots & \eta_{22r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cccccc}%
0 & 0\cdots0 & 0 & c_{g1} & 0\cdots0 & 0\\
0 & \ddots & \vdots & \vdots & \ddots & 0\\
0 & 0\cdots0 & 0 & 0 & 0\cdots0 & c_{gr}\\
-c_{g1} & 0\cdots0 & 0 & 0 & 0\cdots0 & 0\\
\vdots & \ddots & \vdots & \vdots & \ddots & \vdots\\
0 & 0\cdots0 & -c_{gr} & 0 & 0\cdots0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\eta_{11}\\
\vdots\\
\vdots\\
\vdots\\
\vdots\\
\eta_{12r}%
\end{array}
\right) \\
&  =\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbf{\eta}_{21} & \mathbf{\eta}_{22}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & \boldsymbol{c}_{g}\\
-\boldsymbol{c}_{g} & \mathbb{O}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\eta}_{11}\\
\mathbf{\eta}_{12}%
\end{array}
\right)  .
\end{align}


\begin{summary}%
\begin{align}
\Xi\left(  g\right)   &  =\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}c_{gj}\left\{
\left\vert y_{j}\right\rangle \left\langle v_{j+r}^{d}\right\vert -\left\vert
y_{j+r}\right\rangle \left\langle v_{j}^{d}\right\vert \right\} \\
\left\vert g\right\rangle  &  =\sum_{1\leq j\leq r}c_{gj}\left\vert
y_{j}y_{j+r}\right) \\
\left\langle g^{d}\right\vert  &  =\sum_{1\leq j\leq r}c_{gj}\left\langle
v_{j}^{d}v_{j+r}^{d}\right\vert \\
M_{v^{d}v},\mathcal{R}_{v}  &  :\mathcal{B}\left(  \mathcal{F}_{1}\right)
\rightarrow\mathcal{M}\left(  2r,\mathbb{C}\right)  .
\end{align}

\end{summary}

\item The \emph{Symplectic group} $Sp_{g}\left(  \mathcal{F}_{1}%
,\mathbb{C}\right)  $ corresponding to a geminal $g\in$ $\mathcal{BL}\left(
\mathcal{F}_{1}^{d}\times\mathcal{F}_{1}^{d}\right)  \leftrightarrow$
$\left\langle g^{d}\right\vert \in$ $\mathcal{F}_{2}^{d}\leftrightarrow
\left\vert g\right\rangle \in$ $\mathcal{F}_{2}\leftrightarrow\Xi\left(
g\right)  \in\mathcal{B}\left(  \mathcal{F}_{1}\right)  $ is defined by
\begin{equation}
Sp\left(  \mathcal{F}_{1},\mathbb{C}\right)  =\left\{  \left.  T\in
\mathcal{B}\left(  \mathcal{F}_{1}\right)  \right\vert g\left(  T\eta
_{1},T\eta_{2}\right)  =g\left(  \eta_{1},\eta_{2}\right)  ;\forall\eta
_{1},\eta_{2}\in\mathcal{F}_{1}\right\}
\end{equation}


\begin{proposition}
If the rank of the geminal is $r$ then
\begin{equation}
Sp_{g}\left(  \mathcal{F}_{1},\mathbb{C}\right)  \subset\mathcal{B}\left(
\mathcal{F}_{1}\right)  \cong Sp\left(  2r,\mathbb{C}\right)  \subset
\mathcal{B}\left(  \mathbb{C}^{2r}\right)
\end{equation}
which implies
\begin{equation}
Sp_{g}\left(  \mathcal{F}_{1},\mathbb{C}\right)  \cong Sp_{g^{\prime}}\left(
\mathcal{F}_{1},\mathbb{C}\right)  \quad\forall g,g^{\prime}\in\mathcal{F}%
_{2}^{d}.
\end{equation}

\end{proposition}

\begin{lemma}
The value of bilinear antisymmetric form $g$ is given by
\begin{equation}
g\left(  \eta_{1},\eta_{2}\right)  =\left\langle \eta_{1},\Xi\left(  g\right)
\eta_{2}\right\rangle =\mathcal{R}_{v^{d}}\left(  \left\langle \eta_{1}%
^{d}\right\vert \right)  \mathcal{R}_{v}\left(  \Xi\left(  g\right)  \right)
\mathcal{R}_{v}\left(  \left\vert \eta_{2}\right\rangle \right)
=\mathbf{\eta}_{1}^{t}\left(  \mathbb{S}_{v}\left(  \mathbf{v}^{d}%
,\mathbf{v}\right)  \right)  ^{-1}M_{v^{d}v}\left(  \Xi\left(  g\right)
\right)  \mathbf{\eta}_{2}%
\end{equation}
and the Symplectic group $Sp_{g}\left(  \mathcal{F}_{1},\mathbb{C}\right)  $
is given by
\begin{align}
\left\langle \left(  T\boxtimes T\right)  ^{d}g^{d},\eta_{1}\wedge\eta
_{2}\right\rangle  &  =g\left(  T\eta_{1},T\eta_{2}\right)  =\left\langle
g,T\eta_{1}\wedge T\eta_{2}\right\rangle =\left\langle g,\left(  T\boxtimes
T\right)  \eta_{1}\wedge\eta_{2}\right\rangle =g\left(  \eta_{1},\eta
_{2}\right)  =\left\langle g^{d},\eta_{1}\wedge\eta_{2}\right\rangle \\
&  =\left\langle \eta_{1}^{d},\Xi\left(  g\right)  \eta_{2}\right\rangle
=\mathbf{\eta}_{1}^{t}M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)
\mathbf{\eta}_{2}\\
\forall\eta_{1},\eta_{2}  &  \in\mathcal{F}_{1};\quad g^{d}\in\mathcal{F}%
_{2}^{d}\leftrightarrow g\in\mathcal{B}\left(  \mathcal{F}_{1}\times
\mathcal{F}_{1},\mathbb{C}\right)  \leftrightarrow\Xi\left(  g\right)
\in\mathcal{B}_{anti}\left(  \mathcal{F}_{1}\right)  ;\quad T\boxtimes
T\in\mathcal{B}\left(  \mathcal{F}_{2}\right)  .
\end{align}

\end{lemma}

\begin{remark}%
\begin{equation}
\boxtimes\left(  T\right)  \in\mathcal{B}\left(  \mathcal{F}\right)
:\mathcal{F}\rightarrow\mathcal{F},
\end{equation}
and%
\begin{gather}
\left\langle \left(  T\wedge T\right)  ^{d}g^{d},\left(  v_{1}\wedge
v_{2}\right)  \right\rangle =\left\langle T^{d}v_{2}^{d},\Xi\left(  g\right)
Tv_{1}\right\rangle =\left\langle v_{2}^{d},T^{t}\Xi\left(  g\right)
Tv_{1}\right\rangle =\left\langle v_{2}^{d},\Xi\left(  g\right)
v_{1}\right\rangle \\
\boxtimes^{2}T=T\boxtimes T:\mathcal{F}_{2}\rightarrow\mathcal{F}_{2};\\
\boxtimes^{2}T^{d}=T^{d}\boxtimes T^{d}:\mathcal{F}_{2}^{d}\rightarrow
\mathcal{F}_{2}^{d}\\
\quad\left(  \boxtimes^{2}T^{d}\right)  \left(  \left\langle g^{d}\right\vert
\right)  =\left\langle \left(  \left(  T\boxtimes T\right)  \left(  g\right)
\right)  ^{d}\right\vert \\
T:\mathcal{F}_{1}\rightarrow\mathcal{F}_{1};\quad T^{d}:\mathcal{F}_{1}%
^{d}\rightarrow\mathcal{F}_{1}^{d}\\
T\in Sp\left(  \mathcal{F}_{1},\mathbb{C}\right)  \subset\mathcal{B}\left(
\mathcal{F}_{1}\right)  .
\end{gather}
In terms of operators the definition of the Symplectic group is
\begin{equation}
\widehat{T}\left(  \Xi\left(  g\right)  \right)  =T\Xi\left(  g\right)
T^{t}=\Xi\left(  g\right)  ;\widehat{T}\in\mathcal{B}\left(  \mathcal{B}%
\left(  \mathcal{F}_{1}\right)  \right)  ,\quad T^{t},\Xi\left(  g\right)
,T\in\mathcal{B}\left(  \mathcal{F}_{1}\right)  .
\end{equation}
The relationship between antisymmetric matrices and vectors is given by
\end{remark}

\item
\begin{gather}
\left\vert \mathcal{R}_{v}\left(  g\right)  \right\rangle \in\mathbb{C}%
^{2r}\wedge\mathbb{C}^{2r}=%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathbb{C}^{2r}=\mathcal{R}_{v}\left(  \mathcal{F}_{2}\right)  =\sum_{1\leq
j\leq r}c_{gj}\mathcal{R}_{v}\left(  \left\vert y_{j}y_{j+r}\right\rangle
\right) \\
\left\langle \mathcal{R}_{v^{d}}\left(  g^{d}\right)  \right\vert
\in\mathbb{C}^{2r}\wedge\mathbb{C}^{2r}=%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathbb{C}^{2r}\equiv\mathcal{R}_{v^{d}}\left(  \mathcal{F}_{2}^{d}\right)
=\sum_{1\leq j\leq r}c_{gj}\mathcal{R}_{v^{d}}\left(  \left\langle y_{j}%
^{d}y_{j+r}^{d}\right\vert \right) \\
\updownarrow\\
M_{v^{d}v}\left(  \Xi\left(  g\right)  \right)  \in\mathcal{B}_{anti}\left(
\mathbb{C}^{2r}\right)  \equiv\mathcal{R}_{v}\left(  \mathcal{B}_{anti}\left(
\mathcal{H}^{1}\right)  \right)  =\frac{1}{2}\sum_{1\leq j\leq r}%
c_{gj}\left\{  \left\vert \mathcal{R}_{v}\left(  y_{j}\right)  \right\rangle
\left\langle \mathcal{R}_{v^{d}}\left(  y_{j+r}^{d}\right)  \right\vert
-\left\vert \mathcal{R}_{v}\left(  y_{j+r}\right)  \right\rangle \left\langle
\mathcal{R}_{v^{d}}\left(  y_{j}^{d}\right)  \right\vert \right\} \\
g\left(  T\zeta_{1},T\zeta_{2}\right)  =\left\langle \left(  \mathcal{R}%
_{v}\left(  \overset{}{\left(  \boxtimes^{2}T^{d}\right)  \left\langle
g^{d}\right\vert }\right)  \right)  ,\left(  \overset{}{\mathcal{R}_{v}\left(
\zeta_{1}\right)  ,\mathcal{R}_{v}\left(  \zeta_{2}\right)  }\right)
\right\rangle \\
=\frac{1}{\sqrt{2}}\sum_{1\leq j\leq r}\left\{  \left\langle
\overset{}{\left\langle \overset{}{\mathcal{R}_{v^{d}}\left(  T^{d}\right)
\mathcal{R}_{v^{d}}\left(  \eta_{gj}\right)  \left(  \mathcal{R}_{v^{d}%
}\left(  T^{d}\right)  \mathcal{R}_{v^{d}}\left(  \eta_{gj+r}\right)  \right)
}\right\vert ,}\left\vert \overset{}{\zeta_{1}\wedge\zeta_{2}}\right\rangle
\right\rangle \right\}  ;\\
\quad\mathcal{R}_{v^{d}}\left(  T\right)  \in\mathcal{B}\left(  \mathbb{C}%
^{2r}\right)  ;\quad\mathcal{R}_{v}\left(  \boxtimes^{2}T\right)
\in\mathcal{B}\left(
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathbb{C}^{2r}\right) \\
\updownarrow\\
\widehat{\boxtimes^{2}T}\left(  \Xi\left(  g\right)  \right)  =\frac{1}{2}%
\sum_{1\leq j\leq r}c_{gj}\left\{  \left\vert Ty_{j}\right\rangle \left\langle
T^{d}y_{j+r}^{d}\right\vert -\left\vert Ty_{j+r}\right\rangle \left\langle
T^{d}y_{j}^{d}\right\vert \right\}  =\frac{1}{2}\left(  T\boxtimes T\right)
\sum_{1\leq j\leq r}\left\{  \left\vert v_{j}\right\rangle \left\langle
v_{j+r}^{d}\right\vert -\left\vert v_{j+r}\right\rangle \left\langle v_{j}%
^{d}\right\vert \right\}  \left(  T\boxtimes T\right)  ^{t}\\
\updownarrow\\
\mathcal{R}_{v}\left(  \widehat{\boxtimes^{2}T}\left(  \Xi\left(  g\right)
\right)  \right)  =\sum_{1\leq j\leq r}c_{gj}\left\{  \left\vert \left(
Ty_{j}\right)  \right\rangle \left\langle \left(  Ty_{j+r}\right)
^{d}\right\vert -\left\vert \left(  Ty_{j+r}\right)  \right\rangle
\left\langle \left(  Ty_{j}\right)  ^{d}\right\vert \right\} \\
=\mathcal{R}_{v}\left(  T\boxtimes T\right)  \sum_{1\leq j\leq r}\left\{
\left\vert \mathcal{R}_{v}\left(  y_{j}\right)  \right\rangle \left\langle
\mathcal{R}_{v^{d}}\left(  y_{j+r}^{d}\right)  \right\vert -\left\vert
\mathcal{R}_{v}\left(  y_{j+r}\right)  \right\rangle \left\langle
\mathcal{R}_{v^{d}}\left(  y_{j}^{d}\right)  \right\vert \right\}
\mathcal{R}_{v}\left(  T\boxtimes T\right)  ^{t}.
\end{gather}


\item
\begin{align}
&  \mathcal{B}_{a}\left(  \mathcal{F}_{1}\right)  \boxtimes\mathcal{B}%
_{a}\left(  \mathcal{F}_{1}\right)  \subset\mathcal{B}\left(  \mathcal{F}%
_{2}\right)  :\mathcal{F}_{2}\rightarrow\mathcal{F}_{2}\\
&  \Xi\left(  g\right)  \boxtimes\Xi\left(  g\right)  =\boxtimes^{2}\Xi\left(
g\right)  =\frac{1}{2}\sum_{1\leq j\leq r}\left\{  \left\vert \eta
_{j}\right\rangle \left\langle \eta_{j+r}\right\vert -\left\vert \eta
_{j+r}\right\rangle \left\langle \eta_{j}\right\vert \right\}  \boxtimes
\sum_{1\leq k\leq r}\left\{  \left\vert \eta_{k}\right\rangle \left\langle
\eta_{k+r}\right\vert -\left\vert \eta_{k+r}\right\rangle \left\langle
\eta_{k}\right\vert \right\} \\
&  =\frac{1}{2}\sum_{1\leq j,k\leq r}\left\{  \left\vert \eta_{j}\wedge
\eta_{k}\right\rangle \left\langle \eta_{j+r}\wedge\eta_{k+r}\right\vert
-\left\vert \eta_{j}\wedge\eta_{k+r}\right\rangle \left\langle \eta
_{j+r}\wedge\eta_{k}\right\vert -\left\vert \eta_{j+r}\wedge\eta
_{k}\right\rangle \left\langle \eta_{j}\wedge\eta_{k+r}\right\vert +\left\vert
\eta_{j+r}\wedge\eta_{k+r}\right\rangle \left\langle \eta_{j}\wedge\eta
_{k}\right\vert \right\}  ,
\end{align}


\item
\begin{equation}
\boxtimes\left(  \Xi\left(  g\right)  \right)  \in\mathcal{B}\left(
\mathcal{F}\right)  :\mathcal{F}\rightarrow\mathcal{F}%
\end{equation}


\item
\begin{gather}
\widehat{\boxtimes\left(  T\right)  }\left(  \Xi\left(  g\right)  \right)
=\boxtimes\left(  T\Xi\left(  g\right)  T^{t}\right)  =\boxtimes\left(
T\right)  \left(  \overset{}{\boxtimes\left(  \Xi\left(  g\right)  \right)
}\right)  \left(  \boxtimes\left(  T\right)  \right)  ^{t}\\
\boxtimes\left(  \Xi\left(  g\right)  \right)  ,\boxtimes\left(  T\right)
\in\mathcal{F}%
\end{gather}


\item
\begin{equation}
P_{\mathcal{F}_{2}}\left(  \boxtimes\left(  \Xi\left(  g\right)  \right)
\right)  P_{\mathcal{F}_{2}}=\boxtimes^{2}\left(  \Xi\left(  g\right)
\right)  .
\end{equation}

\end{itemize}

$\mathcal{F}$ is an exterior algebra, $\wedge\left(  \mathcal{F}_{1}\right)
,$ as well as an operator algebra (CAR/Clifford)
\begin{align}
g  &  :\mathcal{F}_{1}\times\mathcal{F}_{1}\rightarrow\mathbb{C}\\
g  &  =\sqrt{2}\sum_{1\leq j\leq r}c_{gj}v_{gj}\wedge v_{gj+r}\\
\Xi\left(  g\right)   &  =\sum_{1\leq j\leq r}c_{gj}\left\{  \left\vert
v_{j}\right\rangle \left\langle v_{j+r}^{d}\right\vert -\left\vert
v_{j+r}\right\rangle \left\langle v_{j}^{d}\right\vert \right\}
\in\mathcal{B}_{anti}\left(  \mathcal{F}_{1}\right) \\
g\left(  a,b\right)   &  =\left\langle \left.  g^{d}\right\vert a\wedge
b\right\rangle =\left\langle \left.  b^{d}\right\vert \Xi\left(  g\right)
a\right\rangle
\end{align}
and%
\begin{align}
T  &  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}\\
\left(  \boxtimes^{2}T\right)  \left(  g\right)   &  \equiv\sqrt{2}\sum_{1\leq
j\leq r}c_{gj}T\left(  v_{gj}\right)  \wedge T\left(  v_{gj+r}\right)
;\quad\boxtimes^{2}T\in\mathcal{B}\left(  \mathcal{F}_{2}\right)
\subset\mathcal{B}\left(  \mathcal{F}\right) \\
\boxtimes^{2}\left(  T\right)   &  =\left.  \boxtimes\left(  T\right)
\right\vert _{\mathcal{F}_{2}}\\
\widehat{T}\left(  \Xi\left(  g\right)  \right)   &  =T\Xi\left(  g\right)
T^{t}=\Xi\left(  T\left(  g\right)  \right) \\
g\left(  Ta,Tb\right)   &  =\left\langle \left(  \left.  \boxtimes^{2}\left(
T\right)  \left(  g\right)  \right\vert \right)  ^{d},a\wedge b\right\rangle
=\left\langle \left.  b^{d}\right\vert \left(  T\Xi\left(  g\right)
T^{t}\right)  \left(  a\right)  \right\rangle .
\end{align}
For all finite rank operators $A\in\mathcal{B}_{00}\left(  \mathcal{F}\right)
$

\begin{description}
\item
\begin{itemize}
\item
\begin{align}
\digamma &  :\mathcal{B}_{00}\left(  \mathcal{F}\right)  \rightarrow
\mathcal{B}_{00}\left(  \mathcal{F}\right) \\
\digamma\left(  A\right)   &  =mAm^{-1};m\in\mathcal{B}_{00}\left(
\mathcal{F}\right)
\end{align}


\item
\begin{align}
A  &  =-A^{t}\\
\left(  mAm^{-1}\right)  ^{t}  &  =-m^{-t}Am^{t}=-mAm^{-1}\\
A  &  =m^{t}mAm^{-1}m^{-t}=m^{t}mA\left(  m^{t}m\right)  ^{-1}.
\end{align}

\end{itemize}
\end{description}

\begin{itemize}
Both $\boxtimes\left(  T\right)  $ and $\boxtimes\left(  \Xi\left(  g\right)
\right)  $ $\in$ $\mathcal{B}\left(  \mathcal{F}\right)  $ and can be
expressed as inner automorphisms of the algebra $\mathcal{B}_{00}\left(
\mathcal{F}\right)  $ and one has the following relationships

\item
\begin{equation}
\widehat{\left(  \boxtimes\left(  T\right)  \right)  }\left(  \boxtimes\left(
\Xi\left(  g\right)  \right)  \right)  =\left(  \boxtimes\left(  T\right)
\right)  \left(  \boxtimes\left(  \Xi\left(  g\right)  \right)  \right)
\left(  \boxtimes\left(  T\right)  \right)  ^{t}=\boxtimes\left(  T\Xi\left(
g\right)  T^{t}\right)
\end{equation}


\item
\begin{equation}
\Xi\left(  \left(  \wedge^{n}g\right)  ^{d}\right)  \in\mathcal{B}\left(
\mathcal{F}_{n}\right)  \overset{?}{=}\boxtimes^{n}\left(  \Xi\left(
g\right)  \right)  \in\mathcal{B}\left(  \mathcal{F}_{n}\right)
\end{equation}


\item
\begin{align}
\Xi\left(  g\right)   &  \in\mathcal{B}_{anti}\left(  \mathcal{F}_{1}\right)
\\
\boxtimes^{2}\Xi\left(  g\right)   &  =\Xi\left(  g\right)  \boxtimes
\Xi\left(  g\right)  \in\mathcal{B}\left(  \mathcal{F}_{2}\right)
\end{align}

\end{itemize}

The following product relationship
\begin{align}
&  \left\vert x_{j_{1}}\wedge\cdots\wedge x_{j_{n}}\right\rangle \left\langle
x_{k_{1}}^{d}\wedge\cdots\wedge x_{k_{m}}^{d}\right\vert \boxtimes\left\vert
x_{l_{1}}\wedge\cdots\wedge x_{l_{p}}\right\rangle \left\langle x_{h_{1}}%
^{d}\wedge\cdots\wedge x_{h_{q}}^{d}\right\vert \\
&  \quad\quad\left.  =\right.  \left\vert x_{j_{1}}\wedge\cdots\wedge
x_{j_{n}}\wedge x_{l_{1}}\cdots\wedge x_{l_{p}}\right\rangle \left\langle
x_{k_{1}}^{d}\wedge\cdots\wedge x_{k_{m}}^{d}\wedge x_{h_{1}}^{d}\cdots\wedge
x_{h_{q}}^{d}\right\vert
\end{align}
shows that in particular

\begin{itemize}
\item
\begin{enumerate}
\item
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{F}_{m},\mathcal{F}_{n}\right)  \boxtimes
\mathcal{B}_{00}\left(  \mathcal{F}_{q},\mathcal{F}_{p}\right)  =\mathcal{B}%
_{00}\left(  \mathcal{F}_{n+p},\mathcal{F}_{m+q}\right)  .
\end{equation}


\item
\begin{align}
g  &  =\sum_{1\leq j\leq r}c_{gj}y_{j}\wedge y_{j+r}\\
\Xi\left(  g\right)   &  =\sum_{1\leq j\leq r}c_{gj}\left\{  \left\vert
y_{j}\right\rangle \left\langle y_{j+r}^{d}\right\vert -\left\vert
y_{j+r}\right\rangle \left\langle y_{j}^{d}\right\vert \right\}
\in\mathcal{B}_{00anti}\left(  \mathcal{F}_{1}\right)
\end{align}


\item
\begin{equation}
g\wedge g=\left(  \sum_{1\leq j\leq r}c_{gj}y_{j}\wedge y_{j+r}\right)
\wedge\left(  \sum_{1\leq k\leq r}c_{gk}y_{k}\wedge y_{k+r}\right)
=\sum_{1\leq j\neq k\leq r}c_{gj}c_{gk}y_{j}\wedge y_{j+r}\wedge y_{k}\wedge
y_{k+r}%
\end{equation}


\item
\begin{align}
&  \Xi\left(  g\right)  \boxtimes\Xi\left(  g\right)  =\left(  \sum_{1\leq
j\leq r}c_{gj}\left\{  \left\vert y_{j}\right\rangle \left\langle y_{j+r}%
^{d}\right\vert -\left\vert y_{j+r}\right\rangle \left\langle y_{j}%
^{d}\right\vert \right\}  \right)  \boxtimes\left(  \sum_{1\leq k\leq r}%
c_{gk}\left\{  \left\vert y_{k}\right\rangle \left\langle y_{k+r}%
^{d}\right\vert -\left\vert y_{k+r}\right\rangle \left\langle y_{k}%
^{d}\right\vert \right\}  \right) \\
&  =\sum_{1\leq j,k\leq r}c_{gj}c_{gk}\left\{  \left\vert y_{j}\right\rangle
\left\langle y_{j+r}^{d}\right\vert \boxtimes\left\vert y_{k}\right\rangle
\left\langle y_{k+r}^{d}\right\vert -\left\vert y_{j}\right\rangle
\left\langle y_{j+r}^{d}\right\vert \boxtimes\left\vert y_{k+r}\right\rangle
\left\langle y_{k}^{d}\right\vert -\left\vert y_{j+r}\right\rangle
\left\langle y_{j}^{d}\right\vert \boxtimes\left\vert y_{k}\right\rangle
\left\langle y_{k+r}^{d}\right\vert +\left\vert y_{j+r}\right\rangle
\left\langle y_{j}^{d}\right\vert \boxtimes\left\vert y_{k+r}\right\rangle
\left\langle y_{k}^{d}\right\vert \right\}
\end{align}


\item
\begin{align}
&  \Xi\left(  y_{1}\wedge y_{3}\right)  \boxtimes\Xi\left(  y_{2}\wedge
y_{4}\right)  =\left(  \left\vert y_{1}\right\rangle \left\langle y_{3}%
^{d}\right\vert -\left\vert y_{3}\right\rangle \left\langle y_{1}%
^{d}\right\vert \right)  \boxtimes\left(  \left\vert y_{2}\right\rangle
\left\langle y_{4}^{d}\right\vert -\left\vert y_{4}\right\rangle \left\langle
y_{2}^{d}\right\vert \right) \\
&  =\left\{  \left\vert y_{1}\wedge y_{2}\right\rangle \left\langle y_{3}%
^{d}\wedge y_{4}^{d}\right\vert +\left\vert y_{1}\wedge y_{4}\right\rangle
\left\langle y_{2}^{d}\wedge y_{3}^{d}\right\vert +\left\vert y_{2}\wedge
y_{3}\right\rangle \left\langle y_{1}^{d}\wedge y_{4}^{d}\right\vert
+\left\vert y_{3}\wedge y_{4}\right\rangle \left\langle y_{1}^{d}\wedge
y_{2}^{d}\right\vert \right\}  \in\mathcal{B}\left(  \mathcal{F}_{2}\right)
\end{align}


\item
\begin{equation}
\left(  \bigwedge\left(  \mathcal{F}_{1}\right)  \right)  \otimes\left(
\bigwedge\left(  \mathcal{F}_{1}\right)  \right)  ^{d}:\bigwedge\left(
\mathcal{F}_{1}\right)  \rightarrow\bigwedge\left(  \mathcal{F}_{1}\right)  .
\end{equation}

\end{enumerate}
\end{itemize}

\subsubsection{Commutation Relationships}

The commutation relationships between elements of $\mathcal{F}_{\left(
2\right)  }$ defined as
\begin{equation}
\mathcal{F}_{\left(  2\right)  }=\mathcal{F}_{0}\oplus\mathcal{F}_{1}%
\oplus\mathcal{F}_{2}%
\end{equation}


are generated by observing that
\begin{align}
x_{j}^{2}  &  =\frac{1}{2}I_{\mathcal{F}}\\
x_{j}x_{k}  &  =-x_{k}x_{j};\quad j\neq k
\end{align}
which leads to%
\begin{equation}
\left[  x_{j}x_{k},I_{\mathcal{F}}\right]  =0
\end{equation}
and thus%
\begin{align*}
x_{k}x_{j}  &  =I_{\mathcal{F}}\delta_{kj}-x_{j}x_{k}\\
&  \Rightarrow\left[  x_{j,}x_{k}\right]  =2x_{j}x_{k}-I_{\mathcal{F}}%
\delta_{kj}.
\end{align*}
This gives

\begin{enumerate}
\item
\begin{align}
\left[  x_{j}x_{k},x_{l}\right]   &  =x_{j}x_{k}x_{l}-x_{l}x_{j}x_{k}%
=x_{j}x_{k}x_{l}-\left(  I\delta_{jl}-x_{j}x_{l}\right)  x_{k}=x_{j}x_{k}%
x_{l}-x_{k}\delta_{jl}+x_{j}x_{l}x_{k}\\
&  =x_{j}x_{k}x_{l}-x_{k}\delta_{jl}+x_{j}\left(  I\delta_{kl}-x_{k}%
x_{l}\right)  =x_{j}x_{k}x_{l}-x_{k}\delta_{jl}+x_{j}\delta_{kl}-x_{j}%
x_{k}x_{l}\nonumber\\
&  =x_{j}\delta_{kl}-x_{k}\delta_{jl}.\nonumber
\end{align}
and

\item
\begin{equation}
\left[  x_{j_{1}}x_{j_{2}},x_{k_{1}}x_{k_{2}}\right]  =\left(  \delta
_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}%
}\right)  I_{\mathcal{F}}+x_{j_{2}}x_{k_{1}}\delta_{j_{1}k_{2}}-x_{j_{1}%
}x_{k_{1}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}%
}x_{k_{2}}\delta_{j_{2}k_{1}}.
\end{equation}

\end{enumerate}

$\lceil$some examples

\begin{description}
\item
\begin{itemize}
\item
\begin{equation}
\left[  x_{1}x_{2},x_{3}x_{4}\right]  =x_{1}x_{2}x_{3}x_{4}-x_{3}x_{4}%
x_{1}x_{2}=x_{1}x_{2}x_{3}x_{4}-x_{1}x_{2}x_{3}x_{4}=0
\end{equation}


\item
\begin{equation}
\left[  x_{1}x_{2},x_{1}x_{4}\right]  =x_{1}x_{2}x_{1}x_{4}-x_{1}x_{4}%
x_{1}x_{2}=-x_{2}x_{4}+x_{4}x_{2}=-x_{2}x_{4}%
\end{equation}


\item
\[
\left[  x_{1}x_{2},x_{2}x_{4}\right]  =x_{1}x_{2}x_{2}x_{4}-x_{2}x_{4}%
x_{1}x_{2}=x_{1}x_{4}-x_{4}x_{1}=x_{1}x_{4}%
\]


\item
\[
\left[  x_{1},x_{2}\right]  =x_{1}x_{2}-x_{2}x_{1}=2x_{1}x_{2}%
\]


\item
\begin{align*}
\left[  x_{1}x_{2},x_{1}\right]   &  =x_{1}x_{2}x_{1}-x_{1}x_{1}x_{2}=-x_{2}\\
\left[  x_{1}x_{2},x_{2}\right]   &  =x_{1}x_{2}x_{2}-x_{2}x_{1}x_{2}=x_{1}\\
\left[  x_{1}x_{2},x_{3}\right]   &  =x_{1}x_{2}x_{3}-x_{3}x_{1}x_{2}=0
\end{align*}


\item
\begin{equation}
\left[  x_{1}x_{2},I_{\mathcal{F}}\right]  =0
\end{equation}
$\rfloor$
\end{itemize}
\end{description}

These commutation relationships show that $\mathcal{F}_{\left(  2\right)  },$
which has dimension
\begin{equation}
1+2r+r\left(  2r-1\right)  =1+2r+2r^{2}-r=1+r+2r^{2},
\end{equation}
is a representation of the Lie algebra $o(2r+1,\mathbb{R})$ and
$so(2r+1,\mathbb{R})$, which contains the subalgebras:

\begin{enumerate}
\item $\mathcal{F}_{0},$ $($a representation of $o\left(  1\right)  ),$
$\mathcal{F}_{1}\oplus\mathcal{F}_{2},$ $($a representation of
$so(2r+1,\mathbb{R})),$ $\mathcal{F}_{0}\oplus\mathcal{F}_{2},$ $($a
representation of $o(2r,\mathbb{R})?)$ and

\item $\mathcal{F}_{2},$ $($a representation of $so(2r,\mathbb{R})).$ If we
consider complex coefficients then then one obtains representations of
$o(2r+1,\mathbb{C})$ and $o(2r,\mathbb{C}).$
\end{enumerate}

\begin{remark}
The groups $SL(2r+1,\mathbb{R}),GL(2r+1,\mathbb{R}),SL(2r+1,\mathbb{C}%
),GL(2r+1,\mathbb{C}),SL(2r,\mathbb{R}),GL(2r,\mathbb{R}),SL(2r,\mathbb{C}%
),GL(2r,\mathbb{C}),Sp(2r,\mathbb{C})$ and $Sp(2r,\mathbb{R})$ \emph{do not
have} representations as inner automorphisms of $\mathcal{F}$ that are
generated by Lie algebras contained in $\mathcal{F}_{\left(  2\right)  }.$
\end{remark}

Representations of the real special orthogonal groups are given by
\begin{equation}
\exp\left\{  \sum_{1\leq j\leq2r}\alpha_{j}x_{j}+\sum_{1\leq j<k\leq2r}%
\alpha_{jk}x_{j}x_{k}\right\}  \in SO(2r+1,\mathbb{R});\left\{  \left.
\alpha_{j},\alpha_{jk}\right\vert 1\leq j<k\leq2r\right\}  \in\mathbb{R}%
\end{equation}
and%
\begin{equation}
\exp\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}  \in
SO(2r,\mathbb{R}).
\end{equation}


One should note%
\begin{equation}
\sum_{1\leq j\leq2r}\alpha_{j}x_{j}+\sum_{1\leq j<k\leq2r}\alpha_{jk}%
x_{j}x_{k}\equiv\sum_{1\leq j\leq2r}\mathcal{R}_{x}\left(  \alpha\right)
_{j}x_{j}+\sum_{1\leq j<k\leq2}\mathcal{R}_{x}\left(  \alpha\right)
_{jk}x_{j}x_{k}=\alpha.
\end{equation}


\begin{remark}%
\begin{align}
&  \Pi_{D}\left(  e^{\widehat{\alpha}}\right)  \Phi_{D}\left(  v\right)
=\Phi_{D}\left(  e^{\widehat{\alpha}}v\right) \\
&  \Phi_{D}\left(  \mathcal{F}_{1}\right)  \text{ is not an invariant
subspace.}%
\end{align}

\end{remark}

The adjoint action of $SO(2r+1,\mathbb{R})$ on $\mathcal{F}$ is given by (this
is not the twisted action)
\begin{gather}
\exp\left\{  \alpha_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq2r}\alpha_{j}%
x_{j}+\sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}  A\exp-\left\{
\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq2r}\alpha_{j}x_{j}+\sum_{1\leq
j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}  =\exp\left\{  \operatorname{adj}%
\left(  \alpha\right)  \right\}  \left(  A\right) \\
\alpha_{0},\alpha_{j},\alpha_{jk}\in\mathbb{R}%
\end{gather}
and
\begin{equation}
\operatorname*{Adj}\left(  \exp\left(  \alpha\right)  \right)  =\exp\left\{
\operatorname{adj}\left(  \alpha\right)  \right\}  :\mathcal{F}_{\left(
2\right)  }\longrightarrow\mathcal{F}_{\left(  2\right)  }%
\end{equation}
i.e. under this \emph{adjoint action} $\mathcal{F}_{\left(  2\right)  }$ is an
invariant subspace of $SO(2r+1,\mathbb{R})$.

The algebra $\mathcal{F}$ has the decomposition
\begin{equation}
\mathcal{F}=\bigoplus\limits_{n=0}^{n=2r}\mathcal{F}_{n}%
\end{equation}
and the subspaces, $\mathcal{F}_{n},$ are invariant under the \emph{adjoint
action} of $SO(2r,\mathbb{R}).$This can be seen by the action of
$SO(2r,\mathbb{R})$ on $\mathcal{F}_{1}$ which is given by
\begin{equation}
\exp\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}
v\exp-\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}
=\exp\left\{  \operatorname{adj}\left(  \alpha\right)  \right\}  \left(
v\right)  =\operatorname*{Adj}\left(  \exp\left(  \alpha\right)  \right)
\left(  v\right)  ,
\end{equation}
and the fact that
\begin{equation}
\mathcal{F}_{n}=\bigwedge\nolimits^{n}\mathcal{F}_{1}.
\end{equation}
In detail the adjoint action of $SO(2r,\mathbb{R})$ is
\begin{equation}
\operatorname*{Adj}\left(  \exp\left(  \alpha\right)  \right)  =\exp\left\{
\operatorname{adj}\left(  \alpha\right)  \right\}  \left(  v\right)
=v+\sum_{1\leq j<k\leq2r}\alpha_{jk}\left[  x_{j}x_{k},v\right]  +\frac{1}%
{2}\left[  \alpha,\left[  \alpha,v\right]  \right]  +\cdots.
\end{equation}
Hence as
\[
\left[  x_{j}x_{k},x_{l}\right]  =x_{j}x_{k}x_{l}-x_{l}x_{j}x_{k}=x_{j}%
\delta_{kl}-x_{k}\delta_{jl}%
\]
one obtains%
\begin{align}
\exp\left\{  \operatorname{adj}\left(  \alpha\right)  \right\}  \left(
v\right)   &  =v+\sum_{\substack{1\leq j<k\leq2r\\1\leq l\leq r}}\alpha
_{jk}v_{l}\left[  x_{j}x_{k},x_{l}\right]  +\frac{1}{2}\left[  \alpha,\left[
\alpha,v\right]  \right]  +\cdots\\
&  =v+\frac{1}{2}\sum_{\substack{1\leq j,k\leq2r\\1\leq l\leq r}}\alpha
_{jk}v_{l}\left\{  x_{j}\delta_{kl}-x_{k}\delta_{jl}\right\}  +\frac{1}%
{2}\left[  \alpha,\left[  \alpha,v\right]  \right]  +\cdots\\
&  =v+\sum_{\substack{1\leq j,k\leq2r\\1\leq l\leq r}}\alpha_{jk}v_{l}%
x_{j}\delta_{kl}-\sum_{\substack{1\leq j,k\leq2r\\1\leq l\leq r}}\alpha
_{jk}v_{l}x_{k}\delta_{jl}+\frac{1}{2}\left[  \alpha,\left[  \alpha,v\right]
\right]  +\cdots\\
&  =v+\frac{1}{2}\sum_{1\leq j,k\leq2r}\alpha_{jk}v_{k}x_{j}-\sum_{1\leq
j,k\leq2r}\alpha_{kj}v_{k}x_{j}+\frac{1}{2}\left[  \alpha,\left[
\alpha,v\right]  \right]  +\cdots\\
&  =v+\sum_{1\leq j,k\leq2r}\alpha_{jk}v_{k}x_{j}+\frac{1}{2}\left[
\alpha,\left[  \alpha,v\right]  \right]  +\cdots\\
&  =v+\sum_{1\leq j,k\leq2r}\alpha_{jk}v_{k}x_{j}+\frac{1}{2}\left[
\alpha,\sum_{1\leq j,k\leq2r}\alpha_{jk}v_{k}x_{j}\right]  +\cdots\\
&  =\sum_{1\leq j\leq2r}x_{j}\left(  e^{\mathcal{R}_{x}\left(  \alpha\right)
}\mathcal{R}_{x}\left(  \nu\right)  \right)  _{j}=\sum_{1\leq j\leq2r}\left(
e^{\mathcal{R}_{x}\left(  \alpha\right)  }\mathcal{R}_{x}\left(  \nu\right)
\right)  _{j}x_{j},
\end{align}
where
\begin{equation}
\left(  e^{\mathcal{R}_{x}\left(  \alpha\right)  }\mathcal{R}_{x}\left(
\nu\right)  \right)  _{j}=\sum\left(  e^{\mathcal{R}_{x}\left(  \alpha\right)
}\right)  _{jk}\mathcal{R}_{x}\left(  \nu\right)  _{k}.
\end{equation}
$\lceil$%
\begin{equation}
\bigwedge\left(  A\oplus\left(  B\oplus C\right)  \right)  =\bigwedge\left(
A\right)  \widehat{\otimes}\bigwedge\left(  B\oplus C\right)  =\bigwedge
\left(  A\right)  \widehat{\otimes}\bigwedge\left(  B\right)  \widehat{\otimes
}\bigwedge\left(  C\right)
\end{equation}%
\begin{equation}
\bigwedge\left(  \mathcal{F}_{0}\oplus\mathcal{F}_{1}\oplus\mathcal{F}%
_{2}\right)  =\bigwedge\left(  \mathcal{F}_{0}\right)  \widehat{\otimes
}\bigwedge\left(  \mathcal{F}_{1}\right)  \widehat{\otimes}\bigwedge\left(
\mathcal{F}_{2}\right)  =I\widehat{\otimes}\mathcal{F}\widehat{\otimes
}\bigwedge\left(  \mathcal{F}_{2}\right)  =\mathcal{F}\widehat{\otimes
}\bigwedge\left(  \mathcal{F}_{2}\right)
\end{equation}
$\rfloor$

\subsection{Groups}

\begin{definition}
\emph{Adjoint Action}
\begin{equation}
\operatorname*{Adj}\left(  A\right)  \left(  B\right)  =ABA^{-1}.
\end{equation}

\end{definition}

\begin{definition}
The \emph{Clifford Algebra} group $GL\left(  \mathcal{F},\mathbb{C}\right)
\subset\mathcal{F}$ is defined as
\begin{equation}
GL\left(  \mathcal{F},\mathbb{C}\right)  =\left\{  A\left.  A\in
\mathcal{F}\right\vert \ni\text{ }A^{-1}\exists\right\}  .
\end{equation}

\end{definition}

\begin{definition}
\emph{Commutator Product} is defined as%
\begin{equation}
A\times B=\frac{1}{2}\left[  A,B\right]  \,\forall A,B\in\mathcal{F}.
\end{equation}

\end{definition}

\begin{definition}
\emph{Grade Involution} is defined as
\begin{equation}
\widehat{A_{k}}=\left(  -1\right)  ^{k}A_{k}.
\end{equation}

\end{definition}

The effect of grade involution on versors is
\begin{equation}
\widehat{x_{1}\cdots x_{k}}=\left(  -1\right)  ^{k}x_{1}\cdots x_{k},
\end{equation}
giving
\begin{align}
\widehat{x_{1}}  &  =-x_{1}\\
\widehat{I_{\mathcal{F}}}  &  =I_{\mathcal{F}}.
\end{align}


\begin{remark}
The \emph{Adjoint map }is a an algebra mapping
\begin{equation}
\operatorname*{Adj}\left(  A\right)  :\mathcal{F}\longrightarrow\mathcal{F}%
\end{equation}
as
\begin{equation}
\operatorname*{Adj}\left(  A\right)  \left(  BC\right)  =ABCA^{-1}%
=ABA^{-1}ACA^{-1}=\left(  \operatorname*{Adj}\left(  A\right)  \left(
B\right)  \right)  \left(  \operatorname*{Adj}\left(  A\right)  \left(
C\right)  \right)  .
\end{equation}

\end{remark}

\begin{remark}
The adjoint map $\operatorname*{Adj}$ has the properties
\begin{equation}
\operatorname*{Adj}:GL\left(  \mathcal{F},\mathbb{C}\right)  \rightarrow
\operatorname*{Inn}\left\{  \mathcal{B}\left(  \mathcal{F}\right)  \right\}
\end{equation}
is a group representation i.e.
\begin{equation}
\operatorname*{Adj}\left(  AB\right)  =\operatorname*{Adj}\left(  A\right)
\circ\operatorname*{Adj}\left(  B\right)  ,
\end{equation}
which can be seen from
\begin{equation}
\operatorname*{Adj}\left(  AB\right)  \left(  C\right)  =\left(  AB\right)
C\left(  AB\right)  ^{-1}=ABCB^{-1}A^{-1}%
\end{equation}
and%
\begin{equation}
\left(  \operatorname*{Adj}\left(  A\right)  \circ\operatorname*{Adj}\left(
B\right)  \right)  \left(  C\right)  =\operatorname*{Adj}\left(  A\right)
\left(  \operatorname*{Adj}\left(  B\right)  \right)  \left(  C\right)
=\operatorname*{Adj}\left(  A\right)  \left(  B\left(  C\right)
B^{-1}\right)  =AB\left(  C\right)  B^{-1}A^{-1}.
\end{equation}

\end{remark}

\begin{example}
Let $x$ and $v$ belong to $\mathcal{F}_{1}$ and $x$ be an involution
(i.e.normalized) then
\begin{equation}
\operatorname*{Adj}\left(  x\right)  v=xvx^{-1}=xvx=-v.
\end{equation}

\end{example}

\begin{definition}
\emph{Twisted Adjoint} action
\begin{align}
\widetilde{\operatorname*{Adj}\left(  A\right)  }  &  :\mathcal{F}%
\longrightarrow\mathcal{F}\\
\widetilde{\operatorname*{Adj}\left(  A\right)  }\left(  B\right)   &
=\widehat{A}BA^{-1}.
\end{align}

\end{definition}

\begin{example}
Let $x$ and $v$ belong to $\mathcal{F}_{1}$
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x\right)  }v=\widehat{x}vx^{-1}=-xvx=v,
\end{equation}
where
\begin{equation}
x^{2}=I_{\mathcal{F}}.
\end{equation}

\end{example}

\begin{lemma}
The \emph{Twisted Adjoint map }is a \emph{NOT}\ an algebra mapping as
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x\right)  }\left(  BC\right)
=\widehat{x}BCx^{-1}=\widehat{x}BCx=-xBCx.
\end{equation}
and
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x\right)  }\left(  B\right)
\widetilde{\operatorname*{Adj}\left(  x\right)  }\left(  C\right)
=\widehat{x}Bx^{-1}\widehat{x}Cx^{-1}=\widehat{x}Bx\widehat{x}Cx=xBxxCx=xBCx.
\end{equation}
resulting in
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x\right)  }\left(  BC\right)
\neq\widetilde{\operatorname*{Adj}\left(  x\right)  }\left(  B\right)
\widetilde{\operatorname*{Adj}\left(  x\right)  }\left(  C\right)  .
\end{equation}

\end{lemma}

\begin{lemma}
The twisted adjoint $\widetilde{\operatorname*{Adj}}$ from any group $G$
\begin{equation}
\widetilde{\operatorname*{Adj}}:G\rightarrow\mathcal{B}\left(  \mathcal{F}%
\right)
\end{equation}
\emph{is a group representation (i.e. a homomorpism) }i.e.
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  AB\right)
=\widetilde{\operatorname*{Adj}}\left(  A\right)  \circ
\widetilde{\operatorname*{Adj}}\left(  B\right)  ,
\end{equation}
which can be seen from%
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x_{1}\cdots x_{k}\right)  }%
\widetilde{\operatorname*{Adj}\left(  y_{1}\cdots y_{l}\right)  }\left(
C\right)  =\widehat{x_{1}\cdots x_{k}}\widehat{y_{1}\cdots y_{l}}C\left(
y_{1}\cdots y_{l}\right)  ^{-1}\left(  x_{1}\cdots x_{k}\right)  ^{-1}=\left(
-1\right)  ^{k+l}\left(  x_{1}\cdots x_{k}y_{1}\cdots y_{l}\right)  C\left(
y_{1}\cdots y_{l}\right)  ^{-1}\left(  x_{1}\cdots x_{k}\right)  ^{-1}%
\end{equation}
and%
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  x_{1}\cdots x_{k}y_{1}\cdots
y_{l}\right)  \left(  C\right)  =\widehat{\left(  x_{1}\cdots x_{k}y_{1}\cdots
y_{l}\right)  }C\left(  x_{1}\cdots x_{k}y_{1}\cdots y_{l}\right)
^{-1}=\left(  -1\right)  ^{k+l}\left(  x_{1}\cdots x_{k}y_{1}\cdots
y_{l}\right)  C\left(  x_{1}\cdots x_{k}y_{1}\cdots y_{l}\right)  ^{-1}.
\end{equation}

\end{lemma}

\begin{remark}
In order to obtain a proper treatment of $Pin\left(  \mathcal{F}%
,\mathbb{R}\right)  $ one must use the twisted representation
$\widetilde{\operatorname*{Adj}}.$
\end{remark}

\subsubsection{Clifford Groups}

The \emph{Clifford }group action is defined as
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  A\right)  \left(  v\right)
=\widehat{A}vA^{-1}%
\end{equation}
and the \emph{Clifford }group $\mathcal{CG}\left(  \mathcal{F}\right)  $ by
\begin{equation}
\mathcal{CG}\left(  \mathcal{F}\right)  =\left\{  \left.  A\in\mathcal{F\,}%
\right\vert \,\widetilde{\operatorname*{Adj}}\left(  A\right)  :\mathcal{F}%
_{1}\longrightarrow\mathcal{F}_{1}\right\}  .
\end{equation}


\begin{remark}
As $\mathcal{CG}\left(  \mathcal{F}\right)  $ is a group it must contain the
identity element $I_{\mathcal{F}}\in\mathcal{F}_{0}$
\end{remark}

\subsubsection{Pin and Spin Groups}

If $A\in\mathcal{CG}\left(  \mathcal{F}\right)  $ is a versor that is product
of normalized linearly independent vectors i.e.
\begin{equation}
A=v_{1}\cdots v_{k},\,v_{j}\in\mathcal{F}_{1},v_{j}^{2}=I_{\mathcal{F}},1\leq
j\leq2r
\end{equation}
then as
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  A\right)  :\mathcal{F}_{1}%
\longrightarrow\mathcal{F}_{1}%
\end{equation}
one has
\begin{gather}
AA^{t}=I_{\mathcal{F}}\ \\
\Downarrow\\
A\in O\left(  \mathcal{F}_{1},\mathbb{C}\right)  \cong O\left(  2r,\mathbb{C}%
\right)  .
\end{gather}


\begin{remark}
$O\left(  2r,\mathbb{C}\right)  $ has \emph{two components} distinguished by
the determinant, which is equal to $\pm1$.
\end{remark}

This observation gives rise to the following important subgroups of the
Clifford group:

\subparagraph{Pin Group}

The orthogonal group $O\left(  \mathcal{F}_{1},\mathbb{C}\right)  \cong
O\left(  2r,\mathbb{C}\right)  $ is constituted by reflections and rotations
of $\mathcal{F}_{1}$%

\begin{equation}
O\left(  \mathcal{F}_{1},\mathbb{C}\right)  =\left\{  \left.  A=v_{1}\cdots
v_{k}\right\vert \left\Vert v_{j}\right\Vert =1,v_{j}\in\mathcal{F}_{1}%
,A\in\mathcal{CG}\left(  \mathcal{F}\right)  ,\left\Vert A\right\Vert
=1\right\}
\end{equation}
The covering group of the group $O\left(  \mathcal{F}_{1},\mathbb{C}\right)  $
(a double cover), is the \emph{group }$\operatorname*{Pin}\left(
\mathcal{F},\mathbb{C}\right)  $\emph{,} which is constructed by using the
twisted adjoint operation%
\begin{equation}
\widetilde{\operatorname*{Adj}}:O\left(  \mathcal{F}_{1},\mathbb{C}\right)
\rightarrow\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{C}\right)
\end{equation}
producing maps
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  O\left(  \mathcal{F}_{1},\mathbb{C}%
\right)  \right)  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}%
\end{equation}
defined by
\begin{equation}
\left(  \widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots v_{k}\right)
\right)  \left(  x_{j}\right)  =\widehat{\left(  v_{1}\cdots v_{k}\right)
}x_{j}\left(  v_{1}\cdots v_{k}\right)  ^{t};\,1\leq j\leq2r,
\end{equation}
where $\left\{  \left.  x_{j}\right\vert \,1\leq j\leq2r\right\}  $ is a basis
of $\mathcal{F}_{1}.$

$\operatorname*{Pin}\left(  \mathcal{F},\mathbb{C}\right)  $ is a double cover
as
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  \pm v_{1}\cdots v_{k}\right)
=\widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots v_{k}\right)  ;\forall
v_{1}\cdots v_{k}.
\end{equation}
$\lceil$%
\begin{align}
e^{2i\theta}  &  =1=\cos\theta+i\sin\theta\\
&  \Downarrow\\
\theta &  =0\rightarrow\cos\theta=1\&\sin\theta=0\rightarrow e^{0}=1\\
\theta &  =\pi\rightarrow\cos\theta=-1\&\sin\theta=0\rightarrow e^{2i\pi}=-1\\
\theta &  =2\pi\rightarrow\cos\theta=1\&\sin\theta=0\rightarrow e^{4i\pi}=1
\end{align}
hence
\begin{equation}
\widetilde{\operatorname*{Adj}}\left(  re^{i\theta}v_{1}\cdots v_{k}\right)
=\widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots v_{k}\right)  ;\forall
v_{1}\cdots v_{k},
\end{equation}
when
\begin{align}
r  &  =1\\
\theta &  =0,2\pi.
\end{align}
$\rfloor$

The action of $\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{C}\right)  $
can be extended to $\mathcal{B}\left(  \mathcal{F}\right)  $ as $\mathcal{F}%
=\wedge\left(  \mathcal{F}_{1}\right)  $ by
\begin{equation}
\boxtimes\left(  \widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots
v_{k}\right)  \right)  =\bigoplus\limits_{0\leq n\leq2r}\boxtimes^{n}\left(
\widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots v_{k}\right)  \right)  .
\end{equation}
In this case one can easily see that the extension is in fact the same mapping
i.e.
\begin{equation}
\boxtimes\left(  \widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots
v_{k}\right)  \right)  \left(  A\right)  =\left(
\widetilde{\operatorname*{Adj}}\left(  v_{1}\cdots v_{k}\right)  \right)
\left(  A\right)  =\widehat{\left(  v_{1}\cdots v_{k}\right)  }A\left(
v_{1}\cdots v_{k}\right)  ^{t}.
\end{equation}


\begin{remark}
In general the map from the group $\operatorname*{Pin}\left(  \mathcal{F}%
_{1},\mathbb{R}\right)  $ associated with an indefinite metric to the
orthogonal group of indefinite metric \emph{is not onto nor is }%
$\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ \emph{a
universal covering space}, but if the quadratic form is definite (and the
dimension is greater than $2$), it is both. Hence the map from
$\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{C}\right)  $ to $O\left(
\mathcal{F}_{1},\mathbb{R}\right)  $ is the universal cover and onto.
\end{remark}

\begin{remark}
The group $\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{C}\right)  $ is
a \emph{double cover} of the complex orthogonal group $O\left(  \mathcal{F}%
_{1},\mathbb{C}\right)  \cong O\left(  2r,\mathbb{C}\right)  $ and the group
$\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ is a double
cover of the real orthogonal group $O\left(  \mathcal{F}_{1},\mathbb{R}%
\right)  \cong O\left(  2r,\mathbb{R}\right)  .$
\end{remark}

\subparagraph{Spin Group}

The subgroup of $\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{C}\right)
,$ the spin group $\operatorname*{Spin}\left(  \mathcal{F}_{1},\mathbb{C}%
\right)  ,$ is defined as%

\begin{equation}
\operatorname*{Spin}\left(  \mathcal{F}_{1},\mathbb{C}\right)  =\left\{
\left.  A\in\operatorname*{Pin}\left(  \mathcal{F}_{1},\mathbb{C}\right)
\right\vert A\in\mathcal{F}_{even}\right\}  .
\end{equation}


\begin{remark}
The twisted adjoint map coincides with the adjoint map when they are
restricted to the Clifford even subalgebra.
\end{remark}

The exponential maps from the Lie algebras $o\left(  \mathcal{F}%
_{1},\mathbb{C}\right)  $ and $so\left(  \mathcal{F}_{1},\mathbb{C}\right)  $
are mapped to the Lie groups $O\left(  \mathcal{F}_{1},\mathbb{C}\right)  $
and $SO\left(  \mathcal{F}_{1},\mathbb{C}\right)  $ i.e.
\begin{align}
\exp &  :o\left(  \mathcal{F}_{1},\mathbb{C}\right)  \rightarrow O\left(
\mathcal{F}_{1},\mathbb{C}\right) \\
\exp &  :so\left(  \mathcal{F}_{1},\mathbb{C}\right)  \rightarrow SO\left(
\mathcal{F}_{1},\mathbb{C}\right)  ,
\end{align}
given by
\begin{align}
\exp\left\{  \alpha_{0}I+\sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}
&  =\exp\left\{  \alpha_{0}I\right\}  \exp\left\{  \sum_{1\leq j<k\leq
2r}\alpha_{jk}x_{j}x_{k}\right\}  =\exp\left\{  \alpha_{0}\right\}
\exp\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\} \\
&  =r_{0}e^{i\theta_{0}}\exp\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}%
x_{j}x_{k}\right\}  ,
\end{align}
where
\begin{equation}
\det\left\{  r_{0}e^{i\theta_{0}}\exp\left\{  \sum_{1\leq j<k\leq2r}%
\alpha_{jk}x_{j}x_{k}\right\}  \right\}  =r_{0}e^{i\theta_{0}}%
\end{equation}
and
\begin{equation}
\exp\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}  \in
SO\left(  \mathcal{F}_{1},\mathbb{C}\right)  ,
\end{equation}
where
\begin{equation}
\det\left\{  \exp\left\{  \sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}
\right\}  =\exp\left\{  \operatorname{Tr}\left\{  \sum_{1\leq j<k\leq2r}%
\alpha_{jk}x_{j}x_{k}\right\}  \right\}  =1.
\end{equation}


\begin{lemma}
One can always find $\left\{  \left.  v_{j}\in\mathcal{F}_{1}\right\vert 1\leq
j\leq k\right\}  $ such that
\begin{equation}
\exp\left\{  \alpha_{0}I+\sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\right\}
=v_{1}\cdots v_{k},
\end{equation}
which is essentially representing rotations in the terms of reflections,
\underline{\emph{but not}} vice-versa.
\end{lemma}

\subsubsection{Groups Generated by $\mathcal{F}_{2}$}

\paragraph{Pin and Spin Groups}

The \emph{Pin} group is generated by arbitary products of normalized vectors
belonging to $\mathcal{F}_{1}$ (producing reflections) and the Spin group by
arbitary even products of normalized vectors belonging to $\mathcal{F}_{1}$
and can be generated by geminal operators $g\in\mathcal{F}_{2}.$ $e^{g}$ only
contains powers of $\left\{  x_{j}x_{k}\right\}  $ that produce only even
powers of $\left\{  x_{j}\right\}  $ so that
\begin{equation}
\widehat{e^{g}}=e^{g}%
\end{equation}
and adjoint representations and twisted adjoint representations of groups
produced by Lie algebras contained in $\mathcal{F}_{2}$ are identical.

\begin{remark}
The group $Pin\left(  2r,\mathbb{R}\right)  $ is the double cover of $O\left(
2r,\mathbb{R}\right)  .$
\end{remark}

\begin{remark}
$Spin\left(  2r,\mathbb{R}\right)  $ is generated by exponentials of real
geminal operators.
\end{remark}

Some properties and definitions of group elements and group generators of
$SO\left(  2r,\mathbb{R}\right)  $ associated with the adjoint representation
$\vartheta$ are
\begin{align}
\vartheta\left(  e^{g}\right)   &  :\mathcal{F}\longrightarrow\mathcal{F}\\
\vartheta\left(  e^{g}\right)   &  =e^{\operatorname{adj}\left(  g\right)
}=\operatorname*{Adj}\left(  e^{g}\right) \\
\vartheta\left(  e^{g}\right)  \left(  A\right)   &  =e^{g}Ae^{-g}\\
\operatorname{adj}\left(  g\right)  \left(  A\right)   &  =\left[  g,A\right]
\\
e^{g}\left(  e^{g}\right)  ^{t}  &  =\left(  e^{g}\right)  ^{t}e^{g}%
=I_{\mathcal{F}}\\
\left(  e^{g}\right)  ^{t}  &  =e^{-g}=e^{g^{t}},
\end{align}
where
\begin{equation}
g=%
%TCIMACRO{\tsum \limits_{1\leq j_{1}<j_{2}\leq2r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j_{1}<j_{2}\leq2r}}
%EndExpansion
\mathcal{R}_{x}\left(  g\right)  _{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}%
;\,\mathcal{R}_{x}\left(  g\right)  _{j_{1}j_{2}}\in\mathbb{R},
\end{equation}
i.e.
\begin{equation}
g=\left(  x_{1}x_{2},\cdots,x_{j_{1}}x_{j_{2}},\cdots,x_{2r-1}x_{2r}\right)
\mathcal{R}_{x}\left(  g\right)  =\left(  \mathbf{x}_{2}\right)
\mathcal{R}_{x}\left(  g\right)  ,g\in\mathcal{F}_{2}.
\end{equation}


\begin{remark}%
\begin{equation}
\mathcal{R}_{x}\left(  \Xi\left(  g\right)  \right)  _{jk}=\mathcal{R}%
_{x}\left(  g\right)  _{jk}.
\end{equation}

\end{remark}

The preceding expression is a special case of the representation relationship
that is valid for any element of $\mathcal{F}$ i.e.
\begin{equation}
A=\left(  \mathbf{x}_{0},\mathbf{x}_{1},\cdots,\mathbf{x}_{2r}\right)
\mathcal{R}_{\mathbf{x}}\left(  A\right)  .
\end{equation}


The Spin group $Spin\left(  2r,\mathbb{R}\right)  ,$which is the double cover
of $SO\left(  2r,\mathbb{R}\right)  $ acts on $\mathcal{F}_{1}$ in the
following manner
\begin{equation}
\operatorname*{Adj}\left(  e^{g}\right)  \left(  x_{k}\right)
=e^{\operatorname{adj}\left(  g\right)  }\left(  x_{k}\right)  =e^{g}%
x_{k}e^{-g}=\sum_{1\leq j\leq2r}x_{j}\left(  e^{\mathcal{R}_{x}\left(
g\right)  }\right)  _{jk}=\sum_{1\leq j\leq2r}x_{j}\mathcal{R}_{\mathbf{x}%
_{1}}\left(  \Xi\left(  e^{g}\right)  \right)  _{jk}=\widetilde{x}_{k},
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{\mathbf{x}_{1}}\left(  \Xi\left(  e^{g}\right)  \right)
_{jk}=\left(  e^{\mathcal{R}_{x}\left(  g\right)  }\right)  _{jk},
\end{equation}
thus for $k_{1}<\cdots<k_{m}$ one has
\begin{align}
\left(  \boxtimes^{m}\operatorname*{Adj}\left(  e^{g}\right)  \right)  \left(
x_{k_{1}}\cdots x_{k_{m}}\right)   &  =\left(  \boxtimes^{m}%
\operatorname*{Adj}\left(  e^{g}\right)  \right)  \left(  x_{k_{1}}%
\wedge\cdots\wedge x_{k_{m}}\right)  =\left(  \operatorname*{Adj}\left(
e^{g}\right)  \left(  x_{k_{1}}\right)  \right)  \wedge\cdots\wedge\left(
\operatorname*{Adj}\left(  e^{g}\right)  \left(  x_{k_{m}}\right)  \right) \\
&  =e^{g}x_{k_{1}}e^{-g}\wedge\cdots\wedge e^{g}x_{k_{m}}e^{-g}=e^{g}x_{k_{1}%
}e^{-g}e^{g}x_{k_{2}}e^{-g}\cdots e^{g}x_{k_{m-1}}e^{-g}e^{g}x_{k_{m}}e^{-g}\\
&  =e^{g}x_{k_{1}}x_{k_{2}}\cdots x_{k_{m-1}}x_{k_{m}}e^{-g},
\end{align}
which extends its action to all of $\mathcal{F}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathcal{F}_{1}.$

The \emph{Pin group, }$Pin\left(  2r,\mathbb{R}\right)  ,$ acts on
$\mathcal{F}_{1}$ in the following manner
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x_{k_{1}}\cdots x_{k_{m}}\right)
}\left(  x_{k}\right)  =\widehat{x_{k_{1}}\cdots x_{k_{m}}}\left(
x_{k}\right)  \left(  x_{k_{1}}\cdots x_{k_{m}}\right)  ^{-1}=\sum_{1\leq
j\leq2r}x_{j}\mathcal{R}_{\mathbf{x}_{1}}\left(
\widetilde{\operatorname*{Adj}\left(  x_{k_{1}}\cdots x_{k_{m}}\right)
}\right)  _{jk}=\widetilde{x}_{k}%
\end{equation}
and includes reflections that are not rotations.

\begin{remark}
Are basis transformations
\begin{equation}
\Upsilon:\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}%
\end{equation}
algebra maps? i.e. do the following relationships hold?
\begin{align}
\Upsilon\left(  XY\right)   &  =\Upsilon\left(  X\right)  \Upsilon\left(
Y\right) \\
\Upsilon\left(  X\boxtimes Y\right)   &  =\Upsilon\left(  X\right)
\boxtimes\Upsilon\left(  Y\right)
\end{align}

\end{remark}

\begin{remark}
If $\Upsilon$ is \emph{inner} i.e.
\begin{equation}
\Upsilon\left(  X\right)  =tXt^{-1}%
\end{equation}
then
\begin{equation}
\Upsilon\left(  XY\right)  =tXt^{-1}tYt^{-1}=tXYt^{-1},
\end{equation}
and thus in the case $\Upsilon$ is algebraic.
\end{remark}

\begin{remark}
As inner maps $\Upsilon$ are linear it can be shown that they can be extended
to algebraic maps (but not necessarily $c^{\ast}$-algebra or Clifford algebra
maps) to all of $\mathcal{F}$ i.e.
\begin{align}
\Upsilon\left(  XY\right)   &  =\Upsilon\left(  X\right)  \Upsilon\left(
Y\right) \\
\Upsilon\left(  X\boxtimes Y\right)   &  =\Upsilon\left(  X\right)
\boxtimes\Upsilon\left(  Y\right)  .
\end{align}

\end{remark}

\begin{remark}
The twisted adjoint maps \underline{\emph{do not}} produces algebraic maps
i.e. in general
\begin{equation}
\widetilde{\operatorname*{Adj}\left(  x_{k_{1}}\cdots x_{k_{m}}\right)
}\left(  XY\right)  \neq\widetilde{\operatorname*{Adj}\left(  x_{k_{1}}\cdots
x_{k_{m}}\right)  }\left(  X\right)  \widetilde{\operatorname*{Adj}\left(
x_{k_{1}}\cdots x_{k_{m}}\right)  }\left(  Y\right)  .
\end{equation}

\end{remark}

\begin{remark}
In finite dimensions let $\Upsilon\in GL\left(  \mathcal{F}_{1}\right)
\subset GL\left(  \mathcal{F}\right)  $ then $\Upsilon\in\operatorname*{Inn}%
\left\{  \mathcal{F}\right\}  $ i.e.$\Upsilon\left(  X\right)  =tXt^{-1}%
,\,t\in\mathcal{F}.$

\begin{enumerate}
\item If $\Upsilon$ $\in Pin\left(  \mathcal{F}_{1},\mathbb{C}\right)  \cong
Pin\left(  2r,\mathbb{C}\right)  $ i.e. $t\in O\left(  2r,\mathbb{C}\right)  $
it is an algebra map, a Clifford algebra map -as the Clifford inner product
$\left(  \left.  {}\right\vert \right)  $ \emph{is conserved}, but
\underline{\emph{not }}\emph{in general} a $c^{\ast}$-algebra map

\item If $\Upsilon\in Pin\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ i.e.
$t\in O\left(  2r,\mathbb{R}\right)  $ then $\Upsilon$ is an algebra map, a
Clifford algebra map \emph{and a} $c^{\ast}$-algebra map and produces a
\emph{canonical transformation}.

\item If $\Upsilon\in Spin\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ i.e.
$t\in SO\left(  2r,\mathbb{C}\right)  \cong\exp\left(  \mathcal{F}_{2}\right)
$ then

\begin{enumerate}
\item If $t\in SO\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ then
$\Upsilon\in Spin\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ is a $c^{\ast}%
$-algebra map, a Clifford algebra map and produces a canonical transformation.

\item If $t\notin SO\left(  \mathcal{F}_{1},\mathbb{R}\right)  $ then
$\Upsilon\in Spin\left(  \mathcal{F}_{1},\mathbb{C}\right)  $ is an algebra
map and a Clifford algebra map \emph{but not} a $c^{\ast}$-algebra map and
\emph{does not} produces a canonical transformation.
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{lemma}
\`{I}f $\digamma\in U\left(  \mathcal{F}_{1}\right)  \cong U\left(  2r\right)
$ but $\notin Pin\left(  \mathcal{F}_{1}\right)  $ then
\begin{equation}
\digamma\left(  X_{1}\right)  =\sum_{0\leq j\leq r}Y_{j};Y_{j}\neq0\text{ for
some }j>1
\end{equation}

\end{lemma}

\begin{lemma}
If $r<\infty$ then
\begin{equation}
\digamma\left(  X_{1}\right)  =uX_{1}u^{\dagger},
\end{equation}
where
\begin{equation}
u\in U\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}

\end{lemma}

\begin{corollary}
Such $\digamma^{\prime}s$ maintain the CAR.
\end{corollary}

\begin{lemma}
Let $u\in U\left(  \mathcal{H}_{\mathcal{F}}\right)  \cong U\left(
2^{r}\right)  $ then
\begin{align}
\widehat{u}\left(  \mathbf{a}^{\dagger}\right)   &  =u\mathbf{a}^{\dagger
}u^{\dagger}\\
\widehat{u}\left(  \mathbf{a}\right)   &  =u\mathbf{a}u^{\dagger}%
\end{align}
satisfy the CAR and $\widehat{u}$ is $c^{\ast}$-algebra map i.e. is CAR
algebra map.
\end{lemma}

\begin{corollary}
If $\mathcal{F}$ is a CAR algebra then $\widehat{u}\left(  \mathcal{F}\right)
$ is a CAR algebra.
\end{corollary}

\begin{lemma}
If $u\in O\left(  \mathcal{H}_{\mathcal{F}\mathbb{R}}\right)  \cong O\left(
2^{r+1},\mathbb{R}\right)  $ then $\widehat{u}$ is a Clifford algebra map as
well as $c^{\ast}$-algebra map.
\end{lemma}

\begin{remark}
\emph{In general }$\Upsilon\in GL\left(  \mathcal{F}_{1}\right)  $ are
algebraic thus conserve \emph{exterior products }but \emph{do not} in general
conserve Clifford products.
\end{remark}

\begin{remark}
In particular for $SO(2r,\mathbb{R})$ and $Spin(2r,\mathbb{R})$ the action of
$\widehat{u}\left(  g\right)  \equiv\vartheta\left(  e^{g}\right)
=e^{\operatorname{adj}\left(  g\right)  }=\operatorname*{Adj}\left(
e^{g}\right)  \in\operatorname*{Inn}\left(  \mathcal{F}_{HS}\right)
\subset\mathcal{B}\left(  \mathcal{F}_{HS}\right)  $ can be expressed as
\begin{align}
\widehat{u}_{m}\left(  g\right)  \left(  x_{k_{1}}\cdots x_{k_{m}}\right)   &
=\,\overset{\text{m-times }}{\overbrace{\left(  \widehat{u}\left(  g\right)
\boxtimes\cdots\boxtimes\widehat{u}\left(  g\right)  \right)  }}x_{k_{1}%
}\wedge\cdots\wedge x_{k_{m}}\\
&  =\sum_{1\leq j_{1}j_{2}<\cdots<j_{m}\leq2r}x_{j_{1}}\wedge\cdots\wedge
x_{j_{m}}\left(  \mathcal{R}_{\mathbf{x}_{1}}\left(  \widehat{u}\left(
g\right)  \right)  \boxtimes\cdots\boxtimes\mathcal{R}_{\mathbf{x}_{1}}\left(
\widehat{u}\left(  g\right)  \right)  \right)  _{j_{1}\cdots j_{m}k_{1}\cdots
k_{m}}%
\end{align}
and \emph{we have the remarkable identity}
\begin{equation}
e^{g}x_{k_{1}}x_{k_{2}}\cdots x_{k_{m-1}}x_{k_{m}}e^{-g}=\sum_{1\leq
j_{1}j_{2}<\cdots<j_{m}\leq2r}x_{j_{1}}\wedge\cdots\wedge x_{j_{m}}\left(
e^{\mathcal{R}_{x}\left(  g\right)  }\boxtimes\cdots\boxtimes e^{\mathcal{R}%
_{x}\left(  g\right)  }\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{m}};1\leq
k_{1}<k_{2}<\cdots<k_{m}\leq2r.
\end{equation}
This shows that $SO(2r,\mathbb{R})\subset\operatorname*{Inn}\left\{
\mathcal{F}\right\}  \subset\mathcal{B}\left(  \mathcal{F}_{HS}\right)  $ and
$%
%TCIMACRO{\tbigwedge ^{n}}%
%BeginExpansion
{\textstyle\bigwedge^{n}}
%EndExpansion
\mathcal{F}_{1}$ are invariant subspaces$.$
\end{remark}

\paragraph{Adjoint action of General Linear Group $GL(2r,\mathbb{C})$ on
$\mathcal{F}$}%

\begin{align}
\mathcal{T}  &  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1};\mathcal{T}\in
GL(2r,\mathbb{C})\\
\boxtimes\left(  \mathcal{T}\right)   &  :\mathcal{F}\rightarrow\mathcal{F}\\
\mathcal{T}\left(  x_{k}\right)   &  =\operatorname*{Adj}\left(  T\right)
\left(  x_{k}\right)  =\widehat{T}\left(  x_{k}\right)  =Tx_{k}T^{-1}=\sum
x_{j}\mathcal{R}_{\operatorname*{Adj}}\left(  \mathcal{T}\right)  _{jk}\\
Tx_{k}T^{-1}Tx_{l}T^{-1}  &  =Tx_{k}x_{l}T^{-1}%
\end{align}
so $\boxtimes\left(  \mathcal{T}\right)  $ is algebraic.

\emph{Note that }%
\begin{equation}
T\neq\exp\left\{  \sum_{1\leq j<k\leq2r}t_{jk}x_{j}x_{k}\right\}
\end{equation}
\emph{but }%
\begin{equation}
T=\exp\left\{  \sum_{0\leq n\leq2r}\sum_{1\leq j<k\leq2r}t_{nj_{1}\cdots
j_{n}}x_{j_{1}}\cdots x_{j_{n}}\right\}  ,
\end{equation}
\emph{however} $%
%TCIMACRO{\tbigwedge ^{n}}%
%BeginExpansion
{\textstyle\bigwedge^{n}}
%EndExpansion
\mathcal{F}_{1}$ are still invariant subspaces.

\begin{remark}
$\exp$ is \emph{surjective} from $gl\left(  \mathcal{H}_{\mathcal{F}}\right)
\rightarrow GL\left(  \mathcal{H}_{\mathcal{F}}\right)  $ (\emph{but not on
subgroups} in general)
\end{remark}

$\lceil$One can observe that%
\begin{align}
\left[  x_{k_{1}}\cdots x_{k_{m}},x_{j_{1}}\right]   &  =x_{k_{1}}\cdots
x_{k_{m}}x_{j_{1}}-x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}}=\left(  \left(
-1\right)  ^{m}-1\right)  x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}}\\
\left(  \left(  -1\right)  ^{1}-1\right)  x_{j_{1}}x_{k_{1}}  &  =-2x_{j_{1}%
}x_{k_{1}}\\
\left(  \left(  -1\right)  ^{2}-1\right)  x_{j_{1}}x_{k_{1}}x_{k_{2}}  &  =0,
\end{align}%
\begin{align}
\left[  x_{k_{1}}\cdots x_{k_{m}},\left[  x_{k_{1}}\cdots x_{k_{m}},x_{j_{1}%
}\cdots x_{j_{m}}\right]  \right]   &  =\left[  x_{k_{1}}\cdots x_{k_{m}%
},\left(  \left(  -1\right)  ^{m}-1\right)  x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}%
}\right] \\
&  =\left(  \left(  -1\right)  ^{m}-1\right)  x_{k_{1}}\cdots x_{k_{m}%
}x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}}-\left(  \left(  -1\right)  ^{m}-1\right)
x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}}x_{k_{1}}\cdots x_{k_{m}}\\
&  =\left(  \left(  -1\right)  ^{m}-1\right)  \left(  \left(  -1\right)
^{m}-1\right)  x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}}x_{k_{1}}\cdots x_{k_{m}}%
\end{align}
hence%
\begin{align}
x_{j_{1}}x_{k_{1}}x_{k_{1}}  &  =\left(  -1\right)  ^{0}x_{j_{1}}\\
x_{j_{1}}x_{k_{1}}x_{k_{2}}x_{k_{1}}x_{k_{2}}  &  =\left(  -1\right)
^{1}x_{j_{1}}\\
x_{j_{1}}x_{k_{1}}\cdots x_{k_{m}}x_{k_{1}}\cdots x_{k_{m}}  &  =\left(
-1\right)  ^{m-1}x_{j_{1}}.
\end{align}
$\rfloor$

\emph{Is every algebra automorphism an inner automorphism?} (true in finite
dimensions for matrix algebras---- \underline{\emph{Skolem-Noether's Theorem}})

$\lceil$What subgroup of $\operatorname*{Inn}\left\{  \mathcal{F}\right\}  $
is produced by the linear space formed by the generators of the
algebra?$\rfloor$

\begin{itemize}
\item Generators of an algebra produce a polynomial algebra,

\item Generators of a group produce the group by products, the linear algebra
generated by the group generators produces the group algebra. The Jacobi
identity for matrix algebras is trivially satisfied%
\begin{align}
\left[  A,\left[  B,C\right]  \right]  +\left[  B,\left[  C,A\right]  \right]
+\left[  C,\left[  A,B\right]  \right]   &  =0\\
\left[  A,\left(  BC-CB\right)  \right]  +\left[  B,\left(  CA-AC\right)
\right]  +\left[  C,\left(  AB-BA\right)  \right]   &  =0\\
ABC-ACB-BCA+CBA+BCA-BAC-CAB+ACB+CAB-CBA-ABC+BAC  &  =0
\end{align}
as $A,B,C$ belong to an associative algebra.
\end{itemize}

\begin{remark}
The Clifford group is produced by generators --can find generators that are
invertible (normalized) and ones that are not (nilpotent).
\end{remark}

\begin{remark}
Are all automorphisms of a $c^{\ast}$-algebra inner? (not in infinite dimensions)
\end{remark}

\begin{remark}
Inner automorphisms form a group. Are these groups Lie groups in
correspondence with tangent spaces contained in the algebra?
\end{remark}

\begin{remark}
Do invariance groups of subspaces formed by generators of an algebra
(including unit) belong to the Inner automorphism group. If they do and are
Lie groups they must contain higher order terms in exponents. The general
linear group $GL(2r,\mathbb{R})$ and thus the symplectic group
$Sp(2r,\mathbb{R})$ must be of this form.
\end{remark}

\paragraph{Group Properties of Complexifications}

In general the inverse of the complexification $J$ is given by
\begin{equation}
J^{-1}=-J
\end{equation}
and thus is also a complexification. $J^{t},$ is also an complexification.
\emph{The complexification }$J$\emph{ does not have to be antisymmetric i.e. }%
\begin{equation}
J\neq-J^{t},
\end{equation}
\emph{if it is i.e. }$J=-J^{t}$\emph{ then}
\begin{equation}
J^{t}J=JJ^{t}=I
\end{equation}
i.e. $J\in O(2r,\mathbb{R}).$ Complexifications are related to each other by
\begin{equation}
J_{S}=SJ_{S^{\prime}}S^{-1},
\end{equation}
which ensures that the complexification condition is always fulfilled as
\begin{equation}
J_{S}^{2}=SJ_{S^{\prime}}S^{-1}SJ_{S^{\prime}}S^{-1}=SJ_{S^{\prime}%
}J_{S^{\prime}}S^{-1}=-SS^{-1}=-I.
\end{equation}
This shows that $J_{S}$ and $J_{S^{\prime}}$ are in the same orbit for
arbitary $S$ and $S^{\prime}$ and at least in finite dimensions all
complexifications are in this orbit as
\begin{equation}
\widehat{S}\left(  A\right)  =SAS^{-1},S\in GL(2r,\mathbb{R})
\end{equation}
are algebra isomorphisms and the orbit is a \emph{homogeneous space} for
$GL(2r,\mathbb{R}),$ which acts \emph{transitively} in $V_{2r}$ but not in
$\mathcal{B}\left(  V_{2r}\right)  ,$ where $V_{2r}$ is real $2r$ dimensional
vector space i.e.
\begin{align}
GL(2r,\mathbb{R})  &  :\mathcal{B}\left(  V_{2r}\right)  \rightarrow
\mathcal{B}\left(  V_{2r}\right) \\
\widehat{S}\left(  A\right)   &  =SAS^{-1};A\in\mathcal{B}\left(
V_{2r}\right) \\
\ker\left(  \widehat{S}\right)   &  =\phi.
\end{align}
\emph{All algebra isomorphisms in finite dimensions are inner }$\left[
\text{\emph{Skolem-Noether theorem}}\right]  $.

The set of inner transformations that leave a complexification $J$ fixed i.e.
\begin{equation}
G_{J}=SJS^{-1}=J
\end{equation}
form a subgroup of $GL(2r,\mathbb{R}).$ It is easy to see that
\begin{equation}
G_{J}\cong G_{J^{\prime}}\forall J,J^{\prime}.
\end{equation}
One can consider the homogeneous space formed by the coset
\begin{equation}
C_{J}=\frac{GL(2r,\mathbb{R})}{G_{J}}%
\end{equation}
$\lceil$%
\begin{equation}
GL(r,\mathbb{C})=\{g\in GL(2n,R)|gJg^{-1}=J\}
\end{equation}
$\rfloor$

If $J$ is antisymmetric then
\begin{align}
\left(  gJg^{-1}\right)  ^{t}  &  =J^{t}=-J\\
&  =g^{-t}J^{t}g^{t}=-gJg^{-1},
\end{align}
which gives%
\begin{gather}
g^{-t}Jg^{t}=gJg^{-1}\\
\Updownarrow\\
J=g^{t}gJg^{-1}g^{-t}=\left(  g^{t}g\right)  J\left(  g^{t}g\right)  ^{-1}.
\end{gather}


The symplectic group is defined by
\begin{equation}
Sp(2r,\mathbb{R})=\left\{  \left.  T\in GL(2r,\mathbb{R})\right\vert
TJT^{t}=J,J=-J^{t},J^{2}=-I\right\}  .
\end{equation}


$\lceil$It can be observed that such antisymmetric complexifications have the
property:
\begin{equation}
JJJ^{t}=-J^{t}=J
\end{equation}
so $J$ $\in Sp(2r,\mathbb{R})$.

As%
\begin{equation}
-JJ=J^{t}J=I
\end{equation}
$J$ $\in O(2r,\mathbb{R}),$ hence $J\in U\left(  r\right)  .\rfloor ZZZZ$

If $T\in$ $Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R})=U\left(  r\right)  $ then
\begin{align}
J  &  =TJT^{t}\\
T^{t}T  &  =TT^{t}=I,\\
J^{2}  &  =-I
\end{align}
and $T$ induces a unitary transformation of the complex space produced by $J$
and wrt the corresponding inner product. \emph{Hence if }$J$\emph{ is
antisymmetric it is symplectic wrt to itself and orthogonal thus it induces a
unitary transformation of the complex space produced by }$J,$ \emph{and the
unitary transformation is multiplication by the imaginary unit }$i$ as
\begin{align}
JJ^{t}  &  =I\\
JJJ^{t}  &  =J.
\end{align}


The various possibilities are:

\begin{enumerate}
\item If $T\notin O(2r,\mathbb{R})$ but $\in Sp(2r,\mathbb{R})$ then
\begin{align}
J  &  =TJT^{t}\\
J^{2}  &  =TJT^{t}TJT^{t}=-I\\
TT^{t}  &  \neq I;T^{t}T\neq I\\
J^{t}  &  =TJ^{t}T^{t}\Leftrightarrow J=TJT^{t}.
\end{align}


\item If $T\in O(2r,\mathbb{R})$ but $\notin Sp(2r,\mathbb{R})$ i.e. $T\in$
$\frac{O(2r,\mathbb{R})}{Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R})}%
=\frac{O(2r,\mathbb{R})}{U\left(  r\right)  }$ then
\begin{align}
J  &  \neq TJT^{t}=J_{T}\\
T^{t}T  &  =TT^{t}=I\\
TJT^{t}TJT^{t}  &  =TJ^{2}T^{t}=-TT^{t}=-I=J_{T}^{2}\\
J_{T}^{t}  &  =T^{t}J^{t}T=-J_{T},
\end{align}
thus $J_{T}$ is a new antisymmetric complexification.
\end{enumerate}

In the two preceeding cases $T$ does not induce a unitary transformation of
the complex space produced by $J$ and the corresponding inner product, thus
the \emph{complex spaces are unitarily inequivalent}.

$\lceil$One can also wonder what happens in the case $T\notin$
$Sp(2r,\mathbb{R})$ and $T\notin O(2r,\mathbb{R})$
\begin{equation}
J\neq TJT^{t}=J_{T};T\in GL(2r,\mathbb{R}).
\end{equation}
When is such a $J_{T}$ a complexification i.e.

\begin{enumerate}
\item
\begin{equation}
J_{T}^{2}=TJT^{t}TJT^{t}=-I?
\end{equation}


\item
\begin{align}
JT^{t}TJ  &  =-T^{-1}T^{-t}\\
T^{t}TJ  &  =JT^{-1}T^{-t}=J\left(  T^{t}T\right)  ^{-1}%
\end{align}


\item
\begin{align}
TJT^{t}  &  =SJS^{-1}\\
S^{-1}TJT^{t}S  &  =J.
\end{align}
$\rfloor$
\end{enumerate}

One can consider the example
\begin{equation}
T=\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \in Sp\left(  2,\mathbb{R}\right)  ,
\end{equation}
i.e.%
\begin{equation}
\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 1\\
7 & 4
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
-7 & 2\\
-4 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 1\\
7 & 4
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  .
\end{equation}


The inverse of $T$ is given by
\begin{equation}
T^{-1}=\left(
\begin{array}
[c]{cc}%
4 & -7\\
-1 & 2
\end{array}
\right)  ,
\end{equation}
(which also $\in Sp\left(  2,\mathbb{R}\right)  ),$ so that
\begin{equation}
TT^{-1}=\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
4 & -7\\
-1 & 2
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  .
\end{equation}
The transformation $T$ is not orthogonal i.e.
\begin{equation}
T=\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \notin O\left(  2,\mathbb{R}\right)  ,
\end{equation}
which is demonstrated by
\begin{align}
\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  ^{t}  &  =\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 1\\
7 & 4
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
53 & 30\\
30 & 17
\end{array}
\right) \\
\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  ^{t}\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
2 & 1\\
7 & 4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
5 & 18\\
18 & 65
\end{array}
\right)  .
\end{align}
Hence
\begin{equation}
\left(
\begin{array}
[c]{cc}%
2 & 7\\
1 & 4
\end{array}
\right)  \notin Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R}).
\end{equation}


An example of a complexification that is not antisymmetric is produced by a
similiarity transformations of $\left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  $ e.g.
\begin{align}
\left(
\begin{array}
[c]{cc}%
2 & 0\\
0 & 4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{2} & 0\\
0 & \frac{1}{4}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
0 & 2\\
-4 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{2} & 0\\
0 & \frac{1}{4}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & \frac{1}{2}\\
-2 & 0
\end{array}
\right) \\
\left(
\begin{array}
[c]{cc}%
0 & \frac{1}{2}\\
-2 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & \frac{1}{2}\\
-2 & 0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
-1 & 0\\
0 & -1
\end{array}
\right) \\
\left(
\begin{array}
[c]{cc}%
0 & \frac{1}{2}\\
-2 & 0
\end{array}
\right)  ^{t}  &  \neq-\left(
\begin{array}
[c]{cc}%
0 & \frac{1}{2}\\
-2 & 0
\end{array}
\right)  .
\end{align}
$\lceil$%
\begin{equation}
SAS^{-1}SAS^{-1}=SA^{2}S^{-1}=-I=J^{2}%
\end{equation}
$\rfloor$

Let
\begin{equation}
J^{2}=-I,J=-J^{t}%
\end{equation}


and define
\begin{align}
J_{S}  &  =SJS^{-1}\\
J_{S}^{2}  &  =-I\\
J_{S}^{t}  &  =S^{-t}J^{t}S^{t}=-S^{-t}JS^{t}\neq-J_{S}=-SJS^{-1}\text{ unless
}S\in O(2r,\mathbb{R}),
\end{align}
i.e. if $S\notin O(2r,\mathbb{R})$ then $J_{S}$ is a non antisymmetric complexification.

\emph{In finite dimensions all algebra isomorphisms of $\mathcal{A}$ are inner
i.e. }$\in\operatorname*{Inn}\left(  \emph{\mathcal{A}}\right)  $ \emph{and
are similiarity transformations. Thus all isomorphisms are generated by the
set of invertible elements Inv}$\left(  \emph{\mathcal{A}}\right)  .$%

\begin{align}
h\left(  ab\right)   &  =h\left(  a\right)  h\left(  b\right) \\
h\left(  JJ\right)   &  =h\left(  J\right)  h\left(  J\right)  =h\left(
-I\right) \\
&  =h\left(  aa\right)  =h\left(  a\right)  h\left(  a\right)
\end{align}%
\begin{equation}
a=gbg^{-1}\Leftrightarrow ag=gb
\end{equation}


\begin{remark}
$N$ is a \emph{normal subgroup} of $G$ \emph{if it is left invariant} by
conjugation i.e.%
\begin{equation}
\widehat{g}\left(  N\right)  =gNg^{-1}\in N\quad\forall g\in G,
\end{equation}
$\widehat{g}$ is an isomorphism i.e. $1-1$ and onto.
\end{remark}

\begin{remark}
If $J^{2}=-I$ then $J_{g}$ $=\widehat{g}\left(  J\right)  $ also squares to
$-I.$
\end{remark}

\begin{theorem}
All complexifications, $J_{S},$ in even dimensionsal real vector spaces are
given by
\begin{equation}
J_{S}=SJS^{-1}%
\end{equation}
for some $J,$ where
\begin{equation}
J^{2}=-I,J=-J^{t},S\in GL(2r,\mathbb{R}).
\end{equation}

\end{theorem}

\begin{proof}
All isomorphisms of $\mathcal{B}\left(  V_{2r}\right)  $ are inner
$GL(2r,\mathbb{R})$ transformations and thus the orbit of any arbitary
complexifications $J$ contains all complexifications. $GL(2r,\mathbb{R})$ acts
transitively on such orbits. $\left(  \text{And form homogeneous
spaces.}\right)  $
\end{proof}

\begin{corollary}
All antisymmetric complexifications are given by
\begin{equation}
J=S^{-1}J_{S}S,
\end{equation}
where $J_{S}$ is not in general antisymmetric.
\end{corollary}

Let
\begin{equation}
J_{S}^{2}=-I
\end{equation}
and
\begin{equation}
J_{S}\neq SJS^{-1}%
\end{equation}
for any antisymmetric $J.$

\begin{itemize}
\item
\begin{equation}
J=S^{-1}J_{S}S=-J^{t}=-S^{t}J_{S}^{t}S^{-t}%
\end{equation}


\item
\begin{align}
S^{-1}J_{S}S  &  =-S^{t}J_{S}^{t}S^{-t}\\
J_{S}  &  =-SS^{t}J_{S}^{t}S^{-t}S^{-1}=-\left(  SS^{t}\right)  J_{S}%
^{t}\left(  SS^{t}\right)  ^{-1}%
\end{align}


\item
\begin{equation}
J_{S}^{-1}=-J_{S}%
\end{equation}


\item
\begin{align}
J_{S}^{-t}  &  =-J_{S}^{t}=-\left(  \left(  SS^{t}\right)  J_{S}^{t}\left(
SS^{t}\right)  ^{-1}\right)  ^{-t}=-\left(  SS^{t}\right)  J_{S}^{t}\left(
SS^{t}\right)  ^{-1}\\
J_{S}^{-1}  &  =-\left(  SS^{t}\right)  J_{S}\left(  SS^{t}\right)
^{-1}=-J_{S}.
\end{align}

\end{itemize}

Trivially
\begin{equation}
J^{2}=-I,J=-J^{t},S\in GL(2r,\mathbb{R})\Rightarrow J_{S}^{2}=-I.
\end{equation}


If $J_{S}^{2}=-I$ then
\begin{align}
\left(  S^{-1}J_{S}S\right)  ^{t}  &  =S^{t}J_{S}S^{-t}=J^{t}=-J=-S^{-1}%
J_{S}S\\
J_{S}  &  =-S^{-t}S^{-1}J_{S}SS^{t}=-\left(  SS^{t}\right)  ^{-1}J_{S}\left(
SS^{t}\right)
\end{align}


and%
\begin{equation}
J_{S}^{2}=-I\Leftrightarrow J_{S}^{t2}=-I.
\end{equation}


\begin{remark}
Consider%
\begin{equation}
\det\left(  J^{2}\right)  =\left(  -1\right)  ^{r}=\left(  \det\left(
J\right)  \right)  ^{2}%
\end{equation}
So if $r$ is even $\det\left(  J\right)  =\pm1,$ while if $r$ is odd $\left(
\det\left(  J\right)  \right)  ^{2}=-1.$
\end{remark}

\begin{theorem}
All antisymmetric complexifications are given by
\begin{equation}
J_{T}=TJT^{t}%
\end{equation}
for any antisymmetric fixed $J,$ where
\begin{equation}
T\in O(2r,\mathbb{R}),J=-J^{t},J^{2}=-I.
\end{equation}

\end{theorem}

\begin{proof}
All complexifications are given by
\begin{equation}
J_{T}=TJT^{-1},
\end{equation}
where $J$ is an antisymmetric complexification. Thus in particular if $J_{T}$
is antisymmetric
\begin{equation}
J_{T}=-J_{T}^{t}%
\end{equation}
one has
\begin{gather}
TJT^{-1}=-T^{-t}J^{t}T^{t}=T^{-t}JT^{t}\\
\Downarrow\\
J=-T^{-1}T^{-t}JT^{t}T=\left(  T^{t}T\right)  ^{-1}JT^{t}T
\end{gather}
i.e.
\begin{equation}
J=A^{-1}JA,
\end{equation}
where
\begin{equation}
A>0.
\end{equation}
Thus
\begin{equation}
\sum_{1\leq j\leq2r}\eta_{j}^{-1}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{j}\right\vert J\sum_{1\leq j\leq2r}\eta_{j}\left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{j}\right\vert =J;\quad\eta
_{j}>0
\end{equation}
hence
\begin{equation}
\sum_{1\leq j,k\leq2r}\eta_{j}\eta_{k}\left\langle \varphi_{j}\right\vert
J\left\vert \varphi_{k}\right\rangle \left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert =\sum_{1\leq j,k\leq2r}\left\langle
\varphi_{j}\right\vert J\left\vert \varphi_{k}\right\rangle \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert .
\end{equation}
As
\begin{align}
\eta_{j}\eta_{k}\left\langle \varphi_{j}\right\vert J\left\vert \varphi
_{k}\right\rangle \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert +\eta_{j}\eta_{k}\left\langle \varphi_{k}\right\vert
J\left\vert \varphi_{j}\right\rangle \left\vert \varphi_{k}\right\rangle
\left\langle \varphi_{j}\right\vert  &  =\eta_{j}\eta_{k}\left\langle
\varphi_{j}\right\vert J\left\vert \varphi_{k}\right\rangle \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert -\eta_{j}\eta
_{k}\left\langle \varphi_{j}\right\vert J\left\vert \varphi_{k}\right\rangle
\left\vert \varphi_{j}\right\rangle \left\vert \varphi_{k}\right\rangle
\left\langle \varphi_{j}\right\vert \\
&  =\eta_{j}\eta_{k}\left\langle \varphi_{j}\right\vert J\left\vert
\varphi_{k}\right\rangle \left(  \left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle
\left\langle \varphi_{j}\right\vert \right)
\end{align}
one has
\begin{equation}
\sum_{1\leq j,k\leq2r}\eta_{j}\eta_{k}\left\langle \varphi_{j}\right\vert
J\left\vert \varphi_{k}\right\rangle \left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert =\sum_{1\leq j<k\leq2r}\eta_{j}\eta
_{k}\left\langle \varphi_{j}\right\vert J\left\vert \varphi_{k}\right\rangle
\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{j}\right\vert \right)  =\sum_{1\leq j<k\leq2r}\left\langle \varphi
_{j}\right\vert J\left\vert \varphi_{k}\right\rangle \left(  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert -\left\vert
\varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)
\end{equation}
giving
\begin{align}
\left\langle \varphi_{j}\right\vert J\left\vert \varphi_{k}\right\rangle  &
=\eta_{j}\eta_{k}\left\langle \varphi_{j}\right\vert J\left\vert \varphi
_{k}\right\rangle \Rightarrow\eta_{j}\eta_{k}=1\forall j,k\\
&  \Rightarrow\eta_{j}=1;1\leq j\leq2r.
\end{align}
This is true for all antisymmetric $J,$ thus%
\begin{equation}
A=I.
\end{equation}
Hence%
\begin{align}
TJT^{-1}  &  =-T^{-t}JT^{t}\\
&  \Downarrow\\
T^{-1}  &  =T^{t}.
\end{align}

\end{proof}

\paragraph{Ket-Bra Operators (Nuclear Operators)}

\begin{remark}
One has
\begin{equation}
V\otimes V^{d}\cong\mathcal{B}\left(  V\right)
\end{equation}
and%
\begin{equation}
T:V\rightarrow V:T\in\mathcal{B}\left(  V\right)  ,
\end{equation}
where $V$ can be a Hilbert space.
\end{remark}

\begin{remark}
The standard embedding map from a Banach space $V$ with basis to its bilinear
dual $V^{d}$ via biorthogonality
\begin{equation}
\left\langle v_{j}^{d},v_{k}\right\rangle =\delta_{jk},\,1\leq j,k\leq r
\end{equation}
and is given by
\begin{equation}
D\left(  v\right)  =v^{d}=\sum_{1\leq j\leq r}\left\langle v_{j}%
^{d},v\right\rangle \left\langle v_{j}^{d}\right\vert ,
\end{equation}
where
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\langle v_{j}%
^{d},v\right\rangle \left\vert v_{j}\right\rangle =\sum_{1\leq j\leq
r}\mathcal{R}_{v}\left(  v\right)  _{j}\left\vert v_{j}\right\rangle .
\end{equation}
$D$ is complex linear i.e.
\begin{equation}
D\left(  \alpha_{1}v_{1}+\alpha_{2}v_{2}\right)  =\alpha_{1}v_{1}+\alpha
_{2}v_{2}.
\end{equation}
The duality is based on the bilinear form
\begin{equation}
\left\langle ,\right\rangle :V\times V\rightarrow\mathbb{C}.
\end{equation}

\end{remark}

\begin{remark}
If $V$ is a Hilbert space then one can construct another map from $V$ to its
bilinear dual $V^{d}$
\begin{equation}
H:V\rightarrow V^{d}%
\end{equation}
but now the duality is based on the sesquilinear form
\begin{equation}
\left\langle ,\right\rangle _{h}:V\times V\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\left\langle v,w\right\rangle _{h}=\left\langle \overline{v},w\right\rangle
\end{equation}
defined by the inner product $\left\langle \left.  v\right\vert w\right\rangle
$ in $V.$

$H$ is defined by
\begin{equation}
\left\langle H\left(  v\right)  ,w\right\rangle =\left\langle \left.
v\right\vert w\right\rangle ,\,\,v\in V,\,\forall w\in V,
\end{equation}
which gives%
\begin{equation}
H\left(  v\right)  =v^{h}=\sum_{1\leq j\leq r}\overline{\left\langle v_{j}%
^{h},v\right\rangle }\left\langle v_{j}^{h}\right\vert =\sum_{1\leq j\leq
r}\overline{\left\langle \left.  v_{j}\right\vert v\right\rangle }\left\langle
v_{j}^{h}\right\vert
\end{equation}
and%
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\langle H\left(
v_{j}\right)  ,v\right\rangle \left\vert v_{j}\right\rangle =\sum_{1\leq j\leq
r}\left\langle v_{j}^{h},v\right\rangle \left\vert v_{j}\right\rangle
=\sum_{1\leq j\leq r}\overline{\left\langle \left.  v_{j}\right\vert
v\right\rangle }\left\vert v_{j}\right\rangle =\sum_{1\leq j\leq r}%
\overline{\mathcal{R}_{v}\left(  v\right)  }_{j}\left\vert v_{j}\right\rangle
.
\end{equation}
$H$ is complex antilinear i.e.
\begin{equation}
H\left(  \alpha_{1}v_{1}+\alpha_{2}v_{2}\right)  =\overline{\alpha_{1}}%
v_{1}+\overline{\alpha_{2}}v_{2}%
\end{equation}
A\ biorthogonal basis is given by
\begin{equation}
\left\{  \left.  H\left(  v_{j}\right)  \right\vert 1\leq j\leq r\right\}  ,
\end{equation}
where
\begin{equation}
\left\langle H\left(  v_{j}\right)  ,v_{k}\right\rangle =\left\langle \left.
v_{j}\right\vert v_{k}\right\rangle \,=\delta_{jk},\,1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{definition}%
\begin{equation}
\mathcal{T}\left(  T\right)  \left(  \left\vert \varphi\right\rangle
\left\langle \psi\right\vert \right)  =\left\vert T\varphi\right\rangle
\left\langle T\psi\right\vert =T\left\vert \varphi\right\rangle \left\langle
\psi\right\vert T^{\dagger}=\left(  T\otimes T^{\dagger}\right)  \left\vert
\varphi\right\rangle \left\langle \psi\right\vert
\end{equation}
$\mathcal{T}$ is not an algebra morphism unless $T^{\dagger}=T^{-1}.$
\end{definition}

\begin{remark}%
\begin{equation}
\operatorname*{Range}\left\{  \mathcal{T}\right\}  =\operatorname*{linspan}%
\left\{  T\left\vert \varphi\right\rangle \left\langle \psi\right\vert
T^{\dagger}\right\}  .
\end{equation}

\end{remark}

One can consider the special case
\begin{equation}
T\in GL\left(  V\right)  .
\end{equation}
In general one has the following identities%
\begin{align}
\left(  T\otimes T\right)  \left(  \left\vert \varphi\right\rangle
\otimes\left\vert \psi\right\rangle \right)   &  \equiv\left(  T\otimes
T\right)  \left(  \left\vert \varphi\right\rangle \left\vert \psi\right\rangle
\right)  \equiv\left(  T\otimes T\right)  \left(  \left\vert \varphi
\otimes\psi\right\rangle \right)  =\left\vert T\varphi\otimes T\psi
\right\rangle \\
\left(  T\otimes T^{\dagger}\right)  \left(  \left\vert \varphi\right\rangle
\otimes\left\langle \psi\right\vert \right)   &  =\left(  T\otimes T^{\dagger
}\right)  \left(  \left\vert \varphi\right\rangle \left\langle \psi\right\vert
\right)  =\left\vert T\varphi\right\rangle \left\langle T\psi\right\vert
=T\left\vert \varphi\right\rangle \left\langle \psi\right\vert T^{\dagger}\\
\left(  T\otimes T\right)   &  \in\mathcal{B}\left(  V\otimes V\right)
;\,\left(  T\otimes T^{\dagger}\right)  \in\mathcal{B}\left(  V\otimes
V^{d}\right)  ;\,T^{d}=T^{\dagger};\,T\in\mathcal{B}\left(  V\right)
;\,T^{d}\in\mathcal{B}\left(  V^{d}\right) \\
T^{d}\left(  \psi^{d}\right)   &  =\left\langle \psi\right\vert T^{\dagger}\\
\left(  T\otimes T^{\dagger}\right)   &  \in\mathcal{B}\left(  V\otimes
V^{d}\right)  =\mathcal{B}\left(  \mathcal{B}\left(  V\right)  \right)  .
\end{align}
$\left[  \text{Can any element of }\mathcal{B}\left(  V\otimes V^{d}\right)
\text{ be expressed as }\left(  T\otimes T^{\dagger}\right)  \text{ if }T\in
GL\left(  V\right)  ?\right]  $

Not all bases of $\mathcal{B}\left(  V\otimes V^{d}\right)  $ are of the form
$\left\{  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert \right\}  $ some might be of the form $\left\{  \sum
\limits_{1\leq j,k\leq2r}\lambda_{jk}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert \right\}  ,$ i.e. $\left\{  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert \pm\left\vert
\varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right\}  ,$ so that

\begin{enumerate}
\item
\begin{align}
M\left(  \sum\lambda_{jk}\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert \right)   &  \rightarrow\sum\eta_{lm}\left\vert
\varphi_{l}\right\rangle \left\langle \varphi_{m}\right\vert \\
\sum_{1\leq j,k\leq2r}\lambda_{jk}\left\vert T\varphi_{j}\right\rangle
\left\langle T\varphi_{k}\right\vert  &  =\sum_{1\leq j,k,l,m\leq2r}%
\lambda_{jk}T_{lj}\left\vert \varphi_{l}\right\rangle \left\langle \varphi
_{m}\right\vert \overline{T}_{mk}=\sum_{1\leq j,k,l,m\leq2r}\lambda_{jk}%
T_{lj}\overline{T}_{mk}\left\vert \varphi_{l}\right\rangle \left\langle
\varphi_{m}\right\vert \\
&  =\sum_{1\leq j,k,l,m\leq2r}\lambda_{jk}T_{lj}\overline{T}_{mk}\left\vert
\varphi_{l}\right\rangle \left\langle \varphi_{m}\right\vert =\sum_{1\leq
j,k,l,m\leq2r}T_{lj}\lambda_{jk}T_{km}^{\dagger}\left\vert \varphi
_{l}\right\rangle \left\langle \varphi_{m}\right\vert
\end{align}


\item
\begin{align}
\eta_{lm}  &  =\sum_{1\leq j,k,\leq2r}T_{lj}\lambda_{jk}T_{km}^{\dagger}\\
\mathbf{\eta}  &  =\mathbf{T\lambda T}^{\dagger}%
\end{align}


\item
\begin{align}
\mathbf{\lambda v}_{j}  &  =\alpha_{j}\mathbf{v}_{j}\\
\mathbf{v}_{k}^{\dagger}\mathbf{\lambda v}_{j}  &  =\mathbf{v}_{k}^{\dagger
}\mathbf{v}_{j}\alpha_{j}\\
\mathbf{V}^{\dagger}\mathbf{\lambda V}  &  \mathbf{=V}^{\dagger}%
\mathbf{V\alpha}\\
\sum_{1\leq k,l\leq2r}\overline{V}_{kj}\lambda_{kl}V_{lm}  &  =\sum_{1\leq
k\leq2r}\overline{V}_{kj}V_{km}\alpha_{m}.
\end{align}
The matrix \emph{polarization decomposition} of a real matrix $\mathbf{\lambda
}$ is given by
\[
\mathbf{\lambda=O\beta}%
\]%
\begin{equation}
\mathbf{\beta}=\left(  \mathbf{\lambda}^{t}\mathbf{\lambda}\right)  ^{\frac
{1}{2}},
\end{equation}
where $\mathbf{O\in}$ $O(2r,\mathbb{R})$ and $\mathbf{\beta\geq0}.$

\item The matrix \emph{polarization decomposition} of a complex matrix
$\mathbf{\lambda}$ is given by
\[
\mathbf{\lambda=U\beta}%
\]
where
\begin{equation}
\mathbf{\beta}=\left(  \mathbf{\lambda}^{\dagger}\mathbf{\lambda}\right)
^{\frac{1}{2}},
\end{equation}
and $\mathbf{U\in}$ $U(2r,\mathbb{R})$ and $\mathbf{\beta\geq0}.$
\end{enumerate}

The \emph{SVD} is given by
\begin{equation}
K=\sum_{1\leq j\leq2r}\kappa_{j}\left\vert a_{j}\right\rangle \left\langle
b_{j}\right\vert \equiv\sum_{1\leq j\leq2r}\left\vert a_{j}\right\rangle
\kappa_{j}\left\langle b_{j}\right\vert ,
\end{equation}
for \emph{any compact operator} $K$, where $\kappa_{j}\geq0$ and $\left\{
\left.  \left\vert a_{j}\right\rangle \right\vert 1\leq j\leq2r\right\}
,\left\{  \left.  \left\vert b_{j}\right\rangle \right\vert 1\leq j\leq
r\right\}  $ are orthonormal bases$.$ Thus if $J=-J^{t}$
\begin{equation}
J=\sum_{1\leq j\leq2r}\left\vert a_{j}\right\rangle \left\langle
b_{j}\right\vert =\sum_{1\leq j\leq r}\left\{  \left\vert a_{j}\right\rangle
\left\langle a_{j+r}\right\vert -\left\vert a_{j+r}\right\rangle \left\langle
a_{j}\right\vert \right\}  =-\sum_{1\leq j\leq2r}\left\vert b_{j}\right\rangle
\left\langle a_{j}\right\vert ,
\end{equation}
where $\left\{  \left.  \left\vert a_{j}\right\rangle \right\vert 1\leq
j\leq2r\right\}  ,\left\{  \left.  \left\vert b_{j}\right\rangle =\left\vert
a_{j+r}\right\rangle ,\left\vert b_{j+r}\right\rangle =-\left\vert
a_{j}\right\rangle \right\vert 1\leq j\leq r\right\}  $ and $\left\{  \left.
\kappa_{j}=1\right\vert 1\leq j\leq2r\right\}  .$

Group homomorphisms $\mathcal{R}$ (all representations are group
homomorphisms)
\begin{equation}
\mathcal{R}:G\rightarrow\mathcal{B}\left(  V\right)
\end{equation}
have the properties%
\begin{align}
\mathcal{R}\left(  T_{1}T_{2}\right)   &  =\mathcal{R}\left(  T_{1}\right)
\mathcal{R}\left(  T_{2}\right) \\
\mathcal{R}\left(  id\right)   &  =I_{V}\\
\mathcal{R}\left(  T\right)  ^{-1}  &  =\mathcal{R}\left(  T^{-1}\right)  .
\end{align}
$\mathcal{R}$ is an isomorphism if%
\begin{equation}
\ker\left\{  \mathcal{R}\right\}  =\left\{  id\right\}  ,
\end{equation}
where%
\begin{equation}
\ker\left\{  \mathcal{R}\right\}  =\left\{  \left.  h\in G\right\vert
\mathcal{R}\left(  h\right)  =I_{V}\right\}  .
\end{equation}


In particular we can consider representations $\overset{\frown}{\mathcal{T}}$
of the form
\begin{equation}
\overset{\frown}{\mathcal{T}}:GL(2r,\mathbb{C})\rightarrow\,\mathcal{B}\left(
\mathcal{B}\left(  V\right)  \right)
\end{equation}
constructed from
\begin{equation}
\mathcal{T}:GL(2r,\mathbb{C})\rightarrow\,\mathcal{B}\left(  V\right)  ,
\end{equation}
where%
\begin{equation}
\overset{\frown}{\mathcal{T}}\left(  g\right)  \left(  A\right)
=\mathcal{T}\left(  g\right)  A\mathcal{T}\left(  g\right)  ^{\dagger}.
\end{equation}


\begin{lemma}
$\mathcal{T}$ and $\overset{\frown}{\mathcal{T}}$ are group homomorphisms
\begin{equation}
\,\overset{\frown}{\mathcal{T}}\left(  g_{1}g_{2}\right)  \left(  A\right)
=\left(  g_{1}g_{2}\right)  A\left(  g_{1}g_{2}\right)  ^{\dagger}%
=\mathcal{T}\left(  g_{1}\right)  \mathcal{T}\left(  g_{2}\right)
A\mathcal{T}\left(  g_{2}\right)  ^{\dagger}\mathcal{T}\left(  g_{1}\right)
^{\dagger}=\,\overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \left(
\overset{\frown}{\mathcal{T}}\left(  g_{2}\right)  \left(  A\right)  \right)
=\left(  \overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \circ
\overset{\frown}{\mathcal{T}}\left(  g_{2}\right)  \right)  \left(  A\right)
\end{equation}
however unlike inner automorphisms
\begin{equation}
\overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \left(  AB\right)
\neq\,\overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \left(  A\right)
\overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \left(  B\right)  ,
\end{equation}
i.e. they are not algebra mapping, where
\begin{equation}
\,\overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \left(  A\right)
=\mathcal{T}\left(  g_{1}\right)  \left(  A\right)  \mathcal{T}\left(
g_{1}\right)  ^{\dagger}.
\end{equation}

\end{lemma}

\paragraph{Bra-kets belonging to $\mathcal{B}\left(  \mathcal{F}\right)  =$
$\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  $ and $\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{F}\right)
\right)  $}

\begin{itemize}
\item The exterior algebra $\mathcal{F}$
\begin{equation}
\mathcal{F}=\bigwedge\left(  \mathcal{F}_{1}\right)  ,
\end{equation}
where $\mathcal{F}_{1}$ is the real vector space formed by the generators
$\left\{  \left.  x_{j}\right\vert 1\leq j\leq2r\right\}  ,$ is a Clifford
algebra and gives the representations

\item
\begin{align}
&  \mathcal{T}:GL(2r,\mathbb{C})\rightarrow\mathcal{B}\left(  \mathcal{F}%
_{1}\right) \\
&  \overset{\frown}{\mathcal{T}:}GL(2r,\mathbb{C})\rightarrow\mathcal{B}%
\left(  \mathcal{B}\left(  \mathcal{F}_{1}\right)  \right) \\
&  T\left(  g\right)  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}\\
&  \overset{\frown}{\mathcal{T}}\left(  g\right)  :\mathcal{B}\left(
\mathcal{F}_{1}\right)  \rightarrow\mathcal{B}\left(  \mathcal{F}_{1}\right)
\\
&  \overset{\frown}{\mathcal{T}}\left(  g\right)  \in\mathcal{B}\left(
\mathcal{B}\left(  \mathcal{F}_{1}\right)  \right) \\
&  \overset{\frown}{\mathcal{T}}\left(  g\right)  \left(  \left\vert
\varphi\right\rangle \left\langle \psi\right\vert \right)  =T\left\vert
\varphi\right\rangle \left\langle \psi\right\vert T^{\dagger};\left\vert
\varphi\right\rangle \left\langle \psi\right\vert \in\mathcal{B}\left(
\mathcal{F}_{1}\right)  ,T\left(  g\right)  \in\mathcal{B}\left(
\mathcal{F}_{1}\right)
\end{align}


\item Is $\mathcal{T}$ a representation i.e.
\begin{align}
&  \overset{\frown}{\mathcal{T}}\left(  g_{1}\right)  \overset{\frown
}{\mathcal{T}}\left(  g_{2}\right)  =\,\overset{\frown}{\mathcal{T}}\left(
g_{1}g_{2}\right) \\
&  \overset{\frown}{\mathcal{T}}\left(  g_{1}^{-1}\right)  =\,\overset{\frown
}{\mathcal{T}}\left(  g_{1}\right)  ^{-1}.
\end{align}


\item
\begin{equation}
\overset{\frown}{\mathcal{T}}\,=\mathcal{T\otimes T}^{d}.
\end{equation}


\item
\begin{equation}
\mathcal{T}^{d}\left(  g\right)  =\mathcal{T}\left(  g^{-1}\right)
^{t}=\mathcal{T}\left(  g\right)  ^{-t}=\overline{\mathcal{T}\left(  g\right)
^{-1\dagger}}.
\end{equation}


\item If $\mathcal{T}\left(  g\right)  $ is unitary then
\begin{equation}
\overline{\mathcal{T}\left(  g\right)  ^{-1\dagger}}=\overline{\mathcal{T}%
\left(  g\right)  }.
\end{equation}


\begin{lemma}
The action of the exponential on the Lie algebra of the complex linear group
\begin{equation}
\exp:gl\left(  2r,\mathbb{C}\right)  =M\left(  2r,\mathbb{C}\right)
\rightarrow GL\left(  2r,\mathbb{C}\right)
\end{equation}
given by
\begin{equation}
T=\exp\left\{  \sum_{1\leq j,k\leq2r}\eta_{jk}\left\vert x_{j}\right\rangle
\left\langle x_{k}\right\vert \right\}
\end{equation}
is \emph{surjective \underline{\emph{but not}} injective} i.e.
\begin{equation}
g\in GL\left(  \mathcal{F}_{1}\right)  \Leftrightarrow g=\exp\left\{
A\right\}
\end{equation}
but
\begin{gather}
A_{1}\neq A_{2}\\
\nRightarrow\exp\left\{  A_{1}\right\}  \neq\exp\left\{  A_{2}\right\}  .
\end{gather}

\end{lemma}

\begin{proof}
It suffices to prove that each Jordan block (with nonzero diagonal) is the
exponential of a complex matrix.

Also,
\begin{equation}
\exp:M\left(  2r,\mathbb{C}\right)  \rightarrow GL\left(  2r,\mathbb{C}%
\right)
\end{equation}


is a group homomorphism whose image is an open subgroup, that is the whole of
$GL\left(  2r,\mathbb{C}\right)  $ which is connected.

The lack of injectivity is trivial as
\begin{equation}
\exp\left\{  2\pi iI\right\}  =\exp\left\{  4\pi iI\right\}  .
\end{equation}

\end{proof}

\begin{remark}
The exponential map on sub Lie algebras of $gl\left(  2r,\mathbb{C}\right)  $
\emph{is not in general surjective e.g. }$o\left(  2r,\mathbb{R}\right)  .$
\end{remark}

\begin{remark}
The exponential map is not in general injective.
\end{remark}

\item
\begin{equation}
T:\bigwedge\left(  \mathcal{F}_{1}\right)  \equiv\mathcal{F}\rightarrow
\mathcal{F};\,\boxtimes\left(  T\right)  \left(  x_{1}\wedge\cdots\wedge
x_{n}\right)  =Tx_{1}\wedge\cdots\wedge Tx_{n};\,\boxtimes\left(  T\right)
\in\mathcal{B}\left(  \mathcal{F}\right)
\end{equation}


\item The exponential
\begin{equation}
\exp:gl\left(  \mathcal{F}\right)  \rightarrow GL\left(  \mathcal{F}\right)
\end{equation}
given by%
\begin{equation}
\boxtimes\left(  T\right)  =\exp\left\{  \sum_{0\leq n\leq2r}\sum
_{\substack{1\leq j_{1}<\cdots j_{n}\leq2r\\1\leq k_{1}<\cdots k_{m}\leq
2r}}\eta_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}\left\vert x_{j_{1}}\cdots
x_{j_{n}}\right\rangle \left\langle x_{k_{1}}\cdots x_{k_{m}}\right\vert
\right\}
\end{equation}
is surjective.

\item
\begin{gather}
\overset{\frown}{\mathcal{T}}\left(  \boxtimes\left(  T\right)  \right)
\left(  \left\vert x_{1}\cdots x_{n}\right\rangle \left\langle y_{1}\cdots
y_{m}\right\vert \right)  =\boxtimes\left(  T\right)  \left\vert x_{1}\cdots
x_{n}\right\rangle \left\langle y_{1}\cdots y_{m}\right\vert \left(
\boxtimes\left(  T\right)  \right)  ^{\dagger}=\left\vert Tx_{1}\cdots
Tx_{n}\right\rangle \left\langle Ty_{1}\cdots Ty_{m}\right\vert \\
\overset{\frown}{\mathcal{T}}\left(  \boxtimes\left(  T\right)  \right)
\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{F}\right)  \right)
;\,\boxtimes\left(  T\right)  \in\mathcal{B}\left(  \mathcal{F}\right)
;\,\left\vert x_{1}\cdots x_{n}\right\rangle \left\langle y_{1}\cdots
y_{m}\right\vert \in\mathcal{B}\left(  \mathcal{F}\right)  .
\end{gather}


\item As $\mathcal{F}$ is an algebra (\emph{at least in finite dimensions})
\begin{align}
T\left(  x_{j}\right)   &  =tx_{1}t^{-1}\\
\widehat{\boxtimes\left(  T\right)  }\left(  x_{1}\cdots x_{n}\right)   &
=t\left(  x_{1}\cdots x_{n}\right)  t^{-1};\,x_{1}\cdots x_{n},t,\,t^{-1}%
\in\mathcal{F}%
\end{align}
and
\begin{align}
\exp\left\{  \sum_{0\leq n\leq2r}\sum_{\substack{1\leq j_{1}<\cdots j_{n}%
\leq2r\\1\leq k_{1}<\cdots k_{m}\leq2r}}\eta_{j_{1}\cdots j_{n}k_{1}\cdots
k_{m}}\left\vert x_{j_{1}}\cdots x_{j_{n}}\right\rangle \left\langle x_{k_{1}%
}\cdots x_{k_{m}}\right\vert \right\}  \left\vert x_{l_{1}}\cdots x_{l_{p}%
}\right\rangle  &  =t\left(  x_{l_{1}}\cdots x_{l_{p}}\right)  t^{-1}=\left(
tx_{l_{1}}t^{-1}\cdots tx_{l_{p}}t^{-1}\right) \\
&  =\left\vert y_{l_{1}}\cdots y_{l_{p}}\right\rangle \equiv y_{l_{1}}\cdots
y_{l_{p}},
\end{align}
where
\begin{equation}
t=\exp\left\{  \sum_{0\leq n\leq2r}\sum_{1\leq j_{1}<\cdots j_{n}\leq
2r}\lambda_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}\right\}  ,
\end{equation}
however this is not true for $\mathcal{F}_{1}$ \emph{as it is not an
algebra}$.$ But $\left\{  \mathcal{F}_{n}\right\}  $ \emph{are} invariant
subspaces of $\boxtimes\left(  T\right)  $ i.e.
\begin{equation}
\boxtimes\left(  T\right)  :\mathcal{F}_{n}\rightarrow\mathcal{F}_{n}%
\end{equation}
so in particular
\begin{equation}
\boxtimes\left(  T\right)  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}.
\end{equation}

\end{itemize}

The \emph{real} symplectic group $Sp(2r,\mathbb{R})$ can be defined by
\begin{equation}
\boxtimes\left(  T\right)  J_{x}\boxtimes\left(  T^{t}\right)
=\,\overset{\frown}{\mathcal{T}}\left(  \boxtimes\left(  T\right)  \right)
\left(  J_{x}\right)  =J_{x},
\end{equation}
where%
\begin{align}
J_{x}  &  =\frac{1}{2}\sum_{1\leq j\leq r}\left\{  x_{j}x_{j+r}-x_{j+r}%
x_{j}\right\}  \cong\frac{1}{2}\sum_{1\leq j\leq r}\left\{  \left\vert
x_{j}\right\rangle \left\langle x_{j+r}\right\vert -\left\vert x_{j+r}%
\right\rangle \left\langle x_{j}\right\vert \right\} \\
\boxtimes\left(  T\right)  J_{x}\boxtimes\left(  T^{t}\right)   &  =\frac
{1}{2}\sum_{1\leq j\leq r}\boxtimes\left(  T\right)  \left\{  \left\vert
x_{j}\right\rangle \left\langle x_{j+r}\right\vert -\left\vert x_{j+r}%
\right\rangle \left\langle x_{j}\right\vert \right\}  \boxtimes\left(
T^{t}\right) \\
&  =\frac{1}{2}\sum_{1\leq j\leq r}\left\{  \left\vert tx_{j}t^{-1}%
\right\rangle \left\langle tx_{j+r}t^{-1}\right\vert -\left\vert
tx_{j+r}t^{-1}\right\rangle \left\langle tx_{j}t^{-1}\right\vert \right\} \\
&  =\frac{1}{2}\sum_{1\leq j\leq r}\left\{  \left\vert y_{j}\right\rangle
\left\langle y_{j+r}\right\vert -\left\vert y_{j+r}\right\rangle \left\langle
y_{j}\right\vert \right\}  .
\end{align}
$\boxtimes\left(  T\right)  \in\mathcal{B}\left(  \mathcal{F}\right)  $ is a
\emph{vector space} isomorphism%
\begin{equation}
\boxtimes\left(  T\right)  :\mathcal{F}\rightarrow\mathcal{F}%
\end{equation}
as $T\in GL(2r,\mathbb{R})\subset\mathcal{B}\left(  \mathcal{F}\right)  $%
\begin{align}
T  &  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}\\
T^{-1}  &  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}.
\end{align}
It is gauge invariant i.e.
\begin{equation}
\boxtimes\left(  T\right)  :\mathcal{F}_{n}\rightarrow\mathcal{F}_{n},0\leq
n\leq2r
\end{equation}
i.e.
\begin{equation}
\boxtimes\left(  T\right)  x_{1}\cdots x_{n}=\left(  Tx_{1}\right)
\cdots\left(  Tx_{n}\right)  \in\mathcal{F}_{n}.
\end{equation}
\emph{It is not a Clifford algebra isomorphism} unless every element of the
basis $\left\{  x_{j}\right\}  $ is null, as%
\begin{align}
&  \left(  \boxtimes\left(  T\right)  \left(  x_{j_{1}}\right)  \right)
\left(  \boxtimes\left(  T\right)  \left(  x_{j_{2}}\right)  \right)
=T\left(  x_{j_{1}}\right)  T\left(  x_{j_{2}}\right)  =\sum_{1\leq
k_{1},k_{2}\leq2r}x_{k_{1}}x_{k_{2}}T_{k_{1}j_{1}}T_{k_{2}j_{2}}\\
&  =\sum_{1\leq k_{1}<k_{2}\leq2r}x_{k_{1}}x_{k_{2}}\left(  T_{k_{1}j_{1}%
}T_{k_{2}j_{2}}-T_{k_{2}j_{1}}T_{k_{1}j_{2}}\right)  +\alpha\left(
T^{t}T\right)  _{j_{1}j_{2}}\\
&  =\sum_{1\leq k_{1}<k_{2}\leq2r}x_{k_{1}}\wedge x_{k_{2}}\left(  T\boxtimes
T\right)  _{k_{1}k_{2}j_{1}j_{2}}+\alpha\left(  T^{t}T\right)  _{j_{1}j_{2}%
}\neq\boxtimes\left(  T\right)  \left(  x_{j_{1}}x_{j_{2}}\right)
=\boxtimes^{2}\left(  T\right)  \left(  x_{j_{1}}x_{j_{2}}\right)  ,
\end{align}
where
\begin{equation}
\alpha I_{\mathcal{F}}=\left\Vert x_{j}\right\Vert _{\mathcal{F}}%
^{2}I_{\mathcal{F}};\quad1\leq j\leq2r.
\end{equation}
It is however a \emph{Grassmann algebra isomorphism} i.e.%
\begin{equation}
\left(  \overset{}{\boxtimes\left(  T\right)  \left(  x_{j_{1}}\right)
}\right)  \boxtimes\left(  \overset{}{\boxtimes\left(  T\right)  \left(
x_{j_{2}}\right)  }\right)  =\boxtimes\left(  T\right)  \left(  x_{j_{1}%
}\wedge x_{j_{2}}\right)  =\boxtimes^{2}\left(  T\right)  \left(  x_{j_{1}%
}\wedge x_{j_{2}}\right)  .
\end{equation}
In finite dimensions all \emph{Clifford algebra isomorphisms are inner.}

The adjoint representation $\widehat{\boxtimes\left(  T\right)  }%
\in\mathcal{B}\left(  \mathcal{F}\right)  ,T\in GL(2r,\mathbb{R})$ given by
\begin{align}
T  &  :\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}\\
\widehat{\boxtimes\left(  T\right)  }  &  :\mathcal{F}\rightarrow\mathcal{F}\\
\widehat{\boxtimes\left(  T\right)  }\left(  A\right)   &  =tAt^{-1}%
\end{align}
and%
\begin{equation}
\widehat{\boxtimes\left(  T\right)  }\left(  x_{1}\cdots x_{n}\right)
=\left(  tx_{1}t^{-1}\right)  \cdots\left(  tx_{n}t^{-1}\right)  =tx_{1}\cdots
x_{n}t^{-1}%
\end{equation}
is an algebra isomorphisms i.e.
\begin{align}
&  \widehat{\boxtimes\left(  T\right)  }\left(  x_{1}\right)
\widehat{\boxtimes\left(  T\right)  }\left(  x_{2}\right)  =\widehat{\boxtimes
\left(  T\right)  }\left(  x_{1}x_{2}\right) \\
&  \widehat{T}\left(  x_{1}\right)  \widehat{T}\left(  x_{2}\right)
=\widehat{T}\left(  x_{1}x_{2}\right) \\
&  \left(  tx_{1}t^{-1}\right)  \left(  tx_{2}t^{-1}\right)  =t\left(
x_{1}x_{2}\right)  t^{-1},
\end{align}
which are gauge invariant i.e.
\begin{equation}
\widehat{\boxtimes\left(  T\right)  }:\mathcal{F}_{n}\rightarrow
\mathcal{F}_{n},0\leq n\leq2r.
\end{equation}


The group $GL(2^{2r},\mathbb{R})$ acts in $\mathcal{F}$
\begin{equation}
\mathcal{F}=\operatorname*{linspan}\left\{  \left.  \left\vert \Phi
_{j}\right\rangle \left\langle \Phi_{k}\right\vert \right\vert 1\leq
j,k\leq2^{2r}\right\}
\end{equation}
as vector space isomorphisms. All algebraic isomorphisms (in finite
dimensions), are vector space isomorphisms and can thus be expressed as inner
automorphisms. The adjoint representation of $GL(2^{2r},\mathbb{R})$ in
$\mathcal{F}$ produce algebra isomorphisms%

\begin{align}
\widehat{\Pi_{\mathcal{F}}}\left(  GL(2^{2r},\mathbb{R})\right)   &
:\mathcal{F}\rightarrow\mathcal{F}\\
\widehat{\Pi_{\mathcal{F}}}\left(  g\right)  \left(  A\right)   &
=\Pi_{\mathcal{F}}\left(  g\right)  A\Pi_{\mathcal{F}}\left(  g\right)  ^{-1},
\end{align}
where
\begin{equation}
\Pi_{\mathcal{F}}\left(  g\right)  =\exp\left\{  \sum_{1\leq j,k\leq2^{2r}%
}\lambda_{jk}\left(  g\right)  \left\vert \Phi_{j}\right\rangle \left\langle
\Phi_{k}\right\vert \right\}
\end{equation}
and $\Pi_{\mathcal{F}}$ and $\widehat{\Pi_{\mathcal{F}}}$ are represenations
of the Lie algebra $gl(2^{2r},\mathbb{R}).$ The ket-bras can be expanded in
terms of the Clifford algebra basis i.e.
\begin{equation}
\left\vert \Phi_{j}\right\rangle \left\langle \Phi_{k}\right\vert =\sum_{0\leq
n\leq2r}\sum_{1\leq l_{1}<\cdots l_{n}\leq2r}\eta_{l_{1}\cdots l_{n}%
jk}x_{l_{1}}\cdots x_{l_{n}},
\end{equation}
which shows
\begin{equation}
\Pi_{\mathcal{F}}\left(  g\right)  =\exp\left\{  \sum_{0\leq n\leq2r}%
\sum_{1\leq l_{1}<\cdots l_{n}\leq2r}\varsigma\left(  g\right)  _{l_{1}\cdots
l_{n}}x_{l_{1}}\cdots x_{l_{n}}\right\}  .
\end{equation}


\begin{remark}
$\exp$ is not surjective from $\mathcal{M}\left(  n,\mathbb{R}\right)  $ to
$GL(2r,\mathbb{R})$ for any $n.$
\end{remark}

As $GL(2r,\mathbb{R})\subset GL(2^{2r},\mathbb{R}),$ the group
$GL(2r,\mathbb{R})$ has a representations as inner automorphisms i.e. algebra
isomorphisms in $\mathcal{B}\left(  \mathcal{F}\right)  ,$ If $g\in O\left(
2r,\mathbb{R}\right)  $ then it is a Clifford algebra isomorphism, however if
$g\notin O(2r,\mathbb{R})$ the sums in the exponents \emph{must be greater
than degree two}. Are such transformations gauge invariant i.e. do they leave
$\mathcal{F}_{n}$ invariant? They do not have to be, some are and some are
not. Consider the subgroups, $GL(\mathcal{V},\mathbb{R})$ of $GL(2^{2r}%
,\mathbb{R})$ by
\begin{equation}
GL(\mathcal{V},\mathbb{R})=\left\{  \left.  \widehat{\Pi_{\mathcal{F}}}\left(
g\right)  \in\widehat{\Pi_{\mathcal{F}}}\left(  GL(2^{2r},\mathbb{R})\right)
\right\vert \widehat{\Pi_{\mathcal{F}}}\left(  g\right)  \left(
\mathcal{V}\right)  =\mathcal{V}\right\}  ,
\end{equation}
where $\mathcal{V}$ can be composed in general by non homogeneous linear
combinations of polynomials of $\left\{  x_{j}\right\}  $ i.e.
\begin{equation}
\mathcal{V}=\operatorname*{linspan}\left\{  \left.  \sum_{0\leq n\leq2r}%
\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\eta_{j_{1}}\cdots\eta_{j_{n}}x_{j_{1}%
}\cdots x_{j_{n}}\right\vert 1\leq j,k\leq2r\right\}  =\mathcal{B}\left(
\mathcal{H}^{1}\right)  ;\varphi_{j}\in\mathcal{H}^{1}%
\end{equation}
and%
\begin{equation}
\Pi_{\mathcal{F}}\left(  g\right)  =\exp\left\{  \sum_{0\leq n\leq2r}%
\sum_{1\leq l_{1}<\cdots l_{n}\leq2r}\varsigma\left(  g\right)  _{l_{1}\cdots
l_{n}}x_{l_{1}}\cdots x_{l_{n}}\right\}  ;g\in GL(\mathcal{V},\mathbb{R})\cong
GL(2r,\mathbb{R}).
\end{equation}
Thus
\begin{align}
\widehat{\Pi_{\mathcal{F}}}\left(  GL(\mathcal{V},\mathbb{R})\right)   &
:\mathcal{V}\rightarrow\mathcal{V}\\
\widehat{\Pi_{\mathcal{F}}}\left(  g\right)  \left(  A\right)   &
=\Pi_{\mathcal{F}}\left(  g\right)  A\Pi_{\mathcal{F}}\left(  g\right)
^{-1}\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  \text{ if }A\in
\mathcal{B}\left(  \mathcal{H}^{1}\right)  ,
\end{align}


\begin{remark}
Remember
\begin{equation}
\exp:gl(\mathcal{V},\mathbb{R})\rightarrow GL(\mathcal{V},\mathbb{R})
\end{equation}
is not surjective.
\end{remark}

In general
\begin{equation}
\mathcal{V}\cap\mathcal{F}_{n}\neq\phi,n>1.
\end{equation}
However one can define a subgroup, $GL(\mathcal{F}_{1},\mathbb{R})$ of
$GL(2^{2r},\mathbb{R})$ by
\begin{equation}
GL(\mathcal{F}_{1},\mathbb{R})=\left\{  \left.  \widehat{\Pi_{\mathcal{F}}%
}\left(  g\right)  \in\widehat{\Pi_{\mathcal{F}}}\left(  GL(2^{2r}%
,\mathbb{R})\right)  \right\vert \widehat{\Pi_{\mathcal{F}}}\left(  g\right)
\left(  \mathcal{F}_{1}\right)  =\mathcal{F}_{1}\right\}  ,
\end{equation}
which maps $\mathcal{F}_{1}$ to itself.

The subgroups $\widehat{\Pi_{\mathcal{F}}}\left(  GL(\mathcal{V}%
_{1},\mathbb{R})\right)  $ and $\widehat{\Pi_{\mathcal{F}}}\left(
GL(\mathcal{F}_{1},\mathbb{R})\right)  $ are of course isomorphic to
$\widehat{\Pi_{\mathcal{F}}}\left(  GL(2r,\mathbb{R})\right)  ,$ through
conjugation. $\mathcal{F}$ forms the Lie algebra, $gl(2^{2r},\mathbb{R}),$ of
$GL(2^{2r},\mathbb{R})$ and the adjoint representation of $GL(2^{2r}%
,\mathbb{R})$ is on this algebra (A Lie algebra that is embedded in an
associative algebra has to have to two products $\left[  ,\right]  $ and the
algebraic "$\cdot"$ as the latter is defined in terms of the former). The
algebra $\mathcal{F}$ is the real \emph{universal enveloping algebra }of the
Lie algebra $o(2r,\mathbb{R})$ of the Lie group $O(2r,\mathbb{R}).$ So the Lie
algebra does not have to be closed under the algebraic product, but only the
Lie algebra product, but it does have to form a closed subspace. The Lie
algebra is always invariant under the adjoint action of the Lie group.

\begin{remark}
Let $\mathcal{V}$ be a subspace of an algebra $\mathcal{A},$ $\mathcal{G}$ the
Lie group of the group $G$ and
\begin{align}
L_{A}  &  :\Pi_{\mathcal{A}}\left(  \mathcal{G}\right)  \rightarrow
\Pi_{\mathcal{A}}\left(  \mathcal{G}\right) \\
L_{A}\left(  v\right)   &  =\left[  A,v\right]  \in\Pi_{\mathcal{A}}\left(
\mathcal{G}\right)  ,\,v\in\Pi_{\mathcal{A}}\left(  \mathcal{G}\right)
,A\in\Pi_{\mathcal{A}}\left(  \mathcal{G}\right)
\end{align}
then
\begin{align}
G  &  :\mathcal{G}\rightarrow\mathcal{G}\\
\widehat{g}\left(  v\right)   &  =gvg^{-1}\in\mathcal{G},v\in\Pi_{\mathcal{A}%
}\left(  \mathcal{G}\right)  ,g\in\Pi_{\mathcal{A}}\left(  G\right)
\subset\mathcal{A}\\
g  &  =\exp A,\,A\in\mathcal{G},
\end{align}
as $\mathcal{G}$ is the Lie algebra of $G.$
\end{remark}

In the case of the Clifford algebra $\mathcal{F}$ one has the following
correspondences for

\begin{itemize}
\item $O\left(  2r+1,\mathbb{R}\right)  $
\begin{align}
\mathcal{G}  &  \longleftrightarrow\mathcal{F}_{0}\oplus\mathcal{F}_{1}%
\oplus\mathcal{F}_{2}\longleftrightarrow\mathcal{\Pi_{\mathcal{F}}}\left(
o\left(  2r+1,\mathbb{R}\right)  \right) \\
G  &  \longleftrightarrow\mathcal{\Pi_{\mathcal{F}}}\left(  O\left(
2r+1,\mathbb{R}\right)  \right) \\
\mathcal{A}  &  \longleftrightarrow\mathcal{F}%
\end{align}


\item $O\left(  2r,\mathbb{R}\right)  $%
\begin{align}
&  \mathcal{G}\longleftrightarrow\mathcal{F}_{0}\oplus\mathcal{F}%
_{2}\longleftrightarrow\mathcal{\Pi_{\mathcal{F}}}\left(  o\left(
2r,\mathbb{R}\right)  \right) \\
&  G\longleftrightarrow\mathcal{\Pi_{\mathcal{F}}}\left(  O\left(
2r,\mathbb{R}\right)  \right) \\
&  \mathcal{A}\longleftrightarrow\mathcal{F}_{\text{even}}\subset\mathcal{F}.
\end{align}


\item $GL(2^{2r},\mathbb{C})$%
\begin{align}
&  \mathcal{G}\longleftrightarrow\mathcal{F}\longleftrightarrow\mathcal{\Pi
_{\mathcal{F}}}\left(  gl(2^{2r},\mathbb{C})\right) \\
&  G\longleftrightarrow\mathcal{\Pi_{\mathcal{F}}}\left(  GL(2^{2r}%
,\mathbb{C})\right) \\
&  \mathcal{A}\longleftrightarrow\mathcal{F}.
\end{align}

\end{itemize}

\begin{enumerate}
\item The group of transformations that leave the Clifford structure invariant
in $\mathcal{F}$ is $O(2r,\mathbb{C}).$

\item The group of transformations that leave the complex symplectic structure
invariant in $\mathcal{F}_{1}$ is $Sp(2r,\mathbb{C}).$

\item The group of transformations that leave the CAR structure invariant in
$\mathcal{F}$ is $O(2r,\mathbb{R}).$

\item The group of transformations that leave both the Clifford structure and
complex symplectic product invariant are%
\[
Sp(2r,\mathbb{C})\cap O(2r,\mathbb{C})
\]
leading to the coset spaces
\begin{equation}
\frac{O(2r,\mathbb{C})}{Sp(2r,\mathbb{C})\cap O(2r,\mathbb{C})}%
\end{equation}
and
\begin{equation}
\frac{Sp(2r,\mathbb{C})}{Sp(2r,\mathbb{C})\cap O(2r,\mathbb{C})}.
\end{equation}


\item The group of transformations that leave both the Clifford structure and
real symplectic product invariant are
\[
Sp(2r,\mathbb{R})\cap O(2r,\mathbb{C})
\]
leading to the coset spaces
\begin{equation}
\frac{Sp(2r,\mathbb{R})}{Sp(2r,\mathbb{R})\cap O(2r,\mathbb{C})}%
\end{equation}
and%
\begin{equation}
\frac{O(2r,\mathbb{C})}{Sp(2r,\mathbb{R})\cap O(2r,\mathbb{C})}.
\end{equation}


\item The group of transformations that leave both the CAR structure and
symplectic product invariant are
\begin{equation}
Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R})=U\left(  r\right)  ,
\end{equation}
leading to the coset space%
\begin{equation}
\frac{O(2r,\mathbb{R})}{Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R})}=\frac
{O(2r,\mathbb{R})}{U\left(  r\right)  }.
\end{equation}


\item The set of transformations that leave the CAR structure invariant but
change the symplectic form are
\begin{equation}
T\in O(2r,\mathbb{R});\,T\notin Sp(2r,\mathbb{R}),
\end{equation}
leading to the coset space%
\begin{equation}
\frac{O(2r,\mathbb{R})}{U\left(  r\right)  }=\frac{O(2r,\mathbb{R}%
)}{Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R})}.
\end{equation}


\item The set of transformations that leave the symplectic form invariant but
change the CAR structure are
\begin{equation}
T\notin O(2r,\mathbb{R});\,T\in Sp(2r,\mathbb{R}),
\end{equation}
leading to the coset space%
\begin{equation}
\frac{Sp(2r,\mathbb{R})}{U\left(  r\right)  }=\frac{Sp(2r,\mathbb{R}%
)}{Sp(2r,\mathbb{R})\cap O(2r,\mathbb{R})}.
\end{equation}


\item The set of transformations that change both the symplectic and CAR
stucture
\begin{align}
T  &  \notin O(2r,\mathbb{R});\,T\notin Sp(2r,\mathbb{R})\\
&  \frac{GL(2r,\mathbb{R})}{O(2r,\mathbb{R})}\cap\frac{GL(2r,\mathbb{R}%
)}{Sp(2r,\mathbb{R})}.
\end{align}

\end{enumerate}

$\lceil$ Exterior algebras of direct sums can be expanded as
\begin{equation}
\wedge\left(  \mathcal{F}_{-1}\oplus\mathcal{F}_{+1}\right)  =\wedge\left(
\mathcal{F}_{-1}\right)  \otimes\wedge\left(  \mathcal{F}_{+1}\right)
\end{equation}
and%
\begin{align}
\wedge\left(  \mathcal{F}_{-1}\oplus\mathcal{F}_{+1}\right)   &  =\left\{
\left\vert \phi\right\rangle \right\}  \oplus\left(  \mathcal{F}_{-1}%
\oplus\mathcal{F}_{+1}\right)  \oplus\wedge^{2}\left(  \mathcal{F}_{-1}%
\oplus\mathcal{F}_{+1}\right)  \oplus\cdots\oplus\wedge^{2r}\left(
\mathcal{F}_{-1}\oplus\mathcal{F}_{+1}\right) \\
\wedge^{2}\left(  \mathcal{F}_{-1}\oplus\mathcal{F}_{+1}\right)   &  =\left(
\mathcal{F}_{-1}\oplus\mathcal{F}_{+1}\right)  \wedge\left(  \mathcal{F}%
_{-1}\oplus\mathcal{F}_{+1}\right)  =\mathcal{F}_{-1}\wedge\mathcal{F}%
_{-1}\oplus\mathcal{F}_{-1}\wedge\mathcal{F}_{+1}\oplus\mathcal{F}_{+1}%
\wedge\mathcal{F}_{-1}\oplus\mathcal{F}_{+1}\wedge\mathcal{F}_{+1}%
\end{align}
$\rfloor$

$GL(2r,\mathbb{C})$ is also contained in $\operatorname*{Inn}\left\{
\mathcal{F}\right\}  $, again $%
%TCIMACRO{\tbigwedge ^{n}}%
%BeginExpansion
{\textstyle\bigwedge^{n}}
%EndExpansion
\mathcal{F}_{1}$ are invariant subspaces and
\begin{align}
\widehat{\Pi_{\mathcal{F}}}\left(  \mathcal{R}_{x}\left(  g\right)  \right)
\left(  x_{k_{1}}\cdots x_{k_{m}}\right)   &  =\exp\left\{  \sum_{0\leq
n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\mathcal{R}_{x}\left(  g\right)
_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}\right\}  A\exp\left\{
-\sum_{0\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\mathcal{R}%
_{x}\left(  g\right)  _{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}\right\} \\
&  =y_{k_{1}}\cdots y_{k_{m}};\quad\left\{  \left.  g_{j_{1}\cdots j_{n}}%
\in\mathbb{C}\right\vert 1\leq j_{1}<\cdots<j_{n}\leq2r,0\leq n\leq2r\right\}
,\,g\in GL(2r,\mathbb{C}),\,\mathcal{R}_{x}\left(  g\right)  \in
gl(2r,\mathbb{C})
\end{align}
these sums contain non even products so grade involution needs to be
considered. In particular%

\begin{equation}
\left[  \sum_{0\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}%
\mathcal{R}_{x}\left(  g\right)  _{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}%
},\,x_{j}\right]  =\sum x_{j}\widehat{\Pi_{\mathcal{F}}}\left(  \mathcal{R}%
_{x}\left(  g\right)  \right)  _{jk},\,\mathcal{R}_{x}\left(  g\right)  \in
gl(2r,\mathbb{C}),
\end{equation}
where
\begin{align}
&  \left[  \sum_{1\leq j_{1}<j_{2}<j_{3}\leq4}\mathcal{R}_{x}\left(  g\right)
_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}},\,x_{j}\right]  =\sum_{1\leq
j_{1}<j_{2}<j_{3}\leq4}\mathcal{R}_{x}\left(  g\right)  _{j_{1}j_{2}j_{3}%
}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j}-x_{j}x_{j_{1}}x_{j_{2}}x_{j_{3}%
}\right\} \\
&  =-2\sum_{1\leq j_{1}<j_{2}<j_{3}\neq j\leq4}\mathcal{R}_{x}\left(
g\right)  _{j_{1}j_{2}j_{3}}x_{j}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\sum_{1\leq
j_{1}<j_{2}<j_{3}\leq4}\mathcal{R}_{x}\left(  g\right)  _{j_{1}j_{2}j_{3}%
}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{1}}-x_{j_{1}}x_{j_{1}}x_{j_{2}%
}x_{j_{3}}\right\}  .
\end{align}


\begin{example}
$r=2$%
\begin{equation}
\exp\left\{  \sum_{0\leq n\leq4}\sum_{1\leq j_{1}<\cdots<j_{n}\leq
4}\mathcal{R}_{x}\left(  g\right)  _{j_{1}\cdots j_{n}}x_{j_{1}}\cdots
x_{j_{n}}\right\}  A\exp\left\{  -\sum_{0\leq n\leq4}\sum_{1\leq j_{1}%
<\cdots<j_{n}\leq4}\mathcal{R}_{x}\left(  g\right)  _{j_{1}\cdots j_{n}%
}x_{j_{1}}\cdots x_{j_{n}}\right\}
\end{equation}
and%
\begin{equation}
\left[  \sum_{0\leq n\leq4}\sum_{1\leq j_{1}<\cdots<j_{n}\leq4}\mathcal{R}%
_{x}\left(  g\right)  _{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}%
,\sum_{0\leq n\leq4}\sum_{1\leq j_{1}<\cdots<j_{n}\leq4}h_{j_{1}\cdots j_{n}%
}x_{j_{1}}\cdots x_{j_{n}}\right]  =\sum_{0\leq n\leq4}\sum_{1\leq
j_{1}<\cdots<j_{n}\leq4}f_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}%
\end{equation}
where
\begin{align}
\sum_{0\leq n\leq4}\sum_{1\leq j_{1}<\cdots<j_{n}\leq4}\mathcal{R}_{x}\left(
g\right)  _{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}  &  =\mathcal{R}%
_{x}\left(  g\right)  _{0}I+\sum_{1\leq j_{1}\leq}\mathcal{R}_{x}\left(
g\right)  _{j_{1}}x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq4}\mathcal{R}%
_{x}\left(  g\right)  _{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}\\
&  +\sum_{1\leq j_{1}<j_{2}<j_{3}\leq4}\mathcal{R}_{x}\left(  g\right)
_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+\mathcal{R}_{x}\left(  g\right)
_{1234}x_{1}x_{2}x_{3}x_{4},
\end{align}
where%
\begin{align}
\dim\left(  \mathcal{F}\right)   &  =1+4+6+4+1=2^{4}=16=2^{2r}\\
\dim\left(  \mathcal{H}_{\mathcal{F}}\right)   &  =2^{2}=4=2^{r}%
\end{align}
and%
\begin{align}
\mathcal{F}  &  =\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right) \\
\dim\left(  \mathcal{F}\right)   &  =\dim\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  =16.
\end{align}
The operators $\left\{  E_{jk};1\leq j,k\leq4\right\}  $
\begin{equation}
\left[  E_{jk},E_{lm}\right]  =E_{jm}\delta_{kl}-E_{lk}\delta_{mj}.
\end{equation}
form a basis for the Lie algebra $gl\left(  4,\mathbb{C}\right)  $ and of
$\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathbb{C}^{4}\right)  $
\end{example}

