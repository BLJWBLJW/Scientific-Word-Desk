giving%
\begin{equation}
\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  \right\}  =15.
\end{equation}
One can form the \emph{unitary,} $U\left(  4\right)  ,$ irreducible subspace
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0-1}=\ker\left\{  L_{1}%
^{0}\right\}  \ominus\ker\left\{  L_{1}^{1}\right\} \\
=\operatorname*{linspan}\left\{  \left\{  \left\vert 1\right\rangle
\left\langle 2\right\vert ,\left\vert 1\right\rangle \left\langle 3\right\vert
,\left\vert 1\right\rangle \left\langle 4\right\vert ,\left\vert
2\right\rangle \left\langle 3\right\vert ,\left\vert 2\right\rangle
\left\langle 4\right\vert ,\left\vert 3\right\rangle \left\langle 4\right\vert
,\left\vert 2\right\rangle \left\langle 1\right\vert ,\left\vert
3\right\rangle \left\langle 1\right\vert ,\left\vert 4\right\rangle
\left\langle 1\right\vert ,\left\vert 3\right\rangle \left\langle 2\right\vert
,\left\vert 4\right\rangle \left\langle 2\right\vert ,\left\vert
4\right\rangle \left\langle 3\right\vert \right\}  ,\right. \\
\left.  \left\{  \left\vert 1\right\rangle \left\langle 1\right\vert
-\left\vert 2\right\rangle \left\langle 2\right\vert ,\left\vert
2\right\rangle \left\langle 2\right\vert -\left\vert 3\right\rangle
\left\langle 3\right\vert ,\left\vert 3\right\rangle \left\langle 3\right\vert
-\left\vert 4\right\rangle \left\langle 4\right\vert \right\}  \right\} \\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0-1}\right\}
=15,
\end{gather}
that has the property%
\begin{align}
L_{1}^{0}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(
0\right)  -\left(  1\right)  }\rightarrow\mathbb{O}\\
L_{1}^{0}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(
0\right)  -\left(  1\right)  }^{c}=\ker\left\{  L_{1}^{0}\right\}
^{c}\overset{1-1}{\rightarrow}\mathbb{C}\cong\mathcal{B}_{1}\left(
\mathcal{H}^{0}\right)  .
\end{align}


$\,$and the \emph{unitary} \underline{\emph{non invariant}} irreducible
subspace direct sum decomposition
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0\right)  -\left(
1\right)  }=\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0},
\end{equation}
where
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}  &
=\operatorname*{linspan}\left\{  \left\vert 1\right\rangle \left\langle
2\right\vert ,\left\vert 1\right\rangle \left\langle 3\right\vert ,\left\vert
1\right\rangle \left\langle 4\right\vert ,\left\vert 2\right\rangle
\left\langle 3\right\vert ,\left\vert 2\right\rangle \left\langle 4\right\vert
,\left\vert 3\right\rangle \left\langle 4\right\vert ,\left\vert
2\right\rangle \left\langle 1\right\vert ,\left\vert 3\right\rangle
\left\langle 1\right\vert ,\left\vert 4\right\rangle \left\langle 1\right\vert
,\left\vert 3\right\rangle \left\langle 2\right\vert ,\left\vert
4\right\rangle \left\langle 2\right\vert ,\left\vert 4\right\rangle
\left\langle 3\right\vert \right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}  &
=\operatorname*{linspan}\left\{  \left\vert 1\right\rangle \left\langle
1\right\vert -\left\vert 2\right\rangle \left\langle 2\right\vert ,\left\vert
2\right\rangle \left\langle 2\right\vert -\left\vert 3\right\rangle
\left\langle 3\right\vert ,\left\vert 3\right\rangle \left\langle 3\right\vert
-\left\vert 4\right\rangle \left\langle 4\right\vert \right\}  .
\end{align}

\end{enumerate}
\end{example}

\begin{remark}
These subspaces are in general different when transformed by a unitary
transformation but they are isomorphic.
\end{remark}

\begin{remark}
$\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}$ is an Abelian subalgebra
generated by self adjoint partial isometries. Conjugates of $\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  _{0}$ form an equivalence class. Any class
representative can be identified with $\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  _{0}$ as an Abelian subalgebra.
\end{remark}

Operators with non zero trace can always be decomposed into a component
belonging to
\[
\ker\left\{  L_{1}^{0}\right\}  ^{c}\equiv\left\{  \left.  zP_{\binom{4}{1}%
}\right\vert z\in\mathbb{C}\right\}  =\left\{  \left\{  \left.  zP_{4}%
\right\vert z\in\mathbb{C}\right\}  \right\}  ,
\]
and tracelss components, where%
\begin{equation}
\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  ^{c}\right\}  =1,
\end{equation}
which leads to
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0\right)  -\left(
1\right)  }=\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \ominus\ker\left\{
L_{1}^{0}\right\}  ,\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0-1}\right\}
=15,
\end{gather}
and%
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\ker\left\{  L_{1}%
^{0}\right\}  ^{c}\oplus\ker\left\{  L_{1}^{0}\right\}  ,\\
\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  ^{c}\right\}  =1.
\end{gather}


\begin{example}
\begin{enumerate}
\item Irreducible Unitary/Spinor Decomposition of $\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  $%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\ker\left\{  L_{1}%
^{0}\right\}  ^{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
_{\left(  0\right)  -\left(  1\right)  }%
\end{equation}


\item Decomposition of $\mathcal{B}\left(  \mathcal{H}^{1}\right)  $

If $r<\infty$ then $\mathcal{B}\left(  \mathcal{H}^{1}\right)  =\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  =\ker\left\{  L_{1}^{0}\right\}
^{c}\oplus\ker\left\{  L_{1}^{0}\right\}  $

and%
\begin{align}
\dim\left\{  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right\}   &
=\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}  =16\\
&  =\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  ^{c}\right\}  \oplus
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(
0\right)  -\left(  1\right)  }\right\} \\
&  =\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  ^{c}\right\}  \oplus
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}\right\}
\oplus\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}\right\}
\\
&  =1+3+12=16.
\end{align}


\item If $r=\infty$ then
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  \supset\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  =\ker\left\{  L_{1}^{0}\right\}  ^{c}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0-1}.
\end{equation}


\item If $X\in\ker\left\{  L_{1}^{0}\right\}  ^{c}$ then
\begin{equation}
\operatorname{Tr}\left\{  X\right\}  \in\left(  -\infty,0\right)  \cup\left(
0,\infty\right)  .
\end{equation}

\end{enumerate}
\end{example}

\begin{remark}%
\begin{equation}
\widehat{u}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert \right)  =u\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert u^{\dagger}=\left\vert \psi_{j}%
\right\rangle \left\langle \psi_{k}\right\vert
\end{equation}
thus similiar Ket-Bra spaces are sent into similiar but different Ket-Bra
spaces that are isomorphic as Banach subspaces.
\end{remark}

\begin{remark}
In the infinite dimensional case one should consider the nuclear space
$\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  $ followed by closures in
different topologies.
\end{remark}

\begin{remark}
The subspace $\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}$ is
generated by self adjoint operators and is mapped into isomorphic subspaces by
the adjoint action of $U\left(  \mathcal{H}^{1}\right)  $.
\end{remark}

\begin{remark}
$\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}$ is generated by partial
isometries and is mapped into isomorphic subspaces by the adjoint action of
$U\left(  \mathcal{H}^{1}\right)  $.
\end{remark}

\begin{remark}
Different Ket-Bra bases produce conjugate versions of the Banach subspace
$\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0},$ are \emph{conjugate
Cartan} \emph{subalgebras} of $su\left(  \mathcal{H}^{1}\right)  .$
\end{remark}

\begin{remark}
One could think of $\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}$ and
$\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{1}$ as denoting
\emph{equivalence classes} of Ket-Bra generated Banach subspaces that have
representations in terms of Ket-Bra operators that are bases dependent.
\emph{The \underline{\emph{equivalence classes}} are }$U\left(  \mathcal{H}%
^{1}\right)  $\emph{ invariant} i.e $U\left(  \mathcal{H}^{1}\right)  $ maps
the self adjoint vector space of partial isometries into the self adjoint
vector space of partial isometries through the adjoint action. The equivalence
class is however not Abelian.
\end{remark}

