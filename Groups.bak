_{\mathbb{C}}\right)  \right)  \oplus_{\mathbb{R}}\mathcal{C}_{\mathfrak{H}%
_{\mathbb{R}}}\left(  \mathcal{R}_{e}\left(  \operatorname{Im}_{\mathfrak{e}%
}\mathfrak{H}_{\mathbb{C}}\right)  \right) \\
=\mathcal{R}_{\mathfrak{e}}\left(  \mathcal{C}_{U}\right)  \left(
