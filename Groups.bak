\begin{lemma}
The full tensor algebra is given by
\begin{equation}
\mathcal{H}_{\mathcal{F}}^{\otimes}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
\mathcal{H}^{1}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{H}_{\otimes}^{n}%
\end{equation}
and produces the reducible representation
\begin{equation}
\mathcal{D}_{\mathcal{H}_{\mathcal{F}}^{\otimes}}\left(  U\left(
\mathcal{H}^{1}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{D}_{\mathcal{H}_{\otimes}^{n}}\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  ,
\end{equation}
where
\begin{equation}
\mathcal{D}_{\mathcal{H}_{\otimes}^{n}}\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  \subset\mathcal{B}_{1}\left(  \mathcal{H}_{\otimes}%
^{n}\right)
\end{equation}
and%
\begin{equation}
\mathcal{D}_{\mathcal{H}_{\mathcal{F}}^{\otimes}}\left(  U\left(
\mathcal{H}^{1}\right)  \right)  \subset\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}^{\otimes}\right)  .
\end{equation}

\end{lemma}

\begin{lemma}
Each representation $\mathcal{D}_{\mathcal{H}^{n\otimes}}\left(  U\left(
\mathcal{H}^{1}\right)  \right)  $ can be decomposed into symmetry types as
\begin{equation}
\mathcal{D}_{\mathcal{H}_{\otimes}^{n}}\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{1\leq j\leq\times\left(  n\right)  }}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq j\leq\times\left(  n\right)  }}
%EndExpansion
\mathcal{D}_{\mathcal{H}_{\otimes}^{n}}\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  _{j},
\end{equation}
where the partition function $\times\left(  n\right)  \,\equiv$ is the number
of partitions of $n\equiv$ number of Young Diagrams of order $n.$
\end{lemma}

\begin{remark}
\underline{\emph{No closed-form}} expression for the partition function
$\times\left(  n\right)  $ is known, but it has both asymptotic expansions
that accurately approximate it and recurrence relations by which it can be
calculated exactly. It grows as an exponential function of the square root of
its argument. The \emph{multiplicative invers}e of its generating function is
the \emph{Euler function}; by \emph{Euler's pentagonal number theorem} this
function is an alternating sum of pentagonal number powers of its argument$.$
\end{remark}

\subsubsection{Tensor Products of Representations}

In particular the irreducible representation associated with $n^{th}$ rank
antisymmetric tensors is
\begin{equation}
\mathcal{D}_{\mathcal{H}_{\otimes}^{n}}\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  _{\left[  1^{n},0^{r-n}\right]  }=\mathcal{D}%
_{\mathcal{H}^{n}}\left(  U\left(  \mathcal{H}^{1}\right)  \right)
\end{equation}
and the \emph{reducible} representation associated with the exterior algebra
$\mathcal{H}_{\mathcal{F}}$
\begin{equation}
\mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{D}_{\mathcal{H}^{n}}\left(  U\left(  \mathcal{H}^{1}\right)  \right)
.
\end{equation}
The Young symbols appearing in the tensor product representation $\left(
\mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\otimes\mathcal{D}_{\mathcal{H}%
_{\mathcal{F}}}^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)
$ are
\begin{align}
&  \left[  1^{n},0^{r-n}\right] \\
&  \left[  0,1,0^{r-n-1}\right]  ,\left[  0,0,1,0^{r-n-2}\right]
,\cdots,\left[  0^{r-n},1\right] \\
&  \left[  3,0^{r-3}\right] \\
&  \left[  2,1,0^{r-n-2}\right]  ,\left[  2,0,1,0^{r-n-2}\right]
,\cdots,\left[  2,0^{r-2},1\right] \\
&  \left[  0,2,0^{r-n-2}\right] \\
&  \left[  0,1,1,0^{r-3}\right]  ,\left[  0,1,0,1,0^{r-n-4}\right]
,\cdots,\left[  0,1,0^{r-n-3},1\right] \\
&  \left[  1,1,0^{r-2}\right]  ,\left[  1,0,1,0^{r-n-2}\right]  ,\cdots
,\left[  1,0^{r-n-2},1\right]  \text{ Two copies of each ot these.}\\
&  \left[  1,0^{r-n-1}\right] \\
&  \left[  2,0^{r-n-1}\right]
\end{align}


\begin{remark}
$\mathcal{D}_{\mathcal{H}_{\mathcal{F}}}^{\#}$ denotes the complex conjugate representation.
\end{remark}

The mapping which to every matrix $\mathcal{R}\left(  M\right)  \in
GL(n,\mathbb{C})$ associates the

matrix $\mathcal{R}\left(  M\right)  ^{-1t}\in GL(n,\mathbb{C})$ is a faithful
irreducible representation of $GL(n,\mathbb{C})$ of dimension $n$, called the
\emph{dual} or \emph{contragredient representation} of the vector
representation and denoted $\mathcal{R}^{d}$ i.e
\begin{equation}
\mathcal{R}^{d}\left(  M^{d}\right)  =\mathcal{R}\left(  M\right)  ^{-1t}.
\end{equation}


Considering that the matrix $\mathcal{R}\left(  M\right)  $ represents a
regular linear map%
\begin{equation}
M:V\rightarrow W
\end{equation}
in a given bases, where $V$ and $W$ are $n$-dimensional complex vector spaces,
then $\mathcal{R}\left(  M\right)  ^{-1}$ represents a map
\begin{equation}
M^{-1}:W\rightarrow V
\end{equation}
and $\mathcal{R}\left(  M\right)  ^{-1t}$ a representation of a map
\begin{equation}
M^{d-1}:V^{d}\rightarrow W^{d},
\end{equation}
where $V^{d}$ and $W^{d}$ are the dual spaces of $V$ and $W$, respectively.

Another irreducible representation of dimension $n$ of the group
$GL(n,\mathbb{C})$ is produced by the dual of the complex conjugate, denoted
$\mathcal{R}^{\#d}$ to%
\begin{equation}
\mathcal{R}^{\#d}\left(  M\right)  =\mathcal{R}\left(  M\right)
^{\#-1t}=\mathcal{R}\left(  M\right)  ^{-\dagger}%
\end{equation}
i.e. the Hermitian conjugate of its inverse.

In the case of the unitary group $U(n)$ and its subgroups $SU(n),O(n),SO(n)..$%
., the dual representation coincides with the complex conjugate representation
as
\begin{equation}
\mathcal{R}\left(  M^{d}\right)  =\mathcal{R}^{d}\left(  M\right)
=\mathcal{R}\left(  M\right)  ^{-1t}=\mathcal{R}\left(  M\right)  ^{\dagger
t}=\mathcal{R}\left(  M\right)  ^{\#tt}=\mathcal{R}\left(  M\right)  ^{\#}.
\end{equation}


\begin{remark}
\emph{Adjoint representation of }$U(n):\ $

Besides the vector representation $\mathcal{R}$ and its complex conjugate
$\mathcal{R}^{\#}$, another irrep. of $SU(n)$, is the adjoint representation.
Consider the tensor product%
\begin{equation}
\mathcal{R\otimes R}^{\#}%
\end{equation}
of the vector representation and its complex conjugate. Representing them by
Young diagrams one finds the Clebsch--Gordan series%
\begin{equation}%
\begin{array}
[c]{c}
\end{array}
\otimes%
\begin{array}
[c]{c}%
\\
\\
\vdots\\
\\
\overset{\underbrace{\qquad\qquad}}{n-1}%
\end{array}
=%
\begin{array}
[c]{c}%
\\
\\
\vdots\\
\\
\\
\overset{\underbrace{\qquad\qquad}}{n}%
\end{array}
\oplus%
\begin{array}
[c]{c}%
\begin{array}
[c]{cc}
&
\end{array}
\quad\\%
\begin{array}
[c]{c}
\end{array}
\quad\quad\quad\\
\vdots\qquad\qquad\\%
\begin{array}
[c]{c}
\end{array}
\quad\qquad\\
\overset{\underbrace{\qquad\qquad\qquad\qquad\qquad\qquad}}{\left(
n-1\right)  +1\text{ boxes}}%
\end{array}
\end{equation}
where the first Young diagram on the right-hand side stands for the trivial
representation. Denoting the representations by their respective dimensions
one obtains
\begin{equation}
n\mathcal{\otimes}n^{\#}=1\oplus\left(  n^{2}-1\right)
\end{equation}
i.e. $n\mathcal{\otimes}n^{\#}$ decomposes into the direct sum of two
irreducible representations, one of which is the trivial representation. The
second one, with dimension $\left(  n^{2}-1\right)  $ is called the
\emph{adjoint representation}$.$
\end{remark}

\begin{example}
The group $U(2)$ is defined by the spin $\frac{1}{2}$representation
$\mathcal{D}_{\frac{1}{2}}$ $\left(  U(2)\right)  \subset\mathcal{B}\left(
\mathbb{C}^{2}\right)  \equiv\mathcal{M}\left(  2,\mathbb{C}^{2}\right)  $:
\end{example}

\begin{example}
The tensor product $\mathcal{D}_{\frac{1}{2}}\otimes\mathcal{D}_{\frac{1}{2}%
}^{\#}$ of the spin$\frac{1}{2}$representation $\mathcal{D}_{\frac{1}{2}}$ of
$U\left(  2\right)  $ with its complex conjugate $\mathcal{D}_{\frac{1}{2}%
}^{\#}$ produces a direct sum of an \emph{adjoint representation,} which is a
triplet spin $1$ and a trivial representation a singlet spin $0$. The defining
representation of $U\left(  2\right)  \subset$ $\mathcal{B}\left(
\mathcal{H}^{1}\right)  $ acts in $\mathbb{C}^{2}$, which is a particular
representation of the Hilbert space $\mathcal{H}^{1},$where $\dim\left\{
\mathcal{H}^{1}\right\}  =2,$ i.e.
\begin{equation}
\mathcal{D}_{\frac{1}{2}}:\mathcal{B}\left(  \mathcal{H}^{1}\right)
\rightarrow\mathcal{B}\left(  \mathbb{C}^{2}\right)  \equiv\mathcal{M}\left(
2,\mathbb{C}^{2}\right)
\end{equation}
and the group element $u\in U\left(  2\right)  $ is represented wrt the basis
$\left\{  \alpha,\beta\right\}  $ of $\mathcal{H}^{1}$ by
\begin{equation}
u\left(  \alpha,\beta\right)  =\left(  \alpha,\beta\right)  \mathcal{R}%
_{\frac{1}{2}}\left(  u\right)  =\left(  \alpha,\beta\right)  \mathcal{D}%
_{\frac{1}{2}}\left(  u\right)  =\left(  \alpha,\beta\right)  \left(
\begin{array}
[c]{cc}%
u_{\alpha\alpha} & u_{\alpha\beta}\\
u_{\beta\alpha} & u_{\beta\beta}%
\end{array}
\right)  .
\end{equation}
The tensor product representation $\mathcal{D}_{\frac{1}{2}}\otimes
\mathcal{D}_{\frac{1}{2}}^{\#}$ acts in the representation space
$\mathbb{C}^{2}\otimes\mathbb{C}^{2}$ which is a representation of the space
$\mathcal{H}^{1}\otimes\mathcal{H}^{1},$ which can be analysed as
\begin{align}
\mathcal{H}^{1}  &  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\alpha,\beta\right\} \\
\mathcal{H}^{1}\otimes\mathcal{H}^{1}  &  =\mathcal{H}^{1}\wedge
\mathcal{H}^{1}\oplus\mathcal{H}^{1}\vee\mathcal{H}^{1}\\
\wedge^{2}\mathcal{H}^{1}  &  =\mathcal{H}^{1}\wedge\mathcal{H}^{1}%
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \alpha\wedge\beta\right\}
\\
\vee^{2}\mathcal{H}^{1}  &  =\mathcal{H}^{1}\vee\mathcal{H}^{1}=\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \alpha\vee\beta,\alpha\vee\alpha
,\beta\vee\beta\right\}  ,
\end{align}
and is given by
\begin{align}
\mathbb{C}^{2}  &  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \right\} \\
\mathbb{C}^{2}\otimes\mathbb{C}^{2}  &  =\mathbb{C}^{2}\wedge\mathbb{C}%
^{2}\oplus\mathbb{C}^{2}\vee\mathbb{C}^{2}\\
\wedge^{2}\mathbb{C}^{2}  &  =\mathbb{C}^{2}\wedge\mathbb{C}^{2}%
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \wedge\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \right\}  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
0\\
1\\
-1\\
0
\end{array}
\right)  \right\} \\
\vee^{2}\mathbb{C}^{2}  &  =\mathbb{C}^{2}\vee\mathbb{C}^{2}=\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \vee\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \vee\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \vee\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \right\} \\
&  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
0\\
1\\
1\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\}  .
\end{align}
The \emph{adjoint reprentation} $\mathcal{D}_{\operatorname*{Adj}}$
\begin{equation}
\mathcal{D}_{\operatorname*{Adj}}=\operatorname*{Adj}\circ\mathcal{D}%
_{\frac{1}{2}}:U\left(  2\right)  \rightarrow\mathcal{B}\left(  \mathbb{C}%
^{2}\right)
\end{equation}
is explicitly given by considering the Pauli basis $\left\{  I_{2},\sigma
_{1},\sigma_{2},\sigma_{3}\right\}  $ of $\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  $, which produces the following invariant subspaces of
$\mathcal{B}\left(  \mathcal{H}^{1}\right)  $
\begin{align}
\mathcal{B}\left(  \mathbb{C}^{2}\right)  _{0}  &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  I_{2}\right\}  \cong\mathbb{C}^{2}%
\wedge\mathbb{C}^{2}\\
\mathcal{B}\left(  \mathbb{C}^{2}\right)  _{1}  &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \sigma_{1},\sigma_{2},\sigma_{3}\right\}
\cong\mathbb{C}^{2}\vee\mathbb{C}^{2},
\end{align}
i.e
\begin{equation}
\mathcal{B}\left(  \mathbb{C}^{2}\right)  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  I_{2}\right\}  \oplus\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \sigma_{1},\sigma_{2},\sigma_{3}\right\}
=\mathcal{B}\left(  \mathbb{C}^{2}\right)  _{0}\oplus\mathcal{B}\left(
\mathbb{C}^{2}\right)  _{1},
\end{equation}
and have the representations
\begin{align}
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \boldsymbol{I}_{2}\right\}
&  \cong\mathbb{C}^{2}\wedge\mathbb{C}^{2}\\
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \mathbf{\sigma}%
_{1},\mathbf{\sigma}_{2},\mathbf{\sigma}_{3}\right\}   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
0 & -i\\
i & 0
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \right\}  \cong\mathbb{C}^{2}\vee\mathbb{C}^{2}.
\end{align}
The adjoint map has the properties
\begin{align}
\operatorname*{Adj}  &  :U\left(  2\right)  \rightarrow\mathcal{B}\left(
\mathcal{B}\left(  \mathbb{C}^{2}\right)  \right) \\
\operatorname*{Adj}\left(  u\right)  \left(  I_{2}\right)   &  =I_{2}%
\qquad\forall u\in U\left(  2\right) \\
\operatorname*{Adj}\left(  u\right)  \left\{  \overset{}{\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \sigma_{1},\sigma_{2},\sigma
_{3}\right\}  }\right\}   &  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \sigma_{1},\sigma_{2},\sigma_{3}\right\}
\end{align}
and the effect of its representation is expliccitly given by
\begin{align}
\mathcal{D}_{\frac{1}{2}}\left(  u\right)   &  =\left(
\begin{array}
[c]{cc}%
u_{\alpha\alpha} & u_{\alpha\beta}\\
u_{\beta\alpha} & u_{\beta\beta}%
\end{array}
\right)  \in\mathcal{D}_{\frac{1}{2}}\left(  U\left(  2\right)  \right) \\
\mathcal{D}_{\operatorname*{Adj}}\left(  u\right)  \left(  \mathcal{D}%
_{\frac{1}{2}}\left(  v\right)  \right)   &  =\left(  \operatorname*{Adj}%
\circ\mathcal{D}_{\frac{1}{2}}\left(  u\right)  \right)  \left(
\mathcal{D}_{\frac{1}{2}}\left(  v\right)  \right) \\
\left(
\begin{array}
[c]{cc}%
u_{\alpha\alpha} & u_{\alpha\beta}\\
u_{\beta\alpha} & u_{\beta\beta}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
v_{\alpha\alpha} & v_{\alpha\beta}\\
v_{\beta\alpha} & v_{\beta\beta}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
u_{\alpha\alpha} & u_{\alpha\beta}\\
u_{\beta\alpha} & u_{\beta\beta}%
\end{array}
\right)  ^{\dagger}  &  =\left(
\begin{array}
[c]{cc}%
u_{\alpha\alpha} & u_{\alpha\beta}\\
u_{\beta\alpha} & u_{\beta\beta}%
\end{array}
\right)  \left\{  z_{0}\boldsymbol{I}_{2}+z_{1}\mathbf{\sigma}_{1}%
+z_{2}\mathbf{\sigma}_{2}+z_{3}\mathbf{\sigma}_{3}\right\}  \left(
\begin{array}
[c]{cc}%
u_{\alpha\alpha} & u_{\alpha\beta}\\
u_{\beta\alpha} & u_{\beta\beta}%
\end{array}
\right)  ^{\dagger}\\
&  =w_{0}\boldsymbol{I}_{2}+w_{1}\mathbf{\sigma}_{1}+w_{2}\mathbf{\sigma}%
_{2}+w_{3}\mathbf{\sigma}_{3}.
\end{align}

\end{example}

\begin{remark}
$\mathcal{D}_{\operatorname*{Adj}}$ is in general reducible.
\end{remark}

\begin{example}%
\begin{equation}
\left(  \mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\otimes\mathcal{D}%
_{\mathcal{H}_{\mathcal{F}}}^{\#}\right)  \left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  =\mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\left(  U\left(
\mathcal{H}^{1}\right)  \right)  \otimes\mathcal{D}_{\mathcal{H}_{\mathcal{F}%
}}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  ^{\#}\cong%
\operatorname*{Adj}\left(  \mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\left(
U\left(  \mathcal{H}^{1}\right)  \right)  \right)  .
\end{equation}

\end{example}

\begin{lemma}%
\begin{equation}
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  =\left(
\mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}^{\#}\right)
\left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[  1^{n}%
,0^{r-n}\right]  }\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }%
\end{equation}
and
\begin{equation}
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }=\mathcal{D}_{\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{p}}\left(  U\left(  \mathcal{H}^{1}\right)  \right)
.
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{align}
\left(  \mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\otimes\mathcal{D}%
_{\mathcal{H}_{\mathcal{F}}}^{\#}\right)  \left(  U\left(  \mathcal{H}%
^{1}\right)  \right)   &  =%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq r}}
%EndExpansion
\left\{  \left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}%
_{\mathcal{H}^{n}}^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)
\right)  _{\left[  1^{n},0^{r-n}\right]  }\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }\right\} \\
&  =%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq r}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
1^{n},0^{r-n}\right]  }\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }.
\end{align}

\end{lemma}

\begin{definition}%
\begin{equation}
\mathcal{D}_{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{ep}%
}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq p}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }.
\end{equation}

\end{definition}

\begin{lemma}%
\begin{align}%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }  &  =%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq p}}
%EndExpansion
\left(  \mathcal{D}_{\mathcal{H}^{n}}\otimes\mathcal{D}_{\mathcal{H}^{n}}%
^{\#}\right)  \left(  U\left(  \mathcal{H}^{1}\right)  \right)  _{\left[
2^{p},1^{r-2p},0^{r-n}\right]  }\\
&  =%
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq r}}
%EndExpansion
\mathcal{D}_{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{ep}%
}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  .
\end{align}

\end{lemma}

\begin{lemma}%
\begin{equation}
\left(  \mathcal{D}_{\mathcal{H}_{\mathcal{F}}}\otimes\mathcal{D}%
_{\mathcal{H}_{\mathcal{F}}}^{\#}\right)  \left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  =\mathcal{D}_{\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\left(  U\left(  \mathcal{H}^{1}\right)  \right)  .
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{equation}
\mathcal{D}_{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{ep}%
}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  \subset\mathcal{D}%
_{\mathcal{F}_{ep}}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  .
\end{equation}

\end{lemma}

\subsubsection{Generalized Contraction and Expansion maps on the Even
Subalgebra}

\paragraph{Generalized Expansion}

\begin{definition}
The generalized expansion map, $\Gamma,$ \emph{restricted to the particle
conserving subspace of operators}
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
is defined on the direct sum decomposition
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
and maps Ket-Bras into second quantized operators and is expressed in terms of
the expansion maps $\left\{  \left.  \Gamma_{p}^{n}\right\vert 0\leq p\leq
n\leq r\right\}  $ as
\begin{equation}
\Gamma\left(  X_{e}\right)  =\sum_{0\leq n\leq r}\Gamma^{n}\left(
X_{e}\right)  =\Gamma^{0}\left(  X_{e}\right)  +\cdots+\Gamma^{r}\left(
X_{e}\right)  =\sum_{0\leq n\leq r}\sum_{0\leq p\leq n}\binom{n}{p}\Gamma
_{p}^{n}\left(  X_{e1\cdots p}\right)  ,
\end{equation}
where
\begin{equation}
\Gamma^{n}\left(  X_{e}\right)  =\sum_{0\leq p\leq n}\binom{n}{p}\Gamma
_{p}^{n}\left(  X_{e1\cdots p}\right)  =\binom{0}{0}\Gamma_{p}^{n}\left(
X_{e1\cdots0}\right)  +\cdots+\binom{n}{p}\Gamma_{p}^{n}\left(  X_{e1\cdots
p}\right)  +\cdots+\binom{n}{n}\Gamma_{p}^{n}\left(  X_{e1\cdots n}\right)  .
\end{equation}
In \emph{operator matrix} notation
\begin{equation}
\Gamma\left(  X_{e}\right)  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & \cdots & \cdots & 0\\
\vdots & \ddots & 0 & \cdots & \vdots\\
\binom{n}{0}\Gamma_{0}^{n} & \cdots & \binom{n}{n}\Gamma_{n}^{n} & \cdots &
0\\
\vdots & \cdots & \vdots & \ddots & \vdots\\
\binom{r}{0}\Gamma_{0}^{r} & \cdots & \binom{r}{n}\Gamma_{n}^{r} & \cdots &
\binom{r}{r}\Gamma_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
\vdots\\
X_{e1\cdots n}\\
\vdots\\
X_{e1\cdots r}%
\end{array}
\right)  .
\end{equation}

\end{definition}

\begin{example}
$r=4$%
\begin{equation}
\Gamma\left(  X_{e}\right)  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & 0 & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1} & \binom{1}{1}\Gamma_{1}^{1} & 0 & 0 & 0\\
\binom{2}{0}\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \binom{2}{2}%
\Gamma_{2}^{2} & 0 & 0\\
\binom{3}{0}\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{0}^{3} & \binom{3}{2}%
\Gamma_{0}^{3} & \binom{3}{3}\Gamma_{3}^{3} & 0\\
\binom{4}{0}\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}%
\Gamma_{2}^{4} & \binom{4}{3}\Gamma_{3}^{4} & \binom{4}{4}\Gamma_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e12}\\
X_{e123}\\
X_{e1234}%
\end{array}
\right)
\end{equation}

\end{example}

\begin{lemma}
If
\begin{equation}
X_{e}=\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
X_{e1\cdots n}\\
0\\
\vdots\\
0
\end{array}
\right)
\end{equation}
then
\begin{equation}
\Gamma\left(  X_{e}\right)  =\Gamma\left(  X_{e1\cdots n}\right)  =\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\Gamma^{n}\left(  X_{e1\cdots n}\right) \\
0\\
\vdots\\
0
\end{array}
\right)  \leftrightarrow\Gamma^{n}\left(  X_{e1\cdots n}\right)  .
\end{equation}

\end{lemma}

\begin{example}
$r=4$%
\begin{align}
\Gamma\left(  X^{1}\right)   &  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & 0 & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1} & \binom{1}{1}\Gamma_{1}^{1} & 0 & 0 & 0\\
\binom{2}{0}\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \binom{2}{2}%
\Gamma_{2}^{2} & 0 & 0\\
\binom{3}{0}\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & \binom{3}{2}%
\Gamma_{2}^{3} & \binom{3}{3}\Gamma_{3}^{3} & 0\\
\binom{4}{0}\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}%
\Gamma_{1}^{4} & \binom{4}{3}\Gamma_{1}^{4} & \binom{4}{4}\Gamma_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
X^{1}\\
0\\
0\\
0
\end{array}
\right)  =\Gamma^{1}\left(  X^{1}\right)  =\left(
\begin{array}
[c]{c}%
\Gamma^{1}\left(  X^{1}\right)  ^{0}\\
\Gamma^{1}\left(  X^{1}\right)  ^{1}\\
\Gamma^{1}\left(  X^{1}\right)  ^{2}\\
\Gamma^{1}\left(  X^{1}\right)  ^{3}\\
\Gamma^{1}\left(  X^{1}\right)  ^{4}%
\end{array}
\right)  \leftrightarrow\left(
\begin{array}
[c]{c}%
0\\
\binom{1}{1}\Gamma_{1}^{1}\left(  X^{1}\right) \\
\binom{2}{1}\Gamma_{1}^{2}\left(  X^{1}\right) \\
\binom{3}{1}\Gamma_{1}^{3}\left(  X^{1}\right) \\
\binom{4}{1}\Gamma_{1}^{4}\left(  X^{1}\right)
\end{array}
\right) \\
&  \equiv\binom{1}{1}\Gamma_{1}^{1}\left(  X^{1}\right)  +\binom{2}{1}%
\Gamma_{1}^{2}\left(  X^{1}\right)  +\binom{3}{1}\Gamma_{1}^{3}\left(
X^{1}\right)  +\binom{4}{1}\Gamma_{1}^{4}\left(  X^{1}\right)  .
\end{align}

\end{example}

\begin{example}
$r=4$%
\begin{align}
\Gamma\left(  X^{0}\right)   &  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & 0 & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1} & \binom{1}{1}\Gamma_{1}^{1} & 0 & 0 & 0\\
\binom{2}{0}\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \binom{2}{2}%
\Gamma_{2}^{2} & 0 & 0\\
\binom{3}{0}\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & \binom{3}{2}%
\Gamma_{2}^{3} & \binom{3}{3}\Gamma_{3}^{3} & 0\\
\binom{4}{0}\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}%
\Gamma_{1}^{4} & \binom{4}{3}\Gamma_{1}^{4} & \binom{4}{4}\Gamma_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X^{0}\\
0\\
0\\
0\\
0
\end{array}
\right)  =\Gamma^{0}\left(  X^{0}\right)  =\left(
\begin{array}
[c]{c}%
\Gamma^{0}\left(  X^{0}\right)  ^{0}\\
\Gamma^{0}\left(  X^{0}\right)  ^{1}\\
\Gamma^{0}\left(  X^{0}\right)  ^{2}\\
\Gamma^{0}\left(  X^{0}\right)  ^{3}\\
\Gamma^{0}\left(  X^{0}\right)  ^{4}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\binom{0}{0}\Gamma_{0}^{0}\left(  X^{0}\right) \\
\binom{1}{0}\Gamma_{0}^{1}\left(  X^{0}\right) \\
\binom{2}{0}\Gamma_{o}^{2}\left(  X^{0}\right) \\
\binom{3}{0}\Gamma_{0}^{3}\left(  X^{0}\right) \\
\binom{4}{0}\Gamma_{0}^{4}\left(  X^{0}\right)
\end{array}
\right) \\
&  \leftrightarrow\binom{0}{0}\Gamma_{0}^{0}\left(  X^{0}\right)  +\binom
{1}{0}\Gamma_{0}^{1}\left(  X^{0}\right)  +\binom{2}{0}\Gamma_{0}^{2}\left(
X^{0}\right)  +\binom{3}{0}\Gamma_{0}^{3}\left(  X^{0}\right)  +\binom{4}%
{0}\Gamma_{0}^{4}\left(  X^{0}\right)  .
\end{align}


\begin{remark}
$\lceil A=$Bottom Triangular;$B$ $=$Bottom Triangular; $T$ $=\,$Upper
Triangular%
\begin{align}
A^{n}\left(  x\right)   &  =A^{n}\cdot x=\left(  \mathbb{A}\mathbf{x}\right)
^{n}=\sum_{0\leq p\leq r}A_{p}^{n}x^{p}=y^{n}\\
B^{n}\left(  x\right)   &  =B^{n}\cdot x=\left(  \mathbb{B}\mathbf{x}\right)
^{n}=\sum_{0\leq p\leq n}B_{p}^{n}x^{p}=y^{n}\\
T^{n}\left(  x\right)   &  =T^{n}\cdot x=\left(  \mathbb{T}\mathbf{x}\right)
^{n}=\sum_{n\leq p\leq r}T_{p}^{n}x^{p}=y^{n}%
\end{align}
giving the contravariant vector%
\begin{equation}
y=\left(
\begin{array}
[c]{c}%
y^{0}\\
y^{1}\\
y^{2}\\
y^{3}\\
y^{4}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
A^{0}\left(  x\right) \\
A^{1}\left(  x\right) \\
A^{2}\left(  x\right) \\
A^{3}\left(  x\right) \\
A^{4}\left(  x\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
A^{0}\cdot x\\
A^{1}\cdot x\\
A^{2}\cdot x\\
A^{3}\cdot x\\
A^{4}\cdot x
\end{array}
\right)  ,
\end{equation}
where $\left\{  \left.  A^{j}\right\vert 0\leq j\leq r\right\}  $ are the rows
of the matrix $A.$
\end{remark}
\end{example}

\begin{remark}
\emph{Contravariant coordinate} indices of a the vector are \emph{upper},
while \emph{covariant coordinate} indices of a vector are \emph{lower}, hence
row indices of a matrix are contravariant i,e, upper, while column indices are
covaraint i.e. lower.
\end{remark}

\begin{remark}
Row vectors have lower indices i.e. are covariant, Column vectors have upper
indices and thus contravariant. Labels denoting row vectors are thus naturally
upper, while labels denoting column vectors are thus naturally lower. Thus a
basis of column vectors would be the row super vector
\begin{equation}
\left(  v^{1},v^{2},\cdots,v^{r}\right)  ,
\end{equation}
while a basis of row vectors would be the column super vector
\begin{equation}
\left(
\begin{array}
[c]{c}%
v_{1}\\
\vdots\\
v_{r}%
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{example}
contuing. .......giving%
\begin{align}
\Gamma^{n}\left(  X_{e}\right)   &  =\Gamma^{n}\cdot X_{e}=\sum_{0\leq p\leq
r}\binom{n}{p}\Gamma_{p}^{n}\left(  X_{e1\cdots p}\right)  =\sum_{0\leq p\leq
n}\binom{n}{p}\Gamma_{p}^{n}\left(  X_{e1\cdots p}\right) \\
&  =\binom{n}{0}\Gamma_{0}^{n}\left(  X_{e0}\right)  +\binom{n}{1}\Gamma
_{1}^{n}\left(  X_{e1}\right)  +\cdots+\binom{n}{p}\Gamma_{p}^{n}\left(
X_{e1\cdots p}\right)  +\cdots+\binom{n}{n}\Gamma_{n}^{n}\left(  X_{e1\cdots
n}\right)  ,
\end{align}
where
\begin{equation}
\Gamma^{n}=\left(  \binom{n}{0}\Gamma_{0}^{n},\cdots,\binom{n}{p}\Gamma
_{p}^{n},\cdots,\binom{n}{n}\Gamma_{n}^{n}%
,\overset{r-n}{\overleftrightarrow{0,\cdots,0}}\right)
\end{equation}
and correspond to the rows of the expansion operator matrix.
\end{example}

\begin{example}
$r=6$%
\begin{align}
\Gamma^{0}  &  =\left(  \binom{0}{0}\Gamma_{0}^{n}%
\overset{6}{,\overleftrightarrow{0,\cdots,0}}\right) \\
