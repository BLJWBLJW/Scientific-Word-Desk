\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0-1}=\ker\left\{  L_{2}%
^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\} \\
=\left(  \ker\left\{  L_{2}^{0}\right\}  _{2d}\oplus\ker\left\{  L_{2}%
^{0}\right\}  _{1d}\oplus\ker\left\{  L_{2}^{0}\right\}  _{0d}\right)
\ominus\left(  \ker\left\{  L_{2}^{1}\right\}  _{2d}\oplus\ker\left\{
L_{2}^{1}\right\}  _{1d}\oplus\ker\left\{  L_{2}^{1}\right\}  _{0d}\right) \\
=\left(  \ker\left\{  L_{2}^{0}\right\}  _{1d}\oplus\ker\left\{  L_{2}%
^{0}\right\}  _{0d}\right)  \ominus\left(  \ker\left\{  L_{2}^{1}\right\}
_{1d}\oplus\ker\left\{  L_{2}^{1}\right\}  _{0d}\right)  ,\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0-1}\right\}
=35-20=15,
\end{gather}


