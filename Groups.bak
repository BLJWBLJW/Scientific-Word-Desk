\begin{example}
\emph{SECOND QUANTIZATION }

Let
\begin{equation}
X_{e}=\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert
\end{equation}
then
\begin{align}
&  a_{l_{1}}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}=\Gamma\left(
\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  =\Gamma^{2}\left(
\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right) \nonumber\\
&  =\sum_{\substack{0\leq N,M\leq\infty\\1\leq j_{1}<\cdots<j_{N}\leq
\infty\\1\leq k_{1}<\cdots<k_{M}\leq\infty}}\left\vert \varphi_{l_{1}}%
\varphi_{l_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\left.  \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{M}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}%
}\varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}\left(
N+1\right)  \left(  N+2\right)  \left\vert \varphi_{l_{1}}\wedge\varphi
_{l_{2}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{m_{1}}\wedge\varphi_{m_{2}}\wedge\varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\left(  N+1\right)  \left(  N+2\right)  \left\vert
\varphi_{l_{1}}\right\rangle \left\langle \varphi_{m_{1}}\right\vert
\mathcal{\boxtimes}\left\vert \varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{2}}\right\vert \mathcal{\boxtimes}P_{\mathcal{H}^{N}}=\sum_{0\leq
N\leq\infty}\frac{\left(  N+1\right)  \left(  N+2\right)  }{2}\left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \mathcal{\boxtimes}P_{\mathcal{H}^{N}}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\frac{\left(  N+1\right)  \left(  N+2\right)  }%
{2}\Gamma_{2}^{N}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
=\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert +3\Gamma_{2}^{3}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  +6\Gamma_{2}^{4}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  +\cdots\nonumber\\
&  =\binom{2}{2}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert +\binom{3}{2}\Gamma
_{2}^{3}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  +\binom{4}%
{2}\Gamma_{2}^{4}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
+\cdots\nonumber\\
&  =\sum_{2\leq N\leq\infty}\binom{N}{2}\Gamma_{2}^{N}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  =\Gamma^{2}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  .
\end{align}
This gives
\begin{align}
&  \Gamma\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  =a_{l_{1}%
}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}\leftrightarrow\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
a_{l_{1}}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}\\
0\\
\vdots\\
0
\end{array}
\right)  \cong\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\Gamma^{2}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  _{2}\\
\vdots\\
\Gamma^{2}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  _{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\binom{2}{2}\Gamma_{2}^{2}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
\\
\vdots\\
\binom{r}{2}\Gamma_{2}^{r}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
\end{array}
\right)  \leftrightarrow\binom{2}{2}\Gamma_{2}^{r}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  +\cdots+\binom{r}{2}\Gamma_{2}^{r}\left(
\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  .
\end{align}

\end{example}

\begin{example}
$r=2$

The genral structure of the Ket-Bra second quantization map is
\begin{equation}
\Gamma\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right)  =\left(
\begin{array}
[c]{ccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1} & \binom{1}{1}\Gamma_{1}^{1} & 0\\
\binom{2}{0}\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \binom{2}{2}%
\Gamma_{2}^{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert \\
\left\vert \mathbf{\varphi}_{1}\right\rangle \left\langle \mathbf{\varphi}%
_{1}\right\vert \\
\left\vert \mathbf{\varphi}_{12}\right\rangle \left\langle \mathbf{\varphi
}_{12}\right\vert
\end{array}
\right)  =\left(  \mathbf{a}^{\dagger}\mathbf{a}\right)
\end{equation}
in detail viz in component detail
\begin{equation}%
\begin{array}
[c]{cccccc}%
I_{4} & a_{1}^{\dagger}a_{1} & a_{1}^{\dagger}a_{2} & a_{2}^{\dagger}a_{1} &
a_{2}^{\dagger}a_{2} & a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\\
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =\Gamma^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \Gamma\left(  \left\vert 1\right\rangle
\left\langle 1\right\vert \right)  =\Gamma^{1}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \Gamma\left(  \left\vert
1\right\rangle \left\langle 2\right\vert \right)  =\Gamma^{1}\left(
\left\vert 1\right\rangle \left\langle 2\right\vert \right)  & \Gamma\left(
\left\vert 2\right\rangle \left\langle 1\right\vert \right)  =\Gamma
^{1}\left(  \left\vert 2\right\rangle \left\langle 1\right\vert \right)  &
\Gamma\left(  \left\vert 2\right\rangle \left\langle 2\right\vert \right)
=\Gamma^{1}\left(  \left\vert 2\right\rangle \left\langle 2\right\vert \right)
& \Gamma\left(  \left\vert 12\right\rangle \left\langle 12\right\vert \right)
=\Gamma^{2}\left(  \left\vert 12\right\rangle \left\langle 12\right\vert
\right) \\
\binom{0}{0}\Gamma_{0}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \binom{0}{1}\Gamma_{1}^{0}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \binom{0}{1}\Gamma_{1}%
^{0}\left(  \left\vert 1\right\rangle \left\langle 2\right\vert \right)  &
\binom{0}{1}\Gamma_{1}^{0}\left(  \left\vert 2\right\rangle \left\langle
1\right\vert \right)  & \binom{0}{1}\Gamma_{1}^{0}\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  & \binom{0}{2}\Gamma_{2}%
^{0}\left(  \left\vert 12\right\rangle \left\langle 12\right\vert \right) \\
\binom{1}{0}\Gamma_{0}^{1}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \binom{1}{1}\Gamma_{1}%
^{1}\left(  \left\vert 1\right\rangle \left\langle 2\right\vert \right)  &
\binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert 2\right\rangle \left\langle
1\right\vert \right)  & \binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  & \binom{1}{2}\Gamma_{2}%
^{1}\left(  \left\vert 12\right\rangle \left\langle 12\right\vert \right) \\
\binom{2}{0}\Gamma_{0}^{2}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \binom{2}{1}\Gamma_{1}%
^{2}\left(  \left\vert 1\right\rangle \left\langle 2\right\vert \right)  &
\binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert 2\right\rangle \left\langle
1\right\vert \right)  & \binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  & \binom{2}{2}\Gamma_{2}%
^{2}\left(  \left\vert 12\right\rangle \left\langle 12\right\vert \right)
\end{array}
\end{equation}
giving
\begin{gather}
\parallel\\%
\begin{array}
[c]{cccccc}%
I_{4} & a_{1}^{\dagger}a_{1} & a_{1}^{\dagger}a_{2} & a_{2}^{\dagger}a_{1} &
a_{2}^{\dagger}a_{2} & a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\\
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =\Gamma^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \Gamma\left(  \left\vert 1\right\rangle
\left\langle 1\right\vert \right)  =\Gamma^{1}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \Gamma\left(  \left\vert
1\right\rangle \left\langle 2\right\vert \right)  =\Gamma^{1}\left(
\left\vert 1\right\rangle \left\langle 2\right\vert \right)  & \Gamma\left(
\left\vert 2\right\rangle \left\langle 1\right\vert \right)  =\Gamma
^{1}\left(  \left\vert 2\right\rangle \left\langle 1\right\vert \right)  &
\Gamma\left(  \left\vert 2\right\rangle \left\langle 2\right\vert \right)
=\Gamma^{1}\left(  \left\vert 2\right\rangle \left\langle 2\right\vert \right)
& \Gamma\left(  \left\vert 12\right\rangle \left\langle 12\right\vert \right)
=\Gamma^{2}\left(  \left\vert 12\right\rangle \left\langle 12\right\vert
\right) \\
\binom{0}{0}\Gamma_{0}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & 0 & 0 & 0 & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \binom{1}{1}\Gamma_{1}%
^{1}\left(  \left\vert 1\right\rangle \left\langle 2\right\vert \right)  &
\binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert 2\right\rangle \left\langle
1\right\vert \right)  & \binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  & 0\\
\binom{2}{0}\Gamma_{0}^{2}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert
1\right\rangle \left\langle 1\right\vert \right)  & \binom{2}{1}\Gamma_{1}%
^{2}\left(  \left\vert 1\right\rangle \left\langle 2\right\vert \right)  &
\binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert 2\right\rangle \left\langle
1\right\vert \right)  & \binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  & \binom{2}{2}\Gamma_{2}%
^{2}\left(  \left\vert 12\right\rangle \left\langle 12\right\vert \right)
\end{array}
.
\end{gather}
These matrices are wrt a Ket-Bra basis i.e. a Ket-Bra representation, a second
quantizated representation would look very different.
\end{example}

\begin{example}
\emph{Number Operators}: The\emph{ images} of the projectors onto the pure
particle subspaces are the n-number operators
\begin{equation}
\left(
\begin{array}
[c]{c}%
N_{0}\\
\vdots\\
N_{n}\\
\vdots\\
N_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\Gamma^{0}\left(  P_{e}\right) \\
\vdots\\
\Gamma^{n}\left(  P_{e}\right) \\
\vdots\\
\Gamma^{r}\left(  P_{e}\right)
\end{array}
\right)  =\Gamma\left(  P_{e}\right)  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & \cdots & \cdots & 0\\
\vdots & \ddots & 0 & \cdots & \vdots\\
\binom{n}{0}\Gamma_{0}^{n} & \cdots & \binom{n}{n}\Gamma_{n}^{n} & \cdots &
0\\
\vdots & \cdots & \vdots & \ddots & \vdots\\
\binom{r}{0}\Gamma_{0}^{r} & \cdots & \binom{r}{n}\Gamma_{n}^{r} & \cdots &
\binom{r}{r}\Gamma_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
P_{0}\\
\vdots\\
P_{n}\\
\vdots\\
P_{r}%
\end{array}
\right)  ,
\end{equation}
where
\begin{equation}
\Gamma_{p}^{n}\left(  P_{p}\right)  =P_{n}.
\end{equation}
In particular
\begin{align}
\Gamma^{n}\left(  P_{e}\right)   &  =\Gamma^{n}\cdot P_{e}=\sum_{0\leq p\leq
r}\binom{n}{p}\Gamma_{p}^{n}\left(  P_{p}\right)  =\sum_{0\leq p\leq n}%
\binom{n}{p}\Gamma_{p}^{n}\left(  P_{p}\right) \\
&  =\binom{n}{0}\Gamma_{0}^{n}\left(  P_{0}\right)  +\binom{n}{1}\Gamma
_{1}^{n}\left(  P_{1}\right)  +\cdots+\binom{n}{p}\Gamma_{p}^{n}\left(
P_{p}\right)  +\cdots+\binom{n}{n}\Gamma_{n}^{n}\left(  P_{n}\right) \\
&  =\binom{n}{0}P_{n}+\binom{n}{1}P_{n}+\cdots+\binom{n}{p}P_{n}+\cdots
+\binom{n}{n}P_{n}\\
&  =\left(  \binom{n}{0}+\cdots+\binom{n}{p}+\cdots+\binom{n}{n}\right)
P_{n}=2^{n}P_{n}%
\end{align}
$\lceil$%
\begin{equation}
n=4:\binom{4}{0}+\binom{4}{1}+\binom{4}{2}+\binom{4}{3}+\binom{4}%
{4}=1+4+6+4+1=16=2^{4}%
\end{equation}
$\rfloor$
\end{example}

The even subalgebra, $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e},$ (which is a \emph{Banach Algebra}, closed in the trace class norm, but
\emph{not} a $c^{\ast}$-algebra), is defined by the direct sum expansion
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=\bigoplus
\limits_{0\leq n\leq r}\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,
\end{equation}
where any element, $X\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}$ can be expanded in a ket-bra basis $\left\{  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right\}  \equiv$ $\left\{  \left.  \left\vert \mathbf{\varphi}_{1\cdots
p}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots p}\right\vert
\right\vert 0\leq p\leq r\right\}  $, where
\begin{gather}
\left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots p}\right\vert =\left(  \left\vert \varphi_{1}%
\cdots\varphi_{p}\right\rangle \left\langle \varphi_{1}\cdots\varphi
_{p}\right\vert ,\cdots,\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
,\cdots,\left\vert \varphi_{r-p}\cdots\varphi_{r}\right\rangle \left\langle
\varphi_{r-p}\cdots\varphi_{r}\right\vert \right) \\
\left\vert \mathbf{\varphi}_{1\cdots0}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots0}\right\vert \equiv\left\vert \phi\right\rangle
\left\langle \phi\right\vert \\
1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r\\
0\leq p\leq r,
\end{gather}
as
\begin{gather}
X=\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \mathbf{\varphi}_{1}\right\rangle \left\langle \mathbf{\varphi
}_{1}\right\vert ,\left\vert \mathbf{\varphi}_{12}\right\rangle \left\langle
\mathbf{\varphi}_{12}\right\vert ,\cdots,\left\vert \mathbf{\varphi}_{1\cdots
r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots r}\right\vert \right)
\left(
\begin{array}
[c]{c}%
\mathbf{X}_{e0}\\
\mathbf{\vdots}\\
\mathbf{X}_{e1\cdots n}\\
\mathbf{\vdots}\\
\mathbf{X}_{e1\cdots r}%
\end{array}
\right)  ,\\
X_{e1\cdots n}\in\mathcal{B}_{1}\left(  \mathbb{C}^{\binom{r}{n}}\right) \\
=\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert ,\left\vert
\mathbf{\varphi}_{1}\right\rangle \left\langle \mathbf{\varphi}_{1}\right\vert
,\left\vert \mathbf{\varphi}_{12}\right\rangle \left\langle \mathbf{\varphi
}_{12}\right\vert ,\cdots,\left\vert \mathbf{\varphi}_{1\cdots r}\right\rangle
\left\langle \mathbf{\varphi}_{1\cdots r}\right\vert \right)  \mathcal{R}%
_{\mathbf{\varphi}}\left(  X\right)  \quad\quad\quad\quad\\
=\left(  \left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  \mathbf{X}_{e0},\cdots,\left(  \left\vert \mathbf{\varphi}_{1\cdots
n}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots n}\right\vert \right)
\mathbf{X}_{e1\cdots r},\cdots,\left(  \left\vert \mathbf{\varphi}_{1\cdots
r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots r}\right\vert \right)
\mathbf{X}_{e1\cdots r}\right) \\
=\left(  X_{e0},\cdots,X_{e1\cdots n},\cdots,X_{e1\cdots r}\right)  ,\quad
X_{e1\cdots n}\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,
\end{gather}
where
\begin{equation}
X_{eJ}=\left(  \left\vert \mathbf{\varphi}_{J}\right\rangle \left\langle
\mathbf{\varphi}_{J}\right\vert \right)  \mathbf{X}_{eJ};\quad J=\phi
,1,12,123,\cdots,1\cdots r.
\end{equation}


\begin{example}
$r=4$

\begin{enumerate}
\item
\begin{align}
&  \left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \mathbf{\varphi}_{1}\right\rangle \left\langle \mathbf{\varphi
}_{1}\right\vert ,\left\vert \mathbf{\varphi}_{12}\right\rangle \left\langle
\mathbf{\varphi}_{12}\right\vert ,\left\vert \mathbf{\varphi}_{123}%
\right\rangle \left\langle \mathbf{\varphi}_{123}\right\vert ,\left\vert
\mathbf{\varphi}_{1234}\right\rangle \left\langle \mathbf{\varphi}%
_{1234}\right\vert \right)  =\\
&  \left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert
,\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert
,\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert ,\right. \\
&  \left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{4}\right\vert ,\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert ,\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
,\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{3}\varphi_{4}\right\vert ,\\
&  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\right\vert ,\left\vert \varphi_{1}%
\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{2}%
\varphi_{4}\right\vert ,\left\vert \varphi_{1}\varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{1}\varphi_{3}\varphi_{4}\right\vert
,\left\vert \varphi_{2}\varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\varphi_{4}\right\vert ,\\
&  \left.  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}%
\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\varphi
_{4}\right\vert \right)
\end{align}


\item
\begin{equation}
\mathcal{R}_{\mathbf{\varphi}}\left(  X\right)  =\left(
\begin{array}
[c]{c}%
\mathbf{X}_{e0}\\
\mathbf{X}_{e1}\\
\mathbf{X}_{e12}\\
\mathbf{X}_{e123}\\
\mathbf{X}_{e1234}%
\end{array}
\right)
\end{equation}


\item
\begin{align}
\mathbf{X}_{e0}  &  \in\mathbb{C}\\
\mathbf{X}_{e1}  &  \in\mathbb{C}^{4}\\
\mathbf{X}_{e12}  &  \in\mathbb{C}^{6}\\
\mathbf{X}_{e123}  &  \in\mathbb{C}^{4}\\
\mathbf{X}_{e1234}  &  \in\mathbb{C}%
\end{align}


\item
\begin{equation}
X_{e}=\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \mathbf{\varphi}_{1}\right\rangle \left\langle \mathbf{\varphi
}_{1}\right\vert ,\left\vert \mathbf{\varphi}_{12}\right\rangle \left\langle
\mathbf{\varphi}_{12}\right\vert ,\left\vert \mathbf{\varphi}_{123}%
\right\rangle \left\langle \mathbf{\varphi}_{123}\right\vert ,\left\vert
\mathbf{\varphi}_{1234}\right\rangle \left\langle \mathbf{\varphi}%
_{1234}\right\vert \right)  \mathcal{R}_{\mathbf{\varphi}}\left(  X\right)
\end{equation}

\end{enumerate}
\end{example}

\begin{theorem}
$\Gamma$ maps traceless operators to traceless operators.
\end{theorem}

\begin{proof}
Easily seen from the definition as $\left\{  \left.  \Gamma_{p}^{n}\right\vert
0\leq p\leq n\leq r\right\}  $ map traceless operators to traceless operators.
\end{proof}

\paragraph{Generalized Contraction Operator $L$}

The Generalized Contraction map
\begin{equation}
L:\bigoplus\limits_{0\leq n\leq r}\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  \rightarrow\bigoplus\limits_{0\leq n\leq r}\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)
\end{equation}
acting in the even subalgebra $\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}$ can be expressed in \emph{operator matrix} form
adapted to this direct sum decomposition as
\begin{equation}
L\left(  X_{e}\right)  =L\left(  X_{e}\right)  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}L_{0}^{0} & \cdots & \binom{n}{0}L_{n}^{0} & \cdots & \binom{r}%
{0}L_{r}^{0}\\
0 & \ddots & \vdots & \vdots & \vdots\\
\vdots & \ddots & \binom{n}{n}L_{n}^{n} & \cdots & \binom{r}{n}L_{r}^{n}\\
\vdots & \vdots & \ddots & \ddots & \vdots\\
0 & \cdots & \cdots & 0 & \binom{r}{r}L_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
\vdots\\
X_{e1\cdots n}\\
\vdots\\
X_{e1\cdots r}%
\end{array}
\right)
\end{equation}
giving%
\begin{equation}
L_{n}\left(  X_{e}\right)  =L_{n}\cdot X_{e}=\sum_{n\leq m\leq r}\binom{m}%
{n}L_{m}^{n}\left(  X_{e1\cdots m}\right)  =\binom{n}{n}L_{n}^{0}\left(
X_{e1\cdots n}\right)  +\cdots+\binom{m}{n}L_{n}^{m}\left(  X_{e1\cdots
m}\right)  +\cdots+\binom{r}{n}L_{n}^{r}\left(  X_{e1\cdots r}\right)  ,
\end{equation}
where
\begin{equation}
L_{n}=\left(  \overset{n}{\overleftrightarrow{0,\cdots,0}},\binom{n}{n}%
L_{n}^{n},\cdots,\binom{m}{n}L_{m}^{n},\cdots,\binom{r}{n}L_{r}^{n}\right)
\end{equation}
and
\begin{equation}
L_{n}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  .
\end{equation}


\begin{example}
$n=4,r=6$%
\begin{align}
L_{4}\left(  X_{e}\right)   &  =\sum_{4\leq m\leq6}\binom{m}{n}L_{m}%
^{n}\left(  X_{e1\cdots m}\right)  =\binom{4}{4}L_{4}^{4}\left(
X_{e1234}\right)  +\binom{5}{4}L_{5}^{4}\left(  X_{e12345}\right)  +\binom
{6}{4}L_{6}^{4}\left(  X_{e123456}\right) \\
&  =L_{4}\cdot X_{e}=\left(  0,0,0,0,\binom{4}{4}L_{4}^{4},\binom{5}{4}%
L_{5}^{4},\binom{6}{4}L_{6}^{4}\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e12}\\
X_{e123}\\
X_{e1234}\\
X_{e12345}\\
X_{e123456}%
\end{array}
\right)
\end{align}

\end{example}

\begin{example}
$r=6$%
\begin{align}
L_{0}  &  =\left(  \binom{0}{0}L_{0}^{0},\binom{1}{0}L_{1}^{0},\binom{2}%
{0}L_{2}^{0},\binom{3}{0}L_{3}^{0},\binom{4}{0}L_{4}^{0},\binom{5}{0}L_{5}%
^{0},\binom{6}{0}L_{6}^{0}\right) \\
L_{1}  &  =\left(  0,\binom{1}{1}L_{1}^{1},\binom{2}{1}L_{2}^{1},\binom{3}%
{1}L_{3}^{1},\binom{4}{1}L_{4}^{1},\binom{5}{1}L_{5}^{1},\binom{6}{1}L_{6}%
^{1}\right) \\
&  \vdots\\
L_{5}  &  =\left(  0,0,0,0,0,\binom{5}{5}L_{5}^{5},\binom{6}{5}L_{6}%
^{5},\right) \\
L_{6}  &  =\left(  0,0,0,0,0,0,\binom{6}{6}L_{6}^{6},\right)
\end{align}

\end{example}

\begin{example}%
\begin{equation}
L_{n}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)
=L_{n}\cdot B_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  =\left(
\overset{n}{\overleftrightarrow{0,\cdots,0}},\binom{n}{n}L_{n}^{n}%
,\cdots,\binom{m}{n}L_{m}^{n},\cdots,\binom{r}{n}L_{n}^{n}\right)  \left(
\begin{array}
[c]{c}%
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right) \\
\vdots\\
\mathcal{B}_{1}\left(  \mathcal{H}^{m}\right) \\
\vdots\\
\mathcal{B}_{1}\left(  \mathcal{H}^{r}\right)
\end{array}
\right)  .
\end{equation}

\end{example}

The generalized contraction and expansion maps are adjoints of each other
i.e.
\begin{align}
\left\langle \left.  \Gamma\left(  X\right)  \right\vert Y\right\rangle
_{\mathcal{F}}  &  =\left\langle \left.  X\right\vert L\left(  Y\right)
\right\rangle _{\mathcal{F}};\,X\in\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e},Y\in\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}\\
L^{\dagger}  &  =\Gamma
\end{align}
and
\begin{align}
\Gamma_{np}  &  =\binom{n}{p}\Gamma_{p}^{n}=\left(  L^{\dagger}\right)
_{pn}=\binom{n}{p}\left(  L_{n}^{p}\right)  ^{\dagger}\\
L_{np}  &  =\binom{n}{p}L_{n}^{p}=\left(  \Gamma^{\dagger}\right)
_{pn}=\binom{n}{p}\left(  \Gamma_{p}^{n}\right)  ^{\dagger}.
\end{align}


\begin{remark}
The role of $\left\{  n,p\right\}  $ for $\Gamma$ are reversed in $L$ i.e. row
labels become column labels and vice-versa.
\end{remark}

The action of $L$ on a fixed\emph{ ket-bra basis} can be expressed as
\begin{align}
L\left(  X\right)   &  =\left(  L_{0}\left(  X\right)  ,\cdots,L_{n}\left(
X\right)  ,\cdots,L_{r}\left(  X\right)  \right) \\
&  =L\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \mathbf{\varphi}_{1}\right\rangle \left\langle \mathbf{\varphi
}_{1}\right\vert ,\left\vert \mathbf{\varphi}_{12}\right\rangle \left\langle
\mathbf{\varphi}_{12}\right\vert ,\cdots,\left\vert \mathbf{\varphi}_{1\cdots
r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots r}\right\vert \right)
\mathcal{R}_{\mathbf{\varphi}}\left(  X\right) \\
&  =\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\cdots,\left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert ,\cdots,\left\vert \mathbf{\varphi
}_{1\cdots r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots
r}\right\vert \right)  \mathcal{R}_{\mathbf{\varphi}}\left(  L\right)
\mathcal{R}_{\mathbf{\varphi}}\left(  X\right)  ,\\
&  =L\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\cdots,\left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert ,\cdots,\left\vert \mathbf{\varphi
}_{1\cdots r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots
r}\right\vert \right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
\vdots\\
X_{e1\cdots n}\\
\vdots\\
X_{e1\cdots r}%
\end{array}
\right) \\
&  =\left(  L_{0}\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right)  ,\cdots,L_{n}\left(  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right)  ,\cdots,L_{r}\left(  \left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\varphi}\right\vert \right)  \right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
\vdots\\
X_{e1\cdots n}\\
\vdots\\
X_{e1\cdots r}%
\end{array}
\right)  ,
\end{align}
where
\begin{align}
L\left(  X_{e}\right)   &  =\sum_{0\leq p\leq r}L_{p}\left(  X_{e}\right)
=\sum_{0\leq p\leq n\leq r}\binom{n}{p}L_{n}^{p}\left(  X_{en}\right)
\nonumber\\
L_{p}\left(  X_{e}\right)   &  =\sum_{0\leq n\leq r}\binom{n}{p}L_{n}%
^{p}\left(  X_{en}\right)  .
\end{align}


\begin{remark}%
\begin{equation}
L\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)  =\sum_{0\leq p\leq r}%
L_{p}\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)  =\sum_{0\leq p\leq n\leq
r}\binom{n}{p}L_{n}^{p}\left(  P_{n}\right)  .
\end{equation}

\end{remark}

The representation, $\mathcal{R}_{\mathbf{\varphi}}\left(  L\right)  ,$ of $L$
is the upper triangular operator matrix
\begin{equation}
L=\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}L_{0}^{0} & \cdots & \binom{n}{0}L_{n}^{0} & \cdots & \binom{r}%
{0}L_{r}^{0}\\
0 & \ddots & \vdots & \vdots & \vdots\\
\vdots & \ddots & \binom{n}{n}L_{n}^{n} & \cdots & \binom{r}{n}L_{r}^{n}\\
\vdots & \vdots & \ddots & \ddots & \vdots\\
0 & \cdots & \cdots & 0 & \binom{r}{r}L_{r}^{r}%
\end{array}
\right)
\end{equation}
leading to the \emph{operator representation} of its action as
\begin{align}
&  L\left(  X_{e}\right)  =L\left(  X_{e}\right)  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}L_{0}^{0} & \cdots & \binom{n}{0}L_{n}^{0} & \cdots & \binom{r}%
{0}L_{r}^{0}\\
0 & \ddots & \vdots & \vdots & \vdots\\
\vdots & \ddots & \binom{n}{n}L_{n}^{n} & \cdots & \binom{r}{n}L_{r}^{n}\\
\vdots & \vdots & \ddots & \ddots & \vdots\\
0 & \cdots & \cdots & 0 & \binom{r}{r}L_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
\vdots\\
X_{e1\cdots n}\\
\vdots\\
X_{e1\cdots r}%
\end{array}
\right) \\
&  \Rightarrow\left(  L_{0}\left(  X_{e}\right)  ,\cdots,L_{n}\left(
X_{e}\right)  ,\cdots,L_{r}\left(  X_{e}\right)  \right)  =\left(
\sum\limits_{0\leq p\leq r}\binom{p}{0}L_{p}^{0}\left(  X_{e1\cdots p}\right)
,\cdots,\sum\limits_{n\leq p\leq r}\binom{p}{n}L_{p}^{n}\left(  X_{e1\cdots
p}\right)  ,\cdots,\binom{r}{r}L_{n}^{r}\left(  X_{e1\cdots r}\right)
\right)  ,
\end{align}
where $\left\{  \left.  L_{n}\left(  X_{e}\right)  \right\vert 0\leq n\leq
r\right\}  $ are columns of an operator matrix.

\begin{example}
$r=3$%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}  &
=\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  \oplus\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  \oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right) \\
L\left(  X_{e}\right)   &  =L\left(  X_{e}\right)  =\left(
\begin{array}
[c]{cccc}%
L_{0}^{0} & L_{1}^{0} & L_{2}^{0} & L_{3}^{0}\\
0 & L_{1}^{1} & \binom{2}{1}L_{2}^{1} & \binom{3}{1}L_{3}^{1}\\
0 & 0 & L_{2}^{2} & \binom{3}{2}L_{3}^{2}\\
0 & 0 & 0 & L_{3}^{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e\phi}\\
X_{e1}\\
X_{e12}\\
X_{e123}%
\end{array}
\right)  .
\end{align}

\end{example}

\begin{lemma}%
\begin{equation}
L_{n}^{p}\left(  P_{n}\right)  =\operatorname{Tr}_{n-p}\left\{  P_{n}\right\}
=\binom{n}{p}^{-1}\binom{r-p}{n-p}P_{p}%
\end{equation}
and%
\begin{equation}
\Gamma_{p}^{n}\left(  P_{p}\right)  =P_{n}.
\end{equation}

\end{lemma}

\begin{lemma}
Mixed contraction and expansion maps
\begin{align}
\left(  \Gamma_{p}^{n}\circ L_{n}^{p}\right)  \left(  P_{n}\right)   &
=\binom{n}{p}^{-1}\binom{r-p}{n-p}P_{n}\\
\left(  L_{n}^{p}\circ\Gamma_{p}^{n}\right)  \left(  P_{p}\right)   &
=\binom{n}{p}^{-1}\binom{r-p}{n-p}P_{p}.
\end{align}
$\lceil$%
\begin{align}
\left\langle \left.  \left(  \Gamma_{p}^{n}\circ L_{n}^{p}\right)  \left(
H_{n}\right)  \right\vert D^{n}\right\rangle _{n}  &  =\left\langle \left.
L_{n}^{p}\left(  H_{n}\right)  \right\vert L_{n}^{p}\left(  D^{n}\right)
\right\rangle _{p}\\
\left\langle \left.  \left(  L_{n}^{p}\circ\Gamma_{p}^{n}\right)  \left(
K_{p}\right)  \right\vert D^{n}\right\rangle _{n}  &  =\left\langle \left.
\Gamma_{p}^{n}\left(  K_{p}\right)  \right\vert \Gamma_{p}^{n}\left(
D_{2}\right)  \right\rangle _{n}%
\end{align}
$\rfloor$
\end{lemma}

\begin{example}
$r=4$

\begin{enumerate}
\item
\begin{gather}
L\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)  =\sum_{0\leq p\leq3}%
L_{p}\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)  =\sum_{0\leq p\leq n\leq
3}\binom{n}{p}L_{n}^{p}\left(  P_{n}\right) \\
\left.  =\right.  \binom{0}{0}L_{0}^{0}\left(  P_{0}\right)  +\binom{1}%
{0}L_{1}^{0}\left(  P_{1}\right)  +\binom{1}{1}L_{1}^{1}\left(  P_{1}\right)
+\binom{2}{0}L_{2}^{0}\left(  P_{2}\right)  +\binom{2}{1}L_{2}^{1}\left(
P_{2}\right)  +\binom{2}{2}L_{2}^{2}\left(  P_{2}\right) \\
+\binom{3}{0}L_{3}^{0}\left(  P_{3}\right)  +\binom{3}{1}L_{3}^{1}\left(
P_{3}\right)  +\binom{3}{2}L_{3}^{2}\left(  P_{3}\right)  +\binom{3}{3}%
L_{3}^{3}\left(  P_{3}\right)  +\binom{4}{0}L_{3}^{0}\left(  P_{4}\right)
+\binom{4}{1}L_{3}^{1}\left(  P_{4}\right) \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  +\right.
\binom{4}{2}L_{3}^{2}\left(  P_{4}\right)  +\binom{4}{3}L_{3}^{3}\left(
P_{4}\right)  +\binom{4}{4}L_{4}^{4}\left(  P_{4}\right)  \neq I_{\mathcal{H}%
_{\mathcal{F}}}.
\end{gather}


\item
\begin{align}
L\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)   &  =\sum_{0\leq p\leq n\leq
3}\binom{n}{p}L_{n}^{p}\left(  P_{n}\right)  =\sum_{0\leq p\leq n\leq3}%
\binom{r-p}{n-p}P_{p}\neq I_{\mathcal{H}_{\mathcal{F}}}\\
\binom{r-p}{n-p}  &  =\frac{\left(  r-p\right)  !}{\left(  r-p-n+p\right)
!\left(  n-p\right)  !}=\frac{\left(  r-p\right)  !}{\left(  r-n\right)
!\left(  n-p\right)  !}%
\end{align}
and%
\begin{equation}
\sum_{0\leq p\leq n\leq3}\binom{r-p}{n-p}P_{p}=P_{0}+3P_{1}+P_{1}+P_{2}%
+2P_{2}+P_{2}+\binom{4-3}{3-3}P_{3}+P_{3}+P_{3}+P_{3}+P_{4}+P_{4}+P_{4}%
+P_{4}+P_{4}.
\end{equation}


\item
\begin{align}
\Gamma\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)   &  =\sum_{0\leq p\leq
4}\Gamma_{p}\left(  I_{\mathcal{H}_{\mathcal{F}}}\right)  =\sum_{0\leq p\leq
4}\sum_{0\leq p\leq n\leq4}\binom{n}{p}\Gamma_{p}^{n}\left(  P_{n}\right) \\
&  =P_{0}+P_{1}+P_{1}+P_{2}+2P_{2}+P_{2}+P_{3}+3P_{3}+3P_{3}+P_{3}%
+P_{4}+4P_{4}+6P_{4}+4P_{4}+P_{4}\\
&  =P_{0}+2P_{1}+4P_{2}+8P_{3}+16P_{4}\neq I_{\mathcal{H}_{\mathcal{F}}}.
\end{align}


\item
\begin{align}
&  \Gamma\left(  \left\vert \varphi_{1}\cdots\varphi_{4}\right\rangle
\left\langle \varphi_{1}\cdots\varphi_{4}\right\vert \right)  =\sum_{0\leq
n\leq4}\Gamma^{n}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right) \\
&  =\Gamma_{3}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}%
\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right)  +\Gamma_{4}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right) \\
&  =\binom{3}{3}\Gamma_{3}^{3}\left(  \left\vert \varphi_{1}\varphi_{2}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi
_{3}\right\vert \right)  +\binom{4}{3}\Gamma_{3}^{4}\left(  \left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\varphi_{3}\right\vert \right)  .
\end{align}


\item
\begin{align}
&  L\left(  \left\vert \varphi_{1}\cdots\varphi_{4}\right\rangle \left\langle
\varphi_{1}\cdots\varphi_{4}\right\vert \right)  =\sum_{0\leq n\leq4}%
L_{n}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right) \\
&  =L_{0}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right)
+L_{1}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right)
+L_{2}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right)
+L_{3}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right) \\
&  =\binom{3}{0}L_{3}^{0}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right)  +\binom{3}{1}L_{3}^{1}\left(  \left\vert \varphi_{1}\varphi
_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi
_{3}\right\vert \right)  +\binom{3}{2}L_{3}^{2}\left(  \left\vert \varphi
_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\varphi_{3}\right\vert \right) \\
&  +\binom{3}{3}L_{3}^{3}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right)  .
\end{align}

\end{enumerate}
\end{example}

\begin{example}
The vacuum state projector is mapped onto the identity element of
$\mathcal{F}$ i.e.
\begin{equation}
\Gamma\left(  P_{0}\right)  =\Gamma_{0}\left(  P_{0}\right)  =\sum_{0\leq
n\leq r}\binom{n}{0}\Gamma_{0}^{n}\left(  P_{0}\right)  =\sum_{0\leq n\leq
r}P_{n}=I_{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{example}

\begin{remark}%
\begin{gather}
L_{n}^{p}\in\mathcal{B}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
,\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  \right) \\
\Gamma_{p}^{n}\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)
,\mathcal{B}\left(  \mathcal{H}^{p}\right)  \right) \\
0\leq p\leq n,0\leq n\leq r.
\end{gather}

\end{remark}

\paragraph{Trace of Expanded operators}

Expanded primitive projectors are given by
\begin{align}
\Gamma_{p}^{n}\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert
\right)   &  =\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
\sum_{1\leq j_{p+1}<\cdots<j_{n}\leq r}\left\vert \varphi_{j_{p+1}}%
\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{j_{p+1}}\cdots
\varphi_{j_{n}}\right\vert \\
&  =\sum_{\substack{1\leq j_{p+1}<\cdots<j_{n}\leq r\\\left\{  j_{p+1}%
,\cdots,j_{n}\right\}  \cap\left\{  j_{1},\cdots,j_{p}\right\}  =\phi
}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{j_{p+1}}%
\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\varphi_{j_{p+1}}\cdots\varphi_{j_{n}}\right\vert
\end{align}
leading to
\begin{gather}
L_{n}^{0}\circ\Gamma_{p}^{n}\left(  \left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\vert \right)  =\\
\sum_{1\leq k_{1}<\cdots<k_{n}\leq r}\left\langle \left.
\overset{\overset{}{\overset{}{}}}{\varphi_{k_{1}},p=\cdots\varphi_{k_{n}}%
}\right\vert \sum_{\substack{1\leq j_{p+1}<\cdots<j_{n}\leq r\\\left\{
j_{p+1},\cdots,j_{n}\right\}  \cap\left\{  j_{1},\cdots,j_{p}\right\}  =\phi
}}\left\vert \overset{\overset{}{\overset{}{}}}{\varphi_{k_{1}}\cdots
\varphi_{k_{n}}}\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{j_{p+1}}%
\cdots\varphi_{j_{n}}\right\rangle \left\langle
\overset{\overset{}{\overset{}{}}}{\varphi_{k_{1}}\cdots\varphi_{k_{n}}%
}\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{j_{p+1}}\cdots\varphi_{j_{n}%
}\right\vert \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\rangle \\
\left.  =\right.  \binom{r-p}{n-p}.
\end{gather}


\begin{example}
$r=4,n=3,p=2$%
\begin{equation}
L_{3}^{0}\circ\Gamma_{2}^{3}\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
=L_{3}^{0}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert +\left\vert
\varphi_{1}\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\varphi_{4}\right\vert \right)  =2=\binom{4-2}{3-2}=\binom{2}{1}=2
\end{equation}

\end{example}

\begin{remark}
If $r=\infty$ then
\begin{equation}
L_{3}^{0}\circ\Gamma_{2}^{3}\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
=\infty.
\end{equation}

\end{remark}

\subsubsection{Traceless Operators in}

\begin{lemma}
The space $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ has
the direct sum decompositions
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}  &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left(  \mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\right)  \oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{p\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{p\leq n\leq r}}
%EndExpansion
\left(  \mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}\right) \\
&  =\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{\left(  ep\right)
},
\end{align}
where the centre $\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  $ of $\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ is given by
\begin{equation}
\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right)
\end{equation}
and the subspace of traceless operators is defined by
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  p\right)
}=%
%TCIMACRO{\tbigoplus \limits_{p\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{p\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p},
\end{equation}
which is dual to to the direct sum decomposition of $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ given by
\begin{align}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}  &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left(  \mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)
\oplus\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{p}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{p\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{p\leq n\leq r}}
%EndExpansion
\left(  \mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)
\oplus\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{p}\right) \\
&  =\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  p\right)
}\equiv\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  ^{d}\oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  p\right)
}^{d}.
\end{align}

\end{lemma}

\begin{definition}
Operator of non zero trace are given by
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  0\right)
}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{0}%
\end{equation}
in infinite dimensions they are not multiples of the identity.
\end{definition}

\begin{lemma}
In finite dimensions
\begin{equation}
\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =\operatorname*{linspan}\left\{  \left.  \left(  \binom{r}{p}%
^{-1}P_{_{\mathcal{H}^{p}}}-\binom{r}{p-1}^{-1}P_{_{\mathcal{H}^{p-1}}%
}\right)  \right\vert r\geq p\geq1\right\}  .
\end{equation}

\end{lemma}

\begin{lemma}
The transformation $\Upsilon\in\mathcal{B}\left(  \mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ from the Ket-Bra basis to the
traceless basis is given by
\begin{equation}
\Upsilon:%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  \rightarrow\mathcal{Z}\left(
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  p\right)
}.
\end{equation}

\end{lemma}

\begin{example}
$r=4$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=\mathcal{B}%
_{1}\left(  \mathcal{H}^{0}\right)  \oplus\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  \oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  \oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{4}\right)
\end{equation}
and%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=\mathcal{Z}%
\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)
\oplus\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(
0\right)  }\oplus\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e\left(  1\right)  }\oplus\mathcal{B}_{e}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e\left(  2\right)  }\oplus\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e\left(  3\right)  }\oplus\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e\left(  4\right)  }.
\end{equation}

\end{example}

\begin{lemma}
\begin{enumerate}
\item
\begin{align}
\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)   &  \equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right) \\
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}  \equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)  ,
\end{align}
it is possible that $\left\{  \left.  \mathcal{Z}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  \right)  \right\vert 0\leq n\leq
r\right\}  $ are empty.

\item
\begin{gather}
\text{If }r<\infty\text{ then }\mathcal{Z}\left(  \mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\ker\left\{  L_{n}^{0}\right\}  ^{c}\\
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}  .
\end{gather}

\end{enumerate}
\end{lemma}

\begin{corollary}
Any Trace Class operator, $X_{e},$ belonging to $\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}\subseteq\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ can be expanded as
\begin{equation}
X_{e}=\sum_{0\leq n\leq r}X_{e\left(  n\right)  },
\end{equation}
where
\begin{align}
\operatorname{Tr}\left\{  X_{e\left(  n\right)  }\right\}   &  =0;1\leq n\leq
r\\
\operatorname{Tr}\left\{  X_{e}\right\}   &  =\operatorname{Tr}\left\{
X_{e\left(  0\right)  }\right\}  .
\end{align}

\end{corollary}

\begin{remark}
Swapping the order of direct sums
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}  &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left(  \mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\right)  \oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}\right) \\
&  =\mathcal{\ }%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{p\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{p\leq n\leq r}}
%EndExpansion
\left(  \mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\right)  \oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}\right)
\overset{r<\infty}{=}\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{ep}.
\end{align}

\end{remark}

\begin{remark}%
\begin{align}
&  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right) \\
\Upsilon &  :%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow\mathcal{Z}\left(
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e\left(  n\right)
}.
\end{align}

\end{remark}

\begin{remark}
$\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  $ may be empty.
\end{remark}

\begin{remark}
The direct sum $%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  $ is the space of sequences
equipped with the direct sum norm i.e.
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \equiv\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{0}\right)  ,\cdots,\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  ,\cdots,\mathcal{B}_{1}\left(  \mathcal{H}^{r}\right)
\right)  .
\end{equation}
The action of the contraction map on the sequence space $\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ is
\begin{equation}
L\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\right)
=\left(  L_{0}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\right)  ,\cdots,L_{n}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}\right)  ,\cdots,L_{r}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\right)  \right)  ,
\end{equation}
where%
\begin{equation}
L_{n}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\right)  =\sum\limits_{n\leq p\leq r}\binom{n}{p}L_{n}^{p}\left(
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right)  .
\end{equation}

\end{remark}

\begin{example}
$r=4$%
\begin{align}
\left(  L_{0}\left(  X_{e}\right)  ,\cdots,L_{4}\left(  X_{e}\right)  \right)
&  =\left(  \sum\limits_{0\leq n\leq4}\binom{n}{0}L_{n}^{0}\left(  X_{e1\cdots
n}\right)  ,\cdots,\sum\limits_{p\leq n\leq4}\binom{n}{p}L_{n}^{p}\left(
X_{e1\cdots n}\right)  ,\cdots,\binom{4}{4}L_{4}^{4}\left(  X_{e1\cdots
4}\right)  \right) \\
\left(  \Gamma^{0}\left(  X_{e}\right)  ,\cdots,\Gamma^{4}\left(
X_{e}\right)  \right)   &  =\left(  \binom{0}{0}\Gamma_{0}^{0}\left(
X_{e0}\right)  ,\cdots,\sum\limits_{0\leq p\leq n}\binom{n}{p}\Gamma_{p}%
^{n}\left(  X_{e1\cdots p}\right)  ,\cdots,\sum\limits_{0\leq p\leq4}\binom
{4}{p}\Gamma_{0}^{4}\left(  X_{e1\cdots p}\right)  \right)
\end{align}

\end{example}

\begin{example}
$r=4:$ The standard decomposition of $\mathcal{B}_{1}\left(  \mathbb{C}%
^{16}\right)  _{e}$ gives
\begin{align}
&  \dim\left\{  \mathcal{H}_{\mathcal{F}}\right\}  =1+4+6+4+1=16\\
&  \mathcal{H}_{\mathcal{F}}=\bigwedge\left(  \mathbb{C}^{4}\right)
=\mathbb{C}^{1}\oplus\mathbb{C}^{4}\oplus\mathbb{C}^{6}\oplus\mathbb{C}%
^{4}\oplus\mathbb{C}^{1}=\mathbb{C}^{16}\\
&  \mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}=\mathcal{B}_{1}\left(
\mathbb{C}\right)  \oplus\mathcal{B}_{1}\left(  \mathbb{C}^{4}\right)
\oplus\mathcal{B}_{1}\left(  \wedge^{2}\mathbb{C}^{4}\right)  \oplus
\mathcal{B}_{1}\left(  \wedge^{3}\mathbb{C}^{4}\right)  \oplus\mathcal{B}%
_{1}\left(  \wedge^{4}\mathbb{C}^{4}\right) \\
&  \dim\left\{  \mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}\right\}
=1+16+36+16+1=70\qquad\qquad\qquad\qquad\qquad\qquad\\
&  L:\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}\rightarrow
\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}\\
&  L\left(  X_{e}\right)  =\,\overset{\uparrow}{\underset{\downarrow}{n}%
}\overset{\longleftarrow p\rightarrow}{\left(
\begin{array}
[c]{ccccc}%
L_{0}^{0} & L_{1}^{0} & L_{2}^{0} & L_{3}^{0} & L_{4}^{0}\\
0 & L_{1}^{1} & \binom{2}{1}L_{2}^{1} & \binom{3}{1}L_{3}^{1} & \binom{4}%
{1}L_{4}^{1}\\
\vdots & 0 & L_{2}^{2} & \binom{3}{2}L_{3}^{2} & \binom{4}{2}L_{4}^{2}\\
\vdots & \cdots & \ddots & L_{3}^{3} & \binom{4}{3}L_{4}^{3}\\
0 & \cdots & \cdots & 0 & L_{4}^{4}%
\end{array}
\right)  }\left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e12}\\
X_{e123}\\
X_{e124}%
\end{array}
\right)  \Rightarrow\\
&  \left(  L_{0}\left(  X_{e}\right)  ,\cdots,L_{4}\left(  X_{e}\right)
\right)  =\left(  \sum\limits_{0\leq n\leq4}\binom{n}{0}L_{n}^{0}\left(
X_{e0\cdots n}\right)  ,\cdots,\sum\limits_{p\leq n\leq4}\binom{n}{p}L_{n}%
^{p}\left(  X_{ep\cdots n}\right)  ,\cdots,\binom{4}{4}L_{4}^{4}\left(
X_{e0\cdots4}\right)  \right) \\
&  L_{p}:\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}\rightarrow
\mathcal{B}_{1}\left(  \mathbb{C}^{16}\right)  _{e}\\
&  L_{p}\left(  X_{e}\right)  =L^{p}\left(  \mathcal{X}_{e}\right)
=\mathcal{L}^{p}\cdot\mathcal{X}_{e}.\,0\leq p\leq4.
\end{align}
One can express the action of the generalized contraction and expansion maps
in the informative manner as
\begin{align}
L\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\right)
&  =\left(  L_{0}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}\right)  ,\cdots,L_{n}\left(  \mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}\right)  ,\cdots,L_{r}\left(
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\right)  \right)
\\
&  =\left(  \sum\limits_{0\leq n\leq r}\binom{n}{0}L_{n}^{0}\left(
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{e}\right)  ,\cdots
,\sum\limits_{p\leq n\leq r}\binom{n}{p}L_{n}^{p}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{e}\right)  ,\cdots,L_{r}^{r}\left(
\mathcal{B}_{1}\left(  \mathcal{H}^{r}\right)  _{e}\right)  \right)
\end{align}%
\begin{equation}
\downarrow
\end{equation}%
\begin{align}
&  L\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\right)  =\left(  L_{0}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}\right)  ,\cdots,L_{n}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\right)  ,\cdots
,L_{r}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\right)  \right) \\
&  =\left(  \sum\limits_{0\leq n\leq r}\binom{n}{0}L_{n}^{0}\left(
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  _{e}\right)  ,\cdots
,\sum\limits_{p\leq n\leq r}\binom{n}{p}L_{n}^{p}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{e}\right)  ,\cdots,\binom{r}{r}L_{r}%
^{r}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{r}\right)  _{e}\right)
\right) \\
&  =\left(  \left(  \sum\limits_{0\leq n\leq r}\binom{n}{0}L_{n}^{0}\left(
\mathcal{Z}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right)
\oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq n}}
%EndExpansion
\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{q}\right)  \right)
,\cdots,\sum\limits_{p\leq n\leq r}\binom{n}{p}L_{n}^{p}\left(  \mathcal{Z}%
\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq n}}
%EndExpansion
\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{q}\right)  \right)
,\right)  \right. \\
&  \left.  \cdots,\left(  \mathcal{Z}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{r}\right)  \right)  \oplus%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq r}}
%EndExpansion
\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{r}\right)  _{q}\right)  \right)
\right)
\end{align}
The \emph{contraction decomposition} of $\mathcal{B}_{1}\left(  \mathbb{C}%
^{16}\right)  _{e}\equiv\mathcal{B}_{1}\left(  \wedge\left(  \mathbb{C}%
^{4}\right)  \right)  _{e}$ is
