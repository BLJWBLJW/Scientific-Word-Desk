\begin{proposition}%
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  ^{\bot}=\operatorname{Ran}\left\{  \Gamma
_{0}^{n}\right\}  =\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}%
^{n}\right)  \right)  .
\end{equation}

\end{proposition}

\begin{proof}%
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  ^{\bot}=\left\{  \left.  \Gamma_{0}^{n}\left(
z\right)  \right\vert \left\langle \Gamma_{0}^{n}\left(  z\right)
,X\right\rangle =0,z\in\mathbb{C},\forall X\in\ker\left\{  L_{n}^{0}\right\}
\subset\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\}  .
\end{equation}

\end{proof}

\begin{example}
One has the following
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  1\right)  -\left(
0\right)  }  &  =\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}
=\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}  \ominus0_{\binom{r}{n}%
}=\mathcal{B}\left(  \mathcal{H}^{n}\right)  \ominus\ker\left\{  L_{n}%
^{0}\right\}  ^{\bot}\\
\ker\left\{  L_{n}^{0}\right\}   &  =\ker\left\{  \operatorname{Tr}%
_{\mathcal{H}^{n}}\right\}  =\left\{  \left.  \operatorname{Tr}_{\mathcal{H}%
^{n}}\left\{  X\right\}  =0\right\vert X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  \right\} \\
\ker\left\{  L_{n}^{0}\right\}  ^{\bot}  &  =\left\{  \left.
\overset{}{\Gamma_{0}^{n}\left(  z\right)  }\right\vert \left\langle
\Gamma_{0}^{n}\left(  z\right)  ,X\right\rangle \neq0,z\in\mathbb{C},\forall
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\}
\end{align}
and%
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{0}  &  =\operatorname{Ran}%
\left\{  \Gamma_{0}^{n}\right\} \\
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  1\right)  -\left(
0\right)  }  &  =\operatorname{Ran}\left\{  \Gamma_{1}^{n}\right\}
\ominus\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\} \\
&  \vdots\\
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  n-1\right)  -\left(
n-2\right)  }  &  =\operatorname{Ran}\left\{  \Gamma_{n-1}^{n}\right\}
\ominus\operatorname{Ran}\left\{  \Gamma_{n-2}^{n}\right\} \\
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  n\right)  -\left(
n-1\right)  }  &  =\operatorname{Ran}\left\{  \Gamma_{n}^{n}\right\}
\ominus\operatorname{Ran}\left\{  \Gamma_{n-1}^{n}\right\}  .
\end{align}%
\begin{equation}
\shortparallel
\end{equation}%
\begin{align}
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)   &
=\ker\left\{  L_{n}^{0}\right\}  ^{\bot}\\
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  1\right)  -\left(
0\right)  }  &  =\ker\left\{  L_{n}^{1}\right\}  ^{\bot}\ominus\ker\left\{
L_{n}^{0}\right\}  ^{\bot}\\
&  \vdots\\
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  n-1\right)  -\left(
n-2\right)  }  &  =\ker\left\{  L_{n}^{n-1}\right\}  ^{\bot}\ominus
\ker\left\{  L_{n}^{n-2}\right\}  ^{\bot}\\
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  n\right)  -\left(
n-1\right)  }  &  =\ker\left\{  L_{n}^{n}\right\}  ^{\bot}\ominus\ker\left\{
L_{n}^{n-1}\right\}  ^{\bot}.
\end{align}

\end{example}

\begin{lemma}%
\begin{equation}
\Gamma_{p}^{n}\left(  \mathcal{H}^{p}\right)  \cong\mathcal{H}^{p}%
\end{equation}

\end{lemma}

\begin{theorem}%
\begin{gather}
\operatorname{Tr}\left\{  \Gamma_{p}^{n}\left(  X_{\left(  p,q\right)
}\right)  \right\}  =L_{n}^{0}\left(  \Gamma_{p}^{n}\left(  X_{\left(
p,q\right)  }\right)  \right)  =0,\,\\
X_{\left(  p,q\right)  }\in\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
_{q},\\
1\leq q\leq p,1\leq p\leq n,1\leq n\leq r.
\end{gather}

\end{theorem}

\begin{lemma}
\emph{The trace of expansions of trace zero operators are zero i.e}
\begin{gather}
\operatorname{Tr}\left\{  \Gamma_{p}^{n}\left(  X_{\left(  p,q\right)
}\right)  \right\}  =\left(  L_{n}^{0}\circ\Gamma_{p}^{n}\right)  \left(
X_{\left(  p,q\right)  }\right)  =\binom{r}{n-p}\operatorname{Tr}\left\{
\left(  X_{\left(  p,q\right)  }\right)  \right\}  =\binom{r}{n-p}L_{p}%
^{0}\left(  X_{\left(  p,q\right)  }\right)  =0\\
X_{\left(  p,q\right)  }\in\mathcal{B}\left(  \mathcal{H}^{p}\right)  _{q},\\
1\leq q\leq p,1\leq p\leq n,1\leq n\leq r.
\end{gather}

\end{lemma}

\begin{corollary}
The expansion maps act on trace class operators but do not in general produce
trace class operators except when it acts on trace zero operators
\begin{equation}
\Gamma_{p}^{n}\left(  \mathcal{B}\left(  \mathcal{H}^{p}\right)  _{q}\right)
\subset\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{q},1\leq q\leq p,1\leq
p\leq n,1\leq n\leq r.
\end{equation}

\end{corollary}

\begin{remark}%
\begin{align}
\Gamma_{0}^{1}\left(  z\right)   &  =zI_{1}\\
\mathcal{B}\left(  \mathcal{H}^{1}\right)   &  =\operatorname{Ran}\left\{
\Gamma_{0}^{1}\right\}  \oplus\ker\left\{  L_{1}^{0}\right\}
\end{align}
if one takes the relavent closure.
\end{remark}

\begin{remark}
The adjoint action of the unitary group entwines with the contaction and
expansion maps i.e.
\begin{align}
\widehat{u}_{p}\circ L_{n}^{p}  &  =L_{n}^{p}\circ\widehat{u}_{n}\\
\widehat{u}_{n}\circ\Gamma_{p}^{n}  &  =\Gamma_{p}^{n}\circ\widehat{u}_{p}.
\end{align}

\end{remark}

\begin{lemma}
The adjoint action of the general linear group $GL\left(  \mathcal{H}%
^{1}\right)  $ entwines with the contaction and expansion maps i.e.
\begin{align}
\widehat{g}_{p}\circ L_{n}^{p}  &  =L_{n}^{p}\circ\widehat{g}_{n}\\
\widehat{g}_{n}\circ\Gamma_{p}^{n}  &  =\Gamma_{p}^{n}\circ\widehat{g}_{p}.
\end{align}

\end{lemma}

\begin{lemma}
The space $\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  $ has the direct sum
decomposition
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p-1\right)  -\left(
p\right)  }=%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left\{  \ker\left\{  L_{n}^{p-1}\right\}  \ominus\ker\left\{  L_{n}%
^{p}\right\}  \right\}  ,
\end{equation}
which is biorthogonal to the direct sum decomposition of $\mathcal{B}\left(
\mathcal{H}^{n}\right)  $
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{n}\right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(
p-1\right)  }=%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left\{  \ker\left\{  L_{n}^{p}\right\}  ^{\bot}\ominus\ker\left\{
L_{n}^{p-1}\right\}  ^{\bot}\right\} \\
&  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left\{  \operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}  \ominus
\operatorname{Ran}\left\{  \Gamma_{p-1}^{n}\right\}  \right\}  ,
\end{align}
leading to
\begin{equation}
X=\sum_{0\leq j\leq n}X_{\left(  j\right)  }.
\end{equation}

\end{lemma}

\begin{lemma}
$\mathcal{B}\left(  \mathcal{H}^{n}\right)  $ can be expanded as
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  =\mathcal{B}\left(  \mathcal{H}%
^{n}\right)  _{\left(  n\right)  -\left(  n-1\right)  }\oplus\mathcal{B}%
\left(  \mathcal{H}^{n}\right)  _{\left(  n-1\right)  -\left(  n-2\right)
}\oplus\cdots\oplus\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(
1\right)  -\left(  0\right)  }\oplus\mathcal{Z}\left(  \mathcal{B}\left(
\mathcal{H}^{n}\right)  \right)  ,
\end{equation}
where
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(
p-1\right)  }=\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}
\ominus\operatorname{Ran}\left\{  \Gamma_{p-1}^{n}\right\}  =\ker\left\{
L_{n}^{p}\right\}  ^{\bot}\ominus\ker\left\{  L_{n}^{p-1}\right\}  ^{\bot}.
\end{equation}

\end{lemma}

\begin{example}
$n=1;r=2$%
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  =\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  _{\left(  1\right)  -\left(  0\right)  }\oplus\mathcal{B}\left(
\mathcal{H}^{1}\right)  ^{c}=\operatorname{Ran}\left\{  \Gamma_{1}%
^{1}\right\}  \ominus\operatorname{Ran}\left\{  \Gamma_{0}^{1}\right\}
\oplus\operatorname{Ran}\left\{  \Gamma_{0}^{1}\right\}
\end{equation}
i.e.
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{0}  &  =\operatorname{Ran}%
\left\{  \Gamma_{0}^{1}\right\}  =\mathcal{Z}\left(  \mathcal{B}\left(
\mathcal{H}^{1}\right)  \right)  =\ker\left\{  L_{1}^{0}\right\}  ^{\bot}\\
\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{1}  &  =\mathcal{B}\left(
\mathcal{H}^{1}\right)  \ominus\operatorname{Ran}\left\{  \Gamma_{0}%
^{1}\right\}  =\mathcal{B}\left(  \mathcal{H}^{1}\right)  \ominus
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right)  .
\end{align}
Explicitly
\begin{align}
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right)   &
=\left\{  \left.  \left(
\begin{array}
[c]{cc}%
z & 0\\
0 & z
\end{array}
\right)  \right\vert z\in\mathbb{C}\right\} \\
\mathcal{B}\left(  \mathcal{H}^{1}\right)  _{1}  &  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
z_{1} & z_{2}\\
z_{3} & -z_{1}%
\end{array}
\right)  \right\vert z_{1},z_{2},z_{3}\in\mathbb{C}\right\}
\end{align}
and
\begin{equation}
\left\langle \left.  \left(
\begin{array}
[c]{cc}%
z & 0\\
0 & z
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{cc}%
z_{1} & z_{2}\\
z_{3} & -z_{1}%
\end{array}
\right)  \right\rangle =0.
\end{equation}

\end{example}

\begin{lemma}
The subspaces $\left\{  \left.  \mathcal{B}\left(  \mathcal{H}^{n}\right)
_{p}\right\vert 0\leq p\leq n,0\leq n\leq r\right\}  $ and $\left\{  \left.
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}\right\vert 0\leq p\leq
n,0\leq n\leq r\right\}  $ are invariant to the adjoint action of $U\left(
\mathcal{H}^{1}\right)  .$
\end{lemma}

\begin{corollary}
$\left\{  \left.  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \text{ and
}\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\vert 0\leq n\leq
r\right\}  $ produce \emph{reducible }representations, $\left\{
\mathcal{D}_{\mathcal{B}\left(  \mathcal{H}^{n}\right)  }\left(  U\left(
\mathcal{H}^{1}\right)  \right)  \right\}  $ and $\left\{  \mathcal{D}%
_{\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  }\left(  U\left(
\mathcal{H}^{1}\right)  \right)  \right\}  $ of $U\left(  \mathcal{H}%
^{1}\right)  $ i.e.
\begin{equation}
\mathcal{D}_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }\left(
U\left(  \mathcal{H}^{1}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{D}_{\mathcal{B}\left(  \mathcal{H}^{n}\right)  }\left(  U\left(
\mathcal{H}^{1}\right)  \right)
\end{equation}

\end{corollary}

and
\begin{equation}
\mathcal{D}_{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  }\left(
U\left(  \mathcal{H}^{1}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{D}_{\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  }\left(  U\left(
\mathcal{H}^{1}\right)  \right)  .
\end{equation}


\subsubsection{Young Tableaux}

The full $n$-fold tensor product space is given by
\begin{equation}
\mathcal{H}^{n\otimes}=%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
\mathcal{H}^{1}%
\end{equation}
with elements
\begin{equation}
\Phi_{j_{1}\cdots j_{n}}=\sum_{0\leq j_{1},\cdots,j_{n}\leq r}c_{j_{1}\cdots
j_{n}}\varphi_{j_{1}}\otimes\cdots\otimes\varphi_{j_{n}},
\end{equation}
where $\left\{  \left.  \varphi_{j}\right\vert 1\leq j\leq r\right\}  $ is a
basis for $\mathcal{H}^{1}.$

\begin{definition}
The $n^{th}$-rank Young Tableaux $\left[  n_{1},\left(  n_{2}-n_{1}\right)
,\cdots,\left(  n_{r}-n_{r-1}\right)  \right]  $ are defined as
\begin{equation}
\left[  n_{1},\left(  n_{2}-n_{1}\right)  ,\cdots,\left(  n_{r}-n_{r-1}%
\right)  \right]  =\left\{  \left.  \fbox{$%
\begin{array}
[c]{c}%
\begin{array}
[c]{ccccccc}%
\fbox{$j_1$} & \cdots & \cdots & \cdots & \cdots & \cdots & \fbox{$%
\fbox{$j_{n}{}_{_{1}}$}{}{}$}%
\end{array}
\\%
\begin{array}
[c]{ccccc}%
\fbox{$\fbox{$j_{n}{}_{_{1}}$}+1$} & \cdots & \cdots & \cdots & \fbox{$%
\fbox{$j_{n}{}_{_{2}}$}{}{}$}%
\end{array}
\qquad\\%
\begin{array}
[c]{cccc}%
\fbox{$\fbox{$j_{n_{2}}{}$}{}{}+1$} & \cdots & \cdots & \fbox{$j_n{}__3$}%
\end{array}
\qquad\qquad\\
\vdots\\
\fbox{$j_n{}_{\substack{r}}{}{}$}\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\end{array}
$}\right\vert 1\leq j_{1}\leq\cdots\leq j_{r}\leq r\right\}
\end{equation}
where
\begin{gather}
n_{1}\geq n_{2}\geq\cdots\geq n_{r-1}\geq n_{r}\\
n_{1}+\cdots+n_{r}=n
\end{gather}
and $n_{k}$ is the number of boxes in the $k^{th}$ row, where $1\leq k\leq r$.
\end{definition}

One associates this tableaux with the tensor%
\begin{equation}
\Psi_{j_{1}\cdots j_{n_{1}}{}j_{n_{1}}+1\cdots j_{n_{2}}\cdots j_{n_{r}}}%
\in\mathcal{H}^{n\otimes}%
\end{equation}
that has the symmetry properties:

\begin{enumerate}
\item It is symmetric wrt indices
\begin{equation}
\left\{  j_{n_{p}}+1,\cdots,j_{n_{p+1}}\right\}  {}%
\end{equation}
appearing in \emph{each row}.

\item It is antisymmetric wrt indices
\begin{equation}
\left\{  j_{1},j_{n_{1}}+1,j_{n_{2}}{}+1,\cdots,j_{n_{r}}\right\}  .
\end{equation}
in \emph{each column}.
\end{enumerate}

\begin{example}
For $n=3$ the Young Tableaux are \newline%
\begin{align}
\left[  3,0^{r-3}\right]   &  =\left\{  \left.
\begin{array}
[c]{ccc}%
j_{1} & j_{2} & j_{3}%
\end{array}
\right\vert 1\leq j_{1}\leq j_{2}\leq j_{3}\leq r\right\}  ;\,n=n_{1}%
+\cdots+n_{r}=3+0+\cdots+0\\
\left[  1^{3},0^{r-3}\right]   &  \equiv\left[  1,1,1,0^{r-3}\right]
=\left\{  \left.
\begin{array}
[c]{c}%
j_{1}\\
j_{2}\\
j_{3}%
\end{array}
\right\vert 1\leq j_{1}\leq j_{2}\leq j_{3}\leq r\right\}  ;\,n=n_{1}%
+\cdots+n_{r}=1+1+1+0+\cdots+0\\
\left[  2,1,0^{r-3}\right]   &  =\left\{  \left.
\begin{array}
[c]{c}%
\begin{array}
[c]{cc}%
j_{1} & j_{2}%
\end{array}
\\%
\begin{array}
[c]{c}%
j_{3}%
\end{array}
\qquad
\end{array}
\right\vert 1\leq j_{1}\leq j_{2}\leq j_{3}\leq r\right\}  ;\,n=n_{1}%
+\cdots+n_{r}=2+1+0+\cdots+0
\end{align}
are associated with symmetric, antisymmetric and mixed symmetry tensors
\begin{align}
S_{j_{1}j_{2}j_{3}}  &  =\frac{1}{6}\left\{  \Phi_{j_{1}j_{2}j_{3}}%
+\Phi_{j_{1}j_{3}j_{2}}+\Phi_{j_{2}j_{1}j_{3}}+\Phi_{j_{2}j_{3}j_{1}}%
+\Phi_{j_{3}j_{1}j_{2}}+\Phi_{j_{3}j_{2}j_{1}}\right\} \\
A_{j_{1}j_{2}j_{3}}  &  =\frac{1}{6}\left\{  \Phi_{j_{1}j_{2}j_{3}}%
-\Phi_{j_{1}j_{3}j_{2}}-\Phi_{j_{2}j_{1}j_{3}}+\Phi_{j_{2}j_{3}j_{1}}%
+\Phi_{j_{3}j_{1}j_{2}}-\Phi_{j_{3}j_{2}j_{1}}\right\} \\
\Lambda_{j_{1}j_{2}j_{3}}  &  =\frac{1}{4}\left\{  \Phi_{j_{1}j_{2}j_{3}}%
+\Phi_{j_{2}j_{1}j_{3}}-\Phi_{j_{3}j_{1}j_{2}}-\Phi_{j_{3}j_{2}j_{1}}\right\}
,
\end{align}
where
\begin{equation}
\Phi\in\mathcal{H}^{3\otimes}.
\end{equation}

\end{example}

