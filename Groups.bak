x_{8}+x_{4}x_{8}+x_{2}x_{6}+x_{3}x_{7}\right) \\
&  \quad\quad\quad\quad+\frac{1}{4}\left(  x_{1}x_{2}x_{5}x_{6}+x_{1}%
x_{3}x_{5}x_{7}+x_{1}x_{4}x_{5}x_{8}+x_{2}x_{3}x_{6}x_{7}+x_{2}x_{4}x_{6}%
x_{8}+x_{3}x_{4}x_{7}x_{8}\right) \\
&  \quad\quad\quad\quad\quad\quad\quad\quad+i\left(  x_{1}x_{2}x_{3}x_{5}%
x_{6}x_{7}-x_{1}x_{2}x_{4}x_{5}x_{6}x_{8}-x_{1}x_{3}x_{4}x_{5}x_{7}x_{8}%
-x_{2}x_{3}x_{4}x_{6}x_{7}x_{8}\right)
\end{align}


\item
\begin{align}
&  N_{4}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{5}\right)  \left(
