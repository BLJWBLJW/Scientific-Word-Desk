^{1},\overset{5}{\overleftrightarrow{0,\cdots,0}}\right) \\
&  \vdots\\
\Gamma^{4}  &  =\left(  \binom{4}{0}\Gamma_{0}^{4},\binom{4}{1}\Gamma_{1}%
^{4},\binom{4}{2}\Gamma_{p}^{4},\binom{4}{3}\Gamma_{3}^{4},\binom{4}{4}%
\Gamma_{4}^{4},\overset{2}{\overleftrightarrow{0,0}}\right) \\
\Gamma^{5}  &  =\left(  \binom{5}{0}\Gamma_{0}^{5},\binom{5}{1}\Gamma_{1}%
^{5},\binom{5}{2}\Gamma_{p}^{5},\binom{5}{3}\Gamma_{3}^{5},\binom{5}{4}%
\Gamma_{4}^{5},\binom{5}{5}\Gamma_{5}^{5},\overset{1}{\overleftrightarrow{0}%
}\right) \\
\Gamma^{6}  &  =\left(  \binom{6}{0}\Gamma_{0}^{6},\binom{6}{1}\Gamma_{1}%
^{6},\binom{6}{2}\Gamma_{p}^{6},\binom{6}{3}\Gamma_{3}^{6},\binom{6}{4}%
\Gamma_{4}^{6},\binom{6}{5}\Gamma_{5}^{6},\binom{6}{6}\Gamma_{6}^{6}\right)
\end{align}

\end{example}

giving
\begin{equation}
\Gamma\left(  X_{e}\right)  =\left(
\begin{array}
[c]{c}%
\Gamma^{0}\left(  X_{e}\right) \\
\vdots\\
\Gamma^{6}\left(  X_{e}\right)
\end{array}
\right)  =\left(
\begin{array}
