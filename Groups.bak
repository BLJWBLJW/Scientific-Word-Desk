and

\item $\ker\left\{  L_{2}^{0}\right\}  $%
\begin{align}
\ker\left\{  L_{2}^{0}\right\}   &  =\operatorname*{linspan}\left\{  \left(
\left\vert 12\right\rangle \left\langle 12\right\vert -\left\vert
13\right\rangle \left\langle 13\right\vert \right)  -\left(  \left\vert
24\right\rangle \left\langle 24\right\vert -\left\vert 34\right\rangle
\left\langle 34\right\vert \right)  ,\,\left(  \left\vert 12\right\rangle
