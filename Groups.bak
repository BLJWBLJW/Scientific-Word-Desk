\begin{remark}
These traceless operators can be expressed in Ket-Bra form by using the
resolution of the identity
\begin{equation}
\sum\limits_{1\leq l_{1}<\cdots<l_{n}\leq r}\left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{n}}\right\rangle \left\langle \varphi_{l_{1}}\cdots
\varphi_{l_{m}}\right\vert .
\end{equation}

\end{remark}

\begin{example}%
\begin{equation}
\sum_{0\leq m,n\leq r}\sum\limits_{\substack{1\leq l_{1}<\cdots<l_{n}\leq
r\\1\leq m_{1}<\cdots<m_{n}\leq r}}\left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{n}}\right\rangle \left\langle \varphi_{l_{1}}\cdots\varphi_{l_{m}%
}\right\vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{3}}a_{j_{4}%
}\left\vert \varphi_{m_{1}}\cdots\varphi_{m_{n}}\right\rangle \left\langle
\varphi_{m_{1}}\cdots\varphi_{m_{m}}\right\vert
\end{equation}

\end{example}

\begin{remark}
One can consider the various subspaces

\begin{enumerate}
\item
\begin{equation}
\mathcal{F}=\mathcal{B}\left(  \mathbb{C}^{64}\right)  =\mathcal{B}\left(
\wedge\mathbb{C}^{4}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq4}}
%EndExpansion
\mathcal{B}\left(  \wedge^{m}\mathbb{C}^{4},\wedge^{n}\mathbb{C}^{4}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq8}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq8}}
%EndExpansion
\mathcal{F}_{n}%
\end{equation}
The subspaces $\left\{  \left.  \mathcal{F}_{n}\right\vert 0\leq
n\leq8\right\}  $ are invariant to the adjoint action of $O\left(
8,\mathbb{R}\right)  ,$ thus $\mathcal{B}\left(  \mathbb{C}^{64}\right)  $
produces a reducible representation of $O\left(  8,\mathbb{R}\right)  ,$the
subrepresentations on $\left\{  \left.  \mathcal{F}_{n}\right\vert 0\leq
n\leq8\right\}  $ are irreducible.

\item
\begin{equation}
\mathcal{F}_{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq4}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq4}}
%EndExpansion
\mathcal{F}_{2n}%
\end{equation}
The subspaces $\left\{  \left.  \mathcal{F}_{2n}\right\vert 0\leq
n\leq4\right\}  $ are invariant to the adjoint action of $O\left(
8,\mathbb{R}\right)  ,$ thus $\mathcal{F}_{e}$ produces a reducible
representation of $O\left(  8,\mathbb{R}\right)  ,$the subrepresentations on
$\left\{  \left.  \mathcal{F}_{2n}\right\vert 0\leq n\leq4\right\}  $ are irreducible.

\item
\begin{equation}
\mathcal{A}_{e}=\mathcal{B}\left(  \wedge\mathbb{C}^{4}\right)  _{e}%
=\mathcal{B}\left(  \wedge\mathbb{C}^{4}\right)  _{e\neq}\oplus\mathcal{B}%
\left(  \wedge\mathbb{C}^{4}\right)  _{e0}\oplus\mathcal{B}\left(
\wedge\mathbb{C}^{4}\right)  _{e1}\oplus\mathcal{B}\left(  \wedge
\mathbb{C}^{4}\right)  _{e2}\oplus\mathcal{B}\left(  \wedge\mathbb{C}%
^{4}\right)  _{e3}\oplus\mathcal{B}\left(  \wedge\mathbb{C}^{4}\right)  _{e4}%
\end{equation}
The subspaces $\left\{  \left.  \mathcal{B}\left(  \wedge\mathbb{C}%
^{4}\right)  _{en}\right\vert 0\leq n\leq4\right\}  $ are invariant to the
adjoint action of $U\left(  4\right)  ,$ thus $\mathcal{A}_{e}$ produces a
reducible representation of $U\left(  4\right)  ,$ the subrepresentations on
$\left\{  \left.  \mathcal{B}\left(  \wedge\mathbb{C}^{4}\right)
_{en}\right\vert 0\leq n\leq4\right\}  $ are irreducible.

\item
\begin{equation}
\mathcal{A}_{1e}=\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)
_{e}=\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e\neq}%
\oplus\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e0}\oplus
\mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e1}\oplus\mathcal{B}%
_{1}\left(  \wedge\mathbb{C}^{4}\right)  _{e2}\oplus\mathcal{B}_{1}\left(
\wedge\mathbb{C}^{4}\right)  _{e3}\oplus\mathcal{B}_{1}\left(  \wedge
\mathbb{C}^{4}\right)  _{e4}%
\end{equation}
The subspaces $\left\{  \left.  \mathcal{B}_{1}\left(  \wedge\mathbb{C}%
^{4}\right)  _{en}\right\vert 0\leq n\leq4\right\}  $ are invariant to the
adjoint action of $U\left(  4\right)  ,$ thus $\mathcal{A}_{1e}$ produces a
reducible representation of $U\left(  4\right)  ,$ the subrepresentations on
$\left\{  \left.  \mathcal{B}_{1}\left(  \wedge\mathbb{C}^{4}\right)
_{en}\right\vert 0\leq n\leq4\right\}  $ are irreducible.

\item \emph{The bases of these subspaces}%
\begin{equation}
\mathcal{F}\supset\mathcal{F}_{e}\supset\mathcal{A}_{e}%
\end{equation}
\emph{ can be expressed in terms of Ket-Bra, Second Quantized or Majorano
operators.} In particular the bases of $\mathcal{A}_{e}$ are given by the preceding.
\end{enumerate}
\end{remark}

\begin{lemma}
$\mathcal{F}$ is a $w^{\ast}$-algebras, while $\mathcal{F}_{e}$ and
$\mathcal{A}_{e}$ are sub $w^{\ast}$-algebras of $\mathcal{F}$.
\end{lemma}

\begin{lemma}
The closure of $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{en}$ wrt strong operator norm is $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{en}$, that contains non trace class operators. Hence
the closure contains operators that have zero, undefined or infinite trace.
\end{lemma}

$\lceil$The second quantized map is sometimes algebraic
\begin{equation}
\Gamma\left(  \left\vert 12\right\rangle \left\langle 23\right\vert \right)
=a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{3}=a_{2}^{\dagger}a_{2}a_{1}^{\dagger
}a_{3}=\Gamma\left(  \overset{}{\left\vert 2\right\rangle \left\langle
2\right\vert }\right)  \Gamma\left(  \overset{}{\left\vert 1\right\rangle
\left\langle 3\right\vert }\right)  =2\Gamma\left(  \overset{}{\left\vert
1\right\rangle \left\langle 3\right\vert \boxtimes\left\vert 2\right\rangle
\left\langle 2\right\vert }\right)
\end{equation}
but in general it is not%
\begin{gather}
\Gamma\left(  \left\vert 22\right\rangle \left\langle 22\right\vert \right)
=2\Gamma\left(  \left\vert 2\right\rangle \left\langle 2\right\vert
\boxtimes\left\vert 2\right\rangle \left\langle 2\right\vert \right)  =0\\
\nshortparallel\\
a_{2}^{\dagger}a_{2}^{\dagger}a_{2}a_{2}=n_{2}n_{2}=\Gamma\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  \Gamma\left(  \left\vert
2\right\rangle \left\langle 2\right\vert \right)  =n_{2}=\Gamma\left(
\left\vert 2\right\rangle \left\langle 2\right\vert \right)  .
\end{gather}
$\rfloor$

\begin{remark}
The expansion
\begin{align}
L_{n}^{p}\left(  X\right)   &  =\sum\limits_{\substack{1\leq j_{1}%
<\cdots<j_{p}\leq r\\1\leq k_{1}<\cdots<k_{p}\leq r}}\left(  \operatorname{Tr}%
\left\{  X\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
P_{n-p}\right\}  \right)  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\langle \left.  \left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\vert \boxtimes P_{n-p}\right\vert X\right\rangle
_{\mathcal{B}\left(  \mathcal{H}^{n}\right)  }\left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\langle \left.  \left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\vert \right\vert L_{n}^{p}\left(  X\right)
\right\rangle _{\mathcal{B}\left(  \mathcal{H}^{p}\right)  }\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{p}}\right\vert
\end{align}
confirms that the adjoint of the contraction map $L_{n}^{p}$ is the expansion
map $\Gamma_{p}^{n}$%
\begin{equation}
\Gamma_{p}^{n}:\mathcal{B}\left(  \mathcal{H}^{p}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{n}\right)  ;0\leq p\leq n,0\leq n\leq r
\end{equation}
\emph{defined by }%
\begin{equation}
\Gamma_{p}^{n}\left(  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert
\right)  =\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
P_{n-p}.
\end{equation}

\end{remark}

As the expansion map is the adjoint of the contraction map hence one has the
relationship
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  =\operatorname{Ran}\left\{  \Gamma_{p}%
^{n}\right\}  ^{\bot}\cap\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\subset\mathcal{B}\left(  \mathcal{H}^{n}\right)  ;\,0\leq p\leq n,0\leq n\leq
r.
\end{equation}


\begin{example}%
\begin{gather}
\mathcal{H}^{2}=\ker\left\{  L_{n}^{2}\right\}  ^{\bot}\oplus\ker\left\{
L_{n}^{2}\right\}  =\operatorname{Ran}\left\{  \Gamma_{2}^{n}\right\}
\oplus\ker\left\{  L_{n}^{2}\right\} \\
\Gamma_{2}^{n}\left(  X\right)  =X\boxtimes P_{\mathcal{H}^{n-2}}\in
\ker\left\{  L_{n}^{2}\right\}  ^{\bot}\\
L_{n}^{2}:\operatorname{Ran}\left\{  \Gamma_{2}^{n}\right\}  \cap
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  \text{ is injective.}%
\end{gather}

\end{example}

Further as
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  \supseteq\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  ,0\leq n\leq r
\end{equation}
the expansion map is defined on
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,0\leq n\leq r
\end{equation}
allowing one to define
\begin{gather}
\Gamma_{p}^{n}\circ L_{q}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
\rightarrow\mathcal{B}\left(  \mathcal{H}^{n}\right) \\
\,0\leq p\leq q\leq n,0\leq n\leq r,
\end{gather}
by
\begin{align}
&  \left\langle \left.  L_{q}^{p}\left(  \left\vert \varphi_{j_{1}}%
\cdots\varphi_{jq}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{q}}\right\vert \right)  \right\vert L_{n}^{p}\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{n}}\right\vert \right)  \right\rangle _{\mathcal{B}\left(
\mathcal{H}^{p}\right)  }\\
&  =\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{q}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{q}}\right\vert
\right\vert \Gamma_{p}^{q}\circ L_{n}^{p}\left(  \left\vert \varphi_{l_{1}%
}\cdots\varphi_{l_{n}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{n}}\right\vert \right)  \right\rangle _{\mathcal{B}\left(
\mathcal{H}^{q}\right)  }\\
&  =\left\langle \left.  \Gamma_{p}^{n}\circ L_{q}^{p}\left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{jq}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{q}}\right\vert \right)  \right\vert \left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{n}}\right\vert \right)  \right\rangle _{\mathcal{B}\left(
\mathcal{H}^{n}\right)  }.
\end{align}


\begin{remark}
As the \emph{contraction} maps are \emph{surjective} the \emph{expansion} maps
are \emph{injective}.
\end{remark}

\begin{lemma}
The expansions maps $\left\{  \Gamma_{p}^{n};\,0\leq p\leq n,0\leq n\leq
r\right\}  $ are injective with the properties
\begin{equation}
\Gamma_{p}^{n}:\mathcal{B}\left(  \mathcal{H}^{p}\right)  \rightarrow%
%TCIMACRO{\tbigoplus \limits_{0\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q\leq p}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{q};\,0\leq p\leq n,0\leq n\leq r
\end{equation}
and are isomorphisms
\begin{equation}
\Gamma_{p}^{n}:\mathcal{B}\left(  \mathcal{H}^{p}\right)  _{q}\rightarrow
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{q};\,0\leq p\leq n,0\leq n\leq r.
\end{equation}

\end{lemma}

\section{Exponential Map}

\begin{itemize}
\item The exponential map
\begin{equation}
\exp:\mathcal{G}\rightarrow G
\end{equation}
\emph{is not generally surjective}. However if $G$ is connected the
\emph{exponential map is surjective onto a neighborhood of the identity}, and
since a neighborhood of the identity of a connected topological group
generates the group, once you know what a representation does in a
neighborhood of the identity, that determines what it does everywhere.

\item If $G$ is \emph{simply connected and finite}, then the exponential
provides an unique equivalence between \emph{representations} of the
finite-dimensional Lie algebra $\mathcal{G}$ and representations of the
\emph{simply connected }Lie group $G$ with Lie algebra $\mathcal{G}$.

\item Let $G$ be a Lie group. \emph{All representations }of $G$ give rise to
representations of $\mathcal{G}$ by differentiation. However \emph{not all
}representations of $\mathcal{G}$ come from derivatives. Those representations
of $\mathcal{G}$ that come from derivatives are representations of the
\emph{universal cover} of $G$. When $G$ \emph{is simply connected, all
representations} of $\mathcal{G}$ come from $G$ as derivatives.

\item If we know the representations of $\mathcal{G}$ we can determine by
exponentiation the representations of the universal cover $\widetilde{G}$ of
$G$ from which they are derived by exponentiation. \emph{This determines them
in a neigbhorhood of the identity}. For the representations of $\mathcal{G}$
that come from $G$, if $G$ is connected, then a neigbhorhood of the identity
generates it, so that \emph{this} is enough to reconstruct the representation everywhere.

\item If $G$ is a \emph{real (finite-dimensional)} Lie group with Lie algebra
$\mathcal{G}$ then the following are equivalent:\newline

\begin{description}
\item[*] $\exp$ is \emph{injective}

\item[*] $\exp$ is \emph{bijective};

\item[*] $\exp$ is a \emph{real analytic diffeomorphism};

\item[*] $G$ is \emph{solvable, simply connected}, and $\mathcal{G}$ does not
admit $e$ (Lie algebra of $E)$ as subalgebra of a quotient;

\item[*] $G$ is \emph{solvable, simply connected}, and $\mathcal{G}$ does not
admit $e$ or $\widetilde{e}$ as subalgebra;

\item[*] $G$ has no closed subgroup isomorphic to either the circle
$\mathbb{R}/\mathbb{Z}$, the universal covering $S\widetilde{L(2,\mathbb{R})}%
$, $E$ or $\widetilde{E}$.

\item[*] $G$ is \emph{connected and compact,}

\item[*] $G$ is \emph{connected and nilpotent},

\item[*] $G=GL(n,\mathbb{C})$ (as a real group) .

\item In the above $e$ is the $3$-dimensional Lie algebra with basis $(H,X,Y)$
and bracket
\begin{equation}
\lbrack H,X]=Y,\quad\lbrack H,Y]=-X,\quad\lbrack X,Y]=0.
\end{equation}
It is isomorphic to the Lie algebra of the group of isometries of the plane.
Its central extension $\widetilde{e}$ is defined as the $4$-dimensional Lie
algebra defined by adding a central generator $Z$ and the additional nonzero
bracket
\begin{equation}
\lbrack X,Y]=Z.
\end{equation}
And $E$ and $\widetilde{E}$ are the $3$-dimensional and $4$-dimensional simply
connected solvable Lie groups associated to $e$ and $\widetilde{e}$ respectively.
\end{description}
\end{itemize}

\begin{theorem}
Every simple \emph{exponential real Lie group} is isomorphic to one of the
following Lie groups:
\end{theorem}

\begin{enumerate}
\item A compact simple connected Lie group.

\item $PSL(n,\mathbb{C}),\quad n\geq2$.

\item A Lie group described by%
\begin{equation}
\widetilde{PSL(2,\mathbb{R})}=PSU(1,1)
\end{equation}
and
\begin{equation}
\widetilde{PSO(4,2,\mathbb{R})}=PSL(2,2)
\end{equation}
or $SU\left(  n,1\right)  ,\quad m\geq3.$

\item A Lie group covered by $SL(n,\mathbb{H}),\quad n\geq2$.

\item A Lie group covered by $Spin(2n,1),\quad n\geq2$.

\item A Lie group covered by $Sp(p,q),\quad p\geq q\geq1$.

\item A Lie group covered by $Spin(2n-1,1),\quad n\geq3$.

\item $Spin(2n-2,2)/\U{3008} z\U{3009} $ or $PSO(2n-2,2)_{0},\quad n\geq4$
even. Where $\U{3008} z\U{3009} $ is the center of the group.

\item $PSO(2n-2,2)_{0},\quad n\geq5$ odd.

\item $SO\ast(2n),Spin\ast(2n)/\U{3008} z\prime\U{3009} ,$ or $PSO\ast
(2n),\quad n\geq4$ even.

\item A Lie group covered by $\widetilde{SO^{8}}\ast(2n)$, $\quad n\geq3$ odd.

\item $EIV=E_{6},$
\end{enumerate}

\begin{theorem}
\emph{Cartan. It is always possible to map a Lie algebra onto its Lie group
with a product of exponential mappings.}
\begin{gather}
\text{algebra \qquad= \qquad noncompact generators\qquad+\qquad compact
generators}\\
\overset{\exp}{\downarrow}\qquad\qquad\qquad\qquad\qquad\qquad\overset{\exp
}{\downarrow}\qquad\qquad\qquad\qquad\qquad\qquad\overset{\exp}{\downarrow
}\qquad\\
\qquad\quad\text{Group\quad\qquad=}\qquad\quad\quad\qquad\text{coset
representatives\quad\quad\quad}\times\quad\text{compact subgroup}%
\end{gather}

\end{theorem}

The algebraic manifold parameterizing the exponential of the noncompact
generators is $\mathbb{R}^{m}$, for suitable $m$ (the number of noncompact
generators). The manifold that parameterizes the exponential of the compact
generators is compact.

\begin{remark}
Lie groups with the same covering group have isomorphic Lie algebras, but two
Lie groups with isomorphic \emph{Lie algebras need not be isomorphic}.
\end{remark}

\begin{remark}
\emph{There is a unique Lie algebra for every Lie group}. \emph{For each Lie
algebra there may be many inequivalent Lie groups.} \emph{But there is a
unique Lie group, }$G$\emph{,} called the \emph{universal covering group}.
This group is \emph{simply connected}: every loop starting and ending at the
identity can be continuously deformed to the identity. Moveover, every other
Lie group with this Lie algebra is either identical to this simply connected
Lie group, or else has the form of a quotient $G/D$, where $D$ is a discrete
invariant subgroup of $G$ whose elements commute with $G$ i.e.%
\begin{equation}
gd_{j}=d_{j}g;\quad d_{j}\in D,g\in G.
\end{equation}
If $G$ is compact it is useful to determine the largest such subgroup,
$D_{\max}$, of $G$. Then all compact Lie groups with the same Lie algebra as
$G$ are obtained by \textquotedblleft dividing\textquotedblright\ $G$ by all
possible subgroups of $D_{\max}.$
\end{remark}

For \emph{simple matrix Lie groups} $G$, computation of the discrete invariant
subgroup $D$ is a simple matter. By Schur's Lemma the only \emph{discrete}
group operations $d_{j}$ that commute with all $g\in G$ are multiples of the
identity,
\begin{equation}
gd_{j}=d_{j}g;\quad d_{j}\in D,g\in G\Rightarrow d_{j}=z\mathbb{I}.
\end{equation}


Two Lie groups with isomorphic Lie algebras are locally isomorphic. Let
$G_{1}$ and $G_{2}$ have the same Lie algebra and $G_{1}=G/D_{1}$ then $G_{1}$
is locally isomorphic with $G$. By the same argument $G_{2}$ is locally
isomorphic with $G$, and therefore also with $G_{1}$. If $G$ is compact,
$G_{1}$ and $G_{2}$ are also locally isomorphic with $G/D_{\max}$ which is a
universal image Lie group.

\begin{remark}
There is a unique correspondence between Lie algebras $\mathcal{G}$ and simply
connected Lie groups $G$. Every other \emph{Lie group} with this Lie algebra
is a quotient of the universal covering group by one of the discrete invariant
subgroups $D_{i}$ of $G$.
\end{remark}

\begin{remark}
If you exponentiate the image of a faithful linear representation of a Lie
algebra you get a linear Lie group. In general different faithful linear
representations will give you non-isomorphic linear Lie groups, but all of
them are locally isomorphic---i.e., they will have neighborhoods of the
identity that are isomorphic local Lie groups. However, it can happen that
none of these linear Lie groups is simply connected, and you have to construct
the universal covering group by another method.
\end{remark}

\begin{remark}
Recall that a Lie algebra $\mathcal{G}$ is called "compact" if its Killing
form
\begin{equation}
\left\langle \left.  X\right\vert Y\right\rangle =\operatorname{Tr}%
_{\mathcal{G}}\left\{  \operatorname{adj}\left(  X\right)  \operatorname{adj}%
\left(  Y\right)  \right\}  ,
\end{equation}
where
\begin{equation}
\operatorname{adj}\left(  X\right)  ,\operatorname{adj}\left(  Y\right)
\in\mathcal{B}\left(  \mathcal{G}\right)
\end{equation}
is \emph{negative definite}. In this case the associated Lie groups are
compact and it follows that for any of them the exponential map is surjective.
(This is because the one-parameter groups $exp(tX)$ are geodesics for the
\emph{bi-invariant Riemannian metric} and any two points of a compact
Riemannian manifold are joined by a minimizing geodesic.)
\end{remark}

\begin{remark}
That the universal covering group of a compact Lie algebra admits a faithful
linear representation needs a separate argument. That it is compact, follows
from the fact (essentially the \emph{Peter-Weyl Theorem}) that any compact Lie
group admits a faithful linear representation. Since for every Lie algebra
$\mathcal{G}$ there is a unique simply connected Lie group $G$ with Lie
algebra $\mathcal{G}$. From this follows that the universal covering group of
a connected Lie group $H$ is the (unique) simply connected Lie group $G$
having the same Lie algebra as $H$.
\end{remark}

\begin{theorem}
The only complex exponential simple Lie groups are isomorphic to
$PSL(n,\mathbb{C}),n\geq2$.
\end{theorem}

\begin{remark}
The family of \emph{compact operators is a norm-closed, two-sided, }$\ast
$\emph{-ideal} in $\mathcal{\ B}(\mathcal{H})$. Consequently, a compact
operator $T$ \emph{cannot have a bounded inverse if }$H$\emph{ is
infinite-dimensional}. As if
\begin{equation}
ST=TS=I,
\end{equation}
then the \emph{identity operator would be compact, a contradiction}.
\end{remark}

\subsection{Exponential of Projectors}%

\begin{align}
\exp\left\{  \alpha P\right\}   &  =I+\alpha P+\frac{\alpha^{2}}{2}P+\cdots\\
\exp\left\{  \alpha P\right\}  -I  &  =\alpha P+\frac{\alpha^{2}}{2}P+\cdots\\
\exp\left\{  \alpha\right\}  P  &  =P+\alpha P+\frac{\alpha^{2}}{2}%
P+\cdots=\exp\left\{  \alpha P\right\}  -I+P\\
\exp\left\{  \alpha\right\}  P-P  &  =\alpha P+\frac{\alpha^{2}}{2}P+\cdots\\
\exp\left\{  \alpha P\right\}  -I  &  =\exp\left\{  \alpha\right\}  P-P\\
\exp\left\{  \alpha P\right\}   &  =\exp\left\{  \alpha\right\}  P+\left(
I-P\right)
\end{align}%
\begin{align}
\exp\left\{  -\alpha P\right\}  \exp\left\{  \alpha P\right\}   &  =\left(
\exp\left\{  -\alpha\right\}  P+\left(  I-P\right)  \right)  \left(
\exp\left\{  \alpha\right\}  P+\left(  I-P\right)  \right) \\
&  =P+\exp\left\{  -\alpha\right\}  P\left(  I-P\right)  +\exp\left\{
-\alpha\right\}  P\left(  I-P\right)  +\left(  I-P\right)  \left(  I-P\right)
\\
&  =P+I-P=I.
\end{align}


\subsection{Partial Isometries}%

\begin{equation}
a_{j}^{\dagger}a_{k}a_{k}^{\dagger}a_{j}=a_{j}^{\dagger}\left(  1-a_{k}%
^{\dagger}a_{k}\right)  a_{j}=a_{j}^{\dagger}a_{j}-a_{j}^{\dagger}%
a_{k}^{\dagger}a_{k}a_{j}=a_{j}^{\dagger}a_{j}-a_{j}^{\dagger}a_{j}%
a_{k}^{\dagger}a_{k}=n_{j}-n_{j}n_{k}%
\end{equation}%
\begin{equation}
\left(  n_{j}-n_{j}n_{k}\right)  \left(  n_{j}-n_{j}n_{k}\right)
=n_{j}-2n_{j}n_{k}+n_{j}n_{k}=n_{j}-n_{j}n_{k}%
\end{equation}%
\begin{align}
&  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}a_{m}^{\dagger}a_{l}^{\dagger}%
a_{k}a_{j}=a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{l}^{\dagger}a_{m}%
a_{m}^{\dagger}a_{k}a_{j}=a_{j}^{\dagger}a_{k}^{\dagger}\left(  1-a_{l}%
^{\dagger}a_{l}\right)  \left(  1-a_{m}^{\dagger}a_{m}\right)  a_{k}a_{j}\\
&  =a_{j}^{\dagger}a_{k}^{\dagger}\left(  1-n_{l}\right)  \left(
1-n_{m}\right)  a_{k}a_{j}=a_{j}^{\dagger}a_{k}^{\dagger}\left(  1-n_{l}%
-n_{m}+n_{l}n_{m}\right)  a_{k}a_{j}\\
&  =a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger
}n_{l}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}n_{m}a_{k}a_{j}+a_{j}^{\dagger
}a_{k}^{\dagger}n_{l}n_{m}a_{k}a_{j}%
\end{align}
Let
\begin{equation}
\left\{  j,k\right\}  \cap\left\{  l,m\right\}  =\phi
\end{equation}
then
\begin{align}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}%
n_{l}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}n_{m}a_{k}a_{j}+a_{j}^{\dagger
}a_{k}^{\dagger}n_{l}n_{m}a_{k}a_{j}  &  =n_{j}n_{k}-n_{j}n_{k}n_{l}%
n_{m}-n_{j}n_{k}n_{l}n_{m}+n_{j}n_{k}n_{l}n_{m}=n_{j}n_{k}-n_{j}n_{k}%
n_{l}n_{m}\\
&  =n_{j}n_{k}\left(  1-n_{l}n_{m}\right)
\end{align}
and is a projector as
\begin{align}
n_{j}n_{k}\left(  1-n_{l}n_{m}\right)  n_{j}n_{k}\left(  1-n_{l}n_{m}\right)
&  =n_{j}n_{k}\left(  1-n_{l}n_{m}\right)  ^{2}=n_{j}n_{k}\left(  1-n_{l}%
n_{m}\right)  \left(  1-n_{l}n_{m}\right)  =n_{j}n_{k}\left(  1-2n_{l}%
n_{m}+n_{l}n_{m}\right) \\
&  =n_{j}n_{k}\left(  1-n_{l}n_{m}\right)  .
\end{align}
Let
\begin{equation}
j=l\text{ but }k\neq m
\end{equation}
then
\begin{equation}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}%
n_{j}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}n_{m}a_{k}a_{j}+a_{j}^{\dagger
}a_{k}^{\dagger}n_{j}n_{m}a_{k}a_{j}=n_{j}n_{k}-n_{j}n_{k}n_{m}=n_{j}%
n_{k}\left(  1-n_{m}\right)
\end{equation}
and is a projector as
\begin{equation}
n_{j}n_{k}\left(  1-n_{m}\right)  ^{2}=n_{j}n_{k}\left(  1-2n_{m}%
+n_{m}\right)  =n_{j}n_{k}\left(  1-n_{m}\right)  .
\end{equation}
Let
\begin{equation}
j\neq l\text{ but }k=m
\end{equation}
then we get the same result by symmetry. Let
\begin{equation}
j=m\text{ but }k\neq l
\end{equation}
then
\begin{equation}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}%
n_{l}a_{k}a_{j}-a_{j}^{\dagger}a_{k}^{\dagger}n_{m}a_{k}a_{j}+a_{j}^{\dagger
}a_{k}^{\dagger}n_{l}n_{m}a_{k}a_{j}=n_{j}n_{k}-n_{j}n_{k}n_{l}=n_{j}%
n_{k}\left(  1-n_{l}\right)
\end{equation}
which is a projector.

\begin{lemma}
$a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}$ are partial isometries.
\end{lemma}

\begin{remark}
If $\left(  jk\right)  $ $=\left(  lm\right)  $ then $a_{j}^{\dagger}%
a_{k}^{\dagger}a_{l}a_{m}$ is a projector.
\end{remark}


