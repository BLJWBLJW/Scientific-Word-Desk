\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2}=\ker\left\{
L_{2}^{1}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
1-2\right)  2d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
1-2\right)  1d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
1-2\right)  0d}\\
&  =\operatorname*{linspan}\left\{  \left\vert 12\right\rangle \left\langle
34\right\vert ,\left\vert 13\right\rangle \left\langle 24\right\vert
,\left\vert 14\right\rangle \left\langle 23\right\vert ,\left\vert
23\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 13\right\vert ,\left\vert 34\right\rangle \left\langle
12\right\vert ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 12\right\rangle \left\langle 14\right\vert -\left\vert
32\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{6}\right)  \right\}
^{\dagger}\\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right)  \right. \\
&  \left.  \left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
