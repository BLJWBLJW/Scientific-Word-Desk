\begin{remark}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  0-1\right)  }%
\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{1}.
\end{equation}

\end{remark}

\begin{remark}
The ket-bra basis can generate Trace Class, Hilbert Schmidt, Compact or
Bounded operators depending on the type of limit used. The finite rank
operators can be expanded as%
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{p},
\end{equation}
where
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{0}=\left(
%TCIMACRO{\tbigoplus \limits_{1\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq p\leq n}}
%EndExpansion
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{p}\right)  ^{c},
\end{equation}
giving
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}=\overline{\mathcal{B}%
_{00}\left(  \mathcal{H}^{n}\right)  _{p}}^{TC},0\leq p\leq n.
\end{equation}

\end{remark}

\begin{remark}
What are the properties of
\begin{equation}
\overline{\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{p}}^{HS}%
,\overline{\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{p}}%
^{OpNorm},\overline{\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{p}%
}^{Strong}?
\end{equation}
The contraction map is probably not continuous wrt the operator norm or strong
operator topologies. Each of these spaces is the closure of Ket-Bra operators.
\end{remark}

\subparagraph{Details of the Contraction and Expansion Maps}

\emph{ }The $L_{n}^{p}$ contraction of $X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  $ is given by \emph{ }%
\begin{align}
&  L_{n}^{p}\left(  X\right)  =\sum\limits_{\substack{1\leq l_{p+1}%
<\cdots<l_{n}\leq r\\1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}<\cdots
<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert X\varphi_{j_{1}}\cdots\varphi_{j_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\rangle \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
L_{n}^{p}\left(  X\right)  _{k_{1}\cdots k_{p}j_{1}\cdots j_{p}},
\end{align}
where%
\[
X=\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
X_{j_{1}\cdots j_{n}k_{1}\cdots k_{n}}.
\]
The expansion map $\Gamma_{p}^{n}$ is the adjoint of $L_{n}^{p}$ and determine
the vector coefficients of $L_{n}^{p}\left(  X\right)  $ by
\begin{align}
L_{n}^{p}\left(  X\right)  _{k_{1}\cdots k_{p}j_{1}\cdots j_{p}}  &
=\left\langle \left.  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert
\right\vert L_{n}^{p}\left(  X\right)  \right\rangle _{\mathcal{B}\left(
\mathcal{H}^{p}\right)  }=\operatorname{Tr}_{\mathcal{H}^{n}}\left\{
X\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert ]\boxtimes P_{n-p}\right\} \\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert X\varphi_{j_{1}}\cdots\varphi_{j_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\rangle ,
\end{align}
where we have used the definition of the partial traces and by observing\emph{
}%
\begin{align}
L_{n}^{p}\left(  X\right)   &  =\sum\limits_{\substack{1\leq j_{1}%
<\cdots<j_{p}\leq r\\1\leq k_{1}<\cdots<k_{p}\leq r\\1\leq j_{p+1}%
<\cdots<j_{n}\leq r}}X_{j_{1}\cdots j_{p}l_{p+1}\cdots l_{n}k_{1}\cdots
k_{p}l_{p+1}\cdots l_{n}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r\\1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle \left.
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\vert X\varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}%
\cdots\varphi_{l_{n}}\right\rangle \left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}L_{n}^{p}\left(  X\right)  _{j_{1}\cdots j_{p}k_{1}\cdots
k_{p}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert ,
\end{align}


that leads to
\begin{align}
&  \sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r\\1\leq j_{p+1}<\cdots<j_{n}\leq r}}\operatorname{Tr}%
\left\{  X\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{j_{p+1}%
}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\varphi_{j_{p+1}}\cdots\varphi_{j_{n}}\right\vert \right\}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r\\1\leq j_{p+1}<\cdots<j_{n}\leq r}}\operatorname{Tr}%
\left\{  X\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
\left\vert \varphi_{j_{p+1}}\cdots\varphi_{j_{n}}\right\rangle \left\langle
\varphi_{j_{p+1}}\cdots\varphi_{j_{n}}\right\vert \right\}  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\operatorname{Tr}\left\{  X\left\vert \varphi_{k_{1}%
}\cdots\varphi_{k_{p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\vert \boxtimes P_{n-p}\right\}  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{p}}\right\vert ,
\end{align}
i.e.
\begin{align}
L_{n}^{p}\left(  X\right)   &  =\sum\limits_{\substack{1\leq j_{1}%
<\cdots<j_{p}\leq r\\1\leq k_{1}<\cdots<k_{p}\leq r}}\operatorname{Tr}\left\{
X\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes P_{n-p}\right\}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\langle \left.  \left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\vert \boxtimes P_{n-p}\right\vert X\right\rangle
_{\mathcal{B}\left(  \mathcal{H}^{n}\right)  }\left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{p}}\right\vert \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\langle \left.  \left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\vert \right\vert L_{n}^{p}\left(  X\right)
\right\rangle _{\mathcal{B}\left(  \mathcal{H}^{p}\right)  }\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{p}}\right\vert ,
\end{align}
thus
\begin{equation}
\left\langle \left.  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert
\right\vert L_{n}^{p}\left(  X\right)  \right\rangle _{\mathcal{B}\left(
\mathcal{H}^{p}\right)  }=\operatorname{Tr}_{\mathcal{H}^{n}}\left\{
X\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \boxtimes P_{n-p}\right\}  ,
\end{equation}
and
\begin{align}
L_{n}^{p}\left(  X\right)  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}  &
=\sum_{\substack{1\leq i_{1}<\cdots<i_{n}\leq r\\1\leq l_{1}<\cdots
<l_{n-p}\leq r}}\left\langle \left.  \overset{}{\varphi_{i_{1}}\cdots
\varphi_{i_{n}}}\right\vert \left(  \overset{}{X\left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{p}}\right\vert \boxtimes\left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{n-p}}\right\rangle \left\langle \varphi_{l_{1}}\cdots
\varphi_{l_{n-p}}\right\vert }\right)  \varphi_{i_{1}}\cdots\varphi_{i_{n}%
}\right\rangle \\
&  =\sum_{\substack{1\leq i_{1}<\cdots<i_{n}\leq r\\1\leq l_{1}<\cdots
<l_{n-p}\leq r}}\left\langle \left.  \overset{}{\varphi_{i_{1}}\cdots
\varphi_{i_{n}}}\right\vert \left(  \overset{}{X\left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{p}}\varphi_{l_{1}}\cdots\varphi_{l_{n-p}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{1}}\cdots
\varphi_{l_{n-p}}\right\vert }\right)  \varphi_{i_{1}}\cdots\varphi_{i_{n}%
}\right\rangle \\
&  =\sum_{\substack{1\leq i_{1}<\cdots<i_{n}\leq r\\1\leq l_{1}<\cdots
<l_{n-p}\leq r}}\left\langle \left.  \varphi_{i_{1}}\cdots\varphi_{i_{n}%
}\right\vert X\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{1}}\cdots
\varphi_{l_{n-p}}\right\rangle \delta_{\left(  k_{1}\cdots k_{p}l_{1}\cdots
l_{n-p}\right)  \left(  i_{1}\cdots i_{n}\right)  }.
\end{align}


\begin{example}
$r=5,n=4,p=2,j_{1}=3,j_{2}=5,k_{1}=2,k_{2}=3,$%
\begin{gather}
L_{n}^{p}\left(  X\right)  _{j_{1}j_{2}k_{1}k_{2}}=\sum_{\substack{1\leq
i_{1}<\cdots<i_{4}\leq5\\1\leq l_{1}<l_{2}\leq5}}\left\langle \left.
\varphi_{i_{1}}\cdots\varphi_{i_{4}}\right\vert X\varphi_{3}\varphi_{5}%
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \delta_{\left(  23l_{1}%
l_{2}\right)  \left(  i_{1}\cdots i_{4}\right)  }\\
=\sum_{1\leq l_{1}<l_{2}\leq5}\left\{  \left\langle \left.  \varphi_{1}%
\varphi_{2}\varphi_{3}\varphi_{4}\right\vert X\varphi_{3}\varphi_{5}%
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \delta_{\left(  23l_{1}%
l_{2}\right)  \left(  1234\right)  }+\left\langle \left.  \varphi_{1}%
\varphi_{2}\varphi_{3}\varphi_{5}\right\vert X\varphi_{3}\varphi_{5}%
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \delta_{\left(  23l_{1}%
l_{2}\right)  \left(  1235\right)  }\right. \\
+\left.  \left\langle \left.  \varphi_{1}\varphi_{3}\varphi_{4}\varphi
_{5}\right\vert X\varphi_{3}\varphi_{5}\varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \delta_{\left(  23l_{1}l_{2}\right)  \left(  1345\right)
}+\left\langle \left.  \varphi_{2}\varphi_{3}\varphi_{4}\varphi_{5}\right\vert
X\varphi_{3}\varphi_{5}\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\delta_{\left(  23l_{1}l_{2}\right)  \left(  2345\right)  }\right\} \\
=\left\langle \left.  \varphi_{1}\varphi_{2}\varphi_{3}\varphi_{5}\right\vert
X\varphi_{3}\varphi_{5}\varphi_{1}\varphi_{4}\right\rangle \delta_{\left(
2314\right)  \left(  1234\right)  }%
\end{gather}
$\lceil$Ordered combinatins are
\begin{align}
&  1234,1235,1345,2345\\
&  12,13,14,15,23.24,25,34,35,45
\end{align}
$\rfloor$
\end{example}

\begin{remark}
In particular
\begin{equation}
L_{n}^{n}=I_{\mathcal{H}^{n}}\equiv P_{\mathcal{H}^{n}}%
\end{equation}
and%
\begin{equation}
L_{n}^{0}\equiv\operatorname{Tr}_{\mathcal{H}^{n}}.
\end{equation}

\end{remark}

\begin{lemma}%
\begin{gather}
\operatorname{Tr}\left\{  \Gamma_{p}^{n}\left(  X_{\left(  p\right)  }\right)
\right\}  =\left(  L_{n}^{0}\circ\Gamma_{p}^{n}\right)  \left(  X_{\left(
p\right)  }\right)  =\binom{r}{n-p}\operatorname{Tr}\left\{  X_{\left(
p\right)  }\right\}  =\binom{r}{n-p}L_{p}^{0}\left(  X_{\left(  p\right)
}\right) \\
X_{\left(  p\right)  }\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{p}.
\end{gather}

\end{lemma}

\begin{corollary}
\emph{Expansion of a trace zero operator is a trace zero operator i.e. }%
\begin{equation}
\operatorname{Tr}\left\{  \Gamma_{p}^{n}\left(  X_{\left(  p\right)  }\right)
\right\}  =0\Leftrightarrow X_{\left(  p\right)  }\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{p},0\leq p\leq n\leq r.
\end{equation}
\emph{.}
\end{corollary}

\begin{example}
$p=2,n=4,r=6$%
\begin{align}
X  &  =\sum_{\substack{1\leq j_{1}<j_{2}\leq6\\1\leq k_{1}<k_{2}\leq
6}}X_{j_{1}j_{2}k_{1}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert \\
\Gamma_{2}^{4}\left(  X\right)   &  =\sum\limits_{\substack{_{\substack{1\leq
j_{1}<j_{2}\leq6\\1\leq k_{1}<k_{2}\leq6}}\\1\leq l_{3}<\cdots<l_{4}\leq
6}}X_{j_{1}j_{2}k_{1}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}%
\varphi_{l_{3}}\varphi_{l_{4}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\varphi_{l_{3}}\varphi_{l_{4}}\right\vert \\
\operatorname{Tr}\left\{  \Gamma_{2}^{4}\left(  X\right)  \right\}   &
=\left(  L_{4}^{0}\circ\Gamma_{2}^{4}\right)  \left(  X\right)  =\binom{6}%
{2}\operatorname{Tr}\left\{  X\right\}  =\binom{6}{2}L_{2}^{0}\left(
X\right)  .
\end{align}
$\lceil$%
\begin{equation}
L_{4}^{2}\circ\Gamma_{2}^{4}\left(  X\right)  =\sum
\limits_{\substack{_{\substack{1\leq j_{1}<j_{2}\leq6\\1\leq k_{1}<k_{2}\leq
6}}\\1\leq l_{3}<\cdots<l_{4}\leq6}}X_{j_{1}j_{2}k_{1}k_{2}}L_{4}^{2}\left(
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\varphi_{l_{4}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\varphi_{l_{3}%
}\varphi_{l_{4}}\right\vert \right)
\end{equation}
$\rfloor$
\end{example}

\begin{example}
The expansion map gives
\begin{align}
\Gamma_{2}^{n}\left(  \left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right)   &
=\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \boxtimes\sum_{1\leq l_{3}%
<\cdots<l_{n}\leq r}\left\vert \varphi_{l_{3}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert \\
&  =\sum_{1\leq l_{3}<\cdots<l_{n}\leq r}\left\vert \varphi_{k_{1}}%
\varphi_{k_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert
\end{align}
and the difference of expansion maps give
\begin{align}
&  \Gamma_{3}^{n}\left(  \left\vert \varphi_{k_{1}}\varphi_{k_{2}}%
\varphi_{k_{3}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\varphi_{j_{3}}\right\vert -\Gamma_{2}^{n}\left(  \left\vert \varphi_{k_{1}%
}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \right)  \right)  =\\
&  \sum_{1\leq l_{4}<\cdots<l_{n}\leq r}\left\vert \varphi_{k_{1}}%
\varphi_{k_{2}}\varphi_{k_{3}}\varphi_{l_{4}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}%
}\varphi_{l_{4}}\cdots\varphi_{l_{n}}\right\vert -\sum_{1\leq l_{3}%
<\cdots<l_{n}\leq r}\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\varphi_{l_{3}%
}\cdots\varphi_{l_{n}}\right\rangle \left\langle \varphi_{j_{1}}\varphi
_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert
\end{align}
and
\begin{align}
&  \Gamma_{3}^{n}\left(  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}%
\varphi_{j_{3}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\varphi_{j_{3}}\right\vert \right)  -\Gamma_{2}^{n}\left(  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert \right) \\
&  =\sum_{1\leq l_{3}<\cdots<l_{n}\leq r}\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert
-\sum_{1\leq l_{4}<\cdots<l_{n}\leq r}\left\vert \varphi_{j_{1}}\varphi
_{j_{2}}\varphi_{j_{3}}\varphi_{l_{4}}\cdots\varphi_{l_{n}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}}\varphi_{l_{4}%
}\cdots\varphi_{l_{n}}\right\vert \\
&  =\sum_{1\leq l_{3}\neq j_{3}<\cdots<l_{n}\leq r}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert
+\sum_{1\leq l_{4}<\cdots<l_{n}\leq r}\left\vert \varphi_{j_{1}}\varphi
_{j_{2}}\varphi_{j_{3}}\varphi_{l_{4}}\cdots\varphi_{l_{n}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}}\varphi_{l_{4}%
}\cdots\varphi_{l_{n}}\right\vert \\
&  -\sum_{1\leq l_{4}<\cdots<l_{n}\leq r}\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\varphi_{j_{3}}\varphi_{l_{4}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}%
}\varphi_{l_{4}}\cdots\varphi_{l_{n}}\right\vert \\
&  =\sum_{1\leq l_{3}\neq j_{3}<\cdots<l_{n}\leq r}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert
.
\end{align}

\end{example}

\paragraph{Relationship between the Kernals of Contraction maps and Ranges of
Expansion maps}

\begin{remark}
In the following\emph{ \underline{\emph{notice}} the difference }betwen
\emph{complimentary} and \emph{perpendicular} subspaces. Complimentary
subspaces lie in the \emph{same} Banach space, while perpendicular subspaces
lie in the \emph{dual} Banach space.
\end{remark}

\subparagraph{Contraction Maps}

The kernal of $L_{n}^{p}$ can be characterized as
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  =\left\{  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  \left\vert \,\left\langle Y,L_{n}^{p}\left(  X\right)
\right\rangle =0\,\forall Y\in\mathcal{B}\left(  \mathcal{H}^{p}\right)
\right.  \right\}  =\left\{  X\in\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  \left\vert \,\left\langle \Gamma_{p}^{n}\left(  Y\right)
,X\right\rangle =0\,\forall Y\in\mathcal{B}\left(  \mathcal{H}^{p}\right)
\right.  \right\}
\end{equation}
leading to
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  ^{\bot}=\operatorname{Ran}\left\{  \Gamma
_{p}^{n}\right\}  \subseteq\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
and
\begin{equation}
\left(  \ker\left\{  L_{n}^{p-1}\right\}  \ominus\ker\left\{  L_{n}%
^{p}\right\}  \right)  ^{\bot}=\operatorname{Ran}\left\{  \Gamma_{p}%
^{n}\right\}  \ominus\operatorname{Ran}\left\{  \Gamma_{p-1}^{n}\right\}
\subseteq\mathcal{B}\left(  \mathcal{H}^{n}\right)  .
\end{equation}


\begin{remark}
The nuclear space $\mathcal{B}_{00}\left(  \left(  \mathcal{H}^{n}\right)
\right)  $ is given by
\begin{equation}
\mathcal{B}_{00}\left(  \left(  \mathcal{H}^{n}\right)  \right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\vert \right\vert 1\leq j_{1}<\cdots<j_{n}\leq
r,1\leq k_{1}<\cdots<k_{n}\leq r\right\}  .
\end{equation}
It has certain topological properties and is closed wrt semi norms (true for
all nuclear spaces). It can be closed wrt other topologies e.g. Hilbert
Scmidt, Trace, Operator, Strong Operator, Weak Operator to produce various
spaces of operators.
\end{remark}

\begin{theorem}
The contraction maps
\begin{equation}
L_{n}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  ;1\leq n>p\leq r
\end{equation}
can be defined by its action on basis vectors
\begin{equation}
L_{n}^{p}\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert \right)
=\sum_{\substack{1\leq l_{1}<\cdots<l_{p}\leq r\\1\leq m_{1}<\cdots<m_{p}\leq
r}}\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  a_{l_{1}}^{\dagger
}\cdots a_{l_{p}}^{\dagger}a_{m_{p}}\cdots a_{m_{1}}\left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{n}}\right\vert \right\}  \left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{p}}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{p}%
}\right\vert ,
\end{equation}
where $\left\{  \varphi_{j_{1}};1\leq j_{1}\leq r\right\}  $ is a conb of
$\mathcal{H}^{1}.$
\end{theorem}

\begin{remark}%
\begin{align}
&  \operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  a_{l_{1}}^{\dagger
}\cdots a_{l_{p}}^{\dagger}a_{m_{p}}\cdots a_{m_{1}}\left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{n}}\right\vert \right\}  =\operatorname{Tr}_{\mathcal{H}^{n}%
}\left\{  a_{l_{1}}^{\dagger}\cdots a_{l_{p}}^{\dagger}a_{m_{p}}\cdots
a_{m_{1}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert \right\} \\
&  =\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
a_{l_{1}}^{\dagger}\cdots a_{l_{p}}^{\dagger}a_{m_{p}}\cdots a_{m_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}%
}=\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
a_{l_{1}}^{\dagger}\cdots a_{l_{p}}^{\dagger}a_{m_{p}}\cdots a_{m_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle _{\mathcal{H}^{n}}.
\end{align}

\end{remark}

\begin{lemma}%
\begin{align}
\ker\left\{  L_{n}^{p}\right\}   &  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  \overset{}{X}\right\vert \operatorname{Tr}_{\mathcal{H}^{n}%
}\left\{  a_{l_{1}}^{\dagger}\cdots a_{l_{p}}^{\dagger}a_{m_{p}}\cdots
a_{m_{1}}X\right\}  =0;\right. \\
&  \left.  1\leq l_{1}<\cdots<l_{p}\leq r,1\leq m_{1}<\cdots<m_{p}\leq r;1\leq
j_{1}<\cdots<j_{n}\leq r,1\leq k_{1}<\cdots<k_{n}\leq r\right\}  ,
\end{align}
where
\begin{equation}
X=\sum_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq
r}}X_{j_{1}\cdots j_{n}1\leq k_{1}\cdots k_{n}}\left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{n}}\right\vert \in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{align}
\ker\left\{  L_{n}^{p-1}\right\}   &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \overset{}{X}\right\vert
\operatorname{Tr}_{\mathcal{H}^{n}}\left\{  a_{l_{1}}^{\dagger}\cdots
a_{l_{p-1}}^{\dagger}a_{m_{p-1}}\cdots a_{m_{1}}X\right\}  =0;\right. \\
&  \left.  1\leq l_{1}<\cdots<l_{p-1}\leq r,1\leq m_{1}<\cdots<m_{p-1}\leq
r;1\leq j_{1}<\cdots<j_{n}\leq r,1\leq k_{1}<\cdots<k_{n}\leq r\right\}  .
\end{align}

\end{corollary}

\begin{remark}
$L_{n}^{p}$ can be iterated
\begin{equation}
L_{n}^{p-1}=L_{p}^{p-1}\circ L_{n}^{p}%
\end{equation}
hence
\begin{align}
\ker\left\{  L_{n}^{p-1}\right\}   &  \supset\ker\left\{  L_{n}^{p}\right\} \\
\ker\left\{  L_{n}^{p-1}\right\}   &  =\ker\left\{  L_{n}^{p}\right\}
\oplus\ker\left\{  L_{n}^{p}\right\}  ^{c_{\ker\left\{  L_{n}^{p-1}\right\}
}}%
\end{align}
and one can deduce that
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  ^{c_{\ker\left\{  L_{n}^{p-1}\right\}  }}%
\cong\ker\left\{  L_{p}^{p-1}\right\}  .
\end{equation}

\end{remark}

\begin{theorem}%
\begin{equation}
\ker\left\{  L_{p+1}^{p}\right\}  \cong\ker\left\{  L_{n}^{p}\right\}
\ominus\ker\left\{  L_{n}^{p+1}\right\}  =\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)  }%
\equiv\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p+1\right)  }.
\end{equation}

\end{theorem}

\begin{proof}
\begin{enumerate}
\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\,\overset{\ker\left\{
L_{n}^{p}\right\}  ^{c}\cong\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
=\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{c}\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  0\right)  -\left(  1\right)
}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  1\right)
-\left(  2\right)  }\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  _{\left(  p-1\right)  -\left(  p\right)  }%
}{\overbrace{\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{c}%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  0\right)
-\left(  1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
_{\left(  1\right)  -\left(  2\right)  }\oplus\cdots\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p-1\right)  -\left(  p\right)
}}}\overset{\ker\left\{  L_{n}^{p}\right\}  }{\oplus\overbrace{\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(
n-1\right)  -\left(  n\right)  }}}%
\end{equation}


\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(
p-1\right)  -\left(  p\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)  }\oplus\cdots
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  n-1\right)
-\left(  n\right)  }%
\end{equation}


\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{p+1}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(
p-1\right)  -\left(  p\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  _{\left(  p\right)  -\left(  p+1\right)  }%
\end{equation}


\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(
p-1\right)  -\left(  p\right)  }%
\end{equation}


\item
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  _{c}\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(  0\right)  -\left(  1\right)
}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(  1\right)
-\left(  2\right)  }\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  _{\left(  p-1\right)  -\left(  p\right)  }\\
\cong\\
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(
p-1\right)  -\left(  p\right)  }%
\end{gather}


\item
\begin{equation}
\ker\left\{  L_{p+1}^{p}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  _{\left(  p\right)  -\left(  p+1\right)  }\cong\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)  }%
\end{equation}

\end{enumerate}
\end{proof}

\begin{corollary}%
\begin{equation}
\ker\left\{  L_{p+1}^{p}\right\}  =\left\{  \left.  \overset{}{X\in
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  }\right\vert
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}%
^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  =0,1\leq
j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r.\right\}  .
\end{equation}

\end{corollary}

\begin{example}
$n=5,p=3,4$

\begin{enumerate}
\item[a]
\begin{equation}
L_{5}^{3}=L_{5}^{4}\circ L_{4}^{3}%
\end{equation}


\item[b]
\begin{equation}
\ker\left\{  L_{5}^{3}\right\}  =\left\{  \left.  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{5}\right)  \right\vert \operatorname{Tr}\left\{  \left(
a_{j_{1}}^{\dagger}\cdots a_{j_{3}}^{\dagger}a_{k_{3}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  =0,1\leq j_{1}<\cdots<j_{3}\leq r,1\leq k_{1}%
<\cdots<k_{3}\leq r.\right\}
\end{equation}


\item[c]
\begin{equation}
\ker\left\{  L_{5}^{4}\right\}  =\left\{  \left.  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{5}\right)  \right\vert \operatorname{Tr}\left\{  \left(
a_{j_{1}}^{\dagger}\cdots a_{j_{4}}^{\dagger}a_{k_{4}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  =0,1\leq j_{1}<\cdots<j_{4}\leq r,1\leq k_{1}%
<\cdots<k_{4}\leq r.\right\}
\end{equation}


\item[d]
\begin{equation}
\ker\left\{  L_{4}^{3}\right\}  =\left\{  \left.  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  \right\vert \operatorname{Tr}\left\{  \left(
a_{j_{1}}^{\dagger}\cdots a_{j_{3}}^{\dagger}a_{k_{3}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  =0,1\leq j_{1}<\cdots<j_{3}\leq r,1\leq k_{1}%
<\cdots<k_{3}\leq r.\right\}
\end{equation}


\item[e]
\begin{gather}
\ker\left\{  L_{5}^{3}\right\}  \ominus\ker\left\{  L_{5}^{4}\right\} \\
\parallel\\
\left\{
\begin{array}
[c]{c}%
\left.  X\in\mathcal{B}_{1}\left(  \mathcal{H}^{5}\right)  \right\vert
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{3}}%
^{\dagger}a_{k_{3}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  =0,1\leq
j_{1}<\cdots<j_{3}\leq r,1\leq k_{1}<\cdots<k_{3}\leq r.\\
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{4}}%
^{\dagger}a_{k_{4}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  \neq0,\text{
for some }1\leq j_{1}<\cdots<j_{4}\leq r,1\leq k_{1}<\cdots<k_{4}\leq r
\end{array}
\right\} \\
\cong\ker\left\{  L_{4}^{3}\right\} \\
\parallel\\
\left\{  \left.  X\in\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
\right\vert \operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{3}}^{\dagger}a_{k_{3}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}
=0,1\leq j_{1}<\cdots<j_{3}\leq r,1\leq k_{1}<\cdots<k_{3}\leq r.\right\}  .
\end{gather}

\end{enumerate}
\end{example}

\begin{example}%
\begin{gather}
X\in\ker\left\{  L_{5}^{3}\right\}  \ominus\ker\left\{  L_{5}^{4}\right\}
\text{ if }\\
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{5}\right)  ;\operatorname{Tr}\left\{
\left(  a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}a_{1}\right)
^{\dagger}X\right\}  =0,\operatorname{Tr}\left\{  \left(  a_{1}^{\dagger}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{4}^{\dagger}a_{4}a_{3}a_{2}a_{1}\right)
^{\dagger}X\right\}  \neq0
\end{gather}

\end{example}

\begin{example}%
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{5}\right)  ;\operatorname{Tr}\left\{
\left(  a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}a_{1}\right)
^{\dagger}\left\vert 12345\right\rangle \left\langle 12346\right\vert
\right\}  =0,\operatorname{Tr}\left\{  \left(  a_{1}^{\dagger}a_{2}^{\dagger
}a_{3}^{\dagger}a_{4}^{\dagger}a_{4}a_{3}a_{2}a_{1}\right)  ^{\dagger
}\left\vert 12345\right\rangle \left\langle 12346\right\vert \right\}  \neq0
\end{equation}

\end{example}

\begin{remark}
$\Gamma_{p}^{n}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  \right)
\nsubseteqq\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  .$
\end{remark}

\begin{lemma}
The algebra $\mathcal{B}\left(  \mathcal{H}^{n}\right)  $ is irreducible (it
is a Von Neumann Algbera of Type I and is a factor) i.e. the centre is one
dimensional
\begin{equation}
\left\{  \left.  zP_{n}\right\vert z\in\mathbb{C}\right\}  =\mathcal{Z}\left(
\mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)  .
\end{equation}

\end{lemma}

\begin{example}
Let $p=0$ in this case
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{0}\right)  =\left\{  \left.  z\right\vert
z\in\mathbb{C}\right\}
\end{equation}
then
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  ^{\bot}=\operatorname{Ran}\left\{  \Gamma
_{0}^{n}\right\}  =\left\{  \left.  zP_{n}\right\vert z\neq0\in\mathbb{C}%
\right\}  =\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)
\right)  \subset\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
and
\begin{equation}
\ker\left\{  L_{n}^{0}\right\}  =\left\{  \left.  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  \right\vert \operatorname{Tr}_{\mathcal{H}%
_{\mathcal{F}}}\left\{  X\right\}  =0\right\}  \subset\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  .
\end{equation}
As $\Gamma_{0}^{n}$ is injective
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{0}\right)  =\mathbb{C}\cong\mathcal{Z}\left(
\mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)  .
\end{equation}

\end{example}

\begin{remark}
In the case of the algebra of matrices the set of diagonal matrices \emph{is
larger} than the centre of the algebra.
\end{remark}

\begin{remark}
In infinite dimensions $\ker\left\{  L_{n}^{0}\right\}  ^{\bot}\neq
\ker\left\{  L_{n}^{0}\right\}  ^{c}.$
\end{remark}

\begin{remark}
One has the Banach space decompositions%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)   &  =\ker\left\{  L_{n}%
^{p}\right\}  \oplus\ker\left\{  L_{n}^{p}\right\}  ^{c_{1}}\\
\mathcal{B}\left(  \mathcal{H}^{n}\right)   &  =\operatorname{Ran}\left\{
\Gamma_{p}^{n}\right\}  \oplus\operatorname{Ran}\left\{  \Gamma_{p}%
^{n}\right\}  ^{c}=\ker\left\{  L_{n}^{p}\right\}  ^{\bot}\oplus
\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}  ^{c}=\ker\left\{  L_{n}%
^{p}\right\}  ^{\bot}\oplus\ker\left\{  L_{n}^{p}\right\}  ^{\bot c}%
\end{align}
and
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  ^{c_{1}}\cong\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)
\end{equation}
as
\begin{equation}
\left.  L_{n}^{p}\right\vert _{\ker\left\{  L_{n}^{p}\right\}  ^{c_{1}}}%
:\ker\left\{  L_{n}^{p}\right\}  ^{c_{1}}\rightarrow\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)
\end{equation}
is an isomorphism.
\end{remark}

\begin{example}%
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  =\operatorname{Ran}\left\{
\Gamma_{0}^{n}\right\}  \oplus\operatorname{Ran}\left\{  \Gamma_{0}%
^{n}\right\}  ^{c}=\operatorname*{linspan}\left\{  \left.  zI_{\binom{r}{n}%
}\right\vert z\in\mathbb{C}\right\}  \oplus\ker\left\{  L_{n}^{0}\right\}
\end{equation}

\end{example}

\begin{remark}
In the space $\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  $
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\ker\left\{  L_{n}%
^{p}\right\}  \oplus\ker\left\{  L_{n}^{p}\right\}  ^{c_{1}}=\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  =\ker\left\{  L_{n}^{p-1}\right\}
\oplus\ker\left\{  L_{n}^{p-1}\right\}  ^{c_{1}}\\
\ker\left\{  L_{n}^{p-1}\right\}  \supseteq\ker\left\{  L_{n}^{p}\right\} \\
\ker\left\{  L_{n}^{p-1}\right\}  ^{c_{1}}\subseteq\ker\left\{  L_{n}%
^{p}\right\}  ^{c_{1}}.
\end{gather}

\end{remark}

\begin{remark}
In the dual space $\mathcal{B}\left(  \mathcal{H}^{n}\right)  $
\begin{equation}
\ker\left\{  L_{n}^{p-1}\right\}  ^{\bot}\subseteq\ker\left\{  L_{n}%
^{p}\right\}  ^{\bot}.
\end{equation}

\end{remark}

\begin{example}%
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{n}\right)   &  =\operatorname{Ran}\left\{
\Gamma_{0}^{n}\right\}  \oplus\operatorname{Ran}\left\{  \Gamma_{0}%
^{n}\right\}  ^{c}=\ker\left\{  L_{n}^{0}\right\}  ^{\bot}\oplus
\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}  ^{c}=\ker\left\{  L_{n}%
^{0}\right\}  ^{\bot}\oplus\ker\left\{  L_{n}^{0}\right\}  ^{\bot c}\\
&  =\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)
\oplus\operatorname{Ran}\left\{  \Gamma_{0}^{n}\right\}  ^{c}=\mathcal{Z}%
\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)  \oplus
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)  ^{c}.
\end{align}

\end{example}

\begin{lemma}
As $\mathcal{B}\left(  \mathcal{H}^{n}\right)  \supseteq\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  $
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  ^{\bot}=\operatorname{Ran}\left\{  \Gamma
_{p}^{n}\right\}  \supseteq\ker\left\{  L_{n}^{p}\right\}  ^{c_{1}}.
\end{equation}

\end{lemma}

\begin{remark}
In infinite dimensions
\begin{equation}
\mathcal{Z}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =0_{\binom{n}{p}}.
\end{equation}

\end{remark}

\begin{remark}
Remember that diagonal matrices \emph{are not the same} as scalar multiples of
the identity matrix.
\end{remark}

\begin{lemma}
Contraction maps can be expresssd as iterated maps
\begin{equation}
L_{n}^{p}=L_{p+1}^{p}\circ L_{p+2}^{p+1}\circ\cdots\circ L_{n-1}^{n-2}\circ
L_{n}^{n-1},
\end{equation}
i.e.
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \overset{L_{n}^{p}%
}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  =\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  \overset{L_{n}^{n-1}}{\rightarrow
}\mathcal{B}_{1}\left(  \mathcal{H}^{n-1}\right)  \overset{L_{n-1}%
^{n-2}}{\rightarrow}\cdots\overset{L_{p+2}^{p+1}}{\rightarrow}\mathcal{B}%
_{1}\left(  \mathcal{H}^{p+1}\right)  \overset{L_{p+1}^{p}}{\rightarrow
}\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  .
\end{equation}

\end{lemma}

\begin{example}%
\begin{align}
L_{n}^{2}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right) \\
L_{n}^{2}  &  =L_{3}^{2}\circ L_{4}^{3}\circ\cdots\circ L_{n-1}^{n-2}\circ
L_{n}^{n-1}.
\end{align}

\end{example}

\begin{example}
$n=2,r=4$ the kernals of the contraction maps $L_{2}^{1}$ and $L_{2}^{0}$ are
given by

\begin{enumerate}
\item $\ker\left\{  L_{2}^{1}\right\}  $%
\begin{align*}
\ker\left\{  L_{2}^{1}\right\}   &  =\operatorname*{linspan}\left\{
\left\vert 12\right\rangle \left\langle 34\right\vert ,\left\vert
13\right\rangle \left\langle 24\right\vert ,\left\vert 14\right\rangle
\left\langle 23\right\vert ,\left\vert 23\right\rangle \left\langle
14\right\vert ,\left\vert 24\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 12\right\vert ,\left(  \mathbf{6}%
\right)  \right\} \\
&  \oplus\operatorname*{linspan}\left\{  \left(  \left\vert 31\right\rangle
\left\langle 32\right\vert -\left\vert 41\right\rangle \left\langle
42\right\vert \right)  ,\left(  \left\vert 21\right\rangle \left\langle
23\right\vert -\left\vert 41\right\rangle \left\langle 43\right\vert \right)
,\left(  \left\vert 21\right\rangle \left\langle 24\right\vert -\left\vert
31\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
-\left\vert 42\right\rangle \left\langle 43\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
