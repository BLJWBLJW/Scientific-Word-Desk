[c]{c}%
\left(  \left\vert 12\right\rangle \left\langle 12\right\vert -\left\vert
13\right\rangle \left\langle 13\right\vert -\left\vert 24\right\rangle
\left\langle 24\right\vert +\left\vert 34\right\rangle \left\langle
34\right\vert \right)  ,\\
\left(  \left\vert 13\right\rangle \left\langle 13\right\vert -\left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert +\left\vert 24\right\rangle \left\langle
24\right\vert ,\left(  \mathbf{2}\right)  \right)
\end{array}
\right\} \\
\ker\left\{  L_{2}^{1}\right\}  _{0d}\subset\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0d}\\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  _{0d}\right\}  =2.
\end{gather*}
and%
\[
\ker\left\{  L_{2}^{1}\right\}  _{0d}=\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left(  \left\vert j_{1}j_{2}\right\rangle \left\langle j_{1}j_{2}\right\vert
-\left\vert j_{1}j_{3}\right\rangle \left\langle j_{1}j_{3}\right\vert
-\left\vert j_{2}j_{4}\right\rangle \left\langle j_{2}j_{4}\right\vert
+\left\vert j_{3}j_{4}\right\rangle \left\langle j_{3}j_{4}\right\vert
\right)  ,\\
\left(  \left\vert j_{1}j_{3}\right\rangle \left\langle j_{1}j_{3}\right\vert
-\left\vert j_{1}j_{4}\right\rangle \left\langle j_{1}j_{4}\right\vert
-\left\vert j_{2}j_{3}\right\rangle \left\langle j_{2}j_{3}\right\vert
+\left\vert j_{2}j_{4}\right\rangle \left\langle j_{2}j_{4}\right\vert
,\left(  \mathbf{2}\right)  \right)
\end{array}
\right\}  .
\]

\end{enumerate}
\end{definition}

\begin{example}%
\begin{gather}
\ker\left\{  L_{2}^{1}\right\}  =\ker\left\{  L_{2}^{1}\right\}  _{2d}%
\oplus\ker\left\{  L_{2}^{1}\right\}  _{1d}\oplus\ker\left\{  L_{2}%
^{1}\right\}  _{0d}\\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  \right\}  =20,\,\dim\left\{
\ker\left\{  L_{2}^{1}\right\}  _{2d}\right\}  =6,\,\dim\left\{  \ker\left\{
L_{2}^{1}\right\}  _{1d}\right\}  =12,\,\dim\left\{  \ker\left\{  L_{2}%
^{1}\right\}  _{0d}\right\}  =2.
\end{gather}

\end{example}

\begin{remark}
The diagonal elements e.g. $\left(  \left\vert 12\right\rangle \left\langle
12\right\vert -\left\vert 13\right\rangle \left\langle 13\right\vert \right)
$ are \emph{not} in the kernal $\ker\left\{  L_{2}^{1}\right\}  $ as
\begin{equation}
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  \right\}  \quad\emph{\neq0}.
\end{equation}

\end{remark}

\item In the case $p=0,n=2$ one has

\begin{enumerate}
\item
\begin{gather}
\ker\left\{  L_{2}^{0}\right\}  =\,\ker\left\{  L_{2}^{0}\right\}  _{2d}%
\oplus\ker\left\{  L_{2}^{0}\right\}  _{1d}\oplus\ker\left\{  L_{2}%
^{0}\right\}  _{0d}\\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  \right\}  =35\\
\ker\left\{  L_{2}^{0}\right\}  \supset\ker\left\{  L_{2}^{1}\right\} \\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  \right\}  =20.
\end{gather}


\item
\begin{gather}
\ker\left\{  L_{2}^{0}\right\}  _{2d}=\,\ker\left\{  L_{2}^{1}\right\}
_{2d}\\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  _{2d}\right\}  =6\\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  _{2d}\right\}  =6.
\end{gather}


\item
\begin{gather}
\ker\left\{  L_{2}^{0}\right\}  _{1d}=\ker\left\{  L_{2}^{0}\right\}
_{1d}\oplus\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{1d}%
\ominus\ker\left\{  L_{2}^{1}\right\}  _{1d}\right) \\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  _{1d}\right\}  =24\\
\ker\left\{  L_{2}^{0}\right\}  _{1d}\supset\ker\left\{  L_{2}^{1}\right\}
_{1d}\\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  _{1d}\right\}  =12.
\end{gather}


\item
\begin{gather}
\ker\left\{  L_{2}^{0}\right\}  _{0d}=\operatorname*{linspan}\left\{  \left(
\left\vert 12\right\rangle \left\langle 12\right\vert -\left\vert
13\right\rangle \left\langle 13\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 13\right\vert -\left\vert 14\right\rangle
\left\langle 14\right\vert \right)  ,\right. \\
\left.  \left(  \left\vert 14\right\rangle \left\langle 14\right\vert
-\left\vert 23\right\rangle \left\langle 23\right\vert \right)  ,\left(
\left\vert 23\right\rangle \left\langle 23\right\vert -\left\vert
24\right\rangle \left\langle 24\right\vert \right)  ,\left(  \left\vert
24\right\rangle \left\langle 24\right\vert -\left\vert 34\right\rangle
\left\langle 34\right\vert \right)  \right\} \\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  _{0d}\right\}  =5\\
\ker\left\{  L_{2}^{0}\right\}  _{0d}\supset\ker\left\{  L_{2}^{1}\right\}
_{0d}\\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  _{0d}\right\}  =2.
\end{gather}


\item
\begin{gather}
\ker\left\{  L_{2}^{0}\right\}  =\,\ker\left\{  L_{2}^{0}\right\}  _{2d}%
\oplus\ker\left\{  L_{2}^{0}\right\}  _{1d}\oplus\ker\left\{  L_{2}%
^{0}\right\}  _{0d}=\operatorname*{linspan}\left\{  \ker\left\{  L_{2}%
^{1}\right\}  \left(  \mathbf{20}\right)  \right.  ,\\
\left(  \left\vert 12\right\rangle \left\langle 12\right\vert -\left\vert
13\right\rangle \left\langle 13\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 13\right\vert -\left\vert 14\right\rangle
\left\langle 14\right\vert \right)  ,\left(  \left\vert 14\right\rangle
\left\langle 14\right\vert -\left\vert 23\right\rangle \left\langle
23\right\vert \right)  ,\left(  \left\vert 23\right\rangle \left\langle
23\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert \right)
,\left(  \left\vert 24\right\rangle \left\langle 24\right\vert -\left\vert
34\right\rangle \left\langle 34\right\vert \right)  \left.  \left(
\mathbf{5}\right)  \right\}
\end{gather}

\end{enumerate}

\item The space $\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $ can be
expanded as
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)   &  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(  2\right)  }\\
&  \dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}
=36=1+15+20,
\end{align}
where
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  1\right)  -\left(
2\right)  }  &  =\ker\left\{  L_{2}^{1}\right\}  \ominus\ker\left\{  L_{2}%
^{2}\right\}  =\,\ker\left\{  L_{2}^{1}\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0\right)  -\left(
1\right)  }  &  =\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}%
^{1}\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0}  &  =\left(
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0\right)  -\left(
1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
1\right)  -\left(  2\right)  }\right)  ^{c}\\
\ker\left\{  L_{2}^{2}\right\}   &  =\phi.
\end{align}


\item The dimensions of the spaces are

\begin{enumerate}
\item
\begin{align}
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}   &
=36\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}   &
=16\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  \right\}   &  =1.
\end{align}


\item
\begin{gather}
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
1\right)  -\left(  2\right)  }\right\}  =\dim\left\{  \ker\left\{  L_{2}%
^{1}\right\}  \ominus\ker\left\{  L_{2}^{2}\right\}  \right\}  =\dim\left\{
\ker\left\{  L_{2}^{1}\right\}  \right\}  =20\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(
0\right)  -\left(  1\right)  }\right\}  =\dim\left\{  \ker\left\{  L_{2}%
^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}  \right\}  =15\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}\right\}
=\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0}\right\}  =1.
\end{gather}

\end{enumerate}

\item The space $\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  $ can be
expanded as
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)   &  =\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  _{\left(  0\right)  -\left(  1\right)  }\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}   &
=16=1+15,
\end{align}
where
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0\right)  -\left(
1\right)  }  &  =\ker\left\{  L_{1}^{0}\right\}  \ominus\ker\left\{  L_{1}%
^{1}\right\}  =\,\ker\left\{  L_{1}^{0}\right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}  &  =\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  _{\left(  0\right)  -\left(  1\right)
}^{c}\\
\ker\left\{  L_{1}^{1}\right\}   &  =\phi.
\end{align}
and
\begin{align}
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\left(
0\right)  -\left(  1\right)  }\right\}   &  =\dim\left\{  \ker\left\{
L_{1}^{0}\right\}  \ominus\ker\left\{  L_{1}^{1}\right\}  \right\}  =15\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0}\right\}   &
=1.
\end{align}


\item One has the isomorphisms
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  _{0}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  _{\left(  0\right)  -\left(  1\right)  }\cong\,\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{0}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\left(  0\right)  -\left(  1\right)  }.
\end{equation}


\begin{remark}%
\begin{align}
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{2}\left(  \left\vert
12\right\rangle \left\langle 12\right\vert -\left\vert 13\right\rangle
\left\langle 13\right\vert \right)  \right\}   &  =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert
12\right\rangle \left\langle 12\right\vert -\left\vert 13\right\rangle
\left\langle 13\right\vert \right)  \right\}   &  =0.
\end{align}%
\begin{align}
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{2}\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  \right\}   &  =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  \right\}  \,  &  \emph{\neq0}.
\end{align}

\end{remark}

\item In the case $p=0,1$ and $n=2$ one has

\begin{enumerate}
\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1d}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0d}%
\end{equation}


\item
\begin{align}
\ker\left\{  L_{2}^{0}\right\}  _{2d}  &  =\ker\left\{  L_{2}^{0}\right\}
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2d}\\
\ker\left\{  L_{2}^{0}\right\}  _{1d}  &  =\ker\left\{  L_{2}^{0}\right\}
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{1d}\\
\ker\left\{  L_{2}^{0}\right\}  _{0d}  &  =\ker\left\{  L_{2}^{0}\right\}
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0d}%
\end{align}


\item
\begin{align}
\ker\left\{  L_{2}^{0}\right\}   &  =\ker\left\{  L_{2}^{0}\right\}
_{2d}\oplus\ker\left\{  L_{2}^{0}\right\}  _{1d}\oplus\ker\left\{  L_{2}%
^{0}\right\}  _{0d}\\
\ker\left\{  L_{2}^{1}\right\}   &  =\ker\left\{  L_{2}^{1}\right\}
_{2d}\oplus\ker\left\{  L_{2}^{1}\right\}  _{1d}\oplus\ker\left\{  L_{2}%
^{1}\right\}  _{0d}\\
\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}   &
=\left(  \ker\left\{  L_{2}^{0}\right\}  _{1d}\ominus\ker\left\{  L_{2}%
^{1}\right\}  _{1d}\right)  \oplus\left(  \ker\left\{  L_{2}^{0}\right\}
_{0d}\ominus\ker\left\{  L_{2}^{1}\right\}  _{0d}\right)
\end{align}


\item
\begin{gather}
\ker\left\{  L_{2}^{0}\right\}  _{0d}=\operatorname*{linspan}\left\{  \left(
\left\vert 12\right\rangle \left\langle 12\right\vert -\left\vert
13\right\rangle \left\langle 13\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 13\right\vert -\left\vert 14\right\rangle
\left\langle 14\right\vert \right)  ,\left(  \left\vert 14\right\rangle
\left\langle 14\right\vert -\left\vert 23\right\rangle \left\langle
23\right\vert \right)  ,\left(  \left\vert 23\right\rangle \left\langle
23\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert \right)
\right. \\
\left.  ,\left(  \left\vert 24\right\rangle \left\langle 24\right\vert
-\left\vert 34\right\rangle \left\langle 34\right\vert \right)  ,\left(
\mathbf{5}\right)  \right\}
\end{gather}


\item
\begin{align}
\ker\left\{  L_{2}^{0}\right\}  _{1d}=\operatorname*{linspan}  &  \left\{
\left\vert 12\right\rangle \left\langle 13\right\vert ,\left\vert
12\right\rangle \left\langle 14\right\vert ,\left\vert 12\right\rangle
\left\langle 23\right\vert ,\left\vert 12\right\rangle \left\langle
24\right\vert ,\left\vert 13\right\rangle \left\langle 12\right\vert
,\left\vert 13\right\rangle \left\langle 14\right\vert ,\left\vert
13\right\rangle \left\langle 23\right\vert ,\left\vert 13\right\rangle
\left\langle 34\right\vert ,\right. \\
&  \left\vert 14\right\rangle \left\langle 12\right\vert ,\left\vert
14\right\rangle \left\langle 13\right\vert ,\left\vert 14\right\rangle
\left\langle 24\right\vert ,\left\vert 14\right\rangle \left\langle
34\right\vert ,\left\vert 23\right\rangle \left\langle 12\right\vert
,\left\vert 23\right\rangle \left\langle 13\right\vert ,\left\vert
23\right\rangle \left\langle 24\right\vert ,\left\vert 23\right\rangle
\left\langle 34\right\vert ,\\
&  \left.  \left\vert 24\right\rangle \left\langle 12\right\vert ,\left\vert
24\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 23\right\vert ,\left\vert 24\right\rangle \left\langle
34\right\vert ,\left\vert 34\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 14\right\vert ,\left\vert
34\right\rangle \left\langle 23\right\vert ,\left\vert 34\right\rangle
\left\langle 24\right\vert ,\left(  \mathbf{24}\right)  \right\}
\end{align}


\item
\begin{equation}
\ker\left\{  L_{2}^{0}\right\}  _{2d}=\operatorname*{linspan}\left\{
\left\vert 12\right\rangle \left\langle 34\right\vert ,\left\vert
13\right\rangle \left\langle 24\right\vert ,\left\vert 14\right\rangle
\left\langle 23\right\vert ,\left\vert 23\right\rangle \left\langle
14\right\vert ,\left\vert 24\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 12\right\vert ,\left(  \mathbf{6}%
\right)  \right\}
\end{equation}


\item
\begin{align}
\ker\left\{  L_{2}^{1}\right\}  _{0d}  &  =\ker\left\{  L_{2}^{1}\right\}
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0d}%
=\operatorname*{linspan}\left\{  \left(  \left\vert 12\right\rangle
\left\langle 12\right\vert -\left\vert 13\right\rangle \left\langle
13\right\vert -\left\vert 24\right\rangle \left\langle 24\right\vert
+\left\vert 34\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
&  \left.  \left(  \left\vert 13\right\rangle \left\langle 13\right\vert
-\left\vert 14\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 23\right\vert +\left\vert 24\right\rangle
\left\langle 24\right\vert ,\left(  \mathbf{2}\right)  \right)  \right\}
\end{align}


\item
\begin{gather}
\ker\left\{  L_{2}^{1}\right\}  _{1d}=\ker\left\{  L_{2}^{1}\right\}
\cap\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{1d}%
=\,\operatorname*{linspan}\left\{  \left(  \left\vert 13\right\rangle
\left\langle 23\right\vert -\left\vert 14\right\rangle \left\langle
24\right\vert \right)  ,\left(  \left\vert 12\right\rangle \left\langle
23\right\vert +\left\vert 14\right\rangle \left\langle 34\right\vert \right)
,\left(  \left\vert 12\right\rangle \left\langle 24\right\vert -\left\vert
13\right\rangle \left\langle 34\right\vert \right)  ,\right. \\
\left(  \left\vert 12\right\rangle \left\langle 13\right\vert -\left\vert
24\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert +\left\vert 23\right\rangle
\left\langle 34\right\vert \right)  ,\left(  \left\vert 13\right\rangle
\left\langle 14\right\vert -\left\vert 23\right\rangle \left\langle
24\right\vert \right)  ,\\
\left(  \left\vert 13\right\rangle \left\langle 23\right\vert +\left\vert
14\right\rangle \left\langle 24\right\vert \right)  ,\left(  \left\vert
12\right\rangle \left\langle 23\right\vert -\left\vert 14\right\rangle
\left\langle 34\right\vert \right)  ,\left(  \left\vert 12\right\rangle
\left\langle 24\right\vert +\left\vert 13\right\rangle \left\langle
34\right\vert \right)  ,\\
\left.  \left(  \left\vert 12\right\rangle \left\langle 13\right\vert
+\left\vert 24\right\rangle \left\langle 34\right\vert \right)  ,\left(
\left\vert 13\right\rangle \left\langle 14\right\vert -\left\vert
23\right\rangle \left\langle 34\right\vert \right)  ,\left(  \left\vert
13\right\rangle \left\langle 14\right\vert +\left\vert 23\right\rangle
\left\langle 24\right\vert \right)  ,\left(  \mathbf{12}\right)  \right\}
\end{gather}


\item
\begin{equation}
\ker\left\{  L_{2}^{1}\right\}  _{2d}=\ker\left\{  L_{2}^{0}\right\}  _{2d}%
\end{equation}
hence
\begin{equation}
\ker\left\{  L_{2}^{1}\right\}  _{2d}=\operatorname*{linspan}\left\{
\left\vert 12\right\rangle \left\langle 34\right\vert ,\left\vert
13\right\rangle \left\langle 24\right\vert ,\left\vert 14\right\rangle
\left\langle 23\right\vert ,\left\vert 23\right\rangle \left\langle
14\right\vert ,\left\vert 24\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 12\right\vert ,\left(  \mathbf{6}%
\right)  \right\}
\end{equation}
giving%
\begin{equation}
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  \right\}  =11+24=35.
\end{equation}

\end{enumerate}

\item One has the isomorphism
\begin{equation}
\ker\left\{  L_{1}^{0}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  _{\left(  0\right)  -\left(  1\right)  }\cong\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0\right)  -\left(  1\right)  },
\end{equation}
where%
\begin{align}
\ker\left\{  L_{1}^{0}\right\}   &  =\left\{  \left.  X\in\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  \right\vert \operatorname{Tr}\left\{
X\right\}  =0\right\} \\
&  =\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left\vert 1\right\rangle \left\langle 2\right\vert ,\left\vert 1\right\rangle
\left\langle 3\right\vert ,\left\vert 1\right\rangle \left\langle 4\right\vert
,\left\vert 2\right\rangle \left\langle 3\right\vert ,\left\vert
2\right\rangle \left\langle 4\right\vert ,\left\vert 3\right\rangle
\left\langle 4\right\vert ,\left\vert 2\right\rangle \left\langle 1\right\vert
,\left\vert 3\right\rangle \left\langle 1\right\vert ,\left\vert
4\right\rangle \left\langle 1\right\vert ,\left\vert 3\right\rangle
\left\langle 2\right\vert ,\left\vert 4\right\rangle \left\langle 2\right\vert
,\left\vert 4\right\rangle \left\langle 3\right\vert ,\\
\left\vert 1\right\rangle \left\langle 1\right\vert -\left\vert 2\right\rangle
\left\langle 2\right\vert ,\left\vert 2\right\rangle \left\langle 2\right\vert
-\left\vert 3\right\rangle \left\langle 3\right\vert ,\left\vert
3\right\rangle \left\langle 3\right\vert -\left\vert 4\right\rangle
\left\langle 4\right\vert ,\left(  \mathbf{15}\right)
\end{array}
\right\}  ,
\end{align}
giving%
\begin{equation}
\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  \right\}  =15.
\end{equation}

\end{enumerate}
\end{example}

\begin{remark}
This shows that
\begin{align}
\ker\left\{  L_{2}^{0}\right\}  \ominus\ker\left\{  L_{2}^{1}\right\}   &
\cong\ker\left\{  L_{1}^{0}\right\} \\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  \right\}  -\dim\left\{
\ker\left\{  L_{2}^{1}\right\}  \right\}   &  =\dim\left\{  \ker\left\{
L_{1}^{0}\right\}  \right\}  \equiv35-20=15.
\end{align}

\end{remark}

\begin{lemma}%
\begin{gather}
\left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}
=\left\{  g_{1},\cdots,g_{n}\right\} \\
\Downarrow\\
\sum\limits_{\substack{1\leq l_{1}<\cdots<l_{n}\leq r}}\left\langle \left.
\varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\vert \left(  \left\vert
\varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{g_{1}%
}\cdots\varphi_{g_{n}}\right\vert -\left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n-1}}\varphi_{g_{n+1}}\right\rangle \left\langle \varphi_{g_{1}%
}\cdots\varphi_{g_{n-1}}\varphi_{g_{n+1}}\right\vert \right)  \varphi_{l_{1}%
}\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0\\
1\leq g_{1}<\cdots<g_{n}\leq r,1\leq h_{1}<\cdots<h_{n}\leq r,0\leq p\leq
n,0\leq n\leq r\\
\text{i.e. }\left(  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\vert
-\left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}\varphi_{g_{n+1}%
}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}%
\varphi_{g_{n+1}}\right\vert \right)  \in\ker\left\{  L_{n}^{0}\right\}  .
\end{gather}

\end{lemma}

\begin{proof}
$r=4,n=2,\,\dim\left\{  \mathcal{H}^{2}\right\}  =\binom{4}{2}=6,\,\dim
\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}  =36,\,p=0$%
\begin{gather}
\sum\limits_{\substack{1\leq l_{1}<l_{2}\leq4}}\left\langle \left.
\varphi_{l_{1}}\varphi_{l_{2}}\right\vert \left(  \left\vert \varphi_{g_{1}%
}\varphi_{g_{2}}\right\rangle \left\langle \varphi_{g_{1}}\varphi_{g_{2}%
}\right\vert -\left\vert \varphi_{g_{1}}\varphi_{g_{2}+1}\right\rangle
\left\langle \varphi_{g_{1}}\varphi_{g_{2}+1}\right\vert \right)
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0\\
1\leq g_{1}<g_{2}\leq4\\
\text{i.e. }\left(  \left\vert \varphi_{g_{1}}\varphi_{g_{2}}\right\rangle
\left\langle \varphi_{g_{1}}\varphi_{g_{2}}\right\vert -\left\vert
\varphi_{g_{1}}\varphi_{g_{2}+1}\right\rangle \left\langle \varphi_{g_{1}%
}\varphi_{g_{2}+1}\right\vert \right)  \in\ker\left\{  L_{2}^{0}\right\}  .
\end{gather}
$\lceil$%
\begin{equation}
\left(  g_{1}g_{2}\right)  -\left(  g_{1}g_{2}+1\right)  =\left(  12\right)
-\left(  13\right)  ;\left(  13\right)  -\left(  14\right)  ;\left(
14\right)  -\left(  23\right)  ;\left(  23\right)  -\left(  24\right)
;\left(  24\right)  -\left(  34\right)
\end{equation}
$\rfloor$
\end{proof}

\begin{lemma}%
\begin{gather}
\left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}
=\left\{  i_{1},\cdots,i_{n-\left(  p+1\right)  }\right\} \\
\Downarrow\\
\operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n-\left(  p+1\right)  }}\varphi_{g_{n-p}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n-\left(
p+1\right)  }}\varphi_{h_{n-p}}\cdots\varphi_{h_{n}}\right\vert \right\}
_{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}=0\\
1\leq g_{1}<\cdots<g_{n}\leq r,1\leq h_{1}<\cdots<h_{n}\leq r,0\leq p\leq
n,0\leq n\leq r,\\
\text{i.e. }\left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n-\left(  p+1\right)
}}\varphi_{g_{n-p}}\cdots\varphi_{g_{n}}\right\rangle \left\langle
\varphi_{g_{1}}\cdots\varphi_{g_{n-\left(  p+1\right)  }}\varphi_{h_{n-p}%
}\cdots\varphi_{h_{n}}\right\vert \in\ker\left\{  L_{n}^{p}\right\}  ,
\end{gather}
where the sequence $\left\{  i_{1},\cdots,i_{n-\left(  p+1\right)  }\right\}
$ \emph{is unordered.}

\begin{proof}
$r=4,n=2,\dim\left\{  \mathcal{H}^{2}\right\}  =\binom{4}{2}=6,\dim\left\{
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}  =36,p=1.$%
\begin{gather}
\left\{  g_{1},g_{2}\right\}  \cap\left\{  h_{1},h_{2}\right\}  =\left\{
i_{1},\cdots,i_{2-\left(  1+1\right)  }\right\}  =\left\{  i_{0}\right\}
=\phi\left.  \Rightarrow\right.  \sum\limits_{\substack{1\leq l_{2}\leq
4}}\left\langle \left.  \varphi_{k_{1}}\varphi_{l_{2}}\right\vert \left\vert
\varphi_{g_{1}}\varphi_{g_{2}}\right\rangle \left\langle \varphi_{h_{1}%
}\varphi_{h_{2}}\right\vert \varphi_{j_{1}}\varphi_{l_{2}}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}=0\\
1\leq g_{1}\neq h_{1}<g_{2}\neq h_{2}\leq4\\
\text{i.e. }\left\vert \varphi_{g_{1}}\varphi_{g_{2}}\right\rangle
\left\langle \varphi_{h_{1}}\varphi_{h_{2}}\right\vert \in\ker\left\{
L_{2}^{1}\right\}  .
\end{gather}
Let $p=n-1$ then%
\begin{align}
&  \left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots
,h_{n}\right\}  =\left\{  i_{1},\cdots,i_{n-\left(  p+1\right)  }\right\}
=\phi\\
&  \left.  \Rightarrow\right.  \sum\limits_{\substack{1\leq l_{n}\leq
r}}\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n-1}}\varphi_{l_{n}%
}\right\vert \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle
\left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{n-1}}\varphi_{l_{n}}\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}=0.
\end{align}
Let $p=n-2$ then%
\begin{gather}
\left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}
=\left\{  i_{1},\cdots,i_{n-\left(  n-2+1\right)  }\right\}  =\left\{
i_{1}\right\} \\
\left.  \Rightarrow\right.  \sum\limits_{\substack{1\leq l_{2-1}<l_{2}\leq
r}}\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n-2}}\varphi
_{l_{n-1}}\varphi_{l_{n}}\right\vert \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \varphi_{j_{1}}\cdots\varphi_{j_{n-2}}\varphi_{l_{n-1}}%
\varphi_{l_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0
\end{gather}%
\begin{equation}
\vdots
\end{equation}
Let $p=1$ then%
\begin{align}
&  \left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots
,h_{n}\right\}  =\left\{  i_{1},\cdots,i_{n-\left(  1+1\right)  }\right\}
=\left\{  i_{1},\cdots,i_{n-2}\right\} \\
&  \left.  \Rightarrow\right.  \sum\limits_{\substack{1\leq l_{2}<\cdots
<l_{n}\leq r}}\left\langle \left.  \varphi_{k_{1}}\varphi_{l_{2}}\cdots
\varphi_{l_{n}}\right\vert \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert
\varphi_{j_{1}}\varphi_{l_{2}}\cdots\varphi_{l_{n}}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}=0
\end{align}
Let $p=0$ then%
\begin{align}
&  \left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots
,h_{n}\right\}  =\left\{  i_{1},\cdots,i_{n-1}\right\} \\
&  \left.  \Rightarrow\right.  \sum\limits_{\substack{1\leq l_{2}<\cdots
<l_{n}\leq r}}\left\langle \left.  \varphi_{l_{1}}\cdots\varphi_{l_{n}%
}\right\vert \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}%
\varphi_{h_{n}}\right\vert \varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}=0,
\end{align}
i.e.%
\begin{align}
&  \operatorname{Tr}\left\{  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert
\right\}  =\operatorname{Tr}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n-1}}\varphi_{g_{n}}\right\rangle \left\langle \varphi_{g_{1}%
}\cdots\varphi_{g_{n-1}}\varphi_{h_{n}}\right\vert \right\} \\
&  =\sum\limits_{\substack{1\leq l_{1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\vert \left\vert
\varphi_{g_{1}}\cdots\varphi_{g_{n-1}}\varphi_{g_{n}}\right\rangle
\left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}\varphi_{h_{n}}\right\vert
\varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}%
}=0.
\end{align}
Also if all subscripts are equal
\begin{align}
&  \left\{  g_{1},\cdots,g_{n}\right\}  \cap\left\{  h_{1},\cdots
,h_{n}\right\}  =\left\{  g_{1},\cdots,g_{n}\right\} \\
&  \left.  \Rightarrow\right.  \sum\limits_{\substack{1\leq l_{1}<\cdots
<l_{n}\leq r}}\left\langle \left.  \varphi_{l_{1}}\cdots\varphi_{l_{n}%
}\right\vert \left(  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\vert
-\left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}\varphi_{g_{n+1}%
}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}%
\varphi_{g_{n+1}}\right\vert \right)  \varphi_{l_{1}}\cdots\varphi_{l_{n}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0,
\end{align}
i.e.%
\begin{equation}
\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\vert -\left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n-1}}\varphi
_{g_{n}+1}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n-1}%
}\varphi_{g_{n}+1}\right\vert \right)  \right\}  =0.
\end{equation}

\end{proof}
\end{lemma}

\begin{corollary}
For $p\neq0$%
\begin{gather}
\ker\left\{  L_{n}^{p}\right\}  \equiv\ker\left\{  \operatorname{Tr}%
_{n-p}\right\} \\%
%TCIMACRO{\tbigcup }%
%BeginExpansion
{\textstyle\bigcup}
%EndExpansion
\\%
%TCIMACRO{\tbigoplus \limits_{n-p+1\leq q\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{n-p+1\leq q\leq n}}
%EndExpansion
\operatorname*{linspan}\left\{  \left\{  \left.  \left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert \right\vert \right.  \left\{  g_{1},\cdots
,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}  =\left\{
i_{1},\cdots,i_{q}\right\}  \right\}  .
\end{gather}

\end{corollary}

\begin{corollary}%
\begin{gather}
\ker\left\{  L_{n}^{p-1}\right\}  \supset%
%TCIMACRO{\tbigcup \limits_{0\leq q\leq n-p}}%
%BeginExpansion
{\textstyle\bigcup\limits_{0\leq q\leq n-p}}
%EndExpansion
\operatorname*{linspan}\left\{  \left\{  \left.  \left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert \right\vert \right.  \left\{  g_{1},\cdots
,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}  =\left\{
i_{1},\cdots,i_{q}\right\}  \right\} \\%
%TCIMACRO{\tbigcup }%
%BeginExpansion
{\textstyle\bigcup}
%EndExpansion
\\
\ker\left\{  L_{n}^{p}\right\}  \supset%
%TCIMACRO{\tbigcup \limits_{0\leq q\leq n-\left(  p+1\right)  }}%
%BeginExpansion
{\textstyle\bigcup\limits_{0\leq q\leq n-\left(  p+1\right)  }}
%EndExpansion
\operatorname*{linspan}\left\{  \left\{  \left.  \left\vert \varphi_{g_{1}%
}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert \right\vert \right.  \left\{  g_{1},\cdots
,g_{n}\right\}  \cap\left\{  h_{1},\cdots,h_{n}\right\}  =\left\{
i_{1},\cdots,i_{q}\right\}  \right\} \\
1\leq g_{1}<\cdots<g_{n}\leq r,1\leq h_{1}<\cdots<h_{n}\leq r,0\leq p\leq
n,0\leq n\leq r.
\end{gather}

\end{corollary}

\begin{remark}
One has the nested sequence of contraction map kernal subspaces
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \supseteq\ker\left\{  L_{n}%
^{0}\right\}  \supseteq\cdots\supseteq\ker\left\{  L_{n}^{p}\right\}
\supseteq\ker\left\{  L_{n}^{p+1}\right\}  \supseteq\cdots\supseteq
\ker\left\{  L_{n}^{n-1}\right\}  \supseteq\ker\left\{  L_{n}^{n}\right\}
;0\leq p\leq n.
\end{equation}

\end{remark}

\begin{lemma}
The contraction map $L_{n}^{p}$ can be iterated as
\begin{align}
L_{n}^{p}  &  =L_{p+1}^{p}\circ L_{n}^{p+1}\\
\text{e.g. }L_{4}^{2}  &  =L_{3}^{2}\circ L_{4}^{3},
\end{align}

\end{lemma}

\begin{remark}
This gives
\end{remark}

\begin{enumerate}
\item
\begin{gather}
L_{n}^{p}\left(  X\right)  =L_{p+1}^{p}\circ L_{n}^{p+1}\left(  X\right)
=\left(  L_{p+1}^{p}\circ L_{n}^{p+1}\right)  \left(  X_{n}\right)
=L_{p+1}^{p}\left(  L_{n}^{p+1}\left(  X_{n}\right)  \right) \\
\text{e.g. }L_{4}^{2}\left(  X\right)  =L_{3}^{2}\circ L_{4}^{3}\left(
X\right)  =\left(  L_{3}^{2}\circ L_{4}^{3}\right)  \left(  X_{4}\right)
=L_{3}^{2}\left(  L_{4}^{3}\left(  X_{4}\right)  \right)
\end{gather}
and

\item
\begin{align}
&  \ker\left\{  L_{n}^{p}\right\}  =\ker\left\{  L_{p+1}^{p}\circ L_{n}%
^{p+1}\right\} \\
&  \text{e.g. }\ker\left\{  L_{4}^{2}\right\}  =\ker\left\{  L_{3}^{2}\circ
L_{4}^{3}\right\}  ,
\end{align}
which shows that

\item
\begin{gather}
\ker\left\{  L_{n}^{p}\right\}  =\ker\left\{  L_{p+1}^{p}\circ L_{n}%
^{p+1}\right\}  \supseteq\ker\left\{  L_{n}^{p+1}\right\} \\
\text{e.g. }\ker\left\{  L_{4}^{2}\right\}  =\ker\left\{  L_{3}^{2}\circ
L_{4}^{3}\right\}  \supseteq\ker\left\{  L_{4}^{3}\right\}  ,
\end{gather}


\item
\begin{gather}
L_{p+1}^{p}\left(  X_{p+1}\right)  =L_{p+1}^{p}\left(  L_{n}^{p+1}\left(
X_{n}\right)  \right)  =L_{n}^{p}\left(  X_{n}\right) \\
\text{e.g. }L_{3}^{2}\left(  X_{3}\right)  =L_{3}^{2}\left(  L_{4}^{3}\left(
X_{4}\right)  \right)  =L_{4}^{2}\left(  X_{4}\right)
\end{gather}
and

\item
\begin{gather}
\ker\left\{  L_{p+1}^{p}\right\}  =\left\{  \left.  X_{p+1}\right\vert
L_{p+1}^{p}\left(  X_{p+1}\right)  =0\right\}  =\left\{  \left.
X_{p+1}\right\vert L_{p+1}^{p}\left(  L_{n}^{p+1}\left(  X_{n}\right)
\right)  =0\right\} \\
\text{e.g. }\ker\left\{  L_{3}^{2}\right\}  =\left\{  \left.  X_{3}\right\vert
L_{3}^{2}\left(  X_{3}\right)  =0\right\}  =\left\{  \left.  X_{3}\right\vert
L_{3}^{2}\left(  L_{4}^{3}\left(  X_{4}\right)  \right)  =0\right\}  .
\end{gather}
The trace class spaces can be decomposed as

\item
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\ker\left\{  L_{n}%
^{p+1}\right\}  ^{c}\oplus\ker\left\{  L_{n}^{p+1}\right\}  =\ker\left\{
L_{n}^{p}\right\}  ^{c}\oplus\ker\left\{  L_{n}^{p}\right\} \\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  =\ker\left\{
L_{4}^{3}\right\}  ^{c}\oplus\ker\left\{  L_{4}^{3}\right\}  =\ker\left\{
L_{4}^{2}\right\}  ^{c}\oplus\ker\left\{  L_{4}^{2}\right\}
\end{gather}


\item
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  =\operatorname{Ran}\left\{
L_{n}^{p}\right\}  ^{c}\oplus\operatorname{Ran}\left\{  L_{n}^{p}\right\}
=\operatorname{Ran}\left\{  L_{p+1}^{p}\right\}  ^{c}\oplus\operatorname{Ran}%
\left\{  L_{p+1}^{p}\right\} \\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\operatorname{Ran}%
\left\{  L_{4}^{2}\right\}  ^{c}\oplus\operatorname{Ran}\left\{  L_{4}%
^{2}\right\}  =\operatorname{Ran}\left\{  L_{3}^{2}\right\}  ^{c}%
\oplus\operatorname{Ran}\left\{  L_{3}^{2}\right\}
\end{gather}


\item
\begin{gather}
\operatorname{Ran}\left\{  L_{n}^{p}\right\}  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  =\ker\left\{  L_{p}^{0}\right\}  ^{c}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  0\right)  -\left(
1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(
1\right)  -\left(  2\right)  }\oplus\cdots\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  _{\left(  p-1\right)  -p}\\
\text{e.g. }\operatorname{Ran}\left\{  L_{4}^{2}\right\}  \cong\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  =\ker\left\{  L_{2}^{0}\right\}
^{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  0\right)
-\left(  1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{\left(  1\right)  -\left(  2\right)  }.
\end{gather}

\end{enumerate}

Isomorphisms between \emph{subspaces }of trace class spaces are given by

\begin{enumerate}
\item
\begin{align}
L_{n}^{p}  &  :\ker\left\{  L_{n}^{p}\right\}  ^{c}\overset{1-1}{\rightarrow
}\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right) \\
\text{e.g. }L_{4}^{2}  &  :\ker\left\{  L_{4}^{2}\right\}  ^{c}%
\overset{1-1}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\end{align}


\item
\begin{align}
\left(  L_{n}^{p}\right)  ^{-1}  &  :\mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  \hookrightarrow\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right) \\
\text{e.g. }\left(  L_{4}^{2}\right)  ^{-1}  &  :\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \hookrightarrow\mathcal{B}_{1}\left(  \mathcal{H}%
^{4}\right)
\end{align}


\item
\begin{align}
\left(  L_{n}^{p}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  \right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq q<p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q<p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q\right)  -\left(
q+1\right)  }=\ker\left\{  L_{n}^{p}\right\}  ^{c}\\
\text{e.g. }\left(  L_{4}^{2}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq q<2}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q<2}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  q\right)  -\left(
q+1\right)  }=\ker\left\{  L_{4}^{2}\right\}  ^{c}%
\end{align}


\item
\begin{align}
L_{n}^{p+1}  &  :\ker\left\{  L_{n}^{p+1}\right\}  ^{c}%
\overset{1-1}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right) \\
\text{e.g. }L_{4}^{3}  &  :\ker\left\{  L_{4}^{3}\right\}  ^{c}%
\overset{1-1}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)
\end{align}


\item
\begin{align}
\left(  L_{n}^{p+1}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  \right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq q<p+1}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q<p+1}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q\right)  -\left(
q+1\right)  }=\ker\left\{  L_{n}^{p+1}\right\}  ^{c}\\
\text{e.g. }\left(  L_{4}^{3}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{3}\right)  \right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq q<3}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq q<3}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  q\right)  -\left(
q+1\right)  }=\ker\left\{  L_{4}^{3}\right\}  ^{c}%
\end{align}


\item
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  }  &
=\left(  L_{n}^{p-1}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{p-1}\right)  \right)  \ominus\left(  L_{n}^{p}\right)
^{-1}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  \right) \\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  2\right)
}  &  =\left(  L_{4}^{1}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right)  \ominus\left(  L_{4}^{2}\right)  ^{-1}\left(
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right)
\end{align}


\item
\begin{align}
L_{p+1}^{p}  &  :\ker\left\{  L_{p+1}^{p}\right\}  ^{c}%
\overset{1-1}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
\cong\operatorname{Ran}\left\{  L_{p+1}^{p}\right\} \\
\text{e.g. }L_{3}^{2}  &  :\ker\left\{  L_{3}^{2}\right\}  ^{c}%
\overset{1-1}{\rightarrow}\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\cong\operatorname{Ran}\left\{  L_{3}^{2}\right\}  .
\end{align}
In general Trace Class spaces can be decomposed as
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(
p-1\right)  -p}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(
p\right)  -\left(  p+1\right)  }\oplus\cdots\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{\left(  n-1\right)  -n}\\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  =\mathcal{B}%
_{1}\left(  \mathcal{H}^{4}\right)  _{c}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{\left(  0\right)  -\left(  1\right)  }%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  1\right)
-\left(  2\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
_{\left(  2\right)  -\left(  3\right)  }\oplus_{1}\left(  \mathcal{H}%
^{4}\right)  _{\left(  3\right)  -\left(  4\right)  }%
\end{gather}
The traceless subspaces \emph{are defined as}
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p-1\right)  -\left(
p\right)  }  &  =\ker\left\{  L_{n}^{p-1}\right\}  \ominus\ker\left\{
L_{n}^{p}\right\} \\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  1\right)
-\left(  2\right)  }  &  =\ker\left\{  L_{4}^{1}\right\}  \ominus\ker\left\{
L_{4}^{2}\right\}  .
\end{align}
The complements of traceless subspaces are given by
\begin{align}
\ker\left\{  L_{n}^{p}\right\}  ^{c}  &  =\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)  }%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p+1\right)
-\left(  p+2\right)  }\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  _{\left(  n-1\right)  -n}\\
\text{e.g. }\ker\left\{  L_{4}^{2}\right\}  ^{c}  &  =\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{\left(  2\right)  -\left(  3\right)  }%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  3\right)
-\left(  4\right)  }%
\end{align}
which gives the interesting lemma
\end{enumerate}

\begin{lemma}%
\begin{align}
\ker\left\{  L_{n}^{p-1}\right\}  ^{c}\ominus\ker\left\{  L_{n}^{p}\right\}
^{c}  &  =\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p-1\right)
-\left(  p\right)  }\\
\text{e.g. }\ker\left\{  L_{4}^{1}\right\}  ^{c}\ominus\ker\left\{  L_{4}%
^{2}\right\}  ^{c}  &  =\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
_{\left(  1\right)  -\left(  2\right)  }.
\end{align}

\end{lemma}

\begin{remark}
The space of Trace Class operators for $p$ and $p+1$ can be decomposed as
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)   &  =\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(
p-1\right)  -p}\\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)   &  =\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{c}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0-1}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1-2}%
\end{align}
and%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)   &  =\mathcal{B}_{1}\left(
\mathcal{H}^{p+1}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(
p\right)  -\left(  p+1\right)  }\\
\text{e.g. }\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)   &  =\mathcal{B}%
_{1}\left(  \mathcal{H}^{3}\right)  _{c}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{3}\right)  _{\left(  0\right)  -\left(  1\right)  }%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{\left(  1\right)
-\left(  2\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)
_{\left(  2\right)  -\left(  3\right)  }.
\end{align}
The map $L_{p+1}^{p}$ has the properties
\end{remark}

\begin{enumerate}
\item
\begin{align}
&  L_{p+1}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right) \\
\text{e.g. }  &  L_{3}^{2}:\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)
\rightarrow\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\end{align}


\item
\begin{align}
&  \ker\left\{  L_{P+1}^{p-1}\right\}  \ominus\ker\left\{  L_{P+1}%
^{p}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(
p\right)  -\left(  p+1\right)  }\\
\text{e.g. }  &  \ker\left\{  L_{3}^{1}\right\}  \ominus\ker\left\{  L_{3}%
^{2}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{\left(
2\right)  -\left(  3\right)  }%
\end{align}


\item
\begin{align}
&  \ker\left\{  L_{p+1}^{p}\right\}  ^{c}\cong\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  \subset\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  =\ker\left\{  L_{p+1}^{p}\right\}  ^{c}\oplus\ker\left\{
L_{p+1}^{p}\right\} \\
\text{e.g. }  &  \ker\left\{  L_{3}^{2}\right\}  ^{c}\cong\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  \hookrightarrow\mathcal{B}_{1}\left(
\mathcal{H}^{3}\right)  =\ker\left\{  L_{3}^{2}\right\}  ^{c}\oplus
\ker\left\{  L_{3}^{2}\right\}  .
\end{align}

\end{enumerate}

Trace class operators can be decomposed as
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)   &  =\ker\left\{  L_{n}%
^{p}\right\}  ^{c}\oplus\ker\left\{  L_{n}^{p+1}\right\}  \oplus\left(
\ker\left\{  L_{n}^{p}\right\}  \ominus\ker\left\{  L_{n}^{p+1}\right\}
\right) \\
&  =\ker\left\{  L_{n}^{p+1}\right\}  ^{c}\oplus\ker\left\{  L_{n}%
^{p+1}\right\} \\
&  \Rightarrow\ker\left\{  L_{n}^{p}\right\}  ^{c}\oplus\ker\left\{
L_{n}^{p+1}\right\}  \oplus\left(  \ker\left\{  L_{n}^{p}\right\}  \ominus
\ker\left\{  L_{n}^{p+1}\right\}  \right)  =\ker\left\{  L_{n}^{p+1}\right\}
^{c}\oplus\ker\left\{  L_{n}^{p+1}\right\}
\end{align}


\begin{example}%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)   &  =\ker\left\{  L_{4}%
^{2}\right\}  ^{c}\oplus\ker\left\{  L_{4}^{3}\right\}  \oplus\left(
\ker\left\{  L_{4}^{2}\right\}  \ominus\ker\left\{  L_{4}^{3}\right\}  \right)
\\
&  =\ker\left\{  L_{4}^{3}\right\}  ^{c}\oplus\ker\left\{  L_{4}^{3}\right\}
\\
&  \Rightarrow\ker\left\{  L_{4}^{2}\right\}  ^{c}\oplus\ker\left\{  L_{4}%
^{3}\right\}  \oplus\left(  \ker\left\{  L_{4}^{2}\right\}  \ominus
\ker\left\{  L_{4}^{3}\right\}  \right)  =\ker\left\{  L_{4}^{3}\right\}
^{c}\oplus\ker\left\{  L_{4}^{3}\right\}  .
\end{align}

\end{example}

\begin{lemma}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{c}\cong\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  _{c}.
\end{equation}

\end{lemma}

\begin{theorem}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)  -\left(
q\right)  }=\left(  L_{n}^{p}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  \right)  =\ker\left\{  L_{n}^{p}\right\}  ^{c}%
;\quad1\leq p\leq n.
\end{equation}

\end{theorem}

\begin{example}%
\begin{align}
&  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq2}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq2}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  q-1\right)  -\left(
q\right)  }=\left(  L_{4}^{2}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right)  =\ker\left\{  L_{4}^{2}\right\}  ^{c}\quad\\
&  \mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq2}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq2}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  q-1\right)  -\left(
q\right)  }=\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{c}\oplus
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  0\right)  -\left(
1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(
1\right)  -\left(  2\right)  }.
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  =\,\overset{\ker\left\{
L_{n}^{p}\right\}  ^{c}\cong\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
=\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{c}\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  0\right)  -\left(  1\right)
}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  1\right)
-\left(  2\right)  }\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{p}\right)  _{\left(  p-1\right)  -\left(  p\right)  }%
}{\overbrace{\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{c}%
\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  0\right)
-\left(  1\right)  }\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
_{\left(  1\right)  -\left(  2\right)  }\oplus\cdots\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p-1\right)  -\left(  p\right)
}}}\overset{\ker\left\{  L_{n}^{p}\right\}  }{\oplus\overbrace{\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)
}\oplus\cdots\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(
n-1\right)  -\left(  n\right)  }}}%
\end{equation}

\end{remark}

\begin{remark}
In finite dimensions
\begin{equation}
\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}  =\ker\left\{  L_{n}%
^{p}\right\}  ^{\bot}\cong\ker\left\{  L_{n}^{p}\right\}  ^{c}.
\end{equation}

\end{remark}

\begin{corollary}%
\begin{gather}
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p+1}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p+1}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  q-1\right)  -\left(
q\right)  }=\left(  L_{n}^{p+1}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{p+1}\right)  \right)  =\ker\left\{  L_{n}^{p+1}\right\}
^{c};\quad1\leq p\leq n.\\
\text{e.g.\quad}\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  \cong%
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq3}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq3}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  q-1\right)  -\left(
q\right)  }=\left(  L_{4}^{3}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{3}\right)  \right)  =\ker\left\{  L_{4}^{3}\right\}  ^{c}\\
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  \ominus\mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  \cong\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
_{\left(  p\right)  -\left(  p+1\right)  }\equiv\left(  L_{n}^{p+1}\right)
^{-1}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  \right)
\ominus\left(  L_{n}^{p}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  \right)  \equiv\ker\left\{  L_{n}^{p+1}\right\}
^{c}\ominus\ker\left\{  L_{n}^{p}\right\}  ^{c}\\
\text{e.g.\quad}\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  \ominus
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{\left(  2\right)  -\left(  3\right)  }\equiv\left(
L_{4}^{3}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)
\right)  \ominus\left(  L_{4}^{2}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right)  \equiv\ker\left\{  L_{4}^{3}\right\}
^{c}\ominus\ker\left\{  L_{4}^{2}\right\}  ^{c}.
\end{gather}
In finite dimensions
\begin{align}
&  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(
p+1\right)  }=\ker\left\{  L_{n}^{p+1}\right\}  ^{c}\ominus\ker\left\{
L_{n}^{p}\right\}  ^{c}=\ker\left\{  L_{n}^{p+1}\right\}  ^{\bot}\ominus
\ker\left\{  L_{n}^{p}\right\}  ^{\bot}=\operatorname{Ran}\left\{
\Gamma_{p+1}^{n}\right\}  \ominus\operatorname{Ran}\left\{  \Gamma_{p}%
^{n}\right\} \\
&  \text{e.g.\quad}\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(
2\right)  -\left(  3\right)  }=\ker\left\{  L_{4}^{3}\right\}  ^{c}\ominus
\ker\left\{  L_{4}^{2}\right\}  ^{c}=\ker\left\{  L_{4}^{3}\right\}  ^{\bot
}\ominus\ker\left\{  L_{4}^{2}\right\}  ^{\bot}=\operatorname{Ran}\left\{
\Gamma_{3}^{4}\right\}  \ominus\operatorname{Ran}\left\{  \Gamma_{2}%
^{4}\right\}  .
\end{align}

\end{corollary}

\begin{corollary}%
\begin{align}
&  L_{p+1}^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)
_{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p+1}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p+1}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p+1}\right)  _{\left(  q-1\right)
-\left(  q\right)  }\right)  =\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
_{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq p}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\left(  q-1\right)  -\left(
q\right)  }\\
&  \text{e.g.\quad}L_{3}^{2}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
^{3}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq3}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq3}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{\left(  q-1\right)  -\left(
q\right)  }\right)  =\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq2}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq2}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  q-1\right)  -\left(
q\right)  }.
\end{align}

\end{corollary}

\begin{corollary}%
\begin{equation}
\ker\left\{  L_{p+1}^{p}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}%
^{p+1}\right)  _{\left(  p\right)  -\left(  p+1\right)  }\cong\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\left(  p\right)  -\left(  p+1\right)
}.
\end{equation}

\end{corollary}

\begin{example}
\begin{enumerate}
\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  \cong\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  _{c}\oplus\mathcal{B}_{1}\left(  \mathcal{H}%
^{4}\right)  _{\left(  0\right)  -\left(  1\right)  }\oplus\mathcal{B}%
_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  1\right)  -\left(  2\right)
}\oplus\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  2\right)
-\left(  3\right)  }=\left(  L_{4}^{3}\right)  ^{-1}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{3}\right)  \right)  =\ker\left\{  L_{4}^{3}\right\}
^{c}%
\end{equation}


\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  \ominus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \cong\mathcal{B}_{1}\left(  \mathcal{H}^{4}\right)
_{\left(  2\right)  -\left(  3\right)  }\equiv\left(  L_{4}^{3}\right)
^{-1}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  \right)
\ominus\left(  L_{4}^{2}\right)  ^{-1}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right)
\end{equation}


\item
\begin{equation}
L_{3}^{2}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq3}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq3}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{3}\right)  _{\left(  q-1\right)  -\left(
q\right)  }\right)  =\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{c}\oplus%
%TCIMACRO{\tbigoplus \limits_{1\leq q\leq2}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq q\leq2}}
%EndExpansion
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\left(  q-1\right)  -\left(
q\right)  }%
\end{equation}


\item
\begin{equation}
\ker\left\{  L_{3}^{2}\right\}  =\mathcal{B}_{1}\left(  \mathcal{H}%
^{3}\right)  _{\left(  p\right)  -\left(  p+1\right)  }\cong\mathcal{B}%
_{1}\left(  \mathcal{H}^{4}\right)  _{\left(  2\right)  -\left(  3\right)  }%
\end{equation}


\item
\begin{equation}
\ker\left\{  L_{3}^{2}\right\}  =\left\{  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{4}\right)  \left.  \operatorname{Tr}\left\{  a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{j_{3}}^{\dagger}a_{k_{3}}a_{k_{2}}a_{k_{1}}L_{4}%
^{3}\left(  X\right)  \right\}  =0\right\vert 1\leq j_{1}<j_{2}<j_{3}\leq
r,1\leq k_{1}<k_{2}<k_{3}\leq r\right\}  .
\end{equation}

\end{enumerate}
\end{example}

\begin{remark}
In infinite dimensions scalar multiples of the identity \emph{do not belong}
to $\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  $ i.e.
\begin{equation}
zI_{\mathcal{H}^{n}}=zP_{\mathcal{H}^{n}}\notin\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  .
\end{equation}

\end{remark}

The action of the partial traces on ket-bra bases elements is given by
considering the expansion coefficients
\begin{align}
&  \operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right\}  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}\\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\delta_{\left(
k_{1}\cdots k_{p}l_{p+1}\cdots l_{n}\right)  \left(  q_{1}\cdots g_{n}\right)
}\delta_{\left(  j_{1}\cdots j_{p}l_{p+1}\cdots l_{n}\right)  \left(
h_{1}\cdots h_{n}\right)  }.
\end{align}


\begin{example}
$r=4,n=2,p=2$%
\begin{equation}
L_{2}^{2}\left(  \left\vert \varphi_{g_{1}}\varphi_{g_{2}}\right\rangle
\left\langle \varphi_{h_{1}}\varphi_{h_{2}}\right\vert \right)  _{j_{1}%
j_{2}k_{1}k_{2}}=\operatorname{Tr}_{0}\left\{  \left\vert \varphi_{g_{1}%
}\varphi_{g_{2}}\right\rangle \left\langle \varphi_{h_{1}}\varphi_{h_{2}%
}\right\vert \right\}  _{j_{1}j_{2}k_{1}k_{2}}=\left\langle \left.
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \left\vert \varphi_{g_{1}}%
\varphi_{g_{2}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\left\langle
\varphi_{h_{1}}\varphi_{h_{2}}\right\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{example}

\begin{example}
$r=4,n=2,p=1$%
\begin{equation}
L_{2}^{1}\left(  \left\vert \varphi_{g_{1}}\varphi_{g_{2}}\right\rangle
\left\langle \varphi_{h_{1}}\varphi_{h_{2}}\right\vert \right)  _{j_{1}k_{1}%
}=\operatorname{Tr}_{1}\left\{  \left\vert \varphi_{g_{1}}\varphi_{g_{2}%
}\right\rangle \left\langle \varphi_{h_{1}}\varphi_{h_{2}}\right\vert
\right\}  _{j_{1}k_{1}}=\sum\limits_{\substack{1\leq l_{2}\leq4}}\left\langle
\left.  \varphi_{k_{1}}\varphi_{l_{2}}\right\vert \left\vert \varphi_{g_{1}%
}\varphi_{g_{2}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\left\langle
\varphi_{h_{1}}\varphi_{h_{2}}\right\vert \varphi_{j_{1}}\varphi_{l_{2}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{example}

\begin{example}
$r=4,n=2,p=0$%
\begin{equation}
L_{2}^{0}\left(  \left\vert \varphi_{g_{1}}\varphi_{g_{2}}\right\rangle
\left\langle \varphi_{h_{1}}\varphi_{h_{2}}\right\vert \right)
=\operatorname{Tr}_{2}\left\{  \left\vert \varphi_{g_{1}}\varphi_{g_{2}%
}\right\rangle \left\langle \varphi_{h_{1}}\varphi_{h_{2}}\right\vert
\right\}  =\sum\limits_{\substack{1\leq l_{1}<l_{2}\leq4}}\left\langle \left.
\varphi_{l_{1}}\varphi_{l_{2}}\right\vert \left\vert \varphi_{g_{1}}%
\varphi_{g_{2}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\left\langle
\varphi_{h_{1}}\varphi_{h_{2}}\right\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{example}

\begin{example}
of kernals for $r=4,n=1,\dim\left\{  \mathcal{H}^{1}\right\}  =\binom{4}%
{1}=4,\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}
=16$

\begin{enumerate}
