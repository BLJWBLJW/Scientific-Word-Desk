\paragraph{Lie Group Definition}

Action of the Lie algebra of the group $\left\{  \widehat{u}\left(  g\right)
\right\}  $ on $\mathcal{F}$ can be obtained by considering the tangent space
of paths
\begin{align}
\frac{d}{dt}\widehat{u}\left(  gt\right)  \left(  x_{k_{1}}\right)   &
=\frac{d}{dt}\left\{  e^{gt}x_{k_{1}}e^{-gt}\right\}  =\left(  \frac{d}%
{dt}e^{gt}\right)  x_{k_{1}}e^{-gt}+e^{gt}x_{k_{1}}\left(  \frac{d}{dt}%
e^{-gt}\right) \\
&  =ge^{gt}x_{k_{1}}e^{-gt}-e^{gt}x_{k_{1}}e^{-gt}g=\left[  g,x_{k_{1}}\left(
t\right)  \right]
\end{align}
and%
\begin{align}
\frac{d}{dt}\widehat{u}\left(  gt\right)  \left(  x_{k_{1}}x_{k_{2}}\right)
&  =\left(  \frac{d}{dt}\left\{  e^{gt}x_{k_{1}}e^{-gt}\right\}  \right)
e^{gt}x_{k_{2}}e^{-gt}+e^{gt}x_{k_{1}}e^{-gt}\left(  \frac{d}{dt}\left\{
e^{gt}x_{k_{2}}e^{-gt}\right\}  \right) \\
&  =\left[  g,x_{k_{1}}\left(  t\right)  \right]  x_{k_{2}}\left(  t\right)
+x_{k_{1}}\left(  t\right)  \left[  g,x_{k_{2}}\left(  t\right)  \right]
\end{align}
\emph{Note that }in general $\left[  g,x_{k_{2}}\left(  t\right)  \right]
\neq0.$

$\lceil$In the $\mathcal{H}_{\mathcal{F}}-$ $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ context
\begin{equation}
u_{m}\left(  t\right)  \left\vert \varphi_{1}\wedge\cdots\wedge\varphi
_{m}\right\rangle =\left\vert u_{1}\left(  t\right)  \varphi_{1}\wedge
\cdots\wedge u_{1}\left(  t\right)  \varphi_{m}\right\rangle =u_{1}\left(
t\right)  \wedge\cdots\wedge u_{1}\left(  t\right)  \left\vert \varphi
_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle
\end{equation}
gives on
\begin{align}
&  \left.  \frac{d}{dt}u_{m}\left(  t\right)  \right\vert _{t=0}\left\vert
\varphi_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle =\left.  \left\vert
\frac{d}{dt}\left\{  u_{1}\left(  t\right)  \varphi_{1}\wedge\cdots\wedge
u_{1}\left(  t\right)  \right\}  \varphi_{m}\right\rangle \right\vert _{t=0}\\
&  =\left\vert \left(  \left.  \frac{d}{dt}u_{1}\left(  t\right)  \right\vert
_{t=0}\varphi_{1}\right)  \wedge\cdots\wedge u_{1}\left(  t\right)
\varphi_{m}\right\rangle +\cdots+\left\vert \varphi_{1}\wedge\cdots
\wedge\left(  \left.  \frac{d}{dt}u_{1}\left(  t\right)  \right\vert
_{t=0}\varphi_{m}\right)  \right\rangle \\
&  =\left.  \frac{d}{dt}\left\{  u_{1}\left(  t\right)  \wedge\cdots\wedge
u_{1}\left(  t\right)  \right\}  \right\vert _{t=0}\left\vert \varphi
_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle .
\end{align}
Thus
\begin{equation}
A_{m}\left\vert \varphi_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle
=\left\vert \left(  A_{1}\varphi_{1}\right)  \wedge\cdots\wedge u_{1}\left(
t\right)  \varphi_{m}\right\rangle +\cdots+\left\vert \varphi_{1}\wedge
\cdots\wedge\left(  A_{1}\varphi_{m}\right)  \right\rangle ,
\end{equation}
where
\begin{align}
A_{m}  &  =\left.  \frac{d}{dt}u_{m}\left(  t\right)  \right\vert _{t=0}%
;u_{m}\left(  t\right)  =\exp\left\{  A_{m}t\right\} \\
A_{1}  &  =\left.  \frac{d}{dt}u_{1}\left(  t\right)  \right\vert _{t=0}%
;u_{1}\left(  t\right)  =\exp\left\{  A_{1}t\right\}  .
\end{align}
$\rfloor$

The Gauge group
\begin{equation}
u\left(  \theta\right)  =\exp\left\{  iN\theta\right\}  ,
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
\mathcal{N}=\sum_{1\leq j\leq r}n_{j}=\mathcal{N}_{0}+\mathcal{N}_{2}=\frac
{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}x_{j}x_{j+r}.
\end{equation}


\item
\begin{equation}
\left[  \mathcal{N},x_{l}\right]  =i\sum_{1\leq j\leq r}\left[  x_{j}%
x_{j+r},x_{l}\right]  =i\sum_{1\leq j\leq r}\left\{  x_{j}\delta
_{j+rl}-x_{j+r}\delta_{jl}\right\}  =\left\{
\begin{array}
[c]{c}%
ix_{j};r+1\leq l\leq2r\\
-ix_{j};1\leq l\leq r
\end{array}
\right.
\end{equation}


\item
\begin{align}
\left[  \mathcal{N},x_{k_{1}}x_{k_{2}}\right]   &  =i\sum_{1\leq j\leq
r}\left[  x_{j}x_{j+r},x_{k_{1}}x_{k_{2}}\right] \\
&  =i\sum_{1\leq j\leq r}\left\{  \left(  \delta_{jk_{1}}\delta_{j+rk_{2}%
}-\delta_{j+rk_{1}}\delta_{jk_{2}}\right)  I_{\mathcal{F}}+x_{j+r}x_{k_{1}%
}\delta_{jk_{2}}-x_{j}x_{k_{1}}\delta_{j+rk_{2}}-x_{j+r}x_{k_{2}}%
\delta_{jk_{1}}+x_{j}x_{k_{2}}\delta_{j+rk_{1}}\right\} \\
&  =\left\{
\begin{array}
[c]{c}%
ix_{k_{2}+r}x_{k_{1}}-ix_{k_{1}+r}x_{k_{2}}\\
iI_{\mathcal{F}}-ix_{k_{2}-r}x_{k_{1}}-ix_{k_{1}}x_{k_{2}}\\
-iI_{\mathcal{F}}+ix_{k_{2}}x_{k_{1}}+ix_{k_{1}-r}x_{k_{2}}\\
-ix_{k_{2}-r}x_{k_{1}}+ix_{k_{1}-r}x_{k_{2}}%
\end{array}%
\begin{array}
[c]{c}%
1\leq k_{1}<k_{2}\leq r\\
1\leq k_{1}\leq r;r+1\leq k_{2}\leq2r\\
r+1\leq k_{1}\leq2r;1\leq k_{2}\leq r\\
r+1\leq k_{1}<k_{2}\leq2r
\end{array}
\right.  .
\end{align}

\end{enumerate}

\bigskip We are interested in the gauge invariant subspace
\begin{equation}
\left[  \mathcal{N},g\right]  =0,
\end{equation}
which can easily be identified as being generated by
\begin{align}
a_{j}^{\dagger}a_{k}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+s}\right)
\frac{1}{\sqrt{2}}\left(  x_{k}-ix_{k+s}\right)  =\frac{1}{2}\left(
x_{j}x_{k}+ix_{j+s}x_{k}-ix_{j}x_{k+s}+x_{j+s}x_{k+s}\right) \\
&  =\frac{1}{2}\left(  x_{j}x_{k}+x_{j+s}x_{k+s}+i\left(  x_{j+s}x_{k}%
-x_{j}x_{k+s}\right)  \right)  ,
\end{align}
which gives the special cases%
\begin{align}
n_{j}  &  =a_{j}^{\dagger}a_{j}=\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+s}%
\right)  \frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+s}\right)  =\frac{1}{2}\left(
x_{j}^{2}+ix_{j+s}x_{j}-ix_{j}x_{j+s}+x_{j+s}^{2}\right) \\
&  \left.  =\right.  \frac{1}{2}\left(  I_{\mathcal{F}}+2ix_{j+s}x_{j}\right)
=\frac{1}{2}I_{\mathcal{F}}+ix_{j+s}x_{j}\\
h_{j}  &  =a_{j}a_{j}^{\dagger}=\frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+s}%
\right)  \frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+s}\right)  =\frac{1}%
{2}I_{\mathcal{F}}-ix_{j+s}x_{j}.
\end{align}
This gives the CR's%
\begin{align}
\left[  x_{j}x_{k},x_{l}\right]   &  =x_{j}x_{k}x_{l}-x_{l}x_{j}x_{k}%
=x_{j}x_{k}x_{l}-\left(  I\delta_{jl}-x_{j}x_{l}\right)  x_{k}=x_{j}x_{k}%
x_{l}-x_{k}\delta_{jl}+x_{j}x_{l}x_{k}\\
&  =x_{j}x_{k}x_{l}-x_{k}\delta_{jl}+x_{j}\left(  I\delta_{kl}-x_{k}%
x_{l}\right)  =x_{j}x_{k}x_{l}-x_{k}\delta_{jl}+x_{j}\delta_{kl}-x_{j}%
x_{k}x_{l}\nonumber\\
&  =x_{j}\delta_{kl}-x_{k}\delta_{jl}.\nonumber
\end{align}
and
\begin{equation}
\left[  x_{j_{1}}x_{j_{2}},x_{k_{1}}x_{k_{2}}\right]  =\left(  \delta
_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}%
}\right)  I_{\mathcal{F}}+x_{j_{2}}x_{k_{1}}\delta_{j_{1}k_{2}}-x_{j_{1}%
}x_{k_{1}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}%
}x_{k_{2}}\delta_{j_{2}k_{1}}.
\end{equation}


\subsubsection{Para Vectors}

Para vectors are of the form
\begin{equation}
v=\alpha I_{\mathcal{F}}+\sum_{1\leq j\leq2r}\alpha_{j}x_{j}%
\end{equation}
and are mapped into themselves by
\begin{align}
&  \exp\left\{  \mathcal{R}_{x}\left(  g\right)  _{0}I_{\mathcal{F}}%
+\sum_{1\leq j_{1}<j_{2}\leq2r}\mathcal{R}_{x}\left(  g\right)  _{j_{1}%
}x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq2r}\mathcal{R}_{x}\left(  g\right)
_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}\right\}  v\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\times\exp-\left\{
\mathcal{R}_{x}\left(  g\right)  _{0}I_{\mathcal{F}}+\sum_{1\leq j_{1}%
<j_{2}\leq2r}\mathcal{R}_{x}\left(  g\right)  _{j_{1}}x_{j_{1}}+\sum_{1\leq
j_{1}<j_{2}\leq2r}\mathcal{R}_{x}\left(  g\right)  _{j_{1}j_{2}}x_{j_{1}%
}x_{j_{2}}\right\} \\
&  =\exp\left\{  \sum_{1\leq j_{1}<j_{2}\leq2r}\mathcal{R}_{x}\left(
g\right)  _{j_{1}}x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq2r}\mathcal{R}%
_{x}\left(  g\right)  _{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}\right\}  v\exp-\left\{
\sum_{1\leq j_{1}<j_{2}\leq2r}\mathcal{R}_{x}\left(  g\right)  _{j_{1}%
}x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq2r}\mathcal{R}_{x}\left(  g\right)
_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}\right\}  =v^{\prime},
\end{align}
which form an adjoint representation of the group $SO(2r+1,\mathbb{R}).$

\begin{enumerate}
\item $\lceil$For $j\neq k\neq l\neq m$%
\[
\left[  x_{j}x_{k},x_{l}x_{m}\right]  =x_{j}x_{k}x_{l}x_{m}-x_{l}x_{m}%
x_{j}x_{k}=x_{j}x_{k}x_{l}x_{m}-x_{j}x_{k}x_{l}x_{m}=0
\]


\item $j=l;k\neq m$%
\[
\left[  x_{j}x_{k},x_{j}x_{m}\right]  =x_{j}x_{k}x_{j}x_{m}-x_{j}x_{m}%
x_{j}x_{k}=-\frac{1}{2}x_{k}x_{m}+\frac{1}{2}x_{m}x_{k}=x_{m}x_{k}%
\]


\item $j=l;k=m$%
\[
\left[  x_{j}x_{k},x_{j}x_{k}\right]  =x_{j}x_{k}x_{j}x_{k}-x_{j}x_{k}%
x_{j}x_{k}=-\frac{1}{2}x_{k}x_{k}+\frac{1}{2}x_{k}x_{k}=0
\]


\item $j\neq k\neq l$%
\[
\left[  x_{j}x_{k},x_{l}\right]  =x_{j}x_{k}x_{l}-x_{l}x_{j}x_{k}=0
\]


\item $j\neq k=l$%
\[
\left[  x_{j}x_{k},x_{k}\right]  =x_{j}x_{k}x_{k}-x_{k}x_{j}x_{k}=0=\frac
{1}{2}x_{j}+\frac{1}{2}x_{j}=x_{j},
\]%
\[
\left[  x_{j},x_{k}\right]  =x_{j}x_{k}-x_{k}x_{j}=0.
\]
$\rfloor$
\end{enumerate}

The norm of para vectors is given by
\begin{align}
v^{2}  &  =\left(  v_{0}+v_{1}\right)  ^{2}=\left(  v_{0}^{2}+v_{1}%
^{2}\right)  +2v_{0}v_{1}\\
\left\Vert v\right\Vert I_{\mathcal{F}}  &  =\left(  v_{0}^{2}+v_{1}%
^{2}\right)  ^{\frac{1}{2}}I_{\mathcal{F}},
\end{align}
hence for elements
\begin{equation}
\left(  I_{\mathcal{F}}+\tilde{x}_{j}\right)
\end{equation}
one obtains
\begin{equation}
\left(  I_{\mathcal{F}}+\tilde{x}_{j}\right)  ^{2}=\left(  \left(  1+1\right)
I_{\mathcal{F}}+2\tilde{x}_{j}\right)  =2\left(  I_{\mathcal{F}}+\tilde{x}%
_{j}\right)  .
\end{equation}
The product of para vectors is given by
\begin{align}
\left(  I_{\mathcal{F}}+\tilde{x}_{j}\right)  \left(  I_{\mathcal{F}}%
+\tilde{x}_{k}\right)   &  =I_{\mathcal{F}}+\tilde{x}_{j}+\tilde{x}_{k}%
+\tilde{x}_{j}\tilde{x}_{k}\\
\left(  I_{\mathcal{F}}+\tilde{x}_{k}\right)  \left(  I_{\mathcal{F}}%
+\tilde{x}_{j}\right)   &  =I_{\mathcal{F}}+\tilde{x}_{j}+\tilde{x}_{k}%
-\tilde{x}_{j}\tilde{x}_{k}.
\end{align}


\section{General Linear Group $GL\left(  2r,\mathbb{C}\right)  $}

Noting that
\begin{equation}
E_{jk}E_{lm}=E_{jm}\delta_{kl}%
\end{equation}
the commutation relationships
\begin{equation}
\left[  E_{jk},E_{lm}\right]  =E_{jk}E_{lm}-E_{lm}E_{jk}=E_{jm}\delta
_{kl}-E_{lk}\delta_{mj}%
\end{equation}
define the Lie algebra of the general linear group $GL\left(  2r,\mathbb{C}%
\right)  .$

\subsection{Heisenberg Lie Algebra}

The Heisenberg Lie algebra is a subalgebra of $gl\left(  3,\mathbb{C}\right)
$ and is defined by CR's
\begin{align}
a  &  =a_{1}E_{12}+a_{2}E_{13}+a_{3}E_{23}\\
\left[  E_{12},E_{13}\right]   &  =E_{12}E_{13}-E_{13}E_{12}=0\\
\left[  E_{23},E_{13}\right]   &  =-\left(  E_{13}E_{23}-E_{23}E_{13}\right)
=0\\
\left[  E_{12},E_{23}\right]   &  =E_{12}E_{23}-E_{23}E_{12}=E_{13}%
\end{align}
and%
\begin{gather}
\left(  E_{12}+iE_{23}\right)  \left(  E_{12}-iE_{23}\right)  =-iE_{12}%
E_{23}+iE_{23}E_{12}=-iE_{13}\\
\left(  E_{12}-iE_{23}\right)  \left(  E_{12}+iE_{23}\right)  =-iE_{23}%
E_{12}+iE_{12}E_{23}=iE_{13}\\
\left[  \left(  E_{12}-iE_{23}\right)  ,\left(  E_{12}+iE_{23}\right)
\right]  =2iE_{13}.
\end{gather}


\subsubsection{Group Decomposition}%

\begin{equation}
U\left(  3\right)  =\left.  SU\left(  3\right)  \otimes U\left(  1\right)
\right/  \mathbb{Z}_{3}%
\end{equation}
?%
\begin{equation}
U\left(  r\right)  =\left.  SU\left(  r\right)  \otimes U\left(  1\right)
\right/  \mathbb{Z}_{r}.
\end{equation}


\subsubsection{Tensor Algebra of Tensor Algebra}

One can note that the application of the outer $T$ in $T(T(V))$ implicitly
demotes $T(V)$ from an algebra to a vector space. Then one does not have
$T(T(V))\simeq T(V)$ in general \emph{as an algebra} (they are isomorphic as
vector spaces though; for instance if $V$ is finite dimensional, they are both
countably-infinite dimensional vector spaces).

If $V$ is finite dimensional, then the algebra $T(V)$ has the property of
possessing a finite dimensional subspace that generates it as an algebra, viz.
the copy of $V$ inside $T(V)$. However $T(T(V))$ does not have this property,
because the elements of $T(V)$ inside $T(T(V))$ form an infinite dimensional
subspace of irreducible elements (the only decompositions for them involve a
nonzero scalar of the field; this is a consequence of the "demotion" referred
to above).

As a graded algebra this is even more evident: $T(V)$ has finite-dimensional
homogeneous components in every degree, while $T(T(V))$ is
infinite-demensional in any positive degree.

\subsection{Hypercubes}

Let $I_{n}$ be the $n$-dimensional unit cube, which is the product of $n$
copies of the interval $[0,1]$. The boundary $\partial I_{n}$ of $I_{n}$ is
the subspace consisting of points with at least one coordinate equal to $0$ or
$1$. For a space $X$ with basepointx $0\in X$, define $%
%TCIMACRO{\tprod \nolimits_{n}}%
%BeginExpansion
{\textstyle\prod\nolimits_{n}}
%EndExpansion
(X,x_{0})$ to be the set of homotopy classes of maps%
\begin{equation}
f:\left(  I_{n},\partial I_{n}\right)  \rightarrow(X,x_{0}),
\end{equation}
where \emph{homotopies} $f_{t}$ are required to satisfy%
\begin{equation}
f_{t}:\partial I_{n}\rightarrow x_{0}%
\end{equation}
for all $t$. The definition extends to the case $n=0$ by taking $I_{0}$ to be
a point and $\partial I_{0}$ to be empty, so $%
%TCIMACRO{\tprod \nolimits_{n}}%
%BeginExpansion
{\textstyle\prod\nolimits_{n}}
%EndExpansion
(X,x_{0})$ is just the set of path-components of $X.$

\subsection{ Topological group}

Every connected topological group has a unique universal cover as a
topological space, which has a unique group structure as a \emph{central
extension} by the \emph{fundamental group}. For a disconnected topological
group, there is a unique universal cover of the identity component of the
group, and one can take the same cover as topological spaces on the other
components (which are principal homogeneous spaces for the identity component)
but the group structure on other components is not uniquely determined in general.

\subsection{Homotopy Class}

Given two topological spaces $M$ and $N$, one can place an equivalence
relationship on the continuous maps $f:M->N$ using homotopies, and write
\begin{equation}
f_{1}\sim f_{2}\,\operatorname*{Iff}\,f_{1}\text{ homotopic to }f_{2}.
\end{equation}
Roughly speaking, two maps \emph{are homotopic} if one can be deformed into
the other. This equivalence relation is transitive because these homotopy
deformations can be composed (i.e., one can follow the other).

A simple example is the case of continuous maps from one circle to another
circle. Consider the number of ways an infinitely stretchable string can be
tied around a tree trunk. The string forms the first circle, and the tree
trunk's surface forms the second circle. For any integer $n$, the string can
be wrapped around the tree $n$ times, for positive $n$ clockwise, and negative
$n$ counterclockwise. Each integer $n$ corresponds to a homotopy class of maps
from $S^{1}$ to $S^{1}$.

After the string is wrapped around the tree $n$ times, it could be deformed a
little bit to get another continuous map, but it would still be in the same
homotopy class, since it is homotopic to the original map. Conversely, any map
wrapped around $n$ times can be deformed to any other.

\subsection{Spinor space}

It is worth reviewing how spinor spaces and \emph{Weyl spinors} are
constructed. Given a real vector space $V$ of dimension $n=2m$, its
complexification is $\mathbb{C}\otimes V$. It can be written as the direct sum
of a subspace $W$ of \emph{spinors} and a subspace $\overline{W}$ of
\emph{anti-spinors}:%

\begin{equation}
\mathbb{C}\otimes V=W\oplus\overline{W}%
\end{equation}


The space $W$ is spanned by the spinors
\begin{equation}
\U{3b7} _{k}=e_{2k-1}-ie_{2k}%
\end{equation}
and the complex conjugate spinors span $\overline{W}$. It is straightforward
to see that the spinors anti-commute, and that the product of a spinor and
anti-spinor is a scalar.

The \emph{spinor space} is defined as the exterior algebra $\U{22c0} W$ . The
(complexified) Clifford algebra acts naturally on this space; the
(complexified) spin group corresponds to the length-preserving endomorphisms.
There is a natural grading on the exterior algebra: the product of an odd
number of copies of $W$ correspond to the physics notion of fermions; the even
subspace corresponds to the bosons. The representations of the action of the
spin group on the spinor space can be built in a relatively straightforward fashion.

\subsection{Exact Short and Long Sequences}

In the context of group theory, a sequence%
\begin{equation}
G_{o}\overset{f_{1}}{\rightarrow}G_{1}\overset{f_{2}}{\rightarrow}%
\cdots\overset{f_{n-1}}{\rightarrow}G_{n-1}\overset{f_{n}}{\rightarrow}G_{n}%
\end{equation}
of groups and group homomorphisms is \emph{called exact} if the \emph{image of
each homomorphism} is equal to \emph{the kernel of the next}%
\begin{equation}
\operatorname{Ran}\left\{  f_{k}\right\}  =\ker\left\{  f_{k+1}\right\}  .
\end{equation}
$\lceil$%
\begin{equation}
G_{o}\overset{f_{1}}{\rightarrow}\operatorname{Ran}\left\{  f_{1}\right\}
=\ker\left\{  f_{2}\right\}  \overset{f_{2}}{\rightarrow}\cdots
\overset{f_{n-1}}{\rightarrow}\operatorname{Ran}\left\{  f_{n-1}\right\}
=\ker\left\{  f_{n}\right\}  \overset{f_{n}}{\rightarrow}G_{n}%
\end{equation}%
\begin{equation}
G_{o}\overset{f_{1}}{\rightarrow}f_{1}\left(  G_{o}\right)  =\ker\left\{
f_{2}\right\}  \subseteq G_{1}\overset{f_{2}}{\rightarrow}\cdots
\overset{f_{n-1}}{\rightarrow}f_{n-1}\left(  G_{n-1}\right)  =\ker\left\{
f_{n}\right\}  \subseteq G_{n-1}\overset{f_{n}}{\rightarrow}G_{n}%
\end{equation}
$\rfloor$

The sequence of groups and homomorphisms may be either finite or infinite. A
similar definition can be made for other algebraic structures. For example,
one could have an exact sequence of vector spaces and linear maps, or of
modules and module homomorphisms. More generally, the notion of an exact
sequence makes sense in any category with kernels and cokernels.

\subsection{Contraction and Expansion Maps}

Consider Fock space $\mathcal{H}_{\mathcal{F}},$ which is an exterior algebra
given by
\begin{equation}
\mathcal{H}_{\mathcal{F}}=\bigwedge\left(  \mathcal{H}^{1}\right)
=\bigoplus\limits_{0\leq n\leq r}\mathcal{H}^{n}\equiv\bigoplus\limits_{0\leq
n\leq r}\bigwedge\nolimits^{n}\mathcal{H}^{1}%
\end{equation}
and the \emph{even} \emph{trace class} \underline{\emph{non unital}}
\emph{Fock-algebra (not a }$c^{\ast}$\emph{-algebra wrt the trace class
norm})
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{e}=\bigoplus\limits_{0\leq
n\leq r}\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \equiv\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},
\end{equation}
which is a subalgebra of the \emph{even Fock algebra (a }$c^{\ast}%
$\emph{-algebra wrt the operator norm})%
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{e}=\bigoplus\limits_{0\leq n\leq
r}\mathcal{B}\left(  \mathcal{H}^{n}\right)  \equiv\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e},
\end{equation}
which itself is a subalgebra of the \emph{Fock algebra (a }$c^{\ast}%
$\emph{-algebra wrt the operator norm})
\begin{equation}
\mathcal{F}=\bigoplus\limits_{0\leq n,m\leq r}\mathcal{B}\left(
\mathcal{H}^{n},\mathcal{H}^{m}\right)  =\mathcal{B}\left(  \bigwedge\left(
\mathcal{H}^{1}\right)  \right)  \equiv\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  .
\end{equation}
The Dual space, $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ of
$\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},$ wrt the
sesquilinear dual form
\begin{equation}
\left\langle Y,X\right\rangle =\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}%
}\left\{  Y^{\dagger}X\right\}  ,\,Y\in\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e},X\in\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e},
\end{equation}
is $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ i.e.
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}^{d}%
=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}.
\end{equation}


\begin{remark}
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ \emph{is contained
in} $\mathcal{F}_{e}$ as a sub $c^{\ast}$-algebra i.e. $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}\subset\mathcal{F}_{e}$. $\mathcal{F}%
_{e}$ contains particle non-conserving operators, while $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ contains only particle consering
operators. Of course the definition of a particle \emph{depends} on the second
quantized basis.
\end{remark}

\begin{remark}
The sesquilinear dual form $\left\langle Y,X\right\rangle $ can be considered
as the extension $\widetilde{\left\langle \left.  Y\right\vert X\right\rangle
}_{\mathcal{HS}}$ of the Hilbert-Schmidt inner product
\begin{equation}
\left\langle \left.  Y\right\vert X\right\rangle _{\mathcal{HS}}%
=\operatorname{Tr}\left\{  Y^{\dagger}X\right\}  ,\,X,Y\in\mathcal{B}%
_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}.
\end{equation}

\end{remark}

\begin{remark}
The spaces $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\supseteq\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\supseteq\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
\underline{do not form} a \emph{Gelfand Triple.}
\end{remark}

\begin{remark}
The Compact operators $\mathcal{B}_{0}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \supseteq\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
thus all Trace Class operators have discrete spectra.
\end{remark}

\begin{remark}
Trace Class operators forming a Banach space $\mathcal{B}_{1}\left(
\mathcal{V}\right)  $ which act in a Hilbert space $\mathcal{V}$ can always be
decomposed into the algebraic union%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{V}\right)  =\mathcal{B}_{1\mathsf{zero}%
}\left(  \mathcal{V}\right)  \cup\mathcal{B}_{1\mathsf{zero}}\left(
\mathcal{V}\right)  ^{c},
\end{equation}
where
\begin{equation}
\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)  =\left\{  \left.
X\right\vert \operatorname{Tr}\left\{  X\right\}  =0,X\in\mathcal{B}%
_{1}\left(  \mathcal{V}\right)  \equiv\operatorname{Tr}\left\{  X\right\}
=0,X\in\mathcal{B}\left(  \mathcal{V}\right)  \right\}
\end{equation}
and
\begin{equation}
\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)  ^{c}=\mathcal{B}%
_{1\mathsf{nonzero}}\left(  \mathcal{V}\right)  =\left\{  \left.  X\right\vert
\operatorname{Tr}\left\{  X\right\}  \neq0,X\in\mathcal{B}_{1}\left(
\mathcal{V}\right)  \right\}  .
\end{equation}

\end{remark}

\begin{remark}
In general $\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)
^{c}=\mathcal{B}_{1\mathsf{nonzero}}\left(  \mathcal{V}\right)  $ is not a subspace.
\end{remark}

\begin{definition}
Direct Algebraic Complement: Let $X$ have a structure of a linear space and
let $M$ be a subspace of $X$. A subspace $N\subset X$ is said to be a direct
algebraic complement of $M$ if any $x\in X$ can be uniquely represented as
\begin{equation}
x=y+z,\quad y\in M,z\in N.
\end{equation}
This is equivalent to the conditions
\begin{equation}
X=M+N;\quad M\cap N=\{0\}.
\end{equation}
Any subspace of $X$ has an algebraic complement, but this \emph{complement is
not uniquely} determined.
\end{definition}

\begin{remark}
Let $(X,\U{3c4} )$ be a \emph{linear topological space} and let $X$ be the
direct algebraic sum
\begin{equation}
X=L\oplus N
\end{equation}
of subspaces $L$ and $N$, regarded as linear topological spaces with the
induced topology. The one-to-one mapping
\begin{equation}
(x,y)\mapsto x+y
\end{equation}
of the Cartesian product $L\times N$ onto $X$, which is continuous by virtue
of the linearity of the topology $\U{3c4} $, \emph{does not have, in general},
a continuous inverse. If this mapping is a homeomorphism, i.e. if $X$ is the
direct topological sum of the spaces $L$ and $N$, the subspace $N$ is said to
be the \emph{direct topological complement }of the subspace $L$, the latter
being known as a \emph{complementable} subspace. \emph{Not all} subspaces in
an arbitrary linear topological space, \emph{not even the finite-dimensional
ones}, are complementable.
\end{remark}

\begin{remark}
The following necessary and sufficient condition for complementability holds:
The subspace $L$ is topologically isomorphic to $X/N$, where $N$ is an
algebraic complement of $L$. This criterion entails the following sufficient
conditions for complementability:

\begin{itemize}
\item $L$ is closed and has finite codimension; $X$ is locally convex and $L$
is finite-dimensional.
\end{itemize}
\end{remark}

\begin{remark}
Clearly $\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)  $ is
\emph{not }an algebra as the product of trace zero operators is not in general
a trace zero operator.
\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)  =\ker\left\{
\operatorname{Tr}\right\}
\end{equation}
is a closed subspace.
\end{remark}

\begin{remark}
In finite dimensions
\begin{equation}
\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)  ^{c}=\mathcal{B}%
_{1\mathsf{nonzero}}\left(  \mathcal{V}\right)  =\left\{  \left.
zI_{V}\right\vert z\in\mathbb{C}\right\}
\end{equation}
and is a closed Banach subspace within the Banach space of Trace Class
operators, but in infinte dimensions
\begin{equation}
\mathcal{B}_{1\mathsf{nonzero}}\left(  \mathcal{V}\right)  \cap\left\{
\left.  zI_{V}\right\vert z\in\mathbb{C}\right\}  =\phi,
\end{equation}
as the identity is not trace class.
\end{remark}

\begin{remark}
Banach space subspaces are not necessarily complementable. In the case of
Trace class operators the subspace $\mathcal{B}_{1\mathsf{zero}}\left(
\mathcal{V}\right)  $ is not complementable within $\mathcal{B}_{1}\left(
\mathcal{V}\right)  $. The set $\mathcal{B}_{1\mathsf{nonzero}}\left(
\mathcal{V}\right)  $ is \emph{not} a subspace as two trace non zero operators
can be linearly combined to form a trace zero operator e.g.
\begin{equation}
\operatorname{Tr}\left\{  \alpha X+\beta Y\right\}  =0,
\end{equation}
where%
\begin{equation}
\operatorname{Tr}\left\{  X\right\}  \neq0,\operatorname{Tr}\left\{
Y\right\}  \neq0
\end{equation}
and
\begin{equation}
\operatorname{Tr}\left\{  \alpha X+\beta Y\right\}  =\operatorname{Tr}\left\{
\alpha X\right\}  =-\operatorname{Tr}\left\{  \beta Y\right\}
\end{equation}
i.e.
\begin{equation}
\operatorname{Tr}\left\{  X\right\}  =-\frac{\beta}{\alpha}\operatorname{Tr}%
\left\{  Y\right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
X\in\mathcal{B}_{1\mathsf{zero}}\left(  \mathcal{V}\right)  \nRightarrow
\left\Vert X\right\Vert _{\mathcal{B}_{1}\left(  \mathcal{V}\right)
}=\operatorname{Tr}\left\{  \left(  X^{\dagger}X\right)  ^{\frac{1}{2}%
}\right\}  =0.
\end{equation}

\end{remark}

\begin{definition}
\emph{Quotient Space:} Formally, the construction is as follows (Halmos 1974,
\S 21-22). Let $V$ be a vector space over a field $\mathbb{K}$, and let $N$ be
a subspace of $V$. We define an equivalence relation $\symbol{126}$ on $V$ by
stating that
\begin{equation}
x\symbol{126}y\Leftrightarrow x-y\in N.
\end{equation}
That is, $x$ is related to $y$ if one can be obtained from the other by adding
an element of $N$. From this definition, one can deduce that any element of
$N$ is related to the zero vector; more precisely all the vectors in $N$ get
mapped into the equivalence class of the zero vector.The equivalence class
(or, in this case, the coset) of $x$ is often denoted%
\begin{equation}
\lbrack x]=x+N
\end{equation}
since it is given by%
\begin{equation}
\lbrack x]=\{\left.  x+n\right\vert n\in N\}.
\end{equation}
The quotient space $V/N$ is then defined as $V/\symbol{126}$, the set of all
equivalence classes over $V$ by $\symbol{126}$. Scalar multiplication and
addition are defined on the equivalence classes by%
\begin{equation}
\U{3b1} \lbrack x]=[\U{3b1} x]\text{ for all }\U{3b1} \in\mathbb{K}%
\end{equation}
and%
\begin{equation}
\lbrack x]+[y]=[x+y].
\end{equation}
It is not hard to check that these operations are well-defined (i.e. do not
depend on the choice of representative). These operations turn the quotient
space $V/N$ into a vector space over $\mathbb{K}$ with $N$ being the zero
class, $[0]$. The mapping that associates to $v\in V$ the equivalence class
$[v]$ is known as the \emph{quotient map}.
\end{definition}

\paragraph{Properties}

There is a natural \emph{epimorphism} from $V$ to the quotient space $V/U$
given by sending $x$ to its equivalence class $[x]$. The kernel (or nullspace)
of this epimorphism is the subspace $U$. This relationship is neatly
summarized by the \emph{short exact sequence}%
\begin{equation}
0\rightarrow U\rightarrow V\rightarrow V/U\rightarrow0.
\end{equation}


If $U$ is a subspace of $V$, the dimension of $V/U$ is called the
\emph{codimension} of $U$ in $V$. Since a basis of $V$ may be constructed from
a basis $A$ of $U$ and a basis $B$ of $V/U$ by adding a representative of each
element of $B$ to $A$, the dimension of $V$ is the sum of the dimensions of
$U$ and $V/U$. If $V$ is finite-dimensional, it follows that the codimension
of $U$ in $V$ is the difference between the dimensions of $V$ and $U$ (Halmos
1974, Theorem 22.2)%
\begin{equation}
\operatorname*{codim}\left\{  U\right\}  =\dim\left\{  \U{2061} V/U\right\}
=\dim\left\{  \U{2061} V\right\}  -\dim\U{2061} \left\{  U\right\}  .
\end{equation}


Let
\begin{equation}
T:V\rightarrow W
\end{equation}
be a linear operator. The kernel of $T$, denoted $\ker\left\{  T\right\}  $,
is the set of all $x\in V$ such that $Tx=0$. The kernel is a subspace of $V$.
The first isomorphism theorem of linear algebra says that the quotient space
$V/\ker\left\{  T\right\}  $ is isomorphic to the image of $V$ in $W$. An
immediate corollary, for finite-dimensional spaces, is the \emph{rank--nullity
theorem}: the dimension of $V$ is equal to the dimension of the kernel (the
\emph{nullity} of $T$) plus the dimension of the image $\equiv
\operatorname{Ran}$ (the \emph{rank} of $T$).

\begin{definition}
The \emph{cokernel} of a linear operator
\begin{equation}
T:V\rightarrow W
\end{equation}
is defined to be the quotient space
\begin{equation}
\operatorname{Coker}\left\{  T\right\}  =W/\operatorname{Img}\left\{
T\right\}  .
\end{equation}

\end{definition}

\paragraph{Quotient of a Banach space by a subspace}

\begin{definition}
If $X$ is a Banach space and $M$ is a closed subspace of $X$, then the
quotient $X/M$ is again a Banach space. The quotient space is already endowed
with a vector space structure by the construction of the previous section. We
define a norm on $X/M$ by%
\begin{equation}
\Vert\lbrack x]\Vert_{X/M}=\inf\limits_{m\in M}\Vert x-m\Vert_{X}.
\end{equation}
The quotient space $X/M$ is complete with respect to the norm, so it is a
Banach space.
\end{definition}

\begin{example}
\begin{enumerate}
\item The trace linear functional
\begin{equation}
\operatorname{Tr}:\mathcal{B}_{1}\left(  \mathcal{V}\right)  \rightarrow
\mathbb{C}%
\end{equation}


\item The quoteint space
\begin{equation}
\mathcal{B}_{1\mathsf{nonzero}}\left(  \mathcal{V}\right)  =\mathcal{B}%
_{1}\left(  \mathcal{V}\right)  \left/  \mathcal{B}_{1\mathsf{zero}}\left(
\mathcal{V}\right)  \right.  \equiv\mathcal{B}_{1}\left(  \mathcal{V}\right)
\left/  \ker\left\{  \operatorname{Tr}\right\}  \right.  \cong\mathbb{C}.
\end{equation}


\item The equivalence class
\begin{equation}
\left[  X\right]  =\{\left.  X+Y\right\vert \operatorname{Tr}\left\{
Y\right\}  =0\}.
\end{equation}

\end{enumerate}
\end{example}

\begin{definition}
Approximate Identity: Let $A$ be a normed algebra and let
\begin{equation}
\{\left.  e(\U{3bb} )\right\vert \U{3bb} \in\Lambda\subset\mathbb{R}\}
\end{equation}
be a net in $A$ and $\alpha\in\mathbb{C}$.

\begin{enumerate}
\item $\{\left.  e(\U{3bb} )\right\vert \U{3bb} \in\Lambda\}$ is a \emph{Left
Approximate Identity} for $A$ if for every $a\in A$ we have that $e(\U{3bb}
)a\rightarrow\U{3b1} a$.

\item $\{\left.  e(\U{3bb} )\right\vert \U{3bb} \in\Lambda\}$ is a \emph{Right
Approximate Identity} for $A$ if for every $a\in A$ we have that $ae(\U{3bb}
)\rightarrow\U{3b1} a.$

\item $\{\left.  e(\U{3bb} )\right\vert \U{3bb} \in\Lambda\}$ is a
\emph{Two-Sided Approximate Identity} for $A$ if it is both a left approximate
identity and a right approximate identity.
\end{enumerate}
\end{definition}

\begin{definition}
A \emph{left/right/two-sided approximate identity} is said to be a
\emph{Bounded Left/Right/Two-Sided} Approximate Identity if it is also bounded
as a net, i.e., there exists an $M>0$ such that $\parallel e(\U{3bb}
)\parallel\leq M$ for all $\U{3bb} \in\U{39b} .$ Equivalently, a net
$\{\left.  e(\U{3bb} )\right\vert \U{3bb} \in\Lambda\}$ in $A$ is a left
approximate identity for $A$ if for each $a\in A$ we have that for all
$\U{3f5} >0$ there exists a $\U{3bb} _{0}\in\U{39b} $ such that if $\U{3bb}
\geq\U{3bb} _{0}$ then:
\end{definition}

\begin{description}
\item
\begin{itemize}
\item $\parallel a-e(\U{3bb} )a\parallel<\U{3f5} $ And it is a right
approximate identity for $A$ if for each $a\in A$ we have that for all
$\U{3f5} >0$ there exists a $\U{3bb} _{0}\in\U{39b} $ such that if $\U{3bb}
\geq\U{3bb} _{0}$ then:$\parallel a-ae(\U{3bb} )\parallel<\U{3f5} .$
\end{itemize}
\end{description}

\begin{remark}
It can be shown that $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}$ is closed wrt the trace class norm, $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}$ is closed wrt the \emph{operator norm}
\begin{equation}
\left\Vert f\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}}=\sup\limits_{\left\Vert A\right\Vert _{\mathcal{F}}\leq1}\left\{
\left\vert f\left(  A\right)  \right\vert \right\}  =\sup\limits_{\left\Vert
A\right\Vert _{\mathcal{F}}\leq1}\left\{  \left\vert \operatorname{Tr}%
_{\mathcal{H}_{\mathcal{F}}}\left\{  X_{f}^{\dagger}A\right\}  \right\vert
\right\}  =\sup\limits_{\left\Vert A\right\Vert _{\mathcal{F}}\leq1}\left\{
\left\vert \left\langle X_{f},A\right\rangle \right\vert \right\}
\end{equation}
and elements of $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$
are continuous linear functions acting in $\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ wrt the trace class norm.
\end{remark}

\begin{remark}
Any operator $X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  $ can be
expanded wrt the Ket-Bra conb (biorthogonal dual bases)
\begin{gather}
\left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert =\left(  \left\vert \varphi_{1}%
\cdots\varphi_{p}\right\rangle \left\langle \varphi_{1}\cdots\varphi
_{p}\right\vert ,\cdots,\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
,\cdots,\left\vert \varphi_{r-n}\cdots\varphi_{r}\right\rangle \left\langle
\varphi_{r-n}\cdots\varphi_{r}\right\vert \right) \\
1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r
\end{gather}
in the form
\begin{equation}
X=\left(  \left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert \right)  \mathcal{R}_{\varphi}\left(
X\right)
\end{equation}
as sums or trace class limits (wrt trace class norm) of sums of ket-bra
operators i.e.
\begin{align}
X  &  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq
k_{1}<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\right\vert X\right\rangle _{\mathcal{B}\left(  \mathcal{H}^{n}\right)  }\\
&  \sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\vert \right)  ^{\dagger}X\right\} \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\operatorname{Tr}\left\{  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\vert
X\right\} \\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\vert
X\varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}%
}}\\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
X_{j_{1}\cdots j_{n}k_{1}\cdots k_{n}}.
\end{align}

\end{remark}

\begin{remark}
The \emph{closure of finite rank operators, }$\mathcal{B}_{00}\left(
\mathcal{H}^{n}\right)  ,$ acting in $\mathcal{H}^{n}$ wrt the operator norm
is the \emph{compact operators} $\mathcal{B}_{0}\left(  \mathcal{H}%
^{n}\right)  .$
\end{remark}

\begin{remark}
\emph{Sequences} of \emph{non compact operators can converge wrt the operator
norm to bounded operators}.
\end{remark}

\begin{remark}
S\emph{equences} of \emph{compact operators converge wrt the strong operator
topology to bounded operators.}
\end{remark}

\begin{remark}
Any operator $X\in\mathcal{B}\left(  \mathcal{H}^{n}\right)  $ can be expanded
wrt the Ket-Bra basis
\begin{gather}
\left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert =\left(  \left\vert \varphi_{1}%
\cdots\varphi_{p}\right\rangle \left\langle \varphi_{1}\cdots\varphi
_{p}\right\vert ,\cdots,\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
,\cdots,\left\vert \varphi_{r-n}\cdots\varphi_{r}\right\rangle \left\langle
\varphi_{r-n}\cdots\varphi_{r}\right\vert \right) \\
1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r,
\end{gather}
as
\begin{equation}
X=\left(  \left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert \right)  \mathcal{R}_{\varphi}\left(
X\right)  ,
\end{equation}
which corresponds to the sums or the \emph{strong operator} limits of sums
\begin{equation}
X=\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{n}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
X_{j_{1}\cdots j_{n}k_{1}\cdots k_{n}},
\end{equation}
where
\begin{equation}
X_{j_{1}\cdots j_{n}k_{1}\cdots k_{n}}=\left\langle \left.  \varphi_{j_{1}%
}\cdots\varphi_{j_{n}}\right\vert X\varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=\mathcal{R}_{\varphi}\left(
X\right)  _{j_{1}\cdots j_{n}k_{1}\cdots k_{n}}.
\end{equation}
Using the \emph{extended} inner product and noting that $\left\{  \left\vert
\mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle \mathbf{\varphi
}_{1\cdots n}\right\vert \right\}  $ is a "conb" (more rigorously
biorthogonal) the contravariant representation can be expressed as
\begin{equation}
\mathcal{R}_{\varphi}\left(  X\right)  =\left\langle \left.  \left\vert
\mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle \mathbf{\varphi
}_{1\cdots n}\right\vert \right\vert X\right\rangle _{\mathcal{F}},
\end{equation}
i.e.
\begin{equation}
X_{j_{1}\cdots j_{n}k_{1}\cdots k_{n}}=\left\langle \left.  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\vert \right\vert X\right\rangle _{\mathcal{F}%
}=\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\vert \right)  ^{\dagger}X\right\}  =\left\langle
\left.  \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\vert X\varphi_{k_{1}}%
\cdots\varphi_{k_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{remark}

\subsubsection{Definition of Contraction and Expansion Maps}

\paragraph{Expansion Map}

The \emph{Expansion Maps} $\left\{  \left.  \Gamma_{p}^{n}\right\vert 0\leq
p\leq n,0\leq n\leq r\right\}  $ defined on the subspaces $\left\{  \left.
\mathcal{B}\left(  \mathcal{H}^{p}\right)  \right\vert 0\leq p\leq r\right\}
$
\begin{equation}
\Gamma_{p}^{n}:\mathcal{B}\left(  \mathcal{H}^{p}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
of $\mathcal{F}$ are defined by
\begin{equation}
\Gamma_{p}^{n}\left(  X\right)  =X\boxtimes P_{n-p},\,\,X\in\mathcal{B}\left(
\mathcal{H}^{p}\right)  ,\,P_{n-p}\in\mathcal{B}\left(  \mathcal{H}%
^{n-p}\right)  ,\,\quad P_{n-p}=P_{n-p}^{2}=P_{n-p}^{\dagger},
\end{equation}
where $P_{n-p}$ is the orthogonal projector onto $\mathcal{H}^{n-p}.$

\begin{lemma}
The expansion map is an iterated map%
\begin{equation}
\Gamma_{p}^{n}\left(  X\right)  =X\boxtimes P_{n-p}=X\boxtimes
\overset{n-p}{P_{1}\boxtimes\overbrace{P_{1}\cdots\boxtimes P_{1}}}\,=\left[
\Gamma_{n-1}^{n}\circ\Gamma_{n-2}^{n-1}\circ\cdots\circ\Gamma_{p+1}^{p+2}%
\circ\Gamma_{p}^{p+1}\right]  \left(  \overset{}{X}\right)  ;X\in
\mathcal{B}\left(  \mathcal{H}^{p}\right)
\end{equation}

\end{lemma}

\begin{proof}
From the definition.

\begin{corollary}%
\begin{equation}
\operatorname{Ran}\left\{  \Gamma_{n-1}^{n}\right\}  \supseteq
\operatorname{Ran}\left\{  \Gamma_{p}^{n}\right\}  ;0\leq p\leq n-1.
\end{equation}

\end{corollary}
\end{proof}

\begin{theorem}
The action on basis vectors is given by
\begin{align}
\Gamma_{p}^{n}\left(  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert
\right)   &  =\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
P_{n-p}=\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
\overset{n-p}{\overbrace{P_{1}\boxtimes\cdots\boxtimes P_{1}}}\\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\vert
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\vert .
\end{align}

\end{theorem}

The \emph{Expansion Maps} $\left\{  \left.  \Gamma_{p}^{n}\right\vert 0\leq
p\leq n,0\leq n\leq r\right\}  ,$ which are injective
\begin{equation}
\Gamma_{p}^{n}:\mathcal{B}\left(  \mathcal{H}^{p}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
between subspaces of the even subalgebra $\mathcal{B}_{e}\left(
\bigwedge\left(  \mathcal{H}^{1}\right)  \right)  $ are the\emph{ adjoints} of
the contraction maps wrt the sesquilinear product
\begin{equation}
\left\langle Y,X\right\rangle \equiv\left\langle \left.  Y\right\vert
X\right\rangle _{\mathcal{F}}=\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}%
}\left\{  Y^{\dagger}X\right\}  ,\,Y\in\mathcal{B}\left(  \bigwedge\left(
\mathcal{H}^{1}\right)  \right)  _{e},X\in\mathcal{B}_{1}\left(
\bigwedge\left(  \mathcal{H}^{1}\right)  \right)  _{e},
\end{equation}
defined on the dual Banach spaces $\left\langle \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e},\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}\right\rangle ,$ i.e.
\begin{equation}
\left\langle Y,L_{n}^{p}\left(  X\right)  \right\rangle =\left\langle
\Gamma_{p}^{n}\left(  Y\right)  ,X\right\rangle ,\,Y\in\mathcal{B}\left(
\mathcal{H}^{n}\right)  ,X\in\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  ,
\end{equation}
giving%

\begin{equation}
\left\langle \left.  \left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle
\left\langle \mathbf{\varphi}_{1\cdots p}\right\vert \right\vert L_{n}%
^{p}\left(  X\right)  \right\rangle _{\mathcal{F}}=\left\langle \left.
\Gamma_{p}^{n}\left(  \left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle
\left\langle \mathbf{\varphi}_{1\cdots p}\right\vert \right)  \right\vert
X\right\rangle _{\mathcal{F}}=\left\langle \left.  \left\vert \mathbf{\varphi
}_{1\cdots p}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots
p}\right\vert \boxtimes P_{n-p}\right\vert X\right\rangle _{\mathcal{F}}.
\end{equation}


The explicit form of the expansion maps on bases elements
\begin{gather}
\Gamma_{p}^{n}\left(  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert
\right)  =\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \boxtimes
P_{n-p}\\
1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r,0\leq p\leq
n,0\leq n\leq r,
\end{gather}
are given by
\begin{equation}
\Gamma_{p}^{n}\left(  X\right)  =\sum\limits_{\substack{1\leq j_{1}%
<\cdots<j_{p}\leq r\\1\leq k_{1}<\cdots<k_{p}\leq r\\1\leq l_{p+3}%
<\cdots<l_{n}\leq r}}X_{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}\left\vert
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\vert .
\end{equation}


\begin{example}
$p=2$%
\begin{align}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \boxtimes P_{n-2}  &  =\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \boxtimes\sum\limits_{\substack{1\leq l_{3}%
<\cdots<l_{n}\leq r}}\left\vert \varphi_{l_{3}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{l_{3}}\cdots\varphi_{l_{n}}\right\vert \\
&  =\sum\limits_{\substack{1\leq l_{3}<\cdots<l_{n}\leq r}}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\varphi_{l_{3}%
}\cdots\varphi_{l_{n}}\right\vert .
\end{align}

\end{example}

\begin{example}
$r=4,p=1,n=2$
\end{example}

Projectors and dimension function
\begin{gather}
P_{1}=\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
+\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
+\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert
+\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert \\
\operatorname{Tr}\left\{  P_{1}\right\}  =\binom{4}{1}=4\\
P_{2}=\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert +\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
+\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \\
\operatorname{Tr}\left\{  P_{2}\right\}  =\binom{4}{2}=6.
\end{gather}


Noting that
\begin{equation}
\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\rangle
\left\langle \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\vert
=\frac{1}{n!}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\vert
\end{equation}
the expansion map $\Gamma_{1}^{2}$ has the properties
\begin{align}
\Gamma_{1}^{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert \right)   &  =\left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert \boxtimes P_{1}=\left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert \boxtimes\left(
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
+\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
+\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert
+\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert
\right) \\
&  =\left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle \left\langle
\varphi_{1}\wedge\varphi_{2}\right\vert +\left\vert \varphi_{1}\wedge
\varphi_{3}\right\rangle \left\langle \varphi_{1}\wedge\varphi_{3}\right\vert
+\left\vert \varphi_{1}\wedge\varphi_{4}\right\rangle \left\langle \varphi
_{1}\wedge\varphi_{4}\right\vert \\
&  =\frac{1}{2}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{4}\right\vert \right) \\
\Gamma_{1}^{2}\left(  \left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
+\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert \right) \\
\Gamma_{1}^{2}\left(  \left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right) \\
\Gamma_{1}^{2}\left(  \left\vert \varphi_{4}\right\rangle \left\langle
\varphi_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
+\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right)  ,
\end{align}
hence%
\begin{equation}
\Gamma_{1}^{2}\left(  P_{1}\right)  =P_{1}\boxtimes P_{1}=\Gamma_{1}%
^{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right)  =P_{2}.
\end{equation}
Noting that
\begin{equation}
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert \right\rangle _{\mathcal{F}}=1
\end{equation}
one obtains%
\begin{gather}
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert
P_{2}\right\rangle _{\mathcal{F}}=\left\langle \left.  P_{2}\right\vert
P_{2}\right\rangle _{\mathcal{F}}=\\
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert \left(
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert +\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
+\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert
\right)  \right\rangle _{\mathcal{F}}=6
\end{gather}
i.e.%
\begin{equation}
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert
P_{2}\right\rangle _{\mathcal{F}}=\operatorname{Tr}\left\{  P_{2}\right\}  =6.
\end{equation}


\paragraph{Contraction Map}

The contraction map is the adjoint of the expansion map i.e.
\begin{equation}
\left\langle X,L_{n}^{p}\left(  Y\right)  \right\rangle =\left\langle
\Gamma_{p}^{n}\left(  X\right)  ,Y\right\rangle \quad Y\in\mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  ,\forall X\in\mathcal{B}\left(
\mathcal{H}^{n}\right)
\end{equation}


\begin{example}
\begin{enumerate}
\item The contraction map
\begin{align}
&  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right)  =L_{2}^{1}\left(
\frac{1}{2}\left(  \left\vert \left(  \varphi_{1}\otimes\varphi_{2}%
-\varphi_{2}\otimes\varphi_{1}\right)  \right\rangle \left\langle \varphi
_{1}\otimes\varphi_{2}-\varphi_{2}\otimes\varphi_{1}\right\vert \right)
\right) \\
&  =\frac{1}{2}L_{2}^{1}\left(  \left(  \left\vert \left(  \varphi_{1}%
\otimes\varphi_{2}\right)  \right\rangle \left\langle \varphi_{1}%
\otimes\varphi_{2}\right\vert -\left\vert \left(  \varphi_{1}\otimes
\varphi_{2}\right)  \right\rangle \left\langle \varphi_{2}\otimes\varphi
_{1}\right\vert -\left\vert \left(  \varphi_{2}\otimes\varphi_{1}\right)
\right\rangle \left\langle \varphi_{1}\otimes\varphi_{2}\right\vert
+\left\vert \left(  \varphi_{2}\otimes\varphi_{1}\right)  \right\rangle
\left\langle \varphi_{2}\otimes\varphi_{1}\right\vert \right)  \right) \\
&  =\frac{1}{2}\left(  \left\vert \left(  \varphi_{1}\right)  \right\rangle
\left\langle \varphi_{1}\right\vert +\left\vert \left(  \varphi_{2}\right)
\right\rangle \left\langle \varphi_{2}\right\vert \right)  ,
\end{align}
which is confirmed by
\begin{equation}
\left\langle \left.  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert \right\vert L_{2}^{1}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right)  \right\rangle _{\mathcal{F}}=\left\langle \left.  \Gamma_{1}%
^{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert \right)  \right\vert \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right\rangle
_{\mathcal{F}}=\frac{1}{2}%
\end{equation}%
\begin{equation}
\left\langle \left.  \left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right\vert L_{2}^{1}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right)  \right\rangle _{\mathcal{F}}=\left\langle \left.  \Gamma_{1}%
^{2}\left(  \left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert \right)  \right\vert \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right\rangle
_{\mathcal{F}}=\frac{1}{2}.
\end{equation}


\item
\begin{gather}
\left\langle \left.  \Gamma_{1}^{2}\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert \right)  \right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\rangle _{\mathcal{F}}=\left\langle \left.  \frac{1}%
{2}\left(  \overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{4}\right\vert }\right)  \right\vert \left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right\rangle _{\mathcal{F}}=\frac{1}{2}\\
\left\langle \left.  \Gamma_{1}^{2}\left(  \left\vert \varphi_{2}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  \right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\rangle _{\mathcal{F}}=\left\langle \left.  \frac{1}%
{2}\left(  \overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{2}%
\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
+\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{4}\varphi_{4}\right\vert }\right)  \right\vert \left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right\rangle _{\mathcal{F}}=\frac{1}{2}%
\end{gather}
and%
\begin{align}
\left\langle \left.  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert \right\vert L_{2}^{1}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right)  \right\rangle _{\mathcal{F}}  &  =\operatorname{Tr}\left\{
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  \right\}  =\frac{1}{2}\\
\left\langle \left.  \left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right\vert L_{2}^{1}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right)  \right\rangle _{\mathcal{F}}  &  =\operatorname{Tr}\left\{
\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  \right\}  =\frac{1}{2}\\
&  \Rightarrow L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right)  =\frac{1}{2}\left(
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
+\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
\right)  ,
\end{align}
giving%
\begin{align}
L_{2}^{1}\left(  P_{2}\right)   &  =L_{2}^{1}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
+\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi
_{1}\varphi_{3}\right\vert +\left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}%
\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
+\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right) \\
&  =\frac{3}{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle
\varphi_{4}\right\vert \right)  =\frac{3}{2}P_{1}.
\end{align}
$\lceil$%
\begin{align}
\binom{r-1}{p}  &  =\binom{4-1}{1}=\binom{3}{1}=3\\
\frac{1}{n!}  &  =\frac{1}{2!}=\frac{1}{2}.
\end{align}
$\rfloor$

\item
\begin{align}
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert
P_{2}\right\rangle _{\mathcal{F}}  &  =\left\langle \left.  P_{1}\right\vert
L_{2}^{1}\left(  P_{2}\right)  \right\rangle _{\mathcal{F}}\\
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert
P_{2}\right\rangle _{\mathcal{F}}  &  =\left\langle \left.  P_{2}\right\vert
P_{2}\right\rangle _{\mathcal{F}}=\binom{4}{2}=6\\
\left\langle \left.  P_{1}\right\vert L_{2}^{1}\left(  P_{2}\right)
\right\rangle _{\mathcal{F}}  &  =\left\langle \left.  \overset{}{P_{1}%
}\right\vert \frac{3}{2}P_{1}\right\rangle _{\mathcal{F}}=\frac{3}%
{2}\left\langle \left.  P_{1}\right\vert P_{1}\right\rangle _{\mathcal{F}%
}=\left(  \frac{3}{2}\right)  4=6,
\end{align}
as
\begin{equation}
\left\langle \left.  P_{1}\right\vert P_{1}\right\rangle _{\mathcal{F}%
}=4=\binom{4}{1}.
\end{equation}

\end{enumerate}
\end{example}

\begin{lemma}
Contraction of subspace projectors%
\[
L_{n}^{p}\left(  P_{n}\right)  =\frac{1}{n!}\binom{r-p}{p}P_{p}.
\]


\begin{proof}%
\begin{align}
&  L_{n}^{p}\left(  P_{n}\right)  =L_{n}^{p}\left(  \sum_{1\leq j_{1}%
<\cdots<j_{n}\leq r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\vert
\right)  =L_{n}^{p}\left(  n!\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\rangle \left\langle
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\vert \right) \\
&  =\frac{1}{n!}\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\sum_{\sigma,\mu\in
S_{n}}\left(  -1\right)  ^{\pi\left(  \sigma\right)  }\left(  -1\right)
^{\pi\left(  \mu\right)  }L_{n}^{p}\left(  \left\vert \varphi_{j_{\sigma
\left(  1\right)  }}\otimes\cdots\otimes\varphi_{j_{\sigma\left(  n\right)  }%
}\right\rangle \left\langle \varphi_{j_{\mu\left(  1\right)  }}\otimes
\cdots\otimes\varphi_{j_{\mu\left(  n\right)  }}\right\vert \right) \\
&  =\frac{1}{n!}\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\sum_{\sigma,\mu\in
S_{n}}\left(  -1\right)  ^{\pi\left(  \sigma\right)  }\left(  -1\right)
^{\pi\left(  \mu\right)  }L_{n}^{p}\left(  \left\vert \varphi_{j_{\sigma
\left(  1\right)  }}\otimes\cdots\otimes\varphi_{j_{\sigma\left(  p\right)  }%
}\varphi_{j_{\sigma\left(  p+1\right)  }}\cdots\otimes\varphi_{j_{\sigma
\left(  n\right)  }}\right\rangle \left\langle \varphi_{j_{\mu\left(
1\right)  }}\otimes\cdots\otimes\varphi_{j_{\mu\left(  p\right)  }}%
\varphi_{j_{\sigma\left(  p+1\right)  }}\cdots\otimes\varphi_{j_{\sigma\left(
n\right)  }}\right\vert \right) \\
&  =\frac{1}{n!}\binom{n}{p}\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}\sum
_{\sigma,\mu\in S_{p}}\left(  -1\right)  ^{\pi\left(  \sigma\right)  }\left(
-1\right)  ^{\pi\left(  \mu\right)  }\left\vert \varphi_{j_{\sigma\left(
1\right)  }}\otimes\cdots\otimes\varphi_{j_{\sigma\left(  p\right)  }%
}\right\rangle \left\langle \varphi_{j_{\mu\left(  1\right)  }}\otimes
\cdots\otimes\varphi_{j_{\mu\left(  p\right)  }}\right\vert \\
&  =\frac{1}{n!}\binom{n}{p}\frac{1}{p!}\sum_{1\leq j_{1}<\cdots<j_{n}\leq
r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert =\frac{1}{n!}\frac{n!}{\left(
n-p\right)  !\left(  p!\right)  }\frac{1}{p!}\sum_{1\leq j_{1}<\cdots
<j_{n}\leq r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert \\
&  =\frac{1}{\left(  n-p\right)  !\left(  p!\right)  ^{2}}P_{p}.
\end{align}


\begin{example}
$n=3,p=2$%
\begin{align}
&  L_{3}^{2}\left(  P_{3}\right)  =L_{3}^{2}\left(  \sum_{1\leq j_{1}%
<\cdots<j_{3}\leq4}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}%
}\right\vert \right)  =L_{3}^{2}\left(  3!\sum_{1\leq j_{1}<\cdots<j_{3}\leq
4}\left\vert \varphi_{j_{1}}\wedge\varphi_{j_{2}}\wedge\varphi_{j_{3}%
}\right\rangle \left\langle \varphi_{j_{1}}\wedge\varphi_{j_{2}}\wedge
\varphi_{j_{3}}\right\vert \right) \\
&  =\frac{1}{3!}\sum_{1\leq j_{1}<\cdots<j_{3}\leq4}\sum_{\mu\in S_{2}%
,\sigma\in S_{1}}\left(  -1\right)  ^{\pi\left(  \sigma\right)  }L_{3}%
^{2}\left(  \left\vert \varphi_{j_{\sigma\left(  1\right)  }}\otimes
\varphi_{j_{\sigma\left(  2\right)  }}\otimes\varphi_{j_{\sigma\left(
3\right)  }}\right\rangle \left\langle \varphi_{j_{\mu\left(  1\right)  }%
}\otimes\varphi_{j_{\mu\left(  2\right)  }}\otimes\varphi_{j_{\sigma\left(
3\right)  }}\right\vert \right) \\
&  =\frac{1}{3!}\binom{3}{2}\sum_{1\leq j_{1}<\cdots<j_{3}\leq4}\sum
_{\sigma\in S_{2}}\left\vert \varphi_{j_{\sigma\left(  1\right)  }}%
\otimes\varphi_{j_{\sigma\left(  2\right)  }}\right\rangle \left\langle
\varphi_{j_{\sigma\left(  1\right)  }}\otimes\varphi_{j_{\sigma\left(
2\right)  }}\right\vert \\
&  =\frac{1}{3!}\binom{3}{2}\frac{1}{2!}\sum_{1\leq j_{1}<j_{2}\leq
r}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert =\frac{1}{3}\frac{3!}{\left(
3-2\right)  !\left(  2!\right)  }\frac{1}{3!}\sum_{1\leq j_{1}<j_{2}\leq
r}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \\
&  =\frac{1}{\left(  3-2\right)  !\left(  2!\right)  ^{2}}P_{2}%
\end{align}
and%
\begin{align}
&  \sum_{\mu\in S_{2},\sigma\in S_{3}}\left(  -1\right)  ^{\pi\left(
\sigma\right)  }L_{3}^{2}\left(  \left\vert \varphi_{j_{\sigma\left(
1\right)  }}\otimes\varphi_{j_{\sigma\left(  2\right)  }}\otimes
\varphi_{j_{\sigma\left(  3\right)  }}\right\rangle \left\langle
\varphi_{j_{\mu\left(  1\right)  }}\otimes\varphi_{j_{\mu\left(  2\right)  }%
}\otimes\varphi_{j_{\sigma\left(  3\right)  }}\right\vert \right) \\
&  \left.  =\right.  L_{3}^{2}\left(  \left\vert \varphi_{j_{1}}\otimes
\varphi_{j_{2}}\otimes\varphi_{j_{3}}\right\rangle \left\langle \varphi
_{j_{1}}\otimes\varphi_{j_{2}}\otimes\varphi_{j_{3}}\right\vert -\left\vert
\varphi_{j_{1}}\otimes\varphi_{j_{2}}\otimes\varphi_{j_{3}}\right\rangle
\left\langle \varphi_{j_{2}}\otimes\varphi_{j_{1}}\otimes\varphi_{j_{3}%
}\right\vert \right. \\
&  +\left\vert \varphi_{j_{1}}\otimes\varphi_{j_{3}}\otimes\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\otimes\varphi_{j_{3}}%
\otimes\varphi_{j_{2}}\right\vert -\left\vert \varphi_{j_{2}}\otimes
\varphi_{j_{3}}\otimes\varphi_{j_{1}}\right\rangle \left\langle \varphi
_{j_{1}}\otimes\varphi_{j_{3}}\otimes\varphi_{j_{2}}\right\vert \\
&  +\left.  \left\vert \varphi_{j_{3}}\otimes\varphi_{j_{1}}\otimes
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{3}}\otimes\varphi
_{j_{1}}\otimes\varphi_{j_{2}}\right\vert -\left\vert \varphi_{j_{3}}%
\otimes\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\rangle \left\langle
\varphi_{j_{3}}\otimes\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert \right)
\\
&  \left.  =\right.  \left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\vert
-\left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert +\left\vert \varphi_{j_{1}%
}\otimes\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}%
\otimes\varphi_{j_{2}}\right\vert -\left\vert \varphi_{j_{2}}\otimes
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}\otimes\varphi
_{j_{2}}\right\vert \\
&  +\left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\vert -\left\vert \varphi_{j_{2}%
}\otimes\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{2}}%
\otimes\varphi_{j_{1}}\right\vert \\
&  =\left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}}-\varphi_{j_{2}}%
\otimes\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}\otimes
\varphi_{j_{2}}-\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert .
\end{align}

\end{example}
\end{proof}
\end{lemma}

\begin{lemma}
Expansion of subspace projectors%
\begin{equation}
\Gamma_{p}^{n}\left(  P_{p}\right)  =P_{n}.
\end{equation}

\end{lemma}

\begin{example}
$r=6,p=1,n=2$

\begin{enumerate}
\item
\begin{align}
P_{2}  &  =\sum\limits_{1\leq j_{1}<j_{2}\leq6}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \\
P_{1}  &  =\sum\limits_{\substack{1\leq j_{1}\leq6}}\left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\right\vert
\end{align}


\item
\begin{align}
\operatorname{Tr}\left\{  P_{2}\right\}   &  =\binom{6}{2}=\frac{6!}%
{4!2!}=\frac{30}{2}=15\\
\operatorname{Tr}\left\{  P_{1}\right\}   &  =\binom{6}{1}=\frac{6!}%
{5!1!}=\frac{6}{1}=6
\end{align}


\item
\begin{align}
\Gamma_{1}^{2}\left(  P_{1}\right)   &  =P_{2}\\
L_{2}^{1}\left(  P_{2}\right)   &  =\binom{4-1}{1}\frac{1}{1!}P_{1}=3P_{1}%
\end{align}


\item
\begin{align}
\left\langle \left.  \Gamma_{1}^{2}\left(  P_{1}\right)  \right\vert
P_{2}\right\rangle _{\mathcal{F}}  &  =\left\langle \left.  P_{2}\right\vert
P_{2}\right\rangle _{\mathcal{F}}=15\\
\left\langle \left.  P_{2}\right\vert L_{2}^{1}\left(  P_{2}\right)
\right\rangle _{\mathcal{F}}  &  =3\operatorname{Tr}\left\{  P_{2}\right\}
=3\binom{5}{1}=15
\end{align}

\end{enumerate}
\end{example}

\begin{example}
$r=8,p=2,n=6$

\begin{enumerate}
\item
\begin{align}
P_{6}  &  =\sum\limits_{1\leq j_{1}<\cdots<j_{2}\leq8}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{6}}\right\rangle \left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{6}}\right\vert \\
P_{2}  &  =\sum\limits_{1\leq j_{1}<j_{2}\leq6}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert
\end{align}


\item
\begin{align}
\operatorname{Tr}\left\{  P_{6}\right\}   &  =\binom{8}{6}=\frac{8!}%
{6!2!}=\frac{8\times7}{2}=28\\
\operatorname{Tr}\left\{  P_{2}\right\}   &  =\binom{8}{2}=\frac{8!}%
{2!6!}=\frac{8\times7}{2}=28
\end{align}


\item
\begin{align}
\Gamma_{2}^{6}\left(  P_{2}\right)   &  =P_{6}\\
L_{6}^{2}\left(  P_{2}\right)   &  =\binom{8-2}{2}\frac{1}{2!}P_{2}=\binom
{6}{2}\frac{1}{2!}P_{2}=3P_{2}%
\end{align}


\item
\begin{align}
\left\langle \left.  \Gamma_{2}^{6}\left(  P_{1}\right)  \right\vert
P_{6}\right\rangle _{\mathcal{F}}  &  =\left\langle \left.  P_{6}\right\vert
P_{6}\right\rangle _{\mathcal{F}}=15\\
\left\langle \left.  P_{2}\right\vert L_{6}^{2}\left(  P_{2}\right)
\right\rangle _{\mathcal{F}}  &  =3\operatorname{Tr}\left\{  P_{2}\right\}
=3\binom{5}{1}=15
\end{align}

\end{enumerate}
\end{example}

As the bases $\left\{  \left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle
\left\langle \mathbf{\varphi}_{1\cdots n}\right\vert \right\}  $ and $\left\{
\left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots p}\right\vert \right\}  $ are "orthonormal" wrt the
sesquilinear form $\left\langle \left.  {}\right\vert \right\rangle
_{\mathcal{F}}$ on $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\times\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ the matrix
$\mathcal{M}_{\varphi}\left(  L_{n}^{p}\right)  $ and the matrix
representation $\mathcal{R}_{\varphi}\left(  L_{n}^{p}\right)  $ of $L_{n}%
^{p}$ are identical i.e.
\begin{align}
L_{n}^{p}\left(  \left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle
\left\langle \mathbf{\varphi}_{1\cdots n}\right\vert \right)   &  =\left(
\left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots p}\right\vert \right)  \mathcal{R}_{\varphi}\left(
L_{n}^{p}\right) \\
\left\langle \left.  \overset{}{\left\vert \mathbf{\varphi}_{1\cdots
p}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots p}\right\vert
}\right\vert \overset{}{L_{n}^{p}\left(  \left\vert \mathbf{\varphi}_{1\cdots
n}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots n}\right\vert \right)
}\right\rangle _{\mathcal{F}}  &  =\left\langle \left.  \overset{}{\left\vert
\mathbf{\varphi}_{1\cdots p}\right\rangle \left\langle \mathbf{\varphi
}_{1\cdots p}\right\vert }\right\vert \overset{}{\left\vert \mathbf{\varphi
}_{1\cdots p}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots
p}\right\vert }\right\rangle _{\mathcal{F}}\mathcal{R}_{\varphi}\left(
L_{n}^{p}\right)
\end{align}
giving
\begin{equation}
\left\langle \left.  \left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle
\left\langle \mathbf{\varphi}_{1\cdots p}\right\vert \right\vert L_{n}%
^{p}\left(  \left\vert \mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots n}\right\vert \right)  \right\rangle _{\mathcal{F}%
}=\mathcal{M}_{\varphi}\left(  L_{n}^{p}\right)  =\mathcal{R}_{\varphi}\left(
L_{n}^{p}\right)  .
\end{equation}


The matrix elements of the \emph{contraction map} can be expressed in terms of
the matrix elements of the expansion map i.e.%
\begin{equation}
\left\{  \left\langle \left.  \left\vert \mathbf{\varphi}_{1\cdots
p}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots p}\right\vert
\right\vert L_{n}^{p}\left(  \left\vert \mathbf{\varphi}_{1\cdots
n}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots n}\right\vert \right)
\right\rangle \right\}  =\left\{  \left\langle \left.  \Gamma_{p}^{n}\left(
\left\vert \mathbf{\varphi}_{1\cdots p}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots p}\right\vert \right)  \right\vert \left\vert
\mathbf{\varphi}_{1\cdots n}\right\rangle \left\langle \mathbf{\varphi
}_{1\cdots n}\right\vert \right\rangle \right\}
\end{equation}
and%
\begin{gather}
\left(  L_{n}^{p}\right)  _{\left(  j_{1}\cdots j_{p}k_{1}\cdots k_{p}\right)
\left(  h_{1}\cdots h_{n}i_{1}\cdots i_{n}\right)  }=L_{n}^{p}\left(
\left\vert \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\rangle \left\langle
\varphi_{i_{1}}\cdots\varphi_{i_{n}}\right\vert \right)  _{j_{1}\cdots
j_{p}k_{1}\cdots k_{p}}\\
\shortparallel\\
\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{h}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{h}}\right\vert
\right\vert L_{n}^{p}\left(  \left\vert \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\rangle \left\langle \varphi_{i_{1}}\cdots\varphi_{i_{n}}\right\vert
\right)  \right\rangle _{\mathcal{F}}=\left\langle \left.  \Gamma_{p}%
^{n}\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{h}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{h}}\right\vert \right)
\right\vert \left\vert \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\rangle
\left\langle \varphi_{i_{1}}\cdots\varphi_{i_{n}}\right\vert \right\rangle
_{\mathcal{F}}\\
\shortparallel\\
\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\boxtimes P_{n-p}\right\vert \left\vert \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\rangle \left\langle \varphi_{i_{1}}\cdots\varphi_{i_{n}}\right\vert
\right\rangle _{\mathcal{F}}\\
=\sum\limits_{\substack{1\leq l_{h+1}<\cdots<l_{n}\leq r}}\left\langle \left.
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\vert \right\vert \left\vert
\varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\rangle \left\langle \varphi_{i_{1}%
}\cdots\varphi_{i_{n}}\right\vert \right\rangle _{\mathcal{F}}\\
=\sum\limits_{\substack{1\leq l_{h+1}<\cdots<l_{n}\leq r}}\operatorname{Tr}%
\left\{  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}%
}\cdots\varphi_{l_{n}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\vert \left\vert
\varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\rangle \left\langle \varphi_{i_{1}%
}\cdots\varphi_{i_{n}}\right\vert \right\} \\
=\sum\limits_{\substack{1\leq l_{h+1}<\cdots<l_{n}\leq r}}\left\langle \left.
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\vert \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}\left\langle \left.  \varphi_{i_{1}}\cdots\varphi_{i_{n}%
}\right\vert \varphi_{k_{1}}\cdots\varphi_{k_{h}}\varphi_{l_{h+1}}%
\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\\
=\sum\limits_{\substack{1\leq l_{h+1}<\cdots<l_{n}\leq r}}\pi\left(
j_{1}\cdots j_{p}l_{p+1}\cdots l_{n}\right)  \pi\left(  k_{1}\cdots
k_{p}l_{p+1}\cdots l_{n}\right)  \delta_{\left(  j_{1}\cdots j_{p}%
l_{p+1}\cdots l_{n}\right)  \left(  k_{1}\cdots k_{p}l_{p+1}\cdots
l_{n}\right)  },
\end{gather}
where
\begin{equation}
\pi\left(  j_{1},\cdots,j_{p},l_{p+1},\cdots,l_{n}\right)  =\pm1
\end{equation}
is the parity of the sequence $\left\{  j_{1},\cdots,j_{p},l_{p+1}%
,\cdots,l_{n}\right\}  $, \emph{wrt natural order}, giving
\[
L_{n}^{p}\left(  X\right)  _{\left(  h_{1}\cdots h_{p}i_{1}\cdots
i_{p}\right)  }=\sum\limits_{\substack{1\leq h_{1}<\cdots<h_{n}\leq r\\1\leq
i_{1}<\cdots<i_{n}\leq r}}\left(  L_{n}^{p}\right)  _{\left(  h_{1}\cdots
h_{p}i_{1}\cdots i_{p}\right)  \left(  j_{1}\cdots j_{n}k_{1}\cdots
k_{n}\right)  }X_{j_{1}\cdots j_{n}k_{1}\cdots k_{n}},
\]
where
\begin{equation}
\left(  L_{n}^{p}\right)  _{\left(  h_{1}\cdots h_{p}i_{1}\cdots i_{p}\right)
\left(  j_{1}\cdots j_{n}k_{1}\cdots k_{n}\right)  }=\left\langle \left.
\left\vert \varphi_{h_{1}}\cdots\varphi_{h_{p}}\right\rangle \left\langle
\varphi_{i_{1}}\cdots\varphi_{i_{p}}\right\vert \right\vert L_{n}^{p}\left(
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert \right)  \right\rangle
_{\mathcal{F}}.
\end{equation}


\begin{example}
$p=2,n=4,r=5$%
\begin{equation}
\left\vert \varphi_{3}\varphi_{5}\right\rangle \left\langle \varphi_{2}%
\varphi_{3}\right\vert \boxtimes P_{2}=-\left\vert \varphi_{1}\varphi
_{3}\varphi_{4}\varphi_{5}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\varphi_{3}\varphi_{4}\right\vert
\end{equation}

\end{example}

as%
\begin{align}
\left\vert \varphi_{3}\varphi_{5}\right\rangle \left\langle \varphi_{2}%
\varphi_{3}\right\vert \boxtimes P_{2}  &  =\left\vert \varphi_{3}\varphi
_{5}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
\boxtimes\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert +\left\vert
\varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi
_{4}\right\vert +\left\vert \varphi_{1}\varphi_{5}\right\rangle \left\langle
\varphi_{1}\varphi_{5}\right\vert +\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert \right. \\
&  =+\left.  \left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi
_{5}\right\rangle \left\langle \varphi_{2}\varphi_{5}\right\vert +\left\vert
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert +\left\vert \varphi_{3}\varphi_{5}\right\rangle \left\langle
\varphi_{3}\varphi_{5}\right\vert +\left\vert \varphi_{4}\varphi
_{5}\right\rangle \left\langle \varphi_{4}\varphi_{5}\right\vert \right) \\
&  =\left\vert \varphi_{3}\varphi_{5}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert \boxtimes\left(  \left\vert \varphi_{1}\varphi
_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert \right)
=\left\vert \varphi_{3}\varphi_{5}\varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\varphi_{1}\varphi_{4}\right\vert
=-\left\vert \varphi_{1}\varphi_{3}\varphi_{4}\varphi_{5}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right\vert .
\end{align}


\begin{example}
Of contracted operator matrix elements
\begin{align}
&  L_{4}^{2}\left(  X\right)  _{3523}=\left\langle \left.  \left\vert
\varphi_{3}\varphi_{5}\right\rangle \left\langle \varphi_{2}\varphi
_{3}\right\vert \right\vert L_{4}^{2}\left(  X\right)  \right\rangle
_{\mathcal{F}}=\left\langle \left.  \left\vert \varphi_{3}\varphi
_{5}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert \boxtimes
P_{2}\right\vert X\right\rangle _{\mathcal{F}}\\
&  =-\left\langle \left.  \left\vert \varphi_{1}\varphi_{3}\varphi_{4}%
\varphi_{5}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}%
\varphi_{4}\right\vert \right\vert X\right\rangle _{\mathcal{F}}=-\left\langle
\left.  \varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right\vert X\varphi
_{1}\varphi_{3}\varphi_{4}\varphi_{5}\right\rangle _{\mathcal{H}_{\mathcal{F}%
}}\\
&  =-\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{4}\leq5\\1\leq k_{1}%
<\cdots<k_{4}\leq5}}\left\langle \left.  \overset{}{\varphi_{1}\varphi
_{2}\varphi_{3}\varphi_{4}}\right\vert \left\vert \overset{}{\varphi_{j_{1}%
}\cdots\varphi_{j_{4}}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\left\langle
\overset{}{\varphi_{k_{1}}\cdots\varphi_{k_{4}}}\right\vert \varphi_{1}%
\varphi_{3}\varphi_{4}\varphi_{5}\right\rangle _{\mathcal{H}_{\mathcal{F}}%
}X_{j_{1}\cdots j_{4}k_{1}\cdots k_{4}},\\
&  =-X_{\left(  1234\right)  \left(  1345\right)  }=-X_{\left(  \mathbf{1}%
3\mathbf{4}5\right)  \left(  \mathbf{1}23\mathbf{4}\right)  }=X_{\left(
35\mathbf{14}\right)  \left(  23\mathbf{14}\right)  },
\end{align}
which gives
\begin{equation}
L_{4}^{2}\left(  X\right)  _{3523}=-X_{\left(  1234\right)  \left(
1345\right)  }=-X_{\left(  \mathbf{1}3\mathbf{4}5\right)  \left(
\mathbf{1}23\mathbf{4}\right)  }=X_{\left(  35\mathbf{14}\right)  \left(
23\mathbf{14}\right)  }.
\end{equation}

\end{example}

\begin{remark}
The \emph{contraction pairing} is \emph{not on} naturally ordered matrix elements.
\end{remark}

\begin{conjecture}
If $r=6$
\begin{equation}
L_{4}^{2}\left(  X\right)  _{3523}=X_{\left(  35\mathbf{14}\right)  \left(
23\mathbf{14}\right)  }+X_{\left(  35\mathbf{16}\right)  \left(
23\mathbf{16}\right)  }+X_{\left(  35\mathbf{46}\right)  \left(
23\mathbf{46}\right)  }.
\end{equation}

\end{conjecture}

\subparagraph{Partial Traces}

The \emph{Contraction Maps,} $\left\{  \left.  L_{n}^{p}\right\vert 0\leq
p\leq n,0\leq n\leq r\right\}  ,$
\begin{equation}
L_{n}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
\end{equation}
between subspaces of the even subalgebra $\mathcal{B}_{1}\left(
\bigwedge\left(  \mathcal{H}^{1}\right)  \right)  _{e}$ can be identified with
\emph{operator valued} "\emph{partial traces" }%
\begin{equation}
\operatorname{Tr}_{n-p}:\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\rightarrow\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  ,
\end{equation}
i.e
\begin{equation}
L_{n}^{p}\equiv\operatorname{Tr}_{n-p},
\end{equation}
which are defined as
\begin{align}
L_{n}^{p}\left(  X\right)   &  =\operatorname{Tr}_{n-p}\left\{  X\right\}
=\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq
r}}\left\vert \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{p}}}\right\rangle
\left\langle \overset{}{\varphi_{k_{1}}\cdots\varphi_{k_{p}}}\right\vert
\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}%
}\cdots\varphi_{l_{n}}\right\vert X\varphi_{j_{1}}\cdots\varphi_{j_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}\\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\operatorname{Tr}_{n-p}\left\{  X\right\}  _{j_{1}\cdots j_{p}k_{1}\cdots
k_{p}},
\end{align}
where the expansion coefficients are given by
\begin{equation}
\operatorname{Tr}_{n-p}\left\{  X\right\}  _{j_{1}\cdots j_{p}k_{1}\cdots
k_{p}}=\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert X\varphi_{j_{1}}\cdots\varphi_{j_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}.
\end{equation}
The action of the partial traces on ket-bra bases elements is given by the
coefficients
\begin{align}
&  \operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right\}  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}\\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\delta_{\left(
k_{1}\cdots k_{p}l_{p+1}\cdots l_{n}\right)  \left(  g_{1}\cdots g_{n}\right)
}\delta_{\left(  j_{1}\cdots j_{p}l_{p+1}\cdots l_{n}\right)  \left(
h_{1}\cdots h_{n}\right)  },
\end{align}
where
\begin{align}
1  &  \leq g_{1}<\cdots<g_{n}\leq r,1\leq h_{1}<\cdots<h_{n}\leq r\\
1  &  \leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r.
\end{align}


\begin{lemma}
Equivalence of matrix elements of partial traces and of second quantized
operators: The expansion coefficients of the partial traces of Ket-Bra
operators $\left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle
\left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert \in
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \subset\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ are given by
\begin{align}
&  \operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right\}  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}=\operatorname{Tr}%
\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots
a_{k_{1}}\right)  ^{\dagger}\left(  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right)  \right\} \\
&  =\left\langle \left.  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}^{\dagger}%
a_{k_{p}}\cdots a_{k_{1}}\right\vert \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right\rangle =\left\langle \left.  \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert \left(  a_{k_{1}}^{\dagger}\cdots a_{k_{p}%
}^{\dagger}a_{j_{p}}\cdots a_{j_{1}}\right)  \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle .
\end{align}

\end{lemma}

\begin{proof}
\emph{We have shown previously that}
\begin{equation}
a_{j_{1}}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}%
=\Gamma\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{P}}\right\vert \right)
=\sum_{0\leq n\leq\infty}\sum_{1\leq l_{p+1}<\cdots<l_{n}\leq\infty}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}}\cdots\varphi_{l_{n}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}%
\varphi_{l_{p+1}}\cdots\varphi_{l_{n}}\right\vert .
\end{equation}
\emph{The partial trace is defined by}
\begin{align}
&  \operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right\}  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}\\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert \left(  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right)  \varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}%
}\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}},
\end{align}
hence%
\begin{align*}
&  \operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}%
}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)  ^{\dagger}\left\vert
\varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}%
}\cdots\varphi_{h_{n}}\right\vert \right\} \\
&  =\sum\limits_{\substack{1\leq l_{p+1}<\cdots<l_{n}\leq r}}\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{p}}\varphi_{l_{p+1}}\cdots
\varphi_{l_{n}}\right\vert \left(  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right)  \varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{l_{p+1}%
}\cdots\varphi_{l_{n}}\right\rangle _{\mathcal{H}_{\mathcal{F}}}\\
&  =\operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right\}  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}.
\end{align*}

\end{proof}

\begin{corollary}
The contraction map
\begin{equation}
L_{n}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
\end{equation}
is given by
\begin{align}
L_{n}^{p}\left(  X\right)   &  =\operatorname{Tr}_{n-p}\left\{  X\right\}
=\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\operatorname{Tr}_{n-p}\left\{  X\right\}  _{j_{1}\cdots j_{p}k_{1}\cdots
k_{p}}\\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}%
^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  .
\end{align}

\end{corollary}

\begin{remark}
Kernals of contraction maps
\begin{align}
\ker\left\{  L_{n}^{p}\right\}   &  =\left\{  \left.  \operatorname{Tr}%
\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots
a_{k_{1}}\right)  ^{\dagger}X\right\}  =\left\langle \left.  a_{j_{1}%
}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right\vert
X\right\rangle =0\right\vert \right. \\
&  \left.  \overset{}{X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
,1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r}\right\}
\end{align}

\end{remark}

\begin{example}
$n=6,p=6$%
\begin{equation}
\ker\left\{  L_{6}^{6}\right\}  =\left\{  \operatorname{Tr}\left\{  \left(
a_{j_{1}}^{\dagger}\cdots a_{j_{6}}^{\dagger}a_{k_{6}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  =0\right.  X\in\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  ,\left.  \overset{}{1\leq j_{1}<\cdots<j_{p}\leq r,1\leq
k_{1}<\cdots<k_{p}\leq r}\right\}  =\left\{  0\right\}
\end{equation}

\end{example}

\begin{example}
$n=6,p=4$%
\begin{equation}
\ker\left\{  L_{6}^{4}\right\}  =\left\{  \operatorname{Tr}\left\{  \left(
a_{j_{1}}^{\dagger}\cdots a_{j_{4}}^{\dagger}a_{k_{4}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  =0\right.  X\in\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  ,\left.  \overset{}{1\leq j_{1}<\cdots<j_{p}\leq r,1\leq
k_{1}<\cdots<k_{p}\leq r}\right\}
\end{equation}

\end{example}

\begin{example}
$n=6,p=3$%
\begin{equation}
\ker\left\{  L_{6}^{3}\right\}  =\left\{  \operatorname{Tr}\left\{  \left(
a_{j_{1}}^{\dagger}\cdots a_{j_{3}}^{\dagger}a_{k_{3}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  =0\right.  X\in\mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  ,\left.  \overset{}{1\leq j_{1}<\cdots<j_{p}\leq r,1\leq
k_{1}<\cdots<k_{p}\leq r}\right\}
\end{equation}

\end{example}

\begin{remark}%
\begin{align}
L_{n}^{n}\left(  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle
\left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert \right)
_{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}  &  =\operatorname{Tr}_{0}\left\{
\left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle \left\langle
\varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert \right\}  _{j_{1}\cdots
j_{p}k_{1}\cdots k_{p}}\\
&  =\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}%
}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)  ^{\dagger}\left\vert
\varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}%
}\cdots\varphi_{h_{n}}\right\vert \right\}  .
\end{align}

\end{remark}

\begin{example}%
\begin{equation}
L_{n}^{2}\left(  X\right)  =\operatorname{Tr}_{n-2}\left\{  X\right\}
=\sum\limits_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \operatorname{Tr}_{n-2}\left\{
X\right\}  _{j_{1}j_{2}k_{1}k_{2}}=\sum\limits_{\substack{1\leq j_{1}%
<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}\right)  ^{\dagger}X\right\}  .
\end{equation}

\end{example}

\begin{example}%
\begin{equation}
L_{n}^{1}\left(  X\right)  =\operatorname{Tr}_{n-1}\left\{  X\right\}
=\sum\limits_{\substack{1\leq j_{1}\leq r\\1\leq k_{1}\leq r}}\left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert
\operatorname{Tr}_{n-1}\left\{  X\right\}  _{j_{1}k_{1}}=\sum
\limits_{\substack{1\leq j_{1}\leq r\\1\leq k_{1}\leq r}}\left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}a_{k_{1}}\right)
^{\dagger}X\right\}  .
\end{equation}

\end{example}

\begin{example}%
\begin{equation}
L_{n}^{0}\left(  X\right)  =\operatorname{Tr}_{n}\left\{  X\right\}
=\operatorname{Tr}\left\{  X\right\}  .
\end{equation}

\end{example}

\begin{example}
One has the iterations
\begin{align}
L_{6}^{3}  &  =L_{4}^{3}\circ L_{5}^{4}\circ L_{6}^{5}\\
L_{6}^{2}  &  =L_{3}^{2}\circ L_{4}^{3}\circ L_{5}^{4}\circ L_{6}^{5}\\
L_{6}^{2}  &  =L_{3}^{2}\circ L_{6}^{3}%
\end{align}
hence
\begin{equation}
\ker\left\{  L_{6}^{2}\right\}  \supset\ker\left\{  L_{6}^{3}\right\}
\end{equation}
as
\begin{equation}
L_{6}^{3}\left(  X\right)  =0\Rightarrow L_{6}^{2}\left(  X\right)  =L_{3}%
^{2}\left(  L_{6}^{3}\left(  X\right)  \right)  =0
\end{equation}
so
\begin{equation}
X\in\ker\left\{  L_{6}^{3}\right\}  \Rightarrow X\in\ker\left\{  L_{6}%
^{2}\right\}
\end{equation}
and
\begin{equation}
\ker\left\{  L_{6}^{2}\right\}  \supset\ker\left\{  L_{6}^{3}\right\}  .
\end{equation}

\end{example}

\begin{remark}%
\begin{equation}
\ker\left\{  L_{6}^{0}\right\}  \supset\ker\left\{  L_{6}^{1}\right\}
\supset\ker\left\{  L_{6}^{2}\right\}  \supset\ker\left\{  L_{6}^{3}\right\}
\supset\ker\left\{  L_{6}^{4}\right\}  \supset\ker\left\{  L_{6}^{5}\right\}
\supset\ker\left\{  L_{6}^{6}\right\}
\end{equation}


and $\ker\left\{  L_{n}^{0}\right\}  $ is the largest kernal.
\end{remark}

\begin{theorem}%
\begin{gather}
\frame{$\operatorname{Tr}\left\{  \left(  a_j^\dagger{}_1\cdots a_j_p^\dagger
{}a_k_p{}\cdots a_k_1{}\right)  ^\dagger X\right\}  \,=\,0$},X\in
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,1\leq j_{1}<\cdots<j_{q}\leq
r,1\leq k_{1}<\cdots<k_{q}\leq r\\
\Downarrow\\
\frame{$\operatorname{Tr}\left\{  \left(  a_j^\dagger{}_1\cdots a_j_q^\dagger
{}a_k_q{}\cdots a_k_1{}\right)  ^\dagger X\right\}  \,=\,0$},X\in
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,1\leq j_{1}<\cdots<j_{p}\leq
r,1\leq k_{1}<\cdots<k_{p}\leq r\\
n\geq\frame{$p>q$}\geq0
\end{gather}
i.e.
\begin{equation}
\ker\left\{  L_{n}^{q}\right\}  \supset\ker\left\{  L_{n}^{p}\right\}  ;n\geq
p>q\geq0.
\end{equation}

\end{theorem}

\begin{example}%
\begin{gather}
\frame{$\operatorname{Tr}\left\{  \left(  a_j{}_1^\dagger a_j_2^\dagger
{}a_k_2{}a_k_1{}\right)  ^\dagger X\right\}  \,=\,0$},X\in\mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  ,1\leq j_{1}<j_{2}\leq r,1\leq k_{1}%
<k_{2}\leq r\\
\Downarrow\\
\frame{$\operatorname{Tr}\left\{  \left(  a_j_1^\dagger a_k_1\right)  ^\dagger
X\right\}  \,=0\,$},X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,1\leq
j_{1}\leq r,1\leq k_{1}\leq r.
\end{gather}

\end{example}

\begin{proof}
Comes from the iterated nature of $L_{n}^{p}.$
\end{proof}

\begin{corollary}%
\begin{gather}
\ker\left\{  L_{n}^{p-1}\right\}  \ominus\ker\left\{  L_{n}^{p}\right\} \\
\left\Vert {}\right. \\
\left\{  \operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}%
}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  \neq
0,X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,1\leq j_{1}<\cdots
<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r\right. \\
\left.  \operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{p-1}}^{\dagger}a_{k_{p-1}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}
=0,X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  ,1\leq j_{1}%
<\cdots<j_{p-1}\leq r,1\leq k_{1}<\cdots<k_{p-1}\leq r\right\}  .
\end{gather}

\end{corollary}

\begin{remark}
When $n=0$ one has
\begin{equation}
a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}%
}=I_{\mathcal{H}_{F}}=\Gamma\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)
\end{equation}
giving%
\begin{align}
&  L_{n}^{0}\left(  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert
\right)  =\operatorname{Tr}_{n}\left\{  \left\vert \varphi_{g_{1}}%
\cdots\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots
\varphi_{h_{n}}\right\vert \right\} \\
&  =\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}%
}\right\vert \right)  I_{\mathcal{H}_{F}}\right\}  =\operatorname{Tr}\left\{
\left(  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle
\left\langle \varphi_{h_{1}}\cdots\varphi_{h_{n}}\right\vert \right)
\right\}  .
\end{align}

\end{remark}

\begin{theorem}
Contraction-Expansion Theorem: Let $X\in\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}$ then
\begin{gather}
\operatorname{Tr}_{n-p}\left\{  X\right\}  _{j_{1}\cdots j_{p}k_{1}\cdots
k_{p}}=\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\} \\
=\operatorname{Tr}\left\{  \left(  \Gamma\left(  \left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{p}}\right\vert \right)  \right)  ^{\dagger}X\right\}
=\left\langle \left.  \Gamma\left(  \left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}%
}\right\vert \right)  \right\vert X\right\rangle \\
=\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\right\vert L\left(  X\right)  \right\rangle =\operatorname{Tr}\left\{
\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \right)
^{\dagger}L\left(  X\right)  \right\}  =\operatorname{Tr}\left\{  \left(
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert \right)  ^{\dagger}\binom
{n}{p}L_{n}^{p}\left(  X\right)  \right\} \\
\quad1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r;\quad0\leq
p\leq n.\quad
\end{gather}

\end{theorem}

\begin{definition}
Diagonal space
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{D\Phi
}=\operatorname*{linspan}\left\{  \left.  \left\vert \Phi_{j}\right\rangle
\left\langle \Phi_{j}\right\vert \right\vert 1\leq j\leq2^{r}\right\}  ,
\end{equation}
where $\left\{  \left.  \left\vert \Phi_{j}\right\rangle \right\vert 1\leq
j\leq2^{r}\right\}  $ is a conb for $\mathcal{H}_{\mathcal{F}}.$
\end{definition}

\begin{definition}
Off diagonal space%
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{OD\Phi
}=\operatorname*{linspan}\left\{  \left.  \left\vert \Phi_{j}\right\rangle
\left\langle \Phi_{k}\right\vert \right\vert 1\leq j\neq k\leq2^{r}\right\}  ,
\end{equation}
where $\left\{  \left.  \left\vert \Phi_{j}\right\rangle \right\vert 1\leq
j\leq2^{r}\right\}  $ is a conb for $\mathcal{H}_{\mathcal{F}}.$
\end{definition}

\begin{definition}
$\left(  p,q\right)  -$ bihomogeneous Ket-Bra's (partial isometries)%
\begin{equation}
\left\{  \left\vert \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{q}}\right\vert
1\leq j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{q}\leq r;\quad0\leq p\neq
q\leq n\right.  \right\}  .
\end{equation}

\end{definition}

\begin{definition}
$p-$ homogeneous Ket-Bra's (partial isometries)
\begin{equation}
\left\{  \left\vert \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
1\leq j_{1}\neq k_{1}<\cdots<j_{p}\neq k_{q}\leq r;\,0\leq p\leq n\right.
\right\}  .
\end{equation}

\end{definition}

\begin{definition}
$l-$ Difference Spaces%
\begin{gather}
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{ld}=\operatorname*{linspan}%
\left\{  \left\vert \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
1\leq j_{1},k_{1}<\cdots<j_{p},k_{q}\leq r;\,0\leq p\leq n.\right.  \right\}
\\
\left(  j_{1},\cdots,j_{p}\right)  \cap\left(  k_{1},\cdots,k_{p}\right)
=\left\{  j_{\alpha_{1}},\cdots,j_{\alpha_{l}}\right\} \\
0\leq l\leq n.
\end{gather}

\end{definition}

\begin{remark}
$\left\{  \left.  \left\vert \Phi_{j}\right\rangle \left\langle \Phi
_{j}\right\vert \right\vert 1\leq j\leq2^{r}\right\}  $ are orthogonal
projectors $\equiv$ self adjoint idempotents that form a resolution of the
identity (or resolutions of approximate identities).
\end{remark}

\begin{remark}
$\left\{  \left.  \left\vert \Phi_{j}\right\rangle \left\langle \Phi
_{k}\right\vert \right\vert 1\leq j\neq k\leq2^{r}\right\}  $ are nilpotent
partial isometries.
\end{remark}

\begin{corollary}
Diagonal elements are mapped to diagonal elements and non diagonal elements
are mapped to non diagonal elements by the contraction maps.
\end{corollary}

\begin{corollary}%
\begin{equation}
L_{n}^{p}\left(  \left\vert \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\rangle
\left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n}}\right\vert \right)
=\operatorname{Tr}_{n-p}\left\{  \left\vert \varphi_{g_{1}}\cdots
\varphi_{g_{n}}\right\rangle \left\langle \varphi_{g_{1}}\cdots\varphi_{g_{n}%
}\right\vert \right\}  =\binom{n}{p}^{-1}\sum_{\left\{  h_{1},\cdots
,h_{p}\right\}  \subset\left\{  g_{1},\cdots,g_{n}\right\}  }\left\vert
\varphi_{h_{1}}\cdots\varphi_{h_{p}}\right\rangle \left\langle \varphi_{h_{1}%
}\cdots\varphi_{h_{p}}\right\vert .
\end{equation}

\end{corollary}

\begin{example}%
\begin{equation}
L_{2}^{0}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  =\operatorname{Tr}_{0}\left\{
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert \right\}  =\operatorname{Tr}\left\{  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\}  =\operatorname{Tr}\left\{  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
I_{\mathcal{H}_{\mathcal{F}}}\right\}  .
\end{equation}

\end{example}

\begin{example}%
\begin{gather}
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  =2L_{2}^{1}\left(  \left\vert
\varphi_{1}\wedge\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\wedge\varphi_{2}\right\vert \right)  =2L_{2}^{1}\left(  \frac{1}{4}\left(
\left\vert \left(  \varphi_{1}\otimes\varphi_{2}-\varphi_{2}\otimes\varphi
_{1}\right)  \right\rangle \left\langle \varphi_{1}\otimes\varphi_{2}%
-\varphi_{2}\otimes\varphi_{1}\right\vert \right)  \right) \\
=\frac{1}{2}L_{2}^{1}\left(  \left(  \left\vert \varphi_{1}\otimes\varphi
_{2}\right\rangle \left\langle \varphi_{1}\otimes\varphi_{2}\right\vert
-\left\vert \left(  \varphi_{1}\otimes\varphi_{2}\right)  \right\rangle
\left\langle \varphi_{2}\otimes\varphi_{1}\right\vert -\left\vert \varphi
_{2}\otimes\varphi_{1}\right\rangle \left\langle \varphi_{1}\otimes\varphi
_{2}\right\vert +\left\vert \varphi_{2}\otimes\varphi_{1}\right\rangle
\left\langle \varphi_{2}\otimes\varphi_{1}\right\vert \right)  \right) \\
=\frac{1}{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right)  ,
\end{gather}
where%
\begin{align}
n!  &  =2\\
\frac{1}{\left(  n!\right)  ^{2}}  &  =\frac{1}{4}.
\end{align}

\end{example}

\begin{example}
$n=2,r=4:$Non diagonal elements (nilpotent partial isometries). The ordered
indices are
\begin{equation}
\left(  12\right)  ,\left(  13\right)  ,\left(  14\right)  ,\left(  23\right)
,\left(  24\right)  ,\left(  34\right)
\end{equation}
giving
\begin{align}
&  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi
_{1}\varphi_{3}\right\vert ,\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert ,\left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
,\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert ,\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert ,\\
&  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert ,\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
,\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert ,\left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert ,\\
&  \left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert ,\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
,\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert ,\left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert ,\\
&  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert ,\left\vert \varphi_{2}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
,\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert ,\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert ,\\
&  \left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert ,\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
,\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert ,\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert ,\\
&  \left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert ,\left\vert \varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
,\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert ,\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert ,\left(  \mathbf{30}\right)  .
\end{align}

\end{example}

\begin{example}
$n=1,r=4:$Non diagonal elements (nilpotent partial isometries). The ordered
indices are
\begin{equation}
\left(  12\right)  ,\left(  13\right)  ,\left(  14\right)  ,\left(  23\right)
,\left(  24\right)  ,\left(  34\right)
\end{equation}%
\begin{equation}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{3}\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{4}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{3}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{4}\right\vert
,\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{4}\right\vert
,\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{3}\right\vert
,\left(  \mathbf{12}\right)  .
\end{equation}

\end{example}

\begin{example}
The partial isometries$,\left\{  \left\vert \varphi_{1}\varphi_{2}%
\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert ,\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right\}  $ are contained in the Kernal of $L_{2}^{1}$

\begin{enumerate}
\item
\begin{align}
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right)   &  =\sum_{1\leq j\leq k\leq4}%
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right)  _{jk}\left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert \\
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right)  _{jk}  &  =\operatorname{Tr}%
_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j}^{\dagger}a_{k}\right)
^{\dagger}\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right\}  =\left\langle \left.  \varphi
_{1}\varphi_{2}\right\vert a_{k}^{\dagger}a_{j}\varphi_{1}\varphi
_{4}\right\rangle \\
\left\langle \left.  \varphi_{1}\varphi_{2}\right\vert a_{k}^{\dagger}%
a_{j}\varphi_{1}\varphi_{4}\right\rangle  &  =1=L_{2}^{1}\left(  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{4}\right\vert \right)  _{24}\text{ if }k=2\text{ and }j=4,\text{ }0\text{
otherwise,}%
\end{align}
hence
\begin{equation}
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right)  =\left\vert \varphi_{2}%
\right\rangle \left\langle \varphi_{4}\right\vert .
\end{equation}


\item and%
\begin{align}
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right)   &  =\sum_{1\leq j\leq k\leq4}%
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right)  _{jk}\left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert \\
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right)  _{jk}  &  =\operatorname{Tr}%
_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j}^{\dagger}a_{k}\right)
^{\dagger}\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right\}  =\left\langle \left.  \varphi
_{3}\varphi_{4}\right\vert a_{k}^{\dagger}a_{j}\varphi_{2}\varphi
_{3}\right\rangle \\
\left\langle \left.  \varphi_{3}\varphi_{4}\right\vert a_{k}^{\dagger}%
a_{j}\varphi_{2}\varphi_{3}\right\rangle  &  =-1=L_{2}^{1}\left(  \left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right)  _{23}\text{ if }k=4\text{ and }j=2\text{ otherwise,}%
\end{align}
hence
\begin{equation}
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right)  =-\left\vert \varphi_{2}%
\right\rangle \left\langle \varphi_{4}\right\vert .
\end{equation}
This implies that
\begin{equation}
L_{2}^{1}\left(  \left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}%
\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert
\right)  \right)  =0,
\end{equation}
i,e,
\begin{equation}
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \in\ker\left\{  L_{2}%
^{1}\right\}  ,
\end{equation}
and hence%
\begin{equation}
\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j}^{\dagger
}a_{k}\right)  ^{\dagger}\left(  \left\vert \varphi_{1}\varphi_{2}%
\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right)  \right\}  =\left\langle \left.  \varphi_{1}%
\varphi_{4}\right\vert a_{k}^{\dagger}a_{j}\varphi_{1}\varphi_{2}\right\rangle
+\left\langle \left.  \varphi_{3}\varphi_{4}\right\vert a_{k}^{\dagger}%
a_{j}\varphi_{2}\varphi_{3}\right\rangle =0,\,1\leq j,k\leq4.
\end{equation}

\end{enumerate}

\begin{remark}
Only the partial isometries $\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert $ and $\left\vert \varphi
_{2}\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert $
are considered as $\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{4}\varphi_{4}\right\vert $ and $\left\vert \varphi_{2}\varphi
_{2}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert $ are zero so
the preimage of $\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{4}\right\vert $ is the $\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{4}\right\vert ,\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right\}  .$
\end{remark}

\begin{remark}
The opposite combination does not belong to $\ker\left\{  L_{2}^{1}\right\}  $
as
\begin{equation}
\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j}^{\dagger
}a_{k}\right)  ^{\dagger}\left(  \left\vert \varphi_{1}\varphi_{2}%
\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert -\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right)  \right\}  =\left\langle \left.  \varphi_{1}%
\varphi_{4}\right\vert a_{k}^{\dagger}a_{j}\varphi_{1}\varphi_{2}\right\rangle
-\left\langle \left.  \varphi_{3}\varphi_{4}\right\vert a_{k}^{\dagger}%
a_{j}\varphi_{2}\varphi_{3}\right\rangle \neq0,\,1\leq j,k\leq4.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  L_{2}^{1}\right)  ^{-1}\left(  \left\vert \varphi_{2}\right\rangle
\left\langle \varphi_{4}\right\vert \right)  =\operatorname*{linspan}\left\{
\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert -\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
\right\}  .\left(  \mathbf{2}\right)
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \left(  L_{2}^{1}\right)  ^{-1}\left(  \left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{4}\right\vert \right)  \right)
^{c}\supset\operatorname*{linspan}\left\{  \left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
-\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{3}\varphi_{4}\right\vert \right)  ,\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right)  \right\}  .
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j}^{\dagger
}a_{k}\right)  ^{\dagger}\left(  \left\vert \varphi_{l_{1}}\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{j_{2}}\right\vert
-\left\vert \varphi_{j_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{j_{2}}\varphi_{l_{2}}\right\vert \right)  \right\}  =0,\,1\leq
j,k\leq4,l_{1}\neq l_{2}\neq j_{1}\neq j_{2};1\leq l_{1}\neq l_{2}\leq4,1\leq
j_{1}\neq j_{2}\leq4.
\end{equation}

\end{lemma}

\begin{remark}%
\begin{align}
\ker\left\{  L_{2}^{1}\right\}   &  \supset\operatorname*{linspan}\left\{
\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert -\left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert -\left\vert \varphi_{1}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert -\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\right. \\
&  \left.  \left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert -\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert \right)
,\left(  \mathbf{6}\right)  \right\}  .
\end{align}
and
\begin{align}
\ker\left\{  L_{2}^{1}\right\}   &  \supset\operatorname*{linspan}\left\{
\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert -\left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert -\left\vert \varphi_{1}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert -\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\right. \\
&  \left.  \left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
,\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert -\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert \right)
,\left(  \mathbf{6}\right)  \right\}  ^{\dagger}.
\end{align}

\end{remark}
\end{example}

\begin{example}
Diagonal elements $r=4,n=2,p=1.$ The contraction map $L_{2}^{1}$ maps diagonal
elements to diagonal elements
\begin{equation}
L_{2}^{1}:\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi}%
\rightarrow\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{D\Phi},
\end{equation}
where
\begin{align}
\dim\left\{  \ker\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{D\Phi}\right\}  \right\}   &  =6\\
\dim\left\{  \ker\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)
_{D\Phi}\right\}  \right\}   &  =4
\end{align}
giving
\begin{equation}
\dim\left\{  \ker\left\{  \left.  L_{2}^{1}\right\vert _{\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi}}\right\}  \right\}  =2.
\end{equation}
The values of the contraction map are
\begin{align}
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert
\varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert
\varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert
\varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert
\varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert
\varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert +\left\vert
\varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)  .
\end{align}
The number of differences of these maps is
\begin{equation}
\binom{6}{2}=15=\dim\left\{  \ker\left\{  \left.  L_{2}^{0}\right\vert
_{\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi}}\right\}  \right\}
.
\end{equation}
The values on \emph{a basis} of $\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{D\Phi}$ is given by
\begin{align}
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  -L_{2}^{1}\left(  \left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right)  -\frac{1}%
{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert \right)  =\frac{1}{2}\left(  \left\vert \varphi_{2}%
\right\rangle \left\langle \varphi_{2}\right\vert -\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert \right)  -L_{2}^{1}\left(  \left\vert
\varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi
_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)  -\frac{1}%
{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right)  =\frac{1}{2}\left(  \left\vert \varphi_{3}%
\right\rangle \left\langle \varphi_{3}\right\vert -\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert \right)  -L_{2}^{1}\left(  \left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi
_{3}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)  -\frac{1}%
{2}\left(  \left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert \right)  -L_{2}^{1}\left(  \left\vert
\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi
_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)  -\frac{1}%
{2}\left(  \left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right)  =\frac{1}{2}\left(  \left\vert \varphi_{3}%
\right\rangle \left\langle \varphi_{3}\right\vert -\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right) \\
L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert \right)  -L_{2}^{1}\left(  \left\vert
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)  -\frac{1}%
{2}\left(  \left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right)  =\frac{1}{2}\left(  \left\vert \varphi_{2}%
\right\rangle \left\langle \varphi_{2}\right\vert -\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)
\end{align}
and one can observe

\begin{enumerate}
\item
\begin{align}
&  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert -\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
\right)  =L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert -\left\vert \varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert
\right) \\
&  \Rightarrow L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert -\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
-\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right)  =0
\end{align}


\item
\begin{align}
&  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
\right)  =L_{2}^{1}\left(  \left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert -\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
\right) \\
&  \Rightarrow L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
-\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert \right)  =0,
\end{align}


which shows that $\ker\left\{  \left.  L_{2}^{1}\right\vert _{\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi}}\right\}  $ is given by
\begin{align}
\ker\left\{  \left.  L_{2}^{1}\right\vert _{\operatorname{Diag}\left\{
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}  }\right\}   &
=\operatorname*{linspan}\left\{  \left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert -\left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert -\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
\right. \\
&  \left.  \left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{1}\varphi
_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert -\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi
_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert \right)  ,\left(  \mathbf{2}\right)
\right\}  .
\end{align}

\end{enumerate}

\begin{remark}%
\begin{gather}
\alpha\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert -\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert -\left\vert
\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi
_{4}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \right) \\
\left.  +\right.  \beta\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
-\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert \right)  =0\\
\Rightarrow\alpha=\beta=0
\end{gather}
and thus are linearly independent as $\left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert ,\left\vert
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert ,\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert $ and $\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert $ only occur
in one of the terms. However this two vectors are not orthogonal wrt the
HS\ inner product as
\begin{align}
&  \operatorname{Tr}\left\{  \left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert -\left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert -\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
\right. \\
&  \left.  \left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{1}\varphi
_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert -\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi
_{3}\right\vert +\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert \right)  \right\} \\
&  =-\operatorname{Tr}\left\{  \left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert \left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
\right\}  -\operatorname{Tr}\left\{  \left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert \left\vert
\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi
_{4}\right\vert \right\}  =-2.
\end{align}

\end{remark}

\begin{remark}
Each basis element $\varphi_{j},$ $1\leq j\leq4$ appears twice in each of the
kernal basis elements.
\end{remark}

\begin{remark}
Under permutations $\sigma\in S_{4}$ the basis $\left\{  \left(  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert -\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert -\left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert +\left\vert
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \right)  \right.  \left.  \left(  \left\vert \varphi
_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
-\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{4}\right\vert -\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
\right)  ,\left(  \mathbf{2}\right)  \right\}  $ produce equivalent basis
i.e.
\begin{equation}
\sigma:\left(  1,2,3,4\right)  \rightarrow\left(  \sigma\left(  1\right)
,\sigma\left(  2\right)  ,\sigma\left(  3\right)  ,\sigma\left(  4\right)
\right)  .
\end{equation}

\end{remark}
\end{example}

\begin{example}
The diagonal (orthogonal projectors $\equiv$ self adjoint idempotents) and off
diagonal elements (nilpotent partial isometries) of $\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  $ are given by
\begin{gather}
\operatorname{Diag}\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
\right\}  =\operatorname*{linspan}\left\{  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert ,\left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert ,\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert ,\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert ,\left\vert
\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi
_{4}\right\vert ,\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert ,\left(  \mathbf{6}\right)  \right\} \\
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{ND\Phi}=\left\{
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi}\right\}  ^{c},
\end{gather}
the contraction map $L_{2}^{1}$ has the property
\begin{align}
L_{2}^{1}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi
}\rightarrow\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{D\Phi}\\
L_{2}^{1}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{ND\Phi
}\rightarrow\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{ND\Phi},
\end{align}
hence the dimenson of the kernals restricted diagonal and non diagonal
elements are%
\begin{align}
\dim\left\{  \ker\left\{  \left.  L_{2}^{1}\right\vert _{\mathcal{B}%
_{1}\left(  \mathcal{H}^{2}\right)  _{D\Phi}}\right\}  \right\}   &  =2\\
\dim\left\{  \ker\left\{  \left.  L_{2}^{1}\right\vert _{\mathcal{B}%
_{1}\left(  \mathcal{H}^{1}\right)  _{ND\Phi}}\right\}  \right\}   &  =18.
\end{align}

\end{example}

\begin{example}
The action of the contraction map on the diagonal elements when $r=4,n=2,p=1$%
\begin{gather}
\operatorname{Tr}\left\{  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right\}  =1\\
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  =\frac{1}{2}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right) \\
\operatorname{Tr}\left\{  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
\right\}  =\operatorname{Tr}\left\{  \frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right)  \right\}  =1.
\end{gather}

\end{example}

\begin{example}
$r=4,n=3,p=2$%
\begin{align}
&  L_{3}^{2}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right)  =6L_{3}%
^{2}\left(  \left\vert \varphi_{1}\wedge\varphi_{2}\wedge\varphi
_{3}\right\rangle \left\langle \varphi_{1}\wedge\varphi_{2}\wedge\varphi
_{3}\right\vert \right) \\
&  =6L_{3}^{2}\left(  \frac{1}{36}\left\vert \left(  \varphi_{1}\otimes
\varphi_{2}\otimes\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi
_{3}-\varphi_{1}\otimes\varphi_{3}\otimes\varphi_{2}+\varphi_{3}\otimes
\varphi_{2}\otimes\varphi_{1}-\varphi_{2}\otimes\varphi_{3}\otimes\varphi
_{1}+\varphi_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\rangle
\right. \\
&  \left.  \left\langle \left(  \varphi_{1}\otimes\varphi_{2}\otimes
\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi_{3}-\varphi_{1}%
\otimes\varphi_{3}\otimes\varphi_{2}+\varphi_{3}\otimes\varphi_{2}%
\otimes\varphi_{1}-\varphi_{2}\otimes\varphi_{3}\otimes\varphi_{1}+\varphi
_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\vert \right) \\
&  =\frac{1}{6}L_{3}^{2}\left(  \left\vert \left(  \varphi_{1}\otimes
\varphi_{2}\otimes\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi
_{3}\right)  \right\rangle \left\langle \left(  \varphi_{1}\otimes\varphi
_{2}\otimes\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi_{3}\right)
\right\vert \right. \\
&  +\left\vert \left(  \varphi_{1}\otimes\varphi_{3}\otimes\varphi_{2}%
-\varphi_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\rangle
\left\langle \left(  \varphi_{1}\otimes\varphi_{3}\otimes\varphi_{2}%
-\varphi_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\vert \\
&  \left.  +\left\vert \left(  \varphi_{2}\otimes\varphi_{3}\otimes\varphi
_{1}-\varphi_{3}\otimes\varphi_{2}\otimes\varphi_{1}\right)  \right\rangle
\left\langle \left(  \varphi_{2}\otimes\varphi_{3}\otimes\varphi_{1}%
-\varphi_{3}\otimes\varphi_{2}\otimes\varphi_{1}\right)  \right\vert \right)
\\
&  =\frac{1}{6}\left(  \left\vert \left(  \varphi_{1}\otimes\varphi
_{2}-\varphi_{2}\otimes\varphi_{1}\right)  \right\rangle \left\langle \left(
\varphi_{1}\otimes\varphi_{2}-\varphi_{2}\otimes\varphi_{1}\right)
\right\vert +\left\vert \left(  \varphi_{1}\otimes\varphi_{3}-\varphi
_{3}\otimes\varphi_{1}\right)  \right\rangle \left\langle \left(  \varphi
_{1}\otimes\varphi_{3}-\varphi_{3}\otimes\varphi_{12}\right)  \right\vert
\right. \\
&  +\left.  \left.  \left\vert \left(  \varphi_{2}\otimes\varphi_{3}%
-\varphi_{3}\otimes\varphi_{2}\right)  \right\rangle \left\langle \left(
\varphi_{2}\otimes\varphi_{3}-\varphi_{3}\otimes\varphi_{2}\right)
\right\vert \right)  \right) \\
&  =\frac{4}{6}\left(  \left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle
\left\langle \varphi_{1}\wedge\varphi_{2}\right\vert +\left\vert \varphi
_{1}\wedge\varphi_{3}\right\rangle \left\langle \varphi_{1}\wedge\varphi
_{3}\right\vert +\left\vert \varphi_{2}\wedge\varphi_{3}\right\rangle
\left\langle \varphi_{2}\wedge\varphi_{3}\right\vert \right) \\
&  =\frac{4}{6}\frac{1}{2}\left(  \left\vert \varphi_{1}\varphi_{2}%
\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert \right)  =\frac{1}{3}\left(  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert +\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert \right)
\end{align}%
\begin{equation}
\binom{n}{p}^{-1}=\binom{3}{2}^{-1}=\frac{1}{3}%
\end{equation}

\end{example}

\begin{example}
$r=4,n=3,p=2$%
\begin{align}
P_{3}  &  =\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert +\left\vert
\varphi_{1}\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{1}\varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{3}\varphi
_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert \\
L_{3}^{2}\left(  P_{3}\right)   &  =\frac{1}{3}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
+\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi
_{1}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert \right)  +\frac{1}{3}\left(
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
\right) \\
&  +\frac{1}{3}\left(  \left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{3}\varphi_{4}\right\vert \right)  +\frac{1}{3}\left(  \left\vert \varphi
_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
+\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right) \\
&  =\frac{2}{3}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
+\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{3}\varphi_{4}\right\vert \right)  =\frac{2}{3}P_{2}%
\end{align}
and%
\begin{equation}
\frac{2}{3}\operatorname{Tr}\left\{  P_{2}\right\}  =\frac{2}{3}\binom{4}%
{2}=\frac{2}{3}6=4=\operatorname{Tr}\left\{  P_{3}\right\}  =\binom{4}{3}.
\end{equation}
Note:%
\begin{equation}
\binom{n}{p}^{-1}\binom{r-p}{n-p}=\binom{3}{2}^{-1}\binom{2}{1}=\frac{1}%
{3}2=\frac{2}{3}%
\end{equation}

\end{example}

\begin{example}
$r=4,n=2,p=1$%
\begin{align}
&  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right)  =2L_{2}^{1}\left(
\left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle \left\langle \varphi
_{1}\wedge\varphi_{2}\right\vert \right) \\
&  =2L_{2}^{1}\left(  \frac{1}{4}\left\vert \left(  \varphi_{1}\otimes
\varphi_{2}-\varphi_{2}\otimes\varphi_{1}\right)  \right\rangle \left\langle
\left(  \varphi_{1}\otimes\varphi_{2}-\varphi_{2}\otimes\varphi_{1}\right)
\right\vert \right) \\
&  =\frac{1}{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right)  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right)  .
\end{align}

\end{example}

\begin{example}
$r=4,n=2,p=1$%
\begin{gather}
\operatorname{Tr}\left\{  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right\}  =1\\
\operatorname{Tr}\left\{  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
\right\}  =\operatorname{Tr}\left\{  \frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right)  \right\}  =1.
\end{gather}

\end{example}

\begin{example}
$r=4,n=2,p=1$%
\begin{align}
P_{2}  &  =\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert +\left\vert
\varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi
_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi
_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert +\left\vert
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{3}\varphi
_{4}\right\vert \\
L_{2}^{1}\left(  P_{2}\right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right)  +\frac{1}%
{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert \right)  +\frac{1}{2}\left(  \left\vert \varphi_{1}%
\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)  +\frac{1}%
{2}\left(  \left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert \right) \\
&  +\frac{1}{2}\left(  \left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle
\varphi_{4}\right\vert \right)  +\frac{1}{2}\left(  \left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert +\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right) \\
&  =\frac{3}{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle
\varphi_{4}\right\vert \right)  =\frac{3}{2}P_{1}.
\end{align}
Note:%
\begin{equation}
\binom{n}{p}^{-1}\binom{r-p}{n-p}=\binom{2}{1}^{-1}\binom{4-1}{2-1}=\frac
{1}{2}\binom{3}{1}=\frac{3}{2}.
\end{equation}

\end{example}

\begin{example}
$r=4,n=2,p=1$%
\begin{equation}
\operatorname{Tr}\left\{  P_{2}\right\}  =\binom{4}{2}=6=\frac{3}%
{2}\operatorname{Tr}\left\{  P_{1}\right\}  =\frac{3}{2}\binom{4}{1}.
\end{equation}

\end{example}

\begin{example}
$r=4,n=3,p=1$%
\begin{align}
&  L_{3}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \right)  =6L_{3}%
^{1}\left(  \left\vert \varphi_{1}\wedge\varphi_{2}\wedge\varphi
_{3}\right\rangle \left\langle \varphi_{1}\wedge\varphi_{2}\wedge\varphi
_{3}\right\vert \right) \\
&  =6L_{3}^{1}\left(  \frac{1}{36}\left\vert \left(  \varphi_{1}\otimes
\varphi_{2}\otimes\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi
_{3}-\varphi_{1}\otimes\varphi_{3}\otimes\varphi_{2}+\varphi_{3}\otimes
\varphi_{2}\otimes\varphi_{1}-\varphi_{2}\otimes\varphi_{3}\otimes\varphi
_{1}+\varphi_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\rangle
\right. \\
&  \left.  \left\langle \left(  \varphi_{1}\otimes\varphi_{2}\otimes
\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi_{3}-\varphi_{1}%
\otimes\varphi_{3}\otimes\varphi_{2}+\varphi_{3}\otimes\varphi_{2}%
\otimes\varphi_{1}-\varphi_{2}\otimes\varphi_{3}\otimes\varphi_{1}+\varphi
_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\vert \right) \\
&  =\frac{1}{6}L_{3}^{1}\left(  \left\vert \left(  \varphi_{1}\otimes
\varphi_{2}\otimes\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi
_{3}\right)  \right\rangle \left\langle \left(  \varphi_{1}\otimes\varphi
_{2}\otimes\varphi_{3}-\varphi_{2}\otimes\varphi_{1}\otimes\varphi_{3}\right)
\right\vert \right. \\
&  +\left\vert \left(  \varphi_{1}\otimes\varphi_{3}\otimes\varphi_{2}%
-\varphi_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\rangle
\left\langle \left(  \varphi_{1}\otimes\varphi_{3}\otimes\varphi_{2}%
-\varphi_{3}\otimes\varphi_{1}\otimes\varphi_{2}\right)  \right\vert \\
&  \left.  +\left\vert \left(  \varphi_{2}\otimes\varphi_{3}\otimes\varphi
_{1}-\varphi_{3}\otimes\varphi_{2}\otimes\varphi_{1}\right)  \right\rangle
\left\langle \left(  \varphi_{2}\otimes\varphi_{3}\otimes\varphi_{1}%
-\varphi_{3}\otimes\varphi_{2}\otimes\varphi_{1}\right)  \right\vert \right)
\\
&  =\frac{1}{6}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert +\left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert \right)  =\frac{1}{3}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)  .
\end{align}

\end{example}

\begin{example}
$r=4,n=3,p=1$%
\begin{gather}
\operatorname{Tr}\left\{  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right\}  =1\\
\operatorname{Tr}\left\{  L_{3}^{1}\left(  \left\vert \varphi_{1}\varphi
_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi
_{3}\right\vert \right)  \right\}  =\operatorname{Tr}\left\{  \frac{1}%
{3}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert \right)  \right\}  =1.
\end{gather}

\end{example}

\begin{example}
$r=4,n=3,p=1$%
\begin{align}
P_{3}  &  =\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert +\left\vert
\varphi_{1}\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{1}\varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{3}\varphi
_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert \\
L_{3}^{1}\left(  P_{3}\right)   &  =\frac{1}{3}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)  +\frac{1}%
{3}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right)  +\frac{1}{3}\left(  \left\vert \varphi_{1}%
\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert +\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)  +\\
&  \frac{1}{3}\left(  \left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert +\left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle
\varphi_{4}\right\vert \right)  =\frac{3}{3}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert +\left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)  =P_{1}%
\end{align}
and%
\begin{equation}
\operatorname{Tr}\left\{  P_{1}\right\}  =\binom{4}{1}=4=\operatorname{Tr}%
\left\{  P_{3}\right\}  =\binom{4}{3}.
\end{equation}
Note:%
\begin{equation}
\binom{n}{p}^{-1}\binom{r-p}{n-p}=\binom{3}{1}^{-1}\binom{4-1}{3-1}=\frac
{1}{3}\binom{3}{2}=\frac{3}{3}.
\end{equation}

\end{example}

\begin{example}
$r=4,n=3,p=2$%
\begin{gather}
\operatorname{Tr}\left\{  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right\}  =1\\
\operatorname{Tr}\left\{  L_{3}^{2}\left(  \left\vert \varphi_{1}\varphi
_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi
_{3}\right\vert \right)  \right\}  =\operatorname{Tr}\left\{  \frac{1}%
{3}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert +\left\vert
\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi
_{3}\right\vert \right)  \right\}  =1.
\end{gather}

\end{example}

\begin{example}
$r=4,n=3,p=2$%
\begin{align}
P_{3}  &  =\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert +\left\vert
\varphi_{1}\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{1}\varphi_{3}%
\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{3}\varphi
_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert \\
L_{3}^{2}\left(  P_{3}\right)   &  =\frac{1}{3}\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
+\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi
_{1}\varphi_{3}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert \right)  +\frac{1}{3}\left(
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert +\left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
\right) \\
&  +\frac{1}{3}\left(  \left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{3}\varphi_{4}\right\vert \right)  +\frac{1}{3}\left(  \left\vert \varphi
_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert
+\left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi
_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right) \\
&  =\frac{2}{3}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
+\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi
_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert +\left\vert \varphi_{2}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
+\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi
_{3}\varphi_{4}\right\vert \right)  =\frac{2}{3}P_{2}%
\end{align}
and%
\begin{equation}
\frac{2}{3}\operatorname{Tr}\left\{  P_{2}\right\}  =\frac{2}{3}\binom{4}%
{2}=\frac{2}{3}6=4=\operatorname{Tr}\left\{  P_{3}\right\}  =\binom{4}{3}.
\end{equation}
Note:%
\begin{equation}
\binom{n}{p}^{-1}\binom{r-p}{n-p}=\binom{3}{2}^{-1}\binom{4-2}{3-2}=\frac
{1}{3}\binom{2}{1}=\frac{2}{3}.
\end{equation}

\end{example}

\begin{lemma}%
\begin{equation}
L_{n}^{p}\left(  P_{n}\right)  =\operatorname{Tr}_{n-p}\left\{  P_{n}\right\}
=\binom{n}{p}^{-1}\binom{r-p}{n-p}P_{p}.
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{equation}
\operatorname{Tr}\left\{  P_{n}\right\}  =\binom{n}{p}^{-1}\binom{r-p}%
{n-p}\operatorname{Tr}\left\{  P_{p}\right\}  .
\end{equation}

\end{corollary}

\begin{example}%
\begin{align*}
\left\langle \left.  \Gamma_{p}^{n}\left(  P_{p}\right)  \right\vert
P_{n}\right\rangle  &  =\left\langle \left.  P_{n}\right\vert P_{n}%
\right\rangle =\left\langle \left.  P_{p}\right\vert L_{n}^{p}\left(
P_{n}\right)  \right\rangle =\binom{n}{p}^{-1}\binom{r-p}{n-p}\left\langle
\left.  P_{p}\right\vert P_{p}\right\rangle \\
\left\langle \left.  P_{n}\right\vert P_{n}\right\rangle  &  =\binom{r}{n}\\
\left\langle \left.  P_{p}\right\vert P_{p}\right\rangle  &  =\binom{r}{p}\\
\binom{n}{p}^{-1}\binom{r-p}{n-p}\binom{r}{p}  &  =\frac{p!\left(  n-p\right)
!}{n!}\frac{\left(  r-p\right)  !}{\left(  r-p-n+p\right)  \left(  n-p\right)
!}\frac{r!}{\left(  r-p\right)  !p!}=\frac{r!}{n!\left(  r-n\right)  !}.
\end{align*}

\end{example}

\paragraph{Kernals of Contraction Maps}

Recall%
\begin{align}
L_{n}^{p}\left(  X\right)   &  =\operatorname{Tr}_{n-p}\left\{  X\right\}
=\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\operatorname{Tr}_{n-p}\left\{  X\right\}  _{j_{1}\cdots j_{p}k_{1}\cdots
k_{p}}\\
&  =\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq k_{1}%
<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{p}}\right\vert
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}%
^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  .
\end{align}


The kernal, $\ker\left\{  L_{n}^{p}\right\}  $ of $L_{n}^{p}$ is characterized
by
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  =\left\{  \left.  \overset{}{X}\in
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\vert \operatorname{Tr}%
_{n-p}\left\{  X\right\}  _{j_{1}\cdots j_{p}k_{1}\cdots k_{p}}=0;1\leq
j_{1}<\cdots<j_{p}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r\right\}  .
\end{equation}


\begin{lemma}%
\begin{equation}
\ker\left\{  L_{n}^{p}\right\}  =\left\{  \left.  \overset{}{X}\in
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\vert \operatorname{Tr}%
\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots
a_{k_{1}}\right)  ^{\dagger}X\right\}  =0;1\leq j_{1}<\cdots<j_{p}\leq r,1\leq
k_{1}<\cdots<k_{p}\leq r\right\}  .
\end{equation}

\end{lemma}

\begin{proof}
If $X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  $ then
\begin{equation}
L_{n}^{p}\left(  X\right)  =\sum\limits_{\substack{1\leq j_{1}<\cdots
<j_{p}\leq r\\1\leq k_{1}<\cdots<k_{p}\leq r}}\left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{p}}\right\vert \operatorname{Tr}\left\{  \left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{p}}^{\dagger}a_{k_{p}}\cdots a_{k_{1}}\right)
^{\dagger}X\right\}  .
\end{equation}


\begin{corollary}%
\begin{equation}
\ker\left\{  L_{n}^{n-1}\right\}  =\left\{  \left.  \overset{}{X}%
\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\vert
\operatorname{Tr}\left\{  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{n-1}%
}^{\dagger}a_{k_{n-1}}\cdots a_{k_{1}}\right)  ^{\dagger}X\right\}  =0;1\leq
j_{1}<\cdots<j_{n-1}\leq r,1\leq k_{1}<\cdots<k_{p}\leq r\right\}  .
\end{equation}

\end{corollary}
\end{proof}

\begin{definition}
Resolution of the identity or projector defined by $N$-particle subspaces
\begin{equation}
\left.  I_{\mathcal{F}}\right\vert _{\mathcal{H}^{N}}=P_{N}=\sum_{1\leq
j\leq\binom{r}{N}}\left\vert \Phi_{j}\right\rangle \left\langle \Phi
_{j}\right\vert =\sum_{1\leq j\leq\binom{r}{N}}P_{\Phi_{j}}=\sum\limits_{1\leq
j_{1}<\cdots<j_{N}\leq r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
=\sum\limits_{1\leq j_{1}<\cdots<j_{N}\leq r}P_{\varphi j_{1}\cdots j_{N}},
\end{equation}
where $\left\{  \left.  P_{\Phi_{j}}=\left\vert \Phi_{j}\right\rangle
\left\langle \Phi_{j}\right\vert \right\vert 1\leq j\leq\binom{r}{N}\right\}
$ and $\left\{  \left.  P_{\varphi j_{1}\cdots j_{N}}=\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{N}}\right\vert \right\vert 1\leq j_{1}<\cdots<j_{N}\leq
r\right\}  $ are sets of mutually orthogonal projectors.
\end{definition}

\begin{remark}
Resolutions of the identity form Projection Valued Measures (PVM's).
\end{remark}

\begin{remark}
$\left\{  \left.  P_{\Phi_{j}}=\left\vert \Phi_{j}\right\rangle \left\langle
\Phi_{j}\right\vert \right\vert 1\leq j\leq\binom{r}{N}\right\}  $ and
$\left\{  \left.  P_{\varphi j_{1}\cdots j_{N}}=\left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\vert \right\vert 1\leq j_{1}<\cdots<j_{N}\leq r\right\}
$ are primitive$\equiv$atomic idempotents.
\end{remark}

\begin{definition}
The family of partial isometries $\left\{  \left.  u_{\Phi_{jk}}=\left\vert
\Phi_{j}\right\rangle \left\langle \Phi_{k}\right\vert \right\vert 1\leq j\neq
k\leq\binom{r}{N}\right\}  $ and $\left\{  \left.  u_{\varphi j_{1}\cdots
j_{N}k_{1}\cdots k_{N}}=\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{N}}\right\vert
\right\vert 1\leq j_{1}<\cdots<j_{N}\leq r;1\leq k_{1}<\cdots<k_{N}\leq
r\right\}  $ are primitive partial isometries.
\end{definition}

\begin{remark}
The projectors $\left\vert \Phi_{j}\right\rangle \left\langle \Phi
_{j}\right\vert $ and $\left\vert \Phi_{k}\right\rangle \left\langle \Phi
_{k}\right\vert $ are equivalent i.e.
\begin{equation}
\left\vert \Phi_{j}\right\rangle \left\langle \Phi_{j}\right\vert
\sim\left\vert \Phi_{k}\right\rangle \left\langle \Phi_{k}\right\vert
\end{equation}
as
\begin{equation}
\left\vert \Phi_{j}\right\rangle \left\langle \Phi_{j}\right\vert =\left\vert
\Phi_{j}\right\rangle \left\langle \Phi_{k}\right\vert \left\vert \Phi
_{k}\right\rangle \left\langle \Phi_{j}\right\vert =\left\vert \Phi
_{j}\right\rangle \left\langle \Phi_{k}\right\vert \left(  \left\vert \Phi
_{j}\right\rangle \left\langle \Phi_{k}\right\vert \right)  ^{\dagger}%
\end{equation}
and
\begin{equation}
\left\vert \Phi_{k}\right\rangle \left\langle \Phi_{k}\right\vert =\left\vert
\Phi_{k}\right\rangle \left\langle \Phi_{j}\right\vert \left\vert \Phi
_{j}\right\rangle \left\langle \Phi_{k}\right\vert =\left(  \left\vert
\Phi_{j}\right\rangle \left\langle \Phi_{k}\right\vert \right)  ^{\dagger
}\left\vert \Phi_{j}\right\rangle \left\langle \Phi_{k}\right\vert .
\end{equation}

\end{remark}

\begin{definition}
$\left(  N-p\right)  $-Difference space produced by Ket-Bra operators
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\varphi pd}  &
=\operatorname*{linspan}\left\{  \left.  \left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{p}}\varphi_{j_{p+1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\varphi_{k_{p+1}}%
\cdots\varphi_{j_{kN}}\right\vert \right\vert 1\leq j_{1}<\cdots<j_{p}\leq
r;\right. \\
&  \left.  1\leq j_{p+1}<\cdots<j_{N}\leq r\neq1\leq k_{p+1}<\cdots<k_{N}\leq
r\right\} \\
&  =\operatorname*{linspan}\left\{  \left.  \left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{N-p}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{N-p}}\right\vert \boxtimes\left\vert \varphi_{j_{N-p+1}}%
\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N-p+1}}%
\cdots\varphi_{j_{kN}}\right\vert \right\vert 1\leq j_{1}<\cdots<j_{p}\leq
r;\right. \\
&  \left.  1\leq j_{N-p+1}<\cdots<j_{N}\leq r\neq1\leq k_{N-p+1}<\cdots
<k_{N}\leq r\right\} \\
&  =\operatorname*{linspan}\left\{  \left.  P_{\varphi j_{1}\cdots j_{N-p}%
}\boxtimes u_{\varphi j_{N-p+1}\cdots j_{N}k_{N-p+1}\cdots k_{N}}\right\vert
1\leq j_{1}<\cdots<j_{j_{N-p}}\leq r;\right. \\
&  \left.  1\leq j_{N-p+1}<\cdots<j_{N}\leq r\neq1\leq k_{N-p+1}<\cdots
<k_{N}\leq r\right\} \\
&  =\operatorname*{linspan}\left\{  \left.  P_{\varphi j_{1}}\boxtimes
\cdots\boxtimes P_{\varphi j_{N-p}}\boxtimes u_{\varphi j_{N-p+1}k_{N}%
}\boxtimes\cdots\boxtimes u_{\varphi j_{N}k_{N}}\right\vert 1\leq j_{1}%
<\cdots<j_{j_{N-p}}\leq r;\right. \\
&  \left.  1\leq j_{N-p+1}<\cdots<j_{N}\leq r\neq1\leq k_{N-p+1}<\cdots
<k_{N}\leq r\right\}  .
\end{align}

\end{definition}

\begin{lemma}
Expansion of partial isometries%
\begin{equation}
\Gamma_{P}^{N}\left(  u_{\varphi j_{N-p+1}k_{N}}\boxtimes\cdots\boxtimes
u_{\varphi j_{N}k_{N}}\right)  =\sum_{1\leq j_{1}<\cdots<j_{p}\leq r}\left(
P_{\varphi j_{1}}\boxtimes\cdots\boxtimes P_{\varphi j_{N-p}}\right)
\boxtimes u_{\varphi j_{N-p+1}k_{N}}\boxtimes\cdots\boxtimes u_{\varphi
j_{N}k_{N}}.
\end{equation}

\end{lemma}

\begin{lemma}
\emph{The spaces }$B\left(  \mathcal{H}^{n}\right)  _{\varphi pd}$\emph{
properely \underline{\emph{includes}} the range of the expansion mappings }
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\varphi pd}\supset
\operatorname*{linspan}\left\{  \left.  \Gamma_{P}^{N}\left(  u_{\varphi
j_{N-p+1}k_{N}}\boxtimes\cdots\boxtimes u_{\varphi j_{N}k_{N}}\right)
\right\vert 1\leq j_{N-p+1}<\cdots<j_{N}\leq r\frame{$\neq$}1\leq
k_{N-p+1}<\cdots<k_{N}\leq r\right\}  ,
\end{equation}


i.e.
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{\varphi pd}\supset
\operatorname*{linspan}\left\{  \left.  \Gamma_{P}^{N}\left(  \left\vert
j_{N-p+1}\cdots j_{N}\right\rangle \left\langle k_{N-p+1}\cdots k_{N}%
\right\vert \right)  \right\vert 1\leq j_{N-p+1}<\cdots<j_{N}\leq
r\frame{$\neq$}1\leq k_{N-p+1}<\cdots<k_{N}\leq r\right\}  .
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\varphi pd}\quad\bot
\quad\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\varphi p^{\prime}%
d}\text{ if }p\neq p^{\prime}.
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{equation}
\left\langle \left.  \Gamma_{p}^{n}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{p}\right)  _{\varphi pd}\right)  \right\vert \mathcal{B}%
_{1}\left(  \mathcal{H}^{n}\right)  _{\varphi p^{\prime}d}\right\rangle
=\left\langle \left.  \mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  _{\varphi
pd}\right\vert L_{n}^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
_{\varphi p^{\prime}d}\right)  \right\rangle =0
\end{equation}

\end{corollary}

\begin{lemma}%
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{B}_{00}\left(  \mathcal{H}^{n}\right)  _{\varphi pd}.
\end{equation}

\end{lemma}

\begin{remark}
The spaces $\mathcal{B}\left(  \mathcal{H}^{n}\right)  ,\mathcal{B}_{1}\left(
\mathcal{H}^{n}\right)  $ and $\mathcal{B}_{2}\left(  \mathcal{H}^{n}\right)
$ are obtained by closures in the respective norm topologies of $\mathcal{B}%
_{00}\left(  \mathcal{H}^{n}\right)  $.
\end{remark}

\begin{remark}
This decomposition is not $U\left(  r\right)  $-invariant. What groups is it
invariant to?
\end{remark}

\begin{example}
$r=4,N=2,p=0,N-p=2$%
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\varphi2d}  &
=\operatorname*{linspan}\left\{  \left.  P_{\varphi j_{1}\cdots j_{0}%
}\boxtimes u_{\varphi j_{1}j_{2}k_{1}k_{2}}\right\vert 1\leq j_{1}%
<\cdots<j_{j_{0}}\neq1\leq k_{1}<k_{2}\leq4\right. \\
&  \left.  1\leq j_{1}<j_{2}\leq r\neq1\leq k_{1}<k_{2}\leq4\right\} \\
&  =\operatorname*{linspan}\left\{  \left.  u_{\varphi j_{1}j_{2}k_{1}k_{2}%
}\right\vert 1\leq j_{1}<j_{2}\leq4\neq1\leq k_{1}<k_{2}\leq4\right\}  .
\end{align}

\end{example}

\begin{example}
$r=4,N=2,p=1,N-p=1$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\varphi1d}%
=\operatorname*{linspan}\left\{  \left.  P_{\varphi j_{1}}\boxtimes u_{\varphi
j_{2}k_{2}}\right\vert 1\leq j_{1}\leq4;1\leq j_{2}\leq4\neq1\leq k_{2}%
\leq4\right\}
\end{equation}

\end{example}

\begin{example}
$r=4,N=2,p=2,N-p=0$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\varphi0d}%
=\operatorname*{linspan}\left\{  \left.  P_{\varphi j_{1}j_{2}}\right\vert
1\leq j_{1}<j_{2}\leq4\right\}
\end{equation}

\end{example}

\begin{example}%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\varphi0d}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\varphi1d}\oplus\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{\varphi2d}%
\end{equation}

\end{example}

\begin{remark}
$\boxtimes$ is a commutative product in $\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}$ i.e.
\begin{equation}
A\boxtimes B=B\boxtimes A.
\end{equation}

\end{remark}

\begin{example}
Factorization wrt $\boxtimes$
\begin{align}
\left\vert 12\right\rangle \left\langle 34\right\vert  &  =\left\vert
1\right\rangle \left\langle 3\right\vert \boxtimes\left\vert 2\right\rangle
\left\langle 4\right\vert =\left\vert 2\right\rangle \left\langle 4\right\vert
\boxtimes\left\vert 1\right\rangle \left\langle 3\right\vert \\
\left\vert 13\right\rangle \left\langle 24\right\vert  &  =\left\vert
1\right\rangle \left\langle 2\right\vert \boxtimes\left\vert 3\right\rangle
\left\langle 4\right\vert =\left\vert 3\right\rangle \left\langle 4\right\vert
\boxtimes\left\vert 1\right\rangle \left\langle 2\right\vert \\
\left\vert 14\right\rangle \left\langle 23\right\vert  &  =\left\vert
1\right\rangle \left\langle 2\right\vert \boxtimes\left\vert 4\right\rangle
\left\langle 3\right\vert =\left\vert 4\right\rangle \left\langle 3\right\vert
\boxtimes\left\vert 1\right\rangle \left\langle 2\right\vert \\
\left\vert 23\right\rangle \left\langle 14\right\vert  &  =\left\vert
2\right\rangle \left\langle 1\right\vert \boxtimes\left\vert 3\right\rangle
\left\langle 4\right\vert =\left\vert 3\right\rangle \left\langle 4\right\vert
\boxtimes\left\vert 2\right\rangle \left\langle 1\right\vert \\
\left\vert 24\right\rangle \left\langle 13\right\vert  &  =\left\vert
2\right\rangle \left\langle 1\right\vert \boxtimes\left\vert 4\right\rangle
\left\langle 3\right\vert =\left\vert 4\right\rangle \left\langle 3\right\vert
\boxtimes\left\vert 2\right\rangle \left\langle 1\right\vert \\
\left\vert 34\right\rangle \left\langle 12\right\vert  &  =\left\vert
3\right\rangle \left\langle 1\right\vert \boxtimes\left\vert 4\right\rangle
\left\langle 2\right\vert =\left\vert 4\right\rangle \left\langle 2\right\vert
\boxtimes\left\vert 3\right\rangle \left\langle 1\right\vert \\
\left\vert 34\right\rangle \left\langle 12\right\vert  &  =-\left\vert
3\right\rangle \left\langle 2\right\vert \boxtimes\left\vert 4\right\rangle
\left\langle 1\right\vert =-\left\vert 4\right\rangle \left\langle
1\right\vert \boxtimes\left\vert 3\right\rangle \left\langle 2\right\vert .
\end{align}

\end{example}

\begin{remark}
Factorization wrt $\boxtimes$ is not unique e.g.
\[
\left\vert 12\right\rangle \left\langle 34\right\vert =\left\vert
1\right\rangle \left\langle 3\right\vert \boxtimes\left\vert 2\right\rangle
\left\langle 4\right\vert =-\left\vert 1\right\rangle \left\langle
4\right\vert \boxtimes\left\vert 2\right\rangle \left\langle 3\right\vert
=-\left\vert 2\right\rangle \left\langle 3\right\vert \boxtimes\left\vert
1\right\rangle \left\langle 4\right\vert =\left\vert 2\right\rangle
\left\langle 4\right\vert \boxtimes\left\vert 1\right\rangle \left\langle
3\right\vert .
\]

\end{remark}

\begin{example}
$r=4,n=1,2,\quad\dim\left\{  \mathcal{H}^{2}\right\}  =\binom{4}{2}%
=6,\quad\dim\left\{  \mathcal{H}^{1}\right\}  =\binom{4}{1}=4,\quad
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}
=36,\quad\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}
=16.$

\begin{definition}
Two Difference Spaces = Zero common spaces $N=2,p=0,N-p=2$%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{\varphi2d}%
=\operatorname*{linspan}\left\{  \left.  \phi\boxtimes u_{\varphi j_{1}%
j_{2}k_{1}k_{2}}\right\vert 1\leq j_{1}<j_{2}\leq4\neq1\leq k_{1}<k_{2}%
\leq4\right\}  ,
\end{equation}
which gives
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\varphi2d}%
=\operatorname*{linspan}\left\{  \left\vert 12\right\rangle \left\langle
34\right\vert ,\left\vert 13\right\rangle \left\langle 24\right\vert
,\left\vert 14\right\rangle \left\langle 23\right\vert ,\left\vert
23\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 13\right\vert ,\left\vert 34\right\rangle \left\langle
12\right\vert ,\left(  \mathbf{6}\right)  \right\}  ,
\end{equation}
and
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{2d}=\phi.
\end{equation}

\end{definition}
\end{example}

\begin{remark}%
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2d}\Leftrightarrow
X=\lambda_{3412}\left\vert 12\right\rangle \left\langle 34\right\vert
+\lambda_{2413}\left\vert 13\right\rangle \left\langle 24\right\vert
+\lambda_{2314}\left\vert 14\right\rangle \left\langle 23\right\vert
+\lambda_{1423}\left\vert 23\right\rangle \left\langle 14\right\vert
+\lambda_{1324}\left\vert 24\right\rangle \left\langle 13\right\vert
+\lambda_{1234}\left\vert 34\right\rangle \left\langle 12\right\vert .
\end{equation}

\end{remark}

\begin{lemma}
Connection between kernals of the contraction map and difference spaces%
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2d}\nRightarrow
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}X\right\}  =0;\,1\leq j_{1}<j_{2}\leq4,1\leq k_{1}<k_{2}\leq4,
\end{equation}
\emph{i.e.}
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2d}\nRightarrow
X\notin\ker\left\{  L_{2}^{2}\right\}  .
\end{equation}

\end{lemma}

\begin{example}
\begin{definition}
\begin{lemma}
\begin{proof}%
\begin{align}
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}\left\vert ab\right\rangle \left\langle cd\right\vert \right\}   &
=\left\langle \left.  \left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}\right)  ^{\dagger}\right\vert \left\vert ab\right\rangle
\left\langle cd\right\vert \right\rangle \\
&  =\left\langle \left.  \overset{}{cd}\right\vert a_{j_{1}}^{\dagger}%
a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}ab\right\rangle =\left\langle \left.
\overset{}{a_{j_{2}}a_{j_{1}}cd}\right\vert a_{k_{2}}a_{k_{1}}ab\right\rangle
\end{align}
Let
\begin{align}
j_{1}  &  =c,\\
j_{1}  &  =d,\\
k_{1}  &  =a,\\
k_{2}  &  =b
\end{align}
then
\begin{equation}
\operatorname{Tr}\left\{  a_{c}^{\dagger}a_{d}^{\dagger}a_{b}a_{a}\left\vert
ab\right\rangle \left\langle cd\right\vert \right\}  =1.
\end{equation}

\end{proof}
\end{lemma}

\begin{lemma}
Zero difference spaces are in the kernal of the contraction map:
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2d}\Rightarrow
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{k_{1}}X\right\}  =0;\,1\leq
j_{1}\leq4,1\leq k_{1}\leq4
\end{equation}
i.e.
\begin{equation}
X\in\ker\left\{  L_{2}^{1}\right\}  .
\end{equation}

\end{lemma}
\end{definition}
\end{example}

\begin{proof}
\begin{description}
$\Rightarrow$ If $X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{2d}$
one has
\begin{equation}
X=\lambda_{3412}\left\vert 12\right\rangle \left\langle 34\right\vert
+\lambda_{2413}\left\vert 13\right\rangle \left\langle 24\right\vert
+\lambda_{2314}\left\vert 14\right\rangle \left\langle 23\right\vert
+\lambda_{1423}\left\vert 23\right\rangle \left\langle 14\right\vert
+\lambda_{1324}\left\vert 24\right\rangle \left\langle 13\right\vert
+\lambda_{1234}\left\vert 34\right\rangle \left\langle 12\right\vert
\end{equation}
then
\begin{equation}
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{k_{1}}X\right\}  =0;\,1\leq
j_{1}\leq4,1\leq k_{1}\leq4.
\end{equation}

\end{description}
\end{proof}

\begin{remark}
The converse is not true i.e.
\begin{equation}
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{k_{1}}X\right\}  =0;\,1\leq
j_{1}\leq4,1\leq k_{1}\leq4\nRightarrow X\in\ker\left\{  L_{2}^{1}\right\}  .
\end{equation}

\end{remark}

\begin{example}
One Difference Spaces = One in common Space

Thus
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\varphi1d}\Rightarrow
X=\sum_{\substack{1\leq j\leq4\\1\leq j_{1},k_{1}\neq j\leq4}}\lambda
_{jj_{1}jj_{2}}\left\vert jj_{1}\right\rangle \left\langle jk_{1}\right\vert .
\end{equation}

\end{example}

\begin{example}
Of a vector in the one difference space
\begin{equation}
X=\left\vert 12\right\rangle \left\langle 13\right\vert +\left\vert
12\right\rangle \left\langle 23\right\vert +\left\vert 23\right\rangle
\left\langle 13\right\vert +\left\vert 34\right\rangle \left\langle
14\right\vert
\end{equation}

\end{example}

\begin{example}
\begin{lemma}
One can always find a basis such that
\begin{equation}
X=\sum_{\substack{1\leq j_{1}=j_{3}\text{ or }j_{3}\leq4\\1\leq j_{2}\neq
j_{3}\text{ or }j_{3}\leq4}}\lambda_{j_{1}j_{2}j_{3}j_{4}}\left\vert
j_{1}j_{2}\right\rangle \left\langle j_{3}j_{4}\right\vert
\end{equation}
and%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{\varphi1d}%
=\operatorname*{linspan}\left\{  \left\vert 1\right\rangle \left\langle
2\right\vert ,\left\vert 1\right\rangle \left\langle 3\right\vert ,\left\vert
1\right\rangle \left\langle 4\right\vert ,\left\vert 2\right\rangle
\left\langle 1\right\vert ,\left\vert 2\right\rangle \left\langle 3\right\vert
,\left\vert 2\right\rangle \left\langle 4\right\vert ,\left\vert
3\right\rangle \left\langle 1\right\vert ,\left\vert 3\right\rangle
\left\langle 2\right\vert ,\left\vert 4\right\rangle \left\langle 4\right\vert
,\left\vert 4\right\rangle \left\langle 1\right\vert ,\left\vert
4\right\rangle \left\langle 2\right\vert ,\left\vert 4\right\rangle
\left\langle 3\right\vert ,\left(  \mathbf{12}\right)  \right\}  .
\end{equation}

\end{lemma}
\end{example}

\begin{example}
Zero Difference Spaces = Two in common space

\begin{definition}
\begin{enumerate}
\item[a]
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{0d}=\operatorname*{linspan}%
\left\{  \left\vert 12\right\rangle \left\langle 12\right\vert ,\left\vert
13\right\rangle \left\langle 13\right\vert ,\left\vert 14\right\rangle
\left\langle 14\right\vert ,\left\vert 23\right\rangle \left\langle
23\right\vert ,\left\vert 24\right\rangle \left\langle 24\right\vert
,\left\vert 34\right\rangle \left\langle 34\right\vert ,\left(  \mathbf{6}%
\right)  \right\}
\end{equation}
Thus
\begin{equation}
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  _{\varphi0d}\Rightarrow
X=\sum_{1\leq j\leq4}\lambda_{jj}\left\vert j\right\rangle \left\langle
j\right\vert .
\end{equation}


\item[b]
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  _{0d}=\operatorname*{linspan}%
\left\{  \left\vert 1\right\rangle \left\langle 1\right\vert ,\left\vert
2\right\rangle \left\langle 2\right\vert ,\left\vert 3\right\rangle
\left\langle 3\right\vert ,\left\vert 4\right\rangle \left\langle 4\right\vert
,\left(  \mathbf{4}\right)  \right\}  .
\end{equation}


\item[c]
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  _{0d}=\operatorname*{linspan}%
\left\{  \left\vert 1\right\rangle \left\langle 1\right\vert +\left\vert
2\right\rangle \left\langle 2\right\vert +\left\vert 3\right\rangle
\left\langle 3\right\vert +\left\vert 4\right\rangle \left\langle 4\right\vert
,\left(  \mathbf{1}\right)  \right\}  .
\end{equation}

\end{enumerate}
\end{definition}

\begin{remark}
These subspaces are invariant wrt the adjoint operation.
\end{remark}

\begin{remark}
What characterizes the spaces $\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
_{\varphi kd},0\leq n\leq2?$ They are not invariant to $U\left(
\mathcal{H}^{n}\right)  .$ The property of \emph{number of differences} is not
preserved under liner combination.
\end{remark}
\end{example}

\begin{example}
$r=4,n=1,2,\quad\dim\left\{  \mathcal{H}^{2}\right\}  =\binom{4}{2}%
=6,\quad\dim\left\{  \mathcal{H}^{1}\right\}  =\binom{4}{1}=4,\quad
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}
=36,\quad\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}
=12$The space $\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $ is generated
by
\begin{align}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)   &  =\operatorname*{linspan}%
\left\{  \overset{}{\left\vert 12\right\rangle \left\langle 34\right\vert
,\left\vert 13\right\rangle \left\langle 24\right\vert ,\left\vert
14\right\rangle \left\langle 23\right\vert ,\left\vert 23\right\rangle
\left\langle 14\right\vert },\left\vert 24\right\rangle \left\langle
13\right\vert ,\left\vert 34\right\rangle \left\langle 12\right\vert ,\right.
\left(  \mathbf{6}\right) \\
&  \left\vert 12\right\rangle \left\langle 13\right\vert ,\left\vert
12\right\rangle \left\langle 14\right\vert ,\left\vert 12\right\rangle
\left\langle 23\right\vert ,\left\vert 12\right\rangle \left\langle
24\right\vert ,\left\vert 13\right\rangle \left\langle 12\right\vert
,\left\vert 13\right\rangle \left\langle 14\right\vert ,\left\vert
13\right\rangle \left\langle 23\right\vert ,\left\vert 13\right\rangle
\left\langle 34\right\vert ,\\
&  \left\vert 14\right\rangle \left\langle 12\right\vert ,\left\vert
14\right\rangle \left\langle 13\right\vert ,\left\vert 14\right\rangle
\left\langle 24\right\vert ,\left\vert 14\right\rangle \left\langle
34\right\vert ,\left\vert 23\right\rangle \left\langle 12\right\vert
,\left\vert 23\right\rangle \left\langle 13\right\vert ,\left\vert
23\right\rangle \left\langle 24\right\vert ,\left\vert 23\right\rangle
\left\langle 34\right\vert ,\\
&  \left\vert 24\right\rangle \left\langle 12\right\vert ,\left\vert
24\right\rangle \left\langle 14\right\vert ,\left\vert 24\right\rangle
\left\langle 23\right\vert ,\left\vert 24\right\rangle \left\langle
34\right\vert ,\left\vert 34\right\rangle \left\langle 13\right\vert
,\left\vert 34\right\rangle \left\langle 14\right\vert ,\left\vert
34\right\rangle \left\langle 23\right\vert ,\left\vert 34\right\rangle
\left\langle 24\right\vert ,\left(  \mathbf{24}\right) \\
&  \left.  \left\vert 12\right\rangle \left\langle 12\right\vert ,\left\vert
13\right\rangle \left\langle 13\right\vert ,\left\vert 14\right\rangle
\left\langle 14\right\vert ,\left\vert 23\right\rangle \left\langle
23\right\vert ,\left\vert 24\right\rangle \left\langle 24\right\vert
,\left\vert 34\right\rangle \left\langle 34\right\vert .\left(  \mathbf{6}%
\right)  \right\}  .
\end{align}


\begin{enumerate}
\item The space $\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  $ has the
direct sum decomposition%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  =\,\,\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  _{0d}\oplus\,\mathcal{B}_{1}\left(  \mathcal{H}%
^{2}\right)  _{1d}\oplus\,\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)
_{2d}.
\end{equation}


\item The space $\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  $ is generated
by%
\begin{align}
&  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\operatorname*{linspan}%
\left\{  \left\vert 1\right\rangle \left\langle 2\right\vert ,\left\vert
1\right\rangle \left\langle 3\right\vert ,\left\vert 1\right\rangle
\left\langle 4\right\vert ,\left\vert 2\right\rangle \left\langle 1\right\vert
,\left\vert 2\right\rangle \left\langle 3\right\vert ,\left\vert
2\right\rangle \left\langle 4\right\vert ,\left\vert 3\right\rangle
\left\langle 4\right\vert ,\left\vert 3\right\rangle \left\langle 2\right\vert
,\left\vert 3\right\rangle \left\langle 1\right\vert ,\left\vert
4\right\rangle \left\langle 1\right\vert ,\left\vert 4\right\rangle
\left\langle 2\right\vert ,\left\vert 4\right\rangle \left\langle 3\right\vert
,\right.  \left(  \mathbf{12}\right) \\
&  \left.  \left\vert 1\right\rangle \left\langle 1\right\vert ,\left\vert
2\right\rangle \left\langle 2\right\vert ,\left\vert 3\right\rangle
\left\langle 3\right\vert ,\left\vert 4\right\rangle \left\langle 4\right\vert
.\left(  \mathbf{4}\right)  \right\}  .
\end{align}


\item The space $\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  $ has the
direct sum decomposition%
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  =\,\,\mathcal{B}_{1}\left(
\mathcal{H}^{1}\right)  _{0d}\oplus\,\mathcal{B}_{1}\left(  \mathcal{H}%
^{1}\right)  _{1d}.
\end{equation}


\item Contraction maps

\begin{enumerate}
\item
\begin{gather}
L_{2}^{2}:\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right) \\
L_{2}^{2}\left(  \left(  X\right)  \right)  =X
\end{gather}


\item
\begin{align}
L_{2}^{1}  &  :\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right) \\
L_{2}^{1}\left(  X\right)   &  =%
%TCIMACRO{\tsum \limits_{1\leq j,k\leq4}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j,k\leq4}}
%EndExpansion
\left\vert j\right\rangle \left\langle k\right\vert \operatorname{Tr}\left\{
\left(  a_{j}^{\dagger}a_{k}\right)  ^{\dagger}X\right\}  .
\end{align}


\item
\begin{gather}
L_{2}^{0}:\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  \cong\mathbb{C}\\
L_{2}^{0}\left(  \left(  X\right)  \right)  =\operatorname{Tr}\left\{
X\right\}
\end{gather}

\end{enumerate}

\item Examples of the contraction map $L_{2}^{1}$ coefficients are

\begin{enumerate}
\item One difference%
\begin{align}
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left\vert 12\right\rangle
\left\langle 13\right\vert \right\}   &  =\left\langle \left.  13\right\vert
a_{1}^{\dagger}a_{1}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left\vert 12\right\rangle
\left\langle 14\right\vert \right\}   &  =\left\langle \left.  14\right\vert
a_{1}^{\dagger}a_{1}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left\vert 12\right\rangle
\left\langle 23\right\vert \right\}   &  =\left\langle \left.  23\right\vert
a_{1}^{\dagger}a_{1}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left\vert 12\right\rangle
\left\langle 24\right\vert \right\}   &  =\left\langle \left.  24\right\vert
a_{1}^{\dagger}a_{1}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left\vert 12\right\rangle
\left\langle 34\right\vert \right\}   &  =\left\langle \left.  34\right\vert
a_{1}^{\dagger}a_{1}12\right\rangle =0.
\end{align}


\item One difference%
\begin{align}
\operatorname{Tr}\left\{  \emph{a}_{2}^{\dagger}\emph{a}_{3}\left\vert
\emph{12}\right\rangle \left\langle \emph{13}\right\vert \right\}  \emph{\,}
&  \emph{=\,}\left\langle \left.  \emph{13}\right\vert \emph{a}_{2}^{\dagger
}\emph{a}_{3}\emph{12}\right\rangle \emph{\,\neq0}\\
\operatorname{Tr}\left\{  a_{2}^{\dagger}a_{3}\left\vert 12\right\rangle
\left\langle 14\right\vert \right\}   &  =\left\langle \left.  14\right\vert
a_{2}^{\dagger}a_{3}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{2}^{\dagger}a_{3}\left\vert 12\right\rangle
\left\langle 23\right\vert \right\}   &  =\left\langle \left.  23\right\vert
a_{2}^{\dagger}a_{3}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{2}^{\dagger}a_{3}\left\vert 12\right\rangle
\left\langle 24\right\vert \right\}   &  =\left\langle \left.  24\right\vert
a_{2}^{\dagger}a_{3}12\right\rangle =0\\
\operatorname{Tr}\left\{  a_{2}^{\dagger}a_{3}\left\vert 12\right\rangle
\left\langle 34\right\vert \right\}   &  =\left\langle \left.  34\right\vert
a_{2}^{\dagger}a_{3}12\right\rangle =0.
\end{align}


\item Zero difference%
\begin{align}
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{2}\left(  \left\vert
12\right\rangle \left\langle 12\right\vert -\left\vert 13\right\rangle
\left\langle 13\right\vert \right)  \right\}   &  =0\\
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert
12\right\rangle \left\langle 12\right\vert -\left\vert 13\right\rangle
\left\langle 13\right\vert \right)  \right\}   &  =0.
\end{align}%
\begin{align}
\operatorname{Tr}\left\{  a_{1}^{\dagger}a_{2}\left(  \left\vert
14\right\rangle \left\langle 14\right\vert -\left\vert 23\right\rangle
\left\langle 23\right\vert \right)  \right\}   &  =0\\
\operatorname{Tr}\left\{  \emph{a}_{1}^{\dagger}\emph{a}_{1}\left(  \left\vert
\emph{14}\right\rangle \left\langle \emph{14}\right\vert \emph{-}\left\vert
\emph{23}\right\rangle \left\langle \emph{23}\right\vert \right)  \right\}
\emph{\,}  &  \emph{\neq0}.
\end{align}


\item Two difference%
\[
\operatorname{Tr}\left\{  a_{3}^{\dagger}a_{2}\left\vert 12\right\rangle
\left\langle 34\right\vert \right\}  \,=\,\left\langle \left.  34\right\vert
a_{3}^{\dagger}a_{2}12\right\rangle \,=0
\]

\end{enumerate}

\item In the case $p=2,n=2$ one has
\begin{equation}
\ker\left\{  L_{2}^{2}\right\}  =\,\phi,
\end{equation}
as
\begin{equation}
\ker\left\{  L_{2}^{2}\right\}  =\left\{  \left.  X\in\mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right\vert \operatorname{Tr}\left\{  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}X\right\}  =0,\forall1\leq
j_{1}<j_{2}\leq4,1\leq k_{1}<k_{2}\leq4.\right\}  .
\end{equation}


\item In the case $p=0,1,n=1,2$ one has%
\begin{gather}
L_{2}^{1}:\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right) \\
L_{2}^{0}:\mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  \cong\,\mathbb{C}\\
L_{1}^{0}:\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{0}\right)  \cong\,\mathbb{C}\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right\}  =36\\
\dim\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right\}  =16\\
\dim\left\{  \ker\left\{  L_{2}^{1}\right\}  \right\}  =20\\
\dim\left\{  \ker\left\{  L_{2}^{0}\right\}  \right\}  =35\\
\dim\left\{  \ker\left\{  L_{1}^{0}\right\}  \right\}  =15.
\end{gather}


\item In the case $p=1,n=2$ one has
