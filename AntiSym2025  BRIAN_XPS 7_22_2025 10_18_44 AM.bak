\begin{corollary}
{\em If }the {\em self adjoint} real and complex parts of a complex matrix
commute, ({\em note} that these parts {\em need not to }be real), then the
matrix defines a representation of a normal operator.
\end{corollary}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
{\cal R}_{e}\left( A\right) ^{\dagger }{\cal R}_{e}\left( A\right) =-{\cal R}%
_{e}\left( A\right) ^{\ast }{\cal R}_{e}\left( A\right)
\end{equation}

\item 
\begin{equation}
{\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{\dagger }=-{\cal R}%
_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{\ast }
\end{equation}
\end{enumerate}
\end{remark}

\begin{lemma}
The matrices ${\cal R}_{e}\left( A\right) ^{\ast }{\cal R}_{e}\left(
A\right) $ and ${\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right)
^{\ast }$ are not in general real and do not commute.

\begin{proof}
\begin{equation}
\left( {\cal R}_{e}\left( {\cal A}\right) ^{\ast }{\cal R}_{e}\left( {\cal A}%
\right) \right) ^{\ast }={\cal R}_{e}\left( {\cal A}\right) {\cal R}%
_{e}\left( {\cal A}\right) ^{\ast }
\end{equation}%
and%
\begin{equation}
\left( {\cal R}_{e}\left( {\cal A}\right) {\cal R}_{e}\left( {\cal A}\right)
^{\ast }\right) ^{\ast }={\cal R}_{e}\left( {\cal A}\right) ^{\ast }{\cal R}%
_{e}\left( {\cal A}\right) 
\end{equation}%
and in general 
\begin{equation}
\left[ {\cal R}_{e}\left( {\cal A}\right) ^{\ast },{\cal R}_{e}\left( {\cal A%
}\right) \right] \neq 0.
\end{equation}
\end{proof}%
\begin{equation}
\left( {\cal R}_{e}\left( A\right) ^{\ast }{\cal R}_{e}\left( A\right)
\right) ^{\ast }={\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right)
^{\ast }
\end{equation}%
and 
\begin{equation}
\left( {\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{\ast
}\right) ^{\ast }={\cal R}_{e}\left( A\right) ^{\ast }{\cal R}_{e}\left(
A\right) .
\end{equation}
\end{lemma}

\begin{lemma}
The matrices ${\cal R}_{e}\left( A\right) ^{t}{\cal R}_{e}\left( A\right) $
and ${\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{t}$ are
symmetric but not in general equal to each other unless $A$ is symmetric or
antisymmetric. .

\begin{proof}
\begin{equation}
\left( {\cal R}_{e}\left( {\cal A}\right) ^{t}{\cal R}_{e}\left( {\cal A}%
\right) \right) ^{t}={\cal R}_{e}\left( {\cal A}\right) ^{t}{\cal R}%
_{e}\left( {\cal A}\right) 
\end{equation}%
and 
\begin{equation}
\left( {\cal R}_{e}\left( {\cal A}\right) {\cal R}_{e}\left( {\cal A}\right)
^{t}\right) ^{t}={\cal R}_{e}\left( {\cal A}\right) {\cal R}_{e}\left( {\cal %
A}\right) ^{t}
\end{equation}
\end{proof}

\begin{enumerate}
\item Symmetric case 
\begin{eqnarray}
{\cal R}_{e}\left( A\right) ^{t}{\cal R}_{e}\left( A\right) &=&{\cal R}%
_{e}\left( A\right) ^{2} \\
{\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{t} &=&{\cal R}%
_{e}\left( A\right) ^{2}
\end{eqnarray}

\item Antisymmetric case 
\begin{eqnarray}
{\cal R}_{e}\left( A\right) ^{t}{\cal R}_{e}\left( A\right) &=&-{\cal R}%
_{e}\left( A\right) ^{2} \\
{\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{t} &=&-{\cal R}%
_{e}\left( A\right) ^{2}
\end{eqnarray}
\end{enumerate}
\end{lemma}

\begin{lemma}
If $A$ is a compact $t_{e}$-antisymmetric operator then $A$ can be expanded
as 
\begin{equation}
A=\sum_{1\leq j\leq r}ix_{j}\left( \stackrel{}{\left\vert v_{j}\right\rangle
\left\langle v_{j}\right\vert -\left\vert \sigma _{e}\left( v_{j}\right)
\right\rangle \left\langle \sigma _{e}\left( v_{j}\right) \right\vert }%
\right)
\end{equation}
\end{lemma}

\begin{corollary}
If $A=-A^{t_{e}}$ then 
\begin{equation}
\left[ A,\widehat{\sigma _{e}}\left( A\right) \right] =0.
\end{equation}

\begin{proof}
\begin{equation}
\widehat{\sigma _{e}}\left( {\cal A}\right) ={\cal A}.
\end{equation}
\end{proof}
\end{corollary}

\begin{remark}
\begin{equation}
{\cal R}_{e}\left( A\right) ^{\dagger }{\cal R}_{e}\left( A\right) =-{\cal R}%
_{e}\left( A\right) ^{\ast }{\cal R}_{e}\left( A\right)
\end{equation}%
\begin{equation}
{\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{\dagger }=-{\cal R}%
_{e}\left( A\right) {\cal R}_{e}\left( A\right) ^{\ast }
\end{equation}
\end{remark}

