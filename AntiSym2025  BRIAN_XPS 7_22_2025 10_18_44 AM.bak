%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] -\left[ \stackrel{%
}{%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Im}}%
