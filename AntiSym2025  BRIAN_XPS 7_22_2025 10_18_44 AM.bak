%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) }\right) \,,\,\left( \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) -i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
