\begin{definition}
The real and imaginary \underline{{\em operator}} parts ${\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) $ and ${\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) $ of an operator ${\cal A\in B}\left( {\cal H}\right) $ are 
{\em self adjoint and are defined} as

\begin{enumerate}
\item 
\begin{equation}
{\frak 
%TCIMACRO{\func{Re}}%
