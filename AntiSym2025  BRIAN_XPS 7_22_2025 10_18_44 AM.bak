%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}}\right]  \\
&&+\left[ \stackrel{}{i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Re}}%
%BeginExpansion
