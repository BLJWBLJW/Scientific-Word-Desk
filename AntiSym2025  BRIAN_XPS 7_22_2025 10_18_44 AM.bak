\begin{theorem}
If a matrix $A\in {\cal M}\left( 2r,2r,{\Bbb C}\right) $ is antisymmetric
and normal then it can be brought to complex antisymmetric canonical form by
a {\em real orthogonal} transformation.

\begin{proof}
\begin{equation}
{\cal A}=i{\cal M}+{\cal N}.,
\end{equation}%
where
\end{proof}
\end{theorem}

\begin{enumerate}
\item ${\cal M}$ and ${\cal N}$ commute%
\begin{equation}
\left[ {\cal M},{\cal N}\right] =0
\end{equation}

\item ${\cal M}$ and ${\cal N}$ are real

\begin{enumerate}
\item 
\begin{equation}
{\cal M}={\cal M}^{\ast }
\end{equation}

\item 
\begin{equation}
{\cal N}={\cal N}^{\ast }
\end{equation}
\end{enumerate}

\item ${\cal M}$ and ${\cal N}$ are antisymmetric

\begin{enumerate}
\item 
\begin{equation}
{\cal M}=-{\cal M}^{t}
\end{equation}

\item 
\begin{equation}
{\cal N}=-{\cal N}^{t}
\end{equation}
\end{enumerate}

\item Thus can be simultaneously diagonalized by a real orthogonal
transformation.

\begin{remark}
Note that the real part ${\cal N}$ of $A$ is related to self adjoint {\em %
imaginary} part of $A$ while the imaginary part ${\cal M}$ of $A$ is related
to self adjoint {\em real} part of $A$!.
\end{remark}

\item $%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
A$ and $%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
A$ can be simultaneously diagonalized to give 
\begin{eqnarray}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
A &=&i{\cal M}=\sum_{1\leq j\leq s}\mu _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad \mu
_{j}\in {\Bbb R}  \nonumber \\
&\Rightarrow &{\cal M}={\cal -}\sum_{1\leq j\leq s}i\mu _{j}\left\{
\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert
v_{j}^{\ast }\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\}
\end{eqnarray}%
and 
\begin{eqnarray}
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
A &=&-i{\cal N}=\sum_{1\leq j\leq s}\upsilon _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad
\upsilon _{j}\in {\Bbb R}  \nonumber \\
&\Rightarrow &{\cal N}=\sum_{1\leq j\leq s}i\upsilon _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} .
\end{eqnarray}
\end{enumerate}

Then we can use the theory for real antisymmetric matrices to obtain 
\begin{equation}
{\cal M}=\sum_{1\leq j\leq s}\mu _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert 
\stackrel{}{s_{j}}\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert
\right\}
\end{equation}%
and 
\begin{equation}
{\cal N}=\sum_{1\leq j\leq s}\left( -\upsilon _{j}\right) \left\{ \left\vert 
\stackrel{}{s_{j}}\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert
-\left\vert \stackrel{}{s_{_{j+s}}}\right\rangle \left\langle \stackrel{}{%
s_{j}}\right\vert \right\}
\end{equation}%
which gives using 
\begin{equation}
A=%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
A+i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
A={\cal N}+i{\cal M}
\end{equation}%
the {\em canonical} expansion for normal operators 
\begin{eqnarray}
A &=&\sum_{1\leq j\leq s}\left( -\upsilon _{j}+i\mu _{j}\right) \left\{
\left\vert s_{j}\right\rangle \left\langle s_{j+s}\right\vert -\left\vert
s_{_{j+s}}\right\rangle \left\langle s_{j}\right\vert \right\}  \nonumber \\
&\equiv &\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert 
\stackrel{}{s_{_{j+s}}}\right\rangle \left\langle \stackrel{}{s_{j}}%
\right\vert \right\} ,
\end{eqnarray}%
where $\eta _{j}=-\upsilon _{j}+i\mu _{j}$. This gives the matrix
representation 
\begin{equation}
A\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \eta _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\eta _{s} & 0%
\end{array}%
\right)
\end{equation}%
and the expansion 
\begin{equation}
A=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle
\cdots \left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
\left( 
\begin{array}{ccccc}
0 & \eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \eta _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\eta _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right)
\end{equation}%
We can also observe that $A$ has the {\em spectral expansion} 
\begin{equation}
A=-i\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{v_{j}}%
\right\rangle \left\langle \stackrel{}{v_{j}}\right\vert -\left\vert 
\stackrel{}{v_{j}^{\ast }}\right\rangle \left\langle \stackrel{}{v_{j}^{\ast
}}\right\vert \right\} .
\end{equation}%
This gives the matrix representation 
\begin{equation}
A\left( \left\vert \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right\rangle \right) =\left( \left\vert \left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle \right\rangle
\right) \left( 
\begin{array}{ccccc}
-i\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\eta _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\eta _{s}%
\end{array}%
\right)
\end{equation}%
and the expansion%
\begin{equation}
A=\left( \left\vert \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right\rangle \right) \left( 
\begin{array}{ccccc}
-i\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\eta _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\eta _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle v_{1}^{\ast }\right\vert \\ 
\left\langle v_{1}\right\vert \\ 
\vdots \\ 
\left\langle v_{s}^{\ast }\right\vert \\ 
\left\langle v_{s}\right\vert%
\end{array}%
\right) .
\end{equation}

The bases $\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right) $ and $\left( \left\vert s_{1}\right\rangle
\left\vert s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle
\left\vert s_{s+s}\right\rangle \right) $ can be viewed as transformations
of a fixed {\em real }starting basis $\left( \left\vert e_{1}\right\rangle
\cdots \left\vert e_{2s}\right\rangle \right) $ i.e.%
\begin{eqnarray}
\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
&=&\left( \left\vert e_{1}\right\rangle \cdots \left\vert
e_{2s}\right\rangle \right) {\Bbb S}  \nonumber \\
\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle
\cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle
\right) &=&\left( \left\vert e_{1}\right\rangle \cdots \left\vert
e_{2s}\right\rangle \right) {\Bbb V}
\end{eqnarray}%
where ${\Bbb S}$ is a real orthogonal matrix and ${\Bbb V}$ is unitary
matrix. If we are solely working with matrices we can set 
\begin{equation}
\left\vert e_{j}\right\rangle =\left( 
\begin{array}{c}
0 \\ 
\vdots \\ 
0 \\ 
1 \\ 
0 \\ 
\vdots \\ 
0%
\end{array}%
\right) \leftarrow \text{j'th position}
\end{equation}%
and the matrix ${\Bbb S}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) $ and ${\Bbb V}=$ $\left( \left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle \right) $ where $%
\left\vert s_{j}\right\rangle $ and $\left\vert v_{j}\right\rangle $ are
numerical column vectors, while if we are considering abstract operators we
can consider $\left\{ \left\vert e_{j}\right\rangle \right\} $ to be a given
fixed real basis of ${\cal H}$.

\section{Theorems on Complex Antisymmetric Matrices}

\subsection{Normal Complex Antisymmetric Matrices}

\begin{theorem}
For any complex antisymmetric matrix $A=B+iC$ where:

\begin{enumerate}
\item 
\begin{equation}
B^{T}=-B\text{ }(\text{real antisymmetric part})
\end{equation}

\item 
\begin{equation}
C^{T}=-C\text{ }(\text{real antisymmetric part})
\end{equation}
\end{enumerate}

the following conditions hold:

\begin{enumerate}
\item $A$ is normal ($AA^{\dagger }=A^{\dagger }A$) if and only if the
commutator $[B,C]=BC-CB=0$

\item When normal, $A$ is unitarily diagonalizable with purely imaginary
eigenvalues

\item When $[B,C]\neq 0$, $A$ may have defective eigenvalues requiring
Jordan form.
\end{enumerate}
\end{theorem}

\begin{theorem}
For an $n\times n$ complex matrix $A$, an eigenvalue $\lambda $ is {\bf %
defective} if and only if its geometric multiplicity is strictly less than
its algebraic multiplicity: 
\[
\dim \ker (A-\lambda I)<\text{mult}_{\text{alg}}(\lambda ). 
\]

\begin{proof}
\end{proof}
\end{theorem}

The Jordan decomposition $A=PJP^{-1}$ yields:%
\begin{equation}
J=\bigoplus_{i=1}^{k}J_{m_{i}}(\lambda _{i}),\quad J_{m}(\lambda )=%
\begin{pmatrix} \lambda & 1 & & \\ & \ddots & \ddots & \\ & & \ddots & 1 \\
& & & \lambda \end{pmatrix}_{m\times m}
\end{equation}

For each $\lambda$:

\begin{itemize}
\item Algebraic multiplicity: $\sum_{m_i} m_i$ where $\lambda_i = \lambda$

\item Geometric multiplicity: number of blocks $J_{m_i}(\lambda)$
\end{itemize}

Defectiveness occurs when any $m_{i}>1$, creating non-trivial Jordan blocks.

\begin{enumerate}
\item Non-Defective Matrix%
\begin{equation}
A=\begin{pmatrix} 2 & 0 \\ 0 & 2\end{pmatrix}
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\chi _{A}(\lambda )=(\lambda -2)^{2}(AM=2)
\end{equation}

\item 
\begin{equation}
\ker (A-2I)={\Bbb C}^{2}(GM=2)
\end{equation}

\item Full set of eigenvectors
\end{enumerate}

\item Defective Matrix%
\begin{equation}
B=\begin{pmatrix} 2 & 1 \\ 0 & 2\end{pmatrix}
\end{equation}
\end{enumerate}

\begin{example}
Antisymmetric Case
\end{example}

For $A=B+iC$ with $B^{t}=-B$, $C^{t}=-C$:

\begin{equation}
\text{Normality} \Leftrightarrow [B,C] = 0
\end{equation}

Non-normal cases may exhibit defective eigenvalues:

\begin{enumerate}
\item 
\begin{equation}
A=\begin{pmatrix} 0 & 1+i \\ -1-i & 0\end{pmatrix},\quad \lbrack B,C]\neq 0
\end{equation}

\item Potential defective eigenvalues when $[B,C]\neq 0$

\item Block-diagonalization may contain non-trivial Jordan blocks
\end{enumerate}

\subsection{Block Diagonalization Theorem for Non Normal Complex
Antisymmetric Matrices}

\begin{theorem}
Every complex antisymmetric matrix $A\in M_{n}({\Bbb C})$ with $A^{t}=-A$
can be brought to block diagonal form: 
\begin{equation}
A=U\begin{pmatrix} \begin{pmatrix} 0 & \lambda _{1} \\ -\lambda _{1} &
0\end{pmatrix} & \cdots & {\Bbb O} & 0 & 0 & 0 \\ \vdots & \ddots & \vdots &
0 & 0 & 0 \\ {\Bbb O} & \cdots & \begin{pmatrix} 0 & \lambda _{k} \\
-\lambda _{k} & 0\end{pmatrix} & 0 & 0 & 0 \\ \vdots & \cdots & \vdots & 0 &
0 & 0 \\ \vdots & \cdots & \vdots & 0 & \ddots & 0 \\ {\Bbb O} & \cdots &
{\Bbb O} & 0 & 0 & 0\end{pmatrix}U^{t}
\end{equation}%
where:

\begin{itemize}
\item $U$ is unitary ($U^\dagger U = I$)

\item $\lambda_j \in {\Bbb C}$ are non-zero complex numbers

\item The last block is a $1\times 1$ zero if $n$ is odd
\end{itemize}

\begin{proof}

\begin{enumerate}
\item Step 1: Reduction to Singular Value Form

For any complex square matrix $A$, there exist unitary matrices $U$ and $V$
such that: 
\begin{equation}
A=U\Sigma V^{t}
\end{equation}%
where $\Sigma $ is diagonal with non-negative real entries. For
antisymmetric $A$: 
\begin{equation}
A^{t}=V\Sigma ^{t}U^{t}=-A=-U\Sigma V^{t}
\end{equation}%
This implies 
\begin{equation}
V\Sigma U^{t}=-U\Sigma V^{t}
\end{equation}%
leading to: 
\begin{equation}
\Sigma =-Q\Sigma Q^{t}
\end{equation}%
$\quad $where$\quad Q=V^{\dagger }U$ as 
\begin{equation}
V^{\dagger }V\Sigma U^{t}U^{\ast }=\Sigma =-V^{\dagger }U\Sigma V^{t}U^{\ast
}=-V^{\dagger }U\Sigma \left( U^{\dagger }V\right) ^{t}
\end{equation}%
$.$

\item Pairing of Singular Values 

From 
\begin{equation}
\Sigma =-Q\Sigma Q^{t},
\end{equation}%
we deduce that non-zero singular values must come in pairs. For each $\sigma
_{j}>0$, there exists $\sigma _{k}=\sigma _{j}$ such that the corresponding
blocks satisfy: 
\begin{equation}
\begin{pmatrix}
\sigma _{j} & 0 \\ 
0 & \sigma _{k}%
\end{pmatrix}%
=-%
\begin{pmatrix}
q_{11} & q_{12} \\ 
q_{21} & q_{22}%
\end{pmatrix}%
\begin{pmatrix}
\sigma _{j} & 0 \\ 
0 & \sigma _{k}%
\end{pmatrix}%
\begin{pmatrix}
q_{11} & q_{21} \\ 
q_{12} & q_{22}%
\end{pmatrix}%
\end{equation}%
This enforces the $2\times 2$ block structure.

\item Construction of Block Diagonal Form

Through careful choice of unitary transformations, we can arrange: 
\begin{equation}
\Sigma =\bigoplus_{j=1}^{k}%
\begin{pmatrix}
0 & \sigma _{j} \\ 
-\sigma _{j} & 0%
\end{pmatrix}%
\oplus 0_{n-2k}
\end{equation}%
The complex phases of $\sigma _{j}$ can be absorbed into $U$, giving the
general form with $\lambda _{j}\in {\Bbb C}$.

\item Unitary Congruence

The final form is achieved through unitary congruence (not similarity): 
\begin{equation}
A=U\Lambda U^{t}
\end{equation}%
where $\Lambda $ contains the $2\times 2$ blocks and possibly a zero block.
This preserves the antisymmetry property while revealing the canonical
structure.
\end{enumerate}
\end{proof}
\end{theorem}

\begin{corollary}
For {\em normal} antisymmetric matrices ($[B,C]=0$), all $\lambda _{j}$ are
purely imaginary.
\end{corollary}

\begin{corollary}
When $n$ is odd, at least one eigenvalue must be zero.
\end{corollary}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\chi _{B}(\lambda )=(\lambda -2)^{2}(AM=2)
\end{equation}

\item 
\begin{equation}
\ker (B-2I)=\text{span}\{(1,0)^{t}\}(GM=1)
\end{equation}

\item Requires Jordan form
\end{enumerate}
\end{enumerate}

\section{Injective Map between Complex Geminals and Complex Antisymmetric
Operators.}

\begin{theorem}
There is an injective complex Hilbert space map $T$ 
\begin{equation}
T:{\huge \wedge }^{2}{\cal H}^{1}\rightarrow {\cal B}_{2anti}\left( {\cal H}%
^{1}\right) .
\end{equation}%
given by 
\begin{equation}
T\left( g\right) =G
\end{equation}%
given by 
\begin{equation}
T\left( \left\vert e_{j}e_{k}\right\rangle \right) =T\left( \frac{1}{\sqrt{2}%
}\left\vert e_{j}\wedge e_{k}\right\rangle \right) =T\left( \frac{1}{\sqrt{2}%
}\left( \stackrel{}{\left\vert e_{j}\right\rangle \otimes \left\vert
e_{k}\right\rangle -\left\vert e_{k}\right\rangle \otimes \left\vert
e_{j}\right\rangle }\right) \right) =\frac{1}{\sqrt{2}}\left( \stackrel{}{%
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert -\left\vert
e_{k}\right\rangle \left\langle e_{l}\right\vert }\right)
\end{equation}%
i.e.%
\begin{equation}
T\left( \left\vert e_{j}\right\rangle \otimes \left\vert e_{k}\right\rangle
\right) =\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
\end{equation}
\begin{equation}
T\left( \sum_{1\leq j<k\leq r}\left\vert e_{j}e_{k}\right\rangle {\cal R}%
_{e}\left( g\right) _{jk}\right) =\sum_{1\leq j<k\leq r}\left( \stackrel{}{%
\left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert -\left\vert
e_{k}\right\rangle \left\langle e_{l}\right\vert }\right) {\cal R}_{e}\left(
g\right) _{jk},
\end{equation}%
which can be recast as 
\begin{equation}
T\left( \sum_{1\leq j,k\leq r}\left\vert e_{j}e_{k}\right\rangle {\cal R}%
_{e}\left( g\right) _{jk}\right) =\sum_{1\leq j,k\leq r}\left\vert
e_{j}\right\rangle \left\langle e_{k}\right\vert {\cal R}_{e}\left( g\right)
_{jk},
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( g\right) ^{t}=-{\cal R}_{e}\left( g\right) .
\end{equation}

\begin{proof}
\end{proof}%
\begin{eqnarray}
\left\Vert g\right\Vert _{{\cal H}^{2}}^{2} &=&\left\langle \left.
g\right\vert g\right\rangle =\left\langle \left. \frac{1}{2}\sum_{1\leq
j,k\leq r}\left\vert e_{j}e_{k}\right\rangle {\cal R}_{e}\left( g\right)
_{jk}\right\vert \frac{1}{2}\sum_{1\leq l,m\leq r}\left\vert
e_{l}e_{m}\right\rangle {\cal R}_{e}\left( g\right) _{lm}\right\rangle \\
&=&\frac{1}{4}\sum_{1\leq j,k\leq r}{\cal R}_{e}\left( g\right) _{kj}^{\ast }%
{\cal R}_{e}\left( g\right) _{jk}=\frac{1}{4}\sum_{1\leq j,k\leq
r}\left\vert {\cal R}_{e}\left( g\right) _{jk}\right\vert ^{2}=\frac{1}{2}%
\sum_{1\leq j<k\leq r}\left\vert {\cal R}_{e}\left( g\right)
_{jk}\right\vert ^{2}
\end{eqnarray}%
\begin{equation}
\left\Vert \left\vert e_{j}e_{k}\right\rangle \right\Vert _{{\cal H}%
^{2}}^{2}=1
\end{equation}%
and 
\begin{eqnarray}
\left\Vert G\right\Vert _{{\cal B}_{2anti}\left( {\cal H}^{1}\right) }^{2}
&=&\left\langle \left. G\right\vert G\right\rangle _{{\cal B}_{2anti}\left( 
{\cal H}^{1}\right) }=%
%TCIMACRO{\limfunc{Tr}}%
%BeginExpansion
\mathop{\rm Tr}%
%EndExpansion
\left\{ {\cal R}_{e}\left( g\right) ^{\dagger }{\cal R}_{e}\left( g\right)
\right\} =\sum_{1\leq j,k\leq r}{\cal R}_{e}\left( g\right) _{kj}^{\ast }%
{\cal R}_{e}\left( g\right) _{jk} \\
&=&\sum_{1\leq j,k\leq r}\left\vert {\cal R}_{e}\left( g\right)
_{jk}\right\vert ^{2}=2\sum_{1\leq j<k\leq r}\left\vert {\cal R}_{e}\left(
g\right) _{jk}\right\vert ^{2}
\end{eqnarray}%
\begin{equation}
\left\Vert \left\vert e_{j}\right\rangle \left\langle e_{k}\right\vert
\right\Vert _{{\cal B}_{2anti}\left( {\cal H}^{1}\right) }^{2}=1
\end{equation}%
\begin{equation}
\left( \sqrt{2}\right) ^{2}\left\Vert g\right\Vert _{{\cal H}%
^{2}}^{2}=\sum_{1\leq j<k\leq r}\left\vert {\cal R}_{e}\left( g\right)
_{jk}\right\vert ^{2}
\end{equation}%
\begin{equation}
\left( \frac{1}{\sqrt{2}}\right) ^{2}\left\Vert G\right\Vert _{{\cal B}%
_{2anti}\left( {\cal H}^{1}\right) }^{2}=\sum_{1\leq j<k\leq r}\left\vert 
{\cal R}_{e}\left( g\right) _{jk}\right\vert ^{2}
\end{equation}%
\begin{eqnarray}
\left( \sqrt{2}\right) ^{2}\left\Vert g\right\Vert _{{\cal H}^{2}}^{2}
&=&\left( \frac{1}{\sqrt{2}}\right) ^{2}\left\Vert G\right\Vert _{{\cal B}%
_{2anti}\left( {\cal H}^{1}\right) }^{2} \\
\left\Vert g\right\Vert _{{\cal H}^{2}}^{2} &=&\left( \frac{1}{\sqrt{2}}%
\right) ^{4}\left\Vert G\right\Vert _{{\cal B}_{2anti}\left( {\cal H}%
^{1}\right) }^{2}=\frac{1}{4}\left\Vert G\right\Vert _{{\cal B}%
_{2anti}\left( {\cal H}^{1}\right) }^{2}
\end{eqnarray}%
thus 
\begin{equation}
g\rightarrow \frac{1}{2}G
\end{equation}
\end{theorem}

\section{Symmetry}

There is a 1-1 correspondence between antisymmetric operators acting on a
Hilbert space ${\cal H}$ (i.e. mixed contra and covariant tensors of rank $%
\left( 1,1\right) $) and contravariant tensors of rank $\left( 0,2\right) $
and also covariant tensors of rank $\left( 2,0\right) $. The first
correspondence is given by 
\begin{equation}
A=\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert
s_{_{j+s}}\right\rangle \left\langle \stackrel{}{s_{j}}\right\vert \right\}
\leftrightarrow 2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle  \label{contra}
\end{equation}%
where $\left\vert s_{j}s_{j+s}\right\rangle $ is the normalized
antisymmetric tensor product of the {\em real }basis elements $\left\{
\left\vert s_{j}\right\rangle ,\left\vert s_{_{j+s}}\right\rangle \right\} $
and $\eta _{j}=\eta _{jj+s}$.

The expansions of $A$ are not unique and we have from the preceeding that%
\begin{eqnarray}
A &=&\sum\Sb 1\leq j\leq s  \\ 1\leq k\leq 2s  \\ 1\leq l\leq 2s  \endSb %
\eta _{j}\left\{ \left\vert e_{k}S_{k2j-1}\right\rangle \left\langle
e_{l}S_{l2j}\right\vert -\left\vert e_{k}S_{k2j}\right\rangle \left\langle
e_{l}S_{l2j-1}\right\vert \right\}  \nonumber \\
&=&\sum\Sb 1\leq j\leq s  \\ 1\leq k\leq 2s  \\ 1\leq l\leq 2s  \endSb %
\left\{ \eta _{j}\left\vert e_{k}S_{k2j-1}\right\rangle \left\langle
e_{l}S_{l2j}\right\vert +\eta _{j+s}\left\vert e_{k}S_{k2j}\right\rangle
\left\langle e_{l}S_{l2j-1}\right\vert \right\}  \nonumber \\
&=&\sum\Sb 1\leq j\leq s  \\ 1\leq k\leq 2s  \\ 1\leq l\leq 2s  \endSb %
S_{kj}\eta _{j}S_{lj}\left\vert e_{k}\right\rangle \left\langle
e_{l}\right\vert  \nonumber \\
&=&\sum\Sb 1\leq k\leq 2s  \\ 1\leq l\leq 2s  \endSb \left( {\Bbb S}{\bf %
\eta }{\Bbb S}^{t}\right) _{_{kl}}\left\vert e_{k}\right\rangle \left\langle
e_{l}\right\vert
\end{eqnarray}%
and 
\begin{eqnarray}
A &=&2\sum_{1\leq j\leq s}\eta _{j}\left\vert s_{j}s_{j+s}\right\rangle
=\sum_{1\leq j\leq s}\left\{ \eta _{jj+s}\left\vert
s_{j}s_{j+s}\right\rangle +\eta _{j+sj}\left\vert s_{j+s}s_{j}\right\rangle
\right\}  \nonumber \\
&=&\sum\Sb 1\leq k\leq 2s  \\ 1\leq l\leq 2s  \endSb \left( {\Bbb S}{\bf %
\eta }{\Bbb S}^{t}\right) _{_{kl}}\left\vert e_{k}e_{l}\right\rangle =\sum\Sb
1\leq k\leq 2s  \\ 1\leq l\leq 2s  \endSb {\Bbb A}_{_{j^{\prime }j^{\prime
\prime }}}\left\vert e_{k}e_{l}\right\rangle
\end{eqnarray}%
Eq. $\left( \ref{contra}\right) $ shows that 
\begin{equation}
A=2\sum_{1\leq j\leq s}\eta _{j}\left\vert Os_{j}Os_{j+s}\right\rangle
=2\sum_{1\leq j\leq s}\eta _{j}\left\vert s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
O\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb O}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb O}_{\left( j\right) }=1
\end{equation}%
i.e. $O\in SO(2,{\Bbb R)}$ and $O{\cal A}O^{t}=A.$ If we have some
degeneracies i.e. $\eta _{j_{1}}=\cdots =\eta _{j_{d}}$ then $O\in SO(2r,%
{\Bbb R)}$ and $OAO^{t}=A$ also produce different but equivalent expansions
of $A$ in terms of a real basis.

We can also observe that 
\begin{equation}
A=2\sum_{1\leq j\leq s}\eta _{j}\left\vert Us_{j}Us_{j+s}\right\rangle
=2\sum_{1\leq j\leq s}\eta _{j}\left\vert s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
U\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb U}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb U}_{\left( j\right) }=1
\end{equation}%
i.e. $U\in SU(2,{\Bbb C)}$ and $UAU^{t}=A.$ If we have some degeneracies
i.e. $\eta _{j_{1}}=\cdots =\eta _{j_{d}}$ then $U\in SU(2r,{\Bbb C)}$ and $%
UAU^{t}=A$ also produce different but equivalent expansions of $A$ in terms
of a complex basis.

We can further observe more generally that 
\begin{equation}
A=2\sum_{1\leq j\leq s}\eta _{j}\left( \det {\Bbb U}_{\left( j\right)
}\right) ^{-1}\left\vert Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq
s}\eta _{j}\left\vert s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
U\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb U}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb U}_{\left( j\right) }=e^{i\sigma _{j}}
\end{equation}%
A special case of this is 
\begin{equation}
A=2\sum_{1\leq j\leq s}\eta _{j}\left( \det {\Bbb U}_{\left( j\right)
}\right) ^{-1}\left\vert Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq
s}\left\vert \eta _{j}\right\vert \left\vert Us_{j}Us_{j+s}\right\rangle
\end{equation}%
where 
\begin{equation}
\eta _{j}=\left\vert \eta _{j}\right\vert e^{i\sigma _{j}}
\end{equation}%
Thus one can conclude that the expansion of $A$ in terms of a canonical
complex basis {\em does not }lead to {\em unique }canonical coefficients!!
In this case canonical coefficients are only uniquely defined up to a
complex phase factor and the value of the canonical coefficients depends on
the canonical basis used. However the absolute values $\left\{ \left.
\left\vert \eta _{j}\right\vert \right\vert 1\leq j\leq s\right\} $ that are
real and positive are unique.

Expansions in terms of canonical real bases as $\det {\Bbb O}_{\left(
j\right) }=-1$ (the only other possible value for $\det {\Bbb O}_{\left(
j\right) })$ leads to%
\begin{equation}
A=2\sum_{1\leq j\leq s}\eta _{j}\left( -1\right) \left\vert
Os_{j}Os_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Os_{j+s}Os_{j}\right\rangle ,
\end{equation}%
which corresponds to $\eta _{j}\rightarrow -\eta _{j}$. Thus canonical
coefficients in this case are uniquely defined up to sign. The eigenvalues
of $A$ are however {\em uniquely} defined as $\left\{ \pm i\eta _{j};1\leq
j\leq s\right\} $.

\section{Complex Conjugation\label{star}}

A complex conjugation map, $\sigma _{e}$, is a antilinear involution
determined by any representative,$\left\{ \left\vert {\bf e}\right\rangle
\right\} $, of an equivalence class of bases $\left[ \left\vert {\bf e}%
\right\rangle \right] $ of ${\cal H}$ by

\begin{definition}
\begin{equation}
\sigma _{e}\left\vert v\right\rangle =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq n}\left\vert e_{j}\right\rangle \left( \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( v\right) _{j}\right) -i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( v\right) _{j}\right) }\right) =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq n}\left\vert e_{j}\right\rangle {\cal R}_{e}\left( v\right)
_{j}^{\ast },\quad \forall \left\vert v\right\rangle \in {\cal H}.
\end{equation}%
where 
\begin{equation}
\left\vert v\right\rangle =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq n}\left\vert e_{j}\right\rangle {\cal R}_{e}\left( v\right)
_{j}.
\end{equation}
\end{definition}

\begin{definition}
Any vector that satisfies 
\begin{equation}
\sigma _{e}\left\vert w\right\rangle =\left\vert w\right\rangle
\end{equation}%
is called $\sigma _{e}$-{\em real} wrt the complex conjugation $\sigma _{e}$%
, in particular the basis elements $\left\{ \left\vert e_{j}\right\rangle
\right\} $ are real vectors.
\end{definition}

\begin{definition}
\bigskip The complex conjugate $\widehat{\sigma _{e}}\left( B\right) $ of an
operator $B$ is defined by 
\begin{equation}
{\cal B}^{\ast }=\widehat{\sigma _{e}}\left( B\right) =\sigma _{e}B\sigma
_{e},
\end{equation}%
i.e. 
\begin{equation}
{\cal B}^{\ast }\left\vert v\right\rangle =\widehat{\sigma _{e}}\left(
B\right) \left\vert v\right\rangle =\sigma _{e}B\sigma _{e}\left\vert
v\right\rangle =\sigma _{e}B\left( \sigma _{e}\left\vert v\right\rangle
\right) =\sigma _{e}\left( \stackrel{}{B\left( \sigma _{e}\left\vert
v\right\rangle \right) }\right) ,\quad \forall \left\vert v\right\rangle \in 
{\cal H}.
\end{equation}
\end{definition}

\begin{remark}
This leads to 
\begin{equation}
B^{\ast }\left\vert {\bf e}\right\rangle =\widehat{\sigma _{e}}\left(
B\right) \left( \left\vert {\bf e}\right\rangle \right) =\sigma _{e}B\sigma
_{e}\left( \left\vert {\bf e}\right\rangle \right) =\sigma _{e}B\left(
\left\vert {\bf e}\right\rangle \right) =\sigma _{e}\left( \left\vert {\bf e}%
\right\rangle \right) {\cal R}_{e}\left( B\right) =\left( \left\vert {\bf e}%
\right\rangle \right) {\cal R}_{e}\left( B\right) ^{\ast }.
\end{equation}
\end{remark}

\begin{definition}
The $e$-transpose $B^{t_{e}}$ of an operator $B$ is defined by 
\begin{equation}
B^{t_{e}}\left( \left\vert {\bf e}\right\rangle \right) =\left( \left\vert 
{\bf e}\right\rangle \right) {\cal R}_{e}\left( B^{t_{e}}\right) =\left(
\left\vert {\bf e}\right\rangle \right) {\cal R}_{e}\left( B\right)
^{t},\quad \left\vert {\bf e}\right\rangle \in {\frak B}_{e}\left( {\cal H}%
\right) .
\end{equation}
\end{definition}

\begin{remark}
The transpose $B^{t_{e}}$ can then be defined in terms of $\sigma _{e}$ and
the adjoint operation as 
\begin{equation}
B^{t_{e}}=\left( B^{\dagger }\right) ^{\ast }=\left( \widehat{\sigma _{e}}%
\left( B^{\dagger }\right) \right) ^{t_{e}}.
\end{equation}
\end{remark}

\section{Complex Symmetric Matrix}

\begin{theorem}
\begin{proof}
\begin{enumerate}
\item Step 1: Reduction to Singular Value Form

For any complex square matrix $A$, there exist unitary matrices $U$ and $V$
such that: 
\begin{equation}
A=U\Sigma V^{t}
\end{equation}%
where $\Sigma $ is diagonal with non-negative real entries. For
antisymmetric $A$: 
\begin{equation}
A^{t}=V\Sigma ^{t}U^{t}=A=U\Sigma V^{t}
\end{equation}%
This implies 
\begin{equation}
V\Sigma U^{t}=U\Sigma V^{t}
\end{equation}%
leading to: 
\begin{equation}
U^{\dagger }V\Sigma U^{t}V^{\ast }=Q\Sigma =U^{\dagger }U\Sigma V^{t}V^{\ast
}=\Sigma 
\end{equation}%
$\quad $where$\quad Q=U^{\dagger }V.$
\end{enumerate}
\end{proof}
\end{theorem}
