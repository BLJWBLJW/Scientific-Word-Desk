\section{ Antisymmetric Operators $\in {\cal B}\left( {\cal H}\right) $}

\begin{definition}
\end{definition}

\begin{enumerate}
\item ${\cal H}$ is a complex Hilbert space of dimension $r$.

\item ${\cal B}\left( {\cal H}\right) $ is the set of bounded opertors
acting in ${\cal H}.$

\item $\left( \QTR{bs}{e}\right) $ is a conb of ${\cal H}.$

\item ${\LARGE \otimes }^{2}{\cal H}$ is the space of tensor products of
vector $v\in {\cal H}.$

\begin{enumerate}
\item 
\begin{equation}
{\LARGE \otimes }^{2}{\cal H\cong B}_{2}\left( {\cal H}\right) .
\end{equation}

\item non degenerate second rank tensors $b\in $ ${\normalsize \otimes }^{2}%
{\cal H}$ define non degenerate bilinear forms ${\rm b}=\Xi \left( b\right) $
and invertible operators  $B=\left[ \digamma \circ \Xi \right] \left(
b\right) =\digamma \left( \Xi \left( b\right) \right) $ on ${\cal H}$ i.e.%
\begin{equation}
{\rm b}:{\cal H\times H}\rightarrow {\Bbb C}
\end{equation}%
where 
\begin{equation}
{\rm b}\left( v_{1},v_{2}\right) =b^{d}\left( v_{1}\otimes v\right) ={\cal R}%
_{e}\left( v_{2}\right) ^{t}{\cal R}_{e}\left( B\right) {\cal R}_{e}\left(
v_{2}\right) .
\end{equation}

\item $b$ is non degenerate if it is left and right non degenerate

\begin{enumerate}
\item left non degeneracy means 
\begin{equation}
{\rm b}\left( v_{1},v_{2}\right) =0\,\forall v_{2}\Leftrightarrow v_{1}=0
\end{equation}

\item right non degeneracy means 
\begin{equation}
{\rm b}\left( v_{1},v_{2}\right) =0\,\forall v_{1}\Leftrightarrow v_{2}=0
\end{equation}
\end{enumerate}
\end{enumerate}

\item ${\LARGE \wedge }^{2}{\cal H}$ is the space of antisymmetric tensor
products of vector $v\in {\cal H}.$

\begin{enumerate}
\item 
\begin{equation}
{\LARGE \wedge }^{2}{\cal H\cong B}_{2anti}\left( {\cal H}\right) 
\end{equation}

\item  $g\in {\LARGE \wedge }^{2}{\cal H}$ produces non degenerate (in this
case $r=2n)$ antisymmetric bilinear forms $\equiv $ symplectic forms 
\begin{equation}
{\cal G}:{\cal H\times H}\rightarrow {\Bbb C}
\end{equation}%
by 
\begin{equation}
{\cal G}\left( v_{1},v_{2}\right) =g^{d}\left( v_{1}\wedge v\right) 
\end{equation}%
and antisymmetric invertible operators $\left[ \digamma \circ \Xi \right]
\left( g\right) \in {\cal B}_{2}\left( {\cal H}\right) $ such that 
\begin{equation}
{\cal G}\left( v_{1},v_{2}\right) =g^{d}\left( v_{1}\otimes v_{2}\right) =%
{\cal R}_{e}\left( v_{2}\right) ^{t}{\cal R}_{e}\left( B\right) {\cal R}%
_{e}\left( v_{2}\right) ,
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( B\right) ^{t}=-{\cal R}_{e}\left( B\right) \in {\cal M}%
\left( r,r,{\Bbb C}\right) 
\end{equation}

\item Non degenerate antisymmetric bilinear products on ${\cal H}$ can be
denoted by 
\begin{equation}
\left\{ \left. v_{1}\right\vert v_{2}\right\} _{s}={\rm g}\left(
v_{1},v_{2}\right) .
\end{equation}
\end{enumerate}

\item ${\LARGE \vee }^{2}{\cal H}$ is the space of symmetric tensor products
of vector $v\in {\cal H}.$

\begin{enumerate}
\item 
\begin{equation}
{\LARGE \vee }^{2}{\cal H\cong B}_{2sym}\left( {\cal H}\right) 
\end{equation}

\item $s\in {\LARGE \vee }^{2}{\cal H}$ produces non degenerate symmetric
bilinear forms  
\begin{equation}
{\rm s}:{\cal H\times H}\rightarrow {\Bbb C}
\end{equation}%
by 
\begin{equation}
{\rm s}\left( v_{1},v_{2}\right) =s^{d}\left( v_{1}\wedge v\right) 
\end{equation}%
and antisymmetric invertible operators $\left[ \digamma \circ \Xi \right]
\left( s\right) \in {\cal B}_{2}\left( {\cal H}\right) $ such that 
\begin{equation}
{\rm s}\left( v_{1},v_{2}\right) =s^{d}\left( v_{1}\otimes v_{2}\right) =%
{\cal R}_{e}\left( v_{2}\right) ^{t}{\cal R}_{e}\left( B\right) {\cal R}%
_{e}\left( v_{2}\right) ,
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( B\right) ^{t}={\cal R}_{e}\left( B\right) \in {\cal M}%
\left( r,r,{\Bbb C}\right) .
\end{equation}

\item Non degenerate symmetric bilinear products on ${\cal H}$ can be
denoted by   
\begin{equation}
\left( \left. v_{1}\right\vert v_{2}\right) _{s}={\rm s}\left(
v_{1},v_{2}\right) ,
\end{equation}%
which can be null, indefinite or complex valued i.e. $\left( \left.
v\right\vert v\right) _{s}$ can have the values   
\begin{equation}
\left( \left. v\right\vert v\right) _{s}=\left\{ 
\begin{array}{c}
0 \\ 
x<0 \\ 
z\in {\Bbb C}%
\end{array}%
\right. .
\end{equation}
\end{enumerate}
\end{enumerate}

\subsection{Conjugations and Transpose}

\begin{definition}
The $\sigma _{e}$-complex conjugate of the vector $v\in {\cal H}$ is defined
by 
\begin{equation}
\sigma _{e}\left( v\right) =\left\vert \QTR{bs}{e}\right\rangle \left( {\cal %
R}_{e}\left( v\right) \right) ^{\ast }.
\end{equation}
\end{definition}

\begin{definition}
The $\sigma _{e}$-complex conjugate of an operator $A\in {\cal B}\left( 
{\cal H}\right) $ is defined by 
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =\left\vert \QTR{bs}{e}\right\rangle 
{\cal R}_{e}\left( A\right) ^{\ast }\left\langle \QTR{bs}{e}\right\vert .
\end{equation}
\end{definition}

\begin{definition}
The $t_{e}$-transpose of an operator $A\in {\cal B}\left( {\cal H}\right) $
is defined by 
\begin{equation}
A^{t_{e}}=\left\vert \QTR{bs}{e}\right\rangle {\cal R}_{e}\left( A\right)
^{t}\left\langle \QTR{bs}{e}\right\vert .
\end{equation}
\end{definition}

\begin{lemma}
The $\sigma _{e}$-complex conjugate of an operator $A\in {\cal B}\left( 
{\cal H}\right) $ can be expressed in terms of $\sigma _{e}$-complex
conjugates of vectors i.e. 
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =\sigma _{e}A\sigma _{e}
\end{equation}

\begin{proof}
\begin{equation}
\left[ \widehat{\sigma _{e}}\left( A\right) \right] \left( v\right) =\sigma
_{e}\left( \stackrel{}{A\sigma _{e}\left( \stackrel{}{v}\right) }\right) ,
\end{equation}
\end{proof}%
\begin{equation}
\left[ \widehat{\sigma _{e}}\left( A\right) \right] v=\sigma _{e}\left( 
\stackrel{}{A\sigma _{e}\left( \stackrel{}{v}\right) }\right) .
\end{equation}
\end{lemma}

\begin{lemma}
\label{symmetric bilinear form} $t_{e}$ corresponds to a symmetric bilinear
form 
\begin{equation}
s_{e}:{\cal H}\times {\cal H}\rightarrow {\Bbb C}
\end{equation}%
given by 
\begin{equation}
s_{e}\left( v,w\right) =\left( \sum_{1\leq j\leq k\leq r}e_{j}\vee
e_{k}\right) \left( \stackrel{}{v,w}\right) =\sum_{1\leq j\leq k\leq
r}\left\langle \left. \stackrel{}{e_{j}\vee e_{k}}\right\vert v\vee
w\right\rangle _{{\cal H}\vee {\cal H}}
\end{equation}%
producing a complex symmetric inner product 
\begin{equation}
\left( \left. {}\right\vert \right) _{e}:{\cal H}\times {\cal H}\rightarrow 
{\Bbb C}
\end{equation}
by%
\begin{equation}
\left( \left. \stackrel{}{v}\right\vert w\right) _{e}=s_{e}\left( v,w\right)
\end{equation}%
and a transpose "$t_{e}"$ defined by 
\begin{equation}
\left( \left. \stackrel{}{A^{t_{e}}v}\right\vert w\right) _{e}=\left( \left. 
\stackrel{}{v}\right\vert Aw\right) _{e}\quad \forall v,w\in {\cal H},
\end{equation}%
that is the same as the transpose "$t_{e}"$ previously defined.

\begin{proof}
\end{proof} in order to opbserve that the transpose is well defined  one
must observe that $\left( \left. {}\right\vert \right) _{e}$ is non
degenerate i.e. 
\begin{equation}
\left( \left. \stackrel{}{v}\right\vert w\right) _{e}=0\forall w\in {\cal H}%
\Leftrightarrow v=0
\end{equation}%
Then if  
\begin{equation}
\left( \left. \stackrel{}{B_{1}v}\right\vert w\right) _{e}=\left( \left. 
\stackrel{}{B_{2}v}\right\vert w\right) _{e}=\left( \left. \stackrel{}{v}%
\right\vert Aw\right) _{e}
\end{equation}%
one has 
\begin{equation}
\left( \left. \stackrel{}{\left( B_{1}-B_{2}\right) v}\right\vert w\right)
_{e}=0\forall w\in {\cal H}
\end{equation}%
hence by non degeneracy  
\begin{equation}
\left( B_{1}-B_{2}\right) v=0\forall v\in {\cal H}
\end{equation}%
thus 
\begin{equation}
B_{1}-B_{2}=0
\end{equation}%
and the transpose is well defined.$\blacksquare $ 
\begin{eqnarray}
\sum_{1\leq j\leq k\leq r}\left\langle \left. \stackrel{}{e_{j}\vee e_{k}}%
\right\vert v\vee v\right\rangle _{{\cal H}\vee {\cal H}} &=&\frac{1}{2}%
\sum_{1\leq j\leq k\leq r}\left( \stackrel{}{\left\langle \left.
e_{j}\right\vert v\right\rangle \left\langle \left. e_{k}\right\vert
v\right\rangle +\left\langle \left. e_{k}\right\vert v\right\rangle
\left\langle \left. e_{j}\right\vert v\right\rangle }\right) =\frac{1}{2}%
\sum_{1\leq j\leq k\leq r}\left( {\cal R}_{e}\left( v\right) _{j}{\cal R}%
_{e}\left( v\right) _{k}\stackrel{}{+}{\cal R}_{e}\left( v\right) _{k}{\cal R%
}_{e}\left( v\right) _{j}\right)  \\
&=&\sum_{1\leq j\leq k\leq r}{\cal R}_{e}\left( v\right) _{j}{\cal R}%
_{e}\left( v\right) _{k}
\end{eqnarray}
\end{lemma}

\begin{lemma}
The adjoint operation "$\dagger "$ in ${\cal B}\left( {\cal H}\right) $ is
equal to the composition $\widehat{\sigma _{e}}\circ $ $t_{e}=$ $t_{e}\circ $
$\widehat{\sigma _{e}}$ of \thinspace $\widehat{\sigma _{e}}$ and $t_{e}$ 
\underline{{\em for all}} conb's $\left( \QTR{bs}{e}\right) $ of ${\cal H}$ 
\begin{equation}
A^{\dagger }=\left( \widehat{\sigma _{e}}\left( A\right) \right) ^{t_{e}}.
\end{equation}

\begin{proof}
\begin{eqnarray}
A^{\dagger } &=&\left\vert \QTR{bs}{e}\right\rangle {\cal R}_{e}\left(
A\right) ^{\dagger }\left\langle \QTR{bs}{e}\right\vert  \\
\left( \widehat{\sigma _{e}}\left( A\right) \right) ^{t_{e}} &=&\widehat{%
\sigma _{e}}\left( \stackrel{}{\left\vert \QTR{bs}{e}\right\rangle {\cal R}%
_{e}\left( A\right) ^{t}\left\langle \QTR{bs}{e}\right\vert }\right) =\,%
\stackrel{}{\left\vert \QTR{bs}{e}\right\rangle {\cal R}_{e}\left( A\right)
^{\ast t}\left\langle \QTR{bs}{e}\right\vert =\left\vert \QTR{bs}{e}%
\right\rangle {\cal R}_{e}\left( A\right) ^{\dagger }\left\langle \QTR{bs}{e}%
\right\vert .}
\end{eqnarray}
\end{proof} 
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) ^{t_{e}}=\left\vert \QTR{bs}{e}%
\right\rangle {\cal R}_{e}\left( A\right) ^{\ast t}\left\langle \QTR{bs}{e}%
\right\vert =\left\vert \QTR{bs}{e}\right\rangle {\cal R}_{e}\left( A\right)
^{\dagger }\left\langle \QTR{bs}{e}\right\vert =A^{\dagger }.
\end{equation}
\end{lemma}

\begin{definition}
A vector $v$ ${\cal \in }V$ is

\begin{enumerate}
\item $\sigma _{e}$-{\em real if }%
\begin{equation}
\sigma _{e}\left( v\right) =v.
\end{equation}

\item $\sigma _{e}$-{\em imaginary if }%
\begin{equation}
\sigma _{e}\left( v\right) =-v.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
An operator $A\in {\cal B}\left( {\cal H}\right) $ is

\begin{enumerate}
\item $\sigma _{e}$-{\em real if }%
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =A.
\end{equation}

\item $\sigma _{e}$-{\em imaginary if }%
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =-A.
\end{equation}
\end{enumerate}
\end{definition}

\subsubsection{Real Representations of Vectors}

\begin{lemma}
Any vector $\left\vert v\right\rangle \in {\cal H}$ has a real positive
representation.

\begin{proof}
Let $\left( \QTR{bs}{e}\right) $ be a conb of ${\cal H}$ then 
\begin{equation}
\left\vert v\right\rangle =\left\vert \QTR{bs}{e}\right\rangle {\cal R}%
_{e}\left( v\right) =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle {\cal %
R}_{e}\left( v\right) _{j},\quad {\cal R}_{e}\left( v\right) _{j}\in {\Bbb C}%
.
\end{equation}%
${\cal R}_{e}\left( v\right) _{j}$ can be expresses in polar form as 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}=\left\vert {\cal R}_{e}\left( v\right)
_{j}\right\vert e^{i\theta \left( {\cal R}_{e}\left( v\right) _{j}\right)
},\quad \left\vert {\cal R}_{e}\left( v\right) _{j}\right\vert \in {\Bbb R}
\end{equation}%
hence one obtains the real expansion given by   
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle
\left\vert {\cal R}_{e}\left( v\right) _{j}\right\vert e^{i\theta \left( 
{\cal R}_{e}\left( v\right) _{j}\right) }=%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq r}\left\vert e^{i\theta \left( {\cal R}_{e}\left( v\right)
_{j}\right) }\stackrel{}{e_{j}}\right\rangle \left\vert {\cal R}_{e}\left(
v\right) _{j}\right\vert =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq r}\left\vert \stackrel{}{f_{j}}\right\rangle \left\vert {\cal R%
}_{e}\left( v\right) _{j}\right\vert 
\end{equation}%
and 
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle 
{\cal R}_{f}\left( v\right) _{j},
\end{equation}%
where 
\begin{equation}
\left\vert \stackrel{}{f_{j}}\right\rangle =\left\vert e^{i\theta \left( 
{\cal R}_{e}\left( v\right) _{j}\right) }\stackrel{}{e_{j}}\right\rangle 
\end{equation}%
and 
\begin{equation}
{\cal R}_{f}\left( v\right) _{j}=\left\vert {\cal R}_{e}\left( v\right)
_{j}\right\vert \in {\Bbb R}_{+}.
\end{equation}
\end{proof} Let $\left( \QTR{bs}{e}\right) \,\equiv \left\{ \left.
\left\vert e_{j}\right\rangle \right\vert 1\leq j\leq r\right\} $ be a conb
then 
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle 
{\cal R}_{e}\left( v\right) _{j},\,
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}\in {\Bbb C},\,1\leq j\leq r.
\end{equation}%
Each coefficient ${\cal R}_{e}\left( v\right) _{j}$ can be expanded in polar
form as 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}=\left\vert {\cal R}_{e}\left( v\right)
_{j}\right\vert \exp \left\{ i\theta \left( {\cal R}_{e}\left( v\right)
_{j}\right) \right\} ,\,1\leq j\leq r
\end{equation}%
leading to a new conb 
\begin{equation}
\left\vert f_{j}\right\rangle =\left\vert e_{j}\right\rangle \exp \left\{
i\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) \right\} ,\,1\leq
j\leq r
\end{equation}%
that leads to a a real positive expansion 
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle
\left\vert {\cal R}_{e}\left( v\right) _{j}\right\vert =\sum_{1\leq j\leq
r}\left\vert f_{j}\right\rangle {\cal R}_{f}\left( v\right) _{j}.\,
\end{equation}
\end{lemma}

\begin{remark}
The complex coefficient ${\cal R}_{e}\left( v\right) _{j}$ can be also be
expressed as 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}=\left\vert \stackrel{}{\stackrel{}{{\cal R}%
_{e}\left( v\right) _{j}}}\right\vert \left( \stackrel{}{\cos \left( \theta
\left( \stackrel{}{{\cal R}_{e}\left( v\right) _{j}}\right) \right) +i\sin
\left( \theta \left( \stackrel{}{{\cal R}_{e}\left( v\right) _{j}}\right)
\right) }\right) .
\end{equation}
\end{remark}

\begin{remark}
The transformation 
\begin{equation}
u=\left\vert \QTR{bs}{f}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\end{equation}%
is unitary and has a representation ${\cal R}_{e}\left( u\right) $ given by 
\begin{equation}
{\cal R}_{e}\left( u\right) ={\cal R}_{e}\left( \left\vert \QTR{bs}{f}%
\right\rangle \left\langle \QTR{bs}{e}\right\vert \right) =\left( 
\begin{array}{cccc}
e^{i\theta \left( {\cal R}_{e}\left( v\right) _{1}\right) } & 0 & \cdots & 0
\\ 
0 & \ddots & \cdots & \vdots \\ 
\vdots & \vdots & \ddots & 0 \\ 
0 & \cdots & 0 & e^{i\theta \left( {\cal R}_{e}\left( v\right) _{r}\right) }%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{lemma}
The unjitary group $U\left( r\right) $ has a coset factoriztion 
\begin{equation}
U\left( r\right) =\left( \left. \stackrel{}{U\left( r\right) }\right/
O\left( r,{\Bbb R}\right) \right) O\left( r,{\Bbb R}\right)
\end{equation}%
and the preceding unitary operator $u$ belongs to the coset generated by the
real orthogonal group $O\left( r\right) $ i.e. 
\begin{equation}
u\in \left. \stackrel{}{U\left( r\right) }\right/ O\left( r,{\Bbb R}\right) .
\end{equation}

\begin{proof}
Clearly $u$ does not transform real expansion coeficients to real expansion
coefficients unless   
\begin{equation}
e^{i\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) }=\pm 1
\end{equation}%
i.e.%
\begin{equation}
\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) =2n\pi .
\end{equation}
\end{proof} 
\end{lemma}

\begin{enumerate}
\item The action of group $O\left( r,{\Bbb R}\right) $ conserves the reality
of the $\left( \QTR{bs}{f}\right) $ expansion of $\left\vert v\right\rangle
. $

\item The unitary operator $u$%
\begin{equation}
u=\exp \left\{ -i\sum_{1\leq j\leq r}\left\vert \stackrel{}{e_{j}}%
\right\rangle \left\langle \stackrel{}{e_{j}}\right\vert \theta \left( {\cal %
R}_{e}\left( v\right) _{jj}\right) \right\}
\end{equation}%
does not conserves the reality of the $\left( \QTR{bs}{f}\right) $ expansion
of $\left\vert v\right\rangle \blacksquare .$
\end{enumerate}

\begin{remark}
Polar decomposition of $u\in U\left( r\right) $ 
\begin{equation}
u=\exp \left\{ i\lambda \right\} \exp \left\{ \eta \right\} ,
\end{equation}%
where 
\begin{equation}
\eta =\eta ^{\dagger },\lambda =\lambda ^{\dagger }
\end{equation}%
and 
\begin{equation}
\widehat{\sigma _{e}}\left( \eta \right) =\eta .
\end{equation}
\end{remark}

\begin{remark}
In second quantization%
\begin{equation}
u=\exp \left\{ \frac{1}{2}\sum_{1\leq j<k\leq r}\left( a_{j}^{\dagger
}a_{k}+a_{k}^{\dagger }a_{j}\right) {\cal R}_{a}\left( \lambda _{1}\right)
_{jk}\right\} \exp \left\{ \sum_{1\leq j\leq r}a_{j}^{\dagger }a_{j}{\cal R}%
_{a}\left( \lambda _{0}\right) _{j}\right\} \exp \left\{ \frac{1}{2}%
i\sum_{1\leq j<k\leq r}\left( a_{j}^{\dagger }a_{k}-a_{k}^{\dagger
}a_{j}\right) {\cal R}_{a}\left( \lambda _{-1}\right) _{jk}\right\} .
\end{equation}
\end{remark}

\begin{corollary}
$\left\vert v\right\rangle $ is $\sigma _{f}$-real i.e. 
\begin{equation}
\sigma _{f}\left( v\right) =v.
\end{equation}
\end{corollary}

\subsection{Real Antisymmetric Operators}

\begin{remark}
Let $A$ be a $\sigma _{e}$-{\em real} {\em compact} {\em antisymmetric}
operator $\in {\cal B}_{0}\left( {\cal H}\right) $, then
\end{remark}

\begin{enumerate}
\item 
\begin{equation}
A^{t_{e}}=-A
\end{equation}

and

\item 
\begin{equation}
A=\widehat{\sigma _{e}}\left( A\right) ,
\end{equation}%
where ${\cal H}$ is a complex Hilbert space then

\item it has the canonical expansion 
\begin{equation}
A=\sum_{1\leq j\leq s}\left\{ \left\vert e_{j}\right\rangle \left\langle
e_{j+s}\right\vert -\left\vert e_{_{j+s}}\right\rangle \left\langle
e_{j}\right\vert \right\} {\cal R}_{s}\left( A\right) _{jj}=\sum_{1\leq
j\leq s}\left\{ \left\vert e_{j}\right\rangle \left\langle
e_{j+s}\right\vert -\left\vert e_{_{j+s}}\right\rangle \left\langle
e_{j}\right\vert \right\} \alpha _{j},\,{\cal R}_{s}\left( A\right)
_{jj}=\alpha _{j}\in {\Bbb R},\,1\leq j\leq s.  \label{anti}
\end{equation}
\end{enumerate}

This can be seen from the following:

\begin{lemma}
Every $\sigma _{e}$-{\em real} {\em compact} {\em antisymmetric} operator $%
A\in {\cal B}\left( {\cal H}\right) $ determines a self adjoint operator $%
H\in {\cal B}\left( {\cal H}\right) $ defined by 
\begin{equation}
H=iA.
\end{equation}

\begin{proof}
\begin{equation}
H^{\dagger }=\widehat{\sigma _{e}}\left( H\right) ^{t_{e}}=-iH^{t_{e}}=iA=H
\end{equation}
\end{proof}%
\begin{equation}
H^{\dagger }=-i\widehat{\sigma _{e}}\left( A^{t_{e}}\right) =i\widehat{%
\sigma _{e}}\left( A\right) =iA=H.
\end{equation}
\end{lemma}

\begin{corollary}
The $\sigma _{e}$-real antisymmetric compact operator $A$ has the spectral
expansion 
\begin{equation}
A=\sum_{1\leq j\leq s}\left\{ \left\vert \sigma _{e}\left( v_{j}\right)
\right\rangle \left\langle \sigma _{e}\left( v_{j}\right) \right\vert
-\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert \right\}
i\alpha _{j};\qquad \alpha _{j}\in {\Bbb R},
\end{equation}

\begin{proof}
As $H$ is self adjoint then 
\begin{eqnarray}
H\left\vert v_{j}\right\rangle  &=&\alpha _{j}\left\vert v_{j}\right\rangle 
\\
&\Updownarrow & \\
iA\left\vert v_{j}\right\rangle  &=&\alpha _{j}\left\vert v_{j}\right\rangle 
\\
&\Updownarrow & \\
A\left\vert v_{j}\right\rangle  &=&-i\alpha _{j}\left\vert
v_{j}\right\rangle 
\end{eqnarray}%
and the complex conjuate gives%
\begin{eqnarray}
\sigma _{e}\left( A\left\vert v_{j}\right\rangle \right)  &=&\sigma
_{e}\left( -i\alpha _{j}\left\vert v_{j}\right\rangle \right)  \\
&\Updownarrow & \\
A\left\vert \sigma _{e}\left( v_{j}\right) \right\rangle  &=&i\alpha
_{j}\left\vert \sigma _{e}\left( v_{j}\right) \right\rangle \blacksquare 
\end{eqnarray}
\end{proof}
\end{corollary}

\begin{remark}
\bigskip In finite dimensions we must consider even dimensional spaces or
even dimensional subspaces of codimension 1.
\end{remark}

\begin{lemma}
A real antisymmetric operator $A$ is determined by a self adjoint operator $%
H $ 
\begin{equation}
A=-iH
\end{equation}%
that has paired eigenvalues and complex conjugate eigenvectors.
\end{lemma}

\begin{lemma}
Real antisymmetric operators $A$ and $B$ only commute if they can be
simultaneously diagonalized i.e. for compact operators 
\begin{equation}
\left[ A,B\right] =0\Longleftrightarrow \left\{ 
\begin{array}{c}
A=\sum\limits_{1\leq j\leq r}\left\vert v_{j}\right\rangle \left\langle
v_{j}\right\vert \alpha _{j} \\ 
B=\sum\limits_{1\leq j\leq r}\left\vert v_{j}\right\rangle \left\langle
v_{j}\right\vert \beta _{j}%
\end{array}%
\right. .
\end{equation}
\end{lemma}

\begin{lemma}
If $A$ is \underline{$\sigma _{s}$-{\em real}} and $t_{s}$-antisymmetric
then it is normal i.e. 
\begin{equation}
\left[ A,A^{\dagger }\right] =0
\end{equation}

\begin{proof}
Noting that 
\begin{equation}
{\cal R}_{e}\left( H\right) =i{\cal R}_{e}\left( A\right) ,
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( A\right) \in {\cal B}\left( {\Bbb R}^{r}\right) 
\end{equation}%
then 
\begin{equation}
{\cal R}_{e}\left( H\right) ^{\dagger }=-i{\cal R}_{e}\left( A\right) ^{t}=i%
{\cal R}_{e}\left( A\right) ={\cal R}_{e}\left( H\right) .
\end{equation}%
In the case $A$ is a $\sigma _{e}$-{\em real} {\em antisymmetric} operator
one thus obtains that 
\begin{eqnarray}
\left[ A,A^{\dagger }\right]  &=&AA^{\dagger }-A^{\dagger }A \\
&=&\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\left( \stackrel{}{{\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right)
^{\dagger }-{\cal R}_{e}\left( A\right) ^{\dagger }{\cal R}_{e}\left(
A\right) }\right)  \\
&=&\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\left( \stackrel{}{{\cal R}_{e}\left( iH\right) {\cal R}_{e}\left( iH\right)
^{\dagger }-{\cal R}_{e}\left( iH\right) ^{\dagger }{\cal R}_{e}\left(
iH\right) }\right)  \\
&=&\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\left( \stackrel{}{{\cal R}_{e}\left( H\right) {\cal R}_{e}\left( H\right) -%
{\cal R}_{e}\left( H\right) {\cal R}_{e}\left( H\right) }\right)  \\
&=&0.
\end{eqnarray}
\end{proof}%
\begin{equation}
A=-iH,
\end{equation}%
where 
\begin{equation}
H=H^{\dagger }
\end{equation}%
thus 
\begin{equation}
\left[ A,A^{\dagger }\right] =\left[ -iH,iH\right] =0.\blacksquare
\end{equation}
\end{lemma}

\subsubsection{Real Canonical Expansion of a Real Antisymmetric Operator}

\paragraph{Phase Different Eigenvectors of H\thinspace =\thinspace iA}

{\em It is important to note} that the orthonormal eigenvectors of $H$ are
only defined up to an overall phase factors $e^{i\varphi _{j}}$ which {\em %
do not} preserve the complex conjugate relationship between eigenvectors
associated with paired eigenvalues of opposite sign. These different bases
are related to each other by 
\begin{equation}
\left( \left\vert v_{1}^{\prime }\right\rangle \cdots \left\vert
v_{2s}^{\prime }\right\rangle \right) =\left( \left\vert v_{1}\right\rangle
\cdots \left\vert v_{2s}\right\rangle \right) \left( 
\begin{array}{ccc}
e^{i\varphi _{1}} & {\bf 0} & {\bf 0} \\ 
{\bf 0} & \ddots & {\bf 0} \\ 
{\bf 0} & {\bf 0} & e^{i\varphi _{2s}}%
\end{array}%
\right) .
\end{equation}%
Using a basis with complex conjugate symmetry we obtain 
\begin{equation}
A={\cal -}\sum_{1\leq j\leq s}i\alpha _{j}\left\{ \left\vert
v_{j}^{{}}\right\rangle \left\langle v_{j}^{{}}\right\vert -\left\vert
v_{j}^{\ast }\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\}
;\qquad \alpha _{i}\in {\Bbb R}
\end{equation}

\begin{definition}
We can then define a {\em real} conb $\left\{ \left\vert s_{j}\right\rangle
;1\leq j\leq 2r\right\} $ i.e. $\left\vert s_{j}\right\rangle =\left\vert
s_{j}^{\ast }\right\rangle =\left\vert \sigma _{s}\left( s_{j}\right)
\right\rangle $ by 
\begin{eqnarray}
\left\vert s_{j}\right\rangle &=&\frac{1}{\sqrt{2}}\left( \left\vert
v_{j}\right\rangle +\left\vert v_{j}^{\ast }\right\rangle \right) =\sqrt{2}%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
_{s}\left\vert v_{j}\right\rangle  \nonumber \\
\left\vert s_{j+s}\right\rangle &=&\frac{-i}{\sqrt{2}}\left( \left(
\left\vert v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right)
\right) =\sqrt{2}%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
_{s}\left\vert v_{j}\right\rangle .
\end{eqnarray}%
So that in rearranged form 
\begin{equation}
\left( \stackrel{}{\left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle }\right) =\left( \stackrel{}{\left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle }\right) \frac{1}{%
\sqrt{2}}\left( 
\begin{array}{cccccc}
1 & -i & 0 & 0 & 0 & 0 \\ 
1 & +i & 0 & 0 & 0 & 0 \\ 
0 & 0 & \ddots & 0 & 0 & 0 \\ 
0 & 0 & 0 & \ddots & 0 & 0 \\ 
0 & 0 & 0 & 0 & 1 & -i \\ 
0 & 0 & 0 & 0 & 1 & +i%
\end{array}%
\right) .
\end{equation}
\end{definition}

This gives 
\begin{equation}
A\left\{ \frac{1}{\sqrt{2}}\left( \left\vert v_{j}\right\rangle +\left\vert
v_{j}^{\ast }\right\rangle \right) \right\} =-i\alpha _{j}\frac{1}{\sqrt{2}}%
\left( \left\vert v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle
\right) =\alpha _{j}\left\{ \frac{-i}{\sqrt{2}}\left( \left( \left\vert
v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right) \right)
\right\}  \nonumber
\end{equation}%
i.e. 
\begin{equation}
A\left( 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
_{s}\left( \left\vert v_{j}\right\rangle \right) \right) =\alpha _{j}\left( 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
_{s}\left( \left\vert v_{j}\right\rangle \right) \right)  \nonumber
\end{equation}%
and 
\begin{equation}
A\left\{ \frac{-i}{\sqrt{2}}\left( \left( \left\vert v_{j}\right\rangle
-\left\vert v_{j}^{\ast }\right\rangle \right) \right) \right\} =\frac{%
-\alpha _{j}}{\sqrt{2}}\left\vert v_{j}\right\rangle -\frac{\alpha _{j}}{%
\sqrt{2}}\left\vert v_{j}^{\ast }\right\rangle =-\alpha _{j}\left\{ \frac{1}{%
\sqrt{2}}\left( \left\vert v_{j}\right\rangle +\left\vert v_{j}^{\ast
}\right\rangle \right) \right\}  \nonumber
\end{equation}%
i.e. 
\begin{equation}
A\left( 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
_{s}\left( \left\vert v_{j}\right\rangle \right) \right) =-\alpha _{j}\left( 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
_{s}\left( \left\vert v_{j}\right\rangle \right) \right) .  \nonumber
\end{equation}%
Thus 
\begin{equation}
A=\sum_{1\leq j\leq s}\alpha _{j}\left\{ \left\vert s_{j}\right\rangle
\left\langle s_{j+s}\right\vert -\left\vert s_{j+s}\right\rangle
\left\langle s_{j}\right\vert \right\}
\end{equation}%
which justifies the expansion in eq. $\left( \ref{anti}\right) $. Using the
bases $\left\{ \left\vert s_{j}\right\rangle ;1\leq j\leq 2r\right\} $ we
can produce the canonical matrix representation ${\cal R}_{s}\left( A\right) 
$ of $A$ 
\begin{equation}
A\left( \left\vert {\bf s}\right\rangle \right) =\left\vert {\bf s}%
\right\rangle \left( 
\begin{array}{cc}
{\Bbb O} & {\bf \alpha } \\ 
-{\bf \alpha } & {\Bbb O}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
{\bf \alpha =}\left( 
\begin{array}{ccc}
\alpha _{1} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & \ddots & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \alpha _{s}%
\end{array}%
\right) .
\end{equation}%
One can reorder this basis to obtain 
\begin{equation}
A\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right)
\end{equation}%
and the expansion 
\begin{equation}
A=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle
\cdots \left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
\left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right) .  \label{reex}
\end{equation}%
and the expansion%
\[
A=\left( \stackrel{}{\left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle }\right) {\cal R}_{s}\left( A\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right) =\left( \stackrel{}{\left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle }\right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right) , 
\]%
which gives 
\begin{eqnarray}
{\cal R}_{s}\left( A\right) &=&\left( \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{1}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{1}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{1+s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{1+s}\right) _{r}%
\end{array}%
\right) \cdots \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{s}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{2s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{2s}\right) _{r}%
\end{array}%
\right) \right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right) \\
&&\times \left( \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{1}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{1}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{1+s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{1+s}\right) _{r}%
\end{array}%
\right) \cdots \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{s}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( s_{2s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( s_{2s}\right) _{r}%
\end{array}%
\right) \right) ^{\dagger },
\end{eqnarray}

\begin{remark}
\begin{gather}
A=\left( \stackrel{}{\left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle }\right) {\cal R}_{s}\left( A\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right) =\left( \stackrel{}{\left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle }\right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right) \\
\parallel \\
\left( \stackrel{}{\left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle }\right) {\cal R}_{v}\left( A\right) \left( 
\begin{array}{c}
\left\langle v_{1}\right\vert \\ 
\left\langle v_{1}^{\ast }\right\vert \\ 
\vdots \\ 
\left\langle v_{s}\right\vert \\ 
\left\langle v_{s}^{\ast }\right\vert%
\end{array}%
\right) =\left( \stackrel{}{\left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle }\right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle v_{1}\right\vert \\ 
\left\langle v_{1}^{\ast }\right\vert \\ 
\vdots \\ 
\left\langle v_{s}\right\vert \\ 
\left\langle v_{s}^{\ast }\right\vert%
\end{array}%
\right) .
\end{gather}
\end{remark}

\begin{theorem}
In general real antisymmetric operators $A$,$B{\cal \in B}\left( {\Bbb R}%
^{2s}\right) $ do not commute.

\begin{proof}
\end{proof} In general they are not simultaneously diagonalizable therefore
do not commute.
\end{theorem}

\paragraph{Spectral Representation of Real Antisymmetric Operators}

The row vector of basis vectors, $\left( \left\vert s_{1}\right\rangle
\left\vert s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle
\left\vert s_{s+s}\right\rangle \right) $ can be viewed as a real orthogonal
matrix whose columns are the real basis vectors $\left\{ \cdots ,\left\vert
s_{j}\right\rangle ,\left\vert s_{s+j}\right\rangle ,\cdots \right\} $.

The complex basis $\left\{ \left\vert v_{j}\right\rangle ,\left\vert
v_{j}^{\ast }\right\rangle ;1\leq j\leq s\right\} $ diagonalizes $A$ to give 
\begin{equation}
A\left( \left\vert {\bf v}\right\rangle ,\left\vert {\bf v}^{\ast
}\right\rangle \right) =\left( \left\vert {\bf v}\right\rangle ,\left\vert 
{\bf v}^{\ast }\right\rangle \right) \left( 
\begin{array}{cc}
-i{\bf \alpha } & {\Bbb O} \\ 
{\Bbb O} & i{\bf \alpha }%
\end{array}%
\right)
\end{equation}%
this basis can also be reordered to produce 
\begin{equation}
A\left( \left\vert \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right\rangle \right) =\left( \left\vert v_{1}\right\rangle
\left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle
\left\vert v_{s}^{\ast }\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right)
\end{equation}%
and the expansion%
\[
A=\left( \stackrel{}{\left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle }\right) {\cal R}_{v}\left( A\right) \left( 
\begin{array}{c}
\left\langle v_{1}\right\vert \\ 
\left\langle v_{1}^{\ast }\right\vert \\ 
\vdots \\ 
\left\langle v_{s}\right\vert \\ 
\left\langle v_{s}^{\ast }\right\vert%
\end{array}%
\right) =\left( \stackrel{}{\left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle }\right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle v_{1}\right\vert \\ 
\left\langle v_{1}^{\ast }\right\vert \\ 
\vdots \\ 
\left\langle v_{s}\right\vert \\ 
\left\langle v_{s}^{\ast }\right\vert%
\end{array}%
\right) 
\]%
which gives 
\begin{eqnarray}
{\cal R}_{e}\left( A\right) &=&\left( \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{1}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{1}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{1}\right) _{1}^{\ast } \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{1}\right) _{r}^{\ast }%
\end{array}%
\right) \cdots \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{s}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{s}\right) _{1}^{\ast } \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{s}\right) _{r}^{\ast }%
\end{array}%
\right) \right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right) \\
&&\times \left( \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{1}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{1}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{1}\right) _{1}^{\ast } \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{1}\right) _{r}^{\ast }%
\end{array}%
\right) \cdots \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{s}\right) _{1} \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{s}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
{\cal R}_{e}\left( v_{s}\right) _{1}^{\ast } \\ 
\vdots \\ 
{\cal R}_{e}\left( v_{s}\right) _{r}^{\ast }%
\end{array}%
\right) \right) ^{\dagger },
\end{eqnarray}%
where ${\cal R}_{v}\left( A\right) =\left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right) $.

\begin{remark}
The three basic forms of a real antisymmetric operator $A$ are the

\begin{enumerate}
\item standard form 
\[
A=\left\vert {\bf w}\right\rangle {\cal R}_{w}\left( A\right) \left\langle 
{\bf w}\right\vert =\sum_{1\leq j<k\leq r}\left\{ \left\vert
w_{j}\right\rangle \left\langle w_{k}\right\vert -\left\vert
w_{k}\right\rangle \left\langle w_{j}\right\vert \right\} {\cal R}_{w}\left(
A\right) _{jk};\quad {\cal R}_{w}\left( A\right) _{jk}=-{\cal R}_{w}\left(
A\right) _{kj}\in {\Bbb R},1\leq j<k\leq r=2s, 
\]%
where $\left( {\bf w}\right) $ is real orthonormal basis of ${\Bbb R}^{2s}$

\item spectral form 
\begin{align}
A& =\sum_{1\leq j\leq s}\left\{ \left\vert \sigma _{v}\left( v_{j}\right)
\right\rangle \left\langle \sigma _{e}\left( v_{j}\right) \right\vert
-\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert \right\}
i\alpha _{j} \\
& =\sum_{1\leq j\leq s}\left\{ \left\vert \sigma _{v}\left( v_{j}\right)
\right\rangle \left\langle \sigma _{v}\left( v_{j}\right) \right\vert
-\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert \right\} {\cal R%
}_{v}\left( A\right) _{jj} \\
\qquad & =\sum_{1\leq j\leq s}\left\{ \left\vert \sigma _{v}\left(
v_{j}\right) \right\rangle {\cal R}_{v}\left( A\right) _{jj}\left\langle
\sigma _{v}\left( v_{j}\right) \right\vert -\left\vert v_{j}\right\rangle 
{\cal R}_{v}\left( A\right) _{jj}\left\langle v_{j}\right\vert \right\} ; \\
\qquad {\cal R}_{v}\left( A\right) _{jj}& =i\alpha _{j}\in {\Bbb C}
\end{align}%
and

\item canonical form 
\begin{eqnarray}
A &=&\sum_{1\leq j\leq s}\left\{ \left\vert s_{j}\right\rangle \left\langle
s_{j\QTR{bs}{+}s}\right\vert -\left\vert s_{j\QTR{bs}{+}s}\right\rangle
\left\langle s_{j}\right\vert \right\} \alpha _{j} \\
&=&\sum_{1\leq j\leq s}\left\{ \left\vert s_{j}\right\rangle \left\langle
s_{j\QTR{bs}{+}s}\right\vert -\left\vert s_{j\QTR{bs}{+}s}\right\rangle
\left\langle s_{j}\right\vert \right\} {\cal R}_{s}\left( A\right) _{jj+s} \\
&=&\sum_{1\leq j\leq s}\left\{ \left\vert s_{j}\right\rangle {\cal R}%
_{s}\left( A\right) _{jj+s}\left\langle s_{j\QTR{bs}{+}s}\right\vert
-\left\vert s_{j\QTR{bs}{+}s}\right\rangle {\cal R}_{s}\left( A\right)
_{j+sj}\left\langle s_{j}\right\vert \right\} ; \\
\qquad {\cal R}_{s}\left( A\right) _{jj+s} &=&\alpha _{j},{\cal R}_{s}\left(
A\right) _{j+sj}=-\alpha _{j}\in {\Bbb R};.
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{remark}
The preceding basis $\left( \QTR{bs}{s}\right) $ is $\sigma _{v}$-real 
\begin{equation}
\left\vert \sigma _{v}\left( s_{j}\right) \right\rangle =\left\vert
s_{j}\right\rangle
\end{equation}%
and $A$ is $s$-antisymmetric 
\begin{equation}
A^{t_{s}}=-A^{t_{s}}
\end{equation}%
thus 
\begin{eqnarray}
A^{t_{s}} &=&\left( \sum_{1\leq j\leq s}\left\{ \left\vert \sigma _{v}\left(
v_{j}\right) \right\rangle \left\langle \sigma _{v}\left( v_{j}\right)
\right\vert -\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert
\right\} {\cal R}_{v}\left( A\right) _{jj}\right) ^{t_{s}}=-A=\sum_{1\leq
j\leq s}\left\{ \left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert
-\left\vert \sigma _{v}\left( v_{j}\right) \right\rangle \left\langle \sigma
_{v}\left( v_{j}\right) \right\vert \right\} i\alpha _{j} \\
&=&\widehat{\sigma _{v}}\left( A\right) =-A
\end{eqnarray}
\end{remark}

\section{Complex Antisymmetric Operator and Matrices}

\begin{definition}
An operator $A\in $ ${\cal B}\left( {\cal H}\right) $ is normal if 
\begin{equation}
\left[ A,A^{\dagger }\right] =0,
\end{equation}
\end{definition}

\begin{remark}
Representations ${\cal R}_{e}\left( A\right) \in $ ${\cal B}\left( {\Bbb C}%
^{n}\right) $ of an operator $A\in {\cal B}\left( {\cal H}\right) $ wrt a
conb $\left( \QTR{bs}{e}\right) $

\begin{enumerate}
\item are produced by the expansions%
\begin{equation}
A=\left( \left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}%
\right\vert \right) {\cal R}_{e}\left( A\right) =\left\vert \QTR{bs}{e}%
\right\rangle {\cal R}_{e}\left( A\right) \left\langle \QTR{bs}{e}\right\vert
\end{equation}%
and

\item decomposed into real and imaginary {\em number} parts by 
\begin{equation}
{\cal R}_{e}\left( A\right) =%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) ,
\end{equation}%
where 
\begin{equation}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) \in {\cal B}\left( {\Bbb R}%
^{n}\right) .
\end{equation}

\item If ${\cal R}_{e}\left( A\right) $ is complex antisymmetric i.e. 
\begin{equation}
{\cal R}_{e}\left( A\right) ^{t}=-{\cal R}_{e}\left( A\right)
\end{equation}%
then 
\begin{equation}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) ^{t}=-%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) -i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right)
\end{equation}%
showing that its real and imaginary parts are real antisymmetric i.e. 
\begin{equation}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) ^{t}=-%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right)
\end{equation}%
and 
\begin{equation}
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) ^{t}=-%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{theorem}
$A$ is a normal operator $%
%TCIMACRO{\limfunc{Iff}}%
%BeginExpansion
\mathop{\rm Iff}%
%EndExpansion
$ the real and imaginary {\em number} parts of ${\cal R}_{e}\left( A\right) $
commute i.e. 
\begin{equation}
\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) }\right] =0.
\end{equation}

\begin{proof}
The commutator of the representation ${\cal R}_{e}\left( {\cal A}\right) $
and its adjoint gives 
\begin{eqnarray*}
\left[ {\cal R}_{e}\left( {\cal A}\right) ,{\cal R}_{e}\left( {\cal A}%
\right) ^{\dagger }\right]  &=&\left[ \left( \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
