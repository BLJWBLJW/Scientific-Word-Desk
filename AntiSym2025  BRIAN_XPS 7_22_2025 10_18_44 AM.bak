}\left( A\right) =-\frac{i}{2}\left( A-A^{\dagger }\right) ={\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) ^{\dagger }.
\end{equation}%
Hence 
\begin{equation}
A={\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) +i{\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) .
\end{equation}
\end{enumerate}
\end{definition}

