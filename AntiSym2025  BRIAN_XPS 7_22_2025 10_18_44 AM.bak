\label{Complex Conjugate}

\begin{definition}
The {\em Complex Conjugate}, $\widehat{\sigma _{e}}\left( {\cal A}\right) $
of an operator ${\cal A\in B}\left( {\cal H}\right) $ is defined by

\begin{enumerate}
\item 
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) ={\cal R}_{e}^{-1}\left( \left( {\cal R}%
_{e}\left( A\right) \right) ^{\ast }\right) ,
\end{equation}%
where the representation ${\cal R}_{e}$ is faithul and given in general by

\item 
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =\left\vert \QTR{bs}{e}\right\rangle
\left\langle \QTR{bs}{e}\right\vert \left( {\cal R}_{e}\left( A\right)
\right) ^{\ast }.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
The $\left( \QTR{bs}{e}\right) $-{\em Transpose} $A^{t_{e}}$ of an operator $%
A\in {\cal B}\left( {\cal H}\right) $ is defined by

\begin{enumerate}
\item 
\begin{equation}
A^{t_{e}}={\cal R}_{e}^{-1}\left( \left( {\cal R}_{e}\left( A\right) \right)
^{t}\right)
\end{equation}%
where the representation ${\cal R}_{e}$ is faithul and in general by

\item 
\begin{equation}
A^{t_{e}}=\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}%
\right\vert \left( {\cal R}_{e}\left( A\right) \right) ^{t}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{enumerate}
\item 
\begin{equation}
A=\left( \left\vert \stackrel{}{\QTR{bs}{e}}\right\rangle \left\langle 
\stackrel{}{\QTR{bs}{e}}\right\vert \right) {\cal R}_{e}\left( A\right)
=\left\vert \stackrel{}{\QTR{bs}{e}}\right\rangle {\cal R}_{e}\left(
A\right) \left\langle \stackrel{}{\QTR{bs}{e}}\right\vert .
\end{equation}

\item 
\begin{equation}
{\cal R}_{e}\left( A\right) =%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( A\right) \right) .
\end{equation}
\end{enumerate}

