\begin{definition}
Let $A\in {\cal M}\left( 2r,2r,{\Bbb C}\right) $ we define the matrices $%
{\cal M}$ and ${\cal N}$ by

\begin{enumerate}
\item 
\begin{equation}
{\cal M=-}i{\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) \Leftrightarrow {\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) =i{\cal M}
\end{equation}%
and

\item 
\begin{equation}
{\cal N}=i{\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) \Leftrightarrow {\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) =-i{\cal N},  \nonumber
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
\begin{equation}
A=i{\cal M}+{\cal N}.
\end{equation}
\end{lemma}

\begin{remark}
