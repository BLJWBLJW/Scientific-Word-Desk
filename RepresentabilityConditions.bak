\section{Positive Extension Conditions}

\subsection{Representability}

The necessary and sufficient conditions for the existance of a state that
extends a linear functional $f_{2}$ defined on $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e2}$ to $f$ defined on $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ are:

\begin{enumerate}
\item \emph{Pair Occupation Number Condition (Generalized P Condition)}
\begin{align}
1  &  \geq f\left(  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}%
}\right)  =f\left(  \Phi\left(  \psi_{j_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{1}}\right)  \Phi\left(
\psi_{j_{2}}\right)  \right)  \geq0\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}.
\label{PairOcc1}%
\end{align}


\begin{enumerate}
\item The density operator version of this
\begin{equation}
1\geq\left(  \left.  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}%
}\right\vert D\right)  =\left(  \left.  \left\vert \psi_{j_{1}}\psi_{j_{2}%
}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}}\right\vert \right\vert
D_{2}\right)  \geq0
\end{equation}


\item The Q-symbol version of this condition is
\begin{equation}
\left\Vert \tilde{Q}_{D_{2}}\right\Vert _{\infty}=\sup_{\mathbf{z\in
}\mathbb{C}^{2\left(  r-2\right)  }}\left\{  \tilde{Q}_{D_{2}}\right\}
=\sup_{\mathbf{z\in}\mathbb{C}^{r\left(  r-2\right)  }}\left\{  \frac
{\left\langle \psi_{1}\left(  \mathbf{z}\right)  \psi_{2}\left(
\mathbf{z}\right)  \left\vert D_{2}\psi_{1}\left(  \mathbf{z}\right)  \psi
_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle }{\det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  }\right\}
\leq1,\nonumber
\end{equation}
if further the extending state describes on the average $\binom{N}{2}$ pairs
of fermions then one must add the
\end{enumerate}

\item \emph{Pair} \emph{Normalization Condition}%
\begin{equation}
f\left(  \mathcal{N}_{2}\right)  =\binom{N}{2}.
\end{equation}


a. The density operator version of this is
\begin{equation}
\left(  \left.  \mathcal{N}_{2}\right\vert D\right)  =\left(  \left.
\sum_{1\leq j_{1}<j_{2}\leq r}\left\vert \psi_{j_{1}}\psi_{j_{2}}\right\rangle
\left\langle \psi_{j_{1}}\psi_{j_{2}}\right\vert \right\vert D_{2}\right)
=\operatorname*{Tr}\left\{  D_{2}\right\}  =\binom{N}{2}.
\end{equation}
b. The Q-symbol version of this condition is
\begin{equation}
\qquad\int Q_{D_{2}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z}%
,z}\right)  d\mu\left(  \mathbf{z}\right)  =\int\tilde{Q}_{D_{2}}\left(
\mathbf{z}\right)  d\tilde{\mu}\left(  \mathbf{z}\right)  =\left\Vert
\tilde{Q}_{D_{2}}\right\Vert _{1}=\binom{N}{2}.
\end{equation}
If the linear functional is defined on $\Lambda_{2}=\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e2}\oplus\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e1}$ then one must consider extra conditions for
extending these linear functionals to $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ and must add the following two conditions:

\item \emph{Generalized G Condition }
\begin{align}
1  &  \geq f\left(  b_{j_{1}}^{\dagger}b_{j_{2}}b_{j_{2}}^{\dagger}b_{j_{1}%
}\right)  =f\left(  \Phi\left(  \psi_{j_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  \Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{1}}\right)  \right)  \geq0\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1},
\end{align}
which is equivalent to
\begin{align}
1  &  \geq f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  -f\left(  b_{j_{1}%
}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0,\nonumber\\
1  &  \geq f\left(  b_{j_{2}}^{\dagger}b_{j_{2}}\right)  -f\left(  b_{j_{1}%
}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0
\end{align}
and%
\begin{align}
1  &  \geq f\left(  \Phi\left(  \psi_{j_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{1}}\right)  \right)  -f\left(  \Phi\left(  \psi_{j_{1}}\right)
^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{2}%
}\right)  \Phi\left(  \psi_{j_{1}}\right)  \right)  \geq0,\nonumber\\
1  &  \geq f\left(  \Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  \right)  -f\left(  \Phi\left(  \psi_{j_{1}}\right)
^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{2}%
}\right)  \Phi\left(  \psi_{j_{1}}\right)  \right)  \geq0,
\end{align}
a. the density operator version of this is
\begin{align}
1  &  \geq\left(  \left.  \left\vert \psi_{j_{1}}\right\rangle \left\langle
\psi_{j_{1}}\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert
\psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  \geq0\nonumber\\
1  &  \geq\left(  \left.  \left\vert \psi_{j_{2}}\right\rangle \left\langle
\psi_{j_{2}}\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert
\psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  \geq0,
\end{align}
b. the Q-symbol version of this condition is%
\begin{align}
1  &  \geq\left(  \left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert \tilde{\psi
}_{1}\left(  \mathbf{z}\right)  \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\tilde{\psi}_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert
D_{2}\right)  \geq0\nonumber\\
1  &  \geq\left(  \left.  \left\vert \tilde{\psi}_{2}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert \tilde{\psi
}_{1}\left(  \mathbf{z}\right)  \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\tilde{\psi}_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert
D_{2}\right)  \geq0,
\end{align}
which can be expressed as
\begin{equation}
1\geq Q_{1D_{1}}\mathbf{\geq}Q_{D_{2}}\geq0
\end{equation}%
\begin{equation}
1\geq Q_{2D_{1}}\mathbf{\geq}Q_{D_{2}}\geq0
\end{equation}
and the

\item \emph{Generalized Q Condition }is%
\begin{align}
1  &  \geq f\left(  b_{j_{2}}b_{j_{1}}b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger
}\right)  \geq0\Leftrightarrow1\geq1-f\left(  b_{j_{2}}^{\dagger}b_{j_{2}%
}\right)  -f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  +f\left(  b_{j_{1}%
}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0\nonumber\\
&  \Leftrightarrow0\geq f\left(  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger
}b_{j_{2}}b_{j_{1}}\right)  -f\left(  b_{j_{2}}^{\dagger}b_{j_{2}}\right)
-f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  \geq-1\nonumber\\
&  \Leftrightarrow1\geq f\left(  b_{j_{2}}^{\dagger}b_{j_{2}}\right)
+f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  -f\left(  b_{j_{1}}^{\dagger
}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0
\end{align}
equivalently
\begin{equation}
1\geq f\left(  \Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  \right)  +f\left(  \Phi\left(  \psi_{j_{2}}\right)
^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  \right)  -f\left(  \Phi\left(
\psi_{j_{1}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}%
\Phi\left(  \psi_{j_{2}}\right)  \Phi\left(  \psi_{j_{1}}\right)  \right)
\geq0.
\end{equation}
This condition is a result of the fact that one has the idempotent identities
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}-b_{j_{2}}b_{j_{1}}b_{j_{1}}^{\dagger}b_{j_{2}%
}^{\dagger}=b_{j_{1}}^{\dagger}b_{j_{1}}+b_{j_{2}}^{\dagger}b_{j_{2}}%
-b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}%
\end{equation}%
\begin{equation}
\left(  I_{\mathcal{H}_{\mathcal{F}}}-b_{j_{2}}b_{j_{1}}b_{j_{1}}^{\dagger
}b_{j_{2}}^{\dagger}\right)  ^{2}=I_{\mathcal{H}_{\mathcal{F}}}-b_{j_{2}%
}b_{j_{1}}b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}.
\end{equation}
a. The density operator version of this is
\begin{equation}
1\geq\left(  \left.  \left\vert \psi_{j_{2}}\right\rangle \left\langle
\psi_{j_{2}}\right\vert \right\vert D_{1}\right)  +\left(  \left.  \left\vert
\psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  -\left(  \left.  \left\vert \psi
_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  \geq0.
\end{equation}
b. The Q-symbol version of this condition is%
\begin{equation}
1\geq\left(  \left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  +\left(  \left.  \left\vert \tilde{\psi
}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\psi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert D_{1}\right)  -\left(
\left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}\right)  \tilde{\psi}%
_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\psi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{2}\right)  \geq0.\nonumber
\end{equation}


\item \emph{Occupation Number Condition}
\begin{align}
1  &  \geq f\left(  b_{j}^{\dagger}b_{j}\right)  =f\left(  \Phi\left(
\psi_{j}\right)  ^{\dagger}\Phi\left(  \psi_{j}\right)  \right)
\geq0\,\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}%
\end{align}
a. The density operator version of this is%
\begin{equation}
1\geq\left(  \left.  \left\vert \psi_{j}\right\rangle \left\langle \psi
_{j}\right\vert \right\vert D_{1}\right)  \geq0
\end{equation}
b. The Q-symbol version of this condition is%
\begin{align}
1  &  \geq\left(  \left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  \geq0\nonumber\\
1  &  \geq\left(  \left.  \left\vert \tilde{\psi}_{2}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  \geq0
\end{align}


\item \emph{Particle} \emph{Normalization Condition }%
\begin{equation}
f\left(  \mathcal{N}_{1}\right)  =N.
\end{equation}
a. The density operator version of this is
\begin{equation}
\left(  \left.  \mathcal{N}_{1}\right\vert D\right)  =\left(  \left.
\sum_{1\leq j_{1}\leq r}\left\vert \psi_{j_{1}}\right\rangle \left\langle
\psi_{j_{1}}\right\vert \right\vert D_{1}\right)  =\operatorname*{Tr}\left\{
D_{1}\right\}  =N.
\end{equation}
b. The Q-symbol version of this condition is
\begin{equation}
\int\left(  \left.  \left\{  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert +\left\vert \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\}  \right\vert D_{1}\right)  d\tilde{\mu}\left(
\mathbf{z}\right)  =N.
\end{equation}
The set of operators satisfying the condition (1) - (6) form the set
$\mathcal{S}_{2}$ of Second Order Reduced states i.e. the set of Representable SORDO's.
\end{enumerate}

\subsection{N-Representability}

\qquad In order for a linear functional be the restriciton of a pure number
state it must satisfy
\begin{equation}
f_{2}\left(  \mathcal{N}_{1}^{2}\right)  =f_{2}\left(  \mathcal{N}_{1}\right)
^{2}=N^{2}%
\end{equation}
i.e. its expectation value must be dispersion free on the number operator,
where $N$ is some fixed integer. Thus $f_{2}$ must be defined on $\Lambda_{1}%
$, $D_{1}$ a linear functional of $D_{2}$ (a necessary condition for $f_{2}$
to be extended to a pure number state) and the values of $f_{2}$ on
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}$ related to the
values on $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2}$ by
$f_{2}\left(  b_{j}^{\dagger}b_{k}\right)  =\left(  N-1\right)  ^{-1}%
f_{2}\left(  b_{j}^{\dagger}\mathcal{N}_{1}b_{k}\right)  .$ If the

\begin{enumerate}
\item[1] \emph{Pair} \emph{Normalization Condition}%
\begin{equation}
f\left(  \mathcal{N}_{2}\right)  =\binom{N}{2}%
\end{equation}
a. The density operator version of this is
\begin{equation}
\left(  \left.  \mathcal{N}_{2}\right\vert D\right)  =\left(  \left.
\sum_{1\leq j_{1}<j_{2}\leq r}\left\vert \psi_{j_{1}}\psi_{j_{2}}\right\rangle
\left\langle \psi_{j_{1}}\psi_{j_{2}}\right\vert \right\vert D_{2}\right)
=\operatorname*{Tr}\left\{  D_{2}\right\}  =\binom{N}{2}.
\end{equation}
b. The Q-symbol version of this condition is
\begin{equation}
\qquad\int Q_{D_{2}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z}%
,z}\right)  d\mu\left(  \mathbf{z}\right)  =\int\tilde{Q}_{D_{2}}\left(
\mathbf{z}\right)  d\tilde{\mu}\left(  \mathbf{z}\right)  =\left\Vert
\tilde{Q}_{D_{2}}\right\Vert _{1}=\binom{N}{2}.
\end{equation}
is satisfied then eq. $\left(  \ref{one_def}\right)  $ is equivalent to
\begin{subequations}
\begin{equation}
f_{2}\left(  \mathcal{N}_{1}^{2}\right)  =f_{2}\left(  \mathcal{N}_{1}\right)
^{2}%
\end{equation}
and
\end{subequations}
\begin{equation}
f_{2}\left(  \mathcal{N}_{1}\right)  =N,
\end{equation}
i.e. $f_{2}$ is dispersion free on the number operator.

The necessary and sufficient conditions for the existance of a pure number
state $f$ that is the extension of a linear functional $f_{2}$ defined on
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2}$ (and extended to
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}$in the preceding
manner) to $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ are:

\item[2.] \emph{Pair Occupation Number Condition (Generalized P Condition)}
\begin{align}
1  &  \geq f\left(  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}%
}\right)  =f\left(  \Phi\left(  \psi_{j_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{1}}\right)  \Phi\left(
\psi_{j_{2}}\right)  \right)  \geq0\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}.
\end{align}
a. The density operator version of this
\begin{equation}
1\geq\left(  \left.  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}%
}\right\vert D\right)  =\left(  \left.  \left\vert \psi_{j_{1}}\psi_{j_{2}%
}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}}\right\vert \right\vert
D_{2}\right)  \geq0
\end{equation}
b. The Q-symbol version of this condition is
\begin{equation}
\left\Vert \tilde{Q}_{D_{2}}\right\Vert _{\infty}=\sup_{\mathbf{z\in
}\mathbb{C}^{2\left(  r-2\right)  }}\left\{  \tilde{Q}_{D_{2}}\right\}
=\sup_{\mathbf{z\in}\mathbb{C}^{r\left(  r-2\right)  }}\left\{  \frac
{\left\langle \psi_{1}\left(  \mathbf{z}\right)  \psi_{2}\left(
\mathbf{z}\right)  \left\vert D_{2}\psi_{1}\left(  \mathbf{z}\right)  \psi
_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle }{\det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  }\right\}
\leq1,\nonumber
\end{equation}


\item \emph{Generalized G Condition }
\begin{align}
1  &  \geq f\left(  b_{j_{1}}^{\dagger}b_{j_{2}}b_{j_{2}}^{\dagger}b_{j_{1}%
}\right)  =f\left(  \Phi\left(  \psi_{j_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  \Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{1}}\right)  \right)  \geq0\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1},
\end{align}
which is equivalent to
\begin{align}
1  &  \geq f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  -f\left(  b_{j_{1}%
}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0,\nonumber\\
1  &  \geq f\left(  b_{j_{2}}^{\dagger}b_{j_{2}}\right)  -f\left(  b_{j_{1}%
}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0
\end{align}
and%
\begin{align}
1  &  \geq f\left(  \Phi\left(  \psi_{j_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{1}}\right)  \right)  -f\left(  \Phi\left(  \psi_{j_{1}}\right)
^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{2}%
}\right)  \Phi\left(  \psi_{j_{1}}\right)  \right)  \geq0,\nonumber\\
1  &  \geq f\left(  \Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  \right)  -f\left(  \Phi\left(  \psi_{j_{1}}\right)
^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{2}%
}\right)  \Phi\left(  \psi_{j_{1}}\right)  \right)  \geq0,
\end{align}
a. the density operator version of this is
\begin{align}
1  &  \geq\left(  \left.  \left\vert \psi_{j_{1}}\right\rangle \left\langle
\psi_{j_{1}}\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert
\psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  \geq0\nonumber\\
1  &  \geq\left(  \left.  \left\vert \psi_{j_{2}}\right\rangle \left\langle
\psi_{j_{2}}\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert
\psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  \geq0,
\end{align}
b. the Q-symbol version of this condition is%
\begin{align}
1  &  \geq\left(  \left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert \tilde{\psi
}_{1}\left(  \mathbf{z}\right)  \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\tilde{\psi}_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert
D_{2}\right)  \geq0\nonumber\\
1  &  \geq\left(  \left.  \left\vert \tilde{\psi}_{2}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  -\left(  \left.  \left\vert \tilde{\psi
}_{1}\left(  \mathbf{z}\right)  \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\tilde{\psi}_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert
D_{2}\right)  \geq0,
\end{align}
which can be expressed as
\begin{equation}
1\geq\left[  \mathcal{L}_{11}\left(  \tilde{Q}_{D_{2}}\right)  \right]
\left(  \mathbf{z}\right)  -\tilde{Q}_{D_{2}}\left(  \mathbf{z}\right)  \geq0
\end{equation}%
\begin{equation}
1\geq\left[  \mathcal{L}_{22}\left(  \tilde{Q}_{D_{2}}\right)  \right]
\left(  \mathbf{z}\right)  -\tilde{Q}_{D_{2}}\left(  \mathbf{z}\right)  \geq0
\end{equation}
i.e.
\begin{align}
1  &  \geq\mathcal{L}_{11}\left(  \tilde{Q}_{D_{2}}\right)  -\tilde{Q}_{D_{2}%
}\geq0\\
1  &  \geq\mathcal{L}_{22}\left(  \tilde{Q}_{D_{2}}\right)  -\tilde{Q}_{D_{2}%
}\geq0
\end{align}


\item \emph{Generalized Q Condition }is%
\begin{align}
1  &  \geq f\left(  b_{j_{2}}b_{j_{1}}b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger
}\right)  \geq0\Leftrightarrow1\geq1-f\left(  b_{j_{2}}^{\dagger}b_{j_{2}%
}\right)  -f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  +f\left(  b_{j_{1}%
}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0\nonumber\\
&  \Leftrightarrow0\geq f\left(  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger
}b_{j_{2}}b_{j_{1}}\right)  -f\left(  b_{j_{2}}^{\dagger}b_{j_{2}}\right)
-f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  \geq-1\nonumber\\
&  \Leftrightarrow1\geq f\left(  b_{j_{2}}^{\dagger}b_{j_{2}}\right)
+f\left(  b_{j_{1}}^{\dagger}b_{j_{1}}\right)  -f\left(  b_{j_{1}}^{\dagger
}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}\right)  \geq0
\end{align}
equivalently
\begin{equation}
1\geq f\left(  \Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{j_{2}}\right)  \right)  +f\left(  \Phi\left(  \psi_{j_{2}}\right)
^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  \right)  -f\left(  \Phi\left(
\psi_{j_{1}}\right)  ^{\dagger}\Phi\left(  \psi_{j_{2}}\right)  ^{\dagger}%
\Phi\left(  \psi_{j_{2}}\right)  \Phi\left(  \psi_{j_{1}}\right)  \right)
\geq0.
\end{equation}
This condition is a result of the fact that one has the idempotent identities
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}-b_{j_{2}}b_{j_{1}}b_{j_{1}}^{\dagger}b_{j_{2}%
}^{\dagger}=b_{j_{1}}^{\dagger}b_{j_{1}}+b_{j_{2}}^{\dagger}b_{j_{2}}%
-b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{j_{2}}b_{j_{1}}%
\end{equation}%
\begin{equation}
\left(  I_{\mathcal{H}_{\mathcal{F}}}-b_{j_{2}}b_{j_{1}}b_{j_{1}}^{\dagger
}b_{j_{2}}^{\dagger}\right)  ^{2}=I_{\mathcal{H}_{\mathcal{F}}}-b_{j_{2}%
}b_{j_{1}}b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}.
\end{equation}
a. The density operator version of this is
\begin{equation}
1\geq\left(  \left.  \left\vert \psi_{j_{2}}\right\rangle \left\langle
\psi_{j_{2}}\right\vert \right\vert D_{1}\right)  +\left(  \left.  \left\vert
\psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  -\left(  \left.  \left\vert \psi
_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{j_{1}}\psi_{j_{2}%
}\right\vert \right\vert D_{2}\right)  \geq0.
\end{equation}
b. The Q-symbol version of this condition is%
\begin{equation}
1\geq\left(  \left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  +\left(  \left.  \left\vert \tilde{\psi
}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\psi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert D_{1}\right)  -\left(
\left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}\right)  \tilde{\psi}%
_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\psi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{2}\right)  \geq0,\nonumber
\end{equation}
i.e.%
\begin{equation}
1\geq\tilde{Q}_{\Gamma_{1}^{2}\circ L_{2}^{1}\left(  D_{2}\right)  }\left(
\mathbf{z}\right)  -\tilde{Q}_{D_{2}}\left(  \mathbf{z}\right)  =\left[
\mathcal{L}_{\Gamma L}\left(  \tilde{Q}_{D_{2}}\right)  \right]  \left(
\mathbf{z}\right)  -\tilde{Q}_{D_{2}}\left(  \mathbf{z}\right)  \geq0
\end{equation}


and
\begin{equation}
1\geq\mathcal{L}_{\Gamma L}\left(  \tilde{Q}_{D_{2}}\right)  -\tilde{Q}%
_{D_{2}}\geq0
\end{equation}


\item \emph{Occupation Number Condition}
\begin{align}
1 &  \geq f\left(  b_{j}^{\dagger}b_{j}\right)  =f\left(  \Phi\left(  \psi
_{j}\right)  ^{\dagger}\Phi\left(  \psi_{j}\right)  \right)  \geq
0\,\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}%
\end{align}
The density operator version of this is%
\begin{equation}
1\geq\left(  \left.  \left\vert \psi_{j}\right\rangle \left\langle \psi
_{j}\right\vert \right\vert D_{1}\right)  \geq0
\end{equation}
The Q-symbol version of this condition is%
\begin{align}
1 &  \geq\left(  \left.  \left\vert \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  \geq0\nonumber\\
1 &  \geq\left(  \left.  \left\vert \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\psi}_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  \geq0
\end{align}
i.e.%
\begin{equation}
1\geq\left[  \mathcal{L}_{11}\left(  \tilde{Q}_{D_{2}}\right)  \right]
\left(  \mathbf{z}\right)  \geq0
\end{equation}%
\begin{equation}
1\geq\left[  \mathcal{L}_{22}\left(  \tilde{Q}_{D_{2}}\right)  \right]
\left(  \mathbf{z}\right)  \geq0.
\end{equation}
and
\begin{equation}
1\geq\mathcal{L}_{11}\left(  \tilde{Q}_{D_{2}}\right)  \geq0
\end{equation}%
\begin{equation}
1\geq\mathcal{L}_{22}\left(  \tilde{Q}_{D_{2}}\right)  \geq0.
\end{equation}
The functionals $\mathcal{L}_{11},\mathcal{L}_{22}$ and $\mathcal{L}_{\Gamma
L}$ are defined by
\begin{align}
\mathcal{L}_{11}\left(  \mathbf{z,z}^{\prime}\right)   &  =\frac{1}{2\left(
N-1\right)  }\sum_{1\leq j,kl\leq r}P_{jlkl}\left(  \mathbf{z}^{\prime
}\right)  \operatorname*{Tr}\left\{  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \overset{}{\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}%
^{\prime}\right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j,k,l\leq r}\gamma_{1}\left(
\mathbf{z}\right)  _{kj}K_{Q}\left(  \mathbf{z,z}^{\prime}\right)
P_{jlkl}\left(  \mathbf{z}^{\prime}\right)
\end{align}%
\begin{align}
\mathcal{L}_{22}\left(  \mathbf{z,z}^{\prime}\right)   &  =\frac{1}{2\left(
N-1\right)  }\sum_{1\leq j,kl\leq r}P_{jlkl}\left(  \mathbf{z}^{\prime
}\right)  \operatorname*{Tr}\left\{  \left\vert \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \overset{}{\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}%
^{\prime}\right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j,k,l\leq r}\gamma_{1}\left(
\mathbf{z}\right)  _{kj}K_{Q}\left(  \mathbf{z,z}^{\prime}\right)
P_{jlkl}\left(  \mathbf{z}^{\prime}\right)
\end{align}%
\begin{align}
\left[  \mathcal{L}_{\Gamma L}\left(  Q_{D_{2}}\right)  \right]  \left(
\mathbf{z}\right)    & =Q_{\Gamma_{1}^{2}\circ L_{1}\left(  D\right)  }\left(
\mathbf{z}\right)  =\left(  \left.  \overset{}{\left\vert \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\vert }\right\vert \Gamma_{1}^{2}\circ L_{1}\left(
D\right)  \right)  \nonumber\\
& =\frac{1}{\left(  N-1\right)  }\sum_{1\leq j,k,l\leq r}\gamma_{1}\left(
\mathbf{z}\right)  _{kj}K_{Q}\left(  \mathbf{z,z}^{\prime}\right)
P_{jlkl}\left(  \mathbf{z}^{\prime}\right)  .
\end{align}

\end{enumerate}

We denote the convex set of representable Q-symbols as $\mathfrak{Q}$, the
convex set of $N$-representable Q-symbols as $\mathfrak{Q}_{N}$ and the unit
ball wrt the supremum (uniform) norm of the Q-symbol space, $\mathfrak{F},$ as
$\mathfrak{Q}_{1}$, i.e.
\begin{equation}
\mathfrak{Q}_{1}=\left\{  Q\left(  \mathbf{z}\right)  \left\vert \left\vert
Q\left(  \mathbf{z}\right)  \right\vert \leq1,\mathbf{z\in}\mathbb{C}%
^{2\left(  r-2\right)  }\right.  \right\}  ,
\end{equation}
which is actually the unit hypercube in $\mathfrak{F}$. The extreme points,
$\operatorname*{ext}\left\{  \mathfrak{Q}_{1}\right\}  ,$ of this hypercube
are the vertices of the surface
\begin{equation}
S^{\mathbb{C}^{2\left(  r-2\right)  }}=\left\{  Q\left(  \mathbf{z}\right)
\left\vert \left\vert Q\left(  \mathbf{z}\right)  \right\vert =1,\mathbf{z\in
}\mathbb{C}^{2\left(  r-2\right)  }\right.  \right\}  ,
\end{equation}
the intersection with the positive hyperant is
\begin{equation}
\mathfrak{Q}_{1+}=\left\{  Q\left(  \mathbf{z}\right)  \left\vert 0\leq
Q\left(  \mathbf{z}\right)  \leq1,\mathbf{z\in}\mathbb{C}^{2\left(
r-2\right)  }\right.  \right\}
\end{equation}
and the positive segment of the hypersphere is
\begin{equation}
S_{+}^{\mathbb{C}^{2\left(  r-2\right)  }}=\left\{  Q\left(  \mathbf{z}%
\right)  \left\vert Q\left(  \mathbf{z}\right)  =1,\mathbf{z\in}%
\mathbb{C}^{2\left(  r-2\right)  }\right.  \right\}  .
\end{equation}


\subsection{Energy Functional}

In terms of P and Q symbols the $N$-fermion energy functional can be expressed
as
\begin{equation}
E_{N}\left(  D^{2}\right)  =\int Q_{D^{2}}\left(  \mathbf{z}\right)
P_{K_{2N}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)
d\mu\left(  \mathbf{z}\right)  =\int Q_{K_{2N}}\left(  \mathbf{z}\right)
P_{D^{2}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)
d\mu\left(  \mathbf{z}\right)  ,
\end{equation}
which comes from the general trace product expression for self adjoint trace
class operators
\begin{equation}
\operatorname*{Tr}\left\{  AB\right\}  =\int Q_{B}\left(  \mathbf{z}\right)
P_{A}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)
d\mu\left(  \mathbf{z}\right)  =\int Q_{A}\left(  \mathbf{z}\right)
P_{B}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)
d\mu\left(  \mathbf{z}\right)  .\nonumber
\end{equation}
Again this can be expressed as
\begin{equation}
\operatorname*{Tr}\left\{  AB\right\}  =\int Q_{B}\left(  \mathbf{z}\right)
P_{A}\left(  \mathbf{z}\right)  d\tilde{\mu}\left(  \mathbf{z}\right)  =\int
Q_{A}\left(  \mathbf{z}\right)  P_{B}\left(  \mathbf{z}\right)  d\tilde{\mu
}\left(  \mathbf{z}\right)
\end{equation}
and%
\begin{equation}
E_{N}\left(  D^{2}\right)  =\int Q_{D^{2}}\left(  \mathbf{z}\right)
P_{K_{2N}}\left(  \mathbf{z}\right)  d\tilde{\mu}\left(  \mathbf{z}\right)
=\int Q_{K_{2N}}\left(  \mathbf{z}\right)  P_{D^{2}}\left(  \mathbf{z}\right)
d\tilde{\mu}\left(  \mathbf{z}\right)  .
\end{equation}
The Q-symbol of the Reduced Hamiltonian is given by
\begin{align}
Q_{K_{2N}}\left(  \mathbf{z}\right)   &  =\frac{1}{4}\sum_{\substack{1\leq
j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq r}}K_{2Nj_{1}j_{2}k_{1}k_{2}%
}\left\langle \mathbf{z}\left\vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{k_{2}}a_{k_{1}}\mathbf{z}\right.  \right\rangle \nonumber\\
&  =\frac{1}{4}\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle \sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq
r}}K_{2Nj_{1}j_{2}k_{1}k_{2}}\left\{  \gamma_{1}\left(  \mathbf{z}\right)
_{j_{1}k_{1}}\gamma_{1}\left(  \mathbf{z}\right)  _{j_{2}k_{2}}-\gamma
_{1}\left(  \mathbf{z}\right)  _{j_{1}k_{2}}\gamma_{1}\left(  \mathbf{z}%
\right)  _{j_{2}k_{1}}\right\} \nonumber\\
&  =\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq
r}}K_{2Nj_{1}j_{2}k_{1}k_{2}}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}%
\right)  ,
\end{align}
where%
\begin{align}
K_{2Nj_{1}j_{2}k_{1}k_{2}}  &  =\frac{2}{N\left(  N-1\right)  }\eta\left(
\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}%
}\right) \nonumber\\
&  +\frac{1}{\left(  N-1\right)  }\left(  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}%
}+h_{1j_{2}k_{2}}\delta_{j_{1}k_{1}}\right)  +\frac{1}{2}h_{2j_{1}j_{2}%
k_{1}k_{2}}%
\end{align}
\emph{and }$\gamma_{1}\left(  \mathbf{z}\right)  $ is the FORDM of the
$\emph{two}$ particle state $\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert .$ Hence
\begin{equation}
\tilde{Q}_{K_{2N}}\left(  \mathbf{z}\right)  =E_{2IPS}\left(  \gamma
_{1}\left(  \mathbf{z}\right)  \right)  =\eta+\operatorname*{Tr}%
\nolimits_{\mathcal{H}^{1}}\left\{  h_{1}\gamma_{1}\left(  \mathbf{z}\right)
-\frac{1}{2}V_{HF}\left(  \mathbf{z}\right)  \right\}  ,
\end{equation}
where the Hartree-Fock potential $V_{HF}$ is given as
\begin{equation}
V_{HF}\left(  \mathbf{z}\right)  _{jk}=\sum_{1\leq l,m\leq r}h_{2jlkm}%
\gamma_{1}\left(  \mathbf{z}\right)  _{lm}.
\end{equation}
The P-symbol $P_{K_{2N}}\left(  \mathbf{z}\right)  $ of $Q_{K_{2N}}$ is then
given as
\begin{align}
P_{K_{2N}}\left(  \mathbf{z}\right)   &  =\left[  \mathfrak{Be}^{-1}\left(
Q_{K_{2N}}\right)  \right]  \left(  \mathbf{z}\right)  =\left[  \mathfrak{Be}%
^{-1}\left(  Q_{K_{2N}}\right)  \right]  \left(  \mathbf{z}\right) \nonumber\\
&  =\int\mathfrak{Be}^{-1}\left(  \mathbf{z,z}^{\prime}\right)  Q_{K_{2N}%
}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)
=\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq
r}}K_{2Nj_{1}j_{2}k_{1}k_{2}}P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}%
\right)  ,
\end{align}
where
\begin{equation}
\mathfrak{Be}^{-1}\left(  \mathbf{z,z}^{\prime}\right)  =\sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r\\1\leq p_{1}<p_{2}\leq r\\1\leq
q_{1}<q_{2}\leq r}}\left(  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \left\vert \overset{}{\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert }\right.  \right)  \Delta_{j_{1}j_{2}k_{1}k_{2}p_{1}p_{2}%
q_{1}q_{2}}^{-2}\left(  \left.  \overset{}{\left\vert \varphi_{p_{1}}%
\varphi_{p_{2}}\right\rangle \left\langle \varphi_{q_{1}}\varphi_{q_{2}%
}\right\vert }\right\vert \left\vert \mathbf{z}^{\prime}\right\rangle
\left\langle \mathbf{z}^{\prime}\right\vert \right)  .
\end{equation}
The $N$-particle energy functional becomes the linear functional%
\begin{equation}
E_{N}\left(  D_{2}\right)  =E_{N}\left(  Q_{D_{2}}\right)  =\int Q_{D_{2}%
}\left(  \mathbf{z}\right)  P_{K_{2N}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  .
\end{equation}
The ground state Q-symbol $Q_{D_{GS}^{2}}$ and its energy $E_{NGS}$ are then
the solution to the Linear Programing problem
\begin{equation}
E_{N}\left(  Q_{D_{2GS}}\right)  =\min_{Q_{D_{2}}\in\mathfrak{Q}_{N}}%
E_{N}\left(  Q_{D_{2}}\right)
\end{equation}
where $\mathfrak{Q}_{N}$ is the set determined by the preceding linear
constraints. The energy can be easily expressed in terms of matrix elements
but the constraints more easily expressed in terms of Q-symbols.

\section{Appendix}

The expectation value of the number operator is then%
\begin{align}
f\left(  \mathcal{N}_{1}\right)   &  =\left(  N-1\right)  ^{-1}\sum
_{j}f\left(  a_{j}^{\dagger}\mathcal{N}_{1}a_{j}\right)  =\left(  N-1\right)
^{-1}\sum_{j}f\left(  \left(  \mathcal{N}_{1}a_{j}^{\dagger}-a_{j}^{\dagger
}\right)  a_{j}\right) \nonumber\\
&  =\left(  N-1\right)  ^{-1}f\left(  \mathcal{N}_{1}^{2}\right)  -\left(
N-1\right)  ^{-1}f\left(  \mathcal{N}_{1}\right) \nonumber
\end{align}
using
\begin{equation}
\left[  \mathcal{N}_{1},a_{j}^{\dagger}\right]  =a_{j}^{\dagger}%
=\mathcal{N}_{1}a_{j}^{\dagger}-a_{j}^{\dagger}\mathcal{N}_{1}\Leftrightarrow
a_{j}^{\dagger}\mathcal{N}_{1}=\mathcal{N}_{1}a_{j}^{\dagger}-a_{j}^{\dagger}%
\end{equation}
one obtains%
\begin{align}
f\left(  \mathcal{N}_{1}\right)   &  =\left(  N-1\right)  ^{-1}f\left(
\mathcal{N}_{1}^{2}\right)  -\left(  N-1\right)  ^{-1}f\left(  \mathcal{N}%
_{1}\right) \nonumber\\
&  \Rightarrow\left(  N-1\right)  f\left(  \mathcal{N}_{1}\right)  =f\left(
\mathcal{N}_{1}^{2}\right)  -f\left(  \mathcal{N}_{1}\right) \nonumber\\
&  \Rightarrow Nf\left(  \mathcal{N}_{1}\right)  =f\left(  \mathcal{N}_{1}%
^{2}\right)
\end{align}
then using
\begin{equation}
\left(  \mathcal{N}_{1}\right)  ^{2}=\mathcal{N}_{1}+2\mathcal{N}_{2}%
\end{equation}
one gets
\begin{align}
Nf\left(  \mathcal{N}_{1}\right)   &  =f\left(  \mathcal{N}_{1}+2\mathcal{N}%
_{2}\right)  =f\left(  \mathcal{N}_{1}\right)  +2f\left(  \mathcal{N}%
_{2}\right) \nonumber\\
&  \Rightarrow\frac{\left(  N-1\right)  }{2}f\left(  \mathcal{N}_{1}\right)
=f\left(  \mathcal{N}_{2}\right)
\end{align}
thus if
\begin{equation}
f\left(  \mathcal{N}_{2}\right)  =\frac{N\left(  N-1\right)  }{2}%
\end{equation}
then
\begin{equation}
f\left(  \mathcal{N}_{1}\right)  =N
\end{equation}
and
\begin{equation}
f\left(  \mathcal{N}_{1}^{2}\right)  =N^{2}=f\left(  \mathcal{N}_{1}\right)
^{2}.
\end{equation}


%

\begin{equation}
\mathcal{L}_{11}\left(  \mathbf{z,z}^{\prime}\right)  =\frac{1}{2\left(
N-1\right)  }\sum_{1\leq j_{1},k_{1},l\leq r}P_{j_{1}lk_{1}l}\left(
\mathbf{z}^{\prime}\right)  \operatorname*{Tr}\left\{  \left\vert
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi
_{k_{1}}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}^{\prime}\right)
\end{equation}%
\begin{equation}
Q_{\Gamma_{1}^{2}\circ L_{1}\left(  D\right)  }\left(  \mathbf{z}\right)
=\left(  \left.  \overset{}{\left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert }\right\vert \Gamma_{1}^{2}\circ L_{1}\left(  D\right)  \right)
_{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }.
\end{equation}
The SORDM\ for \emph{any }ensemble, $D,$ of pure number states is defined as
\begin{align}
&  D_{2j_{1}j_{2}k_{1}k_{2}}=\left(  \left.  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}\right\vert D\right)  _{\mathcal{F}%
}=\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}%
}a_{j_{1}}D\right\}  =\sum_{0\leq N\leq\infty}\operatorname{Tr}\left\{
a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}D^{N}\right\}
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger
}a_{k_{2}}^{\dagger}\mathcal{N}_{N-2}a_{j_{2}}a_{k_{2}}D^{N}\right\}
=\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N-2}\leq\infty
}}\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{l_{1}%
}^{\dagger}\cdots a_{l_{N-2}}^{\dagger}a_{l_{N-2}}\cdots a_{l_{1}}a_{j_{2}%
}a_{j_{1}}D^{N}\right\}  \nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N-2}\leq\infty
}}D_{j_{1}j_{2}l_{1}\cdots l_{N-2}k_{1}k_{2}l_{1}\cdots l_{N-2}}^{N}%
=L_{2}\left(  D\right)  _{j_{1}j_{2}k_{1}k_{2}},
\end{align}
which gives%
\begin{equation}
D_{2j_{1}j_{2}k_{1}k_{2}}=\sum_{0\leq N\leq\infty}\binom{N}{2}L_{N}^{2}\left(
D^{N}\right)  _{j_{1}j_{2}k_{1}k_{2}}=\sum_{0\leq N\leq\infty}L_{2}\left(
D^{N}\right)  _{j_{1}j_{2}k_{1}k_{2}}.
\end{equation}
and the FORDM by%
\begin{align}
&  D_{1j_{1}k_{1}}=\left(  \left.  a_{j_{1}}^{\dagger}a_{k_{1}}\right\vert
D\right)  _{\mathcal{F}}=\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger}%
a_{j_{1}}D\right\}  =\sum_{0\leq N\leq\infty}\operatorname{Tr}\left\{
a_{k_{1}}^{\dagger}a_{j_{1}}D^{N}\right\}  \nonumber\\
&  =\sum_{0\leq N\leq\infty}\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger
}\mathcal{N}_{N-1}a_{j_{1}}D^{N}\right\}  =\sum_{\substack{0\leq N\leq
\infty\\1\leq l_{1}<\cdots<l_{N-2}\leq\infty}}\operatorname{Tr}\left\{
a_{k_{1}}^{\dagger}a_{l_{1}}^{\dagger}\cdots a_{l_{N-1}}^{\dagger}a_{l_{N-1}%
}\cdots a_{l_{1}}a_{j_{1}}D^{N}\right\}  \nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N-1}\leq\infty
}}D_{j_{1}j_{2}l_{1}\cdots l_{N-1}k_{1}k_{2}l_{1}\cdots l_{N-1}}^{N}%
=L_{1}\left(  D\right)  _{j_{1}k_{1}},
\end{align}
which gives%
\begin{equation}
D_{1j_{1}k_{1}}=\sum_{0\leq N\leq\infty}\binom{N}{1}L_{N}^{1}\left(
D^{N}\right)  _{j_{1}k_{1}}=\sum_{0\leq N\leq\infty}L_{1}\left(  D^{N}\right)
_{j_{1}k_{1}}.
\end{equation}
Hence if $D=D^{N}$ for a fixed $N$ then
\begin{equation}
D_{2j_{1}j_{2}k_{1}k_{2}}=\sum_{1\leq l_{1}<\cdots<l_{N-2}\leq\infty}%
D_{j_{1}j_{2}l_{1}\cdots l_{N-2}k_{1}k_{2}l_{1}\cdots l_{N-2}}^{N}%
\end{equation}
and
\begin{equation}
D_{1j_{1}k_{1}}=\sum_{1\leq l_{1}<\cdots<l_{N-1}\leq\infty}D_{j_{1}j_{2}%
l_{1}\cdots l_{N-1}k_{1}k_{2}l_{1}\cdots l_{N-1}}^{N}%
\end{equation}
and
\begin{equation}
D_{1j_{1}k_{1}}=\frac{1}{2\left(  N-1\right)  }\sum_{1\leq l\leq\infty
}D_{2j_{1}lk_{1}l}.
\end{equation}


\begin{theorem}
$f$ is a pure N-particle state iff
\begin{equation}
f\left(  a_{j}^{\dagger}a_{k}\right)  =\left(  N-1\right)  ^{-1}f\left(
a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  ;\quad1\leq j,k\leq r \label{N-1}%
\end{equation}
for any basis.
\end{theorem}

\begin{proof}
If $f$ is a pure $N$ particle state eq. $\left(  \ref{N-1}\right)  $ follows
immediately and the "any basis" assertion follows from the invariance of
$\mathcal{N}_{1}$ to $U\left(  \mathcal{H}^{1}\right)  .$

\begin{proof}
Let $f$ be a mixed particle state i.e.
\begin{equation}
f\left(  X\right)  =\sum_{0\leq P\leq\infty}\alpha_{P}\left\langle \Psi
_{P}\left\vert X\Psi_{P}\right.  \right\rangle ;1\geq\alpha_{P}\geq
0;\sum_{0\leq P\leq\infty}\alpha_{P}=1
\end{equation}
then
\begin{align}
f\left(  a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)   &  =\sum_{0\leq
P\leq\infty}\alpha_{P}\left\langle \Psi_{P}\left\vert a_{j}^{\dagger
}\mathcal{N}_{1}a_{k}\Psi_{P}\right.  \right\rangle =\sum_{0\leq P\leq\infty
}\alpha_{P}\left(  P-1\right)  \left\langle \Psi_{P}\left\vert a_{j}^{\dagger
}a_{k}\Psi_{P}\right.  \right\rangle \nonumber\\
&  =\left(  N-1\right)  \sum_{0\leq P\leq\infty}\alpha_{P}\left\langle
\Psi_{P}\left\vert a_{j}^{\dagger}a_{k}\Psi_{P}\right.  \right\rangle
\end{align}
and thus%
\begin{align}
0 &  =\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}  \left\langle
\Psi_{P}\left\vert a_{j}^{\dagger}a_{k}\Psi_{P}\right.  \right\rangle \forall
j,k\nonumber\\
&  \Rightarrow\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}
\left\langle \Psi_{P}\left\vert b^{\dagger}b\Psi_{P}\right.  \right\rangle
=0\forall b\nonumber\\
&  \Leftrightarrow\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}
n_{b}=0;\quad\forall n_{b}\in\left[  0,1\right]  \nonumber\\
&  \Leftrightarrow\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}
=0=\sum_{0\leq P\leq\infty}\alpha_{P}P-N\nonumber\\
&  \Leftrightarrow\sum_{0\leq P\leq\infty}\alpha_{P}P=N;\quad P\in
\mathbb{N},\sum_{0\leq P\leq\infty}\alpha_{P}=1,\alpha_{P}\in\left[
0,1\right]  \nonumber\\
&  \Leftrightarrow\alpha_{N}=1,\alpha_{P}=0,P\neq N.
\end{align}

\end{proof}
\end{proof}

%

\begin{align}
\left[  \mathcal{N}_{1},a_{j}^{\dagger}\right]   &  =a_{j}^{\dagger
}=\mathcal{N}_{1}a_{j}^{\dagger}-a_{j}^{\dagger}\mathcal{N}_{1}\nonumber\\
\left[  \mathcal{N}_{1},a_{j}\right]   &  =-a_{j}=a_{j}\mathcal{N}%
_{1}-\mathcal{N}_{1}a_{j}\Leftrightarrow\mathcal{N}_{1}a_{j}=a_{j}%
+a_{j}\mathcal{N}_{1}%
\end{align}%
\begin{equation}
\int\left(  H\left\vert P_{D^{N}}\left(  \mathbf{z}_{N}\right)  \left\vert
\mathbf{z}_{N}\right\rangle \left\langle \mathbf{z}_{N}\right\vert \right.
\right)  d\mu\left(  \mathbf{z}_{N}\right)  =\int\left(  K_{2N}\left\vert
P_{D_{2}}\left(  \mathbf{z}_{2}\right)  \left\vert \mathbf{z}_{2}\right\rangle
\left\langle \mathbf{z}_{2}\right\vert \right.  \right)  d\mu\left(
\mathbf{z}_{2}\right)
\end{equation}%
\begin{align}
\left(  H\left\vert \int\left\vert \mathbf{z}_{N}\right\rangle \left\langle
\mathbf{z}_{N}\right\vert d\mu\left(  \mathbf{z}_{N}\right)  D^{N}\right.
\right)   &  =\binom{N}{2}\left(  \Gamma_{2}^{N}\left(  K_{2N}\int\left\vert
\mathbf{z}_{2}\right\rangle \left\langle \mathbf{z}_{2}\right\vert d\mu\left(
\mathbf{z}_{2}\right)  \right)  \left\vert D^{N}\right.  \right) \\
&  =\binom{N}{2}\left(  K_{2N}\left\vert \int\left\vert \mathbf{z}%
_{2}\right\rangle \left\langle \mathbf{z}_{2}\right\vert d\mu\left(
\mathbf{z}_{2}\right)  L_{N}^{2}\left(  D^{N}\right)  \right.  \right)
\end{align}%
\begin{align}
\int\left(  H\left\vert \left\vert \mathbf{z}_{N}\right\rangle \left\langle
\mathbf{z}_{N}\right\vert D^{N}\right.  \right)  d\mu\left(  \mathbf{z}%
_{N}\right)   &  =\binom{N}{2}\int\left(  \Gamma_{2}^{N}\left(  K_{2N}%
\left\vert \mathbf{z}_{2}\right\rangle \left\langle \mathbf{z}_{2}\right\vert
\right)  \left\vert D^{N}\right.  \right)  d\mu\left(  \mathbf{z}_{2}\right)
\\
&  =\binom{N}{2}\int\left(  K_{2N}\left\vert \left\vert \mathbf{z}%
_{2}\right\rangle \left\langle \mathbf{z}_{2}\right\vert L_{N}^{2}\left(
D^{N}\right)  \right.  \right)  d\mu\left(  \mathbf{z}_{2}\right)
\end{align}%
\begin{equation}
\operatorname{Tr}\left\{  H\int\left\vert \mathbf{z}_{N}\right\rangle
\left\langle \mathbf{z}_{N}\right\vert d\mu\left(  \mathbf{z}_{N}\right)
D^{N}\right\}
\end{equation}%
\begin{align}
E_{N}  &  =\operatorname{Tr}\left\{  HD^{N}\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \left(  \eta I+\sum_{1\leq j_{1},k_{1}\leq
r}h_{1j_{1}k_{1}}a_{j_{1}}^{\dagger}a_{k_{1}}+\sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}h_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\right)  D^{N}\right\}
\nonumber\\
&  =\eta\operatorname{Tr}\left\{  D^{N}\right\}  +\sum_{1\leq j_{1},k_{1}\leq
r}h_{1j_{1}k_{1}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{k_{1}}%
D^{N}\right\} \nonumber\\
&  +\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}h_{2j_{1}j_{2}k_{1}k_{2}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}  .
\end{align}%
\begin{align}
E_{N}  &  =\left(  H\left\vert D^{N}\right.  \right)  =\eta+\left(  \left.
\sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}}a_{j_{1}}^{\dagger}a_{k_{1}%
}\right\vert D^{N}\right)  +\left(  \left.  \sum_{\substack{1\leq j_{1}%
<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}h_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\right\vert D^{N}\right)
\nonumber\\
&  =\eta+\left(  \left.  \sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}%
}\left\vert \psi_{j_{1}}\right\rangle \left\langle \psi_{k_{1}}\right\vert
\right\vert L\left(  D^{N}\right)  \right)  +\left(  \left.  \sum
_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}h_{2j_{1}%
j_{2}k_{1}k_{2}}\left\vert \psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle
\psi_{k_{1}}\psi_{k_{2}}\right\vert \right\vert L\left(  D^{N}\right)  \right)
\nonumber\\
&  =\eta+\left(  \left.  \sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}%
}\left\vert \psi_{j_{1}}\right\rangle \left\langle \psi_{k_{1}}\right\vert
\right\vert L_{1}\left(  D^{N}\right)  \right)  +\left(  \left.
\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}%
}h_{2j_{1}j_{2}k_{1}k_{2}}\left\vert \psi_{j_{1}}\psi_{j_{2}}\right\rangle
\left\langle \psi_{k_{1}}\psi_{k_{2}}\right\vert \right\vert L_{2}\left(
D^{N}\right)  \right) \\
&  =\eta\binom{N}{0}L_{2}^{0}\circ L_{N}^{2}\left(  D^{N}\right)  +\binom
{N}{1}\left(  \left.  \sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}}\left\vert
\psi_{j_{1}}\right\rangle \left\langle \psi_{k_{1}}\right\vert \right\vert
L_{2}^{1}\circ L_{N}^{2}\left(  D^{N}\right)  \right) \\
&  +\binom{N}{2}\left(  \left.  \sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq
k_{1}<k_{2}\leq r}}h_{2j_{1}j_{2}k_{1}k_{2}}\left\vert \psi_{j_{1}}\psi
_{j_{2}}\right\rangle \left\langle \psi_{k_{1}}\psi_{k_{2}}\right\vert
\right\vert L_{N}^{2}\left(  D^{N}\right)  \right)
\end{align}%
\begin{align}
&  =\eta\binom{N}{2}^{-1}\left(  \left.  P_{\mathcal{H}^{2}}\right\vert
D_{2}\right)  +\binom{N}{1}\binom{N}{2}^{-1}\left(  \left.  \Gamma_{1}%
^{2}\left(  \sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}}\left\vert
\psi_{j_{1}}\right\rangle \left\langle \psi_{k_{1}}\right\vert \right)
\right\vert D_{2}\right) \\
&  +\binom{N}{2}\binom{N}{2}^{-1}\left(  \left.  \sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}h_{2j_{1}j_{2}k_{1}k_{2}%
}\left\vert \psi_{j_{1}}\psi_{j_{2}}\right\rangle \left\langle \psi_{k_{1}%
}\psi_{k_{2}}\right\vert \right\vert D_{2}\right)
\end{align}%
\begin{equation}
=\left(  \left.  \sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}%
<k_{2}\leq r}}\left\{  \eta\binom{N}{2}^{-1}+\frac{1}{N-1}\left(
h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}+\delta_{j_{1}k_{1}}h_{1j_{2}k_{2}}\right)
+h_{2j_{1}j_{2}k_{1}k_{2}}\right\}  \left\vert \psi_{j_{1}}\psi_{j_{2}%
}\right\rangle \left\langle \psi_{k_{1}}\psi_{k_{2}}\right\vert \right\vert
D_{2}\right)
\end{equation}



