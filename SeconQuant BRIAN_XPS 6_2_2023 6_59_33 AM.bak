{\textstyle\bigotimes}
%EndExpansion
\left(  V\right) \\
y_{q_{1}}\left(  \cdot_{\mathcal{Y}}\right)  y_{q_{2}}  &  \in\mathcal{Y}=%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  V^{d}\right)  ,
\end{align}


\item giving in the case of dual algebras%
\begin{equation}
\left(  \left\vert x_{p_{1}}\right\rangle \otimes\left\langle y_{q_{1}%
}\right\vert \right)  @_{\mathcal{XX}^{d}}\left(  \left\vert x_{p_{2}%
}\right\rangle \otimes\left\langle y_{q_{2}}\right\vert \right)  =\left\vert
x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert @_{\mathcal{XY}%
}\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}}\right\vert .
\end{equation}


\item giving in the case of dual exterior algebras
\begin{equation}
\left\vert x_{p_{1}}\right\rangle \otimes\left\langle y_{q_{1}}\right\vert
@_{{\LARGE \wedge}\left(  V\ \right)  {\large \otimes}{\LARGE \wedge}\left(
\ V^{d}\right)  }\left\vert x_{p_{2}}\right\rangle \otimes\left\langle
y_{q_{2}}\right\vert =\left(  -1\right)  ^{p_{2}q_{1}}\left\vert x_{p_{1}%
}\wedge x_{p_{2}}\right\rangle \otimes\left\langle y_{q_{1}}\wedge y_{q_{2}%
}\right\vert .
\end{equation}


\item In particular for $p_{2}=q_{1}=1$
\begin{equation}
\left\vert x_{1}\right\rangle \otimes\left\langle y_{1}\right\vert
@_{{\LARGE \wedge}\left(  V\ \right)  {\large \otimes}{\LARGE \wedge}\left(
\ V^{d}\right)  }\left\vert x_{1}^{\prime}\right\rangle \otimes\left\langle
y_{1}^{\prime}\right\vert =\left\vert x_{1}\wedge x_{1}^{\prime}\right\rangle
\otimes\left\langle y_{1}\wedge y_{1}^{\prime}\right\vert .
\end{equation}


\item Hence
\begin{equation}
@_{{\LARGE \wedge}\left(  V\ \right)  {\large \otimes}{\LARGE \wedge}\left(
\ V^{d}\right)  }\neq{\large \wedge}%
\end{equation}
as
