\section{Tensor Product and Direct Sum of Hilbert Spaces}

\subsection{Tensor Product of Hilbert Spaces}

The tensor product of a sequence of Hilbert spaces $\left\{  \left.
\mathcal{H}_{j}\right\vert 1\leq j\leq n\right\}  $ is given by
\begin{equation}
\bigotimes\limits_{1\leq j\leq m}\mathcal{H}_{j}\equiv\mathcal{H}_{1}%
\otimes\cdots\otimes\mathcal{H}_{m},
\end{equation}
where $\bigotimes\limits_{1\leq j\leq m}\mathcal{H}_{j}$ denotes the linear
space formed by the completion of the vector sequences (i.e. a sequence
$\left\{  v_{1},\cdots,v_{m}\right\}  $ forming the coordinates of a vector)
\begin{equation}
\left(  v_{1},\cdots,v_{m}\right)  ;v_{j}\in\mathcal{H}_{j};1\leq j\leq m
\end{equation}
wrt the tensor product norm
\begin{equation}
\left\Vert \left(  v_{1},\cdots,v_{m}\right)  \right\Vert _{\underset{1\leq
j\leq m}{\otimes}\mathcal{H}_{j}}=%
%TCIMACRO{\tprod \limits_{1\leq j\leq m}}%
%BeginExpansion
{\textstyle\prod\limits_{1\leq j\leq m}}
%EndExpansion
\left\Vert v_{j}\right\Vert _{\mathcal{H}_{j}}.
\end{equation}


Different types of infinite limits
\begin{equation}
\lim\limits_{m\rightarrow\infty}%
%TCIMACRO{\tprod \limits_{1\leq j\leq m}}%
%BeginExpansion
{\textstyle\prod\limits_{1\leq j\leq m}}
%EndExpansion
\left\Vert v_{j}\right\Vert _{\mathcal{H}_{j}}%
\end{equation}
may or may not exist and need careful examination (Thirring "A Course in
Mathematical Physics: Quantum mechanics of large systems" p29....). The
resulting limit Hilbert spaces may or may not be \emph{seperable} $\left(
\text{i.e. have a countable basis}\right)  $ \emph{even if} $\left\{  \left.
\mathcal{H}_{j}\right\vert 1\leq j\leq m\right\}  $ are seperable. In
particular the Hilbert space
\begin{equation}
\bigotimes\limits_{1\leq j\leq\infty}\mathcal{H}_{j},
\end{equation}
where
\begin{equation}
\mathcal{H}_{j}=\mathbb{C}^{2};1\leq j\leq\infty
\end{equation}
defined by Thirring using the inductive limit is \underline{\emph{not}}\emph{
seperable}.

A general element of $\bigotimes\limits_{1\leq j\leq m}\mathcal{H}_{j},$ when
it has a countable basis, is
\begin{equation}
\Psi=\sum_{\substack{1\leq j_{1}\leq r_{1}\\\vdots\\1\leq j_{m}\leq r_{m}%
}}e_{1j_{1}}\otimes\cdots\otimes e_{mj_{m}}\psi_{j_{1}\cdots j_{m}},
\end{equation}
where
\begin{equation}
\left\{  \left.  \left\{  \left.  e_{pj_{p}}\right\vert 1\leq j_{p}\leq
r_{p}\right\}  \right\vert 1\leq p\leq m\right\}
\end{equation}
are conb's of $\left\{  \left.  \mathcal{H}_{j}\right\vert 1\leq j\leq
m<\infty\right\}  .$

\subsubsection{Direct Sum of Tensor Products of Different Hilbert Spaces}

\begin{remark}
\begin{enumerate}
\item In order to consider antisymmetric tensor products of tensors from
different vector spaces one must consider direct sums of tensor products
spaces as
\begin{equation}
a_{1}\otimes a_{2}\in\mathcal{H}_{1}\otimes\mathcal{H}_{2}%
\end{equation}
and
\begin{equation}
a_{2}\otimes a_{1}\in\mathcal{H}_{2}\otimes\mathcal{H}_{1}%
\end{equation}
thus the antisymmetric product%
\begin{equation}
a_{1}\otimes a_{2}-a_{2}\otimes a_{1}\in\left[  \mathcal{H}_{1}\otimes
\mathcal{H}_{2}\right]  \oplus\left[  \mathcal{H}_{2}\otimes\mathcal{H}%
_{1}\right]  =\mathcal{H}_{1}\otimes\mathcal{H}_{2}+\mathcal{H}_{2}%
\otimes\mathcal{H}_{1}.
\end{equation}


\begin{remark}%
\begin{equation}
\dim\left\{  \mathcal{H}_{1}\otimes\mathcal{H}_{2}+\mathcal{H}_{2}%
\otimes\mathcal{H}_{1}\right\}  =2r_{1}r_{2}.
\end{equation}

\end{remark}

\item The tensor products spaces in reversed order are isomorphic as Hilbert
spaces
\begin{align}
\mathcal{H}_{1}\otimes\mathcal{H}_{2}  &  \cong\mathcal{H}_{2}\otimes
\mathcal{H}_{1}\\
\mathfrak{T}  &  :\mathcal{H}_{1}\otimes\mathcal{H}_{2}\rightarrow
\mathcal{H}_{2}\otimes\mathcal{H}_{1}\\
\mathfrak{T}\left(  a_{1}\otimes a_{2}\right)   &  =a_{2}\otimes a_{1}.
\end{align}


\item The isomorphism $\mathfrak{T}$ is linear
\begin{align}
\mathfrak{T}\left(  a_{11}\otimes a_{12}+a_{21}\otimes a_{22}\right)   &
=a_{12}\otimes a_{11}+a_{21}\otimes a_{22}\\
\mathfrak{T}\left(  za_{1}\otimes a_{2}\right)   &  =za_{2}\otimes a_{1}.
\end{align}


\item The exterior product between vectors belonging to different factors of
the tensor product is defined by the following

\begin{definition}
Let $a_{1}\in\mathcal{H}_{1}$ and $a_{2}\in\mathcal{H}_{2}$ then
\begin{equation}
a_{1}\wedge a_{2}=\frac{1}{2}\left(  a_{1}\otimes a_{2}-a_{2}\otimes
a_{1}\right)  =\frac{1}{2}\left(  a_{1}\otimes a_{2}-\mathfrak{T}\left(
a_{1}\otimes a_{2}\right)  \right)  \ \in\mathcal{H}_{1}\otimes\mathcal{H}%
_{2}+\mathcal{H}_{2}\otimes\mathcal{H}_{1},
\end{equation}
which can be expressed as
\begin{equation}
a_{1}\wedge a_{2}=\frac{1}{2!}\sum_{\sigma\in S_{2}}\left(  -1\right)
^{\pi\left(  \sigma\right)  }\left\vert a_{\sigma\left(  1\right)  }\otimes
a_{\sigma\left(  2\right)  }\right\rangle =\frac{1}{2}\left(  \left\vert
a_{1}\otimes a_{2}\right\rangle -\left\vert a_{2}\otimes a_{1}\right\rangle
\right)  =-a_{2}\wedge a_{1};\quad\left\vert a_{j}\right\rangle \in
\mathcal{H}_{j},1\leq j\leq2.
\end{equation}

\end{definition}

\item The general definition for vectors belonging to different Hilbert spaces
is
\begin{equation}
\left\vert a_{1}\wedge\cdots\wedge a_{n}\right\rangle \overset{\triangle
}{=}\frac{1}{n!}\sum_{\sigma\in S_{n}}\left(  -1\right)  ^{\pi\left(
\sigma\right)  }\left\vert a_{\sigma\left(  1\right)  }\otimes\cdots\otimes
a_{\sigma\left(  n\right)  }\right\rangle ;\quad\left\vert a_{j}\right\rangle
\in\mathcal{H}_{j},1\leq j\leq n.
\end{equation}


\item
\begin{equation}
\left\vert a_{1}\wedge\cdots\wedge a_{n}\right\rangle \in%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{\sigma\left(  1\right)  }\otimes\cdots\otimes\mathcal{H}%
_{\sigma\left(  n\right)  }.
\end{equation}


\begin{remark}%
\begin{equation}
\dim\left\{
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{\sigma\left(  1\right)  }\otimes\cdots\otimes\mathcal{H}%
_{\sigma\left(  n\right)  }\right\}  =n!r_{1}\cdots r_{n}=n!%
%TCIMACRO{\tprod \limits_{1\leq j\leq n}}%
%BeginExpansion
{\textstyle\prod\limits_{1\leq j\leq n}}
%EndExpansion
r_{j}.
\end{equation}

\end{remark}

\item The tensor product of vectors belonging to the direct sum $\mathcal{H}%
_{1}\oplus\mathcal{H}_{2}$
\[%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  =\left[  \mathcal{H}%
_{1}\otimes\mathcal{H}_{1}\right]  \oplus\left[  \mathcal{H}_{1}%
\otimes\mathcal{H}_{2}\right]  \oplus\left[  \mathcal{H}_{2}\otimes
\mathcal{H}_{1}\right]  \oplus\left[  \mathcal{H}_{2}\otimes\mathcal{H}%
_{2}\right]  .
\]


\item The exterior product of vectors belonging to the direct sum
$\mathcal{H}_{1}\oplus\mathcal{H}_{2}$ is defined using the $2$-particle
antisymmetrizer as
\begin{align}
&  \left(  a_{11}+a_{12}\right)  \wedge\left(  a_{21}+a_{22}\right)
=\mathcal{A}_{2}\left(  \left(  a_{11}+a_{12}\right)  \otimes\left(
a_{21}+a_{22}\right)  \right) \\
&  =\mathcal{A}_{2}\left(  a_{11}\otimes a_{21}+a_{11}\otimes a_{22}%
+a_{12}\otimes a_{21}+a_{12}\otimes a_{22}\right)  =\mathcal{A}_{2}%
a_{11}\otimes a_{21}+\mathcal{A}_{2}a_{11}\otimes a_{22}+\mathcal{A}_{2}%
a_{12}\otimes a_{21}+\mathcal{A}_{2}a_{12}\otimes a_{22}\\
&  =\frac{1}{2}\left\{  \left(  a_{11}\otimes a_{21}-a_{21}\otimes
a_{11}\right)  +\left(  a_{11}\otimes a_{22}-a_{22}\otimes a_{11}\right)
+\left(  a_{12}\otimes a_{21}-a_{21}\otimes a_{12}\right)  +\left(
a_{12}\otimes a_{22}-a_{22}\otimes a_{12}\right)  \right\}  ,
\end{align}
where
\begin{equation}
\mathcal{A}_{2}=\frac{1}{2!}%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{2}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{2}}}
%EndExpansion
\left(  -1\right)  ^{\pi\left(  \sigma\right)  }P_{\sigma}%
\end{equation}
and
\begin{equation}
P_{\sigma}:\mathcal{H}_{1}\otimes\mathcal{H}_{2}\rightarrow\mathcal{H}%
_{\sigma\left(  1\right)  }\otimes\mathcal{H}_{\sigma\left(  2\right)  }.
\end{equation}


\item The exterior product of the direct sum $\mathcal{H}_{1}\oplus
\mathcal{H}_{2}$ is defined using the $2$-particle antisymmetrizer
\begin{equation}
\mathcal{A}_{2}:%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  \rightarrow%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)
\end{equation}
as
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  =\mathcal{A}_{2}\left(
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  \right)  .
\end{equation}
In detail
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  =\mathcal{A}_{2}\left(
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  \right)  =\mathcal{A}%
_{2}\left(  \mathcal{H}_{1}\otimes\mathcal{H}_{1}\right)  \oplus
\mathcal{A}_{2}\left(  \mathcal{H}_{1}\otimes\mathcal{H}_{2}\right)
\oplus\mathcal{A}_{2}\left(  \mathcal{H}_{2}\otimes\mathcal{H}_{1}\right)
\oplus\mathcal{A}_{2}\left(  \mathcal{H}_{2}\otimes\mathcal{H}_{2}\right)  .
\end{equation}


\item
\begin{align}
\mathcal{A}_{2}  &  :\mathcal{H}_{1}\otimes\mathcal{H}_{1}\rightarrow
\mathcal{H}_{1}\otimes\mathcal{H}_{1}\\
\mathcal{A}_{2}  &  :\mathcal{H}_{1}\otimes\mathcal{H}_{2}\rightarrow
\mathcal{H}_{1}\otimes\mathcal{H}_{2}\oplus\mathcal{H}_{2}\otimes
\mathcal{H}_{1}\\
\mathcal{A}_{2}  &  :\mathcal{H}_{2}\otimes\mathcal{H}_{1}\rightarrow
\mathcal{H}_{1}\otimes\mathcal{H}_{2}\oplus\mathcal{H}_{2}\otimes
\mathcal{H}_{1}\\
\mathcal{A}_{2}  &  :\mathcal{H}_{2}\otimes\mathcal{H}_{2}\rightarrow
\mathcal{H}_{2}\otimes\mathcal{H}_{2}.
\end{align}


\item The general $n$-particle antisymmetrizer%
\begin{equation}
\mathcal{A}_{N}:%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{\sigma\left(  k_{1}\right)  }\otimes\cdots\otimes\mathcal{H}%
_{\sigma\left(  k_{n}\right)  }\rightarrow%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{\sigma\left(  k_{1}\right)  }\otimes\cdots\otimes\mathcal{H}%
_{\sigma\left(  k_{n}\right)  },
\end{equation}
is defined as
\begin{align}
\mathcal{A}_{N}  &  =\frac{1}{N!}%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\left(  -1\right)  ^{\pi\left(  \sigma\right)  }P_{n\sigma}\\
P_{n\sigma}  &  :\mathcal{H}_{k_{1}}\otimes\cdots\otimes\mathcal{H}_{k_{n}%
}\rightarrow\mathcal{H}_{k_{\sigma\left(  1\right)  }}\otimes\cdots
\otimes\mathcal{H}_{k_{\sigma\left(  n\right)  }},
\end{align}
where
\begin{equation}
\left(  k_{1},\cdots,k_{n}\right)  \in\mathbb{N}^{n}%
\end{equation}
and $k_{j},\,1\leq j\leq n$ do not have to be distinct i.e. $k_{j}%
=k_{p},\,1\leq j<p\leq n$ is possible.

\begin{remark}
In particular
\begin{equation}
P_{2\sigma}:\mathcal{H}_{1}\otimes\mathcal{H}_{1}\rightarrow\mathcal{H}%
_{1}\otimes\mathcal{H}_{1}.
\end{equation}

\end{remark}

\begin{example}
of $\sigma\in S_{2}$%
\begin{equation}
\left(  1,1\right)  ,\left(  1,2\right)  ,\left(  2,1\right)  ,\left(
2,2\right)  \in\mathbb{N}^{2}.
\end{equation}

\end{example}

\item Sequences generated by $\left\{  1,2\right\}  :$

\begin{enumerate}
\item sequences of order $2$ generated by $\left\{  1,2\right\}  $%
\begin{align}
&  \left(  1,1\right)  ,\#=\binom{2}{2},\\
&  \left(  1,2\right)  ,\left(  2,1\right)  ,\#=\binom{2}{1},\\
&  \left(  2,2\right)  ,\#=\binom{2}{0}.
\end{align}


\item sequences of order $3$ generated by $\left\{  1,2\right\}  $%
\begin{align}
&  \left(  1,1,1\right)  ,\#=\binom{3}{3},\\
&  \left(  1,1,2\right)  ,\left(  1,2,1\right)  ,\left(  2,1,1\right)
,\#=\binom{3}{2},\\
&  \left(  1,2,2\right)  ,\left(  2,1,2\right)  ,\left(  2,2,1\right)
,\#=\binom{3}{1},\\
&  \left(  2,2,2\right)  ,\#=\binom{3}{0}.
\end{align}


\item sequences of order $4$ generated by $\left\{  1,2\right\}  $%
\begin{align}
&  \left(  1,1,1,1\right)  ,\#=\binom{4}{4},\\
&  \left(  1,1,1,2\right)  ,\left(  1,1,2,1\right)  ,\left(  1,2,1,1\right)
,\left(  2,1,1,1\right)  ,\#=\binom{4}{3},\\
&  \left(  1,1,2,2\right)  ,\left(  1,2,1,2\right)  ,\left(  2,1,1,2\right)
,\left(  1,2,2,1\right)  ,\left(  2,1,1,2\right)  ,\left(  2,1,2,1\right)
,\#=\binom{4}{2},\\
&  \left(  2,2,2,1\right)  ,\left(  2,2,1,2\right)  ,\left(  2,1,2,2\right)
,\left(  1,2,2,2\right)  ,\#=\binom{4}{1},\\
&  \left(  2,2,2,2\right)  ,\#=\binom{4}{0}.
\end{align}

\end{enumerate}

\item
\begin{equation}%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  =%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{\sigma\left(  k_{1}\right)  }\otimes\cdots\otimes\mathcal{H}%
_{\sigma\left(  k_{n}\right)  }%
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  =\mathcal{A}_{n}\left(
\overset{}{%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}_{1}\oplus\mathcal{H}_{2}\right)  }\right)  =\mathcal{A}%
_{n}\left(
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{\sigma\left(  k_{1}\right)  }\otimes\cdots\otimes\mathcal{H}%
_{\sigma\left(  k_{n}\right)  }\right)  ,
\end{equation}
where
\begin{equation}
k_{j}\in\left\{  1,2\right\}  ;1\leq j\leq n.
\end{equation}


\item The $n$-fold tensor product of the $m$-fold direct sum
\begin{equation}%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
\left(
%TCIMACRO{\tbigoplus \limits_{1\leq j\leq m}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq j\leq m}}
%EndExpansion
\mathcal{H}_{j}\right)  =%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\mathcal{H}_{k_{\sigma\left(  1\right)  }}\otimes\cdots\otimes\mathcal{H}%
_{k_{\sigma\left(  n\right)  }}=%
%TCIMACRO{\tbigoplus \limits_{\sigma\in S_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\sigma\in S_{n}}}
%EndExpansion
\widetilde{%
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq n}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq n}}
%EndExpansion
}\mathcal{H}_{k_{\sigma\left(  j\right)  }},
\end{equation}
where $\widetilde{%
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq n}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq n}}
%EndExpansion
}$ denotes that if

\begin{enumerate}
\item
\begin{equation}
\left(  k_{\sigma\left(  1\right)  },\cdots,k_{\sigma\left(  n\right)
}\right)  =\left(  k_{\sigma^{\prime}\left(  1\right)  },\cdots,k_{\sigma
^{\prime}\left(  n\right)  }\right)  ,\,\sigma\neq\sigma^{\prime}\text{ then
}\mathcal{H}_{k_{\sigma\left(  1\right)  }}\otimes\cdots\otimes\mathcal{H}%
_{k_{\sigma\left(  n\right)  }}\text{ is only included once in the direct
sum.}%
\end{equation}
and

\item
\begin{equation}
k_{j}\in\left\{  1,\cdots,m\right\}  ;1\leq j\leq n.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\subsection{Direct Sum of Hilbert Spaces}

The direct sum of a sequence of Hilbert spaces $\left\{  \left.
\mathcal{H}_{j}\right\vert 1\leq j\leq m\right\}  $ is given by
\begin{equation}%
%TCIMACRO{\tbigoplus \limits_{1\leq j\leq m}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq j\leq m}}
%EndExpansion
\mathcal{H}_{j}\equiv\mathcal{H}_{1}\oplus\cdots\oplus\mathcal{H}_{m},
\end{equation}
where $%
%TCIMACRO{\tbigoplus \limits_{1\leq j\leq m}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq j\leq m}}
%EndExpansion
\mathcal{H}_{j}$ is the space formed by the completion of the sequences
\begin{equation}
\left(  v_{1},\cdots,v_{m}\right)  ;v_{j}\in A_{1};1\leq j\leq m
\end{equation}
wrt the direct sum norm
\begin{equation}
\left\Vert \left(  v_{1},\cdots,v_{m}\right)  \right\Vert _{\underset{1\leq
j\leq m}{\oplus}\mathcal{H}_{j}}=\sum_{1\leq j\leq m}\left\Vert v_{j}%
\right\Vert _{\mathcal{H}_{j}}.
\end{equation}


\begin{remark}
Direct sum $\mathbb{C}\oplus_{\mathbb{C}}\mathbb{C=C}^{1+1}=\mathbb{C}^{2}$
\begin{align}
\mathbb{C}\oplus_{\mathbb{C}}\mathbb{C}  &  =\left\{  \left.  z_{1}\oplus
z_{2}=\left(  z_{1},z_{2}\right)  \right\vert z_{1},z_{2}\in\mathbb{C}\right\}
\\
\eta\left(  z_{1}\oplus z_{2}\right)   &  =\left(  \eta z_{1}\oplus\eta
z_{2}\right)  =\left(  \eta z_{1},\eta z_{2}\right) \\
\left(  z_{1}\oplus z_{2}\right)  +\left(  z_{3}\oplus z_{4}\right)   &
=\left(  z_{1}+z_{3}\right)  \oplus\left(  z_{2}+z_{4}\right)  =\left(
z_{1}+z_{3},z_{2}+z_{4}\right) \\
\eta_{1}\left(  z_{1}\oplus z_{2}\right)  +\eta_{2}\left(  z_{3}\oplus
z_{4}\right)   &  =\left(  \eta_{1}z_{1}\oplus\eta_{1}z_{2}\right)  +\left(
\eta_{2}z_{3}\oplus\eta_{2}z_{4}\right)  =\left(  \eta_{1}z_{1}+\eta_{2}%
z_{3},\eta_{1}z_{2}+\eta_{2}z_{4}\right) \\
\left\Vert z_{1}\oplus z_{2}\right\Vert ^{2}  &  =\left\vert z_{1}\right\vert
^{2}+\left\vert z_{2}\right\vert ^{2}.
\end{align}


Tensor product $\mathbb{C\otimes_{\mathbb{C}}C}=\mathbb{C}^{1\times
1}=\mathbb{C}$
\begin{align}
\mathbb{C}\otimes_{\mathbb{C}}\mathbb{C}  &  =\left\{  \left.  z_{1}\otimes
z_{2}=\left(  z_{1},z_{2}\right)  =z_{1}\cdot z_{2}=z_{1}z_{2}\right\vert
z_{1},z_{2}\in\mathbb{C}\right\} \\
\eta\left(  z_{1}\otimes z_{2}\right)   &  =\left(  \eta^{\frac{1}{2}}%
z_{1}\right)  \otimes\left(  \eta^{\frac{1}{2}}z_{2}\right)  =\left(
\eta^{\frac{1}{2}}z_{1},\eta^{\frac{1}{2}}z_{2}\right)  =\eta^{\frac{1}{2}%
}z_{1}\eta^{\frac{1}{2}}z_{2}=\eta z_{1}z_{2}\\
\left(  z_{1}\otimes z_{2}\right)  +\left(  z_{3}\otimes z_{4}\right)   &
=\left(  z_{1},z_{2}\right)  +\left(  z_{3},z_{4}\right)  =z_{1}z_{2}%
+z_{3}z_{4}\\
\eta_{1}\left(  z_{1}\otimes z_{2}\right)  +\eta_{2}\left(  z_{3}\otimes
z_{4}\right)   &  =\eta_{1}\left(  z_{1},z_{2}\right)  +\eta_{2}\left(
z_{3},z_{4}\right)  =\left(  \eta_{1}^{\frac{1}{2}}z_{1},\eta_{1}^{\frac{1}%
{2}}z_{2}\right)  +\left(  \eta_{2}^{\frac{1}{2}}z_{3},\eta_{2}^{\frac{1}{2}%
}z_{4}\right)  =\eta_{1}z_{1}z_{2}+\eta_{2}z_{3}z_{4}\\
\left\Vert z_{1}\otimes z_{2}\right\Vert ^{2}  &  =\left\vert z_{1}\right\vert
^{2}\left\vert z_{2}\right\vert ^{2}.
\end{align}

\end{remark}

\subsection{Graded Vector Spaces}

A \emph{graded vector space}, $V,$ is a direct sum of vector spaces, $\left\{
\left.  W_{j}\right\vert j\in\mathcal{I}\right\}  ,$where $\mathcal{I}$ is an
index set i.e.
\begin{equation}
V=\bigoplus\limits_{j\in\mathcal{I}}W_{j}.
\end{equation}
If $\mathcal{V}_{1}$ and $\mathcal{V}_{2}$ are two $\mathcal{I}$-graded vector
spaces then $\mathcal{V}_{1}\oplus\mathcal{V}_{2}$ is also an $\mathcal{I}%
$-graded vector space with the gradation given by
\begin{equation}
\left(  \mathcal{V}_{1}\oplus\mathcal{V}_{2}\right)  _{j}=\mathcal{V}%
_{1j}\oplus\mathcal{V}_{2j}%
\end{equation}
and if $\mathcal{I}$ is a semi group then $\mathcal{V}_{1}\oplus
\mathcal{V}_{2}$ is \emph{also} an $\mathcal{I}$-graded vector space with the
gradation given by
\begin{equation}
\left(  \mathcal{V}_{1}\otimes\mathcal{V}_{2}\right)  _{j}=\bigoplus
\limits_{\left\{  \left.  \left(  k,l\right)  \right\vert k\ast l=j\right\}
}\mathcal{V}_{1k}\otimes\mathcal{V}_{2l}.
\end{equation}
The most common index sets are
\begin{align}
\mathcal{I}  &  =\mathbb{N}\\
\mathcal{I}  &  =\left\{  0,1\right\}  =\mathbb{Z}_{2},\text{ (super
space)}\equiv\mathbb{N}_{2}\\
\mathcal{I}  &  =\mathbb{Z}.
\end{align}


\subsection{Graded Algebras}

\begin{definition}
A \emph{MODULE }$\emph{M:}$ Let $R$ be a ring and $I_{R}$ is its
multiplicative identity. A \emph{left }$R$\emph{-module }$M$ consists of an
abelian group $\left\{  M,+\right\}  $ and an operation $\cdot:$ $R\times
M\rightarrow M$ such that for all $r,s$ in $R$ and $x,y$ in $M$, we have:

\begin{enumerate}
\item
\begin{equation}
r\cdot(x+y)=r\cdot x+r\cdot y
\end{equation}


\item
\begin{equation}
(r+s)\cdot x=r\cdot x+s\cdot x
\end{equation}


\item
\begin{equation}
(rs)\cdot x=r\cdot(s\cdot x)
\end{equation}


\item
\begin{equation}
I_{R}\cdot x=x.
\end{equation}
Let $G$ be a group, $\mathcal{C}$ a commutative ring with identity $I$ and
$\mathcal{A}$ a $\mathcal{C}$--algebra (an algebra with "scalars" in
$\mathcal{C}$ ) then
\end{enumerate}
\end{definition}

\begin{definition}
$\mathcal{A}$ is called a $G$\emph{--graded }$C$\emph{-algebra} if for every
$g\in G$ there exists \emph{a }$\mathcal{C}$\emph{-module} $\mathcal{A}_{g}$
such that

\begin{enumerate}
\item
\begin{equation}
\mathcal{A}_{g}\mathcal{A}_{h}\subseteq\mathcal{A}_{gh};\,g,h\in G
\end{equation}


\item
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{g\in G}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{g\in G}}
%EndExpansion
\mathcal{A}_{g};\,\mathcal{A}_{g}\text{ are }\mathcal{C}\text{-modules.}%
\end{equation}

\end{enumerate}
\end{definition}

\begin{definition}
A $\mathbb{N}^{+}$-\emph{graded algebra} $\mathcal{A}$ is a vector space that
has a direct sum decomposition
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq\infty}}
%EndExpansion
\mathcal{A}_{n}%
\end{equation}
that has the property
\begin{equation}
\mathcal{A}_{m}\mathcal{A}_{n}\subseteq\mathcal{A}_{m+n}.
\end{equation}

\end{definition}

\begin{definition}
A $\mathbb{N}_{p}^{+}$-graded algebra $\mathcal{A}$ is a vector space that has
a direct sum decomposition
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{1\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq n\leq p}}
%EndExpansion
\mathcal{A}_{n}%
\end{equation}
that has the property
\begin{equation}
\mathcal{A}_{m}\mathcal{A}_{n}\subseteq\mathcal{A}_{m+n}.
\end{equation}

\end{definition}

\begin{definition}
A $\mathbb{N}^{\cdot}$-graded algebra $\mathcal{A}$ is a vector space that has
a direct sum decomposition
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq\infty}}
%EndExpansion
\mathcal{A}_{n}%
\end{equation}
that has the property
\begin{equation}
\mathcal{A}_{m}\mathcal{A}_{n}\subseteq\mathcal{A}_{mn}.
\end{equation}

\end{definition}

\begin{definition}
A $\mathbb{N}_{p}^{\cdot}$-graded algebra $\mathcal{A}$ is a vector space that
has a direct sum decomposition
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq p}}
%EndExpansion
\mathcal{A}_{n}%
\end{equation}
that has the property
\begin{equation}
\mathcal{A}_{m}\mathcal{A}_{n}\subseteq\mathcal{A}_{mn}.
\end{equation}

\end{definition}

\begin{example}
An algebra
\begin{equation}
\mathcal{A}=\mathcal{A}_{0}\oplus\mathcal{A}_{1},
\end{equation}
where%
\begin{align}
\mathcal{A}_{0}\mathcal{A}_{0}  &  =\mathcal{A}_{0}\\
\mathcal{A}_{0}\mathcal{A}_{1}  &  =\mathcal{A}_{1}\\
\mathcal{A}_{1}\mathcal{A}_{1}  &  =\mathcal{A}_{2}%
\end{align}
is \underline{\emph{not}} a $\mathbb{N}_{2}^{+}$-graded algebra.
\end{example}

\begin{example}
An algebra
\begin{equation}
\mathcal{A}=\mathcal{A}_{0}\oplus\mathcal{A}_{1},
\end{equation}
where%
\begin{align}
\mathcal{A}_{0}\mathcal{A}_{0}  &  =\mathcal{A}_{0}\\
\mathcal{A}_{0}\mathcal{A}_{1}  &  =\mathcal{A}_{0}\\
\mathcal{A}_{1}\mathcal{A}_{1}  &  =\mathcal{A}_{1}%
\end{align}
is a $\mathbb{N}_{2}^{\cdot}$-graded algebra and corresponds to
\begin{align}
\mathcal{A}_{0}  &  =\mathcal{A}_{\text{even}}\\
\mathcal{A}_{1}  &  =\mathcal{A}_{\text{odd}}%
\end{align}
\emph{and is a} \emph{super algebra}.
\end{example}

\begin{definition}
A $\mathbb{Z}_{m}^{+/\cdot}$-graded algebra $\mathcal{A}$ is a vector space
that has a direct sum decomposition
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{-m\leq n\leq m}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{-m\leq n\leq m}}
%EndExpansion
\mathcal{A}_{n}%
\end{equation}
that has the property
\begin{equation}
\mathcal{A}_{m}\mathcal{A}_{n}\subseteq\mathcal{A}_{m+n}.
\end{equation}

\end{definition}

\begin{remark}
We consider $0$ to be a natural number and an integer.
\end{remark}

\begin{remark}
The \emph{normal tensor product }$\otimes$ \emph{is a bilinear map from the
spaces }$\mathcal{X}\ $and $\mathcal{Y}$ to the linear space $\mathcal{X}%
\otimes\mathcal{Y}$ i.e. \emph{ }%
\begin{equation}
\otimes:\mathcal{X}\times\mathcal{Y}\rightarrow\mathcal{X}\otimes\mathcal{Y}.
\end{equation}

\end{remark}

\subsection{Tensor Product and Skew Tensor Product}

\begin{itemize}
\item A multiplication "$\cdot_{\mathcal{XY}}$" in the\emph{ }$\mathbb{N}%
$-graded \emph{tensor product }algebra\emph{ }$\mathcal{X}\otimes\mathcal{Y}$
of the $\mathbb{N}$-graded algebras $\mathcal{X}$ and $\mathcal{Y}$ \emph{ }%
\begin{equation}
\cdot_{\mathcal{XY}}:\left(  \mathcal{X}\otimes\mathcal{Y}\right)
\times\left(  \mathcal{X}\otimes\mathcal{Y}\right)  \rightarrow\mathcal{X}%
\otimes\mathcal{Y},
\end{equation}
$\mathcal{\ }$is defined by
\end{itemize}

%

\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \left[  \cdot_{\mathcal{XY}%
}\right]  \left(  x_{p_{2}}\otimes y_{q_{2}}\right)  =\left(  1\right)
^{p_{2}q_{1}}\left(  x_{p_{1}}\left[  \cdot_{\mathcal{X}}\right]  x_{p_{2}%
}\right)  \otimes\left(  y_{q_{1}}\left[  \cdot_{\mathcal{Y}}\right]
y_{q_{2}}\right)  \ ,
\end{equation}
where "$\cdot_{\mathcal{X}}$" and "$\cdot_{\mathcal{Y}}$" are the algebraic
products in $\mathcal{X}$ and $\mathcal{Y}$ respectively and
\begin{align}
p_{2}  &  =\deg\left(  x_{p_{2}}\right) \\
q_{1}  &  =\deg\left(  y_{q_{1}}\right)  .
\end{align}


\begin{remark}
This makes $\mathcal{X}\otimes\mathcal{Y}$ a $\mathbb{N}$-graded algebra
--\emph{though NOT a tensor algebra due to the fact that the algebraic product
is not} "$\otimes$" as
\begin{equation}
\otimes:\left(  \mathcal{X}\otimes\mathcal{Y}\right)  \times\left(
\mathcal{X}\otimes\mathcal{Y}\right)  \rightarrow\mathcal{X}\otimes
\mathcal{Y}\otimes\mathcal{X}\otimes\mathcal{Y},
\end{equation}
but%
\begin{equation}
\otimes:\left(  \mathcal{X}\otimes\mathcal{Y}\right)  \times\left(
\mathcal{X}\otimes\mathcal{Y}\right)  \nrightarrow\mathcal{X}\otimes
\mathcal{Y}.
\end{equation}

\end{remark}

\begin{remark}
If $\mathcal{X}=\mathcal{Y}$ and
\begin{equation}
\mathcal{X}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq\infty}}
%EndExpansion%
%TCIMACRO{\tbigotimes \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{n}}
%EndExpansion
V=%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  V\right)
\end{equation}
then
\begin{equation}
\mathcal{X}\otimes\mathcal{X=X}%
\end{equation}
and
\begin{equation}
\otimes:\left(  \mathcal{X}\otimes\mathcal{X}\right)  \times\left(
\mathcal{X}\otimes\mathcal{X}\right)  \rightarrow\mathcal{X},\
\end{equation}
thus $\mathcal{X}\otimes\mathcal{Y=X}\otimes\mathcal{X=X}$ is a tensor algebra
i.e.
\begin{equation}
\otimes:\mathcal{X}\times\mathcal{X}\rightarrow\mathcal{X}.\
\end{equation}

\end{remark}

\begin{remark}
$%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $ and $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ are exterior algebras wrt the antisymmetric tensor
product "$\wedge$"
\begin{align}
\wedge &  :%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \times%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \rightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right) \\
\wedge &  :%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \times%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \rightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  ,
\end{align}
however "$\wedge$" is not an algebraic product for the mixed exterior algebra
$%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ i.e.
\begin{equation}
\wedge:\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right)  \times\left(
%TCIMACRO{\tbigwedge }%
