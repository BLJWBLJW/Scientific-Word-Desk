\left\langle \eta_{1}\cdots\eta_{p}\right\vert \right)    & =\left\vert
\gamma_{1}\gamma_{2}\right\rangle \left\langle \eta_{1}\eta_{2}\right\vert
\boxtimes P_{\mathcal{H}^{N-2}}=\left\vert \gamma_{1}\gamma_{2}\right\rangle
\left\langle \eta_{1}\eta_{2}\right\vert \boxtimes\sum_{1\leq j_{3}%
\,<\cdots<j_{N}\leq r}\left\vert \varphi_{j_{3}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{3}}\cdots\varphi_{j_{N}}\right\vert
\\
& =2!\left(  N-2\right)  !\left\vert \gamma_{1}\wedge\gamma_{2}\right\rangle
\left\langle \eta_{1}\wedge\eta_{2}\right\vert \boxtimes\sum_{1\leq
j_{3}\,<\cdots<j_{N}\leq r}\left\vert \varphi_{j_{3}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{3}\wedge\cdots\wedge
\varphi_{j_{N}}\right\vert \\
& =2!\left(  N-2\right)  !\sum_{1\leq j_{3}\,<\cdots<j_{N}\leq r}\left\vert
\gamma_{1}\wedge\gamma_{2}\wedge\varphi_{j_{3}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \eta_{1}\wedge\eta_{2}\wedge
\varphi_{3}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \\
& =2!\left(  N-2\right)  !\left(  N!\right)  ^{-1}\sum_{1\leq j_{3}%
\,<\cdots<j_{N}\leq r}\left\vert \gamma_{1}\gamma_{2}\varphi_{j_{3}}%
\cdots\varphi_{j_{N}}\right\rangle \left\langle \eta_{1}\eta_{2}\varphi
_{j_{3}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}


\item $N=5$%
\begin{align}
& \Gamma_{2}^{N}\left(  \left\vert \gamma_{1}\cdots\gamma_{p}\right\rangle
\left\langle \eta_{1}\cdots\eta_{p}\right\vert \right)  =\left\vert \gamma
_{1}\gamma_{2}\right\rangle \left\langle \eta_{1}\eta_{2}\right\vert \boxtimes
P_{\mathcal{H}^{3}}=\left\vert \gamma_{1}\gamma_{2}\right\rangle \left\langle
