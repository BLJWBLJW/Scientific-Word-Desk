\begin{enumerate}
\item The definition of the skew tensor product is
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @_{\mathcal{XY}}\left(  x_{p_{2}%
}\otimes y_{q_{2}}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}%
}\left(  \cdot_{\mathcal{X}}\right)  x_{p_{2}}\right)  \otimes\left(
y_{q_{1}}\left(  \cdot_{\mathcal{Y}}\right)  y_{q_{2}}\right)  \in
\mathcal{X\otimes Y},
\end{equation}
as
\begin{align}
x_{p_{1}}\left(  \cdot_{\mathcal{X}}\right)  x_{p_{2}}  &  \in\mathcal{X}=%
%TCIMACRO{\tbigotimes }%
