_{3}\wedge\varphi_{j_{4}}\wedge\varphi_{j_{5}}\right\vert \\
& =\left(  2!\right)  \left(  3!\right)  \sum_{1\leq j_{3}\,<\cdots<j_{5}\leq
r}\left\vert \gamma_{1}\wedge\gamma_{2}\wedge\varphi_{j_{3}}\wedge
\varphi_{j_{4}}\wedge\varphi_{j_{5}}\right\rangle \left\langle \eta_{1}%
\wedge\eta_{2}\wedge\varphi_{3}\wedge\varphi_{j_{4}}\wedge\varphi_{j_{5}%
}\right\vert \\
& =\left(  2!\right)  \left(  3!\right)  \left(  5!\right)  ^{-1}\sum_{1\leq
j_{3}\,<\cdots<j_{5}\leq r}\left\vert \gamma_{1}\gamma_{2}\varphi_{j_{3}%
}\varphi_{j_{4}}\varphi_{j_{5}}\right\rangle \left\langle \eta_{1}\eta
_{2}\varphi_{j_{3}}\varphi_{j_{4}}\varphi_{j_{5}}\right\vert =\binom{5}%
{2}^{-1}\sum_{1\leq j_{3}\,<\cdots<j_{5}\leq r}\left\vert \gamma_{1}\gamma
_{2}\varphi_{j_{3}}\varphi_{j_{4}}\varphi_{j_{5}}\right\rangle \left\langle
\eta_{1}\eta_{2}\varphi_{j_{3}}\varphi_{j_{4}}\varphi_{j_{5}}\right\vert .
\end{align}


\item
\begin{equation}
\Gamma_{p}^{N}:\mathcal{B}\left(  \mathcal{H}^{P}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{N}\right)  .
\end{equation}


\item
\begin{equation}
\Gamma_{p}^{N}\left(  X\right)  =X_{P}\boxtimes P_{\mathcal{H}^{N-P}%
}=P_{\mathcal{H}^{N-P}}\boxtimes X_{P}=\mathcal{A}_{N}X_{P}\otimes
P_{\mathcal{H}^{N-P}}\mathcal{A}_{N}=\mathcal{A}_{N}P_{\mathcal{H}^{N-P}%
}\otimes X_{P}\mathcal{A}_{N},
\end{equation}
one should note that $\mathcal{A}_{N}\in\mathcal{B}\left(  \mathcal{H}%
^{N\otimes}\right)  ,$ while $P_{\mathcal{H}^{N}}\in\mathcal{B}\left(
\mathcal{H}^{N}\right)  ,$ ($\mathcal{H}^{N}\equiv\mathcal{H}^{N\wedge}$)$.$

\item
\begin{equation}
\Gamma^{N}\left(  X_{P}\right)  =\sum_{0\leq P\leq N}\binom{N}{P}\Gamma
_{P}^{N}\left(  X_{P}\right)  .
\end{equation}


\item
\begin{equation}
\Gamma\left(  X\right)  =\sum_{0\leq P,N\leq r}\Gamma^{N}\left(  X_{P}\right)
=\sum_{0\leq P,N\leq r}\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right)
=\sum_{0\leq P\leq N\leq r}\binom{N}{P}X_{P}\boxtimes P_{\mathcal{H}^{N-P}}.
\end{equation}

\end{enumerate}

\begin{theorem}%
\begin{align}
\Gamma_{p}^{N}\left(  \left\vert \gamma_{1}\cdots\gamma_{p}\right\rangle
\left\langle \eta_{1}\cdots\eta_{p}\right\vert \right)    & =\left\vert
\gamma_{1}\cdots\gamma_{p}\right\rangle \left\langle \eta_{1}\cdots\eta
_{p}\right\vert \boxtimes P_{\mathcal{H}^{N-P}}=\left\vert \gamma_{1}%
\cdots\gamma_{p}\right\rangle \left\langle \eta_{1}\cdots\eta_{p}\right\vert
\boxtimes\sum_{1\leq j_{P+1}\,<\cdots<j_{N}\leq r}\left\vert \varphi_{j_{P+1}%
}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{P+1}}%
\cdots\varphi_{j_{N}}\right\vert \\
& =\binom{N}{p}^{-1}\sum_{1\leq j_{P+1}\,<\cdots<j_{N}\leq r}\left\vert
\gamma_{1}\cdots\gamma_{p}\varphi_{j_{P+1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \eta_{1}\cdots\eta_{p}\varphi_{j_{P+1}}\cdots\varphi_{j_{N}%
}\right\vert .
\end{align}

\end{theorem}

\begin{example}


\begin{enumerate}
\item
\begin{align}
\Gamma_{0}^{N}\left(  \left\vert \phi\right\rangle \left\langle \phi
\right\vert \right)    & =\left\vert \phi\right\rangle \left\langle
\phi\right\vert \boxtimes P_{\mathcal{H}^{N}}=\left\vert \phi\right\rangle
\left\langle \phi\right\vert \boxtimes\sum_{1\leq j_{1}\,<\cdots<j_{N}\leq
r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \\
& =\binom{N}{0}^{-1}\sum_{1\leq j_{1}\,<\cdots<j_{N}\leq r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert =P_{\mathcal{H}^{N}}.
\end{align}


\item
\begin{align}
\Gamma_{1}^{N}\left(  \left\vert \gamma_{1}\right\rangle \left\langle \eta
_{1}\right\vert \right)    & =\left\vert \gamma_{1}\right\rangle \left\langle
\eta\right\vert \boxtimes P_{\mathcal{H}^{N-1}}=\left\vert \gamma
_{1}\right\rangle \left\langle \eta_{1}\right\vert \boxtimes\sum_{1\leq
j_{2}\,<\cdots<j_{N}\leq r}\left\vert \varphi_{j_{2}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{2}}\cdots\varphi_{j_{N}}\right\vert
\\
& =\binom{N}{1}^{-1}\sum_{1\leq j_{2}\,<\cdots<j_{N}\leq r}\left\vert
\gamma_{1}\varphi_{j_{2}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\eta_{1}\varphi_{j_{2}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}


\item
\begin{align}
\Gamma_{2}^{N}\left(  \left\vert \gamma_{1}\gamma_{2}\right\rangle
\left\langle \eta_{1}\eta_{2}\right\vert \right)    & =\left\vert \gamma
_{1}\gamma_{2}\right\rangle \left\langle \eta_{1}\eta_{2}\right\vert \boxtimes
P_{\mathcal{H}^{N-2}}=\left\vert \gamma_{1}\gamma_{2}\right\rangle
\left\langle \eta_{1}\eta_{2}\right\vert \boxtimes\sum_{1\leq j_{3}%
\,<\cdots<j_{N}\leq r}\left\vert \varphi_{j_{3}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{3}}\cdots\varphi_{j_{N}}\right\vert
\\
& =\binom{N}{2}^{-1}\sum_{1\leq j_{P+1}\,<\cdots<j_{N}\leq r}\left\vert
\gamma_{1}\gamma_{2}\varphi_{j_{3}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \eta_{1}\eta_{2}\varphi_{j_{3}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}

\end{enumerate}
\end{example}

\begin{remark}%
\begin{equation}
\Gamma\left(  X\right)  =\sum_{0\leq P,N\leq r}\Gamma^{N}\left(  X_{P}\right)
=\sum_{0\leq P,N\leq r}\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right)
=\sum_{0\leq P\leq N\leq r}\binom{N}{P}X_{P}\boxtimes P_{\mathcal{H}^{N-P}}.
\end{equation}

\end{remark}

\begin{corollary}%
\begin{equation}
\Gamma\left(  \left\vert \gamma_{1}\cdots\gamma_{p}\right\rangle \left\langle
\eta_{1}\cdots\eta_{p}\right\vert \right)  =\sum_{1\leq N\leq r}\binom{N}%
{p}\left\vert \gamma_{1}\cdots\gamma_{p}\right\rangle \left\langle \eta
_{1}\cdots\eta_{p}\right\vert \boxtimes P_{\mathcal{H}^{N-p}}=\sum_{1\leq
N\leq r}\sum_{1\leq j_{P+1}\,<\cdots<j_{N}\leq r}\left\vert \gamma_{1}%
\cdots\gamma_{p}\varphi_{j_{P+1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \eta_{1}\cdots\eta_{p}\varphi_{j_{P+1}}\cdots\varphi_{j_{N}%
}\right\vert
\end{equation}

\end{corollary}

\begin{example}
$P=1$%
\begin{gather}
\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert \right)  =\sum_{1\leq N\leq r}\binom{N}{1}\left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert \boxtimes
P_{\mathcal{H}^{N-1}}\\
=\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
+1\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
\boxtimes\sum_{1\leq p\leq r}\left\vert \varphi_{p}\right\rangle \left\langle
\varphi_{p}\right\vert +2\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert \boxtimes\sum_{1\leq p_{1}\,<p_{2}\leq r}\left\vert
\varphi_{p_{1}}\varphi_{p_{2}}\right\rangle \left\langle \varphi_{p_{1}%
}\varphi_{p_{2}}\right\vert +\cdots+r\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert \boxtimes\sum_{1\leq p_{1}\,<\cdots
<p_{r-1}\leq r}\left\vert \varphi_{p_{1}}\cdots\varphi_{p_{r-1}}\right\rangle
\left\langle \varphi_{p_{1}}\cdots\varphi_{p_{r-1}}\right\vert \\
=\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
+\sum_{1\leq p\leq r}\left\vert \varphi_{j}\varphi_{p}\right\rangle
\left\langle \varphi_{k}\varphi_{p}\right\vert +\sum_{1\leq p_{1}\,<p_{2}\leq
r}\left\vert \varphi_{j}\varphi_{p_{1}}\varphi_{p_{2}}\right\rangle
\left\langle \varphi_{k}\varphi_{p_{1}}\varphi_{p_{2}}\right\vert +\cdots
+\sum_{1\leq p_{1}\,<\cdots<p_{r-1}\leq r}\left\vert \varphi_{j}\varphi
_{p_{1}}\cdots\varphi_{p_{r-1}}\right\rangle \left\langle \varphi_{k}%
\varphi_{p_{1}}\cdots\varphi_{p_{r-1}}\right\vert .
\end{gather}

\end{example}

\begin{example}
Let $r=4$ and $j=1,k=2$ then
\begin{align}
\Gamma\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{2}\right\vert \right)    & =\sum_{1\leq N\leq4}\binom{N}{P}\Gamma_{1}%
^{N}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{2}\right\vert \right)  =\binom{1}{1}\Gamma_{1}^{1}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert \right)
+\binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  +\binom{3}{1}\Gamma_{1}%
^{3}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{2}\right\vert \right)  +\binom{4}{1}\Gamma_{1}^{1}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert \right)  \\
& =\sum_{1\leq N\leq4}\binom{N}{P}\Gamma_{1}^{N}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{2}\right\vert \right)  =\binom{1}%
{1}\Gamma_{1}^{1}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{2}\right\vert \right)  +\binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert \right)  \\
& =\binom{1}{1}\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{2}\right\vert \boxtimes\left\vert \phi\right\rangle \left\langle
\phi\right\vert +\binom{2}{1}\left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{2}\right\vert \boxtimes P_{\mathcal{H}^{1}}+\binom{3}{1}\left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert \boxtimes
P_{\mathcal{H}^{2}}\\
& =\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert
+\sum_{1\leq p\leq4}\left\vert \varphi_{1}\varphi_{p}\right\rangle
\left\langle \varphi_{2}\varphi_{p}\right\vert +\sum_{1\leq p_{1}\,<p_{2}%
\leq4}\left\vert \varphi_{1}\varphi_{p_{1}}\varphi_{p_{2}}\right\rangle
\left\langle \varphi_{2}\varphi_{p_{1}}\varphi_{p_{2}}\right\vert \\
& =\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert
+\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi
_{2}\varphi_{3}\right\vert +\left\vert \varphi_{1}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{1}%
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{3}%
\varphi_{4}\right\vert ,
\end{align}
where
\begin{equation}
\binom{2}{1}\Gamma_{1}^{2}\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  =\binom{2}{1}\left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert \boxtimes
P_{\mathcal{H}^{1}}=\left(  \left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert +\left\vert \varphi_{1}%
\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
\right)
\end{equation}
and%
\begin{equation}
\binom{3}{1}\Gamma_{1}^{3}\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  =\binom{3}{1}\left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert \boxtimes
P_{\mathcal{H}^{2}}=\left(  \left\vert \varphi_{1}\varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert
\right)  .
\end{equation}

\end{example}

\begin{definition}
The expansion map can be generalized to
\begin{equation}
\Gamma_{PQ}^{\left(  P+N\right)  \left(  Q+N\right)  }:\mathcal{B}\left(
\mathcal{H}^{P},\mathcal{H}^{Q}\right)  \rightarrow\mathcal{B}\left(
\mathcal{H}^{P+N},\mathcal{H}^{Q+N}\right)
\end{equation}
by
\begin{equation}
\Gamma_{PQ}^{\left(  P+N\right)  ,\left(  Q+N\right)  }\left(  X_{PQ}\right)
=X_{PQ}\bullet P_{\mathcal{H}^{N}}=\mathcal{A}_{P+N}X_{PQ}\otimes
P_{\mathcal{H}^{N}}\mathcal{A}_{Q+N}.
\end{equation}

\end{definition}

\begin{example}
Let $r=4,$ $P=1,$ $Q=0,$ $N=2$ and recall
\begin{align}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle  & =\sqrt{2!}\left\vert
\varphi_{j_{1}}\wedge\varphi_{j_{2}}\right\rangle \\
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}}\right\rangle  &
=\sqrt{3!}\left\vert \varphi_{j_{1}}\wedge\varphi_{j_{2}}\wedge\varphi_{j_{3}%
}\right\rangle
\end{align}
then
\begin{equation}
\Gamma_{1,0}^{3,2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert \right)  =\left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert \bullet P_{\mathcal{H}^{2}}=\left(  2!\right)  \sum_{1\leq
j_{1}<j_{2}\leq r}\left\vert \varphi_{j}\wedge\varphi_{j_{1}}\wedge
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\wedge\varphi_{j_{2}%
}\right\vert =\left(  3!\right)  ^{-\frac{1}{2}}\left(  2!\right)  ^{\frac
{1}{2}}\sum_{1\leq j_{1}<,j_{2}\leq r}\left\vert \varphi_{j}\varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert .
\end{equation}

\end{example}

\begin{remark}
In general%
\begin{align}
& \Gamma_{P,Q}^{N+P,N+Q}\left(  \left\vert \psi_{1}\cdots\psi_{P}\right\rangle
\left\langle \gamma_{1}\cdots\gamma_{Q}\right\vert \right)  =\left\vert
\psi_{1}\cdots\psi_{P}\right\rangle \left\langle \gamma_{1}\cdots\gamma
_{Q}\right\vert \bullet\left(  \sum_{1\leq j_{1}<\cdots<,j_{N}\leq
r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \right)  \\
& =\left(  N!\right)  \left\vert \psi_{1}\cdots\psi_{P}\right\rangle
\left\langle \gamma_{1}\cdots\gamma_{Q}\right\vert \bullet\left(  \sum_{1\leq
j_{1}<\cdots<,j_{N}\leq r}\left\vert \varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{N}}\right\vert \right)  \\
& =\left(  P!\right)  ^{\frac{1}{2}}\left(  Q!\right)  ^{\frac{1}{2}}\left(
N!\right)  \left\vert \psi_{1}\wedge\cdots\wedge\psi_{P}\right\rangle
\left\langle \gamma_{1}\wedge\cdots\wedge\gamma_{Q}\right\vert \bullet\left(
\sum_{1\leq j_{1}<\cdots<,j_{N}\leq r}\left\vert \varphi_{j_{1}}\wedge
\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \right)  \,\\
& =\left(  P!\right)  ^{\frac{1}{2}}\left(  Q!\right)  ^{\frac{1}{2}}\left(
N!\right)  \sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert \psi_{1}%
\wedge\cdots\wedge\psi_{P}\wedge\varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \gamma_{1}\wedge\cdots\wedge
\gamma_{Q}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert
\\
& =\left(  P!\right)  ^{\frac{1}{2}}\left(  Q!\right)  ^{\frac{1}{2}}\left(
N!\right)  \left(  \left(  N+P\right)  !\right)  ^{-\frac{1}{2}}\left(
\left(  N+Q\right)  !\right)  ^{-\frac{1}{2}}\sum_{1\leq j_{1}<\cdots
<j_{N}\leq r}\left\vert \psi_{1}\cdots\psi_{P}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \gamma_{1}\cdots\gamma_{Q}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}

\end{remark}

\begin{remark}
Let $P=Q$ then
\begin{align}
& \Gamma_{P,P}^{N+P,N+P}\left(  \left\vert \psi_{1}\cdots\psi_{P}\right\rangle
\left\langle \gamma_{1}\cdots\gamma_{P}\right\vert \right)  =\left\vert
\psi_{1}\cdots\psi_{P}\right\rangle \left\langle \gamma_{1}\cdots\gamma
_{P}\right\vert \bullet P_{\mathcal{H}^{N}}=\left\vert \psi_{1}\cdots\psi
_{P}\right\rangle \left\langle \gamma_{1}\cdots\gamma_{P}\right\vert \boxtimes
P_{\mathcal{H}^{N}}\\
& =\left(  P!\right)  \left(  N!\right)  \left(  \left(  N+P\right)  !\right)
^{-1}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert \psi_{1}\cdots\psi
_{P}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \gamma
_{1}\cdots\gamma_{Q}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \\
& =\binom{N+P}{P}^{-1}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert \psi
_{1}\cdots\psi_{P}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \gamma_{1}\cdots\gamma_{Q}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert ,
\end{align}
which agrees with the previously derived results. 
\end{remark}

\begin{remark}
Let $r=4,$ $P=1,$ $Q=0,$ $N=2$ then
\begin{align}
\Gamma_{P,Q}^{N+P,N+Q}\left(  \left\vert \psi_{1}\right\rangle \left\langle
\phi\right\vert \right)    & =\left(  1!\right)  ^{\frac{1}{2}}\left(
0!\right)  ^{\frac{1}{2}}\left(  2!\right)  \left(  \left(  3\right)
!\right)  ^{-\frac{1}{2}}\left(  \left(  2\right)  !\right)  ^{-\frac{1}{2}%
}\sum_{1\leq j_{1}<\cdots<j_{N}\leq4}\left\vert \psi_{1}\varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \phi\varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \\
& =\left(  \left(  3\right)  !\right)  ^{-\frac{1}{2}}\left(  \left(
2\right)  !\right)  ^{\frac{1}{2}}\sum_{1\leq j_{1}<j_{2}\leq4}\left\vert
\psi_{1}\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert ,
\end{align}
which agrees with the previous expression. 
\end{remark}

\begin{remark}%
\begin{equation}
P_{\mathcal{H}^{N}}=P_{\mathcal{H}^{1}}^{N\bullet}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
& \sum_{\substack{1\leq j_{1}<\cdots<j_{M}\leq r\\1\leq k_{1}<\cdots<k_{N}\leq
r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle
\eta_{k_{1}}\cdots\eta_{j_{N}}\right\vert \left(  \sum_{\substack{1\leq
j_{1}<\cdots<j_{M}\leq r\\1\leq k_{1}<\cdots<k_{N}\leq r}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle \eta_{k_{1}%
}\cdots\eta_{j_{N}}\right\vert \right)  ^{\dagger}\\
& =\sum_{\substack{1\leq j_{1}<\cdots<,j_{M}\leq r\\1\leq k_{1}<\cdots
<k_{N}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle
\left\langle \eta_{k_{1}}\cdots\eta_{j_{N}}\right\vert \sum_{\substack{1\leq
l_{1}<\cdots<l_{M}\leq r\\1\leq m_{1}<\cdots<m_{N}\leq r}}\left\vert
\eta_{l_{1}}\cdots\eta_{l_{N}}\right\rangle \left\langle \varphi_{m_{1}}%
\cdots\varphi_{m_{M}}\right\vert \\
& =\sum_{\substack{1\leq j_{1}<\cdots<,j_{M}\leq r\\1\leq m_{1}<\cdots
<m_{M}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{M}}\right\vert 1
\end{align}

\end{remark}

\begin{remark}
One can generalize even further
\begin{align}
& \Gamma_{P,Q}^{M+P,N+Q}\left(  \left\vert \psi_{1}\cdots\psi_{P}\right\rangle
\left\langle \gamma_{1}\cdots\gamma_{Q}\right\vert \right)  =\left\vert
\psi_{1}\cdots\psi_{P}\right\rangle \left\langle \gamma_{1}\cdots\gamma
_{Q}\right\vert \bullet\left(  \sum_{\substack{1\leq j_{1}<\cdots<,j_{M}\leq
r\\1\leq k_{1}<\cdots<,k_{N}\leq r}}\left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{M}}\right\rangle \left\langle \eta_{k_{1}}\cdots\eta_{j_{kN}%
}\right\vert \right)  \\
& =\left(  M!\right)  ^{\frac{1}{2}}\left(  N!\right)  ^{\frac{1}{2}%
}\left\vert \psi_{1}\cdots\psi_{P}\right\rangle \left\langle \gamma_{1}%
\cdots\gamma_{Q}\right\vert \bullet\left(  \sum_{\substack{1\leq j_{1}%
<\cdots<,j_{M}\leq r\\1\leq k_{1}<\cdots<,k_{N}\leq r}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle \eta_{k_{1}%
}\cdots\eta_{j_{kN}}\right\vert \right)  \\
& =\left(  P!\right)  ^{\frac{1}{2}}\left(  Q!\right)  ^{\frac{1}{2}}\left(
N!\right)  \left\vert \psi_{1}\wedge\cdots\wedge\psi_{P}\right\rangle
\left\langle \gamma_{1}\wedge\cdots\wedge\gamma_{Q}\right\vert \bullet\left(
\sum_{1\leq j_{1}<\cdots<,j_{N}\leq r}\left\vert \varphi_{j_{1}}\wedge
\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \right)  \,\\
& =\left(  P!\right)  ^{\frac{1}{2}}\left(  Q!\right)  ^{\frac{1}{2}}\left(
N!\right)  \sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert \psi_{1}%
\wedge\cdots\wedge\psi_{P}\wedge\varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \gamma_{1}\wedge\cdots\wedge
\gamma_{Q}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert
\\
& =\left(  P!\right)  ^{\frac{1}{2}}\left(  Q!\right)  ^{\frac{1}{2}}\left(
N!\right)  \left(  \left(  N+P\right)  !\right)  ^{-\frac{1}{2}}\left(
\left(  N+Q\right)  !\right)  ^{-\frac{1}{2}}\sum_{1\leq j_{1}<\cdots
<j_{N}\leq r}\left\vert \psi_{1}\cdots\psi_{P}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \gamma_{1}\cdots\gamma_{Q}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}

\end{remark}

By considering the restrictions of $a_{j}^{\dagger}$ to $\mathcal{H}^{N}$,
i.e. $a_{j}^{\dagger}P_{\mathcal{H}^{N}},$ for a fixed $0\leq N\leq\infty$ one
obtains%
\begin{align}
a_{j}^{\dagger} &  =\left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert +\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}%
\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}\left(
N!\right)  ^{-1}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  }\left\vert \varphi_{j}\wedge\varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert
\end{align}
as%
\begin{align}
&  \left(  N!\right)  ^{-1}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert =\left(  N!\right)  ^{-1}\sqrt{\left(  N+1\right)  !}\left\vert
\varphi_{j}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\left(  \sqrt{N!}\right)  ^{-1}\sqrt{\left(  N+1\right)  }\left\vert
\varphi_{j}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}
\emph{Note that }$\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle $ is \emph{not necessarily} in normal ordered form and a minus
sign could be introduced when reordering $\left\vert \varphi_{j}\varphi
_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle $ to normal form. One can observe
that the restrictions $P_{\mathcal{H}^{M}}a_{l_{1}}^{\dagger}\cdots a_{l_{M}%
}^{\dagger}a_{m_{N}}\cdots a_{m_{1}}P_{\mathcal{H}^{N}}$ of the second
quantized operators $a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}%
}\cdots a_{m_{1}}$are the arguements of the \emph{Second Quantization} map
$\Gamma$
\begin{equation}
\Gamma:\mathcal{F}\rightarrow\mathcal{F}%
\end{equation}
from the Fock algebra to itself that results in $a_{l_{1}}^{\dagger}\cdots
a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}}.$

In the simplest case
\begin{align}
\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle \phi\right\vert
\right)   &  =a_{j}^{\dagger}=\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}%
<\cdots<j_{N}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  }\left\vert \varphi_{j}\wedge\varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert ,
\end{align}
where we have expanded $a_{j}^{\dagger}$ in terms of its restrictions, which
corresponds to a basis expansion.

The action on the vacuum state is given by
\begin{equation}
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert =I_{\mathcal{H}_{\mathcal{F}}}%
\end{equation}
i.e. $I_{\mathcal{H}_{\mathcal{F}}}$ is a basis vector in the transformed basis!

The next simplest case is
\begin{align}
\Gamma\left(  \left\vert \varphi_{k_{1}}\right\rangle \left\langle
\phi\right\vert \right)   &  =a_{k_{1}}^{\dagger}=\left\vert \varphi_{k_{1}%
}\right\rangle \left\langle \phi\right\vert +\sum_{1\leq N\leq\infty}%
\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert \varphi_{k_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{k_{1}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  \left(  N+2\right)  }\left\vert \varphi_{k_{1}%
}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert .
\end{align}
then%
\begin{align}
\Gamma\left(  \left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle
\left\langle \phi\right\vert \right)   &  =a_{k_{1}}^{\dagger}a_{k_{2}%
}^{\dagger}=\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle
\left\langle \phi\right\vert +\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}%
<\cdots<j_{N}\leq\infty}\left\vert \varphi_{k_{1}}\varphi_{k_{2}}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  \left(  N+2\right)  }\left\vert \varphi_{k_{1}%
}\wedge\varphi_{k_{2}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\vert
\end{align}
and in general
\begin{align}
a_{k_{1}}^{\dagger}\cdots a_{k_{P}}^{\dagger}  &  =\left\vert \varphi_{k_{1}%
}\cdots\varphi_{k_{P}}\right\rangle \left\langle \phi\right\vert +\sum_{1\leq
N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert \varphi
_{k_{1}}\cdots\varphi_{k_{P}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{P}}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\frac{\sqrt{\left(  N+P\right)  \cdots\left(  N+1\right)  }}{\sqrt{P!}%
}\left\vert \varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{p}}\wedge
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\binom{N+P}{P}}\left\vert \varphi_{k_{1}}\wedge\cdots\wedge
\varphi_{k_{P}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\vert .
\end{align}
$\lceil$thus
\begin{equation}
a_{j_{1}}^{\dagger}\cdots a_{j_{N}}^{\dagger}\left\vert \phi\right\rangle
=\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle ,
\end{equation}
which are normalized vectors as expected$\rfloor$

Annihilators can be expressed in an analogous fashion by
\begin{align}
a_{j}  &  =\left\vert \phi\right\rangle \left\langle \varphi_{j}\right\vert
+\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi
_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  }\left\vert \varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j}\wedge\varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert .
\end{align}
Hence
\begin{align}
a_{k_{2}}a_{k_{1}}  &  =\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert +\sum_{1\leq N\leq\infty}\sum_{1\leq
j_{1}<\cdots<j_{N}\leq\infty}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  \left(  N+2\right)  }\left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{1}%
}\wedge\varphi_{k_{2}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\vert
\end{align}
and
\begin{align}
a_{k_{Q}}\cdots a_{k_{1}}  &  =\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert +\sum_{1\leq N\leq\infty}%
\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{Q}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\frac{\sqrt{\left(  N+Q\right)  \left(  N+1\right)  }}{\sqrt{Q!}}\left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{Q}}\wedge\varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\binom{N+Q}{Q}}\left\vert \varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{1}}\wedge\cdots
\wedge\varphi_{k_{Q}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\vert .
\end{align}
One particle operators can be expressed as
\begin{align}
&  a_{l_{1}}^{\dagger}a_{m_{1}}=\Gamma\left(  \left\vert \varphi_{l_{1}%
}\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right) \nonumber\\
&  =\sum_{\substack{0\leq N,M\leq\infty\\1\leq j_{1}<\cdots<j_{N}\leq
\infty\\1\leq k_{1}<\cdots<k_{M}\leq\infty}}\left\vert \varphi_{l_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \left.
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \varphi_{k_{1}}\cdots
\varphi_{k_{M}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{k_{1}}%
\cdots\varphi_{k_{M}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}\left(
N+1\right)  \left\vert \varphi_{l_{1}}\wedge\varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{N}}\right\rangle \left\langle \varphi_{m_{1}}\wedge
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert =\sum_{0\leq
N\leq\infty}\left(  N+1\right)  \left\vert \varphi_{l_{1}}\right\rangle
\left\langle \varphi_{m_{1}}\right\vert \mathcal{\boxtimes}P_{\mathcal{H}^{N}%
}\nonumber\\
&  =\left\vert \varphi_{l_{1}}\right\rangle \left\langle \varphi_{m_{1}%
}\right\vert +2\left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{m_{1}}\right\vert \mathcal{\boxtimes}P_{\mathcal{H}^{1}}+3\left\vert
\varphi_{l_{1}}\right\rangle \left\langle \varphi_{m_{1}}\right\vert
\mathcal{\boxtimes}P_{\mathcal{H}^{2}}+\cdots=\Gamma_{1}^{1}\left(  \left\vert
\varphi_{l_{1}}\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right)
+2\Gamma_{1}^{2}\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{m_{1}}\right\vert \right)  +\cdots\nonumber\\
&  =\sum_{1\leq N\leq\infty}N\Gamma_{1}^{N}\left(  \left\vert \varphi_{l_{1}%
}\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right)  =\sum_{1\leq
N\leq\infty}\binom{N}{1}\Gamma_{1}^{N}\left(  \left\vert \varphi_{l_{1}%
}\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right)  =\Gamma
^{1}\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{m_{1}}\right\vert \right)  .
\end{align}


\begin{lemma}
One-particle operators can be expressed as%
\begin{equation}
a_{l_{1}}^{\dagger}a_{m_{1}}=\Gamma\left(  \left\vert \varphi_{l_{1}%
}\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right)  =\sum_{1\leq
N\leq\infty}\binom{N}{1}\Gamma_{1}^{N}\left(  \left\vert \varphi_{l_{1}%
}\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right)  =\Gamma
^{1}\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{m_{1}}\right\vert \right)
\end{equation}

\end{lemma}

\begin{lemma}
Two-particle operators can be expressed as%
\begin{align}
&  a_{l_{1}}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}=\Gamma\left(
\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right) \nonumber\\
&  =\sum_{\substack{0\leq N,M\leq\infty\\1\leq j_{1}<\cdots<j_{N}\leq
\infty\\1\leq k_{1}<\cdots<k_{M}\leq\infty}}\left\vert \varphi_{l_{1}}%
\varphi_{l_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\left.  \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{M}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}%
}\varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}\left(
N+1\right)  \left(  N+2\right)  \left\vert \varphi_{l_{1}}\wedge\varphi
_{l_{2}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{m_{1}}\wedge\varphi_{m_{2}}\wedge\varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\left(  N+1\right)  \left(  N+2\right)  \left\vert
\varphi_{l_{1}}\right\rangle \left\langle \varphi_{m_{1}}\right\vert
\mathcal{\boxtimes}\left\vert \varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{2}}\right\vert \mathcal{\boxtimes}P_{\mathcal{H}^{N}}=\sum_{0\leq
N\leq\infty}\frac{\left(  N+1\right)  \left(  N+2\right)  }{2}\left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \mathcal{\boxtimes}P_{\mathcal{H}^{N}}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\frac{\left(  N+1\right)  \left(  N+2\right)  }%
{2}\Gamma_{2}^{N}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
=\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert +3\Gamma_{2}^{3}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  +6\Gamma_{2}^{4}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  +\cdots\nonumber\\
&  =\binom{2}{2}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert +\binom{3}{2}\Gamma
_{2}^{3}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  +\binom{4}%
{2}\Gamma_{2}^{4}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
+\cdots\nonumber\\
&  =\sum_{2\leq N\leq\infty}\binom{N}{2}\Gamma_{2}^{N}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  =\Gamma^{2}\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)
\end{align}

\end{lemma}

\begin{lemma}%
\begin{equation}
a_{l_{1}}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}=\Gamma\left(
\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  =\sum_{2\leq N\leq\infty
}\binom{N}{2}\Gamma_{2}^{N}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
=\Gamma^{2}\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  .
\end{equation}

\end{lemma}

\begin{theorem}
Second Qunatization of Ket-Bra's are creation and annihilation operators. In
general
\begin{align}
&  a_{l_{1}}^{\dagger}\cdots a_{l_{P}}^{\dagger}a_{m_{Q}}\cdots a_{m_{1}%
}=\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert \right)
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}%
}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  \cdots\left(  N+P\right)  }\sqrt{\left(  N+1\right)
\cdots\left(  N+Q\right)  }\left\vert \varphi_{l_{1}}\wedge\cdots\wedge
\varphi_{l_{P}}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{m_{1}}\wedge\cdots\wedge\varphi_{m_{Q}%
}\wedge\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sqrt{\frac{\left(  N+1\right)  \cdots\left(
N+P\right)  }{P!}}\sqrt{\frac{\left(  N+1\right)  \cdots\left(  N+Q\right)
}{Q!}}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert \cdot
P_{\mathcal{H}^{N}}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sqrt{\frac{\left(  N+1\right)  \cdots\left(
N+P\right)  }{P!}}\sqrt{\frac{\left(  N+1\right)  \cdots\left(  N+Q\right)
}{Q!}}\Gamma_{PQ}^{N+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}%
}\right\vert \right) \nonumber\\
&  =\sum_{\min(P,Q)\leq N\leq\infty}\sqrt{\binom{N+P}{P}\binom{N+Q}{Q}}%
\Gamma_{PQ}^{N+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  =\Gamma^{PQ}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  .
\end{align}

\end{theorem}

\begin{corollary}%
\begin{equation}
a_{l_{1}}^{\dagger}\cdots a_{l_{P}}^{\dagger}a_{m_{P}}\cdots a_{m_{1}}%
=\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert \right)
=\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\varphi
_{j_{1}}\cdots\varphi_{j_{N}}\right\vert .
\end{equation}

\end{corollary}

\begin{example}
$r=7$%
\begin{align}
&  a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{4}^{\dagger}a_{5}%
a_{6}=\Gamma\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{5}\varphi_{6}\right\vert \right)
=\Gamma^{4,2}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{5}\varphi_{6}\right\vert \right) \\
&  =\sum_{2\leq N\leq7}\sqrt{\binom{N+4}{4}\binom{N+2}{2}}\Gamma
_{4,2}^{N+4N+2}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{5}\varphi_{6}\right\vert \right) \\
&  =\sqrt{\binom{0+4}{4}\binom{0+2}{2}}\Gamma_{4,2}^{0+40+2}\left(  \left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{5}\varphi_{6}\right\vert \right)  +\sqrt{\binom{1+4}{4}\binom{1+2}%
{2}}\Gamma_{4,2}^{1+41+2}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\varphi_{4}\right\rangle \left\langle \varphi_{5}\varphi_{6}\right\vert
\right) \\
&  +\sqrt{\binom{2+4}{4}\binom{2+2}{2}}\Gamma_{4,2}^{2+42+2}\left(  \left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{5}\varphi_{6}\right\vert \right)  +\sqrt{\binom{3+4}{4}\binom{3+2}%
{2}}\Gamma_{4,2}^{3+43+2}\left(  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\varphi_{4}\right\rangle \left\langle \varphi_{5}\varphi_{6}\right\vert
\right) \\
&  =\sqrt{\binom{6}{4}\binom{4}{2}}\left\vert \varphi_{1}\varphi_{2}%
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{5}\varphi
_{6}\right\vert \cdot P_{0}+\sqrt{\binom{7}{4}\binom{5}{2}}\left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{5}\varphi_{6}\right\vert \cdot P_{1}\\
&  +\sqrt{\binom{6}{4}\binom{6}{2}}\left\vert \varphi_{1}\varphi_{2}%
\varphi_{3}\varphi_{4}\right\rangle \left\langle \varphi_{5}\varphi
_{6}\right\vert \cdot P_{2}+\sqrt{\binom{7}{4}\binom{5}{2}}\left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{5}\varphi_{6}\right\vert \cdot P_{3}.
\end{align}

\end{example}

\begin{theorem}%
\begin{align}
a_{l_{1}}^{\dagger}\cdots a_{l_{P}}^{\dagger}a_{m_{Q}}\cdots a_{m_{1}}  &
=\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert \right) \\
&  =\sum_{\min(P,Q)\leq N\leq\infty}\sqrt{\binom{N+P}{P}\binom{N+Q}{Q}}%
\Gamma_{P,Q}^{N+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  =\Gamma^{P,Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  ,
\end{align}
i.e.%
\begin{equation}
\Gamma^{P,Q}=\sum_{\min(P,Q)\leq N\leq\infty}\sqrt{\binom{N+P}{P}\binom
{N+Q}{Q}}\Gamma_{P,Q}^{N+P,N+Q}.
\end{equation}

\end{theorem}

\begin{theorem}
The \emph{Second Quantization map }%
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
given by
\begin{equation}
\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert \right)
=a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}%
};\,0\leq M,N\leq r,0\leq l_{1}<\cdots<l_{P}\leq r,0\leq m_{1}<\cdots
<m_{P}\leq r
\end{equation}
is the \underline{\emph{Generalized Expansion map}} $\mathfrak{G}$.
\end{theorem}

\begin{proof}%
\begin{align}
&  \Gamma\left(  \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\left\vert \mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots Q}\right\vert \\
0\\
\vdots\\
0
\end{array}
\right)  \right)  =\\
&  \left(
\begin{array}
[c]{ccccccc}%
\sqrt{\binom{0}{0}\binom{0}{0}}\Gamma_{0,0}^{0,0} & 0 & \cdots & 0 & 0 & 0 &
0\\
\sqrt{\binom{1}{0}\binom{1}{0}}\Gamma_{0,0}^{1,1} & \sqrt{\binom{1}{0}%
\binom{0}{0}}\Gamma_{10}^{1,0} & 0 & \vdots & \vdots & 0 & \vdots\\
\vdots & \cdots & \ddots & 0 & \vdots & \vdots & \vdots\\
\sqrt{\binom{N}{0}\binom{N}{0}}\Gamma_{0,0}^{N,N} & \vdots & \vdots &
\sqrt{\binom{N+R}{R}\binom{N+S}{S}}\Gamma_{R,S}^{N+R,N+S} & 0 & \vdots &
\vdots\\
\vdots & \cdots & \vdots & \vdots & \ddots & 0 & \vdots\\
\vdots & \vdots & \vdots & \vdots & \vdots & \ddots & 0\\
\sqrt{\binom{r}{0}\binom{r}{0}}\Gamma_{0,0}^{r,r} & \cdots & \cdots &
\sqrt{\binom{r}{R}\binom{r}{S}}\Gamma_{R,S}^{N+r,N+r} & \cdots & \cdots &
\sqrt{\binom{r}{r}\binom{r}{r}}\Gamma_{r,r}^{r,r}%
\end{array}
\right)  \times\\
\times &  \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\left\vert \mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots Q}\right\vert \\
0\\
\vdots\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\left\vert \mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots Q}\right\vert \\
\sqrt{\binom{1+P}{P}\binom{1+Q}{Q}}\Gamma_{P,Q}^{1+P,1+Q}\left(  \left\vert
\mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle \mathbf{\varphi
}_{1\cdots Q}\right\vert \right) \\
\vdots\\
\sqrt{\binom{r+P}{P}\binom{r+Q}{Q}}\Gamma_{P,Q}^{r+P,r+Q}\left(  \left\vert
\mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle \mathbf{\varphi
}_{1\cdots Q}\right\vert \right)
\end{array}
\right)  \leftrightarrow\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\mathbf{a}_{1\cdots P}^{\dagger}\mathbf{a}_{1\cdots Q}\\
0\\
\vdots\\
0
\end{array}
\right)
\end{align}
which is the generalized expansion map. mmmm%

\begin{equation}
\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert \right)
=I_{\mathcal{F}}a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots
a_{m_{1}}I_{\mathcal{F}};\,0\leq M,N\leq r,0\leq l_{1}<\cdots<l_{P}\leq
r,0\leq m_{1}<\cdots<m_{P}\leq r
\end{equation}%
\begin{align}
&  \Gamma\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{4}}\right\vert \right)
=\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots j_{N}\leq r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert a_{l_{1}}^{\dagger}a_{l_{2}}^{\dagger
}a_{m_{4}}\cdots a_{m_{1}}\sum_{0\leq M\leq r}\sum_{1\leq k_{1}<\cdots
k_{M}\leq r}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert \\
&  \Gamma\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{4}}\right\vert \right)
=\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots j_{N}\leq r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle a_{l_{2}%
}^{\dagger}a_{l_{1}}^{\dagger}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\sum_{0\leq M\leq r}\sum_{1\leq k_{1}<\cdots k_{M}\leq r}a_{m_{4}}\cdots
a_{m_{1}}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert \\
&  =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots j_{N}\leq r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle a_{l_{2}%
}^{\dagger}a_{l_{1}}^{\dagger}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\sum_{4\leq M\leq r}\sum_{1\leq k_{4}+1<\cdots k_{M}\leq r}\left\vert
\varphi_{m_{1}}\cdots\varphi_{m_{4}}\varphi_{k_{4}+1}\cdots\varphi_{k_{M}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{4}}\varphi
_{k_{4}+1}\cdots\varphi_{k_{M}}\right\vert
\end{align}%
\begin{equation}
I_{\mathcal{F}}=\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots j_{N}\leq
r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\end{equation}%
\begin{align}
I_{\mathcal{F}}a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots
a_{m_{1}}I_{\mathcal{F}}  &  =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots
j_{N}\leq r}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert a_{l_{1}%
}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}}\sum_{0\leq
M\leq r}\sum_{1\leq k_{1}<\cdots k_{M}\leq r}\left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{M}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{M}}\right\vert \\
&  =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots j_{N}\leq r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle a_{l_{M}%
}^{\dagger}\cdots a_{l_{1}}^{\dagger}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert \sum_{0\leq M\leq r}\sum_{1\leq j_{1}<\cdots j_{M}\leq r}%
a_{m_{N}}\cdots a_{m_{1}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{M}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\vert \\
&  =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots j_{N}\leq r}\left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{m}}\right\rangle \left\langle a_{l_{M}%
}^{\dagger}\cdots a_{l_{1}}^{\dagger}\varphi_{l_{1}}\cdots\varphi_{l_{N}%
}\right\vert \sum_{0\leq M\leq r}\sum_{1\leq j_{1}<\cdots j_{M}\leq r}%
a_{m_{N}}\cdots a_{m_{1}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{M}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\vert
\end{align}

\end{proof}

\begin{corollary}
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \equiv\mathcal{F}$ can
be expanded as the Banach space direct sum
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \equiv\mathcal{F}=%
%TCIMACRO{\tbigoplus \limits_{0\leq M,N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq M,N\leq r}}
%EndExpansion
\mathcal{A}_{MN},
\end{equation}
where
\begin{equation}
\mathcal{A}_{MN}=\operatorname*{linspan}\left\{  \left.  a_{l_{1}}^{\dagger
}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}}\right\vert 0\leq
l_{1}<\cdots<l_{M}\leq r,0\leq m_{1}<\cdots<m_{M}\leq r\right\}
\end{equation}
and
\begin{equation}
a_{0}^{\dagger}=a_{0}=I_{\mathcal{F}}.
\end{equation}
Hence $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ \emph{can thus
be considered as a Banach space of operator sequences} $\left\{  \left.
\left(  Y_{0,0},\cdots,Y_{M,N},\cdots,Y_{r,r}\right)  \right\vert Y_{M,N}%
\in\mathcal{A}_{MN},0\leq M,N\leq r\right\}  .$
\end{corollary}

\begin{remark}
As the direct sum is the sum of disjoint subspaces one can express any
operator $Y\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ as linear
space sums
\begin{equation}
Y=\sum_{0\leq N,M\leq0}Y_{M,N}.
\end{equation}

\end{remark}

\begin{remark}
The \emph{second quantized} $\left\{  I_{\mathcal{F}},\mathbf{a}^{\dagger
}\mathbf{a}\right\}  $\textbf{ }basis is adapted to the preceding direct sum decomposition.
\end{remark}

\begin{remark}
Operators $X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ have the
vector expansions
\begin{equation}
X=\left(  I_{\mathcal{F}},\mathbf{a}^{\dagger}\mathbf{a}\right)
\mathcal{R}_{a}\left(  X\right)  =\left(  \left\vert \mathbf{\varphi
}\right\rangle \left\langle \mathbf{\varphi}\right\vert \right)
\mathcal{R}_{\varphi}\left(  X\right)  ,
\end{equation}
where $\mathcal{R}_{a}\left(  X\right)  $ is the representation of $X$ wrt the
basis $\left\{  \left(  I_{\mathcal{F}},\mathbf{a}^{\dagger}\mathbf{a}\right)
\right\}  $ and $\mathcal{R}_{\varphi}\left(  X\right)  $ is the
representation of $X$ wrt the basis $\left\{  \left\vert \mathbf{\varphi
}\right\rangle \left\langle \mathbf{\varphi}\right\vert \right\}  .$
\end{remark}

\begin{example}%
\begin{equation}
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =\sum_{0\leq N\leq\infty}\sqrt{\binom{N}{0}\binom{N}{0}}\Gamma
_{0,0}^{N,N}\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =\Gamma^{0,0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  \equiv\sum_{0\leq N\leq\infty}\binom{N}{0}\Gamma
_{0}^{N,}\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =\Gamma^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)
\end{equation}
and
\begin{equation}
\Gamma^{0}=\sum_{0\leq N\leq\infty}\binom{N}{0}\Gamma_{0}^{N,}%
\end{equation}
leading to
\begin{equation}
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  =I_{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{example}

\begin{example}
The second quantized map restricted to the particle conserving sub algebra
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ is given by the
components
\begin{equation}
\Gamma^{P}\left(  X\right)  =\sum_{P\leq N\leq r}\binom{N}{P}\Gamma_{P}%
^{N}\left(  X\right)  =\sum_{P\leq N\leq\infty}\binom{N}{P}\Gamma_{P}%
^{N}\left(  X_{P}\right)  ,\,0\leq P\leq r.
\end{equation}

\end{example}

\begin{lemma}%
\begin{equation}
\Gamma\left(  X_{N}\right)  =\Gamma^{N}\left(  X\right)  ;0\leq N\leq r.
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{equation}
\Gamma\left(  X\right)  =\Gamma\left(  \left(  X_{0},X_{1},\cdots,X_{N}%
,\cdots,X_{r}\right)  \right)  =\left(  \Gamma\left(  X_{0}\right)
,\Gamma\left(  X_{1}\right)  ,\cdots,\Gamma\left(  X_{N}\right)
,\cdots,\Gamma\left(  X_{r}\right)  \right)  =\left(  \Gamma^{0}\left(
X\right)  ,\Gamma^{1}\left(  X\right)  ,\cdots,\Gamma^{N}\left(  X\right)
,\cdots,\Gamma^{r}\left(  X\right)  \right)  ,
\end{equation}
where
\begin{equation}
\Gamma^{N}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
and%
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}.
\end{equation}

\end{corollary}

\begin{example}
$\Gamma$ maps sequences of operators to sequences of operators.
\end{example}

\begin{enumerate}
\item
\begin{align}
&  \Gamma\left(  \left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert ,0\cdots,0,\cdots,0\right)  \right) \\
&  =\left(  \sqrt{\binom{0+0}{0}\binom{0+0}{0}}\Gamma_{0,0}^{0+0,0+0}\left(
\left\vert \phi\right\rangle \left\langle \phi\right\vert \right)
,\cdots,\sqrt{\binom{N+0}{0}\binom{N+0}{0}}\Gamma_{0,0}^{N+0,N+0}\left(
\left\vert \phi\right\rangle \left\langle \phi\right\vert \right)
,\cdots,\sqrt{\binom{r}{0}\binom{r}{0}}\Gamma_{0,0}^{r,r}\left(  \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right)  \right) \\
&  =\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\cdots,\Gamma_{0}^{N}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  ,\cdots,\Gamma_{0}^{r}\left(  \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right)  \right)  =\sum_{0\leq
N\leq r}\Gamma_{0}^{N}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  =\left(  I_{\mathcal{H}_{\mathcal{F}}},0,\cdots
,0,\cdots,0\right)  \leftrightarrow I_{\mathcal{H}_{\mathcal{F}}}%
\end{align}


\item
\begin{equation}
\mathbf{a}_{P}^{\dagger}\mathbf{a}_{Q}=\Gamma^{P,Q}\left(  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right)  =\sum_{0\leq,J,K\leq r}\left\vert \mathbf{\varphi}_{J}\right\rangle
\left\langle \mathbf{\varphi}_{K}\right\vert \mathcal{R}_{\varphi}\left(
\mathbb{\Gamma}\right)  _{\left(  JK\right)  ,\left(  PQ\right)  }%
\end{equation}
giving%
\begin{align}
a_{l_{1}}^{\dagger}\cdots a_{l_{P}}^{\dagger}a_{m_{Q}}\cdots a_{m_{1}}  &
=\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert \right)
=\Gamma^{P,Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right) \\
&  =\sum_{\min(P,Q)\leq N\leq\infty}\sqrt{\binom{N+P}{P}\binom{N+Q}{Q}}%
\Gamma_{P,Q}^{N+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  ,
\end{align}
i.e.%
\begin{equation}
\Gamma^{P,Q}=\sum_{\min(P,Q)\leq N\leq\infty}\sqrt{\binom{N+P}{P}\binom
{N+Q}{Q}}\Gamma_{P,Q}^{N+P,N+Q}.
\end{equation}

\end{enumerate}

\begin{remark}
One can observe that any operator $X\in\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ can be expanded wrt to a Ket-Bra basis as
\begin{align}
X  &  =\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\cdots,\left\vert \mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots Q}\right\vert ,\cdots,\left\vert \mathbf{\varphi
}_{1\cdots r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots
r}\right\vert \right)  \left(
\begin{array}
[c]{c}%
\mathbf{X}_{00}\\
\vdots\\
\mathbf{X}_{PQ}\\
\vdots\\
\mathbf{X}_{rr}%
\end{array}
\right) \\
&  =\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\cdots,\left\vert \mathbf{\varphi}_{1\cdots P}\right\rangle \left\langle
\mathbf{\varphi}_{1\cdots Q}\right\vert ,\cdots,\left\vert \mathbf{\varphi
}_{1\cdots r}\right\rangle \left\langle \mathbf{\varphi}_{1\cdots
r}\right\vert \right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{00}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{PQ}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{rr}\right)
\end{array}
\right)  .
\end{align}

\end{remark}

\begin{example}%
\begin{align}
&  a_{l_{1}}^{\dagger}\cdots a_{l_{4}}^{\dagger}a_{m_{2}}a_{m_{1}}%
=\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  =\sum_{0\leq
N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert \varphi
_{l_{1}}\cdots\varphi_{l_{4}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\varphi_{j_{1}}\cdots\varphi
_{j_{N}}\right\vert \nonumber\\
&  =\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert +\sum_{1\leq j_{1}<\cdots<j_{N}%
\leq\infty}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\varphi_{j_{1}%
}\right\vert \nonumber\\
&  +\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{4}}\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\cdots\varphi_{m_{4}}\varphi_{j_{1}}\varphi_{j_{2}}\right\vert
+\ldots\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1},\cdots,j_{N}\leq\infty}%
\sqrt{\left(  N+1\right)  \cdots\left(  N+4\right)  }\sqrt{\left(  N+1\right)
\left(  N+2\right)  }\times\nonumber\\
&  \left\vert \varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{4}}\wedge
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{m_{1}}\wedge\varphi_{m_{2}}\wedge\varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{N}}\right\vert \\
&  =\sum_{0\leq N\leq\infty}\sqrt{\left(  N+1\right)  \cdots\left(
N+4\right)  }\sqrt{\left(  N+1\right)  \left(  N+2\right)  }\left\vert
\varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\wedge\varphi_{m_{2}}\right\vert \cdot P_{\mathcal{H}^{N}%
}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sqrt{\frac{\left(  N+1\right)  \cdots\left(
N+4\right)  }{4!}}\sqrt{\frac{\left(  N+1\right)  \left(  N+2\right)  }{2!}%
}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \cdot P_{\mathcal{H}^{N}}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sqrt{\frac{\left(  N+1\right)  \cdots\left(
N+4\right)  }{4!}}\sqrt{\frac{\left(  N+1\right)  \left(  N+2\right)  }{2!}%
}\Gamma_{4,2}^{N+4,N+2}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\Gamma^{4+N,3+N}\left(  \left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  \right) \\
&  =\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert +\sqrt{\frac{\left(  5\right)
\cdots\left(  2\right)  }{4!}}\sqrt{\frac{\left(  3\right)  \left(  2\right)
}{2!}}\Gamma_{4,2}^{5,3}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi
_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert
\right) \nonumber\\
&  +\sqrt{\frac{\left(  6\right)  \cdots\left(  3\right)  }{4!}}\sqrt
{\frac{\left(  4\right)  \left(  3\right)  }{2!}}\Gamma_{4,2}^{6,4}\left(
\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  +\cdots\nonumber\\
&  =\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert +\sqrt{\binom{5}{4}}\sqrt{\binom
{3}{2}}\Gamma_{4,2}^{5,3}\left(  \left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}%
}\right\vert \right) \\
&  +\sqrt{\binom{6}{4}}\sqrt{\binom{4}{2}}\Gamma_{4,2}^{6,4}\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  +\cdots
\end{align}%
\begin{align}
&  =\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert +\Gamma^{5,3}\left(  \left(
\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  \right) \\
&  +\Gamma^{6,4}\left(  \left(  \left\vert \varphi_{l_{1}}\cdots\varphi
_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert
\right)  \right)  +\cdots+\Gamma^{4+P,2+Q}\left(  \left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}%
}\varphi_{m_{2}}\right\vert \right)  \right)  +\cdots+\Gamma^{4+r,2+r}\left(
\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  \right)
\end{align}
i.e.%
\begin{align}
a_{l_{1}}^{\dagger}\cdots a_{l_{4}}^{\dagger}a_{m_{2}}a_{m_{1}}  &
=\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right) \\
&  =\sum_{\min(P,Q)\leq N\leq\infty}\sqrt{\binom{N+4}{4}\binom{N+2}{2}}%
\Gamma_{4,2}^{N+4,N+2}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{2}}\right\vert
\right)  =\Gamma^{4,2}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{4}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{2}}\right\vert
\right)  .
\end{align}

\end{example}

\begin{remark}
The components other than $\Gamma_{4,2}\left(  \left\vert \varphi_{l_{1}%
}\cdots\varphi_{l_{4}}\right\rangle \left\langle \varphi_{m_{1}}\varphi
_{m_{2}}\right\vert \right)  $ are zero.
\end{remark}

\subsubsection{Components of the Generalized Expansion Map $\equiv$ Second
Quantization Map.}

In general
\begin{equation}
\Gamma\left(  X\right)  =\Gamma\left(  \sum_{0\leq P,Q\leq\infty}%
X_{PQ}\right)  =\sum_{0\leq P,Q\leq\infty}\Gamma\left(  X_{PQ}\right)
=\sum_{0\leq M,N\leq\infty}\Gamma^{M,N}\left(  X\right)  =\sum_{0\leq
M,N\leq\infty}\sum_{0\leq P\leq M,0\leq Q\leq N}\sqrt{\binom{M}{P}\binom{N}%
{Q}}\Gamma_{P,Q}^{M,N}\left(  X_{PQ}\right)  .\nonumber
\end{equation}


\begin{lemma}
The components $\Gamma^{M,N}$ of $\Gamma$ are given by
\begin{equation}
\Gamma^{M,N}\left(  X\right)  =\sum_{\min(P,Q)\leq N\leq\infty}\sqrt
{\binom{N+P}{P}\binom{N+Q}{Q}}\Gamma_{P,Q}^{N+P,N+Q}\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{Q}}\right\vert \right)  .
\end{equation}

\end{lemma}

\begin{example}
$P=4;Q=2$%
\begin{equation}
\Gamma^{M,N}\left(  X\right)  =\sum_{4\leq M,2\leq N\leq r}\sqrt{\binom{M}%
{4}\binom{N}{2}}\Gamma_{4,2}^{M,N}\left(  X_{42}\right)
\end{equation}

\end{example}

\begin{definition}
In particular for particle conserving mappings i.e for the restriction
$\left.  \Gamma\right\vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}}$ of $\Gamma$
\begin{equation}
\left.  \Gamma\right\vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
giving%
\begin{equation}
\Gamma^{N}\left(  X_{e}\right)  =\Gamma^{N,N}\left(  X_{e}\right)
=\sum_{0\leq P\leq N}\binom{N}{P}\Gamma_{P,P}^{N,N}\left(  X_{PP}\right)
\equiv\sum_{0\leq P\leq N}\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right)
\end{equation}
and
\begin{equation}
\Gamma\left(  X_{e}\right)  =\Gamma\left(
\begin{array}
[c]{ccccc}%
X_{e0} & \cdots & X_{eN} & \cdots & X_{er}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccccc}%
\Gamma^{0}\left(  X_{e}\right)  & \cdots & \Gamma^{N}\left(  X_{e}\right)  &
\cdots & \Gamma^{r}\left(  X_{e}\right)
\end{array}
\right)  .
\end{equation}

\end{definition}

In matrix notation
\begin{align}
\Gamma\left(  X_{e}\right)   &  =\Gamma\left(  \left(
\begin{array}
[c]{ccccc}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert  & \cdots &
\left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}%
_{N}\right\vert  & \cdots & \left\vert \mathbf{\varphi}_{r}\right\rangle
\left\langle \mathbf{\varphi}_{r}\right\vert
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right)  \right) \\
&  =\left(
\begin{array}
[c]{ccccc}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert  & \cdots &
\left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}%
_{N}\right\vert  & \cdots & \left\vert \mathbf{\varphi}_{r}\right\rangle
\left\langle \mathbf{\varphi}_{r}\right\vert
\end{array}
\right)  \mathcal{R}_{\varphi}\left(  \Gamma\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccccc}%
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right)  & \cdots & \Gamma\left(  \left\vert \mathbf{\varphi}_{N}\right\rangle
\left\langle \mathbf{\varphi}_{N}\right\vert \right)  & \cdots & \Gamma\left(
\left\vert \mathbf{\varphi}_{r}\right\rangle \left\langle \mathbf{\varphi}%
_{r}\right\vert \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{a}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{er}\right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccccc}%
I_{\mathcal{F}} & \cdots & \mathbf{a}_{N}^{\dagger}\mathbf{a}_{N} & \cdots &
\mathbf{a}_{r}^{\dagger}\mathbf{a}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{a}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{er}\right)
\end{array}
\right)  .
\end{align}
Hence
\begin{equation}
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{a}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{er}\right)
\end{array}
\right)  =\mathcal{R}_{\varphi}\left(  \Gamma\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right)  =\mathcal{M}_{\varphi}\left(  \Gamma\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right)
\end{equation}
and%
\begin{equation}
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{a}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{a}\left(  X_{er}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & 0 & \cdots & \cdots & 0\\
\vdots & \ddots & 0 & \cdots & \vdots\\
\binom{n}{0}\Gamma_{0}^{n}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \cdots & \binom{n}{n}\Gamma_{n}^{n}\left(
\left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}%
_{N}\right\vert \right)  & \cdots & \vdots\\
\vdots & \cdots & \vdots & \ddots & 0\\
\binom{r}{0}\Gamma_{0}^{r}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \cdots & \binom{r}{n}\Gamma_{n}^{r}\left(
\left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}%
_{N}\right\vert \right)  & \cdots & \binom{r}{r}\Gamma_{r}^{r}\left(
\left\vert \mathbf{\varphi}_{r}\right\rangle \left\langle \mathbf{\varphi}%
_{r}\right\vert \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right)  .
\end{equation}


One should note the general relationship
\begin{align}
\Gamma_{M,N}\left(  X_{PQ}\right)   &  =\Gamma_{M,N}\left(  X_{PQ}\right)
\delta_{M\left(  N+P-Q\right)  }=\Gamma_{N+P,N+Q}\left(  X_{PQ}\right)
\delta_{M\left(  N+P-Q\right)  }=\sqrt{\binom{N+P}{P}\binom{N+Q}{Q}}%
\Gamma_{P,Q}^{N+PN+Q}\left(  X_{PQ}\right) \nonumber\\
&  =\sum_{\substack{1\leq l_{1}<\cdots<l_{p}\leq\infty\\1\leq m_{1}%
<\cdots<m_{Q}\leq\infty}}\sqrt{\binom{N+P}{P}\binom{N+Q}{Q}}\Gamma
_{P,Q}^{N+PN+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  X_{l_{1}\cdots l_{P}m_{1}\cdots m_{Q}}.
\end{align}
In Lowdin notation the basis transformation is%
\begin{align}
\Gamma\left\vert \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)   &  =\left\vert \left\vert \mathbf{\Phi
}\right\rangle \left\langle \mathbf{\Phi}\right\vert \right)  \mathcal{R}%
_{\varphi}\left(  \Gamma\right)  =\left\vert \mathbf{a}^{\dagger}%
\mathbf{a}\right)  =\left\vert \Gamma\left(  \left\vert \phi\right\rangle
\left\langle \phi\right\vert \right)  ,\Gamma\left(  \left\vert
\mathbf{\varphi}_{1}\right\rangle \left\langle \phi\right\vert \right)
,\Gamma\left(  \left\vert \phi\right\rangle \left\langle \mathbf{\varphi}%
_{1}\right\vert \right)  ,\cdots,\Gamma\left(  \left\vert \mathbf{\varphi}%
_{P}\right\rangle \left\langle \mathbf{\varphi}_{Q}\right\vert \right)
,\cdots\right) \nonumber\\
&  =\left\vert \Gamma^{0,0}\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  ,\cdots,\Gamma^{P,Q}\left(
\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
\right)  ,\cdots\right)  ,
\end{align}
where%
\begin{equation}
\mathbf{a}_{P}^{\dagger}\mathbf{a}_{Q}=%
%TCIMACRO{\tsum \limits_{0\leq M,N\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{0\leq M,N\leq r}}
%EndExpansion
\left\vert \varphi_{M}\right\rangle \left\langle \varphi_{N}\right\vert
\Gamma_{\varphi M,N,P,Q}=%
%TCIMACRO{\tsum \limits_{0\leq M,N\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{0\leq M,N\leq r}}
%EndExpansion
\left\vert \varphi_{M}\right\rangle \left\langle \varphi_{N}\right\vert
\mathcal{R}_{\varphi MNPQ}\left(  \Gamma\right)  =\Gamma^{P,Q}\left(
\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
\right)  .
\end{equation}
Acting on the basis elements one obtains
\begin{align}
\mathbf{a}_{P}^{\dagger}\mathbf{a}_{Q}  &  =\Gamma\left(  \left\vert
\mathbf{\varphi}_{P}\right\rangle \left\langle \mathbf{\varphi}_{Q}\right\vert
\right)  =\Gamma^{P,Q}\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right) \nonumber\\
&  =\sum_{0\leq M,N\leq\infty}\sum_{\substack{1\leq j_{1}<\cdots<j_{N}%
\leq\infty\\1\leq k_{1}<\cdots<k_{N}\leq\infty}}\left\vert \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{N}}\right\vert \right)  \Gamma_{j_{1}\cdots j_{M}%
k_{1}\cdots k_{N}l_{1}\cdots l_{P}m_{1}\cdots m_{Q}}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\Gamma_{M+PN+Q}\left(  \left\vert \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{Q}}\right\vert \right)  \right) \nonumber\\
&  =\sum_{0\leq M,N\leq\infty}\sqrt{\binom{M+P}{P}\binom{N+Q}{Q}}\Gamma
_{P,Q}^{N+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right) \nonumber\\
&  =\sum_{0\leq M,N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\varphi_{j_{1}}\cdots
\varphi_{j_{M}}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}%
}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert ,
\end{align}
i.e.
\begin{equation}
\Gamma^{N+P,N+Q}\left(  \left\vert \left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}%
}\right\vert \right)  \right)  =\sqrt{\binom{N+P}{P}\binom{N+Q}{Q}}%
\Gamma_{P,Q}^{N+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)  ,
\end{equation}
where the \emph{partial isometries} $P_{\mathcal{H}^{M},\mathcal{H}^{N}}$ are
defined as
\begin{equation}
P_{\mathcal{H}^{M},\mathcal{H}^{N}}=\sum_{\substack{1\leq j_{1},\cdots
,j_{M}\leq\infty\\1\leq k_{1},\cdots,k_{N}\leq\infty}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{N}}\right\vert .
\end{equation}


\subparagraph{Transformation of Bases}

A basis for a column vector space $V$ (i.e. contravariant vectors) can
displayed as
\begin{equation}
\left\vert \mathbf{e}\right)  =\left\vert e_{1},\cdots,e_{n},\cdots
,e_{r}\right)  =\left\vert \mathcal{R}_{f}\left(  e_{1}\right)  ,\cdots
,\mathcal{R}_{f}\left(  e_{n}\right)  ,\cdots,\mathcal{R}_{f}\left(
e_{r}\right)  \right)  =\left\vert \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{n}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{r}%
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{n}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{n}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{r}%
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{n}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{r}%
\end{array}
\right)  \right)  ,
\end{equation}
where $\mathcal{R}_{f}$ is the representation wrt the basis $\left\vert
\mathbf{f}\right)  .$ The RHS can be thought of as a matrix
\begin{equation}
\mathcal{R}_{f}\left(  \left\vert \mathbf{e}\right)  \right)  =\left(  \left(
%
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{n}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{r}%
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{n}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{n}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{r}%
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{n}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{r}%
\end{array}
\right)  \right)
\end{equation}
and $V$ as the vector space generated by the columns of $\mathcal{R}%
_{f}\left(  \left\vert \mathbf{e}\right)  \right)  ,$ i.e. the column space.
If $\left\vert \mathbf{f}\right)  =\left\vert \mathbf{e}\right)  $ then
\begin{equation}
\mathcal{R}_{f}\left(  \left\vert \mathbf{e}\right)  \right)  =\left(  \left(
%
\begin{array}
[c]{c}%
1\\
0\\
\vdots\\
\vdots\\
0
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
1\\
\vdots\\
0
\end{array}
\right)  ,\cdots,\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
\vdots\\
1
\end{array}
\right)  \right)  =\mathbb{I}_{r}.
\end{equation}


Consider two bases $\left\{  e_{j}\right\}  $ and $\left\{  f_{j}\right\}  ,$
which are related by an invertible linear transformation $M,$ then
\begin{equation}
M\left\vert \mathbf{e}\right)  =\left\vert \mathbf{e}\right)  \mathcal{R}%
_{e}\left(  M\right)  =\left\vert \mathbf{f}\right)  =\left\vert f_{1}%
,f_{2},\cdots\right)  =\left\vert M\left(  e_{1}\right)  ,M\left(
e_{2}\right)  ,\cdots\right)  =\left\vert M^{1}\left(  \mathbf{e}\right)
,M^{2}\left(  \mathbf{e}\right)  ,\cdots\right)  ,
\end{equation}
where%
\begin{equation}
f_{j}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
e_{k}M_{kj}=M^{j}\left(  \mathbf{e}\right)  =M\left(  e_{j}\right)
\end{equation}
Then

\begin{enumerate}
\item
\begin{align}
M\left\vert \mathbf{e}\right)   &  =\left\vert \mathbf{e}\right)
\mathcal{R}_{e}\left(  M\right) \nonumber\\
\mathbb{M}_{e}  &  =\Delta_{e}\mathcal{R}_{e}\left(  M\right) \nonumber\\
\Delta_{e}^{-1}\mathbb{M}_{e}  &  =\mathcal{R}_{e}\left(  M\right)  .
\end{align}


\item
\begin{align}
M^{-1}\left\vert \mathbf{f}\right)   &  =\left\vert \mathbf{f}\right)
\mathcal{R}_{f}\left(  M^{-1}\right) \nonumber\\
\mathbb{M}_{f}  &  =\Delta_{f}\mathcal{R}_{f}\left(  M^{-1}\right) \nonumber\\
\Delta_{f}^{-1}\mathbb{M}_{f}  &  =\mathcal{R}_{f}\left(  M^{-1}\right)  ,
\end{align}
giving the following transformation for the orthonormalized bases

\item
\begin{align}
M\left\vert \mathbf{e}\right)  \Delta_{e}^{-\frac{1}{2}}  &  =\left\vert
\mathbf{e}\right)  \Delta_{e}^{-\frac{1}{2}}\mathcal{R}_{e}\left(  M\right)
\nonumber\\
\mathbb{\breve{M}}_{e}  &  =\mathcal{R}_{e}\left(  M\right)  .\nonumber
\end{align}


\item One can also write this as
\begin{align}
M\left\vert \mathbf{e}\right)   &  =\left\vert \mathbf{f}\right)  \Delta
_{e}^{-1}\left(  \mathbf{e}\right\vert \nonumber\\
M^{-1}\left\vert \mathbf{f}\right)   &  =\left\vert \mathbf{e}\right)
\Delta_{f}^{-1}\left(  \mathbf{f}\right\vert
\end{align}
and in the non orthonormal case as

\item
\begin{align}
M\left\vert \mathbf{e}\right)  \Delta_{e}^{-\frac{1}{2}}  &  =\left\vert
\mathbf{f}\right)  \Delta_{f}^{-\frac{1}{2}}\Delta_{e}^{-\frac{1}{2}}\left(
\mathbf{e}\right\vert \nonumber\\
M^{-1}\left\vert \mathbf{f}\right)  \Delta_{f}^{-1}  &  =\left\vert
\mathbf{e}\right)  \Delta_{e}^{-\frac{1}{2}}\Delta_{f}^{-\frac{1}{2}}\left(
\mathbf{f}\right\vert .
\end{align}

\end{enumerate}

In terms of the representation $\mathcal{R}_{f}$ of the basis $\left\vert
\mathbf{e}\right)  $ one obtains%

\begin{align}
\left\vert \mathbf{g}\right)   &  =M\left\vert \mathbf{e}\right)  =\left\vert
\mathbf{e}\right)  \mathcal{R}_{fe}\left(  M\right)  =\left\vert M\left(
e_{1}\right)  ,\cdots,M\left(  e_{r}\right)  \right)  =\left\vert M^{1}\left(
\mathbf{e}\right)  ,\cdots,M^{r}\left(  \mathbf{e}\right)  \right) \\
&  =\left(  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{p}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{r}%
\end{array}
\right)  \cdots\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{n}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{p}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{r}%
\end{array}
\right)  \cdots\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{p}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{r}%
\end{array}
\right)  \right)  \mathcal{R}_{fe}\left(  M\right) \\
&  \mathcal{R}_{e}\left(  g_{n}\right)  _{m}=\sum_{1\leq p\leq r}%
\mathcal{R}_{f}\left(  e_{p}\right)  _{n}\mathcal{R}_{fe}\left(  M\right)
_{pm};\qquad g_{n}=M\left(  e_{n}\right)  =M_{n}\left(  \mathbf{e}\right) \\
&  \mathcal{R}_{e}\left(  g_{n}\right)  _{1}=\sum_{1\leq p\leq r}%
\mathcal{R}_{f}\left(  e_{p}\right)  _{n}\mathcal{R}_{fe}\left(  M\right)
_{p1};\qquad g_{n}=M\left(  e_{n}\right)  =M_{n}\left(  \mathbf{e}\right) \\
&  =\left(  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{1}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{p}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{1}\right)  _{r}%
\end{array}
\right)  \cdots\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{n}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{p}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{n}\right)  _{r}%
\end{array}
\right)  \cdots\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  e_{r}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{p}\\
\vdots\\
\mathcal{R}_{f}\left(  e_{r}\right)  _{r}%
\end{array}
\right)  \right)  \left(
\begin{array}
[c]{ccccc}%
\mathcal{R}_{fe}\left(  M\right)  _{11} & \cdots & \mathcal{R}_{fe}\left(
M\right)  _{1m} & \cdots & \mathcal{R}_{fe}\left(  M\right)  _{1r}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\mathcal{R}_{fe}\left(  M\right)  _{n1} & \cdots & \mathcal{R}_{fe}\left(
M\right)  _{nm} & \cdots & \mathcal{R}_{fe}\left(  M\right)  _{n1}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\mathcal{R}_{fe}\left(  M\right)  _{r1} & \cdots & \mathcal{R}_{fe}\left(
M\right)  _{rm} & \cdots & \mathcal{R}_{fe}\left(  M\right)  _{rr}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccccc}%
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{1}%
\mathcal{R}_{fe}\left(  M\right)  _{p1} & \cdots & \sum\limits_{1\leq p\leq
r}\mathcal{R}_{f}\left(  e_{p}\right)  _{n}\mathcal{R}_{fe}\left(  M\right)
_{p1} & \cdots & \sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(
e_{p}\right)  _{r}\mathcal{R}_{fe}\left(  M\right)  _{p1}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{n}\right)  _{1}%
\mathcal{R}_{fe}\left(  M\right)  _{pm} & \cdots & \sum\limits_{1\leq p\leq
r}\mathcal{R}_{f}\left(  e_{p}\right)  _{n}\mathcal{R}_{fe}\left(  M\right)
_{pm} & \cdots & \sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(
e_{p}\right)  _{r}\mathcal{R}_{fe}\left(  M\right)  _{pm}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{n}\right)  _{1}%
\mathcal{R}_{fe}\left(  M\right)  _{pm} & \cdots & \sum\limits_{1\leq p\leq
r}\mathcal{R}_{f}\left(  e_{p}\right)  _{n}\mathcal{R}_{fe}\left(  M\right)
_{pr} & \cdots & \sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(
e_{p}\right)  _{r}\mathcal{R}_{fe}\left(  M\right)  _{pr}%
\end{array}
\right)
\end{align}
Hence the representation of the $g_{n}$vector in the $f$ basis is
\begin{equation}
\mathcal{R}_{f}\left(  g_{n}\right)  =\left(
\begin{array}
[c]{c}%
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{n}%
\mathcal{R}_{fe}\left(  M\right)  _{p1}\\
\vdots\\
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{n}%
\mathcal{R}_{fe}\left(  M\right)  _{pm}\\
\vdots\\
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{n}%
\mathcal{R}_{fe}\left(  M\right)  _{pr}%
\end{array}
\right)  .
\end{equation}


\begin{example}%
\begin{equation}
\mathcal{R}_{f}\left(  g_{1}\right)  =\left(
\begin{array}
[c]{c}%
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{1}%
\mathcal{R}_{fe}\left(  M\right)  _{p1}\\
\vdots\\
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{1}%
\mathcal{R}_{fe}\left(  M\right)  _{pm}\\
\vdots\\
\sum\limits_{1\leq p\leq r}\mathcal{R}_{f}\left(  e_{p}\right)  _{1}%
\mathcal{R}_{fe}\left(  M\right)  _{pr}%
\end{array}
\right)  .
\end{equation}

\end{example}

\subparagraph{Linear Maps $\mathfrak{M}\in\mathcal{B}\left(  \mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  $}

\begin{enumerate}
\item The $\mathcal{R}_{\mathbf{\Phi}}$ representation of $\Gamma$
\begin{align}
\Gamma\left\vert \overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle  &  =\left\vert
\overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)  }\right\rangle \mathcal{R}_{\mathbf{\Phi}%
}\left(  \Gamma\right) \\
\left\langle \overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  }\right\vert \Gamma\left\vert
\overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)  }\right\rangle  &  =\mathcal{M}%
_{\mathbf{\Phi}}\left(  \Gamma\right)  =\left\langle \overset{}{\left(
\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
\right)  }\right\vert \left\vert \overset{}{\left(  \left\vert \mathbf{\Phi
}\right\rangle \left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle
\mathcal{R}_{\mathbf{\Phi}}\left(  \Gamma\right)  =\Delta_{\left\vert
\mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert }%
\mathcal{R}_{\mathbf{\Phi}}\left(  \Gamma\right) \\
\mathcal{R}_{\mathbf{\Phi}}\left(  \Gamma\right)   &  =\Delta_{\left\vert
\mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert }%
^{-1}\mathcal{M}_{\mathbf{\Phi}}\left(  \Gamma\right)  .
\end{align}


\item The $\left(  \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)  $-expansion of $\Gamma$
\begin{equation}
\Gamma=\left\vert \overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle \Delta
_{\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
}^{-1}\mathcal{M}_{\mathbf{\Phi}}\left(  \Gamma\right)  \Delta_{\left\vert
\mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert }%
^{-1}\left\langle \overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  }\right\vert =\left\vert
\overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)  }\right\rangle \mathcal{R}_{\mathbf{\Phi}%
}\left(  \Gamma\right)  \Delta_{\left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert }^{-1}\left\langle \overset{}{\left(
\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
\right)  }\right\vert .
\end{equation}


\item For orthonormal bases
\begin{equation}
\Gamma=\left\vert \overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle \mathcal{M}%
_{\mathbf{\Phi}}\left(  \Gamma\right)  \left\langle \overset{}{\left(
\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
\right)  }\right\vert =\left\vert \overset{}{\left(  \left\vert \mathbf{\Phi
}\right\rangle \left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle
\mathcal{R}_{\mathbf{\Phi}}\left(  \Gamma\right)  \left\langle
\overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)  }\right\vert .
\end{equation}

\end{enumerate}

Linear Maps $\mathfrak{M}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ in general
are given by%

\begin{equation}
\mathfrak{M}=\sum_{0\leq P,Q,M,N\leq\infty}\left(  \left\vert \Phi
_{P}\right\rangle \left\langle \Phi_{Q}\right\vert \right)  \left(
\mathcal{R}_{\mathbf{\Phi}}\left(  \mathfrak{M}\right)  \Delta_{\left\vert
\mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert }%
^{-1}\right)  _{PQMN}\left(  \left\vert \Phi_{M}\right\rangle \left\langle
\Phi_{N}\right\vert \right)  ^{t},
\end{equation}
i.e.%
\begin{equation}
\mathfrak{M}\left(  X\right)  =\sum_{0\leq P,Q,M,N\leq\infty}\left(
\left\vert \Phi_{P}\right\rangle \left\langle \Phi_{Q}\right\vert \right)
\left(  \mathcal{R}_{\mathbf{\Phi}}\left(  \mathfrak{M}\right)  \Delta
_{\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
}^{-1}\right)  _{PQMN}\left(  \left\vert \Phi_{M}\right\rangle \left\langle
\Phi_{N}\right\vert \right)  ^{t}\sum_{0\leq R,S\leq\infty}\left(  \left\vert
\Phi_{R}\right\rangle \left\langle \Phi_{S}\right\vert \right)  \mathcal{R}%
_{\mathbf{\Phi}}\left(  X\right)  _{RS}%
\end{equation}
giving%
\begin{equation}
\mathfrak{M}\left(  X\right)  =\sum_{0\leq P,Q\leq\infty}\sum_{0\leq
M,N\leq\infty}\left(  \left\vert \Phi_{P}\right\rangle \left\langle \Phi
_{Q}\right\vert \right)  \left(  \mathcal{R}_{\mathbf{\Phi}}\left(
\mathfrak{M}\right)  \Delta_{\left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert }^{-1}\right)  _{PQMN}\mathcal{R}%
_{\mathbf{\Phi}}\left(  X\right)  _{MN}=\sum_{0\leq P,Q\leq\infty}\left(
\left\vert \Phi_{P}\right\rangle \left\langle \Phi_{Q}\right\vert \right)
\left(  \overset{}{\mathcal{R}_{\mathbf{\Phi}}\left(  \mathfrak{M}\left(
X\right)  \right)  }\right)  _{PQ}=\sum_{0\leq P,Q\leq\infty}\mathfrak{M}%
^{PQ}\left(  X\right)  ,
\end{equation}
where
\begin{equation}
X=\sum_{0\leq R,S\leq\infty}\sum_{\substack{1\leq l_{1}<\cdots<l_{R}\leq
\infty\\1\leq m_{1}<\cdots<m_{S}\leq\infty}}\left(  \left\vert \varphi_{l_{1}%
}\cdots\varphi_{l_{R}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{S}}\right\vert \right)  X_{l_{1}\cdots l_{R}m_{1}\cdots m_{S}}.
\end{equation}


The second quantization map, which is in fact the generalized expansion map,
can be expressed as
\begin{gather}
\Gamma=\left\vert \overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle
\left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle \mathcal{R}%
_{\mathbf{\Phi}}\left(  \Gamma\right)  \left\langle \overset{}{\left(
\left\vert \mathbf{\Phi}\right\rangle \left\langle \mathbf{\Phi}\right\vert
\right)  }\right\vert =\left\vert \overset{}{\left(  \left\vert \mathbf{\Phi
}\right\rangle \left\langle \mathbf{\Phi}\right\vert \right)  }\right\rangle
\mathcal{M}_{\mathbf{\Phi}}\left(  \Gamma\right)  \left\langle
\overset{}{\left(  \left\vert \mathbf{\Phi}\right\rangle \left\langle
\mathbf{\Phi}\right\vert \right)  }\right\vert \\
=\sum_{0\leq P,Q,M,N\leq\infty}\sum_{\substack{1\leq l_{1}<\cdots<l_{p}%
\leq\infty\\1\leq m_{1}<\cdots<m_{Q}\leq\infty\\1\leq j_{1}<\cdots<j_{M}%
\leq\infty\\1\leq k_{1}<\cdots<k_{N}\leq\infty}}\left\vert \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{Q}}\right\vert \right)  \left(  \overset{}{\mathcal{R}%
_{\mathbf{\Phi}}\left(  \Gamma\right)  _{l_{1}\cdots l_{p}m_{1}\cdots
m_{Q}j_{1}\cdots j_{M}k_{1}\cdots k_{N}}}\right)  \left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{N}}\right\vert \right\vert
\end{gather}
and its action by
\begin{align}
\Gamma\left(  X\right)   &  =\sum_{0\leq P,Q\leq\infty}\sum_{0\leq
M,N\leq\infty}\left(  \left\vert \Phi_{M}\right\rangle \left\langle \Phi
_{N}\right\vert \right)  \mathcal{R}_{\mathbf{\Phi}}\left(  \Gamma\right)
_{\left(  M,N\right)  ,\left(  P,Q\right)  }X_{PQ}=\sum_{0\leq M,N\leq\infty
}\left(  \left\vert \Phi_{M}\right\rangle \left\langle \Phi_{N}\right\vert
\right)  \left(  \mathcal{R}_{\mathbf{\Phi}}\left(  \Gamma\right)
\mathcal{R}_{\mathbf{\Phi}}\left(  X\right)  \right)  _{MN}=\sum_{0\leq
M,N\leq\infty}\Gamma^{M,N}\left(  X\right) \nonumber\\
&  \equiv\sum_{0\leq M,N\leq\infty}\sum_{\substack{1\leq l_{1}<\cdots
<l_{M}\leq\infty\\1\leq m_{1}<\cdots<m_{N}\leq\infty}}\mathcal{R}%
_{\mathbf{\Phi}}\left(  \Gamma\right)  _{l_{1}\cdots l_{p}m_{1}\cdots
m_{Q}j_{1}\cdots j_{M}k_{1}\cdots k_{N}}\left(  X\right)  .
\end{align}
On basis elements the action is given by
\begin{align}
\Gamma\left(  \left(  \left\vert \Phi_{P}\right\rangle \left\langle \Phi
_{Q}\right\vert \right)  \right)   &  =\sum_{0\leq M,N\leq\infty}\left(
\left\vert \Phi_{M}\right\rangle \left\langle \Phi_{N}\right\vert \right)
\boldsymbol{\Gamma}_{\left(  M,N\right)  ,\left(  P,Q\right)  }=\sum_{0\leq
M,N\leq\infty}\Gamma_{MN}\left(  \left(  \left\vert \Phi_{P}\right\rangle
\left\langle \Phi_{Q}\right\vert \right)  \right)  =\sum_{0\leq N\leq\infty
}\left(  \left\vert \Phi_{P+M}\right\rangle \left\langle \Phi_{Q+N}\right\vert
\right)  \boldsymbol{\Gamma}_{\left(  \left(  P+M\right)  \left(  Q+N\right)
\right)  ,\left(  PQ\right)  }\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sqrt{\binom{M+P}{P}\binom{N+Q}{Q}}\Gamma
_{P,Q}^{M+P,N+Q}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right) \\
&  =\sum_{0\leq N\leq\infty}\sqrt{\binom{M+P}{P}\binom{N+Q}{Q}}\sum_{1\leq
j_{1}<\cdots<j_{N}\leq\infty}\left\vert \left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{P}}\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{q}}\varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\vert \right) \\
&  =\sum_{0\leq N\leq\infty}\Gamma^{\left(  M+P\right)  ,\left(  N+Q\right)
}\left(  \left\vert \left\vert \Phi_{P}\right\rangle \left\langle \Phi
_{Q}\right\vert \right)  \right)  ,
\end{align}
i.e.
\begin{align}
\Gamma^{\left(  P+M\right)  ,\left(  Q+N\right)  }\left(  \left\vert
\left\vert \Phi_{P}\right\rangle \left\langle \Phi_{Q}\right\vert \right)
\right)   &  =\sqrt{\binom{M+P}{P}\binom{N+Q}{Q}}\Gamma_{P,Q}^{\left(
M+P\right)  ,\left(  N+Q\right)  }\left(  \left\vert \Phi_{P}\right\rangle
\left\langle \Phi_{Q}\right\vert \right) \nonumber\\
&  =\sum_{1\leq j_{1}<\cdots<j_{p}\leq\infty}\left\vert \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{M}}\varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\varphi
_{j_{1}}\cdots\varphi_{j_{P}}\right\vert \right)  \Gamma_{l_{1}\cdots
l_{M}j_{1}\cdots j_{P}m_{1}\cdots m_{N}j_{1}\cdots j_{P}}\nonumber\\
&  =\sqrt{\binom{M+P}{P}\binom{N+Q}{Q}}\sum_{1\leq j_{1}<\cdots<j_{p}%
\leq\infty}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\varphi_{j_{1}%
}\cdots\varphi_{j_{M}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{Q}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}
In particular for $P=Q$
\begin{align}
&  \Gamma\left(  \left\vert \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert
\right)  \right)  =\sum_{0\leq N\leq\infty}\sum_{\substack{1\leq j_{1}%
<\cdots<j_{N}\leq\infty\\1\leq k_{1}<\cdots<k_{N}\leq\infty}}\left\vert
\left\vert \varphi_{j_{1}}\cdots\varphi_{l_{N}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{N}}\right\vert \right)  \Gamma_{j_{1}\cdots
j_{N}k_{1}\cdots k_{N}l_{1}\cdots l_{P}m_{1}\cdots m_{p}}\nonumber\\
&  =\sum_{P\leq N\leq\infty}\binom{N}{P}\sum_{1\leq j_{1}<\cdots<j_{p}%
\leq\infty}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\varphi_{j_{1}%
}\cdots\varphi_{j_{N-P}}\right\rangle \left\langle \varphi_{m_{1}}%
\cdots\varphi_{m_{P}}\varphi_{j_{1}}\cdots\varphi_{j_{N-P}}\right\vert
\nonumber\\
&  =\sum_{P\leq N\leq\infty}\Gamma_{NN}\left(  \left\vert \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{P}}\right\vert \right)  \right)  =\sum_{P\leq N\leq\infty
}\binom{N}{P}\Gamma_{PP}^{N,N}\left(  \left\vert \varphi_{l_{1}}\cdots
\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}%
}\right\vert \right) \\
&  \equiv\sum_{P\leq N\leq\infty}\binom{N}{P}\Gamma_{P}^{N,}\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{P}}\right\vert \right)  ,
\end{align}
i.e. as $\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert \right)  $ is a
basis element one has
\begin{equation}
\Gamma^{N}\left(  \left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert
\right)  \right)  =\Gamma^{N}\left(  \left(  \left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{P}}\right\vert \right)  \right)  =\binom{N}{P}\Gamma_{P}%
^{N}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert \right)  ,
\end{equation}
while for a general $X$
\begin{align}
\Gamma^{N,N}\left(  X\right)   &  =\sum_{0\leq P\leq N}\binom{N}{P}%
\Gamma_{P,P}^{N,N}\left(  X_{P}\right) \\
&  =\sum_{0\leq P\leq N}\binom{N}{P}\Gamma_{P,P}^{N,N}\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{P}}\right\vert \right)  X_{l_{1}\cdots l_{P}m_{1}\cdots
m_{p}}.
\end{align}


\emph{The inverse of }$\mathfrak{M}$\emph{ is given by}%

\begin{equation}
\sum_{0\leq P,Q,R\leq\infty}\mathfrak{M}_{PQ}\left(  \mathfrak{M}^{-1}\right)
_{QR}=I_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }=\sum_{0\leq
P,Q,R\leq\infty}\left(  \mathfrak{M}^{-1}\right)  _{PQ}\mathfrak{M}_{QR}.
\end{equation}
In particular for the generalized contraction map $L$
\begin{equation}
L\left(  X_{N}\right)  =\sum_{0\leq P\leq\infty}L_{P}\left(  X_{N}\right)
=\sum_{0\leq P\leq N\leq\infty}\binom{N}{P}L_{N}^{P}\left(  X_{N}\right)
,\nonumber
\end{equation}
so if $X=X_{N}$ one has
\begin{equation}
X_{N}=L^{-1}L\left(  X_{N}\right)  =\sum_{0\leq P\leq\infty}\left(
L^{-1}\right)  _{P}^{N}L_{N}^{P}\left(  X_{N}\right)  .
\end{equation}
The map $\Gamma$ transforms a ket-bra basis of $\mathcal{F}$ to a second
quantized basis$.$ \emph{Its definition is basis independent as it involves
projections and partial isometries associated with the subspaces }$\left\{
\left.  \mathcal{H}^{N}\right\vert 0\leq j\leq r\right\}  $\emph{ rather than
individual bases. }

\subsubsection{Generalized Contraction and Expansion Maps $L$ and $\Gamma$}

The generalized expansion and contraction maps that belong to $\mathcal{B}%
\left(  \mathcal{F}\right)  $ are adjoints to each other wrt the dual Banach
spaces $\left\langle \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
,\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right\rangle $ wrt
$\operatorname*{Tr}_{\mathcal{H}_{\mathcal{F}}},$ where
\begin{equation}
f_{X}\left(  Y\right)  \equiv\left\langle \left.  X\right\vert Y\right\rangle
=\operatorname*{Tr}\nolimits_{\mathcal{H}_{\mathcal{F}}}\left\{  X^{\dagger
}Y\right\}  ,\quad X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
,Y\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}


\begin{example}%
\begin{align}
&  D_{PQj_{1}\cdots j_{P}k_{1}\cdots k_{Q}}=\operatorname*{Tr}%
\nolimits_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  a_{j_{1}}^{\dagger
}\cdots a_{j_{P}}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}}\right)  ^{\dagger
}D\right\}  =\operatorname*{Tr}\nolimits_{\mathcal{H}_{\mathcal{F}}}\left\{
a_{k_{1}}^{\dagger}\cdots a_{k_{Q}}^{\dagger}a_{j_{P}}\cdots a_{j_{1}%
}D\right\}  =\left\langle \Gamma\left(  \left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\right\vert \right)  D\right\rangle \nonumber\\
&  =\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert
\right\vert L\left(  D\right)  \right\rangle =\operatorname*{Tr}%
\nolimits_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right)  ^{\dagger}L\left(  D\right)
\right\} \\
&  =\operatorname*{Tr}\nolimits_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(
\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\vert \right)  L\left(  D\right)
\right\}  =\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert L\left(  D\right)  \varphi_{k_{1}}\cdots\varphi_{k_{Q}%
}\right\rangle =L\left(  D\right)  _{j_{1}\cdots j_{P}k_{1}\cdots k_{Q}},
\end{align}
which defines the operators%
\begin{equation}
D_{PQ}:\mathcal{H}^{Q}\rightarrow\mathcal{H}^{P}%
\end{equation}
by%
\begin{equation}
D_{PQ}=\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{Q}\leq\infty}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert
L\left(  D\right)  _{j_{1}\cdots j_{P}k_{1}\cdots k_{Q}}=\sum_{\substack{1\leq
j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}<\cdots<k_{Q}\leq\infty}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \mathcal{R}_{\boldsymbol{\varphi}}\left(
L\left(  D\right)  \right)  _{j_{1}\cdots j_{P}k_{1}\cdots k_{Q}}.
\end{equation}

\end{example}

The contraction and expansion maps are linear and have components
\begin{subequations}
\label{ExpConCom}%
\begin{align}
P_{\mathcal{B}\left(  \mathcal{H}^{P}\right)  }LP_{\mathcal{B}\left(
\mathcal{H}^{N}\right)  }  &  =L_{PN}=\binom{N}{P}L_{N}^{P};N\geq P\nonumber\\
P_{\mathcal{B}\left(  \mathcal{H}^{N}\right)  }\Gamma P_{\mathcal{B}\left(
\mathcal{H}^{P}\right)  }  &  =\Gamma_{NP}=\binom{N}{P}\Gamma_{P}^{N};N\geq P
\end{align}
and thus are \emph{triangular }maps.

One \emph{should note} that in general
\end{subequations}
\begin{equation}
\Gamma\left(  A\right)  \circ\Gamma\left(  B\right)  \neq\Gamma\left(
A\bullet B\right)  \neq\Gamma\left(  A\circ B\right)  ,
\end{equation}
so $\Gamma$ is not an algebraic map wrt "$\circ"$ nor "$\bullet"$.

\subparagraph{Expectation Values of a $N$-particle State and the Generalized
Contraction Map}

The action of the generalized contraction map on \emph{guage invariant
}operators i.e. operators belonging to $\mathcal{F}_{e\varphi}$ $=\Delta
_{\varphi}\left(  \mathcal{F}\right)  $ is
\begin{align}
L\left(  X_{e}\right)   &  =L\left(  \left(
\begin{array}
[c]{ccccc}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert  & \cdots &
\left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}%
_{N}\right\vert  & \cdots & \left\vert \mathbf{\varphi}_{r}\right\rangle
\left\langle \mathbf{\varphi}_{r}\right\vert
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right)  \right) \\
&  =\left(
\begin{array}
[c]{ccccc}%
L\left(  \left\vert \phi\right\rangle \left\langle \phi\right\vert \right)  &
\cdots & L\left(  \left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle
\mathbf{\varphi}_{N}\right\vert \right)  & \cdots & L\left(  \left\vert
\mathbf{\varphi}_{r}\right\rangle \left\langle \mathbf{\varphi}_{r}\right\vert
\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right) \\
=  &  \left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}L_{0}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & 0 & \binom{n}{0}L_{n}^{0}\left(  \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right)  & \cdots & \binom
{r}{0}L_{r}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right) \\
\vdots & \ddots & 0 & \cdots & \vdots\\
0 & \cdots & \binom{n}{n}L_{n}^{n}\left(  \left\vert \mathbf{\varphi}%
_{N}\right\rangle \left\langle \mathbf{\varphi}_{N}\right\vert \right)  &
\cdots & \binom{r}{n}L_{r}^{n}\left(  \left\vert \mathbf{\varphi}%
_{N}\right\rangle \left\langle \mathbf{\varphi}_{N}\right\vert \right) \\
\vdots & \cdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \cdots & \binom{r}{r}L_{r}^{r}\left(  \left\vert
\mathbf{\varphi}_{r}\right\rangle \left\langle \mathbf{\varphi}_{r}\right\vert
\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  X_{0}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{eN}\right) \\
\vdots\\
\mathcal{R}_{\varphi}\left(  X_{er}\right)
\end{array}
\right)  =\mathcal{R}_{\varphi}\left(  \left(
\begin{array}
[c]{c}%
L_{0}\left(  X_{e}\right) \\
\vdots\\
L_{N}\left(  X_{e}\right) \\
\vdots\\
L_{r}\left(  X_{e}\right)
\end{array}
\right)  \right)  ,
\end{align}
where
\begin{align}
L_{0}\left(  X_{e}\right)   &  =\sum\limits_{0\leq p\leq r}\binom{p}{0}%
L_{0}^{p}\left(  X_{ep}\right)  =\binom{0}{0}L_{0}^{0}\left(  X_{e0}\right)
+\cdots+\binom{n}{0}L_{n}^{0}\left(  X_{en}\right)  +\cdots+\binom{r}{0}%
L_{r}^{0}\left(  X_{er}\right) \\
L_{1}\left(  X_{e}\right)   &  =\sum\limits_{1\leq p\leq r}\binom{p}{1}%
L_{1}^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right)
=\binom{1}{1}L_{1}^{1}\left(  X_{e1}\right)  +\cdots+\binom{n}{1}L_{n}%
^{1}\left(  X_{en}\right)  +\cdots+\binom{n}{1}L_{r}^{1}\left(  X_{er}\right)
\\
L_{2}\left(  X_{e}\right)   &  =\sum\limits_{2\leq p\leq r}\binom{p}{2}%
L_{2}^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right)
=\binom{2}{2}L_{2}^{2}\left(  X_{e2}\right)  +\cdots+\binom{n}{2}L_{n}%
^{2}\left(  X_{en}\right)  +\cdots+\binom{r}{2}L_{r}^{2}\left(  X_{er}\right)
\\
&  \vdots\\
L_{n}\left(  X_{e}\right)   &  =\sum\limits_{n\leq p\leq r}\binom{n}{p}%
L_{n}^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right)
=\binom{n}{n}L_{n}^{n}\left(  X_{en}\right)  +\cdots+\binom{n}{r}L_{r}%
^{n}\left(  X_{er}\right) \\
&  \vdots\\
L_{r}\left(  X_{e}\right)   &  =\binom{r}{r}L_{r}^{r}\left(  X_{er}\right)  .
\end{align}


\begin{remark}%
\begin{gather}
\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}L_{0}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  & \cdots & \binom{n}{0}L_{n}^{0}\left(  \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right)  & \cdots & \binom
{r}{0}L_{r}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right) \\
\vdots & \ddots & \vdots & \cdots & \vdots\\
0 & \cdots & \binom{n}{n}L_{n}^{n}\left(  \left\vert \mathbf{\varphi}%
_{N}\right\rangle \left\langle \mathbf{\varphi}_{N}\right\vert \right)  &
\cdots & \binom{r}{n}L_{r}^{n}\left(  \left\vert \mathbf{\varphi}%
_{N}\right\rangle \left\langle \mathbf{\varphi}_{N}\right\vert \right) \\
\vdots & \cdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \cdots & \binom{r}{r}L_{r}^{r}\left(  \left\vert
\mathbf{\varphi}_{r}\right\rangle \left\langle \mathbf{\varphi}_{r}\right\vert
\right)
\end{array}
\right) \\
\parallel\\
\left(
\begin{array}
[c]{ccccc}%
P_{0} & \cdots & \binom{n}{0}L_{n}^{0}\left(  \left\vert \phi\right\rangle
\left\langle \phi\right\vert \right)  & \cdots & \binom{r}{0}L_{r}^{0}\left(
\left\vert \phi\right\rangle \left\langle \phi\right\vert \right) \\
\vdots & \ddots & \vdots & \cdots & \vdots\\
0 & \cdots & P_{N} & \cdots & \binom{r}{n}L_{r}^{n}\left(  \left\vert
\mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}_{N}\right\vert
\right) \\
\vdots & \cdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \cdots & P_{r}%
\end{array}
\right) \\
\parallel\\
\left(
\begin{array}
[c]{ccccc}%
I_{\mathcal{H}^{0}} & \cdots & \binom{n}{0}L_{n}^{0}\left(  \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right)  & \cdots & \binom
{r}{0}L_{r}^{0}\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right) \\
\vdots & \ddots & \vdots & \cdots & \vdots\\
0 & \cdots & I_{\mathcal{H}^{N}} & \cdots & \binom{r}{n}L_{r}^{n}\left(
\left\vert \mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}%
_{N}\right\vert \right) \\
\vdots & \cdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \cdots & I_{\mathcal{H}^{r}}%
\end{array}
\right)  .\nonumber
\end{gather}

\end{remark}

\begin{lemma}
The operators
\begin{equation}
\boldsymbol{\lambda}_{M}=P_{M},\,P_{M}\in\mathcal{B}\left(  \mathcal{H}%
^{M}\right)  ,\,0\leq M\leq r,
\end{equation}
are eigen value operators of $L.$
\end{lemma}

\begin{lemma}
The operator matrix $L$ cannot be diagonalized it can only be brought to
\emph{Operator Jordan Canonical Form}
\end{lemma}

\begin{proof}
This is true as $L$ is a triangular matrix.
\end{proof}

\begin{lemma}
It has \emph{generalized} \emph{eigen vector operators }$X$ given by
\begin{equation}
\left(  L-\boldsymbol{\lambda}_{M}I_{\mathcal{B}\left(  \mathcal{F}\right)
}\right)  ^{p}X=\mathbb{O}_{\mathcal{B}\left(  \mathcal{F}\right)  }%
,\,X\in\mathcal{B}\left(  \mathcal{F}\right)  ,\text{ }p\geq\text{for some
}q\in\mathbb{Z}_{+},
\end{equation}
where $\boldsymbol{\lambda}_{M}$ are diagonal elemements of the Jordan blocks,
i.e. \emph{eigen value operators}.
\end{lemma}

\begin{definition}
If $q$ is the smallest positive integer such that the preceding equation is
true then the sequence
\begin{equation}
\left\{  \left(  L-\boldsymbol{\lambda}_{M}I_{\mathcal{B}\left(
\mathcal{F}\right)  }\right)  ^{q-1}X,\cdots,\left(  L-\boldsymbol{\lambda
}_{M}I_{\mathcal{B}\left(  \mathcal{F}\right)  }\right)  X,X\in\mathcal{B}%
\left(  \mathcal{F}\right)  \right\}
\end{equation}
is called a \emph{cycle} or \emph{chain} of generalized eigen vector
operators. The terminal \emph{generalized eigen vector operator} i.e. $\left(
L-\boldsymbol{\lambda}_{M}I_{\mathcal{B}\left(  \mathcal{F}\right)  }\right)
^{q-1}X,$ in the chain is always an \emph{eigen vector operato}r as
\begin{equation}
\left(  L-\boldsymbol{\lambda}_{M}I_{\mathcal{B}\left(  \mathcal{F}\right)
}\right)  \left[  \left(  L-\boldsymbol{\lambda}_{M}I_{\mathcal{B}\left(
\mathcal{F}\right)  }\right)  ^{q-1}X\right]  =0.
\end{equation}

\end{definition}

\begin{remark}
The generalized eigen operators are linearly independent.

\begin{theorem}
The operator Jordan Canonical Form of $L$ i.e. the matrix of $L$ wrt its
generalized eigenoperators is
\begin{equation}
\left(
\begin{array}
[c]{ccccccc}%
P_{0} & P_{01} & \cdots & \cdots & \cdots & P_{0r-1} & O_{0r-1}\\
O_{10} & P_{1} & P_{12} & \cdots & \cdots & P_{1r-1} & P_{1r}\\
\vdots & \ddots & \ddots & \ddots & \cdots & \vdots & \vdots\\
\vdots & \cdots & O_{NN-1} & P_{N} & P_{NN+1} & \cdots & P_{Nr}\\
\vdots & \cdots & \vdots & \ddots & \ddots & \vdots & \vdots\\
\vdots & \cdots & \cdots & \vdots & O_{r-1N+1} & P_{r-1} & P_{r-1r}\\
O_{r0} & \cdots & \cdots & \cdots & \cdots & O_{rr-1} & P_{r}%
\end{array}
\right)  .
\end{equation}

\end{theorem}
\end{remark}

\begin{remark}
The matrix elements and "vector" coefficients in the following are all
operators:
\begin{equation}
\left(
\begin{array}
[c]{ccccccc}%
P_{0} & P_{01} & \cdots & \cdots & \cdots & P_{0r-1} & O_{0r-1}\\
O_{10} & P_{1} & P_{12} & \cdots & \cdots & P_{1r-1} & P_{1r}\\
\vdots & \ddots & \ddots & \ddots & \cdots & \vdots & \vdots\\
\vdots & \cdots & O_{NN-1} & P_{N} & P_{NN+1} & \cdots & P_{N}r\\
\vdots & \cdots & \vdots & \ddots & \ddots & \vdots & \vdots\\
\vdots & \cdots & \cdots & \vdots & O_{r-1N+1} & P_{r-1} & P_{r-1r}\\
O_{r0} & \cdots & \cdots & \cdots & \cdots & O_{rr-1} & P_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
P_{0}\\
O_{10}\\
\vdots\\
\vdots\\
\vdots\\
\vdots\\
O_{r0}%
\end{array}
\right)  =P_{0}\left(
\begin{array}
[c]{c}%
P_{0}\\
O_{10}\\
\vdots\\
\vdots\\
\vdots\\
\vdots\\
O_{r0}%
\end{array}
\right)
\end{equation}
and%
\begin{equation}
\left(
\begin{array}
[c]{ccccccc}%
P_{0}-\boldsymbol{\lambda}_{0} & P_{01} & \cdots & \cdots & \cdots & P_{0r-1}
& O_{0r-1}\\
O_{10} & P_{1}-\boldsymbol{\lambda}_{1} & P_{12} & \cdots & \cdots & P_{1r-1}
& P_{1r}\\
\vdots & \ddots & \ddots & \ddots & \cdots & \vdots & \vdots\\
\vdots & \cdots & O_{NN-1} & P_{N}-\boldsymbol{\lambda}_{N} & P_{NN+1} &
\cdots & P_{N}r\\
\vdots & \cdots & \vdots & \ddots & \ddots & \vdots & \vdots\\
\vdots & \cdots & \cdots & \vdots & O_{r-1N+1} & P_{r-1}-\boldsymbol{\lambda
}_{r-1} & P_{r-1r}\\
O_{r0} & \cdots & \cdots & \cdots & \cdots & O_{rr-1} & P_{r}%
-\boldsymbol{\lambda}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
P_{0}\\
O_{10}\\
\vdots\\
\vdots\\
\vdots\\
\vdots\\
O_{r0}%
\end{array}
\right)  =P_{0}\left(
\begin{array}
[c]{c}%
P_{0}\\
O_{10}\\
\vdots\\
\vdots\\
\vdots\\
\vdots\\
O_{r0}%
\end{array}
\right)
\end{equation}

\end{remark}

In particular
\begin{equation}
\left(
\begin{array}
[c]{ccccc}%
P_{0} & \cdots & \binom{n}{0}L_{n}^{0}\left(  \left\vert \phi\right\rangle
\left\langle \phi\right\vert \right)  & \cdots & \binom{r}{0}L_{r}^{0}\left(
\left\vert \phi\right\rangle \left\langle \phi\right\vert \right) \\
\vdots & \ddots & \vdots & \cdots & \vdots\\
0 & \cdots & P_{N} & \cdots & \binom{r}{N}L_{r}^{n}\left(  \left\vert
\mathbf{\varphi}_{N}\right\rangle \left\langle \mathbf{\varphi}_{N}\right\vert
\right) \\
\vdots & \cdots & \vdots & \ddots & \vdots\\
0 & \cdots & 0 & \cdots & P_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
\vdots\\
0\\
X_{eN}\\
0\\
\vdots\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
L_{0}\left(  X_{eN}\right) \\
\vdots\\
L_{N}\left(  X_{eN}\right) \\
0\\
\vdots\\
0
\end{array}
\right)  ,
\end{equation}
where%
\begin{gather}
L_{0}\left(  X_{eN}\right)  =\sum\limits_{0\leq p\leq r}\binom{p}{0}L_{0}%
^{p}\left(  X_{ep}\right)  =\binom{N}{0}L_{N}^{0}\left(  X_{eN}\right) \\
L_{1}\left(  X_{eN}\right)  =\sum\limits_{1\leq p\leq r}\binom{p}{1}L_{1}%
^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  \right)  =\binom
{N}{1}L_{N}^{1}\left(  X_{eN}\right) \\
L_{2}\left(  X_{eN}\right)  =\sum\limits_{2\leq p\leq r}\binom{p}{2}L_{2}%
^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{2}\right)  \right)  =\binom
{N}{2}L_{N}^{2}\left(  X_{eN}\right) \\
\vdots\\
L_{N}\left(  X_{eN}\right)  =\sum\limits_{N\leq p\leq r}\binom{p}{N}L_{n}%
^{p}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right)  =\binom
{N}{N}L_{N}^{N}\left(  X_{eN}\right) \\
0\\
\vdots\\
0
\end{gather}
and%
\begin{equation}
L\left(  X_{e}\right)  =\left(
\begin{array}
[c]{c}%
L_{0}\left(  X_{eN}\right) \\
\vdots\\
L_{n}\left(  X_{eN}\right) \\
\vdots\\
L_{r}\left(  X_{eN}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\binom{N}{0}L_{N}^{0}\left(  X_{eN}\right) \\
\binom{N}{1}L_{N}^{1}\left(  X_{eN}\right) \\
\binom{N}{2}L_{N}^{2}\left(  X_{eN}\right) \\
\vdots\\
\binom{N}{N}L_{N}^{N}\left(  X_{eN}\right) \\
0\\
\vdots\\
0
\end{array}
\right)  .
\end{equation}
In this case
\begin{equation}
X_{e}=X_{eN}+X_{eN-1}+\cdots+X_{e1}+X_{e0}.
\end{equation}


\begin{lemma}%
\begin{equation}
L_{N}^{P}\left(  P_{N}\right)  =\operatorname{Tr}_{N-P}\left\{  P_{N}\right\}
=\binom{N}{P}^{-1}\binom{r-P}{N-P}P_{P}.
\end{equation}

\end{lemma}

Thus
\begin{equation}
L\left(  P_{N}\right)  =\left(
\begin{array}
[c]{c}%
\binom{N}{0}L_{N}^{0}\left(  P_{N}\right) \\
\binom{N}{1}L_{N}^{1}\left(  P_{N}\right) \\
\binom{N}{2}L_{N}^{2}\left(  P_{N}\right) \\
\vdots\\
\binom{N}{N}L_{N}^{N}\left(  P_{N}\right) \\
0\\
\vdots\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\binom{N}{0}\binom{N}{0}^{-1}\binom{r-0}{N-0}P_{0}\\
\binom{N}{1}\binom{N}{1}^{-1}\binom{r-1}{N-1}P_{1}\\
\binom{N}{2}\binom{N}{2}^{-1}\binom{r-2}{N-2}P_{2}\\
\vdots\\
\binom{N}{N}\binom{N}{N}^{-1}\binom{r-N}{N-N}P_{N}\\
0\\
\vdots\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
P_{0}\\
\binom{r-1}{N-1}P_{1}\\
\binom{r-2}{N-2}P_{2}\\
\vdots\\
\binom{r-N}{0}P_{N}\\
0\\
\vdots\\
0
\end{array}
\right)  ,
\end{equation}
showing that $L\left(  P_{N}\right)  $ is not a projector but is still positive.

\begin{definition}
The positive cone $\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  $ in $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ is defined by
\begin{equation}
\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =\left\{  \left.  X=QQ^{\dagger}\right\vert Q\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right\}  .
\end{equation}

\end{definition}

\begin{definition}
Hyperplanes defined by the trace linear functional $\operatorname*{Tr}$%
\begin{equation}
H_{\operatorname*{Tr}}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  =\left\{  \left.  \overset{}{X}\right\vert X\in
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,\operatorname*{Tr}%
\left(  X\right)  =z\in\mathbb{C}\right\}  .
\end{equation}

\end{definition}

\begin{lemma}
$H_{\operatorname*{Tr}}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  $ is a subspace of $\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ of co dimesion $1.$
\end{lemma}

\begin{proof}%
\begin{equation}
X\in H_{\operatorname*{Tr}}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  \Leftrightarrow\operatorname*{Tr}\left(
X-z\right)  =0
\end{equation}
hence $X-z\in\ker\left\{  \operatorname*{Tr}\right\}  $ and this a subspace of
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  .$

Any element $Y$ of $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ can
be expanded as
\begin{equation}
Y=\mathcal{X}+zI_{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{proof}

\begin{lemma}
The convex set of normal states of $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ is the cross section%
\begin{equation}
\mathcal{S}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =H_{\operatorname*{Tr}}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  \cap\mathcal{C}_{+}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  .
\end{equation}

\end{lemma}

\begin{lemma}
$X\in$ $\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  $ has a spectral resolution
\begin{equation}
X\geq0\Leftrightarrow\int_{\sigma\left(  X\right)  \subseteq\mathbb{R}_{+}%
}xdP_{X}\left(  x\right)  .
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{equation}
X\geq0\,\,\&\,\,X\in\mathcal{B}_{0}\left(  \mathcal{H}_{\mathcal{F}}\right)
\Leftrightarrow X=\sum_{1\leq j\leq2^{r}}x_{j}\left\vert \Psi_{j}\right\rangle
\left\langle \Psi_{j}\right\vert ;\,x_{j}\in\mathbb{R}_{+,}1\leq j\leq2^{r}.
\end{equation}

\end{corollary}

\begin{corollary}%
\begin{equation}
X\in\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  \Leftrightarrow\left\langle \left.  \Psi\right\vert
X\Psi\right\rangle _{\mathcal{H}_{\mathcal{F}}}\geq0,\,\forall\Psi
\in\mathcal{H}_{\mathcal{F}}.
\end{equation}

\end{corollary}

\begin{corollary}%
\begin{equation}
\sum_{1\leq k\leq m}x_{k}X_{k}\in\mathcal{C}_{+}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  ;\,x_{k}\in\mathbb{R}_{+}%
,\,X_{k}\in\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  ;\,m\in\mathbb{N}.
\end{equation}

\end{corollary}

\begin{remark}
The sum of positive operators is positive i.e.
\begin{equation}
QQ^{\dagger}=\sum_{1\leq j\leq\kappa}Q_{j}Q_{j}^{\dagger}.
\end{equation}

\end{remark}

\begin{corollary}%
\begin{equation}
X\in\mathcal{C}_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  \Leftrightarrow\left\langle \left.  Y\right\vert
X\right\rangle _{\mathcal{F}}\geq0,\,\forall Y\in\mathcal{C}_{+}\left(
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  .
\end{equation}

\end{corollary}

\begin{corollary}%
\begin{equation}
Y\in\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  \Leftrightarrow\left\langle \left.  Y\right\vert
X\right\rangle _{\mathcal{F}}\geq0,\,\forall X\in\mathcal{C}_{+}\left(
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  .
\end{equation}

\end{corollary}

\begin{corollary}
$\mathcal{C}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  $ is the dual cone of $\mathcal{C}_{+}\left(  \mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ i.e.
\begin{equation}
\mathcal{C}_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  ^{d}=\mathcal{C}_{+}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  .
\end{equation}

\end{corollary}

\begin{definition}
The polar cone $\mathcal{C}_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  ^{0}$ of $\mathcal{C}_{+}\left(
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  $ is the
negative of the dual cone $\mathcal{C}_{+}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ i.e.
\begin{equation}
\mathcal{C}_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  ^{0}=-\mathcal{C}_{+}\left(  \mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  ^{d}=-\mathcal{C}_{+}\left(
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  .
\end{equation}

\end{definition}

\begin{definition}
The convex set of normal states $S_{\text{normal}}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ of $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ is defined by
\begin{equation}
S_{\text{normal}}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =\left\{  D\left\vert f_{I_{\mathcal{F}}}\left(  D\right)
=\left\langle \left.  I_{\mathcal{F}}\right\vert D\right\rangle _{\mathcal{F}%
}=\operatorname{Tr}\left\{  D\right\}  =1,\,D\in\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  ,\,D\geq0\right.  \right\}
\end{equation}

\end{definition}

\begin{remark}
$S_{\text{normal}}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  $ is a \emph{cross section} of the cone $\mathcal{C}%
_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)
.$
\end{remark}

\begin{definition}
A cone $\operatorname{Cone}\left(  \mathcal{S}\right)  $ is a \emph{subset
}$S$ of a vector space $\mathcal{V}$ such that for any two non-negative real
numbers $a,b$ and vectors $v_{1},v_{2}\in\operatorname{Cone}\left(
\mathcal{S}\right)  $, we have $av_{1}+bv_{2}\in$ $\operatorname{Cone}\left(
\mathcal{S}\right)  $. The cone of a finite vector set $S$,
$\operatorname{Cone}\left(  \mathcal{S}\right)  $--called a\emph{ polyhedral
}cone-- is defined by all the linear combinations with non-negative
coefficients of vectors in $V.$
\end{definition}

\begin{definition}
The Projection Cone at any $x\in\partial\mathcal{C}\left(  \mathcal{S}\right)
$ ( $x$ is a point on the boundary of the convex set $\mathcal{C}\left(
\mathcal{S}\right)  )$ is $\operatorname{Cone}\left(  \mathcal{S}_{x}\right)
$, where $S_{x}$ is the set of all the rays emerging from $x$ and containing
another point of $\mathcal{C}\left(  \mathcal{S}\right)  $.
\end{definition}

\begin{definition}
The Polar Cone of the Projection Cone at $x$, which is also called Normal Cone
at $x$, is defined by $\operatorname{Cone}(S_{Nx})$ where $S_{Nx}$ is the set
of normal vectors to all the supporting hyperplanes at $x$. The dimensionality
of the $\operatorname{Cone}(S_{Nx})$ at $x\in\partial\mathcal{C}\left(
\mathcal{S}\right)  $ determines the type of $x$. Specifically, if $C$ is a
$d$-dimensional closed convex set, then $x$ is
\end{definition}

\begin{enumerate}
\item a \emph{vertex},

\item a \emph{point} on a\emph{ }$p$\emph{-face},

\item \emph{a point on a facet} if dimensionality of $\operatorname{Cone}%
(S_{Nx})$ is, respectively, $d$, $(d-p)$ or $(d-1).$
\end{enumerate}

\begin{definition}
A linear map $M\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
\begin{equation}
M:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
is positive $\operatorname*{Iff}$
\begin{equation}
M:\operatorname{Cone}_{+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  \rightarrow\operatorname{Cone}_{+}\left(  \mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  .
\end{equation}

\end{definition}

\begin{remark}
\emph{Maps can be positive but still map elements outside of positive cones to
elements inside positive cones, this observation is the crucial fact that
yields the Representability and the }$N$-R\emph{epresentability}
\emph{problems. }
\end{remark}

\begin{lemma}%
\begin{equation}
L_{n}^{p}:\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \rightarrow
\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)
\end{equation}
is a positive linear map i.e.
\begin{equation}
L_{n}^{p}:\operatorname{Cone}_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
^{n}\right)  \right)  \rightarrow\operatorname{Cone}_{+}\left(  \mathcal{B}%
_{1}\left(  \mathcal{H}^{p}\right)  \right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
X\in\operatorname{Cone}_{+}\left(  \mathcal{B}\left(  \mathcal{V}\right)
\right)  \Leftrightarrow\left\{  \left\langle \left.  v\right\vert
Xv\right\rangle \geq0\,\forall v\in V\right\}  \Leftrightarrow\left\{
X=QQ^{\dagger}\right\}  \Leftrightarrow\left\{  X=\sum_{1\leq j\leq\binom
{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda_{j}\left\vert \Phi_{Xj}%
\right\rangle \left\langle \Phi_{Xj}\right\vert \right\}  .
\end{equation}


Let $X\in\mathcal{B}_{1+}\left(  \mathcal{H}^{n}\right)  \equiv
\operatorname{Cone}_{+}\left(  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)
\right)  $ then
\begin{gather}
\left\langle \left.  v\right\vert L_{n}^{p}\left(  X\right)  v\right\rangle
=\left\langle v\left\vert L_{n}^{p}\left(  \sum_{1\leq j\leq\binom{r}%
{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda_{j}\left\vert \Phi_{Xj}\right\rangle
\left\langle \Phi_{Xj}\right\vert \right)  v\right.  \right\rangle
\,=\left\langle v\left\vert \left(  \sum_{1\leq j\leq\binom{r}{n},\lambda
_{j}\in\mathbb{R}_{+}}\lambda_{j}L_{n}^{p}\left(  \left\vert \Phi
_{Xj}\right\rangle \left\langle \Phi_{Xj}\right\vert \right)  \right)
v\right.  \right\rangle \\
\quad\forall v\in\mathcal{H}^{p},\,\left\{  \Phi_{Xj}\in\mathcal{H}%
^{n},\,1\leq j\leq\binom{r}{n}\right\}
\end{gather}
and%
\begin{gather}
\left\langle v\left\vert \left(  \sum_{1\leq j\leq\binom{r}{n},\lambda_{j}%
\in\mathbb{R}_{+}}\lambda_{j}L_{n}^{p}\left(  \left\vert \Phi_{Xj}%
\right\rangle \left\langle \Phi_{Xj}\right\vert \right)  \right)  v\right.
\right\rangle \\
\parallel\\
=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle v\left\vert \left(  L_{n}^{p}\left(  \left\vert \Phi
_{Xj}\right\rangle \left\langle \Phi_{Xj}\right\vert \right)  \right)
v\right.  \right\rangle _{\mathcal{H}^{p}}=\sum_{1\leq j\leq\binom{r}%
{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda_{j}\operatorname{Tr}_{\mathcal{H}%
^{p}}\left\{  \left\vert v\right\rangle \left\langle v\right\vert L_{n}%
^{p}\left(  \left\vert \Phi_{Xj}\right\rangle \left\langle \Phi_{Xj}%
\right\vert \right)  \right\} \\
=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\operatorname{Tr}_{\mathcal{H}^{p}}\left\{  \Gamma_{p}^{n}\left(
\left\vert v\right\rangle \left\langle v\right\vert \right)  \left\vert
\Phi_{Xj}\right\rangle \left\langle \Phi_{Xj}\right\vert \right\}
=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \Phi_{Xj}\left\vert \Gamma_{p}^{n}\left(  \left\vert
v\right\rangle \left\langle v\right\vert \right)  \Phi_{Xj}\right.
\right\rangle _{\mathcal{H}^{n}}\\
=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \Phi_{Xj}\left\vert \mathcal{A}_{n}\left(  \left\vert
v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}^{n}%
-\mathcal{H}^{p}}\right)  \mathcal{A}_{n}\Phi_{Xj}\right.  \right\rangle
_{\mathcal{H}^{n}}=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}%
}\lambda_{j}\left\langle \mathcal{A}_{n}\Phi_{Xj}\left\vert \left(  \left\vert
v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}^{n}%
-\mathcal{H}^{p}}\right)  \mathcal{A}_{n}\Phi_{Xj}\right.  \right\rangle
_{\mathcal{H}^{n}}\\
=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \mathcal{A}_{n}\Phi_{Xj}\left\vert \left(  \left\vert
v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}^{n}%
-\mathcal{H}^{p}}\right)  \mathcal{A}_{n}\Phi_{Xj}\right.  \right\rangle
_{\mathcal{H}^{n\otimes}}=\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}%
\in\mathbb{R}_{+}}\lambda_{j}\left\langle \mathcal{\Psi}_{Xj}\left\vert
\left(  \left\vert v\right\rangle \left\langle v\right\vert \otimes
P_{\mathcal{H}^{n}-\mathcal{H}^{p}}\right)  \mathcal{\Psi}_{Xj}\right.
\right\rangle _{\mathcal{H}^{n\otimes}}.
\end{gather}


\begin{remark}%
\begin{align}
\left(  A\otimes B\right)  \circ\left(  C\otimes D\right)   &  =\left(  A\circ
C\right)  \otimes\left(  B\circ D\right) \\
\left(  A\otimes B\right)  ^{\dagger}  &  =A^{\dagger}\otimes B^{\dagger}%
\end{align}

\end{remark}

\emph{hence}
\begin{equation}
\left(  \left\vert v\right\rangle \left\langle v\right\vert \otimes
P_{\mathcal{H}^{n-p}}\right)  \circ\left(  \left\vert v\right\rangle
\left\langle v\right\vert \otimes P_{\mathcal{H}^{n-p}}\right)  =\left(
\left\vert v\right\rangle \left\langle v\right\vert \circ\left\vert
v\right\rangle \left\langle v\right\vert \right)  \otimes\left(
P_{\mathcal{H}^{n-p}}\circ P_{\mathcal{H}^{n-p}}\right)  =\left\vert
v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}^{n-p}}%
\end{equation}
and
\begin{equation}
\left(  \left\vert v\right\rangle \left\langle v\right\vert \otimes
P_{\mathcal{H}^{n-p}}\right)  ^{\dagger}=\left\vert v\right\rangle
\left\langle v\right\vert ^{\dagger}\otimes P_{\mathcal{H}^{n-p}}^{\dagger
}=\left\vert v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}%
^{n-p}},
\end{equation}
so $\left\vert v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}%
^{n-p}}$ is an orthogonal projector.

Thus
\begin{equation}
\sum_{1\leq j\leq\binom{r}{n},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \mathcal{\Psi}_{Xj}\left\vert \left(  \left\vert
v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}^{n}%
-\mathcal{H}^{p}}\right)  \mathcal{\Psi}_{Xj}\right.  \right\rangle
_{\mathcal{H}^{n\otimes}}\geq0
\end{equation}
as $\left\vert v\right\rangle \left\langle v\right\vert \otimes P_{\mathcal{H}%
^{n-p}}$ is an orthogonal projector. Hence
\begin{equation}
\left\langle \left.  v\right\vert L_{n}^{p}\left(  X\right)  v\right\rangle
\geq0,\,\forall v\in\mathcal{H}^{p}\,
\end{equation}
and the theorem is proven.

\begin{remark}
$L_{n}^{p}$ is not positively surjective i.e.
\begin{equation}
Y\in\mathcal{B}_{1+}\left(  \mathcal{H}^{p}\right)  \nRightarrow Y=L_{n}%
^{p}\left(  X\right)  \text{ for some }X\in\mathcal{B}_{1+}\left(
\mathcal{H}^{n}\right)  ,
\end{equation}
but it is linearely surjective i.e.
\begin{equation}
L_{n}^{p}\left\{  \mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  \right\}
=\mathcal{B}_{1}\left(  \mathcal{H}^{p}\right)  .
\end{equation}

\end{remark}

\begin{remark}
Let $X<0\in\ker\left\{  L_{n}^{p}\right\}  $, $X+\alpha Y<0$ and
$Y\in\mathcal{B}_{1+}\left(  \mathcal{H}^{p}\right)  $ then $L_{n}^{p}\left(
X+\alpha Y\right)  \in\mathcal{B}_{1+}\left(  \mathcal{H}^{p}\right)  .$
\end{remark}

\begin{remark}
$\operatorname{Cone}_{+}\left(  \mathcal{B}\left(  \mathcal{H}^{p}\right)
\right)  \subset\mathcal{B}_{sa}\left(  \mathcal{H}^{p}\right)  $ and
$\mathcal{B}_{sa}\left(  \mathcal{H}^{p}\right)  $ are respectively a Jordan
algebra and a real vector space.
\end{remark}
\end{proof}

\begin{lemma}%
\begin{equation}
\Gamma_{p}^{n}:\mathcal{B}\left(  \mathcal{H}^{p}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
is a \emph{positive linear map} i.e. $\Gamma_{p}^{n}:\operatorname{Cone}%
_{+}\left(  \mathcal{B}\left(  \mathcal{H}^{p}\right)  \right)  \rightarrow
\operatorname{Cone}_{+}\left(  \mathcal{B}\left(  \mathcal{H}^{n}\right)
\right)  .$
\end{lemma}

\begin{proof}
Let $X_{p}\in\mathcal{B}_{+}\left(  \mathcal{H}^{p}\right)  $ and consider
\begin{equation}
\Gamma_{p}^{n}\left(  X_{p}\right)  =X_{p}\boxtimes P_{\mathcal{H}^{n-p}%
}=\mathcal{A}_{n}X_{p}\otimes P_{\mathcal{H}^{n-p}}\mathcal{A}_{n}%
\in\mathcal{B}\left(  \mathcal{H}^{n}\right)  \subset\mathcal{B}\left(
\mathcal{H}^{n\otimes}\right)
\end{equation}
then
\begin{align}
&  \left\langle \left.  v\right\vert \Gamma_{p}^{n}\left(  X_{p}\right)
v\right\rangle _{\mathcal{H}^{n}}\ =\operatorname{Tr}_{\mathcal{H}^{n}%
}\left\{  \left\vert v\right\rangle \left\langle v\right\vert \Gamma_{p}%
^{n}\left(  X_{p}\right)  \right\}  =\operatorname{Tr}_{\mathcal{H}^{n}%
}\left\{  \left\vert v\right\rangle \left\langle v\right\vert \sum_{1\leq
j\leq\binom{r}{p},\lambda_{j}\in\mathbb{R}_{+}}\lambda_{j}\Gamma_{p}%
^{n}\left(  \left\vert \Phi_{Xpj}\right\rangle \left\langle \Phi
_{Xpj}\right\vert \right)  \right\} \\
&  =\sum_{1\leq j\leq\binom{r}{p},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \overset{}{v}\left\vert \left(  \Gamma_{p}^{n}\left(
\overset{}{\left\vert \Phi_{Xpj}\right\rangle \left\langle \Phi_{Xpj}%
\right\vert }\right)  \right)  \overset{}{v}\right.  \right\rangle
=\sum_{1\leq j\leq\binom{r}{p},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \overset{}{v}\left\vert \left(  \overset{}{\mathcal{A}%
_{n}\left(  \left\vert \Phi_{Xpj}\right\rangle \left\langle \Phi
_{Xpj}\right\vert \otimes P_{\mathcal{H}^{n-p}}\right)  \mathcal{A}_{n}%
}\right)  \overset{}{v}\right.  \right\rangle \\
&  =\sum_{1\leq j\leq\binom{r}{p},\lambda_{j}\in\mathbb{R}_{+}}\lambda
_{j}\left\langle \mathcal{A}_{n}\overset{}{v}\left\vert \left(
\overset{}{\left(  \left\vert \Phi_{Xpj}\right\rangle \left\langle \Phi
_{Xpj}\right\vert \otimes P_{\mathcal{H}^{n-p}}\right)  }\right)
\mathcal{A}_{n}\overset{}{v}\right.  \right\rangle \geq0,
\end{align}
as $\left\{  \left\vert \Phi_{Xpj}\right\rangle \left\langle \Phi
_{Xpj}\right\vert \otimes P_{\mathcal{H}^{n-p}},1\leq j\leq\binom{r}%
{p}\right\}  $ are orthogonal projectors $\blacksquare$.
\end{proof}

\begin{remark}
$\Gamma_{p}^{n}$ is not linearly surjective i.e.
\begin{equation}
\Gamma_{p}^{n}\left\{  \mathcal{B}\left(  \mathcal{H}^{p}\right)  \right\}
\subset\mathcal{B}\left(  \mathcal{H}^{n}\right)  .
\end{equation}
but it is injective.
\end{remark}

\begin{remark}
$\Gamma_{p}^{n}$ is not positively surjective i.e.
\begin{equation}
Y\in\mathcal{B}_{1+}\left(  \mathcal{H}^{n}\right)  \nRightarrow Y=\Gamma
_{p}^{n}\text{ for some }X\in\mathcal{B}_{1+}\left(  \mathcal{H}^{p}\right)  .
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item Let $\mathcal{V}$ be a Hilbert space with direct sum decomposition into
orthogonal subspaces that have in general different dimensions
\begin{equation}
\mathcal{V}=%
%TCIMACRO{\tbigoplus \limits_{1\leq j\leq s}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{1\leq j\leq s}}
%EndExpansion
\mathcal{V}_{j}%
\end{equation}
so that
\begin{equation}
v=\sum_{1\leq j\leq s}v_{j}\leftrightarrow\left(
\begin{array}
[c]{ccc}%
v_{1} & \cdots & v_{s}%
\end{array}
\right)  ^{t}=\left(
\begin{array}
[c]{c}%
v_{1}\\
\vdots\\
v_{s}%
\end{array}
\right)  .
\end{equation}


\item The inner product $\left\langle \left.  v\right\vert w\right\rangle
_{\mathcal{V}}$ can be expressed as
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle _{\mathcal{V}}=\sum_{1\leq
j\leq s}\left\langle \left.  v_{j}\right\vert w_{j}\right\rangle
_{\mathcal{V}_{j}}=\left(
\begin{array}
[c]{ccc}%
\left\langle v_{1}\right\vert  & \cdots & \left\langle v_{s}\right\vert
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
w_{1} & \cdots & w_{s}%
\end{array}
\right)  ^{t}=\left(
\begin{array}
[c]{ccc}%
\left\langle v_{1}\right\vert  & \cdots & \left\langle v_{s}\right\vert
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
w_{1}\\
\vdots\\
w_{s}%
\end{array}
\right)  .
\end{equation}


\item Let $X\in\mathcal{B}\left(  \mathcal{V}\right)  $ then in terms of
partitioning induced by the direct sum decomposition of $\mathcal{V}$
\begin{equation}
X=\sum_{1\leq j,k\leq s}\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{jk}=\sum_{1\leq j,k\leq s}\left\vert \mathbf{\Phi}_{j}\right\rangle
\left\langle \mathbf{\Phi}_{k}\right\vert \mathcal{R}_{\boldsymbol{\varphi}%
}\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{jk}\right)
\end{equation}
and the action of $X$ can be expressed as
\begin{equation}
Xw=\sum_{1\leq j,k\leq s}\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{jk}\mathfrak{R}_{\boldsymbol{\Phi}}\left(  w\right)  _{k}=\sum_{1\leq j\leq
s}\mathfrak{R}_{\boldsymbol{\Phi}}\left(  y\right)  _{j}=y,
\end{equation}
where
\begin{equation}
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{jk}\in\mathcal{B}\left(
\mathcal{V}_{j},\mathcal{V}_{k}\right)
\end{equation}
and%
\begin{equation}
\mathcal{R}_{\boldsymbol{\varphi}}\left(  \mathfrak{R}_{\boldsymbol{\Phi}%
}\left(  y\right)  \right)  _{j}=\sum_{1\leq k\leq s}\mathcal{R}%
_{\boldsymbol{\varphi}}\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(
X\right)  \right)  _{jk}\mathcal{R}_{\boldsymbol{\varphi}}\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  w\right)  \right)  _{k},\,1\leq j\leq
s.
\end{equation}


\begin{example}
$j=2$

\begin{enumerate}
\item Direct sum decomposition%
\begin{equation}
\mathcal{V}=\mathcal{V}_{1}\oplus\mathcal{V}_{2}%
\end{equation}


\item Dimensions%
\begin{align}
\dim\left\{  \mathcal{V}\right\}   &  =5\\
\dim\left\{  \mathcal{V}_{1}\right\}   &  =3\\
\dim\left\{  \mathcal{V}_{2}\right\}   &  =2.
\end{align}


\item
\begin{equation}
