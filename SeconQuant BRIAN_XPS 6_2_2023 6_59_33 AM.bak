and
\begin{align}
&  \left\langle \left.  L\left(  \overset{}{\left\vert \overset{}{\varphi
_{k_{1}}\varphi_{k_{2}}}\right\rangle \left\langle \overset{}{\varphi_{l_{1}%
}\varphi_{l_{2}}}\right\vert }\right)  \right\vert \left\vert
\overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle \left\langle
\overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert \right\rangle
_{\mathcal{F}}\\
&  =\left\langle \left.  \sum_{0\leq p\leq6}\binom{2}{p}L_{2}^{p}\left(
