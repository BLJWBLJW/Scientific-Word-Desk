\right\vert \left\vert \overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}%
}\right\rangle \left\langle \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}%
}\right\vert \right\rangle _{\mathcal{F}}=0,
