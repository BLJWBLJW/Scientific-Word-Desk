^{0}\left(  X_{e2}\right)  -L_{1}^{0}\left(  X_{e1}\right)  +L_{0}^{0}\left(
X_{e0}\right) \\
4L_{4}^{1}\left(  X_{e4}\right)  -3L_{3}^{1}\left(  X_{e3}\right)  +2L_{2}%
^{1}\left(  X_{e2}\right)  -L_{1}^{1}\left(  X_{e1}\right) \\
12L_{4}^{2}\left(  X_{e4}\right)  -3L_{3}^{2}\left(  X_{e3}\right)  +L_{2}%
^{2}\left(  X_{e2}\right) \\
4L_{4}^{3}\left(  X_{e4}\right)  -L_{3}^{3}\left(  X_{e3}\right) \\
L_{4}^{4}\left(  X_{e4}\right) \\
0\\
\vdots\\
0
\end{array}
\right)  $ \emph{may or may not} be positive.
