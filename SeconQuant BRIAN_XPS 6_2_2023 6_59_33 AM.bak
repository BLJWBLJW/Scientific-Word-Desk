{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right)  \nrightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  .
\end{equation}

\end{remark}

\begin{definition}
The \emph{mixed exterior} algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ formed from $\mathcal{X=}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $ and $\mathcal{Y=}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ is generated by the \emph{mixed exterior algebra}
product "${\large \cdot}$"
\begin{equation}
{\Large \cdot:}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right)  \times\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right)  \rightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  ,
\end{equation}
\underline{that is defined by} the
\end{definition}

\begin{definition}%
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}^{d}\right)  {\Large \cdot}\left(  x_{p_{2}%
}\otimes y_{q_{2}}^{d}\right)  =\left(  +1\right)  ^{p_{2}q_{1}}\left(
x_{p_{1}}\wedge x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}^{d}\wedge y_{q_{2}%
}^{d}\right)  .
\end{equation}
If $V$ is a Hilbert space this can be recast as
\begin{align}
\left(  \left\vert x_{p_{1}}\right\rangle \otimes\left\langle y_{q_{1}%
}\right\vert \right)  {\Large \cdot}\left(  \left\vert x_{p_{2}}\right\rangle
\otimes\left\langle y_{q_{2}}\right\vert \right)   &  =\left(  +1\right)
^{p_{2}q_{1}}\left(  \left\vert x_{p_{1}}\right\rangle \wedge\left\vert
x_{p_{2}}\right\rangle \right)  \otimes\left(  \left\langle y_{q_{1}%
}\right\vert \wedge\left\langle y_{q_{2}}\right\vert \right) \\
&  \parallel\\
\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert
{\Large \cdot}\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}%
}\right\vert  &  =\left(  +1\right)  ^{p_{2}q_{1}}\left(  \left\vert x_{p_{1}%
}\right\rangle \wedge\left\vert x_{p_{2}}\right\rangle \right)  \otimes\left(
\left\langle y_{q_{1}}\right\vert \wedge\left\langle y_{q_{2}}\right\vert
\right) \\
&  \parallel\\
\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert
{\Large \cdot}\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}%
}\right\vert  &  =\left(  +1\right)  ^{p_{2}q_{1}}\left\vert x_{p_{1}}\wedge
x_{p_{2}}\right\rangle \otimes\left\langle y_{q_{1}}\wedge y_{q_{2}%
}\right\vert .
\end{align}

\end{definition}

\begin{itemize}
\item In the\emph{ }$\mathbb{N}$-\emph{graded tensor product space
}$\mathcal{X}\otimes\mathcal{Y}$ of two $\mathbb{N}$-graded algebras
$\mathcal{X}$ and $\mathcal{Y}$ \emph{one can define a \underline{\emph{skew}}
multiplication} $@_{XY}$ \emph{ }%
\begin{equation}
@_{\mathcal{XY}}:\left(  \mathcal{X}\otimes\mathcal{Y}\right)  \times\left(
\mathcal{X}\otimes\mathcal{Y}\right)  \rightarrow\mathcal{X}\otimes
\mathcal{Y},
\end{equation}
by
\end{itemize}

\begin{definition}
The \emph{skew product }$\equiv$ \emph{anticommutative multiplication
"}$@_{\mathcal{XY}}$" is defined by
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \left[  @_{\mathcal{XY}}\right]
\left(  x_{p_{2}}\otimes y_{q_{2}}\right)  =\left(  -1\right)  ^{p_{2}q_{1}%
}\left(  x_{p_{1}}\left[  \cdot_{_{\mathcal{X}}}\right]  x_{p_{2}}\right)
\otimes\left(  y_{q_{1}}\left[  \cdot_{_{\mathcal{Y}}}\right]  y_{q_{2}%
}\right)  ,
\end{equation}
where
\begin{align}
p_{2}  &  =\deg\left(  x_{p_{2}}\right) \\
q_{1}  &  =\deg\left(  y_{q_{1}}\right)
\end{align}
and "$\cdot_{_{\mathcal{X}}}",$"$\cdot_{_{\mathcal{Y}}}"$ are the operations
of multiplication in the algebras $\mathcal{X}$ and $\mathcal{Y}$ respectively.
\end{definition}

\begin{notation}
The\emph{ tensor product space }$\mathcal{X}\otimes\mathcal{Y}$ equipped with
the skew product \emph{"}$@_{\mathcal{XY}}$" is called the \emph{skew tensor
product} $\mathcal{X\widehat{\otimes}Y}$ of the two $\mathbb{N}$-graded
algebras $\mathcal{X}$ and $\mathcal{Y}$ \emph{and is a} $\mathbb{N}$-graded algebra.
\end{notation}

\begin{example}
In the case of exterior algebras $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $ and $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ this becomes%
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @_{{\small VV}^{d}}\left(
x_{p_{2}}\otimes y_{q_{2}}\right)  \equiv\left(  -1\right)  ^{p_{2}q_{1}%
}\left(  x_{p_{1}}\wedge x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}\wedge
y_{q_{2}}\right)  ,\quad x_{p_{1}},x_{p_{2}}\in%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  ,y_{q_{1}},y_{q_{2}}\in%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  ,
\end{equation}
where
\begin{equation}
@_{{\small VV}^{d}}:\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right)  \times\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right)  \rightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  .
\end{equation}
If $V$ is a Hilbert space this can be recast as
\begin{equation}
\left(  \left\vert x_{p_{1}}\right\rangle \otimes\left\langle y_{q_{1}%
}\right\vert \right)  @_{{\small VV}^{d}}\left(  \left\vert x_{p_{2}%
}\right\rangle \otimes\left\langle y_{q_{2}}\right\vert \right)  =\left(
-1\right)  ^{p_{2}q_{1}}\left(  \left\vert x_{p_{1}}\right\rangle
\wedge\left\vert x_{p_{2}}\right\rangle \right)  \otimes\left(  \left\langle
y_{q_{1}}\right\vert \wedge\left\langle y_{q_{2}}\right\vert \right)  =\left(
-1\right)  ^{p_{2}q_{1}}\left\vert x_{p_{1}}\wedge x_{p_{2}}\right\rangle
\otimes\left\langle y_{q_{1}}\wedge y_{q_{2}}\right\vert .
\end{equation}

\end{example}

\begin{itemize}
\item Let
\begin{gather}
x_{1}\otimes y_{1}\in\mathcal{X}\ \otimes\mathcal{Y}\\
x_{2}\otimes y_{2}\in\mathcal{X}\ \otimes\mathcal{Y}\\
x_{1},x_{2}\in\mathcal{X},\quad y_{1},y_{2}\in\mathcal{Y},
\end{gather}


\item
\begin{align}
p_{2}  &  =\deg\left(  x_{2}\right) \\
q_{1}  &  =\deg\left(  y_{1}\right)  ,
\end{align}

\end{itemize}

\begin{definition}
\begin{itemize}
\item "$@_{\mathcal{XY}}",$ "$\cdot_{_{X}}"$ and "$\cdot_{y}",$ are the
algebraic products in the vector spaces $\mathcal{X\widehat{\otimes}Y\equiv
}\operatorname{linearspace}\left\{  \mathcal{X}\ \otimes\mathcal{Y}\right\}
,$ $\mathcal{X}$ and $\mathcal{Y}$ respectively and $\otimes$ is the normal
tensor product.

\item The tensor product of graded algebras produce graded algebras.

\item If $\mathcal{X}$ and $\mathcal{Y}$ are tensor algebras then the
algebraic products can be the tensor product i.e.,%
\begin{equation}
\cdot_{_{\mathcal{X}}}=\otimes
\end{equation}
and
\begin{equation}
\cdot_{_{\mathcal{Y}}}=\otimes.
\end{equation}


\item If they are exterior algebras then the algebraic products can be their
exterior products i.e,%
\begin{equation}
\cdot_{_{\mathcal{X}}}=\wedge
\end{equation}
and
\begin{equation}
\cdot_{_{\mathcal{Y}}}=\wedge.
\end{equation}

\end{itemize}
\end{definition}

\begin{remark}
The products $@_{{\small VV}^{d}}$ and $\bullet$ in the mixed exterior
algebras $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ and $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \,\widehat{\otimes}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  $ are related by
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @_{{\small VV}^{d}}\left(
x_{p_{2}}\otimes y_{q_{2}}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(
x_{p_{1}}\otimes y_{q_{1}}\right)  {\Large \cdot}\left(  x_{p_{2}}\otimes
y_{q_{2}}\right)  .
\end{equation}

\end{remark}

\begin{example}
Let
\begin{align}
p_{2}  &  =\deg\left(  x_{2}\right)  =1\\
q_{1}  &  =\deg\left(  y_{1}\right)  =1
\end{align}
and
\begin{align}
p_{1}  &  =\deg\left(  x_{1}\right)  =0\\
q_{2}  &  =\deg\left(  y_{2}\right)  =0
\end{align}
then the skew product $@_{\mathcal{XY}}$ is related to the tensor product
$\otimes$ in $\mathcal{X}\ \otimes\mathcal{Y}$ by
\begin{equation}
\left(  I_{\mathcal{X}}\otimes y_{1}\right)  @_{\mathcal{XY}}\left(
x_{2}\otimes I_{\mathcal{Y}}\right)  =-\left(  I_{\mathcal{X}}\left(
\cdot_{_{X}}\right)  x_{2}\right)  \otimes\left(  y_{1}\left(  \cdot
_{y}\right)  I_{\mathcal{Y}}\right)  \
\end{equation}
giving
\begin{equation}
\left(  I_{\mathcal{X}}\otimes y_{1}\right)  @_{\mathcal{XY}}\left(
x_{2}\otimes I_{\mathcal{Y}}\right)  =-x_{2}\otimes y_{1}.
\end{equation}

\end{example}

\begin{example}
Let
\begin{align}
q  &  =\deg\left(  \left\vert x_{q}^{\prime}\right\rangle \right)  =1\\
p  &  =\deg\left(  \left\vert y_{p}^{d}\right\rangle \right)  =1
\end{align}
and
\begin{align}
\cdot_{_{\mathcal{X}}}  &  =\wedge\\
\cdot_{_{\mathcal{Y}}}  &  =\wedge
\end{align}
then the skew tensor product, "$@"\,\equiv@_{\mathcal{H}^{1}\mathcal{H}^{1d}}$
in ${\LARGE \wedge}\left(  \mathcal{H}^{1}\right)  \,\widehat{\otimes
}\,{\LARGE \wedge}\left(  \mathcal{H}^{1d}\right)  ,$ has the property
\begin{gather}
\left(  \left\vert x\right\rangle \otimes\left\vert y^{d}\right\rangle
\right)  @\left(  \left\vert x^{\prime}\right\rangle \otimes\left\vert
y^{\prime d}\right\rangle \right)  \overset{\triangle}{=}\left(  -1\right)
^{1}\left\vert x\wedge x^{\prime}\right\rangle \otimes\left\vert y^{d}\wedge
y^{\prime d}\right\rangle \\
\parallel\parallel\\
\left(  \left\vert x\right\rangle \otimes\left\langle y\right\vert \right)
@\left(  \left\vert x^{\prime}\right\rangle \otimes\left\langle y^{\prime
}\right\vert \right)  =\left(  -1\right)  ^{1}\left\vert x\wedge x^{\prime
}\right\rangle \otimes\left\langle y\wedge y^{\prime}\right\vert \\
\parallel\parallel\\
\left(  \left\vert x\right\rangle \otimes\left\langle y\right\vert \right)
@\left(  \left\vert x^{\prime}\right\rangle \otimes\left\langle y^{\prime
}\right\vert \right)  =-\left\vert x\wedge x^{\prime}\right\rangle
\otimes\left\langle y\wedge y^{\prime}\right\vert \\
\parallel\parallel\\
\left\vert x\right\rangle \otimes\left\langle y\right\vert @\left\vert
x^{\prime}\right\rangle \otimes\left\langle y^{\prime}\right\vert =-\left(
\left\vert x\right\rangle \otimes\left\langle y\right\vert \right)
{\Large \cdot}\left(  \left\vert x^{\prime}\right\rangle \otimes\left\langle
y^{\prime}\right\vert \right)  =-\left(  \left\vert x\wedge x^{\prime
}\right\rangle \otimes\left\langle y\wedge y^{\prime}\right\vert \right)  .
\end{gather}

\end{example}

\begin{remark}
In the exterior algebra ${\huge \wedge}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)  $ one has in particular
\begin{align}
\left(  \overset{}{\left\vert x\wedge x_{p}^{\prime}\right\rangle }\right)
\wedge\left(  \overset{}{\left\vert y_{q}^{d}\wedge y^{\prime d}\right\rangle
}\right)   &  =\left(  \overset{}{\left\vert x\right\rangle \wedge\left\vert
x_{p}^{\prime}\right\rangle }\right)  \wedge\left(  \overset{}{\left\vert
y_{q}^{d}\right\rangle \wedge\left\vert y^{\prime d}\right\rangle }\right)
=\left\vert x\right\rangle \wedge\left\vert x_{p}^{\prime}\right\rangle
\wedge\left\vert y_{q}^{d}\right\rangle \wedge\left\vert y^{\prime
d}\right\rangle \\
&  =\left(  -1\right)  ^{pq}\left(  \overset{}{\left\vert x\right\rangle
\wedge\left\vert y_{q}^{d}\right\rangle }\right)  \wedge\left(
\overset{}{\left\vert x_{p}^{\prime}\right\rangle \wedge\left\vert y^{\prime
d}\right\rangle }\right)  =\left(  -1\right)  ^{pq}\left(
\overset{}{\left\vert x\right\rangle \wedge\left\langle y_{q}\right\vert
}\right)  \wedge\left(  \overset{}{\left\vert x_{p}^{\prime}\right\rangle
\wedge\left\langle y^{\prime}\right\vert }\right)  ,
\end{align}
i.e.
\begin{equation}
\left(  \overset{}{\left\vert x\right\rangle \wedge\left\langle y_{q}%
\right\vert }\right)  \wedge\left(  \overset{}{\left\vert x_{p}^{\prime
}\right\rangle \wedge\left\langle y^{\prime}\right\vert }\right)  =\left(
-1\right)  ^{pq}\left(  \overset{}{\left\vert x\wedge x_{p}^{\prime
}\right\rangle }\right)  \wedge\left(  \overset{}{\left\vert y_{q}^{d}\wedge
y^{\prime d}\right\rangle }\right)  .
\end{equation}

\end{remark}

