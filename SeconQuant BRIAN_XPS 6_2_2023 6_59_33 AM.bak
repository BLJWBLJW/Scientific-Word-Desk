_{\mathcal{F}}=\overline{\left\langle \left.  \overset{}{\left\vert
\overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle \left\langle
\overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert }\right\vert
L\left(  \overset{}{\left\vert \overset{}{\varphi_{k_{1}}\varphi_{k_{2}}%
}\right\rangle \left\langle \overset{}{\varphi_{l_{1}}\varphi_{l_{2}}%
}\right\vert }\right)  \right\rangle _{\mathcal{F}}},
\end{equation}
which shows that
\begin{equation}
\left\langle \left.  \overset{}{\left\vert \overset{}{\varphi_{i_{1}}%
\cdots\varphi_{i_{4}}}\right\rangle \left\langle \overset{}{\varphi_{j_{1}%
}\cdots\varphi_{j_{4}}}\right\vert }\right\vert L\left(  \overset{}{\left\vert
\overset{}{\varphi_{k_{1}}\varphi_{k_{2}}}\right\rangle \left\langle
\overset{}{\varphi_{l_{1}}\varphi_{l_{2}}}\right\vert }\right)  \right\rangle
=0.
\end{equation}

\end{example}

\begin{example}%
\begin{align}
\mathcal{R}_{\varphi}\left(  L\right)  _{k_{1}k_{2}l_{1}l_{2}i_{1}\cdots
i_{4}j_{1}\cdots j_{4}}  &  =\left\langle \left.  \overset{}{\left\vert
\overset{}{\varphi_{k_{1}}\varphi_{k_{2}}}\right\rangle \left\langle
\overset{}{\varphi_{l_{1}}\varphi_{l_{2}}}\right\vert }\right\vert L\left(
\left\vert \overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle
\left\langle \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert
\right)  \right\rangle _{\mathcal{F}}\\
&  =\overline{\mathcal{R}_{\varphi}\left(  L\right)  }_{i_{1}\cdots i_{4}%
j_{1}\cdots j_{4}k_{1}k_{2}l_{1}l_{2}}\\
&  =\left\langle \left.  \Gamma\left(  \overset{}{\left\vert
\overset{}{\varphi_{k_{1}}\varphi_{k_{2}}}\right\rangle \left\langle
\overset{}{\varphi_{l_{1}}\varphi_{l_{2}}}\right\vert }\right)  \right\vert
\left\vert \overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle
\left\langle \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert
\right\rangle _{\mathcal{F}}\\
&  =\overline{\left\langle \left.  \overset{}{\left\vert \overset{}{\varphi
_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle \left\langle \overset{}{\varphi
_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert }\right\vert \Gamma\left(
\overset{}{\left\vert \overset{}{\varphi_{k_{1}}\varphi_{k_{2}}}\right\rangle
\left\langle \overset{}{\varphi_{l_{1}}\varphi_{l_{2}}}\right\vert }\right)
\right\rangle _{\mathcal{F}}}\\
&  =\overline{\mathcal{R}_{\varphi}\left(  \Gamma\right)  }_{i_{1}\cdots
i_{4}j_{1}\cdots j_{4}k_{1}k_{2}l_{1}l_{2}}=\overline{\mathcal{R}_{\varphi
}\left(  L^{\dagger}\right)  }_{i_{1}\cdots i_{4}j_{1}\cdots j_{4}k_{1}%
k_{2}l_{1}l_{2}}.
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\left\langle \left.  \overset{}{\left\vert \overset{}{\varphi_{k_{1}}%
\varphi_{k_{2}}}\right\rangle \left\langle \overset{}{\varphi_{l_{1}}%
\varphi_{l_{2}}}\right\vert }\right\vert L\left(  \left\vert
\overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle \left\langle
\overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert \right)
\right\rangle _{\mathcal{F}}=\left\langle \left.  \Gamma\left(
\overset{}{\left\vert \overset{}{\varphi_{k_{1}}\varphi_{k_{2}}}\right\rangle
\left\langle \overset{}{\varphi_{l_{1}}\varphi_{l_{2}}}\right\vert }\right)
\right\vert \left\vert \overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}%
}\right\rangle \left\langle \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}%
}\right\vert \right\rangle _{\mathcal{F}}.
\end{equation}

\end{remark}

\begin{remark}
Recall \emph{ }%
\begin{equation}
\left\langle \left.  \Gamma\left(  X\right)  \right\vert Y\right\rangle
_{\mathcal{F}}=\left\langle \left.  X\right\vert L\left(  Y\right)
\right\rangle _{\mathcal{F}};X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e},Y\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}.
\end{equation}
If
\begin{equation}
Y\geq0\text{ and }Y\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}%
\end{equation}
then
\begin{equation}
Y=QQ^{\dagger}\geq0;\,Q,Q^{\dagger}\in\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}.
\end{equation}

\end{remark}

\begin{remark}
The maps
\begin{equation}
\Gamma\circ L=\Gamma\circ\Gamma^{\dagger}=L^{\dagger}\circ L:\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\rightarrow\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
and
\begin{equation}
L\circ\Gamma=\Gamma^{\dagger}\circ\Gamma=L\circ L^{\dagger}:\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\rightarrow\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
are \emph{self adjoint and positive. }
\end{remark}

\begin{remark}
$\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\subset
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ and $L$ is only
defined on $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$.
$\Gamma$ does not preserve trace, so $L\circ\Gamma$ is not well defined.
\end{remark}

\begin{example}
In general%
\begin{equation}
M_{jk}=\sum_{0\leq l\leq r}A_{jl}B_{lk}%
\end{equation}
for triangular matrices $A$ and $B$ non zero matrix elements are in the range
\begin{equation}
l\text{ }\leq j\text{ and }l\leq k
\end{equation}
thus%
\begin{align}
\left(  \Gamma\circ L\right)  _{jk}  &  =\sum_{0\leq l\leq r}\Gamma_{l}%
^{j}L_{k}^{l}=\sum_{0\leq l\leq\min\left(  j,k\right)  }\Gamma_{l}^{j}%
L_{k}^{l}\\
\left(  \Gamma\circ L\right)  _{12}  &  =\sum_{0\leq l\leq1}\Gamma_{l}%
^{1}L_{2}^{l}=\Gamma_{0}^{1}L_{2}^{0}+\Gamma_{1}^{1}L_{2}^{1}\\
\left(  \Gamma\circ L\right)  _{21}  &  =\sum_{0\leq l\leq1}\Gamma_{l}%
^{2}L_{1}^{l}=\Gamma_{0}^{2}L_{1}^{0}+\Gamma_{1}^{2}L_{1}^{1}\\
\left(  \Gamma\circ L\right)  _{22}  &  =\sum_{0\leq l\leq2}\Gamma_{l}%
^{2}L_{2}^{l}=\Gamma_{0}^{2}L_{2}^{0}+\Gamma_{1}^{2}L_{2}^{1}+\Gamma_{2}%
^{2}L_{2}^{2}\\
\left(  \Gamma\circ L\right)  _{24}  &  =\sum_{0\leq l\leq2}\Gamma_{l}%
^{2}L_{4}^{l}=\Gamma_{0}^{2}L_{4}^{0}+\Gamma_{0}^{2}L_{4}^{0}+\Gamma_{0}%
^{2}L_{4}^{0}%
\end{align}
and%
\begin{align}
\left(  \Gamma\circ L\right)  _{0r}  &  =\sum_{0\leq l\leq0}\Gamma_{l}%
^{0}L_{r}^{l}=\Gamma_{0}^{0}L_{r}^{0}\\
\left(  \Gamma\circ L\right)  _{r0}  &  =\sum_{0\leq l\leq0}\Gamma_{l}%
^{r}L_{0}^{l}=\Gamma_{0}^{r}L_{0}^{0}.
\end{align}

\end{example}

\begin{lemma}%
\begin{equation}
\left(  \Gamma\circ L\right)  _{jk}=\sum_{0\leq l\leq\min\left(  j,k\right)
}\Gamma_{l}^{j}L_{k}^{l}.
\end{equation}

\end{lemma}

\begin{example}%
\begin{equation}
\Gamma\circ L=L^{\dagger}\circ L=\left(
\begin{array}
[c]{ccccc}%
\Gamma_{0}^{0} & 0 & \cdots & \cdots & 0\\
\Gamma_{0}^{1} & \Gamma_{1}^{1} & 0 & \cdots & \vdots\\
\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \Gamma_{2}^{2} & 0 & \vdots\\
\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & \binom{3}{2}\Gamma_{2}^{3} &
\Gamma_{3}^{3} & 0\\
\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}\Gamma_{2}^{4} &
\binom{4}{3}\Gamma_{3}^{4} & \Gamma_{4}^{4}%
\end{array}
\right)  \,\left(
\begin{array}
[c]{ccccc}%
L_{0}^{0} & L_{1}^{0} & L_{2}^{0} & L_{3}^{0} & L_{4}^{0}\\
0 & L_{1}^{1} & \binom{2}{1}L_{2}^{1} & \binom{3}{1}L_{3}^{1} & \binom{4}%
{1}L_{4}^{1}\\
\vdots & 0 & L_{2}^{2} & \binom{3}{2}L_{3}^{2} & \binom{4}{2}L_{4}^{2}\\
\vdots & \cdots & \ddots & L_{3}^{3} & \binom{4}{3}L_{4}^{3}\\
0 & \cdots & \cdots & 0 & L_{4}^{4}%
\end{array}
\right)
\end{equation}
giving
\begin{equation}
\left(  \Gamma\circ L\right)  _{24}=\sum_{0\leq l\leq2}\Gamma_{l}^{2}L_{4}%
^{l}=\Gamma_{0}^{2}L_{4}^{0}+\Gamma_{1}^{2}L_{4}^{1}+\Gamma_{2}^{2}L_{4}^{2}.
\end{equation}

\end{example}

\begin{example}%
\begin{equation}
\left(  \Gamma\circ L\right)  \left(  D_{3}\right)  =\left(
\begin{array}
[c]{ccccc}%
\left(  \Gamma\circ L\right)  _{00} & \cdots & \cdots & \cdots & \left(
\Gamma\circ L\right)  _{04}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\left(  \Gamma\circ L\right)  _{40} & \cdots & \cdots & \cdots & \left(
\Gamma\circ L\right)  _{44}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
D_{3}\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\left(  \Gamma\circ L\right)  _{03}\left(  D_{3}\right) \\
\left(  \Gamma\circ L\right)  _{13}\left(  D_{3}\right) \\
\left(  \Gamma\circ L\right)  _{23}\left(  D_{3}\right) \\
\left(  \Gamma\circ L\right)  _{33}\left(  D_{3}\right) \\
\left(  \Gamma\circ L\right)  _{43}\left(  D_{3}\right)
\end{array}
\right)  .
\end{equation}

\end{example}

One can consider the polar decomposition of linear operators
\begin{equation}
A=U_{A}\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}%
\end{equation}
and obtain
\begin{align}
L  &  =U_{L}\left(  L^{\dagger}L\right)  ^{\frac{1}{2}}=U_{L}\left(  \Gamma
L\right)  ^{\frac{1}{2}}\\
\Gamma &  =U_{\Gamma}\left(  \Gamma^{\dagger}\Gamma\right)  ^{\frac{1}{2}%
}=U_{\Gamma}\left(  L\Gamma\right)  ^{\frac{1}{2}},
\end{align}
where
\begin{align}
L  &  \in\mathcal{B}\left(  \mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right) \\
\Gamma &  \in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right) \\
U_{L}  &  \in\mathcal{B}\left(  \mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right) \\
U_{\Gamma}  &  \in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \right)  .
\end{align}


\begin{remark}
$\Gamma$ and $L$ are invertible thus $U_{L}$ and $U_{\Gamma}$ are unitary wrt
the HS inner product in $\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  .$
\end{remark}

The polar decompositions lead to
\begin{equation}
\left\langle \left.  X\right\vert L\left(  Y\right)  \right\rangle
_{\mathcal{F}}=\left\langle \left.  \overset{}{X}\right\vert \left(
U_{L}\left(  \Gamma L\right)  ^{\frac{1}{2}}\right)  \left(  Y\right)
\right\rangle _{\mathcal{F}}=\left\langle \left.  U_{L}^{\dagger}\left(
\overset{}{X}\right)  \right\vert \left(  \Gamma L\right)  ^{\frac{1}{2}%
}\left(  Y\right)  \right\rangle _{\mathcal{F}}%
\end{equation}
and%
\begin{equation}
\left\langle \left.  \Gamma\left(  X\right)  \right\vert Y\right\rangle
_{\mathcal{F}}=\left\langle \left.  U_{\Gamma}\left(  L\Gamma\right)
^{\frac{1}{2}}\left(  \overset{}{X}\right)  \right\vert Y\right\rangle
_{\mathcal{F}}=\left\langle \left.  \left(  L\Gamma\right)  ^{\frac{1}{2}%
}\left(  \overset{}{X}\right)  \right\vert U_{\Gamma}^{\dagger}\left(
Y\right)  \right\rangle _{\mathcal{F}}.
\end{equation}


\begin{remark}%
\begin{equation}
E_{H}\left(  D_{N}\right)  =\left\langle \left.  H\right\vert L\left(
D_{N}\right)  \right\rangle _{\mathcal{F}}=\left\langle \left.  \overset{}{H}%
\right\vert \left(  U_{L}\left(  \Gamma L\right)  ^{\frac{1}{2}}\right)
\left(  D_{N}\right)  \right\rangle _{\mathcal{F}}=\left\langle \left.
U_{L}^{\dagger}\left(  \overset{}{H}\right)  \right\vert \left(  \Gamma
L\right)  ^{\frac{1}{2}}\left(  D_{N}\right)  \right\rangle _{\mathcal{F}}.
\end{equation}

\end{remark}

\section{Standard Second Quantization Map}

Let $T\in\mathcal{L}\left(  \mathcal{V}\right)  $ i.e. be a linear map
\begin{equation}
T:\mathcal{V}\rightarrow\mathcal{V}%
\end{equation}
then one can define an induced linear map%
\begin{equation}
R_{n}\left(  T\right)  :%
%TCIMACRO{\dbigwedge \nolimits^{n}}%
%BeginExpansion
{\displaystyle\bigwedge\nolimits^{n}}
%EndExpansion
\mathcal{V}\rightarrow%
%TCIMACRO{\dbigwedge \nolimits^{n}}%
%BeginExpansion
{\displaystyle\bigwedge\nolimits^{n}}
%EndExpansion
\mathcal{V}%
\end{equation}
by%
\begin{equation}
R_{n}\left(  T\right)  \left\vert \varphi_{1}\cdots\varphi_{n}\right\rangle
=T\mathcal{\boxtimes}\cdots\mathcal{\boxtimes}T\left\vert \varphi_{1}%
\cdots\varphi_{n}\right\rangle =\left\vert T\varphi_{1}\cdots T\varphi
_{n}\right\rangle
\end{equation}
and the induced map
\begin{equation}
R\left(  T\right)  :%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \mathcal{V}\right)  \rightarrow%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \mathcal{V}\right)
\end{equation}
by%
\begin{align}
R\left(  T\right)   &  =\sum_{0\leq n\leq r}R_{n}\left(  T\right) \\
R  &  =%
%TCIMACRO{\dbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
R_{n}.
\end{align}
If $T\in GL\left(  \mathcal{H}^{1}\right)  ,$ where we consider $\mathcal{V}%
=\mathcal{H}^{1},$ then
\begin{equation}
R\left(  T\right)  =\exp\left\{  dR\left(  \mathcal{T}\right)  \right\}
=\exp\left\{  \Gamma\left(  \mathcal{T}\right)  \right\}  =\exp\left\{
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
t_{jk}dR\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert \right)  \right\}  ,
\end{equation}
where
\begin{equation}
dR\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert \right)  =\Gamma\left(  \left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert \right)  .
\end{equation}
One should note that $\Gamma\left(  \mathcal{T}\right)  $ need not be bounded
even if $\mathcal{T}$ is. The map $dR=\Gamma$ is not an algebraic map on
$\Gamma\left(  \mathcal{H}\right)  $ i.e.
\begin{equation}
\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert \right)  \circ\Gamma\left(  \left\vert \varphi_{l}%
\right\rangle \left\langle \varphi_{m}\right\vert \right)  \neq\Gamma\left(
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
\circ\left\vert \varphi_{l}\right\rangle \left\langle \varphi_{m}\right\vert
\right)  ,
\end{equation}
so that in general
\begin{align}
T  &  =\exp\left\{  \mathcal{T}\right\} \\
\Gamma\left(  T\right)   &  \neq\exp\left\{  \Gamma\left(  \mathcal{T}\right)
\right\}  ,
\end{align}
but it is a Lie algebraic map as
\begin{equation}
dR\left(  \left[  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert ,\left\vert \varphi_{l}\right\rangle \left\langle \varphi
_{m}\right\vert \right]  \right)  =\Gamma\left(  \left[  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert ,\left\vert
\varphi_{l}\right\rangle \left\langle \varphi_{m}\right\vert \right]  \right)
=\left[  dR\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert \right)  ,dR\left(  \left\vert \varphi_{l}\right\rangle
\left\langle \varphi_{m}\right\vert \right)  \right]  =\left[  \Gamma\left(
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
\right)  ,\Gamma\left(  \left\vert \varphi_{l}\right\rangle \left\langle
\varphi_{m}\right\vert \right)  \right]  .
\end{equation}


\bigskip\appendix{}

The number operator is an unbounded self-adjoint operator in the complex
Hilbert space $\mathcal{H}$ for the quantum harmonic oscillator. There is
\emph{no real number} $K$ such that%
\begin{equation}
\left\Vert \mathcal{N}\left\vert n\right\rangle \right\Vert _{\mathcal{H}%
}<K\left\Vert \left\vert n\right\rangle \right\Vert _{\mathcal{H}}\quad\forall
n,
\end{equation}
where $\left\{  \left.  \left\vert n\right\rangle \right\vert n\in
\mathbb{N}\right\}  $ are the eigenvectors of the number operator i.e., the
eigenvalues of the number operator have no upper bound.

