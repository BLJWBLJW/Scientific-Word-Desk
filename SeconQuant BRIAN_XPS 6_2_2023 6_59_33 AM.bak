\right\rangle _{\mathcal{F}}\\
&  =\left\langle \left.  \overset{}{\left\vert \overset{}{\varphi_{k_{1}%
}\varphi_{k_{2}}}\right\rangle \left\langle \overset{}{\varphi_{l_{1}}%
\varphi_{l_{2}}}\right\vert }\right\vert \sum_{0\leq p\leq4}\binom{4}{p}%
L_{4}^{p}\left(  \left\vert \overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}%
}\right\rangle \left\langle \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}%
}\right\vert \right)  \right\rangle _{\mathcal{F}}\\
&  =\left\langle \left.  \overset{}{\left\vert \overset{}{\varphi_{k_{1}%
}\varphi_{k_{2}}}\right\rangle \left\langle \overset{}{\varphi_{l_{1}}%
\varphi_{l_{2}}}\right\vert }\right\vert \binom{4}{2}L_{4}^{2}\left(
\left\vert \overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle
\left\langle \overset{}{\varphi_{j_{1}}\cdots\varphi_{j_{4}}}\right\vert
\right)  \right\rangle _{\mathcal{F}}%
