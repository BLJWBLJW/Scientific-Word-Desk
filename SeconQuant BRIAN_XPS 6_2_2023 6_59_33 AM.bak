\begin{theorem}%
\begin{equation}
\left[  \left\Vert A\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }<\infty\right]  \Longleftrightarrow\left[  \left\Vert
\mathcal{R}_{\boldsymbol{\Phi}}\left(  A\right)  \right\Vert _{\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  }<\infty\right]  ,\quad
\mathcal{R}_{\boldsymbol{\Phi}}\left(  A\right)  \in\mathcal{B}\left(
l^{2}\left(  \mathbb{C}\right)  \right)  \subset\mathcal{M}\left(
\infty,\infty,\mathbb{C}\right)  .
\end{equation}

\end{theorem}

\begin{proof}
Consider the Hilbert space of square summable sequences
\begin{equation}
l^{2}\left(  \mathbb{C}\right)  \subset\mathcal{M}\left(  \infty
,1,\mathbb{C}\right)
\end{equation}
and let $\left\vert \boldsymbol{\Phi}\right\rangle $ and $\left\vert
\mathcal{R}_{\Phi}\left(  \boldsymbol{\Phi}\right)  \right\rangle
_{l^{2}\left(  \mathbb{C}\right)  }$ be \emph{conbs} of $\mathcal{H}%
_{\mathcal{F}}$ and $l^{2}\left(  \mathbb{C}\right)  $ respectively, where
$\mathcal{R}_{\Phi}$ is a faithful Hilbert space representation, thus a
Hilbert space isometric isomorphism
\begin{equation}
\mathcal{R}_{\Phi}:\mathcal{H}_{\mathcal{F}}\rightarrow l^{2}\left(
\mathbb{C}\right)
\end{equation}
given by
\begin{equation}
v=\left\vert \boldsymbol{\Phi}\right\rangle \mathcal{R}_{\Phi}\left(
v\right)  ,\quad v\in\mathcal{H}_{\mathcal{F}}.
\end{equation}
$\mathcal{R}_{\Phi}$ induces a $c^{\ast}$-algebra faithful representation,
hence $c^{\ast}$-algebra isomorphism $\mathcal{R}_{\Phi\Phi}$%
\begin{equation}
\mathcal{R}_{\Phi\Phi}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\rightarrow l^{2}\left(  \mathbb{C}\right)
\end{equation}
given by
\begin{equation}
Av=\left\vert \boldsymbol{\Phi}\right\rangle \mathcal{R}_{\Phi\Phi}\left(
A\right)  \mathcal{R}_{\Phi}\left(  v\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{\Phi\Phi}\left(  A\right)  =\mathcal{M}_{\Phi\Phi}\left(
A\right)  =\left\langle \boldsymbol{\Phi}\right\vert A\left\vert
\boldsymbol{\Phi}\right\rangle \in\mathcal{B}\left(  l^{2}\left(
\mathbb{C}\right)  \right)  .
\end{equation}
Then the operator norm $\left\Vert A\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }$ of $A$ is given by
\begin{align}
\left\Vert A\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}  &  =\sup_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left\langle \left.  \Psi\right\vert \left(  A^{\dagger}A\right)
\Psi\right\rangle \right\}  =\sup_{\left\Vert \Psi\right\Vert _{\mathcal{H}%
_{\mathcal{F}}}=1}\left\{  \mathcal{R}_{\Phi}\left(  \Psi\right)  ^{\dagger
}\mathcal{R}_{\Phi\Phi}\left(  A^{\dagger}A\right)  \mathcal{R}_{\Phi}\left(
\Psi\right)  \right\} \\
&  =\sup_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}=1}\left\{
\mathcal{R}_{\Phi}\left(  \Psi\right)  ^{\dagger}\mathcal{R}_{\Phi\Phi}\left(
A\right)  ^{\dagger}\mathcal{R}_{\Phi\Phi}\left(  A\right)  \mathcal{R}_{\Phi
}\left(  \Psi\right)  \right\}  =\left\Vert \mathcal{R}_{\Phi\Phi}\left(
A\right)  \right\Vert _{\mathcal{B}\left(  l^{2}\left(  \mathbb{C}\right)
\right)  },
\end{align}
i.e.
\begin{equation}
\left\Vert A\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=\left\Vert \mathcal{R}_{\Phi\Phi}\left(  A\right)  \right\Vert
_{\mathcal{B}\left(  l^{2}\left(  \mathbb{C}\right)  \right)  }.
\end{equation}

\end{proof}

\begin{theorem}
Let $A\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ then
\begin{equation}
\left\Vert \Gamma\left(  A\right)  \right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }<\infty
\end{equation}
$\lceil$
\end{theorem}

\begin{remark}
This theorem cannot be true as
\begin{equation}
\Gamma\left(  P_{\mathcal{H}^{1}}\right)  =\mathcal{N}_{a}%
\end{equation}
and
\begin{equation}
\left\Vert \mathcal{N}_{a}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\infty.
\end{equation}
$\rfloor$
\end{remark}

\begin{proof}%
\begin{equation}
\Gamma\left(  A\right)  =\Gamma\left(  \left\vert \boldsymbol{\Phi
}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert \right)
\mathcal{R}_{\left\vert \boldsymbol{\Phi}\right\rangle \left\langle
\boldsymbol{\Phi}\right\vert }\left(  A\right)  =\left(  \boldsymbol{a}%
^{\dagger}\boldsymbol{a}\right)  \mathcal{R}_{\boldsymbol{a}^{\dagger
}\boldsymbol{a}}\left(  A\right)  =\left(  \boldsymbol{a}^{\dagger
}\boldsymbol{a}\right)  \mathcal{R}_{\left\vert \boldsymbol{\Phi}\right\rangle
\left\langle \boldsymbol{\Phi}\right\vert }\left(  A\right)
\end{equation}
as
\begin{equation}
\mathcal{R}_{\left\vert \boldsymbol{\Phi}\right\rangle \left\langle
\boldsymbol{\Phi}\right\vert }\left(  A\right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{11}\\
\vdots\\
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{r1}%
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{1r}\\
\vdots\\
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{rr}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{11}\\
\vdots\\
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{r1}%
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{c}%
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{1r}\\
\vdots\\
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{rr}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{11}\\
\vdots\\
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{r1}%
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{c}%
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{1r}\\
\vdots\\
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{rr}%
\end{array}
\right)
\end{array}
\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{\boldsymbol{a}^{\dagger}\boldsymbol{a}}\left(  A\right)  =\left(
%
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{\boldsymbol{a}^{\dagger}\boldsymbol{a}}\left(  A\right)  _{11}\\
\vdots\\
\mathcal{R}_{\boldsymbol{a}^{\dagger}\boldsymbol{a}}\left(  A\right)  _{r1}%
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{\boldsymbol{a}^{\dagger}\boldsymbol{a}}\left(  A\right)  _{1r}\\
\vdots\\
\mathcal{R}_{\boldsymbol{a}^{\dagger}\boldsymbol{a}}\left(  A\right)  _{rr}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{11}\\
\vdots\\
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{r1}%
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{c}%
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{1r}\\
\vdots\\
\mathcal{M}_{\Phi\Phi}\left(  A\right)  _{rr}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{11}\\
\vdots\\
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{r1}%
\end{array}
\right) \\
\vdots\\
\left(
\begin{array}
[c]{c}%
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{1r}\\
\vdots\\
\left\langle \boldsymbol{\Phi}\right\vert A\left\vert \boldsymbol{\Phi
}\right\rangle _{rr}%
\end{array}
\right)
\end{array}
\right)
\end{equation}%
\begin{align}
\mathcal{R}_{e}\left(  v\right)  _{j}  &  =e_{j}^{d}\left(  v\right) \\
\mathcal{R}_{\boldsymbol{a}^{\dagger}\boldsymbol{a}}\left(  A\right)  _{11}
&  =\left(  a^{\dagger}a\right)  _{11}^{d}\left(  A\right)
\end{align}

\end{proof}

\begin{enumerate}
\item Let $V$ be a normed space and $A\in\mathcal{L}\left(  V\right)  $ then
the norm of $A$ is defined as
\begin{equation}
\left\Vert A\right\Vert _{\mathcal{L}\left(  V\right)  }=\sup
\limits_{\left\Vert v\right\Vert _{V}=1}\left\{  \left\Vert Av\right\Vert
_{V}\right\}  .
\end{equation}


\item Let $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ be a
normalized basis for $V$ i.e.
\begin{equation}
\left\Vert e_{j}\right\Vert _{V}=1,\,1\leq j\leq r
\end{equation}


\item Let $A$ be invertible i.e. $A^{-1}$ exists

\item Let $\left\{  \left.  Ae_{j}\right\vert 1\leq j\leq r\right\}  $ be a
normalized basis i.e
\begin{equation}
\left\Vert Ae_{j}\right\Vert _{V}=1,\,1\leq j\leq r
\end{equation}

\end{enumerate}

Then

\begin{enumerate}
\item As the basis $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $
is normalized then for normalized vectors $v$
\begin{gather}
1=\left\Vert v\right\Vert _{V}=\left\Vert \sum_{1\leq j\leq r}e_{j}%
v_{j}\right\Vert _{V}\leq\left\Vert e_{1}v_{1}\right\Vert _{V}+\cdots
+\left\Vert e_{r_{1}}v_{r}\right\Vert _{V}=\left\vert v_{1}\right\vert
\left\Vert e_{1}\right\Vert _{V}+\cdots+\left\vert v_{r}\right\vert \left\Vert
e_{r}\right\Vert _{V}\\
=\left\Vert e_{1}v_{1}\right\Vert _{V}+\cdots+\left\Vert e_{r}v_{r}\right\Vert
_{V}=\left\vert v_{1}\right\vert +\cdots+\left\vert v_{r}\right\vert
\end{gather}
i.e.
\begin{equation}
\left\Vert \mathcal{R}_{e}\left(  v\right)  \right\Vert _{L_{1}}\geq1.
\end{equation}


\item As the basis $\left\{  \left.  Ae_{j}\right\vert 1\leq j\leq r\right\}
$ is normalized then
\begin{equation}
1=\left\Vert Av\right\Vert _{V}=\left\Vert A\sum_{1\leq j\leq r}e_{j}%
v_{j}\right\Vert _{V}\leq\left\Vert Ae_{1}v_{1}\right\Vert _{V}+\cdots
+\left\Vert Ae_{r}v_{r}\right\Vert _{V}=\left\vert v_{1}\right\vert \left\Vert
Ae_{1}\right\Vert _{V}+\cdots+\left\vert v_{r}\right\vert \left\Vert
Ae_{r}\right\Vert _{V}=\left\vert v_{1}\right\vert +\cdots+\left\vert
v_{r}\right\vert .
\end{equation}

\end{enumerate}

\begin{lemma}
$L$ is bounded and has norms $1$.
\end{lemma}

\begin{proof}
Let
\end{proof}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}%
_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}


\item
\begin{equation}
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq
\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}


\item
\begin{equation}
\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq
\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}%
_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}_{00}\left(
\mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{definition}
The \emph{Ket-Bra} basis $\left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\varphi}\right\vert $ of $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ is defined as
\begin{equation}
\left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert =\left\{  \left.  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert
\right\vert 0\leq M,N\leq r,0\leq l_{1}<\cdots<l_{P}\leq r,0\leq m_{1}%
<\cdots<m_{P}\leq r.\right\}
\end{equation}

\end{definition}

\begin{definition}
The row vector of basis elements is
\begin{equation}
\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert \right)  =\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert ,\cdots,\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert
,\cdots,\left\vert \varphi_{1}\cdots\varphi_{r}\right\rangle \left\langle
\varphi_{1}\cdots\varphi_{r}\right\vert \right)  .
\end{equation}


\begin{remark}
This basis produces a discrete resolution of the identity $I_{\mathcal{H}%
_{\mathcal{F}}}\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
\begin{gather}
\left(
\begin{array}
[c]{ccccc}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert  & \cdots &
\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle \left\langle
\varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert  & \cdots & \left\vert
\varphi_{1}\cdots\varphi_{r}\right\rangle \left\langle \varphi_{1}%
\cdots\varphi_{r}\right\vert
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert \\
\vdots\\
\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle \left\langle
\varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert \\
\vdots\\
\left\vert \varphi_{1}\cdots\varphi_{r}\right\rangle \left\langle \varphi
_{1}\cdots\varphi_{r}\right\vert
\end{array}
\right) \\
=\sum_{\substack{0\leq l_{1}<\cdots<l_{P}\leq r\\0\leq m_{1}<\cdots<m_{P}\leq
r\\0\leq M,N\leq r}}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert
=I_{\mathcal{H}_{\mathcal{F}}}%
\end{gather}

\end{remark}

\begin{remark}
One can also use $\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert $ to express the resolution of the identity
$I_{\mathcal{H}_{\mathcal{F}}}$ acting in $\mathcal{H}_{\mathcal{F}}$
\begin{equation}
\left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert =\sum_{\substack{0\leq l_{1}<\cdots<l_{P}\leq r\\0\leq
m_{1}<\cdots<m_{P}\leq r\\0\leq M,N\leq r}}\left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{M}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{N}}\right\vert =I_{\mathcal{H}_{\mathcal{F}}},
\end{equation}
where $\left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert \in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  .$
\end{remark}
\end{definition}

\begin{remark}
Let $X\in\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ then the
representation of $\mathcal{R}_{\left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\varphi}\right\vert }\left(  X\right)  $ of $X$ as vector
wrt the basis $\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right)  $ is given by
\begin{equation}
X=X\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right)  \mathcal{\ }=\left(  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right)  \mathcal{R}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  X\right)  .
\end{equation}
leading to
\begin{equation}
\mathcal{M}_{\varphi}\left(  X\right)  =\left\langle \left.  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right\vert X\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right\rangle _{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=\left\langle \left.  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right\vert \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right\rangle _{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\mathcal{R}_{\varphi}\left(  X\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  X\right)  =\left(  \left\langle \left.
\left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert \right\vert \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right\rangle _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\right)  ^{-1}\mathcal{M}_{\left\vert \mathbf{\varphi
}\right\rangle \left\langle \mathbf{\varphi}\right\vert }\left(  X\right)  .
\end{equation}
As $\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right)  $ is a conb for $\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  $
\begin{equation}
\left\langle \left.  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right\vert \left\vert \mathbf{\varphi
}\right\rangle \left\langle \mathbf{\varphi}\right\vert \right\rangle
_{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  }=\mathbb{I}%
_{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  }%
\end{equation}
and
\begin{equation}
\mathcal{R}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  X\right)  =\ \mathcal{M}_{\left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
}\left(  X\right)  .
\end{equation}

\end{remark}

\begin{remark}
The representation of $\Gamma\in\mathcal{B}\left(  \mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ wrt $\left(  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right)  $ is given by
\begin{equation}
\Gamma\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert \right)  =\left(  \left\vert \mathbf{\varphi
}\right\rangle \left\langle \mathbf{\varphi}\right\vert \right)
\mathcal{R}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert ,\left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\varphi}\right\vert }\left(  \Gamma\right)  \equiv\left(
\left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert \right)  \mathcal{R}_{\left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\varphi}\right\vert }\left(  \Gamma\right)  .
\end{equation}

\end{remark}

\begin{remark}
The matrix $\mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  \Gamma\right)  $ of $\Gamma$ wrt this
basis is given by
\begin{gather}
\mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  \Gamma\right)  _{\left(  j_{1}\cdots
j_{P},k_{1}\cdots k_{Q}\right)  \left(  l_{1}\cdots l_{M},m_{1}\cdots
m_{N}\right)  }\\
\parallel\\
\left\langle \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert
\right\vert \Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert
\right)  \right\rangle _{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }=\overline{\left\langle \left.  \Gamma\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{N}}\right\vert \right)  \right\vert \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }%
\end{gather}
giving%
\begin{align}
\mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  \Gamma\right)  _{\left(  j_{1}\cdots
j_{P},k_{1}\cdots k_{Q}\right)  \left(  l_{1}\cdots l_{M},m_{1}\cdots
m_{N}\right)  }  &  =\overline{\left\langle \left.  \Gamma\left(  \left\vert
\varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle \left\langle \varphi_{m_{1}%
}\cdots\varphi_{m_{N}}\right\vert \right)  \right\vert \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\\
&  =\overline{\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  \left(
\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert \right)  \right)
^{\dagger}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \right\}  }\\
&  =\overline{\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{
\Gamma\left(  \left\vert \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\rangle
\left\langle \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\vert \right)
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \right\}  }\\
&  =\overline{\operatorname{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{  a_{m_{1}%
}^{\dagger}\cdots a_{m_{N}}^{\dagger}a_{l_{M}}\cdots a_{l_{1}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right\}  }\\
&  =\overline{\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\left\vert
\left(  a_{m_{1}}^{\dagger}\cdots a_{m_{N}}^{\dagger}a_{l_{M}}\cdots a_{l_{1}%
}\right)  \right.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\\
&  =\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\vert
\left(  a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}%
}\right)  \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}=0\text{ if }M>P\text{ or }N>Q.
\end{align}
i.e.%
\begin{equation}
\mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  \Gamma\right)  _{\left(  j_{1}\cdots
j_{P},k_{1}\cdots k_{Q}\right)  \left(  l_{1}\cdots l_{M},m_{1}\cdots
m_{N}\right)  }=\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert \left(  a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}%
}\cdots a_{m_{1}}\right)  \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}.
\end{equation}

\end{remark}

\begin{lemma}%
\begin{gather}
\mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  \Gamma\right)  _{\left(  j_{1}\cdots
j_{P},k_{1}\cdots k_{Q}\right)  \left(  l_{1}\cdots l_{M},m_{1}\cdots
m_{N}\right)  }=\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert \left(  a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}%
}\cdots a_{m_{1}}\right)  \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}\\
\parallel\\
\left\{
\begin{array}
[c]{c}%
\begin{array}
[c]{c}%
=1\text{ if }\left(  \left(  l_{1},\cdots,l_{M}\right)  \cap\left(
j_{1},\cdots,j_{P}\right)  =\left(  m_{1},\cdots,m_{N}\right)  \cap\left(
k_{1},\cdots,k_{Q}\right)  \right) \\
=0\text{ if }M>P\text{ or }N>Q\text{ }\\
=0\text{ if }\left(  \text{ }\left(  m_{1},\cdots,m_{N}\right)  \cap\left(
k_{1},\cdots,k_{Q}\right)  =\phi\right)  \text{ or }\left(  \left(
l_{1},\cdots,l_{M}\right)  \cap\left(  j_{1},\cdots,j_{P}\right)
=\phi\right)
\end{array}
\end{array}
\right.  .
\end{gather}

\end{lemma}

\begin{corollary}%
