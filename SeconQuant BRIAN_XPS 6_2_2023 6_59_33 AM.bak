\begin{definition}
The generalized expansion map $\Gamma\in\mathcal{L}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $%
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
by%
\begin{equation}
\Gamma\left(  X\right)  =\sum_{0\leq M,N\leq\infty}\sum_{\substack{P\leq
M\leq\infty\\Q\leq N\leq\infty}}\sqrt{\binom{M}{P}\binom{N}{Q}}\Gamma
_{P,Q}^{M,N}\left(  X_{PQ}\right)  .
\end{equation}%
\begin{equation}
\Gamma_{P,Q}^{M,N}\left(  X_{PQ}\right)  =\left\vert \boldsymbol{\varphi
}_{M-P}\right\rangle \left\langle \boldsymbol{\varphi}_{N-Q}\right\vert
\bullet X_{PQ}=\mathcal{A}_{M-P}\left(  I_{M-P}\right)
\end{equation}%
\begin{equation}
\left\vert \boldsymbol{\varphi}_{M-P}\right\rangle \left\langle
\boldsymbol{\varphi}_{N-Q}\right\vert =
\end{equation}

\end{definition}

\begin{definition}
The even subalgebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}$ is defined by
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq P\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq P\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{P},\mathcal{H}^{P}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq P\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq P\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{P}\right)  .
\end{equation}

\end{definition}

\begin{lemma}
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ is an invariant
subspace of the generalized expansion map??. Let $X\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ then
\begin{equation}
\Gamma\left(  X\right)  =\sum_{0\leq P\leq\infty}\sum_{P\leq N\leq\infty
}\binom{N+P}{P}\Gamma_{P,P}^{N+P,N+P}\left(  X\right)  =\sum_{0\leq
P\leq\infty}\sum_{P\leq N\leq\infty}\binom{N+P}{P}\Gamma_{P}^{N+P}\left(
X\right)  =\Gamma^{PP}\left(  X\right)  =\sum_{0\leq P\leq\infty}\Gamma
^{P}\left(  X\right)  ,
\end{equation}
where%
\begin{equation}
\Gamma^{P}\left(  X\right)  =\sum_{P\leq N\leq r}\binom{N}{P}\Gamma_{P}%
^{N}\left(  X\right)  =\sum_{P\leq N\leq\infty}\binom{N}{P}\Gamma_{P}%
^{N}\left(  X_{P}\right)  =\sum_{P\leq N\leq\infty}\binom{N}{P}X_{P}\boxtimes
P_{\mathcal{H}^{N-P}},\,0\leq P\leq r.
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{equation}
\Gamma\left(  X_{N}\right)  =\Gamma^{N}\left(  X\right)  ;\quad0\leq N\leq r.
\end{equation}

\end{lemma}

\begin{corollary}
The expansion of even operators
\begin{equation}
\Gamma\left(  X\right)  =\Gamma\left(  \left(  X_{0},X_{1},\cdots,X_{N}%
,\cdots,X_{r}\right)  \right)  =\left(  \Gamma\left(  X_{0}\right)
,\Gamma\left(  X_{1}\right)  ,\cdots,\Gamma\left(  X_{N}\right)
,\cdots,\Gamma\left(  X_{r}\right)  \right)  =\left(  \Gamma^{0}\left(
X\right)  ,\Gamma^{1}\left(  X\right)  ,\cdots,\Gamma^{N}\left(  X\right)
,\cdots,\Gamma^{r}\left(  X\right)  \right)  ,
\end{equation}
where
\begin{equation}
\Gamma^{N}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
and%
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}.
\end{equation}

\end{corollary}

The Hilbert space forming the exterior algebra $\mathcal{H}_{\mathcal{F}}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  $ can be decomposed as the direct sum
\begin{equation}
\mathcal{H}_{\mathcal{F}}=%
%TCIMACRO{\tbigoplus \limits_{0\leq N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq N\leq r}}
%EndExpansion
\mathcal{H}^{N},
\end{equation}
which can be represented by contravariant vector sequences $\left(
v^{0},v^{1},\cdots,v^{r}\right)  ,$ where
\begin{equation}
v=\left(
\begin{array}
[c]{ccc}%
P_{\mathcal{H}^{0}} & \cdots & P_{\mathcal{H}^{r}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
v^{0}\\
\vdots\\
v^{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
P_{\mathcal{H}^{0}} & \cdots & P_{\mathcal{H}^{r}}%
\end{array}
\right)  \mathcal{R}_{P_{\mathcal{H}}}\left(  v\right)  =P_{\mathcal{H}^{0}%
}v^{0}+\cdots+P_{\mathcal{H}^{r}}v^{r}=v^{0}+\cdots+v^{r}=v^{0}\oplus
\cdots\oplus v^{r}.
\end{equation}
$.$ The $w^{\ast}$-algebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  $ can be represented wrt this direct sum decomposition as matrices
of operators i.e.
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}},\mathcal{H}_{\mathcal{F}}\right)  =\mathcal{B}%
\left(
%TCIMACRO{\tbigoplus \limits_{0\leq M\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq M\leq r}}
%EndExpansion
\mathcal{H}^{M},%
%TCIMACRO{\tbigoplus \limits_{0\leq N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq N\leq r}}
%EndExpansion
\mathcal{H}^{N}\right)  \overset{\mathcal{R}_{P_{\mathcal{H}}P_{\mathcal{H}}%
}}{\,{\LARGE \longrightarrow}}\mathcal{M}\left(  \left(  r+1\right)  ,\left(
r+1\right)  ,\left(  \mathcal{B}\left(  \mathcal{H}^{M},\mathcal{H}%
^{N}\right)  0\leq M,N\leq r\right)  \right)  .
\end{equation}
The matrix elements of the operator matrix $X$ are given by
\begin{equation}
\left\{  \left.  X_{M}^{N}=P_{\mathcal{H}^{M}}XP_{\mathcal{H}^{N}}\right\vert
0\leq M,N\leq r\right\}
\end{equation}
and the action of the operator $X\in\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  ,$ $X\left(  v\right)  =w$ by
\begin{equation}
\left(
\begin{array}
[c]{ccccc}%
X_{0}^{0} & \cdots & X_{0}^{N} & \cdots & X_{0}^{r}\\
\vdots & \ddots & \vdots & \vdots & \vdots\\
X_{M}^{0} & \cdots & X_{M}^{N} & \cdots & X_{M}^{r}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
X_{r}^{0} & \cdots & X_{r}^{N} & \cdots & X_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
v^{0}\\
\vdots\\
v^{M}\\
\vdots\\
v^{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
w^{0}\\
\vdots\\
w^{M}\\
\vdots\\
w^{r}%
\end{array}
\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{P_{\mathcal{H}}P_{\mathcal{H}}}\left(  X\right)  =\left(
\begin{array}
[c]{ccccc}%
X_{0}^{0} & \cdots & X_{0}^{N} & \cdots & X_{0}^{r}\\
\vdots & \ddots & \vdots & \vdots & \vdots\\
X_{M}^{0} & \cdots & X_{M}^{N} & \cdots & X_{M}^{r}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
X_{r}^{0} & \cdots & X_{r}^{N} & \cdots & X_{r}^{r}%
\end{array}
\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{P_{\mathcal{H}}}\left(  v\right)  =\left(
\begin{array}
[c]{c}%
v^{0}\\
\vdots\\
v^{M}\\
\vdots\\
v^{r}%
\end{array}
\right)  .
\end{equation}


\begin{remark}
As the subspaces $\mathcal{H}^{N}$ are orthogonal (and thus disjoint) one can
expand a vector $v\in\mathcal{H}_{\mathcal{F}}$ as
\begin{equation}
v=\sum_{0\leq N\leq r}v_{N};\,v_{N}\in\mathcal{H}^{N}.
\end{equation}

\end{remark}

\subsubsection{Sub Algebra of Particle Conserving Operators $\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ i.e. Gauge Invariant
Operators}

\begin{remark}
In this section $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ will
play the role of a vector space and $\mathcal{B}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ as the role of operators acting
in $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  .$
\end{remark}

The $w^{\ast}$-algebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
is a Banach space which can be expanded as the Banach space direct sum
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq M,N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq M,N\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{M},\mathcal{H}^{N}\right)
\end{equation}
such that any operator $X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  $ can be represented by contravariant vector operator sequences
$\left(  X^{00},X^{01},X^{10},\cdots,X^{PQ},\cdots,X^{rr}\right)  $ and
\begin{equation}
X=\sum_{0\leq P,Q\leq r}X^{PQ}%
\end{equation}
as the subspaces in the direct sum are disjoint$.$The number of components of
$X$ in this decomposition is $\left(  r+1\right)  ^{2}.$ The space
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ contains a subspace,
$\Delta\left(  \mathcal{F}\right)  \equiv\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e},$ of \emph{particle conserving operators }$\equiv$
\emph{number} \emph{guage invariant operators}
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq N\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N},\mathcal{H}^{N}\right)  \equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq N\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N}\right)
\end{equation}
that in fact forms a sub $w^{\ast}$-algebra. The direct sum structure of
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ is analogous to
the direct sum structure of $\mathcal{H}_{\mathcal{F}}$ and the number of
components of $X_{e}\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}$ is $\left(  r+1\right)  $.

The action of an operator $\mathfrak{X}\in\mathcal{B}\left(  \mathcal{B}%
_{e}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  ,$ where%
\begin{equation}
\mathfrak{X}\left(  X\right)  =Y;\quad X,Y\in\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}%
\end{equation}
is given by $\mathfrak{X\in\,}\mathcal{B}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}\right)  $, which can be decomposed as
\begin{gather}
\mathfrak{\,}\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}\right)  =\mathfrak{\,}\mathcal{B}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e},\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}\right)  =\mathcal{B}\left(
%TCIMACRO{\tbigoplus \limits_{0\leq M\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq M\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{M}\right)  ,%
%TCIMACRO{\tbigoplus \limits_{0\leq N\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq N\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N}\right)  \right) \\
\updownarrow\left.  \mathcal{R}_{P_{\mathcal{H}}P_{\mathcal{H}}}\right. \\
\mathcal{M}\left(  \left(  r+1\right)  ,\left(  r+1\right)  ,\left.
\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{M},\mathcal{H}^{N}\right)
\right)  \right\vert 0\leq M,N\leq r\right)  .
\end{gather}
producing super operator matrices
\begin{equation}
\left(
\begin{array}
[c]{ccccc}%
\mathfrak{X}_{0}^{0} & \cdots & \mathfrak{X}_{0}^{N} & \cdots & \mathfrak{X}%
_{0}^{r}\\
\vdots & \ddots & \vdots & \vdots & \vdots\\
\mathfrak{X}_{M}^{0} & \cdots & \mathfrak{X}_{M}^{N} & \cdots & \mathfrak{X}%
_{M}^{r}\\
\vdots & \vdots & \vdots & \vdots & \vdots\\
\mathfrak{X}_{r}^{0} & \cdots & \mathfrak{X}_{r}^{N} & \cdots & \mathfrak{X}%
_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X^{0}\\
\vdots\\
X^{M}\\
\vdots\\
X^{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
Y^{0}\\
\vdots\\
Y^{M}\\
\vdots\\
Y^{r}%
\end{array}
\right)  .
\end{equation}
In particular
\begin{equation}
\mathfrak{X}\left(  X\right)  ^{N}=Y^{N}=\sum_{0\leq M\leq r}\mathfrak{X}%
_{M}^{N}\left(  X^{M}\right)  .
\end{equation}
The \emph{Generalized Expansion Map}
\begin{gather}
\mathfrak{G}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\\
\mathfrak{G}\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}\right)
\end{gather}
is given by
\begin{equation}
\mathfrak{G}\left(  X\right)  ^{N}=Y^{N}=\sum_{0\leq M\leq r}\binom{N}%
{M}\mathfrak{\Gamma}_{M}^{N}\left(  X^{M}\right)  =\sum_{0\leq M\leq N}%
\binom{N}{M}\mathfrak{\Gamma}_{M}^{N}\left(  X^{M}\right)  ,
\end{equation}


\begin{example}%
\begin{equation}
\mathfrak{G}\left(  X\right)  ^{N}=Y^{N}=\binom{N}{0}\mathfrak{\Gamma}_{0}%
^{N}\left(  X^{0}\right)  +\binom{N}{1}\mathfrak{\Gamma}_{1}^{N}\left(
X^{1}\right)  +\cdots+\binom{N}{N}\mathfrak{\Gamma}_{N}^{N}\left(
X^{N}\right)
\end{equation}
giving%
\begin{align}
\mathfrak{G}\left(  X^{0}\right)  ^{N}  &  =\binom{N}{0}\mathfrak{\Gamma}%
_{0}^{N}\left(  X^{0}\right) \\
\mathfrak{G}\left(  X^{0}\right)  ^{N-1}  &  =\binom{N-1}{0}\mathfrak{\Gamma
}_{0}^{N-1}\left(  X^{0}\right) \\
&  \vdots\\
\mathfrak{G}\left(  X^{0}\right)  ^{1}  &  =\binom{1}{0}\mathfrak{\Gamma}%
_{0}^{1}\left(  X^{0}\right) \\
\mathfrak{G}\left(  X^{0}\right)  ^{0}  &  =\binom{0}{0}\mathfrak{\Gamma}%
_{0}^{0}\left(  X^{0}\right)  ,
\end{align}

\end{example}

where
\begin{equation}
P_{\mathcal{B}\left(  \mathcal{H}^{M}\right)  }\mathfrak{G}P_{\mathcal{B}%
\left(  \mathcal{H}^{N}\right)  }=\mathfrak{G}_{M}^{N}=\binom{N}{M}\Gamma
_{M}^{N};\,N\geq M.
\end{equation}


The action of $\mathfrak{G}$ can be represented by lower triangular operator
matrices
\begin{equation}
\mathfrak{G}\left(  X\right)  =\left(
\begin{array}
[c]{ccccc}%
\mathfrak{G}_{0}^{0} & 0 & \cdots & 0 & 0\\
\vdots & \ddots & \ddots & \vdots & \vdots\\
\mathfrak{G}_{M}^{0} & \cdots & \mathfrak{G}_{M}^{N} & 0 & 0\\
\vdots & \vdots & \vdots & \vdots & \ddots\\
\mathfrak{G}_{r}^{0} & \cdots & \mathfrak{G}_{r}^{N} & \cdots & \mathfrak{G}%
_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X^{0}\\
\vdots\\
X^{M}\\
\vdots\\
X^{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
Y^{0}\\
\vdots\\
Y^{M}\\
\vdots\\
Y^{r}%
\end{array}
\right)  .
\end{equation}


\begin{example}
$r=4$%
\begin{gather}
\mathfrak{G}\left(  X^{1}\right)  =\left(
\begin{array}
[c]{ccccc}%
\mathfrak{G}_{0}^{0} & 0 & 0 & 0 & 0\\
\mathfrak{G}_{1}^{0} & \mathfrak{G}_{1}^{1} & 0 & 0 & 0\\
\mathfrak{G}_{2}^{0} & \mathfrak{G}_{2}^{1} & \mathfrak{G}_{2}^{2} & 0 & 0\\
\mathfrak{G}_{3}^{0} & \mathfrak{G}_{3}^{1} & \mathfrak{G}_{3}^{2} &
\mathfrak{G}_{3}^{3} & 0\\
\mathfrak{G}_{4}^{0} & \mathfrak{G}_{4}^{1} & \mathfrak{G}_{4}^{2} &
\mathfrak{G}_{4}^{3} & \mathfrak{G}_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
X^{1}\\
0\\
0\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
0\\
\mathfrak{G}\left(  X\right)  ^{1}=\binom{1}{1}\Gamma_{1}^{1}\left(
X^{1}\right) \\
\mathfrak{G}\left(  X\right)  ^{2}=\binom{2}{1}\Gamma_{1}^{2}\left(
X^{1}\right) \\
\mathfrak{G}\left(  X\right)  ^{3}=\binom{3}{1}\Gamma_{1}^{3}\left(
X^{1}\right) \\
\mathfrak{G}\left(  X\right)  ^{4}=\binom{4}{1}\Gamma_{1}^{4}\left(
X^{1}\right)
\end{array}
\right) \\
\parallel\\
\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & 0 & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1} & \binom{1}{1}\Gamma_{1}^{1} & 0 & 0 & 0\\
\binom{2}{0}\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \binom{2}{2}%
\Gamma_{2}^{2} & 0 & 0\\
\binom{3}{0}\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & \binom{3}{2}%
\Gamma_{2}^{3} & \binom{3}{3}\Gamma_{3}^{3} & 0\\
\binom{4}{0}\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}%
\Gamma_{1}^{4} & \binom{4}{3}\Gamma_{1}^{4} & \binom{4}{4}\Gamma_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
X^{1}\\
0\\
0\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
0\\
\binom{1}{1}\Gamma_{1}^{1}\left(  X^{1}\right) \\
\binom{2}{1}\Gamma_{1}^{2}\left(  X^{1}\right) \\
\binom{3}{1}\Gamma_{1}^{3}\left(  X^{1}\right) \\
\binom{4}{1}\Gamma_{1}^{4}\left(  X^{1}\right)
\end{array}
\right)  .
\end{gather}

\end{example}

\begin{example}
$r=4$%
\begin{gather}
\mathfrak{G}\left(  X^{0}\right)  =\left(
\begin{array}
[c]{ccccc}%
\mathfrak{G}_{0}^{0} & 0 & 0 & 0 & 0\\
\mathfrak{G}_{1}^{0} & \mathfrak{G}_{1}^{1} & 0 & 0 & 0\\
\mathfrak{G}_{2}^{0} & \mathfrak{G}_{2}^{1} & \mathfrak{G}_{2}^{2} & 0 & 0\\
\mathfrak{G}_{3}^{0} & \mathfrak{G}_{3}^{1} & \mathfrak{G}_{3}^{2} &
\mathfrak{G}_{3}^{3} & 0\\
\mathfrak{G}_{4}^{0} & \mathfrak{G}_{4}^{1} & \mathfrak{G}_{4}^{2} &
\mathfrak{G}_{4}^{3} & \mathfrak{G}_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X^{0}\\
0\\
0\\
0\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathfrak{G}\left(  X\right)  ^{1}=\binom{1}{0}\Gamma_{1}^{1}\left(
X^{0}\right) \\
\mathfrak{G}\left(  X\right)  ^{1}=\binom{1}{0}\Gamma_{1}^{1}\left(
X^{0}\right) \\
\mathfrak{G}\left(  X\right)  ^{2}=\binom{2}{0}\Gamma_{1}^{2}\left(
X^{0}\right) \\
\mathfrak{G}\left(  X\right)  ^{3}=\binom{3}{0}\Gamma_{1}^{3}\left(
X^{0}\right) \\
\mathfrak{G}\left(  X\right)  ^{4}=\binom{4}{0}\Gamma_{1}^{4}\left(
X^{0}\right)
\end{array}
\right)  .\\
\parallel\\
\left(
\begin{array}
[c]{ccccc}%
\binom{0}{0}\Gamma_{0}^{0} & 0 & 0 & 0 & 0\\
\binom{1}{0}\Gamma_{0}^{1} & \binom{1}{1}\Gamma_{1}^{1} & 0 & 0 & 0\\
\binom{2}{0}\Gamma_{0}^{2} & \binom{2}{1}\Gamma_{1}^{2} & \binom{2}{2}%
\Gamma_{2}^{2} & 0 & 0\\
\binom{3}{0}\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & \binom{3}{2}%
\Gamma_{2}^{3} & \binom{3}{3}\Gamma_{3}^{3} & 0\\
\binom{4}{0}\Gamma_{0}^{4} & \binom{4}{1}\Gamma_{1}^{4} & \binom{4}{2}%
\Gamma_{1}^{4} & \binom{4}{3}\Gamma_{1}^{4} & \binom{4}{4}\Gamma_{4}^{4}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X^{0}\\
0\\
0\\
0\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\binom{0}{0}\Gamma_{0}^{0}\left(  X^{0}\right) \\
\binom{1}{0}\Gamma_{0}^{1}\left(  X^{0}\right) \\
\binom{2}{0}\Gamma_{o}^{2}\left(  X^{0}\right) \\
\binom{3}{0}\Gamma_{0}^{3}\left(  X^{0}\right) \\
\binom{4}{0}\Gamma_{0}^{4}\left(  X^{0}\right)
\end{array}
\right)  .
\end{gather}

\end{example}

\begin{definition}
The general expansion map acting in the full algebra $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ is defined by the operator matrix elements
$\left\{  \left.  \Gamma_{PQ}^{MN}\right\vert 0\leq P\leq M\leq r,0\leq Q\leq
N\leq r\right\}  $ given by
\begin{align}
\Gamma_{PQ}^{MN}  &  :\mathcal{B}\left(  \mathcal{H}^{P},\mathcal{H}%
^{Q}\right)  \rightarrow\mathcal{B}\left(  \mathcal{H}^{N},\mathcal{H}%
^{M}\right) \nonumber\\
\Gamma_{PQ}^{MN}\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}%
}\right\rangle \left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert
\right)   &  =\mathcal{A}_{M}X\otimes P_{\mathcal{H}^{M},\mathcal{H}^{N}%
}\mathcal{A}_{N}=\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{Q}}\right\vert \cdot
P_{\mathcal{H}^{N-P},\mathcal{H}^{M-Q}}.
\end{align}

\end{definition}

\section{Second Quantization Map $\Gamma$\label{SecQuant}}

\begin{lemma}
Triangle Inequality%
\begin{equation}
\left\Vert X_{1}+X_{2}\right\Vert \leq\left\Vert X_{1}\right\Vert +\left\Vert
X_{2}\right\Vert .
\end{equation}

\end{lemma}

\begin{lemma}
Norm Product Inequality
\begin{equation}
\left\Vert X_{1}X_{2}\right\Vert \leq\left\Vert X_{1}\right\Vert \left\Vert
X_{2}\right\Vert .
\end{equation}

\end{lemma}

\begin{definition}
The Second Quantized Map
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
is defined by
\begin{equation}
\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{N}}\right\vert \right)
=a_{l_{1}}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}%
};\,0\leq M,N\leq r,0\leq l_{1}<\cdots<l_{P}\leq r,0\leq m_{1}<\cdots
<m_{P}\leq r.
\end{equation}

\end{definition}

\begin{remark}
Hence one has the vector coefficient expansions
\begin{equation}
\Gamma\left(  A\right)  =\Gamma\left(  \left(  \left\vert \boldsymbol{\Phi
}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert \right)
\mathcal{R}_{\left\vert \boldsymbol{\Phi}\right\rangle \left\langle
\boldsymbol{\Phi}\right\vert }\left(  A\right)  \right)  =\left(
\boldsymbol{a}^{\dagger}\boldsymbol{a}\right)  \mathcal{R}_{\left\vert
\boldsymbol{\Phi}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert
}\left(  A\right)  ,
\end{equation}
where
\begin{equation}
A=\left\vert \boldsymbol{\Phi}\right\rangle \left\langle \boldsymbol{\Phi
}\right\vert A\left\vert \boldsymbol{\Phi}\right\rangle \left\langle
\boldsymbol{\Phi}\right\vert =\left\vert \boldsymbol{\Phi}\right\rangle
\mathcal{M}_{\boldsymbol{\Phi}}\left(  A\right)  \left\langle \boldsymbol{\Phi
}\right\vert =\left\vert \boldsymbol{\Phi}\right\rangle \mathcal{R}%
_{\boldsymbol{\Phi}}\left(  A\right)  \left\langle \boldsymbol{\Phi
}\right\vert \equiv\left(  \left\vert \boldsymbol{\Phi}\right\rangle
\left\langle \boldsymbol{\Phi}\right\vert \right)  \mathcal{R}_{\left\vert
\boldsymbol{\Phi}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert
}\left(  A\right)  .
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item Expansion of the second quantized operator $\Gamma\left(  A\right)  $ in
terms of scalar matrix coefficients
\begin{align}
\Gamma\left(  A\right)   &  =\left(  \boldsymbol{a}^{\dagger}\right)
\mathcal{R}_{\Phi\Phi}\left(  A\right)  \left(  \boldsymbol{a}\right)  ^{t}\\
&  =\left(  I_{\mathcal{H}_{\mathcal{F}}},\cdots,a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger},\cdots,a_{1}^{\dagger}\cdots a_{r}^{\dagger}\right)
\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{11} & \cdots & \mathcal{R}_{\Phi
\Phi}\left(  A\right)  _{12^{r}}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{2^{r}1} & \cdots & \mathcal{R}%
_{\Phi\Phi}\left(  A\right)  _{2^{r}2^{r}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
I_{\mathcal{H}_{\mathcal{F}}}\\
\vdots\\
a_{k_{n}}\cdots a_{k_{1}}\\
\vdots\\
a_{1}\cdots a_{r}%
\end{array}
\right) \\
&  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}a_{j_{1}}^{\dagger}\cdots a_{j_{m}%
}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\mathcal{R}_{\Phi\Phi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}.
\end{align}


\item Expansion of the operator $A$ in terms of matrix coefficients%
\begin{align}
A  &  =\left(  \boldsymbol{\Phi}\right)  \mathcal{R}_{\Phi\Phi}\left(
A\right)  \left(  \boldsymbol{\Phi}\right)  ^{t}\\
&  =\left(  \left\vert \phi\right\rangle ,\cdots,\left\vert \varphi_{l_{1}%
}\cdots\varphi_{l_{M}}\right\rangle ,\cdots,\left\vert \varphi_{1}%
\cdots\varphi_{r}\right\rangle \right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{11} & \cdots & \mathcal{R}_{\Phi
\Phi}\left(  A\right)  _{12^{r}}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{\Phi\Phi}\left(  A\right)  _{2^{r}1} & \cdots & \mathcal{R}%
_{\Phi\Phi}\left(  A\right)  _{2^{r}2^{r}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\left\vert \phi\right\rangle \\
\vdots\\
\left\langle \varphi_{l_{1}}\cdots\varphi_{l_{M}}\right\vert \\
\vdots\\
\left\langle \varphi_{1}\cdots\varphi_{r}\right\vert
\end{array}
\right) \\
&  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{m}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\vert \mathcal{R}_{\Phi\Phi}\left(  A\right)  _{j_{1}\cdots j_{m}%
k_{1}\cdots k_{n}}.
\end{align}

\end{enumerate}
\end{remark}

\begin{definition}
Injection of the one particle Hilbert space $\mathcal{H}^{1}$ into the Hilbert
Schmidt operator space
\begin{equation}
\Upsilon:\mathcal{H}^{1}\rightarrow\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \subset\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)
\end{equation}
givn by%
\begin{equation}
\Upsilon\left(  \varphi_{j}\right)  =\left\vert \varphi_{j}\right\rangle
\left\langle \phi\right\vert ,\quad1\leq j\leq r.
\end{equation}

\end{definition}

\begin{definition}
The dual map of $\Upsilon$
\begin{equation}
\Upsilon^{d}:\mathcal{H}^{1d}\rightarrow\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \subset\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)
\end{equation}
given by
\begin{equation}
\Upsilon^{d}\left(  \left\langle \varphi_{j}\right\vert \right)  =\left\vert
\phi\right\rangle \left\langle \varphi_{j}\right\vert ,\quad1\leq j\leq r.
\end{equation}

\end{definition}

\begin{lemma}%
\begin{equation}
\left\langle \left.  v_{1}\right\vert v_{2}\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}=\left\langle \left.  \Upsilon\left(  v_{1}\right)  \right\vert
\Upsilon\left(  v_{2}\right)  \right\rangle _{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=\operatorname*{Tr}\left\{  \left(
\Upsilon\left(  v_{1}\right)  ^{\dagger}\Upsilon\left(  v_{2}\right)  \right)
\right\}  =\operatorname*{Tr}\left\{  \left(  \left\vert \phi\right\rangle
\left\langle v_{1}\right\vert \left\vert v_{2}\right\rangle \left\langle
\phi\right\vert \right)  =\left\langle \left.  v_{1}\right\vert v_{2}%
\right\rangle _{\mathcal{H}_{\mathcal{F}}}\left\langle \left.  \phi\right\vert
\phi\right\rangle _{\mathcal{H}_{\mathcal{F}}}\right\}  =\left\langle \left.
v_{1}\right\vert v_{2}\right\rangle _{\mathcal{H}_{\mathcal{F}}}%
\end{equation}
thus $\Upsilon$ is a Hilbert space isometric isomorphism.
\end{lemma}

\begin{remark}
The creation and annihilation operators $\left\{  \left.  a_{j}^{\dagger
},a_{j}\right\vert 1\leq j\leq r\right\}  $ can be generated by
\begin{gather}
a_{j}^{\dagger}=\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert \right)  =\Gamma\left(  \Upsilon\left(  \varphi_{j}\right)
\right)  \equiv\left[  \Gamma\circ\Upsilon\right]  \left(  \varphi_{j}\right)
=\Phi\left(  \varphi_{j}\right) \\
a_{j}=\Gamma\left(  \left\vert \phi\right\rangle \left\langle \varphi
_{j}\right\vert \right)  =\left[  \Gamma\circ\Upsilon^{d}\right]  \left(
\varphi_{j}^{d}\right)  =\left[  \Gamma\circ\Upsilon^{d}\right]  \left(
\varphi_{j}^{d}\right)  =\left[  \Gamma\circ\Upsilon^{d}\right]  \left(
\digamma_{\left\vert {}\right\rangle }\left(  \varphi_{j}\right)  \right)
=\left[  \Gamma\circ\Upsilon^{d}\circ\digamma_{\left\vert {}\right\rangle
}\right]  \left(  \varphi_{j}\right)  =\Phi_{\digamma_{\left\vert
{}\right\rangle }}\left(  \varphi_{j}\right) \\
1\leq j\leq r,
\end{gather}
where
\begin{equation}
\digamma_{\left\vert {}\right\rangle }:\mathcal{H}^{1}\rightarrow
\mathcal{H}^{1d}%
\end{equation}
is the antilinear map $\digamma_{\left\vert {}\right\rangle }$ given by
\begin{equation}
\digamma_{\left\vert {}\right\rangle }\left(  v\right)  =\left\langle
v\right\vert
\end{equation}
and
\begin{equation}
\left[  \digamma_{\left\vert {}\right\rangle }\left(  v\right)  \right]
\left(  w\right)  =\left\langle \left.  v\right\vert w\right\rangle
_{\mathcal{H}^{1}}.
\end{equation}

\end{remark}

\begin{definition}
\begin{enumerate}
\item The second quantiztion creation operator map $\Phi$%
\begin{equation}
\Phi:\mathcal{H}^{1}\rightarrow\boldsymbol{a}^{\dagger}\subset\mathcal{F}_{1}.
\end{equation}


\item The second quantiztion annihilation operator map $\Phi_{\digamma
_{\left\vert {}\right\rangle }}$%
\begin{equation}
\Phi_{\digamma_{\left\vert {}\right\rangle }}:\mathcal{H}^{1}\rightarrow
\boldsymbol{a}\subset\mathcal{F}_{1}.
\end{equation}


\item
\begin{equation}
\Phi\left(  \varphi_{j}\right)  =\left[  \Gamma\circ\Upsilon\right]  \left(
\varphi_{j}\right)  =a_{j}^{\dagger},1\leq j\leq r.
\end{equation}


\item
\begin{equation}
\Phi_{\digamma_{\left\vert {}\right\rangle }}\left(  \varphi_{j}\right)
=\left[  \Gamma\circ\Upsilon^{d}\circ\digamma_{\left\vert {}\right\rangle
}\right]  \left(  \varphi_{j}\right)  =a_{j},1\leq j\leq r.
\end{equation}

\end{enumerate}
\end{definition}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
\Phi\oplus\Phi^{d}:\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow
\mathcal{F}_{1}.
\end{equation}


\item
\begin{equation}
\Phi\oplus\Phi_{\digamma_{\left\vert {}\right\rangle }}:\mathcal{H}^{1}%
\oplus\mathcal{H}^{1}\rightarrow\mathcal{F}_{1}.
\end{equation}


\item
\begin{equation}
\Phi\oplus\Phi_{\digamma}:\mathcal{H}^{1}\oplus\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \rightarrow\mathcal{F}_{1}.
\end{equation}

\end{enumerate}
\end{remark}

\begin{theorem}%
\begin{equation}
\Phi:\mathcal{H}^{1}\hookrightarrow\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)
\end{equation}
and
\begin{equation}
\Phi^{d}:\mathcal{H}^{1d}\hookrightarrow\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)
\end{equation}
are linear injections.
\end{theorem}

\begin{definition}
The norm $\left\Vert \Gamma\right\Vert _{\mathcal{L}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  }$ of the Second Quantizization Map
$\Gamma\in\mathcal{L}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  $ (the space of linear maps acting in $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  )$ is defined as
\begin{equation}
\left\Vert \Gamma\right\Vert _{\mathcal{L}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  }=\sup\limits_{\left\Vert
X\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }%
=1}\left\{  \left\Vert \Gamma\left(  X\right)  \right\Vert _{\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  }\right\}  .
\end{equation}

\end{definition}

\begin{definition}
The norm $\left\Vert X\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }$ of an operator $X\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $
\begin{equation}
\left\Vert X\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left\Vert X\Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}\right\}
=\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  X^{\dagger}X\left\vert
\Psi\right\rangle \left\langle \Psi\right\vert \right\}  \right)  ^{\frac
{1}{2}}\right\}  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}%
_{\mathcal{F}}}=1}\left\{  \left\vert \left\langle \left.  \Psi\right\vert
X^{\dagger}X\Psi\right\rangle \right\vert ^{\frac{1}{2}}\right\}  .
\end{equation}

\end{definition}

\begin{remark}
The norm $\left\Vert \Gamma\right\Vert _{\mathcal{L}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  }$ can thus be expanded as

\begin{enumerate}
\item
\begin{equation}
\left\Vert \Gamma\right\Vert _{\mathcal{L}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  }=\sup\limits_{\left\Vert
X\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }%
=1}\left\{  \sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}%
_{\mathcal{F}}}=1}\left\{  \left(  \operatorname*{Tr}\left\{
\overset{}{\Gamma\left(  X\right)  ^{\dagger}\Gamma\left(  X\right)
\left\vert \Psi\right\rangle \left\langle \Psi\right\vert }\right\}  \right)
^{\frac{1}{2}}\right\}  \right\}  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{example}
\begin{enumerate}
\item
\begin{enumerate}
\item The operator norm of $a_{j}^{\dagger}\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ is given by
\begin{equation}
\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\sup\limits_{\left\Vert \Psi\right\Vert
_{\mathcal{H}_{\mathcal{F}}}=1}\left\{  \left(  \operatorname*{Tr}\left\{
a_{j}^{\dagger}a_{j}\left\vert \Psi\right\rangle \left\langle \Psi\right\vert
\right\}  \right)  ^{\frac{1}{2}}\right\}  .
\end{equation}


\item The operator norm of $a_{j}^{\dagger}a_{j}\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ is given by%
\begin{equation}
\left\Vert a_{j}^{\dagger}a_{j}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\sup\limits_{\left\Vert \Psi\right\Vert
_{\mathcal{H}_{\mathcal{F}}}=1}\left\{  \left(  \operatorname*{Tr}\left\{
a_{j}^{\dagger}a_{j}a_{j}^{\dagger}a_{j}\left\vert \Psi\right\rangle
\left\langle \Psi\right\vert \right\}  \right)  ^{\frac{1}{2}}\right\}
=\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\left\vert
\Psi\right\rangle \left\langle \Psi\right\vert \right\}  \right)  ^{\frac
{1}{2}}\right\}  =\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }%
\end{equation}


\item This implies
\begin{equation}
\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=1
\end{equation}
as

\item
\begin{equation}
\left\Vert a_{j}^{\dagger}a_{j}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  }^{2}=\left\Vert a_{j}^{\dagger
}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }.
\end{equation}


\item This is true for any idempotent $A$
\begin{equation}
\left\Vert A^{2}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }=\left\Vert A\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }^{2}=\left\Vert A\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\Longrightarrow\left\Vert A\right\Vert
_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }=1.
\end{equation}

\end{enumerate}

\item The HS and TC norms of $a_{j}^{\dagger}a_{j}$ and $a_{j}^{\dagger}$ are
given by

\begin{enumerate}
\item HS norm%
\begin{equation}
\left\Vert a_{j}^{\dagger}a_{j}\right\Vert _{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=\left(  \overset{}{\operatorname*{Tr}%
\left\{  a_{j}^{\dagger}a_{j}a_{j}^{\dagger}a_{j}\right\}  }\right)
^{\frac{1}{2}}=\left(  \overset{}{\operatorname*{Tr}\left\{  a_{j}^{\dagger
}a_{j}\right\}  }\right)  ^{\frac{1}{2}}=\left\Vert a_{j}^{\dagger}\right\Vert
_{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  }%
\end{equation}


\item TC norm%
\begin{equation}
\left\Vert a_{j}^{\dagger}a_{j}\right\Vert _{\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=\operatorname*{Tr}\left\{
\overset{}{\left(  a_{j}^{\dagger}a_{j}a_{j}^{\dagger}a_{j}\right)  ^{\frac
{1}{2}}}\right\}  =\operatorname*{Tr}\left\{  \overset{}{\left(
a_{j}^{\dagger}a_{j}\right)  ^{\frac{1}{2}}}\right\}  =\left\Vert
a_{j}^{\dagger}\right\Vert _{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }.
\end{equation}


\item Number and hole operators
\begin{equation}
\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}\right\}
=\operatorname*{tr}\left\{  n_{j}+h_{j}\right\}  =\operatorname*{tr}\left\{
I_{\mathcal{H}_{\mathcal{F}}}\right\}  =1\Longrightarrow\operatorname*{tr}%
\left\{  n_{j}\right\}  =\frac{1}{2}\text{ and }\operatorname*{tr}\left\{
h_{j}\right\}  =\frac{1}{2}.
\end{equation}


\item Trace of the identity
\begin{equation}
\operatorname*{Tr}\left\{  I_{\mathcal{H}_{\mathcal{F}}}\right\}  =2^{r}%
=2^{r}\operatorname*{tr}\left\{  I_{\mathcal{H}_{\mathcal{F}}}\right\}  .
\end{equation}


\item
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  =2^{r-1}.
\end{equation}


\item
\begin{equation}
\frac{1}{2^{r}}\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\right\}
=\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  .
\end{equation}


\item Hence in infinite dimensions
\begin{equation}
a_{j}^{\dagger},a_{j}\notin\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \supseteq\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
as
\begin{equation}
\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\left(  \operatorname*{Tr}\left\{  a_{j}^{\dagger
}a_{j}\right\}  \right)  ^{\frac{1}{2}}=\left(  2^{r-1}\right)  ^{\frac{1}{2}%
}=2^{\frac{r-1}{2}}\geq\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  }.
\end{equation}

\end{enumerate}

\item The relationship between the norms and corresponding spaces are
\begin{gather}
\left\Vert X\right\Vert _{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }\geq\left\Vert X\right\Vert _{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\geq\left\Vert X\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\\
\left\Vert X\right\Vert _{\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }\text{-}\operatorname*{closure}\left\{  \mathcal{B}_{00}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right\}  =\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right) \\
\left\Vert X\right\Vert _{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }\text{-}\operatorname*{closure}\left\{  \mathcal{B}_{00}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right\}  =\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right) \\
\left\Vert X\right\Vert _{\mathcal{B}_{0}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }\text{-}\operatorname*{closure}\left\{  \mathcal{B}_{00}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right\}  =\mathcal{B}_{0}\left(
\mathcal{H}_{\mathcal{F}}\right) \\
\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  \subseteq
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \subseteq
\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  \subseteq
\mathcal{B}_{0}\left(  \mathcal{H}_{\mathcal{F}}\right)  \subseteq
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{gather}

\end{enumerate}
\end{example}

\subparagraph{Representations and Expectation Values}

\begin{notation}
Bases of $\mathcal{H}_{\mathcal{F}}$
\begin{align}
\left(  \boldsymbol{\Phi}\right)   &  =\left(  \boldsymbol{\Phi}_{0}%
,\cdots,\boldsymbol{\Phi}_{r}\right) \\
\boldsymbol{\Phi}_{n}  &  =\left\vert \boldsymbol{\varphi}%
\overset{\longleftarrow n\longrightarrow}{\boldsymbol{\wedge}\cdots
\boldsymbol{\wedge}}\boldsymbol{\varphi}\right\rangle =\left(  \left\vert
\varphi_{1}\cdots\varphi_{n}\right\rangle ,\cdots,\left\vert \varphi
_{r-n+1}\cdots\varphi_{r}\right\rangle \right) \\
\boldsymbol{\varphi}  &  =\left(  \varphi_{1},\cdots,\varphi_{r}\right)  .
\end{align}

\end{notation}

\begin{example}
\begin{enumerate}
\item Expectation of number operators

\begin{enumerate}
\item
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\left\vert \Psi_{n}%
\right\rangle \left\langle \Psi_{n}\right\vert \right\}  =\left\langle \left.
\overset{}{\Psi_{n}}\right\vert a_{j}^{\dagger}a_{j}\Psi_{n}\right\rangle
=\left\langle \left.  \sum_{1\leq k_{1}\,<\cdots<k_{n}\leq r}\left\vert
\varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\rangle c_{k_{1}\,\cdots k_{n}%
}\right\vert \left(  \overset{}{a_{j}^{\dagger}a_{j}}\right)  \sum_{1\leq
k_{1}\,<\cdots<k_{n}\leq r}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\rangle c_{k_{1}\,\cdots k_{n}}\right\rangle .
\end{equation}


\item
\begin{align}
&  \left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
a_{j}^{\dagger}a_{k}\varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle
=\delta_{k\left(  l_{1}\,\cdots l_{n}\right)  }\delta_{j\left(  k_{1}\,\cdots
k_{n}\right)  }=\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\vert \Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert \right)  \varphi_{l_{1}}\cdots\varphi_{l_{n}%
}\right\rangle \\
&  =\left\langle \left.  \overset{\overset{}{\overset{}{}}}{\varphi_{k_{1}%
}\cdots\varphi_{k_{n}}}\right\vert \left(  \sum_{1\leq p_{2}\,<\cdots
<p_{n}\leq r}\left\vert \varphi_{j}\varphi_{p_{2}}\cdots\varphi_{p_{n}%
}\right\rangle \left\langle \varphi_{k}\varphi_{p_{2}}\cdots\varphi_{p_{n}%
}\right\vert \right)  \varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle
=\delta_{\left(  k_{1}\,\cdots k_{n}\right)  \left(  jp_{2}\,\cdots
p_{n}\right)  }\delta_{\left(  l_{1}\,\cdots l_{n}\right)  \left(
kp_{2}\,\cdots p_{n}\right)  }.
\end{align}

\end{enumerate}

\item \underline{\emph{Note that}}
\begin{equation}
\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert \left(
a_{j}^{\dagger}a_{k}\right)  \varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle
\quad\emph{\neq\quad}\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\vert \left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert \right)  \varphi_{l_{1}}\cdots\varphi_{l_{n}%
}\right\rangle
\end{equation}
and
\begin{equation}
\quad\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{m}}\cdots a_{k_{1}%
}\right)  \varphi_{l_{1}}\cdots\varphi_{l_{n}}\right\rangle \quad
\emph{\neq\quad}\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n}%
}\right\vert \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\vert \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\rangle .
\end{equation}


\item The relationship between the \emph{operator norms} of $a_{j}^{\dagger
}a_{j}$ and $\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  $
\begin{equation}
\left\Vert a_{j}^{\dagger}a_{j}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\left\Vert a_{j}^{\dagger}\right\Vert _{\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  }=\left\Vert \Gamma\left(
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{j}\right\vert
\right)  \right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=\left\Vert \Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert \right)  \right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=1.
\end{equation}


\begin{lemma}%
\begin{equation}
P_{\mathcal{H}^{n_{1}}}\left(  a_{p_{1}}^{\dagger}\cdots a_{p_{m_{1}}%
}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)  P_{\mathcal{H}^{n_{2}}%
}=\left\vert \varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}}\right\rangle
\left\langle \varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}}\right\vert \delta
_{n_{1}m_{1}}\delta_{n_{2}m_{2}}%
\end{equation}


\begin{corollary}%
\begin{equation}
\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n_{1}}}\right\vert
\left(  P_{\mathcal{H}^{n_{1}}}\left(  a_{p_{1}}^{\dagger}\cdots a_{p_{m_{1}}%
}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)  P_{\mathcal{H}^{n_{2}}%
}\right)  \varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}}\right\rangle =\left\langle
\left.  \varphi_{k_{1}}\cdots\varphi_{k_{n_{1}}}\right\vert \left(  \left\vert
\varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}}\right\rangle \left\langle
\varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}}\right\vert \right)  \varphi_{k_{1}%
}\cdots\varphi_{k_{n_{2}}}\right\rangle
\end{equation}

\end{corollary}
\end{lemma}

\item
\begin{align}
&  \left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{n_{1}}}\right\vert
\left(  a_{p_{1}}^{\dagger}\cdots a_{p_{m_{1}}}^{\dagger}a_{q_{m_{2}}}\cdots
a_{q_{1}}\right)  \varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}}\right\rangle
=\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{n_{1}}}\right\vert
P_{\mathcal{H}^{n_{1}}}\left(  a_{p_{1}}^{\dagger}\cdots a_{p_{m_{1}}%
}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)  P_{\mathcal{H}^{n_{2}}%
}\varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}}\right\rangle =\\
&  =\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{n_{1}}}\right\vert
\Gamma\left(  \left\vert \varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}}\right\rangle
\left\langle \varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}}\right\vert \right)
\varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}}\right\rangle \neq\left\langle \left.
\varphi_{j_{1}}\cdots\varphi_{j_{n_{1}}}\right\vert \left\vert \varphi_{p_{1}%
}\cdots\varphi_{p_{m_{1}}}\right\rangle \left\langle \varphi_{q_{1}}%
\cdots\varphi_{q_{m_{2}}}\right\vert \varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}%
}\right\rangle .
\end{align}


\begin{enumerate}
\item
\begin{gather}
\mathcal{M}_{\boldsymbol{\Phi}}\left(  a_{p_{1}}^{\dagger}\cdots a_{p_{m_{1}}%
}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)  =\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  \boldsymbol{\Phi}_{0}\right\vert \left(  a_{p_{1}%
}^{\dagger}\cdots a_{p_{m_{1}}}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)
\boldsymbol{\Phi}_{0}\right\rangle  & \cdots & \left\langle \left.
\boldsymbol{\Phi}_{0}\right\vert \left(  a_{p_{1}}^{\dagger}\cdots
a_{p_{m_{1}}}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)  \boldsymbol{\Phi
}_{2^{r}}\right\rangle \\
\vdots & \ddots & \vdots\\
\left\langle \left.  \boldsymbol{\Phi}_{2^{r}}\right\vert \left(  a_{p_{1}%
}^{\dagger}\cdots a_{p_{m_{1}}}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)
\boldsymbol{\Phi}_{0}\right\rangle  & \cdots & \left\langle \left.
\boldsymbol{\Phi}_{2^{r}}\right\vert \left(  a_{p_{1}}^{\dagger}\cdots
a_{p_{m_{1}}}^{\dagger}a_{q_{m_{2}}}\cdots a_{q_{1}}\right)  \boldsymbol{\Phi
}_{2^{r}}\right\rangle
\end{array}
\right) \\
{\Large \not \parallel }\\
\mathcal{M}_{\boldsymbol{\Phi}}\left(  \left\vert \varphi_{p_{1}}\cdots
\varphi_{p_{m_{1}}}\right\rangle \left\langle \varphi_{q_{1}}\cdots
\varphi_{q_{m_{2}}}\right\vert \right)  =\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  \boldsymbol{\Phi}_{0}\right\vert \left\vert
\varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}}\right\rangle \left\langle
\varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}}\right\vert \boldsymbol{\Phi}%
_{0}\right\rangle  & \cdots & \left\langle \left.  \boldsymbol{\Phi}%
_{0}\right\vert \left\vert \varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}%
}\right\rangle \left\langle \varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}%
}\right\vert \boldsymbol{\Phi}_{2^{r}}\right\rangle \\
\vdots & \ddots & \vdots\\
\left\langle \left.  \boldsymbol{\Phi}_{2^{r}}\right\vert \left\vert
\varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}}\right\rangle \left\langle
\varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}}\right\vert \boldsymbol{\Phi}%
_{0}\right\rangle  & \cdots & \left\langle \left.  \boldsymbol{\Phi}_{2^{r}%
}\right\vert \left\vert \varphi_{p_{1}}\cdots\varphi_{p_{m_{1}}}\right\rangle
\left\langle \varphi_{q_{1}}\cdots\varphi_{q_{m_{2}}}\right\vert
\boldsymbol{\Phi}_{2^{r}}\right\rangle
\end{array}
\right)
\end{gather}


\item
\begin{gather}
\left\langle \left.  \boldsymbol{\Phi}_{M}\right\vert X\boldsymbol{\Phi}%
_{N}\right\rangle \\
\parallel\\
\left(
\begin{array}
[c]{ccc}%
\left\langle \left.  \varphi_{1}\cdots\varphi_{M}\right\vert X\varphi
_{1}\cdots\varphi_{M}\right\rangle  & \cdots & \left\langle \left.
\varphi_{1}\cdots\varphi_{M}\right\vert X\varphi_{r-N+1}\cdots\varphi
_{N}\right\rangle \\
\vdots & \ddots & \vdots\\
\left\langle \left.  \varphi_{r-M+1}\cdots\varphi_{M}\right\vert X\varphi
_{1}\cdots\varphi_{M}\right\rangle  & \cdots & \left\langle \left.
\varphi_{r-M+1}\cdots\varphi_{M}\right\vert X\varphi_{r-N+1}\cdots\varphi
_{N}\right\rangle
\end{array}
\right)  .
\end{gather}

\end{enumerate}
\end{enumerate}
\end{example}

\begin{enumerate}
\item
\begin{equation}
\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n_{1}}}\right\vert
\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m_{1}}}^{\dagger}a_{j_{m_{2}}}\cdots
a_{j_{1}}\right)  \varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}}\right\rangle
=\left\langle \left.  \varphi_{k_{1}}\cdots\varphi_{k_{n_{1}}}\right\vert
\Gamma\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m_{1}}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{m_{2}}}\right\vert \right)
\varphi_{k_{1}}\cdots\varphi_{k_{n_{2}}}\right\rangle .
\end{equation}


\item
\begin{equation}
\left\Vert \Gamma\right\Vert _{\mathcal{L}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  }=\sup_{\left\Vert A\right\Vert
_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }=1}\left\{  \left\Vert
\Gamma\left(  A\right)  \right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\right\}  .
\end{equation}


\item
\begin{equation}
\left\Vert A\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=\sup_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}=1}\left\{
\left\langle \left.  \Psi\right\vert \left(  A^{\dagger}A\right)
\Psi\right\rangle \right\}  =\sup_{\left\Vert \Psi\right\Vert _{\mathcal{H}%
_{\mathcal{F}}}=1}\left\{  \operatorname*{Tr}\left\{  \overset{}{A^{\dagger
}A\left\vert \Psi\right\rangle \left\langle \Psi\right\vert }\right\}
\right\}  =\sup_{P\in\operatorname*{ext}\left\{  \mathcal{C}_{+}\left(
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  \right\}
}\left\{  \operatorname*{Tr}\left\{  \overset{}{A^{\dagger}AP}\right\}
\right\}  .
\end{equation}


\item
\begin{equation}
\left\Vert \Gamma\left(  A\right)  \right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=\sup_{\left\Vert \Psi\right\Vert
_{\mathcal{H}_{\mathcal{F}}}=1}\left\{  \left\langle \left.  \overset{}{\Psi
}\right\vert \left(  \overset{}{\Gamma\left(  A\right)  ^{\dagger}%
\Gamma\left(  A\right)  }\right)  \Psi\right\rangle \right\}  =\sup
_{P\in\operatorname*{ext}\left\{  \mathcal{C}_{+}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  \right\}  }\left\{
\operatorname*{Tr}\left\{  \overset{}{A^{\dagger}AP}\right\}  \right\}  .
\end{equation}


\item
\begin{equation}
A=\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq
k_{1}<\cdots<k_{m}\leq r}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\mathcal{R}_{\varphi}\left(  A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}.
\end{equation}


\item
\begin{align}
\left\Vert A\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}  &  \leq\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\left\Vert \overset{}{\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\vert }\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\mathcal{R}_{\varphi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\\
&  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\mathcal{R}_{\varphi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}<?\infty
\end{align}


\item
\begin{align}
\left\Vert \overset{}{\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }  &
=\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  \overset{}{\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\vert ^{\dagger}\left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{m}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{n}}\right\vert \left\vert \Psi\right\rangle \left\langle
\Psi\right\vert }\right\}  \right)  \right\} \\
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \operatorname*{Tr}\left\{  \overset{}{\left\vert \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{m}}\right\vert \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\left\vert \Psi\right\rangle \left\langle \Psi\right\vert }\right\}  \right\}
\\
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \operatorname*{Tr}\left\{  \overset{}{\left\vert \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{n}}\right\vert \left\vert \Psi\right\rangle \left\langle
\Psi\right\vert }\right\}  \right\}  =1.
\end{align}


\item
\begin{align}
\Gamma\left(  A\right)   &  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq
j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\Gamma\left(
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert \right)  \mathcal{R}_{\varphi
}\left(  A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\\
&  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}a_{j_{1}}^{\dagger}\cdots a_{j_{m}%
}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\mathcal{R}_{\varphi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}.
\end{align}


\item
\begin{align}
\left\Vert \Gamma\left(  A\right)  \right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }  &  \leq\sum_{0\leq m,n\leq r}%
\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{m}\leq
r}}\left\Vert \Gamma\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\right)  \right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}\mathcal{R}_{\varphi}\left(  A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}%
}\\
&  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\left\Vert a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\mathcal{R}_{\varphi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\\
&  =\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\mathcal{R}_{\varphi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}<?\infty.
\end{align}


\item
\begin{align}
\left\Vert a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots
a_{k_{1}}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  \left(  a_{j_{1}}^{\dagger
}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)  ^{\dagger
}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}%
}\left\vert \Psi\right\rangle \left\langle \Psi\right\vert \right\}  \right)
\right\} \\
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  a_{k_{1}}^{\dagger}\cdots
a_{k_{n}}^{\dagger}\left(  a_{j_{m}}\cdots a_{j_{1}}a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}\right)  a_{k_{n}}\cdots a_{k_{1}}\left\vert \Psi
\right\rangle \left\langle \Psi\right\vert \right\}  \right)  \right\} \\
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  a_{k_{1}}^{\dagger}\cdots
a_{k_{n}}^{\dagger}h_{j_{m}}\cdots h_{j_{1}}a_{k_{n}}\cdots a_{k_{1}%
}\left\vert \Psi\right\rangle \left\langle \Psi\right\vert \right\}  \right)
\right\} \\
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  a_{k_{1}}^{\dagger}\cdots
a_{k_{n}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}h_{j_{m}}\cdots h_{j_{1}%
}\left\vert \Psi\right\rangle \left\langle \Psi\right\vert \right\}  \right)
\right\} \\
&  =\sup\limits_{\left\Vert \Psi\right\Vert _{\mathcal{H}_{\mathcal{F}}}%
=1}\left\{  \left(  \operatorname*{Tr}\left\{  n_{j_{1}}\cdots n_{j_{n}%
}h_{j_{m}}\cdots h_{j_{1}}\left\vert \Psi\right\rangle \left\langle
\Psi\right\vert \right\}  \right)  \right\}  =1
\end{align}
i.e.%
\begin{equation}
\left\Vert a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots
a_{k_{1}}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=1.
\end{equation}
$\lceil$%
\begin{align}
\left(  1-a_{j}^{\dagger}a_{j}\right)  a_{j}\  &  =h_{j}a_{j}\ =a_{j}\\
a_{j}h_{j}  &  =a_{j}\left(  1-a_{j}^{\dagger}a_{j}\right)  =a_{j}-a_{j}%
a_{j}^{\dagger}a_{j}=a_{j}-\left(  1-a_{j}^{\dagger}a_{j}\right)  a_{j}%
=a_{j}-a_{j}=0\\
h_{j}a_{k}\  &  =a_{k}h_{j}\
\end{align}
$\rfloor$%
\begin{equation}
\left\Vert a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots
a_{k_{1}}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}\leq\left\Vert a_{j_{1}}^{\dagger}a_{k_{1}}\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\cdots\left\Vert a_{j_{m}}^{\dagger
}a_{k_{1}}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=1
\end{equation}

\end{enumerate}

Hence
\begin{equation}
\left\Vert \Gamma\left(  A\right)  \right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\leq\sum_{0\leq m,n\leq r}\sum
_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{m}\leq
r}}\mathcal{R}_{\varphi}\left(  A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots
k_{n}}=\sum_{0\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{m}\leq r}}\mathcal{M}_{\varphi}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}.
\end{equation}


\begin{remark}
\begin{enumerate}
\item Vectors $\Psi\in\mathcal{H}_{\mathcal{F}}$ can be expanded by the
representation $\mathcal{R}_{\boldsymbol{\Phi}}\left(  \Psi\right)  $ by
\begin{equation}
\Psi=\left\vert \boldsymbol{\Phi}\right\rangle \mathcal{R}_{\boldsymbol{\Phi}%
}\left(  \Psi\right)  .
\end{equation}


\item Operators $A\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
can be represented in the vector representation $\mathcal{R}_{\left\vert
\boldsymbol{\Phi}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert
}\left(  A\right)  $ and can be represented in the matrix representation
$\mathcal{R}_{\boldsymbol{\Phi}}\left(  A\right)  \equiv\mathcal{R}%
_{\boldsymbol{\Phi\Phi}}\left(  A\right)  $ by
\begin{equation}
A=\left\vert \boldsymbol{\Phi}\right\rangle \left\langle \boldsymbol{\Phi
}\right\vert A\left\vert \boldsymbol{\Phi}\right\rangle \left\langle
\boldsymbol{\Phi}\right\vert =\left\vert \boldsymbol{\Phi}\right\rangle
\mathcal{M}_{\boldsymbol{\Phi}}\left(  A\right)  \left\langle \boldsymbol{\Phi
}\right\vert =\left\vert \boldsymbol{\Phi}\right\rangle \mathcal{R}%
_{\boldsymbol{\Phi}}\left(  A\right)  \left\langle \boldsymbol{\Phi
}\right\vert \equiv\left(  \left\vert \boldsymbol{\Phi}\right\rangle
\left\langle \boldsymbol{\Phi}\right\vert \right)  \mathcal{R}_{\left\vert
\boldsymbol{\Phi}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert
}\left(  A\right)  .
\end{equation}


\item For conbs $\left(  \boldsymbol{\Phi}\right)  $ one has
\begin{equation}
\left\langle \overset{}{\boldsymbol{\Phi}}\right\vert \left(
\overset{}{\left(  \left\vert \boldsymbol{\Phi}\right\rangle \left\langle
\boldsymbol{\Phi}\right\vert \right)  \mathcal{R}_{\left\vert \boldsymbol{\Phi
}\right\rangle \left\langle \boldsymbol{\Phi}\right\vert }\left(  A\right)
}\right)  \left\vert \overset{}{\boldsymbol{\Phi}}\right\rangle =\mathcal{M}%
_{\boldsymbol{\Phi}}\left(  A\right)  =\mathcal{R}_{\boldsymbol{\Phi}}\left(
A\right)  .
\end{equation}

\end{enumerate}
\end{remark}

