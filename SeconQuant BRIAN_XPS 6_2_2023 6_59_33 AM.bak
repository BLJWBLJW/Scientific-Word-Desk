The underlying Hilbert space $\mathcal{H}_{\mathcal{F}}$ is
\begin{equation}
\mathcal{H}_{\mathcal{F}}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\vert \phi\right\rangle ,\left\vert \varphi_{1}\right\rangle ,\left\vert
\varphi_{2}\right\rangle ,\left\vert \varphi_{1}\varphi_{2}\right\rangle
\right\}  ,
\end{equation}
which produces the operator Hilbert space $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $
\begin{gather}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert ,\left\vert
\phi\right\rangle \left\langle \varphi_{1}\right\vert ,\left\vert
\phi\right\rangle \left\langle \varphi_{2}\right\vert ,\left\vert \varphi
_{1}\right\rangle \left\langle \phi\right\vert ,\left\vert \varphi
_{2}\right\rangle \left\langle \phi\right\vert ,\left\vert \phi\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \phi\right\vert ,\\
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\right\vert ,\\
\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert ,\\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert .
\end{array}
\right\} \\
\equiv\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left\vert 0,0\right\rangle ,\left\vert 0,1\right\rangle ,\left\vert
0,2\right\rangle ,\left\vert 1,0\right\rangle ,\left\vert 2,0\right\rangle
,\left\vert 0,12\right\rangle ,\left\vert 12,0\right\rangle ,\\
\left\vert 1,1\right\rangle ,\left\vert 1,2\right\rangle ,\left\vert
2,1\right\rangle ,\left\vert 1,12\right\rangle ,\left\vert 12,1\right\rangle
,\\
\left\vert 2,2\right\rangle ,\left\vert 2,12\right\rangle ,\left\vert
12,2\right\rangle ,\\
\left\vert 12,12\right\rangle .
\end{array}
\right\} \\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left(  \left\vert
\mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi}\right\vert
\right)  \right\}  ,
\end{gather}
where
\begin{gather}
\left(  \left\vert \mathbf{\varphi}\right\rangle \left\langle \mathbf{\varphi
}\right\vert \right)  =\left(
\begin{array}
[c]{c}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert ,\left\vert
\phi\right\rangle \left\langle \varphi_{1}\right\vert ,\left\vert
\phi\right\rangle \left\langle \varphi_{2}\right\vert ,\left\vert \varphi
_{1}\right\rangle \left\langle \phi\right\vert ,\left\vert \varphi
_{2}\right\rangle \left\langle \phi\right\vert ,\left\vert \phi\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert ,\left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \phi\right\vert ,\\
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{1}\right\vert
,\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\right\vert ,\\
\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
,\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert ,\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert ,\\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert .
\end{array}
\right) \\
=\left(
\begin{array}
[c]{c}%
\left\vert 0,0\right\rangle ,\left\vert 0,1\right\rangle ,\left\vert
0,2\right\rangle ,\left\vert 1,0\right\rangle ,\left\vert 2,0\right\rangle
,\left\vert 0,12\right\rangle ,\left\vert 12,0\right\rangle ,\\
\left\vert 1,1\right\rangle ,\left\vert 1,2\right\rangle ,\left\vert
2,1\right\rangle ,\left\vert 1,12\right\rangle ,\left\vert 12,1\right\rangle
,\\
\left\vert 2,2\right\rangle ,\left\vert 2,12\right\rangle ,\left\vert
12,2\right\rangle ,\\
\left\vert 12,12\right\rangle .
\end{array}
\right)  .
\end{gather}

\end{example}

\begin{example}
As a vector space $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ can
be expanded
\begin{align}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)   &  =\mathcal{B}\left(
\mathcal{H}^{0},\mathcal{H}^{0}\right)  \oplus\mathcal{B}\left(
\mathcal{H}^{0},\mathcal{H}^{1}\right)  \oplus\mathcal{B}\left(
\mathcal{H}^{1},\mathcal{H}^{0}\right)  \oplus\mathcal{B}\left(
\mathcal{H}^{0},\mathcal{H}^{2}\right)  \oplus\mathcal{B}\left(
\mathcal{H}^{2},\mathcal{H}^{0}\right) \\
&  \oplus\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)
\oplus\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{2}\right)
\oplus\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{1}\right)
\oplus\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  .
\end{align}
and the associated guage invariant even subspace $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ as
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=\mathcal{B}\left(
\mathcal{H}^{0},\mathcal{H}^{0}\right)  \ \oplus\mathcal{B}\left(
\mathcal{H}^{1},\mathcal{H}^{1}\right)  \oplus\mathcal{B}\left(
\mathcal{H}^{2},\mathcal{H}^{2}\right)  .
\end{equation}
where%
\begin{align}
\mathcal{B}\left(  \mathcal{H}^{0}\right)   &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert \left\vert 0\right\rangle
\left\langle 0\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 0,0\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{1}\right)   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \left\vert 0\right\rangle
\left\langle 1\right\vert \right\rangle ,\left\vert \left\vert 0\right\rangle
\left\langle 2\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 0,1\right\rangle ,\left\vert
0,2\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{2}\right)   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \left\vert 0\right\rangle
\left\langle 12\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 0,12\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{0}\right)   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \left\vert 1\right\rangle
\left\langle 0\right\vert \right\rangle ,\left\vert \left\vert 2\right\rangle
\left\langle 0\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 1,0\right\rangle ,\left\vert
2,0\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{0}\right)   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert 12\right\rangle
\left\langle 0\right\vert \right\}  =\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left\vert 12,0\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{1}\right)   &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert \left\vert 1\right\rangle
\left\langle 1\right\vert \right\rangle ,\left\vert \left\vert 1\right\rangle
\left\langle 2\right\vert \right\rangle ,\left\vert \left\vert 2\right\rangle
\left\langle 1\right\vert \right\rangle ,\left\vert \left\vert 2\right\rangle
\left\langle 2\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 1,1\right\rangle ,\left\vert
1,2\right\rangle ,\left\vert 2,1\right\rangle ,\left\vert 2,2\right\rangle
\right\} \\
\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{2}\right)   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \left\vert 1\right\rangle
\left\langle 12\right\vert \right\rangle ,\left\vert \left\vert 2\right\rangle
\left\langle 12\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 1,12\right\rangle ,\left\vert
2,12\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{1}\right)   &  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \left\vert 12\right\rangle
\left\langle 1\right\vert \right\rangle ,\left\vert \left\vert 2\right\rangle
\left\langle 12\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 12,1\right\rangle ,\left\vert
2,12\right\rangle \right\} \\
\mathcal{B}\left(  \mathcal{H}^{2}\right)   &  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert \left\vert 12\right\rangle
\left\langle 12\right\vert \right\rangle \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert 12,12\right\rangle \right\}  .
\end{align}
Operators $M\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  $ can be expresses as
\begin{align}
M  &  :\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right) \\
M  &  =\sum_{\substack{0\leq p_{1},q_{1}\leq2\\0\leq p_{2},q_{2}\leq
2}}P_{\mathcal{B}\left(  \mathcal{H}^{p_{1}},\mathcal{H}^{q_{1}}\right)
}MP_{\mathcal{B}\left(  \mathcal{H}^{p_{2}},\mathcal{H}^{q_{2}}\right)  }%
\end{align}
and
\begin{align}
M_{e}  &  :\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\\
M_{e}  &  =\sum_{0\leq p_{1},p_{2}\leq2}P_{\mathcal{B}\left(  \mathcal{H}%
^{p_{1}},\mathcal{H}^{p_{1}}\right)  }MP_{\mathcal{B}\left(  \mathcal{H}%
^{p_{2}},\mathcal{H}^{p_{2}}\right)  }=\\
&  P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)
}MP_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }%
+P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }%
MP_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }%
+P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }%
MP_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }+\\
&  P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)
}MP_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }%
+P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }%
MP_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }%
+P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }%
MP_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }+\\
&  P_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)
}MP_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }%
+P_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }%
MP_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }%
+P_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }%
MP_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  },
\end{align}
where%
\begin{align}
P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }  &
=\left\vert \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\rangle \left\langle \overset{}{\left\vert 0\right\rangle \left\langle
0\right\vert }\right\vert =\left\vert \overset{}{0,0}\right\rangle
\left\langle \overset{}{0,0}\right\vert \\
P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }  &
=\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle \left\langle \overset{}{\left\vert 1\right\rangle \left\langle
1\right\vert }\right\vert +\left\vert \overset{}{\left\vert 1\right\rangle
\left\langle 2\right\vert }\right\rangle \left\langle \overset{}{\left\vert
1\right\rangle \left\langle 2\right\vert }\right\vert +\left\vert
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\vert +\left\vert \overset{}{\left\vert 2\right\rangle \left\langle
2\right\vert }\right\rangle \left\langle \overset{}{\left\vert 2\right\rangle
\left\langle 2\right\vert }\right\vert \\
&  =\left\vert \overset{}{1,1}\right\rangle \left\langle \overset{}{1,1}%
\right\vert +\left\vert \overset{}{1,2}\right\rangle \left\langle
\overset{}{1,2}\right\vert +\left\vert \overset{}{2,1}\right\rangle
\left\langle \overset{}{2,1}\right\vert +\left\vert \overset{}{2,2}%
\right\rangle \left\langle \overset{}{2,2}\right\vert \\
P_{\mathcal{B}\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }  &
=\left\vert \overset{}{12,12}\right\rangle \left\langle \overset{}{12,12}%
\right\vert .
\end{align}
giving
\end{example}

\begin{enumerate}
\item
\begin{equation}
P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }MP_{\mathcal{B}%
\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }=\left\vert
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\vert M\left\vert \overset{}{\left\vert 0\right\rangle \left\langle
0\right\vert }\right\rangle \left\langle \overset{}{\left\vert 0\right\rangle
\left\langle 0\right\vert }\right\vert =\left\vert \overset{}{\left\vert
0\right\rangle \left\langle 0\right\vert }\right\rangle M_{\left(  0,0\right)
\left(  0,0\right)  }\left\langle \overset{}{\left\vert 0\right\rangle
\left\langle 0\right\vert }\right\vert .
\end{equation}


\item
\begin{align}
&  P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)
}MP_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }=\left\vert
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\vert M\left(  \left\vert \overset{}{\left\vert 1\right\rangle
\left\langle 1\right\vert }\right\rangle \left\langle \overset{}{\left\vert
1\right\rangle \left\langle 1\right\vert }\right\vert +\left\vert
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\vert +\left\vert \overset{}{\left\vert 2\right\rangle \left\langle
1\right\vert }\right\rangle \left\langle \overset{}{\left\vert 2\right\rangle
\left\langle 1\right\vert }\right\vert +\left\vert \overset{}{\left\vert
2\right\rangle \left\langle 2\right\vert }\right\rangle \left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert }\right\vert
\right)  =\\
&  \left\vert \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\rangle M_{\left(  0,0\right)  \left(  1,1\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\rangle M_{\left(  0,0\right)  \left(  1,2\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\rangle M_{\left(  0,0\right)  \left(  2,1\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\rangle M_{\left(  0,0\right)  \left(  2,2\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert }\right\vert .
\end{align}


\item
\begin{equation}
P_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }MP_{\mathcal{B}%
\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }=\left\vert
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\rangle
M_{\left(  0,0\right)  \left(  12,12\right)  }\left\langle
\overset{}{\left\vert 12\right\rangle \left\langle 12\right\vert }\right\vert
.
\end{equation}


\item
\begin{align}
&  P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)
}MP_{\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{0}\right)  }=\left(
\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle \left\langle \overset{}{\left\vert 1\right\rangle \left\langle
1\right\vert }\right\vert +\left\vert \overset{}{\left\vert 1\right\rangle
\left\langle 2\right\vert }\right\rangle \left\langle \overset{}{\left\vert
1\right\rangle \left\langle 2\right\vert }\right\vert +\left\vert
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\vert +\left\vert \overset{}{\left\vert 2\right\rangle \left\langle
2\right\vert }\right\rangle \left\langle \overset{}{\left\vert 2\right\rangle
\left\langle 2\right\vert }\right\vert \right)  M\left\vert
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert
}\right\vert =\\
&  \left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  1,1\right)  \left(  0,0\right)  }\left\langle
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  1,2\right)  \left(  0,0\right)  }\left\langle
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  2,1\right)  \left(  0,0\right)  }\left\langle
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  2,2\right)  \left(  0,0\right)  }\left\langle
\overset{}{\left\vert 0\right\rangle \left\langle 0\right\vert }\right\vert .
\end{align}


\item
\begin{align}
P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }MP_{\mathcal{B}%
\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }  &  =\left(  \left\vert
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\vert +\left\vert \overset{}{\left\vert 1\right\rangle \left\langle
2\right\vert }\right\rangle \left\langle \overset{}{\left\vert 1\right\rangle
\left\langle 2\right\vert }\right\vert +\left\vert \overset{}{\left\vert
2\right\rangle \left\langle 1\right\vert }\right\rangle \left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle \left\langle \overset{}{\left\vert 2\right\rangle \left\langle
2\right\vert }\right\vert \right)  M\\
&  \left(  \left\vert \overset{}{\left\vert 1\right\rangle \left\langle
1\right\vert }\right\rangle \left\langle \overset{}{\left\vert 1\right\rangle
\left\langle 1\right\vert }\right\vert +\left\vert \overset{}{\left\vert
1\right\rangle \left\langle 2\right\vert }\right\rangle \left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle \left\langle \overset{}{\left\vert 2\right\rangle \left\langle
1\right\vert }\right\vert +\left\vert \overset{}{\left\vert 2\right\rangle
\left\langle 2\right\vert }\right\rangle \left\langle \overset{}{\left\vert
2\right\rangle \left\langle 2\right\vert }\right\vert \right)
\end{align}
giving%
\begin{align}
&  \left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  1,1\right)  \left(  1,1\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  1,1\right)  \left(  1,2\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  1,1\right)  \left(  2,1\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  1,1\right)  \left(  2,2\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert }\right\vert \\
&  \left\vert \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  1,2\right)  \left(  1,1\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  1,2\right)  \left(  1,2\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  1,2\right)  \left(  2,1\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  1,2\right)  \left(  2,2\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert }\right\vert \\
&  \left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  2,1\right)  \left(  1,1\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  2,1\right)  \left(  1,2\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  2,1\right)  \left(  1,2\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  2,1\right)  \left(  2,2\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert }\right\vert \\
&  \left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  2,2\right)  \left(  1,1\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  2,2\right)  \left(  2,2\right)  }\left\langle
\overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  2,2\right)  \left(  2,1\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  2,2\right)  \left(  2,2\right)  }\left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert }\right\vert .
\end{align}


\item
\begin{equation}
P_{\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{1}\right)  }MP_{\mathcal{B}%
\left(  \mathcal{H}^{2},\mathcal{H}^{2}\right)  }=\left(  \left\vert
\overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert }\right\rangle
\left\langle \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\vert +\left\vert \overset{}{\left\vert 1\right\rangle \left\langle
2\right\vert }\right\rangle \left\langle \overset{}{\left\vert 1\right\rangle
\left\langle 2\right\vert }\right\vert +\left\vert \overset{}{\left\vert
2\right\rangle \left\langle 1\right\vert }\right\rangle \left\langle
\overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 2\right\vert
}\right\rangle \left\langle \overset{}{\left\vert 2\right\rangle \left\langle
2\right\vert }\right\vert \right)  M\left\vert \overset{}{\left\vert
12\right\rangle \left\langle 12\right\vert }\right\rangle \left\langle
\overset{}{\left\vert 12\right\rangle \left\langle 12\right\vert }\right\vert
\end{equation}
giving
\begin{align}
&  \left\vert \overset{}{\left\vert 1\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  1,1\right)  \left(  12,12\right)  }\left\langle
\overset{}{\left\vert 12\right\rangle \left\langle 12\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 1\right\rangle \left\langle 2\right\vert
}\right\rangle M_{\left(  1,2\right)  \left(  12,12\right)  }\left\langle
\overset{}{\left\vert 12\right\rangle \left\langle 12\right\vert }\right\vert
+\left\vert \overset{}{\left\vert 2\right\rangle \left\langle 1\right\vert
}\right\rangle M_{\left(  2,1\right)  \left(  12,12\right)  }\left\langle
\overset{}{\left\vert 12\right\rangle \left\langle 12\right\vert }\right\vert
\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\qquad+\left\vert \overset{}{\left\vert 2\right\rangle
\left\langle 2\right\vert }\right\rangle M_{\left(  2,2\right)  \left(
12,12\right)  }\left\langle \overset{}{\left\vert 12\right\rangle \left\langle
12\right\vert }\right\vert .
\end{align}


