\item Setting
\begin{equation}
\Gamma_{ab}=\left(  \mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\varphi}\right\vert }\left(  \Gamma\right)  \right)
_{ab}%
\end{equation}
one obtains
\begin{equation}
\Gamma_{\left(  \underline{j_{1}\cdots j_{P}},\underline{k_{1}\cdots k_{Q}%
}\right)  \left[  l_{1}\cdots l_{M},m_{1}\cdots m_{N}\right]  }=\left\langle
\left.  \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\vert \left(  a_{l_{1}%
}^{\dagger}\cdots a_{l_{M}}^{\dagger}a_{m_{N}}\cdots a_{m_{1}}\right)
\varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\rangle _{\mathcal{H}_{\mathcal{F}}%
}.
\end{equation}
Let $r=2,2^{2}=4,2^{4}=16,P=1,Q=1,M=2,N=2$ then e.g.
\begin{align}
\Gamma_{\left(  1,1\right)  \left(  12,12\right)  }  &  =\overline
{\left\langle \left.  \Gamma\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
\right\vert \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\overline{\left\langle \left.  a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}\right\vert \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert \right\rangle _{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }}\\
&  =\overline{\left\langle \left.  \varphi_{1}\right\vert \left(
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\right)  \varphi_{1}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}}=\left\langle \left.  \varphi_{1}\right\vert
\left(  a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\right)  \varphi
_{1}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0\\
\Gamma_{\left(  12,12\right)  \left(  1,1\right)  }  &  =\overline
{\left\langle \left.  \Gamma\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert \right)  \right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\overline{\left\langle \left.  a_{1}^{\dagger}%
a_{1}\right\vert \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\\
&  =\overline{\left\langle \left.  \varphi_{1}\varphi_{2}\right\vert \left(
a_{1}^{\dagger}a_{1}\right)  \varphi_{1}\varphi_{2}\right\rangle
}_{\mathcal{H}_{\mathcal{F}}}=\left\langle \left.  \varphi_{1}\varphi
_{2}\right\vert \left(  a_{1}^{\dagger}a_{1}\right)  \varphi_{1}\varphi
_{2}\right\rangle =1
\end{align}%
\begin{align}
\Gamma_{\left(  1,2\right)  \left(  12,12\right)  }  &  =\overline
{\left\langle \left.  \Gamma\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
\right\vert \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{2}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\overline{\left\langle \left.  a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}\right\vert \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{2}\right\vert \right\rangle _{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }}\\
&  =\overline{\left\langle \left.  \varphi_{2}\right\vert \left(
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\right)  \varphi_{1}\right\rangle
_{\mathcal{H}_{\mathcal{F}}}}=\left\langle \left.  \varphi_{1}\right\vert
\left(  a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\right)  \varphi
_{2}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0\\
\Gamma_{\left(  12,12\right)  \left(  1,2\right)  }  &  =\overline
{\left\langle \left.  \Gamma\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  \right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }=\overline{\left\langle \left.  a_{1}^{\dagger}%
a_{2}\right\vert \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  }\\
&  =\overline{\left\langle \left.  \varphi_{1}\varphi_{2}\right\vert \left(
a_{2}^{\dagger}a_{1}\right)  \varphi_{1}\varphi_{2}\right\rangle
}_{\mathcal{H}_{\mathcal{F}}}=\left\langle \left.  \varphi_{1}\varphi
_{2}\right\vert \left(  a_{2}^{\dagger}a_{1}\right)  \varphi_{1}\varphi
_{2}\right\rangle _{\mathcal{H}_{\mathcal{F}}}=0
\end{align}%
\begin{align}
\Gamma_{\left(  12,12\right)  \left(  0,0\right)  }  &  =\overline
{\left\langle \left.  \Gamma\left(  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right)  \right\vert \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right\rangle
}_{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  }=\overline
{\left\langle \left.  I_{\mathcal{H}_{\mathcal{F}}}\right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\\
&  =\overline{\left\langle \left.  \varphi_{1}\varphi_{2}\right\vert
I_{\mathcal{H}_{\mathcal{F}}}\varphi_{1}\varphi_{2}\right\rangle
}_{\mathcal{H}_{\mathcal{F}}}=\left\langle \left.  \varphi_{1}\varphi
_{2}\right\vert I_{\mathcal{H}_{\mathcal{F}}}\varphi_{1}\varphi_{2}%
\right\rangle _{\mathcal{H}_{\mathcal{F}}}=1\\
\Gamma_{\left(  0,0\right)  \left(  12,12\right)  }  &  =\overline
{\left\langle \left.  \Gamma\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
\right\vert \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right\rangle }_{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)
}=\overline{\left\langle \left.  a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
a_{1}\right\vert \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right\rangle _{\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  }}\\
&  =\overline{\left\langle \left.  \phi\right\vert \left(  a_{1}^{\dagger
}a_{2}^{\dagger}a_{2}a_{1}\right)  \phi\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}}=\left\langle \left.  \phi\right\vert \left(  a_{1}^{\dagger
}a_{2}^{\dagger}a_{2}a_{1}\right)  \phi\right\rangle _{\mathcal{H}%
_{\mathcal{F}}}=0
\end{align}


\item
\begin{gather}
\mathcal{M}_{\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\varphi}\right\vert }\left(  \Gamma\right) \\
\parallel\\
