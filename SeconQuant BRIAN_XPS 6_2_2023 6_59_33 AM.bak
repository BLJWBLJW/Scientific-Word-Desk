\begin{definition}
The direct sum of a Hilbert space with its dual
\begin{equation}
\mathcal{H}_{1}^{1}=\mathcal{H}^{1}\oplus\mathcal{H}^{1d}.
\end{equation}

\end{definition}

\begin{remark}
The exterior product "$\wedge"$ \underline{I\emph{S\ NOT}} a skew tensor
product for ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ as
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \cong%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \subset%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  {\large \wedge}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \,=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \,\,{\LARGE \subset\,}%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,
\end{equation}
but \emph{IT IS} a skew tensor product for $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{1}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{1}^{1}\right)  \equiv%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  $ as
\begin{align}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &  \cong%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \widehat{\otimes}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right) \\
\qquad &  \left.  \overset{\bigtriangleup}{=}\right.
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \wedge%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,
\end{align}
i.e.
\begin{equation}
\mathcal{H}_{1}^{1}\widehat{\otimes}\mathcal{H}_{1}^{1}=\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  \widehat{\otimes}\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  =\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)  {\Large \wedge}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)
\end{equation}
and one has the isomorphism
\begin{equation}
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \,\widehat{\otimes
}\,\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \cong\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \otimes\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}

\end{remark}

\begin{theorem}%
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  {\large \wedge}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \,=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}

\end{theorem}

\begin{proof}
\begin{enumerate}
\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\left\{
%TCIMACRO{\tbigoplus \limits_{k_{1},\cdots,k_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{k_{1},\cdots,k_{n}}}
%EndExpansion
\left(  \mathcal{H}^{k_{1}}\wedge\cdots\wedge\mathcal{H}^{k_{n}}\right)
\right\}  ,
\end{equation}
where
\begin{align}
k_{1}  &  =\left\{
\begin{array}
[c]{c}%
1\\
1d
\end{array}
\right. \\
&  \vdots\\
k_{n}  &  =\left\{
\begin{array}
[c]{c}%
1\\
1d
\end{array}
\right.  .
\end{align}


\item
\begin{equation}
\mathcal{H}^{k_{1}}\wedge\cdots\wedge\mathcal{H}^{k_{n}}=\mathcal{H}^{j_{1}%
}\wedge\cdots\wedge\mathcal{H}^{j_{n}}%
\end{equation}
where
\begin{align}
j_{1}  &  =\left\{
\begin{array}
[c]{c}%
1\\
1d
\end{array}
\right. \\
&  \vdots\\
j_{n}  &  =\left\{
\begin{array}
[c]{c}%
1\\
1d
\end{array}
\right.  .
\end{align}


\item
\begin{equation}
\mathcal{H}^{k_{1}}\wedge\cdots\wedge\mathcal{H}^{k_{n}}=\mathcal{H}^{p}%
\wedge\mathcal{H}^{\left(  n-p\right)  d},\,0\leq p\leq n\,,\forall\left\{
k_{1},\cdots,k_{n}\right\}  .
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{H}^{p}\wedge\mathcal{H}^{\left(  n-p\right)  d}%
\end{equation}


\item Hence
\begin{equation}
\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  {\large \wedge}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  \,=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{H}^{p}\wedge\mathcal{H}^{\left(  n-p\right)  d}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \blacksquare.
\end{equation}

\end{enumerate}
\end{proof}

\begin{remark}%
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \subset%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \wedge%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\vert x\right\rangle \wedge\left\vert y^{d}\right\rangle =\left\vert
x\right\rangle \wedge\left\langle y\right\vert \in%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \wedge%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)
\end{equation}
and can expanded as%
\begin{gather}
\left\vert x\right\rangle \wedge\left\vert y^{d}\right\rangle =\frac{1}%
{2}\left(  \left\vert x\right\rangle \otimes\left\vert y^{d}\right\rangle
-\left\vert y^{d}\right\rangle \otimes\left\vert x\right\rangle \right)
\in\left[  \mathcal{H}^{1}\otimes\mathcal{H}^{1d}\right]  \oplus\left[
\mathcal{H}^{1d}\otimes\mathcal{H}^{1}\right] \\
\cap\\
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \otimes\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =\left[  \mathcal{H}^{1}%
\otimes\mathcal{H}^{1}\right]  \oplus\left[  \mathcal{H}^{1}\otimes
\mathcal{H}^{1d}\right]  \oplus\left[  \mathcal{H}^{1d}\otimes\mathcal{H}%
^{1}\right]  \oplus\left[  \mathcal{H}^{1d}\otimes\mathcal{H}^{1d}\right]  ,
\end{gather}
but%
\begin{equation}
\left\vert x\right\rangle \wedge\left\vert y^{d}\right\rangle \notin%
\mathcal{H}^{1}\otimes\mathcal{H}^{1d},
\end{equation}
i.e.
\begin{equation}
\left\vert x\right\rangle \wedge\left\langle y\right\vert \notin%
\mathcal{H}^{1}\otimes\mathcal{H}^{1d}\subset%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\vert x_{1}\right\rangle \otimes\left\vert y_{1}^{d}\right\rangle
=\left\vert x_{1}\right\rangle \otimes\left\langle y_{1}\right\vert
\neq\left\vert x_{1}\right\rangle \wedge\left\vert y_{1}^{d}\right\rangle
\leftrightarrow\left\vert x_{1}\right\rangle \wedge\left\langle y_{1}%
\right\vert .
\end{equation}

\end{remark}

\begin{definition}
The algebraic isomorphisms%
\begin{equation}
\mathfrak{F}:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
and
\begin{equation}
\mathfrak{E}:{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
that are inverse to each other i.e.
\begin{equation}
\mathfrak{F}^{-1}=\mathfrak{E}%
\end{equation}
are described by Greu$\beta,$ Multilinear Algebra, Theorem 5.15.1, p120.
\end{definition}

\begin{lemma}
The space $\mathcal{B}_{00asa}\left(  \mathcal{H}\right)  $ linearly generates
$\mathcal{B}_{00}\left(  \mathcal{H}\right)  $
\end{lemma}

\begin{proof}
Any operator $X\in\mathcal{B}_{00}\left(  \mathcal{H}\right)  $ has the
expansion
\begin{equation}
X=X_{asa}+iX_{asa}=X_{asa}+X_{sa},
\end{equation}
where
\begin{equation}
X_{asa},X_{sa}\in\mathcal{B}_{00a}\left(  \mathcal{H}^{1}\right)  ,
\end{equation}
as
\begin{equation}
X_{asa}^{\dagger}=-X_{asa}%
\end{equation}
and
\begin{equation}
\left(  iX_{asa}\right)  ^{\dagger}=\left(  iX_{asa}\right)  .
\end{equation}

\end{proof}

\begin{lemma}%
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}\right)  =\mathcal{B}_{00asa}\left(
\mathcal{H}\right)  +_{\mathbb{R}}\mathcal{B}_{00sa}\left(  \mathcal{H}%
\right)  =\mathcal{B}_{00asa}\left(  \mathcal{H}\right)  \oplus_{\mathbb{R}%
}\mathcal{B}_{00sa}\left(  \mathcal{H}\right)  .
\end{equation}

\end{lemma}

\begin{remark}%
\begin{equation}
X=\frac{1}{2}\left\{  \left(  X+X^{\dagger}\right)  +\left(  X-X^{\dagger
}\right)  \right\}  =\frac{1}{2}\left\{  X_{sa}+X_{as}\right\}  ,
\end{equation}

\end{remark}

\begin{proof}
\begin{definition}
The map $\Xi_{\mathcal{HH}^{d}}$%
\begin{equation}
\Xi_{\mathcal{HH}^{d}}\left(  \overset{}{\left\vert x\right\rangle
\otimes\left\langle y\right\vert }\right)  =\left\vert x\right\rangle
\left\langle y\right\vert ,\quad\left\vert x\right\rangle \in\mathcal{H}%
,\left\langle y\right\vert \in\mathcal{H}^{d}.
\end{equation}

\end{definition}
\end{proof}

\begin{lemma}
$\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}$ is a $\mathbb{C}$-linear isomorphism
$\ $%
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}:\mathcal{H}^{1}\otimes\mathcal{H}%
^{1d}\rightarrow\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{lemma}

\begin{notation}
In the following we often do not distinguish between the mixed exterior
algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{\mathcal{F}}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{\mathcal{F}}^{d}\right)  $ and its isomorphic image
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  =\Xi_{\mathcal{H}%
_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left(  \overset{}{%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{\mathcal{F}}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{\mathcal{F}}^{d}\right)  }\right)
\end{equation}
and thus use the same symbols $\bullet$ and $\boxtimes$ for the products in
$\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ and $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{\mathcal{F}}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{\mathcal{F}}^{d}\right)  .$
\end{notation}

\begin{definition}
The map $\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}%
\in\mathcal{B}\left(  \overset{}{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  },\overset{}{%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  }\right)  $ is induced by $\Xi_{\mathcal{H}%
^{1}\mathcal{H}^{1d}}$
\begin{align}
\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left(
\overset{}{\left\vert x_{p_{1}}\wedge\cdots\wedge x_{p_{k}}\right\rangle
\otimes\left\langle y_{q_{1}}\wedge\cdots\wedge y_{q_{l}}\right\vert }\right)
&  =\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left(
\overset{}{\left\vert x_{p_{1}}\right\rangle \otimes\left\langle y_{q_{1}%
}\right\vert \bullet\cdots\bullet\left\vert x_{p_{k}}\right\rangle
\otimes\left\langle y_{q_{l}}\right\vert }\right)  \\
&  =\left(  \Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \overset{}{\left\vert
x_{p_{1}}\right\rangle \otimes\left\langle y_{q_{1}}\right\vert }\right)
\right)  \bullet\cdots\bullet\left(  \Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}%
}\left(  \overset{}{\left\vert x_{p_{k}}\right\rangle \otimes\left\langle
y_{q_{l}}\right\vert }\right)  \right)  ,\quad0\leq k,l\leq r
\end{align}
is the extension of $\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}$ to $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .$
\end{definition}

\begin{example}%
\begin{gather}
\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left(
\overset{}{\left\vert x_{1}\wedge\cdots\wedge x_{5}\right\rangle
\otimes\left\langle y_{1}\wedge\cdots\wedge y_{8}\right\vert }\right)
=\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left(
\overset{}{\left\vert x_{1}\right\rangle \otimes\left\langle y_{1}\right\vert
\bullet\cdots\bullet\left\vert x_{5}\right\rangle \otimes\left\langle
y_{5}\right\vert \bullet\left\vert \phi\right\rangle \otimes\left\langle
y_{6}\right\vert \bullet\cdots\bullet\left\vert \phi\right\rangle
\otimes\left\langle y_{8}\right\vert }\right)  \\
=\left(  \Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \overset{}{\left\vert
x_{1}\right\rangle \otimes\left\langle y_{1}\right\vert }\right)  \right)
\bullet\cdots\bullet\left(  \Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(
\overset{}{\left\vert x_{5}\right\rangle \otimes\left\langle y_{5}\right\vert
}\right)  \right)  \bullet\left(  \Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(
\overset{}{\left\vert \phi\right\rangle \otimes\left\langle y_{6}\right\vert
}\right)  \right)  \bullet\cdots\bullet\left(  \Xi_{\mathcal{H}^{1}%
\mathcal{H}^{1d}}\left(  \overset{}{\left\vert \phi\right\rangle
\otimes\left\langle y_{8}\right\vert }\right)  \right)  \\
=\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert \bullet
\cdots\bullet\left\vert x_{5}\right\rangle \left\langle y_{5}\right\vert
\bullet\left\vert \phi\right\rangle \left\langle y_{6}\right\vert
\bullet\cdots\bullet\left\vert \phi\right\rangle \left\langle y_{8}\right\vert
.
\end{gather}

\end{example}

\begin{remark}%
\begin{align}
\left\vert x_{p}\right\rangle \left\langle \phi\right\vert @\left\vert
x_{q}\right\rangle \left\langle \phi\right\vert  &  =-\left\vert x_{p}\wedge
x_{q}\right\rangle \left\langle \phi\right\vert \\
\left\vert x_{p}\right\rangle \left\langle \phi\right\vert @\left\vert
\phi\right\rangle \left\langle x_{q}\right\vert  &  =\ \left\vert
x_{p}\right\rangle \left\langle x_{q}\right\vert \\
\left\vert \phi\right\rangle \left\langle x_{p}\right\vert @\left\vert
\phi\right\rangle \left\langle x_{q}\right\vert  &  =-\ \left\vert
\phi\right\rangle \left\langle x_{p}\wedge x_{q}\right\vert \\
\left\vert x_{p_{1}}\right\rangle \left\langle x_{q_{1}}\right\vert
@\left\vert x_{p_{2}}\right\rangle \left\langle x_{q_{2}}\right\vert  &
=\left(  -1\right)  ^{_{p_{2}q_{1}}}\left\vert x_{p_{1}}\wedge x_{p_{2}%
}\right\rangle \left\langle x_{q_{1}}\wedge x_{q_{2}}\right\vert =\left(
-1\right)  ^{_{p_{2}q_{1}}}\left\vert x_{p_{1}}\right\rangle \left\langle
x_{q_{1}}\right\vert \cdot\left\vert x_{p_{2}}\right\rangle \left\langle
x_{q_{2}}\right\vert
\end{align}

\end{remark}

\begin{definition}
The \emph{algebraic map} $\Omega\in\mathcal{B}\left(  {\huge \wedge}\left(
\mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  ,{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \right)  $
\begin{equation}
\Omega:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  \mathcal{\ }%
\end{equation}
is given by%
\begin{equation}
\Omega\left(  \left\vert x_{p_{1}}\right\rangle \left\langle x_{q_{1}%
}\right\vert @\left\vert x_{p_{2}}\right\rangle \left\langle x_{q_{2}%
}\right\vert \right)  =\left(  -1\right)  ^{_{p_{2}q_{1}}}\left\vert x_{p_{1}%
}\right\rangle \left\langle x_{q_{1}}\right\vert \cdot\left\vert x_{p_{2}%
}\right\rangle \left\langle x_{q_{2}}\right\vert .
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
\mathfrak{F=E}^{-1}:{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
and
\begin{equation}
\mathfrak{E=F}^{-1}:{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{remark}

\begin{remark}
As a \emph{linear maps}
\begin{equation}
\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left\{
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  \right\}  =\Xi_{\mathcal{H}_{\mathcal{F}%
}\mathcal{H}_{\mathcal{F}}^{d}}\left\{  \mathfrak{E}\left(  {\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \right)  \right\}
\equiv\left[  \overset{}{\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}%
_{\mathcal{F}}^{d}}\circ\mathfrak{E}}\right]  \left\{  {\huge \wedge}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \right\}  =\mathcal{B}%
_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}

\end{remark}

\begin{theorem}%
\begin{equation}
\Xi_{\mathcal{H}_{\mathcal{F}}\mathcal{H}_{\mathcal{F}}^{d}}\left\{
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  \right\}  =\mathcal{B}_{00}\left(
\mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}

\end{theorem}

\begin{proof}%
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)   &  =\left\{  {\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
,@\right\} \\
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(
\mathcal{H}^{1d}\right)   &  =\left\{  {\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
,\bullet\right\}
\end{align}%
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \wedge{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  ={\huge \wedge}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)
\end{equation}%
\begin{gather}
\left\vert x\right\rangle \wedge\left\vert y^{d}\right\rangle =\frac{1}%
{2}\left(  \left\vert x\right\rangle \otimes\left\vert y^{d}\right\rangle
-\left\vert y^{d}\right\rangle \otimes\left\vert x\right\rangle \right)
\in\left[  \mathcal{H}^{1}\otimes\mathcal{H}^{1d}\right]  \oplus\left[
\mathcal{H}^{1d}\otimes\mathcal{H}^{1}\right] \\
\cap\\
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \otimes\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =\left[  \mathcal{H}^{1}%
\otimes\mathcal{H}^{1}\right]  \oplus\left[  \mathcal{H}^{1}\otimes
\mathcal{H}^{1d}\right]  \oplus\left[  \mathcal{H}^{1d}\otimes\mathcal{H}%
^{1}\right]  \oplus\left[  \mathcal{H}^{1d}\otimes\mathcal{H}^{1d}\right]  .
\end{gather}

\end{proof}

\begin{summary}
\begin{enumerate}
\item $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  $ is an algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  $ wrt "$\cdot"$ i.e,
\begin{gather}
\left(  \left\vert x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle \otimes\left\vert
y_{1q_{1}}^{d}\wedge y_{2q_{2}}^{d}\right\rangle \right)  {\Large \cdot
}\left(  \left\vert x_{3p_{3}}\wedge x_{4p_{4}}\right\rangle \otimes\left\vert
y_{3q_{1}}^{d}\wedge y_{4q_{2}}^{d}\right\rangle \right)  =\left(  \left\vert
x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle \left\langle y_{1q_{1}}\wedge
y_{2q_{2}}\right\vert \right)  {\Large \cdot}\left(  \left\vert x_{3p_{1}%
}\wedge x_{4p_{2}}\right\rangle \left\langle y_{3q_{1}}\wedge y_{4q_{2}%
}\right\vert \right) \\
=\left\vert x_{1p_{1}}\wedge x_{2p_{2}}\wedge x_{3p_{3}}\wedge x_{4p_{4}%
}\right\rangle \left\langle y_{1q_{1}}\wedge y_{2q_{2}}\wedge y_{3q_{3}}\wedge
y_{4q_{4}}\right\vert .
\end{gather}


\item $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  $ is an algebra $\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  \widehat{\otimes}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  $ wrt "$@"$ i.e.,
\begin{gather}
\left(  \left\vert x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle \otimes\left\vert
y_{1q_{1}}^{d}\wedge y_{2q_{2}}^{d}\right\rangle \right)  @\left(  \left\vert
x_{3p_{3}}\wedge x_{4p_{4}}\right\rangle \otimes\left\vert y_{3q_{1}}%
^{d}\wedge y_{4q_{2}}^{d}\right\rangle \right)  =\left(  \left\vert x_{1p_{1}%
}\wedge x_{2p_{2}}\right\rangle \left\langle y_{1q_{1}}\wedge y_{2q_{2}%
}\right\vert \right)  @\left(  \left\vert x_{3p_{3}}\wedge x_{4p_{4}%
}\right\rangle \left\langle y_{3q_{3}}\wedge y_{4q_{4}}\right\vert \right) \\
=\left(  -1\right)  ^{\left(  p_{3}+p_{4}\right)  \left(  q_{1}+q_{2}\right)
}\left\vert x_{1p_{1}}\wedge x_{2p_{2}}\wedge x_{3p_{3}}\wedge x_{4p_{4}%
}\right\rangle \left\langle y_{1q_{1}}\wedge y_{2q_{2}}\wedge y_{3q_{3}}\wedge
y_{4q_{4}}\right\vert .
\end{gather}


\item $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  $ is an algebra $\mathcal{F=B}\left(
\mathcal{H}_{\mathcal{F}}\right)  ,$ (actually $\mathcal{B}_{00}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ before limits are performed), wrt
"$\circ"$ i.e.,%
\begin{gather}
\left(  \left\vert x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle \otimes\left\vert
y_{1q_{1}}^{d}\wedge y_{2q_{2}}^{d}\right\rangle \right)  {\Large \circ
}\left(  \left\vert x_{3p_{1}}\wedge x_{4p_{2}}\right\rangle \otimes\left\vert
y_{3q_{1}}^{d}\wedge y_{4q_{2}}^{d}\right\rangle \right)  =\left(  \left\vert
x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle \left\langle y_{1q_{1}}^{d}\wedge
y_{2q_{2}}^{d}\right\vert \right)  {\Large \circ}\left(  \left\vert x_{3p_{1}%
}\wedge x_{4p_{2}}\right\rangle \left\langle y_{3q_{1}}^{d}\wedge y_{4q_{2}%
}^{d}\right\vert \right) \\
=\left(  \left\vert x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle \otimes\left\vert
y_{3q_{1}}^{d}\wedge y_{4q_{2}}^{d}\right\rangle \right)  \left\langle \left.
y_{1q_{1}}\wedge y_{2q_{2}}\right\vert x_{3p_{1}}\wedge x_{4p_{2}%
}\right\rangle =\left(  \left\vert x_{1p_{1}}\wedge x_{2p_{2}}\right\rangle
\left\langle y_{3q_{1}}\wedge y_{4q_{2}}\right\vert \right)  \left\langle
\left.  y_{1q_{1}}\wedge y_{2q_{2}}\right\vert x_{3p_{1}}\wedge x_{4p_{2}%
}\right\rangle .
\end{gather}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  {\large \wedge}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{H}^{p}\wedge\mathcal{H}^{\left(  n-p\right)  d}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\left\{
%TCIMACRO{\tbigoplus \limits_{k_{1},\cdots,k_{n}}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{k_{1},\cdots,k_{n}}}
%EndExpansion
\left(  \mathcal{H}^{k_{1}}\wedge\cdots\wedge\mathcal{H}^{k_{n}}\right)
\right\}  .
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  \otimes\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  \,=\left(
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  \otimes\left(
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion
\left(
%TCIMACRO{\tbigwedge \nolimits^{m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{m}}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  .
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\overset{\text{algebraic}}{\cong}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  \widehat{\otimes}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  .
\end{equation}
wrt "$\wedge$" and "$@$".

\item
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits^{m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{m}}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \overset{\mathbb{C}\text{-linear}}{\cong%
}\mathcal{B}_{00}\left(  \mathcal{H}^{n},\mathcal{H}^{m}\right)  .
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \overset{\mathbb{C}\text{-linear}}{\cong%
}\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}


\item
\begin{equation}
\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  \widehat{\otimes}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  \overset{\mathbb{C}\text{-linear}%
}{\cong}\mathcal{B}_{00}\left(  \mathcal{H}_{\mathcal{F}}\right)  .
\end{equation}

\end{enumerate}
\end{summary}

\subsection{Mixed Exterior Algebra}

\begin{definition}
The mixed exterior algebra generated by a vector space $V$
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  .
\end{equation}
has a multiplication "$\cdot$" determined by the equation
\begin{gather}
\left(  u\otimes u^{d}\right)  {\LARGE \cdot}\left(  v\otimes v^{d}\right)
=\left(  u\wedge v\right)  \otimes\left(  u^{d}\wedge v^{d}\right) \\
{\LARGE \cdot}:%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  \times%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  \rightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  .
\end{gather}
$%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  $ is a graded associative algebra with unit
$I_{\left(  V,V^{d}\right)  }=I_{{\huge \wedge}\left(  V\right)  }\otimes
I_{{\huge \wedge}\left(  V^{d}\right)  }$ and is generated by the elements
$I_{{\huge \wedge}\left(  V\right)  }\otimes I_{{\huge \wedge}\left(
V^{d}\right)  },$ $I_{{\huge \wedge}\left(  V\right)  }\otimes v^{d}$ and
$v\otimes I_{{\huge \wedge}\left(  V^{d}\right)  }.$
\end{definition}

\begin{notation}
When $V$ and $V^{d}$ are Hilbert spaces the identities $I_{{\huge \wedge
}\left(  V\right)  }$ and $I_{{\huge \wedge}\left(  V^{d}\right)  }$ are
$\left\vert \phi\right\rangle $ and $\left\langle \phi\right\vert .$
\end{notation}

If $w\in%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  ,$ one defines $w^{k}\,($ $k\geq1)$ by
\begin{equation}
w^{k}=\frac{1}{k!}\overset{k}{\overbrace{w{\LARGE \cdot\cdot\cdot\cdot}w}%
},\,k\geq1
\end{equation}
and
\begin{equation}
w^{0}=I_{\left(  V,V^{d}\right)  }=I_{{\huge \wedge}\left(  V\right)  }\otimes
I_{{\huge \wedge}\left(  V^{d}\right)  }.
\end{equation}
$%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  $ has a \emph{bigradation} given by the subspaces
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits_{q}^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q}^{p}}
%EndExpansion
\left(  V,V^{d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p}}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge \nolimits^{q}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q}}
%EndExpansion
\left(  V^{d}\right)
\end{equation}
and can be expanded as
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p,q\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p,q\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits_{q}^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q}^{p}}
%EndExpansion
\left(  V,V^{d}\right)  .
\end{equation}
The even subalgebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  _{e}$ is given by
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  _{e}=%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits_{p}^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p}^{p}}
%EndExpansion
\left(  V,V^{d}\right)  .
\end{equation}


\begin{remark}%
\begin{align}
&
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
\left(  V\right)  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\vert \phi\right\rangle \right\} \\
&
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
\left(  V^{d}\right)  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\langle \phi\right\vert \right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert \phi^{d}\right\rangle \right\} \\
&
%TCIMACRO{\tbigwedge \nolimits_{0}^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{0}}
%EndExpansion
\left(  V,V^{d}\right)  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\vert \phi\right\rangle \otimes\left\langle \phi\right\vert \right\}
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert \phi
\right\rangle \left\langle \phi\right\vert \right\}  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \phi\right\rangle
\otimes\left\vert \phi^{d}\right\rangle \right\}  .
\end{align}

\end{remark}

\begin{remark}
The multiplication "${\LARGE \cdot}$" restricted to even subalgebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  _{e}$ can be identified with the box product
"$\boxtimes$".
\end{remark}

Clearly
\begin{equation}
w_{1}{\LARGE \cdot}w_{2}=\left(  -1\right)  ^{p_{1}p_{2}+q_{1}q_{2}}%
w_{2}{\LARGE \cdot}w_{1},\quad w_{1}\in%
%TCIMACRO{\tbigwedge \nolimits_{q_{1}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{1}}^{p_{1}}}
%EndExpansion
\left(  V,V^{d}\right)  ,w_{2}\in%
%TCIMACRO{\tbigwedge \nolimits_{q_{2}}^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{2}}^{p_{2}}}
%EndExpansion
\left(  V,V^{d}\right)  ,
\end{equation}
hence in the even subalgebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  _{e}$
\begin{equation}
w_{1}{\LARGE \cdot}w_{2}=\left(  -1\right)  ^{p_{1}p_{2}+q_{1}q_{2}}%
w_{2}{\LARGE \cdot}w_{1}=\left(  -1\right)  ^{2p_{1}p_{2}}w_{2}{\LARGE \cdot
}w_{1}=w_{2}{\LARGE \cdot}w_{1},\quad w_{1}\in%
%TCIMACRO{\tbigwedge \nolimits_{p_{1}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{1}}^{p_{1}}}
%EndExpansion
\left(  V,V^{d}\right)  ,w_{2}\in%
%TCIMACRO{\tbigwedge \nolimits_{p_{2}}^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{2}}^{p_{2}}}
%EndExpansion
\left(  V,V^{d}\right)
\end{equation}
and thus $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  _{e}$ is a commutative algebra i.e.
\begin{equation}
w_{1}\boxtimes w_{2}=w_{2}\boxtimes w_{1},
\end{equation}
where
\begin{equation}
\boxtimes{\LARGE =}\left.  {\LARGE \cdot}\right\vert _{%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  _{e}}.
\end{equation}


\begin{remark}
Since
\begin{equation}
p_{1}p_{2}+q_{1}q_{2}\equiv\left(  p_{1}+q_{1}\right)  p_{2}+\left(
p_{2}+q_{2}\right)  p_{1}\quad\operatorname{Mod}\left(  2\right)
\end{equation}
it follows that $p_{1}p_{2}+q_{1}q_{2}$ is even whenever $\left(  p_{1}%
+q_{1}\right)  $ and $\left(  p_{2}+q_{2}\right)  $ are and that
\begin{equation}
w_{1}{\LARGE \cdot}w_{2}=w_{2}{\LARGE \cdot}w_{1}%
\end{equation}
if $\left(  p_{1}+q_{1}\right)  $ and $\left(  p_{2}+q_{2}\right)  $ are even.
In this case one has the binomial expansion
\begin{equation}
\left(  w_{1}+w_{2}\right)  ^{k}=\sum_{i+j=k}w_{1}^{i}{\LARGE \cdot}w_{2}^{j}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
w_{1}{\LARGE \cdot}w_{2}=\left(  -1\right)  ^{p_{1}p_{2}+q_{1}q_{2}}%
w_{2}{\LARGE \cdot}w_{1};\quad w_{1}\in%
%TCIMACRO{\tbigwedge \nolimits_{q_{1}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{1}}^{p_{1}}}
%EndExpansion
\left(  V,V^{d}\right)  ,w_{2}\in%
%TCIMACRO{\tbigwedge \nolimits_{q_{2}}^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{2}}^{p_{2}}}
%EndExpansion
\left(  V,V^{d}\right)
\end{equation}
should be contrasted to
\begin{equation}
w_{1}{\LARGE \cdot}w_{2}=\left(  -1\right)  ^{p_{1}p_{2}}w_{2}{\LARGE \cdot
}w_{1}\quad w_{1}\in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{p_{1}}}
%EndExpansion
V,\quad w_{2}\in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{p_{2}}}
%EndExpansion
V
\end{equation}
and
\begin{equation}
w_{1}{\LARGE \cdot}w_{2}=\left(  -1\right)  ^{p+q}w_{2}{\LARGE \cdot}%
w_{1}\quad w_{1}\in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{p}}
%EndExpansion
V,\quad w_{2}\in%
%TCIMACRO{\tbigwedge \nolimits_{q}^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q}^{0}}
%EndExpansion
V^{d}.
\end{equation}

\end{remark}

\begin{example}%
\begin{equation}
\left\vert v\right\rangle \left\langle \phi\right\vert {\LARGE \cdot
}\left\vert \phi\right\rangle \left\langle w\right\vert =\left\vert
\phi\right\rangle \left\langle w\right\vert {\LARGE \cdot}\left\vert
v\right\rangle \left\langle \phi\right\vert =\left\vert v\right\rangle
\left\langle w\right\vert .
\end{equation}

\end{example}

\begin{example}%
\begin{equation}
\left\vert v_{1}\right\rangle \left\langle w_{1}\right\vert {\LARGE \cdot
}\left\vert v_{2}\right\rangle \left\langle w_{2}\right\vert =\left\vert
v_{2}\right\rangle \left\langle w_{2}\right\vert {\LARGE \cdot}\left\vert
v_{1}\right\rangle \left\langle w_{1}\right\vert \equiv\left\vert
v_{1}\right\rangle \left\langle w_{1}\right\vert \boxtimes\left\vert
v_{2}\right\rangle \left\langle w_{2}\right\vert =\left\vert v_{2}%
\right\rangle \left\langle w_{2}\right\vert \boxtimes\left\vert v_{1}%
\right\rangle \left\langle w_{1}\right\vert .
\end{equation}

\end{example}

\begin{lemma}
The mixed exterior algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  $ is algebraically isomorphic to $\mathcal{B}%
_{00}\left(  V\right)  $ i.e. $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  \cong\mathcal{B}_{00}\left(  V\right)  $ through the
isomorphism $\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}$
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}:%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  \rightarrow\mathcal{B}_{00}\left(  V\right)
\end{equation}
given by%
\begin{equation}
\left[  \Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  v_{1}\otimes
w^{d}\right)  \right]  \left(  v_{2}\right)  =\left\vert v_{1}\right\rangle
w^{d}\left(  v_{2}\right)  .
\end{equation}

\end{lemma}

\begin{corollary}
If $V$ is a Hilbert space
\begin{equation}
\left\vert v_{1}\right\rangle w^{d}\left(  v_{2}\right)  =\left\vert
v_{1}\right\rangle \left\langle w\right\vert \left\vert v_{2}\right\rangle
=\left\langle \left.  w\right\vert v_{2}\right\rangle \left\vert
v_{1}\right\rangle .
\end{equation}

\end{corollary}

\begin{remark}
How is the tensor product $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V,V^{d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\ \right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \ V^{d}\right)  $ related to the skew tensor product $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\ \right)  \widehat{\otimes}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \ V^{d}\right)  $ and the exterior product $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\ \right)  \wedge%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \ V^{d}\right)  ?$

\begin{description}
\item
\begin{enumerate}
\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \wedge%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\oplus\ V^{d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{V}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{V}=V\oplus\ V^{d}.
\end{equation}


\item In detail
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \wedge%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  =\mathcal{A}_{p+q}\left\{
%TCIMACRO{\tbigotimes \limits_{0\leq j\leq p}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{0\leq j\leq p}}
%EndExpansion
V\otimes%
%TCIMACRO{\tbigotimes \limits_{0\leq j\leq q}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{0\leq j\leq q}}
%EndExpansion
V^{d}\right\}  =\mathcal{A}_{p+q}\left\{  \mathcal{A}_{p}\left\{
%TCIMACRO{\tbigotimes \limits_{0\leq j\leq p}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{0\leq j\leq p}}
%EndExpansion
V\right\}  \otimes\mathcal{A}_{q}\left\{
%TCIMACRO{\tbigotimes \limits_{0\leq j\leq q}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{0\leq j\leq q}}
%EndExpansion
V^{d}\right\}  \right\}  =\mathcal{A}_{p+q}\left\{
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \right\}
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V^{d}\right)  \not \subset
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  \wedge%
