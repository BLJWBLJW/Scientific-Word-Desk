& =\sum_{0\leq N\leq r}\binom{N+P}{P}^{\frac{1}{2}}\binom{N+Q}{Q}^{\frac{1}%
{2}}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{P}}\right\rangle \left\langle
\varphi_{l_{1}}\cdots\varphi_{l_{Q}}\right\vert \bullet P_{\mathcal{H}^{N}}\\
& =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert
\varphi_{k_{1}}\cdots\varphi_{k_{P}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{l_{1}}\cdots\varphi_{l_{Q}}\varphi
_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\end{align}


\item
\begin{align}
& \Gamma\left(  \left\vert \varphi_{k_{1}}\cdots\varphi_{k_{P}}\right\rangle
\left\langle \varphi_{l_{1}}\cdots\varphi_{l_{Q}}\right\vert \right)
=\sum_{0\leq P,Q\leq r}\Gamma^{P,Q}\left(  \left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{P}}\right\rangle \left\langle \varphi_{l_{1}}\cdots
\varphi_{l_{Q}}\right\vert \right)  \\
& =\sum_{0\leq P,Q\leq r}\sum_{0\leq N\leq r}\binom{N+P}{P}^{\frac{1}{2}%
}\binom{N+Q}{Q}^{\frac{1}{2}}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{P}%
}\right\rangle \left\langle \varphi_{l_{1}}\cdots\varphi_{l_{Q}}\right\vert
\bullet P_{\mathcal{H}^{N}}\\
& =\sum_{0\leq P,Q\leq r}\sum_{0\leq N\leq r}\binom{N+P}{P}^{\frac{1}{2}%
}\binom{N+Q}{Q}^{\frac{1}{2}}\Gamma_{PQ}^{N+P,N+Q}\left(  \left\vert
\varphi_{k_{1}}\cdots\varphi_{k_{P}}\right\rangle \left\langle \varphi_{l_{1}%
}\cdots\varphi_{l_{Q}}\right\vert \right)  \\
& =\sum_{0\leq P,Q\leq r}\sum_{0\leq N\leq r}\sqrt{\binom{N+P}{P}}\sqrt
{\binom{N+Q}{Q}}\Gamma_{PQ}^{N+P,N+Q}\left(  \left\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{P}}\right\rangle \left\langle \varphi_{l_{1}}\cdots
\varphi_{l_{Q}}\right\vert \right)  \\
& =\sum_{0\leq P,Q\leq r}\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots
<j_{N}\leq r}\left\vert \varphi_{k_{1}}\cdots\varphi_{k_{P}}\varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{l_{1}}\cdots
\varphi_{l_{Q}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\end{align}


