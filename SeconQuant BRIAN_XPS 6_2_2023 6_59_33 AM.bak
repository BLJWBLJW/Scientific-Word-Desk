\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{22}\right)
^{\dagger}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\Phi}_{1}\right\rangle  & \left\vert \mathbf{\Phi}%
_{2}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{11}\right)
^{\dagger} & \left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{21}\right)  ^{\dagger}\\
\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{21}\right)
^{\dagger} & \left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{22}\right)  ^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\left\langle \mathbf{\Phi}_{1}\right\vert \\
\left\langle \mathbf{\Phi}_{2}\right\vert
\end{array}
\right)  .
\end{align}


\item Operators acting $\mathcal{V}$ in terms of operators acting on
$\mathcal{V}_{1},\mathcal{V}_{2}$
\begin{align}
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X^{\dagger}\right)  _{11}  &  =\left(
%
\begin{array}
[c]{ccc}%
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{11}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{21}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{31}}\\
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{12}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{22}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{32}}\\
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{13}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{23}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{33}}%
\end{array}
\right)  \in\mathcal{B}\left(  \mathcal{V}_{1},\mathcal{V}_{1}\right)
\leftrightarrow\mathcal{M}\left(  3,3,\mathbb{C}\right) \\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X^{\dagger}\right)  _{12}  &  =\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  \mathfrak{X}\right)  _{21}\right)
^{\dagger}=\left(
\begin{array}
[c]{cc}%
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{41}} &
\mathcal{R}_{\boldsymbol{\varphi}}\overline{\left(  X\right)  _{51}}\\
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{42}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{52}}\\
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{43}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{53}}%
\end{array}
\right)  \in\mathcal{B}\left(  \mathcal{V}_{1},\mathcal{V}_{2}\right)
\leftrightarrow\mathcal{M}\left(  3,2,\mathbb{C}\right) \\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X^{\dagger}\right)  _{21}  &  =\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  \mathfrak{X}\right)  _{12}\right)
^{\dagger}=\left(
\begin{array}
[c]{ccc}%
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{14}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{24}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{34}}\\
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{15}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{25}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{35}}%
\end{array}
\right)  \in\mathcal{B}\left(  \mathcal{V}_{2},\mathcal{V}_{1}\right)
\leftrightarrow\mathcal{M}\left(  2,3,\mathbb{C}\right) \\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X^{\dagger}\right)  _{22}  &  =\left(
%
\begin{array}
[c]{cc}%
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{44}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{54}}\\
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{45}} &
\overline{\mathcal{R}_{\boldsymbol{\varphi}}\left(  X\right)  _{55}}%
\end{array}
\right)  \in\mathcal{B}\left(  \mathcal{V}_{2},\mathcal{V}_{2}\right)
\leftrightarrow\mathcal{M}\left(  2,2,\mathbb{C}\right)  .
\end{align}


\item If $X$ is self adjoint i.e. $X=X^{\dagger}$ then%
\begin{align}
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{11}+\mathfrak{R}%
_{\boldsymbol{\Phi}}\left(  X\right)  _{12}+\mathfrak{R}_{\boldsymbol{\Phi}%
}\left(  X\right)  _{21}+\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{22}  &  =\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{11}\right)  ^{\dagger}+\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(
X\right)  _{12}\right)  ^{\dagger}+\left(  \mathfrak{R}_{\boldsymbol{\Phi}%
}\left(  X\right)  _{21}\right)  ^{\dagger}+\left(  \mathfrak{R}%
_{\boldsymbol{\Phi}}\left(  X\right)  _{22}\right)  ^{\dagger}\\
&  \Updownarrow\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{11}  &  =\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{11}\right)  ^{\dagger
}=\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X^{\dagger}\right)  _{11}\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{12}  &  =\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{12}\right)  ^{\dagger
}=\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  \mathfrak{X}^{\dagger
}\right)  \right)  _{21}\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{21}  &  =\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{21}\right)  ^{\dagger
}=\left(  \mathfrak{R}_{\boldsymbol{\Phi}}\left(  \mathfrak{X}^{\dagger
}\right)  \right)  _{12}\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{22}  &  =\left(
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{22}\right)  ^{\dagger
}=\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X^{\dagger}\right)  _{22}.
\end{align}

\end{enumerate}
\end{example}

\item The inner product $\left\langle \left.  v\right\vert Xw\right\rangle $
can be expressed as%
\begin{align}
\left\langle \left.  v\right\vert Xw\right\rangle  &  =\sum_{1\leq j\leq
s}\left\langle \left.  v_{j}\right\vert y_{j}\right\rangle =\sum_{1\leq j\leq
s}\left\langle \left.  \overset{\overset{}{}}{v_{j}}\right\vert \sum_{1\leq
k\leq s}X_{jk}w_{k}\right\rangle =\sum_{1\leq j,k\leq s}\left\langle \left.
v_{j}\right\vert X_{jk}w_{k}\right\rangle =\sum_{1\leq j,k\leq s}%
v_{j}^{\dagger}X_{jk}w_{k}\\
&  =\left(
\begin{array}
[c]{ccc}%
v_{1}^{\dagger} & \cdots & v_{s}^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
X_{11} & \cdots & X_{1s}\\
\vdots & \ddots & \vdots\\
X_{s1} & \cdots & X_{ss}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
w_{1}\\
\vdots\\
w_{s}%
\end{array}
\right)  ;\quad v_{j},w_{j}\in\mathcal{V}_{j},\,X_{jk}\in\mathcal{B}\left(
\mathcal{V}_{j},\mathcal{V}_{k}\right)  ,
\end{align}
where
\begin{equation}
X_{jk}=\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{jk},\quad1\leq
j,k\leq s
\end{equation}
and
\begin{align}
v_{j}  &  =\mathfrak{R}_{\boldsymbol{\Phi}}\left(  v\right)  _{j}\\
w_{j}  &  =\mathfrak{R}_{\boldsymbol{\Phi}}\left(  w\right)  _{j}\\
1  &  \leq j\leq s.
\end{align}


\item The operator space $\mathcal{B}\left(  \mathcal{V}\right)  $ can be
expressed in partitioned form as
\begin{align}
&  \mathcal{B}\left(  \mathcal{V}\right)  \overset{\mathfrak{R}%
_{\boldsymbol{\Phi}}}{{\LARGE \longrightarrow}}\mathcal{M}\left(
s,s,\mathcal{B}\left(  \mathbb{C}^{r}\right)  \right)  \overset{\mathcal{R}%
_{\boldsymbol{\varphi}}}{{\LARGE \longrightarrow}}\mathcal{M}\left(
s,s,\mathcal{M}\left(  r,r,\mathbb{C}\right)  \right) \\
\qquad\qquad &  =\left\{  \left.  \left(
\begin{array}
[c]{ccc}%
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{11} & \cdots &
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{1s}\\
\vdots & \ddots & \vdots\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{s1} & \cdots &
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{ss}%
\end{array}
\right)  \right\vert X_{jk}\in\mathcal{B}\left(  \mathcal{V}_{j}%
,\mathcal{V}_{k}\right)  ,1\leq j,k\leq s\right\}  \subset\mathcal{M}\left(
s,s,\mathcal{B}\left(  \mathcal{V}\right)  \right)  \leftrightarrow
\mathbb{C}^{s}\otimes\mathcal{B}\left(  \mathcal{V}\right)
\end{align}


\item
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  v_{1}\right)  ^{\dagger} & \cdots &
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  v_{s}\right)  ^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{11} & \cdots &
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{1s}\\
\vdots & \ddots & \vdots\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{s1} & \cdots &
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{ss}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  w\right)  _{1}\\
\vdots\\
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  w\right)  _{s}%
\end{array}
\right)  ;\quad\mathfrak{R}_{\boldsymbol{\Phi}}\left(  v\right)
_{j},\mathfrak{R}_{\boldsymbol{\Phi}}\left(  w\right)  _{j}\in\mathcal{V}%
_{j},\,\mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)  _{jk}\in
\mathcal{B}\left(  \mathcal{V}_{j},\mathcal{V}_{k}\right)
\end{equation}


\item If $X$ is self adjoint i.e. $X=X^{\dagger}$ then
\begin{equation}
X=\sum_{1\leq j,k\leq s}\left\vert \boldsymbol{\Phi}_{j}\right\rangle
\left\langle \boldsymbol{\Phi}_{k}\right\vert \mathfrak{R}_{\boldsymbol{\Phi}%
}\left(  X\right)  _{jk}=\sum_{1\leq j,k\leq s}\left(  \left\vert
\boldsymbol{\Phi}_{j}\right\rangle \left\langle \boldsymbol{\Phi}%
_{k}\right\vert \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{jk}\right)  ^{\dagger}=X^{\dagger}%
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
Let $X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ and
\begin{equation}
X=\sum_{0\leq m,n\leq r}\left\vert \boldsymbol{\Phi}_{m}\right\rangle
\left\langle \boldsymbol{\Phi}_{n}\right\vert \mathfrak{R}_{\boldsymbol{\Phi}%
}\left(  X\right)  _{mn},
\end{equation}
where $\left\vert \boldsymbol{\Phi}_{m}\right\rangle \left\langle
\boldsymbol{\Phi}_{n}\right\vert \mathfrak{R}_{\boldsymbol{\varphi}}\left(
X\right)  _{mn}\in\mathcal{B}\left(  \mathcal{H}^{m},\mathcal{H}^{n}\right)  $
then
\begin{equation}
\left\langle v\left\vert X\right.  v\right\rangle _{\mathcal{H}_{\mathcal{F}}%
}=\sum_{0\leq m,n\leq r}\left\langle v_{m}\left\vert \left\vert
\boldsymbol{\Phi}_{m}\right\rangle \left\langle \boldsymbol{\Phi}%
_{n}\right\vert \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{mn}\right.  v_{n}\right\rangle _{\mathcal{H}^{m}}=\sum_{0\leq m,n\leq
r}\left\langle \left\vert \boldsymbol{\Phi}_{m}\right\rangle \mathfrak{R}%
_{\boldsymbol{\Phi}}\left(  v\right)  _{m}\left\vert \left\vert
\boldsymbol{\Phi}_{m}\right\rangle \left\langle \boldsymbol{\Phi}%
_{n}\right\vert \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{mn}\right.  \left\vert \boldsymbol{\Phi}_{n}\right\rangle \mathfrak{R}%
_{\boldsymbol{\Phi}}\left(  v\right)  _{n}\right\rangle _{\mathcal{H}^{m}}%
\end{equation}

\end{remark}

\begin{definition}%
\begin{equation}
X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{+}\Leftrightarrow
\left\langle v\left\vert X\right.  v\right\rangle _{\mathcal{H}_{\mathcal{F}}%
}\geq0\,\forall v\in\mathcal{H}_{\mathcal{F}}.
\end{equation}

\end{definition}

\begin{lemma}%
\begin{equation}
X\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{+}\Leftrightarrow
X=X^{\dagger}=QQ^{\dagger}.
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{align}
X  &  \in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{+}%
\Leftrightarrow\sum_{0\leq m,n\leq r}\left\langle v_{m}\left\vert
X_{mn}\right.  v_{n}\right\rangle _{\mathcal{H}^{m}}\,=\sum_{0\leq m<n\leq
r}\left\{  \left\langle v_{m}\left\vert X_{mn}\right.  v_{n}\right\rangle
_{\mathcal{H}^{m}}+\left\langle v_{n}\left\vert X_{nm}\right.  v_{m}%
\right\rangle _{\mathcal{H}^{n}}\right\}  +\sum_{0\leq m<n\leq r}\left\langle
v_{n}\left\vert X_{nn}\right.  v_{n}\right\rangle _{\mathcal{H}^{n}}\\
&  =\sum_{0\leq m<n\leq r}\left\{  \left\langle v_{m}\left\vert X_{mn}\right.
v_{n}\right\rangle _{\mathcal{H}^{m}}+\left\langle X_{nm}^{\dagger}%
v_{n}\left\vert v_{m}\right.  \right\rangle _{\mathcal{H}^{n}}\right\}
+\frac{1}{2}\sum_{0\leq m<n\leq r}\left\{  \left\langle v_{n}\left\vert
X_{nn}\right.  v_{n}\right\rangle _{\mathcal{H}^{n}}+\left\langle \left.
X_{nn}^{\dagger}v_{n}\right\vert v_{n}\right\rangle _{\mathcal{H}^{n}%
}\right\}  .
\end{align}

\end{lemma}

\begin{lemma}
$X\geq0\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},$ i.e. is
gauge invariant, where
\begin{equation}
X=\sum_{0\leq n\leq r}X_{nn}=\sum_{0\leq n\leq r}X_{n}=\sum_{0\leq n\leq
r}\left\vert \boldsymbol{\Phi}_{n}\right\rangle \left\langle \boldsymbol{\Phi
}_{n}\right\vert \mathfrak{R}_{\boldsymbol{\Phi}}\left(  X\right)
_{n},\,X_{nn}\in\mathcal{B}\left(  \mathcal{H}^{n}\right)
\end{equation}
$\operatorname*{Iff}$
\begin{equation}
X_{nn}\in\mathcal{B}\left(  \mathcal{H}^{n}\right)  \geq0,0\leq n\leq r.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left\langle \left.  v\right\vert Xv\right\rangle =\left\langle \left.
\overset{\overset{}{}}{v}\right\vert \left(  \sum_{0\leq n\leq r}X_{n}\right)
v\right\rangle =\sum_{0\leq n\leq r}\left\langle v\left\vert X_{n}\right.
v\right\rangle =\sum_{0\leq n\leq r}\left\langle v_{n}\left\vert X_{n}\right.
v_{n}\right\rangle .
\end{equation}
Recall the
\end{proof}

\begin{definition}
Let $M\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{m}\right)
,\mathcal{B}\left(  \mathcal{H}^{n}\right)  \right)  $ then $M\geq0$ if
\begin{equation}
\left\langle \left.  Y\right\vert M\left(  X\right)  \right\rangle
_{\mathcal{B}\left(  \mathcal{H}^{m}\right)  }\geq0\,\forall X\in
\mathcal{B}\left(  \mathcal{H}^{n}\right)  _{+},\forall Y\in\mathcal{B}\left(
\mathcal{H}^{m}\right)  _{+}^{d}\geq0.
\end{equation}

\end{definition}

\begin{corollary}
As $\Gamma_{m}^{n}$ and $L_{n}^{m}$ are positive
\begin{equation}
\left\langle \left.  Y\right\vert L_{n}^{m}\left(  X\right)  \right\rangle
_{\mathcal{B}\left(  \mathcal{H}^{m}\right)  }\geq0\,\forall X\in
\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{+},\forall Y\in
\mathcal{B}\left(  \mathcal{H}^{m}\right)  _{+}^{d}\geq0
\end{equation}
and
\begin{equation}
\left\langle \left.  \Gamma_{m}^{n}\left(  Y\right)  \right\vert
X\right\rangle _{\mathcal{B}\left(  \mathcal{H}^{m}\right)  }\geq0\,\forall
X\in\mathcal{B}_{1}\left(  \mathcal{H}^{n}\right)  _{+},\forall Y\in
\mathcal{B}\left(  \mathcal{H}^{m}\right)  _{+}^{d}\geq0.
\end{equation}

\end{corollary}

\begin{lemma}
If $M\in$ $\mathcal{B}\left(  \mathcal{V}\right)  $ is positive$,$ where
$\mathcal{V}$ is a Hilbert space then $M$ is symmetric wrt the inner product
$\left\langle \left.  \cdot\right\vert \cdot\right\rangle $ of $\mathcal{V}$
\end{lemma}

\begin{proof}
\begin{enumerate}
\item
\begin{equation}
M\geq0\Rightarrow\left\langle \left.  v\right\vert Mv\right\rangle
\ \in\mathbb{R}.
\end{equation}


\item
\begin{equation}
\left\langle \left.  v\right\vert Mv\right\rangle =x=\overline{\left\langle
\left.  Mv\right\vert v\right\rangle }=\alpha-i\beta\Rightarrow\beta=0\text{
and }x=\alpha
\end{equation}
hence
\begin{equation}
\overline{\left\langle \left.  Mv\right\vert v\right\rangle }=\overline
{\left\langle \left.  v\right\vert Mv\right\rangle }=\left\langle \left.
Mv\right\vert v\right\rangle =\left\langle \left.  v\right\vert
Mv\right\rangle .
\end{equation}


\item Polarization gives%
\begin{equation}
4\left\langle \left.  Mv\right\vert w\right\rangle =\left\langle (\left.
M(v+w)\right\vert \left(  v+w\right)  \right\rangle -\left\langle (\left.
M(v-w)\right\vert \left(  v-w\right)  \right\rangle -i\left\langle (\left.
M(v+iw)\right\vert \left(  x+iw\right)  \right\rangle +i\left\langle (\left.
M(v-iw)\right\vert \left(  v-iw\right)  \right\rangle
\end{equation}
and
\begin{equation}
4\left\langle \left.  v\right\vert Mw\right\rangle =\left\langle (\left.
(v+w)\right\vert M\left(  v+w\right)  \right\rangle -\left\langle (\left.
(v-w)\right\vert M\left(  v-w\right)  \right\rangle -i\left\langle (\left.
(v+iw)\right\vert M\left(  x+iw\right)  \right\rangle +i\left\langle (\left.
(v-iw)\right\vert M\left(  v-iw\right)  \right\rangle
\end{equation}
thus
\begin{equation}
\left\langle \left.  Mv\right\vert w\right\rangle =\left\langle \left.
v\right\vert Mw\right\rangle .
\end{equation}

\end{enumerate}
\end{proof}

\begin{corollary}
In finite dimensions $M$ is self adjoint i.e.
\begin{equation}
M=M^{\dagger}.
\end{equation}

\end{corollary}

\begin{claim}
$L\in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
,\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  $
\begin{equation}
\left\langle \left.  Y\right\vert L\left(  X\right)  \right\rangle
_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }\nsucceq0\,\forall
X\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{+},\forall
Y\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{+}^{d}\geq0
\end{equation}

\end{claim}

\begin{lemma}%
\begin{equation}
\left\{  \overset{}{X\geq0\Rightarrow L\left(  X\right)  \geq0\qquad\forall
X\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  }\right\}
\Leftrightarrow\left\{  \overset{}{Y\geq0\Rightarrow\Gamma\left(  Y\right)
\geq0\qquad\forall Y\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
}\right\}  ,
\end{equation}
which is equivalent to
\begin{equation}
\left\{  \overset{}{L\left(  QQ^{\dagger}\right)  \geq0\qquad\forall
QQ^{\dagger}\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
}\right\}  \Leftrightarrow\left\{  \overset{}{\Gamma\left(  QQ^{\dagger
}\right)  \geq0\qquad\forall QQ^{\dagger}\in\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  }\right\}
\end{equation}

\end{lemma}

\begin{proof}
As%
\begin{equation}
\left\langle \left.  QQ^{\dagger}\right\vert L\left(  X\right)  \right\rangle
_{\mathcal{F}}\geq0\,\,\forall QQ^{\dagger}\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  ,\,X\in\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \Leftrightarrow L\left(  X\right)  \geq0
\end{equation}
and%
\begin{equation}
\left\langle \left.  \Gamma\left(  X\right)  \right\vert QQ^{\dagger
}\right\rangle _{\mathcal{F}}\geq0\,\,\forall\,QQ^{\dagger}\in\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,\,X\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \Leftrightarrow\Gamma\left(  X\right)  \geq0
\end{equation}
one can observe%
\begin{equation}
L\left(  QQ^{\dagger}\right)  \geq0\qquad\forall QQ^{\dagger}\in
\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
and
\begin{equation}
QQ^{\dagger}\geq0\Rightarrow\Gamma\left(  QQ^{\dagger}\right)  \geq
0\qquad\forall QQ^{\dagger}\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  .
\end{equation}

\end{proof}

\begin{remark}
If $X\nleqq0$ it is possible that $L\left(  X\right)  \geq0$ and If $Y\nleqq0$
it is possible that $\Gamma\left(  Y\right)  \geq0$ i.e
\begin{equation}
L\left(  X\right)  \geq0\nRightarrow X\geq0
\end{equation}
and
\begin{equation}
\Gamma\left(  Y\right)  \geq0\nRightarrow Y\geq0.
\end{equation}

\end{remark}

\begin{remark}
$X\geq0,$ $X\in V,$ when $f\left(  X\right)  \geq0$ $\forall f\in V_{+}^{d}.$
If $f$ is a normal functional and $X\geq0$
\begin{equation}
f\left(  X\right)  =\operatorname{Tr}\left\{  X^{\dagger}Y_{f}\right\}
\geq0\quad\forall Y_{f}\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{+}.
\end{equation}

\end{remark}

\begin{remark}
There can exist $Y_{f}\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{+}$ when $X\geq0$ such that
\begin{equation}
f\left(  L\left(  X\right)  \right)  =\operatorname{Tr}\left\{  L\left(
X\right)  ^{\dagger}Y_{f}\right\}  <0.
\end{equation}

\end{remark}

\begin{remark}
There can exist $Y_{f}\in\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{+}$ when $X\geq0$ such that
\begin{equation}
f\left(  \Gamma\left(  X\right)  \right)  =\operatorname{Tr}\left\{
\Gamma\left(  X\right)  ^{\dagger}Y_{f}\right\}  <0.
\end{equation}

\end{remark}

The image of a particle rank $N$ vector under the map $L^{-1}$ (determined in
the proceeding) is%
\begin{align}
L^{-1}\left(  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
\vdots\\
X_{eN}\\
0\\
\vdots\\
0
\end{array}
\right)  \right)   &  =\left(
\begin{array}
[c]{ccccc}%
\left(  -1\right)  ^{0}\binom{0}{0}L_{0}^{0} & \cdots & \left(  -1\right)
^{0-N}\binom{N}{0}L_{N}^{0} & \cdots & \left(  -1\right)  ^{0-r}\binom{r}%
{0}L_{r}^{0}\\
0 & \ddots & \vdots & \vdots & \vdots\\
\vdots & \ddots & \left(  -1\right)  ^{0}\binom{N}{N}L_{N}^{N} & \cdots &
\left(  -1\right)  ^{r-N}\binom{r}{N}L_{r}^{N}\\
\vdots & \vdots & \ddots & \ddots & \vdots\\
0 & \cdots & \cdots & 0 & \left(  -1\right)  ^{0}\binom{r}{r}L_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{0}\\
X_{1}\\
X_{2}\\
\vdots\\
X_{N}\\
0\\
\vdots\\
0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
\sum\limits_{N\geq P\geq0}\left(  -1\right)  ^{0-P}\binom{P}{0}L_{N}%
^{0}\left(  X_{eP}\right)  =\left(  -1\right)  ^{0-0}\binom{0}{0}L_{0}%
^{0}\left(  X_{0}\right)  +\cdots+\left(  -1\right)  ^{0-N}\binom{N}{0}%
L_{N}^{0}\left(  X_{N}\right) \\
\sum\limits_{N\geq P\geq1}\left(  -1\right)  ^{1-P}\binom{P}{1}L_{N}%
^{1}\left(  X_{eP}\right)  =\left(  -1\right)  ^{1-1}\binom{1}{1}L_{1}%
^{1}\left(  X_{1}\right)  +\cdots+\left(  -1\right)  ^{1-N}\binom{N}{1}%
L_{N}^{1}\left(  X_{N}\right) \\
\sum\limits_{N\geq P\geq2}\left(  -1\right)  ^{2-P}\binom{P}{2}L_{N}%
^{2}\left(  X_{eP}\right)  =\left(  -1\right)  ^{2-2}\binom{2}{2}L_{1}%
^{1}\left(  X_{2}\right)  +\cdots+\left(  -1\right)  ^{2-N}\binom{N}{2}%
L_{N}^{2}\left(  X_{N}\right) \\
\vdots\\
\sum\limits_{N\geq P\geq N}\left(  -1\right)  ^{N-P}\binom{P}{N}L_{N}%
^{N}\left(  X_{eP}\right)  =\left(  -1\right)  ^{N-N}\binom{N}{N}L_{N}%
^{N}\left(  X_{N}\right) \\
0\\
\vdots\\
0
\end{array}
\right)
\end{align}
is given by
\[
=\left(
\begin{array}
[c]{c}%
\sum\limits_{0\leq P\leq N}\binom{N-P}{0}L_{N}^{0}\left(  X_{eP}\right)
=\binom{N}{0}L_{N}^{0}\left(  X_{eN}\right)  +\binom{N-1}{0}L_{N-1}^{0}\left(
X_{eN-1}\right)  +\cdots+\binom{0}{0}L_{0}^{0}\left(  X_{e0}\right) \\
\sum\limits_{1\leq P\leq N}\binom{N-P+1}{1}L_{N}^{1}\left(  X_{e\left(
N-P\right)  }\right)  =\binom{N}{1}L_{N}^{1}\left(  X_{eN}\right)
+\binom{N-1}{1}L_{N-1}^{1}\left(  X_{eN-1}\right)  +\cdots+\binom{1}{1}%
L_{1}^{1}\left(  X_{e1}\right) \\
\vdots\\
\sum\limits_{Q\leq P\leq N}\binom{N-P+1}{P}L_{P}^{N-P+1}\left(  X_{eP}\right)
=\binom{N}{P}L_{N}^{P}\left(  X_{eN}\right)  +\binom{N-1}{P}L_{N-1}^{P}\left(
X_{eN-1}\right)  +\cdots+\binom{P}{P}L_{P}^{P}\left(  X_{e1}\right) \\
\vdots\\
\binom{N}{N}L_{N}^{N}\left(  X_{eN}\right) \\
0\\
\vdots\\
0
\end{array}
\right)
\]


\begin{example}%
\begin{gather}
L^{-1}\left(  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cccc}%
L_{0}^{0} & -L_{1}^{0} & L_{2}^{0} & -L_{3}^{0}\\
O & L_{1}^{1} & -\binom{2}{1}L_{2}^{1} & \binom{3}{1}L_{3}^{1}\\
O & O & L_{2}^{2} & -\binom{3}{2}L_{3}^{2}\\
O & O & O & L_{3}^{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
L_{0}^{0}\left(  X_{e0}\right)  -L_{2}^{0}\left(  X_{e1}\right)  +L_{2}%
^{0}\left(  X_{e2}\right) \\
L_{1}^{1}\left(  X_{e1}\right)  -\binom{2}{1}L_{2}^{1}\left(  X_{e2}\right) \\
L_{2}^{2}\left(  X_{e2}\right) \\
0
\end{array}
\right) \\
=\left(
\begin{array}
[c]{c}%
X_{e0}-L_{2}^{0}\left(  X_{e1}\right)  +L_{2}^{0}\left(  X_{e2}\right) \\
X_{e1}-2L_{2}^{1}\left(  X_{e2}\right) \\
X_{e2}\\
0
\end{array}
\right)  .
\end{gather}

\end{example}

\begin{example}
As the contraction and expansion maps are transposes of each other%
\begin{equation}
\Gamma^{-1}=\left(
\begin{array}
[c]{cccc}%
\Gamma_{0}^{0} & O & O & O\\
-\Gamma_{0}^{1} & \Gamma_{1}^{1} & O & O\\
\Gamma_{0}^{2} & -\binom{2}{1}\Gamma_{1}^{2} & \Gamma_{2}^{2} & O\\
-\Gamma_{0}^{3} & \binom{3}{1}\Gamma_{1}^{3} & -\binom{3}{2}\Gamma_{2}^{3} &
\Gamma_{3}^{3}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
\Gamma_{0}^{0} & O & O & O\\
-\Gamma_{0}^{1} & \Gamma_{1}^{1} & O & O\\
\Gamma_{0}^{2} & -2\Gamma_{1}^{2} & \Gamma_{2}^{2} & O\\
-\Gamma_{0}^{3} & 3\Gamma_{1}^{3} & -3\Gamma_{2}^{3} & \Gamma_{3}^{3}%
\end{array}
\right)  .
\end{equation}

\end{example}

\begin{lemma}
The \emph{particle rank} is conserved by $\Gamma$ and $\Gamma^{-1}.$
\end{lemma}

\begin{remark}
If $\left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
0
\end{array}
\right)  $ is positive then $\Gamma^{-1}\left(  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{c}%
X_{e0}-L_{2}^{0}\left(  X_{e1}\right)  +L_{2}^{0}\left(  X_{e2}\right) \\
X_{e1}-2L_{2}^{1}\left(  X_{e2}\right) \\
X_{e2}\\
0
\end{array}
\right)  $ \underline{\emph{may or may}}\emph{ not} be positive.
\end{remark}

\begin{example}%
\begin{align}
&  L^{-1}\left(  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
X_{e3}\\
X_{e4}\\
0\\
\vdots\\
0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{ccccc}%
\left(  -1\right)  ^{0-0}\binom{0}{0}L_{0}^{0} & \cdots & \left(  -1\right)
^{0-4}\binom{4}{0}L_{4}^{0} & \cdots & \left(  -1\right)  ^{0-r}\binom{r}%
{0}L_{r}^{0}\\
0 & \ddots & \vdots & \vdots & \vdots\\
\vdots & \ddots & \left(  -1\right)  ^{4-4}\binom{4}{4}L_{4}^{4} & \cdots &
\left(  -1\right)  ^{r-4}\binom{r}{4}L_{r}^{4}\\
\vdots & \vdots & \ddots & \ddots & \vdots\\
0 & \cdots & \cdots & 0 & \left(  -1\right)  ^{r-r}\binom{r}{r}L_{r}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
X_{e3}\\
X_{e4}\\
0\\
\vdots\\
0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{l}%
\sum\limits_{4\geq P\geq0}\left(  -1\right)  ^{0-P}\binom{P}{0}L_{N}%
^{0}\left(  X_{eP}\right)  =\left(  -1\right)  ^{0-0}\binom{0}{0}L_{0}%
^{0}\left(  X_{0}\right)  +\left(  -1\right)  ^{0-1}\binom{0}{0}L_{0}%
^{0}\left(  X_{0}\right)  +\left(  -1\right)  ^{0-2}\binom{0}{0}L_{0}%
^{0}\left(  X_{0}\right) \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad+\,\left(  -1\right)  ^{0-3}\binom{0}{0}L_{0}^{0}\left(  X_{0}\right)
+\left(  -1\right)  ^{0-4}\binom{4}{0}L_{4}^{0}\left(  X_{e4}\right) \\
\sum\limits_{4\geq P\geq1}\left(  -1\right)  ^{1-P}\binom{P}{1}L_{4}%
^{1}\left(  X_{eP}\right)  =\left(  -1\right)  ^{1-1}\binom{1}{1}L_{1}%
^{1}\left(  X_{1}\right)  +\left(  -1\right)  ^{1-2}\binom{2}{1}L_{2}%
^{1}\left(  X_{1}\right)  +\left(  -1\right)  ^{1-3}\binom{3}{1}L_{3}%
^{1}\left(  X_{1}\right) \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad+\,\left(  -1\right)  ^{1-4}\binom{4}{1}L_{4}^{1}\left(  X_{e4}\right)
\\
\sum\limits_{4\geq P\geq2}\left(  -1\right)  ^{2-P}\binom{P}{2}L_{4}%
^{2}\left(  X_{eP}\right)  =\left(  -1\right)  ^{2-2}\binom{2}{2}L_{2}%
^{2}\left(  X_{2}\right)  +\left(  -1\right)  ^{2-3}\binom{2}{2}L_{3}%
^{2}\left(  X_{2}\right)  +\left(  -1\right)  ^{2-4}\binom{4}{2}L_{4}%
^{2}\left(  X_{e4}\right) \\
\sum\limits_{4\geq P\geq2}\left(  -1\right)  ^{3-P}\binom{P}{2}L_{4}%
^{2}\left(  X_{eP}\right)  =\left(  -1\right)  ^{3-3}\binom{2}{2}L_{4}%
^{3}\left(  X_{2}\right)  +\left(  -1\right)  ^{3-4}\binom{4}{2}L_{4}%
^{4}\left(  X_{e4}\right)  \vdots\\
\sum\limits_{4\geq P\geq4}\left(  -1\right)  ^{4-P}\binom{P}{4}L_{4}%
^{4}\left(  X_{eP}\right)  =\left(  -1\right)  ^{4-4}\binom{4}{4}L_{4}%
^{4}\left(  X_{e4}\right) \\
\multicolumn{1}{c}{0}\\
\multicolumn{1}{c}{\vdots}\\
\multicolumn{1}{c}{0}%
\end{array}
\right)
\end{align}
is given by
\[
=\left(
\begin{array}
[c]{l}%
\sum\limits_{0\leq P\leq4}\left(  -1\right)  ^{0-P}\binom{4-P}{0}L_{4}%
^{0}\left(  X_{e4}\right)  =\left(  -1\right)  ^{0-0}\binom{4}{0}L_{4-0}%
^{0}\left(  X_{e4}\right)  +\left(  -1\right)  ^{0-1}\binom{4-1}{0}L_{4-1}%
^{0}\left(  X_{e3}\right)  +\left(  -1\right)  ^{0-2}\binom{4-2}{0}L_{4-2}%
^{0}\left(  X_{e2}\right) \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad+\,\left(  -1\right)  ^{0-3}\binom{4-3}{0}L_{4-3}^{0}\left(
X_{e1}\right)  +\left(  -1\right)  ^{0-4}\binom{0}{0}L_{4-4}^{0}\left(
X_{e0}\right) \\
\sum\limits_{1\leq P\leq4}\left(  -1\right)  ^{1-P}\binom{4-P+1}{1}L_{4}%
^{1}\left(  X_{e\left(  4-P\right)  }\right)  =\left(  -1\right)  ^{1-1}%
\binom{4}{1}L_{4-0}^{1}\left(  X_{e4}\right)  +\left(  -1\right)  ^{1-2}%
\binom{4-1}{1}L_{4-1}^{1}\left(  X_{e4-1}\right)  +\left(  -1\right)
^{1-3}\binom{4-2}{1}L_{4-2}^{1}\left(  X_{e4-2}\right) \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad+\,\left(  -1\right)  ^{1-4}\binom{4-3}{1}L_{4-3}^{1}\left(
X_{e4-3}\right) \\
\sum\limits_{2\leq P\leq4}\left(  -1\right)  ^{2-P}\binom{4-P+1}{1}L_{4}%
^{2}\left(  X_{e\left(  4-P\right)  }\right)  =\left(  -1\right)  ^{2-2}%
\binom{4}{2}L_{4-0}^{2}\left(  X_{e4}\right)  +\left(  -1\right)  ^{2-3}%
\binom{4-1}{2}L_{4-1}^{2}\left(  X_{e4-1}\right)  +\left(  -1\right)
^{2-4}\binom{4-2}{2}L_{4-2}^{2}\left(  X_{e4-2}\right) \\
\sum\limits_{3\leq P\leq4}\left(  -1\right)  ^{3-P}\binom{4-P+1}{1}L_{4}%
^{3}\left(  X_{e\left(  4-P\right)  }\right)  =\left(  -1\right)  ^{3-3}%
\binom{4}{3}L_{4-0}^{3}\left(  X_{e4}\right)  +\left(  -1\right)  ^{3-4}%
\binom{4-3}{3}L_{4-1}^{3}\left(  X_{e4-1}\right) \\
\sum\limits_{4\leq P\leq4}\left(  -1\right)  ^{4-P}\binom{4-P+1}{1}L_{4}%
^{4}\left(  X_{e\left(  4-P\right)  }\right)  =\left(  -1\right)  ^{4-4}%
\binom{4}{4}L_{4-0}^{4}\left(  X_{e4}\right) \\
\multicolumn{1}{c}{0}\\
\multicolumn{1}{c}{\vdots}\\
\multicolumn{1}{c}{0}%
\end{array}
\right)
\]

\end{example}

\begin{remark}
If $\left(
\begin{array}
[c]{c}%
X_{e0}\\
X_{e1}\\
X_{e2}\\
0
