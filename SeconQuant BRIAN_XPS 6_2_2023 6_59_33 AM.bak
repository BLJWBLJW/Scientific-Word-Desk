\item The adjoint $X^{\dagger}\in$ $\mathcal{B}\left(  \mathcal{V}\right)  $
is defined by
\begin{equation}
\left\langle \left.  X^{\dagger}v\right\vert w\right\rangle =\left\langle
\left.  v\right\vert Xw\right\rangle \quad\forall w\in\mathcal{V}%
\end{equation}
and can be expanded as
\begin{equation}
X^{\dagger}=\sum_{1\leq j,k\leq s}\mathfrak{R}_{\boldsymbol{\Phi}}\left(
\mathfrak{X}^{\dagger}\right)  _{jk},
\end{equation}
where
\begin{equation}
\mathfrak{R}_{\boldsymbol{\Phi}}\left(  \mathfrak{X}^{\dagger}\right)
_{jk}\in\mathcal{B}\left(  \mathcal{V}_{k},\mathcal{V}_{j}\right)  ,\,1\leq
j,k\leq s.
\end{equation}


\item
\begin{equation}
\left\langle \left.  X^{\dagger}v\right\vert w\right\rangle =\left\langle
\left.  v\right\vert Xw\right\rangle =\sum_{1\leq j,k\leq s}\left\langle
\left.  v_{j}\right\vert \mathfrak{R}_{\boldsymbol{\varphi}}\left(
\mathfrak{X}\right)  _{jk}w_{k}\right\rangle =\sum_{1\leq j,k\leq
s}\left\langle \left.  \left(  \mathfrak{R}_{\boldsymbol{\varphi}}\left(
\mathfrak{X}\right)  _{jk}\right)  ^{\dagger}v_{j}\right\vert w_{k}%
\right\rangle
\end{equation}


