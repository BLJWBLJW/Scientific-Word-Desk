which shows that $\mathcal{R}_{\varphi}\left(  L\right)  $ is triangular.
\end{example}

\begin{example}%
\begin{equation}
\left\langle \left.  L\left(  \overset{}{\left\vert \overset{}{\varphi_{k_{1}%
}\varphi_{k_{2}}}\right\rangle \left\langle \overset{}{\varphi_{l_{1}}%
\varphi_{l_{2}}}\right\vert }\right)  \right\vert \left\vert
\overset{}{\varphi_{i_{1}}\cdots\varphi_{i_{4}}}\right\rangle \left\langle
