\subsection{Measure Spaces}

\begin{definition}
Measure Space $\mathcal{M}=\left\{  X,\Sigma,\mu\right\}  ,$ where $X$ is a
non empty set, $\Sigma$ $\equiv\Sigma\left(  X\right)  $ a $\sigma$-algebra of
subsets $\Delta$ of $X$ and $\mu$ a measure.
\end{definition}

\begin{definition}
Measure (positive):%
\begin{equation}
\mu:\Sigma\rightarrow\left[  0,\infty\right]  \subset\mathbb{R}%
\end{equation}

\end{definition}

\begin{definition}
$\sigma$-algebra $\Sigma$:
\end{definition}

\begin{enumerate}
\item
\begin{equation}
\phi,\,X,\,\Delta^{c}\,\in\Sigma\quad\forall\Delta\in\Sigma
\end{equation}
and

\item
\begin{equation}%
%TCIMACRO{\tbigcup \limits_{j\in J}}%
%BeginExpansion
{\textstyle\bigcup\limits_{j\in J}}
%EndExpansion
\Delta_{j}\in\Sigma;\,\Delta_{j}\in\Sigma,
\end{equation}
where $J$ is a \emph{finite} or \emph{countably infinite} set.
\end{enumerate}

\begin{definition}
$\U{3c3} $-additivity$\,\equiv\mu$ is countably additive
\begin{equation}
\mu\left(
%TCIMACRO{\tbigcup \limits_{j\in J}}%
%BeginExpansion
{\textstyle\bigcup\limits_{j\in J}}
%EndExpansion
\Delta_{j}\right)  =\sum_{j\in J}\mu\left(  \Delta_{j}\right)  ,
\end{equation}
where
\begin{equation}
\Delta_{j}\cap\Delta_{k}=\phi\quad j\neq k.
\end{equation}

\end{definition}

\begin{definition}
If
\begin{equation}
X=%
%TCIMACRO{\tbigcup \limits_{j\in J}}%
%BeginExpansion
{\textstyle\bigcup\limits_{j\in J}}
%EndExpansion
\Delta_{j},
\end{equation}
where $\left\{  \Delta_{j}\right\}  $ do not have to be disjoint and
\begin{equation}
\mu\left(  \Delta_{j}\right)  <\infty,\quad j\in J
\end{equation}
then $\mu$ is $\U{3c3} $-finite.
\end{definition}

\begin{definition}
Probability Space:%
\begin{equation}
\mu\left(  X\right)  =1
\end{equation}

\end{definition}

\begin{definition}
Monotone:
\begin{equation}
\Delta_{j}\subseteq\Delta_{k}\Rightarrow\mu\left(  \Delta_{j}\right)  \leq
\mu\left(  \Delta_{k}\right)  .
\end{equation}

\end{definition}

\begin{remark}
A set $\Delta$ has \emph{zero }$\mu$\emph{-measure if}
\begin{equation}
\mu\left(  \Delta\right)  =0.
\end{equation}

\end{remark}

\begin{remark}
The empty set is always of measure zero%
\begin{equation}
\mu\left(  \phi\right)  =0.
\end{equation}

\end{remark}

\begin{definition}
A \emph{Borel set }is any set in a topological space that can be formed from
\emph{open sets} (or, equivalently, from closed sets) through the operations
of countable union, countable intersection, and relative complement. For a
topological space $X$, the collection of all Borel sets on $X$ forms a
$\U{3c3} $-algebra, known as the \emph{Borel algebra} or \emph{Borel }$\U{3c3}
$\emph{-algebra}. The \emph{Borel algebra} on $X$ is the smallest $\U{3c3}
$-algebra containing all open sets (or, equivalently, all closed sets).
\end{definition}

\begin{definition}
Absolute Contiuous: A measure $\mu$ is absolutely continuous wrt a measure
$\nu$ expressed as
\begin{equation}
\mu\ll\nu
\end{equation}
if
\begin{equation}
\nu\left(  \Delta\right)  =0\Rightarrow\mu\left(  \Delta\right)
=0,\quad\forall\Delta\in\Sigma.
\end{equation}

\end{definition}

\begin{definition}
The definition of \emph{Lebesgue measure} $\lambda$ on the real line is length
i.e.
\begin{equation}
\lambda\left(  \left[  a,b\right]  \right)  =\lambda\left(  \left(
a,b\right)  \right)  =b-a.
\end{equation}

\end{definition}

\begin{remark}
Any \emph{countable }set of \emph{real} numbers $\Delta$ has \emph{Lebesgue}
measure $0.$ In particular, the Lebesgue measure of the set of algebraic
numbers is $0$, even though the set is dense in $\mathbb{R}$.

\begin{definition}
The definition of \emph{Lebesgue} measure $\lambda$ on $\mathbb{R}^{n},1\leq
n<\infty$ is \emph{length/area/volume/hypervolume}
\begin{equation}
\lambda\left(  \Delta\right)  =\operatorname*{Vol}\left\{  \Delta\right\}
=\left\vert \mathbf{v}_{1}\wedge\cdots\wedge\mathbf{v}_{n}\right\vert
=\left\vert \det\left\{  \mathbb{V}\right\}  \right\vert ,
\end{equation}
where $\left\{  \left.  \mathbf{v}_{j}\right\vert 1\leq j\leq n\right\}  $ are
the vectors defining the sides of the volume and are the columns of a matrix
$\mathbb{V}$. If these vectors are orthogonal then
\begin{equation}
\operatorname*{Vol}\left\{  \Delta\right\}  =\left\vert \mathbf{v}_{1}%
\wedge\cdots\wedge\mathbf{v}_{n}\right\vert =\left\Vert \mathbf{v}_{1}%
\wedge\cdots\wedge\mathbf{v}_{n}\right\Vert =\left\Vert \mathbf{v}%
_{1}\right\Vert \cdots\left\Vert \mathbf{v}_{n}\right\Vert .
\end{equation}
where $\left\Vert \mathbf{v}\right\Vert $ is the Eucliden norm of $\mathbf{v}$
i.e. length of $\mathbf{v.}$
\end{definition}
\end{remark}

\begin{remark}
In $3$-dimensions
\begin{equation}
dV=d\mathbf{x}\wedge d\mathbf{y}\wedge d\mathbf{z}=\left\vert \left(
\begin{array}
[c]{ccc}%
dx & 0 & 0\\
0 & dy & 0\\
0 & 0 & dz
\end{array}
\right)  \right\vert =\left(  dx\mathbf{i}\right)  \wedge\left(
dy\mathbf{j}\right)  \wedge\left(  dz\mathbf{k}\right)  =\left(
dxdydz\right)  \mathbf{i}\wedge\mathbf{j}\wedge\mathbf{k}=dxdydz,
\end{equation}
as
\begin{equation}
\mathbf{i}\wedge\mathbf{j}\wedge\mathbf{k}=\left(  \mathbf{%
\begin{array}
[c]{ccc}%
1 & 0 & 0
\end{array}
}\right)  \mathbf{\wedge}\left(  \mathbf{%
\begin{array}
[c]{ccc}%
0 & 1 & 0
\end{array}
}\right)  \mathbf{\wedge}\left(  \mathbf{%
\begin{array}
[c]{ccc}%
0 & 0 & 1
\end{array}
}\right)  =\left\vert \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 1
\end{array}
\right)  \right\vert =1.
\end{equation}

\end{remark}

\begin{definition}
The \emph{definition} of \emph{Infinitesimal Lebesgue} measure $d\lambda$ on
$\mathbb{R}^{n},1\leq n<\infty$ is
\begin{equation}
d\lambda=dx_{1}\cdots dx_{n}\quad\forall\text{points }\mathbf{\in}%
\mathbb{R}^{n},
\end{equation}
where
\begin{equation}
dx_{1}\cdots dx_{n}=\left\Vert d\mathbf{x}^{1}\wedge\cdots\wedge
d\mathbf{x}^{n}\right\Vert =dx_{1}\cdots dx_{n}\left\Vert \mathbf{e}^{1}%
\wedge\cdots\wedge\mathbf{e}^{n}\right\Vert =dx_{1}\cdots dx_{n}.
\end{equation}

\end{definition}

\begin{remark}
The sign of the coefficient, i.e. $\pm1,$ of the exterior product
$d\mathbf{x}^{1}\wedge\cdots\wedge d\mathbf{x}^{n}=dx_{1}\cdots dx_{n}%
\mathbf{e}^{1}\wedge\cdots\wedge\mathbf{e}^{n}$ determines the
\emph{orientation} of the coordinate frame $\left\{  \mathbf{e}^{1}%
,\cdots,\mathbf{e}^{n}\right\}  .$
\end{remark}

\begin{remark}
If $X$ is a $n$-dimensional differential manifold then there exist coordinate
functions
\begin{equation}
x^{j}:X\rightarrow\mathbb{R},\quad1\leq j\leq n
\end{equation}
producing covariant (dual vectors) differentials at points $p\in X$ that are
linear functionals on the \emph{Tangent Spaces} $T_{p}\left(  X\right)  $ at
the points $p\in X$ i.e.,
\begin{equation}
dx^{j}\left(  p\right)  :T_{p}\left(  X\right)  \rightarrow\mathbb{R}%
,\quad1\leq j\leq n
\end{equation}
and $dx^{j}\left(  p\right)  \in T^{p}\left(  X\right)  $, the \emph{Cotangent
Space} at a point $p\in X$.
\end{remark}

\begin{remark}
Tangent spaces are generated by
\begin{equation}
T_{p}\left(  X\right)  =\mathbb{R}\text{-}\operatorname*{linspan}\left\{
\left.  \frac{\partial}{\partial x_{k}}\left(  p\right)  \right\vert 1\leq
j\leq n\right\}
\end{equation}
and Cotangent spaces are generated by
\begin{equation}
T^{p}\left(  X\right)  =\mathbb{R}\text{-}\operatorname*{linspan}\left\{
\left.  dx^{j}\left(  p\right)  \right\vert 1\leq j\leq n\right\}  .
\end{equation}

\end{remark}

\begin{definition}
The \emph{differential }$d\lambda\left(  p\right)  $\emph{ of Lebesgue
measure} $\lambda$ on a $n$-dimensional differentiable manifold $X$ at a point
$p\in X$ is a linear map from the tangent space $T_{p}\left(  X\right)  $ at
the point $p$ to $\mathbb{R}$ i.e.
\begin{align}
d\lambda\left(  p\right)   &  :T_{p}\left(  X\right)  \rightarrow\mathbb{R}\\
d\lambda\left(  p\right)   &  =d\mathbf{x}^{1}\left(  p\right)  \wedge
\cdots\wedge d\mathbf{x}^{n}\left(  p\right)  ,\quad d\mathbf{x}^{j}\left(
p\right)  \in\mathbb{R}^{n},1\leq j\leq n.
\end{align}

\end{definition}

\begin{remark}%
\begin{equation}
d\lambda\left(  p\right)  =\left\Vert d\mathbf{x}^{1}\left(  p\right)
\wedge\cdots\wedge d\mathbf{x}^{n}\left(  p\right)  \right\Vert =dx_{1}\cdots
dx_{n}\left\Vert \mathbf{e}^{1}\left(  p\right)  \wedge\cdots\wedge
\mathbf{e}^{n}\left(  p\right)  \right\Vert =dx_{1}\cdots dx_{n}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
T_{p}\left(  X\right)   &  \cong\mathbb{R}^{n}\\
T^{p}\left(  X\right)   &  \cong\left(  \mathbb{R}^{n}\right)  ^{d}%
\cong\mathbb{R}^{n}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
d\mathbf{x}^{1}\left(  p\right)  \wedge\cdots\wedge d\mathbf{x}^{n}\left(
p\right)  \in%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
T^{p}\left(  X\right)
\end{equation}

\end{remark}

\begin{remark}
The preceding bases are biorthogonal i.e.
\begin{equation}
dx^{j}\left(  p\right)  \left(  \frac{\partial}{\partial x_{k}}\left(
p\right)  \right)  =\left\langle dx^{j}\left(  p\right)  ,\frac{\partial
}{\partial x_{k}}\left(  p\right)  \right\rangle =\delta_{k}^{j}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
df\left(  p\right)   &  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq n}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq n}}
%EndExpansion
\eta_{j}dx^{j}\left(  p\right) \\
\left\langle df\left(  p\right)  ,\frac{\partial}{\partial x_{k}}\left(
p\right)  \right\rangle  &  =\left\langle
%TCIMACRO{\tsum \limits_{1\leq j\leq n}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq n}}
%EndExpansion
\eta_{j}dx^{j}\left(  p\right)  ,\frac{\partial}{\partial x_{k}}\left(
p\right)  \right\rangle =\eta_{k}=\frac{\partial f}{\partial x_{k}}\left(
p\right)  .
\end{align}

\end{remark}

\begin{remark}
The Tangent, $T\left(  X\right)  ,$ and Cotangent Bundles, $CT\left(
X\right)  ,$ are Vector Bundles that are the \emph{disjoint union} $\bigsqcup$
of the corresponding vector spaces i.e.
\begin{align}
T\left(  X\right)   &  =\bigsqcup\limits_{p\in X}T_{p}\left(  X\right) \\
CT\left(  X\right)   &  =\bigsqcup\limits_{p\in X}T^{p}\left(  X\right)  .
\end{align}

\end{remark}

\begin{remark}
$\left\{  \left.  dx^{j}\right\vert 1\leq j\leq n\right\}  $ and $\left\{
\left.  \frac{\partial}{\partial x_{j}}\right\vert 1\leq j\leq n\right\}  $
are \emph{cross sections} of $CT\left(  X\right)  $ and $T\left(  X\right)  $
respectively, where
\begin{equation}
dx^{j}:X\rightarrow CT\left(  X\right)  ,1\leq j\leq n
\end{equation}
and
\begin{equation}
\frac{\partial}{\partial x_{j}}:X\rightarrow T\left(  X\right)  ,1\leq j\leq
n.
\end{equation}


\begin{definition}
The \emph{Cartesian} \emph{differential} $d\lambda\left(  p\right)  $ at a
point $p\in X$ $\cong\mathbb{R}^{3}$ of Lebesgue measure $\lambda$ on
$\mathbb{R}^{3}$ is
\begin{equation}
d\lambda\left(  p\right)  \equiv dV=dxdydz.
\end{equation}

\end{definition}
\end{remark}

\begin{remark}
Having measure $0$ is \emph{not the same} as being not measurable.
\end{remark}

\begin{remark}
It is convenient in $\mathbb{R}$ to consider measures $\mu$ that are
absolutely continuous wrt Lebesgue measure i.e.%
\begin{equation}
\mu\left(  \Delta\right)  =\int_{\Delta}\rho\left(  p\right)  d\lambda\left(
p\right)  ,
\end{equation}
where $\rho\left(  p\right)  \geq0$ is a density, then one can consider
integrals $I_{\Delta}\left(  g\right)  $ of $g$ wrt $\mu$
\begin{equation}
I_{\Delta}\left(  g\right)  =\int_{\Delta}g\left(  p\right)  d\mu\left(
p\right)  .
\end{equation}

\end{remark}

\begin{remark}
The Lebesgue measure of a set $\Delta$ is given by
\begin{equation}
\lambda\left(  \Delta\right)  =\int_{\Delta}d\lambda\left(  p\right)  .
\end{equation}

\end{remark}

\subsection{Integrating step functions}

\begin{definition}
Indicator Function $\equiv$ Characteristic Function:
\begin{align}
\chi_{\Delta}  &  :\Sigma\rightarrow\left\{  0,1\right\} \\
\chi_{\Delta}\left(  p\right)   &  =\left\{
\begin{array}
[c]{c}%
1\text{ if }p\in\Delta\\
0\text{ if }p\notin\Delta
\end{array}
\right.  .
\end{align}

\end{definition}

\begin{definition}
Heavyside Step Function $\Theta_{a}$%
\begin{equation}
\Theta_{a}:\mathbb{R}\rightarrow\mathbb{R}%
\end{equation}
is defined as
\begin{equation}
\Theta_{a}\left(  x\right)  =\left\{
\begin{array}
[c]{c}%
0,\quad x<a\\
1,\quad x>a
\end{array}
\right.  .
\end{equation}

\end{definition}

\begin{remark}
$\Theta_{a}$ is discontinuous at $x=a.$
\end{remark}

\begin{remark}
The derivative of $\Theta_{a}$ at $x=a$ is the \emph{distribution} $\delta
_{a}$%
\begin{equation}
\delta_{a}\left(  x\right)  =\delta\left(  x-a\right)  =\left\{
\begin{array}
[c]{c}%
1\text{ if }x=a\\
0\text{ if }x\neq a
\end{array}
\right.  ,
\end{equation}
i.e.%
\begin{equation}
\frac{d\Theta_{a}\left(  a\right)  }{dx}\left(  x\right)  =\delta_{a}\left(
x\right)  .
\end{equation}

\end{remark}

\begin{remark}
The delta function is even i.e.
\begin{equation}
\delta_{a}\left(  x\right)  =\delta_{a}\left(  -x\right)  \equiv\delta\left(
x-a\right)  =\delta\left(  a-x\right)  .
\end{equation}

\end{remark}

\begin{lemma}
\emph{Indicator functions} are differences of Heavyside step functions%
\begin{equation}
\chi_{\chi_{\left[  a,b\right]  }}\left(  x\right)  =\Theta_{a}\left(
x\right)  -\Theta_{b}\left(  x\right)  .
\end{equation}

\end{lemma}

\begin{lemma}
The derivative of $\chi_{\Delta_{p}}$ $=\chi_{\left[  a,b\right]  }$ at the
point $x$ is the sum of delta functions i.e.
\begin{equation}
\frac{d\chi_{\chi_{\left[  a,b\right]  }}}{dx}\left(  x\right)  =\delta\left(
x-a\right)  -\delta\left(  x-b\right)  .
\end{equation}

\end{lemma}

\begin{example}%
\begin{align}
\Delta &  =\Delta_{1}\cup\cdots\cup\Delta_{m}\\
\chi_{\Delta}\left(  x\right)   &  =\chi_{\Delta_{1}}\left(  x\right)
+\cdots+\chi_{\Delta_{n}}\left(  x\right)
\end{align}

\end{example}

\begin{definition}
\emph{Step function }$\equiv$ \emph{Simple function} on a measure space
$\left\{  X,\Sigma,%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\right\}  $ is a measurable function which takes only finitely many values.
\end{definition}

In other words, a step function%
\begin{equation}
s:X\rightarrow\mathbb{C}%
\end{equation}
is a function that may be expressed as a finite sum of indicator functions
\begin{equation}
s=\sum_{1\leq j\leq n}\eta_{j}\chi_{\Delta_{j}},\quad\Delta_{j}\cap\Delta
_{k}=\phi\,,j\neq k,
\end{equation}
where $\eta_{j}\in\mathbb{C}$ are the distinct values taken by $s$
\begin{equation}
\Delta_{j}=s^{-1}\left(  \eta_{j}\right)  =\{x\in X|s(x)=\eta_{j}\}\in
\Sigma\left(  X\right)
\end{equation}
are disjoint $\mu$-measurable subsets of $X$ and $\chi_{\Delta_{j}}$ are
indicator functions of $\Delta_{j}$. This expression is unique, and $s>0$ if
and only if $\eta_{j}>0$ for all $j$.

The set of step functions on $X$, denoted $\operatorname*{Step}\left\{
X\right\}  $, is stable under sums and products (in algebraic terms, it is a
$\mathbb{C}$-algebra; the word \textquotedblleft algebra\textquotedblright%
\ has here a completely different meaning than in $\U{3c3} -$algebra). This
results in the two formulae
\begin{align}
\chi_{\Delta}\chi_{\Delta^{\prime}}  &  =\chi_{\Delta\cap\Delta^{\prime}}\\
\chi_{\Delta}+\chi_{\Delta^{\prime}}  &  =\chi_{\Delta\cup\Delta^{\prime}%
}+\chi_{\Delta\cap\Delta^{\prime}}=2\chi_{\Delta\cap\Delta^{\prime}}%
+\chi_{\Delta\cup\Delta^{\prime}-\Delta\cap\Delta^{\prime}}.
\end{align}


\subsection{Integral of functions.}

\begin{definition}
If $X$ is a real $n$-dimensional differentiable manifold the differential
$d\mu\left(  p\right)  $ of a measure $\mu$ at a point $p\in X$ is a linear
map from the tangent space $T_{p}\left(  X\right)  $ at the point $p\in X$ to
$\mathbb{R}$ i.e.
\begin{equation}
d\mu\left(  p\right)  :T_{p}\left(  X\right)  \rightarrow\mathbb{R}.
\end{equation}
This can be extended to \emph{complex} $n$-dimensional differentiable manifold
to produce
\begin{equation}
d\mu\left(  p\right)  :T_{p}\left(  X\right)  \rightarrow\mathbb{C}.
\end{equation}

\end{definition}

\begin{remark}
$X$ can be generalized to \emph{infinite dimensional} Banach or Hilbert manifolds.
\end{remark}

\begin{definition}
Measurable function: The function
\begin{equation}
f:X\rightarrow\mathbb{C}%
\end{equation}
is $\mu$-measurable if
\begin{equation}
f^{-1}\left\{  \mathbb{C}\right\}  \in\Sigma.
\end{equation}

\end{definition}

Let $\mathcal{M}=\left\{  X,\Sigma,%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\right\}  $ be a measure space then the \emph{measure of a set} $\Delta
\in\Sigma$ is defined as the value of the integral of the characteristic
function of $\Delta$, i.e.
\begin{equation}%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  \Delta\right)  =\int\chi_{\Delta}\left(  p\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)  =\int_{\Delta}d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)
\end{equation}
from which we can compute the integral of functions taking finitely many
values (by linearity). One then uses a limiting process to define integrals of
non-negative functions, general real valued functions and then finally complex
valued functions.

\begin{definition}
A \emph{real valued} function $f$ is $%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
$-integrable if%
\begin{equation}
\int f\left(  p\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)  =\sup\limits_{n}\left\{  \int f_{n}\left(  p\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)  \right\}  <\infty,
\end{equation}
where $f$ is the pointwise limit of the sequence $\left\{  f_{n}\right\}  $
i.e.
\begin{equation}
f\left(  p\right)  =\lim\limits_{n\rightarrow\infty}\left\{  f_{n}\left(
p\right)  \right\}  .
\end{equation}
If
\begin{equation}
\sup\limits_{n}\left\{  \int f_{n}\left(  p\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)  \right\}  =\infty
\end{equation}
then $f$ is non integrable.
\end{definition}

\begin{remark}%
\begin{gather}
\chi_{a}\left(  y\right)  =\left\{
\begin{array}
[c]{c}%
1\text{ if }y=a\\
0\text{ if }y\neq a
\end{array}
\right.  =\delta_{a}\left(  y\right)  =\delta\left(  a-y\right) \\
\delta\left(  0\right)  =1\\
\delta\left(  a\right)  \overset{a\neq0}{=}0.
\end{gather}

\end{remark}

\begin{remark}
The \emph{Lebesgue measure }$\lambda$ \emph{of }finite sets of discrete points
is zero as the measure of discrete points is zero i.e.
\begin{equation}
\lambda\left(  \left\{  p\right\}  \right)  =0.
\end{equation}

\end{remark}

\begin{lemma}
If $\mu\ll\nu$ then
\begin{equation}
\mu\left(  \Delta\right)  =\int_{\Delta}f\left(  p\right)  d\nu\left(
p\right)  .
\end{equation}

\end{lemma}

\begin{definition}
Integral: Let $s_{+}$ be a step function that is non negative for any
measurable set $\Delta\in\Sigma$, we define the \emph{integral} of $s_{+}$ on
$\Delta$ with respect to $%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
$ by%
\begin{equation}
\int_{\Delta}s_{+}(p)d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
(p)=\int_{\Delta}\sum_{1\leq j\leq n}\U{3b1} _{j}\chi_{\Delta_{j}}(p)d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
(p)=\sum_{1\leq j\leq n}\U{3b1} _{j}%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
(\Delta_{j}\cap\Delta)\in\lbrack0,+\infty],\quad\U{3b1} _{j}\geq0,1\leq j\leq
n.
\end{equation}

\end{definition}

One can generalize this to \emph{complex valued functions }%
\begin{equation}
f:X\rightarrow\mathbb{C}%
\end{equation}
which are assumed to be measurable for the fixed $\U{3c3} $-algebra $\Sigma,$
by
\begin{equation}
f=f_{1+}-f_{2+}+i\left(  f_{3+}-f_{4+}\right)
\end{equation}
wrt the \emph{complex signed measure }$%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
$ given by \emph{ }
\begin{equation}%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
=%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
_{1+}-%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
_{2+}+i\left(
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
_{3+}-%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
_{4+}\right)  .
\end{equation}


\begin{remark}
The sum of two complex measures is a complex measure, as is the product of a
complex measure by a complex number. That is to say, the set of all complex
measures on a measure space $\left\{  X,\Sigma,%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\right\}  $ forms a \emph{vector space} $\mathcal{M}\left(  X,\Sigma\right)  $
over the complex numbers. Moreover, the \emph{total variation} $\Vert
\cdot\Vert$ defined as%
\begin{equation}
\left\Vert
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\right\Vert =\left\vert
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\right\vert \left(  X\right)
\end{equation}
is a norm, with respect to which the space of complex measures is a Banach space.
\end{remark}

\begin{definition}
Recall that a \emph{measure} $\nu$ is absolutely continuous wrt a measure
$\mu$ expressed as
\begin{equation}
\nu\gg\mu
\end{equation}
if
\begin{equation}
\nu\left(  \Delta\right)  =0\Rightarrow\mu\left(  \Delta\right)
=0,\quad\Delta\in\Sigma.
\end{equation}

\end{definition}

\begin{notation}
Measure denotes positive measure i.e. not a \emph{signed} measure that can
have both positive and negative values..
\end{notation}

\begin{theorem}
\emph{Radon--Nikodym}: If $\nu\gg\mu$ then
\begin{equation}
\nu\left(  \Delta\right)  =\int_{\Delta}\rho_{\nu\mu}\left(  x\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  x\right)  =\int_{\Delta}\frac{d\nu}{d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
}\left(  x\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  x\right)  ,
\end{equation}
i.e. the "density" $\rho$ is the \emph{Radon-Nikodym derivative} i.e.
\begin{equation}
\rho_{\nu\mu}=\frac{d\nu}{d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
}.
\end{equation}

\end{theorem}

\begin{corollary}%
\begin{equation}
\rho_{\nu\mu}=\frac{d\nu}{d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
}\geq0.
\end{equation}

\end{corollary}

\begin{remark}%
\begin{equation}%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  \Delta\right)  =\int_{\Delta}d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)  .
\end{equation}

\end{remark}

\begin{remark}
If $\nu$ is a \emph{probability measure}
\begin{equation}
\nu\left(  X\right)  =\int_{X}d\nu\left(  p\right)  =\int_{X}\rho_{\nu\mu
}\left(  p\right)  d%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
\left(  p\right)  =1
\end{equation}
and $\rho_{\nu\mu}$ is a \emph{probability density}. A probability measure and
the associated probability density define a \emph{State}.
\end{remark}

\begin{definition}
A \emph{Random Variable:} A $\left\{  E,{\LARGE \varepsilon}\right\}  $-valued
random $\mathcal{R}$ is a measurable function from a measurable \emph{sample
space} $X$ (the possible outcomes of experiments) to a measurable space $E$
with $\sigma$-algebra ${\LARGE \varepsilon}$
\begin{equation}
\mathcal{R}:X\rightarrow E,
\end{equation}
where $\mathcal{P}=\left\{  X,\Sigma,\mu\right\}  $ is a \emph{Probability
Space i.e. }$\mu\left(  X\right)  =1$. $\Sigma$ $\left(  X\right)  $
$\equiv{\LARGE \varepsilon}$ is the $\sigma$-algebra of \emph{Events} in the
\emph{Sample Space} $X.$
\end{definition}

\begin{definition}
The \emph{Expectation Value,} $E_{\mu}\left(  \mathcal{R}\right)  ,$ of the
Random Variable /Observable $\mathcal{R}$ in the state $\mu\equiv$ is the
\emph{First Moment} of the Random Variable/Observable $\mathcal{R}$ in a state
$\mu\equiv$ is $\emph{the}$ \emph{mean} value of the Random Variable
/Observable $\mathcal{R}$ in the state $\mu$ is
\begin{equation}
E_{\mu}\left(  \mathcal{R}\right)  =\int pd\mu_{\mathcal{R}}\left(  p\right)
=\int p\rho_{\mu_{\mathcal{R}}}\left(  p\right)  d\lambda\left(  p\right)  .
\end{equation}

\end{definition}

\begin{remark}
$d\mu_{\mathcal{R}}$ is the probability distrubution of the Random Variable
$\mathcal{R}$ in the state $\mu.$
\end{remark}

\begin{remark}
When $E$ is a topological space, then the most common choice for the $\U{3c3}
$-algebra ${\LARGE \varepsilon}$ is the Borel $\U{3c3} $-algebra
$\operatorname*{Bor}\left\{  E\right\}  $, which is the $\U{3c3} $-algebra
generated by the collection of all open sets in $E$. In such case the
$\left\{  E,{\LARGE \varepsilon}\right\}  $-valued random variable is called
an $E$-valued random variable. Moreover, when the space $E$ is the real line
$\mathbb{R}$, then such a real-valued random variable is called simply a
random variable.
\end{remark}

\begin{remark}
If
\begin{equation}
f:X\rightarrow E
\end{equation}
then
\begin{equation}
f^{-1}\left(  B\right)  \in\Sigma\left(  X\right)  ,\quad B\in
\operatorname*{Bor}\left\{  E\right\}  .
\end{equation}

\end{remark}

\begin{remark}
Let $\mathcal{X}\in\mathcal{B}_{normal}\left(  \mathcal{H}^{r}\right)  $ be an
\emph{observable} (possibly an unbounded operator acting on the containing
rigged space $\mathcal{H}^{r})$\qquad then%
\begin{equation}
\mathcal{X=}\int_{\operatorname*{Spec}\left\{  X\right\}  \subseteq
X}xd\mathcal{P}_{\mathcal{X}}\left(  x\right)  ,\quad x\in\mathbb{R}%
\end{equation}
then the associated Probability Distribution (PD), $P_{\mathcal{XD}},$ of
$\mathcal{X}$ in the state $D$
\begin{equation}
P_{\mathcal{XD}}:\Sigma\left(  X\right)  \rightarrow\mathbb{R}%
\end{equation}
is given by
\begin{equation}
P_{\mathcal{XD}}\left(  \Delta\right)  =\int_{\Delta}\operatorname{Tr}\left\{
d\mathcal{P}_{\mathcal{X}}\left(  x\right)  D\right\}  =\operatorname{Tr}%
\left\{  \int_{\Delta}d\mathcal{P}_{\mathcal{X}}\left(  x\right)  D\right\}
=\operatorname{Tr}\left\{  \mathcal{P}_{\mathcal{X}}\left(  \Delta\right)
D\right\}  .
\end{equation}

\end{remark}

\begin{remark}
A probability distribution is a probability measure.
\end{remark}

\begin{remark}
The expectation value of an observable $X\in\mathcal{B}_{sa}\left(
\mathcal{H}\right)  $ is given by
\begin{align}
E_{D}\left(  X\right)   &  =\operatorname{Tr}\left\{  XD\right\}
=\operatorname{Tr}\left\{  \left(  \int_{\operatorname*{Spec}\left\{
X\right\}  }pd\mathcal{P}_{X}\left(  p\right)  \right)  D\right\}
=\operatorname{Tr}\left\{  \left(  \int_{\operatorname*{Spec}\left\{
X\right\}  }pd\mathcal{P}_{X}\left(  p\right)  \right)  \int_{\left(
0,1\right)  }\rho_{D}\left(  p\right)  \left\vert \Psi_{D}\left(  p\right)
\right\rangle \left\langle \Psi_{D}\left(  p\right)  \right\vert
d\lambda\left(  p\right)  \right\} \\
&  =\operatorname{Tr}\left\{  \left(  \int_{\operatorname*{Spec}\left\{
X\right\}  }pd\mathcal{P}_{\mathcal{X}}\left(  p\right)  \right)
\int_{\left(  0,1\right)  }\rho_{D}\left(  p\right)  \left\vert \Psi
_{D}\left(  p\right)  \right\rangle \left\langle \Psi_{D}\left(  p\right)
\right\vert d\lambda\left(  p\right)  \right\} \\
&  =\int_{\operatorname*{Spec}\left\{  X\right\}  }\int_{\left(  0,1\right)
}p^{\prime}\left\langle \Psi_{D}\left(  p\right)  \right\vert d\mathcal{P}%
_{\mathcal{X}}\left(  p^{\prime}\right)  \rho_{D}\left(  p\right)  \left\vert
\Psi_{D}\left(  p\right)  \right\rangle =\int_{\operatorname*{Spec}\left\{
X\right\}  }\int_{\left(  0,1\right)  }p^{\prime}\left\langle \Psi_{D}\left(
p\right)  \right\vert \rho_{\mathcal{X}}\left(  p^{\prime}\right)  \rho
_{D}\left(  p\right)  \left\vert \Psi_{D}\left(  p\right)  \right\rangle
d\lambda\left(  p^{\prime}\right)  d\lambda\left(  p\right)  .
\end{align}

\end{remark}

\begin{remark}
For compact operators one obtains
\begin{align}
E_{D}\left(  X\right)   &  =\operatorname{Tr}\left\{  \left(  \sum_{1\leq
j\leq\infty}p_{j}\left\vert \Psi_{Xj}\right\rangle \left\langle \Psi
_{Xj}\right\vert \right)  \left(  \left(  \sum_{1\leq j\leq\infty}%
d_{j}\left\vert \Psi_{Dj}\right\rangle \left\langle \Psi_{Dj}\right\vert
\right)  \right)  \right\}  =\sum_{1\leq j,k\leq\infty}p_{j}d_{k}\left\vert
\left\langle \Psi_{Xj}\left\vert \Psi_{D_{k}}\right.  \right\rangle
\right\vert ^{2}\\
&  =\sum_{1\leq j\leq\infty}d_{j}\left\langle \Psi_{D_{j}}\left\vert
\mathcal{X}\Psi_{D_{j}}\right.  \right\rangle .
\end{align}

\end{remark}

\begin{remark}
For pure states
\begin{equation}
D=\left\vert \Psi_{D}\right\rangle \left\langle \Psi_{D}\right\vert
\end{equation}
and the expectation value $E_{D}\left(  X\right)  $ of the observable $X$ in
the state $D$ is given by
\begin{equation}
E_{D}\left(  X\right)  =\left\langle \Psi_{D}\left\vert X\Psi_{D}\right.
\right\rangle =\left\langle \Psi_{D}\left\vert \left(  \sum_{1\leq j\leq
\infty}p_{j}\left\vert \Psi_{Xj}\right\rangle \left\langle \Psi_{Xj}%
\right\vert \right)  \Psi_{D}\right.  \right\rangle =\sum_{1\leq j\leq\infty
}p_{j}\left\vert \left\langle \Psi_{Xj}\left\vert \Psi_{D}\right.
\right\rangle \right\vert ^{2}.
\end{equation}

\end{remark}

\begin{example}
\emph{Position Random Variable/Observable} $Q$%
\begin{equation}
Q:X\rightarrow\mathbb{R}^{3},
\end{equation}
where $X$ is the sample space of \emph{positions} in physical space.
\end{example}

\begin{example}
The \emph{average value of the position of an object in a volume }%
$\Delta\subset\mathbb{R}^{3}$ i.e. the observable $Q_{\Delta}$ in a state $D$
is
\begin{equation}
E_{D}\left(  Q_{\Delta}\right)  =E_{D}\left(  \int_{\Delta}xd\mathcal{P}%
_{Q}\left(  x\right)  \right)  =E_{D}\left(  \int_{\Delta}x\rho_{_{Q}}\left(
x\right)  d\lambda\left(  x\right)  \right)
\end{equation}
and the probability that the object is in the region $\Delta\subset X$ in the
state $D$ is
\begin{equation}
P_{Q}\left(  \Delta\right)  =\int_{\Delta}\operatorname{Tr}\left\{
d\mathcal{P}_{Q}\left(  x\right)  D\right\}  =\int_{\Delta}\operatorname{Tr}%
\left\{  \rho_{Q}\left(  x\right)  D\right\}  d\lambda\left(  x\right)
=\int_{\Delta}\rho_{DQ}\left(  x\right)  d\lambda\left(  x\right)  .
\end{equation}

\end{example}

\subsection{Integration of Operators (Spectral Theorem)}

\begin{definition}
A Projection Valued Measure (PVM) is a map $\mathcal{P}$ from the $\sigma
$-algebra $\Sigma\left(  X\right)  $ of subsets of $X$ to the orthogonal
projectors $\operatorname*{Proj}\left\{  \mathcal{H}\right\}  $ acting in a
Hilbert space $\mathcal{H}$ i.e.
\begin{equation}
\mathcal{P}:\Sigma\left(  X\right)  \rightarrow\operatorname*{Proj}\left\{
\mathcal{H}\right\}  \subset\mathcal{B}\left(  \mathcal{H}\right)  ,
\end{equation}
where

\begin{enumerate}
\item The values of the Projection Valued Measure (PVM) are orthogonal
projectors i.e,
\begin{equation}
\mathcal{P}\left(  \Delta\right)  =\int{\large \chi}_{\mathcal{P}}\left(
\Delta\right)  d\mathcal{P}\left(  x\right)  =\int_{\Delta}d\mathcal{P}\left(
x\right)  ,\quad\mathcal{P}\left(  \Delta\right)  =\mathcal{P}\left(
\Delta\right)  ^{2}=\mathcal{P}\left(  \Delta\right)  ^{\dagger}.
\end{equation}


\item ${\large \chi}_{\mathcal{P}}\left(  \Delta\right)  $ is the indicator
function for the set $\Delta\in\Sigma\left(  X\right)  .$

\item The intersection of sets
\begin{equation}
\mathcal{P}\left(  \Delta_{j}\cap\Delta_{k}\right)  =\mathcal{P}\left(
\Delta_{j}\right)  \mathcal{P}\left(  \Delta_{k}\right)  .
\end{equation}


\item If the sets are disjoint
\begin{equation}
\Delta_{j}\cap\Delta_{k}=\phi\Leftrightarrow\mathcal{P}\left(  \Delta
_{j}\right)  \mathcal{P}\left(  \Delta_{k}\right)  =0.
\end{equation}


\item The union of disjoint sets
\begin{equation}
\Delta_{j}\cap\Delta_{k}=\phi\Rightarrow\mathcal{P}\left(  \Delta_{j}%
\cup\Delta_{k}\right)  =\mathcal{P}\left(  \Delta_{j}\right)  +\mathcal{P}%
\left(  \Delta_{k}\right)  .
\end{equation}


\item If $X$ is a \emph{differentiable manifold} the differential
$d\mathcal{P}\left(  x\right)  $ of $\mathcal{P}$ at the point $x$ is a linear
transformation from the tangent space $T_{x}\left(  X\right)  $ of the sample
space $X$ at the point $x$ to the space of bounded operators $\mathcal{B}%
\left(  \mathcal{H}\right)  $ i.e.
\begin{equation}
d\mathcal{P}\left(  x\right)  :T_{x}\left(  X\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}\right)  .
\end{equation}


\item It is possible that $T_{x}\left(  X\right)  $ is a Hilbert space and
isomorphic to $\mathcal{H}$ and thus $X$ is a \emph{Hilbert Manifold or
K\"{a}hler Manifold}.

\item A Projection Valued Measure (PVM) $\mathcal{P}$ forms a \emph{Resolution
of the Identity}
\begin{equation}
\mathcal{P}\left(  X\right)  =\int_{X}d\mathcal{P}\left(  x\right)
=I_{\mathcal{H}}.
\end{equation}

\end{enumerate}
\end{definition}

\begin{remark}%
\begin{equation}
\mathcal{P}:X\rightarrow\operatorname*{Proj}\left\{  \mathcal{H}\right\}  ,
\end{equation}
though $\mathcal{H}$ might have to be replaced by the containing rigged
Hilbert space $\mathcal{H}^{r}$, where
\begin{equation}
\mathcal{H}^{r}\supset\mathcal{H}\supset\mathcal{H}_{r}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
d\mathcal{P}\left(  x\right)  :T_{x}\left(  X\right)  \rightarrow
\operatorname*{Proj}\left\{  \mathcal{H}\right\}  ,
\end{equation}
though $\mathcal{H}$ might have to be replaced by the containing rigged
Hilbert space $\mathcal{H}^{r}.$
\end{remark}

\begin{remark}
$\mathcal{P}$ can be considered as a map into the \emph{Lattice of Projectors}
$\mathcal{LP}\left(  \mathcal{A}\right)  $ contained in a $w^{\ast}$-algebra
$\mathcal{A}.$ The manifold of $1$-dimensional projectors in this Lattice has
a $\emph{K\ddot{a}hler}$ $\emph{manifold}$ structure and is isomorphic to a
\emph{Projective Hilbert space}.
\end{remark}

\begin{remark}
A K\"{a}hler manifold is a manifold with three mutually compatible structures:
\emph{a complex structure}, \emph{a Riemannian structure}, and a
\emph{symplectic structure}.
\end{remark}

\begin{lemma}
In the case $X=\mathbb{R}^{n}$ a PVM $\mathcal{P}$ be can expanded wrt
Lebesgue measure $\mathcal{\lambda}$
\begin{equation}
\mathcal{P}\left(  \Delta\right)  =\int_{\Delta}d\mathcal{P}\left(  x\right)
=\int{\large \chi}_{\mathcal{P}}\left(  \Delta\right)  d\mathcal{P}\left(
x\right)  =\int_{\Delta}\rho_{\mathcal{P}}\left(  x\right)  d\mathcal{\lambda
}\left(  x\right)  =\int_{\Delta}\left\vert \Psi\left(  x\right)
\right\rangle \left\langle \Psi\left(  x\right)  \right\vert d\mathcal{\lambda
}\left(  x\right)  ,
\end{equation}
where $\mathcal{\lambda}$ is lebesgue measure on $\mathbb{R}^{n}$ and forms a
\emph{Resolution of the Identity}%
\begin{equation}
\mathcal{P}\left(  \mathbb{R}^{n}\right)  =\int_{\mathbb{R}^{n}}%
d\mathcal{P}\left(  x\right)  =\int_{\mathbb{R}^{n}}\rho_{\mathcal{P}}\left(
x\right)  d\mathcal{\lambda}\left(  x\right)  =\int_{\mathbb{R}^{n}}\left\vert
\Psi\left(  x\right)  \right\rangle \left\langle \Psi\left(  x\right)
\right\vert d\mathcal{\lambda}\left(  x\right)  =I_{\mathcal{H}},
\end{equation}
i.e. the density $\rho_{\mathcal{P}}\left(  x\right)  \in\mathcal{B}\left(
\mathcal{H}^{r}\right)  $ of $\mathcal{P}\left(  \Delta\right)  \in
\mathcal{B}\left(  \mathcal{H}\right)  $ is given by
\begin{equation}
\rho_{\mathcal{P}}\left(  x\right)  =\left\vert \Psi\left(  x\right)
\right\rangle \left\langle \Psi\left(  x\right)  \right\vert .
\end{equation}

\end{lemma}

\begin{definition}
A \emph{discrete Density Operator} $\rho_{d}\in\mathcal{B}_{1}\left(
\mathcal{H}\right)  $ can be expanded as a sum projectors
\begin{equation}
\rho_{d}=\sum_{1\leq j\leq\infty}\left\vert \Psi_{j}\right\rangle \left\langle
\Psi_{j}\right\vert .
\end{equation}
and produces the operator valued probability density
\begin{equation}
\rho_{d}\left(  x\right)  =\sum_{1\leq j\leq\infty}\left\vert \Psi_{j}\left(
x\right)  \right\rangle \left\langle \Psi_{j}\left(  x\right)  \right\vert
=\sum_{1\leq j\leq\infty}\delta\left(  x-x_{j}\right)  \left\vert \Psi\left(
x\right)  \right\rangle \left\langle \Psi\left(  x\right)  \right\vert .
\end{equation}

\end{definition}

\begin{remark}
The projectors $\left\{  \left.  \left\vert \Psi_{j}\right\rangle \left\langle
\Psi_{j}\right\vert \right\vert 1\leq j\leq\infty\right\}  $ are one
dimensional, thus such probability densities cannot exist in $III$ Von Neumann algebras.
\end{remark}

\begin{definition}
A \emph{simple positive operator valued function }%
\begin{equation}
s:\mathbb{R}^{n}\rightarrow\mathcal{B}\left(  \mathcal{H}\right)
\end{equation}
is defined by%
\begin{equation}
s=\sum_{1\leq j\leq n}\eta_{j}\mathcal{P}_{j},\,\eta_{j}\in\mathbb{R}_{+}%
\end{equation}
where
\begin{equation}
\,\Delta_{j}=s^{-1}\left(  \eta_{j}\right)  ,\quad1\leq j\leq n,\,\Delta
_{j}\in\Sigma\left(  \mathbb{R}^{n}\right)  ,\,\,\eta_{j}\in\mathbb{R}_{+}^{n}%
\end{equation}
and $\left\{  \left.  \mathcal{P}_{j}\right\vert 1\leq j\leq\infty\right\}  $
are PVM's.
\end{definition}

Using \emph{simple positive functions} $s_{A}\left(  x\right)  $ one obtains
the operator valued integral
\begin{equation}
A_{+}=\int_{\Delta}s_{A}\left(  x\right)  d\mathcal{P}_{A}\left(  x\right)
=\sum_{1\leq j\leq n}\eta_{j}\mathcal{P}\left(  \Delta_{j}\right)
\in\mathcal{B}\left(  \mathcal{H}\right)  ,\,\,x\in\mathbb{R}^{n},\eta_{j}%
\in\mathbb{R}_{+},
\end{equation}
which is the \emph{spectral decomposition} of $A_{+}.$This can be generalized
to the spectral decomposition of any \emph{normal operator}
\begin{equation}
A=A_{1+}-A_{2+}+i\left(  A_{3+}-A_{4+}\right)  ,
\end{equation}
where
\begin{equation}
s_{A}=s_{A1+}-s_{A2+}+i\left(  s_{A3+}-s_{A4+}\right)
\end{equation}
is the sum of simple positive functions.

If
\begin{equation}
f=\text{pointwise-}\lim\limits_{m\rightarrow\infty}\left\{  f_{m}\right\}
\equiv p\text{-}\lim\limits_{m\rightarrow\infty}\left\{  f_{m}\right\}
\end{equation}
then the spectral integral has the property
\begin{equation}
\int_{\Delta}f\left(  x\right)  d\mathcal{P}\left(  x\right)  =\int_{\Delta
}\left(  p\text{-}\lim\limits_{m\rightarrow\infty}\left\{  f_{m}\left(
x\right)  \right\}  \right)  d\mathcal{P}\left(  x\right)  =\text{strong
operator-}\lim\limits_{m\rightarrow\infty}\left\{  \int_{\Delta}f_{m}\left(
x\right)  d\mathcal{P}\left(  x\right)  \right\}  \equiv s\text{-}%
\lim\limits_{m\rightarrow\infty}\left\{  \int_{\Delta}f_{m}\left(  x\right)
d\mathcal{P}\left(  x\right)  \right\}  .
\end{equation}


\begin{definition}
Strong Operator Covergence:%
\begin{equation}
T=\text{strong operator-}\lim\limits_{m\rightarrow\infty}\left\{
T_{n}\right\}  \equiv s\text{-}\lim\limits_{m\rightarrow\infty}\left\{
T_{n}\right\}  \Longleftrightarrow\lim\limits_{m\rightarrow\infty}\left\{
\left\Vert \left(  T-T_{n}\right)  \psi\right\Vert _{\mathcal{H}}\right\}
=0\,\forall\psi\in\mathcal{H}.
\end{equation}

\end{definition}

The functions can be extended to
\begin{equation}
f:X\rightarrow\mathbb{C}%
\end{equation}
by
\begin{equation}
f=s_{r+}-s_{r-}+i\left(  s_{i+}-s_{i-}\right)
\end{equation}
leading to normal operators
\begin{equation}
A=\int_{X}\eta d\mathcal{P}_{A}\left(  \eta\right)  =\int%
_{\operatorname*{Spec}\left\{  A\right\}  \subseteq\mathbb{C}}\eta
d\mathcal{P}_{A}\left(  \eta\right)
\end{equation}
and
\begin{equation}
f\left(  A\right)  =\int_{\operatorname*{Spec}\left\{  A\right\}
\subseteq\mathbb{C}}f\left(  \eta\right)  d\mathcal{P}_{A}\left(  \eta\right)
.
\end{equation}


\begin{definition}
A PVM measure $\mathcal{P}_{1}$ is \emph{absolutely continuous} wrt a PVM
measure $\mathcal{P}_{2}$ expressed as
\begin{equation}
\mathcal{P}_{2}\gg\mathcal{P}_{1}%
\end{equation}
if
\begin{equation}
\mathcal{P}_{2}\left(  \Delta\right)  =0\Rightarrow\mathcal{P}_{1}\left(
\Delta\right)  =0,\quad\Delta\in\Sigma.
\end{equation}

\end{definition}

\begin{theorem}
\emph{Operator} \emph{Radon--Nikodym}: If $\mathcal{P}_{2}\gg\mathcal{P}_{1}$
then
\begin{equation}
\mathcal{P}_{2}\left(  \Delta\right)  =\int_{\Delta}\rho_{\mathcal{P}%
_{2}\mathcal{P}_{1}}\left(  x\right)  d\mathcal{P}_{1}\left(  x\right)
=\int_{\Delta}\frac{d\mathcal{P}_{2}}{d\mathcal{P}_{1}}\left(  x\right)
d\mathcal{P}_{1}\left(  x\right)  ,
\end{equation}
i.e. the "density" $\rho_{\mathcal{P}_{2}\mathcal{P}_{1}}$ is the operator
Radon-Nikodym derivative i.e. $\rho_{\mathcal{P}_{2}\mathcal{P}_{1}}%
=\frac{d\mathcal{P}_{2}}{d\mathcal{P}_{1}}.$
\end{theorem}

The PVM $\mathcal{P}_{2}$ that is absolutely continuous wrt $\mathcal{P}_{1}$
has the values
\begin{equation}
\mathcal{P}_{2}\left(  \Delta\right)  =\int\chi_{\Delta}\left(  x\right)
d\mathcal{P}_{2}\left(  x\right)  =\int_{\Delta}d\mathcal{P}_{2}\left(
x\right)  =\int_{\Delta}\rho_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)
d\mathcal{P}_{1}\left(  x\right)  =\int_{\Delta}\left\vert \Psi_{\mathcal{P}%
_{2}\mathcal{P}_{1}}\left(  x\right)  \right\rangle \left\langle
\Psi_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)  \right\vert
d\mathcal{P}_{1}\left(  x\right)  ,
\end{equation}
where $\rho_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)  \in
\operatorname*{Proj}\left\{  \mathcal{B}\left(  \mathcal{H}_{r}\right)
\right\}  $ i.e.%
\begin{equation}
\rho_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)  =\left\vert
\Psi_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)  \right\rangle
\left\langle \Psi_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)
\right\vert ,
\end{equation}
where $\left\vert \Psi_{\mathcal{P}_{2}\mathcal{P}_{1}}\left(  x\right)
\right\rangle \in\mathcal{H}_{r}$, $\left\langle \Psi_{\mathcal{P}%
_{2}\mathcal{P}_{1}}\left(  x\right)  \right\vert \in\mathcal{H}^{r}$ and
$\mathcal{H}^{r}=\left(  \mathcal{H}_{r}\right)  ^{d}.$

\begin{example}
Discrete Spectral Density: In general
\begin{equation}
A=\int_{\operatorname*{Spec}\left\{  A\right\}  }\eta d\mathcal{P}_{A}\left(
\eta\right)  =\int_{\operatorname*{Spec}\left\{  A\right\}  }\eta\rho
_{A}\left(  \eta\right)  d\mathcal{\lambda}\left(  \eta\right)  .
\end{equation}
In the compact operator case the discrete spectral density is
\begin{equation}
\rho_{A}\left(  \eta\right)  =\sum_{1\leq j\leq\infty}\delta\left(  \eta
-\eta_{Aj}\right)  \left\vert \Psi_{A}\left(  \eta\right)  \right\rangle
\left\langle \Psi_{A}\left(  \eta\right)  \right\vert =\sum_{1\leq j\leq
\infty}\delta\left(  \eta-\eta_{Aj}\right)  \left\vert \Psi_{Aj}\right\rangle
\left\langle \Psi_{Aj}\right\vert ,
\end{equation}
where
\begin{equation}
\left\vert \Psi_{Aj}\right\rangle \left\langle \Psi_{Aj}\right\vert
=\left\vert \Psi_{A}\left(  \eta_{Aj}\right)  \right\rangle \left\langle
\Psi_{A}\left(  \eta_{Aj}\right)  \right\vert ,\quad\eta_{Aj}\in
\mathbb{C},1\leq j\leq\infty,
\end{equation}
giving for $A\in\mathcal{B}_{0}\left(  \mathcal{H}\right)  $ the spectral
expansion%
\begin{equation}
A=\sum_{1\leq j\leq\infty}\eta_{Aj}\left\vert \Psi_{Aj}\right\rangle
\left\langle \Psi_{Aj}\right\vert ,\quad\eta_{j}\in\mathbb{C},1\leq
j\leq\infty.
\end{equation}


\begin{enumerate}
\item Consider the density operator $D\in\mathcal{B}_{0}\left(  \mathcal{H}%
\right)  $
\begin{gather}
D=\int_{x\in\mathbb{R}^{+}}xdP_{D}\left(  x\right) \\
\operatorname{Tr}\left\{  D\right\}  =\int_{x\in\mathbb{R}^{+}}%
x\operatorname{Tr}\left\{  d\left(  P_{D}\left(  x\right)  \right)  \right\}
=\int_{x\in\mathbb{R}^{+}}xd\left(  \operatorname{Tr}\left\{  P_{D}\left(
x\right)  \right\}  \right)  =1\\
\int_{x\in\mathbb{R}^{+}}dP_{D}\left(  x\right)  =\int_{x\in\mathbb{R}^{+}%
}\rho_{D}\left(  x\right)  d\lambda\left(  x\right)  =I_{\mathcal{A}}%
\end{gather}
while%
\begin{equation}
\operatorname{Tr}\left\{  I_{\mathcal{A}}\right\}  =\int_{x\in\mathbb{R}^{+}%
}\operatorname{Tr}\left\{  dP_{D}\left(  x\right)  \right\}  =\int%
_{x\in\mathbb{R}^{+}}d\operatorname{Tr}\left\{  P_{D}\left(  x\right)
\right\}  =\int_{x\in\mathbb{R}^{+}}\operatorname{Tr}\left\{  \rho_{D}\left(
x\right)  \right\}  d\lambda\left(  x\right)  =1
\end{equation}
hence
\begin{equation}
P_{D}\left(  x\right)  =\operatorname{Tr}\left\{  \rho_{D}\left(  x\right)
\right\}
\end{equation}
is the \emph{probability density} associated with the state $D.$

\item
\begin{equation}
P_{D\Delta}=\int\chi_{\Delta}\left(  x\right)  dP_{D}\left(  x\right)
=\int_{\Delta}dP_{D}\left(  x\right)  .
\end{equation}


\item
\begin{align}
P_{D\Delta_{1}}  &  =\int\chi_{\Delta_{1}}\left(  x\right)  dP_{D}\left(
x\right)  =\int_{\Delta_{1}}dP_{D}\left(  x\right) \\
P_{D\Delta_{2}}  &  =\int\chi_{\Delta_{2}}\left(  x\right)  dP_{D}\left(
x\right)  =\int_{\Delta_{2}}dP_{D}\left(  x\right) \\
\Delta_{1}  &  \supset\Delta_{2}\\
P_{D\Delta_{1}}-P_{D\Delta_{2}}  &  =\int\left\{  \chi_{\Delta_{1}}\left(
x\right)  P_{D\Delta_{1}}\left(  x\right)  -\chi_{\Delta_{2}}\left(  x\right)
dP_{D\Delta_{2}}\left(  x\right)  \right\}  \geq0.
\end{align}


\item
\begin{equation}
I_{\mathcal{A}}=\int_{X}dP_{I_{\mathcal{A}}}\left(  x\right)  =\int%
\chi_{I_{\mathcal{A}}}\left(  x\right)  dP_{I_{\mathcal{A}}}\left(  x\right)
.
\end{equation}


\item
\begin{align}
\chi_{\Delta_{1}}-\chi_{\Delta_{2}}  &  =\chi_{\Delta_{1}\cup\Delta_{2}}%
-\chi_{\Delta_{1}\cap\Delta_{2}}\\
\Delta_{1}\cup\Delta_{2}  &  =\Delta_{1}\\
\Delta_{1}\cap\Delta_{2}  &  =\Delta_{2}\\
\chi_{\Delta_{1}}-\chi_{\Delta_{2}}  &  =\chi_{\Delta_{1}-\Delta_{2}}.
\end{align}

\end{enumerate}
\end{example}

\begin{example}%
\begin{align}
n_{j}  &  =\int\chi_{n_{j}}\left(  x\right)  dP_{n_{j}}\left(  x\right)
=\int_{x\in\mathbb{R}^{+}}dP_{n_{j}}\left(  x\right)  =P_{\mathcal{H}^{1}%
}+\sum_{1\leq j_{1}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j}\varphi_{j_{1}}\right\vert +\sum_{1\leq
j_{1}<j_{2}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{j}\varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert +\cdots\\
\operatorname*{Spec}\left\{  n_{j}\right\}   &  =\left\{  0,1\right\}  .
\end{align}

\end{example}

\begin{definition}
Normal State: Let $\mathcal{A}$ be a $w^{\ast}$-algebra, and $\U{3c6} $ be a
positive linear functional on $\mathcal{A}$. We say that $\U{3c6} $ is
\emph{normal} if
\begin{equation}
\U{3c6} (\sup\limits_{\U{3b1} }\left\{  A_{\U{3b1} }\right\}  )=\sup
\limits_{\U{3b1} }\left\{  \U{3c6} (A_{\U{3b1} })\right\}
\end{equation}
for all \emph{increasing nets}$\{A_{\U{3b1} }\}$ in $\mathcal{A}_{+}$ that
have an upper bound. If $\mathcal{A}$ is finite dimensional, then each state
is a normal state.
\end{definition}

\begin{remark}
A \emph{normal state} on a von Neumann algebra defines a \emph{countably
additive probability measure} over the \emph{projection lattice contained in
the }von Neumann algebra. The von Neumann algebras familiar from ordinary QM
are algebras of all the bounded operators on a Hilbert space $\mathcal{H}$,
aka Type $I$ factor von Neumann algebras. Their normal states are density
operator states and can be pure or mixed. In QFT and the thermodynamic limit
of QSM, von Neumann algebras of more exotic types abound. \emph{Type
}$\emph{III}$\emph{ von Neumann algebras, for instance, have no
\underline{\emph{pure}} normal states} as the pure states they do have
\emph{fail to be} countably additive.
\end{remark}

\begin{theorem}
Let $\U{3c6} $ be a state on a $w^{\ast}$-algebra $\mathcal{A\subseteq
B}\left(  \mathcal{H}\right)  $ acting on a Hilberts space $\mathcal{H}$. Then
$\U{3c6} $ is normal \emph{if and only if} there exists a density operator
$D_{\Pi_{\U{3c6} }}\in\Pi_{\U{3c6} }\left(  \mathcal{A}\right)  $, i.e. a
\emph{positive trace-class operator }$D_{\Pi_{\U{3c6} }}\in\mathcal{S\left(
\mathcal{B}\left(  \mathcal{H}_{\varphi}\right)  \right)  \subset B}%
_{1}\left(  \mathcal{H}_{\varphi}\right)  $ acting in $\mathcal{H}_{\varphi}$
with
\begin{equation}
\operatorname{Tr}_{\mathcal{H}_{\varphi}}\left\{  D_{\Pi_{\U{3c6} }}\right\}
=1
\end{equation}
such that
\begin{equation}
\U{3c6} (A)=\operatorname{Tr}_{\mathcal{H}_{\varphi}}\left\{  \Pi_{\U{3c6}
}\left(  A\right)  D_{\Pi_{\U{3c6} }}\right\}  \,\forall A\in\mathcal{A},
\end{equation}
where
\begin{equation}
D_{\Pi_{\U{3c6} }}\geq0.
\end{equation}

\end{theorem}

\begin{corollary}
If $\U{3c6} $ is a normal state then $D_{\Pi_{\U{3c6} }}\in\Pi_{\U{3c6}
}\left(  \mathcal{A}\right)  ,$ $D_{\Pi_{\U{3c6} }}\in\mathcal{B}_{1}\left(
\Phi_{\U{3c6} }\left(  \mathcal{A}\right)  \right)  $ and hence $D_{\Pi
_{\U{3c6} }}=\Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)  ,$ where $D_{\U{3c6}
}\in\mathcal{A}.$
\end{corollary}

\begin{corollary}
If $\Pi_{\U{3c6} }$ is faithful then $D_{\U{3c6} }$ is unique.
\end{corollary}

\begin{corollary}
If $\U{3c6} $ is a normal state then%
\begin{equation}
\U{3c6} \left(  D_{\U{3c6} }\right)  =\operatorname{Tr}_{\mathcal{H}_{\varphi
}}\left\{  D_{\Pi_{\U{3c6} }}^{2}\right\}  \leq1.
\end{equation}

\end{corollary}

\begin{corollary}
If
\begin{equation}
\U{3c6} \left(  D_{\U{3c6} }\right)  =\operatorname{Tr}_{\mathcal{H}_{\varphi
}}\left\{  D_{\Pi_{\U{3c6} }}^{2}\right\}  =1
\end{equation}
then $\U{3c6} $ is a pure state and
\begin{equation}
D_{\Pi_{\U{3c6} }}^{2}=D_{\Pi_{\U{3c6} }}.
\end{equation}

\end{corollary}

\begin{remark}
If $\U{3c6} $ is a normal state then%
\begin{equation}
\Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)  \Phi_{\varphi}\left(
I_{\mathcal{A}}\right)  =\Phi_{\varphi}\left(  D_{\U{3c6} }\right)
\end{equation}
and%
\begin{align}
\U{3c6} (A)  &  =\left\langle \left.  \Phi_{\varphi}\left(  I_{\mathcal{A}%
}\right)  \right\vert \Pi_{\U{3c6} }\left(  A\right)  \Phi_{\varphi}\left(
I_{\mathcal{A}}\right)  \right\rangle _{\varphi}=\operatorname{Tr}%
_{\mathcal{H}_{\varphi}}\left\{  \Pi_{\U{3c6} }\left(  A\right)  \left\vert
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert \right\} \\
&  =\operatorname{Tr}_{\mathcal{H}_{\varphi}}\left\{  \Pi_{\U{3c6} }\left(
A\right)  D_{\Pi_{\U{3c6} }}\right\}  =\operatorname{Tr}_{\mathcal{H}%
_{\varphi}}\left\{  \Pi_{\U{3c6} }\left(  A\right)  \Pi_{\U{3c6} }\left(
D_{\U{3c6} }\right)  \right\}  .
\end{align}

\end{remark}

\begin{remark}
If $\U{3c6} $ is a normal state then the vectors $\Phi_{\varphi}\left(
I_{\mathcal{A}}\right)  $ and $\Phi_{\varphi}\left(  D_{\U{3c6} }\right)  $
are not in general equal
\begin{equation}
\left\langle \left.  \left(  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
-\Phi_{\varphi}\left(  D_{\U{3c6} }\right)  \right)  \right\vert \left(
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  -\Phi_{\varphi}\left(
D_{\U{3c6} }\right)  \right)  \right\rangle _{\varphi}=\left\langle \left.
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  \right\rangle _{\varphi}-2\left\langle
\left.  \overset{}{\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  }\right\vert
\Phi_{\varphi}\left(  D_{\U{3c6} }\right)  \right\rangle _{\varphi
}+\left\langle \left.  \Phi_{\varphi}\left(  D_{\U{3c6} }\right)  \right\vert
\Phi_{\varphi}\left(  D_{\U{3c6} }\right)  \right\rangle _{\varphi}.
\end{equation}

\end{remark}

\begin{lemma}
If $\U{3c6} $ is a pure state then
\begin{equation}
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  =\Phi_{\varphi}\left(
D_{\U{3c6} }\right)  .
\end{equation}

\end{lemma}

\begin{corollary}
If $\U{3c6} $ is a pure state then%
\begin{equation}
\left\langle \left.  \left(  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
-\Phi_{\varphi}\left(  D_{\U{3c6} }\right)  \right)  \right\vert \left(
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  -\Phi_{\varphi}\left(
D_{\U{3c6} }\right)  \right)  \right\rangle _{\varphi}=0.
\end{equation}

\end{corollary}

\begin{remark}
If $\U{3c6} $ is a normal state then%
\begin{equation}
\U{3c6} \left(  D_{\U{3c6} }\right)  =\operatorname{Tr}\left\{  \Pi_{\U{3c6}
}\left(  D_{\U{3c6} }\right)  \Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)
\right\}  =\operatorname{Tr}\left\{  \Pi_{\U{3c6} }\left(  D_{\U{3c6}
}\right)  ^{2}\right\}  =\operatorname{Tr}\left\{  D_{\Pi_{\U{3c6} }}%
^{2}\right\}  .
\end{equation}

\end{remark}

\begin{remark}
If $\U{3c6} $ is a state then%
\begin{equation}
\U{3c6} \left(  A\right)  =\operatorname{Tr}\left\{  \Pi_{\U{3c6} }\left(
A\right)  \left\vert \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\rangle \left\langle \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\vert \right\}  .
\end{equation}

\end{remark}

\begin{remark}
If $\U{3c6} $ is a normal state then $D_{\Pi_{\U{3c6} }}=\Pi_{\U{3c6} }\left(
D_{\U{3c6} }\right)  $ then
\[
\U{3c6} \left(  D_{\U{3c6} }\right)  =\operatorname{Tr}\left\{  \left\vert
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert \Pi_{\U{3c6}
}\left(  D_{\U{3c6} }\right)  \right\}  =\left\langle \left.  \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  \right\vert \Pi_{\U{3c6} }\left(  D_{\U{3c6}
}\right)  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle .
\]

\end{remark}

\begin{remark}%
\begin{equation}
\left\Vert \Phi_{\U{3c6} }\left(  I_{\mathcal{A}}-D_{\U{3c6} }\right)
\right\Vert _{\mathcal{H}_{\U{3c6} }}^{2}=\U{3c6} \left(  \left(
I_{\mathcal{A}}-D_{\U{3c6} }\right)  \left(  I_{\mathcal{A}}-D_{\U{3c6}
}\right)  \right)  =\U{3c6} \left(  I_{\mathcal{A}}-2D_{\U{3c6} }+D_{\U{3c6}
}^{2}\right)  =1-2\U{3c6} \left(  D_{\U{3c6} }\right)  +\U{3c6} \left(
D_{\U{3c6} }^{2}\right)  ,
\end{equation}
which again shows that the vectors $\Phi_{\varphi}\left(  I_{\mathcal{A}%
}\right)  $ and $\Phi_{\varphi}\left(  D_{\U{3c6} }\right)  $ are not equal
unless $\U{3c6} $ is a normal \emph{pure} state i.e.
\begin{equation}
D_{\U{3c6} }=D_{\U{3c6} }^{2}%
\end{equation}
and hence
\begin{equation}
D_{\Pi_{\U{3c6} }}=D_{\Pi_{\U{3c6} }}^{2}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{gather}
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  -\Phi_{\varphi}\left(
D_{\U{3c6} }\right)  =0\Rightarrow\left\langle \left.  \left(  \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  -D_{\Pi_{\U{3c6} }}\right)  \right\vert
\left(  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  -D_{\Pi_{\U{3c6} }%
}\right)  \right\rangle _{\varphi}=0\\
\Rightarrow\left\langle \left.  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\vert \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle
_{\varphi}-2\left\langle \left.  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\vert D_{\Pi_{\U{3c6} }}\right\rangle _{\varphi}+\left\langle \left.
D_{\Pi_{\U{3c6} }}\right\vert D_{\Pi_{\U{3c6} }}\right\rangle _{\varphi
}=1-2\varphi\left(  D_{\U{3c6} }\right)  +\varphi\left(  D_{\U{3c6} }%
^{2}\right)  =0
\end{gather}
If $D_{\Pi_{\U{3c6} }}$is a pure state
\begin{equation}
D_{\Pi_{\U{3c6} }}=D_{\Pi_{\U{3c6} }}^{2}%
\end{equation}
and
\begin{equation}
\operatorname{Tr}\left\{  D_{\Pi_{\U{3c6} }}\right\}  =1=\varphi\left(
D_{\U{3c6} }\right)  .
\end{equation}
Thus if $\varphi$ is a pure normal state
\begin{equation}
1-2\varphi\left(  D_{\U{3c6} }\right)  +\varphi\left(  D_{\U{3c6} }%
^{2}\right)  =1-2\varphi\left(  D_{\U{3c6} }\right)  +\varphi\left(
D_{\U{3c6} }\right)  =0
\end{equation}
and
\begin{equation}
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  =\Phi_{\varphi}\left(
D_{\U{3c6} }\right)  .
\end{equation}

\end{remark}

\begin{remark}
Are the operators $\Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)  $ and
$\left\vert \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle
\left\langle \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert $
equal? The action of their difference is
\begin{align}
\left(  \Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)  -\left\vert \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  \right\vert \right)  \Phi_{\varphi}\left(
A\right)   &  =\Phi_{\varphi}\left(  D_{\U{3c6} }A\right)  -\left\langle
\left.  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert
\Phi_{\varphi}\left(  A\right)  \right\rangle \Phi_{\varphi}\left(
I_{\mathcal{A}}\right) \\
&  =\Phi_{\varphi}\left(  D_{\U{3c6} }A\right)  -\varphi\left(  A\right)
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  .
\end{align}

\end{remark}

\begin{remark}
Notice the difference between the inner product and expectation value
differences:
\begin{align}
\operatorname{Tr}\left\{  \Pi_{\U{3c6} }\left(  X\right)  \Pi_{\U{3c6}
}\left(  D_{\U{3c6} }\right)  \right\}   &  =\U{3c6} \left(  X\right) \\
\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert \Phi
_{\varphi}\left(  B\right)  \right\rangle _{\U{3c6} }  &  =\U{3c6} \left(
A^{\dagger}B\right) \\
\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert \Pi_{\U{3c6}
}\left(  X\right)  \Phi_{\varphi}\left(  B\right)  \right\rangle _{\U{3c6} }
&  =\U{3c6} \left(  A^{\dagger}XB\right) \\
\left\langle \left.  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert
\Pi_{\U{3c6} }\left(  X\right)  \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\rangle _{\U{3c6} }  &  =\U{3c6} \left(  X\right)  .
\end{align}

\end{remark}

\begin{remark}
The expectation value of their difference is
\begin{gather}
\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert \left(
D_{\Pi_{\U{3c6} }}-\left\vert \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\rangle \left\langle \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\vert \right)  \Phi_{\varphi}\left(  A\right)  \right\rangle _{\U{3c6}
}=\operatorname{Tr}\left\{  \left(  D_{\Pi_{\U{3c6} }}-\left\vert
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert \right)  \left\vert
\Phi_{\varphi}\left(  A\right)  \right\rangle \left\langle \Phi_{\varphi
}\left(  A\right)  \right\vert \right\} \\
=\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert
D_{\Pi_{\U{3c6} }}\Phi_{\varphi}\left(  A\right)  \right\rangle _{\U{3c6}
}-\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert \left\vert
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert \Phi_{\varphi
}\left(  A\right)  \right\rangle _{\U{3c6} }\\
=\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert
D_{\Pi_{\U{3c6} }}\Phi_{\varphi}\left(  A\right)  \right\rangle _{\U{3c6}
}-\left\vert \left\langle \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\vert \Phi_{\varphi}\left(  A\right)  _{\U{3c6} }\right\vert
^{2}=\varphi\left(  A^{\dagger}D_{\U{3c6} }A\right)  -\left\vert
\varphi\left(  A\right)  \right\vert ^{2},
\end{gather}
which is not in general zero.
\end{remark}

\begin{remark}
This expectation value can also be expressed in trace form as
\begin{align}
&  \operatorname{Tr}\left\{  \left(  D_{\Pi_{\U{3c6} }}-\left\vert
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\vert \right)  \left\vert
\Phi_{\varphi}\left(  A\right)  \right\rangle \left\langle \Phi_{\varphi
}\left(  A\right)  \right\vert \right\} \\
&  =\operatorname{Tr}\left\{  D_{\Pi_{\U{3c6} }}\left\vert \Phi_{\varphi
}\left(  A\right)  \right\rangle \left\langle \Phi_{\varphi}\left(  A\right)
\right\vert \right\}  -\operatorname{Tr}\left\{  \left\vert \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle \Phi_{\varphi
}\left(  I_{\mathcal{A}}\right)  \right\vert \left\vert \Phi_{\varphi}\left(
A\right)  \right\rangle \left\langle \Phi_{\varphi}\left(  A\right)
\right\vert \right\} \\
&  =\varphi\left(  A^{\dagger}D_{\U{3c6} }A\right)  -\left\vert \varphi\left(
A\right)  \right\vert ^{2}.
\end{align}

\end{remark}

\begin{remark}
If
\begin{equation}
D_{\U{3c6} }=D_{\U{3c6} }^{2}%
\end{equation}
then
\begin{equation}
\Phi_{\U{3c6} }\left(  I_{\mathcal{A}}\right)  =\Phi_{\U{3c6} }\left(
D_{\U{3c6} }\right)  .
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\varphi\left(  D^{2}\right)  =\varphi\left(  D\right)  =1\Leftrightarrow
D^{2}=D
\end{equation}

\end{lemma}

\begin{proof}
\begin{enumerate}
\item
\begin{align}
D^{2}  &  =\sum_{1\leq j\leq\infty}d_{j}^{2}P_{j}\\
\varphi\left(  D^{2}\right)   &  =\sum_{1\leq j\leq\infty}d_{j}^{2}%
\varphi\left(  P_{j}\right)  =1
\end{align}


\item
\begin{align}
D  &  =\sum_{1\leq j\leq\infty}d_{j}P_{j}\\
\varphi\left(  D\right)   &  =\sum_{1\leq j\leq\infty}d_{j}\varphi\left(
P_{j}\right)  =1
\end{align}


\item
\begin{equation}
\sum_{1\leq j\leq\infty}P_{j}=I_{\mathcal{A}}%
\end{equation}


\item
\begin{equation}
d_{j}^{2}=d_{j}\Leftrightarrow d_{j}\left(  d_{j}-1\right)  =0\Leftrightarrow
d_{j}=\left\{
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right.  ,\quad1\leq j\leq\infty.
\end{equation}

\end{enumerate}
\end{proof}

\begin{remark}
In general $\left\vert \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\rangle \left\langle \Phi_{\varphi}\left(  I_{\mathcal{A}}\right)
\right\vert $ \emph{may or may not belong to} $\Pi_{\U{3c6} }\left(
\mathcal{A}\right)  .$ If $\U{3c6} $ is a normal state then $D_{\Pi_{\U{3c6}
}}\in\Pi_{\U{3c6} }\left(  \mathcal{A}\right)  $ and $D_{\Pi_{\U{3c6} }}%
=\Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)  .$ If $\Pi_{\U{3c6} }$ is faithful
then $D_{\U{3c6} }$ is unique.
\end{remark}

\begin{remark}
In order for $\U{3c6} $ to be a state it must be a \underline{\emph{linear}}
functional thus
\begin{equation}
\U{3c6} \left(  z_{1}A_{1}+z_{2}A_{2}\right)  =z_{1}\U{3c6} \left(
A_{1}\right)  +z_{2}\U{3c6} \left(  A_{2}\right)
\end{equation}
as well as positive
\begin{equation}
\U{3c6} \left(  A^{\dagger}A\right)  \geq0\quad\forall A\in\mathcal{A}%
\end{equation}
and normalized
\begin{equation}
\U{3c6} \left(  I_{\mathcal{A}}\right)  =1.
\end{equation}
Thus normal states defined in terms of traces must have the form
\begin{equation}
\U{3c6} \left(  A\right)  \ =\operatorname{Tr}\left\{  AD_{2\U{3c6} }\right\}
,
\end{equation}
which is\emph{ not of the form} of a Hilbert Schmidt inner product
\begin{equation}
\ \left\langle \left.  A\right\vert D_{\U{3c6} }\right\rangle _{HS}%
=\operatorname{Tr}\left\{  A^{\dagger}D_{2\U{3c6} }\right\}  .
\end{equation}
Hence
\begin{equation}
\U{3c6} \left(  A\right)  =\left\langle A,D_{\U{3c6} }\right\rangle
=\left\langle \left.  A^{\dagger}\right\vert D_{\U{3c6} }\right\rangle _{HS},
\end{equation}
where
\begin{equation}
D_{\U{3c6} }\in\mathcal{A}_{\ast}%
\end{equation}
and
\begin{equation}
\left\langle \left.  A^{\dagger}\right\vert D_{\U{3c6} }\right\rangle
_{HS}=\U{3c6} \left(  A\right)  .
\end{equation}

\end{remark}

\begin{remark}
If a normalized trace $\operatorname*{tr}$ exists it defines a state $\U{3c6}
_{\operatorname*{tr}}$ by
\begin{equation}
\U{3c6} _{\operatorname*{tr}}\left(  A\right)  =\operatorname*{tr}\left\{
AI_{A}\right\}  =\operatorname*{tr}\left\{  A\right\}  .
\end{equation}

\end{remark}

\begin{remark}
One can use a state $\U{3c6} $ to define a possibly degenerate inner product
\begin{equation}
\left\langle \left.  A\right\vert B\right\rangle _{\U{3c6} }=\U{3c6} \left(
A^{\dagger}B\right)  ,\quad\forall A,B\in\mathcal{A}%
\end{equation}
and thus a GNS map%
\begin{equation}
\Phi_{\U{3c6} }:\mathcal{A\rightarrow H}_{\U{3c6} },
\end{equation}
where
\begin{equation}
\ker\left\{  \Phi_{\U{3c6} }\right\}  =\left\{  \left.  A\right\vert \U{3c6}
\left(  A^{\dagger}A\right)  =0;A\in\mathcal{A}\right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\Pi_{\U{3c6} }\left(  D_{\U{3c6} }\right)  \Phi_{\U{3c6} }\left(  A\right)
=\Phi_{\U{3c6} }\left(  D_{\U{3c6} }A\right)  .
\end{equation}

\end{remark}

Consider a tracial state $\U{3c6} _{\operatorname*{tr}},$ i.e.
\begin{equation}
\U{3c6} _{\operatorname*{tr}}\left(  AB\right)  =\U{3c6} _{\operatorname*{tr}%
}\left(  BA\right)  \quad\forall A,B\in\mathcal{A}%
\end{equation}
defined by
\begin{equation}
\U{3c6} _{\operatorname*{tr}}\left(  A\right)  =\operatorname*{tr}\left\{
AD_{\operatorname*{tr}}\right\}  =\operatorname*{tr}\left\{  AI_{\mathcal{A}%
}\right\}  ,
\end{equation}
where $\operatorname*{tr}$ is a normalized trace i.e.
\begin{equation}
\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =1.
\end{equation}
If $\U{3c6} _{\operatorname*{tr}}\in\mathcal{S\left(  \mathcal{A}\right)  }$
is a normal state then
\begin{gather}
\U{3c6} _{\operatorname*{tr}}(A)=\operatorname*{tr}\left\{
AD_{\operatorname*{tr}}\right\}  =\operatorname{Tr}_{\mathcal{H}_{\U{3c6}
_{\operatorname*{tr}}}}\left\{  \Pi_{\U{3c6} _{\operatorname*{tr}}}\left(
A\right)  \Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  D_{\operatorname*{tr}%
}\right)  \right\}  \,\forall A\in\mathcal{A}\\
\operatorname*{tr}\left\{  D_{\operatorname*{tr}}\right\}  =\operatorname{Tr}%
_{\mathcal{H}_{\U{3c6} _{\operatorname*{tr}}}}\left\{  \Pi_{\U{3c6}
_{\operatorname*{tr}}}\left(  D_{\operatorname*{tr}}\right)  \right\}  =1.
\end{gather}


\begin{conjecture}
$\U{3c6} _{\operatorname*{tr}}$ is not a normal state if it was
$D_{\operatorname*{tr}}$ would belong to predual $\mathcal{A}_{\ast}$ of
$\mathcal{A,}$which it does not.
\end{conjecture}

\begin{remark}
If the $w^{\ast}$-algebra $\mathcal{A}$ is of type $II$ or $III$ it has
\emph{no normal pure states}.
\end{remark}

Let
\begin{equation}
D_{\operatorname*{tr}}=D_{\operatorname*{tr}}^{2}%
\end{equation}
then

\begin{enumerate}
\item
\begin{equation}
\U{3c6} _{\operatorname*{tr}}(A)=\left\langle \left.  \Phi_{\U{3c6}
_{\operatorname*{tr}}}\left(  I_{\mathcal{A}}\right)  \right\vert \Pi_{\U{3c6}
_{\operatorname*{tr}}}\left(  A\right)  \Phi_{\U{3c6} _{\operatorname*{tr}}%
}\left(  I_{\mathcal{A}}\right)  \right\rangle _{\U{3c6} _{\operatorname*{tr}%
}}=\operatorname*{tr}\left\{  A\right\}
\end{equation}


\item
\begin{equation}
\left(  I_{\mathcal{A}}-D_{\operatorname*{tr}}\right)  ^{2}=I_{\mathcal{A}%
}-2D_{\operatorname*{tr}}+D_{\operatorname*{tr}}=I_{\mathcal{A}}%
-D_{\operatorname*{tr}}.
\end{equation}


\item
\begin{equation}
\left(  I_{\mathcal{A}}-D_{\operatorname*{tr}}\right)  D_{\operatorname*{tr}%
}=0.
\end{equation}


\item
\begin{equation}
\operatorname*{tr}\left\{  \left(  I_{\mathcal{A}}-D_{\operatorname*{tr}%
}\right)  \right\}  =0.
\end{equation}


\item
\begin{align}
\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  D_{\operatorname*{tr}}\right)
^{2}  &  =\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  D_{\operatorname*{tr}%
}\right) \\
\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  \left(  I_{\mathcal{A}%
}-D_{\operatorname*{tr}}\right)  \right)  ^{2}  &  =\Pi_{\U{3c6}
_{\operatorname*{tr}}}\left(  \left(  I_{\mathcal{A}}-D_{\operatorname*{tr}%
}\right)  \right)  .
\end{align}


\item
\begin{equation}
\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  I_{\mathcal{A}}%
-D_{\operatorname*{tr}}\right)  \Pi_{\U{3c6} _{\operatorname*{tr}}}\left(
D_{\operatorname*{tr}}\right)  =\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(
\left(  I_{\mathcal{A}}-D_{\operatorname*{tr}}\right)  D_{\operatorname*{tr}%
}\right)  =0.
\end{equation}

\end{enumerate}

\begin{remark}%
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\left\langle \left.  \Phi_{\U{3c6}
_{\operatorname*{tr}}}\left(  I_{\mathcal{A}}\right)  \right\vert \Pi_{\U{3c6}
_{\operatorname*{tr}}}\left(  A\right)  \Phi_{\U{3c6} _{\operatorname*{tr}}%
}\left(  I_{\mathcal{A}}\right)  \right\rangle _{\U{3c6} _{\operatorname*{tr}%
}}%
\end{equation}
thus
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  \neq\operatorname{Tr}_{\mathcal{H}%
_{\U{3c6} _{\operatorname*{tr}}}}\left\{  \Pi_{\U{3c6} _{\operatorname*{tr}}%
}\left(  A\right)  \right\}
\end{equation}
as
\begin{equation}
\operatorname{Tr}_{\mathcal{H}_{\U{3c6} _{\operatorname*{tr}}}}\left\{
\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  A\right)  \right\}  =\left\langle
\left.  \Phi_{\U{3c6} _{\operatorname*{tr}}}\left(  I_{\mathcal{A}}\right)
\right\vert \Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  A\right)  \Phi_{\U{3c6}
_{\operatorname*{tr}}}\left(  I_{\mathcal{A}}\right)  \right\rangle _{\U{3c6}
_{\operatorname*{tr}}}+\operatorname{Tr}_{\mathcal{H}_{\U{3c6}
_{\operatorname*{tr}}}}\left\{  \left(  I_{\mathcal{H}_{\U{3c6}
_{\operatorname*{tr}}}}-\left\vert \Phi_{\U{3c6} _{\operatorname*{tr}}}\left(
I_{\mathcal{A}}\right)  \right\rangle \left\langle \Phi_{\U{3c6}
_{\operatorname*{tr}}}\left(  I_{\mathcal{A}}\right)  \right\vert \right)
\Pi_{\U{3c6} _{\operatorname*{tr}}}\left(  A\right)  \right\}  .
\end{equation}

\end{remark}

\section{Polynomial $w^{\ast}$-Algebra $\mathcal{A}$}

\begin{definition}%
\begin{align}
\mathcal{A}  &  =\text{strong operator-}\lim\limits_{r\rightarrow\infty
}\left\{  \operatorname*{Alg}\left\{  I_{\mathcal{A}},\left\{  x_{1}%
,\cdots,x_{2r}\right\}  \right\}  \right\} \\
&  =\text{strong operator-}\lim\limits_{r\rightarrow\infty}\left\{  \left(
\alpha_{0}I_{\mathcal{A}}+\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\alpha
_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}\right)  ,\alpha_{j_{1}\cdots
j_{n}}\in\mathbb{C},1\leq j_{1}<\cdots<j_{n}\leq2r,0\leq n\leq2r\right\}
\end{align}

\end{definition}

\begin{remark}
The condition of $\mathcal{A}$ being a von Neumann algebra i.e. being closed
in the weak operator topology is equivalent to being closed in the
\textquotedblleft strong\textquotedblright, \textquotedblleft
ultrastrong\textquotedblright, or \textquotedblleft
ultraweak\textquotedblright\ operator topologies, which are topological
conditions, and is equivalent to an algebraic condition i.e. being equal to
its bicommutant.
\end{remark}

\begin{definition}
A normalized tracial state can be defined as
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\left\langle A\right\rangle _{0}%
=\alpha_{0}.
\end{equation}

\end{definition}

\begin{definition}
$\mathcal{A}$ is a $w^{\ast}$-Algebra if is a $c^{\ast}$-Algebra that has a
predual $\mathcal{A}_{\ast}$.
\end{definition}

\begin{remark}
When people say \emph{"weak topology"} in the context of von Neumann algebras
they are usually referring to the topology induced by the \emph{normal
functionals}, which is the \emph{weak * topology} when the algebra is seen as
the dual of the normal functionals. In a concrete von Neumann algebra, this is
the \emph{ultraweak topology}; it \emph{agrees with the weak operator topology
on bounded set}s it is induced by the seminorms%
\begin{equation}
p\left(  A\right)  =\left\vert \varphi\left(  A\right)  \right\vert ,\quad
A\in\mathcal{A},\,\varphi\in\mathcal{A}_{\ast}%
\end{equation}

\end{remark}

\begin{remark}
$\mathcal{A}$ is closed in this topology.
\end{remark}

\begin{remark}
Convergence
\begin{equation}
A=w\text{-}\lim\limits_{\left\{  A_{j}\right\}  _{j\in J}}A_{j}\Leftrightarrow
p\left(  A-A_{j}\right)  \searrow0\Leftrightarrow p\left(  A-A_{j}\right)
=p\left(  A_{j}\right)  \longrightarrow p\left(  A\right)
\end{equation}

\end{remark}

\begin{remark}
The \emph{weak topology} induced on a von Neumann algebra by its predual is
called the \emph{ultraweak topology}. The role of the \emph{ultraweak
topology} for von Neumann algebras is analogous to the role of the \emph{norm
topology for C*-algebras}.
\end{remark}

\begin{definition}
$\mathcal{A}$ is a $c^{\ast}$-Algebra is an algebra that is a Banach space
with norm $\left\Vert {}\right\Vert _{\mathcal{A}}$ that has the properties

\begin{enumerate}
\item
\begin{equation}
\left\Vert A^{\dagger}A\right\Vert _{\mathcal{A}}=\left\Vert A\right\Vert
_{\mathcal{A}}^{2}.
\end{equation}


\item "$\dagger"$ is an involution such that
\begin{align}
\left(  AB\right)  ^{\dagger}  &  =B^{\dagger}A^{\dagger}\\
\left(  \alpha A+\beta B\right)  ^{\dagger}  &  =\overline{\alpha}A^{\dagger
}+\overline{\beta}B^{\dagger}.
\end{align}

\end{enumerate}
\end{definition}

$\mathcal{A}$ is a polynomial algebra
\begin{equation}
\mathcal{A}=\mathbb{C}\text{-}\operatorname*{Alg}\left\{  \left\{  \left.
x_{j}\right\vert 1\leq j\leq2r\right\}  ,I_{\mathcal{A}}\right\}  ,
\end{equation}
where the generators have the properties:

\begin{enumerate}
\item Anti Commutivity%
\begin{equation}
x_{j}x_{k}=-x_{k}x_{j}\Longleftrightarrow\left\{  x_{j},x_{k}\right\}
=0,\quad1\leq j<k\leq2r
\end{equation}


\item Normalized bases elements are involutions
\begin{equation}
x_{j}^{2}=I_{\mathcal{A}}\Longleftrightarrow\left\{  x_{j},x_{j}\right\}
=2I_{\mathcal{A}},\quad1\leq j\leq2r.
\end{equation}

\end{enumerate}

$\mathcal{A}$ has a graded decomposition
\begin{equation}
\mathcal{A}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\mathcal{A}_{n},
\end{equation}
where
\begin{equation}
\mathcal{A}_{n}=%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\mathcal{A}_{1}%
\end{equation}
and the grading is left invariant by transformations $T\in{\large \boxtimes
}\mathcal{B}\left(  \mathcal{A}_{1}\right)  $ where
\begin{equation}
{\large \boxtimes}\mathcal{B}\left(  \mathcal{A}_{1}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
{\large \boxtimes}^{n}\mathcal{B}\left(  \mathcal{A}_{1}\right)  .
\end{equation}


\begin{theorem}
$\mathcal{A}$ is a Clifford Algebra.
\end{theorem}

\begin{definition}
Normalized Trace%
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\left\langle A\right\rangle _{0}.
\end{equation}

\end{definition}

\begin{lemma}
$\left\langle {}\right\rangle _{0}\equiv\operatorname*{tr}$ is faithful and
symmetric i.e.

\begin{enumerate}
\item
\begin{equation}
\left\langle AB\right\rangle _{0}=\left\langle BA\right\rangle _{0}%
\equiv\operatorname*{tr}\left\{  AB\right\}  =\operatorname*{tr}\left\{
BA\right\}  .
\end{equation}


\item
\begin{equation}
\left\langle A\right\rangle _{0}=0\Leftrightarrow A=0.
\end{equation}

\end{enumerate}
\end{lemma}

$\lceil$Grade filters $\left\langle {}\right\rangle _{n}$ are
\begin{equation}
\left\langle A\right\rangle _{n}=A_{n}\in\mathcal{A}_{n}%
\end{equation}
Multiplication is given by
\begin{equation}
AB=\sum_{0\leq m,n\leq2r}A_{m}B_{n},
\end{equation}
where
\begin{equation}
A_{m}B_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle A_{m}%
B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\left\langle A_{m}%
B_{n}\right\rangle _{\left\vert m-n\right\vert +0}+\left\langle A_{m}%
B_{n}\right\rangle _{\left\vert m-n\right\vert +2}+\cdots+\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2\left(  \min\left(
m,n\right)  -1\right)  }+\left\langle A_{m}B_{n}\right\rangle _{\left\vert
m-n\right\vert +2\left(  \min\left(  m,n\right)  \right)  }%
\end{equation}
giving%
\begin{equation}
AB=\sum_{0\leq m,n\leq2r}\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{equation}
$\rfloor$

\begin{remark}%
\begin{align}
&  A^{\dagger}A=\sum_{0\leq m,n\leq2r}A_{m}^{\dagger}A_{n}\\
&  A_{m}^{\dagger}A_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert +2j}%
=\left\langle A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert
+0}+\left\langle A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert
+2}+\cdots+\left\langle A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert
m-n\right\vert +2\left(  \min\left(  m,n\right)  -1\right)  }+\left\langle
A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert +2\left(
\min\left(  m,n\right)  \right)  }\\
&  A^{\dagger}A=\sum_{0\leq m,n\leq2r}\sum_{j=0}^{\min\left(  m,n\right)
}\left\langle A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert
+2j}\\
&  \left\langle A_{m}^{\dagger}A_{n}\right\rangle _{\left\vert m-n\right\vert
+2j}=\sum_{\substack{0\leq j_{1}<\cdots<j_{m}\leq2r\\0\leq k_{1}<\cdots
<k_{n}\leq2r}}\left(  \alpha_{j_{1}\cdots j_{m}}x_{j_{1}\cdots}x_{j_{m}%
}\right)  ^{\dagger}\left(  \alpha_{j_{1}\cdots j_{n}}x_{k_{1}\cdots}x_{k_{n}%
}\right)  =\sum_{\substack{0\leq j_{1}<\cdots<j_{m}\leq2r\\0\leq k_{1}%
<\cdots<k_{n}\leq2r}}\overline{\alpha_{j_{1}\cdots j_{m}}}\alpha_{j_{n}\cdots
j_{1}}x_{j_{1}\cdots}x_{j_{m}}x_{k_{1}\cdots}x_{k_{n}}\\
&  \quad\quad\quad\quad\quad\quad\,\left.  =\right.  \sum_{\substack{0\leq
j_{1}<\cdots<j_{m}\leq2r\\0\leq k_{1}<\cdots<k_{n}\leq2r}}\left(  -1\right)
^{m+1}\overline{\alpha_{j_{1}\cdots j_{m}}}\alpha_{j_{1}\cdots j_{n}}%
x_{j_{1}\cdots}x_{j_{m}}x_{k_{1}\cdots}x_{k_{n}}.
\end{align}


\begin{example}
\begin{enumerate}
\item $r=2$%
\begin{align}
&  AB=\sum_{0\leq m,n\leq4}\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\\
&  \sum_{j=0}^{0}\left\langle A_{0}B_{0}\right\rangle _{0+2j}+\sum_{j=0}%
^{0}\left\langle A_{1}B_{0}\right\rangle _{1+2j}+\sum_{j=0}^{0}\left\langle
A_{2}B_{0}\right\rangle _{2+2j}+\sum_{j=0}^{0}\left\langle A_{3}%
B_{0}\right\rangle _{3+2j}+\sum_{j=0}^{0}\left\langle A_{4}B_{0}\right\rangle
_{4+2j}\\
&  \sum_{j=0}^{0}\left\langle A_{0}B_{1}\right\rangle _{1+2j}+\sum_{j=0}%
^{1}\left\langle A_{1}B_{1}\right\rangle _{0+2j}+\sum_{j=0}^{1}\left\langle
A_{2}B_{1}\right\rangle _{1+2j}+\sum_{j=0}^{1}\left\langle A_{3}%
B_{1}\right\rangle _{2+2j}+\sum_{j=0}^{1}\left\langle A_{4}B_{1}\right\rangle
_{3+2j}\\
&  \sum_{j=0}^{0}\left\langle A_{0}B_{2}\right\rangle _{2+2j}+\sum_{j=0}%
^{1}\left\langle A_{1}B_{2}\right\rangle _{1+2j}+\sum_{j=0}^{2}\left\langle
A_{2}B_{2}\right\rangle _{0+2j}+\sum_{j=0}^{2}\left\langle A_{3}%
B_{2}\right\rangle _{1+2j}+\sum_{j=0}^{2}\left\langle A_{4}B_{2}\right\rangle
_{2+2j}\\
&  \sum_{j=0}^{0}\left\langle A_{0}B_{3}\right\rangle _{3+2j}+\sum_{j=0}%
^{1}\left\langle A_{1}B_{3}\right\rangle _{2+2j}+\sum_{j=0}^{2}\left\langle
A_{2}B_{3}\right\rangle _{1+2j}+\sum_{j=0}^{3}\left\langle A_{3}%
B_{3}\right\rangle _{0+2j}+\sum_{j=0}^{3}\left\langle A_{4}B_{3}\right\rangle
_{1+2j}\\
&  \sum_{j=0}^{0}\left\langle A_{0}B_{4}\right\rangle _{4+2j}+\sum_{j=0}%
^{1}\left\langle A_{1}B_{4}\right\rangle _{3+2j}+\sum_{j=0}^{2}\left\langle
A_{2}B_{4}\right\rangle _{2+2j}+\sum_{j=0}^{3}\left\langle A_{3}%
B_{4}\right\rangle _{1+2j}+\sum_{j=0}^{4}\left\langle A_{4}B_{4}\right\rangle
_{0+2j}.
\end{align}


\item $r=2$%
\begin{align}
&  AB=\sum_{0\leq m,n\leq4}\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\\
&  \left\langle A_{0}B_{0}\right\rangle _{0}+\left\langle A_{1}B_{0}%
\right\rangle _{1}+\left\langle A_{2}B_{0}\right\rangle _{2}+\left\langle
A_{3}B_{0}\right\rangle _{3}+\left\langle A_{4}B_{0}\right\rangle _{4}\\
&  +\left\langle A_{0}B_{1}\right\rangle _{1}+\left\langle A_{1}%
B_{1}\right\rangle _{0}+\left\langle A_{1}B_{1}\right\rangle _{2}+\left\langle
A_{2}B_{1}\right\rangle _{1}+\left\langle A_{2}B_{1}\right\rangle
_{3}+\left\langle A_{3}B_{1}\right\rangle _{2}+\left\langle A_{3}%
B_{1}\right\rangle _{4}+\left\langle A_{4}B_{1}\right\rangle _{3}+\left\langle
A_{4}B_{1}\right\rangle _{5}\\
&  +\left\langle A_{0}B_{2}\right\rangle _{2}+\left\langle A_{1}%
B_{2}\right\rangle _{1}+\left\langle A_{1}B_{2}\right\rangle _{3}+\left\langle
A_{2}B_{2}\right\rangle _{0}+\left\langle A_{2}B_{2}\right\rangle
_{2}+\left\langle A_{2}B_{2}\right\rangle _{4}\\
&  +\left\langle A_{3}B_{2}\right\rangle _{1}+\left\langle A_{3}%
B_{2}\right\rangle _{3}+\left\langle A_{3}B_{2}\right\rangle _{5}+\left\langle
A_{4}B_{2}\right\rangle _{2}+\left\langle A_{4}B_{2}\right\rangle
_{4}+\left\langle A_{4}B_{2}\right\rangle _{6}\\
&  +\left\langle A_{0}B_{3}\right\rangle _{3}+\left\langle A_{1}%
B_{3}\right\rangle _{2}+\left\langle A_{1}B_{3}\right\rangle _{4}+\left\langle
A_{2}B_{3}\right\rangle _{1}+\left\langle A_{2}B_{3}\right\rangle
_{3}+\left\langle A_{2}B_{3}\right\rangle _{5}\\
&  +\left\langle A_{3}B_{3}\right\rangle _{0}+\left\langle A_{3}%
B_{3}\right\rangle _{2}+\left\langle A_{3}B_{3}\right\rangle _{4}+\left\langle
A_{3}B_{3}\right\rangle _{6}+\left\langle A_{4}B_{3}\right\rangle
_{1}+\left\langle A_{4}B_{3}\right\rangle _{3}\\
&  +\left\langle A_{4}B_{3}\right\rangle _{5}+\left\langle A_{4}%
B_{3}\right\rangle _{7}\\
&  +\left\langle A_{0}B_{4}\right\rangle _{4}+\left\langle A_{1}%
B_{4}\right\rangle _{3}+\left\langle A_{1}B_{4}\right\rangle _{5}+\left\langle
A_{2}B_{4}\right\rangle _{2}+\left\langle A_{2}B_{4}\right\rangle
_{4}+\left\langle A_{2}B_{4}\right\rangle _{6}\\
&  +\left\langle A_{3}B_{4}\right\rangle _{1}+\left\langle A_{3}%
B_{4}\right\rangle _{3}+\left\langle A_{3}B_{4}\right\rangle _{5}+\left\langle
A_{3}B_{4}\right\rangle _{7}\\
&  +\left\langle A_{4}B_{4}\right\rangle _{0}+\left\langle A_{4}%
B_{4}\right\rangle _{2}+\left\langle A_{4}B_{4}\right\rangle _{4}+\left\langle
A_{4}B_{4}\right\rangle _{6}+\left\langle A_{4}B_{4}\right\rangle _{8}.
\end{align}


\item $r=2$%
\begin{align}
&  AB=\sum_{0\leq m,n\leq4}\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\\
&  \left.  +\right.  \left\langle A_{0}B_{0}\right\rangle _{0}+\left\langle
A_{1}B_{1}\right\rangle _{0}+\left\langle A_{2}B_{2}\right\rangle
_{0}+\left\langle A_{3}B_{3}\right\rangle _{0}+\left\langle A_{4}%
B_{4}\right\rangle _{0}\\
&  +\left\langle A_{1}B_{0}\right\rangle _{1}+\left\langle A_{0}%
B_{1}\right\rangle _{1}+\left\langle A_{2}B_{1}\right\rangle _{1}+\left\langle
A_{1}B_{2}\right\rangle _{1}+\left\langle A_{3}B_{2}\right\rangle
_{1}+\left\langle A_{4}B_{3}\right\rangle _{1}+\left\langle A_{2}%
B_{3}\right\rangle _{1}+\left\langle A_{3}B_{4}\right\rangle _{1}\\
&  +\left\langle A_{2}B_{0}\right\rangle _{2}+\left\langle A_{1}%
B_{1}\right\rangle _{2}+\left\langle A_{3}B_{1}\right\rangle _{2}+\left\langle
A_{0}B_{2}\right\rangle _{2}+\left\langle A_{2}B_{2}\right\rangle
_{2}+\left\langle A_{1}B_{3}\right\rangle _{2}+\left\langle A_{3}%
B_{3}\right\rangle _{2}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{2}\right\rangle _{2}+\left\langle A_{2}B_{4}\right\rangle _{2}\\
&  +\left\langle A_{3}B_{0}\right\rangle _{3}+\left\langle A_{2}%
B_{1}\right\rangle _{3}+\left\langle A_{1}B_{2}\right\rangle _{3}+\left\langle
