_{3}+\left\langle A_{4}B_{1}\right\rangle _{3}+\left\langle A_{1}%
B_{4}\right\rangle _{3}+\left\langle A_{3}B_{4}\right\rangle _{3}+\left\langle
A_{2}B_{3}\right\rangle _{3}+\left\langle A_{4}B_{3}\right\rangle _{3}\\
&  +\left\langle A_{4}B_{0}\right\rangle _{4}+\left\langle A_{3}%
B_{1}\right\rangle _{4}+\left\langle A_{2}B_{2}\right\rangle _{4}+\left\langle
A_{1}B_{3}\right\rangle _{4}+\left\langle A_{3}B_{3}\right\rangle
_{4}+\left\langle A_{0}B_{4}\right\rangle _{4}+\left\langle A_{2}%
B_{4}\right\rangle _{4}+\left\langle A_{4}B_{2}\right\rangle _{4}+\left\langle
A_{4}B_{4}\right\rangle _{4}\\
&  +\left\langle A_{4}B_{1}\right\rangle _{5}+\left\langle A_{3}%
B_{2}\right\rangle _{5}+\left\langle A_{2}B_{3}\right\rangle _{5}+\left\langle
A_{4}B_{3}\right\rangle _{5}+\left\langle A_{1}B_{4}\right\rangle
_{5}+\left\langle A_{3}B_{4}\right\rangle _{5}\\
&  +\left\langle A_{4}B_{2}\right\rangle _{6}+\left\langle A_{3}%
B_{3}\right\rangle _{6}+\left\langle A_{2}B_{4}\right\rangle _{6}+\left\langle
A_{4}B_{4}\right\rangle _{6}\\
&  +\left\langle A_{4}B_{3}\right\rangle _{7}+\left\langle A_{3}%
B_{4}\right\rangle _{7}\\
&  +\left\langle A_{4}B_{4}\right\rangle _{8}.
\end{align}


\item
\begin{align}
A_{n}  &  =\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\alpha_{j_{1}\cdots j_{n}%
}x_{j_{1}}\wedge\cdots\wedge x_{j_{n}}=\sum_{1\leq j_{1}<\cdots<j_{n}\leq
2r}\alpha_{j_{1}\cdots j_{n}}x_{j_{1}}\wedge\cdots\wedge x_{j_{n}};\quad\\
B_{n}  &  =\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\beta_{j_{1}\cdots j_{n}%
}x_{j_{1}}\wedge\cdots\wedge x_{j_{n}}=\sum_{1\leq j_{1}<\cdots<j_{n}\leq
2r}\beta_{j_{1}\cdots j_{n}}x_{j_{1}}\wedge\cdots\wedge x_{j_{n}}\\
AB  &  =\sum_{0\leq m,n\leq4}\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\sum_{0\leq m,n\leq
4}\sum_{j=0}^{\min\left(  m,n\right)  }\sum_{\substack{0\leq j_{1}%
<\cdots<j_{m}\leq4\\0\leq k_{1}<\cdots<k_{n}\leq4}}\alpha_{j_{1}\cdots j_{m}%
}\beta_{k_{1}\cdots k_{n}}\left\langle x_{j_{1}}\cdots x_{j_{m}}x_{k_{1}%
}\cdots x_{k_{n}}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{align}


\item Clifford Multiplication
\begin{equation}
x_{j_{1}}x_{k_{1}}=\left\langle x_{j_{1}}x_{k_{1}}\right\rangle _{0}%
+\left\langle x_{j_{1}}x_{k_{1}}\right\rangle _{2}=\left(  \left.  x_{j_{1}%
}\right\vert x_{k_{1}}\right)  I_{\mathcal{A}}+x_{j_{1}}\wedge x_{k_{1}%
}=\delta_{j_{1}k_{1}}I_{\mathcal{A}}+x_{j_{1}}\wedge x_{k_{1}}.
\end{equation}


\item
\begin{align}
&  \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}}x_{k_{4}%
}\right)  =\left(  \left(  x_{j_{1}}x_{k_{1}}\right)  x_{k_{2}}x_{k_{3}%
}x_{k_{4}}-\left(  x_{j_{1}}x_{k_{2}}\right)  x_{k_{1}}x_{k_{3}}x_{k_{4}%
}+\left(  x_{j_{1}}x_{k_{3}}\right)  x_{k_{1}}x_{k_{2}}x_{k_{4}}-\left(
x_{j_{1}}x_{k_{4}}\right)  x_{k_{1}}x_{k_{2}}x_{k_{3}}\right) \\
&  =\left(  \delta_{j_{1}k_{1}}I_{\mathcal{A}}+x_{j_{1}}\wedge x_{k_{1}%
}\right)  x_{k_{2}}x_{k_{3}}x_{k_{4}}-\left(  \delta_{j_{1}k_{2}%
}I_{\mathcal{A}}+x_{j_{1}}\wedge x_{k_{2}}\right)  x_{k_{1}}x_{k_{3}}x_{k_{4}%
}\\
&  +\left.  \left(  \delta_{j_{1}k_{3}}I_{\mathcal{A}}+x_{j_{1}}\wedge
x_{k_{3}}\right)  x_{k_{1}}x_{k_{2}}x_{k_{4}}-\left(  \delta_{j_{1}k_{4}%
}I_{\mathcal{A}}+x_{j_{1}}\wedge x_{k_{4}}\right)  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}\right) \\
&  =\delta_{j_{1}k_{1}}x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}+x_{j_{1}%
}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}%
-\delta_{j_{1}k_{2}}x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}}-x_{j_{1}}\wedge
x_{k_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}}\\
&  +\delta_{j_{1}k_{3}}x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}+x_{j_{1}%
}\wedge x_{k_{3}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}%
-\delta_{j_{1}k_{4}}x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}-x_{j_{1}}\wedge
x_{k_{4}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}%
\end{align}
giving%
\begin{align}
\left(  x_{j_{1}}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}}x_{k_{4}}\right)
&  =\left(  x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{1}k_{1}%
}-x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{1}k_{2}}+x_{k_{1}}\wedge
x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{1}k_{3}}-x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{3}}\delta_{j_{1}k_{4}}\right) \\
&  +x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}.
\end{align}


\item
\begin{align*}
&  \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}%
}\right)  =\sum_{j=0}^{2}\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)
\left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{2+2j}\\
&  =\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots
x_{k_{4}}\right)  \right\rangle _{2}+\left\langle \left(  x_{j_{1}}x_{j_{2}%
}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle
_{4}+\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots
x_{k_{4}}\right)  \right\rangle _{6}%
\end{align*}


\item
\begin{align}
&  \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}x_{k_{4}}\right)  =x_{j_{1}}\left(  \overset{}{x_{k_{2}}\wedge x_{k_{3}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}-x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}%
}\delta_{j_{2}k_{2}}+x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}\delta
_{j_{2}k_{3}}}\right. \\
&  -\left.  \overset{}{x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\delta
_{j_{2}k_{4}}}\right)  +x_{j_{1}}\left(  x_{j_{2}}\wedge x_{k_{1}}\wedge
x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}\right)
\end{align}
which gives
\begin{align}
&  =x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}-x_{k_{2}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{3}}+x_{k_{2}}\wedge
x_{k_{3}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{k_{2}%
}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\\
&  -x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{1}}+x_{k_{1}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}}-x_{k_{1}}\wedge
x_{k_{3}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{k_{1}%
}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\\
&  +x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{1}}-x_{k_{1}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{2}}+x_{k_{1}}\wedge
x_{k_{2}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{k_{1}%
}\wedge x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\\
&  -x_{k_{2}}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{1}}+x_{k_{1}%
}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{2}}-x_{k_{1}}\wedge
x_{k_{2}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{3}}+\,x_{j_{1}}\wedge x_{k_{1}%
}\wedge x_{k_{2}}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\\
&  +x_{j_{1}}\left(  x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}%
}\wedge x_{k_{4}}\right)
\end{align}
Noting that
\begin{align}
&  x_{j_{1}}\left(  x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}%
}\wedge x_{k_{4}}\right)  =-\left(  x_{j_{2}}\wedge x_{k_{2}}\wedge x_{k_{3}%
}\wedge x_{k_{4}}\delta_{j_{1}k_{1}}-x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}%
}\wedge x_{k_{4}}\delta_{j_{1}k_{2}}\right. \\
&  \left.  +x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}%
\delta_{j_{1}k_{3}}-x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}%
}\delta_{j_{1}k_{4}}\right)  +x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{1}}\wedge
x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}%
\end{align}
one obtains
\begin{align}
&  \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}x_{k_{4}}\right)  =\\
&  x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}-x_{k_{2}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{3}}+x_{k_{2}}\wedge
x_{k_{3}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{k_{2}%
}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\\
&  -x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{1}}+x_{k_{1}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}}-x_{k_{1}}\wedge
x_{k_{3}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{k_{1}%
}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\\
&  +x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{1}}-x_{k_{1}%
}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{2}}+x_{k_{1}}\wedge
x_{k_{2}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{k_{1}%
}\wedge x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\\
&  -x_{k_{2}}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{1}}+x_{k_{1}%
}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{2}}-x_{k_{1}}\wedge
x_{k_{2}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{3}}+\,x_{j_{1}}\wedge x_{k_{1}%
}\wedge x_{k_{2}}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\\
&  -x_{j_{2}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta
_{j_{1}k_{1}}+x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}}%
\delta_{j_{1}k_{2}}\\
&  -x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}\delta
_{j_{1}k_{3}}+x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}%
\delta_{j_{1}k_{4}}+x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}%
}\wedge x_{k_{3}}\wedge x_{k_{4}}.
\end{align}


\item The second degree term is
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{2}\\
=  &  \left(  x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}%
}-x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{3}}+x_{k_{2}%
}\wedge x_{k_{3}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{4}}\right)  +\\
&  -\left(  x_{k_{3}}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{1}%
}+x_{k_{1}}\wedge x_{k_{4}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}}-x_{k_{1}%
}\wedge x_{k_{3}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{4}}\right) \\
&  +\left(  x_{k_{2}}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{1}%
}-x_{k_{1}}\wedge x_{k_{4}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{2}}+x_{k_{1}%
}\wedge x_{k_{2}}\delta_{j_{2}k_{3}}\delta_{j_{1}k_{4}}\right) \\
&  -\left(  x_{k_{2}}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{1}%
}+x_{k_{1}}\wedge x_{k_{3}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{2}}-x_{k_{1}%
}\wedge x_{k_{2}}\delta_{j_{2}k_{4}}\delta_{j_{1}k_{3}}\right)
\end{align}
which can be rearranged as
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{2}=\nonumber\\
&  \quad x_{k_{1}}\wedge x_{k_{2}}\,\left(  \delta_{j_{2}k_{4}}\delta
_{j_{1}k_{3}}-\delta_{j_{2}k_{3}}\delta_{j_{1}k_{4}}\right)  -x_{k_{1}}\wedge
x_{k_{3}}\left(  \delta_{j_{1}k_{4}}\delta_{j_{2}k_{2}}-\delta_{j_{1}k_{2}%
}\delta_{j_{2}k_{4}}\right) \\
&  +x_{k_{1}}\wedge x_{k_{4}}\left(  \delta_{j_{1}k_{3}}\delta_{j_{2}k_{2}%
}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}\right)  +x_{k_{2}}\wedge x_{k_{3}%
}\left(  \delta_{j_{1}k_{4}}\delta_{j_{2}k_{1}}-\delta_{j_{1}k_{1}}%
\delta_{j_{2}k_{4}}\right) \\
&  -x_{k_{2}}\wedge x_{k_{4}}\left(  \delta_{j_{1}k_{3}}\delta_{j_{2}k_{1}%
}-\delta_{j_{1}k_{1}}\delta_{j_{2}k_{3}}\right)  +x_{k_{3}}\wedge x_{k_{4}%
}\left(  \delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}}-\delta_{j_{1}k_{1}}%
\delta_{j_{2}k_{2}}\right)  .
\end{align}


\item Noting that metric matrix in the $r=2$ case is
\begin{gather}
\mathbf{\Delta}_{j_{1}j_{2}k_{1}k_{2}k_{3}k_{4}}=\left(
\begin{array}
[c]{cccccc}%
0 & 0 & \Delta_{j_{1}k_{1}} & \Delta_{j_{1}k_{2}} & \Delta_{j_{1}k_{3}} &
\Delta_{j_{1}k_{4}}\\
0 & 0 & \Delta_{j_{2}k_{1}} & \Delta_{j_{2}k_{2}} & \Delta_{j_{2}k_{3}} &
\Delta_{j_{2}k_{4}}\\
-\Delta_{j_{1}k_{1}} & -\Delta_{j_{2}k_{1}} & 0 & \Delta_{k_{1}k_{2}} &
\Delta_{k_{1}k_{3}} & \Delta_{k_{1}k_{4}}\\
-\Delta_{j_{1}k_{2}} & -\Delta_{j_{2}k_{2}} & -\Delta_{k_{1}k_{2}} & 0 &
\Delta_{k_{2}k_{3}} & \Delta_{k_{2}k_{4}}\\
-\Delta_{j_{1}k_{3}} & -\Delta_{j_{2}k_{3}} & -\Delta_{k_{1}k_{3}} &
-\Delta_{k_{2}k_{3}} & 0 & \Delta_{k_{3}k_{4}}\\
-\Delta_{j_{1}k_{4}} & -\Delta_{j_{2}k_{3}} & -\Delta_{k_{1}k_{4}} &
-\Delta_{k_{2}k_{4}} & -\Delta_{k_{3}k_{4}} & 0
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cccccc}%
0 & 0 & \Delta_{j_{1}k_{1}} & \Delta_{j_{1}k_{2}} & \Delta_{j_{1}k_{3}} &
\Delta_{j_{1}k_{4}}\\
0 & 0 & \Delta_{j_{2}k_{1}} & \Delta_{j_{2}k_{2}} & \Delta_{j_{2}k_{3}} &
\Delta_{j_{2}k_{4}}\\
-\Delta_{j_{1}k_{1}} & -\Delta_{j_{2}k_{1}} & 0 & 0 & 0 & 0\\
-\Delta_{j_{1}k_{2}} & -\Delta_{j_{2}k_{2}} & 0 & 0 & 0 & 0\\
-\Delta_{j_{1}k_{3}} & -\Delta_{j_{2}k_{3}} & 0 & 0 & 0 & 0\\
-\Delta_{j_{1}k_{4}} & -\Delta_{j_{2}k_{3}} & 0 & 0 & 0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{cccccc}%
0 & 0 & \delta_{j_{1}k_{1}} & \delta_{j_{1}k_{2}} & \delta_{j_{1}k_{3}} &
\delta_{j_{1}k_{4}}\\
0 & 0 & \delta_{j_{2}k_{1}} & \delta_{j_{2}k_{2}} & \delta_{j_{2}k_{3}} &
\delta_{j_{2}k_{4}}\\
-\delta_{j_{1}k_{1}} & -\delta_{j_{2}k_{1}} & 0 & 0 & 0 & 0\\
-\delta_{j_{1}k_{2}} & -\delta_{j_{2}k_{2}} & 0 & 0 & 0 & 0\\
-\delta_{j_{1}k_{3}} & -\delta_{j_{2}k_{3}} & 0 & 0 & 0 & 0\\
-\delta_{j_{1}k_{4}} & -\delta_{j_{2}k_{3}} & 0 & 0 & 0 & 0
\end{array}
\right)
\end{gather}
and
\begin{equation}
\operatorname*{Pf}\left(  \mathbf{\Delta}_{1234}\right)  =\Delta_{12}%
\Delta_{34}-\Delta_{13}\Delta_{24}+\Delta_{14}\Delta_{23}.
\end{equation}


\item This leads to the \emph{second degree} term $\left(  9\right)  $ being
recast as
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{2}\nonumber\\
&  =\operatorname*{Pf}\left(  \Delta_{k_{2}k_{3}k_{1}k_{4}}\right)  x_{j_{1}%
}\wedge x_{j_{2}}+\operatorname*{Pf}\left(  \Delta_{j_{2}k_{3}k_{2}j_{6}%
}\right)  x_{j_{1}}\wedge x_{k_{1}}+\operatorname*{Pf}\left(  \Delta
_{k_{1}k_{3}j_{2}k_{4}}\right)  x_{j_{1}}\wedge x_{k_{2}}+\operatorname*{Pf}%
\left(  \Delta_{j_{2}k_{1}k_{2}k_{4}}\right)  x_{j_{1}}\wedge x_{k_{3}}\\
&  -\operatorname*{Pf}\left(  \Delta_{j_{1}k_{3}k_{2}k_{4}}\right)  x_{j_{2}%
}\wedge x_{k_{1}}-\operatorname*{Pf}\left(  \Delta_{k_{1}k_{3}j_{1}k_{2}%
}\right)  x_{j_{2}}\wedge x_{k_{2}}-\operatorname*{Pf}\left(  \Delta
_{j_{1}k_{1}k_{2}k_{4}}\right)  x_{j_{2}}\wedge x_{k_{3}}+\operatorname*{Pf}%
\left(  \Delta_{j_{2}k_{1}k_{2}k_{3}}\right)  x_{j_{1}}\wedge x_{k_{4}%
}\nonumber\\
&  -\operatorname*{Pf}\left(  \Delta_{j_{1}k_{1}k_{2}k_{3}}\right)  x_{j_{2}%
}\wedge x_{k_{4}}+\operatorname*{Pf}\left(  \Delta_{j_{2}j_{1}k_{3}k_{4}%
}\right)  x_{k_{1}}\wedge x_{k_{2}}-\operatorname*{Pf}\left(  \Delta
_{j_{1}j_{2}k_{2}k_{4}}\right)  x_{k_{1}}\wedge x_{k_{3}}\\
&  +\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}j_{3}j_{6}}\right)  x_{k_{2}%
}\wedge x_{k_{3}}+\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{1}k_{2}%
}\right)  x_{k_{3}}\wedge x_{k_{4}}-\operatorname*{Pf}\left(  \Delta
_{j_{1}j_{2}j_{3}j_{5}}\right)  x_{k_{2}}\wedge x_{k_{4}}+\operatorname*{Pf}%
\left(  \Delta_{j_{1}j_{2}j_{4}j_{5}}\right)  x_{k_{1}}\wedge x_{k_{4}}%
\end{align}
giving
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{2}=\operatorname*{Pf}\left(
\Delta_{j_{2}j_{1}k_{3}k_{4}}\right)  x_{k_{1}}\wedge x_{k_{2}}%
-\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{2}k_{4}}\right)  x_{k_{1}%
}\wedge x_{k_{3}}+\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{2}k_{3}%
}\right)  x_{k_{1}}\wedge x_{k_{4}}\nonumber\\
&  +\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{1}k_{4}}\right)  x_{k_{2}%
}\wedge x_{k_{3}}-\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{1}k_{3}%
}\right)  x_{k_{2}}\wedge x_{k_{4}}+\operatorname*{Pf}\left(  \Delta
_{j_{1}j_{2}k_{1}k_{2}}\right)  x_{k_{3}}\wedge x_{k_{4}}%
\end{align}
and thus
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{2}=\nonumber\\
&  \quad x_{k_{1}}\wedge x_{k_{2}}\,\left(  \delta_{j_{2}k_{4}}\delta
_{j_{1}k_{3}}-\delta_{j_{2}k_{3}}\delta_{j_{1}k_{4}}\right)  -x_{k_{1}}\wedge
x_{k_{3}}\left(  \delta_{j_{1}k_{4}}\delta_{j_{2}k_{2}}-\delta_{j_{1}k_{2}%
}\delta_{j_{2}k_{4}}\right) \\
&  +x_{k_{1}}\wedge x_{k_{4}}\left(  \delta_{j_{1}k_{3}}\delta_{j_{2}k_{2}%
}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}\right)  +x_{k_{2}}\wedge x_{k_{3}%
}\left(  \delta_{j_{1}k_{4}}\delta_{j_{2}k_{1}}-\delta_{j_{1}k_{1}}%
\delta_{j_{2}k_{4}}\right) \\
&  -x_{k_{2}}\wedge x_{k_{4}}\left(  \delta_{j_{1}k_{3}}\delta_{j_{2}k_{1}%
}-\delta_{j_{1}k_{1}}\delta_{j_{2}k_{3}}\right)  +x_{k_{3}}\wedge x_{k_{4}%
}\left(  \delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}}-\delta_{j_{1}k_{1}}%
\delta_{j_{2}k_{2}}\right)  .
\end{align}


\item The \emph{fourth degree} term calculated from pfaffians is
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{4}=\nonumber\\
&  \quad-\delta_{j_{1}k_{1}}x_{j_{2}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge
x_{k_{4}}+\delta_{j_{1}k_{2}}x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge
x_{k_{4}}\\
&  -\delta_{j_{1}k_{3}}x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{4}}+\delta_{j_{1}k_{4}}x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{3}}\nonumber\\
&  +\delta_{j_{2}k_{1}}x_{j_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge
x_{k_{4}}-\delta_{j_{2}k_{2}}x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge
x_{k_{4}}\\
&  +\delta_{j_{2}k_{3}}x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{4}}-\delta_{j_{2}k_{4}}x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{3}}.
\end{align}


\item The fourth degree term is
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{4}=\\
&  \,x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\delta
_{j_{2}k_{4}}+x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}%
\delta_{j_{1}k_{4}}\,\\
&  -\,x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}\delta
_{j_{1}k_{3}}+\,x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}%
}\delta_{j_{2}k_{3}}\\
&  +x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta
_{j_{2}k_{2}}+\,\,x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}%
}\delta_{j_{1}k_{2}}\\
&  -x_{j_{2}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta
_{j_{1}k_{1}}+x_{j_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}%
\delta_{j_{2}k_{1}},
\end{align}
which can be rearranged as%
\begin{align}
&  \left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{4}=\\
&  \,x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\delta
_{j_{2}k_{4}}+x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}%
\delta_{j_{1}k_{4}}\,\\
&  -\,x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}}\delta
_{j_{1}k_{3}}+\,x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{4}%
}\delta_{j_{2}k_{3}}\\
&  +x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta
_{j_{2}k_{2}}+\,\,x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge x_{k_{4}%
}\delta_{j_{1}k_{2}}\\
&  -x_{j_{2}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}\delta
_{j_{1}k_{1}}+x_{j_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}%
\delta_{j_{2}k_{1}}.
\end{align}


\item The sixth degree term is%
\begin{equation}
\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{6}=x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}}.
\end{equation}


\item The sixth order products, where
\begin{equation}
1\leq j_{1}<j_{2}\leq4;1\leq k_{1}<\cdots<k_{4}\leq4
\end{equation}
are given by
\begin{align}
&  x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}x_{k_{3}}x_{k_{4}}=x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}%
}\nonumber\\
&  +\Delta_{j_{1}j_{2}}x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge
x_{k_{4}}-\Delta_{j_{1}k_{1}}x_{j_{2}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge
x_{k_{4}}+\Delta_{j_{1}k_{2}}x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge
x_{k_{4}}\nonumber\\
&  -\Delta_{j_{1}k_{3}}x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{4}}+\Delta_{j_{1}k_{4}}x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{3}}+\Delta_{j_{2}k_{1}}x_{j_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge
x_{k_{4}}\nonumber\\
&  -\Delta_{j_{2}k_{2}}x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{3}}\wedge
x_{k_{4}}+\Delta_{j_{2}k_{3}}x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{4}}-\Delta_{j_{2}k_{4}}x_{j_{1}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge
x_{k_{3}}\nonumber\\
&  +\Delta_{k_{1}k_{2}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{3}}\wedge
x_{k_{4}}-\Delta_{k_{1}k_{3}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{2}}\wedge
x_{k_{4}}+\Delta_{k_{1}k_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{2}}\wedge
x_{k_{3}}\nonumber\\
&  +\Delta_{k_{2}k_{3}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{1}}\wedge
x_{k_{4}}-\Delta_{k_{2}k_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{1}}\wedge
x_{k_{3}}+\Delta_{k_{3}k_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{k_{1}}\wedge
x_{k_{2}}\nonumber\\
&  +\operatorname*{Pf}\left(  \Delta_{k_{2}k_{3}k_{1}k_{4}}\right)  x_{j_{1}%
}\wedge x_{j_{2}}+\operatorname*{Pf}\left(  \Delta_{j_{2}k_{3}k_{2}k_{4}%
}\right)  x_{j_{1}}\wedge x_{k_{1}}+\operatorname*{Pf}\left(  \Delta
_{k_{1}k_{3}j_{2}k_{4}}\right)  x_{j_{1}}\wedge x_{k_{2}}+\operatorname*{Pf}%
\left(  \Delta_{j_{2}k_{1}k_{2}k_{4}}\right)  x_{j_{1}}\wedge x_{k_{3}%
}\nonumber\\
&  -\operatorname*{Pf}\left(  \Delta_{j_{1}k_{3}k_{2}k_{4}}\right)  x_{j_{2}%
}\wedge x_{k_{1}}-\operatorname*{Pf}\left(  \Delta_{k_{1}k_{3}j_{1}k_{4}%
}\right)  x_{j_{2}}\wedge x_{k_{2}}-\operatorname*{Pf}\left(  \Delta
_{j_{1}k_{1}k_{2}k_{4}}\right)  x_{j_{2}}\wedge x_{k_{3}}+\operatorname*{Pf}%
\left(  \Delta_{j_{2}j_{1}k_{4}}\right)  x_{k_{1}}\wedge x_{k_{2}}\nonumber\\
&  -\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{2}k_{4}}\right)  x_{k_{1}%
}\wedge x_{k_{3}}+\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{1}k_{4}%
}\right)  x_{k_{2}}\wedge x_{k_{3}}+\operatorname*{Pf}\left(  \Delta
_{j_{1}j_{2}k_{1}k_{2}}\right)  x_{k_{3}}\wedge x_{k_{4}}+\operatorname*{Pf}%
\left(  \Delta_{j_{2}k_{1}k_{2}k_{3}}\right)  x_{j_{1}}\wedge x_{k_{4}%
}\nonumber\\
&  -\operatorname*{Pf}\left(  \Delta_{j_{1}k_{1}k_{2}k_{3}}\right)  x_{j_{2}%
}\wedge x_{k_{4}}-\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{1}k_{3}%
}\right)  x_{k_{2}}\wedge x_{k_{4}}+\operatorname*{Pf}\left(  \Delta
_{j_{1}j_{2}k_{2}k_{3}}\right)  x_{k_{1}}\wedge x_{k_{4}}\nonumber\\
&  +\operatorname*{Pf}\left(  \Delta_{j_{1}j_{2}k_{1}k_{2}k_{3}k_{4}}\right)
I_{\mathcal{F}},
\end{align}
which can also be expressed as
\begin{align}
x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}x_{k_{3}}x_{k_{4}}  &  =x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{k_{1}}\wedge x_{k_{2}}\wedge x_{k_{3}}\wedge x_{k_{4}%
}\nonumber\\
&  +\sum_{\sigma\in S_{6}/\left(  S_{2}\times S_{4}\right)  }\pi\left(
\sigma\right)  \Delta_{j_{\sigma\left(  1\right)  }j_{\sigma\left(  2\right)
}}x_{k_{\sigma\left(  1\right)  }}\wedge x_{k_{\sigma\left(  2\right)  }%
}\wedge x_{k_{\sigma\left(  3\right)  }}\wedge x_{k_{\sigma\left(  4\right)
}}\nonumber\\
&  \qquad\qquad\qquad\qquad+\sum_{\sigma\in S_{6}/\left(  S_{4}\times
S_{2}\right)  }\pi\left(  \sigma\right)  \operatorname*{Pf}\left(
\mathbf{\Delta}_{j_{\sigma\left(  1\right)  }j_{\sigma\left(  2\right)
}k_{\sigma\left(  3\right)  }k_{\sigma\left(  4\right)  }}\right)
x_{k_{\sigma\left(  5\right)  }}\wedge x_{k_{\sigma\left(  6\right)  }%
}+\operatorname*{Pf}\left(  \mathbf{\Delta}_{j_{1}j_{2}k_{1}k_{2}k_{3}k_{4}%
}\right)  I_{\mathcal{F}}.
\end{align}


\begin{enumerate}
\item The general expression for Clifford products is
\begin{align}
&  \left(  x_{j_{1}}\cdots x_{j_{m}}\right)  \left(  x_{k_{1}}\cdots x_{k_{n}%
}\right)  =\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle \left(  x_{j_{1}%
}\cdots x_{j_{m}}\right)  \left(  x_{k_{1}}\cdots x_{k_{n}}\right)
\right\rangle _{\left\vert m-n\right\vert +2j}\\
&  =\left\langle \left(  x_{j_{1}}\cdots x_{j_{m}}\right)  \left(  x_{k_{1}%
}\cdots x_{k_{n}}\right)  \right\rangle _{\left\vert m-n\right\vert
}+\left\langle \left(  x_{j_{1}}\cdots x_{j_{m}}\right)  \left(  x_{k_{1}%
}\cdots x_{k_{n}}\right)  \right\rangle _{\left\vert m-n\right\vert
+2}+\left\langle \left(  x_{j_{1}}\cdots x_{j_{m}}\right)  \left(  x_{k_{1}%
}\cdots x_{k_{n}}\right)  \right\rangle _{\left\vert m-n\right\vert +4}+\\
&  \cdots+\left\langle \left(  x_{j_{1}}\cdots x_{j_{m}}\right)  \left(
x_{k_{1}}\cdots x_{k_{n}}\right)  \right\rangle _{m+n}.
\end{align}


\item for $r=2$%
\begin{equation}
\left(  m,n\right)  =\left(  0,0\right)  ,\left(  0,1\right)  ,\left(
0,2\right)  ,\left(  0,3\right)  ,\left(  0,4\right)  ,\left(  1,1\right)
,\left(  1,2\right)  ,\left(  1,3\right)  ,\left(  1,4\right)  ,\left(
2,2\right)  ,\left(  2,3\right)  ,\left(  2,4\right)  ,\left(  3,3\right)
,\left(  3,4\right)  ,\left(  4,4\right)  .
\end{equation}


\item $1\leq j_{1}<\cdots<j_{4}\leq4;1\leq k_{1}<\cdots<k_{4}\leq4$%
\begin{align}
&  \left(  x_{j_{1}}\cdots x_{j_{4}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}%
}\right)  =\sum_{j=0}^{4}\left\langle \left(  x_{j_{1}}\cdots x_{j_{4}%
}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle
_{2j}=\left\langle \left(  x_{j_{1}}\cdots x_{j_{4}}\right)  \left(  x_{k_{1}%
}\cdots x_{k_{4}}\right)  \right\rangle _{0}+\\
&  \qquad\left\langle \left(  x_{j_{1}}\cdots x_{j_{4}}\right)  \left(
x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{2}+\left\langle \left(
x_{j_{1}}\cdots x_{j_{4}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)
\right\rangle _{4}+\left\langle \left(  x_{j_{1}}\cdots x_{j_{4}}\right)
\left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{6}+\left\langle
\left(  x_{j_{1}}\cdots x_{j_{4}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}%
}\right)  \right\rangle _{8}.
\end{align}


\item $1\leq j_{1}<\cdots<j_{3}\leq4;1\leq k_{1}<\cdots<k_{4}\leq4$%
\begin{align*}
&  \left(  x_{j_{1}}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}%
}\right)  =\sum_{j=0}^{3}\left\langle \left(  x_{j_{1}}\cdots x_{j_{3}%
}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle
_{1+2j}=\left\langle \left(  x_{j_{1}}\cdots x_{j_{3}}\right)  \left(
x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{1}+\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\left\langle \left(  x_{j_{1}%
}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)
\right\rangle _{3}+\left\langle \left(  x_{j_{1}}\cdots x_{j_{3}}\right)
\left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{5}+\left\langle
\left(  x_{j_{1}}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}%
}\right)  \right\rangle _{7}\\
&  \left(  x_{j_{1}}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}%
}\right)  =\sum_{j=0}^{3}\left\langle \left(  x_{j_{1}}\cdots x_{j_{3}%
}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}}\right)  \right\rangle
_{2j}=\left\langle \left(  x_{j_{1}}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}%
}\cdots x_{k_{3}}\right)  \right\rangle _{0}+\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\left\langle \left(  x_{j_{1}%
}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}}\right)
\right\rangle _{2}+\left\langle \left(  x_{j_{1}}\cdots x_{j_{3}}\right)
\left(  x_{k_{1}}\cdots x_{k_{3}}\right)  \right\rangle _{4}+\left\langle
\left(  x_{j_{1}}\cdots x_{j_{3}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}%
}\right)  \right\rangle _{6}.
\end{align*}


\item $1\leq j_{1}<j_{2}\leq4;1\leq k_{1}<\cdots<k_{4}\leq4$%
\begin{align*}
&  \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}%
}\right)  =\sum_{j=0}^{2}\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)
\left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{2+2j}=\left\langle
\left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)
\right\rangle _{2}+\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(
x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{4}+\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\left\langle \left(  x_{j_{1}}x_{j_{2}%
}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{4}\\
&  \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}%
}\right)  =\sum_{j=0}^{2}\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)
\left(  x_{k_{1}}\cdots x_{k_{3}}\right)  \right\rangle _{2j}=\left\langle
\left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}}\right)
\right\rangle _{0}+\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(
x_{k_{1}}\cdots x_{k_{3}}\right)  \right\rangle _{2}+\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\left\langle \left(  x_{j_{1}}x_{j_{2}%
}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}}\right)  \right\rangle _{6}\\
&  \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)
=\sum_{j=0}^{2}\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(
x_{k_{1}}x_{k_{2}}\right)  \right\rangle _{2j}=\left\langle \left(  x_{j_{1}%
}x_{j_{2}}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)  \right\rangle
_{0}+\left\langle \left(  x_{j_{1}}x_{j_{2}}\right)  \left(  x_{k_{1}}%
x_{k_{2}}\right)  \right\rangle _{2}+\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\left\langle \left(  x_{j_{1}}x_{j_{2}%
}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)  \right\rangle _{4}.
\end{align*}


\item $1\leq j_{1}\leq4;1\leq k_{1}<\cdots<k_{4}\leq4$%
\begin{align*}
&  \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)
=\sum_{j=0}^{1}\left\langle \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\cdots
x_{k_{4}}\right)  \right\rangle _{3+2j}=\left\langle \left(  x_{j_{1}}\right)
\left(  x_{k_{1}}\cdots x_{k_{4}}\right)  \right\rangle _{3}+\left\langle
\left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\cdots x_{k_{4}}\right)
\right\rangle _{5}\\
&  \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}}\right)
=\sum_{j=0}^{1}\left\langle \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\cdots
x_{k_{3}}\right)  \right\rangle _{2+2j}=\left\langle \left(  x_{j_{1}}\right)
\left(  x_{k_{1}}\cdots x_{k_{3}}\right)  \right\rangle _{2}+\left\langle
\left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\cdots x_{k_{3}}\right)
\right\rangle _{4}\\
&  \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)  =\sum
_{j=0}^{1}\left\langle \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}x_{k_{2}%
}\right)  \right\rangle _{1+2j}=\left\langle \left(  x_{j_{1}}\right)  \left(
x_{k_{1}}x_{k_{2}}\right)  \right\rangle _{1}+\left\langle \left(  x_{j_{1}%
}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)  \right\rangle _{3}\\
&  \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\right)  =\sum_{j=0}%
^{1}\left\langle \left(  x_{j_{1}}\right)  \left(  x_{k_{1}}\right)
\right\rangle _{2j}=\left\langle \left(  x_{j_{1}}\right)  \left(  x_{k_{1}%
}\right)  \right\rangle _{0}+\left\langle \left(  x_{j_{1}}\right)  \left(
x_{k_{1}}\right)  \right\rangle _{2}.
\end{align*}


\item $j_{1}=0;1\leq k_{1}<\cdots<k_{4}\leq4:$%
\begin{equation}
I_{\mathcal{A}}\left(  x_{k_{1}}\cdots x_{k_{n}}\right)  =\left\langle \left(
x_{k_{1}}\cdots x_{k_{n}}\right)  \right\rangle _{n}=x_{k_{1}}\cdots x_{k_{n}%
};0\leq n\leq4.
\end{equation}


\item $\left(  m,n\right)  =\left(  1,1\right)  ,\left(  1,2\right)  ,\left(
1,3\right)  ,\left(  1,4\right)  :$%
\begin{align}
&  \left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}\right)  \right\rangle
_{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}\right)  \right\rangle
_{0}=x_{1}x_{1}\\
\left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}\right)  \right\rangle
_{2}=x_{1}x_{2}\\
\left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}\right)  \right\rangle
_{2}=x_{1}x_{3}\\
\left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}\right)  \right\rangle
_{2}=x_{1}x_{4}%
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
\left\langle I_{\mathcal{A}}\right\rangle \\
x_{1}x_{2}\\
x_{1}x_{3}\\
x_{1}x_{4}%
\end{array}
\right.  =\delta_{1k_{1}}I_{\mathcal{A}}+\left(  1-\delta_{1k_{1}}\right)
\left\langle x_{1}x_{k_{1}}\right\rangle \\
&  \left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)
\right\rangle _{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}\right)  \right\rangle
_{1}=\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{3}\right)  \right\rangle
_{1}=\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{4}\right)  \right\rangle
_{1}=\\
\left\langle \left(  x_{1}\right)  \left(  x_{2}x_{3}\right)  \right\rangle
_{3}=\\
\left\langle \left(  x_{1}\right)  \left(  x_{2}x_{4}\right)  \right\rangle
_{3}=\\
\left\langle \left(  x_{1}\right)  \left(  x_{3}x_{4}\right)  \right\rangle
_{3}=
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
x_{2}\\
x_{3}\\
x_{4}\\
x_{1}x_{2}x_{3}\\
x_{1}x_{2}x_{4}\\
x_{1}x_{3}x_{4}%
\end{array}
\right.  =\left(  1-\delta_{1k_{1}}\right)  \left\langle x_{k_{1}%
}\right\rangle +\left(  1-\delta_{1k_{2}}\right)  \left\langle x_{k_{2}%
}\right\rangle \\
&  \left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}\right)  \right\rangle _{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}x_{3}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}x_{4}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{3}x_{4}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}\right)  \left(  x_{2}x_{3}x_{4}\right)
\right\rangle _{4}%
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
x_{2}x_{3}\\
x_{2}x_{4}\\
x_{3}x_{4}\\
x_{1}x_{2}x_{3}x_{4}%
\end{array}
\right. \\
&  =\left(  1-\delta_{1k_{1}}\delta_{1k_{2}}\right)  \left\langle x_{k_{1}%
}x_{k_{2}}\right\rangle +\left(  1-\delta_{1k_{1}}\delta_{1k_{3}}\right)
\left\langle x_{k_{1}}x_{k_{3}}\right\rangle +\left(  1-\delta_{1k_{2}}%
\delta_{1k_{3}}\right)  \left\langle x_{k_{1}}x_{k_{2}}\right\rangle
+\left\langle x_{1}x_{2}x_{3}x_{4}\right\rangle \\
&  \left\langle \left(  x_{1}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}x_{k_{4}}\right)  \right\rangle _{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)
\right\rangle _{3}\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)
\right\rangle _{3}\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)
\right\rangle _{3}\\
\left\langle \left(  x_{1}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)
\right\rangle _{3}%
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
x_{2}x_{3}x_{4}\\
x_{2}x_{3}x_{4}\\
x_{2}x_{3}x_{4}\\
x_{2}x_{3}x_{4}%
\end{array}
\right. \\
&  =\left(  1-\delta_{1k_{1}}\delta_{1k_{2}}\delta_{1k_{3}}\right)
\left\langle x_{k_{1}}x_{k_{2}}x_{k_{3}}\right\rangle +\left(  1-\delta
_{1k_{1}}\delta_{1k_{2}}\delta_{1k_{4}}\right)  \left\langle x_{k_{1}}%
x_{k_{2}}x_{k_{4}}\right\rangle +\left(  1-\delta_{1k_{2}}\delta_{1k_{3}%
}\delta_{1k_{4}}\right)  \left\langle x_{k_{2}}x_{k_{3}}x_{k_{4}}\right\rangle
.
\end{align}


\item $\left(  2,2\right)  ,\left(  2,3\right)  ,\left(  2,4\right)  :$%
\begin{align}
&  \left\langle \left(  x_{1}x_{2}\right)  \left(  x_{k_{1}}x_{k_{2}}\right)
\right\rangle _{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{1}x_{2}\right)
\right\rangle _{0}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{1}x_{3}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{1}x_{4}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{2}x_{3}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{2}x_{4}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{3}x_{4}\right)
\right\rangle _{4}%
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
-I_{\mathcal{A}}\\
-x_{2}x_{3}\\
-x_{2}x_{4}\\
x_{1}x_{3}\\
x_{1}x_{4}\\
x_{1}x_{2}x_{3}x_{4}%
\end{array}
\right. \\
&  =\delta_{1k_{1}}\delta_{2k_{2}}\left\langle I_{\mathcal{A}}\right\rangle
+\left(  1+\delta_{1k_{1}}-\delta_{2k_{2}}\right)  \left\langle x_{k_{1}%
}x_{k_{2}}\right\rangle +\left(  1-\delta_{1k_{1}}\delta_{2k_{3}}\right)
\left\langle x_{1}x_{2}x_{3}x_{4}\right\rangle \\
&  \left\langle \left(  x_{1}x_{2}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}\right)  \right\rangle _{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{1}x_{2}x_{3}\right)
\right\rangle _{1}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{1}x_{2}x_{4}\right)
\right\rangle _{1}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{1}x_{3}x_{4}\right)
\right\rangle _{3}\\
\left\langle \left(  x_{1}x_{2}\right)  \left(  x_{2}x_{3}x_{4}\right)
\right\rangle _{3}%
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
-x_{3}\\
-x_{4}\\
-x_{2}x_{3}x_{4}\\
x_{1}x_{3}x_{4}%
\end{array}
\right. \\
&  =\\
&  \left\langle \left(  x_{1}x_{2}\right)  \left(  x_{k_{1}}x_{k_{2}}x_{k_{3}%
}x_{k_{4}}\right)  \right\rangle _{p}=\left\{  \left\langle \left(  x_{1}%
x_{2}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)  \right\rangle _{2}\right.
=-x_{3}x_{4}.
\end{align}


\item $\left(  3,3\right)  ,\left(  3,4\right)  $%
\begin{align}
&  \left\langle \left(  x_{1}x_{2}x_{3}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}\right)  \right\rangle _{p}=\left\{
\begin{array}
[c]{c}%
\left\langle \left(  x_{1}x_{2}x_{3}\right)  \left(  x_{1}x_{2}x_{3}\right)
\right\rangle _{0}\\
\left\langle \left(  x_{1}x_{2}x_{3}\right)  \left(  x_{1}x_{2}x_{4}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}x_{2}x_{3}\right)  \left(  x_{1}x_{3}x_{4}\right)
\right\rangle _{2}\\
\left\langle \left(  x_{1}x_{2}x_{3}\right)  \left(  x_{2}x_{3}x_{4}\right)
\right\rangle _{2}%
\end{array}
\right.  =\left\{
\begin{array}
[c]{c}%
-I_{\mathcal{A}}\\
x_{3}x_{4}\\
x_{2}x_{4}\\
-x_{1}x_{4}%
\end{array}
\right. \\
&  \left\langle \left(  x_{1}x_{2}x_{3}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{p}=\left\{  \left\langle \left(
x_{1}x_{2}x_{3}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)  \right\rangle
_{1}\right.  =-x_{4}.
\end{align}


\item $\left(  4,4\right)  $%
\[
\left\langle \left(  x_{1}x_{2}x_{3}x_{4}\right)  \left(  x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{k_{4}}\right)  \right\rangle _{p}=\left\{  \left\langle \left(
x_{1}x_{2}x_{3}x_{4}\right)  \left(  x_{1}x_{2}x_{3}x_{4}\right)
\right\rangle _{0}\right.  =I_{\mathcal{A}}.
\]

\end{enumerate}
\end{enumerate}
\end{example}
\end{remark}

\begin{remark}
As $\mathcal{A}$ is an algebra it is a vector space.
\end{remark}

\begin{definition}
A \emph{Banach space norm} $\left\Vert {}\right\Vert _{\mathcal{H}%
_{\mathcal{A}}}$ in $\mathcal{A}$ can be defined as
\begin{align}
\left\Vert A\right\Vert _{\mathcal{H}_{\mathcal{A}}}^{2}  &  =\left\langle
A^{\dagger}A\right\rangle _{0}=\sum_{0\leq n\leq2r}\left\langle A_{n}%
^{\dagger}A_{n}\right\rangle _{0}=\sum_{0\leq n\leq2r}\left\Vert
A_{n}^{\dagger}A_{n}\right\Vert _{\mathcal{H}_{\mathcal{A}}}^{2}\\
&  =\left\langle A_{0}^{\dagger}A_{0}\right\rangle _{0}+\left\langle
A_{1}^{\dagger}A_{1}\right\rangle _{0}+\left\langle A_{2}^{\dagger}%
A_{2}\right\rangle _{0}+\left\langle A_{3}^{\dagger}A_{3}\right\rangle
_{0}+\left\langle A_{4}^{\dagger}A_{4}\right\rangle _{0}+\cdots+\left\langle
A_{2r}^{\dagger}A_{2r}\right\rangle _{0}.
\end{align}

\end{definition}

\begin{definition}
This norm produces a \emph{Banach space }$\mathcal{H}_{\mathcal{A}}$ which is
closed wrt $\left\Vert A\right\Vert _{\mathcal{H}_{\mathcal{A}}}.$
\end{definition}

\begin{definition}
A \emph{Hermitian} inner product $\left\langle \left.  {}\right\vert
\right\rangle _{\mathcal{H}_{\mathcal{A}}}$ in $\mathcal{A}$ can be defined
as
\begin{equation}
\left\langle \left.  A\right\vert B\right\rangle _{\mathcal{H}_{\mathcal{A}}%
}=\left\langle A^{\dagger}B\right\rangle _{0}=\left\langle A_{0}^{\dagger
}B_{0}\right\rangle _{0}+\left\langle A_{1}^{\dagger}B_{1}\right\rangle
_{0}+\left\langle A_{2}^{\dagger}B_{2}\right\rangle _{0}+\left\langle
A_{3}^{\dagger}B_{3}\right\rangle _{0}+\left\langle A_{4}^{\dagger}%
B_{4}\right\rangle _{0}+\cdots+\left\langle A_{2r}^{\dagger}B_{2r}%
\right\rangle _{0},
\end{equation}
or which makes $\mathcal{H}_{\mathcal{A}}$ a \emph{separable} Hilbert space.
\end{definition}

\begin{lemma}
The inner product $\left\langle \left.  {}\right\vert \right\rangle
_{\mathcal{H}_{\mathcal{A}}}$ in $\mathcal{A}$ is faithful i.e.
\begin{equation}
\left\langle \left.  A\right\vert A\right\rangle _{\mathcal{H}_{\mathcal{A}}%
}=0\Leftrightarrow A=0.
\end{equation}

\end{lemma}

\begin{remark}%
\begin{equation}
\left\langle \left.  A\right\vert A\right\rangle _{\mathcal{H}_{\mathcal{A}}%
}=\left\Vert A\right\Vert _{\mathcal{H}_{\mathcal{A}}}^{2}.
\end{equation}

\end{remark}

\begin{remark}
The space of bounded operators $\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}%
}\right)  $ is given by
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}}\right)  =\left\{  \left.
\overset{}{\mathfrak{X}}\right\vert \sup\limits_{\left\Vert A\right\Vert
_{\mathcal{H}_{\mathcal{A}}}=1}\left\{  \left(  \left\langle \left.
A\right\vert \mathfrak{X}^{\dagger}\mathfrak{X}A\right\rangle _{\mathcal{H}%
_{\mathcal{A}}}\right)  ^{\frac{1}{2}}\right\}  <\infty\right\}  =\left\{
\left.  \overset{}{\mathfrak{X}}\right\vert \sup\limits_{\left\Vert
A\right\Vert _{\mathcal{H}_{\mathcal{A}}}=1}\left\{  \left\Vert \mathfrak{X}%
A\right\Vert _{\mathcal{H}_{\mathcal{A}}}^{2}\right\}  <\infty\right\}  ,
\end{equation}
where
\begin{equation}
\mathfrak{X:}\mathcal{A\rightarrow A}.
\end{equation}

\end{remark}

\begin{lemma}
The star operation "$\dagger"$ in $\mathcal{A}$ is the adjoint operation
"$\dagger"$ defined by the inner product $\left\langle \left.  {}\right\vert
\right\rangle _{\mathcal{H}_{\mathcal{A}}},$ where%
\begin{equation}
\left\langle \left.  \mathfrak{X}^{\dagger}B\right\vert A\right\rangle
_{\mathcal{H}_{\mathcal{A}}}=\left\langle \left.  B\right\vert \mathfrak{X}%
A\right\rangle _{\mathcal{H}_{\mathcal{A}}}\,\forall A\in\mathcal{H}%
_{\mathcal{A}},\,B\in\mathcal{H}_{\mathcal{A}}.
\end{equation}

\end{lemma}

\begin{definition}
A $c^{\ast}$-algebra norm $\left\Vert {}\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{A}}\right)  }$ in $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{A}}\right)  $ is defined by
\begin{gather}
\left\Vert \mathfrak{X}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{A}}\right)  }=\sup\limits_{\mathfrak{X}\in\mathcal{B}\left(
\mathcal{H}_{\mathcal{A}}\right)  ,\left\Vert A\right\Vert _{\mathcal{H}%
_{\mathcal{A}}}^{2}=1}\left\{  \left\Vert \mathfrak{X}\left(  A\right)
\right\Vert _{\mathcal{H}_{\mathcal{A}}}\right\}  =\sup\limits_{\mathfrak{X}%
\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}}\right)  ,\left\Vert
A\right\Vert _{\mathcal{H}_{\mathcal{A}}}^{2}=1}\left\{  \left(  \left\langle
\mathfrak{X}\left(  A\right)  ^{\dagger}\mathfrak{X}\left(  A\right)
\right\rangle _{0}\right)  ^{\frac{1}{2}}\right\} \\
=\sup\limits_{\mathfrak{X}\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}%
}\right)  ,\left\Vert A\right\Vert _{\mathcal{H}_{\mathcal{A}}}^{2}=1}\left\{
\left\langle \left.  \mathfrak{X}\left(  A\right)  \right\vert \mathfrak{X}%
\left(  A\right)  \right\rangle ^{\frac{1}{2}}\right\}  .
\end{gather}

\end{definition}

\begin{remark}
\emph{The }$c^{\ast}$\emph{-algebra }$B\left(  \mathcal{H}_{\mathcal{A}%
}\right)  $\emph{ may not be separable wrt the norm }$\left\Vert {}\right\Vert
_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}}\right)  }$\emph{ topology, but
in general it is wrt the strong operator topology induced by }$H_{\mathcal{A}%
}.$
\end{remark}

\begin{lemma}
The $c^{\ast}$-algebra norm $\left\Vert {}\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{A}}\right)  }$ is faithful i.e.
\begin{equation}
\left\Vert \mathfrak{X}\right\Vert _{\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{A}}\right)  }=0\Leftrightarrow\mathfrak{X}=0.
\end{equation}

\end{lemma}

\begin{lemma}
$\left\Vert {}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}%
}\right)  }$ is a $c^{\ast}$-algebra norm i.e.
\begin{equation}
\left\Vert \mathfrak{X}^{\dagger}\mathfrak{X}\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{A}}\right)  }=\left\Vert \mathfrak{X}\right\Vert
_{\mathcal{A}}^{2}.
\end{equation}

\end{lemma}

\begin{remark}
$\mathcal{A}$ is a \emph{sub }$c^{\ast}$\emph{-algebra} of $\mathcal{B}\left(
\mathcal{H}_{\mathcal{A}}\right)  $ given by left multiplication i.e.
\begin{equation}
L_{A}\left(  B\right)  =AB\,\forall B\in\mathcal{A},\,A\in\mathcal{A}.
\end{equation}

\end{remark}

\begin{remark}
\emph{One can form }$c^{\ast}$\emph{-algebra representations }$\Pi_{\varphi
}\left(  \mathcal{A}\right)  $\emph{ of }$A$\emph{ by using states }%
$\varphi\in S\left(  \mathcal{A}\right)  $\emph{ and the GNS construction.
Then one can then form the double commutatnt }$\Pi_{\varphi}\left(
\mathcal{A}\right)  ^{\prime\prime}$\emph{ which is a Von Neumann algebra. The
type of Von Neumann algebra }$\Pi_{\varphi}\left(  \mathcal{A}\right)
^{\prime\prime}$\emph{ is determined by the state }$\varphi.$

\begin{definition}
We will denote the \emph{Von Neumann algebra induced by the }GNS
representation produced by the normalized trace $\operatorname*{tr}$ as
$\mathcal{A}_{\operatorname*{tr}},$ which is a $w^{\ast}$-algebra i.e.
\begin{equation}
\mathcal{A}_{\operatorname*{tr}}=%
%TCIMACRO{\tprod \nolimits_{\operatorname*{tr}}}%
%BeginExpansion
{\textstyle\prod\nolimits_{\operatorname*{tr}}}
%EndExpansion
\left(  \mathcal{A}\right)  ^{\prime\prime}.
\end{equation}
By abus of notation we denote the $w^{\ast}$-algebra $\mathcal{A}%
_{\operatorname*{tr}}$ as $\mathcal{A}.$ The $w^{\ast}$-algebra $\mathcal{A}%
_{\operatorname*{tr}}$ is a Type $II_{1}$ algebra.
\end{definition}
\end{remark}

\begin{remark}
The representations $\Pi_{\varphi}\left(  \mathcal{A}\right)  $ can be of
\emph{any type} depending on the nature of $\varphi\in S\left(  \mathcal{A}%
\right)  .$ Initially one takes $\mathcal{A}$ as a $c^{\ast}$-algebra then
produces a $c^{\ast}$-representation $\Pi_{\varphi}\left(  \mathcal{A}\right)
$ and produces the weak operator closure $\overline{\Pi_{\varphi}\left(
\mathcal{A}\right)  }^{w}$ of $\Pi_{\varphi}\left(  \mathcal{A}\right)  $ that
is a Von Neumann algebra.
\end{remark}

\begin{remark}%
\begin{equation}
\Pi_{\varphi}\left(  A\right)  =\alpha_{0}\Pi_{\varphi}\left(  I_{\mathcal{A}%
}\right)  +\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}%
\alpha_{j_{1}\cdots j_{n}}\Pi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}%
}\right)
\end{equation}
and
\begin{equation}
\Phi_{\varphi}\left(  A\right)  =\alpha_{0}\Phi_{\varphi}\left(
I_{\mathcal{A}}\right)  +\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}<\cdots
<j_{n}\leq2r}\alpha_{j_{1}\cdots j_{n}}\Phi_{\varphi}\left(  x_{j_{1}}\cdots
x_{j_{n}}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The gradation under $\Pi_{\varphi}$ is given by
\begin{equation}
\Pi_{\varphi}\left(  A\right)  =\alpha_{0}\Pi_{\varphi}\left(  I_{\mathcal{A}%
}\right)  +\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}%
\alpha_{j_{1}\cdots j_{n}}\Pi_{\varphi}\left(  x_{j_{1}}\right)  \cdots
\Pi_{\varphi}\left(  x_{j_{n}}\right)  .
\end{equation}
If $\Pi_{\varphi}$ is faithful the gradation is preserved i.e.
\begin{equation}
\left\langle \Pi_{\varphi}\left(  A\right)  \right\rangle _{n}=\sum_{1\leq
j_{1}<\cdots<j_{n}\leq2r}\alpha_{j_{1}\cdots j_{n}}\Pi_{\varphi}\left(
x_{j_{1}}\right)  \cdots\Pi_{\varphi}\left(  x_{j_{n}}\right)  =\Pi_{\varphi
}\left(  \left\langle A\right\rangle _{n}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The inner product in $\mathcal{H}_{\mathcal{\varphi}}$ can be expanded as
\begin{equation}
\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert \Phi
_{\varphi}\left(  A\right)  \right\rangle _{\mathcal{H}_{\mathcal{\varphi}}%
}=\varphi\left(  A^{\dagger}A\right)  =\left\langle A_{0}^{\dagger}%
A_{0}\right\rangle _{0}+\left\langle A_{1}^{\dagger}A_{1}\right\rangle
_{0}+\left\langle A_{2}^{\dagger}A_{2}\right\rangle _{0}+\left\langle
A_{3}^{\dagger}A_{3}\right\rangle _{0}+\left\langle A_{4}^{\dagger}%
A_{4}\right\rangle _{0}+\cdots+\left\langle A_{2r}^{\dagger}A_{2r}%
\right\rangle _{0}.
\end{equation}

\end{remark}

\begin{remark}
The linear functional "$\operatorname*{tr}$"$\in S\left(  \mathcal{A}\right)
$ is a tracial state thus
\begin{equation}
\ker\left\{  \operatorname*{tr}\right\}  =\left\{  0\right\}
\end{equation}
and
\begin{equation}
\operatorname*{tr}\left\{  AB\right\}  =\operatorname*{tr}\left\{  BA\right\}
.
\end{equation}

\end{remark}

\begin{example}
The linear functional "$\operatorname*{tr}$"$\in S\left(  \mathcal{A}\right)
$ and produces the representation $\Pi_{\operatorname*{tr}}\left(
\mathcal{A}\right)  $ and thus the \emph{Von Neumann algebra }$\Pi
_{\operatorname*{tr}}\left(  \mathcal{A}\right)  ^{\prime\prime},$ which is a
Type $II_{1}$\emph{Von Neumann algebra. }$\Pi_{\operatorname*{tr}}\left(
\mathcal{A}\right)  =\Pi_{L}\left(  \mathcal{A}\right)  $ \emph{and is the
left regular representation of }$\mathcal{A}$ (see later)\emph{.}
\end{example}

\begin{lemma}%
\begin{equation}
A\in\mathcal{A}\Rightarrow\operatorname*{tr}\left\{  A\right\}  =\left\langle
A\right\rangle _{0}<\infty.
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{align}
\Pi_{L}\left(  I_{\mathcal{A}}\right)   &  =I_{\mathcal{B}\left(
\mathcal{H}_{\mathcal{A}}\right)  }\\
\Pi_{L}\left(  A\right)   &  =\Pi_{L}\left(  \alpha_{0}I_{\mathcal{A}}%
+\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\alpha_{j_{1}\cdots j_{n}}x_{j_{1}%
}\cdots x_{j_{n}}\right)  =\alpha_{0}\Pi_{L}\left(  I_{\mathcal{A}}\right)
+\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}\alpha_{j_{1}\cdots j_{n}}\Pi_{L}\left(
x_{j_{1}}\right)  \cdots\Pi_{L}\left(  x_{j_{n}}\right) \\
\operatorname*{tr}\left\{  A\right\}   &  =\left\langle A\right\rangle
_{0}=\left\langle \Pi_{L}\left(  A\right)  \right\rangle _{0}=\alpha_{0}.
\end{align}

\end{lemma}

\begin{remark}
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}}\right)  $ is a type I Von
Neumann\emph{-algebra}. The representation $\Pi_{L}\left(  \mathcal{A}\right)
$ is a type $II_{1}$ Von Neumann algebra.
\end{remark}

\begin{notation}%
\begin{align}
\Pi_{\operatorname*{tr}}  &  =\Pi_{I_{\mathcal{A}}}\\
\Phi_{\operatorname*{tr}}  &  =\Phi_{I_{\mathcal{A}}}.
\end{align}

\end{notation}

\begin{notation}%
\begin{equation}
\varphi_{\operatorname*{tr}}\left(  X\right)  =\varphi_{I_{\mathcal{A}}%
}\left(  X\right)  =\operatorname*{tr}\left\{  X\right\}  =\left\langle
X\right\rangle _{0}%
\end{equation}

\end{notation}

\begin{lemma}
The GNS representation $\Pi_{\operatorname*{tr}}$ is identical to $\Pi_{L}$
\end{lemma}

\begin{proof}
\begin{enumerate}
\item
\begin{equation}
\ker\left\{  \Phi_{\operatorname*{tr}}\right\}  =\left\{  0\right\}
\end{equation}
as $\operatorname*{tr}$ is faithful i.e.
\begin{equation}
\left\langle \left.  \Phi_{\operatorname*{tr}}\left(  A\right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  A\right)  \right\rangle =\operatorname*{tr}%
\left\{  A^{\dagger}A\right\}  =\left\langle A^{\dagger}A\right\rangle
_{0}=0\Leftrightarrow A=0.
\end{equation}


\item
\begin{equation}
\Phi_{\operatorname*{tr}}\left(  \mathcal{A}\right)  =\mathcal{H}%
_{\operatorname*{tr}}=\mathcal{H}_{\mathcal{A}}.
\end{equation}


\item The representation $\Pi_{\operatorname*{tr}}$ is defined by
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  B\right)  \Phi_{\operatorname*{tr}}\left(
A\right)  =\Phi_{\operatorname*{tr}}\left(  BA\right)  \,\forall
A\in\mathcal{A}.
\end{equation}


\begin{lemma}
$\Pi_{\operatorname*{tr}}$ is faithful%
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  B-C\right)  =0\Leftrightarrow B=C
\end{equation}

\end{lemma}

\begin{proof}
The action of $\Pi_{\operatorname*{tr}}\left(  B-C\right)  $ on the cyclic
vector $\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  $
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  B-C\right)  \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\right)  =\Phi_{\operatorname*{tr}}\left(  B-C\right)
\end{equation}
which gives if $\Pi_{\operatorname*{tr}}\left(  B-C\right)  =0$ that
\begin{equation}
\Phi_{\operatorname*{tr}}\left(  B-C\right)  =0\Longleftrightarrow B=C
\end{equation}
as $\Phi_{\operatorname*{tr}}$ is faithful. Thus $\Pi_{\operatorname*{tr}}$ is
faithful and
\begin{equation}
\mathcal{A}\overset{w^{\ast}\text{-Algebra}}{\mathcal{\cong}}\Pi
_{\operatorname*{tr}}\left(  \mathcal{A}\right)  ^{\prime\prime}%
\subset\mathcal{B}\left(  \Phi_{\operatorname*{tr}}\left(  \mathcal{A}\right)
\right)  =\mathcal{B}\left(  \mathcal{H}_{\mathcal{A}}\right)  .
\end{equation}

\end{proof}
\end{enumerate}
\end{proof}

\begin{remark}
We have assumed that $\Pi_{\operatorname*{tr}}$ is weakly continuous.
\end{remark}

\begin{remark}
States $f\in\mathcal{S}\left(  \mathcal{A}\right)  $ do not have to be defined
via $\operatorname*{tr}$ e.g.%
\begin{equation}
f\left(  X\right)  \neq\operatorname*{tr}\left\{  XA^{\dagger}A\right\}
\end{equation}
for any $A\in\mathcal{A}.$
\end{remark}

\begin{remark}
The representations $\Pi_{f}\left(  \mathcal{A}\right)  $ can be of \emph{any
type} depending on the nature of $f\in\mathcal{S}\left(  \mathcal{A}\right)
.$ Initially one takes $\mathcal{A}$ as a $c^{\ast}$-algebra then produces a
$c^{\ast}$-representation $\Pi_{f}\left(  \mathcal{A}\right)  $ and produces
the weak operator closure $\overline{\Pi_{f}\left(  \mathcal{A}\right)  }^{w}$
of $\Pi_{f}\left(  \mathcal{A}\right)  $ that is a Von Neumann algebra.
\end{remark}

\begin{remark}%
\begin{equation}
\overline{\Pi_{f}\left(  \mathcal{A}\right)  }^{w}=\Pi_{f}\left(
\mathcal{A}\right)  ^{\prime\prime}\subseteq\mathcal{B}\left(  \Phi_{f}\left(
\mathcal{A}\right)  \right)  .
\end{equation}

\end{remark}

\begin{remark}
Consider $A^{\dagger}A\in\mathcal{B}_{0+}\left(  \mathcal{H}_{\mathcal{A}%
}\right)  $ then
\begin{equation}
A^{\dagger}A=\sum_{1\leq j\leq\infty}x_{A^{\dagger}Aj}\left\vert
\Psi_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}Aj}\right\vert
,\,x_{A^{\dagger}Aj}\in\mathbb{R}_{+}%
\end{equation}
where
\begin{equation}
\sum_{1\leq j\leq\infty}\left\vert \Psi_{A^{\dagger}Aj}\right\rangle
\left\langle \Psi_{A^{\dagger}Aj}\right\vert =I_{\mathcal{A}}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\sum_{1\leq j\leq\infty}\operatorname*{tr}\left\{  \left\vert \Psi
_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}Aj}\right\vert
\right\}  =1,
\end{equation}
hence
\begin{equation}
0\leq\operatorname*{tr}\left\{  \left\vert \Psi_{A^{\dagger}Aj}\right\rangle
\left\langle \Psi_{A^{\dagger}Aj}\right\vert \right\}  \leq1.
\end{equation}

\end{remark}

\begin{remark}
Let $\varphi_{A^{\dagger}A}$ defne a normal state $A^{\dagger}A$ by
\begin{equation}
\varphi_{A^{\dagger}A}\left(  B\right)  =\operatorname*{tr}\left\{
BA^{\dagger}A\right\}  =1,
\end{equation}
then
\begin{equation}
\varphi_{A^{\dagger}A}\left(  I_{\mathcal{A}}\right)  =\operatorname*{tr}%
\left\{  A^{\dagger}A\right\}  =1,
\end{equation}
hence
\begin{equation}
\operatorname*{tr}\left\{  \sum_{1\leq j\leq\infty}x_{A^{\dagger}Aj}\left\vert
\Psi_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}Aj}\right\vert
\right\}  =\sum_{1\leq j\leq\infty}x_{A^{\dagger}Aj}\operatorname*{tr}\left\{
\left\vert \Psi_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}%
Aj}\right\vert \right\}  =1.
\end{equation}

\end{remark}

\begin{remark}
$\left\{  \left.  \varphi_{A^{\dagger}A}\right\vert A\in\mathcal{A}\right\}
\subset\mathcal{S}\left(  \mathcal{A}\right)  $ is the folia of
$\operatorname*{tr}$-states.
\end{remark}

\begin{remark}%
\[
\operatorname*{tr}\left\{  A^{\dagger}A-I_{\mathcal{A}}\right\}  =\sum_{1\leq
j\leq\infty}\left(  x_{A^{\dagger}Aj}-1\right)  \operatorname*{tr}\left\{
\left\vert \Psi_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}%
Aj}\right\vert \right\}  =0\Longleftrightarrow x_{A^{\dagger}Aj}=1,1\leq
j\leq\infty.
\]

\end{remark}

\begin{remark}
In order that
\begin{equation}
\sum_{1\leq j\leq\infty}\operatorname*{tr}\left\{  \left\vert \Psi
_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}Aj}\right\vert
\right\}  =\operatorname*{tr}\left\{  \sum_{1\leq j\leq\infty}\left\vert
\Psi_{A^{\dagger}Aj}\right\rangle \left\langle \Psi_{A^{\dagger}Aj}\right\vert
\right\}  =\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =1
\end{equation}
the value of
\begin{equation}
\operatorname*{tr}\left\{  \left\vert \Psi_{A^{\dagger}Aj}\right\rangle
\left\langle \Psi_{A^{\dagger}Aj}\right\vert \right\}  =\operatorname*{tr}%
\left\{  \left\vert \Psi_{A^{\dagger}Aj^{\prime}}\right\rangle \left\langle
\Psi_{A^{\dagger}Aj^{\prime}}\right\vert \right\}  =p,\,j\neq j^{\prime}%
\end{equation}
and the infinite sum of of the constants $p$ equals $1.$ Hence
\begin{equation}
1=p\infty
\end{equation}
thus $p$ must be infinitessimal. 
\end{remark}

\begin{remark}%
\begin{equation}
\operatorname*{tr}\left\{  XAA^{\dagger}\right\}  =\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  A\right)  \right\vert \Pi_{\operatorname*{tr}%
}\left(  X\right)  \Phi_{\operatorname*{tr}}\left(  A\right)  \right\rangle
=\operatorname{Tr}_{\mathcal{H}_{\mathcal{A}}}\left\{  \Pi_{\operatorname*{tr}%
}\left(  X\right)  \left\vert \Phi_{\operatorname*{tr}}\left(  A\right)
\right\rangle \left\langle \Phi_{\operatorname*{tr}}\left(  A\right)
\right\vert \right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \overset{}{\Pi_{\operatorname*{tr}}\left(  AA^{\dagger}\right)
}\right)  ^{2}=\Pi_{\operatorname*{tr}}\left(  \left(  AA^{\dagger}\right)
^{2}\right)  =\Pi_{\operatorname*{tr}}\left(  AA^{\dagger}\right)
\Pi_{\operatorname*{tr}}\left(  AA^{\dagger}\right)  \overset{\text{in
general}}{\neq}\Pi_{\operatorname*{tr}}\left(  AA^{\dagger}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left\vert \Phi_{\operatorname*{tr}}\left(  A\right)  \right\rangle
\left\langle \Phi_{\operatorname*{tr}}\left(  A\right)  \right\vert =\left(
\left\vert \Phi_{\operatorname*{tr}}\left(  A\right)  \right\rangle
\left\langle \Phi_{\operatorname*{tr}}\left(  A\right)  \right\vert \right)
^{2}%
\end{equation}
hence
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  AA^{\dagger}\right)  \overset{\text{in
general}}{\neq}\left\vert \Phi_{\operatorname*{tr}}\left(  A\right)
\right\rangle \left\langle \Phi_{\operatorname*{tr}}\left(  A\right)
\right\vert .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\left(  I_{\mathcal{A}}-X\right)  ^{2}  &  =I_{\mathcal{A}}-2X+X^{2}\\
X^{2}  &  =X\Rightarrow\left(  I_{\mathcal{A}}-X\right)  ^{2}=I_{\mathcal{A}%
}-X.
\end{align}

\end{remark}

$\lceil$%
\begin{align}
AA^{\dagger} &  =\int_{\mathbb{R}_{+}}xdP_{AA^{\dagger}}\left(  x\right)  \\
\left(  AA^{\dagger}\right)  ^{2} &  =\int_{\mathbb{R}_{+}}x^{2}%
dP_{AA^{\dagger}}\left(  x\right)
\end{align}%
\begin{equation}
AA^{\dagger}=\alpha_{0}I_{\mathcal{A}}+\sum_{1\leq n\leq2r}\sum_{1\leq
j_{1}<\cdots<j_{n}\leq2r}\alpha_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}%
\end{equation}
$\rfloor$

\appendix{}

\section{Enveloping Algebra}

\begin{remark}
In the book "Spinors in Hilbert Space" by Plymen and Robinson, they show if
$V$ is a \emph{complex (separable)} Hilbert space with a \emph{real
structure}, and $Cl(V)$ the corresponding Clifford algebra, there is a
\emph{unique completion} $Cl[V]$ of this algebra to a $c^{\ast}$-algebra: Any
$\ast$-representation of $Cl(V)$ on a Hilbert space will induce that same
$c^{\ast}$-norm on it, and the corresponding closure is the Clifford $c^{\ast
}$-algebra $Cl[V].$
\end{remark}

The situation is \emph{different} for \emph{Von-Neumann algebras}. If%
\begin{equation}
\Pi:Cl(V)\rightarrow\mathcal{B}(\mathcal{H})
\end{equation}


is a $\ast$-representation, then the Von-Neumann-closure
\begin{equation}
VN_{\U{3c0} }\left[  Cl(V)\right]  \overset{\text{def}}{=}\Pi(Cl(V))^{\prime
\prime}%
\end{equation}
will depend drastically on $\Pi$. For example, if $\Pi$ is the \emph{left
regular representation}, then $VN_{\U{3c0} }$ is the \emph{hyperfinite}
$II_{1}$ \emph{factor}, if $\Pi$ is a \emph{Fock} representation, then it is
type $I_{\infty}$, and there are other settings where we obtain type $III$ factors.

\begin{remark}
There is another canonical Von-Neumann algebra containing $Cl(V)$, namely the
\emph{universal enveloping} \emph{algebra}, coming from the case where $\Pi$
is the \emph{universal representation} of $Cl[V]$. Alternatively, it is the
double dual of $Cl[V].$
\end{remark}

\begin{remark}
What can we say about the enveloping Von-Neumann-algebra of $Cl[V].$
\end{remark}

Is it possibly the \emph{hyperfinite} $II_{1}$ factor?

No way! \emph{Every von Neumann completion is a quotient of the universal
enveloping algebra}. \emph{It's as far from being a factor as you can get.}

\begin{remark}
Any \emph{weak}$^{\ast}$ closed ideal of a von Neumann algebra $\mathcal{A}$
has the form $p\mathcal{A}$ for some central projection $p$. The quotient
$\mathcal{A}/p\mathcal{A}$ is isomorphic to $(I-p)\mathcal{A}$ . Thus the
image of $\mathcal{A}$ under any normal (i.e., \emph{weak }$^{\ast}%
$-continuous) $^{\ast}$-homeomorphism is a Von Neumann algebra.
\end{remark}

\begin{remark}
In operator algebras, the \emph{enveloping von Neumann algebra} of a $c^{\ast
}$-algebra is a von Neumann algebra that contains all the operator-algebraic
information about the given $c^{\ast}$-algebra. This may also be called the
\emph{universal enveloping Von Neumann algebra}, since it is given by a
universal property; and (as always with Von Neumann algebras) the term
$w^{\ast}$-algebra may be used in place of Von Neumann algebra.
\end{remark}

\begin{definition}
Let $\mathcal{A}$ be a $c^{\ast}$-algebra and $\Pi_{U}$ be its universal
representation, acting on Hilbert space $\mathcal{H}_{U}$. The image of
$\Pi_{U}$, $\Pi_{U}\left(  \mathcal{A}\right)  $, is a $c^{\ast}$-algebra of
bounded operators on $\mathcal{H}_{U}$. The \emph{enveloping von Neumann
algebra} of $\mathcal{A}$ is the closure of $\Pi_{U}\left(  \mathcal{A}%
\right)  $ in the \emph{weak operator topology}. It is sometimes denoted by
$\mathcal{A}^{\prime\prime}$.
\end{definition}

\begin{remark}
\begin{enumerate}
\item The universal representation $\Pi_{U}$ and $\mathcal{A}^{\prime\prime}$
satisfy the following \emph{universal property}: for \emph{any representation}
$\Pi$, there is a unique $\ast$-homomorphism%
\begin{equation}
\Upsilon:\Pi_{U}\left(  \mathcal{A}\right)  ^{\prime\prime}\rightarrow
\Pi\left(  \mathcal{A}\right)  ^{\prime\prime}%
\end{equation}
that is continuous in the weak operator topology and the restriction of
$\Upsilon$ to $\Pi_{U}\left(  \mathcal{A}\right)  $ is $\Pi$.

\item As a particular case, one can consider the \emph{continuous functional
calculus}, whose unique extension gives a canonical \emph{Borel functional
calculus}.

\item By the \emph{Sherman--Takeda theorem}, the double dual of a $c^{\ast}%
$-algebra $\mathcal{A}$, $\mathcal{A}^{\ast\ast}$, can be identified with
$\mathcal{A}^{\prime\prime}$, as Banach spaces.

\item Every representation of $\mathcal{A}$ \emph{uniquely determines a
central projection} (i.e. a projection in the center of the algebra) in
$\mathcal{A}^{\prime\prime}$; it is called the \emph{central cover of that
projection}.
\end{enumerate}
\end{remark}

\section{Topologies}

\begin{definition}
We define four topologies on $\mathcal{B}\left(  \mathcal{H}\right)  $ as follows.

\begin{enumerate}
\item The \emph{uniform (or norm) topology} is the topology generated by the
`operator norm', that is the topology of the quasi-normed space $\mathcal{B}%
\left(  \mathcal{H}\right)  $.

\item The \emph{strong operator topology} is the uniform topology generated by
the collection of semi-norms
\begin{equation}
p_{x}(A):=\Vert Ax\Vert_{\mathcal{H}},\forall x\in\mathcal{H}.
\end{equation}


\item The \emph{weak operator topology} is the uniform topology generated by
the collection of semi-norms
\begin{equation}
p_{xy}(A):=|\left\langle \left.  x\right\vert Ay\right\rangle _{\mathcal{H}%
}|,\forall x,y\in\mathcal{H}.
\end{equation}


\item The \emph{normal (or ultra-weak) topology} is the uniform topology
generated by the semi-norms
\begin{equation}
p_{B}(A):=|Tr\left\{  AB\right\}  |,\forall B\in\mathcal{B}_{1}\left(
\mathcal{H}\right)  .
\end{equation}

\end{enumerate}
\end{definition}

\begin{definition}
If $\mathcal{B}\left(  \mathcal{H}_{1},\mathcal{H}_{2}\right)  $ is a vector
space of linear maps on the vector space $\mathcal{H}_{1}$ to the vector space
$\mathcal{H}_{2}$, then $\U{3c3} \left(  \mathcal{H}_{1},\mathcal{H}%
_{2}\right)  $ is defined to be the weakest topology on $\mathcal{H}_{1}$ such
that all elements of $\mathcal{B}\left(  \mathcal{H}_{1},\mathcal{H}%
_{2}\right)  $ are continuous.
\end{definition}

\begin{enumerate}
\item The \emph{norm} topology or \emph{uniform} topology or \emph{uniform
operator} topology is defined by the usual norm $||x||_{\mathcal{B}%
(\mathcal{H})}$ on $\mathcal{B}(\mathcal{H})$. It is \emph{stronger} than all
the other topologies below.

\item The \emph{weak} (Banach space) topology is $\U{3c3} (\mathcal{B}%
(\mathcal{H})$, $\mathcal{B}(\mathcal{H})^{\ast}$), in other words the weakest
topology such that all elements of the dual $\mathcal{B}(\mathcal{H})^{\ast}$
are continuous. It is the \emph{weak} topology on the Banach space
$\mathcal{B}(\mathcal{H})$. It is \emph{stronger} than the \emph{ultraweak}
and \emph{weak operator} topologies. (\emph{Warning: the weak Banach space
topology and the weak operator topology and the ultraweak topology are all
sometimes called the weak topology, but they are different.})

\item The \emph{Mackey} topology or \emph{Arens-Mackey} topology is the
\emph{strongest locally convex} topology on $\mathcal{B}(\mathcal{H})$ such
that the dual is $\mathcal{B}(\mathcal{H})^{\ast}$, and is also the
\emph{uniform convergence} topology on $\mathcal{B}(\mathcal{H})$. It is
stronger than all topologies below.

\item The $\U{3c3} $-\emph{strong} $\ast$ topology or \emph{ultrastrong}
$\ast$ topology is the \emph{weakest} topology \emph{stronger} than the
\emph{ultra strong} topology such that the adjoint map is continuous. It is
defined by the family of seminorms $p_{w}(x)$ and $p_{w}(x^{\ast})$ for
positive elements $w$ of $\mathcal{B}(\mathcal{H})^{\ast}$. It is
\emph{stronger} than all topologies below.

\item The $\U{3c3} $-\emph{strong }topology or \emph{ultrastrong} topology or
\emph{strongest} topology or \emph{strongest operator }topology is defined by
the family of seminorms $p_{w}(x)$ for positive elements w of $\mathcal{B}%
(\mathcal{H})^{\ast}$. It is \emph{stronger} than all the topologies below
other than the strong $^{\ast}$ topology. \emph{(Warning: in spite of the name
"strongest topology", it is weaker than the norm topology.)}

\item The $\U{3c3} $-\emph{weak} topology or \emph{ultraweak} topology or
\emph{weak }$^{\ast}$\emph{ operator} topology or \emph{weak} $^{\ast}$
topology or \emph{weak} topology or $\U{3c3} (\mathcal{B}(\mathcal{H}),$
$\mathcal{B}(\mathcal{H})^{\ast})$ topology is defined by the family of
seminorms $p_{w}\left(  x\right)  =|(w,x)|$ for elements $w$ of $\mathcal{B}%
(\mathcal{H})^{\ast}$. It is \emph{stronger} than the \emph{weak} operator
topology. \emph{(Warning: the weak Banach space topology and the weak operator
topology and the ultraweak topology are all sometimes called the weak
topology, but they are different.)}

\item The \emph{strong }$^{\ast}$\emph{operator} topology or \emph{strong
}$^{\ast}$ topology is defined by the seminorms $p_{x}\left(  h\right)
=||x(h)||$ and $p_{x^{\ast}}\left(  h\right)  =||x^{\ast}(h)||$ for
$h\in\mathcal{H}$. It is \emph{stronger} than the \emph{strong} and
\emph{weak} operator topologies.

\item The \emph{strong} operator topology (SOT) or \emph{strong} topology is
defined by the seminorms $p_{x}\left(  h\right)  =||x(h)||$ for $h\in
\mathcal{H}$. It is \emph{stronger} than the \emph{weak operator} topology.

\item The \emph{weak operator} topology (WOT) or \emph{weak} topology is
defined by the seminorms $|(x(h_{1}),h_{2})|$ for $h_{1},h_{2}\in\mathcal{H}$.
\emph{(Warning: the weak Banach space topology, the weak operator topology,
and the ultraweak topology are all sometimes called the weak topology, but
they are different.)}
\end{enumerate}

\subsection{Relations between the topologies}

The continuous linear functionals on $\mathcal{B}(\mathcal{H})$ for the
\emph{weak}, \emph{strong}, and \emph{strong}$^{\ast}$ (operator) topologies
are the same, and are the finite linear combinations of the linear functionals
$\left\langle xh_{1},h_{2}\right\rangle $ for $h_{1},h_{2}\in\mathcal{H}$. The
continuous linear functionals on $\mathcal{B}(\mathcal{H})$ for the
\emph{ultraweak, ultrastrong, ultrastrong} $^{\ast}$ and \emph{Arens-Mackey}
topologies are the same, and are the elements of the predual $\mathcal{B}%
(\mathcal{H})_{\ast}$.

By definition, the continuous linear functionals in the \emph{norm} topology
are the same as those in the \emph{weak Banach} space topology. This dual is a
rather large space with many pathological elements.

On norm bounded sets of $\mathcal{B}(\mathcal{H})$, the \emph{weak} (operator)
and \emph{ultraweak} topologies coincide. This can be seen via, for instance,
the \emph{Banach--Alaoglu} theorem. For essentially the same reason, the
\emph{ultrastrong} topology is the same as the \emph{strong} topology on any
(norm) bounded subset of $\mathcal{B}(\mathcal{H})$. Same is true for the
\emph{Arens-Mackey} topology, the \emph{ultrastrong} $^{\ast}$, and the
\emph{strong}$^{\ast}$ topology.

In locally convex spaces, closure of convex sets can be characterized by the
continuous linear functionals. Therefore, for a convex subset $K$ of
$\mathcal{B}(\mathcal{H})$, the conditions that $K$ be closed in the
\emph{ultrastrong}$^{\ast}$, \emph{ultrastrong}, and \emph{ultraweak}
topologies are all equivalent and are also equivalent to the conditions that
for all $r>0$, $K$ has closed intersection with the closed ball of radius $r$
in the \emph{strong}$^{\ast}$, \emph{strong}, or \emph{weak (operator)} topologies.

The \emph{norm} topology is \emph{metrizable} and the others are not; in fact
they fail to be \emph{first-countable}. However, when $\mathcal{H}$ is
separable, all the topologies above are \emph{metrizable} when restricted to
the unit ball (or to any norm-bounded subset).

\subsection{Normal States}

A normal state on a von Neumann algebra defines a \emph{countably additive
probability measure} over its projection lattice. The von Neumann algebras
familiar from ordinary QM are algebras of all the bounded operators on a
Hilbert space $\mathcal{H}$, aka Type $I$ factor von Neumann algebras. Their
normal states are density operator states, and can be pure or mixed. In QFT
and the thermodynamic limit of QSM, von Neumann algebras of more exotic types
abound. Type $III$ von Neumann algebras, for instance, \emph{have no pure
normal} states; the pure states they do have fail to be countably additive.

Non-normal states are not weakly continuous.

In ordinary QM, $\mathcal{A}=\mathcal{B}(\mathcal{H})$ with $\mathcal{H}$
separable, and let $\mathcal{P(B(H))}$ be the projection lattice of
$\mathcal{B(H)}$. A normal state on $\mathcal{B(H)}$ defines a \emph{countably
additive measure} on $\mathcal{P(B(H))}$. The converse is the assertion that
for any countably additive measure
\begin{equation}%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
:\mathcal{P(B(H))}\rightarrow\lbrack0,1]
\end{equation}
there is a unique normal state $\U{3c9} \in\mathcal{S}\left(  \mathcal{B(H)}%
\right)  $ on $\mathcal{B(H)}$\emph{ }such that
\begin{equation}
\U{3c9} (p)=%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
(p)\quad\forall p\in\mathcal{P(B(H))}%
\end{equation}
or, equivalently, there is a density operator $D$ such that
\begin{equation}
Tr\left\{  pD\right\}  =%
%TCIMACRO{\U{3bc} }%
%BeginExpansion
\mu
%EndExpansion
(p)\quad\forall p\in\mathcal{P(B(H))}.
\end{equation}
This assertion is not true in general, in particular, it fails if
$\dim(\mathcal{H})\leq2$. But a highly nontrivial result, known as
\emph{Gleason's Theorem}, shows that the assertion is true for $\dim
(\mathcal{H})>2$.


