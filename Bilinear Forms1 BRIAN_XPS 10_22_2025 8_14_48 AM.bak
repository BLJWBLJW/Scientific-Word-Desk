\vdots & \ddots & \vdots \\ 
x_{bb2r}\left( e_{b1}\right) & \cdots & x_{bb2r}\left( e_{b2r}\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\item $\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) $%
\begin{gather}
\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bb2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
x_{b1} & \cdots & x_{b2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{bb1} \\ 
\vdots \\ 
y_{bb2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{b2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( x_{b1}\right) & \cdots & e_{bb1}\left( x_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bb2r}\left( x_{b1}\right) & \cdots & e_{bb2r}\left( x_{b2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{bb1}\left( e_{b1}\right) & \cdots & y_{bb1}\left( e_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{bb2r}\left( e_{b1}\right) & \cdots & y_{bb2r}\left( e_{b2r}\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b1}\left( e_{2r}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( y_{2r}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right)
\end{gather}%
i.e. 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) ^{t}\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b1}\left( e_{2r}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( y_{2r}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\item Compare to $\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) ^{t}$ 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) ^{t}=\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\paragraph{\textbf{Comparing transpose and dual representations}}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
