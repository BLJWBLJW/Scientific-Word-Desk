\boldsymbol{\alpha}\right\rangle ^{-\frac{1}{2}}\Longleftrightarrow\left\vert
\boldsymbol{w}\right\rangle \left\langle \left.  \boldsymbol{\alpha
}\right\vert \boldsymbol{\alpha}\right\rangle ^{\frac{1}{2}}=\left\vert
\boldsymbol{\alpha}\right\rangle \\
\left\vert \boldsymbol{v}\right\rangle  &  =\left\vert \boldsymbol{\beta
}\right\rangle \left\langle \left.  \boldsymbol{\beta}\right\vert
\boldsymbol{\beta}\right\rangle ^{-\frac{1}{2}}\Longleftrightarrow\left\vert
\boldsymbol{v}\right\rangle \left\langle \left.  \boldsymbol{\beta}\right\vert
\boldsymbol{\beta}\right\rangle ^{\frac{1}{2}}=\left\vert \boldsymbol{\beta
}\right\rangle \\
\left\langle \boldsymbol{v}\right\vert  &  =\left\langle \left.
\boldsymbol{\beta}\right\vert \boldsymbol{\beta}\right\rangle ^{-\frac{1}{2}%
}\left\langle \boldsymbol{\beta}\right\vert \Longleftrightarrow\left\langle
\left.  \boldsymbol{\beta}\right\vert \boldsymbol{\beta}\right\rangle
^{\frac{1}{2}}\left\langle \boldsymbol{v}\right\vert =\left\langle
\boldsymbol{\beta}\right\vert
\end{align}%
\begin{equation}
\left\langle \left.  \boldsymbol{\beta}\right\vert \boldsymbol{\beta
}\right\rangle =\left\langle \left.  \boldsymbol{\beta}\right\vert
\boldsymbol{\beta}\right\rangle ^{\dagger}\geq0,\left\langle \left.
\boldsymbol{\alpha}\right\vert \boldsymbol{\alpha}\right\rangle =\left\langle
\left.  \boldsymbol{\alpha}\right\vert \boldsymbol{\alpha}\right\rangle
^{\dagger}\geq0
\end{equation}


\item
\begin{align}
\left\langle \left.  \boldsymbol{v}\right\vert \boldsymbol{v}\right\rangle  &
=\left\langle \left.  \boldsymbol{w}\right\vert \boldsymbol{w}\right\rangle
=\mathbb{I}_{p},\\
\left\vert \boldsymbol{v}\right\rangle \left\langle \boldsymbol{v}\right\vert
&  =P_{v},\quad\left\vert \boldsymbol{w}\right\rangle \left\langle
\boldsymbol{w}\right\vert =P_{w}%
\end{align}


\item
\begin{align}
\left\vert \boldsymbol{v}\right\rangle \left\langle \boldsymbol{v}\right\vert
\left\vert \boldsymbol{w}\right\rangle \left\langle \boldsymbol{w}\right\vert
&  =P_{v}P_{w}\\
\left\langle \boldsymbol{v}\right\vert \left\vert \boldsymbol{w}\right\rangle
\left\langle \boldsymbol{w}\right\vert \left\vert \boldsymbol{v}\right\rangle
&  =\left\langle \boldsymbol{v}\right\vert \left\vert \boldsymbol{w}%
\right\rangle \left\langle \boldsymbol{w}\right\vert \left\vert \boldsymbol{v}%
\right\rangle ^{\dagger}=\mathbb{P}_{v}\\
\left\langle \boldsymbol{w}\right\vert \left\vert \boldsymbol{v}\right\rangle
\left\langle \boldsymbol{v}\right\vert \left\vert \boldsymbol{w}\right\rangle
&  =\left\langle \boldsymbol{w}\right\vert \left\vert \boldsymbol{v}%
\right\rangle ^{\dagger}\left\langle \boldsymbol{v}\right\vert \left\vert
\boldsymbol{w}\right\rangle =\mathbb{P}_{w}%
\end{align}

\end{enumerate}

\item
\begin{align}
\left\vert \overset{}{\alpha_{j}}\right\rangle  &  =\sum_{1\leq k\leq
p}\left\vert \overset{}{\boldsymbol{w}_{k}}\right\rangle \left(  \left\langle
\left.  \boldsymbol{\alpha}\right\vert \boldsymbol{\alpha}\right\rangle
^{\frac{1}{2}}\right)  _{kj}\\
\left\langle \overset{}{\beta}_{j}\right\vert  &  =\sum_{1\leq l\leq p}\left(
\left\langle \left.  \boldsymbol{\beta}\right\vert \boldsymbol{\beta
}\right\rangle ^{\frac{1}{2}}\right)  _{lj}\left\langle
\overset{}{\boldsymbol{v}_{l}}\right\vert
\end{align}

\end{enumerate}
\end{remark}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
A=\left(  \boldsymbol{E}_{fe}\right)  \mathcal{R}_{E}\left(  A\right)
\end{equation}


\item
\begin{equation}
\boldsymbol{E}_{uv}=T_{u\eta}\boldsymbol{E}_{fe}T_{v\varsigma}^{t}=\left(
\mathbf{u\#}\boldsymbol{\eta}^{d}\right)  \boldsymbol{E}_{fe}\left(
\boldsymbol{\varsigma}\mathbf{\#v}^{d}\right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{v}\left(  A\right)  =\mathcal{R}_{\varsigma}\left(  T_{uf}%
AT_{ve}^{t}\right)  =\mathcal{R}_{f}\left(  T_{uf}\right)  \mathcal{R}%
_{e}\left(  A\right)  \mathcal{R}_{e}\left(  T_{ve}^{t}\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{corollary}
In any non canonical bases the operator SVD expansion is
\begin{equation}
A=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}E_{f_{j}e_{k}}\mathcal{R}%
_{ee}\left(  A\right)  _{jk}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}E_{w_{j}v_{j}}\mathcal{R}_{vv}\left(  T_{uf}AT_{ve}^{t}\right)  _{jk}%
=\sum_{1\leq j\leq p}E_{w_{j}v_{j}}\mathcal{R}_{vv}\left(  A\right)  _{jj}.
\end{equation}

\end{corollary}

