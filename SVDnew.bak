\begin{notation}
Products in super vector notation
\end{notation}

\begin{enumerate}
\item $\left(  \boldsymbol{e}\right)  $-basis scalar sum of scalar products of
vectors
\[
\mathbf{e}_{b}\cdot\left(  \boldsymbol{e}\right)  ^{t}=\left(  e_{1}%
^{d},\cdots,e_{m}^{d}\right)  \left(  e_{1},\cdots,e_{m}\right)  ^{t}=\left(
e_{1}^{d},\cdots,e_{m}^{d}\right)  \left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{m}%
\end{array}
\right)  =\sum_{1\leq j\leq n}e_{j}^{d}\left(  e_{j}\right)  =n.
\]


\item $\left(  \boldsymbol{e}\right)  $-basis matrix of scalar products of
vectors%
\begin{align}
\mathbf{e}_{b}^{t}\cdot\left(  \boldsymbol{e}\right)   &  =\boldsymbol{e}%
^{d}\left(  \boldsymbol{e}\right)  =\left(  e_{1}^{d},\cdots,e_{n}^{d}\right)
^{t}\left(  e_{1},\cdots,e_{n}\right)  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  \left(  e_{1},\cdots,e_{n}\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  e_{1}\right)  & \cdots & e_{1}^{d}\left(  e_{n}\right) \\
\vdots & \ddots & \vdots\\
e_{n}^{d}\left(  e_{1}\right)  & \cdots & e_{n}^{d}\left(  e_{n}\right)
\end{array}
\right)  =\mathcal{R}_{e}\left(  I_{W}\right)  =\mathbb{I}_{n}\in
\mathcal{M}\left(  n,n,\mathbb{C}\right)  .
\end{align}


\begin{notation}%
\begin{equation}
\boldsymbol{e}^{d}\left(  \boldsymbol{e}\right)  \equiv\mathbf{e}_{b}^{t}%
\cdot\left(  \boldsymbol{e}\right)  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  \left(  e_{1},\cdots,e_{n}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  e_{1}\right)  & \cdots & e_{1}^{d}\left(  e_{n}\right) \\
\vdots & \ddots & \vdots\\
e_{n}^{d}\left(  e_{1}\right)  & \cdots & e_{n}^{d}\left(  e_{n}\right)
\end{array}
\right)  .
\end{equation}

\end{notation}

\item $\left(  \boldsymbol{e}\right)  $-basis matrix of operator products of
vectors%
\begin{align}
\left(  \boldsymbol{e}\right)  \#\mathbf{e}_{b}^{t}  &  =\left(  e_{1}%
,\cdots,e_{n}\right)  ^{t}\left(  e_{1}^{d},\cdots,e_{n}^{d}\right)  =\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{n}%
\end{array}
\right)  \left(  e_{1}^{d},\cdots,e_{n}^{d}\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\left[  e_{1}e_{1}^{d}\right]  & \cdots & \left[  e_{n}e_{1}^{d}\right] \\
\vdots & \ddots & \vdots\\
\left[  e_{1}e_{n}^{d}\right]  & \cdots & \left[  e_{n}e_{n}^{d}\right]
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}e_{1}^{d} & \cdots & e_{n}e_{1}^{d}\\
\vdots & \ddots & \vdots\\
e_{1}e_{n}^{d} & \cdots & e_{n}e_{n}^{d}%
\end{array}
\right)  \in\mathcal{M}\left(  n,n,\mathcal{B}\left(  W,W\right)  \right)
.\nonumber
\end{align}


\item $\left(  \boldsymbol{e}\right)  $-basis operator sum of operator
products of vectors%
\begin{equation}
\left(  \boldsymbol{e}\right)  \#\mathbf{e}_{b}^{t}=\left(  e_{1},\cdots
,e_{n}\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  =\sum_{1\leq j\leq n}\left[  e_{j}e_{j}^{d}\right]  =\sum_{1\leq
j\leq n}e_{j}e_{j}^{d}=I_{W}\in\mathcal{B}\left(  W,W\right)  .
\end{equation}

\end{enumerate}

\begin{remark}
\begin{enumerate}
\item
\begin{enumerate}
\item
\begin{equation}
\boldsymbol{e}^{d}\diamond\mathbf{e}^{t}=\left[  \boldsymbol{e}^{d}%
\mathbf{e}^{t}\right]  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  \diamond\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{r}%
\end{array}
\right)  =\sum_{1\leq j\leq r}\left[  e_{j}^{d}e_{j}\right]  \quad
\in\mathcal{L}\left(  \mathcal{V}^{d}\right)  .
\end{equation}


\item
\begin{equation}
\boldsymbol{e}^{d}\cdot\mathbf{e}^{t}=\boldsymbol{e}^{d}\left(  \mathbf{e}%
^{t}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d} & \cdots & e_{r}^{d}%
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{r}%
\end{array}
\right)  =\sum_{1\leq j\leq r}e_{j}^{d}\left(  e_{j}\right)  \in\mathbb{C}.
\end{equation}


\item
\begin{equation}
\mathbf{e}_{b}\diamond\boldsymbol{e}=\left[  \mathbf{e}_{b}\boldsymbol{e}%
\right]  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{r}^{d}%
\end{array}
\right)  \diamond\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left[  e_{1}^{d}e_{1}\right]  & \cdots & \left[  e_{1}^{d}e_{r}\right] \\
\vdots & \ddots & \vdots\\
\left[  e_{1}^{d}e_{r}\right]  & \cdots & \left[  e_{r}^{d}e_{r}\right]
\end{array}
\right)  \in\mathcal{M}\left(  r,r,\mathcal{L}\left(  \mathcal{V}\right)
\right)  \cong\otimes^{r}\mathcal{L}\left(  \mathcal{V}\right)  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
A sesquilinear $\left\langle \left.  {}\right\vert \right\rangle
$-biorthogonal bases to $\left\vert \mathbf{e}\right\rangle $ of
$\mathcal{H}^{1}$ is denoted by $\left\vert \mathbf{e}^{b}\right\rangle $ that
produces a dual basis i.e. $\left(  \mathbf{e}_{b}\right)  =\digamma
_{\left\vert e\right\rangle }\left\{  \left\vert \mathbf{e}^{b}\right\rangle
\right\}  $
\end{remark}

\begin{definition}
The injection $\digamma_{e}$
\begin{equation}
\digamma_{e}:V\hookrightarrow V^{d},
\end{equation}
which is the embedding of $V$ into $V^{d},$ that is basis dependent if
$\dim\left\{  V\right\}  =\infty$ by
\begin{equation}
\left(  \mathbf{e}_{b}\right)  =\digamma_{e}\left\{  \left(  \mathbf{e}%
\right)  \right\}  .
\end{equation}
The map $\digamma_{e}$ can be linear of antilinear.
\end{definition}

\begin{example}
Let $\digamma_{e}=\digamma_{\left\vert e\right\rangle }$ where
\begin{equation}
\left(  \mathbf{e}_{b}\right)  =\digamma_{\left\vert e\right\rangle }\left\{
\left\vert \mathbf{e}^{b}\right\rangle \right\}
\end{equation}
the map $\digamma_{\left\vert e\right\rangle }$ is $\mathbb{C}$%
-\emph{antilinear} as
\begin{equation}
\left[  \digamma_{\left\vert e\right\rangle }\left(  \alpha v_{1}+\beta
v_{2}\right)  \right]  \left(  w\right)  =\left\langle \left.  \alpha
v_{1}+\beta v_{2}\right\vert w\right\rangle =\overline{\alpha}\left\langle
\left.  v_{1}\right\vert w\right\rangle +\overline{\beta}\left\langle \left.
v_{2}\right\vert w\right\rangle
\end{equation}
and hence
\begin{equation}
\left[  \digamma_{\left\vert e\right\rangle }\left(  \alpha v_{1}+\beta
v_{2}\right)  \right]  =\overline{\alpha}\digamma_{\left\vert e\right\rangle
}\left(  v_{1}\right)  +\overline{\beta}\digamma_{\left\vert e\right\rangle
}\left(  v_{2}\right)  .
\end{equation}

\end{example}

\begin{notation}
\begin{enumerate}
\item
\begin{enumerate}
\item The $\left\langle \left.  {}\right\vert \right\rangle $-biorthogonal
bases $\left\vert \mathbf{e}^{b}\right\rangle $ is given by
\begin{equation}
\left\vert \mathbf{e}^{b}\right\rangle =\left\vert \mathbf{e}\right\rangle
\left\langle \left.  \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}=\left(  \mathbf{e}\right)  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}.
\end{equation}


\item This gives%
\begin{align}
\mathbf{e}_{b}\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}_{b}\right)
^{t}\cdot\left(  \mathbf{e}\right)  =\left\langle \left.  \mathbf{e}%
^{b}\right\vert \mathbf{e}\right\rangle =\left\langle \mathbf{e}%
^{b}\right\vert \cdot\left\vert \mathbf{e}\right\rangle =\left(
\begin{array}
[c]{c}%
\left\langle e_{1}^{b}\right\vert \\
\vdots\\
\left\langle e_{r}^{b}\right\vert
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right\rangle  & \cdots & \left\vert e_{r}\right\rangle
\end{array}
\right) \\
&  =\left\langle \left(  \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\right\vert \cdot\left\vert
\mathbf{e}\right\rangle =\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right)
\left\vert \mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle =\mathbb{I}_{r}.
\end{align}

\end{enumerate}

\item A complex symmetric $\left(  \left.  {}\right\vert \right)  $-conb of
$\mathcal{H}^{1}$ is denoted by $\left\vert \mathbf{e}\right)  .$

\begin{enumerate}
\item The $\left(  \left.  {}\right\vert \right)  $-biorthogonal bases
$\left\vert \mathbf{e}^{b}\right)  $ is given by
\begin{equation}
\left\vert \mathbf{e}^{b}\right)  =\left\vert \mathbf{e}\right)  \left(
\left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}.
\end{equation}


\item This gives%
\begin{align}
\mathbf{e}_{b}\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}_{b}\right)
^{t}\cdot\left(  \mathbf{e}\right)  =\left(  \left.  \mathbf{e}^{b}\right\vert
\mathbf{e}\right)  =\left(  \mathbf{e}^{b}\right\vert \cdot\left\vert
\mathbf{e}\right)  =\left(
\begin{array}
[c]{c}%
\left(  e_{1}^{b}\right\vert \\
\vdots\\
\left(  e_{r}^{b}\right\vert
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right)  & \cdots & \left\vert e_{r}\right)
\end{array}
\right) \\
&  =\left\langle \left(  \mathbf{e}\right)  \left(  \left.  \mathbf{e}%
\right\vert \mathbf{e}\right)  ^{-1}\right\vert \cdot\left\vert \mathbf{e}%
\right)  =\left(  \left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)
^{-1}\left(  \mathbf{e}\right\vert \right)  \left\vert \mathbf{e}\right)
=\left(  \left.  \mathbf{e}\right\vert \mathbf{e}\right)  ^{-1}\left(  \left.
\mathbf{e}\right\vert \mathbf{e}\right)  =\mathbb{I}_{r}.
\end{align}

\end{enumerate}
\end{enumerate}
\end{notation}


