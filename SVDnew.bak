\vdots & \cdots & \vdots\\
f_{m}^{d}\left(  e_{m+1}\right)  & \cdots & f_{m}^{d}\left(  e_{n}\right) \\
0 & \cdots & 0\\
\vdots & \vdots & \vdots\\
0 & \cdots & 0
\end{array}
\right) \\
=\mathbb{P}_{m}=\left(
\begin{array}
[c]{ccc}%
1_{1} & \cdots & 0\\
0 & \ddots & \vdots\\
\vdots & \cdots & 1_{m}\\
0 & \cdots & 0\\
0 & \cdots & 0\\
\vdots & \vdots & \vdots\\
0 & \cdots & 0
\end{array}%
\begin{array}
[c]{ccc}%
0 & \cdots & 0\\
0 & \cdots & 0\\
0 & \cdots & 0\\
0 & \cdots & 0\\
0 & \cdots & 0\\
\vdots & \vdots & \vdots\\
0 & \cdots & 0
\end{array}
\right)  \in\mathcal{M}\left(  n,n,\mathbb{C}\right)  .
\end{gather}


