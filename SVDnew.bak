\left(  \boldsymbol{f}\right)  =A\left(  \boldsymbol{e}\right)  =\left(
\boldsymbol{e}\right)  \mathcal{R}_{ee}\left(  A\right) \\
f_{j}=\sum_{1\leq k\leq n}e_{k}\mathcal{R}_{ee}\left(  A\right)  _{kj}%
,\quad1\leq j\leq m
\end{gather}


\item
\begin{equation}
f_{l}^{d}\left(  f_{j}\right)  =f_{l}^{d}\left(  \sum_{1\leq k\leq n}%
e_{k}\mathcal{R}_{ee}\left(  A\right)  _{kj}\right)  =\sum_{1\leq k\leq
n}f_{l}^{d}\left(  e_{k}\right)  \mathcal{R}_{ee}\left(  A\right)
_{kj}=\delta_{lj}%
\end{equation}
hence
\begin{equation}
\boldsymbol{f}^{d}\left(  \boldsymbol{e}\right)  =\mathcal{R}_{ee}\left(
A\right)  ^{-1}=\left(  A\left(  \boldsymbol{e}\right)  \right)  ^{d}\left(
\left(  \boldsymbol{e}\right)  \right)  .
\end{equation}


\item
\begin{gather}
\left(  \boldsymbol{f}\right)  =A\left(  \boldsymbol{e}\right)  =I_{W}A\left(
\boldsymbol{e}\right)  =\sum_{1\leq j\leq m}\left[  f_{j}f_{j}^{d}\right]
A\left(  \boldsymbol{e}\right)  =\sum_{1\leq j\leq m}\left[  f_{j}f_{j}%
^{d}\right]  A\left(
\begin{array}
[c]{cccc}%
e_{1} & \cdots & \cdots & e_{n}%
\end{array}
\right)  =\sum_{1\leq j\leq m}\left[  f_{j}f_{j}^{d}\right]  \left(
\begin{array}
[c]{cccc}%
\left(  Ae_{1}\right)  & \cdots & \cdots & \left(  Ae_{n}\right)
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cccc}%
f_{1}^{d}\left(  Ae_{1}\right)  f_{1} & \cdots & \cdots & f_{n}^{d}\left(
Ae_{n}\right)  f_{n}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
f_{1}^{d}\left(  Ae_{1}\right)  f_{1} & \cdots & \cdots & f_{n}^{d}\left(
Ae_{n}\right)  f_{n}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
f_{1} & \cdots & \cdots & f_{n}%
\end{array}
\right) \\
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}f_{j}f_{j}^{d}\left(
Ae_{k}\right)  =\left(  \boldsymbol{f}\right)  \mathcal{R}_{ee}\left(
A\right)  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}f_{j}\mathcal{R}%
_{ee}\left(  A\right)  _{jk}=\left(  \boldsymbol{f}\right)  .
\end{gather}


\item
\begin{equation}
\mathcal{R}_{ee}\left(  A\right)  \in\mathcal{M}\left(  m,n,\mathbb{C}\right)
.
\end{equation}


\item
\begin{equation}
Av=A\left(  \boldsymbol{e}\right)  \mathcal{R}_{e}\left(  v\right)  =\left(
\boldsymbol{f}\right)  \mathcal{R}_{ee}\left(  A\right)  \mathcal{R}%
_{e}\left(  v\right)  =w.
\end{equation}


\item
\begin{align}
A  &  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{j}e_{k}%
^{d}\right]  \mathcal{R}_{fe}\left(  A\right)  _{jk}=\sum_{\substack{1\leq
j\leq m\\1\leq k\leq n}}E_{f_{j}e_{k}^{d}}\mathcal{R}_{ee}\left(  A\right)
_{jk}\\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  h_{j}g_{k}%
^{d}\right]  \mathcal{R}_{gg}\left(  A\right)  _{jk}=\sum_{\substack{1\leq
j\leq m\\1\leq k\leq n}}E_{h_{j}g_{k}^{d}}\mathcal{R}_{gg}\left(  A\right)
_{jk}.
\end{align}


\item
\begin{align}
e_{_{j}}  &  =\sum_{1\leq k\leq m}g_{k}\mathcal{R}_{gg}\left(  T_{eg}\right)
_{kj}\\
f_{_{j}}  &  =\sum_{1\leq k\leq m}h_{k}\mathcal{R}_{hh}\left(  T_{fh}\right)
_{kj}.
\end{align}


\item
\begin{equation}
\left[  f_{j}e_{k}^{d}\right]  \left(  v\right)  =f_{j}e_{k}^{d}\left(
v\right)  =\left(  \sum_{1\leq p\leq m}h_{p}\mathcal{R}_{hh}\left(
T_{fh}\right)  _{pj}\right)  \left(  \sum_{1\leq l\leq m}g_{l}^{d}%
\mathcal{R}_{gg}\left(  T_{eg}\right)  _{lk}\right)  \left(  v\right)
=\sum_{\substack{1\leq p\leq m\\1\leq l\leq m}}\mathcal{R}_{hh}\left(
T_{fh}^{t}\right)  _{jp}\left[  h_{p}g_{l}^{d}\right]  \mathcal{R}_{gg}\left(
T_{eg}\right)  _{lk}\left(  v\right)  .
\end{equation}

\end{enumerate}
\end{enumerate}

\section{Dual Spaces}

The dual space $V^{d}$ of a vector space $V$ is the linear space of linear
functionals defined on $V$ i.e.%
\begin{equation}
f\in V^{d}\Leftrightarrow f\left(  c_{1}v_{1}+c_{2}v_{2}\right)
=c_{1}f\left(  v_{1}\right)  +c_{2}f\left(  v_{2}\right)  ,\quad c_{1}%
,c_{2}\in\mathbb{C},\quad v_{1},v_{2}\in V.
\end{equation}


\begin{definition}
A complex conjugate $\mathcal{K}_{e}^{d}\left(  f\right)  $ of a functional
$f,$ is defined by
\begin{equation}
\mathcal{K}_{e}^{d}\left(  f\right)  =\sum_{1\leq j\leq n}e_{bj}%
\overline{\mathcal{R}_{e^{d}}\left(  f\right)  _{j}}%
\end{equation}
for a bases $\left\{  \left.  e_{bj}\right\vert 1\leq j\leq n\right\}  $ of
$V^{d}$. The map $\mathcal{K}_{e}^{d}$ is an anti isomorphism%
\begin{equation}
\mathcal{K}_{e}^{d}\left(  c_{1}f_{1}+c_{2}f_{2}\right)  =\overline{c_{1}%
}\mathcal{K}_{e}^{d}\left(  f_{1}\right)  +\overline{c_{2}}\mathcal{K}_{e}%
^{d}\left(  f_{2}\right)  ,
\end{equation}
i.e. $\mathcal{K}_{e}^{d}\in\mathcal{B}_{anti}\left(  V^{d}\right)  $.
\end{definition}

\begin{definition}
A \emph{c}omplex conjugate $\mathcal{\sigma}_{e}\left(  v\right)  $ of
\emph{a} vector $v$ \emph{is }defined by
\begin{equation}
\mathcal{\sigma}_{e}\left(  v\right)  =\sum_{1\leq j\leq n}e_{j}%
\overline{\mathcal{R}_{e}\left(  v\right)  _{j}}%
\end{equation}
for a bases $\left\{  \left.  e_{j}\right\vert 1\leq j\leq n\right\}  $ of
$V.$ The map $\mathcal{\sigma}_{e}$ is an anti isomorphism%
\begin{equation}
\mathcal{\sigma}_{e}\left(  c_{1}v_{1}+c_{2}v_{2}\right)  =\overline{c_{1}%
}\mathcal{\sigma}_{e}\left(  v_{1}\right)  +\overline{c_{2}}\mathcal{\sigma
}_{e}\left(  v_{2}\right)  ,
\end{equation}
i.e. $\mathcal{\sigma}_{e}\in\mathcal{B}_{anti}\left(  V\right)  .$
\end{definition}

\begin{remark}
Conjugations are \emph{bases dependent.}

\begin{enumerate}
\item The $e$-complex conjugate of $ie_{j}$ is
\begin{equation}
\mathcal{\sigma}_{e}\left(  ie_{j}\right)  =-i\mathcal{\sigma}_{e}\left(
e_{j}\right)  =-ie_{j},
\end{equation}
while

\item the $ie$-complex conjugate of $ie_{j}$ is
\[
\mathcal{\sigma}_{ie}\left(  ie_{j}\right)  =ie_{j}.
\]

\end{enumerate}
\end{remark}

\subsection{Complex conjugates of linear transformations}

\begin{remark}
\begin{enumerate}
\item Let $A\in\mathcal{B}_{00}\left(  W,V\right)  $ then
\begin{align}
w  &  =A\left[  \boldsymbol{ee}^{d}\right]  v=A\left(  \boldsymbol{e}\right)
\boldsymbol{e}^{d}\left(  v\right)  =\sum_{\substack{1\leq j\leq n\\1\leq
k\leq m}}e_{j}\mathcal{R}_{ee}\left(  A\right)  _{jk}\mathcal{R}_{e}\left(
v\right)  _{k}\\
w  &  =A\left[  \boldsymbol{ff}^{d}\right]  \left[  \boldsymbol{e}%
^{d}\boldsymbol{e}\right]  v=A\left(  \boldsymbol{f}\right)  \boldsymbol{f}%
^{d}\left(  \boldsymbol{e}\right)  \boldsymbol{e}^{d}\left(  v\right)
=\sum_{\substack{1\leq j\leq n\\1\leq k,l\leq m}}f_{j}\mathcal{R}_{ff}\left(
A\right)  _{jk}\left(  \boldsymbol{f}^{d}\left(  \boldsymbol{e}\right)
\right)  _{kl}\mathcal{R}_{e}\left(  v\right)  _{l}.
\end{align}


\item A complex conjugate of the image vector $w=Av$ is
\begin{equation}
\mathcal{\sigma}_{f}\left(  w\right)  =\mathcal{\sigma}_{f}\left(  Av\right)
=\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}}f_{j}\overline{\mathcal{R}%
_{ee}\left(  A\right)  _{jk}}\overline{\mathcal{R}_{e}\left(  v\right)  _{k}}.
\end{equation}


\item The action of $A$ on a complex conjugate vector $\mathcal{\sigma}%
_{e}\left(  v\right)  $ is given by
\begin{equation}
w_{\mathcal{\sigma}_{e}}=A\mathcal{\sigma}_{e}\left(  v\right)  =\sum
_{\substack{1\leq j\leq n\\1\leq k\leq m}}f_{j}\mathcal{R}_{ee}\left(
A\right)  _{jk}\overline{\mathcal{R}_{e}\left(  v\right)  _{k}}.
\end{equation}


\item A complex conjugate of the action of $A$ on a complex conjugate vector
is
\begin{equation}
w_{\mathcal{\sigma}_{f}\mathcal{\sigma}_{e}}=\mathcal{\sigma}_{f}\left(
w_{\mathcal{\sigma}_{e}}\right)  =\left(  \mathcal{\sigma}_{f}A\mathcal{\sigma
}_{e}\right)  \left(  v\right)  =\mathcal{\sigma}_{f}\left(  A\mathcal{\sigma
}_{e}\left(  v\right)  \right)  =\sum_{\substack{1\leq j\leq n\\1\leq k\leq
m}}f_{j}\overline{\mathcal{R}_{ee}\left(  A\right)  _{jk}}\mathcal{R}%
_{e}\left(  v\right)  _{k},
\end{equation}
which can be expressed as
\begin{equation}
\left(  \mathcal{\sigma}_{f}A\mathcal{\sigma}_{e}\right)  \left(  v\right)
=\left(  \mathcal{\sigma}_{f}A\mathcal{\sigma}_{e}\right)  \left(
\boldsymbol{e}\right)  \mathcal{R}_{e}\left(  v\right)  =\left(
\boldsymbol{f}\right)  \mathcal{R}_{ee}\left(  \mathcal{\sigma}_{f}%
A\mathcal{\sigma}_{e}\right)  \mathcal{R}_{e}\left(  v\right)  =\left(
\boldsymbol{f}\right)  \mathcal{R}_{f}\left(  \left(  \mathcal{\sigma}%
_{f}A\mathcal{\sigma}_{e}\right)  v\right)  .
\end{equation}


\item This leads to
\begin{equation}
\mathcal{\sigma}_{f}A\mathcal{\sigma}_{e}=\left(  \boldsymbol{f}\right)
\mathcal{R}_{ee}\left(  \mathcal{\sigma}_{f}A\mathcal{\sigma}_{e}\right)
\left(  \mathbf{e}_{b}\right)  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\left[  f_{j}e_{k}^{d}\right]  \mathcal{R}_{ee}\left(  \mathcal{\sigma}%
_{f}A\mathcal{\sigma}_{e}\right)  _{jk}=\sum_{\substack{1\leq j\leq m\\1\leq
k\leq n}}\left[  f_{j}e_{k}^{d}\right]  \overline{\mathcal{R}_{ee}\left(
A\right)  _{jk}},
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
\mathcal{R}_{ee}\left(  A\right)  =\boldsymbol{e}^{d}\left(  A\boldsymbol{e}%
\right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{ee}\left(  Av\right)  =\mathcal{R}_{ee}\left(  A\right)
\mathcal{R}_{e}\left(  v\right)
\end{equation}


\item
\begin{equation}
\overline{\mathcal{R}_{ee}\left(  A\right)  }=\operatorname{Re}\left(
\mathcal{R}_{ee}\left(  A\right)  \right)  -i\operatorname{Im}\left(
\mathcal{R}_{ee}\left(  A\right)  \right)
\end{equation}


\item
\begin{align}
\overline{\mathcal{R}_{ee}\left(  Av\right)  }  &  =\overline{\mathcal{R}%
_{ee}\left(  A\right)  }\overline{\mathcal{R}_{e}\left(  v\right)  }=\left(
\operatorname{Re}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
-i\operatorname{Im}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)  \right)
\left(  \operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-i\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right)  \right)
\\
&  =\operatorname{Re}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\left(  \operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-i\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right)  \right)
-i\operatorname{Im}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)  \left(
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-i\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right)  \right)
\\
&  =\operatorname{Re}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-i\operatorname{Re}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-i\operatorname{Im}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-\operatorname{Im}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right) \\
&  =\operatorname{Re}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
-\operatorname{Im}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right)  -i\left(
\operatorname{Re}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  \right)
+\operatorname{Im}\left(  \mathcal{R}_{ee}\left(  A\right)  \right)
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  \right)  \right) \\
&  =\left(  \overset{}{\operatorname{Re}\left(  \mathcal{R}_{ee}\left(
A\right)  \right)  -i\operatorname{Im}\left(  \mathcal{R}_{ee}\left(
A\right)  \right)  }\right)  \operatorname{Re}\left(  \mathcal{R}_{e}\left(
v\right)  \right)  -\left(  \overset{}{\operatorname{Im}\left(  \mathcal{R}%
_{ee}\left(  A\right)  \right)  +i\operatorname{Re}\left(  \mathcal{R}%
_{ee}\left(  A\right)  \right)  }\right)  \operatorname{Im}\left(
\mathcal{R}_{e}\left(  v\right)  \right)
\end{align}


\item
\begin{align}
\left(  -i\mathbb{I}_{n}\right)  \left(  -ie_{1}\right)   &  =\left(
-i\mathbb{I}_{n}\right)  \left(  \sigma_{e}\left(  ie_{1}\right)  \right)
=-e_{1}\\
\left(  -i\mathbb{I}_{n}\right)  \left(  ie_{1}\right)   &  =\left(
-i\mathbb{I}_{n}\right)  \left(  \sigma_{ie}\left(  ie_{1}\right)  \right)
=e_{1}\\
\left(  i\mathbb{I}_{n}\right)  \left(  \sigma_{e}\left(  ie_{1}\right)
\right)   &  =-e_{1}\\
\left(  i\mathbb{I}_{n}\right)  \left(  \sigma_{ie}\left(  ie_{1}\right)
\right)   &  =e_{1}%
\end{align}

\end{enumerate}

\begin{lemma}
$\mathcal{\sigma}_{f}A\mathcal{\sigma}_{e}$ is basis independent i.e.
\begin{equation}
\mathcal{\sigma}_{f_{1}}A\mathcal{\sigma}_{e_{1}}=\mathcal{\sigma}_{f_{2}%
}A\mathcal{\sigma}_{e_{2}},
\end{equation}
i.e.%
\begin{equation}
\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}}f_{1j}\overline{\mathcal{R}%
_{e_{1}e_{1}}\left(  A\right)  _{jk}}\mathcal{R}_{e_{1}}\left(  v\right)
_{k}=\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}}f_{2j}\overline
{\mathcal{R}_{e_{2}e_{2}}\left(  A\right)  _{jk}}\mathcal{R}_{e_{2}}\left(
v\right)  _{k}.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
w^{\prime}=Tv^{\prime}=\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}%
}f_{1j}\mathcal{R}_{e_{1}e_{1}}\left(  T\right)  _{jk}\mathcal{R}_{e_{1}%
}\left(  v^{\prime}\right)  _{k}=\sum_{\substack{1\leq j\leq n\\1\leq k\leq
m}}f_{2j}\mathcal{R}_{e_{2}e_{2}}\left(  T\right)  _{jk}\mathcal{R}_{e_{2}%
}\left(  v^{\prime}\right)  _{k}.
\end{equation}

\end{proof}
\end{enumerate}
\end{remark}

\begin{definition}
The conjugation $\mathcal{K}_{e}^{d}\in\mathcal{B}_{anti}\left(  V^{d}\right)
$ defines a dual conjugation $\mathcal{K}_{e}\in\mathcal{B}_{anti}\left(
V\right)  $%
\begin{equation}
\mathcal{K}_{e}:V\rightarrow V
\end{equation}
by%
\begin{equation}
f\left(  \mathcal{K}_{e}\left(  v\right)  \right)  =\left[  \mathcal{K}%
_{e}^{d}\left(  f\right)  \right]  \left(  v\right)  ,\quad\forall\quad f\in
V^{d},\quad v\in V.
\end{equation}

\end{definition}

\begin{definition}
The conjugation $\mathcal{\sigma}_{e}$ $\in\mathcal{B}_{anti}\left(  V\right)
$ defines a dual conjugation $\mathcal{\sigma}_{e}^{d}\in\mathcal{B}%
_{anti}\left(  V^{d}\right)  $%
\begin{equation}
\mathcal{\sigma}_{e}^{d}:V^{d}\rightarrow V^{d}%
\end{equation}
by%
\begin{equation}
\left[  \mathcal{\sigma}_{e}^{d}\left(  f\right)  \right]  \left(  v\right)
=f\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)  ,\quad\forall
\quad\ v\in V,\quad f\in V^{d}.
\end{equation}

\end{definition}

\begin{remark}
Each conjugation $\mathcal{\sigma}_{e}$ $\in\mathcal{B}_{anti}\left(
V\right)  $ is associated with a class of bases $\left[  \boldsymbol{e}%
\right]  $.
\end{remark}

\begin{remark}
The conjugations $\mathcal{\sigma}_{e}^{d}$ and $\mathcal{K}_{e}^{d}$ are
different i.e.

\begin{enumerate}
\item
\begin{equation}
\left[  \mathcal{\sigma}_{e}^{d}\left(  f\right)  \right]  \left(  v\right)
=f\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)  =\sum_{1\leq j\leq
n}\mathcal{R}_{e^{d}}\left(  f\right)  _{j}\overline{\mathcal{R}_{e}\left(
v\right)  _{j}}.
\end{equation}


\item
\begin{equation}
\left[  \mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(  v\right)
=f\left(  \mathcal{K}_{e}\left(  v\right)  \right)  =\sum_{1\leq j\leq
n}\overline{\mathcal{R}_{e^{d}}\left(  f\right)  _{j}}\mathcal{R}_{e}\left(
v\right)  _{j}.
\end{equation}


\item
\begin{equation}
\mathcal{K}_{e}^{d}\left(  f\right)  \left(  \mathcal{\sigma}_{e}\left(
v\right)  \right)  =\left[  \left[  \mathcal{K}_{e}^{d}\mathcal{\sigma}%
_{e}\right]  \left(  f\right)  \right]  \left(  v\right)  =\overline{f\left(
v\right)  }=\sum_{1\leq j\leq n}\overline{\mathcal{R}_{e^{d}}\left(  f\right)
_{j}}\overline{\mathcal{R}_{e}\left(  v\right)  _{j}}.
\end{equation}


\item
\begin{equation}
f\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)  =\left[
\mathcal{\sigma}_{e}\left(  f\right)  \right]  \left(  v\right)
=\overline{\left[  \mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(
v\right)  }=\overline{f\left(  \mathcal{K}_{e}\left(  v\right)  \right)  }.
\end{equation}

\end{enumerate}
\end{remark}

\begin{definition}
The operation producing the complex conjugate $\overline{f\left(  v\right)  }$
of the value $f\left(  v\right)  $ of a linear functional $f$ is produced by
the antilinear map
\begin{equation}
\mathcal{C}:V^{d}\rightarrow V^{d}%
\end{equation}
given by the composition
\begin{equation}
\mathcal{C}=\mathcal{K}_{e}^{d}\circ\mathcal{\sigma}_{e}^{d}.
\end{equation}


\begin{remark}
\begin{enumerate}
\item
\begin{equation}
\mathcal{C}\left(  f\right)  =\left[  \mathcal{K}_{e}^{d}\circ\mathcal{\sigma
}_{e}^{d}\right]  \left(  f\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{C\in B}_{anti00}\left(  V^{d}\right)  .
\end{equation}


\item
\begin{equation}
\mathcal{C}\left(  f\right)  =\left[  \mathcal{K}_{e}^{d}\circ\mathcal{\sigma
}_{e}^{d}\right]  \left(  f\right)  =\left[  \mathcal{K}_{e}^{d}f\right]
\circ\mathcal{\sigma}_{e},
\end{equation}
where

\item
\begin{enumerate}
\item
\begin{equation}
\left[  \mathcal{K}_{e}^{d}\circ\mathcal{\sigma}_{e}^{d}\right]
:V^{d}\rightarrow V^{d}.
\end{equation}


\item
\begin{equation}
\mathcal{K}_{e}^{d}\circ f\circ\mathcal{\sigma}_{e}=\mathcal{K}_{e}^{d}%
\circ\mathcal{\sigma}_{e}^{d}\circ f=\left[  \mathcal{K}_{e}^{d}%
\circ\mathcal{\sigma}_{e}^{d}\right]  \left(  f\right)  ,\quad\forall\quad
f\in V^{d}.
\end{equation}


\item
\begin{equation}
\left[  \left[  \mathcal{K}_{e}^{d}\circ\mathcal{\sigma}_{e}^{d}\right]
\left(  f\right)  \right]  \left(  v\right)  =\overline{f\left(  v\right)
}\in\mathbb{C}.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}
\end{definition}

\begin{lemma}
$\mathcal{C}$ is basis independent.
\end{lemma}

\begin{remark}
$\mathcal{K}_{e}^{d}$ and $\mathcal{\sigma}_{e}^{d}$ are antilinear isomorphisms.
\end{remark}

\begin{example}
\begin{enumerate}
\item Let $v\in V$ then%
\begin{equation}
v=\sum_{1\leq j\leq n}e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}%
\end{equation}


\item The action of the conjugation $\mathcal{\sigma}_{e}\in\mathcal{B}%
_{anti}\left(  V\right)  $ is given by
\begin{equation}
\mathcal{\sigma}_{e}\left(  v\right)  =\sum_{1\leq j\leq n}e_{j}%
\mathcal{R}_{e}\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)
_{j}=\sum_{1\leq j\leq n}e_{j}\overline{\mathcal{R}_{e}\left(  v\right)  }_{j}%
\end{equation}


\item
\begin{gather}
f\left(  v\right)  =\sum_{1\leq j,k\leq n}\mathcal{R}_{e^{d}}\left(  f\right)
_{j}\mathcal{R}_{e}\left(  v\right)  _{k}e_{j}^{d}\left(  e_{k}\right)
=\sum_{1\leq j\leq n}\mathcal{R}_{e^{d}}\left(  f\right)  _{j}\mathcal{R}%
_{e}\left(  v\right)  _{j}\\
\Downarrow\\
f\left(  e_{k}\right)  =\mathcal{R}_{e^{d}}\left(  f\right)  _{k}.
\end{gather}


\item
\begin{gather}
\left[  \mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(  v\right)
=\sum_{1\leq j\leq n}\overline{\mathcal{R}_{e^{d}}\left(  f\right)  _{j}%
}\mathcal{R}_{e}\left(  v\right)  _{j}\\
\Downarrow\\
\left[  \mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(  e_{k}\right)
=\mathcal{R}_{e^{d}}\left(  \mathcal{K}_{e}^{d}\left(  f\right)  \right)
_{k}=\overline{\mathcal{R}_{e^{d}}\left(  f\right)  }_{k}.
\end{gather}


\begin{enumerate}
\item
\begin{equation}
\mathcal{K}_{e}^{d}\left(  f\right)  =\sum_{1\leq j\leq n}e_{bj}%
\mathcal{R}_{e^{d}}\left(  \mathcal{K}_{e}^{d}\left(  f\right)  \right)  _{j}.
\end{equation}


\item
\begin{equation}
\mathcal{\sigma}_{e}\left(  v\right)  =\sum_{1\leq j\leq n}e_{j}%
\mathcal{R}_{e}\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)  _{j}.
\end{equation}

\end{enumerate}

\item
\begin{equation}
\left[  \mathcal{C}^{d}\left(  f\right)  \right]  \left(  v\right)  =\left[
\mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(  \mathcal{\sigma}%
_{e}\left(  v\right)  \right)  =\sum_{1\leq j\leq n}\mathcal{R}_{e^{d}}\left(
\mathcal{K}_{e}^{d}\left(  f\right)  \right)  _{j}\mathcal{R}_{e}\left(
\mathcal{\sigma}_{e}\left(  v\right)  \right)  _{j}=\overline{f\left(
v\right)  }.
\end{equation}


\item
\begin{gather}
f^{d}\left(  v\right) \\
\parallel\\
\sum_{1\leq j\leq n}\mathcal{R}_{e^{d}}\left(  f\right)  _{j}\mathcal{R}%
_{e}\left(  v\right)  _{j}=\sum_{1\leq j\leq n}\left(  \operatorname{Re}%
\left(  \mathcal{R}_{e^{d}}\left(  f^{d}\right)  _{j}\right)
+i\operatorname{Im}\left(  \mathcal{R}_{e^{d}}\left(  f^{d}\right)
_{j}\right)  \right)  \left(  \operatorname{Re}\left(  \mathcal{R}_{e}\left(
v\right)  _{j}\right)  +i\operatorname{Im}\left(  \mathcal{R}_{e}\left(
v\right)  _{j}\right)  \right) \\
=\sum_{1\leq j\leq n}\left(  \left(  \operatorname{Re}\left(  \mathcal{R}%
_{e^{d}}\left(  f^{d}\right)  _{j}\right)  \operatorname{Re}\left(
\mathcal{R}_{e}\left(  v\right)  _{j}\right)  -\operatorname{Im}\left(
\mathcal{R}_{e^{d}}\left(  f^{d}\right)  _{j}\right)  \operatorname{Im}\left(
\mathcal{R}_{e}\left(  v\right)  _{j}\right)  \right)  \right. \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\left.  i\left(
\operatorname{Im}\left(  \mathcal{R}_{e^{d}}\left(  f^{d}\right)  _{j}\right)
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}\right)
+\operatorname{Re}\left(  \mathcal{R}_{e^{d}}\left(  f^{d}\right)
_{j}\right)  \operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)
_{j}\right)  \right)  \right)  .
\end{gather}


\item
\begin{gather}
f^{d}\left(  v\right) \\
\parallel\\
\sum_{1\leq j\leq n}\mathcal{R}_{e^{d}}\left(  f\right)  _{j}\mathcal{R}%
_{e}\left(  v\right)  _{j}=\sum_{1\leq j\leq n}\left(  \left(  \mathcal{R}%
_{e^{d}}\left(  \operatorname{Re}_{e^{d}}\left(  f^{d}\right)  \right)
_{j}\right)  +i\left(  \mathcal{R}_{e^{d}}\left(  \operatorname{Im}_{e^{d}%
}\left(  f^{d}\right)  \right)  _{j}\right)  \right)  \left(  \left(
\mathcal{R}_{e}\left(  \operatorname{Re}_{e}\left(  v\right)  \right)
_{j}\right)  +i\left(  \mathcal{R}_{e}\left(  \operatorname{Im}_{e}\left(
v\right)  \right)  _{j}\right)  \right) \\
=\sum_{1\leq j\leq n}\left\{  \mathcal{R}_{e^{d}}\left(  \operatorname{Re}%
_{e^{d}}\left(  f^{d}\right)  \right)  _{j}\mathcal{R}_{e}\left(
\operatorname{Re}_{e}\left(  v\right)  \right)  _{j}-\mathcal{R}_{e^{d}%
}\left(  \operatorname{Im}_{e^{d}}\left(  f^{d}\right)  \right)
_{j}\mathcal{R}_{e}\left(  \operatorname{Im}_{e}\left(  v\right)  \right)
_{j}\right. \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+i\left.  \left(
\mathcal{R}_{e^{d}}\left(  \operatorname{Im}_{e^{d}}\left(  f^{d}\right)
\right)  _{j}\mathcal{R}_{e}\left(  \operatorname{Re}_{e}\left(  v\right)
\right)  _{j}+\mathcal{R}_{e^{d}}\left(  \operatorname{Re}_{e^{d}}\left(
f^{d}\right)  \right)  _{j}\mathcal{R}_{e}\left(  \operatorname{Im}_{e}\left(
v\right)  \right)  _{j}\right)  \right\} \\
\parallel\\
\mathcal{R}_{e^{d}}\left(  \operatorname{Re}_{e^{d}}\left(  f^{d}\right)
\right)  \cdot\mathcal{R}_{e}\left(  \operatorname{Re}_{e}\left(  v\right)
\right)  -\mathcal{R}_{e^{d}}\left(  \operatorname{Im}_{e^{d}}\left(
f^{d}\right)  \right)  \cdot\mathcal{R}_{e}\left(  \operatorname{Im}%
_{e}\left(  v\right)  \right)  \qquad\qquad\qquad\\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+i\left(  \mathcal{R}%
_{e^{d}}\left(  \operatorname{Im}_{e^{d}}\left(  f^{d}\right)  \right)
\cdot\mathcal{R}_{e}\left(  \operatorname{Re}_{e}\left(  v\right)  \right)
+\mathcal{R}_{e^{d}}\left(  \operatorname{Re}_{e^{d}}\left(  f^{d}\right)
\right)  \cdot\mathcal{R}_{e}\left(  \operatorname{Im}_{e}\left(  v\right)
\right)  \right)  .
\end{gather}


\begin{remark}
The preceding expression is basis independent.
\end{remark}

\item
\begin{gather}
\left[  \left[  \mathcal{K}_{e}^{d}\mathcal{\sigma}_{e}\right]  \left(
f\right)  \right]  \left(  v\right)  =\overline{f\left(  v\right)  }\\
\parallel\\
\sum_{1\leq j\leq n}\overline{\mathcal{R}_{e^{d}}\left(  f\right)
_{j}\mathcal{R}_{e}\left(  v\right)  _{j}}=\sum_{1\leq j\leq n}\left(
\operatorname{Re}\left(  \mathcal{R}_{e^{d}}\left(  f\right)  _{j}\right)
-i\operatorname{Im}\left(  \mathcal{R}_{e^{d}}\left(  f\right)  _{j}\right)
\right)  \left(  \operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)
_{j}\right)  -i\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)
_{j}\right)  \right) \\
=\sum_{1\leq j\leq n}\left(  \left(  \operatorname{Re}\left(  \mathcal{R}%
_{e^{d}}\left(  f\right)  _{j}\right)  \operatorname{Re}\left(  \mathcal{R}%
_{e}\left(  v\right)  _{j}\right)  -\operatorname{Im}\left(  \mathcal{R}%
_{e^{d}}\left(  f\right)  _{j}\right)  \operatorname{Im}\left(  \mathcal{R}%
_{e}\left(  v\right)  _{j}\right)  \right)  \right. \\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad-\left.  i\left(
\operatorname{Im}\left(  \mathcal{R}_{e^{d}}\left(  f\right)  _{j}\right)
\operatorname{Re}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}\right)
+\operatorname{Re}\left(  \mathcal{R}_{e^{d}}\left(  f\right)  _{j}\right)
\operatorname{Im}\left(  \mathcal{R}_{e}\left(  v\right)  _{j}\right)
\right)  \right)  .
\end{gather}


\item
\begin{equation}
\left[  \mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(  v\right)
=\sum_{1\leq j\leq n}\mathcal{R}_{e^{d}}\left(  \mathcal{K}_{e}^{d}\left(
f\right)  \right)  _{j}\mathcal{R}_{e}\left(  v\right)  _{j}.
\end{equation}


\item
\begin{equation}
\left[  \mathcal{K}_{e}^{d}\left(  f\right)  \right]  \left(  e_{k}\right)
=\overline{\mathcal{R}_{e}\left(  f\right)  }_{k}=\mathcal{R}_{e^{d}}\left(
\mathcal{K}_{e}^{d}\left(  f\right)  \right)  _{k}.
\end{equation}

\end{enumerate}
\end{example}

\paragraph{Linear Transformations}

\begin{itemize}
\item Consider complex vector spaces $V$ and $W$ that have dimensions
\begin{align}
\dim\left\{  V\right\}   &  =n\\
\dim\left\{  W\right\}   &  =m\nonumber
\end{align}
and bases
\begin{equation}
\left\{  \left.  e_{j}\right\vert 1\leq j\leq n\right\}  \text{ and }\left\{
\left.  f_{j}\right\vert 1\leq j\leq m\right\}  .
\end{equation}


\item Consider linear transformations
\end{itemize}

%

\begin{align}
A  &  \in\mathcal{B}\left(  W,V\right) \\
A  &  :V\rightarrow W,\nonumber
\end{align}
where the dual linear transformations%
\begin{align}
A^{d}  &  \in\mathcal{B}\left(  V^{d},W^{d}\right) \\
A^{d}  &  :W^{d}\rightarrow V^{d},
\end{align}
act in the dual spaces $V^{d}$ and $W^{d}$ that have dimensions
\begin{align}
\dim\left\{  V^{d}\right\}   &  =n\\
\dim\left\{  W^{d}\right\}   &  =m\nonumber
\end{align}
and dual bases
\begin{equation}
\left\{  \left.  e_{bj}\right\vert 1\leq j\leq n\right\}  \text{ and }\left\{
\left.  f_{j}^{d}\right\vert 1\leq j\leq m\right\}  .
\end{equation}


\begin{remark}
If $W\neq V$ then $\mathcal{B}\left(  W,V\right)  $ \emph{is not an algebra!
This can easily be seen by letting }$A_{1},A_{2}\in\mathcal{B}\left(
W,V\right)  $
\begin{equation}
A_{1}v\in W
\end{equation}
showing that
\begin{equation}
A_{2}\left(  A_{1}v\right)
\end{equation}
is not defined.
\end{remark}

\begin{remark}
It is possible to construct \emph{algebras} $\mathcal{B}\left(  V\right)  $
where
\begin{equation}
V=%
%TCIMACRO{\dbigoplus \limits_{1\leq n\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{1\leq n\leq r}}
%EndExpansion
V_{n}%
\end{equation}
and $A_{k}\in\mathcal{B}\left(  V_{k+1},V_{k}\right)  $ i.e.
\begin{equation}
A_{k}:V_{k}\rightarrow V_{k+1},\quad1\leq k\leq n-1.
\end{equation}

\end{remark}

\begin{definition}
The dual transformation $A^{d}\in\mathcal{B}\left(  V^{d},W^{d}\right)  $ of
$A\in\mathcal{B}\left(  W,V\right)  $ is defined by
\end{definition}

\begin{lemma}%
\begin{equation}
\left[  A^{d}w^{d}\right]  \left(  v\right)  =w^{d}\left(  Av\right)
=w^{d}\left(  Av\right)  ,\quad\forall v\in V.
\end{equation}

\end{lemma}

\begin{lemma}
The dual transformation $A^{d}$ of $A$ is given by

\begin{enumerate}
\item
\begin{equation}
\left(  A^{d}f_{j}^{d}\right)  \left(  e_{k}\right)  =f_{j}^{d}\left(
Ae_{k}\right)  ,\,1\leq j\leq m,1\leq k\leq n.
\end{equation}


\item
\begin{equation}
A^{d}f_{j}^{d}=\sum_{1\leq l\leq n}e_{l}^{d}\mathcal{R}_{e^{d}e^{d}}\left(
A^{d}\right)  _{lj}=\sum_{1\leq l\leq n}f_{l}^{d}\mathcal{R}_{f^{d}f^{d}%
}\left(  A^{d}\right)  _{lj}.
\end{equation}


\item
\begin{equation}
Ae_{k}=\sum_{1\leq l\leq m}f_{l}\mathcal{R}_{ff}\left(  A\right)  _{lj}%
=\sum_{1\leq l\leq m}e_{l}\mathcal{R}_{ee}\left(  A\right)  _{lj}.
\end{equation}

\end{enumerate}
\end{lemma}

\begin{corollary}%
\begin{equation}
\left(  A^{d}f_{j}^{d}\right)  \left(  e_{k}\right)  =\sum_{1\leq l\leq
m}e_{l}^{d}\left(  e_{k}\right)  \mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)
_{lj}=\mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)  _{kj}=f_{j}^{d}\left(
Ae_{k}\right)  =\sum_{1\leq l\leq n}f_{j}^{d}\left(  f_{l}\right)
\mathcal{R}_{ff}\left(  A\right)  _{lk}=\mathcal{R}_{ff}\left(  A\right)
_{jk},
\end{equation}
i.e.%
\begin{equation}
\mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)  =\mathcal{R}_{ff}\left(
A\right)  ^{d}.
\end{equation}

\end{corollary}

\begin{remark}
It is convenient to consider $W$ and $V$ to be normed spaces with norms
$\left\Vert {}\right\Vert _{V}$ and $\left\Vert {}\right\Vert _{W}$, if they
are complete wrt these norms they are \emph{Banach} spaces.
\end{remark}

\subparagraph{In the Following Let $V=W.$}

\begin{definition}
Bases of $V$ and $V^{d}$ are dual if they are biorthogonal i.e.
\begin{equation}
e_{bj}\left(  e_{k}\right)  =\delta_{jk},\quad1\leq j,k\leq r.
\end{equation}

\end{definition}

\begin{lemma}
The dual basis $\left\{  \left.  e_{bj}\right\vert 1\leq j\leq r\right\}  $ is
uniquely defined by the basis $\left\{  \left.  e_{j}\right\vert 1\leq j\leq
r\right\}  .$
\end{lemma}

\begin{definition}
Complex linear \emph{injections} $\mathcal{I}_{V_{e}}$ from the complex linear
space $V$ into its dual
\begin{equation}
\mathcal{I}_{V_{e}}:V\rightarrow V^{d}%
\end{equation}
are given by%
\begin{equation}
\mathcal{I}_{V_{e}}\left(  e_{j}\right)  =e_{bj},\quad1\leq j\leq r,
\end{equation}
where $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ is a basis
for $V.$
\end{definition}

\begin{lemma}%
\begin{equation}
\ w^{d}\left(  v\right)  =\left[  \mathcal{I}_{V_{e}}\left(  w\right)
\right]  \left(  v\right)  =v^{d}\left(  \mathcal{I}_{V_{e}}^{d}\left(
w^{d}\right)  \right)  =v^{d}\left(  w\right)  .
\end{equation}

\end{lemma}

\subsection{Tensor Products Spaces of $V.$}

\begin{enumerate}
\item The \emph{full tensor product} ${\Large \otimes}^{2}V=V\otimes V$%
\begin{equation}
V\otimes V=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
e_{j}\otimes e_{k}\right\vert 1\leq j\leq r,1\leq k\leq r\right\}  .
\end{equation}


\item The \emph{symmetric tensor product} ${\huge \vee}^{2}V=V\vee V$%
\begin{equation}
{\huge \vee}^{2}V=\mathcal{S}_{2}\left(  {\Large \otimes}^{2}V\right)  ,
\end{equation}
where
\begin{equation}
v_{1}\vee v_{2}=\frac{1}{2}\left(  v_{1}\otimes v_{2}+v_{2}\otimes
v_{1}\right)
\end{equation}
and $\mathcal{S}$ is the projection operator called the symmetrizer
\begin{equation}
\mathcal{S}_{2}=\frac{1}{2}\sum_{\sigma\in S_{2}}P_{\sigma},
\end{equation}
which is defined in terms of permutation operators
\begin{equation}
P_{\sigma}\left(  v_{1}\otimes v_{2}\right)  =v_{\sigma\left(  1\right)
}\otimes v_{\sigma\left(  2\right)  }%
\end{equation}
Any element of ${\huge \vee}^{2}V$ can be expressed as
\begin{equation}
s=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  s\right)  _{jk}e_{j}\otimes
e_{k},\quad\mathcal{R}_{e}\left(  s\right)  _{jk}=\mathcal{R}_{e}\left(
s\right)  _{kj},\quad1\leq j,k\leq r.
\end{equation}


\item The \emph{antisymmetric tensor product} ${\huge \wedge}^{2}V=V\wedge V$%
\begin{equation}
{\huge \wedge}^{2}V=\mathcal{A}_{2}\left(  {\Large \otimes}^{2}V\right)  ,
\end{equation}
where
\begin{equation}
v_{1}\wedge v_{2}=\frac{1}{2}\left(  v_{1}\otimes v_{2}-v_{2}\otimes
v_{1}\right)
\end{equation}
and $\mathcal{A}_{2}$ is the projection operator called the antisymmetrizer
\begin{equation}
\mathcal{A}_{2}=\frac{1}{2}\sum_{\sigma\in S_{2}}\pi\left(  \sigma\right)
P_{\sigma},
\end{equation}
which is defined in terms of permutation operators $P_{\sigma}$
\begin{equation}
P_{\sigma}\left(  v_{1}\otimes v_{2}\right)  =v_{\sigma\left(  1\right)
}\otimes v_{\sigma\left(  2\right)  }%
\end{equation}
and the parity coefficient $\pi\left(  \sigma\right)  $
\begin{equation}
\pi\left(  \sigma\right)  =\left\{
\begin{array}
[c]{c}%
1\text{ if }\sigma\text{ is even}\\
-1\text{ if }\sigma\text{ is odd}%
\end{array}
\right.  .
\end{equation}
Any element of ${\huge \wedge}^{2}V$ can be expressed as
\begin{equation}
\ g=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  g\right)  _{jk}e_{j}\otimes
e_{k},\quad\mathcal{R}_{e}\left(  \ g\right)  _{jk}=-\mathcal{R}_{e}\left(
g\right)  _{kj},\quad1\leq j,k\leq r.
\end{equation}


\item Decompositions

\begin{enumerate}
\item The projectors $\mathcal{S}_{2}$ and $\mathcal{A}_{2}$ are complimentary
i.e.
\begin{equation}
\mathcal{S}_{2}+\mathcal{A}_{2}=I_{{\Large \otimes}^{2}V}.
\end{equation}


\item The full tensor product $v_{1}\otimes v_{2}$ is the sum of the symmetric
and antisymmetric tensor products i.e.
\begin{equation}
v_{1}\otimes v_{2}=v_{1}\vee v_{2}+v_{1}\wedge v_{2}.
\end{equation}


\item The full tensor product space ${\Large \otimes}^{2}V$ is the sum of the
symmetric and antisymmetric tensor product spaces i.e.%
\begin{equation}
{\Large \otimes}^{2}V={\huge \vee}^{2}V\oplus{\huge \wedge}^{2}V.
\end{equation}

\end{enumerate}

\item \emph{Sesquilinear tensor products} $\mathcal{\sigma}_{e}\left(
V\right)  \otimes V$
\begin{equation}
\mathcal{\sigma}_{e}\left(  V\right)  \otimes V=\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \mathcal{\sigma}_{e}\left(
e_{j}\right)  \otimes e_{k}\right\vert 1\leq j\leq r,1\leq k\leq r\right\}  .
\end{equation}


\item \emph{Sesquilinear symmetric tensor products }$\mathcal{\sigma}%
_{e}\left(  V\right)  \vee V$%
\begin{equation}
\mathcal{\sigma}_{e}\left(  V\right)  \vee V=\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \mathcal{\sigma}_{e}\left(
e_{j}\right)  \vee e_{k}\right\vert 1\leq j\leq k\leq r\right\}
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(
\mathcal{\sigma}_{e}\left(  e_{j}\right)  \otimes e_{k}+e_{k}\otimes
\mathcal{\sigma}_{e}\left(  e_{j}\right)  \right)  \right\vert 1\leq j\leq
k\leq r\right\}  .
\end{equation}


\item \emph{Sesquilinear antisymmetric tensor products} $\mathcal{J}\left(
V\right)  \wedge V$%
\begin{equation}
\mathcal{\sigma}_{e}\left(  V\right)  \wedge V=\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \mathcal{\sigma}_{e}\left(
e_{j}\right)  \wedge e_{k}\right\vert 1\leq j<k\leq r\right\}  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(
\mathcal{\sigma}_{e}\left(  e_{j}\right)  \otimes e_{k}\ -e_{k}\otimes
\mathcal{\sigma}_{e}\left(  e_{j}\right)  \right)  \right\vert 1\leq j<k\leq
r\right\}  .
\end{equation}

\end{enumerate}

\begin{remark}
The dual spaces ${\Large \otimes}^{2}V^{d},{\huge \vee}^{2}V^{d}%
$,${\huge \wedge}^{2}V^{d},\mathcal{K}_{e}^{d}\left(  V^{d}\right)  \otimes
V^{d},\mathcal{K}_{e}^{d}\left(  V^{d}\right)  \vee V^{d}$ and $\mathcal{K}%
_{e}^{d}\left(  V^{d}\right)  \wedge V^{d}$ are defined in anagolous fashions.
\end{remark}

\begin{lemma}
Let $P=P^{2}$ then%
\begin{equation}
\left[  P^{d}w^{d}\right]  \left(  v\right)  =w^{d}\left(  Pv\right)  =\left[
P^{d}w^{d}\right]  \left(  Pv\right)
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left[  P^{d}w^{d}\right]  \left(  Pv\right)  =w^{d}\left(  PPv\right)
=w^{d}\left(  Pv\right)  .
\end{equation}

\end{proof}

\begin{lemma}
Let $P_{1}=P_{1}^{2}$ and $P_{2}=P_{2}^{2}$ then
\begin{align}
\ \left[  w_{1}^{d}\otimes w_{2}^{d}\right]  \left(  \overset{}{\left[
P_{1}\otimes P_{2}\right]  \left(  v_{1}\otimes v_{2}\right)  }\right)   &
=\left[  \left[  P_{1}^{d}\otimes P_{2}^{d}\right]  \left(  \overset{}{w_{1}%
^{d}\otimes w_{2}^{d}}\right)  \right]  \left(  v_{1}\otimes v_{2}\right) \\
&  =\left[  \overset{}{\left[  P_{1}^{d}\otimes P_{2}^{d}\right]  \left(
\overset{}{w_{1}^{d}\otimes w_{2}^{d}}\right)  }\right]  \left(
\overset{}{\left[  P_{1}\otimes P_{2}\right]  \left(  \overset{}{v_{1}\otimes
v_{2}}\right)  }\right)
\end{align}

\end{lemma}

\begin{proof}%
\begin{align}
\ \left[  w_{1}^{d}\otimes w_{2}^{d}\right]  \left(  \left[  P_{1}\otimes
P_{2}\right]  \left(  v_{1}\otimes v_{2}\right)  \right)   &  =w_{1}%
^{d}\left(  P_{1}v_{1}\right)  w_{2}^{d}\left(  P_{2}v_{2}\right) \\
\left[  \left[  P_{1}^{d}\otimes P_{2}^{d}\right]  \left(  w_{1}^{d}\otimes
w_{2}^{d}\right)  \right]  \left(  v_{1}\otimes v_{2}\right)   &  =P_{1}%
^{d}w_{1}^{d}\left(  v_{1}\right)  P_{2}^{d}w_{2}^{d}\left(  v_{2}\right)
=w_{1}^{d}\left(  P_{1}v_{1}\right)  w_{2}^{d}\left(  P_{2}v_{2}\right) \\
\left[  \left[  P_{1}^{d}\otimes P_{2}^{d}\right]  \left(  w_{1}^{d}\otimes
w_{2}^{d}\right)  \right]  \left(  \left[  P_{1}\otimes P_{2}\right]  \left(
v_{1}\otimes v_{2}\right)  \right)   &  =P_{1}^{d}w_{1}^{d}\left(  P_{1}%
v_{1}\right)  P_{2}^{d}w_{2}^{d}\left(  P_{2}v_{2}\right)  =w_{1}^{d}\left(
P_{1}v_{1}\right)  w_{2}^{d}\left(  P_{2}v_{2}\right)  .
\end{align}

\end{proof}

\begin{lemma}
Let $P_{12}=P_{12}^{2}$ then
\begin{equation}
\ \left[  w_{1}^{d}\otimes w_{2}^{d}\right]  \left(  P_{12}\left(
v_{1}\otimes v_{2}\right)  \right)  =\left[  P_{12}^{d}\left(  w_{1}%
^{d}\otimes w_{2}^{d}\right)  \right]  \left(  v_{1}\otimes v_{2}\right)
=\left[  P_{12}^{d}\left(  w_{1}^{d}\otimes w_{2}^{d}\right)  \right]  \left(
P_{12}\left(  v_{1}\otimes v_{2}\right)  \right)  .
\end{equation}

\end{lemma}

\begin{remark}
The tensor product of dual vector spaces $V^{d}$ and $W^{d}$ define bilinear
functionals on the vevctor spaces $V$ and $W$ by
\begin{equation}
\left(  e_{bj}\otimes f_{k}^{d}\right)  \left(  v,w\right)  =\left(
e_{bj}\otimes f_{k}^{d}\right)  \left(  v\otimes w\right)  =e_{bj}\left(
v\right)  f_{k}^{d}\left(  w\right)
\end{equation}
and
\begin{gather}
\left(  e_{bj}\otimes f_{k}^{d}\right)  \left(  c_{1}v_{1}+c_{2}v_{2}%
,d_{1}w_{1}+d_{2}w_{2}\right) \\
\parallel\\
c_{1}d_{1}\left(  e_{bj}\otimes f_{k}^{d}\right)  \left(  v_{1},w_{1}\right)
+c_{1}d_{2}\left(  e_{bj}\otimes f_{k}^{d}\right)  \left(  v_{1},w_{2}\right)
+c_{2}d_{1}\left(  e_{bj}\otimes f_{k}^{d}\right)  \left(  v_{2},w_{1}\right)
+c_{2}d_{2}\left(  e_{bj}\otimes f_{k}^{d}\right)  \left(  v_{2},w_{2}\right)
,\forall v_{1},v_{2}\in V,\forall w_{1},w_{2}\in W.
\end{gather}

\end{remark}

\subsection{Bilinear Functionals in $W\times V\ $ and Dual Linear Functionals
belonging to $W^{d}\otimes V^{d}.$}

In general let $b^{d}\in W^{d}\otimes V^{d}$ then it can be expanded wrt
\begin{equation}
b^{d}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\mathcal{R}_{f^{d}e^{d}%
}\left(  b\right)  _{jk}\left(  f_{j}^{d}\otimes e_{k}^{d}\right)
\end{equation}
then \emph{by definition} it corresponds to the bilinear functional
$\mathfrak{b}\in\mathfrak{B}\left(  W,V\right)  $
\begin{equation}
\mathfrak{b}\left(  w,v\right)  =b^{d}\left(  w\otimes v\right)  ,\quad v\in
V,w\in W,
\end{equation}
which produces the \emph{basis independent} expression%

\begin{equation}
\mathfrak{b}\left(  w,v\right)  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\mathcal{R}_{f}\left(  w\right)  _{j}\mathcal{R}_{f^{d}e^{d}}\left(
b^{d}\right)  _{jk}\mathcal{R}_{e}\left(  v\right)  _{k}.
\end{equation}


\begin{theorem}
\label{GreuB} Greu${\large \beta}${\large : }Canonical expansions of tensor products

\begin{enumerate}
\item
\begin{equation}
b_{W^{d}V^{d}}\in W^{d}\otimes V^{d}=\sum_{1\leq j\leq p\leq\min\left(
m,n\right)  }\alpha_{j}^{d}\otimes\beta_{j}^{d},\quad\alpha_{j}^{d}\in
W^{d},\,\beta_{j}^{d}\in V^{d},\,1\leq j\leq p\leq\min\left(  m,n\right)
\end{equation}


\item
\begin{equation}
b_{WV}\in W\otimes V=\sum_{1\leq j\leq p\leq\min\left(  m,n\right)  }%
\alpha_{j}\otimes\beta_{j},\quad\alpha_{j}\in W,\,\beta_{j}\in V,\,1\leq j\leq
p\leq\min\left(  m,n\right)
\end{equation}


\item
\begin{equation}
b_{WV^{d}}\in W\otimes V^{d}=\sum_{1\leq j\leq p\leq\min\left(  m,n\right)
}\alpha_{j}\otimes\beta_{j}^{d},\quad\alpha_{j}\in W,\,\beta_{j}\in
V^{d},\,1\leq j\leq p\leq\min\left(  m,n\right)
\end{equation}


\item
\begin{equation}
b_{W^{d}V}\in W^{d}\otimes V=\sum_{1\leq j\leq p\leq\min\left(  m,n\right)
}\alpha_{j}^{d}\otimes\beta_{j},\quad\alpha_{j}\in W^{d},\,\beta_{j}\in
V,\,1\leq j\leq p\leq\min\left(  m,n\right)  .
\end{equation}

\end{enumerate}
\end{theorem}

\begin{proof}
See Greubs book.
\end{proof}

\begin{remark}


\begin{enumerate}
\item
\begin{equation}
b_{W^{d}V^{d}}\in\left(  W\otimes V\right)  ^{d}%
\end{equation}


\item
\begin{equation}
b_{WV}\in\left(  W^{d}\otimes V^{d}\right)  ^{d}%
\end{equation}


\item
\begin{equation}
b_{WV^{d}}\in\left(  W^{d}\otimes V\right)  ^{d}%
\end{equation}


\item
\begin{equation}
b_{W^{d}V}\in\left(  W\otimes V^{d}\right)  ^{d}%
\end{equation}

\end{enumerate}
\end{remark}

\begin{definition}
The bilinear form $b\in T^{d}$ is positive if
\begin{equation}
b\left(  v\otimes v\right)  =b\left(  v,v\right)  \geq0
\end{equation}
and positive definite if
\begin{equation}
b\left(  v\otimes v\right)  =b\left(  v,v\right)  >0.
\end{equation}
where $v\otimes v\in T$. 
\end{definition}

\begin{definition}
Operator Valued Maps:

\begin{enumerate}
\item Operator valued map $\Xi_{WV}$ from the tensor product space $W\otimes
V$ to $\mathcal{B}_{00}\left(  W,V\right)  $
\begin{equation}
\Xi_{WV}:W\otimes V\rightarrow\mathcal{B}_{00}\left(  W,V\right)
\end{equation}
by%
\begin{equation}
\Xi_{WV}\left(  b_{WV}\right)  =\sum_{1\leq j,k\leq m}\left[  e_{j}e_{k}%
^{d}\right]  \mathcal{R}_{ee}\left(  \Xi_{WV}\left(  b_{WV}\right)  \right)
_{jk}.
\end{equation}


\item Operator valued map $\Xi_{WV^{d}}$ from the tensor product space
$W\otimes V^{d}$ to $\mathcal{B}_{00}\left(  W,V\right)  $%
\begin{equation}
\Xi_{WV^{d}}:W\otimes V^{d}\rightarrow\mathcal{B}_{00}\left(  W,V\right)
\end{equation}
by%
\begin{equation}
\Xi_{WV^{d}}\left(  b_{WV^{d}}\right)  =\sum_{1\leq j,k\leq m}\left[
e_{j}e_{k}^{d}\right]  \mathcal{R}_{ee}\left(  \Xi_{WV^{d}}\left(  b_{WV^{d}%
}\right)  \right)  _{jk}.
\end{equation}


\item Operator valued map $\Xi_{W^{d}V}$ from the tensor product space
$W^{d}\otimes V$ to $\mathcal{B}_{00}\left(  W,V\right)  $%
\begin{equation}
\Xi_{W^{d}V}:W^{d}\otimes V\rightarrow\mathcal{B}_{00}\left(  W,V\right)
\end{equation}
by%
\begin{equation}
\Xi_{W^{d}V}\left(  b_{W^{d}V}\right)  =\sum_{1\leq j,k\leq m}\left[
e_{j}e_{k}^{d}\right]  \mathcal{R}_{ee}\left(  \Xi_{W^{d}V}\left(  b_{W^{d}%
V}\right)  \right)  _{jk}.
\end{equation}


\item Operator valued map $\Xi_{W^{d}V^{d}}$ from the tensor product space
$W^{d}\otimes V^{d}$ to $\mathcal{B}_{00}\left(  W,V\right)  $%
\begin{equation}
\Xi_{W^{d}V^{d}}:W^{d}\otimes V^{d}\rightarrow\mathcal{B}_{00}\left(
W,V\right)
\end{equation}
by%
\begin{equation}
\Xi_{W^{d}V^{d}}\left(  b_{W^{d}V^{d}}\right)  =\sum_{1\leq j,k\leq m}\left[
e_{j}e_{k}^{d}\right]  \mathcal{R}_{ee}\left(  \Xi_{W^{d}V^{d}}\left(
b_{W^{d}V^{d}}\right)  \right)  _{jk}.
\end{equation}


\item
\begin{equation}
V=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  v_{j}\right\vert
1\leq j\leq n\right\}
\end{equation}
thus
\begin{equation}
v=\left(
\begin{array}
[c]{ccc}%
v_{1} & \cdots & v_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{v}\left(  v\right)  _{1}\\
\vdots\\
\mathcal{R}_{v}\left(  v\right)  _{n}%
\end{array}
\right)  =\left(  \mathbf{v}\right)  \mathcal{R}_{v}\left(  v\right)  .
\end{equation}


\item
\begin{equation}
W=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  w_{j}\right\vert
1\leq j\leq m\right\}
\end{equation}
thus
\begin{equation}
w=\left(
\begin{array}
[c]{ccc}%
w_{1} & \cdots & w_{m}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{w}\left(  w\right)  _{1}\\
\vdots\\
\mathcal{R}_{w}\left(  w\right)  _{m}%
\end{array}
\right)  =\left(  \mathbf{w}\right)  \mathcal{R}_{w}\left(  w\right)  .
\end{equation}


\item
\begin{gather}
\Xi_{WV}\left(  \left(
\begin{array}
[c]{ccc}%
w_{1} & \cdots & w_{m}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{ccc}%
v_{1} & \cdots & v_{n}%
\end{array}
\right)  \right)  =\Xi_{WV}\left(  \left(
\begin{array}
[c]{ccc}%
w_{1}\otimes\left(
\begin{array}
[c]{ccc}%
v_{1} & \cdots & v_{n}%
\end{array}
\right)  & \cdots & w_{m}\otimes\left(
\begin{array}
[c]{ccc}%
v_{1} & \cdots & v_{n}%
\end{array}
\right)
\end{array}
\right)  \right) \\
=\Xi_{WV}\left(  \left(
\begin{array}
[c]{ccccccc}%
w_{1}\otimes v_{1} & \cdots & w_{1}\otimes v_{n} & \cdots & w_{m}\otimes v_{1}
& \cdots & w_{m}\otimes v_{n}%
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{ccccccc}%
\left[  w_{1}v_{1}^{d}\right]  & \cdots & \left[  w_{1}v_{n}^{d}\right]  &
\cdots & \left[  w_{m}v_{1}^{d}\right]  & \cdots & \left[  w_{m}v_{n}%
^{d}\right]
\end{array}
\right) \\
=\left(  \left[  \mathbf{wv}^{d}\right]  \right)  =\left(  \left[  \left(
\mathbf{w}\right)  \left(  \mathbf{v}^{d}\right)  \right]  \right)  =\left(
\left[  \left(  \mathbf{w}\right)  \left(  \mathbf{v}^{d}\right)  \right]
\right)
\end{gather}
giving for $b\in\mathcal{B}_{00}\left(  W,V\right)  $%
\begin{equation}
b=\left[  b\right]  =\left(  \left[  \mathbf{wv}^{d}\right]  \right)
\mathcal{R}_{wv}\left(  b\right)  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\left[  w_{j}v_{k}^{d}\right]  \mathcal{R}_{wv}\left(  b\right)
_{jk}=\left(
\begin{array}
[c]{ccc}%
w_{1} & \cdots & w_{m}%
\end{array}
\right)  \mathcal{R}_{wv}\left(  b\right)  \left(
\begin{array}
[c]{c}%
v_{1}^{d}\\
\vdots\\
v_{m}^{d}%
\end{array}
\right)  =\left(  \mathbf{w}\right)  \mathcal{R}_{wv}\left(  b\right)  \left(
\mathbf{v}\right)  ^{t}.
\end{equation}


\item
\begin{equation}
b=\left[  b\right]  =\left(  \left[  \mathbf{wv}^{d}\right]  \right)
\mathcal{R}_{wv}\left(  b\right)  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\left[  w_{j}v_{k}^{d}\right]  \mathcal{R}_{wv}\left(  b\right)
_{jk}=\left(
\begin{array}
[c]{ccc}%
w_{1} & \cdots & w_{m}%
\end{array}
\right)  \mathcal{R}_{wv}\left(  b\right)  \left(
\begin{array}
[c]{c}%
v_{1}^{d}\\
\vdots\\
v_{m}^{d}%
\end{array}
\right)  =\left(  \mathbf{w}\right)  \mathcal{R}_{wv}\left(  b\right)  \left(
\mathbf{v}\right)  ^{t}.
\end{equation}

\end{enumerate}
\end{definition}

\begin{definition}
Of the product "$\#$"
\begin{align}
x\#y^{d}  &  \in\mathcal{B}\left(  W,V\right) \\
\left(  x\#y^{d}\right)  \left(  v\right)   &  =y^{d}\left(  v\right)
x\quad\forall v\in V,\,\,x\in W,\,y^{d}\in V^{d}.
\end{align}

\end{definition}

\begin{remark}%
\begin{align}
W\otimes V  &  \hookrightarrow W^{d}\otimes V\\
W\otimes V  &  \hookrightarrow W\otimes V^{d}\\
W\otimes V  &  \hookrightarrow W^{d}\otimes V^{d},
\end{align}
where "$\hookrightarrow"$ denotes injection.
\end{remark}

Each $b^{d}\in W^{d}\otimes V^{d}$ can be expanded as
\begin{equation}
b^{d}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(  f_{j}^{d}\otimes
e_{k}^{d}\right)  \mathcal{R}_{f^{d}e^{d}}\left(  b^{d}\right)  _{jk}%
\end{equation}
and corresponds to a linear map $\left[  b\right]  \in\mathcal{B}_{00}\left(
V,W\right)  $, where $\left[  b\right]  :V\rightarrow W$ is given by
\begin{equation}
\left[  b\right]  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
f_{j}e_{k}^{d}\right]  \mathcal{R}_{fe}\left(  b\right)  _{jk}%
\end{equation}
i.e.
\begin{equation}
\Xi_{W^{d}V^{d}}:W^{d}\otimes V^{d}\rightarrow\mathcal{B}_{00}\left(
W,V\right)
\end{equation}
and
\begin{equation}
\left[  b\right]  =\Xi_{W^{d}V^{d}}\left(  b^{d}\right)  .
\end{equation}


\begin{remark}
The maps $\Xi_{W^{d}V^{d}},\Xi_{W^{d}V},\Xi_{WV^{d}}$ and $\Xi_{WV}$ all
produce the operator $\left[  b\right]  \in\mathcal{B}_{00}\left(  W,V\right)
.$
\end{remark}

\begin{remark}
The maps $\Xi_{W^{d}V^{d}},\Xi_{W^{d}V}$ and $\Xi_{WV}$ can be factored
through the map $\Xi_{WV^{d}}.$
\end{remark}

\begin{enumerate}
\item The action of the linear map $\left[  b\right]  \in\mathcal{B}%
_{00}\left(  W,V\right)  $ is given by
\begin{gather}
w=\left[  b\right]  v=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
f_{j}e_{k}^{d}\right]  \mathcal{R}_{ef}\left(  b\right)  _{jk}\left(
\sum_{1\leq l\leq n}\mathcal{R}_{f}\left(  w\right)  _{l}e_{l}\right) \\
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}f_{j}\mathcal{R}_{fe}\left(
b\right)  _{jk}\mathcal{R}_{e}\left(  v\right)  _{k}=\sum_{1\leq j\leq m}%
f_{j}\mathcal{R}_{f}\left(  w\right)  _{j}.
\end{gather}


\item The operator $\left[  wv^{d}\right]  $ can be expanded as
\begin{equation}
\left[  wv^{d}\right]  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
\ f_{j}e_{k}^{d}\right]  \mathcal{R}_{e}\left(  w\right)  _{j}\mathcal{R}%
_{f}\left(  \ v\right)  _{k}=\Xi\left(  w^{d}\otimes v^{d}\right)
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\Xi\left(  w^{d}\otimes
v^{d}\right)  \mathcal{R}_{f^{d}}\left(  w^{d}\right)  _{j}\mathcal{R}_{e^{d}%
}\left(  \ e^{d}\right)  _{k}.
\end{equation}


\item The product of elementary linear maps $\left[  f_{j_{1}}e_{k_{1}}%
^{d}\right]  $%
\begin{equation}
\left[  f_{j_{1}}e_{k_{1}}^{d}\right]  \left[  f_{j_{2}}e_{k_{2}}^{d}\right]
=e_{k_{1}}^{d}\left(  f_{j_{2}}\right)  \left[  f_{j_{1}}e_{k_{2}}^{d}\right]
,
\end{equation}
is \underline{\emph{not defined}} unless $V=W$, hence displaying
$\mathcal{B}_{00}\left(  V,W\right)  $ \emph{is not} an algebra when $V\neq W$
as $e_{k_{1}}^{d}\left(  f_{j_{2}}\right)  $ is not defined.

\item The expansion coefficients of linear map $\left[  b\right]  $ are
defined as
\begin{equation}
\mathcal{R}_{fe}\left(  b\right)  _{jk}=\mathcal{R}_{f^{d}e^{d}}\left(
b_{f^{d}e^{d}}\right)  _{jk}=\mathcal{R}_{f^{d}e}\left(  b_{f^{d}e}\right)
_{jk}=\mathcal{R}_{fe^{d}}\left(  b_{fe^{d}}\right)  _{jk}=\mathcal{R}%
_{fe}\left(  b_{fe}\right)  _{jk},\quad1\leq j\leq m,1\leq k\leq n.
\end{equation}


\item If $V=W$ then $\left[  b\right]  $ are \emph{operators} belonging to
$\mathcal{B}_{00}\left(  V\right)  .$
\end{enumerate}

\subsubsection{Transpose}

\begin{definition}
The transpose map $t\in\mathcal{B}_{00}\left(  V^{d}\otimes W^{d},W^{d}\otimes
V^{d}\right)  $%
\begin{equation}
\left(  w^{d}\otimes v^{d}\right)  ^{t}\left(  b\otimes a\right)  =\left(
w^{d}\otimes v^{d}\right)  \left(  a\otimes b\right)  =v^{d}\left(  a\right)
w^{d}\left(  b\right)  ,\quad\forall a\in V,\forall b\in W\,,
\end{equation}
i.e.%
\begin{equation}
\left(  w^{d}\otimes v^{d}\right)  ^{t}=v^{d}\otimes w^{d}\,.
\end{equation}

\end{definition}

\begin{definition}
The transpose map $t\in\mathcal{B}_{00}\left(  \mathcal{B}_{00}\left(
V,W\right)  ,\mathcal{B}_{00}\left(  W,V\right)  \right)  $%
\begin{equation}
t:\mathcal{B}_{00}\left(  W,V\right)  \rightarrow\mathcal{B}_{00}\left(
V,W\right)
\end{equation}
is defined as%
\begin{equation}
\left[  b\right]  ^{t}=\Xi_{T}\left(  b^{dt}\right)  ,
\end{equation}
where
\begin{equation}
T=VW,V^{d}W,VW^{d},V^{d}W^{d}.
\end{equation}

\end{definition}

\begin{lemma}
The transpose $\left[  b\right]  ^{t}$
\begin{equation}
\left[  b\right]  ^{t}:W\rightarrow V
\end{equation}
of the map $\left[  b\right]  \in\mathcal{B}_{00}\left(  W,V\right)  $
\begin{equation}
\left[  b\right]  :V\rightarrow W
\end{equation}
is given by
\begin{equation}
\left[  b\right]  ^{t}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
e_{j}f_{k}^{d}\right]  ^{t}\mathcal{R}_{ef}\left(  \left[  b\right]  \right)
_{jk}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{k}%
e_{bj}\right]  \mathcal{R}_{ef}\left(  \left[  b\right]  \right)  _{jk}%
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{k}e_{bj}\right]
\mathcal{R}_{fe}\left(  \left[  b\right]  ^{t}\right)  _{kj},\quad\left[
b\right]  \in\mathcal{B}_{00}\left(  V,W\right)  ,\quad\left[  b\right]
^{t}\in\mathcal{B}_{00}\left(  W,V\right)  .
\end{equation}
hence
\begin{equation}
\mathcal{R}_{fe}\left(  \left[  b\right]  ^{t}\right)  _{kj}=\mathcal{R}%
_{ef}\left(  \left[  b\right]  \right)  _{jk},\quad1\leq j\leq m,1\leq k\leq n
\end{equation}
and
\begin{equation}
\mathcal{R}_{fe}\left(  \left[  b\right]  ^{t}\right)  =\mathcal{R}%
_{ef}\left(  \left[  b\right]  \right)  ^{t}.
\end{equation}

\end{lemma}

\begin{lemma}
\begin{enumerate}
\item The transpose map $t\in\mathcal{B}_{00}\left(  V\otimes W,W\otimes
V\right)  $
\begin{equation}
t:W\otimes V\rightarrow V\otimes W
\end{equation}
is given by%
\begin{equation}
\left(  w\otimes v\right)  ^{t}=v\otimes w
\end{equation}
and

\item The transpose map $t\in\mathcal{B}_{00}\left(  \mathcal{B}_{00}\left(
W\right)  ,\mathcal{B}_{00}\left(  V\right)  \right)  $ is given by
\begin{equation}
\left[  wv^{d}\right]  ^{t}=\left[  vw^{d}\right]  .
\end{equation}

\end{enumerate}
\end{lemma}

\begin{lemma}
The transpose operation is basis independent.
\end{lemma}

\begin{proof}
$t$ is $\mathbb{C}$-linear i.e.
\begin{equation}
t\left(  \alpha a+\beta b\right)  =\alpha t\left(  a\right)  +\beta t\left(
b\right)
\end{equation}
as $V\otimes W$ and $W\otimes V$ are $\mathbb{C}$-linear spaces and change of
basis is a linear operation.
\end{proof}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
a\in W,\quad b\in V
\end{equation}


\item
\begin{align}
a\otimes b  &  =\left(  \boldsymbol{f}\otimes\boldsymbol{e}\right)
\mathcal{R}_{f\otimes e}\left(  a\otimes b\right)  =\left(  \boldsymbol{f}%
\otimes\boldsymbol{e}\right)  \left(  \overset{}{\mathcal{R}_{f}\left(
a\right)  \otimes\mathcal{R}_{e}\left(  b\right)  }\right)  =\left(  \left(
\boldsymbol{e}\right)  \otimes\left(  \boldsymbol{f}\right)  \right)  \left(
\overset{}{\mathcal{R}_{f}\left(  a\right)  \otimes\mathcal{R}_{e}\left(
b\right)  }\right) \\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(  f_{j}\otimes
e_{k}\right)  \mathcal{R}_{f}\left(  a\right)  _{j}\mathcal{R}_{e}\left(
b\right)  _{k}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(
f_{j}\otimes e_{k}\right)  \mathcal{R}_{f\otimes e}\left(  a\otimes b\right)
_{jk}.
\end{align}


\item
\begin{align}
b\otimes a  &  =\left(  \boldsymbol{e}\otimes\boldsymbol{f}\right)
\mathcal{R}_{e\otimes f}\left(  b\otimes a\right)  =\left(  \boldsymbol{e}%
\otimes\boldsymbol{f}\right)  \left(  \mathcal{R}_{e}\left(  b\right)
\overset{}{\otimes\mathcal{R}_{f}\left(  a\right)  }\right)  =\left(  \left(
\boldsymbol{e}\right)  \otimes\left(  \boldsymbol{f}\right)  \right)  \left(
\overset{}{\mathcal{R}_{e}\left(  b\right)  \otimes\mathcal{R}_{f}\left(
a\right)  }\right) \\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(  e_{j}\otimes
f_{k}\right)  \mathcal{R}_{f}\left(  a\right)  _{j}\mathcal{R}_{e}\left(
b\right)  _{k}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(
e_{j}\otimes f_{k}\right)  \mathcal{R}_{e\otimes f}\left(  b\otimes a\right)
_{jk}.
\end{align}


\item
\begin{align}
\mathcal{R}_{f\otimes e}\left(  a\otimes b\right)  _{jk}  &  =\mathcal{R}%
_{f}\left(  b\right)  _{k}\mathcal{R}_{e}\left(  a\right)  _{j},\quad1\leq
j\leq m,1\leq k\leq n\\
\mathcal{R}_{e\otimes f}\left(  b\otimes a\right)  _{kj}  &  =\mathcal{R}%
_{f}\left(  b\right)  _{k}\mathcal{R}_{e}\left(  a\right)  _{j},\quad1\leq
j\leq m,1\leq k\leq n.
\end{align}


\begin{enumerate}
\item
\begin{equation}
\left[  b\right]  =\Xi_{T}\left(  b_{T}\right)  =\sum_{\substack{1\leq j\leq
m\\1\leq k\leq n}}\left[  e_{j}f_{k}^{d}\right]  \mathcal{R}_{ef}\left(
b\right)  _{jk}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
e_{j}f_{k}^{d}\right]  \mathcal{R}_{ef}\left(  b_{T}\right)  _{jk}%
\end{equation}
giving%
\begin{equation}
\mathcal{R}_{ef}\left(  b\right)  _{jk}=\mathcal{R}_{e\otimes f}\left(
a\otimes b\right)  _{jk}=\mathcal{R}_{e^{d}\otimes f^{d}}\left(  a^{d}\otimes
b^{d}\right)  _{jk},\quad1\leq j\leq m,1\leq k\leq n.
\end{equation}


\item
\begin{equation}
\left[  b\right]  ^{t}=\Xi_{T}\left(  b_{T}\right)  ^{t}=\sum_{\substack{1\leq
j\leq m\\1\leq k\leq n}}\left[  f_{k}e_{bj}\right]  \mathcal{R}_{fe}\left(
\left[  b\right]  ^{t}\right)  _{kj}=\sum_{\substack{1\leq j\leq m\\1\leq
k\leq n}}\left[  f_{k}e_{bj}\right]  \mathcal{R}_{ef}\left(  b\right)  _{jk}.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\subsubsection{Adjoint}

\begin{definition}
The adjoint map $\dagger\in\mathcal{B}_{anti00}\left(  W^{d}\otimes
V^{d},V^{d}\otimes W^{d}\right)  $%
\begin{equation}
\left(  w\otimes v\right)  ^{\dagger}\left(  b\otimes a\right)  =\overline
{\left(  w\otimes v\right)  \left(  a\otimes b\right)  }=\overline{w\left(
a\right)  }\overline{v\left(  b\right)  },\quad\forall b\in V,\forall a\in
W\,.
\end{equation}

\end{definition}

\begin{definition}
The adjoint map $\dagger\in\mathcal{B}_{00}\left(  \mathcal{B}_{00}\left(
V,W\right)  ,\mathcal{B}_{00}\left(  W,V\right)  \right)  $%
\begin{equation}
\dagger:\mathcal{B}_{00}\left(  W,V\right)  \rightarrow\mathcal{B}_{00}\left(
V,W\right)
\end{equation}
is defined as
\begin{equation}
\left[  b\right]  ^{\dagger}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\left[  f_{j}e_{k}^{d}\right]  ^{\dagger}\overline{\mathcal{R}_{ef}\left(
b\right)  _{jk}}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
e_{k}f_{j}^{d}\right]  \overline{\mathcal{R}_{ef}\left(  b\right)  _{jk}%
},\quad\left[  b\right]  \in\mathcal{B}_{00}\left(  W,V\right)  ,\quad\left[
b\right]  ^{\dagger}\in\mathcal{B}_{00}\left(  V,W\right)  .
\end{equation}

\end{definition}

\begin{lemma}
The adjoint map $\dagger\in\mathcal{B}_{anti00}\left(  W\otimes V,V\otimes
W\right)  $
\begin{equation}
\dagger:W\otimes V\rightarrow V\otimes W
\end{equation}
is given by
\begin{equation}
\left[  b\right]  ^{\dagger}=\left(  \Xi_{T}\left(  b_{T}\right)  \right)
^{\dagger}.
\end{equation}

\end{lemma}

\begin{lemma}
\begin{enumerate}
\item The adjoint map $\dagger\in\mathcal{B}_{anti00}\left(  V\otimes
W,W\otimes V\right)  $
\begin{equation}
\dagger:V\otimes W\rightarrow W\otimes V
\end{equation}
is given by%
\begin{equation}
\left(  v\otimes w\right)  ^{\dagger}=\overline{w\otimes v}%
\end{equation}
and

\item The adjoint map $\dagger\in\mathcal{B}_{anti00}\left(  \mathcal{B}%
_{00}\left(  W\right)  ,\mathcal{B}_{00}\left(  V\right)  \right)  $ is given
by
\begin{equation}
\left[  wv^{d}\right]  ^{\dagger}=\left[  \overline{vw^{d}}\right]  .
\end{equation}

\end{enumerate}
\end{lemma}

\begin{lemma}
The adjoint operation is basis independent.
\end{lemma}

\begin{proof}
$\dagger$ is $\mathbb{C}$-antilinear i.e.
\begin{equation}
\dagger\left(  \alpha a+\beta b\right)  =\overline{\alpha}\dagger\left(
a\right)  +\overline{\beta}\dagger\left(  b\right)
\end{equation}
as $V\otimes W$ and $W\otimes V$ are $\mathbb{C}$-linear spaces and change of
basis is a linear operation.
\end{proof}

\begin{remark}
\begin{enumerate}
\item
\begin{align}
a\otimes b  &  =\left(  \boldsymbol{f}\otimes\boldsymbol{e}\right)
\mathcal{R}_{e\otimes f}\left(  a\otimes b\right)  =\left(  \boldsymbol{f}%
\otimes\boldsymbol{e}\right)  \left(  \overset{}{\mathcal{R}_{e}\left(
a\right)  \otimes\mathcal{R}_{f}\left(  b\right)  }\right)  =\left(  \left(
\boldsymbol{f}\right)  \otimes\left(  \boldsymbol{e}\right)  \right)  \left(
\overset{}{\mathcal{R}_{e}\left(  a\right)  \otimes\mathcal{R}_{f}\left(
b\right)  }\right) \\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(  f_{j}\otimes
e_{k}\right)  \mathcal{R}_{e}\left(  a\right)  _{j}\mathcal{R}_{f}\left(
b\right)  _{k}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(
f_{j}\otimes e_{k}\right)  \mathcal{R}_{e\otimes f}\left(  a\otimes b\right)
_{jk}.
\end{align}


\item
\begin{align}
b\otimes a  &  =\left(  \boldsymbol{e}\otimes\boldsymbol{f}\right)
\mathcal{R}_{f\otimes e}\left(  b\otimes a\right)  =\left(  \boldsymbol{e}%
\otimes\boldsymbol{f}\right)  \mathcal{R}_{f}\left(  b\right)  \otimes
\mathcal{R}_{e}\left(  a\right)  =\left(  \left(  \boldsymbol{e}\right)
\otimes\left(  \boldsymbol{f}\right)  \right)  \mathcal{R}_{f}\left(
b\right)  \otimes\mathcal{R}_{e}\left(  a\right) \\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(  f_{j}\otimes
e_{k}\right)  \mathcal{R}_{f}\left(  b\right)  _{k}\mathcal{R}_{e}\left(
a\right)  _{j}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left(
f_{j}\otimes e_{k}\right)  \mathcal{R}_{f\otimes e}\left(  b\otimes a\right)
_{kj}.
\end{align}


\item
\begin{equation}
\mathcal{R}_{f\otimes e}\left(  b\otimes a\right)  _{kj}=\mathcal{R}_{e\otimes
f}\left(  a\otimes b\right)  _{jk},\quad1\leq j\leq m,1\leq k\leq n.
\end{equation}


\begin{enumerate}
\item
\begin{equation}
\left[  b\right]  =\Xi_{T}\left(  b_{T}\right)  =\sum_{\substack{1\leq j\leq
m\\1\leq k\leq n}}\left[  f_{j}e_{k}^{d}\right]  \mathcal{R}_{fe}\left(
b\right)  _{jk}=\Xi_{WV}\left(  \sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\left(  f_{j}\otimes e_{k}\right)  \mathcal{R}_{f\otimes e}\left(  a\otimes
b\right)  _{jk}\right)  =\Xi_{WV}\left(  \sum_{\substack{1\leq j\leq m\\1\leq
k\leq n}}\left(  f_{j}\otimes e_{k}\right)  \right)  \mathcal{R}_{f}\left(
a\right)  _{j}\mathcal{R}_{e}\left(  b\right)  _{k}%
\end{equation}
giving%
\begin{equation}
\mathcal{R}_{fe}\left(  b\right)  _{jk}=\mathcal{R}_{f\otimes e}\left(
a\otimes b\right)  _{jk}=\mathcal{R}_{f}\left(  a\right)  _{j}\mathcal{R}%
_{e}\left(  b\right)  _{k},\quad1\leq j\leq m,1\leq k\leq n.
\end{equation}


\item
\begin{equation}
\left[  b\right]  ^{\dagger}=\Xi_{T}\left(  b_{T}\right)  ^{\dagger}%
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  e_{k}f_{j}^{d}\right]
^{\dagger}\mathcal{R}_{ef}\left(  b^{\dagger}\right)  _{kj}=\sum
_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{j}e_{k}^{d}\right]
\overline{\mathcal{R}_{fe}\left(  b\right)  _{jk}},
\end{equation}
where
\begin{equation}
\mathcal{R}_{ef}\left(  b^{\dagger}\right)  _{kj}\equiv\mathcal{R}_{ef}\left(
\left[  b\right]  ^{\dagger}\right)  _{kj}=\overline{\mathcal{R}_{fe}\left(
b\right)  _{jk}},\quad1\leq j\leq m,1\leq k\leq n.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
Consider the linear functional
\begin{align}
\left[  \alpha^{d}\otimes\beta^{d}\right]  \left(  \mathcal{\sigma}_{e}\left(
v\right)  \otimes w\right)   &  =\alpha^{d}\left(  \mathcal{\sigma}_{e}\left(
v\right)  \right)  \beta^{d}\left(  w\right)  =\left(  \sum_{1\leq j\leq
m}\mathcal{R}_{e^{d}}\left(  \alpha^{d}\right)  _{j}\mathcal{R}_{e}\left(
\mathcal{\sigma}_{e}\left(  v\right)  \right)  _{j}\right)  \left(
\sum_{1\leq j\leq n}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)
_{j}\mathcal{R}_{f}\left(  w\right)  _{j}\right) \\
&  =\left(  \sum_{1\leq j\leq m}\mathcal{R}_{e^{d}}\left(  \alpha^{d}\right)
_{j}\overline{\mathcal{R}_{e}\left(  v\right)  }_{j}\right)  \left(
\sum_{1\leq j\leq n}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)
_{j}\mathcal{R}_{f}\left(  w\right)  _{j}\right)  ,
\end{align}
then
\begin{align}
\overline{\left[  \alpha^{d}\otimes\beta^{d}\right]  \left(  \mathcal{\sigma
}_{e}\left(  w\right)  \otimes v\right)  }  &  =\overline{\alpha^{d}\left(
\mathcal{\sigma}_{e}\left(  w\right)  \right)  \beta^{d}\left(  v\right)
}=\left(  \sum_{1\leq j\leq m}\overline{\mathcal{R}_{e^{d}}\left(  \alpha
^{d}\right)  _{j}\mathcal{R}_{e}\left(  \mathcal{\sigma}_{e}\left(  w\right)
\right)  _{j}}\right)  \left(  \sum_{1\leq j\leq n}\overline{\mathcal{R}%
_{f^{d}}\left(  \beta^{d}\right)  _{j}\mathcal{R}_{f}\left(  v\right)  _{j}%
}\right) \\
&  =\left(  \sum_{1\leq j\leq m}\overline{\mathcal{R}_{e^{d}}\left(
\alpha^{d}\right)  _{j}}\mathcal{R}_{e}\left(  w\right)  _{j}\right)  \left(
\sum_{1\leq j\leq n}\overline{\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)
_{j}\mathcal{R}_{f}\left(  v\right)  _{j}}\right)  .
\end{align}

\end{remark}

\begin{remark}
Let
\begin{align}
h\left(  v,w\right)  =  &  \left[  \alpha^{d}\otimes\beta^{d}\right]  \left(
\mathcal{\sigma}_{e}\left(  v\right)  \otimes w\right)  +\overline{\left[
\alpha^{d}\otimes\beta^{d}\right]  \left(  \mathcal{\sigma}_{e}\left(
w\right)  \otimes v\right)  }\\
&  =\sum_{1\leq j\leq m}\sum_{1\leq j\leq n}\left\{  \mathcal{R}_{e^{d}%
}\left(  \alpha^{d}\right)  _{j}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)
_{j}\overline{\mathcal{R}_{e}\left(  v\right)  }_{j}\mathcal{R}_{f}\left(
w\right)  _{j}+\overline{\mathcal{R}_{e^{d}}\left(  \alpha^{d}\right)  _{j}%
}\overline{\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)  _{j}\mathcal{R}%
_{f}\left(  v\right)  _{j}}\mathcal{R}_{e}\left(  w\right)  _{j}\right\}
\end{align}
\underline{\emph{then}} $h$ is hermitian i.e.
\begin{equation}
\overline{h\left(  w,v\right)  }=\overline{\left[  \alpha^{d}\otimes\beta
^{d}\right]  \left(  \mathcal{\sigma}_{e}\left(  w\right)  \otimes v\right)
}+\left[  \alpha^{d}\otimes\beta^{d}\right]  \left(  \mathcal{\sigma}%
_{e}\left(  v\right)  \otimes w\right)  =h\left(  v,w\right)
\end{equation}
and
\begin{align}
h\left(  v,w\right)  =  &  \left[  \alpha^{d}\otimes\beta^{d}\right]  \left(
\mathcal{\sigma}_{e}\left(  v\right)  \otimes w+w\otimes\mathcal{\sigma}%
_{e}\left(  v\right)  \right)  =\alpha^{d}\left(  \mathcal{\sigma}_{e}\left(
v\right)  \right)  \beta^{d}\left(  w\right)  +\alpha^{d}\left(  w\right)
\beta^{d}\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right) \\
&  =\sum_{1\leq j\leq m}\mathcal{R}_{e^{d}}\left(  \alpha^{d}\right)
_{j}\mathcal{R}_{e}\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)
_{j}\sum_{1\leq j\leq n}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)
_{j}\mathcal{R}_{f}\left(  w\right)  _{j}+\sum_{1\leq j\leq m}\mathcal{R}%
_{e^{d}}\left(  \alpha^{d}\right)  _{j}\mathcal{R}_{e}\left(  w\right)
_{j}\sum_{1\leq j\leq n}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)
_{j}\mathcal{R}_{f}\left(  \mathcal{\sigma}_{e}\left(  v\right)  \right)
_{j}\\
&  =\sum_{1\leq j\leq m}\mathcal{R}_{e^{d}}\left(  \alpha^{d}\right)
_{j}\overline{\mathcal{R}_{e}\left(  v\right)  }_{j}\sum_{1\leq j\leq
n}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)  _{j}\mathcal{R}_{f}\left(
w\right)  _{j}+\sum_{1\leq j\leq m}\mathcal{R}_{e^{d}}\left(  \alpha
^{d}\right)  _{j}\overline{\mathcal{R}_{e}\left(  w\right)  }_{j}\sum_{1\leq
j\leq n}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)  _{j}\mathcal{R}%
_{f}\left(  v\right)  _{j}\\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left\{  \mathcal{R}_{e^{d}%
}\left(  \alpha^{d}\right)  _{j}\overline{\mathcal{R}_{e}\left(  v\right)
}_{j}\mathcal{R}_{f^{d}}\left(  \beta^{d}\right)  _{k}\mathcal{R}_{f}\left(
w\right)  _{k}+\mathcal{R}_{e^{d}}\left(  \alpha^{d}\right)  _{j}%
\overline{\mathcal{R}_{e}\left(  w\right)  }_{j}\mathcal{R}_{f^{d}}\left(
\beta^{d}\right)  _{k}\mathcal{R}_{f}\left(  v\right)  _{k}\right\}  .
\end{align}

\end{remark}

\begin{remark}
Let
\begin{equation}
h\left(  w,v\right)  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}%
}\overline{\mathcal{R}_{e}\left(  w\right)  }_{j}\mathcal{R}_{e}\left(
h\right)  _{jk}\mathcal{R}_{f}\left(  v\right)  _{k}=\frac{1}{2}%
\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\overline{\mathcal{R}_{e}\left(
w\right)  }_{j}\left\{  \mathcal{R}_{e}\left(  a\right)  _{jk}+\overline
{\mathcal{R}_{e}\left(  a\right)  _{kj}}\right\}  \mathcal{R}_{f}\left(
v\right)  _{k}%
\end{equation}
then
\begin{equation}
h\left(  w,v\right)  =\frac{1}{2}\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\mathcal{R}_{e}\left(  \sigma_{e}\left(  w\right)  \right)  _{j}\left\{
\mathcal{R}_{e}\left(  a\right)  _{jk}+\overline{\mathcal{R}_{e}\left(
a\right)  _{kj}}\right\}  \mathcal{R}_{f}\left(  v\right)  _{k}.
\end{equation}

\end{remark}

\subsection{Group Representations carried by ${\protect\Large \otimes}^{2}V$}

The group $GL\left(  V\right)  \subset GL\left(  {\Large \otimes}^{2}V\right)
$ has matrix representations $\mathcal{R}_{e\otimes e}$%
\begin{equation}
\mathcal{R}_{e\otimes e}:GL\left(  V\right)  \rightarrow\mathcal{M}\left(
r^{2},r^{2},\mathbb{C}\right)  ,
\end{equation}
which are reducible and have direct sum decompositions
\begin{equation}
\mathcal{R}_{e\otimes e}=\mathcal{R}_{e\vee e}\oplus\mathcal{R}_{e\wedge e}%
\end{equation}
and is the tensor product representation produced by the tensor product of the
representation $\mathcal{R}_{e}$ with itself i.e.
\begin{equation}
\mathcal{R}_{e\otimes e}\left(  T\otimes T\right)  =\mathcal{R}_{e}\left(
T\right)  \otimes\mathcal{R}_{e}\left(  T\right)  .
\end{equation}


\begin{definition}
Linear operators $E_{xy}\equiv\left[  xy^{d}\right]  \in\mathcal{B}%
_{00}\left(  V\right)  \cong V\otimes V^{d}\hookrightarrow V^{d}\otimes
V^{d}$
\begin{equation}
E_{xy}:V\rightarrow V,\quad E_{xy}\in\mathcal{B}_{00}\left(  V\right)
\end{equation}
is defined by
\begin{equation}
E_{xy}\left(  v\right)  =y^{d}\left(  v\right)  x,\quad\forall v\in V,\quad
x\in V,\quad y^{d}\in V^{d}.
\end{equation}

\end{definition}

\begin{lemma}
Any element $A\in\mathcal{B}_{00}\left(  V\right)  $ can be expressed as
\begin{equation}
A=\sum_{1\leq j,k\leq r}E_{e_{j}e_{k}}\mathcal{R}_{e}\left(  A\right)  _{jk},
\end{equation}
where $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ is a basis
of $V$ and $\left\{  \left.  e_{j}^{d}\right\vert 1\leq j\leq r\right\}  $ the
corresponding dual basis of $V^{d}$ i.e.
\begin{equation}
e_{bj}=\mathcal{I}_{V}\left(  e_{j}\right)  ,\quad1\leq j\leq r.
\end{equation}

\end{lemma}

\begin{definition}
The transpose operation is \emph{defined} as a linear antihomomorphism
"$t"\in\mathcal{B}_{00}\left(  \overset{}{\mathcal{B}_{00}\left(  V\right)
,\mathcal{B}_{00}\left(  V\right)  }\right)  $ that has the effect
\begin{equation}
\left(  E_{wv}\right)  ^{t}=E_{vw}=\left[  vw^{d}\right]  ,
\end{equation}
where
\begin{equation}
E_{vw}:V\rightarrow V,\quad\in\mathcal{B}_{00}\left(  V\right)  \cong%
\mathcal{B}_{00}\left(  \mathbb{C}^{r}\right)  .
\end{equation}

\end{definition}

\begin{example}
\begin{enumerate}
\item The transition operator $E_{wv}$ has the properties
\begin{equation}
E_{wv}\left(  \eta\right)  =\left[  wv^{d}\right]  \left(  \eta\right)
=v^{d}\left(  \eta\right)  w=\left[  \mathcal{I}_{V}\left(  v\right)  \right]
\left(  \eta\right)  w,
\end{equation}
where
\begin{equation}
\mathcal{I}_{V}\left(  w\right)  =\sum_{1\leq j\leq r}e_{bj}\mathcal{R}%
_{e}\left(  w\right)  _{j}%
\end{equation}
and
\begin{equation}
w=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  w\right)  _{j}%
\end{equation}
for any basis $\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ of
$V.$

\item The transpose $\left(  E_{wv}\right)  ^{t}$ is given by
\begin{equation}
\left(  E_{wv}\right)  ^{t}\left(  \eta\right)  =\left(  E_{vw}\right)
\left(  \eta\right)  =\left[  vw^{d}\right]  \left(  \eta\right)
=w^{d}\left(  \eta\right)  v=\left[  \mathcal{I}_{V}\left(  w\right)  \right]
\left(  \eta\right)  v.
\end{equation}

\end{enumerate}
\end{example}

\begin{definition}
The adjoint operation is \emph{defined} as an anti linear operator
"$\dagger"\in\mathcal{B}_{00}\left(  \overset{}{\mathcal{B}_{00}\left(
V,W\right)  ,\mathcal{B}_{00}\left(  W,V\right)  }\right)  $ that has the
effect
\begin{equation}
A^{\dagger}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{j}%
e_{k}^{d}\right]  ^{t}\overline{\mathcal{R}_{ef}\left(  A\right)  _{jk}}%
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  e_{k}f_{j}^{d}\right]
\overline{\mathcal{R}_{ef}\left(  A\right)  _{jk}}=\sum_{\substack{1\leq j\leq
m\\1\leq k\leq n}}\left[  e_{k}f_{j}^{d}\right]  \mathcal{R}_{ef}\left(
\sigma_{e}A\sigma_{f}\right)  _{jk}.
\end{equation}

\end{definition}

\begin{theorem}
The adjoint operation is basis independent.
\end{theorem}

\begin{proof}%
\begin{align}
A^{\dagger}w  &  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[
e_{k}f_{j}^{d}\right]  \overline{\mathcal{R}_{ef}\left(  A\right)  _{jk}}%
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}e_{k}f_{j}^{d}\left(  w\right)
\overline{\mathcal{R}_{ef}\left(  A\right)  _{jk}}=\sum_{\substack{1\leq j\leq
m\\1\leq k\leq n}}e_{k}\mathcal{R}_{f}\left(  w\right)  _{j}\overline
{\mathcal{R}_{ef}\left(  A\right)  _{jk}}\\
&  =\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}e_{k}\mathcal{R}_{fe}\left(
A^{\dagger}\right)  _{kj}\mathcal{R}_{f}\left(  w\right)  _{j}=\sum_{1\leq
k\leq n}e_{k}\mathcal{R}_{fe}\left(  A^{\dagger}w\right)  _{k},
\end{align}
which is basis independent.
\end{proof}

\subsection{Bilinear Forms acting in $V.$}

\begin{enumerate}
\item Complex nondegenerate bilinear forms $\mathfrak{b}\in\mathfrak{B}\left(
V\right)  $ can be defined in $V\times V$ i.e.
\begin{equation}
\mathfrak{b}\left(  ,\right)  :V\times V\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\mathfrak{b}\left(  c_{1}v_{1}+c_{2}v_{2},c_{3}v_{3}+c_{4}w_{4}\right)
=c_{1}c_{3}\mathfrak{b}\left(  v_{1},v_{3}\right)  +c_{1}c_{4}\mathfrak{b}%
\left(  v_{1},v_{3}\right)  +c_{2}c_{3}\mathfrak{b}\left(  v_{2},v_{3}\right)
+c_{2}c_{4}\mathfrak{b}\left(  v_{2},v_{4}\right)  ,\forall v_{1},v_{2}%
,v_{3},v_{4}\in V.
\end{equation}


\begin{enumerate}
\item The form $\mathfrak{b}$ can always be generated by an element of the
tensor product space ${\large \otimes}^{2}V^{d}=V^{d}\otimes V^{d}$ i.e.
\begin{gather}
\mathfrak{b}\left(  v_{1},v_{2}\right)  =\left(  \left.  {}\right\vert \left.
{}\right.  \right)  _{\mathfrak{b}}=\left[  \sum_{1\leq j\leq r}w_{j}%
^{d}\otimes x_{j}^{d}\right]  \left(  v_{1}\otimes v_{2}\right)  =\left[
\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  b\right)  _{jk}e_{bj}\otimes
e_{k}^{d}\right]  \left(  v_{1}\otimes v_{2}\right) \\
=\left[  \sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  b\right)  _{jk}%
e_{bj}\otimes e_{k}^{d}\right]  \left(  \sum_{1\leq l,m\leq r}\mathcal{R}%
_{e}\left(  v_{1}\right)  _{l}\mathcal{R}_{e}\left(  v_{2}\right)  _{m}%
e_{l}\otimes e_{m}\right) \\
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  b\right)  _{jk}\mathcal{R}%
_{e}\left(  v_{1}\right)  _{j}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}%
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  v_{1}\right)  _{j}%
\mathcal{R}_{e}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)
_{k}.
\end{gather}


\item The form $\mathfrak{b}$ corresponds in a $1-1$ fashion with operators
belonging to $\mathcal{B}_{00}\left(  V\right)  $ i.e.
\begin{equation}
\left[  b\right]  \in\mathcal{B}_{00}\left(  V\right)  \cong V\otimes
V^{d}\hookrightarrow V^{d}\otimes V^{d}%
\end{equation}
where the operator $b$ is given by
\begin{equation}
\left[  b\right]  =\sum_{1\leq j,k\leq r}\left[  e_{j}e_{k}^{d}\right]
\mathcal{R}_{e}\left(  b\right)  _{jk}%
\end{equation}
and
\begin{gather}
\left[  b\right]  v=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  b\right)
_{jk}\left[  e_{j}e_{k}^{d}\right]  v=\sum_{1\leq j,k\leq r}\mathcal{R}%
_{e}\left(  b\right)  _{jk}\left[  e_{j}e_{k}^{d}\right]  \sum_{1\leq l\leq
r}e_{l}\mathcal{R}_{e}\left(  v\right)  _{l}\\
=\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}_{e}\left(  b\right)  _{jk}%
\mathcal{R}_{e}\left(  v\right)  _{k}=\sum_{1\leq j\leq r}\left(  \sum_{1\leq
k\leq r}e_{j}\mathcal{R}_{e}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(
v\right)  _{k}\right)  .
\end{gather}


\item The correspondence between $\mathfrak{b}$ and $\left[  b\right]  $ is
given by
\begin{gather}
\mathfrak{b}\left(  v_{1},v_{2}\right)  =\mathfrak{i}_{e}\left(  v_{1},\left[
b\right]  v_{2}\right)  =\left[  \sum_{1\leq j,k\leq r}\mathcal{\delta}%
_{jk}e_{bj}\otimes e_{k}^{d}\right]  \left(  v_{1}\otimes\left[  b\right]
v_{2}\right)  =\left[  \sum_{1\leq j\leq r}e_{bj}\otimes e_{bj}\right]
\left(  v_{1}\otimes\left[  b\right]  v_{2}\right) \\
=\left[  \sum_{1\leq j\leq r}e_{bj}\otimes e_{bj}\right]  \left(  \sum_{1\leq
l\leq r}\mathcal{R}_{e}\left(  v_{1}\right)  _{l}e_{l}\otimes\sum_{1\leq p\leq
r}\left(  \sum_{1\leq q\leq r}\mathcal{R}_{e}\left(  b\right)  _{pq}%
\mathcal{R}_{e}\left(  v_{2}\right)  _{q}\right)  e_{p}\right) \\
=\sum_{1\leq j,l,p,q\leq r}\mathcal{\delta}_{jk}\mathcal{R}_{e}\left(
v_{1}\right)  _{l}\mathcal{R}_{e}\left(  b\right)  _{pq}\mathcal{R}_{e}\left(
v_{2}\right)  _{q}e_{bj}\left(  e_{l}\right)  \otimes e_{k}^{d}\left(
e_{p}\right) \\
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  v_{1}\right)  _{j}%
\mathcal{R}_{e}\left(  b\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)
_{k}.
\end{gather}


\item
\begin{equation}
\mathfrak{i}_{e}=\sum_{1\leq j,k\leq r}\mathcal{R}_{e}\left(  \mathfrak{i}%
_{e}\right)  _{jk}e_{bj}\otimes e_{k}^{d}=\sum_{1\leq j,k\leq r}%
\mathcal{\delta}_{jk}e_{bj}\otimes e_{k}^{d}=\sum_{1\leq j\leq r}e_{bj}\otimes
e_{bj}.
\end{equation}

\end{enumerate}

\item Complex nondegenerate symmetric bilinear forms $\mathfrak{s}\left(
,\right)  =\left(  \left.  {}\right\vert \left.  {}\right.  \right)
_{\mathfrak{s}}$ can be defined in $V\times V$ i.e.
\begin{equation}
\left(  \left.  {}\right\vert \left.  {}\right.  \right)  _{\mathfrak{s}%
}:V\times V\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\mathfrak{s}\left(  v_{1},v_{2}\right)  =\left(  \left.  v_{1}\right\vert
v_{2}\right)  _{\mathfrak{s}}=\left(  \left.  v_{2}\right\vert v_{1}\right)
_{\mathfrak{s}}=\mathfrak{s}\left(  v_{2},v_{1}\right)  ,\forall v_{1}%
,v_{2}\in V.
\end{equation}


\begin{enumerate}
\item The form $\mathfrak{s}$ can always be generated by an element of the
symmetric tensor product space ${\Large \vee}^{2}V^{d}=V^{d}\vee V^{d}$ i.e.
\begin{equation}
\mathfrak{s}\left(  v_{1},v_{2}\right)  =\left(  \left.  v_{2}\right\vert
v_{1}\right)  _{\mathfrak{s}}=\left[  \sum_{1\leq j\leq r}w_{j}^{d}\vee
x_{j}^{d}\right]  \left(  v_{1}\vee v_{2}\right)  =\left[  \sum_{1\leq j\leq
r}w_{j}^{d}\vee x_{j}^{d}\right]  \left(  v_{2}\vee v_{1}\right)
=\mathfrak{s}\left(  v_{2},v_{1}\right)  .
\end{equation}


\item The form $\mathfrak{s}$ can be expressed wrt a general basis by%
\begin{equation}
\mathfrak{s}\left(  v_{1},v_{2}\right)  =\left(  \left.  v_{2}\right\vert
v_{1}\right)  _{\mathfrak{s}}=\left[  \sum_{1\leq j\leq r}w_{j}^{d}\vee
x_{j}^{d}\right]  \left(  v_{1}\vee v_{2}\right)  =\left[  \sum_{1\leq j,k\leq
r}\mathcal{R}_{e}\left(  s\right)  _{jk}e_{bj}\otimes e_{k}^{d}\right]
\left(  v_{1}\otimes v_{2}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  s\right)  _{jk}=\mathcal{R}_{e}\left(  s\right)
_{kj},\quad1\leq j\leq r,1\leq k\leq r.
\end{equation}


\item
\begin{equation}
\left[  s\right]  \in\mathcal{B}_{00}\left(  V\right)  \cong V\otimes
V^{d}\cong V^{d}\otimes V^{d}.
\end{equation}

\end{enumerate}

\item Complex nondegenerate antisymmetric bilinear forms $\mathfrak{g}\left(
,\right)  =\left\{  \left.  {}\right\vert \left.  {}\right.  \right\}
_{\mathfrak{g}}=$ $\left(  \left.  {}\right\vert \left.  {}\right.  \right)
_{\mathfrak{g}}$ can be defined in $V\times V$ i.e.
\begin{equation}
\left\{  \left.  {}\right\vert \left.  {}\right.  \right\}  _{\mathfrak{g}%
}:V\times V\rightarrow\mathbb{C},
\end{equation}
where
\begin{equation}
\mathfrak{g}\left(  v_{1},v_{2}\right)  =\left\{  \left.  v_{1}\right\vert
v_{2}\right\}  _{\mathfrak{g}}=-\left\{  \left.  v_{1}\right\vert
v_{2}\right\}  _{\mathfrak{g}}=-\mathfrak{g}\left(  v_{2},v_{1}\right)
,\,\forall v_{1},v_{2}\in V.
\end{equation}


\begin{enumerate}
\item The form $\mathfrak{g}$ can always be generated by an element of the
antisymmetric tensor product space ${\Large \wedge}^{2}V^{d}=V^{d}\wedge
V^{d}$ i.e.
\begin{equation}
\mathfrak{g}\left(  v_{1},v_{2}\right)  =\left\{  \left.  v_{1}\right\vert
v_{2}\right\}  _{\mathfrak{g}}=\left[  \sum_{1\leq j\leq s}w_{j}^{d}\wedge
w_{j+s}^{d}\right]  \left(  v_{1}\wedge v_{2}\right)  =-\left[  \sum_{1\leq
j\leq s}w_{j}^{d}\wedge w_{j+s}^{d}\right]  \left(  v_{2}\wedge v_{1}\right)
.
\end{equation}


\item The form $\mathfrak{g}$ can be expressed wrt a general basis by
\begin{equation}
\mathfrak{g}\left(  v_{1},v_{2}\right)  =\left(  \left.  v_{1}\right\vert
v_{2}\right)  _{\mathfrak{g}}=\left[  \sum_{1\leq j\leq r}w_{j}^{d}\wedge
x_{j}^{d}\right]  \left(  v_{1}\wedge v_{2}\right)  =\left[  \sum_{1\leq
j,k\leq r}\mathcal{R}_{e}\left(  g\right)  _{jk}e_{bj}\otimes e_{k}%
^{d}\right]  \left(  v_{1}\otimes v_{2}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{e}\left(  g\right)  _{jk}=-\mathcal{R}_{e}\left(  g\right)
_{kj},\quad1\leq j\leq r,1\leq k\leq r.
\end{equation}


\item
\begin{equation}
\left[  g\right]  \in\mathcal{B}_{00}\left(  V\right)  \cong V\otimes
V^{d}\hookrightarrow V^{d}\otimes V^{d}%
\end{equation}

\end{enumerate}

\item Sesquilinear nondegenerate forms $\mathfrak{h}\left(  ,\right)
=\left\langle \left.  {}\right\vert \left.  {}\right.  \right\rangle
_{\mathfrak{h}}$ can be defined in $V\times V$ i.e.
\begin{equation}
\mathfrak{h}\equiv\left\langle \left.  {}\right\vert \left.  {}\right.
\right\rangle _{h}:V\times V\rightarrow\mathbb{C},
\end{equation}


\begin{enumerate}
\item
\begin{equation}
\mathfrak{h}\left(  v_{1},v_{2}\right)  =\left\langle \left.  v_{1}\right\vert
v_{2}\right\rangle _{h}=\overline{\left\langle \left.  v_{2}\right\vert
v_{1}\right\rangle }_{h},\quad\forall v_{1},v_{2}\in V
\end{equation}


\item
\begin{equation}
\mathfrak{h}\left(  v_{1},v_{2}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\overline{\mathcal{R}_{e}\left(
v_{1}\right)  _{j}}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}%
\end{equation}


\item
\begin{align}
\mathfrak{h}\left(  v_{2},v_{1}\right)   &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\overline{\mathcal{R}_{e}\left(
v_{2}\right)  _{j}}\mathcal{R}_{e}\left(  v_{1}\right)  _{k}=\overline{%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\overline{\mathcal{R}_{e}\left(
v_{1}\right)  _{j}}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  h\right)  _{jk}}\mathcal{R}_{e}\left(
v_{2}\right)  _{j}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{k}}\\
&  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{kj}\mathcal{R}_{e}\left(  v_{2}\right)
_{j}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{k}}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\overline{\mathcal{R}_{e}\left(
v_{1}\right)  _{j}}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}=\overline
{\mathfrak{h}\left(  v_{1},v_{2}\right)  }%
\end{align}


\item
\begin{equation}
h^{d}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}e_{bj}\otimes e_{k}^{d},\quad h^{d}\in%
%TCIMACRO{\dbigotimes \nolimits^{2}}%
%BeginExpansion
{\displaystyle\bigotimes\nolimits^{2}}
%EndExpansion
V^{d}%
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  h\right)  _{jk}=\overline{\mathcal{R}_{e}\left(
h\right)  _{kj}},\quad1\leq j\leq r,1\leq k\leq r.
\end{equation}


\item
\begin{equation}
\left[  h\right]  \in\mathcal{B}_{00}\left(  V\right)  \cong V\otimes
V^{d}\hookrightarrow V^{d}\otimes V^{d}.
\end{equation}


\item
\begin{equation}
\left[  h\right]  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}e_{j}\otimes e_{k}^{d}\in\mathcal{B}%
_{00}\left(  V\right)
\end{equation}


\item
\begin{equation}
\left[  h\right]  ^{\dagger}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  h\right)  _{jk}}e_{k}\otimes e_{bj}%
\in\mathcal{B}_{00}\left(  V\right)
\end{equation}


\item Consider the linear functional $h^{d}$ produced by a self adjoint
$\left[  h\right]  $
\begin{align}
h^{d}\left(  v_{1}\otimes v_{2}\right)   &  =\left[
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}e_{bj}\otimes e_{k}^{d}\right]  \left(
\left(  \sum_{1\leq p\leq r}\mathcal{R}_{e}\left(  v_{1}\right)  _{p}%
e_{p}\right)  \otimes\left(  \sum_{1\leq q\leq r}\mathcal{R}_{e}\left(
v_{2}\right)  _{q}e_{q}\right)  \right) \\
&  =\left[
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}e_{bj}\otimes e_{k}^{d}\right]  \left(
\sum_{1\leq p,q\leq r}\mathcal{R}_{e}\left(  v_{1}\right)  _{p}\mathcal{R}%
_{e}\left(  v_{2}\right)  _{q}e_{p}\otimes e_{q}\right) \\
&  =%
%TCIMACRO{\dsum \limits_{1\leq j,k,p,q\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k,p,q\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v_{1}\right)
_{p}\mathcal{R}_{e}\left(  v_{2}\right)  _{q}\left(  e_{bj}\otimes e_{k}%
^{d}\right)  \left(  e_{p}\otimes e_{q}\right) \\
&  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v_{1}\right)
_{j}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\\
&  =\frac{1}{2}%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\left\{  \mathcal{R}_{e}\left(  h\right)  _{jk}+\overline{\mathcal{R}%
_{e}\left(  h\right)  _{kj}}\right\}  \mathcal{R}_{e}\left(  v_{1}\right)
_{j}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\\
h^{d}\left(  v_{2}\otimes v_{1}\right)   &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)
_{j}\mathcal{R}_{e}\left(  v_{1}\right)  _{k}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{kj}\mathcal{R}_{e}\left(  v_{2}\right)
_{k}\mathcal{R}_{e}\left(  v_{1}\right)  _{j}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  h\right)  _{jk}}\mathcal{R}_{e}\left(
v_{2}\right)  _{k}\mathcal{R}_{e}\left(  v_{1}\right)  _{j}%
\end{align}


\item
\begin{equation}
\overline{h^{d}\left(  v_{2}\otimes v_{1}\right)  }=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\overline{\mathcal{R}_{e}\left(
v_{2}\right)  _{k}}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}.
\end{equation}


\item
\begin{align}
h  &  =h^{\dagger}\\
\left(  u^{\dagger}hu\right)  ^{\dagger}  &  =u^{\dagger}hu,
\end{align}
where
\begin{equation}
u^{\dagger}u=uu^{\dagger}=I_{V}.
\end{equation}


\item
\begin{equation}
\mathcal{R}_{e}\left(  \sigma_{e}\left(  v\right)  \right)  _{j}%
=\overline{\mathcal{R}_{e}\left(  v\right)  _{j}},\quad1\leq j\leq r.
\end{equation}


\item
\begin{equation}
\mathfrak{h}\left(  v_{1},v_{2}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{R}_{e}\left(
h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  \sigma_{e}\left(  v_{1}\right)  \right)  _{j}%
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)
_{k}.
\end{equation}


\item
\begin{equation}
\overline{\mathfrak{h}\left(  v_{2},v_{1}\right)  }=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{j}\overline{\mathcal{R}_{e}\left(
h\right)  _{jk}}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{k}}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{j}\overline{\mathcal{R}_{e}\left(
h\right)  _{jk}}\mathcal{R}_{e}\left(  \sigma_{e}\left(  v_{1}\right)
\right)  _{k}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  \sigma_{e}\left(  v_{1}\right)  \right)  _{j}%
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)
_{k}.
\end{equation}


\begin{lemma}%
\begin{align}
\overline{\mathfrak{h}\left(  v_{2},v_{1}\right)  }  &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{j}\overline{\mathcal{R}_{e}\left(
h\right)  _{jk}}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{k}}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\mathcal{R}_{e}\left(  h\right)
_{jk}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\mathcal{R}_{e}\left(  h\right)
_{jk}\mathcal{R}_{e}\left(  \sigma_{e}\left(  v_{1}\right)  \right)  _{j}\\
&  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{R}_{e}\left(
h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  \sigma_{e}\left(  v_{1}\right)  \right)  _{j}%
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)
_{k}=\mathfrak{h}\left(  v_{1},v_{2}\right)  .
\end{align}

\end{lemma}

\item
\begin{align}
hv  &  =\left(
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{ee}\left(  h\right)  _{jk}e_{j}\otimes e_{k}^{d}\right)  \left(
%TCIMACRO{\dsum \limits_{1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq l\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v\right)  _{l}e_{j}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\mathcal{R}_{ee}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v\right)
_{k}\\
\sigma_{e}\left(  hv\right)   &  =\sigma_{e}\left(
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\mathcal{R}_{ee}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v\right)
_{k}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\overline{\mathcal{R}_{ee}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(
v\right)  _{k}}=\left[  \sigma_{e}h\sigma_{e}\right]  \left(  v\right)  .
\end{align}


\item
\begin{align}
\left(  \sigma_{e}h\sigma_{e}\right)  \sigma_{e}\left(  v\right)   &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\overline{\mathcal{R}_{ee}\left(  h\right)  _{jk}}\mathcal{R}%
_{e}\left(  v\right)  _{k}=\left[  \sigma_{e}h\sigma_{e}\right]  \sigma
_{e}\left(  v\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\mathcal{R}_{e}\left(  \sigma_{e}\left(  v\right)  \right)
_{k}\mathcal{R}_{ee}\left(  h^{\dagger}\right)  _{kj}\\
&  =%
%TCIMACRO{\dsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
e_{j\ }\left(
%TCIMACRO{\dsum \limits_{1\leq k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  \sigma_{e}\left(  v\right)  \right)  _{k}%
\mathcal{R}_{ee}\left(  h^{\dagger}\right)  _{kj}\right)  .
\end{align}


\item If $h=h^{\dagger}$%
\begin{equation}
\mathcal{R}_{ee}\left(  h^{\dagger}\right)  _{jk}=\overline{\mathcal{R}%
_{ee}\left(  h\right)  _{kj}}=\mathcal{R}_{ee}\left(  h\right)  _{jk}%
\end{equation}
and
\begin{equation}
\left(  \sigma_{e}h\sigma_{e}\right)  \sigma_{e}\left(  v\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
e_{j\ }\left(
%TCIMACRO{\dsum \limits_{1\leq k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  \sigma_{e}\left(  v\right)  \right)  _{k}%
\mathcal{R}_{ee}\left(  h\right)  _{kj}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\overline{\mathcal{R}_{ee}\left(  h\right)  _{jk}}\mathcal{R}%
_{e}\left(  \sigma_{e}\left(  v\right)  \right)  _{k}.
\end{equation}


\item
\begin{equation}
\left(  \sigma_{e}h\sigma_{e}\right)  w=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j\ }\overline{\mathcal{R}_{ee}\left(  h\right)  _{jk}}\mathcal{R}%
_{e}\left(  w\right)  _{k}.
\end{equation}


\item The forms $\mathfrak{h}$ are explicitly given by
\begin{equation}
\left\langle \left.  v_{1}\right\vert v_{2}\right\rangle _{\mathfrak{h}%
}\overset{\Delta}{=}\mathfrak{h}\left(  v_{1},v_{2}\right)  =\left[
\sum_{1\leq j\leq r}\mathcal{K}_{e}^{d}\left(  w_{j}^{d}\right)  \vee
x_{j}^{d}\right]  \left(  v_{1}\ ,v_{2}\right)  =\overline{\left[  \sum_{1\leq
j\leq r}\mathcal{K}_{e}^{d}\left(  w_{j}^{d}\right)  \vee x_{j}^{d}\right]
\left(  v_{2},v_{1}\right)  }=\overline{\mathfrak{h}\left(  v_{2}%
,v_{1}\right)  }=\overline{\left\langle \left.  v_{2}\right\vert
v_{1}\right\rangle }_{\mathfrak{h}},
\end{equation}
which can be seen from
\begin{equation}
\left[  2\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}^{d}\right]
\left(  v_{1},v_{2}\right)  =\left[  \left(  \mathcal{K}_{e}^{d}\left(
e_{j}^{d}\right)  \otimes e_{k}^{d}\right)  +\left(  e_{k}^{d}\otimes
\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \right)  \right]  \left(
v_{1},v_{2}\right)  =\overline{e_{j}^{d}\left(  v_{1}\right)  }e_{k}%
^{d}\left(  v_{2}\right)  +\overline{e_{k}^{d}\left(  v_{1}\right)  }e_{j}%
^{d}\left(  v_{2}\right)
\end{equation}
and%
\begin{gather}
\left[  2\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}^{d}\right]
\left(  v_{2},v_{1}\right)  =\left[  \left(  \mathcal{K}_{e}^{d}\left(
e_{j}^{d}\right)  \otimes e_{k}^{d}\right)  +\left(  e_{k}^{d}\otimes
\mathcal{K}^{d}\left(  e_{j}^{d}\right)  \right)  \right]  \left(  v_{2}%
,v_{1}\right)  =\overline{e_{j}^{d}\left(  v_{2}\right)  }e_{k}^{d}\left(
v_{1}\right)  +\overline{e_{k}^{d}\left(  v_{2}\right)  }e_{j}^{d}\left(
v_{1}\right) \\
\Downarrow\\
\overline{\left[  2\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}%
^{d}\right]  \left(  v_{2},v_{1}\right)  }=e_{j}^{d}\left(  v_{2}\right)
\overline{e_{k}^{d}\left(  v_{1}\right)  }+e_{k}^{d}\left(  v_{2}\right)
\overline{e_{j}^{d}\left(  v_{1}\right)  }=\overline{e_{j}^{d}\left(
v_{1}\right)  }e_{k}^{d}\left(  v_{2}\right)  +\overline{e_{k}^{d}\left(
v_{1}\right)  }e_{j}^{d}\left(  v_{2}\right)  .
\end{gather}

\end{enumerate}
\end{enumerate}

\begin{definition}
$\mathfrak{b}$-\emph{biorthogonal} bases sets $\left\{  \left.  e_{j}%
^{b}\right\vert 1\leq j\leq r\right\}  $ and $\left\{  \left.  e_{j}%
\right\vert 1\leq j\leq r\right\}  $ wrt a bilinear form $\mathfrak{b}$ are
bases that have the property
\begin{equation}
\mathfrak{b}\left(  e_{j}^{b},e_{k}\right)  =\delta_{jk},\quad1\leq j,k\leq r.
\end{equation}

\end{definition}

\begin{remark}
If $T\in GL\left(  V\right)  $ then conjugate bilinear forms can be defined
by
\begin{equation}
\left[  \left(  T^{d}\otimes T^{d}\right)  \mathfrak{b}\right]  \left(
v_{1},v_{2}\right)  =\left[  \sum_{1\leq j\leq r}\left(  Tw\right)  _{j}%
^{d}\otimes\left(  Tx\right)  _{j}^{d}\right]  \left(  v_{1}\otimes
v_{2}\right)  =\left[  \sum_{1\leq j\leq r}w_{j}^{d}\otimes x_{j}^{d}\right]
\left(  Tv_{1}\otimes Tv_{2}\right)  .
\end{equation}

\end{remark}

\begin{remark}
A complex \emph{nondegenerate} bilinear form $\mathfrak{b}$ defines a complex
linear injection $\mathcal{I}_{\mathfrak{b}}$ from the complex linear space
$V$ to its dual $V^{d}$
\begin{equation}
\mathcal{I}_{\mathfrak{b}}:V\rightarrow V^{d}%
\end{equation}
given by%
\begin{equation}
w_{1}^{d}=\mathcal{I}_{\mathfrak{b}}\left(  v_{1}\right)  ,
\end{equation}
where%
\begin{equation}
w_{1}^{d}\left(  v_{2}\right)  =\mathfrak{b}\left(  v_{1},v_{2}\right)
=\left[  \mathcal{I}_{\mathfrak{b}}\left(  v_{1}\right)  \right]  \left(
v_{2}\right)  ,\quad\forall v_{2}\in V.
\end{equation}

\end{remark}

\begin{definition}
The \emph{Form matrix} $\mathcal{M}_{e}\left(  \mathfrak{b}\right)
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ of $\mathfrak{b}$ wrt a basis
$\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ of $V$ is
\begin{equation}
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{b}\left(  e_{1},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{1},e_{r}\right) \\
\vdots & \ddots & \vdots\\
\mathfrak{b}\left(  e_{r},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{r},e_{r}\right)
\end{array}
\right)  .
\end{equation}

\end{definition}

\begin{lemma}%
\begin{align}
\mathfrak{b}\left(  T\boldsymbol{e},\boldsymbol{e}\right)   &  =\mathcal{R}%
_{ee}\left(  T\right)  ^{t}\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}%
\right) \\
\mathfrak{b}\left(  \boldsymbol{e},T\boldsymbol{e}\right)   &  =\mathfrak{b}%
\left(  \boldsymbol{e},\boldsymbol{e}\right)  \mathcal{R}_{ee}\left(
T\right)  .
\end{align}

\end{lemma}

\begin{proof}
In terms of matrix elements one has
\begin{equation}
\mathfrak{b}\left(  Te_{p},e_{q}\right)  =\mathfrak{b}\left(  \sum_{1\leq
j\leq r}e_{j}\mathcal{R}_{ee}\left(  T\right)  _{jp},e_{q}\right)
=\sum_{1\leq j\leq r}\mathcal{R}_{ee}\left(  T\right)  _{jp}\mathfrak{b}%
\left(  e_{j},e_{q}\right)  =\sum_{1\leq j\leq r}\mathcal{R}_{ee}\left(
T\right)  _{pj}^{t}\mathfrak{b}\left(  e_{j},e_{q}\right)
\end{equation}
and
\begin{equation}
\mathfrak{b}\left(  e_{p},Te_{q}\right)  =\mathfrak{b}\left(  e_{p}%
,\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{ee}\left(  T\right)  _{jq},\right)
=\sum_{1\leq j\leq r}\mathfrak{b}\left(  e_{p},e_{j}\right)  \mathcal{R}%
_{ee}\left(  T\right)  _{jq}.
\end{equation}

\end{proof}

\begin{corollary}%
\begin{equation}
\mathfrak{b}\left(  T\boldsymbol{e},T\boldsymbol{e}\right)  =\mathcal{R}%
_{ee}\left(  T\right)  ^{t}\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}%
\right)  \mathcal{R}_{ee}\left(  T\right)  .
\end{equation}

\end{corollary}

\begin{remark}
The Form matrices wrt different bases $\left(  \boldsymbol{e}\right)  $ and
$\left(  \boldsymbol{f}\right)  ,$ where
\begin{equation}
\left(  \boldsymbol{f}\right)  =T_{fe}\left(  \boldsymbol{e}\right)  =\left(
\boldsymbol{e}\right)  \mathcal{R}_{ee}\left(  T_{fe}\right)
\end{equation}
and
\begin{equation}
T_{fe}\in GL\left(  V\right)
\end{equation}
are related by
\begin{equation}
\mathfrak{b}\left(  \boldsymbol{f},\boldsymbol{f}\right)  =\mathfrak{b}\left(
T_{fe}\boldsymbol{e},T_{fe}\boldsymbol{e}\right)  =\mathcal{M}_{f}\left(
\mathfrak{b}\right)  =\mathcal{R}_{ee}\left(  T_{fe}\right)  ^{t}%
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  \mathcal{R}_{ee}\left(
T_{fe}\right)  =\mathcal{R}_{ee}\left(  T_{fe}\right)  ^{t}\mathfrak{b}\left(
\boldsymbol{e},\boldsymbol{e}\right)  \mathcal{R}_{ee}\left(  T_{fe}\right)  .
\end{equation}

\end{remark}

\begin{remark}
One can form dual basis $\left(  \mathbf{e}_{b}\right)  $ from $\left(
\boldsymbol{e}\right)  $ by forming the biorthogonal basis $\left(
\mathbf{e}_{b}\right)  $
\begin{equation}
\left(  \mathbf{e}_{b}\right)  =\left(  \left.  \boldsymbol{e}\right\vert
\boldsymbol{e}\right)  ^{-1}\left(  \boldsymbol{e}\right)  \overset{\Delta
}{=}\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  ^{-1}\left(
\boldsymbol{e}\right)
\end{equation}
and then defining
\begin{equation}
\boldsymbol{e}^{d}=\mathcal{I}_{\mathfrak{b}}\left(  \mathbf{e}_{b}\right)  ,
\end{equation}
where one uses the matrix SVD \label{matrix SVD}
\begin{equation}
\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  \equiv
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  =\left(  \mathcal{I}%
_{\mathfrak{b}}\boldsymbol{e}^{d}\right)  \left(  \boldsymbol{e}\right)
=\mathbb{U}\boldsymbol{\Sigma}\mathbb{V}%
\end{equation}
to obtain the inverse of the form matrix $\mathcal{M}_{e}\left(
\mathfrak{b}\right)  $
\begin{equation}
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  ^{-1}=\left(  \left[
\mathcal{I}_{\mathfrak{b}}\left(  \overset{}{\boldsymbol{e}^{d}}\right)
\right]  \left(  \overset{}{\boldsymbol{e}}\right)  \right)  ^{-1}%
=\mathbb{V}^{\dagger}\boldsymbol{\Sigma}^{-1}\mathbb{U}^{\dagger}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{gather}
\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  \equiv\left(
\left.  \boldsymbol{e}\right\vert \boldsymbol{e}\right)  =\mathcal{M}%
_{e}\left(  \mathfrak{b}\right) \\
\left(  \mathbf{e}_{b}\right)  =\mathcal{I}_{\mathfrak{b}}\left(  \left(
\boldsymbol{e}\right)  \left(  \left.  \boldsymbol{e}\right\vert
\boldsymbol{e}\right)  ^{-1}\right)  =\mathcal{I}_{\mathfrak{b}}\left(
\left(  \boldsymbol{e}\right)  \mathfrak{b}\left(  \boldsymbol{e}%
,\boldsymbol{e}\right)  ^{-1}\right)  =\mathcal{I}_{\mathfrak{b}}\left(
\left(  \mathbf{e}_{b}\right)  \right)  .
\end{gather}

\end{remark}

\begin{conjecture}
For each $\left(  \boldsymbol{e}\right)  $ the dual basis $\left(
\mathbf{e}_{b}\right)  $ \emph{is unique} thus the expression $\mathcal{I}%
_{\mathfrak{b}}\left(  \left(  \boldsymbol{e}\right)  \mathfrak{b}\left(
\boldsymbol{e},\boldsymbol{e}\right)  ^{-1}\right)  $ is independent of
$\mathfrak{b.}$
\end{conjecture}

\begin{remark}%
\begin{equation}
\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  \equiv
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  =\left(
\begin{array}
[c]{ccc}%
w_{1}^{d}\left(  e_{1}\right)  & \cdots & w_{1}^{d}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
w_{r}^{d}\left(  e_{1}\right)  & \cdots & w_{r}^{d}\left(  e_{r}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{I}_{\mathfrak{b}}\left(  e_{1}\right)  \left(  e_{1}\right)  & \cdots
& \mathcal{I}_{\mathfrak{b}}\left(  e_{1}\right)  \left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
\mathcal{I}_{\mathfrak{b}}\left(  e_{r}\right)  \left(  e_{1}\right)  & \cdots
& \mathcal{I}_{\mathfrak{b}}\left(  e_{r}\right)  \left(  e_{r}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{b}\left(  e_{1},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{1},e_{r}\right) \\
\vdots & \ddots & \vdots\\
\mathfrak{b}\left(  e_{r},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{r},e_{r}\right)
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{remark}
In finite dimensions the injections $\mathcal{I}_{V}$ are also surjective and
thus are isomorphisms.
\end{remark}

\subsection{Representations}

The matrix representation $\mathcal{R}_{e}\left(  A\right)  \in\mathcal{M}%
\left(  m,n,\mathbb{C}\right)  $ of $A\in\mathcal{B}\left(  W,V\right)  $ wrt
bases $\left\{  \left.  e_{j}\right\vert 1\leq j\leq n\right\}  $ and
$\left\{  \left.  f_{j}\right\vert 1\leq j\leq m\right\}  $ generated by the
linear map $A$ can be displayed as
\begin{equation}
A\left(  \boldsymbol{e}\right)  =A\left(  e_{1},\cdots,e_{n}\right)  =\left(
e_{1},\cdots,e_{n}\right)  \mathcal{R}_{ee}\left(  A\right)  =\left(
\boldsymbol{f}\right)  =\left(  e_{1},\cdots,e_{m}\right)  \mathcal{M}%
_{f^{d}e}\left(  A\right)  ,
\end{equation}
where the matrices $\mathcal{R}_{ee}\left(  A\right)  $ and $\mathcal{M}%
_{f^{d}e}\left(  A\right)  $ are given by
\begin{equation}
\mathcal{R}_{ee}\left(  A\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{ee}\left(  A\right)  _{11} & \cdots & \mathcal{R}_{ee}\left(
A\right)  _{1n}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{ee}\left(  A\right)  _{m1} & \cdots & \mathcal{R}_{ee}\left(
A\right)  _{mn}%
\end{array}
\right)  =\mathcal{M}_{f^{d}e}\left(  A\right)
\end{equation}
and%
\begin{equation}
\mathcal{M}_{f^{d}e}\left(  A\right)  =\left(
\begin{array}
[c]{ccc}%
f_{1}^{d}\left(  Ae_{1}\right)  & \cdots & f_{1}^{d}\left(  Ae_{n}\right) \\
\vdots & \ddots & \vdots\\
f_{m}^{d}\left(  Ae_{1}\right)  & \cdots & f_{m}^{d}\left(  Ae_{n}\right)
\end{array}
\right)  =\boldsymbol{f}^{d}\left(  A\boldsymbol{e}\right)  .
\end{equation}


\subsection{Tensor Product Spaces}

We consider the tensor product spaces

\begin{enumerate}
\item
\begin{equation}
W\otimes V^{d}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
f_{j}\otimes e_{k}^{d}\right\vert 1\leq k\leq m,1\leq k\leq n\right\}
\end{equation}
and

\item
\begin{equation}
W\otimes V=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
f_{j}\otimes e_{k}\right\vert 1\leq k\leq m,1\leq k\leq n\right\}  .
\end{equation}

\end{enumerate}

\begin{definition}
Of the product "$\#$"
\begin{align}
x\#y^{d}  &  \in\mathcal{B}\left(  W,V\right) \\
\left(  x\#y^{d}\right)  \left(  v\right)   &  =y^{d}\left(  v\right)
x\quad\forall v\in V,\,\,x\in W,\,y^{d}\in V^{d}.
\end{align}

\end{definition}

\begin{notation}%
\begin{equation}
E_{xy}\equiv x\#y^{d}.
\end{equation}

\end{notation}

\begin{theorem}
\label{GreuB Theorem} $\left(  \text{Greu\ss }\right)  $ If $a\in W\otimes V$
then
\begin{equation}
a=\sum_{1\leq j\leq p}w_{j}\otimes v_{j}\quad\in W\otimes V,\quad w_{j}\in
W,v_{j}\in V,\mathcal{\quad}1\leq j\leq p,
\end{equation}
where $p=\min\left(  m,n\right)  $, $\left\{  \left.  w_{j}\right\vert 1\leq
j\leq p\right\}  $ and $\left\{  \left.  v_{j}\right\vert 1\leq k\leq
p\right\}  $ are linearly independent sets of vectors in $W$ and $V$ respectively.
\end{theorem}

\begin{corollary}
If $W$ and $V$ are normed spaces one can express $a\in W\otimes V$ in terms of
normed vectors as
\begin{equation}
a=\sum_{1\leq j\leq p}\sigma_{j}\widetilde{w_{j}}\otimes\widetilde{v_{j}},
\end{equation}
where

\begin{enumerate}
\item The vectors $\widetilde{w_{j}},\widetilde{v_{j}},1\leq j\leq p$ are
normalized
\begin{equation}
\left\Vert \widetilde{w_{j}}\right\Vert _{W}=\left\Vert \widetilde{v_{j}%
}\right\Vert _{V}=1,\quad1\leq j\leq p
\end{equation}
i.e.

\item
\begin{align}
\widetilde{w_{j}}  &  =\frac{w_{j}}{\left\Vert w_{j}\right\Vert _{W}}\\
\widetilde{v_{j}}  &  =\frac{v_{j}}{\left\Vert v_{j}\right\Vert _{V}}\\
1  &  \leq j\leq p
\end{align}
where

\item $\sigma_{j},$ $1\leq j\leq p$ are positive
\begin{equation}
\sigma_{j}>0,\quad1\leq j\leq p.
\end{equation}

\end{enumerate}
\end{corollary}

\begin{theorem}
The spaces $\mathcal{B}_{00}\left(  W,V\right)  $,$W\otimes V^{d}$ and
$W\otimes V$ are linearly isomorphic i.e.
\begin{equation}
\mathcal{B}_{00}\left(  W,V\right)  \cong W\otimes V^{d}\cong W\otimes V,
\end{equation}
where the isomorphisms, denoted by $\Xi_{T},\,T=WV^{d},WV$ are given by
\end{theorem}

\begin{enumerate}
\item
\begin{gather}
\Xi_{WV^{d}}:W\otimes V^{d}\rightarrow\mathcal{B}_{00}\left(  W,V\right) \\
\Xi_{WV^{d}}\left(  f_{j}\otimes e_{k}^{d}\right)  =f_{j}\#e_{k}^{d}%
=f_{j}\left[  e_{k}^{d}\right]  \equiv E_{fe}.
\end{gather}
and

\item
\begin{gather}
\Xi_{WV}:W\otimes V\rightarrow\mathcal{B}_{00}\left(  W,V\right) \\
\Xi_{WV}\left(  f_{j}\otimes e_{k}\right)  =f_{j}\#e_{k}^{d}=f_{j}\left[
e_{k}^{d}\right]  \equiv E_{fe}.
\end{gather}

\end{enumerate}

\begin{lemma}
The mapping $A\in\mathcal{B}_{00}\left(  W,V\right)  $ can be expanded as
\[
A=\sum_{1\leq j\leq p}E_{\eta_{j}\varsigma_{j}}=\sum_{1\leq j\leq p}\eta
_{j}\#\varsigma_{j}^{d}=\sum_{1\leq j\leq p}\widetilde{\eta_{j}}\#\left(
\sigma_{j}\widetilde{\varsigma_{j}}^{d}\right)  =\sum_{1\leq j\leq p}%
\sigma_{j}\widetilde{\eta}_{j}^{d}\#\widetilde{\varsigma}_{j}=\left(
\widetilde{\boldsymbol{\eta}}\right)  \mathcal{R}_{\boldsymbol{\varsigma}%
}\left(  A\right)  \left(  \widetilde{\boldsymbol{\varsigma}}^{d}\right)
^{t}=\left(  \widetilde{\boldsymbol{\eta\#\varsigma}^{d}}\right)
\cdot\mathcal{R}_{\boldsymbol{\varsigma}}\left(  A\right)  ,
\]
where
\begin{equation}
\widetilde{\eta_{j}}=\sigma_{j}^{\frac{1}{2}}\eta_{j}%
\end{equation}
and
\begin{equation}
\widetilde{\varsigma_{j}}=\sigma_{j}^{\frac{1}{2}}\varsigma_{j}.
\end{equation}

\end{lemma}

\begin{remark}
The expansion of $A$ wrt a general bases is
\begin{equation}
A=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}E_{f_{j}e_{k}}\mathcal{R}%
_{\boldsymbol{e}}\left(  A\right)  _{jk}.
\end{equation}

\end{remark}

\subsection{Change of Bases and Maps Between Hilbert Spaces}

If $W$ and $V$ are Hilbert spaces

\begin{enumerate}
\item The coordinates of $v$ and $w$ are given by
\begin{align}
e_{j}^{d}\left(  v\right)   &  =\left\langle \left.  e_{j}\right\vert
v\right\rangle _{V},\quad1\leq j\leq n\\
f_{j}^{d}\left(  w\right)   &  =\left\langle \left.  f_{j}\right\vert
w\right\rangle _{W},\quad1\leq j\leq m,
\end{align}
where $\left(  \boldsymbol{e}\right)  $ and $\left(  \boldsymbol{f}\right)  $
are conb's.

\item The dual functionals can be expressed in terms of the inner product
$\left\langle \left.  {}\right\vert \right\rangle _{V}$
\begin{align}
\left\langle \left.  a\right\vert b\right\rangle _{V}  &  =a^{d}\left(
b\right)  =\sum_{1\leq j,k\leq n}\mathcal{R}_{e^{d}}\left(  a\right)
_{j}\mathcal{R}_{e}\left(  b\right)  _{j}e_{j}^{d}\left(  e_{k}\right)
=\sum_{1\leq j,k\leq n}\mathcal{R}_{e^{d}}\left(  a\right)  _{j}%
\mathcal{R}_{e}\left(  b\right)  _{j}=\sum_{1\leq j,k\leq n}\overline
{\mathcal{R}_{e}\left(  a\right)  _{j}}\left\langle \left.  \boldsymbol{e}%
\right\vert \boldsymbol{e}\right\rangle _{jk}\mathcal{R}_{e}\left(  b\right)
_{k}\\
&  =\mathcal{R}_{e^{d}}\left(  a\right)  ^{\dagger}\left\langle \left.
\boldsymbol{e}\right\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left(
b\right) \\
a^{d}  &  =\sum_{1\leq k\leq n}e_{k}^{d}\left(  \sum_{1\leq j\leq n}%
\overline{\mathcal{R}_{e}\left(  a\right)  _{j}}\left\langle \left.
\boldsymbol{e}\right\vert \boldsymbol{e}\right\rangle _{jk}\right)
=\sum_{1\leq k\leq n}e_{k}^{d}\mathcal{R}_{e^{d}}\left(  a\right)  _{k}\\
\mathcal{R}_{e^{d}}\left(  a\right)  _{k}  &  =\sum_{1\leq j\leq n}%
\overline{\mathcal{R}_{e}\left(  a\right)  _{j}}\left\langle \left.
\boldsymbol{e}\right\vert \boldsymbol{e}\right\rangle _{jk}\\
\mathcal{R}_{e^{d}}\left(  a\right)   &  =\overline{\mathcal{R}_{e}\left(
a\right)  }\left\langle \left.  \boldsymbol{e}\right\vert \boldsymbol{e}%
\right\rangle .
\end{align}


\item Using the real linear maps $\left\{  \operatorname{Re}_{e}%
,\operatorname{Im}_{e}\right\}  $ the inner product $\left\langle \left.
{}\right\vert \right\rangle _{V}$ can be expressed in a basis independent
fashion for any $\left(  \boldsymbol{e}\right)  $ as
\begin{gather}
\left\langle \left.  \left(  \operatorname{Re}_{e}\left(  a\right)
+i\operatorname{Im}_{e}\left(  a\right)  \right)  \right\vert \left(
\operatorname{Re}_{e}\left(  b\right)  +i\operatorname{Im}_{e}\left(
b\right)  \right)  \right\rangle _{V}\\
\parallel\\
\left\langle \left.  \operatorname{Re}_{e}\left(  a\right)  \right\vert
\operatorname{Re}_{e}\left(  b\right)  \right\rangle _{V}+\left\langle \left.
\operatorname{Im}_{e}\left(  a\right)  \right\vert \operatorname{Im}%
_{e}\left(  b\right)  \right\rangle _{V}+i\left(  \left\langle \left.
\operatorname{Re}_{e}\left(  a\right)  \right\vert \operatorname{Im}%
_{e}\left(  b\right)  \right\rangle _{V}-\left\langle \left.
\operatorname{Im}_{e}\left(  a\right)  \right\vert \operatorname{Re}%
_{e}\left(  b\right)  \right\rangle _{V}\right) \\
\parallel\\
\left(  \left.  \overset{}{\operatorname{Re}_{e}\left(  a\right)
\oplus\operatorname{Im}_{e}\left(  a\right)  }\right\vert \operatorname{Re}%
_{e}\left(  b\right)  \oplus\operatorname{Im}_{e}\left(  b\right)  \right)
_{V_{R}}+i\left\{  \left.  \overset{}{\operatorname{Re}_{e}\left(  a\right)
\oplus\operatorname{Im}_{e}\left(  a\right)  }\right\vert \operatorname{Re}%
_{e}\left(  b\right)  \oplus\operatorname{Im}_{e}\left(  b\right)  \right\}
_{V_{R}}\\
\parallel\\
\left(  \left.  \overset{}{\left(  \operatorname{Re}_{e}\left(  a\right)
,\operatorname{Im}_{e}\left(  a\right)  \right)  }\right\vert \left(
\operatorname{Re}_{e}\left(  b\right)  ,\operatorname{Im}_{e}\left(  b\right)
\right)  \right)  _{V_{R}}+i\left\{  \left.  \overset{}{\left(
\operatorname{Re}_{e}\left(  a\right)  ,\operatorname{Im}_{e}\left(  a\right)
\right)  }\right\vert \left(  \operatorname{Re}_{e}\left(  b\right)
,\operatorname{Im}_{e}\left(  b\right)  \right)  \right\}  _{V_{R}}%
\end{gather}


\begin{enumerate}
\item The real symmetric inner product
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{V_{R}}:V_{R}\times V_{R}%
\rightarrow\mathbb{R}%
\end{equation}
and the real symplectic form
\begin{equation}
\left\{  \left.  {}\right\vert \right\}  _{V_{R}}:V_{R}\times V_{R}%
\rightarrow\mathbb{R}%
\end{equation}
are defined on the real space $V_{R}$, which is defined as
\begin{equation}
V_{R}=V_{\mathbb{R}}\oplus_{\mathbb{R}}V_{\mathbb{R}}.
\end{equation}


\item The space $V_{\mathbb{R}}$ is defined
\begin{equation}
V_{\mathbb{R}}=\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\operatorname{Re}_{e}\left(  a\right)  \right\vert a\in V\right\}
\cong\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\operatorname{Im}_{e}\left(  a\right)  \right\vert a\in V\right\}
\end{equation}


\item $\operatorname{Re}_{e}\left(  a\right)  $ and $\operatorname{Im}%
_{e}\left(  a\right)  $ belong to a real vector space
\begin{align}
\operatorname{Re}_{e}\left(  a\right)   &  \in V_{\mathbb{R}}=\mathbb{R}%
\text{-}\operatorname*{linspan}\left\{  \left.  e_{j}\right\vert 1\leq j\leq
n\right\} \\
\operatorname{Im}_{e}\left(  a\right)   &  \in V_{\mathbb{R}}=\mathbb{R}%
\text{-}\operatorname*{linspan}\left\{  \left.  e_{j}\right\vert 1\leq j\leq
n\right\}  .
\end{align}


\item The real vector spaces $\left\{  \left.  \operatorname{Re}_{e}\left\{
V\right\}  \right\vert e\in\left[  \boldsymbol{e}\right]  \right\}  $ are
different for different equivalence classes $\left[  \boldsymbol{e}\right]  $
of bases but are real isomorphic.

\item The real vector spaces $\left\{  \left.  \operatorname{Im}_{e}\left\{
V\right\}  \right\vert e\in\left[  \boldsymbol{e}\right]  \right\}  $ are
different for different equivalence classes $\left[  \boldsymbol{e}\right]  $
of bases but are real isomorphic.

\item The real vector spaces $\operatorname{Re}_{e}\left\{  V\right\}  $ and
$\operatorname{Im}_{f}\left\{  V\right\}  $ are real isomorphic for all
$\left(  \boldsymbol{e}\right)  $ and $\left(  \boldsymbol{f}\right)  .$
\end{enumerate}

\item The dual basis $\left(  \mathbf{e}_{b}\right)  $ can be defined in terms
of the $\left\langle \left.  {}\right\vert \right\rangle $-biorthogonal basis
$\left\vert \mathbf{e}^{b}\right\rangle $ as
\begin{align}
\mathbf{e}_{b}\left(  \mathbf{e}\right)   &  =\left(  \mathbf{e}_{b}\right)
^{t}\cdot\left(  \mathbf{e}\right)  =\left\langle \left.  \mathbf{e}%
^{b}\right\vert \mathbf{e}\right\rangle =\left\langle \mathbf{e}%
^{b}\right\vert \cdot\left\vert \mathbf{e}\right\rangle =\left(
\begin{array}
[c]{c}%
\left\langle e_{1}^{b}\right\vert \\
\vdots\\
\left\langle e_{r}^{b}\right\vert
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right\rangle  & \cdots & \left\vert e_{r}\right\rangle
\end{array}
\right) \\
&  =\left\langle \left(  \mathbf{e}\right)  \left\langle \left.
\mathbf{e}\right\vert \mathbf{e}\right\rangle ^{-1}\right\vert \cdot\left\vert
\mathbf{e}\right\rangle =\left(  \left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right)
\left\vert \mathbf{e}\right\rangle =\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle ^{-1}\left\langle \left.  \mathbf{e}\right\vert
\mathbf{e}\right\rangle =\mathbb{I}_{r},
\end{align}
where
\[
\left\vert \mathbf{e}_{b}\right\rangle =\left(
\begin{array}
[c]{ccc}%
e_{1}^{b} & \cdots & e_{n}^{b}%
\end{array}
\right)  =\left(  \mathbf{e}\right)  \left\langle \left.  \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(  \left(
\begin{array}
[c]{c}%
\left\langle e_{1}\right\vert \\
\vdots\\
\left\langle e_{r}\right\vert
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{ccc}%
\left\vert e_{1}\right\rangle  & \cdots & \left\vert e_{r}\right\rangle
\end{array}
\right)  \right)  ^{-1}.
\]


\item The elementary operators $E_{f_{j}e_{k}}$ are given by
\begin{align*}
E_{f_{j}e_{k}}  &  =f_{j}\#e_{k}^{d}=f_{j}e_{k}^{d}=\left[  f_{j}e_{k}%
^{d}\right]  =\left\vert f_{j}\right\rangle \left\langle e_{k}\right\vert
\in\mathcal{B}\left(  W,V\right) \\
\left\vert f_{k}\right\rangle \left\langle e_{j}\right\vert  &  =\left\vert
e_{j}\right\rangle \left\langle f_{k}\right\vert ^{\dagger}=\left(
E_{e_{j}f_{k}}\right)  ^{\dagger}\in\mathcal{B}\left(  V,W\right)  .
\end{align*}


\item The transpose of a mapping $A\ $is given by
\begin{gather}
A^{t}=\left(  \sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}E_{f_{j}e_{k}%
}\mathcal{R}_{\boldsymbol{ee}}\left(  A\right)  _{jk}\right)  ^{t}=\left(
\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{j}e_{k}^{d}\right]
\mathcal{R}_{\boldsymbol{ee}}\left(  A\right)  _{jk}\right)  ^{t}%
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  e_{k}f_{j}^{d}\right]
\mathcal{R}_{\boldsymbol{ee}}\left(  A\right)  _{jk}\\
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  e_{k}f_{j}^{d}\right]
\mathcal{R}_{\boldsymbol{ee}}\left(  A^{t}\right)  _{kj}=\sum_{\substack{1\leq
j\leq m\\1\leq k\leq n}}\left[  e_{k}f_{j}^{d}\right]  \left(  \mathcal{R}%
_{\boldsymbol{ee}}\left(  A\right)  ^{t}\right)  _{jk}.
\end{gather}


\item Resolutions of the identity can be expressed as
\begin{align*}
\left\vert \mathbf{u}\right\rangle \left\langle \mathbf{u}\right\vert  &
=I_{W}\\
\left\vert \mathbf{v}\right\rangle \left\langle \mathbf{v}\right\vert  &
=I_{V}.
\end{align*}


\item \textbf{The operator SVD \label{operator SVD}}

\begin{enumerate}
\item
\begin{align*}
A  &  =\left\vert \mathbf{u}\right\rangle \left\langle \mathbf{u}\right\vert
\left(  \overset{}{\left\vert \boldsymbol{f}\right\rangle \mathcal{R}%
_{ee}\left(  A\right)  \left\langle \boldsymbol{e}\right\vert }\right)
\left\vert \mathbf{v}\right\rangle \left\langle \mathbf{v}\right\vert \\
&  =\left\vert \mathbf{u}\right\rangle \left(  \overset{}{\left\langle
\mathbf{u}\right\vert \left(  \overset{}{\left\vert \boldsymbol{f}%
\right\rangle \mathcal{R}_{ee}\left(  A\right)  \left\langle \boldsymbol{e}%
\right\vert }\right)  \left\vert \mathbf{v}\right\rangle }\right)
\left\langle \mathbf{v}\right\vert \\
&  =\left\vert \mathbf{u}\right\rangle \mathcal{R}_{uu}\left(  A\right)
\left\langle \mathbf{v}\right\vert .
\end{align*}


\item
\begin{equation}
A=\left\vert \mathbf{u}\right\rangle \left(  \overset{}{\left\langle
\mathbf{u}\right\vert \left(  \overset{}{\left\vert \boldsymbol{f}%
\right\rangle \mathcal{R}_{ee}\left(  A\right)  \left\langle \boldsymbol{e}%
\right\vert }\right)  \left\vert \mathbf{v}\right\rangle }\right)
\left\langle \mathbf{v}\right\vert =
\end{equation}

\end{enumerate}

\item \textbf{The matrix SVD \label{The matrix SVD} }%
\[
\mathcal{R}_{uu}\left(  A\right)  =\left(  \overset{}{\left\langle
\mathbf{u}\right\vert \left\vert \boldsymbol{f}\right\rangle }\right)  \left(
\overset{}{\mathcal{R}_{ee}\left(  A\right)  }\right)  \left(
\overset{}{\left\langle \boldsymbol{e}\right\vert \left\vert \mathbf{v}%
\right\rangle }\right)  .
\]


\item Transformation of bases are given by
\begin{align*}
\mathbf{u\#}\boldsymbol{f}^{d}  &  =T_{uf}=\left\vert \mathbf{u}\right\rangle
\left\langle \boldsymbol{f}\right\vert \in\mathcal{B}\left(  W\right) \\
\boldsymbol{f}\mathbf{\#}\boldsymbol{u}^{d}  &  =T_{uf}^{\dagger}=\left\vert
\boldsymbol{f}\right\rangle \left\langle \mathbf{u}\right\vert \in
\mathcal{B}\left(  W\right) \\
\mathbf{v\#}\boldsymbol{e}^{d}  &  =T_{ve}=\left\vert \mathbf{v}\right\rangle
\left\langle \boldsymbol{e}\right\vert \in\mathcal{B}\left(  V\right) \\
\boldsymbol{e}\mathbf{\#v}^{d}  &  =T_{ve}^{\dagger}=\left\vert \boldsymbol{e}%
\right\rangle \left\langle \mathbf{v}\right\vert \in\mathcal{B}\left(
V\right)  .
\end{align*}


\item Thes transformations are unitary i.e.%
\begin{align*}
T_{uf}T_{uf}^{\dagger}  &  =T_{uf}^{\dagger}T_{uf}=I_{W}\\
T_{ve}T_{ve}^{\dagger}  &  =T_{ve}^{\dagger}T_{ve}=I_{V}.
\end{align*}


\item Representations of bases transformations are given by
\begin{align*}
\mathcal{R}_{ff}\left(  T_{uf}\right)   &  =\mathcal{M}_{f}\left(  \left\vert
\mathbf{u}\right\rangle \left\langle \boldsymbol{f}\right\vert \right)
=\mathcal{R}_{ff}\left(  \left\vert \mathbf{u}\right\rangle \left\langle
\boldsymbol{f}\right\vert \right)  =\left\langle \left.  \boldsymbol{f}%
\right\vert \mathbf{u}\right\rangle \in\mathcal{M}\left(  W,W,\mathbb{C}%
\right)  \equiv\mathcal{M}\left(  m,m,\mathbb{C}\right) \\
\mathcal{R}_{ff}\left(  T_{uf}^{\dagger}\right)   &  =\mathcal{M}_{f}\left(
\left\vert \boldsymbol{f}\right\rangle \left\langle \mathbf{u}\right\vert
\right)  =\mathcal{R}_{ff}\left(  \left\vert \boldsymbol{f}\right\rangle
\left\langle \mathbf{u}\right\vert \right)  =\left\langle \left.
\boldsymbol{u}\right\vert \boldsymbol{f}\right\rangle \in\mathcal{M}\left(
W,W,\mathbb{C}\right)  \equiv\mathcal{M}\left(  m,m,\mathbb{C}\right) \\
\mathcal{R}_{u}\left(  T_{uf}\right)   &  =\mathcal{M}_{u}\left(  \left\vert
\mathbf{u}\right\rangle \left\langle \boldsymbol{f}\right\vert \right)
=\mathcal{R}_{u}\left(  \left\vert \mathbf{u}\right\rangle \left\langle
\boldsymbol{f}\right\vert \right)  =\left\langle \left.  \boldsymbol{f}%
\right\vert \mathbf{u}\right\rangle \in\mathcal{M}\left(  W,W,\mathbb{C}%
\right)  \equiv\mathcal{M}\left(  m,m,\mathbb{C}\right) \\
\mathcal{R}_{u}\left(  T_{uf}^{\dagger}\right)   &  =\mathcal{M}_{u}\left(
\left\vert \boldsymbol{f}\right\rangle \left\langle \mathbf{u}\right\vert
\right)  =\mathcal{R}_{u}\left(  \left\vert \boldsymbol{f}\right\rangle
\left\langle \mathbf{u}\right\vert \right)  =\left\langle \left.
\boldsymbol{u}\right\vert \boldsymbol{f}\right\rangle \in\mathcal{M}\left(
W,W,\mathbb{C}\right)  \equiv\mathcal{M}\left(  m,m,\mathbb{C}\right) \\
\mathcal{R}_{ee}\left(  T_{ve}\right)   &  =\mathcal{M}_{v}\left(  \left\vert
\mathbf{v}\right\rangle \left\langle \boldsymbol{\varsigma}\right\vert
\right)  =\mathcal{R}_{ee}\left(  \left\vert \mathbf{v}\right\rangle
\left\langle \boldsymbol{e}\right\vert \right)  =\left\langle \left.
\boldsymbol{e}\right\vert \mathbf{v}\right\rangle \in\mathcal{M}\left(
V,V,\mathbb{C}\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right) \\
\mathcal{R}_{ee}\left(  T_{ve}^{\dagger}\right)   &  =\mathcal{M}_{e}\left(
\left\vert \boldsymbol{e}\right\rangle \left\langle \mathbf{v}\right\vert
\right)  =\mathcal{R}_{ee}\left(  \left\vert \boldsymbol{e}\right\rangle
\left\langle \mathbf{v}\right\vert \right)  =\left\langle \left.
\mathbf{v}\right\vert \boldsymbol{e}\right\rangle \in\mathcal{M}\left(
V,V,\mathbb{C}\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right) \\
\mathcal{R}_{vv}\left(  T_{ve}\right)   &  =\mathcal{M}_{v}\left(  \left\vert
\mathbf{v}\right\rangle \left\langle \boldsymbol{e}\right\vert \right)
=\mathcal{R}_{v}\left(  \left\vert \mathbf{v}\right\rangle \left\langle
\boldsymbol{e}\right\vert \right)  =\left\langle \left.  \boldsymbol{e}%
\right\vert \mathbf{v}\right\rangle \in\mathcal{M}\left(  V,V,\mathbb{C}%
\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right) \\
\mathcal{R}_{vv}\left(  T_{ve}^{\dagger}\right)   &  =\mathcal{M}_{v}\left(
\left\vert \boldsymbol{e}\right\rangle \left\langle \mathbf{v}\right\vert
\right)  =\mathcal{R}_{v}\left(  \left\vert \boldsymbol{e}\right\rangle
\left\langle \mathbf{v}\right\vert \right)  =\left\langle \left.
\mathbf{v}\right\vert \boldsymbol{e}\right\rangle \in\mathcal{M}\left(
V,V,\mathbb{C}\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right)  .
\end{align*}

\end{enumerate}

\subsection{Operator SVD}

\begin{theorem}
\label{Theorem Operator SVD} The Singular Valued Decomposition of any operator
$A\in\mathcal{B}_{0}\left(  W,V\right)  $ is given by the expansion
\begin{equation}
A=\sum_{1\leq j\leq p}E_{w_{j}v_{dj}}\mathcal{R}_{ee}\left(  A\right)
_{jj}=\sum_{1\leq j\leq p}w_{j}\#v_{dj}\mathcal{R}_{\varsigma}\left(
A\right)  _{jj}=\sum_{1\leq j\leq p}\Xi_{WV}\left(  w_{j}\otimes v_{j}\right)
\mathcal{R}_{ee}\left(  A\right)  _{jj}=\Xi_{WV}\left(  \sum_{1\leq j\leq
p}w_{j}\otimes v_{j}\mathcal{R}_{ee}\left(  A\right)  _{jj}\right)
=\sum_{1\leq j\leq p}w_{j}\mathcal{R}_{ee}\left(  A\right)  _{jj}\left[
v_{dj}\right]  ,
\end{equation}
where
\begin{equation}
p=\min\left(  \dim\left(  W\right)  ,\dim\left(  V\right)  \right)  .
\end{equation}

\end{theorem}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
b_{WV^{d}}=b=\sum_{1\leq j\leq p\leq\min\left(  m,n\right)  }\alpha_{j}%
\otimes\beta_{dj},\quad\alpha_{j}\in W,\,\beta_{dj}\in V^{d},\,1\leq j\leq
p\leq\min\left(  m,n\right)
\end{equation}


\item In the Hilbert space case $V,W=\mathcal{H},$ $\Xi_{WV}=$ $\Xi
_{\mathcal{H}}$
\begin{align}
A  &  =\Xi_{WV}\left(  b_{WV^{d}}\right)  =\Xi_{WV}\left(  b\right)
=\sum_{1\leq j\leq p\leq\min\left(  m,n\right)  }\Xi_{WV}\left(  \alpha
_{j}\otimes\beta_{dj}\right)  =\sum_{1\leq j\leq p\leq\min\left(  m,n\right)
}\left\vert \alpha_{j}^{{}}\right\rangle \left\langle \beta_{j}^{{}%
}\right\vert ,\\
\quad\alpha_{j},\beta_{j}  &  \in\mathcal{H},\,1\leq j\leq p\leq\min\left(
m,n\right)
\end{align}


\item Expansion in Orthonormal Basis

\begin{enumerate}
\item
\begin{align}
A  &  =\sum_{1\leq j\leq p\leq\min\left(  m,n\right)  }\left\vert \alpha
_{j}^{{}}\right\rangle \left\langle \beta_{j}^{{}}\right\vert =\left\vert
\boldsymbol{\alpha}\right\rangle \left\langle \boldsymbol{\beta}\right\vert
=\left\vert \left(  \boldsymbol{\alpha}\right)  ^{t}\right\rangle \left\langle
\left(  \boldsymbol{\beta}\right)  \right\vert \overset{\text{Polar
Decomposition }}{=}\left(  \left\vert \boldsymbol{w}\right\rangle \left\langle
\left.  \boldsymbol{\alpha}\right\vert \boldsymbol{\alpha}\right\rangle
^{\frac{1}{2}}\right)  ^{t}\left(  \left\langle \left.  \boldsymbol{\beta
}\right\vert \boldsymbol{\beta}\right\rangle ^{\frac{1}{2}}\left\langle
\boldsymbol{v}\right\vert \right) \\
&  =\sum_{1\leq j\leq p\leq\min\left(  m,n\right)  }\sum_{1\leq k,l\leq
p}\left\vert \boldsymbol{w}_{k}\right\rangle \left(  \left\langle \left.
\boldsymbol{\alpha}\right\vert \boldsymbol{\alpha}\right\rangle ^{\frac{1}{2}%
}\right)  _{kj}\left(  \left\langle \left.  \boldsymbol{\beta}\right\vert
\boldsymbol{\beta}\right\rangle ^{\frac{1}{2}}\right)  _{lj}\left\langle
\boldsymbol{v}_{l}\right\vert =\sum_{1\leq j\leq p\leq\min\left(  m,n\right)
}\sum_{1\leq k,l\leq p}\left\vert \boldsymbol{w}_{k}\right\rangle \left(
\left\langle \left.  \boldsymbol{\alpha}\right\vert \boldsymbol{\alpha
}\right\rangle ^{\frac{1}{2}}\left\langle \left.  \boldsymbol{\beta
}\right\vert \boldsymbol{\beta}\right\rangle ^{\frac{1}{2}}\right)
_{kl}\left\langle \boldsymbol{v}_{l}\right\vert
\end{align}


\item
\begin{gather}
A=\left\vert \left(
\begin{array}
[c]{ccc}%
\alpha_{1} & \cdots & \alpha_{p}%
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
\beta_{1}\\
\vdots\\
\beta_{m}%
\end{array}
\right)  \right\vert =\left(
\begin{array}
[c]{ccc}%
\left\vert \alpha_{1}\right\rangle  & \cdots & \left\vert \alpha
_{p}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\left\langle \beta_{1}\right\vert \\
\vdots\\
\left\langle \beta_{m}\right\vert
\end{array}
\right) \\
\overset{\text{{\Large Polar Decomposition}}}{\parallel}\\
\left(
\begin{array}
[c]{ccc}%
\left\vert w_{1}\right\rangle  & \cdots & \left\vert w_{p}\right\rangle
\end{array}
\right)  \left(
