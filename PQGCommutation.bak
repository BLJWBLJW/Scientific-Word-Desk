_{4}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\end{align}%
\begin{align}
&  +\lambda_{1334}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{3}\psi_{4}\right\vert +\lambda_{3413}\left\vert \psi_{3}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1313}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\\
&  \lambda_{1434}\left\vert \psi_{1}\psi_{4}\right\rangle \left\langle
\psi_{3}\psi_{4}\right\vert +\lambda_{3414}\left\vert \psi_{3}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{4}\right\vert +\lambda
_{1314}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{4}\right\vert +\lambda_{1413}\left\vert \psi_{1}\psi_{4}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert
