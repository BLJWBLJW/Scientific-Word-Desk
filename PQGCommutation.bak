\wedge\varphi_{3}\wedge\varphi_{4}\right\vert \nonumber
\end{align}%
\begin{align}
&  =12\left\{  \lambda_{21212}\lambda_{21313}+\lambda_{21212}\lambda
_{22323}+\lambda_{21313}\lambda_{22323}\right\}  \left\vert \varphi_{1}%
\wedge\varphi_{2}\wedge\varphi_{3}\right\rangle \left\langle \varphi_{1}%
\wedge\varphi_{2}\wedge\varphi_{3}\right\vert \nonumber\\
&  +12\left\{  \lambda_{21212}\lambda_{21414}+\lambda_{21212}\lambda
_{22424}+\lambda_{21414}\lambda_{22424}\right\}  \left\vert \varphi_{1}%
\wedge\varphi_{2}\wedge\varphi_{4}\right\rangle \left\langle \varphi_{1}%
\wedge\varphi_{2}\wedge\varphi_{4}\right\vert \nonumber\\
&  +12\left\{  \lambda_{21313}\lambda_{21414}+\lambda_{21313}\lambda
_{23434}+\lambda_{21414}\lambda_{23434}\right\}  \left\vert \varphi_{1}%
\wedge\varphi_{3}\wedge\varphi_{4}\right\rangle \left\langle \varphi_{1}%
\wedge\varphi_{3}\wedge\varphi_{4}\right\vert \nonumber\\
&  +12\left\{  \lambda_{22323}\lambda_{22424}+\lambda_{22323}\lambda
_{23434}+\lambda_{22424}\lambda_{23434}\right\}  \left\vert \varphi_{2}%
\wedge\varphi_{3}\wedge\varphi_{4}\right\rangle \left\langle \varphi_{2}%
\wedge\varphi_{3}\wedge\varphi_{4}\right\vert \nonumber
\end{align}
$\rfloor$Consider
\begin{align*}
\hat{\lambda}_{2}  &  =\frac{1}{2}\left\{  \lambda_{21212}\left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert +\lambda_{21313}\left\vert \varphi_{1}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\right\vert +\lambda_{21414}\left\vert
\varphi_{1}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi
_{4}\right\vert \right. \\
&  +\lambda_{22323}\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert +\lambda_{22424}\left\vert \varphi
_{2}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi_{4}\right\vert
+\lambda_{23434}\left\vert \varphi_{3}\varphi_{4}\right\rangle \left\langle
\varphi_{3}\varphi_{4}\right\vert \\
&  +\lambda_{22121}\left\vert \varphi_{2}\varphi_{1}\right\rangle \left\langle
\varphi_{2}\varphi_{1}\right\vert +\lambda_{23131}\left\vert \varphi
_{3}\varphi_{1}\right\rangle \left\langle \varphi_{3}\varphi_{1}\right\vert
+\lambda_{24141}\left\vert \varphi_{4}\varphi_{1}\right\rangle \left\langle
\varphi_{4}\varphi_{1}\right\vert \\
&  +\left.  \lambda_{23232}\left\vert \varphi_{3}\varphi_{2}\right\rangle
\left\langle \varphi_{3}\varphi_{2}\right\vert +\lambda_{24242}\left\vert
\varphi_{4}\varphi_{2}\right\rangle \left\langle \varphi_{4}\varphi
_{2}\right\vert +\lambda_{24343}\left\vert \varphi_{4}\varphi_{3}\right\rangle
\left\langle \varphi_{4}\varphi_{3}\right\vert \right\}
\end{align*}
this gives
\begin{align*}
L_{2}^{1}\left(  \hat{\lambda}_{2}\right)   &  =\frac{1}{4}\left\{
\lambda_{21212}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right)  +\lambda_{21313}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)  +\lambda
_{21414}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right)  \right. \\
&  +\lambda_{22121}\left(  \left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right)  +\lambda_{23131}\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{3}\right\rangle \left\langle \varphi_{3}\right\vert \right)  +\lambda
_{24141}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right) \\
&  +\lambda_{22323}\left(  \left\vert \varphi_{3}\right\rangle \left\langle
\varphi_{3}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert \right)  +\lambda_{22424}\left(  \left\vert \varphi
_{4}\right\rangle \left\langle \varphi_{4}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right)  +\lambda
_{23434}\left(  \left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert +\left\vert \varphi_{4}\right\rangle \left\langle \varphi
_{4}\right\vert \right) \\
&  +\left.  \lambda_{23232}\left(  \left\vert \varphi_{3}\right\rangle
\left\langle \varphi_{3}\right\vert +\left\vert \varphi_{2}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  +\lambda_{24242}\left(
\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert
+\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
\right)  +\lambda_{24343}\left(  \left\vert \varphi_{3}\right\rangle
\left\langle \varphi_{3}\right\vert +\left\vert \varphi_{4}\right\rangle
\left\langle \varphi_{4}\right\vert \right)  \right\}
\end{align*}
hence%
\begin{align*}
L_{2}^{1}\left(  \hat{\lambda}_{2}\right)   &  =\frac{1}{2}\left\{  \left(
\lambda_{21212}+\lambda_{21313}+\lambda_{21414}\right)  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert \right. \\
&  +\left(  \lambda_{21212}+\lambda_{22323}+\lambda_{22424}\right)  \left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert \\
&  +\left(  \lambda_{21313}+\lambda_{22323}+\lambda_{23434}\right)  \left\vert
\varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert \\
&  +\left.  \left(  \lambda_{21414}+\lambda_{22424}+\lambda_{23434}\right)
\left\vert \varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert
\right\}
\end{align*}
thus%
\begin{align*}
\hat{\lambda}_{2}\wedge L_{2}^{1}\left(  \hat{\lambda}_{2}\right)   &
=\frac{1}{2}\left(  \lambda_{21212}\left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
+\lambda_{21313}\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert +\lambda_{21414}\left\vert \varphi
_{1}\varphi_{4}\right\rangle \left\langle \varphi_{1}\varphi_{4}\right\vert
\right. \\
&  +\left.  \lambda_{22323}\left\vert \varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\right\vert +\lambda_{22424}\left\vert
\varphi_{2}\varphi_{4}\right\rangle \left\langle \varphi_{2}\varphi
_{4}\right\vert +\lambda_{23434}\left\vert \varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{3}\varphi_{4}\right\vert \right) \\
&  \wedge\left(  \left(  \lambda_{21212}+\lambda_{21313}+\lambda
_{21414}\right)  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left(  \lambda_{21212}+\lambda_{22323}+\lambda
_{22424}\right)  \left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert \right. \\
&  +\left.  \left(  \lambda_{21313}+\lambda_{22323}+\lambda_{23434}\right)
\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert
+\left(  \lambda_{21414}+\lambda_{22424}+\lambda_{23434}\right)  \left\vert
\varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right\}
\end{align*}
giving
\begin{align*}
\hat{\lambda}_{2}\wedge L_{2}^{1}\left(  \hat{\lambda}_{2}\right)   &
=\frac{1}{2}\left(  \lambda_{22323}\left(  \lambda_{21212}+\lambda
_{21313}+\lambda_{21414}\right)  \left\vert \varphi_{1}\varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\right. \\
&  +\lambda_{22424}\left(  \lambda_{21212}+\lambda_{21313}+\lambda
_{21414}\right)  \left\vert \varphi_{1}\varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{4}\right\vert \\
&  +\lambda_{23434}\left(  \lambda_{21212}+\lambda_{21313}+\lambda
_{21414}\right)  \left\vert \varphi_{1}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\varphi_{4}\right\vert \\
&  +\lambda_{21313}\left(  \lambda_{21212}+\lambda_{22323}+\lambda
_{22424}\right)  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \\
&  +\lambda_{21414}\left(  \lambda_{21212}+\lambda_{21313}+\lambda
_{21414}\right)  \left\vert \varphi_{1}\varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{4}\right\vert \\
&  +\lambda_{23434}\left(  \lambda_{21212}+\lambda_{21313}+\lambda
_{21414}\right)  \left\vert \varphi_{2}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert \\
&  +\lambda_{21212}\left(  \lambda_{21313}+\lambda_{22323}+\lambda
_{23434}\right)  \left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \\
&  +\lambda_{21414}\left(  \lambda_{21313}+\lambda_{22323}+\lambda
_{23434}\right)  \left\vert \varphi_{1}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\varphi_{4}\right\vert \\
&  +\lambda_{22424}\left(  \lambda_{21313}+\lambda_{22323}+\lambda
_{23434}\right)  \left\vert \varphi_{2}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert \\
&  +\lambda_{21212}\left(  \lambda_{21414}+\lambda_{22424}+\lambda
_{23434}\right)  \left\vert \varphi_{1}\varphi_{2}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{4}\right\vert \\
&  +\lambda_{21313}\left(  \lambda_{21414}+\lambda_{22424}+\lambda
_{23434}\right)  \left\vert \varphi_{1}\varphi_{3}\varphi_{4}\right\rangle
\left\langle \varphi_{1}\varphi_{3}\varphi_{4}\right\vert \\
&  \left.  +\lambda_{22323}\left(  \lambda_{21414}+\lambda_{22424}%
+\lambda_{23434}\right)  \left\vert \varphi_{2}\varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{2}\varphi_{3}\varphi_{4}\right\vert
\right)
\end{align*}%
\begin{align*}
&  \frac{2}{6}\sum_{\substack{1\leq l_{1},l_{2},l_{3}\leq r}}\left\{
\lambda_{2l_{1}l_{2}l_{1}l_{2}}\lambda_{2l_{1}l_{3}l_{1}l_{3}}+\lambda
_{2l_{1}l_{2}l_{1}l_{2}}\lambda_{2l_{2}l_{3}l_{2}l_{3}}+\lambda_{2l_{1}%
l_{3}l_{1}l_{3}}\lambda_{2l_{2}l_{3}l_{2}l_{3}}\right\}  n_{l_{1}}n_{l_{2}%
}n_{l_{3}}\\
&  =\frac{1}{3}\left(  \sum_{\substack{1\leq l_{1},l_{2}\leq r}}\lambda
_{2l_{1}l_{2}l_{1}l_{2}}n_{l_{1}}n_{l_{2}}\right)  \frac{1}{2}\sum_{_{1\leq
l,l_{3}\leq r}}\lambda_{2l_{3}ll_{3}l}n_{l_{3}}=\frac{1}{6}\sum
_{\substack{1\leq l_{1},l_{2},l_{3}\leq r}}\lambda_{2l_{1}l_{2}l_{1}l_{2}%
}L_{2}^{1}\left(  \hat{\lambda}_{2}\right)  _{l_{3}l_{3}}n_{l_{1}}n_{l_{2}%
}n_{l_{3}}\\
&  \ast\\
&  =\frac{1}{6}\sum_{\substack{1\leq l_{1},l_{2},l_{3}\leq r}}\left(
\lambda_{2}\wedge L_{2}^{1}\left(  \hat{\lambda}_{2}\right)  \right)
_{l_{1}l_{2}l_{3}l_{1}l_{2}l_{3}}n_{l_{1}}n_{l_{2}}n_{l_{3}}=\sum
_{\substack{1\leq l_{1}<l_{2}<l_{3}\leq r}}\left(  \lambda_{2}\wedge L_{2}%
^{1}\left(  \hat{\lambda}_{2}\right)  \right)  _{l_{1}l_{2}l_{3}l_{1}%
l_{2}l_{3}}n_{l_{1}}n_{l_{2}}n_{l_{3}}%
\end{align*}
which can be seen by noting that
\begin{align*}
P_{\mathcal{H}^{2}}  &  =\left(  \left\vert \varphi_{1}\varphi_{2}%
\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert +\left\vert
\varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{3}\right\vert +\left\vert \varphi_{1}\varphi_{4}\right\rangle \left\langle
\varphi_{1}\varphi_{4}\right\vert +\left\vert \varphi_{2}\varphi
_{3}\right\rangle \left\langle \varphi_{2}\varphi_{3}\right\vert \right.  +\\
&  \left.  \left\vert \varphi_{2}\varphi_{4}\right\rangle \left\langle
\varphi_{2}\varphi_{4}\right\vert +\left\vert \varphi_{3}\varphi
_{4}\right\rangle \left\langle \varphi_{3}\varphi_{4}\right\vert \right)
\end{align*}
and
\[
L_{2}^{1}\left(  P_{\mathcal{H}^{2}}\right)  =\frac{3}{2}\left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert +\left\vert
\varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert +\left\vert
\varphi_{4}\right\rangle \left\langle \varphi_{4}\right\vert \right)
=\frac{\left(  r-1\right)  }{2}P_{\mathcal{H}^{1}}=\frac{3}{2}P_{\mathcal{H}%
^{1}}.
\]
where
\[
L_{2}^{1}\left(  \hat{\lambda}_{2}\right)  _{l_{1}l_{1}}=\frac{1}{2}%
\sum_{_{1\leq l\leq r}}\lambda_{2l_{1}ll_{1}l}.
\]
This gives%
\begin{align*}
\hat{\lambda}_{2}\wedge L_{2}^{1}\left(  \hat{\lambda}_{2}\right)   &
=\frac{1}{2}\sum_{\substack{1\leq l_{1},l_{2}\leq r\\1\leq l_{3}\leq
r}}\lambda_{2l_{1}l_{2}l_{1}l_{2}}L_{2}^{1}\left(  \hat{\lambda}_{2}\right)
_{l_{3}l_{3}}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{l_{1}}\varphi_{l_{2}}\right\vert \wedge\left\vert
\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{3}}\right\vert \\
&  =\sum_{\substack{1\leq l_{1},l_{2}\leq r\\1\leq l_{3}\leq r}}\lambda
_{2l_{1}l_{2}l_{1}l_{2}}L_{2}^{1}\left(  \hat{\lambda}_{2}\right)
_{l_{3}l_{3}}\left\vert \varphi_{l_{1}}\wedge\varphi_{l_{2}}\wedge
\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}}\wedge\varphi_{l_{2}%
}\wedge\varphi_{l_{3}}\right\vert \\
&  =\frac{1}{3}\sum_{1\leq l_{1}<l_{2}<l_{3}\leq r}\left\{  \lambda
_{2l_{1}l_{2}l_{1}l_{2}}L_{2}^{1}\left(  \hat{\lambda}_{2}\right)
_{l_{3}l_{3}}+\lambda_{2l_{1}l_{3}l_{1}l_{3}}L_{2}^{1}\left(  \hat{\lambda
}_{2}\right)  _{l_{2}l_{2}}+\lambda_{2l_{2}l_{3}l_{2}l_{3}}L_{2}^{1}\left(
\hat{\lambda}_{2}\right)  _{l_{1}l_{1}}\right\}  \left\vert \varphi_{l_{1}%
}\varphi_{l_{2}}\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}%
}\varphi_{l_{2}}\varphi_{l_{3}}\right\vert \\
&  =\frac{1}{6}\sum_{\substack{1\leq l_{1}<l_{2}<l_{3}\leq r\\1\leq l\leq
r}}\left\{  \lambda_{2l_{1}l_{2}l_{1}l_{2}}\lambda_{2l_{3}ll_{3}l}%
+\lambda_{2l_{1}l_{3}l_{1}l_{3}}\lambda_{2l_{2}ll_{2}l}+\lambda_{2l_{2}%
l_{3}l_{2}l_{3}}\lambda_{2l_{1}ll_{1}l}\right\}  \left\vert \varphi_{l_{1}%
}\varphi_{l_{2}}\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}%
}\varphi_{l_{2}}\varphi_{l_{3}}\right\vert ,
\end{align*}
which checks out as
\begin{align*}
&  L_{2}^{1}\left(  P_{\mathcal{H}^{2}}\right)  _{l_{1}l_{1}}=\frac{1}{2}%
\sum_{_{1\leq l_{1},l_{2}\leq4}}\delta_{l_{1}l_{2}l_{1}l_{2}}=\frac{3}{2}\\
&  P_{\mathcal{H}^{2}}\wedge L_{2}^{1}\left(  P_{\mathcal{H}^{2}}\right)
=\frac{3}{2}P_{\mathcal{H}^{3}}\\
&  \frac{1}{3}\left\{  \lambda_{2l_{1}l_{2}l_{1}l_{2}}L_{2}^{1}\left(
\hat{\lambda}_{2}\right)  _{l_{3}l_{3}}+\lambda_{2l_{1}l_{3}l_{1}l_{3}}%
L_{2}^{1}\left(  \hat{\lambda}_{2}\right)  _{l_{2}l_{2}}+\lambda_{2l_{2}%
l_{3}l_{2}l_{3}}L_{2}^{1}\left(  \hat{\lambda}_{2}\right)  _{l_{1}l_{1}%
}\right\} \\
&  =\frac{1}{3}\left\{  1\times\frac{3}{2}+1\times\frac{3}{2}+1\times\frac
{3}{2}\right\}  =\frac{3}{2}.
\end{align*}
In general%
\begin{align*}
&  L_{2}^{1}\left(  \hat{\lambda}_{2}\right)  =L_{2}^{1}\left(  \frac{1}%
{2}\sum_{\substack{1\leq l_{1},l_{2}\leq r\\1\leq k_{1},k_{2}\leq r}%
}\lambda_{2l_{1}l_{2}l_{1}l_{2}}\left\vert \varphi_{l_{1}}\varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{l_{2}}\right\vert \right)
=\frac{1}{2}\sum_{\substack{1\leq l_{1},l_{2}\leq r\\1\leq k_{1},k_{2}\leq
r}}\lambda_{2l_{1}l_{2}l_{1}l_{2}}L_{2}^{1}\left(  \left\vert \varphi_{l_{1}%
}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{l_{2}%
}\right\vert \right) \\
&  =\frac{1}{4}\sum_{_{1\leq l_{1},l_{2}\leq r}}\lambda_{2l_{1}l_{2}l_{1}%
l_{2}}\left\{  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{l_{1}}\right\vert \delta_{l_{2}l_{2}}-\left\vert \varphi_{l_{1}%
}\right\rangle \left\langle \varphi_{l_{2}}\right\vert \delta_{l_{1}l_{2}%
}-\left\vert \varphi_{l_{2}}\right\rangle \left\langle \varphi_{l_{1}%
}\right\vert \delta_{l_{1}l_{2}}+\left\vert \varphi_{l_{2}}\right\rangle
\left\langle \varphi_{l_{2}}\right\vert \delta_{l_{1}l_{1}}\right\} \\
&  =\frac{1}{4}\sum_{_{1\leq l_{1},l_{2}\leq r}}\lambda_{2l_{1}l_{2}l_{1}%
l_{2}}\left\{  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{l_{1}}\right\vert \delta_{l_{2}l_{2}}+\left\vert \varphi_{l_{2}%
}\right\rangle \left\langle \varphi_{l_{2}}\right\vert \delta_{l_{1}l_{1}%
}\right\} \\
&  =\frac{1}{2}\sum_{_{1\leq l_{1},l_{2}\leq r}}\lambda_{2l_{1}l_{2}l_{1}%
l_{2}}\left\vert \varphi_{l_{1}}\right\rangle \left\langle \varphi_{l_{1}%
}\right\vert =\sum_{_{1\leq l_{1}\leq r}}L_{2}^{1}\left(  \hat{\lambda}%
_{2}\right)  _{l_{1}l_{1}}\left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{l_{1}}\right\vert ,
\end{align*}%
\begin{equation}
L_{4}^{3}\left(  \lambda_{2}\wedge\lambda_{2}\right)  _{l_{1}l_{2}k_{1}%
l_{3}l_{4}k_{3}}=\sum_{1\leq j\leq4}\left(  \lambda_{2}\wedge\lambda
_{2}\right)  _{l_{1}l_{2}k_{1}jl_{3}l_{4}k_{3}j}=\frac{1}{16}\sum_{1\leq
j\leq4}\lambda_{2l_{1}l_{2}l_{3}l_{4}}\lambda_{2k_{1}jk_{3}j}%
\end{equation}

