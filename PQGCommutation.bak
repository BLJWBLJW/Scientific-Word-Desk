\hat{\lambda}_{2}  &  =\lambda_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{2312}\left\vert \psi
_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
+\lambda_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert +\\
&  \lambda_{1323}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1313}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert \\
&  +\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\end{align}%
\begin{align}
&  +\lambda_{1323}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\\
&  \lambda_{1323}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1313}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert \\
&  +\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\end{align}%
\begin{align}
&  +\lambda_{1224}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{2}\psi_{4}\right\vert +\lambda_{2412}\left\vert \psi_{2}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\\
&  \lambda_{1424}\left\vert \psi_{1}\psi_{4}\right\rangle \left\langle
