The condition
\begin{equation}
\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=0
\end{equation}
gives
\begin{align}
&  \sum_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{  \lambda_{1ijk}\left\vert
\psi_{1}\psi_{i}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
+\lambda_{jk1i}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{i}\right\vert \right\}  \wedge\sum_{\substack{2<i<r\\2\leq j,k\leq
r}}\left\{  \lambda_{1ijk}\left\vert \psi_{1}\psi_{i}\right\rangle
\left\langle \psi_{j}\psi_{k}\right\vert +\lambda_{jk1i}\left\vert \psi
_{j}\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{i}\right\vert \right\}
\nonumber\\
&  +\sum_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{  \lambda_{1ijk}\left\vert
\psi_{1}\psi_{i}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
+\lambda_{jk1i}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{i}\right\vert \right\}  \wedge\sum_{2\leq i,j\leq r}\lambda
_{1i1j}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle \psi_{1}\psi
_{j}\right\vert \nonumber\\
&  +\sum_{2\leq i,j\leq r}\lambda_{1i1j}\left\vert \psi_{1}\psi_{i}%
\right\rangle \left\langle \psi_{1}\psi_{j}\right\vert \wedge\sum
_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{  \lambda_{1ijk}\left\vert \psi
_{1}\psi_{i}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
+\lambda_{jk1i}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{i}\right\vert \right\} \nonumber\\
&  +\sum_{2\leq i,j\leq r}\lambda_{1i1j}\left\vert \psi_{1}\psi_{i}%
\right\rangle \left\langle \psi_{1}\psi_{j}\right\vert \wedge\sum_{2\leq
i,j\leq r}\lambda_{1i1j}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle
\psi_{1}\psi_{j}\right\vert \left.  =\right.  0
\end{align}
leading to%
\begin{align}
&  \sum_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{  \lambda_{1ijk}\left\vert
\psi_{1}\psi_{i}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
+\lambda_{jk1i}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{i}\right\vert \right\}  \wedge\sum_{\substack{2<i<r\\2\leq j,k\leq
r}}\left\{  \lambda_{1ijk}\left\vert \psi_{1}\psi_{i}\right\rangle
\left\langle \psi_{j}\psi_{k}\right\vert +\lambda_{jk1i}\left\vert \psi
_{j}\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{i}\right\vert \right\}
\nonumber\\
&  =\sum_{\substack{2\leq i_{1}<\leq,2\leq i_{2}\leq r\\2\leq j_{1},k_{1}\leq
r,2\leq j_{2},k_{2}\leq r}}\left\{  \lambda_{1i_{1}j_{1}k_{1}}\lambda
_{j_{2}k_{2}1i_{2}}\left\vert \psi_{1}\psi_{i_{1}}\right\rangle \wedge
\left\vert \psi_{j_{2}}\psi_{k_{2}}\right\rangle \left\langle \psi_{j_{1}}%
\psi_{k_{1}}\right\vert \wedge\left\langle \psi_{1}\psi_{i_{2}}\right\vert
\right. \nonumber\\
&  \left.  +\lambda_{1i_{2}j_{2}k_{2}}\lambda_{j_{1}k_{1}1i_{1}}\left\vert
\psi_{1}\psi_{i_{2}}\right\rangle \wedge\left\vert \psi_{j_{1}}\psi_{k_{1}%
}\right\rangle \left\langle \psi_{j_{2}}\psi_{k_{2}}\right\vert \wedge
\left\langle \psi_{1}\psi_{i_{1}}\right\vert \right\} \nonumber\\
&  =\sum_{\substack{2\leq i_{1}<\leq,2\leq i_{2}\leq r\\2\leq j_{1},k_{1}\leq
r,2\leq j_{2},k_{2}\leq r}}\left\{  \lambda_{1i_{1}j_{1}k_{1}}\lambda
_{j_{2}k_{2}1i_{2}}\left\vert \left(  \psi_{1}\psi_{i_{1}}\right)
\wedge\left(  \psi_{j_{2}}\psi_{k_{2}}\right)  \right\rangle \left\langle
\left(  \psi_{j_{1}}\psi_{k_{1}}\right)  \wedge\left(  \psi_{1}\psi_{i_{2}%
}\right)  \right\vert \right. \nonumber\\
&  \left.  +\lambda_{1i_{2}j_{2}k_{2}}\lambda_{j_{1}k_{1}1i_{1}}\left\vert
\left(  \psi_{1}\psi_{i_{2}}\right)  \wedge\left(  \psi_{j_{1}}\psi_{k_{1}%
}\right)  \right\rangle \left\langle \left(  \psi_{j_{2}}\psi_{k_{2}}\right)
\wedge\left(  \psi_{1}\psi_{i_{1}}\right)  \right\vert \right\} \\
&  =2\sum_{\substack{2\leq i_{1}<\leq,2\leq i_{2}\leq r\\2\leq j_{1},k_{1}\leq
r,2\leq j_{2},k_{2}\leq r}}\left\{  \lambda_{1i_{1}j_{1}k_{1}}\lambda
_{j_{2}k_{2}1i_{2}}\left\vert \left(  \psi_{1}\psi_{i_{1}}\right)
\wedge\left(  \psi_{j_{2}}\psi_{k_{2}}\right)  \right\rangle \left\langle
\left(  \psi_{j_{1}}\psi_{k_{1}}\right)  \wedge\left(  \psi_{1}\psi_{i_{2}%
}\right)  \right\vert \right\}  \left.  =\right.  0\\
&  \Rightarrow\sum_{\substack{2\leq i_{1}<\leq,2\leq i_{2}\leq r\\2\leq
j_{1},k_{1}\leq r,2\leq j_{2},k_{2}\leq r}}\left\{  \lambda_{1i_{1}j_{1}k_{1}%
}\lambda_{j_{2}k_{2}1i_{2}}\left\vert \psi_{1}\psi_{i_{1}}\psi_{j_{2}}%
\psi_{k_{2}}\right\rangle \left\langle \psi_{1}\psi_{i_{2}}\psi_{j_{1}}%
\psi_{k_{1}}\right\vert \right\}  \left.  =\right.  0
\end{align}
$\lceil$%
\begin{equation}
\lambda_{1i_{1}j_{1}k_{1}}\lambda_{j_{2}k_{2}1i_{2}}\left\vert \psi_{1}%
\psi_{i_{1}}\psi_{j_{2}}\psi_{k_{2}}\right\rangle \left\langle \psi_{1}%
\psi_{i_{2}}\psi_{j_{1}}\psi_{k_{1}}\right\vert
\end{equation}%
\begin{equation}
\left\{  \lambda_{1234}\lambda_{3412}-\lambda_{1324}\lambda_{3412}%
-\lambda_{1234}\lambda_{2413}+\lambda_{1432}\lambda_{3412}+\lambda
_{1234}\lambda_{3214}\right\}  \left\vert 1234\right\rangle \left\langle
1234\right\vert
\end{equation}%
\begin{equation}
\lambda_{1i_{1}j_{1}k_{1}}\lambda_{j_{2}k_{2}1i_{2}}-\lambda_{1j_{2}j_{1}%
k_{1}}\lambda_{i_{1}k_{2}1i_{2}}+\lambda_{1k_{2}j_{1}k_{1}}\lambda_{j_{2}%
i_{1}1i_{2}}+\lambda_{1i_{1}j_{1}k_{1}}\lambda_{j_{2}k_{2}1i_{2}}%
-\lambda_{1j_{2}j_{1}k_{1}}\lambda_{i_{1}k_{2}1i_{2}}+\lambda_{1k_{2}%
j_{1}k_{1}}\lambda_{j_{2}i_{1}1i_{2}}%
\end{equation}


and%
\begin{align}
&  \sum_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{  \lambda_{1ijk}\left\vert
\psi_{1}\psi_{i}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
+\lambda_{jk1i}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{i}\right\vert \right\}  \wedge\sum_{2\leq i,j\leq r}\lambda
_{1i1j}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle \psi_{1}\psi
_{j}\right\vert \nonumber\\
&  =\sum_{\substack{2<i_{1}<r,2<i_{2}<r\\2\leq j_{1},k_{1}\leq r,2\leq
j_{2},k_{2}\leq r}}\lambda_{jk1i}\lambda_{1i1j}\left\vert \psi_{j}\psi
_{k}\right\rangle \left\langle \psi_{1}\psi_{i}\right\vert \wedge\left\vert
\psi_{1}\psi_{i}\right\rangle \left\langle \psi_{1}\psi_{j}\right\vert =0,
\end{align}%
\begin{align}
&  \sum_{2\leq i,j\leq r}\lambda_{1i_{1}1j_{1}}\left\vert \psi_{1}\psi_{i_{1}%
}\right\rangle \left\langle \psi_{1}\psi_{j_{1}}\right\vert \wedge
\sum_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{  \lambda_{1i_{2}j_{2}k_{2}%
}\left\vert \psi_{1}\psi_{i_{2}}\right\rangle \left\langle \psi_{j_{2}}%
\psi_{k_{2}}\right\vert +\lambda_{j_{2}k_{2}1i_{2}}\left\vert \psi_{j_{2}}%
\psi_{k_{2}}\right\rangle \left\langle \psi_{1}\psi_{i_{2}}\right\vert
\right\} \\
&  =\sum_{\substack{2<i_{1}<r,2<i_{2}<r\\2\leq j_{1},k_{1}\leq r,2\leq
j_{2},k_{2}\leq r}}\lambda_{1i_{1}1j_{1}}\lambda_{j_{2}k_{2}1i_{2}}\left\vert
\psi_{1}\psi_{i_{1}}\right\rangle \left\langle \psi_{1}\psi_{j_{1}}\right\vert
\wedge\left\vert \psi_{j_{2}}\psi_{k_{2}}\right\rangle \left\langle \psi
_{1}\psi_{i_{2}}\right\vert =0,
\end{align}%
\begin{equation}
\sum_{2\leq i,j\leq r}\lambda_{1i1j}\left\vert \psi_{1}\psi_{i}\right\rangle
\left\langle \psi_{1}\psi_{j}\right\vert \wedge\sum_{2\leq i,j\leq
r}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle \psi_{1}\psi
_{j}\right\vert =0
\end{equation}
automatically.

e.g.
\begin{align}
\hat{\lambda}_{2}  &  =\lambda_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{2312}\left\vert \psi
_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
+\lambda_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert +\lambda_{1323}\left\vert \psi_{1}\psi_{3}%
\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{2313}\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\lambda_{1313}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert
\end{align}
then
\begin{equation}
\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=0
\end{equation}
automatically.

Now consider
\begin{equation}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}+\hat{\lambda}_{2}^{2}-\hat{\lambda
}_{2}+\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}_{2}%
+\hat{\lambda}_{2}\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  =0
\end{equation}
this gives
\begin{equation}
\hat{\lambda}_{2}^{2}-\hat{\lambda}_{2}+\Gamma_{1}^{2}\left(  \hat{\lambda
}_{1}\right)  \hat{\lambda}_{2}+\hat{\lambda}_{2}\Gamma_{1}^{2}\left(
\hat{\lambda}_{1}\right)  =0
\end{equation}%
\begin{align}
\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}_{2}  &
=\sum_{2<i\leq r}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle
\psi_{1}\psi_{i}\right\vert \sum_{\substack{2\leq i_{1}<j_{1}\leq r\\2\leq
i_{2}<j_{2}\leq r}}\lambda_{i_{1}j_{1}i_{2}j_{2}}\left\vert \psi_{i_{1}}%
\psi_{j_{1}}\right\rangle \left\langle \psi_{i_{2}}\psi_{j_{2}}\right\vert \\
&  =\sum_{\substack{2\leq i_{1}<j_{1}\neq i\leq r\\2\leq i_{2}<j_{2}\neq i\leq
r}}\lambda_{i_{1}j_{1}i_{2}j_{2}}\left\vert \psi_{1}\psi_{i}\right\rangle
\left\langle \psi_{1}\psi_{i}\left\vert \psi_{i_{1}}\psi_{j_{1}}\right.
\right\rangle \left\langle \psi_{i_{2}}\psi_{j_{2}}\right\vert
\end{align}
Using the above expression for one obtains
\begin{align}
\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}_{2}  &
=\lambda_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{2}\psi_{3}\right\vert +\lambda_{1212}\left\vert \psi_{1}\psi_{2}%
\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\lambda_{1323}%
\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{2}\psi
_{3}\right\vert +\lambda_{1313}\left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\end{align}
and
\begin{align}
\hat{\lambda}_{2}\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)   &
=\lambda_{2312}\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert ++\lambda_{1212}\left\vert \psi_{1}\psi_{2}%
\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\lambda_{2313}%
\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1313}\left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\end{align}
giving
\begin{align}
&  \Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}_{2}%
+\hat{\lambda}_{2}\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)
=2\lambda_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert +2\lambda_{1313}\left\vert \psi_{1}\psi_{3}%
\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +2\lambda
_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert \nonumber\\
&  +2\lambda_{1312}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert \\
&  +\lambda_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert +\lambda_{1323}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert +\lambda
_{2312}\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert
\end{align}


2. Let
\begin{equation}
\hat{\lambda}_{1}=\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert
\end{equation}
then
\begin{align}
&  2\hat{\lambda}_{2}=\sum_{1\leq i,k\leq r}\lambda_{12ik}\left\vert \psi
_{1}\psi_{2}\right\rangle \left\langle \psi_{i}\psi_{k}\right\vert
+\sum_{1\leq i,k\leq r}\lambda_{1i2k}\left\vert \psi_{1}\psi_{i}\right\rangle
\left\langle \psi_{2}\psi_{k}\right\vert +\sum_{1\leq i,k\leq r}\lambda
_{2i1k}\left\vert \psi_{2}\psi_{i}\right\rangle \left\langle \psi_{1}\psi
_{k}\right\vert +\sum_{1\leq i,k\leq r}\lambda_{2k1i}\left\vert \psi_{i}%
\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert \nonumber\\
&  +\sum_{3\leq i<r}\lambda_{121i}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{1}\psi_{i}\right\vert +\sum_{3\leq i<r}\lambda
_{121i}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\sum_{3\leq i<r}\lambda_{122i}\left\vert \psi_{1}\psi
_{2}\right\rangle \left\langle \psi_{2}\psi_{i}\right\vert +\sum_{3\leq
i<r}\lambda_{1i12}\left\vert \psi_{2}\psi_{i}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert \nonumber\\
&  +\lambda_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert .
\end{align}
The condition $\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=0$ gives
\begin{align}
\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}  &  =\sum_{3\leq i,k\leq r}%
\lambda_{12ik}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{i}\psi_{k}\right\vert \wedge\sum_{3\leq i,k\leq r}\lambda_{2k1i}\left\vert
\psi_{i}\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\nonumber\\
&  +\sum_{3\leq i,k\leq r}\lambda_{2k1i}\left\vert \psi_{i}\psi_{k}%
\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert \wedge\sum_{3\leq
i,k\leq r}\lambda_{12ik}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{i}\psi_{k}\right\vert =0\\
&  \Rightarrow\sum_{3\leq i,k\leq r}\lambda_{12ik}\lambda_{2k1i}\left\vert
\psi_{1}\wedge\psi_{2}\wedge\psi_{i}\wedge\psi_{k}\right\rangle \left\langle
\psi_{1}\wedge\psi_{2}\wedge\psi_{i}\wedge\psi_{k}\right\vert \nonumber\\
&  \Rightarrow\sum_{3\leq i,k\leq r}\lambda_{12ik}\lambda_{2k1i}\left\vert
\psi_{1}\wedge\psi_{2}\right\rangle \left\langle \psi_{1}\wedge\psi
_{2}\right\vert \wedge\left\vert \psi_{i}\wedge\psi_{k}\right\rangle
\left\langle \psi_{i}\wedge\psi_{k}\right\vert \nonumber\\
&  \Rightarrow\left\vert \psi_{1}\wedge\psi_{2}\right\rangle \left\langle
\psi_{1}\wedge\psi_{2}\right\vert \wedge\sum_{3\leq i,k\leq r}\lambda
_{12ik}\lambda_{2k1i}\left\vert \psi_{i}\wedge\psi_{k}\right\rangle
\left\langle \psi_{i}\wedge\psi_{k}\right\vert \\
&  \Rightarrow\sum_{3\leq i<k\leq r}\lambda_{12ik}\lambda_{2k1i}\left\vert
\psi_{1}\wedge\psi_{2}\wedge\psi_{i}\wedge\psi_{k}\right\rangle \left\langle
\psi_{1}\wedge\psi_{2}\wedge\psi_{i}\wedge\psi_{k}\right\vert =0
\end{align}
i.e.%
\begin{equation}
\lambda_{12ik}\lambda_{2k1i}=0;3\leq i<k\leq r
\end{equation}
Thus
\begin{equation}
\hat{\lambda}_{2}=\left\vert \psi_{1}\wedge\psi_{2}\right\rangle \left\langle
\psi_{1}\wedge\psi_{2}\right\vert .
\end{equation}
3. Let
\begin{equation}
\hat{\lambda}_{1}=\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert +\left\vert \psi_{3}\right\rangle \left\langle \psi
_{3}\right\vert
\end{equation}
then
\begin{align}
\hat{\lambda}_{2}  &  =\sum_{1\leq i\leq r}\left\{  \lambda_{123i}\left\vert
\psi_{1}\psi_{2}\right\rangle \left\langle \psi_{3}\psi_{i}\right\vert
+\lambda_{132i}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi
_{2}\psi_{i}\right\vert +\lambda_{231i}\left\vert \psi_{2}\psi_{3}%
\right\rangle \left\langle \psi_{1}\psi_{i}\right\vert +\right. \nonumber\\
&  \left.  \lambda_{3i12}\left\vert \psi_{3}\psi_{i}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert +\lambda_{2i13}\left\vert \psi_{2}\psi
_{i}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1i23}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle \psi_{2}\psi
_{3}\right\vert \right\} \nonumber\\
&  +\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\lambda
_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{2}\psi
_{3}\right\vert \nonumber\\
&  +\lambda_{2312}\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1323}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{2}\psi
_{3}\right\vert .
\end{align}
In particular note that in this case $\hat{\lambda}_{2}$ \emph{has no diagonal
elements}. The condition $\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=0$ gives
\begin{align}
&  \hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=\nonumber\\
&  \sum_{1\leq i\leq r}\left\{  \left\vert \lambda_{123i}\right\vert
^{2}\left\vert \psi_{1}\psi_{2}\psi_{3}\psi_{i}\right\rangle \left\langle
\psi_{3}\psi_{i}\psi_{1}\psi_{2}\right\vert +\left\vert \lambda_{132i}%
\right\vert ^{2}\left\vert \psi_{1}\psi_{3}\psi_{2}\psi_{i}\right\rangle
\left\langle \psi_{2}\psi_{i}\psi_{1}\psi_{3}\right\vert +\left\vert
\lambda_{231i}\right\vert ^{2}\left\vert \psi_{2}\psi_{3}\psi_{1}\psi
_{i}\right\rangle \left\langle \psi_{1}\psi_{i}\psi_{2}\psi_{3}\right\vert
\right\} \\
&  =0.
\end{align}
Thus
\begin{equation}
\lambda_{1234}=\lambda_{1324}=\lambda_{1423}=\lambda_{3412}=\lambda
_{2413}=\lambda_{2314}=0
\end{equation}
giving
\begin{align}
\hat{\lambda}_{2}  &  =\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi
_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
+\lambda_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{2312}\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1323}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{2}\psi
_{3}\right\vert .
\end{align}
Now we consider we consider the condition
\begin{equation}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}+\hat{\lambda}_{2}^{2}-\hat{\lambda
}_{2}+\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}_{2}%
+\hat{\lambda}_{2}\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  =0
\end{equation}
this gives
\begin{align}
&  \left(  \left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert
+\left\vert \psi_{2}\right\rangle \left\langle \psi_{2}\right\vert +\left\vert
\psi_{3}\right\rangle \left\langle \psi_{3}\right\vert \right)  \wedge\left(
\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert +\left\vert
\psi_{2}\right\rangle \left\langle \psi_{2}\right\vert +\left\vert \psi
_{3}\right\rangle \left\langle \psi_{3}\right\vert \right)  +\left(
\left\vert \lambda_{1213}\right\vert ^{2}+\left\vert \lambda_{1223}\right\vert
^{2}\right)  \left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert \nonumber\\
&  +\left(  \left\vert \lambda_{1312}\right\vert ^{2}+\left\vert
\lambda_{1323}\right\vert ^{2}\right)  \left\vert \psi_{1}\psi_{3}%
\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\left(  \left\vert
\lambda_{2312}\right\vert ^{2}+\left\vert \lambda_{2323}\right\vert
^{2}\right)  \left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi
_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{1213}\lambda_{1323}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{1223}\lambda_{2313}%
\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1312}\lambda_{1223}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{2313}\lambda_{2313}\left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert +\lambda_{1323}\lambda_{2312}%
\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert ++\lambda_{2313}\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\nonumber\\
&  \left(  \left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert
+\left\vert \psi_{2}\right\rangle \left\langle \psi_{2}\right\vert +\left\vert
\psi_{3}\right\rangle \left\langle \psi_{3}\right\vert \right)  \wedge\left(
\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert +\left\vert
\psi_{2}\right\rangle \left\langle \psi_{2}\right\vert +\left\vert \psi
_{3}\right\rangle \left\langle \psi_{3}\right\vert +\cdots\right)
\hat{\lambda}_{2}\nonumber\\
&  \hat{\lambda}_{2}\left(  \left\vert \psi_{1}\right\rangle \left\langle
\psi_{1}\right\vert +\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert +\left\vert \psi_{3}\right\rangle \left\langle \psi
_{3}\right\vert \right)  \wedge\left(  \left\vert \psi_{1}\right\rangle
\left\langle \psi_{1}\right\vert +\left\vert \psi_{2}\right\rangle
\left\langle \psi_{2}\right\vert +\left\vert \psi_{3}\right\rangle
\left\langle \psi_{3}\right\vert +\cdots\right)  -\hat{\lambda}_{2}=0
\end{align}
and hence%
\begin{align}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}-  &  2\left(  \left\vert \psi_{1}%
\psi_{2}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\left\vert
\psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert
+\left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi_{2}\psi
_{3}\right\vert \right)  +\left(  \left\vert \lambda_{1213}\right\vert
^{2}+\left\vert \lambda_{1223}\right\vert ^{2}\right)  \left\vert \psi_{1}%
\psi_{2}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert \nonumber\\
&  +\left(  \left\vert \lambda_{1312}\right\vert ^{2}+\left\vert
\lambda_{1323}\right\vert ^{2}\right)  \left\vert \psi_{1}\psi_{3}%
\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\left(  \left\vert
\lambda_{2312}\right\vert ^{2}+\left\vert \lambda_{2323}\right\vert
^{2}\right)  \left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi
_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{1213}\lambda_{1323}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{1223}\lambda_{2313}%
\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1312}\lambda_{1223}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{2313}\lambda_{2313}\left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert +\lambda_{1323}\lambda_{2312}%
\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\lambda_{2313}\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\nonumber\\
&  4\hat{\lambda}_{2}-\hat{\lambda}_{2}=0
\end{align}
leading to%
\begin{align}
&  \hat{\lambda}_{1}\wedge\hat{\lambda}_{1}-\left(  2+\left\vert
\lambda_{1213}\right\vert ^{2}+\left\vert \lambda_{1223}\right\vert
^{2}\right)  \left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert +\left(  2+\left\vert \lambda_{1312}\right\vert
^{2}+\left\vert \lambda_{1323}\right\vert ^{2}\right)  \left\vert \psi_{1}%
\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\nonumber\\
&  \left(  2+\left\vert \lambda_{2312}\right\vert ^{2}+\left\vert
\lambda_{2323}\right\vert ^{2}\right)  \left\vert \psi_{2}\psi_{3}%
\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \\
&  +\lambda_{1213}\lambda_{1323}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{1223}\lambda_{2313}%
\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1312}\lambda_{1223}\left\vert \psi_{1}\psi
_{3}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{2313}\lambda_{2313}\left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert +\lambda_{1323}\lambda_{2312}%
\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\lambda_{2313}\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +3\hat{\lambda}%
_{2}=0
\end{align}
As $\hat{\lambda}_{2}$ has no diagonal elements there is no solution, as
nothing can cancel $\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}$ , thus
$\hat{\lambda}_{1}$ can not be rank 3.
\end{itemize}

4. Let
\begin{equation}
\hat{\lambda}_{1}=\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert +\left\vert \psi_{3}\right\rangle \left\langle \psi
_{3}\right\vert +\left\vert \psi_{4}\right\rangle \left\langle \psi
_{4}\right\vert
\end{equation}
then
\begin{align}
\hat{\lambda}_{2}=  &  \lambda_{1234}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{3}\psi_{4}\right\vert +\lambda_{3412}\left\vert \psi
_{3}\psi_{4}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
+\lambda_{1324}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi
_{2}\psi_{4}\right\vert +\lambda_{2413}\left\vert \psi_{2}\psi_{4}%
\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert \nonumber\\
&  +\lambda_{1423}\left\vert \psi_{1}\psi_{4}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert +\lambda_{2314}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{4}\right\vert .
\end{align}
Again there are no diagonal elements.
\begin{align}
\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}  &  =\lambda_{1234}\lambda
_{3412}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{3}\psi
_{4}\right\vert \wedge\left\vert \psi_{3}\psi_{4}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert +\lambda_{1324}\lambda_{2413}\left\vert \psi
_{1}\psi_{3}\right\rangle \left\langle \psi_{2}\psi_{4}\right\vert
\wedge\left\vert \psi_{2}\psi_{4}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert \nonumber\\
&  +\lambda_{1423}\lambda_{2314}\left\vert \psi_{1}\psi_{4}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert \wedge\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{4}\right\vert \nonumber\\
&  =\left(  \lambda_{1234}\lambda_{3412}+\lambda_{1324}\lambda_{2413}%
+\lambda_{1423}\lambda_{2314}\right)  \left\vert \psi_{1}\psi_{2}\psi_{3}%
\psi_{4}\right\rangle \left\langle \psi_{1}\psi_{2}\psi_{3}\psi_{4}\right\vert
\nonumber\\
&  =\left(  \left\vert \lambda_{1234}\right\vert ^{2}+\left\vert
\lambda_{1324}\right\vert ^{2}+\left\vert \lambda_{1423}\right\vert
^{2}\right)  \left\vert \psi_{1}\psi_{2}\psi_{3}\psi_{4}\right\rangle
\left\langle \psi_{1}\psi_{2}\psi_{3}\psi_{4}\right\vert =0.
\end{align}
Thus
\begin{equation}
\lambda_{1234}=\lambda_{1324}=\lambda_{1423}=\lambda_{3412}=\lambda
_{2413}=\lambda_{2314}=0
\end{equation}
and
\begin{equation}
\hat{\lambda}_{2}=0,
\end{equation}
so $\hat{\lambda}_{1}$ can not be rank 4.

5. Let
\begin{equation}
\hat{\lambda}_{1}=\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert +\left\vert \psi_{3}\right\rangle \left\langle \psi
_{3}\right\vert +\left\vert \psi_{4}\right\rangle \left\langle \psi
_{4}\right\vert +\left\vert \psi_{5}\right\rangle \left\langle \psi
_{5}\right\vert
\end{equation}
then there are no solutions.

\begin{itemize}
\item i.e.
\begin{equation}
\left\vert \psi_{1}\psi_{j}\right\rangle \left\langle \psi_{1}\psi
_{k}\right\vert =\left\vert \psi_{2}\psi_{j}\right\rangle \left\langle
\psi_{2}\psi_{k}\right\vert =\cdots=\left\vert \psi_{\nu}\psi_{j}\right\rangle
\left\langle \psi_{\nu}\psi_{k}\right\vert =0\Rightarrow j\neq1,\cdots
,\nu;k\neq1,\cdots,\nu
\end{equation}%
\begin{equation}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}=\sum_{1\leq j\leq v}\left\vert
\psi_{j}\right\rangle \left\langle \psi_{j}\right\vert \wedge\sum_{1\leq
l\leq\binom{r}{2}}\beta_{l}\left\vert g_{l}\right\rangle \left\langle
g_{l}\right\vert =\sum_{\substack{1\leq l\leq\binom{r}{2}\\1\leq j\leq
v}}\beta_{l}\left\vert \psi_{j}g_{l}\right\rangle \left\langle \psi_{j}%
g_{l}\right\vert =0
\end{equation}
Thus $\hat{\lambda}_{1}$ must be of the form
\begin{equation}
\hat{\lambda}_{1}=\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert +\left\vert \psi_{3}\right\rangle \left\langle \psi
_{3}\right\vert +\left\vert \psi_{4}\right\rangle \left\langle \psi
_{4}\right\vert
\end{equation}
and
\begin{equation}
\hat{\lambda}_{2}=\sum_{\substack{1\leq k<l\leq4\\1\leq m<n\leq4}%
}\lambda_{klmn}\left\vert \psi_{k}\psi_{l}\right\rangle \left\langle \psi
_{m}\psi_{n}\right\vert .
\end{equation}


\item the condition $\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}+\hat{\lambda
}_{2}^{2}-\hat{\lambda}_{2}=0$ gives%
\begin{equation}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}=2\left(
\begin{array}
[c]{c}%
\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert +\left\vert \psi_{1}\psi_{4}\right\rangle
\left\langle \psi_{1}\psi_{4}\right\vert +\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \\
+\left\vert \psi_{2}\psi_{4}\right\rangle \left\langle \psi_{2}\psi
_{4}\right\vert +\left\vert \psi_{3}\psi_{4}\right\rangle \left\langle
\psi_{3}\psi_{4}\right\vert
\end{array}
\right)
\end{equation}
which is a projector thus
\begin{equation}
\hat{\lambda}_{2}-\hat{\lambda}_{2}^{2}=\hat{\lambda}_{2}\left(
P_{\mathcal{H}^{2}}-\hat{\lambda}_{2}\right)
\end{equation}
must also be a projector with eigenvalues $\left\{  0,1\right\}  $ $=\left\{
\alpha_{j}\left(  1-\alpha_{j}\right)  \right\}  $ i.e.
\begin{equation}
1=\alpha_{j}-\alpha_{j}^{2}%
\end{equation}


\item the condition $\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=0$ gives
\begin{equation}
Tr\left\{  \hat{\lambda}_{2}\wedge\hat{\lambda}_{2}\right\}  =\sum_{1\leq
P<Q\leq\binom{r}{2}}\alpha_{P}\alpha_{Q}=0
\end{equation}%
\begin{equation}
2\sum_{1\leq l<m\leq\binom{r}{2}}\beta_{l}\beta_{m}\left\vert g_{l}\wedge
g_{m}\right\rangle \left\langle g_{l}\wedge g_{m}\right\vert +\sum_{1\leq
l\leq\binom{r}{2}}\beta_{l}^{2}\left\vert g_{l}^{2}\right\rangle \left\langle
g_{l}^{2}\right\vert =0
\end{equation}


\item if $\hat{\lambda}_{2}\geq0$ then
\begin{equation}
\operatorname*{rank}\left\{  \hat{\lambda}_{2}\right\}  =1
\end{equation}
i.e.
\begin{equation}
\hat{\lambda}_{2}=\left\vert g\right\rangle \left\langle g\right\vert .
\end{equation}
Now again using $\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}=0$ gives
\begin{equation}
\left\vert g\right\rangle \left\langle g\right\vert \wedge\left\vert
g\right\rangle \left\langle g\right\vert =\left\vert g\wedge g\right\rangle
\left\langle g\wedge g\right\vert =0,
\end{equation}
thus
\begin{equation}
\left\vert g\wedge g\right\rangle =0.
\end{equation}
Utilizing the canonical expansion of $\left\vert g\right\rangle $ gives
\begin{equation}
\sum_{1\leq l_{1}<l_{2}\leq s}c_{l_{1}}c_{l_{2}}\left\vert \psi_{l_{1}}%
\psi_{l_{1}+s}\psi_{l_{2}}\psi_{l_{2}+s}\right\rangle =0
\end{equation}
which shows that
\begin{equation}
\operatorname*{rank}\left\{  \left\vert g\right\rangle \right\}  =1
\end{equation}

\end{itemize}

\bigskip************************************************************************************************************************

\section{Idempotency of $\lambda_{2}$}

Expanding the operator $\lambda_{2}$ the idempotency condition eq. $\left(
\ref{idem2}\right)  $ becomes
\begin{equation}
\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}g_{l}^{\dagger}g_{l}=\sum_{1\leq
l_{1},l_{2}\leq\binom{r}{2}}\beta_{l_{1}}\beta_{l_{2}}g_{l_{1}}^{\dagger
}g_{l_{1}}g_{l_{2}}^{\dagger}g_{l_{2}} \label{lam2}%
\end{equation}
and one must compare the left hand side of eq. $\left(  \ref{lam2}\right)  $
to the right hand side. In order to do this one brings the RHS of eq. $\left(
\ref{lam2}\right)  $ to normal form producing
\begin{equation}
\sum_{1\leq l_{1},l_{2}\leq\binom{r}{2}}\beta_{l_{1}}\beta_{l_{2}}g_{l_{1}%
}^{\dagger}g_{l_{1}}g_{l_{2}}^{\dagger}g_{l_{2}}=\sum_{1\leq l_{1},l_{2}%
\leq\binom{r}{2}}\beta_{l_{1}}\beta_{l_{2}}\left\{  g_{l_{1}}^{\dagger}\left[
g_{l_{1}},g_{l_{2}}^{\dagger}\right]  g_{l_{2}}+g_{l_{1}}^{\dagger}g_{l_{2}%
}^{\dagger}g_{l_{1}}g_{l_{2}}\right\}  , \label{normform}%
\end{equation}
which can be developed by noting that%
\begin{equation}
\left[  g_{l_{1}},g_{l_{2}}^{\dagger}\right]  =\frac{1}{4}\sum
_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq r}}\bar{g}%
_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}}\left[  a_{j_{2}}a_{j_{1}},a_{k_{1}%
}^{\dagger}a_{k_{2}}^{\dagger}\right]  =\,-\frac{1}{4}\sum_{\substack{1\leq
j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq r}}\bar{g}_{l_{1}j_{1}j_{2}}%
g_{l_{2}k_{1}k_{2}}\left[  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger},a_{j_{2}%
}a_{j_{1}}\right]  ,
\end{equation}
that after using the commutation relationship
\begin{equation}
\left[  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger},a_{j_{2}}a_{j_{1}}\right]
=I_{\mathcal{H}_{\mathcal{F}}}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}%
}-I_{\mathcal{H}_{\mathcal{F}}}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{1}}%
+a_{k_{2}}^{\dagger}a_{j_{2}}\delta_{j_{1}k_{1}}-a_{k_{1}}^{\dagger}a_{j_{2}%
}\delta_{j_{1}k_{2}}-a_{k_{2}}^{\dagger}a_{j_{1}}\delta_{j_{2}k_{1}}+a_{k_{1}%
}^{\dagger}a_{j_{1}}\delta_{j_{2}k_{2}}%
\end{equation}
gives
\begin{align}
&  \left[  g_{l_{1}},g_{l_{2}}^{\dagger}\right]  =-\frac{1}{4}\sum
_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq r}}\bar{g}%
_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}}\left\{  I_{\mathcal{H}_{\mathcal{F}}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}-I_{\mathcal{H}_{\mathcal{F}}}%
\delta_{j_{2}k_{2}}\delta_{j_{1}k_{1}}\right. \nonumber\\
&  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\right.  \left.  a_{k_{2}%
}^{\dagger}a_{j_{2}}\delta_{j_{1}k_{1}}-a_{k_{1}}^{\dagger}a_{j_{2}}%
\delta_{j_{1}k_{2}}-a_{k_{2}}^{\dagger}a_{j_{1}}\delta_{j_{2}k_{1}}+a_{k_{1}%
}^{\dagger}a_{j_{1}}\delta_{j_{2}k_{2}}\right\}  ,\nonumber
\end{align}
then%
\begin{align}
&  =-\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1},k_{2}\leq
r}}\left\{  \bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}}\delta_{j_{2}k_{1}%
}\delta_{j_{1}k_{2}}-\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}}\delta
_{j_{2}k_{2}}\delta_{j_{1}k_{1}}+\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}%
}\delta_{j_{1}k_{1}}a_{k_{2}}^{\dagger}a_{j_{2}}\right. \\
&  \left.  \qquad\qquad\right.  \left.  \quad-\bar{g}_{l_{1}j_{1}j_{2}%
}g_{l_{2}k_{1}k_{2}}\delta_{j_{1}k_{2}}a_{k_{1}}^{\dagger}a_{j_{2}}-\bar
{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}}\delta_{j_{2}k_{1}}a_{k_{2}}^{\dagger
}a_{j_{1}}+\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}k_{2}}\delta_{j_{2}k_{2}%
}a_{k_{1}}^{\dagger}a_{j_{1}}\right\}  ,
\end{align}
then%
\begin{align}
=  &  \frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\bar{g}_{l_{1}j_{1}j_{2}%
}g_{l_{2}j_{1}j_{2}}-\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq
k_{2}\leq r}}\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}j_{1}k_{2}}a_{k_{2}}^{\dagger
}a_{j_{2}}+\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1}\leq
r}}\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}j_{1}}a_{k_{1}}^{\dagger}a_{j_{2}}\\
&  +\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{2}\leq
r}}\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}j_{2}k_{2}}a_{k_{2}}^{\dagger}a_{j_{1}%
}-\frac{1}{4}\sum_{\substack{1\leq j_{1},j_{2}\leq r\\1\leq k_{1}\leq r}%
}\bar{g}_{l_{1}j_{1}j_{2}}g_{l_{2}k_{1}j_{2}}a_{k_{1}}^{\dagger}a_{j_{1}},
\end{align}
then
\begin{equation}
=\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\bar{g}_{l_{1}j_{1}j_{2}}%
g_{l_{2}j_{1}j_{2}}-\frac{1}{4}\sum_{\substack{1\leq j,j_{2}\leq r\\1\leq
k_{2}\leq r}}\left\{  \bar{g}_{l_{1}jj_{2}}g_{l_{2}jk_{2}}-\bar{g}%
_{l_{1}jj_{2}}g_{l_{2}k_{2}j}-\bar{g}_{l_{1}j_{2}j}g_{l_{2}jk_{2}}+\bar
{g}_{l_{1}j_{2}j}g_{l_{2}k_{2}j}\right\}  a_{k_{2}}^{\dagger}a_{j_{2}},
\end{equation}
then%
\begin{equation}
=\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\bar{g}_{l_{1}j_{1}j_{2}}%
g_{l_{2}j_{1}j_{2}}-\frac{1}{4}\sum_{\substack{1\leq j,j_{2}\leq r\\1\leq
k_{2}\leq r}}\left\{  -\bar{g}_{l_{1}j_{2}j}g_{l_{2}jk_{2}}-g_{l_{2}k_{2}%
j}\bar{g}_{l_{1}jj_{2}}-\bar{g}_{l_{1}j_{2}j}g_{l_{2}jk_{2}}-g_{l_{2}k_{2}%
j}\bar{g}_{l_{1}jj_{2}}\right\}  a_{k_{2}}^{\dagger}a_{j_{2}},
\end{equation}
hen%
\begin{equation}
=\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\bar{g}_{l_{1}j_{1}j_{2}}%
g_{l_{2}j_{1}j_{2}}+\frac{1}{2}\sum_{\substack{1\leq j,j_{2}\leq r\\1\leq
k_{2}\leq r}}\left\{  \bar{g}_{l_{1}j_{2}j}g_{l_{2}jk_{2}}+g_{l_{2}k_{2}j}%
\bar{g}_{l_{1}jj_{2}}\right\}  a_{k_{2}}^{\dagger}a_{j_{2}},
\end{equation}
then%
\begin{equation}
\delta_{l_{1}l_{2}}+\sum_{1\leq j_{2},k_{2}\leq r}\eta_{l_{1}l_{2}k_{2}j_{2}%
}a_{k_{2}}^{\dagger}a_{j_{2}},
\end{equation}
where
\begin{equation}
\eta_{l_{1}l_{2}k_{2}j_{2}}=\frac{1}{2}\left(  \bar{g}_{l_{1}j_{2}j}%
g_{l_{2}jk_{2}}+g_{l_{2}k_{2}j}\bar{g}_{l_{1}jj_{2}}\right)  =\bar{g}%
_{l_{1}j_{2}j}g_{l_{2}jk_{2}}.
\end{equation}
Let the rank of the operator $\lambda_{2}$ be two then
\begin{align}
\eta_{11k_{2}j_{2}}  &  =\bar{g}_{1j_{2}j}g_{1jk_{2}}\\
\eta_{12k_{2}j_{2}}  &  =\bar{g}_{1j_{2}j}g_{2jk_{2}}\\
\eta_{21k_{2}j_{2}}  &  =\bar{g}_{2j_{2}j}g_{1jk_{2}}\\
\eta_{22k_{2}j_{2}}  &  =\bar{g}_{2j_{2}j}g_{2jk_{2}}.
\end{align}
The idempotency condition then becomes%
\begin{align}
\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}g_{l}^{\dagger}g_{l}  &  =\sum_{1\leq
l_{1},l_{2}\leq\binom{r}{2}}\beta_{l_{1}}\beta_{l_{2}}g_{l_{1}}^{\dagger
}g_{l_{1}}g_{l_{2}}^{\dagger}g_{l_{2}}=\nonumber\\
&  \sum_{1\leq l_{1},l_{2}\leq\binom{r}{2}}\beta_{l_{1}}\beta_{l_{2}}\left\{
g_{l_{1}}^{\dagger}\left\{  \delta_{l_{1}l_{2}}+\sum_{1\leq j_{2},k_{2}\leq
r}\eta_{l_{1}l_{2}k_{2}j_{2}}a_{k_{2}}^{\dagger}a_{j_{2}}\right\}  g_{l_{2}%
}+g_{l_{1}}^{\dagger}g_{l_{2}}^{\dagger}g_{l_{1}}g_{l_{2}}\right\}  ,
\end{align}
giving%
\begin{equation}
\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}g_{l}^{\dagger}g_{l}=\sum_{1\leq
l\leq\binom{r}{2}}\beta_{l}^{2}g_{l}^{\dagger}g_{l}+\sum_{1\leq l_{1}%
,l_{2}\leq\binom{r}{2}}\beta_{l_{1}}\beta_{l_{2}}\left\{  \sum_{1\leq
j_{2},k_{2}\leq r}\eta_{l_{1}l_{2}k_{2}j_{2}}g_{l_{1}}^{\dagger}a_{k_{2}%
}^{\dagger}a_{j_{2}}g_{l_{2}}+g_{l_{1}}^{\dagger}g_{l_{2}}^{\dagger}g_{l_{1}%
}g_{l_{2}}\right\}  ,
\end{equation}
thus
\begin{equation}
\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}g_{l}^{\dagger}g_{l}\left\vert
g_{\kappa}\right\rangle =\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}^{2}%
g_{l}^{\dagger}g_{l}\left\vert g_{\kappa}\right\rangle \Longleftrightarrow
\beta_{\kappa}\left(  \beta_{\kappa}-1\right)  =0;\quad1\leq\kappa\leq
\binom{r}{2}.
\end{equation}
This gives
\begin{equation}
\sum_{\sigma\in\left\{  1,\cdots,\binom{r}{2}\right\}  }g_{\sigma}^{\dagger
}g_{\sigma}=\sum_{\sigma\in\left\{  1,\cdots,\binom{r}{2}\right\}  }g_{\sigma
}^{\dagger}g_{\sigma}\,+\sum_{\sigma,\sigma^{\prime}\in\left\{  1,\cdots
,\binom{r}{2}\right\}  }\left\{  \sum_{1\leq j_{2},k_{2}\leq r}\eta
_{\sigma\sigma^{\prime}k_{2}j_{2}}g_{\sigma}^{\dagger}a_{k_{2}}^{\dagger
}a_{j_{2}}g_{\sigma^{\prime}}+g_{\sigma}^{\dagger}g_{\sigma^{\prime}}%
^{\dagger}g_{\sigma}g_{\sigma^{\prime}}\right\}
\end{equation}
so that%
\begin{equation}
\sum_{\sigma,\sigma^{\prime}\in\left\{  1,\cdots,\binom{r}{2}\right\}
}\left\{  \sum_{1\leq j_{2},k_{2}\leq r}\eta_{\sigma\sigma^{\prime}k_{2}j_{2}%
}g_{\sigma}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{\sigma^{\prime}}%
+g_{\sigma}^{\dagger}g_{\sigma^{\prime}}^{\dagger}g_{\sigma}g_{\sigma^{\prime
}}\right\}  =0
\end{equation}%
\begin{equation}
\sum_{\sigma,\sigma^{\prime}\in\left\{  1,\cdots,\binom{r}{2}\right\}
}\left\{  g_{\sigma}^{\dagger}\left(  \sum_{1\leq j_{2},k_{2}\leq r}%
\eta_{\sigma\sigma^{\prime}k_{2}j_{2}}a_{k_{2}}^{\dagger}a_{j_{2}}\right)
g_{\sigma^{\prime}}+g_{\sigma}^{\dagger}g_{\sigma^{\prime}}^{\dagger}%
g_{\sigma}g_{\sigma^{\prime}}\right\}  =0
\end{equation}
and in particular
\begin{equation}
\sum_{\sigma,\sigma^{\prime}\in\left\{  1,\cdots,\binom{r}{2}\right\}  }%
\sum_{1\leq j_{2},k_{2}\leq r}\eta_{\sigma\sigma^{\prime}k_{2}j_{2}}g_{\sigma
}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{\sigma^{\prime}}\left\vert
g_{\kappa}\varphi\right\rangle =0\,\forall\left\vert g_{\kappa}\varphi
\right\rangle
\end{equation}%
\begin{align}
\eta_{11k_{2}j_{2}}  &  =\sum_{1\leq j\leq r}\bar{g}_{1j_{2}j}g_{1jk_{2}%
}=-\left(  \mathbb{G}_{1}^{\dagger}\mathbb{G}_{1}\right)  _{k_{2}j_{2}}\\
\eta_{12k_{2}j_{2}}  &  =\sum_{1\leq j\leq r}\bar{g}_{1j_{2}j}g_{2jk_{2}%
}=-\left(  \mathbb{G}_{1}^{\dagger}\mathbb{G}_{2}\right)  _{k_{2}j_{2}}\\
\eta_{21k_{2}j_{2}}  &  =\sum_{1\leq j\leq r}\bar{g}_{2j_{2}j}g_{1jk_{2}%
}=-\left(  \mathbb{G}_{2}^{\dagger}\mathbb{G}_{1}\right)  _{k_{2}j_{2}}\\
\eta_{22k_{2}j_{2}}  &  =\sum_{1\leq j\leq r}\bar{g}_{2j_{2}j}g_{2jk_{2}%
}=-\left(  \mathbb{G}_{2}^{\dagger}\mathbb{G}_{2}\right)  _{k_{2}j_{2}}.
\end{align}
%

\begin{align}
&  -\sum_{1\leq j_{2},k_{2}\leq r}\left\{  \left(  \mathbb{G}_{1}^{\dagger
}\mathbb{G}_{1}\right)  _{k_{2}j_{2}}g_{1}^{\dagger}a_{k_{2}}^{\dagger
}a_{j_{2}}g_{1}+\left(  \mathbb{G}_{1}^{\dagger}\mathbb{G}_{2}\right)
_{k_{2}j_{2}}g_{1}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{2}\right.
\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  +\left(  \mathbb{G}%
_{2}^{\dagger}\mathbb{G}_{1}\right)  _{k_{2}j_{2}}g_{2}^{\dagger}a_{k_{2}%
}^{\dagger}a_{j_{2}}g_{1}+\left(  \mathbb{G}_{2}^{\dagger}\mathbb{G}%
_{2}\right)  _{k_{2}j_{2}}g_{2}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}%
g_{2}\right\}
\end{align}%
\begin{align}
&  \sum_{1\leq j,j_{2},k_{2}\leq r}\left\{  \bar{g}_{1j_{2}j}g_{1jk_{2}}%
g_{1}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{1}+\bar{g}_{1j_{2}j}g_{2jk_{2}%
}g_{1}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{2}+\bar{g}_{2j_{2}j}g_{1jk_{2}%
}g_{2}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{1}+\bar{g}_{2j_{2}j}g_{2jk_{2}%
}g_{2}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}g_{2}\right\}  \left\vert
g_{\kappa}\varphi_{\nu}\right\rangle \nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  =\right.
0\,\forall\left\vert g_{\kappa}\varphi_{\nu}\right\rangle
\end{align}%
\begin{equation}
\sum_{1\leq j,k_{2}\leq r}\left\{  \bar{g}_{1\nu j}g_{1jk_{2}}\left\vert
g_{1}\varphi_{k_{2}}\right\rangle +\bar{g}_{2\nu j}g_{1jk_{2}}\left\vert
g_{2}\varphi_{k_{2}}\right\rangle \right\}  =0\,
\end{equation}%
\begin{equation}
\sum_{1\leq k_{2}\leq r}\left\{  \left(  \mathbb{G}_{1}^{\dagger}%
\mathbb{G}_{1}\right)  _{k_{2}\nu}\left\vert g_{1}\varphi_{k_{2}}\right\rangle
+\left(  \mathbb{G}_{2}^{\dagger}\mathbb{G}_{1}\right)  _{k_{2}\nu}\left\vert
g_{2}\varphi_{k_{2}}\right\rangle \right\}  =0\,
\end{equation}%
\begin{align}
\lambda_{2}  &  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq
k_{1}<k_{2}\leq\infty}}\lambda_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}=\sum_{1\leq l\leq r}\beta_{l}%
g_{l}^{\dagger}g_{l}\nonumber\\
&  =\sum_{\substack{1\leq l\leq r\\1\leq j_{1},j_{2}\leq s}}c_{lj_{1}%
}c_{lj_{2}}\beta_{l}b_{lj_{1}}^{\dagger}b_{lj_{1}+s}^{\dagger}b_{lj_{2}%
+s}b_{lj_{2}}=\sum_{\substack{1\leq l\leq r\\1\leq j_{1},j_{2}\leq
s}}c_{lj_{1}}c_{lj_{2}}\beta_{l}b_{lj_{1}}^{\dagger}\left(  \delta_{j_{1}%
j_{2}}-b_{lj_{2}+s}b_{lj_{1}+s}^{\dagger}\right)  b_{lj_{2}}\nonumber\\
&  =\sum_{\substack{1\leq l\leq r\\1\leq j_{1}\leq s}}c_{lj_{1}}c_{lj_{1}%
}\beta_{l}b_{lj_{1}}^{\dagger}b_{lj_{1}}-\sum_{\substack{1\leq l\leq r\\1\leq
j_{1},j_{2}\leq s}}c_{lj_{1}}c_{lj_{2}}\beta_{l}b_{lj_{1}}^{\dagger}%
b_{lj_{2}+s}b_{lj_{1}+s}^{\dagger}b_{lj_{2}}%
\end{align}


