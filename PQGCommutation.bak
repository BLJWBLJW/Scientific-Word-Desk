\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi_{3}\right\vert
\right)  \right) \nonumber\\
&  =2\sum_{4\leq j_{4}<\cdots<j_{m}\leq r}\left\vert \varphi_{1}\varphi
_{2}\varphi_{3}\varphi_{j_{4}}\cdots\varphi_{j_{m}}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{j_{4}}\cdots\varphi_{j_{m}%
}\right\vert
\end{align}


\item
\begin{align}
&  \lambda_{1}=a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}a_{2}=\Gamma\left(
\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert +\left\vert
\psi_{2}\right\rangle \left\langle \psi_{2}\right\vert \right)  ;\nonumber\\
&  \lambda_{2}=-a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=-\Gamma\left(
\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert \right) \nonumber\\
&  \lambda_{1}\lambda_{2}=-\left(  a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}%
a_{2}\right)  a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=-a_{1}^{\dagger}\left(
1-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger}a_{2}{}_{1}-a_{2}^{\dagger
}\left(  1-a_{2}^{\dagger}a_{2}\right)  a_{1}^{\dagger}a_{1}a_{2}%
=-2a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\nonumber\\
&  \lambda_{2}\lambda_{1}=-2a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
\nonumber\\
&  \lambda_{1}\lambda_{2}+\lambda_{2}\lambda_{1}=-4a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}=-4\Gamma\left(  \left\vert \psi_{1}\psi
_{2}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert \right) \nonumber\\
&  \lambda_{1}^{2}-\lambda_{1}=\left(  a_{1}^{\dagger}a_{1}+a_{2}^{\dagger
}a_{2}\right)  ^{2}-\left(  a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}a_{2}\right)
=2a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\nonumber\\
&  \lambda_{2}^{2}-\lambda_{2}=a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
--a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=2a_{1}^{\dagger}a_{2}^{\dagger
}a_{2}a_{1}\nonumber\\
&  \lambda_{1}^{2}-\lambda_{1}+\lambda_{2}^{2}-\lambda_{2}+\lambda_{1}%
\lambda_{2}+\lambda_{2}\lambda_{1}=0+2a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
a_{1}+2a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}-4a_{1}^{\dagger}a_{2}%
^{\dagger}a_{2}a_{1}=0\rfloor
\end{align}
hence the idempotency condition%
\begin{equation}
\left(  \lambda_{1}+\lambda_{2}\right)  ^{2}-\left(  \lambda_{1}+\lambda
_{2}\right)  =\lambda_{1}^{2}-\lambda_{1}+\lambda_{2}^{2}-\lambda_{2}%
+\lambda_{1}\lambda_{2}+\lambda_{2}\lambda_{1}=0.
\end{equation}
