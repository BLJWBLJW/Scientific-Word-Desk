\begin{itemize}
\item The condition%
\begin{equation}
\hat{\lambda}_{1}^{2}-\hat{\lambda}_{1}=0
\end{equation}
shows that $\hat{\lambda}_{1}$ has eigenvalues $\left\{  0,1\right\}  $ and
$\hat{\lambda}_{1}$ is a projector which can be expanded as
\begin{equation}
\hat{\lambda}_{1}=\sum_{1\leq j\leq v}\left\vert \psi_{j}\right\rangle
\left\langle \psi_{j}\right\vert
\end{equation}
for any basis that spans the range of $\hat{\lambda}_{1}$.

\item The condition $\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}=0$ shows that
\begin{equation}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}=\sum_{1\leq j\leq v}\left\vert
\psi_{j}\right\rangle \left\langle \psi_{j}\right\vert \wedge\sum
_{\substack{1\leq k<l\leq r\\1\leq m<n\leq r}}\lambda_{klmn}\left\vert
\psi_{k}\psi_{l}\right\rangle \left\langle \psi_{m}\psi_{n}\right\vert
=\sum_{\substack{1\leq k<l\leq r\\1\leq m<n\leq r\\1\leq j\leq v}%
}\lambda_{klmn}\left\vert \psi_{j}\psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{j}\psi_{m}\psi_{n}\right\vert =0.
\end{equation}
Given a projector $\hat{\lambda}_{1}$ what solutions for $\hat{\lambda}_{2}$
are possible for $\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}=0$, first we
determine the subspace $\left\{  \left\vert \psi_{k}\psi_{l}\right\rangle
\left\langle \psi_{m}\psi_{n}\right\vert \right\}  ,$ which is the kernal of
the linear map $\sum_{1\leq j\leq v}\left\vert \psi_{j}\right\rangle
\left\langle \psi_{j}\right\vert \wedge$ i.e.
\begin{equation}
\sum_{1\leq j\leq v}\left\vert \psi_{j}\right\rangle \left\langle \psi
_{j}\right\vert \wedge\left\vert \psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{m}\psi_{n}\right\vert =0.
\end{equation}
This gives for $\nu=1$
\begin{equation}
\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert
\wedge\left\vert \psi_{k}\psi_{l}\right\rangle \left\langle \psi_{m}\psi
_{n}\right\vert =0\Rightarrow k=1\text{ or }l=1\text{ or }m=1\text{ or }n=1
\end{equation}
i.e. $\left\vert \psi_{k}\psi_{l}\right\rangle \left\langle \psi_{m}\psi
_{n}\right\vert $ must be of the form
\begin{equation}
\left\{  \left\vert \psi_{1}\psi_{l}\right\rangle \left\langle \psi_{m}%
\psi_{n}\right\vert ,\left\vert \psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{n}\right\vert ,\left\vert \psi_{1}\psi_{l}\right\rangle
\left\langle \psi_{1}\psi_{n}\right\vert \right\}  .
\end{equation}
For $\nu=2$ the operators $\left\{  \left\vert \psi_{k}\psi_{l}\right\rangle
\left\langle \psi_{m}\psi_{n}\right\vert \right\}  $ must be "orthogonal" to
both $\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert $ and
$\left\vert \psi_{2}\right\rangle \left\langle \psi_{2}\right\vert $ and must
be of the form
\begin{equation}
\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle \psi_{2}\psi
_{n}\right\vert ,\left\vert \psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert ,\left\vert \psi_{2}\psi_{l}\right\rangle
\left\langle \psi_{1}\psi_{n}\right\vert ,\left\vert \psi_{1}\psi
_{2}\right\rangle \left\langle \psi_{m}\psi_{n}\right\vert .
\end{equation}
For $\nu=3$ the operators $\left\{  \left\vert \psi_{k}\psi_{l}\right\rangle
\left\langle \psi_{m}\psi_{n}\right\vert \right\}  $ must be "orthogonal" to
$\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert $,
$\left\vert \psi_{2}\right\rangle \left\langle \psi_{2}\right\vert $ and
$\left\vert \psi_{3}\right\rangle \left\langle \psi_{3}\right\vert $ thus they
must be of the form
\begin{equation}
\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{2}\psi
_{n}\right\vert ,\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert ,\left\vert \psi_{k}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert ,\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{n}\right\vert ,\left\vert
\psi_{2}\psi_{l}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert
,\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{3}\psi
_{n}\right\vert .
\end{equation}
For $\nu=4$ the operators $\left\{  \left\vert \psi_{k}\psi_{l}\right\rangle
\left\langle \psi_{m}\psi_{n}\right\vert \right\}  $ must be "orthogonal" to
$\left\vert \psi_{1}\right\rangle \left\langle \psi_{1}\right\vert $,
$\left\vert \psi_{2}\right\rangle \left\langle \psi_{2}\right\vert ,\left\vert
\psi_{3}\right\rangle \left\langle \psi_{3}\right\vert $ and $\left\vert
\psi_{4}\right\rangle \left\langle \psi_{4}\right\vert $ and must be of the
form
\begin{equation}
\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{2}\psi
_{4}\right\vert ,\left\vert \psi_{1}\psi_{4}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert ,\left\vert \psi_{3}\psi_{4}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert ,\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{4}\right\vert ,\left\vert
\psi_{2}\psi_{4}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert
,\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{3}\psi
_{4}\right\vert .
\end{equation}
The operator $\hat{\lambda}_{2}$ is self adjoint thus one needs to consider
basis elements
\begin{equation}
\left\{  \frac{1}{\sqrt{2}}\left(  \left\vert \psi_{k}\psi_{l}\right\rangle
\left\langle \psi_{m}\psi_{n}\right\vert +\left\vert \psi_{m}\psi
_{n}\right\rangle \left\langle \psi_{k}\psi_{l}\right\vert \right)  ,\frac
{i}{\sqrt{2}}\left(  \left\vert \psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{m}\psi_{n}\right\vert -\left\vert \psi_{m}\psi_{n}\right\rangle
\left\langle \psi_{k}\psi_{l}\right\vert \right)  \right\}
\end{equation}
which in order to be orthogonal to $\left\vert \psi_{1}\right\rangle
\left\langle \psi_{1}\right\vert $ and $\left\vert \psi_{2}\right\rangle
\left\langle \psi_{2}\right\vert $ must be of the form
\begin{align}
&  \frac{1}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{l}\right\rangle
\left\langle \psi_{2}\psi_{n}\right\vert +\left\vert \psi_{2}\psi
_{l}\right\rangle \left\langle \psi_{1}\psi_{n}\right\vert \right)  ,\frac
{1}{\sqrt{2}}\left(  \left\vert \psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert +\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{k}\psi_{l}\right\vert \right) \nonumber\\
&  \frac{i}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{l}\right\rangle
\left\langle \psi_{2}\psi_{n}\right\vert -\left\vert \psi_{2}\psi
_{l}\right\rangle \left\langle \psi_{1}\psi_{n}\right\vert \right)  ,\frac
{i}{\sqrt{2}}\left(  \left\vert \psi_{k}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert -\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{k}\psi_{l}\right\vert \right)  ,
\end{align}
while in order it be orthogonal to $\left\vert \psi_{1}\right\rangle
\left\langle \psi_{1}\right\vert $, $\left\vert \psi_{2}\right\rangle
\left\langle \psi_{2}\right\vert $ and $\left\vert \psi_{3}\right\rangle
\left\langle \psi_{3}\right\vert $ they must be of the form
\begin{align}
&  \frac{1}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{2}\psi_{n}\right\vert +\left\vert \psi_{2}\psi
_{n}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert \right)  ,\frac
{1}{\sqrt{2}}\left(  \left\vert \psi_{3}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert +\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{3}\psi_{l}\right\vert \right) \nonumber\\
&  \frac{1}{\sqrt{2}}\left(  \left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{n}\right\vert +\left\vert \psi_{1}\psi
_{n}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \right)
,\nonumber\\
&  \frac{i}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{2}\psi_{n}\right\vert -\left\vert \psi_{2}\psi
_{n}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert \right)  ,\frac
{i}{\sqrt{2}}\left(  \left\vert \psi_{3}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert -\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{3}\psi_{l}\right\vert \right) \nonumber\\
&  \frac{i}{\sqrt{2}}\left(  \left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{n}\right\vert -\left\vert \psi_{1}\psi
_{n}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \right)  ,
\end{align}
while in order be orthogonal to $\left\vert \psi_{1}\right\rangle \left\langle
\psi_{1}\right\vert $, $\left\vert \psi_{2}\right\rangle \left\langle \psi
_{2}\right\vert ,\left\vert \psi_{3}\right\rangle \left\langle \psi
_{3}\right\vert $ and $\left\vert \psi_{4}\right\rangle \left\langle \psi
_{4}\right\vert $ it must be of the form%
\begin{align}
&  \frac{1}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{2}\psi_{4}\right\vert +\left\vert \psi_{2}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert \right)  ,\frac
{1}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{2}\right\rangle \left\langle
\psi_{3}\psi_{4}\right\vert +\left\vert \psi_{3}\psi_{4}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert \right) \nonumber\\
&  \frac{1}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{4}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{4}\right\vert \right)
,\nonumber\\
&  \left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert ,\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{3}\right\vert ,\left\vert \psi_{1}\psi_{4}\right\rangle
\left\langle \psi_{1}\psi_{4}\right\vert ,\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert ,\left\vert
\psi_{2}\psi_{4}\right\rangle \left\langle \psi_{2}\psi_{4}\right\vert
,\left\vert \psi_{3}\psi_{4}\right\rangle \left\langle \psi_{3}\psi
_{4}\right\vert ,\nonumber\\
&  \frac{i}{\sqrt{2}}\left(  \left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{2}\psi_{4}\right\vert -\left\vert \psi_{2}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert \right)  ,\frac
{i}{\sqrt{2}}\left(  \left\vert \psi_{3}\psi_{4}\right\rangle \left\langle
\psi_{1}\psi_{2}\right\vert -\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{3}\psi_{4}\right\vert \right) \nonumber\\
&  \frac{i}{\sqrt{2}}\left(  \left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{4}\right\vert -\left\vert \psi_{1}\psi
_{4}\right\rangle \left\langle \psi_{2}\psi_{3}\right\vert \right)  .
\end{align}


\item We consider the condition
\begin{equation}
\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}=0
\end{equation}


\item 1. Let
\begin{equation}
\hat{\lambda}_{1}=\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert
\end{equation}
then $\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}=0$ gives $\left(
\text{simplifying notation by }\lambda_{2}\equiv\lambda\right)  $
\begin{equation}
\hat{\lambda}_{2}=\frac{1}{2}\sum_{\substack{2<i<r\\2\leq j,k\leq r}}\left\{
\lambda_{1ijk}\left\vert \psi_{1}\psi_{i}\right\rangle \left\langle \psi
_{j}\psi_{k}\right\vert +\lambda_{jk1i}\left\vert \psi_{j}\psi_{k}%
\right\rangle \left\langle \psi_{1}\psi_{i}\right\vert \right\}  +\frac{1}%
{2}\sum_{2\leq i,j\leq r}\lambda_{1i1j}\left\vert \psi_{1}\psi_{i}%
\right\rangle \left\langle \psi_{1}\psi_{j}\right\vert
\end{equation}
e.g. if $r=3$
\begin{align}
&  \hat{\lambda}_{2}=\lambda_{1223}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{2312}\left\vert \psi
_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
+\lambda_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi
_{1}\psi_{2}\right\vert +\nonumber\\
&  \lambda_{1323}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{2}\psi_{3}\right\vert +\lambda_{2313}\left\vert \psi_{2}\psi
_{3}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1313}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert +\lambda_{1312}\left\vert \psi
_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert
\end{align}
so that
\begin{align}
&  \lambda_{2}=\lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda_{1212}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}+\nonumber\\
&  \lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1313}a_{1}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\nonumber\\
&  =\left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
+\lambda_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right)  +\nonumber\\
&  \left(  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda_{1323}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\right)  .
\end{align}%
\begin{align}
&  \lambda_{2}^{2}=\left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{2}a_{1}+\lambda_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right)
^{2}+\nonumber\\
&  \left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
+\lambda_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right) \nonumber\\
&  \times\left(  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}%
a_{2}+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda
_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger
}a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\right)
\nonumber\\
&  \left(  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda_{1323}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\right)
\nonumber\\
&  \times\left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
a_{1}+\lambda_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right)
\nonumber\\
&  +\left(  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda_{1323}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\right)  ^{2}%
\end{align}
We evaluate this in stages the first part is
\begin{equation}
\left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}+\lambda
_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right)  ^{2}=\lambda
_{1212}^{2}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}+\lambda_{1313}^{2}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}+2\lambda_{1212}\lambda_{1313}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}a_{1}%
\end{equation}
the second is
\begin{align}
&  \left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
+\lambda_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right) \nonumber\\
&  \times\left(  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}%
a_{2}+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda
_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger
}a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\right)
\left.  =\right. \nonumber\\
&  \lambda_{1212}\lambda_{1223}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}+\lambda_{1212}\lambda_{2312}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}+\lambda_{1212}\lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{1}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}\nonumber\\
&  +\lambda_{1212}\lambda_{2313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\\
&  +\lambda_{1212}\lambda_{1213}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}+\lambda_{1212}\lambda_{1312}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}a_{1}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}\nonumber\\
&  +\lambda_{1313}\lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}+\lambda_{1313}\lambda_{2312}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}\nonumber\\
&  +\lambda_{1313}\lambda_{1323}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{1313}\lambda_{2313}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{1}\\
&  +\lambda_{1313}\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}+\lambda_{1313}\lambda_{1312}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}a_{1}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}%
\end{align}%
\begin{equation}
=\lambda_{1212}\lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}%
+\lambda_{1212}\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
+\lambda_{1313}\lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
+\lambda_{1313}\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}%
\end{equation}
the third is
\begin{align}
&  \left(  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda_{1323}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\right)
\nonumber\\
&  \times\left(  \lambda_{1212}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
a_{1}+\lambda_{1313}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right)  \left.
=\right. \nonumber\\
&  \lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}+\lambda_{2312}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}+\lambda_{1323}a_{1}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{1}+\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}%
+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
\end{align}%
\begin{equation}
=\lambda_{1212}\lambda_{2313}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}%
+\lambda_{1212}\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}%
+\lambda_{1313}\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
+\lambda_{1313}\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
\end{equation}
and the fourth is
\begin{align}
&  \left(
\begin{array}
[c]{c}%
\overset{\alpha+\alpha^{\dagger}}{\overbrace{\lambda_{1223}a_{1}^{\dagger
}a_{2}^{\dagger}a_{3}a_{2}+\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}}}+\overset{\beta+\beta^{\dagger}}{\overbrace{\lambda_{1323}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\lambda_{2313}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}}}\\
+\overset{\gamma+\gamma^{\dagger}}{\overbrace{\lambda_{1213}a_{1}^{\dagger
}a_{2}^{\dagger}a_{3}a_{1}+\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}}}%
\end{array}
\right)  ^{2}=\nonumber\\
&  \left(  \left(  \alpha+\alpha^{\dagger}\right)  +\left(  \beta
+\beta^{\dagger}+\gamma+\gamma^{\dagger}\right)  \right)  ^{2}\left.  =\right.
\nonumber\\
&  \left(  \alpha+\alpha^{\dagger}\right)  ^{2}+\left(  \alpha+\alpha
^{\dagger}\right)  \left(  \beta+\beta^{\dagger}+\gamma+\gamma^{\dagger
}\right)  +\left(  \beta+\beta^{\dagger}+\gamma+\gamma^{\dagger}\right)
\left(  \alpha+\alpha^{\dagger}\right)  +\left(  \beta+\beta^{\dagger}%
+\gamma+\gamma^{\dagger}\right)  ^{2}\left.  =\right. \nonumber\\
&  \alpha^{2}+\alpha^{\dagger2}+\alpha\alpha^{\dagger}+\alpha^{\dagger}%
\alpha+\alpha\beta+\alpha\beta^{\dagger}+\alpha\gamma+\alpha\gamma^{\dagger
}+\alpha^{\dagger}\beta+\alpha^{\dagger}\beta^{\dagger}+\alpha^{\dagger}%
\gamma+\alpha^{\dagger}\gamma^{\dagger}+\beta\alpha+\beta^{\dagger}%
\alpha\nonumber\\
&  +\gamma\alpha+\gamma^{\dagger}\alpha+\beta\alpha^{\dagger}+\beta^{\dagger
}\alpha^{\dagger}+\gamma\alpha^{\dagger}+\gamma^{\dagger}\alpha^{\dagger
}+\beta^{2}+\beta^{\dagger2}+\beta\beta^{\dagger}+\beta^{\dagger}\beta
+\gamma^{2}+\gamma^{\dagger2}+\gamma\gamma^{\dagger}\nonumber\\
&  +\gamma^{\dagger}\gamma+\beta\gamma+\beta\gamma^{\dagger}+\beta^{\dagger
}\gamma+\beta^{\dagger}\gamma^{\dagger}+\gamma\beta+\gamma^{\dagger}%
\beta+\gamma\beta^{\dagger}+\gamma^{\dagger}\beta^{\dagger}%
\end{align}%
\begin{equation}
\alpha^{2}=\alpha^{\dagger2}=\beta^{2}=\beta^{\dagger2}=\gamma^{2}%
=\gamma^{\dagger2}=0
\end{equation}%
\begin{equation}
\alpha\beta=\alpha^{\dagger}\beta^{\dagger}=\alpha^{\dagger}\gamma^{\dagger
}=\gamma\alpha=\alpha\gamma=\beta\alpha=\beta^{\dagger}\alpha^{\dagger}%
=\gamma^{\dagger}\alpha^{\dagger}=\beta^{\dagger}\gamma^{\dagger}=\gamma
\beta=\beta\gamma=\gamma^{\dagger}\beta^{\dagger}=0
\end{equation}%
\begin{align}
\alpha\alpha^{\dagger}  &  =\lambda_{1223}\lambda_{2312}a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}\nonumber\\
\alpha^{\dagger}\alpha &  =\lambda_{2312}\lambda_{1223}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{2}\nonumber\\
\beta\beta^{\dagger}  &  =\lambda_{1323}\lambda_{2313}a_{1}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}\nonumber\\
\beta^{\dagger}\beta &  =\lambda_{2313}\lambda_{1323}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{2}\nonumber\\
\gamma\gamma^{\dagger}  &  =\lambda_{1213}\lambda_{1312}a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}\nonumber\\
\gamma^{\dagger}\gamma &  =\lambda_{1312}\lambda_{1213}a_{1}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{1}%
\end{align}%
\begin{align}
\alpha\beta^{\dagger}  &  =\lambda_{1223}\lambda_{2313}a_{1}^{\dagger}%
a_{2}^{\dagger}a_{3}\left(  1-a_{2}^{\dagger}a_{2}\right)  a_{3}^{\dagger
}a_{3}a_{1}=\lambda_{1223}\lambda_{2313}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{3}^{\dagger}a_{3}a_{1}=\lambda_{1223}\lambda_{2313}a_{1}^{\dagger
}a_{2}^{\dagger}a_{3}a_{1}\nonumber\\
\alpha\beta &  =\lambda_{1223}\lambda_{1323}a_{1}^{\dagger}a_{2}^{\dagger
}a_{3}a_{2}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}=0\nonumber\\
\alpha\gamma^{\dagger}  &  =\lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{2}\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
=\lambda_{1223}\lambda_{1312}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}=0\nonumber\\
\alpha\gamma &  =\lambda_{1213}\lambda_{1223}a_{1}^{\dagger}a_{2}^{\dagger
}a_{3}a_{2}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}=0\nonumber\\
\alpha^{\dagger}\beta &  =\lambda_{2312}\lambda_{1323}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{2}a_{1}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}%
=\lambda_{2312}\lambda_{1323}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}\left(
1-a_{1}^{\dagger}a_{1}\right)  a_{3}^{\dagger}a_{3}a_{2}=0\nonumber\\
\alpha^{\dagger}\gamma &  =\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{2}a_{1}\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}%
=\lambda_{2312}\lambda_{1213}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}\left(
1-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger}a_{3}a_{1}\nonumber\\
&  =\lambda_{2312}\lambda_{1213}a_{2}^{\dagger}a_{3}^{\dagger}\left(
1-a_{2}^{\dagger}a_{2}\right)  a_{3}a_{1}=\lambda_{2312}\lambda_{1213}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\\
\beta^{\dagger}\gamma &  =\lambda_{2313}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{1}\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}%
=\lambda_{2313}\lambda_{1213}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}\left(
1-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger}a_{3}a_{1}=\lambda_{2313}%
\lambda_{1213}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}^{\dagger}a_{3}%
a_{1}=0\nonumber\\
\beta\gamma &  =\lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}%
\lambda_{1213}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}=\lambda_{1323}%
\lambda_{1213}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}a_{1}^{\dagger}%
a_{2}^{\dagger}a_{3}a_{1}=0\nonumber\\
\beta\gamma^{\dagger}  &  =\lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{2}\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
=\lambda_{1323}\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}=0
\end{align}%
\begin{align}
\hat{\lambda}_{1}^{2}-\hat{\lambda}_{1}  &  =0\nonumber\\
\hat{\lambda}_{1}\wedge\hat{\lambda}_{1}+\hat{\lambda}_{2}^{2}-\hat{\lambda
}_{2}+\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}_{2}%
+\hat{\lambda}_{2}\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)   &
=0\nonumber\\
2\hat{\lambda}_{1}\wedge\hat{\lambda}_{2}+L_{4}^{3}\left(  \hat{\lambda}%
_{2}\wedge\hat{\lambda}_{2}\right)   &  =0\Rightarrow\hat{\lambda}_{1}%
\wedge\hat{\lambda}_{2}=0\nonumber\\
\hat{\lambda}_{2}\wedge\hat{\lambda}_{2}  &  =0
\end{align}%
\begin{align}
\lambda_{2}^{2}  &  =2\lambda_{1212}\lambda_{1313}a_{1}^{\dagger}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}+\left(  \lambda_{1212}^{2}%
+\lambda_{1213}\lambda_{1312}+\lambda_{1223}\lambda_{2312}\right)
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}+\nonumber\\
&  \left(  \lambda_{1313}^{2}+\lambda_{1323}\lambda_{2313}+\lambda
_{1312}\lambda_{1213}\right)  a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}+\\
&  \left(  \lambda_{1212}\lambda_{1213}+\lambda_{1213}\lambda_{1313}\right)
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1}+\lambda_{1313}\lambda_{1223}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{2}+\lambda_{1212}\lambda_{1312}%
a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\nonumber\\
&  \lambda_{2312}\lambda_{1223}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}%
a_{2}+\lambda_{2313}\lambda_{1323}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}%
a_{2}+\lambda_{2312}\lambda_{1213}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}%
a_{1}+\nonumber\\
&  \lambda_{1212}\lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}%
a_{2}+\lambda_{2312}\lambda_{1323}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}%
a_{1}+\nonumber\\
&  \lambda_{1212}\lambda_{2313}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}%
a_{1}+\lambda_{1313}\lambda_{2312}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}%
a_{1}+\lambda_{1313}\lambda_{1312}a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}\\
&  +\lambda_{1223}\lambda_{2313}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}%
a_{1}+\lambda_{1223}\lambda_{1323}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}%
\end{align}
e.g. if $r=4$ the possible combinations that contain $1$ are:%
\begin{align}
&  1223,1224,1234,1323,1324,1334,1423,1424,1434\nonumber\\
&  2312,2412,3412,2313,2413,3413,2314,2414,3414\nonumber\\
&  1212,1213,1214,1312,1313,1314,1412,1413,1414
\end{align}
giving%
