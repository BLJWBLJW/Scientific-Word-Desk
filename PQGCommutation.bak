\sum_{0\leq P\leq r}P_{\mathcal{H}^{P}}\left(  \lambda_{1}^{2}-\lambda
_{1}+\lambda_{2}^{2}-\lambda_{2}+\lambda_{1}\lambda_{2}+\lambda_{2}\lambda
_{1}\right)  P_{\mathcal{H}^{P}}=0
\end{gather}
