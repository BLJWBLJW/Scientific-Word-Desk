\begin{align}
&  +\lambda_{1324}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{2}\psi_{4}\right\vert +\lambda_{2413}\left\vert \psi_{2}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1212}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert +\\
&  \lambda_{1324}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle
\psi_{2}\psi_{4}\right\vert +\lambda_{2413}\left\vert \psi_{2}\psi
_{4}\right\rangle \left\langle \psi_{1}\psi_{3}\right\vert +\lambda
_{1213}\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert +\lambda_{1312}\left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{2}\right\vert .
