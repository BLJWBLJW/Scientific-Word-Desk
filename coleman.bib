@ARTICLE{Coleman97,
  author = {A.J. Coleman},
  month = {15 May 1997},
  year = 1997,
  title = {The AGP model for fermion systems},
  journal = {Int. J. Quantum Chem.},
  volume = 63,
  number = 1,
  pages = {23-30},
  publisher = {Wiley},
  abstract = {A mathematically rigorous treatment of the antisymmetrized
             geminal power (AGP) model is given. The model is advocated as an
             extremely flexible tool for studying a wide variety of fermion
             systems, characterized by a single Slater determinant, on the one
             hand, or Yang's most highly correlated wave function, on the
             other. When the first-order reduced density matrix of the actual
             system has eigenvalues which are evenly degenerate, the model can
             treat one-particle properties exactly. A formula is obtained for
             the precise energy of an AGP state in the Born-Oppenheimer
             approximation. An estimate is given of the error which occurs
             when the second-order density matrix of an AGP state is
             approximated by the widely used expression involving the
             so-called anomalous Green's function.},
  keywords = {Eigenvalues and eigenfunctions; Fermion systems; AGP model;
             Fermion systems; Mathematically rigorous treatment;
             Antisymmetrized geminal power model; Single Slater determinant;
             Highly correlated wave function; First-order reduced density
             matrix; Evenly degenerate eigenvalues; One-particle properties;
             Second-order density matrix; Anomalous Green's function;
             Antisymmetrised geminal power state energy},
  language = {English}
}
@ARTICLE{Coleman95,
  author = {A.J. Coleman and E.P. Yukalova and V.I. Yukalov},
  month = {15 May 1995},
  year = 1995,
  title = {Pairon distributions and the spectra of reduced Hamiltonians},
  journal = {Int. J. Quantum Chem.},
  volume = 54,
  number = 4,
  pages = {211-22},
  abstract = {The reduction of the N-particle problem to the 2- and 1-particle
             problems is discussed, and the relation between the statistics of
             particles and the properties of the pairon distribution is
             studied. It turns out that not all levels of the pairon spectra
             can be occupied. A simple way of defining the pairon distribution
             is suggested. The spectra of the reduced Hamiltonian with
             power-law interaction potentials are analyzed. The bound states
             are calculated by the method of self-similar approximation, the
             accuracy of which is compared with and shown to be better than
             that of the quasi-classical approximation.},
  keywords = {Bound states; Many-body problems; Pairon distributions; Reduced
             Hamiltonian; N-particle problem; 2-Particle problem; 1-Particle
             problem; Particle statistics; Pairon spectra levels; Power-law
             interaction potentials; Bound states; Self-similar approximation;
             Quasi-classical approximation},
  language = {English}
}
@ARTICLE{Coleman95a,
  author = {A.J. Coleman and E.P. Yukalova and V.I. Yukalov},
  month = {20 Feb. 1995},
  year = 1995,
  title = {Superconductors with mesoscopic phase separation},
  journal = {Physica C},
  volume = 243,
  number = {1-2},
  pages = {76-92},
  abstract = {A model of superconductivity is proposed taking into account
             repulsive particle interaction, mesoscopic phase separation and
             softening of the crystalline lattice. These features are typical
             of many high-temperature superconductors. The main results
             obtained for the model are: (1) phase separation is possible only
             if repulsive forces play a significant role; (2) the critical
             temperature as a function of the superconducting phase fraction
             can have non-monotonic behaviour; (3) superconductivity is
             possible in heterophase systems even when it would be forbidden
             in pure samples. These results are in agreement with experiments.},
  keywords = {Mesoscopic systems; Superconducting energy gap; Superconducting
             transition temperature; Superconductivity; N/a superconductivity
             model; Mesoscopic phase separation; Repulsive particle
             interaction; Critical temperature; Superconducting phase
             fraction; Nonmonotonic behavior; Heterophase systems;
             Hamiltonians; Gap equation; Interaction potentials},
  language = {English}
}
@ARTICLE{Coleman93,
  author = {A.J. Coleman and V.I. Yukalov},
  month = {Dec. 1993},
  year = 1993,
  title = {Order indices and ordering in macroscopic systems},
  journal = {Nuovo Cimento B},
  volume = {108B},
  number = {ser.2, no.12},
  pages = {1377-97},
  abstract = {In A.J. Coleman and V.I. Yukalov: Mod. Phys. Lett. B, 5, 1679
             (1991) and Nuovo Cimento B, 107, 535 (1992) we introduced order
             indices of reduced density matrices as a tool to connect
             macroscopic and microscopic properties of physical systems. In
             the present paper, we give a definition of order indices which is
             independent of the representation of the density matrices and is
             valid for both fermion and boson systems and for all types of
             order: short, mid and long range. Time-dependent indices are
             introduced to permit discussion of non-equilibrium processes.
             Special attention is devoted to the study of mid-range order and
             the corresponding stability conditions. Mid-range order is
             examined both in a system at rest and in a system with
             two-velocity motion.},
  keywords = {Quantum statistical mechanics; Macroscopic systems; Ordering;
             Order indices; Reduced density matrices; Microscopic properties;
             Boson systems; Fermion systems; Time-dependent indices;
             Nonequilibrium processes; Mid-range order; Stability conditions;
             Two-velocity motion},
  language = {English}
}
@ARTICLE{Coleman92,
