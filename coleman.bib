  month = {May 1992},
  year = 1992,
  title = {Order indices for boson density matrices},
  journal = {Nuovo Cimento B},
  volume = {107B},
  number = {ser.2, no.5},
  pages = {535-52},
  abstract = {The authors study low-temperature properties of boson density
             matrices when macroscopic occupation of quantum energy levels can
             occur. An important novelty of their approach is the definition
             of order indices that characterize the behaviour of largest
             eigenvalues of density matrices in the thermodynamic limit.
             Continuous variation of the order indices gives rise to a whole
