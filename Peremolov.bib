@article{Morozov90,
	author = {A.Yu. Morozov and A.M. Perelomov and A.A. Rosly and M.A. Shifman and A.V. Turbiner},
	title = {Quasi-exactly-solvable quantal problems: one-dimensional analogue of rational conformal field theories},
