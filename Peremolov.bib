	year = {1969},
	issn = {0038-5646},
	keywords = {Quantum optics; Quantum theory applications; },
	language = {Russian},
	abstract = {An exact solution is obtained for the problem of a quantum oscillator with a time dependent frequency omega (t) varying in an arbitrary manner. The quantum transition probabilities w/sub mn/ between the discrete spectrum states which are stationary for t to +or- infinity are calculated. The variation of the adiabatic invariant I=E/ omega under the action of a variable frequency omega (t) is calculated for an arbitrary initial state.}
}

@article{Perelomov93,
