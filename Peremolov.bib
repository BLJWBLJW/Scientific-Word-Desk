}

@article{Belavin69,
	author = {A.A. Belavin and B.Ya. Zel'dovich and A.M. Perelomov and V.S. Popov},
	title = {Relaxation of quantum systems with equidistant spectra},
	journal = {Soviet Physics - JETP},
	volume = {56},
	number = {1},
	pages = {264-74},
	year = {1969},
	issn = {0038-5646},
	keywords = {Quantum theory; Relaxation; },
	language = {Russian},
	abstract = {The structure of a kinetic equation which describes the relaxation of quantum systems with equidistant spectra is discussed. Examples of such systems are harmonic oscillators (with linear or nonlinear damping), a spin in a magnetic field, an ensemble of two-level atoms interacting with a radiation field (Dicke problem). It is demonstrated that equations of this type retain positive determinacy of the density matrix. A solution of the kinetic equation is obtained for the Dicke problem and an exact quantum expression is found for the shape of the radiation line. Interference line narrowing due to the equidistant nature of the spectrum is discussed.}
}

@article{Degasperis92,
	author = {A. Degasperis and D. Lebedev and M. Olshanetsky and S. Pakuliak and A. Perelomov and P.M. Santini},
	title = {Generalized intermediate long-wave hierarchy in zero-curvature representation with noncommutative spectral parameter},
	journal = {Journal of Mathematical Physics},
	volume = {33},
	number = {11},
	pages = {3783-93},
	month = {Nov. 1992},
	year = {1992},
	keywords = {Integro-differential equations; Wave equations; Intermediate long-wave hierarchy; Zakharov-Shabat dressing method; Zero-curvature representation; Drinfeld-Sokolov formalism; Operator-valued spectral parameter; Space variable; Saveliev-Vershik continuum graded Lie algebras; Fairlie-Zachos sinh-algebra},
	language = {English},
	abstract = {The simplest generalization of the intermediate long-wave hierarchy (ILW) is considered to show how to extend the Zakharov-Shabat dressing method (1974) to nonlocal, i.e. integro-partial differential, equations. The purpose is to give a procedure of constructing the zero-curvature representation of this class of equations. This result obtains by combining the Drinfeld-Sokolov formalism (1984) together with the introduction of an operator-valued spectral parameter, namely a spectral parameters that does not commute with the space variable x. This extension provides a connection between the ILW/sub k/ hierarchy and the Saveliev-Vershik continuum graded Lie algebras (1990). In the case of ILW/sub 2/ the Fairlie-Zachos sinh-algebra (1989) was found.}
}

