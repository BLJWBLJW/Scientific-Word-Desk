	title = {Explicit solution of the quantum three-body Calogero-Sutherland model},
	journal = {Journal of Physics A [Mathematical and General]},
	volume = {31},
	number = {32},
	pages = {L559-65},
	publisher = {IOP Publishing},
	month = {14 Aug. 1998},
	year = {1998},
	keywords = {Clebsch-Gordan coefficients; Many-body problems; Quantum theory; Wave functions; Quantum three-body Calogero-Sutherland model; Quantum integrable systems; Root systems; Kappa -deformation; Clebsch-Gordan series; Recursion relations; Generalized zonal spherical functions; Jack polynomials},
	language = {English},
	abstract = {The class of quantum integrable systems associated with root systems was introduced by Olshanetsky and Perelomov as a generalization of the Calogero-Sutherland systems. It was recently shown by one of the authors that for such systems with a potential v(q)= kappa ( kappa -1) sin/sup -2/ q, the series in the product of two wavefunctions is the kappa -deformation of the Clebsch-Gordan series. This yields recursion relations for the wavefunctions of those systems and, related to them, for generalized zonal spherical functions on symmetric spaces. In this letter this approach is used to compute the explicit expressions for the three-body Calogero-Sutherland wavefunctions, which are the Jack polynomials. We conjecture that similar results are also valid for the more general two-parameters deformation ((q,r)-deformation) introduced by Macdonald.}
}

