\begin{example}
The exterior product defined in terms of the tensor product
\begin{gather}
v\wedge w=\frac{1}{2}\left(  v\otimes w-w\otimes v\right)  =\left(
v_{1}\left\vert \varphi_{1}\right\rangle +v_{2}\left\vert \varphi
_{2}\right\rangle \right)  \wedge\left(  w_{1}\left\vert \varphi
_{1}\right\rangle +w_{2}\left\vert \varphi_{2}\right\rangle \right) \\
=\frac{1}{2}\left(  \left(  \overset{}{\left(  v_{1}\left\vert \varphi
_{1}\right\rangle +v_{2}\left\vert \varphi_{2}\right\rangle \right)
\otimes\left(  w_{1}\left\vert \varphi_{1}\right\rangle +w_{2}\left\vert
\varphi_{2}\right\rangle \right)  }\right)  -\,\left(  \overset{}{\left(
w_{1}\left\vert \varphi_{1}\right\rangle +w_{2}\left\vert \varphi
_{2}\right\rangle \right)  \otimes\left(  v_{1}\left\vert \varphi
_{1}\right\rangle +v_{2}\left\vert \varphi_{2}\right\rangle \right)  }\right)
\right) \\
=\frac{1}{2}\left(  \overset{}{v_{1}w_{1}\left\vert \varphi_{1}\right\rangle
\otimes\left\vert \varphi_{1}\right\rangle +v_{1}w_{2}\left\vert \varphi
_{1}\right\rangle \otimes\left\vert \varphi_{2}\right\rangle +v_{2}%
w_{1}\left\vert \varphi_{2}\right\rangle \otimes\left\vert \varphi
_{1}\right\rangle +v_{2}w_{2}\left\vert \varphi_{2}\right\rangle
\otimes\left\vert \varphi_{2}\right\rangle }\right. \\
\left.  -\left(  \overset{}{w_{1}v_{1}\left\vert \varphi_{1}\right\rangle
\otimes\left\vert \varphi_{1}\right\rangle +w_{1}v_{2}\left\vert \varphi
_{2}\right\rangle \otimes\left\vert \varphi_{1}\right\rangle +w_{2}%
v_{1}\left\vert \varphi_{1}\right\rangle \otimes\left\vert \varphi
_{2}\right\rangle +w_{2}v_{2}\left\vert \varphi_{2}\right\rangle
\otimes\left\vert \varphi_{2}\right\rangle }\right)  \right) \\
=\frac{1}{2}\left(  v_{1}w_{2}\left\vert \varphi_{1}\right\rangle
\otimes\left\vert \varphi_{2}\right\rangle +v_{2}w_{1}\left\vert \varphi
_{2}\right\rangle \otimes\left\vert \varphi_{1}\right\rangle -w_{1}%
v_{2}\left\vert \varphi_{2}\right\rangle \otimes\left\vert \varphi
_{1}\right\rangle -w_{2}v_{1}\left\vert \varphi_{1}\right\rangle
\otimes\left\vert \varphi_{2}\right\rangle \right) \\
=\frac{1}{2}\left(  \left(  v_{1}w_{2}-w_{2}v_{1}\right)  \left\vert
\varphi_{1}\right\rangle \otimes\left\vert \varphi_{2}\right\rangle +\left(
v_{2}w_{1}-w_{1}v_{2}\right)  \left\vert \varphi_{2}\right\rangle
\otimes\left\vert \varphi_{1}\right\rangle \right) \\
=\frac{1}{2}\left(  \left(  v_{1}w_{2}-w_{2}v_{1}\right)  \left\vert
\varphi_{1}\right\rangle \otimes\left\vert \varphi_{2}\right\rangle -\left(
w_{1}v_{2}-v_{2}w_{1}\right)  \left\vert \varphi_{2}\right\rangle
\otimes\left\vert \varphi_{1}\right\rangle \right) \\
=\left(  v_{1}w_{2}-w_{2}v_{1}\right)  \frac{1}{2}\left(
\overset{}{\left\vert \varphi_{1}\right\rangle \otimes\left\vert \varphi
_{2}\right\rangle -\left\vert \varphi_{2}\right\rangle \otimes\left\vert
\varphi_{1}\right\rangle }\right)
\end{gather}
hence in $\mathbb{C}^{2}$%
\begin{equation}
\left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  \wedge\left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  =\frac{1}{2}\left(  \left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  -\left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  \right)  =v_{1}w_{2}-w_{2}v_{1}.
\end{equation}

\end{example}

\item Direct sum of $\mathcal{H}^{1}$ and $\mathcal{H}^{1d}$
\begin{gather}
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}=\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left(  \left\vert \varphi_{1}\right\rangle
\oplus\left\vert \varphi_{1}^{d}\right\rangle \right)  ,\left(  \left\vert
\varphi_{1}\right\rangle \oplus\left\vert \varphi_{2}^{d}\right\rangle
\right)  ,\left(  \left\vert \varphi_{2}\right\rangle \oplus\left\vert
\varphi_{1}^{d}\right\rangle \right)  ,\left(  \left\vert \varphi
_{2}\right\rangle \oplus\left\vert \varphi_{2}^{d}\right\rangle \right)
\right\} \\
\cong\left\{  \left(
\begin{array}
[c]{cccc}%
v_{1} & v_{2} & w_{1}^{d} & w_{2}^{d}%
\end{array}
\right)  \right\}  \in\mathbb{C}^{4}.
\end{gather}


\item The direct sum of two vectors is defined by
\begin{equation}
\left\vert \varphi_{j}\right\rangle \oplus\left\vert \varphi_{k}%
^{d}\right\rangle =\left(  \left\vert \varphi_{j}^{{}}\right\rangle
,\left\vert \varphi_{k}^{d}\right\rangle \right)  =\left(  \left\vert
\varphi_{j}^{{}}\right\rangle ,0\right)  +\left(  0,\left\vert \varphi_{k}%
^{d}\right\rangle \right)  ;\,1\leq j,k\leq2.
\end{equation}


\item Second order exterior product of $\mathcal{H}^{1}$ and $\mathcal{H}%
^{1d}$
\begin{align}%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
