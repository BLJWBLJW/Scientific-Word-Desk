%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right]  \left(  1\times2\right)
\oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \otimes%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right]  \left(  1\times1\right)
\end{gather}
hence%
\begin{equation}
\dim\left\{
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right\}  =1+2+2+1+4+2+1+2+1=16
\end{equation}
i.e.
\begin{equation}
\dim\left\{
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \otimes%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right\}  =\dim\left\{
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \right\}  \times\dim\left\{
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right\}  =4\times4=16
\end{equation}

\end{remark}

\item The tensor product with $\mathbb{C}$ is the same as normal
multiplication in complex vector spaces i.e.
\begin{equation}
\mathbb{C}\otimes\mathcal{H}^{1d}\ =\left\{  z\otimes\left\langle v\right\vert
\right\}  =\left\{  \left(  z,\left\langle v\right\vert \right)  \right\}
=\left\{  z\left\langle v\right\vert \right\}  =\mathcal{H}^{1d}.
\end{equation}


\item The polynomial expansion of a sum is given by
\begin{equation}
\left(  a+b\right)  ^{3}=\left(  a+b\right)  ^{2}\left(  a+b\right)  =\left(
a^{2}+ab+ba+b^{2}\right)  \left(  a+b\right)  =a^{3}+aba+ba^{2}+b^{2}%
a+a^{2}b+ab^{2}+bab+b^{3}.
\end{equation}


\item Zero order exterior products of the direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$ is
\begin{equation}
{\huge \wedge}^{0}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
=\mathbb{C}.
\end{equation}


\item First order exterior products of the direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$ is
\begin{align}
{\huge \wedge}^{1}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
=\mathcal{H}^{1}\oplus\mathcal{H}^{1d}=\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \left(  \left\vert \varphi_{j}^{{}%
}\right\rangle ,0\right)  ,\left(  0,\left\vert \varphi_{j}^{d}\right\rangle
\right)  \right\vert 1\leq j\leq2\right\} \\
&  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j}^{{}}\right\rangle ,\left\vert \varphi_{j}^{d}\right\rangle
\right\vert 1\leq j\leq2\right\}  .
\end{align}


\begin{remark}%
\begin{equation}
\dim\left\{  {\huge \wedge}^{1}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \right\}  =\binom{4}{1}=4
\end{equation}

\end{remark}

\item Second order exterior product of the direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$ is
\begin{gather}
{\huge \wedge}^{2}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
=\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \wedge\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right) \\
=\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}\right)  \right]
\oplus\left[  \left(  \mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)
\oplus\left(  \mathcal{H}^{1d}\wedge\mathcal{H}^{1}\right)  \right]
\oplus\left[  {\huge \wedge}^{2}\mathcal{H}^{1d}\right] \\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\right\rangle ,\left\vert \varphi_{1}%
^{d}\varphi_{2}^{d}\right\rangle \right\}  ,\left\{  \left.  \left\vert
\varphi_{j}^{{}}\varphi_{k}^{d}\right\rangle ,\left\vert \varphi_{j}%
^{d}\varphi_{k}^{{}}\right\rangle \right\vert 1\leq j,k\leq2\right\}
\right\}  .
\end{gather}


\begin{remark}%
\begin{equation}
\dim\left\{  {\huge \wedge}^{2}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \right\}  =\binom{4}{2}=6
\end{equation}
and equals the dimension of the expanded direct sum
\begin{equation}
{\huge \wedge}^{2}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\left(  6\right)  =\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}\right)
\right]  \left(  1\right)  \oplus\left[  \left(  \mathcal{H}^{1}%
\wedge\mathcal{H}^{1d}\right)  \left(  2\right)  \oplus\left(  \mathcal{H}%
^{1d}\wedge\mathcal{H}^{1}\right)  \right]  \left(  2\right)  \oplus\left[
{\huge \wedge}^{2}\mathcal{H}^{1d}\right]  \left(  1\right)  .
\end{equation}

\end{remark}

\item The definition of exterior product in terms of normal tensor product is
defined by
\begin{align}
{\huge \wedge}^{2}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
=\mathcal{A}_{2}\left[  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right]
\otimes\left[  \left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \right]
\\
&  =\mathcal{A}_{2}\left(  \left[  \mathcal{H}^{1}\otimes\mathcal{H}%
^{1}\right]  \oplus\left[  \mathcal{H}^{1}\otimes\mathcal{H}^{1d}\right]
\oplus\left[  \mathcal{H}^{1}\otimes\mathcal{H}^{1d}\right]  \oplus\left[
\mathcal{H}^{1d}\otimes\mathcal{H}^{1d}\right]  \right) \\
&  =\mathcal{A}_{2}\left(  \left[  \mathcal{H}^{2\otimes}\right]
\oplus\left[  \mathcal{H}^{1}\otimes\mathcal{H}^{1d}\right]  \oplus\left[
\mathcal{H}^{1d}\otimes\mathcal{H}^{1}\right]  \oplus\left[  \mathcal{H}%
^{2d\otimes}\right]  \right)  .
\end{align}


\item Third order exterior product of the direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$ is
\begin{gather}
{\huge \wedge}^{3}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =\\
{\huge \wedge}^{3}\mathcal{H}^{1}\oplus\mathcal{H}^{1}\wedge\mathcal{H}%
^{1d}\wedge\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\wedge{\huge \wedge}%
^{2}\mathcal{H}^{1}\oplus{\huge \wedge}^{2}\mathcal{H}^{1d}\wedge
\mathcal{H}^{1}\\
\oplus{\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\oplus
\mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\oplus\mathcal{H}%
^{1d}\wedge\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\oplus{\huge \wedge}%
^{3}\mathcal{H}^{1d}\\
={\huge \wedge}^{3}\mathcal{H}^{1}\oplus{\huge \wedge}^{2}\mathcal{H}%
^{1}\wedge\mathcal{H}^{1d}\ \oplus{\huge \wedge}^{2}\mathcal{H}^{1}%
\wedge\mathcal{H}^{1d}\oplus\mathcal{H}^{1}\wedge{\huge \wedge}^{2}%
\mathcal{H}^{1d}\oplus{\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}%
^{1d}\\
+\mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\oplus\mathcal{H}%
^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\oplus{\huge \wedge}%
^{3}\mathcal{H}^{1d}\\
=\left(  {\huge \wedge}^{3}\mathcal{H}^{1}\right)  \oplus\left(
{\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)  \ \oplus
\left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)
\oplus\left(  \mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)
\oplus\left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)
\\
\oplus\left(  \mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)
\oplus\left(  \mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)
\oplus\left(  {\huge \wedge}^{3}\mathcal{H}^{1d}\right)
\end{gather}
giving
\begin{gather}
{\huge \wedge}^{3}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
=\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}%
^{1d}\right)  \ \oplus\left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge
\mathcal{H}^{1d}\right)  \right] \\
\oplus\left[  \left(  \mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}%
^{1d}\right)  \oplus\left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge
\mathcal{H}^{1d}\right)  \right]  \oplus\left[  \left(  \mathcal{H}^{1}%
\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)  \oplus\left(  \mathcal{H}%
^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)  \right]  .
\end{gather}


\begin{remark}%
\begin{equation}
{\huge \wedge}^{3}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{j}^{d}\right\rangle ,\left\vert
\varphi_{j}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\vert 1\leq
j\leq2\right\}  =\left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge
\mathcal{H}^{1d}\right)  \ \oplus\left(  {\huge \wedge}^{2}\mathcal{H}%
^{1}\wedge\mathcal{H}^{1d}\right)  .
\end{equation}
The dimension of ${\huge \wedge}^{3}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)  $ of
\begin{equation}
\dim\left\{  {\huge \wedge}^{3}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \right\}  =\binom{4}{3}=4,
\end{equation}
which corresponds to%
\begin{equation}
{\huge \wedge}^{3}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\left(  4\right)  =\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}%
\wedge\mathcal{H}^{1d}\right)  \left(  2\right)  \ \oplus\left(
{\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)  \left(
2\right)  \right]  .
\end{equation}

\end{remark}

\item Fourth order exterior product of the direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$ is%
\[
{\huge \wedge}^{4}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert \varphi_{1}^{{}%
}\varphi_{2}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\}  .
\]


\begin{remark}%
