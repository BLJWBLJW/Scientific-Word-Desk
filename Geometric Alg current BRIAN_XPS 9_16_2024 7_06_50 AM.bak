}\widetilde{a}_{j_{n}}^{\dagger}\cdots\widetilde{a}_{j_{1}}^{\dagger}\right\}
&  =0;1\leq j_{1}<\cdots<j_{n}\leq2r\neq1\leq k_{1}<\cdots<k_{m}\leq2r\\
\operatorname*{tr}\left\{  \widetilde{a}_{j_{n}}^{\dagger}\cdots
\widetilde{a}_{j_{1}}^{\dagger}\right\}   &  =0;1\leq j_{1}<\cdots<j_{n}\leq2r
\end{align}%
\begin{equation}
\operatorname*{tr}\left\{  \widetilde{a}_{l}\widetilde{a}_{j}\widetilde{a}%
_{j}^{\dagger}\widetilde{a}_{k}^{\dagger}\right\}  =\operatorname*{tr}\left\{
\widetilde{a}_{l}\widetilde{a}_{k}^{\dagger}\widetilde{a}_{j}\widetilde{a}%
_{j}^{\dagger}\right\}  =0
\end{equation}
Thus $\Pi_{\operatorname*{tr}}\left(  \widetilde{a}_{k}^{\dagger}\right)  $
has the usual properties of the creation operator on the basis $\left\{
\left.  \left\vert \Phi_{\operatorname*{tr}}\left(  I_{\mathcal{F}}\right)
\right\rangle ,\left\vert \Phi_{\operatorname*{tr}}\left(  \widetilde{a}%
_{l_{1}}^{\dagger}\cdots\widetilde{a}_{l_{m}}^{\dagger}\right)  \right\rangle
\right\vert 1\leq l_{1}<\cdots<l_{m}\leq2r\right\}  $ and the above expansion
is an example of the quantization map. This also shows that the mixed state
$\operatorname*{tr}$, which is tracial, is gauge invariant \emph{for any
gauge} i.e. for any basis.

The traces of the idempotents are then given by
\begin{align}
\operatorname{Tr}\left\{  A_{+}\right\}   &  =\operatorname{Tr}\left\{
\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  \right\}  =\frac{r}{2}+\frac
{1}{2}\operatorname{Tr}\left\{  A\right\} \\
\operatorname{Tr}\left\{  A_{-}\right\}   &  =\operatorname{Tr}\left\{
\frac{1}{2}\left(  I_{\mathcal{F}}-A\right)  \right\}  =\frac{r}{2}-\frac
{1}{2}\operatorname{Tr}\left\{  A\right\}  ,
\end{align}
which gives
\begin{align}
\operatorname{Tr}\left\{  A_{+}\right\}   &  \in\frac{r}{2}+\left\{
\begin{array}
[c]{c}%
+\frac{1}{2}r\\
\vdots\\
-\frac{1}{2}r
\end{array}
\right. \\
\operatorname{Tr}\left\{  A_{-}\right\}   &  \in\frac{r}{2}+\left\{
\begin{array}
[c]{c}%
-\frac{1}{2}r\\
\vdots\\
+\frac{1}{2}r
\end{array}
\right.
\end{align}
and corresponds to the dimension of the projector.

$\lceil$The projectors are orthogonal to each other%
\begin{align}
\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}+A\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}+2A+I_{\mathcal{F}}\right)
=\frac{1}{2}\left(  I_{\mathcal{F}}+A\right) \\
\frac{1}{2}\left(  I_{\mathcal{F}}-A\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-A\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}-2A+I_{\mathcal{F}}\right)
=\frac{1}{2}\left(  I_{\mathcal{F}}-A\right) \\
\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-A\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}-I_{\mathcal{F}}\right)
=0.
\end{align}
$\rfloor$

$\lceil$%
\begin{align}
f\left(  A_{+}\right)   &  =f\left(  \frac{1}{2}\left(  I_{\mathcal{F}%
}+A\right)  \right)  =\frac{1}{2}\left(  1+f\left(  A\right)  \right)
=\frac{1}{2}+\frac{1}{2}f\left(  A\right) \\
f\left(  A\right)  _{-}  &  =f\left(  \frac{1}{2}\left(  I_{\mathcal{F}%
}-A\right)  \right)  =\frac{1}{2}\left(  1-f\left(  A\right)  \right)
=\frac{1}{2}-\frac{1}{2}f\left(  A\right)
\end{align}
giving for states $f$
\begin{equation}
0\leq f\left(  A_{+}\right)  \leq1\Leftrightarrow0\leq\frac{1}{2}\left(
1+f\left(  A\right)  \right)  \leq1\Leftrightarrow0\leq\left(  1+f\left(
A\right)  \right)  \leq2\Leftrightarrow-1\leq f\left(  A\right)  \leq2
\end{equation}
and%
\begin{equation}
0\leq f\left(  A_{-}\right)  \leq1\Leftrightarrow0\leq\frac{1}{2}\left(
1-f\left(  A\right)  \right)  \leq1\Leftrightarrow0\leq\left(  1-f\left(
A\right)  \right)  \leq2\Leftrightarrow-1\leq-f\left(  A\right)
\leq2\Leftrightarrow-2\leq f\left(  A\right)  \leq1
\end{equation}
resulting in
\begin{equation}
-1\leq f\left(  A\right)  \leq1.
\end{equation}
$\rfloor$

The idempotents $\left\{  A_{+},A_{-}\right\}  $ are not self adjoint unless
the involution $A$ is. If $A$ is a self adjoint involution then
\begin{equation}
A=\int_{\alpha\in\sigma\left(  A\right)  }\alpha dP_{A}\left(  \alpha\right)
,
\end{equation}
where
\begin{equation}
\alpha^{2}=1,\alpha\in\mathbb{R\Rightarrow\,}\alpha=\pm1.
\end{equation}
The spectrum can also contain $\alpha=0.$

$\lceil$Projectors are only compact if their ranges are finite dimensional.
However non compact operators can have a discrete spectra$\rfloor$

The inverse relationship is
\begin{equation}
A=2A_{+}-I_{\mathcal{F}}=2A_{-}+I_{\mathcal{F}}.
\end{equation}
$\lceil$For example%
\begin{align}
A  &  =2n-I_{\mathcal{F}}\\
\left(  2n-I_{\mathcal{F}}\right)  ^{2}  &  =4n-4n+I_{\mathcal{F}%
}=I_{\mathcal{F}}%
\end{align}%
\begin{align}
A_{+}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+2n-I_{\mathcal{F}}\right)  =n\\
A_{-}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}-2n+I_{\mathcal{F}}\right)
=I_{\mathcal{F}}-n=h\\
A_{+}A_{-}  &  =nh=a^{\dagger}aaa^{\dagger}=0
\end{align}
$\rfloor$

It is interesting to observe that
\begin{align}
\frac{1}{2}\left(  I_{\mathcal{F}}\pm A\right)  A  &  =\frac{1}{2}\left(
I_{\mathcal{F}}\pm A\right) \\
\left[  \frac{1}{2}\left(  I_{\mathcal{F}}\pm A\right)  ,A\right]   &  =0.
\end{align}


If
\begin{equation}
A=A^{\dagger}%
\end{equation}
then the idempotents are self adjoint.

\begin{theorem}
There is a $2-1$ relationship between idempotents and involutions in
$\mathcal{F}.$
\end{theorem}

Projectors of order $n$ are of the form
\begin{equation}
P_{nA}=\frac{1}{2}\left(  I_{\mathcal{F}}\pm A\right)  ,A=A^{\dagger},
\end{equation}
where $A$ is an involution of the form
\begin{equation}
A=\sum_{0\leq m\leq n}\left\langle A\right\rangle _{m}%
\end{equation}
so that
\begin{equation}
A^{2}=\sum_{0\leq m\leq2n}\left\langle A^{2}\right\rangle _{m}=I_{\mathcal{F}%
},
\end{equation}
i.e.%
\begin{align}
\left\langle A^{2}\right\rangle _{0}  &  =I_{\mathcal{F}}\\
\left\langle A^{2}\right\rangle _{m}  &  =0,1\leq m\leq2n.
\end{align}


\paragraph{First order projectors}

Let $\left\{  \left.  y_{j}\right\vert 1\leq j\leq2r\right\}  $ be any self
adjoint orthonormal basis of $\mathcal{F}_{1}$ that generates the basis
$\left\{  I_{\mathcal{F}},\left\{  \left.  y_{j_{1}}\cdots y_{j_{p}%
}\right\vert 1\leq j_{1}<\cdots<j_{p}\leq2r;1\leq p\leq2r\right\}  \right\}  $
of $\mathcal{F}.$ Then one can form the first order (non homogeneous) self
adjoint idempotents that are partially mutually orthogonal and complimentary
\begin{align}
&  p_{+j_{1}}^{2}=\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}+2y_{j_{1}}+y_{j_{1}}^{2}\right)  =\frac{1}{4}\left(
2I_{\mathcal{F}}+2y_{j_{1}}\right)  =\frac{1}{2}\left(  I_{\mathcal{F}%
}+y_{j_{1}}\right)  =p_{+j_{1}}\\
&  p_{-j_{1}}^{2}=\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}-2y_{j_{1}}+y_{j_{1}}^{2}\right)  =\frac{1}{4}\left(
2I_{\mathcal{F}}-2y_{j_{1}}\right)  =\frac{1}{2}\left(  I_{\mathcal{F}%
}-y_{j_{1}}\right)  =p_{-j_{1}}\\
&  p_{+j_{1}}p_{-j_{1}}=\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}-y_{j_{1}}^{2}\right)  =0\\
&  p_{-j_{1}}+p_{+j_{1}}=\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
+\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)  =I_{\mathcal{F}}%
\end{align}
and non commutative
\begin{align}
p_{+j_{1}}p_{+j_{2}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{2}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}+y_{j_{1}}+y_{j_{2}}+y_{j_{1}}y_{j_{2}}\right)  \neq p_{+j_{2}%
}p_{+j_{1}}\\
p_{+j_{2}}p_{+j_{1}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{2}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}+y_{j_{1}}+y_{j_{2}}-y_{j_{1}}y_{j_{2}}\right)  \neq p_{+j_{1}%
}p_{+j_{2}}.
\end{align}
In particular
\begin{equation}
\left(  \sqrt{2}x_{j}\right)  ^{2}=2\frac{1}{2}I_{\mathcal{F}}=I_{\mathcal{F}}%
\end{equation}
leading to the self adjoint projectors%
\begin{equation}
p_{\pm x_{j}}=\frac{1}{2}\left(  I_{\mathcal{F}}\pm\sqrt{2}x_{j}\right)  .
\end{equation}


In general one can construct self adjoint projectors from any normalized self
adjoint vectors (as they are involutions)
\begin{equation}
p_{\pm v}=\frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right)  ,
\end{equation}
where%
\begin{equation}
v=\sum_{1\leq j\leq2r}v_{j}x_{j};v_{j}\in\mathbb{R},1\leq j\leq2r.
\end{equation}
$\lceil$%
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}+\sqrt{2}x_{j}\right)  \frac{1}{2}\left(
I_{\mathcal{F}}-\sqrt{2}x_{j+r}\right)  =\frac{1}{4}\left(  I_{\mathcal{F}%
}+\sqrt{2}x_{j}-\sqrt{2}x_{j+r}-2x_{j}x_{j+r}\right)
\end{equation}%
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right)  v=\frac{1}{2}\left(  v\pm
I_{\mathcal{F}}\right)
\end{equation}
$\rfloor$

This is of course true for any normalized self adjoint blade of any order.

\paragraph{Second order projectors\label{Second order projectors}}

The $\left\{  n_{j}\right\}  $ and $\left\{  h_{j}\right\}  $ are pairs of
projectors that satisfy the preceeding, where $A_{j}=$ $2ix_{j}x_{j+r}$%

\begin{equation}
p_{\pm x_{j}x_{j+r}}=\frac{1}{2}\left(  I_{\mathcal{F}}\pm A_{j}\right)
=\frac{1}{2}\left(  I_{\mathcal{F}}\pm2ix_{j}x_{j+r}\right)  =\frac{1}%
{2}I_{\mathcal{F}}\pm ix_{j}x_{j+r}.
\end{equation}
In general for normalized self adjoint bivectors $g$ of the form
\begin{equation}
g=i\sum_{1\leq j\leq r}c_{j}x_{j}x_{j+r};c_{j}>0,1\leq j<k\leq r
\end{equation}
$g$ is not in general an involution as
\begin{equation}
g^{2}=\sum_{1\leq j,k\leq r}c_{j}c_{k}x_{j}x_{j+r}x_{k}x_{k+r}=\sum_{1\leq
j\leq r}c_{j}^{2}I_{\mathcal{F}}-2\sum_{1\leq j<k\leq r}c_{j}c_{k}x_{j}%
x_{j+r}x_{k}x_{k+r}\neq I_{\mathcal{F}},
\end{equation}
as $\sum_{1\leq j<k\leq r}c_{j}c_{k}x_{j}x_{j+r}x_{k}x_{k+r}$ is not zero
i.e.
\begin{equation}
\sum_{1\leq j<k\leq r}c_{j}c_{k}x_{j}x_{j+r}x_{k}x_{k+r}\neq0
\end{equation}
unless
\begin{equation}
c_{j}c_{k}=0;1\leq j<k\leq r,
\end{equation}
which implies all but one of the $\left\{  c_{j}\right\}  ^{\prime}s$ is non zero.

\subparagraph{Bivectors}

The most general complex bivector is given by%

\begin{equation}
g=\sum_{1\leq j<k\leq r}g_{jk}x_{j}x_{k};\,g_{jk}=-g_{jk}\in\mathbb{C}.
\end{equation}
If $g$ is self adjoint then
\begin{align}
g  &  =g^{\dagger}=-\sum_{1\leq j<k\leq r}\overline{g}_{jk}x_{j}x_{k}\\
&  \Rightarrow g_{jk}=-\overline{g}_{jk}%
\end{align}
$\lceil$%
\begin{equation}
x+iy=-\left(  x-iy\right)  =-x+iy\Rightarrow x=0
\end{equation}
$\rfloor$

thus $g$ is a purely imaginary bivector i.e.
\begin{equation}
g=ig_{r},\,g_{r}^{t}=-g_{r}%
\end{equation}
and the analysis given in preceeding for self adjoint bivectors applies. Hence
any, self adjoint bivector can be expressed in canonical form as
\begin{equation}
g=i\sum_{1\leq j\leq r}c_{j}y_{j}y_{j+r};\,c_{j}\in\mathbb{R}_{+},y_{j}%
=y_{j}^{\dagger},1\leq j\leq2r.
\end{equation}
$\lceil$%
\begin{align}
g  &  =\sum_{1\leq j\leq r}c_{j}a_{j}^{\dagger}a_{j+s}^{\dagger}=\frac{1}%
{2}\sum_{1\leq j\leq s}c_{j}\left(  x_{j}-ix_{j+r}\right)  \left(
x_{j+s}-ix_{j+s+r}\right)  \ \\
&  =\frac{1}{2}\sum_{1\leq j\leq s}c_{j}\left(  x_{j}x_{j+s}-ix_{j}%
x_{j+s+r}-ix_{j+r}x_{j+s}-x_{j+r}x_{j+s+r}\right) \\
&  =\frac{1}{2}\sum_{1\leq j\leq s}c_{j}\left(  x_{j}x_{j+s}-x_{j+r}%
x_{j+s+r}-i\left(  x_{j}x_{j+s+r}+x_{j+r}x_{j+s}\right)  \right)
\end{align}
$\rfloor$

$\lceil$ Using normalized basis elements

\begin{enumerate}
\item
\begin{align}
g^{2}  &  =\sum_{1\leq j,k\leq r}c_{j}c_{k}y_{j}y_{j+r}y_{k}y_{k+r}%
=\sum_{1\leq j<k\leq r}c_{j}c_{k}y_{j}y_{j+r}y_{j}y_{j+r}+2\sum_{1\leq j<k\leq
r}c_{j}c_{k}y_{j}y_{j+r}y_{k}y_{k+r}\\
&  =\sum_{1\leq j\leq r}c_{j}^{2}I_{\mathcal{F}}+2\sum_{1\leq j<k\leq r}%
c_{j}c_{k}y_{j}y_{j+r}y_{k}y_{k+r}\neq g
\end{align}


\item
\begin{align}
g^{2}  &  =I_{\mathcal{F}}\Rightarrow\sum_{1\leq j\leq r}c_{j}^{2}%
=1\,\&\,\sum_{1\leq j<k\leq r}c_{j}c_{k}y_{j}y_{j+r}y_{k}y_{k+r}=0\\
&  \Rightarrow c_{j}=0,1\leq j\leq r.
\end{align}
$\rfloor$
\end{enumerate}

Grade two homogeneous involutions are thus always self adjoint grade two
blades. Inhomogeneous grade two involutions are of the general form
\begin{equation}
c_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq r}c_{1j}x_{j}+i\sum_{1\leq j\leq
r}c_{2j}x_{j}x_{j+r}.
\end{equation}


\begin{enumerate}
\item If $\mathbf{c}_{2}=0$ and $\mathbf{c}_{1}=0$ then
\begin{equation}
\left(  c_{0}I_{\mathcal{F}}\right)  ^{2}=I_{\mathcal{F}}\Leftrightarrow
c_{0}=\pm1.
\end{equation}


\item If $\mathbf{c}_{2}=0$ and $c_{0}=0$ then
\begin{equation}
\left(  \sum_{1\leq j\leq r}c_{1j}x_{j}\right)  ^{2}=I_{\mathcal{F}%
}\Leftrightarrow\sum_{1\leq j\leq r}c_{1j}^{2}=1.
\end{equation}


\item If $\mathbf{c}_{2}=0$ then
\begin{equation}
\left(  c_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq r}c_{1j}x_{j}\right)
^{2}=c_{0}^{2}I_{\mathcal{F}}+2\sum_{1\leq j\leq r}c_{1j}x_{j}+\sum_{1\leq
j\leq r}c_{1j}^{2}I_{\mathcal{F}}=I_{\mathcal{F}}\Leftrightarrow
c_{1j}=0,1\leq j\leq r.
\end{equation}
where $c_{0}=0,c_{1j}=0,1\leq j\leq r.$
\end{enumerate}

Second order projections\emph{ cannot} be expressed as simple products of
first order ones as
\begin{align}
&  \left(  \frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  \frac{1}{2}\left(
I_{\mathcal{F}}+w\right)  \right)  ^{2}=\left(  \frac{1}{4}\left(
I_{\mathcal{F}}+v+w+vw\right)  \right)  ^{2}\\
&  =\frac{1}{16}\left(  \left(  I_{\mathcal{F}}+v+w+vw\right)  +v\left(
I_{\mathcal{F}}+v+w+vw\right)  +w\left(  I_{\mathcal{F}}+v+w+vw\right)
+vw\left(  I_{\mathcal{F}}+v+w+vw\right)  \right) \\
&  =\frac{1}{16}I\left(  _{\mathcal{F}}+v+w+vw+v+I_{\mathcal{F}}%
+vw+w+w+wv+I_{\mathcal{F}}-v+vw-w+v-I_{\mathcal{F}}\right) \\
&  =\frac{1}{8}\left(  I_{\mathcal{F}}+v+w+vw\right)  =\frac{1}{2}\left(
\frac{1}{4}\left(  I_{\mathcal{F}}+v+w+vw\right)  \right)  \neq\frac{1}%
{4}\left(  I_{\mathcal{F}}+v+w+vw\right)  .
\end{align}
$\lceil$%
\begin{equation}
\sqrt{2}p\sqrt{2}p=2\frac{1}{2}p=p
\end{equation}%
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  \left(  I_{\mathcal{F}}+B\right)
=\frac{1}{2}\left(  I_{\mathcal{F}}+A+B+AB\right)
\end{equation}
$\rfloor$

The only other way second order projectors could be expressed in terms of
first order ones is as
\begin{equation}
\sum\alpha_{j}\frac{1}{2}\left(  I_{\mathcal{F}}+v_{j}\right)  \frac{1}%
{2}\left(  I_{\mathcal{F}}+w_{j}\right)  .
\end{equation}


\subparagraph{Third order projectors}

The projectors
\begin{equation}
p_{\pm v}=\frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right)  ,
\end{equation}
and
\begin{equation}
\frac{1}{2}I_{\mathcal{F}}\pm ix_{j}x_{j+r}%
\end{equation}
clearly commute, thus their products
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}\pm ix_{j}x_{j+r}\right)
\end{equation}
are projectors.

\subparagraph{Fourth order projectors}

The projectors
\begin{equation}
\frac{1}{2}I_{\mathcal{F}}\pm ix_{j}x_{j+r},\frac{1}{2}I_{\mathcal{F}}\pm
ix_{k}x_{k+r}%
\end{equation}
clearly commute, thus their products
\begin{equation}
\left(  \frac{1}{2}I_{\mathcal{F}}\pm ix_{j}x_{j+r}\right)  \left(  \frac
{1}{2}I_{\mathcal{F}}\pm ix_{k}x_{k+r}\right)
\end{equation}
are projectors. But non decomposable projectors also exist and need to be characterized.

\subparagraph{General grade four self adjoint involutions}

General grade four self adjoint involutions that are gauge invariant are of
the form
\begin{align}
A  &  =c_{0}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}%
+\sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{k}x_{l}x_{l}x_{m}=c_{0}I_{\mathcal{F}%
}+\left\langle A\right\rangle _{2}+\left\langle A\right\rangle _{4}\\
&  =A_{0}+A_{2}+A_{4}.
\end{align}
The involution condition gives
\begin{equation}
\left(  c_{0}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}%
+\sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)  ^{2}%
=c_{0}^{2}I_{\mathcal{F}}+\left\langle A\right\rangle _{2}^{2}+\left\langle
A\right\rangle _{4}^{2}+2c_{0}\left(  \left\langle A\right\rangle
_{2}+\left\langle A\right\rangle _{4}\right)  +2\left\langle A\right\rangle
_{2}\left\langle A\right\rangle _{4}=I_{\mathcal{F}}%
\end{equation}
i.e.%
\begin{align}
&  c_{0}^{2}I_{\mathcal{F}}+\left(  i\sum_{1\leq j\leq r}c_{2j}x_{j}%
x_{j+r}\right)  ^{2}+\left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}%
x_{k}x_{l}x_{m}\right)  ^{2}+2c_{0}\left(  i\sum_{1\leq j\leq r}c_{2j}%
x_{j}x_{j+r}+\sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right) \\
&  \left.  +\right.  2\left(  i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}\right)
\left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)
=I_{\mathcal{F}}.
\end{align}
Recall the geometric product square is defined as
\begin{equation}
A^{2}=AA=\sum_{0\leq m,n\leq2r}A_{m}A_{n},
\end{equation}
where
\begin{equation}
A_{m}A_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle A_{m}%
A_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{equation}
In the case of
\begin{equation}
A=A_{0}+A_{2}+A_{4}%
\end{equation}
one obtains
\begin{align}
&  A^{2}=A_{0}A_{0}+A_{0}A_{2}+A_{0}A_{4}+A_{2}A_{0}+A_{2}A_{2}+A_{2}%
A_{4}+A_{4}A_{0}+A_{4}A_{2}+A_{4}A_{4}\\
&  =A_{0}^{2}+A_{2}^{2}+A_{4}^{2}+2\left(  A_{0}A_{2}+A_{0}A_{4}\right)
+2A_{2}A_{4}\\
&  =\left\langle A_{0}^{2}\right\rangle _{0}+\left\langle A_{2}^{2}%
\right\rangle _{0}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{2}+\left\langle A_{2}^{2}\right\rangle _{4}%
+\left\langle A_{4}^{2}\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle
_{8}+2\left\langle A_{0}A_{2}\right\rangle _{2}+2\left\langle A_{0}%
A_{4}\right\rangle _{4}+2\left\langle A_{2}A_{4}\right\rangle _{2}%
+2\left\langle A_{2}A_{4}\right\rangle _{4}+2\left\langle A_{2}A_{4}%
\right\rangle _{6},
\end{align}
where
\begin{align}
A_{2}^{2}  &  =\sum_{j=0}^{2}\left\langle A_{2}^{2}\right\rangle
_{2j}=\left\langle A_{2}^{2}\right\rangle _{0}+\left\langle A_{2}%
^{2}\right\rangle _{2}+\left\langle A_{2}^{2}\right\rangle _{4}\\
A_{4}^{2}  &  =\sum_{j=0}^{4}\left\langle A_{4}^{2}\right\rangle
_{2j}=\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle A_{4}%
^{2}\right\rangle _{2}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{4}^{2}\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{8}\\
A_{2}A_{4}  &  =\sum_{j=0}^{2}\left\langle A_{2}A_{4}\right\rangle
_{2j}=\left\langle A_{2}A_{4}\right\rangle _{0}+\left\langle A_{2}%
A_{4}\right\rangle _{2}+\left\langle A_{2}A_{4}\right\rangle _{4}\\
A_{0}A_{2}  &  =\left\langle A_{0}A_{2}\right\rangle _{2}\\
A_{0}A_{4}  &  =\left\langle A_{0}A_{4}\right\rangle _{4}\\
\left\langle A^{2}\right\rangle _{0}  &  =\left\langle A_{2}^{2}\right\rangle
_{0}+\left\langle A_{4}^{2}\right\rangle _{0}+2\left\langle A_{2}%
A_{4}\right\rangle _{0}\\
\left\langle A^{2}\right\rangle _{2}  &  =\left\langle A_{2}^{2}\right\rangle
_{2}+\left\langle A_{4}^{2}\right\rangle _{2}+2\left\langle A_{2}%
A_{4}\right\rangle _{2}\\
\left\langle A^{2}\right\rangle _{4}  &  =\left\langle A_{2}^{2}\right\rangle
_{4}+\left\langle A_{4}^{2}\right\rangle _{4}+2\left\langle A_{2}%
A_{4}\right\rangle _{4}=A_{2}\wedge A_{2}+\left\langle A_{4}^{2}\right\rangle
_{4}+2\left\langle A_{2}A_{4}\right\rangle _{4}\\
\left\langle A^{2}\right\rangle _{6}  &  =2\left\langle A_{2}A_{4}%
\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{6}\\
\left\langle A^{2}\right\rangle _{8}  &  =\left\langle A_{4}^{2}\right\rangle
_{8}=A_{4}\wedge A_{4}%
\end{align}
The involution condition gives
\begin{equation}
\left\langle A^{2}\right\rangle _{0}=A_{0}^{2}+\left\langle A_{2}%
^{2}\right\rangle _{0}+\left\langle A_{4}^{2}\right\rangle _{0}+2\left\langle
A_{2}A_{4}\right\rangle _{0}%
\end{equation}%
\begin{align}
\left\langle A^{2}\right\rangle _{2}  &  =\left\langle A_{2}^{2}\right\rangle
_{2}+\left\langle A_{4}^{2}\right\rangle _{2}+2\left\langle A_{2}%
A_{4}\right\rangle _{2}=0\\
\left\langle A^{2}\right\rangle _{4}  &  =\left\langle A_{2}^{2}\right\rangle
_{4}+\left\langle A_{4}^{2}\right\rangle _{4}+2\left\langle A_{2}%
A_{4}\right\rangle _{4}=A_{2}\wedge A_{2}+\left\langle A_{4}^{2}\right\rangle
_{4}+2\left\langle A_{2}A_{4}\right\rangle _{4}=0\\
\left\langle A^{2}\right\rangle _{6}  &  =\left\langle A^{2}\right\rangle
_{6}=A_{2}\wedge A_{4}+\left\langle A_{4}^{2}\right\rangle _{6}=0\\
\left\langle A^{2}\right\rangle _{8}  &  =\left\langle A_{4}^{2}\right\rangle
_{8}=A_{4}\wedge A_{4}=0.
\end{align}%
\begin{equation}
\left\langle A^{2}\right\rangle _{0}=c_{0}^{2}I_{\mathcal{F}}+\left\langle
A_{2}^{2}\right\rangle _{0}+\left\langle A_{4}^{2}\right\rangle _{0}%
+2\left\langle A_{2}A_{4}\right\rangle _{0}%
\end{equation}%
\begin{align}
\left\langle A^{2}\right\rangle _{2}  &  =\left\langle A_{2}^{2}\right\rangle
_{2}+\left\langle A_{4}^{2}\right\rangle _{2}+2\left\langle A_{2}%
A_{4}\right\rangle _{2}=0\\
\left\langle A^{2}\right\rangle _{4}  &  =\left\langle A_{2}^{2}\right\rangle
_{4}+\left\langle A_{4}^{2}\right\rangle _{4}+2\left\langle A_{2}%
A_{4}\right\rangle _{4}=A_{2}\wedge A_{2}+\left\langle A_{4}^{2}\right\rangle
_{4}+2\left\langle A_{2}A_{4}\right\rangle _{4}=0\\
\left\langle A^{2}\right\rangle _{6}  &  =2\left\langle A_{2}A_{4}%
\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{6}=A_{2}\wedge
A_{4}+\left\langle A_{4}^{2}\right\rangle _{6}=0\\
\left\langle A^{2}\right\rangle _{8}  &  =\left\langle A_{4}^{2}\right\rangle
_{8}=A_{4}\wedge A_{4}=0.
\end{align}
Expanding into the self adjoint non normalized orthogonal basis gives

\begin{enumerate}
\item
\begin{align}
\left\langle A^{2}\right\rangle _{0}  &  =c_{0}^{2}I_{\mathcal{F}%
}+\left\langle \left(  i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}\right)
^{2}\right\rangle _{0}+\left\langle \left(  \sum_{1\leq j<k<l<m\leq
r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)  ^{2}\right\rangle _{0}=I_{\mathcal{F}%
}\\
&  \equiv\left(  c_{0}^{2}+\frac{1}{2}\sum_{1\leq j\leq r}c_{2j}^{2}+\frac
{1}{4}\sum_{1\leq j<k<l<m\leq r}c_{4jklm}^{2}\right)  I_{\mathcal{F}%
}=I_{\mathcal{F}}\\
&  \Leftrightarrow c_{0}^{2}+\frac{1}{2}\sum_{1\leq j\leq r}c_{2j}^{2}%
+\frac{1}{4}\sum_{1\leq j<k<l<m\leq r}c_{4jklm}^{2}=1
\end{align}


\item
\begin{align}
\left\langle A^{2}\right\rangle _{2}  &  =c_{0}\left\langle i\sum_{1\leq j\leq
r}c_{2j}x_{j}x_{j+r}\right\rangle _{2}+\left\langle \left(  i\sum_{1\leq j\leq
r}c_{2j}x_{j}x_{j+r}\right)  ^{2}\right\rangle _{2}+\left\langle \left(
\sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)  ^{2}%
\right\rangle _{2}\\
&  \left.  +\right.  \left\langle \left(  i\sum_{1\leq j\leq r}c_{2j}%
x_{j}x_{j+r}\right)  \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}%
x_{k}x_{l}x_{m}\right)  \right\rangle _{2}=0\\
&  =c_{0}\left\langle i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}\right\rangle
_{2}+\left\langle \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}%
x_{l}x_{m}\right)  ^{2}\right\rangle _{2}\\
&  \left.  +\right.  \left\langle \left(  i\sum_{1\leq j\leq r}c_{2j}%
x_{j}x_{j+r}\right)  \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}%
x_{k}x_{l}x_{m}\right)  \right\rangle _{2}=0
\end{align}


\item
\begin{align}
\left\langle A^{2}\right\rangle _{4}  &  =c_{0}\left\langle \sum_{1\leq
j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right\rangle _{4}+\left\langle
\left(  i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}\right)  ^{2}\right\rangle
_{4}+\left\langle \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}%
x_{l}x_{m}\right)  ^{2}\right\rangle _{4}\\
&  \left.  +\right.  \left\langle \left(  i\sum_{1\leq j\leq r}c_{2j}%
x_{j}x_{j+r}\right)  \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}%
x_{k}x_{l}x_{m}\right)  \right\rangle _{4}\\
&  =\left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)
\wedge\left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)
+\\
&  \left\langle \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}%
x_{l}x_{m}\right)  ^{2}\right\rangle _{4}+\left\langle \left(  i\sum_{1\leq
j\leq r}c_{2j}x_{j}x_{j+r}\right)  \left(  \sum_{1\leq j<k<l<m\leq r}%
c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)  \right\rangle _{4}=0
\end{align}


\item
\begin{align}
&  \left\langle A^{2}\right\rangle _{6}\left.  =\right.  \left\langle
A_{4}^{2}\right\rangle _{6}\left.  =\right.  \left\langle A_{2}A_{4}%
\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{6}\\
&  =\left(  i\sum_{1\leq j\leq r}c_{2j}x_{j}x_{j+r}\right)  \wedge\left(
\sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)  \left.
+\right.  \left\langle \left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}%
x_{k}x_{l}x_{m}\right)  ^{2}\right\rangle _{6}=0
\end{align}


\item
\[
\left\langle A^{2}\right\rangle _{8}=\left\langle A_{4}^{2}\right\rangle
_{8}=\left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)
\wedge\left(  \sum_{1\leq j<k<l<m\leq r}c_{4jklm}x_{j}x_{k}x_{l}x_{m}\right)
=0.
\]

\end{enumerate}

\subsection{Primitive Idempotents}

An idempotent $p$ is primitive if it cannot be expressed as a non trivial sum
of mutually orthogonal idempotents i.e.
\begin{equation}
p\neq\sum_{1\leq j\leq q}\eta_{j},\,q>1,
\end{equation}
where
\begin{equation}
\eta_{j}\eta_{k}=\eta_{j}\delta_{jk};1\leq j\leq q.
\end{equation}


A primitive idempotent could be of any order i.e.
\begin{equation}
p=\sum_{0\leq j\leq2^{2r}}\left\langle p\right\rangle _{j}=\sum_{0\leq
j\leq2^{2r}}p_{j},
\end{equation}
where $p_{j}=\left\langle p\right\rangle _{j}$ and is not in general
idempotent. The scalar part can be expressed as
\begin{equation}
p\ast I_{\mathcal{F}}=p_{0}=\operatorname*{tr}\left\{  p^{\dagger
}I_{\mathcal{F}}\right\}  I_{\mathcal{F}}.
\end{equation}
As $p=p^{2}$ one has in particular that
\begin{align}
p_{0}  &  =\left\langle p^{2}\right\rangle _{0}=\left\langle p^{\dagger
}p\right\rangle _{0}\geq0=\sum_{0\leq j\leq2^{2r}}\left\langle p_{j}^{\dagger
}p_{j}\right\rangle _{0}=p_{0}^{2}+\sum_{1\leq j\leq2^{2r}}\left\langle
p_{j}^{\dagger}p_{j}\right\rangle _{0}\\
p_{0}-p_{0}^{2}  &  =p_{0}\left(  I_{\mathcal{F}}-p_{0}\right)  =\sum_{1\leq
j\leq2^{2r}}\left\langle p_{j}^{\dagger}p_{j}\right\rangle _{0}\geq0,
\end{align}
so
\begin{equation}
0\leq p_{0}I_{\mathcal{F}}=\operatorname*{tr}\left\{  p_{0}I_{\mathcal{F}%
}\right\}  I_{\mathcal{F}}\leq I_{\mathcal{F}}\Leftrightarrow0\leq
\operatorname*{tr}\left\{  p_{0}I_{\mathcal{F}}\right\}  \leq1\Leftrightarrow
0\leq p_{0}\leq1.
\end{equation}


\subsection{Non Primitive Idempotents}

\subsubsection{Elementary Idempotents}

Elementary idempotents cannot be expressed as non trivial products of other
idempotents. The order of an idempotent is the order of the polynomial that
defines it in terms of Clifford algebra generators.

\paragraph{ Order 2 (Elementary)}%

\begin{align}
n_{j}  &  =a_{j}^{\dagger}a_{j}=\sum_{\substack{1\leq p\leq r\\1\leq
j_{2}<\cdots<j_{p}\leq r}}\left\vert \varphi_{j}\varphi_{j_{2}}\cdots
\varphi_{j_{p}}\right\rangle \left\langle \varphi_{j}\varphi_{j_{2}}%
\cdots\varphi_{j_{p}}\right\vert =\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\\
h_{j}  &  =a_{j}a_{j}^{\dagger}=\frac{1}{2}I_{\mathcal{F}}-n_{j}=\frac{1}%
{2}\sum_{\substack{0\leq p\leq r\\1\leq j_{1}<\cdots<j_{p}\leq r}}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\vert -\sum
_{\substack{1\leq p\leq r\\1\leq j_{2}<\cdots<j_{p}\leq r}}\left\vert
\varphi_{j}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\vert =\frac{1}%
{2}I_{\mathcal{F}}-ix_{j}x_{j+r}.
\end{align}
$\lceil$%
\begin{equation}
\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)  =\frac{1}{4}I_{\mathcal{F}}%
+ix_{j}x_{j+r}+\frac{1}{4}I_{\mathcal{F}}=\frac{1}{2}I_{\mathcal{F}}%
+ix_{j}x_{j+r}%
\end{equation}
$\rfloor$

$\lceil$Note that
\begin{align}
\operatorname{Tr}\left\{  n_{j}\right\}   &  =\binom{r-1}{0}+\binom{r-1}%
{1}+\cdots+\binom{r-1}{r-1}=2^{r-1}\\
\operatorname*{tr}\left\{  n_{j}\right\}   &  =\frac{2^{r-1}}{2^{r}}=\frac
{1}{2}%
\end{align}
$\rfloor$

\paragraph{Order 4 (Products of Elementary)}%

\begin{align}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}  &  =a_{j}^{\dagger}a_{j}%
a_{k}^{\dagger}a_{k}=n_{j}n_{k}=\sum_{3\leq p\leq r}\left\vert \varphi
_{j}\varphi_{k}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j}\varphi_{k}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\vert \\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)  \left(  \frac
{1}{2}I_{\mathcal{F}}+ix_{k}x_{k+r}\right) \\
n_{j}h_{k}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{k}x_{k+r}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+i\left(  x_{j}x_{j+r}-x_{k}x_{k+r}\right)  +x_{j}%
x_{j+r}x_{k}x_{k+r}\\
h_{j}h_{k}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{j}x_{j+r}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{k}x_{k+r}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+i\left(  x_{k}x_{k+r}-x_{j}x_{j+r}\right)  +x_{k}%
x_{k+r}x_{j}x_{j+r}%
\end{align}
In terms of FQ
\begin{align}
n_{j}n_{k}=  &  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}=\Gamma\left(
\left\vert \varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{j}%
\varphi_{k}\right\vert \right) \nonumber\\
&  =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert
\varphi_{j}\varphi_{k}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j}\varphi_{k}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq
r}P_{jkj_{1}\cdots j_{N}},
\end{align}
where
\begin{equation}
P_{jkj_{1}\cdots j_{N}};0\leq N\leq r,1\leq j_{1}<\cdots<j_{N}\leq r,0\leq
j<k\leq r
\end{equation}
are primitive idempotents.

$\lceil$Note that
\begin{equation}
\Gamma\left(  P_{j_{1}\cdots j_{N}}\right)  ^{2}=\Gamma\left(  P_{j_{1}\cdots
j_{N}}\right)  \Gamma\left(  P_{j_{1}\cdots j_{N}}\right)  =\Gamma\left(
P_{j_{1}\cdots j_{N}}\right)  =\Gamma\left(  P_{j_{1}\cdots j_{N}}^{2}\right)
=\Gamma\left(  P_{j_{1}\cdots j_{N}}P_{j_{1}\cdots j_{N}}\right)
\end{equation}
while
\begin{equation}
\Gamma\left(  P_{j_{1}\cdots j_{N}}\right)  \Gamma\left(  P_{k_{1}\cdots
k_{N}}\right)  \neq\Gamma\left(  P_{j_{1}\cdots j_{N}}P_{k_{1}\cdots k_{N}%
}\right)  ;\left(  j_{1}\cdots j_{N}\right)  \neq\left(  k_{1}\cdots
k_{N}\right)  .
\end{equation}


E.g.
\begin{align}
\Gamma\left(  P_{1}\right)  ^{2}  &  =\Gamma\left(  P_{1}\right)
=\Gamma\left(  P_{1}^{2}\right) \\
\Gamma\left(  P_{2}\right)  ^{2}  &  =\Gamma\left(  P_{2}\right)
=\Gamma\left(  P_{2}^{2}\right)  ,
\end{align}
while
\begin{align}
\Gamma\left(  P_{1}\right)  \Gamma\left(  P_{2}\right)   &  =n_{1}n_{2}%
=\Gamma\left(  P_{12}\right)  \neq0\\
\Gamma\left(  P_{1}P_{2}\right)   &  =0=\Gamma\left(  0\right)  .
\end{align}


$\rfloor.$

\paragraph{Products of Elementary Idempotents}

In general Non-Elementary idempotents are products of commuting elementary
idempotents e.g. an idempotent of order $n+m$ is given by
\begin{equation}
p_{n,m}=%
%TCIMACRO{\dprod \limits_{l=1,\cdots,m}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,\cdots,m}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=m+1,\cdots,n}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=m+1,\cdots,n}}
%EndExpansion
h_{i}=%
%TCIMACRO{\dprod \limits_{l=1,\cdots,m}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,\cdots,m}}
%EndExpansion
\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{l}x_{l+r}\right)
%TCIMACRO{\dprod \limits_{l=m+1,\cdots,n}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=m+1,\cdots,n}}
%EndExpansion
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{l}x_{l+r}\right)
\end{equation}
so that e.g.
\begin{align}
p_{2,0}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{1+r}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{2+r}\right)  =\frac{1}{4}I_{\mathcal{F}%
}+ix_{1}x_{1+r}+ix_{2}x_{2+r}+x_{1}x_{2}x_{1+r}x_{2+r}\\
p_{1,1}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{1+r}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{2+r}\right)  =\frac{1}{4}I_{\mathcal{F}%
}+ix_{1}x_{1+r}-ix_{2}x_{2+r}-x_{1}x_{2}x_{1+r}x_{2+r}\\
p_{0,2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{1+r}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{2+r}\right)  =\frac{1}{4}I_{\mathcal{F}%
}-ix_{1}x_{1+r}-ix_{2}x_{2+r}+x_{1}x_{2}x_{1+r}x_{2+r}.
\end{align}


One can also see (below) that Primitive idempotents are also products of
Elementary idempotents.

\subsubsection{Non Elementary Idempotents}

One can postulate that one can construct non-simple, (non-primitive?)
idempotents by considering in a Type $I$ representation
\begin{equation}
g^{\dagger}g=\ \sum_{1\leq j,k\leq s}c_{j}c_{k}a_{j}^{\dagger}a_{j+s}%
^{\dagger}a_{k+s}a_{k}=\ \sum_{1\leq j,k\leq s}c_{j}c_{k}\sum_{0\leq N\leq
r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\ \left\vert \varphi_{j}\varphi
_{j+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{k}\varphi_{k+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert ,
\end{equation}
where
\begin{equation}
\left\langle \left.  g\right\vert g\right\rangle =\mathbf{g}^{\dagger
}\mathbf{g}=1.
\end{equation}
$\lceil$%
\begin{align}
\left(  g^{\dagger}g\right)  ^{2}  &  =\ \sum_{\substack{1\leq j,k\leq
s\\1\leq l,m\leq s}}c_{j}c_{k}c_{l}c_{m}\sum_{\substack{0\leq N\leq r\\0\leq
M\leq r}}\sum_{\substack{1\leq j_{1}<\cdots<j_{N}\leq r\\1\leq k_{1}^{\prime
}<\cdots<k_{M}^{\prime}\leq r}}\ \ \left\vert \varphi_{j}\varphi_{j+s}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi
_{k}\varphi_{k+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \ \left\vert
\varphi_{l}\varphi_{l+s}\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle
\left\langle \varphi_{m}\varphi_{m+s}\varphi_{j_{1}}\cdots\varphi_{j_{M}%
}\right\vert \\
&  =\sum_{\substack{1\leq j,k\leq s\\1\leq l,m\leq s}}c_{j}c_{k}c_{l}c_{m}%
\sum_{\substack{0\leq N\leq r\\0\leq N\leq r}}\sum_{\substack{1\leq
j_{1}<\cdots<j_{N}\leq r\\1\leq k_{1}^{\prime}<\cdots<k_{N}^{\prime}\leq
r}}\left\vert \varphi_{j}\varphi_{j+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \delta_{klj_{1}\cdots j_{N}j_{1}^{\prime}\cdots j_{N}^{\prime}%
}\left\langle \varphi_{m}\varphi_{m+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert \\
&  =\sum_{\substack{1\leq j,k\leq s\\1\leq k,m\leq s}}c_{j}c_{k}^{2}%
\ c_{m}\sum_{\substack{0\leq N\leq r\\0\leq N\leq r}}\sum_{\substack{1\leq
j_{1}<\cdots<j_{N}\leq r\\1\leq k_{1}^{\prime}<\cdots<k_{N}^{\prime}\leq
r}}\left\vert \varphi_{j}\varphi_{j+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \delta_{klj_{1}\cdots j_{N}j_{1}^{\prime}\cdots j_{N}^{\prime}%
}\left\langle \varphi_{m}\varphi_{m+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert \\
&  =\sum_{1\leq j,m\leq s}c_{j}c_{m}\sum_{\substack{0\leq N\leq r\\0\leq N\leq
r}}\sum_{\substack{1\leq j_{1}<\cdots<j_{N}\leq r\\1\leq k_{1}^{\prime}%
<\cdots<k_{N}^{\prime}\leq r}}\left\vert \varphi_{j}\varphi_{j+s}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \delta_{j_{1}\cdots
j_{N}j_{1}^{\prime}\cdots j_{N}^{\prime}}\left\langle \varphi_{m}\varphi
_{m+s}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\end{align}
However \emph{the preceding calculation must be incorrect as }%
\begin{equation}
g^{\dagger}gg^{\dagger}g=\sum_{1\leq j,k,l,m\leq r}c_{j}c_{k}c_{l}c_{m}%
a_{j}^{\dagger}a_{j+s}^{\dagger}a_{k+s}a_{k}a_{l}^{\dagger}a_{l+s}^{\dagger
}a_{m+s}a_{m}%
\end{equation}
noting that%
\begin{align}
a_{k+s}a_{k}a_{l}^{\dagger}a_{l+s}^{\dagger}  &  =a_{k+s}\left(  \delta
_{kl}-a_{l}^{\dagger}a_{k}\right)  a_{l+s}^{\dagger}=a_{k+s}a_{l+s}^{\dagger
}\delta_{kl}-a_{k+s}a_{l}^{\dagger}a_{k}a_{l+s}^{\dagger}=\left(
1-a_{l+s}^{\dagger}a_{k+s}\right)  \delta_{kl}-a_{l}^{\dagger}a_{k+s}%
a_{l+s}^{\dagger}a_{k}\\
&  =\left(  1-a_{l+s}^{\dagger}a_{k+s}\right)  \delta_{kl}-a_{l}^{\dagger
}\left(  \delta_{kl}-a_{l+s}^{\dagger}a_{k+s}\right)  a_{k}=\delta
_{kl}I-a_{l+s}^{\dagger}a_{k+s}\delta_{kl}-a_{l}^{\dagger}a_{k}\delta
_{kl}+a_{l}^{\dagger}a_{l+s}^{\dagger}a_{k+s}a_{k}%
\end{align}
we obtain%
\begin{align}
g^{\dagger}gg^{\dagger}g  &  =\sum_{1\leq j,k,l,m\leq r}c_{j}c_{k}c_{l}%
c_{m}a_{j}^{\dagger}a_{j+s}^{\dagger}\left(  \delta_{kl}I-a_{l+s}^{\dagger
}a_{k+s}\delta_{kl}-a_{l}^{\dagger}a_{k}\delta_{kl}+a_{l}^{\dagger}%
a_{l+s}^{\dagger}a_{k+s}a_{k}\right)  a_{m+s}a_{m}\\
&  =\sum_{1\leq j,m\leq r}c_{j}c_{m}a_{j}^{\dagger}a_{j+s}^{\dagger}%
a_{m+s}a_{m}-\sum_{1\leq j,l,m\leq r}c_{j}c_{l}^{2}c_{m}a_{j}^{\dagger}%
a_{j+s}^{\dagger}a_{l+s}^{\dagger}a_{l+s}a_{m+s}a_{m}\\
&  -\sum_{1\leq j,l,m\leq r}c_{j}c_{l}^{2}c_{m}a_{j}^{\dagger}a_{j+s}%
^{\dagger}a_{l}^{\dagger}a_{l}a_{m+s}a_{m}+\sum_{1\leq j,k,l,m\leq r}%
c_{j}c_{k}c_{l}c_{m}a_{j}^{\dagger}a_{j+s}^{\dagger}a_{l}^{\dagger}%
a_{l+s}^{\dagger}a_{k+s}a_{k}a_{m+s}a_{m}\\
&  \neq g^{\dagger}g.
\end{align}%
\begin{align}
gg^{\dagger}  &  =\sum_{1\leq j,k,l,m\leq r}c_{k}c_{j}a_{k+s}a_{k}%
a_{j}^{\dagger}a_{j+s}^{\dagger}\ \\
g^{\dagger}g  &  =\sum_{1\leq j,k,l,m\leq r}c_{k}c_{j}a_{j}^{\dagger}%
a_{j+s}^{\dagger}a_{k+s}a_{k}\ \\
gg^{\dagger}-g^{\dagger}g  &  =\sum_{1\leq j,k,l,m\leq r}c_{k}c_{j}\left[
a_{k+s}a_{k},a_{j}^{\dagger}a_{j+s}^{\dagger}\right] \\
&  =\sum_{1\leq j,k,l,m\leq r}c_{k}c_{j}\left(  \delta_{kj}I-a_{j+s}^{\dagger
}a_{k+s}\delta_{kj}-a_{j}^{\dagger}a_{k}\delta_{kj}+a_{j}^{\dagger}%
a_{j+s}^{\dagger}a_{k+s}a_{k}\right) \\
&  =\sum_{1\leq j\leq r}\left(  c_{j}^{2}-c_{j}^{2}a_{j+s}^{\dagger}%
a_{j+s}-c_{j}^{2}a_{j}^{\dagger}a_{j}\right)  +\sum_{1\leq j,k\leq r}%
c_{k}c_{j}a_{j}^{\dagger}a_{j+s}^{\dagger}a_{k+s}a_{k}\\
&  =1-\sum_{1\leq j\leq r}c_{j}^{2}\left(  a_{j}^{\dagger}a_{j}+a_{j+s}%
^{\dagger}a_{j+s}\right)  +\sum_{1\leq j,k\leq r}c_{k}c_{j}a_{j}^{\dagger
}a_{j+s}^{\dagger}a_{k+s}a_{k}\\
&  =1-\sum_{1\leq j\leq r}c_{j}^{2}\left(  a_{j}^{\dagger}a_{j}+a_{j+s}%
^{\dagger}a_{j+s}\right)  +g^{\dagger}g
\end{align}
$\rfloor$

\subsection{Ket-Bra Primitive Idempotents}

One can consider Ket-Bra idempotents generated by GNS representations of the
algebra, which in general do not belong to the algebra but are in the
enveloping Type I Von Neumann Algebras. In particular Fock (vacuum)
representations $\mathcal{F}$ on $\mathcal{H}_{\mathcal{F}}$ are of Type I and
Ket-Bra partial isometries and idempotents are contained in it. Ket-Bra
operators are partial isometries whose initial and final projections are one
dimensional and thus only exist in Type I Von Neumann Algebras.

\subsubsection{Operator, Box and Exterior Products in $\mathcal{F}$}

\subparagraph{Definitions of \emph{the Box product, }$\boxtimes,$ \emph{and
Exterior, }$\wedge,$ \emph{products of operators}}

The \emph{Box }$\boxtimes$ and \emph{Exterior Products }$\wedge$ of Ket-Bra
basis elements of the one particle operator space are defined by
\begin{align}
\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \boxtimes\cdots\boxtimes\left\vert \varphi_{j_{N}}\right\rangle
\left\langle \varphi_{k_{M}}\right\vert  &  =\mathcal{A}_{N}\left(  \left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert
\otimes\cdots\otimes\left\vert \varphi_{j_{M}}\right\rangle \left\langle
\varphi_{k_{M}}\right\vert \right)  \mathcal{A}_{M}\\
&  =\frac{1}{\left(  N!M!\right)  }\sum_{\substack{\sigma\in S_{N}\\\mu\in
S_{M}}}\left\vert \varphi_{j_{\sigma\left(  1\right)  }}\right\rangle
\left\langle \varphi_{k_{\mu\left(  1\right)  }}\right\vert \otimes
\cdots\otimes\left\vert \varphi_{j_{\sigma\left(  N\right)  }}\right\rangle
\left\langle \varphi_{k_{\mu\left(  M\right)  }}\right\vert
\end{align}
and
\begin{align}
\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \wedge\cdots\wedge\left\vert \varphi_{j_{N}}\right\rangle
\left\langle \varphi_{k_{N}}\right\vert  &  =\mathcal{A}_{N}\left(  \left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert
\otimes\cdots\otimes\left\vert \varphi_{j_{N}}\right\rangle \left\langle
\varphi_{k_{N}}\right\vert \right) \\
&  =\frac{1}{N!}\sum_{\sigma\in S_{N}}\left\vert \varphi_{j_{\sigma\left(
1\right)  }}\right\rangle \left\langle \varphi_{k_{\sigma\left(  1\right)  }%
}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{\sigma\left(
N\right)  }}\right\rangle \left\langle \varphi_{k_{\sigma\left(  N\right)  }%
}\right\vert ,
\end{align}
respectively. Ket-Bra elements (which \emph{can only} be defined intrinsically
in the algebra $\mathcal{F}$ if it has representations of Type I -see
Takesaki, as they are partial isometries corresponding to one dimensional
projectors) which are grade inhomogeneous (in terms of grades defined by self
adjoint Majorana operators). It is important to note (Chisholm eq.80) that in
general
\begin{equation}
C\wedge D=\sum\limits_{0\leq m,n\leq2r}\left\langle C_{m}D_{n}\right\rangle
_{m+n},
\end{equation}
the product $\wedge$ is associative and
\begin{equation}
C_{m}\wedge D_{n}=\left(  -1\right)  ^{m+n}D_{n}\wedge C_{m}.
\end{equation}


$\lceil$Note that
\begin{equation}
A_{1}\otimes\cdots\otimes A_{p}\notin\mathcal{F},A_{j}\in\mathcal{F}_{1}%
\end{equation}
$\rfloor$

One can compare the action of the box product%

\begin{align}
&  \left(  \left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi
_{k_{1}}\right\vert \boxtimes\cdots\boxtimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)  \left\vert
\varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{N}}\right\rangle =\mathcal{A}%
_{N}\left(  \left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)  \left\vert
\varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{N}}\right\rangle \\
&  =\mathcal{A}_{N}\left(  \left\vert \varphi_{j_{1}}\right\rangle
\left\langle \varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)
\mathcal{A}_{N}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes\varphi_{l_{N}%
}\right\rangle \\
&  =\mathcal{A}_{N}\left(  \left\vert \varphi_{j_{1}}\right\rangle
\left\langle \varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)
\mathcal{A}_{N}^{2}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes
\varphi_{l_{N}}\right\rangle
\end{align}
to the wedge product of operators on an antisymmetric vector space (such as
$\mathcal{F}$ itself as in the left regular Hilbert Schmidt representation)
\begin{align}
&  \left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \wedge\cdots\wedge\left\vert \varphi_{j_{N}}\right\rangle
\left\langle \varphi_{k_{N}}\right\vert \left\vert \varphi_{l_{1}}\wedge
\cdots\wedge\varphi_{l_{p}}\right\rangle =\mathcal{A}_{N}\left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert
\otimes\cdots\otimes\left\vert \varphi_{j_{N}}\right\rangle \left\langle
\varphi_{k_{N}}\right\vert \left\vert \varphi_{l_{1}}\wedge\cdots\wedge
\varphi_{l_{p}}\right\rangle \\
&  =\mathcal{A}_{N}\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \mathcal{A}%
_{N}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes\varphi_{l_{N}}\right\rangle
\\
&  =\mathcal{A}_{N}\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \mathcal{A}_{N}%
^{2}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes\varphi_{l_{N}%
}\right\rangle
\end{align}
and see that they are \emph{identical. }

$\lceil$Explicitly in the bivector case
\begin{align}
&  \left(  \frac{{}}{{}}\left\vert \varphi_{p_{1}}\right\rangle \left\langle
\varphi_{p_{2}}\right\vert \boxtimes\left\vert \varphi_{q_{1}}\right\rangle
\left\langle \varphi_{q_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}%
}\wedge\varphi_{j_{2}}\right\rangle =\frac{1}{2!}\sum_{\sigma\in S_{2}%
}\left\vert \varphi_{\sigma\left(  p\right)  _{1}}\right\rangle \left\langle
\varphi_{\sigma\left(  p\right)  _{2}}\right\vert \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\left\vert \varphi_{\sigma\left(  q\right)  _{1}%
}\right\rangle \left\langle \varphi_{\sigma\left(  q\right)  _{2}}\right\vert
\left\vert \varphi_{j_{2}}\right\rangle \\
&  =\frac{1}{2}\left(  \left\vert \left\vert \varphi_{p_{1}}\right\rangle
\left\langle \varphi_{p_{2}}\right\vert \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\left\vert \varphi_{q_{1}}\right\rangle \left\langle
\varphi_{q_{2}}\right\vert \varphi_{j_{2}}\right\rangle +\left\vert \left\vert
\varphi_{q_{1}}\right\rangle \left\langle \varphi_{q_{2}}\right\vert
\left\vert \varphi_{j_{1}}\right\rangle \wedge\left\vert \varphi_{p_{1}%
}\right\rangle \left\langle \varphi_{p_{2}}\right\vert \varphi_{j_{2}%
}\right\rangle \right) \\
&  =\frac{1}{2}\left(  \left\vert \varphi_{p_{1}}\right\rangle \wedge
\left\vert \varphi_{q_{1}}\right\rangle \delta_{p_{2}j_{1}}\delta_{q_{2}j_{2}%
}+\left\vert \varphi_{q_{1}}\right\rangle \wedge\left\vert \varphi_{p_{1}%
}\right\rangle \delta_{q_{2}j_{1}}\delta_{p_{2}j_{2}}\right) \\
&  =\left(  \frac{{}}{{}}\left\vert \varphi_{q_{1}}\right\rangle \left\langle
\varphi_{q_{2}}\right\vert \boxtimes\left\vert \varphi_{p_{1}}\right\rangle
\left\langle \varphi_{p_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}%
}\wedge\varphi_{j_{2}}\right\rangle =\left(  \frac{1}{2}\left\vert
\varphi_{p_{1}}\varphi_{q_{1}}\right\rangle \left\langle \varphi_{p_{2}%
}\varphi_{q_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}}\wedge
\varphi_{j_{2}}\right\rangle ,
\end{align}
where%
\begin{equation}
S_{2}=\left\{  \sigma_{1},\sigma_{2}\right\}
\end{equation}%
\begin{align}
\sigma_{1}  &  :p\rightarrow p\\
\sigma_{1}  &  :q\rightarrow q
\end{align}%
\begin{align}
\sigma_{2}  &  :p\rightarrow q\\
\sigma_{2}  &  :q\rightarrow p.
\end{align}%
\begin{equation}
\left(  \left\vert \varphi_{q_{1}}\right\rangle \left\langle \varphi_{q_{2}%
}\right\vert \wedge\left\vert \varphi_{p_{1}}\right\rangle \left\langle
\varphi_{p_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}}\wedge
\varphi_{j_{2}}\right\rangle =\left(  \frac{1}{2}\left\vert \varphi_{p_{1}%
}\varphi_{q_{1}}\right\rangle \left\langle \varphi_{p_{2}}\varphi_{q_{2}%
}\right\vert \right)  \left\vert \varphi_{j_{1}}\wedge\varphi_{j_{2}%
}\right\rangle .
\end{equation}
$\rfloor$

\subsubsection{Decomposable Ket-Bra projectors
(\protect\underline{decomposable \emph{primitive idempotents}}) in terms of
one particle and one hole projectors (\protect\underline{simple idempotents})}

Recall the expressions for one particle and one hole projections
\begin{align}
n_{j}  &  =a_{j}^{\dagger}a_{j}=\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}%
=n_{j}^{\dagger}\\
h_{j}  &  =a_{j}a_{j}^{\dagger}=I_{\mathcal{F}}-n_{j}=\frac{1}{2}%
I_{\mathcal{F}}-ix_{j}x_{j+r}=h_{j}^{\dagger}%
\end{align}
and that they all commute.

Consider the $r=3$ case%

\begin{equation}
\mathcal{H}_{\mathcal{F}}=\operatorname*{linspan}\left\{  \left\vert
\phi\right\rangle ,\left\vert \varphi_{1}\right\rangle ,\left\vert \varphi
_{2}\right\rangle ,\left\vert \varphi_{3}\right\rangle ,\left\vert \varphi
_{1}\varphi_{2}\right\rangle ,\left\vert \varphi_{1}\varphi_{3}\right\rangle
,\left\vert \varphi_{2}\varphi_{3}\right\rangle ,\left\vert \varphi_{1}%
\varphi_{2}\varphi_{3}\right\rangle \right\}
\end{equation}
then as operators acting in $\mathcal{H}_{\mathcal{F}}$

1. In a vacuum Fock representation i.e. $a_{j}^{\dagger}\equiv\Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  a_{j}^{\dagger
}\right)  $ one has
\begin{equation}
\left\vert \phi\right\rangle \left\langle \phi\right\vert =a_{3}a_{2}%
a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}=a_{3}a_{3}^{\dagger}%
a_{2}a_{2}^{\dagger}a_{1}a_{1}^{\dagger}=h_{3}h_{2}h_{1}=%
%TCIMACRO{\dprod \limits_{l=1,2,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2,3}}
%EndExpansion
h_{i}%
\end{equation}


\begin{example}%
\begin{align}
\left\vert \phi\right\rangle \left\langle \phi\right\vert  &  =%
%TCIMACRO{\dprod \limits_{1\leq j\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\leq3}}
%EndExpansion
h_{j}=h_{1}h_{2}h_{3}=\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{5}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{3}x_{6}\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-\frac{1}{2}ix_{1}x_{4}-\frac{1}%
{2}ix_{2}x_{5}-x_{1}x_{4}x_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right) \\
&  =\left(  \frac{1}{8}I_{\mathcal{F}}-\frac{1}{4}ix_{1}x_{4}-\frac{1}%
{4}ix_{2}x_{5}-\frac{1}{2}x_{1}x_{4}x_{2}x_{5}-\frac{1}{4}ix_{3}x_{6}-\frac
{1}{2}x_{1}x_{4}x_{3}x_{6}-\frac{1}{2}x_{2}x_{5}x_{3}x_{6}+ix_{1}x_{4}%
x_{2}x_{5}x_{3}x_{6}\right) \\
&  =\left(  \frac{1}{8}I_{\mathcal{F}}-\frac{1}{4}ix_{1}x_{4}-\frac{1}%
{4}ix_{2}x_{5}-\frac{1}{4}ix_{3}x_{6}-\frac{1}{2}x_{1}x_{4}x_{2}x_{5}-\frac
{1}{2}x_{1}x_{4}x_{3}x_{6}-\frac{1}{2}x_{2}x_{5}x_{3}x_{6}+ix_{1}x_{4}%
x_{2}x_{5}x_{3}x_{6}\right) \\
&  =\left(  \frac{1}{8}I_{\mathcal{F}}-\frac{1}{4}i\left(  x_{1}x_{4}%
+x_{2}x_{5}+x_{3}x_{6}\right)  +\frac{1}{2}\left(  x_{1}x_{2}x_{4}x_{5}%
+x_{1}x_{3}x_{4}x_{6}+x_{2}x_{3}x_{5}x_{6}\right)  -ix_{1}x_{2}x_{3}x_{4}%
x_{5}x_{6}\right) \\
&  =\left\langle \left\vert \phi\right\rangle \left\langle \phi\right\vert
\right\rangle _{0}+\left\langle \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\rangle _{2}+\left\langle \left\vert \phi\right\rangle
\left\langle \phi\right\vert \right\rangle _{4}+\left\langle \left\vert
\phi\right\rangle \left\langle \phi\right\vert \right\rangle _{6},
\end{align}

\end{example}

2.%
\begin{equation}
\kappa_{1}=\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert =a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger
}=a_{3}a_{3}^{\dagger}a_{2}a_{2}^{\dagger}a_{1}^{\dagger}a_{1}=h_{3}h_{2}%
n_{1}=%
%TCIMACRO{\dprod \limits_{l=1}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=2,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=2,3}}
%EndExpansion
h_{i},
\end{equation}
which one can check by%

\begin{align}
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\phi\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{1}\right\rangle  &  =\left\vert \varphi_{1}\right\rangle \\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{2}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{3}^{\dagger}a_{2}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{2}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\right\rangle  &  =0.
\end{align}
$\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert $ can
be expressed in the self adjoint basis as
\begin{align}
\kappa_{1}  &  =\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert =%
%TCIMACRO{\dprod \limits_{1\leq j\neq1\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\neq1\leq3}}
%EndExpansion
h_{j}a_{j_{1}}^{\dagger}a_{j_{1}}=h_{2}h_{3}a_{1}^{\dagger}a_{1}=h_{2}%
h_{3}n_{1}=n_{1}h_{2}h_{3}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{4}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-i\frac{1}{2}x_{2}x_{5}+i\frac{1}%
{2}x_{1}x_{4}+x_{1}x_{4}x_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right) \\
&  =\frac{1}{8}I_{\mathcal{F}}-i\frac{1}{4}x_{3}x_{6}-i\frac{1}{4}x_{2}%
x_{5}+i\frac{1}{4}x_{1}x_{4}+\frac{1}{2}x_{1}x_{4}x_{2}x_{5}-\frac{1}{2}%
x_{2}x_{5}x_{3}x_{6}+\frac{1}{2}x_{1}x_{4}x_{3}x_{6}-ix_{1}x_{4}x_{2}%
x_{5}x_{3}x_{6}\\
&  =\frac{1}{8}I_{\mathcal{F}}-i\frac{1}{4}\left(  x_{3}x_{6}+x_{2}x_{5}%
-x_{1}x_{4}\right)  +\frac{1}{2}\left(  -x_{1}x_{2}x_{4}x_{5}+x_{2}x_{3}%
x_{5}x_{6}-x_{1}x_{3}x_{4}x_{6}\right)  +ix_{1}x_{2}x_{3}x_{4}x_{5}x_{6}.
\end{align}


3.%
\begin{align}
\kappa_{2}  &  =\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert =%
%TCIMACRO{\dprod \limits_{1\leq j\neq2\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\neq2\leq3}}
%EndExpansion
h_{j}a_{j_{1}}^{\dagger}a_{j_{1}}=h_{1}h_{3}a_{2}^{\dagger}a_{2}=h_{1}%
h_{3}n_{2}=a_{3}a_{1}a_{2}^{\dagger}a_{2}a_{1}^{\dagger}a_{3}^{\dagger}%
=a_{3}a_{3}^{\dagger}a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}\\
&  =h_{3}h_{1}n_{2}=%
%TCIMACRO{\dprod \limits_{l=2}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=2}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=1,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,3}}
%EndExpansion
h_{i}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{5}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right)  .
\end{align}


4%
\begin{align}
\kappa_{3}  &  =\left\vert \varphi_{3}\right\rangle \left\langle \varphi
_{3}\right\vert =%
%TCIMACRO{\dprod \limits_{1\leq j\neq3\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\neq3\leq3}}
%EndExpansion
h_{j}a_{j_{1}}^{\dagger}a_{j_{1}}=h_{1}h_{2}a_{3}^{\dagger}a_{3}=h_{1}%
h_{2}n_{3}=a_{2}a_{1}a_{3}^{\dagger}a_{3}a_{1}^{\dagger}a_{2}^{\dagger}%
=a_{2}a_{2}^{\dagger}a_{1}a_{1}^{\dagger}a_{3}^{\dagger}a_{23}=h_{2}h_{1}%
n_{3}\\
&  =%
%TCIMACRO{\dprod \limits_{l=3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=3}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=1,2}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2}}
%EndExpansion
h_{i}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{3}x_{6}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{5}\right)  .
\end{align}


5.%
\begin{align}
\kappa_{12}  &  =\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert =a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger
}a_{2}a_{3}^{\dagger}=a_{3}a_{3}^{\dagger}a_{1}^{\dagger}a_{1}a_{2}^{\dagger
}a_{2}=h_{3}n_{2}n_{1}\\
&  =%
%TCIMACRO{\dprod \limits_{l=1,2}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=3}}
%EndExpansion
h_{i}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{4}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right)  ,
\end{align}
which one can check by%

\begin{align}
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\phi\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{2}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =\left\vert \varphi_{1}\varphi
_{2}\right\rangle \\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{2}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\right\rangle  &  =0.
\end{align}
6.%
\begin{equation}
\kappa_{13}=\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{3}\right\vert =h_{2}a_{1}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{1}=h_{2}n_{1}n_{3},
\end{equation}
7.%
\begin{equation}
\kappa_{23}=\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{2}\varphi_{3}\right\vert =h_{1}a_{2}^{\dagger}a_{3}^{\dagger}%
a_{3}a_{2}=h_{1}n_{2}n_{3},
\end{equation}
8.%
\begin{align}
\kappa_{123}  &  =\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert =a_{1}^{\dagger
}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}a_{3}=n_{3}n_{2}n_{1}=%
%TCIMACRO{\dprod \limits_{l=1,2,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2,3}}
%EndExpansion
n_{i}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{4}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}+ix_{3}x_{6}\right)
\end{align}


The projectors onto subspaces of fixed particle number are given by
\begin{align}
P_{0}  &  =h_{1}h_{2}h_{3}\\
P_{1}  &  =h_{2}h_{3}a_{1}^{\dagger}a_{1}+h_{1}h_{3}a_{2}^{\dagger}a_{2}%
+h_{1}h_{2}a_{3}^{\dagger}a_{3}=h_{2}h_{3}n_{1}+h_{1}h_{3}n_{2}+h_{1}%
h_{2}n_{3}\\
P_{2}  &  =h_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}a_{3}+h_{1}a_{1}^{\dagger
}a_{1}a_{3}^{\dagger}a_{3}+h_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}%
=h_{1}n_{2}n_{3}+h_{2}n_{1}n_{3}+h_{3}n_{1}n_{2}\\
P_{3}  &  =n_{1}n_{2}n_{3}%
\end{align}
giving
\begin{equation}
I_{\mathcal{F}}=P_{0}+P_{1}+P_{2}+P_{3}.
\end{equation}


In the case $r=2$ the identity operator has the expansion
\begin{equation}
I_{\mathcal{F}}=P_{0}+P_{1}+P_{2}=h_{1}h_{2}+h_{2}n_{1}+h_{1}n_{2}+n_{1}n_{2},
\end{equation}
where%
\begin{align}
P_{0}  &  =h_{1}h_{2}=\left(  I_{\mathcal{F}}-n_{1}\right)  \left(
I_{\mathcal{F}}-n_{2}\right)  =I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}%
{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\\
P_{1}  &  =h_{2}a_{1}^{\dagger}a_{1}+h_{1}a_{2}^{\dagger}a_{2}=h_{1}%
n_{2}+h_{2}n_{1}\\
&  =h_{1}n_{2}+h_{2}n_{1}=\left(  I_{\mathcal{F}}-n_{1}\right)  n_{2}+\left(
I_{\mathcal{F}}-n_{2}\right)  n_{1}=n_{2}-n_{1}n_{2}+n_{1}-n_{1}n_{2}%
=n_{1}+n_{2}-2n_{1}n_{2}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)  +\left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{1}{2}ix_{1}x_{3}+\frac{1}{2}ix_{2}%
x_{4}+x_{1}x_{3}x_{2}x_{4}+\frac{1}{4}I_{\mathcal{F}}+\frac{1}{2}ix_{1}%
x_{3}-\frac{1}{2}ix_{2}x_{4}+x_{2}x_{4}x_{1}x_{3}\\
&  =\frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}\\
P_{2}  &  =n_{1}n_{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
+x_{1}x_{2}x_{3}x_{4}%
\end{align}
and we have also expanded in term of the self adjoint basis.

\emph{In general decomposable ket-bra projectors can be expressed as the
products }
\begin{align}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert  &  =%
%TCIMACRO{\dprod \limits_{0\leq l\leq p}}%
%BeginExpansion
{\displaystyle\prod\limits_{0\leq l\leq p}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{p+1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{p+1\leq l\leq r}}
%EndExpansion
h_{i}=%
%TCIMACRO{\dprod \limits_{0\leq l\leq p}}%
%BeginExpansion
{\displaystyle\prod\limits_{0\leq l\leq p}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{p+1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{p+1\leq l\leq r}}
%EndExpansion
\left(  I_{\mathcal{F}}-n_{l}\right) \\
&  =%
%TCIMACRO{\dprod \limits_{0\leq l\leq p}}%
%BeginExpansion
{\displaystyle\prod\limits_{0\leq l\leq p}}
%EndExpansion
\left\{  \frac{1}{2}I_{\mathcal{F}}+ix_{l}x_{l+r}\right\}
%TCIMACRO{\dprod \limits_{p+1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{p+1\leq l\leq r}}
%EndExpansion
\left\{  \frac{1}{2}I_{\mathcal{F}}-ix_{l}x_{l+r}\right\}  .
\end{align}


\subsubsection{Examples of Clifford exterior product of operators for $r=2,3$
compared to box products}

Consider the hole projectors $\left\{  \left.  h_{j}\right\vert 1\leq
j\leq2\right\}  $ the exterior products of the operators given by
\begin{align}
h_{1}  &  =\frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\\
h_{2}  &  =\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}%
\end{align}
are%
\begin{align}
h_{1}\wedge h_{1}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-ix_{1}x_{3}\\
h_{2}\wedge h_{2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-ix_{2}x_{4}\\
h_{1}\wedge h_{2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-ix_{1}x_{3}-ix_{2}x_{4}+x_{1}x_{2}x_{3}x_{4}.
\end{align}
The exterior product of the operator $P_{1}$ with itself is given by
\begin{equation}
P_{1}\wedge P_{1}=\left(  \frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}%
x_{4}\right)  \wedge\left(  \frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}%
x_{4}\right)  =\frac{1}{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}\neq P_{2},
\end{equation}
\emph{which should be compared to the box product}
\begin{equation}
P_{1}\boxtimes P_{1}=P_{2},
\end{equation}
which is shown by
\begin{equation}
\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert \right)  \boxtimes\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle
\left\langle \varphi_{2}\right\vert \right)  =2\left\vert \varphi_{1}%
\wedge\varphi_{2}\right\rangle \left\langle \varphi_{1}\wedge\varphi
_{2}\right\vert =\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert .
\end{equation}
The box product of the number operators
\begin{align}
n_{1}  &  =\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \\
n_{2}  &  =\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert
\end{align}
is given by
\begin{align}
n_{1}\boxtimes n_{2}  &  =\left(  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert +\left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
\boxtimes\left(  \left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert +\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right) \\
&  =2\left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle \left\langle
\varphi_{1}\wedge\varphi_{2}\right\vert =\left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert =n_{1}n_{2},
\end{align}
which in this case is equal to the operator product.

The projectors onto subspaces of fixed particle number for the $r=2$ case are
given by
\begin{align}
P_{0}  &  =I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}-a_{2}^{\dagger}a_{2}%
+a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=I_{\mathcal{F}}-n_{1}-n_{2}%
+n_{1}n_{2}\\
P_{1}  &  =a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}a_{2}-2a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}=n_{1}+n_{2}-2n_{1}n_{2}\\
P_{2}  &  =a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=n_{1}n_{2}.
\end{align}
Checking the orthogonality of these projectors one obtains
\begin{align*}
P_{0}P_{1}  &  =\left(  I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\right)  \left(
n_{1}+n_{2}-2n_{1}n_{2}\right) \\
&  =n_{1}+n_{2}-2n_{1}n_{2}-n_{1}\left(  n_{1}+n_{2}-2n_{1}n_{2}\right)
-n_{2}\left(  n_{1}+n_{2}-2n_{1}n_{2}\right)  +n_{1}n_{2}\left(  n_{1}%
+n_{2}-2n_{1}n_{2}\right) \\
&  =n_{1}+n_{2}-2n_{1}n_{2}-n_{1}-n_{1}n_{2}+2n_{1}n_{2}-n_{2}n_{1}%
-n_{2}+2n_{1}n_{2}\\
&  =-2n_{1}n_{2}-n_{1}n_{2}+2n_{1}n_{2}-n_{2}n_{1}+2n_{1}n_{2}=0
\end{align*}%
\begin{equation}
P_{0}P_{2}=\left(  I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\right)  n_{1}%
n_{2}=n_{1}n_{2}-n_{1}n_{2}-n_{1}n_{2}+n_{1}n_{2}=0
\end{equation}%
\begin{equation}
P_{1}P_{2}=\left(  n_{1}+n_{2}-2n_{1}n_{2}\right)  n_{1}n_{2}=n_{1}n_{2}%
+n_{1}n_{2}-2n_{1}n_{2}=0
\end{equation}
The checking exterior product $P_{1}\wedge P_{1}$ of the projector $P_{1}$
with itself again one gets
\begin{align}
P_{1}\wedge P_{1}  &  =P_{1}-\left(  \left\langle P_{12}P_{12}\right\rangle
_{0}+\left\langle P_{12}P_{12}\right\rangle _{2}+\left\langle P_{14}%
P_{12}\right\rangle _{2}+\left\langle P_{14}P_{12}\right\rangle _{4}\right. \\
&  +\left.  \left\langle P_{12}P_{14}\right\rangle _{2}+\left\langle
P_{14}P_{14}\right\rangle _{0}+\left\langle P_{14}P_{14}\right\rangle
_{2}+\left\langle P_{14}P_{14}\right\rangle _{4}+\left\langle P_{14}%
P_{14}\right\rangle _{6}\right) \\
&  =P_{1}-\left\langle P_{14}P_{14}\right\rangle _{0}=\frac{1}{2}%
I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}I_{\mathcal{F}}=\frac{1}%
{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}\neq P_{2}.
\end{align}
by noting that
\begin{align}
A\wedge B  &  =AB-\left(  \left\langle A_{2}B_{2}\right\rangle _{0}%
+\left\langle A_{2}B_{2}\right\rangle _{2}+\left\langle A_{4}B_{2}%
\right\rangle _{2}+\left\langle A_{4}B_{2}\right\rangle _{4}\right. \\
&  +\left.  \left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle A_{4}%
B_{4}\right\rangle _{0}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{4}\right\rangle _{4}+\left\langle A_{4}B_{4}\right\rangle _{6}\right)
.
\end{align}
If $r=2$ then the projectors in the non self adjoint basis are
\begin{align}
P_{0}  &  =\kappa_{0}=\left\vert \phi\right\rangle \left\langle \phi
\right\vert =h_{1}h_{2}=a_{1}a_{1}^{\dagger}a_{2}a_{2}^{\dagger}=\left(
1-a_{1}^{\dagger}a_{1}\right)  \left(  1-a_{2}^{\dagger}a_{2}\right)
=I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}-a_{2}^{\dagger}a_{2}+a_{1}^{\dagger
}a_{1}a_{2}^{\dagger}a_{2}=I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\\
\kappa_{1}  &  =\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert =h_{2}n_{1}=a_{2}a_{2}^{\dagger}a_{1}^{\dagger}a_{1}=\left(
1-a_{2}^{\dagger}a_{2}\right)  a_{1}^{\dagger}a_{1}=a_{1}^{\dagger}a_{1}%
-a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=n_{1}-n_{1}n_{2}=n_{1}\left(
I_{\mathcal{F}}-n_{2}\right) \\
\kappa_{2}  &  =\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert =h_{1}n_{2}=a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}=\left(
1-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger}a_{2}=a_{2}^{\dagger}a_{2}%
-a_{2}^{\dagger}a_{1}^{\dagger}a_{1}a_{2}=n_{2}-n_{1}n_{2}=n_{2}\left(
I_{\mathcal{F}}-n_{1}\right) \\
P_{1}  &  =\kappa_{1}+\kappa_{2}\\
P_{2}  &  =\kappa_{12}=\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert =n_{1}n_{2}.
\end{align}
The box products give%
\begin{align}
P_{0}\boxtimes P_{0}  &  =P_{0}\\
P_{0}\boxtimes\kappa_{1}  &  =\kappa_{1}\\
P_{0}\boxtimes\kappa_{2}  &  =\kappa_{2}\\
\kappa_{1}\boxtimes\kappa_{2}  &  =\kappa_{12}%
\end{align}
with all other product being zero.

In the self adjoint basis the atomic idempotents can be expanded as
\begin{align}
\kappa_{0}  &  =\kappa_{00}+\kappa_{02}+\kappa_{04}=\left(  I_{\mathcal{F}%
}-n_{1}\right)  \left(  I_{\mathcal{F}}-n_{2}\right)  =\left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{4}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\\
\kappa_{1}  &  =\kappa_{10}+\kappa_{12}+\kappa_{14}=n_{1}\left(
I_{\mathcal{F}}-n_{2}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}%
x_{3}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\\
\kappa_{2}  &  =\kappa_{20}+\kappa_{22}+\kappa_{24}=n_{2}\left(
I_{\mathcal{F}}-n_{1}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}%
x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\\
\kappa_{12}  &  =\kappa_{120}+\kappa_{122}+\kappa_{124}=\left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
=n_{1}n_{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}.
\end{align}
They sum to the identity%
\begin{align}
\kappa_{0}+\kappa_{1}+\kappa_{2}+\kappa_{12}  &  =\frac{1}{4}I_{\mathcal{F}%
}-\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}%
+\frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\\
&  +\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}+\frac{1}{4}I_{\mathcal{F}}+\frac{i}%
{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\\
&  =I_{\mathcal{F}}%
\end{align}
as they should.

The\emph{ Clifford exterior product} of the operators $\kappa_{1}$ and
$\kappa_{2}$ is given by
\begin{align}
&  \kappa_{1}\wedge\kappa_{2}=\left(  \kappa_{10}+\kappa_{12}+\kappa
_{14}\right)  \wedge\left(  \kappa_{20}+\kappa_{22}+\kappa_{24}\right)
=\kappa_{10}\kappa_{20}+\kappa_{12}+\kappa_{14}+\kappa_{22}+\kappa
_{24}+\left\langle \kappa_{12}\kappa_{22}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle \left(  x_{1}x_{3}-x_{2}x_{4}\right)  \left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{1}%
{4}x_{1}x_{2}x_{3}x_{4}+\frac{1}{4}\left\langle \left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle x_{1}x_{3}x_{1}x_{3}-x_{2}x_{4}x_{1}x_{3}-x_{1}x_{3}x_{2}%
x_{4}+x_{2}x_{4}x_{2}x_{4}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle -\frac{1}{4}I_{\mathcal{F}}+x_{1}x_{2}x_{3}x_{4}+x_{1}%
x_{2}x_{3}x_{4}-\frac{1}{4}I_{\mathcal{F}}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{2}x_{1}x_{2}x_{3}x_{4}=\frac{1}{16}I_{\mathcal{F}},
\end{align}
checked by%
\begin{align}
&  \kappa_{1}\wedge\kappa_{2}=\left(  \left(  \frac{1}{4}I_{\mathcal{F}}%
+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}%
x_{3}x_{4}\right)  \wedge\left(  \left(  \frac{1}{4}I_{\mathcal{F}}-\frac
{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}x_{3}%
x_{4}\right) \\
&  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  \right)  \wedge\left(  \frac{1}{4}I_{\mathcal{F}%
}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +\left(  \frac
{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right)  \wedge x_{1}x_{2}x_{3}x_{4}\right. \\
&  \left.  -x_{1}x_{2}x_{3}x_{4}\wedge\left(  \frac{1}{4}I_{\mathcal{F}}%
+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}%
x_{3}x_{4}\wedge x_{1}x_{2}x_{3}x_{4}\right) \\
&  \left(  \left(  \frac{1}{16}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-\frac{1}{4}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \wedge\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  \right)  \right. \\
&  \left.  +\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  \right)  \wedge x_{1}x_{2}x_{3}x_{4}-x_{1}x_{2}%
x_{3}x_{4}\wedge\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}x_{3}x_{4}\wedge x_{1}%
x_{2}x_{3}x_{4}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{8}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  +\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{8}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  +\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \wedge\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{2}x_{2}x_{4}x_{1}x_{3}=\frac{1}{16}I_{\mathcal{F}}.
\end{align}


The \emph{box product }of the operators $\kappa_{1}$ and $\kappa_{2}$ is given
by
\begin{align}
\kappa_{1}\boxtimes\kappa_{2}=  &  \left(  n_{1}-n_{1}n_{2}\right)
\boxtimes\left(  n_{2}-n_{1}n_{2}\right)  =n_{1}\boxtimes n_{2}-n_{1}\boxtimes
n_{1}n_{2}-n_{1}n_{2}\boxtimes n_{2}+n_{1}n_{2}\boxtimes n_{1}n_{2}=\frac
{1}{2}n_{1}n_{2}\\
=  &  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  \right)  -x_{1}x_{2}x_{3}x_{4}\right)  \boxtimes
\left(  \left(  \frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right)  -x_{1}x_{2}x_{3}x_{4}\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right)  \boxtimes\left(  \frac{1}{4}I_{\mathcal{F}}%
-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  -\left(  \frac
{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right)  \boxtimes x_{1}x_{2}x_{3}x_{4}\\
&  -x_{1}x_{2}x_{3}x_{4}\boxtimes\left(  \frac{1}{4}I_{\mathcal{F}}-\frac
{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}x_{3}%
x_{4}\boxtimes x_{1}x_{2}x_{3}x_{4}\\
&  =\left(  \frac{1}{16}I_{\mathcal{F}}\boxtimes I_{\mathcal{F}}+\frac{1}%
{4}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \boxtimes\left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right)  -\left(  \frac{1}{4}I_{\mathcal{F}}\boxtimes
x_{1}x_{2}x_{3}x_{4}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\boxtimes x_{1}x_{2}x_{3}x_{4}\right) \\
&  -\left(  \frac{1}{4}x_{1}x_{2}x_{3}x_{4}\boxtimes I_{\mathcal{F}}-\frac
{i}{2}x_{1}x_{2}x_{3}x_{4}\boxtimes\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right)  +x_{1}x_{2}x_{3}x_{4}\boxtimes x_{1}x_{2}x_{3}x_{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}\boxtimes I_{\mathcal{F}}+\frac{1}{4}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \boxtimes\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-\frac{1}{2}I_{\mathcal{F}}\boxtimes x_{1}x_{2}x_{3}x_{4}+x_{1}x_{2}x_{3}%
x_{4}\boxtimes x_{1}x_{2}x_{3}x_{4}\\
&  =\frac{1}{2}\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)  .
\end{align}
The box product squares of $\kappa_{1}$ and $\kappa_{2}$ are zero%

\begin{align}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
\boxtimes\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert  &  =\kappa_{1}\boxtimes\kappa_{1}=\left(  n_{1}-n_{1}%
n_{2}\right)  \boxtimes\left(  n_{1}-n_{1}n_{2}\right)  =n_{1}\boxtimes
n_{1}-2n_{1}\boxtimes n_{1}n_{2}+n_{1}n_{2}\boxtimes n_{1}n_{2}=0\\
\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
\boxtimes\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert  &  =\kappa_{2}\boxtimes\kappa_{2}=\left(  n_{2}-n_{1}%
n_{2}\right)  \boxtimes\left(  n_{2}-n_{1}n_{2}\right)  =n_{2}\boxtimes
n_{2}-2n_{2}\boxtimes n_{1}n_{2}+n_{1}n_{2}\boxtimes n_{1}n_{2}=0.
\end{align}


The Clifford \emph{operator} products of
\begin{equation}
\kappa_{1}=\kappa_{10}+\kappa_{12}+\kappa_{14}=n_{1}\left(  I_{\mathcal{F}%
}-n_{2}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
\kappa_{2}=\kappa_{20}+\kappa_{22}+\kappa_{24}=n_{2}\left(  I_{\mathcal{F}%
}-n_{1}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}%
\end{equation}
are given by

\begin{enumerate}
\item
\begin{align*}
\kappa_{1}\kappa_{2}  &  =\left(  \left(  \frac{1}{4}I_{\mathcal{F}}%
-x_{1}x_{2}x_{3}x_{4}\right)  +\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \right)  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}%
x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}x_{2}x_{3}x_{4}\right)  ^{2}%
+\frac{1}{4}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  ^{2}\\
&  =\left(  \frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}%
+x_{1}x_{2}x_{3}x_{4}x_{1}x_{2}x_{3}x_{4}\right)  +\frac{1}{4}\left(
x_{1}x_{3}x_{1}x_{3}-x_{1}x_{3}x_{2}x_{4}-x_{2}x_{4}x_{1}x_{3}+x_{2}x_{4}%
x_{2}x_{4}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{16}I_{\mathcal{F}}+\frac{1}{4}\left(  -\frac{1}{4}I_{\mathcal{F}}+x_{1}%
x_{2}x_{3}x_{4}+x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}I_{\mathcal{F}}\right) \\
&  =\frac{1}{8}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}%
{8}I_{\mathcal{F}}+\frac{1}{2}x_{1}x_{2}x_{3}x_{4}=0
\end{align*}


\item
\begin{align}
