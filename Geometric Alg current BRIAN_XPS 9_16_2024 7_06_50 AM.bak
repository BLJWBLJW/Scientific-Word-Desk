\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =\operatorname*{tr}%
\left\{  \Pi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  \right\}
=\operatorname*{tr}\left\{  \Pi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)
\right\}  =\frac{1}{16}\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}}}\left\{
\Pi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)  \right\}  =\frac{1}%
{256}\operatorname{Tr}_{\mathcal{H}_{\operatorname*{tr}}}\left\{
\Pi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  \right\}  =1
\end{equation}


\item
\begin{align}
\frac{1}{16}\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}}^{1}}\left\{
