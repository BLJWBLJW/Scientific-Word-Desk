&  \operatorname*{tr}\left\{  a_{k}^{\dagger}a_{k}+a_{k}a_{k}^{\dagger
}\right\}  =1\\
&  \operatorname*{tr}\left\{  a_{k}^{\dagger}a_{k}\right\}
=\operatorname*{tr}\left\{  a_{k}a_{k}^{\dagger}\right\}  =\frac{1}{2}%
\end{align}%
\begin{equation}
\operatorname*{tr}\left\{  a_{k}^{\dagger}a_{l}\right\}  =\operatorname*{tr}%
\left\{  a_{l}a_{k}^{\dagger}\right\}  =-\operatorname*{tr}\left\{  a_{l}%
a_{k}^{\dagger}\right\}  \Rightarrow\operatorname*{tr}\left\{  a_{k}^{\dagger
}a_{l}\right\}  =0;k\neq l
\end{equation}%
