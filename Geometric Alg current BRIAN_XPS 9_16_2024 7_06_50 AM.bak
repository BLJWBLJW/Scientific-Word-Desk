_{01}\oplus\mathcal{A}_{20}\oplus\mathcal{A}_{02}\oplus\mathcal{A}_{11}%
\oplus\mathcal{A}_{21}\oplus\mathcal{A}_{12}\oplus\mathcal{A}_{22}\right\} \\
&  =\binom{r}{0}^{2}+2\binom{r}{0}\binom{r}{2}+2\binom{r}{0}\binom{r}%
{1}+\binom{r}{1}^{2}+2\binom{r}{1}\binom{r}{2}+\binom{r}{2}^{2}%
=1+4+4+2+4+1=16=2^{4}\\
&  \dim\left\{  \mathcal{A}_{00}\oplus\mathcal{A}_{11}\oplus\mathcal{A}%
_{22}\right\}  =\binom{r}{0}^{2}+\binom{2}{1}^{2}+\binom{2}{2}^{2}=1+4+1=6
\end{align}
and by
\begin{align}
