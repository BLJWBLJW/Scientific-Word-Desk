[c]{cc}%
w_{3}^{d} & w_{4}^{d}%
\end{array}
\right)  \right)  \right\} \\
=\left\{  \left(
\begin{array}
[c]{cccc}%
v_{1} & v_{2} & w_{1}^{d} & w_{2}^{d}%
\end{array}
\right)  \wedge\left(
