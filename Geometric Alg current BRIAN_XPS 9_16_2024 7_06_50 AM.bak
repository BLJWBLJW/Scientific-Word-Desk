[c]{c}%
1\\
0
\end{array}
\right)  \otimes\overset{\cdots j_{p}}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\overset{r}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  }\right\rangle =\nonumber\\
&  \left\vert \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\overset{j_{2}\cdots}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\overset{\cdots j_{p}}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
