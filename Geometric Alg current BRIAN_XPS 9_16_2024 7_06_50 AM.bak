{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1d}\right] \\
&  ={\huge \wedge}\left(  \mathcal{H}^{1}\ \right)  \wedge{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  ,
\end{align}


