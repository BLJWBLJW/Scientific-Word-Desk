\subparagraph{Comparing the trace and vacuum representations}

one sees that:

1.
\begin{equation}
\ker\left\{  \Phi_{\operatorname*{tr}}\right\}  =0,
\end{equation}
so that
\begin{equation}
\dim\left\{  \ker\left\{  \Phi_{\operatorname*{tr}}\right\}  \right\}  =0,
\end{equation}
and
\begin{equation}
\ker\left\{  \Phi_{\operatorname*{tr}}\right\}  =\operatorname*{linspan}%
\left\{  \left.  x_{j_{1}}\cdots x_{j_{n}}\right\vert 1\leq j_{1}<\cdots
<j_{n}\leq2r,0\leq n\leq2r\right\}
\end{equation}
as
\begin{equation}
\operatorname*{tr}\left\{  \left(  x_{j_{1}}\cdots x_{j_{n}}\right)
^{\dagger}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  \right\}  \neq0;1\leq
j_{1}<\cdots<j_{n}\leq2r,0\leq n\leq2r.
\end{equation}
2.
\begin{align}
&  \ker\left\{  \Phi_{\left\vert \phi\right\rangle \left\langle \phi
\right\vert }\right\} \\
&  \left.  =\right.  \operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left\{  \left.  a_{p_{1}}^{\dagger}\cdots a_{p_{n}}^{\dagger}a_{q_{m}}\cdots
a_{q_{1}}\right\vert \right\}  ,1\leq p_{1}<\cdots<p_{n}\leq r,1\leq n\leq
r;\,1\leq q_{1}<\cdots<q_{m}\leq r,1\leq m\leq r\\
\left\{  \left.  a_{q_{m}}\cdots a_{q_{1}}\right\vert \,1\leq q_{1}%
<\cdots<q_{m}\leq r,1\leq m\leq r\right\}  ,\left\{  \left.  a_{p_{1}%
}^{\dagger}\cdots a_{p_{n}}^{\dagger}\right\vert 1\leq p_{1}<\cdots<p_{n}\leq
r,1\leq n\leq r\right\}
\end{array}
\right\}
\end{align}
so that
\begin{equation}
\dim\left\{  \ker\left\{  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\right\}  \right\}  =2^{2r}-2^{r}=2^{r}\left(  2^{r}%
-1\right)  ,
\end{equation}
as%
\begin{gather}
\operatorname*{tr}\left\{  a_{p_{1}}^{\dagger}\cdots a_{p_{n}}^{\dagger
}a_{q_{m}}\cdots a_{q_{1}}\left\vert \phi_{a}\right\rangle \left\langle
\phi_{a}\right\vert \right\}  =\operatorname*{tr}\left\{  a_{p_{1}}^{\dagger
}\cdots a_{p_{n}}^{\dagger}\left\vert \phi_{a}\right\rangle \left\langle
\phi_{a}\right\vert \right\}  =\operatorname*{tr}\left\{  a_{q_{m}}\cdots
a_{q_{1}}\left\vert \phi_{a}\right\rangle \left\langle \phi_{a}\right\vert
\right\}  =0,\\
1\leq p_{1}<\cdots<p_{n}\leq r,1\leq n\leq r;\,1\leq q_{1}<\cdots<q_{m}\leq
r,1\leq m\leq r.
\end{gather}
and%
\begin{equation}
\left\{  \ker\left\{  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\right\}  \right\}  ^{\bot}=\operatorname*{linspan}\left\{
\left.  a_{p_{1}}^{\dagger}\cdots a_{p_{n}}^{\dagger}\right\vert 1\leq
p_{1}<\cdots<p_{n}\leq r,1\leq n\leq r\right\}
\end{equation}
so that
\begin{equation}
\dim\left\{  \ker\left\{  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\right\}  \right\}  ^{\bot}=2^{r},
\end{equation}
as
\begin{equation}
\operatorname*{tr}\left\{  a_{p_{n}}\cdots a_{p_{1}}a_{p_{1}}^{\dagger}\cdots
a_{p_{n}}^{\dagger}\left\vert \phi_{a}\right\rangle \left\langle \phi
_{a}\right\vert \right\}  ;\text{ }1\leq p_{1}<\cdots<p_{n}\leq r,1\leq n\leq
r.
\end{equation}
The representation $\Pi_{\operatorname*{tr}}\left(  \mathcal{F}\right)  $ thus
decomposes into the direct sum of irreducible representations
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  \mathcal{F}\right)  =%
