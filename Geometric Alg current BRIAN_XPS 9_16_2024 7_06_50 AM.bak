0
\end{array}
\right)  \otimes\cdots\otimes\overset{r}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  }\right\rangle ,
\end{align}
which can be written as
\begin{gather}
\left[  a_{1}^{\dagger}\otimes a_{2}\otimes\overset{3\cdots}{\mathbb{I}%
}\otimes\cdots\otimes\overset{\cdots r}{\mathbb{I}}\right]  \left\vert
e_{2}\otimes e_{1}\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes e_{1}%
\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes e_{2}\otimes\cdots\otimes
e_{1}\right\rangle \nonumber\\
=\left\vert e_{1}\otimes e_{2}\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes
e_{1}\otimes\cdots\otimes e_{2}\otimes e_{2}\otimes e_{1}\otimes\cdots\otimes
e_{1}\right\rangle .
\end{gather}


The action of the projection can be written as
\begin{gather}
\left[  a_{1}^{\dagger}a_{1}\otimes\overset{2\cdots}{\mathbb{I}_{2}}%
\otimes\cdots\otimes\overset{\cdots r}{\mathbb{I}_{2}}\right]  \left\vert
e_{1}\otimes e_{1}\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes e_{1}%
\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes e_{1}\otimes\cdots\otimes
e_{1}\right\rangle \nonumber\\
=\left\vert e_{2}\otimes e_{1}\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes
e_{1}\otimes\cdots\otimes e_{1}\otimes e_{2}\otimes e_{1}\otimes\cdots\otimes
e_{1}\right\rangle
\end{gather}


The vacuum vector in the Pauli representation is represented by
\begin{equation}
\left\vert \overset{1\cdots}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  }\otimes\overset{\cdots\cdots\cdots\cdots\cdots\cdots\cdots
\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots}{\left(
