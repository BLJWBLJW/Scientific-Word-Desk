The variables $\left\{  d_{2j_{2}j_{1}}\right\}  $ and $\left\{
d_{4j_{1}j_{2}j_{3}j_{4}}\right\}  $ are constrained by the extension to a
positive functional constraint
\begin{gather}
1\geq\alpha_{0}+\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}}%
d_{2j_{2}j_{1}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\alpha_{4j_{1}%
j_{2}j_{3}j_{4}}d_{4j_{1}j_{2}j_{3}j_{4}}\geq0\\
\forall\\
\alpha_{0}I_{\mathcal{F}}+i\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}%
}x_{j_{1}}x_{j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\alpha
_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}\in
\emph{\mathfrak{P.}}%
\end{gather}
$\lceil$Consider the diagonal operators formed by products of
\begin{equation}
n_{j}=a_{j}^{\dagger}a_{j}=\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}%
\end{equation}
Two particle diagonal operators%
\begin{align}
A_{2}  &  =\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}n_{j_{1}}n_{j_{2}}=\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}%
j_{1}j_{2}}a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}}%
=\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\\
&  =\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}\left(
\frac{1}{2}I_{\mathcal{F}}+ix_{j_{1}}x_{j_{1}+r}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{j_{2}}x_{j_{2}+r}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}\left(
\frac{1}{4}I_{\mathcal{F}}+i\frac{1}{2}x_{j_{1}}x_{j_{1}+r}+i\frac{1}%
{2}x_{j_{2}}x_{j_{2}+r}-x_{j_{1}}x_{j_{1}+r}x_{j_{2}}x_{j_{2}+r}\right) \\
&  =\left(  \frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}%
j_{1}j_{2}}\right)  I_{\mathcal{F}}+\frac{i}{2}\sum_{1\leq j_{1}<j_{2}\leq
r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}\left(  x_{j_{1}}x_{j_{1}+r}+x_{j_{2}%
}x_{j_{2}+r}\right)  +\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}%
j_{1}j_{2}}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}\\
&  =\frac{1}{4}\operatorname*{Tr}\left\{  \lambda_{2}\right\}  I_{\mathcal{F}%
}+\frac{i}{2}\sum_{1\leq j_{1}<j_{2}\leq r}L_{2}^{1}\left(  \lambda
_{2}\right)  _{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}+\sum_{1\leq j_{1}<j_{2}\leq
r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r},
\end{align}
where
\begin{align}
&  \sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}\left(
x_{j_{1}}x_{j_{1}+r}+x_{j_{2}}x_{j_{2}+r}\right)  =\sum_{1\leq j_{1}<j_{2}\leq
r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{1}+r}+\sum_{1\leq j_{1}%
<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{2}}x_{j_{2}+r}\\
&  \lambda_{2j_{1}j_{2}j_{1}j_{2}}=\lambda_{2j_{2}j_{1}j_{2}j_{1}}\\
&  =\frac{1}{2}\sum_{1\leq j_{1}\neq j_{2}\leq r}\lambda_{2j_{1}j_{2}%
j_{1}j_{2}}x_{j_{1}}x_{j_{1}+r}+\frac{1}{2}\sum_{1\leq j_{1}\neq j_{2}\leq
r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{2}}x_{j_{2}+r}=\ \sum_{1\leq j_{1}\neq
j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{1}+r}\\
&  =\sum_{1\leq j_{1}\leq r}L_{2}^{1}\left(  \lambda_{2}\right)  _{j_{1}j_{1}%
}x_{j_{1}}x_{j_{1}+r},
\end{align}
where%
\begin{equation}
L_{2}^{1}\left(  \lambda_{2}\right)  _{j_{1}j_{1}}=\sum_{1\leq,j_{2}\leq
r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}.
\end{equation}
One particle operators%
\begin{align}
A_{1}  &  =\sum_{1\leq j_{1}\leq r}\lambda_{1j_{1}j_{1}}n_{j_{1}}=\sum_{1\leq
j_{1}\leq r}\lambda_{1j_{1}j_{1}}\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j_{1}%
}x_{j_{1}+r}\right)  =\left(  \frac{1}{2}\sum_{1\leq j_{1}\leq r}%
\lambda_{1j_{1}j_{1}}\right)  I_{\mathcal{F}}+i\sum_{1\leq j_{1}\leq r}%
\lambda_{1j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}\\
&  =\frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)  I_{\mathcal{F}%
}+i\sum_{1\leq j_{1}\leq r}\lambda_{1j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}%
\end{align}


\begin{remark}
\emph{i.e. they are inhomogeneous operators even in the simplet cases.}
\end{remark}

If the state $D$ is pure then (Type $I$ algebras)
\begin{equation}
D=D^{2},
\end{equation}
while if it is mixed (ensemble) then
\begin{gather}
D\geq D^{2}\\
\Updownarrow\\
D=\sum_{1\leq j\leq q}\alpha_{j}D_{j},
\end{gather}
where $\left\{  D_{j}\right\}  $ are pure density operators i.e.
\begin{equation}
D_{j}=D_{j}^{2}%
\end{equation}
and
\begin{equation}
\sum_{1\leq j\leq q}\alpha_{j}=1;\qquad0\leq\alpha_{j}\leq1.
\end{equation}


The square of the density operator can be expanded as%
\begin{equation}
D^{2}=\sum_{0\leq p,q\leq2r}\sum_{j=0}^{\min\left(  p,q\right)  }\left\langle
D_{p}D_{q}\right\rangle _{\left\vert p-q\right\vert +2j}=\sum_{0\leq n\leq
2r}\left\langle D^{2}\right\rangle _{n},
\end{equation}


and in general
\begin{equation}
\left\langle D^{2}\right\rangle _{n}\neq\left\langle D\right\rangle _{n}.
\end{equation}


The condition for a state to be a pure state is
\begin{equation}
\sum_{0\leq p,q\leq2r}\sum_{j=0}^{\min\left(  p,q\right)  }\left\langle
D_{p}D_{q}\right\rangle _{\left\vert p-q\right\vert +2j}=\sum_{0\leq p\leq
2r}D_{p}.
\end{equation}
e.g. $r=3$ and
\begin{equation}
D=D_{0}+D_{2}+D_{4}+D_{6}%
\end{equation}
the condition becames
\begin{align}
&  \sum_{0\leq p,q\leq6}\sum_{j=0}^{\min\left(  p,q\right)  }\left\langle
D_{p}D_{q}\right\rangle _{\left\vert p-q\right\vert +2j}\nonumber\\
&  =\left\langle D_{0}D_{0}\right\rangle _{0}+\left\langle D_{2}%
D_{2}\right\rangle _{0}+\left\langle D_{2}D_{2}\right\rangle _{2}+\left\langle
D_{2}D_{2}\right\rangle _{4}+\left\langle D_{4}D_{4}\right\rangle
_{0}+\left\langle D_{4}D_{4}\right\rangle _{2}+\left\langle D_{4}%
D_{4}\right\rangle _{4}+\left\langle D_{4}D_{4}\right\rangle _{6}+\left\langle
D_{4}D_{4}\right\rangle _{8}\nonumber\\
&  +\left\langle D_{6}D_{6}\right\rangle _{0}+\left\langle D_{6}%
D_{6}\right\rangle _{2}+\left\langle D_{6}D_{6}\right\rangle _{4}+\left\langle
D_{6}D_{6}\right\rangle _{6}+\left\langle D_{6}D_{6}\right\rangle
_{8}+\left\langle D_{6}D_{6}\right\rangle _{10}+\left\langle D_{6}%
D_{6}\right\rangle _{12}\nonumber\\
&  +2\left\{
\begin{array}
[c]{c}%
\left\langle D_{0}D_{0}\right\rangle _{0}+\left\langle D_{0}D_{2}\right\rangle
_{0}+\left\langle D_{0}D_{2}\right\rangle _{2}+\left\langle D_{0}%
D_{4}\right\rangle _{0}+\left\langle D_{0}D_{4}\right\rangle _{2}+\left\langle
D_{0}D_{4}\right\rangle _{4}+\left\langle D_{0}D_{6}\right\rangle _{0}\\
+\left\langle D_{0}D_{6}\right\rangle _{2}+\left\langle D_{0}D_{6}%
\right\rangle _{4}+\left\langle D_{0}D_{6}\right\rangle _{6}%
\end{array}
\right. \nonumber\\
&  +\left\langle D_{2}D_{4}\right\rangle _{0}+\left\langle D_{2}%
D_{4}\right\rangle _{2}+\left\langle D_{2}D_{4}\right\rangle _{4}+\left\langle
D_{2}D_{4}\right\rangle _{6}+\left\langle D_{2}D_{6}\right\rangle
_{0}+\left\langle D_{2}D_{6}\right\rangle _{2}+\left\langle D_{2}%
D_{6}\right\rangle _{4}\nonumber\\
&  +\left\langle D_{2}D_{6}\right\rangle _{6}+\left\langle D_{2}%
D_{6}\right\rangle _{8}\\
&  +\left.  \left\langle D_{4}D_{6}\right\rangle _{0}+\left\langle D_{4}%
D_{6}\right\rangle _{2}+\left\langle D_{4}D_{6}\right\rangle _{4}+\left\langle
D_{4}D_{6}\right\rangle _{6}+\left\langle D_{4}D_{6}\right\rangle
_{8}+\left\langle D_{4}D_{6}\right\rangle _{10}\right\}
\end{align}
then
\begin{align}
D_{0}  &  =\left\langle D_{0}D_{0}\right\rangle _{0}+\left\langle D_{2}%
D_{2}\right\rangle _{0}+\left\langle D_{4}D_{4}\right\rangle _{0}+\left\langle
D_{6}D_{6}\right\rangle _{0}+2\left(  \left\langle D_{0}D_{2}\right\rangle
_{0}+\left\langle D_{0}D_{4}\right\rangle _{0}+\left\langle D_{0}%
D_{6}\right\rangle _{0}\right) \nonumber\\
&  +\left\langle D_{2}D_{4}\right\rangle _{0}+\left\langle D_{2}%
D_{6}\right\rangle _{0}+\left\langle D_{4}D_{6}\right\rangle _{0}\\
D_{2}  &  =\left\langle D_{2}D_{2}\right\rangle _{2}+\left\langle D_{4}%
D_{4}\right\rangle _{2}+\left\langle D_{6}D_{2}\right\rangle _{4}+2\left(
\left\langle D_{0}D_{2}\right\rangle _{2}+\left\langle D_{0}D_{4}\right\rangle
_{2}+\left\langle D_{0}D_{6}\right\rangle _{2}+\left\langle D_{2}%
D_{4}\right\rangle _{2}\right) \nonumber\\
&  +\left\langle D_{2}D_{6}\right\rangle _{2}+\left\langle D_{4}%
D_{6}\right\rangle _{2}\\
D_{4}  &  =\left\langle D_{2}D_{2}\right\rangle _{4}+\left\langle D_{4}%
D_{4}\right\rangle _{4}+\left\langle D_{6}D_{6}\right\rangle _{4}+2\left(
\left\langle D_{0}D_{4}\right\rangle _{4}+\left\langle D_{0}D_{6}\right\rangle
_{4}+\left\langle D_{2}D_{4}\right\rangle _{4}\right) \nonumber\\
&  +\left\langle D_{2}D_{6}\right\rangle _{4}+\left\langle D_{4}%
D_{6}\right\rangle _{4}\\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{6}+\left\langle D_{6}%
D_{6}\right\rangle _{6}+\left\langle D_{0}D_{6}\right\rangle _{6}+\left\langle
D_{2}D_{4}\right\rangle _{6}+\left\langle D_{2}D_{6}\right\rangle
_{6}+\left\langle D_{4}D_{6}\right\rangle _{6}\nonumber\\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{8}+\left\langle D_{6}%
D_{6}\right\rangle _{8}+\left\langle D_{2}D_{6}\right\rangle _{8}+\left\langle
D_{4}D_{6}\right\rangle _{8}\nonumber\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{10}+\left\langle D_{4}%
D_{6}\right\rangle _{10}\nonumber\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{12}.
\end{align}
Noting that
\begin{equation}
D_{0}=I_{\mathcal{F}},
\end{equation}
where
\begin{equation}
f_{D}\left(  I_{\mathcal{F}}\right)  =1=\operatorname*{tr}\left\{  D\right\}
,
\end{equation}
one obtains that (noting $\left\langle A_{j}B_{k}\right\rangle _{0}=\left(
\left.  A_{j}\right\vert B_{k}\right)  =\left\langle A_{j}B_{k}\right\rangle
_{0}\delta_{jk})$
\begin{align}
0  &  =\left\langle D_{2}D_{2}\right\rangle _{0}+\left\langle D_{4}%
D_{4}\right\rangle _{0}+\left\langle D_{6}D_{6}\right\rangle _{0}\\
D_{2}  &  =-\left\{  \left\langle D_{2}D_{2}\right\rangle _{2}+\left\langle
D_{4}D_{4}\right\rangle _{2}+\left\langle D_{6}D_{2}\right\rangle
_{4}+2\left\{  \left\langle D_{2}D_{4}\right\rangle _{2}+\left\langle
D_{2}D_{6}\right\rangle _{2}+\left\langle D_{4}D_{6}\right\rangle
_{2}\right\}  \right\} \\
D_{4}  &  =-\left\{  \left\langle D_{2}D_{2}\right\rangle _{4}+\left\langle
D_{4}D_{4}\right\rangle _{4}+\left\langle D_{6}D_{6}\right\rangle
_{4}+2\left\{  \left\langle D_{2}D_{4}\right\rangle _{4}+\left\langle
D_{2}D_{6}\right\rangle _{4}+\left\langle D_{4}D_{6}\right\rangle
_{4}\right\}  \right\} \\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{6}+\left\langle D_{6}%
D_{6}\right\rangle _{6}+\left\langle D_{6}\right\rangle _{6}+\left\langle
D_{2}D_{4}\right\rangle _{6}+\left\langle D_{2}D_{6}\right\rangle
_{6}+\left\langle D_{4}D_{6}\right\rangle _{6}\\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{8}+\left\langle D_{6}%
D_{6}\right\rangle _{8}+\left\langle D_{2}D_{6}\right\rangle _{8}+\left\langle
D_{4}D_{6}\right\rangle _{8}\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{10}+\left\langle D_{4}%
D_{6}\right\rangle _{10}\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{12}.
\end{align}


The norms are given by%
\begin{align}
\left\Vert D\right\Vert _{HS}^{2}  &  =\left\langle DD\right\rangle
_{0}=\left\langle D^{2}\right\rangle _{0}=\sum_{0\leq p\leq2r}D_{p}D_{p}%
=\sum_{0\leq p\leq2r}\left\langle D_{p}^{2}\right\rangle =\sum_{0\leq p\leq
2r}\left\Vert D_{p}\right\Vert _{HS}^{2}\\
\left\Vert D^{2}\right\Vert _{HS}^{2}  &  =\left\langle D^{2}D^{2}%
\right\rangle _{0}=\left\langle D^{4}\right\rangle _{0}=\sum_{0\leq p\leq
2r}D_{p}^{2}D_{p}^{2}=\sum_{0\leq p\leq2r}\left\langle D_{p}^{4}\right\rangle
_{0}=\sum_{0\leq p\leq2r}\left\Vert D_{p}^{2}\right\Vert _{HS}^{2}.
\end{align}
Note that unless $D=I_{\mathcal{F}}$ one has that $\left\Vert D\right\Vert
_{HS}$ $>1$ and $\left\Vert D_{p}^{2}\right\Vert _{HS}^{2}>1.$

\subsubsection{The Number Operator}

If a state describes on the average $N_{a}$ particles then%
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  =\operatorname*{tr}\left\{  \left\langle
\mathcal{N}_{a0}D_{0}\right\rangle _{0}\right\}  +\operatorname*{tr}\left\{
\left\langle \mathcal{N}_{a2}D_{2}\right\rangle _{0}\right\}  =N_{a},
\end{equation}
where the number operator $\mathcal{N}_{a}$ is
\begin{equation}
\mathcal{N}_{a}=\sum_{1\leq j\leq r}n_{aj}=\mathcal{N}_{a0}+\mathcal{N}%
_{a2}=\mathcal{N}_{a}=\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}%
x_{j}x_{j+r}.
\end{equation}
If it describes $N_{a}$ particles then
\begin{gather}
\left[  \mathcal{N}_{a},D\right]  =0\,\&\,\operatorname*{tr}\left\{
\left\langle \mathcal{N}_{a}D\right\rangle _{0}\right\}  =N_{a}\nonumber\\
\Updownarrow\nonumber\\
\operatorname*{tr}\left\{  \left\langle \mathcal{N}_{a}^{2}D\right\rangle
_{0}\right\}  -\left(  \operatorname*{tr}\left\{  \left\langle \mathcal{N}%
_{a}D\right\rangle _{0}\right\}  \right)  ^{2}=0,
\end{gather}
i.e.
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  ^{2}-f_{D}\left(  \mathcal{N}_{a}%
^{2}\right)  =0.
\end{equation}


\begin{definition}
$U_{a}\left(  \alpha\right)  \in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  $%
\begin{equation}
U_{a}\left(  \alpha\right)  =\exp\left(  i\mathcal{N}_{a}\alpha\right)  ,
\end{equation}

\end{definition}

\begin{definition}
$\widehat{U_{a}\left(  \alpha\right)  }\in\mathcal{B}\left(  \mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  $%
\begin{equation}
\widehat{U_{a}\left(  \alpha\right)  }\left(  A\right)  =\exp\left(
i\mathcal{N}_{a}\alpha\right)  A\exp\left(  -i\mathcal{N}_{a}\alpha\right)
=\exp\left(  \widehat{i\mathcal{N}_{a}\alpha}\right)  \left(  A\right)  ,
\end{equation}

\end{definition}

One should observe that the same gauge transformation is produced by
$\widehat{\mathcal{N}_{a}}\left(  \alpha\right)  ,$where
\begin{equation}
\widehat{\mathcal{N}_{a}\left(  \alpha\right)  }\left(  A\right)  =\left[
\mathcal{N}_{a}\left(  \alpha\right)  ,A\right]
\end{equation}
for any $\alpha\in\left(  -\infty,\infty\right)  .$

The number operator expressed in the $\left\{  x_{j}\right\}  $ bases involves
$r$, which is infinity when $r=\infty,$ however the back transformation works
as one gets $\infty-\infty$ in the form of $r-r$ as can be seen from%
\begin{align}
\mathcal{N}_{x\left(  a\right)  }  &  =\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq
j\leq r}x_{j}x_{j+r}\nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\frac{1}{\sqrt{2}}\left(
a_{j}^{\dagger}+a_{j}\right)  \frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}%
-a_{j}\right) \\
&  =\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\frac{i}{2}\left(
-a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}-\frac{1}{2}\sum_{1\leq j\leq r}\left(
-a_{j}^{\dagger}a_{j}+I_{\mathcal{F}}-a_{j}^{\dagger}a_{j}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}-\sum_{1\leq j\leq r}\left(  \frac{1}%
{2}I_{\mathcal{F}}-a_{j}^{\dagger}a_{j}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}-\frac{r}{2}I_{\mathcal{F}}+\sum_{1\leq j\leq
r}a_{j}^{\dagger}a_{j}\nonumber\\
&  =\mathcal{N}_{a}.
\end{align}


The square of the number operator is given by
\begin{align}
\mathcal{N}_{a}^{2}  &  =\sum_{1\leq j,k\leq r}n_{j}n_{k}=\sum_{1\leq j\leq
r}n_{j}+2\sum_{1\leq j<k\leq r}n_{j}n_{k}=\sum_{1\leq j\leq r}n_{j}%
+2\sum_{1\leq j<k\leq r}a_{j}^{\dagger}a_{j}a_{k}^{\dagger}a_{k}\\
&  =\sum_{1\leq j\leq r}n_{j}+2\sum_{1\leq j<k\leq r}a_{j}^{\dagger}%
a_{k}^{\dagger}a_{k}a_{j}=\sum_{1\leq j\leq r}n_{j}+2\sum_{1\leq j<k\leq
r}n_{jk}=\mathcal{N}_{a}+2\mathcal{N}_{a2},
\end{align}
which gives in the Clifford basis
\begin{align}
\mathcal{N}_{x}^{2}  &  =\left(  \frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq
r}x_{j}x_{j+r}\right)  \left(  \frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq k\leq
r}x_{k}x_{k+r}\right) \nonumber\\
&  =\frac{r^{2}}{4}I_{\mathcal{F}}+i\frac{r}{2}\sum_{1\leq j\leq r}%
x_{j}x_{j+r}+\sum_{1\leq j,k\leq r}x_{j}x_{k}x_{j+r}x_{k+r}\nonumber\\
&  =\left(  \frac{r^{2}}{4}+\frac{r}{4}\right)  I_{\mathcal{F}}+i\frac{r}%
{2}\sum_{1\leq j\leq r}x_{j}x_{j+r}+2\sum_{1\leq j<k\leq r}x_{j}x_{k}%
x_{j+r}x_{k+r}\nonumber\\
&  =\frac{r\left(  r+1\right)  }{4}I_{\mathcal{F}}+i\frac{r}{2}\sum_{1\leq
j\leq r}x_{j}x_{j+r}+2\sum_{1\leq j<k\leq r}x_{j}x_{k}x_{j+r}x_{k+r}.
\end{align}


Thus a state describes a fixed number of $"a"$ particles iff
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  ^{2}-f_{D}\left(  \mathcal{N}_{a}%
^{2}\right)  =f_{D}\left(  \mathcal{N}_{a}\right)  ^{2}-f_{D}\left(
\mathcal{N}_{a}\right)  -2f_{D}\left(  \mathcal{N}_{a2}\right)  =f_{D}\left(
\mathcal{N}_{a}\right)  \left(  f_{D}\left(  \mathcal{N}_{a}\right)
-1\right)  -2f_{D}\left(  \mathcal{N}_{a2}\right)  =0,
\end{equation}
i.e.
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  \left(  f_{D}\left(  \mathcal{N}%
_{a}\right)  -1\right)  =2f_{D}\left(  \mathcal{N}_{a2}\right)  .
\end{equation}


The pair operator $\mathcal{N}_{a2}$ can be expanded as
\begin{align}
\mathcal{N}_{a2}  &  =\sum_{1\leq j<k\leq r}n_{j}n_{k}=\sum_{1\leq j<k\leq
r}\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{k}x_{k+r}\right) \\
&  =\frac{1}{4}\binom{r}{2}I_{\mathcal{F}}+2i\sum_{1\leq j\leq r}x_{j}%
x_{j+r}-\sum_{1\leq j<k\leq r}x_{j}x_{j+r}x_{k}x_{k+r}=\left\langle
\mathcal{N}_{x2}\right\rangle _{0}+\left\langle \mathcal{N}_{x2}\right\rangle
_{2}+\left\langle \mathcal{N}_{x2}\right\rangle _{4}.
\end{align}


\paragraph{Majorana Number Operator}

One can define the following function of the number operator, which we call
the \emph{Majorana Number Operator}, \emph{ }
\begin{equation}
\mathcal{N}_{xM}=i\sum_{1\leq j\leq r}x_{j}x_{j+r},,
\end{equation}
which generates the same representation (adjoint representation) of the Gauge
group in $\mathcal{F},$ and has the following properties
\begin{equation}
\left[  A,\mathcal{N}_{xM}\right]  =0\Longleftrightarrow\left[  A,\mathcal{N}%
_{x}\right]  =0
\end{equation}
and
\begin{equation}
f\left(  \mathcal{N}_{xM}^{2}\right)  =f\left(  \mathcal{N}_{xM}\right)
^{2}\Longleftrightarrow f\left(  \mathcal{N}_{x}^{2}\right)  =f\left(
\mathcal{N}_{x}\right)  ^{2}\,\forall f\in\mathcal{S}\left(  \mathcal{F}%
\right)  .
\end{equation}
In the non self adjoint basis

\begin{enumerate}
\item
\begin{align}
\mathcal{N}_{xM}  &  =i\sum_{1\leq j\leq r}\frac{1}{\sqrt{2}}\left(
a_{j}^{\dagger}+a_{j}\right)  \frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}%
-a_{j}\right)  =i\sum_{1\leq j\leq r}\frac{i}{2}\left(  a_{j}a_{j}^{\dagger
}-a_{j}^{\dagger}a_{j}\right) \nonumber\\
&  =-\frac{1}{2}\sum_{1\leq j\leq r}\left(  -a_{j}^{\dagger}a_{j}%
+I_{\mathcal{F}}-a_{j}^{\dagger}a_{j}\right)  =\sum_{1\leq j\leq r}\left(
a_{j}^{\dagger}a_{j}-\frac{1}{2}I_{\mathcal{F}}\right)  =\sum_{1\leq j\leq
r}\left(  n_{j}-\frac{1}{2}I_{\mathcal{F}}\right)  .
\end{align}


\item
\begin{align}
\widehat{\mathcal{N}}_{xM}\left(  x_{k}\right)   &  =\left[  i\sum_{1\leq
j\leq r}x_{j}x_{j+r},x_{k}\right]  =-ix_{k+r}\\
\widehat{\mathcal{N}}_{xM}\left(  x_{k+r}\right)   &  =\left[  i\sum_{1\leq
j\leq r}x_{j}x_{j+r},x_{k+r}\right]  =ix_{k}.
\end{align}


\item
\begin{align}
\widehat{\mathcal{N}}_{xM}\left(  \widehat{\mathcal{N}}_{xM}\left(
x_{k}\right)  \right)   &  =\widehat{\mathcal{N}}_{xM}\left(  \left[
i\sum_{1\leq j\leq r}x_{j}x_{j+r},x_{k}\right]  \right)
=-i\widehat{\mathcal{N}}_{xM}\left(  x_{k+r}\right)  =-iix_{k}=x_{k}\\
\widehat{\mathcal{N}}_{xM}\left(  \widehat{\mathcal{N}}_{xM}\left(
x_{k+r}\right)  \right)   &  =\widehat{\mathcal{N}}_{xM}\left(  \left[
i\sum_{1\leq j\leq r}x_{j}x_{j+r},x_{k+r}\right]  \right)
=i\widehat{\mathcal{N}}_{xM}\left(  x_{k}\right)  =-iix_{k+r}=x_{k+r},
\end{align}
thus
\begin{equation}
\left.  \widehat{\mathcal{N}}_{xM}^{2}\right\vert _{\mathcal{F}_{1}%
}=I_{\mathcal{F}_{1}},
\end{equation}
which is Greu$\beta$s $\omega$ involution.
\end{enumerate}

The operators\emph{ }$\widehat{\mathcal{N}}_{xM},$ and $\widehat{\mathcal{N}%
_{a}}$ leave the subspaces\emph{ }$\left\{  \left.  \mathcal{F}_{j}\right\vert
0\leq j\leq2r\right\}  $\emph{ }invariant \emph{but they do not leave the
component spaces }$\left\{  \mathbf{x}_{1},\mathbf{x}_{2}\right\}  $
\emph{invariant}$,$where
\begin{equation}
\mathcal{F}_{1}=\mathbf{x}_{1}\oplus_{\mathbb{C}}\mathbf{x}_{2}.
\end{equation}


On the other hand
\begin{align}
\left[  \mathcal{N}_{a},a_{k}^{\dagger}\right]   &  =\widehat{\mathcal{N}_{a}%
}\left(  a_{k}^{\dagger}\right)  =\left[  \sum_{1\leq j\leq r}a_{j}^{\dagger
}a_{j},a_{k}^{\dagger}\right]  =a_{k}^{\dagger}a_{k}a_{k}^{\dagger}%
-a_{k}^{\dagger}a_{k}^{\dagger}a_{k}=a_{k}^{\dagger}\\
\left[  \mathcal{N}_{a},a_{k}\right]   &  =\widehat{\mathcal{N}_{a}}\left(
a_{k}\right)  =a_{k}^{\dagger}a_{k}a_{k}-a_{k}a_{k}^{\dagger}a_{k}=-a_{k},
\end{align}
showing that $\widehat{\mathcal{N}}_{xM},$ and $\widehat{\mathcal{N}_{a}}$
\emph{do leave the component spaces }$\left\{  \mathbf{a}^{\dagger}%
,\mathbf{a}\right\}  $ \emph{invariant}$,$ where
\begin{equation}
\mathcal{F}_{1}=\mathbf{a}^{\dagger}\oplus_{\mathbb{C}}\mathbf{a}%
\end{equation}
\emph{ }i.e.
\begin{align}
\widehat{\mathcal{N}_{a}}  &  :\mathbf{a}^{\dagger}\longrightarrow
\mathbf{a}^{\dagger}\\
\widehat{\mathcal{N}_{a}}  &  :\mathbf{a}\longrightarrow\mathbf{a.}%
\end{align}


The difference of two expansions of number operators is
\begin{equation}
\mathcal{N}_{a}-\mathcal{N}_{b}=\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq
r}x_{j}x_{j+r}-\frac{r}{2}I_{\mathcal{F}}-i\sum_{1\leq j\leq r}y_{j}%
y_{j+r}=i\sum_{1\leq j\leq r}\left(  x_{j}x_{j+r}-y_{j}y_{j+r}\right)
=\mathcal{N}_{xM}-\mathcal{N}_{yM}.
\end{equation}


\paragraph{{\protect\LARGE Real and Complex Direct Sums}}

\begin{remark}
Let $V_{\mathbb{C}}$ and $W_{\mathbb{C}}$ be complex vector spaces and
$V_{\mathbb{R}}$ and $W_{\mathbb{R}}$ be real vector spaces

\begin{enumerate}
\item The complex direct sum%
\begin{equation}
V_{\mathbb{C}}\oplus_{\mathbb{C}}W_{\mathbb{C}}%
\end{equation}
is defined by
\begin{align}
\alpha\left(  v,w\right)   &  =\left(  \alpha v,\alpha w\right)  ;\,\alpha
\in\mathbb{C}\\
\left(  v_{1},w_{1}\right)  +\left(  v_{2},w_{2}\right)   &  =\left(
v_{1}+v_{2},w_{1}+w_{2}\right)  .
\end{align}


\item The spaces $V_{\mathbb{C}}$ and $W_{\mathbb{C}}$ can be embedded into
$V_{\mathbb{C}}\oplus_{\mathbb{C}}W_{\mathbb{C}}$ as disjoint complex
subspaces
\begin{equation}
V_{\mathbb{C}}\cong\left\{  \left.  \left(  v,0\right)  \right\vert v\in
V_{\mathbb{C}}\right\}  \subset V_{\mathbb{C}}\oplus_{\mathbb{C}}%
W_{\mathbb{C}}%
\end{equation}
and
\begin{equation}
W_{\mathbb{C}}\cong\left\{  \left.  \left(  0,w\right)  \right\vert w\in
W_{\mathbb{C}}\right\}  \subset V_{\mathbb{C}}\oplus_{\mathbb{C}}%
W_{\mathbb{C}}.
\end{equation}


\begin{notation}
The images of $V_{\mathbb{C}}$ and $W_{\mathbb{C}}$ under the embeddings are
$\widetilde{V_{\mathbb{C}}}$ and $\widetilde{W_{\mathbb{C}}}.$
\begin{equation}
V_{\mathbb{C}}\oplus_{\mathbb{C}}W_{\mathbb{C}}=\widetilde{V_{\mathbb{C}}%
}\oplus_{\mathbb{C}}\widetilde{W_{\mathbb{C}}}=\widetilde{V_{\mathbb{C}}%
}+_{\mathbb{C}}\widetilde{W_{\mathbb{C}}}%
\end{equation}

\end{notation}

\item The real direct sum%
\begin{equation}
V_{\mathbb{C}}\oplus_{\mathbb{R}}W_{\mathbb{C}}%
\end{equation}
is defined by%
\begin{align}
\alpha\left(  v,w\right)   &  =\left(  \alpha v,\alpha w\right)  ;\,\alpha
\in\mathbb{R}\\
\left(  v_{1},w_{1}\right)  +\left(  v_{2},w_{2}\right)   &  =\left(
v_{1}+v_{2},w_{1}+w_{2}\right)  .
\end{align}


\item Bases $\left\{  \left.  \varphi_{j}\right\vert 1\leq j\leq r\right\}  $
and $\left\{  \left.  \psi_{j}\right\vert 1\leq j\leq r\right\}  $ of
$V_{\mathbb{C}}$ and $W_{\mathbb{C}}$ produce bases $\left\{  \left.  \left(
\varphi_{j},0\right)  ,\left(  0,\psi_{j}\right)  \right\vert 1\leq j\leq
r\right\}  $ of $V_{\mathbb{C}}\oplus_{\mathbb{C}}W_{\mathbb{C}}$ and
$V_{\mathbb{C}}\oplus_{\mathbb{R}}W_{\mathbb{C}}$

\begin{enumerate}
\item By definition any vector $\left\vert \eta\right\rangle \in$
$V_{\mathbb{C}}\oplus_{\mathbb{C}}W_{\mathbb{C}}$ can be expanded as
\begin{equation}
\left\vert \eta\right\rangle =\sum_{1\leq j\leq r}\eta_{j}\left\vert \left(
\varphi_{j},0\right)  \right\rangle +\sum_{1\leq k\leq r}\zeta_{k}\left\vert
\left(  0,\psi_{k}\right)  \right\rangle ;\,\eta_{j},\zeta_{k}\in\mathbb{C}.
\end{equation}


\item Any vector $\left\vert \eta\right\rangle \in$ $V_{\mathbb{C}}%
\oplus_{\mathbb{R}}W_{\mathbb{C}}$ can be expanded as
\begin{equation}
\left\vert \alpha\right\rangle =\sum_{1\leq j\leq r}\eta_{j}\left\vert \left(
\varphi_{j},0\right)  \right\rangle +\sum_{1\leq k\leq r}\zeta_{k}\left\vert
\left(  0,\psi_{k}\right)  \right\rangle ;\,\eta_{j},\zeta_{k}\in\mathbb{R}%
\end{equation}
or%
\begin{equation}
\left\vert \alpha\right\rangle =\sum_{1\leq j\leq r}\eta_{j}\left\vert \left(
\varphi_{j},0\right)  \right\rangle +\sum_{1\leq k\leq r}\zeta_{k}^{\prime
}\left\vert \left(  0,i\psi_{k}\right)  \right\rangle ;\,\eta_{j},\zeta
_{k}^{\prime}\in\mathbb{R}.
\end{equation}
In particular if $W_{\mathbb{C}}=V_{\mathbb{C}}$
\begin{equation}
\left\vert \alpha\right\rangle =\sum_{1\leq j\leq r}\eta_{j}\left\vert \left(
\varphi_{j},0\right)  \right\rangle +\sum_{1\leq j\leq r}\zeta_{k}^{\prime
}\left\vert \left(  0,i\varphi_{j}\right)  \right\rangle ;\,\eta_{j},\zeta
_{k}^{\prime}\in\mathbb{R}%
\end{equation}
and as $\widetilde{V_{\mathbb{C}}}$ and $\widetilde{W_{\mathbb{C}}}$ are
disjoint subspaces of $V_{\mathbb{C}}\oplus_{\mathbb{R}}W_{\mathbb{C}}$
\begin{equation}
V_{\mathbb{C}}\oplus_{\mathbb{R}}iV_{\mathbb{C}}\equiv V_{\mathbb{C}%
}+_{\mathbb{R}}iV_{\mathbb{C}}=V_{\mathbb{C}}.
\end{equation}

\end{enumerate}

\item The real direct sum%
\begin{equation}
V_{\mathbb{R}}\oplus_{\mathbb{R}}W_{\mathbb{R}}%
\end{equation}
is defined by%
\begin{align}
\alpha\left(  v,w\right)   &  =\left(  \alpha v,\alpha w\right)  ;\,\alpha
\in\mathbb{R}\\
\left(  v_{1},w_{1}\right)  +\left(  v_{2},w_{2}\right)   &  =\left(
v_{1}+v_{2},w_{1}+w_{2}\right)  .
\end{align}


\item The bases $\left\{  \left.  \varphi_{j}\right\vert 1\leq j\leq
r\right\}  $ and $\left\{  \left.  \psi_{j}\right\vert 1\leq j\leq r\right\}
$ of $V_{\mathbb{C}}$ and $W_{\mathbb{C}}$ are also bases for \emph{different
isomorphic copies} of the real spaces $V_{\mathbb{R}}$ and $W_{\mathbb{R}}$
that produce bases $\left\{  \left.  \left(  \varphi_{j},0\right)  ,\left(
0,\psi_{j}\right)  \right\vert 1\leq j\leq r\right\}  $ of \emph{different
isomorphic copies} of the real direct sum spaces $V_{\mathbb{R}}%
\oplus_{\mathbb{R}}W_{\mathbb{R}}.$
\end{enumerate}
\end{remark}

\begin{remark}
The concrete Fock Space $\mathcal{H}_{\mathcal{F}}$ and Fock Algebra
$\mathcal{F}$, are $w^{\ast}$-algebra vacuum representations of the abstract
CAR $c^{\ast}$-algebra $\mathcal{A}$ wrt e.g. the normalized trace state$,$
$\operatorname*{tr}$ defined on $\mathcal{A}$ (if it exists) i.e.
$\operatorname*{tr}$ $\in\mathcal{A}^{d},$ and can be expressed as
\begin{align}
\mathcal{H}_{\mathcal{F}}  &  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\mathcal{H}^{n}\equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\Huge \wedge}^{n}\mathcal{H}^{1}\\
\mathcal{F}  &  =\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\mathcal{F}_{n}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
{\huge x}_{mn}=%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion
{\huge a}_{mn}=%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion
{\huge \varphi}_{mn}.
\end{align}
$\mathcal{F}$ is a $w^{\ast}$-algebra and can be considerd as a Clifford
algebra generated by the Clifford $w^{\ast}$-completion (the $w^{\ast}%
$-algebra generated by the GNS\ representation produced by the normalized
tracial state $\operatorname*{tr}$), of the $c^{\ast}$-algebra $\mathcal{F}$
and also has an exterior structure, i.e.
\begin{equation}
\mathcal{F}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{F}_{1}\right)  .
\end{equation}

\end{remark}

\begin{remark}
Any vacuum state suffices to generate a Fock representation of $\mathcal{A}.$
\end{remark}

\begin{definition}
Second quantization, $\Phi_{\varphi},$ of Hilbert spaces%
\begin{gather}
\Phi_{\varphi}:\mathcal{H}^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{C}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \rightarrow\mathcal{F}%
_{1},\\
\Phi_{\varphi}=\Phi_{\varphi1}\oplus_{\mathbb{C}}\Phi_{\varphi2}%
\end{gather}
is defined as
\begin{align}
\Phi_{\varphi}\left(  \mathbf{\varphi}\right)   &  =\mathbf{b}^{\dagger}\\
\Phi_{\varphi}\left(  \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\right)   &  =\mathbf{c}\ ,
\end{align}
where $\left\{  \boldsymbol{\varphi}\right\}  $ is a conb of $\mathcal{H}%
^{1}.$
\end{definition}

The \emph{complex linear} maps
\begin{equation}
\Phi_{\varphi}:\mathcal{H}^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{C}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \rightarrow\mathcal{F}%
_{1}\subset\mathcal{F}%
\end{equation}
are given by
\begin{equation}
\Phi_{\varphi}\left(  \left(  \varphi_{j},\sigma_{\varphi}\left(  \varphi
_{k}\right)  \right)  \right)  =\left(  \Phi_{\varphi1}\left(  \varphi
_{j}\right)  ,\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \varphi
_{k}\right)  \right)  \right)  =\left(  b_{j}^{\dagger},c_{k}\right)
\equiv\left(  b^{\dagger}\left(  \varphi_{j}\right)  ,c\left(  \varphi
_{k}\right)  \right)  ,\quad1\leq j,k\leq r,
\end{equation}
where
\begin{align}
\Phi_{\varphi1}  &  :\mathcal{H}^{1}\rightarrow\left\{  \mathbf{b}^{\dagger
}\right\} \\
\Phi_{\varphi2}  &  :\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\rightarrow\left\{  \mathbf{c}\right\}  .
\end{align}


\begin{remark}
In general
\begin{equation}
\Phi_{\varphi}\left(  \mathbf{\varphi},\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  =\left(  \mathbf{\varphi},\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  \mathcal{R}_{\varphi}\left(
\Phi_{\varphi}\right)  =\left(  \mathbf{\varphi},\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{W}_{r}}\left(  g\right) \\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{X}_{r}}\left(  g\right)
\end{array}
\right)  ,
\end{equation}
where $\mathbb{U}_{r}\left(  g\right)  ,\overline{\mathbb{W}_{r}}\left(
g\right)  ,\mathbb{V}_{r}\left(  g\right)  $ and $\overline{\mathbb{X}_{r}%
}\left(  g\right)  $ belong to $\mathcal{M}\left(  r,\mathbb{C}\right)  .$
\end{remark}

\begin{definition}
$\Phi_{\varphi}\left(  g\right)  $ is a \emph{Bogoliubov map} if
\begin{equation}
\Phi_{\varphi}\left(  g\right)  \left(  \mathbf{\varphi},\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  =\left(  \mathbf{\varphi}%
,\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)  \mathcal{R}%
_{\varphi}\left(  \Phi_{\varphi}\left(  g\right)  \right)  =\left(
\mathbf{\varphi},\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
\left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{V}_{r}}\left(  g\right) \\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{U}_{r}}\left(  g\right)
\end{array}
\right)
\end{equation}
if
\begin{equation}
\Phi_{\varphi}\left(  g\right)  \in\mathcal{B}\left(  \mathcal{F}_{1}\right)
\text{ and }g\in O\left(  2r,\mathbb{R}\right)  .
\end{equation}

\end{definition}

\begin{remark}
If $\Phi_{\varphi}$ is a bogoliubov map then
\begin{align}
\Phi_{\varphi}\left(  \mathbf{\varphi}\right)   &  =\mathbf{b}^{\dagger}\\
\Phi_{\varphi}\left(  \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\right)   &  =\mathbf{b}\ =\Phi_{\varphi}\left(  \mathbf{\varphi}\right)
^{\dagger}.
\end{align}

\end{remark}

\begin{remark}
In general a bogoliubov map $\Phi_{\varphi}$ produces mixtures of $\left\{
\mathbf{a}^{\dagger}\right\}  $ and $\left\{  \mathbf{a}\right\}  $ i.e.
\begin{gather}
\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi11} & \Phi_{\varphi12}\\
\Phi_{\varphi21} & \Phi_{\varphi22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\Phi_{\varphi11}\\
\Phi_{\varphi21}%
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\Phi_{\varphi12}\\
\Phi_{\varphi22}%
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{\varphi}\right)  \Phi_{\varphi11}+\sigma_{\varphi}\left(
\mathbf{\varphi}\right)  \Phi_{\varphi21} & \left(  \mathbf{\varphi}\right)
\Phi_{\varphi12}+\sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\Phi_{\varphi22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \mathbf{\varphi}\right)  \right)
\end{array}
\right)  =\Phi_{\varphi}\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  .
\end{gather}

\end{remark}

\begin{remark}
If
\begin{equation}
\Phi_{\varphi}\rightarrow\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi11} & \mathbf{0}_{12}\\
\mathbf{0}_{21} & \Phi_{\varphi22}%
\end{array}
\right)
\end{equation}
then
\begin{align}
\Phi_{\varphi}\left(  \mathbf{\varphi}\right)   &  =\mathbf{a}^{\dagger}\\
\Phi_{\varphi}\left(  \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\right)   &  =\mathbf{a}=\Phi_{\varphi}\left(  \mathbf{\varphi}\right)
^{\dagger}%
\end{align}
and $\Phi_{\varphi}$ does not mix $\left\{  \mathbf{a}^{\dagger}\right\}  $
and $\left\{  \mathbf{a}\right\}  .$
\end{remark}

\begin{remark}%
\begin{equation}
\sigma_{\varphi}\left(  zv\right)  =\overline{z}\sigma_{\varphi}\left(
v\right)  ,\quad v\in\mathcal{H}^{1}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \sigma_{\varphi}\left(  \psi
_{j}\right)  \right\vert 1\leq j\leq r\right\}  =\left\{  \left.
\sigma_{\varphi}\left(  v\right)  \right\vert v\in\mathcal{H}^{1}\right\}
\end{equation}
i.e.%
\begin{equation}
\eta=\sum_{1\leq j\leq r}\eta_{j}\sigma_{\varphi}\left(  \psi_{j}\right)
=\sum_{1\leq j\leq r}\sigma_{\varphi}\left(  \overline{\eta_{j}}\psi
_{j}\right)  ;\quad\eta_{j}\in\mathbb{C},\psi_{j}\in\mathcal{H}^{1},1\leq
j\leq r.
\end{equation}

\end{remark}

\begin{remark}
The conjugation $\sigma_{\varphi}$
\begin{equation}
\sigma_{\varphi}:\mathcal{H}^{1}\rightarrow\mathcal{H}^{1}%
\end{equation}
is conjugate linear $\equiv$ anti linear i.e.
\begin{equation}
\sigma_{\varphi}\left(  z_{1}\left\vert v_{1}\right\rangle +z_{2}\left\vert
v_{2}\right\rangle \right)  =\overline{z_{1}}\sigma_{\varphi}\left(
\left\vert v_{1}\right\rangle \right)  +\overline{z_{2}}\sigma_{\varphi
}\left(  \left\vert v_{2}\right\rangle \right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\ker\left\{  \sigma_{\varphi}\right\}  =\left\{  0\right\}  ,
\end{equation}
hence $\sigma_{\varphi}$ is an Hilbert space anti isomorphism.
\end{remark}

\begin{remark}
The dual space $\mathcal{H}^{1d}$%
\begin{align}
f_{\varphi_{1}},f_{\varphi_{2}}  &  :\mathcal{H}^{1}\rightarrow\mathbb{C}\\
\left(  z_{1}f_{\varphi_{1}}+z_{2}f_{\varphi_{2}}\right)  \left(  v\right)
&  =z_{1}f_{\varphi_{1}}\left(  v\right)  +z_{2}f_{\varphi_{2}}\left(
v\right)  =f_{\varphi_{1}}\left(  z_{1}v\right)  +f_{\varphi_{2}}\left(
z_{2}v\right)  =f_{z_{1}\varphi_{1}+z_{2}\varphi_{2}}\left(  v\right)
\end{align}

\end{remark}

\begin{remark}
The functionals $f_{v}$ are obviously $\mathbb{C}$-linear hence belong to
$\mathcal{H}^{1d}.$
\end{remark}

\begin{lemma}%
\begin{equation}
\mathcal{H}^{1}{\large \otimes}_{\mathbb{C}}\mathcal{H}^{1d}\cong%
\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\mathcal{H}^{1}{\large \otimes}_{\mathbb{C}}\mathcal{H}^{1d}=\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert \varphi
_{j}\right\rangle \otimes_{\mathbb{C}}\left\langle \varphi_{k}\right\vert
\right\vert 1\leq j,k\leq r\right\}  \cong\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert \right\vert 1\leq j,k\leq r\right\}
=\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{proof}

\begin{definition}
The isomorphism $\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}$
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}:\mathcal{H}^{1}{\large \otimes
}_{\mathbb{C}}\mathcal{H}^{1d}\rightarrow\mathcal{B}_{00}\left(
\mathcal{H}^{1}\right)
\end{equation}
between $\mathcal{H}^{1}\otimes_{\mathbb{C}}\mathcal{H}^{1d}$ and
$\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  $ is defined by
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \overset{}{\left\vert \varphi
_{j}\right\rangle \otimes_{\mathbb{C}}\left\langle \varphi_{k}\right\vert
}\right)  =\left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert ,1\leq j,k\leq r,
\end{equation}
hence
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left\{  \mathcal{H}^{1}{\large \otimes
}_{\mathbb{C}}\mathcal{H}^{1d}\right\}  =\mathcal{B}_{00}\left(
\mathcal{H}^{1}\right)  .
\end{equation}

\end{definition}

\begin{corollary}%
\begin{equation}
\mathcal{B}_{0}\left(  \mathcal{H}^{1}\right)  =\left\Vert {}\right\Vert
\text{-}\lim\left\{  \mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
\right\vert 1\leq j,k\leq r\right\}  \right\}  =\left\Vert {}\right\Vert
\text{-}\lim\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left\{  \mathcal{H}%
^{1}\otimes_{\mathbb{C}}\mathcal{H}^{1d}\right\}  .
\end{equation}

\end{corollary}

\begin{corollary}%
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  =s\text{-}\lim\left\{
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert \right\vert 1\leq
j,k\leq r\right\}  \right\}  =s\text{-}\lim\Xi_{\mathcal{H}^{1}\mathcal{H}%
^{1d}}\left\{  \mathcal{H}^{1}\otimes_{\mathbb{C}}\mathcal{H}^{1d}\right\}  .
\end{equation}

\end{corollary}

\begin{remark}
Operators can always be decomposed as the sum of an adjoint and anti self
adjoint operators
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  =\left\{  \left.
X=X_{1}+X_{2}\right\vert X_{1}=X_{1}^{\dagger},X_{2}=-X_{2}^{\dagger}\right\}
,
\end{equation}
where
\begin{align}
X_{1}  &  =\frac{1}{2}\left(  X+X^{\dagger}\right)  =X_{1}^{\dagger}\\
X_{2}  &  =\frac{1}{2}\left(  X-X^{\dagger}\right)  =-X_{2}^{\dagger},
\end{align}
hence $\mathbb{\ }$%
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\{  \left.  \frac{1}{2}\left(  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert \pm\left\vert
\varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)
\right\vert 1\leq j<k\leq r\right\}  ,\left\{  \left.  \frac{1}{2}\left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{j}\right\vert \right\vert 1\leq
j\leq r\right\}  \right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  i\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{j}\right\vert \right)  \right)  ^{2}=i\left(  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert -\left\vert \varphi
_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)  i\left(
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
-\left\vert \varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert
\right)  =\left(  \left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{k}\right\vert +\left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{j}\right\vert \right)
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
X_{1}  &  =\sum_{1\leq j\leq k\leq r}X_{1jk}\frac{1}{2}\left(  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert +\left\vert
\varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)  ,\quad
X_{1jk}\in\mathbb{R}\\
X_{2}  &  =\sum_{1\leq j<k\leq r}X_{2jk}\frac{1}{2}\left(  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert -\left\vert
\varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)  ,\quad
X_{2jk}\in\mathbb{R}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
iX_{2}=\sum_{1\leq j<k\leq r}iX_{2jk}\frac{1}{2}\left(  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert -\left\vert \varphi
_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)  =\left(
iX_{2}\right)  ^{\dagger},\quad X_{2}=-X_{2}^{\dagger}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left(  \left\vert \varphi
_{j}\right\rangle \wedge\left\langle \varphi_{k}\right\vert \right)  \right)
&  =\frac{1}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  ,1\leq j<k\leq r\\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left(  i\left\vert \varphi
_{j}\right\rangle \wedge\left\langle \varphi_{k}\right\vert \right)  \right)
&  =\frac{i}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  ,1\leq j<k\leq r
\end{align}

\end{remark}

\begin{remark}%
\begin{align}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left(  \left\vert \varphi
_{j}\right\rangle \vee\left\langle \varphi_{k}\right\vert \right)  \right)
&  =\frac{1}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  ,1\leq j<k\leq r\\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left(  i\left\vert \varphi
_{j}\right\rangle \vee\left\langle \varphi_{k}\right\vert \right)  \right)
&  =\frac{i}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  ,1\leq j<k\leq r\\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left(  \left\vert \varphi
_{j}\right\rangle \vee\left\langle \varphi_{j}\right\vert \right)  \right)
&  =\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{j}\right\vert
,1\leq j\leq r.
\end{align}

\end{remark}

\begin{definition}
The isomorphism $\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert
}}$
\begin{align}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}  &
:\mathcal{H}^{1}{\large \wedge}_{\mathbb{R}}\mathcal{H}^{1d}\rightarrow
\mathcal{B}_{00ah}\left(  \mathcal{H}^{1}\right) \\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}  &
:\mathcal{H}^{1}{\large \vee}_{\mathbb{R}}\mathcal{H}^{1d}\rightarrow
\mathcal{B}_{00h}\left(  \mathcal{H}^{1}\right)
\end{align}
between $\mathcal{H}^{1}{\large \wedge}_{\mathbb{R}}\mathcal{H}^{1d}$ and
$\mathcal{H}^{1}{\large \vee}_{\mathbb{R}}\mathcal{H}^{1d}$ into
$\mathcal{B}_{00ah}\left(  \mathcal{H}^{1}\right)  $ and $\mathcal{B}%
_{00h}\left(  \mathcal{H}^{1}\right)  $ are defined by
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left(
\left\vert \varphi_{j}\right\rangle \wedge_{\mathbb{R}}\left\langle
\varphi_{k}\right\vert \right)  =\frac{1}{2}\left(  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert -\left\vert \varphi
_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)  ,1\leq j<k\leq
r,
\end{equation}
and
\begin{align}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left(
i\left\vert \varphi_{j}\right\rangle \vee_{\mathbb{R}}\left\langle \varphi
_{k}\right\vert \right)   &  =\frac{1}{2}\left(  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert +\left\vert \varphi
_{k}\right\rangle \left\langle \varphi_{j}\right\vert \right)  \leftrightarrow
\frac{i}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  ,1\leq j<k\leq r\\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left(
\left\vert \varphi_{j}\right\rangle \vee_{\mathbb{R}}\left\langle \varphi
_{j}\right\vert \right)   &  =\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{j}\right\vert ,1\leq j\leq r,
\end{align}
hence
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left\{
\mathcal{H}^{1}{\large \wedge}_{\mathbb{R}}\mathcal{H}^{1d}\right\}
=\mathcal{B}_{00ah}\left(  \mathcal{H}^{1}\right)
\end{equation}
and
\begin{equation}
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left\{
\mathcal{H}^{1}{\large \vee}_{\mathbb{R}}\mathcal{H}^{1d}\right\}
=\mathcal{B}_{00ah}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{definition}

\begin{remark}
The space of anti self adjoint operators \emph{is not} isomorphic to the space
of self adjopint operators
\begin{equation}
\mathcal{B}_{00ah}\left(  \mathcal{H}^{1}\right)  \,\lnot\cong\mathcal{B}%
_{00h}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\mathcal{H}^{1}{\large \wedge}_{\mathbb{R}}\mathcal{H}^{1d}\cong%
\mathcal{B}_{00ah}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{align}
\mathcal{H}^{1}{\large \wedge}_{\mathbb{R}}\mathcal{H}^{1d}  &  =\mathbb{R}%
\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert \varphi
_{j}\right\rangle \wedge_{\mathbb{R}}\left\langle \varphi_{k}\right\vert
\right\vert 1\leq j<k\leq r\right\}  =\mathbb{R}\text{-}%
\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(  \left\vert
\varphi_{j}\right\rangle \otimes_{\mathbb{R}}\left\langle \varphi
_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \otimes_{\mathbb{R}%
}\left\langle \varphi_{j}\right\vert \right)  \right\vert 1\leq j<k\leq
r\right\} \\
&  \cong\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.  \frac{1}%
{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{j}\right\vert \right)  \right\vert 1\leq j<k\leq r\right\}  =\mathcal{B}%
_{00ah}\left(  \mathcal{H}^{1}\right)  .
\end{align}

\end{proof}

\begin{lemma}%
\begin{equation}
\mathcal{H}^{1}{\large \vee}_{\mathbb{R}}\mathcal{H}^{1d}\cong\mathcal{B}%
_{00h}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{align}
\mathcal{H}^{1}{\large \vee}_{\mathbb{R}}\mathcal{H}^{1d}  &  =\mathbb{R}%
\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert \varphi
_{j}\right\rangle \vee_{\mathbb{R}}\left\langle \varphi_{k}\right\vert
\right\vert 1\leq j<k\leq r\right\}  =\mathbb{R}\text{-}%
\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(  \left\vert
\varphi_{j}\right\rangle \otimes_{\mathbb{R}}\left\langle \varphi
_{k}\right\vert +\left\vert \varphi_{k}\right\rangle \otimes_{\mathbb{R}%
}\left\langle \varphi_{j}\right\vert \right)  \right\vert 1\leq j\leq k\leq
r\right\} \\
&  \cong\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.  \frac{1}%
{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert +\left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{j}\right\vert \right)  \right\vert 1\leq j\leq k\leq r\right\}
=\mathcal{B}_{00h}\left(  \mathcal{H}^{1}\right)  .
\end{align}

\end{proof}

\begin{corollary}%
\begin{equation}
\mathcal{B}_{0ah}\left(  \mathcal{H}^{1}\right)  =\left\Vert {}\right\Vert
\text{-}\lim\left\{  \mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\frac{1}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert -\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  \right\vert 1\leq j<k\leq r\right\}  \right\}
=\left\Vert {}\right\Vert \text{-}\lim\Xi_{\mathcal{H}^{1}\mathcal{H}%
^{1\left\langle {}\right\vert }}\left\{  \mathcal{H}^{1}\wedge_{\mathbb{R}%
}\mathcal{H}^{1d}\right\}
\end{equation}
and
\begin{equation}
\mathcal{B}_{0h}\left(  \mathcal{H}^{1}\right)  =\left\Vert {}\right\Vert
\text{-}\lim\left\{  \mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\frac{1}{2}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert +\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert \right)  \right\vert 1\leq j<k\leq r\right\}  \right\}
=\left\Vert {}\right\Vert \text{-}\lim\Xi_{\mathcal{H}^{1}\mathcal{H}%
^{1\left\langle {}\right\vert }}\left\{  \mathcal{H}^{1}\vee_{\mathbb{R}%
}\mathcal{H}^{1d}\right\}  .
\end{equation}

\end{corollary}

\begin{corollary}%
\begin{equation}
\mathcal{B}_{ah}\left(  \mathcal{H}^{1}\right)  =s\text{-}\lim\left\{
\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
-\left\vert \varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert
\right)  \right\vert 1\leq j<k\leq r\right\}  \right\}  =s\text{-}\lim
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left\{
\mathcal{H}^{1}\wedge_{\mathbb{R}}\mathcal{H}^{1d}\right\}
\end{equation}
and
\begin{equation}
\mathcal{B}_{h}\left(  \mathcal{H}^{1}\right)  =s\text{-}\lim\left\{
\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
+\left\vert \varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert
\right)  \right\vert 1\leq j<k\leq r\right\}  \right\}  =s\text{-}\lim
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1\left\langle {}\right\vert }}\left\{
\mathcal{H}^{1}\vee_{\mathbb{R}}\mathcal{H}^{1d}\right\}  .
\end{equation}

\end{corollary}

\begin{lemma}%
\begin{equation}
\mathcal{H}^{1}\otimes_{\mathbb{C}}\mathcal{H}^{1d}\cong\mathcal{B}%
_{00}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\mathcal{H}^{1}\otimes_{\mathbb{C}}\mathcal{H}^{1d}=\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \left\vert \varphi_{j}\right\rangle
\otimes_{\mathbb{C}}\left\langle \varphi_{k}\right\vert \right\vert 1\leq
j<k\leq r\right\}  \left.  \cong\right.  \mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  \frac{1}{2}\left(  \left\vert
\varphi_{j}\right\rangle \otimes_{\mathbb{R}}\left\langle \varphi
_{k}\right\vert \pm\left\vert \varphi_{k}\right\rangle \otimes_{\mathbb{R}%
}\left\langle \varphi_{j}\right\vert \right)  \right\vert 1\leq j,k\leq
r\right\}  =\mathcal{B}_{00}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{proof}

\begin{definition}
The Hilbert space isometric isomorphisms $\digamma_{\left\vert \varphi
\right\rangle }$ of the complex Hilbert space $\mathcal{H}^{1}$ with the dual
space $\mathcal{H}^{1d}$ of $\mathcal{H}^{1}$
\begin{equation}
\digamma_{\left\vert \varphi\right\rangle }:\mathcal{H}^{1}\rightarrow
\mathcal{H}^{1d}%
\end{equation}
is defined by
\begin{equation}
\digamma_{\left\vert \varphi\right\rangle }\left(  \left\vert v\right\rangle
\right)  =f_{v}=\left\langle v\right\vert ,
\end{equation}
where
\begin{equation}
f_{v}\left(  w\right)  =\left\langle \left.  v\right\vert w\right\rangle .
\end{equation}

\end{definition}

\begin{remark}
The map
\begin{equation}
\digamma_{\left\vert \varphi\right\rangle }:\mathcal{H}^{1}\rightarrow
\mathcal{H}^{1d}%
\end{equation}
is \emph{antilinear}. In finite dimensions
\begin{equation}
\digamma_{\left\vert \varphi\right\rangle }=\digamma_{\left\vert
{}\right\rangle }.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{H}^{1}\otimes_{\mathbb{C}}\mathcal{H}^{1d}=\mathcal{H}^{1}%
\otimes_{\mathbb{C}}\digamma_{\left\vert \varphi\right\rangle }\left(
\mathcal{H}^{1}\right)
\end{equation}
hence
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1}\right)  =s\text{-}\lim\left\{
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \overset{}{\mathcal{H}^{1}%
\otimes_{\mathbb{C}}\digamma_{\left\vert \varphi\right\rangle }\left(
\mathcal{H}^{1}\right)  }\right)  \right\}  .
\end{equation}

\end{remark}

\begin{example}%
\begin{align}
\digamma_{\left\vert {}\right\rangle }\left(  \left\vert w\right\rangle
\right)   &  =\left\langle w\right\vert \\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left\vert v\right\rangle
\otimes\digamma_{\left\vert {}\right\rangle }\left(  \left\vert w\right\rangle
\right)  \right)   &  =\left\vert v\right\rangle \left\langle w\right\vert .
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\mathcal{H}^{1d}=\digamma_{\left\vert \varphi\right\rangle }\left\{
\mathcal{H}^{1}\right\}  =\digamma_{\left\vert \varphi\right\rangle }\left\{
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  =\digamma
_{\left\vert \sigma_{\varphi}\left(  \varphi\right)  \right\rangle }\left\{
\mathcal{H}^{1}\right\}  .
\end{equation}

\end{remark}

\begin{remark}
The dual of a Hilbert space $\mathcal{H}$ is anti isomorphic to the Hilbert
space $\mathcal{H}$ and the anti isomorphism is $\digamma_{\left\vert
{}\right\rangle }$.
\end{remark}

\begin{definition}
The Hilbert space isomorphisms $\Upsilon_{1\phi}$
\begin{equation}
\Upsilon_{1\phi}:\mathcal{H}^{1}\rightarrow\mathcal{B}\left(  \mathcal{H}%
^{1},\mathcal{H}^{0}\right)
\end{equation}
is defined by%
\begin{equation}
\Upsilon_{1\phi}\left(  v\right)  =\left[  v\phi^{d}\right]  =E_{v\phi}.
\end{equation}

\end{definition}

\begin{example}%
\begin{equation}
\Upsilon_{1\phi}\left(  v\right)  =\left\vert v\right\rangle \left\langle
\phi\right\vert .
\end{equation}

\end{example}

\begin{definition}
The Hilbert space isomorphisms $\Upsilon_{2\phi}$%
\begin{equation}
\Upsilon_{2\phi}:\mathcal{H}^{1d}\rightarrow\mathcal{B}\left(  \mathcal{H}%
^{0},\mathcal{H}^{1}\right)
\end{equation}
is defined by%
\begin{equation}
\Upsilon_{2\phi}\left(  \digamma_{\left\vert \varphi\right\rangle }\left(
v\right)  \right)  =\Upsilon_{2\phi}\left(  \digamma\left(  v\right)  \right)
=\left[  \phi v^{d}\right]  =E_{\phi v}=\left[  \phi v^{d}\right]  ^{\dagger
}=E_{\phi v}^{\dagger}=\Upsilon_{1\phi}\left(  v\right)  ^{\dagger}.
\end{equation}

\end{definition}

\begin{example}%
\begin{equation}
\Upsilon_{2\phi}\left(  \digamma_{\left\vert \varphi\right\rangle }\left(
v\right)  \right)  =\left\vert \phi\right\rangle \left\langle v\right\vert
=\left\vert v\right\rangle \left\langle \phi\right\vert ^{\dagger}%
=\Upsilon_{1\phi}\left(  v\right)  ^{\dagger}.
\end{equation}

\end{example}

\begin{definition}
$\Upsilon_{\varphi}$ from the vector space $\mathcal{H}^{1}\oplus_{\mathbb{C}%
}\mathcal{H}^{1d}$ into the operator subspace $\mathcal{B}\left(
\mathcal{H}^{1},\mathcal{H}^{0}\right)  \oplus_{\mathbb{C}}\mathcal{B}\left(
\mathcal{H}^{0},\mathcal{H}^{1}\right)  $
\begin{equation}
\Upsilon_{2\phi}:\mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{1d}%
\rightarrow\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{0}\right)
\oplus_{\mathbb{C}}\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{1}\right)
\equiv\mathcal{B}\left(  \mathcal{H}^{1},\mathbb{C}\right)  \oplus
_{\mathbb{C}}\mathcal{B}\left(  \mathbb{C},\mathcal{H}^{1}\right)
\end{equation}
is given by%
\begin{equation}
\Upsilon_{\varphi}=\Upsilon_{1\phi}\oplus_{\mathbb{C}}\Upsilon_{2\phi}.
\end{equation}

\end{definition}

\begin{example}
from a vector space $\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  $ into the operator subspace $\mathcal{B}%
\left(  \mathcal{H}^{1},\mathbb{C}\right)  \oplus_{\mathbb{C}}\mathcal{B}%
\left(  \mathbb{C},\mathcal{H}^{1}\right)  $
\begin{equation}
\Upsilon_{\phi\varphi}:\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \hookrightarrow\mathcal{B}\left(
\mathcal{H}^{1},\mathcal{H}^{0}\right)  \oplus_{\mathbb{C}}\mathcal{B}\left(
\mathcal{H}^{0},\mathcal{H}^{1}\right)  \equiv\mathcal{B}\left(
\mathcal{H}^{1},\mathbb{C}\right)  \oplus_{\mathbb{C}}\mathcal{B}\left(
\mathbb{C},\mathcal{H}^{1}\right)
\end{equation}
is given by
\end{example}

\begin{definition}
\begin{enumerate}
\item
\begin{equation}
\Upsilon_{\phi\varphi}:\left\vert v\right\rangle \rightarrow\left\vert
v\right\rangle \left\langle \phi\right\vert
\end{equation}
and

\item
\begin{equation}
\Upsilon_{\phi\varphi}\left(  \left\vert \sigma_{\varphi}\left(  v\right)
\right\rangle \right)  \rightarrow\left\vert \phi\right\rangle \left\langle
v\right\vert =\Upsilon_{\varphi}\left(  \left\vert v\right\rangle \right)
^{\dagger}.
\end{equation}

\end{enumerate}
\end{definition}

\begin{remark}
The action of $\digamma_{\left\vert {}\right\rangle }$ on both the complex
conjugate space $\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ and the
space $\mathcal{H}^{1}$ produces the dual space $\mathcal{H}^{1d}.$ Then the
action of $\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}$ on $\mathcal{H}^{1}%
\otimes_{\mathbb{C}}\mathcal{H}^{1d}$ produces operators belonging to
$\mathcal{B}\left(  \mathcal{H}^{1}\right)  $, which can then be second
quantized i.e.
\begin{equation}
\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \overset{I_{\mathcal{H}^{1}}\oplus_{\mathbb{C}}\digamma
_{\left\vert {}\right\rangle }=\Upsilon_{\phi}}{-----\rightarrow}%
\mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{1d}\overset{\Xi_{\mathcal{H}%
^{1}\mathcal{H}^{1d}}}{------\rightarrow}\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  \overset{\Gamma}{\rightarrow}\mathcal{F}_{1}.
\end{equation}

\end{remark}

\begin{remark}
Hence $\Upsilon_{\phi}$ embeds $\mathcal{H}^{1}\oplus_{\mathbb{C}}%
\mathcal{H}^{1d}$ into $\mathcal{F}$
\begin{equation}
\mathcal{F}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
=\mathcal{B}\left(  {\large \wedge}\left(  \mathcal{H}^{1}\right)  \right)  .
\end{equation}

\end{remark}

\begin{definition}
Second Quantization of a Hilbert space
\begin{align}
\Upsilon_{\phi}  &  :\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \rightarrow\mathcal{F}_{1}\\
\Upsilon_{\phi}  &  =\Gamma\circ\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}.
\end{align}

\end{definition}

\begin{remark}
The maps $\Phi_{\varphi}$ involves the second quantization / generalized
expansion map $\Gamma$, the second quantization of a Hilbert space map
$\Upsilon$ and the conjugate Hilbert space to dual Hilbert space map
$\digamma_{\varphi}$
\begin{equation}
\Upsilon_{\phi}:\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \rightarrow\mathcal{F}_{1}\subset\mathcal{F}.
\end{equation}

\end{remark}

\begin{remark}
The $\Upsilon_{\phi}$ isomorphism can be extended to the exterior algebra
generated by $\mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{d1}$
\begin{equation}
\boxtimes\Upsilon_{\phi}:%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{d1}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}_{\mathbb{C}}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  \rightarrow\mathcal{F=}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{F}_{1}\right)  =\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The $\Upsilon_{\phi}$ isomorphism can be extended to
\begin{equation}
\boxtimes\left(  \Upsilon_{\phi}\right)  :%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{d1}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The second quantization map
\begin{equation}
\Gamma:\mathcal{F\rightarrow F}%
\end{equation}
has in particular the action
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{0}\right)
\oplus_{\mathbb{C}}\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{1}\right)
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{1},\mathcal{H}^{0}\right)  \oplus_{\mathbb{C}%
}\mathcal{B}\left(  \mathcal{H}^{0},\mathcal{H}^{1}\right)  =\Upsilon_{\phi
}\left\{  \mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right\}  =\Upsilon_{\phi}\left\{  \mathcal{H}%
^{1}\oplus_{\mathbb{C}}\mathcal{H}^{1d}\right\}
\end{equation}


\item
\begin{align}
\Gamma\left(  \overset{}{\left\vert \phi\right\rangle \left\langle \varphi
_{j}\right\vert }\right)   &  =\Gamma\left(  \Upsilon_{\phi}\left(
\left\langle \varphi_{j}\right\vert \right)  \right)  =a_{j}\in\mathcal{F}%
_{1}\\
\Gamma\left(  \overset{}{\left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert }\right)   &  =\Gamma\left(  \Upsilon_{\phi}\left(  \left\vert
\varphi_{j}\right\rangle \right)  \right)  =a_{j}^{\dagger}\in\mathcal{F}_{1}.
\end{align}


\item
\begin{equation}
\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle \phi\right\vert
\right)  =\Gamma\left(  \left\vert \phi\right\rangle \left\langle \varphi
_{j}\right\vert \right)  ^{\dagger}.
\end{equation}

\end{enumerate}
\end{remark}

\begin{remark}
The map $\Phi_{\varphi}$
\begin{align}
\Phi_{\varphi}\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi11} & \Phi_{\varphi12}\\
\Phi_{\varphi21} & \Phi_{\varphi22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \mathcal{R}_{\varphi}\left(  \Phi_{\varphi}\right)  =\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \mathbf{\varphi}\right)  \right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{\varphi}\right)  \Phi_{\varphi11}+\sigma_{\varphi}\left(
\mathbf{\varphi}\right)  \Phi_{\varphi21} & \left(  \mathbf{\varphi}\right)
\Phi_{\varphi12}+\sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\Phi_{\varphi22}%
\end{array}
\right)  .
\end{align}

\end{remark}

\begin{remark}
In particular \emph{standard second quantiztion} is given by the block
diagonal Bogoliubov maps $\Phi_{\varphi}$
\begin{align}
\Phi_{\varphi}\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \mathbf{\varphi}\right)  \right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi11} & \mathbb{O}\\
\mathbb{O} & \Phi_{\varphi22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{\varphi}\right)  \Phi_{\varphi11} & \sigma_{\varphi}\left(
\mathbf{\varphi}\right)  \Phi_{\varphi22}%
\end{array}
\right)  ,
\end{align}
where
\begin{equation}
\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \mathbf{\varphi}\right)
\right)  =\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  ^{\dagger}.
\end{equation}

\end{remark}

\begin{remark}
In particular creation and annihilation operators $\left\{  \mathbf{a}%
^{\dagger},\mathbf{a}\right\}  $ are given by
\begin{align}
\Phi_{\varphi}\left(  \overset{}{\left(  \mathbf{\varphi},\mathbf{0}\right)
}\right)   &  =\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\mathbf{0}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{\varphi}\right)  \Phi_{\varphi11}\  & \ \mathbf{0}%
\end{array}
\right)  =\mathbf{a}^{\dagger}\ \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{0}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi11} & \mathbb{O}\\
\mathbb{O} & \Phi_{\varphi22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{\varphi}\right)  \Phi_{\varphi11} & \left(  \mathbf{0}\right)
\Phi_{\varphi22}%
\end{array}
\right) \\
\Phi_{\varphi}\left(  \overset{}{\left(  \mathbf{0},\sigma_{\varphi}\left(
\ \mathbf{\varphi}\right)  \right)  }\right)   &  =\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{0}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \ \mathbf{\varphi}\right)  \right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \sigma_{\varphi}\left(  \ \mathbf{\varphi}\right)  \Phi
_{\varphi22}%
\end{array}
\right)  =\mathbf{a}\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \sigma_{\varphi}\left(  \ \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi11} & \mathbb{O}\\
\mathbb{O} & \Phi_{\varphi22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{0}\right)  \Phi_{\varphi11} & \sigma_{\varphi}\left(
\ \mathbf{\varphi}\right)  \Phi_{\varphi22}%
\end{array}
\right)  .
\end{align}
i.e.%
\begin{align}
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)   &  =\mathbf{a}^{\dagger}%
=\sum_{1\leq k\leq r}\left\vert a_{k}^{\dagger}\right\rangle \left\langle
\varphi_{k}\right\vert \left\vert \mathbf{\varphi}\right\rangle =\sum_{1\leq
k\leq r}\left\vert \Gamma\left(  \left\vert \varphi_{k}\right\rangle
\left\langle \phi\right\vert \right)  \right\rangle \left\langle \varphi
_{k}\right\vert \left\vert \mathbf{\varphi}\right\rangle \ \\
\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \ \mathbf{\varphi}\right)
\right)   &  =\mathbf{a}=\sum_{1\leq k\leq r}\left\vert a_{k}\right\rangle
\left\langle \varphi_{k}\right\vert \left\vert \sigma_{\varphi}\left(
\ \mathbf{\varphi}\right)  \right\rangle =\sum_{1\leq k\leq r}\left\vert
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \varphi_{k}\right\vert
\right)  \right\rangle \left\langle \sigma_{\varphi}\left(  \varphi
_{k}\right)  \right\vert \left\vert \sigma_{\varphi}\left(  \ \mathbf{\varphi
}\right)  \right\rangle \
\end{align}
giving
\begin{equation}
\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \ \mathbf{\varphi}\right)
\right)  =\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  ^{\dagger}.
\end{equation}

\end{remark}

\begin{remark}
Complex linearatity is shown by
\begin{align}
\Phi_{\varphi}\left(  \left(  \eta_{j}\varphi_{j}+\eta_{k}\varphi
_{k},0\right)  \right)   &  =\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \mathbf{\varphi}\right)  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
0\\
\eta_{j}\\
\vdots\\
\eta_{k}\\
0
\end{array}
\right) \\
\mathbf{0}%
\end{array}
\right)  =\eta_{j}a_{j}^{\dagger}+\eta_{k}a_{k}^{\dagger}\\
\Phi_{\varphi}\left(  \left(  0,\sigma_{\varphi}\left(  \eta_{j}\varphi
_{j}+\eta_{k}\varphi_{k}\right)  \right)  \right)   &  =\Phi_{\varphi}\left(
0,\overline{\eta_{j}}\sigma_{\varphi}\left(  \varphi_{j}\right)
+\overline{\eta_{k}}\sigma_{\varphi}\left(  \varphi_{k}\right)  \right)
=\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \mathbf{\varphi}\right)  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{0}\\
\left(
\begin{array}
[c]{c}%
0\\
\overline{\eta_{j}}\\
\vdots\\
\overline{\eta_{k}}\\
0
\end{array}
\right)
\end{array}
\right)  =\overline{\eta_{j}}a_{j}+\overline{\eta_{k}}a_{k}.
\end{align}

\end{remark}

\begin{remark}
Recall in general the map from $\mathcal{H}^{1}\oplus_{\mathbb{C}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ to $\mathcal{F}_{1}$ has
the matrix representation
\begin{equation}
\Phi_{\varphi}\left(  \mathbf{\varphi},\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  =\left(  \mathbf{\varphi},\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  \mathcal{R}_{\varphi}\left(
\Phi_{\varphi}\right)  =\left(  \mathbf{\varphi},\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{W}_{r}}\left(  g\right) \\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{X}_{r}}\left(  g\right)
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{notation}
Three different bases of $\mathcal{F}$ are%
\begin{align}
{\huge x}  &  =\left\{  \left.  {\huge x}_{mn}\right\vert 0\leq m,n\leq
r\right\}  =\left\{  \left.  \mathbf{x}_{1m}\mathbf{x}_{2n}\right\vert 0\leq
m,n\leq r\right\} \\
{\huge a}  &  =\left\{  \left.  {\huge a}_{mn}\right\vert 0\leq m,n\leq
r\right\}  =\left\{  \left.  \mathbf{a}_{m}^{\dagger}\mathbf{a}_{n}\right\vert
0\leq m,n\leq r\right\} \\
{\huge \varphi}  &  =\left\{  \left.  {\huge \varphi}_{mn}\right\vert 0\leq
m,n\leq r\right\}  =\left\{  \left.  \left\vert \mathbf{\varphi}%
_{m}\right\rangle \left\langle \mathbf{\varphi}_{n}\right\vert \right\vert
0\leq m,n\leq r\right\}  .
\end{align}

\end{notation}

\begin{remark}
$\mathcal{F}_{1}$ can be expanded in terms of the bases $\left\{
\mathbf{x}\right\}  \equiv$ $\left\{  \mathbf{x}_{1}\mathbf{x}_{2}\right\}  $
and $\left\{  \mathbf{a}^{\dagger}\right\}  \equiv\left\{  \mathbf{a}%
_{1}^{\dagger},\mathbf{a}_{1}\right\}  $%
\begin{equation}
\mathcal{F}_{1}={\huge a}_{10}+{\huge a}_{01}={\huge x}_{10}+{\huge x}%
_{01}=\mathbf{x}_{11}{\large +}_{\mathbb{C}}\mathbf{x}_{21}=\mathbf{a}%
_{1}^{\dagger}{\large +}_{\mathbb{C}}\mathbf{a}_{1}.
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\mathcal{H}^{\oplus1}=\operatorname{Re}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \oplus_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  =\left(  \mathcal{H}^{1}+_{\mathbb{R}%
}\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)  \oplus\left(
\mathcal{H}^{1}-_{\mathbb{R}}\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\right)  .
\end{equation}

\end{lemma}

Bogolubion maps $\Phi_{\varphi}$ have the property
\begin{align}
\Phi_{\varphi}  &  :\operatorname{Re}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \rightarrow\left\{  \mathbf{x}_{11}\right\}  =\left\{  \frac
{1}{\sqrt{2}}\left(  \mathbf{a}_{1}^{\dagger}+\mathbf{a}_{1}\right)  \right\}
\\
\Phi_{\varphi}  &  :\operatorname*{iIm}\nolimits_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \rightarrow\left\{  \mathbf{x}_{21}\right\}
=\left\{  \frac{i}{\sqrt{2}}\left\{  \mathbf{a}_{1}^{\dagger}-\mathbf{a}%
_{1}\right\}  \right\}  .
\end{align}


\begin{remark}%
\begin{equation}
\left(  \mathbf{x}_{1},\mathbf{x}_{2}\right)  =K_{2r}\left(  \mathbf{a}%
_{1}^{\dagger},\mathbf{a}_{1}\right)  =\left(  \mathbf{a}_{1}^{\dagger
},\mathbf{a}_{1}\right)  \mathbb{K}_{2r}=\left(  \mathbf{a}_{1}^{\dagger
},\mathbf{a}_{1}\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  =\left(  \mathbf{a}_{1}^{\dagger},\mathbf{a}_{1}\right)
\mathcal{R}_{\varphi}\left(  K_{2r}\right)
\end{equation}


$\lceil$%
\begin{equation}
\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
2\mathbb{I}_{r} & \mathbb{O}_{r}\\
\mathbb{O}_{r} & 2\mathbb{I}_{r}%
\end{array}
\right)  =\mathbb{I}_{2r}%
\end{equation}%
\begin{equation}
\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
i\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & 2\mathbb{I}_{r}\\
2\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}
\right)  =\mathbb{J}_{2r}%
\end{equation}
hence
\begin{equation}
K_{2r}\in U\left(  2r\right)
\end{equation}
however
\begin{equation}
K_{2r}\notin O\left(  2r,\mathbb{R}\right)  .
\end{equation}
$\rfloor$
\end{remark}

\begin{remark}
The linear map $\Phi_{\varphi}$
\begin{equation}
\Phi_{\varphi}:\mathcal{H}^{\oplus1}\rightarrow\mathcal{F}_{1}%
\end{equation}
induces the maps
\begin{align}
\boxtimes\left(  \Phi_{\varphi}\right)   &  :%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{\oplus1}\right)  \rightarrow\mathcal{F\equiv B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \equiv\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right) \\
\boxtimes^{n}\Phi_{\varphi}  &  :%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{\oplus1}\right)  \rightarrow\mathcal{F}_{n}=%
%TCIMACRO{\tbigoplus \limits_{m_{1}+m_{2}=n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{m_{1}+m_{2}=n}}
%EndExpansion
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \mathbf{x}_{1m_{1}%
}\mathbf{x}_{2m_{2}}\right\}  =%
%TCIMACRO{\tbigoplus \limits_{m_{1}+m_{2}=n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{m_{1}+m_{2}=n}}
%EndExpansion
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \mathbf{a}_{m_{1}}^{\dagger
}\mathbf{a}_{m_{2}}\right\}  .
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{\oplus1}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \Phi_{\varphi}\left\{  \mathcal{H}^{1}\oplus_{\mathbb{C}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  \right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \Phi_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)
\widehat{\otimes}_{\mathbb{C}}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \Phi_{\varphi}\left\{  \sigma_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \right\}  \right)  \cong\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  \equiv\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\boxtimes\left(  \Phi_{\varphi}\right)  \circ\mathcal{\Pi}_{\mathcal{H}%
^{\oplus}}=\left(  \ \widehat{\Pi}_{\mathcal{F}}\circ\boxtimes\right)  \left(
\Phi_{\varphi}\right)  .
\end{equation}

\end{remark}

\begin{remark}
One can consider the following representations of $O\left(  2r,\mathbb{R}%
\right)  $ by Bogoliubov maps$:$
\end{remark}

\begin{enumerate}
\item
\begin{enumerate}
\item
\begin{equation}
\mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}:O\left(  2r,\mathbb{R}\right)
\rightarrow\mathcal{B}\left(  \mathcal{H}_{\varphi}^{\oplus1}\right)
=\mathcal{B}\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right)
\end{equation}
given by
\begin{equation}
\mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(  g\right)  \left(
\mathbf{\varphi},\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
=\left(  \mathbf{\varphi},\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\right)  \mathcal{R}_{\varphi}\left(  \mathcal{\Pi}_{\mathcal{H}_{\varphi
}^{\oplus1}}\left(  g\right)  \right)  =\left(  \mathbf{\varphi}%
,\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{V}_{r}}\left(  g\right) \\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{U}_{r}}\left(  g\right)
\end{array}
\right)
\end{equation}
and

\item
\begin{align}
&  \mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(  g\right)  \left(
\overset{}{\left(  \mathbf{\varphi},\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  \mathcal{R}_{\varphi}\left(  K_{2r}\right)  }\right) \\
&  =\mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(  g\right)  \left(
\mathbf{\varphi},\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  =\mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(  g\right)
\left(  \frac{1}{\sqrt{2}}\left(  \mathbf{\varphi+}\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  ,\frac{i}{\sqrt{2}}\left(  \sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  -\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  \right) \\
&  =\left(  \frac{1}{\sqrt{2}}\left(  \mathbf{\varphi+}\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  ,\frac{i}{\sqrt{2}}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  -\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  \right)  \mathcal{R}_{\operatorname{Re}%
\varphi\operatorname{Im}\varphi}\left(  \mathcal{\Pi}_{\mathcal{H}_{\varphi
}^{\oplus1}}\left(  g\right)  \right) \\
&  =\left(  \frac{1}{\sqrt{2}}\left(  \mathbf{\varphi+}\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  ,\frac{i}{\sqrt{2}}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  -\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  \right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{V}_{r}}\left(  g\right) \\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{U}_{r}}\left(  g\right)
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right) \\
&  =\left(  \frac{1}{\sqrt{2}}\left(  \mathbf{\varphi+}\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  ,\frac{i}{\sqrt{2}}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  -\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  \right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{V}_{r}}\left(  g\right) \\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{U}_{r}}\left(  g\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right) \\
&  =\left(  \frac{1}{\sqrt{2}}\left(  \mathbf{\varphi+}\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)  ,\frac{i}{\sqrt{2}}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  -\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right)  \right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \overset{}{\mathbb{U}_{r}\left(  g\right)
+\mathbb{V}_{r}\left(  g\right)  }\right)  & -\operatorname{Im}\left(
\overset{}{\mathbb{U}_{r}\left(  g\right)  +\mathbb{V}_{r}\left(  g\right)
}\right) \\
\operatorname{Im}\left(  \overset{}{\mathbb{U}_{r}\left(  g\right)
-\mathbb{V}_{r}\left(  g\right)  }\right)  & \operatorname{Re}\left(
\overset{}{\mathbb{U}_{r}\left(  g\right)  -\mathbb{V}_{r}\left(  g\right)
}\right)
\end{array}
\right)  ,
\end{align}
i.e.
\begin{equation}
\mathcal{R}_{\operatorname{Re}\varphi\operatorname{Im}\varphi}\left(
\mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(  g\right)  \right)
=\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \overset{}{\mathbb{U}_{r}\left(  g\right)
+\mathbb{V}_{r}\left(  g\right)  }\right)  & -\operatorname{Im}\left(
\overset{}{\mathbb{U}_{r}\left(  g\right)  +\mathbb{V}_{r}\left(  g\right)
}\right) \\
\operatorname{Im}\left(  \overset{}{\mathbb{U}_{r}\left(  g\right)
-\mathbb{V}_{r}\left(  g\right)  }\right)  & \operatorname{Re}\left(
\overset{}{\mathbb{U}_{r}\left(  g\right)  -\mathbb{V}_{r}\left(  g\right)
}\right)
\end{array}
\right)  \in\mathcal{M}\left(  2r,\mathbb{R}\right)  ,
\end{equation}
while
\begin{equation}
\mathcal{R}_{\varphi}\left(  \mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}%
}\left(  g\right)  \right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{U}_{r}\left(  g\right)  & \overline{\mathbb{V}_{r}\left(  g\right)
}\\
\mathbb{V}_{r}\left(  g\right)  & \overline{\mathbb{U}_{r}\left(  g\right)  }%
\end{array}
\right)  \in\mathcal{M}\left(  2r,\mathbb{C}\right)  .
\end{equation}

\end{enumerate}

$\lceil$ We check this using scalers
\begin{align}
&  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}} & \frac{1}{\sqrt{2}}\\
-\frac{i}{\sqrt{2}} & \frac{i}{\sqrt{2}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
u & \overline{v}\\
v & \overline{u}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}} & \frac{i}{\sqrt{2}}\\
\frac{1}{\sqrt{2}} & \frac{-i}{\sqrt{2}}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
1 & 1\\
-i & i
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
u & \overline{v}\\
v & \overline{u}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & i\\
1 & -i
\end{array}
\right) \\
&  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
u+v & \overline{v}+\overline{u}\\
iv-iu & i\overline{u}-i\overline{v}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & i\\
1 & -i
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
u+v+\overline{v}+\overline{u} & i\left(  u+v-\overline{v}-\overline{u}\right)
\\
i\left(  v-u+\overline{u}-\overline{v}\right)  & -v+u+\overline{u}%
-\overline{v}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  u+v\right)  & -\operatorname{Im}\left(  u+v\right) \\
\operatorname{Im}\left(  u-v\right)  & \operatorname{Re}\left(  u-v\right)
\end{array}
\right)  ,
\end{align}
where we have used%
\begin{align}
i\left(  x+iy\right)  -i\left(  x-iy\right)   &  =ix-y-ix-y=-2y\\
i\left(  x-iy\right)  -i\left(  x+iy\right)   &  =ix+y-ix+y=2y\\
\left(  x+iy\right)  +\left(  x-iy\right)   &  =2x.
\end{align}
Hence
\begin{equation}
\left(
\begin{array}
[c]{cc}%
u & \overline{v}\\
v & \overline{u}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}} & \frac{i}{\sqrt{2}}\\
\frac{1}{\sqrt{2}} & \frac{-i}{\sqrt{2}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  u+v\right)  & -\operatorname{Im}\left(  u+v\right) \\
\operatorname{Im}\left(  u-v\right)  & \operatorname{Re}\left(  u-v\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}} & \frac{1}{\sqrt{2}}\\
-\frac{i}{\sqrt{2}} & \frac{i}{\sqrt{2}}%
\end{array}
\right)  .
\end{equation}
$\rfloor$

\item The representations $\Pi_{\mathcal{F}_{1}}\left(  O\left(
2r,\mathbb{R}\right)  \right)  $%
\begin{equation}
\Pi_{\mathcal{F}_{1}}:O\left(  2r,\mathbb{R}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{1}\right)
\cong\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{1}\right)
\otimes_{\mathbb{C}}\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}%
^{1}\right)  .
\end{equation}


\item The adjoint representations $\widehat{\Pi}_{\mathcal{F}_{1}}\left(
O\left(  2r,\mathbb{R}\right)  \right)  $%
\begin{align}
\widehat{\Pi}_{\mathcal{F}_{1}}  &  :O\left(  2r,\mathbb{R}\right)
\rightarrow\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)
\right)  \equiv\mathcal{B}\left(  \mathcal{F}_{1}\right) \\
\widehat{\Pi}_{\mathcal{F}_{1}}  &  =\operatorname*{Adj}\circ\Pi
_{\mathcal{F}_{1}}\\
\ \widehat{\Pi}_{\mathcal{F}_{1}}  &  :O\left(  2r,\mathbb{R}\right)
\rightarrow\mathcal{B}\left(  \mathcal{F}_{1}\right)  \cong\mathcal{B}\left(
\Phi_{\varphi}\left\{  \mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right\}  \right)  .
\end{align}


\item The reducible representation $\Pi_{\mathcal{F}}\left(  O\left(
2r,\mathbb{R}\right)  \right)  $
\begin{align}
\Pi_{\mathcal{F}}  &  :O\left(  2r,\mathbb{R}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \ \equiv\mathcal{B}%
\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \right)  \equiv\mathcal{F}\\
\widehat{\Pi}_{\mathcal{F}}  &  :O\left(  2r,\mathbb{R}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  \equiv\mathcal{B}\left(  \mathcal{F}\right) \\
\widehat{\Pi}_{\mathcal{F}}  &  =\operatorname*{Adj}\circ\Pi_{\mathcal{F}}\\
\ \widehat{\Pi}_{\mathcal{F}}  &  :O\left(  2r,\mathbb{R}\right)
\rightarrow\mathcal{B}\left(  \mathcal{F}\right)  \equiv\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{F}_{1}\right)  \right)  =\mathcal{B}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \Phi_{\varphi}\left\{  \mathcal{H}^{1}\oplus_{\mathbb{C}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  \right)  \right)
.
\end{align}


\item The representations $\Pi_{\mathcal{F}}$ $\left(  O\left(  2r,\mathbb{R}%
\right)  \right)  $ and $\ \widehat{\Pi}_{\mathcal{F}}\left(  O\left(
2r,\mathbb{R}\right)  \right)  $ are reducible and decompose as
\begin{align}
\Pi_{\mathcal{F}}  &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\Pi_{\mathcal{F}_{n}}\\
\ \widehat{\Pi}_{\mathcal{F}}  &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r\ }}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r\ }}
%EndExpansion
\widehat{\Pi}_{\mathcal{F}_{n}},
\end{align}
where $\left\{  \left.  \Pi_{\mathcal{F}_{n}}\left(  O\left(  2r,\mathbb{R}%
\right)  \right)  \right\vert 0\leq n\leq2r\right\}  $ and $\left\{  \left.
\widehat{\Pi}_{\mathcal{F}_{n}}\left(  O\left(  2r,\mathbb{R}\right)  \right)
\right\vert 0\leq n\leq2r\right\}  $ are irreducible.

\item $\Pi_{\mathcal{F}}$ $\left(  O\left(  2r,\mathbb{R}\right)  \right)  $
is reduced by $\mathcal{F}_{1}$
\begin{align}
\ \widehat{\Pi}_{\mathcal{F}}\left(  g\right)  \left(  \mathbf{a}_{1}%
^{\dagger},\mathbf{a}_{1}\right)   &  \equiv\Pi_{\mathcal{F}}\left(  g\right)
\left(  \mathbf{a}^{\dagger},\mathbf{a}\right)  \Pi_{\mathcal{F}}\left(
g\right)  ^{\dagger}=\Pi_{\mathcal{F}}\left(  g\right)  \Phi_{\varphi}\left(
\overset{}{\left(  \mathbf{\varphi,}\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  }\right)  \Pi_{\mathcal{F}}\left(  g\right)  ^{\dagger
}=\Phi_{\varphi}\left(  \mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(
g\right)  \left(  \overset{}{\mathbf{\varphi,}\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  }\right)  \right) \\
&  =\Phi_{\varphi}\left(  \left(  \overset{}{\mathbf{\varphi,}\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  }\right)  \mathcal{R}_{\varphi}\left(
\mathcal{\Pi}_{\mathcal{H}_{\varphi}^{\oplus1}}\left(  g\right)  \right)
\right)  =\ \widehat{\Pi}_{\mathcal{F}}\left(  g\right)  \Phi_{\varphi}\left(
\overset{}{\left(  \mathbf{\varphi,}\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  }\right) \\
&  =\left(  \overset{}{\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)
,\Phi_{\varphi2}\left(  \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\right)  }\right)  \mathcal{R}_{\varphi}\left(  \mathcal{\Pi}_{\mathcal{H}%
_{\varphi}^{\oplus1}}\left(  g\right)  \right)  =\ \widehat{\Pi}_{\mathcal{F}%
}\left(  g\right)  \left(  \overset{}{\Phi_{\varphi1}\left(  \mathbf{\varphi
}\right)  ,\Phi_{\varphi2}\left(  \sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  }\right)  .
\end{align}

\end{enumerate}

\begin{remark}
The algebraic $\mathbb{C}$ direct sum $\oplus_{\mathbb{C}}$of two $\mathbb{C}$
subspaces $V_{1}$ and $V_{2}$ is a subset of $V_{1}\times V_{2}$ that has the
properties
\begin{align}
\alpha\left(  v_{1},v_{2}\right)   &  =\left(  \alpha v_{1},\alpha
v_{2}\right) \\
\left(  v_{1},v_{2}\right)  +\left(  w_{1},w_{2}\right)   &  =\left(
v_{1}+w_{1},v_{2}+w_{2}\right)
\end{align}
hence
\begin{equation}
\alpha\left(  v_{1},v_{2}\right)  +\beta\left(  w_{1},w_{2}\right)  =\left(
\alpha v_{1}+\beta w_{1},\alpha v_{2}+\beta w_{2}\right)  ,
\end{equation}
where
\begin{equation}
\alpha,\beta\in\mathbb{C}.
\end{equation}
If $V_{1}$ and $V_{2}$ are normed spaces then the direct sum norm is
\begin{equation}
\left\Vert \left(  v_{1},v_{2}\right)  \right\Vert _{V_{1}\oplus_{\mathbb{C}%
}V_{2}}=\left\Vert v_{1}\right\Vert _{V_{1}}+\left\Vert v_{2}\right\Vert
_{V_{2}}.
\end{equation}
The complex subspaces $V_{1}$ and $V_{2}$ contain real subspaces produced by
real linear combinations of sets of vectors contained in those subspaces. Real
subspaces of the complex direct sum are produced by the real direct sum of
real subspaces of $V_{1}$ and $V_{2}.$
\end{remark}

Any vector $v\in\mathcal{H}^{1}$ can be expressed as%
\begin{gather*}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert \varphi
_{j}\right\rangle \mathcal{R}_{\varphi}\left(  v\right)  _{j}=\sum_{1\leq
j\leq r}\left\vert \varphi_{j}\right\rangle \left\{  \operatorname{Re}\left(
\mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)  +i\operatorname{Im}\left(
\mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)  \right\}  =\sum_{1\leq
j\leq r}\left\vert \varphi_{j}\right\rangle \operatorname{Re}\left(
\mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)  +i\sum_{1\leq j\leq
r}\left\vert \varphi_{j}\right\rangle \operatorname{Im}\left(  \mathcal{R}%
_{\varphi}\left(  v\right)  _{j}\right) \\
=\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \left\{
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right)  _{j}+i\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(
v\right)  \right)  _{j}\right\}  =\sum_{1\leq j\leq r}\left\vert \varphi
_{j}\right\rangle \mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi
}\left(  v\right)  \right)  _{j}+i\sum_{1\leq j\leq r}\left\vert \varphi
_{j}\right\rangle \mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi
}\left(  v\right)  \right)  _{j}\\
=\operatorname{Re}_{\varphi}\left(  v\right)  +i\operatorname{Im}_{\varphi
}\left(  v\right)  =\operatorname{Re}_{\varphi}\left(  v\right)
+\operatorname*{iIm}\nolimits_{\varphi}\left(  v\right)
\end{gather*}
wrt to a conb $\left\{  \mathbf{\varphi}\right\}  $ of $\mathcal{H}^{1},$
where
\begin{align}
\operatorname{Re}_{\varphi}\left(  v\right)   &  =\sum_{1\leq j\leq
r}\left\vert \varphi_{j}\right\rangle \operatorname{Re}\left(  \mathcal{R}%
_{\varphi}\left(  v\right)  _{j}\right)  =\sum_{1\leq j\leq r}\left\vert
\varphi_{j}\right\rangle \mathcal{R}_{\varphi}\left(  \operatorname{Re}%
_{\varphi}\left(  v\right)  \right)  _{j}\\
\operatorname{Im}_{\varphi}\left(  v\right)   &  =\sum_{1\leq j\leq
r}\left\vert \varphi_{j}\right\rangle \operatorname{Im}\left(  \mathcal{R}%
_{\varphi}\left(  v\right)  _{j}\right)  =\sum_{1\leq j\leq r}\left\vert
\varphi_{j}\right\rangle \mathcal{R}_{\varphi}\left(  \operatorname{Im}%
_{\varphi}\left(  v\right)  \right)  _{j}\\
\operatorname*{iIm}\nolimits_{\varphi}\left(  v\right)   &  =\sum_{1\leq j\leq
r}\left\vert i\varphi_{j}\right\rangle \operatorname{Im}\left(  \mathcal{R}%
_{\varphi}\left(  v\right)  _{j}\right)  =\sum_{1\leq j\leq r}\left\vert
\varphi_{j}\right\rangle \mathcal{R}_{\varphi}\left(  \operatorname*{iIm}%
\nolimits_{\varphi}\left(  v\right)  \right)  _{j},
\end{align}
hence%
\begin{align}
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
&  =\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right)  _{j}\\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
&  =\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)  _{j}\\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
&  =\mathcal{R}_{\varphi}\left(  \operatorname*{iIm}\nolimits_{\varphi}\left(
v\right)  \right)  _{j}\\
1  &  \leq j\leq r.
\end{align}


This leads to the definitions:

\begin{definition}
$\varphi$-real space real Hilbert space $\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $
\begin{equation}
\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  =\mathbb{R}%
\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert \varphi
_{j}\right\rangle \right\vert 1\leq j\leq r\right\}
\end{equation}

\end{definition}

\begin{definition}
$\varphi$-imaginary space real Hilbert space $\operatorname{Im}_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  $
\begin{equation}
\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  =\mathbb{R}%
\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert \varphi
_{j}\right\rangle \right\vert 1\leq j\leq r\right\}
\end{equation}

\end{definition}

Clearly
\begin{equation}
\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
=\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{equation}


\begin{definition}
$\varphi$-imaginary space real Hilbert space $\operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $
\begin{equation}
\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}
=\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
i\varphi_{j}\right\rangle \right\vert 1\leq j\leq r\right\}  .
\end{equation}

\end{definition}

\begin{remark}
The \emph{complex} Hilbert space $\mathcal{H}^{1}$ can be expressed as
\begin{equation}
\mathcal{H}^{1}=\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
+_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  =\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
+_{\mathbb{C}}\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  =\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
+_{\mathbb{C}}\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{equation}

\end{remark}

\begin{remark}
In terms of complexifications
\begin{align}
\mathcal{H}^{1}  &  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  =\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right\} \\
&  =\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\otimes_{\mathbb{R}}\mathbb{C}=\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \otimes_{\mathbb{R}}\mathbb{C}=\operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \otimes_{\mathbb{R}%
}\mathbb{C}.
\end{align}

\end{remark}

\begin{remark}
The \emph{real} Hilbert spaces $\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $ and $\operatorname*{iIm}\nolimits_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $ are \emph{not closed} under complex linear
combinations and
\begin{equation}
\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \oplus
_{\mathbb{C}}\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \neq\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
+_{\mathbb{C}}\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  ,
\end{equation}
as
\begin{equation}
\mathbb{C}\text{-}\dim\left\{  \operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \oplus_{\mathbb{C}}\operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  =2r
\end{equation}
and
\begin{equation}
\mathbb{C}\text{-}\dim\left\{  \operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  +_{\mathbb{C}}\operatorname*{iIm}\nolimits_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right\}  =r.
\end{equation}

\end{remark}

\begin{definition}
One can define \emph{real Hilbert spaces} $\mathcal{H}_{\varphi}^{1}$ and
$\mathcal{H}_{\varphi\mathbb{R}}^{1}$ by the real direct sums
\begin{equation}
\mathcal{H}_{\varphi}^{1}=\operatorname{Re}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \oplus_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  =\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  +_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi
}\left\{  \mathcal{H}^{1}\right\}
\end{equation}
and
\begin{equation}
\mathcal{H}_{\varphi\mathbb{R}}^{1}=\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}\operatorname{Im}_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \neq\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  +_{\mathbb{R}}\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}
\end{equation}
as
\begin{equation}
\mathbb{R}\text{-}\dim\left\{  \operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}\operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  =\mathbb{R}%
\text{-}\dim\left\{  \operatorname{Re}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \oplus_{\mathbb{R}}\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right\}  =2r,
\end{equation}
while
\begin{equation}
\mathbb{R}\text{-}\dim\left\{  \operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  +_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right\}  =\mathbb{R}\text{-}\dim\left\{
\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  +_{\mathbb{R}%
}\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\}  =r.
\end{equation}

\end{definition}

\begin{remark}
The decomposition of the inner product $\left\langle \left.  v\right\vert
w\right\rangle $ in $\mathcal{H}^{1}$
\begin{align}
\left\langle \left.  v\right\vert w\right\rangle  &  =\operatorname{Re}%
\left\langle \left.  v\right\vert w\right\rangle +i\operatorname{Im}%
\left\langle \left.  v\right\vert w\right\rangle =\left(  \left.  v\right\vert
w\right)  +i\left\{  \left.  v\right\vert w\right\} \\
&  =\left(  \left.  \operatorname{Re}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Re}_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}%
_{\varphi}}+\left(  \left.  \operatorname{Im}_{\varphi}\left(  v\right)
\right\vert \operatorname{Im}_{\varphi}\left(  w\right)  \right)
_{\operatorname{Im}_{\varphi}}+i\left(  \left(  \left.  \operatorname{Re}%
_{\varphi}\left(  v\right)  \right\vert \operatorname{Im}_{\varphi}\left(
w\right)  \right)  _{\operatorname{Re}_{\varphi}}-\left(  \left.
\operatorname{Im}_{\varphi}\left(  v\right)  \right\vert \operatorname{Re}%
_{\varphi}\left(  w\right)  \right)  _{\operatorname{Im}_{\varphi}}\right) \\
&  =\left(  \left.  \operatorname{Re}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Re}_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}%
_{\varphi}}+\left(  \left.  \operatorname{Im}_{\varphi}\left(  v\right)
\right\vert \operatorname{Im}_{\varphi}\left(  w\right)  \right)
_{\operatorname*{iIm}\nolimits_{\varphi}}+i\left(  \left(  \left.
\operatorname{Re}_{\varphi}\left(  v\right)  \right\vert \operatorname{Im}%
_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}_{\varphi}}-\left(
\left.  \operatorname{Im}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Re}_{\varphi}\left(  w\right)  \right)  _{\operatorname*{iIm}%
\nolimits_{\varphi}}\right)
\end{align}
for any basis $\left\{  \mathbf{\varphi}\right\}  $ of $\mathcal{H}^{1}.$
\end{remark}

\begin{lemma}
The bilinear form $\left(  \left.  {}\right\vert \right)  $
\begin{equation}
\left(  \left.  {}\right\vert \right)  :\mathcal{H}^{1}\times\mathcal{H}%
^{1}\rightarrow\mathbb{R}%
\end{equation}
is complex symmetrc and complex bilinear but real valued.
\end{lemma}

\begin{lemma}
The bilinear form $\left\{  \left.  {}\right\vert \right\}  $
\begin{equation}
\left\{  \left.  {}\right\vert \right\}  :\mathcal{H}^{1}\times\mathcal{H}%
^{1}\rightarrow\mathbb{R}%
\end{equation}
is symplectic and complex bilinear but real valued.
\end{lemma}

\begin{remark}%
\begin{gather}
z=re^{i\theta}=r\left(  \cos\theta+i\sin\theta\right) \\
\operatorname{Re}\left(  z\right)  =r\cos\theta\\
\operatorname{Im}\left(  z\right)  =r\sin\theta\\
0\leq\theta<2\pi\\
r=\sqrt{\operatorname{Re}\left(  z\right)  ^{2}+\operatorname{Im}\left(
z\right)  ^{2}}\\
\theta=\tan^{-1}\left(  \frac{\operatorname{Im}\left(  z\right)
}{\operatorname{Re}\left(  z\right)  }\right)  \equiv\arctan\left(
\frac{\operatorname{Im}\left(  z\right)  }{\operatorname{Re}\left(  z\right)
}\right)  .
\end{gather}

\end{remark}

\begin{remark}%
\begin{equation}
\left\langle \left.  v\right\vert w\right\rangle =\sqrt{\operatorname{Re}%
\left(  \left\langle \left.  v\right\vert w\right\rangle \right)
^{2}+\operatorname{Im}\left(  \left\langle \left.  v\right\vert w\right\rangle
\right)  ^{2}}\exp i\left(  \tan^{-1}\left(  \frac{\operatorname{Im}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  }{\operatorname{Re}%
\left(  \left\langle \left.  v\right\vert w\right\rangle \right)  }\right)
\right)  .
\end{equation}

\end{remark}

\begin{definition}
\emph{Real valued symmetric inner product} $\left(  \left.  {}\right\vert
\right)  _{\mathbb{R}}$ on the complex space Hilbert space $\mathcal{H}^{1}$%
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{\mathbb{R}}=\operatorname{Re}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  =\sum_{1\leq j\leq
r}\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \operatorname{Re}_{\varphi
}\left(  w_{j}\right)  +\sum_{1\leq j\leq r}\operatorname{Im}_{\varphi}\left(
v_{j}\right)  \operatorname{Im}_{\varphi}\left(  w_{j}\right)  =\left(
\left.  \operatorname{Re}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Re}_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}%
_{\varphi}}+\left(  \left.  \operatorname{Im}_{\varphi}\left(  v\right)
\right\vert \operatorname{Im}_{\varphi}\left(  w\right)  \right)
_{\operatorname{Im}_{\varphi}}%
\end{equation}
for any conb $\left\{  \mathbf{\varphi}\right\}  .$
\end{definition}

\begin{remark}%
\begin{align}
\left\langle \left.  v\right\vert v\right\rangle  &  =\sqrt{\operatorname{Re}%
\left(  \left\langle \left.  v\right\vert v\right\rangle \right)
^{2}+\operatorname{Im}\left(  \left\langle \left.  v\right\vert v\right\rangle
\right)  ^{2}}\exp\left(  \tan^{-1}\left(  \frac{\operatorname{Im}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  }{\operatorname{Re}%
\left(  \left\langle \left.  v\right\vert w\right\rangle \right)  }\right)
\right)  =\sqrt{\operatorname{Re}\left(  \left\langle \left.  v\right\vert
v\right\rangle \right)  ^{2}}\exp\left(  \tan^{-1}\left(  \frac{0}%
{\operatorname{Re}\left(  \left\langle \left.  v\right\vert v\right\rangle
\right)  }\right)  \right) \\
&  =\operatorname{Re}\left(  \left\langle \left.  v\right\vert v\right\rangle
\right)  =\left(  \left.  v\right\vert w\right)  _{\mathbb{R}}.
\end{align}

\end{remark}

\begin{remark}
$\left(  \left.  v\right\vert w\right)  _{\mathbb{R}}$ is \emph{non
degenerate} i.e.
\begin{equation}
\left(  \left.  v\right\vert v\right)  _{\mathbb{R}}=\operatorname{Re}\left(
\left\langle \left.  v\right\vert v\right\rangle \right)  =0\Rightarrow
\left\vert v\right\rangle =0.
\end{equation}

\end{remark}

\begin{remark}
It is real homogeneous on $\mathcal{H}^{1}$ i.e.
\begin{equation}
\left(  \left.  v\right\vert cw\right)  _{\mathbb{R}}=c\left(  \left.
v\right\vert w\right)  _{\mathbb{R}},\,c\in\mathbb{R}.
\end{equation}

\end{remark}

\begin{remark}
$\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}$ is symmetric on
$\mathcal{H}^{1}$ i.e.
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{\mathbb{R}}=\operatorname{Re}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  =\operatorname{Re}%
\left(  \overline{\left\langle \left.  w\right\vert v\right\rangle }\right)
=\operatorname{Re}\left(  \left\langle \left.  w\right\vert v\right\rangle
\right)  =\left(  \left.  w\right\vert v\right)  _{\mathbb{R}}.
\end{equation}

\end{remark}

\begin{remark}
$\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}$ is real linear on
$\mathcal{H}^{1}$%
\begin{align}
\left(  \left.  v\right\vert c_{1}w_{1}+c_{2}w_{2}\right)  _{\mathbb{R}}  &
=\operatorname{Re}\left(  \left\langle \left.  v\right\vert c_{1}w_{1}%
+c_{2}w_{2}\right\rangle \right)  =\operatorname{Re}\left(  \left\langle
\left.  v\right\vert c_{1}w_{1}\right\rangle \right)  +\operatorname{Re}%
\left(  \left\langle \left.  v\right\vert c_{2}w_{2}\right\rangle \right)
=\operatorname{Re}\left(  c_{1}\left\langle \left.  v\right\vert
w_{1}\right\rangle \right)  +\operatorname{Re}\left(  c_{2}\left\langle
\left.  v\right\vert w_{2}\right\rangle \right) \\
&  =c_{1}\operatorname{Re}\left(  \left\langle \left.  v\right\vert
w_{1}\right\rangle \right)  +c_{2}\operatorname{Re}\left(  \left\langle
\left.  v\right\vert w_{2}\right\rangle \right)  =c_{1}\left(  \left.
v\right\vert w_{1}\right)  _{\mathbb{R}}+c_{2}\left(  \left.  v\right\vert
w_{2}\right)  _{\mathbb{R}}%
\end{align}
hence it is real \emph{bilinear} on $\mathcal{H}^{1}.$
\end{remark}

\begin{remark}
$\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}$ is not invariant to
unitary group $U\left(  \mathcal{H}^{1}\right)  $ i.e.
\begin{equation}
\left(  \left.  uv\right\vert uw\right)  _{\mathbb{R}}=\operatorname{Re}%
\left(  \left\langle \left.  uv\right\vert uw\right\rangle \right)  =\left(
\left.  v\right\vert w\right)  _{\mathbb{R}}=\operatorname{Re}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  .\,u\in U\left(
\mathcal{H}^{1}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align*}
\operatorname{Re}\left(  \left\langle \left.  v\right\vert cw\right\rangle
\right)   &  =\operatorname{Re}\left(  c\left\langle \left.  v\right\vert
w\right\rangle \right)  =\operatorname{Re}\left(  \left(  \operatorname{Re}%
\left(  c\right)  +i\operatorname{Im}\left(  c\right)  \right)  \left(
\operatorname{Re}\left\langle \left.  v\right\vert w\right\rangle
+i\operatorname{Im}\left\langle \left.  v\right\vert w\right\rangle \right)
\right) \\
&  =\operatorname{Re}\left(  \operatorname{Re}\left(  c\right)
\operatorname{Re}\left\langle \left.  v\right\vert w\right\rangle
+\operatorname{Re}\left(  c\right)  i\operatorname{Im}\left\langle \left.
v\right\vert w\right\rangle +i\operatorname{Im}\left(  c\right)
\operatorname{Re}\left\langle \left.  v\right\vert w\right\rangle
-\operatorname{Im}\left(  c\right)  \operatorname{Im}\left\langle \left.
v\right\vert w\right\rangle \right) \\
&  =\operatorname{Re}\left(  c\right)  \operatorname{Re}\left\langle \left.
v\right\vert w\right\rangle -\operatorname{Im}\left(  c\right)
\operatorname{Im}\left\langle \left.  v\right\vert w\right\rangle
\neq\operatorname{Re}\left(  c\right)  \operatorname{Re}\left\langle \left.
v\right\vert w\right\rangle \text{ if }\operatorname{Im}\left(  c\right)
\neq0.
\end{align*}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{\mathbb{R}}=\left(  \left.
w\right\vert v\right)  _{\mathbb{R}}%
\end{equation}
and is complex semi bilinear i.e.
\begin{align}
\left(  \left.  v\right\vert c_{1}w_{1}+c_{2}w_{2}\right)  _{\mathbb{R}}  &
=\operatorname{Re}\left(  \left\langle \left.  v\right\vert c_{1}w_{1}%
+c_{2}w_{2}\right\rangle \right)  =\operatorname{Re}\left(  \left\langle
\left.  v\right\vert c_{1}w_{1}\right\rangle +\left\langle \left.
v\right\vert c_{2}w_{2}\right\rangle \right) \\
&  =\operatorname{Re}\left\langle \left.  v\right\vert c_{1}w_{1}\right\rangle
+\operatorname{Re}\left\langle \left.  v\right\vert c_{2}w_{2}\right\rangle
=\left(  \left.  v\right\vert c_{1}w_{1}\right)  _{\mathbb{R}}+\left(  \left.
v\right\vert c_{2}w_{2}\right)  _{\mathbb{R}}.
\end{align}

\end{remark}

\begin{remark}
$\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}$ is of course real
bilinear as it is real symmetric.
\end{remark}

\begin{remark}%
\begin{gather}
\mathcal{H}^{1}=\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\oplus_{\mathbb{R}}i\operatorname{Im}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  =\operatorname{Re}_{\psi}\left\{  \mathcal{H}^{1}\right\}
\oplus_{\mathbb{R}}i\operatorname{Im}_{\psi}\left\{  \mathcal{H}^{1}\right\}
\,\forall\left\{  \left\vert \mathbf{\psi}\right\rangle \right\}  ,\left\{
\left\vert \mathbf{\varphi}\right\rangle \right\} \\
\mathcal{H}_{\mathbb{\varphi}}^{1}=\mathbb{R}\text{-}\operatorname{Re}%
_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}i\mathbb{R}%
\text{-}\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
,\,\left\{  \left\vert \mathbf{\varphi}\right\rangle \right\}  .
\end{gather}

\end{remark}

\begin{remark}
The real bilinear form $\left(  \left.  {}\right\vert _{\mathbb{R}}\right)  $
acting on the complex Hilbert space $\mathcal{H}^{1}$
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}:\mathcal{H}^{1}%
\times\mathcal{H}^{1}\rightarrow\mathbb{R}%
\end{equation}
is a non degenerate real inner product in $\mathcal{H}_{\mathbb{\varphi}}%
^{1}\oplus_{\mathbb{R}}i\mathcal{H}_{\mathbb{\varphi}}^{1}$ and $\mathcal{H}%
_{\mathbb{\varphi}}^{1}\oplus_{\mathbb{R}}\mathcal{H}_{\mathbb{\varphi}}^{1}$
i.e.
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}:\left(  \mathcal{H}%
_{\mathbb{\varphi}}^{1}\oplus_{\mathbb{R}}i\mathcal{H}_{\mathbb{\varphi}}%
^{1}\right)  \times\left(  \mathcal{H}_{\mathbb{\varphi}}^{1}\oplus
_{\mathbb{R}}i\mathcal{H}_{\mathbb{\varphi}}^{1}\right)  \rightarrow\mathbb{R}%
\end{equation}
and
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}:\left(  \mathcal{H}%
_{\mathbb{\varphi}}^{1}\oplus_{\mathbb{R}}\mathcal{H}_{\mathbb{\varphi}}%
^{1}\right)  \times\left(  \mathcal{H}_{\mathbb{\varphi}}^{1}\oplus
_{\mathbb{R}}\mathcal{H}_{\mathbb{\varphi}}^{1}\right)  \rightarrow\mathbb{R}.
\end{equation}

\end{remark}

\begin{remark}
The real bilinear form
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{\mathbb{R}}:\mathcal{H}^{1}%
\times\mathcal{H}^{1}\rightarrow\mathbb{R}%
\end{equation}
is \emph{not complex bilinear}.
\end{remark}

\begin{lemma}%
\begin{equation}
\operatorname{Re}\left(  \left\langle \left.  v\right\vert w_{1}%
-w_{2}\right\rangle \right)  =0\,\forall v\in\mathcal{H}^{1}\Leftrightarrow
w\U{2081} =w\U{2082}
\end{equation}

\end{lemma}

\begin{proof}
\qquad%
\begin{equation}
\operatorname{Re}\left(  \left\langle \left.  v\right\vert w\right\rangle
\right)  =\sum_{1\leq j\leq r}\left\{  \operatorname{Re}\left(  v_{\varphi
j}\right)  \operatorname{Re}\left(  w_{\varphi j}\right)  +\operatorname{Im}%
\left(  v_{\varphi j}\right)  \operatorname{Im}\left(  w_{\varphi j}\right)
\right\}  =\sum_{1\leq j\leq r}\left\{  \left(  \operatorname{Re}_{\varphi
}\left(  v\right)  \right)  _{j}\left(  \operatorname{Re}_{\varphi}\left(
w\right)  \right)  _{j}+\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)  _{j}\left(  \operatorname{Im}_{\varphi}\left(  w\right)  \right)
_{j}\right\}
\end{equation}
and%
\begin{equation}
\operatorname{Re}\left(  \left\langle \left.  v\right\vert w_{1}%
-w_{2}\right\rangle \right)  =\sum_{1\leq j\leq r}\left\{  \operatorname{Re}%
\left(  v_{\varphi j}\right)  \operatorname{Re}\left(  w_{1\varphi
j}-w_{2\varphi j}\right)  +\operatorname{Im}\left(  v_{\varphi j}\right)
\operatorname{Im}\left(  w_{1\varphi j}-w_{2\varphi j}\right)  \right\}  .
\end{equation}
In particular
\begin{equation}
\operatorname{Re}\left(  w_{1\varphi k}-w_{2\varphi k}\right)  =0,\,1\leq
k\leq r
\end{equation}
when one chooses the vectors
\begin{equation}
\left\vert v_{k}\right\rangle =\sum_{1\leq j\leq r}\delta_{kj}%
\operatorname{Re}\left(  v_{j}\right)  \left\vert \varphi_{j}\right\rangle
=\operatorname{Re}\left(  v_{k}\right)  \left\vert \varphi_{k}\right\rangle
,\,1\leq k\leq r
\end{equation}
in the LHS\ of the inner product.
\end{proof}

\begin{definition}
\emph{Real symplectic inner product} on the complex space Hilbert space
$\mathcal{H}^{1}$%
\begin{align}
\left\{  \left.  v\right\vert w\right\}   &  =\operatorname{Im}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  =\sum_{1\leq j\leq
r}\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \operatorname{Im}_{\varphi
}\left(  w_{j}\right)  -\sum_{1\leq j\leq r}\operatorname{Im}_{\varphi}\left(
v_{j}\right)  \operatorname{Re}_{\varphi}\left(  w_{j}\right) \\
&  =\left(  \left.  \operatorname{Re}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Im}_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}%
_{\varphi}}-\left(  \left.  \operatorname{Im}_{\varphi}\left(  v\right)
\right\vert \operatorname{Re}_{\varphi}\left(  w\right)  \right)
_{\operatorname{Im}_{\varphi}},
\end{align}
where $\left(  \left.  {}\right\vert \right)  _{\operatorname{Re}_{\varphi}}$
and $\left(  \left.  {}\right\vert \right)  _{\operatorname{Im}_{\varphi}}$
are real inner products on the real Hilbert spaces $\operatorname{Re}%
_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ and $\operatorname{Im}_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  $ respectively.
\end{definition}

\begin{remark}
$\left\{  \left.  .\right\vert .\right\}  $ is bilinear and antisymmetric
\begin{equation}
\left\{  \left.  v\right\vert w\right\}  =-\left\{  \left.  w\right\vert
v\right\}
\end{equation}
and%
\begin{align}
\left\{  \left.  v\right\vert c_{1}w_{1}+c_{2}w_{2}\right\}   &
=\operatorname{Im}\left(  \left\langle \left.  v\right\vert c_{1}w_{1}%
+c_{2}w_{2}\right\rangle \right)  =\operatorname{Im}\left(  \left\langle
\left.  v\right\vert c_{1}w_{1}\right\rangle +\left\langle \left.
v\right\vert c_{2}w_{2}\right\rangle \right) \\
&  =\operatorname{Im}\left\langle \left.  v\right\vert c_{1}w_{1}\right\rangle
+\operatorname{Im}\left\langle \left.  v\right\vert c_{2}w_{2}\right\rangle
=\left\{  \left.  v\right\vert c_{1}w_{1}\right\}  +\left\{  \left.
v\right\vert c_{2}w_{2}\right\}  .
\end{align}

\end{remark}

\begin{definition}
\emph{Real symmetric inner product} on the real spaces Hilbert space
$\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ and
$\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $
\begin{align}
\left(  \left.  v\right\vert w\right)  _{\operatorname{Re}_{\varphi}}  &
=\sum_{1\leq j\leq r}\operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Re}_{\varphi}\left(  w_{j}\right) \\
\left(  \left.  v\right\vert w\right)  _{\operatorname{Im}_{\varphi}}  &
=\sum_{1\leq j\leq r}\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\operatorname{Im}_{\varphi}\left(  w_{j}\right)  .
\end{align}

\end{definition}

\begin{definition}
One can also define the real inner products $\left(  \left.  {}\right\vert
\right)  _{\operatorname*{iIm}\nolimits_{\varphi}}$ on the real Hilbert space
$\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $
using the identification
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{\operatorname*{iIm}\nolimits_{\varphi
}}=\left(  \left.  {}\right\vert \right)  _{\operatorname{Im}_{\varphi}}%
\end{equation}
by
\begin{equation}
\left(  \left.  \operatorname{Im}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Im}_{\varphi}\left(  w\right)  \right)  _{\operatorname*{iIm}%
\nolimits_{\varphi}}=\left(  \left.  \operatorname{Im}_{\varphi}\left(
v\right)  \right\vert \operatorname{Im}_{\varphi}\left(  w\right)  \right)
_{\operatorname{Im}_{\varphi}},\quad v\in\mathcal{H}^{1}.
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{\mathbb{R}}=\operatorname{Re}\left(
\left\langle \left.  v\right\vert w\right\rangle \right)  _{\mathbb{R}%
}=\left(  \left.  \operatorname{Re}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Re}_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}%
_{\varphi}}+\left(  \left.  \operatorname{Im}_{\varphi}\left(  v\right)
\right\vert \operatorname{Im}_{\varphi}\left(  w\right)  \right)
_{\operatorname{Im}_{\varphi}}.
\end{equation}

\end{remark}

\begin{remark}
In general
\begin{equation}
\left(  \left.  \operatorname{Re}_{\varphi}\left(  v\right)  \right\vert
\operatorname{Re}_{\varphi}\left(  w\right)  \right)  _{\operatorname{Re}%
_{\varphi}}\neq\left(  \left.  \operatorname{Re}_{\psi}\left(  v\right)
\right\vert \operatorname{Re}_{\psi}\left(  w\right)  \right)
_{\operatorname{Re}_{\psi}}%
\end{equation}
unless
\begin{equation}
\left\{  u\mathbf{\varphi}\right\}  =\left\{  \mathbf{\psi}\right\}  \text{
for }u\in\mathcal{\Pi}_{\mathcal{H}^{1}}\left\{  O\left(  r,\mathbb{R}\right)
\right\}  .
\end{equation}

\end{remark}

The real direct sum is \emph{invariant} to the action of the representation
$\mathcal{\Pi}_{\mathcal{H}^{1}}\left\{  O\left(  r,\mathbb{R}\right)
\right\}  \subset$ $\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ of $O\left(
r,\mathbb{R}\right)  ,$ but \emph{not invariant} to the action of the
representation $\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  U\left(  r\right)
\right)  $ of $U\left(  r\right)  .$

\begin{remark}
If $u=\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  g\right)  \in\mathcal{\Pi
}_{\mathcal{H}^{1}}\left(  U\left(  r\right)  \right)  $ then%
\begin{equation}
\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  g\right)  =\exp\left\{  i\mathcal{\Pi
}_{\mathcal{H}^{1}}\left(  \mathrm{k}\right)  \right\}  =e^{ik},
\end{equation}
where $ik\in u\left(  r\right)  $ and
\begin{equation}
\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  \mathrm{k}\right)  =\mathcal{\Pi
}_{\mathcal{H}^{1}}\left(  \mathrm{k}\right)  ^{\dagger}=k=k^{\dagger}.
\end{equation}
Hence by the spectral theorem
\begin{equation}
u=\int_{\mathbb{R}}e^{i\theta}dP_{u}\left(  \theta\right)  ,
\end{equation}
as
\[
u^{\dagger}u=uu^{\dagger}=I_{\mathcal{H}^{1}}=\left(  \int_{\left[
0,2\pi\right)  }e^{i\theta}dP_{u}\left(  \theta\right)  \right)  \left(
\int_{\left[  0,2\pi\right)  }e^{-i\theta}dP_{u}\left(  \theta\right)
\right)  =\int_{\mathbb{R}}dP_{u}\left(  \theta\right)  ,
\]
where
\begin{equation}
k=\int_{\mathbb{R}}\theta dP_{u}\left(  \theta\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
e^{i\theta}  &  =\cos\theta+i\sin\theta\\
e^{\frac{\pi}{2}i}  &  =\cos\frac{\pi}{2}+i\sin\frac{\pi}{2}=0+i1=i\\
e^{\pi i}  &  =\cos\pi+i\sin\pi=-1+0=-1\\
e^{\frac{3\pi}{2}i}  &  =\cos\frac{3\pi}{2}+i\sin\frac{3\pi}{2}=0+i\left(
-1\right)  =-i\\
e^{2\pi i}  &  =\cos2\pi+i\sin2\pi=1+i0=1.
\end{align}
The representation $\mathcal{\Pi}_{\mathcal{H}^{1}}$ of the subgroup $O\left(
r,\mathbb{R}\right)  $ of $U\left(  r\right)  $ is constituted by elements of
the form
\begin{equation}
u=e^{ik}=\int_{\left[  0,2\pi\right)  }e^{i\theta}dP_{u}\left(  \theta\right)
,\quad ik=-\left(  ik\right)  ^{t}\Leftrightarrow k=-k^{t}.
\end{equation}
The eigenvalues of $k\in\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  O\left(
r,\mathbb{R}\right)  \right)  $ are $\left\{  i\lambda,-i\lambda,0\right\}  $
where $\lambda\in\mathbb{R},$ as $k$ is an antisymmetric real matrix, hence
\begin{equation}
k=\int_{\mathbb{R}}\left\{
\begin{array}
[c]{c}%
0\\
i\lambda\\
-i\lambda
\end{array}
\right.  dP_{u}\left(  \theta\right)  ,
\end{equation}
thus
\begin{equation}
\lambda=0\text{ or }\pi
\end{equation}
when
\begin{equation}
u\in\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  O\left(  r,\mathbb{R}\right)
\right)  \subset\mathcal{B}\left(  \mathcal{H}^{1}\right)  \cong%
\mathcal{M}\left(  r,\mathbb{C}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
I_{\mathcal{F}}=I_{\mathcal{H}_{\mathcal{F}}}=\int_{\mathbb{R}}dP\left(
\theta\right)  =s\text{-}\lim\limits_{r\rightarrow\infty}\left\{  \sum_{1\leq
j\leq r}\left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{j}\right\vert \right\}  ,
\end{equation}
for any conb $\left\{  \mathbf{\varphi}\right\}  $ of $\mathcal{H}^{1}.$
\end{remark}

\begin{definition}
The conjugation $\sigma_{\varphi}$
\begin{equation}
\sigma_{\varphi}:\mathcal{H}^{1}\rightarrow\mathcal{H}^{1}%
\end{equation}
on $\mathcal{H}^{1}$ defined by
\begin{gather}
\sigma_{\varphi}\left(  v\right)  =\sum_{1\leq j\leq r}\left\vert \varphi
_{j}\right\rangle \left\{  \operatorname{Re}\left(  \mathcal{R}_{\varphi
}\left(  v\right)  _{j}\right)  -i\operatorname{Im}\left(  \mathcal{R}%
_{\varphi}\left(  v\right)  _{j}\right)  \right\}  =\sum_{1\leq j\leq
r}\left\vert \varphi_{j}\right\rangle \left\{  \mathcal{R}_{\varphi}\left(
\operatorname{Re}_{\varphi}\left(  v\right)  \right)  _{j}-\mathcal{R}%
_{\varphi}\left(  \operatorname*{iIm}\nolimits_{\varphi}\left(  v\right)
\right)  _{j}\right\} \\
=\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \operatorname{Re}%
\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)  -i\sum_{1\leq
j\leq r}\left\vert \varphi_{j}\right\rangle \operatorname{Im}\left(
\mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)  ,
\end{gather}
depends on the basis $\left\{  \mathbf{\varphi}\right\}  .$
\end{definition}

\begin{lemma}
The conjungation $\sigma_{\varphi}$ maintains the direct sum decompositions
$\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \oplus
_{\mathbb{R}}i\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $
and $\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\oplus_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $ i.e.
\begin{equation}
\sigma_{\varphi}:\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\oplus_{\mathbb{R}}i\operatorname{Im}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \rightarrow\operatorname{Re}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \oplus_{\mathbb{R}}i\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}
\end{equation}
and
\begin{equation}
\sigma_{\varphi}:\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\oplus_{\mathbb{R}}\operatorname*{iIm}\nolimits_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \rightarrow\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}\operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{equation}

\end{lemma}

\begin{proof}
obvious from the definition.
\end{proof}

\begin{remark}
$\sigma_{\varphi}\in\mathcal{B}_{\mathbb{R}}\left(  \mathcal{H}^{1}\right)  $
i.e. it is real linear when acting on the complex Hilbert space $\mathcal{H}%
^{1}$ and is also an antilinear complex map $\in\mathcal{B}_{anti}\left(
\mathcal{H}^{1}\right)  $.
\end{remark}

\begin{lemma}
$\sigma_{\varphi}=\sigma_{\psi}$ if
\begin{equation}
\mathbf{\sigma}_{\varphi}=u\mathbf{\sigma}_{\psi}u^{\dagger},\quad\text{where
}u\in\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  O\left(  r,\mathbb{R}\right)
\right)  \subset\mathcal{\Pi}_{\mathcal{H}^{1}}\left(  U\left(  r\right)
\right)  ,
\end{equation}
i.e. $u$ is a representation of an orthogonal transformation belonging to
$O\left(  r,\mathbb{R}\right)  $.
\end{lemma}

\begin{proof}%
\[
v=\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \left\{
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
+i\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
\right\}  =\sum_{1\leq j\leq r}\left\vert \psi_{j}\right\rangle \left\{
\operatorname{Re}\left(  \mathcal{R}_{\psi}\left(  v\right)  _{j}\right)
+i\operatorname{Im}\left(  \mathcal{R}_{\psi}\left(  v\right)  _{j}\right)
\right\}  .
\]

\end{proof}

\begin{lemma}
A conjugation $\sigma_{\varphi}$ is defined on $\mathcal{H}^{1}$ by
\begin{equation}
\sigma_{\varphi}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert \varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert i\varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\end{equation}
and a complex unit $J_{\varphi}$ by
\begin{equation}
J_{\varphi}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}  .
\end{equation}

\end{lemma}

\begin{proof}
Any vector $v\in\mathcal{H}^{1}$ can be expanded as
\begin{equation}
\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \left\{
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
-i\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
\right\}
\end{equation}
then%
\begin{align}
&
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert \varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert i\varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\sum_{1\leq j\leq r}\left\vert \varphi_{j}\right\rangle \left\{
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
-i\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
\right\} \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert \varphi_{j}\right)  \left(  \varphi_{j}\right\vert
\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert \varphi
_{j}\right)  -\left\vert i\varphi_{j}\right)  \left(  i\varphi_{j}\right\vert
\operatorname{Im}_{\varphi}\left(  v_{j}\right)  \left\vert i\varphi
_{j}\right)  \right\}  \ \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert
\varphi_{j}\right)  -\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\left\vert i\varphi_{j}\right)  \right\}  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert
\varphi_{j}\right\rangle -i\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\left\vert \varphi_{j}\right\rangle \right\}  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left(  \operatorname{Re}_{\varphi}v_{j}-i\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \right)  \left\vert \varphi_{j}\right\rangle \right\}
\end{align}
hence the conjugation $\sigma_{\varphi}$ is given by
\begin{equation}
\sigma_{\varphi}\left(  v\right)  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert \varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert i\varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\left\vert v\right\rangle =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left(  \operatorname{Re}_{\varphi}v_{j}-i\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \right)  \left\vert \varphi_{j}\right\rangle \right\}
=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\vert \varphi_{j}\right\rangle \left\{  \left(  \operatorname{Re}%
_{\varphi}v_{j}-i\operatorname{Im}_{\varphi}\left(  v_{j}\right)  \right)
\right\}  .
\end{equation}
The action of $%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}  $ is
given by
\begin{align}
&
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\left\vert \varphi_{j}\right\rangle +\operatorname{Im}_{\varphi}\left(
v_{j}\right)  \right\}  \left\vert i\varphi_{j}\right\rangle \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\left\vert \varphi_{j}\right)  +\operatorname{Im}_{\varphi}\left(
v_{j}\right)  \right\}  \left\vert i\varphi_{j}\right) \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert \varphi
_{j}\right)  -\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert
\operatorname{Im}_{\varphi}\left(  v_{j}\right)  \left\vert i\varphi
_{j}\right)  \right\} \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  i\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert
\varphi_{j}\right)  +\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\left\vert i\varphi_{j}\right)  \right\}  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  i\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert
\varphi_{j}\right\rangle +\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\left\vert \varphi_{j}\right\rangle \right\}  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  i\operatorname{Re}_{\varphi}\left(  v_{j}\right)  +\operatorname{Im}%
_{\varphi}\left(  v_{j}\right)  \left\vert \varphi_{j}\right\rangle \right\}
\end{align}
hence the complex unit $J_{\varphi}$ is given by
\begin{equation}
J_{\varphi}\left(  v\right)  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\left\vert \varphi_{j}\right\rangle =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  i\operatorname{Re}_{\varphi}\left(  v_{j}\right)  +\operatorname{Im}%
_{\varphi}\left(  v_{j}\right)  \left\vert \varphi_{j}\right\rangle \right\}
.
\end{equation}

\end{proof}

\begin{remark}
For $\mathcal{M}\left(  r,\mathbb{C}\right)  $ acting in $\mathbb{C}^{r}$
\begin{align}
\mathbb{M}\mathbf{v}  &  =\left(  \mathbb{A}+i\mathbb{B}\right)  \left(
\mathbf{v}_{r}+i\mathbf{v}_{i}\right)  =\mathbb{A}\left(  \mathbf{v}%
_{r}+i\mathbf{v}_{i}\right)  +i\mathbb{B}\left(  \mathbf{v}_{r}+i\mathbf{v}%
_{i}\right)  =\mathbb{A}\mathbf{v}_{r}+i\left(  \mathbb{A}\mathbf{v}%
_{i}+\mathbb{B}\mathbf{v}_{r}\right)  -\mathbb{B}\mathbf{v}_{i}=\mathbb{A}%
\mathbf{v}_{r}-\mathbb{B}\mathbf{v}_{i}+i\left(  \mathbb{A}\mathbf{v}%
_{i}+\mathbb{B}\mathbf{v}_{r}\right) \\
&  =\left(
\begin{array}
[c]{c}%
\mathbb{A}\mathbf{v}_{r}-\mathbb{B}\mathbf{v}_{i}\\
i\mathbb{A}\mathbf{v}_{i}+i\mathbb{B}\mathbf{v}_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{A} & i\mathbb{B}\\
i\mathbb{B} & \mathbb{A}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{v}_{r}\\
i\mathbf{v}_{i}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{M}\right)  & i\operatorname{Im}\left(
\mathbb{M}\right) \\
i\operatorname{Im}\left(  \mathbb{M}\right)  & \operatorname{Re}\left(
\mathbb{M}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathbf{v}\right) \\
i\operatorname{Im}\left(  \mathbf{v}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathbf{w}\right) \\
i\operatorname{Im}\left(  \mathbf{w}\right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathbb{M}\right)  \operatorname{Re}\left(
\mathbf{v}\right)  -\operatorname{Im}\left(  \mathbb{M}\right)
\operatorname{Im}\left(  \mathbf{v}\right) \\
i\left(  \operatorname{Re}\left(  \mathbb{M}\right)  \operatorname{Im}\left(
\mathbf{v}\right)  +\operatorname{Im}\left(  \mathbb{M}\right)
\operatorname{Re}\left(  \mathbf{v}\right)  \right)
\end{array}
\right)  .
\end{align}

\end{remark}

\begin{remark}
Any vector $\left\vert v\right\rangle \in\mathcal{H}^{1}$can be expanded wrt
an conb $\left\{  \mathbf{\varphi}\right\}  $ as
\begin{equation}
\left\vert v\right\rangle =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  \right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  .
\end{equation}
The action of $M\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ is
\begin{equation}
\left\vert w\right\rangle =M\left\vert v\right\rangle =\left(  \left\vert
\mathbf{\varphi}\right\rangle \right)  \mathcal{R}_{\varphi}\left(  M\right)
\mathcal{R}_{\varphi}\left(  v\right)  =\left(  \left\vert \mathbf{\varphi
}\right\rangle \right)  \mathcal{R}_{\varphi}\left(  w\right)
\end{equation}
and can be expressed as
\begin{align}
\left\vert w\right\rangle  &  =M\left\vert v\right\rangle =M\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \mathcal{R}_{r\varphi}\left(  M\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{r\varphi}\left(  M\right)  _{11} & \mathcal{R}_{r\varphi}\left(
M\right)  _{12}\\
\mathcal{R}_{r\varphi}\left(  M\right)  _{21} & \mathcal{R}_{r\varphi}\left(
M\right)  _{22}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{M}_{11} & \mathbb{M}_{12}\\
\mathbb{M}_{21} & \mathbb{M}_{22}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  .
\end{align}
The operator $M\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  $ can be
considered as a vector and expanded wrt a bases as
\begin{align}
&  M\left(
\begin{array}
[c]{cccc}%
\left\vert \mathbf{\varphi}\right)  \left(  \mathbf{\varphi}\right\vert  &
\left\vert \mathbf{\varphi}\right)  \left(  i\mathbf{\varphi}\right\vert  &
\left\vert i\mathbf{\varphi}\right)  \left(  \mathbf{\varphi}\right\vert  &
\left\vert i\mathbf{\varphi}\right)  \left(  i\mathbf{\varphi}\right\vert
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
\left\vert \mathbf{\varphi}\right)  \left(  \mathbf{\varphi}\right\vert  &
\left\vert \mathbf{\varphi}\right)  \left(  i\mathbf{\varphi}\right\vert  &
\left\vert i\mathbf{\varphi}\right)  \left(  \mathbf{\varphi}\right\vert  &
\left\vert i\mathbf{\varphi}\right)  \left(  i\mathbf{\varphi}\right\vert
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbb{M}_{11}\\
\mathbb{M}_{12}\\
\mathbb{M}_{21}\\
\mathbb{M}_{22}%
\end{array}
\right) \\
&  \left.  =\right.  \left\vert \mathbf{\varphi}\right)  \left(
\mathbf{\varphi}\right\vert \mathbb{M}_{11}+\left\vert \mathbf{\varphi
}\right)  \left(  i\mathbf{\varphi}\right\vert \mathbb{M}_{12}+\left\vert
i\mathbf{\varphi}\right)  \left(  \mathbf{\varphi}\right\vert \mathbb{M}%
_{21}+\left\vert i\mathbf{\varphi}\right)  \left(  i\mathbf{\varphi
}\right\vert \mathbb{M}_{22},
\end{align}
where
\begin{equation}
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  w\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  w\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{M}_{11} & \mathbb{M}_{12}\\
\mathbb{M}_{21} & \mathbb{M}_{22}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathbb{M}_{11}\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(
v\right)  \right)  +\mathbb{M}_{12}\mathcal{R}_{\varphi}\left(
\operatorname{Im}_{\varphi}\left(  v\right)  \right) \\
\mathbb{M}_{21}\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(
v\right)  \right)  +\mathbb{M}_{22}\mathcal{R}_{\varphi}\left(
\operatorname{Im}_{\varphi}\left(  v\right)  \right)
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\mathcal{R}_{\varphi}\left(  M\right)  _{11}\mathcal{R}_{\varphi}\left(
\operatorname{Re}_{\varphi}\left(  v\right)  \right)  +\mathcal{R}_{\varphi
}\left(  M\right)  _{12}\mathcal{R}_{\varphi}\left(  \operatorname{Im}%
_{\varphi}\left(  v\right)  \right)   &  =\operatorname{Re}\left(
\mathbb{M}\right)  \operatorname{Re}\left(  \mathbf{v}\right)
-\operatorname{Im}\left(  \mathbb{M}\right)  \operatorname{Im}\left(
\mathbf{v}\right) \\
\mathcal{R}_{\varphi}\left(  M\right)  _{21}\mathcal{R}_{\varphi}\left(
\operatorname{Re}_{\varphi}\left(  v\right)  \right)  +\mathcal{R}_{\varphi
}\left(  M\right)  _{22}\mathcal{R}_{\varphi}\left(  \operatorname{Im}%
_{\varphi}\left(  v\right)  \right)   &  =\operatorname{Re}\left(
\mathbb{M}\right)  \operatorname{Im}\left(  \mathbf{v}\right)
+\operatorname{Im}\left(  \mathbb{M}\right)  \operatorname{Re}\left(
\mathbf{v}\right)
\end{align}
giving
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbb{M}_{11} & \mathbb{M}_{12}\\
\mathbb{M}_{21} & \mathbb{M}_{22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{M}\right)  & -\operatorname{Im}\left(
\mathbb{M}\right) \\
\operatorname{Im}\left(  \mathbb{M}\right)  & \operatorname{Re}\left(
\mathbb{M}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{A} & -\mathbb{B}\\
\mathbb{B} & \mathbb{A}%
\end{array}
\right)
\end{equation}
and%
\begin{equation}
\mathcal{R}_{r\varphi}\left(  M\right)  =\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{r\varphi}\left(  M\right)  _{11} & \mathcal{R}_{r\varphi}\left(
M\right)  _{12}\\
\mathcal{R}_{r\varphi}\left(  M\right)  _{21} & \mathcal{R}_{r\varphi}\left(
M\right)  _{22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{M}_{11} & \mathbb{M}_{12}\\
\mathbb{M}_{21} & \mathbb{M}_{22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right)  &
-\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right)  &
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right)
\end{array}
\right)  ,
\end{equation}
where $\mathcal{R}_{r\varphi}$ is the representation of $\mathcal{B}\left(
\mathcal{H}^{1}\right)  $ generated by the conb basis $\left\{
\mathbf{\varphi}\right\}  $ of $\mathcal{H}^{1}$ induced by the real direct
sum $\mathcal{H}_{\varphi}^{1}\oplus_{\mathbb{R}}\mathcal{H}_{i\varphi}^{1}.$
\end{remark}

\begin{remark}
$\mathcal{R}_{r\varphi}$ is a real representation of $\mathcal{B}\left(
\mathcal{H}^{1}\right)  $ in $\mathcal{M}\left(  2r,\mathbb{R}\right)
\supset\mathcal{R}_{r\varphi}\left(  \mathcal{B}\left(  \mathcal{H}_{\varphi
}^{1}\oplus_{\mathbb{R}}\mathcal{H}_{i\varphi}^{1}\right)  \right)  $ wrt the
conb $\left\{  \mathbf{\varphi}\right\}  $ of $\mathcal{H}^{1}.$
\end{remark}

\begin{remark}
Complex transformation are mapped into real transformations by
\begin{equation}
T:\mathcal{B}\left(  \mathcal{H}^{1}\right)  \rightarrow\mathcal{B}\left(
\mathcal{H}_{\varphi}^{1}\oplus_{\mathbb{R}}\mathcal{H}_{i\varphi}^{1}\right)
=\mathcal{B}\left(  \mathcal{H}_{\mathbb{R}r}^{\oplus1}\right)
\end{equation}
and form a \emph{subset }of real transformations $T$ as
\begin{equation}
T\left\{  \mathcal{B}\left(  \mathcal{H}^{1}\right)  \right\}  \subset
\mathcal{B}\left(  \mathcal{H}_{\varphi}^{1}\oplus_{\mathbb{R}}\mathcal{H}%
_{i\varphi}^{1}\right)
\end{equation}
where the representations $\mathcal{R}_{\varphi}\left(  T\right)  $ are given
by
\begin{align}
\mathcal{R}_{\varphi}\left(  T\right)   &  :\mathcal{R}_{\varphi}\left(
\mathcal{B}\left(  \mathcal{H}^{1}\right)  \right)  \rightarrow\mathcal{R}%
_{r\varphi}\left(  \mathcal{B}\left(  \mathcal{H}_{\varphi}^{1}\oplus
_{\mathbb{R}}\mathcal{H}_{i\varphi}^{1}\right)  \right) \\
\mathcal{R}_{\varphi}\left(  T\right)  \left(  \mathcal{R}_{\varphi}\left(
M\right)  \right)   &  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right)  &
-\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right)  &
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  M\right)  \right)
\end{array}
\right)  =\mathcal{R}_{r\varphi}\left(  T\left(  M\right)  \right)  .
\end{align}

\end{remark}

\begin{definition}%
\begin{align}
\mathcal{H}_{\varphi}^{1}  &  =\mathbb{R}\text{-}\operatorname*{linspan}%
\left\{  \left.  \left\vert \varphi_{j}\right\rangle \right\vert 1\leq j\leq
r\right\} \\
\mathcal{H}_{i\varphi}^{1}  &  =\mathbb{R}\text{-}\operatorname*{linspan}%
\left\{  \left.  \left\vert i\varphi_{j}\right\rangle \right\vert 1\leq j\leq
r\right\}  .
\end{align}

\end{definition}

\begin{remark}%
\begin{equation}
\mathcal{H}_{\varphi}^{1}\neq\mathcal{H}_{\psi}^{1}\text{ unless }\left\vert
\mathbf{\varphi}\right\rangle =u\left\vert \mathbf{\psi}\right\rangle \text{
where }u\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(  O\left(
r,\mathbb{R}\right)  \right)  ,
\end{equation}
where $\left\{  \mathbf{\varphi}\right\}  $ and $\left\{  \mathbf{\psi
}\right\}  $ are conb of $\mathcal{H}^{1}.$
\end{remark}

\begin{remark}
$\mathcal{B}\left(  \mathcal{H}^{1}\right)  \cong\mathcal{M}\left(
r,\mathbb{C}\right)  $%
\begin{equation}
u\left(  \left\vert \mathbf{\varphi}\right\rangle \right)  =\left(  \left\vert
\mathbf{\varphi}\right\rangle \right)  \mathcal{R}_{\varphi}\left(  u\right)
=\left(  \left\vert \mathbf{\varphi}\right\rangle \right)  \left(
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
+i\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
\right)  =\left(  \left\vert \mathbf{\varphi}\right\rangle \right)  \left(
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  u\right)
\right)  +i\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(
u\right)  \right)  \right)  ,
\end{equation}
can be expressed as
\begin{align}
u\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)  &
-\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)  &
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)  &
\mathbb{O}_{r}\\
\mathbb{O}_{r} & \operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(
u\right)  \right)
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & -\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(
u\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)  &
\mathbb{O}_{r}%
\end{array}
\right)  \right) \\
&  =\left(  \left\vert \mathbf{\varphi}\right\rangle \right)  \left(
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
+i\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
\right)  =\left(  \left\vert \mathbf{\varphi}\right\rangle \right)  \left(
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  u\right)
\right)  +i\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(
u\right)  \right)  \right)  .
\end{align}

\end{remark}

\begin{remark}
$\mathcal{H}^{1}\cong\mathbb{C}^{r}$%
\begin{equation}
v\left(  \left\vert \mathbf{\varphi}\right\rangle \right)  =\left(  \left\vert
\mathbf{\varphi}\right\rangle \right)  \left(  \operatorname{Re}\left(
\mathcal{R}_{\varphi}\left(  v\right)  \right)  +i\operatorname{Im}\left(
\mathcal{R}_{\varphi}\left(  v\right)  \right)  \right)  =\left(  \left\vert
\mathbf{\varphi}\right\rangle \right)  \left(  \mathcal{R}_{\varphi}\left(
\operatorname{Re}_{\varphi}\left(  v\right)  \right)  +i\mathcal{R}_{\varphi
}\left(  \operatorname{Im}_{\varphi}\left(  v\right)  \right)  \right)
\end{equation}
can be e xpressed as%
\begin{equation}
v\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  \right)
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{remark}
In $\mathcal{R}_{\varphi}\left(  \mathcal{B}\left(  \mathcal{H}^{1}\right)
\right)  =\mathcal{M}\left(  r,\mathbb{C}\right)  $ the action on
$\mathcal{H}^{1}\cong\mathbb{C}^{r}$ is given by
\begin{align}
&  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)  &
-\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)  &
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  u\right)
\right)  & -\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(
u\right)  \right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  u\right)
\right)  & \mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(
u\right)  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  v\right)
\right)  -\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)
\right)  \mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(
v\right)  \right) \\
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u\right)  \right)
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  v\right)
\right)  +\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u\right)
\right)  \mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(
v\right)  \right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(  w\right)
\right) \\
\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(  w\right)
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  w\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  w\right)  \right)
\end{array}
\right)
\end{align}
in $\mathcal{R}_{r\varphi}\left(  \mathcal{B}\left(  \mathcal{H}_{r\varphi
}^{1}\oplus_{\mathbb{R}}\mathcal{H}_{ri\varphi}^{1}\right)  \right)  .$
\end{remark}

\begin{remark}
\begin{enumerate}
\item
\begin{gather}
\sigma_{\varphi}\left(  v\right)  =\sigma_{\varphi}\left\vert v\right\rangle
=\left(  \left\vert \mathbf{\varphi}\right)  \left(  \mathbf{\varphi
}\right\vert -\left\vert i\mathbf{\varphi}\right)  \left(  i\mathbf{\varphi
}\right\vert \right)  \left\vert v\right\rangle \\
=\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \mathcal{R}_{r\varphi}\left(  \sigma_{\varphi}\right)  \mathcal{R}%
_{r\varphi}\left(  \left\vert v\right\rangle \right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \mathcal{R}_{r\varphi}\left(  \left(  \left\vert \mathbf{\varphi
}\right)  \left(  \mathbf{\varphi}\right\vert -\left\vert i\mathbf{\varphi
}\right)  \left(  i\mathbf{\varphi}\right\vert \right)  \right)
\mathcal{R}_{r\varphi}\left(  \left\vert v\right\rangle \right) \\
=\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}_{r}\\
\mathbb{O}_{r} & -\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right) \\
\operatorname{Im}_{\varphi}\left(  \mathbf{v}\right)
\end{array}
\right)  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left(  \operatorname{Re}_{\varphi}v_{j}-i\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \right)  \left\vert \varphi_{j}\right\rangle \right\}
.
\end{gather}


\item
\begin{gather}
J_{\varphi}\left(  v\right)  =J_{\varphi}\left\vert v\right\rangle =\left(
\left\vert i\mathbf{\varphi}\right)  \left(  \mathbf{\varphi}\right\vert
-\left\vert \mathbf{\varphi}\right)  \left(  i\mathbf{\varphi}\right\vert
\right)  \left\vert v\right\rangle \\
=\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \mathcal{R}_{r\varphi}\left(  J_{\varphi}\right)  \mathcal{R}%
_{r\varphi}\left(  \left\vert v\right\rangle \right)  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \mathcal{R}_{r\varphi}\left(  \left(  \left\vert i\mathbf{\varphi
}\right)  \left(  \mathbf{\varphi}\right\vert +\left\vert \mathbf{\varphi
}\right)  \left(  i\mathbf{\varphi}\right\vert \right)  \right)
\mathcal{R}_{r\varphi}\left(  \left\vert v\right\rangle \right) \\
=\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{O}_{r} & -\mathbb{I}_{r}\\
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right) \\
\operatorname{Im}_{\varphi}\left(  \mathbf{v}\right)
\end{array}
\right)  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left(  i\operatorname{Re}_{\varphi}v_{j}-\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \right)  \left\vert \varphi_{j}\right\rangle \right\}
=i\left\vert v\right\rangle .
\end{gather}

\end{enumerate}
\end{remark}

\begin{definition}
Recall
\end{definition}

\begin{enumerate}
\item the direct sum complex Hilbert space $\mathcal{H}^{\oplus1}$ by
\begin{equation}
\mathcal{H}^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}
\end{equation}


\item and direct sum real Hilbert space $\mathcal{H}_{\mathbb{R}}^{\oplus1}$
by
\begin{equation}
\mathcal{H}_{\mathbb{R}}^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{R}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{equation}

\end{enumerate}

\begin{remark}
$\mathcal{H}^{1}\cap\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}
=\mathcal{H}^{1}.$
\end{remark}

\begin{remark}
The direct sum decomposition $\mathcal{H}^{1}\oplus_{\mathbb{R}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ of $\mathcal{H}%
_{\mathbb{R}}^{\oplus1}$ is invariant to real linear combinations.
\end{remark}

\begin{remark}
$\mathcal{H}_{\mathbb{R}}^{\oplus1}$ and $\mathcal{H}^{\oplus1}$ are
independent of the basis $\left\{  \mathbf{\varphi}\right\}  $ used to define
the conjugation$.$
\end{remark}

\begin{remark}
One can expand any vector $v$ wrt the direct sum $\mathcal{H}^{1}%
\oplus_{\mathbb{C}}\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  $ as
\begin{equation}
\left\vert v\right\rangle =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert \sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right\rangle
\end{array}
\right)  \ \left(
\begin{array}
[c]{c}%
\mathbf{v}_{1}\\
\mathbf{v}_{2}%
\end{array}
\right)  \in\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  =\mathcal{H}^{\oplus1};\quad\mathbf{v}_{1}%
,\mathbf{v}_{2}\in\mathcal{R}_{\varphi}\left(  \mathcal{H}^{1}\right)
\subset\mathbb{C}^{r}.
\end{equation}

\end{remark}

\begin{enumerate}
\item Real-imaginary expansion of vectors $v\in\mathcal{H}^{1}$
\begin{align}
\left\vert v\right\rangle  &  =\sum_{1\leq j\leq r}\left\{  \operatorname{Re}%
_{\varphi}\left(  v_{j}\right)  +i\operatorname{Im}_{\varphi}\left(
v_{j}\right)  \right\}  \left\vert \varphi_{j}\right\rangle =\sum_{1\leq j\leq
r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert
\varphi_{j}\right\rangle +i\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\right\}  \left\vert \varphi_{j}\right\rangle =\sum_{1\leq j\leq r}\left\{
\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \left\vert \varphi
_{j}\right\rangle +\operatorname{Im}_{\varphi}\left(  v_{j}\right)  \left\vert
i\varphi_{j}\right\rangle \right\} \\
&  =\left(
\begin{array}
[c]{cc}%
\left\vert \mathbf{\varphi}\right\rangle  & \left\vert i\mathbf{\varphi
}\right\rangle
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right) \\
\operatorname{Im}_{\varphi}\left(  \mathbf{v}\right)
\end{array}
\right)  ,\quad\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
,\operatorname{Im}_{\varphi}\left(  \mathbf{v}\right)  \in\mathbb{R}^{r}.
\end{align}


\item Real-imaginary expansion of inner product in $\mathcal{H}^{1}$
\begin{gather}
\left\langle \left.  v\right\vert w\right\rangle \left.  =\right.
\operatorname{Re}\left(  \left\langle \left.  v\right\vert w\right\rangle
\right)  +i\operatorname{Im}\left(  \left\langle \left.  v\right\vert
w\right\rangle \right) \\
\left\langle \left.  \sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi
}\left(  v_{j}\right)  \left\vert \varphi_{j}\right\rangle +i\operatorname{Im}%
_{\varphi}\left(  v_{j}\right)  \right\}  \left\vert \varphi_{j}\right\rangle
\right\vert \sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(
w_{j}\right)  \left\vert \varphi_{j}\right\rangle +i\operatorname{Im}%
_{\varphi}\left(  w_{j}\right)  \right\}  \left\vert \varphi_{j}\right\rangle
\right\rangle \\
\left.  =\right.  \sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi
}\left(  v_{j}\right)  \operatorname{Re}_{\varphi}\left(  w_{j}\right)
+\operatorname{Im}_{\varphi}\left(  v_{j}\right)  \operatorname{Im}_{\varphi
}\left(  w_{j}\right)  \right\}  +i\sum_{1\leq j\leq r}\left\{
\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \operatorname{Im}_{\varphi
}\left(  w_{j}\right)  -\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\operatorname{Re}_{\varphi}\left(  w_{j}\right)  \right\} \\
=\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Re}%
_{\varphi}\left(  \mathbf{w}\right)  +\operatorname{Im}_{\varphi}\left(
\mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(  \mathbf{w}\right)
+i\left(  \operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  \cdot
\operatorname{Im}_{\varphi}\left(  \mathbf{w}\right)  -\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Re}_{\varphi}\left(
\mathbf{w}\right)  \right)
\end{gather}
i.e.%
\begin{equation}
\operatorname{Re}\left(  \left\langle \left.  v\right\vert w\right\rangle
\right)  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  \cdot
\operatorname{Re}_{\varphi}\left(  \mathbf{w}\right)  +\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(
\mathbf{w}\right)
\end{equation}
and
\begin{equation}
\operatorname{Im}\left(  \left\langle \left.  v\right\vert w\right\rangle
\right)  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  \cdot
\operatorname{Im}_{\varphi}\left(  \mathbf{w}\right)  -\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Re}_{\varphi}\left(
\mathbf{w}\right)  .
\end{equation}


\item Orthonormality in $\mathcal{H}^{1}$ wrt $\left\langle \left.
\cdot\right\vert \cdot\right\rangle $
\begin{equation}
\left\langle \left.  \varphi_{j}\right\vert \varphi_{k}\right\rangle
=\delta_{jk}\Rightarrow\operatorname{Re}\left(  \left\langle \left.
\varphi_{j}\right\vert \varphi_{k}\right\rangle \right)  =\delta_{jk}%
\end{equation}
i.e.%
\begin{align}
\left\langle \left.  \varphi_{j}\right\vert \varphi_{k}\right\rangle  &
=0\Rightarrow\operatorname{Re}\left(  \left\langle \left.  \varphi
_{j}\right\vert \varphi_{k}\right\rangle \right)  =0\quad\&\quad
\operatorname{Im}\left(  \left\langle \left.  \varphi_{j}\right\vert
\varphi_{k}\right\rangle \right)  =0\\
\left\langle \left.  \varphi_{j}\right\vert \varphi_{j}\right\rangle  &
=1\Rightarrow\operatorname{Re}\left(  \left\langle \left.  \varphi
_{j}\right\vert \varphi_{j}\right\rangle \right)  =1\quad\&\quad
\operatorname{Im}\left(  \left\langle \left.  \varphi_{j}\right\vert
\varphi_{j}\right\rangle \right)  =0.
\end{align}


\item
\begin{align}
\left\langle \left.  v\right\vert w\right\rangle  &  =0\Rightarrow
\operatorname{Re}\left(  \left\langle \left.  v\right\vert w\right\rangle
\right)  =0\quad\&\quad\operatorname{Im}\left(  \left\langle \left.
v\right\vert w\right\rangle \right)  =0\\
&  \Rightarrow\left\{
\begin{array}
[c]{c}%
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Re}_{\varphi}\left(  w_{j}\right)  +\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \operatorname{Im}_{\varphi}\left(  w_{j}\right)
\right\}  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
\cdot\operatorname{Re}_{\varphi}\left(  \mathbf{w}\right)  +\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(
\mathbf{w}\right)  =0\\
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Im}_{\varphi}\left(  w_{j}\right)  -\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \operatorname{Re}_{\varphi}\left(  w_{j}\right)
\right\}  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
\cdot\operatorname{Im}_{\varphi}\left(  \mathbf{w}\right)  -\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Re}_{\varphi}\left(
\mathbf{w}\right)  =0
\end{array}
\right.
\end{align}%
\begin{align}
\left\langle \left.  v\right\vert w\right\rangle  &  =d\in\mathbb{R}%
\Rightarrow\operatorname{Re}\left(  \left\langle \left.  v\right\vert
w\right\rangle \right)  =d\quad\&\quad\operatorname{Im}\left(  \left\langle
\left.  v\right\vert w\right\rangle \right)  =0\\
&  \Rightarrow\left\{
\begin{array}
[c]{c}%
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Re}_{\varphi}\left(  w_{j}\right)  +\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \operatorname{Im}_{\varphi}\left(  w_{j}\right)
\right\}  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
\cdot\operatorname{Re}_{\varphi}\left(  \mathbf{w}\right)  +\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(
\mathbf{w}\right)  =d\\
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Im}_{\varphi}\left(  w_{j}\right)  -\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \operatorname{Re}_{\varphi}\left(  w_{j}\right)
\right\}  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
\cdot\operatorname{Im}_{\varphi}\left(  \mathbf{w}\right)  -\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Re}_{\varphi}\left(
\mathbf{w}\right)  =0
\end{array}
\right.
\end{align}%
\begin{align}
\left\langle \left.  v\right\vert w\right\rangle  &  =di,\,d\in\mathbb{R}%
\Rightarrow\operatorname{Re}\left(  \left\langle \left.  v\right\vert
w\right\rangle \right)  =0\quad\&\quad\operatorname{Im}\left(  \left\langle
\left.  v\right\vert w\right\rangle \right)  =d\\
&  \Rightarrow\left\{
\begin{array}
[c]{c}%
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Re}_{\varphi}\left(  w_{j}\right)  +\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \operatorname{Im}_{\varphi}\left(  w_{j}\right)
\right\}  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
\cdot\operatorname{Re}_{\varphi}\left(  \mathbf{w}\right)  +\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(
\mathbf{w}\right)  =0\\
\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\operatorname{Im}_{\varphi}\left(  w_{j}\right)  -\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \operatorname{Re}_{\varphi}\left(  w_{j}\right)
\right\}  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
\cdot\operatorname{Im}_{\varphi}\left(  \mathbf{w}\right)  -\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Re}_{\varphi}\left(
\mathbf{w}\right)  =d
\end{array}
\right.  .
\end{align}


\item The real inner product $\left(  \left.  \cdot\right\vert \cdot\right)
_{\varphi}$ on $\mathcal{H}_{\mathbb{R}}^{\oplus1}$ is given by
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{\varphi}=\sum_{1\leq j\leq
r}\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \operatorname{Re}_{\varphi
}\left(  w_{j}\right)  +\sum_{1\leq j\leq r}\operatorname{Im}_{\varphi}\left(
v_{j}\right)  \operatorname{Im}_{\varphi}\left(  w_{j}\right)
=\operatorname{Re}\left\langle \left.  v\right\vert w\right\rangle
\end{equation}
and \emph{it is independent of the decomposition}
\begin{equation}
\operatorname{Re}_{\varphi}\left(  \mathcal{H}^{1}\right)  \oplus_{\mathbb{R}%
}i\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\end{equation}
\emph{i.e. independent of the bases} $\left\{  \mathbf{\varphi}\right\}  $ so
\begin{equation}
\left(  \left.  v\right\vert w\right)  _{\varphi}=\left(  \left.  v\right\vert
w\right)  _{\mathbb{R}}\,\forall\left\{  \mathbf{\varphi}\right\}
\in\mathfrak{B}_{on}\left(  \mathcal{H}^{1}\right)  ,
\end{equation}
where $\mathfrak{B}_{on}\left(  \mathcal{H}^{1}\right)  $ is the set of
orthonormal bases of $\mathcal{H}^{1}.$

\item $\left(  \left.  \cdot\right\vert \cdot\right)  _{\varphi}=$ $\left(
\left.  \cdot\right\vert \cdot\right)  _{\mathbb{R}}$ is a real bilinear form
\begin{equation}
\left(  \left.  {}\right\vert \right)  _{\varphi}:\mathcal{H}^{1}%
\times\mathcal{H}^{1}\rightarrow\mathbb{R}%
\end{equation}
i.e.%
\begin{equation}
\left(  \left.  \alpha\varphi_{j}+\beta\varphi_{j^{\prime}}\right\vert
\varphi_{k}\right)  _{\varphi}=\left(  \left.  \varphi_{k}\right\vert
\alpha\varphi_{j}+\beta\varphi_{j^{\prime}}\right)  _{\varphi}=\alpha\left(
\left.  \varphi_{j}\right\vert \varphi_{k}\right)  _{\varphi}+\beta\left(
\left.  \varphi_{j^{\prime}}\right\vert \varphi_{k}\right)  _{\varphi}%
;\quad\alpha,\beta\in\mathbb{R}.
\end{equation}


\item
\begin{align}
\left(  \left.  v\right\vert v\right)  _{\varphi}  &  =1\Rightarrow\sum_{1\leq
j\leq r}\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \operatorname{Re}%
_{\varphi}\left(  w_{j}\right)  +\sum_{1\leq j\leq r}\operatorname{Im}%
_{\varphi}\left(  v_{j}\right)  \operatorname{Im}_{\varphi}\left(
w_{j}\right) \\
&  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  \cdot
\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  +\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(
\mathbf{v}\right)  =1\\
\left(  \left.  v\right\vert v\right)  _{\varphi}  &  =0\Rightarrow\sum_{1\leq
j\leq r}\operatorname{Re}_{\varphi}\left(  v_{j}\right)  \operatorname{Re}%
_{\varphi}\left(  w_{j}\right)  +\sum_{1\leq j\leq r}\operatorname{Im}%
_{\varphi}\left(  v_{j}\right)  \operatorname{Im}_{\varphi}\left(
w_{j}\right) \\
&  =\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  \cdot
\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)  +\operatorname{Im}%
_{\varphi}\left(  \mathbf{v}\right)  \cdot\operatorname{Im}_{\varphi}\left(
\mathbf{v}\right)  =0\\
&  \Longleftrightarrow\left(  \operatorname{Re}_{\varphi}\left(
\mathbf{v}\right)  \cdot\operatorname{Re}_{\varphi}\left(  \mathbf{v}\right)
=0\right)  \,\,\&\,\,\left(  \operatorname{Im}_{\varphi}\left(  \mathbf{v}%
\right)  \cdot\operatorname{Im}_{\varphi}\left(  \mathbf{v}\right)  =0\right)
.
\end{align}


\item The basis $\left\{  \mathbf{\varphi,}i\mathbf{\varphi}\right\}  $ is a
conb of $\mathcal{H}_{\mathbb{R}}^{\oplus1}$ wrt $\left(  \left.
{}\right\vert \right)  _{\varphi}$ i.e.
\begin{align}
\left(  \left.  \varphi_{j}\right\vert \varphi_{k}\right)  _{\varphi}  &
=\left(  \left.  \varphi_{k}\right\vert \varphi_{j}\right)  _{\varphi
}=\operatorname{Re}\left\langle \left.  \varphi_{j}\right\vert \varphi
_{k}\right\rangle =\operatorname{Re}\left\langle \left.  \varphi
_{k}\right\vert \varphi_{j}\right\rangle =\delta_{jk}\\
\left(  \left.  i\varphi_{j}\right\vert i\varphi_{k}\right)  _{\varphi}  &
=\left(  \left.  i\varphi_{k}\right\vert i\varphi_{j}\right)  _{\varphi
}=\operatorname{Re}\left\langle \left.  i\varphi_{j}\right\vert i\varphi
_{k}\right\rangle =\operatorname{Re}\left\langle \left.  i\varphi
_{k}\right\vert i\varphi_{j}\right\rangle =\delta_{jk}\\
\left(  \left.  \varphi_{j}\right\vert i\varphi_{k}\right)  _{\varphi}  &
=\left(  \left.  i\varphi_{k}\right\vert \varphi_{j}\right)  _{\varphi
}=\operatorname{Re}\left\langle \left.  \varphi_{j}\right\vert i\varphi
_{k}\right\rangle =\operatorname{Re}\left\langle \left.  i\varphi
_{k}\right\vert \varphi_{j}\right\rangle =0.
\end{align}

\end{enumerate}

\begin{remark}
One can decompose
\begin{equation}
\mathcal{H}^{\oplus1}\cong\mathcal{F}_{1}%
\end{equation}
as the direct sum
\begin{equation}
\mathcal{H}^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left(  \mathcal{H}^{1}\right)  ,
\end{equation}
where
\begin{equation}
\mathbb{C}\text{-}\dim\left\{  \mathcal{H}^{1}\right\}  =\mathbb{C}%
\text{-}\dim\left\{  \sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  \right\}
=r
\end{equation}
and $\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ is the $\varphi
$-complex conjugate of $\mathcal{H}^{1},$ where $\sigma_{\varphi}$ is the
conjugation induced by the conb basis $\left\{  \mathbf{\varphi}\right\}  $ of
$\mathcal{H}^{1}.$
\end{remark}

\begin{remark}
One can expand any vector wrt the direct sum $\mathcal{H}^{1}\oplus
_{\mathbb{C}}\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  $ as
\begin{equation}
v=\left(  \mathbf{\varphi,}\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{v}_{1}\\
\mathbf{v}_{2}%
\end{array}
\right)  \in\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  =\mathcal{H}^{\oplus1};\quad\mathbf{v}_{1}%
,\mathbf{v}_{2}\in\mathcal{R}_{\varphi}\left(  \mathcal{H}^{1}\right)
\subset\mathbb{C}^{r}.
\end{equation}

\end{remark}

In particular one can consider the direct sum decompositions of $\mathcal{H}%
^{\oplus1}$
\begin{equation}
\mathcal{H}^{\oplus1}=\operatorname{Re}_{\varphi}\left(  \mathcal{H}%
^{1}\right)  \oplus_{\mathbb{C}}\operatorname{Im}_{\varphi}\left(
\mathcal{H}^{1}\right)  =\operatorname{Re}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \oplus_{\mathbb{C}}i\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  =\operatorname{Re}_{\varphi}\left(  \mathcal{H}%
^{1}\right)  \oplus_{\mathbb{R}}i\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  ,
\end{equation}
where
\begin{align}
\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}   &  =\left\{
\left.  \operatorname{Re}_{\varphi}\left(  v\right)  =\frac{1}{2}\left(
v+\sigma_{\varphi}\left(  v\right)  \right)  \right\vert v\in\mathcal{H}%
^{1}\right\}  =\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j}\right\rangle \right\vert 1\leq j\leq r\right\} \\
\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}   &  =\left\{
\left.  \operatorname{Im}_{\varphi}\left(  v\right)  =\frac{1}{2}\left(
v-\sigma_{\varphi}\left(  v\right)  \right)  \right\vert v\in\mathcal{H}%
^{1}\right\}  =\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert i\varphi_{j}\right\rangle \right\vert 1\leq j\leq r\right\}  .
\end{align}


\begin{example}%
\begin{align}
\left\vert v\right\rangle  &  =\sum_{1\leq j\leq r}v_{j}\left\vert \varphi
_{j}\right\rangle =\sum_{1\leq j\leq r}\left(  \operatorname{Re}_{\varphi
}\left(  v_{j}\right)  +i\operatorname{Im}_{\varphi}\left(  v_{j}\right)
\right)  \left\vert \varphi_{j}\right\rangle =\sum_{1\leq j\leq r}\left(
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
+i\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
\right)  \left\vert \varphi_{j}\right\rangle \\
&  =\sum_{1\leq j\leq r}\left\{  \operatorname{Re}_{\varphi}\left(
v_{j}\right)  \left\vert \varphi_{j}\right\rangle +\operatorname{Im}_{\varphi
}\left(  v_{j}\right)  \left\vert i\varphi_{j}\right\rangle \right\}
=\sum_{1\leq j\leq r}\left(  \operatorname{Re}\left(  \mathcal{R}_{\varphi
}\left(  v\right)  _{j}\right)  +\operatorname{Im}\left(  \mathcal{R}%
_{\varphi}\left(  v\right)  _{j}\right)  \right)  \left\vert i\varphi
_{j}\right\rangle \\
&  =\frac{1}{2}\sum_{1\leq j\leq r}\left\{  \left(  v_{j}+\sigma_{\varphi
}\left(  v_{j}\right)  \right)  \left\vert \varphi_{j}\right\rangle +\left(
v_{j}-\sigma_{\varphi}\left(  v_{j}\right)  \right)  \left\vert \varphi
_{j}\right\rangle \right\}  .
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\left\vert v\right\rangle =\frac{1}{2}\sum_{1\leq j\leq r}\left\{  \left(
v_{j}+\sigma_{\psi}\left(  v_{j}\right)  \right)  \left\vert \varphi
_{j}\right\rangle +\left(  v_{j}-\sigma_{\psi}\left(  v_{j}\right)  \right)
\left\vert \varphi_{j}\right\rangle \right\}  =\sum_{1\leq j\leq r}\left\{
\operatorname{Re}_{\psi}\left(  v_{j}\right)  \left\vert \varphi
_{j}\right\rangle +\operatorname{Im}_{\psi}\left(  v_{j}\right)  \left\vert
\varphi_{j}\right\rangle \right\}  ,
\end{equation}
where
\begin{equation}
\operatorname{Re}_{\psi}\left(  v_{j}\right)  =v_{j}+\sigma_{\psi}\left(
v_{j}\right)
\end{equation}
and
\begin{equation}
\operatorname{Im}_{\psi}\left(  v_{j}\right)  =v_{j}-\sigma_{\psi}\left(
v_{j}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
&  =\mathcal{R}_{\varphi}\left(  \operatorname{Re}_{\varphi}\left(
v_{j}\right)  \right)  =\mathcal{R}_{\varphi}\left(  v_{j}+\sigma_{\varphi
}\left(  v_{j}\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  v\right)  _{j}\right)
&  =\mathcal{R}_{\varphi}\left(  \operatorname{Im}_{\varphi}\left(
v_{j}\right)  \right)  =\mathcal{R}_{\varphi}\left(  v_{j}-\sigma_{\varphi
}\left(  v_{j}\right)  \right)
\end{align}
in general however
\begin{align}
\operatorname{Re}\left(  \mathcal{R}_{\psi}\left(  v\right)  _{j}\right)   &
\neq\mathcal{R}_{\psi}\left(  \operatorname{Re}_{\varphi}\left(  v_{j}\right)
\right)  =\mathcal{R}_{\psi}\left(  v_{j}+\sigma_{\varphi}\left(
v_{j}\right)  \right) \\
\operatorname{Im}\left(  \mathcal{R}_{\psi}\left(  v\right)  _{j}\right)   &
\neq\mathcal{R}_{\psi}\left(  \operatorname{Im}_{\varphi}\left(  v_{j}\right)
\right)  =\mathcal{R}_{\psi}\left(  v_{j}-\sigma_{\varphi}\left(
v_{j}\right)  \right)  .
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\left\vert v\right\rangle =\left\{  \mathbf{\varphi+}\sigma\mathbf{_{\varphi
}\left\{  \mathbf{\varphi}\right\}  ,\varphi}-\sigma_{\varphi}\left\{
\mathbf{\varphi}\right\}  \right\}  \left(
\begin{array}
[c]{c}%
\frac{1}{2}\left(  \mathbf{v}+\sigma_{\varphi}\left(  \mathbf{v}\right)
\right) \\
\frac{1}{2}\left(  \mathbf{v}-\sigma_{\varphi}\left(  \mathbf{v}\right)
\right)
\end{array}
\right)  \in\operatorname{Re}_{\varphi}\left(  \mathcal{H}^{1}\right)
\oplus_{\mathbb{C}}\operatorname*{iIm}\nolimits_{\varphi}\left(
\mathcal{H}^{1}\right)  =\mathcal{H}^{\oplus1};\quad\mathbf{v}_{1}%
,\mathbf{v}_{2}\in\mathcal{R}_{\varphi}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{remark}

\begin{remark}
One has the real Hilbert space isormorphisms
\begin{equation}
\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\overset{\mathbb{R}}{\cong}\operatorname{Im}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \overset{\mathbb{R}}{\cong}-i\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \overset{\mathbb{R}}{\cong}i\operatorname{Im}%
_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{equation}

\end{remark}

One can define a $2r$-dimensional real Hilbert space $\mathcal{H}_{\mathbb{R}%
}^{\oplus1}$derived from $\mathcal{H}^{1}$ and $\sigma_{\varphi}$ by
\begin{equation}
\mathcal{H}_{\mathbb{R}}^{\oplus1}=\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}J_{\varphi}\operatorname{Re}%
_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \overset{\mathbb{R}}{\cong%
}\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \oplus
_{\mathbb{R}}\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\end{equation}
and%
\begin{equation}
\mathcal{H}_{\mathbb{R}}^{\oplus1}\cong\operatorname{Re}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}i\operatorname{Im}_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \cong h_{\varphi}\oplus_{\mathbb{R}%
}h_{\varphi},
\end{equation}
where
\begin{equation}
h_{\varphi}=\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
=\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \cong%
\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{equation}


\begin{remark}
$h_{\varphi}$ is a real Hilbert space with a conb $\left\{  \mathbf{\varphi
}\right\}  $
\begin{equation}
h_{\varphi}=\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j}\right\rangle \right\vert 1\leq j\leq r\right\}
\end{equation}
leading to the expansion of vectors as
\begin{equation}
\left\vert w\right)  =\left(  \mathbf{\varphi}\right)  \mathbf{w}\in
h_{\varphi},\quad\mathbf{w}\in\mathbb{R}^{r}.
\end{equation}
The complexification $\mathcal{J}_{\varphi}$ has the effect
\begin{gather}
\underset{\mathcal{J}_{\varphi}}{\underbrace{\left\vert v\right\rangle
=\left(  \mathbf{\varphi,\varphi}\right)  \left(
\begin{array}
[c]{c}%
\mathbf{w}_{1}\\
\mathbf{w}_{2}%
\end{array}
\right)  \in h_{\varphi}\oplus_{\mathbb{R}}h_{\varphi}=\left(  \left\vert
w_{1}\right)  ,\left\vert w_{2}\right)  \right)  }}\quad\quad\quad\\
\downarrow\quad\quad\quad\\
\mathcal{J}_{\varphi}\left(  v\right)  =\left(  \mathbf{\varphi,}%
i\mathbf{\varphi}\right)  \left(
\begin{array}
[c]{c}%
\mathbf{w}_{1}\\
\mathbf{w}_{2}%
\end{array}
\right)  \in h_{\varphi}\oplus_{\mathbb{R}}ih_{\varphi}=\left(  \left\vert
w_{1}\right\rangle ,\left\vert iw_{2}\right\rangle \right)  =\left\vert
w_{1}\right\rangle +i\left\vert w_{2}\right\rangle \\
\left\vert \mathcal{J}_{\varphi}\left(  v\right)  \right\rangle \in
\mathcal{H}^{1}.
\end{gather}

\end{remark}

\begin{lemma}
Let $\mathcal{H}_{\mathbb{R}}^{\oplus1}$ be a $2r$-dimensional real Hilbert
space with conb $\left\{  \mathbf{\varphi}\right\}  $ and complexification
$\mathcal{J}_{\varphi}$ then one can define a complex Hilbert space by%
\begin{align}
\mathcal{J}_{\varphi}  &  :\mathcal{H}_{\mathbb{R}}^{\oplus1}=h_{\varphi
}\oplus_{\mathbb{R}}h_{\varphi}\rightarrow\mathcal{H}^{1}\\
h_{\varphi}  &  =\mathbb{R}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j}\right)  \right\vert 1\leq j\leq r\right\}  ,
\end{align}
where
\begin{align}
\mathcal{J}_{\varphi}\left(  \left\vert \upsilon\right)  \right)   &
=\mathcal{J}_{\varphi}\left(  \left(  \left\vert \upsilon_{1}\right)
,\left\vert \upsilon_{2}\right)  \right)  \right)  =\mathcal{J}_{\varphi
}\left(  \left(  \left\vert \upsilon_{1}\right)  ,J_{\varphi}\left(
\left\vert \upsilon_{1}^{\prime}\right)  \right)  \right)  \right)
=\mathcal{J}_{\varphi}\left(  \left\vert \upsilon_{1}\right)  +J_{\varphi
}\left(  \left\vert \upsilon_{1}^{\prime}\right)  \right)  \right) \\
&  =\left\vert \upsilon_{1}\right\rangle +i\left\vert \upsilon_{1}^{\prime
}\right\rangle =\operatorname{Re}_{\varphi}\left(  \left\vert \omega
\right\rangle \right)  +i\operatorname{Im}_{\varphi}\left(  \left\vert
\omega\right\rangle \right)  =\operatorname{Re}_{\varphi}\left(  \left\vert
\omega\right\rangle \right)  +\operatorname*{iIm}\nolimits_{\varphi}\left(
\left\vert \omega\right\rangle \right)
\end{align}
and define the action of the complex unit%
\begin{equation}
i\left\vert \varphi_{j}\right\rangle \overset{\triangle}{=}J_{\varphi}%
\varphi_{j};\quad\varphi_{j}\in h_{\varphi},\,J_{\varphi}\varphi_{j}%
\in\,J_{\varphi}h_{\varphi},1\leq j\leq r.
\end{equation}

\end{lemma}

The subspaces $\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $
and $\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ are
eigenspaces of the conjugation $\sigma_{\varphi}$ i.e.
\begin{align}
\sigma_{\varphi}  &  :\operatorname{Re}_{\varphi}\left(  \mathcal{H}%
^{1}\right)  \ \rightarrow\operatorname{Re}_{\varphi}\left(  \mathcal{H}%
^{1}\right)  \ \\
\left\{  \sigma_{\varphi}\left(  \left\vert \eta\right\rangle \right)
=\left\vert \eta\right\rangle \right\}   &  \Leftrightarrow\left\{  \eta
\in\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right\} \\
\sigma_{\varphi}  &  :\operatorname{Im}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \rightarrow\operatorname{Im}_{\varphi}\left\{  \mathcal{H}%
^{1}\right\} \\
\left\{  \sigma_{\varphi}\left(  \left\vert \eta\right\rangle \right)
=-\left\vert \eta\right\rangle \right\}   &  \Leftrightarrow\left\{
\left\vert \eta\right\rangle \in\operatorname{Im}_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right\}  ,
\end{align}
which is a real linear and complex antilinear map%
\begin{equation}
\sigma_{\varphi}:\mathcal{H}^{\oplus1}\rightarrow\mathcal{H}^{\oplus1}.
\end{equation}
Recall $\sigma_{\varphi}$ is defined by
\begin{align}
\left\vert v\right\rangle  &  =\sum_{1\leq j\leq r}v_{j}\left\vert \varphi
_{j}\right\rangle =\sum_{1\leq j\leq r}\left(  \operatorname{Re}\left(
v_{j}\right)  +i\operatorname{Im}\left(  v_{j}\right)  \right)  \left\vert
\varphi_{j}\right\rangle \\
\sigma_{\varphi}\left(  \left\vert v\right\rangle \right)   &  =\sum_{1\leq
j\leq r}\overline{v_{j}}\left\vert \varphi_{j}\right\rangle =\sum_{1\leq j\leq
r}\left(  \operatorname{Re}\left(  v_{j}\right)  -i\operatorname{Im}\left(
v_{j}\right)  \right)  \left\vert \varphi_{j}\right\rangle \\
\left\vert v\right\rangle +\left\vert \sigma_{\varphi}\left(  v\right)
\right\rangle  &  =2\sum_{1\leq j\leq r}\operatorname{Re}\left(  v_{j}\right)
\left\vert \varphi_{j}\right\rangle \\
\left\vert v\right\rangle -\left\vert \sigma_{\varphi}\left(  v\right)
\right\rangle  &  =2\sum_{1\leq j\leq r}i\operatorname{Im}\left(
v_{j}\right)  \left\vert \varphi_{j}\right\rangle \\
\sigma_{\varphi}\left(  \left\vert \varphi_{j}\right\rangle \right)   &
=\left\vert \varphi_{j}\right\rangle ,
\end{align}
where $\left\{  \mathbf{\varphi}\right\}  $ is conb basis of $\mathcal{H}%
^{1}.$ $\sigma_{\varphi}$ corresponds to the complex unit $J_{\varphi}$
\begin{align}
J_{\varphi}  &  \in\mathcal{B}_{\mathbb{R}}\left(  \operatorname{Re}_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \oplus_{\mathbb{R}}\operatorname{Im}%
_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right) \\
J_{\varphi}  &  \in\mathcal{B}_{\mathbb{R}}\left(  \operatorname{Re}_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \oplus_{\mathbb{C}}\operatorname{Im}%
_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)
\end{align}
and
\begin{align}
J_{\varphi}  &  :\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\rightarrow\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\} \\
J_{\varphi}  &  :\operatorname{Im}_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\rightarrow-\operatorname{Re}_{\varphi}\left\{  \mathcal{H}^{1}\right\}  .
\end{align}


The conjugation $\sigma_{\varphi}\in\mathcal{B}_{anti}\left(  \mathcal{H}%
^{1}\right)  $ can be expressed as
\begin{equation}
\sigma_{\varphi}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert \varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert i\varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\end{equation}
and the complex unit $J_{\varphi}$ $\in\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  $ by
\begin{equation}
J_{\varphi}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}  .
\end{equation}


\begin{remark}
Recall%
\begin{equation}
\left(  \left.  {}\right\vert \right)  =\operatorname{Re}\left\langle \left.
{}\right\vert \right\rangle
\end{equation}
hence
\begin{align}
\left(  \left.  \varphi_{k}\right\vert i\varphi_{j}\right)   &
=\operatorname{Re}\left\langle \left.  \varphi_{k}\right\vert i\varphi
_{j}\right\rangle =\operatorname{Re}\left(  i\left\langle \left.  \varphi
_{k}\right\vert \varphi_{j}\right\rangle \right)  =\operatorname{Re}\left(
i\delta_{jk}\right)  =0\\
\left(  \left.  \varphi_{j}\right\vert i\varphi_{j}\right)   &
=\operatorname{Re}\left\langle \left.  \varphi_{j}\right\vert i\varphi
_{j}\right\rangle =\operatorname{Re}\left(  i\left\langle \left.  \varphi
_{j}\right\vert \varphi_{j}\right\rangle \right)  =\operatorname{Re}\left(
i\right)  =0.
\end{align}

\end{remark}

\begin{example}
\begin{enumerate}
\item
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\mathcal{R}_{\varphi}\left(
v\right)  _{j}\left\vert \varphi_{j}\right\rangle
\end{equation}


\item
\begin{align}
J_{\varphi}\left\vert v\right\rangle  &  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\sum_{1\leq k\leq r}\mathcal{R}_{\varphi}\left(  v\right)  _{k}\left\vert
\varphi_{k}\right\rangle =%
%TCIMACRO{\tsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{\varphi}\left(  v\right)  _{k}\left\{  \left\vert i\varphi
_{j}\right)  \left(  \varphi_{j}\right\vert \left\vert \varphi_{k}%
\right\rangle -\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert
\left\vert \varphi_{k}\right\rangle \right\} \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{\varphi}\left(  v\right)  _{k}\left\{  \left\vert i\varphi
_{j}\right)  \delta_{jk}\right\}  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\mathcal{R}_{\varphi}\left(  v\right)  _{j}\left\{  \left\vert i\varphi
_{j}\right)  \right\}  =i\left\vert v\right\rangle .
\end{align}


\item
\begin{align}
J_{\varphi}\left\vert \psi_{l}\right\rangle  &  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert
-\left\vert \varphi_{j}\right)  \left(  i\varphi_{j}\right\vert \right\}
\sum_{1\leq k\leq r}\mathcal{R}_{\varphi}\left(  \psi_{l}\right)
_{k}\left\vert \varphi_{k}\right\rangle =%
%TCIMACRO{\tsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{\varphi}\left(  \psi_{l}\right)  _{k}\left\{  \left\vert
i\varphi_{j}\right)  \left(  \varphi_{j}\right\vert \left\vert \varphi
_{k}\right\rangle -\left\vert \varphi_{j}\right)  \left(  i\varphi
_{j}\right\vert \left\vert \varphi_{k}\right\rangle \right\} \\
&  =%
%TCIMACRO{\tsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{\varphi}\left(  \psi_{l}\right)  _{k}\left\{  \left\vert
i\varphi_{j}\right)  \delta_{jk}\right\}  =%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\mathcal{R}_{\varphi}\left(  i\psi_{l}\right)  _{j}\left\{  \left\vert
\varphi_{j}\right)  \right\}  =i\left\vert \psi_{l}\right\rangle .
\end{align}


\item Bases that are unitarily equivalent produce the same complex unit
\begin{equation}
J_{\psi}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\left\{  \left\vert iu\varphi_{j}\right)  \left(  u\varphi_{j}\right\vert
-\left\vert u\varphi_{j}\right)  \left(  iu\varphi_{j}\right\vert \right\}
=J_{\varphi},\,u\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(
U\left(  \mathcal{H}^{1}\right)  \right)
\end{equation}
i.e.
\begin{equation}
J_{\varphi}=uJ_{\varphi}u^{\dagger}=\operatorname*{Adj}\left(  u\right)
\left(  J_{\varphi}\right)  .
\end{equation}

\end{enumerate}
\end{example}

\begin{lemma}
The action of $J_{\varphi}$ does not depend on $\left\{  \left\vert
\mathbf{\varphi}\right\rangle \right\}  $ as
\begin{equation}
J_{\varphi}\left\vert v\right\rangle =J_{\psi}\left\vert v\right\rangle
=i\left\vert v\right\rangle \quad\forall\left\vert v\right\rangle
\in\mathcal{H}^{1}%
\end{equation}
for all conbs $\left\{  \left\vert \mathbf{\psi}\right\rangle \right\}  $ and
$\left\{  \left\vert \mathbf{\varphi}\right\rangle \right\}  ,$ i.e.
\begin{equation}
J_{\varphi}=iI_{\mathcal{H}^{1}}.
\end{equation}

\end{lemma}

\begin{corollary}%
\begin{equation}
J_{\varphi}\in\mathcal{B}\left(  \mathcal{H}^{1}\right)  .
\end{equation}

\end{corollary}

The group $O\left(  2r,\mathbb{R}\right)  $ is unitarily represented in the
Banach space of operators $\mathcal{B}\left(  \mathcal{F}_{1}\right)
\equiv\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}_{1}%
}\right)  \right)  $ by canonical transformations
\begin{equation}
\widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)  :\mathcal{F}_{1}%
\rightarrow\mathcal{F}_{1}%
\end{equation}
constructed by the adjoint representation
\begin{equation}
\widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)  \left(  X\right)
=\operatorname*{Adj}\left(  \Pi_{\mathcal{F}_{1}}\left(  g\right)  \right)
\left(  X\right)  =\Pi_{\mathcal{F}}\left(  g\right)  \left(  X\right)
\Pi_{\mathcal{F}}\left(  g\right)  ^{\dagger},
\end{equation}
where $\Pi_{\mathcal{F}}$ is a unitary representation in the Hilbert space
$\mathcal{H}_{\mathcal{F}}$ i.e
\begin{equation}
\Pi_{\mathcal{F}}:O\left(  2r,\mathbb{R}\right)  \rightarrow\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)
\end{equation}
and $\widehat{\Pi_{\mathcal{F}_{1}}}$ is an irreducible component of
$\widehat{\Pi_{\mathcal{F}}}$
\begin{equation}
\widehat{\Pi_{\mathcal{F}}}:O\left(  2r,\mathbb{R}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  \equiv\mathcal{B}\left(  \mathcal{F}\right)  ,
\end{equation}
i.e.
\begin{equation}
\widehat{\Pi_{\mathcal{F}}}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\widehat{\Pi_{\mathcal{F}_{n}}}.
\end{equation}
The representation $\widehat{\Pi_{\mathcal{F}}}$ is defined by the exterior
algebra structure
\begin{equation}
\mathcal{F=}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{F}_{1}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\mathcal{F}_{n}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\mathcal{F}_{1}%
\end{equation}
giving
\begin{equation}
\widehat{\Pi_{\mathcal{F}_{n}}}=\overset{\longleftarrow\cdots\cdots\cdots
n\cdots\cdots\cdots\cdots\longrightarrow}{\,\,\widehat{\Pi_{\mathcal{F}_{1}}%
}\boxtimes\cdots\boxtimes\widehat{\Pi_{\mathcal{F}_{1}}}}\,\equiv\boxtimes
^{n}\,\widehat{\Pi_{\mathcal{F}_{1}}},
\end{equation}
i.e.
\begin{equation}
\widehat{\Pi_{\mathcal{F}_{n}}}\left(  g\right)  =\,\widehat{\Pi
_{\mathcal{F}_{1}}}\left(  g\right)  \boxtimes\cdots\boxtimes\,\widehat{\Pi
_{\mathcal{F}_{1}}}\left(  g\right)  .
\end{equation}


The Hilbert space $\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $is isomorphic to subspace $\mathcal{F}_{1}$ by the
generalized second quantization map $\Phi_{\varphi}$%

\begin{equation}
\Phi_{\varphi}:\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \rightarrow\mathcal{F}_{1}.
\end{equation}
$\lceil$

\begin{remark}
$\mathcal{F}_{1}$ can be expanded as a complex direct sum of subspaces of
equal dimension as
\begin{equation}
\mathcal{F}_{1}=\mathcal{F}_{11}\oplus_{\mathbb{C}}\mathcal{F}_{12}%
\end{equation}

\end{remark}

\begin{example}%
\begin{align}
\mathcal{F}_{11}  &  =\mathbf{a}^{\dagger}\\
\mathcal{F}_{12}  &  =\mathbf{a}%
\end{align}
or%
\begin{align}
\mathcal{F}_{11}  &  =\mathbf{x}_{1}\\
\mathcal{F}_{12}  &  =\mathbf{x}_{2}.
\end{align}

\end{example}

\begin{remark}
Second Quantization $\Phi_{\varphi}$ of a Hilbert space $\mathcal{H}^{1}%
\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $
\begin{align}
\Phi_{\varphi}  &  :\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \rightarrow\mathcal{F}_{1}\\
\Phi_{\varphi}  &  =\Gamma\circ\digamma\circ\left(  I_{\mathcal{H}^{1}}%
\oplus_{\mathbb{C}}\Upsilon_{\varphi}\right)  .
\end{align}
$\rfloor$
\end{remark}

The representation $\Pi_{\mathcal{F}}$ can be extended to $\mathcal{H}%
^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $ by%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)  }=\Pi_{\mathcal{F}%
}\circ\boxtimes\left(  \Phi_{\varphi}\right)
\end{equation}
giving
\begin{gather}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)  }\left(  g\right)
\in\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)
\right)  =\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)
\right)  =\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{1}\right)
{\normalsize \otimes}_{\mathbb{C}}\left(  {\huge \wedge}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right)  \right) \\
\cong\mathcal{B}\left(  \mathcal{B}\left(  {\huge \wedge}\left(
\mathcal{H}^{1}\right)  \right)  \right)  =\mathcal{B}\left(  \mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \right)  =\mathcal{B}\left(
\mathcal{F}\right)  ,
\end{gather}
i.e.
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)  }:O\left(
2r,\mathbb{R}\right)  \rightarrow\mathcal{B}\left(  \mathcal{H}^{1}%
\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)
\subset\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)
\right)  =\mathcal{B}\left(  \mathcal{F}\right)
\end{equation}
and%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)  }\left(  g\right)
:\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \rightarrow\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}
\end{equation}
giving%
\begin{equation}
\widehat{\Pi_{\mathcal{F}}}\left(  g\right)  \left(  \Phi_{\varphi}\left(
v\right)  \right)  =\left(  \widehat{\Pi_{\mathcal{F}}}\left(  g\right)
\circ\Phi_{\varphi}\right)  \left(  v\right)  \in\mathcal{B}\left(
{\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)  \right)  .
\end{equation}


\begin{lemma}%
\begin{equation}
\Pi_{\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  }=\sigma_{\varphi}%
\Pi_{\mathcal{H}^{1}}\sigma_{\varphi}.
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{equation}
\mathcal{R}_{\varphi}\left(  \Pi_{\sigma_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  }\right)  =\overline{\mathcal{R}_{\varphi}\left(  \Pi
_{\mathcal{H}^{1}}\right)  }.
\end{equation}

\end{lemma}

\begin{lemma}%
\begin{equation}
\Pi_{\mathcal{H}^{1d}}=\Pi_{\mathcal{H}^{1}}^{\dagger}.
\end{equation}

\end{lemma}

\begin{lemma}
The representation $\Pi_{\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)  }$ $\left(
U\left(  \mathcal{H}^{1}\right)  \right)  $ of $U\left(  \mathcal{H}%
^{1}\right)  $
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right)  }\left(  u\right)  \equiv
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{\oplus1}\right)  }\left(  u\right)
:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\right)
\end{equation}
induces the representation $\Pi_{\mathcal{B}\left(  \mathcal{F}\right)
}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  $%
\begin{equation}
\Pi_{\mathcal{B}\left(  \mathcal{F}\right)  }\left(  u\right)  :\mathcal{B}%
\left(  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \right)  \rightarrow
\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \right)
\end{equation}
by
\begin{equation}
\Pi_{\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \right)
}=\operatorname*{Adj}\circ\Pi_{{\huge \wedge}\left(  \mathcal{H}^{\oplus
1}\right)  },
\end{equation}
where
\begin{equation}
\operatorname*{Adj}:\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \right)  \rightarrow\mathcal{B}\left(  \mathcal{B}\left(
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \right)  \right)  .
\end{equation}

\end{lemma}

\begin{enumerate}
\item Exterior algebra of the direct sum $\mathcal{H}^{1}\oplus_{\mathbb{C}%
}\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  $ can be factored into a
tensor product of the exterior algebra of the individual summands i.e.
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right)  ={\huge \wedge}\left(
\mathcal{H}^{1}\right)  \widehat{\otimes}_{\mathbb{C}}{\huge \wedge}\left(
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  \right)  \cong%
\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \right)  .
\end{equation}


\item Exterior algebra of the direct sum $\mathcal{H}^{1}\oplus_{\mathbb{C}%
}\mathcal{H}^{1d}$%
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}%
^{1d}\right)  ={\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}_{\mathbb{C}}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \cong%
\mathcal{B}\left(  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \right)  .
\end{equation}


\item The representations $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}$ and $\Pi_{\mathcal{H}^{1}}$ have the following effect on $\mathcal{H}^{1}$
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  u\right)
\left\vert v\right\rangle =\Pi_{\mathcal{H}^{1}}\left(  u\right)  \left\vert
v\right\rangle =\left\vert \Pi_{\mathcal{H}^{1}}\left(  u\right)
v\right\rangle .\
\end{equation}


\item The representations $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}$ and $\Pi_{\mathcal{H}^{1d}}$ have the following effect on $\mathcal{H}%
^{1d}$%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  u\right)
\left\langle v\right\vert =\Pi_{\mathcal{H}^{1d}}\left(  u\right)
\left\langle v\right\vert =\left\langle \Pi_{\mathcal{H}^{1d}}\left(
u\right)  v\right\vert =\left\langle v\right\vert \Pi_{\mathcal{H}^{1}}\left(
u\right)  ^{\dagger}.
\end{equation}


\item The representations $\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  \right)  }$ and $\Pi_{\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  }$ have the following effect on $\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  $%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\right)  }\left(  u\right)  \left\vert \sigma_{\varphi}\left(  v\right)
\right\rangle =\Pi_{\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  }\left(
u\right)  \left\vert \sigma_{\varphi}\left(  v\right)  \right\rangle
=\left\vert \sigma_{\varphi}\left(  uv\right)  \right\rangle =\sigma_{\varphi
}\Pi_{\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  }\left(  u\right)
\sigma_{\varphi}\left\vert \sigma_{\varphi}\left(  v\right)  \right\rangle .
\end{equation}


\item The representations $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  }$ and $\Pi_{\mathcal{H}^{1}\oplus_{\mathbb{C}%
}\mathcal{H}^{1d}}$ have the following effect on $\mathcal{H}^{1}%
\oplus_{\mathbb{C}}\mathcal{H}^{1d}$%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
}\left(  u\right)  \left(  \left\vert v\right\rangle \oplus\left\langle
w\right\vert \right)  =\Pi_{\mathcal{H}^{1}\oplus\mathcal{H}^{1d}}\left(
u\right)  \left(  \left\vert v\right\rangle \oplus\left\langle w\right\vert
\right)  =\Pi_{\mathcal{H}^{1}}\left(  u\right)  \left\vert v\right\rangle
\oplus\Pi_{\mathcal{H}^{1d}}\left(  u\right)  \left\langle w\right\vert .
\end{equation}


\item The representations $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  \right)  }$ and
$\Pi_{\mathcal{H}^{1}\oplus_{\mathbb{C}}\mathcal{H}^{1d}}$ have the following
effect on $\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }\left(  u\right)  \left(  \left\vert
v\right\rangle \oplus\left\vert \sigma_{\varphi}\left(  v\right)
\right\rangle \right)  =\Pi_{\mathcal{H}^{1}\oplus\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \left(  \left\vert v\right\rangle
\oplus\left\vert \sigma_{\varphi}\left(  v\right)  \right\rangle \right)
=\Pi_{\mathcal{H}^{1}}\left(  u\right)  \left\vert v\right\rangle \oplus
\Pi_{\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  }\left(  u\right)
\left\vert \sigma_{\varphi}\left(  v\right)  \right\rangle .
\end{equation}


\item The representation $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  }$ on the exterior algebra of the direct sum
$\mathcal{H}^{1}\oplus\mathcal{H}^{1d}$ can be expressed as tensor product of
$\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes_{\mathbb{C}}%
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$ the representations
$\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and $\Pi_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }$%
\begin{align}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
}\left(  u\right)  \left(  \left\vert v\right\rangle \oplus\sigma_{\varphi
}\left(  \left\vert w\right\rangle \right)  \right)   &  =\Pi_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }\widehat{\otimes}_{\mathbb{C}}%
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  u\right)  \left(
\left\vert v\right\rangle \oplus\left\langle w\right\vert \right)
=\Pi_{\mathcal{H}^{1}\oplus\mathcal{H}^{1d}}\left(  u\right)  \left(
\left\vert v\right\rangle \oplus\left\langle w\right\vert \right) \\
&  =\left(  \left\vert \Pi_{\mathcal{H}^{1}}\left(  u\right)  v\right\rangle
\right)  \oplus\left\langle \Pi_{\mathcal{H}^{1d}}\left(  u\right)
w\right\vert =\left(  \left\vert \Pi_{\mathcal{H}^{1}}\left(  u\right)
v\right\rangle \right)  \oplus\left\langle w\right\vert \left(  \Pi
_{\mathcal{H}^{1}}\left(  u\right)  \right)  ^{\dagger}.
\end{align}


\item The representation $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  \right)  }$ on the
exterior algebra of the direct sum $\mathcal{H}^{1}\oplus\sigma_{\varphi
}\left(  \mathcal{H}^{1}\right)  $ can be expressed as tensor product of
$\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes_{\mathbb{C}}%
\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left(  \mathcal{H}^{1}\right)
\right)  }$ the representations $\Pi_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }$ and $\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }$%
\begin{align}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }\left(  u\right)  \left(  \left\vert
v\right\rangle \oplus\sigma_{\varphi}\left(  \left\vert w\right\rangle
\right)  \right)   &  =\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes_{\mathbb{C}}\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }\left(  u\right)  \left(  \left\vert
v\right\rangle \oplus\sigma_{\varphi}\left(  \left\vert w\right\rangle
\right)  \right)  =\Pi_{\mathcal{H}^{1}\oplus\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \left(  \left\vert v\right\rangle
\oplus\sigma_{\varphi}\left(  \left\vert w\right\rangle \right)  \right) \\
&  =\Pi_{\mathcal{H}^{1}}\left(  u\right)  \left\vert v\right\rangle \oplus
\Pi_{\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  }\left(  u\right)
\sigma_{\varphi}\left(  \left\vert w\right\rangle \right)  =\left\vert
\Pi_{\mathcal{H}^{1}}\left(  u\right)  v\right\rangle \oplus\sigma_{\varphi
}\left(  \left\vert \Pi_{\mathcal{H}^{1}}\left(  u\right)  w\right\rangle
\right)  .
\end{align}
$.$

\item The representation $\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}$ can be decomposed as
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  u\right)
=\boxtimes\left(  \Pi_{\mathcal{H}^{1}}\left(  u\right)  \right)  =\left(
\boxtimes\circ\Pi_{\mathcal{H}^{1}}\right)  \left(  u\right)  ,
\end{equation}
i.e.%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }=\boxtimes\circ
\Pi_{\mathcal{H}^{1}}.
\end{equation}


\item The representation $\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }$ can be decomposed as
\begin{equation}
\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left(  \mathcal{H}^{1}\right)
\right)  }\left(  u\right)  =\boxtimes\left(  \Pi_{\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \right)  =\left(  \boxtimes\circ
\Pi_{\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)  }\right)  \left(
u\right)  ,
\end{equation}
i.e.%
\begin{equation}
\Pi_{{\huge \wedge}\left(  \sigma_{\varphi}\left(  \mathcal{H}^{1}\right)
\right)  }=\boxtimes\circ\Pi_{\sigma_{\varphi}\left(  \mathcal{H}^{1}\right)
}.
\end{equation}


\item
\begin{align}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\sigma_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }\left(  u\right)  \left(  \left\vert
v\right\rangle \oplus\sigma_{\varphi}\left(  \left\vert w\right\rangle
\right)  \right)   &  =\left\vert \Pi_{\mathcal{H}^{1}}\left(  u\right)
v\right\rangle \oplus\sigma_{\varphi}\left(  \left\vert \Pi_{\mathcal{H}^{1}%
}\left(  u\right)  w\right\rangle \right)  =\left\vert \mathrm{u}%
v\right\rangle \oplus\sigma_{\varphi}\left(  \left\vert \mathrm{u}%
w\right\rangle \right) \\
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
}\left(  u\right)  \left(  \left\vert v\right\rangle \oplus\left\langle
w\right\vert \right)   &  =\left\vert \Pi_{\mathcal{H}^{1}}\left(  u\right)
v\right\rangle \oplus\left\langle \Pi_{\mathcal{H}^{1}}\left(  u\right)
w\right\vert =\left\vert \mathrm{u}v\right\rangle \oplus\left\langle
\mathrm{u}w\right\vert \\
&  \left\vert \mathrm{u}v\right\rangle \oplus\left\langle \mathrm{u}%
w\right\vert .
\end{align}


\item
\begin{equation}
\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
}\left(  u\right)  \left(  \left\vert v\right\rangle \oplus\left\langle
w\right\vert \right)  =\Pi_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes_{\mathbb{C}}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(
u\right)  \left(  \left\vert v\right\rangle \otimes_{\mathbb{C}}\left\langle
w\right\vert \right)  =\left(  \Pi_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes_{\mathbb{C}}\Pi_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\right)  \left(  u\right)  \left(  \left\vert v\right\rangle
\otimes_{\mathbb{C}}\left\langle w\right\vert \right)  .
\end{equation}


\item
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
\cong{\huge \wedge}\left(  \mathcal{H}^{1}\ \right)  \widehat{\otimes
}_{\mathbb{C}}{\huge \wedge}\left(  \mathcal{H}^{1d}\right) \\
\mathfrak{sp}  &  :\left\vert v\right\rangle \oplus_{\mathbb{C}}\left\langle
w\right\vert \rightarrow\left\vert v\right\rangle \widehat{\otimes
}_{\mathbb{C}}\left\langle w\right\vert \\
\mathfrak{ps}  &  :\left\vert v\right\rangle \widehat{\otimes}_{\mathbb{C}%
}\left\langle w\right\vert \rightarrow\left\vert v\right\rangle \oplus
_{\mathbb{C}}\left\langle w\right\vert .
\end{align}

\end{enumerate}

\paragraph{{\protect\large Exterior Product of Direct Sums}}

\begin{enumerate}
\item Direct sum of Dual Spaces

\begin{example}
\begin{enumerate}
\item Direct Sum of vectors%
\begin{equation}
\left\vert v\right\rangle \oplus_{\mathbb{C}}\left\langle w\right\vert
=\left\vert v\right\rangle \oplus_{\mathbb{C}}\left\vert w^{d}\right\rangle
=\left\vert v\right\rangle +\left\vert w^{d}\right\rangle \equiv\left(
\left\vert v\right\rangle ,0\right)  +\left(  0,\left\vert w^{d}\right\rangle
\right)
\end{equation}


\item Tensor product of direct sum of vectors%
\begin{gather}
\left(  \left\vert v_{1}\right\rangle +\left\vert w_{1}^{d}\right\rangle
\right)  \otimes\left(  \left\vert v_{2}\right\rangle +\left\vert w_{2}%
^{d}\right\rangle \right) \\
=\left\vert v_{1}\right\rangle \otimes\left\vert v_{2}\right\rangle
+\left\vert v_{1}\right\rangle \otimes\left\vert w_{2}^{d}\right\rangle
+\left\vert w_{1}^{d}\right\rangle \otimes\left\vert v_{2}\right\rangle
+\left\vert w_{1}^{d}\right\rangle \otimes\left\vert w_{2}^{d}\right\rangle \\
=\left(  \left\vert v_{1}\right\rangle +\left\vert w_{1}^{d}\right\rangle
,\left\vert v_{2}\right\rangle +\left\vert w_{2}^{d}\right\rangle \right) \\
=\left(  \left\vert v_{1}\right\rangle ,\left\vert v_{2}\right\rangle \right)
+\left(  \left\vert v_{1}\right\rangle ,\left\vert w_{2}^{d}\right\rangle
\right)  +\left(  \left\vert w_{1}^{d}\right\rangle ,\left\vert v_{2}%
\right\rangle \right)  +\left(  \left\vert w_{1}^{d}\right\rangle ,\left\vert
w_{2}^{d}\right\rangle \right) \\
=\left(  \left\vert v_{1}\right\rangle ,\left\vert v_{2}\right\rangle \right)
\oplus_{\mathbb{C}}\left(  \left\vert v_{1}\right\rangle ,\left\vert w_{2}%
^{d}\right\rangle \right)  \oplus_{\mathbb{C}}\left(  \left\vert w_{1}%
^{d}\right\rangle ,\left\vert v_{2}\right\rangle \right)  \oplus_{\mathbb{C}%
}\left(  \left\vert w_{1}^{d}\right\rangle ,\left\vert w_{2}^{d}\right\rangle
\right)
\end{gather}
In particular

\item
\begin{equation}
\left(  \left\vert v_{1}\right\rangle ,0\right)  \otimes\left(  0,\left\vert
w_{2}^{d}\right\rangle \right)  =\left(  \left\vert v_{1}\right\rangle
,\left\vert w_{2}^{d}\right\rangle \right)  \ =\left\vert v_{1}\right\rangle
\otimes\left\vert w_{2}^{d}\right\rangle ,
\end{equation}
which gives

\item
\begin{equation}
\left(  \left\vert v\right\rangle ,0\right)  \wedge\left(  0,\left\vert
w^{d}\right\rangle \right)  =\frac{1}{2}\left\{  \left\vert v\right\rangle
\otimes\left\vert w^{d}\right\rangle -\left\vert w^{d}\right\rangle
\otimes\left\vert v\right\rangle \right\}  .
\end{equation}


\begin{example}
In the case $r=2$
\end{example}

