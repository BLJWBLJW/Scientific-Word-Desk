0
\end{array}
\right)  }\otimes\overset{\cdots r}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \,}\right\rangle =\left\vert \overset{1}{e_{1}}\otimes e_{1}%
\otimes\cdots\otimes e_{1}\otimes\overset{r}{e_{1}}\right\rangle
\end{equation}
which is the image of
\begin{equation}
\mathfrak{O}_{\varphi}\left(  \left\vert \phi\right\rangle \right)
\equiv\left\vert \overset{1}{0}\overset{\cdots}{\cdots}\overset{r}{0}%
\right\rangle \in\mathfrak{O}_{\varphi}\left(  \mathcal{H}_{\mathcal{F}%
}\right)
\end{equation}
under the $jw$ map.

\subsection{The Tensor Algebra $\bigoplus\limits_{0\leq n\leq r}%
\bigotimes\nolimits^{n}\mathcal{B}\left(  \mathbb{C}^{2}\right)  $}

The matrices belonging to $\mathcal{M}\left(  2^{r},\mathbb{C}\right)  $ are
related to $\mathcal{B}\left(  \mathbb{C}^{2r}\right)  $ via representations
$\mathcal{R}_{e}$ produced by basis $\left\{  e_{1},e_{2}\right\}  $ of
$\mathbb{C}^{2}$ i.e
\begin{equation}
\mathcal{R}_{e}:\mathcal{B}\left(  \mathbb{C}^{2}\right)  \rightarrow
\mathcal{M}\left(  2,\mathbb{C}\right)
\end{equation}
by
\begin{equation}
A\left(  e_{1}e_{2}\right)  =\left(  e_{1}e_{2}\right)  \mathcal{R}_{e}\left(
A\right)
\end{equation}
to produce%
\begin{equation}
\mathcal{R}_{e}\left(  A_{1}\otimes\cdots\otimes A_{r}\right)  =\mathcal{R}%
_{e}\left(  A_{1}\right)  \otimes\cdots\otimes\mathcal{R}_{e}\left(
A_{r}\right)  .
\end{equation}


The Clifford algebra
\begin{equation}
\mathcal{F}=\bigwedge\left(  \mathcal{F}_{1}\right)  =\bigoplus\limits_{0\leq
n\leq2r}\mathcal{F}_{n}=\bigoplus\limits_{0\leq n\leq2r}^{n}%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{F}_{1}\right)
\end{equation}
(the exterior algebra equipped with operator product) is isomorphic to
$\mathcal{B}\left(  \mathbb{C}^{2r}\right)  \cong\otimes^{r}\mathcal{B}\left(
\mathbb{C}^{2}\right)  $ via the \emph{Jordan-Wigner }map i.e.%
\begin{equation}
\mathcal{F}\cong\mathcal{B}\left(  \mathbb{C}^{2r}\right)  .
\end{equation}
In fact one can think of $\mathcal{B}\left(  \mathbb{C}^{2r}\right)  $ as
being a representation of $\mathcal{F}$ i.e.
\begin{equation}
\mathcal{R}_{JW}:\mathcal{F}\rightarrow\mathcal{B}\left(  \mathbb{C}%
^{2r}\right)  =\bigotimes\nolimits^{r}\mathcal{B}\left(  \mathbb{C}%
^{2}\right)  .
\end{equation}
One can observe that this Clifford algebra depends on the the dimension $r$.

\begin{notation}
Introducing the notation
\begin{align}
\mathcal{F}_{1}\left(  r\right)   &  \equiv\mathcal{F}_{1}\\
\mathcal{F}\left(  r\right)   &  \equiv\mathcal{F},
\end{align}
when
\begin{equation}
\dim\left\{  \mathcal{F}_{1}\right\}  =2r.
\end{equation}

\end{notation}

\begin{remark}
One can consider the generalization of a particular $2^{2r}$ dimensional
CAR/Clifford algebra for a fixed $r$ to the direct sum of CAR/Clifford
algebras for all $r$ i.e.
\begin{equation}
\mathfrak{F}=\bigoplus\limits_{0\leq n\leq r}\mathcal{F}\left(  r\right)
\end{equation}
leading to the representation%
\begin{equation}
\mathcal{R}_{JW}\left(  \mathfrak{F}\right)  =\mathcal{R}_{JW}\left(
\bigoplus\limits_{0\leq n\leq r}\mathcal{F}\left(  r\right)  \right)
=\bigoplus\limits_{0\leq n\leq r}\mathcal{R}_{JW}\left(  \mathcal{F}\left(
r\right)  \right)  =\bigoplus\limits_{0\leq n\leq r}\bigotimes\nolimits^{n}%
\mathcal{B}\left(  \mathbb{C}^{2}\right)  ,
\end{equation}
which is the \emph{full tensor algebra} over the operator space $\mathcal{B}%
\left(  \mathbb{C}^{2}\right)  $ that acts on the tensor algebra generated by
vector space $\mathbb{C}^{2}$
\begin{equation}
\mathcal{R}_{jw}\left(  \mathfrak{H}_{\mathfrak{F}}\right)  =\bigoplus
\limits_{0\leq n\leq r}\bigotimes\nolimits^{n}\mathbb{C}^{2}=\bigoplus
\limits_{0\leq n\leq r}\mathbb{C}^{2n}\overset{\Delta}{=}\bigoplus\left(
\mathbb{C}^{2}\right)  ,
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{JW}\left(  \mathfrak{F}\right)  =\mathcal{B}\left(
\bigoplus\limits_{0\leq n\leq r}\bigotimes\nolimits^{n}\mathbb{C}^{2}\right)
\cong\bigoplus\limits_{0\leq n\leq r}\mathcal{B}\left(  \bigotimes
\nolimits^{n}\mathbb{C}^{2}\right)  =\bigoplus\limits_{0\leq n\leq
r}\mathcal{B}\left(  \mathbb{C}^{2n}\right)  \overset{\Delta}{=}%
\bigoplus\left(  \mathcal{B}\left(  \mathbb{C}^{2}\right)  \right)  .
\end{equation}

\end{remark}

\begin{remark}
The dimension of $\mathfrak{F}$ and $\mathcal{R}_{JW}\left(  \mathfrak{F}%
\right)  $ is given by%
\begin{equation}
\dim\left(  \mathfrak{F}\right)  =\dim\left(  \mathcal{R}_{JW}\left(
\mathfrak{F}\right)  \right)  =\sum\limits_{0\leq r\leq\infty}\dim\left(
\mathcal{B}\left(  \mathbb{C}^{2r}\right)  \right)  =\sum\limits_{0\leq
r\leq\infty}2^{2r}=\infty.
\end{equation}

\end{remark}

\begin{remark}
In the finite dimensional case where we limit the sum i.e. $r\leq k<\infty$
\begin{equation}
\dim\left(  \mathfrak{F}\right)  =\sum\limits_{0\leq r\leq k}2^{2r}.
\end{equation}

\end{remark}

\begin{example}
$k=4$%
\begin{equation}
\sum\limits_{0\leq r\leq4}2^{2r}=1+2^{2}+2^{4}+2^{6}+2^{8}=1+4+16+64+256=341.
\end{equation}

\end{example}

\begin{remark}
The tensor spaces $\bigotimes\nolimits^{n}\mathbb{C}^{2}$ hence $\bigoplus
\limits_{0\leq n\leq r}\left(  \bigotimes\nolimits^{n}\mathbb{C}^{2}\right)
=$ $\bigoplus\limits_{0\leq n\leq r}\mathbb{C}^{2n}$ and the tensor algebras
$\mathcal{B}\left(  \bigotimes\nolimits^{n}\mathbb{C}^{2}\right)  $ hence
$\bigoplus\limits_{0\leq n\leq r}\mathcal{B}\left(  \mathbb{C}^{2n}\right)  $
can be reduced into symmetry classes wrt the symmetric group i.e. spin symmetries.
\end{remark}

\begin{remark}
For example
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathbb{C}^{2}\right)  \subset\bigotimes\nolimits^{n}\mathbb{C}^{2}%
\end{equation}
and
\begin{equation}
\mathcal{B}\left(
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathbb{C}^{2}\right)  \right)  \subset\mathcal{B}\left(
\bigotimes\nolimits^{n}\mathbb{C}^{2}\right)  .
\end{equation}

\end{remark}

\section{Properties of Complex Clifford Algebras}

\subsection{Definition of a Clifford Algebra}

\begin{definition}
A Clifford algebra $Cl(V,Q)$ is a\emph{ unital associative} algebra
$\mathcal{A}$ that \emph{contains and is generated} by a vector space $V$ over
a field $\mathbb{F}$, where $V$ is equipped with

\begin{enumerate}
\item A \emph{quadratic form}
\begin{equation}
Q_{V}~:V\rightarrow\mathbb{F}.
\end{equation}


\item A product $"\cdot"$ and multiplicative identity $I_{\mathcal{A}}$
subject to the condition
\begin{equation}
v\cdot v=v^{2}=Q_{V}(v)I_{\mathcal{A}},\,\quad\forall v\in V.
\end{equation}

\end{enumerate}
\end{definition}

\begin{definition}
If $V$ is a normed vector space with norm $\Vert v\Vert_{V}$%
\begin{equation}
Q_{V}\left(  v\right)  =\Vert v\Vert_{V}^{2}.
\end{equation}

\end{definition}

\begin{remark}
One can generalize this definition by replacing the vector space $V$ by a left
or right module $M$ constructed using a ring $\mathsf{R}$ and consider a
quadratic form
\begin{equation}
Q_{M}~:M\rightarrow\mathsf{R}.
\end{equation}
and a product defined by
\begin{equation}
v\cdot v=v^{2}=Q_{M}(v)I_{\mathcal{A}},\,\quad\forall v\in M.
\end{equation}

\end{remark}

\begin{remark}
In the case that the scalars are quaternions
\begin{equation}
\mathsf{R}=\mathbb{H}.
\end{equation}

\end{remark}

\paragraph{Inner Products in Normed Spaces}

\begin{remark}
There are exactly four \emph{Euclidean Hurwitz algebras} over the real
numbers. These are the
\end{remark}

\begin{definition}
\begin{enumerate}
\item Real numbers $\mathbb{R}$,

\item Complex numbers $\mathbb{C}$,

\item Quaternions $\mathbb{H}$ ,

\item Octonions $\mathbb{O}$,

where the dimensions of these spaces over the real numbers are $1,2,4,$and $8$ ,respectively.
\end{enumerate}
\end{definition}

\begin{remark}
\begin{enumerate}
\item The canonical norms on $\mathbb{R}$ and $\mathbb{C}$ are their absolute
value functions$.$

\item The canonical norm on $\mathbb{H}$ of quaternions is defined by
\begin{equation}
\left\Vert q\right\Vert ^{2}=qq^{\ast}=q^{\ast}q=a^{2}+b^{2}+c^{2}+d^{2}%
\end{equation}
for every quaternion
\begin{equation}
q=a\boldsymbol{1}_{\mathbb{H}}+b\boldsymbol{i}_{\mathbb{H}}+c\boldsymbol{j}%
_{\mathbb{H}}+d\boldsymbol{k}_{\mathbb{H}}%
\end{equation}
in $\mathbb{H}$. This is the same as the Euclidean norm on $\mathbb{H}$
considered as the vector space $\mathbb{R}^{4}$.

\item The canonical norm on the octonions is just the Euclidean norm on
$\mathbb{R}^{8}$.
\end{enumerate}
\end{remark}

\begin{remark}
In \emph{an} inner product space the norm satisfies the parallelogram law%
\begin{equation}
\Vert x+y\Vert^{2}+\Vert x-y\Vert^{2}=2\Vert x\Vert^{2}+2\Vert y\Vert^{2}.
\end{equation}

\end{remark}

\begin{remark}
\emph{The parallelogram law does \underline{\emph{NOT}} hold in all normed
spaces.}
\end{remark}

\begin{remark}
If the \emph{parallelogram law \underline{\emph{does hold}} then one can
define an inner product in terms of the norm. }
\end{remark}

\begin{theorem}
Any normed space that satisfies the parallelogram law supports an inner
product that produces the norm.
\end{theorem}

\begin{theorem}
Let $X$ be a $\mathbb{C}$-vector space. For a map
\begin{equation}
q:X\rightarrow\lbrack0,\infty)
\end{equation}


the following are equivalent:

\begin{enumerate}
\item There exists a positive definite sesquilinear form
\begin{equation}
\varphi:X\times X\rightarrow\mathbb{C},
\end{equation}
such that%
\begin{equation}
Q(x)=\sqrt{\U{3c6} (x,x)},\forall x\in X
\end{equation}


\item $Q$ is a seminorm $\left(  Q\text{ is a norm when }Q(x)=0\Leftrightarrow
x=0\right)  $ on $X$ , which satisfies the \textbf{Parallelogram Law}:%
\begin{equation}
Q(x+y)^{2}+Q(x-y)^{2}=2Q(x)^{2}+2Q(y)^{2},\forall x,y\in X.
\end{equation}
Moreover, $\U{3c6} $ is unique and satisfies the \textbf{Polarization
Identit}y:
\begin{equation}
\U{3c6} (x,y)=\frac{1}{4}\sum_{0\leq k\leq3}i^{\boldsymbol{-}k}Q(x+i^{k}%
y)^{2}.
\end{equation}

\end{enumerate}
\end{theorem}

\paragraph{Symmetric bilinear forms \label{Symmetric bilinear forms}}

The \emph{polarization identities} are not restricted to inner products. If
$B$ is any symmetric bilinear form on a $\mathbb{F}$-vector space $V$
\begin{equation}
B:V\times V\rightarrow\mathbb{F}%
\end{equation}
and $Q$ is the quadratic form
\begin{equation}
Q:V\rightarrow\mathbb{F}%
\end{equation}
defined by
\begin{equation}
Q\left(  v\right)  =B\left(  v,v\right)
\end{equation}
then one has the \textbf{Polarization Identities}

\begin{enumerate}
\item
\begin{equation}
2B\left(  u,v\right)  =Q\left(  u+v\right)  -Q\left(  u\right)  -Q\left(
v\right)  .
\end{equation}


\item
\begin{equation}
2B\left(  u,v\right)  =Q\left(  u\right)  +Q\left(  v\right)  -Q\left(
u-v\right)  .
\end{equation}


\item
\begin{equation}
4B\left(  u,v\right)  =Q\left(  u+v\right)  -Q\left(  u-v\right)  .
\end{equation}

\end{enumerate}

\begin{remark}
\begin{enumerate}
\item The formulas above even apply in the case where the field of scalars has
characteristic two, though the left-hand sides are all zero in this case.
Consequently, in characteristic two there is no formula for a symmetric
bilinear form in terms of a quadratic form, and they are in fact distinct
notions, a fact which has important consequences in L-theory; for brevity, in
this context "symmetric bilinear forms" are often referred to as "symmetric forms".

\item \emph{These formulas also apply to \textbf{bilinear forms on modules}
over a commutative ring,} though again one can only solve for $B(u,v)$ if $2$
is invertible in the ring, and otherwise these are distinct notions. For
example, over the integers, one distinguishes integral quadratic forms from
integral symmetric forms, which are a narrower notion

\item More generally, in the presence of a ring involution or where $2$ is not
invertible, one distinguishes -quadratic forms and -symmetric forms; a
symmetric form defines a quadratic form, and the polarization identity
(without a factor of $2$) from a quadratic form to a symmetric form is called
the "symmetrization map", and is not in general an isomorphism. This has
historically been a subtle distinction: over the integers it was not until the
1950s that relation between "twos out" (integral quadratic form) and "twos in"
(integral symmetric form) was understood.
\end{enumerate}
\end{remark}

\paragraph{Real, Complex and Quaternionic Spaces
\label{Real, Complex and Quaternionic Spaces}}

\begin{remark}
If $u,v\in\mathrm{V}$, then the following \emph{polarization identity} holds
and can be used to define an inner product in the real space $\mathrm{V}$
through the
\end{remark}

\begin{theorem}
Let $\mathrm{V}$ be a normed real vector space then one can define a
$\mathbb{R}$-valued inner product
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle _{\mathrm{V}}:\mathrm{V}%
\times\mathrm{V}\rightarrow\mathbb{R}%
\end{equation}
by the \emph{polarization identity}%
\begin{equation}
\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathrm{V}%
}=\frac{1}{4}\left(  \overset{}{\left\Vert \overset{}{u+v}\right\Vert
_{\mathrm{V}}^{2}-\left\Vert \overset{}{u-v}\right\Vert _{\mathrm{V}}^{2}%
}\right)  \boldsymbol{1}_{\mathbb{R}}.
\end{equation}

\end{theorem}

\begin{corollary}
Let $\mathrm{V}$ be a normed real vector space then one can define a
$\mathbb{R}$-valued inner product
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle _{\mathrm{V}}:\mathrm{V}%
\times\mathrm{V}\rightarrow\mathbb{R}%
\end{equation}
by%
\begin{equation}
\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathrm{V}%
}=\frac{1}{2}\left(  \left\Vert u+v\right\Vert _{\mathrm{V}}^{2}%
-\overset{}{\left\Vert v\right\Vert _{\mathrm{V}}^{2}-\left\Vert u\right\Vert
_{\mathrm{V}}^{2}}\right)  \boldsymbol{1}_{\mathbb{R}}=\frac{1}{2}\left(
\overset{}{Q_{\mathrm{V}}(u+v)-Q_{\mathrm{V}}(u)-Q_{\mathrm{V}}(v)}\right)
\boldsymbol{1}_{\mathbb{R}}.
\end{equation}

\end{corollary}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
Q_{\mathrm{V}}(v)=\left\langle \left.  v\right\vert v\right\rangle
_{\mathrm{V}}=\left\Vert v\right\Vert _{\mathrm{V}}^{2}%
\end{equation}


\item giving%
\begin{equation}
\left\langle \left.  \overset{}{v}\right\vert v\right\rangle _{\mathrm{V}%
}=\frac{1}{2}\left(  \overset{}{Q_{\mathrm{V}}(2v)-Q_{\mathrm{V}%
}(v)-Q_{\mathrm{V}}(v)}\right)  =\frac{1}{2}\left(  \overset{}{Q_{\mathrm{V}%
}(2v)-2Q_{\mathrm{V}}(v)}\right)  =\frac{1}{2}\left(  \overset{}{\left\Vert
2v\right\Vert _{\mathrm{V}}^{2}-2\left\Vert v\right\Vert _{\mathrm{V}}^{2}%
}\right)  =\frac{1}{2}\left(  4\overset{}{\left\Vert v\right\Vert
_{\mathrm{V}}^{2}-2\left\Vert v\right\Vert _{\mathrm{V}}^{2}}\right)
=\left\Vert v\right\Vert _{\mathrm{V}}^{2}.
\end{equation}

\end{enumerate}
\end{remark}

\begin{corollary}%
\begin{equation}
\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathrm{V}%
}=\frac{1}{4}\left(  \overset{}{Q_{\mathrm{V}}\left(  u+v\right)
-Q_{\mathrm{V}}\left(  u-v\right)  }\right)  \boldsymbol{1}_{\mathbb{R}}.,
\end{equation}

\end{corollary}

\begin{theorem}
Let $\mathfrak{H}$ be a normed complex vector space then one can define a
$\mathbb{C}$-valued inner product
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle _{\mathfrak{H}}%
:\mathfrak{H}\times\mathfrak{H}\rightarrow\mathbb{C}%
\end{equation}
by%
\begin{equation}
\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathfrak{H}%
}=\frac{1}{4}\left(  \overset{}{\left\Vert \overset{}{u+v\boldsymbol{1}%
_{\mathbb{C}}}\right\Vert _{\mathfrak{H}}^{2}-\left\Vert \overset{}{u-v}%
\boldsymbol{1}_{\mathbb{C}}\right\Vert _{\mathfrak{H}}^{2}}\right)
\boldsymbol{1}_{\mathbb{C}}+\left(  \overset{}{\left\Vert \overset{}{u+v}%
\boldsymbol{i}_{\mathbb{C}}\right\Vert _{\mathfrak{H}}^{2}-\left\Vert
\overset{}{u-v}\boldsymbol{i}_{\mathbb{C}}\right\Vert _{\mathfrak{H}}^{2}%
}\right)  \boldsymbol{i}_{\mathbb{C}}.
\end{equation}

\end{theorem}

\begin{corollary}%
\begin{equation}
\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathfrak{H}%
}=\frac{1}{4}\left(  \left(  Q_{\mathfrak{H}}\left(
\overset{}{u\boldsymbol{1}_{\mathbb{C}}+v}\right)  -Q_{\mathfrak{H}}\left(
\overset{}{u\boldsymbol{1}_{\mathbb{C}}-v}\right)  \boldsymbol{1}_{\mathbb{C}%
}\right)  +\left(  Q_{\mathfrak{H}}\left(  \overset{}{u\boldsymbol{i}%
_{\mathbb{C}}+v}\right)  -Q_{\mathfrak{H}}\left(  \overset{}{u\boldsymbol{i}%
_{\mathbb{C}}-v}\right)  \right)  \boldsymbol{i}_{\mathbb{C}}\right)  ,
\end{equation}

\end{corollary}

\begin{theorem}
Let $\mathfrak{H}_{\mathbb{H}}$ be a normed quaternionic\emph{ right} module
then one can define a $\mathbb{H}$-valued inner product
\begin{equation}
\left\langle \left.  {}\right\vert \right\rangle _{\mathfrak{H}}%
:\mathfrak{H}_{\mathbb{H}}\times\mathfrak{H}_{\mathbb{H}}\rightarrow\mathbb{H}%
\end{equation}
by%
\begin{gather}
4\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathfrak{H}%
_{\mathbb{H}}}\\
\parallel\\
\left(  \overset{}{\left\Vert \overset{}{u+v\boldsymbol{1}_{\mathbb{H}}%
}\right\Vert _{\mathfrak{H}_{\mathbb{H}}}^{2}-\left\Vert \overset{}{u-v}%
\boldsymbol{1}_{\mathbb{H}}\right\Vert _{\mathfrak{H}_{\mathbb{H}}}^{2}%
}\right)  \boldsymbol{1}_{\mathbb{H}}+\left(  \overset{}{\left\Vert
\overset{}{u+v}\boldsymbol{i}_{\mathbb{H}}\right\Vert _{\mathfrak{H}%
_{\mathbb{H}}}^{2}-\left\Vert \overset{}{u-v\boldsymbol{i}_{\mathbb{H}}%
}\right\Vert _{\mathfrak{H}_{\mathbb{H}}}^{2}}\right)  \boldsymbol{i}%
_{\mathbb{H}}\\
\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\left(
\overset{}{\left\Vert \overset{}{u+v}\boldsymbol{j}_{\mathbb{H}}\right\Vert
_{\mathfrak{H}_{\mathbb{H}}}^{2}-\left\Vert \overset{}{u-v\boldsymbol{j}%
_{\mathbb{H}}}\right\Vert _{\mathfrak{H}_{\mathbb{H}}}^{2}}\right)
\boldsymbol{j}_{\mathbb{H}}+\left(  \overset{}{\left\Vert \overset{}{u+v}%
\boldsymbol{k}_{\mathbb{H}}\right\Vert _{\mathfrak{H}_{\mathbb{H}}}%
^{2}-\left\Vert \overset{}{u-v\boldsymbol{k}_{\mathbb{H}}}\right\Vert
_{\mathfrak{H}_{\mathbb{H}}}^{2}}\right)  \boldsymbol{k}_{\mathbb{H}}.
\end{gather}

\end{theorem}

\begin{corollary}
The quaternionic inner product can be expanded in terms of quaternionic
quadratic forms as
\begin{align}
\left\langle \left.  \overset{}{u}\right\vert v\right\rangle _{\mathfrak{H}%
_{\mathbb{H}}}  &  =\frac{1}{4}\left(  \left(  Q_{\mathfrak{H}_{\mathbb{H}}%
}\left(  \overset{}{u\boldsymbol{1}_{\mathbb{H}}+v}\right)  -Q_{\mathfrak{H}%
_{\mathbb{H}}}\left(  \overset{}{u\boldsymbol{1}_{\mathbb{H}}-v}\right)
\right)  \boldsymbol{1}_{\mathbb{H}}+\left(  Q_{\mathfrak{H}_{\mathbb{H}}%
}\left(  \overset{}{u\boldsymbol{i}_{\mathbb{H}}+v}\right)  -Q_{\mathfrak{H}%
_{\mathbb{H}}}\left(  \overset{}{u\boldsymbol{i}_{\mathbb{H}}-v}\right)
\right)  \boldsymbol{i}_{\mathbb{H}}\right. \\
&  \qquad\qquad\qquad+\left.  \left(  Q_{\mathfrak{H}_{\mathbb{H}}}\left(
\overset{}{u\boldsymbol{j}_{\mathbb{H}}+v}\right)  -Q_{\mathfrak{H}%
_{\mathbb{H}}}\left(  \overset{}{u\boldsymbol{j}_{\mathbb{H}}-v}\right)
\right)  \boldsymbol{j}_{\mathbb{H}}+\left(  Q_{\mathfrak{H}_{\mathbb{H}}%
}\left(  \overset{}{u\boldsymbol{k}_{\mathbb{H}}+v}\right)  -Q_{\mathfrak{H}%
_{\mathbb{H}}}\left(  \overset{}{u\boldsymbol{k}_{\mathbb{H}}-v}\right)
\right)  \boldsymbol{k}_{\mathbb{H}}\right)  ,
\end{align}

\end{corollary}

\paragraph{Linear Algebra \label{Linear Algebra}}

\begin{remark}
A unital algebra $\mathcal{A}$ is a linear space over a field i.e. a linear
space where the coefficients of the elements i.e. \emph{scalar} multiplication
come from a field and a bilinear product in the algebra to the algebra is
defined, thus is a vector space. i.e. $\mathcal{A}$ is a vector space where

\begin{enumerate}
\item $\mathcal{A}$ has a group structure that produces algebraic
multiplication with multiplication $"\cdot"$ and identity $I_{\mathcal{A}}$ i.e.

\begin{enumerate}
\item
\begin{equation}
\cdot:\mathcal{A}\times\mathcal{A}\rightarrow\mathcal{A}%
\end{equation}
i.e.
\begin{equation}
\cdot\left(  a,b\right)  =a\cdot b\in\mathcal{A}%
\end{equation}


\item
\begin{equation}
aa^{-1}=a^{-1}a=I_{\mathcal{A}}%
\end{equation}


\item
\begin{equation}
I_{\mathcal{A}}a=aI_{\mathcal{A}}=a
\end{equation}

\end{enumerate}

\item $\mathcal{A}$ has an abelian group structure that produces sums and
differences with multiplication $"+"$, inverse $"-"$ and identity $"0"$ i.e.

\begin{enumerate}
\item
\begin{equation}
a+b=b+a.
\end{equation}


\item
\begin{equation}
a-a=0.
\end{equation}


\item
\begin{equation}
a+0=0+a=a.
\end{equation}

\end{enumerate}

\item Scalar multiplication in $\mathcal{A}$ is given by scalar linear
operators $s\in\operatorname*{End}\left\{  \mathcal{A}\right\}  $%
\begin{equation}
s:\mathcal{A\rightarrow A}%
\end{equation}
i.e.
\begin{equation}
s\left(  a\right)  \equiv sa\in\mathcal{A}%
\end{equation}
and
\begin{equation}
s\left(  a+b\right)  =s\left(  a\right)  +s\left(  b\right)
\end{equation}
that form a field $\mathbb{F}$ ( a commutative divison ring)$.$

\item The action of $s$ on $\mathcal{A}$ is commutative i.e.
\begin{equation}
sa=as.
\end{equation}

\end{enumerate}
\end{remark}

\paragraph{Algebraic Modules \label{Algebraic Modules}}

\begin{definition}
A \emph{module} $\mathcal{M}$ is a \emph{linear space} over a ring \textsf{R
}i.e. a linear space where the scalar coefficients of the elements form a
ring. In more detail:
\end{definition}

\begin{definition}
A \emph{module} $\mathcal{M}$ is a mathematical set $S=\left\{  x\right\}  $
that is a

\begin{enumerate}
\item commutative group under addition and that is closed under this
commutative multiplication
\begin{equation}
x+y=y+x\in\mathcal{S}%
\end{equation}


\item has a ring of linear operators that are group endomorphisms (actually
automorphisms)
\begin{equation}
a\left(  x+y\right)  =a\left(  x\right)  +a\left(  y\right)
\end{equation}
that map $S$ to itself
\begin{equation}
a:S\rightarrow S
\end{equation}
that are called scalar multiplication and whose action are denoted by
\begin{equation}
a\left(  x\right)  =ax.
\end{equation}
These operators are distributive from the left or right or both by elements of
a ring \textsf{R }$=\left\{  a\right\}  $ i.e.
\begin{equation}
a(bx)=(ab)x\in S
\end{equation}
or
\begin{equation}
(xb)a=x(ba)\in S
\end{equation}
or both where $a$ and $b$ are elements of the ring \textsf{R }and $x$ belongs
to the set $S$.
\end{enumerate}
\end{definition}

\begin{remark}
There is no multiplication $"\boldsymbol{.}"$ operation in a module
$\mathcal{M}$ i.e. $x\boldsymbol{\cdot}y$ does not exist as it has not been
defined in the set $S$
\end{remark}

\begin{definition}
Given a sets $S$ and binary operators $\ast$ and $+$ on $S$ the operation
$x\ast$ \underline{is\emph{ left-distributive}} over (or with respect to) $+$
if given any elements $x,y,z$ $\in S$
\begin{equation}
x\ast(y+z)=(x\ast y)+(x\ast z)
\end{equation}
the operation $\ast$ \underline{is \emph{right-distributive} over} $+$ if,
given any elements $x,y,$ and $z$ of $S$ ,
\begin{equation}
(y+z)\ast x=(y\ast x)+(z\ast x)
\end{equation}
and the operation $\ast$ is distributive over $+$ if it is left- and right-distributive.
\end{definition}

\begin{definition}
Define
\begin{equation}
L_{x}\left(  y\right)  =x\ast y
\end{equation}
and
\begin{equation}
R_{x}\left(  y\right)  =y\ast x
\end{equation}
then
\begin{equation}
L_{x},R_{x}\in\operatorname*{End}\left\{  S\right\}  .
\end{equation}

\end{definition}

\begin{lemma}%
\begin{equation}
L_{x}\circ L_{y}=L_{x\ast y}%
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left(  L_{x}\circ L_{y}\right)  \left(  z\right)  =L_{x}\left(  L_{y}\left(
z\right)  \right)  =L_{x}\left(  y\ast z\right)  =x\ast y\ast z
\end{equation}
and
\begin{equation}
L_{x\ast y}\left(  z\right)  =x\ast y\ast z
\end{equation}
hence
\begin{equation}
L_{x}\circ L_{y}=L_{x\ast y}.
\end{equation}

\end{proof}

\begin{corollary}%
\begin{equation}
L:S\rightarrow\operatorname*{End}\left\{  S\right\}
\end{equation}
given by
\begin{equation}
L\left(  x\right)  =L_{x}%
\end{equation}
is a homomorphism.
\end{corollary}

\begin{proof}%
\begin{equation}
L\left(  x\ast y\right)  =L_{x\ast y}=L_{x}\circ L_{y}=L\left(  x\right)
\circ L\left(  y\right)  .
\end{equation}

\end{proof}

\begin{lemma}%
\begin{equation}
R_{x}\circ R_{y}=R_{y\ast x}%
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left(  R_{x}\circ R_{y}\right)  \left(  z\right)  =R_{x}\left(  R_{y}\left(
z\right)  \right)  =R_{x}\left(  z\ast y\right)  =z\ast y\ast x
\end{equation}
and
\begin{equation}
R_{y\ast x}\left(  z\right)  =z\ast y\ast x
\end{equation}
hence
\begin{equation}
R_{x}\circ R_{y}=R_{y\ast x}.
\end{equation}

\end{proof}

\begin{corollary}%
\begin{equation}
R:S\rightarrow\operatorname*{End}\left\{  S\right\}
\end{equation}
given by
\begin{equation}
R\left(  x\right)  =R_{x}%
\end{equation}
is an \underline{anti }homomorphism.
\end{corollary}

\begin{proof}%
\begin{equation}
R\left(  x\ast y\right)  =R_{x\ast y}=R_{y}\circ R_{x}=R\left(  y\right)
\circ R\left(  x\right)  .
\end{equation}

\end{proof}

\begin{remark}
With respect to the operation $"\ast"$ left and right multiplication are
connected by
\begin{equation}
L_{x}\left(  y\right)  =x\ast y=R_{y}\left(  x\right)
\end{equation}

\end{remark}

\begin{remark}
The left associative law can be expressed as%
\begin{equation}
L_{x}(y+z)=L_{x}(y)+L_{x}(z)
\end{equation}

\end{remark}

\begin{remark}
The right associative law can be expressed as%
\begin{equation}
R_{x}(y+z)=R_{x}(y)+R_{x}(z)
\end{equation}

\end{remark}

\begin{definition}
Formally, a binary operation $\ast$ on a set $S$ is called
\underline{\emph{associative}} if it satisfies the
\underline{\emph{associative law}}:%
\begin{equation}
(x\ast y)\ast z=x\ast(y\ast z)\,\forall\,x,y,z\in S
\end{equation}
Here, $\ast$ is used to replace the symbol of the operation, which may be any
symbol, and even the absence of symbol (juxtaposition) as for multiplication.%
\begin{equation}
(xy)z=x(yz)=xyz\,\forall\,x,y,z\in S
\end{equation}
The associative law can also be expressed in functional notation thus:
\begin{equation}
f(f(x,y),z)=f(x,f(y,z)).
\end{equation}

\end{definition}

\begin{remark}
The associative law can be expressed as
\begin{equation}
L_{x\ast y}\left(  z\right)  =L_{x}\left(  y\right)  \ast z=x\ast L_{y}\left(
z\right)  .
\end{equation}

\end{remark}

\begin{remark}
\begin{enumerate}
\item A \textbf{module} $\mathcal{M}$ has an abelian group structure with
multiplication $"+"$, inverse $"-"$ and identity $"0"$ i.e.

\begin{enumerate}
\item
\begin{equation}
a+b=b+a.
\end{equation}


\item
\begin{equation}
a-a=0.
\end{equation}


\item
\begin{equation}
a+0=0+a=a.
\end{equation}

\end{enumerate}

\item Scalar linear operators $s\in\mathcal{L}\left(  \mathcal{M}\right)
\subset\operatorname*{End}\left\{  \mathcal{M}\right\}  $ that are abelian
group automorphisms
\begin{equation}
s:\mathcal{M\rightarrow M},
\end{equation}
where
\begin{equation}
s\left(  a\right)  \equiv sa\in\mathcal{M}%
\end{equation}
and
\begin{equation}
s\left(  a+b\right)  =s\left(  a\right)  +s\left(  b\right)
\end{equation}
that form a division ring $\mathsf{R}$ that produces scalar multiplication in
$\mathcal{M}.$

\item The linear operators $s$ are generated by scalar multiplication from the
right or scalar multiplication from the left.
\end{enumerate}
\end{remark}

\begin{remark}
When you replace \textquotedblleft vector space\textquotedblright\ with
\textquotedblleft module\textquotedblright\ in the definition of an algebra,
the resulting mathematical structure is called a \emph{module over an algebra}
or more simply an \emph{algebraic module}.
\end{remark}

\begin{remark}
An \emph{algebraic module }is a module (as defined in abstract algebra) that
interacts with an algebra.
\end{remark}

\begin{remark}
\begin{enumerate}
\item An \emph{algebraic module} $\mathcal{A}$ has in general a non
commucative a group structure with multiplication $"\cdot"$ and identity
$I_{\mathcal{A}}$ i.e.

\begin{enumerate}
\item
\begin{equation}
\cdot:\mathcal{A}\times\mathcal{A}\rightarrow\mathcal{A}%
\end{equation}
i.e.
\begin{equation}
\cdot\left(  a,b\right)  =a\cdot b\in\mathcal{A}%
\end{equation}
A multiplicative inverse $I_{\mathcal{A}}$ with the properties

\item
\begin{equation}
aa^{-1}=a^{-1}a=I_{\mathcal{A}}%
\end{equation}


\item
\begin{equation}
I_{\mathcal{A}}a=aI_{\mathcal{A}}=a.
\end{equation}

\end{enumerate}

\item $\mathcal{A}$ has an abelian group structure that provides the linear
structure with multiplication $"+"$, inverse $"-"$ and identity $"0"$ i.e.

\begin{enumerate}
\item
\begin{equation}
a+b=b+a.
\end{equation}


\item
\begin{equation}
a-a=0.
\end{equation}


\item
\begin{equation}
a+0=0+a=a.
\end{equation}

\end{enumerate}

\item Scalar linear operators $s\in\mathcal{L}\left(  \mathcal{A}\right)  $
that are produced by left action
\begin{equation}
s_{l}:\mathcal{A\rightarrow A}%
\end{equation}
i.e.
\begin{equation}
s_{l}\left(  a\right)  =sa\in\mathcal{A}%
\end{equation}
and
\begin{equation}
s_{l}\left(  a+b\right)  =sa+sb
\end{equation}
that form a division ring $\mathsf{R}.$

\item Scalar linear operators $s\in\mathcal{L}\left(  \mathcal{A}\right)  $
that are produced by right action
\begin{equation}
s_{r}:\mathcal{A\rightarrow A}%
\end{equation}
i.e.
\begin{equation}
s_{r}\left(  a\right)  =as\in\mathcal{A}%
\end{equation}
and
\begin{equation}
s_{r}\left(  a+b\right)  =as+bs
\end{equation}
that form a division ring $\mathsf{R}.$
\end{enumerate}
\end{remark}

\begin{example}
In a algebra
\begin{equation}
abxy=baxy
\end{equation}
but in an \emph{algebraic module}
\begin{equation}
abxy\neq baxy.
\end{equation}

\end{example}

\begin{remark}
$x_{1},x_{2},y_{1},y_{2}\in S;$ $a_{1},a_{2},b_{1},b_{2}\in\mathsf{R}$
multiplication in an algebraic module is given by
\begin{align}
z  &  =\left(  a_{1}x_{1}+b_{1}y_{1}\right)  \left(  a_{2}x_{2}+b_{2}%
y_{2}\right)  =a_{1}x_{1}\left(  a_{2}x_{2}+b_{2}y_{2}\right)  +b_{1}%
y_{1}\left(  a_{2}x_{2}+b_{2}y_{2}\right) \\
&  =a_{1}x_{1}a_{2}x_{2}+a_{1}x_{1}b_{2}y_{2}+b_{1}y_{1}a_{2}x_{2}+b_{1}%
y_{1}b_{2}y_{2}\\
&  =a_{1}x_{1}a_{2}x_{2}+a_{1}x_{1}b_{2}y_{2}+b_{1}y_{1}a_{2}x_{2}+b_{1}%
y_{1}b_{2}y_{2}%
\end{align}
so scalar multiplication must be defined from the right and left on the
elements of the set $\mathcal{S}$, thus $\mathsf{R}$ has to be a bilateral
module wrt to its action on $S.$
\end{remark}

\begin{summary}
\begin{enumerate}
\item A vector space $V$ is an abelian group $S$

\begin{enumerate}
\item with

\begin{enumerate}
\item a commutative multiplication denoted by $"+"$ i.e.
\begin{equation}
s_{1}+s_{2}=s_{2}+s_{1}\in S
\end{equation}


\item an identity element denoted by $"0"$ i.e.
\begin{equation}
0+s=s
\end{equation}


\item an inverse operation denoted by $"-"$ i.e
\begin{equation}
s-s=0
\end{equation}

\end{enumerate}

\item equipped with a scalar multiplication produced by

\begin{enumerate}
\item an associated \underline{\emph{Field}} (commutative Division Ring),
which is denoted by $\mathbb{F},$ of group endomorphisms $a\in
\operatorname{ScalF}\left\{  S\right\}  \subset\operatorname*{End}\left\{
S\right\}  $%
\begin{equation}
a\left(  s_{1}+s_{2}\right)  =a\left(  s_{1}\right)  +a\left(  s_{2}\right)  .
\end{equation}


\item where the Field (commutative Division Ring) product is denoted by
$"\ast"$ and the addition in the field by $"+".$

\item these endomorphisms are actually isomorphisms as
\begin{equation}
a\left(  s\right)  =0\Leftrightarrow s=0.
\end{equation}


\item the associated field of endomorphisms form a group of automorphisms
$\operatorname*{Aut}\left\{  \mathcal{S}\right\}  $ of $\mathcal{S}.$

\item the action of $\operatorname{ScalF}\left\{  S\right\}  \subset
\operatorname*{Aut}\left\{  \mathcal{S}\right\}  $ on $S$ is associative
\begin{equation}
\left(  a\ast b\right)  \left(  s_{1}+s_{2}\right)  =\left(  a\ast b\right)
\left(  s_{1}\right)  +\left(  a\ast b\right)  \left(  s_{2}\right)  =a\left(
b\left(  s_{1}\right)  \right)  +a\left(  b\left(  s_{2}\right)  \right)
\end{equation}

\end{enumerate}

\item
\begin{equation}
V=\left\{  S,\operatorname{ScalF}\left\{  S\right\}  \right\}
\end{equation}

\end{enumerate}

\item A module $\mathcal{M}$ is

\begin{enumerate}
\item an abelian group $S$ with

\begin{enumerate}
\item a multiplication denoted by $"+"$ i.e.
\begin{equation}
s_{1}+s_{2}=s_{2}+s_{1}\in S
\end{equation}


\item an identity element denoted by $"0"$ i.e.
\begin{equation}
0+s=s
\end{equation}


\item an inverse operation denoted by $"-"$ i.e
\begin{equation}
s-s=0
\end{equation}

\end{enumerate}

\item equipped with a scalar multiplication produced by

\begin{enumerate}
\item an associated \underline{\emph{Ring}} \textsf{R }of group endomorphisms
$a\in\operatorname*{ScalM}\left\{  S\right\}  \subset\operatorname*{End}%
\left\{  S\right\}  $%
\begin{equation}
a\left(  s_{1}+s_{2}\right)  =a\left(  s_{1}\right)  +a\left(  s_{2}\right)  .
\end{equation}


\item where the Ring product is denoted by $"\ast"$ and the addition in the
field by $"+".$

\item these endomorphisms might not be isomorphisms
\begin{equation}
a\left(  s\right)  =0\neq s=0
\end{equation}
as it is possible
\begin{equation}
a_{1}\ast a_{2}=0\text{ where }a_{1}\neq0\text{ and }a_{2}\neq0\quad\text{for
}a_{1},a_{2}\in\mathsf{R.}%
\end{equation}


\item the action of $\operatorname*{ScalM}\left\{  S\right\}  $ on $S$ is
associative i.e.
\begin{equation}
\left(  a\ast b\right)  \left(  s\right)  =a\left(  b\left(  s_{1}\right)
\right)
\end{equation}


\item and distibutive i.e.
\begin{equation}
a\left(  s_{1}+s_{2}\right)  =a\left(  s_{1}\right)  +a\left(  s_{2}\right)
\end{equation}

\end{enumerate}

\item
\begin{equation}
\mathcal{M}=\left\{  S,\operatorname*{ScalM}\left\{  S\right\}  \right\}
\end{equation}

\end{enumerate}

\item An \underline{Algebra $\mathcal{A}$} is a vector space $V$ that has an
additional \emph{Semi Group} structure endowered by

\begin{enumerate}
\item a multiplication operation $"\cdot"$ i.e.
\begin{equation}
v_{1}\cdot v_{2}\in V
\end{equation}


\item that is distributive wrt $"+"$ operation in $V$ i.e.
\begin{equation}
v\cdot\left(  w_{1}+w_{2}\right)  =v\cdot w_{1}+v\cdot w_{2}%
\end{equation}


\item
\begin{equation}
v\cdot a\left(  w\right)  =a\left(  v\cdot w\right)
\end{equation}%
\begin{equation}
a\left(  w\right)  \cdot v=a\left(  w\cdot v\right)
\end{equation}


\item a two sided identity element denoted by $"I\,"$ i.e.
\begin{equation}
vI=Iv=v
\end{equation}


\item a subset $\operatorname{inv}\left\{  V\right\}  $ of $V$ that have two
sided $\cdot$-inverses i.e.%
\begin{equation}
vv^{-1}=v^{-1}v=I
\end{equation}


\item
\begin{equation}
a\left(  v_{1}\right)  \cdot b\left(  v_{2}\right)  =\left(  ab\right)
\left(  v_{1}\cdot v\right)
\end{equation}

\end{enumerate}

\item An \underline{\emph{Algebraic Module }$\mathcal{A}_{m}$} is a module
$\mathcal{M}$ that has an additional \emph{Semi Group} structure endowered by

\begin{enumerate}
\item a multiplication operation $"\ast"$ i.e.
\begin{equation}
v\ast w\in\mathcal{M}%
\end{equation}
that is distributive wrt $"+"$ operation in $\mathcal{M}$ i.e.
\begin{equation}
v\ast\left(  w_{1}+w_{2}\right)  =v\ast w_{1}+v\ast w_{2}%
\end{equation}


\item $\operatorname*{ScalM}\left\{  S\right\}  $ is not distrubutive wrt
$"\ast"$ as
\begin{equation}
a\left(  v\ast w\right)  =v\ast a\left(  w\right)  =a\left(  v\right)  \ast w
\end{equation}
but notice
\begin{equation}
a\left(  v_{1}\ast v_{2}\right)  \neq a\left(  v_{1}\right)  \ast a\left(
v_{2}\right)
\end{equation}
but it is associative i.e.
\begin{equation}
\left(  a\cdot b\right)  \left(  v\right)  =a\left(  b\left(  v\right)
\right)
\end{equation}


\item a two sided identity element denoted by $"I\,"$ i.e.
\begin{equation}
v\ast I=I\ast v=v
\end{equation}


\item a subset $\operatorname{inv}\left(  V\right)  $ of $V$ that have two
sided $\ast$-inverses i.e.%
\begin{equation}
v\ast v^{-1}=v^{-1}\ast v=I
\end{equation}

\end{enumerate}

\item
\begin{equation}
a\left(  v_{1}\ast v_{2}\right)  =v_{1}\ast a\left(  v_{2}\right)  =a\left(
v_{1}\right)  \ast v_{2}%
\end{equation}

\end{enumerate}
\end{summary}

\begin{remark}
The Clifford algebra
\begin{equation}
\mathcal{A}=Cl(V,Q)
\end{equation}
is the \emph{"freest"} unital associative algebra generated by $V$. The idea
of being the "freest" or "most general" algebra subject to this identity can
be formally expressed through the notion of a universal property.
\end{remark}

\begin{notation}
When $V$ is a finite-dimensional \textbf{real} vector space and $Q$ is
nondegenerate, $Cl(V,Q)$ may be identified by the label $Cl\left(
p,q,\mathbb{R}\right)  $, indicating that $V$ has an orthogonal basis
$\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ with $p$ elements
with%
\begin{equation}
e_{j}^{2}=+I_{\mathcal{A}},\quad1\leq j\leq p
\end{equation}
and $q$ elements with
\begin{equation}
e_{j}^{2}=-I_{\mathcal{A}},\,\quad p+1\leq j\leq r,
\end{equation}
where $\mathbb{R}$ indicates that this is a Clifford algebra over the reals;
i.e. coefficients of elements of the algebra are real numbers.
\end{notation}

\paragraph{Free Algebra \label{Free Algebra}}

The free algebra generated by $V$ (which may be a quaternionic linear space)
may be written as the tensor algebra
\begin{equation}%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  V\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq\infty}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq\infty}}
%EndExpansion
{\large \otimes}^{n}V,
\end{equation}
that is, the direct sum of the tensor product of $n$ copies of $V$ over all
$n$. Therefore one obtains a Clifford algebra as \emph{the quotient}
\begin{equation}
\frac{%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  V\right)  }{\mathcal{I}_{Q}}%
\end{equation}
of this tensor algebra by the two-sided ideal $\mathcal{I}_{Q}$ generated by
elements of the form%
\begin{equation}
\mathcal{I}_{Q}=\left\{  \left.  \overset{}{\mathfrak{i}\left(  v,Q\right)
}\right\vert \mathfrak{i}\left(  v,Q\right)  =v\otimes v-Q\left(  v\right)
I_{\mathcal{A}},\quad v\in V\right\}  .
\end{equation}


\begin{remark}
The product induced by the tensor product in the quotient algebra is written
using juxtaposition (e.g. $uv$ or $u\cdot v$). Its associativity follows from
the associativity of the tensor product.
\end{remark}

The Clifford algebra has a distinguished subspace~$V$, that is the \emph{image
of the embedding map of }$V$ into $Cl(V,Q)$. Such a subspace \emph{cannot} in
general be uniquely determined if one is only given a $\mathbb{F}$-algebra
that is isomorphic to the Clifford algebra.

If $2$ is invertible in the ground field $\mathbb{F}$, then one can rewrite
the fundamental identity above in the form%

\begin{equation}
\left\{  u,v\right\}  =uv+vu=\left\langle \left.  u\right\vert v\right\rangle
_{V}I_{\mathcal{A}}~~\forall u,v\in V,
\end{equation}
where%

\begin{equation}
\left\langle \left.  u\right\vert v\right\rangle _{V}=\frac{1}{2}\left(
\overset{}{Q(u+v)-Q(u)-Q(v)}\right)
\end{equation}
is the symmetric bilinear form associated with $Q$, via the polarization identity.

\begin{remark}
Quadratic forms and Clifford algebras in characteristic $2$ form an
exceptional case in this respect. In particular, if $\operatorname{char}%
(\mathbb{F})=2$ it is not true that a quadratic form necessarily or uniquely
determines a symmetric bilinear form that satisfies
\begin{equation}
Q(v)=\left\langle \left.  v\right\vert v\right\rangle _{V}.
\end{equation}

\end{remark}

\begin{remark}
Usually one includes the condition that the characteristic is not 2, and are
false if this condition is removed.
\end{remark}

\paragraph{Quantization of the Associated Exterior Algebra
\label{Associated Exterior Algebra}}

Clifford algebras are closely related to exterior algebras. Indeed, if $Q=0$
then the Clifford algebra $Cl(V,Q)$ is just the exterior algebra $\U{22c0}
\left(  V\right)  $. Whenever $2$ is invertible in the ground
field~$\mathbb{F}$, there exists a canonical linear isomorphism between
$\U{22c0} \left(  V\right)  $ and $Cl(V,Q)$. That is, they are naturally
isomorphic as linear spaces, but with different multiplications (in the case
of characteristic two, they are still isomorphic as vector spaces, just not
naturally). Clifford multiplication together with the distinguished subspace
$V$ is strictly richer than the exterior product since it makes use of the
extra information provided by~$Q$.

\begin{remark}
The Clifford algebra is a \emph{filtered algebra}; the associated \emph{graded
algebra} is the exterior algebra.
\end{remark}

\begin{remark}
More precisely, \emph{Clifford} algebras may be thought of as
\emph{quantizations} of the exterior algebra, in the same way that the
\emph{Weyl} algebra is a quantization of the symmetric algebra.
\end{remark}

\subsection{Polynomial Algebra}

A Clifford Algebra is a graded polynomial algebra $\mathcal{A}$ generated by a
basis $\left\{  I,\left\{  \left.  x_{j}\right\vert 1\leq j\leq\infty\right\}
\right\}  =$ $\left\{  \left.  x_{j}\right\vert 0\leq j\leq\infty\right\}  $
that satisfies
\begin{equation}
\left\{  x_{j},x_{k}\right\}  =\delta_{jk}I=\delta_{jk}x_{0};\quad1\leq
j,k\leq\infty
\end{equation}
together with a complex symmetric bilinear form
\begin{equation}
\left(  \left.  {}\right\vert \right)  :\mathcal{A\times A}\rightarrow
\mathbb{C}%
\end{equation}
given by
\begin{equation}
\left(  \left.  x_{j_{1}}\cdots x_{j_{n}}\right\vert x_{k_{1}}\cdots x_{k_{m}%
}\right)  =\delta_{j_{1}\cdots j_{n}k_{1}\cdots k_{m}}\in\mathbb{C},\quad0\leq
j_{1}<\cdots<j_{n}\leq\infty,0\leq k_{1}<\cdots<k_{m}\leq\infty,0\leq
m,n\leq\infty.
\end{equation}


\begin{remark}%
\begin{align}
\left\{  x_{j},x_{j}\right\}   &  =2x_{j}^{2}=x_{0}^{2}=I_{\mathcal{A}}\\
&  \Updownarrow\\
x_{j}^{2}  &  =\frac{1}{\sqrt{2}}I_{\mathcal{A}}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\left\{  \left(  x_{j_{1}}\cdots x_{j_{n}}\right)  ^{t},x_{j_{1}}\cdots
x_{j_{n}}\right\}  =x_{j_{n}}\cdots x_{j_{1}}x_{j_{1}}\cdots x_{j_{n}%
}+x_{j_{1}}\cdots x_{j_{n}}x_{j_{n}}\cdots x_{j_{1}}=2^{n}I_{\mathcal{A}}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \left.  A\right\vert B\right)  =\left(  \left.  \sum_{1\leq
j\leq\infty}A_{j}x_{j}\right\vert \sum_{1\leq j\leq\infty}B_{j}x_{j}\right)
=\sum_{1\leq j,k\leq\infty}A_{j}B_{k}\left(  \left.  x_{j}\right\vert
x_{k}\right)  =\sum_{1\leq j,k\leq\infty}A_{j}B_{k}\delta_{jk}=\sum_{1\leq
j,k\leq\infty}A_{j}B_{j};\quad A_{j},B_{j}\in\mathbb{C},\quad1\leq j\leq\infty
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\left(  \left.  A\right\vert A\right)  =0\nRightarrow A=0
\end{equation}
\emph{Hence neither }$\left(  \left.  A\right\vert A\right)  $\emph{ nor
}$\left\vert \left(  \left.  A\right\vert A\right)  \right\vert $\emph{
produce a norm, though }$\left\vert \left(  \left.  A\right\vert A\right)
\right\vert $ is a \emph{seminorm}.
\end{remark}

\begin{remark}%
\begin{equation}
\left\vert z\right\vert ^{2}=\,\overset{\_}{z}z=\left(  \operatorname{Re}%
\left\{  z\right\}  -i\operatorname{Im}\left\{  z\right\}  \right)  \left(
\operatorname{Re}\left\{  z\right\}  +i\operatorname{Im}\left\{  z\right\}
\right)  =\left(  \operatorname{Re}\left\{  z\right\}  ^{2}+\operatorname{Im}%
\left\{  z\right\}  ^{2}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
z^{2}  &  =\,zz=\left(  \operatorname{Re}\left\{  z\right\}
+i\operatorname{Im}\left\{  z\right\}  \right)  \left(  \operatorname{Re}%
\left\{  z\right\}  +i\operatorname{Im}\left\{  z\right\}  \right)  =\left(
\operatorname{Re}\left\{  z\right\}  ^{2}-\operatorname{Im}\left\{  z\right\}
^{2}\right)  +2\operatorname{Re}\left\{  z\right\}  \operatorname{Im}\left\{
z\right\}  i\\
\overset{\_}{z}^{2}  &  =\,\overset{\_}{z}\overset{\_}{z}=\left(
\operatorname{Re}\left\{  z\right\}  -i\operatorname{Im}\left\{  z\right\}
\right)  \left(  \operatorname{Re}\left\{  z\right\}  -i\operatorname{Im}%
\left\{  z\right\}  \right)  =\left(  \operatorname{Re}\left\{  z\right\}
^{2}-\operatorname{Im}\left\{  z\right\}  ^{2}\right)  -2\operatorname{Re}%
\left\{  z\right\}  \operatorname{Im}\left\{  z\right\}  i,
\end{align}
hence if
\begin{equation}
\operatorname{Re}\left\{  z\right\}  ^{2}=\operatorname{Im}\left\{  z\right\}
^{2}%
\end{equation}
then
\begin{equation}
z^{2}=2i\operatorname{Re}\left\{  z\right\}  \operatorname{Im}\left\{
z\right\}
\end{equation}
and
\begin{equation}
\,\overset{\_}{z}^{2}=-2i\operatorname{Re}\left\{  z\right\}
\operatorname{Im}\left\{  z\right\}  .
\end{equation}

\end{remark}

\begin{remark}
Let
\begin{equation}
A=zx_{1}+\overset{\_}{z}x_{2}=\left(  \operatorname{Re}\left\{  z\right\}
+i\operatorname{Im}\left\{  z\right\}  \right)  x_{1}+\left(
\operatorname{Re}\left\{  z\right\}  -i\operatorname{Im}\left\{  z\right\}
\right)  x_{2}%
\end{equation}
then
\begin{equation}
A^{2}=z^{2}x_{1}^{2}+\,\overset{\_}{z}^{2}x_{1}^{2}=2^{n}\left(
z^{2}+\,\overset{\_}{z}^{2}\right)  I_{\mathcal{A}}=0.
\end{equation}

\end{remark}

\subsection{Trace}

The multiplicative unit is $I_{\mathcal{A}}$ and has the properties\qquad

\begin{enumerate}
\item
\begin{equation}
\left\langle I_{\mathcal{A}}\right\rangle _{0}=I_{\mathcal{A}}%
\end{equation}


\item
\begin{equation}
\left\langle \alpha I_{\mathcal{A}}\right\rangle _{0}=\alpha I_{\mathcal{A}%
};\alpha\in\mathbb{C}.
\end{equation}


\item
\begin{equation}
I_{\mathcal{A}}A=AI_{\mathcal{A}}=A\quad\forall A\in\mathcal{A}.
\end{equation}

\end{enumerate}

\begin{definition}
One can define a $\mathcal{F}$\emph{-valued} trace on $\mathcal{F}$ by
\begin{equation}
\operatorname*{Trace}\left\{  A\right\}  =\left\langle A\right\rangle _{0}.
\end{equation}

\end{definition}

This has the trace properties as it is symmetric
\begin{equation}
\left\langle A_{1}A_{2}\right\rangle _{0}=\left\langle A_{2}A_{1}\right\rangle
_{0},
\end{equation}
which leads to the cyclic property
\begin{equation}
\left\langle A_{1}A_{2}\cdots A_{k}\right\rangle _{0}=\left\langle A_{2}\cdots
A_{k}A_{1}\right\rangle _{0}=\left\langle A_{p}\cdots A_{k}A_{1}\cdots
A_{p-1}\right\rangle _{0}.
\end{equation}
One can introduce \emph{a} linear functional -\emph{a} \emph{normalized trace
or weight}, $\operatorname*{tr},$%
\begin{align}
\operatorname*{tr}  &  :\mathcal{F}\longrightarrow\mathbb{C}\\
\operatorname*{tr}\left\{  A\right\}   &  =\left\langle \left\langle
A\right\rangle \right\rangle _{0}\in\mathbb{C},
\end{align}
that has the properties
\begin{equation}
\left(  \left.  A\right\vert B\right)  =\operatorname*{tr}\left\{
A^{t}B\right\}
\end{equation}
and%
\begin{align}
\left\langle A\right\rangle _{0}  &  =\operatorname*{tr}\left\{  A\right\}
I_{\mathcal{F}}\\
\operatorname*{tr}\left\{  I_{\mathcal{F}}\right\}   &  =1\\
\operatorname*{tr}\left\{  \alpha I_{\mathcal{F}}\right\}   &  =\alpha\\
\operatorname*{tr}\left\{  A+B\right\}   &  =\operatorname*{tr}\left\{
A\right\}  +\operatorname*{tr}\left\{  B\right\} \\
\operatorname*{tr}\left\{  AB\right\}   &  =\operatorname*{tr}\left\{
BA\right\} \\
\operatorname*{tr}\left\{  ABC\right\}   &  =\operatorname*{tr}\left\{
CAB\right\}  =\operatorname*{tr}\left\{  BCA\right\} \\
\left\langle A^{\dagger}B\right\rangle _{0}  &  =\operatorname*{tr}\left\{
A^{\dagger}B\right\}  I_{\mathcal{F}}\\
\left\vert A\right\vert _{2\operatorname*{tr}}^{2}  &  =\left\langle
A^{\dagger}A\right\rangle _{0}=\operatorname*{tr}\left\{  A^{\dagger
}A\right\}  I_{\mathcal{F}}\\
\left\Vert A\right\Vert _{2\operatorname*{tr}}^{2}  &  =\operatorname*{tr}%
\left\{  A^{\dagger}A\right\}  .
\end{align}
In finite dimensions
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =2^{-r}\operatorname*{Tr}\left\{
A\right\}  ,
\end{equation}
where $\operatorname*{Tr}$ is the \emph{normal trace} in a Fock representation
i.e.
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\sum_{0\leq p\leq r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\left\vert A\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle
=\sum_{0\leq p\leq r}\left.  \operatorname*{Tr}\right.  _{p}\left\{
A\right\}  ,
\end{equation}
where $\left\{  \varphi_{j_{1}},\cdots,\varphi_{j_{r}}\right\}  $ is a conb of
$\mathcal{H}^{1}$,
\begin{equation}
\left.  \operatorname*{Tr}\right.  _{p}\left\{  A\right\}  =\operatorname*{Tr}%
\left\{  AP_{p}\right\}
\end{equation}
and $P_{p}$ is the orthogonal projector onto $\mathcal{H}^{p}.$

The preceeding relationship betwee $\operatorname*{tr}$ and
$\operatorname*{Tr}$ is also valid in an abstract Clifford/CAR\ that have Type
I representations, where $A$ must be a trace class operator.

\begin{remark}
However although
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\infty\text{ if }A\notin\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
one has
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\frac{\infty}{2^{\infty}}%
\end{equation}
so the set of operators that satisfy
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  <\infty
\end{equation}
is not obvious.
\end{remark}

\subparagraph{Comparing $\operatorname*{tr}$ and $\operatorname*{Tr}$}

Since
\begin{equation}
\operatorname*{tr}\left\{  I_{2^{r}}\right\}  =2^{-r}\operatorname*{Tr}%
\left\{  I_{2^{r}}\right\}  =2^{-r}2^{r}=1
\end{equation}
one has
\begin{equation}
\lim\limits_{r\rightarrow\infty}\left\{  \operatorname*{tr}\left\{  I_{2^{r}%
}\right\}  \right\}  =1.
\end{equation}
If $P_{r}$ is an orthogonal projector belonging to the $2^{2r}$ dimensional
CAR\ algebra then
\begin{equation}
\operatorname*{Tr}\left\{  I_{2^{r}}-P_{r}\right\}  \geq0
\end{equation}
and
\begin{equation}
1\geq\frac{\operatorname*{Tr}\left\{  I_{2^{r}}-P_{r}\right\}  }{2^{r}%
}=\operatorname*{tr}\left\{  I_{2^{r}}-P_{r}\right\}  \geq0.
\end{equation}
Thus
\begin{equation}
1\geq\lim\limits_{r\rightarrow\infty}\left\{  \frac{\operatorname*{Tr}\left\{
I_{2^{r}}-P_{r}\right\}  }{2^{r}}\right\}  =\lim\limits_{r\rightarrow\infty
}\left\{  \operatorname*{tr}\left\{  I_{2^{r}}-P_{r}\right\}  \right\}  \geq0,
\end{equation}
so
\begin{equation}
1\geq\lim\limits_{r\rightarrow\infty}\left\{  \operatorname*{tr}\left\{
P_{r}\right\}  \right\}  \geq0.
\end{equation}


\begin{lemma}
If $P_{r}$ are $1$-dimensional projectors then
\begin{equation}
\lim\limits_{r\rightarrow\infty}\left\{  \operatorname*{tr}\left\{
P_{r}\right\}  \right\}  =0,
\end{equation}
thus such projectors \emph{are not present} in representations of infinite
dimensional algebras with normalized trace e.g. Type $II_{1}$ VnA's.
\end{lemma}

$\lceil$ Example $\mathcal{F}$ for $r=4$
\begin{align}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\right\}   &  =1+\binom{3}%
{1}+\binom{3}{2}+\binom{3}{3}=1+3+3+1=8\\
2^{4}  &  =16
\end{align}
as
\begin{align}
&  \left\{  \sum_{1\leq p\leq4}\sum_{1\leq j_{1}<\cdots<j_{p}\leq
4}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert a_{j}^{\dagger
}a_{j}\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle \right\} \\
&  =\sum_{1\leq j_{1}\leq4}\left\langle \varphi_{j_{1}}\left\vert
a_{j}^{\dagger}a_{j}\varphi_{j_{1}}\right.  \right\rangle +\sum_{1\leq
j_{1}<j_{2}\leq4}\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\left\vert
a_{j}^{\dagger}a_{j}\varphi_{j_{1}}\varphi_{j_{2}}\right.  \right\rangle \\
&  +\sum_{1\leq j_{1}<j_{2}<j_{3}\leq4}\left\langle \varphi_{j_{1}}%
\varphi_{j_{2}}\varphi_{j_{3}}\left\vert a_{j}^{\dagger}a_{j}\varphi_{j_{1}%
}\varphi_{j_{2}}\varphi_{j_{3}}\right.  \right\rangle +\left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\left\vert a_{j}^{\dagger}%
a_{j}\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right.  \right\rangle \\
&  =1+3+3+1=8.
\end{align}
Thus
\begin{equation}
\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  =\frac{1}{2}%
\end{equation}
$\rfloor$

In general for any $r$ the trace of the particle projectors
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  =\operatorname*{Tr}%
\left\{  n_{j}\right\}  =1+\binom{r-1}{1}+\binom{r-1}{2}+\cdots+\binom
{r-1}{r-1}=2^{r-1},
\end{equation}
gives%
\begin{equation}
\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  =\operatorname*{Tr}%
\left\{  n_{j}\right\}  =\frac{\operatorname*{Tr}\left\{  a_{j}^{\dagger}%
a_{j}\right\}  }{2^{r}}=\frac{2^{r-1}}{2^{r}}=\frac{1}{2}.
\end{equation}


\begin{remark}%
\begin{equation}
\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  A\right\}  =\operatorname*{Tr}%
\left\{  P_{\mathcal{H}^{1}}A\right\}  =\operatorname*{Tr}\left\{
P_{\mathcal{H}^{1}}AP_{\mathcal{H}^{1}}\right\}
\end{equation}
thus if $A\in\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  $ then
\begin{equation}
\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  A\right\}  =\operatorname{Tr}%
\left\{  A\right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  a_{j}^{\dagger}a_{k}\right\}
=\delta_{jk};1\leq j,k\leq r.
\end{equation}

\end{remark}

\begin{remark}
If $A\in\mathcal{B}_{1}\left(  \mathcal{H}^{1}\right)  $ then%
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\frac{1}{2^{r}}\operatorname{Tr}%
_{\mathcal{H}^{1}}\left\{  A\right\}  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\operatorname*{tr}\left\{  P_{\mathcal{H}^{1}}\right\}  =\frac{1}{2^{r}%
}\operatorname{Tr}_{\mathcal{H}^{1}}\left\{  P_{\mathcal{H}^{1}}\right\}
=\frac{r}{2^{r}}%
\end{equation}

\end{remark}

For any one particle operator one thus obtains
\begin{align}
\operatorname*{tr}\left\{  \sum_{1\leq j,k\leq r}A_{jk}a_{j}^{\dagger}%
a_{k}\right\}   &  =\frac{1}{2^{r}}\operatorname*{Tr}\left\{  \sum_{1\leq
j,k\leq r}A_{jk}a_{j}^{\dagger}a_{k}\right\}  =\frac{1}{2^{r}}\left\{
\sum_{0\leq p\leq r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq r}\left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert \sum_{1\leq j,k\leq r}%
A_{jk}a_{j}^{\dagger}a_{k}\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.
\right\rangle \right\} \\
&  =\frac{1}{2^{r}}\left\{  \sum_{1\leq p\leq r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert
\sum_{1\leq j\leq r}A_{jj}a_{j}^{\dagger}a_{j}\varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right.  \right\rangle \right\} \\
&  =\frac{1}{2^{r}}\left\{  \sum_{1\leq j\leq r}A_{jj}\sum_{1\leq p\leq r}%
\sum_{1\leq j_{1}<\cdots<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{p}}\left\vert a_{j}^{\dagger}a_{j}\varphi_{j_{1}}\cdots
\varphi_{j_{p}}\right.  \right\rangle \right\} \\
&  =\frac{1}{2}\operatorname{Tr}\left\{  \mathbb{A}\right\}  .
\end{align}


The trace of pair projectors is given by
\begin{align}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}\right\}
&  =\operatorname*{Tr}\left\{  n_{k}n_{j}\right\}  =\left\{  \sum_{2\leq p\leq
r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq r}\left\langle \varphi_{j_{1}}%
\cdots\varphi_{j_{p}}\left\vert a_{j}^{\dagger}a_{k}^{\dagger}a_{k}%
a_{j}\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle \right\} \\
&  =1+\binom{r-2}{1}+\binom{r-2}{2}+\cdots+\binom{r-2}{r-2}=2^{r-2}%
\end{align}
$\lceil$ Example for $r=4$
\begin{align}
&  \operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}%
a_{j}\right\}  =\left\{  \sum_{1\leq p\leq4}\sum_{1\leq j_{1}<\cdots<j_{p}%
\leq4}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}\varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right.  \right\rangle \right\} \\
&  \left.  =\right.  \sum_{1\leq j_{1}<j_{2}\leq4}\left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\left\vert a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}%
\varphi_{j_{1}}\varphi_{j_{2}}\right.  \right\rangle +\sum_{1\leq j_{1}%
<j_{2}<j_{3}\leq4}\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{j_{3}%
}\left\vert a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}\varphi_{j_{1}}%
\varphi_{j_{2}}\varphi_{j_{3}}\right.  \right\rangle +\left\langle \varphi
_{1}\varphi_{2}\varphi_{3}\varphi_{4}\left\vert a_{j}^{\dagger}a_{k}^{\dagger
}a_{k}a_{j}\varphi_{1}\varphi_{2}\varphi_{3}\varphi_{4}\right.  \right\rangle
\\
&  \left.  =\right.  1+2+1=4
\end{align}
$\rfloor$

For any two particle operator one thus obtains%
\begin{align}
&  \operatorname*{tr}\left\{  \sum_{1\leq j<k\leq r}A_{jkjk}a_{j}^{\dagger
}a_{k}^{\dagger}a_{k}a_{j}\right\}  =\frac{1}{2^{r}}\operatorname*{Tr}\left\{
\sum_{1\leq j<k\leq r}A_{jkjk}a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}\right\}
\\
&  =\frac{1}{2^{r}}\left\{  \sum_{2\leq p\leq r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert
\sum_{1\leq j<k\leq r}A_{jkjk}a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}%
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle \right\}  =\frac
{1}{2^{2}}\left.  \operatorname{Tr}\right.  _{2}\left\{  \mathbb{A}%
_{2}\right\}  .
\end{align}


The trace of $N$-tuple projectors is given by
\begin{align}
\operatorname*{Tr}\left\{  a_{k_{1}}^{\dagger}\cdots a_{k_{N}}^{\dagger
}a_{k_{N}}\cdots a_{k_{1}}\right\}   &  =\operatorname*{Tr}\left\{  n_{k_{N}%
}\cdots n_{k_{1}}\right\}  =\sum_{N\leq p\leq r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert
a_{k_{1}}^{\dagger}\cdots a_{k_{N}}^{\dagger}a_{k_{N}}\cdots a_{k_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle \\
&  =1+\binom{r-N}{1}+\binom{r-N}{2}+\cdots+\binom{r-N}{r-N}=2^{r-N}.
\end{align}
The trace of any $N$-particle operator is thus given by
\begin{align}
\operatorname*{tr}\left\{  A\right\}   &  =\operatorname*{tr}\left\{
\sum_{0\leq k_{1}<\cdots<k_{N}\leq r}A_{k_{1}\cdots k_{N}k_{1}\cdots k_{N}%
}a_{k_{1}}^{\dagger}\cdots a_{k_{N}}^{\dagger}a_{k_{N}}\cdots a_{k_{1}%
}\right\} \\
&  =\frac{1}{2^{r}}\left\{  \sum_{N\leq p\leq r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}}\left\vert
\sum_{1\leq k_{1}<\cdots<k_{N}\leq r}A_{k_{1}\cdots k_{N}k_{1}\cdots k_{N}%
}a_{k_{1}}^{\dagger}\cdots a_{k_{N}}^{\dagger}a_{k_{N}}\cdots a_{k_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle \right\} \\
&  =\frac{1}{2^{r}}\left\{  \sum_{0\leq k_{1}<\cdots<k_{N}\leq r}%
A_{k_{1}\cdots k_{N}k_{1}\cdots k_{N}}\sum_{N\leq p\leq r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\left\vert a_{k_{1}}^{\dagger}\cdots a_{k_{N}}^{\dagger}a_{k_{N}}\cdots
a_{k_{1}}\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle \right\}
\end{align}
leading to the lemma

\begin{lemma}%
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\frac{2^{r-N}}{2^{r}}\operatorname*{Tr}%
\left\{  \mathbb{A}\right\}  =\frac{1}{2^{N}}\left.  \operatorname{Tr}\right.
_{N}\left\{  \mathbb{A}\right\}  .
\end{equation}

\end{lemma}

If $\operatorname*{Tr}\left\{  \mathbb{A}\right\}  =1$ then
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\frac{2^{r-N_{a}}}{2^{r}}=\frac
{1}{2^{N_{a}}},
\end{equation}
so $N_{a}$-particle normal states $f$ expressed in terms of
$\operatorname*{tr}$ are given by
\begin{equation}
f\left(  A\right)  =2^{N_{a}}\operatorname*{tr}\left\{  AD\right\}  ,
\end{equation}
where
\begin{align}
\left[  \mathcal{N}_{a},D\right]   &  =0\\
2^{N_{a}}\operatorname*{tr}\left\{  \mathcal{N}_{a}D\right\}   &  =N_{a}%
\in\mathbb{R}^{+}.
\end{align}


\begin{lemma}%
\begin{equation}
\operatorname*{tr}\left\{  n_{k_{N}}\cdots n_{k_{1}}\right\}  =2^{-N_{a}}.
\end{equation}

\end{lemma}

\subparagraph{Traces and Representations of $\mathcal{A}$}

Two bases for $\mathcal{A}$ are the non self adjoint one $\ $

\begin{enumerate}
\item
\begin{gather}
\left\{  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right\} \\
\parallel\\
\left\{  I_{\mathcal{A}},\left\{  \left.  a_{j_{1}}^{\dagger}\cdots a_{j_{m}%
}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right\vert 1\leq j_{1}<\cdots<j_{m}\leq
r,1\leq k_{1}<\cdots<k_{n}\leq r,1\leq m,n\leq r\right\}  ,\right. \\
\left.  \left\{  \left.  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}\right\vert 1\leq j_{1}<\cdots<j_{m}\leq r,1\leq m\leq r\right\}  \left\{
\left.  a_{k_{1}}\cdots a_{k_{n}}\right\vert 1\leq k_{1}<\cdots<k_{n}\leq
r,1\leq n\leq r\right\}  \right\}
\end{gather}
and

\item the self adjoint one
\begin{equation}
\left\{  \boldsymbol{x}\right\}  =\left\{  I_{\mathcal{A}},\left\{  \left.
x_{j_{1}}\cdots x_{j_{m}}\right\vert 1\leq j_{1}<\cdots<j_{m}\leq2r;1\leq
m\leq2r\right\}  \right\}  .
\end{equation}

\end{enumerate}

Any operator $A\in\mathcal{A}$ can be expanded in these bases as strong
operator limits of

\begin{enumerate}
\item
\begin{align}
A  &  ={\Large a}\left(  A\right)  _{00}I_{\mathcal{A}}+\sum_{1\leq m\leq
r}\sum_{1\leq j_{1}<\cdots<j_{m}\leq r}{\Large a}\left(  A\right)
_{j_{1}\cdots j_{m}0}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}+\sum_{1\leq
n\leq r}\sum_{1\leq k_{1}<\cdots<k_{n}\leq r}{\Large a}\left(  A\right)
_{0k_{1}\cdots k_{n}}a_{k_{n}}\cdots a_{k_{1}}\\
&  +\sum_{1\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(  A\right)  _{j_{1}\cdots
j_{m}k_{1}\cdots k_{n}}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}%
}\cdots a_{k_{1}}%
\end{align}
and

\item
\begin{equation}
A={\LARGE x}\left(  A\right)  _{00}I_{\mathcal{A}}+\sum_{1\leq n\leq2r}%
\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}{\LARGE x}\left(  A\right)  _{j_{1}\cdots
j_{n}}x_{j_{1}}\cdots x_{j_{n}}.
\end{equation}

\end{enumerate}

The GNS\ representation $\Pi_{\varphi}\left(  \mathcal{A}\right)  $ on
$\Phi_{\varphi}$ $\left(  \mathcal{A}\right)  $ is given by
\begin{align}
\Phi_{\varphi}  &  :\mathcal{A}\left/  \ker\left\{  \Phi_{\varphi}\right\}
\right.  \equiv\mathcal{A}\left/  L_{\varphi}\right.  \rightarrow
\mathcal{H}_{\varphi}\\
\Pi_{\varphi}  &  :\mathcal{A}\rightarrow\mathcal{B}\left(  \mathcal{H}%
_{\varphi}\right) \\
\left\langle \left.  \Phi_{\varphi}\left(  A\right)  \right\vert \Phi
_{\varphi}\left(  B\right)  \right\rangle _{\mathcal{H}_{\varphi}}  &
=\varphi\left\{  A^{\dagger}B\right\} \\
\Pi_{\varphi}\left(  X\right)  \Phi_{\varphi}\left(  A\right)   &
=\Phi_{\varphi}\left(  XA\right) \\
\mathcal{B}\left(  \mathcal{A}\right)   &  \supset\mathcal{A},
\end{align}
where
\begin{equation}
\ker\left\{  \Phi_{\varphi}\right\}  =\left\{  \left.  A\right\vert
\varphi\left\{  A^{\dagger}A\right\}  =0,A\in\mathcal{A}\right\}
\end{equation}
is a left ideal $L_{\varphi},$ leading to representations%
\begin{align}
\Pi_{\varphi}\left(  A\right)   &  ={\Large a}\left(  A\right)  _{00}%
\Pi_{\varphi}\left(  I_{\mathcal{A}}\right)  +\sum_{1\leq j_{1}<\cdots
<j_{m}\leq r}{\Large a}\left(  A\right)  _{j_{1}\cdots j_{m}0}\Pi_{\varphi
}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}\right)  +\sum_{1\leq
k_{1}<\cdots<k_{n}\leq r}{\Large a}\left(  A\right)  _{0k_{1}\cdots k_{n}}%
\Pi_{\varphi}\left(  a_{k_{n}}\cdots a_{k_{1}}\right) \\
&  +\sum_{1\leq m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq
r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(  A\right)  _{j_{1}\cdots
j_{m}k_{1}\cdots k_{n}}\Pi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
\end{align}
and%
\begin{equation}
\Pi_{\varphi}\left(  A\right)  ={\LARGE x}\left(  A\right)  _{00}\Pi_{\varphi
}\left(  I_{\mathcal{A}}\right)  +\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}%
<\cdots<j_{n}\leq2r}{\LARGE x}\left(  A\right)  _{j_{1}\cdots j_{n}}%
\Pi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  .
\end{equation}


The metric matrices $\Delta_{\varphi}\left(  \boldsymbol{a}^{\dagger
}\boldsymbol{a}\right)  ,$ $\Delta_{\varphi}\left(  \boldsymbol{x}\right)  $
associated with these bases are
\begin{align}
\left\langle \left.  \Phi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m_{1}}}^{\dagger}a_{k_{n_{1}}}\cdots a_{k_{1}}\right)  \right\vert
\Phi_{\varphi}\left(  a_{l_{1}}^{\dagger}\cdots a_{l_{n_{2}}}^{\dagger
}a_{p_{m_{2}}}\cdots a_{p_{1}}\right)  \right\rangle _{\mathcal{H}_{\varphi}}
&  =\Delta_{\varphi}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)
_{j_{1}\cdots j_{m_{1}}k_{1}\cdots k_{n_{1}}l_{1}\cdots l_{m_{2}}p_{1}\cdots
p_{n_{2}}}\\
&  =\varphi\left(  a_{k_{1}}^{\dagger}\cdots a_{j_{n_{1}}}^{\dagger
}a_{j_{n_{1}}}\cdots a_{j_{1}}a_{l_{1}}^{\dagger}\cdots a_{l_{n_{2}}}%
^{\dagger}a_{p_{m_{2}}}\cdots a_{p_{1}}\right)  ,
\end{align}
where
\begin{align}
1  &  \leq j_{1}<\cdots<j_{m_{1}}\leq r,1\leq k_{1}<\cdots<k_{n_{1}}\leq
r,0\leq m_{1},n_{1}\leq r\\
1  &  \leq l_{1}<\cdots<l_{m_{2}}\leq r,1\leq p_{1}<\cdots<p_{n_{2}}\leq
r,0\leq m_{2},n_{2}\leq r
\end{align}
and
\begin{equation}
\left\langle \left.  \Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{m}}\right)
\right\vert \Phi_{\varphi}\left(  x_{k_{1}}\cdots x_{k_{n}}\right)
\right\rangle _{\mathcal{H}_{\varphi}}=\Delta_{\varphi}\left(  \boldsymbol{x}%
\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}=\varphi\left(  x_{j_{m}}\cdots
x_{j_{1}}x_{k_{1}}\cdots x_{k_{n}}\right)  ,
\end{equation}
where
\begin{equation}
1\leq j_{1}<\cdots<j_{m}\leq2r,1\leq k_{1}<\cdots<k_{n}\leq r,0\leq m,n\leq2r
\end{equation}


These representations have the properties

\begin{enumerate}
\item
\begin{equation}
\varphi\left\{  A\right\}  =\left\langle \left.  \Phi_{\varphi}\left(
I_{\mathcal{A}}\right)  \right\vert \Pi_{\varphi}\left(  A\right)
\Phi_{\varphi}\left(  I_{\mathcal{A}}\right)  \right\rangle _{\mathcal{H}%
_{\varphi}}%
\end{equation}


\item
\begin{align}
\operatorname{Tr}_{\mathcal{H}_{\varphi}}\left\{  A\right\}   &  =\sum_{0\leq
m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\langle \left.  \Phi_{\varphi}\left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
\right\vert \Pi_{\varphi}\left(  A\right)  \Phi_{\varphi}\left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
\right\rangle _{\mathcal{H}_{\varphi}}\\
&  =\varphi\left\{  A\right\}  +\sum_{1\leq m,n\leq r}\sum_{\substack{1\leq
j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}\left\langle \left.
\Phi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}%
}\cdots a_{k_{1}}\right)  \right\vert \Pi_{\varphi}\left(  A\right)
\Phi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}%
}\cdots a_{k_{1}}\right)  \right\rangle _{\mathcal{H}_{\varphi}}%
\end{align}


\item
\begin{equation}
\Phi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}%
}\cdots a_{k_{1}}\right)  =\Pi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)  \Phi_{\varphi}\left(
I_{\mathcal{A}}\right)  =\Phi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)  .
\end{equation}
and

\item
\begin{align}
\operatorname{Tr}_{\mathcal{H}_{\varphi}}\left\{  A\right\}   &  =\sum_{0\leq
m,n\leq r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}%
<\cdots<k_{n}\leq r}}\left\langle \left.  \Phi_{\varphi}\left(  x_{j_{1}%
}\cdots x_{j_{n}}\right)  \right\vert \Pi_{\varphi}\left(  A\right)
\Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  \right\rangle
_{\mathcal{H}_{\varphi}}\\
&  =\varphi\left\{  A\right\}  +\sum_{1\leq m,n\leq r}\sum_{\substack{1\leq
j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}\left\langle \left.
\Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  \right\vert
\Pi_{\varphi}\left(  A\right)  \Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}%
}\right)  \right\rangle _{\mathcal{H}_{\varphi}}%
\end{align}


\item
\begin{equation}
\Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  =\Pi_{\varphi}\left(
x_{j_{1}}\cdots x_{j_{n}}\right)  \Phi_{\varphi}\left(  I_{\mathcal{A}%
}\right)  =\Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  .
\end{equation}

\end{enumerate}

\begin{remark}
In general
\begin{equation}
\left\{  \left.  \Phi_{\varphi}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)
\right\vert 1\leq j_{1}<\cdots<j_{n}\leq2r,0\leq n\leq2r\right\}
\end{equation}
and
\begin{equation}
\left\{  \left.  \Phi_{\varphi}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}%
}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)  \right\vert 1\leq j_{1}%
<\cdots<j_{n}\leq r,1\leq k_{1}<\cdots<k_{n}\leq r,0\leq m,n\leq r\right\}
\end{equation}
are overcomplete bases, which is reflected in the singularity of
$\Delta_{\varphi}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)  $ and
$\Delta_{\varphi}\left(  \boldsymbol{x}\right)  $.
\end{remark}

\subparagraph{Fock Representations}

\begin{definition}
$\varphi_{f}$ is a Fock vacuum state if $\exists$ a left ideal $L_{a}$ with
the property
\begin{equation}
\varphi_{f}\left(  L_{a}\right)  =0,
\end{equation}
where $L_{a}$ is a left ideal generated by $\left\{  \boldsymbol{a}\right\}
=\left\{  \left.  a_{j}\right\vert 1\leq j_{1}<\cdots<j_{n}\leq r\right\}  .$
\end{definition}

\begin{lemma}
$L_{a}$ is maximal.
\end{lemma}

\begin{lemma}
If $\varphi_{f}$ is a Fock vacuum state its associated metric matrix has the
property
\begin{equation}
\Delta_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\right)  =\varphi
_{f}\left(  \boldsymbol{aa}^{\dagger}\right)  =\mathbb{I}_{2^{r}}.
\end{equation}

\end{lemma}

\emph{Fock states} $\varphi_{f}$ associated with the basis $\left\{
\boldsymbol{a}^{\dagger}\boldsymbol{a}\right\}  $ produce $c^{\ast}$-algebra
$\Pi_{\varphi_{f}}$ representations and Hilbert space representations
$\Phi_{\varphi_{f}}$ that have the properties
\begin{gather}
\ker\left\{  \Phi_{\varphi_{f}}\right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  a_{j_{1}}\cdots a_{j_{n}}\right\vert
1\leq k_{1}<\cdots<k_{n}\leq r;1\leq n\leq r\right\}  =L_{a}\\
\Updownarrow\\
\Phi_{\varphi_{f}}\left(  a_{j_{1}}\cdots a_{j_{n}}\right)  =0;1\leq
j_{1}<\cdots<j_{n}\leq r,1\leq n\leq r
\end{gather}
and%
\begin{gather}
\Pi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger}\right)
\Phi_{\varphi_{f}}\left(  I_{\mathcal{F}}\right)  =\Pi_{\varphi_{f}}\left(
a_{j_{1}}^{\dagger}\right)  \cdots\Pi_{\varphi_{f}}\left(  a_{j_{n}}^{\dagger
}\right)  \Phi_{\varphi_{f}}\left(  I_{\mathcal{F}}\right)  =\Phi_{\varphi
_{f}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger}\right) \\
\Pi_{\varphi_{f}}\left(  a_{j_{1}}\ \right)  \Phi_{\varphi_{f}}\left(
I_{\mathcal{A}}\right)  =0.
\end{gather}
The bases $\left\{  \left.  \Phi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger
}\cdots a_{j_{n}}^{\dagger}\right)  \right\vert 1\leq j_{1}<\cdots<j_{n}\leq
r,0\leq n\leq r\right\}  $ is orthonormal i.e.
\begin{equation}
\Delta_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\right)  _{j_{1}\cdots
j_{m}k_{1}\cdots k_{n}}=\left\langle \left.  \Phi_{\varphi_{f}}\left(
a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}\right)  \right\vert
\Phi_{\varphi_{f}}\left(  a_{k_{1}}^{\dagger}\cdots a_{k_{n}}^{\dagger
}\right)  \right\rangle =\delta_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}},
\end{equation}
when $\varphi_{f}$ is the Fock state associated with the $\left\{
\boldsymbol{a}^{\dagger}\boldsymbol{a}\right\}  $ basis.

One can express the Fock Hilbert space basis as
\begin{align}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle  &
=\Phi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger
}\right)  ;1\leq j_{1}<\cdots<j_{n}\leq r,1\leq n\leq r\\
\left\vert \phi_{\varphi_{f}}\right\rangle  &  \equiv\left\vert \phi
_{a}\right\rangle =\left\vert \Phi_{\varphi_{f}}\left(  I_{\mathcal{A}%
}\right)  \right\rangle ,
\end{align}
where $\left\{  \left.  \varphi_{j}\right\vert 1\leq j\leq r\right\}  $ is a
conb for a Hilbert space $\mathcal{H}_{\varphi_{f}}^{1}$ and expand any
operator $\Pi_{\varphi_{f}}\left(  A\right)  \in\mathcal{B}\left(
\mathcal{H}_{\varphi_{f}}\right)  $ in ket-bra form
\begin{equation}
\Pi_{\varphi_{f}}\left(  A\right)  =\sum_{0\leq m,n\leq r}\sum
_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq
r}}{\Large a}\left(  A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{n}}\right\vert .
\end{equation}


\begin{remark}
$\Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)  $ plays the role of the
Fock vacuum vector in $\mathcal{H}_{\varphi_{f}}$ i.e.
\begin{equation}
\left\vert \phi_{\varphi_{f}}\right\rangle =\left\vert \Phi_{\varphi_{f}%
}\left(  I_{\mathcal{A}}\right)  \right\rangle .
\end{equation}

\end{remark}

\begin{remark}
The Fock representation $\Pi_{\varphi_{f}}$ is faithful i.e.%
\begin{equation}
\ker\left\{  \Pi_{\varphi_{f}}\right\}  =0
\end{equation}
although $\Phi_{\varphi_{f}}$ \emph{is not}.
\end{remark}

\begin{remark}
If $r=\infty$ then $\Pi_{\varphi_{f}}\left(  \mathcal{A}\right)  $ is a Type
$I$ Von Neumann algebra.
\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{F}=\Pi_{\varphi_{f}}\left(  \mathcal{A}\right)  .
\end{equation}

\end{remark}

Using the conb $\left\{  \left.  \Phi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger
}\cdots a_{j_{n}}^{\dagger}\right)  \right\vert 1\leq j_{1}<\cdots<j_{n}\leq
r,0\leq n\leq r\right\}  $ one can expand any operator belonging to
$\Pi_{\varphi_{f}}\left(  \mathcal{A}\right)  $ as the strong operator limit
of
\begin{align}
A_{\varphi_{f}}  &  =\Pi_{\varphi_{f}}\left(  A\right)  =\sum\limits_{0\leq
n,m\leq r}\sum\limits_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq
k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(  A\right)  _{j_{1}\cdots j_{m}%
k_{1}\cdots k_{n}}\Pi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger}\right)
\cdots\Pi_{\varphi_{f}}\left(  a_{j_{m}}^{\dagger}\right)  \Pi_{\varphi_{f}%
}\left(  a_{k_{n}}\right)  \cdots\Pi_{\varphi_{f}}\left(  a_{k_{1}}\right) \\
&  ={\Large a}\left(  A\right)  _{00}\Pi_{\varphi_{f}}\left(  I_{\mathcal{F}%
}\right)  +\sum\limits_{1\leq j_{1}<\cdots<j_{m}\leq r}{\Large a}\left(
A\right)  _{j_{1}\cdots j_{m}0}\Pi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger
}\right)  \cdots\Pi_{\varphi_{f}}\left(  a_{j_{m}}^{\dagger}\right)
+\sum\limits_{1\leq k_{1}<\cdots<k_{n}\leq r}{\Large a}\left(  A\right)
_{0k_{1}\cdots k_{n}}\Pi_{\varphi_{f}}\left(  a_{k_{n}}\right)  \cdots
\Pi_{\varphi_{f}}\left(  a_{k_{1}}\right) \\
&  +\sum\limits_{1\leq n,m\leq r}\sum\limits_{\substack{1\leq j_{1}%
<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(
A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\Pi_{\varphi_{f}}\left(
a_{j_{1}}^{\dagger}\right)  \cdots\Pi_{\varphi_{f}}\left(  a_{j_{m}}^{\dagger
}\right)  \Pi_{\varphi_{f}}\left(  a_{k_{n}}\right)  \cdots\Pi_{\varphi_{f}%
}\left(  a_{k_{1}}\right)  .
\end{align}
One can also use the \emph{overcomplete basis} $\left\{  \left.  \Phi
_{\varphi_{f}}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  \right\vert 1\leq
j_{1}<\cdots<j_{n}\leq2r,0\leq n\leq2r\right\}  $ to expand any operator
belonging to $\Pi_{\varphi_{f}}\left(  \mathcal{A}\right)  $ as
\begin{equation}
\Pi_{_{\varphi_{f}}}\left(  A\right)  ={\LARGE x}\left(  A\right)  _{00}%
\Pi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)  +\sum_{1\leq n\leq2r}%
\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}{\LARGE x}\left(  A\right)  _{j_{1}\cdots
j_{n}}\Pi_{\varphi_{f}}\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  .
\end{equation}
This gives the zeroth grade component

\begin{enumerate}
\item
\begin{equation}
\left\langle \Pi_{\varphi_{f}}\left(  A\right)  \right\rangle _{0}%
=\Pi_{\varphi_{f}}\left(  \left\langle \overset{}{A}\right\rangle _{0}\right)
={\LARGE x}\left(  A\right)  _{00}%
\end{equation}


\item In terms of the $\left\{  \boldsymbol{x}\right\}  $ basis
\begin{equation}
\left\langle \Pi_{\varphi_{f}}\left(  A\right)  \right\rangle _{0}%
=\Pi_{\varphi_{f}}\left(  \left\langle \overset{}{A}\right\rangle _{0}\right)
=\Pi_{\varphi_{f}}\left(  \left\langle {\LARGE x}\left(  A\right)
_{00}I_{\mathcal{A}}+\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq
2r}{\LARGE x}\left(  A\right)  _{j_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}%
}\right\rangle _{0}\right)  ={\LARGE x}\left(  A\right)  _{00}.
\end{equation}


\item In terms of the $\left\{  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right\}  $ basis
\begin{equation}
\left\langle \Pi_{\varphi_{f}}\left(  A\right)  \right\rangle _{0}%
=\sum\limits_{0\leq n,m\leq r}\sum\limits_{\substack{1\leq j_{1}<\cdots
<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\left\langle \Pi_{\varphi_{f}}\left(
a_{j_{1}}^{\dagger}\right)  \cdots\Pi_{\varphi_{f}}\left(  a_{j_{m}}^{\dagger
}\right)  \Pi_{\varphi_{f}}\left(  a_{k_{n}}\right)  \cdots\Pi_{\varphi_{f}%
}\left(  a_{k_{1}}\right)  \right\rangle _{0}\neq{\Large a}\left(  A\right)
_{00}.
\end{equation}
The normalized trace in the Fock representation is given by%
\[
\varphi_{f}\left(  A\right)  =\operatorname*{tr}\nolimits_{\mathcal{H}%
_{\varphi_{f}}}\left\{  A\right\}  =\left\langle \Pi_{\varphi_{f}}\left(
A\right)  \right\rangle _{0}=\left\langle \Pi_{\varphi_{f}}\left(  A\right)
\right\rangle _{0}=X\left(  A\right)  _{00}=\left\langle \left.  \Phi
_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)  \right\vert \Pi_{\varphi_{f}%
}\left(  A\right)  \Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)
\right\rangle _{\mathcal{H}_{\varphi_{f}}}.
\]
Noting that%
\begin{equation}
\Pi_{\varphi_{f}}\left(  A\right)  =\sum_{0\leq m,n\leq r}\sum_{1\leq
j_{1}<\cdots<j_{m}\leq r}{\Large a}\left(  A\right)  _{j_{1}\cdots j_{m}%
k_{1}\cdots k_{n}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{n}}\right\vert
\end{equation}
the operator trace is given by
\begin{align}
\operatorname{Tr}_{\mathcal{H}_{\varphi}}\left\{  \Pi_{\varphi_{f}}\left(
A\right)  \right\}   &  =\varphi_{f}\left\{  A\right\}  +\sum_{1\leq m\leq
r}\sum_{1\leq j_{1}<\cdots<j_{m}\leq r}\left\langle \left.  \Phi_{\varphi_{f}%
}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}\right)  \right\vert
\Pi_{\varphi_{f}}\left(  A\right)  \Phi_{\varphi_{f}}\left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}\right)  \right\rangle _{\mathcal{H}%
_{\varphi_{f}}}\\
&  ={\Large a}\left(  A\right)  _{00}+\sum_{1\leq m\leq r}\sum_{1\leq
j_{1}<\cdots<j_{m}\leq r}{\Large a}\left(  A\right)  _{j_{1}\cdots j_{m}%
j_{1}\cdots j_{m}}=\operatorname{Tr}\left\{  {\Large a}\left(  A\right)
\right\}  .
\end{align}

\end{enumerate}

The non self adjoint basis is related to the self adjoint basis by
\begin{gather}
a_{j}=\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right) \\
a_{j}^{\dagger}=\frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right) \\
1\leq j\leq r
\end{gather}
leading to%
\begin{gather}
\Phi_{\varphi_{f}}\left(  a_{j}\right)  =\frac{1}{\sqrt{2}}\Phi_{\varphi_{f}%
}\left(  x_{j}+ix_{j+r}\right)  =0\\
\Rightarrow\Phi_{\varphi_{f}}\left(  x_{j}\right)  =-i\Phi_{\varphi_{f}%
}\left(  x_{j+r}\right) \\
\Rightarrow\Phi_{\varphi_{f}}\left(  a_{j}^{\dagger}\right)  =\sqrt{2}%
\Phi_{\varphi_{f}}\left(  x_{j}\right) \\
1\leq j\leq r.
\end{gather}
The metric matrix $\Delta_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger
}\right)  $ for a Fock state $\varphi_{f}$ is
\begin{gather}
\varphi_{f}\left(  I_{\mathcal{A}}\right)  =\left\langle \left.  \Phi
_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\vert \Phi_{\varphi_{f}%
}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{f}}%
}=\Delta_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\right)  _{00}=1\\
\varphi_{f}\left(  I_{\mathcal{A}}a_{k}^{\dagger}\right)  =\varphi_{f}\left(
a_{k}^{\dagger}\right)  =\left\langle \left.  \Phi_{\varphi_{f}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Phi_{\varphi_{f}}\left(  a_{k}%
^{\dagger}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{f}}}=\Delta
_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\right)  _{0k}=0\\
\varphi_{f}\left(  a_{j}I_{\mathcal{A}}\right)  =\varphi_{f}\left(
a_{j}\right)  =\left\langle \left.  \Phi_{\varphi_{f}}\left(  a_{j}^{\dagger
}\ \right)  \right\vert \Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)
\right\rangle _{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(
\boldsymbol{a}^{\dagger}\right)  _{j0}=0\\
\varphi_{f}\left(  a_{j}a_{k}^{\dagger}\right)  =\left\langle \left.
\Phi_{\varphi_{f}}\left(  a_{j}^{\dagger}\ \right)  \right\vert \Phi
_{\varphi_{f}}\left(  a_{k}^{\dagger}\ \right)  \right\rangle _{\mathcal{H}%
_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\right)
_{jk}=\delta_{jk}\\
\varphi_{f}\left(  a_{j}a_{k}\right)  =\left\langle \left.  \Phi_{\varphi_{f}%
}\left(  a_{j}\ \right)  \right\vert \Phi_{\varphi_{f}}\left(  a_{k}\ \right)
\right\rangle _{\mathcal{H}_{\varphi_{f}}}=0\\
\varphi_{f}\left(  a_{j}^{\dagger}a_{k}^{\dagger}\right)  =\left\langle
\left.  \Phi_{\varphi_{f}}\left(  a_{j}\ \right)  \right\vert \Phi
_{\varphi_{f}}\left(  a_{k}^{\dagger}\ \right)  \right\rangle _{\mathcal{H}%
_{\varphi_{f}}}=0\\
\varphi_{f}\left(  a_{j}^{\dagger}a_{k}\right)  =\left\langle \left.
\Phi_{\varphi_{f}}\left(  a_{j}\ \right)  \right\vert \Phi_{\varphi_{f}%
}\left(  a_{k}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{f}}}=0\\
1\leq j,k\leq r.
\end{gather}
Using
\begin{gather}
\Phi_{\varphi_{f}}\left(  a_{j}\right)  =\frac{1}{\sqrt{2}}\Phi_{\varphi_{f}%
}\left(  x_{j}+ix_{j+r}\right)  =0\\
\Rightarrow\Phi_{\varphi_{f}}\left(  x_{j}\right)  =-i\Phi_{\varphi_{f}%
}\left(  x_{j+r}\right) \\
\Rightarrow\Phi_{\varphi_{f}}\left(  a_{j}^{\dagger}\right)  =\sqrt{2}%
\Phi_{\varphi_{f}}\left(  x_{j}\right)  =-i\sqrt{2}\Phi_{\varphi_{f}}\left(
x_{j+r}\right) \\
1\leq j\leq r.
\end{gather}
this gives%
\begin{gather}
\varphi_{f}\left(  I_{\mathcal{A}}\right)  =\left\langle \left.  \Phi
_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\vert \Phi_{\varphi_{f}%
}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{f}}%
}=\Delta_{\varphi_{f}}\left(  \boldsymbol{x}\right)  _{00}=1\\
\varphi_{f}\left(  I_{\mathcal{A}}x_{k}\right)  =\varphi_{f}\left(
x_{k}\right)  =\left\langle \left.  \Phi_{\varphi_{f}}\left(  I_{\mathcal{A}%
}\ \right)  \right\vert \Phi_{\varphi_{f}}\left(  x_{k}\ \right)
\right\rangle _{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(
\boldsymbol{x}\right)  _{0k}=0\\
\varphi_{f}\left(  a_{j}I_{\mathcal{A}}\right)  =\varphi_{f}\left(
a_{j}\right)  =\left\langle \left.  \Phi_{\varphi}\left(  x_{j}\ \right)
\right\vert \Phi_{\varphi}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(  \boldsymbol{x}%
\right)  _{j0}=0\\
\varphi_{f}\left(  a_{j}a_{k}^{\dagger}\right)  =\left\langle \left.
\Phi_{\varphi}\left(  x_{j}\ \right)  \right\vert \Phi_{\varphi}\left(
x_{k}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi
_{f}}\left(  \boldsymbol{x}\right)  _{jk}=2\delta_{jk}\\
\Rightarrow\left\langle \left.  \Phi_{\varphi_{f}}\left(  x_{j}\ \right)
\right\vert \Phi_{\varphi_{f}}\left(  x_{k+r}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(  \boldsymbol{x}%
\right)  _{jk+r}=2i\delta_{jk}\\
\Rightarrow\left\langle \left.  \Phi_{\varphi_{f}}\left(  x_{j+r}\ \right)
\right\vert \Phi_{\varphi_{f}}\left(  x_{k}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(  \boldsymbol{x}%
\right)  _{j+rk}=-2i\delta_{jk}\\
\Rightarrow\left\langle \left.  \Phi_{\varphi_{f}}\left(  x_{j+r}\ \right)
\right\vert \Phi_{\varphi_{f}}\left(  x_{k+r}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}=\Delta_{\varphi_{f}}\left(  \boldsymbol{x}%
\right)  _{j+rk+r}=2\delta_{jk}\\
1\leq j,k\leq r.
\end{gather}


The algebraic trace and normalized trace are

\begin{enumerate}
\item
\begin{gather}
\varphi_{f}\left(  A\right)  =\left\langle \left.  \Phi_{\varphi_{f}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Pi_{\varphi_{f}}\left(  A\right)
\Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}\\
\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi_{\varphi_{f}}\left(
A\right)  \right\}  =\left\langle \left.  \Phi_{\varphi_{f}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Pi_{\varphi_{f}}\left(  A\right)
\Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}+\sum_{1\leq m\leq r}\sum_{1\leq j_{1}%
<\cdots<j_{m}\leq r}\left\langle \left.  \Phi_{\varphi_{f}}\left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}\ \right)  \right\vert \Pi_{\varphi_{f}%
}\left(  A\right)  \Phi_{\varphi_{f}}\left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{f}}}\\
=\left\langle \left.  \phi_{f}\right\vert \Pi_{\varphi_{f}}\left(  A\right)
\phi_{f}\right\rangle _{\mathcal{H}_{\varphi_{f}}}+\sum_{1\leq m\leq r}%
\sum_{1\leq j_{1}<\cdots<j_{m}\leq r}\left\langle \left.  \varphi_{j_{1}%
}\cdots\varphi_{j_{m}}\right\vert \Pi_{\varphi_{f}}\left(  A\right)
\varphi_{j_{1}}\cdots\varphi_{j_{m}}\right\rangle _{\mathcal{H}_{\varphi_{f}}}%
\end{gather}
and

\item
\begin{gather}
\varphi_{f}\left(  \left\langle A\right\rangle _{0}\right)  =\left\langle
\left.  \Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\left\langle \Pi_{\varphi_{f}}\left(  A\right)  \right\rangle _{0}%
\Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}\\
\operatorname*{tr}\nolimits_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi
_{\varphi_{f}}\left(  A\right)  \right\}  =\left\langle \Pi_{\varphi_{f}%
}\left(  A\right)  \right\rangle _{0}=\operatorname*{tr}\left\{  A\right\}
=\left\langle A\right\rangle _{0}.
\end{gather}

\end{enumerate}

\begin{lemma}
In finite dimensions the normalized and operator traces in the Fock
representation are related by
\begin{gather}
\operatorname*{tr}\left\{  A\right\}  =\operatorname*{tr}%
\nolimits_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi_{\varphi_{f}}\left(
A\right)  \right\}  =\left\langle \Pi_{\varphi_{f}}\left(  A\right)
\right\rangle _{0}=\frac{1}{2^{r}}\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}%
}}\left\{  \Pi_{\varphi_{f}}\left(  A\right)  \right\} \\
\operatorname*{tr}\nolimits_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi
_{\varphi_{f}}\left(  A\right)  \right\}  =\left\langle \Pi_{\varphi_{f}%
}\left(  A\right)  \right\rangle _{0}=\frac{1}{2^{r}}\operatorname{Tr}%
_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi_{\varphi_{f}}\left(  A\right)
\right\}  .
\end{gather}

\end{lemma}

\begin{proof}%
\[
\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =\operatorname*{tr}%
\nolimits_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi_{\varphi_{f}}\left(
I_{\mathcal{A}}\right)  \right\}  =\left\langle \Pi_{\varphi_{f}}\left(
I_{\mathcal{A}}\right)  \right\rangle _{0}=1
\]
and
\begin{gather}
\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi_{\varphi_{f}}\left(
I_{\mathcal{A}}\right)  \right\}  =\left\langle \left.  \phi_{f}\right\vert
\Pi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)  \phi_{f}\right\rangle
_{\mathcal{H}_{\varphi_{f}}}+\sum_{1\leq m\leq r}\sum_{1\leq j_{1}%
<\cdots<j_{m}\leq r}\left\langle \left.  \varphi_{j_{1}}\cdots\varphi_{j_{m}%
}\right\vert \Pi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)  \varphi_{j_{1}%
}\cdots\varphi_{j_{m}}\right\rangle _{\mathcal{H}_{\varphi_{f}}}\\
=1+r+\binom{r}{2}+\cdots+\binom{r}{r}=2^{r},
\end{gather}
hence
\begin{equation}
\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =\frac{1}{2^{r}%
}\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}}}\left\{  \Pi_{\varphi_{f}%
}\left(  I_{\mathcal{A}}\right)  \right\}  .
\end{equation}


\begin{remark}%
\begin{gather}
\varphi_{f}\left(  A\right)  =\left\langle \left.  \Phi_{\varphi_{f}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Pi_{\varphi_{f}}\left(  A\right)
\Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}\\
=\sum\limits_{0\leq n,m\leq r}\sum\limits_{\substack{1\leq j_{1}<\cdots
<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\left\langle \left.  \Phi_{\varphi_{f}%
}\left(  I_{\mathcal{A}}\ \right)  \right\vert \Pi_{\varphi_{f}}\left(
a_{j_{1}}^{\dagger}\right)  \cdots\Pi_{\varphi_{f}}\left(  a_{j_{m}}^{\dagger
}\right)  \Pi_{\varphi_{f}}\left(  a_{k_{n}}\right)  \cdots\Pi_{\varphi_{f}%
}\left(  a_{k_{1}}\right)  \Phi_{\varphi_{f}}\left(  I_{\mathcal{A}}\ \right)
\right\rangle _{\mathcal{H}_{\varphi_{f}}}\\
={\Large a}\left(  A\right)  _{00}%
\end{gather}

\end{remark}
\end{proof}

\begin{definition}
The \emph{Folium} $\mathfrak{F}_{_{f}}$ of Normal Fock states generated by $f$
contained in $\mathcal{S}\left(  \mathcal{A}\right)  $ is given by
\begin{equation}
\mathfrak{F}_{_{f}}=\left\{  \left.  \overset{}{\varphi_{fD}}\right\vert
\varphi_{fD}\left(  A\right)  =\operatorname{Tr}_{\mathcal{H}_{\varphi_{f}}%
}\left\{  \Pi_{\varphi_{f}}\left(  A\right)  D\right\}  ,\,A\in\mathcal{A}%
,\,D\in\mathcal{B}_{1}\left(  \mathcal{H}_{\varphi_{f}}\right)  \right\}  .
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
\mathcal{R}_{\Phi_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\ \right)
}\left(  D\right)  _{k_{1}\cdots k_{n}j_{1}\cdots j_{m}}=\varphi_{fD}\left(
a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
.
\end{equation}

\end{remark}

\begin{proof}
\begin{remark}
The cyclic vector $\Phi_{\varphi_{fD}}\left(  I_{\mathcal{A}}\ \right)  $
produced by the state $\varphi_{fD}\in\mathcal{S}\left(  \mathcal{A}\right)  $
defined by the density operator $D\in\mathcal{S}\left(  \mathcal{B}\left(
\mathcal{H}_{\varphi_{f}}\right)  \right)  $ is $\Phi_{\varphi_{fD}}\left(
I_{\mathcal{A}}\ \right)  $ and
\begin{equation}
\varphi_{fD}\left(  A\right)  =\left\langle \left.  \Phi_{\varphi_{fD}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Pi_{\varphi_{fD}}\left(  A\right)
\Phi_{\varphi_{fD}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{f}}}=\operatorname{Tr}\left\{  {\Large a}\left(
A\right)  \mathcal{R}_{\Phi_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger
}\ \right)  }\left(  D\right)  \right\}  .
\end{equation}

\end{remark}

\begin{remark}
The energy of a system characterized by a Hamiltonian $H$ in a Type $I$ state
$\varphi_{fD}$ is given by
\begin{equation}
\varphi_{fD}\left(  H\right)  =\left\langle \left.  \Phi_{fD}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Pi_{fD}\left(  H\right)  \Phi
_{fD}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}%
_{\varphi_{f}}}=\operatorname{Tr}\left\{  {\Large a}\left(  H\right)
\mathcal{R}_{\Phi_{\varphi_{f}}\left(  \boldsymbol{a}^{\dagger}\ \right)
}\left(  D\right)  \right\}
\end{equation}

\end{remark}
\end{proof}

\begin{example}
Consider the $N$-particle Independent Particle State $D_{\varphi_{f}}^{N}%
\in\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)  $
\begin{equation}
D_{\varphi_{f}}^{N}=\left\vert \varphi_{1}\cdots\varphi_{N}\right\rangle
\left\langle \varphi_{1}\cdots\varphi_{N}\right\vert
\end{equation}
then%
\begin{equation}
L_{D_{\varphi_{f}}^{N}}=\operatorname*{Alg}\left\{  a_{1}^{\dagger}%
,\cdots,a_{N}^{\dagger},\left\{  \left.  a_{j_{N+1}}^{\dagger},\cdots
,a_{j_{r}}^{\dagger}\right\vert N+1\leq j_{1}<\cdots<j_{r}\leq r\right\}
\right\}  =\ker\left\{  \varphi_{fD^{N}}\right\}
\end{equation}
giving the \emph{dressed vacuum} properties%
\begin{align}
\Pi_{fD}\left(  a_{j}\ \right)  \Phi_{fD}\left(  I_{\mathcal{A}}\ \right)   &
=\Phi_{fD}\left(  a_{j}\ \right)  ;1\leq j\leq N\\
\Pi_{fD}\left(  a_{j}^{\dagger}\ \right)  \Phi_{fD}\left(  I_{\mathcal{A}%
}\ \right)   &  =\Phi_{fD}\left(  a_{j}^{\dagger}\ \right)  ;N+1\leq j\leq r.
\end{align}
The energy expectation value is given by
\begin{align}
\varphi_{fD^{N}}\left(  H\right)   &  =\left\langle \left.  \Phi_{fD}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Pi_{\varphi_{f}}\left(  H\right)
\Phi_{fD}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}%
_{\varphi_{f}}}=\left\langle \left.  \varphi_{1}\cdots\varphi_{N}\right\vert
\Pi_{\varphi_{f}}\left(  H\right)  \varphi_{1}\cdots\varphi_{N}\right\rangle
_{\mathcal{H}_{\varphi_{f}}}\\
&  =\operatorname{Tr}\left\{  \Pi_{\varphi_{f}}\left(  H\right)  \left\vert
\varphi_{1}\cdots\varphi_{N}\right\rangle \left\langle \varphi_{1}%
\cdots\varphi_{N}\right\vert \right\}  =E_{H}\left(  D_{\varphi_{f}}%
^{N}\right)  .
\end{align}

\end{example}

\subparagraph{The Normalized Trace Representation}

Both $\Pi_{\operatorname*{tr}}$ and $\Phi_{\operatorname*{tr}}$ are faithful
(as $\operatorname*{tr}$ is faithful) i.e.
\begin{equation}
\ker\left\{  \Pi_{\operatorname*{tr}}\right\}  =\ker\left\{  \Phi
_{\operatorname*{tr}}\right\}  =0.
\end{equation}
The action on the cyclic vector $\Phi_{\operatorname*{tr}}\left(
I_{\mathcal{F}}\right)  $ --which is \emph{not} a vacuum vector is

\begin{enumerate}
\item
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}a_{k_{n}}\cdots a_{k_{1}}\right)  \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{F}}\right)  =\Pi_{\operatorname*{tr}}\left(  a_{j_{1}}^{\dagger
}\right)  \cdots\Pi_{\operatorname*{tr}}\left(  a_{j_{n}}^{\dagger}\right)
\Pi_{\operatorname*{tr}}\left(  a_{k_{n}}\right)  \cdots\Pi
_{\operatorname*{tr}}\left(  a_{k_{1}}\right)  \Phi_{\operatorname*{tr}%
}\left(  I_{\mathcal{F}}\right)  =\Phi_{\operatorname*{tr}}\left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
\end{equation}


and
\end{enumerate}

%

\begin{equation}
\Pi_{\operatorname*{tr}}\left(  x_{j_{1}}\cdots x_{j_{m}}\right)
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{F}}\right)  =\Pi
_{\operatorname*{tr}}\left(  x_{j_{1}}\right)  \cdots\Pi_{\operatorname*{tr}%
}\left(  x_{j_{1}}\right)  \Phi_{\operatorname*{tr}}\left(  I_{\mathcal{F}%
}\right)  =\Phi_{\operatorname*{tr}}\left(  x_{j_{1}}\cdots x_{j_{m}}\right)
.
\end{equation}
The metric matrices $\Delta_{\operatorname*{tr}}\left(  \boldsymbol{x}\right)
$ and $\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger
}\boldsymbol{a}\right)  $ are both non singular. The basis $\left\{
\boldsymbol{x}\right\}  $ is orthogonal but the basis $\left\{  \boldsymbol{a}%
^{\dagger}\boldsymbol{a}\right\}  $is not.

The $2^{2r}\times2^{2r}$ real metric matrix $\Delta_{\operatorname*{tr}%
}\left(  \boldsymbol{x}\right)  $ for the Trace state $\varphi
_{\operatorname*{tr}}$ is given by

\begin{enumerate}
\item
\begin{equation}
\left\langle \left.  \Delta_{\operatorname*{tr}}\left(  \boldsymbol{x}\right)
_{00}=\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{\operatorname*{tr}}}}=\varphi_{\operatorname*{tr}%
}\left(  I_{\mathcal{A}}\right)  =\operatorname*{tr}\left\{  I_{\mathcal{A}%
}\right\}  =\left\langle I_{\mathcal{A}}\right\rangle _{0}=1
\end{equation}


\item
\begin{align}
\Delta_{\operatorname*{tr}}\left(  \boldsymbol{x}\right)  _{0j_{1}\cdots
j_{m}}  &  =\Delta_{\operatorname*{tr}}\left(  \boldsymbol{x}\right)
_{j_{1}\cdots j_{m}0}=\left\langle \left.  \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Phi_{\operatorname*{tr}}\left(
x_{j_{1}}\cdots x_{j_{m}}\ \right)  \right\rangle _{\mathcal{H}_{\Phi
_{\operatorname*{tr}}}}=\left\langle \left.  \Phi_{\operatorname*{tr}}\left(
x_{j_{1}}\cdots x_{j_{m}}\ \right)  \right\vert \Phi_{\operatorname*{tr}%
}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\Phi
_{\operatorname*{tr}}}}\\
&  =\varphi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}x_{j_{1}}\cdots
x_{j_{m}}\right)  =\varphi_{\operatorname*{tr}}\left(  x_{j_{1}}\cdots
x_{j_{m}}\right)  =\operatorname*{tr}\left\{  x_{j_{1}}\cdots x_{j_{m}%
}\right\}  =\left\langle x_{j_{1}}\cdots x_{j_{m}}\right\rangle _{0}=0
\end{align}


\item
\begin{align}
\Delta_{\operatorname*{tr}}\left(  \boldsymbol{x}\right)  _{j_{1}\cdots
j_{m}k_{1}\cdots k_{n}}  &  =\left\langle \left.  \Phi_{\operatorname*{tr}%
}\left(  x_{j_{1}}\cdots x_{j_{m}}\ \right)  \right\vert \Phi
_{\operatorname*{tr}}\left(  x_{k_{1}}\cdots x_{k_{m}}\ \right)  \right\rangle
_{\mathcal{H}_{\varphi_{\operatorname*{tr}}}}=\varphi_{\operatorname*{tr}%
}\left(  \left(  x_{j_{1}}\cdots x_{j_{m}}\right)  ^{t}x_{k_{1}}\cdots
x_{k_{m}}\right) \\
&  =\operatorname*{tr}\left\{  \left(  x_{j_{1}}\cdots x_{j_{m}}\right)
^{t}x_{k_{1}}\cdots x_{k_{m}}\right\}  =\left\langle x_{j_{m}}\cdots x_{j_{1}%
}x_{k_{1}}\cdots x_{k_{m}}\right\rangle _{0}\ =\frac{1}{2^{n}\ }\delta
_{mn}\delta_{j_{1}\cdots j_{m}k_{1}\cdots k_{m}},
\end{align}
where
\begin{equation}
1\leq j_{1}<\cdots<j_{n}\leq2r,0\leq n\leq2r.
\end{equation}
One can construct an orthonormal basis $\left\{  \widetilde{\boldsymbol{x}%
}\right\}  $ by defining
\begin{equation}
\widetilde{x}_{j}=\sqrt{2}x_{j};1\leq j\leq2r.
\end{equation}
$\lceil$%
\begin{equation}
x_{1}^{2}=\frac{1}{2}\left(  a_{1}^{\dagger}+a_{1}\right)  \left(
a_{1}^{\dagger}+a_{1}\right)  =\frac{1}{2\ }\left(  a_{1}a_{1}^{\dagger}%
+a_{1}^{\dagger}a_{1}\right)  =\frac{1}{2\ }I_{2^{r}}%
\end{equation}
$\rfloor$
\end{enumerate}

\begin{enumerate}
\item The $2^{2r}\times2^{2r}$ complex metric matrix $\Delta
_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)  $
for the Trace state $\varphi_{\operatorname*{tr}}$ is given by
\begin{equation}
\left\langle \left.  \Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}%
^{\dagger}\boldsymbol{a}\right)  _{00}=\Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\ \right)  \right\vert \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\varphi
_{\operatorname*{tr}}}}=\varphi_{\operatorname*{tr}}\left(  I_{\mathcal{A}%
}\right)  =\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =\left\langle
I_{\mathcal{A}}\right\rangle _{0}=1.
\end{equation}


\item
\begin{align}
\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{0j_{1}\cdots j_{m}}  &  =\left\langle \left.  \Phi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}\ \right)  \right\rangle _{\mathcal{H}_{\Phi_{\operatorname*{tr}}}}%
=\varphi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}\right)  =\varphi_{\operatorname*{tr}}\left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}\right) \\
&  =\left\langle a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}\right\rangle
_{0}=\operatorname*{tr}\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}\right\}  =\overline{\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}%
^{\dagger}\boldsymbol{a}\right)  }_{j_{1}\cdots j_{m}0}\\
\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{0j_{1}+r\cdots j_{m}+r}  &  =\left\langle \left.  \Phi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  a_{j_{1}}\cdots a_{j_{m}}\ \right)
\right\rangle _{\mathcal{H}_{\Phi_{\operatorname*{tr}}}}=\varphi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}a_{j_{1}}\cdots a_{j_{m}}\right)
=\varphi_{\operatorname*{tr}}\left(  a_{j_{1}}\cdots a_{j_{m}}\right) \\
&  =\left\langle a_{j_{1}}\cdots a_{j_{m}}\right\rangle _{0}%
=\operatorname*{tr}\left\{  a_{j_{1}}\cdots a_{j_{m}}\right\}  =\overline
{\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  }_{j_{1}+r\cdots j_{m}+r0}\\
\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{j_{1}\cdots j_{m}0}  &  =\left\langle \left.  \Phi
_{\operatorname*{tr}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}\ \right)  \right\vert \Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}%
}\ \right)  \right\rangle _{\mathcal{H}_{\Phi_{\operatorname*{tr}}}}%
=\varphi_{\operatorname*{tr}}\left(  \left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}\right)  ^{\dagger}I_{\mathcal{A}}\right)  =\varphi
_{\operatorname*{tr}}\left(  a_{j_{m}}\cdots a_{j_{1}}\right) \\
&  =\left\langle a_{j_{m}}\cdots a_{j_{1}}\right\rangle _{0}%
=\operatorname*{tr}\left\{  a_{j_{m}}\cdots a_{j_{1}}\right\}  =\overline
{\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  }_{0j_{1}\cdots j_{m}}\\
\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{j_{1}+r\cdots j_{m}+r0}  &  =\left\langle \left.  \Phi
_{\operatorname*{tr}}\left(  a_{j_{1}}\cdots a_{j_{m}}\ \right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\rangle
_{\mathcal{H}_{\Phi_{\operatorname*{tr}}}}=\varphi_{\operatorname*{tr}}\left(
\left(  a_{j_{1}}\cdots a_{j_{m}}\right)  ^{\dagger}I_{\mathcal{A}}\right)
=\varphi_{\operatorname*{tr}}\left(  a_{j_{m}}^{\dagger}\cdots a_{j_{1}%
}^{\dagger}\right) \\
&  =\left\langle a_{j_{m}}^{\dagger}\cdots a_{j_{1}}^{\dagger}\right\rangle
_{0}=\operatorname*{tr}\left\{  a_{j_{m}}^{\dagger}\cdots a_{j_{1}}^{\dagger
}\right\}  =\overline{\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}%
^{\dagger}\boldsymbol{a}\right)  }_{0j_{1}+r\cdots j_{m}+r}.
\end{align}


\item
\begin{align}
&  \Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{0j_{1}\cdots j_{m}k_{1}\cdots k_{n}}=\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}a_{k_{n}}\cdots a_{k_{1}}\right)  \right\rangle _{\mathcal{H}_{\Phi
_{\operatorname*{tr}}}}=\varphi_{\operatorname*{tr}}\left(  I_{\mathcal{A}%
}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
\\
&  =\varphi_{\operatorname*{tr}}\left(  \left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)  \right)  =\left\langle
a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}%
}\right\rangle _{0}=\operatorname*{tr}\left\{  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right\}  =\overline
{\Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  }_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}0}\\
&  \Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}0}=\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger
}a_{k_{n}}\cdots a_{k_{1}}\right)  \right\vert \Phi_{\operatorname*{tr}%
}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\Phi
_{\operatorname*{tr}}}}=\varphi_{\operatorname*{tr}}\left(  \left(  a_{j_{1}%
}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right)
^{\dagger}I_{\mathcal{A}}\right) \\
&  =\varphi_{\operatorname*{tr}}\left(  a_{k_{1}}^{\dagger}\cdots a_{k_{m}%
}^{\dagger}a_{j_{n}}\cdots a_{j_{1}}\right)  =\left\langle a_{k_{1}}^{\dagger
}\cdots a_{k_{m}}^{\dagger}a_{j_{n}}\cdots a_{j_{1}}\right\rangle
_{0}=\operatorname*{tr}\left\{  a_{k_{1}}^{\dagger}\cdots a_{k_{m}}^{\dagger
}a_{j_{n}}\cdots a_{j_{1}}\right\}  =\overline{\Delta_{\operatorname*{tr}%
}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)  }_{0j_{1}\cdots
j_{m}k_{1}\cdots k_{n}}%
\end{align}


\item
\begin{align}
&  \Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{p_{1}\cdots p_{m}j_{1}\cdots j_{m^{\prime}}k_{1}\cdots
k_{n^{\prime}}}=\left\langle \left.  \Phi_{\operatorname*{tr}}\left(
a_{p_{1}}\cdots a_{p_{m}}\ \right)  \right\vert \Phi_{\operatorname*{tr}%
}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m^{\prime}}}^{\dagger}a_{k_{n^{\prime
}}}\cdots a_{k_{1}}\right)  \right\rangle _{\mathcal{H}_{\Phi
_{\operatorname*{tr}}}}\\
&  =\varphi_{\operatorname*{tr}}\left(  \left(  a_{p_{1}}\cdots a_{p_{m}%
}\ \right)  ^{\dagger}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}%
}\cdots a_{k_{1}}\right)  =\varphi_{\operatorname*{tr}}\left(  a_{p_{m}}\cdots
a_{p_{1}}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{n}}\cdots
a_{k_{1}}\right) \\
&  =\left\langle a_{p_{m}}\cdots a_{p_{1}}a_{j_{1}}^{\dagger}\cdots a_{j_{m}%
}^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right\rangle _{0}=\operatorname*{tr}%
\left\{  a_{p_{m}}\cdots a_{p_{1}}a_{j_{1}}^{\dagger}\cdots a_{j_{m}}%
^{\dagger}a_{k_{n}}\cdots a_{k_{1}}\right\}  =\overline{\Delta
_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)
}_{j_{1}\cdots j_{m^{\prime}}k_{1}\cdots k_{n}p_{1}\cdots p_{m}}%
\end{align}


\item
\begin{align}
&  \Delta_{\operatorname*{tr}}\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}%
\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}p_{1}\cdots p_{m^{\prime}}%
q_{1}\cdots q_{n^{\prime}}}=\left\langle \left.  \Phi_{\operatorname*{tr}%
}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{m}}^{\dagger}a_{k_{1}}\cdots
a_{k_{n}}\right)  \right\vert \Phi_{\operatorname*{tr}}\left(  a_{p_{1}%
}^{\dagger}\cdots a_{p_{m^{\prime}}}^{\dagger}a_{q_{1}}\cdots a_{q_{n^{\prime
}}}\ \right)  \right\rangle _{\mathcal{H}_{\varphi_{\operatorname*{tr}}}}\\
&  =\varphi_{\operatorname*{tr}}\left(  \left(  a_{j_{1}}^{\dagger}\cdots
a_{j_{m}}^{\dagger}a_{k_{1}}\cdots a_{k_{n}}\right)  ^{\dagger}a_{p_{1}%
}^{\dagger}\cdots a_{p_{m^{\prime}}}^{\dagger}a_{q_{1}}\cdots a_{q_{n^{\prime
}}}\right)  =\varphi_{\operatorname*{tr}}\left(  a_{k_{1}}^{\dagger}\cdots
a_{k_{n}}^{\dagger}a_{j_{m}}\cdots a_{j_{1}}a_{p_{1}}^{\dagger}\cdots
a_{p_{m^{\prime}}}^{\dagger}a_{q_{1}}\cdots a_{q_{n^{\prime}}}\right) \\
&  \left\langle a_{k_{1}}^{\dagger}\cdots a_{k_{n}}^{\dagger}a_{j_{m}}\cdots
a_{j_{1}}a_{p_{1}}^{\dagger}\cdots a_{p_{m^{\prime}}}^{\dagger}a_{q_{1}}\cdots
a_{q_{n^{\prime}}}\right\rangle _{0}=\operatorname*{tr}\left\{  a_{k_{1}%
}^{\dagger}\cdots a_{k_{n}}^{\dagger}a_{j_{m}}\cdots a_{j_{1}}a_{p_{1}%
}^{\dagger}\cdots a_{p_{m^{\prime}}}^{\dagger}a_{q_{1}}\cdots a_{q_{n^{\prime
}}}\right\}  .
\end{align}


\item Any operator $A_{\operatorname*{tr}}\in\Pi_{\operatorname*{tr}}\left(
\mathcal{A}\right)  ,$ which is properely contained in $\mathcal{B}\left(
\Phi_{\operatorname*{tr}}\left(  \mathcal{A}\right)  \right)  $ when
$r=\infty$ can be expanded as
\begin{align}
A_{\operatorname*{tr}}  &  =\Pi_{\operatorname*{tr}}\left(  A\right)
=\sum\limits_{0\leq n,m\leq r}\sum\limits_{\substack{1\leq j_{1}<\cdots
<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(  A\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\Pi_{\operatorname*{tr}}\left(  a_{j_{1}%
}^{\dagger}\right)  \cdots\Pi_{\operatorname*{tr}}\left(  a_{j_{m}}^{\dagger
}\right)  \Pi_{\operatorname*{tr}}\left(  a_{k_{n}}\right)  \cdots
\Pi_{\operatorname*{tr}}\left(  a\right)  _{k_{1}}\\
&  ={\Large a}\left(  A\right)  _{00}\Pi_{\operatorname*{tr}}\left(
I_{\mathcal{F}}\right)  +\sum\limits_{1\leq j_{1}<\cdots<j_{m}\leq
r}{\Large a}\left(  A\right)  _{j_{1}\cdots j_{m}0}\Pi_{\operatorname*{tr}%
}\left(  a_{j_{1}}^{\dagger}\right)  \cdots\Pi_{\operatorname*{tr}}\left(
a_{j_{m}}^{\dagger}\right)  +\sum\limits_{1\leq k_{1}<\cdots<k_{n}\leq
r}{\Large a}\left(  A\right)  _{0k_{1}\cdots k_{n}}\Pi_{\operatorname*{tr}%
}\left(  a_{k_{n}}\right)  \cdots\Pi_{\operatorname*{tr}}\left(  a\right)
_{k_{1}}\\
&  +\sum\limits_{1\leq n,m\leq r}\sum\limits_{\substack{1\leq j_{1}%
<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{n}\leq r}}{\Large a}\left(
A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}\Pi_{\operatorname*{tr}}\left(
a_{j_{1}}^{\dagger}\right)  \cdots\Pi_{\operatorname*{tr}}\left(  a_{j_{m}%
}^{\dagger}\right)  \Pi_{\operatorname*{tr}}\left(  a_{k_{n}}\right)
\cdots\Pi_{\operatorname*{tr}}\left(  a\right)  _{k_{1}}%
\end{align}
and

\item
\begin{equation}
A_{\operatorname*{tr}}=\Pi_{\operatorname*{tr}}\left(  A\right)  =X\left(
A\right)  _{00}\Pi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)
+\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq2r}{\Large x}\left(
A\right)  _{j_{1}\cdots j_{n}}\Pi_{\operatorname*{tr}}\left(  x_{j_{1}}\cdots
x_{j_{n}}\right)  .
\end{equation}

\end{enumerate}

\begin{remark}
$\Pi_{\operatorname*{tr}}\left(  \mathcal{A}\right)  ^{\prime\prime}$ is Type
$II_{1}$ Von Neumann algebra when $r=\infty.$
\end{remark}

The scalar value of the zeroth degree component is
\begin{equation}
\left\langle A\right\rangle _{0}\equiv\operatorname*{tr}\left\{  A\right\}
={\Large x}_{00}\left(  A\right)
\end{equation}
In general
\begin{equation}
{\Large a}\left(  A\right)  _{00}\neq{\Large x}\left(  A\right)  _{00}%
\end{equation}
The algebraic trace and normalized trace are
\begin{gather}
\varphi_{\operatorname*{tr}}\left(  A\right)  =\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Pi_{\operatorname*{tr}}\left(  A\right)  \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\operatorname*{tr}}}\\
\operatorname{Tr}_{\mathcal{H}_{\operatorname*{tr}}}\left\{  \Pi
_{\operatorname*{tr}}\left(  A\right)  \right\}  =\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Pi_{\operatorname*{tr}}\left(  A\right)  \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\operatorname*{tr}}%
}+\sum_{1\leq j_{1}<\cdots<j_{m}\leq2r}\left\langle \left.  \Phi
_{\operatorname*{tr}}\left(  \widetilde{x}_{j_{1}}\cdots\widetilde{x}_{j_{m}%
}\ \right)  \right\vert \Pi_{\operatorname*{tr}}\left(  A\right)
\Phi_{\operatorname*{tr}}\left(  \widetilde{x}_{j_{1}}\cdots\widetilde{x}%
_{j_{m}}\ \right)  \right\rangle _{\mathcal{H}_{\operatorname*{tr}}}%
\end{gather}


and
\begin{gather}
\operatorname*{tr}\left\{  A\right\}  =\varphi_{\operatorname*{tr}}\left(
A\right)  =\left\langle A\right\rangle _{0}=\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Pi_{\operatorname*{tr}}\left(  A\right)  \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}_{\operatorname*{tr}}}\\
\operatorname*{tr}\nolimits_{\mathcal{H}_{\operatorname*{tr}}}\left\{
\Pi_{\operatorname*{tr}}\left(  A\right)  \right\}  =\left\langle
\Pi_{\operatorname*{tr}}\left(  A\right)  \right\rangle _{0}%
=\operatorname*{tr}\left\{  A\right\}  =\left\langle A\right\rangle _{0}.
\end{gather}


\begin{lemma}
In finite dimensions the normalized and operator traces are related by
\begin{gather}
\operatorname*{tr}\left\{  A\right\}  =\operatorname*{tr}%
\nolimits_{\mathcal{H}_{\operatorname*{tr}}}\left\{  \Pi_{\operatorname*{tr}%
}\left(  A\right)  \right\}  =\left\langle \Pi_{\operatorname*{tr}}\left(
A\right)  \right\rangle _{0}=\frac{1}{2^{2r}}\operatorname{Tr}_{\mathcal{H}%
_{\operatorname*{tr}}}\left\{  \Pi_{\operatorname*{tr}}\left(  A\right)
\right\} \\
\operatorname*{tr}\nolimits_{\mathcal{H}_{\operatorname*{tr}}}\left\{
\Pi_{\operatorname*{tr}}\left(  A\right)  \right\}  =\left\langle
\Pi_{\operatorname*{tr}}\left(  A\right)  \right\rangle _{0}=\frac{1}{2^{2r}%
}\operatorname{Tr}_{\mathcal{H}_{\operatorname*{tr}}}\left\{  \Pi
_{\operatorname*{tr}}\left(  A\right)  \right\}  .
\end{gather}

\end{lemma}

\begin{proof}%
\[
\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =\operatorname*{tr}%
\nolimits_{\mathcal{H}_{\operatorname*{tr}}}\left\{  \Pi_{\operatorname*{tr}%
}\left(  I_{\mathcal{A}}\right)  \right\}  =\left\langle \Pi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  \right\rangle _{0}=1
\]
and
\begin{gather}
\operatorname{Tr}_{\mathcal{H}_{\operatorname*{tr}}}\left\{  \Pi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  \right\}  =\left\langle
\left.  \phi_{\operatorname*{tr}}\right\vert \Pi_{\operatorname*{tr}}\left(
I_{\mathcal{A}}\right)  \phi_{\operatorname*{tr}}\right\rangle _{\mathcal{H}%
_{\operatorname*{tr}}}+\sum_{1\leq m\leq2r}\sum_{1\leq j_{1}<\cdots<j_{m}%
\leq2r}\left\langle \left.  \Phi_{\operatorname*{tr}}\left(  \widetilde{x}%
_{j_{1}}\cdots\widetilde{x}_{j_{m}}\ \right)  \right\vert \Pi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  \Phi_{\operatorname*{tr}%
}\left(  \widetilde{x}_{j_{1}}\cdots\widetilde{x}_{j_{m}}\ \right)
\right\rangle _{\mathcal{H}_{\operatorname*{tr}}}\\
=1+r+\binom{r}{2}+\cdots+\binom{2r}{2r}=2^{2r},
\end{gather}
hence
\begin{equation}
\operatorname*{tr}\left\{  I_{\mathcal{A}}\right\}  =\frac{1}{2^{2r}%
}\operatorname{Tr}_{\mathcal{H}_{\operatorname*{tr}}}\left\{  \Pi
_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)  \right\}  .
\end{equation}


\begin{remark}%
\begin{align}
\varphi_{\operatorname*{tr}}\left(  A\right)   &  =\left\langle \left.
\Phi_{\varphi_{\operatorname*{tr}}}\left(  I_{\mathcal{A}}\ \right)
\right\vert \left\langle \Pi_{\operatorname*{tr}}\left(  A\right)
\right\rangle _{0}\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)
\right\rangle _{\mathcal{H}_{\operatorname*{tr}}}\\
&  =\sum\limits_{0\leq m\leq2r}\sum\limits_{1\leq j_{1}<\cdots<j_{m}\leq
2r}{\Large x}\left(  A\right)  _{j_{1}\cdots j_{m}}\left\langle \left.
\Phi_{\operatorname*{tr}}\left(  I_{\mathcal{A}}\ \right)  \right\vert
\Pi_{\operatorname*{tr}}\left(  x_{j_{1}}\right)  \cdots\Pi
_{\operatorname*{tr}}\left(  x_{j_{m}}\right)  \Phi_{\operatorname*{tr}%
}\left(  I_{\mathcal{A}}\ \right)  \right\rangle _{\mathcal{H}%
_{\operatorname*{tr}}}\\
&  =\sum\limits_{0\leq m\leq2r}\sum\limits_{1\leq j_{1}<\cdots<j_{m}\leq
2r}{\Large x}\left(  A\right)  _{j_{1}\cdots j_{m}}\varphi_{\operatorname*{tr}%
}\left(  x_{j_{1}}\cdots x_{j_{m}}\right)  ={\Large x}\left(  A\right)  _{0}.
\end{align}

\end{remark}
\end{proof}

\begin{definition}
The \emph{Folium} $\mathfrak{F}_{_{\operatorname*{tr}}}$ of Normal Normalized
Trace states generated by $\varphi_{\operatorname*{tr}}$ $\in$ $\mathcal{S}%
\left(  \mathcal{A}\right)  $ is given by
\begin{equation}
\mathfrak{F}_{\operatorname*{tr}}=\left\{  \left.  \overset{}{\varphi
_{\operatorname*{tr}D}}\right\vert \varphi_{\operatorname*{tr}D}\left(
A\right)  =\operatorname{Tr}_{\mathcal{H}_{\operatorname*{tr}}}\left\{
\Pi_{\operatorname*{tr}}\left(  A\right)  D\right\}  ,\,A\in\mathcal{A}%
,\,D\in\mathcal{B}_{1}\left(  \mathcal{H}_{\operatorname*{tr}}\right)
\right\}  .
\end{equation}

\end{definition}

\begin{example}
Let $r=4$ then
\begin{equation}
\dim\left\{  \mathcal{A}\right\}  =2^{2r}=2^{8}=256
\end{equation}
and consider the occupation operator $n_{3}$
\begin{equation}
n_{3}=a_{3}^{\dagger}a_{3}=\frac{1}{2}I_{\mathcal{A}}+ix_{3}x_{3+8}=\frac
{1}{2}I_{\mathcal{A}}+ix_{3}x_{11}%
\end{equation}
which can be expressed as
\begin{equation}
n_{3}=X\left(  n_{J}\right)  _{0}I_{\mathcal{A}}+X\left(  n_{J}\right)
_{\left(  3\right)  \left(  11\right)  }x_{3}x_{11}%
\end{equation}
and
\begin{equation}
n_{3}={\Large a}\left(  n_{3}\right)  _{\left(  3\right)  \left(  3\right)
}a_{3}^{\dagger}a_{3}%
\end{equation}
where
\begin{align}
{\Large x}\left(  n_{3}\right)  _{0}  &  =\frac{1}{2}\\
{\Large x}\left(  n_{3}\right)  _{\left(  3\right)  \left(  11\right)  }  &
=i.
\end{align}
and
\begin{align}
{\Large a}\left(  n_{3}\right)  _{0}  &  =0\\
{\Large a}\left(  n_{3}\right)  _{\left(  3\right)  \left(  3\right)  }  &
=1.
\end{align}

\end{example}

\begin{remark}%
\begin{equation}
\left\langle n_{3}\right\rangle _{0}=\operatorname*{tr}\left\{  n_{3}\right\}
={\Large x}\left(  n_{3}\right)  _{0}=\frac{1}{2}.
\end{equation}

\end{remark}

\begin{example}
\begin{enumerate}
\item The representations $\Pi_{\varphi_{f}}$ and $\Pi_{\operatorname*{tr}}$
are given by
\begin{gather}
\mathcal{H}_{\varphi_{f}}=\Phi_{\varphi_{f}}\left(  \mathcal{A}\right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n}}\right\rangle \right\vert 1\leq
j_{1}<\cdots<j_{n}\leq4;0\leq n\leq4\right\} \\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \Phi_{\varphi_{f}%
}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger}\right)  \right\vert
1\leq j_{1}<\cdots<j_{n}\leq4;0\leq n\leq4\right\} \\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \Phi_{\varphi_{f}%
}\left(  x_{j_{1}}\cdots x_{j_{m}}\right)  \right\vert 1\leq j_{1}%
<\cdots<j_{m}\leq8,0\leq m\leq8\right\} \\
\dim\left\{  \mathcal{H}_{\varphi_{f}}\right\}  =2^{4}=16,
\end{gather}
which is generated by the subspace%
\begin{gather}
\mathcal{H}_{\varphi_{f}}^{1}=\Phi_{\varphi_{f}}\left(  \mathcal{A}%
_{1}\right)  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j_{1}}\right\rangle \right\vert 1\leq j_{1}\leq4\right\}
\\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \Phi_{\varphi_{f}%
}\left(  a_{j_{1}}^{\dagger}\right)  \right\vert 1\leq j_{1}\leq4\right\} \\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \Phi_{\varphi_{f}%
}\left(  x_{j_{1}}\right)  \right\vert 1\leq j_{1}\leq8\right\} \\
\dim\left\{  \mathcal{H}_{\varphi_{f}}^{1}\right\}  =4
\end{gather}
and

