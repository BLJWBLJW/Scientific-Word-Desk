\wedge\mathcal{H}^{1d}\right)  \left(  2\right)  \ \oplus\left(
{\huge \wedge}^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)  \left(
2\right)  \right] \\
&  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{j}^{d}\right\rangle ,\left\vert
\varphi_{j}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\vert 1\leq
j\leq2\right\}  .
\end{align}


\item
\[
{\huge \wedge}^{4}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert \varphi_{1}^{{}%
}\varphi_{2}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\}  ,
\]
hence

\item
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
=\mathbb{C}\oplus{\huge \wedge}^{1}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)  \oplus\left[  \left(  {\huge \wedge}^{2}%
\mathcal{H}^{1}\right)  \right]  \left(  1\right)  \oplus\left[  \left(
\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)  \left(  2\right)  \oplus\left(
\mathcal{H}^{1d}\wedge\mathcal{H}^{1}\right)  \right]  \left(  2\right)
\oplus\left[  {\huge \wedge}^{2}\mathcal{H}^{1d}\right]  \left(  1\right) \\
&  \oplus\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge
\mathcal{H}^{1d}\right)  \left(  2\right)  \ \oplus\left(  {\huge \wedge}%
^{2}\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right)  \left(  2\right)  \right]
\oplus{\huge \wedge}^{4}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\left(  1\right)
\end{align}
giving%
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
=\mathbb{C}\oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j}^{{}}\right\rangle ,\left\vert \varphi_{j}%
^{d}\right\rangle \right\vert 1\leq j\leq2\right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j}^{{}}\right\rangle \right\vert 1\leq j\leq2\right\}  \oplus
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j}^{d}\right\rangle \right\vert 1\leq j\leq2\right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{d}\right\rangle ,\left\vert \varphi_{2}^{{}%
}\varphi_{1}^{d}\right\rangle ,\left\vert \varphi_{1}^{d}\varphi_{2}^{{}%
}\right\rangle ,\left\vert \varphi_{2}^{d}\varphi_{1}^{{}}\right\rangle
\right\}  \right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\right\rangle ,\left\vert \varphi_{2}^{{}%
}\varphi_{1}^{{}}\right\rangle ,\left\vert \varphi_{1}^{d}\varphi_{2}%
^{d}\right\rangle ,\left\vert \varphi_{2}^{d}\varphi_{1}^{d}\right\rangle
\right\}  \right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{1}^{d}\right\rangle ,\left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{2}^{d}\right\rangle ,\left\vert
\varphi_{1}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle ,\left\vert
\varphi_{2}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle
\right\}
\end{align}
and
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
=\left[  \mathbb{C}\right]  \oplus\left[  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right] \\
&  \oplus\left[  \mathcal{H}^{1}\right]  \oplus\left[  \mathcal{H}^{1d}\right]
\\
&  \oplus\left[  \mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right] \\
&  \oplus\left[  \mathcal{H}^{2}\right]  \oplus\left[  \mathcal{H}^{2d}\right]
\\
&  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right]  \oplus\left[  \mathcal{H}%
^{1}\wedge%
