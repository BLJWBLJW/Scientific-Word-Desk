\begin{theorem}
In finite dimensional case $r<\infty$ the number basis of $\mathfrak{B}%
^{2^{r}}$ is in $1-1$ correspondence to the standard basis of $jw\left(
\mathcal{H}_{\mathcal{F}}\right)  $ which is in $1-1$ correspondence to the
basis $\left\{  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\right\}  $ of $\mathcal{H}_{\mathcal{F}}$ i.e.
\begin{align}
&  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\overset{\mathfrak{O}_{\varphi}}{\longleftrightarrow}\left\vert 0\cdots
0\overset{j_{1}}{1}0\cdots0\cdots0\,\cdots0\cdots0\overset{j_{p}}{1}%
0\cdots\overset{r}{0}\right\rangle \nonumber\\
&  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle
\overset{jw_{\varphi}}{\longleftrightarrow}\left\vert \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\overset{j_{1}\cdots}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\overset{\cdots\cdots\cdots\cdots\cdots\cdots\cdots
\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  }\otimes\overset{\cdots j_{p}}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\overset{r}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  }\right\rangle \nonumber\\
&  \equiv\left\vert e_{1}\otimes\cdots\otimes e_{1}\otimes\overset{j_{1}%
\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots\cdots
j_{p}}{e_{2}\otimes e_{1}\otimes\cdots\otimes e_{1}\otimes e_{2}}\otimes
e_{1}\otimes\cdots\otimes e_{1}\right\rangle .
\end{align}

\end{theorem}

The vector states
\begin{equation}
\left\vert 0\cdots0\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}0\cdots
0\overset{j_{p}}{1}0\cdots0\right\rangle ;1\leq p\leq r,1\leq j_{1}%
<\cdots<j_{p}\leq r
\end{equation}
can be\emph{ identified with states} of $2^{r}$-\emph{Qubits }in \emph{quantun
computing} and \emph{quantum information theory}.

\begin{theorem}
The ket-bra operators
\begin{equation}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{q}}\right\vert \in\mathcal{F};\,1\leq
j_{1},k_{1},\cdots,j_{q},k_{q}\leq r;1\leq q\leq r
\end{equation}
are represented in the Pauli representation $JW\left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{q}}\right\vert \right)  $ by
\begin{equation}
\left\vert e_{j_{1}}\otimes\cdots\otimes e_{j_{r}}\right\rangle \otimes
\left\langle e_{k_{1}}\otimes\cdots\otimes e_{k_{r}}\right\vert ;\,1\leq
j_{1},k_{1},\cdots,j_{r},k_{r}\leq2,\nonumber
\end{equation}
which can be recast as
\begin{equation}
\left\vert e_{j_{1}}\right\rangle \left\langle e_{k_{1}}\right\vert
\otimes\cdots\otimes\left\vert e_{j_{r}}\right\rangle \left\langle e_{k_{r}%
}\right\vert ;\,\left\vert e_{j_{1}}\right\rangle \in\mathbb{C}^{2}%
,\left\langle e_{k_{1}}\right\vert \in\mathbb{C}^{2d};1\leq j_{1},k_{1}%
,\cdots,j_{r},k_{r}\leq2.
\end{equation}

\end{theorem}

\begin{notation}
\begin{itemize}
\item
\begin{equation}
\left\vert a\right\rangle \otimes\left\vert b\right\rangle =\left\vert
a\right\rangle \left\vert b\right\rangle =\left\vert a\otimes b\right\rangle
\end{equation}


\item
\begin{equation}
\left\vert a\right\rangle \#\left\langle b\right\vert =\left\vert
a\right\rangle \left\langle b\right\vert
\end{equation}


\item The $r=1$ case
\end{itemize}
\end{notation}

\begin{enumerate}
\item
\begin{align}
\left\vert a\right\rangle \otimes\left\vert b\right\rangle  &  =\left(
a_{1}\left\vert e_{1}\right\rangle +a_{2}\left\vert e_{2}\right\rangle
\right)  \otimes\left(  b_{1}\left\vert e_{1}\right\rangle +b_{2}\left\vert
e_{2}\right\rangle \right)  =a_{1}b_{1}\left\vert e_{1}\otimes e_{1}%
\right\rangle +a_{1}b_{2}\left\vert e_{1}\otimes e_{2}\right\rangle
+a_{2}b_{1}\left\vert e_{2}\otimes e_{1}\right\rangle +a_{2}b_{2}\left\vert
e_{2}\otimes e_{2}\right\rangle \\
\left\vert a\right\rangle \left\langle b\right\vert  &  =\left\vert
a_{1}\left\vert e_{1}\right\rangle +a_{2}\left\vert e_{2}\right\rangle
\right\rangle \left\langle b_{1}\left\langle e_{1}\right\vert +b_{2}%
\left\langle e_{2}\right\vert \right\vert =a_{1}b_{1}\left\vert e_{1}%
\right\rangle \left\langle e_{1}\right\vert +a_{1}b_{2}\left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert +a_{2}b_{1}\left\vert
e_{2}\right\rangle \left\langle e_{1}\right\vert +a_{2}b_{2}\left\vert
e_{2}\right\rangle \left\langle e_{2}\right\vert .
\end{align}


\begin{enumerate}
\item
\begin{equation}
\left\vert \left(
\begin{array}
[c]{c}%
a_{1}\\
a_{2}%
\end{array}
\right)  \right\rangle \otimes\left\vert \left(
\begin{array}
[c]{c}%
b_{1}\\
b_{2}%
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
a_{1}\left(
\begin{array}
[c]{c}%
b_{1}\\
b_{2}%
\end{array}
\right) \\
a_{2}\left(
\begin{array}
[c]{c}%
b_{1}\\
b_{2}%
\end{array}
\right)
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
a_{1}b_{1}\\
a_{1}b_{2}\\
a_{2}b_{1}\\
a_{2}b_{2}%
\end{array}
\right)  \right\rangle .
\end{equation}


\item
\begin{gather}
\left\vert \left(
\begin{array}
[c]{c}%
a_{1}\\
a_{2}%
\end{array}
\right)  \right\rangle \#\left\langle \left(
\begin{array}
[c]{c}%
b_{1}\\
b_{2}%
\end{array}
\right)  \right\vert =\left\vert \left(
\begin{array}
[c]{c}%
a_{1}\\
a_{2}%
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
b_{1}\\
b_{2}%
\end{array}
\right)  \right\vert =\left(
\begin{array}
[c]{c}%
a_{1}\\
a_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\overline{b_{1}} & \overline{b_{2}}%
\end{array}
\right) \\
=\left(
\begin{array}
[c]{c}%
a_{1}\left(
\begin{array}
[c]{cc}%
\overline{b_{1}} & \overline{b_{2}}%
\end{array}
\right) \\
a_{2}\left(
\begin{array}
[c]{cc}%
\overline{b_{1}} & \overline{b_{2}}%
\end{array}
\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
a_{1}\overline{b_{1}} & a_{1}\overline{b_{2}}\\
a_{2}\overline{b_{1}} & a_{2}\overline{b_{2}}%
\end{array}
\right)  .
\end{gather}


\item
\begin{gather}
\left(
\begin{array}
[c]{cc}%
A_{11} & A_{12}\\
A_{21} & A_{22}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
B_{11} & B_{12}\\
B_{21} & B_{22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
A_{11}\left(
\begin{array}
[c]{cc}%
B_{11} & B_{12}\\
B_{21} & B_{22}%
\end{array}
\right)  & A_{12}\left(
\begin{array}
[c]{cc}%
B_{11} & B_{12}\\
B_{21} & B_{22}%
\end{array}
\right) \\
A_{21}\left(
\begin{array}
[c]{cc}%
B_{11} & B_{12}\\
B_{21} & B_{22}%
\end{array}
\right)  & A_{22}\left(
\begin{array}
[c]{cc}%
B_{11} & B_{12}\\
B_{21} & B_{22}%
\end{array}
\right)
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cccc}%
A_{11}B_{11} & A_{11}B_{12} & A_{12}B_{11} & A_{12}B_{12}\\
A_{11}B_{21} & A_{11}B_{22} & A_{12}B_{21} & A_{12}B_{22}\\
A_{21}B_{11} & A_{21}B_{12} & A_{22}B_{11} & A_{22}B_{12}\\
A_{21}B_{21} & A_{21}B_{22} & A_{22}B_{21} & A_{22}B_{22}%
\end{array}
\right)  .
\end{gather}

\end{enumerate}

\item
\begin{align}
\left\vert e_{1}\right\rangle  &  \rightarrow\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
\left\vert e_{2}\right\rangle  &  \rightarrow\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  .
\end{align}


\item
\begin{equation}
\left\vert e_{1}\right\rangle \#\left\langle e_{2}\right\vert =\left\vert
e_{1}\right\rangle \left\langle e_{2}\right\vert \rightarrow\left\vert \left(
%
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right\rangle \left\langle \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \right\vert =\left(
\begin{array}
[c]{cc}%
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  .
\end{equation}


\item
\begin{align}
\left\vert e_{1}\otimes e_{1}\right\rangle  &  \rightarrow\left\vert \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
1\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
0\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right)  \right\rangle \\
\left\vert e_{1}\otimes e_{2}\right\rangle  &  \rightarrow\left\vert \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
1\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right) \\
0\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  \right\rangle \\
\left\vert e_{2}\otimes e_{1}\right\rangle  &  \rightarrow\left\vert \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
0\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
1\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right\rangle \\
\left\vert e_{2}\otimes e_{2}\right\rangle  &  \rightarrow\left\vert \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
0\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right) \\
1\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)
\end{array}
\right)  \right\rangle =\left\vert \left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)  \right\rangle .
\end{align}

\end{enumerate}

The replacement operation $a_{2}^{\dagger}a_{1}$
\begin{equation}
a_{2}^{\dagger}a_{1}\left\vert \varphi_{1}\varphi_{j_{2}}\cdots\varphi_{j_{p}%
}\right\rangle =\left\vert \varphi_{2}\varphi_{j_{2}}\cdots\varphi_{j_{p}%
}\right\rangle \equiv JW\left(  a_{2}^{\dagger}a_{1}\right)  \left\vert
10\cdots0\overset{j_{2}\cdots}{1}0\cdots0\overset{\cdots j_{p}}{1}%
0\cdots\overset{r}{0}\right\rangle =\left\vert 01\cdots0\overset{j_{2}%
\cdots}{1}0\cdots0\overset{\cdots j_{p}}{1}0\cdots\overset{r}{0}\right\rangle
\end{equation}
is expressed in the Pauli representation by
\begin{align}
a_{2}^{\dagger}a_{1}  &  \leftrightarrow\left[  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right]  \times\\
&  \times\left[  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right] \\
&  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  .
\end{align}


\begin{example}
Creation and anihilation operators in the $r=2$ case

\begin{enumerate}
\item
\begin{align}
a_{1}  &  =\,\overset{1-1}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots
\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes\overset{1}{\overbrace{\mathbb{I}%
_{2}\otimes\cdots\otimes\mathbb{I}_{2}}}\,=a\otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
&  =\left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert \otimes
\mathbb{I}_{2}=\left\vert e_{1}\otimes e_{1}\right\rangle \left\langle
e_{2}\otimes e_{1}\right\vert +\left\vert e_{1}\otimes e_{2}\right\rangle
\left\langle e_{2}\otimes e_{2}\right\vert \\
a_{1}^{\dagger}  &  =\,\overset{1-1}{\overbrace{\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}\otimes
\overset{1}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=a^{\dagger}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
&  =\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert \otimes
\mathbb{I}_{2}=\left\vert e_{2}\otimes e_{1}\right\rangle \left\langle
e_{1}\otimes e_{1}\right\vert +\left\vert e_{2}\otimes e_{2}\right\rangle
\left\langle e_{1}\otimes e_{2}\right\vert .
\end{align}


\item
\begin{align}
a_{2}  &  =\,\overset{2-1}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots
\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes\overset{0}{\overbrace{\mathbb{I}%
_{2}\otimes\cdots\otimes\mathbb{I}_{2}}}\,=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes a=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right) \\
&  =\left(  \left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert \right)
\otimes\left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert =\left\vert
e_{1}\otimes e_{1}\right\rangle \left\langle e_{1}\otimes e_{2}\right\vert
-\left\vert e_{2}\otimes e_{1}\right\rangle \left\langle e_{2}\otimes
e_{2}\right\vert \\
a_{2}^{\dagger}  &  =\,\overset{2-1}{\overbrace{\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}\otimes
\overset{0}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes a^{\dagger}=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right) \\
&  =\left(  \left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert
-\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert \right)
\otimes\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert =\left\vert
e_{1}\otimes e_{2}\right\rangle \left\langle e_{1}\otimes e_{1}\right\vert
-\left\vert e_{2}\otimes e_{2}\right\rangle \left\langle e_{2}\otimes
e_{1}\right\vert .
\end{align}


\item
\begin{align}
a_{1}^{\dagger}a_{1}  &  =\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
a_{2}^{\dagger}a_{2}  &  =\left(  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  .
\end{align}


\item
\begin{align}
\left(  a_{1}^{\dagger}a_{1}\right)  ^{2}  &  =\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
\left(  a_{2}^{\dagger}a_{2}\right)  ^{2}  &  =\left(  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  .
\end{align}


\item
\begin{align}
a_{1}^{\dagger}a_{1}  &  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \leftrightarrow\left\vert e_{2}\right\rangle \left\langle
e_{2}\right\vert \otimes I_{2}=\left\vert e_{2}\otimes e_{1}\right\rangle
\left\langle e_{2}\otimes e_{1}\right\vert +\left\vert e_{2}\otimes
e_{2}\right\rangle \left\langle e_{2}\otimes e_{2}\right\vert \\
a_{2}^{\dagger}a_{2}  &  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \leftrightarrow I_{2}\otimes\left\vert e_{1}\right\rangle
\left\langle e_{1}\right\vert =\left\vert e_{1}\otimes e_{1}\right\rangle
\left\langle e_{1}\otimes e_{1}\right\vert +\left\vert e_{2}\otimes
e_{1}\right\rangle \left\langle e_{2}\otimes e_{1}\right\vert .
\end{align}


\item
\begin{gather}
a_{2}^{\dagger}a_{1}=\left(  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
0 & -1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right) \\
\leftrightarrow-\left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
\otimes\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert
=-\left\vert e_{1}\otimes e_{2}\right\rangle \left\langle e_{2}\otimes
e_{2}\right\vert .
\end{gather}


\item
\begin{gather}
a_{1}^{\dagger}a_{2}^{\dagger}=\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
-1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right) \\
\leftrightarrow-\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
\otimes\left\vert e_{2}\right\rangle \left\langle e_{1}\right\vert
=-\left\vert e_{2}\otimes e_{2}\right\rangle \left\langle e_{1}\otimes
e_{1}\right\vert .
\end{gather}


\item
\begin{equation}
a_{2}a_{1}=\left(
\begin{array}
[c]{cc}%
0 & -1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \leftrightarrow-\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert \otimes\left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert =-\left\vert e_{1}\otimes e_{1}\right\rangle \left\langle
e_{2}\otimes e_{2}\right\vert .
\end{equation}


\item
\begin{equation}
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}\leftrightarrow\left(  -\left\vert
e_{2}\otimes e_{2}\right\rangle \left\langle e_{1}\otimes e_{1}\right\vert
\right)  \circ\left(  -\left\vert e_{1}\otimes e_{1}\right\rangle \left\langle
e_{2}\otimes e_{2}\right\vert \right)  =\left\vert e_{2}\otimes e_{2}%
\right\rangle \left\langle e_{2}\otimes e_{2}\right\vert
\end{equation}


\item
\begin{gather}
a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
-1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right)  \circ\left(  \left(
\begin{array}
[c]{cc}%
0 & -1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \right) \\
=\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & -1\\
0 & 0
\end{array}
\right)  \right)  \otimes\left(  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right) \\
\leftrightarrow\left(  -\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \otimes\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \right)  \circ\left(  -\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert \otimes\left\vert e_{1}\right\rangle
\left\langle e_{2}\right\vert \right)  =\left\vert e_{2}\right\rangle
\left\langle e_{1}\right\vert \left\vert e_{1}\right\rangle \left\langle
e_{2}\right\vert \otimes\left\vert e_{2}\right\rangle \left\langle
e_{1}\right\vert \left\vert e_{1}\right\rangle \left\langle e_{2}\right\vert
\\
=\left\vert e_{2}\right\rangle \left\langle e_{2}\right\vert \otimes\left\vert
e_{2}\right\rangle \left\langle e_{2}\right\vert =\left\vert e_{2}\otimes
e_{2}\right\rangle \left\langle e_{2}\otimes e_{2}\right\vert
\end{gather}

\end{enumerate}
\end{example}

The action on $\mathbb{C}^{2r}$ is given by \qquad%
\begin{align}
&  \left[  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\overset{3\cdots}{\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  }\otimes\cdots\otimes\overset{\cdots r}{\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  }\right]  \times\nonumber\\
&  \left\vert \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\overset{j_{2}\cdots}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\left(
