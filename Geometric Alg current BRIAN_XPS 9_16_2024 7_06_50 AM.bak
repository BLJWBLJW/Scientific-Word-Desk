\ \right\}  \right]  \oplus\left[  \mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left\vert \varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\}
\right] \\
\oplus\left[  \mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\right\rangle ,\left\vert \varphi_{2}^{{}}\right\rangle
\ \right\}  \otimes\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\vert \varphi_{1}^{d}\right\rangle ,\left\vert \varphi_{2}^{d}%
\right\rangle \ \right\}  \right] \\
\oplus\left[  \mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\right\rangle ,\left\vert \varphi_{2}^{{}}\right\rangle
\ \right\}  \otimes\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\vert \varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\}  \right] \\
\oplus\left[  \mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\right\rangle \right\}  \otimes\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \varphi_{1}^{d}%
\right\rangle ,\left\vert \varphi_{2}^{d}\right\rangle \ \right\}  \right] \\
\oplus\left[  \mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\right\rangle \right\}  \otimes\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\vert \varphi_{1}^{d}\varphi
_{2}^{d}\right\rangle \ \ \right\}  \right]  ,
\end{gather}
which should be compared to
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &
=\mathbb{C}\oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.
\left\vert \varphi_{j}^{{}}\right\rangle ,\left\vert \varphi_{j}%
^{d}\right\rangle \right\vert 1\leq j\leq2\right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j}^{{}}\right\rangle \right\vert 1\leq j\leq2\right\}  \oplus
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \left\vert
\varphi_{j}^{d}\right\rangle \right\vert 1\leq j\leq2\right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{d}\right\rangle ,\left\vert \varphi_{2}^{{}%
}\varphi_{1}^{d}\right\rangle ,\left\vert \varphi_{1}^{d}\varphi_{2}^{{}%
}\right\rangle ,\left\vert \varphi_{2}^{d}\varphi_{1}^{{}}\right\rangle
\right\}  \right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\right\rangle ,\left\vert \varphi_{2}^{{}%
}\varphi_{1}^{{}}\right\rangle ,\left\vert \varphi_{1}^{d}\varphi_{2}%
^{d}\right\rangle ,\left\vert \varphi_{2}^{d}\varphi_{1}^{d}\right\rangle
\right\}  \right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{1}^{d}\right\rangle ,\left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{2}^{d}\right\rangle ,\left\vert
\varphi_{1}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle ,\left\vert
\varphi_{2}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle \right\} \\
&  \oplus\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}^{{}}\varphi_{2}^{{}}\varphi_{1}^{d}\varphi_{2}^{d}\right\rangle
\right\}
\end{align}


