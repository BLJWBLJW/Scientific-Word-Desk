where the \emph{spin step down} operator for $r=1,$ $a\equiv S_{-}%
=S_{+}^{\dagger}$ is given by
\begin{equation}
a=\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  .
\end{equation}
\emph{It is important to observe the use of }%
\begin{equation}
\mathbb{\sigma}_{z}=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)
\end{equation}
\emph{ in the definition of the fermion creation and annihilation operators.
This is necessary in order that operators at \underline{\emph{different
sites}} anti commute, where different sites correspond to different fermion
degrees of freedom.} These operators are "\emph{non local"} operators in the
context of spin chains as they act non trivially on more than one site (though
some authors disagree about this characterization). One can define
\emph{local} spin chain operators that commute, if they belong to diffferent
sites, by
\begin{equation}
m_{k}=%
%TCIMACRO{\dbigotimes \limits_{1\leq j\leq k-1}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{1\leq j\leq k-1}}
%EndExpansion
\mathbb{I}_{2}\otimes m\otimes%
%TCIMACRO{\dbigotimes \limits_{k+1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{k+1\leq j\leq r}}
%EndExpansion
\mathbb{I}_{2}=\overset{k-1}{\,\overbrace{\,\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\otimes\overset{k}{a}\otimes
\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
},1\leq k\leq r,\nonumber
\end{equation}
where $m_{k}\in%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathcal{M}\left(  2,\mathbb{C}\right)  $ and $m\in\mathcal{M}\left(
2,\mathbb{C}\right)  ,$ that \emph{do not} represent fermion creation and
annihilation operators, \emph{which are non local operators}, but can be
expanded in terms of fermion operators as the fermion operators \emph{span} $%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathcal{M}\left(  2,\mathbb{C}\right)  .$

\begin{remark}
$r$ is the number of internal degrees of freedom associated with a Hilbert
space of dimension $r$ and $n$ is the number of particles of internal degrees
of freedom $r.$ Fermion fields are described by operators acting the exterior
algebra $\mathcal{F}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  .$
\end{remark}

\subsubsection{Angular Momentum}

Individual systems with angular momentum representations $\left\{
\mathcal{D}_{j_{1}},\mathcal{D}_{j_{2}}\right\}  $ are related to composite
angular momentum representations via decomposing tensor products of
representations into direct sums of representations by, (producing
\emph{Clebsch-Gordon} coefficients),
\begin{align}
\mathcal{D}_{j_{1}}\left(  SL\left(  2,\mathbb{C}\right)  \right)
\otimes\mathcal{D}_{j_{2}}\left(  SL\left(  2,\mathbb{C}\right)  \right)   &
=%
%TCIMACRO{\tbigoplus _{j=\left\vert j_{1}-j_{2}\right\vert }^{j=j_{1}+j_{2}}}%
%BeginExpansion
{\textstyle\bigoplus_{j=\left\vert j_{1}-j_{2}\right\vert }^{j=j_{1}+j_{2}}}
%EndExpansion
\mathcal{D}_{j}\left(  SL\left(  2,\mathbb{C}\right)  \right)  ;\quad
j_{1}=\frac{k_{1}}{2},j_{2}=\frac{k_{2}}{2};\quad k_{1},k_{2}\in\left\{
0,1,\cdots,n\right\}  ,0\leq n\leq\infty\\
j  &  =\left\vert j_{1}-j_{2}\right\vert ,\,\left\vert j_{1}-j_{2}\right\vert
+1,\cdots,j_{1}+j_{2},
\end{align}
e.g, in the \emph{special case} of $SU(2)$ the adjoint representation
decomposes as
\begin{equation}
\mathcal{D}_{\frac{1}{2}}\left(  SU\left(  2\right)  \right)  \otimes
\overline{\mathcal{D}_{\frac{1}{2}}\left(  SU\left(  2\right)  \right)
}=\mathcal{D}_{0}\left(  SU\left(  2\right)  \right)  \oplus\mathcal{D}%
_{1}\left(  SU\left(  2\right)  \right)  ,
\end{equation}
where $\mathcal{D}_{1}\left(  SU\left(  2\right)  \right)  $ is the adjoint
representation of $SU(2)$ and $\mathcal{D}_{0}\left(  SU\left(  2\right)
\right)  $ the trivial representation.

If the tensor product of representations are restricted to $SO\left(
3,\mathbb{R}\right)  $ or $SU\left(  2\right)  $ and the rank of the tensor
product is even then the representations are called \emph{even and are
tensorial}, while if the rank is odd the representations are called \emph{odd
and are spinorial. }The irreducible representations $\mathcal{D}_{j}$
correspond to the eigenvalues $l\left(  l+1\right)  $ of the Casimir operator
$L^{2}$ of $so\left(  3,\mathbb{R}\right)  $ or equivalently $s\left(
s+1\right)  $ of $S^{2}$ of $su\left(  2\right)  \ $and have dimension $2l+1$
and $2s+1$ respectively. The values of $l$ and $s$ are respectively
\emph{integer} corresponding to even/tensorial or \emph{half integer}
corresponding to odd/spinorial. representations.

\paragraph{Spin Adaptation}

The action of the spin step down and step up operators are demonstrated by
\begin{align}
\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \equiv a\left\vert 2\right\rangle =\left\vert 1\right\rangle ,\\
\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \equiv a^{\dagger}\left\vert 2\right\rangle =0,\\
\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \equiv a\left\vert 1\right\rangle =0,\\
\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \equiv a^{\dagger}\left\vert 1\right\rangle =\left\vert
2\right\rangle
\end{align}
and%
\begin{align}
\frac{\mathbb{\sigma}_{z}}{2}\left\vert 1\right\rangle  &  =\frac{1}{2}\left(
%
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  =-\frac{1}{2}\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  ,\\
\frac{\mathbb{\sigma}_{z}}{2}\left\vert 2\right\rangle  &  =\frac{1}{2}\left(
%
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  .
\end{align}
$\lceil$The $S_{z}$ operator can be expressed in terms of the creation and
annihilation operators as
\begin{align}
S_{z}\left\vert 1\right\rangle  &  =\frac{1}{2}\left(  a_{2}^{\dagger}%
a_{2}-a_{1}^{\dagger}a_{1}\right)  \left\vert 1\right\rangle =-\frac{1}%
{2}\left\vert 1\right\rangle \\
S_{z}\left\vert 2\right\rangle  &  =\frac{1}{2}\left(  a_{2}^{\dagger}%
a_{2}-a_{1}^{\dagger}a_{1}\right)  \left\vert 2\right\rangle =+\frac{1}%
{2}\left\vert 2\right\rangle .
\end{align}
$\rfloor$

giving in general for any $r$ the total spin operators
\begin{align}
S_{z}  &  =\frac{1}{2}\sum_{1\leq j\leq s}\left\{  a_{j+r}^{\dagger}%
a_{j+r}-a_{j}^{\dagger}a_{j}\right\} \\
S_{+}  &  =\sum_{1\leq j\leq r}a_{j+r}^{\dagger}a_{j}\\
S_{-}  &  =\sum_{1\leq j\leq r}a_{j}^{\dagger}a_{j+r}\\
S^{2}  &  =S_{-}S_{+}+S_{z}\left(  S_{z}+I_{\mathcal{F}}\right)  .
\end{align}
In the $r=2$ case
\begin{align}
S_{z}  &  =\frac{1}{2}\left\{  a_{2}^{\dagger}a_{2}-a_{1}^{\dagger}%
a_{1}\right\} \\
S_{+}  &  =a_{2}^{\dagger}a_{1}\\
S_{-}  &  =a_{1}^{\dagger}a_{2}\\
S^{2}  &  =S_{-}S_{+}+S_{z}\left(  S_{z}+I_{2}\right)  .
\end{align}


One can spin adapt $\mathbb{C}^{2r\otimes}=%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}$ by using a basis that are simultaneous eigenvectors of $S^{2}$
and $S_{z}$ i.e.
\begin{align}
S^{2}\left\vert \psi_{Sm_{S}}\right\rangle  &  =S\left(  S+1\right)
\left\vert \psi_{Sm_{S}}\right\rangle ;\,0\leq S\leq r\\
S_{z}\left\vert \psi_{Sm_{S}}\right\rangle  &  =m_{S}\left\vert \psi_{Sm_{S}%
}\right\rangle ;\,-S\leq m_{S}\leq S,\,2S+1\text{ different values},
\end{align}
where $\left\vert \psi_{Sm_{S}}\right\rangle \in$ $\mathbb{C}^{2r\otimes}.$

\begin{remark}
One can think of $\mathbb{C}^{2r}$ as

\begin{enumerate}
\item $\mathbb{C}^{2r\oplus}$ a Hilbert space, equipped with the \emph{direct
sum} norm, describing a single particle with $2r$-degrees of freedom or

\item $\mathbb{C}^{2r\otimes}$ a Hilbert space, equipped with the \emph{tensor
product} norm, describing $r$ distinguishable particles with $2$-internal
degrees of freedom

\item a \emph{Fermion field} Hilbert space, equipped with the tensor product
norm, describing coherent and incoherent mixtures of up to $r$-particles
particles with $2$-internal degrees of freedom.
\end{enumerate}
\end{remark}

\begin{example}
Hilbert spaces, equipped with the \emph{tensor product }norm, describing $N$
\emph{distinguishable particles} with $r=2$-internal degrees of freedom for
$N=1,2,3,4$:%
\begin{align}
\text{spaces}  &  :\mathbb{C}^{\otimes2\ },\mathbb{C}^{\otimes4\ }%
,\mathbb{C}^{\otimes6\ },\mathbb{C}^{\otimes8\ }\\
\text{particles}  &  :N=1,2,3,4\\
\mathbb{C}\text{-}\dim &  :2,4,8,16\qquad
\end{align}
have bases:%
\begin{align}
&  1.\left\{  \left\vert \alpha\right\rangle ,\left\vert \beta\right\rangle
\right\}  \overset{S_{z}\,\text{spin eigenvector}}{\equiv}\,\equiv
\,\overset{S_{z}\,\text{spin eigenvector to }S^{2}\text{ eigenvectors}%
}{-------------\rightarrow}\left\{  \left\vert \frac{1}{2}\right\rangle
,\left\vert -\frac{1}{2}\right\rangle \right\} \\
&  2.\left\{  \left\vert \alpha\alpha\right\rangle ,\left\vert \alpha
\beta\right\rangle ,\left\vert \beta\alpha\right\rangle ,\left\vert \beta
\beta\right\rangle \right\}  \overset{S_{z}\,\text{spin eigenvector to }%
S^{2}\text{ eigenvectors}}{-------------\rightarrow}\left\{  \left\vert
\alpha\beta-\beta\alpha\right\rangle ,\left\vert \alpha\alpha\right\rangle
,\left\vert \alpha\beta+\beta\alpha\right\rangle ,\left\vert \beta
\beta\right\rangle \right\} \\
&  \qquad\qquad\qquad\overset{\text{spin eigenvector}}{\equiv}\,\left\{
\left\vert 0\right\rangle ,\left\{  \left\vert +1\right\rangle ,\left\vert
0\right\rangle ,\left\vert -1\right\rangle \right\}  \right\} \\
&  3.\left\{  \left\vert \alpha\alpha\alpha\right\rangle ,\left\vert
\alpha\alpha\beta\right\rangle ,\left\vert \alpha\beta\alpha\right\rangle
,\left\vert \alpha\beta\beta\right\rangle ,\left\vert \beta\alpha
\alpha\right\rangle ,\left\vert \beta\alpha\beta\right\rangle ,\left\vert
\beta\beta\alpha\right\rangle ,\left\vert \beta\beta\beta\right\rangle
\right\} \\
&  \overset{S_{z}\,\text{spin eigenvector to }S^{2}\text{ eigenvectors}%
}{\left.  \qquad\right.  -------------\rightarrow}\,\left\{  \left\{
\left\vert \frac{1}{2}\right\rangle ,\left\vert -\frac{1}{2}\right\rangle
\right\}  ,\left\{  \left\vert \frac{1}{2}\right\rangle ,\left\vert -\frac
{1}{2}\right\rangle \right\}  ,\left\{  \left\vert \frac{3}{2}\right\rangle
,\left\vert \frac{1}{2}\right\rangle ,\left\vert -\frac{1}{2}\right\rangle
\left\vert -\frac{3}{2}\right\rangle \right\}  \right\} \\
&  \left.  \qquad\qquad\qquad\right.  \overset{\text{spin eigenvector}%
}{\equiv}\,\,\left\{  \left\vert 0\right\rangle ,\left\vert 0\right\rangle
,\left\{  \left\vert +1\right\rangle ,\left\vert 0\right\rangle ,\left\vert
-1\right\rangle \right\}  ,\left\{  \left\vert +1\right\rangle ,\left\vert
0\right\rangle ,\left\vert -1\right\rangle \right\}  ,\left\{  \left\vert
+1\right\rangle ,\left\vert 0\right\rangle ,\left\vert -1\right\rangle
\right\}  ,\left\{  \left\vert +2\right\rangle ,\left\vert +1\right\rangle
,\left\vert 0\right\rangle ,\left\vert -1\right\rangle ,\left\vert
-2\right\rangle \right\}  \right\} \\
&  4.\left\{  \left\vert \alpha\alpha\alpha\alpha\right\rangle ,\left\vert
\alpha\alpha\alpha\beta\right\rangle ,\left\vert \alpha\alpha\beta
\alpha\right\rangle ,\left\vert \alpha\alpha\beta\beta\right\rangle
,\left\vert \alpha\beta\alpha\alpha\right\rangle ,\left\vert \alpha\beta
\alpha\beta\right\rangle ,\left\vert \alpha\beta\beta\alpha\right\rangle
,\right. \\
&  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\right.  \left.
\left\vert \alpha\beta\beta\beta\right\rangle ,\beta\alpha\alpha
\alpha,\left\vert \beta\alpha\alpha\beta\right\rangle ,\left\vert \beta
\alpha\beta\alpha\right\rangle ,\left\vert \beta\alpha\beta\beta\right\rangle
,\left\vert \beta\beta\alpha\alpha\right\rangle ,\left\vert \beta\beta
\alpha\beta\right\rangle ,\left\vert \beta\beta\beta\alpha\right\rangle
,\left\vert \beta\beta\beta\beta\right\rangle \right\} \\
&  \overset{S_{z}\,\text{spin eigenvector to }S^{2}\text{ eigenvectors}%
}{---------\rightarrow}\,\left\{  \left\{  \left\vert \frac{1}{2}\right\rangle
,\left\vert -\frac{1}{2}\right\rangle \right\}  ,\left\{  \left\vert \frac
{1}{2}\right\rangle ,\left\vert -\frac{1}{2}\right\rangle \right\}  ,\left\{
\left\vert \frac{3}{2}\right\rangle ,\left\vert \frac{1}{2}\right\rangle
,\left\vert -\frac{1}{2}\right\rangle \left\vert -\frac{3}{2}\right\rangle
\right\}  ,\right. \\
&  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\right.  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\right.  \left.
\left\{
\begin{array}
[c]{c}%
\left\vert \frac{5}{2}\right\rangle ,\left\vert \frac{3}{2}\right\rangle
,\left\vert \frac{1}{2}\right\rangle ,\\
\left\vert -\frac{1}{2}\right\rangle ,\left\vert -\frac{3}{2}\right\rangle
,\left\vert -\frac{5}{2}\right\rangle
\end{array}
\right\}  \right\} \\
&  \left.  \qquad\qquad\qquad\right.  \overset{\text{spin eigenvector}%
}{\equiv}\,\,\left\{  \left\vert 0\right\rangle ,\left\vert 0\right\rangle
,\left\{  \left\vert +1\right\rangle ,\left\vert 0\right\rangle ,\left\vert
-1\right\rangle \right\}  ,\left\{  \left\vert +1\right\rangle ,\left\vert
0\right\rangle ,\left\vert -1\right\rangle \right\}  ,\left\{  \left\vert
+1\right\rangle ,\left\vert 0\right\rangle ,\left\vert -1\right\rangle
\right\}  ,\left\{  \left\vert +2\right\rangle ,\left\vert +1\right\rangle
,\left\vert 0\right\rangle ,\left\vert -1\right\rangle ,\left\vert
-2\right\rangle \right\}  \right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\left.  \left\{  \left\vert +3\right\rangle ,\left\vert
+2\right\rangle ,\left\vert +1\right\rangle ,\left\vert 0\right\rangle
,\left\vert -1\right\rangle ,\left\vert -2\right\rangle ,\left\vert
-3\right\rangle \right\}  \right\}  .
\end{align}

\end{example}

\begin{example}
The basis of the tensor product $\mathbb{C}^{2\ }\otimes\mathbb{C}^{2\ }$ can
be expressed as
\begin{align}
\left\vert \alpha\alpha\right\rangle  &  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
1\\
0\\
0\\
0
\end{array}
\right) \\
\left\vert \alpha\beta\right\rangle  &  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right) \\
\left\vert \beta\alpha\right\rangle  &  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right) \\
\left\vert \beta\beta\right\rangle  &  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
0\\
0\\
0\\
1
\end{array}
\right)
\end{align}
giving the spin adapted basis $\left\{  \left\vert \alpha\alpha\right\rangle
,\left\vert \beta\beta\right\rangle \right\}  $ plus%
\begin{align}
\frac{1}{\sqrt{2}}\left(  \left\vert \alpha\beta\right\rangle +\left\vert
\beta\alpha\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(  \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  +\left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right)  =\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
0\\
1\\
1\\
0
\end{array}
\right) \\
\frac{1}{\sqrt{2}}\left(  \left\vert \alpha\beta\right\rangle -\left\vert
\beta\alpha\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(  \left(
\begin{array}
[c]{c}%
0\\
1\\
0\\
0
\end{array}
\right)  -\left(
\begin{array}
[c]{c}%
0\\
0\\
1\\
0
\end{array}
\right)  \right)  =\frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{c}%
0\\
1\\
-1\\
0
\end{array}
\right)  .
\end{align}

\end{example}

\begin{example}
The tensor product spin bases for
\begin{gather}
N=1,2,3,4\\
S=\left\{  \frac{1}{2}\right\}  ,\left\{  0,1\right\}  ,\left\{  \frac{1}%
{2},\frac{3}{2}\right\}  ,\left\{  0,1,2\right\} \\
\,2S+1=1,2,3,4,5
\end{gather}
are

\begin{enumerate}
\item
\begin{align}
S^{2}\left(  \left\vert \alpha\right\rangle ,\left\vert \beta\right\rangle
\right)   &  =\left(  \left\vert \alpha\right\rangle ,\left\vert
\beta\right\rangle \right)  \mathbb{S}^{2}\qquad\\
1\text{ particle spin }\text{dim }  &  =2\text{ }=1\times\dim\left\{
\mathcal{D}_{\frac{1}{2}}\right\}  ;\,S=\frac{1}{2};\,2S+1=2,
\end{align}


\item
\begin{align}
&  S^{2}\left(  \left\vert \alpha\alpha\right\rangle ,\left\vert \alpha
\beta\right\rangle ,\left\vert \beta\alpha\right\rangle ,\left\vert \beta
\beta\right\rangle \right)  =\left(  \left\vert \alpha\alpha\right\rangle
,\left\vert \alpha\beta\right\rangle ,\left\vert \beta\alpha\right\rangle
,\left\vert \beta\beta\right\rangle \right)  \mathbb{S}^{2}\\
&  2\text{ particle spin }\text{dim}=4=1\times\dim\left\{  \mathcal{D}%
_{0}\right\}  +1\times\dim\left\{  \mathcal{D}_{1}\right\}
;\,S=0,1;\,2S+1=1,3,
\end{align}


\item
\begin{gather}
S^{2}\left(  \left\vert \alpha\alpha\alpha\right\rangle ,\left\vert
\alpha\alpha\beta\right\rangle ,\left\vert \alpha\beta\alpha\right\rangle
,\left\vert \alpha\beta\beta\right\rangle ,\left\vert \beta\alpha
\alpha\right\rangle ,\left\vert \beta\alpha\beta\right\rangle ,\left\vert
\beta\beta\alpha\right\rangle ,\left\vert \beta\beta\beta\right\rangle
\right)  =\left(  \left\vert \alpha\alpha\alpha\right\rangle ,\left\vert
\alpha\alpha\beta\right\rangle ,\left\vert \alpha\beta\alpha\right\rangle
,\left\vert \alpha\beta\beta\right\rangle ,\left\vert \beta\alpha
\alpha\right\rangle ,\left\vert \beta\alpha\beta\right\rangle ,\left\vert
\beta\beta\alpha\right\rangle ,\left\vert \beta\beta\beta\right\rangle
\right)  \mathbb{S}^{2}\\
3\text{ particle spin }\text{dim }=8\text{ }=2\times\dim\left\{
\mathcal{D}_{\frac{1}{2}}\right\}  +1\times\dim\left\{  \mathcal{D}_{\frac
{3}{2}}\right\}  ;\,S=\frac{1}{2},\frac{3}{2};\,2S+1=2,4,
\end{gather}


\item
\begin{align}
&  S^{2}\left(
\begin{array}
[c]{c}%
\left\vert \alpha\alpha\alpha\alpha\right\rangle ,\left\vert \alpha
\alpha\alpha\beta\right\rangle ,\left\vert \alpha\alpha\beta\alpha
\right\rangle ,\left\vert \alpha\alpha\beta\beta\right\rangle ,\left\vert
\alpha\beta\alpha\alpha\right\rangle ,\left\vert \alpha\beta\alpha
\beta\right\rangle ,\left\vert \alpha\beta\beta\alpha\right\rangle ,\\
\left\vert \alpha\beta\beta\beta\right\rangle ,\left\vert \beta\alpha
\alpha\alpha\right\rangle ,\left\vert \beta\alpha\alpha\beta\right\rangle
,\left\vert \beta\alpha\beta\alpha\right\rangle ,\left\vert \beta\alpha
\beta\beta\right\rangle ,\left\vert \beta\beta\alpha\alpha\right\rangle
,\left\vert \beta\beta\alpha\beta\right\rangle ,\left\vert \beta\beta
\beta\alpha\right\rangle ,\left\vert \beta\beta\beta\beta\right\rangle
\end{array}
\right) \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.
\shortparallel\right. \\
&  \left(
\begin{array}
[c]{c}%
\left\vert \alpha\alpha\alpha\alpha\right\rangle ,\left\vert \alpha
\alpha\alpha\beta\right\rangle ,\left\vert \alpha\alpha\beta\alpha
\right\rangle ,\left\vert \alpha\alpha\beta\beta\right\rangle ,\left\vert
\alpha\beta\alpha\alpha\right\rangle ,\left\vert \alpha\beta\alpha
\beta\right\rangle ,\left\vert \alpha\beta\beta\alpha\right\rangle ,\\
\left\vert \alpha\beta\beta\beta\right\rangle ,\left\vert \beta\alpha
\alpha\alpha\right\rangle ,\left\vert \beta\alpha\alpha\beta\right\rangle
,\left\vert \beta\alpha\beta\alpha\right\rangle ,\left\vert \beta\alpha
\beta\beta\right\rangle ,\left\vert \beta\beta\alpha\alpha\right\rangle
,\left\vert \beta\beta\alpha\beta\right\rangle ,\left\vert \beta\beta
\beta\alpha\right\rangle ,\left\vert \beta\beta\beta\beta\right\rangle
\end{array}
\right)  \mathbb{S}^{2}\\
&  4\text{ particle spin }\text{dim }=16\text{ }=2\times\dim\left\{
\mathcal{D}_{0}\right\}  +3\times\dim\left\{  \mathcal{D}_{1}\right\}
+1\times\dim\left\{  \mathcal{D}_{2}\right\}  ;\,S=0,1,2;\,2S+1=1,3,5.
\end{align}

\end{enumerate}
\end{example}

The spin adapted bases produce the direct sum decompositions
\begin{align}
\mathbb{C}^{2}  &  =\mathfrak{s}_{\frac{1}{2}}\\
\mathbb{C}^{2}\otimes\mathbb{C}^{2}  &  =\mathbb{C}^{4\ }=\mathfrak{s}%
_{0}\oplus\mathfrak{s}_{1}\\
\mathbb{C}^{2}\otimes\mathbb{C}^{2}\otimes\mathbb{C}^{2}  &  =\mathbb{C}%
^{8\ }=2\mathfrak{s}_{\frac{1}{2}}\oplus\mathfrak{s}_{\frac{3}{2}}\\
\mathbb{C}^{2}\otimes\mathbb{C}^{2}\otimes\mathbb{C}^{2}\otimes\mathbb{C}^{2}
&  =\mathbb{C}^{16\ }=2\mathfrak{s}_{0}\oplus3\mathfrak{s}_{1}\oplus
\mathfrak{s}_{2}%
\end{align}
and lead to block diagonal representations for the operators $S^{2}$ and
$S_{z},$which, commute with each other thus are simultaneously diagonalizable.
Observing that
\begin{equation}
\mathcal{B}\left(  \mathfrak{s}_{\frac{1}{2}}\right)  \cong\mathcal{M}\left(
2,\mathbb{C}\right)
\end{equation}
the block diagonal representations correspond to the direct sum decompositions
of the tensor products is%
\begin{equation}
\mathcal{D}_{j_{1}}\otimes\mathcal{D}_{j_{2}}=%
%TCIMACRO{\tbigoplus _{j=\left\vert j_{1}-j_{2}\right\vert }^{j=j_{1}+j_{2}}}%
%BeginExpansion
{\textstyle\bigoplus_{j=\left\vert j_{1}-j_{2}\right\vert }^{j=j_{1}+j_{2}}}
%EndExpansion
\mathcal{D}_{j}.
\end{equation}
In particular

\begin{enumerate}
\item
\begin{align}
\mathcal{B}\left(  \mathfrak{s}_{\frac{1}{2}}\right)  \otimes\mathcal{B}%
\left(  \mathfrak{s}_{\frac{1}{2}}\right)   &  \supset\mathcal{D}_{\frac{1}%
{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \otimes\mathcal{D}%
_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right) \\
&  =%
%TCIMACRO{\tbigoplus _{j=0}^{j=1}}%
%BeginExpansion
{\textstyle\bigoplus_{j=0}^{j=1}}
%EndExpansion
\mathcal{D}_{j}\left(  GL\left(  2,\mathbb{C}\right)  \right)  =\mathcal{D}%
_{0}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus\mathcal{D}%
_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)  =\mathcal{B}\left(
\mathfrak{s}_{0}\right)  \oplus\mathcal{B}\left(  \mathfrak{s}_{1}\right)
\end{align}


\item
\begin{gather}
\mathcal{B}\left(  \mathfrak{s}_{\frac{1}{2}}\right)  \otimes\mathcal{B}%
\left(  \mathfrak{s}_{\frac{1}{2}}\right)  \otimes\mathcal{B}\left(
\mathfrak{s}_{\frac{1}{2}}\right)  \supset\\
\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\otimes\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)
\right)  \otimes\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}%
\right)  \right)  =%
%TCIMACRO{\tbigoplus _{j=0}^{j=1}}%
%BeginExpansion
{\textstyle\bigoplus_{j=0}^{j=1}}
%EndExpansion
\left(  \mathcal{D}_{j}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\otimes\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)
\right)  \right) \\
=%
%TCIMACRO{\tbigoplus _{j=0}^{j=1}}%
%BeginExpansion
{\textstyle\bigoplus_{j=0}^{j=1}}
%EndExpansion
\left(
%TCIMACRO{\tbigoplus _{j^{\prime}=\left\vert j-\frac{1}{2}\right\vert
%}^{j^{\prime}=j+\frac{1}{2}}}%
%BeginExpansion
{\textstyle\bigoplus_{j^{\prime}=\left\vert j-\frac{1}{2}\right\vert
}^{j^{\prime}=j+\frac{1}{2}}}
%EndExpansion
\mathcal{D}_{j^{\prime}}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\right) \\
=\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\otimes\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)
\right)  \otimes\mathcal{D}_{\frac{3}{2}}\left(  GL\left(  2,\mathbb{C}%
\right)  \right)  =2\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}%
\right)  \right)  \oplus\mathcal{D}_{\frac{3}{2}}\left(  GL\left(
2,\mathbb{C}\right)  \right)  \subset2\mathcal{B}\left(  \mathfrak{s}%
_{\frac{1}{2}}\right)  \oplus\mathcal{B}\left(  \mathfrak{s}_{\frac{3}{2}%
}\right)
\end{gather}


\item
\begin{gather}
\mathcal{B}\left(  \mathfrak{s}_{\frac{1}{2}}\right)  \otimes\mathcal{B}%
\left(  \mathfrak{s}_{\frac{1}{2}}\right)  \otimes\mathcal{B}\left(
\mathfrak{s}_{\frac{1}{2}}\right)  \otimes\mathcal{B}\left(  \mathfrak{s}%
_{\frac{1}{2}}\right)  \supset\left(  \mathcal{D}_{\frac{1}{2}}\left(
GL\left(  2,\mathbb{C}\right)  \right)  \otimes\mathcal{D}_{\frac{1}{2}%
}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \otimes\mathcal{D}_{\frac
{3}{2}\left(  GL\left(  2,\mathbb{C}\right)  \right)  }\right)  \otimes
\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right) \\
=\mathcal{D}_{0}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{0}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{\frac{3}{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\otimes\mathcal{D}_{\frac{1}{2}}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\\
=\mathcal{D}_{0}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{0}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \oplus
\mathcal{D}_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)  \otimes
\mathcal{D}_{2}\left(  GL\left(  2,\mathbb{C}\right)  \right) \\
=2\mathcal{D}_{0}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\oplus3\mathcal{D}_{1}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\oplus\mathcal{D}_{2}\left(  GL\left(  2,\mathbb{C}\right)  \right)
\subset2\mathcal{B}\left(  \mathfrak{s}_{0}\right)  \oplus3\mathcal{B}\left(
\mathfrak{s}_{1}\right)  \oplus\mathcal{B}\left(  \mathfrak{s}_{2}\right)  ,
\end{gather}
where we have considered the complexification of the representations of
$U\left(  2\right)  $ i.e. representations that are also representations of
$GL\left(  2,\mathbb{C}\right)  .$
\end{enumerate}

The preceding decompositions are of importance as the non relativistic
molecular Hamiltonian $H$ commutes with both $S^{2}$ and $S_{z}$, showing that
the spin eigenspaces are invariant to $U\left(  2\right)  $ and $H.$

\begin{remark}
\begin{enumerate}
\item The vector space $\mathbb{C}_{\oplus}^{4}$ is generated as the
\emph{direct sum}
\begin{equation}
\mathbb{C}_{\oplus}^{4}=\mathbb{C}^{2}\oplus\mathbb{C}^{2}%
\end{equation}
and is a Hilbert space with inner product
\begin{equation}
\left\langle \left.  v_{1}\oplus v_{2}\right\vert w_{1}\otimes w_{2}%
\right\rangle _{\oplus4}=\left\langle \left.  v_{1}\right\vert w_{1}%
\right\rangle _{2}+\left\langle \left.  v_{2}\right\vert w_{2}\right\rangle
_{2}=\left(  \overline{v_{11}}w_{11}+\overline{v_{12}}w_{12}\right)  +\left(
\overline{v_{21}}w_{21}+\overline{v_{22}}w_{22}\right)
\end{equation}
and norm
\begin{equation}
\left\Vert v_{1}\oplus v_{2}\right\Vert _{\oplus4}^{2}=\left\langle \left.
v_{1}\right\vert v_{1}\right\rangle _{2}+\left\langle \left.  v_{2}\right\vert
v_{2}\right\rangle _{2}=\left\Vert v_{1}\right\Vert _{2}^{2}+\left\Vert
v_{2}\right\Vert _{2}^{2}=\left(  \overline{v_{11}}v_{11}+\overline{v_{12}%
}v_{12}\right)  +\left(  \overline{v_{21}}v_{21}+\overline{v_{22}}%
v_{22}\right)  .
\end{equation}
The space $\mathbb{C}^{4}$ is defined as $\mathbb{C}_{\oplus}^{4}.$

\item The vector space $\mathbb{C}_{\otimes}^{4}$ is generated as the
\emph{tensor product}
\begin{equation}
\mathbb{C}_{\otimes}^{4}=\mathbb{C}^{2}\otimes\mathbb{C}^{2}%
\end{equation}
and is a Hilbert space with inner product
\begin{equation}
\left\langle \left.  v_{1}\otimes v_{2}\right\vert w_{1}\otimes w_{2}%
\right\rangle _{\otimes4}=\left\langle \left.  v_{1}\right\vert w_{1}%
\right\rangle _{2}\left\langle \left.  v_{2}\right\vert w_{2}\right\rangle
_{2}=\left(  \overline{v_{11}}w_{11}+\overline{v_{12}}w_{12}\right)  \left(
\overline{v_{21}}w_{21}+\overline{v_{22}}w_{22}\right)
\end{equation}
and norm
\begin{equation}
\left\Vert v_{1}\otimes v_{2}\right\Vert _{\otimes4}^{2}=\left\langle \left.
v_{1}\right\vert v_{1}\right\rangle _{2}\left\langle \left.  v_{2}\right\vert
v_{2}\right\rangle _{2}=\left\Vert v_{1}\right\Vert _{2}^{2}\left\Vert
v_{2}\right\Vert _{2}^{2}=\left(  \overline{v_{11}}v_{11}+\overline{v_{12}%
}v_{12}\right)  \left(  \overline{v_{21}}v_{21}+\overline{v_{22}}%
v_{22}\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{example}
The spin adapted subspaces, (singlet and triplet), of $\mathbb{C}^{2}%
\otimes\mathbb{C}^{2}$ are
\begin{align}
\mathbb{C}^{2}\otimes\mathbb{C}^{2}  &  =\mathbb{C}_{\otimes}^{4\ }%
=\mathfrak{s}_{0}\oplus\mathfrak{s}_{1}\\
\mathfrak{s}_{0}  &  =\mathbb{C-}\operatorname*{linspan}\left\{  \frac
{1}{\sqrt{2}}\left(  \left\vert \alpha\beta\right\rangle +\left\vert
\beta\alpha\right\rangle \right)  \right\} \\
\mathfrak{s}_{1}  &  =\mathbb{C-}\operatorname*{linspan}\left\{  \left\vert
\alpha\alpha\right\rangle ,\frac{1}{\sqrt{2}}\left(  \left\vert \alpha
\beta\right\rangle -\left\vert \beta\alpha\right\rangle ,\left\vert \beta
\beta\right\rangle \right)  \right\}
\end{align}
with orthogonal projectors%
\begin{align}
P_{\mathfrak{s}_{0}}  &  =\frac{1}{2}\left\vert \left(  \alpha\beta
-\beta\alpha\right)  \right\rangle \left\langle \left(  \alpha\beta
-\beta\alpha\right)  \right\vert \\
P_{\mathfrak{s}_{1}}  &  =\left\vert \alpha\alpha\right\rangle \left\langle
\alpha\alpha\right\vert +\frac{1}{2}\left\vert \left(  \alpha\beta+\beta
\alpha\right)  \right\rangle \left\langle \left(  \alpha\beta+\beta
\alpha\right)  \right\vert +\left\vert \beta\beta\right\rangle \left\langle
\beta\beta\right\vert =P_{\mathfrak{s}_{1}1}+P_{\mathfrak{s}_{1}%
0}+P_{\mathfrak{s}_{1}-1}\\
P_{\mathfrak{s}_{1}1}  &  =\left\vert \alpha\alpha\right\rangle \left\langle
\alpha\alpha\right\vert \\
P_{\mathfrak{s}_{1}0}  &  =\frac{1}{2}\left\vert \left(  \alpha\beta
+\beta\alpha\right)  \right\rangle \left\langle \left(  \alpha\beta
+\beta\alpha\right)  \right\vert \\
P_{\mathfrak{s}_{1}-1}  &  =\left\vert \beta\beta\right\rangle \left\langle
\beta\beta\right\vert .
\end{align}

\end{example}

\begin{remark}
\emph{These subspaces are invariant to }$GL\left(  2,\mathbb{C}\right)
$\emph{ and hence }$U\left(  2\right)  .$
\end{remark}

The state spaces $S\left(  \mathcal{M}\left(  2^{2},\mathbb{C}\right)
\right)  $ and $S\left(  \mathcal{M}_{h}\left(  2^{2},\mathbb{C}\right)
\right)  $ contain the pure states
\begin{equation}
\left\{  \frac{1}{2}\left\vert \left(  \alpha\beta-\beta\alpha\right)
\right\rangle \left\langle \left(  \alpha\beta-\beta\alpha\right)  \right\vert
,\left\vert \alpha\alpha\right\rangle \left\langle \alpha\alpha\right\vert
,\frac{1}{2}\left\vert \left(  \alpha\beta+\beta\alpha\right)  \right\rangle
\left\langle \left(  \alpha\beta+\beta\alpha\right)  \right\vert ,\left\vert
\beta\beta\right\rangle \left\langle \beta\beta\right\vert \right\}  ,
\end{equation}
each of which produces irreducible GNS representations of $\mathcal{M}\left(
2^{2},\mathbb{C}\right)  $ and $\mathcal{M}_{h}\left(  2^{2},\mathbb{C}%
\right)  .$ The group $U\left(  2\right)  $ has the following representation
in $\mathcal{B}\left(  \mathbb{C}^{4}\right)  \equiv\mathcal{M}\left(
2^{2},\mathbb{C}\right)  $
\begin{align}
u\left(  \mathbf{\lambda}\right)   &  =\exp i\left\{  \lambda_{00}\left\vert
0,0\right\rangle \left\langle \left(  0,0\right)  \right\vert +%
%TCIMACRO{\tsum _{-1\leq j,k\leq1}}%
%BeginExpansion
{\textstyle\sum_{-1\leq j,k\leq1}}
%EndExpansion
\lambda_{jk}\left\vert 1,j\right\rangle \left\langle \left(  1,k\right)
\right\vert \right\}  ;\,\lambda_{jk}=\overline{\lambda}_{kj}\\
&  =\exp i\left\{  \eta_{00}\left\vert 0,0\right\rangle \left\langle \left(
0,0\right)  \right\vert +%
%TCIMACRO{\tsum _{-1\leq j\leq k\leq1}}%
%BeginExpansion
{\textstyle\sum_{-1\leq j\leq k\leq1}}
%EndExpansion
\eta_{jk}\left(  \left\vert 1,j\right\rangle \left\langle \left(  1,k\right)
\right\vert +\left\vert 1,k\right\rangle \left\langle \left(  1,j\right)
\right\vert \right)  \right\} \\
&  =\exp i\left\{  \eta_{00}\left\vert 0,0\right\rangle \left\langle \left(
0,0\right)  \right\vert \right\}  \exp i\left\{
%TCIMACRO{\tsum _{-1\leq j\leq k\leq1}}%
%BeginExpansion
{\textstyle\sum_{-1\leq j\leq k\leq1}}
%EndExpansion
\eta_{jk}\left(  \left\vert 1,j\right\rangle \left\langle \left(  1,k\right)
\right\vert +\left\vert 1,k\right\rangle \left\langle \left(  1,j\right)
\right\vert \right)  \right\}  ;\eta_{jk}\in\mathbb{R}\\
\eta_{00}  &  =\lambda_{00},\eta_{jk}=\operatorname{Re}\lambda_{jk};1\leq
j\leq k\leq1,
\end{align}
where%
\begin{align}
\left\vert 0,0\right\rangle  &  \equiv\frac{1}{2}\left\vert \left(
\alpha\beta-\beta\alpha\right)  \right\rangle \\
\left\vert 1,-1\right\rangle  &  \equiv\left\vert \beta\beta\right\rangle \\
\left\vert 1,0\right\rangle  &  \equiv\frac{1}{\sqrt{2}}\left\vert \alpha
\beta+\beta\alpha\right\rangle \\
\left\vert 1,1\right\rangle  &  \equiv\left\vert \alpha\alpha\right\rangle .
\end{align}


\begin{remark}%
\begin{align}
\det\left\{  u\left(  \mathbf{\lambda}\right)  \right\}   &  =\exp\left\{
i\operatorname{Tr}\left\{  i\lambda_{00}\left\vert 0,0\right\rangle
\left\langle 0,0\right\vert +%
%TCIMACRO{\tsum _{-1\leq j,k\leq1}}%
%BeginExpansion
{\textstyle\sum_{-1\leq j,k\leq1}}
%EndExpansion
\lambda_{jk}\left\vert 1,j\right\rangle \left\langle 1,k\right\vert \right\}
\right\} \\
&  =\exp\left\{  i\operatorname{Tr}\left\{  \lambda_{00}+\lambda
_{-1-1}+\lambda_{00}+\lambda_{11}\right\}  \right\}  =e^{i\theta\left(
\lambda\right)  }.
\end{align}
Hence in particular one can generate group elements with $\det\left\{
u\left(  \mathbf{\lambda}\right)  \right\}  =\pm1.$
\end{remark}

The states
\begin{equation}
P_{\mathfrak{s}_{0}}=\left\vert \left(  0,0\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \text{ and }P_{\mathfrak{s}_{1}-1}=\left(
\left\vert \left(  1,-1\right)  \right\rangle \left\langle \left(
1,-1\right)  \right\vert ,\text{ }P_{\mathfrak{s}_{1}0}=\left\vert \left(
1,0\right)  \right\rangle \left\langle \left(  1,0\right)  \right\vert ,\text{
}P_{\mathfrak{s}_{1}1}=\left\vert \left(  1,1\right)  \right\rangle
\left\langle \left(  1,1\right)  \right\vert \right)  \text{ }%
\end{equation}
are invariant to $U\left(  2\right)  $ i.e.%
\begin{align}
f_{P_{\mathfrak{s}_{0}}}\left(  B\right)   &  =\operatorname{Tr}\left\{
BP_{\mathfrak{s}_{0}}\right\}  =f_{P_{\mathfrak{s}_{0}}}\left(  uBu^{\dagger
}\right)  =\operatorname{Tr}\left\{  uBu^{\dagger}P_{\mathfrak{s}_{0}%
}\right\}  \forall B\in\mathcal{M}\left(  2^{2},\mathbb{C}\right) \\
f_{P_{\mathfrak{s}_{1}}}\left(  B\right)   &  =\operatorname{Tr}\left\{
BP_{\mathfrak{s}_{1}}\right\}  =f_{P_{\mathfrak{s}_{0}}}\left(  uBu^{\dagger
}\right)  =\operatorname{Tr}\left\{  uBu^{\dagger}P_{\mathfrak{s}_{1}%
}\right\}  \forall B\in\mathcal{M}\left(  2^{2},\mathbb{C}\right)
\end{align}
as
\begin{equation}
\left[  P_{\mathfrak{s}_{0}},u\left(  \mathbf{\lambda}\right)  \right]
=\left[  P_{\mathfrak{s}_{1}-1},u\left(  \mathbf{\lambda}\right)  \right]
=\left[  P_{\mathfrak{s}_{1}0},u\left(  \mathbf{\lambda}\right)  \right]
=\left[  P_{\mathfrak{s}_{1}1},u\left(  \mathbf{\lambda}\right)  \right]  =0.
\end{equation}


We first consider the GNS representation, $\Phi_{D},$ produced by the $\sin
$glet state
\begin{equation}
D=P_{\mathfrak{s}_{0}}=\frac{1}{2}\left\vert \left(  \alpha\beta-\beta
\alpha\right)  \right\rangle \left\langle \left(  \alpha\beta-\beta
\alpha\right)  \right\vert =\left\vert 0,0\right\rangle \left\langle \left(
0,0\right)  \right\vert
\end{equation}
on $\mathcal{M}\left(  2^{2},\mathbb{C}\right)  ,$ where in this case
\begin{equation}
\Phi_{D}:\mathcal{M}\left(  2^{2},\mathbb{C}\right)  \rightarrow\mathbb{C}%
^{4}\cong\mathcal{M}\left(  2,\mathbb{C}\right)  ,
\end{equation}
so that
\begin{equation}
\mathcal{M}\left(  2^{2},\mathbb{C}\right)  =\ker\left\{  \Phi_{D}\right\}
\oplus\ker\left\{  \Phi_{D}\right\}  ^{\bot}\cong\ker\left\{  \Phi
_{D}\right\}  \oplus\mathcal{M}\left(  2,\mathbb{C}\right)  \cong\ker\left\{
\Phi_{D}\right\}  \oplus\mathbb{C}^{4}.
\end{equation}


The range and kernel of $\Phi_{D}$ are given by the triplet states
\begin{align}
\ker\left\{  \Phi_{D}\right\}   &  =\mathbb{C}-\operatorname*{linspan}\left\{
\left\vert \left(  1,1\right)  \right\rangle \left\langle \left(  1,1\right)
\right\vert ,\left\vert \left(  1,0\right)  \right\rangle \left\langle \left(
1,0\right)  \right\vert ,\left\vert \left(  1,-1\right)  \right\rangle
\left\langle \left(  1,-1\right)  \right\vert ,\right. \\
&  \left\vert \left(  0,0\right)  \right\rangle \left\langle \left(
1,0\right)  \right\vert ,\left\vert \left(  0,0\right)  \right\rangle
\left\langle \left(  1,1\right)  \right\vert ,\left\vert \left(  0,0\right)
\right\rangle \left\langle \left(  1,-1\right)  \right\vert ,\\
&  \left.  \left\vert \left(  1,-1\right)  \right\rangle \left\langle \left(
1,1\right)  \right\vert ,\left\vert \left(  1,1\right)  \right\rangle
\left\langle \left(  1,-1\right)  \right\vert ,\left\vert \left(  1,-1\right)
\right\rangle \left\langle \left(  1,0\right)  \right\vert ,\left\vert \left(
1,0\right)  \right\rangle \left\langle \left(  1,-1\right)  \right\vert
,\left\vert \left(  1,-1\right)  \right\rangle \left\langle \left(
1,1\right)  \right\vert ,\left\vert \left(  1,1\right)  \right\rangle
\left\langle \left(  1,-1\right)  \right\vert \right\}  ,\\
\ker\left\{  \Phi_{D}\right\}  ^{\bot}  &  =\mathbb{C}-\operatorname*{linspan}%
\left\{  \left\vert \left(  0,0\right)  \right\rangle \left\langle \left(
0,0\right)  \right\vert ,\left\vert \left(  1,0\right)  \right\rangle
\left\langle \left(  0,0\right)  \right\vert ,\left\vert \left(  1,1\right)
\right\rangle \left\langle \left(  0,0\right)  \right\vert ,\left\vert \left(
1,-1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right\} \\
&  \cong\operatorname*{Range}\left\{  \Phi_{D}\right\}  \cong\mathbb{C}^{4}.
\end{align}
i.e.%
\begin{align}
\Phi_{D}\left(  \left\vert \left(  0,0\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)   &  \equiv\left\vert \left(
0,0\right)  \right\rangle \\
\Phi_{D}\left(  \left\vert \left(  1,-1\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)   &  \equiv\left\vert \left(
1,-1\right)  \right\rangle \\
\Phi_{D}\left(  \left\vert \left(  1,0\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)   &  \equiv\left\vert \left(
1,0\right)  \right\rangle \\
\Phi_{D}\left(  \left\vert \left(  1,1\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)   &  \equiv\left\vert \left(
1,1\right)  \right\rangle .
\end{align}
The representation $\Pi_{D}$ is given by

\begin{enumerate}
\item[a]
\begin{align}
&  \Pi_{D}\left(  \left\vert \left(  0,0\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
0,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =\Phi_{D}\left(  \left\vert \left(  0,0\right)  \right\rangle
\left\langle \left(  0,0\right)  \right\vert \right)  \equiv\left\vert \left(
0,0\right)  \right\rangle \\
&  \Pi_{D}\left\vert \left(  0,0\right)  \right\rangle \left\langle \left(
0,0\right)  \right\vert \Phi_{D}\left(  \left\vert \left(  1,0\right)
\right\rangle \left\langle \left(  0,0\right)  \right\vert \right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  0,0\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  0,0\right)  \right\rangle \left\langle
\left(  0,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,-1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0
\end{align}


\item[b]
\begin{align}
&  \Pi_{D}\left(  \left\vert \left(  1,0\right)  \right\rangle \left\langle
\left(  1,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
0,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,0\right)  \right\rangle \left\langle
\left(  1,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =\Phi_{D}\left(  \left\vert \left(  1,0\right)  \right\rangle
\left\langle \left(  0,0\right)  \right\vert \right)  \equiv\left\vert \left(
1,0\right)  \right\rangle \\
&  \Pi_{D}\left(  \left\vert \left(  1,0\right)  \right\rangle \left\langle
\left(  1,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,0\right)  \right\rangle \left\langle
\left(  1,0\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,-1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0
\end{align}


\item[c]
\begin{align}
&  \Pi_{D}\left(  \left\vert \left(  1,1\right)  \right\rangle \left\langle
\left(  1,1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
0,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,1\right)  \right\rangle \left\langle
\left(  1,1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,1\right)  \right\rangle \left\langle
\left(  1,1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =\Phi_{D}\left(  \left\vert \left(  1,1\right)  \right\rangle
\left\langle \left(  0,0\right)  \right\vert \right)  \equiv\left\vert \left(
1,1\right)  \right\rangle \\
&  \Pi_{D}\left(  \left\vert \left(  1,1\right)  \right\rangle \left\langle
\left(  1,1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,-1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0
\end{align}


\item[d]
\begin{align}
&  \Pi_{D}\left(  \left\vert \left(  1,-1\right)  \right\rangle \left\langle
\left(  1,-1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
0,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,-1\right)  \right\rangle \left\langle
\left(  1,-1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,0\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,-1\right)  \right\rangle \left\langle
\left(  1,-1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =0\\
&  \Pi_{D}\left(  \left\vert \left(  1,-1\right)  \right\rangle \left\langle
\left(  1,-1\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
1,-1\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =\Phi_{D}\left(  \left\vert \left(  1,-1\right)  \right\rangle
\left\langle \left(  0,0\right)  \right\vert \right)  \equiv\left\vert \left(
1,-1\right)  \right\rangle .
\end{align}

\end{enumerate}

In general
\begin{gather}
\Pi_{D}\left(  \left\vert \left(  j,k\right)  \right\rangle \left\langle
\left(  l,m\right)  \right\vert \right)  \Phi_{D}\left(  \left\vert \left(
p,q\right)  \right\rangle \left\langle \left(  0,0\right)  \right\vert
\right)  =\delta_{lp}\delta_{mq}\Phi_{D}\left(  \left\vert \left(  p,q\right)
\right\rangle \left\langle \left(  0,0\right)  \right\vert \right)  ;\\
0\leq j\leq1,-1\leq k\leq1:0\leq l\leq1,-1\leq m\leq1;0\leq p\leq1,-1\leq
q\leq1,
\end{gather}
so
\begin{equation}
\Pi_{D}\left(  u\left(  \mathbf{\lambda}\right)  \right)  =\Pi_{D}\left(  \exp
i\left\{  \lambda_{00}\left\vert 0,0\right\rangle \left\langle \left(
0,0\right)  \right\vert \right\}  \right)  \Pi_{D}\left(  \exp i\left\{
%TCIMACRO{\tsum _{-1\leq j\leq k\leq1}}%
%BeginExpansion
{\textstyle\sum_{-1\leq j\leq k\leq1}}
%EndExpansion
\lambda_{jk}\left(  \left\vert 1,j\right\rangle \left\langle \left(
1,k\right)  \right\vert +\left\vert 1,k\right\rangle \left\langle \left(
1,j\right)  \right\vert \right)  \right\}  \right)  ;\lambda_{jk}\in
\mathbb{R},
\end{equation}
maps%
\begin{align}
\Pi_{D}\left(  \exp i\left\{  \lambda_{00}\left\vert 0,0\right\rangle
\left\langle \left(  0,0\right)  \right\vert \right\}  \right)   &
:\mathfrak{s}_{0}\rightarrow\mathfrak{s}_{0}\\
\Pi_{D}\left(  \exp i\left\{
%TCIMACRO{\tsum _{-1\leq j\leq k\leq1}}%
%BeginExpansion
{\textstyle\sum_{-1\leq j\leq k\leq1}}
%EndExpansion
\lambda_{jk}\left(  \left\vert 1,j\right\rangle \left\langle \left(
1,k\right)  \right\vert +\left\vert 1,k\right\rangle \left\langle \left(
1,j\right)  \right\vert \right)  \right\}  \right)   &  :\mathfrak{s}%
_{1}\rightarrow\mathfrak{s}_{1}%
\end{align}
and preserves the direct sum%
\begin{equation}
\mathfrak{s}_{0}\oplus\mathfrak{s}_{1}\rightarrow\mathfrak{s}_{0}%
\oplus\mathfrak{s}_{1}.
\end{equation}
The adjoint representation of $U\left(  2\right)  $ on $\mathcal{M}\left(
2^{2},\mathbb{C}\right)  $ has the properties
\begin{equation}
\Pi_{D}\left(  \widehat{u}\left(  A\right)  \right)  \Phi_{D}\left(  X\right)
=\Pi_{D}\left(  uAu^{\dagger}\right)  \Phi_{D}\left(  X\right)  =\Pi
_{D}\left(  u\right)  \Pi_{D}\left(  A\right)  \Pi_{D}\left(  u\right)
^{\dagger}\Phi_{D}\left(  X\right)  =\Phi_{D}\left(  uAu^{\dagger}X\right)  .
\end{equation}
The representation of $U\left(  2\right)  $ splits into one and three
dimensional ones over $\mathcal{M}\left(  2^{2},\mathbb{C}\right)  .$ The
corresponding real Lie algebra correspondingly split into the direct sum of
the algebras $\mathcal{B}\left(  \mathfrak{s}_{0}\right)  \oplus_{\mathbb{R}%
}\mathcal{B}\left(  \mathfrak{s}_{1}\right)  .$

\subsubsection{Decomposition of Tensor Product into Symmetry Classes of
Tensors.}

\begin{remark}
The $r$-fold tensor product of the Hilbert space $\mathbb{C}^{2}$
\begin{equation}
\mathbb{C}^{2r\otimes}=%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}%
\end{equation}
has a norm given by
\begin{equation}
\left\Vert v_{1}\otimes\cdots\otimes v_{r}\right\Vert _{\mathbb{C}^{2r\otimes
}}=\left\Vert v_{1}\right\Vert _{\mathbb{C}^{2}}\cdots\left\Vert
v_{r}\right\Vert _{\mathbb{C}^{2}}.
\end{equation}
The direct $r$-fold sum of $\mathbb{C}^{2}$%
\begin{equation}
\mathbb{C}^{2r\oplus}=\mathbb{C}^{2r}=%
%TCIMACRO{\tbigoplus \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigoplus\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}%
\end{equation}
has a norm given by%
\begin{equation}
\left\Vert v_{1}\oplus\cdots\oplus v_{r}\right\Vert _{\mathbb{C}^{2r\oplus}%
}=\left\Vert v_{1}\right\Vert _{\mathbb{C}^{2}}+\cdots+\left\Vert
v_{r}\right\Vert _{\mathbb{C}^{2}};\,v_{j}\in\mathbb{C}^{2},1\leq j\leq r.
\end{equation}
The spaces $\mathbb{C}^{2r\otimes}$ and $\mathbb{C}^{2r\oplus}$ are both
generated by the space of sequences $\left(  v_{1},\cdots,v_{r}\right)
\in\,\overset{r}{\overbrace{\mathbb{C\times\cdots\times C}}}$ \emph{but have
different norms so the closures are in general different.}
\end{remark}

\begin{remark}
The Hilbert space with norm $\left\Vert {}\right\Vert _{\mathbb{C}^{2r\oplus}%
}$
\begin{equation}
\mathbb{C}^{\infty\otimes}=\lim\limits_{r\rightarrow\infty}\left\{
%TCIMACRO{\tbigoplus \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigoplus\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right\}
\end{equation}
is seperable, however the Hilbert space with norm $\left\Vert {}\right\Vert
_{\mathbb{C}^{2r\otimes}}$
\begin{equation}
\mathbb{C}^{\infty\oplus}=\lim\limits_{r\rightarrow\infty}\left\{
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right\}
\end{equation}
\emph{is not seperable}.
\end{remark}

\begin{remark}
The algebraic $r$-fold tensor product of linear operators acting in the space
$\mathbb{C}^{2}$
\begin{equation}%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathcal{L}\left(  \mathbb{C}^{2}\right)  =\mathcal{L}\left(  \mathbb{C}%
^{2r}\right)  ,\,r<\infty
\end{equation}
act in both $\mathbb{C}^{2r\otimes}$ and $\mathbb{C}^{2r\oplus}.$The space of
bounded operators, $\mathcal{B}\left(  \mathbb{C}^{\infty\otimes}\right)  ,$
acting in $\mathbb{C}^{\infty\otimes}$ is different to the space of bounded
operators, $\mathcal{B}\left(  \mathbb{C}^{\infty\oplus}\right)  ,$ acting in
$\mathbb{C}^{\infty\oplus}$ \emph{as the norms are different}.
\end{remark}

\begin{remark}
In the infinite dimensional case one can generalize to more general
Topological Vector Spaces by considering various topologies on the direct
products
\begin{equation}
{\Large X}^{r}\left(  \mathbb{C}^{2}\right)  =\mathbb{C}^{2r\times
}=\,\overset{r}{\overbrace{\mathbb{C}^{2}\times\cdots\times\mathbb{C}^{2}}}.
\end{equation}
The spaces of linear operators $\mathcal{L}\left(  \mathbb{C}^{2r}\right)  $
acting in $\mathbb{C}^{2r}$ inherit topological properties from the topologies
of $\mathbb{C}^{2r\times}.$
\end{remark}

Tensor product vector spaces can be decomposed into direct sums of vector
subspaces of symmetry classes of tensors
\begin{equation}
\mathbb{C}^{2r\otimes}=%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}=%
%TCIMACRO{\tbigoplus \limits_{\kappa}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{\kappa}}
%EndExpansion
\left(
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right)  _{\kappa};\,\kappa\in\text{symmetry classes of }%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\equiv\text{cycle structure of }S_{r}.
\end{equation}


\begin{remark}
Cycles $\,\kappa$ are of the form%
\[
\,\kappa=\left[  1^{\,\kappa_{1}},2^{\kappa_{2}},\cdots,\left(  r-1\right)
^{\kappa_{r-1}},r^{\kappa_{r}}\right]  \equiv\left(  \kappa_{1},\cdots
,\kappa_{r}\right)  ;\,\kappa_{1}+\cdots+\kappa_{r}=r.
\]

\end{remark}

\begin{example}
$r=4$%
\begin{equation}
\left(  4,0,0,0\right)  ,\left(  3,1,0,0\right)  ,\left(  2,2,0,0\right)
,\left(  2,1,1,0\right)  ,\left(  1,1,1,1\right)  .
\end{equation}

\end{example}

The subspaces $\left\{  \left.  \left(
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right)  _{\kappa}\right\vert 0\leq\kappa\leq r\right\}  $ are
invariant eigen spaces of the spin Casimer operator $S^{2}$ associated with
the eigenvalue $2S+1$ and the tensors in those subspaces correspond to pure
spin tensors that form by linear combination invariant subspaces of $GL\left(
2,\mathbb{C}\right)  $, hence producing \emph{irreducible representations} of
$GL\left(  2,\mathbb{C}\right)  .$ The basis vectors of $\left(
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right)  _{\kappa}$ can be choosen to be eigenvectors of
$S_{z}\equiv S_{3}$ associated with the eigenvalues $-r,-\left(  r-1\right)
,\cdots,\left(  r-1\right)  ,r.$

\begin{example}
$r=2$%
\begin{equation}
\mathbb{C}^{4\otimes}=%
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\mathbb{C}^{2}=\mathbb{C}^{2}\otimes\mathbb{C}^{2}=\left(
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\mathbb{C}^{2}\right)  _{\left[  1^{2}\right]  }\oplus\left(
%TCIMACRO{\tbigotimes \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{2}}
%EndExpansion
\mathbb{C}^{2}\right)  _{\left[  2^{1}\right]  }=\left(  \mathbb{C}^{2}%
\otimes\mathbb{C}^{2}\right)  _{0}\oplus\left(  \mathbb{C}^{2}\otimes
\mathbb{C}^{2}\right)  _{1}.
\end{equation}

\end{example}

\begin{example}
$r=2,$

\begin{enumerate}
\item Singlet tensors%
\begin{equation}
S=0;\,S_{3}=0;\,2S+1=1,
\end{equation}


\item Triplet tensors%
\begin{equation}
S=1;\,S_{3}=-1,0,1;\,2S+1=3\,.
\end{equation}

\end{enumerate}
\end{example}

\begin{example}
$r=1$

\begin{enumerate}
\item Doublet tensors%
\begin{equation}
S=\frac{1}{2};\,S_{3}=-\frac{1}{2},\frac{1}{2};\,2S+1=2.
\end{equation}

\end{enumerate}
\end{example}

\begin{remark}
One can construct orthogonal projections $P_{\kappa}$ onto the symmetry
classes%
\begin{equation}
P_{\kappa}:%
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\rightarrow\left(
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right)  _{\kappa},
\end{equation}
which are linear combinations of representations of permutation operators
$\sigma\in S_{r}.$
\end{remark}

\begin{remark}
The bounded operators $\mathcal{B}\left(
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right)  $ do not in general conserve symmetry class, though
they can be expressed in terms of Ket-Bra's formed from spin adapted tensors.
\end{remark}

\begin{remark}
The space $\mathcal{B}\left(
%TCIMACRO{\tbigotimes \nolimits^{r}}%
%BeginExpansion
{\textstyle\bigotimes\nolimits^{r}}
%EndExpansion
\mathbb{C}^{2}\right)  $ can be expanded as a direct sum of subspaces
invariant to $GL\left(  2r,\mathbb{C}\right)  .$
\end{remark}

\subsection{Majorano Spinors}

A Clifford basis in terms of \emph{Majorano Spinors }is given by
\begin{align}
x_{k}  &  =\frac{1}{\sqrt{2}}\left(  a_{k}^{\dagger}+a_{k}\right) \nonumber\\
&  =\frac{1}{\sqrt{2}}\left(  \overset{k-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}%
\otimes\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes
\mathbb{I}_{2}}}+\,\overset{k-1}{\,\overbrace{\,\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes
\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\right) \nonumber\\
&  =\frac{1}{\sqrt{2}}\left(  \overset{k-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\otimes\left(  a^{\dagger
}+a\right)  \otimes\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes
\cdots\otimes\mathbb{I}_{2}}}\right) \nonumber\\
&  =\frac{1}{\sqrt{2}}\left(  \overset{k-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right) \nonumber\\
x_{k+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)  =\frac
{i}{\sqrt{2}}\left(  \overset{k-1}{\,\overbrace{\,\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(  a^{\dagger}-a\right)
\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\right) \nonumber\\
&  =\frac{i}{\sqrt{2}}\left(  \overset{k-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & -1\\
1 & 0
\end{array}
\right)  \otimes\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  ,
\end{align}
Example $r=1$%
\begin{gather}
x_{1}=\frac{1}{\sqrt{2}}\left(  \overset{1-1}{\,\overbrace{\,\mathbb{\sigma
}_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{1-1}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{1}{\sqrt{2}}\left(  a^{\dagger
}+\,a\right)  =\frac{1}{\sqrt{2}}\mathbb{\sigma}_{1}\\
x_{2}=\frac{i}{\sqrt{2}}\left(  \overset{1-1}{\overbrace{\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(  a^{\dagger
}-a\right)  \otimes\overset{1-1}{\overbrace{\,\mathbb{I}_{2}\otimes
\cdots\otimes\mathbb{I}_{2}}}\right)  =\frac{i}{\sqrt{2}}\left(  a^{\dagger
}-a\right)  \ =\frac{1}{\sqrt{2}}\mathbb{\sigma}_{2}\\
x_{1}x_{2}=\frac{1}{\sqrt{2}}\mathbb{\sigma}_{1}\frac{1}{\sqrt{2}%
}\mathbb{\sigma}_{2}=\frac{1}{2}\mathbb{\sigma}_{1}\mathbb{\sigma}_{2}%
=\frac{1}{2}i\mathbb{\sigma}_{3}\\
\frac{1}{2}i\mathbb{\sigma}_{3}\frac{1}{2}\mathbb{\sigma}_{1}\mathbb{\sigma
}_{2}=\frac{1}{4}i\mathbb{\sigma}_{3}\mathbb{\sigma}_{1}\mathbb{\sigma}%
_{2}=\frac{1}{4}i\mathbb{\sigma}_{1}\mathbb{\sigma}_{2}\mathbb{\sigma}%
_{3}=x_{1}x_{2}x_{1}x_{2}=-\frac{1}{4}\mathbb{I}_{2}\\
\Downarrow\\
\mathbb{\sigma}_{1}\mathbb{\sigma}_{2}\mathbb{\sigma}_{3}=i\mathbb{I}_{2}.
\end{gather}


One can define normalized generators as
\begin{equation}
\widehat{x}_{j}=\sqrt{2}x_{j}%
\end{equation}
that are involutions i.e.
\begin{equation}
\left(  \widehat{x}_{j}\right)  ^{2}=\frac{2}{2}\mathbb{\sigma}_{j}%
^{2}=\mathbb{I}_{2};\,1\leq j\leq2
\end{equation}
and observe
\begin{equation}
\left(  \widehat{x}_{12}\right)  ^{2}=\left(  \widehat{x}_{1}\widehat{x}%
_{2}\right)  ^{2}=-\mathbb{I}_{2}.
\end{equation}
The product $\widehat{x}_{12}$ anti commutes with the vectors $\widehat{x}%
_{1}$ and $\widehat{x}_{2}$ i.e.
\begin{equation}
\left\{  \widehat{x}_{12},\widehat{x}_{1}\right\}  =\left\{  \widehat{x}%
_{12},\widehat{x}_{2}\right\}  =0.
\end{equation}


\paragraph{Complex Numbers and the Euclidean Plane}

The Euclidean plane real Clifford algebra can be represented as
\begin{equation}
\operatorname*{Cl}\left(  2,0,\mathbb{R}\right)  =\mathbb{R\oplus R}%
^{2}\mathbb{\oplus}%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathbb{R}%
\end{equation}
showing that the complex numbers can be represented by the even sub algebra%
\begin{equation}
\mathbb{C\cong R\oplus}%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathbb{R}%
\end{equation}
i.e.
\begin{equation}
z=a+b\widehat{x}_{12}.
\end{equation}


Example $r=2$%
\begin{align}
x_{1}  &  =\frac{1}{\sqrt{2}}\left(
\overset{1-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{2-1}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{1}{\sqrt{2}}\left(  a^{\dagger}%
\otimes\,\mathbb{I}_{2}+a\otimes\,\mathbb{I}_{2}\right) \nonumber\\
x_{2}  &  =\frac{1}{\sqrt{2}}\left(
\overset{2-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{2-2}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{1}{\sqrt{2}}\left(  \mathbb{\sigma}%
_{z}\otimes a^{\dagger}+\,\mathbb{\sigma}_{z}\otimes a\right) \nonumber\\
x_{3}  &  =\frac{1}{\sqrt{2}}\left(
\overset{1-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & -i\\
1 & 0
\end{array}
\right)  \otimes\overset{2-1}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{i}{\sqrt{2}}\left(  a^{\dagger}%
\otimes\mathbb{I}_{2}-a\otimes\mathbb{I}_{2}\right) \nonumber\\
x_{4}  &  =\frac{i}{\sqrt{2}}\left(
\overset{2-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & -i\\
1 & 0
\end{array}
\right)  \otimes\overset{2-2}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{i}{\sqrt{2}}\left(  \mathbb{\sigma}%
_{z}\otimes a^{\dagger}-\mathbb{\sigma}_{z}\otimes a\right)  .
\end{align}


\subsubsection{Examples of Clifford Algebras}

If the underlying complex vector space, $V,$ is even dimensional
$=2r,r\in\mathbb{N}$ then
\begin{equation}
\operatorname*{Cl}\left(  2r,\mathbb{C}\right)  \simeq\mathcal{M}\left(
2r,\mathbb{C}\right)  ,
\end{equation}
while if it is odd dimensional $=2r-1,r\in\mathbb{N}$%
\begin{equation}
\operatorname*{Cl}\left(  2r-1,\mathbb{C}\right)  \simeq\mathcal{M}\left(
2r-1,\mathbb{C}\right)  \oplus\mathcal{M}\left(  2r-1,\mathbb{C}\right)  .
\end{equation}


\paragraph{r=0}%

\begin{equation}
\operatorname*{Cl}\left(  0,\mathbb{C}\right)  \simeq\mathbb{C}%
\end{equation}


\paragraph{r=1 even}

This is the complex algebra generated by the Pauli matrices themselves and is
isomorphic to the bi quaternions i.e.%
\begin{align}
\operatorname*{Cl}\left(  2,\mathbb{C}\right)   &  \simeq\mathcal{M}\left(
2,\mathbb{C}\right)  =%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\mathbb{C}^{2}=%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \mathbb{C}\oplus\mathbb{C}\right)  =%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \mathbb{C}\right)  \otimes%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \mathbb{C}\right)  =\left(  \mathbb{C}\oplus\mathbb{C}\right)
\otimes\left(  \mathbb{C}\oplus\mathbb{C}\right)  =\mathbb{C}^{2}%
\otimes\mathbb{C}^{2}\\
\mathcal{M}\left(  2,\mathbb{C}\right)   &  :\mathbb{C}^{2}\rightarrow
\mathbb{C}^{2}%
\end{align}


e.g.
\begin{align}
a_{1}  &  =\,\overset{1-1}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots
\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes
\overset{1-1}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=a=\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right) \\
a_{1}^{\dagger}  &  =\,\overset{1-1}{\overbrace{\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}\otimes
\overset{1-1}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=a^{\dagger}=\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  .
\end{align}
$\lceil$ The CAR is confirmed by%
\begin{align}
\left\{  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \right\}   &  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 0
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
0 & 0\\
0 & 1
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  .
\end{align}
$\rfloor$

\paragraph{r=1 odd}

gives the bicomplex numbers%
\begin{equation}
\operatorname*{Cl}\left(  1,\mathbb{C}\right)  \simeq\mathcal{M}\left(
2^{0},\mathbb{C}\right)  \oplus\mathcal{M}\left(  2^{0},\mathbb{C}\right)
\simeq\mathbb{C}\oplus\mathbb{C=}%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\mathbb{C}.
\end{equation}


\paragraph{r=2 even}%

\begin{align}
\operatorname*{Cl}\left(  4,\mathbb{C}\right)   &  \simeq\mathcal{M}\left(
4,\mathbb{C}\right) \\
\mathcal{M}\left(  4,\mathbb{C}\right)   &  :\mathbb{C}^{4}\rightarrow
\mathbb{C}^{4}%
\end{align}


The fermion creators and annihilators are given by%
\begin{equation}
a_{k}=%
%TCIMACRO{\dbigotimes \limits_{1\leq j\leq k-1}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{1\leq j\leq k-1}}
%EndExpansion
\mathbb{\sigma}_{z}\otimes a\otimes%
%TCIMACRO{\dbigotimes \limits_{k+1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{k+1\leq j\leq r}}
%EndExpansion
\mathbb{I}_{2}=\,\overset{k-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes
\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\overset{k}{a}\otimes
\overset{r-k}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
},1\leq k\leq r,\nonumber
\end{equation}
which gives explicitly in the $r=2$ case
\begin{align}
a_{1}  &  =\,\overset{1-1}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots
\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes
\overset{2-1}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=a\otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
a_{1}^{\dagger}  &  =\,\overset{1-1}{\overbrace{\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}\otimes
\overset{2-1}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=a^{\dagger}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)
\end{align}
and%
\begin{align}
a_{2}  &  =\,\overset{2-1}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots
\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes
\overset{2-2}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes a=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right) \\
a_{2}^{\dagger}  &  =\,\overset{2-1}{\overbrace{\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}\otimes
\overset{2-2}{\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\,=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes a^{\dagger}=\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  .
\end{align}
The anti commutator of $a_{1}^{\dagger}$ and $a_{2}^{\dagger}$ gives
\begin{align}
\left\{  a_{1}^{\dagger},a_{2}^{\dagger}\right\}   &  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right) \\
&  +\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
0 & 0\\
-1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
0\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  & 0\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right) \\
1\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  & 0\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
0\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  & 0\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right) \\
-1\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  & 0\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)
\end{array}
\right)  =\mathbb{O}_{4}.
\end{align}
The action of the fermion creation and annihilation operators on the vacuum
vector (lowest weight vector) is given by
\begin{align}
a_{1}\left\vert e_{1}\otimes e_{1}\right\rangle  &  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  =\mathbf{0}_{4}=\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)
\end{align}%
\begin{align}
a_{1}^{\dagger}\left\vert e_{1}\otimes e_{1}\right\rangle  &  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  =\left\vert e_{2}\otimes e_{1}\right\rangle ,
\end{align}%
\begin{align}
a_{2}\left\vert e_{1}\otimes e_{1}\right\rangle  &  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  =\mathbf{0}_{4}=\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)
\end{align}%
\begin{align}
a_{2}^{\dagger}\left\vert e_{1}\otimes e_{1}\right\rangle  &  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  =\left\vert e_{1}\otimes e_{2}\right\rangle .
\end{align}
The dimensions of the associated Fock space is
\begin{equation}
\dim\left\{  \mathcal{H}_{\mathcal{F}}\right\}  =4=1+2+1=2^{2}=2^{r}%
\end{equation}
and Fock algebra is
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =16=\left(  2^{2}\right)  ^{2}=\left(
2^{r}\right)  ^{2}=2^{4}=2^{2r},
\end{equation}
as the number of degrees of freedom $\dim\left\{  \mathcal{H}^{1}\right\}
=r=2.$The dimension of the Clifford algebra is $16$ and thus represented by
matrices of order $2^{2}=4.$

\paragraph{r=2 odd
\begin{equation}
\operatorname*{Cl}\left(  3,\mathbb{C}\right)  \simeq\mathcal{M}\left(
2,\mathbb{C}\right)  \oplus\mathcal{M}\left(  2,\mathbb{C}\right)  .
\end{equation}
}

The identity element of $\mathcal{M}\left(  2^{r},\mathbb{C}\right)  $ is given%

\begin{equation}
\mathbb{I}_{2r}=\overset{r}{\,\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}.
\end{equation}
Clifford multiplication in $\mathcal{M}\left(  2^{2r},\mathbb{C}\right)  $ is
generated by normal matrix multiplication of tensor products i.e.
\begin{equation}
\left(
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq r}}
%EndExpansion
A_{j}\right)  \left(
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq r}}
%EndExpansion
B_{j}\right)  =\left(
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq r}}
%EndExpansion
A_{j}B_{j}\right)
\end{equation}
where $A_{j},B_{j}\in\mathcal{M}\left(  2,\mathbb{C}\right)  ,\,1\leq j\leq r$
and the action on the tensor product vector space is given by
\begin{equation}
\left(
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq r}}
%EndExpansion
A_{j}\right)  \left(
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq r}}
%EndExpansion
h_{j}\right)  =\left(
%TCIMACRO{\tbigotimes \limits_{1\leq j\leq r}}%
%BeginExpansion
{\textstyle\bigotimes\limits_{1\leq j\leq r}}
%EndExpansion
A_{j}h_{j}\right)  ,
\end{equation}
where $h_{j}\in\otimes^{r}\mathbb{C}^{2}.$ This multiplication and operator
action is extended to all of $\mathcal{M}\left(  2^{r},\mathbb{C}\right)  $
and $\otimes^{r}\mathbb{C}^{2}$ by linearity.

Projectors in $\mathcal{M}\left(  2^{r},\mathbb{C}\right)  \equiv\otimes
^{r}\mathcal{M}\left(  2,\mathbb{C}\right)  $ include
\begin{equation}
\mathcal{P}_{k}=\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}\otimes
P_{k}\otimes\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2},
\end{equation}
where
\begin{equation}
P_{k}=P_{k}^{2}=P_{k}^{\dagger};\,1\leq k\leq r.
\end{equation}


\subsubsection{Majorano\emph{ }Representations}

A basis for the Clifford Algebra, $\operatorname*{Cl}\left(  2r,\mathbb{C}%
\right)  \cong\mathcal{\operatorname*{CAR}}\left(  2r\right)  ,$ algebra is
given a basis of majorana spinors
\begin{equation}
I_{\mathcal{F}},x_{j_{1}},x_{j_{1}}x_{j_{2}},\cdots,x_{j_{1}}\cdots x_{j_{2r}%
};1\leq j_{1}<\cdots<j_{2r}\leq2r,
\end{equation}
which have the preceeding representations in $\mathcal{M}\left(
2^{r},\mathbb{C}\right)  $ i.e.
\begin{equation}
x_{j_{1}}\in\operatorname*{Cl}\left(  2r,\mathbb{C}\right)  =JW\left(
x_{j_{1}}\right)  \in\mathcal{M}\left(  2^{2r},\mathbb{C}\right)  .
\end{equation}
The number of basis elements and thus dimension of $\mathcal{F}$ is
\begin{equation}
2^{2r}=\sum_{0\leq j\leq2r}\binom{2r}{j}.
\end{equation}
The graded expansion of $\operatorname*{Cl}\left(  2r,\mathbb{C}\right)  $
\begin{equation}
\operatorname*{Cl}\left(  2r,\mathbb{C}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq j\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq j\leq2r}}
%EndExpansion
\mathcal{F}_{n}%
\end{equation}
is inherited by $\mathcal{M}\left(  2^{r},\mathbb{C}\right)  $ i.e.
\begin{equation}
\mathcal{M}\left(  2^{2r},\mathbb{C}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq j\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq j\leq2r}}
%EndExpansion
JW\left(  \mathcal{F}_{j}\right)  ,
\end{equation}
showing that one can expand any element $\mathbb{A\in}\mathcal{M}\left(
2^{2r},\mathbb{C}\right)  $ as%
\begin{equation}
\mathbb{A}=a_{0}\mathbb{I}_{2^{r}}+\sum_{1\leq p\leq2r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}a_{j_{1}\cdots j_{p}}JW\left(  x_{j_{1}}\cdots
x_{j_{p}}\right)  ;\,a_{0},\,a_{j_{1}\cdots j_{p}}\in\mathbb{C}^{2^{2r}},1\leq
j_{1}<\cdots<j_{p}\leq2r,1\leq p\leq2r.
\end{equation}
\emph{It should be noted! that elements of }$\left\{  \left.  JW\left(
\mathcal{F}_{p}\right)  \right\vert 0\leq p\leq2r\right\}  $ \emph{are all
}\underline{$r$\emph{-fold}}\emph{ tensor products of elements of}
$\mathcal{M}\left(  2,\mathbb{C}\right)  .$

For $r=0$ the basis of $\mathcal{F}$ is%
\begin{equation}
\left\{  I_{\mathcal{F}}\right\}
\end{equation}
and the dimension
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{0}=1
\end{equation}
and
\begin{equation}
\mathcal{F}\cong\mathcal{M}\left(  1,\mathbb{C}\right)  \cong\mathbb{C}.
\end{equation}
One can also note the a real representation of the complex numbers
\begin{equation}
\rho:\mathbb{C}\rightarrow\mathcal{B}\left(  \mathbb{R}^{2}\right)
\end{equation}
is given by
\begin{equation}
\rho\left(  z\right)  =\left(
\begin{array}
[c]{cc}%
x & -y\\
y & x
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left\{  z\right\}  & -\operatorname{Im}\left\{  z\right\} \\
\operatorname{Im}\left\{  z\right\}  & \operatorname{Re}\left\{  z\right\}
\end{array}
\right)  ,
\end{equation}
where
\begin{equation}
z=x+iy.
\end{equation}
For $r=1$ the basis of $\mathcal{F}$ is
\begin{equation}
I_{\mathcal{F}},x_{1},x_{2},x_{1}x_{2}%
\end{equation}
and the dimension%
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{2r}=2^{2}=4
\end{equation}
and
\begin{equation}
\mathcal{F}\cong\mathcal{M}\left(  2,\mathbb{C}\right)  .
\end{equation}


For $r=2$ the basis of $\mathcal{F}$ is
\begin{equation}
\left\{  I_{\mathcal{F}},x_{1},x_{2},x_{3},x_{4},x_{1}x_{2},x_{1}x_{3}%
,x_{1}x_{4},x_{2}x_{3},x_{2}x_{4},x_{3}x_{4},x_{1}x_{2}x_{3},x_{1}x_{2}%
x_{4},x_{1}x_{3}x_{4},x_{2}x_{3}x_{4},x_{1}x_{2}x_{3}x_{4}\right\}
\end{equation}
and the dimension%
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{2r}=2^{4}=16
\end{equation}
and
\begin{equation}
\mathcal{F}\cong\mathcal{M}\left(  4,\mathbb{C}\right)  .
\end{equation}


For $r=3$ the basis of $\mathcal{F}$ is
\begin{align}
&  \left\{  I_{\mathcal{F}},x_{1},x_{2},x_{3},x_{4},x_{5},x_{6},\right.
\nonumber\\
&  x_{1}x_{2},x_{1}x_{3},x_{1}x_{4},x_{1}x_{5},x_{1}x_{6},x_{2}x_{3}%
,x_{2}x_{4},x_{2}x_{5},x_{2}x_{6},x_{3}x_{4},x_{3}x_{5},x_{3}x_{6},x_{4}%
x_{5},x_{4}x_{6},x_{5}x_{6},\nonumber\\
&  x_{1}x_{2}x_{3},x_{1}x_{2}x_{4},x_{1}x_{2}x_{5},x_{1}x_{2}x_{6},x_{1}%
x_{3}x_{4},x_{1}x_{3}x_{5},x_{1}x_{3}x_{6},x_{2}x_{3}x_{4},x_{2}x_{3}%
x_{5},x_{2}x_{3}x_{6},x_{3}x_{4}x_{5},x_{3}x_{4}x_{6},x_{4}x_{5}%
x_{6},\nonumber\\
&  x_{1}x_{2}x_{3}x_{4},x_{1}x_{2}x_{3}x_{5},x_{1}x_{2}x_{3}x_{6},x_{1}%
x_{2}x_{4}x_{6},x_{1}x_{2}x_{5}x_{6},x_{1}x_{3}x_{4}x_{5},x_{1}x_{3}x_{4}%
x_{6},x_{1}x_{3}x_{5}x_{6},\nonumber\\
&  x_{2}x_{3}x_{4}x_{5},x_{2}x_{3}x_{4}x_{6},x_{2}x_{3}x_{5}x_{6},x_{3}%
x_{4}x_{5}x_{6},\nonumber\\
&  \left.  x_{1}x_{2}x_{3}x_{4}x_{5},x_{1}x_{2}x_{3}x_{4}x_{6},x_{1}x_{2}%
x_{3}x_{5}x_{6},x_{1}x_{2}x_{4}x_{5}x_{6},x_{1}x_{3}x_{4}x_{5}x_{6},x_{2}%
x_{3}x_{4}x_{5}x_{6},x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}\right\}  ,
\end{align}
and the dimension%
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{2r}=2^{6}=64,
\end{equation}
which corresponds to
\begin{align}
&  \binom{6}{0}+\binom{6}{1}+\binom{6}{2}+\binom{6}{3}+\binom{6}{4}+\binom
{6}{5}+\binom{6}{6}\nonumber\\
&  =1+6+15+20+15+6+1=64
\end{align}
and $\mathcal{F}\cong\mathcal{M}\left(  8,\mathbb{C}\right)  .$

\subsection{The Occupation Number Representation $\mathfrak{O}_{\varphi}$}

The sets of occupation operators $\left\{  \left.  n_{\varphi j},h_{\varphi
j}\right\vert 1\leq j\leq r\right\}  ,\left\{  \left.  h_{\varphi
j}\right\vert 1\leq j\leq r\right\}  ,$ where
\begin{equation}
h_{\varphi j}=I_{\mathcal{F}}-n_{\varphi j},
\end{equation}
associated with a basis $\left\{  \varphi_{1},\cdots,\varphi_{r}\right\}  $ of
$\mathcal{H}^{1}$ act in Fock space $\mathcal{H}_{\mathcal{F}}$ and commute
amongst themselves and each other. They are all orthogonal projection
operators thus their spectrum is $\left\{  0,1\right\}  .$ Also
\begin{align}
n_{\varphi j}h_{\varphi j}  &  =0\\
n_{\varphi j}\left\vert \Psi\right\rangle  &  =\left\vert \Psi\right\rangle
\neq0\Leftrightarrow h_{\varphi j}\left\vert \Psi\right\rangle =0,\,\left\vert
\Psi\right\rangle \in\mathcal{H}_{\mathcal{F}}%
\end{align}
thus the simultaneous eigenbasis $\left\{  \left.  n_{\varphi j}\right\vert
1\leq j\leq r\right\}  $ (or $\left\{  \left.  h_{\varphi j}\right\vert 1\leq
j\leq r\right\}  )$ determines a basis for $\mathcal{H}_{\mathcal{F}}$ and
which can be labelled by the array of eigenvalues$\equiv$quantum numbers
\begin{equation}
\left\vert \eta_{1},\cdots,\eta_{r}\right\rangle ,
\end{equation}
where
\begin{equation}
\eta_{j}=\left\{
\begin{array}
[c]{c}%
0\equiv\text{hole in }j^{th}\text{ position}\\
1\equiv\text{particle in }j^{th}\text{ position}%
\end{array}
\right.  ,1\leq j\leq r,
\end{equation}
again showing that
\begin{equation}
\dim\left\{  \mathcal{H}_{\mathcal{F}}\right\}  =2^{r}.
\end{equation}


\begin{remark}%
\begin{align}
n_{\varphi j}\left\vert \phi\right\rangle  &  =0\left\vert \phi\right\rangle
=0;\,1\leq j\leq r\\
h_{\varphi j}\left\vert \phi\right\rangle  &  =\left\vert \phi\right\rangle
;\,1\leq j\leq r,
\end{align}
where%
\begin{equation}
\left\vert \phi\right\rangle =\left\vert 0\cdots000\cdots000\cdots
000\cdots0\right\rangle ,
\end{equation}
\emph{BUT is \underline{\emph{NOT}} the zero vector, but is a vacuum state}$.$
\end{remark}

\begin{remark}
The labelling of eigenvectors by eigenvalues of the commuting set of number
operators $\left\{  \left.  n_{\varphi j}\right\vert 1\leq j\leq r\right\}  $
produces sequences of binary numbers, viz binary sequences,%
\begin{equation}%
%TCIMACRO{\tsum \nolimits^{2^{r}}}%
%BeginExpansion
{\textstyle\sum\nolimits^{2^{r}}}
%EndExpansion
=\left\{  \left.  \overset{\longleftarrow\qquad\qquad\qquad\qquad\qquad\qquad
r\qquad\qquad\qquad\qquad\qquad\qquad\qquad\longrightarrow}{\left\vert
0\cdots0\cdots\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}0\cdots
0\overset{j_{p-1}}{1}0\cdots0\overset{j_{p}}{1}0\cdots0\right\rangle
}\right\vert 1\leq p\leq r,1\leq j_{1}<\cdots<j_{p}\leq r\right\}  .
\end{equation}
$.$
\end{remark}

\begin{definition}
The \emph{Occupation} \emph{Number} representation $\mathfrak{O}_{\varphi
}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ of $\mathcal{H}_{\mathcal{F}}$ is
defined by the mapping of basis vectors
\begin{equation}
\mathfrak{O}_{\varphi}:\mathcal{H}_{\mathcal{F}}\rightarrow\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{
%TCIMACRO{\tsum \nolimits^{2^{r}}}%
%BeginExpansion
{\textstyle\sum\nolimits^{2^{r}}}
%EndExpansion
\right\}  \overset{\Delta}{=}\mathfrak{B}^{2^{r}}%
\end{equation}
given by
\begin{equation}
\mathfrak{O}_{\varphi}\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \right)  =\overset{\longleftarrow\qquad\qquad\qquad\qquad
\qquad\qquad r\qquad\qquad\qquad\qquad\qquad\qquad\qquad\longrightarrow
}{\left\vert 0\cdots0\cdots\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}%
0\cdots0\overset{j_{p-1}}{1}0\cdots0\overset{j_{p}}{1}0\cdots0\right\rangle },
\end{equation}
where $\left\{  \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\right\rangle \right\vert 1\leq p\leq r,1\leq j_{1}<\cdots<j_{p}\leq
r\right\}  $ is a complete orthonormal \emph{GSO} \emph{basis} of
$\mathcal{H}_{\mathcal{F}}$ and $\mathfrak{O}_{\varphi}$ is a linear algebra
isomorphism i.e. $\mathfrak{O}_{\varphi}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \cong\mathfrak{B}^{2^{r}},$ which in the infinite $r=\infty$ case is
not a Hilbert space isomorphism as $\mathcal{H}_{\mathcal{F}}$ is a separable
Hilbert space but $\mathfrak{B}^{2^{r}}$ is not$.$
\end{definition}

\begin{remark}
The full spaces $\bigotimes\nolimits^{r}\mathcal{M}\left(  2,\mathbb{C}%
\right)  $ and $\mathfrak{B}^{2^{r}}$ are generated by complex linear
combinations of $\left\{  \left.  e_{j_{1}}\otimes\cdots\otimes e_{j_{2^{r}}%
}\right\vert 1\leq j_{1},\cdots,j_{2^{r}}\leq2\right\}  $ and $\left\{
\left.  \overset{\longleftarrow\qquad\qquad\qquad\qquad\qquad\qquad
r\qquad\qquad\qquad\qquad\qquad\qquad\qquad\longrightarrow}{\left\vert
0\cdots0\cdots\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}0\cdots
0\overset{j_{p-1}}{1}0\cdots0\overset{j_{p}}{1}0\cdots0\right\rangle
}\right\vert 1\leq p\leq r,1\leq j_{1}<\cdots<j_{p}\leq r\right\}  .$
\end{remark}

\begin{definition}
The \emph{Occupation} \emph{Number} representation $\mathfrak{O}_{\varphi}$
can be extended to $\mathcal{F}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  $ i.e.
\begin{equation}
\mathfrak{O}_{\varphi}:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\rightarrow\mathcal{L}\left(  \mathfrak{B}^{2^{r}}\right)  ,
\end{equation}
where $\mathcal{L}\left(  \mathfrak{B}^{2^{r}}\right)  $ is the algebraic
space of linear operators acting in $\mathfrak{B}^{2^{r}},$ i.e. ignoring any
topological considerations.
\end{definition}

\begin{remark}
As mentioned previously in terms of matrices belonging to $\mathcal{M}\left(
2,\mathbb{C}\right)  $ and $\mathcal{M}\left(  2^{r},\mathbb{C}\right)  $
acting in $\mathbb{C}^{2}$ and $\mathbb{C}^{2^{r}}$ the Jordon-Wigner
transformations $JW$ and $jw$ are interpreted in terms of representations
generated by bases $\left\{  \left.  \left\vert e_{j}\right\rangle \right\vert
1\leq j\leq2\right\}  $ i.e. between the operator spaces
\begin{align}
JW  &  :\mathcal{F}\rightarrow\mathcal{B}\left(  \mathbb{C}^{2r\otimes}\right)
\\
\mathcal{R}_{e}  &  :\mathcal{B}\left(  \mathbb{C}^{2r\otimes}\right)
\rightarrow\mathcal{M}\left(  2^{r},\mathbb{C}\right)
\end{align}
and between the Hilbert spaces%
\begin{align}
jw  &  :\mathcal{H}_{\mathcal{F}}\rightarrow\mathbb{C}^{2r\otimes}\\
\mathcal{R}_{e}  &  :\mathbb{C}^{2r\otimes}\rightarrow\mathbb{C}^{2r\otimes}.
\end{align}

\end{remark}

\subsubsection{Connection between $JW$ and $\mathfrak{O}_{\varphi}$}

The number occupation and the Jordan - Wigner maps between vector spaces
\begin{align}
\mathfrak{O}_{\varphi}  &  :\mathcal{H}_{\mathcal{F}}\rightarrow
\mathfrak{B}^{2^{r}}\\
jw_{e}  &  :\mathcal{H}_{\mathcal{F}}\rightarrow\mathcal{R}_{e}\left(
\mathbb{C}^{2r\otimes}\right)
\end{align}
leads to the \emph{Quantum Qubit} map $\left(  \mathfrak{QU}\right)  $
\begin{gather}
\mathcal{H}_{\mathcal{F}}\\
\swarrow\qquad\searrow\\
\swarrow\mathfrak{O}_{\varphi}\qquad jw_{e}\searrow\\
\swarrow\qquad\qquad\qquad\qquad\searrow\\
\mathfrak{B}^{2^{r}}{\LARGE \longleftarrow}{\Large ---}\left(  \mathfrak{QU}%
\right)  {\Large -}\mathcal{R}_{e}\left(  \bigotimes\nolimits^{r}%
\mathbb{C}^{2}\right)  .
\end{gather}


\begin{notation}
We use the same symbol $\mathfrak{O}_{\varphi}$ to denote occupation number
representations of $\mathcal{H}_{\mathcal{F}}$ and $\mathcal{F}.$
\end{notation}

The number occupation and the Jordan - Wigner maps between operator spaces
\begin{align}
\mathfrak{O}_{\varphi}  &  :\mathcal{F}\rightarrow\mathcal{L}\left(
\mathfrak{B}^{2^{r}}\right) \\
JW_{e}  &  :\mathcal{F}\rightarrow\mathcal{B}\left(  \mathcal{R}_{e}\left(
\mathbb{C}^{2r\otimes}\right)  \right)  \equiv\mathcal{M}\left(
2^{r},\mathbb{C}\right)
\end{align}
leads to the Quantum Program map $\left(  \mathfrak{QP}\right)  $
\begin{gather}
\,\,\,\mathcal{F}\\
\swarrow\qquad\searrow\\
\swarrow\mathfrak{O}_{\varphi}\qquad JW_{e}\searrow\\
\swarrow\,\,\qquad\qquad\qquad\qquad\,\,\searrow\\
\mathcal{L}\left(  \mathfrak{B}^{2^{r}}\right)  {\LARGE \longleftarrow
}\,{\Large --}\left(  \mathfrak{QP}\right)  {\Large ---}\bigotimes
\nolimits^{r}\mathcal{M}\left(  2,\mathbb{C}\right)  .
\end{gather}


\begin{remark}
The vector and operator occupation number representation is given by
\begin{align}
\mathfrak{O}_{\varphi}  &  =jw_{e}\circ\mathfrak{QU:\mathcal{H}_{\mathcal{F}%
}\rightarrow B}^{2^{r}}\\
\mathfrak{O}_{\varphi}  &  =JW_{e}\circ\mathfrak{QP:\mathcal{F}}%
\rightarrow\mathcal{L}\left(  \mathfrak{B}^{2^{r}}\right)  .
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
\bigotimes\nolimits^{r}\mathcal{M}\left(  2,\mathbb{C}\right)  \cong%
\mathcal{B}\left(  \mathcal{R}_{e}\left(  \mathbb{C}^{2r\otimes}\right)
\right)  .
\end{equation}

\end{remark}

\begin{remark}
The spaces $\mathcal{H}_{\mathcal{F}}$ and $\mathbb{C}^{2r\otimes}$ are
endowered with inner products and thus norms, however they are not isomorphic
in the $r=\infty$ limit.
\end{remark}

\begin{example}
