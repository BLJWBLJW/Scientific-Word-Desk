\operatorname*{linspan}\left\{  \left\vert \varphi_{1}^{d}\varphi_{2}%
^{d}\right\rangle \right\}  \cong\mathbb{C}.
\end{align}


\item The exterior algebras of $\mathcal{H}^{1}$ and $\mathcal{H}^{1d}$%
\begin{align}%
%TCIMACRO{\tbigwedge }%
