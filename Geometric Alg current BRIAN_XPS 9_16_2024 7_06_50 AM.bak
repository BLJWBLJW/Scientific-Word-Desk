\right\rangle \left\langle \Phi_{\operatorname*{tr}}\left(  I_{\mathcal{F}%
}\right)  \right\vert
\end{align}
and $\left\{  \left.  \left\vert \Phi_{\operatorname*{tr}}\left(
I_{\mathcal{F}}\right)  \right\rangle ,\left\vert \Phi_{\operatorname*{tr}%
}\left(  \widetilde{x}_{j_{1}}\cdots\widetilde{x}_{j_{n}}\right)
\right\rangle \right\vert 1\leq j_{1}<\cdots<j_{n}\leq2r,1\leq n\leq
2r\right\}  $ is a conb for $\Phi_{\operatorname*{tr}}\left(  \mathcal{F}%
\right)  .$

