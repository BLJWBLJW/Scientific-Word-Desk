\dim\left\{  {\huge \wedge}^{4}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \right\}  =\binom{4}{4}=1.
\end{equation}

\end{remark}

\item The expansion of the exterior algebra of the direct sum is
