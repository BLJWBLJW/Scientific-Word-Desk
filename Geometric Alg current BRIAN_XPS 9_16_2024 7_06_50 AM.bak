\section{Commutation Relationships}

Assuming a normalized basis $\left\{  x_{j}\right\}  $ the CR's for
\emph{Majorano Spinors}

\begin{enumerate}
\item
\begin{equation}
\left[  x_{j},x_{k}\right]  =x_{j}x_{k}-x_{k}x_{j}=x_{j}x_{k}-\left(
I_{\mathcal{F}}\delta_{kj}-x_{j}x_{k}\right)  =2x_{j}x_{k}-I_{\mathcal{F}%
}\delta_{kj}%
\end{equation}


\item
\begin{gather}
j_{1}\neq j_{2};k_{1}\neq k_{2}\nonumber\\
\left[  x_{j_{1}}x_{j_{2}},x_{k_{1}}x_{k_{2}}\right]  =x_{j_{1}}x_{j_{2}%
}x_{k_{1}}x_{k_{2}}-x_{k_{1}}x_{k_{2}}x_{j_{1}}x_{j_{2}}\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}-x_{k_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{1}k_{2}}-x_{j_{1}}x_{k_{2}}\right)  x_{j_{2}}\nonumber\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}-x_{k_{1}}x_{j_{2}}\delta_{j_{1}k_{2}%
}+x_{k_{1}}x_{j_{1}}x_{k_{2}}x_{j_{2}}\nonumber\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}-x_{k_{1}}x_{j_{2}}\delta_{j_{1}k_{2}%
}+\left(  I_{\mathcal{F}}\delta_{j_{1}k_{1}}-x_{j_{1}}x_{k_{1}}\right)
\left(  I_{\mathcal{F}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\right)
\nonumber\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}-x_{k_{1}}x_{j_{2}}\delta_{j_{1}k_{2}%
}+I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-x_{j_{1}}x_{k_{1}%
}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}}x_{k_{1}%
}x_{j_{2}}x_{k_{2}}\nonumber\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}-x_{k_{1}}x_{j_{2}}\delta_{j_{1}k_{2}%
}+I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-x_{j_{1}}x_{k_{1}%
}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}}\left(
I_{\mathcal{F}}\delta_{j_{2}k_{1}}-x_{j_{2}}x_{k_{1}}\right)  x_{k_{2}%
}\nonumber\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}-\left(  I_{\mathcal{F}}\delta
_{j_{2}k_{1}}-x_{j_{2}}x_{k_{1}}\right)  \delta_{j_{1}k_{2}}+I_{\mathcal{F}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-x_{j_{1}}x_{k_{1}}\delta_{j_{2}k_{2}%
}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}}x_{k_{2}}\delta_{j_{2}k_{1}%
}-x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}\nonumber\\
=x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}+\left(  \delta_{j_{1}k_{1}}\delta
_{j_{2}k_{2}}-\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}\right)  I_{\mathcal{F}%
}+x_{j_{2}}x_{k_{1}}\delta_{j_{1}k_{2}}-x_{j_{1}}x_{k_{1}}\delta_{j_{2}k_{2}%
}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}}x_{k_{2}}\delta_{j_{2}k_{1}%
}-x_{j_{1}}x_{j_{2}}x_{k_{1}}x_{k_{2}}\nonumber\\
=\left(  \delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{2}k_{1}}%
\delta_{j_{1}k_{2}}\right)  I_{\mathcal{F}}+x_{j_{2}}x_{k_{1}}\delta
_{j_{1}k_{2}}-x_{j_{1}}x_{k_{1}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}%
\delta_{j_{1}k_{1}}+x_{j_{1}}x_{k_{2}}\delta_{j_{2}k_{1}},
\end{gather}
giving
\begin{equation}
\left[  x_{j_{1}}x_{j_{2}},x_{k_{1}}x_{k_{2}}\right]  =\left(  \delta
_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}%
}\right)  I_{\mathcal{F}}+x_{j_{2}}x_{k_{1}}\delta_{j_{1}k_{2}}-x_{j_{1}%
}x_{k_{1}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\delta_{j_{1}k_{1}}+x_{j_{1}%
}x_{k_{2}}\delta_{j_{2}k_{1}}.
\end{equation}


\item
\begin{gather}
j_{1}\neq j_{2}\\
\left[  x_{j_{1}}x_{j_{2}},x_{k_{1}}\right]  =x_{j_{1}}x_{j_{2}}x_{k_{1}%
}-x_{k_{1}}x_{j_{1}}x_{j_{2}}=\left(  \delta_{j_{2}k_{2}}-\delta_{j_{1}k_{1}%
}\right)  x_{k_{1}}.
\end{gather}


\item
\begin{align}
&  \left[  x_{j_{1}}x_{j_{2}}x_{j_{3}},x_{k_{1}}x_{k_{2}}x_{k_{3}}\right]
=x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}-x_{k_{1}}x_{k_{2}%
}x_{k_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}\nonumber\\
&  =x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}\nonumber\\
&  -x_{k_{1}}\left(  \left(  \delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}%
-\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}}\right)  I_{\mathcal{F}}+x_{j_{2}%
}x_{k_{2}}\delta_{j_{1}k_{3}}-x_{j_{1}}x_{k_{2}}\delta_{j_{2}k_{3}}-x_{j_{2}%
}x_{k_{3}}\delta_{j_{1}k_{2}}+x_{j_{1}}x_{k_{3}}\delta_{j_{2}k_{2}}-x_{j_{1}%
}x_{j_{2}}x_{k_{2}}x_{k_{3}}\right)  x_{j_{3}}\\
&  =x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}-\left(
\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}-\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}%
}\right)  x_{k_{1}}x_{j_{3}}+x_{k_{1}}x_{j_{2}}x_{k_{2}}x_{j_{3}}\delta
_{j_{1}k_{3}}-x_{k_{1}}x_{j_{1}}x_{k_{2}}x_{j_{3}}\delta_{j_{2}k_{3}%
}\nonumber\\
&  -x_{k_{1}}x_{j_{2}}x_{k_{3}}x_{j_{3}}\delta_{j_{1}k_{2}}+x_{k_{1}}x_{j_{1}%
}x_{k_{3}}x_{j_{3}}\delta_{j_{2}k_{2}}-x_{k_{1}}x_{j_{1}}x_{j_{2}}x_{k_{2}%
}x_{k_{3}}x_{j_{3}}\nonumber\\
&  =x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}-\left(
\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}-\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}%
}\right)  x_{k_{1}}x_{j_{3}}+\left(  I_{\mathcal{F}}\delta_{j_{2}k_{1}%
}-x_{j_{2}}x_{k_{1}}\right)  \left(  I_{\mathcal{F}}\delta_{j_{3}k_{2}%
}-x_{j_{3}}x_{k_{2}}\right)  \delta_{j_{1}k_{3}}\nonumber\\
&  -\left(  I_{\mathcal{F}}\delta_{j_{1}k_{1}}-x_{j_{1}}x_{k_{1}}\right)
\left(  I_{\mathcal{F}}\delta_{j_{3}k_{2}}-x_{j_{3}}x_{k_{2}}\right)
\delta_{j_{2}k_{3}}\\
&  -\left(  I_{\mathcal{F}}\delta_{j_{2}k_{1}}-x_{j_{2}}x_{k_{1}}\right)
\left(  I_{\mathcal{F}}\delta_{j_{3}k_{3}}-x_{j_{3}}x_{k_{3}}\right)
\delta_{j_{1}k_{2}}+\left(  I_{\mathcal{F}}\delta_{j_{1}k_{1}}-x_{j_{1}%
}x_{k_{1}}\right)  \left(  I_{\mathcal{F}}\delta_{j_{3}k_{3}}-x_{j_{3}%
}x_{k_{3}}\right)  \delta_{j_{2}k_{2}}\nonumber\\
&  -\left(  I_{\mathcal{F}}\delta_{j_{1}k_{1}}-x_{j_{1}}x_{k_{1}}\right)
\left(  I_{\mathcal{F}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}\right)  \left(
I_{\mathcal{F}}\delta_{j_{3}k_{3}}-x_{j_{3}}x_{k_{3}}\right) \\
&  =x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}-x_{k_{1}}x_{j_{3}%
}\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}+x_{k_{1}}x_{j_{3}}\delta_{j_{2}k_{2}%
}\delta_{j_{1}k_{3}}\nonumber\\
&  +I_{\mathcal{F}}\delta_{j_{2}k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{1}k_{3}%
}-x_{j_{2}}x_{k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{1}k_{3}}-x_{j_{3}}x_{k_{2}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{3}}+x_{j_{2}}x_{k_{1}}x_{j_{3}}x_{k_{2}%
}\delta_{j_{1}k_{3}}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{2}k_{3}%
}-x_{j_{1}}x_{k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{2}k_{3}}-x_{j_{3}}x_{k_{2}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{3}}+x_{j_{1}}x_{k_{1}}x_{j_{3}}x_{k_{2}%
}\delta_{j_{2}k_{3}}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{2}k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{1}k_{2}%
}-x_{j_{2}}x_{k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{1}k_{2}}-x_{j_{3}}x_{k_{3}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}+x_{j_{2}}x_{k_{1}}x_{j_{3}}x_{k_{3}%
}\delta_{j_{1}k_{2}}\nonumber\\
&  +I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{2}k_{2}%
}-x_{j_{1}}x_{k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{2}k_{2}}-x_{j_{3}}x_{k_{3}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}+x_{j_{1}}x_{k_{1}}x_{j_{3}}x_{k_{3}%
}\delta_{j_{2}k_{2}}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}\delta_{j_{3}k_{3}%
}+x_{j_{1}}x_{k_{1}}\delta_{j_{2}k_{2}}\delta_{j_{3}k_{3}}+x_{j_{2}}x_{k_{2}%
}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{3}}-x_{j_{1}}x_{k_{1}}x_{j_{2}}x_{k_{2}%
}\delta_{j_{3}k_{3}}\nonumber\\
&  +x_{j_{3}}x_{k_{3}}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-x_{j_{1}}%
x_{k_{1}}x_{j_{3}}x_{k_{3}}\delta_{j_{2}k_{2}}-x_{j_{2}}x_{k_{2}}x_{j_{3}%
}x_{k_{3}}\delta_{j_{1}k_{1}}+x_{j_{1}}x_{k_{1}}x_{j_{2}}x_{k_{2}}x_{j_{3}%
}x_{k_{3}}%
\end{align}

\end{enumerate}

\bigskip%
\begin{align}
&  =x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}-\left(
I_{\mathcal{F}}\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  \delta
_{j_{1}k_{2}}\delta_{j_{2}k_{3}}+\left(  I_{\mathcal{F}}\delta_{j_{3}k_{1}%
}-x_{j_{3}}x_{k_{1}}\right)  \delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}}\nonumber\\
&  +I_{\mathcal{F}}\delta_{j_{2}k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{1}k_{3}%
}-x_{j_{2}}x_{k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{1}k_{3}}-x_{j_{3}}x_{k_{2}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{3}}+x_{j_{2}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{2}}\delta_{j_{1}k_{3}%
}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{2}k_{3}%
}-x_{j_{1}}x_{k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{2}k_{3}}-x_{j_{3}}x_{k_{2}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{3}}+x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{2}}\delta_{j_{2}k_{3}%
}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{2}k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{1}k_{2}%
}-x_{j_{2}}x_{k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{1}k_{2}}-x_{j_{3}}x_{k_{3}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}+x_{j_{2}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{3}}\delta_{j_{1}k_{2}%
}\nonumber\\
&  +I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{2}k_{2}%
}-x_{j_{1}}x_{k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{2}k_{2}}-x_{j_{3}}x_{k_{3}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}+x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{3}}\delta_{j_{2}k_{2}%
}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}\delta_{j_{3}k_{3}%
}+x_{j_{1}}x_{k_{1}}\delta_{j_{2}k_{2}}\delta_{j_{3}k_{3}}+x_{j_{2}}x_{k_{2}%
}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{3}}-x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{1}k_{2}}-x_{j_{1}}x_{k_{2}}\right)  x_{k_{2}}\delta_{j_{3}k_{3}%
}\nonumber\\
&  +\left(  I_{\mathcal{F}}\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)
\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{3}}\delta_{j_{2}k_{2}%
}\nonumber\\
&  -x_{j_{2}}\left(  I_{\mathcal{F}}\delta_{j_{3}k_{2}}-x_{j_{3}}x_{k_{2}%
}\right)  x_{k_{3}}\delta_{j_{1}k_{1}}+x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{1}k_{2}}-x_{j_{1}}x_{k_{2}}\right)  \left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{2}}-x_{j_{3}}x_{k2}\right)  x_{k_{3}}%
\end{align}%
\begin{align}
&  =x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{k_{1}}x_{k_{2}}x_{k_{3}}-I_{\mathcal{F}%
}\delta_{j_{3}k_{1}}\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}-x_{j_{3}}x_{k_{1}%
}\delta_{j_{1}k_{2}}\delta_{j_{2}k_{3}}+I_{\mathcal{F}}\delta_{j_{3}k_{1}%
}\delta_{j_{2}k_{2}}\delta_{j_{1}k_{3}}-x_{j_{3}}x_{k_{1}}\delta_{j_{2}k_{2}%
}\delta_{j_{1}k_{3}}\nonumber\\
&  +I_{\mathcal{F}}\delta_{j_{2}k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{1}k_{3}%
}-x_{j_{2}}x_{k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{1}k_{3}}-x_{j_{3}}x_{k_{2}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{3}}+x_{j_{2}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{2}}\delta_{j_{1}k_{3}%
}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{2}k_{3}%
}-x_{j_{1}}x_{k_{1}}\delta_{j_{3}k_{2}}\delta_{j_{2}k_{3}}-x_{j_{3}}x_{k_{2}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{3}}+x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{2}}\delta_{j_{2}k_{3}%
}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{2}k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{1}k_{2}%
}-x_{j_{2}}x_{k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{1}k_{2}}-x_{j_{3}}x_{k_{3}%
}\delta_{j_{2}k_{1}}\delta_{j_{1}k_{2}}+x_{j_{2}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{3}}\delta_{j_{1}k_{2}%
}\nonumber\\
&  +I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{2}k_{2}%
}-x_{j_{1}}x_{k_{1}}\delta_{j_{3}k_{3}}\delta_{j_{2}k_{2}}-x_{j_{3}}x_{k_{3}%
}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}+x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{3}}\delta_{j_{2}k_{2}%
}\nonumber\\
&  -I_{\mathcal{F}}\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}\delta_{j_{3}k_{3}%
}+x_{j_{1}}x_{k_{1}}\delta_{j_{2}k_{2}}\delta_{j_{3}k_{3}}+x_{j_{2}}x_{k_{2}%
}\delta_{j_{1}k_{1}}\delta_{j_{3}k_{3}}-x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{1}k_{2}}-x_{j_{1}}x_{k_{2}}\right)  x_{k_{2}}\delta_{j_{3}k_{3}%
}\nonumber\\
&  +\left(  I_{\mathcal{F}}\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)
\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{1}}-x_{j_{3}}x_{k_{1}}\right)  x_{k_{3}}\delta_{j_{2}k_{2}%
}\nonumber\\
&  -x_{j_{2}}\left(  I_{\mathcal{F}}\delta_{j_{3}k_{2}}-x_{j_{3}}x_{k_{2}%
}\right)  x_{k_{3}}\delta_{j_{1}k_{1}}+x_{j_{1}}\left(  I_{\mathcal{F}}%
\delta_{j_{1}k_{2}}-x_{j_{1}}x_{k_{2}}\right)  \left(  I_{\mathcal{F}}%
\delta_{j_{3}k_{2}}-x_{j_{3}}x_{k2}\right)  x_{k_{3}}.
\end{align}
Thus
\begin{equation}
\mathcal{F}_{\left(  2\right)  }=\mathcal{F}_{0}\oplus\mathcal{F}_{1}%
\oplus\mathcal{F}_{2}%
\end{equation}
is closed under the Lie product $\left[  ,\right]  ,$ while $\mathcal{F}%
_{\left(  n\right)  },3,\cdots,2r-1$ is not closed.

\bigskip The CR's for\emph{ second degree Fermion Operators}

\begin{enumerate}
\item
\begin{gather}
\left[  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger},a_{l_{2}}a_{l_{1}}\right]
\nonumber\\
\parallel\\
I_{\mathcal{H}_{\mathcal{F}}}\delta_{l_{2}k_{1}}\delta_{l_{1}k_{2}%
}-I_{\mathcal{H}_{\mathcal{F}}}\delta_{l_{2}k_{2}}\delta_{l_{1}k_{1}}%
+a_{k_{2}}^{\dagger}a_{l_{2}}\delta_{l_{1}k_{1}}-a_{k_{1}}^{\dagger}a_{l_{2}%
}\delta_{l_{1}k_{2}}-a_{k_{2}}^{\dagger}a_{l_{1}}\delta_{l_{2}k_{1}}+a_{k_{1}%
}^{\dagger}a_{l_{1}}\delta_{l_{2}k_{2}},
\end{gather}
which gives%
\begin{equation}
a_{l_{4}}a_{l_{3}}a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}=a_{k_{1}}^{\dagger
}a_{k_{2}}^{\dagger}a_{l_{4}}a_{l_{3}}-I_{\mathcal{H}_{\mathcal{F}}}%
\delta_{l_{4}k_{1}}\delta_{l_{3}k_{2}}+I_{\mathcal{H}_{\mathcal{F}}}%
\delta_{l_{4}k_{2}}\delta_{l_{3}k_{1}}-a_{k_{2}}^{\dagger}a_{l_{4}}%
\delta_{l_{3}k_{1}}+a_{k_{1}}^{\dagger}a_{l_{4}}\delta_{l_{3}k_{2}}+a_{k_{2}%
}^{\dagger}a_{l_{3}}\delta_{l_{4}k_{1}}-a_{k_{1}}^{\dagger}a_{l_{3}}%
\delta_{l_{4}k_{2}}.\nonumber
\end{equation}

\end{enumerate}

%

\begin{gather}
\left[  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger},a_{l_{2}}^{\dagger}a_{l_{1}%
}\right] \nonumber\\
\parallel\\
a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{l_{2}}^{\dagger}a_{l_{1}}-a_{l_{2}%
}^{\dagger}a_{l_{1}}a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}=a_{k_{1}}^{\dagger
}a_{k_{2}}^{\dagger}a_{l_{2}}^{\dagger}a_{l_{1}}-a_{l_{2}}^{\dagger}\left(
\delta_{l_{1}k_{1}}-a_{k_{1}}^{\dagger}a_{l_{1}}\right)  a_{k_{2}}^{\dagger
}=a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{l_{2}}^{\dagger}a_{l_{1}}-a_{l_{2}%
}^{\dagger}a_{k_{2}}^{\dagger}\delta_{l_{1}k_{1}}+a_{l_{2}}^{\dagger}a_{k_{1}%
}^{\dagger}a_{l_{1}}a_{k_{2}}^{\dagger}\\
=a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{l_{2}}^{\dagger}a_{l_{1}}-a_{l_{2}%
}^{\dagger}a_{k_{2}}^{\dagger}\delta_{l_{1}k_{1}}+a_{l_{2}}^{\dagger}a_{k_{1}%
}^{\dagger}\left(  \delta_{l_{1}k_{2}}-a_{k_{2}}^{\dagger}a_{l_{1}}\right)
=a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{l_{2}}^{\dagger}a_{l_{1}}-a_{l_{2}%
}^{\dagger}a_{k_{2}}^{\dagger}\delta_{l_{1}k_{1}}+a_{l_{2}}^{\dagger}a_{k_{1}%
}^{\dagger}\delta_{l_{1}k_{2}}-a_{l_{2}}^{\dagger}a_{k_{1}}^{\dagger}a_{k_{2}%
}^{\dagger}a_{l_{1}}\\
=a_{l_{2}}^{\dagger}a_{k_{1}}^{\dagger}\delta_{l_{1}k_{2}}-a_{l_{2}}^{\dagger
}a_{k_{2}}^{\dagger}\delta_{l_{1}k_{1}}%
\end{gather}
i.e.%
\begin{equation}
\left[  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger},a_{l_{2}}^{\dagger}a_{l_{1}%
}\right]  =a_{l_{2}}^{\dagger}a_{k_{1}}^{\dagger}\delta_{l_{1}k_{2}}-a_{l_{2}%
}^{\dagger}a_{k_{2}}^{\dagger}\delta_{l_{1}k_{1}}.
\end{equation}


\subsection{Isomorphisms of $\operatorname*{Cl}\left(  p,q\right)  $ with
matrix rings}

\begin{enumerate}
\item when $p-q$ $\left(  \operatorname{Mod}\left(  8\right)  \right)  $
$=3,7$ then $\operatorname*{Cl}\left(  p,q\right)  $ $\cong\mathcal{M}\left(
2^{\frac{p+q-1}{2}},\mathbb{C}\right)  \left[  \overset{}{=\mathcal{M}\left(
2^{1},\mathbb{C}\right)  \text{ or }\mathcal{M}\left(  2^{3},\mathbb{C}%
\right)  ,\quad\mathcal{M}\left(  2^{8},\mathbb{C}\right)  \text{ or
}\mathcal{M}\left(  2^{11},\mathbb{C}\right)  ,\cdots}\right]  $

\item when $p-q$ $\left(  \operatorname{Mod}\left(  8\right)  \right)  =2,0$
then $\operatorname*{Cl}\left(  p,q\right)  \cong\mathcal{M}\left(
2^{\frac{p+q}{2}},\mathbb{R}\right)  =$

\item when $p-q$ $\left(  \operatorname{Mod}\left(  8\right)  \right)  $
$=4,6$ then $\operatorname*{Cl}\left(  p,q\right)  $ $\cong\mathcal{M}\left(
2^{\frac{p+q-2}{2}},\mathbb{H}\right)  =$

\item when $p-q$ $\left(  \operatorname{Mod}\left(  8\right)  \right)  $ $=1$
then $\operatorname*{Cl}\left(  p,q\right)  $ $\cong\mathcal{M}\left(
2^{\frac{p+q-1}{2}},\mathbb{R}\right)  $ $\oplus\,\,\mathcal{M}\left(
2^{\frac{p+q-1}{2}},\mathbb{R}\right)  =$

\item when $p-q$ $\left(  \operatorname{Mod}\left(  8\right)  \right)  $ $=5$
then $\operatorname*{Cl}\left(  p,q\right)  \cong\mathcal{M}\left(
2^{\frac{p+q-3}{2}},\mathbb{H}\right)  $ $\oplus$ $\mathcal{M}\left(
2^{\frac{p+q-3}{2}},\mathbb{H}\right)  =$
\end{enumerate}

\bigskip Starting at dimension $8$ we've the recursion relation. In other
words, $\operatorname*{Cl}\left(  p,q\right)  \$\operatorname*{Cl}(n+8)$
consists of $16\times16$ matrices with entries in $\operatorname*{Cl}(n+8)$
This `period-$8$' is called \emph{Bott periodicity}, since it has a
far-ranging set of applications to topology, some of which were discovered by
Bott.%
\begin{gather}
\operatorname*{Cl}\left(  p,q,\mathbb{R}\right) \\
\shortparallel
\end{gather}%
\begin{equation}
\left(
\begin{array}
[c]{ccccccccc}%
p\left/  q\right.  & 0 & 1 & 2 & 3 & 4 & 5 & 6 & 7\\
7 & \operatorname*{Cl}\left(  0,0,\mathbb{R}\right)  &  &  &  &  &  &  &
\operatorname*{Cl}\left(  0,7,\mathbb{R}\right) \\
6 & \operatorname*{Cl}\left(  1,0,\mathbb{R}\right)  &  &  &  &  &  &  &
\operatorname*{Cl}\left(  1,7,\mathbb{R}\right) \\
5 &  &  &  &  &  &  &  & \\
4 &  &  &  &  &  &  &  & \\
3 &  &  &  &  &  &  &  & \\
2 &  &  &  &  &  &  &  & \\
1 & \operatorname*{Cl}\left(  7,0,\mathbb{R}\right)  &  &  &  &  &  &  &
\operatorname*{Cl}\left(  6,7,\mathbb{R}\right) \\
0 & 0 & 1 & 2 & 3 & 4 & 5 & 6 & 7
\end{array}
\right)
\end{equation}%
\begin{equation}
\shortparallel
\end{equation}%
\begin{align}
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathbb{R}\\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathbb{C=R\oplus
R=R}^{2}\\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathbb{H}\\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathbb{H\oplus H}\\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathcal{M}\left(
2,\mathbb{H}\right) \\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathcal{M}\left(
4,\mathbb{C}\right) \\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathcal{M}\left(
8,\mathbb{R}\right) \\
\operatorname*{Cl}\left(  0,0.\mathbb{R}\right)   &  =\mathcal{M}\left(
8,\mathbb{R}\right)  \oplus\mathcal{M}\left(  8,\mathbb{R}\right)
\end{align}%
\begin{gather}
\operatorname*{Cl}\left(  n,0,\mathbb{R}\right)  =\operatorname*{Cl}\left(
8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}\left(  n-8,0,\mathbb{R}%
\right) \\
\operatorname*{Cl}\left(  9,0,\mathbb{R}\right)  =\operatorname*{Cl}\left(
8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}\left(  9-8,0,\mathbb{R}%
\right)  =\operatorname*{Cl}\left(  8,0,\mathbb{R}\right)  \otimes
\operatorname*{Cl}\left(  1,0,\mathbb{R}\right) \\
\vdots\\
\operatorname*{Cl}\left(  15,0,\mathbb{R}\right)  =\operatorname*{Cl}\left(
8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}\left(  15-8,0,\mathbb{R}%
\right)  =\operatorname*{Cl}\left(  8,0,\mathbb{R}\right)  \otimes
\operatorname*{Cl}\left(  7,0,\mathbb{R}\right) \\
\operatorname*{Cl}\left(  16,0,\mathbb{R}\right)  =\operatorname*{Cl}\left(
8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}\left(  16-8,0,\mathbb{R}%
\right)  =\operatorname*{Cl}\left(  8,0,\mathbb{R}\right)  \otimes
\operatorname*{Cl}\left(  8,0,\mathbb{R}\right) \\
\operatorname*{Cl}\left(  17,0,\mathbb{R}\right)  =\operatorname*{Cl}\left(
8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}\left(  17-8,0,\mathbb{R}%
\right)  =\operatorname*{Cl}\left(  8,0,\mathbb{R}\right)  \otimes
\operatorname*{Cl}\left(  9,0,\mathbb{R}\right) \\
=\operatorname*{Cl}\left(  8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}%
\left(  8,0,\mathbb{R}\right)  \otimes\operatorname*{Cl}\left(  1,0,\mathbb{R}%
\right)  .
\end{gather}


Thus \emph{all }real Clifford algebras are produced from the Clifford algebras
$\operatorname*{Cl}\left(  p,q,\mathbb{R}\right)  ;$ $0\leq p,q\leq8$, whose
structure is given in the following:%

