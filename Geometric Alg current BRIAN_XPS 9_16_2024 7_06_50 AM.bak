,\Phi_{\operatorname*{tr}}\left(  a_{j_{1}}\right)  \right\vert 1\leq
j_{1}\leq4\right\}  \right\} \\
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\{  \left.
\Phi_{\operatorname*{tr}}\left(  x_{j_{m}}\right)  \right\vert 1\leq j_{m}%
\leq8\right\}  \right\} \\
\dim\left\{  \mathcal{H}_{\operatorname*{tr}}^{1}\right\}  =8.
\end{gather}


\item
\begin{align}
\Pi_{\varphi_{f}}\left(  I_{\mathcal{A}}\right)   &  =I_{16}\\
