\oplus\mathcal{H}^{1d}\right)  \oplus{\huge \wedge}^{3}\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  \oplus{\huge \wedge}^{4}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,
\end{equation}
where

\item
\begin{equation}
{\huge \wedge}^{1}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
