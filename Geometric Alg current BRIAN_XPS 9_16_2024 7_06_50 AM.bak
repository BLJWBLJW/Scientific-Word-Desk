\mathcal{H}^{1d}\right)  \right]  \oplus\left[  \left(  {\huge \wedge}%
^{2}\mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)  \right] \\
\oplus\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge{\huge \wedge
}^{2}\mathcal{H}^{1d}\right)  \right]  \ \oplus\left[  \left(  {\huge \wedge
}^{2}\mathcal{H}^{1}\wedge{\huge \wedge}^{2}\mathcal{H}^{1d}\right)  \right]
\oplus\left[  \left(  {\huge \wedge}^{2}\mathcal{H}^{1}\wedge{\huge \wedge
}^{2}\mathcal{H}^{1d}\right)  \right]  .
\end{gather}


\item Exterior products of second order exterior products
\begin{align}
&
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1}\wedge%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1}=%
%TCIMACRO{\tbigwedge \nolimits^{4}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{4}}
%EndExpansion
\mathcal{H}^{1}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \right\}  \wedge\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\right\}  =0\\
&
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1}\wedge%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1d}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \right\}  \wedge\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left\langle \varphi_{1}\varphi_{2}\right\vert
\right\}  =\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \wedge\left\langle \varphi_{1}\varphi
_{2}\right\vert \right\}  \mathbb{\ }\\
&
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1d}\wedge%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\mathcal{H}^{1d}=%
%TCIMACRO{\tbigwedge \nolimits^{4}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{4}}
%EndExpansion
\mathcal{H}^{1d}=\mathbb{C}\text{-}\operatorname*{linspan}\left\{
\left\langle \varphi_{1}\varphi_{2}\right\vert \right\}  \wedge\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\}  =0.
\end{align}


\item Tensor product of direct sums
\begin{align}
\left(  v_{1}\oplus w_{1}\right)  \otimes\left(  v_{2}\oplus w_{2}\right)   &
=\left(
\begin{array}
[c]{cccc}%
v_{11} & v_{12} & w_{11} & w_{12}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cccc}%
v_{21} & v_{22} & w_{21} & w_{22}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{cccc}%
v_{11}v_{21} & v_{11}v_{22} & v_{11}w_{21} & v_{11}w_{22}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cccc}%
v_{12}v_{21} & v_{12}v_{22} & v_{12}w_{21} & v_{12}w_{22}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
w_{11}v_{21} & w_{11}v_{22} & w_{11}w_{21} & w_{11}w_{22}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cccc}%
w_{12}v_{21} & w_{12}v_{22} & w_{12}w_{21} & w_{12}w_{22}%
\end{array}
\right)
\end{array}
\right)
\end{align}%
\begin{align}
\left(  v_{2}\oplus w_{2}\right)  \otimes\left(  v_{1}\oplus w_{1}\right)   &
=\left(
\begin{array}
[c]{cccc}%
v_{21} & v_{22} & w_{21} & w_{22}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cccc}%
v_{11} & v_{12} & w_{11} & w_{12}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{cccc}%
v_{21}v_{11} & v_{21}v_{12} & v_{21}w_{11} & v_{21}w_{12}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cccc}%
v_{22}v_{11} & v_{22}v_{12} & v_{22}w_{11} & v_{22}w_{12}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
w_{21}v_{11} & w_{21}v_{12} & w_{21}w_{11} & w_{21}w_{12}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cccc}%
w_{21}v_{11} & w_{21}v_{12} & w_{21}w_{11} & w_{21}w_{12}%
\end{array}
\right)
\end{array}
\right)
\end{align}%
\begin{gather}
\left(  v_{1}\oplus w_{1}\right)  \wedge\left(  v_{2}\oplus w_{2}\right)
=\frac{1}{2}\left(  \left(  v_{1}\oplus w_{1}\right)  \otimes\left(
v_{2}\oplus w_{2}\right)  \right)  -\left(  \left(  v_{2}\oplus w_{2}\right)
\otimes\left(  v_{1}\oplus w_{1}\right)  \right)  =\\
\frac{1}{2}\left(  \left(
\begin{array}
[c]{cccc}%
v_{11} & v_{12} & w_{11} & w_{12}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cccc}%
v_{21} & v_{22} & w_{21} & w_{22}%
\end{array}
\right)  -\left(
\begin{array}
[c]{cccc}%
v_{21} & v_{22} & w_{21} & w_{22}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cccc}%
v_{11} & v_{12} & w_{11} & w_{12}%
\end{array}
\right)  \right)
\end{gather}%
\begin{equation}
=\frac{1}{2}\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{cccc}%
v_{11}v_{21}-v_{21}v_{11} & v_{11}v_{22}-v_{21}v_{12} & v_{11}w_{21}%
-v_{21}w_{11} & v_{11}w_{22}-v_{21}w_{12}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
v_{12}v_{21}-v_{22}v_{11} & v_{12}v_{22}-v_{22}v_{12} & v_{12}w_{21}%
-v_{22}w_{11} & v_{12}w_{22}-v_{22}w_{12}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
w_{11}v_{21}-w_{21}v_{11} & w_{11}v_{22}-w_{21}v_{12} & w_{11}w_{21}%
-w_{21}w_{11} & w_{11}w_{22}-w_{21}w_{12}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
w_{12}v_{21}-w_{21}v_{11} & w_{12}v_{22}-w_{21}v_{12} & w_{12}w_{21}%
-w_{21}w_{11} & w_{12}w_{22}-w_{21}w_{12}%
\end{array}
\right)
\end{array}
\right)
\end{equation}%
\begin{equation}
=\frac{1}{2}\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{cccc}%
0 & v_{11}v_{22}-v_{21}v_{12} & 0 & v_{11}w_{22}-v_{21}w_{12}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
v_{12}v_{21}-v_{22}v_{11} & 0 & v_{12}w_{21}-v_{22}w_{11} & 0
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
0 & w_{11}v_{22}-w_{21}v_{12} & 0 & w_{11}w_{22}-w_{21}w_{12}%
\end{array}
\right)  ,\\
\left(
\begin{array}
[c]{cccc}%
0 & w_{12}v_{22}-w_{21}v_{12} & w_{12}w_{21}-w_{21}w_{11} & 0
\end{array}
\right)
\end{array}
\right)  .
\end{equation}

\end{enumerate}

In general the exterior algebra of a direct sum
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
is produced by noting that%

\begin{equation}
\left\vert v\right\rangle \widehat{\otimes}_{\mathbb{C}}\left\langle
w\right\vert =\left(  -1\right)  ^{pq}\left\vert w\right\rangle
\widehat{\otimes}_{\mathbb{C}}\left\langle v\right\vert ,
\end{equation}
giving%
\begin{align}
&
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \widehat{\otimes}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{\ H}^{1d}\right) \\
&  =\left[  \mathbb{C}\right]  \ \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \oplus%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \right]  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right]  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \right] \\
&  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \,\widehat{\otimes}\,%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right]  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \,\widehat{\otimes}\,%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right] \\
&  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \,\widehat{\otimes}\,%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right]  \oplus\left[
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \widehat{\otimes}%
%TCIMACRO{\tbigwedge \nolimits^{2}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  \right]  .
\end{align}
as%
\begin{align}
\left\vert v_{1}\right\rangle \widehat{\otimes}_{\mathbb{C}}\left\langle
w_{1}\right\vert  &  =\left(  -1\right)  ^{1}\left\vert w_{1}\right\rangle
\widehat{\otimes}_{\mathbb{C}}\left\langle v_{1}\right\vert =\ \left\vert
w_{1}\right\rangle \widehat{\otimes}_{\mathbb{C}}\left\langle v_{1}\right\vert
\\
\left\vert v_{1}\right\rangle \widehat{\otimes}_{\mathbb{C}}\left\langle
w_{1}\right\vert  &  \rightarrow\left\vert v_{1}\right\rangle \left\langle
w_{1}\right\vert \\
\left(  \left\vert v_{1}\right\rangle \left\langle w_{1}\right\vert \right)
^{\dagger}  &  =-\left\vert v_{1}\right\rangle \left\langle w_{1}\right\vert
\\
\left(  i\left\vert v_{1}\right\rangle \left\langle w_{1}\right\vert \right)
^{\dagger}  &  =\left\vert v_{1}\right\rangle \left\langle w_{1}\right\vert
\end{align}
and%
\begin{equation}
\left\vert v_{1}\right\rangle \widehat{\otimes}_{\mathbb{C}}\left\langle
w_{1}\right\vert =\frac{1}{2}\left(  \left\vert v_{1}\right\rangle
\otimes_{\mathbb{C}}\left\langle w_{1}\right\vert -\ \left\vert w_{1}%
\right\rangle \otimes_{\mathbb{C}}\left\langle v_{1}\right\vert \right)  .
\end{equation}
$\lceil$%
\begin{align}
\left(  \frac{i}{2}\left(  \left\vert v_{1}\right\rangle \otimes_{\mathbb{C}%
}\left\langle w_{1}\right\vert -\ \left\vert w_{1}\right\rangle \otimes
_{\mathbb{C}}\left\langle v_{1}\right\vert \right)  \right)  ^{\dagger}  &
=\frac{i}{2}\left(  \left\vert v_{1}\right\rangle \otimes_{\mathbb{C}%
}\left\langle w_{1}\right\vert -\ \left\vert w_{1}\right\rangle \otimes
_{\mathbb{C}}\left\langle v_{1}\right\vert \right) \\
X  &  =\left(  X+X^{\dagger}\right)  +\left(  X-X^{\dagger}\right)  =A+B,\quad
A=A^{\dagger},B=-B^{\dagger},
\end{align}
$\rfloor$

\begin{enumerate}
\item Is $\mathfrak{sp}$ an exterior algebra homomorphism i.e.
\begin{align}
\mathfrak{sp}\left(  \left(  \left\vert v_{1}\right\rangle \oplus\left\langle
w_{1}\right\vert \right)  \wedge\left(  \left\vert v_{2}\right\rangle
\oplus\left\langle w_{2}\right\vert \right)  \right)   &  =\mathfrak{sp}%
\left(  \left\vert v_{1}\right\rangle \oplus\left\langle w_{1}\right\vert
\right)  \wedge\mathfrak{sp}\left(  \left\vert v_{2}\right\rangle
\oplus\left\langle w_{2}\right\vert \right) \\
&  =\left(  \left\vert v_{1}\right\rangle \otimes\left\langle w_{1}\right\vert
\right)  \wedge\left(  \left\vert v_{2}\right\rangle \otimes\left\langle
w_{2}\right\vert \right)  =\left\vert v_{1}\wedge v_{2}\right\rangle
\otimes\left\langle w_{1}\wedge w_{2}\right\vert
\end{align}%
\begin{align}
\digamma_{\left\vert \varphi\right\rangle }\left(  \sigma_{\varphi}\left(
\left\vert w\right\rangle \right)  \right)   &  =\left\langle w\right\vert \\
\left\vert v\right\rangle \otimes\digamma_{\left\vert \varphi\right\rangle
}\left(  \sigma_{\varphi}\left(  \left\vert w\right\rangle \right)  \right)
&  =\left\vert v\right\rangle \otimes\left\langle w\right\vert \\
\Xi_{\mathcal{H}^{1}\mathcal{H}^{1d}}\left(  \left\vert v\right\rangle
\otimes\digamma_{\left\vert \varphi\right\rangle }\left(  \sigma_{\varphi
}\left(  \left\vert w\right\rangle \right)  \right)  \right)   &  =\left\vert
v\right\rangle \left\langle w\right\vert .
\end{align}

\end{enumerate}

The direct sum $\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{
\mathcal{H}^{1}\right\}  $ is generated by
\begin{equation}
\mathcal{H}^{\oplus1}=\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{z}_{1}\\
\mathbf{z}_{2}%
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
\mathbf{z}_{1}\\
\mathbf{z}_{2}%
\end{array}
\right)  \in\mathbb{C}^{2r}\right\}  ,
\end{equation}
where $\left\{  \mathbf{\varphi}\right\}  $ is a conb for $\mathcal{H}^{1}.$
The unitary representation $\Pi_{\mathcal{F}}$ of $O\left(  2r,\mathbb{R}%
\right)  $ is given by
\begin{equation}
\Pi_{\mathcal{F}}\left(  g\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{z}_{1}\\
\mathbf{z}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{z}_{1}\\
\mathbf{z}_{2}%
\end{array}
\right)  ,
\end{equation}
where%
\begin{equation}
\Pi_{\mathcal{F}}\left(  g\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\psi} & \sigma_{\varphi}\left\{  \mathbf{\psi}\right\}
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \mathcal{R}_{1\varphi}\left(  g\right)
\end{equation}
and
\begin{equation}
\mathcal{R}_{1\varphi}\left(  \Pi_{\mathcal{F}}\left(  g\right)  \right)
=\left(  \mathcal{R}_{1\varphi}\circ\Pi_{\mathcal{F}}\right)  \left(
g\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{U}\left(  g\right)  & \overline{\mathbb{V}}\left(  g\right) \\
\mathbb{V}\left(  g\right)  & \overline{\mathbb{U}}\left(  g\right)
\end{array}
\right)  \in\mathcal{M}\left(  2r,\mathbb{C}\right)  .
\end{equation}
The representation $\Pi_{\mathcal{F}}$ is reducible i.e.%
\begin{equation}
\Pi_{\mathcal{F}}=%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\Pi_{\mathcal{F}_{n}},
\end{equation}
where $\Pi_{\mathcal{F}_{n}}$ is irreducible on $\mathcal{F}_{n}$ for $0\leq
n\leq2r$.

The action of the non singular transformation $\Pi_{\mathcal{F}}\left(
g\right)  $ on basis elements of $\mathcal{H}^{\oplus1}$ adapted to the
decomposition
\begin{equation}
\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}
\end{equation}
is given by
\begin{equation}
\left\vert \psi_{j}\right\rangle =\sum_{1\leq k\leq r}\left\{  \left\vert
\varphi_{k}\right\rangle \mathbb{U}_{kj}+\left\vert \sigma_{\varphi}\left(
\varphi_{k}\right)  \right\rangle \mathbb{V}_{kj}\right\}  .
\end{equation}
Any element $\left\vert \eta\right\rangle $ of $\mathcal{H}^{\oplus1}$ can be
expanded as
\begin{equation}
\left\vert \eta\right\rangle =\sum_{1\leq k\leq r}\left\{  \left\vert \psi
_{k}\right\rangle \eta_{1k}+\left\vert \sigma_{\psi}\left(  \psi_{k}\right)
\right\rangle \eta_{2k}\right\}
\end{equation}
since the transformation $\left(  \mathcal{R}_{1\varphi}\circ\Pi_{\mathcal{F}%
}\right)  \left(  g\right)  $ is unitary.

Hence
\begin{align}
\Phi_{\psi}\left(  \mathbf{\psi}\right)   &  =\mathbf{b}^{\dagger}\\
\Phi_{\psi}\left(  \sigma_{\psi}\left\{  \mathbf{\psi}\right\}  \right)   &
=\mathbf{b}=\Phi_{\psi}\left(  \mathbf{\psi}\right)  ^{\dagger},
\end{align}
where
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \left.  =\right.  \widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)
\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left.  =\right.  \left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathcal{R}_{a}\left(  g\right)  ;\quad g\in O\left(  2r,\mathbb{R}%
\right)
\end{equation}
and
\begin{align}
&  \left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \left.  =\right.  \widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)
\left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  \left.  =\right.  \operatorname*{Adj}\left(  u\left(  g\right)
\right)  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{2}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right) \\
&  \left.  =\right.  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  u\left(  g\right)  \mathbf{\varphi}\right)  & \Phi
_{2}\left(  \sigma_{\varphi}\left\{  u\left(  g\right)  \mathbf{\varphi
}\right\}  \right)
\end{array}
\right) \\
&  \left.  =\right.  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \left.  =\right.  \left[  \Phi_{\varphi1}\oplus_{\mathbb{C}}%
\Phi_{\varphi2}\right]  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right) \\
&  \left.  =\right.  \left(
\begin{array}
[c]{cc}%
\Phi_{\varphi1}\left(  \mathbf{\varphi}\right)  & \Phi_{\varphi2}\left(
\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \left.  =\right.  \left[  \Phi_{\varphi1}\oplus_{\mathbb{C}}%
\Phi_{\varphi2}\right]  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \mathcal{R}_{\varphi}\left(  g\right)  ;\quad g\in O\left(
2r,\mathbb{R}\right)  .
\end{align}


\begin{enumerate}
\item Adjoint representation of $O\left(  2r,\mathbb{R}\right)  $
\begin{align}
&  \widehat{\Pi_{\mathcal{F}}}:O\left(  2r,\mathbb{R}\right)  \rightarrow
\mathcal{B}\left(  \mathcal{F}_{1}\right)  \subset\mathcal{B}\left(
\mathcal{F}\right) \\
\quad\widehat{\Pi_{\mathcal{F}}}\left(  g\right)  \left(  X\right)   &
=\operatorname*{Adj}\left(  \Pi_{\mathcal{F}}\left(  g\right)  \right)
\left(  X\right)  =\Pi_{\mathcal{F}}\left(  g\right)  \left(  X\right)
\Pi_{\mathcal{F}}\left(  g\right)  ^{\dagger}=\widehat{u}\left(  g\right)
\left(  X\right)  =u\left(  g\right)  Xu\left(  g\right)  ^{\dagger}%
\end{align}
formed from the representation $\Pi_{\mathcal{F}}\left\{  O\left(
2r,\mathbb{R}\right)  \right\}  \subset\mathcal{F=B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ that acts in $\mathcal{H}_{\mathcal{F}}$
\begin{align}
&  \Pi_{\mathcal{F}}:O\left(  2r,\mathbb{R}\right)  \rightarrow\mathcal{F}\\
&  \Pi_{\mathcal{F}}\left(  g\right)  =u\left(  g\right)  \in\mathcal{F}.
\end{align}


\item
\begin{align}
\left(  \mathbf{b}^{\dagger}\right)   &  =\widehat{\Pi_{\mathcal{F}}}\left(
g\right)  \left(  \mathbf{a}^{\dagger}\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbb{U}\\
\mathbb{V}%
\end{array}
\right) \\
\left(  \mathbf{b}\right)   &  =\widehat{\Pi_{\mathcal{F}}}\left(  g\right)
\left(  \mathbf{a}\right)  \left.  =\right.  \left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\overline{\mathbb{V}}\\
\overline{\mathbb{U}}%
\end{array}
\right)  .
\end{align}
In particular
\begin{align}
&  b^{\dagger}\left(  \varphi_{j}\right)  =\widehat{\Pi_{\mathcal{F}}}\left(
g\right)  \left(  a^{\dagger}\left(  \varphi_{j}\right)  \right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbb{U}_{j}\\
\mathbb{V}_{j}%
\end{array}
\right)  =\sum_{1\leq k\leq r}\left\{  a_{k}^{\dagger}\mathbb{U}_{kj}%
+a_{k}\mathbb{V}_{kj}\right\} \\
&  =a^{\dagger}\left(  \sum_{1\leq k\leq r}\varphi_{k}\mathbb{U}_{kj}\right)
+a\left(  \sum_{1\leq k\leq r}\sigma_{\varphi}\left(  \varphi_{k}\right)
\mathbb{V}_{kj}\right)  .
\end{align}


\item
\begin{align}
&  \Phi_{\varphi1}\left(  \sum_{1\leq k\leq r}\varphi_{k}\mathbb{U}%
_{kj}\right)  =\sum_{1\leq k\leq r}a_{k}^{\dagger}\mathbb{U}_{kj};\quad
\Phi_{\varphi2}\left(  z\varphi_{k}\right)  =za_{k}^{\dagger};\quad
\Phi_{\varphi1}\left(  \varphi_{k}\right)  =a_{k}^{\dagger}\\
&  \left(  \Phi_{\varphi2}\left(  \sum_{1\leq k\leq r}\sigma_{\psi}\left(
\varphi_{k}\right)  \mathbb{V}_{kj}\right)  \right)  ^{\dagger}=\left(
\left(  \sum_{1\leq k\leq r}\Phi_{\varphi2}\left(  \sigma_{\psi}\left(
\varphi_{k}\right)  \right)  \overline{\mathbb{V}_{kj}}\right)  \right)
^{\dagger}\\
&  =\sum_{1\leq k\leq r}\Phi_{\varphi2}\left(  \sigma_{\psi}\left(
\varphi_{k}\right)  \right)  \mathbb{V}_{kj}=\sum_{1\leq k\leq r}%
a_{k}\mathbb{V}_{kj};\quad\Phi_{\varphi2}\left(  \sigma_{\psi}\left(
\varphi_{k}\right)  \right)  =a_{k}\\
&  \left(  \Phi_{\varphi2}\left(  \overline{\overline{z}}\sigma_{\varphi
}\left(  \varphi_{k}\right)  \right)  \right)  ^{\dagger}=\left(
\overline{\overline{z}}\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(
\varphi_{k}\right)  \right)  \right)  ^{\dagger}=z\Phi_{\varphi2}\left(
\sigma_{\varphi}\left(  \varphi_{k}\right)  \right)  =za_{k}%
\end{align}


\item
\begin{align}
\Phi_{\varphi}  &  =\Phi_{\varphi1}\oplus_{\mathbb{C}}\Phi_{\varphi
2}:\mathcal{H}^{1}\oplus_{\mathbb{C}}\sigma_{\varphi}\left\{  \mathcal{H}%
^{1}\right\}  \rightarrow\mathcal{F}_{1}\\
\left[  \Phi_{\varphi1}\oplus_{\mathbb{C}}\Phi_{\varphi2}\right]  \left(
\begin{array}
[c]{cc}%
\boldsymbol{\varphi} & \sigma_{\varphi}\left\{  \boldsymbol{\varphi}\right\}
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{\varphi} & \sigma_{\varphi}\left\{  \boldsymbol{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{\varphi}\left(  \Phi_{\varphi1}\right)  & \mathbb{O}\\
\mathbb{O} & \mathcal{R}_{\sigma_{\varphi}}\left(  \Phi_{\varphi2}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  .
\end{align}
In particular%
\begin{equation}
\left[  \Phi_{\varphi1}\oplus_{\mathbb{C}}\Phi_{\varphi2}\right]  \left(
\begin{array}
[c]{cc}%
\varphi_{k} & \sigma_{\varphi}\left(  \varphi_{k}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
a_{k}^{\dagger} & a_{k}%
\end{array}
\right)  .
\end{equation}


\item
\begin{align}
\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \varphi_{k}\right)  \right)
&  =a_{k}=\left(  \Phi_{\varphi1}\left(  \varphi_{k}\right)  \right)
^{\dagger}=\left(  a_{k}^{\dagger}\right)  ^{\dagger}\\
\Phi_{\varphi2}\left(  \overline{\overline{z}}\sigma_{\varphi}\left(
\varphi_{k}\right)  \right)   &  =\overline{\overline{z}}a_{k}\\
\Phi_{\varphi2}\left(  \overline{z_{k}}\sigma_{\varphi}\left(  \varphi
_{k}\right)  +\overline{z_{l}}\sigma_{\varphi}\left(  \varphi_{l}\right)
\right)   &  =\overline{\overline{z_{k}}}a_{k}+\overline{\overline{z_{l}}%
}a_{l}\\
\Phi_{\varphi2}\left(  \overline{\overline{z}}\sigma_{\varphi}\left(
\varphi_{k}\right)  \right)  ^{\dagger}  &  =\left(  \overline{\overline{z}%
}a_{k}\right)  ^{\dagger}=za_{k}^{\dagger}=\Phi_{\varphi1}\left(  z\varphi
_{k}\right)
\end{align}


\item
\begin{align}
&  a_{k}^{\dagger}=\Phi_{\varphi1}\left(  \varphi_{k}\right)  ;\quad
\Phi_{\varphi1}\left(  z_{k}\varphi_{k}+z_{l}\varphi_{l}\right)  =z_{k}%
\Phi_{\varphi1}\left(  \varphi_{k}\right)  +z_{l}\Phi_{\varphi1}\left(
\varphi_{l}\right) \\
&  a_{k}=\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \varphi_{k}\right)
\right)  ;\quad\Phi_{\varphi2}\left(  \overline{z_{k}}\sigma_{\varphi}\left(
\varphi_{k}\right)  +\overline{z_{l}}\sigma_{\varphi}\left(  \varphi
_{l}\right)  \right)  =\left(  \Phi_{\varphi1}\left(  z_{k}\varphi_{k}%
+z_{l}\varphi_{l}\right)  \right)  ^{\dagger}\\
&  =\left(  z_{k}\Phi_{\varphi1}\left(  \varphi_{k}\right)  +z_{l}%
\Phi_{\varphi1}\left(  \varphi_{l}\right)  \right)  ^{\dagger}=\overline
{z_{k}}\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \varphi_{k}\right)
\right)  +\overline{z_{l}}\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(
\varphi_{l}\right)  \right) \\
&  \Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \varphi_{k}\right)  \right)
=a_{k}=\Phi_{\varphi1}\left(  \varphi_{k}\right)  ^{\dagger}%
\end{align}


\item
\begin{equation}
\widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)  \left(  \mathbf{a}\right)
=\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\overline{\mathbb{V}}\\
\overline{\mathbb{U}}%
\end{array}
\right)
\end{equation}


\item In particular%
\begin{align}
&  b\left(  \varphi_{j}\right)  =\widehat{\Pi_{\mathcal{F}_{1}}}\left(
g\right)  \left(  a\left(  \sigma_{\varphi}\left(  \varphi_{j}\right)
\right)  \right)  =\widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)  \left(
\Phi_{\varphi2}\left(  \sigma_{\varphi}\left(  \varphi_{j}\right)  \right)
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\overline{\mathbb{V}_{j}}\\
\overline{\mathbb{U}_{j}}%
\end{array}
\right)  =\sum_{1\leq k\leq r}\left\{  a_{k}^{\dagger}\overline{\mathbb{V}%
}_{kj}+a_{k}\overline{\mathbb{U}}_{kj}\right\} \\
&  =\left(  a^{\dagger}\left(  \sum_{1\leq k\leq r}\varphi_{k}\mathbb{U}%
_{kj}\right)  +a\left(  \sum_{1\leq k\leq r}\sigma_{\varphi}\left(
\varphi_{k}\right)  \overline{\mathbb{V}_{kj}}\right)  \right)  ^{\dagger}\\
&  \left.  =\right.  \left(  a^{\dagger}\left(  \sum_{1\leq k\leq r}%
\varphi_{k}\mathbb{U}_{kj}\right)  \right)  ^{\dagger}+\left(  a\left(
\sum_{1\leq k\leq r}\sigma_{\varphi}\left(  \varphi_{k}\right)  \overline
{\mathbb{V}_{kj}}\right)  \right)  ^{\dagger}=a\left(  \sum_{1\leq k\leq
r}\varphi_{k}\mathbb{U}_{kj}\right)  +a^{\dagger}\left(  \sum_{1\leq k\leq
r}\sigma_{\varphi}\left(  \varphi_{k}\right)  \overline{\mathbb{V}_{kj}%
}\right) \\
&  \left.  =\right.  \Phi_{\varphi1}\left(  \sum_{1\leq k\leq r}\varphi
_{k}\overline{\mathbb{V}}_{kj}\right)  +\Phi_{\varphi2}\left(  \sum_{1\leq
k\leq r}\sigma_{\varphi}\left(  \varphi_{k}\right)  \overline{\mathbb{U}}%
_{kj}\right)  =\Phi_{\varphi}\left(  \left(  \sum_{1\leq k\leq r}\varphi
_{k}\overline{\mathbb{V}}_{kj},\sum_{1\leq k\leq r}\sigma_{\varphi}\left(
\varphi_{k}\right)  \overline{\mathbb{U}}_{kj}\right)  \right)
\end{align}
and
\begin{equation}
b^{\dagger}\left(  \varphi_{j}\right)  =\widehat{\Pi_{\mathcal{F}_{1}}}\left(
g\right)  \left(  a^{\dagger}\left(  \varphi_{j}\right)  \right)
=\widehat{\Pi_{\mathcal{F}_{1}}}\left(  g\right)  \left(  \Phi_{\varphi
1}\left(  \varphi_{j}\right)  \right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbb{U}_{j}\\
\mathbb{V}_{j}%
\end{array}
\right)  =\sum_{1\leq k\leq r}\left\{  a_{k}^{\dagger}\mathbb{U}_{kj}%
+a_{k}\mathbb{V}_{kj}\right\}  .
\end{equation}


\item
\begin{align}
\left\vert \psi_{j}\right\rangle  &  =\sum_{1\leq k\leq r}\left\vert
\varphi_{k}\right\rangle \mathbb{U}_{kj}\\
\left\vert \eta_{j}\right\rangle  &  =\sum_{1\leq k\leq r}\left\vert
\sigma_{\varphi}\left(  \varphi_{k}\right)  \right\rangle \overline
{\mathbb{V}_{kj}}%
\end{align}


\item
\begin{align}
&  b\left(  \varphi_{j}\right)  =\widehat{\Pi_{\mathcal{F}_{1}}}\left(
g\right)  \left(  a\left(  \varphi_{j}\right)  \right)  =\widehat{\Pi
_{\mathcal{F}_{1}}}\left(  g\right)  \left(  \Phi_{\varphi2}\left(
\varphi_{j}\right)  \right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\overline{\mathbb{V}_{j}}\\
\overline{\mathbb{U}_{j}}%
\end{array}
\right)  =\sum_{1\leq k\leq r}\left\{  a_{k}^{\dagger}\overline{\mathbb{V}%
}_{kj}+a_{k}\overline{\mathbb{U}}_{kj}\right\}  =b_{j}\\
&  =\left(  a^{\dagger}\left(  \psi_{j}\right)  +a\left(  \eta_{j}\right)
\right)  ^{\dagger}=a\left(  \psi_{j}\right)  +a^{\dagger}\left(  \eta
_{j}\right) \\
&  \left.  =\right.  \left(  a^{\dagger}\left(  \psi_{j}\right)  \right)
^{\dagger}+\left(  a\left(  \eta_{j}\right)  \right)  ^{\dagger}=a\left(
\psi_{j}\right)  +a^{\dagger}\left(  \eta_{j}\right) \\
&  \left.  =\right.  \Phi_{\varphi1}\left(  \sum_{1\leq k\leq r}\varphi
_{k}\overline{\mathbb{V}}_{kj}\right)  +\Phi_{\varphi2}\left(  \sum_{1\leq
k\leq r}\sigma_{\varphi}\left(  \varphi_{k}\right)  \overline{\mathbb{U}}%
_{kj}\right)  =\Phi_{\varphi}\left(  \left(  \sum_{1\leq k\leq r}\varphi
_{k}\overline{\mathbb{V}}_{kj},\sum_{1\leq k\leq r}\sigma_{\varphi}\left(
\varphi_{k}\right)  \overline{\mathbb{U}}_{kj}\right)  \right)  .
\end{align}

\end{enumerate}

\begin{remark}
The complex Hilbert space $\mathcal{H}^{1}$ can be expanded in terms of the
real direct sums
\end{remark}

\begin{enumerate}
\item
\begin{align}
\mathcal{H}_{\varphi}^{\oplus1}  &  =\mathcal{H}^{1}\oplus_{\mathbb{R}%
}i\mathcal{H}^{1}=\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & i\mathbf{\varphi}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \in\mathbb{C}^{2r}\right\} \\
&  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & i\mathbf{\varphi}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  v\right) \\
\mathcal{R}_{\varphi}\left(  w\right)
\end{array}
\right)  \right\vert v,w\in\mathcal{H}^{1}\right\}  .
\end{align}


\item
\begin{align}
\mathcal{H}_{\varphi}^{\oplus1}  &  =\mathcal{H}^{1}\oplus_{\mathbb{R}}%
\sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \in\mathbb{C}^{2r}\right\} \\
&  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\varphi}\left(  v\right) \\
\mathcal{R}_{\sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}  }\left(
w\right)
\end{array}
\right)  \right\vert v,w\in\mathcal{H}^{1}\right\}  .
\end{align}


\item
\begin{align}
\mathcal{H}_{\varphi}^{\oplus1}  &  =\operatorname{Re}_{\varphi}\left(
\mathcal{H}^{1}\right)  \oplus_{\mathbb{R}}\operatorname*{iIm}%
\nolimits_{\varphi}\left\{  \mathcal{H}^{1}\right\}  =\left\{  \left.  \left(
%
\begin{array}
[c]{cc}%
\frac{1}{2}\left(  \mathbf{\varphi}+\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  & \frac{1}{2}\left(  \mathbf{\varphi}-\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \in\mathbb{R}^{2r}\right\} \\
&  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}_{\varphi}\left(  \mathbf{\varphi}\right)  &
i\operatorname{Im}_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \in\mathbb{R}^{2r}\right\} \\
&  =\left\{  \left.  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}_{\varphi}\left(  \mathbf{\varphi}\right)  &
i\operatorname{Im}_{\varphi}\left(  \mathbf{\varphi}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{\operatorname{Re}_{\varphi}\left(  \mathbf{\varphi}\right)
}\left(  v\right) \\
\mathcal{R}_{\operatorname{Im}_{\varphi}\left(  \mathbf{\varphi}\right)
}\left(  v\right)
\end{array}
\right)  \right\vert \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}\\
\mathbf{x}_{2}%
\end{array}
\right)  \in\mathbb{R}^{2r}\right\}  .
\end{align}


\item All conbs $\left\{  \mathbf{\psi}\right\}  $ of $\mathcal{H}^{1}$ are
connected by $u\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(
U\left(  r\right)  \right)  $ by
\begin{equation}
\left\vert \mathbf{\psi}\right\rangle =u\left\vert \mathbf{\varphi
}\right\rangle
\end{equation}
for a fixed basis $\left\{  \mathbf{\varphi}\right\}  .$

\item The real direct sum of the representation $\Pi_{\mathcal{B}\left(
\mathcal{H}^{1}\right)  }\left(  U\left(  r\right)  \right)  $ with
$\Pi_{\mathcal{B}\left(  i\mathcal{H}^{1}\right)  }\left(  U\left(  r\right)
\right)  $ i.e.
\begin{equation}
u\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(  U\left(
r\right)  \right)  \oplus_{\mathbb{R}}\Pi_{\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  }\left(  U\left(  r\right)  \right)
\end{equation}
has the action%
\begin{gather}
u\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & i\mathbf{\varphi}%
\end{array}
\right)  =\left(  u_{1}\oplus_{\mathbb{R}}u_{1}\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & i\mathbf{\varphi}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
u_{1}\mathbf{\varphi} & u_{1}i\mathbf{\varphi}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & i\mathbf{\varphi}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{\varphi}\left(  u_{1}\right)  & \mathbb{O}_{r}\\
\mathbb{O}_{r} & \mathcal{R}_{i\varphi}\left(  u_{1}\right)
\end{array}
\right)  ,\\
u_{1}\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(  U\left(
r\right)  \right)  ,\,\mathcal{R}_{\varphi}\left(  u_{1}\right)  \text{ and
}\mathcal{R}_{i\varphi}\left(  u_{1}\right)  \in\mathcal{M}\left(
r,\mathbb{C}\right)  .
\end{gather}


\item The real direct sum of the representation $\Pi_{\mathcal{B}\left(
\mathcal{H}^{1}\right)  }\left(  U\left(  r\right)  \right)  $ with
$\Pi_{\mathcal{B}\left(  \sigma_{\varphi}\left\{  \mathcal{H}^{1}\right\}
\right)  }\left(  U\left(  r\right)  \right)  $ i.e.
\begin{equation}
u\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(  U\left(
r\right)  \right)  \oplus_{\mathbb{R}}\Pi_{\mathcal{B}\left(  \sigma_{\varphi
}\left\{  \mathcal{H}^{1}\right\}  \right)  }\left(  U\left(  r\right)
\right)
\end{equation}
has the action%
\begin{gather}
u\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  =\left(  u_{1}\oplus_{\mathbb{R}}u_{1}\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
u_{1}\mathbf{\varphi} & u_{1}i\mathbf{\varphi}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\varphi} & \sigma_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{\varphi}\left(  u_{1}\right)  & \mathbb{O}_{r}\\
\mathbb{O}_{r} & \overline{\mathcal{R}_{\varphi}\left(  u_{1}\right)  }%
\end{array}
\right)  ,\\
u_{1}\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(  U\left(
r\right)  \right)  ,\mathcal{R}_{\varphi}\left(  u_{1}\right)  \text{ }%
\in\mathcal{M}\left(  r,\mathbb{C}\right)  .
\end{gather}


\item The real direct sum of the representation $\Pi_{\mathcal{B}\left(
\operatorname{Re}_{\varphi}\left(  \mathcal{H}^{1}\right)  \right)  }\left(
U\left(  r\right)  \right)  $ with $\Pi_{\mathcal{B}\left(
\operatorname*{iIm}\nolimits_{\varphi}\left(  \mathcal{H}^{1}\right)  \right)
}\left(  U\left(  r\right)  \right)  $ i.e.
\begin{equation}
u\in\Pi_{\mathcal{B}\left(  \operatorname{Re}_{\varphi}\left(  \mathcal{H}%
^{1}\right)  \right)  }\left(  U\left(  r\right)  \right)  \oplus_{\mathbb{R}%
}\Pi_{\mathcal{B}\left(  \operatorname*{iIm}\nolimits_{\varphi}\left(
\mathcal{H}^{1}\right)  \right)  }\left(  U\left(  r\right)  \right)
\end{equation}
has the action%
\begin{gather}
u\left(
\begin{array}
[c]{cc}%
\frac{1}{2}\left(  \mathbf{\varphi}+\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  & \frac{1}{2}\left(  \mathbf{\varphi}-\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  =\left(  u_{1}\oplus_{\mathbb{R}}u_{1}\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{2}\left(  \mathbf{\varphi}+\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  & \frac{1}{2}\left(  \mathbf{\varphi}-\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cc}%
\frac{1}{2}\left(  u_{1}\mathbf{\varphi}+\sigma_{\varphi}\left\{
u_{1}\mathbf{\varphi}\right\}  \right)  & \frac{1}{2}\left(  u_{1}%
\mathbf{\varphi}-\sigma_{\varphi}\left\{  u_{1}\mathbf{\varphi}\right\}
\right)
\end{array}
\right) \\
=\left(
\begin{array}
[c]{cc}%
\frac{1}{2}\left(  \mathbf{\varphi}+\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  & \frac{1}{2}\left(  \mathbf{\varphi}-\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u_{1}\right)  \right)  &
-\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u_{1}\right)  \right)
\\
\operatorname{Im}\left(  \mathcal{R}_{\varphi}\left(  u_{1}\right)  \right)  &
\operatorname{Re}\left(  \mathcal{R}_{\varphi}\left(  u_{1}\right)  \right)
\end{array}
\right)  ,\\
u_{1}\in\Pi_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\left(  U\left(
r\right)  \right)  ,\mathcal{R}_{\varphi}\left(  u_{1}\right)  \text{ }%
\in\mathcal{M}\left(  r,\mathbb{C}\right)  .
\end{gather}

\end{enumerate}

\begin{remark}%
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\frac{1}{2}\left(  \mathbf{\varphi}+\sigma_{\varphi}\left\{  \mathbf{\varphi
}\right\}  \right)  & \frac{1}{2}\left(  \mathbf{\varphi}-\sigma_{\varphi
}\left\{  \mathbf{\varphi}\right\}  \right)
\end{array}
\right)  \equiv\left(
\begin{array}
[c]{cc}%
\operatorname{Re}_{\varphi}\left\{  \mathbf{\varphi}\right\}  &
\operatorname*{iIm}\nolimits_{\varphi}\left\{  \mathbf{\varphi}\right\}
\end{array}
\right)  .
\end{equation}

\end{remark}

\section{Clifford Valued Functions}

Nonlinear functions
\begin{equation}
f:\mathcal{F}\longrightarrow\mathcal{F}%
\end{equation}
can be defined on the Clifford algebra e.g. the exponential function
\begin{equation}
\exp\left\{  A\right\}  =\sum_{0\leq n\leq\infty}\frac{1}{n!}A^{n}.
\end{equation}
In the special case when $A$ is a multivector i.e.
\begin{equation}
A=\left\langle A\right\rangle _{n}%
\end{equation}
one can deduce the generalization of Eulers formula
\begin{equation}
\exp\left\{  i\alpha\hat{A}\right\}  =\cos\left(  \alpha\right)  I+\sin\left(
\alpha\right)  \hat{A},
\end{equation}
where
\begin{align}
\alpha &  =\left\Vert A\right\Vert _{HS}=\left\langle \left\langle A^{\dagger
}A\right\rangle \right\rangle _{0}^{\frac{1}{2}}\\
\hat{A}  &  =\frac{A}{\left\Vert A\right\Vert _{HS}}\\
\alpha &  \in\mathbb{R}.
\end{align}
and thus get expressions for $\sin\left\{  \alpha\hat{A}\right\}  $ and
$\cos\left\{  \alpha\hat{A}\right\}  .$

If $A$ is a normal operator i.e.
\begin{equation}
\left[  A,A^{\dagger}\right]  =0
\end{equation}
then one has the spectral decomposition
\begin{equation}
A=%
%TCIMACRO{\tint \nolimits_{\sigma\left(  A\right)  }}%
%BeginExpansion
{\textstyle\int\nolimits_{\sigma\left(  A\right)  }}
%EndExpansion
\alpha dP_{A}\left(  A\right)
\end{equation}
and thus
\begin{equation}
f\left(  A\right)  =%
%TCIMACRO{\tint \nolimits_{\sigma\left(  A\right)  }}%
%BeginExpansion
{\textstyle\int\nolimits_{\sigma\left(  A\right)  }}
%EndExpansion
f\left(  \alpha\right)  dP_{A}\left(  \alpha\right)  .
\end{equation}


$\lceil$For complex numbers
\begin{align}
b^{z}  &  =e^{z\ln\left(  b\right)  },b\geq0\\
x  &  =\ln\left(  b\right) \\
e^{x}  &  =b
\end{align}
A special case is given by
\begin{equation}
2^{i}=e^{i\ln2}.
\end{equation}
$\rfloor$

One can thus consider $A^{i\beta}$ for positive elements $A\ $
\begin{equation}
A^{i\beta}=%
%TCIMACRO{\tint \nolimits_{\sigma\left(  A\right)  }}%
%BeginExpansion
{\textstyle\int\nolimits_{\sigma\left(  A\right)  }}
%EndExpansion
e^{i\beta\ln\left(  \alpha\right)  }dP_{A}\left(  \alpha\right)  ,
\end{equation}
where $\beta\in\mathbb{R},$ which produce unitary elements as
\begin{equation}
AA^{\dagger}=%
%TCIMACRO{\tint \nolimits_{\sigma\left(  A\right)  }}%
%BeginExpansion
{\textstyle\int\nolimits_{\sigma\left(  A\right)  }}
%EndExpansion
e^{i\beta\ln\left(  \alpha\right)  }dP_{A}\left(  \alpha\right)
%TCIMACRO{\tint \nolimits_{\sigma\left(  A\right)  }}%
%BeginExpansion
{\textstyle\int\nolimits_{\sigma\left(  A\right)  }}
%EndExpansion
e^{-i\beta\ln\left(  \alpha\right)  }dP_{A}\left(  \alpha\right)  =%
%TCIMACRO{\tint \nolimits_{\sigma\left(  A\right)  }}%
%BeginExpansion
{\textstyle\int\nolimits_{\sigma\left(  A\right)  }}
%EndExpansion
dP_{A}\left(  \alpha\right)  =I_{\mathcal{A}}.
\end{equation}


\begin{definition}
Modular Transformations
\begin{equation}
\mathfrak{U}\left(  \beta\right)  :\mathcal{P}\left(  \mathcal{F}\right)
\rightarrow U\left(  \mathcal{F}\right)
\end{equation}
given by
\begin{equation}
A^{i\beta}=\exp\left\{  i\beta\ln\left(  A\right)  \right\}  ;\,0\leq
\beta<2\pi.
\end{equation}

\end{definition}

\begin{remark}
$\ln\left(  A\right)  $ can be considered as a Hamiltonian (generator of time
displacements), $\mathfrak{h},$ i.e.%
\begin{equation}
\mathfrak{h}=\ln\left(  A\right)  .
\end{equation}
This construction is significant in the construction of the \emph{Modular
Theory of }$w^{\ast}$-algebras\emph{.}
\end{remark}

\begin{remark}
Are the transformations
\begin{equation}
\mathfrak{U}\left(  \beta\right)  :\mathcal{P}\left(  \mathcal{F}\right)
\rightarrow U\left(  \mathcal{F}\right)
\end{equation}
given by
\begin{equation}
\mathfrak{U}\left(  \beta\right)  \left(  A\right)  =A^{i\beta};\,0\leq
\beta<2\pi
\end{equation}
isomorphisms? I.e. is
\begin{equation}
\mathfrak{U}\left(  \beta\right)  ^{-1}\left(  A^{i\beta}\right)  =A
\end{equation}
well defined (not one to many).
\end{remark}

\begin{remark}%
\begin{equation}
A^{i\beta}=\exp\left\{  i\beta\ln\left(  A\right)  \right\}  =\exp\left\{
i\beta\right\}  +\exp\left\{  \ln\left(  A\right)  \right\}  =e^{i\beta
}I_{\mathcal{F}}+A
\end{equation}%
\begin{equation}
A^{i\beta}-e^{i\beta}I_{\mathcal{F}}=A
\end{equation}%
\begin{equation}
\mathfrak{U}\left(  \beta\right)  ^{-1}\left(  A^{i\beta}\right)  =A^{i\beta
}-e^{i\beta}I_{\mathcal{F}}=A
\end{equation}

\end{remark}

\begin{definition}
Cayley Transformation%
\begin{equation}
U:\mathcal{B}_{sa}\left(  \mathcal{H}\right)  \rightarrow SU\left(
\mathcal{H}\right)
\end{equation}
is given by
\begin{equation}
U\left(  A\right)  =\left(  A-iI\right)  \left(  A+iI\right)  ^{-1}=\left(
A+iI\right)  ^{-1}\left(  A-iI\right)  .
\end{equation}

\end{definition}

\begin{remark}
The inverse of the Cayley transform
\begin{equation}
U^{-1}:SU\left(  \mathcal{H}\right)  \rightarrow\mathcal{B}_{sa}\left(
\mathcal{H}\right)
\end{equation}
is given by
\begin{equation}
U^{-1}\left(  U\left(  A\right)  \right)  =\left(  U\left(  A\right)
-I\right)  \left(  U\left(  A\right)  +I\right)  ^{-1}=\left(  U\left(
A\right)  +I\right)  ^{-1}\left(  U\left(  A\right)  -I\right)
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\det\left\{  U\left(  A\right)  \right\}  =\det\left\{  \left(  A-iI\right)
\left(  A+iI\right)  ^{-1}\right\}  =\det\left\{  \left(  A-iI\right)
\right\}  \det\left\{  \left(  A+iI\right)  ^{-1}\right\}  =1
\end{equation}
hence $U\left(  A\right)  \in SU\left(  \mathcal{H}\right)  .$
\end{remark}

\begin{remark}
For $A=A^{\dagger}$ the unitary transformation $U\left(  A\right)  $
\begin{equation}
U\left(  A\right)  =\left(  A-iI\right)  \left(  A+iI\right)  ^{-1}%
\end{equation}
should be compared to unitary transformation $U_{A}$ generated by the
exponential map i.e.
\begin{equation}
U_{A}=\exp\left\{  iA\right\}
\end{equation}
and to the modular unitary transformation
\begin{equation}
\mathfrak{U}\left(  \beta\right)  \left(  A\right)  =A^{i\beta},
\end{equation}
which are are in general different to each other.
\end{remark}

\begin{theorem}
The \emph{Hille--Yosida} theorem relates the resolvent through a Laplace
transform to an integral over the one-parameter group of transformations
generated by $A$. Thus, for example, if $A$ is a \emph{self adjoint}, then
\begin{equation}
U_{A}(t)=exp(itA)
\end{equation}
is a one-parameter group of unitary operators. The resolvent of $A$ can be
expressed as the Laplace transform%
\begin{equation}
\mathfrak{R}(z;A)=\left(  A-zI\right)  ^{-1}=\int_{0}^{\infty}e^{-zt}%
U_{A}(t)dt=\int_{0}^{\infty}e^{-zt}exp(itA)dt,
\end{equation}
where
\begin{equation}
\left\vert z\right\vert >\left\Vert A\right\Vert .
\end{equation}
This can be generalized to any bounded operator $A$
\begin{equation}
\mathfrak{R}(z;A)=\left(  A-zI\right)  ^{-1}=\int_{0}^{\infty}e^{-zt}%
T_{A}(t)dt=\int_{0}^{\infty}e^{-zt}\exp(tA)dt,
\end{equation}
where
\begin{equation}
\operatorname{Re}\left(  z\right)  >\left\Vert A\right\Vert .
\end{equation}

\end{theorem}

\begin{theorem}
Let $\mathcal{C}$ be a circle of radius $r\left(  \mathcal{C}\right)  >\Vert
A\Vert$ centered at the origin. Then
\begin{equation}
T_{A}(t)=\exp(tA)=\frac{1}{2\pi i}%
%TCIMACRO{\toint \nolimits_{\mathcal{C}}}%
%BeginExpansion
{\textstyle\oint\nolimits_{\mathcal{C}}}
%EndExpansion
e^{t\lambda}\mathfrak{R}(\lambda;A)d\lambda.
\end{equation}

\end{theorem}

\begin{remark}
These theorems can be generalized to unbounded operators.
\end{remark}

\begin{corollary}%
\begin{equation}
\left.  \operatorname{res}\left(  \mathfrak{R}(z;A)\right)  \right\vert
_{z=\lambda}=P_{A}\left(  \lambda\right)  =-\frac{1}{2\pi i}%
%TCIMACRO{\toint \nolimits_{\mathcal{C}_{\lambda}}}%
%BeginExpansion
{\textstyle\oint\nolimits_{\mathcal{C}_{\lambda}}}
%EndExpansion
\mathfrak{R}(\zeta;A)d\zeta=\left\vert \psi_{A}\left(  \lambda\right)
\right\rangle \left\langle \psi_{A}\left(  \lambda\right)  \right\vert ,
\end{equation}
where $\mathcal{C}_{\lambda}$ is a contour in the positive dirction around the
eigenvalue $\U{3bb} .$
\end{corollary}

\section{Groups}

The commutator defines the \emph{Commutator Product}
\begin{equation}
A\times B=\frac{1}{2}\left[  A,B\right]  \,\forall A,B\in\mathcal{F}.
\end{equation}


\emph{Grade Involution} is defined as
\begin{equation}
A_{k}^{\circledast}=\left(  -1\right)  ^{k}A_{k}.
\end{equation}


The \emph{Clifford }group action is defined by \emph{twisted} inner
automorphisms as
\begin{align}
\vartheta\left[  A\right]   &  :\mathcal{F}\longrightarrow\mathcal{F}\\
\vartheta\left[  A\right]  \left(  B\right)   &  =A^{\circledast}BA^{-1}.
\end{align}
The adjoint inner automorphism is defined as
\begin{align}
Ad\left[  A\right]   &  :\mathcal{F}\longrightarrow\mathcal{F}\\
Ad\left[  A\right]  \left(  X\right)   &  =AXA^{-1}.
\end{align}
The mappings $\vartheta$ and $Ad$ are identical on the even subsalgebra
$\mathcal{F}_{e}.$

The twisted map $\vartheta$ is a group homomorphism i.e.
\begin{equation}
\vartheta:G\rightarrow\operatorname*{Inn}\left\{  \mathcal{F}\right\}
\subset\mathcal{B}\left(  \mathcal{F}\right)
\end{equation}
such that
\begin{equation}
\vartheta\left(  g_{1}g_{2}\right)  =\vartheta\left(  g_{1}\right)
\vartheta\left(  g_{2}\right)  ,
\end{equation}
however $Ad$ is \emph{not a group homomorphism} i.e.
\begin{equation}
Ad:G\rightarrow\mathcal{B}\left(  \mathcal{F}\right)
\end{equation}
so that in general
\begin{equation}
Ad\left(  g_{1}g_{2}\right)  \neq Ad\left(  g_{1}\right)  Ad\left(
g_{2}\right)  .
\end{equation}
$\lceil$%
\begin{equation}
Ad\left(  g_{1}\right)  Ad\left(  g_{2}\right)  \left(  X\right)  =Ad\left(
g_{1}\right)  \left(  g_{2}Xg_{2}^{-1}\right)  =g_{1}g_{2}Xg_{2}^{-1}%
g_{1}^{-1}=g_{1}g_{2}X\left(  g_{1}g_{2}\right)  ^{-1}%
\end{equation}
$\rfloor$

The Clifford $\,\equiv\,$Lipschitz group $\mathcal{CG}\left(  \mathcal{F}%
\right)  $ is constituted by twisted inner automorphisms that leave
$\mathcal{F}_{1}$ and thus all $\left\{  \left.  \mathcal{F}_{n}\right\vert
1\leq n\leq2r\right\}  $ invariant to the actions of $\vartheta\left[
A\right]  $ i.e.
\begin{equation}
\left\{  \left.  A\in\mathcal{F}\right\vert \vartheta\left[  A\right]
:\mathcal{F}_{1}\mathcal{\longrightarrow F}_{1}\right\}  .
\end{equation}
One could also consider the more general group $GL\left(  \mathcal{F}\right)
$ whose elements do not in general leave $\mathcal{F}_{1}$ invariant i.e.
\begin{align}
&  \left\{  \left.  A\in\mathcal{F}\right\vert \vartheta\left[  A\right]
:\mathcal{F}_{1}\mathcal{\nrightarrow F}_{1}\right\} \\
&  \left\{  \left.  A\in\mathcal{F}\right\vert Ad\left[  A\right]
:\mathcal{F}_{1}\mathcal{\nrightarrow F}_{1}\right\}  .
\end{align}
and the unitary subgroup $U\left(  \mathcal{F}\right)  $ comprised of the
unitary elements
\begin{equation}
\left\{  \left.  \widehat{u}\in\mathcal{B}\left(  \mathcal{F}\right)
\right\vert \widehat{u}\left(  X\right)  =uXu^{\dagger};u^{\dagger
}u=uu^{\dagger}=I_{\mathcal{F}}\right\}
\end{equation}
and the twisted unitary group
\begin{equation}
\left\{  \left.  \widehat{u}\in\mathcal{B}\left(  \mathcal{F}\right)
\right\vert \widehat{u}\left(  A\right)  =\vartheta\left[  u\right]  \left(
X\right)  ;u^{\dagger}u=uu^{\dagger}=I_{\mathcal{F}}\right\}  .
\end{equation}
$\lceil$%
\begin{equation}
v_{1}v_{2}\left(  v_{1}+v_{3}\right)  \left(  v_{1}v_{2}\right)  ^{-1}=\left(
-v_{2}+v_{1}v_{2}v_{3}\right)  \left(  v_{1}v_{2}\right)  ^{-1}=-v_{2}\left(
v_{1}v_{2}\right)  ^{-1}+v_{1}%
\end{equation}
$\rfloor$

The following important subgroups of the Clifford group are

\subparagraph{Pin}%

\begin{equation}
\operatorname*{Pin}\left(  \mathcal{F}\right)  =\left\{  \left.
A\in\mathcal{CG}\left(  \mathcal{F}\right)  \right\vert \left\Vert
A\right\Vert =1\right\}
\end{equation}


As $g\in\operatorname*{Pin}\left(  \mathcal{F}\right)  \subset\mathcal{CG}%
\left(  \mathcal{F}\right)  ,$ $g$ \emph{can be represented as a versor} i.e.
\begin{equation}
g=v_{1}\cdots v_{k},v_{j}\in\mathcal{F}_{1},0\leq k\leq2r.
\end{equation}


\subparagraph{Spin}%

\begin{equation}
\operatorname*{Spin}\left(  \mathcal{F}\right)  =\left\{  \left.
A\in\operatorname*{Pin}\left(  \mathcal{F}\right)  \right\vert A\in
\mathcal{F}_{even}\right\}
\end{equation}
As $g\in\operatorname*{Spin}\left(  \mathcal{F}\right)  \subset\mathcal{CG}%
\left(  \mathcal{F}\right)  ,$ $g$ can be represented as an even versor i.e.
\begin{equation}
g=v_{1}\cdots v_{k},v_{j}\in\mathcal{F}_{1},k=2l,0\leq l\leq r.
\end{equation}


The Pin group is the double cover of $O(2r,\mathbb{R}),$ while the Spin group
is the double cover of $SO(2r,\mathbb{R}).$

\section{Idempotents}

If an idempotent $p$ is self adjoint
\begin{equation}
p=p^{\dagger}%
\end{equation}
it is positive as
\begin{equation}
p=p^{2}=p^{\dagger}p.
\end{equation}


It is possible to have non self adjoint idempotents (theses are associated
with non orthogonal projectors and nonorthogonal subspace decompositions),
which are non positive.

\subsubsection{Construction of Idempotents from Involutions and Partial
Involutions}

In general if $A$ \emph{is an involution i.e.},
\begin{equation}
A^{2}=I_{\mathcal{F}}=\left(  \left.  A\right\vert A\right)  I_{\mathcal{F}}%
\end{equation}
\emph{then one can form the idempotents }%
\begin{align}
P_{A_{+}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+A\right) \\
P_{A_{-}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}-A\right)
\end{align}
\emph{that are mutually orthogonal and complimentary }
\begin{align}
P_{A_{+}}P_{A_{-}}  &  =0\\
P_{A_{+}}+P_{A_{-}}  &  =I_{\mathcal{F}}.
\end{align}
The difference of the two idempotents $P_{A_{\pm}}$ gives back the original
involution $A$ i.e.
\begin{equation}
P_{A_{+}}-P_{A_{-}}=\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  -\frac{1}%
{2}\left(  I_{\mathcal{F}}-A\right)  =A,
\end{equation}
the sum just gives the identity operator $I_{\mathcal{F}}$. \emph{The
idempotents }$P_{A_{\pm}}$ \emph{are not orthogonal projectors unless the
involutions }$A$ \emph{are self adjoint.}

The preceeding construction can be generalized by considering \emph{partial
involutions, }$A,$ that have the properties
\begin{align}
A^{2}  &  =\mathcal{P}_{A}\\
\mathcal{P}_{A}  &  =\mathcal{P}_{A}^{2}\\
A\mathcal{P}_{A}  &  =\mathcal{P}_{A}A=A
\end{align}
that also produce idempotents $P_{A_{+}}$ and $P_{A_{-}}$ that are defined by%
\begin{align}
P_{A_{+}}  &  =\frac{1}{2}\left(  \mathcal{P}_{A}+A\right) \\
P_{A_{-}}  &  =\frac{1}{2}\left(  \mathcal{P}_{A}-A\right)
\end{align}
and shown to be idempotent by%
\begin{align}
\left(  P_{A_{\pm}}\right)  ^{2}  &  =\left(  \frac{1}{2}\left(
\mathcal{P}_{A}\pm A\right)  \right)  ^{2}=\frac{1}{2}\left(  \mathcal{P}%
_{A}\pm A\right)  \frac{1}{2}\left(  \mathcal{P}_{A}\pm A\right) \\
&  =\frac{1}{4}\left(  \mathcal{P}_{A}^{2}\pm A\mathcal{P}_{A}\pm
\mathcal{P}_{A}A+A^{2}\right)  =\frac{1}{4}\left(  \mathcal{P}_{A}%
\pm2A+\mathcal{P}_{A}\right)  =\frac{1}{2}\left(  \mathcal{P}_{A}\pm A\right)
=P_{A_{\pm}}.
\end{align}
The initial partial idempotent and involution are be recovered by
\begin{align}
\mathcal{P}_{A}  &  =P_{A_{+}}+P_{A_{-}}\\
A  &  =P_{A_{+}}-P_{A_{-}}.
\end{align}
If the \emph{partial involution }$A$\emph{ is self adjoint then it is a
partial isometry} \emph{and the resulting idempotents }$P_{A_{\pm}}$\emph{ are
orthogonal projectors}.

$\lceil$%
\begin{gather}
P_{A_{\pm}}=Q_{A_{\pm}}Q_{A_{\pm}}^{\dagger}=P_{A_{\pm}}^{2}=\frac{1}%
{4}\left(  \mathcal{P}_{A}\pm A\right)  \left(  \mathcal{P}_{A}\pm A\right)
=\frac{1}{2}\left(  P\pm A\right)  =P_{A_{\pm}}\\
Q_{A_{\pm}}Q_{A_{\pm}}^{\dagger}Q_{A_{\pm}}Q_{A_{\pm}}^{\dagger}=Q_{A_{\pm}%
}Q_{A_{\pm}}^{\dagger}%
\end{gather}
$\rfloor$

\subparagraph{Example}

Let
\begin{align}
\left\langle \left.  a\right\vert b\right\rangle  &  =0\\
\left\langle \left.  a\right\vert a\right\rangle  &  =\left\langle \left.
b\right\vert b\right\rangle =1
\end{align}
then a self adjoint partial involution $\mathcal{I}_{ab}$, (therefore a
partial isometry), is given by
\[
\mathcal{I}_{ab}=\left(  \left\vert a\right\rangle \left\langle b\right\vert
+\left\vert b\right\rangle \left\langle a\right\vert \right)
\]
with associated orthogonal projector $\mathcal{P}_{ab}$
\begin{equation}
\mathcal{I}_{ab}^{2}=\mathcal{P}_{ab}=\left\vert a\right\rangle \left\langle
a\right\vert +\left\vert b\right\rangle \left\langle b\right\vert
=\mathcal{P}_{ab}^{2},
\end{equation}
as shown by%
\begin{equation}
\mathcal{P}_{ab}^{2}=\left(  \left\vert a\right\rangle \left\langle
b\right\vert +\left\vert b\right\rangle \left\langle a\right\vert \right)
\left(  \left\vert a\right\rangle \left\langle b\right\vert +\left\vert
b\right\rangle \left\langle a\right\vert \right)  =\left\vert a\right\rangle
\left\langle a\right\vert +\left\vert b\right\rangle \left\langle b\right\vert
=\mathcal{P}_{ab}.
\end{equation}
The inclusion property is shown by
\begin{align}
\mathcal{I}_{ab}\mathcal{P}_{ab}  &  =\left(  \left\vert a\right\rangle
\left\langle b\right\vert +\left\vert b\right\rangle \left\langle a\right\vert
\right)  \left(  \left\vert a\right\rangle \left\langle a\right\vert
+\left\vert b\right\rangle \left\langle b\right\vert \right)  =\left\vert
b\right\rangle \left\langle a\right\vert +\left\vert a\right\rangle
\left\langle b\right\vert =\mathcal{I}_{ab}\\
\mathcal{P}_{ab}\mathcal{I}_{ab}  &  =\left(  \left\vert a\right\rangle
\left\langle a\right\vert +\left\vert b\right\rangle \left\langle b\right\vert
\right)  \left(  \left\vert a\right\rangle \left\langle b\right\vert
+\left\vert b\right\rangle \left\langle a\right\vert \right)  =\left\vert
b\right\rangle \left\langle a\right\vert +\left\vert a\right\rangle
\left\langle b\right\vert =\mathcal{I}_{ab}.
\end{align}
$\lceil$This also shows that
\begin{equation}
\mathcal{I}_{ab}^{3}=\mathcal{I}_{ab}.
\end{equation}
$\rfloor$

The orthogonal projectors $P_{\mathcal{I}_{ab}\pm}$ obtained from the self
adjoint partial involutions $\mathcal{I}_{ab}$ are
\begin{equation}
P_{\mathcal{I}_{ab}\pm}=\frac{1}{2}\left(  \mathcal{P}_{ab}\pm\mathcal{I}%
_{ab}\right)  =\frac{1}{2}\left(  \left\vert a\right\rangle \left\langle
a\right\vert +\left\vert b\right\rangle \left\langle b\right\vert \pm\left(
\left\vert a\right\rangle \left\langle b\right\vert +\left\vert b\right\rangle
\left\langle a\right\vert \right)  \right)  ,
\end{equation}
which is confirmed by%
\begin{align}
P_{\mathcal{I}_{ab}\pm}^{2}=  &  \frac{1}{4}\left(  \left\vert a\right\rangle
\left\langle a\right\vert +\left\vert b\right\rangle \left\langle b\right\vert
\pm\left(  \left\vert a\right\rangle \left\langle b\right\vert +\left\vert
b\right\rangle \left\langle a\right\vert \right)  \right)  ^{2}=\frac{1}%
{4}\left(  \left\vert a\right\rangle \left\langle a\right\vert +\left\vert
b\right\rangle \left\langle b\right\vert \pm\left\vert a\right\rangle
\left\langle b\right\vert \pm\left\vert b\right\rangle \left\langle
a\right\vert \right)  \left(  \left\vert a\right\rangle \left\langle
a\right\vert +\left\vert b\right\rangle \left\langle b\right\vert
\pm\left\vert a\right\rangle \left\langle b\right\vert \pm\left\vert
b\right\rangle \left\langle a\right\vert \right) \\
&  =\frac{1}{2}\left(  \left\vert a\right\rangle \left\langle a\right\vert
\pm\left\vert b\right\rangle \left\langle a\right\vert \right)  +\frac{1}%
{2}\left(  \left\vert b\right\rangle \left\langle b\right\vert \pm\left\vert
a\right\rangle \left\langle b\right\vert \right)  =\frac{1}{2}\left(
\left\vert a\right\rangle \left\langle a\right\vert +\left\vert b\right\rangle
\left\langle b\right\vert \pm\left\vert a\right\rangle \left\langle
b\right\vert \pm\left\vert b\right\rangle \left\langle a\right\vert \right)
=P_{\mathcal{I}_{ab}\pm}.
\end{align}
$\lceil$%
\begin{equation}
\left(  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
1 & \pm1\\
\pm1 & 1
\end{array}
\right)  \right)  ^{2}=\frac{1}{4}\left(
\begin{array}
[c]{cc}%
1 & \pm1\\
\pm1 & 1
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & \pm1\\
\pm1 & 1
\end{array}
\right)  =\frac{1}{4}\left(
\begin{array}
[c]{cc}%
2 & \pm2\\
\pm2 & 2
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
1 & \pm1\\
\pm1 & 1
\end{array}
\right)  .
\end{equation}
$\rfloor$

One can observe from the example that if $\left\{  \left\vert a\right\rangle
,\left\vert b\right\rangle ,\left\vert c\right\rangle ,\left\vert
d\right\rangle \right\}  $ are orthonormal then the partial
involutions/partial isometries
\begin{equation}
\mathcal{I}_{ab}=\left(  \left\vert a\right\rangle \left\langle b\right\vert
+\left\vert b\right\rangle \left\langle a\right\vert \right)
\,\&\,\mathcal{I}_{cd}=\,\left(  \left\vert c\right\rangle \left\langle
d\right\vert +\left\vert d\right\rangle \left\langle c\right\vert \right)
\end{equation}
produce orthogonal projectors, $P_{\mathcal{I}_{ab}\pm},P_{\mathcal{I}_{cd}%
\pm}$ that are orthogonal to each other, thus can be added together to form a
third projector i.e.
\begin{align}
P_{\mathcal{I}_{abcd}\pm}  &  =P_{\mathcal{I}_{ab}\pm}+P_{\mathcal{I}_{cd}\pm
}\\
P_{\mathcal{I}_{abcd}\pm}^{2}  &  =P_{\mathcal{I}_{abcd}\pm}.
\end{align}


\subparagraph{Schur Decomposition}

Let $A$ be a matrix then the \emph{Schur decomposition}, (which is not unique)
is given by%

\begin{equation}
A=U\Delta U^{\dagger},
\end{equation}
where $U$ is unitary and $\Delta$ is an upper triangular matrix, since
$\sigma\left(  A\right)  =\sigma\left(  \Delta\right)  $ and $\Delta$ is upper
triangular the eigenvalues of $A$ are the diagonal elements of $\Delta$ ($A$
is similar to $\Delta).$The upper triangular matrix can be decomposed as
\begin{equation}
\Delta=\Delta_{d}+\Delta_{u},
\end{equation}
where $\Delta_{d}$ is the diagonal and $\Delta_{u}$ is strictly upper
triangular. $\Delta_{u}$ is nilpotent.

\begin{theorem}
Ringrose: For a compact operator, $A,$ there is a maximal nest of
$A$-invariant projections $P_{\lambda}$, $\U{3bb} \in\lbrack0,1]$ and $A=N+Q,$
where $N$ is a normal operator and belongs to the algebra generated by this
nest. $Q$ is upper triangular with respect to this nest and which is a
quasinilpotent, ($\sigma(Q)=\{0\}$), compact operator.
\end{theorem}

\begin{remark}%
\begin{equation}
A^{\dagger}A=U\Delta^{\dagger}U^{\dagger}U\Delta U^{\dagger}=U\Delta^{\dagger
}\Delta U^{\dagger}%
\end{equation}
and%
\begin{equation}
\Delta^{\dagger}\Delta=\left(  \Delta_{d}^{\dagger}+\Delta_{u}^{\dagger
}\right)  \left(  \Delta_{d}+\Delta_{u}\right)  =\Delta_{d}^{\dagger}%
\Delta_{d}+\Delta_{d}^{\dagger}\Delta_{u}+\Delta_{u}^{\dagger}\Delta
_{d}+\Delta_{u}^{\dagger}\Delta_{u}.
\end{equation}

\end{remark}

\begin{example}
\bigskip Let%
\begin{align}
\Delta_{u}  &  =\left(
\begin{array}
[c]{ccc}%
0 & a & b\\
0 & 0 & c\\
0 & 0 & 0
\end{array}
\right) \\
\Delta_{d}  &  =\left(
\begin{array}
[c]{ccc}%
\alpha_{1} & 0 & 0\\
0 & \alpha_{2} & 0\\
0 & 0 & \alpha_{3}%
\end{array}
\right)
\end{align}
then
\end{example}

\begin{enumerate}
\item
\begin{align}
\Delta_{u}^{2}  &  =\left(
\begin{array}
[c]{ccc}%
0 & a & b\\
0 & 0 & c\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
0 & a & b\\
0 & 0 & c\\
0 & 0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
0 & 0 & ac\\
0 & 0 & 0\\
0 & 0 & 0
\end{array}
\right) \\
\Delta_{u}^{3}  &  =\left(
\begin{array}
[c]{ccc}%
0 & 0 & ac\\
0 & 0 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
0 & a & b\\
0 & 0 & c\\
0 & 0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
0 & 0 & 0\\
0 & 0 & 0\\
0 & 0 & 0
\end{array}
\right)  =0
\end{align}


\item
\begin{equation}
\Delta_{d}^{\dagger}\Delta_{d}=\left(
\begin{array}
[c]{ccc}%
\overline{\alpha}_{1} & 0 & 0\\
0 & \overline{\alpha}_{2} & 0\\
0 & 0 & \overline{\alpha}_{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\alpha_{1} & 0 & 0\\
0 & \alpha_{2} & 0\\
0 & 0 & \alpha_{3}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left\vert \alpha_{1}\right\vert ^{2} & 0 & 0\\
0 & \left\vert \alpha_{2}\right\vert ^{2} & 0\\
0 & 0 & \left\vert \alpha_{3}\right\vert ^{2}%
\end{array}
\right)
\end{equation}


\item
\begin{equation}
\Delta_{u}^{\dagger}\Delta_{u}=\left(
\begin{array}
[c]{ccc}%
0 & 0 & 0\\
\overline{a} & 0 & 0\\
\overline{b} & \overline{c} & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
0 & a & b\\
0 & 0 & c\\
0 & 0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
0 & 0 & 0\\
0 & \left\vert \alpha\right\vert ^{2} & \overline{a}c\\
0 & \overline{b}a & \left\vert b\right\vert ^{2}+\left\vert c\right\vert ^{2}%
\end{array}
\right)
\end{equation}


\item
\begin{align}
\Delta_{u}^{\dagger}\Delta_{d}  &  =\left(
\begin{array}
[c]{ccc}%
0 & 0 & 0\\
\overline{a} & 0 & 0\\
\overline{b} & \overline{c} & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\alpha_{1} & 0 & 0\\
0 & \alpha_{2} & 0\\
0 & 0 & \alpha_{3}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
0 & 0 & 0\\
\overline{a}\alpha_{1} & 0 & 0\\
\overline{b}\alpha_{1} & \overline{c}\alpha_{2} & 0
\end{array}
\right) \\
\Delta_{d}^{\dagger}\Delta_{u}  &  =\left(
\begin{array}
[c]{ccc}%
0 & \overline{\alpha}_{1}a & \overline{\alpha}_{1}b\\
0 & 0 & \overline{\alpha}_{2}c\\
0 & 0 & 0
\end{array}
\right)
\end{align}


\item
\begin{equation}
\Delta^{\dagger}\Delta=\left(
\begin{array}
[c]{ccc}%
\overline{\alpha}_{1} & 0 & 0\\
\overline{a} & \overline{\alpha}_{2} & 0\\
\overline{b} & \overline{c} & \overline{\alpha}_{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\alpha_{1} & a & b\\
0 & \alpha_{2} & c\\
0 & 0 & \alpha_{3}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left\vert \alpha_{1}\right\vert ^{2} & \overline{\alpha}_{1}a &
\overline{\alpha}_{1}b\\
\overline{a}\alpha_{1} & \left\vert a\right\vert ^{2}+\left\vert \alpha
_{2}\right\vert ^{2} & \overline{a}b+\overline{\alpha}_{2}c\\
\overline{b}\alpha_{1} & \overline{b}a+\overline{c}\alpha_{2} & \left\vert
b\right\vert ^{2}+\left\vert c\right\vert ^{2}+\left\vert \alpha
_{3}\right\vert ^{2}%
\end{array}
\right)
\end{equation}

\end{enumerate}

\subsection{Partial Isometries and Singular Valued Decomposition (SVD)}

Any compact operator, $A\in\mathcal{B}_{0}\left(  \mathcal{H}\right)  $,
acting in a Hilbert space $\mathcal{H}$ has a discrete spectrum,
$\sigma\left(  A\right)  =\left\{  \left.  \lambda_{j}\right\vert \lambda
_{j}\in\mathbb{C},1\leq j\leq r\right\}  .$

\begin{remark}
Non compact operators can also have completely discrete spectrum as well e.g.
the identity operator.
\end{remark}

Let the range of $A\ $(not neccesarily compact) be given by
\begin{equation}
\operatorname{Ran}\left\{  A\right\}  =\left\{  \left.  \left\vert
f_{j}\right\rangle \right\vert 1\leq j\leq\kappa\right\}  ,
\end{equation}
and the kernal by
\begin{equation}
\operatorname{Ker}\left\{  A\right\}  =\left\{  \left.  \left\vert
e_{j}\right\rangle \right\vert \kappa+1\leq j\leq r\right\}  ,
\end{equation}
where
\begin{align}
\kappa &  =\dim\left\{  \operatorname{Ran}\left\{  A\right\}  \right\} \\
r-\kappa &  =\dim\left\{  \ker\left\{  A\right\}  \right\}  .
\end{align}
The relationship between the range and kernal of $A$ is given by
\begin{equation}
\operatorname{Ran}\left\{  A\right\}  =\left\{  \left.  \left\vert
f_{j}\right\rangle \right\vert 1\leq j\leq\kappa\right\}  \cong%
\operatorname{Ker}\left\{  A\right\}  ^{\bot}=\operatorname*{linspan}\left\{
\left.  \left\vert e_{j}\right\rangle \right\vert 1\leq j\leq\kappa\right\}
\end{equation}
and $A$ is injective from $\operatorname{Ker}\left\{  A\right\}  ^{\bot}$ to
$\operatorname{Ran}\left\{  A\right\}  ,$ \emph{however} \emph{it should be
noted that in general} $\operatorname{Ker}\left\{  A\right\}  ^{\bot}%
\neq\operatorname{Ran}\left\{  A\right\}  $ as they could be in different
spaces$.$

$\lceil$%
\begin{equation}
\left\langle \left.  f_{j}\right\vert Ae_{k}\right\rangle =0;f_{j}%
\in\operatorname{Ran}\left\{  A\right\}  ^{\bot}\cong\operatorname{Ker}%
\left\{  A\right\}
\end{equation}
$\rfloor$

A Hilbert space $\mathcal{H}$ can be decomposed into the direct sums
\begin{equation}
\mathcal{H}=\operatorname{Ker}\left\{  A\right\}  \oplus\operatorname{Ker}%
\left\{  A\right\}  ^{\bot}=\operatorname{Ran}\left\{  A\right\}  ^{\bot
}\oplus\operatorname{Ran}\left\{  A\right\}  ,
\end{equation}
where
\begin{equation}
\left(  \operatorname{Ker}\left\{  A\right\}  ^{\bot}\cong\operatorname{Ran}%
\left\{  A\right\}  \right)  \equiv\left(  \operatorname*{linspan}\left\{
\left.  \left\vert e_{j}\right\rangle \right\vert 1\leq j\leq\kappa\right\}
\cong\operatorname*{linspan}\left\{  \left.  \left\vert f_{j}\right\rangle
\right\vert 1\leq j\leq\kappa\right\}  \right)  ,
\end{equation}
and%
\begin{equation}
\left(  \operatorname{Ker}\left\{  A\right\}  \cong\operatorname{Ran}\left\{
A\right\}  ^{\bot}\right)  \equiv\left(  \operatorname*{linspan}\left\{
\left.  \left\vert e_{j}\right\rangle \right\vert \kappa+1\leq j\leq
r\right\}  \cong\operatorname*{linspan}\left\{  \left.  \left\vert
f_{j}\right\rangle \right\vert \kappa+1\leq j\leq r\right\}  \right)  .
\end{equation}


\begin{theorem}
Any compact operator $A\in\mathcal{B}_{0}\left(  \mathcal{H}\right)  $ can be
factored into a \emph{Singular Valued Decomposition (SVD)} as
\begin{equation}
A=\left\vert \mathbf{f}\right\rangle \mathbb{A}_{d}\left\langle \mathbf{e}%
\right\vert =\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle \left\vert
\alpha_{j}\right\vert \left\langle e_{j}\right\vert ,
\end{equation}
where $\left\vert \mathbf{e}\right\rangle $ and $\left\vert \mathbf{f}%
\right\rangle $ are conb's of $\mathcal{H}$ and $\left\{  \left.  \left\vert
\alpha_{j}\right\vert \right\vert \alpha_{j}^{2}\in\sigma\left(  A^{\dagger
}A\right)  \equiv\operatorname*{Spec}\left(  A^{\dagger}A\right)  ,1\leq j\leq
r\right\}  $ are the singular values of $A.$
\end{theorem}

\begin{remark}
$\sigma\left(  A^{\dagger}A\right)  $ $\subset\mathbb{R}_{+}$ is the spectrum
of $A^{\dagger}A.$
\end{remark}

\begin{corollary}
One can see that this is the standard matrix SVD by observing%
\begin{equation}
A=U\left\vert \mathbf{\varsigma}\right\rangle \mathbb{A}_{d}\left\langle
\mathbf{\varsigma}\right\vert V=\left\vert \mathbf{\varsigma}\right\rangle
\mathcal{R\varsigma}\left(  U\right)  \mathbb{A}_{d}\mathcal{R\varsigma
}\left(  V\right)  ^{\dagger}\left\langle \mathbf{\varsigma}\right\vert
=\left\vert \mathbf{\varsigma}\right\rangle \mathbb{UA}_{d}\mathbb{V}%
^{\dagger}\left\langle \mathbf{\varsigma}\right\vert =\left\vert
\mathbf{\varsigma}\right\rangle \mathcal{R\varsigma}\left(  A\right)
\left\langle \mathbf{\varsigma}\right\vert ,
\end{equation}
where $\left\vert \mathbf{\varsigma}\right\rangle $ is any conb of
$\mathcal{H},$ where
\begin{equation}
\mathbb{U}=\left\langle \left.  \mathbf{\varsigma}\right\vert \mathbf{f}%
\right\rangle
\end{equation}
and
\begin{equation}
\mathbb{V}=\left\langle \left.  \mathbf{\varsigma}\right\vert \mathbf{e}%
\right\rangle .
\end{equation}

\end{corollary}

\begin{proof}
Using the resolution of the identity $\left\vert \mathbf{\varsigma
}\right\rangle \left\langle \mathbf{\varsigma}\right\vert $ one obtains
\begin{equation}
A=\left\vert \mathbf{\varsigma}\right\rangle \left\langle \mathbf{\varsigma
}\right\vert A\left\vert \mathbf{\varsigma}\right\rangle \left\langle
\mathbf{\varsigma}\right\vert =\left\vert \mathbf{\varsigma}\right\rangle
\left\langle \mathbf{\varsigma}\right\vert U\left\vert \mathbf{\varsigma
}\right\rangle \left\langle \mathbf{\varsigma}\right\vert \mathbb{A}%
_{d}\left\vert \mathbf{\varsigma}\right\rangle \left\langle \mathbf{\varsigma
}\right\vert V\left\vert \mathbf{\varsigma}\right\rangle \left\langle
\mathbf{\varsigma}\right\vert =\left\vert \mathbf{\varsigma}\right\rangle
\mathcal{R\varsigma}\left(  U\right)  \mathbb{A}_{d}\mathcal{R\varsigma
}\left(  V\right)  \left\langle \mathbf{\varsigma}\right\vert
\end{equation}
that produces the matrix represntations
\begin{equation}
A\left\vert \mathbf{\varsigma}\right\rangle =\left\vert \mathbf{\varsigma
}\right\rangle \mathcal{R\varsigma}\left(  U\right)  \mathbb{A}_{d}%
\mathcal{R\varsigma}\left(  V\right)  \left\langle \mathbf{\varsigma
}\right\vert \left\vert \mathbf{\varsigma}\right\rangle =\left\vert
\mathbf{\varsigma}\right\rangle \mathcal{R\varsigma}\left(  U\right)
\mathbb{A}_{d}\mathcal{R\varsigma}\left(  V\right)  =\left\vert
\mathbf{\varsigma}\right\rangle \mathcal{R\varsigma}\left(  A\right)  .
\end{equation}

\end{proof}

\begin{corollary}
A special case of the SVD is the spectral theorem for positive operators
$A\in\mathcal{B}_{0}\left(  \mathcal{H}\right)  $ i.e.%
\begin{equation}
A=\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \alpha_{j}\left\langle
e_{j}\right\vert ,
\end{equation}
where $\left\vert \mathbf{e}\right\rangle $ is a conb formed by the
eigenvectors of $A\ $and $\alpha_{j}\in\sigma\left(  A\right)  ,\,1\leq j\leq
r\subset\mathbb{R}_{+}.$
\end{corollary}

\begin{remark}
If $A$ is invertible (thus in infinite dimensions it is not compact)
\begin{equation}
A^{-1}=\left\vert \mathbf{e}\right\rangle \mathbb{A}_{d}^{-1}\left\langle
\mathbf{f}\right\vert =\sum_{1\leq j\leq r}\left\vert \alpha_{j}\right\vert
^{-1}\left\vert e_{j}\right\rangle \left\langle f_{j}\right\vert .
\end{equation}

\end{remark}

\begin{remark}
This theorem is also valid even if $A$ cannot be diagonalized and only be
brought to Jordan Canonical Form.
\end{remark}

One can consider the positive operator $\left\vert A\right\vert ^{2}%
=A^{\dagger}A,$ and its unique square root $\left\vert A\right\vert =\left(
A^{\dagger}A\right)  ^{\frac{1}{2}},$ which have eigenvalues $\left\{  \left.
\alpha_{j}^{2}\right\vert \alpha_{j}\geq0\in\mathbb{R},1\leq j\leq r\right\}
$ and $\left\{  \left.  \overset{}{\left\vert \alpha_{j}\right\vert
}\right\vert \left\vert \alpha_{j}\right\vert \geq0\in\mathbb{R}^{+},1\leq
j\leq r\right\}  $ respectively associated with orthonormal eigenvectors,
$\left\{  \left\vert \mathbf{e}\right\rangle \right\}  ,$ leading to the
expansions
\begin{align}
\left\vert A\right\vert ^{2}  &  =A^{\dagger}A=\sum_{1\leq j\leq r}\alpha
_{j}^{2}\left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert
=\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(  A^{\dagger
}A\right)  \left\langle \mathbf{e}\right\vert \\
\left\vert A\right\vert  &  =\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}%
=\sum_{1\leq j\leq r}\alpha_{j}\left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
\left(  A^{\dagger}A\right)  ^{\frac{1}{2}}\right)  \left\langle
\mathbf{e}\right\vert .
\end{align}
The eigenvalues of $\left\vert A\right\vert $ are called the \emph{singular
values} of $A.$

One has the following identities between the matrix representations,
$\mathcal{R}_{e}\left(  A\right)  ,\mathcal{R}_{f}\left(  A\right)  ,$ and the
SVD of $A$ $.$%
\begin{equation}
A=\left\vert \mathbf{f}\right\rangle \mathbb{A}_{d}\left\langle \mathbf{e}%
\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
A\right)  \left\langle \mathbf{e}\right\vert =\left\vert \mathbf{f}%
\right\rangle \mathcal{R}_{f}\left(  A\right)  \left\langle \mathbf{f}%
\right\vert ,
\end{equation}
where
\begin{equation}
\mathbb{A}_{d}=\left(
\begin{array}
[c]{cccc}%
\left\vert \alpha_{1}\right\vert  & 0 & \cdots & 0\\
0 & \ddots & \ddots & \vdots\\
\vdots & \ddots & \ddots & 0\\
0 & \cdots & 0 & \left\vert \alpha_{r}\right\vert
\end{array}
\right)  ,
\end{equation}
however one should note that the matrices $\mathcal{R}_{e}\left(  A\right)
,\mathcal{R}_{f}\left(  A\right)  $ \emph{might not be diagonalizable and only
be able to be brought to Jordan canonical form}.

\begin{remark}%
\begin{align}
A^{\dagger}A  &  =\left(  \left\vert \mathbf{f}\right\rangle \mathbb{A}%
_{d}\left\langle \mathbf{e}\right\vert \right)  ^{\dagger}\left(  \left\vert
\mathbf{f}\right\rangle \mathbb{A}_{d}\left\langle \mathbf{e}\right\vert
\right)  =\left\vert \mathbf{e}\right\rangle \mathbb{A}_{d}\left\langle
\mathbf{f}\right\vert \left\vert \mathbf{f}\right\rangle \mathbb{A}%
_{d}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\mathbb{A}_{d}^{2}\left\langle \mathbf{e}\right\vert =\sum_{1\leq j\leq
r}\alpha_{j}^{2}\left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert \\
AA^{\dagger}  &  =\left(  \left\vert \mathbf{f}\right\rangle \mathbb{A}%
_{d}\left\langle \mathbf{e}\right\vert \right)  \left(  \left\vert
\mathbf{f}\right\rangle \mathbb{A}_{d}\left\langle \mathbf{e}\right\vert
\right)  ^{\dagger}=\left\vert \mathbf{f}\right\rangle \mathbb{A}%
_{d}\left\langle \mathbf{e}\right\vert \left\vert \mathbf{e}\right\rangle
\mathbb{A}_{d}\left\langle \mathbf{f}\right\vert =\left\vert \mathbf{f}%
\right\rangle \mathbb{A}_{d}^{2}\left\langle \mathbf{f}\right\vert
=\sum_{1\leq j\leq r}\alpha_{j}^{2}\left\vert f_{j}\right\rangle \left\langle
f_{j}\right\vert
\end{align}

\end{remark}

The two orthonormal bases $\left\{  \left\vert \mathbf{e}\right\rangle
,\left\vert \mathbf{f}\right\rangle \right\}  $ are related by unitary
transformations
\begin{align}
U_{ef}\left\vert \mathbf{f}\right\rangle  &  =\left\vert \mathbf{e}%
\right\rangle =U_{fe}^{\dagger}\left\vert \mathbf{f}\right\rangle \\
U_{ef}^{\dagger}\left\vert \mathbf{e}\right\rangle  &  =\left\vert
\mathbf{f}\right\rangle =U_{fe}\left\vert \mathbf{e}\right\rangle ,
\end{align}
where the unitary operators are sums of partial isometries i.e.
\begin{align}
U_{ef}  &  =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle
f_{j}\right\vert =U_{fe}^{\dagger}\\
U_{fe}  &  =\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle \left\langle
e_{j}\right\vert =U_{ef}^{\dagger}.
\end{align}


\begin{proposition}
All unitary transformations can be expressed in this fashion
\end{proposition}

\begin{proof}%
\begin{equation}
\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle f_{j}%
\right\vert =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle \left\langle
Ug_{j}\right\vert =\sum_{1\leq j\leq r}\left\vert \overset{\overset{}{}%
}{e_{j}}\right\rangle \left\langle \sum_{1\leq j\leq r}U_{jk}g_{k}\right\vert
=\sum_{1\leq k\leq r}\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle
\overline{U}_{jk}\left\langle g_{k}\right\vert =\sum_{1\leq k\leq r}\left\vert
h_{k}\right\rangle \left\langle g_{k}\right\vert .
\end{equation}

\end{proof}

Using the singular values of $A$ one has the following expansions
\begin{equation}
A^{\dagger}A=\left\vert \mathbf{e}\right\rangle \mathbb{A}_{d}\left\langle
\mathbf{f}\right\vert \left\vert \mathbf{f}\right\rangle \mathbb{A}%
_{d}\left\langle \mathbf{e}\right\vert =\left\vert \mathbf{e}\right\rangle
\mathbb{A}_{d}^{2}\left\langle \mathbf{e}\right\vert =\sum_{1\leq j\leq
r}\left\vert \alpha_{j}\right\vert ^{2}\left\vert e_{j}\right\rangle
\left\langle e_{j}\right\vert =\sum_{1\leq j\leq r}\left\vert e_{j}%
\right\rangle \mathcal{R}_{e}\left(  A^{\dagger}A\right)  _{jj}\left\langle
e_{j}\right\vert =\left\vert \mathbf{e}\right\rangle \mathcal{R}_{e}\left(
A^{\dagger}A\right)  \left\langle \mathbf{e}\right\vert .
\end{equation}


If $A$ has zero eigenvalues and thus zero singular values the kernal of $A$,
$\ker\left\{  A\right\}  $ and the kernal of $\left\vert A\right\vert ^{2},$
$\operatorname{Ker}\left\{  A^{\dagger}A\right\}  ,$ is non trivial and is
given by
\begin{equation}
\operatorname{Ker}\left\{  A\right\}  =\operatorname{Ker}\left\{  A^{\dagger
}A\right\}  =\left\{  \left.  \left\vert e_{j}\right\rangle \right\vert
\kappa+1\leq j\leq r\right\}
\end{equation}
and $A$ can be expanded as
\begin{equation}
A=\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert .
\end{equation}


The SVD of $A$ gives rise to the \emph{polar decomposition of }$A$ by
observing
\begin{equation}
A=\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert =\sum_{1\leq j\leq\kappa
}\left\vert f_{j}\right\rangle \left\langle e_{j}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert \alpha_{k}\right\vert \left\vert e_{k}\right\rangle
\left\langle e_{k}\right\vert
\end{equation}
i.e.
\begin{equation}
A=\mathcal{I}_{fe}\left\vert A\right\vert ,
\end{equation}
where $\mathcal{I}_{fe}$ is the partial isometry
\begin{equation}
\mathcal{I}_{fe}=\sum_{1\leq j\leq\kappa}\left\vert f_{j}\right\rangle
\left\langle e_{j}\right\vert ,
\end{equation}
$\lceil$%
\begin{align}
\operatorname{Ker}\left\{  \mathcal{I}_{fe}\right\}   &
=\operatorname*{linspan}\left\{  \left.  \left\vert e_{j}\right\rangle
\right\vert \kappa+1\leq j\leq r\right\} \\
\operatorname{Ker}\left\{  \mathcal{I}_{fe}\right\}  ^{\bot}  &
=\operatorname*{linspan}\left\{  \left.  \left\vert f_{j}\right\rangle
\right\vert 1\leq j\leq\kappa\right\}  \equiv\text{Initial Space of
}\mathcal{I}_{fe}\\
\operatorname{Ran}\left\{  \mathcal{I}_{fe}\right\}   &  =\mathcal{I}%
_{fe}\operatorname{Ker}\left\{  \mathcal{I}_{ef}\right\}  ^{\bot}%
\equiv\text{Final Space of }\mathcal{I}_{fe}\\
\mathcal{I}_{fe}\mathcal{I}_{fe}^{\dagger}  &  =\sum_{1\leq j\leq\kappa
}\left\vert f_{j}\right\rangle \left\langle f_{j}\right\vert
=P_{\operatorname{Ran}\left\{  \mathcal{I}_{fe}\right\}  }\equiv
\text{Projector onto the Final Space of }\mathcal{I}_{fe}\\
\mathcal{I}_{fe}^{\dagger}\mathcal{I}_{fe}  &  =\sum_{1\leq j\leq\kappa
}\left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert
=P_{\operatorname{Ker}\left\{  \mathcal{I}_{fe}\right\}  ^{\bot}}%
\equiv\text{Projector onto the Initial Space of }\mathcal{I}_{fe}%
\end{align}
$\rfloor$

that maps the final space to the initial space and has the properties
\begin{align}
\mathcal{I}_{fe}^{\dagger}\mathcal{I}_{fe}  &  =\sum_{1\leq j\leq\kappa
}\left\vert e_{k}\right\rangle \left\langle f_{k}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert f_{j}\right\rangle \left\langle e_{j}\right\vert
=\sum_{1\leq j\leq\kappa}\left\vert e_{j}\right\rangle \left\langle
e_{j}\right\vert =P_{\operatorname{Ker}\left\{  A\right\}  ^{\bot}}\\
\mathcal{I}_{fe}\mathcal{I}_{fe}^{\dagger}  &  =\sum_{1\leq j\leq\kappa
}\left\vert f_{j}\right\rangle \left\langle e_{j}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert e_{k}\right\rangle \left\langle f_{k}\right\vert
=\sum_{1\leq j\leq\kappa}\left\vert f_{j}\right\rangle \left\langle
f_{j}\right\vert =P_{\operatorname{Ran}\left\{  A\right\}  },
\end{align}
where $P_{\operatorname{Ker}\left\{  A\right\}  ^{\bot}}$ is the \emph{initial
projector} and $P_{\operatorname{Ran}\left\{  A\right\}  }$ the \emph{final
projector }of the partial\emph{ }isometry $\mathcal{I}_{fe}$.

If we consider the induced positive operator $\left\vert A^{\dagger
}\right\vert ^{2}=AA^{\dagger}$ one obtains
\begin{equation}
\left\vert A^{\dagger}\right\vert =\left(  AA^{\dagger}\right)  ^{\frac{1}{2}%
}=\left(  \sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert \sum_{1\leq j\leq\kappa
}\left\vert \alpha_{k}\right\vert \left\vert e_{k}\right\rangle \left\langle
f_{k}\right\vert \right)  ^{\frac{1}{2}}=\sum_{1\leq j\leq\kappa}\left\vert
\alpha_{j}\right\vert \left\vert f_{j}\right\rangle \left\langle
f_{j}\right\vert
\end{equation}
and thus
\begin{equation}
\left(  AA^{\dagger}\right)  ^{\frac{1}{2}}\mathcal{I}_{fe}=\left\vert
A^{\dagger}\right\vert \mathcal{I}_{fe}=\sum_{1\leq j\leq\kappa}\left\vert
\alpha_{j}\right\vert \left\vert f_{j}\right\rangle \left\langle
f_{j}\right\vert \sum_{1\leq k\leq\kappa}\left\vert f_{k}\right\rangle
\left\langle e_{k}\right\vert =\sum_{1\leq j\leq\kappa}\left\vert \alpha
_{j}\right\vert \left\vert f_{j}\right\rangle \left\langle e_{j}\right\vert
=A.
\end{equation}
Comparing the polar factorization of $A^{\dagger}$ to $A$ one observes that
\begin{align}
A  &  =\mathcal{I}_{fe}\left\vert A\right\vert =\left\vert A^{\dagger
}\right\vert \mathcal{I}_{fe}\\
A^{\dagger}  &  =\mathcal{I}_{fe}^{\dagger}\left\vert A\right\vert .
\end{align}


\subsubsection{Pseudo Inverse}

One can use the SVD of $A$ to construct its unique pseudo inverse $A^{+}$ that
has the properties

\begin{enumerate}
\item
\begin{equation}
AA^{+}A=A,
\end{equation}


\item
\begin{equation}
A^{+}AA^{+}=A^{+},
\end{equation}


\item
\begin{equation}
(AA^{+})^{\dagger}=AA^{+},
\end{equation}


\item
\begin{equation}
(A^{+}A)^{\dagger}=A^{+}A
\end{equation}
by

\item
\begin{equation}
A^{+}=\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert ^{-1}\left\vert
e_{j}\right\rangle \left\langle f_{j}\right\vert ,
\end{equation}


\item where%
\begin{equation}
A=\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert .\
\end{equation}

\end{enumerate}

\begin{remark}%
\begin{align}
AA^{+}  &  =\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert
\left\vert f_{j}\right\rangle \left\langle e_{j}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert \alpha_{k}\right\vert ^{-1}\left\vert e_{k}%
\right\rangle \left\langle f_{k}\right\vert =\sum_{1\leq j\leq\kappa
}\left\vert f_{j}\right\rangle \left\langle f_{j}\right\vert
=P_{\operatorname{Ran}\left\{  A\right\}  }\\
A^{+}A  &  =\sum_{1\leq j\leq\kappa}\left\vert \alpha_{k}\right\vert
^{-1}\left\vert e_{k}\right\rangle \left\langle f_{k}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert f_{j}\right\rangle
\left\langle e_{j}\right\vert =\sum_{1\leq j\leq\kappa}\left\vert
e_{j}\right\rangle \left\langle e_{j}\right\vert =P_{\operatorname{Ker}%
\left\{  A\right\}  ^{\bot}}.
\end{align}

\end{remark}

One can see that $A^{+}$ satisfies the properties of the pseudo inverse by

\begin{enumerate}
\item
\begin{gather}
AA^{+}A=\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert \sum_{1\leq j\leq\kappa
}\left\vert \alpha_{k}\right\vert ^{-1}\left\vert e_{k}\right\rangle
\left\langle f_{k}\right\vert \sum_{1\leq j\leq\kappa}\left\vert \alpha
_{l}\right\vert \left\vert f_{l}\right\rangle \left\langle e_{l}\right\vert
=\sum_{1\leq j,k.l\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
\alpha_{k}\right\vert ^{-1}\left\vert \alpha_{l}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert \left\vert e_{k}\right\rangle
\left\langle f_{k}\right\vert \left\vert f_{l}\right\rangle \left\langle
e_{l}\right\vert \\
=\sum_{1\leq j,k.l\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
\alpha_{j}\right\vert ^{-1}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert =\sum_{1\leq j\leq\kappa
}\left\vert \alpha_{j}\right\vert \left\vert f_{j}\right\rangle \left\langle
e_{j}\right\vert ,
\end{gather}


\item
\begin{equation}
A^{+}AA^{+}=\sum_{1\leq j\leq\kappa}\left\vert \alpha_{k}\right\vert
^{-1}\left\vert e_{k}\right\rangle \left\langle f_{k}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert f_{j}\right\rangle
\left\langle e_{j}\right\vert \sum_{1\leq j\leq\kappa}\left\vert \alpha
_{k}\right\vert ^{-1}\left\vert e_{k}\right\rangle \left\langle f_{k}%
\right\vert =\sum_{1\leq j\leq\kappa}\left\vert \alpha_{k}\right\vert
^{-1}\left\vert e_{k}\right\rangle \left\langle f_{k}\right\vert ,
\end{equation}


\item
\begin{equation}
AA^{+}=(\sum_{1\leq j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert
f_{j}\right\rangle \left\langle e_{j}\right\vert \sum_{1\leq j\leq\kappa
}\left\vert \alpha_{j}\right\vert ^{-1}\left\vert e_{j}\right\rangle
\left\langle f_{j}\right\vert )^{\dagger}=\left(  \sum_{1\leq j\leq\kappa
}\left\vert f_{j}\right\rangle \left\langle f_{j}\right\vert \right)
^{\dagger}=\left(  P_{\operatorname{Ran}\left\{  A\right\}  }\right)
^{\dagger}=P_{\operatorname{Ran}\left\{  A\right\}  }=AA^{+},
\end{equation}


\item
\begin{equation}
A^{+}A=(\sum_{1\leq j\leq\kappa}\left\vert \alpha_{k}\right\vert
^{-1}\left\vert e_{k}\right\rangle \left\langle f_{k}\right\vert \sum_{1\leq
j\leq\kappa}\left\vert \alpha_{j}\right\vert \left\vert f_{j}\right\rangle
\left\langle e_{j}\right\vert )^{\dagger}=\left(  \sum_{1\leq j\leq\kappa
}\left\vert e_{j}\right\rangle \left\langle e_{j}\right\vert \right)
^{\dagger}=\left(  P_{\operatorname{Ker}\left\{  A\right\}  ^{\bot}}\right)
^{\dagger}=P_{\operatorname{Ker}\left\{  A\right\}  ^{\bot}}=A^{+}A.
\end{equation}

\end{enumerate}

\paragraph{Construction of Idempotents continued}

One can form idempotents from unit vectors in the $\left(  \left.
{}\right\vert \right)  $-norm which are thus involutions that produce
idempotents that are orthogonal to each other.
\begin{gather}
v=\sum_{1\leq j\leq2r}z_{j}\widetilde{x_{j}};\quad z_{j}\in\mathbb{C},1\leq
j\leq2r\\
v^{2}=\left(  \left.  v\right\vert v\right)  I_{\mathcal{F}}+v\wedge v=\left(
\left.  v\right\vert v\right)  I_{\mathcal{F}}\\
\sum_{1\leq j,k\leq2r}z_{j}z_{k}\widetilde{x_{j}}\widetilde{x_{k}}=\sum_{1\leq
j\leq2r}z_{j}^{2}I_{\mathcal{F}}+\sum_{1\leq j<k\leq2r}\left(  z_{j}%
z_{k}-z_{k}z_{j}\right)  \widetilde{x_{j}}\widetilde{x_{k}}=I_{\mathcal{F}}\\
\Leftrightarrow\sum_{1\leq j\leq2r}z_{j}^{2}=1\Leftrightarrow\sum_{1\leq
j\leq2r}z_{j}^{\ast2}=1.\\
\left(  \frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right)  \right)  ^{2}=\frac
{1}{4}\left(  I_{\mathcal{F}}+2v+I\right)  =\frac{1}{4}\left(  2I_{\mathcal{F}%
}\pm2v\right)  =\frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right) \\
\frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-v\right)  =0\\
\frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  +\frac{1}{2}\left(
I_{\mathcal{F}}-v\right)  =I_{\mathcal{F}}.
\end{gather}
$\lceil$%
\begin{equation}
z_{j}^{2}=\left(  \operatorname{Re}z_{j}+i\operatorname{Im}z_{j}\right)
\left(  \operatorname{Re}z_{j}+i\operatorname{Im}z_{j}\right)  =\left(
\operatorname{Re}z_{j}\right)  ^{2}-\left(  \operatorname{Im}z_{j}\right)
^{2}+2i\operatorname{Re}z_{j}\operatorname{Im}z_{j}%
\end{equation}
$\rfloor$

The $\left(  \left.  {}\right\vert \right)  $-\emph{normalization/involution
condition} gives that
\begin{align}
z_{j}^{2}  &  =\left(  \operatorname{Re}z_{j}+i\operatorname{Im}z_{j}\right)
\left(  \operatorname{Re}z_{j}+i\operatorname{Im}z_{j}\right)  =\left(
\operatorname{Re}z_{j}\right)  ^{2}+2i\operatorname{Im}z_{j}\operatorname{Re}%
z_{j}-\left(  \operatorname{Im}z_{j}\right)  ^{2}\\
\sum_{1\leq j\leq2rj}z_{j}^{2}  &  =1=\sum_{1\leq j\leq2r}\left(  \left(
\operatorname{Re}z_{j}\right)  ^{2}+2i\operatorname{Im}z_{j}\operatorname{Re}%
z_{j}-\left(  \operatorname{Im}z_{j}\right)  ^{2}\right)  =1\Leftrightarrow
i\sum_{1\leq j\leq2r}\operatorname{Im}z_{j}\operatorname{Re}z_{j}%
=0\,\&\,\sum_{1\leq j\leq2r}\left(  \left(  \operatorname{Re}z_{j}\right)
^{2}-\left(  \operatorname{Im}z_{j}\right)  ^{2}\right)  =1.
\end{align}


\bigskip

Both $\frac{1}{2}\left(  I_{\mathcal{F}}\pm v\right)  $ and $\frac{1}%
{2}\left(  I_{\mathcal{F}}\pm v^{\ast}\right)  \equiv\frac{1}{2}\left(
I_{\mathcal{F}}\pm v^{\ast}\right)  ^{\dagger}$ are idempotents and their
product is given by

\begin{enumerate}
\item
\begin{align}
\frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}+v^{\ast}\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}+v+v^{\ast}%
+\sum_{1\leq j,k\leq2r}\left\vert z_{j}\right\vert ^{2}I_{\mathcal{F}}%
+\sum_{1\leq j<k\leq2r}\left(  z_{j}z_{k}^{\ast}-z_{k}z_{j}^{\ast}\right)
\widetilde{x_{j}}\widetilde{x_{k}}\right) \\
&  =\frac{1}{4}\left(  \left(  1+\sum_{1\leq j,k\leq2r}\left\vert
z_{j}\right\vert ^{2}\right)  I_{\mathcal{F}}+2\operatorname{Re}\left\{
v\right\}  +2i\sum_{1\leq j<k\leq2r}\operatorname{Im}\left\{  z_{j}z_{k}%
^{\ast}\right\}  \widetilde{x_{j}}\widetilde{x_{k}}\right)  ,
\end{align}
as
\begin{equation}
\sum_{1\leq j,k\leq2r}z_{j}z_{k}^{\ast}\widetilde{x_{j}}\widetilde{x_{k}}%
=\sum_{1\leq j,k\leq2r}\left\vert z_{j}\right\vert ^{2}I_{\mathcal{F}}%
+\sum_{1\leq j<k\leq2r}\left(  z_{j}z_{k}^{\ast}-z_{k}z_{j}^{\ast}\right)
\widetilde{x_{j}}\widetilde{x_{k}}.
\end{equation}
$\lceil$%
\begin{align}
\operatorname{Im}\left\{  z_{j}z_{k}^{\ast}\right\}   &  =\operatorname{Im}%
\left\{  \left(  \operatorname{Re}z_{j}+i\operatorname{Im}z_{j}\right)
\left(  \operatorname{Re}z_{k}-i\operatorname{Im}z_{k}\right)  \right\}
=\operatorname{Im}\left\{  \left(  \operatorname{Re}z_{j}\operatorname{Re}%
z_{k}+i\operatorname{Im}z_{j}\operatorname{Re}z_{k}-i\operatorname{Re}%
z_{j}\operatorname{Im}z_{k}+\operatorname{Im}z_{j}\operatorname{Im}%
z_{k}\right)  \right\} \\
&  =\operatorname{Im}z_{j}\operatorname{Re}z_{k}-\operatorname{Re}%
z_{j}\operatorname{Im}z_{k}=\left(
\begin{array}
[c]{cc}%
\operatorname{Re}z_{j} & \operatorname{Im}z_{j}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
0 & -1\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\operatorname{Re}z_{k}\\
\operatorname{Im}z_{k}%
\end{array}
\right)  .
\end{align}
$\rfloor$

If
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}+v^{\ast}\right)  =0
\end{equation}
then
\begin{align}
\operatorname{Re}z_{j}  &  =0\\
1+\sum_{1\leq j,k\leq2r}\left\vert z_{j}\right\vert ^{2}  &  =1+\sum_{1\leq
j,k\leq2r}\left(  \left(  \operatorname{Re}z_{j}\right)  ^{2}+\left(
\operatorname{Im}z_{j}\right)  ^{2}\right)  =0\\
\operatorname{Im}\left(  z_{j}z_{k}^{\ast}\right)   &  =0.
\end{align}
so
\begin{equation}
v=0.
\end{equation}


\item
\begin{align}
\frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-v^{\ast}\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}+v-v^{\ast}%
-\sum_{1\leq j,k\leq2r}\left\vert z_{j}\right\vert ^{2}I_{\mathcal{F}}%
-\sum_{1\leq j<k\leq2r}\left(  z_{j}z_{k}^{\ast}-z_{k}z_{j}^{\ast}\right)
\widetilde{x_{j}}\widetilde{x_{k}}\right) \\
&  =\frac{1}{4}\left(  \left(  1-\sum_{1\leq j,k\leq2r}\left\vert
z_{j}\right\vert ^{2}\right)  I_{\mathcal{F}}+2i\operatorname{Im}\left\{
v\right\}  -2i\sum_{1\leq j<k\leq2r}\operatorname{Im}\left\{  z_{j}z_{k}%
^{\ast}\right\}  \widetilde{x_{j}}\widetilde{x_{k}}\right)  ,
\end{align}
If
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}+v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-v^{\ast}\right)  =0
\end{equation}
then
\begin{align}
\operatorname{Im}z_{j}  &  =0\Leftrightarrow\operatorname{Im}%
v=0\Leftrightarrow v=v^{\ast}=v^{\dagger}\\
1-\sum_{1\leq j,k\leq2r}\left\vert z_{j}\right\vert ^{2}  &  =1-\sum_{1\leq
j,k\leq2r}\left(  \operatorname{Re}z_{j}\right)  ^{2}=0\\
\operatorname{Im}\left(  z_{j}z_{k}^{\ast}\right)   &  =0,
\end{align}
which are all satisfied.

\item
\begin{align}
\frac{1}{2}\left(  I_{\mathcal{F}}-v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-v^{\ast}\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}-\left(  v+v^{\ast
}\right)  +\sum_{1\leq j,k\leq2r}\left\vert z_{j}\right\vert ^{2}%
I_{\mathcal{F}}+\sum_{1\leq j<k\leq2r}\left(  z_{j}z_{k}^{\ast}-z_{k}%
z_{j}^{\ast}\right)  \widetilde{x_{j}}\widetilde{x_{k}}\right) \\
&  =\frac{1}{4}\left(  \left(  1+\sum_{1\leq j,k\leq2r}\left\vert
z_{j}\right\vert ^{2}\right)  I_{\mathcal{F}}+2\operatorname{Re}\left\{
v\right\}  +2i\sum_{1\leq j<k\leq2r}\operatorname{Im}\left\{  z_{j}z_{k}%
^{\ast}\right\}  \widetilde{x_{j}}\widetilde{x_{k}}\right)  .
\end{align}
If
\begin{equation}
\frac{1}{2}\left(  I_{\mathcal{F}}-v\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-v^{\ast}\right)  =0
\end{equation}
the same reasoning as in $(1)$ shows that $v=0.$
\end{enumerate}

As self adjoint involutions $A$ can always be diagonalized and have spectrum
$\sigma\left(  A\right)  =\left\{  0,\pm1\right\}  $ all partial involutions
can be expressed as
\begin{equation}
U^{\dagger}\left(
\begin{array}
[c]{ccc}%
\mathbb{I}_{r_{1}} & \mathbb{O} & \mathbb{O}\\
\mathbb{O} & -\mathbb{I}_{r_{2}} & \mathbb{O}\\
\mathbb{O} & \mathbb{O} & \mathbb{O}_{r-r_{1}-r_{2}}%
\end{array}
\right)  U,U\in U\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
which have trace
\begin{equation}
\operatorname{Tr}\left\{  A\right\}  =r_{1}-r_{2},
\end{equation}
where
\begin{equation}
0\leq r_{1}\leq r;0\leq r_{2}\leq r;0\leq r_{1}+r_{2}\leq r,
\end{equation}
so the values of the trace are given by integers
\begin{equation}
\operatorname{Tr}\left\{  A\right\}  \in\left\{  -r,-r+1,\cdots,0,\cdots
,r-1,r\right\}  .
\end{equation}


All normalized self adjoint blades
\begin{align}
&  v_{j_{1}}\cdots v_{j_{n}}=\left(  v_{j_{1}}\cdots v_{j_{n}}\right)
^{\dagger}=v_{j_{n}}^{\dagger}\cdots v_{j_{1}}^{\dagger}\\
&  v_{j_{n}}^{\dagger}\cdots v_{j_{1}}^{\dagger}v_{j_{1}}\cdots v_{j_{n}%
}=I_{\mathcal{F}}%
\end{align}


are involutions as
\begin{equation}
\left(  v_{j_{1}}\cdots v_{j_{n}}\right)  ^{2}=I_{\mathcal{F}}.
\end{equation}


\begin{theorem}
Self adjoint blades produce self adjoint involutions of the form
\end{theorem}

\begin{enumerate}
\item Type $1$%
\begin{equation}
i\widetilde{x}_{j_{1}}\cdots\widetilde{x}_{j_{n}},
\end{equation}
or

\item Type $2$%
\begin{equation}
\widetilde{x}_{j_{1}}\cdots\widetilde{x}_{j_{n}},
\end{equation}
where $\left\{  \left.  \widetilde{x}_{j}\right\vert 1\leq j\leq2r\right\}  $
are normalized linearly independent real vectors. E.g. self adjoint blade
involutions of order 1,4,5,8 are of type 2, while Self adjoint blade
involutions of order 2,3,6,7 are of type 1.
\end{enumerate}

\begin{proof}
$\lceil$The parities of restoring natural order are given by
\begin{align}
\sigma &  :\left\{  1,2\right\}  \rightarrow\left\{  2,1\right\}  ;\pi\left(
\sigma\right)  =-1=\left(  -1\right)  ^{\tau\left(  \sigma\right)  }=\left(
-1\right)  ^{1}\\
\sigma &  :\left\{  1,2,3\right\}  \rightarrow\left\{  3,2,1\right\}
;\pi\left(  \sigma\right)  =-1=\left(  -1\right)  ^{\tau\left(  \sigma\right)
}=\left(  -1\right)  ^{3}\\
\sigma &  :\left\{  1,2,3,4\right\}  \rightarrow\left\{  4,3,2,1\right\}
;\pi\left(  \sigma\right)  =1=\left(  -1\right)  ^{\tau\left(  \sigma\right)
}=\left(  -1\right)  ^{6}\\
\sigma &  :\left\{  1,2,3,4,5\right\}  \rightarrow\left\{  5,4,3,2,1\right\}
;\pi\left(  \sigma\right)  =1=\left(  -1\right)  ^{\tau\left(  \sigma\right)
}=\left(  -1\right)  ^{10}\\
\sigma &  :\left\{  1,2,3,4,5,6\right\}  \rightarrow\left\{
6,5,4,3,2,1\right\}  ;\pi\left(  \sigma\right)  =-1=\left(  -1\right)
^{\tau\left(  \sigma\right)  }=\left(  -1\right)  ^{15}\\
\sigma &  :\left\{  1,2,3,4,5,6,7\right\}  \rightarrow\left\{
7,6,5,4,3,2,1\right\}  ;\pi\left(  \sigma\right)  =-1=\left(  -1\right)
^{\tau\left(  \sigma\right)  }=\left(  -1\right)  ^{21}\\
\sigma &  :\left\{  1,2,3,4,5,6,7,8\right\}  \rightarrow\left\{
8,7,6,5,4,3,2,1\right\}  ;\pi\left(  \sigma\right)  =1=\left(  -1\right)
^{\tau\left(  \sigma\right)  }=\left(  -1\right)  ^{28}%
\end{align}
