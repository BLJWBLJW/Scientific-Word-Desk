\begin{theorem}%
\begin{equation}
\operatorname{Tr}_{\mathcal{F}}\left\{  A\right\}  =\operatorname{Tr}%
_{JW\left(  \mathcal{F}\right)  }\left\{  JW\left(  A\right)  \right\}  .
\end{equation}

\end{theorem}

\begin{example}
