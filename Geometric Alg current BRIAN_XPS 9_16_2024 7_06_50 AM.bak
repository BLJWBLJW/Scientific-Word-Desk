,\left\langle \varphi_{2}\right\vert \right\}  \right]  \oplus\left[
\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left\langle \varphi
_{1}\varphi_{2}\right\vert \right\}  \right]  .
\end{align}


\item The tensor product of the direct sum $\mathbb{C}^{2}\oplus\mathbb{C}%
^{2}$
\[
v\oplus w=\left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  \oplus\left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
v_{1} & v_{2} & w_{1} & w_{2}%
\end{array}
\right)
\]%
\begin{align}
&  \left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
v_{3} & v_{4}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
v_{1}v_{3} & v_{1}v_{4} & v_{2}v_{3} & v_{2}v_{4}%
\end{array}
\right) \\
&  \left(
\begin{array}
[c]{cc}%
v_{3} & v_{4}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
v_{3}v_{1} & v_{3}v_{2} & v_{4}v_{1} & v_{4}v_{2}%
\end{array}
\right) \\
&  \left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
v_{1}w_{1} & v_{1}w_{2} & v_{2}w_{1} & v_{2}w_{2}%
\end{array}
\right) \\
&  \left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
v_{1} & v_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
w_{1}v_{1} & w_{1}v_{2} & w_{2}v_{1} & w_{2}v_{2}%
\end{array}
\right) \\
&  \left(
\begin{array}
[c]{cc}%
w_{1} & w_{2}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{cc}%
w_{3} & w_{4}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cccc}%
w_{1}w_{3} & w_{1}w_{4} & w_{2}w_{3} & w_{2}w_{4}%
\end{array}
\right)  .
\end{align}


\item Second order exterior product of direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$%
