\section{Wick Product}

\subsection{Definition of Wick Product}%

\begin{gather}
X_{1}\cdots X_{m}=\,:X_{1}\cdots X_{m}:+\\
\left(  -1\right)  ^{\pi\left(  12\right)  }:\underleftrightarrow{X_{1}X_{2}%
}X_{3}\cdots X_{m}:+\,\left(  -1\right)  ^{\pi\left(  13\right)
}:\underleftrightarrow{X_{1}X_{2}X_{3}}X_{4}\cdots X_{m}:+\cdots+\,\left(
-1\right)  ^{\pi\left(  1m\right)  }:\underleftrightarrow{X_{1}X_{2}\cdots
X_{m}}:+\\
:X_{1}\underleftrightarrow{X_{2}X_{3}}X_{4}\cdots X_{m}:+\cdots+\,:X_{1}%
\underleftrightarrow{X_{2}\cdots X_{m}}\,+\\
:X_{1}X_{2}\underleftrightarrow{X_{3}X_{4}}X_{5}\cdots X_{m}:+\cdots
+\,:X_{1}X_{2}\underleftrightarrow{X_{3}\cdots X_{m}}+\cdots+\,:X_{1}%
X_{2}X_{3}\cdots\underleftrightarrow{X_{m-1}X_{m}}:+\\
:\underleftrightarrow{X_{1}X_{2}}\underleftrightarrow{X_{3}X_{4}}X_{5}\cdots
X_{m}:+\cdots+\,:X_{1}X_{2}X_{3}\cdots\underleftrightarrow{X_{m-3}X_{m-2}%
}\underleftrightarrow{X_{m-1}X_{m}}:\\
\vdots\\
:\underleftrightarrow{X_{1}X_{2}}\underleftrightarrow{X_{3}X_{4}}%
\cdots\underleftrightarrow{X_{m-3}X_{m-2}}\underleftrightarrow{X_{m-1}X_{m}%
}:\\
:\underleftrightarrow{X_{j}X_{k}}:\,=\operatorname*{tr}\left\{  X_{j}%
X_{k}D\right\}
\end{gather}
The operators $\left\{  X_{1},\cdots,X_{m}\right\}  $ are all "vectors" i.e.
$\in\mathcal{F}_{1}$ but need not be a basis nor orthonormal i.e. they can be
any general vectors.

\subsection{Vacuum State}%

\begin{align}
&  D\geq0\\
&  \operatorname*{tr}\left\{  D\right\}  =1\\
&  \operatorname*{tr}\left\{  X_{j}D\right\}  =0;1\leq j\leq2r
\end{align}


\subsubsection{Example of Vacuum States}%

\begin{equation}
D=b_{1}^{\dagger}\cdots b_{k}^{\dagger}\exp\left\{
%TCIMACRO{\tsum \limits_{1\leq i<j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq i<j\leq r}}
%EndExpansion
g_{ij}b_{i}^{\dagger}b_{j}^{\dagger}\right\}  \exp\left\{
%TCIMACRO{\tsum \limits_{1\leq i<j\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq i<j\leq r}}
%EndExpansion
-\overline{g}_{ij}b_{i}b_{j}\right\}  b_{k}\cdots b_{1}%
\end{equation}


\subsection{Example}

1.%

\begin{align}
X_{1}X_{2} &  =\,:X_{1}X_{2}:+:\underleftrightarrow{X_{1}X_{2}}:\\
&  =\left(  -1\right)  ^{\pi\left(  12\right)  }:X_{1}X_{2}%
:+\,\operatorname*{tr}\left\{  X_{1}X_{2}D\right\}
\end{align}
This implies
\begin{equation}
\,:X_{1}X_{2}:\,=X_{1}X_{2}-\operatorname*{tr}\left\{  X_{1}X_{2}D\right\}  .
\end{equation}


2.%
\begin{align}
X_{1}X_{2}X_{3}  &  =\,:X_{1}X_{2}X_{3}:+\pi\left(  12\right)
:\underleftrightarrow{X_{1}X_{2}}X_{3}:+\,\pi\left(  23\right)  :X_{1}%
\underleftrightarrow{X_{2}X_{3}}:+\,\pi\left(  13\right)
:\underleftrightarrow{X_{1}X_{2}X_{3}}:\\
&  =:X_{1}X_{2}X_{3}:+\,\operatorname*{tr}\left\{  X_{1}X_{2}D\right\}
X_{3}+\operatorname*{tr}\left\{  X_{1}X_{3}D\right\}  X_{2}-\operatorname*{tr}%
\left\{  X_{2}X_{3}D\right\}  X_{1}%
\end{align}


This implies
\begin{equation}
\,:X_{1}X_{2}X_{3}:\,=X_{1}X_{2}X_{3}-\operatorname*{tr}\left\{  X_{1}%
X_{2}D\right\}  X_{3}-\operatorname*{tr}\left\{  X_{1}X_{3}D\right\}
X_{2}+\operatorname*{tr}\left\{  X_{2}X_{3}D\right\}  X_{1}.
\end{equation}



