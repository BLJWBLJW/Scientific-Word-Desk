%TCIDATA{Version=5.50.0.2960}
%TCIDATA{LaTeXparent=0,0,EOMN.tex}
                      
%TCIDATA{ChildDefaults=chapter:1,page:1}


\section{Antisymmetric Operators}

\subsection{Real Antisymmetric Matrices}

Let ${\cal A}$ be a {\em real} compact antisymmetric operator $\in {\cal B}%
_{0}\left( V\right) $, where $V$ is a Hilbert space then it has the
canonical expansion 
\begin{equation}
{\cal A}=\sum_{1\leq j\leq s}\alpha _{j}\left\{ \left\vert
s_{j}\right\rangle \left\langle s_{j+s}\right\vert -\left\vert
s_{_{j+s}}\right\rangle \left\langle s_{j}\right\vert \right\}  \label{anti}
\end{equation}%
As the operator is real ${\cal A}={\cal A}^{\ast }$, (see Appendix \ref{star}
for the definition of complex conjugation $\ast $), it can be converted into
a compact self adjoint purely imaginary operator, ${\cal H}$, with the
properties 
\begin{eqnarray}
{\cal H} &=&i{\cal A}  \nonumber \\
{\cal H}^{\dagger } &=&-i{\cal A}^{t}=i{\cal A}={\cal H}  \nonumber \\
{\cal H}^{\ast } &=&-i{\cal A}=i{\cal A}^{t}\,={\cal H}^{t}
\end{eqnarray}%
and 
\begin{equation}
{\cal H}=i{\cal A}=\sum_{1\leq j\leq s}\alpha _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad \alpha
_{j}\in {\Bbb R}  \label{sa}
\end{equation}%
where $\left\{ \left\vert v_{j}\right\rangle ,\left\vert v_{j}^{\ast
}\right\rangle ;1\leq j\leq \infty \right\} $ is a conb for ${\cal H}$. In
finite dimensions we must consider even dimensional spaces or even
dimensional subspaces of codimension 1. Eq. $\left( \ref{sa}\right) $ is
seen by observing that 
\begin{equation}
{\cal H}\left\vert v\right\rangle =\alpha \left\vert v\right\rangle
\Rightarrow {\cal H}^{\ast }\left\vert v^{\ast }\right\rangle =\alpha
\left\vert v^{\ast }\right\rangle \Rightarrow {\cal H}^{t}\left\vert v^{\ast
}\right\rangle =\alpha \left\vert v^{\ast }\right\rangle \Rightarrow {\cal H}%
\left\vert v^{\ast }\right\rangle =-\alpha \left\vert v^{\ast }\right\rangle
\end{equation}%
{\em It is important to note} that the orthonormal eigenvectors of ${\cal H}$
are only defined up to an overall phase factors $e^{i\varphi _{j}}$ which 
{\em do not} preserve the complex conjugate relationship between
eigenvectors associated with paired eigenvalues of opposite sign. These
different bases are related to each other by 
\begin{equation}
\left( \left\vert v_{1}^{\prime }\right\rangle \cdots \left\vert
v_{2s}^{\prime }\right\rangle \right) =\left( \left\vert v_{1}\right\rangle
\cdots \left\vert v_{2s}\right\rangle \right) \left( 
\begin{array}{ccc}
e^{i\varphi _{1}} & {\bf 0} & {\bf 0} \\ 
{\bf 0} & \ddots & {\bf 0} \\ 
{\bf 0} & {\bf 0} & e^{i\varphi _{2s}}%
\end{array}%
\right)
\end{equation}%
Using a basis with complex conjugate symmetry we obtain 
\begin{equation}
{\cal A}={\cal -}\sum_{1\leq j\leq s}i\alpha _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad \alpha
_{i}\in {\Bbb R}
\end{equation}%
We can then define a {\em real} conb $\left\{ \left\vert s_{j}\right\rangle
;1\leq j\leq \infty \right\} $ i.e. $\left\vert s_{j}\right\rangle
=\left\vert s_{j}^{\ast }\right\rangle $ as 
\begin{eqnarray}
\left\vert s_{j}\right\rangle &=&\frac{1}{\sqrt{2}}\left( \left\vert
v_{j}\right\rangle +\left\vert v_{j}^{\ast }\right\rangle \right) =\sqrt{2}%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left\vert v_{j}\right\rangle  \nonumber \\
\left\vert s_{j+s}\right\rangle &=&\frac{-i}{\sqrt{2}}\left( \left(
\left\vert v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right)
\right) =\sqrt{2}%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left\vert v_{j}\right\rangle
\end{eqnarray}%
so that 
\begin{eqnarray}
{\cal A}\left\{ \frac{1}{\sqrt{2}}\left( \left\vert v_{j}\right\rangle
+\left\vert v_{j}^{\ast }\right\rangle \right) \right\} &=&-i\alpha _{j}%
\frac{1}{\sqrt{2}}\left( \left\vert v_{j}\right\rangle -\left\vert
v_{j}^{\ast }\right\rangle \right)  \nonumber \\
&=&\alpha _{j}\left\{ \frac{-i}{\sqrt{2}}\left( \left( \left\vert
v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right) \right)
\right\}
\end{eqnarray}%
and 
\begin{eqnarray}
{\cal A}\left\{ \frac{-i}{\sqrt{2}}\left( \left( \left\vert
v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right) \right)
\right\} &=&\frac{-\alpha _{j}}{\sqrt{2}}\left\vert v_{j}\right\rangle -%
\frac{\alpha _{j}}{\sqrt{2}}\left\vert v_{j}^{\ast }\right\rangle  \nonumber
\\
&=&-\alpha _{j}\left\{ \frac{1}{\sqrt{2}}\left( \left\vert
v_{j}\right\rangle +\left\vert v_{j}^{\ast }\right\rangle \right) \right\}
\end{eqnarray}%
thus 
\begin{equation}
{\cal A}=\sum_{1\leq j\leq s}\alpha _{j}\left\{ \left\vert
s_{j}\right\rangle \left\langle s_{j+s}\right\vert -\left\vert
s_{j+s}\right\rangle \left\langle s_{j}\right\vert \right\}
\end{equation}%
which justifies the expansion in eq. $\left( \ref{anti}\right) $. Using the
bases $\left\{ \left\vert s_{j}\right\rangle ;1\leq j\leq \infty \right\} $
we can produce the canonical matrix representation of ${\cal A}$ 
\begin{equation}
{\cal A}\left( \left\vert {\bf s}\right\rangle \right) =\left\vert {\bf s}%
\right\rangle \left( 
\begin{array}{cc}
{\Bbb O} & {\bf \alpha } \\ 
-{\bf \alpha } & {\Bbb O}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
{\bf \alpha =}\left( 
\begin{array}{ccc}
\alpha _{1} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & \ddots & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \alpha _{s}%
\end{array}%
\right) .
\end{equation}%
One can reorder this basis to obtain 
\begin{equation}
{\cal A}\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle
\cdots \left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right)
\end{equation}%
and the expansion 
\begin{equation}
{\cal A}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\vert s_{1}\right\rangle \\ 
\left\vert s_{1+s}\right\rangle \\ 
\vdots \\ 
\left\vert s_{s}\right\rangle \\ 
\left\vert s_{s+s}\right\rangle%
\end{array}%
\right)  \label{reex}
\end{equation}%
The row vector of basis vectors, $\left( \left\vert s_{1}\right\rangle
\left\vert s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle
\left\vert s_{s+s}\right\rangle \right) $, can be viewed as a real
orthogonal matrix whose columns are the real basis vectors $\left\{ \cdots
,\left\vert s_{j}\right\rangle ,\left\vert s_{s+j}\right\rangle ,\cdots
\right\} $.

The complex basis $\left\{ \left\vert v_{j}\right\rangle ,\left\vert
v_{j}^{\ast }\right\rangle ;1\leq j\leq \infty \right\} $ diagonalizes $%
{\cal A}$ to give 
\begin{equation}
{\cal A}\left( \left\vert {\bf v}\right\rangle ,\left\vert {\bf v}^{\ast
}\right\rangle \right) =\left( \left\vert {\bf v}\right\rangle ,\left\vert 
{\bf v}^{\ast }\right\rangle \right) \left( 
\begin{array}{cc}
-i{\bf \alpha } & {\Bbb O} \\ 
{\Bbb O} & i{\bf \alpha }%
\end{array}%
\right)
\end{equation}%
this basis can also be reordered to produce 
\begin{equation}
{\cal A}\left( \left\vert \left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle \right\rangle \right) =\left( \left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right)
\end{equation}%
and the expansion%
\begin{equation}
{\cal A}=\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\vert v_{1}\right\rangle \\ 
\left\vert v_{1}^{\ast }\right\rangle \\ 
\vdots \\ 
\left\vert v_{s}\right\rangle \\ 
\left\vert v_{s}^{\ast }\right\rangle%
\end{array}%
\right) .  \label{ccex}
\end{equation}%
The row vector of basis vectors, $\left( \left\vert v_{1}\right\rangle
\left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle
\left\vert v_{s}^{\ast }\right\rangle \right) $, can be viewed as an unitary
matrix whose columns are the basis vectors $\left\{ \cdots ,\left\vert
v_{j}\right\rangle ,\left\vert v_{j}^{\ast }\right\rangle ,\cdots \right\} $%
. Note that the expansions of eqs $\left( \ref{reex}\right) $ and $\left( %
\ref{ccex}\right) $ both give ${\cal A}$ thus in eq $\left( \ref{reex}%
\right) $ all the imaginary terms cancel.

\subsection{Complex Antisymmetric Matrices}

\begin{definition}
The real and imaginary parts of ${\cal A}$ are {\em self adjoint and are
defined} as

\begin{enumerate}
\item  
\begin{mathletters}
\[
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}=\frac{1}{2}\left( {\cal A}+{\cal A}^{\dagger }\right) 
\]

\item 
\end{mathletters}
\begin{equation}
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}=\frac{-i}{2}\left( {\cal A}-{\cal A}^{\dagger }\right) 
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
This {\em definition is valid in both the operator and matrix representation}
cases and hence 
\begin{equation}
{\cal A}=%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}+i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}.
\end{equation}
\end{remark}

\begin{remark}
The representations ${\cal R}\left( 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}\right) $ and ${\cal R}\left( 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}\right) $ are {\em generally complex} i.e. belong to ${\cal M}\left(
2r,2r,{\Bbb C}\right) .$
\end{remark}

\begin{definition}
An operator ${\cal A}$ is normal if 
\begin{equation}
\left[ {\cal A},{\cal A}^{\dagger }\right] =0,
\end{equation}
\end{definition}

\begin{lemma}
${\cal A}$ is normal $%
%TCIMACRO{\limfunc{Iff}}%
%BeginExpansion
\mathop{\rm Iff}%
%EndExpansion
$ 
\begin{equation}
\left[ 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A},%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}\right] =0.
\end{equation}
\end{lemma}

\begin{proof}

\begin{eqnarray}
\left[ 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A},%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}\right]  &=&\left[ \frac{1}{2}\left( {\cal A}+{\cal A}^{\dagger
}\right) ,\frac{-i}{2}\left( {\cal A}-{\cal A}^{\dagger }\right) \right] =%
\frac{-i}{4}\left( {\cal A}+{\cal A}^{\dagger }\right) \left( {\cal A}-{\cal %
A}^{\dagger }\right) +\frac{i}{4}\left( {\cal A}-{\cal A}^{\dagger }\right)
\left( {\cal A}+{\cal A}^{\dagger }\right)  \\
&=&\frac{-i}{4}{\cal AA}-\frac{i}{4}{\cal A}^{\dagger }{\cal A}+\frac{i}{4}%
{\cal AA}^{\dagger }+\frac{i}{4}{\cal A}^{\dagger }{\cal A}^{\dagger }-\frac{%
i}{4}{\cal A}^{\dagger }{\cal A}-\frac{i}{4}{\cal A}^{\dagger }{\cal A}%
^{\dagger }+\frac{i}{4}{\cal AA}+\frac{i}{4}{\cal AA}^{\dagger } \\
&=&-\frac{i}{2}{\cal A}^{\dagger }{\cal A}+\frac{i}{2}{\cal AA}^{\dagger } \\
&=&i\left[ {\cal A},{\cal A}^{\dagger }\right] .
\end{eqnarray}%
Hence 
\begin{equation}
\left[ {\cal A},{\cal A}^{\dagger }\right] =0\Leftrightarrow \left[ 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A},%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}\right] =0.\blacksquare 
\end{equation}
\end{proof}

\begin{remark}
{\em If }the {\em self adjoint} real and complex parts of a complex matrix
commute, ({\em note} that these parts {\em need not to }be real), then the
matrix defines a representation of a normal operator. 
\end{remark}

\begin{definition}
Let ${\cal A}\in {\cal M}\left( 2r,2r,{\Bbb C}\right) $ we define the
matrices ${\cal M}$ and ${\cal N}$ by 

\begin{enumerate}
\item 
\begin{equation}
{\cal M=-}i%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A\Leftrightarrow }%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}=i{\cal M}
\end{equation}

\item 
\begin{equation}
{\cal N}=i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A\Leftrightarrow }%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}=-i{\cal N},  \nonumber
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
If the matrix ${\cal A}$ is antisymmetric i.e. ${\cal A=-A}^{t},$ then the
matrices ${\cal M}$ and ${\cal N}$ are real    
\begin{eqnarray}
{\cal M} &=&-{\cal M}^{t}={\cal M}^{\ast }  \nonumber \\
{\cal N} &=&-{\cal N}^{t}={\cal N}^{\ast },
\end{eqnarray}
\end{lemma}

\begin{proof}
From the definition of ${\cal M}$ and ${\cal N}$ one obtains 
\end{proof}

\begin{remark}
\begin{enumerate}
\item   
\begin{equation}
{\cal A}=i{\cal M}+{\cal N}={\cal N}+i{\cal M}
\end{equation}

\item  
\begin{equation}
{\cal N}=\frac{1}{2}\left( {\cal A}-{\cal A}^{\dagger }\right) =\frac{1}{2}%
\left( {\cal A}+{\cal A}^{\ast }\right) =-{\cal N}^{\dagger }={\cal N}^{\ast
}  \nonumber
\end{equation}

\item 
\begin{equation}
{\cal M}=\frac{-i}{2}\left( {\cal A}+{\cal A}^{\dagger }\right) =\frac{-i}{2}%
\left( {\cal A}-{\cal A}^{\ast }\right) =-{\cal M}^{\dagger }={\cal M}^{\ast
}.
\end{equation}
\end{enumerate}
\end{remark}

\begin{theorem}
If a matrix ${\cal A\in M}\left( 2r,2r,{\Bbb C}\right) $ is antisymmetric
and normal then it can be brought to complex antisymmetric canonical form by
a {\em real orthogonal} transformation.
\end{theorem}

\begin{proof}
Let ${\cal A}$ be a normal matrix then 
\begin{equation}
\left[ {\cal A},{\cal A}^{\dagger }\right] =0.
\end{equation}%
If ${\cal A}$ is antisymmetric 
\begin{equation}
{\cal A}=-{\cal A}^{t}  \label{at}
\end{equation}%
(for operators the transpose operation is defined in terms of the adjoint
and complex conjugation operations see Appendix \ref{star})\ then 
\begin{eqnarray}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A\,} &=&-%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}^{t}  \nonumber \\
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A\,} &=&-%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}^{t}.
\end{eqnarray}%
and 
\begin{eqnarray}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A} &=&%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}^{\dagger }=%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}^{t\ast }=-\left( 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}\right) ^{\ast }  \nonumber \\
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A} &=&%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}^{\dagger }=%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}^{t\ast }=-\left( 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}\right) ^{\ast }.
\end{eqnarray}%
Hence $%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}$ and $%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}$ are {\em purely imaginary} i.e. products of $i$ and {\em real}
antisymmetric matrices i.e. 
\begin{eqnarray}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A} &=&i{\cal M}  \nonumber \\
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A} &=&-i{\cal N}.
\end{eqnarray}%
Thus ${\cal A}$ can be decomposed as  
\begin{equation}
{\cal A}=i{\cal M}+{\cal N}={\cal N}+i{\cal M}
\end{equation}%
and hence  
\begin{eqnarray}
{\cal N} &=&\frac{1}{2}\left( {\cal A}-{\cal A}^{\dagger }\right) =\frac{1}{2%
}\left( {\cal A}+{\cal A}^{\ast }\right) =-{\cal N}^{\dagger }={\cal N}%
^{\ast }  \nonumber \\
{\cal M} &=&\frac{-i}{2}\left( {\cal A}+{\cal A}^{\dagger }\right) =\frac{-i%
}{2}\left( {\cal A}-{\cal A}^{\ast }\right) =-{\cal M}^{\dagger }={\cal M}%
^{\ast }
\end{eqnarray}%
confirming that ${\cal M}$ and ${\cal N}$ are real. 
\end{proof}

\begin{remark}
Note that the real part ${\cal N}$ of ${\cal A}$ is related to self adjoint 
{\em imaginary} part of ${\cal A}$ while the imaginary part ${\cal M}$ of $%
{\cal A}$ is related to self adjoint {\em real} part of ${\cal A}$!. 

\begin{proof}
If ${\cal A}$ is normal then the matrices ${\cal M}$ and ${\cal N}$ commute
i.e 
\begin{equation}
\left[ {\cal M},{\cal N}\right] =0
\end{equation}%
as do the self adjoint real and complex parts of ${\cal A},$ hence can be
simultaneously diagonalized by a real orthogonal transformation. $%
\blacksquare $
\end{proof}
\end{remark}

\begin{theorem}
If ${\cal R}\left( {\cal A}\right) \in {\cal M}\left( 2r,2r,{\Bbb C}\right) $
is antisymmetric i.e. 
\begin{equation}
{\cal A}={\cal -A}^{t}
\end{equation}%
then ${\cal R}\left( {\cal A}\right) $ is normal i.e. 
\begin{equation}
\left[ {\cal A},{\cal A}^{\dagger }\right] =0,
\end{equation}
\end{theorem}

\begin{proof}
\end{proof}

$%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}$ and $%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}$ can be simultaneously diagonalized to give 
\begin{eqnarray}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A} &=&i{\cal M}=\sum_{1\leq j\leq s}\mu _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad \mu
_{j}\in {\Bbb R}  \nonumber \\
&\Rightarrow &{\cal M}={\cal -}\sum_{1\leq j\leq s}i\mu _{j}\left\{
\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert
v_{j}^{\ast }\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\}
\end{eqnarray}%
and 
\begin{eqnarray}
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A} &=&-i{\cal N}=\sum_{1\leq j\leq s}\upsilon _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad
\upsilon _{j}\in {\Bbb R}  \nonumber \\
&\Rightarrow &{\cal N}=\sum_{1\leq j\leq s}i\upsilon _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} .
\end{eqnarray}%
Then we can use the theory for real antisymmetric matrices to obtain 
\begin{equation}
{\cal M}=\sum_{1\leq j\leq s}\mu _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert 
\stackrel{}{s_{j}}\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert
\right\}
\end{equation}%
and 
\begin{equation}
{\cal N}=\sum_{1\leq j\leq s}\left( -\upsilon _{j}\right) \left\{ \left\vert 
\stackrel{}{s_{j}}\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert
-\left\vert \stackrel{}{s_{_{j+s}}}\right\rangle \left\langle \stackrel{}{%
s_{j}}\right\vert \right\}
\end{equation}%
which gives using 
\begin{equation}
{\cal A}=%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}+i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}={\cal N}+i{\cal M}
\end{equation}%
the {\em canonical} expansion 
\begin{eqnarray}
{\cal A} &=&\sum_{1\leq j\leq s}\left( -\upsilon _{j}+i\mu _{j}\right)
\left\{ \left\vert s_{j}\right\rangle \left\langle s_{j+s}\right\vert
-\left\vert s_{_{j+s}}\right\rangle \left\langle s_{j}\right\vert \right\} 
\nonumber \\
&\equiv &\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert 
\stackrel{}{s_{_{j+s}}}\right\rangle \left\langle \stackrel{}{s_{j}}%
\right\vert \right\} ,
\end{eqnarray}%
where $\eta _{j}=-\upsilon _{j}+i\mu _{j}$. This gives the matrix
representation 
\begin{equation}
{\cal A}\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle
\cdots \left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \eta _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\eta _{s} & 0%
\end{array}%
\right)
\end{equation}%
and the expansion 
\begin{equation}
{\cal A}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \eta _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\eta _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right)
\end{equation}%
We can also observe that ${\cal A}$ has the {\em spectral expansion} 
\begin{equation}
{\cal A}=-i\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{v_{j}}%
\right\rangle \left\langle \stackrel{}{v_{j}}\right\vert -\left\vert 
\stackrel{}{v_{j}^{\ast }}\right\rangle \left\langle \stackrel{}{v_{j}^{\ast
}}\right\vert \right\} .
\end{equation}%
This gives the matrix representation 
\begin{equation}
{\cal A}\left( \left\vert \left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle \right\rangle \right) =\left( \left\vert
\left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots
\left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle
\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\eta _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\eta _{s}%
\end{array}%
\right)
\end{equation}%
and the expansion%
\begin{equation}
{\cal A}=\left( \left\vert \left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle \right\rangle \right) \left( 
\begin{array}{ccccc}
-i\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\eta _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\eta _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle v_{1}^{\ast }\right\vert \\ 
\left\langle v_{1}\right\vert \\ 
\vdots \\ 
\left\langle v_{s}^{\ast }\right\vert \\ 
\left\langle v_{s}\right\vert%
\end{array}%
\right) .
\end{equation}

The bases $\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right) $ and $\left( \left\vert s_{1}\right\rangle
\left\vert s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle
\left\vert s_{s+s}\right\rangle \right) $ can be viewed as transformations
of a fixed {\em real }starting basis $\left( \left\vert e_{1}\right\rangle
\cdots \left\vert e_{2s}\right\rangle \right) $ i.e.%
\begin{eqnarray}
\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
&=&\left( \left\vert e_{1}\right\rangle \cdots \left\vert
e_{2s}\right\rangle \right) {\Bbb S}  \nonumber \\
\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle
\cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle
\right) &=&\left( \left\vert e_{1}\right\rangle \cdots \left\vert
e_{2s}\right\rangle \right) {\Bbb V}
\end{eqnarray}%
where ${\Bbb S}$ is a real orthogonal matrix and ${\Bbb V}$ is unitary
matrix. If we are solely working with matrices we can set 
\begin{equation}
\left\vert e_{j}\right\rangle =\left( 
\begin{array}{c}
0 \\ 
\vdots \\ 
0 \\ 
1 \\ 
0 \\ 
\vdots \\ 
0%
\end{array}%
\right) \leftarrow \text{j'th position}
\end{equation}%
and the matrix ${\Bbb S}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) $ and ${\Bbb V}=$ $\left( \left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle \right) $ where $%
\left\vert s_{j}\right\rangle $ and $\left\vert v_{j}\right\rangle $ are
numerical column vectors, while if we are considering abstract operators we
can consider $\left\{ \left\vert e_{j}\right\rangle \right\} $ to be a given
fixed real basis of ${\cal H}$.

\section{Symmetry}

There is a 1-1 correspondence between antisymmetric operators acting on a
Hilbert space ${\cal H}$ (i.e. mixed contra and covariant tensors of rank $%
\left( 1,1\right) $) and contravariant tensors of rank $\left( 0,2\right) $
and also covariant tensors of rank $\left( 2,0\right) $. The first
correspondence is given by 
\begin{equation}
{\cal A}=\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert
s_{_{j+s}}\right\rangle \left\langle \stackrel{}{s_{j}}\right\vert \right\}
\leftrightarrow 2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle  \label{contra}
\end{equation}%
where $\left\vert s_{j}s_{j+s}\right\rangle $ is the normalized
antisymmetric tensor product of the {\em real }basis elements $\left\{
\left\vert s_{j}\right\rangle ,\left\vert s_{_{j+s}}\right\rangle \right\} $
and $\eta _{j}=\eta _{jj+s}$. The expansions of ${\cal A}$ are not unique
and we have from the preceeding that%
\begin{eqnarray}
{\cal A} &=&\sum\Sb 1\leq j\leq s  \\ 1\leq j^{\prime }\leq 2s  \\ 1\leq
j^{\prime \prime }\leq 2s  \endSb \eta _{j}\left\{ \left\vert e_{j^{\prime
}}S_{j^{\prime }2j-1}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j}\right\vert -\left\vert e_{j^{\prime
}}S_{j^{\prime }2j}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j-1}\right\vert \right\}  \nonumber \\
&=&\sum\Sb 1\leq j\leq s  \\ 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime
\prime }\leq 2s  \endSb \left\{ \eta _{j}\left\vert e_{j^{\prime
}}S_{j^{\prime }2j-1}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j}\right\vert +\eta _{j+s}\left\vert e_{j^{\prime
}}S_{j^{\prime }2j}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j-1}\right\vert \right\}  \nonumber \\
&=&\sum\Sb 1\leq j\leq 2s  \\ 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime
\prime }\leq 2s  \endSb S_{j^{\prime }j}\eta _{j}S_{j^{\prime \prime
}j}\left\vert e_{j^{\prime }}\right\rangle \left\langle e_{j^{\prime \prime
}}\right\vert  \nonumber \\
&=&\sum\Sb 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime \prime }\leq 2s 
\endSb \left( {\Bbb S}{\bf \eta }{\Bbb S}^{t}\right) _{_{j^{\prime
}j^{\prime \prime }}}\left\vert e_{j^{\prime }}\right\rangle \left\langle
e_{j^{\prime \prime }}\right\vert
\end{eqnarray}%
and 
\begin{eqnarray}
{\cal A} &=&2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle =\sum_{1\leq j\leq s}\left\{ \eta
_{jj+s}\left\vert s_{j}s_{j+s}\right\rangle +\eta _{j+sj}\left\vert
s_{j+s}s_{j}\right\rangle \right\}  \nonumber \\
&=&\sum\Sb 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime \prime }\leq 2s 
\endSb \left( {\Bbb S}{\bf \eta }{\Bbb S}^{t}\right) _{_{j^{\prime
}j^{\prime \prime }}}\left\vert e_{j^{\prime }}e_{j^{\prime \prime
}}\right\rangle =\sum\Sb 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime \prime
}\leq 2s  \endSb {\Bbb A}_{_{j^{\prime }j^{\prime \prime }}}\left\vert
e_{j^{\prime }}e_{j^{\prime \prime }}\right\rangle
\end{eqnarray}%
Eq. $\left( \ref{contra}\right) $ shows that 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Os_{j}Os_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
O\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb O}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb O}_{\left( j\right) }=1
\end{equation}%
i.e. $O\in SO(2,{\Bbb R)}$ and $O{\cal A}O^{t}={\cal A}.$ If we have some
degeneracies i.e. $\eta _{j_{1}}=\cdots =\eta _{j_{d}}$ then $O\in SO(2d,%
{\Bbb R)}$ and $O{\cal A}O^{t}={\cal A}$ also produce different but
equivalent expansions of ${\cal A}$ in terms of a real basis.

We can also observe that 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
U\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb U}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb U}_{\left( j\right) }=1
\end{equation}%
i.e. $U\in SU(2,{\Bbb C)}$ and $U{\cal A}U^{t}={\cal A}.$ If we have some
degeneracies i.e. $\eta _{j_{1}}=\cdots =\eta _{j_{d}}$ then $U\in SU(2d,%
{\Bbb C)}$ and $U{\cal A}U^{t}={\cal A}$ also produce different but
equivalent expansions of ${\cal A}$ in terms of a complex basis.

We can further observe more generally that 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left( \det {\Bbb U}_{\left( j\right)
}\right) ^{-1}\left\vert Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq
s}\eta _{j}\left\vert s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
U\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb U}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb U}_{\left( j\right) }=e^{i\sigma }
\end{equation}%
A special case of this is 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left( \det {\Bbb U}_{\left( j\right)
}\right) ^{-1}\left\vert Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq
s}\left\vert \eta _{j}\right\vert \left\vert Us_{j}Us_{j+s}\right\rangle
\end{equation}%
where 
\begin{equation}
\eta _{j}=\left\vert \eta _{j}\right\vert e^{i\sigma }
\end{equation}%
Thus one can conclude that the expansion of ${\cal A}$ in terms of a
canonical complex basis {\em does not }lead to {\em unique }canonical
coefficients!! In this case canonical coefficients are only uniquely defined
up to a complex phase factor and the value of the canonical coefficients
depends on the canonical basis used. However the absolute values $\left\{
\left. \left\vert \eta _{j}\right\vert \right\vert 1\leq j\leq s\right\} $
are unique.

Expansions in terms of canonical real bases as $\det {\Bbb O}_{\left(
j\right) }=-1$ (the only other possible value for $\det {\Bbb O}_{\left(
j\right) })$ leads to%
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left( -1\right) \left\vert
Os_{j}Os_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Os_{j+s}Os_{j}\right\rangle ,
\end{equation}%
which corresponds to $\eta _{j}\rightarrow -\eta _{j}$. Thus canonical
coefficients in this case are uniquely defined up to sign. The eigenvalues
of ${\cal A}$ are however {\em uniquely} defined as $\left\{ \pm i\eta
_{j};1\leq j\leq s\right\} $.

\section{Complex Conjugation\label{star}}

A complex conjugation map, $K$, is a antilinear involution determined by any
representative,$\left\{ \left\vert {\bf e}\right\rangle \right\} $, of an
equivalence class of bases $\left[ \left\vert {\bf e}\right\rangle \right] $
of ${\cal H}$ by 
\begin{equation}
K\left\vert v\right\rangle =%
%TCIMACRO{\dsum }%
%BeginExpansion
\mathop{\displaystyle\sum}
%EndExpansion
\left( x_{j}-iy_{j}\right) \left\vert e_{j}\right\rangle =%
%TCIMACRO{\dsum }%
%BeginExpansion
\mathop{\displaystyle\sum}
%EndExpansion
\eta _{j}^{\ast }\left\vert e_{j}\right\rangle
\end{equation}%
where 
\begin{equation}
\left\vert v\right\rangle =%
%TCIMACRO{\dsum }%
%BeginExpansion
\mathop{\displaystyle\sum}
%EndExpansion
\eta _{j}\left\vert e_{j}\right\rangle
\end{equation}%
Any vector that satisfies 
\begin{equation}
K\left\vert w\right\rangle =\left\vert w\right\rangle
\end{equation}%
is called real wrt $K$, in particular the basis elements $\left\{ \left\vert
e_{j}\right\rangle \right\} $ are real vectors.

The complex conjugate of an operator ${\cal B}$ is defined by 
\begin{equation}
{\cal B}^{\ast }=K{\cal B}K
\end{equation}%
leading to 
\begin{equation}
{\cal B}^{\ast }=K{\cal B}K\left( \left\vert {\bf e}\right\rangle \right) =K%
{\cal B}\left( \left\vert {\bf e}\right\rangle \right) =K\left( \left\vert 
{\bf e}\right\rangle \right) {\Bbb B}=\left( \left\vert {\bf e}\right\rangle
\right) {\Bbb B}^{\ast }
\end{equation}

The transpose ${\cal B}^{t}$ can then be defined in terms of $K$ and the
adjoint operation as 
\begin{equation}
{\cal B}^{t}=\left( {\cal B}^{\dagger }\right) ^{\ast }=K{\cal B}^{\dagger }K
\end{equation}
