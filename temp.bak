The fermionic operator $a_i^\dagger a_j^\dagger a_k a_l $ expands in the
Majorana basis as:

\begin{equation}
\begin{split}
a_{i}^{\dagger }a_{j}^{\dagger }a_{k}a_{l}=\frac{1}{16}\Big[& \gamma
_{2i-1}\gamma _{2j-1}\gamma _{2k-1}\gamma _{2l-1}+i\gamma _{2i-1}\gamma
_{2j-1}\gamma _{2k-1}\gamma _{2l}-i\gamma _{2i-1}\gamma _{2j-1}\gamma
_{2k}\gamma _{2l-1}+\gamma _{2i-1}\gamma _{2j-1}\gamma _{2k}\gamma
_{2l}+i\gamma _{2i-1}\gamma _{2j}\gamma _{2k-1}\gamma _{2l-1}-\gamma
_{2i-1}\gamma _{2j}\gamma _{2k-1}\gamma _{2l} \\
+& \gamma _{2i-1}\gamma _{2j}\gamma _{2k}\gamma _{2l-1}+i\gamma
_{2i-1}\gamma _{2j}\gamma _{2k}\gamma _{2l}-i\gamma _{2i}\gamma
_{2j-1}\gamma _{2k-1}\gamma _{2l-1}+\gamma _{2i}\gamma _{2j-1}\gamma
_{2k-1}\gamma _{2l}-\gamma _{2i}\gamma _{2j-1}\gamma _{2k}\gamma _{2l-1} \\
-& i\gamma _{2i}\gamma _{2j-1}\gamma _{2k}\gamma _{2l}+\gamma _{2i}\gamma
_{2j}\gamma _{2k-1}\gamma _{2l-1}+i\gamma _{2i}\gamma _{2j}\gamma
_{2k-1}\gamma _{2l}-i\gamma _{2i}\gamma _{2j}\gamma _{2k}\gamma
_{2l-1}+\gamma _{2i}\gamma _{2j}\gamma _{2k}\gamma _{2l}\Big]
\end{split}%
\end{equation}

where $\gamma _{\mu }$ are Majorana operators satisfying $\{\gamma _{\mu
},\gamma _{\nu }\}=2\delta _{\mu \nu }$.

$a_{i}^{\dagger }a_{j}^{\dagger }a_{k}a_{l}=\frac{1}{16}\Big[\gamma
_{2i-1}\gamma _{2j-1}\gamma _{2k-1}\gamma _{2l-1}+i\gamma _{2i-1}\gamma
_{2j-1}\gamma _{2k-1}\gamma _{2l}-i\gamma _{2i-1}\gamma _{2j-1}\gamma
_{2k}\gamma _{2l-1}+\gamma _{2i-1}\gamma _{2j-1}\gamma _{2k}\gamma
_{2l}+i\gamma _{2i-1}\gamma _{2j}\gamma _{2k-1}\gamma _{2l-1}-\gamma
_{2i-1}\gamma _{2j}\gamma _{2k-1}\gamma _{2l}$%
\begin{equation}
a_{i}^{\dagger }a_{j}^{\dagger }a_{k}a_{l}=\frac{1}{16}\Big[\gamma
_{2i-1}\gamma _{2j-1}\gamma _{2k-1}\gamma _{2l-1}+i\gamma _{2i-1}\gamma
_{2j-1}\gamma _{2k-1}\gamma _{2l}-i\gamma _{2i-1}\gamma _{2j-1}\gamma
_{2k}\gamma _{2l-1}+\gamma _{2i-1}\gamma _{2j-1}\gamma _{2k}\gamma
_{2l}+i\gamma _{2i-1}\gamma _{2j}\gamma _{2k-1}\gamma _{2l-1}-\gamma
_{2i-1}\gamma _{2j}\gamma _{2k-1}\gamma _{2l}
\end{equation}

$+\gamma _{2i-1}\gamma _{2j}\gamma _{2k}\gamma _{2l-1}+i\gamma _{2i-1}\gamma
_{2j}\gamma _{2k}\gamma _{2l}-i\gamma _{2i}\gamma _{2j-1}\gamma
_{2k-1}\gamma _{2l-1}+\gamma _{2i}\gamma _{2j-1}\gamma _{2k-1}\gamma
_{2l}-\gamma _{2i}\gamma _{2j-1}\gamma _{2k}\gamma _{2l-1}-i\gamma
_{2i}\gamma _{2j-1}\gamma _{2k}\gamma _{2l}+\gamma _{2i}\gamma _{2j}\gamma
_{2k-1}\gamma _{2l-1}$%
\begin{equation}
+\gamma _{2i-1}\gamma _{2j}\gamma _{2k}\gamma _{2l-1}+i\gamma _{2i-1}\gamma
_{2j}\gamma _{2k}\gamma _{2l}-i\gamma _{2i}\gamma _{2j-1}\gamma
_{2k-1}\gamma _{2l-1}+\gamma _{2i}\gamma _{2j-1}\gamma _{2k-1}\gamma
_{2l}-\gamma _{2i}\gamma _{2j-1}\gamma _{2k}\gamma _{2l-1}-i\gamma
_{2i}\gamma _{2j-1}\gamma _{2k}\gamma _{2l}+\gamma _{2i}\gamma _{2j}\gamma
_{2k-1}\gamma _{2l-1}
\end{equation}

\end{document}
