\right) \mathcal{R}_{\mathbf{E}\otimes \mathbf{E}}\left( X\right) \\
\shortparallel \\
\sum_{1\leq j,k,p,q\leq r}\overset{}{E_{jk}}\left\langle \left. \overset{}{%
E_{pq}}\right\vert \left( {}\right) \right\rangle _{\mathcal{B}\left( 
\mathcal{F}\right) }\mathcal{R}_{\mathbf{E}\otimes \mathbf{E}}\left(
X\right) _{jkpq}.
\end{gather}

\item 
\begin{gather}
\Xi _{\mathcal{\wedge }\left( \mathbb{C}^{r}\right) \mathcal{\wedge }\left( 
