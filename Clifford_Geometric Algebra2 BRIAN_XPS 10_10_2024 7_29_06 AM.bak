\item $k=l=3,\,I=\left\{ 1,2,3\right\} ,J=\left\{ 1,3,4\right\} $%
\begin{equation}
A\left( I,J\right) =A\left( \overset{}{\left\{ 1,2,3\right\} ,\left\{
1,3,4\right\} }\right) =\left( 
\begin{array}{cccc}
A_{11} & \mathrm{A}_{12} & A_{13} & A_{14} \\ 
A_{21} & \mathrm{A}_{22} & A_{23} & A_{24} \\ 
A_{31} & \mathrm{A}_{32} & A_{33} & A_{34} \\ 
\mathrm{A}_{43} & \mathrm{A}_{42} & \mathrm{A}_{43} & \mathrm{A}_{44} \\ 
\mathrm{A}_{53} & \mathrm{A}_{52} & \mathrm{A}_{53} & \mathrm{A}_{54} \\ 
