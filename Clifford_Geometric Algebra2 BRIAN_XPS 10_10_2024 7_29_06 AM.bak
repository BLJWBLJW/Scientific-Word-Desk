\item $k=l=1,\,I=\left\{ 1\right\} ,J=\left\{ 3\right\} $%
\begin{equation}
A\left( I,J\right) =A\left( \overset{}{\left\{ 1\right\} ,\left\{ 3\right\} }%
\right) =\left( 
\begin{array}{cccc}
