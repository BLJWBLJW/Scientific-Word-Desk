\paragraph{Exponential of Projectors in Jordan Algebras}

\begin{equation}
\exp \left\{ \alpha P\right\} =I_{\mathcal{F}}+\alpha P+\frac{1}{2!}\alpha
^{2}P+\frac{1}{3!}\alpha ^{3}P+\cdots =I_{\mathcal{F}}+P\left( e^{\alpha
}-1\right)
\end{equation}%
and%
\begin{equation}
\exp _{\ast }\left( \alpha P\right) =\exp \left( \alpha P\right) =I_{%
\mathcal{F}}+\alpha P+\frac{1}{2}\alpha ^{2}P^{2\ast }+\cdots =I_{\mathcal{F}%
}+\alpha P+\frac{1}{2!}\alpha ^{2}P+\frac{1}{3!}\alpha ^{3}P+\cdots =I_{%
\mathcal{F}}+P\left( e^{\alpha }-1\right) .
\end{equation}

\begin{remark}
Let $\alpha =1$ then 
\begin{gather}
\exp \left( P\right) =I_{\mathcal{F}}+P\left( e-1\right) \\
\Downarrow \\
P=\left( e-1\right) ^{-1}\left( \exp \left( P\right) -I_{\mathcal{F}}\right)
.
\end{gather}
\end{remark}

\begin{theorem}
\begin{equation}
\exp \left\{ A\right\} =I_{\mathcal{F}}+e^{1}A\Leftrightarrow A=A^{2},\quad
A\in \mathcal{F}
\end{equation}%
\begin{equation}
\text{for}
\end{equation}%
\begin{equation}
A\geq 0.
\end{equation}
\end{theorem}

\begin{proof}
\begin{eqnarray}
\exp \left\{ A\right\} &=&I_{\mathcal{F}}+\alpha A+\frac{1}{2!}\alpha
^{2}A^{2}+\frac{1}{3!}\alpha ^{3}A^{3}+\cdots =I_{\mathcal{F}}+A\left(
e^{\alpha }-1\right) \\
&=&I_{\mathcal{F}}+A\left( 1+\alpha +\frac{1}{2!}\alpha ^{2}+\frac{1}{3!}%
\alpha ^{3}+\cdots -1\right) =I_{\mathcal{F}}+A\left( \alpha +\frac{1}{2!}%
\alpha ^{2}+\frac{1}{3!}\alpha ^{3}+\cdots \right) \\
&=&I_{\mathcal{F}}+\alpha A+\frac{1}{2!}\alpha ^{2}A+\frac{1}{3!}\alpha
^{3}A+\cdots
\end{eqnarray}%
As this is true $\forall \alpha \in \mathbb{C}$ the operator coefficients of 
$\alpha ^{n}$ must be equal i.e. 
\begin{equation*}
A^{n}=A,\,1\leq n<\infty
\end{equation*}%
Using the spectral theorem 
\begin{equation}
A=\int_{\mathbb{R}^{+}}xdP_{A}\left( x\right)
\end{equation}%
this gives%
\begin{equation}
\int_{\mathbb{R}^{+}}x^{n}dP_{A}\left( x\right) =\int_{\mathbb{R}%
^{+}}xdP_{A}\left( x\right) \Longleftrightarrow \int_{\mathbb{R}^{+}}\left(
x^{n}-x\right) dP_{A}\left( x\right) \Longleftrightarrow
x^{n}=x\Longleftrightarrow x\left( x^{n-1}-1\right) =0.
\end{equation}%
As $x\geq 0$ then $x=1$ or $0$ $\Rightarrow $ $A$ must be a projector i.e. 
\begin{equation}
A=A^{2}.
\end{equation}
\end{proof}

\begin{remark}
\begin{equation}
\exp _{\ast }\left\{ A\right\} =\exp \left\{ A\right\} ,\quad A\in \mathcal{F%
}_{sa}.
\end{equation}
\end{remark}

The set $\left\{ \left. X_{j_{1}}\cdots _{j_{n}}\right\vert 1\leq
j_{1}<\cdots <j_{n}\leq 2r,0\leq n\leq 2r\right\} $ forms a basis for the
Jordan algebra $\mathfrak{h}_{\mathcal{F}}\left( \mathbb{R}\right) $ and the
real self adjoint $\mathcal{F}_{sa}$ subspace of $\mathcal{F}$ 
\begin{eqnarray}
\exp _{\ast }\left( P\right) &=&\exp _{\ast }\left\{ \sum_{0\leq n\leq
2r}\sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}\eta _{nj_{1\cdots
}j_{n}}X_{j_{1}}\cdots _{j_{n}}\right\} =\tprod\limits_{0\leq n\leq 2r}\exp
_{\ast }\left\{ \sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}\eta _{nj_{1\cdots
}j_{n}}X_{j_{1}}\cdots _{j_{n}}\right\} \\
&=&\tprod\limits_{0\leq n\leq 2r}\tprod\limits_{1\leq j_{1}<\cdots
<j_{n}\leq 2r}\exp _{\ast }\left\{ \eta _{nj_{1\cdots }j_{n}}X_{j_{1}}\cdots
_{j_{n}}\right\} .
\end{eqnarray}

\begin{example}
$r=1$

\begin{enumerate}
\item 
\begin{align}
\exp \left\{ P_{2}\left( \mathbf{\eta }\right) \right\} & =\exp _{\ast
}\left\{ \sum_{0\leq n\leq 2}\sum_{1\leq j_{1}<j_{2}\leq 2}\eta
_{nj_{1\cdots }j_{2}}i\widetilde{x}_{j_{1}}\widetilde{x}_{j_{2}}\right\}
=\tprod\limits_{0\leq n\leq 2}\exp _{\ast }\left\{ \sum_{1\leq
j_{1}<j_{2}\leq 2}\eta _{nj_{1}j_{2}}i\widetilde{x}_{j_{1}}\widetilde{x}%
_{j_{2}}\right\} \\
& =\exp _{\ast }\left\{ \eta _{00}I_{\mathcal{F}}\right\} \ast \exp _{\ast
}\left\{ \sum_{1\leq j_{1}\leq 2}\eta _{1j_{1}}\widetilde{x}_{j_{1}}\right\}
\ast \exp _{\ast }\left\{ \sum_{1\leq j_{1}<j_{2}\leq 2}\eta _{2j_{1}j_{2}}i%
\widetilde{x}_{j_{1}}\widetilde{x}_{j_{2}}\right\} \\
& =\exp _{\ast }\left\{ \overset{}{\eta _{00}I_{\mathcal{F}}}\right\} \ast
\exp _{\ast }\left\{ \overset{}{\eta _{11}\widetilde{x}_{1}+\eta _{12}%
\widetilde{x}_{2}}\right\} \ast \exp _{\ast }\left\{ \overset{}{\eta _{212}i%
\widetilde{x}_{1}\widetilde{x}_{2}}\right\} \\
& =\exp _{\ast }\left\{ \overset{}{\eta _{00}I_{\mathcal{F}}}\right\} \ast
\exp _{\ast }\left\{ \eta _{11}\widetilde{x}_{1}\right\} \ast \exp _{\ast
}\left\{ \overset{}{\eta _{12}\widetilde{x}_{2}}\right\} \ast \exp _{\ast
}\left\{ \overset{}{\eta _{212}i\widetilde{x}_{1}\widetilde{x}_{2}}\right\} .
\end{align}

\item 
\begin{gather}
\exp _{\ast }\left\{ \eta _{11}X_{1}\right\} =\exp _{\ast }\left\{ \eta _{11}%
\widetilde{x_{1}}\right\} \\
=\exp \left\{ \eta _{11}\widetilde{x_{1}}\right\} =I_{\mathcal{F}}+\eta _{11}%
\widetilde{x_{1}}+\frac{1}{2}\eta _{11}^{2}\widetilde{x_{1}}^{2}+\frac{1}{3!}%
\eta _{11}^{3}\widetilde{x_{1}}^{3}+\cdots =I_{\mathcal{F}}+\eta _{11}%
\widetilde{x_{1}}+\frac{1}{2!}\eta _{11}^{2}I_{\mathcal{F}}+\frac{1}{3!}\eta
_{11}^{3}\widetilde{x_{1}}+\frac{1}{4!}\eta _{11}^{4}I_{\mathcal{F}}+\cdots
\\
=\left( 1+\frac{1}{2!}\eta _{11}^{2}+\frac{1}{4!}\eta _{11}^{4}+\cdots
\right) I_{\mathcal{F}}+\left( \eta _{11}+\frac{1}{3!}\eta _{11}^{3}+\cdots
\right) \widetilde{x_{1}} \\
=\cosh \left( \eta _{11}\right) I_{\mathcal{F}}+\sinh \left( \eta
_{11}\right) \widetilde{x_{1}},
\end{gather}%
i.e. 
\begin{equation}
\exp _{\ast }\left\{ \eta _{11}X_{1}\right\} =\cosh \left( \eta _{11}\right)
I_{\mathcal{F}}+\sinh \left( \eta _{11}\right) \widetilde{x_{1}}.
\end{equation}

\item 
\begin{gather}
\exp _{\ast }\left\{ \eta _{212}X_{12}\right\} =\exp _{\ast }\left\{ \eta
_{212}X_{12}\right\} =\exp \left\{ \eta _{212}X_{12}\right\} =\exp _{\ast
}\left\{ ix_{1}x_{2}\right\} =I_{\mathcal{F}}+\eta _{212}i\widetilde{%
x_{1}x_{2}}+\frac{1}{2}\eta _{212}^{2}\left( i\widetilde{x_{1}x_{2}}\right)
^{2}+\frac{1}{3!}\eta _{212}^{3}\left( i\widetilde{x_{1}x_{2}}\right)
^{2}+\cdots \\
=I_{\mathcal{F}}+\eta _{212}i\widetilde{x_{1}x_{2}}+\frac{1}{2!}\eta
_{212}^{2}I_{\mathcal{F}}+\frac{1}{3!}\eta _{212}^{2}\left( i\widetilde{%
x_{1}x_{2}}\right) ^{3}+\frac{1}{4!}\eta _{212}^{2}I_{\mathcal{F}}+\cdots \\
=\left( 1+\eta _{212}+\frac{1}{3!}\eta _{212}^{3}+\cdots \right) I_{\mathcal{%
F}}+\left( \eta _{212}+\frac{1}{3!}\eta _{212}^{2}+\cdots \right) i%
\widetilde{x_{1}x_{2}} \\
=\cosh \left( \eta _{212}\right) I_{\mathcal{F}}+\sinh \left( \eta
_{212}\right) i\widetilde{x_{1}x_{2}},
\end{gather}%
i.e.%
\begin{equation}
\exp _{\ast }\left\{ \eta _{212}X_{12}\right\} =\cosh \left( \eta
_{212}\right) I_{\mathcal{F}}+\sinh \left( \eta _{212}\right) i\widetilde{%
x_{1}x_{2}}.
\end{equation}

\item 
\begin{equation}
\left( a+b\right) \left( c+d\right) \left( e+f\right) =\left(
ac+ad+bc+bd\right) \left( e+f\right) =ace+ade+bce+bde+acf+adf+bcf+bdf
\end{equation}%
giving%
\begin{gather}
\exp _{\ast }\left\{ \overset{}{\eta _{00}I_{\mathcal{F}}}\right\} \ast \exp
_{\ast }\left\{ \eta _{11}\widetilde{x}_{1}\right\} \ast \exp _{\ast
}\left\{ \overset{}{\eta _{12}\widetilde{x}_{2}}\right\} \ast \exp _{\ast
}\left\{ \overset{}{\eta _{212}i\widetilde{x}_{1}\widetilde{x}_{2}}\right\}
\\
\parallel \\
=e^{\eta _{00}}\left( \cosh \left( \eta _{11}\right) I_{\mathcal{F}}+\sinh
\left( \eta _{11}\right) \widetilde{x_{1}}\right) \ast \left( \cosh \left(
\eta _{12}\right) I_{\mathcal{F}}+\sinh \left( \eta _{12}\right) \widetilde{%
x_{2}}\right) \ast \left( \cosh \left( \eta _{212}\right) I_{\mathcal{F}%
}+\sinh \left( \eta _{212}\right) i\widetilde{x_{1}x_{2}}\right) \\
\parallel \\
e^{\eta _{00}}\left( \left( \overset{}{\cosh \left( \eta _{11}\right) \cosh
\left( \eta _{12}\right) \cosh \left( \eta _{212}\right) }\right) I_{%
\mathcal{F}}+\left( \overset{}{\sinh \left( \eta _{11}\right) \cosh \left(
\eta _{12}\right) \cosh \left( \eta _{212}\right) \widetilde{x_{1}}+\cosh
\left( \eta _{11}\right) \sinh \left( \eta _{12}\right) \cosh \left( \eta
_{212}\right) \widetilde{x_{2}}}\right) \right. \\
+\left( \overset{}{\sinh \left( \eta _{11}\right) \sinh \left( \eta
_{12}\right) \cosh \left( \eta _{212}\right) \widetilde{x_{1}}\ast 
\widetilde{x_{2}}}\right) \\
+\left( \overset{}{\cosh \left( \eta _{11}\right) \cosh \left( \eta
_{12}\right) \sinh \left( \eta _{212}\right) i\widetilde{x_{1}x_{2}}+\cosh
\left( \eta _{11}\right) \sinh \left( \eta _{12}\right) \sinh \left( \eta
_{212}\right) \widetilde{x_{2}}\ast i\widetilde{x_{1}x_{2}}+\sinh \left(
\eta _{11}\right) \cosh \left( \eta _{12}\right) \sinh \left( \eta
_{212}\right) \widetilde{x_{1}}\ast i\widetilde{x_{1}x_{2}}}\right) \\
+\left. \left( \overset{}{\sinh \left( \eta _{11}\right) \sinh \left( \eta
_{12}\right) \sinh \left( \eta _{212}\right) }\right) \widetilde{x_{1}}\ast 
\widetilde{x_{2}}\ast i\widetilde{x_{1}x_{2}}\right)
\end{gather}%
\begin{gather}
\parallel \\
e^{\eta _{00}}\left( \left( \overset{}{\cosh \left( \eta _{11}\right) \cosh
\left( \eta _{12}\right) \cosh \left( \eta _{212}\right) }\right) I_{%
\mathcal{F}}+\left( \overset{}{\sinh \left( \eta _{11}\right) \cosh \left(
\eta _{12}\right) \cosh \left( \eta _{212}\right) \widetilde{x_{1}}+\cosh
\left( \eta _{11}\right) \sinh \left( \eta _{12}\right) \cosh \left( \eta
_{212}\right) \widetilde{x_{2}}}\right) \right. \\
+\left. \left( \overset{}{\cosh \left( \eta _{11}\right) \cosh \left( \eta
_{12}\right) \sinh \left( \eta _{212}\right) i\widetilde{x_{1}x_{2}}}\right)
\right)
\end{gather}%
Recall 
\begin{equation}
\exp \left\{ \alpha P\right\} =I_{\mathcal{F}}+P\left( e^{\alpha }-1\right)
\end{equation}%
then the idempotency constriant condition gives 
\begin{gather}
e^{\eta _{00}}\left( \left( \overset{}{\cosh \left( \eta _{11}\right) \cosh
\left( \eta _{12}\right) \cosh \left( \eta _{212}\right) }\right) I_{%
\mathcal{F}}+\left( \overset{}{\sinh \left( \eta _{11}\right) \cosh \left(
\eta _{12}\right) \cosh \left( \eta _{212}\right) \widetilde{x_{1}}+\cosh
\left( \eta _{11}\right) \sinh \left( \eta _{12}\right) \cosh \left( \eta
_{212}\right) \widetilde{x_{2}}}\right) \right. \\
\left. +\left( \overset{}{\cosh \left( \eta _{11}\right) \cosh \left( \eta
_{12}\right) \sinh \left( \eta _{212}\right) i\widetilde{x_{1}x_{2}}}\right)
\right) \\
\parallel \\
I_{\mathcal{F}}+e^{1}\left( \overset{}{\eta _{11}\widetilde{x_{1}}+\eta _{12}%
\widetilde{x_{2}}+\eta _{212}i\widetilde{x_{1}x_{2}}}\right)
\end{gather}%
giving%
\begin{eqnarray}
e^{\eta _{00}}\left( \cosh \left( \eta _{11}\right) \cosh \left( \eta
_{12}\right) \cosh \left( \eta _{212}\right) \right) &=&1 \\
e^{\eta _{00}}\sinh \left( \eta _{11}\right) \cosh \left( \eta _{12}\right)
\cosh \left( \eta _{212}\right) &=&e^{1}\eta _{11} \\
e^{\eta _{00}}\cosh \left( \eta _{11}\right) \sinh \left( \eta _{12}\right)
\cosh \left( \eta _{212}\right) &=&e^{1}\eta _{12} \\
e^{\eta _{00}}\cosh \left( \eta _{11}\right) \cosh \left( \eta _{12}\right)
\sinh \left( \eta _{212}\right) &=&e^{1}\eta _{212}.
\end{eqnarray}%
\begin{gather}
\Downarrow \\
\tanh \left( \eta _{11}\right) =e^{\left( 1-\eta _{00}\right) }\eta
_{11}\Leftrightarrow \tanh \left( \eta _{11}\right) -e^{\left( 1-\eta
_{00}\right) }\eta _{11}=0 \\
\tanh \left( \eta _{12}\right) =e^{\left( 1-\eta _{00}\right) }\eta
_{12}\Leftrightarrow \tanh \left( \eta _{12}\right) -e^{\left( 1-\eta
_{00}\right) }\eta _{12}=0 \\
\tanh \left( \eta _{212}\right) =e^{\left( 1-\eta _{00}\right) }\eta
_{212}.\Leftrightarrow \tanh \left( \eta _{212}\right) -e^{\left( 1-\eta
_{00}\right) }\eta _{212}=0
\end{gather}
\end{enumerate}
\end{example}

\begin{example}
