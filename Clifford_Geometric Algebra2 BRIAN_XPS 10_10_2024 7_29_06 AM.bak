\\
&=&-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}
\end{eqnarray}%
these results give
\end{enumerate}

