\left( \mathbf{E}\right) \left( \left\langle \left. \mathbf{E}\right\vert
\left( {}\right) \right\rangle _{\mathcal{B}\left( \mathcal{F}\right)
}\right) ^{t}\mathcal{R}_{\mathbf{EE}}\left( \mathbb{X}\right) ,
\end{gather}%
where $\left( \mathbf{E}\right) $ is the row vector of elementay matrices

