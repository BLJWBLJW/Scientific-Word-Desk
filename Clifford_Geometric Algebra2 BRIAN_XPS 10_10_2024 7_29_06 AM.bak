j_{1}<j_{2}\leq 2r}\eta _{nj_{1}j_{2}}i\widetilde{x}_{j_{1}}\widetilde{x}%
_{j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}\eta _{nj_{1}j_{2}}i\widetilde{%
x}_{j_{1}}\widetilde{x}_{j_{2}}\widetilde{x}_{j_{3}}.
\end{eqnarray}
