\item $k=l=2,\,I=\left\{ 1,3\right\} ,J=\left\{ 1,2\right\} $%
\begin{equation}
A\left( I,J\right) =A\left( \overset{}{\left\{ 1,3\right\} ,\left\{
1,2\right\} }\right) =\left( 
\begin{array}{cccc}
A_{11} & A_{12} & \mathrm{A}_{13} & \mathrm{A}_{14} \\ 
\mathrm{A}_{21} & \mathrm{A}_{22} & \mathrm{A}_{23} & \mathrm{A}_{24} \\ 
A_{31} & A_{32} & \mathrm{A}_{33} & \mathrm{A}_{34} \\ 
\mathrm{A}_{43} & \mathrm{A}_{42} & \mathrm{A}_{43} & \mathrm{A}_{44} \\ 
\mathrm{A}_{53} & \mathrm{A}_{52} & \mathrm{A}_{53} & \mathrm{A}_{54} \\ 
\mathrm{A}_{63} & \mathrm{A}_{62} & \mathrm{A}_{63} & \mathrm{A}_{64}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
A_{11} & A_{12} \\ 
A_{31} & A_{32}%
\end{array}%
\right)
\end{equation}

\item $k=l=1,\,I=\left\{ 1\right\} ,J=\left\{ 2\right\} $%
\begin{equation}
A\left( I,J\right) =A\left( \overset{}{\left\{ 1\right\} ,\left\{ 2\right\} }%
\right) =\left( 
\begin{array}{cccc}
\mathrm{A}_{11} & A_{12} & \mathrm{A}_{13} & \mathrm{A}_{14} \\ 
\mathrm{A}_{21} & \mathrm{A}_{22} & \mathrm{A}_{23} & \mathrm{A}_{24} \\ 
\mathrm{A}_{31} & \mathrm{A}_{32} & \mathrm{A}_{33} & \mathrm{A}_{34} \\ 
\mathrm{A}_{43} & \mathrm{A}_{42} & \mathrm{A}_{43} & \mathrm{A}_{44} \\ 
\mathrm{A}_{53} & \mathrm{A}_{52} & \mathrm{A}_{53} & \mathrm{A}_{54} \\ 
\mathrm{A}_{63} & \mathrm{A}_{62} & \mathrm{A}_{63} & \mathrm{A}_{64}%
\end{array}%
\right) =\left( 
\begin{array}{c}
A_{12}%
\end{array}%
\right)
\end{equation}

\item $k=5,l=3,\,I=\left\{ 1,3,4,5,6\right\} ,J=\left\{ 1,2,3\right\} $%
\begin{equation}
A\left( I,J\right) =A\left( \overset{}{\left\{ 1,3,4,5,6\right\} ,\left\{
1,2,3\right\} }\right) =\left( 
\begin{array}{cccc}
A_{11} & A_{12} & A_{13} & \mathrm{A}_{14} \\ 
\mathrm{A}_{21} & \mathrm{A}_{22} & \mathrm{A}_{23} & \mathrm{A}_{24} \\ 
A_{31} & A_{32} & A_{33} & \mathrm{A}_{34} \\ 
A_{43} & A_{42} & A_{43} & \mathrm{A}_{44} \\ 
A_{53} & A_{52} & A_{53} & \mathrm{A}_{54} \\ 
A_{63} & A_{62} & A_{63} & \mathrm{A}_{64}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
A_{11} & A_{12} & A_{13} \\ 
A_{31} & A_{32} & A_{33} \\ 
A_{43} & A_{42} & A_{43} \\ 
A_{53} & A_{52} & A_{53} \\ 
A_{63} & A_{62} & A_{63}%
\end{array}%
\right)
\end{equation}
\end{enumerate}
\end{example}

\begin{lemma}
If $k=l$ the $A\left( I,J\right) $ is a square matrix.
\end{lemma}

\begin{proof}
The number of rows indexed by 
\begin{equation}
I=\left\{ i_{1}<\cdots <i_{k}\right\} \subset \left\{ 1,\cdots ,p\right\} =k
\end{equation}

The number of columns indexed by 
\begin{equation}
J=\left\{ j_{1}<\cdots <j_{k}\right\} \subset \left\{ 1,\cdots ,q\right\} =k
\end{equation}

Thus 
\begin{equation}
\divideontimes \func{row}\left\{ A\left( I,J\right) \right\} =\divideontimes 
\func{col}\left\{ A\left( I,J\right) \right\} =k.
\end{equation}
\end{proof}

\begin{definition}
If $p=q$ the $\left( I,J\right) $-\emph{minor} $\mathfrak{m}\left( A\right)
_{IJ}$ of the matrix $A$ is 
\begin{equation}
\mathfrak{m}\left( A\right) _{IJ}=\det \left\{ A\left( I,J\right) \right\} .
\end{equation}
\end{definition}

\begin{definition}
If $k=l$ the $\left( I,J\right) $-\emph{cofactor} $\mathfrak{c}\left(
A\right) _{IJ}$ of the matrix $A$ is 
\begin{equation}
\mathfrak{c}\left( A\right) _{IJ}=\left( -1\right) ^{r+s}\det \left\{
A\left( I,J\right) \right\} .
\end{equation}
\end{definition}

\begin{definition}
The $k^{th}${\large \thinspace compound matrix} $\mathfrak{C}_{k}\left(
A\right) $ of a $p\times q$ is a matrix $A$ is defined as follows: If $%
k>\min (p,q)$, then $\mathfrak{C}_{k}\left( A\right) $ is the unique $%
0\,\times \,0$ matrix. Otherwise, $\mathfrak{C}_{k}\left( A\right) $ has
size $\binom{p}{k}\times \binom{q}{k}$. Its rows and columns are indexed by $%
k$-element subsets $I$ of $\{1,...,p\}$ and $k$-element subsets $J$ of $%
\{1,...,q\}$ in their lexicographic order. The entry corresponding to
subsets $I$ and $J$ is the minor $\det \left\{ A\left( I,J\right) \right\} $.
\end{definition}

\begin{remark}
In some applications of compound matrices, the precise ordering of the rows
and columns is unimportant. For this reason, some authors do not specify how
the rows and columns are to be ordered.
\end{remark}

\begin{remark}
\begin{equation}
\det \left\{ A\right\} =\det \left\{ A^{t}\right\} .
\end{equation}
\end{remark}

\begin{remark}
Let $A\in \mathcal{M}\left( n,m,\mathbb{C}\right) ,B\in \mathcal{M}\left(
m,l,\mathbb{C}\right) ,X\in \mathcal{M}\left( n,n,\mathbb{C}\right) $ and $%
1\leq p\leq \min \{n,m,l\}$, then one has

\begin{enumerate}
\item \emph{Binet-Cauchy Theorem} $\mathfrak{C}_{p}(AB)$ $=$ $\mathfrak{C}%
_{p}(A)\mathfrak{C}_{p}(B)$.

\item If $A$ is unitary, then $\mathfrak{C}_{p}(A)$ is unitary.

\item If $X$ is diagonal, then $\mathfrak{C}_{p}(X)$ is diagonal.

\item If $X$ is upper (lower) triangular, then $\mathfrak{C}_{p}(X)$ is
upper (lower) triangular.

\item \emph{Silvester-Franke Theorem} $\det \left\{ \mathfrak{C}%
_{p}(X)\right\} =\det \left\{ X\right\} ^{\binom{n-1}{p-1}}$

\item $\mathfrak{C}_{p}\left( A^{t}\right) $ $=$ $\mathfrak{C}_{p}\left(
A\right) ^{t}$
\end{enumerate}
\end{remark}

\begin{example}
For example, consider the $6\times 3$ matrix%
\begin{equation}
A=\left( 
\begin{array}{ccc}
A_{11} & A_{12} & A_{13} \\ 
A_{21} & A_{22} & A_{23} \\ 
A_{31} & A_{32} & A_{33} \\ 
A_{41} & A_{42} & A_{43} \\ 
A_{51} & A_{52} & A_{53} \\ 
A_{61} & A_{62} & A_{63}%
\end{array}%
\right) .
\end{equation}%
The rows are indexed by $\{1,2,3,4,5,6\}$ and the columns by $\{1,2,3\}$
producing $\binom{6}{2}\times \binom{3}{2}=45$ sub matrices, in particular 
\begin{equation}
A\left( \left\{ 4,5\right\} ,\left\{ 2,3\right\} \right) =\left( 
\begin{array}{ccc}
\mathrm{A}_{11} & \mathrm{A}_{12} & \mathrm{A}_{13} \\ 
\mathrm{A}_{21} & \mathrm{A}_{22} & \mathrm{A}_{23} \\ 
\mathrm{A}_{31} & \mathrm{A}_{32} & \mathrm{A}_{33} \\ 
\mathrm{A}_{41} & A_{42} & A_{43} \\ 
\mathrm{A}_{51} & A_{52} & A_{53} \\ 
\mathrm{A}_{61} & \mathrm{A}_{62} & \mathrm{A}_{63}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
A_{42} & A_{43} \\ 
A_{52} & A_{53}%
\end{array}%
\right)
\end{equation}%
giving the matrix element $\left( \left( 4,5\right) \left( 2,3\right)
\right) $ of the $\binom{6}{2}\times \binom{3}{2}$ second compound matrix $%
\mathfrak{C}_{2}\left( A\right) $ 
\begin{equation}
\mathfrak{C}_{2}\left( A\right) _{\left( 4,5\right) \left( 2,3\right) }=\det
\left\{ A\left\{ 4,5\right\} ,\left\{ 2,3\right\} \right\} =\det \left\{
\left( 
\begin{array}{cc}
A_{42} & A_{43} \\ 
A_{52} & A_{53}%
\end{array}%
\right) \right\}
\end{equation}%
and hence 
\begin{equation}
\mathfrak{C}_{2}\left( A\right) _{\left( i_{1}i_{2}\right) \left(
j_{1}j_{2}\right) }=\det \left\{ \left( 
\begin{array}{cc}
A_{i_{1}j_{1}} & A_{i_{1}j_{2}} \\ 
A_{i_{2}j_{1}} & A_{i_{2}j_{2}}%
\end{array}%
\right) \right\} .
\end{equation}
\end{example}

\begin{example}
\begin{equation}
A=\left( 
\begin{array}{cc}
A_{11} & A_{12} \\ 
A_{21} & A_{22} \\ 
A_{31} & A_{32} \\ 
A_{41} & A_{42} \\ 
A_{51} & A_{52} \\ 
A_{61} & A_{62}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
A_{11} & A_{12} & \mathrm{A}_{13} \\ 
A_{21} & A_{22} & \mathrm{A}_{23} \\ 
A_{31} & A_{32} & \mathrm{A}_{33} \\ 
A_{41} & A_{42} & \mathrm{A}_{43} \\ 
A_{51} & A_{52} & \mathrm{A}_{53} \\ 
A_{61} & A_{62} & \mathrm{A}_{63}%
\end{array}%
\right)
\end{equation}%
The rows are indexed by $\{1,2,3,4,5,6\}$ and the columns by $\{1,2\}$
producing $\binom{6}{2}\times \binom{2}{2}=15$ sub matrices, in particular 
\begin{equation}
A\left( \left\{ 4,5\right\} ,\left\{ 1,2\right\} \right) =\left( 
\begin{array}{cc}
\mathrm{A}_{11} & \mathrm{A}_{12} \\ 
\mathrm{A}_{21} & \mathrm{A}_{22} \\ 
\mathrm{A}_{31} & \mathrm{A}_{32} \\ 
A_{41} & A_{42} \\ 
A_{51} & A_{52} \\ 
\mathrm{A}_{61} & \mathrm{A}_{62}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
A_{41} & A_{42} \\ 
A_{51} & A_{52}%
\end{array}%
\right)
\end{equation}%
giving the matrix element $\left( \left( 4,5\right) ,\left( 1,2\right)
\right) $ of the $\binom{6}{2}\times \binom{2}{2}$ second compound matrix $%
\mathfrak{C}_{2}\left( A\right) $ 
\begin{equation}
\mathfrak{C}_{2}\left( A\right) _{\left( 4,5\right) \left( 1,2\right) }=\det
\left\{ A\left( \left\{ 4,5\right\} ,\left\{ 1,2\right\} \right) \right\}
=\det \left\{ \left( 
\begin{array}{cc}
A_{43} & A_{42} \\ 
A_{53} & A_{52}%
\end{array}%
\right) \right\}
\end{equation}%
and hence 
\begin{equation}
\mathfrak{C}_{2}\left( A\right) _{\left( i_{1}i_{2}\right) \left(
j_{1}j_{2}\right) }=\det \left\{ \left( 
\begin{array}{cc}
A_{i_{1}j_{1}} & A_{i_{1}j_{2}} \\ 
A_{i_{2}j_{1}} & A_{i_{2}j_{2}}%
\end{array}%
\right) \right\} .
\end{equation}
\end{example}

\begin{example}
Consider 
\begin{equation}
A^{t}=\left( 
\begin{array}{cccccc}
A_{11} & A_{21} & A_{31} & A_{41} & A_{51} & A_{61} \\ 
A_{12} & A_{22} & A_{32} & A_{42} & A_{52} & A_{62}%
\end{array}%
\right)
\end{equation}%
then 
\begin{equation}
\mathfrak{C}_{2}\left( A^{t}\right) _{\left( 4,5\right) \left( 1,2\right) }=%
\mathfrak{C}_{2}\left( A\right) _{\left( 1,2\right) \left( 4,5\right) }=\det
\left\{ A\left( \left\{ 1,2\right\} ,\left\{ 4,5\right\} \right) \right\}
=\det \left\{ \left( 
\begin{array}{cc}
A_{43} & A_{53} \\ 
A_{42} & A_{52}%
\end{array}%
\right) \right\}
\end{equation}%
and hence 
\begin{equation}
\mathfrak{C}_{2}\left( A^{t}\right) _{\left( i_{1}i_{2}\right) \left(
j_{1}j_{2}\right) }=\mathfrak{C}_{2}\left( A\right) _{\left(
j_{1}j_{2}\right) \left( i_{1}i_{2}\right) }=\det \left\{ \left( 
\begin{array}{cc}
A_{i_{1}j_{1}} & A_{i_{2}j_{1}} \\ 
A_{i_{1}j_{2}} & A_{i_{2}j_{2}}%
\end{array}%
\right) \right\} .
\end{equation}
\end{example}

\begin{example}
\begin{eqnarray}
x_{1}\wedge x_{2} &=&\left( 2!\right) ^{-1}\sum_{\sigma \in S_{2}}\left(
-1\right) ^{\pi \left( \sigma \right) }x_{\sigma \left( 1\right) }\circ
x_{\sigma \left( 2\right) }=\frac{1}{2}\left( x_{1}x_{2}-x_{2}x_{1}\right)
=x_{1}x_{2} \\
x_{1}\wedge x_{1} &=&0 \\
x_{1}\wedge x_{2}\wedge x_{3} &=&\left( 3!\right) ^{-1}\sum_{\sigma \in
S_{2}}\left( -1\right) ^{\pi \left( \sigma \right) }x_{\sigma \left(
1\right) }\circ x_{\sigma \left( 2\right) }=\frac{1}{6}\left(
x_{1}x_{2}x_{3}-x_{1}x_{3}x_{2}-x_{2}x_{1}x_{3}+x_{3}x_{1}x_{2}-x_{3}x_{2}x_{1}+x_{2}x_{3}x_{1}\right) =x_{1}x_{2}x_{3}.
\end{eqnarray}
\end{example}

\begin{remark}
A basis for the exterior algebra is given by $\left\{ I_{\mathcal{F}%
},\left\{ \left. x_{j_{1}\cdots }x_{j_{n}}\right\vert 1\leq j_{1}<\cdots
<j_{n}\leq 2r;\quad 1\leq n\leq 2r\right\} \right\} $

This leads to the expansion 
\begin{equation}
A=A_{0}I_{\mathcal{F}}+\sum_{1\leq n\leq 2r}\sum_{1\leq j_{1}<\cdots
<j_{n}\leq 2r}A_{j_{1}\cdots j_{nr}}x_{j_{1}\cdots }x_{j_{n}}=A_{0}I_{%
\mathcal{F}}+\sum_{1\leq n\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{n}\leq
2r}A_{j_{1}\cdots j_{n}}x_{j_{1}\cdots }x_{j_{n}}.
\end{equation}
\end{remark}

\begin{remark}
The subspaces $\left\{ \left. \mathcal{F}_{n}\right\vert 0\leq n\leq
2r\right\} $ are disjoint and 
\begin{equation*}
I_{\mathcal{F}}\neq \sum_{1\leq n\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{n}\leq
2r}A_{j_{1}\cdots j_{nr}}x_{j_{1}\cdots }x_{j_{n}},\quad 1\leq n\leq 2r,
\end{equation*}%
one can show this do by considering the operator valued trace and noting
that it is zero on elements $n>0.\ $
\end{remark}

\begin{theorem}
If $A_{k}\in \mathcal{F}_{1}$ for $1\leq k\leq n$ then 
\begin{equation}
A_{k_{1}}\wedge \cdots \wedge A_{k_{n}}=\sum_{1\leq j_{1}<\cdots <j_{n}\leq
2r}x_{j_{1}\cdots }x_{j_{n}}A_{j_{1}\cdots j_{n}k_{1}\cdots
k_{n}}=\sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}x_{j_{1}\cdots
}x_{j_{n}}\left( A_{k_{1}}\wedge \cdots \wedge A_{k_{n}}\right)
_{j_{1}\cdots j_{n}}=\sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}x_{j_{1}\cdots
}x_{j_{n}}\mathfrak{C}_{r}\left( A\right) _{j_{1}\cdots j_{n}k_{1}\cdots
k_{n}},
\end{equation}%
where 
\begin{equation}
A_{k}=\sum_{1\leq j\leq 2r}x_{j}A_{jk}=\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
A_{1k} \\ 
\vdots \\ 
A_{2rk}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \mathcal{R}_{x}\left( A_{k}\right)
\end{equation}%
and 
\begin{equation}
A=\left( 
\begin{array}{cccc}
A_{11} & \cdots & \cdots & A_{2rn} \\ 
\vdots & \vdots & \vdots & \vdots \\ 
A_{2r1} & \cdots & \cdots & A_{2rn}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\mathcal{R}_{x}\left( A_{1}\right) \\ 
\vdots \\ 
\mathcal{R}_{x}\left( A_{n}\right)%
\end{array}%
\right) .
\end{equation}
\end{theorem}

\begin{proof}
Consider the matrix of $A$ in the $\mathcal{R}_{x}$ representation of three
vectors $\left\{ A_{1},A_{2},A_{3}\right\} $ in the $r=3$ case arranged in
columns i.e. 
\begin{equation}
A=\left( 
\begin{array}{ccc}
A_{11} & A_{12} & A_{13} \\ 
A_{21} & A_{22} & A_{23} \\ 
A_{31} & A_{32} & A_{33} \\ 
A_{41} & A_{42} & A_{43} \\ 
A_{51} & A_{52} & A_{53} \\ 
A_{61} & A_{62} & A_{63}%
\end{array}%
\right)
\end{equation}%
then the exterior product of $A_{1}$ and $A_{2}$ can be expanded as

\begin{enumerate}
\item 
\begin{eqnarray}
A_{1}\wedge A_{2} &=&\sum_{1\leq j_{1}<j_{2},\leq 2r}x_{j_{1}}\wedge
x_{j_{2}}\left( A_{1}\wedge A_{2}\right) _{j_{1}j_{2}}=\left( 
\begin{array}{ccc}
x_{1}x_{2} & \cdots & x_{2r-1}x_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( A_{1}\wedge A_{2}\right) _{12} \\ 
\vdots \\ 
\left( A_{1}\wedge A_{2}\right) _{\left( 2r-1\right) 2r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
x_{1}x_{2} & \cdots & x_{2r-1}x_{2r}%
\end{array}%
\right) \mathcal{R}_{x}\left( A_{1}\wedge A_{2}\right)
\end{eqnarray}%
and

\item 
\begin{gather}
A_{1}\wedge A_{2}=\sum_{1\leq j\leq 2r}x_{j}A_{j1}\wedge \sum_{1\leq j\leq
2r}x_{j}A_{j2}=\sum_{1\leq j_{1},j_{2}\leq r}x_{j_{1}}A_{j_{1}1}\wedge
x_{j_{2}}A_{j2}=\frac{1}{2}\sum_{1\leq j_{1},j_{2},\leq 2r}x_{j_{1}}\wedge
x_{j_{2}}A_{j_{1}1}A_{j_{2}2} \\
=\frac{1}{2}\sum_{1\leq j_{1}<j_{2},\leq 2r}x_{j_{1}}\wedge x_{j_{2}}\left(
A_{j_{1}1}A_{j_{2}2}-A_{j_{2}2}A_{j_{1}1}\right) \\
=\frac{1}{2}\sum_{1\leq j_{1},j_{2},\leq 2r}x_{j_{1}}\wedge x_{j_{2}}\left(
A_{1}\wedge A_{2}\right) _{j_{1}j_{2}}=\frac{1}{2}\sum_{1\leq
j_{1},j_{2}\leq 2r}x_{j_{1}}x_{j_{2}}\left\vert 
\begin{array}{cc}
A_{j_{1}1} & A_{j_{1}2} \\ 
A_{j_{2}1} & A_{j_{2}2}%
\end{array}%
\right\vert =\sum_{1\leq j_{1}<j_{2}\leq 2r}x_{j_{1}}x_{j_{2}}\left\vert 
\begin{array}{cc}
A_{j_{1}1} & A_{j_{1}2} \\ 
A_{j_{2}1} & A_{j_{2}2}%
\end{array}%
\right\vert \\
=\sum_{1\leq j_{1}<j_{2}\leq 2r}x_{j_{1}}x_{j_{2}}\mathfrak{C}_{2}\left(
A\right) _{\left( j_{1}j_{2}\right) \left( 12\right) } \\
\left( A_{1}\wedge A_{2}\right) _{j_{1}j_{2}}=\left\vert 
\begin{array}{cc}
A_{j_{1}1} & A_{j_{1}2} \\ 
A_{j_{2}1} & A_{j_{2}2}%
\end{array}%
\right\vert =\det \left\{ \left( 
\begin{array}{cc}
A_{j_{1}1} & A_{j_{1}2} \\ 
A_{j_{2}1} & A_{j_{2}2}%
\end{array}%
\right) \right\} =\mathfrak{C}_{2}\left( A\right) _{\left( j_{1}j_{2}\right)
\left( 12\right) }.
\end{gather}
\end{enumerate}

\begin{remark}
$\det $ is invariant under the transpose operation
\end{remark}

The exterior product of $A_{1},A_{2}$ and $A_{3}$ can be expanded as

\begin{enumerate}
\item 
\begin{eqnarray}
A_{1}\wedge A_{2}\wedge A_{3} &=&\sum_{1\leq j_{1}<j_{2},\leq
2r}x_{j_{1}}\wedge x_{j_{2}}\left( A_{1}\wedge A_{2}\wedge A_{3}\right)
_{j_{1}j_{2}j_{3}}=\left( 
\begin{array}{ccc}
x_{1}x_{2}x_{3} & \cdots & x_{2r-2}x_{2r-1}x_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( A_{1}\wedge A_{2}\wedge A_{3}\right) _{123} \\ 
\vdots \\ 
\left( A_{1}\wedge A_{2}\wedge A_{3}\right) _{\left( 2r-2\right) \left(
2r-1\right) 2r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
x_{1}x_{2}x_{3} & \cdots & x_{2r-2}x_{2r-1}x_{2r}%
\end{array}%
\right) \mathcal{R}_{x}\left( A_{1}\wedge A_{2}\wedge A_{3}\right)
\end{eqnarray}%
and

\item 
\begin{gather}
A_{1}\wedge A_{2}\wedge A_{3}=\sum_{1\leq j\leq 2r}x_{j}A_{j1}\wedge
\sum_{1\leq j\leq 2r}x_{j}A_{j2}\wedge \sum_{1\leq j\leq
2r}x_{j}A_{j3}=\sum_{1\leq j_{1},j_{2},j_{3}\leq
2r}x_{j_{1}}A_{j_{1}1}\wedge x_{j_{2}}A_{j_{2}2}\wedge x_{j_{3}}A_{j_{3}3} \\
=\frac{1}{6}\sum_{1\leq j_{1},j_{2},j_{3}\leq
2r}A_{j_{1}1}A_{j_{2}2}A_{j_{3}3}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}} \\
=\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}\left(
A_{j_{1}1}A_{j_{2}2}A_{j_{3}3}-A_{j_{1}1}A_{j_{3}3}A_{j_{2}2}+A_{j_{3}3}A_{j_{1}1}A_{j_{2}2}-A_{j_{2}2}A_{j_{1}1}A_{j_{3}3}+A_{j_{2}2}A_{j_{3}3}A_{j_{1}1}-A_{j_{3}3}A_{j_{2}2}A_{j_{1}1}\right) x_{j_{1}}x_{j_{2}}x_{j_{3}}
\\
=\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}x_{j_{1}}x_{j_{2}}x_{j_{3}}\left(
A_{1}\wedge A_{2}\wedge A_{3}\right) _{j_{1}j_{2}j_{3}} \\
=\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}x_{j_{1}}x_{j_{2}}x_{j_{3}}\left\vert 
\begin{array}{ccc}
A_{j_{1}1} & A_{j_{2}1} & A_{j_{3}1} \\ 
A_{j_{1}2} & A_{j_{2}2} & A_{j_{3}2} \\ 
A_{j_{1}3} & A_{j_{2}3} & A_{j_{3}3}%
\end{array}%
\right\vert =\sum_{1\leq j_{1}<j_{2}<j_{3}\leq
2r}x_{j_{1}}x_{j_{2}}x_{j_{3}}\det \left\{ \left( 
\begin{array}{ccc}
A_{j_{1}1} & A_{j_{2}1} & A_{j_{3}1} \\ 
A_{j_{1}2} & A_{j_{2}2} & A_{j_{3}2} \\ 
A_{j_{1}3} & A_{j_{2}3} & A_{j_{3}3}%
\end{array}%
\right) \right\} \\
=\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}x_{j_{1}}x_{j_{2}}x_{j_{3}}\mathfrak{C}%
_{3}\left( A\right) _{j_{1}j_{2}j_{3}123} \\
\left( A_{1}\wedge A_{2}\wedge A_{3}\right) _{j_{1}j_{2}j_{3}}=\left\vert 
\begin{array}{ccc}
A_{j_{1}1} & A_{j_{2}1} & A_{j_{3}1} \\ 
A_{j_{1}2} & A_{j_{2}2} & A_{j_{3}2} \\ 
A_{j_{1}3} & A_{j_{2}3} & A_{j_{3}3}%
\end{array}%
\right\vert =\det \left\{ \left( 
\begin{array}{ccc}
A_{j_{1}1} & A_{j_{1}2} & A_{j_{1}3} \\ 
A_{j_{2}1} & A_{j_{2}2} & A_{j_{2}3} \\ 
A_{j_{3}1} & A_{j_{3}2} & A_{j_{3}3}%
\end{array}%
\right) \right\} =\mathfrak{C}_{3}\left( A\right) _{\left(
j_{1}j_{2}j_{3}\right) \left( 123\right) }
\end{gather}%
etc..........$\blacksquare .$
\end{enumerate}
\end{proof}

\paragraph{End of Exterior Product in Clifford Algebra}

\subparagraph{Different Gradations}

The exterior algebra graded decomposition is a different decomposition to
the ones introduced before i.e. in terms of degrees of creation and
annihilation operators 
\begin{equation}
\mathcal{F}=\dbigoplus\limits_{0\leq n,m\leq r}\mathcal{A}_{nm}
\label{SecondQuant}
\end{equation}%
and mappings between the component Hilbert spaces%
\begin{equation}
\mathcal{F}=\dbigoplus\limits_{0\leq n,m\leq r}\mathcal{B}_{nm}\left( 
\mathcal{H}_{\mathcal{F}}\right) \equiv \dbigoplus\limits_{0\leq n,m\leq r}%
\mathcal{B}\left( \mathcal{H}^{n},\mathcal{H}^{m}\right) .
\label{ParticleMap}
\end{equation}%
One should observe that 
\begin{equation}
\mathcal{F}_{n}=\dbigoplus\limits_{\substack{ p+q=n  \\ 0\leq p,q\leq r}}%
\mathcal{A}_{pq}.
\end{equation}%
and 
\begin{equation}
\mathcal{F}_{n}=\tbigoplus\limits_{0\leq p\leq n}\mathcal{A}_{pn-p}
\end{equation}%
i.e.%
\begin{equation}
\mathcal{F}=\tbigoplus\limits_{0\leq n\leq 2r}\tbigoplus\limits_{0\leq p\leq
n}\mathcal{A}_{pn-p};\quad 0\leq n\leq r.
\end{equation}%
The expansion 
\begin{equation}
\mathcal{F}=\dbigoplus\limits_{0\leq n\leq 2r}\mathcal{F}_{n}
\end{equation}%
shows that $\mathcal{F}$ is $\mathbb{N}$-graded.

One also has the \emph{Super Algebra }$\mathbb{N}_{2}$-grading 
\begin{equation}
\mathcal{F}=\mathcal{F}_{even}\oplus \mathcal{F}_{odd},
\end{equation}%
where 
\begin{align}
\mathcal{F}_{even}& =\dbigoplus\limits_{1\leq n\leq r}\mathcal{F}_{2n} \\
\mathcal{F}_{odd}& =\dbigoplus\limits_{1\leq n\leq r}\mathcal{F}_{2n-1}.
\end{align}

\bigskip If $A$ is a general element of $\mathcal{F}$ then 
\begin{equation}
A=\sum_{0\leq n\leq 2r}\left\langle A\right\rangle _{n}=\sum_{0\leq n\leq
2r}A_{n},
\end{equation}%
where 
\begin{equation}
\left\langle A\right\rangle _{n}=A_{n}\in \mathcal{F}_{n}.
\end{equation}%
Thus 
\begin{equation}
\left\langle A\right\rangle _{n}=\sum_{1\leq j_{1}<\cdots <j_{n}\leq
2r}A_{nj_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}=\sum_{1\leq j_{1}<\cdots
<j_{n}\leq 2r}A_{nj_{1}\cdots j_{n}}x_{j_{1}}\wedge \cdots \wedge x_{j_{n}}
\end{equation}%
and 
\begin{equation}
\left\langle A\right\rangle _{0}=\alpha I_{\mathcal{F}}=A_{0};\alpha \in 
\mathbb{C}.
\end{equation}%
Thus 
\begin{equation}
\left\langle A_{n}\right\rangle _{m}=\delta _{nm}A_{n}.
\end{equation}

\begin{remark}
The Clifford algebra $\mathcal{F}$ has the operator norm $\left\Vert
{}\right\Vert _{\mathcal{F}}$ and the various norms $\left\Vert
{}\right\Vert _{p\mathcal{F}}$ associated with the Schatten Ideals.
\end{remark}

\begin{remark}
Recall 
\begin{equation}
\mathcal{F=}\tbigwedge \left( \mathcal{F}_{1}\right)
\end{equation}%
and 
\begin{equation}
\mathcal{F}_{1}=\mathcal{V}_{\boldsymbol{+}}\oplus _{\mathbb{R}}\mathcal{V}_{%
\boldsymbol{-}}
\end{equation}%
\begin{equation}
\tbigwedge \left( \mathcal{F}_{1}\right) =\tbigwedge \left( \mathcal{V}_{%
\boldsymbol{+}}\oplus _{\mathbb{R}}\mathcal{V}_{\boldsymbol{-}}\right) =
\end{equation}
\end{remark}

\begin{remark}
The Clifford algebra $\mathcal{F}$ is based on the Hilbert space $\mathcal{H}
$ has quasi free states defined by 
\begin{equation}
\omega _{A}\left( B\left( f\right) B\left( g\right) \right) =\left\langle
\left. f\right\vert Ag\right\rangle _{\mathcal{H}}
\end{equation}
If 
\begin{equation}
A=\frac{1}{2}I_{\mathcal{H}}
\end{equation}%
then 
\begin{equation}
\omega _{A}\left( B\left( f\right) B\left( g\right) \right) =\frac{1}{2}%
\left\langle \left. f\right\vert g\right\rangle _{\mathcal{H}}
\end{equation}%
is a tracial state.
\end{remark}

\subsection{Reversion $"t"$}

\qquad Reversion is defined by%
\begin{equation}
\left( x_{j_{1}}\cdots x_{j_{n}}\right) ^{t}=x_{j_{n}}\cdots
x_{j_{1}}=\left( -1\right) ^{\binom{n}{2}}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}%
and reversion plus complex conjugation by%
\begin{equation}
\left( x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger }=\overline{%
x_{j_{n}}\cdots x_{j_{1}}}=\left( -1\right) ^{\binom{n}{2}}\overline{%
x_{j_{1}}\cdots x_{j_{n}}}.
\end{equation}%
This definition gives 
\begin{equation}
\left( AB\right) ^{\dagger }=B^{\dagger }A^{\dagger }
\end{equation}%
for arbitary $A$ and $B.$

\begin{example}
\begin{enumerate}
\item 
\begin{eqnarray}
x_{1}^{t} &=&\left( -1\right) ^{\binom{1}{2}}x_{1}=x_{1} \\
\left( x_{1}x_{2}\right) ^{t} &=&\left( -1\right) ^{\binom{2}{2}%
}x_{1}x_{2}=-x_{1}x_{2} \\
\left( x_{1}x_{2}x_{3}\right) ^{t} &=&\left( -1\right) ^{\binom{3}{2}}\left(
x_{1}x_{2}x_{3}\right) =-x_{1}x_{2}x_{3} \\
\left( x_{1}x_{2}x_{3}x_{4}\right) ^{t} &=&\left( -1\right) ^{\binom{4}{2}%
}\left( x_{1}x_{2}x_{3}x_{4}\right) =x_{1}x_{2}x_{3}x_{4}
\end{eqnarray}

\item 
\begin{equation}
x_{4}x_{3}x_{2}x_{1}=-x_{3}x_{4}x_{2}x_{1}=x_{3}x_{2}x_{4}x_{1}=-x_{3}x_{2}x_{1}x_{4}=x_{2}x_{3}x_{1}x_{4}=-x_{2}x_{1}x_{3}x_{4}=x_{1}x_{2}x_{3}x_{4}
\end{equation}
\end{enumerate}
\end{example}

\textbf{Reversion composed with complex conjugation is actually the operator
adjoint operation} as can be seen by 
\begin{align}
\left( x_{1}x_{2}\right) ^{\dagger} & =\left( \frac{1}{\sqrt{2}}\left(
a_{1}^{\dagger}+a_{1}\right) \frac{1}{\sqrt{2}}\left(
a_{2}^{\dagger}+a_{2}\right) \right) ^{\dagger}=\frac{1}{\sqrt{2}}\left(
a_{2}^{\dagger }+a_{2}\right) \frac{1}{\sqrt{2}}\left(
a_{1}^{\dagger}+a_{1}\right)  \notag \\
& =\frac{1}{2}\left(
a_{2}^{\dagger}a_{1}^{\dagger}+a_{2}^{\dagger}a_{1}+a_{2}a_{1}^{%
\dagger}+a_{2}a_{1}\right) =-\frac{1}{2}\left(
a_{1}^{\dagger}a_{2}^{\dagger}+a_{1}^{\dagger}a_{2}+a_{1}a_{2}^{%
\dagger}+a_{1}a_{2}\right)  \notag \\
& =-x_{2}x_{1}
\end{align}
and%
\begin{align}
\left( x_{1}x_{1+r}\right) ^{\dagger} & =\left( \frac{1}{\sqrt{2}}\left(
a_{1}^{\dagger}+a_{1}\right) \frac{i}{\sqrt{2}}\left(
a_{1}^{\dagger}-a_{1}\right) \right) ^{\dagger}=\frac{i}{\sqrt{2}}\left(
a_{1}^{\dagger }-a_{1}\right) \frac{1}{\sqrt{2}}\left(
a_{1}^{\dagger}+a_{1}\right)  \notag \\
& =\frac{i}{2}\left(
a_{1}^{\dagger}a_{1}^{\dagger}+a_{1}^{\dagger}a_{1}-a_{1}a_{1}^{%
\dagger}-a_{1}a_{1}\right) =-\frac{i}{2}\left(
a_{1}^{\dagger}a_{1}^{\dagger}+a_{1}^{\dagger}a_{1}-a_{1}a_{1}^{%
\dagger}+a_{1}a_{1}\right)  \notag \\
& =-x_{1+r}x_{1}.
\end{align}

\section{Geometric Algebra I}

\subsection{Scaler Product}

The product $C_{1}D_{1}$ of two grade 1 operators (vectors) can be expressed
as the sum of a symmetric and antisymmetric part of the operator product in $%
\mathcal{F}$ i.e. 
\begin{equation}
C_{1}D_{1}=\frac{1}{2}\left\{ C_{1}D_{1}+D_{1}C_{1}\right\} +\frac{1}{2}%
\left\{ C_{1}D_{1}-D_{1}C_{1}\right\} =\frac{1}{2}\left\{
C_{1},D_{1}\right\} +\frac{1}{2}\left[ C_{1},D_{1}\right]
\end{equation}%
which allows one to define a "scalar product" $(\cdot |\cdot )$ 
\begin{equation}
(\cdot |\cdot ):\mathcal{F}_{1}\times \mathcal{F}_{1}\longrightarrow \mathbb{%
C}I_{\mathcal{F}}
\end{equation}%
between vectors as 
\begin{equation}
(C_{1}|D_{1})=\frac{1}{2}\left\{ C_{1},D_{1}\right\} .
\end{equation}%
This scalar product can be extended to all of $\mathcal{F}$ by using the
exterior algebra property of $\mathcal{F}$ (i.e. $\mathcal{F}=\wedge \left( 
\mathcal{F}_{1}\right) ).$

The basis $\left\{ \left. x_{j}\right\vert \,1\leq j\leq 2r\right\} $ is
"orthogonal" with respect to this scalar product i.e. 
\begin{equation}
(x_{j}|x_{k})=x_{j}\vee x_{k}=\frac{1}{2}\left\{
x_{j}x_{k}+x_{k}x_{j}\right\} =\left\{ x_{j},x_{k}\right\} =\frac{1}{2}%
\delta _{jk}I_{\mathcal{F}};1\leq j\leq 2r,
\end{equation}%
but \emph{not normalized}. One can define normalized vectors by 
\begin{equation}
\tilde{x}_{j}=\sqrt{2}x_{j};1\leq j\leq 2r,
\end{equation}%
but these vectors do not satisfy the CAR as 
\begin{equation*}
\left\{ \tilde{x}_{j},\tilde{x}_{k}\right\} =2\delta _{jk}I_{\mathcal{F}}.
\end{equation*}

One can expand any two vectors $C_{1}$ and $D_{1}$ in terms of this
orthonormal basis as 
\begin{align}
C_{1}& =\sum_{1\leq j\leq 2r}c_{j}\tilde{x}_{j} \\
D_{1}& =\sum_{1\leq j\leq 2r}d_{j}\tilde{x}_{j}
\end{align}%
and obtain 
\begin{equation}
(C_{1}|D_{1})=(D_{1}|C_{1})=\sum_{1\leq j\leq 2r}c_{j}d_{j}I_{\mathcal{F}%
}=\left( \left( C_{1}|D_{1}\right) \right) I_{\mathcal{F}},
\end{equation}%
where 
\begin{equation}
\left( C_{1}|D_{1}\right) =\sum_{1\leq j\leq 2r}c_{j}d_{j}.
\end{equation}

The CAR's can then be expressed in terms of this scalar product as 
\begin{equation}
\left\{ C_{1},D_{1}\right\} =\sum_{1\leq j,k\leq2r}c_{j}d_{k}\left\{ \tilde{x%
}_{j},\tilde{x}_{k}\right\} I_{\mathcal{F}}=\sum_{1\leq j\leq2r}c_{j}d_{j}I_{%
\mathcal{F}}=2(C_{1}|D_{1}).
\end{equation}

The invariance group of the scalar product $(\cdot|\cdot)$ is $O\left( 2r,%
\mathbb{C}\right) .$

One can define a quadratic function $Q$ in terms of this scalar product by 
\begin{equation}
Q\left( C_{1}\right) =\left( C_{1}\left\vert C_{1}\right. \right)
\end{equation}%
and then one can recover the scalar product by using the \emph{polarization
identity} 
\begin{equation}
\left( C_{1}\left\vert D_{1}\right. \right) =Q\left( C_{1}+D_{1}\right)
-Q\left( C_{1}\right) -Q\left( D_{1}\right) .
\end{equation}

\begin{remark}
This scalar product does not define a norm nor a seminorm,
\end{remark}

\subsection{Contraction}

Left and right contraction are defined by 
\begin{align*}
v\rfloor D & =\frac{1}{2}\left\{ vD-\hat{D}v\right\} \\
v\lfloor D & =\frac{1}{2}\left\{ Dv-v\hat{D}\right\} ,
\end{align*}
where the \emph{grade involution operation }%
\begin{equation*}
\widehat{}:D\rightarrow\hat{D},
\end{equation*}
is defined by 
\begin{align*}
D & =\sum_{0\leq n\leq2r}D_{n} \\
\hat{D}_{n} & =\left( -1\right) ^{n}D_{n} \\
\widehat{D} & =\sum_{0\leq n\leq2r}\left( -1\right) ^{n}D_{n}=\sum_{0\leq
m\leq r}D_{2m}-\sum_{1\leq m\leq r}D_{2m-1}.
\end{align*}
The scalar products 
\begin{align}
\left( A\left\vert B\right. \right) & =\left\langle A^{t}B\right\rangle _{0}
\\
\left\langle A\left\vert B\right. \right\rangle & =\left\langle A^{\dagger
}B\right\rangle _{0}
\end{align}
can be expressed in terms of the contraction operation.

Contraction can be generalized to act between any elements of the G{}A by 
\begin{align}
A\rfloor B & =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q} \\
A\lfloor B & =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{q-p}.
\end{align}

\subsection{Wedge Product$\,\equiv $\thinspace Exterior Product}

The wedge product \emph{between vectors} is defined as the antisymmetric
part of the operator product i.e. 
\begin{equation*}
C_{1}\wedge D_{1}=\left\langle C_{1}D_{1}\right\rangle _{2}=\frac{1}{2}\left[
C_{1},D_{1}\right] \text{ (The last identity works only for vectors,
definately does not work for grade 0 elements).}
\end{equation*}%
In general the wedge product in a Clifford algebra is defined by 
\begin{equation}
C\wedge D=\sum\limits_{0\leq m,n\leq 2r}\left\langle C_{m}D_{n}\right\rangle
_{m+n}
\end{equation}%
or by the multilinear extension 
\begin{equation}
C\wedge D=\sum_{1\leq j_{1}<\cdots <j_{n}<2r}C_{j_{1}\cdots
j_{n}}x_{j_{1}}\cdots x_{j_{n}}\wedge \sum_{1\leq k_{1}<\cdots
<k_{n}<2r}D_{k_{1}\cdots k_{n}}x_{k_{1}}\cdots x_{k_{n}}=\sum_{\substack{ %
1\leq j_{1}<\cdots <j_{n}<2r  \\ 1\leq k_{1}<\cdots <k_{n}<2r}}%
C_{j_{1}\cdots j_{n}}D_{k_{1}\cdots k_{n}}x_{j_{1}}\wedge \cdots \wedge
x_{j_{n}}\wedge x_{k_{1}}\wedge \cdots \wedge x_{k_{n}},
\end{equation}%
where 
\begin{equation}
x_{p}\wedge x_{q}=\frac{1}{2}\left[ x_{p},x_{q}\right] ,\quad 1\leq p,q\leq
2r
\end{equation}%
and can be shown to be basis independent at least in the finite dimensional
case.

In order to investigate the connection between the products $\circ,\boxtimes$
and $\wedge$ we consider the first quantized expansions of the creation and
annihilation operators for \underline{\emph{Type I}}\emph{\ }\underline{%
\emph{vacuum} \emph{representations}} of a CAR algebra, e.g. the Fock
algebra $\mathcal{F},$ 
\begin{align}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{1}^{\dagger}\right) & \equiv a_{1}^{\dagger}=\left\vert \varphi
_{1}\right\rangle \left\langle \phi\right\vert +\sum_{2\leq n\leq
r}\sum_{2\leq j_{1}<\cdots<j_{n-1}<r}\left\vert
\varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots \varphi_{j_{n-1}}\right\vert , \\
a_{1} & =\left\vert \phi\right\rangle \left\langle \varphi_{1}\right\vert
+\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-1}<r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle \varphi
_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert .
\end{align}
Then the GA\ wedge product between a creator and an annihilator gives

\begin{equation}
a_{1}^{\dagger}\wedge a_{1}=\frac{1}{2}\left[ a_{1}^{\dagger},a_{1}\right] =%
\frac{1}{2}\left( a_{1}^{\dagger}a_{1}-a_{1}a_{1}^{\dagger}\right) =\frac{1}{%
2}\left( a_{1}^{\dagger}a_{1}-I_{\mathcal{F}}+a_{1}^{\dagger}a_{1}\right)
=a_{1}^{\dagger}a_{1}-\frac{1}{2}I_{\mathcal{F}}
\end{equation}
$\lceil$ which is antisymmetric as%
\begin{equation}
a_{1}\wedge a_{1}^{\dagger}=\frac{1}{2}\left[ a_{1},a_{1}^{\dagger}\right] =%
\frac{1}{2}\left( a_{1}a_{1}^{\dagger}-a_{1}^{\dagger}a_{1}\right) =\frac{1}{%
2}\left( I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}-a_{1}^{\dagger}a_{1}\right) =%
\frac{1}{2}I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}
\end{equation}
$\rfloor$

while the operator product $\boxtimes $ gives 
\begin{align}
& \left( \left\vert \varphi _{1}\right\rangle \left\langle \phi \right\vert
+\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots <j_{n-1}<r}\left\vert \varphi
_{1}\varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\rangle \left\langle
\varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\vert \right) \\
& \boxtimes \left( \left\vert \phi \right\rangle \left\langle \varphi
_{1}\right\vert +\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots
<j_{n-1}<r}\left\vert \varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\rangle
\left\langle \varphi _{1}\varphi _{j_{1}}\cdots \varphi
_{j_{n-1}}\right\vert \right) \\
& =\left\vert \varphi _{1}\right\rangle \left\langle \varphi _{1}\right\vert
+\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots <j_{n-1}<r}\left\vert \varphi
_{1}\varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\rangle \left\langle \
\varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\vert +\sum_{2\leq n\leq
r}\sum_{2\leq j_{1}<\cdots <j_{n-1}<r}\left\vert \varphi _{j_{1}}\cdots
\varphi _{j_{n-1}}\right\rangle \left\langle \varphi _{1}\varphi
_{j_{1}}\cdots \varphi _{j_{n-1}}\right\vert \  \\
& +\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots <j_{n-1}<r}\left\vert
\varphi _{1}\varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\rangle
\left\langle \varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\vert
+\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots <j_{n-1}<r}\left\vert \varphi
_{j_{1}}\cdots \varphi _{j_{n-1}}\right\rangle \left\langle \varphi
_{1}\varphi _{j_{1}}\cdots \varphi _{j_{n-1}}\right\vert ,
\end{align}%
\emph{which are not equal i.e }%
\begin{equation}
a_{1}^{\dagger }\wedge a_{1}\neq a_{1}^{\dagger }\boxtimes a_{1}
\end{equation}%
or equivalently 
\begin{equation}
\Pi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{1}^{\dagger }\wedge a_{1}\right) \neq \Pi _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }\left( a_{1}^{\dagger }\right) \boxtimes \Pi
_{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{1}\right) .
\end{equation}%
Incidently 
\begin{equation}
\Pi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{1}^{\dagger }\wedge a_{1}\right) =\Pi _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }\left( a_{1}^{\dagger }\right) \wedge \Pi
_{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{1}\right)
\end{equation}%
as $\wedge $ is defined in terms of the Clifford$\equiv $Operator product,
while 
\begin{equation}
a_{1}^{\dagger }\boxtimes a_{1}
\end{equation}%
only makes sense in terms of representations i.e. 
\begin{equation}
\Pi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{1}^{\dagger }\right) \boxtimes \Pi _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }\left( a_{1}\right)
\end{equation}%
as the $\boxtimes $ \emph{product is only defined for representations,
though it does make sense for mappings belonging to $\mathcal{B}\left( \emph{%
\mathcal{A}}\right) $ acting on $\mathcal{A}$.}

The GA\ wedge product between two creators gives%
\begin{equation}
a_{1}^{\dagger}\wedge a_{2}^{\dagger}=a_{1}^{\dagger}a_{2}^{\dagger
}=\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\phi\right\vert +\sum_{3\leq n\leq r}\sum_{3\leq
j_{1}<\cdots<j_{n-2}<r}\left\vert \varphi
_{1}\varphi_{2}\varphi_{j_{1}}\cdots\varphi_{j_{n-2}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{n-2}}\right\vert ,
\end{equation}
and we need to see if $a_{1}^{\dagger}\boxtimes
a_{2}^{\dagger}=a_{1}^{\dagger}a_{2}^{\dagger}.$ In first quantization 
\begin{align}
a_{1}^{\dagger}\boxtimes a_{2}^{\dagger} & =\left( \left\vert \varphi
_{1}\right\rangle \left\langle \phi\right\vert +\sum_{2\leq n\leq
r}\sum_{2\leq j_{1}<\cdots<j_{n-2}<r}\left\vert
\varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots \varphi_{j_{n-1}}\right\vert \right) \\
& \boxtimes\left( \left\vert \varphi_{2}\right\rangle \left\langle
\phi\right\vert +\sum_{2\leq n\leq r}\sum_{1\leq j_{1}<\cdots<j_{n-2}\neq
2<r}\left\vert
\varphi_{2}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) \\
& =\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert
\boxtimes\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert
+\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert
\boxtimes\left( \sum_{2\leq n\leq r}\sum_{1\leq j_{1}<\cdots<j_{n-2}\neq
2<r}\left\vert
\varphi_{2}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) \\
& +\left( \sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-2}<r}\left\vert
\varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right)
\boxtimes\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert \\
& +\left( \sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-2}<r}\left\vert
\varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) \boxtimes\left(
\sum_{2\leq n\leq r}\sum_{1\leq j_{1}<\cdots<j_{n-2}\neq2<r}\left\vert
\varphi_{2}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right)
\end{align}
while 
\begin{align}
a_{1}^{\dagger}a_{2}^{\dagger} & =\left( \left\vert \varphi_{1}\right\rangle
\left\langle \phi\right\vert +\sum_{2\leq n\leq r}\sum_{2\leq
j_{1}<\cdots<j_{n-2}<r}\left\vert \varphi_{1}\varphi_{j_{1}}\cdots
\varphi_{j_{n-1}}\right\rangle \left\langle \varphi_{j_{1}}\cdots
\varphi_{j_{n-1}}\right\vert \right) \times \\
& \left( \left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert
+\sum_{2\leq n\leq r}\sum_{1\leq j_{1}<\cdots<j_{n-2}\neq2<r}\left\vert
\varphi_{2}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) \\
& =\left( \sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-2}<r}\left\vert
\varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) \left\vert
\varphi_{2}\right\rangle \left\langle \phi\right\vert \\
& +\left( \sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-2}<r}\left\vert
\varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) \left( \sum_{2\leq
n\leq r}\sum_{1\leq j_{1}<\cdots<j_{n-2}\neq2<r}\left\vert
\varphi_{2}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert \right) .
\end{align}
\emph{so indeed} $a_{1}^{\dagger}\boxtimes a_{2}^{\dagger}=a_{1}^{\dagger
}a_{2}^{\dagger}.$

\begin{definition}
The Clifford wedge product between vectors, is defined as 
\begin{equation}
v_{1}\wedge \cdots \wedge v_{n}=\frac{1}{n!}\sum_{\sigma \in S_{n}}\left(
-1\right) ^{\pi \left( \sigma \right) }v_{\sigma \left( 1\right) }\cdots
v_{\sigma \left( n\right) }.
\end{equation}
\end{definition}

$\lceil $

\begin{enumerate}
\item 
\begin{align}
v_{1}\wedge v_{2}& =\frac{1}{2}\left( v_{1}v_{2}-v_{2}v_{1}\right)
=v_{1}v_{2}-\frac{1}{2}\left( v_{1}v_{2}+v_{2}v_{1}\right)
=v_{1}v_{2}-\left( \left. v_{1}\right\vert v_{2}\right) \\
& =v_{1}v_{2}-\left\langle v_{1}v_{2}\right\rangle _{0}=\left\langle
v_{1}v_{2}\right\rangle _{2}-\left\langle v_{1}v_{2}\right\rangle _{0} \\
& =\left\langle \left\langle v_{1}\right\rangle _{1}\left\langle
v_{2}\right\rangle _{1}\right\rangle _{2}-\left\langle \left\langle
v_{1}\right\rangle _{1}\left\langle v_{2}\right\rangle _{1}\right\rangle
_{0}=\left\langle \left\langle v_{1}\right\rangle _{1}\left\langle
v_{2}\right\rangle _{1}\right\rangle _{1+1}-\left\langle \left\langle
v_{1}\right\rangle _{1}\left\langle v_{2}\right\rangle _{1}\right\rangle
_{1-1}=\sum_{0\leq p,q\leq 2r}\sum_{0\leq j\leq p+q}\left\langle
\left\langle v_{1}\right\rangle _{p}\left\langle v_{2}\right\rangle
_{q}\right\rangle _{j}
\end{align}

\item 
\begin{equation*}
v_{1}\wedge v_{2}\wedge v_{3}=\frac{1}{6}\left(
v_{1}v_{2}v_{3}-v_{2}v_{1}v_{3}+v_{3}v_{2}v_{1}-v_{2}v_{3}v_{1}-v_{1}v_{3}v_{2}+v_{3}v_{1}v_{2}\right)
\end{equation*}

\item 
\begin{equation*}
v_{1}\wedge \left( v_{2}\wedge v_{3}\right) =\frac{1}{6}\left(
v_{1}v_{2}v_{3}+v_{1}v_{2}v_{3}-2v_{2}v_{3}v_{1}+v_{1}v_{2}v_{3}+v_{1}v_{2}v_{3}\right)
\end{equation*}

\item 
\begin{equation}
v_{1}\wedge v_{2}\wedge v_{3}=\left( \left\langle v_{1}v_{2}\right\rangle
_{2}-\left\langle v_{1}v_{2}\right\rangle _{0}\right) \wedge v_{3}=
\end{equation}

\item 
\begin{equation}
v_{1}v_{2}v_{3}=v_{1}\wedge v_{2}\wedge v_{3}+\left\langle
v_{2}v_{3}\right\rangle _{0}v_{1}-\left\langle v_{1}v_{3}\right\rangle
_{0}v_{2}+\left\langle v_{1}v_{2}\right\rangle _{0}v_{3}
\end{equation}%
$\rfloor $
\end{enumerate}

and can be generalized to give

\begin{equation}
v\wedge B=\frac{1}{2}\left( vB+B\left( \widehat{v}\right) v\right)
\end{equation}%
so that 
\begin{equation}
vB=v\rfloor B+v\wedge B.
\end{equation}%
This can be extended to general elements to give 
\begin{align}
A\rfloor B& =\sum_{0\leq p,q\leq 2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q} \\
A\lfloor B& =\sum_{0\leq p,q\leq 2r}\left\langle A_{p}B_{q}\right\rangle
_{q-p}.
\end{align}%
This leads to 
\begin{equation}
AB=A\rfloor B+A\wedge B
\end{equation}%
giving 
\begin{equation}
AB=\sum_{0\leq p,q\leq 2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q}+A\wedge B,
\end{equation}%
so that 
\begin{align}
A\wedge B& =AB-\sum_{0\leq p,q\leq 2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q} \\
& =\sum_{0\leq p,q\leq 2r}A_{p}B_{q}-\sum_{0\leq p,q\leq 2r}\left\langle
A_{p}B_{q}\right\rangle _{p-q} \\
& =\sum_{0\leq p,q\leq 2r}\sum_{j=0}^{\min \left( p,q\right) }\left\langle
A_{p}B_{q}\right\rangle _{\left\vert p-q\right\vert +2j}-\sum_{0\leq p,q\leq
2r}\left\langle A_{p}B_{q}\right\rangle _{p-q}=\sum_{0\leq p,q\leq
2r}\left\langle A_{p}B_{q}\right\rangle _{p+q}
\end{align}%
$\lceil $%
\begin{align}
v_{1}\wedge v_{2}& =\sum_{0\leq p,q\leq 4}\sum_{j=0}^{\min \left( p,q\right)
}\left\langle v_{1p}v_{2q}\right\rangle _{\left\vert p-q\right\vert
+2j}-\sum_{0\leq p,q\leq 4}\left\langle v_{1p}v_{2q}\right\rangle _{p-q} \\
& =\left\langle v_{11}v_{21}\right\rangle _{0}+\left\langle
v_{11}v_{21}\right\rangle _{2}-\left\langle v_{11}v_{21}\right\rangle _{0}
\end{align}%
and%
\begin{align}
A_{2}\wedge B_{2}& =\sum_{j=0}^{2}\left\langle A_{2}B_{2}\right\rangle
_{\left\vert p-q\right\vert +2j}-\left\langle A_{2}B_{2}\right\rangle _{0} \\
& =\left\langle A_{2}B_{2}\right\rangle _{0}+\left\langle
A_{2}B_{2}\right\rangle _{2}+\left\langle A_{2}B_{2}\right\rangle
_{4}-\left\langle A_{2}B_{2}\right\rangle _{0}=\left\langle
A_{2}B_{2}\right\rangle _{2}+\left\langle A_{2}B_{2}\right\rangle _{4}?
\end{align}%
$\rfloor $

The wedge product can be fully generalized by 
\begin{equation}
A\wedge B=\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle _{q+p}.
\end{equation}

\subsection{Products of Basis Vectors}

The general geometric product is given by%
\begin{equation}
AB=\sum_{0\leq m,n\leq2r}A_{m}B_{n},
\end{equation}
where 
\begin{equation}
A_{m}B_{n}=\sum_{j=0}^{\min\left( m,n\right) }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{equation}

The product of the vectors $C_{1},D_{1}$ can be expressed as 
\begin{equation}
C_{1}D_{1}=\left\langle C_{1}D_{1}\right\rangle _{0}+\left\langle
C_{1}D_{1}\right\rangle _{2}=(C_{1}|D_{1})+C_{1}\wedge D_{1}
\end{equation}%
and in particular the product of two basis vectors as 
\begin{align}
x_{j_{1}}x_{j_{2}}& =\left( x_{j_{1}}\left\vert x_{j_{2}}\right. \right)
+x_{j_{1}}\wedge x_{j_{2}}=\left\langle x_{j_{1}}x_{j_{2}}\right\rangle
_{0}+\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{2} \\
& =\Delta _{j_{1}j_{2}}+x_{j_{1}}\wedge x_{j_{2}}=\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}}\right) +x_{j_{1}}\wedge x_{j_{2}},
\end{align}%
where 
\begin{equation}
\Delta _{j_{1}j_{2}}=\left( \left( x_{j_{1}}\left\vert x_{j_{2}}\right.
\right) \right) =\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{0}=\limfunc{%
Pf}\left( \Delta _{j_{1}j_{2}}\right) ,
\end{equation}%
which is equivalent to 
\begin{equation}
x_{j_{1}}\wedge x_{j_{2}}=x_{j_{1}}x_{j_{2}}-\left( \left(
x_{j_{1}}\left\vert x_{j_{2}}\right. \right) \right) .
\end{equation}

\begin{example}
\begin{equation}
AB=\sum_{0\leq m,n\leq 2r}\sum_{j=0}^{\min \left( m,n\right) }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{equation}%
Let 
\begin{align}
A& =A_{1} \\
B& =B_{1} \\
AB& =A_{1}B_{1}=\sum_{j=0}^{1}\left\langle A_{1}B_{1}\right\rangle
_{2j}=\left\langle A_{1}B_{1}\right\rangle _{0}+\left\langle
A_{1}B_{1}\right\rangle _{2} \\
A_{1}\wedge B_{1}& =AB-\left\langle A_{1}B_{1}\right\rangle _{0}
\end{align}%
and%
\begin{equation}
A\wedge B=\sum_{0\leq p,q\leq 1}\left\langle A_{p}B_{q}\right\rangle
_{q+p}=\left\langle A_{0}B_{0}\right\rangle _{0}+\left\langle
A_{1}B_{0}\right\rangle _{1}+\left\langle A_{0}B_{1}\right\rangle
_{1}+\left\langle A_{1}B_{1}\right\rangle _{2}.
\end{equation}
\end{example}

The exterior product of $A_{p}$ and $B_{q}$ is defined by 
\begin{align}
A_{p}\wedge B_{q}& =A_{p}B_{q}-\sum_{j=0}^{\min \left( p,q\right)
-1}\left\langle A_{p}B_{q}\right\rangle _{\left\vert p-q\right\vert +2j} \\
& =\sum_{j=0}^{\min \left( p,q\right) }\left\langle A_{p}B_{q}\right\rangle
_{\left\vert p-q\right\vert +2j}-\sum_{j=0}^{\min \left( p,q\right)
-1}\left\langle A_{p}B_{q}\right\rangle _{\left\vert p-q\right\vert +2j} \\
& =\left\langle A_{p}B_{q}\right\rangle _{\left\vert p-q\right\vert +2\min
\left( p,q\right) }=\left\langle A_{p}B_{q}\right\rangle _{p+q},
\end{align}%
which gives in this case

\begin{enumerate}
\item 
\begin{equation}
A_{0}\wedge B_{0}=A_{0}B_{0}-\sum_{j=0}^{\min \left( 0,0\right)
-1}\left\langle A_{0}B_{0}\right\rangle _{\left\vert 0\right\vert
+2j}=A_{0}B_{0}-\left\langle A_{0}B_{0}\right\rangle _{-2}=A_{0}B_{0}
\end{equation}

\item 
\begin{equation}
A_{1}\wedge B_{0}=A_{1}B_{0}-\sum_{j=0}^{\min \left( 1,0\right)
-1}\left\langle A_{1}B_{0}\right\rangle _{\left\vert 1-0\right\vert
+2j}=A_{1}B_{0}-\left\langle A_{1}B_{0}\right\rangle _{0}=A_{1}B_{0}
\end{equation}

\item 
\begin{equation}
A_{1}\wedge B_{1}=A_{1}B_{1}-\sum_{j=0}^{\min \left( 1,1\right)
-1}\left\langle A_{1}B_{1}\right\rangle _{\left\vert 1-1\right\vert
+2j}=A_{1}B_{1}-\left\langle A_{1}B_{1}\right\rangle _{0}
\end{equation}

\item 
\begin{align*}
A_{1}B_{1}& =\sum_{j=0}^{1}\left\langle A_{1}B_{1}\right\rangle _{\left\vert
1-1\right\vert +2j}=\left\langle A_{1}B_{1}\right\rangle _{0}+\left\langle
A_{1}B_{1}\right\rangle _{2}=\left\langle A_{1}B_{1}\right\rangle
_{0}+A_{1}\wedge B_{1} \\
A_{1}\wedge B_{1}& =\left\langle A_{1}B_{1}\right\rangle _{2}
\end{align*}

\item 
\begin{align}
A_{2}\wedge B_{1}& =A_{2}B_{1}-\sum_{j=0}^{\min \left( 2,1\right)
-1}\left\langle A_{2}B_{1}\right\rangle _{\left\vert 2-1\right\vert
+2j}=A_{2}B_{1}-\left\langle A_{2}B_{1}\right\rangle
_{1+0}=A_{2}B_{1}-\left\langle A_{2}B_{1}\right\rangle _{1} \\
A_{2}B_{1}& =\sum_{j=0}^{1}\left\langle A_{2}B_{1}\right\rangle
_{1+2j}=\left\langle A_{2}B_{1}\right\rangle _{1}+\left\langle
A_{2}B_{1}\right\rangle _{3} \\
A_{2}\wedge B_{1}& =\left\langle A_{2}B_{1}\right\rangle _{3}
\end{align}

\item 
\begin{equation}
A_{2}\wedge B_{2}=A_{2}B_{2}-\sum_{j=0}^{\min \left( 2,2\right)
-1}\left\langle A_{2}B_{2}\right\rangle _{\left\vert 2-2\right\vert
+2j}=A_{2}B_{2}-\sum_{j=0}^{1}\left\langle A_{2}B_{2}\right\rangle
_{2j}=A_{2}B_{2}-\left\langle A_{2}B_{2}\right\rangle _{2}-\left\langle
A_{2}B_{2}\right\rangle _{0}
\end{equation}

\item 
\begin{align}
A_{2}B_{2}& =\sum_{j=0}^{2}\left\langle A_{2}B_{2}\right\rangle _{\left\vert
2-2\right\vert +2j}=\left\langle A_{2}B_{2}\right\rangle _{0}+\left\langle
A_{2}B_{2}\right\rangle _{2}+\left\langle A_{2}B_{2}\right\rangle
_{4}=\left\langle A_{2}B_{2}\right\rangle _{0}+\left\langle
A_{2}B_{2}\right\rangle _{2}+A_{2}\wedge B_{2} \\
A_{2}\wedge B_{2}& =\left\langle A_{2}B_{2}\right\rangle _{4}
\end{align}

\item 
\begin{equation}
A_{4}\wedge B_{2}=A_{4}B_{2}-\sum_{j=0}^{\min \left( 4,2\right)
-1}\left\langle A_{4}B_{2}\right\rangle _{\left\vert 4-2\right\vert
+2j}=A_{4}B_{2}-\sum_{j=0}^{1}\left\langle A_{4}B_{2}\right\rangle
_{2+2j}=A_{4}B_{2}-\left\langle A_{4}B_{2}\right\rangle _{2}-\left\langle
A_{4}B_{2}\right\rangle _{4}
\end{equation}

\item 
\begin{align}
A_{4}B_{2}& =\sum_{j=0}^{2}\left\langle A_{4}B_{2}\right\rangle
_{2+2j}=\left\langle A_{4}B_{2}\right\rangle _{2}+\left\langle
A_{4}B_{2}\right\rangle _{4}+\left\langle A_{4}B_{2}\right\rangle _{6} \\
A_{4}\wedge B_{2}& =\left\langle A_{4}B_{2}\right\rangle _{6}
\end{align}

\item 
\begin{equation}
A_{4}\wedge B_{4}=A_{4}B_{4}-\sum_{j=0}^{\min \left( 4,4\right)
-1}\left\langle A_{4}B_{4}\right\rangle _{\left\vert 4-4\right\vert
+2j}=A_{4}B_{4}-\sum_{j=0}^{3}\left\langle A_{4}B_{4}\right\rangle
_{2j}=A_{4}B_{4}-\left\langle A_{4}B_{4}\right\rangle _{0}-\left\langle
A_{4}B_{4}\right\rangle _{2}-\left\langle A_{4}B_{4}\right\rangle _{6}
\end{equation}

\item 
\begin{align}
A_{4}B_{4}& =\sum_{j=0}^{\min \left( 4,4\right) }\left\langle
A_{4}B_{4}\right\rangle _{0+2j}=\sum_{j=0}^{4}\left\langle
A_{4}B_{4}\right\rangle _{2j}=\left\langle A_{4}B_{4}\right\rangle
_{0}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{4}\right\rangle _{6}+\left\langle A_{4}B_{4}\right\rangle _{8} \\
A_{4}\wedge B_{4}& =\left\langle A_{4}B_{4}\right\rangle _{8}
\end{align}
\end{enumerate}

The product of two even fourth order operators is 
\begin{align}
A& =A_{0}+A_{2}+A_{4} \\
B& =B_{0}+B_{2}+B_{4} \\
AB& =\sum_{0\leq m,n\leq 4}\sum_{j=0}^{\min \left( m,n\right) }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j} \\
& =\left\langle A_{0}B_{0}\right\rangle _{0}+\left\langle
A_{2}B_{0}\right\rangle _{2}+\left\langle A_{0}B_{2}\right\rangle
_{2}+\left\langle A_{4}B_{0}\right\rangle _{4} \\
& +\left\langle A_{0}B_{4}\right\rangle _{4}+\left\langle
A_{2}B_{2}\right\rangle _{0}+\left\langle A_{2}B_{2}\right\rangle
_{2}+\left\langle A_{2}B_{2}\right\rangle _{4} \\
& +\left\langle A_{4}B_{2}\right\rangle _{2}+\left\langle
A_{4}B_{2}\right\rangle _{4}+\left\langle A_{4}B_{2}\right\rangle
_{6}+\left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle
A_{2}B_{4}\right\rangle _{4}+\left\langle A_{2}B_{4}\right\rangle _{6} \\
& +\left\langle A_{4}B_{4}\right\rangle _{0}+\left\langle
A_{4}B_{4}\right\rangle _{2}+\left\langle A_{4}B_{4}\right\rangle
_{4}+\left\langle A_{4}B_{4}\right\rangle _{6}+\left\langle
A_{4}B_{4}\right\rangle _{8}.
\end{align}%
The GA exterior product is 
\begin{align}
A\wedge B& =AB-\sum_{0\leq m,n\leq 2}\sum_{j=0}^{\min \left( m,n,1\right)
-1}\left\langle A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j} \\
& =\left\langle A_{0}B_{0}\right\rangle _{0}+\left\langle
A_{0}B_{2}\right\rangle _{2}+\left\langle A_{2}B_{0}\right\rangle
_{2}+\left\langle A_{2}B_{2}\right\rangle _{4}+\left\langle
A_{2}B_{4}\right\rangle _{6}+\left\langle A_{4}B_{2}\right\rangle
_{6}+\left\langle A_{4}B_{4}\right\rangle _{8},
\end{align}%
which must also equal 
\begin{equation}
A\wedge B=\sum_{0\leq p,q\leq 4}\left\langle A_{p}B_{q}\right\rangle _{q+p}.
\end{equation}

$\lceil $%
\begin{align}
x_{j_{1}}\wedge x_{j_{2}}& =\sum_{0\leq p,q\leq 2r}\left\langle \left\langle
x_{j_{1}}\right\rangle _{q}\left\langle x_{j_{2}}\right\rangle
_{p}\right\rangle _{q+p}=\left\langle \left\langle x_{j_{1}}\right\rangle
_{0}\left\langle x_{j_{2}}\right\rangle _{0}\right\rangle _{0}+\left\langle
\left\langle x_{j_{1}}\right\rangle _{1}\left\langle x_{j_{2}}\right\rangle
_{0}\right\rangle _{1}+\left\langle \left\langle x_{j_{1}}\right\rangle
_{0}\left\langle x_{j_{2}}\right\rangle _{1}\right\rangle _{1}+\left\langle
\left\langle x_{j_{1}}\right\rangle _{1}\left\langle x_{j_{2}}\right\rangle
_{1}\right\rangle _{2} \\
& =\left\langle \left\langle x_{j_{1}}\right\rangle _{1}\left\langle
x_{j_{2}}\right\rangle _{1}\right\rangle _{2}=\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{2}=\frac{1}{2}\left[ x_{j_{1}},x_{j_{2}}%
\right] .
\end{align}

$\rfloor$

\subsubsection{Pfaffian}

\begin{definition}
1: The Pfaffian "$\limfunc{Pf}$" is a complex valued multilinear
antisymmetric function defined on subsets belonging to the power set $%
\mathcal{P}\left( \mathcal{S}\right) $ of a set $\mathcal{S},$ where 
\begin{equation}
\limfunc{Pf}\left( a_{1},a_{2}\right) \equiv \limfunc{Pf}\left( \left\{
a_{1},a_{2}\right\} \right) =-\limfunc{Pf}\left( a_{2},a_{1}\right) .
\end{equation}%
In general a $\left( 2n\right) ^{th}$ degree Pfaffian is defined by the
following expansion rule 
\begin{equation}
\limfunc{Pf}\left( a_{1},\cdots ,a_{2n}\right) =\sum_{2\leq j\leq n}\left(
-1\right) ^{j}\limfunc{Pf}\left( a_{1},a_{j}\right) \limfunc{Pf}\left(
a_{2},\cdots ,\widehat{a_{j}},\cdots ,a_{2n}\right) .
\end{equation}
\end{definition}

\begin{definition}
2: The Pfaffian, is a multilinear, complex valued function 
\begin{equation}
\limfunc{Pf}:\overset{\left. n\left( n-1\right) \right/ 2}{\overbrace{%
\mathbb{C}\times \cdots \times \mathbb{C}}}\,\cong \mathbb{C}^{\left.
n\left( n-1\right) \right/ 2}\rightarrow \mathbb{C}
\end{equation}%
defined by%
\begin{gather}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}\cdots j_{2n}}\right) =\limfunc{Pf}%
\left( \mathbf{\Delta }_{j_{1}j_{2}},\cdots ,\mathbf{\Delta }_{j_{1}j_{n}},%
\mathbf{\Delta }_{j_{2}j_{3}},\cdots ,\mathbf{\Delta }_{j_{2}j_{n}},\cdots ,%
\mathbf{\Delta }_{j_{2n-1}j_{2n}}\right) \\
=\dsum\limits_{\rho \in DC_{2}^{2n}}\pi \left( \rho \right)
\dprod\limits_{1\leq \leq k\leq n}\Delta _{j_{\rho \left( 2k-1\right)
}j_{\rho \left( 2k\right) }}=\frac{1}{2^{n}n!}\dsum\limits_{\sigma \in
S_{2n}}\pi \left( \sigma \right) \dprod\limits_{1\leq k\leq n}\Delta
_{j_{\sigma \left( 2k-1\right) }j_{\sigma \left( 2k\right) }}, \\
\mathbf{\Delta }_{j_{1}\cdots j_{2n}}\equiv \left( \mathbf{\Delta }%
_{j_{1}j_{2}},\cdots ,\mathbf{\Delta }_{j_{1}j_{n}},\mathbf{\Delta }%
_{j_{2}j_{3}},\cdots ,\mathbf{\Delta }_{j_{2}j_{n}},\cdots ,\mathbf{\Delta }%
_{j_{2n-1}j_{2n}}\right) ,
\end{gather}%
where $\rho $ and $\sigma $ are permutations 
\begin{equation}
\sigma ,\rho :\left\{ 1,\cdots ,2n\right\} \longrightarrow \left\{ 
\begin{array}{c}
\left\{ \rho \left( 1\right) ,\cdots ,\rho \left( 2n\right) \right\} \\ 
\left\{ \sigma \left( 1\right) ,\cdots ,\sigma \left( 2n\right) \right\}%
\end{array}%
\right. ,
\end{equation}%
constrained by 
\begin{align}
\rho \left( 2k-1\right) & <\rho \left( 2k\right) ;1\leq k\leq n, \\
\sigma \left( 2k-1\right) & <\sigma \left( 2k\right) ;1\leq k\leq n,
\end{align}%
leading to the induced permutations 
\begin{equation}
\sigma ,\rho :\left\{ j_{1},\cdots ,j_{2n}\right\} \longrightarrow \left\{ 
\begin{array}{c}
\left\{ j_{\rho \left( 1\right) },\cdots ,j_{\rho \left( 2n\right) }\right\}
\\ 
\left\{ j_{\sigma \left( 1\right) },\cdots ,j_{\sigma \left( 2n\right)
}\right\}%
\end{array}%
\right.
\end{equation}%
and $\pi \left( \cdot \right) $ is their parity. \emph{Note that }$\left\{
j_{1},\cdots ,j_{2n}\right\} $ \emph{do not have to have distinct values
i.e. it is possible, for example, that }$j_{1}=j_{2}=\cdots =j_{2n}$.
\end{definition}

\begin{definition}
3: The Pfaffian can also be defined using the exterior product by 
\begin{gather}
\frac{1}{r!}g^{r\wedge }=\,\overset{\qquad r}{\frac{1}{r!}\overbrace{g\wedge
\cdots \wedge g}}\,=Pf\left( g\right) x_{j_{1}}\wedge \cdots \wedge
x_{j_{2r}}=\limfunc{Pf}\left( \mathbb{G}\left( g\right) \right)
x_{j_{1}}\wedge \cdots \wedge x_{j_{2r}}\equiv \func{Pf}\left( \mathbb{G}%
\left( g\right) :j_{1},\cdots ,j_{2r}\right) x_{j_{1}}\wedge \cdots \wedge
x_{j_{2r}} \\
\equiv \limfunc{Pf}\left( \mathbb{G}\left( g\right) _{j_{1}\cdots
j_{2r}}\right) x_{j_{1}}\wedge \cdots \wedge x_{j_{2r}}\equiv \limfunc{Pf}%
\left( \mathbb{G}\left( g\right) _{j_{1}j_{2}},\cdots ,\mathbb{G}\left(
g\right) _{j_{1}j_{2r}},\mathbb{G}\left( g\right) _{j_{2}j_{3}},\cdots ,%
\mathbb{G}\left( g\right) _{j_{2}j_{2r}},\cdots ,\mathbb{G}\left( g\right)
_{j_{2r-1}j_{2r}}\right) x_{j_{1}}\wedge \cdots \wedge x_{j_{2r}},
\end{gather}%
where $\left\{ j_{1},\cdots ,j_{2r}\right\} $ are all unequal and 
\begin{equation}
g=\dsum\limits_{1\leq j_{1}<j_{2}\leq 2r}g_{j_{1}j_{2}}x_{j_{1}}\wedge
x_{j_{2}}=\dsum\limits_{1\leq j_{1}<j_{2}\leq 2r}\mathbb{G}\left( g\right)
_{j_{1}j_{2}}x_{j_{1}}\wedge x_{j_{2}}=\dsum\limits_{1\leq k\leq r}\alpha
_{j_{k}}c_{j_{2k-1}}\wedge c_{j_{2k}},
\end{equation}%
where%
\begin{equation}
\mathbb{G}\left( g\right) =\mathcal{R}_{x}\left( G\left( g\right) \right) =%
\mathcal{R}_{x}\left( \Omega \left( g\right) \right) =\left( 
\begin{array}{cccc}
0 & \mathbb{G}\left( g\right) _{1,2} & \cdots & \mathbb{G}\left( g\right)
_{1,2r} \\ 
\mathbb{G}\left( g\right) _{2,1} & \ddots & \ddots & \vdots \\ 
\vdots & \ddots & \ddots & \mathbb{G}\left( g\right) _{2r-1,2r} \\ 
\mathbb{G}\left( g\right) _{2r,1} & \cdots & \mathbb{G}\left( g\right)
_{2r,2r-1} & 0%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\left( g_{j_{1}j_{2}}=\mathbb{G}\left( g\right) _{j_{2}j_{1}}\right)
=-\left( \mathbb{G}\left( g\right) _{j_{1}j_{2}}=g_{j_{2}j_{1}}\right)
,\quad 1\leq j_{1}<j_{2}\leq 2r.
\end{equation}
\end{definition}

\begin{remark}
In the canonical expansion case 
\begin{eqnarray}
\frac{1}{r!}g^{r\wedge } &=&\,\overset{\qquad r}{\frac{1}{r!}\overbrace{%
g\wedge \cdots \wedge g}}\,=\frac{1}{2^{r}}\frac{1}{r!}\dsum\limits_{1\leq
k_{1},\cdots ,k_{r}\leq r}\alpha _{j_{k_{1}}}\cdots \alpha
_{j_{k_{r}}}c_{j_{2k_{1}-1}}\wedge c_{j_{2k_{1}}}\wedge \cdots \wedge
c_{j_{2k_{r}-1}}\wedge c_{j_{2k_{r}}} \\
&=&\left( \frac{1}{r!}\sum_{\sigma \in S_{r}}\pi \left( \sigma \right)
\alpha _{j_{\sigma \left( 1\right) }}\cdots \alpha _{j_{\sigma \left(
r\right) }}\right) c_{1}\wedge c_{2}\wedge \cdots \wedge c_{2r-1}\wedge
c_{2r}=\left( \frac{1}{r!}\sum_{\sigma \in S_{r}}\pi \left( \sigma \right)
\alpha _{j_{\sigma \left( 1\right) }}\cdots \alpha _{j_{\sigma \left(
r\right) }}\right) \pi \left( \mu \right) c_{1}\wedge c_{r+1}\wedge \cdots
\wedge c_{r}\wedge c_{r+r} \\
&=&\left( \overset{}{\alpha _{1}\cdots \alpha }_{r}\right) \pi \left( \mu
\right) c_{\mu \left( 1\right) }\wedge c_{\mu \left( 2\right) }\wedge \cdots
\wedge c_{\mu \left( 2r-1\right) }\wedge c_{\mu \left( 2r\right) },
\end{eqnarray}%
where 
\begin{equation}
\mu =\left( 
\begin{array}{ccccc}
1 & 2 & \cdots & 2r-1 & 2r \\ 
1 & r+1 & \cdots & r & 2r%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathbb{G}_{c}\left( g\right) =\mathcal{R}_{c}\left( G\left( g\right)
\right) =\mathcal{R}_{c}\left( \Xi _{\mathcal{F}^{2}}\left( g\right) \right)
=\left( 
\begin{array}{cccccc}
0 & 0 & 0 & \lambda _{1} & 0 & 0 \\ 
0 & 0 & 0 & 0 & \ddots & 0 \\ 
0 & 0 & 0 & 0 & 0 & \lambda _{r} \\ 
-\lambda _{1} & 0 & 0 & 0 & 0 & 0 \\ 
0 & \ddots & 0 & 0 & 0 & 0 \\ 
0 & 0 & -\lambda _{r} & 0 & 0 & 0%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{notation}
\begin{enumerate}
\item 
\begin{equation}
\mathbb{A}=\left( 
\begin{array}{ccc}
a_{11} & \cdots & a_{1n} \\ 
\vdots & \ddots & \vdots \\ 
a_{n1} & \cdots & a_{nn}%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\left\backslash \mathbb{A}\right\vert =\left( 
\begin{array}{ccccc}
0 & a_{12} & \cdots & \cdots & a_{1n} \\ 
\ast & 0 & \ddots & \cdots & \vdots \\ 
\ast & \ast & \ddots & \ddots & \vdots \\ 
\ast & \ast & \ast & 0 & a_{n-11n} \\ 
\ast & \ast & \ast & \ast & 0%
\end{array}%
\right)
\end{equation}
\end{enumerate}
\end{notation}

\begin{definition}
The Pfaffian of order $n$ can also be defined as 
\begin{equation}
\func{Pf}\left\{ \left\backslash \mathbb{A}\right\vert \right\} =\func{Pf}%
\left( a_{12},a_{23,\cdots ,}a_{2n-12n}\right) =\sum_{\rho \in
N_{1}^{2n}\left( \mathbb{N}_{1}^{n}\right) }\pi \left( \rho \right)
\prod\limits_{k\in \mathbb{N}_{1}^{n}}a_{\rho \left( 2k-1\right) \rho \left(
2k\right) },
\end{equation}%
which should be compared to the definition of the determinant.
\end{definition}

\begin{definition}
Determinant of rank $n$%
\begin{equation}
\det \left\{ \mathbb{A}\right\} =\det \left( a_{11},a_{22,\cdots
,}a_{nn}\right) =\sum_{\sigma \in S_{n}\left( \mathbb{N}_{1}^{n}\right) }\pi
\left( \sigma \right) \prod\limits_{k\in \mathbb{N}_{1}^{n}}a_{k\sigma
\left( k\right) }.
\end{equation}
\end{definition}

\begin{remark}
$N_{1}^{r}$ the set of ordered permuations of $\mathbb{N}_{1}^{r}$, which is
contained in the set of unordered permutations $S_{r}:$ 
\begin{eqnarray}
\rho &\in &N_{1}^{r}\Rightarrow \rho \left( 2h-1\right) <\rho \left(
2h\right) \\
h,k &\in &\mathbb{N}_{1}^{r},\quad h<k\Rightarrow \rho \left( 2h-1\right)
<\rho \left( 2h\right) .
\end{eqnarray}
\end{remark}

\begin{remark}
The Pfaffian is invariant under proper similarity transformations.
\end{remark}

\begin{remark}
For decomposible geminals $g\left( b_{1},b_{2}\right) =b_{1}\wedge b_{2},$
where 
\begin{equation}
b_{k}=\sum_{1\leq j\leq 2r}x_{j}b_{jk}=\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
b_{11} \\ 
\vdots \\ 
b_{2r1}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{x}\left( b_{11}\right) \\ 
\vdots \\ 
\mathcal{R}_{x}\left( b_{2r1}\right)%
\end{array}%
\right) ;\quad 1\leq k\leq 2
\end{equation}%
one has 
\begin{eqnarray*}
g\left( b_{1},b_{2}\right) &=&b_{1}\wedge b_{2}=\frac{1}{2}\left(
b_{1}\otimes b_{2}-b_{2}\otimes b_{1}\right) =\frac{1}{2}\sum_{1\leq
j_{1},j_{2}\leq 2r}\left( b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right)
x_{j_{1}}\otimes x_{j_{2}} \\
&=&\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\left(
b_{j_{1}1}b_{j_{1}2}-b_{j_{1}2}b_{j_{1}1}\right) x_{j_{1}}\otimes x_{j_{2}}+%
\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq 2r}\left(
b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right) x_{j_{1}}\otimes x_{j_{2}}+%
\frac{1}{2}\sum_{1\leq j_{1}>j_{2}\leq 2r}\left(
b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right) x_{j_{1}}\otimes x_{j_{2}}
\\
&=&\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq 2r}\left(
b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right) x_{j_{1}}\otimes x_{j_{2}}+%
\frac{1}{2}\sum_{1\leq j_{2}>j_{1}\leq 2r}\left(
b_{j_{2}1}b_{j_{1}2}-b_{j_{2}2}b_{j_{1}1}\right) x_{j_{2}}\otimes x_{j_{1}}
\\
&=&\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq 2r}\left(
b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right) x_{j_{1}}\otimes x_{j_{2}}-%
\frac{1}{2}\sum_{1\leq j_{2}>j_{1}\leq 2r}\left(
b_{j_{2}2}b_{j_{1}1}-b_{j_{2}1}b_{j_{1}2}\right) x_{j_{2}}\otimes x_{j_{1}}
\\
&=&\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq 2r}\left(
b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right) \left( x_{j_{1}}\otimes
x_{j_{2}}-x_{j_{2}}\otimes x_{j_{1}}\right) =\sum_{1\leq j_{1}<j_{2}\leq
2r}\left( b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}\right) x_{j_{1}}\wedge
x_{j_{2}} \\
&=&\sum_{1\leq j_{1}<j_{2}\leq 2r}\det \left\{ \left( 
\begin{array}{cc}
b_{j_{1}1} & b_{j_{1}2} \\ 
b_{j_{2}1} & b_{j_{2}2}%
\end{array}%
\right) \right\} x_{j_{1}}\wedge x_{j_{2}}\equiv \sum_{1\leq j_{1}<j_{2}\leq
2r}\left\vert \left( 
\begin{array}{cc}
b_{j_{1}1} & b_{j_{1}2} \\ 
b_{j_{2}1} & b_{j_{2}2}%
\end{array}%
\right) \right\vert x_{j_{1}}\wedge x_{j_{2}}=\sum_{1\leq j_{1}<j_{2}\leq 2r}%
\mathbb{G}\left( \overset{}{g\left( b_{1},b_{2}\right) }\right)
_{j_{1}j_{2}}x_{j_{1}}\wedge x_{j_{2}} \\
&=&\sum_{1\leq j_{1}<j_{2}\leq 2r}\mathfrak{C}_{2}\left( B\right)
_{j_{1}j_{2}12}x_{j_{1}}\wedge x_{j_{2}}=\sum_{1\leq j_{1}<j_{2}\leq 2r}\det
\left\{ B\left( j_{1}j_{2}12\right) \right\} x_{j_{1}}\wedge x_{j_{2}},
\end{eqnarray*}%
where the matrix $\mathcal{R}_{x}\left( B\right) $ of the vectors $\left\{
b_{1},b_{2}\right\} $ is 
\begin{equation}
\mathcal{R}_{x}\left( B\right) =\left( 
\begin{array}{cc}
\mathbf{b}_{1} & \mathbf{b}_{2}%
\end{array}%
\right) =%
\begin{array}{cc}
\mathcal{R}_{x}\left( b_{1}\right) & \mathcal{R}_{x}\left( b_{2}\right)%
\end{array}%
=\left( 
\begin{array}{cc}
b_{11} & b_{12} \\ 
\vdots & \vdots \\ 
b_{2r1} & b_{2r2}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathbb{G}\left( g\left( b_{1},b_{2}\right) \right)
_{j_{1}j_{2}}=b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}.
\end{equation}
\end{remark}

\begin{lemma}
Let $g\,=g\left( b_{1},b_{2}\right) $ then 
\begin{equation}
\frac{1}{r!}\overset{r}{\overbrace{g\left( b_{1},b_{2}\right) \wedge \cdots
\wedge g\left( b_{1},b_{2}\right) }}\,=\limfunc{Pf}\left( \mathbb{G}\left(
g\left( b_{1},b_{2}\right) \right) \right) x_{j_{1}}\wedge \cdots \wedge
x_{j_{2r}}=\left( \overset{}{\det \left( \mathbb{G}\left( g\left(
b_{1},b_{2}\right) \right) \right) }\right) ^{\frac{1}{2}}x_{j_{1}}\wedge
\cdots \wedge x_{j_{2r}},
\end{equation}%
where 
\begin{equation}
\mathbb{G}\left( g\left( b_{1},b_{2}\right) \right)
_{j_{1}j_{2}}=b_{j_{1}1}b_{j_{2}2}-b_{j_{1}2}b_{j_{2}1}
\end{equation}
\end{lemma}

\begin{example}
$r=1$ and $g$ be decomposible then

\begin{enumerate}
\item 
\begin{equation}
g\left( b_{1},b_{2}\right) =b_{1}\wedge b_{2}=\sum_{1\leq j_{1}<j_{2}\leq 2}%
\mathcal{R}_{x}\left( b_{1}\wedge b_{2}\right) _{j_{1}j_{2}}x_{j_{1}}\wedge
x_{j_{2}}=\dsum\limits_{1\leq j_{1}<j_{2}\leq 2}\mathbb{G}\left( g\left(
b_{1},b_{2}\right) \right) _{j_{1}j_{2}}x_{j_{1}}\wedge x_{j_{2}}
\end{equation}%
and

\item 
\begin{equation}
g\,=Pf\left( g\right) x_{1}\wedge x_{2}=Pf\left( \mathbf{\Delta }\right)
x_{1}\wedge x_{2}=\dsum\limits_{1\leq j_{1}<j_{2}\leq
2}g_{j_{1}j_{2}}x_{j_{1}}\wedge x_{j_{2}}=g_{12}x_{1}\wedge x_{2}=\frac{1}{2}%
\left( g_{12}x_{1}\wedge x_{2}-g_{21}x_{2}\wedge x_{1}\right) ,
\end{equation}%
where 
\begin{equation}
g_{21}=-g_{12}.
\end{equation}%
Hence 
\begin{equation}
Pf\left( g\right) =Pf\left( g_{j_{1}j_{2}}\right) ,
\end{equation}%
where 
\begin{equation}
\mathbb{G}\left( g\left( b_{1},b_{2}\right) \right) =\left( 
\begin{array}{cc}
0 & g_{12} \\ 
-g_{12} & 0%
\end{array}%
\right) .
\end{equation}
\end{enumerate}
\end{example}

\begin{theorem}
Expansion of Pfaffians 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}\cdots j_{2n}}\right) =\limfunc{Pf}%
\left( \mathbf{\Delta }_{j_{1}j_{2}},\cdots ,\mathbf{\Delta }_{j_{1}j_{n}},%
\mathbf{\Delta }_{j_{2}j_{3}},\cdots ,\mathbf{\Delta }_{j_{2}j_{n}},\cdots ,%
\mathbf{\Delta }_{j_{2n-1}j_{2n}}\right) =\tsum_{\substack{ 1\leq k\leq 2n 
\\ k\neq l}}\left( -1\right) ^{k+l+1+\theta \left( k-l\right) }\mathbf{%
\Delta }_{j_{k}j_{l}}\limfunc{Pf}\left( \mathbf{\Delta }_{j_{3}\cdots
j_{2n}}\left( j_{k}j_{l}\right) \right)
\end{equation}
\end{theorem}

\begin{corollary}
Expansion of Pfaffians%
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}\cdots j_{2n}}\right) =\limfunc{Pf}%
\left( \mathbf{\Delta }_{j_{1}j_{2}},\cdots ,\mathbf{\Delta }_{j_{1}j_{n}},%
\mathbf{\Delta }_{j_{2}j_{3}},\cdots ,\mathbf{\Delta }_{j_{2}j_{n}},\cdots ,%
\mathbf{\Delta }_{j_{2n-1}j_{2n}}\right) =\tsum_{2\leq k_{1}\leq 2n}\left(
-1\right) ^{k_{1}}\mathbf{\Delta }_{j_{1}j_{k_{1}}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}\cdots j_{2n}}\left( j_{1}j_{k_{1}}\right) \right)
\end{equation}
\end{corollary}

\begin{corollary}
Expansion of Pfaffians%
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}\cdots j_{2n}}\left(
j_{1}j_{k_{1}}\right) \right) =\tsum_{2\leq k_{1}\leq 2n}\left( -1\right)
^{k_{1}}\mathbf{\Delta }_{j_{1}j_{k_{1}}}\tsum_{3\leq k_{2}\leq 2n}\left(
-1\right) ^{k_{2}}\mathbf{\Delta }_{j_{2}j_{k_{2}}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}\cdots j_{2n}}\left( j_{1}j_{k_{1}}j_{k_{2}}\right)
\right)
\end{equation}%
hence 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}\cdots j_{2n}}\right) =\limfunc{Pf}%
\left( \mathbf{\Delta }_{j_{1}j_{2}},\cdots ,\mathbf{\Delta }_{j_{1}j_{n}},%
\mathbf{\Delta }_{j_{2}j_{3}},\cdots ,\mathbf{\Delta }_{j_{2}j_{n}},\cdots ,%
\mathbf{\Delta }_{j_{2n-1}j_{2n}}\right) =\tsum_{2\leq k_{1}<k_{2}\leq
2n}\left( -1\right) ^{k_{1}+k_{2}}\mathbf{\Delta }_{j_{1}j_{k_{1}}}\mathbf{%
\Delta }_{j_{2}j_{k_{2}}}\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}\cdots
j_{2n}}\left( j_{1}j_{k_{1}}j_{k_{2}}\right) \right)
\end{equation}
\end{corollary}

\begin{example}
$n=1;$%
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}}\right) =\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}j_{2}}\right) =\dsum\limits_{\rho \in DC_{2}^{2}}\pi
\left( \rho \right) \dprod\limits_{1\leq \leq k\leq n}\Delta _{j_{\rho
\left( 2k-1\right) }j_{\rho \left( 2k\right) }}=\frac{1}{2}%
\dsum\limits_{\sigma \in S_{2}}\pi \left( \sigma \right) \Delta _{j_{\sigma
\left( 1\right) }j_{\sigma \left( 2\right) }}=\frac{1}{2}\left( \mathbf{%
\Delta }_{j_{1}j_{2}}-\mathbf{\Delta }_{j_{2}j_{1}}\right)
\end{equation}%
then%
\begin{equation}
\mathbf{\Delta }_{jk}=-\mathbf{\Delta }_{kj}\Rightarrow \limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}j_{2}}\right) =\mathbf{\Delta }_{j_{1}j_{2}}.
\end{equation}
\end{example}

\begin{example}
$n=2;$

\begin{enumerate}
\item 
\begin{enumerate}
\item If $\mathbf{\Delta }$ is antisymmetric i.e. 
\begin{gather}
\mathbf{\Delta }_{jk}=-\mathbf{\Delta }_{kj}\text{ } \\
\Downarrow \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) =\Delta
_{j_{1}j_{2}}\Delta _{j_{3}j_{4}}-\Delta _{j_{1}j_{3}}\Delta
_{j_{2}j_{4}}+\Delta _{j_{1}j_{4}}\Delta _{j_{2}j_{3}}=\limfunc{Pf}\left(
\Delta _{j_{1}j_{2}}\right) \limfunc{Pf}\left( \Delta _{j_{3}j_{4}}\right) -%
\limfunc{Pf}\left( \Delta _{j_{1}j_{3}}\right) \limfunc{Pf}\left( \Delta
_{j_{2}j_{4}}\right) +\limfunc{Pf}\left( \Delta _{j_{1}j_{4}}\right) 
\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) ,
\end{gather}%
where 
\begin{equation}
\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) \equiv \left( \mathbf{%
\Delta }_{j_{1}j_{2}},\mathbf{\Delta }_{j_{1}j_{3}},\mathbf{\Delta }%
_{j_{1}j_{4}},\mathbf{\Delta }_{j_{2}j_{3}},\mathbf{\Delta }_{j_{2}j_{4}},%
\mathbf{\Delta }_{j_{3}j_{4}}\right) .
\end{equation}

\item Using the preceding definition%
\begin{align}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) & =%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\Delta }%
_{j_{1}j_{3}},\mathbf{\Delta }_{j_{1}j_{4}},\mathbf{\Delta }_{j_{2}j_{3}},%
\mathbf{\Delta }_{j_{2}j_{4}},\mathbf{\Delta }_{j_{3}j_{4}}\right) \\
& =\dsum\limits_{\rho \in DC_{2}^{4}}\pi \left( \rho \right)
\dprod\limits_{1\leq \leq k\leq 2}\Delta _{j_{\rho \left( 2k-1\right)
}j_{\rho \left( 2k\right) }}=\frac{1}{2^{2}2!}\dsum\limits_{\sigma \in
S_{4}}\pi \left( \sigma \right) \Delta _{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma \left( 3\right) }j_{\sigma
\left( 4\right) }}.
\end{align}%
hence

\item 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right)
=\dsum\limits_{\rho \in DC_{2}^{4}}\pi \left( \rho \right) \limfunc{Pf}%
\left( \Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right)
}}\right) \limfunc{Pf}\left( \Delta _{j_{\sigma \left( 3\right) }j_{\sigma
\left( 4\right) }}\right) .
\end{equation}
\end{enumerate}

\item Using the Lagrange type expansion%
\begin{eqnarray}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) &=&%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\Delta }%
_{j_{1}j_{3}},\mathbf{\Delta }_{j_{1}j_{4}},\mathbf{\Delta }_{j_{2}j_{3}},%
\mathbf{\Delta }_{j_{2}j_{4}},\mathbf{\Delta }_{j_{3}j_{4}}\right)
=\tsum_{2\leq k\leq 4}\left( -1\right) ^{k}\mathbf{\Delta }_{j_{1}j_{k}}%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left(
j_{1}j_{k}\right) \right) \\
&=&\left( -1\right) ^{2}\mathbf{\Delta }_{j_{1}j_{2}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left( j_{1}j_{2}\right) \right)
+\left( -1\right) ^{3}\mathbf{\Delta }_{j_{1}j_{3}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left( j_{1}j_{3}\right) \right)
+\left( -1\right) ^{4}\mathbf{\Delta }_{j_{1}j_{4}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left( j_{1}j_{4}\right) \right) \\
&=&\left( -1\right) ^{2}\mathbf{\Delta }_{j_{1}j_{2}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{3}j_{4}}\right) +\left( -1\right) ^{3}\mathbf{\Delta }%
_{j_{1}j_{3}}\limfunc{Pf}\left( \mathbf{\Delta }_{j_{2}j_{4}}\right) +\left(
-1\right) ^{4}\mathbf{\Delta }_{j_{1}j_{4}}\limfunc{Pf}\left( \mathbf{\Delta 
}_{j_{2}j_{3}}\right) \\
&=&\mathbf{\Delta }_{j_{1}j_{2}}\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{3}j_{4}}\right) -\mathbf{\Delta }_{j_{1}j_{3}}\limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{2}j_{4}}\right) +\mathbf{\Delta }_{j_{1}j_{4}}\limfunc{%
Pf}\left( \mathbf{\Delta }_{j_{2}j_{3}}\right) \\
&=&\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}}\right) \limfunc{Pf}%
\left( \mathbf{\Delta }_{j_{3}j_{4}}\right) -\limfunc{Pf}\left( \mathbf{%
\Delta }_{j_{1}j_{3}}\right) \limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{4}}\right) +\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{4}}%
\right) \limfunc{Pf}\left( \mathbf{\Delta }_{j_{2}j_{3}}\right)
\end{eqnarray}%
as%
\begin{equation}
\mathbf{\Delta }_{j_{3}j_{4}}=\mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left(
j_{1}j_{2}\right) ,\quad \mathbf{\Delta }_{j_{2}j_{4}}=\mathbf{\Delta }%
_{j_{1}j_{2}j_{3}j_{4}}\left( j_{1}j_{3}\right) \text{ and }\mathbf{\Delta }%
_{j_{2}j_{3}}=\mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left(
j_{1}j_{4}\right) ,
\end{equation}%
and 
\begin{eqnarray}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left(
j_{1}j_{2}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{3}j_{4}}\right) \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left(
j_{1}j_{3}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{4}}\right) \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\left(
j_{1}j_{4}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{3}}\right) .
\end{eqnarray}

\item 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right)
=\dsum\limits_{\sigma \in DC_{2}^{4}}\pi \left( \sigma \right) \Delta
_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }}=\dsum\limits_{\sigma \in
DC_{2}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta _{j_{\sigma
\left( 1\right) }j_{\sigma \left( 2\right) }}\right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 3\right) }j_{\sigma \left( 4\right) }}\right) .
\end{equation}
\end{enumerate}
\end{example}

\begin{example}
$n=3;$

\begin{enumerate}
\item Using the definition%
\begin{gather}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) =%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\cdots },\mathbf{%
\Delta }_{j_{5}j_{6}}\right) =\dsum\limits_{\rho \in DC_{2}^{6}}\pi \left(
\rho \right) \dprod\limits_{1\leq \leq k\leq 3}\Delta _{j_{\rho \left(
2k-1\right) }j_{\rho \left( 2k\right) }}=\dsum\limits_{\rho \in
DC_{2}^{6}}\pi \left( \rho \right) \Delta _{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma \left( 3\right) }j_{\sigma
\left( 4\right) }}\Delta _{j_{\sigma \left( 5\right) }j_{\sigma \left(
6\right) }} \\
=\frac{1}{2^{3}3!}\dsum\limits_{\sigma \in S_{6}}\pi \left( \sigma \right)
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\Delta
_{j_{\sigma \left( 3\right) }j_{\sigma \left( 4\right) }}\Delta _{j_{\sigma
\left( 5\right) }j_{\sigma \left( 6\right) }}.
\end{gather}

\item Using the Lagrange type expansion%
\begin{equation*}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) =%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\cdots },\mathbf{%
\Delta }_{j_{5}j_{6}}\right) =\tsum_{2\leq k\leq 6}\left( -1\right) ^{k}%
\mathbf{\Delta }_{j_{1}j_{k}}\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left( j_{1}j_{k}\right) \right)
\end{equation*}%
where%
\begin{eqnarray}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left(
j_{1}j_{2}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{3}j_{4}j_{5}j_{6}}\right) \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left(
j_{1}j_{3}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{4}j_{5}j_{6}}\right) \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left(
j_{1}j_{4}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{3}j_{5}j_{6}}\right) \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left(
j_{1}j_{5}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{3}j_{4}j_{6}}\right) \\
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left(
j_{1}j_{6}\right) \right) &=&\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{2}j_{3}j_{4}j_{5}}\right) .
\end{eqnarray}

\item The expansion 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right)
=\tsum_{2\leq k\leq 6}\left( -1\right) ^{k}\mathbf{\Delta }_{j_{1}j_{k}}%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\left(
j_{1}j_{k}\right) \right)
\end{equation}

can be expressed as 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right)
=\dsum\limits_{\sigma \in DC_{2}^{6}}\pi \left( \sigma \right) \Delta
_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }}\Delta _{j_{\sigma \left(
5\right) }j_{\sigma \left( 6\right) }}.
\end{equation}
\end{enumerate}
\end{example}

\begin{definition}
A \emph{Pfaffian minor} of order $2m$ of a $2n\times 2n$ skew symmetric
matrix $\Delta $ is a \emph{Pfaffian} of a $2m\times 2m$ submatrix of $%
\Delta ,$ where $m<n,$ consisting of rows and columns indexed by $%
j_{1},\cdots ,j_{2m}$ for some $j_{1}<\cdots <j_{2m},$ where $\left\{
j_{1},\cdots ,j_{2m}\right\} \subset \left\{ 1,\cdots ,2n\right\} $.
\end{definition}

\begin{notation}
\begin{equation}
\mathbf{\Delta }_{j_{1}\cdots j_{2n}}\equiv \mathbf{\Delta }\left( \left\{
j_{1},\cdots ,j_{2n}\right\} \right) \equiv \left( 
\begin{array}{cccc}
0 & \mathbf{\Delta }_{j_{1}j_{2}} & \cdots & \mathbf{\Delta }_{j_{1}j_{n}}
\\ 
-\mathbf{\Delta }_{j_{1}j_{2}} & \ddots & \ddots & \vdots \\ 
\vdots & \ddots & \ddots & \mathbf{\Delta }_{j_{2n-1}j_{2n}} \\ 
-\mathbf{\Delta }_{j_{1}j_{n}} & \cdots & -\mathbf{\Delta }_{j_{2n-1}j_{2n}}
& 0%
\end{array}%
\right) .
\end{equation}
\end{notation}

\begin{example}
$n=2:$

\begin{enumerate}
\item The $4^{th}$ order Pfaffian 
\begin{gather}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) =\limfunc{%
Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\Delta }_{j_{1}j_{3}},%
\mathbf{\Delta }_{j_{1}j_{4}},\mathbf{\Delta }_{j_{2}j_{3}},\mathbf{\Delta }%
_{j_{2}j_{4}},\mathbf{\Delta }_{j_{3}j_{4}}\right) =\frac{1}{2^{2}2!}%
\dsum\limits_{\sigma \in S_{4}}\pi \left( \sigma \right)
\dprod\limits_{1\leq k\leq 2}\Delta _{j_{\sigma \left( 2k-1\right)
}j_{\sigma \left( 2k\right) }} \\
=\frac{1}{8}\dsum\limits_{\sigma \in S_{4}}\pi \left( \sigma \right) \Delta
_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }}=\Delta _{j_{1}j_{2}}\Delta
_{j_{3}j_{4}}-\Delta _{j_{1}j_{3}}\Delta _{j_{2}j_{4}}+\Delta
_{j_{1}j_{4}}\Delta _{j_{2}j_{3}},
\end{gather}%
where the $4^{th}$ order symmetric group contains $24$ permutations $\sigma $
i.e. 
\begin{equation}
S_{4}=\left\{ \sigma _{1},\cdots ,\sigma _{24}\right\} .
\end{equation}

\item The action of this group on the index set of $4$ objects gives the set
of subsets 
\begin{gather}
S_{4}:\mathbb{N}_{1}^{4}\equiv \left\{ 1,2,3,4\right\} \rightarrow \left\{
\left. \left\{ \sigma _{j}\left( 1\right) ,\sigma _{j}\left( 2\right)
,\sigma _{j}\left( 3\right) ,\sigma _{j}\left( 4\right) \right\} \right\vert
1\leq j\leq 24\right\} \\
=\left\{ \left\{ 1,2,3,4\right\} ,\left\{ 1,2,4,3\right\} ,\cdots ,\left\{
4,3,2,1\right\} \right\} .
\end{gather}

\item This set contains the set of ordered subsets of disjoint sets of pairs 
\begin{equation}
\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 3,4\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,3\right\} ,\left\{ 2,4\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,4\right\} ,\left\{ 2,3\right\} }\right\} .
\end{equation}

\item The subset $C_{2}^{4}$ of ordered permutations $\eta \in S_{4}$
produces the set of ordered subsets of sets of ordered pairs 
\begin{equation}
C_{2}^{4}:\left\{ 1,2,3,4\right\} \rightarrow \left\{ \left\{ \left\{
1,2\right\} ,\left\{ 3,4\right\} \right\} ,\left\{ \left\{ 1,3\right\}
,\left\{ 2,4\right\} \right\} ,\left\{ \left\{ 1,4\right\} ,\left\{
2,3\right\} \right\} ,\left\{ \left\{ 2,3\right\} ,\left\{ 1,4\right\}
\right\} ,\left\{ \left\{ 2,4\right\} ,\left\{ 1,3\right\} \right\} ,\left\{
\left\{ 3,4\right\} ,\left\{ 1,2\right\} \right\} \right\}
\end{equation}%
i.e.%
\begin{eqnarray}
C_{2}^{4} &:&\mathbb{N}_{1}^{4}\equiv \left\{ 1,2,3,4\right\} \rightarrow
\left\{ \left. \left\{ \eta _{j}\left( 1\right) ,\eta _{j}\left( 2\right)
\right\} \right\vert 1\leq j\leq 6\right\} \\
&=&\left\{ \left\{ 1,2\right\} ,\left\{ 1,3\right\} ,\left\{ 1,4\right\}
,\left\{ 2,3\right\} ,\left\{ 2,4\right\} ,\left\{ 3,4\right\} \right\} \\
\eta _{j} &:&\mathbb{N}_{1}^{4}\equiv \left\{ 1,2,3,4\right\} \rightarrow
\left\{ \eta _{j}\left( 1\right) ,\eta _{j}\left( 2\right) \right\} .
\end{eqnarray}

\item Set of sets of ordered pairs selected from $\mathbb{N}_{1}^{4}$ 
\begin{gather}
C_{2}^{4}\left( \mathbb{N}_{1}^{4}\right) =\left\{ \overset{}{\left\{
1,2\right\} ,\left\{ 1,3\right\} ,\left\{ 1,4\right\} ,\left\{ 2,3\right\}
,\left\{ 2,4\right\} ,\left\{ 3,4\right\} }\right\} \\
\divideontimes \left( C_{2}^{4}\left( \mathbb{N}_{1}^{4}\right) \right) =%
\binom{4}{2}=6
\end{gather}

\item Set of disjoint sets of ordered pairs selected from $\mathbb{N}%
_{1}^{4} $ is 
\begin{gather}
DC_{2}^{4}\left( \mathbb{N}_{1}^{4}\right) =\left\{ 
\begin{array}{c}
\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 3,4\right\} }\right\} , \\ 
\left\{ \overset{}{\left\{ 1,3\right\} ,\left\{ 2,4\right\} }\right\} , \\ 
\left\{ \overset{}{\left\{ 1,4\right\} ,\left\{ 2,3\right\} }\right\} , \\ 
\left\{ \overset{}{\left\{ 2,3\right\} ,\left\{ 1,4\right\} }\right\} , \\ 
\left\{ \overset{}{\left\{ 2,4\right\} ,\left\{ 1,3\right\} }\right\} , \\ 
\left\{ \overset{}{\left\{ 3,4\right\} ,\left\{ 1,2\right\} }\right\}%
\end{array}%
\right\} \\
\divideontimes \left( DC_{2}^{4}\left( \mathbb{N}_{1}^{4}\right) \right) =%
\frac{1}{2}\binom{4}{2}\binom{2}{2}=3
\end{gather}

\item Number of ways to select sets of ordered pairs from $\mathbb{N}%
_{1}^{4} $ equals number of sets of ordered pairs $=\binom{4}{2}=6$

\item Number of ways to select sets of ordered pairs from $\mathbb{N}%
_{1}^{2} $ equals number of sets of ordered pairs $=\binom{2}{2}=1$

\item Number of pairs of \emph{disjoint} odered sets of pairs $%
\divideontimes \left( DC_{2}^{4}\right) =$ $\frac{1}{2}\binom{4}{2}\binom{2}{%
2}=\frac{6}{2}=3$

\item Number of pairs of odered sets of pairs $\divideontimes \left(
C_{2}^{4}\right) =\binom{4}{2}^{2}$ $=36$
\end{enumerate}
\end{example}

\begin{example}
$n=3:$

\begin{enumerate}
\item The $6^{th}$ order Pfaffian 
\begin{gather}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) =%
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\cdots },\mathbf{%
\Delta }_{j_{5}j_{6}}\right) =\frac{1}{2^{3}3!}\dsum\limits_{\sigma \in
S_{6}}\pi \left( \sigma \right) \dprod\limits_{1\leq k\leq 3}\Delta
_{j_{\sigma \left( 2k-1\right) }j_{\sigma \left( 2k\right)
}}=\dsum\limits_{\sigma \in DC_{2}^{6}}\pi \left( \sigma \right)
\dprod\limits_{1\leq k\leq 3}\Delta _{j_{\sigma \left( 2k-1\right)
}j_{\sigma \left( 2k\right) }} \\
=\frac{1}{48}\dsum\limits_{\sigma \in S_{6}}\pi \left( \sigma \right) \Delta
_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }}\Delta _{j_{\sigma \left(
5\right) }j_{\sigma \left( 6\right) }}=\dsum\limits_{\sigma \in
DC_{2}^{6}}\pi \left( \sigma \right) \Delta _{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma \left( 3\right) }j_{\sigma
\left( 4\right) }}\Delta _{j_{\sigma \left( 5\right) }j_{\sigma \left(
6\right) }},
\end{gather}

\item 
\begin{gather}
DC_{2}^{6}\left\{ \mathbb{N}_{1}^{6}\right\} =\overset{{\Huge \longleftarrow
\qquad \qquad \qquad \qquad \qquad \qquad {\LARGE 6}\qquad \qquad \qquad
\qquad \qquad \qquad \longrightarrow }}{\left\{ 
\begin{array}{c}
\uparrow \\ 
\overset{\overset{}{}}{\underset{\underset{}{}}{15}} \\ 
\downarrow%
\end{array}%
\begin{array}{c}
\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 3,4\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 3,5\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 3,6\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 4,5\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 4,6\right\} }\right\}
,\left\{ \overset{}{\left\{ 1,2\right\} ,\left\{ 5,6\right\} }\right\} , \\ 
\vdots \qquad \qquad \qquad \qquad \qquad \qquad \qquad \qquad \vdots \qquad
\qquad \qquad \qquad \qquad \qquad \qquad \qquad \qquad \qquad \qquad \qquad
\vdots \\ 
\left\{ \overset{}{\left\{ 5,6\right\} ,\left\{ 1,2\right\} }\right\}
,\left\{ \overset{}{\left\{ 5,6\right\} ,\left\{ 1,3\right\} }\right\}
,\left\{ \overset{}{\left\{ 5,6\right\} ,\left\{ 1,4\right\} }\right\}
,\left\{ \overset{}{\left\{ 5,6\right\} ,\left\{ 2,3\right\} }\right\}
,\left\{ \overset{}{\left\{ 5,6\right\} ,\left\{ 2,4\right\} }\right\}
,\left\{ \overset{}{\left\{ 5,6\right\} ,\left\{ 3,4\right\} }\right\} .%
\end{array}%
\right\} } \\
\divideontimes \left( DC_{2}^{6}\left\{ \mathbb{N}_{1}^{6}\right\} \right) =%
\frac{1}{2}\binom{6}{2}\binom{4}{2}\binom{2}{2}=45
\end{gather}

\item Number of ways to select sets of ordered pairs from $\mathbb{N}%
_{1}^{6} $ equals number of sets of ordered pairs $=\binom{6}{2}=15$

\item Number of ways to select sets of ordered pairs from $\mathbb{N}%
_{1}^{4} $ equals number of sets of ordered pairs $=\binom{4}{2}=6$

\item Number of pairs of disjoint odered sets of pairs $\divideontimes
\left( DC_{2}^{6}\right) =$ $\frac{1}{2}\binom{6}{2}\binom{4}{2}=\frac{%
15\times 6}{2}=45$

\item Number of pairs of odered sets of pairs $\divideontimes \left(
C_{2}^{6}\right) =\binom{6}{2}^{2}$ $=225.$
\end{enumerate}
\end{example}

\begin{lemma}
Number of ways to select subsets of disjoint ordered pairs from $\mathbb{N}%
_{1}^{2n}$ is 
\begin{equation}
\divideontimes \left( DC_{2}^{2n}\left( \mathbb{N}_{1}^{2n}\right) \right) =%
\frac{1}{n!}\binom{2n}{2}\binom{2n-2}{2}\cdots \binom{2}{2}.
\end{equation}
\end{lemma}

\begin{proof}
\begin{enumerate}
\item 
\begin{equation}
n=1:\divideontimes \left( DC_{2}^{2}\left( \mathbb{N}_{1}^{2}\right) \right)
=\frac{1}{1!}\binom{2}{2}=1
\end{equation}

\item 
\begin{equation}
n=2:\divideontimes \left( DC_{2}^{4}\left( \mathbb{N}_{1}^{4}\right) \right)
=\frac{1}{2!}\binom{4}{2}\binom{2}{2}=6
\end{equation}

\item 
\begin{equation}
n=3:\divideontimes \left( DC_{2}^{6}\left( \mathbb{N}_{1}^{6}\right) \right)
=\frac{1}{3!}\binom{6}{2}\binom{4}{2}\binom{2}{2}=\frac{1}{6}\times 15\times
6\times 1=15
\end{equation}

\item 
\begin{equation}
n=4:\divideontimes \left( DC_{2}^{8}\left( \mathbb{N}_{1}^{8}\right) \right)
=\frac{1}{4!}\binom{8}{2}\binom{6}{2}\binom{4}{2}\binom{2}{2}=\frac{1}{24}%
28\times 15\times 6\times 1=105
\end{equation}
\end{enumerate}
\end{proof}

\begin{remark}
\emph{All odd order pfaffians are zero by definition.}
\end{remark}

\begin{remark}
The zeroth order pfaffian is $=1$
\end{remark}

\begin{remark}
The second order pfaffian is $\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{1}j_{2}}\right) =\mathbf{\Delta }_{j_{1}j_{2}}$
\end{remark}

\begin{remark}
The fourth order pfaffian is%
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) =\limfunc{%
Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}},\mathbf{\Delta }_{j_{1}j_{3}},%
\mathbf{\Delta }_{j_{1}j_{4}},\mathbf{\Delta }_{j_{2}j_{3}},\mathbf{\Delta }%
_{j_{2}j_{4}},\mathbf{\Delta }_{j_{3}j_{4}}\right) =\Delta
_{j_{1}j_{2}}\Delta _{j_{3}j_{4}}-\Delta _{j_{1}j_{3}}\Delta
_{j_{2}j_{4}}+\Delta _{j_{1}j_{4}}\Delta _{j_{2}j_{3}}.
\end{equation}
\end{remark}

\begin{remark}
The sixth order pfaffian can be expanded in terms of sub Pfaffians as%
\begin{gather}
\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right)
=\dsum\limits_{\sigma \in DC_{2}^{6}}\pi \left( \sigma \right) \Delta
_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\Delta _{j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }}\Delta _{j_{\sigma \left(
5\right) }j_{\sigma \left( 6\right) }}  \notag \\
\parallel \\
+\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}}\right) \limfunc{Pf}\left(
\Delta _{j_{5}j_{6}}\right) =+\left( \Delta _{j_{1}j_{2}}\Delta
_{j_{3}j_{4}}-\Delta _{j_{1}j_{3}}\Delta _{j_{2}j_{4}}+\Delta
_{j_{1}j_{4}}\Delta _{j_{2}j_{3}}\right) \limfunc{Pf}\left( \Delta
_{j_{5}j_{6}}\right) \\
-\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{4}j_{6}}\right) =-\left( \Delta _{j_{1}j_{2}}\Delta
_{j_{3}j_{5}}-\Delta _{j_{1}j_{3}}\Delta _{j_{2}j_{5}}+\Delta
_{j_{1}j_{5}}\Delta _{j_{2}j_{3}}\right) \limfunc{Pf}\left( \Delta
_{j_{4}j_{6}}\right) \\
+\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{4}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{3}j_{6}}\right) =+\left( \Delta _{j_{1}j_{2}}\Delta
_{j_{4}j_{5}}-\Delta _{j_{1}j_{4}}\Delta _{j_{2}j_{5}}+\Delta
_{j_{1}j_{5}}\Delta _{j_{2}j_{4}}\right) \limfunc{Pf}\left( \Delta
_{j_{3}j_{6}}\right) \\
-\limfunc{Pf}\left( \Delta _{j_{1}j_{3}j_{4}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{2}j_{6}}\right) =-\left( \Delta _{j_{1}j_{3}}\Delta
_{j_{4}j_{5}}-\Delta _{j_{1}j_{4}}\Delta _{j_{3}j_{5}}+\Delta
_{j_{1}j_{5}}\Delta _{j_{3}j_{4}}\right) \limfunc{Pf}\left( \Delta
_{j_{2}j_{6}}\right) \\
+\limfunc{Pf}\left( \Delta _{j_{2}j_{3}j_{4}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{1}j_{6}}\right) =+\left( \Delta _{j_{2}j_{3}}\Delta
_{j_{4}j_{5}}-\Delta _{j_{2}j_{4}}\Delta _{j_{3}j_{5}}+\Delta
_{j_{2}j_{5}}\Delta _{j_{3}j_{4}}\right) \limfunc{Pf}\left( \Delta
_{j_{1}j_{6}}\right) \\
\parallel
\end{gather}
\end{remark}

\begin{gather}
+\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}}\right) \limfunc{Pf}\left(
\Delta _{j_{5}j_{6}}\right) =+\left( \limfunc{Pf}\left( \Delta
_{j_{1}j_{2}}\right) \limfunc{Pf}\left( \Delta _{j_{3}j_{4}}\right) -%
\limfunc{Pf}\left( \Delta _{j_{1}j_{3}}\right) \limfunc{Pf}\left( \Delta
_{j_{2}j_{4}}\right) +\limfunc{Pf}\left( \Delta _{j_{1}j_{4}}\right) 
\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) \right) \limfunc{Pf}\left(
\Delta _{j_{5}j_{6}}\right) \\
-\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{4}j_{6}}\right) =-\left( \limfunc{Pf}\left( \Delta
_{j_{1}j_{2}}\right) \limfunc{Pf}\left( \Delta _{j_{3}j_{5}}\right) -%
\limfunc{Pf}\left( \Delta _{j_{1}j}\right) \limfunc{Pf}\left( \Delta
_{j_{2}j_{5}}\right) +\limfunc{Pf}\left( \Delta _{j_{1}j_{5}}\right) 
\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) \right) \limfunc{Pf}\left(
\Delta _{j_{4}j_{6}}\right) \\
+\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{4}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{3}j_{6}}\right) =+\left( \limfunc{Pf}\left( \Delta
_{j_{1}j_{2}}\right) \limfunc{Pf}\left( \Delta _{j_{4}j_{5}}\right) -%
\limfunc{Pf}\left( \Delta _{j_{1}j_{4}}\right) \limfunc{Pf}\left( \Delta
_{j_{2}j_{5}}\right) +\limfunc{Pf}\left( \Delta _{j_{1}j_{5}}\right) 
\limfunc{Pf}\left( \Delta _{j_{2}j_{4}}\right) \right) \limfunc{Pf}\left(
\Delta _{j_{3}j_{6}}\right) \\
-\limfunc{Pf}\left( \Delta _{j_{1}j_{3}j_{4}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{2}j_{6}}\right) =-\left( \limfunc{Pf}\left( \Delta
_{j_{1}j_{3}}\right) \limfunc{Pf}\left( \Delta _{j_{4}j_{5}}\right) -%
\limfunc{Pf}\left( \Delta _{j_{1}j_{4}}\right) \limfunc{Pf}\left( \Delta
_{j_{3}j_{5}}\right) +\limfunc{Pf}\left( \Delta _{j_{1}j_{5}}\right) 
\limfunc{Pf}\left( \Delta _{j_{3}j_{4}}\right) \right) \limfunc{Pf}\left(
\Delta _{j_{2}j_{6}}\right) \\
+\limfunc{Pf}\left( \Delta _{j_{2}j_{3}j_{4}j_{5}}\right) \limfunc{Pf}\left(
\Delta _{j_{1}j_{6}}\right) =+\left( \limfunc{Pf}\left( \Delta
_{j_{2}j_{3}}\right) \limfunc{Pf}\left( \Delta _{j_{4}j_{5}}\right) -%
\limfunc{Pf}\left( \Delta _{j_{2}j_{4}}\right) \limfunc{Pf}\left( \Delta
_{j_{3}j_{5}}\right) +\limfunc{Pf}\left( \Delta _{j_{2}j_{5}}\right) 
\limfunc{Pf}\left( \Delta _{j_{3}j_{4}}\right) \right) \limfunc{Pf}\left(
\Delta _{j_{1}j_{6}}\right) .
\end{gather}

\begin{remark}
The pfaffian $\limfunc{Pf}\left( \mathbf{\Delta }_{1234}\right) $ of the $%
4\times 4$ antisymmetric matrix 
\begin{equation}
\left( 
\begin{array}{cccc}
0 & \mathbf{\Delta }_{12} & \mathbf{\Delta }_{13} & \mathbf{\Delta }_{14} \\ 
-\mathbf{\Delta }_{12} & 0 & \mathbf{\Delta }_{23} & \mathbf{\Delta }_{24}
\\ 
-\mathbf{\Delta }_{13} & -\mathbf{\Delta }_{23} & 0 & \mathbf{\Delta }_{34}
\\ 
-\mathbf{\Delta }_{14} & -\mathbf{\Delta }_{24} & -\mathbf{\Delta }_{34} & 0%
\end{array}%
\right)
\end{equation}%
is 
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{1234}\right) =\limfunc{Pf}\left( \Delta
_{12},\Delta _{13},\Delta _{14},\Delta _{23},\Delta _{24},\Delta
_{34}\right) =\Delta _{12}\Delta _{34}-\Delta _{13}\Delta _{24}+\Delta
_{14}\Delta _{23},
\end{equation}%
which is the same as the pfaffian $\limfunc{Pf}\left( \mathbf{\Delta }%
_{1234}\right) $ of the general $4\times 4$ matrix 
\begin{equation}
\mathbf{\Delta }_{4}=\left( 
\begin{array}{cccc}
\mathbf{\Delta }_{11} & \mathbf{\Delta }_{12} & \mathbf{\Delta }_{13} & 
\mathbf{\Delta }_{14} \\ 
\mathbf{\Delta }_{21} & \mathbf{\Delta }_{22} & \mathbf{\Delta }_{23} & 
\mathbf{\Delta }_{24} \\ 
\mathbf{\Delta }_{31} & \mathbf{\Delta }_{32} & \mathbf{\Delta }_{33} & 
\mathbf{\Delta }_{34} \\ 
\mathbf{\Delta }_{41} & \mathbf{\Delta }_{42} & \mathbf{\Delta }_{43} & 
\mathbf{\Delta }_{44}%
\end{array}%
\right) ,
\end{equation}%
\emph{when we only consider the top triangle}.

The pfaffian $\limfunc{Pf}\left( \mathbf{\Delta }_{1122}\right) $ based on
the matrix $\mathbf{\Delta }_{4}$ is%
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }_{1122}\right) =\limfunc{Pf}\left( \Delta
_{11},\Delta _{12},\Delta _{12},\Delta _{12},\Delta _{12},\Delta
_{22}\right) =\Delta _{11}\Delta _{22}-\Delta _{12}\Delta _{12}+\Delta
_{12}\Delta _{12}=\Delta _{11}\Delta _{22}
\end{equation}%
and is the pfaffian of 
\begin{equation}
\left( 
\begin{array}{cccc}
0 & \mathbf{\Delta }_{11} & \mathbf{\Delta }_{12} & \mathbf{\Delta }_{12} \\ 
-\mathbf{\Delta }_{11} & 0 & \mathbf{\Delta }_{12} & \mathbf{\Delta }_{12}
\\ 
-\mathbf{\Delta }_{13} & -\mathbf{\Delta }_{12} & 0 & \mathbf{\Delta }_{22}
\\ 
-\mathbf{\Delta }_{12} & -\mathbf{\Delta }_{12} & -\mathbf{\Delta }_{22} & 0%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{definition}
Lagrange Expansion for Pfaffians 
\begin{equation}
\limfunc{Pf}\left( A_{1\cdots 2m}\right) =\limfunc{Pf}\left( A_{1},\cdots
,A_{2m}\right) =\sum_{2\leq j\leq m}\limfunc{Pf}\left( A_{1},A_{j}\right)
\left( -1\right) ^{j}\limfunc{Pf}\left( A_{2},\cdots ,\widehat{A_{j}},\cdots
,A_{2m}\right) .
\end{equation}
\end{definition}

\begin{example}
$m=1$%
\begin{eqnarray}
\limfunc{Pf}\left( A_{12}\right) &=&\limfunc{Pf}\left( A_{1},A_{2}\right)
=\sum_{2\leq j\leq 2}\limfunc{Pf}\left( A_{1},A_{j}\right) \left( -1\right)
^{j}\limfunc{Pf}\left( A_{2},\cdots ,\widehat{A_{j}},\cdots ,A_{2m}\right) \\
&=&\limfunc{Pf}\left( A_{1},A_{2}\right) \left( -1\right) ^{2}=\limfunc{Pf}%
\left( A_{1},A_{2}\right)
\end{eqnarray}
\end{example}

\begin{example}
$m=2$%
\begin{eqnarray}
\limfunc{Pf}\left( A_{1\cdots 4}\right) &=&\limfunc{Pf}\left( A_{1},\cdots
,A_{4}\right) =\sum_{2\leq j\leq 4}\limfunc{Pf}\left( A_{1},A_{j}\right)
\left( -1\right) ^{j}\limfunc{Pf}\left( A_{2},\cdots ,\widehat{A_{j}},\cdots
,A_{4}\right) \\
&=&\limfunc{Pf}\left( A_{1},A_{2}\right) \left( -1\right) ^{2}\limfunc{Pf}%
\left( A_{2},A_{4}\right) +\limfunc{Pf}\left( A_{1},A_{3}\right) \left(
-1\right) ^{3}\limfunc{Pf}\left( A_{2},A_{4}\right) +\limfunc{Pf}\left(
A_{1},A_{4}\right) \left( -1\right) ^{4}\limfunc{Pf}\left( A_{2},A_{3}\right)
\end{eqnarray}
\end{example}

\subparagraph{Continue main theme}

\begin{enumerate}
\item[3] The third order products are given by 
\begin{equation}
\text{(noting that }\left\langle \left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{2}x_{j_{3}}\right\rangle _{1}=\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{2}\rfloor x_{j_{3}}=\left\langle
x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}-\left\langle
x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}\text{)}
\end{equation}%
\begin{align}
x_{j_{1}}x_{j_{2}}x_{j_{3}}& =\left( x_{j_{1}}x_{j_{2}}\right)
x_{j_{3}}=\left( x_{j_{1}}x_{j_{2}}\right) \rfloor x_{j_{3}}+\left(
x_{j_{1}}x_{j_{2}}\right) \wedge x_{j_{3}}  \notag \\
& =\left\langle \left\langle x_{j_{1}}x_{j_{2}}\right\rangle
_{2}x_{j_{3}}\right\rangle _{1}+\left( \left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{0}+\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{2}\right) \wedge x_{j_{3}}  \notag \\
& =\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}-\left\langle
x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}+\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}+\left\langle
x_{j_{1}}x_{j_{2}}x_{j_{3}}\right\rangle _{3}  \notag \\
& =\left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}\right\rangle _{3}+\left\langle
x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}-\left\langle
x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}+\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}  \notag \\
& =x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}+\left( \left.
x_{j_{2}}\right\vert x_{j_{3}}\right) x_{j_{1}}-\left( \left.
x_{j_{1}}\right\vert x_{j_{3}}\right) x_{j_{2}}+\left( \left.
x_{j_{1}}\right\vert x_{j_{2}}\right) x_{j_{3}}.
\end{align}%
giving%
\begin{equation}
x_{j_{1}}x_{j_{2}}x_{j_{3}}=x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}+%
\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) x_{j_{1}}-\limfunc{Pf}\left(
\Delta _{j_{1}j_{3}}\right) x_{j_{2}}+\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}}\right) x_{j_{3}}
\end{equation}%
and 
\begin{equation}
x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}=x_{j_{1}}x_{j_{2}}x_{j_{3}}-%
\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) x_{j_{1}}+\limfunc{Pf}\left(
\Delta _{j_{1}j_{3}}\right) x_{j_{2}}-\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}}\right) x_{j_{3}}.
\end{equation}

\item[4] The fourth order products are given by 
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=\left(
x_{j_{1}}x_{j_{2}}x_{j_{3}}\right) x_{j_{4}}=\left(
x_{j_{1}}x_{j_{2}}x_{j_{3}}\right) \rfloor x_{j_{4}}+\left(
x_{j_{1}}x_{j_{2}}x_{j_{3}}\right) \wedge x_{j_{4}}  \notag \\
& =\left( \left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}\right\rangle
_{3}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}-\left\langle
x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}+\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\right) \rfloor x_{j_{4}} 
\notag \\
& +\left( \left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}\right\rangle
_{3}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}-\left\langle
x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}+\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\right) \wedge x_{j_{4}} \\
& =\left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}\right\rangle _{3}\rfloor
x_{j_{4}}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}\rfloor
x_{j_{4}}-\left\langle x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}\rfloor
x_{j_{4}}+\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\rfloor
x_{j_{4}}  \notag \\
& +\left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}\right\rangle _{3}\wedge
x_{j_{4}}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}\wedge
x_{j_{4}}-\left\langle x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}\wedge
x_{j_{4}}+\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\wedge
x_{j_{4}}  \notag \\
& =\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{2}x_{j_{3}}\rfloor
x_{j_{4}}-\left\langle x_{j_{1}}x_{j_{3}}\right\rangle _{2}x_{j_{2}}\rfloor
x_{j_{4}}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{2}x_{j_{1}}\rfloor
x_{j_{4}}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}\rfloor
x_{j_{4}}-\left\langle x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}\rfloor
x_{j_{4}}+\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\rfloor
x_{j_{4}}  \notag \\
& +\left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}\right\rangle
_{3}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}\wedge
x_{j_{4}}-\left\langle x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}\wedge
x_{j_{4}}+\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\wedge
x_{j_{4}}  \notag \\
& =\left\langle x_{j_{3}}x_{j_{4}}\right\rangle _{0}x_{j_{1}}\wedge
x_{j_{2}}-\left\langle x_{j_{2}}x_{j_{4}}\right\rangle _{0}x_{j_{1}}\wedge
x_{j_{3}}+\left\langle x_{j_{1}}x_{j_{4}}\right\rangle _{0}x_{j_{2}}\wedge
x_{j_{3}}  \notag \\
& +\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}\left\langle
x_{j_{1}}x_{j_{4}}\right\rangle _{0}-\left\langle
x_{j_{1}}x_{j_{3}}\right\rangle _{0}\left\langle
x_{j_{2}}x_{j_{4}}\right\rangle _{0}+\left\langle
x_{j_{1}}x_{j_{2}}\right\rangle _{0}\left\langle
x_{j_{3}}x_{j_{4}}\right\rangle _{0} \\
& +\left\langle x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}\right\rangle
_{3}+\left\langle x_{j_{2}}x_{j_{3}}\right\rangle _{0}x_{j_{1}}\wedge
x_{j_{4}}-\left\langle x_{j_{1}}x_{j_{3}}\right\rangle _{0}x_{j_{2}}\wedge
x_{j_{4}}+\left\langle x_{j_{1}}x_{j_{2}}\right\rangle _{0}x_{j_{3}}\wedge
x_{j_{4}}  \notag \\
& =x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\left( \left. x_{j_{1}}\right\vert x_{j_{2}}\right) x_{j_{3}}\wedge
x_{j_{4}}-\left( \left. x_{j_{1}}\right\vert x_{j_{3}}\right)
x_{j_{2}}\wedge x_{j_{4}}+\left( \left. x_{j_{1}}\right\vert
x_{j_{4}}\right) x_{j_{2}}\wedge x_{j_{3}}  \notag \\
& +\left( \left. x_{j_{2}}\right\vert x_{j_{3}}\right) x_{j_{1}}\wedge
x_{j_{4}}-\left( \left. x_{j_{2}}\right\vert x_{j_{4}}\right)
x_{j_{1}}\wedge x_{j_{3}}+\left( \left. x_{j_{3}}\right\vert
x_{j_{4}}\right) x_{j_{1}}\wedge x_{j_{2}}  \notag \\
& +\left( \left. x_{j_{1}}\right\vert x_{j_{2}}\right) \left( \left.
x_{j_{3}}\right\vert x_{j_{4}}\right) -\left( \left. x_{j_{1}}\right\vert
x_{j_{3}}\right) \left( \left. x_{j_{2}}\right\vert x_{j_{4}}\right) +\left(
\left. x_{j_{1}}\right\vert x_{j_{4}}\right) \left( \left.
x_{j_{2}}\right\vert x_{j_{3}}\right) .
\end{align}%
Giving 
\begin{align}
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}& =x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\left( \left. x_{j_{1}}\right\vert x_{j_{2}}\right) x_{j_{3}}\wedge
x_{j_{4}}-\left( \left. x_{j_{1}}\right\vert x_{j_{3}}\right)
x_{j_{2}}\wedge x_{j_{4}}+\left( \left. x_{j_{1}}\right\vert
x_{j_{4}}\right) x_{j_{2}}\wedge x_{j_{3}}  \notag \\
& +\left( \left. x_{j_{2}}\right\vert x_{j_{3}}\right) x_{j_{1}}\wedge
x_{j_{4}}-\left( \left. x_{j_{2}}\right\vert x_{j_{4}}\right)
x_{j_{1}}\wedge x_{j_{3}}+\left( \left. x_{j_{3}}\right\vert
x_{j_{4}}\right) x_{j_{1}}\wedge x_{j_{2}}  \notag \\
& +\left( \left. x_{j_{1}}\right\vert x_{j_{2}}\right) \left( \left.
x_{j_{3}}\right\vert x_{j_{4}}\right) -\left( \left. x_{j_{1}}\right\vert
x_{j_{3}}\right) \left( \left. x_{j_{2}}\right\vert x_{j_{4}}\right) +\left(
\left. x_{j_{1}}\right\vert x_{j_{4}}\right) \left( \left.
x_{j_{2}}\right\vert x_{j_{3}}\right)
\end{align}%
and thus 
\begin{align}
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}& =x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\Delta _{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}-\Delta
_{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}+\Delta _{j_{1}j_{4}}x_{j_{2}}\wedge
x_{j_{3}}  \notag \\
& +\Delta _{j_{2}j_{23}}x_{j_{1}}\wedge x_{j_{4}}-\Delta
_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}+\Delta _{j_{3}j_{4}}x_{j_{1}}\wedge
x_{j_{2}}  \notag \\
& +\Delta _{j_{1}j_{2}}\Delta _{j_{3}j_{4}}-\Delta _{j_{1}j_{3}}\Delta
_{j_{2}j_{4}}+\Delta _{j_{1}j_{4}}\Delta _{j_{2}j_{23}}.
\end{align}%
which can also be expressed as 
\begin{align}
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}& =x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{1}j_{2}}\right) x_{j_{3}}\wedge x_{j_{4}}-%
\limfunc{Pf}\left( \Delta _{j_{1}j_{3}}\right) x_{j_{2}}\wedge x_{j_{4}}+%
\limfunc{Pf}\left( \Delta _{j_{1}j_{4}}\right) x_{j_{2}}\wedge x_{j_{3}} 
\notag \\
& +\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) x_{j_{1}}\wedge x_{j_{4}}-%
\limfunc{Pf}\left( \Delta _{j_{2}j_{4}}\right) x_{j_{1}}\wedge x_{j_{3}}+%
\limfunc{Pf}\left( \Delta _{j_{3}j_{4}}\right) x_{j_{1}}\wedge x_{j_{2}} 
\notag \\
& +\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}}\right) .
\end{align}%
$\lceil $To check we derive this again by 
\begin{align}
& x_{i}x_{j}x_{k}x_{l}=\left\{ \left( x_{i}\left\vert x_{j}\right. \right)
+x_{i}\wedge x_{j}\right\} \left\{ \left( x_{k}\left\vert x_{l}\right.
\right) +x_{k}\wedge x_{l}\right\}  \notag \\
& =\left( x_{i}\left\vert x_{j}\right. \right) \left( x_{k}\left\vert
x_{l}\right. \right) +\left( x_{i}\left\vert x_{j}\right. \right)
x_{k}\wedge x_{l}+\left( x_{k}\left\vert x_{l}\right. \right) x_{i}\wedge
x_{j}+\left( x_{i}\wedge x_{j}\right) \left( x_{k}\wedge x_{l}\right)  \notag
\\
& =\left( x_{i}\left\vert x_{j}\right. \right) \left( x_{k}\left\vert
x_{l}\right. \right) +\left( x_{i}\left\vert x_{j}\right. \right)
x_{k}\wedge x_{l}+\left( x_{k}\left\vert x_{l}\right. \right) x_{i}\wedge
x_{j}  \notag \\
& -\left( \left. x_{i}\right\vert x_{k}\right) x_{j}\wedge x_{l}+\left(
\left. x_{i}\right\vert x_{l}\right) x_{j}\wedge x_{k}+\left( \left.
x_{j}\right\vert x_{k}\right) x_{i}\wedge x_{l}-\left( \left.
x_{j}\right\vert x_{l}\right) x_{i}\wedge x_{k}  \notag \\
& +x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}
\end{align}%
$\rfloor $

\item[5] The fifth order by 
\begin{align}
x_{i}x_{j}x_{k}x_{l}x_{m}& =\left\{ x_{i}\wedge x_{j}\wedge x_{k}\wedge
x_{l}+\left( \left. x_{i}\right\vert x_{j}\right) x_{k}\wedge x_{l}-\left(
\left. x_{i}\right\vert x_{k}\right) x_{j}\wedge x_{l}+\left( \left.
x_{i}\right\vert x_{l}\right) x_{j}\wedge x_{k}\right.  \notag \\
& +\left( \left. x_{j}\right\vert x_{k}\right) x_{i}\wedge x_{l}-\left(
\left. x_{j}\right\vert x_{l}\right) x_{i}\wedge x_{k}+\left( \left.
x_{k}\right\vert x_{l}\right) x_{i}\wedge x_{j}  \notag \\
& +\left. \left( \left. x_{i}\right\vert x_{j}\right) \left( \left.
x_{k}\right\vert x_{l}\right) -\left( \left. x_{i}\right\vert x_{k}\right)
\left( \left. x_{j}\right\vert x_{l}\right) +\left( \left. x_{i}\right\vert
x_{l}\right) \left( \left. x_{j}\right\vert x_{k}\right) \right\} x_{m}.
\end{align}%
$\lceil $%
\begin{align}
\left\{ x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\right\} x_{m}&
=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge x_{m}+x_{i}\wedge
x_{j}\wedge x_{k}\left( \left. x_{l}\right\vert x_{m}\right) -x_{i}\wedge
x_{j}\wedge x_{l}\left( \left. x_{k}\right\vert x_{m}\right)  \notag \\
& +x_{i}\wedge x_{k}\wedge x_{l}\left( \left. x_{j}\right\vert x_{m}\right)
-x_{j}\wedge x_{k}\wedge x_{l}\left( \left. x_{i}\right\vert x_{m}\right) 
\notag \\
\left\{ \left( \left. x_{i}\right\vert x_{j}\right) x_{k}\wedge
x_{l}\right\} x_{m}& =\left( \left. x_{i}\right\vert x_{j}\right) \left\{
x_{k}\wedge x_{l}\wedge x_{m}+\left( \left. x_{l}\right\vert x_{m}\right)
x_{k}-\left( \left. x_{k}\right\vert x_{m}\right) x_{l}\right\}  \notag \\
& =\left( \left. x_{i}\right\vert x_{j}\right) x_{k}\wedge x_{l}\wedge
x_{m}+\left( \left. x_{i}\right\vert x_{j}\right) \left( \left.
x_{l}\right\vert x_{m}\right) x_{k}-\left( \left. x_{i}\right\vert
x_{j}\right) \left( \left. x_{k}\right\vert x_{m}\right) x_{l}  \notag \\
\left( \left. x_{i}\right\vert x_{j}\right) \left( \left. x_{k}\right\vert
x_{l}\right) x_{m}& =\left( \left. x_{i}\right\vert x_{j}\right) \left(
\left. x_{k}\right\vert x_{l}\right) x_{m}
\end{align}%
$\rfloor $ giving 
\begin{align}
& x_{i}x_{j}x_{k}x_{l}x_{m}=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge
x_{m}  \notag \\
& +\left( \left. x_{i}\right\vert x_{j}\right) x_{k}\wedge x_{l}\wedge
x_{m}-\left( \left. x_{i}\right\vert x_{k}\right) x_{j}\wedge x_{l}\wedge
x_{m}+\left( \left. x_{i}\right\vert x_{l}\right) x_{j}\wedge x_{k}\wedge
x_{m}  \notag \\
& +\left( \left. x_{j}\right\vert x_{k}\right) x_{i}\wedge x_{l}\wedge
x_{m}-\left( \left. x_{j}\right\vert x_{l}\right) x_{i}\wedge x_{k}\wedge
x_{m}+\left( \left. x_{k}\right\vert x_{l}\right) x_{i}\wedge x_{j}\wedge
x_{m}  \notag \\
& +\left( \left. x_{l}\right\vert x_{m}\right) x_{i}\wedge x_{j}\wedge
x_{k}-\left( \left. x_{k}\right\vert x_{m}\right) x_{i}\wedge x_{j}\wedge
x_{l}+\left( \left. x_{j}\right\vert x_{m}\right) x_{i}\wedge x_{k}\wedge
x_{l}-\left( \left. x_{i}\right\vert x_{m}\right) x_{j}\wedge x_{k}\wedge
x_{l}  \notag \\
& +\left( \left. x_{i}\right\vert x_{j}\right) \left( \left.
x_{l}\right\vert x_{m}\right) x_{k}-\left( \left. x_{i}\right\vert
x_{j}\right) \left( \left. x_{k}\right\vert x_{m}\right) x_{l}  \notag \\
& -\left( \left. x_{i}\right\vert x_{k}\right) \left( \left.
x_{l}\right\vert x_{m}\right) x_{j}+\left( \left. x_{i}\right\vert
x_{k}\right) \left( \left. x_{j}\right\vert x_{m}\right) x_{l}  \notag \\
& -\left( \left. x_{i}\right\vert x_{l}\right) \left( \left.
x_{j}\right\vert x_{m}\right) x_{k}+\left( \left. x_{i}\right\vert
x_{l}\right) \left( \left. x_{k}\right\vert x_{m}\right) x_{j}  \notag \\
& +\left( \left. x_{j}\right\vert x_{k}\right) \left( \left.
x_{l}\right\vert x_{m}\right) x_{i}-\left( \left. x_{j}\right\vert
x_{k}\right) \left( \left. x_{i}\right\vert x_{m}\right) x_{l}  \notag \\
& -\left( \left. x_{j}\right\vert x_{l}\right) \left( \left.
x_{k}\right\vert x_{m}\right) x_{i}+\left( \left. x_{j}\right\vert
x_{l}\right) \left( \left. x_{k}\right\vert x_{m}\right) x_{k}  \notag \\
& +\left( \left. x_{k}\right\vert x_{l}\right) \left( \left.
x_{j}\right\vert x_{m}\right) x_{i}-\left( \left. x_{k}\right\vert
x_{l}\right) \left( \left. x_{i}\right\vert x_{m}\right) x_{j}  \notag \\
& +\left\{ \left( \left. x_{i}\right\vert x_{j}\right) \left( \left.
x_{k}\right\vert x_{l}\right) -\left( \left. x_{i}\right\vert x_{k}\right)
\left( \left. x_{j}\right\vert x_{l}\right) +\left( \left. x_{i}\right\vert
x_{l}\right) \left( \left. x_{j}\right\vert x_{k}\right) \right\} x_{m}.
\end{align}%
then%
\begin{align}
& x_{i}x_{j}x_{k}x_{l}x_{m}=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge
x_{m}  \notag \\
& +\left( \left. x_{i}\right\vert x_{j}\right) x_{k}\wedge x_{l}\wedge
x_{m}-\left( \left. x_{i}\right\vert x_{k}\right) x_{j}\wedge x_{l}\wedge
x_{m}+\left( \left. x_{i}\right\vert x_{l}\right) x_{j}\wedge x_{k}\wedge
x_{m}  \notag \\
& +\left( \left. x_{j}\right\vert x_{k}\right) x_{i}\wedge x_{l}\wedge
x_{m}-\left( \left. x_{j}\right\vert x_{l}\right) x_{i}\wedge x_{k}\wedge
x_{m}+\left( \left. x_{k}\right\vert x_{l}\right) x_{i}\wedge x_{j}\wedge
x_{m}  \notag \\
& +\left( \left. x_{l}\right\vert x_{m}\right) x_{i}\wedge x_{j}\wedge
x_{k}-\left( \left. x_{k}\right\vert x_{m}\right) x_{i}\wedge x_{j}\wedge
x_{l}+\left( \left. x_{j}\right\vert x_{m}\right) x_{i}\wedge x_{k}\wedge
x_{l}-\left( \left. x_{i}\right\vert x_{m}\right) x_{j}\wedge x_{k}\wedge
x_{l}  \notag \\
& +\left\{ \left( \left. x_{i}\right\vert x_{j}\right) \left( \left.
x_{l}\right\vert x_{m}\right) -\left( \left. x_{i}\right\vert x_{l}\right)
\left( \left. x_{j}\right\vert x_{m}\right) +\left( \left. x_{j}\right\vert
x_{l}\right) \left( \left. x_{k}\right\vert x_{m}\right) \right\} x_{k} 
\notag \\
& +\left\{ \left( \left. x_{i}\right\vert x_{k}\right) \left( \left.
x_{j}\right\vert x_{m}\right) -\left( \left. x_{j}\right\vert x_{k}\right)
\left( \left. x_{i}\right\vert x_{m}\right) -\left( \left. x_{i}\right\vert
x_{j}\right) \left( \left. x_{k}\right\vert x_{m}\right) \right\} x_{l} 
\notag \\
& +\left\{ \left( \left. x_{i}\right\vert x_{l}\right) \left( \left.
x_{k}\right\vert x_{m}\right) -\left( \left. x_{k}\right\vert x_{l}\right)
\left( \left. x_{i}\right\vert x_{m}\right) -\left( \left. x_{i}\right\vert
x_{k}\right) \left( \left. x_{l}\right\vert x_{m}\right) \right\} x_{j} 
\notag \\
& +\left\{ \left( \left. x_{j}\right\vert x_{k}\right) \left( \left.
x_{l}\right\vert x_{m}\right) -\left( \left. x_{j}\right\vert x_{l}\right)
\left( \left. x_{k}\right\vert x_{m}\right) +\left( \left. x_{k}\right\vert
x_{l}\right) \left( \left. x_{j}\right\vert x_{m}\right) \right\} x_{i} 
\notag \\
& +\left\{ \left( \left. x_{i}\right\vert x_{j}\right) \left( \left.
x_{k}\right\vert x_{l}\right) -\left( \left. x_{i}\right\vert x_{k}\right)
\left( \left. x_{j}\right\vert x_{l}\right) +\left( \left. x_{i}\right\vert
x_{l}\right) \left( \left. x_{j}\right\vert x_{k}\right) \right\} x_{m}.
\end{align}%
Thus%
\begin{align}
& x_{i}x_{j}x_{k}x_{l}x_{m}=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge
x_{m}  \notag \\
& +\Delta _{ij}x_{k}\wedge x_{l}\wedge x_{m}-\Delta _{ik}x_{j}\wedge
x_{l}\wedge x_{m}+\Delta _{il}x_{j}\wedge x_{k}\wedge x_{m}+\Delta
_{jk}x_{i}\wedge x_{l}\wedge x_{m}-\Delta _{jl}x_{i}\wedge x_{k}\wedge x_{m}
\notag \\
& +\Delta _{kl}x_{i}\wedge x_{j}\wedge x_{m}+\Delta _{lm}x_{i}\wedge
x_{j}\wedge x_{k}-\Delta _{km}x_{i}\wedge x_{j}\wedge x_{l}+\Delta
_{jm}x_{i}\wedge x_{k}\wedge x_{l}-\Delta _{im}x_{j}\wedge x_{k}\wedge x_{l}
\notag \\
& +\left\{ \Delta _{ij}\Delta _{lm}-\Delta _{il}\Delta _{jm}+\Delta
_{jl}\Delta _{km}\right\} x_{k}  \notag \\
& +\left\{ \Delta _{ik}\Delta _{jm}-\Delta _{jk}\Delta _{im}-\Delta
_{ij}\Delta _{km}\right\} x_{l}  \notag \\
& +\left\{ \Delta _{il}\Delta _{km}-\Delta _{kl}\Delta _{im}-\Delta
_{ik}\Delta _{lm}\right\} x_{j}  \notag \\
& +\left\{ \Delta _{lm}\Delta _{jk}-\Delta _{jl}\Delta _{km}+\Delta
_{kl}\Delta _{jm}\right\} x_{i}  \notag \\
& +\left\{ \Delta _{ij}\Delta _{kl}-\Delta _{ik}\Delta _{jl}+\Delta
_{il}\Delta _{jk}\right\} x_{m}.
\end{align}%
Hence the fifth order products are%
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}=x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{1}j_{2}}\right) x_{j_{3}}\wedge
x_{j_{4}}\wedge x_{j_{5}}-\limfunc{Pf}\left( \Delta _{j_{1}j_{3}}\right)
x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{5}}+\limfunc{Pf}\left( \Delta
_{j_{1}j_{4}}\right) x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{5}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{2}j_{3}}\right) x_{j_{1}}\wedge
x_{j_{4}}\wedge x_{j_{5}}-\limfunc{Pf}\left( \Delta _{j_{2}j_{4}}\right)
x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\limfunc{Pf}\left( \Delta
_{j_{3}j_{4}}\right) x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{5}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{4}j_{5}}\right) x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}-\limfunc{Pf}\left( \Delta _{j_{3}j_{5}}\right)
x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{4}}+\limfunc{Pf}\left( \Delta
_{j_{2}j_{5}}\right) x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}-\limfunc{Pf}%
\left( \Delta _{j_{1}j_{5}}\right) x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}
\notag \\
& +\limfunc{Pf}\left( \Delta _{j_{2}j_{3}j_{4}j_{5}}\right) x_{j_{1}}-%
\limfunc{Pf}\left( \Delta _{j_{1}j_{3}j_{4}j_{5}}\right) x_{j_{2}}+\limfunc{%
Pf}\left( \Delta _{j_{1}j_{2}j_{4}j_{5}}\right) x_{j_{3}}-\limfunc{Pf}\left(
\Delta _{j_{1}j_{2}j_{3}j_{5}}\right) x_{j_{4}}+\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}j_{4}}\right) x_{j_{5}},
\end{align}

\item[6] The sixth order products decompose as 
\begin{align}
& x_{i}x_{j}x_{k}x_{l}x_{m}x_{n}=\left\{ x_{i}\wedge x_{j}\wedge x_{k}\wedge
x_{l}\wedge x_{m}\wedge x_{n}\right.  \notag \\
& +\Delta _{ij}x_{k}\wedge x_{l}\wedge x_{m}-\Delta _{ik}x_{j}\wedge
x_{l}\wedge x_{m}+\Delta _{il}x_{j}\wedge x_{k}\wedge x_{m}+\Delta
_{jk}x_{i}\wedge x_{l}\wedge x_{m}-\Delta _{jl}x_{i}\wedge x_{k}\wedge x_{m}
\notag \\
& +\Delta _{kl}x_{i}\wedge x_{j}\wedge x_{m}+\Delta _{lm}x_{i}\wedge
x_{j}\wedge x_{k}-\Delta _{km}x_{i}\wedge x_{j}\wedge x_{l}+\Delta
_{jm}x_{i}\wedge x_{k}\wedge x_{l}-\Delta _{im}x_{j}\wedge x_{k}\wedge x_{l}
\notag \\
& +\left. \limfunc{Pf}\left( \Delta _{jklm}\right) x_{i}-\limfunc{Pf}\left(
\Delta _{iklm}\right) x_{j}+\limfunc{Pf}\left( \Delta _{ijlm}\right) x_{k}-%
\limfunc{Pf}\left( \Delta _{ijkm}\right) x_{l}+\limfunc{Pf}\left( \Delta
_{ijkl}\right) x_{m}\right\} x_{n}
\end{align}%
leading to 
\begin{align}
& x_{i}x_{j}x_{k}x_{l}x_{m}x_{n}=x_{i}\wedge x_{j}\wedge x_{k}\wedge
x_{l}\wedge x_{m}\wedge x_{n}  \notag \\
& +\Delta _{mn}x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}-\Delta _{\ln
}x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{m}+\Delta _{kn}x_{i}\wedge
x_{j}\wedge x_{l}\wedge x_{m}  \notag \\
& -\Delta _{jn}x_{i}\wedge x_{k}\wedge x_{l}\wedge x_{m}+\Delta
_{in}x_{j}\wedge x_{k}\wedge x_{l}\wedge x_{m}  \notag \\
& +\Delta _{ij}x_{k}\wedge x_{l}\wedge x_{m}\wedge x_{n}+\Delta _{ij}\Delta
_{mn}x_{k}\wedge x_{l}-\Delta _{ij}\Delta _{\ln }x_{k}\wedge x_{m}+\Delta
_{ij}\Delta _{kn}x_{l}\wedge x_{m}  \notag \\
& -\Delta _{ik}x_{j}\wedge x_{l}\wedge x_{m}\wedge x_{n}+\Delta _{ik}\Delta
_{mn}x_{j}\wedge x_{l}-\Delta _{ik}\Delta _{\ln }x_{j}\wedge x_{m}+\Delta
_{ik}\Delta _{jn}x_{l}\wedge x_{m}  \notag \\
& +\Delta _{il}x_{j}\wedge x_{k}\wedge x_{m}\wedge x_{n}-\Delta _{il}\Delta
_{mn}x_{j}\wedge x_{k}+\Delta _{il}\Delta _{kn}x_{j}\wedge x_{m}-\Delta
_{il}\Delta _{jn}x_{k}\wedge x_{m}  \notag \\
& +\Delta _{jk}x_{i}\wedge x_{l}\wedge x_{m}\wedge x_{n}-\Delta _{jk}\Delta
_{mn}x_{i}\wedge x_{l}+\Delta _{jk}\Delta _{\ln }x_{i}\wedge x_{m}-\Delta
_{jk}\Delta _{in}x_{l}\wedge x_{m}  \notag \\
& -\Delta _{jl}x_{i}\wedge x_{k}\wedge x_{m}\wedge x_{n}+\Delta _{jl}\Delta
_{mn}x_{i}\wedge x_{k}-\Delta _{jl}\Delta _{kn}x_{i}\wedge x_{m}+\Delta
_{jl}\Delta _{in}x_{k}\wedge x_{m}  \notag \\
& +\Delta _{kl}x_{i}\wedge x_{j}\wedge x_{m}\wedge x_{n}-\Delta _{kl}\Delta
_{mn}x_{i}\wedge x_{j}+\Delta _{kl}\Delta _{jn}x_{i}\wedge x_{m}-\Delta
_{kl}\Delta _{in}x_{j}\wedge x_{m}  \notag \\
& -\Delta _{im}x_{j}\wedge x_{k}\wedge x_{l}\wedge x_{n}-\Delta _{im}\Delta
_{\ln }x_{j}\wedge x_{k}+\Delta _{im}\Delta _{kn}x_{j}\wedge x_{l}-\Delta
_{im}\Delta _{jn}x_{k}\wedge x_{l}  \notag \\
& +\Delta _{lm}x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{n}-\Delta _{lm}\Delta
_{kn}x_{i}\wedge x_{j}+\Delta _{lm}\Delta _{jn}x_{i}\wedge x_{k}-\Delta
_{lm}\Delta _{in}x_{j}\wedge x_{k}  \notag \\
& -\Delta _{km}x_{i}\wedge x_{j}\wedge x_{l}\wedge x_{n}+\Delta _{km}\Delta
_{\ln }x_{i}\wedge x_{j}-\Delta _{km}\Delta _{jn}x_{i}\wedge x_{l}+\Delta
_{km}\Delta _{in}x_{j}\wedge x_{l}  \notag \\
& +\Delta _{jm}x_{i}\wedge x_{k}\wedge x_{l}\wedge x_{n}-\Delta _{jm}\Delta
_{\ln }x_{i}\wedge x_{k}+\Delta _{jm}\Delta _{kn}x_{i}\wedge x_{l}-\Delta
_{jm}\Delta _{in}x_{k}\wedge x_{l}  \notag \\
& +\Delta _{lm}\Delta _{kn}x_{i}\wedge x_{j}-\Delta _{lm}\Delta
_{jn}x_{i}\wedge x_{k}+\Delta _{lm}\Delta _{in}x_{j}\wedge x_{k}  \notag \\
& -\Delta _{km}\Delta _{\ln }x_{i}\wedge x_{j}+\Delta _{km}\Delta
_{jn}x_{i}\wedge x_{l}-\Delta _{km}\Delta _{in}x_{j}\wedge x_{l}  \notag \\
& +\Delta _{jm}\Delta _{\ln }x_{i}\wedge x_{k}-\Delta _{jm}\Delta
_{kn}x_{i}\wedge x_{l}+\Delta _{jm}\Delta _{in}x_{k}\wedge x_{l}  \notag \\
& -\Delta _{im}\Delta _{\ln }x_{j}\wedge x_{k}+\Delta _{im}\Delta
_{kn}x_{j}\wedge x_{l}-\Delta _{im}\Delta _{jn}x_{k}\wedge x_{l}  \notag \\
& +\limfunc{Pf}\left( \Delta _{jklm}\right) x_{i}\wedge x_{n}+\limfunc{Pf}%
\left( \Delta _{jklm}\right) \Delta _{in}-\limfunc{Pf}\left( \Delta
_{iklm}\right) x_{j}\wedge x_{n}  \notag \\
& -\limfunc{Pf}\left( \Delta _{iklm}\right) \Delta _{jn}+\limfunc{Pf}\left(
\Delta _{ijlm}\right) x_{k}\wedge x_{n}+\limfunc{Pf}\left( \Delta
_{ijlm}\right) \Delta _{kn}  \notag \\
& -\limfunc{Pf}\left( \Delta _{ijkm}\right) x_{l}\wedge x_{n}-\limfunc{Pf}%
\left( \Delta _{ijkm}\right) \Delta _{\ln }+\limfunc{Pf}\left( \Delta
_{ijkl}\right) x_{m}\wedge x_{n}+\limfunc{Pf}\left( \Delta _{ijkl}\right)
\Delta _{mn}
\end{align}%
\begin{align}
& x_{i}x_{j}x_{k}x_{l}x_{m}x_{n}=x_{i}\wedge x_{j}\wedge x_{k}\wedge
x_{l}\wedge x_{m}\wedge x_{n}  \notag \\
& +\Delta _{ij}x_{k}\wedge x_{l}\wedge x_{m}\wedge x_{n}-\Delta
_{ik}x_{j}\wedge x_{l}\wedge x_{m}\wedge x_{n}+\Delta _{il}x_{j}\wedge
x_{k}\wedge x_{m}\wedge x_{n}-\Delta _{im}x_{j}\wedge x_{k}\wedge
x_{l}\wedge x_{n}  \notag \\
& +\Delta _{in}x_{j}\wedge x_{k}\wedge x_{l}\wedge x_{m}  \notag \\
& +\Delta _{jk}x_{i}\wedge x_{l}\wedge x_{m}\wedge x_{n}-\Delta
_{jl}x_{i}\wedge x_{k}\wedge x_{m}\wedge x_{n}+\Delta _{jm}x_{i}\wedge
x_{k}\wedge x_{l}\wedge x_{n}-\Delta _{jn}x_{i}\wedge x_{k}\wedge
x_{l}\wedge x_{m}  \notag \\
& +\Delta _{kl}x_{i}\wedge x_{j}\wedge x_{m}\wedge x_{n}-\Delta
_{km}x_{i}\wedge x_{j}\wedge x_{l}\wedge x_{n}+\Delta _{kn}x_{i}\wedge
x_{j}\wedge x_{l}\wedge x_{m}  \notag \\
& +\Delta _{lm}x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{n}-\Delta _{\ln
}x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{m}+\Delta _{mn}x_{i}\wedge
x_{j}\wedge x_{k}\wedge x_{l}  \notag \\
& +\left\{ \Delta _{lm}\Delta _{kn}-\Delta _{lm}\Delta _{jn}-\Delta
_{km}\Delta _{\ln }\right\} x_{i}\wedge x_{j}+\left\{ \Delta _{jm}\Delta
_{\ln }-\Delta _{lm}\Delta _{jn}+\Delta _{jl}\Delta _{mn}\right\}
x_{i}\wedge x_{k}  \notag \\
& +\left\{ \Delta _{km}\Delta _{jn}-\Delta _{jm}\Delta _{kn}-\Delta
_{jk}\Delta _{mn}\right\} x_{i}\wedge x_{l}+\left\{ \Delta _{jk}\Delta _{\ln
}-\Delta _{jl}\Delta _{kn}+\Delta _{kl}\Delta _{jn}\right\} x_{i}\wedge x_{m}
\notag \\
& -\left\{ \Delta _{im}\Delta _{\ln }+\Delta _{lm}\Delta _{in}-\Delta
_{il}\Delta _{mn}\right\} x_{j}\wedge x_{k}-\left\{ \Delta _{km}\Delta
_{in}+\Delta _{im}\Delta _{kn}+\Delta _{ik}\Delta _{mn}\right\} x_{j}\wedge
x_{l}  \notag \\
& -\left\{ \Delta _{ik}\Delta _{\ln }+\Delta _{il}\Delta _{kn}-\Delta
_{kl}\Delta _{in}\right\} x_{j}\wedge x_{m}+\left\{ \Delta _{jm}\Delta
_{in}-\Delta _{im}\Delta _{jn}+\Delta _{ij}\Delta _{mn}\right\} x_{k}\wedge
x_{l}  \notag \\
& -\left\{ \Delta _{ij}\Delta _{\ln }+\Delta _{jl}\Delta _{in}-\Delta
_{il}\Delta _{jn}\right\} x_{k}\wedge x_{m}+\left\{ \Delta _{ij}\Delta
_{kn}-\Delta _{jk}\Delta _{in}+\Delta _{ik}\Delta _{jn}\right\} x_{l}\wedge
x_{m}  \notag \\
& +\limfunc{Pf}\left( \mathbf{\Delta }_{jklm}\right) x_{i}\wedge x_{n}-%
\limfunc{Pf}\left( \mathbf{\Delta }\right) _{iklm}x_{j}\wedge x_{n}-\limfunc{%
Pf}\left( \mathbf{\Delta }\right) _{ijkm}x_{l}\wedge x_{n}  \notag \\
& +\limfunc{Pf}\left( \mathbf{\Delta }\right) _{ijlm}x_{k}\wedge x_{n}+%
\limfunc{Pf}\left( \mathbf{\Delta }\right) _{ijkl}x_{m}\wedge x_{n}+\limfunc{%
Pf}\left( \mathbf{\Delta }\right) _{jklm}\Delta _{in}-\limfunc{Pf}\left( 
\mathbf{\Delta }\right) _{ijkm}\Delta _{\ln }  \notag \\
& -\limfunc{Pf}\left( \mathbf{\Delta }\right) _{iklm}\Delta _{jn}+\limfunc{Pf%
}\left( \mathbf{\Delta }\right) _{ijkl}\Delta _{mn}+\limfunc{Pf}\left( 
\mathbf{\Delta }\right) _{ijlm}\Delta _{kn}
\end{align}%
and finally 
\begin{align}
& x_{j_{1}}x_{j}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}=x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge x_{j_{6}} 
\notag \\
& +\Delta _{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge
x_{j_{6}}-\Delta _{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}+\Delta _{j_{1}j_{4}}x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{5}}\wedge x_{j_{6}}-\Delta
_{j_{1}j_{5}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{6}} 
\notag \\
& +\Delta _{j_{1}j_{6}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}+\Delta _{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}-\Delta _{j_{2}j_{4}}x_{j_{1}}\wedge
x_{j_{3}}\wedge x_{j_{5}}\wedge x_{j_{6}}+\Delta
_{j_{2}j_{5}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{6}} 
\notag \\
& -\Delta _{j_{2}j_{6}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}+\Delta _{j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{5}}\wedge x_{j_{6}}-\Delta _{j_{3}j_{5}}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{6}}+\Delta
_{j_{3}j_{6}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{5}} 
\notag \\
& +\Delta _{j_{4}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge
x_{j_{6}}-\Delta _{\ln }x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge
x_{j_{5}}+\Delta _{j_{5}j_{6}}x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{4}j_{5}j_{3}j_{6}}\right) x_{j_{1}}\wedge
x_{j_{2}}+\limfunc{Pf}\left( \Delta _{j_{2}j_{5}\ln }\right) x_{j_{1}}\wedge
x_{j_{3}}+\limfunc{Pf}\left( \Delta _{j_{3}j_{5}j_{2}j_{6}}\right)
x_{j_{1}}\wedge x_{j_{4}}+\limfunc{Pf}\left( \Delta _{j_{2}j_{3}\ln }\right)
x_{j_{1}}\wedge x_{j_{5}}-\limfunc{Pf}\left( \Delta _{j_{1}j_{5}\ln }\right)
x_{j_{2}}\wedge x_{j_{3}}  \notag \\
& -\limfunc{Pf}\left( \Delta _{j_{3}\min }\right) x_{j_{2}}\wedge x_{j_{4}}-%
\limfunc{Pf}\left( \Delta _{j_{1}j_{3}\ln }\right) x_{j_{2}}\wedge x_{j_{5}}+%
\limfunc{Pf}\left( \Delta _{j_{2}\min }\right) x_{j_{3}}\wedge x_{j_{4}}-%
\limfunc{Pf}\left( \Delta _{j_{1}j_{2}\ln }\right) x_{j_{3}}\wedge x_{j_{5}}+%
\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{6}}\right) x_{j_{4}}\wedge
x_{j_{5}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{2}j_{3}j_{4}j_{5}}\right) x_{j_{1}}\wedge
x_{j_{6}}-\limfunc{Pf}\left( \Delta _{j_{1}j_{3}j_{4}j_{5}}\right)
x_{j_{2}}\wedge x_{j_{6}}-\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}j_{5}}\right) x_{j_{4}}\wedge x_{j_{6}}+\limfunc{Pf}\left(
\Delta _{j_{1}j_{2}j_{4}j_{5}}\right) x_{j_{3}}\wedge x_{j_{6}}+\limfunc{Pf}%
\left( \Delta _{j_{1}j_{2}j_{3}j_{4}}\right) x_{j_{5}}\wedge x_{j_{6}} 
\notag \\
& +\left\{ \limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) -\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{4}j_{3}j_{5}j_{6}}\right) -\limfunc{Pf}\left( \Delta
_{j_{1}j_{3}j_{2}j_{4}j_{5}j_{6}}\right) +\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{5}j_{3}j_{4}j_{6}}\right) +\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{4}j_{5}j_{3}j_{6}}\right) \right\} I_{\mathcal{F}},
\end{align}%
where%
\begin{align}
& \limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) =%
\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}}\right) \Delta
_{j_{5}j_{6}}-\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{5}}\right)
\Delta _{j_{4}j_{6}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{4}j_{5}}\right) \Delta
_{j_{3}j_{6}}-\limfunc{Pf}\left( \Delta _{j_{1}j_{3}j_{4}j_{5}}\right)
\Delta _{j_{2}j_{6}}+\limfunc{Pf}\left( \Delta
_{j_{2}j_{3}j_{4}j_{5}}\right) \Delta _{j_{1}j_{6}}.
\end{align}
\end{enumerate}

In summary

2. The second degree products are given by%
\begin{equation*}
x_{i}x_{j}=x_{i}\wedge x_{j}+\Delta _{ij}I_{\mathcal{F}}.
\end{equation*}

3. The third degree products are given by

\begin{equation}
x_{j_{1}}x_{j_{2}}x_{j_{3}}=x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}+\Delta_{j_{2}j_{3}}x_{j_{1}}-\Delta_{j_{1}j_{3}}x_{j_{2}}+%
\Delta_{j_{1}j_{2}}x_{j_{3}}.
\end{equation}

4. The fourth degree products are given by 
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=  \notag \\
& x_{j_{1}}\wedge x_{j}\wedge x_{j_{3}}\wedge x_{j_{4}} \\
& +\Delta _{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}-\Delta
_{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}+\Delta _{j_{1}j_{4}}x_{j_{2}}\wedge
x_{j_{3}}+\Delta _{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}-\Delta
_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}+\Delta _{j_{3}j_{4}}x_{j_{1}}\wedge
x_{j_{2}}  \notag \\
& +\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right) I_{%
\mathcal{F}}.
\end{align}

5. The fifth degree products are given by%
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}=  \notag \\
& x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}
\\
& +\Delta _{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}-\Delta
_{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{5}}+\Delta
_{j_{1}j_{4}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\Delta
_{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}\wedge x_{j_{5}}  \notag \\
& -\Delta _{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\Delta
_{j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{5}}+\Delta
_{j_{4}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}-\Delta
_{j_{3}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{4}}  \notag \\
& +\Delta _{j_{2}j_{5}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}-\Delta
_{j_{1}j_{5}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\limfunc{Pf}\left( \mathbf{\Delta }_{j_{2}j_{3}j_{4}j_{5}}\right)
x_{j_{1}}-\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{3}j_{4}j_{5}}\right)
x_{j}+\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{4}j_{5}}\right)
x_{j_{3}}-\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{5}}\right)
x_{j_{4}}+\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}}\right)
x_{j_{5}},
\end{align}%
which can also be expressed as 
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}=  \notag \\
& x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}
\\
& +\sum_{\sigma \in DC_{2}^{5}}\pi \left( \sigma \right) \Delta _{j_{\sigma
\left( 1\right) }j_{\sigma \left( 2\right) }}x_{j_{\sigma \left( _{3}\right)
}}\wedge x_{j_{\sigma \left( _{4}\right) }}\wedge x_{j_{\sigma \left(
5\right) }}+\sum_{\sigma \in DC_{4}^{5}}\pi \left( \sigma \right) \limfunc{Pf%
}\left( \mathbf{\Delta }_{j_{\sigma \left( 1\right) }j_{\sigma \left(
_{2}\right) }j_{\sigma \left( _{3}\right) }j_{\sigma \left( _{4}\right)
}}\right) x_{j_{\sigma \left( 5\right) }}.
\end{align}

6. The sixth degree products are given by 
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}=x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge x_{j_{6}} 
\notag \\
& +\Delta _{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge
x_{j_{6}}-\Delta _{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}+\Delta _{j_{1}j_{4}}x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{5}}\wedge x_{j_{6}}  \notag \\
& -\Delta _{j_{1}j_{5}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{6}}+\Delta _{j_{1}j_{6}}x_{j_{2}}\wedge x_{j_{3}}\wedge
x_{j_{4}}\wedge x_{j_{5}}+\Delta _{j_{2}j_{3}}x_{j_{1}}\wedge
x_{j_{4}}\wedge x_{j_{5}}\wedge x_{j_{6}}  \notag \\
& -\Delta _{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{5}}\wedge
x_{j_{6}}+\Delta _{j_{2}j_{5}}x_{j_{1}}\wedge x_{j_{3}}\wedge
x_{j_{4}}\wedge x_{j_{6}}-\Delta _{j_{2}j_{6}}x_{j_{1}}\wedge
x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}  \notag \\
& +\Delta _{j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{5}}\wedge
x_{j_{6}}-\Delta _{j_{3}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{4}}\wedge x_{j_{6}}+\Delta _{j_{3}j_{6}}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{5}}  \notag \\
& +\Delta _{j_{4}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge
x_{j_{6}}-\Delta _{j_{4}j_{6}}x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{5}}+\Delta _{j_{5}j_{6}}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{4}j_{5}j_{3}j_{6}}\right) x_{j_{1}}\wedge
x_{j_{2}}+\limfunc{Pf}\left( \Delta _{j_{2}j_{5}j_{4}j_{6}}\right)
x_{j_{1}}\wedge x_{j_{3}}+\limfunc{Pf}\left( \Delta
_{j_{3}j_{5}j_{2}j_{6}}\right) x_{j_{1}}\wedge x_{j_{4}}+\limfunc{Pf}\left(
\Delta _{j_{2}j_{3}j_{4}j_{6}}\right) x_{j_{1}}\wedge x_{j_{5}}  \notag \\
& -\limfunc{Pf}\left( \Delta _{j_{1}j_{5}j_{4}j_{6}}\right) x_{j_{2}}\wedge
x_{j_{3}}-\limfunc{Pf}\left( \Delta _{j_{3}j_{5}j_{1}j_{6}}\right)
x_{j_{2}}\wedge x_{j_{4}}-\limfunc{Pf}\left( \Delta
_{j_{1}j_{3}j_{4}j_{6}}\right) x_{j_{2}}\wedge x_{j_{5}}+\limfunc{Pf}\left(
\Delta _{j_{2}j_{1}j_{6}}\right) x_{j_{3}}\wedge x_{j_{4}}  \notag \\
& -\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{4}j_{6}}\right) x_{j_{3}}\wedge
x_{j_{5}}+\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{6}}\right)
x_{j_{4}}\wedge x_{j_{5}}+\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}j_{4}}\right) x_{j_{5}}\wedge x_{j_{6}}+\limfunc{Pf}\left(
\Delta _{j_{2}j_{3}j_{4}j_{5}}\right) x_{j_{1}}\wedge x_{j_{6}}  \notag \\
& -\limfunc{Pf}\left( \Delta _{j_{1}j_{3}j_{4}j_{5}}\right) x_{j_{2}}\wedge
x_{j_{6}}-\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{5}}\right)
x_{j_{4}}\wedge x_{j_{6}}+\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{4}j_{5}}\right) x_{j_{3}}\wedge x_{j_{6}}  \notag \\
& +\limfunc{Pf}\left( \Delta _{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) I_{%
\mathcal{F}},
\end{align}%
which can also be expressed as 
\begin{align}
& x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}=  \notag \\
& +\sum_{\sigma \in DC_{2}^{6}}\pi \left( \sigma \right) \Delta _{j_{\sigma
\left( 1\right) }j_{\sigma \left( 2\right) }}x_{j_{\sigma \left( 3\right)
}}\wedge x_{j_{\sigma \left( 4\right) }}\wedge x_{j_{\sigma \left( 5\right)
}}\wedge x_{j_{\sigma \left( 6\right) }}  \notag \\
& +\sum_{\sigma \in DC_{4}^{6}}\pi \left( \sigma \right) \limfunc{Pf}\left( 
\mathbf{\Delta }_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right)
}j_{\sigma \left( 3\right) }j_{\sigma \left( 4\right) }}\right) x_{j_{\sigma
\left( 5\right) }}\wedge x_{j_{\sigma \left( 6\right) }} \\
& +\limfunc{Pf}\left( \mathbf{\Delta }_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}%
\right) I_{\mathcal{F}}.
\end{align}

7. The seventh degree products are given by 
\begin{align}
& x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}x_{j_{7}}=  \notag \\
& x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}\wedge x_{j_{7}} \\
& +\sum_{\sigma \in DC_{2}^{7}}\pi \left( \sigma \right) \Delta _{j_{\sigma
\left( 1\right) }j\sigma \left( _{2}\right) }x_{j_{\sigma \left( _{3}\right)
}}\wedge x_{j_{\sigma \left( _{4}\right) }}\wedge x_{j_{\sigma \left(
5\right) }}\wedge x_{j_{\sigma \left( _{6}\right) }}\wedge x_{j_{\sigma
\left( 7\right) }}  \notag \\
& +\sum_{\sigma \in DC_{4}^{7}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( _{2}\right) }j_{\sigma
\left( _{3}\right) }j_{\sigma \left( _{4}\right) }}\right) x_{j_{\sigma
\left( _{5}\right) }}\wedge x_{j_{\sigma \left( _{6}\right) }}\wedge
x_{j_{\sigma \left( 7\right) }}  \notag \\
& +\sum_{\sigma \in DC_{6}^{7}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }j_{\sigma \left( 5\right)
}j_{\sigma \left( 6\right) }}\right) x_{j_{\sigma \left( 7\right) }}
\end{align}

8. The eigth degree products are given by 
\begin{align}
& \qquad \qquad \qquad \qquad \left.
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}x_{j_{7}}x_{j_{8}}%
\right.  \notag \\
& \qquad \qquad \qquad \qquad \qquad \qquad \left. \parallel \right. \\
& x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}\wedge x_{j_{7}}\wedge x_{j_{8}} \\
& +\sum_{\sigma \in DC_{2}^{8}}\pi \left( \sigma \right) \Delta _{j_{\sigma
\left( 1\right) }j_{\sigma \left( 2\right) }}x_{j_{\sigma \left( 3\right)
}}\wedge x_{j_{\sigma \left( 4\right) }}\wedge x_{j_{\sigma \left( 5\right)
}}\wedge x_{j_{\sigma \left( 6\right) }}\wedge x_{j_{\sigma \left( 7\right)
}}\wedge x_{j_{\sigma \left( 8\right) }}  \notag \\
& +\sum_{\sigma \in DC_{4}^{8}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }}\right) x_{j_{\sigma \left(
5\right) }}\wedge x_{j_{\sigma \left( 6\right) }}\wedge x_{j_{\sigma \left(
7\right) }}\wedge x_{j_{\sigma \left( 8\right) }}  \notag \\
& +\sum_{\sigma \in DC_{6}^{8}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }j_{\sigma
\left( 3\right) }j_{\sigma \left( 4\right) }j_{\sigma \left( 5\right)
}j_{\sigma \left( 6\right) }}\right) x_{j_{\sigma \left( 7\right) }}\wedge
x_{j_{\sigma \left( 8\right) }} \\
& +\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}j_{7}j_{8}}\right) I_{\mathcal{F}}.
\end{align}

\begin{theorem}
\begin{equation}
x_{j_{1}}\cdots x_{j_{m}}=\sum_{0\leq p\leq m}\sum_{\sigma \in
DC_{p}^{m}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta _{j_{\sigma
\left( 1\right) }\cdots j_{\sigma \left( p\right) }}\right) x_{j_{\sigma
\left( p+1\right) }}\wedge \cdots \wedge x_{j_{\sigma \left( m\right) }}
\end{equation}
\end{theorem}

\begin{proof}
\begin{enumerate}
\item 
\end{enumerate}
\end{proof}

\begin{lemma}
\begin{proof}
\begin{enumerate}
\item odd term%
\begin{eqnarray}
&&m=3 \\
&&x_{j_{1}}x_{j_{2}}x_{j_{3}}=\sum_{0\leq p\leq 3}\sum_{\sigma \in
DC_{p}^{3}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta _{j_{\sigma
\left( 1\right) }\cdots j_{\sigma \left( p\right) }}\right) x_{j_{\sigma
\left( p+1\right) }}\wedge \cdots \wedge x_{j_{\sigma \left( 3\right) }} \\
&=&x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}+\sum_{\sigma \in DC_{1}^{3}}\pi
\left( \sigma \right) \limfunc{Pf}\left( \Delta _{j_{\sigma \left( 1\right)
}}\right) x_{j_{\sigma \left( 2\right) }}\wedge x_{j_{\sigma \left( 3\right)
}}+\sum_{\sigma \in DC_{2}^{3}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\right)
x_{j_{\sigma \left( 3\right) }}+\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}}\right) I_{\mathcal{F}} \\
&=&x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}+\sum_{\sigma \in DC_{2}^{3}}\pi
\left( \sigma \right) \limfunc{Pf}\left( \Delta _{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }}\right) x_{j_{\sigma \left( 3\right) }}
\end{eqnarray}

\item even term 
\begin{eqnarray}
&&m=4 \\
&&x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=\sum_{0\leq p\leq 4}\sum_{\sigma \in
DC_{p}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta _{j_{\sigma
\left( 1\right) }\cdots j_{\sigma \left( p\right) }}\right) x_{j_{\sigma
\left( p+1\right) }}\wedge \cdots \wedge x_{j_{\sigma \left( 3\right) }} \\
&=&x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}+\sum_{\sigma
\in DC_{1}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta
_{j_{\sigma \left( 1\right) }}\right) x_{j_{\sigma \left( 2\right) }}\wedge
x_{j_{\sigma \left( 3\right) }}\wedge x_{j_{\sigma \left( 4\right)
}}+\sum_{\sigma \in DC_{2}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\right)
x_{j_{\sigma \left( 3\right) }}\wedge x_{j_{\sigma \left( 4\right) }} \\
&&+\sum_{\sigma \in DC_{3}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }j_{\sigma
\left( 3\right) }}\right) x_{j_{\sigma \left( 4\right) }}+\sum_{\sigma \in
DC_{4}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}j_{4}}\right) I_{\mathcal{F}} \\
&=&x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}+\sum_{\sigma
\in DC_{2}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left( \Delta
_{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right) }}\right)
x_{j_{\sigma \left( 3\right) }}\wedge x_{j_{\sigma \left( 4\right)
}}+\sum_{\sigma \in DC_{4}^{4}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta _{j_{1}j_{2}j_{3}j_{4}}\right) I_{\mathcal{F}},
\end{eqnarray}%
where$\qquad \qquad \qquad \qquad $%
\begin{equation}
\limfunc{Pf}\left( 0\right) =1;\,\limfunc{Pf}\left( \Delta _{j_{\sigma
\left( 1\right) }}\right) =0;\,\limfunc{Pf}\left( \Delta
_{j_{1}j_{2}j_{3}}\right) =0.
\end{equation}
\end{enumerate}
\end{proof}
\end{lemma}

\subsubsection{Theorems on Expansion of Versors and Pffafians}

\begin{definition}
$\mathbb{N}_{q}^{p}$ :Sets of ordered natural numbers 
\begin{equation}
\mathbb{N}_{p}^{q}=\left\{ p,p+1,\cdots ,q\right\} ,\quad 1\leq p\leq q\in 
\mathbb{N}
\end{equation}
\end{definition}

\begin{definition}
$S_{n}:$ The set of permutations $\sigma $ of $n$ labels
\end{definition}

\begin{definition}
$S_{n}\left( N_{p}^{p+\kappa }\right) :$ The set of all permutations of the
labels $\left\{ \sigma \left( p\right) ,\cdots ,\sigma \left( p+\kappa
\right) \right\} \subset \left\{ \mathbb{N}_{p}^{p+\kappa }\right\} $ of the
labels $\left\{ p,\cdots ,p+\kappa \right\} \subset \left\{ \mathbb{N}%
_{p}^{p+\kappa }\right\} $ of natural numbers.
\end{definition}

\begin{definition}
$C_{k}^{n}:$ The set of permutations $\sigma $ producing ordered
combinations of $k$ elements from an ordered set of $n$ elements $\mathbb{N}%
_{q}^{q+n}$
\end{definition}

\begin{definition}
$C_{k}^{n}\left( \mathbb{N}_{q}^{p}\right) :$ Sets of ordered combinations
of $k$ elements from an ordered set of $n$ elements $\mathbb{N}_{q}^{q+n}$ 
\begin{equation}
C_{k}^{n}\left( \mathbb{N}_{q}^{p}\right) =\left\{ \left. \left\{
n_{q}<\cdots <n_{p}\right\} \right\vert \left\{ n_{q},\cdots ,n_{p}\right\}
\subset N_{q}^{p}\right\} .
\end{equation}
\end{definition}

\begin{lemma}
Exterior Product Expansion $\equiv $ Expansion of Versors in terms of Blades%
\begin{equation}
a_{j_{1}}\wedge \cdots \wedge a_{j_{n}}=\sum_{1\leq k_{1}<\cdots <k_{n}\leq
2r}x_{k_{1}}\wedge \cdots \wedge x_{k_{n}}\det \left\{ A\left( \left\{
k_{1},\cdots ,k_{n}\right\} ,\left\{ j_{1},\cdots ,j_{n}\right\} \right)
\right\} .
\end{equation}
\end{lemma}

\begin{lemma}
Geminal Power Expansion$\,\equiv $ Expansion of bivector powers in terms of
Blades%
\begin{eqnarray}
g^{n} &=&\,\overset{n}{\overbrace{g\wedge \cdots \wedge g}}\,=\sum_{1\leq
k_{1}<\cdots <k_{2n}\leq 2r}x_{k_{1}}\wedge \cdots \wedge x_{k_{2n}}\func{Pf}%
\left\{ \mathcal{R}_{x}\left( \Omega \left( g\right) \right) \left(
k_{1},\cdots ,k_{2n}\right) \right\} \\
&=&\sum_{\sigma \in C_{2n}^{2r}}x_{\sigma \left( 1\right) }\wedge \cdots
\wedge x_{\sigma \left( 2n\right) }\func{Pf}\left\{ \mathcal{R}_{x}\left(
\Omega \left( g\right) \right) \left( \sigma \left( 1\right) ,\cdots ,\sigma
\left( 2n\right) \right) \right\} .
\end{eqnarray}
\end{lemma}

\subsection{Wilmott Expansion}

In general one has the following theorem that relates the geometric
(Clifford) and exterior products

\begin{theorem}
{\Large Grassmann-Clifford Algebra Equivalence (G.P.Wilmot, J. Math. Phys.
29,2338-2345 (1988))\label{Grassmann-Clifford Algebra Equivalence Wilmot}} 
\begin{equation}
{\LARGE a}_{j_{1}}{\LARGE \cdots a}_{j_{n}}\,\quad {\LARGE =}%
\dprod\limits_{0\leq q\leq n}{\LARGE a}_{j_{q}}\,\quad {\LARGE =}%
\dsum\limits_{0\leq p\leq n}\dsum\limits_{\sigma \in DC_{p}^{n}}\pi \left(
\sigma \right) {\LARGE a}_{j_{\sigma \left( p+1\right) }}{\LARGE \wedge
\cdots \wedge a}_{j_{\sigma \left( n\right) }}\limfunc{Pf}\left( \mathbf{%
\Delta }\left( A\right) _{j_{\sigma \left( 1\right) }\cdots j_{\sigma \left(
p\right) }}\right) ,
\end{equation}%
where

\begin{enumerate}
\item 
\begin{equation}
\mathbf{\Delta }_{pq}\left( A\right) =\left( \left. a_{p}\right\vert
a_{q}\right) =\left\langle a_{p}a_{q}\right\rangle _{0},
\end{equation}

\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
\mathbf{a}_{j_{1}} & \cdots & \mathbf{a}_{j_{n}}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
a_{1j_{1}} & \cdots & a_{1j_{n}} \\ 
\vdots & \vdots & \vdots \\ 
a_{2rj_{1}} & \cdots & a_{2rj_{n}}%
\end{array}%
\right) ,
\end{equation}

\item 
\begin{equation}
k=0\Longrightarrow a_{j_{\sigma \left( 1\right) }}\wedge \cdots \wedge
a_{j_{\sigma \left( 0\right) }}=I_{\mathcal{F}}.
\end{equation}

\item 
\begin{eqnarray}
\limfunc{Pf}\left( 0\right) &=&1; \\
\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{j_{\sigma \left(
1\right) }\cdots j_{\sigma \left( 2p+1\right) }}\right) &=&0,1\leq p\leq %
\left[ \frac{n}{2}\right]
\end{eqnarray}
\end{enumerate}
\end{theorem}

\begin{remark}
The subscripts $\left\{ j_{1},\cdots ,j_{n}\right\} $ may not be distinct.
\end{remark}

\begin{remark}
$n$ is the rank of the \emph{versor} $A$ whose expansion contains \emph{%
blades} of rank $0\leq k<n.$
\end{remark}

\begin{remark}
$2^{2r}$ is the dimension of the Clifford algebra $\mathcal{F}.$
\end{remark}

\begin{example}
\bigskip The third rank \emph{versor} ${\normalsize a}_{1}{\normalsize a}_{2}%
{\normalsize a}_{3}$ can be expanded in terms of \emph{exterior} products as 
\begin{eqnarray}
{\normalsize a}_{1}{\normalsize a}_{2}{\normalsize a}_{3}{\normalsize \,\,} &%
{\normalsize =}&\dprod\limits_{0\leq j\leq 3}{\normalsize a}_{_{j}}%
{\normalsize \,\,=}\sum_{0\leq p\leq 3}\sum_{\sigma \in DC_{p}^{3}}%
{\normalsize \pi }\left( \sigma \right) {\normalsize a}_{\sigma \left(
p+1\right) }{\normalsize \wedge \cdots \wedge a}_{\sigma \left( 3\right) }%
\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{\sigma \left( 1\right)
\sigma \left( 2\right) },\cdots ,\mathbf{\Delta }\left( A\right) _{\sigma
\left( p-1\right) \sigma \left( p\right) }\right) \\
&=&\sum_{\sigma \in DC_{0}^{3}}{\normalsize \pi }\left( \sigma \right) 
{\normalsize a}_{\sigma \left( 1\right) }{\normalsize \wedge a_{\sigma
\left( 2\right) }\wedge a_{\sigma \left( 3\right) }}+\sum_{\sigma \in
DC_{2}^{3}}{\normalsize \pi }\left( \sigma \right) {\normalsize a}_{\sigma
\left( 3\right) }\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{\sigma
\left( 1\right) \sigma \left( 2\right) }\right) \\
&=&{\normalsize a}_{1}{\normalsize \wedge a}_{2}{\normalsize \wedge a}_{3}%
{\normalsize \,+}\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right)
_{12}\right) {\normalsize a}_{3}-\limfunc{Pf}\left( \mathbf{\Delta }\left(
A\right) _{13}\right) {\normalsize a}_{2}+\limfunc{Pf}\left( \mathbf{\Delta }%
\left( A\right) _{23}\right) {\normalsize a}_{1}.
\end{eqnarray}
\end{example}

\begin{example}
The fourth rank \emph{versor} ${\normalsize a}_{1}{\normalsize a}_{2}%
{\normalsize a}_{3}{\normalsize a}_{4}$ can be expanded in terms of \emph{%
exterior} products as%
\begin{gather}
{\normalsize a}_{1}{\normalsize a}_{2}{\normalsize a}_{3}{\normalsize a}_{4}%
{\normalsize \,\,}{\normalsize =}\dprod\limits_{0\leq j\leq 4}{\normalsize a}%
_{_{j}}{\normalsize \,\,=}\sum_{0\leq k\leq 2}\sum_{\sigma \in DC_{k}^{4}}%
{\normalsize \pi }\left( \sigma \right) {\normalsize a}_{\sigma \left(
k+1\right) }{\normalsize \wedge \cdots \wedge a}_{\sigma \left( \kappa
\right) }\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{\sigma \left(
1\right) \sigma \left( 2\right) },\cdots ,\mathbf{\Delta }\left( A\right)
_{\sigma \left( k-1\right) \sigma \left( k\right) }\right) \\
=\sum_{\sigma \in DC_{0}^{4}}{\normalsize \pi }\left( \sigma \right) 
{\normalsize a}_{\sigma \left( 1\right) }{\normalsize \wedge a_{\sigma
\left( 2\right) }\wedge a_{\sigma \left( 3\right) }\wedge a_{\sigma \left(
4\right) }} \\
+\Delta \left( A\right) _{12}a_{3}\wedge a_{4}-\Delta \left( A\right)
_{13}a_{2}\wedge a_{4}+\Delta \left( A\right) _{14}a_{2}\wedge a_{3}+\Delta
\left( A\right) _{23}a_{1}\wedge a_{4}-\Delta \left( A\right)
_{24}a_{1}\wedge a_{3}+\Delta \left( A\right) _{34}a_{1}\wedge a_{2} \\
+\sum_{\sigma \in DC_{4}^{4}}{\normalsize \pi }\left( \sigma \right) 
\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{\sigma \left( 1\right)
\sigma \left( 2\right) },\mathbf{\Delta }\left( A\right) _{\sigma \left(
3\right) \sigma \left( 4\right) }\right) I_{\mathcal{F}}
\end{gather}%
\begin{gather}
\parallel \\
{\normalsize a}_{1}{\normalsize \wedge a}_{2}{\normalsize \wedge a}_{3}%
{\normalsize \,\wedge a_{4}} \\
{\normalsize +} \\
\Delta \left( A\right) _{12}a_{3}\wedge a_{4}-\Delta \left( A\right)
_{13}a_{2}\wedge a_{4}+\Delta \left( A\right) _{14}a_{2}\wedge a_{3}+\Delta
\left( A\right) _{23}a_{1}\wedge a_{4}-\Delta \left( A\right)
_{24}a_{1}\wedge a_{3}+\Delta \left( A\right) _{34}a_{1}\wedge a_{2}+%
\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{12},\mathbf{\Delta }%
\left( A\right) _{34}\right) I_{\mathcal{F}}.
\end{gather}
\end{example}

\begin{example}
The eigth rank \emph{versor} $%
a_{j_{1}}a_{j_{2}}a_{j_{3}}a_{j_{4}}a_{j_{5}}a_{j_{6}}a_{j_{7}}a_{j_{8}}$
can be expanded in terms of \emph{exterior} products as%
\begin{gather}
a_{j_{1}}a_{j_{2}}a_{j_{3}}a_{j_{4}}a_{j_{5}}a_{j_{6}}a_{j_{7}}a_{j_{8}} 
\notag \\
\parallel \\
\qquad a_{j_{1}}\wedge a_{j_{2}}\wedge a_{j_{3}}\wedge a_{j_{4}}\wedge
a_{j_{5}}\wedge a_{j_{6}}\wedge a_{j_{7}}\wedge a_{j_{8}} \\
+ \\
+\sum_{\sigma \in DC_{6}^{8}}\pi \left( \sigma \right) \Delta \left(
A\right) _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right)
}}a_{j_{\sigma \left( 3\right) }}\wedge a_{j_{\sigma \left( 4\right)
}}\wedge a_{j_{\sigma \left( 5\right) }}\wedge a_{j_{\sigma \left( 6\right)
}}\wedge a_{j_{\sigma \left( 7\right) }}\wedge a_{j_{\sigma \left( 8\right)
}}  \notag \\
+\sum_{\sigma \in DC_{4}^{8}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta \left( A\right) _{j_{\sigma \left( 1\right) }j_{\sigma \left(
2\right) }j_{\sigma \left( 3\right) }j_{\sigma \left( 4\right) }}\right)
a_{j_{\sigma \left( 5\right) }}\wedge a_{j_{\sigma \left( 6\right) }}\wedge
a_{j_{\sigma \left( 7\right) }}\wedge a_{j_{\sigma \left( 8\right) }}  \notag
\\
+\sum_{\sigma \in DC_{2}^{8}}\pi \left( \sigma \right) \limfunc{Pf}\left(
\Delta \left( A\right) _{j_{\sigma \left( 1\right) }j_{\sigma \left(
2\right) }j_{\sigma \left( 3\right) }j_{\sigma \left( 4\right) }j_{\sigma
\left( 5\right) }j_{\sigma \left( 6\right) }}\right) a_{j_{\sigma \left(
7\right) }}\wedge a_{j_{\sigma \left( 8\right) }} \\
+\limfunc{Pf}\left( \Delta \left( A\right)
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}j_{7}j_{8}}\right) I_{\mathcal{F}},
\end{gather}%
compared to 
\begin{equation}
{\normalsize a}_{j_{1}}{\normalsize \cdots a}_{j_{8}}{\normalsize \,=}%
\dprod\limits_{0\leq q\leq 8}{\normalsize a}_{j_{q}}{\normalsize \,\quad =}%
\dsum\limits_{0\leq k\leq 8}\dsum\limits_{\sigma \in DC_{k}^{8}}{\normalsize %
\pi }\left( \sigma \right) \limfunc{Pf}\left( \mathbf{\Delta }\left(
A\right) _{j_{\sigma \left( 1\right) }\cdots j_{\sigma \left( k\right)
}}\right) {\normalsize a}_{j_{\sigma \left( 1\right) }}{\normalsize \wedge
\cdots \wedge a}_{j_{\sigma \left( \kappa \right) }}.
\end{equation}
\end{example}

\begin{remark}
\begin{equation}
{\normalsize a}_{j_{1}}{\normalsize \cdots a}_{j_{8}}{\normalsize \,}%
=\left\langle {\normalsize a}_{j_{1}}{\normalsize \cdots a}%
_{j_{8}}\right\rangle _{8}+\left\langle {\normalsize a}_{j_{1}}{\normalsize %
\cdots a}_{j_{8}}\right\rangle _{8}+\left\langle {\normalsize a}_{j_{1}}%
{\normalsize \cdots a}_{j_{8}}\right\rangle _{6}+\left\langle {\normalsize a}%
_{j_{1}}{\normalsize \cdots a}_{j_{8}}\right\rangle _{4}+\left\langle 
{\normalsize a}_{j_{1}}{\normalsize \cdots a}_{j_{8}}\right\rangle
_{2}+\left\langle {\normalsize a}_{j_{1}}{\normalsize \cdots a}%
_{j_{8}}\right\rangle _{0}
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{\sigma \left( 1\right)
\sigma \left( 2\right) \cdots \sigma \left( k-1\right) \sigma \left(
k\right) }\right) =\left\{ 
\begin{array}{c}
\limfunc{Pf}\left( \mathbf{\Delta }\left( A\right) _{\sigma \left( 1\right)
\sigma \left( 2\right) },\cdots ,\mathbf{\Delta }\left( A\right) _{\sigma
\left( k-1\right) \sigma \left( k\right) }\right) ,\quad k=2m \\ 
0,\quad k=2m+1%
\end{array}%
\right.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation*}
\func{Pf}\left( \mathbf{\Delta }\left( A\right) :\sigma \left( 1\right)
,\sigma \left( 2\right) ,\cdots ,\sigma \left( k-1\right) ,\sigma \left(
k\right) \right) =\func{Pf}\left\{ \mathbf{\Delta }\left( A\right) \left(
\sigma \left( 1\right) \sigma \left( 2\right) \cdots \sigma \left(
k-1\right) \sigma \left( k\right) \right) \right\} ,
\end{equation*}%
where 
\begin{equation}
\mathbf{\Delta }\left( A\right) \left( \sigma \left( 1\right) \sigma \left(
2\right) \cdots \sigma \left( k-1\right) \sigma \left( k\right) \right)
\end{equation}%
is the $k\times k$ block submatrix $\mathbf{\Delta }\left( A\right) \left(
\sigma \left( 1\right) \sigma \left( 2\right) \cdots \sigma \left(
k-1\right) \sigma \left( k\right) \right) $ of the $2r\times 2r$ matrix $%
\mathbf{\Delta }\left( A\right) $ formed by $\left\{ \sigma \left( 1\right)
,\sigma \left( 2\right) ,\cdots ,\sigma \left( k-1\right) ,\sigma \left(
k\right) \right\} $ rows and columns of $\mathbf{\Delta }\left( A\right) $
\end{remark}

\begin{theorem}
{\Large Expansion of Pfaffians} $\left( \text{{\Large G.P.Wilmot,
J.Math.Phys.29,2346(1988)}}\right) \label{Expansion of Pfaffians Wilmot}$%
\begin{gather}
\limfunc{Pf}\left( \overset{}{\left( \left. a_{1}\right\vert a_{2}\right)
,\cdots ,\left( \left. a_{2k-1}\right\vert a_{2k}\right) }\right)
=\sum_{l=0}^{\min \left( \left[ \frac{\kappa }{2}\right] ,\left[ k-\frac{%
\kappa }{2}\right] \right) }\left( -1\right) ^{l}\sum_{\mu \in
C_{2m}^{\kappa }}\sum_{v\in C_{2n}^{2k-\kappa }}\pi \left( \mu \right) \pi
\left( v\right) \func{Pf}\left( \overset{}{\left( \left. a_{\mu \left(
1\right) }\right\vert a_{\mu \left( 2\right) }\right) ,\cdots ,\left( \left.
a_{\mu \left( 2m-1\right) }\right\vert a_{\mu \left( 2m\right) }\right) }%
\right) \\
\times \func{Pf}\left( \overset{}{\left( \left. a_{\nu \left( 1\right)
}\right\vert a_{\nu \left( 2\right) }\right) ,\cdots ,\left( \left. a_{\nu
\left( 2n-1\right) }\right\vert a_{\nu \left( 2n\right) }\right) }\right)
\det \left( \overset{}{\left( \left. a_{\mu \left( 2m+1\right) }\right\vert
a_{\nu \left( 2n+1\right) }\right) ,\cdots ,\left( \left. a_{\mu \left(
\kappa \right) }\right\vert a_{\nu \left( \kappa \right) }\right) }\right) ,
\end{gather}%
where

\begin{notation}
\begin{enumerate}
\item 
\begin{equation}
k\in \left\{ 1,\cdots ,\left[ \frac{\kappa }{2}\right] \right\}
\end{equation}

\item 
\begin{equation}
\mu \in C_{2m}^{k};\quad \nu \in C_{2n}^{\kappa -2k}.
\end{equation}

\item 
\begin{equation}
\mu ,\nu :\mathbb{N}_{1}^{2k}\rightarrow \mathbb{N}_{1}^{2k}.
\end{equation}

\item 
\begin{equation}
\left. \mu \right\vert _{\mathbb{N}_{1}^{\kappa }}:\mathbb{N}_{1}^{\kappa
}\rightarrow \mathbb{N}_{1}^{\kappa },\quad \left. \mu \right\vert _{\mathbb{%
N}_{\kappa +1}^{2k}}=id,\quad \mu \left( \mathbb{N}_{1}^{\kappa }\right)
=\left. \mu \right\vert _{\mathbb{N}_{1}^{\kappa }}\in C_{2m}^{\kappa
}\left( \mathbb{N}_{1}^{\kappa }\right) .
\end{equation}

\item 
\begin{equation}
\left. \nu \right\vert _{\mathbb{N}_{\kappa +1}^{2k}}:\mathbb{N}_{\kappa
+1}^{2k}\rightarrow \mathbb{N}_{\kappa +1}^{2k},\quad \left. \nu \right\vert
_{\mathbb{N}_{1}^{\kappa }}=id,\quad \nu \left( \mathbb{N}_{\kappa
+1}^{2k}\right) =\left. \nu \right\vert _{\mathbb{N}_{\kappa +1}^{2k}}\in
C_{2n}^{2k-\kappa }\left( \mathbb{N}_{\kappa +1}^{2k}\right) .
\end{equation}

\item 
\begin{equation}
m\left( l\right) =\left( \left[ \frac{\kappa }{2}-l\right] \right) ,\quad
n\left( l\right) =\left( \left[ \frac{k-\kappa }{2}-l\right] \right) .
\end{equation}
\end{enumerate}
\end{notation}
\end{theorem}

\begin{example}
