}\right)  \\
+i\left( \overset{}{%
x_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}}+x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}+r}-x_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}-x_{j_{1}+r}x_{j_{2}}x_{j_{4}}x_{j_{3}}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}%
}\right) 
