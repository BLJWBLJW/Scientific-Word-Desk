1278,1378,1478,2378,2478,3478, & 3456,2456,2356,1456,1356,1256%
\end{array}%
\end{equation}%
\begin{equation}
J\left( j,k\right) =2r\left( j-1\right) -j\left( j+1\right) /2+k;1\leq
j<k\leq2r.
\end{equation}%
\begin{equation}
J\left( 5,6\right) =8\left( 5-1\right) -5\left( 5+1\right) /2+6=32-15+6=23
\end{equation}%
\begin{equation}
J\left( 3,4\right) =8\left( 3-1\right) -3\left( 3+1\right) /2+4=16-6+4=14
\end{equation}%
\begin{equation}
J\left( 7,8\right) =8\left( 7-1\right) -7\left( 7+1\right) /2+8=54-28+8=34
\end{equation}
