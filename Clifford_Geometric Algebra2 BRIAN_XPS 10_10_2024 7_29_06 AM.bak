\eta _{224} \\ 
\eta _{234}%
\end{array}%
\right) \ 
\end{equation}
\end{remark}

\section{\protect\appendix{}Jordan Idempotency}

\begin{remark}
The Jordan square of a triple sum has the form$\,$%
\begin{equation}
\left( a+b+ic\right) \ast \left( a+b+ic\right) =a^{2\ast }+b^{2\ast
}-c^{2\ast }+2a\ast b+2ia\ast c+2ib\ast c
\end{equation}
\end{remark}

\begin{example}
