\item $2-$substitions:%
\begin{equation}
\binom{4}{2}^{2}=36
\end{equation}%
\begin{equation}
\begin{array}{cc}
1256,1356,1456,2356,2456,3456, & 3478,2478,2378,1478,1378,1278 \\ 
1257,1357,1457,2357,2457,3457, & 3468,2468,2368,1468,1368,1268 \\ 
1258,1358,1458,2358,2458,3458, & 3467,2467,2367,1467,1367,1267 \\ 
1267,1367,1467,2367,2467,3467, & 3458,2458,2358,1458,1358,1258 \\ 
