\\
&=&-ix_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{31}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}
