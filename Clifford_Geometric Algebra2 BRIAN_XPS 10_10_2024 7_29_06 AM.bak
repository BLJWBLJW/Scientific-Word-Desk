\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & -\func{Im}\left( \mathbb{U+V}\right)
\\ 
\func{Im}\left( \mathbb{U-V}\right) & \func{Re}\left( \mathbb{U-V}\right)%
\end{array}
\right) \left( 
\begin{array}{c}
\mathbf{x}_{1} \\ 
\mathbf{x}_{2}%
