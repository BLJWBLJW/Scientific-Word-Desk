_{11}\widetilde{x}_{1}+\eta _{12}\widetilde{x}_{2}+\eta _{13}\widetilde{x}%
_{3}+\eta _{14}\widetilde{x}_{4} \\
&\Downarrow & \\
\eta _{0} &=&\frac{1}{2}
\end{eqnarray}%
and%
\begin{gather}
-\eta _{212}\eta _{12}-\eta _{213}\eta _{13}-\eta _{214}\eta _{14}=0 \\
+\eta _{212}\eta _{11}-\eta _{223}\eta _{13}-\eta _{224}\eta _{14}=0 \\
+\eta _{213}\eta _{11}+\eta _{223}\eta _{12}-\eta _{234}\eta _{14}=0 \\
+\eta _{214}\eta _{11}+\eta _{224}\eta _{12}+\eta _{234}\eta _{13}=0
