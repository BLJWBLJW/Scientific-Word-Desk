_{1j_{1}}X_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq 4}\eta
_{2j_{1}j_{2}}X_{j_{1}j_{2}} \\
\parallel \\
\,\overset{a}{\overbrace{\eta _{0}I_{\mathcal{H}_{\mathcal{F}}}}}+\overset{b}%
{\overbrace{\eta _{11}\widetilde{x}_{1}+\eta _{12}\widetilde{x}_{2}+\eta
