\begin{equation}
P_{2}=\left( I_{\mathcal{H}_{\mathcal{F}%
}},x_{1},x_{2},x_{3},x_{4},ix_{1}x_{2},ix_{1}x_{3},ix_{1}x_{4},ix_{2}x_{3},ix_{2}x_{4},ix_{3}x_{4}\right) \left( 
\begin{array}{c}
\eta _{0} \\ 
\eta _{11} \\ 
