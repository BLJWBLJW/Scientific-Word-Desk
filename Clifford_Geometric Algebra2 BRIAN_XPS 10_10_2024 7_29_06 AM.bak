\begin{theorem}
\begin{equation}
X_{j_{1}\cdots j_{m}}\ast X_{k_{1}\cdots k_{n}}=
\end{equation}
\end{theorem}

\begin{proof}
\begin{equation}
X_{j_{1}\cdots j_{n}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{4}%
}x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{n}};\,0\leq n\leq 2r,1\leq j_{1}<\cdots <j_{n}\leq 2r
\end{equation}%
\begin{equation}
X_{j_{1}\cdots j_{m}}\ast X_{k_{1}\cdots k_{n}}=\frac{1}{2}\left( i^{\frac{%
m\left( m-1\right) }{2}}x_{j_{1}}\cdots x_{j_{m}}i^{\frac{n\left( n-1\right) 
}{2}}x_{k_{1}}\cdots x_{k_{n}}+i^{\frac{n\left( n-1\right) }{2}%
}x_{k_{1}}\cdots x_{k_{n}}i^{\frac{m\left( m-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{m}}\right) =\frac{i^{\left( \frac{m\left( m-1\right) }{2}+\frac{%
n\left( n-1\right) }{2}\right) }}{2}\left( x_{j_{1}}\cdots
x_{j_{m}}x_{k_{1}}\cdots x_{k_{n}}+x_{k_{1}}\cdots x_{k_{n}}x_{j_{1}}\cdots
x_{j_{m}}\right)
\end{equation}%
\begin{equation}
\frac{1}{2}\left( m\left( m+1\right) +n\left( n+1\right) \right) =\frac{1}{2}%
\left( m^{2}+m+n^{2}+n\right) =\frac{1}{2}\left( m^{2}+n^{2}+m+n\right) =%
\frac{1}{2}\left( \left( m+n\right) ^{2}-2mn+m+n\right) =\frac{1}{2}\left(
\left( m+n\right) \left( \left( m+n\right) +1\right) -2mn\right)
\end{equation}
\end{proof}

\begin{remark}
Any element, $X,$ of $\mathfrak{h}_{\mathcal{A}}\left( \mathbb{R}\right) $
can be expanded as 
\begin{equation}
A=\sum_{0\leq n\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}X_{j_{1}\cdots
j_{n}}\mathcal{R}_{X}\left( A\right) _{j_{1}\cdots j_{n}};\quad \,\mathcal{R}%
_{X}\left( A\right) _{j_{1}\cdots j_{n}}\in \mathbb{R}.
\end{equation}
\end{remark}

\begin{remark}
Let $P_{a}$ and $P_{b}$ be orthogonal projectors belonging to $\mathcal{A}$
i.e. 
\begin{eqnarray}
P_{a} &=&P_{a}^{2}=P_{a}^{\dagger } \\
P_{b} &=&P_{b}^{2}=P_{b}^{\dagger }.
\end{eqnarray}%
The Jordan product of two orthogonal projectors (not necessarily to each
other) 
\begin{equation}
P_{a}\ast P_{b}=\frac{1}{2}\left( P_{a}P_{b}+P_{b}P_{a}\right)
\end{equation}%
is in general no longer Clifford idempotent 
\begin{align}
\left( \frac{1}{2}\left( P_{a}P_{b}+P_{b}P_{a}\right) \right) ^{2}& =\frac{1%
}{4}\left( P_{a}P_{b}+P_{b}P_{a}\right) \left( P_{a}P_{b}+P_{b}P_{a}\right) =%
\frac{1}{4}\left(
P_{a}P_{b}P_{a}P_{b}+P_{b}P_{a}P_{a}P_{b}+P_{a}P_{b}P_{b}P_{a}+P_{b}P_{a}P_{b}P_{a}\right)
\\
& \neq \frac{1}{4}\left( P_{a}P_{b}+P_{b}P_{a}\right)
\end{align}%
but is self adjoint i.e 
\begin{equation}
\left( P_{a}\ast P_{b}\right) ^{\dagger }=P_{a}\ast P_{b}.
\end{equation}%
.
\end{remark}

\begin{remark}
Orthogonal projectors are Jordan idempotent i.e. $\,$if $P_{a}=P_{b}$ then 
\begin{equation}
P_{a}\ast P_{a}=\frac{1}{4}\left(
P_{a}P_{a}P_{a}P_{a}+P_{a}P_{a}P_{a}P_{a}+P_{a}P_{a}P_{a}P_{a}+P_{a}P_{a}P_{a}P_{a}\right) =P_{a}.
\end{equation}
\end{remark}

\begin{remark}
The vector space $\mathcal{A}_{sa}$ is \emph{ordered} and generated by the 
\emph{positive cone} $\mathcal{A}_{sa+}$ i.e. 
\begin{equation}
\mathcal{A}_{sa}=\mathcal{A}_{sa+}-\mathcal{A}_{sa+}.
\end{equation}
\end{remark}

\begin{definition}
\emph{Jordan Quadratic Product }is defined by 
\begin{equation}
U_{x}\left( y\right) =2x\ast \left( x\ast y\right) -x^{2}\ast y=x\ast y\ast
x,
\end{equation}%
which gives%
\begin{equation}
U_{U_{x}\left( y\right) }=U_{x}U_{y}U_{x}.
\end{equation}
\end{definition}

\begin{definition}
The \emph{Jordan Triple Product} is defined by 
\begin{equation}
\left\{ x,y,z\right\} =2\left( \overset{}{x\ast \left( y\ast z\right)
+\left( x\ast y\right) \ast z-\left( x\ast z\right) \ast y}\right) =x\ast
y\ast z+z\ast y\ast x.
\end{equation}
\end{definition}

\paragraph{Spectral Expansion}

As all elements in a Jordan algebra are self adjoint in the enveloping
associative algebra one always has the spectral expansion theorem 
\begin{equation}
A=\int_{\limfunc{Spec}\left( A\right) \subseteq \mathbb{R}}\lambda
dP_{A}\left( \lambda \right)
\end{equation}%
giving 
\begin{equation}
A\ast B=\int_{\limfunc{Spec}\left( A\ast B\right) \subseteq \mathbb{R}%
}\lambda dP_{A\ast B}\left( \lambda \right) .
\end{equation}

\begin{remark}
In the compact case 
\begin{align}
\sum_{1\leq j\leq 2r}\alpha _{j}\left\vert x_{j}\right\rangle \left\langle
x_{j}\right\vert \sum_{1\leq k\leq 2r}\beta _{k}\left\vert
y_{k}\right\rangle \left\langle y_{k}\right\vert & =\sum_{1\leq j.k\leq
2r}\alpha _{j}\beta _{k}\left\vert x_{j}\right\rangle \left\langle
x_{j}\right\vert \left\vert y_{k}\right\rangle \left\langle y_{k}\right\vert
\\
\sum_{1\leq k\leq 2r}\beta _{k}\left\vert y_{k}\right\rangle \left\langle
y_{k}\right\vert \sum_{1\leq j\leq 2r}\alpha _{j}\left\vert
x_{j}\right\rangle \left\langle x_{j}\right\vert & =\sum_{1\leq j.k\leq
2r}\alpha _{j}\beta _{k}\left\vert y_{k}\right\rangle \left\langle
y_{k}\right\vert \left\vert x_{j}\right\rangle \left\langle x_{j}\right\vert
\\
\sum_{1\leq j\leq 2r}\alpha _{j}\left\vert x_{j}\right\rangle \left\langle
x_{j}\right\vert \ast \sum_{1\leq k\leq 2r}\beta _{k}\left\vert
y_{k}\right\rangle \left\langle y_{kj}\right\vert & =\frac{1}{2}\sum_{1\leq
j.k\leq 2r}\alpha _{j}\beta _{k}\left\{ \left\vert x_{j}\right\rangle
\left\langle x_{j}\right\vert \left\vert y_{k}\right\rangle \left\langle
y_{k}\right\vert +\left\vert y_{k}\right\rangle \left\langle
y_{k}\right\vert \left\vert x_{j}\right\rangle \left\langle x_{j}\right\vert
\right\} =\sum_{1\leq k\leq 2r}\gamma _{j}\left\vert z_{k}\right\rangle
\left\langle z_{k}\right\vert
\end{align}
\end{remark}

\begin{remark}
The Jordan product of compact projectors 
\begin{eqnarray}
&&\sum_{1\leq j\leq \kappa }\left\vert x_{j}\right\rangle \left\langle
x_{j}\right\vert \ast \sum_{1\leq j\leq \kappa }\left\vert
x_{j}\right\rangle \left\langle x_{j}\right\vert =\frac{1}{2}\sum_{1\leq
j\leq \kappa }\left\{ \left\vert x_{j}\right\rangle \left\langle
x_{j}\right\vert \left\vert x_{k}\right\rangle \left\langle x_{k}\right\vert
+\left\vert x_{k}\right\rangle \left\langle x_{k}\right\vert \left\vert
x_{j}\right\rangle \left\langle x_{j}\right\vert \right\} \\
&=&\frac{1}{2}\sum_{1\leq j\leq \kappa }\left\{ \left\vert
x_{j}\right\rangle \left\langle x_{j}\right\vert +\left\vert
x_{j}\right\rangle \left\langle x_{j}\right\vert \right\} =\sum_{1\leq j\leq
\kappa }\left\vert x_{j}\right\rangle \left\langle x_{j}\right\vert
\end{eqnarray}%
i.e. 
\begin{equation}
P^{2\ast }=P\ast P=P=P^{2}.
\end{equation}
\end{remark}

\begin{remark}
Orthogonal projectors can be expanded in in both the Jordan and Clifford
algebras as 
\begin{equation}
P=\sum_{0\leq n\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}\eta
_{nj_{1}\cdots j_{n}}i^{\frac{n\left( n-1\right) }{2}}\widetilde{x}%
_{j_{1}}\cdots \widetilde{x}_{j_{n}};\quad \eta _{nj_{1}\cdots j_{n}}\in 
\mathbb{R}.
\end{equation}
\end{remark}

\begin{remark}
The zeroth degree Jordan idempotent $\equiv $ orthogonal projector is 
\begin{equation}
P_{0}=I_{\mathcal{H}_{\mathcal{F}}}.
\end{equation}
\end{remark}

\begin{example}
The square of a sum in a Jordan algebra has the form 
\begin{equation}
\left( a+b\right) \left( a+b\right) =a^{2}+2ab+b^{2}.
\end{equation}%
The degree one projector $P_{1\eta }$ has the expansion 
\begin{equation}
P_{1\eta }=\sum_{0\leq n\leq 1}\sum_{1\leq j_{1}\leq 2r}\eta _{nj_{1}\cdots
j_{n}}i^{\frac{n\left( n-1\right) }{2}}\widetilde{x}_{j_{1}}\cdots 
\widetilde{x}_{j_{n}}=\eta _{0}I_{\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}
\end{equation}%
giving%
\begin{eqnarray}
P_{1\eta }\ast P_{1\eta } &=&\left( \eta _{0}I_{\mathcal{H}_{\mathcal{F}%
}}+\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}\right) \ast
\left( \eta _{0}I_{\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq j_{1}\leq 2r}\eta
_{1j_{1}}\widetilde{x}_{j_{1}}\right) \\
&=&\eta _{0}^{2}I_{\mathcal{H}_{\mathcal{F}}}+2\eta _{0}\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}+.\frac{1}{2}\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}^{2}I_{\mathcal{H}_{\mathcal{F}}}. \\
&=&\left( \eta _{0}^{2}+\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\eta
_{1j_{1}}^{2}\right) I_{\mathcal{H}_{\mathcal{F}}}+2\eta _{0}\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}.
\end{eqnarray}%
The idempotency condition 
\begin{equation}
P_{1\eta }\ast P_{1\eta }=P_{1\eta }=P_{1\eta }^{2}
\end{equation}%
gives%
\begin{gather}
\left[ \left( \eta _{0}^{2}+\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\eta
_{1j_{1}}^{2}\right) I_{\mathcal{H}_{\mathcal{F}}}+2\eta _{0}\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}\right] =\left[ \eta _{0}I_{%
\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{%
x}_{j_{1}}\right] \\
\Downarrow \\
\left[ \left( \eta _{0}^{2}+\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\eta
_{1j_{1}}^{2}\right) \right] =\eta _{0}\Rightarrow \left[ \eta _{0}-\eta
_{0}^{2}=\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}^{2}\right] \\
2\eta _{0}\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}%
_{j_{1}}=\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}%
_{j_{1}}\Rightarrow \left[ \eta _{0}=\frac{1}{2}\right] \\
\Downarrow \\
\frac{1}{4}=\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\eta
_{1j_{1}}^{2}\Leftrightarrow \sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}^{2}=%
\frac{1}{4}.
\end{gather}
\end{example}

\begin{example}
\begin{eqnarray}
\left( \alpha I_{\mathcal{F}}+\beta x_{1}\right) ^{2} &=&\alpha ^{2}I_{%
\mathcal{F}}+2\alpha \beta \widetilde{x}_{1}+\frac{1}{2}\beta ^{2}I_{%
\mathcal{F}}=\alpha I_{\mathcal{F}}+\beta \widetilde{x}_{1} \\
\beta &=&2\alpha \beta \Rightarrow \left( \alpha =\frac{1}{2}\right) \text{
or }\left( \beta =0\text{ and }\alpha =1\right) \\
\alpha &=&\alpha ^{2}+\frac{1}{2}\beta ^{2} \\
&\Rightarrow &\frac{1}{2}=\frac{1}{4}+\frac{1}{2}\beta ^{2}\Rightarrow \beta
=\frac{1}{\sqrt{2}}
\end{eqnarray}%
giving%
\begin{equation}
P_{1\eta }=\frac{1}{2}I_{\mathcal{H}_{\mathcal{F}}}+\frac{1}{\sqrt{2}}%
\widetilde{x}_{1}.
\end{equation}%
In this case $r=2$ and%
\begin{eqnarray}
\eta _{0} &=&\frac{1}{2},\,\eta _{11}=\frac{1}{\sqrt{2}} \\
\eta _{12} &=&\eta _{13}=\eta _{14}=0
\end{eqnarray}%
and one can check 
\begin{equation}
\left( \frac{1}{2}I_{\mathcal{H}_{\mathcal{F}}}+\frac{1}{\sqrt{2}}\widetilde{%
x}_{1}\right) ^{2}=\frac{1}{4}I_{\mathcal{H}_{\mathcal{F}}}+\frac{1}{\sqrt{2}%
}\widetilde{x}_{1}+\left( \frac{1}{2}\right) \left( \frac{1}{2}\right) I_{%
\mathcal{H}_{\mathcal{F}}}=\frac{1}{2}I_{\mathcal{H}_{\mathcal{F}}}+\frac{1}{%
\sqrt{2}}\widetilde{x}_{1}.
\end{equation}
\end{example}

\begin{example}
In the general first degree case the idempotency conditions give

\begin{enumerate}
\item 
\begin{equation}
\eta _{0}^{2}+\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}^{2}=\eta
_{0}
\end{equation}

\item 
\begin{gather}
2\eta _{0}\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}%
_{j_{1}}=\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}} \\
\Downarrow \\
\eta _{0}=\frac{1}{2}\text{ or }\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}%
\widetilde{x}_{j_{1}}=0\text{ and }\eta _{0}=1.
\end{gather}

\item This gives 
\begin{equation}
\left[ \frac{1}{4}+\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}^{2}=\frac{1}{4}%
\right] \Rightarrow \left[ \frac{1}{4}-\frac{1}{2}+\sum_{1\leq j_{1}\leq
2r}\eta _{1j_{1}}^{2}=0\right] \Rightarrow \left[ \sum_{1\leq j_{1}\leq
2r}\eta _{1j_{1}}^{2}=\frac{1}{4}\right] ,
\end{equation}%
and the general expression for the first order idempotent as 
\begin{equation}
P_{1\eta }=\frac{1}{2}I_{\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq j_{1}\leq
2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}};\quad \eta _{1j_{1}}\in \mathbb{R}%
,\quad \sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}^{2}=\frac{1}{4}.
\end{equation}
\end{enumerate}
\end{example}

\begin{remark}
\begin{equation}
P_{1\eta }^{2}=\left( \frac{1}{2}I_{\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}\right) \ast \left( \frac{1}{%
2}I_{\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq j_{1}\leq 2r}\eta _{1j_{1}}%
\widetilde{x}_{j_{1}}\right) =\left( \frac{1}{4}+\sum_{1\leq j_{1}\leq
2r}\eta _{1j_{1}}^{2}\right) I_{\mathcal{H}_{\mathcal{F}}}+\sum_{1\leq
j_{1}\leq 2r}\eta _{1j_{1}}\widetilde{x}_{j_{1}}
\end{equation}%
hence 
\begin{equation}
P_{1\eta }^{2}=P_{1\eta }\Leftrightarrow \sum_{1\leq j_{1}\leq 2r}\eta
_{1j_{1}}^{2}=\frac{1}{4}.
\end{equation}
\end{remark}

\begin{example}
\begin{enumerate}
\item 
