\eta _{213} &=&1;\quad \eta _{212}=\eta _{214}=\eta _{223}=\eta _{224}=\eta
_{234}=0
\end{eqnarray}%
giving%
\begin{equation}
\frac{1}{4}-\frac{1}{2}+0+\frac{1}{4}\left( 1\right) =0.
\end{equation}
\end{example}

