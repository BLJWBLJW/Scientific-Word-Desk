giving 
\begin{equation}
\left( 
\begin{array}{cccc}
0 & -\eta _{212} & -\eta _{213} & -\eta _{214} \\ 
\eta _{212} & 0 & -\eta _{223} & -\eta _{224} \\ 
\eta _{213} & \eta _{223} & 0 & -\eta _{234} \\ 
\eta _{214} & \eta _{224} & \eta _{234} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\eta _{11} \\ 
\eta _{12} \\ 
\eta _{13} \\ 
\eta _{14}%
\end{array}%
\right) =\left( 
\begin{array}{c}
0 \\ 
0 \\ 
0 \\ 
0%
\end{array}%
\right)
\end{equation}

\item The second order term idempotency condition%
\begin{gather}
i\left[ \eta _{212}\widetilde{x}_{1}\widetilde{x}_{2}+\eta _{213}\widetilde{x%
}_{1}\widetilde{x}_{3}+\eta _{214}\widetilde{x}_{1}\widetilde{x}_{4}+\eta
_{223}\widetilde{x}_{2}\widetilde{x}_{3}+\eta _{224}\widetilde{x}_{2}%
