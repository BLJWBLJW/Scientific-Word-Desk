\section{Canonical Anti Commutation Relationship (CAR)}

\subsubsection{The Fock Representation}

The creation operators $\left\{ \left. a_{j}^{\dagger }\equiv a^{\dagger
}\left( \varphi _{j}\right) \equiv a\left( \varphi _{j}\right) ^{\dagger
}\right\vert 1\leq j\leq r\right\} $ belong to $\mathcal{F}\equiv \mathcal{B}%
\left( \mathcal{H}_{\mathcal{F}}\right) ,$ where $\mathcal{H}_{\mathcal{F}}$
is a \emph{Hilbert Exterior Algebra} given by 
\begin{equation}
\mathcal{H}_{\mathcal{F}}\equiv \tbigwedge \left( \mathcal{H}^{1}\right)
=\tbigoplus\limits_{0\leq n\leq r}\mathcal{H}^{n},
\end{equation}%
where 
\begin{eqnarray}
\mathcal{H}^{n} &=&\otimes ^{n}\mathcal{H}^{1};\,1\leq n\leq r \\
\mathcal{H}^{0} &=&\mathbb{C}\left\vert \phi \right\rangle
\end{eqnarray}%
and $\left\vert \phi \right\rangle $ the vacuum state for $\mathcal{H}_{%
\mathcal{F}}.$

\begin{definition}
The inner product $\left\langle \left. {}\right\vert \right\rangle _{%
\mathcal{H}_{\mathcal{F}}}$ in the Hilbert space $\mathcal{H}_{\mathcal{F}}$
is 
\begin{equation}
\left\langle \left. v\right\vert v\right\rangle _{\mathcal{H}_{\mathcal{F}%
}}=\sum_{0\leq n\leq \infty }\left\langle \left. v\right\vert v\right\rangle
_{\mathcal{H}^{n}},\quad v_{n}\in \mathcal{H}^{n},\,0\leq n\leq \infty .
\end{equation}
\end{definition}

\begin{definition}
The Hilbert space $\mathcal{H}_{\mathcal{F}}$ is defined as the completion
of sums of \emph{finite rank} vectors $v_{n}$ 
\begin{eqnarray}
v_{n} &=&\left( v_{n1},\cdots v_{nn},0,\cdots \right) \\
v_{n} &\in &\mathcal{H}^{n},\,0\leq n<\infty ,
\end{eqnarray}%
that have finitely many non zero components.
\end{definition}

\begin{definition}
\begin{equation}
\left\vert \phi \right\rangle \wedge \Phi =\Phi \wedge \left\vert \phi
\right\rangle =\Phi \quad \forall \Phi \in \mathcal{H}_{\mathcal{F}},
\end{equation}%
i.e. $\left\vert \phi \right\rangle $ is the identity element of $\mathcal{H}%
_{\mathcal{F}}$ wrt the multiplication $\wedge .$
\end{definition}

The identity operator $I_{\mathcal{F}}\equiv I_{\mathcal{H}_{\mathcal{F}%
}}\in \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ can be expanded
as 
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}=\sum_{0\leq n\leq r}P_{\mathcal{H}^{n}},
\end{equation}%
where $\left\{ \left. P_{\mathcal{H}^{n}}\right\vert 0\leq n\leq r\right\} $
are orthogonal projectors onto the subspaces $\left\{ \left.
\tbigwedge\nolimits^{n}\mathcal{H}^{1}\equiv \mathcal{H}^{n}\right\vert
0\leq n\leq r\right\} .$ The dimensions of the subspaces are given by 
\begin{equation}
\dim \left\{ \mathcal{H}^{n}\right\} =\func{Tr}_{\mathcal{H}_{\mathcal{F}%
}}\left\{ P_{\mathcal{H}^{n}}\right\} =\func{Tr}_{\mathcal{H}^{n}}\left\{ P_{%
\mathcal{H}^{n}}\right\} =\binom{r}{n};0\leq n\leq r,
\end{equation}%
leading to 
\begin{equation}
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ I_{\mathcal{H}_{\mathcal{F}%
}}\right\} =\sum_{0\leq n\leq r}\binom{r}{n}=2^{r}.
\end{equation}%
The trace $\func{Tr}_{\mathcal{H}_{\mathcal{F}}}$ can be restricted to the
subspaces leading to \emph{partial traces} i.e. 
\begin{equation}
\func{Tr}_{\mathcal{H}^{n}}=\left. \func{Tr}_{\mathcal{H}_{\mathcal{F}%
}}\right\vert _{\mathcal{H}^{n}}
\end{equation}%
giving%
\begin{equation}
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ P_{\mathcal{H}^{m}}\right\} =%
\func{Tr}_{\mathcal{H}^{n}}\left\{ P_{\mathcal{H}^{m}}\right\} =\binom{r}{n}%
\delta _{nm};0\leq n\leq r.
\end{equation}

\begin{notation}
\begin{equation}
\Phi \equiv \left\vert \Phi \right\rangle .
\end{equation}
\end{notation}

\begin{notation}
Unless stated otherwise we will use the identification $\func{Tr}\equiv 
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}.$
\end{notation}

The creation operators $\left\{ \left. a_{j}^{\dagger }\right\vert 1\leq
j\leq r\right\} \subset \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $
are defined by their action on a conb $\left\{ \left. \left\vert \varphi
_{j_{1}}\cdots \varphi _{j_{n}}\right\rangle \right\vert 1\leq j_{1}<\cdots
<j_{n}\leq r;0\leq n\leq r\right\} $ of $\mathcal{H}_{\mathcal{F}}$ by 
\begin{equation}
a_{j}^{\dagger }\left\vert \varphi _{j_{1}}\cdots \varphi
_{j_{n}}\right\rangle =\left\vert \varphi _{j}\varphi _{j_{1}}\cdots \varphi
_{j_{n}}\right\rangle .  \label{CREAT}
\end{equation}%
and the annihilation operators $\left\{ \left. a_{j}\right\vert 1\leq j\leq
r\right\} $ are defined as their adjoints i.e. 
\begin{equation}
a_{j}=\left( a_{j}^{\dagger }\right) ^{\dagger },\,1\leq j\leq r.
\end{equation}

The creation and annihilation operators satisfy the \emph{Canonical
Anticommutation Relationships (CAR)} 
\begin{subequations}
\label{CAR}
\begin{align}
\left\{ a_{j},a_{k}^{\dagger}\right\} & =\delta_{jk}I_{\mathcal{F}}
\label{CAR1} \\
\left\{ a_{j}^{\dagger},a_{k}^{\dagger}\right\} & =\left\{
a_{j},a_{k}\right\} =0  \label{CAR2} \\
1 & \leq j\leq r,
\end{align}
where 
\end{subequations}
\begin{equation}
\left\{ A,B\right\} =AB+BA,
\end{equation}

\begin{itemize}
\item The operators $\left\{ \left. a_{j}^{\dagger}\right\vert 1\leq j\leq
r\right\} $ are bounded so have bounded adjoints $\left\{ \left.
a_{j}\right\vert 1\leq j\leq r\right\} $ and hence 
\begin{equation}
a_{j}^{\dagger}=\left( a_{j}\right) ^{\dagger}.
\end{equation}

\item In particular it follows from the definition eq. $\left( \ref{CREAT}%
\right) $ and eq. $\left( \ref{CAR1}\right) $ that 
\begin{gather}
a_{j}^{\dagger }\left\vert \phi \right\rangle =\left\vert \varphi
_{j}\right\rangle  \notag \\
a_{j}\left\vert \phi \right\rangle =0  \notag \\
1\leq j\leq r.
\end{gather}

This follows from 
\begin{equation}
\left\langle \left. \phi\right\vert a_{j}^{\dagger}a_{j}\phi\right\rangle
=\left\langle \phi\left\vert \left( I_{\mathcal{F}}-a_{j}a_{j}^{\dagger
}\right) \right. \phi\right\rangle =0,
\end{equation}
which implies that 
\begin{equation}
a_{j}\left\vert \phi\right\rangle =0.
\end{equation}

\item $a_{j}^{\dagger }$ and $a_{j}$ are \emph{partial isometries}, (and
generate the \emph{Fermion Fock algebra} $\mathcal{F}\equiv \mathcal{B}%
\left( \tbigwedge \left( \mathcal{H}^{1}\right) \right) $), as 
\begin{equation}
a_{j}^{\dagger }a_{j}\text{ and }a_{j}a_{j}^{\dagger }
\end{equation}%
are projectors and equivalently 
\begin{equation}
a_{j}a_{j}^{\dag }a_{j}=a_{j}\left( 1-a_{j}a_{j}^{\dag }\right) =a_{j}.
\end{equation}%
In this particular case 
\begin{align}
a_{j}^{\dag }a_{j}+a_{j}a_{j}^{\dag }& =I_{\mathcal{F}}, \\
a_{j}^{\dag }a_{j}a_{j}a_{j}^{\dag }& =0 \\
a_{j}a_{j}^{\dag }a_{j}^{\dag }a_{j}& =0,
\end{align}%
the projectors $a_{j}^{\dag }a_{j}$ and $a_{j}a_{j}^{\dag }$ are orthogonal
as $a_{j}^{\dag }a_{j}a_{j}a_{j}^{\dag }=a_{j}^{\dag }a_{j}\left(
1-a_{j}^{\dag }a_{j}\right) =a_{j}^{\dag }a_{j}-a_{j}^{\dag }a_{j}=0$ and
are also infinite dimensional if $r=\infty $.

\item The partial isometries $\left\{ \left. a_{j}^{\dagger
},a_{j}\right\vert 1\leq j\leq r\text{ }\right\} $ associated with the
projectors $\left\{ \left. a_{j}^{\dagger }a_{j},a_{j}a_{j}^{\dagger
}\right\vert 1\leq j\leq r\text{ }\right\} $ generate a Fock representation $%
\mathcal{F}=\mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ of a CAR\
algebra$,$ (the space of bounded operators acting in $\mathcal{H}_{\mathcal{F%
}}),$ which is a \emph{noncomutative polynomial Type }$I_{2^{r}}$ $w^{\ast }$%
\emph{-algebra}.

\item The trace of the projectors $\left\{ \left. a_{j}^{\dagger
}a_{j},a_{j}a_{j}^{\dagger }\right\vert 1\leq j\leq r\text{ }\right\} $ are 
\begin{equation}
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ a_{j}^{\dag
}a_{j}+a_{j}a_{j}^{\dag }\right\} =\func{Tr}_{\mathcal{H}_{\mathcal{F}%
}}\left\{ I_{\mathcal{F}}\right\} =2^{r}
\end{equation}%
leading to 
\begin{equation}
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ a_{j}^{\dag }a_{j}\right\} =%
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ a_{j}a_{j}^{\dag }\right\}
=2^{r-1}.
\end{equation}%
and 
\begin{equation}
\func{Tr}_{\mathcal{H}^{n}}\left\{ a_{j}^{\dag }a_{j}\right\} =\func{Tr}_{%
\mathcal{H}^{n}}\left\{ a_{j}a_{j}^{\dag }\right\} =\binom{r-1}{n}.
\end{equation}

\item The antisymmetry of the CAR gives 
\begin{equation}
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ a_{j}^{\dag }a_{k}\right\} =%
\func{Tr}_{\mathcal{H}_{\mathcal{F}}}\left\{ a_{j}a_{k}^{\dag }\right\}
=0;\,1\leq j\neq k\leq r.
\end{equation}
\end{itemize}

\paragraph{General Field Operators}

One can set the operators $\left\{ \left. a_{j}^{\dagger }\right\vert 1\leq
j\leq r\right\} $ as the values of a \emph{complex linear map} 
\begin{equation}
\Phi ^{\dagger }:\mathcal{H}^{1}\rightarrow \mathcal{B}\left( \mathcal{H}_{%
\mathcal{F}}\right) ,
\end{equation}%
i.e. 
\begin{equation}
a_{j}^{\dagger }=\Phi ^{\dagger }\left( \left\vert \varphi _{j}\right\rangle
\right) ,
\end{equation}%
which leads to a more general (basis free) form of the CAR 
\begin{subequations}
\begin{align}
\left\{ \Phi \left( \left\vert u\right\rangle \right) ,\Phi ^{\dagger
}\left( \left\vert v\right\rangle \right) \right\} & =\left\langle \left.
u\right\vert v\right\rangle I_{\mathcal{F}} \\
\left\{ \Phi ^{\dagger }\left( \left\vert u\right\rangle \right) ,\Phi
^{\dagger }\left( \left\vert v\right\rangle \right) \right\} & =\left\{ \Phi
\left( \left\vert u\right\rangle \right) ,\Phi \left( \left\vert
v\right\rangle \right) \right\} =0 \\
\forall \left\vert u\right\rangle ,\left\vert v\right\rangle & \in \mathcal{H%
}^{1},
\end{align}%
where 
\end{subequations}
\begin{equation}
\Phi \left( \left\vert u\right\rangle \right) =\left( \Phi ^{\dagger }\left(
\left\vert u\right\rangle \right) \right) ^{\dagger }.
\end{equation}%
In this case 
\begin{equation}
\mathcal{H}_{\mathcal{F}}=\tbigwedge \left( \mathcal{H}^{1}\right) ,
\end{equation}%
however this can be generalized by considering different \emph{indexed}
Hilbert spaces $\mathfrak{H}$ for a CAR\ map 
\begin{equation}
\Phi ^{\dagger }:\mathfrak{H}\rightarrow \mathcal{A}
\end{equation}%
into a $c^{\ast }$\emph{-algebra} $\mathcal{A}$ followed by a GNS
representation induced by a state $f\in \mathcal{S}\left( \mathcal{A}\right) 
$ i.e. 
\begin{equation}
\Phi ^{\dagger }:\mathfrak{H}\rightarrow \mathcal{A}\rightarrow \mathcal{\Pi 
}_{f}\left( \mathcal{A}\right) \subseteq \mathcal{B}\left( \mathcal{H}%
_{f}\right) .
\end{equation}

\begin{remark}
As $\mathcal{\Pi }_{f}\left( \mathcal{A}\right) $ is in general \emph{%
properly included} in $\mathcal{B}\left( \mathcal{H}_{f}\right) $ it may 
\emph{not contain} any \emph{individual} Ket-Bra operators, though it must
contain linear combinations or limits of combinations of these operators (as
all operators in $\mathcal{B}\left( \mathcal{H}_{f}\right) $ can be
expressed in this manner).
\end{remark}

\begin{definition}
A map $T\in GL\left( \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right)
\right) \subset \mathcal{B}\left( \mathcal{B}\left( \mathcal{H}_{\mathcal{F}%
}\right) \right) $ is a $c^{\ast }$\emph{-algebra automorphism} if $\forall
X,Y\in \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ 
\begin{align}
T\left( XY\right) & =T\left( X\right) T\left( Y\right) \\
T\left( X^{\dagger }\right) & =T\left( X\right) ^{\dagger } \\
T^{-1}T& =I_{\mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) }.
\end{align}
\end{definition}

The norm of $T$ is defined by 
\begin{equation}
\left\Vert T\right\Vert =\sup_{\left\Vert X\right\Vert _{\mathcal{B}\left( 
\mathcal{H}_{\mathcal{F}}\right) }=1}\left\Vert T\left( X\right) \right\Vert
_{\mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) },
\end{equation}%
and $T$ is an isometric isomorphism if 
\begin{equation}
\left\Vert T\left( X\right) \right\Vert _{\mathcal{B}\left( \mathcal{H}_{%
\mathcal{F}}\right) }=\left\Vert X\right\Vert _{\mathcal{B}\left( \mathcal{H}%
_{\mathcal{F}}\right) }
\end{equation}

\begin{lemma}
If $T$ is a $c^{\ast }$\emph{-algebra isomorphism i.e. } 
\begin{equation}
T\left( I_{\mathcal{F}}\right) =I_{\mathcal{F}}
\end{equation}
then 
\begin{subequations}
\label{CAR}
\begin{align}
\left\{ T\left( a_{j}\right) ,T\left( a_{k}^{\dagger }\right) \right\} &
=\left\{ T\left( a_{j}\right) ,T\left( a_{k}\right) ^{\dagger }\right\}
=T\left( \left\{ a_{j},a_{k}^{\dagger }\right\} \right) =\delta _{jk}T\left(
I_{\mathcal{F}}\right) \\
T\left( \left\{ a_{j}^{\dagger },a_{k}^{\dagger }\right\} \right) & =T\left(
\left\{ a_{j},a_{k}\right\} \right) =0 \\
1& \leq j,k\leq r
\end{align}%
i.e. $T$ preserves the CAR's.
\end{lemma}

\begin{lemma}
$T$ is a $c^{\ast }$\emph{-algebra inner isometric isomorphism} if 
\end{subequations}
\begin{equation}
T\left( X\right) =\widehat{u}\left( X\right) =uXu^{\dagger }
\end{equation}
when 
\begin{equation}
u\in U\left( \mathcal{H}_{\mathcal{F}}\right) .
\end{equation}
\end{lemma}

One can note that the norms of the annihilation and creation operators are 
\begin{equation}
\left\Vert a_{j}\right\Vert _{\mathcal{B}\left( \mathcal{H}_{\mathcal{F}%
}\right) }=\left\Vert a_{j}^{\dagger }\right\Vert _{\mathcal{B}\left( 
\mathcal{H}_{\mathcal{F}}\right) }=1.
\end{equation}%
Obviously 
\begin{equation}
T\left( I_{\mathcal{F}}\right) \in \mathcal{Z}\left( \mathcal{F}\right) ,
\end{equation}%
where $\mathcal{Z}\left( \mathcal{F}\right) $ is the centre of $\mathcal{F}$%
. In this case $\mathcal{F}$ is a simple algebra thus 
\begin{equation}
T\left( I_{\mathcal{F}}\right) =zI_{\mathcal{F}},\quad z\in \mathbb{C},
\end{equation}%
and 
\begin{equation}
z=1.
\end{equation}

\begin{remark}
One can generalize some of the preceding to \emph{non }invertible elements
of $\mathcal{B}\left( \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right)
\right) $ i.e. to general endomorphisms of $\mathcal{B}\left( \mathcal{H}_{%
\mathcal{F}}\right) .$
\end{remark}

\begin{notation}
The set $\left\{ \mathbf{a}^{\dagger },\mathbf{a}\right\} $ is an example of
an \emph{Adjoint Basis }of $\mathcal{F}_{1}$
\end{notation}

\begin{notation}
The set $\left\{ \mathbf{x}\right\} =\left\{ \mathbf{x}_{1},\mathbf{x}%
_{2}\right\} ,$ where 
\begin{equation}
\mathbf{x}_{1}=\mathbf{x}_{1}^{\dagger },
\end{equation}%
\begin{equation}
\mathbf{x}_{2}=\mathbf{x}_{2}^{\dagger }
\end{equation}%
and 
\begin{equation}
\left\{ \mathbf{x}_{1}\right\} \cap \left\{ \mathbf{x}_{2}\right\} =\phi
\end{equation}%
(to be defined subsequently), is an example of a \emph{Self Adjoint Basis }%
of $\mathcal{F}_{1}$.
\end{notation}

\begin{notation}
A basis of $\mathcal{F}_{1}$ that is not \emph{Adjoint} or \emph{Self
Adjoint }is called a \emph{General Basis} $\mathcal{F}_{1},$ unless
otherwise qualified with another property$.$
\end{notation}

\begin{definition}
If an operator $X\in \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $
can be expanded as 
\begin{equation}
X=\sum_{0\leq m\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{m}\leq
2r}x_{j_{1}}\cdots x_{j_{m}}\mathcal{R}_{x}\left( X\right) _{j_{1}\cdots
j_{m}}
\end{equation}%
it is said to be of \emph{degree} $m$ wrt the self adjoint basis $\left\{ 
\mathbf{x}\right\} $ and $X\in \deg \left\{ \mathcal{F},\mathbf{x,}m\right\}
.$
\end{definition}

\begin{definition}
If an operator $X\in \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $
can be expanded as 
\begin{equation}
X=\sum_{1\leq j_{1}<\cdots <j_{m}\leq 2r}x_{j_{1}}\cdots x_{j_{m}}\mathcal{R}%
_{x}\left( X\right) _{j_{1}\cdots j_{m}}
\end{equation}%
it is said to be \emph{homogeneous} of degree $m$ wrt the self adjoint basis 
$\left\{ \mathbf{x}\right\} $ and $X\in \func{homdeg}\left\{ \mathcal{F},%
\mathbf{x,}m\right\} .$
\end{definition}

\begin{remark}
Let $T$ be a $c^{\ast }$\emph{-algebra isomorphism}

\begin{enumerate}
\item \emph{\ }if 
\begin{equation}
T:\deg \left\{ \mathcal{F},\mathbf{x,}m\right\} \rightarrow \deg \left\{ 
\mathcal{F},\mathbf{x,}m\right\}
\end{equation}%
then $T$ is degree preserving, while

\item if 
\begin{equation}
T:\func{homdeg}\left\{ \mathcal{F},\mathbf{x,}m\right\} \rightarrow \func{%
homdeg}\left\{ \mathcal{F},\mathbf{x,}m\right\}
\end{equation}%
then $T$ is homogeneous degree preserving.
\end{enumerate}
\end{remark}

\begin{conjecture}
It is possible to produce bases $T\left( \mathcal{F}_{1}\right) $ and thus
representations of the CAR that are of higher degree than first degree in $%
\left\{ \mathbf{x}\right\} .$
\end{conjecture}

\section{Fat Symbol Notation}

We first note that matrices $m\times n$ matrices with entries from the \emph{%
Clifford Algebra / }$c^{\ast }$\emph{-Algebra }$\mathcal{F}$ are in fact
tensor products as \emph{\ } 
\begin{equation}
\mathcal{M}\left( m,n,\mathcal{F}\right) =\mathcal{M}\left( m,n,\mathbb{C}%
\right) \otimes \mathcal{F},
\end{equation}%
where%
\begin{align}
m& =\text{number of rows} \\
n& =\text{number of columns.}
\end{align}

\begin{notation}
\emph{Column vectors} (Contravariant vectors) formed from elements of $%
\mathcal{F}$ are arrays 
\begin{equation}
\mathcal{F}^{m}=\mathcal{M}\left( m,1,\mathcal{F}\right) .
\end{equation}%
In finite dimensions if there is an inner product defined in $\mathcal{F}%
^{1} $ the dual space, $\left( \mathcal{F}^{m}\right) ^{d},$ of $\mathcal{F}%
^{m}$ is isomorphic to the space of \emph{row vectors} (Covariant vectors) 
\begin{equation}
\left( \mathcal{F}^{m}\right) ^{d}=\mathcal{M}\left( 1,m,\mathcal{F}\right) .
\end{equation}
\end{notation}

\begin{remark}
Any contravariant vector belonging $v\in V,$ a complex vector space of
dimension $n,$ can be expanded in terms of a product of a contravariant
vector $\mathbf{v}=\mathcal{R}_{e}\left( v\right) \in \mathbb{C}^{n}$ and a 
\emph{super} covariant vector of basis vectors $\mathbf{e}$ of $V^{n}$ as 
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{n}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{n}%
\end{array}%
\right) =\left( \mathbf{e}\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) _{n}%
\end{array}%
\right) =\left( \mathbf{e}\right) \mathcal{R}_{e}\left( v\right) \mathbf{;\,}%
e_{j},1\leq j\leq n\mathbf{.}
\end{equation}
\end{remark}

\begin{notation}
\begin{equation}
\mathbf{e}\equiv \left( \mathbf{e}\right) .
\end{equation}
\end{notation}

\begin{example}
Let $\mathcal{F}=\mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ and
consider a Ket-Bra basis $\left\{ \left. \left\vert \Psi _{j}\right\rangle
\left\langle \Psi _{k}\right\vert \right\vert 1\leq j,k\leq 2^{r}\right\} $
then 
\begin{eqnarray}
\mathcal{F} &=&\mathcal{M}\left( 2^{2r},1,\mathcal{B}\left( \mathcal{H}_{%
\mathcal{F}}\right) \right) \\
\left( \mathcal{F}\right) ^{d} &=&\mathcal{M}\left( 1,2^{2r},\mathcal{B}%
\left( \mathcal{H}_{\mathcal{F}}\right) \right) .
\end{eqnarray}%
Any operator $X\in \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ can
be expanded as the strong operator limit of the expansions 
\begin{equation}
X=\left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle \left\langle \Psi _{1}\right\vert & \cdots
& \left\vert \Psi _{2^{r}}\right\rangle \left\langle \Psi _{2^{r}}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{2^{r}2^{r}}%
\end{array}%
\right) =\left( \left\vert \mathbf{\Psi }\right\rangle \left\langle \mathbf{%
\Psi }\right\vert \right) \mathcal{R}_{\left\vert \Psi \right\rangle
\left\langle \Psi \right\vert }\left( X\right) =\left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle \left\langle \Psi _{1}\right\vert & \cdots
& \left\vert \Psi _{2^{r}}\right\rangle \left\langle \Psi _{2^{r}}\right\vert%
\end{array}%
\right) \mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi
\right\vert }\left( X\right) ,
\end{equation}%
where $\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi
\right\vert }\left( X\right) \in \mathbb{C}^{2^{2r}}.$
\end{example}

\begin{example}
$X\in \mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ has a matrix
representation $\mathcal{R}_{\left\vert \Psi \right\rangle }\left( X\right) $
wrt the basis $\left\{ \left. \left\vert \Psi _{j}\right\rangle \right\vert
1\leq j\leq 2^{r}\right\} $ given by 
\begin{equation}
X\left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle & \cdots & \left\vert \Psi
_{2^{r}}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle & \cdots & \left\vert \Psi
_{2^{r}}\right\rangle%
\end{array}%
\right) \mathcal{R}_{\left\vert \Psi \right\rangle }\left( X\right) ,
\end{equation}%
where $\mathcal{R}_{\left\vert \Psi \right\rangle }\left( X\right) \in 
\mathcal{M}\left( 2^{r},2^{r},\mathbb{C}\right) .$
\end{example}

\begin{remark}
\begin{enumerate}
\item The injection from $\mathcal{H}_{\mathcal{F}}$ to its dual space $%
\mathcal{H}_{\mathcal{F}}^{d}$ determined by the basis $\left( \mathbf{\Psi }%
\right) $ of $\mathcal{H}_{\mathcal{F}}$ is given by 
\begin{equation}
\digamma _{\left\vert \Psi \right\rangle }:\mathcal{H}_{\mathcal{F}%
}\rightarrow \mathcal{H}_{\mathcal{F}}^{d}
\end{equation}%
where%
\begin{equation}
\digamma _{\left\vert \Psi \right\rangle }\left( \left\vert \varphi
\right\rangle \right) =\left\langle \varphi \right\vert .
\end{equation}

\item Any vector belonging to $\mathcal{H}_{\mathcal{F}}$ can be expanded as 
\begin{equation}
\left\vert \varphi \right\rangle =\left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle & \cdots & \left\vert \Psi
_{2^{r}}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) _{2^{r}}%
\end{array}%
\right) \equiv \left( 
\begin{array}{ccc}
\Psi _{1} & \cdots & \Psi _{2^{r}}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) _{2^{r}}%
\end{array}%
\right) .
\end{equation}

\item Any vector belonging to $\mathcal{H}_{\mathcal{F}}^{d}$ can be
expanded as%
\begin{equation}
\varphi ^{d}=\left( 
\begin{array}{ccc}
\Psi _{1}^{d} & \cdots & \Psi _{2^{r}}^{d}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\Psi ^{d}}\left( \varphi \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\Psi ^{d}}\left( \varphi \right) _{2^{r}}%
\end{array}%
\right)
\end{equation}%
and its action on $\mathcal{H}_{\mathcal{F}}$ via the map $\digamma
_{\left\vert \Psi \right\rangle }$ by 
\begin{equation}
\digamma _{\left\vert \Psi \right\rangle }\left( \left\vert \varphi
\right\rangle \right) =\left\langle \varphi \right\vert =\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{\left\langle \Psi \right\vert }\left( \varphi \right)
_{1}} & \cdots & \overline{\mathcal{R}_{\left\langle \Psi \right\vert
}\left( \varphi \right) _{2^{r}}}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle \Psi _{1}\right\vert \\ 
\vdots \\ 
\left\langle \Psi _{2^{r}}\right\vert%
\end{array}%
\right) .
\end{equation}

\item Hence 
\begin{gather}
f_{\psi }\left( \varphi \right) =\left\langle \psi \right\vert \left\vert
\varphi \right\rangle =\left\langle \left. \psi \right\vert \varphi
\right\rangle =\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{\left\langle \Psi \right\vert }\left( \psi \right)
_{1}} & \cdots & \overline{\mathcal{R}_{\left\langle \Psi \right\vert
}\left( \psi \right) _{2^{r}}}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle \Psi _{1}\right\vert \\ 
\vdots \\ 
\left\langle \Psi _{2^{r}}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle & \cdots & \left\vert \Psi
_{2^{r}}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) _{2^{r}}%
\end{array}%
\right) \\
=\mathcal{R}_{\left\langle \Psi \right\vert }\left( \psi \right) ^{\dagger
}\left\langle \left. \mathbf{\Psi }\right\vert \mathbf{\Psi }\right\rangle 
\mathcal{R}_{\left\vert \Psi \right\rangle }\left( \varphi \right) .
\end{gather}
\end{enumerate}
\end{remark}

\begin{lemma}
Any operator $X\in \mathcal{B}_{00}\left( \mathcal{H}_{\mathcal{F}}\right) $
can be expanded as 
\begin{equation}
X=\left( 
\begin{array}{ccc}
\left\vert \Psi _{1}\right\rangle & \cdots & \left\vert \Psi
_{2^{r}}\right\rangle%
\end{array}%
\right) \mathcal{R}_{\left\vert \Psi \right\rangle }\left( X\right) \left( 
\begin{array}{c}
\left\langle \Psi _{1}\right\vert \\ 
\vdots \\ 
\left\langle \Psi _{2^{r}}\right\vert%
\end{array}%
\right) =\sum_{1\leq j,k\leq r}\left\vert \Psi _{j}\right\rangle \mathcal{R}%
_{\left\vert \Psi \right\rangle }\left( X\right) _{jk}\left\langle \Psi
_{k}\right\vert =\sum_{1\leq j,k\leq r}\left\vert \Psi _{j}\right\rangle
\left\langle \Psi _{k}\right\vert \mathcal{R}_{\left\vert \Psi \right\rangle
}\left( X\right) _{jk},
\end{equation}%
hence 
\begin{equation}
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{jk}=\mathcal{R}_{\left\vert \Psi \right\rangle }\left(
X\right) _{jk},\quad 1\leq j,k\leq r.
\end{equation}
\end{lemma}

\begin{example}
The action of the dual space $\mathcal{B}_{1}\left( \mathcal{H}_{\mathcal{F}%
}\right) ^{d}=\mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) $ on the
space $\mathcal{B}_{1}\left( \mathcal{H}_{\mathcal{F}}\right) $ is given by 
\begin{eqnarray}
f_{Y}\left( X\right) &=&\func{Tr}\left\{ Y^{\dagger }X\right\} =\sum_{1\leq
j,k\leq r}\left( \mathcal{R}_{\left\vert \Psi \right\rangle }\left( Y\right)
\right) _{jk}^{\dagger }\mathcal{R}_{\left\vert \Psi \right\rangle }\left(
X\right) _{kj}=\sum_{1\leq j,k\leq r}\overline{\mathcal{R}_{\left\vert \Psi
\right\rangle }\left( Y\right) _{kj}}\mathcal{R}_{\left\vert \Psi
\right\rangle }\left( X\right) _{kj} \\
&=&\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi
\right\vert }\left( Y\right) _{11}} & \cdots & \overline{\mathcal{R}%
_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert }\left(
Y\right) _{2^{r}2^{r}}}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{2^{r}2^{r}}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{c}
\overline{\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi
\right\vert }\left( Y\right) _{11}} \\ 
\vdots \\ 
\overline{\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi
\right\vert }\left( Y\right) _{2^{r}2^{r}}}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert
}\left( X\right) _{2^{r}2^{r}}%
\end{array}%
\right) =\overline{\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle
\Psi \right\vert }\left( Y\right) }^{t}\mathcal{R}_{\left\vert \Psi
\right\rangle \left\langle \Psi \right\vert }\left( X\right) =\mathcal{R}%
_{\left\vert \Psi \right\rangle \left\langle \Psi \right\vert }\left(
Y\right) ^{\dagger }\mathcal{R}_{\left\vert \Psi \right\rangle \left\langle
\Psi \right\vert }\left( X\right) ,
\end{eqnarray}%
where 
\begin{equation}
\dagger \,=\dagger \,_{\mathcal{B}\left( \mathcal{H}_{\mathcal{F}}\right) }.
\end{equation}
\end{example}

\begin{definition}
Operator Valued Maps:

\begin{enumerate}
\item Operator valued map $\Xi _{WV}$ from the tensor product space $%
W\otimes V$ to $\mathcal{B}_{00}\left( W,V\right) $ 
\begin{equation}
\Xi _{WV}:W\otimes V\rightarrow \mathcal{B}_{00}\left( W,V\right)
\end{equation}%
by%
\begin{equation}
\Xi _{WV}\left( b_{WV}\right) =\sum_{1\leq j,k\leq m}\left[ e_{j}e_{k}^{d}%
\right] \mathcal{R}_{ee}\left( \Xi _{WV}\left( b_{WV}\right) \right) _{jk}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{example}
\begin{equation}
\Xi _{WV}\left( w_{j}\otimes v_{k}\right) \left( x\right)
=w_{j}v_{k}^{d}\left( x\right)
\end{equation}
\end{example}

\begin{example}
\begin{equation}
\Xi _{\mathcal{FF}}\left( \left\vert \Psi _{j}\right\rangle \left\langle
\Psi _{k}\right\vert \otimes \left\vert \Psi _{p}\right\rangle \left\langle
\Psi _{q}\right\vert \right) \left( X\right) =\left\vert \Psi
_{j}\right\rangle \left\langle \Psi _{k}\right\vert \left( \left\vert \Psi
_{p}\right\rangle \left\langle \Psi _{q}\right\vert \left( X\right) \right)
=\left\vert \Psi _{j}\right\rangle \left\langle \Psi _{k}\right\vert 
\limfunc{Tr}\nolimits_{\mathcal{F}}\left\{ \left( \left\vert \Psi
_{p}\right\rangle \left\langle \Psi _{q}\right\vert \right) ^{\dagger
}X\right\} =\left\vert \Psi _{j}\right\rangle \left\langle \Psi
_{k}\right\vert \limfunc{Tr}\nolimits_{\mathcal{F}}\left\{ \left\vert \Psi
_{q}\right\rangle \left\langle \Psi _{p}\right\vert X\right\}
\end{equation}
\end{example}

