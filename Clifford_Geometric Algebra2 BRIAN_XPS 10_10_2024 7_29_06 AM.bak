\item $4-$subsitutions:%
\begin{equation}
\binom{4}{4}^{2}=1
\end{equation}%
\begin{equation}
56781234
\end{equation}
\end{enumerate}

One can consider the special case $r=4$ the number of subscripts that have
one values in common are 
\begin{equation}
\binom{8}{4}\binom{8-4}{3}=70\ast 4=280
\end{equation}%
e.g.%
\begin{align}
&
12341567,12351467,12361457,12371456,12451367,12461357,12471356,12561347,12571346,12671356,
\notag \\
& 13451267,13461257,13471256,13561247,13571246,13671245,  \notag \\
& 14561237,14571236,14671235,  \notag \\
& 15671234.
\end{align}%
the coefficients are%
\begin{align}
& \left(
A_{1234}A_{1567}-A_{1235}A_{1467}+A_{1236}A_{1457}-A_{1237}A_{1456}+A_{1245}A_{1367}-A_{1246}A_{1357}+A_{1247}A_{1356}-A_{1256}A_{1347}\right.
\notag \\
&
-A_{1257}A_{1346}+A_{1267}A_{1345}-A_{1345}A_{1267}+A_{1346}A_{1257}-A_{1347}A_{1256}-A_{1356}A_{1247}+A_{1357}A_{1246}-A_{1367}A_{1245}
\notag \\
& \left.
+A_{1456}A_{1237}-A_{1457}A_{1236}+A_{1467}A_{1235}-A_{1567}A_{1234}\right)
x_{2}\wedge x_{3}\wedge x_{4}\wedge x_{5}\wedge x_{6}\wedge x_{7}.
\end{align}%
So it seems that this term cancels.

One can consider the special case $r=4$ the number of subscripts that have
two values in common are 
\begin{equation}
\binom{8}{4}\binom{8-4}{2}=70\ast12=840
\end{equation}
e.g.%
\begin{equation}
12341256,12351246,12361245,12451236,12461235,12561234.
\end{equation}
the coefficients are given by%
\begin{align}
& A_{1234}A_{1256}x_{3}\wedge x_{4}\wedge x_{5}\wedge x_{6} \\
& A_{1235}A_{1246}x_{3}\wedge x_{5}\wedge x_{4}\wedge x_{6} \\
& A_{1236}A_{1245}x_{3}\wedge x_{6}\wedge x_{4}\wedge x_{5} \\
& A_{1245}A_{1236}x_{4}\wedge x_{5}\wedge x_{3}\wedge x_{6} \\
& A_{1246}A_{1235}x_{4}\wedge x_{6}\wedge x_{3}\wedge x_{5} \\
& A_{1256}A_{1234}x_{5}\wedge x_{6}\wedge x_{3}\wedge x_{4}
\end{align}
which gives on reordering%
\begin{align}
& A_{1234}A_{1256}x_{3}\wedge x_{4}\wedge x_{5}\wedge
x_{6}-A_{1235}A_{1246}x_{3}\wedge x_{4}\wedge x_{5}\wedge
x_{6}+A_{1236}A_{1245}x_{3}\wedge x_{4}\wedge x_{5}\wedge x_{6} \\
& +A_{1245}A_{1236}x_{3}\wedge x_{4}\wedge x_{5}\wedge
x_{6}-A_{1246}A_{1235}x_{3}\wedge x_{4}\wedge x_{5}\wedge
x_{6}+A_{1256}A_{1234}x_{3}\wedge x_{4}\wedge x_{5}\wedge x_{6}
\end{align}%
\begin{equation}
=2\left( A_{1234}A_{1256}-A_{1235}A_{1246}+A_{1236}A_{1245}\right)
x_{3}\wedge x_{4}\wedge x_{5}\wedge x_{6}
\end{equation}
which in general is non zero.

One can consider the special case $r=4$ the subscripts that have three
values in common are 
\begin{equation}
\binom{8}{4}\binom{8-4}{1}=70\ast4=280
\end{equation}
e.g.%
\begin{align}
& 12341235,12341236,12341237,12341238,12351234,12351236,12351237,12351238, \\
& 12361234,12361235,12361237,12361238,12371238,
\end{align}
the coefficients are 
\begin{equation}
A_{1234}A_{1235}-A_{1235}A_{1234}+A_{1234}A_{1236}-A_{1236}A_{1234}+A_{1234}A_{1235}-A_{1235}A_{1234}\cdots.
\end{equation}
So it seems that this term cancels.

One can consider the special case $r=4$ the number of subscripts that have
four values in common are 
\begin{equation}
\binom{8}{4}\binom{8-4}{0}=70\ast1=70
\end{equation}%
\begin{equation}
12341234+12351235+\cdots.
\end{equation}

\subsubsection{Self Adjoint Idempotents i.e. Projections.}

In order that idempotents describe projections and be positive they must be
self adjoint. This induces further constriants on the preceeding conditions.
This gives%
\begin{align}
A_{0}& =A_{0}^{\dagger }\Rightarrow \alpha =\overline{\alpha }\Rightarrow
\alpha \in \mathbb{R} \\
A_{2}& =A_{2}^{\dagger }=\sum_{1\leq j_{1}<j_{2}\leq
2r}A_{2j_{1}j_{2}}x_{j_{1}}x_{j_{2}}=-\sum_{1\leq j_{1}<j_{2}\leq 2r}%
\overline{A}_{2j_{1}j_{2}}x_{j_{1}}x_{j_{2}}\Rightarrow \mathbb{A}_{2}=-%
\overline{\mathbb{A}}_{2}\Rightarrow \mathbb{A}_{2} \\
& =i\func{Im}\left\{ \mathbb{A}_{2}\right\} \,\,\&\,\,\,\mathbb{A}_{2}=%
\mathbb{A}_{2}^{t};\,\,\mathbb{A}_{2}\in \mathbb{R}^{2r} \\
A_{4}& =A_{4}^{\dagger }=\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq
2r}A_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=\sum_{1\leq
j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}\overline{A}%
_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{4}}x_{j_{3}}x_{j_{2}}x_{j_{1}} \\
& =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}\overline{A}%
_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}\Rightarrow 
\mathbb{A}_{4}\in \mathbb{R}^{4r^{2}}.
\end{align}

\section{Geometric Algebra II}

The operator and Clifford products in $\mathcal{F}=\mathcal{B}\left( 
\mathcal{H}_{\mathcal{F}}\right) $ are the same and are also known as the 
\emph{geometric product. }Thus $\mathcal{F}$ can be thought of as an
operator algebra, Clifford algebra or Geometric algebra. The product of two
grade 1 operators (vectors) 
\begin{equation}
a=\sum_{1\leq j\leq2r}\alpha_{j}x_{j}\text{ and }\,b=\sum_{1\leq
j\leq2r}\beta_{j}x_{j}
\end{equation}
is given by 
\begin{align}
ab & =\sum_{1\leq j,k\leq2r}\alpha_{j}\beta_{k}x_{j}x_{k}=\sum_{1\leq
j\leq2r}\alpha_{j}\beta_{j}x_{j}^{2}+\sum_{1\leq j\neq
k\leq2r}\alpha_{j}\beta_{k}x_{j}x_{k}  \notag \\
& =\frac{1}{2}\sum_{1\leq j\leq2r}\alpha_{j}\beta_{j}+\sum_{1\leq j<k\leq
2r}\left( \alpha_{j}\beta_{k}-\alpha_{k}\beta_{j}\right) x_{j}x_{k}  \notag
\\
& =\frac{1}{2}\left( \left. a\right\vert b\right) +a\wedge b
\end{align}
and the product $ab$ expressed in this fashion is called the \emph{geometric
product }of the \emph{vectors} $a$ and $b.$ The products $\left\langle
\left. a\right\vert b\right\rangle $ and $a\wedge b$ can be expressed or
defined by 
\begin{equation*}
\left( \left. a\right\vert b\right) =\frac{1}{2}\left( ab+ba\right) =\frac{1%
}{2}\left\{ a,b\right\} ,
\end{equation*}
which is $\mathbb{C}$-symmetric and 
\begin{equation*}
a\wedge b=\frac{1}{2}\left( ab-ba\right) =\frac{1}{2}\left[ a,b\right] .
\end{equation*}

\subsection{Degree of Operators}

$N$-degree operators are defined to be $N^{th}$ degree polynomials in the
generators of the Clifford algebra and are of the form 
\begin{equation}
A_{N}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq M\leq N}\sum_{1\leq
j_{1}<\cdots<j_{M}\leq2r}\alpha_{Mj_{1}\cdots j_{M}}x_{j_{1}}\cdots x_{j_{M}}
\end{equation}
and grade $N$ operators are homogeneous of degree $N$ i.e. 
\begin{equation}
B_{N}=\sum_{1\leq j_{1}<\cdots<j_{N}\leq2r}\alpha_{Nj_{1}\cdots
j_{N}}x_{j_{1}}\cdots x_{j_{N}}.
\end{equation}

\emph{Blades} are outer $\equiv$ wedge products of vectors, while \emph{%
versors} are geometric product of vectors.

\subsubsection{First Degree Operators}

First degree operators are first degree polynomials in the generators of the
Clifford algebra 
\begin{equation}
A_{1}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq2r}\alpha_{1j}x_{j},  \notag
\end{equation}
these are also called \emph{para vectors}.

Grade 1 operators are homogeneous of degree 1 and can be expressed in terms
of a non a self adjoint basis as 
\begin{align}
A_{1} & =\sum_{1\leq j\leq2r}\alpha_{j}x_{j}=\sum_{1\leq j\leq r}\left\{
\alpha_{j}x_{j}+\alpha_{j+r}x_{j+r}\right\} =\sum_{1\leq j\leq r}\left\{
\alpha_{j}\left( a_{j}^{\dagger}+a_{j}\right) +\alpha_{j+r}i\left(
a_{j}^{\dagger}-a_{j}\right) \right\}  \notag \\
& =\sum_{1\leq j\leq r}\left\{
\alpha_{j}a_{j}^{\dagger}+\alpha_{j}a_{j}+i\alpha_{j+r}a_{j}^{\dagger}-i%
\alpha_{j+r}a_{j}\right\} =\sum_{1\leq j\leq r}\left\{ \left(
\alpha_{j}+i\alpha_{j+r}\right) a_{j}^{\dagger }+\left(
\alpha_{j}-i\alpha_{j+r}\right) a_{j}\right\} .
\end{align}
If $A_{1}$ is self adjoint then 
\begin{equation}
A_{1}=\sum_{1\leq j\leq r}\left\{ \left( \alpha_{j}+i\alpha_{j+r}\right)
a_{j}^{\dagger}+\left( \alpha_{j}-i\alpha_{j+r}\right) a_{j}\right\}
=\sum_{1\leq j\leq r}\left\{ z_{j}a_{j}^{\dagger}+\overline{z}%
_{j}a_{j}\right\} ,
\end{equation}
where 
\begin{equation}
z_{j}=\left( \alpha_{j}+i\alpha_{j+r}\right)
\end{equation}
if not 
\begin{equation}
A_{1}=\sum_{1\leq j\leq r}\left\{ z_{1j}a_{j}^{\dagger}+z_{2j}a_{j}\right\} ,
\end{equation}
where 
\begin{align}
z_{1j} & =\alpha_{j}+i\alpha_{j+r} \\
z_{2j} & =\alpha_{j}-i\alpha_{j+r}.
\end{align}

\subsubsection{Second Degree Operators}

Second degree operators are second degree polynomials in the generators of
the Clifford algebra 
\begin{equation}
A_{2}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq
j\leq2r}\alpha_{1j}x_{j}+\sum_{1\leq j<k\leq2r}\alpha_{2jk}x_{j}x_{k}. 
\notag
\end{equation}
Homogeneous second degree operators of degree 2 can be expressed in terms of
a non self adjoint basis as 
\begin{align}
A_{2} & =\sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}  \notag \\
& =2\sum_{1\leq j<k\leq r}\left( \alpha_{jk}-\alpha_{kj}\right) \left(
a_{j}^{\dagger}+a_{j}\right) \left( a_{k}^{\dagger}+a_{k}\right) +  \notag \\
& +i\sum_{1\leq j\leq r,r+1\leq k\leq2r}\left( \alpha_{jk}-\alpha
_{kj}\right) \left( a_{j}^{\dagger}+a_{j}\right) \left( a_{k}^{\dagger
}-a_{k}\right) -2\sum_{r+1\leq j<k\leq2r}\left( \alpha_{jk}-\alpha
_{kj}\right) \left( a_{j}^{\dagger}-a_{j}\right) \left( a_{k}^{\dagger
}-a_{k}\right)  \notag \\
& =2\sum_{1\leq j<k\leq r}\left( \alpha_{jk}-\alpha_{kj}\right) \left(
a_{j}^{\dagger}a_{k}^{\dagger}+a_{j}^{\dagger}a_{k}+a_{j}a_{k}^{%
\dagger}+a_{j}a_{k}\right)  \notag \\
& +i\sum_{1\leq j\leq r,r+1\leq k\leq2r}\left( \alpha_{jk}-\alpha
_{kj}\right) \left(
a_{j}^{\dagger}a_{k}^{\dagger}-a_{j}^{\dagger}a_{k}+a_{j}a_{k}^{%
\dagger}-a_{j}a_{k}\right)  \notag \\
& -2\sum_{r+1\leq j<k\leq2r}\left( \alpha_{jk}-\alpha_{kj}\right) \left(
a_{j}^{\dagger}a_{k}^{\dagger}-a_{j}^{\dagger}a_{k}-a_{j}a_{k}^{%
\dagger}+a_{j}a_{k}\right) .
\end{align}
Grade $2$ operators are homogeneous of degree $2$ i.e. 
\begin{equation}
A_{2}=\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}}x_{j_{1}}x_{j_{2}}.
\end{equation}

\section{Lie Algebra}

The algebra $\mathcal{A}$ becomes a Lie algebra under the commutator product 
$\left[ ,\right] $ i.e. 
\begin{equation}
\left[ A,B\right] =AB-BA.
\end{equation}
Commutator closed subspaces of $\mathcal{A}$ are also Lie algebras, but may
not be subalgebras of $\mathcal{A}.$

The \emph{complex} subspace, $\mathcal{A}_{0}^{\bot },$ of \emph{traceless}
elements of $\mathcal{A}$ is a closed under Lie products as is the \emph{%
real }subspace , $\mathcal{A}_{skew},$ of \emph{skew adjoint} elements of $%
\mathcal{A}.$

\section{Jordan Algebras (Euclidean=Formally Real)}

The set of self adjoint operators, $\mathcal{A}_{sa},$ is a real subspace of 
$\mathcal{A},$ however it is not a subalgebra. In order to overcome this one
can introduce the Jordan product $\left\{ ,\right\} \equiv \,"\ast "$ by 
\begin{equation}
A\ast B=\frac{1}{2}\left\{ A,B\right\} \text{ }\forall A,B\in \mathcal{A}%
_{sa}.
\end{equation}%
Equipped with this product $\mathcal{A}_{sa}$ becomes a \emph{Special} \emph{%
Jordan} algebra $\mathfrak{h}_{\mathcal{A}}\left( \mathbb{R}\right) =\left\{ 
\mathcal{A}_{sa},\ast \right\} $ which is \emph{non associative, but
commutative\thinspace \thinspace }$\equiv \,$\emph{Abelian }i.e. in general%
\begin{equation}
A\ast \left( B\ast C\right) \neq \left( A\ast B\right) \ast C
\end{equation}%
but 
\begin{equation}
A\ast B=B\ast A.
\end{equation}

\begin{example}
\begin{equation}
x_{1}\ast x_{2}=\frac{1}{2}\left( x_{1}x_{2}+x_{2}x_{1}\right) =0
\end{equation}%
and%
\begin{eqnarray}
\left( x_{1}\ast x_{2}\right) \ast x_{2} &=&0 \\
x_{1}\ast \left( x_{2}\ast x_{2}\right) &=&x_{1}\ast \left( I_{\mathcal{H}_{%
\mathcal{F}}}\right) =x_{1}.
\end{eqnarray}
\end{example}

\begin{example}
The basis elements $ix_{1}x_{2}$ and $ix_{3}x_{4}$ are self adjoint 
\begin{eqnarray}
\left( ix_{1}x_{2}\right) ^{\dagger } &=&-ix_{2}x_{1}=ix_{1}x_{2} \\
\left( ix_{3}x_{4}\right) ^{\dagger } &=&-ix_{4}x_{3}=ix_{3}x_{4}
\end{eqnarray}%
and their Jordan product is self adjoint 
\begin{eqnarray}
\left( ix_{1}x_{2}\right) \ast \left( ix_{3}x_{4}\right) &=&\frac{1}{2}%
\left( \left( ix_{1}x_{2}\right) \left( ix_{3}x_{4}\right) +\left(
ix_{3}x_{4}\right) \left( ix_{1}x_{2}\right) \right) =-\frac{1}{2}\left(
\left( x_{1}x_{2}\right) \left( x_{3}x_{4}\right) +\left( x_{3}x_{4}\right)
\left( x_{1}x_{2}\right) \right) \\
&=&-\frac{1}{2}\left( x_{1}x_{2}x_{3}x_{4}+x_{1}x_{2}x_{3}x_{4}\right)
=-x_{1}x_{2}x_{3}x_{4}\text{ } \\
\text{i.e. }\left( ix_{1}x_{2}\right) \ast \left( ix_{3}x_{4}\right)
&=&-x_{1}x_{2}x_{3}x_{4}
\end{eqnarray}%
as 
\begin{equation}
\left( x_{1}x_{2}x_{3}x_{4}\right) ^{\dagger
}=x_{4}x_{3}x_{2}x_{1}=-x_{1}x_{4}x_{3}x_{2}=-x_{1}x_{2}x_{4}x_{3}=x_{1}x_{2}x_{3}x_{4}.
\end{equation}
\end{example}

\begin{remark}
If the Jordan algebra is contained in an associative algebra 
\begin{equation}
A\ast B=\frac{1}{2}\left( \left( A+B\right) ^{2}-\left( A-B\right)
^{2}\right) =\frac{1}{2}\left( A^{2}+AB+BA+B^{2}-A^{2}+AB+BA-B^{2}\right) =%
\frac{1}{2}\left( AB+BA\right) .
\end{equation}
\end{remark}

\begin{lemma}
The Jordan product is linear i.e. disttributive%
\begin{equation}
A\ast \left( B+C\right) =A\ast B+A\ast C
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
A\ast \left( B+C\right) =\frac{1}{2}\left( A\left( B+C\right) +\left(
B+C\right) A\right) =\frac{1}{2}\left( AB+AC+BA+CA\right) =\frac{1}{2}\left(
AB+BA+AC+CA\right) =A\ast B+A\ast C.
\end{equation}
\end{proof}

\begin{remark}
The Clifford and Jordan products are different 
\begin{eqnarray}
x_{1}x_{2} &\neq &x_{1}\ast x_{2} \\
\left( ix_{1}x_{2}\right) \left( ix_{3}x_{4}\right) &\neq &\left(
ix_{1}x_{2}\right) \ast \left( ix_{3}x_{4}\right) .
\end{eqnarray}
\end{remark}

\begin{axiom}
Formally a \emph{Jordan algebra} satisfies the axioms
\end{axiom}

\begin{enumerate}
\item Commutivity%
\begin{equation}
A\ast B=B\ast A
\end{equation}

\item Jordan Identity%
\begin{equation}
A^{2}\ast \left( B\ast A\right) =\left( A^{2}\ast B\right) \ast A
\end{equation}
\end{enumerate}

\begin{definition}
A Jordan algebra is \emph{formally real\thinspace \thinspace }$\equiv \,$%
\emph{Euclidean} if 
\begin{equation}
\sum_{1\leq j\leq p}A_{j}^{2}=0\Rightarrow A_{1}=A_{2}=\cdots =A_{p}=0.
\end{equation}
\end{definition}

\begin{lemma}
Every formally real Jordan algebra is \emph{Power Associative i.e. every sub}%
algebra generated by any element $X\in \mathfrak{h}_{\mathcal{A}}\left( 
\mathbb{R}\right) $ is $\ast $-associative.
\end{lemma}

\begin{remark}
If a Jordan algebra is formally real the Jordan identity implies power
associativity i.e. 
\begin{equation}
A^{m}\ast A^{n}=A^{m+n}.
\end{equation}
\end{remark}

\begin{definition}
The positive cone in a Jordan algebra e.g. $\mathfrak{h}_{\mathcal{A}}\left( 
\mathbb{R}\right) $ is defined by 
\begin{equation}
\mathcal{C}_{\mathfrak{h}_{\mathcal{A}}\left( \mathbb{R}\right) }=\left\{
\left. X=A^{2\ast }=A\ast A\right\vert X\in \mathfrak{h}_{\mathcal{A}}\left( 
\mathbb{R}\right) \right\} .
\end{equation}
\end{definition}

\subsubsection{Bases for Jordan Algebras}

\begin{remark}
Inversion in the Clifford algebra $\mathcal{A}$ is defined by the
permutations 
\begin{equation}
\sigma :\left\{ 1,\cdots ,n-1,n\right\} \rightarrow \left\{ n,n-1,\cdots
,1\right\} ,
\end{equation}%
which can be expressed in terms of transpositions as
\end{remark}

\begin{eqnarray}
12 &\rightarrow &21\  \\
123 &\rightarrow &132\rightarrow 312\rightarrow 321 \\
1234 &\rightarrow &1243\rightarrow 1423\rightarrow 4123\rightarrow
4132\rightarrow 4312\rightarrow 4321 \\
12345 &\rightarrow &12354\rightarrow \ 12534\rightarrow 15234\rightarrow
51234\rightarrow 51243\rightarrow 1423\rightarrow 4123\rightarrow
4132\rightarrow 4312\rightarrow 4321 \\
123456 &\rightarrow &123465\rightarrow 123645\rightarrow 126345\rightarrow
162345\rightarrow 612345\rightarrow 612354 \\
&\rightarrow &\ 12534\rightarrow 15234\rightarrow 51234\rightarrow
51243\rightarrow 1423\rightarrow 4123\rightarrow 4132\rightarrow
4312\rightarrow 4321 \\
1234567 &\rightarrow &1234576\rightarrow 1234756\rightarrow
1237456\rightarrow 1273456\rightarrow 1723456\rightarrow 7123456 \\
&\rightarrow &7123465\rightarrow 7123645\rightarrow 7126345\rightarrow
7162345\rightarrow 7612345 \\
&\rightarrow &7612354\rightarrow \ 7612534\rightarrow 7615234\rightarrow
7651234\rightarrow 7651243 \\
&\rightarrow &7651423\rightarrow 7654123\rightarrow 7654132\rightarrow
7654312\rightarrow 7654321,
\end{eqnarray}

which leads to the parities $\pi \left( \sigma \right) $ $=\divideontimes $
of transpositions $\times $ $\left( -1\right) $ 
\begin{equation}
\begin{array}{cccc}
n & \text{starting sequence} & \pi \left( \sigma \right) =\left( -1\right) ^{%
\frac{n\left( n-1\right) }{2}}=i^{n\left( n-1\right) } & \divideontimes 
\text{ of transpositions} \\ 
1 & \left( 1\right) & \left( -1\right) ^{0}=1 & 0\text{\quad even} \\ 
2 & \left( 1,2\right) & \left( -1\right) ^{1}=-1 & 1\text{\quad odd} \\ 
3 & \left( 1,2,3\right) & \left( -1\right) ^{3}=-1 & 3\text{\quad odd} \\ 
4 & \left( 1,2,3,4\right) & \left( -1\right) ^{6}=1 & 6\text{\quad even} \\ 
5 & \left( 1,2,3,4,5\right) & \left( -1\right) ^{10}=1 & 10\text{\quad even}
\\ 
6 & \left( 1,2,3,4,5,6\right) & \left( -1\right) ^{15}=-1 & 15\text{\quad odd%
} \\ 
7 & \left( 1,2,3,4,5,6,7\right) & \left( -1\right) ^{21}=-1. & 21\text{\quad
odd}%
\end{array}%
\end{equation}%
where we have used the

\begin{lemma}
\begin{equation}
\left( -1\right) ^{\frac{\alpha }{2}}=\left( -i\right) ^{\alpha },\,\alpha
\in \mathbb{R}.
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
\left( -1\right) ^{\frac{\alpha }{2}}=\left( i^{2}\right) ^{\frac{\alpha }{2}%
}=i^{\alpha }.
\end{equation}
\end{proof}

\begin{corollary}
\begin{equation}
i^{n\left( n-1\right) }=\left( -1\right) ^{\frac{n\left( n-1\right) }{2}}.
\end{equation}
\end{corollary}

\begin{corollary}
\begin{equation}
\left( i^{m}\right) ^{\dagger }=i^{-m}
\end{equation}
\end{corollary}

\begin{proof}
\begin{equation}
i^{\dagger }=-i=i^{-1}
\end{equation}%
and 
\begin{equation}
\overset{m}{\overbrace{i^{\dagger }\cdots i^{\dagger }}}\,=\,\overset{m}{%
\overbrace{i^{-1}\cdots i^{-1}}}\,=i^{-m}.
\end{equation}
\end{proof}

\begin{remark}
The products $x_{j_{1}}\cdots x_{j_{n}}$ 
\begin{equation}
x_{j_{1}}\cdots x_{j_{n}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{2}%
}x_{j_{n}}\cdots x_{j_{1}}=\left( i^{2}\right) ^{\frac{n\left( n-1\right) }{2%
}}x_{j_{n}}\cdots x_{j_{1}}=i^{n\left( n-1\right) }x_{j_{n}}\cdots x_{j_{1}}
\end{equation}%
are symmetric or antisymmetric.

\begin{enumerate}
\item If $\left( x_{j_{1}}\cdots x_{j_{n}}\right) $ is symmetric it is self
adjoint,

\item if it is antisymmetric then $\left( ix_{j_{1}}\cdots x_{j_{n}}\right) $
is self adjoint.

\item The adjoint of $x_{j_{1}}\cdots x_{j_{n}}$ is given by 
\begin{equation}
\left( x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger }=x_{j_{n}}\cdots
x_{j_{1}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{n}}=i^{n\left( n-1\right) }x_{j_{1}}\cdots x_{j_{n}}.
\end{equation}

\item \emph{If }$\left( -1\right) ^{\frac{n\left( n-1\right) }{2}%
}=i^{n\left( n-1\right) }=+1$\emph{\ then }$x_{j_{1}}\cdots x_{j_{n}}$\emph{%
\ is self adjoint, }

\item \emph{while if }$\left( -1\right) ^{\frac{n\left( n-1\right) }{2}%
}=i^{n\left( n-1\right) }=-1$\emph{\ then }$ix_{j_{1}}\cdots x_{j_{n}}$\emph{%
\ is self adjoint.}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{eqnarray}
i\left( -i\right) &=&1 \\
i^{-1} &=&-i
\end{eqnarray}%
gives%
\begin{equation}
\left( i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots x_{j_{n}}\right)
^{\dagger }=\left( -i\right) ^{\frac{n\left( n-1\right) }{2}}\left(
x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger }=i^{-\frac{n\left( n-1\right) }{2%
}}\left( x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger }=i^{-\frac{n\left(
n-1\right) }{2}}i^{n\left( n-1\right) }x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{%
n\left( n-1\right) }{2}}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
\end{remark}

\begin{example}
$n=5$%
\begin{eqnarray}
\left( x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}\right) ^{\dagger }
&=&x_{j_{5}}x_{j_{4}}x_{j_{3}}x_{j_{2}}x_{j_{1}}=x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}
\\
i^{10}x_{j_{1}}\cdots x_{j_{5}} &=&-x_{j_{1}}\cdots x_{j_{5}} \\
\left( -x_{j_{1}}\cdots x_{j_{5}}\right) ^{\dagger }
&=&-x_{j_{5}}x_{j_{4}}x_{j_{3}}x_{j_{2}}x_{j_{1}}=-x_{j_{3}}x_{j_{2}}x_{j_{5}}x_{j_{4}}x_{j_{1}}=-x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}
\end{eqnarray}
\end{example}

\begin{example}
Powers of $i$%
\begin{eqnarray}
i^{0} &=&\left( \left( -1\right) ^{\frac{1}{2}}\right) ^{0}=1 \\
i^{1} &=&i \\
i^{3} &=&\left( -1\right) i=-i \\
i^{6} &=&\left( i^{2}\right) ^{3}=\left( -1\right) ^{3}=-1 \\
i^{10} &=&\left( i^{2}\right) ^{5}=\left( -1\right) ^{5}=-1 \\
i^{15} &=&\left( i^{2}\right) ^{7}\left( i\right) =\left( -1\right)
^{7}\left( i\right) =-i \\
i^{21} &=&\left( i^{2}\right) ^{10}\left( i\right) =\left( -1\right)
^{10}\left( i\right) =i
\end{eqnarray}%
gives 
\begin{equation}
\begin{array}{c}
\begin{array}{cccccc}
n & i^{\frac{n\left( n-1\right) }{2}} & \left( -1\right) ^{\frac{n\left(
n-1\right) }{4}} & i^{\frac{n\left( n-1\right) }{2}} & \binom{n}{2}= & \text{%
Type } \\ 
1 & i^{\frac{1\left( 1-1\right) }{2}}=i^{0} & 1 & \left( \left( -1\right) ^{%
\frac{1}{2}}\right) ^{0}=1 & \binom{1}{2}=0 & x_{j_{1}}\quad \text{ self
adjoint} \\ 
2 & i^{\frac{2\left( 2-1\right) }{2}}=i^{1} & i & \left( \left( -1\right) ^{%
\frac{1}{2}}\right) ^{1}=i & \binom{2}{2}=1 & ix_{j_{1}}x_{j_{2}}\quad \text{%
odd = self adjoint} \\ 
3 & i^{\frac{3\left( 3-1\right) }{2}}=i^{3} & -i & \left( \left( -1\right) ^{%
\frac{1}{2}}\right) ^{3}=\left( -1\right) \left( -1\right) ^{\frac{1}{2}}=-i
& \binom{3}{2}=3 & -ix_{j_{1}}\cdots x_{j_{3}}\quad \text{odd = self adjoint}
\\ 
4 & i^{\frac{4\left( 4-1\right) }{2}}=i^{6} & -1 & \left( -1\right) \left(
-1\right) \left( -1\right) =-1 & \binom{4}{2}=6 & -x_{j_{1}}\cdots
x_{j_{4}}\quad \text{even = self adjoint} \\ 
5 & i^{\frac{5\left( 5-1\right) }{2}}=i^{10} & -1 & \left( -1\right) \left(
-1\right) \left( -1\right) \left( -1\right) \left( -1\right) =-1 & \binom{5}{%
2}=10 & -x_{j_{1}}\cdots x_{j_{5}}\quad \text{even = self adjoint} \\ 
6 & i^{\frac{6\left( 6-1\right) }{2}}=i^{15} & -i & \left( -1\right) \left(
-1\right) \left( -1\right) \left( -1\right) \left( -1\right) \left(
-1\right) \left( -1\right) \left( -1\right) ^{\frac{1}{2}}=-i & \binom{6}{2}%
=15 & -ix_{j_{1}}\cdots x_{j_{6}}\quad \text{odd = self adjoint} \\ 
7 & i^{\frac{7\left( 7-1\right) }{2}}=i^{21} & i. & \left( -1\right) \left(
-1\right) \left( -1\right) \left( -1\right) \left( -1\right) \left(
-1\right) \left( -1\right) \left( -1\right) \left( -1\right) \left(
-1\right) \left( -1\right) ^{\frac{1}{2}}=i & \binom{7}{2}=21 & 
ix_{j_{1}}\cdots x_{j_{7}}\quad \text{odd = self adjoint}%
\end{array}%
\end{array}%
,
\end{equation}
\end{example}

\begin{example}
The values of the $i^{n\left( n-1\right) }=\left( -1\right) ^{\frac{n\left(
n-1\right) }{2}}$ factor for $n=1,\cdots ,7$ 
\begin{equation}
\begin{array}{c}
\begin{array}{cccccc}
n & i^{n\left( n-1\right) } & \left( -1\right) ^{\frac{n\left( n-1\right) }{2%
}} & \sqrt{\left( -1\right) ^{\frac{n\left( n-1\right) }{2}}} & \binom{n}{2}
& \text{Type } \\ 
1 & i^{1\left( 1-1\right) }=i^{0} & 1 & \left( 1\right) ^{\frac{1}{2}}=1 & 
\binom{1}{2}=0 & \left( i^{0}\right) ^{\frac{1}{2}}x_{j_{1}}=x_{j_{1}}\quad 
\text{even = self adjoint} \\ 
2 & i^{2\left( 2-1\right) }=i^{2} & -1 & \left( -1\right) ^{\frac{1}{2}}=i & 
\binom{2}{2}=1 & \left( i^{2}\right) ^{\frac{1}{2}%
}x_{j_{1}}x_{j_{2}}=ix_{j_{1}}x_{j_{2}}\quad \text{odd = self adjoint} \\ 
3 & i^{3\left( 3-1\right) }=i^{6} & -1 & \left( -1\right) ^{\frac{1}{2}}=i & 
\binom{3}{2}=3 & \left( i^{6}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots
x_{j_{3}}=-ix_{j_{1}}\cdots x_{j_{3}}\quad \text{odd = self adjoint} \\ 
4 & i^{4\left( 4-1\right) }=i^{12} & 1 & \left( 1\right) ^{\frac{1}{2}}=1 & 
\binom{4}{2}=6 & \left( i^{12}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots
x_{j_{4}}=x_{j_{1}}\cdots x_{j_{4}}\quad \text{even = self adjoint} \\ 
5 & i^{5\left( 5-1\right) }=i^{20} & 1 & \left( 1\right) ^{\frac{1}{2}}=1 & 
\binom{5}{2}=10 & \left( i^{20}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots
x_{j_{5}}=x_{j_{1}}\cdots x_{j_{5}}\quad \text{even = self adjoint} \\ 
6 & i^{6\left( 6-1\right) }=i^{30} & -1 & \left( -1\right) ^{\frac{1}{2}}=i
& \binom{6}{2}=15 & \left( i^{30}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots
x_{j_{6}}=ix_{j_{1}}\cdots x_{j_{6}}\quad \text{odd = self adjoint} \\ 
7 & i^{7\left( 7-1\right) }=i^{42} & -1. & \left( -1\right) ^{\frac{1}{2}}=i
& \binom{7}{2}=21 & \left( i^{42}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots
x_{j_{7}}=ix_{j_{1}}\cdots x_{j_{7}}\quad \text{odd = self adjoint}%
\end{array}%
\end{array}%
,
\end{equation}
\end{example}

\begin{definition}
Self adjoint Clifford products of self adjoint Clifford algebra generators
form a basis for \emph{both} the Clifford and Jordan algebras%
\begin{equation}
X_{j_{1}\cdots j_{n}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{4}%
}x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{n}};\quad 0\leq n\leq 2r,\,1\leq j_{1}<\cdots <j_{n}\leq 2r.
\end{equation}
\end{definition}

\begin{remark}
These products are not Jordan products.
\end{remark}

\begin{lemma}
The operators 
\begin{equation}
X_{j_{1}\cdots j_{n}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{4}%
}x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{n}};\,0\leq n\leq 2r,1\leq j_{1}<\cdots <j_{n}\leq 2r
\end{equation}%
are self adjoint i.e. 
\begin{equation}
X_{j_{1}\cdots j_{n}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{4}%
}x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{n}}=X_{j_{1}\cdots j_{n}}^{\dagger }.
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
X_{j_{1}\cdots j_{n}}^{\dagger }=\left( i^{\frac{n\left( n-1\right) }{2}%
}x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger }=i^{-\frac{n\left( n-1\right) }{%
2}}x_{j_{1}}\cdots x_{j_{n}}=i^{-\frac{n\left( n-1\right) }{2}}i^{n\left(
n-1\right) }x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{n\left( n-1\right) }{2}%
}x_{j_{1}}\cdots x_{j_{n}}=X_{j_{1}\cdots j_{n}}.
\end{equation}
\end{proof}

\begin{lemma}
The self adjoint operators 
\begin{equation}
X_{j_{1}\cdots j_{n}}=\left( -1\right) ^{\frac{n\left( n-1\right) }{4}%
}x_{j_{1}}\cdots x_{j_{n}}=i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots
x_{j_{n}};\,0\leq n\leq 2r,1\leq j_{1}<\cdots <j_{n}\leq 2r
\end{equation}%
forms a \emph{self adjoint} basis $\left\{ \left. X_{j_{1}\cdots
j_{n}}\right\vert 0\leq n\leq 2r,1\leq j_{1}<\cdots <j_{n}\leq 2r\right\} $
of $\mathcal{A}.$
\end{lemma}

\begin{proof}
From above 
\begin{equation}
i^{\frac{n\left( n-1\right) }{2}}x_{j_{1}}\cdots x_{j_{n}}=\left\{ 
\begin{array}{c}
\left( i^{0}\right) ^{\frac{1}{2}}x_{j_{1}}\quad \\ 
\left( i^{2}\right) ^{\frac{1}{2}}x_{j_{1}}x_{j_{2}}\quad \\ 
\left( i^{6}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots x_{j_{3}}\quad \\ 
\left( i^{12}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots x_{j_{4}}\quad \\ 
\left( i^{20}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots x_{j_{5}}\quad \\ 
\left( i^{30}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots x_{j_{6}}\quad \\ 
\left( i^{42}\right) ^{\frac{1}{2}}x_{j_{1}}\cdots x_{j_{7}}%
\end{array}%
=%
\begin{array}{c}
x_{j_{1}} \\ 
ix_{j_{1}}x_{j_{2}} \\ 
-ix_{j_{1}}\cdots x_{j_{3}} \\ 
-x_{j_{1}}\cdots x_{j_{4}} \\ 
-x_{j_{1}}\cdots x_{j_{5}} \\ 
-ix_{j_{1}}\cdots x_{j_{6}} \\ 
ix_{j_{1}}\cdots x_{j_{7}}%
\end{array}%
\right. =%
\begin{array}{c}
x_{j_{1}}^{\dagger } \\ 
\left( ix_{j_{1}}x_{j_{2}}\right) ^{\dagger
}=-ix_{j_{2}}x_{j_{1}}=ix_{j_{1}}x_{j_{2}} \\ 
\left( -ix_{j_{1}}\cdots x_{j_{3}}\right) ^{\dagger }=-ix_{j_{3}}\cdots
x_{j_{1}}=-ix_{j_{1}}\cdots x_{j_{3}} \\ 
\left( -x_{j_{1}}\cdots x_{j_{4}}\right) ^{\dagger }=-x_{j_{4}}\cdots
x_{j_{1}}=-x_{j_{1}}\cdots x_{j_{4}} \\ 
\left( -x_{j_{1}}\cdots x_{j_{5}}\right) ^{\dagger }=-x_{j_{5}}\cdots
x_{j_{1}}=-x_{j_{1}}\cdots x_{j_{5}} \\ 
\left( -ix_{j_{1}}\cdots x_{j_{6}}\right) ^{\dagger }=ix_{j_{6}}\cdots
x_{j_{1}}=-ix_{j_{1}}\cdots x_{j_{6}} \\ 
\left( ix_{j_{1}}\cdots x_{j_{7}}\right) ^{\dagger }=-ix_{j_{7}}\cdots
x_{j_{1}}=ix_{j_{1}}\cdots x_{j_{7}}%
\end{array}%
.
\end{equation}%
etc..
\end{proof}

\begin{remark}
\begin{eqnarray}
\frac{1}{2}\left( e^{i\theta }+e^{-i\theta }\right) &=&\frac{1}{2}\left(
\cos \theta +i\sin \theta +\cos \theta -i\sin \theta \right) =\cos \theta \\
e^{i\theta } &=&\cos \theta +i\sin \theta
\end{eqnarray}%
hence%
\begin{eqnarray}
e^{i0} &=&1 \\
e^{i\frac{\pi }{2}} &=&i \\
e^{i\pi } &=&-1 \\
e^{i\frac{3\pi }{2}} &=&-i \\
e^{i2\pi } &=&1.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{eqnarray}
\cos \theta &=&\frac{1}{2}\left( e^{i\theta }+e^{-i\theta }\right) \\
\sin \theta &=&\frac{1}{2}\left( e^{i\theta }-e^{-i\theta }\right) .
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{equation}
e^{i\frac{\pi }{2}\frac{n\left( n-1\right) }{2}}=\exp i\left\{ \frac{n\left(
n-1\right) \pi }{4}\right\} =i^{\frac{n\left( n-1\right) }{2}}.
\end{equation}
\end{remark}

\begin{example}
$\ $The factor $i^{\frac{n\left( n-1\right) }{2}}$ 
\begin{eqnarray}
X_{j_{1}} &=&\widetilde{x}_{j_{1}}=i^{0}\widetilde{x}_{j_{1}}=\widetilde{x}%
_{j_{1}} \\
X_{j_{1}j_{2}} &=&i^{1}\widetilde{x}_{j_{1}}\widetilde{x}_{j_{2}}=i%
\widetilde{x}_{j_{1}}\widetilde{x}_{j_{2}} \\
X_{j_{1}\cdots j_{3}} &=&i^{3}\widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{3}}=-i\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{3}} \\
X_{j_{1}\cdots j_{4}} &=&i^{6}\widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{4}}=-\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{4}} \\
X_{j_{1}\cdots j_{5}} &=&i^{10}\widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{5}}=-\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{5}} \\
X_{j_{1}\cdots j_{6}} &=&i^{15}\widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{6}}=-i\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{6}} \\
X_{j_{1}\cdots j_{7}} &=&i^{21}\widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{7}}=i\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{7}}.
\end{eqnarray}
\end{example}

\begin{proof}
\begin{example}
$r=2$%
\begin{equation}
I_{\mathcal{A}%
},X_{1},X_{2},X_{3},X_{4},X_{12},X_{13},X_{14},X_{23},X_{24},X_{34},X_{123},X_{124},X_{134},X_{234},X_{1234}.
\end{equation}
\end{example}
\end{proof}

\begin{remark}
The \emph{self adjoint} basis $\left\{ \left. X_{j_{1}\cdots
j_{n}}\right\vert 0\leq n\leq 2r,1\leq j_{1}<\cdots <j_{n}\leq 2r\right\} $
of $\mathcal{A}$ is generated by the generators $\left\{ I_{\mathcal{A}%
},\left\{ \left. \widetilde{x}_{j_{1}}\right\vert 1\leq j_{1}\leq 2r\right\}
\right\} $ of the Clifford/CAR algebra $\mathcal{A}.$
\end{remark}

\begin{remark}
\emph{The basis }$\left\{ \left. X_{j_{1}\cdots j_{n}}\right\vert 0\leq
n\leq 2r,1\leq j_{1}<\cdots <j_{n}\leq 2r\right\} $\emph{\ is also a basis
of the real Jordan algebra }$h_{\mathcal{A}}\left( \mathbb{R}\right)
=\left\{ \mathcal{A}_{sa},\ast \right\} \cong h_{\mathcal{F}}\left( \mathbb{R%
}\right) \cong h_{2^{2r}}\left( \mathbb{R}\right) ,$\emph{\ where }$X_{0}=I_{%
\mathcal{A}}$\emph{\ is the multiplicative unit in both }$A$\emph{\ and }$h_{%
\mathcal{A}}\left( \mathbb{R}\right) $\emph{.}
\end{remark}

\begin{remark}
As $\mathcal{A}$ is a Clifford/CAR algebra one has the following Jordan
relationships between the generators 
\begin{align}
\widetilde{x}_{j_{1}}\ast \widetilde{x}_{j_{2}}& =\frac{1}{2}\delta
_{j_{1}j_{2}}I_{\mathcal{A}}=\widetilde{x}_{j_{2}}\ast \widetilde{x}_{j_{1}}
\\
\widetilde{x}_{j_{1}}\ast \widetilde{x}_{j_{2}}& =0\,\,\text{for }j_{1}\neq
j_{2} \\
v_{1}\ast v_{2}& =\frac{1}{2}\left( \left. v_{1}\right\vert v_{2}\right) I_{%
\mathcal{A}};\,v_{1},v_{2}\in \mathcal{A}_{1sa} \\
v_{1}\ast \left( v_{2}\ast v_{3}\right) & =v_{1}\ast \left( v_{3}\ast
v_{2}\right) =\left( v_{3}\ast v_{2}\right) \ast v_{1}=\frac{1}{2}\left(
\left. v_{2}\right\vert v_{3}\right) v_{1} \\
\left( v_{1}\ast v_{2}\right) \ast v_{3}& =\left( v_{2}\ast v_{1}\right)
\ast v_{3}=v_{3}\ast \left( v_{2}\ast v_{1}\right) =\frac{1}{2}\left( \left.
v_{1}\right\vert v_{2}\right) v_{3}.
\end{align}
\end{remark}

\begin{remark}
The paravectors form a Euclidean \emph{sub} Jordan algebra.
\end{remark}

\begin{remark}
Different basis elements of first degree are orthogonal wrt the Jordan
product 
\begin{equation}
\widetilde{x}_{1}\ast \widetilde{x}_{2}=\frac{1}{2}\left( \widetilde{x}_{1}%
\widetilde{x}_{2}+\widetilde{x}_{2}\widetilde{x}_{1}\right) =0
\end{equation}%
and are involutions 
\begin{equation}
\widetilde{x}_{1}\ast \widetilde{x}_{1}=\frac{1}{2}\left( \widetilde{x}_{1}%
\widetilde{x}_{1}+\widetilde{x}_{1}\widetilde{x}_{1}\right) =\frac{1}{2}%
\left( \frac{1}{2}+\frac{1}{2}\right) =I_{\mathcal{F}}.
\end{equation}
\end{remark}

\begin{remark}
The higher grade normalized Jordan basis elements are involutions or anti
involutions.
\end{remark}

\begin{remark}
The higher grade Jordan basis elements can be decomposed in terms of Jordan
products of lower grade basis elements i.e. 
\begin{eqnarray}
\left( i\widetilde{x}_{1}\widetilde{x}_{2}\right) \ast \left( i\widetilde{x}%
_{3}\widetilde{x}_{4}\right) &=&\frac{1}{2}\left( \left( i\widetilde{x}_{1}%
\widetilde{x}_{2}\right) \left( i\widetilde{x}_{3}\widetilde{x}_{4}\right)
+\left( i\widetilde{x}_{3}\widetilde{x}_{4}\right) \left( i\widetilde{x}_{1}%
\widetilde{x}_{2}\right) \right) =-\frac{1}{2}\left( \left( \widetilde{x}_{1}%
\widetilde{x}_{2}\right) \left( \widetilde{x}_{3}\widetilde{x}_{4}\right)
+\left( \widetilde{x}_{1}\widetilde{x}_{2}\right) \left( \widetilde{x}_{3}%
\widetilde{x}_{4}\right) \right) =-\widetilde{x}_{1}\widetilde{x}_{2}%
\widetilde{x}_{3}\widetilde{x}_{4} \\
X_{1234} &=&i^{\frac{12}{2}}\widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}%
_{3}\widetilde{x}_{4}=i^{6}\widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}%
_{3}\widetilde{x}_{4}=\left( -1\right) \widetilde{x}_{1}\widetilde{x}_{2}%
\widetilde{x}_{3}\widetilde{x}_{4}=-\widetilde{x}_{1}\widetilde{x}_{2}%
\widetilde{x}_{3}\widetilde{x}_{4}.
\end{eqnarray}
\end{remark}

\begin{remark}
The Jordan product of two Jordan basis elements is self adjoint 
\begin{align}
\left( i\widetilde{x}_{1}\widetilde{x}_{2}\right) \ast \left( i\widetilde{x}%
_{3}\widetilde{x}_{4}\right) & =\frac{1}{2}\left( i\widetilde{x}_{1}%
\widetilde{x}_{2}i\widetilde{x}_{3}\widetilde{x}_{4}+i\widetilde{x}_{3}%
\widetilde{x}_{4}i\widetilde{x}_{1}\widetilde{x}_{2}\right) =-\frac{1}{2}%
\left( \widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}_{3}\widetilde{x}_{4}+%
\widetilde{x}_{4}\widetilde{x}_{3}\widetilde{x}_{2}\widetilde{x}_{1}\right)
\\
\left( \left( i\widetilde{x}_{1}\widetilde{x}_{2}\right) \ast \left( i%
\widetilde{x}_{3}\widetilde{x}_{4}\right) \right) ^{\dagger }& =-\frac{1}{2}%
\left( \widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}_{3}\widetilde{x}_{4}+%
\widetilde{x}_{3}\widetilde{x}_{4}\widetilde{x}_{1}\widetilde{x}_{2}\right)
^{\dagger }=-\frac{1}{2}\left( \widetilde{x}_{4}\widetilde{x}_{3}\widetilde{x%
}_{2}\widetilde{x}_{1}+\widetilde{x}_{2}\widetilde{x}_{1}\widetilde{x}_{4}%
\widetilde{x}_{3}\right) \\
& =-\frac{1}{2}\left( \widetilde{x}_{4}\widetilde{x}_{3}\widetilde{x}_{2}%
\widetilde{x}_{1}+\widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}_{3}%
\widetilde{x}_{4}\right) =\left( i\widetilde{x}_{1}\widetilde{x}_{2}\right)
\ast \left( i\widetilde{x}_{3}\widetilde{x}_{4}\right) .
\end{align}
\end{remark}

\begin{theorem}
A Jordan basis of $\mathfrak{h}_{\mathcal{A}}\left( \mathbb{R}\right) $ is
generated by Jordan products of $\left\{ \left. \widetilde{x}_{j_{1}},i%
\widetilde{x}_{j_{1}}\widetilde{x}_{j_{2}}\right\vert 1\leq j_{1}<j_{2}\leq
2r\right\} $
\end{theorem}

\begin{proof}
\begin{equation}
\widetilde{x}_{1}\ast \left( i\widetilde{x}_{2}\widetilde{x}_{3}\right) =%
\frac{i}{2}\left( \widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}_{3}+%
\widetilde{x}_{2}\widetilde{x}_{3}\widetilde{x}_{1}\right) =i\widetilde{x}%
_{1}\widetilde{x}_{2}\widetilde{x}_{3}=X_{123}
\end{equation}%
$\lceil $%
\begin{equation}
\left( i\widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}_{3}\right) ^{\dagger
}=-i\widetilde{x}_{3}\widetilde{x}_{2}\widetilde{x}_{1}=i\widetilde{x}_{1}%
\widetilde{x}_{2}\widetilde{x}_{3}
\end{equation}%
$\rfloor $%
\begin{equation}
\left( i\widetilde{x}_{1}\widetilde{x}_{2}\right) \ast \left( i\widetilde{x}%
_{3}\widetilde{x}_{4}\right) =X_{12}\ast X_{34}=\frac{1}{2}\left( i%
\widetilde{x}_{1}\widetilde{x}_{2}i\widetilde{x}_{3}\widetilde{x}_{4}+i%
\widetilde{x}_{3}\widetilde{x}_{4}i\widetilde{x}_{1}\widetilde{x}_{2}\right)
=-\frac{1}{2}\left( \widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}_{3}%
\widetilde{x}_{4}+\widetilde{x}_{4}\widetilde{x}_{3}\widetilde{x}_{2}%
\widetilde{x}_{1}\right) =-\widetilde{x}_{1}\widetilde{x}_{2}\widetilde{x}%
_{3}\widetilde{x}_{4}=-X_{1234}.
\end{equation}
\end{proof}

