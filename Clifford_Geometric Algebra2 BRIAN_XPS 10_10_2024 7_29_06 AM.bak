ix_{j_{1}+r}x_{j_{2}}x_{j_{3}+r}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{3}+r}x_{j_{1}+r}\right\}
\end{align*}%
\begin{align*}
-& \frac{1}{16}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda
_{2j_{1}j_{2}j_{1}j_{3}}\left\{
x_{j_{1}}x_{j_{2}}x_{j_{1}}x_{j_{3}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{1}}x_{j_{3}}%
