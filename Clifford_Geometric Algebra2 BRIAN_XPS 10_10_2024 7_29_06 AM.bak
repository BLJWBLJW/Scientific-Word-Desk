\begin{theorem}
$A_{4}\wedge A_{4}=0$ Iff $A_{4}=\dsum \limits_{1\leq
j<k<l<m\leq7}A_{4jklm}e_{jklm}$

\begin{proof}
The if part is easy as 
\begin{equation}
\left\{ ijkl\right\} \cap \left\{ mnop\right\} \neq \phi
\end{equation}%
for this range of subscripts thus the products 
\begin{equation}
e_{jklm}\wedge e_{mnop}=0\forall \left\{ i,j,k,l,m,n,o,p\right\} \in \left\{
1,2,3,4,5,6,7\right\} .
\end{equation}
\end{proof}
\end{theorem}

The only if part: Let 
\begin{equation}
A_{4}\wedge A_{4}=0
\end{equation}
and 
\begin{equation}
A_{4}=\dsum\limits_{1\leq j<k<l<m\leq
8}A_{4jklm}e_{jklm}thenf_{12345678}\left( \mathbb{A}_{4}\right) =0.
\end{equation}

This can easily be shown to be possible, let 
\begin{equation}
f_{12345678}\left( \mathbb{A}_{4}\right)
=A_{1}A_{70}-A_{2}A_{69}=0\Leftrightarrow
A_{1}A_{70}=A_{2}A_{69}\Leftrightarrow \frac{A_{1}}{A_{2}}=\frac{A_{69}}{%
A_{70}}=\alpha ,
\end{equation}%
where

\begin{align}
A_{4}& =A_{1}e_{1234}+A_{2}e_{1235}+A_{69}e_{4678}+A_{70}e_{5678} \\
& =\alpha A_{2}e_{1234}+A_{2}e_{1235}+\alpha A_{69}e_{4678}+A_{69}e_{5678} \\
& =A_{2}\left( \alpha e_{1234}+e_{1235}\right) +A_{69}\left( \alpha
e_{4678}+e_{5678}\right)
\end{align}%
and%
\begin{align}
& \left( \overset{}{}A_{2}\left( \alpha e_{1234}+e_{1235}\right)
+A_{69}\left( \alpha e_{4678}+e_{5678}\right) \right) \wedge \left( \overset{%
}{}A_{2}\left( \alpha e_{1234}+e_{1235}\right) +A_{69}\left( \alpha
e_{4678}+e_{5678}\right) \right) \\
& =\alpha A_{2}e_{1234}\wedge A_{69}e_{5678}+A_{2}e_{1235}\wedge
A_{69}\alpha e_{4678}+A_{69}\alpha e_{4678}\wedge
A_{2}e_{1235}+A_{69}e_{5678}\wedge \alpha A_{2}e_{1234} \\
& =\alpha A_{2}A_{69}e_{1234}\wedge e_{5678}+\alpha
A_{2}A_{69}e_{1235}\wedge e_{4678}+\alpha A_{69}A_{2}e_{4678}\wedge
e_{1235}+\alpha A_{2}A_{69}e_{5678}\wedge e_{1234} \\
& =2\alpha A_{2}A_{69}\left( e_{1234}\wedge e_{5678}+e_{1235}\wedge
e_{4678}\right) =2\alpha A_{2}A_{69}\left( e_{12345678}-e_{12345678}\right)
=0.
\end{align}

\begin{remark}
Unlike the tensor algebra the Clifford algebra is \emph{not }$\mathbb{Z}$%
\emph{-graded}, since two vectors can multiply to a scalar. Nevertheless it
is $\mathbb{Z}_{2}$-graded, and this $\mathbb{Z}_{2}$-grading is important.
We can define an algebra automorphism $\U{3bb} $ on $Cl(Q)$ by taking%
\begin{equation}
\U{3bb} (v)=-v,v\in V
\end{equation}%
and extending this to be an algebra automorphism.
\end{remark}

