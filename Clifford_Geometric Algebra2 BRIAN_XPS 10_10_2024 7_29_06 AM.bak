\begin{example}
$r=1,$

The map $\Xi _{\mathcal{\wedge }\left( \mathbb{C}^{r}\right) \mathcal{\wedge 
}\left( \mathbb{C}^{r}\right) }$ acts in the tensor product space $\mathcal{M%
}\left( 2^{1},2^{1},\mathbb{C}\right) \otimes \mathcal{M}\left( 2^{1},2^{1},%
\mathbb{C}\right) $ to produce operators belonging to $\mathcal{B}\left( 
\mathcal{M}\left( 2,2,\mathbb{C}\right) \right) $ i.e. $\mathcal{M}\left(
4,4,\mathbb{C}\right) .$ The row vector of bases vectors of $\mathcal{M}%
\left( 2,2,\mathbb{C}\right) $ belong to $\mathcal{M}\left( 1,4,\mathcal{M}%
\left( 2,2,\mathbb{C}\right) \right) :$

\begin{enumerate}
\item The tensor product of row vectors of bases elements of $\mathcal{M}%
\left( 2^{1},2^{1},\mathbb{C}\right) $ have the following structure 
\begin{gather}
\left( \mathcal{M}\left( 1,2^{2},\mathcal{M}\left( 2^{1},2^{1},\mathbb{C}%
\right) \right) \otimes \mathcal{M}\left( 1,2^{2},\mathcal{M}\left(
2^{1},2^{1},\mathbb{C}\right) \right) \right) \subset \mathcal{M}\left(
2^{4},2^{4},\mathbb{C}\right) \\
\shortparallel \\
\left( \mathcal{M}\left( 1,4,\mathcal{M}\left( 2,2,\mathbb{C}\right) \right)
\otimes \mathcal{M}\left( 1,4,\mathcal{M}\left( 2,2,\mathbb{C}\right)
\right) \right) \subset \mathcal{M}\left( 16,16,\mathbb{C}\right) .
\end{gather}

\item The matrix space $\mathcal{M}\left( 2,2,\mathbb{C}\right) $ can be
considered as representations of $\mathcal{B}\left( \mathbb{C}^{2}\right) $
generated from a row vector $\mathbf{E}=\left\{ \left. E_{jk}\right\vert
1\leq j,k\leq 2\right\} $ belonging to $\mathcal{M}\left( 1,2^{2},\mathcal{M}%
\left( 2^{1},2^{1},\mathbb{C}\right) \right) =\mathcal{M}\left( 1,4,\mathcal{%
M}\left( 2,2,\mathbb{C}\right) \right) $ of basis vectors $\left\{ \left.
E_{jk}\right\vert 1\leq j,k\leq 2\right\} $ of $\mathcal{B}\left( \mathbb{C}%
^{2}\right) $ i.e. 
\begin{gather}
\left\{ \mathcal{R}_{E}\left( Z\right) =\left\{ \left. \left( 
\begin{array}{cc}
\mathcal{R}_{E}\left( Z\right) _{11} & \mathcal{R}_{E}\left( Z\right) _{12}
\\ 
\mathcal{R}_{E}\left( Z\right) _{21} & \mathcal{R}_{E}\left( Z\right) _{22}%
\end{array}%
\right) \right\vert \mathcal{R}_{E}\left( Z\right) _{11},\mathcal{R}%
_{E}\left( Z\right) _{12},\mathcal{R}_{E}\left( Z\right) _{21},\mathcal{R}%
_{E}\left( Z\right) _{22}\in \mathbb{C}\right\} \right\} \\
\parallel \\
\left( \overset{}{\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
1 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) }\right) \left( 
\begin{array}{c}
\mathcal{R}_{EE}\left( Z\right) _{11} \\ 
\mathcal{R}_{EE}\left( Z\right) _{12} \\ 
\mathcal{R}_{EE}\left( Z\right) _{21} \\ 
\mathcal{R}_{EE}\left( Z\right) _{22}%
\end{array}%
\right) \\
\parallel \\
\left( \overset{}{\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
1 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) }\right) \mathcal{R}_{EE}\left( Z\right) .
\end{gather}

\begin{notation}
The element $Z\in \mathcal{B}\left( \mathbb{C}^{2}\right) $ represented as a 
\emph{vector} wrt the basis 
\begin{eqnarray}
\mathbf{E} &=&\left\{ \left. E_{jk}\right\vert 1\leq j,k\leq 2\right\}
=\left\{ \left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
1 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) \right\} \\
&=&\left\{ \left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) ,\left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) ,\left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) ,\left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) \right\}
\end{eqnarray}%
of $\mathcal{B}\left( \mathbb{C}^{2}\right) $ is 
\begin{equation}
\mathcal{R}_{EE}\left( Z\right) \equiv \mathcal{R}_{E\otimes E}\left(
Z\right) =\left( 
\begin{array}{c}
\mathcal{R}_{EE}\left( Z\right) _{11} \\ 
\mathcal{R}_{EE}\left( Z\right) _{12} \\ 
\mathcal{R}_{EE}\left( Z\right) _{21} \\ 
\mathcal{R}_{EE}\left( Z\right) _{22}%
\end{array}%
\right) ,
\end{equation}%
while the element $Z\in \mathcal{B}\left( \mathbb{C}^{2}\right) $
represented as a \emph{matrix} wrt the basis 
\begin{equation}
\mathbf{e}=\left\{ \left. e_{j}\right\vert 1\leq j\leq 2\right\} =\left\{
\left( 
\begin{array}{c}
1 \\ 
0%
\end{array}%
\right) ,\left( 
\begin{array}{c}
0 \\ 
1%
\end{array}%
\right) \right\}
\end{equation}%
of $\mathbb{C}^{2}$ is%
\begin{equation}
\mathcal{R}_{E}\left( Z\right) =\left( 
\begin{array}{cc}
\mathcal{R}_{E}\left( Z\right) _{11} & \mathcal{R}_{E}\left( Z\right) _{12}
\\ 
\mathcal{R}_{E}\left( Z\right) _{21} & \mathcal{R}_{E}\left( Z\right) _{22}%
\end{array}%
\right) ,
\end{equation}%
where%
\begin{equation}
Z\left( e_{1},e_{2}\right) =\left( e_{1},e_{2}\right) \mathcal{R}_{E}\left(
Z\right) .
\end{equation}
\end{notation}

\item The tensor product of row vectors of bases vectors of $\mathcal{M}%
\left( 2,2,\mathbb{C}\right) $ is 
\begin{equation}
\left( \left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
1 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) \right) \otimes \left( \left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 1 \\ 
0 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
1 & 0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & 0 \\ 
0 & 1%
\end{array}%
\right) \right) .
\end{equation}

\item The first element $\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 0%
\end{array}%
\right) $ produces the products, which are the first $4$ elements of the row
vector of the basis row vector of the tensor product space 
\begin{gather}
\left( 
\begin{array}{cc}
