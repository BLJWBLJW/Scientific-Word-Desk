\end{eqnarray}
\end{example}

\appendix{}

\section{Change of Basis}

\begin{enumerate}
\item 
\begin{eqnarray}
\left[ \left( \mathbf{f}\right) \left( \mathbf{e}^{d}\right) ^{t}\right]
\left( \mathbf{e}\right) &=&\left( \mathbf{f}\right) \\
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{n}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1}^{d} \\ 
\vdots \\ 
e_{n}^{d}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{n}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{n}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{n}%
\end{array}%
\right) \mathcal{R}_{e}\left( \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{n}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1}^{d} \\ 
\vdots \\ 
e_{n}^{d}%
\end{array}%
\right) \right) \\
&=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{n}%
\end{array}%
\right) \mathcal{R}_{e}\left( \sum_{1\leq j\leq n}f_{j}e_{j}^{d}\right)
\end{eqnarray}

\item 
\begin{eqnarray}
\mathcal{R}_{e}\left( \sum_{1\leq j\leq n}f_{j}e_{j}^{d}\right) &=&\left( 
\begin{array}{c}
e_{1}^{d} \\ 
\vdots \\ 
e_{n}^{d}%
\end{array}%
\right) \left( \sum_{1\leq j\leq n}f_{j}e_{j}^{d}\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{n}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e_{1}^{d} \\ 
\vdots \\ 
e_{n}^{d}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{n}%
\end{array}%
\right) \\
&=&\left( \mathbf{e}^{d}\right) ^{t}\left( \mathbf{f}\right) =\mathbf{e}%
^{dt}\left( \mathbf{f}\right) =\left( 
\begin{array}{ccc}
e_{1}^{d}\left( f_{1}\right) & \cdots & e_{1}^{d}\left( f_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{n}^{d}\left( f_{1}\right) & \cdots & e_{n}^{d}\left( f_{n}\right)%
\end{array}%
\right)
\end{eqnarray}

\item 
\begin{eqnarray}
A\left( \mathbf{e}\right) &=&\left( \mathbf{e}\right) \mathcal{R}_{e}\left(
A\right) =\left( \mathbf{e}\right) \left( \mathbf{e}^{dt}\left( A\left( 
\mathbf{e}\right) \right) \right) \\
A\left( \mathbf{f}\right) &=&\left( \mathbf{f}\right) \mathcal{R}_{f}\left(
A\right) =\left[ \left( \mathbf{f}\right) \left( \mathbf{e}^{d}\right) ^{t}%
\right] \left( \mathbf{e}\right) \mathcal{R}_{f}\left( A\right) =\left( 
\mathbf{e}\right) \mathcal{R}_{e}\left( \sum_{1\leq j\leq
n}f_{j}e_{j}^{d}\right) \mathcal{R}_{f}\left( A\right)
\end{eqnarray}

\begin{enumerate}
\item 
\begin{eqnarray}
A &=&\left( \mathbf{e}\right) \left( \mathbf{e}^{d}\right) ^{t}A\left( 
\mathbf{e}\right) \left( \mathbf{e}^{d}\right) ^{t}=\left( \mathbf{f}\right)
\left( \mathbf{f}^{d}\right) ^{t}A\left( \mathbf{f}\right) \left( \mathbf{f}%
^{d}\right) ^{t}=\left( \mathbf{e}\right) \left( \mathbf{e}^{d}\right)
^{t}A\left( \mathbf{f}\right) \left( \mathbf{f}^{d}\right) ^{t}=\left( 
\mathbf{f}\right) \left( \mathbf{f}^{d}\right) ^{t}A\left( \mathbf{e}\right)
\left( \mathbf{e}^{d}\right) ^{t} \\
&=&\left( \mathbf{e}\right) \left( \mathbf{e}^{dt}\left( A\left( \mathbf{e}%
\right) \right) \right) \left( \mathbf{e}^{d}\right) ^{t}=\left( \mathbf{f}%
\right) \left( \mathbf{f}^{dt}\left( A\left( \mathbf{f}\right) \right)
\right) \left( \mathbf{f}^{d}\right) ^{t}=\left( \mathbf{e}\right) \left( 
\mathbf{e}^{dt}\left( A\left( \mathbf{f}\right) \right) \right) \left( 
\mathbf{f}^{d}\right) ^{t}=\left( \mathbf{f}\right) \left( \mathbf{f}%
^{dt}\left( A\left( \mathbf{e}\right) \right) \right) \left( \mathbf{e}%
^{d}\right) ^{t}
\end{eqnarray}

\item 
\begin{eqnarray}
A &=&\left( \mathbf{e}\right) \left( \mathbf{e}^{dt}\left( \left( \mathbf{f}%
\right) \left( \mathbf{f}^{d}\right) ^{t}A\left( \mathbf{f}\right) \left( 
\mathbf{f}^{d}\right) ^{t}\left( \mathbf{e}\right) \right) \right) \left( 
\mathbf{e}^{d}\right) ^{t}=\left( \mathbf{f}\right) \left( \mathbf{f}%
^{dt}\left( \left( \mathbf{e}\right) \left( \mathbf{e}^{d}\right)
^{t}A\left( \mathbf{e}\right) \left( \mathbf{e}^{d}\right) ^{t}\left( 
\mathbf{f}\right) \right) \right) \left( \mathbf{f}^{d}\right) ^{t} \\
&=&\left( \mathbf{e}\right) \left( \mathbf{e}^{dt}\left( \mathbf{f}\right)
\left( \mathbf{f}^{d}\right) ^{t}A\left( \mathbf{f}\right) \left( \mathbf{f}%
^{d}\right) ^{t}\left( \mathbf{e}\right) \right) \left( \mathbf{e}%
^{d}\right) ^{t}=\left( \mathbf{f}\right) \left( \mathbf{f}^{dt}\left( 
\mathbf{e}\right) \left( \mathbf{e}^{d}\right) ^{t}A\left( \mathbf{e}\right)
\left( \mathbf{e}^{d}\right) ^{t}\left( \mathbf{f}\right) \right) \left( 
\mathbf{f}^{d}\right) ^{t} \\
&=&\left( \mathbf{e}\right) \left( \left[ \mathbf{e}^{dt}\left( \mathbf{f}%
\right) \right] \left( \mathbf{f}^{d}\right) ^{t}A\left( \mathbf{f}\right) %
\left[ \mathbf{f}^{dt}\left( \mathbf{e}\right) \right] \right) \left( 
\mathbf{e}^{d}\right) ^{t}=\left( \mathbf{f}\right) \left( \left[ \mathbf{f}%
^{dt}\left( \mathbf{e}\right) \right] \left( \mathbf{e}^{d}\right)
^{t}A\left( \mathbf{e}\right) \left[ \mathbf{e}^{dt}\left( \mathbf{f}\right) %
\right] \right) \left( \mathbf{f}^{d}\right) ^{t} \\
&=&\left( \mathbf{e}\right) \left( \left[ \mathbf{e}^{dt}\left( \mathbf{f}%
\right) \right] \mathcal{R}_{f}\left( A\right) \left[ \mathbf{f}^{dt}\left( 
\mathbf{e}\right) \right] \right) \left( \mathbf{e}^{d}\right) ^{t}=\left( 
\mathbf{f}\right) \left( \left[ \mathbf{f}^{dt}\left( \mathbf{e}\right) %
\right] \mathcal{R}_{e}\left( A\right) \left[ \mathbf{e}^{dt}\left( \mathbf{f%
}\right) \right] \right) \left( \mathbf{f}^{d}\right) ^{t} \\
&=&\left( \mathbf{e}\right) \mathcal{R}_{e}\left( A\right) \left( \mathbf{e}%
^{d}\right) ^{t}=\left( \mathbf{f}\right) \mathcal{R}_{f}\left( A\right)
\left( \mathbf{f}^{d}\right) ^{t}
\end{eqnarray}
\end{enumerate}

\item 
\begin{eqnarray}
\mathcal{R}_{e}\left( A\right) &=&\left[ \mathbf{e}^{dt}\left( \mathbf{f}%
\right) \right] \mathcal{R}_{f}\left( A\right) \left[ \mathbf{f}^{dt}\left( 
\mathbf{e}\right) \right] \\
\mathcal{R}_{f}\left( A\right) &=&\left[ \mathbf{f}^{dt}\left( \mathbf{e}%
\right) \right] \mathcal{R}_{e}\left( A\right) \left[ \mathbf{e}^{dt}\left( 
\mathbf{f}\right) \right]
\end{eqnarray}

\item 
\begin{eqnarray}
\left[ \mathbf{f}^{dt}\left( \mathbf{e}\right) \right] &=&\left[ \mathbf{e}%
^{dt}\left( \mathbf{f}\right) \right] ^{-1} \\
\left[ \mathbf{e}^{dt}\left( \mathbf{f}\right) \right] &=&\left[ \mathbf{f}%
^{dt}\left( \mathbf{e}\right) \right] ^{-1}
\end{eqnarray}
\end{enumerate}

