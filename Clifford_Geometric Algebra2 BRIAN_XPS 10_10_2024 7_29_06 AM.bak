\begin{remark}
$\mathcal{R}_{y}\left( L_{Y_{\kappa }\ast }\right) $ are all partial
isometries as 
\begin{equation}
\mathcal{R}_{y}\left( L_{Y_{\kappa }\ast }\right) ^{\dagger }\mathcal{R}%
_{y}\left( L_{Y_{\kappa }\ast }\right) =\left( \mathcal{R}_{y}\left(
L_{Y_{\kappa }\ast }\right) \right) ^{2}=P=P^{2}=P^{\dagger }.
\end{equation}
\end{remark}

\begin{remark}
Left Jordan multiplication is not an algebra homomorphism 
\begin{gather}
L_{A\ast }\left( XY\right) =\frac{1}{2}\left( AXY+XYA\right) \neq \\
L_{A\ast }\left( X\right) L_{A\ast }\left( Y\right) =\frac{1}{2}\left(
AX+XA\right) \frac{1}{2}\left( AY+YA\right) =\frac{1}{4}\left(
AXAX+AXYA+YAAX+XAYA\right)
\end{gather}%
nor a star mapping%
\begin{gather}
L_{A\ast }\left( X\right) ^{\dagger }=\left( \frac{1}{2}\left( AX+XA\right)
\right) ^{\dagger }=\frac{1}{2}\left( A^{\dagger }X^{\dagger }+X^{\dagger
}A^{\dagger }\right) \neq \\
L_{A\ast }\left( X^{\dagger }\right) =\frac{1}{2}\left( AX^{\dagger
}+X^{\dagger }A\right) .
\end{gather}
\end{remark}

\section{Two Particle Operators}

\textsc{(these do not have to be particle conserving operators so could be
better described as two Bogoliubon Operators). These are not homogeneous
polynomials when expressed in terms of }$\left\{ x_{j}\right\} $

\begin{remark}
\begin{align}
\frac{1}{\sqrt{2}}\left( x_{j}+ix_{j+r}\right) & =a_{j} \\
\frac{1}{\sqrt{2}}\left( x_{j}-ix_{j+r}\right) & =a_{j}^{\dagger }.
\end{align}
\end{remark}

One can first consider two particle operators of

\subsection{Decomposable Diagonal form}

These type of particle operators can be expanded as%
\begin{align}
\lambda _{2d}& =\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger }a_{j_{2}}a_{j_{1}}\mathcal{R}_{a}\left( \lambda
_{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}  \notag \\
& =\sum_{1\leq j_{1}<j_{2}\leq r}n_{j_{1}}n_{j_{2}}\mathcal{R}_{a}\left(
\lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}=\sum_{1\leq j_{1}<j_{2}\leq
r}\left( \frac{1}{2}I_{\mathcal{F}}+ix_{j_{1}}x_{j_{1}+r}\right) \left( 
\frac{1}{2}I_{\mathcal{F}}+ix_{j_{2}}x_{j_{2}+r}\right) \mathcal{R}%
_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}} \\
& =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\left(
x_{j_{1}}-ix_{j_{1}+r}\right) \left( x_{j_{2}}-ix_{j_{2}+r}\right) \left(
x_{j_{2}}+ix_{j_{2}+r}\right) \left( x_{j_{1}}+ix_{j_{1}+r}\right) \mathcal{R%
}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}  \notag \\
& =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\left(
x_{j_{1}}x_{j_{2}}-ix_{j_{1}+r}x_{j_{2}}-ix_{j_{1}}x_{j_{2}+r}-x_{j_{1}+r}x_{j_{2}+r}\right) \times \left( x_{j_{2}}x_{j_{1}}+ix_{j_{2}+r}x_{j_{1}}+ix_{j_{2}}x_{j_{1}+r}-x_{j_{2}+r}x_{j_{1}+r}\right) 
\mathcal{R}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}  \notag \\
& =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\left\{ {}\right.  \notag \\
&
+x_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}
\notag \\
&
+ix_{j_{1}}x_{j_{2}}x_{j_{2}+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}+r}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}}
\notag \\
&
+ix_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}}x_{j_{1}+r}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}+r}
\notag \\
& -\left.
x_{j_{1}}x_{j_{2}}x_{j_{2}+r}x_{j_{1}+r}+ix_{j_{1}+r}x_{j_{2}}x_{j_{2}+r}x_{j_{1}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}\right\} 
\mathcal{R}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}
\end{align}

\begin{enumerate}
\item The zeroth degree terms are%
\begin{gather}
\left\langle \lambda _{2d}\right\rangle _{0}  \notag \\
\parallel \\
\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\left\{
x_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}\right\} 
\mathcal{R}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}} \\
\parallel \\
\frac{1}{32}\sum_{1\leq j_{1},j_{2}\leq r}I_{\mathcal{F}}\mathcal{R}%
_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}} \\
\parallel \\
\frac{1}{32}I_{\mathcal{F}}\limfunc{Tr}\left\{ \mathcal{R}_{a}\left( \lambda
_{2d}\right) \right\}
\end{gather}

\item The second degree terms are 
\begin{gather*}
\left\langle \lambda _{2d}\right\rangle _{2}=\frac{1}{8}\sum_{1\leq
j_{1},j_{2}\leq r}\left\{
-ix_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}\right.
\\
+ix_{j_{1}}x_{j_{2}}x_{j_{2}+r}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}}+ix_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}
\\
-\left.
ix_{j_{1}+r}x_{j_{2}}x_{j_{2}+r}x_{j_{1}+r}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}\right\} 
\mathcal{R}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}} \\
\parallel
\end{gather*}%
\begin{gather}
\frac{1}{16}\sum_{1\leq j_{1},j_{2}\leq r}i\left(
-x_{j_{1}+r}x_{j_{1}}-x_{j_{2}+r}x_{j_{2}}+x_{j_{2}}x_{j_{2}+r}-x_{j_{1}+r}x_{j_{1}}+x_{j_{1}}x_{j_{1}+r}-x_{j_{2}+r}x_{j_{2}}-x_{j_{2}+r}x_{j_{2}}+x_{j_{1}}x_{j_{1}+r}\right) 
\mathcal{R}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}  \notag \\
\parallel \\
\frac{i}{2}\sum_{1\leq j_{1},j_{2}\leq r}x_{j_{1}}x_{j_{1}+r}\mathcal{R}%
_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}} \\
\parallel \\
\frac{i}{2}\sum_{1\leq j_{1}\leq r}L_{2}^{1}\left( \lambda _{2d}\right)
_{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r},
\end{gather}%
where the contraction operator is defined by 
\begin{equation}
\mathcal{R}_{a}\left( L_{2}^{1}\left( \lambda _{2d}\right) \right)
_{j_{1}j_{2}}=\sum_{1\leq j_{3}\leq r}\mathcal{R}_{a}\left( \lambda
_{2d}\right) _{j_{1}j_{3}j_{2}j_{3}}.
\end{equation}

\item The fourth degree terms are%
\begin{eqnarray*}
\left\langle \lambda _{2d}\right\rangle _{4} &=&-\frac{1}{8}\sum_{1\leq
j_{1},j_{2}\leq r}\left(
x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}\right) 
\mathcal{R}_{a}\left( \lambda _{2d}\right) _{j_{1}j_{2}j_{1}j_{2}} \\
&=&\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq
r}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}\mathcal{R}_{a}\left( \lambda
_{2d}\right) _{j_{1}j_{2}j_{1}j_{2}}
\end{eqnarray*}

\item Hence 
\begin{align}
\lambda _{2}& =\frac{1}{4}\left. \limfunc{Tr}\right\vert _{2}\left\{ 
\mathcal{R}_{a}\left( \lambda _{2d}\right) \right\} I_{\mathcal{F}}+\frac{i}{%
2}\sum_{1\leq j_{1}\leq r}\mathcal{R}_{a}\left( L_{2}^{1}\left( \lambda
_{2d}\right) \right) _{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}+\sum_{1\leq
j_{1}<j_{2}\leq r}\mathcal{R}_{a}\left( \lambda _{2d}\right)
_{j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}  \notag \\
& =\frac{1}{4}\mathcal{R}_{a}\left( L_{2}^{0}\left( \mathcal{R}_{a}\left(
\lambda _{2d}\right) \right) \right) I_{\mathcal{F}}+\frac{i}{2}\sum_{1\leq
j_{1}\leq r}\mathcal{R}_{a}\left( L_{2}^{1}\left( \lambda _{2}\right)
\right) _{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}+\sum_{1\leq j_{1}<j_{2}\leq r}%
\mathcal{R}_{a}\left( L_{2}^{2}\left( \lambda _{2}\right) \right)
_{j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}.
\end{align}
\end{enumerate}

\subsection{General form}

\begin{enumerate}
\item The $\left( x_{j_{1}}-ix_{j_{1}+r}\right) \left(
x_{j_{2}}-ix_{j_{2}+r}\right) \left( x_{j_{4}}+ix_{j_{4}+r}\right) \left(
x_{j_{3}}+ix_{j_{3}+r}\right) $ coefficient of $\lambda
_{2j_{1}j_{2}j_{3}j_{4}}$

\begin{enumerate}
\item The first two terms 
\begin{equation}
\left( x_{j_{1}}-ix_{j_{1}+r}\right) \left( x_{j_{2}}-ix_{j_{2}+r}\right)
=x_{j_{1}}x_{j_{2}}-ix_{j_{1}}x_{j_{2}+r}-ix_{j_{1}+r}x_{j_{2}}-x_{j_{1}+r}x_{j_{2}+r}
\end{equation}

\item The second two terms 
\begin{equation}
\left( x_{j_{4}}+ix_{j_{4}+r}\right) \left( x_{j_{3}}+ix_{j_{3}+r}\right)
=x_{j_{4}}x_{j_{3}}+ix_{j_{4}+r}x_{j_{3}}+ix_{j_{4}}x_{j_{3}+r}-x_{j_{4}+r}x_{j_{3}+r}
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{example}
