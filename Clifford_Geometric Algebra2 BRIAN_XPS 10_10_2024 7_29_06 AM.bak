& 122346: \\
& 122356: \\
& 122456: \\
& 123456:
\end{align}%
\begin{equation}
A_{22}A_{24}=A_{24}A_{22}=\left( \alpha_{212}\alpha_{43456}-\alpha
_{213}\alpha_{42456}+\alpha_{214}\alpha_{43256}\right)
x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}
\end{equation}

\begin{equation}
A_{24}A_{24}=\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r  \\ 1\leq
j_{5}<j_{6}<j_{7}<j_{8}\leq 2r}}\alpha _{4j_{1}j_{2}j_{3}j_{4}}\alpha
_{4j_{5}j_{6}j_{7}j_{8}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}x_{j_{7}}x_{j_{8}}
\end{equation}%
\begin{equation}
A_{24}A_{24}=\alpha _{4}\wedge \alpha _{4}+\frac{1}{2}L_{3}^{4}\left( \alpha
_{4}\wedge \alpha _{4}\right) -\frac{1}{4}L_{2}^{4}\left( \alpha _{4}\wedge
\alpha _{4}\right) +\frac{1}{8}L_{1}^{4}\left( \alpha _{4}\wedge \alpha
_{4}\right) -\frac{1}{16}L_{0}^{4}\left( \alpha _{4}\wedge \alpha
_{4}\right) I_{\mathcal{F}}.
\end{equation}

\section{Grassmann Powers}

Let $A_{p}$ and $B_{q}$ be homogeneous of degrees $p$ and $q$ respectively
then one has the identities and definitions 
\begin{align}
A_{p}\wedge B_{q}& =\left\langle A_{p}B_{q}\right\rangle _{p+q} \\
A_{p}\wedge B_{q}& =\left( -1\right) ^{pq}B_{q}\wedge A_{p},
\end{align}%
$\lceil $%
\begin{align}
I\wedge I& =\left\langle I^{2}\right\rangle _{0}=I \\
\alpha I\wedge \beta I& =\left\langle \alpha \beta I^{2}\right\rangle
_{0}=\alpha \beta I
\end{align}%
\begin{equation}
I\wedge B=B\wedge I\quad \forall B\in \mathcal{F},
\end{equation}%
$\rfloor $

where 
\begin{equation}
A_{p}=\left\langle A\right\rangle _{p},B_{q}=\left\langle B\right\rangle
_{q}.
\end{equation}%
This gives 
\begin{equation}
A_{p}\wedge A_{p}=\left( -1\right) ^{p^{2}}A_{p}\wedge A_{p}
\end{equation}%
thus if $p^{2}$ is odd then 
\begin{equation}
A_{p}\wedge A_{p}=0,
\end{equation}%
i.e. 
\begin{equation}
A_{p}\wedge A_{p}=0;p=1,3,5,\cdots .
\end{equation}

\begin{enumerate}
\item Let $p=2$ then 
\begin{align}
A_{2}\wedge A_{2}& =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}2\left(
A_{j_{1}j_{2}}A_{j_{3}j_{4}}-A_{j_{1}j_{3}}A_{j_{2}j_{4}}+A_{j_{1}j_{4}}A_{j_{2}j_{3}}\right) x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}
\\
& =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}2\limfunc{Pf}\left( \mathbb{A}%
_{2}\left( j_{1}j_{2}j_{3}j_{4}\right) \right)
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}},
\end{align}%
where $\mathbb{A}_{2}\left( j_{1}j_{2}j_{3}j_{4}\right) $ is the
antisymmetric matrix 
\begin{equation}
\left( 
\begin{array}{cccc}
0 & A_{j_{1}j_{2}} & A_{j_{1}j_{3}} & A_{j_{1}j_{4}} \\ 
-A_{j_{1}j_{2}} & 0 & A_{j_{2}j_{3}} & A_{j_{2}j_{4}} \\ 
-A_{j_{1}j_{3}} & -A_{j_{2}j_{3}} & 0 & A_{j_{3}j_{4}} \\ 
-A_{j_{1}j_{4}} & -A_{j_{2}j_{4}} & -A_{j_{3}j_{4}} & 0%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\limfunc{Pf}\left\{ \mathbb{A}_{2}\left( j_{1}j_{2}j_{3}j_{4}\right)
\right\}
=A_{j_{1}j_{2}}A_{j_{3}j_{4}}-A_{j_{1}j_{3}}A_{j_{2}j_{4}}+A_{j_{1}j_{4}}A_{j_{2}j_{3}}.
\end{equation}

\item Let $p=4$ then 
\begin{align}
A_{4}\wedge A_{4}& =\sum_{1\leq
j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}<j_{7}<j_{8}\leq 2r}2\left(
A_{j_{1}j_{2}j_{3}j_{4}}A_{j_{5}j_{6}j_{7}j_{8}}+\cdots \right)
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}x_{j_{7}}x_{j_{8}} \\
& =\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}<j_{5}<j_{6}<j_{7}<j_{8}\leq 2r}2%
\limfunc{Pf}\left\{ \left( \mathbb{A}_{4}\otimes \mathbb{A}_{4}\right)
\left( j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}j_{7}j_{8}\right) \right\}
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}x_{j_{6}}x_{j_{7}}x_{j_{8}}.
\end{align}%
$\lceil $%
\begin{equation}
\limfunc{Pf}\left\{ a_{1},\cdots ,a_{2n}\right\} =\sum_{j=2}^{n}\limfunc{Pf}%
\left\{ a_{1},a_{j}\right\} \left( -1\right) ^{j}\limfunc{Pf}\left\{
a_{2},\cdots ,\hat{a}_{j},\cdots ,a_{2n}\right\}
\end{equation}%
$\rfloor $

One can consider the special case $r=4$ the subscripts that have no values
in common are 
\begin{equation}
\binom{8}{4}\binom{8-4}{4}=\binom{8}{4}=\frac{8\ast 7\ast 6\ast 5}{1\ast
2\ast 3\ast 4}=70
\end{equation}%
e.g.%
\begin{equation}
12345678,12354678,12364578,12374568,12384567,
\end{equation}%
which gives the terms 
\begin{align}
& A_{1234}A_{5678}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge
x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1235}A_{4678}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{5}\wedge
x_{4}\wedge x_{6}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1236}A_{4578}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{6}\wedge
x_{4}\wedge x_{5}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1237}A_{4568}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{7}\wedge
x_{4}\wedge x_{5}\wedge x_{6}\wedge x_{8}  \notag \\
& A_{1238}A_{4567}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{8}\wedge
x_{4}\wedge x_{5}\wedge x_{6}\wedge x_{7}
\end{align}%
and the final coefficient is%
\begin{equation}
\left(
A_{1234}A_{5678}-A_{1235}A_{4678}+A_{1236}A_{4578}-A_{1237}A_{4568}+A_{1238}A_{4567}\right) x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}
\end{equation}%
\begin{align}
& A_{1234}A_{5678}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge
x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1254}A_{3678}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge
x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1264}A_{5378}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge
x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1274}A_{5638}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge
x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}  \notag \\
& A_{1284}A_{5673}x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\wedge
x_{5}\wedge x_{6}\wedge x_{7}\wedge x_{8}
\end{align}%
\begin{align}
\limfunc{Pf}\left\{ \left( a_{1},\cdots ,a_{4}\right) \right\} &
=\sum_{j=2}^{4}\left( -1\right) ^{j}\limfunc{Pf}\left\{ a_{1},a_{j}\right\} 
\limfunc{Pf}\left\{ a_{2},\cdots ,\hat{a}_{j},\cdots ,a_{4}\right\} \\
& =\limfunc{Pf}\left\{ a_{1},a_{2}\right\} \left( -1\right) ^{2}\limfunc{Pf}%
\left\{ a_{3},a_{4}\right\} +\limfunc{Pf}\left\{ a_{1},a_{3}\right\} \left(
-1\right) ^{3}\limfunc{Pf}\left\{ a_{2},a_{4}\right\} \\
& +\limfunc{Pf}\left\{ a_{1},a_{4}\right\} \left( -1\right) ^{4}\limfunc{Pf}%
\left\{ a_{2},a_{3}\right\} \\
& =\frac{1}{4}\left( a_{1}a_{2}-a_{2}a_{1}\right) \left(
a_{3}a_{4}-a_{4}a_{3}\right) -\frac{1}{4}\left( a_{1}a_{3}-a_{3}a_{1}\right)
\left( a_{2}a_{4}-a_{4}a_{2}\right) \\
& +\frac{1}{4}\left( a_{1}a_{4}-a_{4}a_{1}\right) \left(
a_{2}a_{3}-a_{3}a_{2}\right)
\end{align}
\end{enumerate}

\section{Exterior Product Between General Elements}

In general%
\begin{equation}
A\wedge B=\sum_{\substack{ 0\leq m,n\leq 2r  \\ 0\leq m+n\leq 2r}}%
\left\langle A_{m}B_{n}\right\rangle _{m+n}
\end{equation}%
for basis elements%
\begin{gather}
\left( x_{j_{1}}\cdots x_{j_{m}}\right) \wedge \left( x_{k_{1}}\cdots
x_{k_{m}}\right) =\left( x_{j_{1}}\wedge \cdots \wedge x_{j_{m}}\right)
\wedge \left( x_{k_{1}}\wedge \cdots \wedge x_{k_{m}}\right) =\left\langle
\left( x_{j_{1}}\cdots x_{j_{m}}\right) \left( x_{k_{1}}\cdots
x_{k_{m}}\right) \right\rangle _{m+n} \\
1\leq j_{1}<\cdots <j_{m}\leq 2r;1\leq k_{1}\cdots <k_{m}\leq 2r.
\end{gather}

\section{Geometric Product Between General Elements}

\subparagraph{%
\protect\begin{equation}
AB=\sum_{0\leq m,n\leq 2r}A_{m}B_{n} 
\protect\end{equation}%
\protect\begin{equation}
A_{m}B_{n}=\sum_{j=0}^{\min \left( m,n\right) }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}. 
\protect\end{equation}%
Squares}

\begin{align}
A^{2}& =\sum_{0\leq m,n\leq 2r}A_{m}A_{n} \\
A_{m}A_{n}& =\sum_{j=0}^{\min \left( m,n\right) }\left\langle
A_{m}A_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{align}

\begin{example}
Fourth order operators 
\begin{align}
A^{2}& =A_{0}^{2}+A_{1}^{2}+A_{2}^{2}+A_{3}^{2}+A_{4}^{2}  \notag \\
&
+A_{0}A_{1}+A_{0}A_{2}+A_{0}A_{3}+A_{0}A_{4}+A_{1}A_{0}+A_{2}A_{0}+A_{3}A_{0}+A_{4}A_{0}
\notag \\
& +A_{1}A_{2}+A_{1}A_{3}+A_{1}A_{4}+A_{2}A_{1}+A_{3}A_{1}+A_{4}A_{1}  \notag
\\
& +A_{2}A_{3}+A_{2}A_{4}+A_{3}A_{2}+A_{4}A_{2}  \notag \\
& +A_{3}A_{4}+A_{4}A_{3},
\end{align}%
where
\end{example}

1. 
\begin{subequations}
\begin{align}
A_{4}^{2}& =\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{4}^{2}\right\rangle _{2}+\left\langle A_{4}^{2}\right\rangle
_{4}+\left\langle A_{4}^{2}\right\rangle _{6}+\left\langle
A_{4}^{2}\right\rangle _{8} \\
A_{3}^{2}& =\left\langle A_{3}^{2}\right\rangle _{0}+\left\langle
A_{3}^{2}\right\rangle _{2}+\left\langle A_{3}^{2}\right\rangle
_{4}+\left\langle A_{3}^{2}\right\rangle _{6} \\
A_{2}^{2}& =\left\langle A_{2}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{2}+\left\langle A_{2}^{2}\right\rangle _{4} \\
A_{1}^{2}& =\left\langle A_{1}^{2}\right\rangle _{0}+\left\langle
A_{1}^{2}\right\rangle _{2} \\
A_{0}^{2}& =\left\langle A_{0}^{2}\right\rangle _{0},
\end{align}%
thus 
\end{subequations}
\begin{align*}
\left( \left. A\right\vert A\right) & =\left\langle A_{4}^{2}\right\rangle
_{0}+\left\langle A_{3}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}+\left\langle A_{1}^{2}\right\rangle
_{0}+\left\langle A_{0}^{2}\right\rangle _{0} \\
& =\left( \left. A_{0}\right\vert A_{0}\right) +\left( \left.
A_{1}\right\vert A_{1}\right) +\left( \left. A_{2}\right\vert A_{2}\right)
+\left( \left. A_{3}\right\vert A_{3}\right) +\left( \left. A_{4}\right\vert
A_{4}\right) \\
& =\left\{ \alpha _{0}^{2}+\frac{1}{2}\sum_{1\leq j_{1}\leq 2r}\left( \alpha
_{1j_{1}}\right) ^{2}-\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq 2r}\left(
\alpha _{2j_{1}j_{2}}\right) ^{2}-\frac{1}{8}\sum_{1\leq
j_{1}<j_{2}<j_{3}\leq 2r}\left( \alpha _{3j_{1}j_{2}j_{3}}\right) ^{2}+\frac{%
1}{16}\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}\left( \alpha
_{4j_{1}j_{2}j_{3}j_{4}}\right) ^{2}\right\} I_{\mathcal{F}}.
\end{align*}%
One can also express the inner products of the even number components as 
\begin{align}
\left( \left. A_{0}\right\vert A_{0}\right) & =\left. \limfunc{Tr}%
\right\vert _{0}\left\{ \mathbb{A}_{0}^{t}\mathbb{A}_{0}\right\} \limfunc{Tr}%
I_{\mathcal{F}}  \notag \\
\left( \left. A_{2}\right\vert A_{2}\right) & =\frac{1}{4}\left. \limfunc{Tr}%
\right\vert _{1}\left\{ \mathbb{A}_{2}^{t}\mathbb{A}_{2}\right\} I_{\mathcal{%
F}}  \notag \\
\left( \left. A_{4}\right\vert A_{4}\right) & =\frac{1}{16}\left. \limfunc{Tr%
}\right\vert _{2}\left\{ \mathbb{A}_{4}^{t}\mathbb{A}_{4}\right\} I_{%
\mathcal{F}},
\end{align}%
where we have used the ordered form of the basis.

2.%
\begin{align}
A_{3}A_{4} & =\left\langle A_{3}A_{4}\right\rangle _{1}+\left\langle
A_{3}A_{4}\right\rangle _{3}+\left\langle A_{3}A_{4}\right\rangle
_{5}+\left\langle A_{3}A_{4}\right\rangle _{7} \\
A_{4}A_{3} & =\left\langle A_{4}A_{3}\right\rangle _{1}+\left\langle
A_{4}A_{3}\right\rangle _{3}+\left\langle A_{4}A_{3}\right\rangle
_{5}+\left\langle A_{4}A_{3}\right\rangle _{7},
\end{align}

3.%
\begin{align}
A_{2}A_{3} & =\left\langle A_{2}A_{3}\right\rangle _{1}+\left\langle
A_{2}A_{3}\right\rangle _{3}+\left\langle A_{2}A_{3}\right\rangle _{5} \\
A_{3}A_{2} & =\left\langle A_{3}A_{2}\right\rangle _{1}+\left\langle
A_{3}A_{2}\right\rangle _{3}+\left\langle A_{3}A_{2}\right\rangle _{5},
\end{align}

4.%
\begin{align}
A_{2}A_{4} & =\left\langle A_{2}A_{4}\right\rangle _{2}+\left\langle
A_{2}A_{4}\right\rangle _{4}+\left\langle A_{2}A_{4}\right\rangle _{6} \\
A_{4}A_{2} & =\left\langle A_{4}A_{2}\right\rangle _{2}+\left\langle
A_{4}A_{2}\right\rangle _{4}+\left\langle A_{4}A_{2}\right\rangle _{6}.
\end{align}

5.%
\begin{align}
A_{1}A_{2} & =\left\langle A_{1}A_{2}\right\rangle _{1}+\left\langle
A_{1}A_{2}\right\rangle _{3} \\
A_{2}A_{1} & =\left\langle A_{2}A_{1}\right\rangle _{1}+\left\langle
A_{2}A_{1}\right\rangle _{3}
\end{align}

6.%
\begin{align}
A_{1}A_{3} & =\left\langle A_{1}A_{3}\right\rangle _{2}+\left\langle
A_{1}A_{3}\right\rangle _{4} \\
A_{3}A_{1} & =\left\langle A_{3}A_{1}\right\rangle _{2}+\left\langle
A_{3}A_{1}\right\rangle _{4}
\end{align}

7.%
\begin{align}
A_{1}A_{4}& =\left\langle A_{1}A_{4}\right\rangle _{3}+\left\langle
A_{1}A_{4}\right\rangle _{5} \\
A_{4}A_{1}& =\left\langle A_{4}A_{1}\right\rangle _{3}+\left\langle
A_{4}A_{1}\right\rangle _{5}.
\end{align}%
In this case 
\begin{equation}
A=A_{0}+A_{2}+A_{4},
\end{equation}%
hence 
\begin{align}
A^{2}& =\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{4}^{2}\right\rangle _{2}+\left\langle A_{4}^{2}\right\rangle
_{4}+\left\langle A_{4}^{2}\right\rangle _{6}+\left\langle
A_{4}^{2}\right\rangle _{8}+\left\langle A_{2}^{2}\right\rangle
_{0}+\left\langle A_{2}^{2}\right\rangle _{2}+\left\langle
A_{2}^{2}\right\rangle _{4}  \notag \\
& +\left\langle A_{2}A_{4}\right\rangle _{2}+\left\langle
A_{2}A_{4}\right\rangle _{4}+\left\langle A_{2}A_{4}\right\rangle
_{6}+\left\langle A_{4}A_{2}\right\rangle _{2}+\left\langle
A_{4}A_{2}\right\rangle _{4}+\left\langle A_{4}A_{2}\right\rangle
_{6}+2A_{0}A_{2}+2A_{0}A_{4},
\end{align}%
which can be rearranged as 
\begin{align}
A^{2}& =\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}+A_{0}^{2}  \notag \\
& +\left\langle A_{4}^{2}\right\rangle _{2}+\left\langle
A_{2}^{2}\right\rangle _{2}+\left\langle A_{2}A_{4}\right\rangle
_{2}+\left\langle A_{4}A_{2}\right\rangle _{2}+2A_{0}A_{2}  \notag \\
& +2A_{0}A_{4}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{2}A_{4}\right\rangle _{4}+\left\langle A_{4}A_{2}\right\rangle
_{4}+\left\langle A_{2}^{2}\right\rangle _{4}  \notag \\
& +\left\langle A_{4}^{2}\right\rangle _{6}+\left\langle
A_{2}A_{4}\right\rangle _{6}+\left\langle A_{4}A_{2}\right\rangle _{6} 
\notag \\
& +\left\langle A_{4}^{2}\right\rangle _{8},
\end{align}%
Noting that 
\begin{equation}
\left\langle A_{r}B_{s}\right\rangle _{r+s-2j}=\left( -1\right)
^{rs-j}\left\langle B_{s}A_{r}\right\rangle _{r+s-2j}
\end{equation}%
this gives 
\begin{align}
A^{2}& =A_{0}^{2}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}  \notag \\
& +2\left\langle A_{2}A_{4}\right\rangle _{2}+2A_{0}A_{2}  \notag \\
& +\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{2}^{2}\right\rangle _{4}+2A_{0}A_{4}  \notag \\
& +2\left\langle A_{2}A_{4}\right\rangle _{6}  \notag \\
& +\left\langle A_{4}^{2}\right\rangle _{8},
\end{align}%
as 
\begin{subequations}
\label{contraccond}
\begin{align}
\left\langle A_{4}A_{4}\right\rangle _{8-6}& =\left( -1\right)
^{16-3}\left\langle A_{4}A_{4}\right\rangle _{8-6}\Rightarrow \left\langle
A_{4}^{2}\right\rangle _{2}=0  \label{4-2-2} \\
\left\langle A_{4}A_{4}\right\rangle _{8-4}& =\left( -1\right)
^{16-2}\left\langle A_{4}A_{4}\right\rangle _{8-4}=\left\langle
A_{4}A_{4}\right\rangle _{4}  \label{4-4-4} \\
\left\langle A_{4}A_{4}\right\rangle _{8-2}& =\left( -1\right)
^{16-1}\left\langle A_{4}A_{4}\right\rangle _{8-2}\Rightarrow \left\langle
A_{4}^{2}\right\rangle _{6}=0  \label{4-4-6} \\
\left\langle A_{4}A_{4}\right\rangle _{8-0}& =\left( -1\right)
^{16-0}\left\langle A_{4}A_{4}\right\rangle _{8}=\left\langle
A_{4}^{2}\right\rangle _{8}  \label{4-4-8} \\
\left\langle A_{4}A_{2}\right\rangle _{6-4}& =\left( -1\right)
^{8-2}\left\langle A_{2}A_{4}\right\rangle _{6-4}=\left\langle
A_{2}A_{4}\right\rangle _{2}  \label{4-2--2} \\
\left\langle A_{2}A_{4}\right\rangle _{6-2}& =\left( -1\right)
^{8-1}\left\langle A_{4}A_{2}\right\rangle _{6-2}\Rightarrow \left\langle
A_{2}A_{4}\right\rangle _{4}=-\left\langle A_{4}A_{2}\right\rangle _{4}
\label{2-4-4} \\
\left\langle A_{4}A_{2}\right\rangle _{6-0}& =\left( -1\right)
^{8-0}\left\langle A_{2}A_{4}\right\rangle _{6-0}=\left\langle
A_{2}A_{4}\right\rangle _{6}  \label{4-2-6} \\
\left\langle A_{2}A_{2}\right\rangle _{4-2}& =\left( -1\right)
^{4-1}\left\langle A_{2}A_{2}\right\rangle _{4-2}\Rightarrow \left\langle
A_{2}^{2}\right\rangle _{2}=0  \label{2-2-2} \\
\left\langle A_{2}A_{2}\right\rangle _{4-0}& =\left( -1\right)
^{4-0}\left\langle A_{2}A_{2}\right\rangle _{4-0}=\left\langle
A_{2}^{2}\right\rangle _{4}.  \label{2-2-0}
\end{align}%
It is easy to show that 
\end{subequations}
\begin{subequations}
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{0}& =\left( \left. A_{4}\right\vert
A_{4}\right) I_{\mathcal{F}} \\
\left\langle A_{2}^{2}\right\rangle _{0}& =\frac{1}{8}\left. \limfunc{Tr}%
\right\vert _{1}\left\{ \mathbb{A}_{2}^{t}\mathbb{A}_{2}\right\} I_{\mathcal{%
F}}=\left( \left. A_{2}\right\vert A_{2}\right) I_{\mathcal{F}}
\end{align}%
and 
\end{subequations}
\begin{subequations}
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{8}& =A_{4}\wedge A_{4} \\
\left\langle A_{2}^{2}\right\rangle _{4}& =A_{2}\wedge A_{2} \\
\left\langle A_{2}A_{4}\right\rangle _{6}& =A_{2}\wedge A_{4}.
\end{align}%
One can check this by considering representative tensor elements for eq.$%
\left( \ref{4-2-2}\right) $ 
\end{subequations}
\begin{equation}
\left\langle A_{4}A_{2}\right\rangle _{\left( 2\right) 12}=-\left(
A_{1256}A_{56}+A_{1246}A_{46}+A_{1236}A_{36}+A_{1245}A_{45}+A_{1235}A_{35}+A_{1234}A_{34}\right) \neq 0
\end{equation}%
\begin{equation}
\left\langle A_{2}A_{4}\right\rangle _{\left( 2\right) 12}=-\left(
A_{56}A_{1256}+A_{46}A_{1246}+A_{36}A_{1236}+A_{45}A_{1245}+A_{35}A_{1235}+A_{34}A_{1234}\right) \neq 0
\end{equation}%
for eq.$\left( \ref{4-4-6}\right) $%
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{\left( 6\right) 234567}=&
A_{1234}A_{1567}-A_{1235}A_{1467}+A_{1236}A_{1457}-A_{1237}A_{1456}+A_{1245}A_{1367}-A_{1246}A_{1357}+A_{1247}A_{1356}-A_{1256}A_{1347}
\notag \\
&
-A_{1257}A_{1346}+A_{1267}A_{1345}-A_{1345}A_{1267}+A_{1346}A_{1257}-A_{1347}A_{1256}-A_{1356}A_{1247}+A_{1357}A_{1246}-A_{1367}A_{1245}
\notag \\
& +A_{1456}A_{1237}-A_{1457}A_{1236}+A_{1467}A_{1235},-A_{1567}A_{1234}=0
\end{align}%
for eq. $\left( \ref{4-4-4}\right) $%
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{\left( 4\right) 3456}&
=-A_{1234}A_{1256}+A_{1235}A_{1246}-A_{1236}A_{1245}-A_{1245}A_{1236}+A_{1246}A_{1235}-A_{1256}A_{1234}
\\
& =2\left( A_{1235}A_{1246}-A_{1234}A_{1256}-A_{1236}A_{1245}\right)
\end{align}%
for eq. $\left( \ref{4-4-2}\right) $%
\begin{equation}
\left\langle A_{4}^{2}\right\rangle _{\left( 2\right)
45}=A_{1234}A_{1235}-A_{1235}A_{1234}+A_{1234}A_{1236}-A_{1236}A_{1234}+A_{1234}A_{1235}-A_{1235}A_{1234}\cdots =0.
\end{equation}

The \emph{reflection or involution }condition $A^{2}=I_{\mathcal{F}}$ gives 
\begin{equation}
A^{2}=A_{0}^{2}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}+2\left\langle A_{2}A_{4}\right\rangle
_{2}+2A_{0}A_{2}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{2}^{2}\right\rangle _{4}+2A_{0}A_{4}+2\left\langle
A_{2}A_{4}\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{8}=I_{%
\mathcal{F}},
\end{equation}
leading to 
\begin{align}
A_{0}^{2}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0} & =I_{\mathcal{F}} \\
\left\langle A_{2}A_{4}\right\rangle _{2}+A_{0}A_{2} & =0 \\
\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle A_{2}^{2}\right\rangle
_{4}+2A_{0}A_{4} & =0 \\
\left\langle A_{2}A_{4}\right\rangle _{6} & =A_{2}\wedge A_{4}=0 \\
\left\langle A_{4}^{2}\right\rangle _{8} & =A_{4}\wedge A_{4}=0
\end{align}

If $A$ is a reflection then 
\begin{align*}
\mathcal{A}_{+} & =\frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}+A\right) \\
\mathcal{A}_{-} & =\frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}-A\right)
\end{align*}
are \emph{orthogonal idempotents}, as%
\begin{equation*}
\mathcal{A}_{+}^{2}=\left( \frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}+A\right)
\right) ^{2}=\frac{1}{2}\left( I_{\mathcal{F}}+2A+I_{\mathcal{F}}\right) =%
\mathcal{A}_{+},
\end{equation*}%
\begin{equation*}
\mathcal{A}_{-}^{2}=\left( \frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}-A\right)
\right) ^{2}=\frac{1}{2}\left( I_{\mathcal{F}}-2A+I_{\mathcal{F}}\right) =%
\mathcal{A}_{-}
\end{equation*}
and 
\begin{equation*}
\mathcal{A}_{+}\mathcal{A}_{-}=\mathcal{A}_{-}\mathcal{A}_{+}=0=\frac{1}{%
\sqrt{2}}\left( I_{\mathcal{F}}+A\right) \frac{1}{\sqrt{2}}\left( I_{%
\mathcal{F}}-A\right) =\frac{1}{2}\left( I_{\mathcal{F}}+A\right) \left( I_{%
\mathcal{F}}-A\right) .
\end{equation*}

The \emph{idempotency} condition $A^{2}=A$ gives 
\begin{align}
A^{2}-A & =\left\{ A_{0}\left( A_{0}-1\right) +\left\langle
A_{4}^{2}\right\rangle _{0}+\left\langle A_{2}^{2}\right\rangle _{0}\right\}
+\left\{ 2\left\langle A_{2}A_{4}\right\rangle _{2}+\left( 2A_{0}-1\right)
A_{2}\right\} +\left\{ \left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{2}^{2}\right\rangle _{4}+\left( 2A_{0}-1\right) A_{4}\right\}  \notag \\
& +2\left\langle A_{2}A_{4}\right\rangle _{6}+\left\langle
A_{4}^{2}\right\rangle _{8}=0,
\end{align}
which gives 
\begin{subequations}
\label{idem cond}
\begin{align}
A_{0}\left( A_{0}-I_{\mathcal{F}}\right) +\left\langle
A_{4}^{2}\right\rangle _{0}+\left\langle A_{2}^{2}\right\rangle _{0} & =0 \\
2\left\langle A_{2}A_{4}\right\rangle _{2}+\left( 2A_{0}-I_{\mathcal{F}%
}\right) A_{2} & =0 \\
\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle A_{2}^{2}\right\rangle
_{4}+\left( 2A_{0}-I_{\mathcal{F}}\right) A_{4} & =0 \\
\left\langle A_{2}A_{4}\right\rangle _{6} & =0 \\
\left\langle A_{4}^{2}\right\rangle _{8} & =0
\end{align}
and thus 
\end{subequations}
\begin{align}
A_{0}\left( A_{0}-1\right) +\left( \left. A_{4}\right\vert A_{4}\right)
+\left( \left. A_{2}\right\vert A_{2}\right) & =0 \\
2\left\langle A_{2}A_{4}\right\rangle _{2}+\left( 2A_{0}-1\right) A_{2} & =0
\\
\left\langle A_{4}^{2}\right\rangle _{4}+A_{2}\wedge A_{2}+\left(
2A_{0}-1\right) A_{4} & =0 \\
A_{2}\wedge A_{4} & =0 \\
A_{4}\wedge A_{4} & =0
\end{align}
and in more detail%
\begin{align}
A_{0}\left( A_{0}-1\right) +\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq
2r}A_{4j_{1}j_{2}j_{3}j_{4}}^{2}+\sum_{1\leq
j_{1}<j_{2}\leq2r}A_{2j_{1}j_{2}}^{2} & =0 \\
2\left\langle A_{2}A_{4}\right\rangle _{2}+\left( 2\alpha-1\right) A_{2} & =0
\\
\left\langle A_{4}^{2}\right\rangle _{4}+A_{2}\wedge A_{2}+\left(
2\alpha-1\right) A_{4} & =0 \\
A_{2}\wedge A_{4} & =0 \\
A_{4}\wedge A_{4} & =0.
\end{align}

\subsection{Canonical form of 4-forms}

(check what happens if $A_{4}$ are self adjoint)

The homogeneous operator $A_{4}$ can be expanded as 
\begin{align}
A_{4}& =\frac{1}{4!}\sum_{\substack{ 1\leq j_{1},j_{2},j_{3},j_{4}\leq 2r}}%
A_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=\frac{1}{4!}%
\sum _{\substack{ 1\leq j_{1},j_{2},j_{3},j_{4}\leq 2r}}%
A_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge
x_{j_{4}} \\
& =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}}%
A_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=\frac{1}{4}\sum 
_{\substack{ 1\leq j_{1}<j_{2}\leq 2r  \\ 1<j_{3}<j_{4}\leq 2r}}%
A_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}},
\end{align}%
where the coefficients $\left\{ A_{j_{1}j_{2}j_{3}j_{4}}\right\} $ are
antisymmetric in the subscripts and 
\begin{equation*}
A_{j_{1}j_{2}j_{3}j_{4}}=0\text{ if }j_{1}=j_{3}\text{ or }%
j_{4},\,j_{2}=j_{3}\text{ or }j_{4},\,j_{1}=j_{2}\text{ or }\,j_{3}=j_{4}.
\end{equation*}%
$\lceil \ $consider the example for $r=2$ arranged as $12\times 12$ matrix 
\begin{equation*}
\begin{array}{ccccccccccccc}
& 12 & 13 & 14 & 21 & 23 & 24 & 31 & 32 & 34 & 41 & 42 & 43 \\ 
12 & 0 & 0 & 0 & 0 & 0 & 0 & 0 & 0 & A_{1234} & 0 & 0 & A_{1243} \\ 
13 & 0 & 0 & 0 & 0 & 0 & A_{1324} & 0 & 0 & 0 & 0 & \ast & 0 \\ 
14 & 0 & 0 & 0 & 0 & A_{1423} & 0 & 0 & A_{1432} & 0 & 0 & 0 & 0 \\ 
21 & 0 & 0 & 0 & 0 & 0 & 0 & 0 & 0 & \ast & 0 & 0 & \ast \\ 
23 & 0 & 0 & \ast & 0 & 0 & 0 & 0 & 0 & 0 & \ast & 0 & 0 \\ 
24 & 0 & \ast & 0 & 0 & 0 & 0 & \ast & 0 & 0 & 0 & 0 & 0 \\ 
31 & 0 & 0 & 0 & 0 & 0 & \ast & 0 & 0 & 0 & 0 & \ast & 0 \\ 
32 & 0 & 0 & \ast & 0 & 0 & 0 & 0 & 0 & 0 & \ast & 0 & 0 \\ 
34 & \ast & 0 & 0 & \ast & 0 & 0 & 0 & 0 & 0 & 0 & 0 & 0 \\ 
41 & 0 & 0 & 0 & 0 & \ast & 0 & 0 & \ast & 0 & 0 & 0 & 0 \\ 
42 & 0 & \ast & 0 & 0 & 0 & 0 & \ast & 0 & 0 & 0 & 0 & 0 \\ 
43 & \ast & 0 & 0 & \ast & 0 & 0 & 0 & 0 & 0 & 0 & 0 & 0%
\end{array}%
\end{equation*}%
or as a $6\times 6$ \emph{symmetric} matrix 
\begin{equation*}
\left( 
\begin{array}{ccccccc}
& 12 & 13 & 14 & 23 & 24 & 34 \\ 
12 & 0 & 0 & 0 & 0 & 0 & A_{1234} \\ 
13 & 0 & 0 & 0 & 0 & A_{1324} & 0 \\ 
14 & 0 & 0 & 0 & A_{1423} & 0 & 0 \\ 
23 & 0 & 0 & A_{2314} & 0 & 0 & 0 \\ 
24 & 0 & A_{2413} & 0 & 0 & 0 & 0 \\ 
34 & A_{3412} & 0 & 0 & 0 & 0 & 0%
\end{array}%
\right)
\end{equation*}%
$\rfloor $

As%
\begin{equation*}
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=x_{j_{3}}x_{j_{4}}x_{j_{1}}x_{j_{2}}
\end{equation*}%
one has 
\begin{equation*}
A_{j_{1}j_{2}j_{3}j_{4}}=A_{j_{3}j_{4}j_{1}j_{2}}
\end{equation*}%
and thus the matrix $\mathbb{A=}\left\{ \left. A_{J_{12}J_{34}}\right\vert
1\leq J_{12},J_{34}\leq r\left( 2r-1\right) \right\} $ is symmetric i.e. 
\begin{equation*}
A_{J_{12}J_{34}}=A_{J_{34}J_{12}};1\leq J_{12},J_{34}\leq r\left( 2r-1\right)
\end{equation*}%
and the operator $A_{4}$ can be expanded as 
\begin{equation*}
A_{4}=\frac{1}{4}\sum_{1\leq J_{12},J_{34}\leq r\left( 2r-1\right)
}A_{4J_{12}J_{34}}Y_{J_{12}}Y_{J_{34}}=\frac{1}{4}\sum_{1\leq
J_{12},J_{34}\leq r\left( 2r-1\right) }A_{4J_{12}J_{34}}Y_{J_{12}}\wedge
Y_{J_{34}},
\end{equation*}%
where 
\begin{align*}
Y_{J_{12}}& =x_{j_{1}}x_{j_{2}} \\
Y_{J_{34}}& =x_{j_{3}}x_{j_{4}}.
\end{align*}%
If the matrix $\mathbb{A=}\left\{ \left. A_{J_{12}J_{34}}\right\vert 1\leq
J_{12},J_{34}\leq r\left( 2r-1\right) \right\} $ is real symmetric, (which
it must be if $A_{4}$ is self adjoint), one can diagonalize it with real
orthogonal transformations i.e. $\mathbb{O\in }O(r\left( 2r-1\right) ,%
\mathbb{R)},$ to obtain 
\begin{equation*}
\mathbb{O}^{t}\mathbb{AO=}\left( 
\begin{array}{ccc}
\alpha _{1} & \cdots & 0 \\ 
\vdots & \ddots & \vdots \\ 
0 & \cdots & \alpha _{r\left( 2r-1\right) }%
\end{array}%
\right) \Longleftrightarrow \mathbb{A=O}\left( 
\begin{array}{ccc}
\alpha _{1} & \cdots & 0 \\ 
\vdots & \ddots & \vdots \\ 
0 & \cdots & \alpha _{r\left( 2r-1\right) }%
\end{array}%
\right) \mathbb{O}^{t}
\end{equation*}%
giving 
\begin{equation*}
A_{J_{12}J_{34}}=\sum_{1\leq K\leq r\left( 2r-1\right) }O_{J_{12}K}\alpha
_{K}O_{J_{34}K}
\end{equation*}%
and thus 
\begin{equation*}
A_{4}=\frac{1}{4}\sum_{1\leq J_{12},J_{34}\leq r\left( 2r-1\right)
}A_{4J_{12}J_{34}}Y_{J_{12}}Y_{J_{34}}=\frac{1}{4}\sum_{1\leq
J_{12},J_{34}\leq r\left( 2r-1\right) }\sum_{1\leq K\leq r\left( 2r-1\right)
}O_{J_{12}K}\alpha _{K}O_{J_{34}K}Y_{J_{12}}Y_{J_{34}}.
\end{equation*}%
One can define the generalized geminal operator 
\begin{equation*}
\mathcal{O}_{K}=\sum_{1\leq J_{12}\leq r\left( 2r-1\right)
}O_{J_{12}K}Y_{J_{12}}=\sum_{1\leq j_{1}\neq j_{2}\leq
2r}O_{kj_{1}j_{2}}x_{j_{1}}x_{j_{2}};\quad O_{kj_{1}j_{2}}=-O_{kj_{2}j_{1}},
\end{equation*}%
which has the canonical form 
\begin{equation*}
\mathcal{O}_{K}=\sum_{1\leq l\leq r}c_{Kl}y_{Kl}y_{Kl+r}=\sum_{1\leq l\leq
r}c_{Kl}y_{Kl}\wedge y_{Kl+r},\quad c_{Kl}\in \mathbb{R}^{+}.
\end{equation*}%
Note that $\left\{ y_{Kl}\right\} $ \emph{are} \emph{self adjoint }operators
belonging to $\mathcal{F}$ that are linear combinations of single creation
and annihilation operators$.$ The operator $A_{4}$ can thus be expressed as 
\begin{align*}
A_{4}& =\frac{1}{4}\sum_{1\leq J_{12},J_{34}\leq r\left( 2r-1\right)
}A_{4J_{12}J_{34}}Y_{J_{12}}Y_{J_{34}}=\frac{1}{4}\sum_{1\leq K\leq r\left(
2r-1\right) }\alpha _{K}\sum_{1\leq J_{12},J_{34}\leq r\left( 2r-1\right)
}O_{J_{12r\left( 2r+1\right) 2}K}O_{J_{34}K}Y_{J_{12}}Y_{J_{34}} \\
& =\frac{1}{4}\sum_{1\leq K\leq r\left( 2r-1\right) }\alpha _{K}\sum_{1\leq
J_{12}\leq r\left( 2r-1\right) }O_{J_{12}K}Y_{J_{12}}\sum_{1\leq J_{34}\leq
r\left( 2r-1\right) }O_{J_{34}K}Y_{J_{34}}=\frac{1}{4}\sum_{1\leq K\leq
r\left( 2r-1\right) }\alpha _{K}\mathcal{O}_{K}\wedge \mathcal{O}_{K} \\
& =\frac{1}{4}\sum_{1\leq K\leq 2r\left( 2r-1\right) }\alpha _{K}\mathcal{O}%
_{K}^{2\wedge }.
\end{align*}%
Using the canonical form for a second degree antisymmetric polynomial this
gives the canonical form for a fourth degree antisymmetric polynomial as 
\begin{align*}
A_{4}& =\frac{1}{4}\sum_{1\leq K\leq r\left( 2r-1\right) }\alpha
_{K}\sum_{1\leq l_{1},l_{2}\leq
r}c_{Kl_{1}}c_{Kl_{2}}y_{Kl_{1}}y_{Kl_{1}+r}y_{Kl_{2}}y_{Kl_{2}+r}=\frac{1}{4%
}\sum_{1\leq K\leq r\left( 2r-1\right) }\alpha _{K}\sum_{1\leq l_{1}\neq
l_{2}\leq r}c_{Kl_{1}}c_{Kl_{2}}y_{Kl_{1}}y_{Kl_{1}+r}y_{Kl_{2}}y_{Kl_{2}+r}
\\
& =\frac{1}{2}\sum_{1\leq K\leq r\left( 2r-1\right) }\alpha _{K}\sum_{1\leq
l_{1}<l_{2}\leq
r}c_{Kl_{1}}c_{Kl_{2}}y_{Kl_{1}}y_{Kl_{1}+r}y_{Kl_{2}}y_{Kl_{2}+r}=\sum_{1%
\leq K\leq r\left( 2r-1\right) }\alpha _{K}\mathcal{O}_{K}\wedge \mathcal{O}%
_{K}.
\end{align*}%
One should note that $\left\{ \alpha _{K}\in \mathbb{R}\right\} $ and $%
\left\{ c_{Kl}\geq 0\right\} $ and $\left\{ \mathcal{O}_{K}\right\} $ are
self adjoint. However the coefficients $\alpha _{K}$ could be negative \emph{%
unless the matrix} $\mathbb{A}$ is positive, \emph{which it is if it is a
projector}.

$\lceil$ If 
\begin{equation*}
\mathcal{O}_{K}\wedge\mathcal{O}_{K}=\mathcal{O}_{K}^{2\wedge}=0
\end{equation*}
then 
\begin{equation*}
\text{rank}\left\{ \mathcal{O}_{K}\right\} =1
\end{equation*}
as 
\begin{align*}
\mathcal{O}_{K}^{2\wedge} & =2\sum_{1\leq l<m\leq
r}c_{Kl}c_{Km}y_{Kl}y_{Kl+r}y_{Km}y_{Km+r} \\
& =2\sum_{1\leq l<m\leq r}c_{Kl}c_{Km}y_{Kl}y_{Km}y_{Kl+r}y_{Km+r}
\end{align*}
and 
\begin{equation*}
\left( \left. y_{Kp}\right\vert y_{Kq}\right) =\delta_{pq}I_{\mathcal{F}}
\end{equation*}
so that 
\begin{equation*}
y_{Kl}y_{Kl+r}y_{Km}y_{Km+r}\neq0\text{ if }l\neq m.
\end{equation*}
$\rfloor$

The Grassmann square of $A_{4}$ is 
\begin{align*}
A_{4}^{2\wedge} & =A_{4}\wedge A_{4}=\left( \frac{1}{4}\right)
^{2}\sum_{1\leq K\leq r\left( 2r-1\right) }\alpha_{K}\mathcal{O}_{K}\wedge%
\mathcal{O}_{K}\wedge\sum_{1\leq L\leq r\left( 2r-1\right) }\alpha _{L}%
\mathcal{O}_{L}\wedge\mathcal{O}_{L} \\
& =\left( \frac{1}{4}\right) ^{2}\sum_{\substack{ 1\leq K\leq r\left(
2r-1\right)  \\ 1\leq L\leq r\left( 2r-1\right) }}\alpha_{K}\alpha _{L}%
\mathcal{O}_{K}\wedge\mathcal{O}_{L}\wedge\mathcal{O}_{K}\wedge \mathcal{O}%
_{L} \\
& =\left( \frac{1}{4}\right) ^{2}\sum_{\substack{ 1\leq K\leq r\left(
2r-1\right)  \\ 1\leq L\leq r\left( 2r-1\right) }}\alpha_{K}\alpha _{L}%
\mathcal{O}_{KL}\wedge\mathcal{O}_{KL} \\
& =\left( \frac{1}{4}\right) ^{2}\sum_{1\leq K,L\leq r\left( 2r-1\right)
}\alpha_{K}\alpha_{L}\sum_{1\leq m,n,p,q\leq
r}c_{Km}c_{Kn}c_{Lp}c_{Lq}\left(
y_{Km}y_{Km+r}y_{Kn}y_{Kn+r}y_{Lp}y_{Lp+r}y_{Lq}y_{Lq+r}\right) \\
& =\left( \frac{1}{4}\right) ^{2}\sum_{1\leq K,L\leq r\left( 2r-1\right)
}\alpha_{K}\alpha_{L}\sum_{1\leq m,n,p,q\leq
r}c_{Km}c_{Kn}c_{Lp}c_{Lq}\left(
y_{Km}y_{Kn}y_{Lp}y_{Lq}y_{Km+r}y_{Kn+r}y_{Lp+r}y_{Lq+r}\right) .
\end{align*}

If $A$ is a reflection then 
\begin{align*}
\mathcal{A}_{+} & =\frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}+A\right) \\
\mathcal{A}_{-} & =\frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}-A\right)
\end{align*}
are idempotents, as%
\begin{equation*}
\mathcal{A}_{+}^{2}=\left( \frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}+A\right)
\right) ^{2}=\frac{1}{2}\left( I_{\mathcal{F}}+2A+I_{\mathcal{F}}\right) =%
\mathcal{A}_{+}
\end{equation*}
and 
\begin{equation*}
\mathcal{A}_{-}^{2}=\left( \frac{1}{\sqrt{2}}\left( I_{\mathcal{F}}-A\right)
\right) ^{2}=\frac{1}{2}\left( I_{\mathcal{F}}-2A+I_{\mathcal{F}}\right) =%
\mathcal{A}_{-}.
\end{equation*}
Also 
\begin{equation*}
\mathcal{A}_{+}\mathcal{A}_{-}=\mathcal{A}_{-}\mathcal{A}_{+}=0=\frac{1}{%
\sqrt{2}}\left( I_{\mathcal{F}}+A\right) \frac{1}{\sqrt{2}}\left( I_{%
\mathcal{F}}-A\right) =\frac{1}{2}\left( I_{\mathcal{F}}+A\right) \left( I_{%
\mathcal{F}}-A\right) .
\end{equation*}

$\lceil $%
\begin{equation}
\left\langle A_{4}^{2}\right\rangle _{4}=\frac{1}{4}\left(
A_{1234}A_{1256}-A_{1235}A_{1246}+A_{1236}A_{1245}\right) x_{3}\wedge
x_{4}\wedge x_{5}\wedge x_{6}
\end{equation}%
\begin{equation}
\left\langle A_{2}A_{4}\right\rangle _{\left( 2\right) 12}=-\frac{1}{4}%
\left(
A_{1256}A_{56}+A_{1246}A_{46}+A_{1236}A_{36}+A_{1245}A_{45}+A_{1235}A_{35}+A_{1234}A_{34}\right) x_{1}\wedge x_{2}
\end{equation}%
$\rfloor $

\section{Zeon Algebra}

\qquad The algebra formed from the even Fock algebra 
\begin{equation}
\mathcal{F}_{e}=\dbigwedge\limits_{0\leq p\leq 2r}\mathcal{F}_{2p}
\end{equation}%
is a \emph{Zeon algebra} as 
\begin{equation}
\left\langle A\right\rangle _{2p}\wedge \left\langle B\right\rangle
_{2q}=(-1)^{2\left( p+q\right) }\left\langle B\right\rangle _{2q}\wedge
\left\langle A\right\rangle _{2p}=\left\langle B\right\rangle _{2q}\wedge
\left\langle A\right\rangle _{2p}
\end{equation}%
and is generated by 
\begin{equation}
\left\{ \left. e_{jk}\right\vert e_{jk}=e_{j}\wedge e_{k}=e_{j}e_{k};1\leq
j<k\leq 2r\right\} \text{ and }I_{\mathcal{F}},
\end{equation}%
where 
\begin{equation}
\left( e_{jk}\right) ^{2}=\left( e_{jk}\right) ^{2\wedge }=0
\end{equation}%
i.e. are nilpotent. \emph{This condition makes it different from a standerd
symmetric tensor algebra. }The first and second order subspaces are
generated by the nilpotent elements 
\begin{align}
\mathcal{F}_{2}& =\limfunc{linspan}\left\{ \left. e_{jk}\right\vert 1\leq
j<k\leq 2r\right\} \\
\mathcal{F}_{4}& =\limfunc{linspan}\left\{ \left. e_{jklm}\right\vert
e_{jklm}=e_{jk}e_{lm};1\leq j<k<l<m\leq 2r\right\} .
\end{align}%
A general element of $\mathcal{F}_{2}$ is given by 
\begin{equation}
A_{2}=\dsum\limits_{1\leq j<k\leq 2r}A_{2jk}e_{jk}
\end{equation}%
and of $\mathcal{F}_{4}$ by 
\begin{equation}
A_{4}=\dsum\limits_{1\leq j<k<l<m\leq
2r}A_{4jklm}e_{jklm}=\dsum\limits_{1\leq j<k<l<m\leq
2r}A_{4jklm}e_{jk}e_{lm}=\frac{1}{2}\dsum\limits_{\substack{ 1\leq j<k\leq
2r  \\ 1\leq l<m\leq 2r}}\tilde{A}_{4jklm}e_{jk}e_{lm}=\frac{1}{2}%
\dsum\limits_{1\leq J,K\leq r\left( 2r-1\right) }\tilde{A}_{4JK}e_{J}e_{K}.
\end{equation}%
The basis $\left\{ \left. e_{J}e_{K}\right\vert 1\leq J<K\leq r\left(
2r-1\right) \right\} $ is overcomplete (i.e. linearly dependent) as e.g. 
\begin{equation}
e_{1234}=e_{12}e_{34}=-e_{13}e_{24}=e_{14}e_{23}\equiv e_{\mathbf{1}}e_{%
\mathbf{14}}=-e_{\mathbf{2}}e_{\mathbf{9}}=e_{\mathbf{3}}e_{\mathbf{8}}
\end{equation}%
giving 
\begin{equation}
A_{41234}=\tilde{A}_{41234}-\tilde{A}_{41324}+\tilde{A}_{41423}.
\end{equation}

$\lceil$For example $r=3$ then the bases is indexed by

\begin{equation}
\left\{ 
\begin{array}{c}
12-1,13-2,14-3,15-4,16-5,23-6,24-7,25-8,26-9,34-10,35-11, \\ 
36-12,45-13,46-14,56-15%
\end{array}%
\right\}
\end{equation}%
\begin{align}
& \left\{
12/34,12/35,12/36,12/45,12/46,12/56,13/45,13/46,13/56,14/56,23/45,23/46,23/56,24/56,34/56\right\}
\\
& \equiv \left\{
1/10,1/11,1/12,1/13,1/14,1/15,2/13,2/14,2/15,3/15,4/13,4/14,4/15,5/15,6/15%
\right\}
\end{align}%
\begin{align}
A_{4}& =\dsum\limits_{1\leq j<k<l<m\leq
6}A_{4jklm}e_{jklm}=\dsum\limits_{1\leq j<k<l<m\leq 6}A_{4jklm}e_{jk}e_{lm}
\\
&
=A_{41234}e_{12}e_{34}+A_{41235}e_{12}e_{35}+A_{41236}e_{12}e_{36}+A_{41245}e_{12}e_{45}+A_{41246}e_{12}e_{46}
\\
&
+A_{41256}e_{12}e_{56}+A_{41345}e_{13}e_{45}+A_{41346}e_{13}e_{46}+A_{41356}e_{13}e_{56}+A_{41456}e_{14}e_{56}
\\
&
+A_{42345}e_{23}e_{45}+A_{41246}e_{23}e_{46}+A_{42356}e_{23}e_{56}+A_{42456}e_{24}e_{56}+A_{43456}e_{34}e_{56}.
\end{align}%
$\rfloor $

The matrix of coefficients $\widetilde{\mathbb{A}}_{4}$ is symmetric and
real if $A_{4}$ is self adjoint (as $\left\{ e_{jk}\right\} $ are self
adjoint), it also has zero diagonal, thus $\limfunc{Tr}\widetilde{\mathbb{A}}%
_{4}=0$ and can be diagonalized to give 
\begin{equation}
\mathbb{G}^{t}\widetilde{\mathbb{A}}_{4}\mathbb{G=A}_{4D},
\end{equation}
where 
\begin{equation}
\mathbb{G}^{t}\mathbb{G=GG}^{t}=\mathbb{I}_{r\left( 2r-1\right) }
\end{equation}
and 
\begin{equation}
\widetilde{\mathbb{A}}_{4D}=\left( 
\begin{array}{ccc}
\alpha_{1} & \mathbb{O} & \mathbb{O} \\ 
\mathbb{O} & \ddots & \mathbb{O} \\ 
\mathbb{O} & \mathbb{O} & \alpha_{r\left( 2r-1\right) }%
\end{array}
\right) .
\end{equation}
Thus 
\begin{equation}
\widetilde{\mathbb{A}}_{4}=\mathbb{G}\widetilde{\mathbb{A}}_{4D}\mathbb{G}%
^{t}
\end{equation}
and 
\begin{equation}
\widetilde{A}_{4jklm}=\dsum \limits_{\substack{ 1\leq p<q\leq2r  \\ 1\leq
r<s\leq2r}}G_{jkpq}\widetilde{A}_{4Dpqrs}\delta_{\left( pq\right) \left(
rs\right) }G_{lmrs}=\dsum \limits_{1\leq p<q\leq2r}G_{jkpq}\widetilde{A}%
_{4Dpqpq}G_{lmpq}
\end{equation}
hence 
\begin{align}
A_{4} & =\dsum \limits_{1\leq j<k<l<m\leq2r}\widetilde{A}%
_{4jklm}e_{jk}e_{lm}=\frac{1}{2}\dsum \limits_{\substack{ 1\leq j<k\leq2r 
\\ 1\leq l<m\leq2r}}\dsum \limits_{1\leq p<q\leq2r}G_{jkpq}\widetilde{A}%
_{4Dpqpq}G_{lmpq}e_{jk}e_{lm} \\
& =\frac{1}{2}\dsum \limits_{1\leq p<q\leq2r}\dsum \limits_{\substack{ 1\leq
j<k\leq2r  \\ 1\leq l<m\leq2r}}G_{jkpq}\widetilde{A}%
_{4Dpqpq}G_{lmpq}e_{jk}e_{lm} \\
& =\dsum \limits_{1\leq p<q\leq2r}\widetilde{A}_{4Dpqpq}E_{pq}E_{pq},
\end{align}
where%
\begin{equation}
E_{pq}=\frac{1}{\sqrt{2}}\dsum \limits_{1\leq l<m\leq2r}G_{lmpq}e_{lm}.
\end{equation}
This can be expressed in canonical form as 
\begin{equation}
E_{pq}=\dsum \limits_{1\leq l\leq r}c_{pql}\varphi_{pqll+r};c_{pql}\in%
\mathbb{R}^{+},
\end{equation}
where 
\begin{equation}
\varphi_{pqll+r}=\varphi_{pql}\varphi_{pql+r}=\varphi_{pql}\wedge
\varphi_{pql+r}.
\end{equation}
If $A_{4Dpq}<0$ then we can replace the self adjoint operator $E_{pq}$ with
the anti selfadjoint operator $\widetilde{E_{pq}}=iE_{pq},$ while if it is
positive $\widetilde{E_{pq}}=E_{pq}$ to obtain 
\begin{equation}
A_{4}=\dsum \limits_{1\leq p<q\leq2r}\left\vert \widetilde{A}%
_{4Dpq}\right\vert \left( \widetilde{E_{pq}}\right) ^{2\wedge}.
\end{equation}

\subsection{Nilpotency}

The condition 
\begin{equation}
\left( A_{4}\right) ^{2\wedge}=\dsum \limits_{\substack{ 1\leq p<q\leq2r  \\ %
1\leq r<s\leq2r}}\left\vert A_{4Dpq}\right\vert \left\vert
A_{4Drs}\right\vert \widetilde{E_{pq}}\wedge\widetilde{E_{pq}}\wedge%
\widetilde{E_{rs}}\wedge\widetilde{E_{rs}}=0
\end{equation}
gives 
\begin{equation}
\left( A_{4}\right) ^{2\wedge}=\dsum \limits_{\substack{ 1\leq p<q\leq2r  \\ %
1\leq r<s\leq2r}}\left\vert \widetilde{A}_{4Dpq}\right\vert \left\vert 
\widetilde{A}_{4Drs}\right\vert \widetilde{E_{pq}}\wedge\widetilde{E_{rs}}%
\wedge \widetilde{E_{pq}}\wedge\widetilde{E_{rs}}=\dsum \limits_{\substack{ %
1\leq p<q\leq2r  \\ 1\leq r<s\leq2r}}\left\vert \widetilde{A}%
_{4Dpq}\right\vert \left\vert \widetilde{A}_{4Drs}\right\vert \left( 
\widetilde{E_{pq}}\wedge\widetilde{E_{rs}}\right) ^{2\wedge}=0.
\end{equation}

A basis for $\mathcal{F}_{4}$ is 
\begin{equation}
\left\{ \left. e_{jklm}\right\vert 1\leq j<k<l<m\leq2r\right\} ,
\end{equation}
where 
\begin{equation}
e_{jklm}=e_{jk}e_{lm}=e_{j}e_{k}e_{l}e_{m}.
\end{equation}
Products of different basis elements of $\mathcal{F}_{2}$ can produce the
same basis element of $\mathcal{F}_{4}$ e.g. 
\begin{equation}
e_{1234}=e_{12}e_{34}=-e_{13}e_{24}=e_{14}e_{23}
\end{equation}
and if any indices are in common the product is zero e.g. 
\begin{equation}
e_{12}e_{13}=0.
\end{equation}
\emph{Note} that these properties are $\emph{not}$ true for the operators $%
\left\{ \widetilde{E_{pq}}\right\} $ even though they form a basis for $%
\mathcal{F}_{2}.$

This analysis can be extended to $\mathcal{F}_{8}$ e.g. 
\begin{equation}
e_{12345678}=e_{1234}e_{5678}=-e_{1235}e_{4678}
\end{equation}
etc..

$\lceil$The number of such equalities is $\binom{8}{4}=\frac{8\times
7\times6\times5}{1\times2\times3\times4}=70\rfloor.$

\begin{align}
A_{4}\wedge A_{4} & =\dsum \limits_{1\leq
j<k<l<m\leq2r}A_{4jklm}e_{jklm}\wedge\dsum \limits_{1\leq
j<k<l<m\leq2r}A_{4jklm}e_{jklm}=\dsum \limits_{\substack{ 1\leq
j<k<l<m\leq2r  \\ 1\leq n<o<p<q\leq2r}}A_{4jklm}A_{4nopq}e_{jklm}\wedge
e_{nopq} \\
& =\dsum \limits_{1\leq j<k<l<m<n<o<p<q\leq2r}f\left(
A_{4jklm},A_{4nopq}\right) e_{jklmnopq}=\dsum \limits_{1\leq
j<k<l<m<n<o<p<q\leq2r}f_{jklmnopq}\left( A_{4}\right) e_{jklmnopq}
\end{align}
$\rfloor$

The nilpotency condition is then 
\begin{equation}
\left( f\left( A_{4jklm},A_{4nopq}\right) =f_{jklmnopq}\left( A_{4}\right)
=f_{jklmnopq}\left( \mathbb{A}_{4}\right) =0\right) \text{ or }%
e_{jklmnopq}=0\,\forall jklmnopq.
\end{equation}%
\begin{equation}
A_{4}\wedge A_{4}=\dsum \limits_{\substack{ 1\leq J\leq\binom{2r}{4}  \\ %
1\leq K\leq \binom{2r}{4}}}A_{4J}A_{4K}e_{J}\wedge e_{K}=\frac{1}{2}\dsum
\limits_{1\leq J<K\leq\binom{2r}{4}}A_{4J}A_{4K}e_{J}\wedge e_{K}
\end{equation}%
\begin{align}
e_{J}\wedge e_{K} & =e_{K}\wedge e_{J} \\
e_{J}\wedge e_{K} & =0\Leftrightarrow J\cap K\neq\phi \\
e_{J}\wedge e_{K} & \neq0\Leftrightarrow J\cap K=\phi
\end{align}%
\begin{equation}
e_{J_{1}}\wedge e_{K_{1}}=\left( -1\right) ^{\pi\left( \sigma\right)
}e_{J_{2}}\wedge e_{K_{2}}\Leftrightarrow J_{1}\cup K_{1}=J_{2}\cup K_{2}
\end{equation}
where 
\begin{equation}
\sigma\left( \left\{ J_{1}K_{1}\right\} \right) =\left\{ J_{2}K_{2}\right\}
\end{equation}
and $\pi$ is the parity of $\sigma.$

If 
\begin{equation}
A_{4}=\dsum \limits_{1\leq j<k<l<m\leq6}A_{4jklm}e_{jklm}
\end{equation}
then 
\begin{equation}
A_{4}\wedge A_{4}=0,
\end{equation}
while if

\begin{align}
A_{4} & =\dsum \limits_{1\leq j<k<l<m\leq8}A_{4jklm}e_{jklm} \\
A_{4}\wedge A_{4} & \neq0
\end{align}
unless 
\begin{equation}
f_{12345678}\left( \mathbb{A}_{4}\right) =0.
\end{equation}
Zero replacements 
\begin{equation}
+1234/5678,
\end{equation}
one replacement%
\begin{align}
& -1235/4678,+1236/4578,-1237/4568,+1238/4567, \\
& +1245/3678,-1246/3578,+1247/3568,-1248/3567, \\
& -1345/2678,+1346/2578,-1347/2568,+1348/2567, \\
& +2345/1678,-2346/1578,+2347/1568,-2348/1567,
\end{align}
two replacements (are self transpose) 
\begin{align}
& 3478/1256,3468/1257,3467/1258,3458/1267,3457/1268,3456/1278, \\
& 2478/1356,2468/1357,2467/1358,2458/1367,2457/1368,2456/1378, \\
& 2378/1456,2368/1457,2367/1458,2358/1467,2357/1468,2356/1478, \\
& 1478/2356,1468/2357,1467/2358,1458/2367,1457/2368,1456/2378, \\
& 1378/2456,1368/2457,1367/2458,1358/2467,1357/2468,1356/2478, \\
& 1278/3456,1268/3457,1267/3458,1258/3467,1257/3468,1256/3478,
\end{align}
three replacements are the transpose of the one replacements and four
replacements the transpose of the zero replacements.

The linearized subscripts give 
\begin{align}
& f_{12345678}\left( \mathbb{A}_{4}\right) =f_{1,70}\left( \mathbb{A}%
_{4}\right) =A_{1}A_{70} \\
& -A_{2}A_{69}+A_{3}A_{68}-A_{4}A_{67}+A_{5}A_{66} \\
& +A_{6}A_{65}-A_{7}A_{64}+A_{8}A_{63}-A_{9}A_{62} \\
& -A_{16}A_{55}+A_{17}A_{54}-A_{18}A_{53}+A_{19}A_{52} \\
& +A_{36}A_{35}-A_{37}A_{34}+A_{38}A_{33}-A_{39}A_{32} \\
&
+A_{61}A_{10}-A_{60}A_{11}+A_{59}A_{12}-A_{58}A_{13}+A_{57}A_{14}-A_{56}A_{15}
\\
&
+A_{51}A_{20}-A_{50}A_{21}+A_{49}A_{22}-A_{48}A_{23}+A_{47}A_{24}-A_{46}A_{25}
\\
&
+A_{45}A_{26}-A_{44}A_{27}+A_{43}A_{28}-A_{42}A_{29}+A_{41}A_{30}-A_{40}A_{31}
\end{align}
and the quadratic subscripts give 
\begin{align}
& f_{12345678}\left( \mathbb{A}_{4}\right) =f_{\left( 1,14\right) ,\left(
23,28\right) }\left( \mathbb{A}_{4}\right) =A_{1,14}A_{23,28} \\
& -A_{1,15}A_{20,28}+A_{1,16}A_{19,28}-A_{1,17}A_{19,27}+A_{1,18}A_{19,26} \\
& +A_{1,19}A_{16,28}-A_{1,20}A_{15,28}+A_{1,21}A_{15,27}-A_{1,22}A_{15,26} \\
& -A_{2,19}A_{11,28}+A_{2,19}A_{10,28}-A_{2,19}A_{10,27}+A_{2,19}A_{10,26} \\
& +A_{8,19}A_{5,28}-A_{8,20}A_{4,28}+A_{8,21}A_{4,27}-A_{8,22}A_{4,26}
\end{align}

\subsection{Compound Indices}

The ordered pairs $\left( j,k\right) $ can be expressed as a single index $%
J\left( j,k\right) ,$where the transformation is 
\begin{equation}
J\left( j,k\right) =2r\left( j-1\right) -j\left( j+1\right) /2+k;1\leq
j<k\leq2r.
\end{equation}
One can check this formula for $r=3$ by:

\begin{equation}
\begin{array}{ccc}
j & k & J\left( j,k\right) \\ 
1 & 2 & 6\left( 1-1\right) -1\left( 1+1\right) /2+2=1 \\ 
1 & 3 & 6\left( 1-1\right) -1\left( 1+1\right) /2+3=2 \\ 
1 & 4 & 6\left( 1-1\right) -1\left( 1+1\right) /2+4=3 \\ 
1 & 5 & 6\left( 1-1\right) -1\left( 1+1\right) /2+5=4 \\ 
1 & 6 & 6\left( 1-1\right) -1\left( 1+1\right) /2+6=5 \\ 
2 & 3 & 6\left( 2-1\right) -2\left( 2+1\right) /2+3=6 \\ 
2 & 4 & 6\left( 2-1\right) -2\left( 2+1\right) /2+4=7 \\ 
2 & 5 & 6\left( 2-1\right) -2\left( 2+1\right) /2+5=8 \\ 
2 & 6 & 6\left( 2-1\right) -2\left( 2+1\right) /2+6=9 \\ 
3 & 4 & 6\left( 3-1\right) -3\left( 3+1\right) /2+4=10 \\ 
3 & 5 & 6\left( 3-1\right) -3\left( 3+1\right) /2+5=11 \\ 
3 & 6 & 6\left( 3-1\right) -3\left( 3+1\right) /2+6=12 \\ 
4 & 5 & 6\left( 4-1\right) -4\left( 4+1\right) /2+5=13 \\ 
4 & 6 & 6\left( 4-1\right) -4\left( 4+1\right) /2+6=14 \\ 
5 & 6 & 6\left( 5-1\right) -5\left( 5+1\right) /2+6=15%
\end{array}%
\end{equation}

\bigskip One can classify this term into $0-$substition, $1-$substition, $2-$%
substitions, $3-$substitions, and $4-$substitions:

\begin{enumerate}
\item $0-$substition :%
\begin{equation}
12345678
\end{equation}

\item $1-$substition :%
\begin{equation}
\binom{4}{1}^{2}=16
\end{equation}%
