1\leq ,j_{3},j_{4}\leq r}}\lambda _{2j_{1}j_{2}j_{3}j_{4}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger }a_{j_{4}}a_{j_{3}}=\sum_{\substack{ 1\leq
j_{1}<j_{2}\leq r  \\ 1\leq ,j_{3}<j_{4}\leq r}}\left( \lambda
_{2j_{1}j_{2}j_{3}j_{4}}-\lambda _{2j_{2}j_{1}j_{3}j_{4}}-\lambda
_{2j_{1}j_{2}j_{4}j_{3}}+\lambda _{2j_{2}j_{1}j_{4}j_{3}}\right)
a_{j_{1}}^{\dagger }a_{j_{2}}^{\dagger }a_{j_{4}}a_{j_{3}}
\end{equation}
\end{remark}

\begin{enumerate}
\item \bigskip The zeroth degree terms are are after setting $%
j_{3}=j_{1},j_{4}=j_{2}$%
\begin{align}
& \left\langle \sum_{\substack{ 1\leq j_{1}<j_{2}\leq r  \\ 1\leq
,j_{3}<j_{4}\leq r}}\lambda _{2j_{1}j_{2}j_{3}j_{4}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger }a_{j_{4}}a_{j_{3}}\right\rangle _{0}=\frac{1}{4}%
\sum_{1\leq j_{1},j_{2}\leq r}\lambda _{2j_{1}j_{2}j_{1}j_{2}}\left\{
x_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}\right\}
\notag \\
& =\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq r}\lambda
_{2j_{1}j_{2}j_{1}j_{2}}I_{\mathcal{F}}=\frac{1}{4}\left. \limfunc{Tr}%
\right. _{2}\left\{ \lambda _{2}\right\} I_{\mathcal{F}}.
\end{align}

\item The second degree terms are after setting $%
