\subsection{P$^{\text{th}}$ Order Reduced Density Operator}

In general a positive linear functional $f_{P}$ defined on $\Lambda_{P}$ i.e.
\begin{equation}
f_{P}:\Lambda_{P}\rightarrow\mathbb{R},1\leq P\leq N-1
\end{equation}
can be extended to a positive linear functional $f_{P}^{N}$ (not uniquely)
defined on $\Lambda_{N}$ $\supseteq\Lambda_{N-1}\supseteq\cdots\supseteq
\Lambda_{1}$ if
\begin{equation}
0\leq f_{P}\left(  \lambda_{P}\right)  \leq1\,\forall\lambda_{P}%
\in\mathfrak{B}_{1}\left(  \Lambda_{P}\right)  \Leftrightarrow\left(
\left\Vert \lambda_{P}\right\Vert \leq1\&\lambda_{P}\geq0\right)
\end{equation}
and
\begin{align}
f_{P}\left(  \mathcal{N}_{1}\right)   &  =N\nonumber\\
&  \vdots\nonumber\\
f_{P}\left(  \mathcal{N}_{P}\right)   &  =\binom{N}{P}.
\end{align}
Then
\begin{equation}
f_{P}^{N}\left(  X\right)  =\operatorname*{Tr}\left\{  XD^{N}\right\}
,X\in\mathcal{B}_{sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},
\end{equation}
and
\begin{equation}
f_{P}^{N}\left(  \eta_{P}\right)  =f_{P}\left(  \eta_{P}\right)
=\operatorname*{Tr}\left\{  \eta_{P}D^{N}\right\}  ,\eta_{P}\in\Lambda_{P},
\end{equation}
where $D^{N}\in S_{N}\ $and
\begin{equation}
f_{P}^{N}\left(  \left(  \mathcal{N}_{1}\right)  ^{2}\right)  =N^{2}.
\end{equation}


\subsection{N-Electron Density Operator}%

\begin{equation}
f^{N}\left(  X\right)  =\operatorname*{Tr}\left\{  XD^{N}\right\}
,X\in\mathcal{B}_{sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}%
\begin{align}
f^{N}\left(  \mathcal{N}_{1}\right)   &  =N\nonumber\\
&  \vdots\nonumber\\
f^{N}\left(  \mathcal{N}_{P}\right)   &  =\binom{N}{P}\nonumber\\
&  \vdots\nonumber\\
f^{N}\left(  \mathcal{N}_{N}\right)   &  =1
\end{align}%
\begin{equation}
f^{N}\left(  \left(  \mathcal{N}_{1}\right)  ^{2}\right)  =N^{2}.
\end{equation}


\section{Invariant Subspaces of $U\left(  \mathcal{H}^{1}\right)  $}

The expansion map is the adjoint of contraction map i.e.
\begin{equation}
\left(  \left.  \Gamma_{P}^{N}\left(  X\right)  \right\vert Y\right)
_{N}=\left(  \left.  X\right\vert L_{N}^{P}\left(  Y\right)  \right)  _{P}.
\end{equation}
One can expand $\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)  $ as a direct
sum
\begin{equation}
\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)  =%
%TCIMACRO{\dbigoplus \limits_{0\leq P\leq N}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq P\leq N}}
%EndExpansion
\mathfrak{B}_{NP},
\end{equation}
where
\begin{equation}
\mathfrak{B}_{NP}=\ker\left\{  L_{N}^{P-1}\right\}  \ominus\ker\left\{
L_{N}^{P}\right\}  ,1\leq P\leq N.
\end{equation}
It is easy to see that%
\begin{equation}
\ker\left\{  L_{N}^{0}\right\}  \supseteq\cdots\supseteq\ker\left\{  L_{N}%
^{N}\right\}
\end{equation}
and%
\begin{equation}
\operatorname*{Tr}\left\{  Y\right\}  =L_{N}^{0}\left(  Y\right)
\end{equation}
so that
\begin{equation}
Y\in\ker\left\{  L_{N}^{0}\right\}  \Leftrightarrow\operatorname*{Tr}\left\{
Y\right\}  =0
\end{equation}
and hence
\begin{equation}
Y\in\ker\left\{  L_{N}^{P}\right\}  ,1\leq P\leq N\Rightarrow
\operatorname*{Tr}\left\{  Y\right\}  =0.
\end{equation}
One should note that
\begin{equation}
\ker\left\{  L_{N}^{N}\right\}  =\phi
\end{equation}
as
\begin{equation}
L_{N}^{N}=\widehat{I_{N}}.
\end{equation}
Any operator $X_{N}\in\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)  $ can
be expanded as
\begin{equation}
X_{N}=X_{NN}+\cdots+X_{N1}+X_{N0},
\end{equation}
where
\begin{equation}
X_{NP}\in\mathfrak{B}_{NP};1\leq P\leq N
\end{equation}
and
\begin{equation}
X_{N0}=X_{N}-\left(  X_{NN}+\cdots+X_{N1}\right)  ,
\end{equation}
so that
\begin{align}
\operatorname*{Tr}\left\{  X_{N}\right\}   &  =\operatorname*{Tr}\left\{
X_{N0}\right\} \nonumber\\
\operatorname*{Tr}\left\{  X_{NP}\right\}   &  =0,1\leq P\leq N.
\end{align}


Each subspace $\mathcal{H}^{N}$ carries a representation of $U\left(
\mathcal{H}^{1}\right)  $ given by
\begin{equation}
u_{N}\left\vert \varphi_{1}\cdots\varphi_{N}\right\rangle =u\wedge\cdots\wedge
u\left\vert \varphi_{1}\cdots\varphi_{N}\right\rangle =\left\vert u\varphi
_{1}\cdots u\varphi_{N}\right\rangle
\end{equation}
and it can be shown that
\begin{equation}
L_{N}^{P}\left(  u_{N}Xu_{N}^{\dagger}\right)  =u_{P}L_{N}^{P}\left(
X\right)  u_{P}^{\dagger},X\in\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)
\end{equation}
thus
\begin{equation}
u_{N}Xu_{N}^{\dagger}\in\ker\left\{  L_{N}^{P}\right\}  \Leftrightarrow
X\in\ker\left\{  L_{N}^{P}\right\}
\end{equation}
i.e. $\ker\left\{  L_{N}^{P}\right\}  $ is invariant (but reducible) under the
action of $SU\left(  \mathcal{H}^{1}\right)  $
\begin{equation}
\widehat{u_{N}}:\ker\left\{  L_{N}^{P}\right\}  \rightarrow\ker\left\{
L_{N}^{P}\right\}
\end{equation}
and
\begin{equation}
\widehat{u_{P}}\circ L_{N}^{P}=L_{N}^{P}\circ\widehat{u_{N}}.
\end{equation}
The Hilbert-Schmidt space $\mathcal{B}_{2sa}\left(  \mathcal{H}^{N}\right)  $
carries a representation of $U\left(  \mathcal{H}^{1}\right)  $
\begin{equation}
\widehat{u_{N}}\left(  A\right)  =u_{N}Au_{N}^{\dagger},\,A\in\mathcal{B}%
_{2sa}\left(  \mathcal{H}^{N}\right)
\end{equation}
that is reducible and has the direct sum decomposition
\begin{equation}
\mathcal{B}_{2sa}\left(  \mathcal{H}^{N}\right)  =%
%TCIMACRO{\dbigoplus \limits_{0\leq P\leq N}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq P\leq N}}
%EndExpansion
\mathfrak{B}_{NP},
\end{equation}
into \emph{orthogonal }irreducible subspaces $\left\{  \mathfrak{B}_{NP};0\leq
P\leq N\right\}  ,$ where
\begin{equation}
\mathfrak{B}_{N0}=\mathbb{R}.
\end{equation}
These spaces have the property
\begin{align}
X_{N}  &  =\sum_{0\leq P\leq N}X_{NP},X_{NP}\in\mathfrak{B}_{NP};0\leq P\leq
N\\
\sum_{Q+1\leq P\leq N}X_{NP}  &  \in\ker\left\{  L_{N}^{Q}\right\}  ,
\end{align}
where
\begin{equation}
X_{N0}=\operatorname*{Tr}\left\{  X_{N}\right\}  P_{N}.
\end{equation}
If $X_{N}$ $\notin\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)  $ then
$\operatorname*{Tr}\left\{  X_{N}\right\}  $ can be formally set as $\infty$
or $-\infty.$

The pure part expansion can be generalized to the space $\mathcal{B}%
_{2sa}\left(  \mathcal{H}_{F}\right)  _{e}$ which expanded as
\begin{align}
\mathcal{B}_{0sa}\left(  \mathcal{H}_{F}\right)  _{e}  &  =%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}_{0sa}\left(  \mathcal{H}^{N}\right)  _{e}=%
%TCIMACRO{\dbigoplus \limits_{\substack{0\leq N\leq\infty\\0\leq P\leq N}}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{\substack{0\leq N\leq\infty\\0\leq P\leq N}}}
%EndExpansion
\mathfrak{B}_{NP}\\
X  &  =\sum_{\substack{0\leq N\leq\infty\\0\leq P\leq N}}X_{NP}=\sum_{0\leq
P\leq\infty}\sum_{P\leq N\leq\infty}X_{NP}=\sum_{0\leq P\leq\infty}X_{P},
\end{align}
where
\begin{equation}
X_{P}=\sum_{P\leq N\leq\infty}X_{NP}.
\end{equation}
In particular
\begin{equation}
X_{0}=\sum_{0\leq N\leq\infty}X_{N0}=\operatorname*{Tr}\left\{  X\right\}  I
\end{equation}
and
\begin{equation}
X=\sum_{0\leq P\leq\infty}X_{_{j_{1}\cdots j_{P}k_{1}\cdots k_{P}}}a_{j_{1}%
}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}.
\end{equation}
For example
\begin{align}
&  \mathcal{B}_{2sa}\left(  \mathcal{H}_{F}\right)  _{e2}=\left\{
\sum_{_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty}%
}}X_{_{j_{1}j_{2}k_{1}k_{2}}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}\right\} \\
&  =\left\{  \sum_{_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}%
<k_{2}\leq\infty}}}\left(  X_{_{0j_{1}j_{2}k_{1}k_{2}}}+X_{_{1j_{1}j_{2}%
k_{1}k_{2}}}+X_{_{2j_{1}j_{2}k_{1}k_{2}}}\right)  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}\right\} \\
&  =\left\{  X_{_{0}}\mathcal{N}_{2}\right\}  \bigcup\left\{  \sum_{_{1\leq
j_{1}\neq k_{1}\leq\infty}}X_{_{1j_{1}k_{1}}}a_{j_{1}}^{\dagger}%
\mathcal{N}_{1}a_{k_{1}}\right\} \\
&  \bigcup\left\{  \sum_{_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq
k_{1}<k_{2}\leq\infty}}}X_{_{2j_{1}j_{2}k_{1}k_{2}}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\right\}
\end{align}
The space $\mathcal{B}_{2sa}\left(  \mathcal{H}_{F}\right)  _{e}$ thus also
carries a representation of $U\left(  \mathcal{H}^{1}\right)  $ as
\begin{align}
\widehat{u}(A)  &  =uAu^{\dagger}=\sum_{0\leq N\leq\infty}\widehat{u_{N}%
}\left(  A_{N}\right)  =\sum_{\substack{0\leq P\leq N\\0\leq N\leq\infty
}}\widehat{u_{N}}\left(  A_{NP}\right)  ,\\
\widehat{u_{N}}  &  =\left.  \widehat{u}\right\vert _{\mathcal{B}_{2sa}\left(
\mathcal{H}^{N}\right)  }%
\end{align}
and
\begin{equation}
u\left(  \lambda\right)  =\exp i\left\{  \sum_{1\leq j,k\leq\infty}%
\lambda_{jk}a_{j}^{\dagger}a_{k}\right\}  ;\lambda_{jk}=\overline{\lambda
}_{kj},1\leq j,k\leq\infty.
\end{equation}
One can also note that
\begin{equation}
\mathcal{B}_{2sa}\left(  \mathcal{H}_{F}\right)  _{e}=\mathfrak{U}\left(
U\left(  \mathcal{H}^{1}\right)  \right)  ,
\end{equation}
where $\mathfrak{U}\left(  U\left(  \mathcal{H}^{1}\right)  \right)  $ is a
representation of the universal covering algebra of $U\left(  \mathcal{H}%
^{1}\right)  .$

The space $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{o}$ also
carries a representation of $U\left(  \mathcal{H}^{1}\right)  .$%

\begin{equation}
\left(  1-a^{\dagger}a\right)  \left(  1-aa^{\dagger}\right)  =1-\left(
a^{\dagger}a+aa^{\dagger}\right)  +a^{\dagger}aaa^{\dagger}=0
\end{equation}%
\begin{align}
a^{\dagger}aa^{\dagger}b  &  =a^{\dagger}\left(  1-a^{\dagger}a\right)
b=a^{\dagger}b\nonumber\\
a^{\dagger}ba^{\dagger}a  &  =0\nonumber\\
a^{\dagger}ab^{\dagger}a  &  =0\nonumber\\
b^{\dagger}aa^{\dagger}a  &  =b^{\dagger}\left(  1-a^{\dagger}a\right)
a=b^{\dagger}a
\end{align}%
\begin{align}
aa^{\dagger}Aa^{\dagger}a  &  =\nonumber\\
a^{\dagger}aAaa^{\dagger}  &  =a^{\dagger}baa^{\dagger}=a^{\dagger}b\left(
1-a^{\dagger}a\right)  =a^{\dagger}b
\end{align}


\section{Projectors in $\mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}$}

Are $\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right\}  $ the only projectors? i.e. can
\begin{equation}
g^{\dagger}gg^{\dagger}g=g^{\dagger}g,
\end{equation}
only when
\begin{equation}
g^{\dagger}g=a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}?
\end{equation}
First one must determine the commutator%
\begin{equation}
\left[  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger},a_{j_{4}}a_{j_{3}}\right]
\end{equation}
thus one brings $a_{j_{4}}a_{j_{3}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}$ to
normal form as
\begin{align}
&  a_{j_{4}}a_{j_{3}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=a_{j_{4}}\left(
I\delta_{j_{3}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{3}}\right)  a_{j_{2}}^{\dagger
}=a_{j_{4}}a_{j_{2}}^{\dagger}\delta_{j_{3}j_{1}}-a_{j_{4}}a_{j_{1}}^{\dagger
}a_{j_{3}}a_{j_{2}}^{\dagger}=\nonumber\\
&  \left(  \delta_{j_{4}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{4}}\right)
\delta_{j_{3}j_{1}}-\left(  I\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{4}%
}\right)  \left(  I\delta_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{3}}\right)
=\nonumber\\
&  I\delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-a_{j_{2}}^{\dagger}a_{j_{4}}%
\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta_{j_{3}j_{2}}+a_{j_{1}}%
^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{4}}a_{j_{2}}^{\dagger}a_{j_{3}%
}=\nonumber\\
I  &  \delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-a_{j_{2}}^{\dagger}a_{j_{4}%
}\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta_{j_{3}j_{2}}+a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}\left(  \delta_{j_{4}j_{2}}-a_{j_{2}%
}^{\dagger}a_{j_{4}}\right)  a_{j_{3}}=\nonumber\\
I  &  \delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta
_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{1}}+a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{3}}\delta_{j_{4}j_{2}}+a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{4}}a_{j_{3}},
\end{align}
hence
\begin{align}
&  a_{j_{4}}a_{j_{3}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=\nonumber\\
&  I\delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta
_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{1}}+a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{3}}\delta_{j_{4}j_{2}}+a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{4}}a_{j_{3}}%
\end{align}
and
\begin{equation}
\left[  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger},a_{j_{4}}a_{j_{3}}\right]
=I\delta_{j_{4}j_{1}}\delta_{j_{3}j_{2}}-I\delta_{j_{4}j_{2}}\delta
_{j_{3}j_{1}}+a_{j_{2}}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{1}}-a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}+a_{j_{1}}^{\dagger}a_{j_{3}}\delta_{j_{4}j_{2}}%
\end{equation}


\begin{theorem}
\bigskip$g^{\dagger}gg^{\dagger}g=g^{\dagger}g\Longleftrightarrow g^{\dagger
}=a_{j}^{\dagger}a_{k}^{\dagger},$ when $\left\Vert g\right\Vert
_{\mathcal{H}^{2}}^{2}=1$ and $c_{1}\neq0$%
\begin{equation}
g^{\dagger}gg^{\dagger}g=\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq s}a_{j_{1}%
}^{\dagger}a_{j_{1+s}}^{\dagger}a_{j_{2}}a_{j_{2+s}}a_{j_{3}}^{\dagger
}a_{j_{3+s}}^{\dagger}a_{j_{4}}a_{j_{4+s}}c_{j_{1}}c_{j_{2}}c_{j_{3}}c_{j_{4}}%
\end{equation}
Observing that
\begin{align}
&  a_{j_{2}}a_{j_{2+s}}a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}\nonumber\\
&  =\delta_{j_{2}j_{3+s}}\delta_{j_{2+s}j_{3}}-\delta_{j_{2}j_{3}}%
\delta_{j_{2+s}j_{3+s}}-a_{j_{3+s}}^{\dagger}a_{j_{2}}\delta_{j_{2+s}j_{3}%
}+\nonumber\\
&  \quad+a_{j_{3}}^{\dagger}a_{j_{2}}\delta_{j_{2+s}j_{3+s}}+a_{j_{3+s}%
}^{\dagger}a_{j_{2+s}}\delta_{j_{2}j_{3}}-a_{j_{3}}^{\dagger}a_{j_{2+s}}%
\delta_{j_{2}j_{3+s}}+a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}a_{j_{2+s}%
}a_{j_{2}}\nonumber\\
&  =-I\delta_{j_{2}j_{3}}+a_{j_{3}}^{\dagger}a_{j_{2}}\delta_{j_{2}j_{3}%
}+a_{j_{3}}^{\dagger}a_{j_{2}}\delta_{j_{2}j_{3}}+a_{j_{3}}^{\dagger
}a_{j_{3+s}}^{\dagger}a_{j_{2+s}}a_{j_{2}}%
\end{align}
one obtains%
\begin{align}
&  g^{\dagger}gg^{\dagger}g=\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq s}%
a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger}\left(  -\delta_{j_{2}j_{3}}+a_{j_{3}%
}^{\dagger}a_{j_{2}}\delta_{j_{2}j_{3}}+a_{j_{3}+s}^{\dagger}a_{j_{2}+s}%
\delta_{j_{2}j_{3}}+a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}a_{j_{2+s}%
}a_{j_{2}}\right) \nonumber\\
&  \qquad\qquad\qquad\times a_{j_{4}}a_{j_{4+s}}c_{j_{1}}c_{j_{2}}c_{j_{3}%
}c_{j_{4}}\nonumber\\
&  =\sum_{1\leq j_{1},j_{4}\leq s}a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger
}a_{j_{4+s}}a_{j_{4}}c_{j_{1}}c_{j_{4}}\left\Vert g\right\Vert _{\mathcal{H}%
^{2}}^{2}\nonumber\\
&  \qquad+\sum_{1\leq j_{1},j_{2},j_{4}\leq s}a_{j_{1}}^{\dagger}a_{j_{1+s}%
}^{\dagger}\left(  a_{j_{2}}^{\dagger}a_{j_{2}}+a_{j_{2}+s}^{\dagger}%
a_{j_{2}+s}\right)  a_{j_{4}}a_{j_{4+s}}c_{j_{1}}n_{j_{2}}c_{j_{4}}\nonumber\\
&  \quad\qquad+\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq s}a_{j_{1}}^{\dagger
}a_{j_{1+s}}^{\dagger}a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}a_{j_{2+s}%
}a_{j_{2}}a_{j_{4}}a_{j_{4+s}}c_{j_{1}}c_{j_{2}}c_{j_{3}}c_{j_{4}}.
\end{align}
Hence
\begin{align}
g^{\dagger}gg^{\dagger}g-g^{\dagger}g  &  =0\Rightarrow\nonumber\\
a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger}\left(  a_{j_{2}}^{\dagger}a_{j_{2}%
}+a_{j_{2}+s}^{\dagger}a_{j_{2}+s}\right)  a_{j_{4}}a_{j_{4+s}}  &
=0\nonumber\\
a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger}a_{j_{3}}^{\dagger}a_{j_{3+s}%
}^{\dagger}a_{j_{2+s}}a_{j_{2}}a_{j_{4}}a_{j_{4+s}}  &  =0
\end{align}
and the only solution is $s=1.$ Consider $s=2$ then e.g.%
\begin{align}
a_{1}^{\dagger}a_{3}^{\dagger}\left(  a_{2}^{\dagger}a_{2}+a_{4}^{\dagger
}a_{4}\right)  a_{1}a_{3}n_{1}n_{2}  &  =0\nonumber\\
a_{1}^{\dagger}a_{3}^{\dagger}a_{2}^{\dagger}a_{4}^{\dagger}a_{3}a_{1}%
a_{2}a_{4}n_{1}n_{2}  &  =0,
\end{align}
which is not possible unless $n_{2}=0.$
\end{theorem}

\section{Generalized P-Condition}

The generalized P-condition is based on the product
\begin{equation}
A^{\dagger}A,
\end{equation}
where
\begin{equation}
A=a_{j_{2}}a_{j_{1}},
\end{equation}
i.e.%
\begin{equation}
A^{\dagger}A=a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}.
\end{equation}


If $f$ is a state then%
\begin{equation}
1\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right)  \geq0
\end{equation}


\section{Generalized Q-Condition}

The generalized Q-condition is based on the product
\begin{equation}
A^{\dagger}A,
\end{equation}
where
\begin{equation}
A=a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger},
\end{equation}
i.e.%
\begin{equation}
A^{\dagger}A=a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}.
\end{equation}
This operator is a projector as
\begin{align}
\left(  a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\right)  ^{2}
&  =a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger
}\left(  1-a_{j_{2}}a_{j_{2}}^{\dagger}\right)  a_{j_{1}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}=\nonumber\\
&  =a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}-a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}a_{j_{2}}^{\dagger
}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\nonumber\\
&  =a_{j_{2}}a_{j_{1}}\left(  1-a_{j_{1}}a_{j_{1}}^{\dagger}\right)  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}+a_{j_{2}}a_{j_{1}}a_{j_{2}}a_{j_{1}}a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\nonumber\\
&  =a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}-a_{j_{2}}%
a_{j_{1}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\nonumber\\
&  =a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}.
\end{align}
Noting that
\begin{equation}
a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=I_{\mathcal{H}%
_{\mathcal{F}}}-a_{j_{2}}^{\dagger}a_{j_{2}}-a_{j_{1}}^{\dagger}a_{j_{1}%
}+a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}%
\end{equation}
one has
\begin{equation}
f\left(  a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\right)
=1-f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)  -f\left(  a_{j_{1}}^{\dagger
}a_{j_{1}}\right)  +f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}%
}a_{j_{1}}\right)
\end{equation}
and if $f$ is a state then
\begin{align}
1  &  \geq f\left(  a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\right)  \geq0\Leftrightarrow1\geq1-f\left(  a_{j_{2}}^{\dagger}a_{j_{2}%
}\right)  -f\left(  a_{j_{1}}^{\dagger}a_{j_{1}}\right)  +f\left(  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0\nonumber\\
&  \Leftrightarrow0\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{j_{2}}a_{j_{1}}\right)  -f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)
-f\left(  a_{j_{1}}^{\dagger}a_{j_{1}}\right)  \geq-1\nonumber\\
&  \Leftrightarrow1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)
+f\left(  a_{j_{1}}^{\dagger}a_{j_{1}}\right)  -f\left(  a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0
\end{align}
\emph{One should note however that}
\begin{equation}
a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\notin\Lambda
_{2}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}\oplus
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2},
\end{equation}
but
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}-a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}%
\end{equation}
does, as
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}-a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}=a_{j_{1}}^{\dagger}a_{j_{1}}+a_{j_{2}}^{\dagger}a_{j_{2}},
\end{equation}
which is a projector as%
\begin{align}
\left(  I_{\mathcal{H}_{\mathcal{F}}}-a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}\right)  ^{2}  &  =I_{\mathcal{H}_{\mathcal{F}}}%
-2a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}+\left(  a_{j_{2}%
}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\right)  ^{2}\nonumber\\
&  =I_{\mathcal{H}_{\mathcal{F}}}-a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}.
\end{align}
This condition can be formulated as
\begin{align}
1  &  \geq f\left(  \Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\chi\right)  \right)  +f\left(  \Phi\left(  \psi\right)  ^{\dagger}\Phi\left(
\psi\right)  \right)  -f\left(  \Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\psi\right)  ^{\dagger}\Phi\left(  \chi\right)  \Phi\left(  \psi\right)
\right)  \geq0\nonumber\\
&  \left.  \forall\right.  \left\langle \chi\left\vert \psi\right.
\right\rangle =0;\left\langle \psi\left\vert \psi\right.  \right\rangle
=\left\langle \chi\left\vert \chi\right.  \right\rangle =1
\end{align}


\section{Generalized G-Condition}

The generalized G-condition is based on the product
\begin{equation}
A^{\dagger}A,
\end{equation}
where
\begin{equation}
A=a_{j_{1}}^{\dagger}a_{j_{2}},
\end{equation}
i.e.%
\begin{equation}
A^{\dagger}A=a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}%
=a_{j_{2}}^{\dagger}\left(  I_{\mathcal{H}_{\mathcal{F}}}-a_{j_{1}}^{\dagger
}a_{j_{1}}\right)  a_{j_{2}}=a_{j_{2}}^{\dagger}a_{j_{2}}-a_{j_{2}}^{\dagger
}a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}.
\end{equation}
The operator $a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}%
}=n_{j_{1}}n_{j_{2}}$ is a projector as
\begin{equation}
n_{j_{1}}n_{j_{2}}n_{j_{1}}n_{j_{2}}=n_{j_{1}}n_{j_{1}}n_{j_{2}}n_{j_{2}%
}=n_{j_{1}}n_{j_{2}}%
\end{equation}
and
\begin{equation}
a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}\in\Lambda_{2}.
\end{equation}


If $f$ is a state then the Generalized G-condition gives
\begin{align}
1  &  \geq f\left(  a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}%
}\right)  =f\left(  a_{j_{2}}^{\dagger}\left(  I-a_{j_{1}}^{\dagger}a_{j_{1}%
}\right)  a_{j_{2}}\right)  =f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}-a_{j_{2}%
}^{\dagger}a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}\right)  \geq0\nonumber\\
&  \Leftrightarrow1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)
-f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)
\geq0.
\end{align}
This condition can be formulated as
\begin{align}
1  &  \geq f\left(  \Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\chi\right)  \right)  -f\left(  \Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\psi\right)  ^{\dagger}\Phi\left(  \chi\right)  \Phi\left(  \psi\right)
\right)  \geq0\nonumber\\
1  &  \geq f\left(  \Phi\left(  \psi\right)  ^{\dagger}\Phi\left(
\psi\right)  \right)  -f\left(  \Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\psi\right)  ^{\dagger}\Phi\left(  \chi\right)  \Phi\left(  \psi\right)
\right)  \geq0\nonumber\\
&  \left.  \forall\right.  \left\langle \chi\left\vert \psi\right.
\right\rangle =0;\left\langle \psi\left\vert \psi\right.  \right\rangle
=\left\langle \chi\left\vert \chi\right.  \right\rangle =1
\end{align}
which gives
\begin{align}
1  &  \geq\frac{1}{2}\left(  f\left(  \Phi\left(  \chi\right)  ^{\dagger}%
\Phi\left(  \chi\right)  \right)  +f\left(  \Phi\left(  \psi\right)
^{\dagger}\Phi\left(  \psi\right)  \right)  \right)  -f\left(  \Phi\left(
\chi\right)  ^{\dagger}\Phi\left(  \psi\right)  ^{\dagger}\Phi\left(
\chi\right)  \Phi\left(  \psi\right)  \right)  \geq0\nonumber\\
&  \left.  \forall\right.  \left\langle \chi\left\vert \psi\right.
\right\rangle =0;\left\langle \psi\left\vert \psi\right.  \right\rangle
=\left\langle \chi\left\vert \chi\right.  \right\rangle =1
\end{align}


Thus by Kadisons projector theorem
\begin{equation}
1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)  -f\left(  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)  +f\left(  a_{j_{1}%
}^{\dagger}a_{j_{1}}\right)  -f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{j_{2}}a_{j_{1}}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right)  \geq0
\end{equation}
are the \emph{Necessary and Sufficient} conditions for $f$ to be extended to a
state i.e. to be \emph{Representable}.

If $f$ is only defined on $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}$ and satisfies the condition
\begin{equation}
f\left(  \mathcal{N}_{2}\right)  =\binom{N}{2} \label{TraceCond}%
\end{equation}
one can define its values on $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e1}$ by
\begin{equation}
f\left(  a_{j}^{\dagger}a_{k}\right)  =\left(  N-1\right)  f\left(
a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  \label{Cont.Cond}%
\end{equation}
and the \emph{Necessary and Sufficient} conditions for $f$ to be
N-\emph{Representable }are \emph{ }%
\begin{equation}
1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)  -f\left(  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)  +f\left(  a_{j_{1}%
}^{\dagger}a_{j_{1}}\right)  -f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{j_{2}}a_{j_{1}}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right)  \geq0
\end{equation}
plus eqs. $\left(  \ref{TraceCond},\ref{Cont.Cond}\right)  .$ This must be
true for all basis where
\begin{align}
&  \left(  \left.  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  \right\vert D\right)  _{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right)  \right\vert D\right)  _{\mathcal{F}%
}=\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert L\left(  D\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert L_{1}\left(  D\right)  \right)  _{\mathcal{F}}%
\end{align}
If $D=D^{N}$ then
\begin{align}
&  \left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert L_{1}\left(  D\right)  \right)  _{\mathcal{F}}=\left(
\left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert
\right\vert L_{1}\left(  D^{N}\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =N\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert L_{2}^{1}\circ L_{N}^{2}\left(  D^{N}\right)  \right)
_{\mathcal{F}}=N\left(  \left.  \overset{}{\Gamma_{1}^{2}\left(  \left\vert
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert \right)
}\right\vert L_{N}^{2}\left(  D^{N}\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =\frac{2}{\left(  N-1\right)  }\left(  \left.  \overset{}{\Gamma_{1}%
^{2}\left(  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right)  }\right\vert L_{2}\left(  D^{N}\right)  \right)
_{\mathcal{F}}%
\end{align}
and
\begin{align}
&  \left(  \left.  \left\{  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  +\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \right\}  \right\vert D\right)  _{\mathcal{F}%
}\nonumber\\
&  =\left(  \left.  \Gamma\left(  \left\{  \left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert +\left\vert \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\}  \right)  \right\vert
D\right)  _{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \left\{  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert +\left\vert \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\}  \right\vert L\left(  D\right)
\right)  _{\mathcal{F}}\nonumber\\
&  =\left(  \left.  L_{2}^{1}\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert D_{1}\right)
_{\mathcal{F}}\nonumber\\
&  =\left(  \left.  L_{2}^{1}\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert L_{2}%
^{1}\left(  D_{2}\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\vert \Gamma_{1}^{2}\circ L_{2}%
^{1}\left(  D_{2}\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =Q_{\Gamma_{1}^{2}\circ L_{2}^{1}\left(  D_{2}\right)  }\left(
\mathbf{z}\right)  .
\end{align}
The condition%
\begin{align}
1  &  \geq f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  \right)  -f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  \right)  \geq0,\nonumber\\
1  &  \geq f\left(  \Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  \right)  -f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  \right)  \geq0,
\end{align}
becomes%

\begin{align}
1  &  \geq\left(  \left.  f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  \right)  \right\vert D\right)  _{\mathcal{F}%
}-\left(  \left.  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D\right)  _{\mathcal{F}}\geq0,\nonumber\\
1  &  \geq\left(  \left.  f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  \right)  \right\vert D\right)  _{\mathcal{F}%
}-\left(  \left.  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D\right)  _{\mathcal{F}}\geq0,
\end{align}
then
\begin{align}
1  &  \geq\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right)  \right\vert D\right)  _{\mathcal{F}%
}-\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert D\right)
_{\mathcal{F}}\geq0,\nonumber\\
1  &  \geq\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right)  \right\vert D\right)  _{\mathcal{F}%
}-\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert D\right)
_{\mathcal{F}}\geq0,
\end{align}
and
\begin{align}
1  &  \geq\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}%
\right)  \right\vert \right\vert L\left(  D\right)  \right)  _{\mathcal{F}%
}-\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\vert L\left(  D\right)  \right)
_{\mathcal{F}}\geq0,\nonumber\\
1  &  \geq\left(  \left.  \left\vert \tilde{\varphi}_{2}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}%
\right)  \right\vert \right\vert L\left(  D\right)  \right)  _{\mathcal{F}%
}-\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\vert L\left(  D\right)  \right)
_{\mathcal{F}}\geq0,
\end{align}
and finally
\begin{align}
1  &  \geq\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}%
\right)  \right\vert \right\vert D_{1}\right)  _{\mathcal{B}\left(
\mathcal{H}^{1}\right)  }-\left(  \left.  \left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert
D_{2}\right)  _{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }\geq0,\nonumber\\
1  &  \geq\left(  \left.  \left\vert \tilde{\varphi}_{2}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}%
\right)  \right\vert \right\vert D_{1}\right)  _{\mathcal{B}\left(
\mathcal{H}^{1}\right)  }-\left(  \left.  \left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert
D_{2}\right)  _{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }\geq0.
\end{align}
One can note that
\begin{align}
\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right)  \right\vert D\right)  _{\mathcal{F}}
&  =\left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D\right)  _{\mathcal{F}}=\left(  \left.  \left\vert \tilde
{\varphi}_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert \right\vert L\left(
D\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{1}\right)  _{\mathcal{B}\left(  \mathcal{H}%
^{1}\right)  }%
\end{align}
If $D$ $=$ $D^{N}$ then
\begin{equation}
D_{1}=\left(  N-1\right)  L_{2}^{1}\left(  D_{2}\right)
\end{equation}
and
\begin{equation}
\left(  N-1\right)  \left(  \left.  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right\vert L_{2}^{1}\left(  D_{2}\right)
\right)  _{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }=\left(  N-1\right)
\left(  \left.  \Gamma_{1}^{2}\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right)  \right\vert D_{2}\right)
_{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }%
\end{equation}
The condition
\begin{align}
1  &  \geq f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  \right)  +f\left(  \Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \right) \nonumber\\
&  \left.  -\right.  f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  \right)  \geq0,
\end{align}
becomes
\begin{align}
&  1\geq\left(  \left.  \left\{  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  +\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \right\}  \right\vert D\right)  _{\mathcal{F}%
}\nonumber\\
&  \left.  -\right.  \left(  \left.  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right)  \Phi\left(  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right)  \right\vert D\right)  _{\mathcal{F}}\geq0,
\end{align}
then
\begin{align}
&  1\geq\left(  \left.  \Gamma\left(  \left\{  \left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert +\left\vert \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\}  \right)  \right\vert
D\right)  _{\mathcal{F}}\nonumber\\
&  \left.  -\right.  \left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi
}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert
D\right)  _{\mathcal{F}}\geq0,
\end{align}
and
\begin{align}
&  1\geq\left(  \left.  \left\{  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert +\left\vert \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\}  \right\vert L\left(  D\right)
\right)  _{\mathcal{F}}\nonumber\\
&  \left.  -\right.  \left(  \left.  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert L\left(  D\right)
\right)  _{\mathcal{F}}\geq0,
\end{align}
finally
\begin{align}
&  1\geq\left(  \left.  \left\{  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert +\left\vert \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\}  \right\vert D_{1}\right)
_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\nonumber\\
&  \left.  -\right.  \left(  \left.  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert D_{2}\right)
_{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }\geq0.
\end{align}
This gives
\begin{align}
&  1\geq\left(  \left.  L_{2}^{1}\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert D_{1}\right)
_{\mathcal{B}\left(  \mathcal{H}^{1}\right)  }\nonumber\\
&  \left.  -\right.  \left(  \left.  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert D_{2}\right)
_{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }\geq0.
\end{align}
$\lceil$After noting that
\begin{align}
&  \Gamma_{2}\left(  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert +\left\vert \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\vert \right) \nonumber\\
&  \left.  =\right.  2\left\{  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \right\}
\end{align}
$\rfloor$

The condition%
\begin{equation}
1\geq f\left(  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)
\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  \right)  \geq0,
\end{equation}
becomes
\begin{equation}
1\geq\left(  \left.  \overset{}{\left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert }\right\vert D_{2}\right)
_{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }\geq0
\end{equation}
and
\begin{equation}
Q_{D_{2}}\left(  \mathbf{z}\right)  =\left(  \left.  \overset{}{\left\vert
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\vert
}\right\vert D_{2}\right)  _{\mathcal{B}\left(  \mathcal{H}^{2}\right)  }.
\end{equation}


\bigskip%

\begin{equation}
1\geq\left(  N-1\right)  ^{-1}f\left(  a_{j_{2}}^{\dagger}\mathcal{N}%
_{1}a_{j_{2}}\right)  -f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}%
a_{j_{2}}a_{j_{1}}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq\left(  N-1\right)  ^{-1}f\left(  a_{j_{2}}^{\dagger}\mathcal{N}%
_{1}a_{j_{2}}\right)  +\left(  N-1\right)  ^{-1}f\left(  a_{j_{1}}^{\dagger
}\mathcal{N}_{1}a_{j_{1}}\right)  -f\left(  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right)  \geq0
\end{equation}
plus eq. $\left(  \ref{TraceCond}\right)  .$ This must be true for all basis
thus it becomes
\begin{equation}
1\geq\left(  N-1\right)  ^{-1}f\left(  \Phi\left(  \psi\right)  ^{\dagger
}\mathcal{N}_{1}\Phi\left(  \psi\right)  \right)  -f\left(  \Phi\left(
\psi\right)  ^{\dagger}\Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\chi\right)  \Phi\left(  \psi\right)  \right)  \geq0,
\end{equation}%
\begin{equation}
1\geq\left(  N-1\right)  ^{-1}f\left(  \Phi\left(  \chi\right)  ^{\dagger
}\mathcal{N}_{1}\Phi\left(  \chi\right)  \right)  -f\left(  \Phi\left(
\psi\right)  ^{\dagger}\Phi\left(  \chi\right)  ^{\dagger}\Phi\left(
\chi\right)  \Phi\left(  \psi\right)  \right)  \geq0,
\end{equation}%
\begin{align}
1  &  \geq\left(  N-1\right)  ^{-1}f\left(  \Phi\left(  \psi\right)
^{\dagger}\mathcal{N}_{1}\Phi\left(  \psi\right)  \right)  +\left(
N-1\right)  ^{-1}f\left(  \Phi\left(  \chi\right)  ^{\dagger}\mathcal{N}%
_{1}\Phi\left(  \chi\right)  \right) \\
&  \left.  -\right.  f\left(  \Phi\left(  \psi\right)  ^{\dagger}\Phi\left(
\chi\right)  ^{\dagger}\Phi\left(  \chi\right)  \Phi\left(  \psi\right)
\right)  \geq0,
\end{align}%
\begin{equation}
1\geq f\left(  \Phi\left(  \psi\right)  ^{\dagger}\Phi\left(  \chi\right)
^{\dagger}\Phi\left(  \chi\right)  \Phi\left(  \psi\right)  \right)  \geq0,
\end{equation}
where $\forall\left\vert \psi\right\rangle $ ,$\left\vert \chi\right\rangle $
$\left\langle \left.  \psi\right\vert \chi\right\rangle =0,\left\langle
\left.  \psi\right\vert \psi\right\rangle =\left\langle \left.  \chi
\right\vert \chi\right\rangle =0.$
\begin{equation}
1\geq\left(  N-1\right)  ^{-1}f\left(  \Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{1}\right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{1}\right)  \right)  -f\left(  \Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{1}\right)  ^{\dagger}\Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{2}\right)  ^{\dagger}\Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{2}\right)  \Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{1}\right)  \right)  \geq0,
\end{equation}%
\begin{equation}
1\geq\left(  N-1\right)  ^{-1}f\left(  \Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{2}\right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{2}\right)  \right)  -f\left(  \Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{1}\right)  ^{\dagger}\Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{2}\right)  ^{\dagger}\Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{2}\right)  \Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{1}\right)  \right)  \geq0,
\end{equation}%
\begin{align}
1  &  \geq\left(  N-1\right)  ^{-1}f\left(  \Phi\left(  c\left(
\mathbf{z}\right)  \varphi_{1}\right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(
c\left(  \mathbf{z}\right)  \varphi_{1}\right)  \right)  +\left(  N-1\right)
^{-1}f\left(  \Phi\left(  c\left(  \mathbf{z}\right)  \varphi_{2}\right)
^{\dagger}\mathcal{N}_{1}\Phi\left(  c\left(  \mathbf{z}\right)  \varphi
_{2}\right)  \right) \nonumber\\
&  \left.  -\right.  f\left(  \Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{1}\right)  ^{\dagger}\Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{2}\right)  ^{\dagger}\Phi\left(  c\left(  \mathbf{z}\right)
\varphi_{2}\right)  \Phi\left(  c\left(  \mathbf{z}\right)  \varphi
_{1}\right)  \right)  \geq0,
\end{align}
%

\begin{equation}
1\geq f\left(  \Phi\left(  c\left(  \mathbf{z}\right)  \varphi_{1}\right)
^{\dagger}\Phi\left(  c\left(  \mathbf{z}\right)  \varphi_{2}\right)
^{\dagger}\Phi\left(  c\left(  \mathbf{z}\right)  \varphi_{2}\right)
\Phi\left(  c\left(  \mathbf{z}\right)  \varphi_{1}\right)  \right)  \geq0.
\end{equation}
\bigskip

As $u\left(  \mathbf{z}\right)  $ and its restrictions are unitary
\begin{equation}
\left\langle \left.  u\left(  \mathbf{z}\right)  \varphi_{1}\varphi
_{2}\right\vert u\left(  \mathbf{z}\right)  \varphi_{1}\varphi_{2}%
\right\rangle =1=\left\langle \left.  u\left(  \mathbf{z}\right)  \varphi
_{1}u\left(  \mathbf{z}\right)  \varphi_{2}\right\vert u\left(  \mathbf{z}%
\right)  \varphi_{1}u\left(  \mathbf{z}\right)  \varphi_{2}\right\rangle ,
\end{equation}%
\begin{equation}
\left\langle \left.  u\left(  \mathbf{z}\right)  \varphi_{1}\right\vert
u\left(  \mathbf{z}\right)  \varphi_{1}\right\rangle =1=\left\langle \left.
u\left(  \mathbf{z}\right)  \varphi_{2}\right\vert u\left(  \mathbf{z}\right)
\varphi_{2}\right\rangle ,
\end{equation}%
\begin{equation}
\left\langle \left.  u\left(  \mathbf{z}\right)  \varphi_{1}\right\vert
u\left(  \mathbf{z}\right)  \varphi_{2}\right\rangle =0
\end{equation}
and%
\begin{equation}
u\left(  \mathbf{z}\right)  \mathcal{N}_{1}u\left(  \mathbf{z}\right)
^{\dagger}=\mathcal{N}_{1}.
\end{equation}
The action of $u\left(  \mathbf{z}\right)  $ naturally extends onto
$P_{\mathcal{H}^{1}}-\left\vert \varphi_{1}\right\rangle \left\langle
\varphi_{1}\right\vert -\left\vert \varphi_{2}\right\rangle \left\langle
\varphi_{2}\right\vert $ so that
\begin{equation}
u\left(  \mathbf{z}\right)  \left\{  P_{\mathcal{H}^{1}}-\left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert -\left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right\}
u\left(  \mathbf{z}\right)  ^{\dagger}%
\end{equation}
and
\begin{equation}
u\left(  \mathbf{z}\right)  \left\{  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle
\left\langle \varphi_{2}\right\vert \right\}  u\left(  \mathbf{z}\right)
^{\dagger}%
\end{equation}
are orthogonal projectors. as are
\begin{equation}
u\left(  \mathbf{z}\right)  \left\{  P_{\mathcal{H}^{2}}-\left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \right\}  u\left(  \mathbf{z}\right)  ^{\dagger}%
\end{equation}
and
\begin{equation}
u\left(  \mathbf{z}\right)  \left\{  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right\}
u\left(  \mathbf{z}\right)  ^{\dagger}%
\end{equation}
We can define
\begin{equation}
f\left(  u\left(  \mathbf{z}\right)  \Phi\left(  \varphi_{1}\right)
^{\dagger}u\left(  \mathbf{z}\right)  ^{\dagger}u\left(  \mathbf{z}\right)
\Phi\left(  \varphi_{1}\right)  u\left(  \mathbf{z}\right)  ^{\dagger}\right)
=\left(  N-1\right)  ^{-1}f\left(  u\left(  \mathbf{z}\right)  \Phi\left(
\varphi_{1}\right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(  \varphi_{1}\right)
u\left(  \mathbf{z}\right)  ^{\dagger}\right)
\end{equation}
i.e.%
\begin{equation}
f\left(  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  ^{\dagger
}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  \right)  =\left(
N-1\right)  ^{-1}f\left(  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(  \varphi_{1}\left(
\mathbf{z}\right)  \right)  \right)  ,
\end{equation}
where $\varphi_{1}\left(  \mathbf{z}\right)  $ are now normalized, which can
be expressed as%
\begin{equation}
\operatorname*{Tr}\left\{  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
D_{f}\right\}  =\left(  N-1\right)  ^{-1}\operatorname*{Tr}\left\{
\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  ^{\dagger
}\mathcal{N}_{1}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
D_{f}\right\}
\end{equation}
and
\begin{equation}
\left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D_{f}\right)  _{\mathcal{F}}=\left(  N-1\right)  ^{-1}\left(
\left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  ^{\dagger
}\mathcal{N}_{1}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D_{f}\right)  _{\mathcal{F}}.
\end{equation}
$\lceil$ If this is true for all diagonals then this implies it is true for
all off diagonals as well$\rfloor$ If we also have%
\begin{equation}
\left(  \left.  \mathcal{N}_{2}\right\vert D_{f}\right)  _{\mathcal{F}}%
=\binom{N}{2}%
\end{equation}
then
\begin{equation}
\left(  \left.  \mathcal{N}_{1}\right\vert D_{f}\right)  _{\mathcal{F}}=N
\end{equation}
and%
\begin{equation}
\left(  \left.  \mathcal{N}_{1}^{2}\right\vert D_{f}\right)  _{\mathcal{F}%
}=N^{2}%
\end{equation}
thus $D_{f}$ is a pure number state
\begin{equation}
D_{f}=D_{f}^{N}.
\end{equation}
Then
\begin{align}
\left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D_{f}\right)  _{\mathcal{F}}  &  =\left(  \left.  \Phi\left(
\varphi_{1}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(
\varphi_{1}\left(  \mathbf{z}\right)  \right)  \right\vert D_{f}^{N}\right)
_{\mathcal{H}^{N}}\nonumber\\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \Phi\left(  \varphi_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(  \varphi
_{1}\left(  \mathbf{z}\right)  \right)  \right\vert D_{f}^{N}\right)
_{\mathcal{H}^{N}}.
\end{align}
Noting that
\begin{align}
&  \left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)
\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  \right\vert
D_{f}^{N}\right)  _{\mathcal{H}^{N}}\nonumber\\
&  =\left(  \left.  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert \wedge I_{\mathcal{H}_{F}}\right\vert D_{f}^{N}\right)
_{\mathcal{H}^{N}}\nonumber\\
&  =\left(  \left.  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert \wedge P_{\mathcal{H}^{N}}\right\vert D_{f}^{N}\right)
_{\mathcal{H}^{N}}\nonumber\\
&  =\binom{N}{2}\left(  \left.  \Gamma_{2}^{N}\left(  \left\vert \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi
_{2}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert D_{f}%
^{N}\right)  _{\mathcal{H}^{N}}\nonumber\\
&  =\binom{N}{2}\left(  \left.  \left\vert \varphi_{1}\left(  \mathbf{z}%
\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert L_{N}^{2}\left(  D_{f}^{N}\right)  \right)
_{\mathcal{H}^{2}}\nonumber\\
&  =\left(  \left.  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert \right\vert D_{2Nf}\right)  _{\mathcal{H}^{2}}\nonumber\\
&  =\tilde{Q}_{D_{f2N}}\left(  \mathbf{z}\right)
\end{align}
one can see that
\begin{align}
&  \left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D_{f}\right)  _{\mathcal{F}}=\left(  \left.  \Phi\left(
\varphi_{1}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(
\varphi_{1}\left(  \mathbf{z}\right)  \right)  \right\vert D_{f}^{N}\right)
_{\mathcal{H}^{N}}\nonumber\\
&  =\binom{N}{1}\left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}%
\right)  \right)  ^{\dagger}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)
\right)  \right\vert L_{N}^{1}\left(  D_{f}^{N}\right)  \right)
_{\mathcal{H}^{1}}\nonumber\\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \Phi\left(  \varphi_{1}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(  \varphi
_{1}\left(  \mathbf{z}\right)  \right)  \right\vert D_{f2N}\right)
_{\mathcal{H}^{2}}\nonumber\\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \left\{  \left\vert \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi
_{2}\left(  \mathbf{z}\right)  \right\vert +\left\vert \varphi_{1}\left(
\mathbf{z}\right)  \right\rangle \left\langle \varphi_{1}\left(
\mathbf{z}\right)  \right\vert \wedge P_{12}^{\bot}\left(  \mathbf{z}\right)
\right\}  \right\vert D_{f2N}\right)  _{\mathcal{H}^{2}}.
\end{align}
Thus
\begin{align}
\tilde{Q}_{D_{f1N}}\left(  \mathbf{z}\right)   &  =\left(  N-1\right)
^{-1}\left(  \left.  \left\{  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert +\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi
_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\vert \right\}
\right\vert D_{f2N}\right)  _{\mathcal{H}^{2}}\nonumber\\
\tilde{Q}_{D_{f2N}}\left(  \mathbf{z}\right)   &  =\left(  \left.  \left\vert
\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi
_{2}\left(  \mathbf{z}\right)  \right\vert \right\vert D_{2Nf}\right)
_{\mathcal{H}^{2}}%
\end{align}%
\begin{align}
\tilde{Q}_{D_{f1}^{1}}\left(  \mathbf{z}\right)   &  =\int\mathcal{K}\left(
\mathbf{z,z}^{\prime}\right)  \tilde{Q}_{D_{f}^{2}}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  =\left(  N-1\right)  ^{-1}\left(  \left.
\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)  ^{\dagger
}\mathcal{N}_{1}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
\right\vert D_{f}^{2}\right)  _{\mathcal{H}^{2}}\nonumber\\
&  =\left(  \left.  \Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\mathcal{N}_{1}\Phi\left(  \varphi_{1}\left(  \mathbf{z}\right)
\right)  \right\vert D_{f}^{1}\right)  _{\mathcal{H}^{1}}%
\end{align}%
\begin{align}
\tilde{Q}_{D_{f2}^{1}}\left(  \mathbf{z}\right)   &  =\int\mathcal{K}\left(
\mathbf{z,z}^{\prime}\right)  \tilde{Q}_{D_{f}^{2}}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  =\left(  N-1\right)  ^{-1}\left(  \left.
\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)  ^{\dagger}%
\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)  \right\vert
D_{f}^{2}\right)  _{\mathcal{H}^{2}}\nonumber\\
&  =\left(  \left.  \Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \varphi_{2}\left(  \mathbf{z}\right)  \right)
\right\vert D_{f}^{1}\right)  _{\mathcal{H}^{1}}%
\end{align}%
\begin{align}
\left[  a_{j}^{\dagger},\sum_{l}a_{l}^{\dagger}a_{l}\right]   &  =\sum
_{l}\left[  a_{j}^{\dagger},a_{l}^{\dagger}a_{l}\right]  =\sum_{l}\left\{
a_{j}^{\dagger}a_{l}^{\dagger}a_{l}-a_{l}^{\dagger}a_{l}a_{j}^{\dagger
}\right\}  =\sum_{l}\left\{  a_{j}^{\dagger}a_{l}^{\dagger}a_{l}%
-a_{l}^{\dagger}\left(  \delta_{lj}-a_{j}^{\dagger}a_{l}\right)  \right\}
\nonumber\\
&  =\sum_{l}\left\{  a_{j}^{\dagger}a_{l}^{\dagger}a_{l}-a_{j}^{\dagger}%
a_{l}^{\dagger}a_{l}\right\}  -a_{j}^{\dagger}=-a_{j}^{\dagger}\nonumber\\
\left[  \mathcal{N}_{1},a_{j}^{\dagger}\right]   &  =a_{j}^{\dagger
}=\mathcal{N}_{1}a_{j}^{\dagger}-a_{j}^{\dagger}\mathcal{N}_{1}\nonumber\\
\left[  \mathcal{N}_{1},a_{j}^{\dagger}\right]  ^{\dagger}  &  =a_{j}=-\left[
\mathcal{N}_{1},a_{j}\right] \nonumber\\
\left[  \mathcal{N}_{1},a_{j}\right]   &  =-a_{j}=a_{j}\mathcal{N}%
_{1}-\mathcal{N}_{1}a_{j}\Leftrightarrow\mathcal{N}_{1}a_{j}=a_{j}%
+a_{j}\mathcal{N}_{1}%
\end{align}%
\begin{align}
f\left(  a_{j}^{\dagger}a_{k}\right)   &  =\left(  \left.  a_{j}^{\dagger
}a_{k}\right\vert D_{f}\right)  _{\mathcal{F}}\overset{\Delta}{=}\left(
N-1\right)  ^{-1}\left(  \left.  a_{j}^{\dagger}\mathcal{N}_{1}a_{k}%
\right\vert D_{f}\right)  _{\mathcal{F}}=\left(  N-1\right)  ^{-1}\left(
\left.  a_{j}^{\dagger}a_{k}\left\{  \mathcal{N}_{1}+I\right\}  \right\vert
D_{f}\right)  _{\mathcal{F}}\\
&  =\operatorname*{Tr}\left\{  a_{k}^{\dagger}a_{j}D_{f}\right\}  =\left(
N-1\right)  ^{-1}\operatorname*{Tr}\left\{  a_{k}^{\dagger}\mathcal{N}%
_{1}a_{j}D_{f}\right\}  =\left(  N-1\right)  ^{-1}\operatorname*{Tr}\left\{
a_{k}^{\dagger}\left\{  a_{j}+a_{j}\mathcal{N}_{1}\right\}  D_{f}\right\} \\
&  =\left(  N-1\right)  ^{-1}\operatorname*{Tr}\left\{  \left\{
a_{k}^{\dagger}a_{j}+a_{k}^{\dagger}a_{j}\mathcal{N}_{1}\right\}
D_{f}\right\}  .
\end{align}%
\begin{align}
\left(  \left.  \mathcal{N}_{1}\right\vert D_{f}\right)  _{\mathcal{F}}  &
=\left(  N-1\right)  ^{-1}\left(  \left.  \mathcal{N}_{1}\left\{
I_{\mathcal{H}_{\mathcal{F}}}+\mathcal{N}_{1}\right\}  \right\vert
D_{f}\right)  _{\mathcal{F}}=\left(  N-1\right)  ^{-1}\left(  \left.  \left\{
\mathcal{N}_{1}+\mathcal{N}_{1}^{2}\right\}  \right\vert D_{f}\right)
_{\mathcal{F}}\\
N  &  =\left(  N-1\right)  ^{-1}\left(  \left.  \mathcal{N}_{1}\right\vert
D_{f}\right)  _{\mathcal{F}}+\left(  N-1\right)  ^{-1}\left(  \left.
\mathcal{N}_{1}^{2}\right\vert D_{f}\right)  _{\mathcal{F}}\\
N  &  =\frac{N}{N-1}+\frac{N^{2}}{N-1}%
\end{align}


