\section{Tensor Product of Operators}

The tensor product is
\begin{align}
&  \left(  A\otimes B\right)  \left(  \varphi_{j_{1}}\otimes\varphi_{j_{2}%
}\right)  \overset{\bigtriangleup}{=}\left(  A\varphi_{j_{1}}\otimes
B\varphi_{j_{2}}\right)  ;1\leq j_{1},j_{2}\leq\infty\nonumber\\
&  \left(  A\otimes B\right)  _{j_{1}j_{2}k_{1}k_{2}}=\left\langle
\varphi_{j_{1}}\otimes\varphi_{j_{2}}\left\vert \left(  A\otimes B\right)
\varphi_{k_{1}}\otimes\varphi_{k_{2}}\right.  \right\rangle =\left\langle
\varphi_{j_{1}}\otimes\varphi_{j_{2}}\left\vert \left(  A\varphi_{k_{1}%
}\otimes B\varphi_{k_{2}}\right)  \right.  \right\rangle \nonumber\\
&  =\left\langle \varphi_{j_{1}}\left\vert A\varphi_{k_{1}}\right.
\right\rangle \left\langle \varphi_{j_{2}}B\varphi_{k_{2}}\right\rangle
=A_{j_{1}k_{1}}B_{j_{2}k_{2}}%
\end{align}
and the antisymmetric tensor product is
\begin{align}
&  \left(  A\wedge B\right)  \left(  \varphi_{j_{1}}\wedge\varphi_{j_{2}%
}\right)  \overset{\bigtriangleup}{=}\left(  A\varphi_{j_{1}}\wedge
B\varphi_{j_{2}}\right)  ;1\leq j_{1},j_{2}\leq\infty\nonumber\\
&  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\overset{\bigtriangleup}{=}\frac{1}{\sqrt{2}}\varphi_{j_{1}}\wedge
\varphi_{j_{2}}\nonumber\\
&  \varphi_{j_{1}}\wedge\varphi_{j_{2}}=\varphi_{j_{1}}\otimes\varphi_{j_{2}%
}-\varphi_{j_{2}}\otimes\varphi_{j_{1}}%
\end{align}%
\begin{equation}
\left(  A\wedge B\right)  =P_{\mathcal{H}^{2}}\left(  A\otimes B\right)
P_{\mathcal{H}^{2}},
\end{equation}
where%
\begin{align}
&  P_{\mathcal{H}^{2}}=\sum_{1\leq j_{1}<j_{2}\leq\infty}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert =\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq\infty
}\left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}}-\varphi_{j_{2}}%
\otimes\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}\otimes
\varphi_{j_{2}}-\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq\infty}\left\{  \left\vert
\varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\rangle \left\langle \varphi
_{j_{1}}\otimes\varphi_{j_{2}}\right\vert -\left\vert \varphi_{j_{1}}%
\otimes\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{2}}\otimes
\varphi_{j_{1}}\right\vert -\left\vert \varphi_{j_{2}}\otimes\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\vert
\right. \nonumber\\
&  \left.  +\left\vert \varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\rangle
\left\langle \varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert \right\}
\nonumber\\
&  =\frac{1}{2!}\sum_{1\leq j_{1},j_{2}\leq\infty}\left\{  \left\vert
\varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\rangle \left\langle \varphi
_{j_{1}}\otimes\varphi_{j_{2}}\right\vert -\left\vert \varphi_{j_{1}}%
\otimes\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{2}}\otimes
\varphi_{j_{1}}\right\vert \right\} \nonumber\\
&  =\frac{1}{2!}\sum_{1\leq j_{1},j_{2}\leq\infty}\sum_{\sigma\in S_{2}%
}\left(  -1\right)  ^{\pi\left(  \sigma\right)  }\left\vert \varphi_{j_{1}%
}\otimes\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{\sigma\left(
1\right)  }}\otimes\varphi_{j_{\varphi\left(  2\right)  }}\right\vert .
\end{align}
Using%
\begin{equation}
A\varphi_{j_{1}}\wedge B\varphi_{j_{2}}=A\varphi_{j_{1}}\otimes B\varphi
_{j_{2}}-B\varphi_{j_{2}}\otimes A\varphi_{j_{1}}%
\end{equation}
one gets%
\begin{align}
&  \left(  A\wedge B\right)  _{j_{1}j_{2}k_{1}k_{2}}=\left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\left\vert \left(  A\wedge B\right)
\varphi_{k_{1}}\varphi_{k_{2}}\right.  \right\rangle =\frac{1}{2}\left\{
\left\langle \varphi_{j_{1}}\wedge\varphi_{j_{2}}\left\vert \left(  A\wedge
B\right)  \varphi_{k_{1}}\wedge\varphi_{k_{2}}\right.  \right\rangle \right\}
\nonumber\\
&  =\frac{1}{2}\left\{  \left\langle \left(  \varphi_{j_{1}}\otimes
\varphi_{j_{2}}-\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right)  \left\vert
\left(  A\wedge B\right)  \left(  \varphi_{k_{1}}\otimes\varphi_{k_{2}%
}-\varphi_{k_{2}}\otimes\varphi_{k_{1}}\right)  \right.  \right\rangle
\right\} \nonumber\\
&  =\frac{1}{2}\left\{  \left\langle \left(  \varphi_{j_{1}}\otimes
\varphi_{j_{2}}-\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right)  \left\vert
\left(  A\otimes B\right)  \left(  \varphi_{k_{1}}\otimes\varphi_{k_{2}%
}-\varphi_{k_{2}}\otimes\varphi_{k_{1}}\right)  \right.  \right\rangle
\right\} \nonumber\\
&  =\frac{1}{2}\left\langle \left(  \varphi_{j_{1}}\otimes\varphi_{j_{2}%
}\right)  \left\vert \left(  A\otimes B\right)  \left(  \varphi_{k_{1}}%
\otimes\varphi_{k_{2}}\right)  \right.  \right\rangle -\frac{1}{2}\left\langle
\left(  \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right)  \left\vert \left(
A\otimes B\right)  \left(  \varphi_{k_{2}}\otimes\varphi_{k_{1}}\right)
\right.  \right\rangle \nonumber\\
&  \frac{1}{2}\left\langle \left(  \varphi_{j_{2}}\otimes\varphi_{j_{1}%
}\right)  \left\vert \left(  A\otimes B\right)  \left(  \varphi_{k_{1}}%
\otimes\varphi_{k_{2}}\right)  \right.  \right\rangle -\frac{1}{2}\left\langle
\left(  \varphi_{j_{2}}\otimes\varphi_{j_{1}}\right)  \left\vert \left(
A\otimes B\right)  \left(  \varphi_{k_{2}}\otimes\varphi_{k_{1}}\right)
\right.  \right\rangle \nonumber\\
&  =\frac{1}{2}\left\{  A_{j_{1}k_{1}}B_{j_{2}k_{2}}-A_{j_{1}k_{2}}%
B_{j_{2}k_{1}}-A_{j_{2}k_{1}}B_{j_{1}k_{2}}+A_{j_{2}k_{2}}B_{j_{1}k_{1}%
}\right\}  .
\end{align}
Thus%
\begin{align}
\left(  A\wedge A\right)  _{j_{1}j_{2}k_{1}k_{2}}  &  =A_{j_{1}k_{1}}%
A_{j_{2}k_{2}}-A_{j_{1}k_{2}}A_{j_{2}k_{1}}\nonumber\\
\left(  A\wedge I\right)  _{j_{1}j_{2}k_{1}k_{2}}  &  =\frac{1}{2}\left\{
A_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-A_{j_{1}k_{2}}\delta_{j_{2}k_{1}}%
-A_{j_{2}k_{1}}\delta_{j_{1}k_{2}}+A_{j_{2}k_{2}}\delta_{j_{1}k_{1}}\right\}
.
\end{align}


\section{Normalization, Contraction and Expansion}%

\begin{align}
\left\Vert a\wedge b\right\Vert ^{2}  &  =\left\langle a\wedge b\left\vert
a\wedge b\right.  \right\rangle =\left\langle \left\{  a\otimes b-b\otimes
a\right\}  \left\vert \left\{  a\otimes b-b\otimes a\right\}  \right.
\right\rangle \nonumber\\
&  =\left\{  \left\langle a\left\vert a\right.  \right\rangle \left\langle
b\left\vert b\right.  \right\rangle -\left\langle a\left\vert b\right.
\right\rangle \left\langle b\left\vert a\right.  \right\rangle -\left\langle
b\left\vert a\right.  \right\rangle \left\langle a\left\vert b\right.
\right\rangle +\left\langle a\left\vert a\right.  \right\rangle \left\langle
b\left\vert b\right.  \right\rangle \right\} \nonumber\\
&  =2\left\{  \left\langle a\left\vert a\right.  \right\rangle \left\langle
b\left\vert b\right.  \right\rangle -\left\langle a\left\vert b\right.
\right\rangle \left\langle b\left\vert a\right.  \right\rangle \right\}
\nonumber\\
&  =2\det\left(
\begin{array}
[c]{cc}%
\left\langle a\left\vert a\right.  \right\rangle  & \left\langle a\left\vert
b\right.  \right\rangle \\
\left\langle b\left\vert a\right.  \right\rangle  & \left\langle b\left\vert
b\right.  \right\rangle
\end{array}
\right)  ,
\end{align}
thus
\begin{equation}
\operatorname*{Tr}\left\{  \left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
\right\}  =\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right.  \right\rangle =\det\left(
\begin{array}
[c]{cc}%
\left\langle \varphi_{j_{1}}\left\vert \varphi_{j_{1}}\right.  \right\rangle
& \left\langle \varphi_{j_{1}}\left\vert \varphi_{j_{2}}\right.  \right\rangle
\\
\left\langle \varphi_{j_{2}}\left\vert \varphi_{j_{1}}\right.  \right\rangle
& \left\langle \varphi_{j_{2}}\left\vert \varphi_{j_{2}}\right.
\right\rangle
\end{array}
\right)  =1
\end{equation}
and
\begin{align}
\operatorname*{Tr}\left\{  P_{\mathcal{H}^{2}}\right\}   &
=\operatorname*{Tr}\left\{  \sum_{1\leq j_{1}<j_{2}\leq r}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert \right\}  =\binom{r}{2}\\
\operatorname*{Tr}\left\{  P_{\mathcal{H}^{1}}\right\}   &
=\operatorname*{Tr}\left\{  \sum_{1\leq j_{1}\leq r}\left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\right\vert \right\}  =r.
\end{align}
The individual pair state projectors can be expanded as
\begin{align}
&  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert =\frac{1}{2}\left\vert
\varphi_{j_{1}}\otimes\varphi_{j_{2}}-\varphi_{j_{2}}\otimes\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\otimes\varphi_{j_{2}}%
-\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert \nonumber\\
&  =\frac{1}{2}\left\{  \left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\vert
-\left\vert \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert -\left\vert \varphi_{j_{2}%
}\otimes\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}%
\otimes\varphi_{j_{2}}\right\vert \right. \nonumber\\
&  \left.  +\left\vert \varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\rangle
\left\langle \varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert \right\}  .
\end{align}
The contraction of these projectors is thus%
\begin{equation}
L_{1}\left(  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right)  =\left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}\right\vert
\left\langle \varphi_{j_{2}}\left\vert \varphi_{j_{2}}\right.  \right\rangle
+\left\vert \varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{2}%
}\right\vert \left\langle \varphi_{j_{1}}\left\vert \varphi_{j_{1}}\right.
\right\rangle
\end{equation}
and%
\begin{align}
L_{2}^{1}\left(  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right)   &  =\frac
{1}{2}L_{1}\left(  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right) \nonumber\\
&  =\frac{1}{2}\left\{  \left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{j_{1}}\right\vert \left\langle \varphi_{j_{2}}\left\vert
\varphi_{j_{2}}\right.  \right\rangle +\left\vert \varphi_{j_{2}}\right\rangle
\left\langle \varphi_{j_{2}}\right\vert \left\langle \varphi_{j_{1}}\left\vert
\varphi_{j_{1}}\right.  \right\rangle \right\}
\end{align}
and hence
\begin{align}
L_{1}\left(  P_{\mathcal{H}^{2}}\right)   &  =L_{1}\left(  \sum_{1\leq
j_{1}<j_{2}\leq r}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right)  =L_{1}\left(
\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \right) \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}L_{1}\left(  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert \right) \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\left\{  \left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}\right\vert
\left\langle \varphi_{j_{2}}\left\vert \varphi_{j_{2}}\right.  \right\rangle
+\left\vert \varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{2}%
}\right\vert \left\langle \varphi_{j_{1}}\left\vert \varphi_{j_{1}}\right.
\right\rangle \right\} \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\left\{  \left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{j_{1}}\right\vert
\left\langle \varphi_{j_{2}}\left\vert \varphi_{j_{2}}\right.  \right\rangle
+\sum_{1\leq j_{1},j_{2}\leq r}\left\vert \varphi_{j_{2}}\right\rangle
\left\langle \varphi_{j_{2}}\right\vert \left\langle \varphi_{j_{1}}\left\vert
\varphi_{j_{1}}\right.  \right\rangle \right\} \nonumber\\
&  =\frac{1}{2}\left\{  \sum_{1\leq j_{1}\leq r}\left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\right\vert \sum_{1\leq j_{2}\leq
r}\left\langle \varphi_{j_{2}}\left\vert \varphi_{j_{2}}\right.  \right\rangle
+\sum_{1\leq j_{2}\leq r}\left\vert \varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{2}}\right\vert \sum_{1\leq j_{1}\leq r}\left\langle \varphi
_{j_{1}}\left\vert \varphi_{j_{1}}\right.  \right\rangle \right\} \nonumber\\
&  =\frac{1}{2}\left\{  r\sum_{1\leq j_{1}\leq r}\left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\right\vert +r\sum_{1\leq j_{2}\leq
r}\left\vert \varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{2}%
}\right\vert \right\} \nonumber\\
&  =rP_{\mathcal{H}^{1}},
\end{align}
i.e.
\begin{equation}
L_{1}\left(  P_{\mathcal{H}^{2}}\right)  =rP_{\mathcal{H}^{1}}=2L_{2}%
^{1}\left(  P_{\mathcal{H}^{2}}\right)  \equiv L_{2}^{1}\left(  P_{\mathcal{H}%
^{2}}\right)  =\left(  2\right)  ^{-1}L_{1}\left(  P_{\mathcal{H}^{2}}\right)
=\left(  2\right)  ^{-1}rP_{\mathcal{H}^{1}}.
\end{equation}
This shows explicitly shows that $L$ and $L_{2}^{1}$ are unbounded.

The expansion of $P_{\mathcal{H}^{1}}$

First we recall
\begin{align}
&  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\overset{\bigtriangleup}{=}\sqrt{2}\varphi_{j_{1}}\wedge\varphi_{j_{2}%
}\nonumber\\
&  \varphi_{j_{1}}\wedge\varphi_{j_{2}}=\frac{1}{2}\left(  \varphi_{j_{1}%
}\otimes\varphi_{j_{2}}-\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right)
\nonumber\\
&  \left\langle \left.  \varphi_{j_{1}}\wedge\varphi_{j_{2}}\right\vert
\varphi_{j_{3}}\wedge\varphi_{j_{4}}\right\rangle =\frac{1}{4}\left\langle
\left.  \left(  \varphi_{j_{1}}\otimes\varphi_{j_{2}}-\varphi_{j_{2}}%
\otimes\varphi_{j_{1}}\right)  \right\vert \left(  \varphi_{j_{3}}%
\otimes\varphi_{j_{4}}-\varphi_{j_{4}}\otimes\varphi_{j_{3}}\right)
\right\rangle \nonumber\\
&  =\frac{1}{4}\left\{  \left\langle \left.  \varphi_{j_{1}}\otimes
\varphi_{j_{2}}\right\vert \varphi_{j_{3}}\otimes\varphi_{j_{4}}\right\rangle
-\left\langle \left.  \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\vert
\varphi_{j_{4}}\otimes\varphi_{j_{3}}\right\rangle -\left\langle \left.
\varphi_{j_{2}}\otimes\varphi_{j_{1}}\right\vert \varphi_{j_{3}}\otimes
\varphi_{j_{4}}\right\rangle +\left\langle \left.  \varphi_{j_{2}}%
\otimes\varphi_{j_{1}}\right\vert \varphi_{j_{4}}\otimes\varphi_{j_{3}%
}\right\rangle \right\} \nonumber\\
&  =\frac{1}{2}\left\{  \left\langle \left.  \varphi_{j_{1}}\otimes
\varphi_{j_{2}}\right\vert \varphi_{j_{3}}\otimes\varphi_{j_{4}}\right\rangle
-\left\langle \left.  \varphi_{j_{1}}\otimes\varphi_{j_{2}}\right\vert
\varphi_{j_{4}}\otimes\varphi_{j_{3}}\right\rangle \right\}  =\frac{1}%
{2}\left\{  \left\langle \left.  \varphi_{j_{1}}\right\vert \varphi_{j_{3}%
}\right\rangle \left\langle \left.  \varphi_{j_{2}}\right\vert \varphi_{j_{4}%
}\right\rangle -\left\langle \left.  \varphi_{j_{1}}\right\vert \varphi
_{j_{4}}\right\rangle \left\langle \left.  \varphi_{j_{2}}\right\vert
\varphi_{j_{3}}\right\rangle \right\} \nonumber\\
&  =\frac{1}{2}\det\left\{
\begin{array}
[c]{cc}%
\left\langle \left.  \varphi_{j_{1}}\right\vert \varphi_{j_{3}}\right\rangle
& \left\langle \left.  \varphi_{j_{1}}\right\vert \varphi_{j_{4}}\right\rangle
\\
\left\langle \left.  \varphi_{j_{2}}\right\vert \varphi_{j_{3}}\right\rangle
& \left\langle \left.  \varphi_{j_{2}}\right\vert \varphi_{j_{4}%
}\right\rangle
\end{array}
\right\}
\end{align}
thus if the vectors are orthonormal
\begin{equation}
\left\langle \left.  \varphi_{j_{1}}\wedge\varphi_{j_{2}}\right\vert
\varphi_{j_{3}}\wedge\varphi_{j_{4}}\right\rangle =\frac{1}{2}\left\{
\delta_{j_{1}j_{3}}\delta_{j_{2}j_{4}}-\delta_{j_{1}j_{4}}\delta_{j_{2}j_{3}%
}\right\}  .
\end{equation}
The normalized projectors are then
\begin{equation}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert =2\left\vert \varphi_{j_{1}}%
\wedge\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\wedge
\varphi_{j_{2}}\right\vert .
\end{equation}
The expansion map gives
\begin{equation}
\Gamma_{1}^{2}\left(  P_{\mathcal{H}^{1}}\right)  =P_{\mathcal{H}^{2}%
}=P_{\mathcal{H}^{1}}\wedge P_{\mathcal{H}^{1}}%
\end{equation}
as%
\begin{align}
&  \left(  P_{\mathcal{H}^{1}}\wedge P_{\mathcal{H}^{1}}\right)  =\sum_{1\leq
j\leq r}\left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{j}\right\vert \wedge\sum_{1\leq k\leq r}\left\vert \varphi_{k}\right\rangle
\left\langle \varphi_{k}\right\vert =\sum_{1\leq j,k\leq r}\left\vert
\varphi_{j}\wedge\varphi_{k}\right\rangle \left\langle \varphi_{j}%
\wedge\varphi_{k}\right\vert =\\
&  2\sum_{1\leq j<k\leq r}\left\vert \varphi_{j}\wedge\varphi_{k}\right\rangle
\left\langle \varphi_{j}\wedge\varphi_{k}\right\vert =\sum_{j<k}\left\vert
\varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{j}\varphi
_{k}\right\vert =P_{\mathcal{H}^{2}}%
\end{align}


i.e.%
\begin{align}
\Gamma_{2}\left(  P_{\mathcal{H}^{1}}\right)   &  =2P_{\mathcal{H}^{2}%
}=2\Gamma_{1}^{2}\left(  P_{\mathcal{H}^{1}}\right) \nonumber\\
&  \equiv\Gamma_{1}^{2}\left(  P_{\mathcal{H}^{1}}\right)  =\left(  2\right)
^{-1}\Gamma_{2}\left(  P_{\mathcal{H}^{1}}\right)  =P_{\mathcal{H}^{2}}.
\end{align}
In general%
\begin{equation}
\Gamma\left(  P_{\mathcal{H}^{1}}\right)  =\sum_{0\leq N\leq r}P_{\mathcal{H}%
^{1}}\wedge P_{\mathcal{H}^{N}}=\sum_{0\leq N\leq r}\Gamma_{N}\left(
P_{\mathcal{H}^{1}}\right)  =P_{\mathcal{H}^{1}}+P_{\mathcal{H}^{1}}\wedge
P_{\mathcal{H}^{1}}+\cdots
\end{equation}
giving
\begin{equation}
\Gamma_{N}\left(  P_{\mathcal{H}^{1}}\right)
=\overset{N}{\overbrace{P_{\mathcal{H}^{1}}\wedge\cdots\wedge P_{\mathcal{H}%
^{1}}}}%
\end{equation}%
\begin{equation}
\left(  P_{\mathcal{H}^{2}}\left\vert \left\vert \varphi_{j_{1}}\varphi
_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
\right.  \right)  =\left(  \Gamma_{1}^{2}\left(  P_{\mathcal{H}^{1}}\right)
\left\vert \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right.  \right)  =\left(
P_{\mathcal{H}^{1}}\left\vert L_{2}^{1}\left(  \left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \right)  \right.  \right)  =1.
\end{equation}
Thus in general
\begin{align}
L_{P}\left(  P_{\mathcal{H}^{N}}\right)   &  =\binom{r}{N-P}P_{\mathcal{H}%
^{P}}=\binom{r}{N-P}\binom{N}{P}L_{N}^{P}\left(  P_{\mathcal{H}^{N}}\right)
\nonumber\\
&  \equiv L_{N}^{P}\left(  P_{\mathcal{H}^{N}}\right)  =\binom{r}{N-P}%
^{-1}\binom{N}{P}^{-1}L_{P}\left(  P_{\mathcal{H}^{N}}\right)  =\binom{r}%
{N-P}^{-1}\binom{N}{P}^{-1}P_{\mathcal{H}^{P}}%
\end{align}
and%
\begin{align}
\Gamma_{N}\left(  P_{\mathcal{H}^{P}}\right)   &  =\binom{N}{P}P_{\mathcal{H}%
^{N}}=\binom{N}{P}\Gamma_{P}^{N}\left(  P_{\mathcal{H}^{P}}\right) \nonumber\\
&  \equiv\Gamma_{P}^{N}\left(  P_{\mathcal{H}^{P}}\right)  =\binom{N}{P}%
^{-1}\Gamma_{N}\left(  P_{\mathcal{H}^{P}}\right)  =P_{\mathcal{H}^{N}}.
\end{align}
One should also note that
\begin{equation}
\Gamma\left(  X\right)  =X\wedge I_{\mathcal{H}_{\mathcal{F}}}=X\wedge
\sum_{0\leq N\leq\infty}P_{\mathcal{H}^{N}}=\sum_{0\leq N\leq\infty}\Gamma
_{N}\left(  X\right)  =\sum_{\substack{0\leq N\leq\infty\\0\leq P\leq
N}}\Gamma_{NP}\left(  X_{P}\right)  =\sum_{\substack{0\leq N\leq\infty\\0\leq
P\leq N}}\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right)
\end{equation}
and
\begin{equation}
L\left(  X\right)  =\sum_{0\leq P\leq\infty}L_{P}\left(  X\right)
=\sum_{\substack{0\leq P\leq\infty\\P\leq N\leq\infty}}L_{NP}\left(
X_{P}\right)  =\sum_{\substack{0\leq P\leq\infty\\P\leq N\leq\infty}}\binom
{N}{P}L_{P}^{N}\left(  X_{P}\right)  .
\end{equation}
Also
\begin{align}
\Gamma\left(  \Gamma\left(  X\right)  \right)   &  =\Gamma^{2}\left(
X\right)  =X\wedge I_{\mathcal{H}_{\mathcal{F}}}\wedge I_{\mathcal{H}%
_{\mathcal{F}}}=X\wedge\sum_{0\leq N,M\leq r}P_{\mathcal{H}^{N}}\wedge
P_{\mathcal{H}^{M}}\\
&  =\sum_{0\leq N,M\leq r}\binom{N}{M}X\wedge P_{\mathcal{H}^{N+M}}?
\end{align}


\section{Misc}

The Second Order Reduced N-particle Hamiltonian is
\begin{align}
K_{2N}  &  =\frac{1}{2}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\{
\frac{1}{N\left(  N-1\right)  }\eta\left(  \delta_{j_{1}k_{1}}\delta
_{j_{2}k_{2}}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}}\right)  \right.
+\nonumber\\
&  \qquad\qquad\qquad\qquad\left.  \frac{1}{\left(  N-1\right)  }\left(
h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}+h_{1j_{2}k_{2}}\delta_{j_{1}k_{1}}\right)
+\frac{1}{2}h_{2j_{1}j_{2}k_{1}k_{2}}\right\}  \times a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}K_{Nj_{1}j_{2}%
k_{1}k_{2}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}%
\end{align}%
\begin{align}
&  \frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq
r}\left\{  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}D_{2Nj_{1}j_{2}k_{1}k_{2}%
}+h_{1j_{2}k_{2}}\delta_{j_{1}k_{1}}D_{2Nj_{1}j_{2}k_{1}k_{2}}\right\}
\nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq
r}2D_{2Nj_{1}j_{2}j_{1}j_{2}}=\frac{1}{\left(  N-1\right)  }\sum_{1\leq
j_{1},j_{2},k_{1},k_{2}\leq r}D_{2Nj_{1}j_{2}j_{1}j_{2}}\nonumber\\
&  =\frac{N\left(  N-1\right)  }{\left(  N-1\right)  }=N
\end{align}%
\begin{equation}
\mathcal{N}_{12N}=\frac{1}{\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2}\leq
r}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert
\end{equation}
If
\begin{equation}
\operatorname{Tr}\left\{  \mathcal{N}_{12N}A\right\}  =N
\end{equation}
and
\begin{align}
\operatorname{Tr}\left\{  A\right\}   &  =\binom{N}{2}\\
A  &  \geq0
\end{align}


\subsubsection{Change of Basis}%

\begin{equation}
I=\sum\left\vert P_{j_{1}j_{2}k_{1}k_{2}}\right)  \left(  Q_{j_{1}j_{2}%
k_{1}k_{2}}\right\vert
\end{equation}
The Q-symbol of the operator
\begin{equation}
\left\vert \varphi_{1}\left(  \mathbf{z}^{\prime}\right)  \varphi_{2}\left(
\mathbf{z}^{\prime}\right)  \right\rangle \left\langle \varphi_{1}\left(
\mathbf{z}^{\prime}\right)  \varphi_{2}\left(  \mathbf{z}^{\prime}\right)
\right\vert =\left\vert \mathbf{z}^{\prime}\right\rangle \left\langle
\mathbf{z}^{\prime}\right\vert =c\left(  \mathbf{z}^{\prime}\right)
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert c\left(  \mathbf{z}^{\prime}\right)  ^{\dagger}%
\end{equation}
is
\begin{equation}
Q_{\left\vert \mathbf{z}^{\prime}\right\rangle \left\langle \mathbf{z}%
^{\prime}\right\vert }\left(  \mathbf{z}\right)  =\operatorname*{Tr}\left\{
\left\vert \mathbf{z}^{\prime}\right\rangle \left\langle \mathbf{z}^{\prime
}\right\vert \left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert \right\}  =\left\langle \left.  \mathbf{z}^{\prime}\right\vert
\mathbf{z}\right\rangle \left\langle \left.  \mathbf{z}\right\vert
\mathbf{z}^{\prime}\right\rangle =\left\vert \left\langle \left.
\mathbf{z}^{\prime}\right\vert \mathbf{z}\right\rangle \right\vert
^{2}=\left\vert S\left(  \mathbf{z}^{\prime},\mathbf{z}\right)  \right\vert
^{2}%
\end{equation}
thus
\begin{align}
\left(  Q_{\left\vert \mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}%
_{1}\right\vert }\left\vert Q_{\left\vert \mathbf{z}_{2}\right\rangle
\left\langle \mathbf{z}_{2}\right\vert }\right.  \right)   &  =\int
Q_{\left\vert \mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}%
_{1}\right\vert }\left(  \mathbf{z}\right)  Q_{\left\vert \mathbf{z}%
_{2}\right\rangle \left\langle \mathbf{z}_{2}\right\vert }\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \\
&  =\int\left\langle \left.  \mathbf{z}_{1}\right\vert \mathbf{z}\right\rangle
\left\langle \left.  \mathbf{z}\right\vert \mathbf{z}_{1}\right\rangle
\left\langle \left.  \mathbf{z}_{2}\right\vert \mathbf{z}\right\rangle
\left\langle \left.  \mathbf{z}\right\vert \mathbf{z}_{2}\right\rangle
d\mu\left(  \mathbf{z}\right) \\
&  =\int\left\langle \left.  \mathbf{z}\right\vert \mathbf{z}_{1}\right\rangle
\left\langle \left.  \mathbf{z}_{1}\right\vert \mathbf{z}\right\rangle
\left\langle \left.  \mathbf{z}\right\vert \mathbf{z}_{2}\right\rangle
\left\langle \left.  \mathbf{z}_{2}\right\vert \mathbf{z}\right\rangle
d\mu\left(  \mathbf{z}\right)  .
\end{align}
Do they form a resolution of the identity i.e.%

\begin{equation}
I=\int\left\vert Q_{\left\vert \mathbf{z}^{\prime}\right\rangle \left\langle
\mathbf{z}^{\prime}\right\vert }\right)  \left(  P_{\left\vert \mathbf{z}%
^{\prime}\right\rangle \left\langle \mathbf{z}^{\prime}\right\vert
}\right\vert d\mu\left(  \mathbf{z}^{\prime}\right)
\end{equation}
$\lceil$%
\begin{align}
I  &  =\sum\left\vert \mathbf{e}_{j}\right\rangle \left\langle \mathbf{e}%
_{j}\right\vert =\int\left\vert \mathbf{x}\right\rangle \left\langle
\mathbf{x}\right\vert d\mathbf{x}\\
\delta\left(  \mathbf{x}^{\prime}-\mathbf{x}\right)   &  =\sum\left\langle
\left.  \mathbf{x}^{\prime}\right\vert \mathbf{e}_{j}\right\rangle
\left\langle \left.  \mathbf{e}_{j}\right\vert \mathbf{x}\right\rangle
=\sum\left\langle \left.  \mathbf{e}_{j}\right\vert \mathbf{x}\right\rangle
\left\langle \left.  \mathbf{x}^{\prime}\right\vert \mathbf{e}_{j}%
\right\rangle \rfloor
\end{align}


All observable properties of the states of N-electron systems can be described
by N-electron density matrices which, however, are known to contain redundant
information. This redundant information can be contracted out producing
Reduced Second Order Density Matrices (SRDM's), but at the cost of losing
explicit description of the N-electron antisymmetry conditions. The equations
for the full states explicitly satisfy this antisymmetric exchange condition
in a straightforward way, but the implementation of these conditions in the
equations for the reduced states has proved intractable and is known as the
N-Representability problem, namely, determining the necessary and sufficient
conditions that SRDM's) must satisfy in order to be the contraction of full
N-electron density matrices (that satisfy the antisymmetric exchange condition).

