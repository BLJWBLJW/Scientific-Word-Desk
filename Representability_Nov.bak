\section{Introduction}

In order to develop a sufficiently accurate quantum mechanical description of
the portion of atomic and molecular systems formed by $N$-electrons it has
been found that one only needs to a consider a subset, $\mathfrak{H}_{N2},$ of
Hamiltonian operators, $H,$ that describe the individual kinetic energies,
interactions with external and internal electric and magnetic fields and the
\emph{simultaneous pair wise interactions} of the electrons. This subset acts
in the $N$-fold antisymmetric tensor product Hilbert space $\mathcal{H}^{N}$
and correspond to operators acting in the antisymmetric tensor product space
$\mathcal{H}^{2}$ that describe pairs of electrons. The stationary
$N$-electron states, $\left\{  \left.  D_{j}^{N}\right\vert 0\leq
j\leq\varkappa\right\}  ,$ associated with these Hamiltonians belong to the
convex set, $S_{N},$ of positive, normalized, trace class operators acting in
$\mathcal{H}^{N}$ that is defined by
\begin{subequations}
\label{NDensityOP}%
\begin{equation}
S_{N}=\left\{  D\in\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)
\subseteq\mathcal{B}\left(  \mathcal{H}^{N}\right)  \left\vert
\operatorname*{Tr}\nolimits_{N}\left\{  D^{N}\right\}  =1,D^{N}\geq O\right.
\right\}  ,
\end{equation}
where $\mathcal{B}\left(  \mathcal{H}^{N}\right)  $ and $\mathcal{B}%
_{1}\left(  \mathcal{H}^{N}\right)  $ are the Banach spaces of bounded and
trace class operators \cite{BanachSpace} respectively acting in $\mathcal{H}%
^{N}$ and $\operatorname*{Tr}\nolimits_{N}\left\{  {}\right\}  $ is the trace
over $\mathcal{H}^{N}.$ The energies, $\left\{  \left.  E_{Nj}\right\vert
0\leq j\leq\varkappa\right\}  ,$ of these stationary states are the stationary
values of the restriction of the linear functional
\end{subequations}
\begin{equation}
E_{H}\left(  D\right)  =\operatorname*{Tr}\nolimits_{N}\left\{  HD\right\}
\label{LinFun}%
\end{equation}
to the convex set $S_{N}$ at the points $\left\{  D_{j}^{N}\right\}  .$ In
particular the ground state energy, $E_{N0},$ is the solution to the
constrained minimization of the linear functional $E_{H}$ over this convex set
i.e.
\begin{equation}
E_{N0}=E_{H}\left(  D_{0}^{N}\right)  =\min_{D\in S_{N}}\operatorname*{Tr}%
\nolimits_{N}\left\{  HD\right\}  . \label{Minval}%
\end{equation}
As $E_{H}$ is linear its minimum value occurs at extreme points,
$\operatorname*{ext}\left\{  S_{N}\right\}  ,$ of $S_{N},$ thus one only has
to the check the values of $E_{H}$ at these points$,$ which \emph{are known}
to be one dimensional projectors onto subspaces of $\mathcal{H}^{N}$ and thus
correspond to, up to a phase factor, unit vectors, $\left\vert \Psi
\right\rangle ,$ in $\mathcal{H}^{N}.$ The values of $E_{H}$ at these points
is given by
\begin{equation}
E_{H}\left(  D\right)  =\operatorname*{Tr}\nolimits_{N}\left\{  HD\right\}
=\left\langle \left.  \Psi\right\vert H\Psi\right\rangle , \label{Enval}%
\end{equation}
which can be computed to any prescribed degree of accuracy by introducing
finite dimensional approximations to $\mathcal{H}^{1}$ and hence
$\mathcal{H}^{N}$. There is a natural duality between $\mathcal{B}\left(
\mathcal{H}^{N}\right)  $ and $\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)
$ given by
\begin{equation}
\left(  X\left\vert Y\right.  \right)  _{\mathcal{H}^{N}}=\operatorname*{Tr}%
\nolimits_{N}\left\{  X^{\dagger}Y\right\}  ;X\in\mathcal{B}\left(
\mathcal{H}^{N}\right)  ,Y\in\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)  ,
\end{equation}
where $X^{\dagger}$ is the adjoint of $X,$ which can be extended to unbounded
linear functionals corresponding to unbounded operators acting in
$\mathcal{H}^{N}$ and allows the expression eq. $\left(  \ref{LinFun}\right)
$ to be written as
\begin{equation}
E_{H}\left(  D\right)  =\left(  H\left\vert D\right.  \right)  _{\mathcal{H}%
^{N}}.
\end{equation}
As the Hamiltonian $H\in\mathfrak{H}_{N2}$ the linear problem in eq. $\left(
\ref{MinVal}\right)  $ can be equivalently expressed as
\begin{align}
E_{N0}  &  =\min_{D\in S_{N}}\left(  H\left\vert D\right.  \right)
_{\mathcal{H}^{N}}=\min_{D\in S_{N}}\operatorname*{Tr}\left\{  HD\right\}
\label{MinVal2}\\
&  =\min_{D\in\operatorname*{ext}\left\{  S_{2N}\right\}  }\left(
K_{2N}\left\vert D\right.  \right)  _{\mathcal{H}^{2}}=\min_{D\in
\operatorname*{ext}\left\{  S_{2N}\right\}  }\operatorname*{Tr}\left\{
K_{2N}D\right\}  ,
\end{align}
(If the ground state is not in the continuum then $\min$ is correct and not
$\inf)$ where $K_{2N}$ is the reduced Hamiltonian operator that acts in
$\mathcal{H}^{2}$ which corresponds to $H$ through the injective expansion map
$\Gamma_{2}^{N}$ and $S_{2N}$ is the convex set of Second Order Reduced
Density Operators (SORDO's) contained in $S_{2}$ that corresponds to $S_{2N}$
through the surjective contraction map $L_{N}^{2}$ that are adjoints of each
other i.e.
\begin{equation}
\left(  H\left\vert L_{N}^{2}\left(  D\right)  \right.  \right)
_{\mathcal{H}^{N}}=\left(  \Gamma_{2}^{N}\left(  H\right)  \left\vert
D\right.  \right)  _{\mathcal{H}^{N}}.
\end{equation}


Finite dimensional approximations of the functional eq. $\left(
\ref{LinFun}\right)  $ determining the energy of $N$-electron states are
obtained by the introduction of subsets of orthonormal bases of $\mathcal{H}%
^{1}$ and thus $\mathcal{H}^{N}.$ The matrices $\mathbb{D}^{N}$ representing
the operators $D^{N}$ satisfy the conditions
\begin{align}
\operatorname*{Tr}\left\{  \mathbb{D}^{N}\right\}   &  =1\nonumber\\
\mathbb{D}^{N}  &  \geq\mathbb{O} \label{NDensity}%
\end{align}
and are determined by
\begin{equation}
\eta_{N}=\frac{1}{2}\binom{r}{N}\left(  \binom{r}{N}+1\right)  \sim r^{2N}
\label{NDenSize}%
\end{equation}
complex parameters, where $r$ is the rank of the orthonormal basis set that
spans a finite dimensional approximation to $\mathcal{H}^{1}.$ SORDO's are
represented by Second Order Reduced Density Matrices (SORDM's), $\mathbb{D}%
_{2}^{N},$ which are determined by
\begin{equation}
\eta_{2}=\frac{1}{2}\binom{r}{2}\left(  \binom{r}{2}+1\right)  \sim r^{4}
\label{2DenSize}%
\end{equation}
complex parameters. A crucial difference is that $\eta_{2}$ does not depend on
the number of electrons while $\eta_{N}$ does, hence
\begin{equation}
\frac{\eta_{N}}{\eta_{2}}\sim r^{2N-4}, \label{RatioSize}%
\end{equation}
which increases rapidly as the number of electrons increases. Just
concentrating on the ratio of the number of parameters is however misleading
as their values are constrained and the complexity of the constraining
equations must be taken into account. In the case of $N$-electron density
matrices the constraints are eq. $\left(  \ref{NDensity}\right)  ,$ while in
the case of SORDM's they are
\begin{equation}
\mathbb{D}_{2}^{N}\in S_{2N}. \label{2Density}%
\end{equation}
The convex set described in eq. $\left(  \ref{NDensity}\right)  $ is the
positive portion of the unit hypersphere in the space of trace class
operators, $\mathcal{B}\left(  \mathcal{H}^{N}\right)  ,$ acting in the
Hilbert space $\mathcal{H}^{N},$ whose extreme points are well characterized,
in contrast the extreme points of the convex set described in eq. $\left(
\ref{2Density}\right)  $ have not all been described and the search for a
description is called the $N$-representability problem, first explicitly
introduced by Husimi \cite{Husimi} then Coulson \cite{Coulson}.

The formulation of the problem can be extended to distinguish between pure
states, ensemble (also known as mixed) states, states that describe coherent
and incoherent mixtures of varying number of particles as well as between
finite and infinite dimensional versions of the problem. In this paper
"representability" is to be interpretted as "ensemble representability" in
contrast to "pure state representability" and we consider the finite
dimensional version of the problem. Solutions to the infinite dimensional
problem would then be expressed as limits of the constraints that we derive
and their validity depend on the continuity of the constraining relationships
to the topology the limits are taken in.

Even though the significant physical interactions that determine the nature of
the state are most pair wise the fact that electrons are fermions implies a
basic underlying exchange symmetry [thus a conservation principle and an
invariance group (the Symmetric Group)] that can be thought of as an
$N$-electron interaction. This basic symmetry interaction determines a class
of possible electron states from which a physical state is determined by
coulombic interaction between electrons and electrons and nuclei, the kinetic
energy of the electrons and the presence of electric and magnetic fields.
States determined by the $\eta_{2}$ parameters are called \emph{reduced
states} in contrast to those determined by those determined by the $\eta_{N}$
parameters. Every state determines a reduced state however the set of
conditions that intrinsically characterize reduced states are not known and
constitute the $N$-representability problem.

We formulate the problem of determining whether an element of the set of
positive trace class operators, $\mathcal{B}_{1+}\left(  \mathcal{H}%
^{2}\right)  ,$ acting in $\mathcal{H}^{2}$ actually is a reduced state by
considering whether the bounded positive linear functional that it determines
on the set of bounded operators, $\mathcal{B}\left(  \mathcal{H}^{2}\right)
,$ acting in $\mathcal{H}^{2}$ can be extended to a positive bounded linear
functional acting on the set of bounded operators acting in $\mathcal{H}^{N}$
i.e. we formulate the conditions for a positive trace class operator acting in
$\mathcal{H}^{2}$ to be $N$-representable in terms of whether it can be
extended to a bounded positive linear functional on $\mathcal{B}\left(
\mathcal{H}^{N}\right)  .$

In order to do this we observe that operators in $\mathcal{B}\left(
\mathcal{H}^{N}\right)  $ for any $N$ are determined by the values of linear
functionals on the Fermi Fock algebra, which we review in section $\left(
{}\right)  .$ The Fermi Fock algebra is a $w^{\ast}$-algebra and thus one can
apply general results from this context to the extension problem in the Fock
algebra and hence the representability and $N$-representability problems. Emch
has discussed the conditions that a positive functional defined on a subspace
of an algebra must satisfy in order to be extend to a state thus be a partial
state, while Segal has extended consideration to subspaces not containing the
identity and Kadison has shown how these conditions can be expressed in terms
of values of the linear functionals on idempotents, i.e. projectors, in these subspaces.

The subspaces associated with SORDO's are the spaces formed by one and two
particle second quantized operators. We show that the idempotents within these
subspaces are decomposable i.e products of one particle or one hole operators
and can be all generated from a reference one particle basis by the action of
the unitary group $\mathcal{U}\left(  \mathcal{H}^{1}\right)  $ of one
particle space $\mathcal{H}^{1}.$ We show that Kadisons theorem leads to
generalizations of the P, Q and G conditions which are \emph{necessary and
sufficient }for\emph{ }representability.

If a functional is $N$-representable then its values on one particle operators
are defined by its values on two particle operators and one need only check
the \emph{necessary and sufficient} conditions that the functional must
satisfy in order to be a reduced $N$-particle state on decomposable two
particle idempotents and sums of one and two particle idempotents as discussed
in section $\left(  {}\right)  $.

The values of functionals on every decomposable two particle idempotent can be
expressed in terms of the action of the one particle unitary group
$\mathcal{U}\left(  \mathcal{H}^{1}\right)  $ on a reference decomposable
two-particle state i.e. a two particle Independent Particle State (IPS).

The group $\mathcal{U}\left(  \mathcal{H}^{1}\right)  $ can be expressed as a
coset factorization with respect to the isotropy group of a two particle
reference IPS and that generates a complex parameterization of the group by
considering elements of the coset to be products of elements of the general
linear group $GL\left(  \mathcal{H}^{1}\right)  $. The action of
$\mathcal{U}\left(  \mathcal{H}^{1}\right)  $ on a two particle IP\ reference
state produces a complex manifold of two particle Thouless Coherent States
(CS's). The values of the functionals on the idempotents then correspond to
values of the CS Q-symbols on this complex manifold. The \emph{necessary and
sufficient }conditions for a $N$-representable extension to exist can then be
totally recast in terms of \emph{known }norm, positivity and linear
constraints on Q-symbols and by using the P-symbol of the reduced $N$-particle
Hamiltonian (which is dual to its Q-symbol) the $N$-particle energy
functional, $E_{N}\left(  Q\right)  $ can be formulated as a linear functional
of the Q-symbols. We explicitly give the transformation from the Q-symbol of
the reduced Hamiltonian to its P-symbol.

Finding the ground electronic state can then be expressed as Linear Programing
(LP) problem or a Semi Definite Programing (SDP) one and in the infinite
dimensional case is equivalent to solving the Time Independent Schr\H{o}dinger
Equation (TISE). In the finite dimensional case, produced by finite
dimensional approximations to the space of Q-symbols, approximations of the
TISE which converge to the exact solution.

\section{Quantum Chemical Formulation}

Given a positive matrix $\mathbb{D}_{2}$ that is a representation of a
positive operator $D_{2}$ ~acting in two electron space i.e.
\begin{equation}
D_{2}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \cdots\left\vert
\varphi_{r-1}\varphi_{r}\right\rangle \right)  =\left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \cdots\left\vert \varphi_{r-1}\varphi
_{r}\right\rangle \right)  \mathbb{D}_{2}%
\end{equation}
\emph{is} $D_{2}$ a contraction of a $N$-electron state $D^{N}$ (that has
matrix representation $\mathbb{D}^{N}$), where
\begin{align}
\operatorname{Tr}\left\{  D_{2}\right\}   &  =\operatorname{Tr}\left\{
\mathbb{D}_{2}\right\}  =\binom{N}{2}\\
\operatorname{Tr}\left\{  D^{N}\right\}   &  =\operatorname{Tr}\left\{
\mathbb{D}^{N}\right\}  =1
\end{align}
and thus $N$-representable. The importance of this question lies in the
observation that the molecular Hamiltonian, $H,$ only contains up to two
particle interactions i.e.
\begin{equation}
H=h_{0}+h_{1}+h_{2},
\end{equation}
where
\begin{subequations}
\label{Hamiltonian}%
\begin{align}
h_{0}  &  =\eta I,\nonumber\\
h_{1}  &  =\sum_{1\leq j_{1},k_{2}\leq r}h_{1j_{1}k_{1}}a_{j_{1}}^{\dagger
}a_{k_{1}},\nonumber\\
h_{2}  &  =\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}h_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}},
\end{align}
and thus the energy $E_{N}$ of an $N$-electron state $D^{N}$ can be expressed
as
\end{subequations}
\begin{align}
E_{N}  &  =\operatorname{Tr}\left\{  HD^{N}\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \left(  \eta I+\sum_{1\leq j_{1},k_{1}\leq
r}h_{1j_{1}k_{1}}a_{j_{1}}^{\dagger}a_{k_{1}}+\sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}h_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\right)  D^{N}\right\}
\nonumber\\
&  =\eta\operatorname{Tr}\left\{  D^{N}\right\}  +\sum_{1\leq j_{1},k_{1}\leq
r}h_{1j_{1}k_{1}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{k_{1}}%
D^{N}\right\} \nonumber\\
&  +\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}h_{2j_{1}j_{2}k_{1}k_{2}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}  .
\end{align}
Observing that%
\begin{align}
&  \sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}}\operatorname{Tr}\left\{
a_{j_{1}}^{\dagger}\mathcal{N}_{1}a_{k_{1}}D^{N}\right\}  =\frac{1}{\left(
N-1\right)  }\sum_{1\leq j_{1},k_{1},l\leq r}h_{1j_{1}k_{1}}\operatorname{Tr}%
\left\{  a_{j_{1}}^{\dagger}a_{l}^{\dagger}a_{l}a_{k_{1}}D^{N}\right\}
\nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq
r}\left(  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}+h_{1j_{2}k_{2}}\delta_{j_{1}%
k_{1}}\right)  \operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}%
^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}
\end{align}
and
\begin{align}
\eta\operatorname{Tr}\left\{  \mathcal{N}_{2}D^{N}\right\}   &  =\frac{\eta
}{2}\sum_{1\leq j_{1},j_{2}\leq r}\operatorname{Tr}\left\{  a_{j_{1}}%
^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}D^{N}\right\} \nonumber\\
&  =\frac{\eta}{2}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\frac{1}{2}\left(
\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}%
}\right)  \operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{k_{2}}a_{k_{1}}D^{N}\right\}  ,
\end{align}
one can define the Second Order Reduced N-electron Hamiltonian $K_{2N}$ as
\begin{align}
K_{2N}  &  =\frac{1}{2}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\{
\frac{1}{N\left(  N-1\right)  }\eta\left(  \delta_{j_{1}k_{1}}\delta
_{j_{2}k_{2}}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}}\right)  \right.
+\nonumber\\
&  \qquad\qquad\qquad\qquad\left.  \frac{1}{\left(  N-1\right)  }\left(
h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}+h_{1j_{2}k_{2}}\delta_{j_{1}k_{1}}\right)
+\frac{1}{2}h_{2j_{1}j_{2}k_{1}k_{2}}\right\}  \left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}K_{j_{1}j_{2}%
k_{1}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert
\end{align}
and the energy can be expressed as
\begin{equation}
E_{N}=\operatorname{Tr}\left\{  HD^{N}\right\}  =\operatorname{Tr}\left\{
\Gamma_{2}^{N}\left(  K_{2N}\right)  D^{N}\right\}  =\operatorname{Tr}\left\{
K_{2N}L_{N}^{2}\left(  D^{N}\right)  \right\}  =\frac{1}{2}\operatorname{Tr}%
\left\{  \mathbb{K}_{2N}\mathbb{D}_{2}\right\}  .
\end{equation}
$\lceil$We can consider a one particle Hamiltonian
\begin{align}
K_{2N}  &  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2},k_{1}%
,k_{2}\leq r}\left(  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}+h_{1j_{2}k_{2}}%
\delta_{j_{1}k_{1}}\right)  \left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
\nonumber\\
E_{1}\left(  D^{N}\right)   &  =\frac{1}{2}\operatorname{Tr}\left\{
K_{2N}D_{2N}\right\} \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq
r}\left(  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}+h_{1j_{2}k_{2}}\delta_{j_{1}%
k_{1}}\right)  D_{2Nj_{1}j_{2}k_{1}k_{2}}\nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq
r}\left\{  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}D_{2Nj_{1}j_{2}k_{1}k_{2}%
}+h_{1j_{2}k_{2}}\delta_{j_{1}k_{1}}D_{2Nj_{1}j_{2}k_{1}k_{2}}\right\}
\nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\left\{  \sum_{1\leq j_{2},k_{2}\leq
r}h_{1j_{2}k_{2}}\operatorname{Tr}\left\{  a_{j_{2}}^{\dagger}\mathcal{N}%
_{1}a_{k_{2}}D^{N}\right\}  +\sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}%
}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\mathcal{N}_{1}a_{k_{1}}%
D^{N}\right\}  \right\} \nonumber\\
&  =\sum_{1\leq j_{1},k_{1}\leq r}h_{1j_{1}k_{1}}\operatorname{Tr}\left\{
a_{j_{1}}^{\dagger}a_{k_{1}}D^{N}\right\}  =\sum_{1\leq j_{1},k_{1}\leq
r}h_{1j_{1}k_{1}}D_{1Nj_{1}k_{1}}%
\end{align}


and zero particle
\begin{align}
K_{2N}  &  =\frac{1}{N\left(  N-1\right)  }\eta\sum_{1\leq j_{1},j_{2}%
,k_{1},k_{2}\leq r}\left(  \delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}%
-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}}\right)  \left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \nonumber\\
E_{0}\left(  D^{N}\right)   &  =\frac{1}{N\left(  N-1\right)  }\eta\sum_{1\leq
j_{1},j_{2},k_{1},k_{2}\leq r}\left(  \delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}%
}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}}\right)  D_{2Nj_{1}j_{2}k_{1}k_{2}%
}\nonumber\\
&  =\frac{2}{N\left(  N-1\right)  }\eta\operatorname{Tr}\left\{
\mathcal{N}_{2}D^{N}\right\}  =\eta\operatorname{Tr}\left\{  D^{N}\right\}
=\eta\operatorname{Tr}\left\{  D_{2N}\right\}  .\rfloor
\end{align}
Note
\begin{equation}
H=\Gamma_{2}^{N}\left(  K\right)  .
\end{equation}
If one wants to be precise in the notation then
\begin{align}
K  &  \equiv K_{N2}\\
\mathbb{D}_{2}  &  \equiv\mathbb{D}_{N2}%
\end{align}
leading to
\begin{equation}
E_{N}=\eta+\operatorname{Tr}\left\{  \mathbf{h}_{1}\mathbb{D}_{1}\right\}
+\operatorname{Tr}\left\{  \mathbf{h}_{2}\mathbb{D}_{2}\right\}  ,
\label{red_en}%
\end{equation}
where
\begin{equation}
D_{1jk}=\operatorname{Tr}\left\{  a_{k}^{\dagger}a_{j}D^{N}\right\}
\end{equation}
and
\begin{equation}
D_{2kmjl}=\operatorname{Tr}\left\{  a_{j}^{\dagger}a_{l}^{\dagger}a_{m}%
a_{k}D^{N}\right\}  .
\end{equation}
The First Order Reduced Density Matrix (FORDM) $\mathbb{D}_{1}$, can be
derived from $\mathbb{D}_{2}$ by (see Appendix ) by
\begin{equation}
D_{1jk}=\frac{2}{\left(  N-1\right)  }\sum_{1\leq l\leq r}D_{2jlkl},
\end{equation}
if $D^{N}$ is a pure state i.e. $D^{N}=\left\vert \Psi_{N}\right\rangle
\left\langle \Psi_{N}\right\vert .$ In this case the expression eq. $\left(
\ref{red_en}\right)  $ can be compared to the CI expression
\begin{equation}
\left\langle \Psi_{N}\left\vert H\Psi_{N}\right.  \right\rangle =\sum
_{\substack{1\leq j_{1}<\cdots<j_{N}\leq r\\1\leq k_{1}<\cdots<k_{N}\leq
r}}\bar{C}_{j_{1}\cdots j_{N}}C_{k_{1}\cdots kN}\left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\left\vert H\varphi_{k_{1}}\cdots\varphi_{k_{N}}\right.
\right\rangle , \label{CI_en}%
\end{equation}
which involves $\sim r^{N}$ complex variables that determine $\left\vert
\Psi_{N}\right\rangle .$ Thus the CI\ energy expression eq. $\left(
\ref{CI_en}\right)  $ scales as $r^{N}$ while SORDM\ expression scales as
$\sim r^{4},$ \emph{which does not involve the number of electrons}.

\section{Background}

\subsection{Fermi Fock Space and Algebra}

We consider the fermion Fock space, $\mathcal{H}_{F},$ based on the one
particle space Hilbert space $\mathcal{H}^{1}$ and the fermion Fock algebra
$\mathcal{F}$, defined by
\begin{align}
\mathcal{H}_{\mathcal{F}}  &  =\underset{0\leq N\leq\infty}{\bigoplus
}\mathcal{H}^{N},\\
\mathcal{H}^{N}  &  =\bigwedge\limits^{N}\mathcal{H}^{1}%
\end{align}
and
\begin{equation}
\mathcal{F}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}
where $\wedge$ denotes antisymmetric tensor product and $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ is the space of bounded operators acting
in $\mathcal{H}_{\mathcal{F}}$. The inner product in $\mathcal{H}%
_{\mathcal{F}}$ is defined as
\begin{equation}
\left\langle \Psi\left\vert \Phi\right.  \right\rangle _{\mathcal{F}}%
=\sum_{0\leq N\leq\infty}\left\langle \Psi_{N}\left\vert \Phi_{N}\right.
\right\rangle _{\mathcal{H}^{N}}=\sum_{0\leq N\leq\infty}\left\langle
\Psi\left\vert P_{\mathcal{H}^{N}}\Phi\right.  \right\rangle _{\mathcal{H}%
^{N}}%
\end{equation}
and the norm as
\begin{equation}
\left\Vert \Phi\right\Vert _{\mathcal{F}}=\left(  \sum_{0\leq N\leq\infty
}\left\Vert \Phi_{N}\right\Vert _{\mathcal{H}^{N}}^{2}\right)  ^{\frac{1}{2}%
}=\left(  \sum_{0\leq N\leq\infty}\left\Vert P_{\mathcal{H}^{N}}%
\Phi\right\Vert _{\mathcal{H}^{N}}^{2}\right)  ^{\frac{1}{2}}.
\end{equation}


The Fock algebra can be generated by polynomials of second quantized
operators, $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq j\leq
\infty\right\}  ,$ which are defined by their action on the vacuum state
$\left\vert \phi\right\rangle $ by
\begin{equation}
a_{j}^{\dagger}\left\vert \phi\right\rangle =\left\vert \varphi_{j}%
\right\rangle ,1\leq j\leq\infty,
\end{equation}
where $\left\{  \left.  \left\vert \varphi_{j}\right\rangle \right\vert 1\leq
j\leq\infty\right\}  $ is a complete orthonormal basis of one-particle space
$\mathcal{H}^{1}$ and satisfy the anti-commutation relationships given by
\begin{equation}
\left[  a_{j}^{\dagger},a_{k}\right]  _{+}=a_{j}^{\dagger}a_{k}+a_{k}%
a_{j}^{\dagger}=\delta_{jk};1\leq j,k\leq\infty.
\end{equation}
The operators $\left\{  \left.  a_{j,}a_{j}^{\dagger}\right\vert 1\leq
j\leq\infty\right\}  $ can be considered as the values of the maps
\begin{equation}
\Phi,\Phi^{\dagger}:\mathcal{H}^{1}\rightarrow\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)
\end{equation}
given by
\begin{align}
a_{j}  &  =\Phi\left(  \varphi_{j}\right)  ,\nonumber\\
a_{j}^{\dagger}  &  =\Phi\left(  \varphi_{j}\right)  ^{\dagger}\equiv
\Phi^{\dagger}\left(  \varphi_{j}\right)  .
\end{align}
The point field operators $\left\{  \left.  \Phi\left(  \boldsymbol{r}\right)
\right\vert \boldsymbol{r\in}\mathbb{R}^{3}\right\}  $ are defined by
\cite{Thirring}
\begin{equation}
\Phi\left(  \boldsymbol{r}\right)  =\sum_{1\leq j\leq\infty}\overline
{\varphi_{j}\left(  \boldsymbol{r}\right)  }a_{j}%
\end{equation}
and can be considered as the value of the map%
\begin{equation}
\Phi:\mathcal{D\rightarrow B}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}
i.e.
\begin{equation}
\Phi\left(  \boldsymbol{r}\right)  =\Phi\left(  \bar{\delta}_{\boldsymbol{r}%
}\right)
\end{equation}
and%
\begin{equation}
\delta_{\boldsymbol{r}}\left(  \boldsymbol{r}^{\prime}\right)  =\delta\left(
\boldsymbol{r-r}^{\prime}\right)  ,
\end{equation}
where $\mathcal{D}$ is a space of distribrutions containing the delta
functions $\delta_{\mathbf{r}}.$ The unbounded operators $\Phi\left(
\boldsymbol{r}\right)  $ are densely defined (but not closeable) on the Fock
space, $\mathcal{H}_{\mathcal{F}},$ nor the subspaces $\mathcal{H}^{N}%
=\wedge^{N}\mathcal{H}^{1},$ and the domains of their adjoints $\Phi\left(
\boldsymbol{r}\right)  ^{\dagger}$ are empty i.e. do not contain any vectors
belonging to $\mathcal{H}_{\mathcal{F}}$ \cite{Thirring}. However, matrix
elements such as $\left\langle \varphi\left\vert \Phi\left(  \boldsymbol{r}%
\right)  ^{\dagger}\Phi\left(  \boldsymbol{r}^{\prime}\right)  \right.
\psi\right\rangle $ can be defined as the distributional limits of
$\left\langle \varphi\left\vert \Phi\left(  f\right)  ^{\dagger}\Phi\left(
f^{\prime}\right)  \right.  \psi\right\rangle $ as $f,f^{\prime}\rightarrow$
delta functions.

The scalar product%
\begin{equation}
\left(  \cdot\left\vert \cdot\right.  \right)  _{N}:\mathcal{B}\left(
\mathcal{H}^{N}\right)  \times\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)
\rightarrow\mathbb{C}%
\end{equation}
can be extended to
\begin{equation}
\left(  \cdot\left\vert \cdot\right.  \right)  _{\mathcal{F}}:\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \times\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \rightarrow\mathbb{C},
\end{equation}
as
\begin{align}
\left(  A\left\vert B\right.  \right)  _{\mathcal{F}}  &  =\operatorname*{Tr}%
\left\{  \sum_{0\leq P,Q,R,S\leq\infty}\left(  P_{\mathcal{H}^{P}%
}AP_{\mathcal{H}^{Q}}\right)  ^{\dagger}P_{\mathcal{H}^{R}}BP_{\mathcal{H}%
^{S}}\right\}  =\operatorname*{Tr}\left\{  \sum_{0\leq P,Q,R,S\leq\infty
}\left(  A_{PQ}\right)  ^{\dagger}B_{RS}\right\} \nonumber\\
&  =\sum_{0\leq P,Q\leq\infty}\operatorname*{Tr}\left\{  \sum_{0\leq
P,Q\leq\infty}\left(  A\right)  _{QP}^{\dagger}B_{PQ}\right\}  =\sum_{0\leq
P,Q\leq\infty}\left(  A_{PQ}\left\vert B_{PQ}\right.  \right)  _{\mathcal{Q}},
\end{align}
where
\begin{equation}
\left(  A_{PQ}\left\vert B_{PQ}\right.  \right)  _{\mathcal{Q}}%
=\operatorname*{Tr}\nolimits_{\mathcal{H}^{Q}}\left\{  \left(  A_{PQ}\right)
^{\dagger}B_{PQ}\right\}  .
\end{equation}


\subsection{Norm of Creation and Annihilation Operators}

The operators $a_{j}^{\dagger}a_{j}$ and $a_{j}a_{j}^{\dagger}$ are idempotent
and positive (therefore projection operators) and thus
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}\geq a_{j}^{\dagger}a_{j}\geq0
\end{equation}
and
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}\geq a_{j}a_{j}^{\dagger}\geq0
\end{equation}
as
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}=a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}.
\end{equation}
This also shows that $a_{j}^{\dagger}$ and $a_{j}$ are partial isometries.
Thus
\begin{equation}
\left\Vert a_{j}\right\Vert =\left\Vert a_{j}^{\dagger}\right\Vert =\left\Vert
a_{j}^{\dagger}a_{j}\right\Vert =\sup_{\substack{\left\Vert \Phi\right\Vert
=1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{  \left\langle
\left.  \Phi\right\vert a_{j}^{\dagger}a_{j}\Phi\right\rangle \right\}  =1.
\label{OccOpNorm}%
\end{equation}
The dimension of the projection operators $\left\{  a_{j}^{\dagger}%
a_{j}\right\}  $ are infinite as
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  =\sum
_{\substack{1\leq N\leq\infty\\1\leq j_{1}<\cdots<j_{N}\leq\infty
}}\left\langle \Psi_{Nj_{1}\cdots j_{N}}\left\vert a_{j}^{\dagger}a_{j}%
\Psi_{Nj_{1}\cdots j_{N}}\right.  \right\rangle =\infty.
\end{equation}
This corresponds to the eigenvalues of $a_{j}^{\dagger}a_{j},$ which are
$\left\{  0,1\right\}  ,$ being infinitely degenerate.

\subsection{Ket-Bra Representation of Second Quantized Operators}

\subsubsection{Second Quantization of First Quantized Operators}

\bigskip By considering the restrictions of $a_{j}^{\dagger}$ to
$\mathcal{H}^{N}$ for $0\leq N\leq\infty$ one obtains%
\begin{align}
a_{j}^{\dagger}  &  =\left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert +\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}%
\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
a_{j}  &  =\left\vert \phi\right\rangle \left\langle \varphi_{j}\right\vert
+\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi
_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert . \label{FQ1}%
\end{align}
thus one can define the second quantization map $\Gamma$
\begin{equation}
\Gamma:\mathcal{F\rightarrow F}%
\end{equation}
from the Fock algebra to itself by
\begin{align}
\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle \phi\right\vert
\right)   &  =a_{j}^{\dagger}\nonumber\\
\Gamma\left(  \left\vert \phi\right\rangle \left\langle \varphi_{j}\right\vert
\right)   &  =a_{j}.
\end{align}
One can check the validity of these First Quantized (FQ) expansions of the
Second Quantized operators by observing that for instance%
\begin{align}
&  \Gamma\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{m_{1}}\right\vert \right)  =a_{l_{1}}^{\dagger}a_{m_{1}}%
=\Gamma\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\phi\right\vert \right)  \Gamma\left(  \left\vert \phi\right\rangle
\left\langle \varphi_{m_{1}}\right\vert \right) \nonumber\\
&  =\sum_{\substack{0\leq N,M\leq\infty\\1\leq j_{1}<\cdots<j_{N}\leq
\infty\\1\leq k_{1}<\cdots<k_{M}\leq\infty}}\left\vert \varphi_{l_{1}}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \left.
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \varphi_{k_{1}}\cdots
\varphi_{k_{M}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{k_{1}}%
\cdots\varphi_{k_{M}}\right\vert \nonumber\\
&  =\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}
and%
\begin{align}
&  \Gamma\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  =a_{l_{1}%
}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}=\Gamma\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \phi\right\vert
\right)  \Gamma\left(  \left\vert \phi\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right) \nonumber\\
&  =\sum_{\substack{0\leq N,M\leq\infty\\1\leq j_{1}<\cdots<j_{N}\leq
\infty\\1\leq k_{1}<\cdots<k_{M}\leq\infty}}\left\vert \varphi_{l_{1}}%
\varphi_{l_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle \left\langle
\left.  \varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert \varphi_{k_{1}}%
\cdots\varphi_{k_{M}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}%
}\varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert \nonumber\\
&  =\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots<j_{N}\leq\infty
}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}}\varphi_{j_{1}%
}\cdots\varphi_{j_{N}}\right\vert .
\end{align}
However \emph{in general}
\begin{equation}
\Gamma(A)\Gamma(B)\neq\Gamma(AB)
\end{equation}
although
\begin{equation}
\Gamma\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\varphi_{m_{1}}\right\vert \right)  =a_{l_{1}}^{\dagger}a_{m_{1}}%
=\Gamma\left(  \left\vert \varphi_{l_{1}}\right\rangle \left\langle
\phi\right\vert \right)  \Gamma\left(  \left\vert \phi\right\rangle
\left\langle \varphi_{m_{1}}\right\vert \right)  =\Gamma\left(  \left\vert
\varphi_{l_{1}}\right\rangle \left\langle \phi\right\vert \wedge\left\vert
\phi\right\rangle \left\langle \varphi_{m_{1}}\right\vert \right)  ,
\end{equation}
and%
\begin{align}
\Gamma\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)   &  =a_{l_{1}%
}^{\dagger}a_{l_{2}}^{\dagger}a_{m_{2}}a_{m_{1}}=\Gamma\left(  \left\vert
\varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle \phi\right\vert
\right)  \Gamma\left(  \left\vert \phi\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right) \nonumber\\
&  =\Gamma\left(  \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \phi\right\vert \wedge\left\vert \phi\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right)  .
\end{align}


The spectral resolution of the projection operators $\left\{  a_{j}^{\dagger
}a_{j}\right\}  $ is given by the FQ expansion
\begin{equation}
a_{j}^{\dagger}a_{j}=\sum_{1\leq N\leq\infty}\sum_{1\leq j_{1}<\cdots
<j_{N}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{j}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert , \label{OccNumOp}%
\end{equation}
(which again shows that $\left\{  a_{j}^{\dagger}a_{j}\right\}  $ are infinite
dimensional if $r=\infty)$ and one can define the number operator as
\begin{equation}
\mathcal{N}_{1}=\sum_{1\leq j\leq\infty}a_{j}^{\dagger}a_{j}=\sum_{1\leq
N\leq\infty}NP_{\mathcal{H}^{N}}. \label{NumOp}%
\end{equation}
Eq. $\left(  \ref{NumOp}\right)  $ can be seen by considering the example%
\begin{equation}
\sum_{1\leq j\leq\infty}\left.  a_{j}^{\dagger}a_{j}\right\vert _{\mathcal{H}%
^{2}}=\sum_{1\leq j,j_{2}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j}\varphi_{j_{1}}\right\vert
=2\sum_{1\leq j<j_{1}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j}\varphi_{j_{1}}\right\vert
=2P_{\mathcal{H}^{2}}.
\end{equation}
This shows that for $P_{\mathcal{H}^{1}}$
\begin{equation}
\Gamma\left(  \sum_{1\leq j\leq\infty}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{j}\right\vert \right)  =\Gamma\left(  P_{\mathcal{H}%
^{1}}\right)  =\mathcal{N}_{1}=\sum_{1\leq N\leq\infty}NP_{\mathcal{H}^{N}}%
\end{equation}
and
\begin{align}
\mathcal{N}_{1}P_{\mathcal{H}^{N}}  &  =NP_{\mathcal{H}^{N}}=P_{\mathcal{H}%
^{1}}\wedge P_{\mathcal{H}^{N-1}},\quad0\leq N\leq\infty\nonumber\\
&  \Updownarrow\nonumber\\
P_{\mathcal{H}^{N}}  &  =N^{-1}\left(  P_{\mathcal{H}^{1}}\wedge
P_{\mathcal{H}^{N-1}}\right)  ,\quad0\leq N\leq\infty.
\end{align}
$\lceil$%
\begin{align}
P_{\mathcal{H}^{1}}\wedge P_{\mathcal{H}^{1}}  &  =\sum_{1\leq j,j_{2}%
\leq\infty}\left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{j}\right\vert \wedge\sum_{1\leq j,j_{2}\leq\infty}\left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j_{1}}\right\vert =\sum_{1\leq
j,j_{2}\leq\infty}\left\vert \varphi_{j}\wedge\varphi_{j_{1}}\right\rangle
\left\langle \varphi_{j}\wedge\varphi_{j_{1}}\right\vert \nonumber\\
&  =2\sum_{1\leq j<j_{2}\leq\infty}\left\vert \varphi_{j}\wedge\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j}\wedge\varphi_{j_{1}}\right\vert
=\sum_{1\leq j<j_{2}\leq\infty}\left\vert \varphi_{j}\varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{j}\varphi_{j_{1}}\right\vert
=P_{\mathcal{H}^{2}}%
\end{align}


Using
\begin{equation}
\Gamma\left(  X\right)  =\sum_{0\leq N,M,R,S\leq\infty}P_{\mathcal{H}^{N}%
}\Gamma\left(  P_{\mathcal{H}^{R}}XP_{\mathcal{H}^{S}}\right)  P_{\mathcal{H}%
^{M}}=\sum_{0\leq N,M,R,S\leq\infty}\Gamma_{MNRS}\left(  X^{RS}\right)
\nonumber
\end{equation}
one obtains that
\begin{align}
\Gamma\left(  P_{\mathcal{H}^{1}}\right)   &  =\sum_{0\leq N,M\leq\infty
}\Gamma_{NM11}\left(  P_{\mathcal{H}^{1}}\right)  =\sum_{0\leq N,M\leq\infty
}P_{\mathcal{H}^{N}}\Gamma\left(  P_{\mathcal{H}^{1}}\right)  P_{\mathcal{H}%
^{M}}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\Gamma_{NN11}\left(  P_{\mathcal{H}^{1}}\right)
=\sum_{1\leq N\leq\infty}\Gamma_{1}^{N}\left(  P_{\mathcal{H}^{1}}\right)
=\sum_{1\leq N\leq\infty}\Gamma_{N}\left(  P_{\mathcal{H}^{1}}\right)
=\sum_{1\leq N\leq\infty}NP_{\mathcal{H}^{N}}%
\end{align}
and hence
\[
\binom{N}{1}\Gamma_{1}^{N}\left(  P_{\mathcal{H}^{1}}\right)  =NP_{\mathcal{H}%
^{N}}=P_{\mathcal{H}^{1}}\wedge P_{\mathcal{H}^{N-1}}=\Gamma_{N}\left(
P_{\mathcal{H}^{1}}\right)  .
\]
For $P_{\mathcal{H}^{2}}$
\begin{equation}
\Gamma\left(  \sum_{1\leq j<k\leq\infty}\left\vert \varphi_{j}\varphi
_{k}\right\rangle \left\langle \varphi_{j}\varphi_{k}\right\vert \right)
=\Gamma\left(  P_{\mathcal{H}^{2}}\right)  =\mathcal{N}_{2}=\sum_{2\leq
N\leq\infty}\binom{N}{2}P_{\mathcal{H}^{N}}=\sum_{2\leq N\leq\infty}\Gamma
_{N}\left(  P_{\mathcal{H}^{2}}\right)
\end{equation}
and
\[
\binom{N}{2}\Gamma_{2}^{N}\left(  P_{\mathcal{H}^{2}}\right)  =\binom{N}%
{2}P_{\mathcal{H}^{N}}=\Gamma_{N}\left(  P_{\mathcal{H}^{2}}\right)  .
\]
Thus in general
\begin{align}
&  \Gamma\left(  \sum_{1\leq j_{1}<\cdots<j_{M}\leq\infty}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{M}}\right\rangle \left\langle \varphi_{j_{1}%
}\cdots\varphi_{j_{M}}\right\vert \right)  =\Gamma\left(  P_{\mathcal{H}^{M}%
}\right)  =\mathcal{N}_{M}\nonumber\\
&  =\sum_{M\leq N\leq\infty}\binom{N}{M}P_{\mathcal{H}^{N}}=\sum_{M\leq
N\leq\infty}\binom{N}{M}\Gamma_{M}^{N}\left(  P_{\mathcal{H}^{M}}\right)
=\sum_{M\leq N\leq\infty}\Gamma_{N}\left(  P_{\mathcal{H}^{M}}\right)  .
\end{align}


\subsubsection{First Quantization of Second Quantized Operators *}

The inverse relationship that would be given by $\Gamma^{-1}$ i.e.
\begin{equation}
\Gamma^{-1}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{N}}^{\dagger}a_{k_{M}%
}\cdots a_{k_{1}}\right)  =\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert .
\end{equation}


The bases $\left\{  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{M}}\right\vert
\right\}  $ is orthonormal$,$ while the basis $\left\{  a_{j_{1}}^{\dagger
}\cdots a_{j_{N}}^{\dagger}a_{k_{M}}\cdots a_{k_{1}}\right\}  $ is not. The
metric matrix for the latter basis is
\begin{equation}
\Delta_{j_{1}\cdots j_{N}k_{1}\cdots k_{M}l_{1}\cdots l_{P}m_{1}\cdots m_{Q}%
}=\operatorname*{Tr}\left\{  a_{k_{1}}^{\dagger}\cdots a_{k_{M}}^{\dagger
}a_{j_{N}}\cdots a_{j_{1}}a_{l_{1}}^{\dagger}\cdots a_{l_{P}}^{\dagger
}a_{m_{Q}}\cdots a_{m_{1}}\right\}  =0\text{ if }M+P\neq N+Q
\end{equation}%
\begin{align}
&  =\sum_{0\leq R\leq r}\sum_{1\leq i_{1}<\cdots<i_{R}\leq r}\left\langle
\varphi_{i_{1}\cdots}\varphi_{i_{R}}\left\vert a_{k_{1}}^{\dagger}\cdots
a_{k_{M}}^{\dagger}a_{j_{N}}\cdots a_{j_{1}}a_{l_{1}}^{\dagger}\cdots
a_{l_{P}}^{\dagger}a_{m_{Q}}\cdots a_{m_{1}}\right.  \varphi_{i_{1}\cdots
}\varphi_{i_{R}}\right\rangle \\
&  =\sum_{M+P\leq R\leq r}\sum_{1\leq i_{1}<\cdots<i_{R}\leq r}\left\langle
\varphi_{i_{1}\cdots}\varphi_{i_{R}}\left\vert a_{k_{1}}^{\dagger}\cdots
a_{k_{M}}^{\dagger}a_{j_{N}}\cdots a_{j_{1}}a_{l_{1}}^{\dagger}\cdots
a_{l_{P}}^{\dagger}a_{m_{Q}}\cdots a_{m_{1}}\right.  \varphi_{i_{1}\cdots
}\varphi_{i_{R}}\right\rangle
\end{align}


\subsection{Particle Conserving Operators}

The operator ideal spaces $\left\{  \mathcal{C}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  ,\mathcal{B}_{k}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  ;1\leq\kappa\leq2\right\}  $ are contained in $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ and
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{C}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}_{2}\left(
\mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}_{1}\left(
\mathcal{H}_{\mathcal{F}}\right)  \supseteq\mathcal{B}_{0}\left(
\mathcal{H}_{\mathcal{F}}\right)  ,
\end{equation}
where $\mathcal{C}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ are compact,
$\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ are Hilbert
Schmidt, $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ are trace
class and $\mathcal{B}_{0}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ are
finite rank operators. The spaces $\left\{  \mathcal{C}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  ,\mathcal{B}_{k}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  ;1\leq\kappa\leq2\right\}  $ are complete normed spaces, which are
the completions of $\mathcal{B}_{0}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
in the appropriate norms. Thus it is often more convenient to work within the
context of finite rank operators and take the appropriate limits (if they
exist) when necessary. In finite dimensions all the these are spaces are
identical and can be considered as finite dimensional approximations
corresponding to $\dim\left(  \mathcal{H}_{\mathcal{F}}\right)  =2^{r}$ and
$\dim\left(  \mathcal{H}^{1}\right)  =r$.

The self adjoint number operator, $\mathcal{N}_{1},$ defined as
\begin{equation}
\mathcal{N}_{1}\mathcal{\,}=\sum_{1\leq j\leq\infty}a_{j}^{\dagger}a_{j}%
=\int\Phi\left(  \boldsymbol{x}\right)  ^{\dagger}\Phi\left(  \boldsymbol{x}%
\right)  dx
\end{equation}
allows one to decomposes the space $\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ into a direct sum of operators that commute with
$\mathcal{N}$ and those that do not as
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}\oplus\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{o},
\end{equation}
where
\begin{align}
\widehat{\mathcal{N}_{1}}  &  =\left[  \mathcal{N}_{1},\right]  :\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  \rightarrow\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right) \nonumber\\
\widehat{\mathcal{N}_{1}}  &  :\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\nonumber\\
\widehat{\mathcal{N}_{1}}  &  :\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{o}\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{o}.
\end{align}


\subsubsection{Even Fock Algebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}$}

The subspace $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ can
be identified with polynomials and strong limits of polynomials of products of
an even numbers of creators and annihilators in \emph{normal form} i.e.%
\begin{equation}
X=\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}<\cdots
<k_{P}\leq\infty}}X_{j_{1}\cdots j_{P}k_{1}\cdots k_{P}}a_{j_{1}}^{\dagger
}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}},
\end{equation}
while the subspace $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{o}$
corresponds to polynomials of products of an unequal number of creators and
annihilators. The subspace $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e}$ decomposes as the direct sums
\begin{align}
\mathcal{F}_{e}  &  =\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}\nonumber\\
&  =%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eN}\label{BanSp}\\
&  \cong%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N}\right)  , \label{BanAlg}%
\end{align}
where
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e0}=\mathbb{C}%
I_{\mathcal{H}_{\mathcal{F}}},
\end{equation}
$I_{\mathcal{H}_{\mathcal{F}}}$ is the identity operator in $\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  ,$%
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{0}\right)  =\mathbb{C}\left\vert
\phi\right\rangle \left\langle \phi\right\vert
\end{equation}
and the two Banach space direct sums are \emph{different} but isomorphic. In
order to show the validity of the first decomposition one needs to show that
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eN}\cap\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eN^{\prime}}=\phi
\end{equation}
or equivalently that
\begin{equation}
\sum_{0\leq N\leq\infty}A_{N}=0\Leftrightarrow A_{N}=0,0\leq N\leq\infty
,A_{N}\in\mathcal{B}_{sa}\left(  \mathcal{H}^{N}\right)  .
\end{equation}
It is easy to see that the last condition is satisfied, consider
\begin{equation}
\left(  \sum_{0\leq N\leq\infty}A_{N}\right)  \left\vert \Psi_{M}%
\right\rangle
\end{equation}
and chose $\left\vert \Psi_{M}\right\rangle \in\mathcal{H}^{M},$ $0\leq
M\leq\infty.$

The spaces $\mathcal{B}_{0sa}\left(  \mathcal{H}^{N}\right)  ,0\leq
N\leq\infty$ are orthogonal with respect to the H-S norm, but $\mathcal{B}%
_{0sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eN}$ are not, consider%
\begin{align}
&  \sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}X_{j_{1}\cdots j_{P}k_{1}\cdots k_{P}}%
\operatorname*{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger
}a_{k_{P}}\cdots a_{k_{1}}\mathcal{N}_{1}\right\}  ,P\neq N\nonumber\\
&  =\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}X_{j_{1}\cdots j_{P}k_{1}\cdots k_{P}}%
\operatorname*{Tr}\nolimits_{N}\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{P}%
}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}\right\}  \neq0.
\end{align}


The subspaces $\left\{  \left.  \mathcal{B}\left(  \mathcal{H}^{N}\right)
\right\vert 0\leq N\leq\infty\right\}  $ are subalgebras while the subspaces
$\left\{  \left.  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{N}\right\vert 0\leq N\leq\infty\right\}  $ \emph{are not }(the identity has
components in all the spaces and $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{1}$ has to have the identity added to it to be closed). Thus eq.
$\left(  \ref{BanAlg}\right)  $ is a direct sum of algebras while eq. $\left(
\ref{BanSp}\right)  $ is just a direct sum of Banach spaces.

\subsubsection{Odd Fock Algebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{o}$}

The odd Fock algebra can be expanded as the direct sums
\begin{align}
\mathcal{F}_{o}  &  =\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{o}\nonumber\\
&  =%
%TCIMACRO{\dbigoplus \limits_{0\leq N,M;N\neq M\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N,M;N\neq M\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{NM}\\
&  \cong%
%TCIMACRO{\dbigoplus \limits_{0\leq N,M;N\neq M\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N,M;N\neq M\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N},\mathcal{H}^{M}\right)  ,
\end{align}
where $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{NM}$ are
polynomials of $N$ creators and $M$ annihilators and $\mathcal{B}\left(
\mathcal{H}^{N},\mathcal{H}^{M}\right)  $ are bounded linear maps from
$\mathcal{H}^{N}$ to $\mathcal{H}^{M}.$

\subsection{Complexification}

As density operators and Hamiltonians are in general self adjoint we can
restrict attention to the real space $\mathcal{B}_{sa}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  ,$which is a real subspace of $\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  $ such that its complexification gives
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ i.e.
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  =\mathcal{B}_{sa}\left(
\mathcal{H}_{\mathcal{F}}\right)  \oplus i\mathcal{B}_{sa}\left(
\mathcal{H}_{\mathcal{F}}\right)
\end{equation}
such that $Z\in\mathcal{B}_{2}\left(  \mathcal{H}^{N}\right)  ,$ where
\begin{equation}
Z=X+iY;\text{ }X,Y\in\mathcal{B}_{2sa}\left(  \mathcal{H}^{N}\right)  .
\end{equation}
The inner product in $\mathcal{B}_{2}\left(  \mathcal{H}^{N}\right)  $ is
defined in terms of the inner product in $\mathcal{B}_{2sa}\left(
\mathcal{H}^{N}\right)  $ as
\begin{equation}
\left(  Z_{1}\left\vert Z_{2}\right.  \right)  _{NHS}=\left(  X_{1}\left\vert
X_{2}\right.  \right)  _{N}+\left(  Y_{1}\left\vert Y_{2}\right.  \right)
_{N}+i\left\{  \left(  X_{1}\left\vert Y_{2}\right.  \right)  _{N}-\left(
Y_{1}\left\vert X_{2}\right.  \right)  _{N}\right\}  ,
\end{equation}
which corresponds to
\begin{equation}
\left(  Z_{1}\left\vert Z_{2}\right.  \right)  _{NHS}=\operatorname{Tr}%
\left\{  Z_{1}^{\dagger}Z_{2}\right\}  ,
\end{equation}
as%
\begin{equation}
\operatorname{Tr}\left\{  \left(  X_{1}-iY_{1}\right)  \left(  X_{2}%
+iY_{2}\right)  \right\}  =\operatorname{Tr}\left\{  X_{1}X_{2}-iY_{1}%
X_{2}+iX_{1}Y_{2}+Y_{1}Y_{2}\right\}  .
\end{equation}


For density operators and Hamiltonians that commute with the number operator
$\mathcal{N}$ we can wlog consider $\mathcal{B}_{sa}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}.$

Note that $\mathcal{B}_{2sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ (self
adjoint operators) and $i\mathcal{B}_{2sa}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  $ (anti self adjoint operators) are not orthogonal subspaces of
$\mathcal{B}_{2}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ as they are not
even subspaces under $\mathbb{C}$-linear combination.

The are not closed under the operator product, however they are closed under
the Jordan product and thus form Jordan algebras (which are non associative).

\subsubsection{Linear Maps $M:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $}%

\begin{align}
M\left(  X\right)   &  =\sum_{0\leq P,Q,R\leq\infty}P_{\mathcal{B}\left(
\mathcal{H}^{P}\right)  }MP_{\mathcal{B}\left(  \mathcal{H}^{Q}\right)
}P_{\mathcal{B}\left(  \mathcal{H}^{R}\right)  }X=\sum_{0\leq P,Q\leq\infty
}P_{\mathcal{B}\left(  \mathcal{H}^{P}\right)  }MP_{\mathcal{B}\left(
\mathcal{H}^{Q}\right)  }X\nonumber\\
&  =\sum_{0\leq P,Q\leq\infty}M_{PQ}X_{Q}=\sum_{0\leq P\leq\infty}M_{P}\left(
X\right)  .
\end{align}


The inverse of $M$ is given by%

\begin{equation}
\sum_{0\leq P,Q,R\leq\infty}M_{PQ}\left(  M^{-1}\right)  _{QR}=I_{\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  }=\sum_{0\leq P,Q,R\leq\infty
}\left(  M^{-1}\right)  _{PQ}M_{QR}.
\end{equation}
In particular if
\begin{equation}
L\left(  X_{N}\right)  =\sum_{0\leq P\leq\infty}L_{P}\left(  X_{N}\right)
=\sum_{0\leq P\leq N\leq\infty}\binom{N}{P}L_{N}^{P}\left(  X_{N}\right)
,\nonumber
\end{equation}
so if $X=X_{N}$ one has
\begin{equation}
X_{N}=L^{-1}L\left(  X_{N}\right)  =\sum_{0\leq P\leq\infty}\left(
L^{-1}\right)  _{P}^{N}L_{N}^{P}\left(  X_{N}\right)  .
\end{equation}


Conssider two orthonormal bases $\left\{  e_{j}\right\}  $ and $\left\{
f_{j}\right\}  $ then
\begin{equation}
M=\sum_{j,k}\left(  e_{j}\left\vert Mf_{k}\right.  \right)  \left\vert
e_{j}\right)  \left(  f_{k}\right\vert
\end{equation}%
\begin{equation}
\left\vert \mathbf{e}\right)  \Delta_{e}^{-\frac{1}{2}}\Delta_{f}^{-\frac
{1}{2}}\left(  \mathbf{f}\right\vert \left\vert \mathbf{e}\right)  \Delta
_{e}^{-\frac{1}{2}}\Delta_{f}^{-\frac{1}{2}}\left(  \mathbf{f}\right\vert =
\end{equation}%
\begin{equation}
\left\vert \mathbf{e}\right)  \Delta_{e}^{-1}\left(  \mathbf{e}\right\vert
\left\vert \mathbf{e}\right)  \Delta_{e}^{-1}\left(  \mathbf{e}\right\vert
=\left\vert \mathbf{e}\right)  \Delta_{e}^{-1}\left(  \mathbf{e}\right\vert
\end{equation}


\subsubsection{Contraction and Expansion Maps $L$ and $\Gamma$}%

\begin{align}
D_{PQj_{1}\cdots j_{P}k_{1}\cdots k_{Q}}  &  =\left(  \left.  a_{j_{1}%
}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}\right\vert
D\right)  _{\mathcal{F}}=\left(  \left.  \Gamma\left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right)  \right\vert D\right)
_{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert
\right\vert L\left(  D\right)  \right)  _{\mathcal{F}}=L\left(  D\right)
_{j_{1}\cdots j_{P}k_{1}\cdots k_{Q}},
\end{align}
which defines the operator%
\begin{equation}
D_{PQ}:\mathcal{H}^{Q}\rightarrow\mathcal{H}^{P}%
\end{equation}
by%
\begin{equation}
D_{PQ}=\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{Q}\leq\infty}}L\left(  D\right)  _{j_{1}\cdots j_{P}k_{1}\cdots
k_{Q}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert .
\end{equation}
The contraction and expansion maps are linear and have components
\begin{subequations}
\label{ExpConCom}%
\begin{align}
P_{\mathcal{B}\left(  \mathcal{H}^{P}\right)  }LP_{\mathcal{B}\left(
\mathcal{H}^{N}\right)  }  &  =L_{PN}=\binom{N}{P}^{-1}L_{N}^{P};N\geq
P\nonumber\\
P_{\mathcal{B}\left(  \mathcal{H}^{N}\right)  }\Gamma P_{\mathcal{B}\left(
\mathcal{H}^{P}\right)  }  &  =\Gamma_{NP}=\binom{N}{P}^{-1}\Gamma_{P}%
^{N};N\geq P
\end{align}
and thus are triangular maps.

The contraction and expansion maps commute with the representations
$\mathcal{R}_{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }\left(
U\left(  \mathcal{H}^{1}\right)  \right)  $ and $\mathcal{R}_{\mathcal{B}%
\left(  \mathcal{H}^{N}\right)  }\left(  U\left(  \mathcal{H}^{1}\right)
\right)  ,$ $0\leq N\leq\infty$ of the unitary group $U\left(  \mathcal{H}%
^{1}\right)  $ i.e.
\end{subequations}
\begin{align}
L\left(  \mathcal{R}_{\mathcal{F}}\left(  u\right)  X\right)   &
=\mathcal{R}_{\mathcal{F}}\left(  u\right)  L\left(  X\right) \nonumber\\
\Gamma\left(  \mathcal{R}_{\mathcal{F}}\left(  u\right)  X\right)   &
=\mathcal{R}_{\mathcal{F}}\left(  u\right)  \Gamma\left(  X\right)
\end{align}
and their components intertwine the representations $\mathcal{R}%
_{\mathcal{B}\left(  \mathcal{H}^{N}\right)  }\left(  U\left(  \mathcal{H}%
^{1}\right)  \right)  $ and $\mathcal{R}_{\mathcal{B}\left(  \mathcal{H}%
^{P}\right)  }\left(  U\left(  \mathcal{H}^{1}\right)  \right)  ,$ $0\leq
N\leq\infty;0\leq P\leq N$ i.e.
\begin{equation}
L_{N}^{P}\left(  \mathcal{R}_{\mathcal{B}\left(  \mathcal{H}^{N}\right)
}\left(  u\right)  X\right)  =\mathcal{R}_{\mathcal{B}\left(  \mathcal{H}%
^{P}\right)  }\left(  u\right)  L_{N}^{P}\left(  X\right)
\end{equation}%
\begin{equation}
\Gamma_{P}^{N}\left(  \mathcal{R}_{\mathcal{B}\left(  \mathcal{H}^{N}\right)
}\left(  u\right)  X\right)  =\mathcal{R}_{\mathcal{B}\left(  \mathcal{H}%
^{N}\right)  }\left(  u\right)  \Gamma_{P}^{N}\left(  X\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{R}_{\mathcal{F}}\left(  u\right)  X=uXu^{\dagger}=\hat{u}\left(
X\right)  =\left[  Adj(u)\right]  (X);\mathcal{B}\left(  \mathcal{H}%
^{N}\right)  .
\end{equation}
One should note that
\begin{equation}
\left.  \mathcal{R}_{\mathcal{F}}\right\vert _{\mathcal{H}^{N}}=\mathcal{R}%
_{\mathcal{B}\left(  \mathcal{H}^{N}\right)  }.
\end{equation}


\section{Expansion and Contraction Maps.}

Recall that the second quantization map is
\begin{equation}
\Gamma\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \right)
=a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}%
}=\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \wedge I_{\mathcal{H}%
_{\mathcal{F}}}.
\end{equation}
$\lceil$In particular%
\[
a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}=\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \wedge I_{\mathcal{H}_{\mathcal{F}}}\rfloor.
\]
The states $D$ are determined by their values
\begin{align}
&  \left\{  \left.  f_{D}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger
}a_{k_{Q}}\cdots a_{k_{1}}\right)  \right\vert 1\leq j_{1}<\cdots<j_{P}%
\leq\infty,1\leq k_{1}<\cdots<k_{Q}\leq\infty,0\leq P,Q\leq\infty\right\}
\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.
\Updownarrow\right. \nonumber\\
&  \left\{  \left.  \left(  \left.  a_{j_{1}}^{\dagger}\cdots a_{j_{P}%
}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}}\right\vert D\right)  _{\mathcal{F}%
}\right\vert 1\leq j_{1}<\cdots<j_{P}\leq\infty,1\leq k_{1}<\cdots<k_{Q}%
\leq\infty,0\leq P,Q\leq\infty\right\}
\end{align}
on the operators $\left\{  \left.  a_{j_{1}}^{\dagger}\cdots a_{j_{P}%
}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}}\right\vert 1\leq j_{1}<\cdots<j_{P}%
\leq\infty,1\leq k_{1}<\cdots<k_{Q}\leq\infty,0\leq P,Q\leq\infty\right\}  $
i.e.
\begin{align}
f_{D}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{Q}}\cdots
a_{k_{1}}\right)   &  =\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger}\cdots
a_{k_{Q}}^{\dagger}a_{j_{P}}\cdots a_{j_{1}}D\right\}  =\left(  \left.
a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}%
}\right\vert D\right)  _{\mathcal{F}};\nonumber\\
1  &  \leq j_{1}<\cdots<j_{P}\leq\infty,1\leq k_{1}<\cdots<k_{Q}\leq
\infty,0\leq P,Q\leq\infty.
\end{align}
It should be noted that these \emph{are not} the matrix elements of $D$ wrt to
the basis $\left\{  \left.  \varphi_{j}\right\vert 1\leq j\leq\infty\right\}
,$ which are
\begin{align}
D_{j_{1}\cdots j_{P}k_{1}\cdots k_{Q}}  &  =\left(  \left.  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right\vert D\right)  _{\mathcal{F}%
}=\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert \right)  D\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert \right)  D_{PQ}\right\}
\end{align}
but are the matrix elements of the "reduced density/transition matrices"
\begin{align}
&  D_{PQj_{1}\cdots j_{P}k_{1}\cdots k_{Q}}=\operatorname{Tr}\left\{
a_{k_{1}}^{\dagger}\cdots a_{k_{Q}}^{\dagger}a_{j_{P}}\cdots a_{j_{1}%
}D\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert \wedge I_{\mathcal{H}_{\mathcal{F}}}\right)  D\right\}
\nonumber\\
&  =\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\vert \wedge\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots
<l_{N}\leq\infty}}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\rangle
\left\langle \varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\vert \right)
D\right\} \nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N}\leq\infty
}}\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\varphi_{l_{1}}\cdots\varphi_{l_{N}%
}\right\vert \right)  D\right\} \nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N}\leq\infty
}}D_{j_{1}\cdots j_{P}l_{1}\cdots l_{N}k_{1}\cdots k_{Q}l_{1}\cdots l_{N}%
}=\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N}\leq\infty
}}\left(  D_{N+P,N+Q}\right)  _{j_{1}\cdots j_{P}l_{1}\cdots l_{N}k_{1}\cdots
k_{Q}l_{1}\cdots l_{N}},
\end{align}
i.e.
\begin{equation}
D_{PQj_{1}\cdots j_{P}k_{1}\cdots k_{Q}}=\operatorname{Tr}\left\{  a_{k_{1}%
}^{\dagger}\cdots a_{k_{Q}}^{\dagger}a_{j_{P}}\cdots a_{j_{1}}D\right\}
=\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N}\leq\infty
}}\left(  D_{N+P,N+Q}\right)  _{j_{1}\cdots j_{P}l_{1}\cdots l_{N}k_{1}\cdots
k_{Q}l_{1}\cdots l_{N}}%
\end{equation}
$\lceil$this defines reduction in terms of partial traces of in general
rectangular matrices$\rfloor$ where
\begin{equation}
D=\sum_{1\leq R,S\leq\infty}D_{RS};\quad D_{RS}=P_{R}DP_{S}\equiv
P_{\mathcal{H}^{R}}DP_{\mathcal{H}^{S}}.
\end{equation}


Using the second quantization map $\Gamma$ we have in general that
\begin{align}
D_{PQj_{1}\cdots j_{P}k_{1}\cdots k_{Q}}  &  =\left(  \left.  a_{j_{1}%
}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}\right\vert
D\right)  _{\mathcal{F}}=\left(  \left.  \Gamma\left(  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert \right)  \right\vert D\right)
_{\mathcal{F}}\nonumber\\
&  =\left(  \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert
\right\vert L\left(  D\right)  \right)  _{\mathcal{F}}=L\left(  D\right)
_{j_{1}\cdots j_{P}k_{1}\cdots k_{Q}}%
\end{align}
and that the general "reduced density/transition operator" is
\begin{equation}
D_{PQ}=\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{Q}\leq\infty}}D_{PQj_{1}\cdots j_{P}k_{1}\cdots k_{Q}}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{Q}}\right\vert .
\end{equation}
The SORDM\ for \emph{any }ensemble, $D,$ of pure number states is defined as
\begin{align}
&  D_{2j_{1}j_{2}k_{1}k_{2}}=\left(  \left.  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}\right\vert D\right)  _{\mathcal{F}%
}=\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}%
}a_{j_{1}}D\right\}  =\sum_{0\leq N\leq\infty}\operatorname{Tr}\left\{
a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}D^{N}\right\}
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger
}a_{k_{2}}^{\dagger}\mathcal{N}_{N-2}a_{j_{2}}a_{k_{2}}D^{N}\right\}
=\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N-2}\leq\infty
}}\operatorname{Tr}\left\{  a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{l_{1}%
}^{\dagger}\cdots a_{l_{N-2}}^{\dagger}a_{l_{N-2}}\cdots a_{l_{1}}a_{j_{2}%
}a_{j_{1}}D^{N}\right\} \nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N-2}\leq\infty
}}D_{j_{1}j_{2}l_{1}\cdots l_{N-2}k_{1}k_{2}l_{1}\cdots l_{N-2}}^{N},
\end{align}
$\lceil$ The use of the number operator is not necessary it just gives an
equivalent formulation$\rfloor$ where $D^{N}\equiv D^{N,N}$, $0!=1$ and $N!=0$
for $N<0$ and thus the general SORDO $D_{2}$ for \emph{any }ensemble, $D,$ of
pure number states is given as
\begin{align}
D_{2}  &  =\sum_{0\leq N\leq\infty}\sum_{\substack{1\leq j_{1}<j_{2}\leq
\infty\\1\leq k_{1}<k_{2}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\sum_{0\leq N\leq\infty}\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq
k_{1}<k_{2}\leq\infty}}\sum_{1\leq l_{1}<\cdots<l_{N-2}\leq\infty}%
D_{j_{1}j_{2}l_{1}\cdots l_{N-2}k_{1}k_{2}l_{1}\cdots l_{N-2}}^{N}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert .
\end{align}
As%
\begin{align}
\binom{N}{2}L_{N}^{2}\left(  D^{N}\right)   &  =\sum_{\substack{1\leq
j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty}}\operatorname{Tr}\left\{
a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{1}}a_{k_{2}}D^{N}\right\}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}D_{N2j_{1}j_{2}k_{2}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert ;0\leq
P\leq N,
\end{align}
one obtains%
\begin{equation}
L_{N}^{2}\left(  D^{N}\right)  _{j_{1}j_{2}k_{2}k_{2}}=\binom{N}{2}^{-1}%
\sum_{1\leq l_{1}<\cdots<l_{N-2}\leq\infty}D_{j_{1}j_{2}l_{1}\cdots
l_{N-2}k_{1}k_{2}l_{1}\cdots l_{N-2}}^{N}%
\end{equation}
and%
\begin{equation}
D_{2}=\sum_{2\leq N\leq\infty}\binom{N}{2}L_{N}^{2}\left(  D^{N}\right)  .
\end{equation}
Thus for any such state $D$ one has the following trace formula%
\begin{align}
\operatorname{Tr}D_{2}  &  =\sum_{\substack{0\leq N\leq\infty\\1\leq
l_{1}<\cdots<l_{N}\leq\infty\\1\leq j_{1}<j_{2}\leq\infty}}D_{j_{1}j_{2}%
l_{1}\cdots l_{N}j_{1}j_{2}l_{1}\cdots l_{N}}=\sum_{0\leq N\leq\infty}%
\sum_{\substack{1\leq l_{1}<\cdots<l_{N-2}\leq\infty\\1\leq j_{1}<j_{2}%
\leq\infty}}D_{j_{1}j_{2}l_{1}\cdots l_{N-2}j_{1}j_{2}l_{1}\cdots l_{N-2}}%
^{N}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\frac{1}{2!\left(  N-2\right)  !}\sum
_{\substack{1\leq l_{1},\cdots,l_{N-2}\leq\infty\\1\leq j_{1}<j_{2}\leq\infty
}}D_{j_{1}j_{2}l_{1}\cdots l_{N-2}j_{1}j_{2}l_{1}\cdots l_{N-2}}%
^{N}\nonumber\\
&  =\sum_{0\leq N\leq\infty}\frac{N!}{2!\left(  N-2\right)  !}\sum_{1\leq
l_{1}<\cdots<l_{N}\leq\infty}D_{l_{1}\cdots l_{N}l_{1}\cdots l_{N}}^{N}%
=\sum_{0\leq N\leq\infty}\binom{N}{2}\operatorname{Tr}\left\{  D^{N}\right\}
\nonumber\\
&  =\sum_{0\leq N\leq\infty}\binom{N}{2}\operatorname{Tr}\left\{  L_{N}%
^{2}\left(  D^{N}\right)  \right\}  .
\end{align}
$\lceil$The $N!$ comes from expressing the unordered form of the trace in
terms of the ordered form$\rfloor$ This can be expressed as
\begin{align}
\operatorname{Tr}D_{2}  &  =\sum_{0\leq N\leq\infty}\sum_{1\leq j_{1}%
<j_{2}\leq\infty}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{j_{2}}a_{j_{1}}D^{N}\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \sum_{1\leq j_{1}<j_{2}\leq\infty}a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}D^{N}\right\}  =\sum_{0\leq
N\leq\infty}\binom{N}{2}\operatorname{Tr}D^{N}.
\end{align}
In particular for a pure number state
\begin{align}
\operatorname{Tr}D_{2N}  &  =\operatorname{Tr}\left\{  \sum_{1\leq j_{1}%
<j_{2}\leq\infty}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}%
D^{N}\right\}  =\operatorname{Tr}\left\{  \mathcal{N}_{2}D^{N}\right\}
\nonumber\\
&  =\sum_{\substack{1\leq l_{1}<\cdots<l_{N-2}\leq\infty\\1\leq j_{1}%
<j_{2}\leq\infty}}D_{j_{1}j_{2}l_{1}\cdots l_{N-2}j_{1}j_{2}l_{1}\cdots
l_{N-2}}^{N}=\binom{N}{2}.
\end{align}
One gets the same results using the ket-bra representation of the second
quantized operators i.e. for a general state $D$ the matrix elements of the
SORDM\ are
\begin{align}
D_{2j_{1}j_{2}k_{1}k_{2}}  &  =\operatorname{Tr}\left\{  \left(  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \wedge\sum_{\substack{0\leq N\leq\infty\\1\leq
l_{1}<\cdots<l_{N}\leq\infty}}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{N}%
}\right\rangle \left\langle \varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\vert
\right)  D\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \left(  \left\vert \varphi_{j_{1}}\varphi
_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
\wedge\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1},\cdots,l_{N}\leq\infty
}}\frac{1}{N!}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\rangle
\left\langle \varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\vert \right)
D\right\} \nonumber\\
&  =\operatorname{Tr}\left\{  \sum_{\substack{0\leq N\leq\infty\\1\leq
l_{1},\cdots,l_{N}\leq\infty}}\frac{1}{\left(  N-2\right)  !}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{1}}\cdots\varphi_{l_{N-2}%
}\right\rangle \left\langle \varphi_{l_{1}}\cdots\varphi_{l_{N-2}}%
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert D^{N}\right\} \nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1},\cdots,l_{N}\leq\infty
}}\frac{1}{\left(  N-2\right)  !}\left\langle \left.  \varphi_{l_{1}}%
\cdots\varphi_{l_{N-2}}\varphi_{j_{1}}\varphi_{j_{2}}\right\vert D^{N}%
\varphi_{l_{1}}\cdots\varphi_{l_{N-2}}\varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle
\end{align}%
\begin{equation}
D_{2j_{1}j_{2}k_{1}k_{2}}=\sum_{\substack{0\leq N\leq\infty\\1\leq
l_{1}<\cdots<l_{N-2}\leq\infty}}\left\langle \left.  \varphi_{l_{1}}%
\cdots\varphi_{l_{N-2}}\varphi_{j_{1}}\varphi_{j_{2}}\right\vert D^{N}%
\varphi_{l_{1}}\cdots\varphi_{l_{N-2}}\varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle
\end{equation}
hence%
\begin{equation}
D_{2j_{1}j_{2}k_{1}k_{2}}=\sum_{0\leq N\leq\infty}\binom{N}{2}L_{N}^{2}\left(
D^{N}\right)  _{j_{1}j_{2}k_{1}k_{2}},
\end{equation}
where%
\begin{align}
\binom{N}{2}L_{N}^{2}\left(  D^{N}\right)   &  =\sum_{\substack{1\leq
j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty}}\operatorname{Tr}\left\{
a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{1}}a_{k_{2}}D^{N}\right\}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}D_{N2j_{1}j_{2}k_{2}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert ;0\leq
P\leq N,
\end{align}%
\begin{align}
L_{N}^{2}\left(  D^{N}\right)  _{j_{1}j_{2}k_{1}k_{2}}  &  =\binom{N}{2}%
^{-1}\sum_{1\leq l_{1}<\cdots<l_{N-2}\leq\infty}D_{j_{1}j_{2}l_{1}\cdots
l_{N-2}k_{1}k_{2}l_{1}\cdots l_{N-2}}^{N}\nonumber\\
&  =\binom{N}{2}^{-1}\sum_{1\leq l_{1}<\cdots<l_{N-2}\leq\infty}\left\langle
\left.  \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{1}}\cdots\varphi_{l_{N-2}%
}\right\vert D^{N}\varphi_{k_{1}}\varphi_{k_{2}}\varphi_{l_{1}}\cdots
\varphi_{l_{N-2}}\right\rangle
\end{align}
and
\begin{equation}
\binom{N}{2}L_{N}^{2}\left(  D^{N}\right)  _{j_{1}j_{2}k_{1}k_{2}%
}=\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{1}%
}a_{k_{2}}D^{N}\right\}  .
\end{equation}
In the case of a pure number state one obtains%
\begin{align}
&  \operatorname{Tr}\left\{  D_{2N}\right\}  =\sum_{\substack{1\leq
l_{1},\cdots,l_{N-2}\leq\infty\\1\leq j_{1},j_{2}\leq\infty}}\frac
{1}{2!\left(  N-2\right)  !}\left\langle \left.  \varphi_{j_{1}}\varphi
_{j_{2}}\varphi_{l_{1}}\cdots\varphi_{l_{N-2}}\right\vert D^{N}\varphi_{k_{1}%
}\varphi_{k_{2}}\varphi_{l_{1}}\cdots\varphi_{l_{N-2}}\right\rangle
\nonumber\\
&  =\frac{N!}{2!\left(  N-2\right)  !}\sum_{1\leq l_{1}<\cdots<l_{N}\leq
\infty}\left\langle \left.  \varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\vert
D^{N}\varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\rangle =\binom{N}%
{2}\operatorname{Tr}D^{N}=\binom{N}{2}.
\end{align}
The normalization condition for states is
\begin{align}
\operatorname{Tr}\left\{  D\right\}   &  =\sum_{1\leq l_{1}<\cdots<l_{N}%
\leq\infty}D_{l_{1}\cdots l_{N}l_{1}\cdots l_{N}}=\sum_{\substack{0\leq
N\leq\infty\\1\leq l_{1}<\cdots<l_{N}\leq\infty}}D_{l_{1}\cdots l_{N}%
l_{1}\cdots l_{N}}^{N}\nonumber\\
&  =\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1},\cdots,l_{N}\leq\infty
}}\operatorname{Tr}D^{N}=\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}%
,\cdots,l_{N}\leq\infty}}\frac{1}{N!}D_{l_{1}\cdots l_{N}l_{1}\cdots l_{N}%
}^{N}=1.
\end{align}


One can construct a "contraction" map $L:\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}\rightarrow\mathcal{B}_{1}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e}$ by
\begin{equation}
L\left(  D\right)  =L\left(  \sum_{0\leq P\leq\infty}D_{P}\right)
=\sum_{0\leq P\leq\infty}L_{P}\left(  D\right)  =\sum_{\substack{P\leq
N\leq\infty\\0\leq P\leq\infty}}\binom{N}{P}L_{N}^{P}\left(  D_{N}\right)  ,
\end{equation}
where
\begin{align}
D  &  =\sum_{0\leq N\leq\infty}D_{N},\nonumber\\
D_{N}  &  \in\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)  ;0\leq N\leq
\infty.
\end{align}
This map is adjoint to the restricted second quantization map $\Gamma
:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\rightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$ given by
\begin{equation}
\Gamma\left(  X\right)  =\Gamma\left(  \sum_{0\leq P\leq\infty}X_{P}\right)
=\sum_{0\leq P\leq\infty}\Gamma\left(  X_{P}\right)  =\sum_{0\leq P\leq\infty
}\Gamma_{P}\left(  X\right)  =\sum_{0\leq P\leq\infty}\sum_{P\leq N\leq\infty
}\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right)  ,
\end{equation}
where
\begin{align}
X  &  =\sum_{0\leq P\leq\infty}X_{P},\nonumber\\
X_{P}  &  \in\mathcal{B}_{1}\left(  \mathcal{H}^{P}\right)  ;0\leq P\leq
\infty.\nonumber
\end{align}
$\lceil$%
\begin{equation}
\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert \right)
==\Gamma\left(  \left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P}}\right\rangle
\left\langle \varphi_{m_{1}}\cdots\varphi_{m_{P}}\right\vert \right)
=\sum_{0\leq N\leq\infty}\Gamma_{N}\left(  \left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{P}}\right\vert \right)  =\sum_{\substack{0\leq N\leq\infty\\0\leq
P\leq N}}\binom{N}{P}\Gamma_{P}^{N}\left(  \left\vert \varphi_{l_{1}}%
\cdots\varphi_{l_{P}}\right\rangle \left\langle \varphi_{m_{1}}\cdots
\varphi_{m_{P}}\right\vert \right)
\end{equation}
$\rfloor$

$\bigskip$

$\lceil$ The subspaces $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e}$ and $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{o}$ are
invariant subspaces of $\Gamma$ and thus of $L$ which can thus be defined on
all of $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \rfloor$

The Banach space $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$
is the dual of $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}$
through the scalar product $\left(  \bullet\left\vert \bullet\right.  \right)
_{\mathcal{F}},$ where
\begin{equation}
\left(  X\left\vert D\right.  \right)  _{\mathcal{F}_{e}}=\sum_{0\leq
N\leq\infty}\left(  X^{N}\left\vert D^{N}\right.  \right)  _{N},\,X\in
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},D\in\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},
\end{equation}
where
\begin{equation}
\left(  X^{N}\left\vert D^{N}\right.  \right)  _{N}=\operatorname*{Tr}\left\{
X^{N\dagger}D^{N}\right\}  .
\end{equation}
Then $\Gamma=L^{\dagger}$ \cite{Kummar} i.e.
\begin{equation}
\left(  \Gamma\left(  X\right)  \left\vert D\right.  \right)  _{\mathcal{F}%
_{e}}=\left(  X\left\vert L\left(  D\right)  \right.  \right)  _{\mathcal{F}%
_{e}}.
\end{equation}
In general (including particle non conserving operators that have components
$X_{PQ},$ $P\neq Q$)
\begin{align}
&  \left(  \left.  \Gamma\left(  \left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}%
}\right\vert \right)  \right\vert D\right)  _{\mathcal{F}}=\left(  \left.
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \wedge I_{\mathcal{H}%
_{\mathcal{F}}}\right\vert D\right)  _{\mathcal{F}}\nonumber\\
&  \left.  =\right.  \left(  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger
}a_{k_{1}}\cdots a_{k_{Q}}\left\vert D\right.  \right)  _{\mathcal{F}}%
=f_{D}\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{1}}\cdots
a_{k_{Q}}\right) \nonumber\\
&  \left.  =\right.  \left(  \left.  \Gamma\left(  \left\vert \varphi_{j_{1}%
}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{Q}}\right\vert \right)  \right\vert D\right)  _{\mathcal{F}%
}=\left(  \left.  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \right\vert
L\left(  D\right)  \right)  _{\mathcal{F}}.
\end{align}


If $D$ is an $N$-particle state then%
\begin{align}
\binom{N}{N-P}D_{Pj_{1}\cdots j_{P}k_{1}\cdots k_{P}}  &  =\operatorname{Tr}%
\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}\mathcal{N}%
_{N-P}a_{k_{P}}\cdots a_{k_{1}}D\right\} \nonumber\\
\sum_{1\leq l_{1}<\cdots<l_{N}\leq\infty}D_{j_{1}\cdots j_{P}l_{P+1}\cdots
l_{N}k_{1}\cdots k_{P}l_{P+1}\cdots l_{N}}  &  =\binom{N}{N-P}%
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger
}a_{k_{P}}\cdots a_{k_{1}}D\right\}  .
\end{align}
This checks out as%
\begin{align}
&  \sum_{\substack{1\leq l_{P+1},\cdots,l_{N}\leq\infty\\1\leq j_{1}%
,\cdots,j_{P}\leq\infty}}D_{j_{1}\cdots j_{P}l_{P+1}\cdots l_{N}j_{1}\cdots
j_{P}l_{P+1}\cdots l_{N}}\nonumber\\
&  =\left(  N-P\right)  !P!\sum_{\substack{1\leq l_{P+1}<\cdots<l_{N}%
\leq\infty\\1\leq j_{1}<\cdots<j_{P}\leq\infty}}D_{j_{1}\cdots j_{P}%
l_{1}\cdots l_{N}j_{1}\cdots j_{P}l_{1}\cdots l_{N}}\nonumber\\
&  =\frac{\left(  N-P\right)  !P!N!}{\left(  N-P\right)  !P!}%
=N!\operatorname{Tr}D=N!.
\end{align}
Thus%
\begin{align}
\sum_{\substack{1\leq l_{1},\cdots,l_{N}\leq\infty\\1\leq j_{1},\cdots
,jP\leq\infty}}D_{j_{1}\cdots j_{P}l_{1}\cdots l_{N}j_{1}\cdots j_{P}%
l_{1}\cdots l_{N}}  &  =\binom{N}{N-P}\binom{N}{P}\nonumber\\
\operatorname{Tr}D_{P}  &  =\frac{1}{N!P!}\binom{N}{N-P}.
\end{align}
The contraction maps acting on pure number states are explicitly defined by
\begin{align}
\tilde{D}_{NP}  &  =L_{N}^{P}\left(  D^{N}\right)  =\binom{N}{P}^{-1}%
\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}<\cdots
<k_{P}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots
a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}D^{N}\right\}  \left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}%
}\cdots\varphi_{k_{P}}\right\vert \nonumber\\
&  =\binom{N}{P}^{-1}\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq
k_{1}<\cdots<k_{P}\leq\infty}}D_{NPj_{1}\cdots j_{P}k_{1}\cdots k_{P}%
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{P}}\right\vert ;0\leq P\leq N.
\end{align}
The contraction maps, $\left\{  \left.  L_{N}^{P}\right\vert 0\leq P\leq
N;0\leq N\leq\infty\right\}  ,$ map $N$-electron states%
\begin{equation}
S_{N}=\left\{  D^{N}\left\vert D^{N}\in\mathcal{B}_{1+}\left(  \mathcal{H}%
^{N}\right)  ;\operatorname{Tr}D^{N}=1\right.  \right\}  ,
\end{equation}
to reduced $P$-electron states
\begin{equation}
L_{N}^{P}:S_{N}\subset\mathcal{B}_{1+}\left(  \mathcal{H}^{N}\right)
\subset\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)  \longrightarrow
\tilde{S}_{NP}\subset S_{P}\subset\mathcal{B}_{1+}\left(  \mathcal{H}%
^{P}\right)  \subset\mathcal{B}_{1sa}\left(  \mathcal{H}^{P}\right)  ,
\end{equation}
where $\mathcal{B}_{1sa}\left(  \mathcal{H}^{N}\right)  $ is the space of self
adjoint trace class operators acting in $\mathcal{H}^{N},$ $\mathcal{B}%
_{1+}\left(  \mathcal{H}^{N}\right)  $ the cone of positive self adjoint trace
class operators, $S_{N}$ the convex set of $N$-electron states, $S_{P}%
,\mathcal{B}_{1+}\left(  \mathcal{H}^{P}\right)  ,\mathcal{B}_{1sa}\left(
\mathcal{H}^{P}\right)  $ the corresponding $P$-electron objects and
$\tilde{S}_{NP}$ the set of $N$- representable $P^{th}$ order Reduced Density
Operators (PRDO's) that are normalized to $1$ i.e.
\begin{equation}
\tilde{S}_{NP}=\left\{  \left.  \tilde{D}_{NP}\right\vert \tilde{D}_{NP}%
=L_{N}^{P}\left(  D^{N}\right)  ,D^{N}\in S_{N}\right\}  .
\end{equation}
The set, $\left\{  D_{NP}\right\}  ,$ of reduced density operators
\begin{equation}
D_{NP}=\binom{N}{P}\tilde{D}_{NP},
\end{equation}
normalized to the number of $P$-electron groups is denoted by $S_{NP}$ i.e.
\begin{equation}
S_{NP}=\left\{  \left.  D_{NP}\right\vert D_{NP}=\binom{N}{P}L_{N}^{P}\left(
D^{N}\right)  ,D^{N}\in S_{N}\right\}  ,
\end{equation}
thus
\begin{equation}
S_{NP}=\binom{N}{P}\tilde{S}_{NP}.
\end{equation}


As $S_{N},S_{P},S_{NP}$ and $\tilde{S}_{NP}$ are convex sets they are
generated by their extreme points $\operatorname*{ext}\left\{  S_{N}\right\}
,\operatorname*{ext}\left\{  S_{P}\right\}  ,\operatorname*{ext}\left\{
S_{NP}\right\}  $ and $\operatorname*{ext}\left\{  \tilde{S}_{NP}\right\}
.$The extreme points $\operatorname*{ext}\left\{  S_{N}\right\}
,\operatorname*{ext}\left\{  S_{P}\right\}  $ of $S_{N}$ and $S_{P}$
respectively are pure states that are projectors onto one dimensional
subspaces of $\mathcal{H}^{N}$ and $\mathcal{H}^{P}$ (their rank is 1), which
should be contrasted to the extreme points $\operatorname*{ext}\left\{
\tilde{S}_{NP}\right\}  $whose rank can never be one ($N\neq P,0$ ) and thus
must generate a subset of $S_{P}.$ These subsets are convex sets of
\emph{mixed states }$\equiv$ \emph{ensemble states}$.$ In the case $P=1$
\begin{equation}
\tilde{S}_{N1}=\left\{  \left.  \tilde{D}_{N1}\right\vert \tilde{D}_{N1}%
=L_{N}^{1}\left(  D^{N}\right)  ,D^{N}\in S_{N}\right\} \nonumber
\end{equation}
and it is easy to see that
\begin{equation}
\operatorname*{Tr}\left\{  \tilde{D}_{N1}\right\}  =1\text{ and }\tilde
{D}_{N1}\geq0\text{ for }\tilde{D}_{N1}\in\tilde{S}_{N1}%
\end{equation}
thus
\begin{equation}
\tilde{S}_{N1}\subset S_{1}.
\end{equation}
Convex sets are generated by their extreme points \cite{Krein-Millman} and one
can show that
\begin{equation}
\operatorname*{ext}\left\{  \tilde{S}_{N1}\right\}  =\left\{  \tilde{D}%
_{N1}\left\vert \tilde{D}_{N1}=\frac{1}{N}\sum_{1\leq j\leq N}\left\vert
\psi_{j}\right\rangle \left\langle \psi_{j}\right\vert ;\text{ where }\left\{
\left.  \left\vert \psi_{j}\right\rangle \right\vert 1\leq j\leq
\infty\right\}  \text{ are conb's of }\mathcal{H}^{1}\right.  \right\}  ,
\end{equation}
thus%
\begin{equation}
\tilde{S}_{N1}=\left\{  \tilde{D}_{1}\left\vert \tilde{D}_{1}=\sum_{1\leq
j\leq\infty}\beta_{j}\tilde{D}_{N1j};\sum_{1\leq j\leq\infty}\beta_{j}%
=1,0\leq\beta_{j}\leq1,1\leq j\leq\infty\right.  \right\}  ,
\end{equation}
where $\tilde{D}_{N1j}\in\operatorname*{ext}\left\{  \tilde{S}_{N1}\right\}
,1\leq j\leq\infty$ (note that $\left\vert \psi_{j}\right\rangle \left\langle
\psi_{j}\right\vert \notin\tilde{S}_{N1}$ if $N\neq1$ hence the extreme points
are mixed states and not projectors$).$ As $\tilde{S}_{N1}\subset S_{1}$ one
has the spectral decomposition
\begin{equation}
\tilde{S}_{N1}=\left\{  \tilde{D}_{1}\left\vert \tilde{D}_{1}=\sum_{1\leq
j\leq\infty}\alpha_{j}\left\vert \psi_{j}\right\rangle \left\langle \psi
_{j}\right\vert ;\sum_{1\leq j\leq\infty}\alpha_{j}=1,0\leq\alpha_{j}%
\leq1,1\leq j\leq\infty\right.  \right\}  .
\end{equation}


In the case $P=2$ one has has the spectral decomposition
\begin{align}
&  \tilde{S}_{N2}=\left\{  \left.  \tilde{D}_{N2}\right\vert \tilde{D}%
_{N2}=L_{N}^{2}\left(  D^{N}\right)  ,D^{N}\in S_{N}\right\} \nonumber\\
&  \subseteq\left\{  \tilde{D}_{2N}\left\vert \tilde{D}_{2N}=\sum_{1\leq
j\leq\infty}\alpha_{j}\left\vert \psi_{2j}\right\rangle \left\langle \psi
_{2j}\right\vert ;\sum_{1\leq j\leq\infty}\alpha_{j}=1,0\leq\alpha_{j}%
\leq1,\right.  \right. \nonumber\\
&  \left.  1\leq j\leq\infty,\left\{  \left.  \left\vert \psi_{2j}%
\right\rangle \right\vert 1\leq j\leq\infty\right\}  \text{ are conb's of
}\mathcal{H}^{2}\right\}
\end{align}
and the convex decomposition%
\begin{equation}
\tilde{S}_{N2}=\left\{  \tilde{D}\left\vert \tilde{D}=\sum_{1\leq j\leq\infty
}\beta_{j}\tilde{D}_{j};\sum_{1\leq j\leq\infty}\beta_{j}=1,0\leq\beta_{j}%
\leq1,1\leq j\leq\infty\right.  \right\}
\end{equation}
and
\begin{equation}
\tilde{S}_{N2}\subset S_{2}.
\end{equation}
If one knew the extreme points of $\tilde{S}_{N2}$ the problem would be solved.

The preceding definitions produce the normalization
\begin{subequations}
\label{RedDenMat}%
\begin{align}
&  \operatorname{Tr}\left\{  D_{N1}\right\}  =\sum_{1\leq j_{1}\leq\infty
}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{1}}D^{N}\right\}  \text{
}\left\langle \left.  \varphi_{j_{1}}\right\vert \varphi_{j_{1}}\right\rangle
_{1}=\operatorname{Tr}\left\{  \mathcal{N}D^{N}\right\}  =N\nonumber\\
&  \operatorname{Tr}\left\{  D_{N2}\right\}  =\sum_{1\leq j_{1}<j_{2}%
\leq\infty}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{j_{2}}a_{j_{1}}D^{N}\right\}  \left\langle \left.  \varphi_{j_{1}}%
\varphi_{j_{2}}\right\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
_{2}=\operatorname{Tr}\left\{  \mathcal{N}_{2}D^{N}\right\}  =\binom{N}%
{2}\nonumber\\
&  \qquad\qquad\qquad\quad\qquad\qquad\qquad\quad\vdots\nonumber\\
&  \operatorname{Tr}\left\{  D_{NP}\right\}  =\sum_{1\leq j_{1}<\cdots
<j_{P}\leq\infty}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{P}%
}^{\dagger}a_{j_{P}}\cdots a_{j_{1}}D^{N}\right\}  \left\langle \left.
\varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\vert \varphi_{j_{1}}\cdots
\varphi_{j_{P}}\right\rangle _{P}\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\quad\left.  =\right.  \operatorname{Tr}\left\{  \mathcal{N}_{P}%
D^{N}\right\}  =\binom{N}{P}\nonumber\\
&  \qquad\qquad\qquad\quad\qquad\qquad\qquad\quad\vdots\label{RdDenMat}%
\end{align}
and
\end{subequations}
\begin{equation}
\operatorname{Tr}\left\{  \tilde{D}_{NP}\right\}  =1\,\forall N,P.
\end{equation}


In the coordinate representation
\begin{equation}
D^{p}\left(  \boldsymbol{\kappa}_{p};\boldsymbol{\kappa}_{p}^{\prime}\right)
=\operatorname{Tr}\left\{  \Phi\left(  \boldsymbol{\kappa}_{p}^{\prime
}\right)  ^{\dagger}\Phi\left(  \boldsymbol{\kappa}_{p}\right)  D\right\}
=\int D^{p}\left(  \boldsymbol{\kappa}_{p};\boldsymbol{\kappa}_{p}^{\prime
}\right)  \left\vert \boldsymbol{\kappa}_{p}\right\rangle \left\langle
\boldsymbol{\kappa}_{p}^{\prime}\right\vert d\boldsymbol{\kappa}%
_{p}d\boldsymbol{\kappa}_{p}^{\prime}, \label{DenMatDef}%
\end{equation}
where
\begin{align}
\boldsymbol{\kappa}_{p}  &  \equiv\boldsymbol{x}_{1},\cdots,\boldsymbol{x}%
_{p},\\
\boldsymbol{x}_{j}  &  \equiv\boldsymbol{r}_{j}\boldsymbol{,\xi}_{j};1\leq
j\leq p.\nonumber
\end{align}
The operators $\Phi\left(  \boldsymbol{\kappa}_{p}\right)  ^{\dagger}$ are
defined as the product of the one-electrons operators $\Phi\left(
\boldsymbol{\kappa}_{1}\right)  ^{\dagger}$ i.e.%
\begin{equation}
\Phi\left(  \boldsymbol{\kappa}_{p}\right)  ^{\dagger}=\Phi\left(
\boldsymbol{x}_{1}\right)  ^{\dagger}\cdots\Phi\left(  \boldsymbol{x}%
_{p}\right)  ^{\dagger}.
\end{equation}


The adjoint maps, $\Gamma_{P}^{N},$ wrt to the scalar products (which are
generalizations of the Hilbert-Schmidt inner products ---the spaces
$\mathcal{B}_{sa}\left(  \mathcal{H}^{N}\right)  \supseteq\mathcal{B}%
_{2sa}\left(  \mathcal{H}^{N}\right)  \supseteq\mathcal{B}_{1sa}\left(
\mathcal{H}^{N}\right)  $ could be thought of as a Gelfand Triple.)
\begin{align}
\text{ }\left(  \left.  \bullet\right\vert \bullet\right)  _{N}  &
:\mathcal{B}_{sa}\left(  \mathcal{H}^{N}\right)  \times\mathcal{B}%
_{1sa}\left(  \mathcal{H}^{N}\right)  \rightarrow\mathbb{R}\\
\left(  \text{ }\left.  \bullet\right\vert \bullet\right)  _{p}  &
:\mathcal{B}_{sa}\left(  \mathcal{H}^{p}\right)  \times\mathcal{B}%
_{1sa}\left(  \mathcal{H}^{p}\right)  \rightarrow\mathbb{R}%
\end{align}
are defined as
\begin{equation}
\left(  \left.  \Gamma_{P}^{N}\left(  X\right)  \right\vert Y\right)
_{N}=\left(  \left.  X\right\vert L_{N}^{P}\left(  Y\right)  \right)  _{P}.
\end{equation}
The maps $\left\{  L_{N}^{P},\Gamma_{P}^{N}\right\}  $ can be naturally
extended to $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{sae},\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{sa}$ and
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  .$ $L_{N}^{P}$ is
surjective, while $\Gamma_{P}^{N}$ is injective, thus in the infinite
dimensional case $\Gamma_{P}^{N}\left(  \mathcal{B}_{sa}\left(  \mathcal{H}%
^{P}\right)  \right)  $ is a proper subspace of $\mathcal{B}_{sa}\left(
\mathcal{H}^{N}\right)  $ for $P<N,$ while in the finite dimensional case for
$P<\left[  \frac{N}{2}\right]  .$ Further as
\begin{equation}
\left(  \left.  \Gamma_{P}^{N}\left(  X\right)  \right\vert Y\right)
_{N}=\left(  \left.  X\right\vert L_{N}^{P}\left(  Y\right)  \right)
_{P}=0,\,Y\in\ker\left\{  L_{N}^{P}\right\}
\end{equation}
one has
\begin{equation}
\operatorname*{ran}\left\{  \Gamma_{P}^{N}\right\}  \subset\mathcal{B}\left(
\mathcal{H}^{N}\right)  \bot\ker\left\{  L_{N}^{P}\right\}  \subset
\mathcal{B}_{1}\left(  \mathcal{H}^{N}\right)  .
\end{equation}
Taking the closure in Hilbert-Schmidt norm one obtains
\begin{equation}
\mathcal{B}_{2sa}\left(  \mathcal{H}^{N}\right)  =\overline{\ker\left\{
L_{N}^{P}\right\}  }\oplus\ker\left\{  L_{N}^{P}\right\}  ^{\bot}.
\end{equation}%
\begin{equation}
\ker\left\{  L_{N}^{P}\right\}  ^{\bot}=%
%TCIMACRO{\dbigcup \limits_{P\leq P^{\prime}<N}}%
%BeginExpansion
{\displaystyle\bigcup\limits_{P\leq P^{\prime}<N}}
%EndExpansion
\operatorname*{ran}\left\{  \Gamma_{P^{\prime}}^{N}\right\}
\end{equation}


We can define operators, $T_{NP},$ belonging to $\mathcal{B}_{1sa}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e}$ that act in $\mathcal{H}_{\mathcal{F}%
}$
\begin{equation}
\binom{N}{P}T_{NP}=\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq
k_{1}<\cdots<k_{P}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger
}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}D^{N}\right\}  a_{j_{1}%
}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}%
\end{equation}
and in particular both $\mathcal{H}^{P^{\prime}}$ and $\mathcal{H}^{N}$ by
taking restrictions$.$ One can observe that
\begin{equation}
D_{NP^{\prime}}=L_{N}^{P^{\prime}}\left(  D^{N}\right)  =\left.
T_{NP}\right\vert _{\mathcal{H}^{P^{\prime}}};0\leq P^{\prime}\leq P;0\leq
P\leq N
\end{equation}
and prove that
\begin{equation}
\Gamma_{P}^{N}\left(  D_{NP}\right)  =\left.  T_{NP}\right\vert _{\mathcal{H}%
^{N}}.
\end{equation}


$\lceil$%
\begin{align}
T_{NN}  &  =\sum_{\substack{1\leq j_{1}<\cdots<j_{N}\leq\infty\\1\leq
k_{1}<\cdots<k_{N}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger
}\cdots a_{j_{N}}^{\dagger}a_{k_{N}}\cdots a_{k_{1}}D^{N}\right\}  a_{j_{1}%
}^{\dagger}\cdots a_{j_{N}}^{\dagger}a_{k_{N}}\cdots a_{k_{1}}\nonumber\\
\left.  T_{NN}\right\vert _{\mathcal{H}^{N}}  &  =D^{N}\nonumber\\
D_{NP}  &  =\binom{N}{P}L_{N}^{P}\left(  D^{N}\right)  =\sum_{\substack{1\leq
j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}<\cdots<k_{P}\leq\infty
}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger
}a_{k_{P}}\cdots a_{k_{1}}D^{N}\right\}  \left\vert \varphi_{j_{1}}%
\cdots\varphi_{j_{P}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{P}}\right\vert \nonumber\\
&  =\binom{N}{P}L_{N}^{P}\left(  \left.  T_{NN}\right\vert _{\mathcal{H}^{N}%
}\right)  =L_{N}^{P}\left(  \Gamma_{N}^{N}\left(  D_{NN}\right)  \right)  \neq
L_{N}^{P}\left(  \Gamma_{P}^{N}\left(  D_{NP}\right)  \right)  .\rfloor
\end{align}


\subsection{The Second Quantization Map $\Gamma.\label{SeCQuant}$}

The second quantized map, $\Gamma,$%
\begin{equation}
\Gamma:\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \longrightarrow
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
is a Banach space isomorphism, however \emph{it is not} a $c^{\ast}$-algebra
isomorphism. It is defined by its action on basis elements as
\begin{align}
&  \Gamma\left(  \left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle
\left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}}\right\vert \right)
=\sum_{\substack{0\leq N\leq\infty\\1\leq l_{1}<\cdots<l_{N}\leq\infty
}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\varphi_{l_{1}}\cdots
\varphi_{l_{N}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{Q}%
}\varphi_{l_{1}}\cdots\varphi_{l_{N}}\right\vert \nonumber\\
&  =a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}}.
\end{align}
The restrictions of particle conserving field operators give
\begin{align}
\left.  a_{j_{1}}^{\dagger}\cdots a_{j_{N}}^{\dagger}a_{k_{N}}\cdots a_{k_{1}%
}\right\vert _{\mathcal{H}^{N}}  &  =\left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{1}}\cdots\varphi_{k_{N}%
}\right\vert \nonumber\\
\left.  a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}%
}\right\vert _{\mathcal{H}^{N}}  &  =\sum_{1\leq j_{P+1}<\cdots<j_{N}%
\leq\infty}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\varphi_{j_{P+1}%
}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{1}}\cdots
\varphi_{k_{P}}\varphi_{j_{P+1}}\cdots\varphi_{j_{N}}\right\vert .
\end{align}


The map $\Gamma$ relates the following two decompositions of the even Fock
algebra%
\begin{equation}
\mathcal{F}_{e}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}=%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eN}=%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\Gamma\left(  \mathcal{B}\left(  \mathcal{H}^{N}\right)  \right)  \cong%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N}\right)  ,
\end{equation}
where
\begin{equation}
\mathcal{B}\left(  \mathcal{H}^{N}\right)  \cong\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{eN}=\Gamma\left(  \mathcal{B}\left(
\mathcal{H}^{N}\right)  \right)  ,
\end{equation}
these isomorphisms are vector space ones but not algebraic ones i.e.%
\begin{align}
\Gamma &  :\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq
k_{1}<\cdots<k_{P}\leq\infty}}X_{Pj_{1}\cdots j_{P}k_{1}\cdots k_{P}%
}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\rangle \left\langle
\varphi_{k_{1}}\cdots\varphi_{k_{P}}\right\vert \nonumber\\
&  \longrightarrow\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq
k_{1}<\cdots<k_{P}\leq\infty}}X_{Pj_{1}\cdots j_{P}k_{1}\cdots k_{P}}a_{j_{1}%
}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}%
\end{align}
but
\begin{equation}
\Gamma(XY)\neq\Gamma(X)\Gamma(Y).
\end{equation}


One can easily see this when $r=3$ and
\begin{align}
&  X=\sum_{1\leq j,k\leq3}X_{jk}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert ,\quad Y=\sum_{1\leq j,k\leq3}%
Y_{jk}\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
\nonumber\\
&  I_{\mathcal{H}_{F}}=\left\vert \phi\right\rangle \left\langle
\phi\right\vert +\sum_{1\leq j\leq3}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{j}\right\vert +\sum_{1\leq j<k\leq3}\left\vert
\varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{j}\varphi
_{k}\right\vert +\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\varphi_{3}\right\vert \nonumber\\
&  XY=\sum_{1\leq j,k,l\leq3}X_{jl}Y_{lk}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert \quad\nonumber\\
&  X\wedge I_{\mathcal{H}_{F}}=\sum_{1\leq j,k\leq3}X_{jk}\left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert +\sum_{1\leq
j,k,l\leq3}X_{jk}\left\vert \varphi_{j}\varphi_{l}\right\rangle \left\langle
\varphi_{k}\varphi_{l}\right\vert \nonumber\\
&  \qquad\qquad+\operatorname*{Tr}\left\{  X\right\}  \left\vert \varphi
_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\varphi_{3}\right\vert \nonumber\\
&  Y\wedge I_{\mathcal{H}_{F}}=\sum_{1\leq j,k\leq3}Y_{jk}\left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert +\sum_{1\leq
j,k,l\leq3}Y_{jk}\left\vert \varphi_{j}\varphi_{l}\right\rangle \left\langle
\varphi_{k}\varphi_{l}\right\vert \nonumber\\
&  \qquad\qquad+\operatorname*{Tr}\left\{  Y\right\}  \left\vert \varphi
_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\varphi_{3}\right\vert \nonumber\\
&  XY\wedge I_{\mathcal{H}_{F}}=\sum_{1\leq j,k,l\leq3}X_{jl}Y_{lk}\left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert +\sum_{1\leq
j,k,l,m\leq3}X_{jl}Y_{lk}\left\vert \varphi_{j}\varphi_{m}\right\rangle
\left\langle \varphi_{k}\varphi_{m}\right\vert \nonumber\\
&  \qquad\qquad+\operatorname*{Tr}\left\{  XY\right\}  \left\vert \varphi
_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\varphi_{3}\right\vert \nonumber\\
&  \left(  X\wedge I_{\mathcal{H}_{F}}\right)  \left(  Y\wedge I_{\mathcal{H}%
_{F}}\right) \nonumber\\
&  =\sum_{1\leq j,k,l\leq3}X_{jl}Y_{lk}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert +\sum_{\substack{1\leq j,k,l\leq3\\1\leq
j^{\prime},k^{\prime},l^{\prime}\leq3}}X_{jk}Y_{j^{\prime}k^{\prime}%
}\left\vert \varphi_{j}\varphi_{l}\right\rangle \left\langle \varphi
_{k}\varphi_{l}\left\vert \varphi_{j^{\prime}}\varphi_{l^{\prime}}\right.
\right\rangle \left\langle \varphi_{k^{\prime}}\varphi_{l^{\prime}}\right\vert
\nonumber\\
&  \qquad\qquad+\left(  \operatorname*{Tr}\left\{  XY\right\}  \right)
^{2}\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\right\vert
\end{align}%
\begin{align}
&  =\sum_{1\leq j,k,l\leq3}X_{jl}Y_{lk}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert +\sum_{\substack{1\leq j,k,l\leq3\\1\leq
j^{\prime},k^{\prime},l^{\prime}\leq3}}X_{jk}Y_{j^{\prime}k^{\prime}%
}\left\vert \varphi_{j}\varphi_{l}\right\rangle \left\{  \delta_{kj^{\prime}%
}\delta_{ll^{\prime}}-\delta_{kl^{\prime}}\delta_{lj^{\prime}}\right\}
\left\langle \varphi_{k^{\prime}}\varphi_{l^{\prime}}\right\vert \\
&  \qquad\qquad+\left(  \operatorname*{Tr}\left\{  XY\right\}  \right)
^{2}\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\right\vert \\
&  =\sum_{1\leq j,k,l\leq3}X_{jl}Y_{lk}\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{k}\right\vert +\\
&  \sum_{\substack{1\leq j,k,l\leq3\\1\leq j^{\prime},k^{\prime},l^{\prime
}\leq3}}\left\{  X_{jk}Y_{kk^{\prime}}\left\vert \varphi_{j}\varphi
_{l}\right\rangle \left\langle \varphi_{k^{\prime}}\varphi_{l}\right\vert
-X_{jk}Y_{j^{\prime}k^{\prime}}\left\vert \varphi_{j}\varphi_{j^{\prime}%
}\right\rangle \left\langle \varphi_{k^{\prime}}\varphi_{k}\right\vert
\right\} \\
&  \qquad\qquad+\left(  \operatorname*{Tr}\left\{  XY\right\}  \right)
^{2}\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\right\vert .
\end{align}


Consider the special case $X_{P}=P_{\mathcal{H}^{P}}$ then
\begin{align}
\Gamma\left(  P_{\mathcal{H}^{P}}\right)   &  =\Gamma\left(  \sum_{1\leq
j_{1}<\cdots<j_{P}\leq\infty}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}%
}\right\rangle \left\langle \varphi_{j_{1}}\cdots\varphi_{j_{P}}\right\vert
\right) \nonumber\\
&  =\sum_{1\leq j_{1}<\cdots<j_{P}\leq\infty}a_{j_{1}}^{\dagger}\cdots
a_{j_{P}}^{\dagger}a_{j_{P}}\cdots a_{j_{1}}=\mathcal{N}_{P},
\end{align}%
\begin{equation}
\frac{\left\langle \Psi_{N}\left.  \mathcal{N}_{P}\right\vert \Psi
_{N}\right\rangle }{\left\langle \left.  \Psi_{N}\right\vert \Psi
_{N}\right\rangle }=\binom{N}{P},
\end{equation}%
\begin{equation}
\Gamma_{P}^{N}\left(  P_{\mathcal{H}^{P}}\right)  =\binom{N}{P}^{-1}\left.
\Gamma\left(  P_{\mathcal{H}^{P}}\right)  \right\vert _{\mathcal{H}^{N}}%
\end{equation}
and
\begin{equation}
P_{\mathcal{H}^{N}}=\Gamma_{P}^{N}\left(  P_{\mathcal{H}^{P}}\right)  .
\end{equation}


As one can expand the second quantized operators in terms of ket-bra's one
obtains
\begin{equation}
\Gamma\left(  \left\vert \varphi_{j}\right\rangle \left\langle \varphi
_{k}\right\vert \right)  =a_{j}^{\dagger}a_{k}=\left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert +\sum_{1\leq N\leq
\infty}\sum_{1\leq j_{2}<\cdots<j_{N}\leq\infty}\left\vert \varphi_{j}%
\varphi_{j_{2}}\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi
_{k}\varphi_{j_{2}}\cdots\varphi_{j_{N}}\right\vert .
\end{equation}


Each element of $%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N}\right)  $ (which is a direct sum of
algebras) can be represented as $\left(
\begin{array}
[c]{c}%
X_{0}\\
\vdots\\
X_{\infty}%
\end{array}
\right)  _{FQ}$ (with only finitely many non zero elements), $X_{N}%
\in\mathcal{B}\left(  \mathcal{H}^{N}\right)  $. The direct sum $%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eN}$ is only a vector
space direct sum and not a direct sum of algebras but we can still represent
each element as $\left(
\begin{array}
[c]{c}%
Y_{0}\\
\vdots\\
Y_{\infty}%
\end{array}
\right)  _{SQ},$ $Y_{N}\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{eN}$. Using the direct sum representations we obtain
\begin{equation}
\Gamma\left(  \left(
\begin{array}
[c]{c}%
X_{0}\\
\vdots\\
X_{\infty}%
\end{array}
\right)  _{FQ}\right)  =\left(
\begin{array}
[c]{c}%
\Gamma\left(  X_{0}\right) \\
\vdots\\
\Gamma\left(  X_{\infty}\right)
\end{array}
\right)  _{SQ}=\left(
\begin{array}
[c]{c}%
Y_{0}\\
\vdots\\
Y_{\infty}%
\end{array}
\right)  _{SQ}%
\end{equation}
and%
\begin{equation}
\Gamma(X_{P})=\sum_{P\leq N\leq\infty}\left.  \Gamma\left(  X_{P}\right)
\right\vert _{\mathcal{H}^{N}}=\sum_{P\leq N\leq\infty}\binom{N}{P}\Gamma
_{P}^{N}\left(  X_{P}\right)  .
\end{equation}
We can reexpress $\Gamma(X_{P})$ wrt the decomposition $%
%TCIMACRO{\dbigoplus \limits_{0\leq N\leq\infty}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq N\leq\infty}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}^{N}\right)  $ as
\begin{equation}
\left(
\begin{array}
[c]{c}%
0\\
\vdots\\
X_{P}\\
\vdots\\
\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right) \\
\vdots
\end{array}
\right)  _{FQ}%
\end{equation}
leading to $\Gamma(\sum\limits_{0\leq P\leq N}X_{P})=\sum\limits_{0\leq P\leq
N}\Gamma(X_{P})$ being given by
\begin{equation}
\Gamma\left(  \left(
\begin{array}
[c]{c}%
X_{0}\\
\vdots\\
X_{N}\\
\vdots\\
X_{\infty}%
\end{array}
\right)  _{FQ}\right)  =\left(
\begin{array}
[c]{c}%
\vdots\\
\sum\limits_{0\leq P\leq N}\binom{N}{P}\Gamma_{P}^{N}\left(  X_{P}\right) \\
\vdots
\end{array}
\right)  _{FQ}.
\end{equation}


\begin{theorem}
$X_{P}\geq0$ $\Rightarrow\left.  \Gamma\left(  X_{P}\right)  \right\vert
_{\mathcal{H}^{N}}\geq0,$ $N>P$

\begin{proof}%
\begin{align}
\left\langle \Psi_{N}\left\vert \left.  \Gamma\left(  X_{P}\right)
\right\vert _{\mathcal{H}^{N}}\right.  \Psi_{N}\right\rangle  &  =\left\langle
\Psi_{N}\left\vert \sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq
k_{1}<\cdots<k_{P}\leq\infty}}X_{j_{1}\cdots j_{P}k_{1}\cdots k_{P}}a_{j_{1}%
}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}\right.
\Psi_{N}\right\rangle \nonumber\\
=  &  \sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}X_{Pj_{1}\cdots j_{P}k_{1}\cdots k_{P}}\left\langle
\Psi_{N}a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}%
}\Psi_{N}\right\rangle \nonumber\\
=\binom{N}{P}  &  \sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq
k_{1}<\cdots<k_{P}\leq\infty}}X_{Pj_{1}\cdots j_{P}k_{1}\cdots k_{P}}L_{N}%
^{P}\left(  \left\vert \Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert
\right)  _{k_{1}\cdots k_{P}j_{1}\cdots j_{P}}\nonumber\\
&  \Rightarrow\operatorname{Tr}\left\{  X_{P}L_{N}^{P}\left(  \left\vert
\Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert \right)  \right\}
\geq0
\end{align}
as $X_{P}\geq0.$
\end{proof}
\end{theorem}

\section{The Kummer Cone}

Cones are defined by
\begin{equation}
C=\left\{  \left.  X\right\vert \alpha X\in X,\alpha\in\mathbb{R}^{+}\right\}
\end{equation}
they do not have be convex sets nor linear spaces, if they are then they are
convex cones or linear cones.

Let $X_{P}\in\mathcal{B}_{sa}\left(  \mathcal{H}^{P}\right)  $ such $r\left(
X\right)  \cap\left(  -\infty,0\right)  \neq\phi$ then
\begin{align}
\inf_{\Phi_{P}\in\mathcal{H}^{P}}\left\{  \frac{\left\langle \left.  \Phi
_{P}\right\vert X_{P}\Phi_{P}\right\rangle }{\left\langle \left.  \Phi
_{P}\right\vert \Phi_{P}\right\rangle }\right\}   &  =\inf_{D^{P}\in
S_{P}\subset\mathcal{B}_{1sa+}\left(  \mathcal{H}^{P}\right)  }\left\{
\operatorname*{Tr}\left\{  X_{P}D^{P}\right\}  \right\} \nonumber\\
&  =\inf_{D^{P}\in S_{P}\subset\mathcal{B}_{1sa+}\left(  \mathcal{H}%
^{P}\right)  }\left\{  \left\langle \left.  X_{P}\right\vert D^{P}%
\right\rangle _{P}\right\}  =\alpha\left(  X_{P}\right)  <0
\end{align}
($\alpha\left(  X_{P}\right)  $ is the lowest eigenvalue or generalized
eigenvalue of $X_{P}$) then by shifting one obtains the positive operator
\begin{equation}
X_{P}-\alpha\left(  X_{P}\right)  P_{P}\geq0\Leftrightarrow X_{P}\geq
\alpha\left(  X_{P}\right)  P_{P},
\end{equation}
which expands to a positive $N$-electron operator%
\begin{equation}
\Gamma_{P}^{N}\left(  X_{P}-\alpha\left(  X_{P}\right)  P_{P}\right)
=\Gamma_{P}^{N}\left(  X_{P}\right)  -\alpha\left(  X_{P}\right)  \Gamma
_{P}^{N}\left(  P_{P}\right)  =\Gamma_{P}^{N}\left(  X_{P}\right)
-\alpha\left(  X_{P}\right)  P_{N}\geq0.
\end{equation}
Consider the expansion of the unshifted operator (which by hypothesis is not
positive) then
\begin{equation}
\inf_{\Phi_{N}\in\mathcal{H}^{N}}\left\{  \frac{\left\langle \left.  \Phi
_{N}\right\vert \Gamma_{P}^{N}\left(  X_{P}\right)  \Phi_{N}\right\rangle
}{\left\langle \left.  \Phi_{N}\right\vert \Phi_{N}\right\rangle }\right\}
=\alpha\left(  \Gamma_{P}^{N}\left(  X_{P}\right)  \right)  \geq\alpha\left(
X_{P}\right)  ,
\end{equation}
as%
\begin{align}
\alpha\left(  \Gamma_{P}^{N}\left(  X_{P}\right)  \right)   &  =\inf_{\Phi
_{N}\in\mathcal{H}^{N}}\left\{  \frac{\left\langle \left.  \Phi_{N}\right\vert
\Gamma_{P}^{N}\left(  X_{P}\right)  \Phi_{N}\right\rangle }{\left\langle
\left.  \Phi_{N}\right\vert \Phi_{N}\right\rangle }\right\}  =\inf_{D^{N}\in
S_{N}}\left\{  \left\langle \left.  \Gamma_{P}^{N}\left(  X_{P}\right)
\right\vert D^{N}\right\rangle _{N}\right\} \nonumber\\
&  =\inf_{D^{N}\in S_{N}}\left\{  \left\langle \left.  X_{P}\right\vert
L_{N}^{P}\left(  D^{N}\right)  \right\rangle _{P}\right\}  =\inf_{D_{NP}%
\in\tilde{S}_{NP}}\left\{  \left\langle \left.  X_{P}\right\vert
D_{NP}\right\rangle _{P}\right\}  \geq\alpha\left(  X_{P}\right)
\end{align}
due to $\tilde{S}_{NP}=L_{N}^{P}\left(  S_{N}\right)  \subset S_{P}$. Thus the
expanded operator is less negative and by shifting
\begin{equation}
\Gamma_{P}^{N}\left(  X_{P}\right)  -\alpha\left(  \Gamma_{P}^{N}\left(
X_{P}\right)  \right)  P_{N}\geq0.
\end{equation}
Hence
\begin{equation}
\alpha\left(  X_{P}\right)  -\alpha\left(  \Gamma_{P}^{N}\left(  X_{P}\right)
\right)  =\inf_{\Phi_{P}\in\mathcal{H}^{P}}\left\{  \frac{\left\langle \left.
\Phi_{P}\right\vert \left\{  X_{P}-\alpha\left(  \Gamma_{P}^{N}\left(
X_{P}\right)  P_{P}\right)  \right\}  \Phi_{P}\right\rangle }{\left\langle
\left.  \Phi_{P}\right\vert \Phi_{P}\right\rangle }\right\}  \leq0
\end{equation}
i.e.%
\begin{equation}
X_{P}-\alpha\left(  \Gamma_{P}^{N}\left(  X_{P}\right)  \right)  P_{P}\ngeq0.
\end{equation}


\begin{theorem}
$\exists Y_{P}=\left.  \Gamma\left(  Y_{P}\right)  \right\vert _{\mathcal{H}%
^{P}}\ngeq0$ $\ni\Gamma_{P}^{N}\left(  Y_{P}\right)  =\binom{N}{P}^{-1}\left.
\Gamma\left(  Y_{P}\right)  \right\vert _{\mathcal{H}^{N}}\geq0,$ $N>P$

\begin{proof}
For $P=1$ let
\begin{equation}
X_{1}=-\left\vert \psi\right\rangle \left\langle \psi\right\vert
\end{equation}
then
\begin{equation}
\inf_{\varphi\in\mathcal{H}^{1}}\left\{  \frac{\left\langle \left.
\varphi\right\vert X_{1}\varphi\right\rangle }{\left\langle \left.
\varphi\right\vert \varphi\right\rangle }\right\}  =\alpha\left(
X_{1}\right)  =-1<0
\end{equation}
and
\begin{align}
&  \inf_{\Phi_{N}\in\mathcal{H}^{N}}\left\{  \frac{\left\langle \left.
\Phi_{N}\right\vert \Gamma_{1}^{N}\left(  X_{1}\right)  \Phi_{N}\right\rangle
}{\left\langle \left.  \Phi_{N}\right\vert \Phi_{N}\right\rangle }\right\}
=\inf_{\Phi_{N}\in\mathcal{H}^{N}}\operatorname{Tr}\left\{  \Gamma_{1}%
^{N}\left(  X_{1}\right)  \frac{\left\vert \Phi_{N}\right\rangle \left\langle
\Phi_{N}\right\vert }{\left\langle \left.  \Phi_{N}\right\vert \Phi
_{N}\right\rangle }\right\} \nonumber\\
&  =\inf_{\Phi_{N}\in\mathcal{H}^{N}}\operatorname{Tr}\left\{  X_{1}L_{N}%
^{1}\left(  \frac{\left\vert \Phi_{N}\right\rangle \left\langle \Phi
_{N}\right\vert }{\left\langle \left.  \Phi_{N}\right\vert \Phi_{N}%
\right\rangle }\right)  \right\}  =\inf_{\Phi_{N}\in\mathcal{H}^{N}%
}\operatorname{Tr}\left\{  \left(  -\left\vert \psi\right\rangle \left\langle
\psi\right\vert \right)  L_{N}^{1}\left(  \frac{\left\vert \Phi_{N}%
\right\rangle \left\langle \Phi_{N}\right\vert }{\left\langle \left.  \Phi
_{N}\right\vert \Phi_{N}\right\rangle }\right)  \right\} \nonumber\\
&  =-\frac{1}{N}=\alpha\left(  \Gamma_{1}^{N}\left(  X_{1}\right)  \right)
>\alpha\left(  X_{1}\right)  .
\end{align}
Thus
\begin{align}
&  \inf_{\varphi\in\mathcal{H}^{1}}\left\{  \frac{\left\langle \left.
\varphi\right\vert \left\{  X_{1}-\alpha\left(  \Gamma_{1}^{N}\left(
X_{1}\right)  \right)  \right\}  \varphi\right\rangle }{\left\langle \left.
\varphi\right\vert \varphi\right\rangle }\right\}  =\alpha\left(
X_{1}\right)  -\alpha\left(  \Gamma_{1}^{N}\left(  X_{1}\right)  \right)
\nonumber\\
&  =-1+\frac{1}{N}=\frac{1-N}{N}<0
\end{align}
and trivially
\begin{align}
&  \inf_{\Phi\in\mathcal{H}^{N}}\left\{  \frac{\left\langle \left.
\Phi\right\vert \Gamma_{1}^{N}\left(  X_{1}-\alpha\left(  \Gamma_{1}%
^{N}\left(  X_{1}\right)  P_{1}\right)  \right)  \Phi\right\rangle
}{\left\langle \left.  \Phi\right\vert \Phi\right\rangle }\right\}
=\nonumber\\
&  \alpha\left(  \Gamma_{1}^{N}\left(  X_{1}\right)  \right)  -\alpha\left(
\Gamma_{1}^{N}\left(  X_{1}\right)  \right)  =0\nonumber\\
&  \Leftrightarrow\Gamma_{1}^{N}\left(  X_{1}-\alpha\left(  \Gamma_{1}%
^{N}\left(  X_{1}\right)  \right)  \right)  \geq0.
\end{align}

\end{proof}
\end{theorem}

The above is based on the fact that for states $D^{N}\in S_{N}$ one has
\begin{align}
&  \sup_{\varphi_{1}\in\mathcal{H}^{1}}\left\{  \frac{\left\langle \left.
\varphi_{1}\right\vert L_{N}^{1}\left(  D^{N}\right)  \varphi_{1}\right\rangle
}{\left\langle \left.  \varphi_{1}\right\vert \varphi_{1}\right\rangle
}\right\}  =\sup_{\varphi_{1}\in\mathcal{H}^{1}}\left\{  \operatorname{Tr}%
\left\{  \Gamma_{1}^{N}\left(  \frac{\left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert }{\left\langle \left.  \varphi
_{1}\right\vert \varphi_{1}\right\rangle }\right)  D^{N}\right\}  \right\} \\
&  \left.  =\right.  \sup_{\varphi_{1}\in\mathcal{H}^{1}}\left\{
\operatorname{Tr}\left\{  \binom{N}{1}^{-1}\Gamma\left(  \frac{\left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert }{\left\langle
\left.  \varphi_{1}\right\vert \varphi_{1}\right\rangle }\right)
D^{N}\right\}  \right\} \\
&  \left.  =\right.  \sup_{\substack{\varphi_{1}\in\mathcal{H}^{1}\\\left\Vert
\varphi_{1}\right\Vert =1}}\left\{  \operatorname{Tr}\left\{  \frac{1}{N}%
\Phi\left(  \varphi_{1}\right)  ^{\dagger}\Phi\left(  \varphi_{1}\right)
D^{N}\right\}  \right\}  =\beta\left(  L_{N}^{1}\left(  D^{N}\right)  \right)
=\frac{1}{N},
\end{align}
which is based in turn on the fact that $\Phi\left(  \varphi_{1}\right)  $ is
a partial isometry ($\Phi\left(  \varphi_{1}\right)  ^{\dagger}\Phi\left(
\varphi_{1}\right)  $ and $\Phi\left(  \varphi_{1}\right)  \Phi\left(
\varphi_{1}\right)  ^{\dagger}$ are idempotent projections) and
\begin{equation}
\left\Vert \Phi\left(  \varphi_{1}\right)  \right\Vert =\left\Vert \Phi\left(
\varphi_{1}\right)  ^{\dagger}\right\Vert =1.
\end{equation}
The corresponding 2-particle operators
\begin{equation}
\Phi\left(  \varphi_{a}\right)  ^{\dagger}\Phi\left(  \varphi_{b}\right)
^{\dagger}\Phi\left(  \varphi_{b}\right)  \Phi\left(  \varphi_{a}\right)
=\Phi\left(  \varphi_{a}\right)  ^{\dagger}\Phi\left(  \varphi_{a}\right)
\Phi\left(  \varphi_{b}\right)  ^{\dagger}\Phi\left(  \varphi_{b}\right)
\end{equation}
are also idempotent (and thus projectors), and one can show that
\begin{equation}
\left\Vert \Phi\left(  \varphi_{b}\right)  \Phi\left(  \varphi_{a}\right)
\right\Vert =\left\Vert \Phi\left(  \varphi_{a}\right)  ^{\dagger}\Phi\left(
\varphi_{b}\right)  ^{\dagger}\right\Vert =1,
\end{equation}
but they are not partial isometries.

The operator norm restricted to decomposable vectors is given by
\begin{align}
&  \sup_{\varphi_{a},\varphi_{b}\in\mathcal{H}^{1}}\left\{  \frac{\left\langle
\left.  \varphi_{b}\varphi_{a}\right\vert L_{N}^{2}\left(  D^{N}\right)
\varphi_{b}\varphi_{a}\right\rangle }{\left\langle \left.  \varphi_{b}%
\varphi_{a}\right\vert \varphi_{b}\varphi_{a}\right\rangle }\right\}
\nonumber\\
&  \left.  =\right.  \sup_{\varphi_{a},\varphi_{b}\in\mathcal{H}^{1}}\left\{
\operatorname{Tr}\left\{  \binom{N}{2}^{-1}\Gamma\left(  \frac{\left\vert
\varphi_{b}\varphi_{a}\right\rangle \left\langle \varphi_{b}\varphi
_{a}\right\vert }{\left\langle \left.  \varphi_{b}\varphi_{a}\right\vert
\varphi_{b}\varphi_{a}\right\rangle }\right)  D^{N}\right\}  \right\}
\nonumber\\
&  \left.  =\right.  \sup_{\substack{\varphi_{a},\varphi_{b}\in\mathcal{H}%
^{1}\\\left\Vert \varphi_{a}\right\Vert =\left\Vert \varphi_{b}\right\Vert
=1}}\left\{  \operatorname{Tr}\left\{  \frac{2}{N\left(  N+1\right)  }%
\Phi\left(  \varphi_{a}\right)  ^{\dagger}\Phi\left(  \varphi_{b}\right)
^{\dagger}\Phi\left(  \varphi_{b}\right)  \Phi\left(  \varphi_{a}\right)
D^{N}\right\}  \right\}  =\frac{2}{N\left(  N+1\right)  },
\end{align}
however the set of decomposable unit vectors $\left\{  \left\vert \varphi
_{b}\varphi_{a}\right\rangle \right\}  $ in $\mathcal{H}^{2}$ is a subset of
all unit vectors so the actual norm is greater. The set of all unit vectors is
given by
\begin{align}
&  \left\vert g\right\rangle =\sum_{1\leq j<k\leq\infty}g_{jk}\left\vert
\varphi_{j}\varphi_{k}\right\rangle \\
&  \sum_{1\leq j<k\leq\infty}\left\vert g_{jk}\right\vert ^{2}=1.
\end{align}
Consider
\begin{align}
&  \sum_{_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}%
}}\overline{g}_{j_{1}j_{2}}g_{k_{1}k_{2}}\left\langle \left.  \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert L_{N}^{2}\left(  D^{N}\right)  \varphi_{k_{1}%
}\varphi_{k_{2}}\right\rangle =\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq
k_{1}<k_{2}\leq r}}\overline{g}_{j_{1}j_{2}}g_{k_{1}k_{2}}\operatorname{Tr}%
\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}
\\
&  =\sum_{_{\substack{1\leq j_{1}\leq s\\1\leq k_{1}\leq s}}}c_{j_{1}j_{1}%
+s}c_{k_{1}k_{1}+s}\operatorname{Tr}\left\{  b_{j_{1}}^{\dagger}b_{j_{1}%
+s}^{\dagger}b_{k_{1}+s}b_{k_{1}}D^{N}\right\}
\end{align}
and an extreme geminal
\begin{align}
&  =\frac{1}{s^{2}}\sum_{_{\substack{1\leq j_{1}\leq s\\1\leq k_{1}\leq s}%
}}\operatorname{Tr}\left\{  b_{j_{1}}^{\dagger}b_{j_{1}+s}^{\dagger}%
b_{k_{1}+s}b_{k_{1}}D^{N}\right\} \\
&  =\frac{1}{s^{2}}\sum_{_{\substack{1\leq j_{1}\leq s\\1\leq k_{1}\leq s}%
}}\operatorname{Tr}\left\{  b_{j_{1}}^{\dagger}b_{j_{1}+s}^{\dagger}%
b_{j_{1}+s}b_{j_{1}}D^{N}\right\}  +\frac{2}{s^{2}}\sum_{_{1\leq j_{1}%
<k_{1}\leq s}}\operatorname{Re}\left\{  \operatorname{Tr}\left\{  b_{j_{1}%
}^{\dagger}b_{j_{1}+s}^{\dagger}b_{k_{1}+s}b_{k_{1}}D^{N}\right\}  \right\} \\
&  =\frac{1}{s^{2}}\binom{N}{2}+\frac{2}{s^{2}}\sum_{_{1\leq j_{1}<k_{1}\leq
s}}\operatorname{Re}\left\{  \operatorname{Tr}\left\{  b_{j_{1}}^{\dagger
}b_{j_{1}+s}^{\dagger}b_{k_{1}+s}b_{k_{1}}D^{N}\right\}  \right\}  .
\end{align}
$\lceil$If the extreme geminal was an eigenvector of $L_{N}^{2}\left(
D^{N}\right)  $ then
\begin{align}
\operatorname{Tr}\left\{  b_{j_{1}}^{\dagger}b_{j_{1}+s}^{\dagger}b_{k_{1}%
+s}b_{k_{1}}D^{N}\right\}   &  =0;\text{ }j_{1}\neq k_{1}\nonumber\\
&  \Rightarrow\sum_{_{1\leq j_{1}<k_{1}\leq s}}\operatorname{Re}\left\{
\operatorname{Tr}\left\{  b_{j_{1}}^{\dagger}b_{j_{1}+s}^{\dagger}b_{k_{1}%
+s}b_{k_{1}}D^{N}\right\}  \right\}  =0
\end{align}
and
\begin{equation}
\left\langle \left.  g\right\vert L_{N}^{2}\left(  D^{N}\right)
g\right\rangle =\frac{1}{s^{2}}\sum_{_{\substack{1\leq j_{1}<j_{2}\leq
r\\1\leq k_{1}<k_{2}\leq r}}}\left\langle \left.  \varphi_{j_{1}}%
\varphi_{j_{2}}\right\vert L_{N}^{2}\left(  D^{N}\right)  \varphi_{k_{1}%
}\varphi_{k_{2}}\right\rangle =\frac{1}{s^{2}}\binom{N}{2}.\rfloor
\end{equation}


The Kummer cone $\mathcal{K}_{NP}$ is defined as
\begin{equation}
\mathcal{K}_{NP}=\left\{  \left.  X_{P}\right\vert X_{P}\in\mathcal{B}%
_{sa}\left(  \mathcal{H}^{P}\right)  ,\Gamma_{P}^{N}\left(  X_{P}\right)
\geq0\right\}
\end{equation}
it is \emph{crucial to observe} that
\begin{equation}
\mathcal{K}_{NP}\supset\mathcal{B}_{sa+}\left(  \mathcal{H}^{P}\right)  \text{
and }\Gamma_{P}^{N}\left(  \mathcal{K}_{NP}\right)  \subset\mathcal{B}%
_{sa+}\left(  \mathcal{H}^{N}\right)
\end{equation}


\begin{theorem}
(Garrod \& Percus)
\end{theorem}

$D_{P}\in\tilde{S}_{NP}$ $\Longleftrightarrow\left\{  \left(  \left.
X_{P}\right\vert D_{P}\right)  _{P}\geq0\,\,\forall\,\Gamma_{P}^{N}\left(
X_{P}\right)  \geq0\right\}  \equiv\left(  \left.  X_{P}\right\vert
D_{P}\right)  _{P}\geq0\,\forall X_{P}\in\mathcal{K}_{NP}.$

\begin{corollary}
If $D_{P}\notin\tilde{S}_{NP},$ but $D_{P}\in S_{P}$ then $\exists\,X_{P}%
\in\mathcal{K}_{NP}\supset\mathcal{B}_{sa+}\left(  \mathcal{H}^{P}\right)
\ni$
\begin{equation}
\left(  \left.  X_{P}\right\vert D_{P}\right)  _{P}=\left(  \left.
X_{P}\right\vert L_{N}^{P}\left(  D_{N}\right)  \right)  _{P}=\left(  \left.
\Gamma_{P}^{N}\left(  X_{P}\right)  \right\vert D_{N}\right)  _{N}<0.
\end{equation}

\end{corollary}

This shows that the restriction of a non positive linear functional on
$\mathcal{B}_{sa}\left(  \mathcal{H}^{N}\right)  $ can be positive on
$\mathcal{B}_{sa}\left(  \mathcal{H}^{P}\right)  $ and that elements of
$S_{P}-\tilde{S}_{NP}$ can be restrictions of non positive linear functionals
on $\mathcal{B}_{sa}\left(  \mathcal{H}^{N}\right)  .$

A more general statement of the preceding theorems is
\begin{equation}
\Gamma\left(  X_{p}\right)  \geq0\Rightarrow X_{p}\geq0
\end{equation}
but not vice versa.

\section{States}

A state is a bounded positive linear function, $f$, acting on $\mathcal{B}%
\left(  \mathcal{H}_{\mathcal{F}}\right)  $ such that $f\left(  I\right)  =1,$
it is called a normal state if it can be identified with an element of the
predual, $\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  ,$ of
$\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $ and abnormal otherwise
i.e. if it belongs to $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
^{\ast}\ominus\mathcal{B}_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  .$ If
we focus on expectation values of self adjoint observables one can restrict
attention to
\begin{subequations}
\label{States}%
\begin{align}
f  &  :\mathcal{B}_{sa}\left(  \mathcal{H}_{F}\right)  \rightarrow
\mathbb{R}\nonumber\\
f\left(  X\right)   &  \geq0\forall X\geq0\nonumber\\
f\left(  I\right)   &  =1\nonumber\\
f\left(  X\right)   &  =\operatorname{Tr}\left\{  XD\right\}  ;\text{ }D\in
S_{F}\subset\mathcal{B}_{1+}\left(  \mathcal{H}_{F}\right)  \text{ if }f\text{
is normal,}%
\end{align}
where
\end{subequations}
\begin{equation}
S_{F}=\left\{  \left.  D\right\vert D\in\mathcal{B}_{1+}\left(  \mathcal{H}%
_{F}\right)  ;\operatorname{Tr}\left\{  D\right\}  =1\right\}  .
\end{equation}


Note
\begin{equation}
\left\Vert X\right\Vert _{1}=\operatorname{Tr}\left\{  \left(  X^{\dagger
}X\right)  ^{\frac{1}{2}}\right\}  =\operatorname{Tr}\left\{  \left\vert
X\right\vert \right\}  ,
\end{equation}
thus
\begin{equation}
\left\Vert D\right\Vert _{1}=\operatorname{Tr}\left\{  \left(  D^{2}\right)
^{\frac{1}{2}}\right\}  =\operatorname{Tr}\left\{  \left\vert D\right\vert
\right\}  =\operatorname{Tr}\left\{  D\right\}  =1,
\end{equation}
hence $D$ belongs to the positive hyperant of the $\left\Vert {}\right\Vert
_{1}$ unit sphere.

\subsection{Values of States}

A set of states, $S,$ is called \emph{full} for a subspace $W$ if
\begin{equation}
f\left(  X-Y\right)  =0\,\forall f\in S\Leftrightarrow X=Y;X,Y\in W,
\end{equation}
which is equivalent to
\begin{equation}
f\left(  X\right)  =0\,\forall f\in S\Leftrightarrow X=0.
\end{equation}
Consider a set of linearly independent operators $\left\{  X_{j}\right\}  $ in
$W$ then if $S$ is full for $W$ one has
\begin{equation}
f\left(  \sum\alpha_{j}X_{j}\right)  =\sum\alpha_{j}f\left(  X_{j}\right)
=0\forall f\in S\Leftrightarrow\alpha_{j}=0.
\end{equation}
If the set of states is not full then it is possible
\begin{equation}
f\left(  X\right)  =f\left(  Y\right)  \quad\forall f\in S,\text{ when }X\neq
Y,\,X,Y\in W
\end{equation}
i.e.
\begin{equation}
f\left(  \sum\alpha_{j}X_{j}\right)  =\sum\alpha_{j}f\left(  X_{j}\right)
=0\,\forall f\in S;\alpha_{j}\neq0\text{ }%
\end{equation}
and $\left\{  X_{j}\right\}  $ still be linearly independent.

\subsection{ Real Valued States}

One can consider $\mathcal{B}_{2sa}\left(  \mathcal{H}_{F}\right)  $ as a real
Hilbert space with inner product $\left(  \left.  \bullet\right\vert
\bullet\right)  $ defined as
\begin{equation}
\left(  \left.  X\right\vert Y\right)  =\operatorname{Tr}\left\{  XY\right\}
.
\end{equation}
As any positive element of $\mathcal{B}_{1sa}\left(  \mathcal{H}_{F}\right)  $
can be expressed as the square of elements of $\mathcal{B}_{1sa}\left(
\mathcal{H}_{F}\right)  $ i.e.%
\begin{equation}
D=Q^{2}%
\end{equation}
the set of states $S_{F}$ can also be described as
\begin{equation}
S_{F}=\left\{  \left.  Q\right\vert \left(  \left.  Q\right\vert Q\right)
=1;Q\in\mathcal{B}_{2sa}\left(  \mathcal{H}_{F}\right)  \right\}  .
\end{equation}
One should note that the correspondence between $Q$ and $D$ is not $1-1$ as
$D$ has many square roots i.e.
\begin{equation}
Q=\sum\left(  \pm\alpha_{j}\right)  \left\vert \Phi_{j}\right\rangle
\left\langle \Phi_{j}\right\vert ,
\end{equation}
where
\begin{equation}
D=\sum\alpha_{j}^{2}\left\vert \Phi_{j}\right\rangle \left\langle \Phi
_{j}\right\vert .
\end{equation}


\section{Reduced and Partial States}

A \emph{partial} state is a postive linear functional defined on a subspace
$\mathcal{W}$ of $\mathcal{B}_{sa}\left(  \mathcal{H}_{F}\right)  $ that
contains the identity $I_{\mathcal{H}_{F}}$ and satisfies eq. $\left(
\ref{States}\right)  $ for elements of the subspace and is the restriction of
a state. It can be shown \cite{Emch} that the necessary and sufficient
condition for a positive linear functional defined on such a subspace $W$ to
be a partial state and thus extended to a state is
\begin{equation}
\sup_{\substack{0\leq X\leq I\\X\in\mathcal{W}}}f\left(  X\right)  \leq1
\label{LessI}%
\end{equation}
and%
\begin{equation}
\inf_{\substack{X\geq I\\X\in\mathcal{W}}}f\left(  X\right)  \geq1.
\label{MoreI}%
\end{equation}
We denote the positive hyperants of the unit ball and annulus in $\mathcal{W}$
as
\begin{equation}
\mathfrak{B}_{1+}\left(  \mathcal{W}\right)  =\left\{  X\left\vert 0\leq
\sup_{\Phi\in\mathcal{H}_{F}}\left\{  \frac{\left\langle \left.
\Phi\right\vert X\Phi\right\rangle }{\left\langle \left.  \Phi\right\vert
\Phi\right\rangle }\right\}  =\left\Vert X\right\Vert =r\left(  X\right)
\leq1;X\geq0\right.  \right\}
\end{equation}
and
\begin{equation}
\mathfrak{A}_{1+}\left(  \mathcal{W}\right)  =\left\{  X\left\vert \infty
>\inf_{\Phi\in\mathcal{H}_{F}}\left\{  \left\vert \frac{\left\langle \left.
\Phi\right\vert X\Phi\right\rangle }{\left\langle \left.  \Phi\right\vert
\Phi\right\rangle }\right\vert \right\}  \geq1;X\geq0\right.  \right\}  .
\end{equation}
A \emph{reduced} state is a postive linear functional defined on a subspace
$\mathcal{W}$ of $\mathcal{B}_{sa}\left(  \mathcal{H}_{F}\right)  $ that does
not contain the identity $I$ and is the restriction of a state. The necessary
and sufficient condition for a positive linear functional defined on such a
subspace $W$ to be a reduced state and thus be extended to a state is
\begin{equation}
\sup_{X\in\mathfrak{B}_{1+}\left(  \mathcal{W}\right)  }f\left(  X\right)
\leq1
\end{equation}
and%
\begin{equation}
\inf_{X\in\mathfrak{A}_{1+}\left(  \mathcal{W}\right)  }f\left(  X\right)
\geq1.
\end{equation}


\subsection{Positive Operators contained within the Unit Ball $\mathfrak{B}%
_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)  $}

The condition $0$ $\leq X\leq I,$ $X\in\mathcal{B}_{+}\left(  \mathcal{H}%
_{F}\right)  $ can be expressed as
\begin{equation}
0\leq\left\langle \left.  \Phi\right\vert X\Phi\right\rangle \leq\left\langle
\left.  \Phi\right\vert \Phi\right\rangle \text{ }\forall\Phi\in
\mathcal{H}_{F}%
\end{equation}
which is equivalent to
\begin{equation}
0\leq\sup_{\Phi\in\mathcal{H}_{F}}\left\{  \frac{\left\langle \left.
\Phi\right\vert X\Phi\right\rangle }{\left\langle \left.  \Phi\right\vert
\Phi\right\rangle }\right\}  =\left\Vert X\right\Vert =r\left(  X\right)
\leq1;X\geq0. \label{supcon}%
\end{equation}
The set of $X$ that satisfy eq. $\left(  \ref{supcon}\right)  $ is the set of
positive operators contained in the unit ball $\mathfrak{B}_{1+}\left(
\mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)  =\mathfrak{B}_{1}\left(
\mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)  \cap\mathcal{B}_{+}\left(
\mathcal{H}_{F}\right)  \subset\mathcal{B}\left(  \mathcal{H}_{F}\right)  .$
The condition $X\geq I$ is equivalent to
\begin{equation}
\infty>\inf_{\Phi\in\mathcal{H}_{F}}\left\{  \frac{\left\langle \left.
\Phi\right\vert X\Phi\right\rangle }{\left\langle \left.  \Phi\right\vert
\Phi\right\rangle }\right\}  \geq1;X\geq0. \label{infcon}%
\end{equation}
The set of $X$ that satisfy eq. $\left(  \ref{infcon}\right)  $%
\begin{equation}
\mathfrak{A}_{1+}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)
=\mathfrak{A}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)
\cap\mathcal{B}_{+}\left(  \mathcal{H}_{F}\right)  \subset\mathcal{B}\left(
\mathcal{H}_{F}\right)
\end{equation}
is the set of positive operators contained in the hyperannulus $\mathfrak{A}%
_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)  ,$ and can
also be characterized by
\begin{equation}
\mathfrak{A}_{1+}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)
=\left\{  \left.  X\right\vert \left(  X-I\right)  \geq0;X\in\mathcal{B}%
_{+}\left(  \mathcal{H}_{F}\right)  \right\}  .
\end{equation}
The operators, $A$, belonging to the postive hyperant of the unit ball have
the spectral decomposition
\begin{equation}
A=\int_{r_{0}\left(  A\right)  }^{r\left(  A\right)  }\alpha\left\vert
\alpha\right\rangle \left\langle \alpha\right\vert d\alpha,
\end{equation}
where
\begin{equation}
0\leq r_{0}\left(  A\right)  \leq r\left(  A\right)  \leq1,
\end{equation}
and thus the operators, $A$, belonging to the postive hyperant of the annulus
have the spectral decomposition
\begin{equation}
A=\int_{r_{0}\left(  A\right)  }^{r\left(  A\right)  }\alpha\left\vert
\alpha\right\rangle \left\langle \alpha\right\vert d\alpha,
\end{equation}
where
\begin{equation}
1\leq r_{0}\left(  A\right)  \leq r\left(  A\right)  <\infty.
\end{equation}
Thus $\mathfrak{B}_{1}\left(  X\right)  $ and $\mathfrak{A}_{1}\left(
X\right)  $ can be generated by any bounded positive operators by scaling
\begin{equation}
\mathfrak{B}_{1}\left(  X\right)  =\left\{  X\left(  \alpha\right)  =\alpha
X\left\vert \alpha\leq\frac{1}{\left\Vert X\right\Vert }\right.  \right\}
\subset\mathfrak{B}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)
\right)  \Leftrightarrow\left\Vert X\left(  \alpha\right)  \right\Vert \leq1
\end{equation}
and shifting
\begin{align}
\mathfrak{A}_{1}\left(  X\right)   &  =\left\{  X\left(  \alpha\right)
=X+\left(  1-\alpha\right)  I\left\vert \alpha\leq\inf_{\Phi}\left\{
\frac{\left\langle \left.  \Phi\right\vert X\Phi\right\rangle }{\left\langle
\left.  \Phi\right\vert \Phi\right\rangle }\right\}  \right.  \right\}
\nonumber\\
&  \subset\mathfrak{A}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)
\right)  \Leftrightarrow\inf_{\Phi}\left\{  \frac{\left\langle \left.
\Phi\right\vert X\left(  \alpha\right)  \Phi\right\rangle }{\left\langle
\left.  \Phi\right\vert \Phi\right\rangle }\right\}  \geq1.
\end{align}
The unit hypersphere in $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
$ is defined as
\begin{equation}
\mathfrak{S}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =\left\{  X\left\vert \left\Vert X\right\Vert =1,X\in\mathcal{B}%
\left(  \mathcal{H}_{F}\right)  \right.  \right\}  ,
\end{equation}
whose positive hyperant is given by
\begin{equation}
\mathfrak{S}_{1+}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
\right)  =\mathfrak{S}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)  \cap\mathcal{B}_{+}\left(  \mathcal{H}_{F}\right)  .
\end{equation}
One can see that
\begin{equation}
\mathfrak{B}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)  \right)
\cap\mathfrak{A}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{F}\right)
\right)  =\mathfrak{S}_{1}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right)
\end{equation}
and note that $\mathfrak{B}_{1}\left(  \mathcal{B}\left(  \mathcal{H}%
_{F}\right)  \right)  $ is a convex set

$\lceil$%
\begin{align}
&  \sup_{\substack{\left\Vert \Phi\right\Vert =1\\\left\vert \Phi\right\rangle
\in\mathcal{H}_{F}}}\left\{  \left\vert \left\langle \left.  \Phi\right\vert
\left(  \alpha_{1}X_{1}+\alpha_{2}X_{2}\right)  \Phi\right\rangle \right\vert
\right\} \nonumber\\
&  \leq\left(  \alpha_{1}\sup_{\substack{\left\Vert \Phi\right\Vert
=1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{  \left\vert
\left\langle \left.  \Phi\right\vert X_{1}\Phi\right\rangle \right\vert
\right\}  +\alpha_{2}\sup_{\substack{\left\Vert \Phi\right\Vert =1\\\left\vert
\Phi\right\rangle \in\mathcal{H}_{F}}}\left\{  \left\vert \left\langle \left.
\Phi\right\vert X_{2}\Phi\right\rangle \right\vert \right\}  \right)  \leq1
\end{align}
$\rfloor$, but $\mathfrak{A}_{1}\left(  \mathcal{B}\left(  \mathcal{H}%
_{F}\right)  \right)  $ and $\mathfrak{S}_{1}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  $ are not.

The points on the unit hypersphere \emph{are not }in general extreme points of
the of the unit ball in a Banach space, in fact if the Banach space is not a
dual Banach space no extreme points exist, however in this case $\mathcal{B}%
\left(  \mathcal{H}_{F}\right)  $ is the dual of $\mathcal{B}_{1}\left(
\mathcal{H}_{F}\right)  $ (it is a w$^{\ast}$-algebra) and it can be shown
that if one restricts attention to positive operators in the unit sphere
\begin{gather}
X\in\operatorname*{ext}\left\{  \mathfrak{B}_{1+}\left(  \mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  \right)  \right\}  \Leftrightarrow
X^{\dagger}X\text{ and }XX^{\dagger}\text{ are projections}\\
\left\Vert X\right\Vert =\left\Vert X^{\dagger}\right\Vert =\left\Vert
X^{\dagger}X\right\Vert =\left\Vert XX^{\dagger}\right\Vert =1
\end{gather}
and the positive hyperant of the unit ball is generated by the closure of the
convex combinations of these extreme points. If $A$ lies on the lower boundary
of the unit annulus then
\begin{equation}
A=\int_{r_{0}\left(  A\right)  }^{r\left(  A\right)  }\alpha\left\vert
\alpha\right\rangle \left\langle \alpha\right\vert d\alpha=\int_{r_{0}\left(
A\right)  }^{r\left(  A\right)  }\left\vert \alpha\right\rangle \left\langle
\alpha\right\vert d\alpha,
\end{equation}
and is thus the identity operator or a projector. The operators
\begin{equation}
\sum_{0\leq k\leq\infty}\alpha_{k}P_{\mathcal{H}^{k}};\alpha_{k}\geq1,0\leq
k\leq\infty
\end{equation}
are all in the annulus, but the counting operators $\mathcal{N}_{k},1\leq
k\leq\infty$ are not.

The subspace $\Lambda_{P}$ is defined by
\begin{equation}
\Lambda_{P}=%
%TCIMACRO{\dbigoplus \limits_{1\leq k\leq P}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{1\leq k\leq P}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eP}%
\end{equation}
in terms of $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eP}.$ The
positive hyperant, $\mathfrak{B}_{1+}\left(  \Lambda_{P}\right)  ,$ of the
unit ball, $\mathfrak{B}_{1}\left(  \Lambda_{P}\right)  ,$is given by
\begin{align}
\mathfrak{B}_{1+}\left(  \Lambda_{P}\right)   &  =\left\{  \lambda
_{P}\left\vert \lambda_{P}=\sum_{1\leq Q\leq P}\sum_{\substack{1\leq
j_{1}<\cdots<j_{Q}\leq\infty\\1\leq k_{1}<\cdots<k_{Q}\leq\infty}%
}\lambda_{j_{1}\cdots j_{Q}k_{1}\cdots k_{Q}}a_{j_{1}}^{\dagger}\cdots
a_{j_{Q}}^{\dagger}a_{k_{Q}}\cdots a_{k_{1}}\right.  \right. \nonumber\\
&  \left.  0\leq\frac{\left\langle \left.  \Phi\right\vert \lambda_{P}%
\Phi\right\rangle }{\left\langle \left.  \Phi\right\vert \Phi\right\rangle
}\leq1\text{ }\forall\left\vert \Phi\right\rangle \in\mathcal{H}_{F}\right\}
\end{align}
$\lceil$One should note that
\begin{equation}
\sum_{1\leq j<P}\alpha_{j}\lambda_{j}\neq\lambda_{P}%
\end{equation}
for any $\lambda_{P}\neq0$ as
\begin{equation}
\sum_{\substack{1\leq j_{1}\leq\infty\\1\leq k_{1}\leq\infty}}\lambda
_{j_{1}k_{1}}a_{j_{1}}^{\dagger}a_{k_{1}}\neq\sum_{\substack{1\leq j_{1}%
\leq\infty\\1\leq k_{1}\leq\infty\\1\leq l\leq\infty}}\lambda_{j_{1}k_{1}%
}a_{j_{1}}^{\dagger}a_{l}^{\dagger}a_{l}a_{k_{1}}%
\end{equation}
just consider in particular
\begin{equation}
\sum_{\substack{1\leq j_{1}\leq\infty\\1\leq k_{1}\leq\infty}}\lambda
_{j_{1}k_{1}}a_{j_{1}}^{\dagger}a_{k_{1}}\left\vert \varphi_{a}\varphi
_{b}\varphi_{c}\right\rangle \neq\sum_{\substack{1\leq j_{1}\leq\infty\\1\leq
k_{1}\leq\infty\\1\leq l\leq\infty}}\lambda_{j_{1}k_{1}}a_{j_{1}}^{\dagger
}a_{l}^{\dagger}a_{l}a_{k_{1}}\left\vert \varphi_{a}\varphi_{b}\varphi
_{c}\right\rangle .\rfloor
\end{equation}


It is obvious that
\begin{equation}
0\leq\lambda_{P}\leq I,\lambda_{P}\in\mathfrak{B}_{1+}\left(  \Lambda
_{P}\right)  ,1\leq P\leq\infty.
\end{equation}
The identity operator $I\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  $ can be expressed as a sum of orthogonal projectors onto the
subspaces $\mathcal{B}\left(  \mathcal{H}^{N}\right)  $ as%
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}=\sum_{0\leq N\leq\infty}P_{\mathcal{H}^{N}}%
\end{equation}
thus
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}>P_{\mathcal{H}^{N}},\,0\leq N\leq\infty.
\end{equation}
The projectors $\left\{  \left.  P_{\mathcal{H}^{N}}\right\vert 0\leq
N\leq\infty\right\}  $ act as the identity elements $\left\{  \left.
P_{\mathcal{H}^{N}}\right\vert 0\leq N\leq\infty\right\}  $ on the spaces
$\left\{  \left.  \mathcal{H}^{N}\right\vert 0\leq N\leq\infty\right\}  $ i.e.%
\begin{equation}
P_{\mathcal{H}^{N}}=\left.  I\right\vert _{\mathcal{H}^{N}}=P_{\mathcal{H}%
^{N}}.
\end{equation}
One can observe that
\begin{equation}
P_{\mathcal{H}^{N}}=\left.  \binom{N}{P}^{-1}\mathcal{N}_{P}\right\vert
_{\mathcal{H}^{N}};0\leq P\leq N
\end{equation}
so in particular
\begin{equation}
I_{\mathcal{H}_{\mathcal{F}}}=\sum_{0\leq N\leq\infty}\left.  N^{-1}%
\mathcal{N}_{1}\right\vert _{\mathcal{H}^{N}}.
\end{equation}


If $D\in S_{P}$ $\subset\mathcal{B}_{1+}\left(  \mathcal{H}^{P}\right)  $
then
\begin{align}
0  &  \leq\left\langle \left.  \Phi\right\vert D\Phi\right\rangle
\leq\left\langle \left.  \Phi\right\vert \Phi\right\rangle \text{ }%
\forall\left\vert \Phi\right\rangle \in\mathcal{H}^{P}\\
\operatorname{Tr}\left\{  D\right\}   &  =1\\
\left\langle \left.  \Phi\right\vert D\Phi\right\rangle  &  =0\text{ }%
\forall\left\vert \Phi\right\rangle \in\mathcal{H}^{M},\text{ }M\neq P.
\end{align}
However it only defines a partial state, $\tilde{D}_{NP},$ on $\mathcal{B}%
_{sa}\left(  \mathcal{H}_{F}\right)  $ if $\tilde{D}_{NP}\in\tilde{S}%
_{PN}\subset S_{P}$ for $P\leq N.$ In general $\tilde{S}_{PN}$ are mixed
states (even $\operatorname*{ext}\left\{  \tilde{S}_{PN}\right\}  $are
mixed)$.$

\section{Extensions of Reduced States}

We are interested in extending reduced states defined on a sequence of nested
subspaces
\begin{equation}
\Lambda_{P}=%
%TCIMACRO{\dbigoplus \limits_{0\leq P\leq M}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq P\leq M}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eP},\quad1\leq M<N
\end{equation}
to%
\begin{equation}
\Lambda_{N}=%
%TCIMACRO{\dbigoplus \limits_{0\leq P\leq N}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq P\leq N}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{eP},
\end{equation}
where obviously
\begin{equation}
\Lambda_{N}\supseteq\cdots\supseteq\Lambda_{1}\supseteq\Lambda_{0}.
\end{equation}


As we are extending positive \emph{linear} functionals the condition eq.
$\left(  \ref{supcon}\right)  $ needs only to be checked on extreme points of
the positive hyperants of the unit balls $\left\{  \mathfrak{B}_{1}\left(
\Lambda_{P}\right)  \right\}  $ whose extreme points are projection operators
$\cite{Kadison}$ (if the states are just representable).

If $\left\{  X_{j}\right\}  $ is a linearly independent set of vectors then
one can set the values of a linear functional on them in an independent manner
and this defines the values of the functional on the subspace generated by
these vectors i.e.
\begin{equation}
f\left(  \sum_{1\leq j\leq m}c_{j}X_{j}\right)  =\sum_{1\leq j\leq m}%
c_{j}f\left(  X_{j}\right)  =\sum_{1\leq j\leq m}c_{j}d_{j}=h,
\end{equation}
where $d_{j}=f\left(  X_{j}\right)  .$ One must also consider "fullness" of
the set of states as%
\begin{align}
f\left(  b_{j}^{\dagger}b_{m}\right)   &  =\beta\nonumber\\
f\left(  b_{j}^{\dagger}\mathcal{N}_{1}b_{m}\right)   &  =\left(  N-1\right)
\beta\nonumber\\
\text{ if }f\left(  \mathcal{N}_{1}^{2}\right)   &  =f\left(  \mathcal{N}%
_{1}\right)  ^{2}=N^{2}\nonumber\\
\alpha_{1}b_{j}^{\dagger}b_{m}+\alpha_{2}b_{j}^{\dagger}\mathcal{N}_{1}b_{m}
&  =0\Rightarrow\alpha_{1},\alpha_{2}=0\nonumber\\
f\left(  \alpha_{1}b_{j}^{\dagger}b_{m}+\alpha_{2}b_{j}^{\dagger}%
\mathcal{N}_{1}b_{m}\right)   &  =0\forall f\in S_{N}\nRightarrow\alpha
_{1},\alpha_{2}=0\nonumber\\
\text{ as }f\left(  b_{j}^{\dagger}\mathcal{N}_{1}b_{m}-\left(  N-1\right)
b_{j}^{\dagger}b_{m}\right)   &  =0;\text{i.e. }\alpha_{1}=1,\alpha
_{2}=\left(  N-1\right) \nonumber\\
\left(  \left.  \alpha_{1}b_{j}^{\dagger}b_{m}+\alpha_{2}b_{j}^{\dagger
}\mathcal{N}_{1}b_{m}\right\vert \right)  _{\mathcal{H}^{N}}  &
=0\nRightarrow\alpha_{1},\alpha_{2}=0
\end{align}


so $b_{j}^{\dagger}b_{m}$ and $b_{j}^{\dagger}\mathcal{N}_{1}b_{m}$ are not
linearly independent on $\mathcal{H}^{N}$.

\subsection{First Order Reduced Density Operator}

In order that a positive linear functional $f_{1}$ defined on $\Lambda_{1},$
i.e.
\begin{align}
f_{1}  &  :\Lambda_{1}\rightarrow\mathbb{R},\nonumber\\
f_{1}\left(  \eta_{1}\right)   &  \geq0,\eta_{1}\geq0,\eta_{1}\in\Lambda_{1}%
\end{align}
can be extended (not uniquely) to a state $\tilde{f}_{1}$ defined on
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}\supseteq\Lambda_{1}%
\end{equation}
it must satisfy the \emph{necessary and sufficient} conditions
\begin{subequations}
\label{FORDcon}%
\begin{align}
0  &  \leq f_{1}\left(  \lambda_{1}\right)  \leq1\,\forall\lambda_{1}%
\in\mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  \Leftrightarrow\left(
\left\Vert \lambda_{1}\right\Vert \leq1,\lambda_{1}\geq0\right)
\label{con1.1}\\
1  &  \leq f_{1}\left(  \lambda_{1}\right)  \leq\infty\,\forall\lambda_{1}%
\in\mathfrak{A}_{1+}\left(  \Lambda_{1}\right)  \Leftrightarrow\lambda
_{1}-I\geq0. \label{con1.2}%
\end{align}
The annulus $\mathfrak{A}_{1+}\left(  \Lambda_{1}\right)  $ does intercept
$\Lambda_{1}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}$ i.e.
\end{subequations}
\begin{equation}
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}\cap\mathfrak{A}%
_{1+}\left(  \Lambda_{1}\right)  =\phi
\end{equation}
thus we can ignore condition eq. $\left(  \ref{con1.2}\right)  .$ As
$\mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  $ is a convex set and $f_{1}$ is
a linear functional the condition eq. $\left(  \ref{con1.1}\right)  $ can be
expressed as
\begin{equation}
f_{1}\left(  \lambda_{1}\right)  \leq1\,\forall\lambda_{1}\in
\operatorname*{Proj}\left\{  \Lambda_{1}\right\}  ,
\end{equation}
where
\begin{equation}
\operatorname*{Proj}\left\{  \Lambda_{1}\right\}  =\operatorname*{ext}\left\{
\mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  \right\}  .
\end{equation}
Then
\begin{equation}
f_{1}\left(  \eta_{1}\right)  =\operatorname*{Tr}\left\{  \eta_{1}D\right\}
,\eta_{1}\in\Lambda_{1}%
\end{equation}
and its extension
\begin{equation}
\tilde{f}_{1}\left(  X\right)  =\operatorname*{Tr}\left\{  XD\right\}
,X\in\mathcal{B}_{sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e}%
\end{equation}
where $D\in S_{\mathcal{F}}.$

If further
\begin{equation}
f_{1}\left(  \mathcal{N}_{1}\right)  =N \label{Trcon}%
\end{equation}
(such positive functionals are easily constructed) then their exists an
extension $f_{1}^{N}$ such that%
\begin{equation}
f_{1}^{N}\left(  \left(  \mathcal{N}_{1}\right)  ^{2}\right)  =N^{2}
\label{PureNum}%
\end{equation}
(such an extension is still positive as $\left(  \mathcal{N}_{1}\right)
^{2}\geq$ $\mathcal{N}_{1})$ and
\begin{equation}
f_{1}^{N}\left(  X\right)  =\operatorname*{Tr}\left\{  XD^{N}\right\}
,X\in\mathcal{B}_{sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},
\end{equation}
where $D^{N}\in S_{N}.$ Setting the value $N$ for $f_{1}$ is allowed by the
unit ball condition as let
\begin{equation}
f_{1}^{\prime}\left(  \mathcal{N}_{1}\right)  =\beta
\end{equation}
then we can set
\begin{equation}
f_{1}\left(  \mathcal{N}_{1}\right)  =\frac{N}{\beta}f_{1}^{\prime}\left(
\mathcal{N}_{1}\right)  =N.
\end{equation}
(If one sets it on one expansion of the number operator then it is
automatically set on all other expansions). The existence of an extension
$f_{1}^{N}$ that has the property eq. $\left(  \ref{PureNum}\right)  $ is not
so obvious but is known to exist by construction (using the method below).

$\lceil$%
\begin{equation}
\left\Vert \mathcal{N}_{1}\right\Vert =\sup_{\left\vert \Phi\right\rangle
\in\mathcal{H}_{F}}\left\{  \frac{\left\langle \left.  \Phi\right\vert
\mathcal{N}_{1}\Phi\right\rangle }{\left\langle \left.  \Phi\right\vert
\Phi\right\rangle }\right\}  =\infty,
\end{equation}
but is finite on states that have finitely non zero components, which is a
dense set in $\mathcal{H}_{F}$.$\rfloor$

As $\lambda_{1}\geq0$ then $\mathbf{\lambda}_{1}\geq0$ where $\mathbf{\lambda
}_{1}$ is the matrix with matrix elements $\lambda_{1jk}$ defined by
\begin{equation}
\lambda_{1jk}=\left\langle \left.  \varphi_{j}\right\vert \lambda_{1}%
\varphi_{k}\right\rangle ,
\end{equation}
where
\begin{equation}
\lambda_{1}=\sum_{1\leq j,k\leq\infty}\lambda_{1jk}a_{j}^{\dagger}a_{k}%
\end{equation}
and
\begin{equation}
\mathbf{\lambda}_{1}=\mathbf{\lambda}_{1}^{\dagger}.
\end{equation}
As $\mathbf{\lambda}_{1}$ is positive (thus hermitian)
\begin{equation}
\mathbf{\lambda}_{1}=\mathbf{u}\left(
\begin{array}
[c]{ccc}%
\beta_{1} & \cdots & 0\\
\vdots & \ddots & \vdots\\
0 & \cdots & \beta_{r}%
\end{array}
\right)  \mathbf{u}^{\dagger};\beta_{j}\geq0,1\leq j\leq r.
\end{equation}
Hence one can expand $\lambda_{1}$ as
\begin{equation}
\lambda_{1}=\sum_{\substack{1\leq j,k\leq r\\1\leq l\leq r}}u_{jl}\beta
_{l}\bar{u}_{kl}a_{j}^{\dagger}a_{k}=\sum_{1\leq l\leq r}\beta_{l}%
b_{l}^{\dagger}b_{l},
\end{equation}
where%
\begin{equation}
b_{l}^{\dagger}=\sum_{1\leq j\leq r}a_{j}^{\dagger}u_{jl}.
\end{equation}
This is a spectral expansion of $\lambda_{1}$ the $\left\{  \beta_{l}\right\}
$ are infinitely degenerate and $\left\{  b_{l}^{\dagger}b_{l}\right\}  $ are
the projectors onto the degenerate subspaces, which can be expanded into one
dimensional ket-bra projection operators according to eq. $\left(
\ref{OccNumOp}\right)  $. Noting that if $\lambda_{1}\in\mathfrak{B}%
_{1+}\left(  \Lambda_{1}\right)  $
\begin{align}
\left\Vert \lambda_{1}\right\Vert  &  =\sup_{\substack{\left\Vert
\Phi\right\Vert =1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{
\left\langle \left.  \Phi\right\vert \lambda_{1}\Phi\right\rangle \right\}
=\sup_{\substack{\left\Vert \Phi\right\Vert =1\\\left\vert \Phi\right\rangle
\in\mathcal{H}_{F}}}\left\{  \sum_{1\leq l\leq r}\beta_{l}\left\langle \left.
\Phi\right\vert b_{l}^{\dagger}b_{l}\Phi\right\rangle \right\} \\
&  \leq\sum_{1\leq l\leq r}\beta_{l}\sup_{\substack{\left\Vert \Phi\right\Vert
=1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{  \left\langle
\left.  \Phi\right\vert b_{l}^{\dagger}b_{l}\Phi\right\rangle \right\}
=\sum_{1\leq l\leq r}\beta_{l},
\end{align}
as
\begin{equation}
\left\Vert b_{l}^{\dagger}b_{l}\right\Vert =\sup_{\substack{\left\Vert
\Phi\right\Vert =1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{
\left\langle \left.  \Phi\right\vert b_{l}^{\dagger}b_{l}\Phi\right\rangle
\right\}  =1.
\end{equation}
As $\lambda_{1}$ is a projector $\left\Vert \lambda_{1}\right\Vert =1$ and
\begin{equation}
1\leq\sum_{1\leq l\leq r}\beta_{l}.
\end{equation}


$\lceil$%
\begin{align}
\left\Vert \left(  b_{l}^{\dagger}b_{l}\right)  ^{2}\right\Vert  &
=\left\Vert b_{l}^{\dagger}b_{l}\right\Vert ^{2}\nonumber\\
\left\Vert \left(  b_{l}^{\dagger}b_{l}\right)  ^{2}\right\Vert  &
=\left\Vert b_{l}^{\dagger}b_{l}\right\Vert \nonumber\\
&  \Downarrow\nonumber\\
\left\Vert b_{l}^{\dagger}b_{l}\right\Vert ^{2}  &  =\left\Vert b_{l}%
^{\dagger}b_{l}\right\Vert
\end{align}
thus
\begin{equation}
\left\Vert b_{l}^{\dagger}b_{l}\right\Vert =1\text{ or }0
\end{equation}
as $b_{l}^{\dagger}b_{l}$ $\neq0$ one has $\left\Vert b_{l}^{\dagger}%
b_{l}\right\Vert =1\rfloor$ one can conclude that
\begin{equation}
0\leq\beta_{l}\leq1.
\end{equation}
This can be summarized as%
\begin{align}
\operatorname*{Proj}\left\{  \Lambda_{1+}\right\}   &  =\left\{  \left.
\Phi\left(  \psi_{l}\right)  ^{\dagger}\Phi\left(  \psi_{l}\right)
\right\vert \forall\text{conb's }\left\{  \left.  \left\vert \psi
_{l}\right\rangle \right\vert 1\leq l\leq r\right\}  \text{ of }%
\mathcal{H}^{1}\right\} \nonumber\\
\operatorname*{Proj}\left\{  \Lambda_{1+}\right\}   &  =\operatorname*{ext}%
\left\{  \mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  \right\}
=\operatorname*{ext}\left\{  \mathfrak{B}_{1}\left(  \left(  \mathcal{B}%
_{+}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}\right)  \right)  \right\}
\end{align}
$\left(  \text{Note that }\Phi\left(  \psi_{l}\right)  \Phi\left(  \psi
_{l}\right)  ^{\dagger}=I_{\mathcal{H}_{\mathcal{F}}}\text{ }-\Phi\left(
\psi_{l}\right)  ^{\dagger}\Phi\left(  \psi_{l}\right)  \notin\Lambda
_{1}=\mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}\right)  .$
So
\begin{align}
\sup_{\lambda_{1}\in\mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  }\left\{
f_{1}\left(  \lambda_{1}\right)  \right\}   &  =\sup_{\lambda_{1}%
\in\mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  }\left\{  f_{1}\left(
\sum_{1\leq l\leq r}\beta_{l}b_{l}^{\dagger}b_{l}\right)  \right\} \nonumber\\
&  =\sup_{\lambda_{1}\in\mathfrak{B}_{1+}\left(  \Lambda_{1}\right)  }\left\{
\sum_{1\leq l\leq r}\beta_{l}f_{1}\left(  b_{l}^{\dagger}b_{l}\right)
\right\}  \leq1
\end{align}
implies the \emph{Occupation Number Condition}
\begin{align}
0  &  \leq f_{1}\left(  b_{l}^{\dagger}b_{l}\right)  =f_{1}\left(  \Phi\left(
\psi_{l}\right)  ^{\dagger}\Phi\left(  \psi_{l}\right)  \right)
\leq1\,\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}. \label{occnum}%
\end{align}


\subsection{Second Order Reduced Density Operator}

Products of operators belonging to $\Lambda_{1}$ are contained in $\Lambda
_{2}$ as%
\begin{align}
&  \sum_{1\leq j,k\leq\infty}\lambda_{1jk}a_{j}^{\dagger}a_{k}\sum_{1\leq
p,q\leq\infty}\eta_{1pq}a_{p}^{\dagger}a_{q}=\sum_{1\leq j,k,p,q\leq\infty
}\lambda_{1jk}\eta_{1pq}a_{j}^{\dagger}a_{k}a_{p}^{\dagger}a_{q}\nonumber\\
&  =\sum_{1\leq j,k,p,q\leq\infty}\lambda_{1jk}\eta_{1pq}\left\{
a_{j}^{\dagger}\left(  \delta_{kp}-a_{p}^{\dagger}a_{k}\right)  a_{q}\right\}
=\sum_{1\leq j,k,p,q\leq\infty}\lambda_{1jk}\eta_{1pq}\left\{  a_{j}^{\dagger
}a_{q}\delta_{kp}+a_{j}^{\dagger}a_{p}^{\dagger}a_{q}a_{k}\right\} \nonumber\\
&  =\sum_{1\leq j,q\leq\infty}\left(  \mathbf{\lambda}_{1}\mathbf{\eta}%
_{1}\right)  _{jq}a_{j}^{\dagger}a_{q}\nonumber\\
&  \qquad\qquad\qquad+\sum_{\substack{1\leq j<p\leq\infty\\1\leq k<q\leq
\infty}}\left(  \lambda_{1jk}\eta_{1pq}-\lambda_{1pk}\eta_{1jq}-\lambda
_{1jq}\eta_{1pk}+\lambda_{1pq}\eta_{1jk}\right)  a_{j}^{\dagger}a_{p}%
^{\dagger}a_{q}a_{k}\nonumber\\
&  =\sum_{1\leq j,q\leq\infty}\left(  \mathbf{\lambda}_{1}\mathbf{\eta}%
_{1}\right)  _{jq}a_{j}^{\dagger}a_{q}+\sum_{\substack{1\leq j<p\leq
\infty\\1\leq k<q\leq\infty}}\left(  \mathbf{\lambda}_{1}\wedge\mathbf{\eta
}_{1}\right)  _{jpkq}a_{j}^{\dagger}a_{p}^{\dagger}a_{q}a_{k}%
\end{align}


A positive linear functional $f_{2}$ defined on $\Lambda_{2}$ i.e.
\begin{equation}
f_{2}:\Lambda_{2}\rightarrow\mathbb{R}%
\end{equation}
can be extended to a positive linear functional $f_{2}^{N}$ (not uniquely)
defined on $\Lambda_{N}$ iff
\begin{subequations}
\label{SORDcon}%
\begin{align}
0  &  \leq f_{2}\left(  \lambda_{2}\right)  \leq1\,\forall\lambda_{2}%
\in\mathfrak{B}_{1+}\left(  \Lambda_{2}\right)  =\left\{  \left.  \lambda
_{2}\right\vert \left\Vert \lambda_{2}\right\Vert \leq1,\lambda_{2}%
\geq0\right\} \label{con2.1}\\
1  &  \leq f_{2}\left(  \lambda_{2}\right)  \leq\infty\,\forall\lambda_{2}%
\in\mathfrak{A}_{1+}\left(  \Lambda_{2}\right)  =\left\{  \left.  \lambda
_{2}\right\vert \lambda_{2}-I\geq0\right\}  . \label{con2.2}%
\end{align}
and
\end{subequations}
\begin{subequations}
\label{NumCon}%
\begin{align}
f_{2}\left(  \mathcal{N}_{1}\right)   &  =N\\
f_{2}\left(  \mathcal{N}_{2}\right)   &  =\binom{N}{2}.
\end{align}
Then%
\end{subequations}
\begin{equation}
f_{2}^{N}\left(  X\right)  =\operatorname*{Tr}\left\{  XD^{N}\right\}
,X\in\mathcal{B}_{sa}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e},
\end{equation}
and
\begin{equation}
f_{2}^{N}\left(  \eta_{2}\right)  =f_{2}\left(  \eta_{2}\right)
=\operatorname*{Tr}\left\{  \eta_{2}D^{N}\right\}  ,\eta_{2}\in\Lambda_{2},
\end{equation}
where $D^{N}\in S_{N}.$

One should note that
\begin{equation}
\left(  \mathcal{N}_{1}\right)  ^{2}=\mathcal{N}_{1}+2\mathcal{N}_{2},
\end{equation}
as%
\begin{align}
\sum_{1\leq j,k\leq\infty}a_{j}^{\dagger}a_{j}a_{k}^{\dagger}a_{k}  &
=\sum_{1\leq j,k\leq\infty}a_{j}^{\dagger}\left(  \delta_{jk}-a_{k}^{\dagger
}a_{j}\right)  a_{k}=\sum_{1\leq j,k\leq\infty}\left\{  a_{j}^{\dagger}%
a_{k}\delta_{jk}-a_{j}^{\dagger}a_{k}^{\dagger}a_{j}a_{k}\right\} \nonumber\\
&  =\sum_{1\leq j\leq\infty}a_{j}^{\dagger}a_{j}+2\sum_{1\leq j<k\leq\infty
}a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}.
\end{align}
Thus
\begin{equation}
\mathcal{N}_{2}=\frac{1}{2}\mathcal{N}_{1}\left(  \mathcal{N}_{1}-1\right)
\end{equation}
and eq. $\left(  \ref{NumCon}\right)  $ implies that
\begin{equation}
f_{2}\left(  \left(  \mathcal{N}_{1}\right)  ^{2}\right)  =N^{2}
\label{PureNum2}%
\end{equation}


\begin{theorem}
A state $f$ is a $N$ particle state iff $f\left(  \mathcal{N}_{1}\right)  =N$
and $f\left(  \mathcal{N}_{2}\right)  =\binom{N}{2}$ equivalently $f\left(
\mathcal{N}_{1}\right)  =N$ and $f\left(  \mathcal{N}_{2}\right)  =\binom
{N}{2}\Leftrightarrow f\left(  \left(  \mathcal{N}_{1}\right)  ^{2}\right)
=f\left(  \mathcal{N}_{1}\right)  ^{2}=N^{2}$
\end{theorem}

\begin{proof}
In the following we use the operator identity $\left(  \mathcal{N}_{1}\right)
^{2}=\mathcal{N}_{1}+2\mathcal{N}_{2}$

If
\begin{equation}
f\left(  \mathcal{N}_{1}\right)  =N\text{ and }f\left(  \mathcal{N}%
_{2}\right)  =\binom{N}{2}%
\end{equation}
then%
\begin{equation}
f\left(  \mathcal{N}_{1}+2\mathcal{N}_{2}\right)  =f\left(  \mathcal{N}%
_{1}^{2}\right)  =N+\frac{2N\left(  N-1\right)  }{2}=N^{2}=f\left(
\mathcal{N}_{1}\right)  ^{2}%
\end{equation}
thus $f$ is a pure $N$ -particle state.

If $f$ is a pure $N$-particle state i.e.
\begin{equation}
f\left(  \mathcal{N}_{1}^{2}\right)  =N^{2}%
\end{equation}
then
\begin{equation}
f\left(  \mathcal{N}_{1}\right)  =N
\end{equation}
and
\begin{equation}
f\left(  \mathcal{N}_{2}\right)  =\binom{N}{2}.
\end{equation}

\end{proof}

The preceding theorem in turn implies that
\begin{equation}
f_{2}\left(  a_{j_{1}}^{\dagger}a_{k_{1}}\right)  =\left(  N-1\right)
^{-1}f_{2}\left(  a_{j_{1}}^{\dagger}\mathcal{N}_{1}a_{k_{1}}\right)  =\left(
N-1\right)  ^{-1}\sum_{1\leq j\leq r}f_{2}\left(  a_{j_{1}}^{\dagger}%
a_{j}^{\dagger}a_{j}a_{k_{1}}\right)
\end{equation}
\emph{i.e. the values of }$f_{2}$\emph{ on }$\Lambda_{1}$\emph{ }$=$\emph{
}$B\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}$\emph{ are determined by
their values on }$B\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2}$\emph{ if
the condition eq. }$\left(  \ref{PureNum2}\right)  $\emph{ is satisfied. }In
fact we conjecture

\begin{theorem}
$f$ is a pure N-particle state iff
\begin{equation}
f\left(  a_{j}^{\dagger}a_{k}\right)  =\left(  N-1\right)  ^{-1}f\left(
a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  ;\quad1\leq j,k\leq r \label{N-1}%
\end{equation}
for any basis.
\end{theorem}

\begin{proof}
The "any basis" assertion follows from the invariance of $\mathcal{N}_{1}$ to
$U\left(  \mathcal{H}^{1}\right)  .$ If $f$ is a pure $N$ particle state eq.
$\left(  \ref{N-1}\right)  $ follows immediately.

Let $f$ be a mixed particle state i.e.
\begin{equation}
f\left(  X\right)  =\sum_{0\leq P\leq\infty}\alpha_{P}\left\langle \Psi
_{P}\left\vert X\Psi_{P}\right.  \right\rangle ;1\geq\alpha_{P}\geq
0;\sum_{0\leq P\leq\infty}\alpha_{P}=1
\end{equation}
then
\begin{align}
f\left(  a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)   &  =\sum_{0\leq
P\leq\infty}\alpha_{P}\left\langle \Psi_{P}\left\vert a_{j}^{\dagger
}\mathcal{N}_{1}a_{k}\Psi_{P}\right.  \right\rangle =\sum_{0\leq P\leq\infty
}\alpha_{P}\left(  P-1\right)  \left\langle \Psi_{P}\left\vert a_{j}^{\dagger
}a_{k}\Psi_{P}\right.  \right\rangle \nonumber\\
&  =\left(  N-1\right)  \sum_{0\leq P\leq\infty}\alpha_{P}\left\langle
\Psi_{P}\left\vert a_{j}^{\dagger}a_{k}\Psi_{P}\right.  \right\rangle
\end{align}
and thus%
\begin{align}
0  &  =\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}  \left\langle
\Psi_{P}\left\vert a_{j}^{\dagger}a_{k}\Psi_{P}\right.  \right\rangle \forall
j,k\\
&  \Rightarrow\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}
\left\langle \Psi_{P}\left\vert b^{\dagger}b\Psi_{P}\right.  \right\rangle
=0\forall b\\
&  \Leftrightarrow\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}
n_{b}=0;\quad\forall n_{b}\in\left[  0,1\right] \\
&  \Leftrightarrow\sum_{0\leq P\leq\infty}\alpha_{P}\left\{  P-N\right\}
=0=\sum_{0\leq P\leq\infty}\alpha_{P}P-N\\
&  \Leftrightarrow\sum_{0\leq P\leq\infty}\alpha_{P}P=N;\quad P\in
\mathbb{N},\sum_{0\leq P\leq\infty}\alpha_{P}=1,\alpha_{P}\in\left[
0,1\right] \\
&  \Leftrightarrow\alpha_{N}=1,\alpha_{P}=0,P\neq N.
\end{align}

\end{proof}

As $\lambda_{2}\geq0$ then $\mathbf{\lambda}_{2}\geq0,$ where $\mathbf{\lambda
}_{2}$ is the matrix with matrix elements $\lambda_{2j_{1}j_{2}k_{1}k_{2}}$
defined by
\begin{equation}
\lambda_{2j_{1}j_{2}k_{1}k_{2}}=\left\langle \left.  \varphi_{j_{1}}%
\varphi_{j_{2}}\right\vert \lambda_{2}\varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle ,
\end{equation}
where
\begin{equation}
\lambda_{2}=\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}%
\leq\infty}}\lambda_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}%
\end{equation}
and
\begin{equation}
\mathbf{\lambda}_{2}\geq0\Rightarrow\mathbf{\lambda}_{2}=\mathbf{\lambda}%
_{2}^{\dagger}.
\end{equation}
As $\mathbf{\lambda}_{2}$ is positive
\begin{equation}
\mathbf{\lambda}_{2}=\mathbf{u}_{2}\left(
\begin{array}
[c]{ccc}%
\beta_{1} & \cdots & 0\\
\vdots & \ddots & \vdots\\
0 & \cdots & \beta_{\binom{r}{2}}%
\end{array}
\right)  \mathbf{u}_{2}^{\dagger};\,\beta_{j}\geq0,1\leq j\leq\binom{r}{2}%
\end{equation}
then
\begin{equation}
\lambda_{2}=\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}%
\leq\infty}}\lambda_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}=\sum_{1\leq l\leq\infty}\beta_{l}g_{l}^{\dagger
}g_{l}, \label{ProjEx}%
\end{equation}
where%
\begin{equation}
g_{l}^{\dagger}=\sum_{1\leq j_{1}<j_{2}\leq\infty}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}u_{2j_{1}j_{2}l}%
\end{equation}
and
\begin{equation}
\mathbf{u}_{2l}^{\dagger}\mathbf{u}_{2m}=\sum_{1\leq j_{1}<j_{2}\leq\infty
}\bar{u}_{2j_{1}j_{2}l}u_{2j_{1}j_{2}m}=\delta_{lm}.
\end{equation}
Clearly one can define an antisymmetric matrix of geminal coefficients
$\mathbf{g}_{l}$ by
\begin{equation}
g_{2j_{1}j_{2}l}=u_{2j_{1}j_{2}l},\quad g_{2j_{2}j_{1}l}=-u_{2j_{2}j_{1}%
l};1\leq j_{1}<j_{2}\leq\infty,
\end{equation}
and
\begin{equation}
\sum_{1\leq j_{1}<j_{2}\leq\infty}\bar{g}_{2j_{1}j_{2}l}g_{2j_{1}j_{2}%
m}=\operatorname*{Tr}\left\{  \mathbf{g}_{l}^{\dagger}\mathbf{g}_{m}\right\}
=\left\langle g_{l}\left\vert g_{m}\right.  \right\rangle =\delta_{lm}.
\end{equation}
The operator norm of $\lambda_{2},\lambda_{2}\geq0$ is given by
\begin{align}
\left\Vert \lambda_{2}\right\Vert  &  =\sup_{\substack{\left\Vert
\Phi\right\Vert =1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{
\left\langle \left.  \Phi\right\vert \lambda_{2}\Phi\right\rangle \right\}
=\sup_{\substack{\left\Vert \Phi\right\Vert =1\\\left\vert \Phi\right\rangle
\in\mathcal{H}_{F}}}\left\{  \sum_{1\leq l\leq\binom{r}{2}}\beta
_{l}\left\langle \left.  \Phi\right\vert g_{l}^{\dagger}g_{l}\Phi\right\rangle
\right\} \\
&  \leq\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}\sup_{\substack{\left\Vert
\Phi\right\Vert =1\\\left\vert \Phi\right\rangle \in\mathcal{H}_{F}}}\left\{
\left\langle \left.  \Phi\right\vert g_{l}^{\dagger}g_{l}\Phi\right\rangle
\right\}  .
\end{align}
In order to study this one can observe that $\left\{  a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right\}  $ are projectors as
\begin{equation}
a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}=a_{j_{1}}^{\dagger
}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}}%
\end{equation}
and
\begin{equation}
a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}^{\dagger
}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}}=a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{1}%
}^{\dagger}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{2}}^{\dagger}a_{j_{2}%
}=a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}},
\end{equation}
\emph{thus their sup norms must be equal to one }(if $\left\Vert X\right\Vert
^{2}=\left\Vert X\right\Vert $ then $\left\Vert X\right\Vert =1)$ i.e.
\begin{equation}
\left\Vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right\Vert
=1\Leftrightarrow\left\Vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\right\Vert
=\left\Vert a_{j_{2}}a_{j_{1}}\right\Vert =1
\end{equation}
and one obtains%
\begin{align}
\left\Vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\right\Vert ^{2}  &
=\left\Vert a_{j_{1}}a_{j_{2}}\right\Vert ^{2}=\left\Vert a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}\right\Vert =\left\Vert a_{j_{2}}a_{j_{1}}\right\Vert
\nonumber\\
&  =\left\Vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right\Vert =r\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}%
a_{j_{1}}\right)  =r\left(  a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}^{\dagger
}a_{j_{2}}\right)  =1.
\end{align}


$\lceil$As the operators commute i.e.
\begin{equation}
\left[  a_{j_{1}}^{\dagger}a_{j_{1}},a_{j_{2}}^{\dagger}a_{j_{2}}\right]  =0
\end{equation}
they can be simultaneously diagonalized
\begin{equation}
a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}^{\dagger}a_{j_{2}}=\int\alpha_{j_{1}%
}\left(  \alpha\right)  \left\vert \alpha\right\rangle \left\langle
\alpha\right\vert d\alpha\int\alpha_{j_{2}}\left(  \alpha\right)  \left\vert
\alpha\right\rangle \left\langle \alpha\right\vert d\alpha=\int\alpha
_{j_{1}j_{2}}\left(  \alpha\right)  \left\vert \alpha\right\rangle
\left\langle \alpha\right\vert d\alpha
\end{equation}
and $0\leq\alpha_{j_{1}}\left(  \alpha\right)  ,\alpha_{j_{2}}\left(
\alpha\right)  ,\alpha_{j_{1}j_{2}}\left(  \alpha\right)  \leq1.\rfloor$

\begin{theorem}
$\lambda_{2}\in\mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2}$
is idempotent iff $\lambda_{2}=\Phi\left(  \varphi\right)  ^{\dagger}%
\Phi\left(  \psi\right)  ^{\dagger}\Phi\left(  \psi\right)  \Phi\left(
\varphi\right)  ,$ where $\left\langle \varphi\left\vert \psi\right.
\right\rangle =0$ and $\left\Vert \varphi\right\Vert =$ $\left\Vert
\psi\right\Vert =1.$
\end{theorem}

One can show \cite{Kadison} that the extreme points of the positive hyperant
of the unit ball $\mathfrak{B}_{1}\left(  \mathcal{B}_{+}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e2}\right)  ,$which are in the
intersection of the positive hyperant and the unit hypersphere $\mathfrak{S}%
_{1}\left(  \mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e2}\right)  ,$ are given by
\begin{align}
\operatorname*{Proj}\left\{  \mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}\right\}   &  =\left\{  \left.  \Phi\left(  \psi_{l_{1}%
}\right)  ^{\dagger}\Phi\left(  \psi_{l_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{l_{2}}\right)  \Phi\left(  \psi_{l_{1}}\right)  \right\vert \right.
1\leq l_{1}\,<l_{2}\leq r\nonumber\\
&  \left.  \forall\text{conb's }\left\{  \left.  \left\vert \psi
_{l}\right\rangle \right\vert 1\leq l\leq r\right\}  \text{ of }%
\mathcal{H}^{1}\right\}  =\operatorname*{ext}\left(  \mathfrak{B}_{1}\left(
\mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2}\right)
\right)  .
\end{align}
This can be extended to $\Lambda_{2}=\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  _{e1}\oplus\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}$, noting $\Phi\left(  \varphi\right)  ^{\dagger}\Phi\left(
\psi\right)  \Phi\left(  \psi\right)  ^{\dagger}\Phi\left(  \varphi\right)  $
is also a projector, as
\begin{align}
&  \operatorname*{Proj}\left\{  \Lambda_{2+}\right\}  =\nonumber\\
&  \left\{  \left.  \Phi\left(  \psi_{l_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{l_{2}}\right)  ^{\dagger}\Phi\left(  \psi_{l_{2}}\right)  \Phi\left(
\psi_{l_{1}}\right)  ,\Phi\left(  \psi_{l_{1}}\right)  ^{\dagger}\Phi\left(
\psi_{l_{2}}\right)  \Phi\left(  \psi_{l_{2}}\right)  ^{\dagger}\Phi\left(
\psi_{l_{1}}\right)  ,\Phi\left(  \psi_{l_{3}}\right)  ^{\dagger}\Phi\left(
\psi_{l_{3}}\right)  \right\vert \right. \nonumber\\
&  \left.  \qquad\qquad\qquad\right.  1\leq l_{1}\,,l_{2}\leq r,1\leq
l_{3}\leq r,\left.  \forall\text{conb's }\left\{  \left.  \left\vert \psi
_{l}\right\rangle \right\vert 1\leq l\leq r\right\}  \text{ of }%
\mathcal{H}^{1}\right\} \nonumber\\
&  \left.  \qquad\qquad=\right.  \operatorname*{ext}\left(  \mathfrak{B}%
_{1}\left(  \Lambda_{2+}\right)  \right)  .
\end{align}
\emph{It should be noted} that $g^{\dagger}g$ are \emph{not }extreme points of
the unit ball $\mathfrak{B}_{1}\left(  \left(  \mathcal{B}_{+}\left(
\mathcal{H}_{\mathcal{F}}\right)  _{e2}\right)  \right)  $ \emph{unless }they
are produced by geminal creators that have rank equal to one \emph{even if
}$\left\Vert g^{\dagger}g\right\Vert =1$.

The canonical decomposition of a geminal gives
\begin{align}
\left\Vert g_{l}^{\dagger}\right\Vert  &  =\left\Vert \sum_{1\leq j_{1}%
<j_{2}\leq\infty}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}g_{lj_{1}j_{2}%
}\right\Vert \nonumber\\
&  =\left\Vert \sum_{1\leq j\leq s}b_{lj}^{\dagger}b_{lj_{+s}}^{\dagger}%
c_{lj}\right\Vert \leq\sum_{1\leq j\leq s}c_{lj}\left\Vert b_{lj}^{\dagger
}b_{lj_{+s}}^{\dagger}\right\Vert =\sum_{1\leq j\leq s}c_{lj},
\end{align}
where
\begin{equation}
\sum_{1\leq j\leq s}c_{lj}^{2}=1;1\geq c_{lj}\geq0,1\leq j\leq s.
\end{equation}
Therefore
\begin{equation}
\left\Vert g_{l}^{\dagger}g_{l}\right\Vert =\left\Vert g_{l}^{\dagger
}\right\Vert ^{2}=\left\Vert g_{l}\right\Vert ^{2}=r\left(  g_{l}^{\dagger
}g_{l}\right)  \leq\left(  \sum_{1\leq j\leq s}c_{lj}\right)  ^{2}%
=1+2\sum_{1\leq j<k\leq s}c_{lj}c_{lk}\nonumber
\end{equation}
and in general a $g_{l}^{\dagger}g_{l}$ produced by a \emph{normalized
}geminal does not belong to the unit ball unless
\begin{equation}
\sum_{1\leq j<k\leq s}c_{lj}c_{lk}=0\Rightarrow c_{lk}=0,\text{ }k>1\text{ and
}c_{l1}=1.
\end{equation}
In this case
\begin{equation}
g_{l}^{\dagger}g_{l}=b_{l_{1}}^{\dagger}b_{l_{1+s}}^{\dagger}b_{l_{1+s}%
}b_{l_{1}},
\end{equation}
which is a projector and is an extreme point of the unit ball. Thus condition
eq. $\left(  \ref{con2.1}\right)  $ becomes the \emph{Pair Occupation Number
Condition (Generalized P Condition)}
\begin{align}
0  &  \leq f_{2}\left(  b_{j}^{\dagger}b_{k}^{\dagger}b_{k}b_{j}\right)
=f_{2}\left(  \Phi\left(  \psi_{j}\right)  ^{\dagger}\Phi\left(  \psi
_{k}\right)  ^{\dagger}\Phi\left(  \psi_{k}\right)  \Phi\left(  \psi
_{j}\right)  \right)  \leq1\,\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}.
\label{PairOcc1}%
\end{align}
and the \emph{Generalized G Condition }
\begin{align}
0  &  \leq f_{2}\left(  b_{j}^{\dagger}b_{k}b_{k}^{\dagger}b_{j}\right)
=f_{2}\left(  \Phi\left(  \psi_{j}\right)  ^{\dagger}\Phi\left(  \psi
_{k}\right)  \Phi\left(  \psi_{k}\right)  ^{\dagger}\Phi\left(  \psi
_{j}\right)  \right)  \leq1\,\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1}.
\label{PairOcc2}%
\end{align}
Together with the \emph{Occupation Number Condition}
\begin{align}
0  &  \leq f_{2}\left(  b_{j}^{\dagger}b_{j}\right)  =f_{2}\left(  \Phi\left(
\psi_{j}\right)  ^{\dagger}\Phi\left(  \psi_{j}\right)  \right)
\leq1\,\nonumber\\
&  \forall\text{conb's }\left\{  \left.  \left\vert \psi_{l}\right\rangle
\right\vert 1\leq l\leq r\right\}  \text{ of }\mathcal{H}^{1} \label{SingOcc}%
\end{align}
\emph{these are the }\textbf{Necessary and Sufficient Conditions} \emph{for
the Representability of a state belonging to }$S_{2}$ \emph{to be extended to
a state belonging to }$S_{\mathcal{F}}.$ We denote this convex set of
representable states as $S_{2\mathcal{F}}.$ The extreme points,
$\operatorname*{ext}\left\{  S_{2\mathcal{F}}\right\}  ,$ of this set have not
been characterized.

If the condition
\begin{equation}
f\left(  \mathcal{N}_{1}^{2}\right)  =f\left(  \mathcal{N}_{1}\right)
^{2}=N^{2} \label{PureNumber}%
\end{equation}
is added to eq. $\left(  \ref{PairOcc1}\right)  $ then one obtains
\textbf{Necessary and Sufficient Conditions} \emph{for the N-Representability
of a state belonging to }$S_{2}$ \emph{to be extended to a state belonging to
}$S_{N}$ as being just eqs. $\left(  \ref{PairOcc1}\right)  $ and $\left(
\ref{PureNumber}\right)  .$The set, $S_{N2},$ of such $N$-Representable states
is described by
\begin{align}
S_{N2}  &  =\left\{  D^{2}\left\vert D^{2}\in S_{2},\underset{\varphi,\psi
\in\mathcal{H}^{1}}{Max}\left\{  \left\langle \left.  \varphi\psi\right\vert
D^{2}\varphi\psi\right\rangle \right\}  \leq1,\operatorname*{Tr}\left\{
D^{2}\right\}  =\binom{N}{2},\operatorname*{Tr}\left\{  D^{1}\right\}
=N\right.  \right\} \nonumber\\
S_{N2}  &  =\left\{  D^{2}\left\vert D^{2}\in S_{2},\underset{u\in U\left(
\mathcal{H}^{1}\right)  }{Max}\left\{  \left\langle \left.  u\varphi_{0}%
u\psi_{0}\right\vert D^{2}u\varphi_{0}u\psi_{0}\right\rangle \right\}
\leq1,\operatorname*{Tr}\left\{  D^{2}\right\}  =\binom{N}{2},\right.  \right.
\nonumber\\
&  \left.  \operatorname*{Tr}\left\{  D^{1}\right\}  =N\right\} \nonumber\\
S_{N2}  &  =\left\{  D^{2}\left\vert D^{2}\in S_{2},\underset{\lambda\in
u\left(  \mathcal{H}^{1}\right)  }{Max}\left\{  \left\langle \left.
\varphi_{0}\psi_{0}\right\vert e^{i\lambda}D^{2}e^{-i\lambda}\varphi_{0}%
\psi_{0}\right\rangle \right\}  \leq1,\operatorname*{Tr}\left\{
D^{2}\right\}  =\binom{N}{2},\right.  \right. \nonumber\\
&  \left.  \operatorname*{Tr}\left\{  D^{1}\right\}  =N\right\}  ,
\end{align}
again the extreme points, $\operatorname*{ext}\left\{  S_{2N}\right\}  ,$ of
this set have not been characterized. One should note that the trace condition
is
\begin{equation}
\left\Vert D^{2}\right\Vert _{1}=\operatorname*{Tr}\left\{  D^{2}\right\}
=\binom{N}{2}.
\end{equation}
$\lceil$The trace of the first and second RDO's of a general state $D$ are
\begin{align}
\operatorname*{Tr}\left\{  D^{2}\right\}   &  =\sum_{1\leq j,k\leq r}%
D_{jkjk}^{2}=\frac{1}{2}\sum_{1\leq j,k\leq r}f\left(  a_{j}^{\dagger}%
a_{k}^{\dagger}a_{k}a_{j}\right)  =f\left(  \mathcal{N}_{2}\right) \\
\operatorname*{Tr}\left\{  D^{1}\right\}   &  =\sum_{1\leq j\leq r}D_{jj}%
^{1}=\sum_{1\leq j\leq r}f\left(  a_{j}^{\dagger}a_{j}\right)  =f\left(
\mathcal{N}_{1}\right)  .
\end{align}
In general
\begin{equation}
f\left(  a_{j}^{\dagger}a_{k}\right)  \neq\left(  N-1\right)  ^{-1}\sum_{1\leq
j\leq r}f\left(  a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  =\left(
N-1\right)  ^{-1}\sum_{1\leq l\leq r}f\left(  a_{j}^{\dagger}a_{l}^{\dagger
}a_{l}a_{k}\right)  ,
\end{equation}
and in fact%
\begin{equation}
f\left(  a_{j}^{\dagger}a_{k}\right)  =\left(  N-1\right)  ^{-1}\sum_{1\leq
j\leq r}f\left(  a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  =\left(
N-1\right)  ^{-1}\sum_{1\leq l\leq r}f\left(  a_{j}^{\dagger}a_{l}^{\dagger
}a_{l}a_{k}\right)
\end{equation}
iff $f$ is a pure number state.

One can define the FORDM as the contraction of the SORDM if and only if $f$ is
a pure number state i.e.
\begin{equation}
D_{jk}^{1}=\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}D_{jlkl}^{2}=\left(
N-1\right)  ^{-1}\sum_{1\leq l\leq r}f\left(  a_{j}^{\dagger}a_{l}^{\dagger
}a_{l}a_{k}\right)  =\left(  N-1\right)  ^{-1}f\left(  a_{j}^{\dagger
}\mathcal{N}_{1}a_{k}\right)  =f\left(  a_{j}^{\dagger}a_{k}\right)  .
\end{equation}
As then
\begin{equation}
\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}f\left(  a_{j}^{\dagger}%
a_{l}^{\dagger}a_{l}a_{k}\right)  =\left(  N-1\right)  ^{-1}f\left(
a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  =\left(  N-1\right)  ^{-1}\left(
N-1\right)  f\left(  a_{j}^{\dagger}a_{k}\right)  =f\left(  a_{j}^{\dagger
}a_{k}\right)  ,
\end{equation}
and the traces are given by
\begin{equation}
\sum_{1\leq j,k\leq r}f\left(  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}%
a_{j}\right)  =\sum_{1\leq j\leq r}f\left(  a_{j}^{\dagger}a_{k}^{\dagger
}a_{k}a_{j}\right)  =\left(  N-1\right)  \sum_{1\leq j\leq r}f\left(
a_{j}^{\dagger}a_{j}\right)  =\left(  N-1\right)  f\left(  \mathcal{N}%
_{1}\right)  =N\left(  N-1\right)
\end{equation}
and
\begin{equation}
\sum_{1\leq j\leq r}f\left(  a_{j}^{\dagger}a_{j}\right)  =\left(  N-1\right)
^{-1}\sum_{1\leq j\leq r}f\left(  a_{j}^{\dagger}\mathcal{N}_{1}a_{j}\right)
.
\end{equation}
$\rfloor$

\subsubsection{Two-fermion Thouless Coherent States}

The nonlinear manifold, $\mathcal{M}_{2},$ of, in general unnormalized,
decomposable geminals (i.e. Independent 2-particle States) in $\mathcal{H}%
^{2}$ can be coordinatized by using the Thouless parameters, $\left\{  \left.
z_{ph}\right\vert 1\leq h\leq2,3\leq p\leq r\right\}  $ via Thouless Coherent
States
\begin{equation}
\left\vert \mathbf{z}\right\rangle =\left\vert \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle ,
\end{equation}
where
\begin{align}
\left\vert \mathbf{z}\right\rangle  &  =\exp\left\{  \sum
\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}%
a_{h}\right\}  \left\vert \varphi_{1}\varphi_{2}\right\rangle \\
\left\vert \varphi_{j}\left(  \mathbf{z}\right)  \right\rangle  &
=\exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}%
a_{p}^{\dagger}a_{h}\right\}  \left\vert \varphi_{j}\right\rangle ;1\leq
j\leq2.
\end{align}
$\lceil$Elements of $\mathcal{H}^{1},\mathcal{H}^{3},\cdots,\mathcal{H}^{r}$
also have holomorphic wave functions, $\Psi_{P}\left(  \mathbf{z}\right)  ,$
of $\mathbf{z}$ given by
\begin{equation}
\Psi_{P}\left(  \mathbf{z}\right)  =\left\langle \left.  \exp\left\{
\sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}%
a_{h}\right\}  \Phi_{P}\right\vert \Psi_{P}\right\rangle ,
\end{equation}
but on these spaces
\begin{align}
P_{\mathcal{H}^{P}}  &  \neq\int\exp\left\{  \sum\limits_{\substack{1\leq
h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \left\vert \Phi
_{P}\right\rangle \left\langle \Phi_{P}\right\vert \exp\left\{  \sum
\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}%
a_{h}\right\}  d\mu\left(  \mathbf{z}\right)  ,\nonumber\\
&  =\int\exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq
r}}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \left\vert \varphi_{1}\cdots\varphi
_{P}\right\rangle \left\langle \varphi_{1}\cdots\varphi_{P}\right\vert
\exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}%
a_{p}^{\dagger}a_{h}\right\}  d\mu\left(  \mathbf{z}\right)  ,
\end{align}
as the reference state $\left\vert \Phi_{P}\right\rangle \in$ $\mathcal{H}%
^{P}$ does not produce a one dimensional representation of $SU\left(
2\right)  \times SU\left(  r-2\right)  $ i.e.
\begin{equation}
u\left\vert \Phi_{P}\right\rangle \neq e^{i\theta\left(  u\right)  }\left\vert
\Phi_{P}\right\rangle \,\forall u\in U\left(  2\right)  \times U\left(
r-2\right)  ,P\neq2,
\end{equation}
which is \emph{the essential} ingredient for the construction of scalar
Coherent States and thus such wavefunctions do not uniquely represent the
states. In the case $P=1$ if
\begin{equation}
\left\vert \Phi_{1}\right\rangle =c_{1}\left\vert \varphi_{1}\right\rangle
+c_{2}\left\vert \varphi_{2}\right\rangle ,
\end{equation}
for fixed $c_{1}\neq0,c_{2}\neq0,$ $\left\vert c_{1}\right\vert ^{2}%
+\left\vert c_{2}\right\vert ^{2}=1$ then
\begin{equation}
P_{\mathcal{H}^{1}}=\int\exp\left\{  \sum\limits_{\substack{1\leq
h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \left\vert \Phi
_{1}\right\rangle \left\langle \Phi_{1}\right\vert \exp\left\{  \sum
\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}%
a_{h}\right\}  d\mu^{\prime}\left(  \mathbf{z}\right)  .
\end{equation}


$\lceil$From the preceding sections
\begin{equation}
\Gamma_{P}^{N}\left(  P_{\mathcal{H}^{P}}\right)  =P_{\mathcal{H}^{P}}\wedge
P_{\mathcal{H}^{N-P}}=P_{\mathcal{H}^{N}}=\binom{N}{P}^{-1}\Gamma_{N}\left(
P_{\mathcal{H}^{P}}\right)
\end{equation}
and
\begin{equation}
L_{N}^{P}\left(  P_{\mathcal{H}^{N}}\right)  =\binom{r}{N}P_{\mathcal{H}^{P}%
}=\binom{N}{P}^{-1}\binom{r}{N}L_{P}\left(  P_{\mathcal{H}^{N}}\right)  .
\end{equation}
$\lceil$%
\begin{equation}
\left(  \left.  \Gamma_{P}^{N}\left(  P_{\mathcal{H}^{P}}\right)  \right\vert
P_{\mathcal{H}^{N}}\right)  =\left(  \left.  P_{\mathcal{H}^{P}}\right\vert
L_{N}^{P}\left(  P_{\mathcal{H}^{N}}\right)  \right)  =\left(  \left.
P_{\mathcal{H}^{N}}\right\vert P_{\mathcal{H}^{N}}\right)  =\operatorname*{Tr}%
\left\{  P_{\mathcal{H}^{N}}\right\}
\end{equation}
$\rfloor$

Thus in particular
\begin{align}
L_{2}^{1}\left(  P_{\mathcal{H}^{2}}\right)   &  =\frac{r}{2}P_{\mathcal{H}%
^{1}}=\frac{r}{2}L_{1}\left(  P_{\mathcal{H}^{2}}\right) \nonumber\\
\Gamma_{1}^{2}\left(  P_{\mathcal{H}^{1}}\right)   &  =P_{\mathcal{H}^{2}%
}=\frac{1}{2}\Gamma_{2}\left(  P_{\mathcal{H}^{1}}\right)  ,
\end{align}
which gives%
\begin{align}
L_{2}^{1}\left(  P_{\mathcal{H}^{2}}\right)   &  =L_{2}^{1}\left(  \int
u\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert u\left(  \mathbf{z}\right)
^{\dagger}d\mu\left(  \mathbf{z}\right)  \right)  =\int u\left(
\mathbf{z}\right)  L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right)
u\left(  \mathbf{z}\right)  ^{\dagger}d\mu\left(  \mathbf{z}\right)
\nonumber\\
&  =\frac{1}{2}\int u\left(  \mathbf{z}\right)  \left\{  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert
\varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right\}
u\left(  \mathbf{z}\right)  ^{\dagger}d\mu\left(  \mathbf{z}\right)  =\frac
{r}{2}P_{\mathcal{H}^{1}}%
\end{align}
i.e.%
\begin{equation}
\int u\left(  \mathbf{z}\right)  \left\{  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert +\left\vert \varphi_{2}\right\rangle
\left\langle \varphi_{2}\right\vert \right\}  u\left(  \mathbf{z}\right)
^{\dagger}d\mu\left(  \mathbf{z}\right)  =rP_{\mathcal{H}^{1}}.
\end{equation}
This can be reexpressed as
\begin{equation}
L_{1}\left(  \int\left\vert \widetilde{\varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  }\right\vert d\mu\left(  \mathbf{z}\right)  \right)
=r\int\left\{  \left\vert \widetilde{\varphi_{1}\left(  \mathbf{z}\right)
}\right\rangle \left\langle \widetilde{\varphi_{1}\left(  \mathbf{z}\right)
}\right\vert +\left\vert \widetilde{\varphi_{2}\left(  \mathbf{z}\right)
}\right\rangle \left\langle \widetilde{\varphi_{2}\left(  \mathbf{z}\right)
}\right\vert \right\}  d\mu\left(  \mathbf{z}\right)
\end{equation}
The expansion relationship gives
\begin{align}
\Gamma_{1}^{2}\left(  P_{\mathcal{H}^{1}}\right)   &  =\Gamma_{1}^{2}\left(
\frac{1}{r}\int u\left(  \mathbf{z}\right)  \left\{  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi_{2}\right\vert \right\}  u\left(
\mathbf{z}\right)  ^{\dagger}d\mu\left(  \mathbf{z}\right)  \right)
\nonumber\\
&  =\frac{1}{r}\int u\left(  \mathbf{z}\right)  \Gamma_{1}^{2}\left(
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
+\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
\right)  u\left(  \mathbf{z}\right)  ^{\dagger}d\mu\left(  \mathbf{z}\right)
\nonumber\\
&  =P_{\mathcal{H}^{2}},
\end{align}
which can be reexpressed as
\begin{align}
&  \Gamma_{2}\left(  \frac{1}{r}\int\left\{  \left\vert \widetilde{\varphi
_{1}\left(  \mathbf{z}\right)  }\right\rangle \left\langle \widetilde{\varphi
_{1}\left(  \mathbf{z}\right)  }\right\vert +\left\vert \widetilde{\varphi
_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle \widetilde{\varphi
_{2}\left(  \mathbf{z}\right)  }\right\vert \right\}  d\mu\left(
\mathbf{z}\right)  \right) \nonumber\\
&  =\frac{1}{2}\int\left\vert \widetilde{\varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  }\right\vert d\mu\left(  \mathbf{z}\right)  .
\end{align}
Applying this to two particle operators one obtains
\begin{align}
&  \left(  \left.  \int\left\vert \widetilde{\varphi_{1}\left(  \mathbf{z}%
\right)  \varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  }\right\vert d\mu\left(  \mathbf{z}\right)  \right\vert
X\right)  _{\mathcal{F}}\nonumber\\
&  =\frac{2}{r}\left(  \left.  \Gamma_{2}\left(  \int\left\{  \left\vert
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  }\right\vert +\left\vert
\widetilde{\varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{2}\left(  \mathbf{z}\right)  }\right\vert \right\}
d\mu\left(  \mathbf{z}\right)  \right)  \right\vert X\right)  _{\mathcal{F}%
}\nonumber\\
&  =\frac{2}{r}\left(  \left.  \int\left\{  \left\vert \widetilde{\varphi
_{1}\left(  \mathbf{z}\right)  }\right\rangle \left\langle \widetilde{\varphi
_{1}\left(  \mathbf{z}\right)  }\right\vert +\left\vert \widetilde{\varphi
_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle \widetilde{\varphi
_{2}\left(  \mathbf{z}\right)  }\right\vert \right\}  d\mu\left(
\mathbf{z}\right)  \right\vert L_{1}\left(  X\right)  \right)  _{\mathcal{F}}.
\end{align}
The Q-symbol for the two particle operator $X$ is given as
\begin{equation}
\left(  \left.  \left\vert \widetilde{\varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  }\right\vert \right\vert X\right)  =\operatorname*{Tr}%
\left\{  \left\vert \widetilde{\varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  }\right\vert X\right\}  =Q_{X}\left(  \mathbf{z}\right)  ,
\end{equation}
and%
\begin{align}
&  \frac{1}{r}\left(  \left.  \Gamma_{2}\left(  \left\{  \left\vert
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{1}\left(  \mathbf{z}\right)  }\right\vert +\left\vert
\widetilde{\varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle
\widetilde{\varphi_{2}\left(  \mathbf{z}\right)  }\right\vert \right\}
\right)  \right\vert X\right)  _{\mathcal{F}}\nonumber\\
&  =\frac{1}{r}\left(  \left.  \left\{  \left\vert \widetilde{\varphi
_{1}\left(  \mathbf{z}\right)  }\right\rangle \left\langle \widetilde{\varphi
_{1}\left(  \mathbf{z}\right)  }\right\vert +\left\vert \widetilde{\varphi
_{2}\left(  \mathbf{z}\right)  }\right\rangle \left\langle \widetilde{\varphi
_{2}\left(  \mathbf{z}\right)  }\right\vert \right\}  \right\vert L_{1}\left(
X\right)  \right)  _{\mathcal{F}}\nonumber\\
&  =\frac{1}{2r}\left(  \left.  \left\vert \widetilde{\varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  }\right\rangle
\left\langle \widetilde{\varphi_{1}\left(  \mathbf{z}\right)  \varphi
_{2}\left(  \mathbf{z}\right)  }\right\vert \right\vert X\right)
_{\mathcal{F}}=\frac{1}{2r}Q_{X}\left(  \mathbf{z}\right)  .\rfloor
\end{align}


The isotropy group of a state $\left\vert \Phi\right\rangle $ is
\begin{equation}
U_{\Phi}=\left\{  \left.  u\right\vert u\in U\left(  \mathcal{H}_{\mathcal{F}%
}\right)  ,u\left\vert \Phi\right\rangle =e^{i\theta\left(  u\right)
}\left\vert \Phi\right\rangle \right\}  .
\end{equation}
For decomposable pure number states the isotropy groups are $U\left(
N\right)  \times U\left(  r-N\right)  \subset U\left(  r\right)  ,$ in
particular we focus on $N=2$ and in the Fock representation any $u\in U\left(
r\right)  $ can be factored through $U\left(  2\right)  \times U\left(
r-2\right)  $ as
\begin{equation}
u\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)  ,\beta}\right)  =c\left(
\mathbf{z}\right)  h\left(  \mathbf{\alpha}\left(  \mathbf{z}\right)  \right)
c\left(  -\mathbf{z}\right)  ^{\dagger}k\left(  \mathbf{\beta}\right)  .
\end{equation}
The restrictions of $U\left(  r\right)  $ to $\mathcal{H}^{N}$ are
\begin{align}
\left.  u\right\vert _{\mathcal{H}^{1}}  &  =u_{1}=P_{\mathcal{H}^{1}%
}uP_{\mathcal{H}^{1}}\\
\left.  u\right\vert _{\mathcal{H}^{2}}  &  =u_{1}\wedge u_{1}=P_{\mathcal{H}%
^{2}}uP_{\mathcal{H}^{2}}\\
&  \vdots\\
\left.  u\right\vert _{\mathcal{H}^{N}}  &  =\wedge^{N}u_{1}=P_{\mathcal{H}%
^{N}}uP_{\mathcal{H}^{N}}\\
&  \vdots
\end{align}
In particular
\begin{align}
u\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)  ,\beta}\right)  \left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =c\left(  \mathbf{z}\right)  h\left(
\mathbf{\alpha}\left(  \mathbf{z}\right)  \right)  \left\vert \varphi
_{1}\varphi_{2}\right\rangle =u_{1}\wedge u_{1}\left\vert \varphi_{1}%
\varphi_{2}\right\rangle =\left\vert u_{1}\varphi_{1}u_{1}\varphi
_{2}\right\rangle \\
&  =\left\vert \left[  c\left(  \mathbf{z}\right)  _{1}h\left(  \mathbf{\alpha
}\left(  \mathbf{z}\right)  \right)  _{1}\varphi_{1}\right]  \left[  c\left(
\mathbf{z}\right)  _{1}h\left(  \mathbf{\alpha}\left(  \mathbf{z}\right)
\right)  _{1}\varphi_{2}\right]  \right\rangle
\end{align}%
\begin{equation}
u\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)  ,\beta}\right)
a_{1}^{\dagger}a_{2}^{\dagger}u\left(  \mathbf{z,\alpha\left(  \mathbf{z}%
\right)  ,\beta}\right)  ^{\dagger}\left\vert \phi\right\rangle =c\left(
\mathbf{z}\right)  h\left(  \mathbf{\alpha}\left(  \mathbf{z}\right)  \right)
a_{1}^{\dagger}a_{2}^{\dagger}h\left(  \mathbf{\alpha}\left(  \mathbf{z}%
\right)  \right)  ^{\dagger}c\left(  \mathbf{z}\right)  ^{\dagger}\left\vert
\phi\right\rangle
\end{equation}
giving
\begin{equation}
c\left(  -\mathbf{z}\right)  ^{\dagger}k\left(  \mathbf{\beta}\right)
a_{1}^{\dagger}a_{2}^{\dagger}k\left(  \mathbf{\beta}\right)  ^{\dagger
}c\left(  -\mathbf{z}\right)  =a_{1}^{\dagger}a_{2}^{\dagger}%
\end{equation}
$\rfloor$

In particular the coset
\begin{equation}
c\left(  \mathbf{z}\right)  =\exp\left\{  \sum\limits_{\substack{1\leq
h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}a_{h}\right\}  ,\nonumber
\end{equation}
acting on the reference state in $\mathcal{H}^{2}$ is given by%
\begin{align}
c\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\varphi_{2}\right\rangle  &
=\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\rangle =\left\vert c\left(  \mathbf{z}\right)
\varphi_{1}c\left(  \mathbf{z}\right)  \varphi_{2}\right\rangle =\nonumber\\
&  \left\vert \varphi_{1}\varphi_{2}\right\rangle +\sum\limits_{3\leq p\leq
r}\left\{  z_{p1}\left\vert \varphi_{p}\varphi_{2}\right\rangle +z_{p2}%
\left\vert \varphi_{1}\varphi_{p}\right\rangle \right\}  +\sum\limits_{3\leq
p_{1},p_{2}\leq r}z_{p_{1}1}z_{p_{2}2}\left\vert \varphi_{p_{1}}\varphi
_{p_{2}}\right\rangle ,
\end{align}
while acting on an occupied state in $\mathcal{H}^{1}$
\begin{align}
&  \exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}%
}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert \exp\left\{  \sum\limits_{\substack{1\leq
h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}a_{h}\right\} \nonumber\\
&  =\left\{  I_{\mathcal{H}_{\mathcal{F}}}+\sum\limits_{3\leq p\leq r}%
z_{ph}a_{p}^{\dagger}a_{1}\right\}  \left\vert \varphi_{1}\right\rangle
\left\langle \varphi_{1}\right\vert \left\{  I_{\mathcal{H}_{\mathcal{F}}%
}+\sum\limits_{3\leq p\leq r}z_{ph}a_{p}^{\dagger}a_{1}\right\} \nonumber\\
&  =\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
+\sum\limits_{3\leq p\leq r}z_{p1}\left\vert \varphi_{p}\right\rangle
\left\langle \varphi_{1}\right\vert +\sum\limits_{3\leq p\leq r}\bar{z}%
_{p1}\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{p}\right\vert
+\sum\limits_{3\leq p,p^{\prime}\leq r}z_{p^{\prime}1}\bar{z}_{p1}\left\vert
\varphi_{p^{\prime}}\right\rangle \left\langle \varphi_{p}\right\vert ,
\end{align}
and
\begin{align}
&  \exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}%
}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \left\vert \varphi_{j}\right\rangle
=\left\{  I_{\mathcal{H}_{\mathcal{F}}}+\sum\limits_{\substack{1\leq
h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \left\vert
\varphi_{j}\right\rangle \nonumber\\
&  =\left\{
\begin{array}
[c]{c}%
\left\vert \varphi_{1}\right\rangle +\sum\limits_{3\leq p\leq r}%
z_{p1}\left\vert \varphi_{p}\right\rangle \\
\left\vert \varphi_{2}\right\rangle +\sum\limits_{3\leq p\leq r}%
z_{p2}\left\vert \varphi_{p}\right\rangle \\
\left\vert \varphi_{j}\right\rangle ,j\neq1,2
\end{array}
\right.  .
\end{align}
The norm of a general decomposable geminal is given by
\begin{align}
\left\Vert a\wedge b\right\Vert ^{2}  &  =\left\langle a\wedge b\left\vert
a\wedge b\right.  \right\rangle =\left\langle \left\{  a\otimes b-b\otimes
a\right\}  \left\vert \left\{  a\otimes b-b\otimes a\right\}  \right.
\right\rangle \nonumber\\
&  =\left\{  \left\langle a\left\vert a\right.  \right\rangle \left\langle
b\left\vert b\right.  \right\rangle -\left\langle a\left\vert b\right.
\right\rangle \left\langle b\left\vert a\right.  \right\rangle -\left\langle
b\left\vert a\right.  \right\rangle \left\langle a\left\vert b\right.
\right\rangle +\left\langle a\left\vert a\right.  \right\rangle \left\langle
b\left\vert b\right.  \right\rangle \right\} \nonumber\\
&  =2\left\{  \left\langle a\left\vert a\right.  \right\rangle \left\langle
b\left\vert b\right.  \right\rangle -\left\langle a\left\vert b\right.
\right\rangle \left\langle b\left\vert a\right.  \right\rangle \right\}
\nonumber\\
&  =2\det\left(
\begin{array}
[c]{cc}%
\left\langle a\left\vert a\right.  \right\rangle  & \left\langle a\left\vert
b\right.  \right\rangle \\
\left\langle b\left\vert a\right.  \right\rangle  & \left\langle b\left\vert
b\right.  \right\rangle
\end{array}
\right)  ,
\end{align}
thus noting for $h=1,2$ one has
\begin{align}
&  \left\langle \varphi_{h}\left(  \mathbf{z}\right)  \left\vert \varphi
_{h}\left(  \mathbf{z}\right)  \right.  \right\rangle =\left\Vert \varphi
_{h}\left(  \mathbf{z}\right)  \right\Vert ^{2}=\nonumber\\
&  \left\langle \left(  \varphi_{h}+\sum\limits_{3\leq p\leq r}z_{p1}%
\varphi_{p}\right)  \left\vert \left(  \varphi_{h}+\sum\limits_{3\leq p\leq
r}z_{p1}\varphi_{p}\right)  \right.  \right\rangle =1+\sum\limits_{3\leq p\leq
r}\bar{z}_{ph}z_{ph}=1+\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)
_{hh}\nonumber
\end{align}
and
\begin{equation}
\left\langle \varphi_{1}\left(  \mathbf{z}\right)  \left\vert \varphi
_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle =\sum\limits_{3\leq
p\leq r}\bar{z}_{p1}z_{p2}%
\end{equation}
one obtains
\begin{align}
&  \left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle =\det\left(
\begin{array}
[c]{cc}%
\left\langle \varphi_{1}\left(  \mathbf{z}\right)  \left\vert \varphi
_{1}\left(  \mathbf{z}\right)  \right.  \right\rangle  & \left\langle
\varphi_{1}\left(  \mathbf{z}\right)  \left\vert \varphi_{2}\left(
\mathbf{z}\right)  \right.  \right\rangle \\
\left\langle \varphi_{2}\left(  \mathbf{z}\right)  \left\vert \varphi
_{1}\left(  \mathbf{z}\right)  \right.  \right\rangle  & \left\langle
\varphi_{2}\left(  \mathbf{z}\right)  \left\vert \varphi_{2}\left(
\mathbf{z}\right)  \right.  \right\rangle
\end{array}
\right)  =\nonumber\\
&  \det\left(
\begin{array}
[c]{cc}%
1+\sum\limits_{3\leq p\leq r}\bar{z}_{p1}z_{p1} & \sum\limits_{3\leq p\leq
r}\bar{z}_{p1}z_{p2}\\
\sum\limits_{3\leq p\leq r}z_{p1}\bar{z}_{p2} & 1+\sum\limits_{3\leq p\leq
r}\bar{z}_{p2}z_{p2}%
\end{array}
\right)  =\det\left(
\begin{array}
[c]{cc}%
1+\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)  _{11} & \left(
\mathbf{z}^{\dagger}\mathbf{z}\right)  _{12}\\
\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)  _{21} & 1+\left(
\mathbf{z}^{\dagger}\mathbf{z}\right)  _{22}%
\end{array}
\right) \nonumber\\
&  =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ,
\end{align}
where
\begin{equation}
\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\rangle =\frac{1}{\sqrt{2}}\left\vert \varphi
_{1}\left(  \mathbf{z}\right)  \wedge\varphi_{2}\left(  \mathbf{z}\right)
\right\rangle .
\end{equation}
Dividing by this norm gives normalized CS's in $\mathcal{H}^{2}$ but not in
$\mathcal{H}^{1}$ where normalized CS's must be defined as
\begin{equation}
\left\vert \Phi_{1}\left(  \mathbf{z}\right)  \right\rangle =c_{1}\left(
1+\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)  _{11}\right)  ^{-\frac{1}{2}%
}\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \right\rangle +c_{2}\left(
1+\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)  _{22}\right)  ^{-\frac{1}{2}%
}\left\vert \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle .
\end{equation}


The CS$\ \left\vert \mathbf{z}\right\rangle =\left\vert \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle $ can
be expanded in a single and double excitation form as
\begin{align}
&  \left\vert \mathbf{z}\right\rangle =\sum_{1\leq j<k\leq r}\left\langle
\varphi_{j}\varphi_{k}\left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle \left\vert
\varphi_{j}\varphi_{k}\right\rangle \nonumber\\
&  \left.  =\right.  \sum_{1\leq j<k\leq r}\left\langle \varphi_{j}\varphi
_{k}\left\vert
\begin{array}
[c]{c}%
\left\vert \varphi_{1}\varphi_{2}\right\rangle +\sum\limits_{3\leq p\leq
r}\left\{  z_{p1}\left\vert \varphi_{p}\varphi_{2}\right\rangle +z_{p2}%
\left\vert \varphi_{1}\varphi_{p}\right\rangle \right\} \\
+\sum\limits_{3\leq p_{1},p_{2}\leq r}z_{p_{1}1}z_{p_{2}2}\left\vert
\varphi_{p_{1}}\varphi_{p_{2}}\right\rangle
\end{array}
\right.  \right\rangle \left\vert \varphi_{j}\varphi_{k}\right\rangle \\
&  \left\langle \varphi_{j}\varphi_{k}\left\vert \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right.
\right\rangle =\left\{
\begin{array}
[c]{c}%
1;j=1,k=2\\
z_{k2};j=1,3\leq k\leq r\\
-z_{k1};j=2,3\leq k\leq r\\
z_{j1}z_{k2}-z_{j2}z_{k1};3\leq j<k\leq r
\end{array}
\right.  .
\end{align}
Hence%
\begin{align}
\left\vert \mathbf{z}\right\rangle  &  =\left\vert \varphi_{1}\varphi
_{2}\right\rangle +\sum\limits_{3\leq k\leq r}\left\{  z_{k2}\left\vert
\varphi_{1}\varphi_{k}\right\rangle +z_{k1}\left\vert \varphi_{k}\varphi
_{2}\right\rangle \right\} \nonumber\\
&  +\frac{1}{2}\sum_{3\leq j<k\leq r}\det\left(
\begin{array}
[c]{cc}%
z_{j1} & z_{j2}\\
z_{k1} & z_{k2}%
\end{array}
\right)  \left\vert \varphi_{j}\varphi_{k}\right\rangle .
\end{align}


The reference IPS state is
\begin{equation}
\gamma_{2\varphi}=\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert =\gamma_{1\varphi}\wedge\gamma_{1\varphi}%
\end{equation}
and the manifold of two electron IPS's produced in $\mathcal{B}_{1sa+}\left(
\mathcal{H}^{2}\right)  $ is
\begin{align}
D_{IP}^{2}\left(  \mathbf{z}\right)   &  =\gamma_{2\varphi}\left(
\mathbf{z}\right)  =\gamma_{1\varphi}\left(  \mathbf{z}\right)  \wedge
\gamma_{1\varphi}\left(  \mathbf{z}\right) \nonumber\\
&  =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\vert
\equiv\frac{\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert }{\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle }=\left\vert \mathbf{\tilde{z}}\right\rangle \left\langle
\mathbf{\tilde{z}}\right\vert .
\end{align}
The effect of the contraction map produces the reference FORDO\
\begin{equation}
L_{2}^{1}\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \right)  =\gamma_{1\varphi}=\frac{1}%
{2}\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert \right)
\end{equation}
and the intertwining property gives
\begin{align}
&  L_{2}^{1}\left(  \frac{\left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \varphi
_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert }{\left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi
_{2}\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\left(  \mathbf{z}%
\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle }\right)
\nonumber\\
&  =L_{2}^{1}\left(  u\left(  \mathbf{z,\alpha,\beta}\right)  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert u\left(  \mathbf{z,\alpha,\beta}\right)  ^{\dagger}\right)
\nonumber\\
&  =L_{2}^{1}\left(  c\left(  \mathbf{z}\right)  \frac{\left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
}{\left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle }c\left(
\mathbf{z}\right)  ^{\dagger}\right) \nonumber\\
&  =c\left(  \mathbf{z}\right)  k\left(  \mathbf{\beta}\right)  L_{2}%
^{1}\left(  \frac{\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert }{\left\langle \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \left\vert
\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right.  \right\rangle }\right)  k\left(  \mathbf{\beta}\right)  ^{\dagger
}c\left(  \mathbf{z}\right)  ^{\dagger}\nonumber\\
&  =\frac{1}{2}\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}%
\right)  ^{-1}c\left(  \mathbf{z}\right)  k\left(  \mathbf{\beta}\right)
\left(  \left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert \right)  k\left(  \mathbf{\beta}\right)  ^{\dagger}c\left(
\mathbf{z}\right)  ^{\dagger}\nonumber\\
&  =D_{1IP}^{2}\left(  \mathbf{z}\right)  \equiv\gamma_{1}\left(
\mathbf{z}\right)  =\frac{1}{2}\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger
}\mathbf{z}\right)  ^{-1}\left(  \left\vert \varphi_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \varphi_{1}\left(  \mathbf{z}\right)
\right\vert +\left\vert \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \varphi_{2}\left(  \mathbf{z}\right)  \right\vert \right)  .
\end{align}
Thus
\begin{align}
\gamma_{1}\left(  \mathbf{z}\right)   &  =u\left(  \mathbf{z,\alpha,\beta
}\right)  \gamma_{1}\left(  \mathbf{0}\right)  u\left(  \mathbf{z,\alpha
,\beta}\right)  ^{\dagger}\nonumber\\
&  c\left(  \mathbf{z}\right)  h\left(  \mathbf{\alpha}\right)  c\left(
-\mathbf{z}\right)  ^{\dagger}\gamma_{1}\left(  \mathbf{0}\right)  c\left(
-\mathbf{z}\right)  h\left(  \mathbf{\alpha}\right)  c\left(  \mathbf{z}%
\right)  ^{\dagger}\nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-2} & \mathbf{z}\\
\mathbb{O} & \mathbb{I}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
e^{\mathbf{\alpha}_{h}\left(  \mathbf{z}\right)  } & \mathbb{O}\\
\mathbb{O} & e^{\mathbf{\alpha}_{p}\left(  \mathbf{z}\right)  }%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-2} & \mathbb{O}\\
-\mathbf{z}^{\dagger} & \mathbb{I}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{2} & \mathbb{O}_{2,r}\\
\mathbb{O}_{r,2} & \mathbb{O}_{r-2}%
\end{array}
\right)  \times\nonumber\\
&  \times\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-2} & -\mathbf{z}\\
\mathbb{O} & \mathbb{I}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
e^{\mathbf{\alpha}_{h}\left(  \mathbf{z}\right)  } & \mathbb{O}\\
\mathbb{O} & e^{\mathbf{\alpha}_{p}\left(  \mathbf{z}\right)  }%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-2} & \mathbb{O}\\
\mathbf{z}^{\dagger} & \mathbb{I}_{2}%
\end{array}
\right)
\end{align}
and
\begin{align}
&  \left\langle \left.  \varphi_{j}\right\vert \gamma_{1}\left(
\mathbf{z}\right)  \varphi_{k}\right\rangle =\det\left(  \mathbb{I}%
_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  \left\langle \left.  \varphi
_{j}\right\vert \left\{  \left\vert \varphi_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \varphi_{1}\left(  \mathbf{z}\right)  \right\vert
+\left\vert \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\varphi_{2}\left(  \mathbf{z}\right)  \right\vert \right\}  \varphi
_{k}\right\rangle \nonumber\\
&  =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\left\langle \left.  \varphi_{j}\right\vert \left\{  \left\vert c\left(
\mathbf{z}\right)  \varphi_{1}\right\rangle \left\langle c\left(
\mathbf{z}\right)  \varphi_{1}\right\vert +\left\vert c\left(  \mathbf{z}%
\right)  \varphi_{2}\right\rangle \left\langle c\left(  \mathbf{z}\right)
\varphi_{2}\right\vert \right\}  \varphi_{k}\right\rangle \nonumber\\
&  =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\left\{  \left\langle \left.  \varphi_{j}\right\vert c\left(
\mathbf{z}\right)  \varphi_{1}\right\rangle \left\langle \left.  \varphi
_{1}\right\vert c\left(  \mathbf{z}\right)  ^{\dagger}\varphi_{k}\right\rangle
+\left\langle \left.  \varphi_{j}\right\vert c\left(  \mathbf{z}\right)
\varphi_{2}\right\rangle \left\langle \left.  \varphi_{2}\right\vert c\left(
\mathbf{z}\right)  ^{\dagger}\varphi_{k}\right\rangle \right\} \nonumber\\
&  =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\left\{  \left\langle \left.  c\left(  \mathbf{z}\right)  \varphi
_{1}\right\vert \left\vert \varphi_{k}\right\rangle \left\langle \varphi
_{j}\right\vert c\left(  \mathbf{z}\right)  \varphi_{1}\right\rangle
+\left\langle \left.  c\left(  \mathbf{z}\right)  \varphi_{2}\right\vert
\left\vert \varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert
c\left(  \mathbf{z}\right)  \varphi_{2}\right\rangle \right\}  .
\end{align}
Expanding the above product displays that IPS FORDO's\ are expressed in terms
of the $\mathbf{z}$ parameters as (this is true for any $N$)
\begin{align}
\gamma_{1}\left(  \mathbf{z}\right)  _{hh^{\prime}}  &  =\left[  \left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-1}\right]
_{hh^{\prime}};1\leq h,h^{\prime}\leq N\nonumber\\
\gamma_{1}\left(  \mathbf{z}\right)  _{pp^{\prime}}  &  =\left[
\mathbf{z}\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\mathbf{z}^{\dagger}\right]  _{pp^{\prime}};N+1\leq p,p^{\prime}\leq
r\nonumber\\
\gamma_{1}\left(  \mathbf{z}\right)  _{ph}  &  =\left[  \mathbf{z}\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-1}\right]
_{ph}\nonumber\\
\gamma_{1}\left(  \mathbf{z}\right)  _{hp}  &  =\left[  \left(  \mathbb{I}%
_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-1}\mathbf{z}^{\dagger}\right]
_{hp}.
\end{align}


The normalized Q-symbol of the two electron reference state is
\begin{align}
\tilde{Q}_{\gamma_{2\varphi}}\left(  \mathbf{z}\right)   &  =\frac
{\left\langle \mathbf{z}\left\vert \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right.
\mathbf{z}\right\rangle }{\left\langle \mathbf{z\left\vert \mathbf{z}\right.
}\right\rangle }=\left\langle \varphi_{1}\varphi_{2}\left\vert \frac
{\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
}{\left\langle \mathbf{z\left\vert \mathbf{z}\right.  }\right\rangle }\right.
\varphi_{1}\varphi_{2}\right\rangle =\gamma_{2}\left(  \mathbf{z}\right)
_{1212}\nonumber\\
&  =\left\{  \gamma_{1}\left(  \mathbf{z}\right)  _{11}\gamma_{1}\left(
\mathbf{z}\right)  _{22}-\gamma_{1}\left(  \mathbf{z}\right)  _{12}\gamma
_{1}\left(  \mathbf{z}\right)  _{21}\right\}  =\left\vert
\begin{array}
[c]{cc}%
\gamma_{1}\left(  \mathbf{z}\right)  _{11} & \gamma_{1}\left(  \mathbf{z}%
\right)  _{12}\\
\gamma_{1}\left(  \mathbf{z}\right)  _{21} & \gamma_{1}\left(  \mathbf{z}%
\right)  _{22}%
\end{array}
\right\vert \nonumber\\
&  =\left\vert
\begin{array}
[c]{cc}%
\left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\right]  _{11} & \left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger
}\mathbf{z}\right)  ^{-1}\right]  _{12}\\
\left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\right]  _{21} & \left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger
}\mathbf{z}\right)  ^{-1}\right]  _{22}%
\end{array}
\right\vert =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1},
\end{align}
which can also be expressed as
\begin{align}
\tilde{Q}_{\gamma_{2\varphi}}\left(  \mathbf{z}\right)   &  =\frac
{\left\langle \mathbf{z}\left\vert \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right.
\mathbf{z}\right\rangle }{\left\langle \mathbf{z\left\vert \mathbf{z}\right.
}\right\rangle }=\frac{\left\langle c\left(  \mathbf{z}\right)  \varphi
_{1}\varphi_{2}\left\vert \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right.  c\left(
\mathbf{z}\right)  \varphi_{1}\varphi_{2}\right\rangle }{\left\langle
\mathbf{z\left\vert \mathbf{z}\right.  }\right\rangle }\nonumber\\
&  =\frac{\left\vert \left\langle \varphi_{1}\varphi_{2}\left\vert c\left(
\mathbf{z}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle \right\vert
^{2}}{\left\langle \mathbf{z\left\vert \mathbf{z}\right.  }\right\rangle }.
\end{align}
This implies that
\begin{align}
Q_{\gamma_{2\varphi}}\left(  \mathbf{z}\right)   &  =\left\langle
\mathbf{z}\left\vert \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right.  \mathbf{z}%
\right\rangle =\left\vert \left\langle \left.  \mathbf{z}\right\vert
\varphi_{1}\varphi_{2}\right\rangle \right\vert ^{2}=\left\vert \left\langle
\left.  \varphi_{1}\varphi_{2}\right\vert c\left(  \mathbf{z}\right)
\varphi_{1}\varphi_{2}\right\rangle \right\vert ^{2}\nonumber\\
&  =\left\vert \left\langle \varphi_{1}\varphi_{2}\left\vert \exp\left\{
\sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}%
a_{h}\right\}  \varphi_{1}\varphi_{2}\right.  \right\rangle \right\vert
^{2}=1,
\end{align}
which can also be seen from the explicit expansion of the coset elements
acting on the reference state vector. The unnormalized Q-symbol of any two
particle IPS\ is given by
\begin{align}
Q_{\psi_{1}\psi_{2}}\left(  \mathbf{z}\right)   &  =\operatorname*{Tr}\left\{
\left\vert \psi_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi
_{2}\right\vert \left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert \right\}  =\left\langle \mathbf{z}\left\vert \left\vert \psi
_{1}\psi_{2}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert \right.
\mathbf{z}\right\rangle \nonumber\\
&  =\left\langle \psi_{1}\psi_{2}\left\vert \left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert \right.  \psi_{1}\psi_{2}\right\rangle
=\left\vert \left\langle \psi_{1}\psi_{2}\left\vert c\left(  \mathbf{z}%
\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle \right\vert ^{2}.
\end{align}
By the preceding construction
\begin{equation}
\left\vert \psi_{1}\psi_{2}\right\rangle =c\left(  \mathbf{z}^{\prime}\right)
\left\vert \varphi_{1}\varphi_{2}\right\rangle ,
\end{equation}
so%
\begin{align}
Q_{\psi_{1}\psi_{2}}\left(  \mathbf{z}\right)   &  =\left\vert \left\langle
c\left(  \mathbf{z}^{\prime}\right)  \varphi_{1}\varphi_{2}\left\vert c\left(
\mathbf{z}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle \right\vert
^{2}\nonumber\\
&  =\left\vert \left\langle \varphi_{1}\varphi_{2}\left\vert c\left(
\mathbf{z}^{\prime}\right)  ^{\dagger}c\left(  \mathbf{z}\right)  \varphi
_{1}\varphi_{2}\right.  \right\rangle \right\vert ^{2}.
\end{align}
One can expand the reference two electron state as
\begin{equation}
\gamma_{2\varphi}=\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}%
}\gamma_{2\varphi jklm}\left\vert \varphi_{j}\varphi_{k}\right\rangle
\left\langle \varphi_{l}\varphi_{m}\right\vert
\end{equation}
and the manifold of IPS\ states as
\begin{equation}
\gamma_{2\varphi}\left(  \mathbf{z}\right)  =\sum_{\substack{1\leq j<k\leq
r\\1\leq l<m\leq r}}\gamma_{2\varphi jklm}\left(  \mathbf{z}\right)
\left\vert \varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{l}%
\varphi_{m}\right\vert .
\end{equation}
The unnormalized Q-symbol of $\left\vert \varphi_{j}\varphi_{k}\right\rangle
\left\langle \varphi_{l}\varphi_{m}\right\vert $ is given by
\begin{align}
Q_{\varphi jklm}\left(  \mathbf{z}\right)   &  =\operatorname*{Tr}\left\{
\left\vert \varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{l}%
\varphi_{m}\right\vert \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \right\}  =\left\langle \left.  \mathbf{z}\right\vert
\varphi_{j}\varphi_{k}\right\rangle \left\langle \left.  \varphi_{l}%
\varphi_{m}\right\vert \mathbf{z}\right\rangle \nonumber\\
&  =\left\langle \left.  \varphi_{l}\varphi_{m}\right\vert \mathbf{z}%
\right\rangle \left\langle \left.  \mathbf{z}\right\vert \varphi_{j}%
\varphi_{k}\right\rangle =\gamma_{2\varphi lmjk}\left(  \mathbf{z}\right)
\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
\end{align}
thus
\begin{align}
Q_{\varphi A}\left(  \mathbf{z}\right)   &  =\sum_{\substack{1\leq j<k\leq
r\\1\leq l<m\leq r}}A_{\varphi jklm}Q_{\varphi jklm}\left(  \mathbf{z}\right)
\nonumber\\
&  =\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}A_{\varphi jklm}%
\gamma_{2\varphi lmjk}\left(  \mathbf{z}\right)  ,
\end{align}
where
\begin{equation}
A=\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}A_{\varphi jklm}\left\vert
\varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{l}\varphi
_{m}\right\vert .
\end{equation}


\subsubsection{Factorizations of $SU\left(  r\right)  $}

The Thouless Coherent States are group Coherent States produced by the coset
decomposition of
\begin{equation}
SU\left(  r\right)  =\frac{SU\left(  r\right)  }{SU\left(  2\right)  \times
SU\left(  r-2\right)  }\times\left(  SU\left(  2\right)  \times SU\left(
r-2\right)  \right)
\end{equation}
and the expression of the coset in terms of elements of $SL\left(
r,\mathbb{C}\right)  $ as
\begin{equation}
\frac{SU\left(  r\right)  }{SU\left(  2\right)  \times SU\left(  r-2\right)
}=K_{+}K_{0}K_{-};\quad K_{+},K_{0},K_{-}\subset SL\left(  r,\mathbb{C}%
\right)  ,
\end{equation}
where we consider the Fermi-Fock realization of the special unitary sub
groups
\begin{align}
\mathcal{R}_{\mathcal{H}_{\mathcal{F}}}\left(  SU\left(  2\right)  \right)
&  =\exp\left\{  i\sum\limits_{1\leq h,h^{\prime}\leq2}\beta_{hh^{\prime}%
}a_{h}^{\dagger}a_{h^{\prime}}\right\} \nonumber\\
&  =\exp\left\{  iN_{01}\left(  \beta\right)  \right\}  ;\beta_{hh^{\prime}%
}=\bar{\beta}_{h^{\prime}h}\in\mathbb{C},1\leq h\leq2\nonumber\\
\mathcal{R}_{\mathcal{H}_{\mathcal{F}}}\left(  SU\left(  r-2\right)  \right)
&  =\exp\left\{  i\sum\limits_{3\leq p,p^{\prime}\leq r}\beta_{pp^{\prime}%
}a_{p}^{\dagger}a_{p^{\prime}}\right\} \nonumber\\
&  =\exp\left\{  iN_{02}\right\}  ;\,\beta_{pp^{\prime}}=\bar{\beta
}_{p^{\prime}p}\in\mathbb{C},3\leq p\leq r
\end{align}
and the factors of the coset%
\begin{align}
\mathcal{R}_{\mathcal{H}_{\mathcal{F}}}\left(  K_{+}\left(  \mathbf{z}\right)
\right)   &  =\exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq
r}}z_{ph}a_{p}^{\dagger}a_{h}\right\}  =\exp\left\{  N_{+}\left(
\mathbf{z}\right)  \right\} \nonumber\\
\mathcal{R}_{\mathcal{H}_{\mathcal{F}}}\left(  K_{0}\left(  \mathbf{z}\right)
\right)   &  =\exp\left\{  \sum\limits_{1\leq h,h^{\prime}\leq2}%
\alpha_{hh^{\prime}}\left(  \mathbf{z}\right)  a_{h}^{\dagger}a_{h^{\prime}%
}+\sum\limits_{3\leq p,p^{\prime}\leq r}\alpha_{pp^{\prime}}\left(
\mathbf{z}\right)  a_{p}^{\dagger}a_{p^{\prime}}\right\}  =\exp\left\{
N_{0}\left(  \mathbf{z}\right)  \right\}  ,\,\nonumber\\
N_{0}\left(  \alpha\left(  \mathbf{z}\right)  \right)   &  =N_{01}\left(
\alpha\left(  \mathbf{z}\right)  \right)  +N_{02}\left(  \alpha\left(
\mathbf{z}\right)  \right)  ;\alpha_{hh^{\prime}}\left(  \mathbf{z}\right)
=\bar{\alpha}_{h^{\prime}h}\left(  \mathbf{z}\right)  ,\,\alpha_{pp^{\prime}%
}\left(  \mathbf{z}\right)  =\bar{\alpha}_{p^{\prime}p}\left(  \mathbf{z}%
\right)  \in\mathbb{C}\nonumber\\
\mathcal{R}_{\mathcal{H}_{\mathcal{F}}}\left(  K_{-}\left(  \mathbf{z}\right)
\right)   &  =\exp\left\{  -\sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq
r}}\bar{z}_{ph}a_{h}^{\dagger}a_{p}\right\}  =\exp\left\{  N_{-}\left(
\mathbf{z}\right)  \right\}  .
\end{align}
The alphas are chosen so that
\begin{align}
&  \exp\left\{  \sum\limits_{1\leq h,h^{\prime}\leq2}\alpha_{hh^{\prime}%
}\left(  \mathbf{z}\right)  a_{h}^{\dagger}a_{h^{\prime}}+\sum\limits_{3\leq
p,p^{\prime}\leq r}\alpha_{pp^{\prime}}\left(  \mathbf{z}\right)
a_{p}^{\dagger}a_{p^{\prime}}\right\}  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  =\right.
\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-\frac
{1}{2}}\left\vert \varphi_{1}\varphi_{2}\right\rangle ,
\end{align}
but notice that the betas \emph{do not }depend on $\mathbf{z.}$ The group
elements belonging to the Fock representation $\mathcal{R}_{\mathcal{H}%
_{\mathcal{F}}}\left(  SU\left(  r\right)  \right)  $ of $SU\left(  r\right)
$ can be factored as
\begin{equation}
u\left(  \mathbf{\lambda}\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)
,\beta}\right)  \right)  =u\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)
,\beta}\right)  =c\left(  \mathbf{z}\right)  h\left(  \mathbf{\alpha}\left(
\mathbf{z}\right)  \right)  c\left(  -\mathbf{z}\right)  ^{\dagger}k\left(
\mathbf{\beta}\right)  ,
\end{equation}
where%
\begin{equation}
u\left(  \mathbf{\lambda}\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)
,\beta}\right)  \right)  =\exp\left\{  \sum\limits_{1\leq j,k\leq r}%
\lambda_{jk}a_{j}^{\dagger}a_{k}\right\}  ;\lambda_{jk}=-\bar{\lambda}_{kj}\,,
\end{equation}
and
\begin{equation}
u\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)  ,\beta}\right)  u\left(
\mathbf{z,\alpha\left(  \mathbf{z}\right)  ,\beta}\right)  ^{\dagger}=c\left(
\mathbf{z}\right)  h\left(  \mathbf{\alpha}\left(  \mathbf{z}\right)  \right)
c\left(  -\mathbf{z}\right)  ^{\dagger}k\left(  \mathbf{\beta}\right)
k\left(  \mathbf{\beta}\right)  ^{\dagger}c\left(  -\mathbf{z}\right)
h\left(  \mathbf{\alpha}\left(  \mathbf{z}\right)  \right)  c\left(
\mathbf{z}\right)  ^{\dagger}=I.
\end{equation}
The set of vectors
\begin{equation}
\left\{  \left.  u\left(  \mathbf{z,\alpha\left(  \mathbf{z}\right)  ,\beta
}\right)  \left\vert \varphi_{j}\right\rangle \right\vert 1\leq j\leq
r\right\}
\end{equation}
is always a conb as the factors $h\left(  \mathbf{\alpha}\left(
\mathbf{z}\right)  \right)  c\left(  -\mathbf{z}\right)  ^{\dagger}k\left(
\mathbf{\beta}\right)  $ do effect $\left\{  \left.  \left\vert \varphi
_{j}\right\rangle \right\vert 3\leq j\leq r\right\}  ,$ in contrast to the
fact that $c\left(  -\mathbf{z}\right)  ^{\dagger}k\left(  \mathbf{\beta
}\right)  $ does not effect $\left\vert \varphi_{1}\varphi_{2}\right\rangle .$

\subsubsection{Manifold of Decomposable Pair Creators}

\subsubsection{Parametrization of Coset}

Details of the coset decomposition of $\mathcal{R}_{\mathcal{H}_{\mathcal{F}}%
}\left(  SU\left(  \mathcal{H}^{1}\right)  \right)  $ are:
\begin{align}
c\left(  \mathbf{\eta}\right)   &  =\exp\left\{  \sum\limits_{\substack{1\leq
h\leq2\\3\leq p\leq r}}\left\{  \eta_{ph}a_{p}^{\dagger}a_{h}-\bar{\eta}%
_{ph}a_{h}^{\dagger}a_{p}\right\}  \right\}  \in\mathcal{R}_{\mathcal{H}%
_{\mathcal{F}}}\left(  \frac{SU\left(  r\right)  }{SU\left(  2\right)  \times
SU\left(  r-2\right)  }\right) \\
c\left(  \mathbf{\varsigma}\right)   &  =\left(
\begin{array}
[c]{cc}%
\left(  \mathbb{I}_{r-2}-\mathbf{\varsigma\varsigma}^{\dagger}\right)
^{\frac{1}{2}} & \mathbf{\varsigma}\\
-\mathbf{\varsigma}^{\dagger} & \left(  \mathbb{I}_{2}-\mathbf{\varsigma
}^{\dagger}\mathbf{\varsigma}\right)  ^{\frac{1}{2}}%
\end{array}
\right)  \in\left.  \mathcal{R}_{\mathcal{H}_{\mathcal{F}}}\left(
\frac{SU\left(  r\right)  }{SU\left(  2\right)  \times SU\left(  r-2\right)
}\right)  \right\vert _{\mathcal{H}_{\mathbf{\varphi}}^{1}},
\end{align}
where%
\begin{equation}
\mathbf{\varsigma}=\mathbf{\eta}\frac{\sin\left(  \sqrt{\mathbf{\eta}%
^{\dagger}\mathbf{\eta}}\right)  }{\sqrt{\mathbf{\eta}^{\dagger}\mathbf{\eta}%
}}.
\end{equation}
One can show that
\begin{equation}
P_{\mathcal{H}^{2}}=\int\left\vert \mathbf{\tilde{\varsigma}}\right\rangle
\left\langle \mathbf{\tilde{\varsigma}}\right\vert d\omega\left(
\mathbf{\varsigma}\right)  =\int\left\vert \mathbf{\tilde{\varsigma}%
}\right\rangle \left\langle \mathbf{\tilde{\varsigma}}\right\vert \left(  2\pi
i\right)  ^{-2\left(  r-2\right)  }d\mathbf{\bar{\varsigma}}d\mathbf{\varsigma
},
\end{equation}
where
\begin{equation}
\left\vert \mathbf{\tilde{\varsigma}}\right\rangle =\left\vert \mathbf{\tilde
{\varsigma}}\left(  \mathbf{\bar{z},z}\right)  \right\rangle
\end{equation}
are \emph{normalized states. }($\mathbf{\tilde{\varsigma}}$ maybe are the
elements of the unitary transformation (Blaizot and Orland)?). The projected
coset representative coordinates are defined as
\begin{align}
\mathbf{z}  &  =\mathbf{\varsigma}\left(  \mathbb{I}_{2}-\mathbf{\varsigma
}^{\dagger}\mathbf{\varsigma}\right)  ^{-\frac{1}{2}},\nonumber\\
\mathbf{\varsigma}  &  =\mathbf{z}\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger
}\mathbf{z}\right)  ^{-\frac{1}{2}},\nonumber\\
\mathbb{O}  &  \leq\mathbf{\varsigma}^{\dagger}\mathbf{\varsigma}%
\leq\mathbb{I}_{2};\mathbb{O}\leq\mathbf{\varsigma\mathbf{\varsigma}^{\dagger
}}\leq\mathbb{I}_{\left(  r-2\right)  },
\end{align}
and%
\begin{align}
&  \exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}\left\{
\eta_{ph}a_{p}^{\dagger}a_{h}-\bar{\eta}_{ph}a_{h}^{\dagger}a_{p}\right\}
\right\}  =\nonumber\\
&  \exp\left\{  \sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}%
}z_{ph}a_{p}^{\dagger}a_{h}\right\}  \exp\left\{  \sum\limits_{1\leq
h,h^{\prime}\leq2}\alpha_{hh^{\prime}}\left(  \mathbf{z}\right)
a_{h}^{\dagger}a_{h^{\prime}}+\sum\limits_{3\leq p,p^{\prime}\leq r}%
\alpha_{pp^{\prime}}\left(  \mathbf{z}\right)  a_{p}^{\dagger}a_{p^{\prime}%
}\right\} \nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\times\exp\left\{
-\sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}\bar{z}_{ph}%
a_{h}^{\dagger}a_{p}\right\}
\end{align}
The representation of the last term in the $\left\vert \mathbf{\varphi
}\right\rangle $ basis of $\mathcal{H}^{1}$ is
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-2} & \mathbf{z}\\
\mathbb{O} & \mathbb{I}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
e^{\mathbf{\alpha}_{h}\left(  \mathbf{z}\right)  } & \mathbb{O}\\
\mathbb{O} & e^{\mathbf{\alpha}_{p}\left(  \mathbf{z}\right)  }%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r-2} & \mathbb{O}\\
-\mathbf{z}^{\dagger} & \mathbb{I}_{2}%
\end{array}
\right)  ,
\end{equation}
giving%
\begin{align}
\mathbf{z}  &  =\mathbf{\varsigma}\left(  \mathbb{I}_{2}-\mathbf{\varsigma
}^{\dagger}\mathbf{\varsigma}\right)  ^{-\frac{1}{2}}\nonumber\\
e^{\mathbf{\alpha}_{h}\left(  \mathbf{z}\right)  }  &  =\left(  \mathbb{I}%
_{2}-\mathbf{\varsigma}^{\dagger}\mathbf{\varsigma}\right)  ^{\frac{1}{2}%
}\nonumber\\
e^{\mathbf{\alpha}_{p}\left(  \mathbf{z}\right)  }  &  =\left(  \mathbb{I}%
_{\left(  r-2\right)  }-\mathbf{\varsigma\varsigma}^{\dagger}\right)
^{-\frac{1}{2}}%
\end{align}
thus
\begin{align}
\mathbf{\alpha}_{h}\left(  \mathbf{z}\right)   &  =\frac{1}{2}\ln\left(
\mathbb{I}_{2}-\mathbf{\varsigma}^{\dagger}\mathbf{\varsigma}\right)
\nonumber\\
\mathbf{\alpha}_{p}\left(  \mathbf{z}\right)   &  =-\frac{1}{2}\ln\left(
\mathbb{I}_{\left(  r-2\right)  }-\mathbf{\varsigma\varsigma}^{\dagger
}\right)
\end{align}
and%
\begin{align}
\mathbf{\alpha}_{h}\left(  \mathbf{z}\right)   &  =\frac{1}{2}\ln\left(
\mathbb{I}_{2}-\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-\frac{1}{2}}\mathbf{z}^{\dagger}\mathbf{z}\left(  \mathbb{I}_{2}%
+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-\frac{1}{2}}\right) \nonumber\\
\mathbf{\alpha}_{p}\left(  \mathbf{z}\right)   &  =-\frac{1}{2}\ln\left(
\mathbb{I}_{\left(  r-2\right)  }-\mathbf{\varsigma\varsigma}^{\dagger
}\right)  .
\end{align}
The IPS FORDO $\gamma_{1}\left(  \mathbf{z}\right)  $ can be expressed in
terms of $\mathbf{\varsigma}$ as
\begin{align}
\gamma_{1}\left(  \mathbf{\varsigma}\right)  _{hh^{\prime}}  &  =\left(
\mathbb{I}_{2}-\mathbf{\varsigma}^{\dagger}\mathbf{\varsigma}\right)
_{hh^{\prime}}\nonumber\\
\gamma_{1}\left(  \mathbf{\varsigma}\right)  _{pp^{\prime}}  &  =\left(
\mathbf{\varsigma}^{\dagger}\mathbf{\varsigma}\right)  _{pp^{\prime}%
}\nonumber\\
\gamma_{1}\left(  \mathbf{\varsigma}\right)  _{ph}  &  =\left[
\mathbf{\varsigma}\left(  \mathbb{I}_{2}-\mathbf{\varsigma}^{\dagger
}\mathbf{\varsigma}\right)  ^{-\frac{1}{2}}\right]  _{ph}\nonumber\\
\gamma_{1}\left(  \mathbf{\varsigma}\right)  _{hp}  &  =\left[  \left(
\mathbb{I}_{2}-\mathbf{\varsigma}^{\dagger}\mathbf{\varsigma}\right)
^{-\frac{1}{2}}\mathbf{\varsigma}^{\dagger}\right]  _{hp}.
\end{align}


This manifold generates the holomorphic representation
\begin{equation}
g\left(  \mathbf{z}\right)  =\left\langle \mathbf{\bar{z}}\left\vert g\right.
\right\rangle
\end{equation}
of $\mathcal{H}^{2}$ based on the resolution of the identity
\cite{Blaiz&Orland}
\begin{equation}
P_{\mathcal{H}^{2}}=\int\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  =\int\left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert \det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-\left(  r+1\right)
}\left(  2\pi i\right)  ^{-2\left(  r-2\right)  }d\mathbf{\bar{z}}d\mathbf{z},
\end{equation}
the vectors $\left\vert \mathbf{z}\right\rangle $ are in general
\emph{unnormalized} i.e.%
\begin{equation}
\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
=\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
\overset{\mathbf{z\neq0}}{\neq}1
\end{equation}
and the extra inverse power in the resolution of the identity accounts for
their normalization.

The holomorphic wavefunctions $g\left(  \mathbf{z}\right)  $ are defined by
\begin{equation}
\left\vert g\right\rangle =\int g\left(  \mathbf{\bar{z}}\right)  \left\vert
\mathbf{z}\right\rangle d\mu\left(  \mathbf{z}\right)
\end{equation}
and the measure is given by
\begin{equation}
d\mu\left(  \mathbf{z}\right)  =\det\left(  \mathbb{I}_{2}+\mathbf{z}%
^{\dagger}\mathbf{z}\right)  ^{-\left(  r+1\right)  }\left(  2\pi i\right)
^{-2\left(  r-2\right)  }d\mathbf{\bar{z}}d\mathbf{z,}%
\end{equation}
where
\begin{align}
\frac{d\mathbf{\bar{z}}d\mathbf{z}}{\left(  2\pi i\right)  ^{r}}  &
=\frac{d\left(  \operatorname{Re}\mathbf{z}\right)  d\left(  \operatorname{Im}%
\mathbf{z}\right)  }{\left(  2\pi\right)  ^{r}}=\frac{d\mathbf{x}d\mathbf{y}%
}{\left(  2\pi\right)  ^{r}}\nonumber\\
&  \qquad\left.  \Updownarrow\right. \nonumber\\
d\mathbf{\bar{z}}d\mathbf{z}  &  =i^{r}d\left(  \operatorname{Re}%
\mathbf{z}\right)  d\left(  \operatorname{Im}\mathbf{z}\right)  ,
\end{align}
showing that $\mu$ is positive measure. One can introduce a new measure
$\tilde{\mu}$
\begin{equation}
d\tilde{\mu}\left(  \mathbf{z}\right)  =\det\left(  \mathbb{I}_{2}%
+\mathbf{z}^{\dagger}\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)
=S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)
\end{equation}
that is absolutely continuous wrt $\mu$ such that
\begin{equation}
P_{\mathcal{H}^{2}}=\int\frac{\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert }{\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle }\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}%
\right)  d\mu\left(  \mathbf{z}\right)  =\int\widetilde{\left\vert
\mathbf{z}\right\rangle }\widetilde{\left\langle \mathbf{z}\right\vert
}d\tilde{\mu}\left(  \mathbf{z}\right)  ,
\end{equation}
where $\widetilde{\left\vert \mathbf{z}\right\rangle }$ are normalized.

The dimension of $\mathcal{H}^{2}$ is given by
\begin{align}
\operatorname*{Tr}\left\{  P_{\mathcal{H}^{2}}\right\}   &  =\binom{r}{2}%
=\int\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
d\mu\left(  \mathbf{z}\right)  =\int S\left(  \mathbf{\bar{z},z}\right)
d\mu\left(  \mathbf{z}\right)  =\int\det\left(  \mathbb{I}_{2}+\mathbf{z}%
^{\dagger}\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-r}\left(  2\pi i\right)  ^{-2\left(  r-2\right)  }d\mathbf{\bar{z}%
}d\mathbf{z,}%
\end{align}
showing that
\begin{equation}
\int\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-r}\left(  2\pi i\right)  ^{-2\left(  r-2\right)  }d\mathbf{\bar{z}%
}d\mathbf{z}=\binom{r}{2}.
\end{equation}


The reproducing kernel property (equivalent to being the integral kernel of a
projection operator) is obtained by using the resolution of the identity
\begin{equation}
P_{\mathcal{H}^{2}}=\int\left\vert \mathbf{z}^{\prime\prime}\right\rangle
\left\langle \mathbf{z}^{\prime\prime}\right\vert d\mu\left(  \mathbf{z}%
^{\prime\prime}\right)
\end{equation}
and taking the $\mathbf{z,z}^{\prime}$ matrix element to obtain
\begin{equation}
\int\left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime\prime}\right.
\right\rangle \left\langle \mathbf{z}^{\prime\prime}\left\vert \mathbf{z}%
^{\prime}\right.  \right\rangle d\mu\left(  \mathbf{z}^{\prime\prime}\right)
=\left\langle \mathbf{z}\right\vert \left\{  \int\left\vert \mathbf{z}%
^{\prime\prime}\right\rangle \left\langle \mathbf{z}^{\prime\prime}\right\vert
d\mu\left(  \mathbf{z}^{\prime\prime}\right)  \right\}  \left\vert
\mathbf{z}^{\prime}\right\rangle =\left\langle \mathbf{z}\left\vert
\mathbf{z}^{\prime}\right.  \right\rangle =\det\left(  \mathbb{I}%
_{2}+\mathbf{z}^{\dagger}\mathbf{z}^{\prime}\right)
\end{equation}
i.e.
\begin{equation}
S^{2}\left(  \mathbf{\bar{z}},\mathbf{z}^{\prime}\right)  =\int S\left(
\mathbf{\bar{z},z}^{\prime\prime}\right)  S\left(  \mathbf{\bar{z}}%
^{\prime\prime},\mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}%
^{\prime\prime}\right)  =\left\langle \mathbf{z}\right\vert \left\{
\int\left\vert \mathbf{z}^{\prime\prime}\right\rangle \left\langle
\mathbf{z}^{\prime\prime}\right\vert d\mu\left(  \mathbf{z}^{\prime\prime
}\right)  \right\}  \left\vert \mathbf{z}^{\prime}\right\rangle =S\left(
\mathbf{\bar{z}},\mathbf{z}^{\prime}\right)  .
\end{equation}


As
\begin{equation}
\left\langle g_{1}\left\vert g_{2}\right.  \right\rangle =\int\overline
{g_{1}\left(  \mathbf{z}\right)  }g_{2}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)
\end{equation}
the space $\mathcal{H}^{2}$ is isometrically isomorphic to the Hilbert space
of holomorphic wavefunctions $\mathcal{P}L_{2}\left(  \mathbb{C}^{2\left(
r-2\right)  },\mu\right)  $ that is a sub space of the space of holomorphic
functions $L_{2}\left(  \mathbb{C}^{2\left(  r-2\right)  },\mu\right)  $ i.e.
\begin{equation}
\mathcal{H}^{2}\cong\mathcal{P}L_{2}\left(  \mathbb{C}^{2\left(  r-2\right)
},\mu\right)  \subset L_{2}\left(  \mathbb{C}^{2\left(  r-2\right)  }%
,\mu\right)
\end{equation}
given by
\begin{equation}
\mathcal{P}f\left(  \mathbf{\bar{z}}\right)  =\int_{\mathbb{C}^{2\left(
r-2\right)  }}S\left(  \mathbf{\bar{z},z}^{\prime}\right)  f\left(
\mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)  ,
\end{equation}
where the reproducing kernel $S\left(  \mathbf{\bar{z},z}^{\prime}\right)  ,$
is the integral kernel of the projection operator $\mathcal{P},$ is given by
\begin{equation}
S\left(  \mathbf{\bar{z},z}^{\prime}\right)  =\left\langle \mathbf{z}%
\left\vert \mathbf{z}^{\prime}\right.  \right\rangle =\det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}^{\prime}\right)  =\overline
{S\left(  \mathbf{\bar{z}}^{\prime},\mathbf{z}\right)  }.
\end{equation}
An operator $A$ has a biholomorphic representation as
\begin{equation}
\int\left\vert \mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}%
_{1}\right\vert A\left\vert \mathbf{z}_{2}\right\rangle \left\langle
\mathbf{z}_{2}\right\vert d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(
\mathbf{z}_{2}\right)  =\int A\left(  \mathbf{\bar{z}}_{1},\mathbf{z}%
_{2}\right)  \left\vert \mathbf{z}_{1}\right\rangle \left\langle
\mathbf{z}_{2}\right\vert d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(
\mathbf{z}_{2}\right)  ,
\end{equation}
which leads to
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\int A\left(  \mathbf{\bar{z}}%
_{1},\mathbf{z}_{2}\right)  S\left(  \mathbf{\bar{z}}_{2},\mathbf{z}%
_{1}\right)  d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}%
_{2}\right)  =\int AS\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{1}\right)
d\mu\left(  \mathbf{z}_{1}\right)  ,
\end{equation}
where
\begin{equation}
AS\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{1}\right)  =\int A\left(
\mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  S\left(  \mathbf{\bar{z}}%
_{2},\mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}_{2}\right)  .
\end{equation}


\subsubsection{Thouless P and Q Symbols}

The normalized Q (covariant/Wick) symbol, $\tilde{Q}_{A},$ of an operator
$A\in\mathcal{L}\left(  \mathcal{H}^{2}\right)  $ is a biholomorphic function
defined as
\begin{equation}
\tilde{Q}_{A}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\tilde{Q}_{A}\left(
\mathbf{z}\right)  =\frac{\left\langle \mathbf{z}\left\vert A\mathbf{z}%
\right.  \right\rangle }{\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle }=\frac{\left\langle \mathbf{z}\left\vert A\mathbf{z}\right.
\right\rangle }{S\left(  \mathbf{\bar{z},z}\right)  }=\frac{Q_{A}\left(
\mathbf{z}\right)  }{S\left(  \mathbf{\bar{z},z}\right)  }%
\end{equation}
and the unnormalized as
\begin{equation}
Q_{A}\left(  \mathbf{z}\right)  =\operatorname*{Tr}\left\{  A\left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert \right\}  ,
\end{equation}
giving
\begin{equation}
Q_{A}\left(  \mathbf{z}\right)  =\tilde{Q}_{A}\left(  \mathbf{z}\right)
S\left(  \mathbf{\bar{z},z}\right)  .
\end{equation}
The P (contravariant/AntiWick) symbol is formally defined as
\begin{equation}
A=\int P_{A}\left(  \mathbf{z}\right)  \left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  .
\end{equation}
This leads to the Berezin Transformation
\begin{align}
\left[  \mathfrak{Be}\left(  P_{A}\right)  \right]  \left(  \mathbf{z}%
^{\prime}\right)   &  =Q_{A}\left(  \mathbf{z}^{\prime}\right)  =\frac
{1}{S\left(  \mathbf{\bar{z}}^{\prime}\mathbf{,z}^{\prime}\right)  }%
\int_{\mathbb{C}^{r\left(  r-2\right)  }}P_{A}\left(  \mathbf{z}\right)
\left\vert S\left(  \mathbf{\bar{z},z}^{\prime}\right)  \right\vert ^{2}%
d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int\mathfrak{Be}\left(  \mathbf{z,z}^{\prime}\right)  P_{A}\left(
\mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)  ,
\end{align}
where the Berezin integral kernel is
\begin{equation}
\mathfrak{Be}\left(  \mathbf{z,z}^{\prime}\right)  =\frac{\left\vert S\left(
\mathbf{\bar{z},z}^{\prime}\right)  \right\vert ^{2}}{S\left(  \mathbf{\bar
{z},z}\right)  }.
\end{equation}
The inverse Berezin Transformation is formally given by
\begin{equation}
\mathfrak{Be}^{-1}\left(  Q_{A}\right)  \left(  \mathbf{z}\right)
=P_{A}\left(  \mathbf{z}\right)  =\int\mathfrak{Be}^{-1}\left(  \mathbf{z,z}%
^{\prime}\right)  Q_{A}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(
\mathbf{z}^{\prime}\right)
\end{equation}
and can be expressed as \cite{Weiner}%
\begin{align}
\mathfrak{Be}^{-1}\left(  \mathbf{z,z}^{\prime}\right)   &  =\sum
_{_{\substack{1\leq l_{1}<l_{2}\leq r,\\1\leq m_{1}<m_{2}\leq r,\\1\leq
j_{1}<j_{2}\leq r,\\1\leq k_{1}<k_{2}\leq r}}}Q_{l_{1}l_{2}m_{1}m_{2}}\left(
\mathbf{z}\right)  \left(  \Delta^{-2}\right)  _{l_{1}l_{2}m_{1}m_{2}%
j_{1}j_{2}k_{1}k_{2}}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime
}\right) \nonumber\\
&  =\sum_{\substack{1\leq l_{1}<l_{2}\leq r,\\1\leq m_{1}<m_{2}\leq r,\\1\leq
j_{1}<j_{2}\leq r,\\1\leq k_{1}<k_{2}\leq r}}\gamma_{2}\left(  \mathbf{z}%
\right)  _{l_{1}l_{2}m_{1}m_{2}}\left(  \Delta^{-2}\right)  _{l_{1}l_{2}%
m_{1}m_{2}j_{1}j_{2}k_{1}k_{2}}\gamma_{2}\left(  \mathbf{z}^{\prime}\right)
_{j_{1}j_{2}k_{1}k_{2}}.
\end{align}
The Q-symbol of any operator $A\in\mathcal{L}\left(  \mathcal{H}^{2}\right)  $
is given as
\begin{equation}
Q_{A}\left(  \mathbf{z}\right)  =Q_{A}\left(  \mathbf{\bar{z},z}\right)
=\sum_{\substack{1\leq l_{1}<l_{2}\leq r,\\1\leq m_{1}<m_{2}\leq r}%
}A_{j_{1}j_{2}k_{1}k_{2}}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  ,
\end{equation}
where
\begin{align}
Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)   &  =\operatorname*{Tr}%
\left\{  \left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \right\} \nonumber\\
&  =\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\left\vert c\left(
\mathbf{z}\right)  ^{\dagger}c\left(  \mathbf{z}\right)  \varphi_{j_{1}%
}\varphi_{j_{2}}\right.  \right\rangle \nonumber\\
&  =\gamma_{2}\left(  \mathbf{z}\right)  _{j_{1}j_{2}k_{1}k_{2}}\left\langle
\varphi_{1}\varphi_{2}\left\vert c\left(  \mathbf{z}\right)  ^{\dagger
}c\left(  \mathbf{z}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle .
\end{align}
The P-symbol of any operator can be given in terms of its Q-symbol by using
\begin{align}
P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)   &  =\sum_{\substack{1\leq
l_{1}<l_{2}\leq r,\\1\leq m_{1}<m_{2}\leq r}}\operatorname*{Tr}\left\{
\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right\}  \left(  \Delta
^{-1}\right)  _{l_{1}l_{2}m_{1}m_{2}j_{1}j_{2}k_{1}k_{2}}\nonumber\\
&  =\sum_{\substack{1\leq l_{1}<l_{2}\leq r,\\1\leq m_{1}<m_{2}\leq r}%
}\gamma_{2}\left(  \mathbf{z}\right)  _{m_{1}m_{2}l_{1}l_{2}}\left(
\Delta^{-1}\right)  _{l_{1}l_{2}m_{1}m_{2}j_{1}j_{2}k_{1}k_{2}},
\end{align}
where%
\begin{align}
&  \Delta_{l_{1}l_{2}m_{1}m_{2}j_{1}j_{2}k_{1}k_{2}}=\int\overline
{\operatorname*{Tr}\left\{  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle
\left\langle \varphi_{m_{1}}\varphi_{m_{2}}\right\vert \right\}
}\operatorname*{Tr}\left\{  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert \right\}  d\mu\left(
\mathbf{z}\right) \nonumber\\
&  =\int\overline{\gamma_{2}\left(  \mathbf{z}\right)  }_{m_{1}m_{2}l_{1}%
l_{2}}\gamma_{2}\left(  \mathbf{z}\right)  _{j_{1}j_{2}k_{1}k_{2}}d\mu\left(
\mathbf{z}\right)  ,
\end{align}
as
\begin{equation}
P_{A}\left(  \mathbf{z}\right)  =\sum_{\substack{1\leq l_{1}<l_{2}\leq
r,\\1\leq m_{1}<m_{2}\leq r}}A_{j_{1}j_{2}k_{1}k_{2}}P_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  .
\end{equation}
\qquad\qquad

We note that
\begin{equation}
P_{\mathcal{H}^{2}}=\int\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  =\int\frac{\left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert }{\left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle }\det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  =\int\widetilde{\left\vert \mathbf{z}\right\rangle
}\widetilde{\left\langle \mathbf{z}\right\vert }d\tilde{\mu}\left(
\mathbf{z}\right)  ,
\end{equation}
where
\begin{equation}
d\mu\left(  \mathbf{z}\right)  =\left\langle \mathbf{z}\left\vert
\mathbf{z}\right.  \right\rangle ^{-1}d\tilde{\mu}\left(  \mathbf{z}\right)
=\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}d\tilde{\mu}\left(  \mathbf{z}\right)
\end{equation}
and hence
\begin{equation}
d\tilde{\mu}\left(  \mathbf{z}\right)  =\det\left(  \mathbb{I}_{2}%
+\mathbf{z}^{\dagger}\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  .
\end{equation}
The trace of the operator $A$ is given by
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\operatorname*{Tr}\left\{
AP_{\mathcal{H}^{2}}\right\}  =\operatorname*{Tr}\left\{  A\int\left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert d\mu\left(
\mathbf{z}\right)  \right\}  =\int Q_{A}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  =\int\tilde{Q}_{A}\left(  \mathbf{z}\right)  d\tilde{\mu
}\left(  \mathbf{z}\right)  .
\end{equation}
If $P_{A}\left(  \mathbf{z}\right)  $ exists then
\begin{equation}
A=\int P_{A}\left(  \mathbf{z}\right)  \widetilde{\left\vert \mathbf{z}%
\right\rangle }\widetilde{\left\langle \mathbf{z}\right\vert }d\tilde{\mu
}\left(  \mathbf{z}\right)  =\int P_{A}\left(  \mathbf{z}\right)
\frac{\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
}{\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle }%
d\tilde{\mu}\left(  \mathbf{z}\right)  =\int P_{A}\left(  \mathbf{z}\right)
\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
^{-1}d\tilde{\mu}\left(  \mathbf{z}\right)  =\int P_{A}\left(  \mathbf{z}%
\right)  \left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
d\mu\left(  \mathbf{z}\right)  ,
\end{equation}
(i.e. the P-symbol is \emph{the same} if the measure and states change) and
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\int P_{A}\left(  \mathbf{z}\right)
d\tilde{\mu}\left(  \mathbf{z}\right)  =\int P_{A}\left(  \mathbf{z}\right)
S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)  =\int
Q_{A}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  =\int\tilde
{Q}_{A}\left(  \mathbf{z}\right)  d\tilde{\mu}\left(  \mathbf{z}\right)  .
\end{equation}
The P and Q-symbols form a biorthogonal bases
\begin{equation}
\left(  \left.  Q_{j_{1}j_{2}k_{1}k_{2}}\right\vert P_{A}\right)  =\left(
\left.  Q_{A}\right\vert P_{j_{1}j_{2}k_{1}k_{2}}\right)  =A_{j_{1}j_{2}%
k_{1}k_{2}},
\end{equation}
where
\begin{equation}
\left(  \left.  Q\right\vert P\right)  =\int\overline{Q\left(  \mathbf{z}%
\right)  }P\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  .
\end{equation}
In terms of P and Q symbols the $N$-fermion energy functional can be expressed
as
\begin{equation}
E_{N}\left(  D_{2}\right)  =\int Q_{D_{2}}\left(  \mathbf{z}\right)
P_{K_{2N}}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  =\int
Q_{K_{2N}}\left(  \mathbf{z}\right)  P_{D_{2}}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  ,
\end{equation}
which comes from the general trace product expression for self adjoint trace
class operators
\begin{equation}
\operatorname*{Tr}\left\{  AB\right\}  =\int\overline{Q_{B}\left(
\mathbf{z}\right)  }P_{A}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}%
\right)  =\int\overline{Q_{A}\left(  \mathbf{z}\right)  }P_{B}\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  .\nonumber
\end{equation}
Hence $Q_{A}\mathbf{\in}L_{\infty}\left(  \mathbb{C}^{2\left(  r-2\right)
},\mu\right)  $ and $P_{A}\mathbf{\in}L_{\infty}\left(  \mathbb{C}^{2\left(
r-2\right)  },\mu\right)  ^{d}=$ space of measures on $\mathbb{C}^{2\left(
r-2\right)  }.$ A subspace of $L_{\infty}\left(  \mathbb{C}^{2\left(
r-2\right)  },\mu\right)  ^{d}$ is $L_{1}\left(  \mathbb{C}^{2\left(
r-2\right)  },\mu\right)  $, which is the predual of $L_{\infty}\left(
\mathbb{C}^{2\left(  r-2\right)  },\mu\right)  .$ The Q-symbol of the Reduced
Hamiltonian is given by
\begin{align}
Q_{K_{2N}}\left(  \mathbf{z}\right)   &  =\frac{1}{4}\sum_{1\leq j_{1}%
,j_{2},k_{1},k_{2}\leq r}K_{2Nj_{1}j_{2}k_{1}k_{2}}\left\langle \mathbf{z}%
\left\vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}%
\mathbf{z}\right.  \right\rangle \nonumber\\
&  =\frac{1}{4}\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle \sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}K_{2Nj_{1}j_{2}%
k_{1}k_{2}}\left\{  \gamma_{1}\left(  \mathbf{z}\right)  _{j_{1}k_{1}}%
\gamma_{1}\left(  \mathbf{z}\right)  _{j_{2}k_{2}}-\gamma_{1}\left(
\mathbf{z}\right)  _{j_{1}k_{2}}\gamma_{1}\left(  \mathbf{z}\right)
_{j_{2}k_{1}}\right\}  ,
\end{align}
where%
\begin{align}
K_{2Nj_{1}j_{2}k_{1}k_{2}} &  =\frac{2}{N\left(  N-1\right)  }\eta\left(
\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}%
}\right)  \nonumber\\
&  +\frac{1}{\left(  N-1\right)  }\left(  h_{1j_{1}k_{1}}\delta_{j_{2}k_{2}%
}+h_{1j_{2}k_{2}}\delta_{j_{1}k_{1}}\right)  +\frac{1}{2}h_{2j_{1}j_{2}%
k_{1}k_{2}}.
\end{align}
The Q-symbol of any SORDO is given by
\begin{align}
Q_{D_{2}}\left(  \mathbf{z}\right)   &  =\frac{1}{4}\left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle \sum_{1\leq j_{1}%
,j_{2},k_{1},k_{2}\leq r}D_{2j_{1}j_{2}k_{1}k_{2}}\gamma_{2}\left(
\mathbf{z}\right)  _{k_{1}k_{2}j_{1}j_{2}}\nonumber\\
&  =\frac{1}{4}\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle \sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}D_{2j_{1}j_{2}%
k_{1}k_{2}}\left\{  \gamma_{1}\left(  \mathbf{z}\right)  _{j_{1}k_{1}}%
\gamma_{1}\left(  \mathbf{z}\right)  _{j_{2}k_{2}}-\gamma_{1}\left(
\mathbf{z}\right)  _{j_{1}k_{2}}\gamma_{1}\left(  \mathbf{z}\right)
_{j_{2}k_{1}}\right\}  .
\end{align}
This can also be expressed as
\begin{align}
&  Q_{D_{2}}\left(  \mathbf{z}\right)  =\left\langle \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \left\vert
D_{2}\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}%
\right)  \right.  \right\rangle =\left\langle c\left(  \mathbf{z}\right)
\varphi_{1}\varphi_{2}\left\vert D_{2}c\left(  \mathbf{z}\right)  \varphi
_{1}\varphi_{2}\right.  \right\rangle \nonumber\\
&  =\operatorname*{Tr}\left\{  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert D_{2}\right\}  =\operatorname*{Tr}\left\{  c\left(
\mathbf{z}\right)  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert c\left(  \mathbf{z}\right)  ^{\dagger
}\right\}  =f_{D_{2}}\left(  c\left(  \mathbf{z}\right)  a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}c\left(  \mathbf{z}\right)  ^{\dagger}\right)
\end{align}


\subsubsection{Reduced Operators and Symbols}%

\begin{equation}
\tilde{Q}_{X}\left(  \mathbf{z}\right)  =\operatorname*{Tr}\left\{
\widetilde{\left\vert \mathbf{z}\right\rangle }\widetilde{\left\langle
\mathbf{z}\right\vert }X\right\}  =\operatorname*{Tr}\left\{
\widetilde{\left\vert \mathbf{z}\right\rangle }\widetilde{\left\langle
\mathbf{z}\right\vert }X\right\}  =\left(  \left.  \widetilde{\left\vert
\mathbf{z}\right\rangle }\widetilde{\left\langle \mathbf{z}\right\vert
}\right\vert X\right)
\end{equation}


For any operator belonging to $\mathcal{L}\left(  \mathcal{H}^{2}\right)  $
one has
\begin{equation}
X_{2}=\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}X_{j_{1}j_{2}k_{1}k_{2}}P_{\mathcal{H}^{2}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}P_{\mathcal{H}^{2}}=\sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}X_{2j_{1}j_{2}k_{1}k_{2}%
}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert
\end{equation}
which has a Q-symbol
\begin{equation}
Q_{X_{2}}\left(  \mathbf{z}\right)  =\sum_{\substack{1\leq j_{1}<j_{2}\leq
r\\1\leq k_{1}<k_{2}\leq r}}X_{2j_{1}j_{2}k_{1}k_{2}}Q_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  =\operatorname*{Tr}\left\{  \left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert X_{2}\right\}
=\left(  \left.  \widetilde{\left\vert \mathbf{z}\right\rangle }%
\widetilde{\left\langle \mathbf{z}\right\vert }\right\vert X_{2}\right)  ,
\end{equation}
where%
\begin{align}
X_{2j_{1}j_{2}k_{1}k_{2}}  &  =\int\overline{Q_{X_{2}}\left(  \mathbf{z}%
\right)  }P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  =f_{X}\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{k_{2}}a_{k_{1}}\right)  =\operatorname*{Tr}\left\{  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert ^{\dagger}X\right\} \nonumber\\
&  =\operatorname*{Tr}\left\{  \left\vert \varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
X\right\}
\end{align}
and $f_{X}$ is defined on $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}.$ Thus
\begin{align}
X_{2}  &  =\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}X_{2j_{1}j_{2}k_{1}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
\nonumber\\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}%
}\int\overline{Q_{X_{2}}\left(  \mathbf{z}\right)  }P_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\int\overline{Q_{X_{2}}\left(  \mathbf{z}\right)  }\sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert d\mu\left(
\mathbf{z}\right)
\end{align}


The normalized Q-symbol is
\begin{align}
\tilde{Q}_{X}\left(  \mathbf{z}\right)   &  =\sum_{\substack{1\leq j_{1}%
<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq r}}X_{j_{1}j_{2}k_{1}k_{2}}\tilde
{Q}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =\operatorname*{Tr}%
\left\{  \widetilde{\left\vert \mathbf{z}\right\rangle }%
\widetilde{\left\langle \mathbf{z}\right\vert }X\right\}  \nonumber\\
&  =\left(  \left.  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
\right\vert X\right)  \nonumber\\
&  =\left(  \left.  \Gamma\left(  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert X\right)
\nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right\vert L\left(  X\right)  \right)
\nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \right\vert \right\vert L_{2}\left(  X\right)  \right)  .
\end{align}
If $X=X^{N}$ then this gives
\begin{equation}
\tilde{Q}_{X}\left(  \mathbf{z}\right)  =\tilde{Q}_{X^{N}}\left(
\mathbf{z}\right)  =\binom{N}{2}\left(  \left.  \left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert \right\vert
L_{N}^{2}\left(  X^{N}\right)  \right)  .
\end{equation}
and
\begin{equation}
N\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \right\vert L_{N}^{1}\left(  X^{N}\right)  \right)  =\frac{2}%
{N-1}\binom{N}{2}\left(  \left.  \Gamma_{1}^{2}\left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert \right\vert L_{N}^{2}\left(
X^{N}\right)  \right)
\end{equation}


One can extend $f_{X}$ to $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}$ and thus to $\Lambda_{2}$ by defining
\begin{align}
f_{X}\left(  a_{j}^{\dagger}a_{k}\right)   &  =X_{1jk}=\left(  \left.
\left\vert \varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert
\right\vert L\left(  X\right)  \right)  =\left(  \left.  \left\vert
\varphi_{j}\right\rangle \left\langle \varphi_{k}\right\vert \right\vert
L_{1}\left(  X\right)  \right)  =\left(  \left.  \left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert \right\vert X_{1}\right)
\nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}X_{j_{1}lk_{1}l}=\left(
N-1\right)  ^{-1}\sum_{1\leq l\leq r}\operatorname*{Tr}\left\{  \left\vert
\varphi_{k}\varphi_{l}\right\rangle \left\langle \varphi_{j}\varphi
_{l}\right\vert X\right\} \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\left(  \left.  \left\vert
\varphi_{j}\varphi_{l}\right\rangle \left\langle \varphi_{k}\varphi
_{l}\right\vert \right\vert X_{2}\right)  =\left(  N-1\right)  ^{-1}%
\operatorname*{Tr}\left\{  \left(  \left\vert \varphi_{k}\right\rangle
\left\langle \varphi_{j}\right\vert \wedge P_{\mathcal{H}^{1}}\right)
X\right\} \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}f_{X}\left(  a_{j}^{\dagger
}a_{l}^{\dagger}a_{l}a_{k}\right)  =\left(  N-1\right)  ^{-1}f_{X}\left(
a_{j}^{\dagger}\mathcal{N}_{1}a_{k}\right)  .
\end{align}
one obtains
\begin{align}
&  f_{X}\left(  \Phi\left(  \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{k}\left(  \mathbf{z}\right)
\right)  \right)  =X_{1jk}\left(  \mathbf{z}\right)  =\left(  \left.
\left\vert \tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right\vert
\right\vert L\left(  X\right)  \right)  =\left(  \left.  \left\vert
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right\vert \right\vert
L_{1}\left(  X\right)  \right) \nonumber\\
&  \overset{\Delta}{=}\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}%
X_{2j_{1}lk_{1}l}\left(  \mathbf{z}\right)  =\left(  N-1\right)  ^{-1}%
\sum_{1\leq l\leq r}\operatorname*{Tr}\left\{  \left\vert \tilde{\varphi}%
_{k}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right\vert X_{2}\right\}
\nonumber\\
&  =\left(  N-1\right)  ^{-1}\operatorname*{Tr}\left\{  \left(  \left\vert
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right\vert \wedge
P_{\mathcal{H}^{1}}\right)  X\right\} \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}f_{X}\left(  \Phi\left(
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(
\tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(
\tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)  \Phi\left(
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right)  \right) \nonumber\\
&  =\left(  N-1\right)  ^{-1}f_{X}\left(  \Phi\left(  \tilde{\varphi}%
_{j}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\mathcal{N}_{1}\Phi\left(
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right)  \right) \nonumber\\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \sum_{1\leq l\leq r}\left\vert
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{k}\left(
\mathbf{z}\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right\vert
\right\vert X_{2}\right) \nonumber\\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \sum_{1\leq l\leq r}\left\vert
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right\vert \wedge
P_{\mathcal{H}^{1}}\right\vert X_{2}\right)  .
\end{align}
Thus
\begin{align}
&  f_{X}\left(  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right)  \right)  =\left(  N-1\right)  ^{-1}\left\{  \left(  \left.
\overset{}{\left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert }\right\vert X_{2}\right)  \right. \nonumber\\
&  \left.  +\left(  \left.  \sum_{3\leq l\leq r}\left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right\vert \right\vert
X_{2}\right)  \right\} \nonumber\\
&  =\left(  N-1\right)  ^{-1}\left\{  \tilde{Q}_{X_{2}}\left(  \mathbf{z}%
\right)  +\sum_{3\leq l\leq r}\left(  \left.  \overset{}{\left\vert
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right\vert
}\right\vert X_{2}\right)  \right\} \nonumber\\
&  =\left(  N-1\right)  ^{-1}\left\{  \tilde{Q}_{X_{2}}\left(  \mathbf{z}%
\right)  +\sum_{3\leq l\leq r}\left(  \left.  \overset{}{u\left(
\mathbf{z}\right)  \left\vert \varphi_{1}\varphi_{l}\right\rangle \left\langle
\varphi_{1}\varphi_{l}\right\vert u\left(  \mathbf{z}\right)  ^{\dagger}%
}\right\vert X_{2}\right)  \right\}
\end{align}
The projector onto $\mathcal{H}^{2}$ is given by
\begin{align}
P_{\mathcal{H}^{2}}  &  =\sum_{1\leq j_{1}<j_{2}\leq r}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert =\int\left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert S\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right) \\
&  =\int\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \varphi_{2}\left(
\mathbf{z}\right)  \varphi_{1}\left(  \mathbf{z}\right)  \right\vert
d\mu\left(  \mathbf{z}\right)
\end{align}
Hence%
\begin{align}
P_{\mathcal{H}^{2}}P_{\mathcal{H}^{2}}  &  =\sum_{1\leq j_{1}<j_{2}\leq
r}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \int\left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert S\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \\
&  =\sum_{1\leq j_{1}<j_{2}\leq r}\int\left\vert \varphi_{j_{1}}\varphi
_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\left\vert
u\left(  \mathbf{z}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle
\left\langle \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert S\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  =P_{\mathcal{H}^{2}}.
\end{align}%
\begin{equation}
X_{1j_{1}k_{1}}=\sum_{1\leq l\leq r}X_{j_{1}lk_{1}l}=\int\overline{\tilde
{Q}_{X}\left(  \mathbf{z}\right)  }\sum_{1\leq l\leq r}P_{j_{1}lk_{1}l}\left(
\mathbf{z}\right)  S\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)
\end{equation}%
\begin{align}
&  Q_{X_{1}}\left(  \mathbf{z}\right)  \overset{\Delta}{=}\sum
_{\substack{1\leq j_{1},k_{1}\leq r\\1\leq l\leq r}}X_{j_{1}lk_{1}l}%
Q_{j_{1}lk_{1}l}\left(  \mathbf{z}\right)  =\operatorname*{Tr}\left\{
\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
\Gamma_{1}^{2}\left(  X_{1}\right)  \right\}  =\operatorname*{Tr}\left\{
L_{2}^{1}\left(  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \right)  X_{1}\right\} \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert }\right\vert \Gamma_{1}^{2}\left(  X_{1}\right)
\right)  =\left(  \left.  \overset{}{\left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert }\right\vert \Gamma_{1}^{2}\left(
X_{1}\right)  \right)  =\left(  \left.  \overset{}{L_{2}^{1}\left(  \left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert \right)
}\right\vert L_{2}^{1}\left(  X_{2}\right)  \right) \nonumber\\
&  =\left(  \left.  \overset{}{\Gamma_{1}^{2}\circ L_{2}^{1}\left(  \left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert \right)
}\right\vert X_{2}\right)  =\left(  \left.  \overset{}{\left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert }\right\vert
\Gamma_{1}^{2}\circ L_{2}^{1}\left(  X_{2}\right)  \right)  =Q_{\Gamma_{1}%
^{2}\circ L_{2}^{1}\left(  X_{2}\right)  }\left(  \mathbf{z}\right)
\nonumber\\
X_{1}  &  =\sum_{\substack{1\leq l\leq r\\1\leq j,k\leq r}}X_{2jlkl}\left\vert
\varphi_{k}\right\rangle \left\langle \varphi_{j}\right\vert =N\sum_{1\leq
j,k\leq r}L_{2}^{1}\left(  X_{2}\right)  _{kj}\left\vert \varphi
_{k}\right\rangle \left\langle \varphi_{j}\right\vert \nonumber\\
\Gamma_{1}^{2}\left(  X_{1}\right)   &  =X_{1}\wedge P_{\mathcal{H}^{1}}%
\end{align}
This gives
\begin{align}
f_{X_{1}}\left(  a_{j}^{\dagger}a_{k}\right)   &  =\left(  N-1\right)
^{-1}\int\sum_{1\leq l\leq r}\overline{P_{j_{1}lk_{1}l}\left(  \mathbf{z}%
\right)  }Q_{X}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \\
&  =\left(  N-1\right)  ^{-1}\int\overline{P_{X}\left(  \mathbf{z}\right)
}\sum_{1\leq l\leq r}Q_{j_{1}lk_{1}l}\left(  \mathbf{z}\right)  .
\end{align}
$\lceil$%
\begin{equation}
Q_{X_{1}}\left(  \mathbf{z}\right)  =\left(  N-1\right)  ^{-1}%
\operatorname*{Tr}\left\{  \left(  \left\vert \Phi_{1}\left(  \mathbf{z}%
\right)  \right\rangle \left\langle \Phi_{1}\left(  \mathbf{z}\right)
\right\vert \wedge P_{\mathcal{H}^{1}}\right)  X\right\}  \rfloor?
\end{equation}


One can also consider
\begin{align}
\operatorname*{Tr}\left\{  X\right\}   &  =\int Q_{X}\left(  \mathbf{z}%
\right)  S\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  =\int
Q_{X}\left(  \mathbf{z}\right)  d\tilde{\mu}\left(  \mathbf{z}\right)
=\sum_{1\leq j<k\leq r}f_{X}\left(  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}%
a_{j}\right)  =f_{X}\left(  \mathcal{N}_{2}\right) \nonumber\\
&  =\sum_{1\leq j<k\leq r}\int\overline{Q_{X}\left(  \mathbf{z}\right)
}P_{jkjk}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  =\int%
\sum_{1\leq j<k\leq r}\overline{Q_{X}\left(  \mathbf{z}\right)  }%
P_{jkjk}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int\sum_{1\leq j<k\leq r}\overline{\tilde{Q}_{X}\left(  \mathbf{z}%
\right)  }P_{jkjk}\left(  \mathbf{z}\right)  S\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  =\int\sum_{1\leq j<k\leq r}\overline{\tilde
{Q}_{X}\left(  \mathbf{z}\right)  }P_{jkjk}\left(  \mathbf{z}\right)
d\tilde{\mu}\left(  \mathbf{z}\right)
\end{align}
hence%
\begin{equation}
\sum_{1\leq j<k\leq r}P_{jkjk}\left(  \mathbf{z}\right)  =S\left(
\mathbf{z}\right)  ,
\end{equation}
thus is a partition of unity wrt the measure $\tilde{\mu}$.

\subsection{ \textbf{Necessary and Sufficient Conditions}}%

\begin{align}
&  1\geq Q_{\Gamma_{1}^{2}\circ L_{2}^{1}\left(  D_{2}\right)  }\left(
\mathbf{z}\right)  -Q_{D_{2}}\left(  \mathbf{z}\right)  =\left[
\mathcal{L}_{\Gamma L}\left(  Q_{D_{2}}\right)  \right]  \left(
\mathbf{z}\right)  -Q_{D_{2}}\left(  \mathbf{z}\right)  \geq0\\
&  1\geq Q_{D_{2}}\left(  \mathbf{z}\right)  \geq0\\
&  1\geq\left[  \mathcal{L}_{11}\left(  Q_{D_{2}}\right)  \right]  \left(
\mathbf{z}\right)  -Q_{D_{2}}\left(  \mathbf{z}\right)  \geq0\\
&  1\geq\left[  \mathcal{L}_{22}\left(  Q_{D_{2}}\right)  \right]  \left(
\mathbf{z}\right)  -Q_{D_{2}}\left(  \mathbf{z}\right)  \geq0\\
&  \int Q_{D_{2}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z}%
,z}\right)  d\mu\left(  \mathbf{z}\right)  =\binom{N}{2}\\
&  \int Q_{D_{1}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z}%
,z}\right)  d\mu\left(  \mathbf{z}\right)  =N
\end{align}


The \textbf{Necessary and Sufficient Condition }for $N$-Representability can
be expressed in terms of Q-symbols as
\begin{align}
&  \left\Vert Q_{D_{2}}\right\Vert _{\infty}=\sup_{\mathbf{z\in}%
\mathbb{C}^{2\left(  r-2\right)  }}\left\{  \tilde{Q}_{D_{2}}\right\}
=\sup_{\mathbf{z\in}\mathbb{C}^{r\left(  r-2\right)  }}\left\{  \frac
{\left\langle \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \left\vert D_{2}\varphi_{1}\left(  \mathbf{z}\right)
\varphi_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle }{\det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  }\right\}
\leq1,\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\int Q_{D_{2}}\left(  \mathbf{z}\right)
S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)  =\binom
{N}{2},\nonumber
\end{align}%
\begin{equation}
1\geq\left(  N-1\right)  ^{-1}\int\sum_{1\leq l\leq r}\overline{P_{1l1l}%
\left(  \mathbf{z}\right)  }Q_{D_{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  -\int\overline{P_{j_{1}j_{2}j_{1}j_{2}}\left(
\mathbf{z}\right)  }Q_{D_{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  \geq0,
\end{equation}%
\begin{equation}
1\geq\int\left\{  \sum_{1\leq l\leq r}\left(  N-1\right)  ^{-1}\overline
{P_{j_{1}lj_{1}l}\left(  \mathbf{z}\right)  }-\overline{P_{j_{1}j_{2}%
j_{1}j_{2}}\left(  \mathbf{z}\right)  }\right\}  Q_{D_{2}}\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  \geq0
\end{equation}%
\begin{align}
&  1\geq\left(  N-1\right)  ^{-1}\int\sum_{1\leq l\leq r}\overline
{P_{j_{2}lj_{2}l}\left(  \mathbf{z}\right)  }Q_{D_{2}}\left(  \mathbf{z}%
\right)  d\mu\left(  \mathbf{z}\right)  +\left(  N-1\right)  ^{-1}\int%
\sum_{1\leq l\leq r}\overline{P_{j_{1}lj_{1}l}\left(  \mathbf{z}\right)
}Q_{D_{2}}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \nonumber\\
&  \left.  -\right.  \int\overline{P_{j_{1}j_{2}j_{1}j_{2}}\left(
\mathbf{z}\right)  }Q_{D_{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  \geq0,
\end{align}%
\begin{equation}
1\geq\int\left\{  \sum_{1\leq l\leq r}\left(  N-1\right)  ^{-1}\left(
\overline{P_{j_{1}lj_{1}l}\left(  \mathbf{z}\right)  }+\overline
{P_{j_{2}lj_{2}l}\left(  \mathbf{z}\right)  }\right)  -\overline{P_{j_{1}%
j_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)  }\right\}  Q_{D_{2}}\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  \geq0
\end{equation}%
\begin{equation}
1\geq\int\overline{P_{j_{1}j_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)
}Q_{D_{2}}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  \geq0
\end{equation}%
\begin{equation}
\left(  N-1\right)  ^{-1}\int\sum_{1\leq j,l\leq r}\overline{P_{jljl}\left(
\mathbf{z}\right)  }Q_{D_{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  =N.
\end{equation}
We denote the convex set of $N$-representable Q-symbols as
\begin{align}
\mathfrak{Q}_{1+N}  &  =\left\{  Q\left(  \mathbf{z}\right)  \left\vert 0\leq
Q\left(  \mathbf{z}\right)  \leq1;\int Q\left(  \mathbf{z}\right)  S\left(
\mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)  =\binom{N}%
{2}\right.  \right. \nonumber\\
&  \qquad\qquad\qquad\left.  \int\breve{Q}_{D^{2}}\left(  \mathbf{z}\right)
S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)
=N,\mathbf{z\in}\mathbb{C}^{2\left(  r-2\right)  }\right\}
\end{align}
and the unit ball wrt the supremum (uniform) norm of the Q-symbol space,
$\mathfrak{F},$ as $\mathfrak{Q}_{1}$, i.e.
\begin{equation}
\mathfrak{Q}_{1}=\left\{  Q\left(  \mathbf{z}\right)  \left\vert \left\vert
Q\left(  \mathbf{z}\right)  \right\vert \leq1,\mathbf{z\in}\mathbb{C}%
^{2\left(  r-2\right)  }\right.  \right\}  ,
\end{equation}
which is actually the unit hypercube in $\mathfrak{F}$. The extreme points,
$\operatorname*{ext}\left\{  \mathfrak{Q}_{1}\right\}  ,$ of this hypercube
are the vertices of the surface
\begin{equation}
S^{\mathbb{C}^{2\left(  r-2\right)  }}=\left\{  Q\left(  \mathbf{z}\right)
\left\vert \left\vert Q\left(  \mathbf{z}\right)  \right\vert =1,\mathbf{z\in
}\mathbb{C}^{2\left(  r-2\right)  }\right.  \right\}  ,
\end{equation}
the intersection with the positive hyperant is
\begin{equation}
\mathfrak{Q}_{1+}=\left\{  Q\left(  \mathbf{z}\right)  \left\vert 0\leq
Q\left(  \mathbf{z}\right)  \leq1,\mathbf{z\in}\mathbb{C}^{2\left(
r-2\right)  }\right.  \right\}
\end{equation}
and the positive segment of the hypersphere is
\begin{equation}
S_{+}^{\mathbb{C}^{2\left(  r-2\right)  }}=\left\{  Q\left(  \mathbf{z}%
\right)  \left\vert Q\left(  \mathbf{z}\right)  =1,\mathbf{z\in}%
\mathbb{C}^{2\left(  r-2\right)  }\right.  \right\}  .
\end{equation}
$\mathfrak{Q}_{1+}$ is the convex set of \emph{representable} Q-symbols, its
extreme points, $\operatorname*{ext}\left\{  \mathfrak{Q}_{1+}\right\}
\subset S_{+}^{\mathbb{C}^{2\left(  r-2\right)  }}$ \emph{are known }and are
the indicator functions%
\begin{equation}
P_{\Delta}\left(  \mathbf{z}\right)  =\left\{
\begin{array}
[c]{c}%
1\text{ if }z\in\Delta\subseteq\mathbb{C}^{2\left(  r-2\right)  }\\
0\text{ if }z\notin\Delta\subseteq\mathbb{C}^{2\left(  r-2\right)  }%
\end{array}
\right.  ,
\end{equation}
which are idempotents in the $w^{\ast}$-algebra formed by $L_{\infty}\left(
\mathbb{C}^{2\left(  r-2\right)  },\mu\right)  .$ However the convex set of
$N$ representable Q-symbols is
\begin{align}
\mathfrak{Q}_{1+N}  &  =\left\{  Q\left(  \mathbf{z}\right)  \left\vert 0\leq
Q\left(  \mathbf{z}\right)  \leq1;\int Q\left(  \mathbf{z}\right)  S\left(
\mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)  =\binom{N}%
{2}\right.  \right. \nonumber\\
&  \qquad\qquad\qquad\left.  \int\breve{Q}_{D^{2}}\left(  \mathbf{z}\right)
S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)
=N,\mathbf{z\in}\mathbb{C}^{2\left(  r-2\right)  }\right\}
\end{align}
and the extreme points of $\mathfrak{Q}_{1+N}$ are \emph{not} the same as the
extreme points of $\mathfrak{Q}_{1+},$ e.g. the independent particle states
$\gamma_{2}\left(  \mathbf{z}\right)  $ must be extreme points and they are
\emph{not} indicator functions in $L_{\infty}\left(  \mathbb{C}^{2\left(
r-2\right)  },\mu\right)  ,$ as
\begin{equation}
\gamma_{2}\left(  \mathbf{z}\right)  =\det\left(  \mathbb{I}_{2}%
+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-1}.
\end{equation}


The sup norm condition gives
\begin{align}
\left\vert Q_{D_{2N}}\left(  \mathbf{z}\right)  \right\vert  &  =\left\vert
\frac{1}{4}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}D_{_{2N}j_{1}j_{2}%
k_{1}k_{2}}\gamma_{2}\left(  \mathbf{z}\right)  _{k_{1}k_{2}j_{1}j_{2}%
}\right\vert \nonumber\\
&  \leq\frac{1}{4}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert
D_{_{2N}j_{1}j_{2}k_{1}k_{2}}\gamma_{2}\left(  \mathbf{z}\right)  _{k_{1}%
k_{2}j_{1}j_{2}}\right\vert \nonumber\\
&  \leq\frac{1}{4}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert
D_{_{2N}j_{1}j_{2}k_{1}k_{2}}\right\vert \left\vert \gamma_{2}\left(
\mathbf{z}\right)  _{k_{1}k_{2}j_{1}j_{2}}\right\vert \nonumber\\
&  \leq\frac{1}{4}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert
D_{_{2N}j_{1}j_{2}k_{1}k_{2}}\right\vert ,
\end{align}
as
\begin{equation}
0\leq\left\vert \gamma_{2}\left(  \mathbf{z}\right)  _{k_{1}k_{2}j_{1}j_{2}%
}\right\vert \leq1.
\end{equation}
Thus the condition on the Q-symbols becomes the condition
\begin{equation}
\frac{1}{4}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert D_{_{2N}%
j_{1}j_{2}k_{1}k_{2}}\right\vert \leq1
\end{equation}
on the matrix elements of the SORDM elements in the reference state basis. The
ground state variational problem thus can be expressed as
\begin{align}
E\left(  D_{\ast}^{2}\right)   &  =\inf_{D^{2}\in S_{2N}}\operatorname*{Tr}%
\left\{  K_{2N}D^{2}\right\} \nonumber\\
&  \Updownarrow\nonumber\\
E\left(  Q_{\ast}\right)   &  =\inf_{Q\in\mathfrak{Q}_{1+N}}\left\{  \int
P_{K_{2N}}\left(  \mathbf{z}\right)  Q\left(  \mathbf{z}\right)  S\left(
\mathbf{\bar{z},z}\right)  d\mu\left(  \mathbf{z}\right)  \right\}  .
\end{align}
$\lceil$Noting that
\begin{equation}
P_{N}=\left.  \binom{N}{P}^{-1}\mathcal{N}_{P}\right\vert _{\mathcal{H}^{N}%
};0\leq P\leq N
\end{equation}
the P symbols of the number and pair operators are
\begin{align}
\mathcal{N}_{1}  &  =2I_{2}=2\int\left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  \Rightarrow
P_{\mathcal{N}_{1}}\left(  \mathbf{z}\right)  =2\nonumber\\
\mathcal{N}_{2}  &  =I_{2}=\int\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  \Rightarrow
P_{\mathcal{N}_{2}}\left(  \mathbf{z}\right)  =1
\end{align}
and have the same Q symbols as
\begin{align*}
Q_{\mathcal{N}_{1}}\left(  \mathbf{z}\right)   &  =\frac{\left\langle
\mathbf{z}\left\vert \mathcal{N}_{1}\mathbf{z}\right.  \right\rangle
}{\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle }=2\\
Q_{\mathcal{N}_{2}}\left(  \mathbf{z}\right)   &  =\frac{\left\langle
\mathbf{z}\left\vert \mathcal{N}_{2}\mathbf{z}\right.  \right\rangle
}{\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle }=1
\end{align*}
thus
\begin{align}
\operatorname*{Tr}\left\{  \mathcal{N}_{1}D^{2}\right\}   &
=2\operatorname*{Tr}\left\{  D^{2}\right\}  =2\operatorname*{Tr}\left\{
\int\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
d\mu\left(  \mathbf{z}\right)  D^{2}\right\}  =2\int Q_{D^{2}}\left(
\mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(
\mathbf{z}\right) \nonumber\\
\operatorname*{Tr}\left\{  \mathcal{N}_{1}^{2}D^{2}\right\}   &
=4\operatorname*{Tr}\left\{  D^{2}\right\}  =4\operatorname*{Tr}\left\{
\int\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
d\mu\left(  \mathbf{z}\right)  D^{2}\right\}  =4\int Q_{D^{2}}\left(
\mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(
\mathbf{z}\right) \nonumber\\
\operatorname*{Tr}\left\{  \mathcal{N}_{2}D^{2}\right\}   &
=\operatorname*{Tr}\left\{  D^{2}\right\}  =\operatorname*{Tr}\left\{
\int\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
d\mu\left(  \mathbf{z}\right)  D^{2}\right\}  =\int Q_{D^{2}}\left(
\mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)  d\mu\left(
\mathbf{z}\right)  ,
\end{align}
while%
\begin{equation}
\int Q_{D^{2}}\left(  \mathbf{z}\right)  S\left(  \mathbf{\bar{z},z}\right)
d\mu\left(  \mathbf{z}\right)  =\binom{N}{2}.\rfloor
\end{equation}


\begin{theorem}
The matrix elements $\left\langle \psi_{j}\psi_{k}\left\vert X\psi_{l}\psi
_{m}\right.  \right\rangle $ determine $\left\langle g_{1}\left\vert X\right.
g_{2}\right\rangle $
\end{theorem}

%

\begin{equation}
\left\langle g_{1}\left\vert X\right.  g_{2}\right\rangle =\sum
_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}g_{1jk}g_{2lm}\left\langle
\psi_{j}\psi_{k}\left\vert X\right.  \psi_{l}\psi_{m}\right\rangle
\end{equation}
Polarization in a complex space gives
\begin{align}
&  \left\langle \psi_{j}\psi_{k}\left\vert X\right.  \psi_{l}\psi
_{m}\right\rangle \nonumber\\
&  =\sum_{0\leq\nu\leq3}\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq
r}}i^{\nu}\left\langle \left(  \psi_{j}\wedge\psi_{k}+i^{\nu}\psi_{l}%
\wedge\psi_{m}\right)  \left\vert X\right.  \left(  \psi_{j}\wedge\psi
_{k}+i^{\nu}\psi_{l}\wedge\psi_{m}\right)  \right\rangle ,
\end{align}
while in a real space
\begin{equation}
\left\langle \psi_{j}\psi_{k}\left\vert X\right.  \psi_{l}\psi_{m}%
\right\rangle =\frac{1}{4}\left\{  \left\Vert \left\vert \psi_{j}\psi
_{k}\right\rangle +\left\vert \psi_{l}\psi_{m}\right\rangle \right\Vert
^{2}-\left\Vert \left\vert \psi_{j}\psi_{k}\right\rangle -\left\vert \psi
_{l}\psi_{m}\right\rangle \right\Vert ^{2}\right\}  .
\end{equation}
Cauchy-Schwartz gives
\begin{align}
\left\vert \left\langle \psi_{j}\psi_{k}\left\vert A^{2}\right.  \psi_{l}%
\psi_{m}\right\rangle \right\vert  &  \leq\left\langle \psi_{j}\psi
_{k}\left\vert A^{2}\right.  \psi_{j}\psi_{k}\right\rangle \left\langle
\psi_{l}\psi_{m}\left\vert A^{2}\right.  \psi_{l}\psi_{m}\right\rangle
\nonumber\\
&  \leq\sup\left\langle \psi_{j}\psi_{k}\left\vert A^{2}\right.  \psi_{j}%
\psi_{k}\right\rangle \sup\left\langle \psi_{l}\psi_{m}\left\vert
A^{2}\right.  \psi_{l}\psi_{m}\right\rangle =1.
\end{align}
Is the following true ?
\begin{align}
\left\vert \left\langle \psi_{j}\psi_{k}\left\vert A^{2}\right.  \psi_{l}%
\psi_{m}\right\rangle \right\vert  &  \leq1,\quad\forall\left\vert \psi
_{j}\right\rangle ,\left\vert \psi_{k}\right\rangle ,\left\vert \psi
_{l}\right\rangle ,\left\vert \psi_{m}\right\rangle \in B_{\psi}\nonumber\\
&  \Updownarrow\nonumber\\
\left\langle \varphi_{j}\varphi_{k}\left\vert A^{2}\right.  \varphi_{j}%
\varphi_{k}\right\rangle  &  \leq1,\forall\left\vert \varphi_{j}\right\rangle
,\left\vert \varphi_{k}\right\rangle \in B_{\varphi}\quad\forall B_{\varphi}%
\end{align}
%

\begin{equation}
\left\langle A\psi_{j}\psi_{k}\left\vert A\psi_{j}\psi_{k}\right.
\right\rangle =\left\langle u\wedge uA\psi_{j}\psi_{k}\left\vert u\wedge
uA\psi_{j}\psi_{k}\right.  \right\rangle
\end{equation}%
\begin{equation}
\left\langle u\psi_{j}u\psi_{k}\left\vert A^{2}\right.  u\psi_{j}u\psi
_{k}\right\rangle =\left\langle Au\psi_{j}u\psi_{k}\left\vert Au\psi_{j}%
u\psi_{k}\right.  \right\rangle
\end{equation}%
\begin{align}
\left\vert \left\langle u\psi_{j}u\psi_{k}\left\vert A^{2}\right.  u\psi
_{l}u\psi_{m}\right\rangle \right\vert  &  =\left\vert \sum_{j^{\prime
}k^{\prime}l^{\prime}m^{\prime}}\bar{u}_{j^{\prime}j}\bar{u}_{k^{\prime}%
k}\left\langle \psi_{j^{\prime}}\psi_{k^{\prime}}\left\vert A^{2}\right.
\psi_{l^{\prime}}\psi_{m^{\prime}}\right\rangle u_{l^{\prime}l}u_{m^{\prime}%
m}\right\vert \nonumber\\
&  \leq\sum_{j^{\prime}k^{\prime}l^{\prime}m^{\prime}}\left\vert \bar
{u}_{j^{\prime}j}\bar{u}_{k^{\prime}k}\left\langle \psi_{j}\psi_{k}\left\vert
A^{2}\right.  \psi_{l}\psi_{m}\right\rangle u_{l^{\prime}l}u_{m^{\prime}%
m}\right\vert \nonumber\\
&  =\sum_{j^{\prime}k^{\prime}l^{\prime}m^{\prime}}\left\vert \bar
{u}_{j^{\prime}j}\right\vert \left\vert \bar{u}_{k^{\prime}k}\right\vert
\left\vert \left\langle \psi_{j}\psi_{k}\left\vert A^{2}\right.  \psi_{l}%
\psi_{m}\right\rangle \right\vert \left\vert u_{l^{\prime}l}\right\vert
\left\vert u_{m^{\prime}m}\right\vert \nonumber\\
&  \leq\sum_{j^{\prime}k^{\prime}l^{\prime}m^{\prime}}\left\vert \bar
{u}_{j^{\prime}j}\right\vert \left\vert \bar{u}_{k^{\prime}k}\right\vert
\left\vert u_{l^{\prime}l}\right\vert \left\vert u_{m^{\prime}m}\right\vert
\nonumber\\
&  =\sum_{j^{\prime}}\left\vert \bar{u}_{j^{\prime}j}\right\vert
\sum_{k^{\prime}}\left\vert \bar{u}_{k^{\prime}k}\right\vert \sum_{l^{\prime}%
}\left\vert u_{l^{\prime}l}\right\vert \sum_{m^{\prime}}\left\vert
u_{m^{\prime}m}\right\vert
\end{align}%
\begin{align}
\sup\left\langle g\left\vert X\right.  g\right\rangle  &  =\sup\left\vert
\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}g_{jk}g_{lm}\left\langle
\psi_{j}\psi_{k}\left\vert X\right.  \psi_{l}\psi_{m}\right\rangle \right\vert
\nonumber\\
&  \leq\sup\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}\left\vert
g_{jk}g_{lm}\right\vert \left\vert \left\langle \psi_{j}\psi_{k}\left\vert
X\right.  \psi_{l}\psi_{m}\right\rangle \right\vert \nonumber\\
&  \leq\sup\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}\left\vert
g_{jk}g_{lm}\right\vert
\end{align}


Using the canonical form we get%
