\right)  \left(
\begin{array}
[c]{cc}%
\left(  \mathbf{x}_{11},\mathbf{x}_{12}\right)  & \left(  \mathbf{x}%
_{21},\mathbf{x}_{22}\right)
\end{array}
\right)  .
