AB=\sum_{0\leq m,n\leq2r}A_{m}B_{n}%
\end{equation}%
\begin{equation}
A_{m}B_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle A_{m}%
B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{equation}
In particular for squares}%

\begin{align}
A^{2}  &  =\sum_{0\leq m,n\leq2r}A_{m}A_{n}\\
A_{m}A_{n}  &  =\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle A_{m}%
A_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{align}


Thus for fourth order operators
\begin{align}
A^{2}  &  =A_{0}^{2}+A_{1}^{2}+A_{2}^{2}+A_{3}^{2}+A_{4}^{2}\nonumber\\
&  +A_{0}A_{1}+A_{0}A_{2}+A_{0}A_{3}+A_{0}A_{4}+A_{1}A_{0}+A_{2}A_{0}%
+A_{3}A_{0}+A_{4}A_{0}\nonumber\\
&  +A_{1}A_{2}+A_{1}A_{3}+A_{1}A_{4}+A_{2}A_{1}+A_{3}A_{1}+A_{4}%
A_{1}\nonumber\\
&  +A_{2}A_{3}+A_{2}A_{4}+A_{3}A_{2}+A_{4}A_{2}\nonumber\\
&  +A_{3}A_{4}+A_{4}A_{3},
\end{align}
where

1.%
\begin{subequations}
\begin{align}
A_{4}^{2}  &  =\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle A_{4}%
^{2}\right\rangle _{2}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{4}^{2}\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{8}\\
A_{3}^{2}  &  =\left\langle A_{3}^{2}\right\rangle _{0}+\left\langle A_{3}%
^{2}\right\rangle _{2}+\left\langle A_{3}^{2}\right\rangle _{4}+\left\langle
A_{3}^{2}\right\rangle _{6}\\
A_{2}^{2}  &  =\left\langle A_{2}^{2}\right\rangle _{0}+\left\langle A_{2}%
^{2}\right\rangle _{2}+\left\langle A_{2}^{2}\right\rangle _{4}\\
A_{1}^{2}  &  =\left\langle A_{1}^{2}\right\rangle _{0}+\left\langle A_{1}%
^{2}\right\rangle _{2}\\
A_{0}^{2}  &  =\left\langle A_{0}^{2}\right\rangle _{0},
\end{align}
thus
\end{subequations}
\begin{align*}
\left(  \left.  A\right\vert A\right)   &  =\left\langle A_{4}^{2}%
\right\rangle _{0}+\left\langle A_{3}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}+\left\langle A_{1}^{2}\right\rangle _{0}%
+\left\langle A_{0}^{2}\right\rangle _{0}\\
&  =\left(  \left.  A_{0}\right\vert A_{0}\right)  +\left(  \left.
A_{1}\right\vert A_{1}\right)  +\left(  \left.  A_{2}\right\vert A_{2}\right)
+\left(  \left.  A_{3}\right\vert A_{3}\right)  +\left(  \left.
A_{4}\right\vert A_{4}\right) \\
&  =\left\{  \alpha_{0}^{2}+\frac{1}{2}\sum_{1\leq j_{1}\leq2r}\left(
\alpha_{1j_{1}}\right)  ^{2}-\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq2r}\left(
\alpha_{2j_{1}j_{2}}\right)  ^{2}-\frac{1}{8}\sum_{1\leq j_{1}<j_{2}<j_{3}%
\leq2r}\left(  \alpha_{3j_{1}j_{2}j_{3}}\right)  ^{2}+\frac{1}{16}\sum_{1\leq
j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\left(  \alpha_{4j_{1}j_{2}j_{3}j_{4}}\right)
^{2}\right\}  I_{\mathcal{F}}%
\end{align*}
One can also express the inner products of the even number components as
\begin{align}
\left(  \left.  A_{0}\right\vert A_{0}\right)   &  =\operatorname*{Tr}\left\{
\mathbb{A}_{0}^{t}\mathbb{A}_{0}\right\}  I_{\mathcal{F}}\nonumber\\
\left(  \left.  A_{2}\right\vert A_{2}\right)   &  =\frac{1}{4}%
\operatorname*{Tr}\left\{  \mathbb{A}_{2}^{t}\mathbb{A}_{2}\right\}
I_{\mathcal{F}}\nonumber\\
\left(  \left.  A_{4}\right\vert A_{4}\right)   &  =\frac{1}{16}%
\operatorname*{Tr}\left\{  \mathbb{A}_{4}^{t}\mathbb{A}_{4}\right\}
I_{\mathcal{F}},
\end{align}
where we have used the ordered form of the basis.

2.%
\begin{align}
A_{3}A_{4}  &  =\left\langle A_{3}A_{4}\right\rangle _{1}+\left\langle
A_{3}A_{4}\right\rangle _{3}+\left\langle A_{3}A_{4}\right\rangle
_{5}+\left\langle A_{3}A_{4}\right\rangle _{7}\\
A_{4}A_{3}  &  =\left\langle A_{4}A_{3}\right\rangle _{1}+\left\langle
A_{4}A_{3}\right\rangle _{3}+\left\langle A_{4}A_{3}\right\rangle
_{5}+\left\langle A_{4}A_{3}\right\rangle _{7},
\end{align}


3.%
\begin{align}
A_{2}A_{3}  &  =\left\langle A_{2}A_{3}\right\rangle _{1}+\left\langle
A_{2}A_{3}\right\rangle _{3}+\left\langle A_{2}A_{3}\right\rangle _{5}\\
A_{3}A_{2}  &  =\left\langle A_{3}A_{2}\right\rangle _{1}+\left\langle
A_{3}A_{2}\right\rangle _{3}+\left\langle A_{3}A_{2}\right\rangle _{5},
\end{align}


4.%
\begin{align}
A_{2}A_{4}  &  =\left\langle A_{2}A_{4}\right\rangle _{2}+\left\langle
A_{2}A_{4}\right\rangle _{4}+\left\langle A_{2}A_{4}\right\rangle _{6}\\
A_{4}A_{2}  &  =\left\langle A_{4}A_{2}\right\rangle _{2}+\left\langle
A_{4}A_{2}\right\rangle _{4}+\left\langle A_{4}A_{2}\right\rangle _{6}.
\end{align}


5.%
\begin{align}
A_{1}A_{2}  &  =\left\langle A_{1}A_{2}\right\rangle _{1}+\left\langle
A_{1}A_{2}\right\rangle _{3}\\
A_{2}A_{1}  &  =\left\langle A_{2}A_{1}\right\rangle _{1}+\left\langle
A_{2}A_{1}\right\rangle _{3}%
\end{align}


6.%
\begin{align}
A_{1}A_{3}  &  =\left\langle A_{1}A_{3}\right\rangle _{2}+\left\langle
A_{1}A_{3}\right\rangle _{4}\\
A_{3}A_{1}  &  =\left\langle A_{3}A_{1}\right\rangle _{2}+\left\langle
A_{3}A_{1}\right\rangle _{4}%
\end{align}


7.%
\begin{align}
A_{1}A_{4}  &  =\left\langle A_{1}A_{4}\right\rangle _{3}+\left\langle
A_{1}A_{4}\right\rangle _{5}\\
A_{4}A_{1}  &  =\left\langle A_{4}A_{1}\right\rangle _{3}+\left\langle
A_{4}A_{1}\right\rangle _{5}.
\end{align}
In our case
\begin{equation}
A=A_{0}+A_{2}+A_{4},
\end{equation}
hence
\begin{align}
A^{2}  &  =\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle A_{4}%
^{2}\right\rangle _{2}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{4}^{2}\right\rangle _{6}+\left\langle A_{4}^{2}\right\rangle _{8}%
+\left\langle A_{2}^{2}\right\rangle _{0}+\left\langle A_{2}^{2}\right\rangle
_{2}+\left\langle A_{2}^{2}\right\rangle _{4}\nonumber\\
&  +\left\langle A_{2}A_{4}\right\rangle _{2}+\left\langle A_{2}%
A_{4}\right\rangle _{4}+\left\langle A_{2}A_{4}\right\rangle _{6}+\left\langle
A_{4}A_{2}\right\rangle _{2}+\left\langle A_{4}A_{2}\right\rangle
_{4}+\left\langle A_{4}A_{2}\right\rangle _{6}+2A_{0}A_{2}+2A_{0}A_{4},
\end{align}
which can be rearranged as
\begin{align}
A^{2}  &  =\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle A_{2}%
^{2}\right\rangle _{0}+A_{0}^{2}\nonumber\\
&  +\left\langle A_{4}^{2}\right\rangle _{2}+\left\langle A_{2}^{2}%
\right\rangle _{2}+\left\langle A_{2}A_{4}\right\rangle _{2}+\left\langle
A_{4}A_{2}\right\rangle _{2}+2A_{0}A_{2}\nonumber\\
&  +2A_{0}A_{4}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{2}A_{4}\right\rangle _{4}+\left\langle A_{4}A_{2}\right\rangle
_{4}+\left\langle A_{2}^{2}\right\rangle _{4}\nonumber\\
&  +\left\langle A_{4}^{2}\right\rangle _{6}+\left\langle A_{2}A_{4}%
\right\rangle _{6}+\left\langle A_{4}A_{2}\right\rangle _{6}\nonumber\\
&  +\left\langle A_{4}^{2}\right\rangle _{8},
\end{align}
As
\begin{equation}
\left\langle A_{r}B_{s}\right\rangle _{r+s-2j}=\left(  -1\right)
^{rs-j}\left\langle B_{s}A_{r}\right\rangle _{r+s-2j}%
\end{equation}
this gives
\begin{align}
A^{2}  &  =A_{0}^{2}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}\nonumber\\
&  +2\left\langle A_{2}A_{4}\right\rangle _{2}+2A_{0}A_{2}\nonumber\\
&  +\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle A_{2}^{2}%
\right\rangle _{4}+2A_{0}A_{4}\nonumber\\
&  +2\left\langle A_{2}A_{4}\right\rangle _{6}\nonumber\\
&  +\left\langle A_{4}^{2}\right\rangle _{8},
\end{align}
as
\begin{subequations}
\label{contraccond}%
\begin{align}
\left\langle A_{4}A_{4}\right\rangle _{8-6}  &  =\left(  -1\right)
^{16-3}\left\langle A_{4}A_{4}\right\rangle _{8-6}\Rightarrow\left\langle
A_{4}^{2}\right\rangle _{2}=0\label{4-2-2}\\
\left\langle A_{4}A_{4}\right\rangle _{8-4}  &  =\left(  -1\right)
^{16-2}\left\langle A_{4}A_{4}\right\rangle _{8-4}=\left\langle A_{4}%
A_{4}\right\rangle _{4}\label{4-4-4}\\
\left\langle A_{4}A_{4}\right\rangle _{8-2}  &  =\left(  -1\right)
^{16-1}\left\langle A_{4}A_{4}\right\rangle _{8-2}\Rightarrow\left\langle
A_{4}^{2}\right\rangle _{6}=0\label{4-4-6}\\
\left\langle A_{4}A_{4}\right\rangle _{8-0}  &  =\left(  -1\right)
^{16-0}\left\langle A_{4}A_{4}\right\rangle _{8}=\left\langle A_{4}%
^{2}\right\rangle _{8}\label{4-4-8}\\
\left\langle A_{4}A_{2}\right\rangle _{6-4}  &  =\left(  -1\right)
^{8-2}\left\langle A_{2}A_{4}\right\rangle _{6-4}=\left\langle A_{2}%
A_{4}\right\rangle _{2}\label{4-2--2}\\
\left\langle A_{2}A_{4}\right\rangle _{6-2}  &  =\left(  -1\right)
^{8-1}\left\langle A_{4}A_{2}\right\rangle _{6-2}\Rightarrow\left\langle
A_{2}A_{4}\right\rangle _{4}=-\left\langle A_{4}A_{2}\right\rangle
_{4}\label{2-4-4}\\
\left\langle A_{4}A_{2}\right\rangle _{6-0}  &  =\left(  -1\right)
^{8-0}\left\langle A_{2}A_{4}\right\rangle _{6-0}=\left\langle A_{2}%
A_{4}\right\rangle _{6}\label{4-2-6}\\
\left\langle A_{2}A_{2}\right\rangle _{4-2}  &  =\left(  -1\right)
^{4-1}\left\langle A_{2}A_{2}\right\rangle _{4-2}\Rightarrow\left\langle
A_{2}^{2}\right\rangle _{2}=0\label{2-2-2}\\
\left\langle A_{2}A_{2}\right\rangle _{4-0}  &  =\left(  -1\right)
^{4-0}\left\langle A_{2}A_{2}\right\rangle _{4-0}=\left\langle A_{2}%
^{2}\right\rangle _{4}. \label{2-2-0}%
\end{align}
It is easy to show that
\end{subequations}
\begin{subequations}
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{0}  &  =\left(  \left.  A_{4}\right\vert
A_{4}\right)  I_{\mathcal{F}}\\
\left\langle A_{2}^{2}\right\rangle _{0}  &  =\frac{1}{8}\operatorname*{Tr}%
\left\{  \mathbb{A}_{2}^{t}\mathbb{A}_{2}\right\}  I_{\mathcal{F}}=\left(
\left.  A_{2}\right\vert A_{2}\right)  I_{\mathcal{F}}%
\end{align}
and
\end{subequations}
\begin{subequations}
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{8}  &  =A_{4}\wedge A_{4}\\
\left\langle A_{2}^{2}\right\rangle _{4}  &  =A_{2}\wedge A_{2}\\
\left\langle A_{2}A_{4}\right\rangle _{6}  &  =A_{2}\wedge A_{4}.
\end{align}
One can check this by considering representative tensor elements for
eq.$\left(  \ref{4-2-2}\right)  $
\end{subequations}
\begin{equation}
\left\langle A_{4}A_{2}\right\rangle _{\left(  2\right)  12}=-\left(
A_{1256}A_{56}+A_{1246}A_{46}+A_{1236}A_{36}+A_{1245}A_{45}+A_{1235}%
A_{35}+A_{1234}A_{34}\right)  \neq0
\end{equation}%
\begin{equation}
\left\langle A_{2}A_{4}\right\rangle _{\left(  2\right)  12}=-\left(
A_{56}A_{1256}+A_{46}A_{1246}+A_{36}A_{1236}+A_{45}A_{1245}+A_{35}%
A_{1235}+A_{34}A_{1234}\right)  \neq0
\end{equation}
for eq.$\left(  \ref{4-4-6}\right)  $%
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{\left(  6\right)  234567}=  &
A_{1234}A_{1567}-A_{1235}A_{1467}+A_{1236}A_{1457}-A_{1237}A_{1456}%
+A_{1245}A_{1367}-A_{1246}A_{1357}+A_{1247}A_{1356}-A_{1256}A_{1347}%
\nonumber\\
&  -A_{1257}A_{1346}+A_{1267}A_{1345}-A_{1345}A_{1267}+A_{1346}A_{1257}%
-A_{1347}A_{1256}-A_{1356}A_{1247}+A_{1357}A_{1246}-A_{1367}A_{1245}%
\nonumber\\
&  +A_{1456}A_{1237}-A_{1457}A_{1236}+A_{1467}A_{1235},-A_{1567}A_{1234}=0
\end{align}
for eq. $\left(  \ref{4-4-4}\right)  $%
\begin{align}
\left\langle A_{4}^{2}\right\rangle _{\left(  4\right)  3456}  &
=-A_{1234}A_{1256}+A_{1235}A_{1246}-A_{1236}A_{1245}-A_{1245}A_{1236}%
+A_{1246}A_{1235}-A_{1256}A_{1234}\\
&  =2\left(  A_{1235}A_{1246}-A_{1234}A_{1256}-A_{1236}A_{1245}\right)
\end{align}
for eq. $\left(  \ref{4-4-2}\right)  $%
\begin{equation}
\left\langle A_{4}^{2}\right\rangle _{\left(  2\right)  45}=A_{1234}%
A_{1235}-A_{1235}A_{1234}+A_{1234}A_{1236}-A_{1236}A_{1234}+A_{1234}%
A_{1235}-A_{1235}A_{1234}\cdots=0
\end{equation}


The \emph{reflection or involution }condition $A^{2}=I_{\mathcal{F}}$ gives
\begin{equation}
A^{2}=A_{0}^{2}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle
A_{2}^{2}\right\rangle _{0}+2\left\langle A_{2}A_{4}\right\rangle _{2}%
+2A_{0}A_{2}+\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle A_{2}%
^{2}\right\rangle _{4}+2A_{0}A_{4}+2\left\langle A_{2}A_{4}\right\rangle
_{6}+\left\langle A_{4}^{2}\right\rangle _{8}=I_{\mathcal{F}},
\end{equation}
leading to
\begin{align}
A_{0}^{2}+\left\langle A_{4}^{2}\right\rangle _{0}+\left\langle A_{2}%
^{2}\right\rangle _{0}  &  =I_{\mathcal{F}}\\
\left\langle A_{2}A_{4}\right\rangle _{2}+A_{0}A_{2}  &  =0\\
\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle A_{2}^{2}\right\rangle
_{4}+2A_{0}A_{4}  &  =0\\
\left\langle A_{2}A_{4}\right\rangle _{6}  &  =A_{2}\wedge A_{4}=0\\
\left\langle A_{4}^{2}\right\rangle _{8}  &  =A_{4}\wedge A_{4}=0
\end{align}


If $A$ is a reflection then
\begin{align*}
\mathcal{A}_{+}  &  =\frac{1}{\sqrt{2}}\left(  I_{\mathcal{F}}+A\right) \\
\mathcal{A}_{-}  &  =\frac{1}{\sqrt{2}}\left(  I_{\mathcal{F}}-A\right)
\end{align*}
are \emph{orthogonal idempotents}, as%
\[
\mathcal{A}_{+}^{2}=\left(  \frac{1}{\sqrt{2}}\left(  I_{\mathcal{F}%
}+A\right)  \right)  ^{2}=\frac{1}{2}\left(  I_{\mathcal{F}}+2A+I_{\mathcal{F}%
}\right)  =\mathcal{A}_{+},
\]%
\[
\mathcal{A}_{-}^{2}=\left(  \frac{1}{\sqrt{2}}\left(  I_{\mathcal{F}%
}-A\right)  \right)  ^{2}=\frac{1}{2}\left(  I_{\mathcal{F}}-2A+I_{\mathcal{F}%
}\right)  =\mathcal{A}_{-}%
\]
and
\[
\mathcal{A}_{+}\mathcal{A}_{-}=\mathcal{A}_{-}\mathcal{A}_{+}=0=\frac{1}%
{\sqrt{2}}\left(  I_{\mathcal{F}}+A\right)  \frac{1}{\sqrt{2}}\left(
I_{\mathcal{F}}-A\right)  =\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)
\left(  I_{\mathcal{F}}-A\right)  .
\]


The \emph{idempotency} condition $A^{2}=A$ gives
\begin{align}
A^{2}-A  &  =\left\{  A_{0}\left(  A_{0}-1\right)  +\left\langle A_{4}%
^{2}\right\rangle _{0}+\left\langle A_{2}^{2}\right\rangle _{0}\right\}
+\left\{  2\left\langle A_{2}A_{4}\right\rangle _{2}+\left(  2A_{0}-1\right)
A_{2}\right\}  +\left\{  \left\langle A_{4}^{2}\right\rangle _{4}+\left\langle
A_{2}^{2}\right\rangle _{4}+\left(  2A_{0}-1\right)  A_{4}\right\} \nonumber\\
&  +2\left\langle A_{2}A_{4}\right\rangle _{6}+\left\langle A_{4}%
^{2}\right\rangle _{8}=0
\end{align}
which gives
\begin{subequations}
\label{idem cond}%
\begin{align}
A_{0}\left(  A_{0}-I_{\mathcal{F}}\right)  +\left\langle A_{4}^{2}%
\right\rangle _{0}+\left\langle A_{2}^{2}\right\rangle _{0}  &  =0\\
2\left\langle A_{2}A_{4}\right\rangle _{2}+\left(  2A_{0}-I_{\mathcal{F}%
}\right)  A_{2}  &  =0\\
\left\langle A_{4}^{2}\right\rangle _{4}+\left\langle A_{2}^{2}\right\rangle
_{4}+\left(  2A_{0}-I_{\mathcal{F}}\right)  A_{4}  &  =0\\
\left\langle A_{2}A_{4}\right\rangle _{6}  &  =0\\
\left\langle A_{4}^{2}\right\rangle _{8}  &  =0
\end{align}
and thus
\end{subequations}
\begin{align}
A_{0}\left(  A_{0}-1\right)  +\left(  \left.  A_{4}\right\vert A_{4}\right)
+\left(  \left.  A_{2}\right\vert A_{2}\right)   &  =0\\
2\left\langle A_{2}A_{4}\right\rangle _{2}+\left(  2A_{0}-1\right)  A_{2}  &
=0\\
\left\langle A_{4}^{2}\right\rangle _{4}+A_{2}\wedge A_{2}+\left(
2A_{0}-1\right)  A_{4}  &  =0\\
A_{2}\wedge A_{4}  &  =0\\
A_{4}\wedge A_{4}  &  =0
\end{align}
and in more detail%
\begin{align}
A_{0}\left(  A_{0}-1\right)  +\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq
2r}A_{4j_{1}j_{2}j_{3}j_{4}}^{2}+\sum_{1\leq j_{1}<j_{2}\leq2r}A_{2j_{1}j_{2}%
}^{2}  &  =0\\
2\left\langle A_{2}A_{4}\right\rangle _{2}+\left(  2\alpha-1\right)  A_{2}  &
=0\\
\left\langle A_{4}^{2}\right\rangle _{4}+A_{2}\wedge A_{2}+\left(
2\alpha-1\right)  A_{4}  &  =0\\
A_{2}\wedge A_{4}  &  =0\\
A_{4}\wedge A_{4}  &  =0.
\end{align}


