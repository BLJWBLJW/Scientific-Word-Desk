\subparagraph{Pfaffian}

The Pfaffian, a multilinear, symmetric (?) complex valued function
\begin{equation}
\operatorname*{Pf}:\overset{n}{\overbrace{\mathbb{C}\times\cdots
\times\mathbb{C}}}\,\cong\mathbb{C}^{n}\rightarrow\mathbb{C}^{n}%
\end{equation}
is defined in general by
\begin{align}
\operatorname*{Pf}\left(  \mathbf{\Delta}_{j_{1}\cdots j_{2n}}\right)   &
=\operatorname*{Pf}\left(  \mathbf{\Delta}_{j_{1}j_{2}},\cdots,\mathbf{\Delta
}_{j_{2n-1}j_{2n}}\right)  =%
%TCIMACRO{\dsum \limits_{\rho\in C_{2}^{2n}\left(  \mathbb{N}_{1}^{2n}\right)
%}}%
%BeginExpansion
{\displaystyle\sum\limits_{\rho\in C_{2}^{2n}\left(  \mathbb{N}_{1}%
^{2n}\right)  }}
%EndExpansion
\pi\left(  \rho\right)
%TCIMACRO{\dprod \limits_{1\leq\leq k\leq n}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq\leq k\leq n}}
%EndExpansion
\Delta_{j_{\rho\left(  2k-1\right)  }j_{\rho\left(  2k\right)  }}=\frac
{1}{2^{n}n!}%
%TCIMACRO{\dsum \limits_{\sigma\in S_{2n}}}%
%BeginExpansion
{\displaystyle\sum\limits_{\sigma\in S_{2n}}}
%EndExpansion
\pi\left(  \sigma\right)
%TCIMACRO{\dprod \limits_{1\leq k\leq n}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq k\leq n}}
%EndExpansion
\Delta_{j_{\sigma\left(  2k-1\right)  }j_{\sigma\left(  2k\right)  }},\\
\mathbf{\Delta}_{j_{1}\cdots j_{2n}}  &  \equiv\left(  \mathbf{\Delta}%
_{j_{1}j_{2}},\cdots,\mathbf{\Delta}_{j_{2n-1}j_{2n}}\right)  ,
\end{align}
where $\rho$ and $\sigma$ are permutations
\begin{equation}
\rho:\left\{  1,\cdots,2n\right\}  \longrightarrow\left\{  \rho\left(
1\right)  ,\cdots,\rho\left(  2n\right)  \right\}  ,
\end{equation}
and $\rho$ is constrained by
\begin{equation}
\rho\left(  2k-1\right)  <\rho\left(  2k\right)  ;1\leq k\leq n,
\end{equation}
leading to the induced permutation
\begin{equation}
