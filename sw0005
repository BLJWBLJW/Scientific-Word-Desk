\section{General Self Adjoint Field Operators}

In general one can define self adjoint operators by the real linear maps
\begin{equation}
X,Y:\mathfrak{h}\rightarrow\mathcal{F},
\end{equation}
given by
\begin{align}
X\left(  \left\vert u\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  +\Phi\left(
\left\vert u\right\rangle \right)  \right)  =X\left(  \left\vert
u\right\rangle \right)  ^{\dagger}\\
Y\left(  \left\vert u\right\rangle \right)   &  =\frac{i}{\sqrt{2}}\left(
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  -\Phi\left(
\left\vert u\right\rangle \right)  \right)  =Y\left(  \left\vert
u\right\rangle \right)  ^{\dagger},
\end{align}
which give%
\begin{align}
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)   &  =\frac{1}%
{\sqrt{2}}\left(  X\left(  \left\vert u\right\rangle \right)  -iY\left(
\left\vert u\right\rangle \right)  \right) \\
\Phi\left(  \left\vert u\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
X\left(  \left\vert u\right\rangle \right)  +iY\left(  \left\vert
u\right\rangle \right)  \right)  .
\end{align}
\emph{Note that} $X$ and $Y$ are $\mathbb{R}$-linear i.e.
\begin{align}
X\left(  \sum_{1\leq j\leq p}\lambda_{j}\left\vert u_{j}\right\rangle \right)
&  =\sum_{1\leq j\leq p}\lambda_{j}X\left(  \left\vert u_{j}\right\rangle
\right) \\
Y\left(  \sum_{1\leq j\leq p}\lambda_{j}\left\vert u_{j}\right\rangle \right)
&  =\sum_{1\leq j\leq p}\lambda_{j}Y\left(  \left\vert u_{j}\right\rangle
\right)  ,
\end{align}
when
\begin{equation}
\lambda_{j}\in\mathbb{R},1\leq j\leq p,
\end{equation}
while
\begin{align}
X\left(  \sum_{1\leq j\leq p}\lambda_{j}\left\vert u_{j}\right\rangle \right)
&  \neq\sum_{1\leq j\leq p}\lambda_{j}X\left(  \left\vert u_{j}\right\rangle
\right) \\
Y\left(  \sum_{1\leq j\leq p}\lambda_{j}\left\vert u_{j}\right\rangle \right)
&  \neq\sum_{1\leq j\leq p}\lambda_{j}Y\left(  \left\vert u_{j}\right\rangle
\right)  ,
\end{align}
when
\begin{equation}
\lambda_{j}\in\mathbb{C},\mathbb{\notin},\mathbb{R};1\leq j\leq p\quad
\text{i.e}.\lambda_{j}\neq\overline{\lambda_{j}}.
\end{equation}
.

The maps $\left\{  \Phi^{\dagger},\Phi\right\}  $ could also be named
$\left\{  a^{\dagger},a\right\}  $ as
\begin{equation}
a_{k}^{\dagger}=a^{\dagger}\left(  \left\vert \varphi_{k}\right\rangle
