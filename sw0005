Then
\begin{align}
\left(  T\left(  \mathbf{x}_{1}\right)  \right)  ^{\dagger}  &  =\mathbf{x}%
_{1}^{\dagger}\mathbb{T}_{11}^{\dagger}+\mathbf{x}_{2}^{\dagger}%
\mathbb{T}_{21}^{\dagger}\\
\left(  T\left(  \mathbf{x}_{2}\right)  \right)  ^{\dagger}  &  =\mathbf{x}%
_{1}^{\dagger}\mathbb{T}_{12}^{\dagger}+\mathbf{x}_{2}^{\dagger}%
\mathbb{T}_{22}^{\dagger},
\end{align}
as%
\begin{align}
\left(  \sum_{j}x_{1j}\mathbb{T}_{11jk}\right)  ^{\dagger}  &  =\sum_{j}%
x_{1j}^{\dagger}\mathbb{\bar{T}}_{11jk}=\sum_{j}\mathbb{\bar{T}}_{11jk}%
x_{1j}^{\dagger}=\sum_{j}\left(  \mathbb{T}_{11}^{\dagger}\right)  _{kj}%
x_{1j}^{\dagger}\\
