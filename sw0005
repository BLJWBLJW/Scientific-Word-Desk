\subsection{Reversion}

\qquad Reversion is defined by%
\begin{equation}
\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  ^{t}=x_{j_{n}}\cdots x_{j_{1}%
}=\left(  -1\right)  ^{\binom{n}{2}}x_{j_{1}}\cdots x_{j_{n}}%
\end{equation}
and reversion plus complex conjugation by%
\begin{equation}
\left(  x_{j_{1}}\cdots x_{j_{n}}\right)  ^{\dagger}=\overline{x_{j_{n}}\cdots
x_{j_{1}}}=\left(  -1\right)  ^{\binom{n}{2}}\overline{x_{j_{1}}\cdots
x_{j_{n}}}.
\end{equation}
This definition gives
\begin{equation}
\left(  AB\right)  ^{\dagger}=B^{\dagger}A^{\dagger}%
\end{equation}
for arbitary $A$ and $B.$

\textbf{Reversion composed with complex conjugation is actually the operator
adjoint operation} as can be seen by
\begin{align}
\left(  x_{1}x_{2}\right)  ^{\dagger}  &  =\left(  \frac{1}{\sqrt{2}}\left(
a_{1}^{\dagger}+a_{1}\right)  \frac{1}{\sqrt{2}}\left(  a_{2}^{\dagger}%
+a_{2}\right)  \right)  ^{\dagger}=\frac{1}{\sqrt{2}}\left(  a_{2}^{\dagger
}+a_{2}\right)  \frac{1}{\sqrt{2}}\left(  a_{1}^{\dagger}+a_{1}\right)
\nonumber\\
&  =\frac{1}{2}\left(  a_{2}^{\dagger}a_{1}^{\dagger}+a_{2}^{\dagger}%
a_{1}+a_{2}a_{1}^{\dagger}+a_{2}a_{1}\right)  =-\frac{1}{2}\left(
a_{1}^{\dagger}a_{2}^{\dagger}+a_{1}^{\dagger}a_{2}+a_{1}a_{2}^{\dagger}%
+a_{1}a_{2}\right) \nonumber\\
&  =-x_{2}x_{1}%
\end{align}
and%
\begin{align}
\left(  x_{1}x_{1+r}\right)  ^{\dagger}  &  =\left(  \frac{1}{\sqrt{2}}\left(
a_{1}^{\dagger}+a_{1}\right)  \frac{i}{\sqrt{2}}\left(  a_{1}^{\dagger}%
-a_{1}\right)  \right)  ^{\dagger}=\frac{i}{\sqrt{2}}\left(  a_{1}^{\dagger
}-a_{1}\right)  \frac{1}{\sqrt{2}}\left(  a_{1}^{\dagger}+a_{1}\right)
\nonumber\\
&  =\frac{i}{2}\left(  a_{1}^{\dagger}a_{1}^{\dagger}+a_{1}^{\dagger}%
a_{1}-a_{1}a_{1}^{\dagger}-a_{1}a_{1}\right)  =-\frac{i}{2}\left(
a_{1}^{\dagger}a_{1}^{\dagger}+a_{1}^{\dagger}a_{1}-a_{1}a_{1}^{\dagger}%
+a_{1}a_{1}\right) \nonumber\\
&  =-x_{1+r}x_{1}.
\end{align}


\section{Geometric Algebra I}

\subsection{Scaler Product}

The product $C_{1}D_{1}$ of two grade 1 operators (vectors) can be expressed
as the sum of a symmetric and antisymmetric part of the operator product in
$\mathcal{F}$ i.e.
\begin{equation}
C_{1}D_{1}=\frac{1}{2}\left\{  C_{1}D_{1}+D_{1}C_{1}\right\}  +\frac{1}%
{2}\left\{  C_{1}D_{1}-D_{1}C_{1}\right\}  =\frac{1}{2}\left\{  C_{1}%
,D_{1}\right\}  +\frac{1}{2}\left[  C_{1},D_{1}\right]
\end{equation}
which allows one to define a "scalar product" $(\cdot|\cdot)$
\begin{equation}
(\cdot|\cdot):\mathcal{F}_{1}\mathcal{\longrightarrow}\mathbb{C}%
I_{\mathcal{F}}%
\end{equation}
between vectors as
\begin{equation}
(C_{1}|D_{1})=\frac{1}{2}\left\{  C_{1},D_{1}\right\}  .
\end{equation}
This scalar product can be extended to all of $\mathcal{F}$ by using the
exterior algebra property of $\mathcal{F}$ (i.e. $\mathcal{F=}\wedge\left(
\mathcal{F}_{1}\right)  ).$

The basis $\left\{  \left.  x_{j}\right\vert \,1\leq j\leq2r\right\}  $ is
"orthogonal" with respect to this scalar product i.e.
\begin{equation}
(x_{j}|x_{k})=x_{j}\vee x_{k}=\frac{1}{2}\left\{  x_{j}x_{k}+x_{k}%
x_{j}\right\}  =\left\{  x_{j},x_{k}\right\}  =\frac{1}{2}\delta
_{jk}I_{\mathcal{F}};1\leq j\leq2r,
\end{equation}
but not normalized. One can define normalized vectors by
\begin{equation}
\tilde{x}_{j}=\sqrt{2}x_{j};1\leq j\leq2r,
\end{equation}
but these vectors do not satisfy the CAR as
\[
\left\{  \tilde{x}_{j},\tilde{x}_{k}\right\}  =2\delta_{jk}I_{\mathcal{F}}.
\]


One can expand any two vectors $C_{1}$ and $D_{1}$ in terms of this
orthonormal basis as
\begin{align}
C_{1}  &  =\sum_{1\leq j\leq2r}c_{j}\tilde{x}_{j}\\
D_{1}  &  =\sum_{1\leq j\leq2r}\mathfrak{d}_{j}\tilde{x}_{j}%
\end{align}
and obtain
\begin{equation}
(C_{1}|D_{1})=(D_{1}|C_{1})=\sum_{1\leq j\leq2r}c_{j}\mathfrak{d}%
_{j}I_{\mathcal{F}}=\left(  \left(  C_{1}|D_{1}\right)  \right)
I_{\mathcal{F}}.
\end{equation}


The CAR's can then be expressed in terms of this scalar product as
\begin{equation}
\left\{  C_{1},D_{1}\right\}  =\sum_{1\leq j,k\leq2r}c_{j}d_{k}\left\{
\tilde{x}_{j},\tilde{x}_{k}\right\}  I_{\mathcal{F}}=\sum_{1\leq j\leq2r}%
c_{j}\mathfrak{d}_{j}I_{\mathcal{F}}=2(C_{1}|D_{1}).
\end{equation}


The invariance group of the scalar product $(\cdot|\cdot)$ is $O\left(
2r,\mathbb{C}\right)  .$

One can define a quadratic function $Q$ in terms of this scalar product by
\begin{equation}
Q\left(  C_{1}\right)  =\left(  C_{1}\left\vert C_{1}\right.  \right)
\end{equation}
and then one can recover the scalar product by using the polarization
identity
\begin{equation}
\left(  C_{1}\left\vert D_{1}\right.  \right)  =Q\left(  C_{1}+D_{1}\right)
-Q\left(  C_{1}\right)  -Q\left(  D_{1}\right)  .
\end{equation}


\subsection{Contraction}

Left and right contraction are defined by
\begin{align*}
v\rfloor D  &  =\frac{1}{2}\left\{  vD-\hat{D}v\right\} \\
v\lfloor D  &  =\frac{1}{2}\left\{  Dv-v\hat{D}\right\}  ,
\end{align*}
where the \emph{grade involution operation }%
\[
\widehat{}:D\rightarrow\hat{D},
\]
is defined by
\begin{align*}
D  &  =\sum_{0\leq n\leq2r}D_{n}\\
\hat{D}_{n}  &  =\left(  -1\right)  ^{n}D_{n}.
\end{align*}
The scalar products
\begin{align}
\left(  A\left\vert B\right.  \right)   &  =\left\langle A^{t}B\right\rangle
_{0}\\
\left\langle A\left\vert B\right.  \right\rangle  &  =\left\langle A^{\dagger
}B\right\rangle _{0}%
\end{align}
can be expressed in terms of the contraction operation.

Contraction can be generalized to act between any elements of the G{}A by
\begin{align}
A\rfloor B  &  =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q}\\
A\lfloor B  &  =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{q-p}.
\end{align}


\subsection{Wedge Product}

The wedge product \emph{between vectors} is defined as the antisymmetric part
of the operator product i.e.
\[
C_{1}\wedge D_{1}=\left\langle C_{1}D_{1}\right\rangle _{2}=\frac{1}{2}\left[
C_{1},D_{1}\right]  \text{ (only for vectors, definately does not work for
grade 0 elements)}%
\]
and \emph{might NOT }correspond to the operator wedge product of operators of
degree 1 (vectors in the Geometric Algebra) induced by the underlying exterior
algebra, $\mathcal{H}_{\mathcal{F}},$ of $\mathcal{F}.$ In general the wedge
product in a Clifford algebra is defined by
\begin{equation}
C\wedge D\equiv C\overset{vec}{\wedge}D=\sum\limits_{0\leq m,n\leq
2r}\left\langle C_{m}D_{n}\right\rangle _{m+n}.
\end{equation}
In order to investigate this we consider the first quantized expansions of the
creation and annihilation operators
\begin{align}
a_{1}^{\dagger}  &  =\left\vert \varphi_{1}\right\rangle \left\langle
\phi\right\vert +\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-1}%
<r}\left\vert \varphi_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle
\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert ,\\
a_{1}  &  =\left\vert \phi\right\rangle \left\langle \varphi_{1}\right\vert
+\sum_{2\leq n\leq r}\sum_{2\leq j_{1}<\cdots<j_{n-1}<r}\left\vert
\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\rangle \left\langle \varphi
_{1}\varphi_{j_{1}}\cdots\varphi_{j_{n-1}}\right\vert .
\end{align}
Then the GA\ wedge product between a creator and an annihilator gives%

\begin{equation}
a_{1}^{\dagger}\wedge a_{1}=\frac{1}{2}\left[  a_{1}^{\dagger},a_{1}\right]
