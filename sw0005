n\leq2r,g\in O\left(  2r,\mathbb{R}\right)  .
\end{equation}
The subgroup $U\left(  r\right)  $ is a maximal compact subgroup of $O\left(
2r,\mathbb{R}\right)  $ and one can consider the coset $O\left(
2r,\mathbb{R}\right)  /U\left(  r\right)  $ and thus the $O\left(
2r,\mathbb{R}\right)  /U\left(  r\right)  $-Coherent States
\begin{equation}
