\section{Zeon Algebra}

\qquad The symmetric tensor algebra formed from the even Fock algebra
\begin{equation}
\mathcal{F}_{+}=%
%TCIMACRO{\dbigwedge \limits_{0\leq p\leq2r}}%
%BeginExpansion
{\displaystyle\bigwedge\limits_{0\leq p\leq2r}}
%EndExpansion
\mathcal{F}_{2p}%
\end{equation}
is a \emph{Zeon algebra} as
\begin{equation}
\left\langle A\right\rangle _{2p}\wedge\left\langle B\right\rangle
_{2q}=(-1)^{2\left(  p+q\right)  }\left\langle B\right\rangle _{2q}%
\wedge\left\langle A\right\rangle _{2p}=\left\langle B\right\rangle
_{2q}\wedge\left\langle A\right\rangle _{2p}%
\end{equation}
and is generated by
\begin{equation}
\left\{  \left.  e_{jk}\right\vert e_{jk}=e_{j}\wedge e_{k}=e_{j}e_{k};1\leq
j<k\leq2r\right\}  \text{ and }I_{\mathcal{F}},
\end{equation}
where
\begin{equation}
\left(  e_{jk}\right)  ^{2}=\left(  e_{jk}\right)  ^{2\wedge}=0
\end{equation}
