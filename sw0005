\section{Canonical Anti Commutation Relationship (CAR)}

The \emph{Canonical Anticommutation Relationships} are for a given conb
$\left\{  \left.  \left\vert \varphi_{j}\right\rangle \right\vert 1\leq j\leq
r\right\}  $ of $\mathcal{H}^{1}$
\begin{subequations}
\label{CAR}%
\begin{align}
\left\{  a_{j},a_{k}^{\dagger}\right\}   &  =\delta_{jk}I_{\mathcal{F}%
}\label{CAR1}\\
\left\{  a_{j}^{\dagger},a_{k}^{\dagger}\right\}   &  =\left\{  a_{j}%
,a_{k}\right\}  =0\label{CAR2}\\
1  &  \leq j\leq r,
\end{align}
where
\end{subequations}
\begin{equation}
\left\{  A,B\right\}  =AB+BA,
\end{equation}
the creation operators $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq
j\leq r\right\}  $ are defined by their action on \emph{normalized} vectors
$\left\vert \Psi\right\rangle \in\mathcal{H}_{\mathcal{F}}$ by
\begin{equation}
a_{j}^{\dagger}\left\vert \Psi\right\rangle =\left\vert \varphi_{j}\wedge
\Psi\right\rangle \label{CREAT}%
\end{equation}
and the annihilation operators $\left\{  \left.  a_{j}\right\vert 1\leq j\leq
r\right\}  $ are defined as their adjoints i.e.
\begin{equation}
a_{j}=\left(  a_{j}^{\dagger}\right)  ^{\dagger},\,1\leq j\leq r.
\end{equation}


\subsubsection{Comments}

\begin{itemize}
\item The operators $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq j\leq
r\right\}  $ are bounded so have bounded adjoints $\left\{  \left.
a_{j}\right\vert 1\leq j\leq r\right\}  $ and hence
\begin{equation}
a_{j}^{\dagger}=\left(  a_{j}\right)  ^{\dagger}.
\end{equation}


\item In particular it follows from the definition eq. $\left(  \ref{CREAT}%
\right)  $ and eq. $\left(  \ref{CAR1}\right)  $ that
\begin{align}
a_{j}^{\dagger}\left\vert \phi\right\rangle  &  =\left\vert \varphi
_{j}\right\rangle \nonumber\\
a_{j}\left\vert \phi\right\rangle  &  =0\nonumber\\
1  &  \leq j\leq r.
\end{align}


This follows from
\begin{equation}
\left\langle \left.  \phi\right\vert a_{j}^{\dagger}a_{j}\phi\right\rangle
=\left\langle \phi\left\vert \left(  I_{\mathcal{F}}-a_{j}a_{j}^{\dagger
}\right)  \right.  \phi\right\rangle =0,
\end{equation}
which implies that
\begin{equation}
a_{j}\left\vert \phi\right\rangle =0.
\end{equation}


\item $a_{j}^{\dagger}$ and $a_{j}$ are partial isometries, (and generate the
Fermion Fock algebra), as
\begin{equation}
a_{j}^{\dagger}a_{j}\text{ and }a_{j}a_{j}^{\dagger}%
\end{equation}
are projectors and equivalently
\begin{equation}
a_{j}a_{j}^{\dag}a_{j}=a_{j}\left(  1-a_{j}a_{j}^{\dag}\right)  =a_{j}.
\end{equation}
In this particular case
\begin{align}
a_{j}^{\dag}a_{j}+a_{j}a_{j}^{\dag} &  =I_{F},\\
a_{j}^{\dag}a_{j}a_{j}a_{j}^{\dag} &  =0\\
a_{j}a_{j}^{\dag}a_{j}^{\dag}a_{j} &  =0,
\end{align}
the projectors $a_{j}^{\dag}a_{j}$ and $a_{j}a_{j}^{\dag}$ are orthogonal as
$a_{j}^{\dag}a_{j}a_{j}a_{j}^{\dag}=a_{j}^{\dag}a_{j}\left(  1-a_{j}^{\dag
}a_{j}\right)  =a_{j}^{\dag}a_{j}-a_{j}^{\dag}a_{j}=0$ and are also infinite dimensional.
\end{itemize}

One can set the operators $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq
j\leq r\right\}  $ as the values of the \emph{complex linear map}
\begin{equation}
\Phi^{\dagger}:\mathcal{H}^{1}\rightarrow\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)
\end{equation}
i.e.
\begin{equation}
a_{j}^{\dagger}=\Phi^{\dagger}\left(  \left\vert \varphi_{j}\right\rangle
\right)  ,
\end{equation}
which leads to a more general (basis free) form of the CAR
\begin{subequations}
\begin{align}
\left\{  \Phi\left(  \left\vert u\right\rangle \right)  ,\Phi^{\dagger}\left(
\left\vert v\right\rangle \right)  \right\}   &  =\left\langle \left.
u\right\vert v\right\rangle I_{\mathcal{F}}\\
\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}   &
=\left\{  \Phi\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  =0\\
\forall\left\vert u\right\rangle ,\left\vert v\right\rangle  &  \in
\mathcal{H}^{1}.
\end{align}


The $c^{\ast}$-algebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
,$ (which is a $w^{\ast}$-algebra), is generated by the basis $\left\{
\left.  a_{j},a_{j}^{\dagger}\right\vert 1\leq j\leq r\right\}  .$ A map $T$
is a $c^{\ast}$-algebra isomorphism if
\end{subequations}
\begin{align}
T  &  \in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right) \\
T\left(  XY\right)   &  =T\left(  X\right)  T\left(  Y\right) \\
T\left(  X^{\dagger}\right)   &  =T\left(  X\right)  ^{\dagger}\\
T^{-1}T  &  =Id,
\end{align}
where the norm of $T$ is defined by
\begin{equation}
\left\Vert T\right\Vert =\sup_{\left\Vert X\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=1}\left\Vert T\left(  X\right)
\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }.
\end{equation}
In particular one can see that
\begin{equation}
T\left(  I_{\mathcal{F}}\right)  =I_{\mathcal{F}}%
\end{equation}
and
\begin{subequations}
\label{CAR}%
\begin{align}
\left\{  T\left(  a_{j}\right)  ,T\left(  a_{k}^{\dagger}\right)  \right\}
&  =T\left(  \left\{  a_{j},a_{k}^{\dagger}\right\}  \right)  =\delta
_{jk}T\left(  I_{\mathcal{F}}\right) \\
T\left(  \left\{  a_{j}^{\dagger},a_{k}^{\dagger}\right\}  \right)   &
=T\left(  \left\{  a_{j},a_{k}\right\}  \right)  =0\\
1  &  \leq j,k\leq r.
\end{align}
One can note that
\end{subequations}
\begin{equation}
\left\Vert a_{j}\right\Vert =\left\Vert a_{j}^{\dagger}\right\Vert =1.
\end{equation}


\section{Fat Symbol Notation}

\subsection{Transpose}%

\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  ^{t}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}^{t}\\
\mathbf{x}_{2}^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1}^{t}\mathbf{x}_{1} & \mathbf{x}_{1}^{t}\mathbf{x}_{2}\\
\mathbf{x}_{2}^{t}\mathbf{x}_{1}^{t} & \mathbf{x}_{2}\mathbf{x}_{2}%
\end{array}
\right)  .
\end{equation}
i.e.
\begin{align}
&  \left(
\begin{array}
[c]{cc}%
\left(  \mathbf{x}_{11},\mathbf{x}_{12}\right)   & \left(  \mathbf{x}%
_{21},\mathbf{x}_{22}\right)
\end{array}
\right)  ^{t}\left(
\begin{array}
[c]{cc}%
\left(  \mathbf{x}_{11},\mathbf{x}_{12}\right)   & \left(  \mathbf{x}%
_{21},\mathbf{x}_{22}\right)
\end{array}
\right)  \\
&  =\left(
\begin{array}
[c]{c}%
\left(  \mathbf{x}_{11},\mathbf{x}_{12}\right)  ^{t}\\
\left(  \mathbf{x}_{21},\mathbf{x}_{22}\right)  ^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\left(  \mathbf{x}_{11},\mathbf{x}_{12}\right)   & \left(  \mathbf{x}%
_{21},\mathbf{x}_{22}\right)
\end{array}
\right)  \\
&  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
\mathbf{x}_{11}^{t}\\
\mathbf{x}_{12}^{t}%
\end{array}
\right)  \\
\left(
\begin{array}
[c]{c}%
\mathbf{x}_{21}^{t}\\
\mathbf{x}_{22}^{t}%
\end{array}
\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\left(  \mathbf{x}_{11},\mathbf{x}_{12}\right)   & \left(  \mathbf{x}%
_{21},\mathbf{x}_{22}\right)
\end{array}
\right)  .
\end{align}
Consider the linear transformation
\begin{equation}
T\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
T\mathbf{x}_{1} & T\mathbf{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathbb{T=}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1}\mathbb{T}_{11}+\mathbf{x}_{2}\mathbb{T}_{21} & \mathbf{x}%
_{1}\mathbb{T}_{12}+\mathbf{x}_{2}\mathbb{T}_{22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  ,
\end{equation}
where
\begin{equation}
\mathbb{T=}\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  .
\end{equation}
In more detail
\begin{align}
T\left(  \mathbf{x}_{1}\right)   &  =\mathbf{x}_{1}\mathbb{T}_{11}%
+\mathbf{x}_{2}\mathbb{T}_{21}\\
T\left(  \mathbf{x}_{2}\right)   &  =\mathbf{x}_{1}\mathbb{T}_{12}%
+\mathbf{x}_{2}\mathbb{T}_{22},
\end{align}
where%
\begin{align}
\sum_{j}x_{1j}\mathbb{T}_{11jk} &  =\sum_{j}\mathbb{T}_{11jk}x_{1j}=\sum
_{j}\left(  \mathbb{T}_{11}^{t}\right)  _{kj}x_{1j}\\
\sum_{j}x_{2j}\mathbb{T}_{21jk} &  =\sum_{j}\mathbb{T}_{21jk}x_{2j}=\sum
_{j}\left(  \mathbb{T}_{21}^{t}\right)  _{kj}x_{2j}%
\end{align}%
\begin{align}
\sum_{j}x_{1j}\mathbb{T}_{12jk} &  =\sum_{j}\mathbb{T}_{12jk}x_{1j}=\sum
_{j}\left(  \mathbb{T}_{12}^{t}\right)  _{kj}x_{1j}\\
\sum_{j}x_{2j}\mathbb{T}_{22jk} &  =\sum_{j}\mathbb{T}_{22jk}x_{2j}=\sum
_{j}\left(  \mathbb{T}_{22}^{t}\right)  _{kj}x_{2j}%
\end{align}
hence%
\begin{align}
\left(  \mathbf{x}_{1}\mathbb{T}_{11}\right)  ^{t} &  =\mathbb{T}_{11}%
^{t}\mathbf{x}_{1}^{t}\\
\left(  \mathbf{x}_{2}\mathbb{T}_{21}\right)  ^{t} &  =\mathbb{T}_{21}%
^{t}\mathbf{x}_{2}^{t}\\
\left(  \mathbf{x}_{1}\mathbb{T}_{12}\right)  ^{t} &  =\mathbb{T}_{12}%
^{t}\mathbf{x}_{1}^{t}\\
\left(  \mathbf{x}_{2}\mathbb{T}_{22}\right)  ^{t} &  =\mathbb{T}_{22}%
^{t}\mathbf{x}_{2}^{t},
\end{align}%
\begin{align}
\left(  T\left(  \mathbf{x}_{1}\right)  \right)  ^{t} &  =\left(
\mathbf{x}_{1}\mathbb{T}_{11}+\mathbf{x}_{2}\mathbb{T}_{21}\right)
^{t}=\mathbb{T}_{11}^{t}\mathbf{x}_{1}^{t}+\mathbb{T}_{21}^{t}\mathbf{x}%
_{2}^{t}\\
\left(  T\left(  \mathbf{x}_{2}\right)  \right)  ^{t} &  =\left(
\mathbf{x}_{1}\mathbb{T}_{12}+\mathbf{x}_{2}\mathbb{T}_{22}\right)
^{t}=\mathbb{T}_{12}^{t}\mathbf{x}_{1}^{t}+\mathbb{T}_{22}^{t}\mathbf{x}%
_{2}^{t},
\end{align}
and
\begin{equation}
\left(  T\left(  \mathbf{x}\right)  \right)  ^{t}=\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11}^{t} & \mathbb{T}_{21}^{t}\\
\mathbb{T}_{12}^{t} & \mathbb{T}_{22}^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}^{t}\\
\mathbf{x}_{2}^{t}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  ^{t}\left(
\begin{array}
[c]{c}%
\mathbf{x}_{1}^{t}\\
\mathbf{x}_{2}^{t}%
\end{array}
\right)  =\left(  \left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  \right)  ^{t}.
\end{equation}
This gives
\begin{align}
&  \left(
\begin{array}
[c]{c}%
\mathbf{y}_{1}^{t}\\
\mathbf{y}_{2}^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  =\left(  \left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathbb{T}\right)  ^{t}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathbb{T=T}^{t}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  ^{t}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathbb{T}\nonumber\\
&  =\mathbb{T}^{t}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1}^{t}\mathbf{x}_{1} & \mathbf{x}_{1}^{t}\mathbf{x}_{2}\\
\mathbf{x}_{2}^{t}\mathbf{x}_{1}^{t} & \mathbf{x}_{2}\mathbf{x}_{2}%
\end{array}
\right)  \mathbb{T=}\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  ^{t}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1}^{t}\mathbf{x}_{1} & \mathbf{x}_{1}^{t}\mathbf{x}_{2}\\
\mathbf{x}_{2}^{t}\mathbf{x}_{1}^{t} & \mathbf{x}_{2}\mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11}^{t} & \mathbb{T}_{21}^{t}\\
\mathbb{T}_{12}^{t} & \mathbb{T}_{22}^{t}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1}^{t}\mathbf{x}_{1} & \mathbf{x}_{1}^{t}\mathbf{x}_{2}\\
\mathbf{x}_{2}^{t}\mathbf{x}_{1}^{t} & \mathbf{x}_{2}\mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{1}+\mathbb{T}_{21}%
^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{1} & \mathbb{T}_{11}^{t}\mathbf{x}_{1}%
^{t}\mathbf{x}_{2}+\mathbb{T}_{21}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{2}\\
\mathbb{T}_{12}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{1}+\mathbb{T}_{22}%
^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{1} & \mathbb{T}_{12}^{t}\mathbf{x}_{1}%
^{t}\mathbf{x}_{2}+\mathbb{T}_{22}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11} & \mathbb{T}_{12}\\
\mathbb{T}_{21} & \mathbb{T}_{22}%
\end{array}
\right)  \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{T}_{11}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{1}\mathbb{T}_{11}%
+\mathbb{T}_{21}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{1}\mathbb{T}_{11}%
+\mathbb{T}_{11}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{2}\mathbb{T}_{21}%
+\mathbb{T}_{21}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{2}\mathbb{T}_{21} &
\mathbb{T}_{11}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{1}\mathbb{T}_{12}%
+\mathbb{T}_{21}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{1}\mathbb{T}_{12}%
+\mathbb{T}_{11}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{2}\mathbb{T}_{22}%
+\mathbb{T}_{21}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{2}\mathbb{T}_{22}\\
\mathbb{T}_{12}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{1}\mathbb{T}_{11}%
+\mathbb{T}_{22}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{1}\mathbb{T}_{11}%
+\mathbb{T}_{12}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{2}\mathbb{T}_{21}%
+\mathbb{T}_{22}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{2}\mathbb{T}_{21} &
\mathbb{T}_{12}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{1}\mathbb{T}_{12}%
+\mathbb{T}_{22}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{1}\mathbb{T}_{12}%
+\mathbb{T}_{12}^{t}\mathbf{x}_{1}^{t}\mathbf{x}_{2}\mathbb{T}_{22}%
+\mathbb{T}_{22}^{t}\mathbf{x}_{2}^{t}\mathbf{x}_{2}\mathbb{T}_{22}%
\end{array}
\right)  .
\end{align}


\subsection{Adjoint}%

\begin{equation}
