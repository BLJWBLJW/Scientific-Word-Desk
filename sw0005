\mathbf{x}_{11}^{\dagger}\\
\mathbf{x}_{12}^{\dagger}%
\end{array}
\right) \\
\left(
\begin{array}
[c]{c}%
\mathbf{x}_{21}^{\dagger}\\
\mathbf{x}_{22}^{\dagger}%
