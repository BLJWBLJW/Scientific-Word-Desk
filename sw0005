\subsection{$K$ is a Linear Map but Not an Algebra Map}

The $K$ transformation is
\begin{equation}
\left(  \mathbf{x}\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =K\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
K\left(  \mathbf{a}^{\dagger}\right)  & K\left(  \mathbf{a}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathbb{K},
\end{equation}
so in particular
\begin{align}
x_{k}  &  =K\left(  a_{k}^{\dagger}\right)  ;1\leq k\leq r\\
x_{k+r}  &  =K\left(  a_{k}\right)  ;1\leq k\leq r
\end{align}
thus
\begin{equation}
x_{1}x_{1}=K\left(  a_{1}^{\dagger}\right)  K\left(  a_{1}^{\dagger}\right)
=\frac{1}{2}\mathbb{I}_{r}\neq K\left(  a_{1}^{\dagger}a_{1}^{\dagger}\right)
=0.
\end{equation}
However it is algebraic on products of different basis elements as
\begin{align}
a_{1}^{\dagger}a_{2}^{\dagger}  &  =a_{1}^{\dagger}\wedge a_{2}^{\dagger}\\
x_{1}x_{2}  &  =K\left(  a_{1}^{\dagger}\right)  K\left(  a_{2}^{\dagger
}\right)  =K\left(  a_{1}^{\dagger}\right)  \wedge K\left(  a_{2}^{\dagger
}\right)  =\frac{1}{\sqrt{2}}\left(  a_{1}^{\dagger}+a_{1}\right)  \frac
{1}{\sqrt{2}}\left(  a_{2}^{\dagger}+a_{2}\right)  =\frac{1}{2}\left(
a_{1}^{\dagger}a_{2}^{\dagger}+a_{1}^{\dagger}a_{2}+a_{1}a_{2}^{\dagger}%
+a_{1}a_{2}\right)
\end{align}
and
\begin{equation}
\left(  K\wedge K\right)  \left(  a_{1}^{\dagger}a_{2}^{\dagger}\right)
=K\left(  a_{1}^{\dagger}\right)  \wedge K\left(  a_{2}^{\dagger}\right)
=\frac{1}{\sqrt{2}}\left(  a_{1}^{\dagger}+a_{1}\right)  \wedge\frac{1}%
{\sqrt{2}}\left(  a_{2}^{\dagger}+a_{2}\right)  =\frac{1}{2}\left(
a_{1}^{\dagger}a_{2}^{\dagger}+a_{1}^{\dagger}a_{2}+a_{1}a_{2}^{\dagger}%
+a_{1}a_{2}\right)  =K\left(  a_{1}^{\dagger}\right)  K\left(  a_{2}^{\dagger
}\right)  .
\end{equation}
One should note though that even on products of different basis elements it is
not a *-algebra map as
\begin{align}
K\left(  a_{1}\right)  ^{\dagger}  &  \neq K\left(  a_{1}^{\dagger}\right) \\
K\left(  a_{1}\right)  ^{\dagger}  &  =x_{3}\\
K\left(  a_{1}^{\dagger}\right)   &  =x_{1}.
\end{align}


