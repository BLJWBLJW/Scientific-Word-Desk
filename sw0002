\subsubsection{Exterior Algebra Generated by the GNS\ Construction}

The GNS\ Hilbert space generated by the state $f$
\begin{equation}
\Phi_{f}\left(  \mathcal{F}\right)  =\operatorname*{linspan}\left\{  \left.
\Phi_{f}\left(  A_{j}\right)  \right\vert 1\leq j\leq2^{2r}\right\}  ,
\end{equation}
where $\left\{  \left.  A_{j}\right\vert 1\leq j\leq2^{2r}\right\}  $ is a
basis for $\mathcal{F}$ and has metric matrix if $f$ is a normal state
\begin{equation}
\left\langle \left.  \Phi_{f}\left(  A_{j}\right)  \right\vert \Phi_{f}\left(
A_{k}\right)  \right\rangle =f\left(  A_{j}^{\dagger}A_{k}\right)
=\operatorname*{tr}\left\{  A_{j}^{\dagger}A_{k}D_{f}\right\}  ;1\leq
j,k\leq2^{2r}.
\end{equation}


$\mathcal{F}_{1}$ generates $\mathcal{F}$ via the exterior algebra
construction
\begin{equation}
\mathcal{F}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathcal{F}_{1}%
\end{equation}
and thus $\Phi_{f}\left(  \mathcal{F}\right)  $ by
\begin{equation}
\Phi_{f}\left(  \mathcal{F}\right)  =\Phi_{f}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathcal{F}_{1}\right)  .
\end{equation}
It is important to examine whether $\Phi_{f}$ is an exterior algebra map (thus
an exterior algebra homomorphism) i.e.
\begin{align}
\Phi_{f}\left(
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathcal{F}_{1}\right)   &  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\Phi_{f}\left(  \mathcal{F}_{1}\right) \\
\Phi_{f}\left(  A\wedge B\right)   &  =\Phi_{f}\left(  A\right)  \wedge
\Phi_{f}\left(  B\right) \\
\Phi_{f}\left(  \alpha A+\beta B\right)   &  =\alpha\Phi_{f}\left(  A\right)
+\beta\Phi_{f}\left(  B\right)  \forall A,B\in\mathcal{F},\alpha,\beta
\in\mathbb{C}.
\end{align}
This is straightforward and shown in Greub (chapter 5, second edition) for any
well defined exterior multiplication in $\mathcal{F}$ if $\Phi_{f}$ is linear
and is in fact a homomorphism i.e.
\begin{equation}
\Phi_{f}\left(  A\wedge B\right)  =\Phi_{f}\left(  A\right)  \wedge\Phi
_{f}\left(  B\right)  \,\forall A,B\in\mathcal{F},
\end{equation}
\emph{however we will show that }$\Phi_{f}$ is in some cases \emph{not} a
homomorphism and not an exterior algebra map $\mathcal{F\rightarrow}\Phi
_{f}\left(  \mathcal{F}\right)  $.

If $\Phi_{f}$ was an exterior algebra map and
\begin{equation}
B\in\ker\left\{  \Phi_{f}\right\}
\end{equation}
then
\begin{align}
\Phi_{f}\left(  A\wedge B\right)   &  =\Phi_{f}\left(  A\right)  \wedge
\Phi_{f}\left(  B\right)  =0,\forall A\in\mathcal{F},\forall\in\ker\left\{
\Phi_{f}\right\} \\
\Phi_{f}\left(  B\wedge A\right)   &  =\Phi_{f}\left(  B\right)  \wedge
\Phi_{f}\left(  A\right)  =0,\forall A\in\mathcal{F},\forall\in\ker\left\{
\Phi_{f}\right\}
\end{align}
and $\ker\left\{  \Phi_{f}\right\}  $ would be a $2$-sided ideal wrt
"$\wedge".$

Self adjoint, $\left\{  \mathbf{x_{1},x}_{2}\right\}  ,$ and non self adjoint,
$\left\{  \mathbf{a}^{\dagger},\mathbf{a}\right\}  ,$ splitting bases of
$\mathcal{F}_{1}$ generate $\mathcal{F}$ and $\Phi_{f}\left(  \mathcal{F}%
\right)  $ and have the following property
\begin{equation}
\Phi_{f}\left(  \mathcal{F}\right)  =\bigwedge\Phi_{f}\left(  \mathcal{F}%
_{1}\right)  =\bigwedge\left(  \Phi_{f}\left(  \mathbf{x}_{1}\oplus
_{\mathbb{C}}\mathbf{x}_{2}\cong\mathbf{x}_{1}+_{\mathbb{C}}\mathbf{x}%
_{2}\right)  \right)  =\bigwedge\Phi_{f}\left(  \mathbf{x}_{1}\right)
\otimes\bigwedge\Phi_{f}\left(  \mathbf{x}_{2}\right)  =\mathcal{H}_{f}%
\end{equation}
and%
\begin{equation}
\Phi_{f}\left(  \mathcal{F}\right)  =\bigwedge\Phi_{f}\left(  \mathcal{F}%
_{1}\right)  =\bigwedge\left(  \Phi_{f}\left(  \mathbf{a}^{\dagger
}+_{\mathbb{C}}\mathbf{a\cong a}^{\dagger}\oplus_{\mathbb{C}}\mathbf{a}%
