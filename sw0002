\mathcal{N}_{a},a_{j}^{\dagger}\right]  =\left[  \sum_{1\leq k\leq r}%
a_{k}^{\dagger}a_{k},a_{j}^{\dagger}\right]  =a_{j}^{\dagger}\\
\widehat{\mathcal{N}}_{a}\left(  a_{j}\right)   &  =\left[  \mathcal{N}%
_{a},a_{j}\right]  =\left[  \sum_{1\leq k\leq r}a_{k}^{\dagger}a_{k}%
,a_{j}^{\dagger}\right]  =-a_{j}\\
