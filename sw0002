}\overline{q}_{k_{1}\cdots k_{N_{a}}}\left\langle a_{j_{1}}^{\dagger}\cdots
a_{j_{N_{a}}}^{\dagger}a_{k_{N_{a}}}\cdots a_{k_{1}}\right\rangle _{4}.
\end{align}


\subsubsection{Evolution Equations}

Time dependent operators generated by unitary evolution operators e.g. in the
case of one particle Hamiltonians
\begin{equation}
\prod_{1\leq j\leq N}a_{j}^{\dagger}\left(  t\right)  =\widehat{u}_{H}\left(
t\right)  \left(  \prod_{1\leq j\leq N}a_{j}^{\dagger}\right)  =\prod_{1\leq
j\leq N}\widehat{u}_{H}\left(  t\right)  \left(  a_{j}^{\dagger}\right)  ,
\end{equation}
satisfy the EOM
\begin{gather}
A\left(  t\right)  =\widehat{u}_{H}\left(  t\right)  \left(  A\right)
=\exp\left\{  iHt\right\}  A\exp\left\{  -iHt\right\}  =\exp\left\{
i\operatorname{adj}\left(  H\right)  t\right\}  \left(  A\right) \\
\Downarrow\\
-i\frac{dA\left(  t\right)  }{dt}=-\left[  H,A\left(  t\right)  \right]  .
\end{gather}
Hence in particular
\begin{align}
-i\frac{d}{dt}\left\{  Q\left(  t\right)  Q\left(  t\right)  ^{\dagger
}\right\}   &  =\frac{dQ\left(  t\right)  }{dt}Q\left(  t\right)  ^{\dagger
}+Q\left(  t\right)  \frac{dQ^{\dagger}\left(  t\right)  }{dt}=\left[
H,Q\left(  t\right)  \right]  Q\left(  t\right)  ^{\dagger}+Q\left(  t\right)
\left[  H,Q^{\dagger}\left(  t\right)  \right] \\
&  =HQ\left(  t\right)  Q\left(  t\right)  ^{\dagger}-Q\left(  t\right)
HQ\left(  t\right)  ^{\dagger}+Q\left(  t\right)  HQ^{\dagger}\left(
t\right)  -Q\left(  t\right)  Q^{\dagger}\left(  t\right)  H=\left[
H,Q\left(  t\right)  Q^{\dagger}\left(  t\right)  \right]  ,
\end{align}
giving
\begin{equation}
-i\frac{d}{dt}D\left(  t\right)  =\left[  H,D\left(  t\right)  \right]
=\widehat{H}\left(  D\left(  t\right)  \right)  .
\end{equation}
The time evolution of basis elements generated by one particle Hamiltonians is
given by
\begin{align}
\widehat{u}_{H}\left(  t\right)  \left(  \prod_{1\leq j\leq N}a_{j}^{\dagger
}\right)   &  =\prod_{1\leq j\leq N}\widehat{u}_{H}\left(  t\right)  \left(
a_{j}^{\dagger}\right)  =\prod_{1\leq j\leq N}a_{j}^{\dagger}\left(  t\right)
\\
-i\frac{d}{dt}\left(  \prod_{1\leq j\leq N}a_{j}^{\dagger}\left(  t\right)
\right)   &  =\left[  H,\prod_{1\leq j\leq N}a_{j}^{\dagger}\left(  t\right)
\right] \\
-i\frac{d}{dt}\left(  \prod_{1\leq j\leq N}a_{j}^{\dagger}\left(  t\right)
\right)   &  =\left[  H,a_{1}^{\dagger}\left(  t\right)  \right]  \left(
\prod_{2\leq j\leq N}a_{j}^{\dagger}\left(  t\right)  \right)  +a_{1}%
^{\dagger}\left(  t\right)  \left[  H,a_{2}^{\dagger}\left(  t\right)
\right]  \left(  \prod_{3\leq j\leq N}a_{j}^{\dagger}\left(  t\right)
\right)  +\\
&  \cdots+\left(  \prod_{1\leq j\leq p}a_{j}^{\dagger}\left(  t\right)
\right)  \left[  H,a_{p+1}^{\dagger}\left(  t\right)  \right]  \left(
\prod_{p+2\leq j\leq N}a_{j}^{\dagger}\left(  t\right)  \right)
+\cdots+\left(  \prod_{1\leq j\leq N-1}a_{j}^{\dagger}\left(  t\right)
\right)  \left[  H,a_{N}^{\dagger}\left(  t\right)  \right] \\
&  =\left(  -i\frac{d}{dt}a_{1}^{\dagger}\left(  t\right)  \right)  \left(
\prod_{2\leq j\leq N}a_{j}^{\dagger}\left(  t\right)  \right)  +\cdots+\left(
\prod_{1\leq j\leq N-1}a_{j}^{\dagger}\left(  t\right)  \right)  \left(
-i\frac{d}{dt}a_{N}^{\dagger}\left(  t\right)  \right)  .
\end{align}


\subsubsection{Eigen Vector Equations{}}

$Q\in\mathcal{F}$ is an eigen operator of the operator $\widehat{H}%
:\mathcal{F}\rightarrow$ $\mathcal{F}$ if
\begin{equation}
\widehat{H}\left(  Q\right)  =\left[  H,Q\right]  =EI_{\mathcal{F}}.
\end{equation}
It is \emph{IMPORTANT to note that }%
\begin{align}
\widehat{H}\left(  Q_{1}\right)  Q_{2}  &  =\left[  H,Q_{1}\right]
Q_{2}=HQ_{1}Q_{2}-Q_{1}HQ_{2}\\
\widehat{H}\left(  Q_{1}Q_{2}\right)   &  =\left[  H,Q_{1}\right]  Q_{2}%
+Q_{1}\left[  H,Q_{2}\right]  =HQ_{1}Q_{2}-Q_{1}HQ_{2}+Q_{1}HQ_{2}-Q_{1}%
Q_{2}H=\left[  H,Q_{1}Q_{2}\right]
\end{align}
thus in general
\begin{equation}
\widehat{H}\left(  Q_{1}\right)  Q_{2}\neq\widehat{H}\left(  Q_{1}%
Q_{2}\right)  .
\end{equation}


Density Operators $D$ are \emph{Stationary }wrt a unitary time evolution
generated by $H$ if
\begin{equation}
-i\frac{d}{dt}D\left(  t\right)  =\left[  H,D\left(  t\right)  \right]
=\widehat{H}\left(  D\left(  t\right)  \right)  =0,
\end{equation}
i.e.
\begin{equation}
D\left(  t\right)  =D,
\end{equation}
where
\begin{equation}
D\left(  t\right)  =\widehat{u}\left(  D\right)  =u\left(  t\right)  Du\left(
t\right)  ^{\dagger}\equiv\exp\left\{  -i\widehat{H}t\right\}  \left(
D\right)  .
\end{equation}
Density operators are positive and normalized i.e.
\begin{equation}
D=\frac{QQ^{\dagger}}{\left\langle \left\langle QQ^{\dagger}\right\rangle
\right\rangle _{0}}=\frac{QQ^{\dagger}}{\operatorname*{tr}\left\{
QQ^{\dagger}\right\}  }=\widetilde{Q}\widetilde{Q}^{\dagger}.
\end{equation}
$\widetilde{Q}$ are defined up to unitary transformation that change the phase
of $\widetilde{Q}$ i.e.
\begin{equation}
\widehat{v}\left(  \widetilde{Q}\right)  =v\widetilde{Q}v^{\dagger}%
=e^{i\theta}\widetilde{Q},
\end{equation}
where
\begin{equation}
v=\exp\left\{  i\eta\right\}  ;\quad\eta=\eta^{\dagger}%
\end{equation}
and that leaves the density operator invariant
\begin{equation}
\widehat{v}\left(  D\right)  =v\widetilde{Q}v^{\dagger}v\widetilde{Q}%
^{\dagger}v^{\dagger}=vDv^{\dagger}=e^{i\theta}\widetilde{Q}\widetilde{Q}%
^{\dagger}e^{-i\theta}=D.
\end{equation}
Thus
\begin{equation}
\left[  \eta,D\right]  =0
\end{equation}
and%
\begin{equation}
\widehat{\eta}\left(  \widetilde{Q}\right)  =\left[  \eta,\widetilde{Q}%
\right]  =\theta\widetilde{Q}%
\end{equation}
i.e.
\begin{equation}
\widetilde{Q}\equiv\widetilde{Q}_{\theta}.
\end{equation}
One can also observe that
\begin{align}
v\widetilde{Q}  &  =e^{i\theta}\widetilde{Q}v\\
\left(  v\widetilde{Q}\right)  ^{\dagger}  &  =\left(  e^{i\theta
}\widetilde{Q}v\right)  ^{\dagger}\\
&  \Updownarrow\\
\widetilde{Q}v^{\dagger}  &  =e^{-i\theta}v^{\dagger}\widetilde{Q}^{\dagger}.
\end{align}


\begin{theorem}%
\begin{gather}
D=\widehat{v}\left(  D\right)  =v\widetilde{Q}v^{\dagger}v\widetilde{Q}%
^{\dagger}v^{\dagger}=vDv^{\dagger}\\
\Updownarrow\\
\widehat{v}\left(  \widetilde{Q}\right)  =v\widetilde{Q}v^{\dagger}%
=e^{i\theta}\widetilde{Q}.
\end{gather}

\end{theorem}

This gives the important corollary that shows in particular that time
stationarity is equivalent to an eigen value problem.

\begin{corollary}%
\begin{gather}
\widehat{v}\left(  \widetilde{Q}\right)  =v\widetilde{Q}v^{\dagger}%
=e^{i\theta}\widetilde{Q}\\
\Updownarrow\\
\widehat{\eta}\left(  \widetilde{Q}\right)  =\theta\widetilde{Q}.
\end{gather}

\end{corollary}

\subsubsection{Optimization Formulation of Eigenvalue Problem}

The variational problem that is associated with time stationarity is
\begin{equation}
\min\limits_{Q}\left\{  \frac{\left\langle Q\left\vert \widehat{H}\left(
Q\right)  \right.  \right\rangle _{\mathcal{F}}}{\left\langle Q\left\vert
Q\right.  \right\rangle _{\mathcal{F}}}\right\}  =\min\limits_{\left\langle
Q\left\vert Q\right.  \right\rangle _{\mathcal{F}}=1}\left\{  \left\langle
Q\left\vert \widehat{H}\left(  Q\right)  \right.  \right\rangle _{\mathcal{F}%
}\right\}  =\max\limits_{\lambda}\min\limits_{Q}\left\{  \left\langle
Q\left\vert \widehat{H}\left(  Q\right)  \right.  \right\rangle _{\mathcal{F}%
}-\lambda\left(  \left\langle Q\left\vert Q\right.  \right\rangle
_{\mathcal{F}}-1\right)  \right\}  .
\end{equation}
The sufficient condition for $Q$ to be a energy stationary operator, in the
sense of optimization, with energy $E$ is thus
\begin{equation}
\left(  \widehat{H}-EI_{\mathcal{F}}\right)  Q=0,
\end{equation}
i.e.
\begin{equation}
\widehat{H}\left(  Q\right)  =EQ.
\end{equation}
This a minimum if
\begin{equation}
\left(  \widehat{H}-EI_{\mathcal{F}}\right)  \geq0
\end{equation}
otherwise it is stationary.

One should observe%
\begin{align}
\widehat{H}\left(  Q^{\dagger}\right)   &  =HQ^{\dagger}-Q^{\dagger}H\\
\left(  \widehat{H}\left(  Q\right)  \right)  ^{\dagger}  &  =\left(
HQ-QH\right)  ^{\dagger}=Q^{\dagger}H-HQ^{\dagger}=-\widehat{H}\left(
Q^{\dagger}\right)
\end{align}
hence if $E_{k}$ is an eigenvalue associated to eigenoperator $Q_{k},$
$-E_{k}$ is an eigenvalue associated to the eigenoperator $Q_{k}^{\dagger}$
i.e.
\begin{equation}
\widehat{H}\left(  Q^{\dagger}\right)  =-\left(  \widehat{H}\left(  Q\right)
\right)  ^{\dagger}=-EQ^{\dagger}.
\end{equation}
One can observe
\begin{equation}
\widehat{H}\left(  Q\right)  Q^{\dagger}=EQQ^{\dagger}\equiv ED
\end{equation}
$\lceil$of course
\begin{equation}
\widehat{H}\left(  QQ^{\dagger}\right)  =\widehat{H}\left(  D\right)  =0.
\end{equation}
$\rfloor$

