\section{Clifford Norms}

By construction and definition of the CAR/Clifford algebra
\begin{align}
\operatorname*{Trace}\left\{  A\right\}   &  =\left\langle A\right\rangle
_{0}=\mathit{\operatorname*{tr}}\left(  A\right)  I_{\mathcal{F}}\\
\mathit{\operatorname*{tr}}\left(  A\right)   &  \equiv\left\langle
\left\langle A\right\rangle \right\rangle _{0}\in\mathbb{C}\\
\operatorname*{Trace}\left\{  I_{\mathcal{F}}\right\}   &  =\left\langle
I_{\mathcal{F}}\right\rangle _{0}=I_{\mathcal{F}}\\
\mathit{\operatorname*{tr}}\left(  I_{\mathcal{F}}\right)   &  =1
\end{align}
and one can define
\begin{align}
\left\langle \left.  A\right\vert B\right\rangle _{\mathcal{F}}  &
=\left\langle \left\langle A^{\dagger}B\right\rangle \right\rangle _{0}\\
\left(  \left.  A\right\vert B\right)  _{\mathcal{F}}  &  =\left\langle
\left\langle A^{t}B\right\rangle \right\rangle _{0}\\
\left\Vert A\right\Vert _{\mathcal{HS}}  &  =\left(  \left\langle \left.
A\right\vert A\right\rangle _{\mathcal{F}}\right)  ^{\frac{1}{2}}\\
\left\Vert A\right\Vert _{\mathcal{TC}}  &  =\mathit{\operatorname*{tr}%
}\left\{  \left(  A^{\dagger}A\right)  ^{\frac{1}{2}}\right\}  .
\end{align}


On the Von Neumann closure one has
\begin{align}
\operatorname*{Trace}  &  :\mathcal{F\longrightarrow F}\\
\mathit{\operatorname*{tr}}  &  :\mathcal{F\longrightarrow}\left[
-\infty,\infty\right]  .
\end{align}


\emph{The trace is zero on}
\begin{equation}%
%TCIMACRO{\dbigoplus \limits_{1\leq n\leq2r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{1\leq n\leq2r}}
%EndExpansion
\mathcal{F}_{n}%
\end{equation}
as
\begin{equation}
\left\langle \sum_{1\leq n\leq2r}A_{n}\right\rangle _{0}=0.
\end{equation}
The subspaces $\left\{  \mathcal{F}_{n}\right\}  $ are orthogonal wrt
$\left\langle \left.  A\right\vert B\right\rangle _{\mathcal{F}}$ i.e.
\begin{equation}
\mathcal{F}_{n}\bot\mathcal{F}_{m};0\leq n\neq m\leq2r,
\end{equation}
as the geometric product between two general elements $A^{\dagger}$ and $B$ is
defined as
\begin{equation}
A^{\dagger}B=\sum_{0\leq m,n\leq2r}A_{m}^{\dagger}B_{n},
\end{equation}
where
\begin{equation}
A_{m}^{\dagger}B_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}^{\dagger}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j},
\end{equation}
which can never have a zeroth component if $m\neq n$ giving that
\begin{equation}
\left\langle A_{m}^{\dagger}B_{n}\right\rangle _{0}=0,\,m\neq n,
\end{equation}
leading to
\begin{equation}
\left\langle A^{\dagger}B\right\rangle _{0}=\sum_{0\leq m\leq2r}\left\langle
A_{m}^{\dagger}B_{m}\right\rangle _{0},
\end{equation}
in particular (\emph{for normalized basis})%
\begin{equation}
\left\langle \left\langle A_{1}B_{1}\right\rangle \right\rangle _{0}%
=\left\langle \left\langle \sum_{1\leq j,k\leq2r}A_{1j}B_{1k}x_{j}%
x_{k}\right\rangle \right\rangle _{0}=\left\langle \left\langle \sum_{1\leq
j\leq2r}A_{1j}B_{1j}x_{j}^{2}\right\rangle \right\rangle _{0}=\sum_{1\leq
j\leq2r}A_{1j}B_{1j}.
\end{equation}
Let
\begin{align}
A_{p}  &  =a_{1}\wedge\cdots\wedge a_{p}\\
B_{p}  &  =b_{1}\wedge\cdots\wedge b_{p}%
\end{align}
then
\begin{align}
\left\langle \left.  A_{p}\right\vert B_{p}\right\rangle  &  =\left(
-1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\left\langle \left.  a_{p}%
\wedge\cdots\wedge a_{1}\right\vert b_{1}\wedge\cdots\wedge b_{p}\right\rangle
=\left(  -1\right)  \left\langle ^{\frac{p\left(  p-1\right)  }{2}%
}\left\langle \left(  a_{p}\wedge\cdots\wedge a_{1}\right)  \left(
b_{1}\wedge\cdots\wedge b_{p}\right)  \right\rangle \right\rangle _{0}\\
&  =\left(  -1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\sum_{\substack{1\leq
j_{1}<\cdots<j_{p}\leq2r\\1\leq k_{1}<\cdots<k_{p}\leq2r}}\left\langle
\left\langle a_{pj_{1}}\cdots a_{1j_{1}}x_{j_{p}}\wedge\cdots\wedge x_{j_{1}%
}b_{pk_{p}}\cdots b_{1k_{1}}x_{k_{1}}\wedge\cdots\wedge x_{k_{p}}\right\rangle
\right\rangle _{0}\\
&  =\left(  -1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\sum_{\substack{1\leq
j_{1}<\cdots<j_{p}\leq2r\\1\leq k_{1}<\cdots<k_{p}\leq2r}}\left\vert
\begin{array}
[c]{ccc}%
\left(  \left.  a_{j_{1}}\right\vert b_{k_{1}}\right)  & \cdots & \left(
\left.  a_{j_{1}}\right\vert b_{k_{p}}\right) \\
\vdots & \vdots & \vdots\\
\left(  \left.  a_{j_{p}}\right\vert b_{k_{1}}\right)  & \cdots & \left(
\left.  a_{j_{p}}\right\vert b_{k_{p}}\right)
\end{array}
\right\vert .
\end{align}
Note that
\begin{align}
A_{m}^{\dagger}  &  =\sum_{1\leq j_{1}<\cdots<j_{m}\leq2r}\overline{A}%
_{mj_{1}\cdots j_{m}}x_{j_{m}}\wedge\cdots\wedge x_{j_{1}}\\
B_{m}  &  =\sum_{1\leq j_{1}<\cdots<j_{m}\leq2r}B_{mj_{1}\cdots j_{m}}%
x_{j_{1}}\wedge\cdots\wedge x_{j_{m}}%
\end{align}%
\begin{align}
\left\langle \left.  A_{m}\right\vert B_{m}\right\rangle  &  =\sum
_{\substack{1\leq j_{1}<\cdots<j_{m}\leq2r\\1\leq k_{1}<\cdots<k_{m}\leq
2r}}\overline{A}_{mj_{1}\cdots j_{m}}B_{mk_{1}\cdots k_{m}}\left\langle
\left\langle \left(  x_{j_{m}}\wedge\cdots\wedge x_{j_{1}}\right)  \left(
x_{k_{1}}\wedge\cdots\wedge x_{k_{m}}\right)  \right\rangle \right\rangle
_{0}\\
&  =\sum_{1\leq j_{1}<\cdots<j_{m}\leq2r}\overline{A}_{mj_{1}\cdots j_{m}%
}B_{mj_{1}\cdots j_{m}}%
\end{align}%
\begin{equation}
\left\langle \left\langle A^{\dagger}B\right\rangle \right\rangle _{0}%
=\sum_{0\leq m\leq2r}\left\langle \left\langle A_{m}^{\dagger}B_{m}%
\right\rangle \right\rangle _{0}=\sum_{0\leq m\leq2r}\sum_{1\leq j_{1}%
<\cdots<j_{m}\leq2r}\overline{A}_{mj_{1}\cdots j_{m}}B_{mj_{1}\cdots j_{m}}.
\end{equation}


\subsubsection{Inner and Scalar Products}

The Clifford inner and scalar products can be expressed in terms of the trace
as
\begin{align}
\left\langle \left.  A\right\vert B\right\rangle _{\mathcal{F}}  &
=\left\langle A^{\dagger}B\right\rangle _{0}=\operatorname*{Trace}\left\{
A^{\dagger}B\right\}  =\operatorname*{tr}\left\{  A^{\dagger}B\right\}
I_{\mathcal{F}}\in\mathcal{F}_{0}\\
\left(  \left.  A\right\vert B\right)  _{\mathcal{F}}  &  =\left\langle
A^{t}B\right\rangle _{0}=\operatorname*{Trace}\left\{  A^{t}B\right\}
=\operatorname*{tr}\left\{  A^{t}B\right\}  I_{\mathcal{F}}\in\mathcal{F}%
_{0}\\
\left\langle \left.  A\right\vert B\right\rangle  &  =\overline{\left\langle
\left.  B\right\vert A\right\rangle }=\left\langle \left\langle A^{\dagger
}B\right\rangle \right\rangle _{0}=\operatorname*{tr}\left\{  A^{\dagger
}B\right\}  \in\mathbb{C}\\
\left(  \left.  A\right\vert B\right)   &  =\left(  \left.  B\right\vert
A\right)  =\left\langle \left\langle A^{t}B\right\rangle \right\rangle
_{0}=\operatorname*{tr}\left\{  A^{t}B\right\}  \in\mathbb{C}.
\end{align}
Other internal products in $\mathcal{F}$ can be defined in terms of these
preceeding products.

\subsection{States $f_{D}$}

States are positive normalized linear functionals defined on $\mathcal{F}$ and
if the state is a \emph{normal }state it can be associated with a density
operator $D\in\mathcal{F}$ i.e.
\begin{equation}
f_{D}\left(  I_{\mathcal{F}}\right)  =1=\mathit{\operatorname*{tr}}\left(
D\right)  =\left\langle \left\langle \left.  I\right\vert D\right\rangle
\right\rangle _{0}.
\end{equation}
We can always define $D$ by
\begin{equation}
D=\frac{QQ^{\dagger}}{\operatorname*{tr}\left\{  QQ^{\dagger}\right\}  }.
\end{equation}


\subsection{Differentials and Directional Derrivatives}

A function $f$ between Banach spaces $X$ and $Y$
\begin{equation}
f:U\subset X\longrightarrow Y
\end{equation}
is differentiable at $x\in U$ if $\exists$ a linear transformation $df\left(
x\right)  \in\mathcal{B}\left(  X,Y\right)  ,$ the differential $df\left(
x\right)  $ of $f$ at $x,$ such that
\begin{align}
f\left(  x+h\right)  -f\left(  x\right)  -df\left(  x\right)   &  =o\left(
h\right) \\
o\left(  h\right)   &  =\left\Vert h\right\Vert \psi\left(  h\right) \\
\psi &  :X\longrightarrow Y\\
\lim\limits_{h\rightarrow0}\psi\left(  h\right)   &  =0\text{ (Banach space
norms).}%
\end{align}
The directional derrivative $\frac{\partial}{\partial h}f\left(  x\right)  $
of $f$ at $x$ in the direction $h$ is given by
\begin{align}
\lim\limits_{t\rightarrow0}\left\{  \frac{f\left(  x+th\right)  -f\left(
x\right)  }{t}\right\}   &  =\left.  \frac{d}{dt}f\left(  x+th\right)
\right\vert _{t=0}=df\left(  x\right)  \left(  h\right)  =\frac{\partial
}{\partial h}f\left(  x\right)  =\sum_{1\leq j\leq2r}\frac{\partial f\left(
x\right)  }{\partial x_{j}}\mathit{h}_{j}=\sum_{1\leq j\leq2r}\mathit{h}%
_{j}\frac{\partial}{\partial x_{j}}f\left(  x\right) \\
&  \left(  \text{If }\emph{df}\left(  x\right)  \text{ exists!}\right) \\
h  &  =\sum_{1\leq j\leq2r}\mathit{h}_{j}x_{j};\left\{  \left.  \mathit{h}%
_{j}\right\vert 1\leq j\leq2r\right\}  \text{ are scalars.}%
\end{align}
The existance of $\left\{  \frac{\partial f\left(  x\right)  }{\partial
h}\right\}  $ for all $h$ does not imply that $df\left(  x\right)  $ exists.

The Dirac Operator, $\mathfrak{D,}$is defined as
\begin{equation}
\mathfrak{D}=\sum_{1\leq j\leq2r}x_{j}\frac{\partial}{\partial x_{j}},x_{j}%
\in\mathcal{F}_{1}%
\end{equation}
where $\mathfrak{D}$ acts on functions $f$
\begin{equation}
f:\mathcal{F\longrightarrow F}.
\end{equation}


