\paragraph{Exterior Products}

The CAR gives%
\begin{align}
a_{j_{1}}^{\dagger}a_{j_{1}}+a_{j_{1}}a_{j_{1}}^{\dagger}  &  =\frac{1}%
{2}\left(  x_{j_{1}}-ix_{j_{1}+r}\right)  \left(  x_{j_{1}}+ix_{j_{1}%
+r}\right)  +\frac{1}{2}\left(  x_{j_{1}}+ix_{j_{1}+r}\right)  \left(
x_{j_{1}}-ix_{j_{1}+r}\right) \\
&  =\frac{1}{2}\left(  x_{j_{1}}x_{j_{1}}+ix_{j_{1}}x_{j_{1}+r}-ix_{j_{1}%
+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{1}+r}+x_{j_{1}}x_{j_{1}}-ix_{j_{1}}x_{j_{1}%
+r}+ix_{j_{1}+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{1}+r}\right) \\
&  =x_{j_{1}}x_{j_{1}}+x_{j_{1}+r}x_{j_{1}+r}=I_{\mathcal{F}}%
\end{align}
as it should.

The wedge product in $\bigwedge\left(  \mathbf{a}^{\dagger}\right)
\equiv\bigwedge\left(  \mathcal{F}_{a+}\right)  \mathcal{\ }$ is given by
\begin{align}
&  a_{j_{1}}^{\dagger}\wedge a_{j_{2}}^{\dagger}=\left\langle a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}\right\rangle _{2}=\frac{1}{2}\left\langle
\left(  x_{j_{1}}-ix_{j_{1}+r}\right)  \left(  x_{j_{2}}-ix_{j_{2}+r}\right)
\right\rangle _{2}\\
&  =\left\{
\begin{array}
[c]{c}%
\frac{1}{2}\left(  \left\langle x_{j_{1}}x_{j_{1}}\right\rangle _{2}%
-\left\langle x_{j_{1}+r}x_{j_{1}+r}\right\rangle _{2}-i\left(  \left\langle
x_{j_{1}}x_{j_{1}+r}\right\rangle _{2}+\left\langle x_{j_{1}+r}x_{j_{1}%
}\right\rangle _{2}\right)  \right)  =0\text{ if }j_{1}=j_{2}\\
\frac{1}{2}\left(  \left(  x_{j_{1}}x_{j_{2}}-x_{j_{1}+r}x_{j_{2}+r}\right)
-i\left(  x_{j_{1}}x_{j_{2}+r}+x_{j_{1}+r}x_{j_{2}}\right)  \right)  \text{
}\neq0\text{ if }j_{1}\neq j_{2},
\end{array}
\right.  ,
\end{align}
which also gives via the adjoint operation
\begin{align}
&  a_{j_{1}}\wedge a_{j_{2}}=\left\langle a_{j_{1}}a_{j_{2}}\right\rangle
_{2}=\frac{1}{2}\left\langle \left(  x_{j_{1}}+ix_{j_{1}+r}\right)  \left(
x_{j_{2}}+ix_{j_{2}+r}\right)  \right\rangle _{2}\\
&  =\left\{
\begin{array}
[c]{c}%
\frac{1}{2}\left(  \left\langle x_{j_{1}+r}x_{j_{1}+r}\right\rangle
_{2}-\left\langle x_{j_{1}}x_{j_{1}}\right\rangle _{2}++i\left(  \left\langle
x_{j_{1}}x_{j_{1}+r}\right\rangle _{2}+\left\langle x_{j_{1}+r}x_{j_{1}%
}\right\rangle _{2}\right)  \right)  =0\text{ if }j_{1}=j_{2}\\
\frac{1}{2}\left(  \left(  x_{j_{1}+r}x_{j_{2}+r}-x_{j_{1}}x_{j_{2}}\right)
+i\left(  x_{j_{1}}x_{j_{2}+r}+x_{j_{1}+r}x_{j_{2}}\right)  \right)  \text{
}\neq0\text{ if }j_{1}\neq j_{2},
\end{array}
\right.  ,
\end{align}
where
\begin{equation}
1\leq j_{1},j_{2}\leq r.
\end{equation}
This shows that
\begin{align}
a_{j_{1}}^{\dagger}\wedge a_{j_{2}}^{\dagger}  &  =-a_{j_{2}}^{\dagger}\wedge
a_{j_{1}}^{\dagger}=a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\quad\text{ }%
j_{1}\neq j_{2}\\
a_{j_{1}}^{\dagger}\wedge a_{j_{1}}^{\dagger}  &  =0.
\end{align}%
\begin{align}
a_{j_{1}}\wedge a_{j_{2}}  &  =-a_{j_{2}}\wedge a_{j_{1}}=a_{j_{1}}a_{j_{2}%
}\quad\text{ }j_{1}\neq j_{2}\\
a_{j_{1}}\wedge a_{j_{1}}  &  =0.
\end{align}
The wedge product of $a_{j_{1}}^{\dagger}$ and $a_{j_{2}}$ is given by
\begin{align}
a_{j_{1}}^{\dagger}\wedge a_{j_{2}}  &  =\left\langle a_{j_{1}}^{\dagger
}a_{j_{2}}\right\rangle _{2}=\frac{1}{2}\left\langle \left(  x_{j_{1}%
}-ix_{j_{1}+r}\right)  \left(  x_{j_{2}}+ix_{j_{2}+r}\right)  \right\rangle
_{2}\\
&  =\frac{1}{2}\left(  \left(  \left\langle x_{j_{1}}x_{j_{2}}\right\rangle
_{2}+\left\langle x_{j_{1}+r}x_{j_{2}+r}\right\rangle _{2}\right)  +i\left(
\left\langle x_{j_{1}}x_{j_{2}+r}\right\rangle _{2}-\left\langle x_{j_{1}%
+r}x_{j_{2}}\right\rangle _{2}\right)  \right) \\
&  =\frac{1}{2}\left(  \left(  x_{j_{1}}x_{j_{2}}+x_{j_{1}+r}x_{j_{2}%
+r}\right)  +i\left(  x_{j_{1}}x_{j_{2}+r}-x_{j_{1}+r}x_{j_{2}}\right)
\right)  \text{ },
\end{align}
thus if $j_{1}\neq j_{2}$%
\begin{equation}
a_{j_{1}}^{\dagger}\wedge a_{j_{2}}=\frac{1}{2}\left(  \left(  x_{j_{1}%
}x_{j_{2}}+x_{j_{1}+r}x_{j_{2}+r}\right)  +i\left(  x_{j_{1}}x_{j_{2}%
+r}-x_{j_{1}+r}x_{j_{2}}\right)  \right)  =-a_{j_{2}}\wedge a_{j_{1}}%
^{\dagger}%
\end{equation}
as
\begin{equation}
a_{j_{2}}a_{j_{1}}^{\dagger}=-a_{j_{1}}^{\dagger}a_{j_{2}}.
\end{equation}
If $j_{1}=j_{2}$
\begin{equation}
a_{j_{1}}^{\dagger}\wedge a_{j_{1}}=ix_{j_{1}}x_{j_{1}+r}%
\end{equation}
and $a_{j_{1}}^{\dagger}\wedge a_{j_{1}}$ is self adjoint i.e.
\begin{equation}
\left(  a_{j_{1}}^{\dagger}\wedge a_{j_{1}}\right)  ^{\dagger}=\left(
ix_{j_{1}}x_{j_{1}+r}\right)  ^{\dagger}=-ix_{j_{1}+r}x_{j_{1}}=ix_{j_{1}%
}x_{j_{1}+r}=a_{j_{1}}^{\dagger}\wedge a_{j_{1}}.
\end{equation}
If $j_{1}\neq j_{2}$
\begin{align}
a_{j_{1}}^{\dagger}\wedge a_{j_{2}}  &  =\left\langle a_{j_{1}}^{\dagger
}a_{j_{2}}\right\rangle _{2}=\frac{1}{2}\left\langle \left(  x_{j_{1}%
}-ix_{j_{1}+r}\right)  \left(  x_{j_{2}}+ix_{j_{2}+r}\right)  \right\rangle
_{2}\\
&  =\frac{1}{2}\left(  \left(  x_{j_{1}}x_{j_{2}}+x_{j_{1}+r}x_{j_{2}%
+r}\right)  +i\left(  x_{j_{1}}x_{j_{2}+r}-x_{j_{1}+r}x_{j_{2}}\right)
\right)  =a_{j_{1}}^{\dagger}a_{j_{2}},
\end{align}
If $j_{1}=j_{2}$
\begin{align}
a_{j_{1}}^{\dagger}\wedge a_{j_{1}}  &  =ix_{j_{1}}x_{j_{1}+r}=-\frac{1}%
{2}\left(  a_{j_{1}}^{\dagger}+a_{j_{1}}\right)  \left(  a_{j_{1}}^{\dagger
}-a_{j_{1}}\right) \\
&  =-\frac{1}{2}\left(  a_{j_{1}}^{\dagger}a_{j_{1}}^{\dagger}+a_{j_{1}%
}a_{j_{1}}^{\dagger}-a_{j_{1}}^{\dagger}a_{j_{1}}+a_{j_{1}}a_{j_{1}}\right) \\
&  =-\frac{1}{2}\left(  a_{j_{1}}a_{j_{1}}^{\dagger}-a_{j_{1}}^{\dagger
}a_{j_{1}}\right)  =-\frac{1}{2}\left(  I_{\mathcal{F}}-2a_{j_{1}}^{\dagger
}a_{j_{1}}\right)  =a_{j_{1}}^{\dagger}a_{j_{1}}-\frac{1}{2}I_{\mathcal{F}}%
\end{align}
and
\begin{align}
a_{j_{1}}  &  \wedge a_{j_{1}}^{\dagger}=\left\langle a_{j_{1}}a_{j_{1}%
}^{\dagger}\right\rangle _{2}=\frac{1}{2}\left\langle \left(  x_{j_{1}%
}+ix_{j_{1}+r}\right)  \left(  x_{j_{1}}-ix_{j_{1}+r}\right)  \right\rangle
_{2}\\
&  =\frac{1}{2}\left(  \left\langle x_{j_{1}}x_{j_{1}}\right\rangle
_{2}+\left\langle x_{j_{1}+r}x_{j_{1}+r}\right\rangle _{2}+i\left(
\left\langle x_{j_{1}+r}x_{j_{1}}\right\rangle _{2}-\left\langle x_{j_{1}%
}x_{j_{1}+r}\right\rangle _{2}\right)  \right)  =-ix_{j_{1}}x_{j_{1}+r}\text{
}.
\end{align}
Hence%
\begin{equation}
a_{j_{1}}\wedge a_{j_{1}}^{\dagger}=-ix_{j_{1}}x_{j_{1}+r}=-a_{j_{1}}%
^{\dagger}\wedge a_{j_{1}}.
\end{equation}
The Clifford/Geometric product of $a_{j_{1}}^{\dagger}$ and $a_{j_{2}}$
\[
a_{j_{1}}^{\dagger}a_{j_{2}}=\frac{1}{2}\left(  x_{j_{1}}-ix_{j_{1}+r}\right)
\left(  x_{j_{2}}+ix_{j_{2}+r}\right)  =\frac{1}{2}\left(  x_{j_{1}}x_{j_{2}%
}+ix_{j_{1}}x_{j_{2}+r}-ix_{j_{1}+r}x_{j_{2}}+x_{j_{1}+r}x_{j_{2}+r}\right)
,
\]
which gives in particular
\begin{align}
n_{j_{1}}  &  =a_{j_{1}}^{\dagger}a_{j_{1}}=\frac{1}{2}\left(  x_{j_{1}%
}x_{j_{1}}+x_{j_{1}+r}x_{j_{1}+r}+i\left(  x_{j_{1}}x_{j_{2}+r}-x_{j_{1}%
+r}x_{j_{2}}\right)  \right) \\
&  =\frac{1}{2}\left(  x_{j_{1}}x_{j_{2}}+x_{j_{1}+r}x_{j_{2}+r}+i\left(
x_{j_{1}}x_{j_{1}+r}-x_{j_{1}+r}x_{j_{1}}\right)  \right) \\
&  =\frac{1}{2}I_{\mathcal{F}}+ix_{j_{1}}x_{j_{1}+r}%
\end{align}
which shows that
\begin{equation}
h_{j_{1}}=a_{j_{1}}a_{j_{1}}^{\dagger}=\frac{1}{2}I_{\mathcal{F}}-ix_{j_{1}%
}x_{j_{1}+r}.
\end{equation}


\paragraph{GNS Maps}

The action of $\Phi_{f_{a}}$ on the self adjoint basis is
\begin{align}
\Phi_{f_{a}}\left(  x_{j_{1}}\right)   &  =\frac{1}{\sqrt{2}}\Phi_{f_{a}%
}\left(  a_{j_{1}}^{\dagger}+a_{j_{1}}\right)  =\frac{1}{\sqrt{2}}\Phi_{f_{a}%
}\left(  a_{j_{1}}^{\dagger}\right) \\
\Phi_{f_{a}}\left(  x_{j_{1}+r}\right)   &  =\frac{i}{\sqrt{2}}\Phi_{f_{a}%
}\left(  a_{j_{1}}^{\dagger}-a_{j_{1}}\right)  =\frac{i}{\sqrt{2}}\Phi_{f_{a}%
}\left(  a_{j_{1}}^{\dagger}\right)
\end{align}
which shows that as a complex map it is not $1-1$ but as a real map it is.

For second order products where $j_{1}=j_{2}$
\begin{align}
\Phi_{f_{a}}\left(  x_{j_{1}}\wedge x_{j_{1}}\right)   &  =\frac{1}{2}%
\Phi_{f_{a}}\left(  \left(  a_{j_{1}}^{\dagger}+a_{j_{1}}\right)
\wedge\left(  a_{j_{1}}^{\dagger}+a_{j_{1}}\right)  \right)  =\frac{1}{2}%
\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}\wedge a_{j_{1}}^{\dagger}+a_{j_{1}%
}^{\dagger}\wedge a_{j_{1}}+a_{j_{1}}\wedge a_{j_{1}}^{\dagger}+a_{j_{1}%
}\wedge a_{j_{1}}\right) \\
&  =\frac{1}{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}\wedge a_{j_{1}%
}+a_{j_{1}}\wedge a_{j_{1}}^{\dagger}\right)  =\frac{1}{2}\Phi_{f_{a}}\left(
ix_{j_{1}}x_{j_{1}+r}-ix_{j_{1}}x_{j_{1}+r}\right)  =0,
\end{align}
while for $j_{1}\neq j_{2}$
\begin{align}
\Phi_{f_{a}}\left(  x_{j_{1}}\wedge x_{j_{2}}\right)   &  =\Phi_{f_{a}}\left(
x_{j_{1}}x_{j_{2}}\right)  \text{ }\\
&  =\frac{1}{2}\Phi_{f_{a}}\left(  \left(  a_{j_{1}}^{\dagger}+a_{j_{1}%
}\right)  \left(  a_{j_{2}}^{\dagger}+a_{j_{2}}\right)  \right)  =\frac{1}%
{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}+a_{j_{1}%
}a_{j_{2}}^{\dagger}+a_{j_{1}}^{\dagger}a_{j_{2}}+a_{j_{1}}a_{j_{2}}\right) \\
&  =\frac{1}{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\right)  =\frac{1}{\sqrt{2}}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}\right)
\wedge\frac{1}{\sqrt{2}}\Phi_{f_{a}}\left(  a_{j_{2}}^{\dagger}\right)
=\Phi_{f_{a}}\left(  x_{j_{1}}\right)  \wedge\Phi_{f_{a}}\left(  x_{j_{2}%
}\right)  ,
\end{align}
for $j_{1}\neq j_{2}$
\begin{align}
\Phi_{f_{a}}\left(  x_{j_{1}}\wedge x_{j_{2}+r}\right)   &  =\Phi_{f_{a}%
}\left(  x_{j_{1}}x_{j_{2}+r}\right) \\
&  =\frac{i}{2}\Phi_{f_{a}}\left(  \left(  a_{j_{1}}^{\dagger}+a_{j_{1}%
}\right)  \left(  a_{j_{2}}^{\dagger}-a_{j_{2}}\right)  \right)  =\frac{i}%
{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}-a_{j_{1}%
}a_{j_{2}}^{\dagger}+a_{j_{1}}^{\dagger}a_{j_{2}}-a_{j_{1}}a_{j_{2}}\right) \\
&  =\frac{i}{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\right)  =\frac{1}{\sqrt{2}}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}\right)
\wedge\frac{i}{\sqrt{2}}\Phi_{f_{a}}\left(  a_{j_{2}}^{\dagger}\right)
=\Phi_{f_{a}}\left(  x_{j_{1}}\right)  \wedge\Phi_{f_{a}}\left(  x_{j_{2}%
+r}\right)  ,\text{ }j_{1}\neq j_{2}%
\end{align}
thus $\Phi_{f_{a}}$ is a homomorphism for all the preceeding cases, but for
$j_{1}=j_{2}$
\begin{align}
\Phi_{f_{a}}\left(  x_{j_{1}}\wedge x_{j_{1}+r}\right)   &  =\Phi_{f_{a}%
}\left(  x_{j_{1}}x_{j_{1}+r}\right) \\
&  =\frac{i}{2}\Phi_{f_{a}}\left(  \left(  a_{j_{1}}^{\dagger}+a_{j_{1}%
}\right)  \left(  a_{j_{1}}^{\dagger}-a_{j_{1}}\right)  \right)  =\frac{i}%
{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}a_{j_{1}}^{\dagger}-a_{j_{1}%
}a_{j_{1}}^{\dagger}+a_{j_{1}}^{\dagger}a_{j_{1}}-a_{j_{1}}a_{j_{2}}\right) \\
&  =\frac{i}{2}\Phi_{f_{a}}\left(  a_{j_{1}}^{\dagger}a_{j_{1}}-a_{j_{1}%
}a_{j_{1}}^{\dagger}\right)  =\frac{i}{2}\Phi_{f_{a}}\left(  a_{j_{1}%
