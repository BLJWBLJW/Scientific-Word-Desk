a_{j}\right)  \right\rangle =f\left(  a_{j}^{\dagger}a_{j}\right)
=\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{j}D_{f}\right\}  ,
\end{equation}
showing that if
\begin{equation}
f\left(  a_{j}^{\dagger}a_{j}\right)  =0
\end{equation}
then
\begin{equation}
\Pi_{f}\left(  a_{j}\right)  \Phi_{f}\left(  I_{\mathcal{F}}\right)  =0.
\end{equation}
Thus a state $f$ is a vacuum state \emph{and produces a vacuum vector }%
$\Phi_{f}\left(  I_{\mathcal{F}}\right)  $\emph{ via the GNS construction} if
there exists a splitting of $\mathcal{F}_{1}$ into
\begin{equation}
\mathcal{F}_{1}=\mathbf{a}^{\dagger}\oplus\mathbf{a}%
\end{equation}
such that
\begin{align}
&  \mathbf{a\subset}\ker\left\{  \Phi_{f}\right\} \\
&  \mathbf{a}^{\dagger}\cap\ker\left\{  \Phi_{f}\right\}  =\phi.
\end{align}
(Note that $\ker\left\{  \Phi_{f}\right\}  $ is a left ideal containing the
two sided ideal $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathbf{a}$)

If $\Phi_{f}\left(  I_{\mathcal{F}}\right)  $ is a vacuum vector belonging to
the Fock space $\Phi_{f}\left(  \mathcal{F}\right)  $ then it is orthogonal to
all other vectors in $\mathcal{H}_{f}$ as
\begin{equation}
f\left(  a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger}\right)  =\left\langle
\left.  \Phi_{f}\left(  I_{\mathcal{F}}\right)  \right\vert \Phi_{f}\left(
a_{j_{1}}^{\dagger}\cdots a_{j_{n}}^{\dagger}\right)  \right\rangle =0;1\leq
j_{1}<\cdots<j_{n}\leq2r,1\leq n\leq2r,
\end{equation}
this follows directly from
\begin{equation}
a_{j_{1}}\cdots a_{j_{n}}\in\ker\left\{  \Phi_{f}\right\}  ;1\leq j_{1}%
<\cdots<j_{n}\leq2r,1\leq n\leq2r
\end{equation}
and that $\left\{  a_{1},\cdots,a_{r}\right\}  $ generate a left ideal.

States that are vacuum states produce generalized quasi free Fock
representations (or Fock representations) that are not all unitarily
equivalent. Not all states are vacuum states and these produce non Fock
representations of the CAR.

$\operatorname*{tr}$ $\equiv I_{\mathcal{F}}$ is not a vacuum state. This can
be seen by considering the values of $\operatorname*{tr}$ \emph{on any} split
non self adjoint basis that satisfy the CAR which are given by
\begin{align}
\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{k}\right\}   &  =\left\langle
\left\langle a_{j}^{\dagger}a_{k}\right\rangle \right\rangle _{0}=\frac{1}%
{2}\left\langle \left\langle \left(  x_{j}-ix_{j+r}\right)  \left(
x_{k}+ix_{k+r}\right)  \right\rangle \right\rangle _{0}=\frac{1}%
{2}\left\langle \left\langle x_{j}x_{k}-ix_{j+r}x_{k}+ix_{j}x_{k+r}%
+x_{j+r}x_{k+r}\right\rangle \right\rangle _{0}\\
&  =\frac{1}{2}\left\langle \left\langle x_{j}x_{k}-ix_{j+r}x_{k}%
+ix_{j}x_{k+r}+x_{j+r}x_{k+r}\right\rangle \right\rangle _{0}=\frac{1}%
{2}\delta_{jk}=\operatorname*{tr}\left\{  a_{k}a_{j}^{\dagger}\right\} \\
\operatorname*{tr}\left\{  a_{k}a_{j}^{\dagger}\right\}   &  =\left\langle
\left\langle a_{k}a_{j}^{\dagger}\right\rangle \right\rangle _{0}%
=\operatorname*{tr}\left\{  \delta_{jk}-a_{j}^{\dagger}a_{k}\right\}
=\delta_{jk}-\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{k}\right\} \\
&  \Rightarrow\left\{
\begin{array}
[c]{c}%
\operatorname*{tr}\left\{  a_{k}a_{j}^{\dagger}\right\}  =-\operatorname*{tr}%
\left\{  a_{j}^{\dagger}a_{k}\right\}  ;j\neq k\\
\operatorname*{tr}\left\{  a_{j}a_{j}^{\dagger}\right\}  =1-\operatorname*{tr}%
\left\{  a_{j}^{\dagger}a_{j}\right\}  ;j=k
\end{array}
\right. \\
&  \Rightarrow\operatorname*{tr}\left\{  a_{j}a_{j}^{\dagger}\right\}
=\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{j}\right\}  =\frac{1}{2}\\
\operatorname*{tr}\left\{  a_{j}a_{k}\right\}   &  =-\operatorname*{tr}%
\left\{  a_{k}a_{j}\right\}  =\operatorname*{tr}\left\{  a_{k}a_{j}\right\}
\Rightarrow\operatorname*{tr}\left\{  a_{j}a_{k}\right\}  =0
\end{align}
$\lceil$Thus
\begin{equation}
\left\langle a_{j}a_{j}^{\dagger}\right\rangle _{0}=\left\langle
a_{j}^{\dagger}a_{j}\right\rangle _{0}=\frac{1}{2}\neq0
\end{equation}
and hence
\begin{equation}
\left\{  a_{j}a_{j}^{\dagger},a_{j}^{\dagger}a_{j}\right\}  \notin%
\bigoplus\limits_{1\leq n\leq2r}\mathcal{F}_{n}%
\end{equation}
as they contain components belonging to $\mathcal{F}_{0}\rfloor$.

The values on the associated (unnormalized) self adjoint bases are then
\begin{equation}
\operatorname*{tr}\left\{  x_{j}x_{k}\right\}  =\delta_{jk}\left\langle
\left\langle x_{j}^{2}\right\rangle \right\rangle _{0}=\frac{1}{2}\delta
_{jk};1\leq j\leq2r.
\end{equation}
This shows that $\operatorname*{tr}$ is \emph{NOT }a vacuum state. Hence the
representation $\Pi_{\operatorname*{tr}}$ is \emph{NOT }a Fock representation
and in fact generates a type II$_{1}$ Von Neumann algebra. In contrast Fock
representations produce type I$_{r}$ Von Neumann algebras. These observations
show that the left regular representation of the CAR/Clifford algebra induced
by the central state $\operatorname*{tr}$ that defines its $c^{\ast}$-algebra
norm, can thus be viewed as a type II$_{1}$ $w^{\ast}$-algebra/Von Neumann algebra.

\paragraph{Splitting of $\mathcal{F}_{1}$ into non adjoint subspaces.}

The number operators $\widehat{\mathcal{N}}_{a}$ based on $\left\{  \left.
a_{j}^{\dagger},a_{j}\right\vert 1\leq j\leq r\right\}  $ split $\mathcal{F}%
_{1}$ into eigenspaces corresponding to the eigenvalues $+\frac{1}{2}$ and
