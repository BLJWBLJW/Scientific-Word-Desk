\left.  -i\frac{d}{d\theta}\widehat{u}_{N_{a}}\left(  \theta\right)
\right\vert _{\theta=0}\left(  \prod_{1\leq j\leq N}a_{j}^{\dagger}\right)
&  =\left[  \mathcal{N}_{a},\prod_{1\leq j\leq N}a_{j}^{\dagger}\right] \\
\left.  -i\frac{d}{d\theta}\prod_{1\leq j\leq N}\left(  \widehat{u_{1}}\left(
\theta\right)  \left(  a_{j}^{\dagger}\right)  \right)  \right\vert _{t=0}  &
=\left[  \mathcal{N}_{a},a_{1}^{\dagger}\right]  \left(  \prod_{2\leq j\leq
N}a_{j}^{\dagger}\right)  +a_{1}^{\dagger}\left[  \mathcal{N}_{a}%
,a_{2}^{\dagger}\right]  \left(  \prod_{3\leq j\leq N}a_{j}^{\dagger}\right)
+\\
&  \cdots+\left(  \prod_{1\leq j\leq p}a_{j}^{\dagger}\right)  \left[
\mathcal{N}_{a},a_{p+1}^{\dagger}\right]  \left(  \prod_{p+2\leq j\leq N}%
a_{j}^{\dagger}\right)  +\cdots+\left(  \prod_{1\leq j\leq N-1}a_{j}^{\dagger
}\right)  \left[  \mathcal{N}_{a},a_{N}^{\dagger}\right] \\
&  =N\left(  \prod_{1\leq j\leq N}a_{j}^{\dagger}\right)  =N\left(
2^{-\frac{N}{2}}\prod_{1\leq j\leq N}\left(  x_{j}+ix_{j+r}\right)  \right)  ,
\end{align}
as in general any element of $\mathcal{F}$ can be expressed as strong limits
of polynomials formed from the mononomials
\begin{equation}
\prod_{0\leq j\leq N_{p}}\widehat{u_{1}}\left(  \theta\right)  \left(
a_{j}^{\dagger}\right)  \prod_{0\leq j\leq N_{h}}\widehat{u_{1}}\left(
\theta\right)  \left(  a_{j}\right)  ;0\leq N_{p},N_{h}\leq\infty,
\end{equation}
where
\begin{equation}
a_{0}^{\dagger}=a_{0}=I_{\mathcal{F}}.
\end{equation}
The general action of any Number operator $\widehat{\mathcal{N}}$ is given by
considering the EOM produced by the Gauge group
\begin{equation}
-i\frac{dA\left(  \theta\right)  }{d\theta}=\left[  \mathcal{N},A\left(
\theta\right)  \right]  =\widehat{\mathcal{N}}\left(  A\left(  \theta\right)
\right)  ,
\end{equation}
that gives for basis elements of $\mathcal{F}$
\begin{align}
&  \left.  \frac{d}{d\theta}\left(  \prod_{1\leq j\leq N_{p}}\widehat{u_{1}%
}\left(  \theta\right)  \left(  a_{j}^{\dagger}\right)  \prod_{1\leq j\leq
N_{h}}\widehat{u_{1}}\left(  \theta\right)  \left(  a_{j}\right)  \right)
\right\vert _{\theta=0}=\left(  N_{p}\prod_{1\leq j\leq N_{p}}a_{j}^{\dagger
}\right)  \left(  -N_{h}\prod_{1\leq j\leq N_{h}}a_{j}\right) \\
&  =\left(  N_{p}-N_{h}\right)  \prod_{1\leq j\leq N_{p}}a_{j}^{\dagger}%
\prod_{1\leq j\leq N_{h}}a_{j}=\left(  N_{p}-N_{h}\right)  2^{-\frac{N_{p}}%
{2}}\prod_{1\leq j\leq N_{p}}\left(  x_{j}+ix_{j+r}\right)  2^{-\frac{N_{h}%
}{2}}\prod_{1\leq j\leq N_{h}}\left(  x_{j}-ix_{j+r}\right)  ,
\end{align}
the last term can be simplified by noting
\begin{align}
2^{-\frac{N_{p}+N_{h}}{2}}\prod_{1\leq j_{p}\leq N_{p}}\left(  x_{j_{p}%
}+ix_{j_{p}+r}\right)  \prod_{1\leq j_{h}\leq N_{h}}\left(  x_{j_{h}%
}-ix_{j_{h}+r}\right)   &  =2^{-\frac{N_{p}+N_{h}}{2}}\prod_{\substack{1\leq
j_{p}\leq N_{p}\\1\leq j_{h}\leq N_{h}}}\left(  x_{j_{p}}+ix_{j_{p}+r}\right)
\left(  x_{j_{h}}-ix_{j_{h}+r}\right) \\
&  =2^{-\frac{N_{p}+N_{h}}{2}}\prod_{\substack{1\leq j_{p}\leq N_{p}\\1\leq
j_{h}\leq N_{h}}}\left(  x_{j_{p}}x_{j_{h}}+x_{j_{p}+r}x_{j_{h}+r}+i\left(
x_{j_{p}+r}x_{j_{h}}-x_{j_{p}}x_{j_{h}+r}\right)  \right)  ,
\end{align}
giving
\begin{align}
&  \widehat{\mathcal{N}}_{a}\left(  \prod_{1\leq j\leq N_{p}}a_{j}^{\dagger
}\prod_{1\leq j\leq N_{h}}a_{j}\right)  =\widehat{\mathcal{N}}_{a}\left(
2^{-\frac{N_{p}+N_{h}}{2}}\prod_{\substack{1\leq j_{p}\leq N_{p}\\1\leq
j_{h}\leq N_{h}}}\left(  x_{j_{p}}x_{j_{h}}+x_{j_{p}+r}x_{j_{h}+r}+i\left(
x_{j_{p}+r}x_{j_{h}}-x_{j_{p}}x_{j_{h}+r}\right)  \right)  \right) \\
&  =\left(  N_{p}-N_{h}\right)  \left(  2^{-\frac{N_{p}+N_{h}}{2}}%
\prod_{\substack{1\leq j_{p}\leq N_{p}\\1\leq j_{h}\leq N_{h}}}\left(
x_{j_{p}}x_{j_{h}}+x_{j_{p}+r}x_{j_{h}+r}+i\left(  x_{j_{p}+r}x_{j_{h}%
}-x_{j_{p}}x_{j_{h}+r}\right)  \right)  \right) \\
&  =\left(  N_{p}-N_{h}\right)  \left(  \prod_{1\leq j\leq N_{p}}%
a_{j}^{\dagger}\prod_{1\leq j\leq N_{h}}a_{j}\right)  .
\end{align}
Thus
\begin{equation}
\left(  \prod_{1\leq j\leq N_{p}}a_{j}^{\dagger}\prod_{1\leq j\leq N_{h}}%
a_{j}\right)  =\left(  2^{-\frac{N_{p}+N_{h}}{2}}\prod_{\substack{1\leq
j_{p}\leq N_{p}\\1\leq j_{h}\leq N_{h}}}\left(  x_{j_{p}}x_{j_{h}}+x_{j_{p}%
+r}x_{j_{h}+r}+i\left(  x_{j_{p}+r}x_{j_{h}}-x_{j_{p}}x_{j_{h}+r}\right)
\right)  \right)
\end{equation}
are eigen operators of $\widehat{\mathcal{N}}_{a},$which allows one to
decompose $\mathcal{F}$ as the direct sum of the eigen vector spaces
\begin{equation}
\mathcal{F}=\bigoplus\limits_{-\infty\leq N_{a}\leq\infty}\mathcal{F}_{\left[
N_{a}\right]  },
\end{equation}
where
\begin{equation}
\widehat{\mathcal{N}}_{a}\mathcal{F}_{\left[  N_{a}\right]  }=N_{a}%
\mathcal{F}_{\left[  N_{a}\right]  },
\end{equation}
i.e. $\mathcal{F}_{\left[  N_{a}\right]  }$ are invariant, (eigen), subspaces
of $\widehat{\mathcal{N}}_{a}.$ The subspace $\mathcal{F}_{\left[  0\right]
}=\mathcal{F}_{e}$ is the subalgebra of Gauge invariant operators. The
subspaces $N_{a}\neq0$ are not in general invariant to $SO\left(
2r,\mathbb{R}\right)  ,SO\left(  2r+1,\mathbb{R}\right)  ,$ but are invariant
to $U\left(  r,\mathbb{R}\right)  .$

In general
\begin{equation}
\sum_{1\leq j\leq\infty}a_{j}^{\dagger}a_{j}\neq\sum_{1\leq j\leq\infty}%
b_{j}^{\dagger}b_{j}%
\end{equation}
even though both $\left\{  a_{j}^{\dagger},a_{j}\right\}  $ and $\left\{
b_{j}^{\dagger},b_{j}\right\}  $ satisfy the CAR. These correspond to
different complexifications of $\mathcal{F}_{1\mathbb{R}}$ and thus
representations of $\mathcal{F}$ (or in more precise notation $\mathcal{A}%
_{CAR}),$representations also depend on states. Note that $\mathcal{F}$ often
denotes the standard Fock representation, which is based on a particular
Hilbert space $\mathcal{H}_{\mathcal{F}}=\wedge\left(  \mathcal{H}^{1}\right)
.$

