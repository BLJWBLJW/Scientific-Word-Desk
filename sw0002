\right. \\
\operatorname*{tr}\left\{  a_{k}^{\dagger}a_{k}^{{}}+a_{k}a_{k}^{\dagger
}\right\}   &  =\frac{1}{2}+\frac{1}{2}=1\\
\dim\left\{  \mathbf{a}^{\dagger}\right\}   &  =\dim\left\{  \mathbf{a}%
\right\}  =r.
\end{align}


