\section{Polynomial *-Algebras}

Let $\left\{  I_{\mathcal{A}},\left\{  \left.  x_{j_{1}}\cdots x_{j_{p}%
}\right\vert 1\leq j_{1}<\cdots<j_{p}\leq2r\right\}  \right\}  $ be a basis
for a complex algebra $\mathcal{A}_{finite},$ where
\begin{equation}
\mathcal{A}_{finite}=\mathbb{C}\text{-}\operatorname*{linspan}%
\operatorname*{poly}\left\{  \left.  I_{\mathcal{A}},x_{j}\right\vert 1\leq
j\leq2r\right\}
\end{equation}
and the linear span is limited to all \emph{finite} complex linear combination
of products of the generators of $\mathcal{A}_{finite},$ i.e. by finite
complex polynomials of the generators even when $r=\infty$. Note that in
general we are limiting consideration to algebras where the generators satisfy
certain relationships. We also use the set of linear maps (ignoring continuity
and boundness) $T\in\mathcal{L}\left(  \mathcal{A}\right)  $ acting in
$\mathcal{A}$ i.e.
\begin{align}
T  &  :\mathcal{A\longrightarrow A}\\
T(\alpha A+\beta B)  &  =\alpha T(A)+\beta T(B);\alpha,\beta\in\mathbb{C}%
,A,B\in\mathcal{A}.
\end{align}
Complex algebras can always be generated by even dimensional real agebras of
twice the generator dimension and the introduction of a complex structure, so
we don't have to always consider complex algebras.

We assume or limit to the case where there exists a unique bounded linear
functional $\mathit{\operatorname*{tr}}\in\mathcal{A}_{finite}^{d}$ that is a
\emph{normalized faithful tracial} state i.e.
\begin{align}
\mathit{\operatorname*{tr}}\left(  I_{\mathcal{A}}\right)   &  =1\\
\mathit{\operatorname*{tr}}\left(  \xi^{\dagger}\xi\right)   &
=0\Leftrightarrow\xi=0\\
\mathit{\operatorname*{tr}}\left(  AB\right)   &  =\mathit{\operatorname*{tr}%
}\left(  BA\right)  \forall A,B\\
\mathit{\operatorname*{tr}} &  :\mathcal{A\longrightarrow}\mathbb{C}.
\end{align}
The adjoint operation is defined in terms of complex conjugation and reversion
i.e.
\begin{equation}
\left(  \xi_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right)  ^{\dagger
}=\overline{\xi}_{j_{1}\cdots j_{p}}x_{j_{p}}\cdots x_{j_{1}}%
\end{equation}
and
\begin{equation}
x_{j}^{\dagger}=x_{j};1\leq j\leq2r.
\end{equation}
$\lceil$In the case of a Clifford/CAR algebra that are generated by self
adjoint (real) bases
\begin{equation}
\mathit{\operatorname*{tr}}\left(  \xi\right)  =\left\langle \left\langle
\xi\right\rangle \right\rangle _{0}=\xi_{0},
\end{equation}
where
\begin{equation}
\xi=\xi_{0}I_{\mathcal{A}}+\xi_{r}.
\end{equation}
Is $\left\langle \left\langle \cdot\right\rangle \right\rangle _{0}$ faithful
i.e.
\begin{equation}
\left\langle \left\langle \xi^{\dagger}\xi\right\rangle \right\rangle
_{0}=0\Longleftrightarrow\xi=0?
\end{equation}
As%
\begin{align}
\xi^{\dagger}\xi &  =\left(  \xi_{0}I_{\mathcal{A}}+\sum_{1\leq p\leq2r}%
\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\xi_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots
x_{j_{p}}\right)  ^{\dagger}\left(  \xi_{0}I_{\mathcal{A}}+\sum_{1\leq
q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq2r}\xi_{k_{1}\cdots k_{q}}x_{k_{1}%
}\cdots x_{k_{q}}\right)  \\
&  =\left\vert \xi_{0}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq p,q\leq
2r}\sum_{\substack{1\leq j_{1}<\cdots<j_{p}\leq2r\\1\leq k_{1}<\cdots
<k_{q}\leq2r}}\overline{\xi}_{j_{1}\cdots j_{p}}\xi_{k_{1}\cdots k_{q}%
}x_{j_{p}}\cdots x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}}\\
&  =\left(  \left\vert \xi_{0}\right\vert ^{2}+\left\langle \left\langle
\xi_{r}^{\dagger}\xi_{r}\right\rangle \right\rangle _{0}\right)
I_{\mathcal{A}}+\sum_{1\leq q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq2r}%
\Xi_{k_{1}\cdots k_{q}}x_{k_{1}}\cdots x_{k_{q}}%
\end{align}
this becomes
\begin{equation}
\left\vert \left\langle \left\langle \xi^{\dagger}\xi\right\rangle
\right\rangle _{0}\right\vert ^{2}=\left(  \left\vert \xi_{0}\right\vert
^{2}+\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle
\right\rangle _{0}\right)  =0\Longleftrightarrow\xi=0
\end{equation}
i.e.
\begin{equation}
\sum_{1\leq q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq2r}\Xi_{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}=0.
\end{equation}
The scalar term of $\xi_{r}^{\dagger}\xi_{r}$ is given by
\begin{align}
\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle \right\rangle
_{0} &  =\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}%
\overline{\xi}_{j_{1}\cdots j_{p}}\xi_{j_{1}\cdots j_{p}}x_{j_{p}}\cdots
x_{j_{1}}x_{j_{1}}\cdots x_{j_{p}}=\sum_{1\leq p\leq2r}\frac{1}{2^{p}}%
\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\overline{\xi}_{j_{1}\cdots j_{p}}%
\xi_{j_{1}\cdots j_{p}}\\
&  =\sum_{1\leq p\leq2r}\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots<j_{p}\leq
2r}\left\vert \xi_{j_{1}\cdots j_{p}}\right\vert ^{2},
\end{align}
which shows that
\begin{equation}
\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle \right\rangle
_{0}\geq0
\end{equation}
and
\begin{equation}
\left\langle \left\langle \xi_{r}^{\dagger}\xi_{r}\right\rangle \right\rangle
_{0}=0\Longleftrightarrow\xi_{r}=0.
\end{equation}
This reasoning can be extended to $\xi$ to obtain
\begin{equation}
\left\langle \left\langle \xi^{\dagger}\xi\right\rangle \right\rangle
_{0}=0\Longleftrightarrow\xi=0,
\end{equation}
which shows that
\begin{equation}
\mathit{\operatorname*{tr}}\left(  \xi^{\dagger}\xi\right)  =0\Leftrightarrow
\xi=0
\end{equation}
and thus the $\mathit{\operatorname*{tr}}$ functional is faithful.

$\lceil$Note that
\begin{equation}
\mathit{\operatorname*{tr}}\left(  x_{j}\right)  =0,
\end{equation}
\begin{equation}
x_{j}\neq0,
\end{equation}%
\begin{equation}
\mathit{\operatorname*{tr}}\left(  x_{j}^{\dagger}x_{j}\right)  =\left\langle
\left\langle x_{j}^{\dagger}x_{j}\right\rangle \right\rangle _{0}=\frac{1}%
{2}\neq0
\end{equation}
$\rfloor$

$\lceil$If $\kappa$ is positive
\begin{equation}
\left\langle \left\langle \kappa\right\rangle \right\rangle _{0}%
=\mathit{\operatorname*{tr}}\left\{  \left\langle \left\langle \kappa
\right\rangle \right\rangle _{0}I_{\mathcal{A}}+\kappa_{r}\right\}  \geq0.
\end{equation}
If
\begin{equation}
\left\langle \left\langle \kappa\right\rangle \right\rangle _{0}=0
\end{equation}
then
\begin{equation}
\mathit{\operatorname*{tr}}\left\{  \left\langle \left\langle \kappa
\right\rangle \right\rangle _{0}I_{\mathcal{A}}+\kappa_{r}\right\}
=\mathit{\operatorname*{tr}}\left\{  \kappa_{r}\right\}  =0,
\end{equation}
more over from the preceeding
\begin{equation}
\kappa_{r}=0.
\end{equation}
A simple example is given by
\begin{align}
\eta &  =c_{1}x_{1}-c_{2}x_{2}\\
\eta^{\dagger}\eta &  =\frac{1}{2}\left(  \left\vert c_{1}\right\vert
^{2}+\left\vert c_{2}\right\vert ^{2}\right)  I_{\mathcal{A}}-\bar{c}_{1}%
c_{2}x_{1}x_{2}-\bar{c}_{2}c_{1}x_{2}x_{1}=\frac{1}{2}\left(  \left\vert
c_{1}\right\vert ^{2}+\left\vert c_{2}\right\vert ^{2}\right)  I_{\mathcal{A}%
}+\left(  \bar{c}_{2}c_{1}-\bar{c}_{1}c_{2}\right)  x_{1}x_{2}\\
&  =\frac{1}{2}\left(  \left\vert c_{1}\right\vert ^{2}+\left\vert
c_{2}\right\vert ^{2}\right)  I_{\mathcal{A}}+2i\operatorname{Im}\left(
\bar{c}_{2}c_{1}\right)  x_{1}x_{2}.
\end{align}
$\rfloor$

All positive elements can be expressed as the products
\begin{align}
\kappa &  =\xi^{\dagger}\xi=\left(  \left\langle \left\langle \xi\right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}%
<\cdots<j_{p}\leq2r}\xi_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right)
^{\dagger}\left(  \left\langle \left\langle \xi\right\rangle \right\rangle
_{0}I_{\mathcal{A}}+\sum_{1\leq q\leq2r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq
2r}\xi_{k_{1}\cdots k_{q}}x_{k_{1}}\cdots x_{k_{q}}\right) \\
&  =\left\vert \left\langle \left\langle \xi\right\rangle \right\rangle
_{0}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq p,q\leq2r}\sum
_{\substack{1\leq j_{1}<\cdots<j_{p}\leq2r\\1\leq k_{1}<\cdots<k_{q}\leq
2r}}\overline{\xi}_{j_{1}\cdots j_{p}}\xi_{k_{1}\cdots k_{q}}x_{j_{p}}\cdots
x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}}%
\end{align}
so that%
\begin{equation}
\mathit{\operatorname*{tr}}\left\{  \xi^{\dagger}\xi\right\}  =\left\vert
\left\langle \left\langle \xi\right\rangle \right\rangle _{0}\right\vert
