\section{Positivity Constraints}

\begin{theorem}
A partial state $f_{\left(  4\right)  }$ defined on $\mathcal{F}_{\left(
4\right)  }$ can be extended to a state $f$ of $\mathcal{F}$ if and only if
\begin{equation}
0\leq f_{\left(  4\right)  }\left(  P\right)  \leq1\quad\forall P\in
\Pr\left\{  \mathcal{F}_{\left(  4\right)  }\right\}  ,
\end{equation}
where $\Pr\left\{  \mathcal{F}_{\left(  4\right)  }\right\}  $ is the set of
orthogonal projections (orthogonal idempotents $\equiv$ self adjoint
idempotents) belonging to $\mathcal{F}_{\left(  4\right)  }.$
\end{theorem}

If $f_{\left(  4\right)  }$ is a normal partial state
\begin{equation}
f_{\left(  4\right)  }\left(  P\right)  =\operatorname*{tr}\left\{
PD_{\left(  4\right)  }\right\}  =\operatorname*{tr}\left\{  P\left(
I_{\mathcal{F}}+d_{1}+d_{2}+d_{3}+d_{4}\right)  \right\}
\end{equation}
and if $f_{\left(  4\right)  }$ is gauge invariant normal state
\begin{equation}
f_{\left(  4\right)  }\left(  P\right)  =\operatorname*{tr}\left\{
PD_{\left(  4\right)  }\right\}  =\operatorname*{tr}\left\{  P\left(
I_{\mathcal{F}}+d_{2}+d_{4}\right)  \right\}  =\operatorname*{tr}\left\{
P_{0}I_{\mathcal{F}}+P_{2}d_{2}+P_{4}d_{4}\right\}  =P_{0}+\operatorname*{tr}%
\left\{  P_{2}d_{2}+P_{4}d_{4}\right\}  .
\end{equation}
A gauge invariant partial state can be extended iff
\begin{equation}
D_{\left(  4\right)  }=\left\langle QQ^{\dagger}\right\rangle _{0}%
+\left\langle QQ^{\dagger}\right\rangle _{2}+\left\langle QQ^{\dagger
}\right\rangle _{4},
\end{equation}
for \emph{some }$Q$ (there could be many $Q^{\prime}s$ defining the same
$D_{\left(  4\right)  }),$ where in general
\begin{equation}
Q=\sum_{0\leq j\leq2r}\left\langle Q\right\rangle _{j}.
\end{equation}
Orthogonal idempotents/projections are positive thus
\begin{equation}
P=pp^{\dagger}%
\end{equation}
thus for normal partial states
\begin{equation}
f_{\left(  4\right)  }\left(  P\right)  =\left\langle \left\langle PD_{\left(
4\right)  }\right\rangle \right\rangle _{0}=\operatorname*{tr}\left\{
PD_{\left(  4\right)  }\right\}  =\operatorname*{tr}\left\{  pp^{\dagger
}D_{\left(  4\right)  }\right\}  =\operatorname*{tr}\left\{  p^{\dagger
}D_{\left(  4\right)  }p\right\}  =\left\langle \left.  p\right\vert
D_{\left(  4\right)  }p\right\rangle _{\mathcal{F}}.
\end{equation}
and
\begin{equation}
0\leq\left\langle \left.  p\right\vert D_{\left(  4\right)  }p\right\rangle
_{\mathcal{F}}\leq1.
\end{equation}
If
\begin{equation}
P\in\Pr\left\{  \mathcal{F}_{\left(  4\right)  }\right\}  \Leftrightarrow
p\in\mathcal{F}_{\left(  4\right)  }%
\end{equation}
then the positivity (representability) constraint becomes
