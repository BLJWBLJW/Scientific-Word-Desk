a_{j}^{\dagger}\right)  \right\rangle  &  =\left\langle a_{k}^{\dagger
}\widehat{\mathcal{N}}_{a}\left(  a_{j}^{\dagger}\right)  \right\rangle
_{0}=\left\langle \left.  a_{k}\right\vert a_{j}^{\dagger}\right\rangle
=\operatorname*{tr}\left\{  a_{k}^{\dagger}a_{j}^{\dagger}\right\}
=-\operatorname*{tr}\left\{  a_{j}^{\dagger}a_{k}^{\dagger}\right\}
\Rightarrow\operatorname*{tr}\left\{  a_{k}^{\dagger}a_{j}^{\dagger}\right\}
=0\\
\left\langle \left.  a_{k}^{\dagger}\right\vert \widehat{\mathcal{N}}%
_{a}\left(  a_{j}^{\dagger}\right)  \right\rangle  &  =\left\langle a_{k}^{{}%
}\widehat{\mathcal{N}}_{a}\left(  a_{j}^{\dagger}\right)  \right\rangle
_{0}=\left\langle \left.  a_{k}^{\dagger}\right\vert a_{j}^{\dagger
}\right\rangle =\operatorname*{tr}\left\{  a_{k}a_{j}^{\dagger}\right\}
=\left\{
\begin{array}
[c]{c}%
0\text{ if }k\neq j\\
\frac{1}{2}\text{ if }k=j
\end{array}
\right. \\
\left\langle \left.  a_{k}^{{}}\right\vert \widehat{\mathcal{N}}_{a}\left(
