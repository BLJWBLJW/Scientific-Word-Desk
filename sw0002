\subsection{Gauge Group}

The number operator is given by
\begin{equation}
\mathcal{N}=\sum_{1\leq j\leq r}n_{j}=\mathcal{N}_{0}+\mathcal{N}%
_{2}=\mathcal{N}=\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}x_{j}x_{j+r}.
\end{equation}
leading to
\begin{align}
\operatorname{Tr}\left\{  \Pi_{\mathit{\operatorname*{tr}}}\left(
\mathcal{N}\right)  ^{\dagger}\frac{1}{2^{2r}}\Pi_{\mathit{\operatorname*{tr}%
}}\left(  D_{f}\right)  \right\}   &  =\frac{1}{2^{2r}}\operatorname{Tr}%
\left\{  \Pi_{\mathit{\operatorname*{tr}}}\left(  \mathcal{N}D_{f}\right)
\right\}  =\mathit{\operatorname*{tr}}\left(  \mathcal{N}D_{f}\right)
=\left\langle \left\langle \mathcal{N}D_{f}\right\rangle \right\rangle _{0}\\
&  =\frac{1}{2^{2r}}\operatorname{Tr}\left\{  \Pi_{\mathit{\operatorname*{tr}%
}}\left(  \left(  \frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}x_{j}%
x_{j+r}\right)  D_{f}\right)  \right\} \\
&  =\operatorname{Tr}\left\{  \Pi_{\mathit{\operatorname*{tr}}}\left(  \left(
\frac{r}{2^{2r}}I_{\mathcal{F}}+\frac{i}{2^{2r}}\sum_{1\leq j\leq r}%
x_{j}x_{j+r}\right)  D_{f}\right)  \right\}  .
\end{align}


The \emph{Gauge} group is defined as
\begin{equation}
u\left(  \theta\right)  =e^{i\mathcal{N}\theta}=\exp\left\{  \left(  \frac
{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}x_{j}x_{j+r}\right)  \theta
\right\}  ,\theta\in\mathbb{R}%
\end{equation}
and its action on $\mathcal{F}$ is given by
\begin{equation}
Adj\left(  u\left(  \theta\right)  \right)  \left(  \cdot\right)
=\widehat{u\left(  \theta\right)  }\left(  \cdot\right)  =\exp\left\{
adj\left(  \mathcal{N}\right)  \theta\right\}  \left(  \cdot\right)
=\exp\left\{  \left[  N,\cdot\right]  \theta\right\}  =\exp\left\{
\widehat{\mathcal{N}}\theta\right\}  \left(  \cdot\right)  ,
\end{equation}
i.e.
\begin{equation}
\widehat{u\left(  \theta\right)  }\left(  A\right)  =e^{i\mathcal{N}\theta
}Ae^{-i\mathcal{N}\theta}=\exp\left\{  i\sum_{1\leq j\leq r}x_{j}%
x_{j+r}\right\}  A\exp\left\{  -i\sum_{1\leq j\leq r}x_{j}x_{j+r}\right\}
=\exp\left\{  i\left[  \mathcal{N},A\right]  \theta\right\}  =\exp\left\{
i\left[  \mathcal{N}_{maj},A\right]  \theta\right\}  ,
\end{equation}
so the generator of $\widehat{u\left(  \theta\right)  }$ is not unique and can
be in particular either $\widehat{\mathcal{N}}$ or $\widehat{\mathcal{N}%
}_{maj}.$

As
\begin{equation}
\left[  x_{j}x_{k},x_{l}x_{m}\right]  =0,\left\{  jk\right\}  \neq\left\{
lm\right\}  ,
\end{equation}
but
\begin{equation}
\left[  x_{j}x_{k},x_{l}x_{m}\right]  \neq0,\left\{  jk\right\}  \cap\left\{
lm\right\}  =\left\{  j\right\}  \text{ or }\left\{  k\right\}  ,
\end{equation}
thus in general
\begin{equation}
\left[  \mathcal{N},A\right]  =\left[  \mathcal{N}_{maj},A\right]  \neq0
\end{equation}
and
\begin{equation}
\widehat{u\left(  \theta\right)  }\left(  A\right)  \neq A.
\end{equation}
$\mathcal{F}_{2}$ decomposes into irreducible subspaces of
$\widehat{\mathcal{N}}$, $\widehat{\mathcal{N}_{maj}}$ and $\widehat{u\left(
\theta\right)  }$.

