\subsection{Hamiltonians and Time Evolutions}

In the vacuum representation the expectation value of a one particle
Hamiltonian is given by
\begin{align}
&  \left\langle \left.  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}^{\dagger}\right)  \right\vert \Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  \widehat{H}\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right)  \right\rangle =\operatorname*{tr}\left\{
a_{j}\widehat{H}\left(  a_{j}^{\dagger}\right)  \left\vert \phi\right\rangle
\left\langle \phi\right\vert \right\}  =E_{j}\operatorname*{tr}\left\{
a_{j}a_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle \phi\right\vert
\right\} \\
&  =\operatorname*{tr}\left\{  a_{j}\left(  Ha_{j}^{\dagger}-a_{j}^{\dagger
}H\right)  \left\vert \phi\right\rangle \left\langle \phi\right\vert \right\}
=\operatorname*{tr}\left\{  a_{j}Ha_{j}^{\dagger}\left\vert \phi\right\rangle
\left\langle \phi\right\vert \right\}  -\operatorname*{tr}\left\{  a_{j}%
a_{j}^{\dagger}H\left\vert \phi\right\rangle \left\langle \phi\right\vert
\right\} \\
&  =\operatorname*{tr}\left\{  a_{j}Ha_{j}^{\dagger}\left\vert \phi
\right\rangle \left\langle \phi\right\vert \right\}  =E_{j}\operatorname*{tr}%
\left\{  a_{j}a_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\}  =E_{j},
\end{align}
as
\begin{equation}
H\left\vert \phi\right\rangle \left\langle \phi\right\vert =0,
\end{equation}
which also means that $\Pi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  \widehat{u}\right)  $ and $\Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  \widehat{H}\right)  $
are well defined. Thus
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =2^{-r}\operatorname*{Tr}\left\{
A\right\}  ,
\end{equation}%
\begin{equation}
\left\langle \left.  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}^{\dagger}\right)  \right\vert \Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  \widehat{H}\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right)  \right\rangle =\left\langle \left.  \varphi
_{j}\right\vert H\varphi_{j}\right\rangle .
\end{equation}
and
\begin{align}
\left\langle \left.  \varphi_{j}\right\vert H\varphi_{j}\right\rangle  &
=E_{j}=\operatorname{Tr}\left\{  H\left\vert \varphi_{j}\right\rangle
\left\langle \varphi_{j}\right\vert \right\}  =\operatorname{Tr}\left\{
Ha_{j}^{\dagger}\left\vert \phi\right\rangle \left\langle \phi\right\vert
a_{j}\right\}  =\operatorname{Tr}\left\{  a_{j}Ha_{j}^{\dagger}\left\vert
\phi\right\rangle \left\langle \phi\right\vert \right\} \\
&  =\operatorname{Tr}\left\{  \left(  a_{j}Ha_{j}^{\dagger}-a_{j}%
a_{j}^{\dagger}H\right)  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\}  =\operatorname{Tr}\left\{  a_{j}\widehat{H}\left(
a_{j}^{\dagger}\right)  \left\vert \phi\right\rangle \left\langle
\phi\right\vert \right\} \\
&  =\left\langle \left.  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}^{\dagger}\right)  \right\vert \Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  \widehat{H}\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right)  \right\rangle .
\end{align}
A time evolution in $\mathcal{H}^{1}$ is given by
\begin{equation}
\left\vert \psi\left(  t\right)  \right\rangle =u\left(  t\right)  \left\vert
\psi\right\rangle =e^{-iHt}\left\vert \psi\right\rangle
\end{equation}
and in $\mathcal{F}$ by
\begin{equation}
A\left(  t\right)  =\widehat{u}\left(  t\right)  \left(  A\right)  =u\left(
t\right)  Au\left(  t\right)  ^{\dagger}=e^{-iHt}Ae^{iHt}=\exp\left\{
-i\operatorname{adj}\left(  H\right)  \right\}  \left(  A\right)  ,
\end{equation}
where
\begin{equation}
\widehat{H}\left(  A\right)  =\operatorname{adj}\left(  H\right)  \left(
A\right)  =\left[  H,A\right]  .
\end{equation}
This gives
\begin{align}
u\left(  t\right)  a_{j}^{\dagger}u\left(  t\right)  ^{\dagger}  &
=a_{j}^{\dagger}\left(  u\left(  t\right)  \varphi_{j}\right)  =\Gamma\left(
u\left(  t\right)  \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert u\left(  t\right)  ^{\dagger}\right) \\
\widehat{H}\left(  a_{j}^{\dagger}\right)   &  =\left[  H,a_{j}^{\dagger
}\right]  =a_{j}^{\dagger}\left(  H\varphi_{j}\right)  =\Gamma\left(
H\left\vert \varphi_{j}\right\rangle \left\langle \phi\right\vert -\left\vert
\varphi_{j}\right\rangle \left\langle \phi\right\vert H\right)  ,
\end{align}
which shows
\begin{align}
H\varphi_{j}  &  =E_{j}\varphi_{j}\\
\widehat{H}\left(  \left\vert \varphi_{j}\right\rangle \left\langle
\phi\right\vert \right)   &  =E_{j}\left\vert \varphi_{j}\right\rangle
\left\langle \phi\right\vert \\
\widehat{H}\left(  a_{j}^{\dagger}\right)   &  =E_{j}a_{j}^{\dagger}.
\end{align}
$\lceil$%

\begin{align}
\left[  \sum_{1\leq j\leq r}E_{j}a_{j}^{\dagger}a_{j},a_{k}^{\dagger}\right]
&  =\sum_{1\leq j\leq r}E_{j}\left[  a_{j}^{\dagger}a_{j},a_{k}^{\dagger
}\right]  =\sum_{1\leq j\leq r}E_{j}\left(  a_{j}^{\dagger}a_{j}a_{k}%
^{\dagger}-a_{k}^{\dagger}a_{j}^{\dagger}a_{j}\right)  =E_{k}\left(
a_{k}^{\dagger}a_{k}a_{k}^{\dagger}-a_{k}^{\dagger}a_{k}^{\dagger}%
a_{k}\right)  =E_{k}a_{k}^{\dagger}\\
&  =a^{\dagger}\left(  E_{k}\varphi_{k}\right)  =a^{\dagger}\left(
H\varphi_{k}\right)  =E_{k}a^{\dagger}\left(  \varphi_{k}\right)  .
\end{align}%
\begin{equation}
e^{-iHt}a_{k}^{\dagger}e^{iHt}=e^{-iE_{k}t}a_{k}^{\dagger}%
\end{equation}
$\rfloor$

The states $\left\{  \left.  a_{j}^{\dagger}a_{j}\right\vert 1\leq j\leq
r\right\}  $ and $\left\{  \left.  a_{j}a_{j}^{\dagger}\right\vert 1\leq j\leq
r\right\}  $ are stationary and $\left\{  \left.  a_{j}^{\dagger}%
,a_{j}\right\vert 1\leq j\leq r\right\}  $ are eigen operators of
$\widehat{H}$ i.e.
\begin{align}
\widehat{u}\left(  t\right)  \left(  a_{j}^{\dagger}a_{j}\right)   &
=a_{j}^{\dagger}a_{j};\widehat{u}\left(  t\right)  \left(  a_{j}a_{j}%
^{\dagger}\right)  =a_{j}a_{j}^{\dagger}\\
\left[  H,a_{j}^{\dagger}a_{j}\right]   &  =\left[  H,a_{j}a_{j}^{\dagger
}\right]  =0\\
\widehat{H}\left(  a_{j}^{\dagger}\right)   &  =E_{j}a_{j}^{\dagger};1\leq
j\leq r\\
\widehat{H}\left(  a_{j}\right)   &  =-E_{j}a_{j};1\leq j\leq r.
\end{align}
Hence%
\begin{align}
\left\langle a_{j}^{\dagger}\left\vert \widehat{H}a_{j}^{\dagger}\right.
\right\rangle _{\mathcal{F}}  &  =\operatorname*{tr}\left\{  a_{j}\left[
H,a_{j}^{\dagger}\right]  \right\}  =\operatorname*{tr}\left\{  a_{j}\left(
Ha_{j}^{\dagger}-a_{j}^{\dagger}H\right)  \right\}  =\operatorname*{tr}%
\left\{  a_{j}Ha_{j}^{\dagger}\right\}  -\operatorname*{tr}\left\{  a_{j}%
a_{j}^{\dagger}H\right\} \\
&  =\operatorname*{tr}\left\{  Ha_{j}^{\dagger}a_{j}\right\}
-\operatorname*{tr}\left\{  Ha_{j}a_{j}^{\dagger}\right\}  =E_{j}%
\operatorname*{tr}\left\{  a_{j}a_{j}^{\dagger}\right\}  =\operatorname*{tr}%
\left\{  Ha_{j}^{\dagger}a_{j}\right\}  -\operatorname*{tr}\left\{  H\left(
1-a_{j}^{\dagger}a_{j}\right)  \right\}  =2\operatorname*{tr}\left\{
Ha_{j}^{\dagger}a_{j}\right\}  -\operatorname*{tr}\left\{  H\right\} \\
&  \Rightarrow\frac{\left\langle a_{j}^{\dagger}\left\vert \widehat{H}%
a_{j}^{\dagger}\right.  \right\rangle _{\mathcal{F}}}{\left\langle
a_{j}^{\dagger}\left\vert a_{j}^{\dagger}\right.  \right\rangle _{\mathcal{F}%
}}=E_{j}.
\end{align}
However
\begin{equation}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
\widehat{H}\right)  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}^{\dagger}\right)  =\Phi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  Ha_{j}^{\dagger}%
-a_{j}^{\dagger}H\right)  =\Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  Ha_{j}^{\dagger}\right)  =\Pi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  H\right)
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}^{\dagger}\right)  =E_{j}\Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}^{\dagger}\right)
\end{equation}
as
\begin{equation}
\left\langle \left.  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}^{\dagger}H\right)  \right\vert \Phi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  a_{j}^{\dagger
}H\right)  \right\rangle =\operatorname*{tr}\left\{  Ha_{j}a_{j}^{\dagger
}H\left\vert \phi\right\rangle \left\langle \phi\right\vert \right\}  =0
\end{equation}
i.e.
\begin{equation}
a_{j}^{\dagger}H\in\ker\Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }%
\end{equation}
and%
\begin{equation}
\left\langle \left.  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  Ha_{j}^{\dagger}\right)  \right\vert \Phi_{\left\vert
\phi\right\rangle \left\langle \phi\right\vert }\left(  Ha_{j}^{\dagger
}\right)  \right\rangle =\operatorname*{tr}\left\{  a_{j}HHa_{j}^{\dagger
}\left\vert \phi\right\rangle \left\langle \phi\right\vert \right\}  \neq0.
\end{equation}
On the other hand
\begin{equation}
\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
a_{j}\right)  =0
\end{equation}
i.e.
\begin{equation}
a_{j}\in\ker\Phi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }%
\end{equation}
thus
\begin{equation}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
\widehat{H}\right)  \Phi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  a_{j}\right)  =0,
\end{equation}
so the eigenvalues $\left\{  -E_{j}\right\}  $ associated with $\left\{
a_{j}\right\}  $ are eliminated and
\begin{equation}
\Pi_{\left\vert \phi\right\rangle \left\langle \phi\right\vert }\left(
\widehat{H}\right)  =\Pi_{\left\vert \phi\right\rangle \left\langle
\phi\right\vert }\left(  H\right)  .
\end{equation}
\label{rep check}

\section{Bra Ket Operators $\in\mathcal{B}\left(  \mathcal{A}_{HS}\right)  $}

The Hilbert space $\mathcal{A}_{HS}$ is defined by the closure of
$\mathcal{A}_{0}$ $\left(  \text{the analog of finite rank operators}\right)
$ in the norm given by
\begin{equation}
\left\Vert A\right\Vert _{HS}=\left(  \operatorname*{tr}\left\{  A^{\dagger
}A\right\}  \right)  ^{\frac{1}{2}}=\left\langle \left.  A\right\vert
A\right\rangle _{\mathcal{A}}^{\frac{1}{2}}=\left(  \left\langle \left\langle
A^{\dagger}A\right\rangle \right\rangle _{0}\right)  ^{\frac{1}{2}}%
\end{equation}
or equivalently by the GNS\ carrier space defined by the faithful tracial
state $\operatorname*{tr},$ i.e. by $\Phi_{\operatorname*{tr}}\left(
\mathcal{A}^{c}\right)  .$ The representation $\Pi_{\operatorname*{tr}}\left(
\mathcal{A}^{c}\right)  $ of $\mathcal{A}^{c}$ on $\Phi_{\operatorname*{tr}%
}\left(  \mathcal{A}^{c}\right)  \equiv\mathcal{A}_{HS}$ is contained in
$\mathcal{B}\left(  \mathcal{A}_{HS}\right)  $ and it is probably true that
$\mathcal{B}\left(  \mathcal{A}_{HS}\right)  \cong\mathcal{A}^{w}$ as
$w^{\ast}$-algebras.

By redefining the norms of $\left\{  x_{j}\right\}  $ one can define an
orthonormal basis of $\Phi_{\operatorname*{tr}}\left(  \mathcal{A}^{c}\right)
$ as $\left\{  \Phi_{\mathit{\operatorname*{tr}}}\left(  I_{\mathcal{A}%
}\right)  ,\left\{  \left.  \Phi_{\mathit{\operatorname*{tr}}}\left(
x_{j_{1}}\cdots x_{j_{p}}\right)  \right\vert 1\leq j_{1}<\cdots<j_{p}%
\leq2r\right\}  ;1\leq p\leq2r\right\}  $ and $\mathcal{A}_{HS}$ as $\left\{
I_{\mathcal{A}},\left\{  \left.  x_{j_{1}}\cdots x_{j_{p}}\right\vert 1\leq
j_{1}<\cdots<j_{p}\leq2r\right\}  ;1\leq p\leq2r\right\}  $, but note that
there is no difference between $\Phi_{\operatorname*{tr}}\left(
\mathcal{A}^{c}\right)  $ and $\mathcal{A}_{HS}$ so we shall denote the
Hilbert space as $\mathcal{A}_{HS}$ from now on. So as vectors in
$\mathcal{A}_{HS}$ one has the identity
\begin{equation}
A\equiv\Phi_{\mathit{\operatorname*{tr}}}\left(  A\right)  .
\end{equation}
A resolution of the identity $I_{\mathcal{A}_{HS}}\in\mathcal{B}\left(
\mathcal{A}_{HS}\right)  ,$ (One should observe that the action of
$I_{\mathcal{A}}$ and $I_{\mathcal{A}_{HS}}$ on $\mathcal{A}_{HS}$ are
identical), is thus given by
\begin{equation}
I_{\mathcal{A}_{HS}}=\left\vert I_{\mathcal{A}}\right\rangle \left\langle
I_{\mathcal{A}}\right\vert +\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \left\langle
x_{j_{1}}\cdots x_{j_{p}}\right\vert ,
\end{equation}
note that
\begin{equation}
\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \equiv x_{j_{1}}\cdots
x_{j_{p}},
\end{equation}
leading to the vector expansion
\begin{align}
A  &  =I_{\mathcal{A}_{HS}}A=\left(  \left\vert I_{\mathcal{A}}\right\rangle
\left\langle I_{\mathcal{A}}\right\vert +\sum_{1\leq p\leq2r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle x_{j_{1}}\cdots x_{j_{p}}\right\vert \right)  A\\
&  =\left\vert I_{\mathcal{A}}\right\rangle \left\langle \left.
I_{\mathcal{A}}\right\vert A\right\rangle _{\mathcal{A}}+\sum_{1\leq p\leq
2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\left\vert x_{j_{1}}\cdots x_{j_{p}%
}\right\rangle \left\langle \left.  x_{j_{1}}\cdots x_{j_{p}}\right\vert
A\right\rangle _{\mathcal{A}}\\
&  =\left\vert I_{\mathcal{A}}\right\rangle \operatorname*{tr}\left\{
A\right\}  +\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq
2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \operatorname*{tr}%
\left\{  x_{j_{p}}\cdots x_{j_{1}}A\right\} \\
&  =\operatorname*{tr}\left\{  A\right\}  I_{\mathcal{A}}+\sum_{1\leq p\leq
2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\operatorname*{tr}\left\{  x_{j_{p}%
}\cdots x_{j_{1}}A\right\}  x_{j_{1}}\cdots x_{j_{p}}\\
&  =\left\langle \left\langle A\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq p\leq2r}\sum_{1\leq j_{1}<\cdots<j_{p}\leq2r}\left\langle
\left\langle x_{j_{p}}\cdots x_{j_{1}}A\right\rangle \right\rangle
_{0}x_{j_{1}}\cdots x_{j_{p}}.
\end{align}
Thus one can make the identifications
\begin{equation}
\left\langle A\right\rangle _{p}=\sum_{1\leq j_{1}<\cdots<j_{p}\leq
2r}\left\langle \left\langle x_{j_{p}}\cdots x_{j_{1}}A\right\rangle
\right\rangle _{0}x_{j_{1}}\cdots x_{j_{p}}=\sum_{1\leq j_{1}<\cdots<j_{p}%
\leq2r}A_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}};0\leq p\leq2r
\end{equation}


Any nuclear operator $T\in\mathcal{B}\left(  \mathcal{A}_{HS}\right)  $ can be
expressed as
\begin{equation}
T=\sum_{0\leq p,q\leq2r}\sum_{\substack{0\leq j_{1}<\cdots<j_{p}\leq2r\\0\leq
k_{1}<\cdots<k_{q}\leq2r}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
T_{j_{1}\cdots j_{p}k_{1}\cdots k_{q}}\left\langle x_{k_{1}}\cdots x_{k_{q}%
}\right\vert =\sum_{0\leq p,q\leq2r}\sum_{\substack{0\leq j_{1}<\cdots
