\section{GNS\ Construction}

A state $f$ on a $c^{\ast}$-algebra is defined by a linear functional that has
the properties
\begin{align}
f  &  :\mathcal{A\longrightarrow}\mathbb{C}\\
f\left(  A\right)   &  =\overline{f\left(  A^{\dagger}\right)  }\\
f\left(  \alpha A+\beta B\right)   &  =\alpha f\left(  A\right)  +\beta
f\left(  B\right) \\
f\left(  I_{\mathcal{A}}\right)   &  =1\\
A  &  \geq0\Rightarrow f\left(  A\right)  \geq0.
\end{align}
$\left(  A\geq0\Longleftrightarrow A=Q^{\dagger}Q\text{ for some }Q\right)  .$
States are normal if there exists a density operator $D_{f}\in\mathcal{A}%
,D_{f}\geq0$ and $\operatorname*{tr}\left\{  D_{f}\right\}  =1$, such that
\begin{equation}
f\left(  A\right)  =\operatorname*{tr}\left\{  AD_{f}\right\}  .
\end{equation}
States are faithful if
\begin{equation}
f\left(  A\right)  =0\,\Longleftrightarrow A=0,
\end{equation}
in particular the $\operatorname*{tr}$ functional is a faithful state i.e.
\begin{equation}
A\geq0\text{ and }\operatorname*{tr}\left\{  A\right\}  =0\Longleftrightarrow
A=0.
\end{equation}
$\lceil$Non faithful states are more common e.g.%
\begin{equation}
f_{\left\vert \Psi\right\rangle \left\langle \Psi\right\vert }\left(
c_{1}\left\vert \Phi_{1}\right\rangle \left\langle \Phi_{1}\right\vert
+c_{2}\left\vert \Phi_{2}\right\rangle \left\langle \Phi_{2}\right\vert
\right)  =\operatorname*{tr}\left\{  \left(  c_{1}\left\vert \Phi
_{1}\right\rangle \left\langle \Phi_{1}\right\vert +c_{2}\left\vert \Phi
_{2}\right\rangle \left\langle \Phi_{2}\right\vert \right)  ^{\dagger
}\left\vert \Psi\right\rangle \left\langle \Psi\right\vert \right\}  =0,
\end{equation}
when
\begin{equation}
\left\langle \left.  \Psi\right\vert \Phi_{1}\right\rangle =\left\langle
\left.  \Psi\right\vert \Phi_{2}\right\rangle =0.
\end{equation}
$\rfloor$

States define Hilbert spaces, $\Phi_{f}\left(  \mathcal{A}\right)  ,$ by the
GNS construction%
\begin{align}
\Phi_{f}  &  :\mathcal{A\longrightarrow H}_{f}\\
\ker\left\{  \Phi_{f}\right\}   &  =\left\{  \left.  \xi\right\vert f\left(
\xi^{\dagger}\xi\right)  =0\right\} \\
\Phi_{f}\left(  A+\xi\right)   &  =\Phi_{f}\left(  A\right) \\
\Phi_{f}\left(  \alpha A+\beta B\right)   &  =\alpha\Phi_{f}\left(  A\right)
+\beta\Phi_{f}\left(  B\right) \\
\left\Vert \Phi_{f}\left(  A\right)  \right\Vert _{\mathcal{H}_{f}}  &
=\left(  f\left(  A^{\dagger}A\right)  \right)  ^{\frac{1}{2}}=\left(
\operatorname*{tr}\left\{  A^{\dagger}AD_{f}\right\}  \right)  ^{\frac{1}{2}%
}\\
\left\langle \left.  \Phi_{f}\left(  A\right)  \right\vert \Phi_{f}\left(
B\right)  \right\rangle _{\mathcal{H}_{f}}  &  =f\left(  A^{\dagger}B\right)
=\operatorname*{tr}\left\{  A^{\dagger}BD_{f}\right\}  .
\end{align}
Hence
\begin{equation}
\xi\in\ker\left\{  \Phi_{f}\right\}  \Longleftrightarrow\left\Vert \Phi
_{f}\left(  \xi\right)  \right\Vert _{\mathcal{H}_{f}}^{2}=f\left(
\xi^{\dagger}\xi\right)  =\operatorname*{tr}\left\{  \xi^{\dagger}\xi
D_{f}\right\}  =0\equiv\Phi_{f}\left(  \xi\right)  =0.
\end{equation}
One can observe
\begin{equation}
\xi\in\ker\left\{  \Phi_{f}\right\}  \Rightarrow\left\langle \left.  \Phi
_{f}\left(  \xi\right)  \right\vert \Phi_{f}\left(  I_{\mathcal{F}}\right)
\right\rangle _{\mathcal{H}_{f}}=f\left(  \xi^{\dagger}\right)
=\operatorname*{tr}\left\{  \xi^{\dagger}D_{f}\right\}  =0
\end{equation}
and
\begin{equation}
\xi\in\ker\left\{  \Phi_{f}\right\}  \Rightarrow\left\langle \left.  \Phi
_{f}\left(  I_{\mathcal{F}}\right)  \right\vert \Phi_{f}\left(  \xi\right)
\right\rangle _{\mathcal{H}_{f}}=f\left(  \xi\right)  =\operatorname*{tr}%
\left\{  \xi D_{f}\right\}  =0,
\end{equation}
\emph{but be especially cognizant that }
\begin{equation}
\xi\in\ker\left\{  \Phi_{f}\right\}  \nRightarrow\xi^{\dagger}\in\ker\left\{
\Phi_{f}\right\}  \text{ i.e. }\nRightarrow f\left(  \xi\xi^{\dagger}\right)
=0.
\end{equation}
$\lceil$An example of this is
\begin{equation}
f\left(  a^{\dagger}a\right)  =0=f\left(  I_{\mathcal{F}}-aa^{\dagger}\right)
\Rightarrow f\left(  aa^{\dagger}\right)  =1.
\end{equation}
$\rfloor$

If a state $f$ is faithful
\begin{equation}
\ker\left\{  \Phi_{f}\right\}  =0.
\end{equation}


One should note that

\begin{enumerate}
\item
\begin{equation}
f\left(  \xi^{\dagger}\right)  =f\left(  \xi\right)  =0\nRightarrow\xi\in
\ker\left\{  \Phi_{f}\right\}  ,\text{ nor }\xi^{\dagger}\in\ker\left\{
\Phi_{f}\right\}  ,
\end{equation}


\item
\[
0=f\left(  \xi^{\dagger}\xi\right)  =\operatorname*{tr}\left\{  \xi^{\dagger
}\xi D_{f}\right\}  =\operatorname*{tr}\left\{  \xi D_{f}\xi^{\dagger
}\right\}  =\operatorname*{tr}\left\{  D_{f}\xi^{\dagger}\xi\right\}
\Leftrightarrow\xi\in\ker\left\{  \Phi_{f}\right\}  \Leftrightarrow\xi
D_{f}\xi^{\dagger}=0,
\]


\item
\begin{equation}
\operatorname*{tr}\left\{  \xi^{\dagger}\xi D_{f}\right\}  =\operatorname*{tr}%
\left\{  \xi^{\dagger}\xi Q_{f}Q_{f}^{\dagger}\right\}  =\operatorname*{tr}%
\left\{  Q_{f}^{\dagger}\xi^{\dagger}\xi Q_{f}\right\}  =\operatorname*{tr}%
\left\{  \left(  \xi Q_{f}\right)  ^{\dagger}\xi Q_{f}\right\}  ,
\end{equation}
thus
\begin{equation}
\operatorname*{tr}\left\{  \xi^{\dagger}\xi D_{f}\right\}  =0\Leftrightarrow
\xi Q_{f}=0,
\end{equation}
as $\operatorname*{tr}$ is faithful.
\end{enumerate}

Representations of $\mathcal{A}$ can then be constructed (GNS construction)
by
\begin{align}
\Pi_{f}  &  :\mathcal{A\hookrightarrow B}\left(  \mathcal{H}_{f}\right) \\
\Pi_{f}\left(  A\right)  \Phi_{f}\left(  X\right)   &  =\Phi_{f}\left(
AX\right) \\
\left\Vert \Pi_{f}\left(  A\right)  \right\Vert _{\mathcal{B}\left(
\mathcal{H}_{f}\right)  }  &  =\sup\limits_{\Phi_{f}\left(  X\right)
\in\mathcal{H}_{f}}\left\{  \left\vert \frac{\left\langle \left.  \Phi
_{f}\left(  X\right)  \right\vert \Pi_{f}\left(  A\right)  \Phi_{f}\left(
X\right)  \right\rangle _{\mathcal{H}_{f}}}{\left\langle \left.  \Phi
_{f}\left(  X\right)  \right\vert \Phi_{f}\left(  X\right)  \right\rangle
_{\mathcal{H}_{f}}}\right\vert \right\} \\
&  =\sup\limits_{\Phi_{f}\left(  X\right)  \in\mathcal{H}_{f}}\left\{
\left\vert \frac{\operatorname*{tr}\left\{  X^{\dagger}AXD_{f}\right\}
}{\operatorname*{tr}\left\{  X^{\dagger}XD_{f}\right\}  }\right\vert \right\}
\\
&  =\sup\limits_{\Phi_{f}\left(  X\right)  \in\mathcal{H}_{f}}\left\{
\left\vert \operatorname{Tr}\left\{  \Pi_{f}\left(  A\right)  \frac{\left\vert
\Phi_{f}\left(  X\right)  \right\rangle \left\langle \Phi_{f}\left(  X\right)
\right\vert }{\left\langle \left.  \Phi_{f}\left(  X\right)  \right\vert
\Phi_{f}\left(  X\right)  \right\rangle _{\mathcal{H}_{f}}}\right\}
\right\vert \right\} \\
&  =\sup\limits_{\Phi_{f}\left(  X\right)  \in\mathcal{H}_{f}}\left\{
\left\vert \frac{\operatorname{Tr}\left\{  \Pi_{f}\left(  A\right)  \left\vert
\Phi_{f}\left(  X\right)  \right\rangle \left\langle \Phi_{f}\left(  X\right)
\right\vert \right\}  }{\operatorname{Tr}\left\{  \left\vert \Phi_{f}\left(
X\right)  \right\rangle \left\langle \Phi_{f}\left(  X\right)  \right\vert
\right\}  }\right\vert \right\}  ,
\end{align}
where $\Pi_{f}\left(  \mathcal{A}\right)  $ \emph{is in general a subalgebra}
of $\mathcal{B}\left(  \mathcal{H}_{f}\right)  .$ As $\Pi_{f}\left(
\mathcal{A}\right)  $ is a subalgebra not all elements of $\Pi_{f}\left(
\mathcal{A}\right)  ^{\prime\prime}$ are contained in $\mathcal{B}\left(
\mathcal{H}_{f}\right)  $ e.g. if $\Pi_{f}\left(  \mathcal{A}\right)
^{\prime\prime}$ is a type III Von Neumann algebra than it contains no finite
dimensional projctors, thus no atomic projections and \emph{no pure states}.
However the action of $\Pi_{f}\left(  \mathcal{A}\right)  ^{\prime\prime}$ is
defined on all vectors in $\mathcal{H}_{f}$ e.g.
\begin{equation}
\left\langle \left.  v\right\vert \Pi_{f}\left(  A\right)  v\right\rangle
_{\mathcal{H}_{f}}\in\mathbb{R};\Pi_{f}\left(  A\right)  =\Pi_{f}\left(
A\right)  ^{\dagger}%
\end{equation}
is always a finite expectation value of the self adjoint operator $\Pi
_{f}\left(  A\right)  $ even though
\begin{equation}
\left\vert v\right\rangle \left\langle v\right\vert \notin\Pi_{f}\left(
\mathcal{A}\right)  ,
\end{equation}
\emph{in particular} it is possible that the projector onto the generating
state
\begin{equation}
\left\vert \Phi_{f}\left(  I_{\mathcal{A}}\right)  \right\rangle \left\langle
\Phi_{f}\left(  I_{\mathcal{A}}\right)  \right\vert \notin\Pi_{f}\left(
\mathcal{A}\right)  .
\end{equation}
A state, $\lambda,$ is normal for $\Pi_{f}\left(  \mathcal{A}\right)
^{\prime\prime}$ if $\exists D_{\lambda}\in\Pi_{f}\left(  \mathcal{A}\right)
^{\prime\prime}$ such that
\begin{equation}
\lambda\left(  \Pi_{f}\left(  A\right)  \right)  =\operatorname{Tr}\left\{
\Pi_{f}\left(  A\right)  D_{\lambda}\right\}  ;\,D_{\lambda}\in\Pi_{f}\left(
\mathcal{A}\right)  ^{\prime\prime},
\end{equation}
so it is possible that \emph{no normal} states exist for a given $\Pi
_{f}\left(  \mathcal{A}\right)  ^{\prime\prime}.$

The vector $\Phi_{f}\left(  I_{\mathcal{A}}\right)  $ is a \emph{cyclic}
vector for $\Pi_{f}\left(  \mathcal{A}\right)  $ i.e.
\begin{equation}
\mathcal{H}_{f}=\overline{\left\{  \left.  \Pi_{f}\left(  \mathcal{A}\right)
\Phi_{f}\left(  I_{\mathcal{A}}\right)  \right\vert A\in\mathcal{A}\right\}
}.
\end{equation}
If
\begin{equation}
\ker\left\{  \Phi_{f}\right\}  =\left\{  0\right\}
\end{equation}
then $f$ is also \emph{seperating, }which also implies\emph{ }that $f$ is
faithful\emph{. }

A vector $v$ is \emph{cyclic} for an subalgebra $\mathcal{A}_{sub}$ if
\begin{equation}
\mathcal{H}=\overline{\left\{  \left.  Av\right\vert A\in\mathcal{A}%
_{sub}\right\}  }.
\end{equation}
A vector $v$ is \emph{seperating} for a subalgebra $\mathcal{A}_{sub}$ if the
only solution to
\begin{equation}
Av=0;\text{ }A\in\mathcal{A}_{sub}%
\end{equation}
is
\begin{equation}
A=0.
\end{equation}
In terms of a GNS representation this is equivalent to
\begin{equation}
\Pi_{f}\left(  A\right)  \Phi_{f}\left(  I_{\mathcal{A}}\right)
=0\Longleftrightarrow\Pi_{f}\left(  A\right)  =0.
\end{equation}


\bigskip One can observe that $\ker\left\{  \Phi_{f}\right\}  $ is a left
ideal in $\mathcal{A},$ $\left(  \text{which is not in general selfadjoint}%
\right)  ,$ as
\begin{equation}
\Pi_{f}\left(  A\right)  \Phi_{f}\left(  \xi\right)  =\Phi_{f}\left(
A\xi\right)  =0\text{ if }\xi\in\ker\left\{  \Phi_{f}\right\}
\end{equation}
i.e.
\begin{equation}
A\xi\in\ker\left\{  \Phi_{f}\right\}  \text{ if }\xi\in\ker\left\{  \Phi
_{f}\right\}  .
\end{equation}
In particular this shows that $\ker\left\{  \Phi_{f}\right\}  $ is closed
under multiplication and as it is trivially closed under addition (as
$\Phi_{f}$ is linear) it is an subalgebra.

If the state $f$ is faithful i.e.
\begin{equation}
\ker\left\{  \Phi_{f}\right\}  =\left\{  0\right\}  ,
\end{equation}
then the condition that the vector $\Phi_{f}\left(  I_{\mathcal{A}}\right)  $
is seperating for $\Pi_{f}\left(  \mathcal{A}\right)  $
\begin{equation}
\Pi_{f}\left(  A\right)  \Phi_{f}\left(  I_{\mathcal{A}}\right)  =\Phi
_{f}\left(  A\right)  =0\,\forall A\in\mathcal{A}%
\end{equation}
implies that
\begin{equation}
A=0.
\end{equation}
This shows that if
\begin{equation}
\Pi_{f}\left(  A-B\right)  \Phi_{f}\left(  I_{\mathcal{A}}\right)  =\Phi
_{f}\left(  A-B\right)  =0
\end{equation}
and $f$ is faithful then
\begin{equation}
A-B=0\equiv A=B
\end{equation}
and thus $\Pi_{f}$ is faithful i.e.
\begin{equation}
\ker\left\{  \Pi_{f}\right\}  =\left\{  0\right\}  .
\end{equation}
\emph{The converse is not true} i.e. $\Pi_{f}$ being faithful$\,\nRightarrow
f$ is faithful. If $f$ is a pure state then $\Pi_{f}$ is irreducible, pure
states are in general non faithful but irreducible representations are usually faithful.

