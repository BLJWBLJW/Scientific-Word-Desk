_{f}\left(  \mathcal{A}\right)  _{\ast}^{\prime\prime}\subset\mathcal{B}%
\left(  \mathcal{H}_{f}\right)  \text{ and}\notin\Pi_{f}\left(  \mathcal{A}%
\right)  ^{\prime\prime},
\end{equation}
it is even possible
\begin{equation}
\Pi_{f}\left(  \mathcal{A}\right)  ^{\prime\prime}\cap\Pi_{f}\left(
\mathcal{A}\right)  _{\ast}^{\prime\prime}=\phi.
\end{equation}


We now concentrate on the representation generated by the state
$\operatorname*{tr}$ with density operator $I_{\mathcal{A}}$
\begin{equation}
\operatorname*{tr}\left(  A\right)  =\operatorname*{tr}\left\{
AI_{\mathcal{A}}\right\}
\end{equation}
is produced by the Hilbert Space $\mathcal{A}_{HS}\equiv\Phi
_{\operatorname*{tr}}\left(  \mathcal{A}\right)  $ i.e.
\begin{align}
\Phi_{\operatorname*{tr}}  &  :\mathcal{A\longrightarrow H}%
_{\operatorname*{tr}}\equiv\mathcal{A}_{HS}\\
\ker\left\{  \Phi_{\operatorname*{tr}}\right\}   &  =\left\{  \left.
\xi\right\vert \operatorname*{tr}\left(  \xi^{\dagger}\xi\right)  =0\right\}
\Rightarrow\xi=0\\
\left\Vert \Phi_{\operatorname*{tr}}\left(  A\right)  \right\Vert
_{\mathcal{H}_{\operatorname*{tr}}}  &  =\left(  \operatorname*{tr}\left\{
A^{\dagger}A\right\}  \right)  ^{\frac{1}{2}}\\
\left\langle \left.  \Phi_{\operatorname*{tr}}\left(  A\right)  \right\vert
\Phi_{\operatorname*{tr}}\left(  B\right)  \right\rangle _{\mathcal{H}%
_{\operatorname*{tr}}}  &  =\operatorname*{tr}\left\{  A^{\dagger}B\right\}  .
\end{align}
The representation
\begin{equation}
\Pi_{\operatorname*{tr}}\left(  \mathcal{A}\right)  \subseteq\mathcal{B}%
\left(  \mathcal{A}_{HS}\right)
\end{equation}
and is a faithful representation. A representation is faithful if
\begin{equation}
\Pi_{f}\left(  A\right)  =0\Rightarrow A=0,
\end{equation}
i.e.
\begin{equation}
\ker\left\{  \Pi_{f}\right\}  =0,
\end{equation}
thus a $c^{\ast}$-algebra isomorphism. If $f$ is faithful so is $\Pi_{f}$
(i.e. this is a sufficient condition), however $\Pi_{f}$ can be faithful even
if $f$ is not (so it is not a neccesary condition).

The metric matrix associated with a state $f\in\mathcal{A}^{d}$ is
\begin{align}
