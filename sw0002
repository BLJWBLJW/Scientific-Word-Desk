\subsubsection{Well Defined GNS Representations}

A transformation $T\in\mathcal{B}\left(  \mathcal{A}\right)  $ induces a
transformation belonging to $\mathcal{B}\left(  \Phi_{f}\left(  \mathcal{A}%
\right)  \right)  $ if
\begin{equation}
T:\ker\Phi_{f}\rightarrow\ker\Phi_{f}%
\end{equation}
i.e. it produces a \emph{well defined operator} $\Pi_{f}\left(  T\right)  .$

The GNS representation of $\widehat{u}$, $\Pi_{f}\left(  \widehat{u}\right)
,$ is well defined if
\begin{equation}
\widehat{u}:\ker\Phi_{f}\rightarrow\ker\Phi_{f}%
\end{equation}
i.e.
\begin{equation}
f\left(  B^{\dagger}B\right)  =f\left(  uA^{\dagger}u^{\dagger}uAu^{\dagger
}\right)  =f\left(  uA^{\dagger}Au^{\dagger}\right)  =0\Leftrightarrow
f\left(  A^{\dagger}A\right)  =0;A,B\in\ker\Phi_{f},
\end{equation}
where
\begin{equation}
B=\widehat{u}\left(  A\right)  .
\end{equation}
Thus
\begin{equation}
\operatorname*{tr}\left\{  uA^{\dagger}Au^{\dagger}D_{f}\right\}
=\operatorname*{tr}\left\{  A^{\dagger}Au^{\dagger}D_{f}u\right\}
=\operatorname*{tr}\left\{  A^{\dagger}AD_{f}\right\}  =0.
\end{equation}
Hence one can see that a \emph{sufficient condition }for $\Pi_{f}\left(
\widehat{u}\right)  $ and its infinitessimal generator $\Pi_{f}\left(
\widehat{h}\right)  $ to be well defined is that $\widehat{u}$ and
$\widehat{u}^{\dagger}$ are symmetries of $D_{f}$ i.e.
\begin{equation}
\widehat{u}\left(  D_{f}\right)  ^{\dagger}=u^{\dagger}D_{f}u=uD_{f}%
u^{\dagger}=D_{f},
\end{equation}
which is equivalent to
\begin{equation}
\widehat{h}\left(  D_{f}\right)  =\left[  h,D_{f}\right]  =0.
\end{equation}
\emph{Neccesary conditions }for well definedness of $\Pi_{f}\left(
\widehat{u}\right)  $ and $\Pi_{f}\left(  \widehat{h}\right)  $ are given by
\begin{equation}
f\left(  \left[  h,X\right]  ^{\dagger}\left[  h,X\right]  \right)  =0\text{
if }f\left(  X^{\dagger}X\right)  =0
\end{equation}
and thus
\begin{equation}
f\left(  \left[  h,X\right]  ^{\dagger}\right)  =f\left(  \left[  h,X\right]
\right)  =0.
\end{equation}
The condition
\begin{equation}
f\left(  \left[  h,X\right]  ^{\dagger}\left[  h,X\right]  \right)  =0\text{ }%
\end{equation}
can be further developed to give%
\begin{equation}
f\left(  \left[  h,X\right]  ^{\dagger}\left[  h,X\right]  \right)
=\operatorname*{tr}\left\{  \left[  h,X\right]  ^{\dagger}\left[  h,X\right]
Q_{f}Q_{f}^{\dagger}\right\}  =\operatorname*{tr}\left\{  Q_{f}^{\dagger
}\left[  h,X\right]  ^{\dagger}\left[  h,X\right]  Q_{f}\right\}
=\operatorname*{tr}\left\{  \left(  \left[  h,X\right]  Q_{f}\right)
^{\dagger}\left(  \left[  h,X\right]  Q_{f}\right)  \right\}  =0,
\end{equation}
which gives
\begin{equation}
\left[  h,X\right]  Q_{f}=0=hXQ_{f}-XhQ_{f}\Rightarrow hXQ_{f}=XhQ_{f}%
\end{equation}
and thus
\begin{equation}
\left[  h,X\right]  Q_{f}Q_{f}^{\dagger}=\left[  h,X\right]  D_{f}%
=0\quad\forall X\in\ker\Phi_{f}.
\end{equation}
The condition
\begin{equation}
f\left(  \left[  h,X\right]  \right)  =0
\end{equation}
can be further developed to give%

\begin{align}
f\left(  \left[  h,X\right]  \right)   &  =\operatorname*{tr}\left\{  \left[
h,X\right]  D_{f}\right\}  =\operatorname*{tr}\left\{  \left(  hX-Xh\right)
D_{f}\right\}  =\operatorname*{tr}\left\{  \left(  hXD_{f}-XhD_{f}\right)
\right\} \\
&  =\operatorname*{tr}\left\{  \left(  XD_{f}h-XhD_{f}\right)  \right\}
=-\operatorname*{tr}\left\{  X\left[  h,D_{f}\right]  \right\}  =0\quad\forall
X\in\ker\Phi_{f}.
\end{align}


\subsubsection{Time Evolution}

The time evolution can be described and characterized by
\begin{align}
D_{Q}\left(  t\right)   &  =\widehat{u}\left(  t\right)  \left(  D\right)
=\widehat{u}\left(  t\right)  \left(  QQ^{\dagger}\right)  =Q\left(  t\right)
Q\left(  t\right)  ^{\dagger}\\
-i\frac{d}{dt}\left\{  Q\left(  t\right)  Q\left(  t\right)  ^{\dagger
}\right\}   &  =\left(  -i\frac{d}{dt}Q\left(  t\right)  \right)  Q\left(
t\right)  ^{\dagger}+Q\left(  t\right)  \left(  -i\frac{d}{dt}Q\left(
t\right)  ^{\dagger}\right) \\
&  =\left[  H,Q\left(  t\right)  \right]  Q\left(  t\right)  ^{\dagger
}+Q\left(  t\right)  \left(  \left[  H,Q\left(  t\right)  ^{\dagger}\right]
\right) \\
&  =\left[  H,Q\left(  t\right)  Q\left(  t\right)  ^{\dagger}\right]  .
\end{align}


$D_{Q}\left(  t\right)  $ is a stationary state if%
\begin{equation}
-i\frac{d}{dt}\left\{  D_{Q}\left(  t\right)  \right\}  =\left[
H,D_{Q}\left(  t\right)  \right]  =0\text{ i.e. }D_{Q}\left(  t\right)
=D_{Q}\quad\forall t.
\end{equation}
The operators $Q\left(  t\right)  $ and $Q\left(  t\right)  ^{\dagger}$ are
called \emph{amplitudes} of $D_{Q}\left(  t\right)  $ and if they are eigen
operators of $\widehat{H}$ i.e.
\begin{gather}
\widehat{H}\left(  Q\left(  t\right)  \right)  =\left[  H,Q\left(  t\right)
\right]  =EQ\left(  t\right) \\
\Updownarrow\\
\widehat{H}\left(  Q^{\dagger}\left(  t\right)  \right)  =\left[  H,Q\left(
t\right)  ^{\dagger}\right]  =-EQ\left(  t\right)  ^{\dagger}%
\end{gather}
they are \emph{stationary operator amplitudes} of $\widehat{H}$ i.e.
\begin{align}
\widehat{u}\left(  t\right)  \left(  Q\right)   &  =e^{-iEt}Q\\
\widehat{u}\left(  t\right)  \left(  Q^{\dagger}\right)   &  =e^{iEt}%
Q^{\dagger},
\end{align}
which implies that $D_{Q}$ and $D_{Q^{\dagger}}$ are stationary states of
$\widehat{H}.$ As $Q$ and $Q^{\dagger}$ are eigen operators of the self
adjoint (super) operator $\widehat{H}$ associated with different eigen values
one has the orthogonality relationships
\begin{align}
\operatorname*{tr}\left\{  QQ\right\}   &  =\operatorname*{tr}\left\{
Q^{\dagger}Q^{\dagger}\right\}  =0\\
\operatorname*{tr}\left\{  Q\left[  H,Q\right]  \right\}   &
=\operatorname*{tr}\left\{  Q^{\dagger}\left[  H,Q^{\dagger}\right]  \right\}
=0\\
&  \Updownarrow\\
\operatorname*{tr}\left\{  QHQ-QQH\right\}   &  =0\Longleftrightarrow
\operatorname*{tr}\left\{  QHQ\right\}  =\operatorname*{tr}\left\{
QQH\right\}  \text{ (which is trivial and always true)}.
\end{align}
A representation $\Pi_{f}$ is faithful if
\begin{equation}
\Pi_{f}\left(  A\right)  =0\Longleftrightarrow A=0.
\end{equation}
If a time evolution is defined by
\begin{equation}
\widehat{u}\left(  t\right)  =\exp\left\{  -i\widehat{H}t\right\}
\end{equation}
then $\Pi_{f}\left(  \widehat{u}\right)  $ is well defined if
\begin{equation}
\left[  H,D_{f}\right]  =0,
\end{equation}
i.e. $D_{f}$ is a stationary state of the Hamiltonian $\widehat{H},$ and its
action on $\Phi_{f}\left(  \mathcal{A}\right)  $ is given by
\begin{align}
\Pi_{f}\left(  \widehat{H}\right)  \Phi_{f}\left(  A\right)   &  =\Phi
_{f}\left(  \left[  H,A\right]  \right) \\
\Pi_{f}\left(  \widehat{u}\left(  t\right)  \right)  \Phi_{f}\left(  A\right)
&  =\Phi_{f}\left(  u\left(  t\right)  Au\left(  t\right)  ^{\dagger}\right)
\,\forall A\in\mathcal{A}.
\end{align}
In particular
\begin{equation}
\Phi_{f}\left(  \left[  H,D_{f}\right]  \right)  =0.
\end{equation}
The inner product in $\Phi_{f}\left(  \mathcal{A}\right)  $ is given by
\begin{equation}
\left\langle \Phi_{f}\left(  A\right)  \left\vert \Phi_{f}\left(  B\right)
\right.  \right\rangle _{\mathcal{H}_{f}}=\operatorname*{tr}\left\{
A^{\dagger}BD\right\}  =\operatorname*{tr}\left\{  A^{\dagger}BQQ^{\dagger
}\right\}  ,
\end{equation}
where
\begin{equation}
D_{Q}=QQ^{\dagger}.
\end{equation}
Then
\begin{align}
\Pi_{f}\left(  \widehat{H}\right)  \Phi_{f}\left(  Q\right)   &  =\Phi
_{f}\left(  \left[  H,Q\right]  \right)  =E\Phi_{f}\left(  Q\right) \\
\Pi_{f}\left(  \widehat{u}\left(  t\right)  \right)  \Phi_{f}\left(  Q\right)
&  =\Phi_{f}\left(  u\left(  t\right)  Qu\left(  t\right)  ^{\dagger}\right)
=e^{-iEt}\Phi_{f}\left(  Q\right)  .
\end{align}
From the eigenvalue equations and the orthogonality of $Q^{\dagger}$ and $Q$
one has
\begin{align}
