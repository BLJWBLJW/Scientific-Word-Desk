\widehat{H}\right)  \Phi_{f}\left(  Q\right)  \right.  \right\rangle _{Q}  &
=\operatorname*{tr}\left\{  Q^{\dagger}\left[  H,Q\right]  QQ^{\dagger
}\right\}  =E\operatorname*{tr}\left\{  Q^{\dagger}QQQ^{\dagger}\right\} \\
\left\langle \Phi_{f}\left(  Q^{\dagger}\right)  \left\vert \Pi_{f}\left(
\widehat{H}\right)  \Phi_{f}\left(  Q^{\dagger}\right)  \right.  \right\rangle
_{Q}  &  =\operatorname*{tr}\left\{  Q\left[  H,Q^{\dagger}\right]
QQ^{\dagger}\right\}  =-E\operatorname*{tr}\left\{  QQ^{\dagger}QQ^{\dagger
}\right\}
\end{align}%
\begin{align}
\left\langle \Phi_{f}\left(  Q\right)  \left\vert \Pi_{f}\left(
\widehat{H}\right)  \Phi_{f}\left(  Q\right)  \right.  \right\rangle
_{Q^{\dagger}}  &  =\operatorname*{tr}\left\{  Q^{\dagger}\left[  H,Q\right]
Q^{\dagger}Q\right\}  =E\operatorname*{tr}\left\{  Q^{\dagger}QQ^{\dagger
}Q\right\} \\
\left\langle \Phi_{f}\left(  Q^{\dagger}\right)  \left\vert \Pi_{f}\left(
\widehat{H}\right)  \Phi_{f}\left(  Q^{\dagger}\right)  \right.  \right\rangle
