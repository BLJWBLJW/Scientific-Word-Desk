L_{\infty}\left(  \mathbb{R},\lambda\right)  =L_{1}\left(  \mathbb{R}%
,\lambda\right)  ^{\ast}%
\end{equation}%
\begin{equation}
L_{\infty}\left(  \mathbb{R},\lambda\right)  ^{\ast}=L_{1}\left(
\mathbb{R},\lambda\right)  ^{\ast\ast}=M\left(  \mathbb{R},\lambda\right)
\supset L_{1}\left(  \mathbb{R},\lambda\right)  ,
\end{equation}
where $M\left(  \mathbb{R},\lambda\right)  $ is the space of measures on
