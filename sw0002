=-E\operatorname*{tr}\left\{  Q^{\dagger}Q^{\dagger}Q^{\dagger}Q\right\}  =0\\
&  \Rightarrow\operatorname*{tr}\left\{  HQ^{\dagger}Q^{\dagger}QQ^{\dagger
}\right\}  =\operatorname*{tr}\left\{  HQ^{\dagger}QQ^{\dagger}Q^{\dagger
}\right\}  .
\end{align}


