\subsection{Symmetries and the GNS\ Construction}

\subsubsection{Unitary Symmetries}

Unitary symmetries are implemented in $\mathcal{A}$ by inner $\ast
$-automorphisms \emph{that are unitary} wrt the $\operatorname*{tr}$ inner
product in $\mathcal{A}_{HS}$ i.e.
\begin{align}
\widehat{u}\left(  A\right)   &  =uAu^{\dagger}\\
\left\langle \left.  \widehat{u}\left(  A\right)  \right\vert \widehat{u}%
\left(  B\right)  \right\rangle _{\mathcal{A}}  &  =\operatorname*{tr}\left\{
uA^{\dagger}u^{\dagger}uBu^{\dagger}\right\}  =\operatorname*{tr}\left\{
uA^{\dagger}Bu^{\dagger}\right\}  =\operatorname*{tr}\left\{  A^{\dagger
}Bu^{\dagger}u\right\}  =\operatorname*{tr}\left\{  A^{\dagger}B\right\}
=\left\langle \left.  A\right\vert B\right\rangle _{\mathcal{A}},
\end{align}
where
\begin{equation}
uu^{\dagger}=u^{\dagger}u=I_{\mathcal{F}};u\in\mathcal{F}.
\end{equation}
$\lceil$One could also consider non unitary symmetries therefore not $\ast
$-automorphisms
\begin{equation}
\widehat{g}\left(  A\right)  =gAg^{-1}=A.
\end{equation}
$\rfloor$

If $A$ is invariant to $\widehat{u}$ i.e.
\begin{equation}
\widehat{u}\left(  A\right)  =A
\end{equation}
then $A$ has the symmetry implemented by $\widehat{u}.$ The adjoint
$\widehat{u}^{\dagger}$ of $\widehat{u}$ is given by
\begin{equation}
\left\langle \left.  \widehat{u}^{\dagger}\left(  A\right)  \right\vert
B\right\rangle _{\mathcal{A}}=\left\langle \left.  A\right\vert \widehat{u}%
\left(  B\right)  \right\rangle _{\mathcal{A}}\forall B
\end{equation}
i.e.
\begin{equation}
\operatorname*{tr}\left\{  \widehat{u}^{\dagger}\left(  A\right)  B\right\}
=\operatorname*{tr}\left\{  AuBu^{\dagger}\right\}  =\operatorname*{tr}%
\left\{  u^{\dagger}AuB\right\}
\end{equation}
so that
\begin{equation}
\widehat{u}^{\dagger}\left(  A\right)  =u^{\dagger}Au.
\end{equation}
As
\begin{equation}
\widehat{u}^{-1}=\widehat{u}^{\dagger}%
\end{equation}
$\lceil$%
\begin{equation}
\widehat{u}^{\dagger}\left(  uAu^{\dagger}\right)  =u^{\dagger}uAu^{\dagger
}u=A
\end{equation}
$\rfloor$

then
\begin{equation}
\widehat{u}^{\dagger}\left(  \widehat{u}\left(  A\right)  \right)
=\widehat{u}\left(  \widehat{u}^{\dagger}\left(  A\right)  \right)  =A
\end{equation}
so if
\begin{equation}
\widehat{u}\left(  A\right)  =A
\end{equation}
then
\begin{equation}
\widehat{u}^{\dagger}\left(  \widehat{u}\left(  A\right)  \right)
=\widehat{u}^{\dagger}\left(  A\right)  =A,
\end{equation}
so if $\widehat{u}$ is a symmetry so is $\widehat{u}^{\dagger}.$

As $\widehat{u}$ is a unitary transformation it is generated by a self adjoint
operator $\widehat{h}$ i.e.
\begin{align}
\widehat{u}  &  =\exp\left\{  i\operatorname{adj}\left(  h\right)  \right\} \\
\operatorname{adj}\left(  h\right)  \left(  \cdot\right)   &  =\widehat{h}%
\left(  \cdot\right)  =\left[  h,\cdot\right] \\
\widehat{h}  &  =\widehat{h}^{\dagger};h=h^{\dagger},
\end{align}
note that $h$ can belong to $\mathcal{F}_{\left(  n\right)  }$ for any
$n\in\left\{  0,\cdots,2r\right\}  .$ The adjoint $\widehat{h}^{\dagger}$of
$\widehat{h}$ is given by
\begin{equation}
\left\langle \left.  \widehat{h}^{\dagger}\left(  A\right)  \right\vert
B\right\rangle _{\mathcal{A}}=\left\langle \left.  \overset{}{A}\right\vert
\widehat{h}\left(  B\right)  \right\rangle _{\mathcal{A}}%
\end{equation}
i.e.
\begin{equation}
\operatorname*{tr}\left\{  \left(  \widehat{h}^{\dagger}\left(  A\right)
\right)  ^{\dagger}B\right\}  =\operatorname*{tr}\left\{  A^{\dagger
}\widehat{h}\left(  B\right)  \right\}  =\operatorname*{tr}\left\{
A^{\dagger}\left[  h,B\right]  \right\}  =\operatorname*{tr}\left\{
A^{\dagger}hB-A^{\dagger}Bh\right\}  =\operatorname*{tr}\left\{  A^{\dagger
}hB-hA^{\dagger}B\right\}  =\operatorname*{tr}\left\{  \left[  A^{\dagger
},h\right]  B\right\}  ,
\end{equation}
so that the self adjoint condition
\begin{align}
&  \left(  \widehat{h}^{\dagger}\left(  A\right)  \right)  ^{\dagger}=\left[
A^{\dagger},h\right] \\
&  \Rightarrow\widehat{h}^{\dagger}\left(  A\right)  =\left(  \left[
A^{\dagger},h\right]  \right)  ^{\dagger}=h^{\dagger}A-Ah^{\dagger}=\left[
h,A\right]  =\widehat{h}\left(  A\right)  .
\end{align}
One should note that as
\begin{align}
\widehat{u}\left(  A\right)   &  =uAu^{\dagger}\\
\widehat{u}^{\dagger}\left(  A\right)   &  =u^{\dagger}Au\\
\left(  \widehat{u}\left(  A\right)  \right)  ^{\dagger}  &  =uA^{\dagger
}u^{\dagger}=\widehat{u}\left(  A^{\dagger}\right) \\
\left(  \widehat{u}\left(  A^{\dagger}\right)  \right)  ^{\dagger}  &
=uAu^{\dagger}=\widehat{u}\left(  A\right)
\end{align}
one has
\begin{equation}
\widehat{u}\left(  A\right)  ^{\dagger}=uA^{\dagger}u^{\dagger}=\widehat{u}%
\left(  A^{\dagger}\right)  \neq\widehat{u}^{\dagger}\left(  A\right)  \text{
in general}%
\end{equation}
but
\begin{equation}
\widehat{h}\left(  A\right)  ^{\dagger}=-\widehat{h}\left(  A^{\dagger
}\right)  .
\end{equation}


\subsubsection{Projective Symmetries}

$A$ is \emph{projectively invariant} to $\widehat{u}$ if
\begin{equation}
\widehat{u}\left(  A\right)  =\exp\left\{  i\operatorname{adj}\left(
h\right)  \lambda\right\}  \left(  A\right)  =e^{i\lambda}A;\lambda
\in\mathbb{R}.
\end{equation}
If $A$ is projectively invariant to $\widehat{u}$ then
\begin{align}
\widehat{u}\left(  A\right)  \left(  \widehat{u}\left(  A\right)  \right)
^{\dagger}  &  =AA^{\dagger}\\
\left(  \widehat{u}\left(  A\right)  \right)  ^{\dagger}\widehat{u}\left(
A\right)   &  =A^{\dagger}A
\end{align}
and $AA^{\dagger}$ and $A^{\dagger}A$ are invariant to $\widehat{u}$ i.e.
\begin{align}
\widehat{u}\left(  AA^{\dagger}\right)   &  =uAu^{\dagger}uA^{\dagger
}u^{\dagger}=\widehat{u}\left(  A\right)  \widehat{u}\left(  A^{\dagger
}\right)  =e^{i\lambda}Ae^{-i\lambda}A^{\dagger}=AA^{\dagger}\\
\widehat{u}\left(  A^{\dagger}A\right)   &  =uA^{\dagger}u^{\dagger
}uAu^{\dagger}=\widehat{u}\left(  A^{\dagger}\right)  \widehat{u}\left(
A\right)  =e^{-i\lambda}A^{\dagger}e^{i\lambda}A=A^{\dagger}A.
\end{align}
If
\begin{equation}
Au=uA,\quad\text{i.e. }\left[  A,u\right]  =0
\end{equation}
then
\begin{equation}
\widehat{u}\left(  A\right)  =uAu^{\dagger}=A
\end{equation}
and
\begin{equation}
\widehat{h}\left(  A\right)  =0,
\end{equation}
which is a special case of
\begin{equation}
\widehat{h}\left(  A\right)  =\lambda A.
\end{equation}
Other special cases are given by
\begin{equation}
\widehat{h}\left(  A\right)  =2n\pi iA;0\leq n\leq\infty,
\end{equation}
which give
\begin{equation}
\widehat{u}\left(  A\right)  =uAu^{\dagger}=A.
\end{equation}


