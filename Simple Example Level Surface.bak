\section{Simple Example}

The basic constraints are
\begin{align}
\left(  A\left\vert O\left(  t\right)  ^{t}K_{j}O\left(  t\right)  A\right.
\right)    & =\left(  A\left\vert K_{j}A\right.  \right)  \label{inv}\\
\left(  O\left(  t\right)  ^{t}A\left\vert O\left(  t\right)  A\right.
\right)    & =\left(  A\left\vert A\right.  \right)  \label{normaliz}\\
K_{j}  & \geq0\label{positiv}%
\end{align}
leading to
\begin{align}
O\left(  t\right)  ^{t}O\left(  t\right)   &  =I\\
O\left(  t\right)   &  =\exp t\left\{  \sum_{k}\lambda_{k}\Lambda_{k}\right\}
\\
\Lambda_{k} &  =-\Lambda_{k}^{t};\,\lambda_{k}\in\mathbb{R}\\
O_{k}\left(  t\right)   &  =\exp\left\{  \Lambda_{k}t\right\}  .
\end{align}%
\begin{align}
\operatorname{Tr}\left\{  O\left(  t\right)  ^{t}K_{j}O\left(  t\right)
\left\vert A\right)  \left(  A\right\vert \right\}    & =\operatorname{Tr}%
\left\{  K_{j}O\left(  t\right)  \left\vert A\right)  \left(  A\right\vert
O\left(  t\right)  ^{t}\right\}  \\
& =\operatorname{Tr}\left\{  O\left(  t\right)  ^{t}\left\vert A\right)
\left(  A\right\vert K_{j}^{t}O\left(  t\right)  \right\}  =\operatorname{Tr}%
\left\{  K_{j}\left\vert A\right)  \left(  A\right\vert \right\}
\end{align}
The $K$ invariance gives
\begin{equation}
\left(  A\left\vert O_{k}\left(  t\right)  ^{t}K_{j}O_{k}\left(  t\right)
A\right.  \right)  =\left(  A\left\vert \exp\left\{  -\Lambda_{k}t\right\}
K_{j}\exp\left\{  \Lambda_{k}t\right\}  A\right.  \right)
\end{equation}%
\begin{equation}
=\left(  A\left\vert K_{j}A\right.  \right)  +\left(  A\left\vert \left[
K_{j},\Lambda_{k}\right]  A\right.  \right)  t+\frac{1}{2}\left(  A\left\vert
\left[  \left[  K_{j},\Lambda_{k}\right]  ,\Lambda_{k}\right]  A\right.
\right)  t^{2}+\cdots.
\end{equation}
$\lceil$%
\begin{align}
\left(  A\left\vert \left[  K_{j},\Lambda_{k}\right]  A\right.  \right)    &
=\left(  A\left\vert K_{j}\Lambda_{k}A\right.  \right)  -\left(  A\left\vert
\Lambda_{k}K_{j}A\right.  \right)  \\
& =\left(  K_{j}^{t}A\left\vert \Lambda_{k}A\right.  \right)  -\left(
\Lambda_{k}^{t}A\left\vert K_{j}A\right.  \right)  \\
& =\left(  \Lambda_{k}A\left\vert K_{j}^{t}A\right.  \right)  -\left(
\Lambda_{k}^{t}A\left\vert K_{j}A\right.  \right)  \rfloor
\end{align}
The tangent vectors are%
\begin{equation}
\Lambda_{k}\left\vert A\right)  .
\end{equation}
Any of the following satisfy the constraints

\begin{itemize}
\item
\begin{equation}
\exp\left\{  \Lambda_{k}t\right\}  \left\vert A\right)  =\left\vert A\right)
\end{equation}%
\begin{equation}
\Leftrightarrow\Lambda_{k}\left\vert A\right)  =0
\end{equation}
However this condition leads to a null tangent space and does not depend on
$\left\{  K_{j}\right\}  .$

\item
\begin{equation}
\left[  K_{j},\Lambda_{k}\right]  =\sum_{l}\lambda_{jkl}\Lambda_{l}%
\end{equation}
$\lceil$i.e. $\left\{  \Lambda_{l}\right\}  $ generates an invariant subspace
for $\operatorname{adj}\left(  K_{j}\right)  $ (producing the adjoint rep) and
thus $\left\{  \Lambda_{l}\right\}  $ carries a spinor representation of the
orthogonal group $\mathcal{O}\left(  \mathbb{R}^{\nu}\right)  $ on the algebra
generated by $\left\{  \Lambda_{l}\right\}  $
\begin{equation}
O_{k}{}^{t}K_{j}O_{k}\in\operatorname{alg}\left\{  \Lambda_{l}\right\}
\rfloor
\end{equation}
\textbf{and}%
\begin{equation}
\left[  \Lambda_{l},\Lambda_{k}\right]  =0,
\end{equation}
i.e. $\operatorname{alg}\left\{  \Lambda_{l}\right\}  $ is commutative.

\item
\begin{equation}
\left[  K_{j},\Lambda_{k}\right]  =\sum_{l}\eta_{jkl}K_{l}%
\end{equation}
$\lceil$i.e. $\left\{  K_{l}\right\}  $ generates an invariant subspace for
$\operatorname{adj}\left(  \Lambda_{j}\right)  $ (producing the adjoint rep)
and thus $\left\{  K_{l}\right\}  $ carries a adjoint representation of the
orthogonal group $\mathcal{O}\left(  \mathbb{R}^{\nu}\right)  $ on the algebra
generated by $\left\{  \Lambda_{l}\right\}  $
\begin{equation}
O_{k}{}^{t}K_{j}O_{k}\in\operatorname{alg}\left\{  K_{l}\right\}  \rfloor
\end{equation}
and
\begin{equation}
\left(  A\left\vert K_{l}A\right.  \right)  =0.
\end{equation}


\item
\begin{equation}
\left[  K_{j},\Lambda_{k}\right]  =\sum_{l}\lambda_{l}\Lambda_{l}%
\end{equation}
$\left\{  \Lambda_{l}\right\}  $ form a Lie algebra i.e
\begin{equation}
\left[  \Lambda_{j},\Lambda_{k}\right]  =\sum_{l}\lambda_{jkl}\Lambda_{l}%
\end{equation}
and
\begin{equation}
\left(  A\left\vert \Lambda_{l}A\right.  \right)  =0
\end{equation}


\item
\begin{align}
& \left[  K_{j},\Lambda_{k}\right]  =0\\
& \qquad\left.  \Updownarrow\right.  \\
& O_{k}\left(  t\right)  ^{t}K_{j}O_{k}\left(  t\right)  =K_{j}%
\end{align}

\end{itemize}




