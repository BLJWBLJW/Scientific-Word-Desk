+x_{3}x_{6}x_{1}x_{8}+x_{3}x_{6}x_{7}x_{2}+x_{5}x_{4}x_{1}x_{8}+x_{5}%
x_{4}x_{7}x_{2}+x_{5}x_{6}x_{7}x_{8}-x_{5}x_{6}x_{1}x_{2}}\right. \\
+  &  \left.  i\left(  \overset{}{x_{3}x_{4}x_{1}x_{8}+x_{3}x_{4}x_{7}%
x_{2}-x_{3}x_{6}x_{1}x_{2}+x_{1}x_{6}x_{7}x_{8}-x_{5}x_{4}x_{1}x_{2}%
+x_{5}x_{4}x_{7}x_{8}-x_{5}x_{6}x_{1}x_{8}-x_{5}x_{6}x_{7}x_{2}}\right)
\right)
\end{align}

\end{enumerate}
\end{example}

