\section{Majorana Expansion of a Two-Particle Operator}

\subsection*{Majorana Operator Basis}

\begin{enumerate}
\item The Majorana operators $\left\{  \left.  x_{j}\right\vert 1\leq j\leq
r\right\}  $ are Hermitian and satisfy the Clifford algebra commutation
relationships:
\[
\{x_{j},x_{k}\}=2\delta_{jk}I_{\mathcal{H}_{\mathcal{F}}},\quad1\leq
j,k\leq2r
\]
hence the Majorana operators are normalized i.e.
\begin{equation}
x_{j}^{2}=I_{\mathcal{H}_{\mathcal{F}}},\quad1\leq j\leq2r
\end{equation}
and
\begin{equation}
x_{j}x_{k}=-x_{k}x_{j},\quad1\leq j,k\leq2r
\end{equation}
For a system with $r$ fermionic modes, $2r$ Majorana operators are defined in
terms of creation $\left\{  a_{j}^{\dagger},1\leq j\leq r\right\}  $ and
annihilation $\left\{  a_{j},1\leq j\leq r\right\}  $ operators:
\[
x_{j}=a_{j}+a_{j}^{\dagger},\quad x_{j+r}=-i(a_{j}-a_{j}^{\dagger}),\quad1\leq
j\leq r
\]
giving
\begin{equation}
\left(  \boldsymbol{x}\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}\\
\boldsymbol{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
i\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{a}^{\dagger}\\
\boldsymbol{a}%
\end{array}
\right)  .
\end{equation}


\item The inverse relations are:
\[
a_{j}=\frac{1}{2}(x_{j}+ix_{j+r}),\quad a_{j}^{\dagger}=\frac{1}{2}%
(x_{j}-ix_{j+r}),\quad1\leq j\leq r
\]
giving
\begin{equation}
\left(  \boldsymbol{a}^{\dagger},\boldsymbol{a}\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{c}%
\boldsymbol{a}^{\dagger}\\
\boldsymbol{a}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & -i\mathbb{I}_{r}\\
\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}\\
\boldsymbol{x}_{2}%
\end{array}
\right)  .
\end{equation}


\begin{lemma}
The CAR is realized by the field operators that are defined in terms of the
preceding Majorana operators
\begin{equation}
\{a_{j}^{\dagger},a_{k}\}=\delta_{jk}I_{\mathcal{H}_{\mathcal{F}}},\quad1\leq
j,k\leq r.
\end{equation}


\begin{proof}%
\begin{align*}
\{a_{j}^{\dagger},a_{k}\}  &  =\{\frac{1}{2}(x_{j}+ix_{j+r}),\frac{1}{2}%
(x_{k}-ix_{k+r})\}=\frac{1}{4}\left(  \overset{}{(x_{j}+ix_{j+r}%
)(x_{k}-ix_{k+r})+(x_{k}-ix_{k+r})(x_{j}+ix_{j+r})}\right) \\
&  =\frac{1}{4}\left(  \overset{}{(x_{j})(x_{k}-ix_{k+r})+(ix_{j+r}%
)(x_{k}-ix_{k+r})+(x_{k})(x_{j}+ix_{j+r})}+(-ix_{k+r})(x_{j}+ix_{j+r})\right)
\\
&  =\frac{1}{4}\left(  \overset{}{x_{j}x_{k}-ix_{j}x_{k+r}+ix_{j+r}%
x_{k}+x_{j+r}x_{k+r}+x_{k}x_{j}+ix_{k}x_{j+r}}-ix_{k+r}x_{j}+x_{k+r}%
x_{j+r}\right) \\
&  =\frac{1}{4}\left(  \overset{}{x_{j}x_{k}+x_{k}x_{j}}+x_{j+r}%
x_{k+r}+x_{k+r}x_{j+r}\right) \\
&  =\frac{1}{4}\left(  2\delta_{jk}I_{\mathcal{H}_{\mathcal{F}}}+2\delta
_{jk}I_{\mathcal{H}_{\mathcal{F}}}\right)  =\delta_{jk}I_{\mathcal{H}%
_{\mathcal{F}}},\quad1\leq j,k\leq r.\blacksquare
\end{align*}

\end{proof}
\end{lemma}

\item In particular creation and annhilation operators in terms of Majorana
operators
\begin{align}
\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{0}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}\\
-i\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right) \\
\left(
\begin{array}
[c]{c}%
\boldsymbol{a}\\
\boldsymbol{0}%
\end{array}
\right)   &  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{O} & \mathbb{O}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}\\
\boldsymbol{x}_{2}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}+i\boldsymbol{x}_{2}\\
\boldsymbol{0}%
\end{array}
\right)  .
\end{align}


\item This gives one particle conserving operators in super vector form as
\begin{align}
\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{a}\\
\boldsymbol{0}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}+i\boldsymbol{x}_{2}\\
\boldsymbol{0}%
\end{array}
\right)  =\frac{1}{4}\left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)
\left(  \boldsymbol{x}_{1}+i\boldsymbol{x}_{2}\right) \\
&  =\frac{1}{4}\left(  \boldsymbol{x}_{1}\boldsymbol{x}_{1}+i\boldsymbol{x}%
_{1}\boldsymbol{x}_{2}-i\boldsymbol{x}_{2}\boldsymbol{x}_{1}+\boldsymbol{x}%
_{2}\boldsymbol{x}_{2}\right)  =\frac{1}{4}\left(  \boldsymbol{x}%
_{1}\boldsymbol{x}_{1}+\boldsymbol{x}_{2}\boldsymbol{x}_{2}+i\left(
\boldsymbol{x}_{1}\boldsymbol{x}_{2}-\boldsymbol{x}_{2}\boldsymbol{x}%
_{1}\right)  \right)
\end{align}
giving the following expression for individual operators
\begin{equation}
a_{j}^{\dagger}a_{k}=\frac{1}{4}\left(  x_{j}\boldsymbol{x}_{k}+ix_{j}%
x_{k+r}-ix_{j+r}x_{k}+x_{j+r}x_{k+r}\right)  =\frac{1}{4}\left(
\overset{}{x_{j}x_{k}+x_{j+r}x_{k+r}+i\left(  x_{j}x_{k+r}-x_{j+r}%
x_{k}\right)  }\right)  ,\quad1\leq j,k\leq r.
\end{equation}


\item This gives two particle conserving operators in super vector form as%
\begin{align}
&  \left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}^{\dagger}\boldsymbol{aa}%
\right)  =\left(  \boldsymbol{a}^{\dagger}\right)  \left(  \boldsymbol{a}%
^{\dagger}\right)  \left(  \boldsymbol{a}\right)  \left(  \boldsymbol{a}%
\right)  =\left(  \left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger} & \cdots & a_{r}^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger} & \cdots & a_{r}^{\dagger}%
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \right) \\
&  =\frac{1}{16}\left(  \left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{3}+i\boldsymbol{x}_{4}\\
\boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{3}+i\boldsymbol{x}_{4}\\
\boldsymbol{0}%
\end{array}
\right)  \right) \\
&  =\frac{1}{16}\left(  \left(
\begin{array}
[c]{cccc}%
\left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)  \left(  \boldsymbol{x}%
_{1}-i\boldsymbol{x}_{2}\right)  & \boldsymbol{0} & \boldsymbol{0} &
\boldsymbol{0}%
\end{array}
\right)  \right)  \left(
\begin{array}
[c]{c}%
\left(  \boldsymbol{x}_{3}+i\boldsymbol{x}_{4}\right)  \left(  \boldsymbol{x}%
_{3}+i\boldsymbol{x}_{4}\right) \\
\boldsymbol{0}\\
\boldsymbol{0}\\
\boldsymbol{0}%
\end{array}
\right) \\
&  =\frac{1}{16}\left(  \left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)
\left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)  \left(  \boldsymbol{x}%
_{3}+i\boldsymbol{x}_{4}\right)  \left(  \boldsymbol{x}_{3}+i\boldsymbol{x}%
_{4}\right)  \right)
\end{align}
giving the following expression for individual operators
\begin{align*}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}  &  =\frac{1}{16}(x_{j}%
-ix_{j+r})(x_{k}-ix_{k+r})(x_{l}+ix_{l+r})(x_{m}+ix_{m+r}),\\
\quad1  &  \leq j<k\leq r,1\leq l<m\leq r
\end{align*}
that number
\begin{equation}
\binom{r}{2}^{2}=\frac{r^{2}}{4}\left(  r-1\right)  ^{2}.
\end{equation}
The full expansion of the fermionic operator $a_{j}^{\dagger}a_{k}^{\dagger
}a_{l}a_{m}$ into Majorana operators is
\end{enumerate}

%

\begin{align}
&  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=\frac{1}{16}\left\{  \left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m}-\\
x_{k}x_{m}x_{j+r}x_{l+r}-x_{j}x_{k}x_{l+r}x_{m+r}-x_{l}x_{m}x_{j+r}%
x_{k+r}-x_{j}x_{l}x_{k+r}x_{m+r}+x_{j}x_{m}x_{k+r}x_{l+r}+x_{k}x_{l}%
x_{j+r}x_{m+r}+\\
x_{j+r}x_{k+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\left.
i\left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m+r}-x_{j}x_{k}x_{m}x_{l+r}-x_{j}x_{l}x_{m}x_{k+r}%
+x_{k}x_{l}x_{m}x_{j+r}-\\
x_{l}x_{j+r}x_{k+r}x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}+x_{j}x_{k+r}%
x_{l+r}x_{m+r}-x_{k}x_{j+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right\}
\end{align}


where $\left\{  \left.  x_{j}\right\vert 1\leq j\leq2r\right\}  $ are Majorana
operators satisfying $\{x_{j},x_{k}\}=2\delta_{jk}$, with the fermionic
mapping
\begin{align*}
a_{j}  &  =\tfrac{1}{2}(x_{j}+ix_{j+r})\\
a_{j}^{\dagger}  &  =\tfrac{1}{2}(x_{j}-ix_{j+r})
\end{align*}


In particular these operators can be classified into

\begin{enumerate}
\item Operators that can be described by two unequal subscripts $k\neq j$
\begin{gather*}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}=n_{j}n_{k}=\frac{1}{2}\left(
I_{\mathcal{H}_{\mathcal{F}}}+ix_{j}x_{j+r}\right)  \frac{1}{2}\left(
I_{\mathcal{H}_{\mathcal{F}}}+ix_{k}x_{k+r}\right) \\
\parallel\\
\frac{1}{4}\left\{  \overset{}{I_{\mathcal{H}_{\mathcal{F}}}+i\left(
x_{j}x_{j+r}+x_{k}x_{k+r}\right)  -x_{j}x_{j+r}x_{k}x_{k+r}}\right\} \\
\parallel\\
\frac{1}{4}\left\{  \overset{}{I_{\mathcal{H}_{\mathcal{F}}}+i\left(
x_{j}x_{j+r}+x_{k}x_{k+r}\right)  +x_{j}x_{k}x_{j+r}x_{k+r}}\right\}  ,
\end{gather*}
that number
\begin{equation}
\binom{r}{2}=\frac{r}{2}\left(  r-1\right)  =\frac{r\left(  r-1\right)
}{\left(  1\right)  \left(  2\right)  }.
\end{equation}
In the case $r=3$ there are $3$ subscripts
\begin{equation}
\binom{3}{2}=\frac{3}{2}\left(  3-1\right)  =3,
\end{equation}
which are
\begin{equation}
1212,1313,2323.
\end{equation}
In the case $r=4$ there are $6$ subscripts
\begin{equation}
\binom{4}{2}=\frac{4}{2}\left(  4-1\right)  =2\left(  3\right)  =6,
\end{equation}
which are
\begin{equation}
1212,1313,1414,2323,2424,3434.
\end{equation}


\item Operators that can be described by three unequal subscripts $j\neq l\neq
k$%
\begin{gather}
a_{j}^{\dagger}a_{l}a_{k}^{\dagger}a_{k}=a_{j}^{\dagger}a_{l}n_{k}=n_{k}%
a_{j}^{\dagger}a_{l}\\
\parallel\\
\frac{1}{8}\left\{  \overset{}{x_{j}x_{l}+ix_{j+r}x_{l+r}-ix_{j+r}%
x_{l}+x_{j+r}x_{l+r}}+\overset{}{ix_{j}x_{l}x_{k}x_{k+r}-x_{j}x_{l+r}%
x_{k}x_{k+r}+x_{j+r}x_{l}x_{k}x_{kz+r}+ix_{j+r}x_{l+r}x_{k}x_{k+r}}\right\} \\
\parallel\\
\frac{1}{8}\left\{  x_{j}x_{l}+x_{j+r}x_{l+r}+x_{j}x_{k}x_{l+r}x_{k+r}%
+x_{l}x_{k}x_{j+r}x_{k+r}+i\left(  \overset{}{x_{j+r}x_{l+r}+x_{l}%
x_{j+r}+x_{j}x_{l}x_{k}x_{k+r}+x_{k}x_{j+r}x_{l+r}x_{k+r}}\right)  \right\}  ,
\end{gather}
that number%
\begin{equation}
\#=2\binom{r}{2}\binom{r-2}{1}=2\frac{1}{2}r\left(  r-1\right)  \left(
r-2\right)  =r\left(  r-1\right)  \left(  r-2\right)  .
\end{equation}
In the case $r=3$ there are $6$ subscripts
\begin{equation}
2\frac{1}{2}3\left(  3-1\right)  \left(  3-2\right)  =\left(  3\right)
\left(  2\right)  \left(  1\right)  =6,
\end{equation}
which are
\begin{equation}
1233,1322,2133,2311,3122,3211.
\end{equation}
In the case $r=4$ there are $24$ subscripts
\begin{equation}
2\frac{1}{2}4\left(  4-1\right)  \left(  4-2\right)  =4\left(  3\right)
\left(  2\right)  =24,
\end{equation}
which are
\begin{equation}
2311,2411,3411,3211,4211,4311
\end{equation}%
\begin{equation}
1322,1422,3422,3122,4122,4322
\end{equation}%
\begin{equation}
1233,1433,2433,2133,4133,4233
\end{equation}%
\begin{equation}
1244,1344,2344,2144,3144,3244.
\end{equation}


\item Operators that can be described by four unequal subscripts%
\begin{gather}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=a_{j}^{\dagger}a_{m}a_{k}^{\dagger
}a_{l}\\
\parallel
\end{gather}%
\begin{align}
&  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=\frac{1}{16}\left\{  \left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m}-\\
x_{k}x_{m}x_{j+r}x_{l+r}-x_{j}x_{k}x_{l+r}x_{m+r}-x_{l}x_{m}x_{j+r}%
x_{k+r}-x_{j}x_{l}x_{k+r}x_{m+r}+x_{j}x_{m}x_{k+r}x_{l+r}+x_{k}x_{l}%
x_{j+r}x_{m+r}+\\
x_{j+r}x_{k+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\left.
i\left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m+r}-x_{j}x_{k}x_{m}x_{l+r}-x_{j}x_{l}x_{m}x_{k+r}%
+x_{k}x_{l}x_{m}x_{j+r}-\\
x_{l}x_{j+r}x_{k+r}x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}+x_{j}x_{k+r}%
x_{l+r}x_{m+r}-x_{k}x_{j+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right\}
\end{align}
that number
\begin{equation}
\#=\binom{r}{2}\binom{r-2}{2}=\frac{1}{2}r\left(  r-1\right)  \frac{1}%
{2}\left(  r-2\right)  \left(  r-3\right)  =\frac{1}{4}r\left(  r-1\right)
\left(  r-2\right)  \left(  r-3\right)  .
\end{equation}
In the case $r=3$ there are $0$ subscripts
\begin{equation}
\#=\frac{1}{4}3\left(  3-1\right)  \left(  3-2\right)  \left(  3-3\right)  =0.
\end{equation}
In the case $r=4$ there are $6$ subscripts
\begin{equation}
\#=\frac{1}{4}4\left(  4-1\right)  \left(  4-2\right)  \left(  4-3\right)
=\left(  3\right)  \left(  2\right)  \left(  1\right)  =6,
\end{equation}
which are
\[
1234,1324,1423,2314,2413,3412,
\]
this are permutation of $\left\{  1,2,3,4\right\}  $ belonging to $S_{4}$
produced by combinations belonging to $C_{2}^{4}$ i.e.
\begin{gather}
\mu\left(  \left\{  1,2,3,4\right\}  \right)  ,\quad\mu\in C_{4}^{r}\subset
S_{r},\,\mu\left(  j,k,l,m\right)  =\alpha\left(  \left\{  j,k\right\}
\right)  \beta\left(  \left\{  l,m\right\}  \right)  ,\quad\alpha\in C_{2}%
^{r}\subset S_{r},\quad\beta\in C_{2}^{r-2}\subset S_{r-2}\\
S_{2}\times S_{2r-2}\subset S_{2r}.
\end{gather}

\end{enumerate}

\begin{definition}
The complex vector space of two particle operators
\begin{equation}
\mathcal{A}_{a2}=\mathbb{C}\text{-}\operatorname{linspan}\left\{  \left.
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\right\vert 1\leq j<k\leq r,1\leq
m<l\leq r\right\}  .
\end{equation}

\end{definition}

\begin{definition}
Decomposition of the two particle operator subspace $\mathcal{A}_{a2}:$

\begin{enumerate}
\item Two out of four subscripts different

\begin{enumerate}
\item The subspace of operators $\mathcal{A}_{a2\left(  2\right)  }%
\subset\mathcal{A}_{a2}$
\begin{equation}
\mathcal{A}_{a2\left(  2\right)  }=\mathbb{C}\text{-}\operatorname{linspan}%
\left\{  \left.  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}\right\vert 1\leq
j<k\leq r\right\}  .
\end{equation}


\item The index set $\mathfrak{I}_{2}^{4}$
\begin{equation}
\mathfrak{I}_{2}^{4}=\left\{  \left.  \left(  j,k\right)  \right\vert 1\leq
j<k\leq r\right\}  .
\end{equation}

\end{enumerate}

\item Three subscripts out of four different

\begin{enumerate}
\item The subspace of operators $\mathcal{A}_{a2\left(  3\right)  }%
\subset\mathcal{A}_{a2}$%
\begin{equation}
\mathcal{A}_{a2\left(  3\right)  }=\mathbb{C}\text{-}\operatorname{linspan}%
\left\{  \left.  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\right\vert 1\leq
k\neq j\neq l\leq r\right\}
\end{equation}


\item The index set $\mathfrak{I}_{3}^{4}$%
\begin{equation}
\mathfrak{I}_{3}^{4}=\left\{  \left.  \left(  j,l,k\right)  \right\vert 1\leq
k\neq j\neq l\leq r\right\}
\end{equation}

\end{enumerate}

\item Four subscripts out of four different

\begin{enumerate}
\item The subspace of operators $\mathcal{A}_{a2\left(  3\right)  }%
\subset\mathcal{A}_{a2}$%
\begin{equation}
\mathcal{A}_{a2\left(  4\right)  }=\mathbb{C}\text{-}\operatorname{linspan}%
\left\{  \left.  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\right\vert 1\leq
j<k\leq r,1\leq l<m\leq r,\left(  j,k\right)  \neq\left(  l,m\right)
\right\}
\end{equation}


\item The index set $\mathfrak{I}_{4}^{4}$%
\begin{equation}
\mathfrak{I}_{4}^{4}=\left\{  \left.  \left(  j,k,l,m\right)  \right\vert
1\leq j<k\leq r,1\leq l<m\leq r,\left(  j,k\right)  \neq\left(  l,m\right)
\right\}
\end{equation}

\end{enumerate}
\end{enumerate}
\end{definition}

\begin{lemma}
The three subspaces $\left\{  \mathcal{A}_{a2\left(  2\right)  }%
,\mathcal{A}_{a2\left(  3\right)  },\mathcal{A}_{a2\left(  4\right)
}\right\}  $ are disjoint and
\begin{equation}
\mathcal{A}_{a2}=\mathcal{A}_{a2\left(  2\right)  }\oplus\mathcal{A}%
_{a2\left(  3\right)  }\oplus\mathcal{A}_{a2\left(  4\right)  }.
\end{equation}

\end{lemma}

\begin{lemma}
The vector spaces $\left\{  \mathcal{A}_{a2},\mathcal{A}_{a2\left(  2\right)
},\mathcal{A}_{a2\left(  3\right)  },\mathcal{A}_{a2\left(  4\right)
}\right\}  $ have the dimensions

\begin{enumerate}
\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2}\right\}  =\binom{r}{2}^{2}%
\end{equation}


\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2\left(  2\right)  }\right\}  =\binom{r}{2}%
\end{equation}


\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2\left(  3\right)  }\right\}  =2\binom{r-1}%
{2}\binom{r}{1}%
\end{equation}


\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2\left(  4\right)  }\right\}  =\binom{r}{2}%
\binom{r-2}{2}.
\end{equation}

\end{enumerate}
\end{lemma}

\begin{lemma}%
\begin{equation}
\binom{r}{2}^{2}=\binom{r}{2}+2\binom{r-1}{2}\binom{r}{1}+\binom{r}{2}%
\binom{r-2}{2}%
\end{equation}

\end{lemma}

\begin{proof}
\begin{enumerate}
\item
\begin{enumerate}
\item
\begin{equation}
\binom{r}{2}=\frac{r\left(  r-1\right)  }{2}=\frac{1}{2}r^{2}-\frac{1}%
{2}r=\frac{1}{4}\left(  2r^{2}-2r\right)
\end{equation}


\item In the case $r=4$%
\begin{equation}
\frac{4\left(  4-1\right)  }{2}=6.
\end{equation}


\item In general
\begin{equation}
\binom{r}{2}^{2}=\frac{r\left(  r-1\right)  }{2}\frac{r\left(  r-1\right)
}{2}=\frac{1}{4}r^{2}\left(  r^{2}-2r+1\right)  =\frac{1}{4}r^{4}-\frac{1}%
{2}r^{3}+\frac{1}{4}r^{2}=\frac{1}{4}\left(  r^{4}-2r^{3}+r^{2}\right)
\end{equation}


\item[b] In the case $r=4$%
\begin{equation}
\frac{1}{4}4^{4}-\frac{1}{2}4^{3}+\frac{1}{4}4^{2}=64-32+4=36
\end{equation}


\item In general%
\begin{equation}
\binom{r}{2}=\frac{r\left(  r-1\right)  }{2}=\frac{1}{2}r^{2}-\frac{1}%
{2}r=\frac{1}{4}\left(  2r^{2}-2r\right)
\end{equation}


\item In the case $r=4$%
\begin{equation}
\frac{4\left(  4-1\right)  }{2}=6
\end{equation}


\item In general%
\begin{equation}
2\binom{r-1}{2}\binom{r}{1}=r\left(  r-1\right)  \left(  r-2\right)  =r\left(
r^{2}-3r+2\right)  =r^{3}-3r^{2}+2r=\frac{1}{4}\left(  4r^{3}-12r^{2}%
+8r\right)
\end{equation}


\item In the case $r=4$%
\begin{gather}
4^{3}-\left(  3\right)  4^{2}+\left(  2\right)  4=64-48+8=24\\
2\binom{4-1}{2}\binom{4}{1}=2\binom{3}{2}\binom{4}{1}=4\left(  4-1\right)
\left(  4-2\right)  =4\left(  4^{2}-\left(  3\right)  4+2\right)
=4^{3}-3\left(  4^{2}\right)  +2\left(  4\right)  =64-48+8=24
\end{gather}


\item In general%
\begin{align}
\binom{r}{2}\binom{r-2}{2}  &  =\frac{1}{4}\left(  r^{2}-\frac{1}{2}r\right)
\left(  r-2\right)  \left(  r-3\right)  =\frac{1}{4}\left(  r^{2}-r\right)
\left(  r^{2}-5r+6\right) \\
&  =\frac{1}{4}\left(  r^{2}\left(  r^{2}-5r+6\right)  -r\left(
r^{2}-5r+6\right)  \right)  =\frac{1}{4}\left(  r^{4}-5r^{3}+6r^{2}%
-r^{3}+5r^{2}-6r\right) \\
&  =\frac{1}{4}\left(  r^{4}-6r^{3}+11r^{2}-6r\right)
\end{align}


\item In the case $r=4$%
\begin{equation}
\frac{1}{4}4\left(  4^{3}-6\left(  4^{2}\right)  +11\left(  4\right)
-6\right)  =64-96+44-6=108-102=6
\end{equation}

\end{enumerate}

\item The sum of these three terms are
\begin{align}
&  \frac{1}{4}\left(  2r^{2}-2r\right)  +\frac{1}{4}\left(  4r^{3}%
-12r^{2}+8r\right)  +\frac{1}{4}\left(  r^{4}-6r^{3}+11r^{2}-6r\right) \\
&  =\frac{1}{4}\left(  2r^{2}-2r+4r^{3}-12r^{2}+8r+r^{4}-6r^{3}+11r^{2}%
-6r\right) \\
&  =\frac{1}{4}\left(  r^{2}-2r^{3}+r^{4}\right)  ,
\end{align}
which equals $\binom{r}{2}^{2}$ i.e.%
\begin{equation}
\frac{1}{4}\left(  r^{4}-2r^{3}+r^{2}\right)  .\blacksquare
\end{equation}

\end{enumerate}
\end{proof}

\begin{remark}
In the case $r=4$ the full basis has cardenality given by
\end{remark}

%

\begin{equation}
\binom{r}{2}^{2}=\frac{r^{2}}{4}\left(  r-1\right)  ^{2}=\frac{16}{4}\left(
4-1\right)  ^{2}=\left(  4\right)  \left(  9\right)  =36.
\end{equation}
Each term $O_{jklm}a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}$ in the expansion
of two particle operators can be expressed in terms of Majorana operators as
\begin{gather}
O_{jklm}a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=\frac{1}{16}O_{jklm}%
(x_{j}-ix_{j+r})(x_{k}-ix_{k+r})(x_{l}+ix_{l+r})(x_{m}+ix_{m+r})\\
\parallel
\end{gather}%
\begin{align}
&  \frac{1}{16}O_{jklm}\left\{  \left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m}-\\
x_{k}x_{m}x_{j+r}x_{l+r}-x_{j}x_{k}x_{l+r}x_{m+r}-x_{l}x_{m}x_{j+r}%
x_{k+r}-x_{j}x_{l}x_{k+r}x_{m+r}+x_{j}x_{m}x_{k+r}x_{l+r}+x_{k}x_{l}%
x_{j+r}x_{m+r}+\\
x_{j+r}x_{k+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\left.
i\left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m+r}-x_{j}x_{k}x_{m}x_{l+r}-x_{j}x_{l}x_{m}x_{k+r}%
+x_{k}x_{l}x_{m}x_{j+r}-\\
x_{l}x_{j+r}x_{k+r}x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}+x_{j}x_{k+r}%
x_{l+r}x_{m+r}-x_{k}x_{j+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right\}  .
\end{align}


In detail the calculation of $\left(  x_{j}-ix_{j+r}\right)  (x_{k}%
-ix_{k+r})(x_{l}+ix_{l+r})(x_{m}+ix_{m+r})$ is given by

\begin{enumerate}
\item
\begin{gather}
(x_{j}-ix_{j+r})(x_{k}-ix_{k+r})(x_{l}+ix_{l+r})(x_{m}+ix_{m+r})\\
\parallel
\end{gather}


\begin{enumerate}
\item The first two factors produce%
\begin{equation}
(x_{j}-ix_{j+r})(x_{k}-ix_{k+r})=x_{j}x_{k}-ix_{j}x_{k+r}-ix_{j+r}%
x_{k}-x_{j+r}x_{k+r}=\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)
-i\left(  \overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)
\end{equation}
and

\item the second two produce
\begin{equation}
(x_{l}+ix_{l+r})(x_{m}+ix_{m+r})=x_{l}x_{m}+ix_{l}x_{m+r}+ix_{l+r}%
x_{m}-x_{l+r}x_{m+r}=\left(  \overset{}{x_{l}x_{m}-x_{l+r}x_{m+r}}\right)
+i\left(  \overset{}{x_{l}x_{m+r}+x_{l+r}x_{m}}\right)  .
\end{equation}
Hence the product of all four factors produce
\end{enumerate}

\item
\begin{gather}
(x_{j}-ix_{j+r})(x_{k}-ix_{k+r})(x_{l}+ix_{l+r})(x_{m}+ix_{m+r})\\
\parallel\\
\left(  x_{j}x_{k}-ix_{j}x_{k+r}-ix_{j+r}x_{k}-x_{j+r}x_{k+r}\right)  \left(
x_{l}x_{m}+ix_{l}x_{m+r}+ix_{l+r}x_{m}-x_{l+r}x_{m+r}\right) \\
\parallel\\
\left(  \overset{}{\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)
-i\left(  \overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  }\right)  \left(
\overset{}{\left(  \overset{}{x_{l}x_{m}-x_{l+r}x_{m+r}}\right)  +i\left(
\overset{}{x_{l}x_{m+r}+x_{l+r}x_{m}}\right)  }\right) \\
\parallel\\
\left(  \overset{}{\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)
\left(  \overset{}{x_{l}x_{m}-x_{l+r}x_{m+r}}\right)  +\left(
\overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  \left(  \overset{}{x_{l}%
x_{m+r}+x_{l+r}x_{m}}\right)  }\right)  +\\
i\left(  \overset{}{\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)
\left(  \overset{}{x_{l}x_{m+r}+x_{l+r}x_{m}}\right)  -\left(
\overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  \left(  \overset{}{x_{l}%
x_{m}-x_{l+r}x_{m+r}}\right)  }\right)
\end{gather}%
\begin{gather}
\parallel\\
\left(  \overset{}{\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)
\left(  \overset{}{x_{l}x_{m}-x_{l+r}x_{m+r}}\right)  +\left(
\overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  \left(  \overset{}{x_{l}%
x_{m+r}+x_{l+r}x_{m}}\right)  }\right) \\
i\left(  \overset{}{\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)
\left(  \overset{}{x_{l}x_{m+r}+x_{l+r}x_{m}}\right)  -\left(
\overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  \left(  \overset{}{x_{l}%
x_{m}-x_{l+r}x_{m+r}}\right)  }\right)
\end{gather}


\item Noting that
\begin{align}
\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)  \left(  \overset{}{x_{l}%
x_{m}-x_{l+r}x_{m+r}}\right)   &  =x_{j}x_{k}x_{l}x_{m}-x_{j}x_{k}%
x_{l+r}x_{m+r}-x_{j+r}x_{k+r}x_{l}x_{m}+x_{j+r}x_{k+r}x_{l+r}x_{m+r}\\
&  =x_{j}x_{k}x_{l}x_{m}-x_{j}x_{k}x_{l+r}x_{m+r}-x_{l}x_{m}x_{j+r}%
x_{k+r}+x_{j+r}x_{k+r}x_{l+r}x_{m+r}%
\end{align}
and
\begin{align}
\left(  \overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  \left(  \overset{}{x_{l}%
x_{m+r}+x_{l+r}x_{m}}\right)   &  =x_{j}x_{k+r}x_{l}x_{m+r}+x_{j}%
x_{k+r}x_{l+r}x_{m}+x_{j+r}x_{k}x_{l}x_{m+r}+x_{j+r}x_{k}x_{l+r}x_{m}\\
&  =-x_{j}x_{l}x_{k+r}x_{m+r}+x_{j}x_{m}x_{k+r}x_{l+r}+x_{k}x_{l}%
x_{j+r}x_{m+r}-x_{k}x_{m}x_{j+r}x_{l+r}%
\end{align}
one obtains that the real part is
\begin{gather}
x_{j}x_{k}x_{l}x_{m}\\
-x_{k}x_{m}x_{j+r}x_{l+r}-x_{j}x_{k}x_{l+r}x_{m+r}-x_{l}x_{m}x_{j+r}%
x_{k+r}-x_{j}x_{l}x_{k+r}x_{m+r}+x_{j}x_{m}x_{k+r}x_{l+r}+x_{k}x_{l}%
x_{j+r}x_{m+r}\\
+x_{j+r}x_{k+r}x_{l+r}x_{m+r}.
\end{gather}


\item Noting that
\begin{align}
\left(  \overset{}{x_{j}x_{k}-x_{j+r}x_{k+r}}\right)  \left(  \overset{}{x_{l}%
x_{m+r}+x_{l+r}x_{m}}\right)   &  =x_{j}x_{k}x_{l}x_{m+r}+x_{j}x_{k}%
x_{l+r}x_{m}-x_{j+r}x_{k+r}x_{l}x_{m+r}-x_{j+r}x_{k+r}x_{l+r}x_{m}\\
&  =x_{j}x_{k}x_{l}x_{m+r}-x_{j}x_{k}x_{m}x_{l+r}-x_{l}x_{j+r}x_{k+r}%
x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}%
\end{align}
and
\begin{align}
\left(  \overset{}{x_{j}x_{k+r}+x_{j+r}x_{k}}\right)  \left(  \overset{}{x_{l}%
x_{m}-x_{l+r}x_{m+r}}\right)   &  =x_{j}x_{k+r}x_{l}x_{m}-x_{j}x_{k+r}%
x_{l+r}x_{m+r}+x_{j+r}x_{k}x_{l}x_{m}-x_{j+r}x_{k}x_{l+r}x_{m+r}\\
&  =x_{j}x_{l}x_{m}x_{k+r}-x_{j}x_{k+r}x_{l+r}x_{m+r}-x_{k}x_{l}x_{m}%
x_{j+r}+x_{k}x_{j+r}x_{l+r}x_{m+r}%
\end{align}
one obtains that the imaginary part is
\begin{gather}
x_{j}x_{k}x_{l}x_{m+r}-x_{j}x_{k}x_{m}x_{l+r}-x_{j}x_{l}x_{m}x_{k+r}%
+x_{k}x_{l}x_{m}x_{j+r}\\
-x_{l}x_{j+r}x_{k+r}x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}+x_{j}x_{k+r}%
x_{l+r}x_{m+r}-x_{k}x_{j+r}x_{l+r}x_{m+r}.
\end{gather}


\item Thus
\begin{gather}
O_{jklm}a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=\frac{1}{16}O_{jklm}%
(x_{j}-ix_{j+r})(x_{k}-ix_{k+r})(x_{l}+ix_{l+r})(x_{m}+ix_{m+r})\\
\parallel
\end{gather}%
\begin{align}
&  \frac{1}{16}O_{jklm}\left\{  \left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m}-\\
x_{j}x_{k}x_{l+r}x_{m+r}-x_{j}x_{l}x_{k+r}x_{m+r}+x_{j}x_{m}x_{k+r}%
x_{l+r}+x_{k}x_{l}x_{j+r}x_{m+r}-x_{k}x_{m}x_{j+r}x_{l+r}-x_{l}x_{m}%
x_{j+r}x_{k+r}+\\
x_{j+r}x_{k+r}x_{l+r}x_{m+r}%
\end{array}
\right)  \right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\left.  i\left(
\begin{array}
[c]{c}%
x_{j}x_{k}x_{l}x_{m+r}-x_{j}x_{k}x_{m}x_{l+r}-x_{j}x_{l}x_{m}x_{k+r}%
+x_{k}x_{l}x_{m}x_{j+r}+\\
x_{j}x_{k+r}x_{l+r}x_{m+r}-x_{k}x_{j+r}x_{l+r}x_{m+r}-x_{l}x_{j+r}%
x_{k+r}x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}%
\end{array}
\right)  \right\}
\end{align}
The Majorana products

\item involved in the real part are
\begin{equation}
x_{j}x_{k}x_{l}x_{m},\quad\left\{  \overset{}{x_{j}x_{k}x_{l+r}x_{m+r},\quad
x_{j}x_{l}x_{k+r}x_{m+r},\quad x_{j}x_{m}x_{k+r}x_{l+r},\quad x_{k}%
x_{l}x_{j+r}x_{m+r},\quad x_{k}x_{m}x_{j+r}x_{l+r},\quad x_{l}x_{m}%
x_{j+r}x_{k+r}}\right\}  ,\quad x_{j+r}x_{k+r}x_{l+r}x_{m+r}%
\end{equation}%
\begin{equation}
x_{\sigma_{\nu}\left(  j\right)  }x_{\sigma_{\nu}\left(  k\right)  }%
x_{\sigma_{\nu}^{c}\left(  l\right)  }x_{\sigma_{\nu}^{c}\left(  m\right)
},\left\{  \quad x_{\sigma_{\nu}\left(  j\right)  }x_{\sigma_{\nu}\left(
k\right)  }x_{\sigma_{\nu}^{c}\left(  l\right)  +r}x_{\sigma_{\nu}^{c}\left(
m\right)  +r}\quad\right\}  ,\quad x_{\sigma_{\nu}\left(  j\right)
+r}x_{\sigma_{\nu}\left(  k\right)  +r}x_{\sigma_{\nu}^{c}\left(  l\right)
+r}x_{\sigma_{\nu}^{c}\left(  m\right)  +r}%
\end{equation}
and

\item involved in the imaginary part are%
\begin{equation}
x_{j}x_{k}x_{l}x_{m+r},\quad x_{j}x_{k}x_{m}x_{l+r},\quad x_{j}x_{l}%
x_{m}x_{k+r},\quad x_{k}x_{l}x_{m}x_{j+r},\quad x_{j}x_{k+r}x_{l+r}%
x_{m+r},\quad x_{k}x_{j+r}x_{l+r}x_{m+r},\quad x_{l}x_{j+r}x_{k+r}%
x_{m+r},\quad x_{m}x_{j+r}x_{k+r}x_{l+r}.
\end{equation}

\end{enumerate}

\begin{remark}
$\widehat{\sigma}_{\nu}$ is the function of selecting two ordered elements
from four ordered elements, $\widehat{\sigma}_{\nu}^{c}$ is the compliment of
$\widehat{\sigma}_{\nu}$ i.e. the selection o the compliment of the set
selected by $\widehat{\sigma}_{\nu}.$
\end{remark}

\begin{remark}
\newline Four different subscripts are generated by ordered permutations
$\mu_{\nu}=\widehat{\sigma}_{\nu}\times\widehat{\sigma}_{\nu}^{c},$
$\widehat{\sigma}_{\nu},\widehat{\sigma}_{\nu}^{c}\in C_{2}^{4},$ $\mu_{\nu
}\in\mathcal{C}_{\sigma}\subset S^{4},$%
\begin{gather}
\widehat{\sigma}_{\nu}:\left\{  j,k,l,m\right\}  \rightarrow\left\{  \left\{
j,k\right\}  ,\left\{  j,l\right\}  ,\left\{  j,m\right\}  ,\left\{
k,l\right\}  ,\left\{  k,m\right\}  ,\left\{  l,m\right\}  \right\} \\%
\begin{array}
[c]{c}%
\widehat{\sigma}_{1}\left(  \left\{  j,k,l,m\right\}  \right)  =\left\{
j,k\right\} \\
\widehat{\sigma}_{2}\left(  \left\{  j,k,l,m\right\}  \right)  =\left\{
j,l\right\} \\
\widehat{\sigma}_{3}\left(  \left\{  j,k,l,m\right\}  \right)  =\left\{
j,m\right\} \\
\widehat{\sigma}_{4}\left(  \left\{  j,k,l,m\right\}  \right)  =\left\{
k,l\right\} \\
\widehat{\sigma}_{5}\left(  \left\{  j,k,l,m\right\}  \right)  =\left\{
k,m\right\} \\
\widehat{\sigma}_{6}\left(  \left\{  j,k,l,m\right\}  \right)  =\left\{
l,m\right\}
\end{array}
\\
\mu_{\nu}:\left\{  j,k,l,m\right\}  \rightarrow\left\{  \mu_{\nu}\left(
j\right)  ,\mu_{\nu}\left(  k\right)  ,\mu_{\nu}\left(  l\right)  ,\mu_{\nu
}\left(  m\right)  \right\}
\end{gather}

\end{remark}

\begin{example}
\begin{enumerate}
\item
\begin{gather}
\widehat{\sigma}_{\nu}:\left\{  1,2,3,4\right\}  \rightarrow\left\{  \left\{
1,2\right\}  ,\left\{  1,3\right\}  ,\left\{  1,4\right\}  ,\left\{
2,3\right\}  ,\left\{  2,4\right\}  ,\left\{  3,4\right\}  \right\} \\%
\begin{array}
[c]{c}%
\widehat{\sigma}_{1}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{
1,2\right\} \\
\widehat{\sigma}_{2}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{
1,3\right\} \\
\widehat{\sigma}_{3}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{
1,4\right\} \\
\widehat{\sigma}_{4}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{
2,3\right\} \\
\widehat{\sigma}_{5}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{
2,4\right\} \\
\widehat{\sigma}_{6}\left(  \left\{  1,2,3,4\right\}  \right)  =\left\{
3,4\right\}
\end{array}
\end{gather}


\item
\begin{align}
&  O_{\mu_{\nu}\left(  \left\{  jklm\right\}  \right)  }\left(  \left(
\overset{}{%
\begin{array}
[c]{c}%
x_{\mu_{\nu}\left(  j\right)  }x_{\mu_{\nu}\left(  k\right)  }x_{\mu_{\nu
}\left(  l\right)  }x_{\mu_{\nu}\left(  m\right)  }+\\
\sum_{1\leq\iota\leq6}x_{\omega_{\iota}\left(  \mu_{\nu}\left(  j\right)
\right)  }x_{\omega_{\iota}\left(  \mu_{\nu}\left(  k\right)  \right)
}x_{\omega_{\iota}\left(  \mu_{\nu}\left(  l\right)  \right)  +r}%
x_{\omega_{\iota}\left(  \mu_{\nu}\left(  m\right)  \right)  +r}+\\
x_{\mu_{\nu}\left(  j\right)  +r}x_{\mu_{\nu}\left(  k\right)  +r}x_{\mu_{\nu
}\left(  l\right)  +r}x_{\mu_{\nu}\left(  m\right)  +r}%
\end{array}
}\right)  \right.  \\
&  +\left.  i\left(
\begin{array}
[c]{c}%
x_{\mu_{\nu}\left(  j\right)  }x_{\mu_{\nu}\left(  k\right)  }x_{\mu_{\nu
}\left(  l\right)  }x_{\mu_{\nu}\left(  m\right)  +r}+x_{\mu_{\nu}\left(
j\right)  }x_{\mu_{\nu}\left(  k\right)  }x_{\mu_{\nu}\left(  m\right)
}x_{\mu_{\nu}\left(  l\right)  +r}+x_{\mu_{\nu}\left(  j\right)  }x_{\mu_{\nu
}\left(  l\right)  }x_{\mu_{\nu}\left(  m\right)  }x_{\mu_{\nu}\left(
k\right)  +r}+x_{\mu_{\nu}\left(  k\right)  }x_{\mu_{\nu}\left(  l\right)
}x_{\mu_{\nu}\left(  m\right)  }x_{\mu_{\nu}\left(  j\right)  +r}\\
\overset{}{x_{\mu_{\nu}\left(  j\right)  }x_{\mu_{\nu}\left(  k\right)
+r}x_{\mu_{\nu}\left(  l\right)  +r}x_{\mu_{\nu}\left(  m\right)  +r}%
+x_{\mu_{\nu}\left(  k\right)  }x_{\mu_{\nu}\left(  j\right)  +r}x_{\mu_{\nu
}\left(  l\right)  +r}x_{\mu_{\nu}\left(  m\right)  +r}+x_{\mu_{\nu}\left(
l\right)  }x_{\mu_{\nu}\left(  j\right)  +r}x_{\mu_{\nu}\left(  k\right)
+r}x_{\mu_{\nu}\left(  m\right)  +r}+x_{\mu_{\nu}\left(  m\right)  }%
x_{\mu_{\nu}\left(  j\right)  +r}x_{\mu_{\nu}\left(  k\right)  +r}x_{\mu_{\nu
}\left(  l\right)  +r}}%
\end{array}
\right)  \right)  .
\end{align}

\end{enumerate}
\end{example}

