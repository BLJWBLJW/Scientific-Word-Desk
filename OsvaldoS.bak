\subsection{Linear Response Described by AGP Coherent States .}

We now use the manifold of AGP coherent states in which to approximate linear
response functions. Within the context of the classical equations of motion in
the associated phase space the linear response of the first order reduced
density matrix produced by the radiation field is then given as
\begin{align}
&  \delta^{1}\rho_{1}\left(  \mathbf{z}{_{0},\mathbf{\bar{z}}_{0}}\right)
_{ij}\left(  \xi\right)  =\left(
\begin{array}
[c]{cc}%
\frac{\partial\rho_{ji}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  }{\partial\mathbf{z}} & \frac{\partial\rho_{ji}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial
\mathbf{\bar{z}}}%
\end{array}
\right)  \times\nonumber\\
&  \left(  \zeta\left(
\begin{array}
[c]{cc}%
\mathbf{0} & -\mathbf{\bar{C}}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right) \\
\mathbf{C}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
& \mathbf{0}%
\end{array}
\right)  -\left(
\begin{array}
[c]{cc}%
D_{\mathbf{z\bar{z}}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  & D_{\mathbf{zz}}^{2}\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right) \\
D_{\mathbf{\bar{z}\bar{z}}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}%
}_{0},\mathbf{\varsigma}_{0}\right)  & D_{\mathbf{\bar{z}z}}^{2}%
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)
\end{array}
\right)  \right)  ^{-1}\nonumber\\
&  \quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad
\quad\quad\quad\quad\times\left(
\begin{array}
[c]{cc}%
\frac{\partial\rho_{ji}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  }{\partial\mathbf{\bar{z}}} & \mathbb{O}\\
\mathbb{O} & \frac{\partial\rho_{ji}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{f}\left(  \zeta\right) \\
\overline{\mathbf{f}\left(  \zeta\right)  }%
\end{array}
\right)  ,
\end{align}
where
\begin{equation}
\frac{\partial\mathcal{F}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\mathbf{,\xi}\right)  }{\partial\mathbf{z}}=\sum_{1\leq
k,l\leq\nu}\left.  \frac{\partial\left\langle \left.  \Phi\left(
\mathbf{\varsigma}_{0}\right)  \right\vert a_{k}^{\dag}a_{l}\Phi\left(
\mathbf{\varsigma}_{0}\right)  \right\rangle }{\partial\mathbf{z}}\right\vert
_{\mathbf{z=z}_{0}}f_{kl}\left(  \zeta\right)  .
\end{equation}
In general the off diagonal blocks $\left\{  D_{\mathbf{\bar{z}\bar{z}}}%
^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  ,D_{\mathbf{zz}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  \right\}  $ are not zero. This
can be seen by considering
\begin{align}
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)   &  =\left\langle \left.  \exp\left\{  \sum
\limits_{_{\substack{-s\leq j<k\leq s\\\left\vert j\right\vert \neq\left\vert
k\right\vert }}}z_{+jk}q_{jk}^{\dagger}\right\}  \exp\left\{  \sum
\limits_{_{\substack{-s\leq j<k\leq s\\\left\vert j\right\vert \neq\left\vert
k\right\vert }}}\lambda_{jk}u_{jk}\right\}  g_{0}^{\frac{N}{2}}\right\vert
H_{0}\right. \nonumber\\
&  \quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\left\vert
\exp\left\{  \sum\limits_{_{\substack{-s\leq j<k\leq s\\\left\vert
j\right\vert \neq\left\vert k\right\vert }}}z_{+jk}q_{jk}^{\dagger}\right\}
\exp\left\{  \sum\limits_{_{\substack{-s\leq j<k\leq s\\\left\vert
j\right\vert \neq\left\vert k\right\vert }}}\lambda_{jk}u_{jk}\right\}
g_{0}^{\frac{N}{2}}\right\rangle
\end{align}
one can see that
\begin{equation}
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}_{+}\partial
\mathbf{z}_{+}}=0\Rightarrow\left\langle \left.  \Phi\left(  \mathbf{\varsigma
}_{0}\right)  \right\vert H_{0}q_{i_{1}j_{1}}^{\dagger}\cdots q_{i_{m}j_{m}%
}^{\dagger}\Phi\left(  \mathbf{\varsigma}_{0}\right)  \right\rangle
=0\quad\forall m\geq2
\end{equation}
implies that $H_{0}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  $ is first
order in $\mathbf{z}$ and that $H_{0}$ is a linear function of $\left\{
q_{i_{1}j_{1}}^{\dagger}\right\}  $. From
\begin{equation}
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}_{+}%
\partial\mathbf{\bar{z}}_{+}}=0,\frac{\partial^{2}\mathcal{E}_{0}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial
\mathbf{\lambda}\partial\mathbf{\lambda}}=0,\frac{\partial^{2}\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
}{\partial\mathbf{\bar{\lambda}}\partial\mathbf{\bar{\lambda}}}=0
\end{equation}
one reaches the same conclusion about the operators $\left\{  q_{ij}\right\}
$ and $\left\{  \lambda_{ij}\right\}  .$ If this were true then
\begin{equation}
H_{0}=E_{0}\left\vert g_{0}^{\frac{N}{2}}\right\rangle \left\langle
g_{0}^{\frac{N}{2}}\right\vert +\sum_{n}\left(  E_{n}-E_{0}\right)
Q_{n}^{\dagger}\left\vert g_{0}^{\frac{N}{2}}\right\rangle \left\langle
g_{0}^{\frac{N}{2}}\right\vert Q_{n}%
\end{equation}
where
\begin{equation}
Q_{n}^{\dagger}=\sum\limits_{_{\substack{-s\leq j<k\leq s\\\left\vert
j\right\vert \neq\left\vert k\right\vert }}}Q_{njk}q_{jk}^{\dagger}%
+\sum\limits_{_{\substack{-s\leq j<k\leq s\\\left\vert j\right\vert
\neq\left\vert k\right\vert }}}U_{njk}u_{jk}%
\end{equation}
Thus if the excited states were single excitations out of the reference state
were exact, the off diagonal blocks would be identically zero and the
Hamiltonian could be written as a bilinear form in the above excitation
operators. In this case the quadratic expansion would be exact and Taylor
series quadratic error would be zero. (Note that diagonalizing the Hessian
does not accomplish this unless the off diagonal blocks are actually zero, as
the eigen excitation operators would then be linear combinations of the
excitation operators and their adjoints.) The slower the convergence of the
Taylor series, i.e. the greater the quadratic error term, the poorer the
approximation of excited states by single particle excitations out of the
reference is.

Once the coherent state manifold is defined one is free to use any well
defined coordinate system in which to find the critical points of the energy
function i.e. classical Hamiltonian, for that manifold. We have published a
procedure based on the coordinates based on the following parameterization of
AGP states%
\begin{equation}
\left\vert g^{\frac{N}{2}}\right\rangle =P_{N}\exp\left\{  \sum_{1\leq i<j\leq
r}g_{ij}a_{i}^{\dagger}a_{j}^{\dagger}\right\}  \left\vert \phi\right\rangle
\end{equation}
This procedure will be compared to ones based on coordinate system
$\{\mathbf{z}\}$.

\section{Summary and Discussion\label{discussion}}

We have described how there are three possible chains of coset decompositions
of the one particle unitary group $U\left(  r\right)  $ starting from maximal
compact subgroups. Each of these chains produce families of cosets $\left\{
U\left(  r\right)  \left/  K\right.  \right\}  $. A coset produces a manifold
of coherent states from a reference state $\left\vert \Phi_{ref}\right\rangle
$ if this state carries a one dimensional unitary representation of the
subgroup $K$ and the Hilbert space that $\left\vert \Phi_{ref}\right\rangle $
belongs to carries an irreducible representation of $U\left(  r\right)  .$ As
we are considering $N=2M$ electron states this condition rules out cosets
based on the maximal compact groups $SO(r)$ and $U\left(  p\right)  \times
U\left(  r-p\right)  $ for $p\neq N$, leaving only $USp\left(  2s\right)  $
and $U\left(  N\right)  \times U\left(  r-N\right)  $. The subgroups
$USp\left(  2\omega_{1}\right)  \times\cdots\times USp\left(  2\omega
_{p}\right)  \times SU\left(  2\right)  ^{\sigma}\times SU\left(  2\xi\right)
$ of $USp\left(  2s\right)  $ also satisfy this CS\ condition, but there are
no subgroups of $U\left(  N\right)  \times U\left(  r-N\right)  $ that do. The
reference state for all of these cosets is an AGP\ state belonging to the
class (see section \ref{one particle groups}) $\left\{  \sigma,\omega
_{1},\cdots,\omega_{\rho},\xi\right\}  $ that is determined by the canonical
coefficients $\left\{  c_{j}\right\}  $ of the geminal $\left\vert
g\right\rangle $, this index set also classifies the possible isotropy
subgroups and hence the cosets. The Lie algebra of $U\left(  r\right)  $ has
different direct sum decompositions determined by the different subgroups
generating the cosets. The manifolds of AGP\ CS's $\mathcal{M}\left(
\sigma,\omega_{1},\cdots,\omega_{\rho},\xi\right)  $ have complex coordinates
systems $\mathbf{z}$ wrt the reference state dependent bases adapted to these
Lie algebra decompositions and these coordinates parameterize AGP states.
Different manifolds contain AGP states that describe different physical
properties e.g. extreme AGP's have properties associated with highly
correlated systems, such as superconductors.

The manifolds $\mathcal{M}\left(  \sigma,\omega_{1},\cdots,\omega_{\rho}%
,\xi\right)  $ equipped with the coordinate system $\mathbf{z}$ are
particularly useful as they have a natural generalized phase space structure
and can be used to construct, via the TDVP,\ approximations of the TDSE as a
classical dynamical system. If one used the manifold constituted by whole
Hilbert space $\mathcal{H}^{N}$ (not an AGP\ manifold) then the classical
Hamilton equations plus an equation for a time dependent phase would be
equivalent to the TDSE, and their solutions would provide solutions to the
Schr\"{o}dinger equation. The classical equations restricted to the
AGP\ manifolds produce paths of AGP states that approximate the exact paths.
One can consider the classical linear response of approximate stationary
states found on these manifolds to external time dependent perturbations
either within the curved phase or in the tangent space at these points
\cite{Weiner94}. This allows a variety of linear response approximations
schemes to be developed that generalize and clarify propagator and Random
Phase approximations.

\appendix


\section{Matrices\label{Matrices}}

The metric matrix $\mathbf{C}\left(  \mathrm{\bar{z}}\left(  t\right)
,\mathrm{z}\left(  t\right)  \right)  =\left\{  \frac{\partial^{2}%
\Lambda\left(  \mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(  t\right)
\right)  }{\partial\bar{z}_{j}\partial z_{k}}\right\}  $ is given by%
\begin{align}
\mathbf{C}\left(  \mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(
t\right)  \right)   &  =\frac{1}{\mathcal{S}\left(  \mathrm{\bar{z}}\left(
t\right)  ,\mathrm{z}\left(  t\right)  \right)  }\left\{  \frac{\partial
^{2}\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(
t\right)  \right)  }{\partial\mathbf{\bar{z}}\partial\mathbf{z}}\right.
\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\left.  -\frac{1}{\mathcal{S}\left(
\mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(  t\right)  \right)  }%
\frac{\partial\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)
,\mathrm{z}\left(  t\right)  \right)  }{\partial\mathbf{\bar{z}}}\otimes
\frac{\partial\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)
,\mathrm{z}\left(  t\right)  \right)  }{\partial\mathbf{z}}\right\}  ,
\end{align}
and the gradient of the energy function $\mathcal{E}\left(  \mathrm{\bar{z}%
}\mathbf{,}\mathrm{z},t\right)  $ has the form%
\begin{equation}
D^{1}\mathcal{E}\left(  \mathrm{\bar{z}}\mathbf{,}\mathrm{z},t\right)
=\left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z}}\mathbf{,}\mathrm{z}%
,t\right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z}}\mathbf{,}\mathrm{z}%
,t\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  ,
\end{equation}
where
\begin{equation}
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z}}\mathbf{,}\mathrm{z}%
,t\right)  }{\partial\mathbf{x}}=\frac{1}{\mathcal{S}\left(  \mathrm{\bar{z}%
}\left(  t\right)  ,\mathrm{z}\left(  t\right)  \right)  }\left\{
\frac{\partial\mathcal{H}\left(  \mathrm{\bar{z}}\mathbf{,}\mathrm{z}%
,t\right)  }{\partial\mathbf{x}}-\mathcal{E}\left(  \mathrm{\bar{z}}%
\mathbf{,}\mathrm{z},t\right)  \frac{\partial\mathcal{S}\left(  \mathrm{\bar
{z}}\left(  t\right)  ,\mathrm{z}\left(  t\right)  \right)  }{\partial
\mathbf{x}}\right\}
\end{equation}
for $\mathbf{x=z,\bar{z}}$ and $\frac{\partial\mathcal{Y}\left(
\mathrm{\bar{z}}\mathbf{,}\mathrm{z},t\right)  }{\partial\mathbf{x}}$ is a
column vector with coordinates $\left\{  \left.  \frac{\partial\mathcal{Y}%
\left(  \mathrm{\bar{z}}\mathbf{,}\mathrm{z},t\right)  }{\partial x_{k}%
}\right\vert \mathcal{Y=H},\mathcal{S},\mathcal{E}\right\}  $.

\section{Functions on the Tangent Space\label{functions}}

Functions $f:\mathcal{M}\rightarrow\mathbb{C}$ induce linear functions, the
differentials $df\left[  \mathbf{z}_{0}\right]  :$ $\mathcal{T}_{\mathbf{z}%
_{0}}\rightarrow\mathbb{C}$, that are the best linear approximations to $f$
around the point $\mathbf{z}_{0}\in\mathcal{M}$. Physically this corresponds
to classical observables $f$ on a curved phase space $\mathcal{M}$ being
locally approximated by the linear observables $df\left[  \mathbf{z}%
_{0}\right]  $ that act on a flat phase space $\mathcal{T}_{\mathbf{z}_{0}}$.
As examples consider

\begin{description}
\item[(a)] the holomorphic function
\begin{equation}
f_{\chi}\left(  \mathbf{z}\right)  =\left\langle \chi\left\vert \Phi\left(
\mathbf{z}\right)  \right.  \right\rangle
\end{equation}
then
\begin{equation}
df_{\chi}\left[  \mathbf{z}_{0}\right]  \left(  \mathbf{0,\eta}\right)
=\sum_{1\leq j\leq\nu}\eta_{j}\left\langle \chi\left\vert Y_{j}\Phi\left(
\mathbf{z}_{0}\right)  \right.  \right\rangle ,
\end{equation}
where $\mathbf{\eta}$ are local coordinates i.e.
\begin{equation}
\mathbf{\eta=z-z}_{0}%
\end{equation}


\item[(b)] the real valued function%
\begin{equation}
f_{\operatorname{Re}\chi}\left(  \mathbf{\bar{z},z}\right)  =\left\langle
\chi\left\vert \Phi\left(  \mathbf{z}\right)  \right.  \right\rangle
+\left\langle \Phi\left(  \mathbf{z}\right)  \left\vert \chi\right.
\right\rangle
\end{equation}
then
\begin{equation}
df_{\operatorname{Re}\chi}\left[  \mathbf{z}_{0}\right]  \left(
\mathbf{\bar{\eta},\eta}\right)  =\sum_{1\leq j\leq\nu}\left\{  \eta
_{j}\left\langle \chi\left\vert Y_{j}\Phi\left(  \mathbf{z}_{0}\right)
\right.  \right\rangle +\bar{\eta}_{j}\left\langle \Phi\left(  \mathbf{z}%
_{0}\right)  \left\vert Y_{j}^{\dagger}\right.  \chi\right\rangle \right\}  ,
\end{equation}


\item[(c)] and a real valued classical observable
\begin{equation}
\mathcal{O}\left(  \mathbf{\bar{z},z}\right)  =\frac{\left\langle \left.
\Phi\left(  \mathbf{z}\right)  \right\vert O\Phi\left(  \mathbf{z}\right)
\right\rangle }{\left\langle \left.  \Phi\left(  \mathbf{z}\right)
\right\vert \Phi\left(  \mathbf{z}\right)  \right\rangle }%
\end{equation}
then
\begin{align}
d\mathcal{O}\left[  \mathbf{z}_{0}\right]  \left(  \mathbf{\bar{\eta},\eta
}\right)   &  =\sum_{1\leq j\leq\nu}\frac{1}{\mathcal{S}\left(  \mathbf{\bar
{z}}_{0},\mathbf{z}_{0}\right)  }\left\{  \overset{}{}\eta_{j}\left\{
\left\langle \Phi\left(  \mathbf{z}_{0}\right)  \left\vert OY_{j}\Phi\left(
\mathbf{z}_{0}\right)  \right.  \right\rangle -\mathcal{O}\left(
\mathbf{\bar{z}}_{0},\mathbf{z}_{0}\right)  \left\langle \Phi\left(
\mathbf{z}_{0}\right)  \left\vert Y_{j}\Phi\left(  \mathbf{z}_{0}\right)
\right.  \right\rangle \right\}  \right. \nonumber\\
&  +\left.  \bar{\eta}_{j}\left\{  \left\langle \Phi\left(  \mathbf{z}%
_{0}\right)  \left\vert Y_{j}^{\dagger}O\Phi\left(  \mathbf{z}_{0}\right)
\right.  \right\rangle -\mathcal{O}\left(  \mathbf{\bar{z}}_{0},\mathbf{z}%
_{0}\right)  \left\langle \Phi\left(  \mathbf{z}_{0}\right)  \left\vert
Y_{j}^{\dagger}\Phi\left(  \mathbf{z}_{0}\right)  \right.  \right\rangle
\right\}  \overset{}{}\right\}  .
\end{align}
This can be expressed in matrix form as
\begin{equation}
d\mathcal{O}\left[  \mathbf{z}_{0}\right]  \left(  \mathbf{\bar{\eta},\eta
}\right)  =\left(
\begin{array}
[c]{cc}%
\frac{\partial\mathcal{O}\left(  \mathbf{\bar{z}}_{0},\mathbf{z}_{0}\right)
}{\partial\mathbf{\bar{z}}} & \frac{\partial\mathcal{O}\left(  \mathbf{\bar
{z}}_{0},\mathbf{z}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\eta}\\
\mathbf{\bar{\eta}}%
\end{array}
\right)
\end{equation}
where
\begin{align}
\frac{\partial\mathcal{O}\left(  \mathbf{\bar{z}}_{0},\mathbf{z}_{0}\right)
}{\partial\mathbf{z}}  &  =\frac{1}{\mathcal{S}\left(  \mathbf{\bar{z}}%
_{0},\mathbf{z}_{0}\right)  }\left\{  \left\langle \Phi\left(  \mathbf{z}%
_{0}\right)  \left\vert O\mathbf{Y}\Phi\left(  \mathbf{z}_{0}\right)  \right.
\right\rangle -\mathcal{O}\left(  \mathbf{\bar{z}}_{0},\mathbf{z}_{0}\right)
\left\langle \Phi\left(  \mathbf{z}_{0}\right)  \left\vert \mathbf{Y}%
\Phi\left(  \mathbf{z}_{0}\right)  \right.  \right\rangle \right\} \nonumber\\
\frac{\partial\mathcal{O}\left(  \mathbf{\bar{z}}_{0},\mathbf{z}_{0}\right)
}{\partial\mathbf{\bar{z}}}  &  =\frac{1}{\mathcal{S}\left(  \mathbf{\bar{z}%
}_{0},\mathbf{z}_{0}\right)  }\left\{  \left\langle \Phi\left(  \mathbf{z}%
_{0}\right)  \left\vert \mathbf{Y}^{\dag}O\Phi\left(  \mathbf{z}_{0}\right)
\right.  \right\rangle -\mathcal{O}\left(  \mathbf{\bar{z}}_{0},\mathbf{z}%
_{0}\right)  \left\langle \Phi\left(  \mathbf{z}_{0}\right)  \left\vert
\mathbf{Y}^{\dag}\Phi\left(  \mathbf{z}_{0}\right)  \right.  \right\rangle
\right\}  .
\end{align}

\end{description}

In general real analytic functions on $\mathcal{M}$ can be expanded as
functions on any tangent space $\mathcal{T}_{\mathbf{z}_{0}}$ as%
\begin{equation}
f\left(  \mathbf{\bar{z}}_{0}+\mathbf{\bar{\eta},z}_{0}+\mathbf{\eta}\right)
=\sum_{1\leq n\leq\infty}D^{n}f\left[  \mathbf{\bar{z}}_{0}\mathbf{,z}%
_{0}\right]  \left(  \mathbf{\bar{\eta},\eta}\right)  \label{tay1}%
\end{equation}
where
\begin{equation}
D^{n}f\left[  \mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(
\mathbf{\bar{\eta},\eta}\right)  =\sum_{p+q=n}\left(  \frac{\partial
^{n}f\left(  \mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right)  }{\partial
^{p}\mathbf{\bar{z}\partial}^{q}\mathbf{z}}\right)  \cdot\left(
\mathbf{\bar{\eta}}^{\otimes p}\otimes\mathbf{\eta}^{\otimes q}\right)
\end{equation}
and
\begin{equation}
\left(  \frac{\partial^{n}f\left(  \mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right)
}{\partial^{p}\mathbf{\bar{z}\partial}^{q}\mathbf{z}}\right)  \cdot\left(
\mathbf{\bar{\eta}}^{\otimes p}\otimes\mathbf{\eta}^{\otimes q}\right)
=\frac{1}{p!q!}\sum_{\substack{1\leq j_{1},\ldots,j_{p}\leq\nu\\1\leq
k_{1},\ldots,k_{q}\leq\nu}}\frac{\partial^{n}f\left(  \mathbf{\bar{z}}%
_{0}\mathbf{,z}_{0}\right)  }{\partial\bar{z}_{j_{1}}\cdots\partial\bar
{z}_{j_{p}}\mathbf{\partial}z_{k_{1}}\cdots\mathbf{\partial}z_{k_{q}}}%
\bar{\eta}_{j_{1}}\cdots\bar{\eta}_{j_{p}}\eta_{k_{1}}\cdots\eta_{k_{q}}.
\end{equation}
Substituting $\mathbf{\eta=z-z}_{0}$ in eq. $\left(  \ref{tay1}\right)  $ one
obtains
\begin{equation}
f\left(  \mathbf{\bar{z},z}\right)  =\sum_{1\leq n\leq\infty}D^{n}f\left[
\mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(  \mathbf{\bar{z}-\bar{z}%
}_{0}\mathbf{,z-z}_{0}\right)  \label{tay2}%
\end{equation}
showing that analytic functions can be viewed as functions on any tangent
space $\mathcal{T}_{\mathbf{z}_{0}}.$ This is not unexpected as $\mathbb{C}%
^{\nu}$ is linearly isomorphic to $\mathcal{T}_{\mathbf{z}_{0}}$ for any
$\mathbf{z}_{0}$ through the maps $d\Phi\left[  \mathbf{z}_{0}\right]  $%
\begin{equation}
d\Phi\left[  \mathbf{z}_{0}\right]  :\mathbb{C}^{\nu}\rightarrow
\mathcal{T}_{\mathbf{z}_{0}}^{\left(  1,0\right)  }%
\end{equation}
and thus can be used as the flat coordinate space. Equations eq. $\left(
\ref{tay1}\right)  $ and eq. $\left(  \ref{tay2}\right)  $ lead to
approximations defined as
\begin{equation}
f_{M}\left[  \mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(
\mathbf{\bar{z},z}\right)  =\sum_{1\leq n\leq M}D^{n}f\left[  \mathbf{\bar{z}%
}_{0}\mathbf{,z}_{0}\right]  \left(  \mathbf{\bar{z}-\bar{z}}_{0}%
\mathbf{,z-z}_{0}\right)  .
\end{equation}
In particular
\begin{equation}
\mathcal{O}_{2}\left[  \mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(
\mathbf{\bar{z},z}\right)  =\sum_{1\leq n\leq2}D^{n}\mathcal{O}\left[
\mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(  \mathbf{\bar{z}-\bar{z}%
}_{0}\mathbf{,z-z}_{0}\right)
\end{equation}
which can be equivalently expressed in terms of tangent space coordinates as
\begin{equation}
\mathcal{O}_{2}\left[  \mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(
\mathbf{\bar{\eta},\eta}\right)  =\sum_{1\leq n\leq2}D^{n}\mathcal{O}\left[
\mathbf{\bar{z}}_{0}\mathbf{,z}_{0}\right]  \left(  \mathbf{\bar{\eta},\eta
}\right)  .
\end{equation}
In an analogous fashion complex analytic functions can be expanded as
\begin{equation}
f\left(  \mathbf{z}\right)  =\sum_{1\leq n\leq\infty}D^{n}f\left[
\mathbf{z}_{0}\right]  \left(  \mathbf{z-z}_{0}\right)  =\sum_{1\leq
n\leq\infty}D^{n}f\left[  \mathbf{z}_{0}\right]  \left(  \mathbf{\eta}\right)
.
\end{equation}


\section{Matrix Theorem\label{Theorem}}

\begin{theorem}
A hermitian matrix $\left(
\begin{array}
[c]{cc}%
\mathbf{A} & \mathbf{B}\\
\overline{\mathbf{B}} & \overline{\mathbf{A}}%
\end{array}
\right)  $ has degenerate eigenvectors $\left(
\begin{array}
[c]{c}%
\mathbf{a}\\
\mathbf{b}%
\end{array}
\right)  $ and $\left(
\begin{array}
[c]{c}%
\overline{\mathbf{b}}\\
\overline{\mathbf{a}}%
\end{array}
\right)  .$

\begin{proof}
Let
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{A} & \mathbf{B}\\
\overline{\mathbf{B}} & \overline{\mathbf{A}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{a}\\
\mathbf{b}%
\end{array}
\right)  =\lambda\left(
\begin{array}
[c]{c}%
\mathbf{a}\\
\mathbf{b}%
\end{array}
\right)  ;\qquad\lambda\in\mathbb{R}%
\end{equation}
then
\begin{align}
\mathbf{Aa+Bb}  &  =\lambda\mathbf{a}\nonumber\\
\overline{\mathbf{B}}\mathbf{a}+\overline{\mathbf{A}}\mathbf{b}  &
\mathbf{=}\lambda\mathbf{b.} \label{ex1}%
\end{align}
Taking the complex conjugate of eq. $\left(  \ref{ex1}\right)  $ we obtain
\begin{align}
\overline{\mathbf{A}}\mathbf{\bar{a}}+\overline{\mathbf{B}}\overline
{\mathbf{b}}  &  =\lambda\mathbf{\bar{a}}\nonumber\\
\mathbf{B\bar{a}}+\mathbf{A\overline{\mathbf{b}}}  &  \mathbf{=}%
\lambda\overline{\mathbf{b}},
\end{align}
which corresponds to
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{A} & \mathbf{B}\\
\overline{\mathbf{B}} & \overline{\mathbf{A}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\overline{\mathbf{b}}}\\
\mathbf{\bar{a}}%
\end{array}
\right)  =\lambda\left(
\begin{array}
[c]{c}%
\mathbf{\overline{\mathbf{b}}}\\
\mathbf{\bar{a}}%
\end{array}
\right)  .
\end{equation}

\end{proof}
\end{theorem}

\section{Hermitian Form of the Energy Hessian\label{EnergyHess}}

The Hessian of the classical Hamiltonian $\mathcal{E}_{0}\left(
\mathbf{\bar{z}},\mathbf{\bar{z}}\right)  $ at the point $\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  $
\begin{equation}
\left(
\begin{array}
[c]{cc}%
D_{\mathbf{\bar{z}\bar{z}}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}%
}_{0},\mathbf{\varsigma}_{0}\right)  & D_{\mathbf{\bar{z}z}}^{2}%
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right) \\
D_{\mathbf{z\bar{z}}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  & D_{\mathbf{zz}}^{2}\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
\end{array}
\right)
\end{equation}
can be transformed into a hermitian matrix, $\mathfrak{D}$, by premultiplying
by $\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \mathbf{1}\\
\mathbf{1} & \mathbf{0}%
\end{array}
\right)  $ i.e.
\begin{equation}
\mathfrak{D}\equiv\left(
\begin{array}
[c]{cc}%
D_{\mathbf{z\bar{z}}}^{2}\mathcal{E}_{0} & D_{\mathbf{zz}}^{2}\mathcal{E}%
_{0}\\
D_{\mathbf{\bar{z}\bar{z}}}^{2}\mathcal{E}_{0} & D_{\mathbf{\bar{z}z}}%
^{2}\mathcal{E}_{0}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \mathbf{1}\\
\mathbf{1} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
D_{\mathbf{\bar{z}\bar{z}}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}%
}_{0},\mathbf{\varsigma}_{0}\right)  & D_{\mathbf{\bar{z}z}}^{2}%
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right) \\
D_{\mathbf{z\bar{z}}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  & D_{\mathbf{zz}}^{2}\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
\end{array}
\right)  .
\end{equation}
If $\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  $ is a
critical point of the classical Hamiltonian $\mathcal{E}_{0}\left(
\mathbf{\bar{z}},\mathbf{z}\right)  $ then
\begin{align}
&  \mathfrak{D}=\frac{1}{\mathcal{S}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }\left\{  \left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{H}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z\partial\bar{z}}} &
\frac{\partial^{2}\mathcal{H}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z\partial z}}\\
\frac{\partial^{2}\mathcal{H}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}\partial\bar{z}}}
& \frac{\partial^{2}\mathcal{H}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}\partial z}}%
\end{array}
\right)  -\mathcal{E}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  \left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z\partial\bar{z}}} &
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z\partial z}}\\
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}\partial\bar{z}}} &
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}\partial z}}%
\end{array}
\right)  \right\} \nonumber\\
&  \equiv\frac{1}{\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }\left\{  \mathfrak{H}-\mathcal{E}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  \mathfrak{\Delta
}\right\}  ,
\end{align}
where the positive definite metric matrix $\mathfrak{\Delta}$ is defined as
\begin{equation}
\mathfrak{\Delta}=\left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z\partial\bar{z}}} &
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z\partial z}}\\
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}\partial\bar{z}}} &
\frac{\partial^{2}\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}\partial z}}%
\end{array}
\right)  .
\end{equation}
As%
\begin{equation}
\left\{  \mathfrak{H}-\mathcal{E}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  \mathfrak{\Delta}\right\}
=\mathfrak{\Delta}^{\frac{1}{2}}\left\{  \mathfrak{\Delta}^{-\frac{1}{2}%
}\mathfrak{H\Delta}^{-\frac{1}{2}}-\mathcal{E}\left(  \mathbf{\bar{\varsigma}%
}_{0},\mathbf{\varsigma}_{0}\right)  \mathbb{I}_{2\nu}\right\}
\mathfrak{\Delta}^{\frac{1}{2}},
\end{equation}
it is natural to consider the spectral expansions
\begin{equation}
\mathfrak{\Delta}^{-\frac{1}{2}}\mathfrak{H\Delta}^{-\frac{1}{2}}=\sum_{1\leq
j\leq\nu}\sigma_{j}\left\{  \mathbf{y}_{j}\mathbf{y}_{j}^{\dagger}%
+\mathbf{y}_{j+\nu}\mathbf{y}_{j+\nu}^{\dagger}\right\}  ;\qquad\eta_{j}%
\in\mathbb{R}%
\end{equation}
and
\begin{equation}
\mathbb{I}_{2\nu}=\sum_{1\leq j\leq\nu}\left\{  \mathbf{y}_{j}\mathbf{y}%
_{j}^{\dagger}+\mathbf{y}_{j+\nu}\mathbf{y}_{j+\nu}^{\dagger}\right\}
\end{equation}
to obtain
\begin{align}
\left\{  \mathfrak{H}-\mathcal{E}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  \mathfrak{\Delta}\right\}   &
=\mathfrak{\Delta}^{\frac{1}{2}}\left\{  \sum_{1\leq j\leq\nu}\sigma
_{j}\left\{  \mathbf{y}_{j}\mathbf{y}_{j}^{\dagger}+\mathbf{y}_{j+\nu
}\mathbf{y}_{j+\nu}^{\dagger}\right\}  -\mathcal{E}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  \sum_{1\leq j\leq\nu}\left\{
\mathbf{y}_{j}\mathbf{y}_{j}^{\dagger}+\mathbf{y}_{j+\nu}\mathbf{y}_{j+\nu
}^{\dagger}\right\}  \right\}  \mathfrak{\Delta}^{\frac{1}{2}}\nonumber\\
&  =\mathfrak{\Delta}^{\frac{1}{2}}\left\{  \sum_{1\leq j\leq\nu}\left(
\sigma_{j}-\mathcal{E}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  \right)  \left\{  \mathbf{y}_{j}\mathbf{y}_{j}^{\dagger
}+\mathbf{y}_{j+\nu}\mathbf{y}_{j+\nu}^{\dagger}\right\}  \right\}
\mathfrak{\Delta}^{\frac{1}{2}}.
\end{align}
Thus producing the spectral expansion
\begin{equation}
\mathfrak{D=}\left(
\begin{array}
[c]{cc}%
D_{\mathbf{z\bar{z}}}^{2}\mathcal{E}_{0} & D_{\mathbf{zz}}^{2}\mathcal{E}%
_{0}\\
D_{\mathbf{\bar{z}\bar{z}}}^{2}\mathcal{E}_{0} & D_{\mathbf{\bar{z}z}}%
^{2}\mathcal{E}_{0}%
\end{array}
\right)  =\frac{1}{\mathcal{S}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }\mathfrak{\Delta}^{\frac{1}{2}}\left\{
\sum_{1\leq j\leq\nu}\left(  \sigma_{j}-\mathcal{E}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  \right)  \left\{
\mathbf{y}_{j}\mathbf{y}_{j}^{\dagger}+\mathbf{y}_{j+\nu}\mathbf{y}_{j+\nu
}^{\dagger}\right\}  \right\}  \mathfrak{\Delta}^{\frac{1}{2}}.
\end{equation}


\section{Path Integrals\label{pathinteg}}

The probability, $P_{\Phi_{i}\rightarrow\Phi_{f}}\left(  \tau\right)  $, that
a quantum process characterized by a Hamiltonian $H$ starting from a given
initial state $\left\vert \Phi_{i}\right\rangle $ at time $t=0$ will be in a
given arbitrary state $\left\vert \Phi_{f}\right\rangle $ at a time $t=\tau$
is
\begin{equation}
P_{\Phi_{i}\rightarrow\Phi_{f}}\left(  \tau\right)  =\left\vert \left\langle
\Phi_{f}\left\vert U\left(  \tau\right)  \right.  \Phi_{i}\right\rangle
\right\vert ^{2},
\end{equation}
where the evolution operator $U\left(  t\right)  $ satisfies the equation
\begin{equation}
\frac{d}{dt}U\left(  t\right)  =-iH\left(  t\right)  U\left(  t\right)
\end{equation}
and produces solution paths $\left\{  \mathbf{\psi}\left(  t\right)  \right\}
$ of states%
\begin{equation}
\mathbf{\psi}\left(  t\right)  =\left\vert \Psi\left(  t\right)  \right\rangle
=T\left\{  e^{-i\int_{0}^{t}H\left(  t^{\prime}\right)  dt^{\prime}}\right\}
\left\vert \Phi_{i}\right\rangle
\end{equation}
indexed by the initial values $\left\{  \left\vert \Phi_{i}\right\rangle
\right\}  $ to the TDSE, where $T$ is the time ordering operator. The
transition amplitude $\left\langle \Phi_{f}\left\vert U\left(  \tau\right)
\right.  \Phi_{i}\right\rangle $ is called the propagator between the states
$\left\vert \Phi_{i}\right\rangle $ and $\left\vert \Phi_{f}\right\rangle $.
This transition amplitude can be expressed \emph{formally} as a path integral
over the space of paths
\begin{equation}
\mathfrak{P}\left(  \Phi_{i},\Phi_{f},\tau\right)  =\left\{  \left.
\mathbf{\psi}\right\vert ,\mathbf{\psi}\left(  t\right)  \in\mathcal{H}%
^{N}\quad t\in\left(  0,\tau\right)  ,\mathbf{\psi}\left(  0\right)
=\left\vert \Phi_{i}\right\rangle ,\mathbf{\psi}\left(  \tau\right)
=\left\vert \Phi_{f}\right\rangle \right\}
\end{equation}
as a path integral%
\begin{equation}
\left\langle \Psi_{f}\left\vert U\left(  \tau\right)  \right.  \Psi
_{i}\right\rangle =\int_{\mathfrak{P}\left(  \Phi_{i},\Phi_{f},\tau\right)
}e^{i\mathcal{A}\left(  \mathbf{\psi,\bar{\psi},\tau}\right)  }d\mu\left(
\mathbf{\psi}\right)  ,
\end{equation}
where $d\mu\left(  \mathbf{\psi}\right)  $ is a measure \cite{Measure} on the
space $\mathfrak{P}\left(  \Phi_{i},\Phi_{f},\tau\right)  $. The action,
$\mathcal{A},$ is defined in terms of a Lagrangian, $\mathcal{L}$, as
\begin{equation}
\mathcal{A}\left(  \mathbf{\psi,\bar{\psi},}\tau\right)  =\int_{0}^{\tau
}\mathcal{L}\left(  \mathbf{\psi},\mathbf{\bar{\psi},}t\right)  dt,
\end{equation}
where the Lagrangian is defined as
\begin{equation}
\mathcal{L}\left(  \mathbf{\psi},\mathbf{\bar{\psi},}t\right)  =\frac
{\left\langle \mathbf{\psi}\left(  t\right)  \left\vert \left(  i\frac
{\partial}{\partial t}-H\left(  t\right)  \right)  \mathbf{\psi}\left(
t\right)  \right.  \right\rangle }{\left\langle \mathbf{\psi}\left(  t\right)
\left\vert \mathbf{\psi}\left(  t\right)  \right.  \right\rangle }%
\equiv\mathcal{K}\left(  \mathbf{\psi},\mathbf{\bar{\psi},}t\right)
-\mathcal{E}\left(  \mathbf{\psi},\mathbf{\bar{\psi},}t\right)
\end{equation}
and we have introduced a classical kinetic energy term $\mathcal{K}$ and
Hamiltonian $\mathcal{E}$
\begin{subequations}
\begin{align}
\mathcal{K}\left(  \mathbf{\psi},\mathbf{\bar{\psi},}t\right)   &
=\frac{\left\langle \mathbf{\psi}\left(  t\right)  \left\vert i\frac{\partial
}{\partial t}\mathbf{\psi}\left(  t\right)  \right.  \right\rangle
}{\left\langle \mathbf{\psi}\left(  t\right)  \left\vert \mathbf{\psi}\left(
t\right)  \right.  \right\rangle }\\
\mathcal{E}\left(  \mathbf{\psi},\mathbf{\bar{\psi},}t\right)   &
=\frac{\left\langle \mathbf{\psi}\left(  t\right)  \left\vert H\left(
t\right)  \mathbf{\psi}\left(  t\right)  \right.  \right\rangle }{\left\langle
\mathbf{\psi}\left(  t\right)  \left\vert \mathbf{\psi}\left(  t\right)
\right.  \right\rangle }.
\end{align}
The notation used in eqs. $\left(  \ref{pathb}\right)  $ - $\left(
\ref{pathe}\right)  $ emphasizes the difference between the value of a path at
a particular point, which is a vector in $\mathcal{H}^{N},$ and a path, which
in this case, is a map from the closed real interval $\left[  0,\tau\right]  $
to $\mathcal{H}^{N}.$ The path integral method has and is the focus of a huge
literature containing discussions of technical details, mathematical rigor,
practical implementations and computational strategies, all of which have been
avoided in eqs. $\left(  \ref{pathb}\right)  -\left(  \ref{pathe}\right)  $.

\subsection{Path Integrals using Coherent States}

One of the fundamental properties of a family of group CS's $\left\{
\left\vert \Phi\left(  \mathbf{z}\right)  \right\rangle \right\}  $ associated
with a coset $G/K$ that form a manifold in the Hilbert space $\mathcal{H}^{N}$
is the existence of a resolution of the identity that is a consequence of the
irreducibility of $G$ on $\mathcal{H}^{N}$
\end{subequations}
\begin{equation}
I=\int\left\vert \Phi\left(  \mathbf{z}\right)  \right\rangle \left\langle
\Phi\left(  \mathbf{z}\right)  \right\vert d\mu\left(  \mathbf{z}\right)  ,
\label{reso}%
\end{equation}
where
\begin{equation}
\left\vert \Phi\left(  \mathbf{z}\right)  \right\rangle =C\left(
\mathbf{z}\right)  \left\vert \Phi_{ref}\right\rangle
\end{equation}
and $C\left(  \mathbf{z}\right)  $ is parameterization of the representation
of the coset $G/K$ on $\mathcal{H}^{N}$. The parameters $z$ belong to a
complex manifold $\mathcal{M}$, in the simplest case these manifolds are
finite dimensional vector spaces and $\mathbf{z}\,\equiv\left(  z_{1}%
,\cdots,z_{\nu}\right)  $, but in general they are complex domains
\cite{domains} (restricted regions of $\mathbb{C}^{\nu}),$ or even complex
valued function spaces. If one pre and post multiplies the evolution operator
$U\left(  \tau\right)  $ with the resolution eq. $\left(  \ref{reso}\right)  $
we obtain
\begin{align}
U\left(  \tau\right)   &  =\int\left\vert \Phi\left(  \mathbf{z}^{\prime
}\right)  \right\rangle \left\langle \Phi\left(  \mathbf{z}^{\prime}\right)
\left\vert U\left(  \tau\right)  \right.  \Phi\left(  \mathbf{z}\right)
\right\rangle \left\langle \Phi\left(  \mathbf{z}\right)  \right\vert
d\mu\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}\right)
\nonumber\\
&  \equiv\int P\left(  \mathbf{z}^{\prime},\mathbf{z},\tau\right)  \left\vert
\Phi\left(  \mathbf{z}^{\prime}\right)  \right\rangle \left\langle \Phi\left(
\mathbf{z}\right)  \right\vert d\mu\left(  \mathbf{z}^{\prime}\right)
d\mu\left(  \mathbf{z}\right)  ,
\end{align}
where
\begin{equation}
P\left(  z^{\prime},z,\tau\right)  =\left\langle \Phi\left(  z^{\prime
}\right)  \left\vert U\left(  \tau\right)  \right.  \Phi\left(  z\right)
\right\rangle
\end{equation}
form an overcomplete set of evolution operator matrix elements, also called
the propagator kernel. Any transition amplitude $\left\langle \Phi
_{f}\left\vert U\left(  \tau\right)  \right.  \Phi_{i}\right\rangle $ can be
expressed in terms of this kernel and holomorphic wavefunctions \cite{holo}
$\left\{  \Phi_{i}\left(  \mathbf{z}\right)  ,\Phi_{f}\left(  \mathbf{z}%
\right)  \right\}  ,$ both of which obviously depend on the family of CS's
being used, as
\begin{equation}
\left\langle \Phi_{f}\left\vert U\left(  \tau\right)  \right.  \Phi
_{i}\right\rangle =\int P\left(  \mathbf{z}^{\prime},\mathbf{z},\tau\right)
\overline{\Phi_{f}\left(  \mathbf{z}^{\prime}\right)  }\Phi_{i}\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)  d\mu\left(
\mathbf{z}\right)  ,
\end{equation}
where the holomorhpic wavefunction, $\Psi\left(  \mathbf{z}\right)  $, of
$\left\vert \Psi\right\rangle $ wrt the CS family $\left\{  \left\vert
\Phi\left(  \mathbf{z}\right)  \right\rangle \right\}  $ is defined as
\begin{equation}
\Psi\left(  \mathbf{z}\right)  =\left\langle \Phi\left(  \mathbf{z}\right)
\left\vert \Psi\right.  \right\rangle .
\end{equation}
Using the path integral construction the propagator kernel becomes an integral
over parameter paths $\left\{  \mathrm{z}\right\}  $ with fixed end points,
$\mathrm{z}\left(  0\right)  =\mathbf{z}_{i};\quad\mathrm{z}\left(
\tau\right)  =\mathbf{z}_{f}$
\begin{equation}
P\left(  \mathbf{z}_{f},\mathbf{z}_{i},\tau\right)  =\int_{\mathfrak{P}\left(
\mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  }e^{i\mathcal{A}\left(
\mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)  }d\mu\left(  \mathrm{z}%
\right)  , \label{p1}%
\end{equation}
where the space of parameter paths is
\begin{equation}
\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  =\left\{
\left.  \mathrm{z}\right\vert ,\mathrm{z}\left(  t\right)  \in\mathcal{M}%
\mathfrak{,}\quad t\in\left[  0,\tau\right]  ,\mathrm{z}\left(  0\right)
=\mathbf{z}_{i},\mathrm{z}\left(  \tau\right)  =\mathbf{z}_{f}\right\}  ,
\end{equation}
the action
\begin{equation}
\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)  =\int
_{0}^{\tau}\mathcal{L}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)
dt
\end{equation}
and the Lagrangian is defined as
\begin{equation}
\mathcal{L}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)
=\frac{\left\langle \Phi\left(  \mathrm{z}\left(  t\right)  \right)
\left\vert \left(  i\frac{\partial}{\partial t}-H\left(  t\right)  \right)
\Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right.  \right\rangle
}{\left\langle \Phi\left(  \mathrm{z}\left(  t\right)  \right)  \left\vert
\Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right.  \right\rangle
}\equiv\mathcal{K}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)
-\mathcal{E}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)  .
\end{equation}
From this definition one can observe that the Lagrangian $\mathcal{L}$ can be
considered as a function of $\mathrm{v}\left(  t\right)  =\mathrm{\dot{z}%
}\left(  t\right)  \mathrm{,}$ so that
\begin{equation}
\mathcal{L=L}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\mathrm{\bar{v}%
},\mathrm{v}\mathbf{,}t\right)  ,
\end{equation}
and $\left\{  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\mathrm{\bar{v}}%
,\mathrm{v}\right\}  $ can be considered as independent variables that
determine $\mathcal{L}$. This is important in the derivation of equations of
motion for $\left\{  \mathrm{\bar{z}},\mathrm{z}\right\}  \mathrm{\ }%
$resulting from the Principle of Stationary Action $\delta^{1}\mathcal{A}%
\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)  =0$, (see any text
discussing the calculus of variations e.g. \cite{sagan}). For notational
convenience we will not explicitly show the dependence of $\mathcal{L}$ on
$\mathrm{v}\left(  t\right)  $.

\subsection{Stationary Phase Approximation \label{SPA}}

The action functional $\mathcal{A}$ can be expanded around any path
$\mathrm{z}$ in terms of the incremental paths $\delta\mathrm{z}\in$
$\mathfrak{P}_{0}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)
\subset\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  $, that
are zero at the end points i.e. $\delta\mathrm{z}\left(  0\right)
=\delta\mathrm{z}\left(  \tau\right)  =0$, as
\begin{equation}
\mathcal{A}\left(  \mathrm{\bar{z}}+\delta\mathrm{\bar{z}},\mathrm{z}%
+\delta\mathrm{z}\mathbf{,}\tau\right)  =\mathcal{A}\left(  \mathrm{\bar{z}%
},\mathrm{z}\mathbf{,}\tau\right)  +\delta^{1}\mathcal{A}\left(
\mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)  +\delta^{2}\mathcal{A}%
\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)  +\cdots.
\label{vari}%
\end{equation}
The first and second order changes in the action are given by
\begin{align}
\delta^{1}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
&  =\left(
\begin{array}
[c]{cc}%
D_{\mathrm{\bar{z}}}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}%
\mathbf{,}\tau\right)  & D_{\mathrm{z}}\mathcal{A}\left(  \mathrm{\bar{z}%
},\mathrm{z}\mathbf{,}\tau\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\delta\mathrm{\bar{z}}\\
\delta\mathrm{z}%
\end{array}
\right) \\
\delta^{2}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
&  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\delta\mathrm{\bar{z}} & \delta\mathrm{z}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
D_{\mathrm{\bar{z}\bar{z}}}^{2}\mathcal{A}\left(  \mathrm{\bar{z}}%
,\mathrm{z}\mathbf{,}\tau\right)  & D_{\mathrm{\bar{z}z}}^{2}\mathcal{A}%
\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right) \\
D_{\mathrm{z\bar{z}}}^{2}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}%
\mathbf{,}\tau\right)  & D_{\mathrm{zz}}^{2}\mathcal{A}\left(  \mathrm{\bar
{z}},\mathrm{z}\mathbf{,}\tau\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\delta\mathrm{\bar{z}}\\
\delta\mathrm{z}%
\end{array}
\right)  , \label{actexp}%
\end{align}
where the gradient $D_{\mathrm{x}}\mathcal{A}\left(  \mathrm{\bar{z}%
},\mathrm{z}\mathbf{,}t\right)  $ and Hessian $D_{\mathrm{xy}}^{2}%
\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)  $ of the
action are composed of the functional derivatives
\begin{align}
D_{\mathrm{x}}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}%
t\right)   &  =\left\{  \frac{\delta\mathcal{A}\left(  \mathrm{\bar{z}%
},\mathrm{z}\mathbf{,}t\right)  }{\delta\mathrm{x}\left(  t\right)  }\right\}
;\mathrm{x}\left(  t\right)  =\mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}%
\left(  t\right)  ,\nonumber\\
D_{\mathrm{xy}}^{2}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}%
\mathbf{,}t\right)   &  =\left\{  \frac{\delta^{2}\mathcal{A}\left(
\mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)  }{\delta\mathrm{x}\left(
t\right)  \delta\mathrm{y}\left(  t\right)  }\right\}  ;\mathrm{x}\left(
t\right)  =\mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(  t\right)
;\mathrm{y}\left(  t\right)  =\mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}%
\left(  t\right)  ,
\end{align}
which are defined by
\begin{equation}
D_{\mathrm{x}}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}%
\tau\right)  =\lim_{\eta\rightarrow0}\frac{1}{\eta}\mathcal{A}\left(
\mathrm{\bar{z}}+\eta\delta\mathrm{x},\mathrm{z}+\eta\delta\mathrm{x}%
\mathbf{,}\tau\right)  .
\end{equation}
The matrix product in eq. $\left(  \ref{actexp}\right)  $ is defined in terms
of integration as
\begin{equation}
D_{\mathrm{\bar{z}}}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}%
\mathbf{,}\tau\right)  \left(  \delta\mathrm{\bar{z}}\right)  =\int_{0}^{\tau
}\frac{\delta\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}t\right)
}{\delta\mathrm{\bar{z}}\left(  t\right)  }\delta\mathrm{\bar{z}}\left(
t\right)  dt.
\end{equation}
The paths $\zeta\in\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f}%
,\tau\right)  $ that make the action stationary to all incremental variation,
$\delta\mathrm{z}\in$ $\mathfrak{P}_{0}\left(  \mathbf{z}_{i},\mathbf{z}%
_{f},\tau\right)  $, i.e.%
\begin{equation}
\delta^{1}\mathcal{A}\left(  \bar{\zeta}\mathbf{,}\zeta\mathbf{,}\tau\right)
=\left(
\begin{array}
[c]{cc}%
D_{\mathrm{\bar{z}}}\mathcal{A}\left(  \bar{\zeta}\mathbf{,}\zeta
\mathbf{,}\tau\right)  & D_{\mathrm{z}}\mathcal{A}\left(  \bar{\zeta
}\mathbf{,}\zeta\mathbf{,}\tau\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\delta\mathrm{\bar{z}}\\
\delta\mathrm{z}%
\end{array}
\right)  =0\quad\forall\delta\mathrm{\bar{z},}\delta\mathrm{z}%
\end{equation}
are called classical paths.

The changes in the action can also be given in terms of the first and second
order variations of the Lagrangian as
\begin{align}
\delta^{1}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
&  =\int_{0}^{\tau}\delta^{1}\mathcal{L}\left(  \mathrm{\bar{z}}%
,\mathrm{z}\mathbf{,}t\right)  dt\nonumber\\
\delta^{2}\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
&  =\int_{0}^{\tau}\delta^{2}\mathcal{L}\left(  \mathrm{\bar{z}}%
,\mathrm{z}\mathbf{,}t\right)  dt.
\end{align}
where at a fixed time $t$, the Lagrangian $\mathcal{L}$ is considered to be a
function of the independent variables $z=\mathrm{z}\left(  t\right)  ,$
$\bar{z}=\mathrm{\bar{z}}\left(  t\right)  $, $v=\mathrm{v}\left(  t\right)  $
and $\bar{v}=\mathrm{\bar{v}}\left(  t\right)  $, i.e. the values of the path
and path velocities, in contrast to the action that is a function of the
complete path. This leads to the following expressions for the variations of
the Lagrangian as
\begin{align}
\delta^{1}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)   &  =\left(
\begin{array}
[c]{cccc}%
D_{\mathbf{\bar{z}}}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  &
D_{\bar{v}}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{z}%
\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{v}\mathcal{L}\left(
\bar{z},z\mathbf{,}t\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\delta\bar{z}\\
\delta\bar{v}\\
\delta z\\
\delta v
\end{array}
\right) \\
\delta^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)   &  =\frac{1}%
{2}\left(
\begin{array}
[c]{cccc}%
\delta\bar{z} & \delta\bar{v} & \delta z & \delta v
\end{array}
\right)  \times\nonumber\\
&  \left(
\begin{array}
[c]{cccc}%
D_{zz}^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{z\bar{v}}%
^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{zz}^{2}%
\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{zv}^{2}\mathcal{L}\left(
\bar{z},z\mathbf{,}t\right) \\
D_{vz}^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{v\bar{v}}%
^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{vz}^{2}%
\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{vv}^{2}\mathcal{L}\left(
\bar{z},z\mathbf{,}t\right) \\
D_{zz}^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{z\bar{v}}%
^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{zz}^{2}%
\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{zv}^{2}\mathcal{L}\left(
\bar{z},z\mathbf{,}t\right) \\
D_{vz}^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{v\bar{v}}%
^{2}\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{vz}^{2}%
\mathcal{L}\left(  \bar{z},z\mathbf{,}t\right)  & D_{vv}^{2}\mathcal{L}\left(
\bar{z},z\mathbf{,}t\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\delta\bar{z}\\
\delta\bar{v}\\
\delta z\\
\delta v
\end{array}
\right)  ,
\end{align}
where
\begin{equation}
D_{\mathbf{x}}\mathcal{L}\left(  \bar{z},z\mathbf{,}\bar{v},v,t\right)
\left(  \delta\mathbf{x}\right)  =\frac{\partial\mathcal{L}\left(  \bar
{z},z\mathbf{,}\bar{v},v,t\right)  }{\partial\mathbf{x}}\delta\mathbf{x=}%
\sum_{1\leq j\leq\nu}\frac{\partial\mathcal{L}\left(  \bar{z},z\mathbf{,}%
\bar{v},v,t\right)  }{\partial x_{j}}\delta x_{j};\quad\mathbf{x=z,\bar
{z},v,\bar{v}.}%
\end{equation}


If one assumes that the action, $\mathcal{A}$, is an analytical functional
then one can expand it as a convergent power series about any point
$\mathrm{z}\in$ $\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f}%
,\tau\right)  $ in terms of functionals,$\left\{  \delta^{j}\mathcal{A}%
\right\}  $, of $\left\{  \delta\mathrm{\bar{z}},\delta\mathrm{z}\right\}  $
as
\begin{equation}
\mathcal{A}\left(  \mathrm{\bar{z}}+\delta\mathrm{\bar{z}},\mathrm{z}%
+\delta\mathrm{z}\mathbf{,}\tau\right)  =\sum\limits_{0\leq j\leq\infty}%
\delta^{j}\mathcal{A}\left(  \delta\mathrm{\bar{z}},\delta\mathrm{z}\right)  ,
\end{equation}
where we dropped explicit reference to the time interval $\tau$ in the
variations. The path integral eq. $\left(  \ref{approxpath}\right)  $ can then
be reformulated as%
\begin{align}
\int_{\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)
}e^{i\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
}d\mu\left(  \mathrm{z}\right)   &  =\int_{\mathfrak{P}_{0}\left(
\mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  }\exp\left\{  i\sum\limits_{0\leq
j\leq\infty}\delta^{j}\mathcal{A}\left(  \delta\mathrm{\bar{z}},\delta
\mathrm{z}\right)  \right\}  d\mu\left(  \delta\mathrm{z}\right) \nonumber\\
&  =e^{i\mathcal{A}\left(  \bar{\zeta}\mathbf{,}\zeta\mathbf{,}\tau\right)
}\int_{\mathfrak{P}_{0}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)
}\exp\left\{  i\sum\limits_{1\leq j\leq\infty}\delta^{j}\mathcal{A}\left(
\delta\mathrm{\bar{z}},\delta\mathrm{z}\right)  \right\}  d\mu\left(
\delta\mathrm{z}\right)  . \label{pathtay}%
\end{align}


Using the theory of oscillatory integrals the path integral eq. $\left(
\ref{p1}\right)  $ can be asymptotically approximated \cite{de Witt} as
\begin{equation}
\int_{\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)
}e^{i\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
}d\mu\left(  \mathrm{z}\right)  \approx\sum_{\lambda}K\left(  \mathrm{\bar
{\zeta}}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda}\right)  e^{i\mathcal{A}%
\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda
}\mathbf{,}\tau\right)  } \label{approxpath}%
\end{equation}
where $\left\{  \mathrm{\zeta}_{\lambda}\right\}  $ are stationary, i.e.
classical, paths of $\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}%
\mathbf{,}\tau\right)  ,$ $\mathrm{z\in}\mathfrak{P}\left(  \mathbf{z}%
_{i},\mathbf{z}_{f},\tau\right)  ,$ and are thus stationary phases of the
exponent in the integral eq. $\left(  \ref{p1}\right)  $. Comparing eq.
$\left(  \ref{pathtay}\right)  $ and eq. $\left(  \ref{approxpath}\right)  $
one can observe that the prefactor term can be expressed as
\begin{equation}
K\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda
}\right)  =\int_{\mathfrak{P}_{0}\left(  \mathbf{z}_{i},\mathbf{z}_{f}%
,\tau\right)  }\exp\left\{  i\sum\limits_{2\leq j\leq\infty}\delta
^{j}\mathcal{A}\left(  \delta\mathrm{\bar{z}}_{\lambda},\delta\mathrm{z}%
_{\lambda}\right)  \right\}  d\mu\left(  \delta\mathrm{z}_{\lambda}\right)  ,
\label{kexp}%
\end{equation}
where we have split the domain of the integral eq. $\left(  \ref{pathtay}%
\right)  $ into a union of neighborhoods, $\mathfrak{P}_{0\lambda}\left(
\mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  $, about stationary points
$\left\{  \mathrm{\zeta}_{\lambda}\right\}  $ and hence into a sum of
integrals in terms of the incremental paths $\left\{  \delta\mathrm{z}%
_{\lambda}\right\}  $%
\begin{equation}
\delta\mathrm{z}_{\lambda}=\mathrm{z}-\mathrm{\zeta}_{\lambda};\quad
\mathrm{z}\in\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  ,
\end{equation}
and expansions about stationary points.

The second order term, $K^{\left(  2\right)  }\left(  \mathrm{\bar{\zeta}%
}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda}\right)  $, in the expansion eq.
$\left(  \ref{kexp}\right)  $ can be exactly evaluated as a Gaussian integral
to give \cite{Schulmann}
\begin{equation}
K^{\left(  2\right)  }\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}%
\mathrm{\zeta}_{\lambda}\right)  =\int_{\mathfrak{P}_{0\lambda}\left(
\mathbf{z}_{i},\mathbf{z}_{f},\tau\right)  }\exp\left\{  i\delta
_{\mathrm{\zeta}_{\lambda}}^{2}\mathcal{A}\left(  \delta\mathrm{\bar{z}%
}_{\lambda},\delta\mathrm{z}_{\lambda}\right)  \right\}  d\mu\left(
\delta\mathrm{z}_{\lambda}\right)  =\sqrt{\det\left(  i\frac{\partial
^{2}\mathcal{A}\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}\mathrm{\zeta
}_{\lambda}\mathbf{,}\tau\right)  }{\partial\mathbf{z}_{f}\partial
\mathbf{z}_{i}}\right)  },
\end{equation}
where the Hessian is with respect to \emph{variation} of the end points of the
paths, evaluated at the \emph{fixed} endpoints $\left\{  \mathbf{z}%
_{i},\mathbf{z}_{f}\right\}  $. In general it is not possible to obtain closed
expressions for higher order terms in eq. $\left(  \ref{kexp}\right)  $. The
Stationary Phase Approximation (SPA)\ to the path integral is defined to be
the quadratic approximation given by
\begin{equation}
\int_{\mathfrak{P}\left(  \mathbf{z}_{i},\mathbf{z}_{f},\tau\right)
}e^{i\mathcal{A}\left(  \mathrm{\bar{z}},\mathrm{z}\mathbf{,}\tau\right)
}d\mu\left(  \mathrm{z}\right)  \approx\sum_{\lambda}K^{\left(  2\right)
}\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda
}\right)  e^{i\mathcal{A}\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}%
\mathrm{\zeta}_{\lambda}\mathbf{,}\tau\right)  }%
\end{equation}
where
\begin{equation}
\delta\mathcal{A}\left(  \mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}%
\mathrm{\zeta}_{\lambda}\mathbf{,}\tau\right)  =0.
\end{equation}


In order to obtain the exact $N$-particle propagator one needs to express the
path integral over the manifold of $SU\left(  \mathcal{H}^{N}\right)
/U\left(  1\right)  $-CS's, $\left\{  \left\vert \Phi\left(  \mathbf{z}%
\right)  \right\rangle \right\}  $, that form the unit sphere
\begin{equation}
\left\Vert \left\vert \Psi\right\rangle \right\Vert =1
\end{equation}
in $\mathcal{H}^{N}$ $\left(  \text{see section }\ref{excs}\right)  $. Thus
the integral eq. $\left(  \ref{p1}\right)  $ ranges over all possible paths of
normalized vectors in $\mathcal{H}^{N}$ that begin at $\left\vert \Phi\left(
\mathbf{z}_{i}\right)  \right\rangle $ and end at $\left\vert \Phi\left(
\mathbf{z}_{f}\right)  \right\rangle $ with duration $\tau$. In terms of these
paths the functional $\mathcal{A}$ and the function $\mathcal{L}$ are
quadratic and the second order expansions are \emph{exact }thus making the SPA exact.

The SPA uses paths, with fixed end points $\mathrm{z}\left(  \tau\right)
=\mathbf{z}_{f},\mathrm{z}\left(  0\right)  =\mathbf{z}_{i},$ that satisfy the
stationary action condition $\delta\mathcal{A}\left(  \mathrm{\bar{\zeta}%
}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda}\mathbf{,}\tau\right)  =0$ given
by solutions to the generalized classical equation eq. $\left(  \ref{EOM}%
\right)  $ that can be expressed as
\begin{align}
-i\sum C_{jk}\frac{d\mathrm{z}_{k}}{dt}  &  =\frac{\partial\mathcal{E}%
}{\partial\mathrm{\bar{z}}_{j}}\\
i\sum\bar{C}_{jk}\frac{d\mathrm{\bar{z}}_{k}}{dt}  &  =\frac{\partial
\mathcal{E}}{\partial z_{j}}%
\end{align}
over the phase space formed by the manifold, $\mathcal{M}$, of states
$\left\{  \left\vert \Phi\left(  z\right)  \right\rangle \right\}  $ and are
evolution paths for the classical Hamiltonian $\mathcal{E}.$ If the Lagrangian
is quadratic the classical paths $\left\{  \mathrm{\zeta}_{\lambda}\right\}  $
produce an exact propagator
\begin{equation}
P\left(  \mathbf{z}_{f},\mathbf{z}_{i};\tau\right)  =\sum_{\lambda}\sqrt
{\det\left(  i\frac{\partial^{2}\mathcal{A}\left(  \mathrm{\bar{\zeta}%
}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda}\mathbf{,}\tau\right)  }%
{\partial\mathbf{z}_{f}\partial\mathbf{z}_{i}}\right)  }e^{i\mathcal{A}\left(
\mathrm{\bar{\zeta}}_{\lambda}\mathbf{,}\mathrm{\zeta}_{\lambda}\mathbf{,}%
\tau\right)  },
\end{equation}
otherwise truncating at second order produces an approximate propagator. One
should note that the degree of the Lagrangian is determined by the degree of
the classical Hamiltonian $\mathcal{E}.$

The SPA approximation can be improved by using a higher order approximations
to the classical Hamiltonian around stationary paths, produced by considering
more terms of the Taylor series. Clearly the nature of the manifold
$\mathcal{M}$ controls the nature and order properties of the series expansion
of $\mathcal{L}$, so determines the rate of convergence. When $\mathcal{M}$ is
the unit sphere in $\mathcal{H}^{N}$ the expansion is quadratic, while if
$\mathcal{M}$ is a smaller manifold the expansions are of higher degree and
the rate of convergence is determined by the nature of the states constituting
the manifold.

\section{Orthogonal Motion\label{orthogmotion}}

If the norm of the states $\left\vert \Phi\left(  \mathrm{z}\left(  t\right)
\right)  \right\rangle $ are constrained to be normalized i.e.
\begin{equation}
\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(
t\right)  \right)  =\left\langle \Phi\left(  \mathrm{z}\left(  t\right)
\right)  \mathbf{|}\Phi\left(  \mathrm{z}\left(  t\right)  \right)
\right\rangle =1\quad\forall t
\end{equation}
then
\begin{equation}
\frac{d}{dt}\left\langle \Phi\left(  \mathrm{z}\left(  t\right)  \right)
\mathbf{|}\Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle
=\left\langle \dot{\Phi}\left(  \mathrm{z}\left(  t\right)  \right)
\mathbf{|}\Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle
+\left\langle \Phi\left(  \mathrm{z}\left(  t\right)  \right)  \mathbf{|}%
\dot{\Phi}\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle =0,
\end{equation}
which gives in the case $U\left(  \mathcal{H}^{N}\right)  /U\left(  1\right)
$-CS's
\begin{equation}
\frac{d\mathrm{z}\left(  t\right)  }{dt}^{\dag}\mathrm{z}\left(  t\right)
+\mathrm{z}\left(  t\right)  ^{\dagger}\frac{d\mathrm{z}\left(  t\right)
}{dt}=\left(
\begin{array}
[c]{cc}%
\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt} & \frac{d\mathrm{z}\left(
t\right)  }{dt}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathrm{z}\left(  t\right) \\
\mathrm{\bar{z}}\left(  t\right)
\end{array}
\right)  =0. \label{orthog1}%
\end{equation}
A sufficient condition for this to hold is that
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \mathbf{P}_{\mathrm{z}\left(  t\right)  }\\
\mathbf{P}_{\mathrm{\bar{z}}\left(  t\right)  } & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  =0, \label{orthog2}%
\end{equation}
which of course is equivalent to
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \mathbf{P}_{\mathrm{z}\left(  t\right)  }^{\bot}\\
\mathbf{P}_{\mathrm{\bar{z}}\left(  t\right)  }^{\bot} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  . \label{orthog3}%
\end{equation}
The classical equations of motion eq. $\left(  \ref{EOM}\right)  $ for the
evolution of for $SU\left(  \mathcal{H}^{N}\right)  /U\left(  1\right)  $-CS's
is
\begin{equation}
\frac{1}{\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)  \mathrm{,z}%
\left(  t\right)  \right)  }\left(
\begin{array}
[c]{cc}%
\mathbf{0} & -i\mathbf{P}_{\mathrm{z}\left(  t\right)  }^{\bot}\\
i\mathbf{P}_{\mathrm{\bar{z}}\left(  t\right)  }^{\bot} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)
}{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)
}{\partial\mathbf{z}}%
\end{array}
\right)  , \label{EOM1}%
\end{equation}
which is equivalent to
\begin{equation}
\left(
\begin{array}
[c]{c}%
i\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
-i\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)
}{\partial\mathbf{z}}\\
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)
}{\partial\mathbf{\bar{z}}}%
\end{array}
\right)
\end{equation}
and eq. $\left(  \ref{orthog3}\right)  $ if
\begin{equation}
\mathrm{z}\left(  t\right)  ^{\dagger}\frac{\partial\mathcal{E}\left(
\mathrm{\bar{z},z}\mathbf{,}t\right)  }{\partial\mathbf{z}}=0\quad\forall t.
\label{orthog4}%
\end{equation}
The condition expressed in eq. $\left(  \ref{orthog4}\right)  $ is satisfied
as
\begin{align}
&  \left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)
}{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)
}{\partial\mathbf{z}}%
\end{array}
\right)  =\frac{1}{\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)
\mathrm{,z}\left(  t\right)  \right)  }\left(
\begin{array}
[c]{c}%
\left\{  \frac{\partial\mathcal{H}\left(  \mathrm{\bar{z},z}\mathbf{,}%
t\right)  }{\partial\mathbf{\bar{z}}}-\mathcal{E}\left(  \mathrm{\bar{z}%
,z}\mathbf{,}t\right)  \frac{\partial\mathcal{S}\left(  \mathrm{\bar{z}%
}\left(  t\right)  ,\mathrm{z}\left(  t\right)  \right)  }{\partial
\mathbf{\bar{z}}}\right\} \\
\left\{  \frac{\partial\mathcal{H}\left(  \mathrm{\bar{z},z}\mathbf{,}%
t\right)  }{\partial\mathbf{z}}-\mathcal{E}\left(  \mathrm{\bar{z}%
,z}\mathbf{,}t\right)  \frac{\partial\mathcal{S}\left(  \mathrm{\bar{z}%
}\left(  t\right)  ,\mathrm{z}\left(  t\right)  \right)  }{\partial\mathbf{z}%
}\right\}
\end{array}
\right) \nonumber\\
&  \qquad\qquad\qquad\left.  =\right.  \frac{1}{\mathcal{S}\left(
\mathrm{\bar{z}}\left(  t\right)  \mathrm{,z}\left(  t\right)  \right)
}\left(
\begin{array}
[c]{cc}%
\mathbb{O} & \mathbb{H}\left(  t\right)  -\mathcal{E}\left(  \mathrm{\bar
{z},z}\mathbf{,}t\right)  \mathbb{I}\\
\mathbb{\bar{H}}\left(  t\right)  -\mathcal{E}\left(  \mathrm{\bar{z}%
,z}\mathbf{,}t\right)  \mathbb{I} & \mathbb{O}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathrm{\bar{z}}\left(  t\right) \\
\mathrm{z}\left(  t\right)
\end{array}
\right)  ,
\end{align}
where the matrix $\mathbb{H}\left(  t\right)  $ is the time dependent full CI
matrix given by
\begin{equation}
H\left(  t\right)  _{KL}=\left\langle \Phi_{K}\mathbf{|}H\left(  t\right)
\Phi_{L}\right\rangle ,
\end{equation}
and hence
\begin{equation}
\mathrm{z}\left(  t\right)  ^{\dag}\left(  \mathbb{H}\left(  t\right)
-\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t\right)  \mathbb{I}\right)
\mathrm{z}\left(  t\right)  =0.
\end{equation}
%

\begin{align}
&  =-i\sum_{r,s}\int_{0}^{t}\left\{  \frac{\partial\mathcal{A}\left(
\mathbf{z}_{c},\mathbf{\bar{z}}_{c}\right)  }{\partial\mathbf{\bar{z}}%
}e^{-i\left(  D^{2}\mathcal{H}_{0}\left(  \mathbf{z}_{c},\mathbf{\bar{z}}%
_{c}\right)  -\mathcal{E}_{0}\left(  \mathbf{z}_{c},\mathbf{\bar{z}}%
_{c}\right)  D^{2}\mathcal{S}\left(  \mathbf{z}_{c},\mathbf{\bar{z}}%
_{c}\right)  \right)  t}\frac{\partial\rho_{sr}\left(  \mathbf{z}%
_{c},\mathbf{\bar{z}}_{c}\right)  }{\partial\mathbf{z}}\right. \\
&  \qquad\qquad\qquad\qquad\qquad\qquad\left.  -\frac{\partial\rho_{sr}\left(
\mathbf{z}_{c},\mathbf{\bar{z}}_{c}\right)  }{\partial\mathbf{\bar{z}}%
}e^{i\left(  D^{2}\mathcal{H}_{0}\left(  \mathbf{z}_{c},\mathbf{\bar{z}}%
_{c}\right)  -\mathcal{E}_{0}\left(  \mathbf{z}_{c},\mathbf{\bar{z}}%
_{c}\right)  D^{2}\mathcal{S}\left(  \mathbf{z}_{c},\mathbf{\bar{z}}%
_{c}\right)  \right)  t}\frac{\partial\mathcal{A}\left(  \mathbf{z}%
_{c},\mathbf{\bar{z}}_{c}\right)  }{\partial\mathbf{z}}\right\}  f_{rs}\left(
t^{\prime}\right)  dt^{\prime}.
\end{align}


\section{Velocity form of Tangent Vectors.\label{manifold}}

Let $\Phi^{-1}$ be a complex coordinate chart for the $\nu$-dimensional
manifold $\mathcal{M}$ i.e.
\begin{equation}
\Phi^{-1}:\mathcal{M}\rightarrow\mathbb{C}^{\nu}%
\end{equation}
and
\begin{equation}
\Phi:\mathbb{C}^{\nu}\rightarrow\mathcal{M}.
\end{equation}
Let $\mathcal{C}^{\infty}\left(  \mathcal{M}\right)  $ be the space of smooth
complex valued function, i.e. infinitely differentiable, defined on
$\mathcal{M}$ and $\Phi\left(  \mathrm{z}\left(  t\right)  \right)  $ be a
path in $\mathcal{M}$ i.e.%
\begin{equation}
\Phi\circ\mathrm{z}:\mathbb{R\rightarrow}\mathcal{M},
\end{equation}
where $\mathrm{z}\left(  t\right)  \in\mathbb{C}^{\nu}$. Two paths,
$\Phi\left(  \mathrm{z}_{1}\left(  t\right)  \right)  ,\Phi\left(
\mathrm{z}_{2}\left(  t\right)  \right)  $ that pass through the point
$\Phi\left(  \mathbf{z}_{0}\right)  $ at $t=0$ i.e. $\Phi\left(
\mathrm{z}_{1}\left(  0\right)  \right)  ,\Phi\left(  \mathrm{z}_{2}\left(
0\right)  \right)  =\Phi\left(  \mathbf{z}_{0}\right)  $ are tangent at this
point if the velocities of the corresponding $\mathbb{C}^{\nu}$ paths are
equal i.e.%
\begin{equation}
\frac{d\mathrm{z}_{1}\left(  0\right)  }{dt}=\frac{d\mathrm{z}_{2}\left(
0\right)  }{dt}. \label{equiv}%
\end{equation}
The set of all paths tangent at a point form an equivalence class and the set
of equivalence classes form a linear space called the tangent space
$\mathcal{T}_{\mathbf{z}_{0}}^{\left(  1,0\right)  }$ at the point
$\Phi\left(  \mathbf{z}_{0}\right)  $. A tangent vector, $X_{\mathrm{z}\left(
0\right)  }$, belonging to the tangent space $\mathcal{T}_{\mathbf{z}_{0}%
}^{\left(  1,0\right)  }$ acts on the space, $\mathcal{C}^{\infty}\left(
\mathcal{M}\right)  $, of infinitely differentiable complex value functions,
$f$, defined on $\mathcal{M}$ to produce
\begin{equation}
X_{\mathrm{z}\left(  0\right)  }\left(  f\right)  =\frac{df\left(  \Phi\left(
\mathrm{z}\left(  0\right)  \right)  \right)  }{dt}\equiv\frac{df\left(
\mathrm{z}\left(  0\right)  \right)  }{dt}\quad\forall f\in\mathcal{C}%
^{\infty}\left(  \mathcal{M}\right)  , \label{tanvect}%
\end{equation}
where $\mathbf{z}_{0}=\mathrm{z}\left(  t_{0}\right)  $ and $f\left(
\mathrm{z}\left(  t\right)  \right)  $ implicitly means $f\left(  \Phi\left(
\mathrm{z}\left(  t\right)  \right)  \right)  $. The path in eq. $\left(
\ref{tanvect}\right)  $ is a representative of the equivalence class produced
by the relationship eq. $\left(  \ref{equiv}\right)  .$ Eq. $\left(
\ref{tanvec}\right)  $ can be developed to give
\begin{equation}
X_{\mathrm{z}\left(  0\right)  }\left(  f\right)  =\frac{df\left(  \Phi\left(
\mathrm{z}\left(  0\right)  \right)  \right)  }{dt}=\sum_{1\leq j\leq v}%
\frac{\partial f\left(  \Phi\left(  \mathrm{z}\left(  0\right)  \right)
\right)  }{\partial z_{j}}\frac{d\mathrm{z}_{j}\left(  0\right)  }{dt}%
\quad\forall f\in\mathcal{C}^{\infty}\left(  \mathcal{M}\right)  ,
\label{tanvect1}%
\end{equation}
which gives
\begin{align}
X_{\mathrm{z}\left(  0\right)  }\left(  f\right)   &  =\sum_{1\leq j\leq
v}\frac{d\mathrm{z}_{j}\left(  0\right)  }{dt}\frac{\partial f\left(
\Phi\left(  \mathrm{z}\left(  0\right)  \right)  \right)  }{\partial z_{j}%
}\equiv\left\{  \sum_{1\leq j\leq v}\frac{d\mathrm{z}_{j}\left(  0\right)
}{dt}\frac{\partial}{\partial z_{j}}\right\}  f\left(  \Phi\left(
\mathrm{z}\left(  0\right)  \right)  \right) \nonumber\\
&  \equiv\left\{  \sum_{1\leq j\leq v}\frac{d\mathrm{z}_{j}\left(  0\right)
}{dt}\frac{\partial}{\partial z_{j}}\right\}  f\left(  \mathrm{z}\left(
0\right)  \right)  \quad\forall f\in\mathcal{C}^{\infty}\left(  \mathcal{M}%
\right)  \label{tanvect2}%
\end{align}
Eq. $\left(  \ref{tanvect2}\right)  $ shows that tangent vectors can also be
defined as%
\begin{equation}
X_{\mathbf{z}_{0}}=\sum_{1\leq j\leq v}\alpha_{j}\frac{\partial}{\partial
z_{j}}\qquad\alpha_{j}\in\mathbb{C},\quad1\leq j\leq\nu
\end{equation}
and act on $\mathcal{C}^{\infty}\left(  \mathcal{M}\right)  $ by
\begin{equation}
X_{\mathbf{z}_{0}}\left(  f\right)  =\left\{  \sum_{1\leq j\leq v}\alpha
_{j}\frac{\partial}{\partial z_{j}}\right\}  f\left(  \mathbf{z}_{0}\right)
\quad\forall f\in\mathcal{C}^{\infty}\left(  \mathcal{M}\right)  .
\end{equation}
If we let the basis of $\mathbb{C}^{\nu}$ be $\left\{  \left.  \mathbf{e}%
_{j}\right\vert 1\leq j\leq\nu\right\}  ,$ giving the expansion
\begin{equation}
\mathbf{z=}\sum_{1\leq j\leq\nu}z_{j}\mathbf{e}_{j},
\end{equation}
we can consider paths $\mathrm{e}_{j}\left(  t\right)  ,$ with coordinates
$\left\{  \mathrm{e}_{jk}\left(  t\right)  \right\}  $ defined as
\begin{equation}
\mathrm{e}_{j}\left(  t\right)  =\mathbf{z}_{0}+t\mathbf{e}_{j}=\left(
\mathrm{e}_{j1}\left(  t\right)  ,\cdots,\mathrm{e}_{jj}\left(  t\right)
,\cdots,\mathrm{e}_{j\nu}\left(  t\right)  \right)  =\left(  z_{01}%
,\cdots,z_{0j-1},z_{0j}+t,z_{0j+1},\cdots,z_{0\nu}\right)
\end{equation}
producing tangent vectors%
\begin{equation}
X_{\mathrm{e}_{j}\left(  0\right)  }\left(  f\right)  =\frac{df\left(
\Phi\left(  \mathrm{e}_{j}\left(  0\right)  \right)  \right)  }{dt}%
=\sum_{1\leq j\leq v}\frac{\partial f\left(  \Phi\left(  \mathbf{z}%
_{0}\right)  \right)  }{\partial z_{k}}\frac{d\mathrm{e}_{jk}\left(  0\right)
}{dt}=\frac{\partial f\left(  \mathbf{z}_{0}\right)  }{\partial z_{j}},
\label{bas1}%
\end{equation}
showing that tangent basis vectors can be expressed equivalently as%
\begin{equation}
X_{\mathrm{e}_{j}\left(  t_{0}\right)  }\equiv\frac{\partial}{\partial z_{j}%
}\qquad1\leq j\leq\nu.
\end{equation}
In particular eq. $\left(  \ref{bas1}\right)  $ must hold for linear functions
$l\in\mathcal{C}_{L}^{\infty}\left(  \mathcal{M}\right)  \subset
\mathcal{C}^{\infty}\left(  \mathcal{M}\right)  $ that belong to the cotangent
space $\mathcal{T}_{\mathbf{z}_{0}}^{\left(  1,0\right)  \ast}$ giving that
\begin{align}
&  X_{\mathrm{e}_{j}\left(  0\right)  }\left(  l\right)  =\left.
\frac{dl\left(  \Phi\left(  \mathrm{e}_{j}\left(  t\right)  \right)  \right)
}{dt}\right\vert _{t=0}=l\left(  \left.  \frac{d\Phi\left(  \mathrm{e}%
_{j}\left(  t\right)  \right)  }{dt}\right\vert _{t=0}\right)  \equiv l\left(
\frac{d\Phi\left(  \mathrm{e}_{j}\left(  0\right)  \right)  }{dt}\right)
\nonumber\\
&  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\right\vert \in\mathbb{C\quad\forall}l\in\mathcal{C}_{L}^{\infty
}\left(  \mathcal{M}\right)  ;1\leq j\leq\nu
\end{align}
and equivalently
\begin{equation}
\frac{\partial l\left(  \Phi\left(  \mathbf{z}_{0}\right)  \right)  }{\partial
z_{j}}=l\left(  \frac{\partial\Phi\left(  \mathbf{z}_{0}\right)  }{\partial
z_{j}}\right)  \in\mathbb{C\quad\forall}l\in\mathcal{C}_{L}^{\infty}\left(
\mathcal{M}\right)  ;1\leq j\leq\nu.
\end{equation}
Hence one can conclude that
\begin{equation}
\left\{  \left.  \frac{\partial\Phi\left(  \mathbf{z}_{0}\right)  }{\partial
z_{j}}\right\vert 1\leq j\leq\nu\right\}  \label{tanbas}%
\end{equation}
forms a basis for $\mathcal{T}_{\mathbf{z}_{0}}^{\left(  1,0\right)  }.$

The basis given in eq. $\left(  \ref{tanbas}\right)  $ allows one to consider
the tangent space $\mathcal{T}_{\mathbf{z}_{0}}^{\left(  1,0\right)  }$ in
terms of the differential, $d\Phi\left[  \mathbf{z}_{0}\right]  $, of the
inverse of the coordinate chart
\begin{equation}
\Phi:\mathbb{C}^{\nu}\rightarrow\mathcal{M}%
\end{equation}
at the point $\mathbf{z}_{0}\in\mathbb{C}^{\nu}$ which maps $\mathbb{C}^{\nu
}\rightarrow\mathcal{T}_{\mathbf{z}_{0}}$. The differential, $d\Phi\left[
\mathbf{z}_{0}\right]  $, maps any $\delta\mathbf{z\in}\mathbb{C}^{\nu}$ to
the tangent space $\mathcal{T}_{\mathbf{z}_{0}}^{\left(  1,0\right)  }$
producing
\begin{equation}
d\Phi\left[  \mathbf{z}_{0}\right]  \left(  \delta\mathbf{z}\right)
=\sum_{1\leq j\leq v}\frac{\partial\Phi\left(  \mathbf{z}_{0}\right)
}{\partial z_{j}}\delta z_{j}\quad\in\mathcal{T}_{\mathbf{z}_{0}}.
\end{equation}


\section{Solution to EOM\label{solution}}

The EOM in matrix form for paths on the manifold $\mathcal{M}$ is
\begin{equation}
\left(
\begin{array}
[c]{c}%
\overline{\mathrm{\dot{z}}}\left(  t\right) \\
\mathrm{\dot{z}}\left(  t\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \overline{\mathbf{C}\left(  \mathrm{\bar{z}}\left(  t\right)
,\mathrm{z}\left(  t\right)  \right)  }^{-1}\\
-i\mathbf{C}\left(  \mathrm{\bar{z}}\left(  t\right)  ,\mathrm{z}\left(
t\right)  \right)  ^{-1} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}_{0}\left(  \mathrm{\bar{z}}\left(  t\right)
,\mathrm{z}\left(  t\right)  \right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}_{0}\left(  \mathrm{\bar{z}}\left(  t\right)
,\mathrm{z}\left(  t\right)  \right)  }{\partial\mathbf{z}}%
\end{array}
\right)  .
\end{equation}
In general $\mathcal{E}_{0}$ can be expanded about a point $\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  $ as
\begin{equation}
\mathcal{E}_{0}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
+D^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  \left(  \mathbf{\bar{z}-\bar{\varsigma}}_{0},\mathbf{z-\varsigma
}_{0}\right)  +\frac{1}{2}D^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}%
}_{0},\mathbf{\varsigma}_{0}\right)  \left(  \mathbf{\bar{z}-\bar{\varsigma}%
}_{0},\mathbf{z-\varsigma}_{0}\right)  +\cdots, \label{enex}%
\end{equation}
where
\begin{equation}
D_{\mathbf{\varsigma}}^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  \left(  \mathbf{\bar{z}-\bar{\varsigma}%
}_{0},\mathbf{z-\varsigma}_{0}\right)  =\left(
\begin{array}
[c]{cc}%
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}} & \frac
{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\bar{z}-\bar{\varsigma}}_{0}\\
\mathbf{z-\varsigma}_{0}%
\end{array}
\right)
\end{equation}
and
\begin{equation}
D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  \left(  \mathbf{\bar{z}-\bar{z}}%
_{0},\mathbf{z-z}_{0}\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{\bar{z}-\bar{\varsigma}}_{0} & \mathbf{z-\varsigma}_{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\bar{z}-\bar{\varsigma}}_{0}\\
\mathbf{z-\varsigma}_{0}%
\end{array}
\right)  .
\end{equation}
If we truncate $\mathcal{E}_{0}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  $
in eq. $\left(  \ref{enex}\right)  $ at second order to form $\mathcal{E}%
_{L}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  $
\begin{equation}
\mathcal{E}_{L}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
+D_{\mathbf{\varsigma}}^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  \left(  \mathbf{\bar{z}-\bar{\varsigma}%
}_{0},\mathbf{z-\varsigma}_{0}\right)  +\frac{1}{2}D_{\mathbf{\varsigma}}%
^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  \left(  \mathbf{\bar{z}-\bar{\varsigma}}_{0},\mathbf{z-\varsigma
}_{0}\right)
\end{equation}
we obtain a linearized gradient
\begin{equation}
D_{\mathbf{z}}^{1}\mathcal{E}_{L}\left(  \mathbf{\bar{z}},\mathbf{z}\right)
=\left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\bar{z}-\bar{\varsigma}}_{0}\\
\mathbf{z-\varsigma}_{0}%
\end{array}
\right)  .
\end{equation}
Then the linear approximation to the EOM becomes
\begin{equation}
\left(
\begin{array}
[c]{c}%
\overline{\mathrm{\dot{z}}}_{L}\left(  t\right) \\
\mathrm{\dot{z}}_{L}\left(  t\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \overline{\mathbf{C}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }^{-1}\\
-i\mathbf{C}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  ^{-1} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}_{L}\left(  \mathrm{\bar{z}}_{L}\left(  t\right)
,\mathrm{z}_{L}\left(  t\right)  \right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}_{L}\left(  \mathrm{\bar{z}}_{L}\left(  t\right)
,\mathrm{z}_{L}\left(  t\right)  \right)  }{\partial\mathbf{z}}%
\end{array}
\right)
\end{equation}
giving the following equation for paths in the tangent space $\mathcal{T}%
_{\mathbf{\varsigma}_{0}}$
\begin{align}
\left(
\begin{array}
[c]{c}%
\overline{\mathrm{\dot{z}}}_{L}\left(  t\right) \\
\mathrm{\dot{z}}_{L}\left(  t\right)
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \overline{\mathbf{C}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }^{-1}\\
-i\mathbf{C}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  ^{-1} & \mathbf{0}%
\end{array}
\right)  \times\nonumber\\
&  \left\{  \left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  +\left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  \right\}  \left(
\begin{array}
[c]{c}%
\overline{\mathrm{z}}_{L}\left(  t\right)  \mathbf{-\bar{\varsigma}}_{0}\\
\mathrm{z}_{L}\left(  t\right)  \mathbf{-\varsigma}_{0}%
\end{array}
\right)
\end{align}
which we can abbreviate to
\begin{equation}
\mathrm{\dot{X}}\left(  t\right)  \equiv C^{-1}D_{\mathbf{\varsigma}}%
^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  +C^{-1}D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  \mathrm{X}\left(
t\right)  ,
\end{equation}
leading to
\begin{equation}
\mathrm{\dot{X}}\left(  t\right)  \equiv C^{-1}D_{\mathbf{\varsigma}}%
^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  \left\{  D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  ^{-1}%
D_{\mathbf{\varsigma}}^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  +\mathrm{X}\left(  t\right)  \right\}  .
\end{equation}
We can then make the substitution
\begin{equation}
\mathrm{Y}\left(  t\right)  =D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  ^{-1}%
D_{\mathbf{\varsigma}}^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  +\mathrm{X}\left(  t\right)
\end{equation}
obtaining
\begin{equation}
\mathrm{\dot{Y}}\left(  t\right)  =C^{-1}D_{\mathbf{\varsigma}}^{2}%
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  \mathrm{Y}\left(  t\right)
\end{equation}
which has the solution
\begin{equation}
\mathrm{Y}\left(  t\right)  =\left\{  \exp C^{-1}D_{\mathbf{\varsigma}}%
^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  t\right\}  \mathrm{Y}\left(  0\right)  .
\end{equation}
This gives
\begin{equation}
D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  ^{-1}D_{\mathbf{\varsigma}}^{1}%
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  +\mathrm{X}\left(  t\right)  =\left\{  \exp C^{-1}%
D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  t\right\}  \left\{  D_{\mathbf{\varsigma}%
}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  ^{-1}D_{\mathbf{\varsigma}}^{1}\mathcal{E}_{0}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  +\mathrm{X}\left(
0\right)  \right\}
\end{equation}
leading to
\begin{align}
\mathrm{X}\left(  t\right)   &  =\left\{  \exp C^{-1}D_{\mathbf{\varsigma}%
}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  t\right\}  \left\{  D_{\mathbf{\varsigma}}^{2}\mathcal{E}%
_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)
^{-1}D_{\mathbf{\varsigma}}^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}%
}_{0},\mathbf{\varsigma}_{0}\right)  +\mathrm{X}\left(  0\right)  \right\}
-D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  ^{-1}D_{\mathbf{\varsigma}}^{1}%
\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right) \nonumber\\
&  \equiv\left\{  \exp C^{-1}D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(
\mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  t\right\}
\left\{  \mathrm{X}\left(  0\right)  -X_{\min}\right\}  +X_{\min},
\end{align}
where
\begin{equation}
X_{\min}=-D_{\mathbf{\varsigma}}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  ^{-1}D_{\mathbf{\varsigma}%
}^{1}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)
\end{equation}
If we choose
\begin{equation}
\mathrm{X}\left(  0\right)  =\left(
\begin{array}
[c]{c}%
\overline{\mathrm{z}}_{L}\left(  0\right)  \mathbf{-\bar{\varsigma}}_{0}\\
\mathrm{z}_{L}\left(  0\right)  \mathbf{-\varsigma}_{0}%
\end{array}
\right)  =\mathbf{0,}%
\end{equation}
so that the initial point of the path $\mathrm{z}_{L}$ is $\mathbf{\varsigma
}_{0}$ i.e.
\begin{equation}
\left(
\begin{array}
[c]{c}%
\overline{\mathrm{z}}_{L}\left(  0\right) \\
\mathrm{z}_{L}\left(  0\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathbf{\bar{\varsigma}}_{0}\\
\mathbf{\varsigma}_{0}%
\end{array}
\right)  ,
\end{equation}
then this becomes
\begin{equation}
\mathrm{X}\left(  t\right)  =X_{\min}-\exp\left\{  C\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  ^{-1}D_{\mathbf{\varsigma}%
}^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma
}_{0}\right)  t\right\}  X_{\min}%
\end{equation}
and
\begin{align}
&  \left(
\begin{array}
[c]{c}%
\overline{\mathrm{z}}_{L}\left(  t\right) \\
\mathrm{z}_{L}\left(  t\right)
\end{array}
\right)  =\nonumber\\
&  \qquad\qquad\left\{  \exp\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \overline{\mathbf{C}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }^{-1}\\
-i\mathbf{C}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  ^{-1} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  t\right\} \nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\times\left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  ^{-1}\left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right) \nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad-\left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  ^{-1}\left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}_{0}%
,\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}}%
\end{array}
\right)  +\left(
\begin{array}
[c]{c}%
\mathbf{\bar{\varsigma}}_{0}\\
\mathbf{\varsigma}_{0}%
\end{array}
\right)  .
\end{align}
This shows that
\begin{align}
\mathrm{\dot{X}}\left(  t\right)   &  =\left(
\begin{array}
[c]{c}%
\overline{\mathrm{\dot{z}}}_{L}\left(  t\right)  \mathbf{-\bar{\varsigma}}%
_{0}\\
\mathrm{\dot{z}}_{L}\left(  t\right)  \mathbf{-\varsigma}_{0}%
\end{array}
\right)  =\mathbf{0}\\
&  \Rightarrow\left(
\begin{array}
[c]{c}%
\overline{\mathrm{\dot{z}}}_{L}\left(  t\right) \\
\mathrm{\dot{z}}_{L}\left(  t\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathbf{\bar{\varsigma}}_{0}\\
\mathbf{\varsigma}_{0}%
\end{array}
\right)
\end{align}
at a critical point $\left(
\begin{array}
[c]{c}%
\mathbf{\bar{\varsigma}}_{0}\\
\mathbf{\varsigma}_{0}%
\end{array}
\right)  $ of $\mathcal{E}_{0}.$

If $\left(
\begin{array}
[c]{c}%
\mathbf{\bar{\varsigma}}_{0}\\
\mathbf{\varsigma}_{0}%
\end{array}
\right)  $ is a critical point of $\mathcal{E}_{0}$ then
\begin{equation}
D_{\mathbf{z}}^{1}\mathcal{E}_{L}\left(  \mathbf{\bar{z}},\mathbf{z}\right)
=\left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\bar{z}-\bar{\varsigma}}_{0}\\
\mathbf{z-\varsigma}_{0}%
\end{array}
\right)
\end{equation}
and the linearized EOM\ for any classical observable becomes
\begin{align}
&  \left(
\begin{array}
[c]{c}%
\overline{\mathrm{\dot{O}}}_{L}\left(  t\right) \\
\mathrm{\dot{O}}_{L}\left(  t\right)
\end{array}
\right)  =\nonumber\\
&  \left(
\begin{array}
[c]{cc}%
\frac{\partial O}{\partial\mathbf{\bar{z}}} & \frac{\partial O}{\partial
\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{0} & \overline{\mathbf{C}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }^{-1}\\
-i\mathbf{C}\left(  \mathbf{\bar{\varsigma}}_{0},\mathbf{\varsigma}%
_{0}\right)  ^{-1} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{\bar{z}%
}\partial\mathbf{z}}\\
\frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar{\varsigma}}%
_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}\partial
\mathbf{\bar{z}}} & \frac{\partial^{2}\mathcal{E}_{0}\left(  \mathbf{\bar
{\varsigma}}_{0},\mathbf{\varsigma}_{0}\right)  }{\partial\mathbf{z}%
\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\overline{\mathrm{z}}_{L}\left(  t\right)  \mathbf{-\bar{\varsigma}}_{0}\\
\mathrm{z}_{L}\left(  t\right)  \mathbf{-\varsigma}_{0}%
\end{array}
\right)
\end{align}


\section{The Exact TDSE in CS form\label{CSTDSE}}

In order to facilitate a direct comparison of approximations to exact linear
response functions it is useful to derive the exact linear response function
in terms of coherent states based on the coset $SU\left(  \mathcal{H}%
^{N}\right)  /U\left(  1\right)  $. First we describe the TDSE in this
setting. In this case the overlap kernel, $\mathcal{S}\left(
\mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  $, and the classical Hamiltonian,
$\mathcal{E}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z},}t\right)  $, are
defined for an arbitrary quantum Hamiltonian $H\left(  t\right)  $ as%
\begin{align}
&  \mathcal{S}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)
=\left\langle \Phi\left(  \mathbf{z}\right)  \mathbf{|}\Phi\left(
\mathbf{z}\right)  \right\rangle =\sum_{1\leq K\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }\left\vert z_{k}\right\vert ^{2}\nonumber\\
&  \mathcal{E}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z},}t\right)
=\frac{\left\langle \Phi\left(  \mathbf{z}\right)  \mathbf{|}H\left(
t\right)  \Phi\left(  \mathbf{z}\right)  \right\rangle }{\left\langle
\Phi\left(  \mathbf{z}\right)  \mathbf{|}\Phi\left(  \mathbf{z}\right)
\right\rangle }=\frac{\sum_{1\leq k,l\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }\bar{z}_{k}z_{l}\left\langle \Phi_{k}\mathbf{|}H\left(  t\right)
\Phi_{l}\right\rangle }{\sum_{1\leq k\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }\left\vert z_{k}\right\vert ^{2}}\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\equiv\frac{\sum_{1\leq
k,l\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }\bar{z}_{k}z_{l}H_{kl}\left(  t\right)  }{\sum_{1\leq k\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }\left\vert z_{k}\right\vert ^{2}}%
\end{align}
and the K\"{a}hler metric matrix for this coset manifold is given by
\begin{align}
C_{kl}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)   &  =\frac
{\partial^{2}\ln\mathcal{S}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}%
}\right)  }{\partial\bar{z}_{k}\partial z_{l}}=\frac{1}{\mathcal{S}\left(
\mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  }\left\{  \frac{\partial
^{2}\mathcal{S}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  }%
{\partial\bar{z}_{k}\partial z_{l}}-\frac{1}{\mathcal{S}\left(
\mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  }\frac{\partial\mathcal{S}\left(
\mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  }{\partial\bar{z}_{k}}%
\frac{\partial\mathcal{S}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)
}{\partial z_{l}}\right\} \nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  =\right.
\frac{1}{\mathcal{S}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)
}\left\{  \delta_{kl}-\frac{z_{k}\bar{z}_{l}}{\mathcal{S}\left(
\mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  }\right\}  ,
\end{align}
which can be written as
\begin{equation}
\mathbf{C}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  =\frac
{1}{\mathcal{S}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  }\left\{
\mathbf{I-P}_{z}\right\}  =\frac{1}{\mathcal{S}\left(  \mathbf{\mathbf{\bar
{z}},\mathbf{z}}\right)  }\mathbf{P}_{z}^{\bot},
\end{equation}
where $\mathbf{P}_{z}$ is the orthogonal projector onto the vector
$\mathbf{z}\in\mathbb{C}^{\binom{r}{N}}$. Clearly this metric matrix is
singular, with a one dimensional kernel, and does not define a symplectic form
on the coset manifold, however it does define a non degenerate symplectic form
on the manifold that is perpendicular to $\mathbf{z}$. Evolutions determined
by the EOM eq. $\left(  \ref{EOM}\right)  $ constrained to this manifold
conserve the norm (see Appendix \ref{orthogmotion}) of states. Hence all
states on an evolution path are normalized if the initial state is normalized
i.e.
\begin{equation}
\mathcal{S}\left(  \mathrm{\bar{z}}\left(  t\right)  \mathbf{,}\mathrm{z}%
\left(  t\right)  \right)  =\mathcal{S}\left(  \mathrm{\bar{z}}\left(
0\right)  \mathbf{,}\mathrm{z}\left(  0\right)  \right)  =1.
\end{equation}
The Poisson Bracket corresponding to this constrained dynamics is defined by
the generalized inverse of the metric matrix resulting in the equations of
motion
\begin{equation}
\left(
\begin{array}
[c]{c}%
\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & i\mathbf{P}_{z}^{\bot}\\
-i\mathbf{P}_{\bar{z}}^{\bot} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{\partial\mathcal{E}\left(  \bar{z},z\mathbf{,}t\right)  }{\partial
\mathbf{\bar{z}}}\\
\frac{\partial\mathcal{E}\left(  \bar{z},z\mathbf{,}t\right)  }{\partial
\mathbf{z}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
-i\frac{\partial\mathcal{E}\left(  \bar{z},z\mathbf{,}t\right)  }%
{\partial\mathbf{z}}\\
i\frac{\partial\mathcal{E}\left(  \bar{z},z\mathbf{,}t\right)  }%
{\partial\mathbf{\bar{z}}}%
\end{array}
\right)  ,
\end{equation}
that become
\begin{equation}
\left(
\begin{array}
[c]{c}%
i\frac{d\mathrm{\bar{z}}\left(  t\right)  }{dt}\\
-i\frac{d\mathrm{z}\left(  t\right)  }{dt}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{O} & \mathbb{\bar{H}}\left(  t\right)  -\mathcal{E}\left(
\mathrm{\bar{z},z}\mathbf{,}t\right)  \mathbb{I}\\
\mathbb{H}\left(  t\right)  -\mathcal{E}\left(  \mathrm{\bar{z},z}%
\mathbf{,}t\right)  \mathbb{I} & \mathbb{O}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathrm{z}\left(  t\right) \\
\mathrm{\bar{z}}\left(  t\right)
\end{array}
\right)  . \label{TDCI}%
\end{equation}
The diagonal blocks of the Hessian $D^{2}\mathcal{E}\left(  \mathrm{\bar{z}%
,z}\mathbf{,}t\right)  $ are zero for case of $U\left(  \mathcal{H}%
^{N}\right)  /U\left(  1\right)  $-CS's and one observes that
\begin{equation}
\left(
\begin{array}
[c]{cc}%
D_{\mathbf{\bar{z}\bar{z}}}^{2}\mathcal{E}\left(  \mathrm{\bar{z},z}%
\mathbf{,}t\right)  & D_{\mathbf{\bar{z}z}}^{2}\mathcal{E}\left(
\mathrm{\bar{z},z}\mathbf{,}t\right) \\
D_{\mathbf{z\bar{z}}}^{2}\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}%
t\right)  & D_{\mathbf{zz}}^{2}\mathcal{E}\left(  \mathrm{\bar{z},z}%
\mathbf{,}t\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{0} & \mathbb{\bar{H}}\left(  t\right)  -\mathcal{E}\left(
\mathrm{\bar{z},z}\mathbf{,}t\right)  \mathbb{I}\\
\mathbb{H}\left(  t\right)  -\mathcal{E}\left(  \mathrm{\bar{z},z}%
\mathbf{,}t\right)  \mathbb{I} & \mathbf{0}%
\end{array}
\right)  ,
\end{equation}
but for other manifolds this is not in general true.

The formal solution of eq. $\left(  \ref{TDCI}\right)  $ is given by
\begin{equation}
\mathrm{z}\left(  t\right)  =Te^{-i\int_{0}^{t}\left\{  \mathbb{H}\left(
t^{\prime}\right)  -\mathcal{E}\left(  \mathrm{\bar{z},z}\mathbf{,}t^{\prime
}\right)  \mathbb{I}\right\}  dt^{\prime}}\mathrm{z}\left(  0\right)  ,
\label{sol}%
\end{equation}
where $T$ is the time ordering operator. However, the time dependent
CI\ coefficients vector, $\mathrm{z}\left(  t\right)  $, given by eq. $\left(
\ref{sol}\right)  $ that determines the state
\begin{equation}
\left\vert \Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle
=\sum_{j}\mathrm{z}_{j}\left(  t\right)  \left\vert \Psi_{j}\right\rangle ,
\end{equation}
where $\left\{  \left\vert \Psi_{j}\right\rangle \right\}  $ is a fixed
orthonormal basis of $\mathcal{H}^{N}$, is \emph{not }a solution of the TDSE.
In order to produce a solution one must multiply the CI coefficients, and thus
the state, by a time dependent phase to obtain coefficients
\begin{equation}
\mathrm{\eta}\left(  t\right)  =e^{-i\int_{0}^{t}\mathcal{E}\left(  \bar
{z},z\mathbf{,}t\right)  dt^{\prime}}\mathrm{z}\left(  t\right)
\label{statvec}%
\end{equation}
and state
\begin{equation}
\left\vert \Psi\left(  \mathrm{\eta}\left(  t\right)  \right)  \right\rangle
=e^{-i\int_{0}^{t}\mathcal{E}\left(  \bar{z},z\mathbf{,}t\right)  dt^{\prime}%
}\left\vert \Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle .
\label{stat_state}%
\end{equation}
From eq. $\left(  \ref{sol}\right)  $ one can see that
\begin{equation}
\left\vert \Psi\left(  \mathrm{\eta}\left(  t\right)  \right)  \right\rangle
=e^{-i\int_{0}^{t}\mathcal{E}\left(  \bar{z},z\mathbf{,}t\right)  dt^{\prime}%
}\left\vert \Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle
=Te^{-i\int_{0}^{t}H\left(  t^{\prime}\right)  dt^{\prime}}\left\vert
\Phi\left(  \mathrm{z}\left(  0\right)  \right)  \right\rangle ,
\end{equation}
\ showing that%
\begin{equation}
\sigma\left(  t\right)  =\int_{0}^{t}\mathcal{E}\left(  \mathrm{\bar{z}%
,z}\mathbf{,}t\right)  dt^{\prime}%
\end{equation}
is the solution to the time dependent phase equation eq. $\left(
\ref{phase}\right)  .$

The initial state, $\left\vert \Phi\left(  \mathrm{z}\left(  0\right)
\right)  \right\rangle $, is usually chosen to be a stationary state,
$\left\vert \Psi_{0}\right\rangle $, of the unperturbed time independent
Hamiltonian $H_{0}$, which correspond to a critical point $\mathbf{z}_{c}$ of
$\mathcal{E}_{0}\left(  \mathbf{\mathbf{\bar{z}},\mathbf{z}}\right)  $ as
\begin{equation}
\frac{d\mathrm{z}_{0}\left(  t\right)  }{dt}=0\Rightarrow\mathrm{z}_{0}\left(
t\right)  =\mathbf{\mathbf{z}}_{c}\forall t
\end{equation}
and hence
\begin{equation}
\frac{d\mathrm{z}_{0}\left(  t\right)  }{dt}=0\Leftrightarrow D^{1}%
\mathcal{E}_{0}\left(  \mathbf{\mathbf{\bar{z}}}_{c}\mathbf{,\mathbf{z}}%
_{c}\right)  =0.
\end{equation}
This leads to
\begin{equation}
\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{O} & \mathbb{\bar{H}}_{0}-\mathcal{E}\left(  \mathbf{\mathbf{\bar{z}}%
}_{c}\mathbf{,\mathbf{z}}_{c}\right)  \mathbb{I}\\
\mathbb{H}_{0}-\mathcal{E}\left(  \mathbf{\mathbf{\bar{z}}}_{c}%
\mathbf{,\mathbf{z}}_{c}\right)  \mathbb{I} & \mathbb{O}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathbf{\mathbf{z}}_{c}\\
\mathbf{\mathbf{\bar{z}}}_{c}%
\end{array}
\right)
\end{equation}
which displays that $\mathbf{\mathbf{z}}_{c}$ is an eigenvector of
$\mathbb{H}_{0}$ and $\left\vert \Phi\left(  \mathbf{z}_{c}\right)
\right\rangle $ an eigenstate of $H_{0}$.

It is interesting to observe that the actual stationary state CI\ coefficients
and stationary state that satisfy the TDSE are given from eqs. $\left(
\ref{statvec}\right)  $ and $\left(  \ref{stat_state}\right)  $ as
\begin{equation}
\mathrm{\eta}_{0}\left(  t\right)  =e^{-i\mathcal{E}\left(
\mathbf{\mathbf{\bar{z}}}_{c}\mathbf{,\mathbf{z}}_{c}\right)  t}%
\mathbf{\mathbf{z}}_{c}%
\end{equation}
and
\begin{equation}
\left\vert \Psi\left(  \mathrm{\eta}_{0}\left(  t\right)  \right)
\right\rangle =e^{-i\mathcal{E}\left(  \mathbf{\mathbf{\bar{z}}}%
_{c}\mathbf{,\mathbf{z}}_{c}\right)  t}\left\vert \Phi\left(
\mathbf{\mathbf{z}}_{c}\right)  \right\rangle
\end{equation}
respectively.

\section{Linear Response for the Exact TDSE\label{fulllinres}}

In order to obtain the linear response of stationary states of $H_{0}$ to a
time dependent external field $F\left(  t\right)  $ one considers terms up to
first order in $F\left(  t\right)  $%
\begin{equation}
\left\vert \Phi\left(  \mathrm{z}\left(  t\right)  \right)  \right\rangle
=Te^{-i\int_{0}^{t}H\left(  t^{\prime}\right)  dt^{\prime}}\left\vert
\Phi\left(  \mathrm{z}\left(  0\right)  \right)  \right\rangle \simeq
e^{-iH_{0}t}\left\{  1-i\int_{0}^{t}F\left(  t^{\prime}\right)  dt^{\prime
}\right\}  \left\vert \Phi\left(  \mathrm{z}\left(  0\right)  \right)
\right\rangle ,
\end{equation}
where
\begin{equation}
H\left(  t\right)  =H_{0}+F\left(  t\right)
\end{equation}
and the initial state is a stationary state, $\left\vert \Psi_{0}\right\rangle
$, of $H_{0}$
\begin{equation}
\left\vert \Psi_{0}\right\rangle =\left\vert \Phi\left(  \mathrm{z}\left(
0\right)  \right)  \right\rangle =\left\vert \Phi\left(  \mathrm{z}_{0}\left(
0\right)  \right)  \right\rangle =\left\vert \Phi\left(  \mathbf{z}%
_{c}\right)  \right\rangle .
\end{equation}


In the CS\ setting the expectation values of quantum observables, $A$,
correspond to classical observables, $\mathcal{A}$ defined on the phase space
$\mathcal{M}$ and for $SU\left(  \mathcal{H}^{N}\right)  /U\left(  1\right)
$-CS's they have the form
\begin{equation}
\mathcal{A}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\frac{\left\langle
\left.  \Phi\left(  \mathbf{z}\right)  \right\vert A\left(  t\right)
\Phi\left(  \mathbf{z}\right)  \right\rangle }{\left\langle \left.
\Phi\left(  \mathbf{z}\right)  \right\vert \Phi\left(  \mathbf{z}\right)
\right\rangle }=\frac{\sum_{1\leq k,l\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }z_{k}\bar{z}_{l}A_{lk}}{\sum_{1\leq k\leq\left(
%TCIMACRO{\QATOP{r}{N}}%
%BeginExpansion
\genfrac{}{}{0pt}{}{r}{N}%
%EndExpansion
\right)  }\left\vert z_{k}\right\vert ^{2}}=\frac{\mathbf{z}^{\dagger
}\mathbb{A}\mathbf{z}}{\mathbf{z}^{\dagger}\mathbf{z}}.
\end{equation}
The linear response of the expectation value of an operator $A$ from its value
in the stationary state $\left\vert \Psi_{0}\right\rangle $ is given by eq.
$\left(  \ref{res}\right)  $ in the Hilbert space setting and in terms of the
approximate CS\ parameter path given by first order perturbation theory as
\begin{equation}
\mathrm{\xi}\left(  t\right)  \simeq e^{-i\mathbb{H}_{0}t}\left\{  1-i\int
_{0}^{t}\mathbb{F}_{H}\left(  t^{\prime}\right)  dt^{\prime}\right\}
\mathbf{z}_{c}%
\end{equation}
where
\begin{equation}
\mathbb{F}_{H}\left(  t^{\prime}\right)  =e^{i\mathbb{H}_{o}t^{\prime}%
}\mathbb{F}\left(  t^{\prime}\right)  e^{-i\mathbb{H}_{o}t^{\prime}}.
\end{equation}
After one substitutes eq. $\left(  \ref{linpath}\right)  $ into eq. $\left(
\ref{qsym}\right)  $, noting that the denominator of eq. $\left(
\ref{qsym}\right)  $ is constant up to first order in $F$, one can deduce that
the evolution of a classical observable, $\mathcal{A}$, is determined up to
first order in $F$ around the point $\left(  \mathbf{\bar{z}}_{c}%
,\mathbf{z}_{c}\right)  $ by
\begin{align}
&  \mathcal{A}\left(  \mathrm{\bar{\xi}}\left(  t\right)  ,\mathrm{\xi}\left(
t\right)  \right)  \approx\frac{\mathbf{z}_{c}^{\dagger}e^{i\mathbb{H}_{0}%
t}\mathbb{A}e^{-i\mathbb{H}_{0}t}\mathbf{z}_{c}}{\mathbf{z}_{c}^{\dagger
}\mathbf{z}_{c}}-\nonumber\\
&  \qquad\qquad\qquad i\frac{1}{\mathbf{z}_{c}^{\dagger}\mathbf{z}_{c}%
}\mathbf{z}_{c}^{\dagger}\left\{  e^{i\mathbb{H}_{0}t}\mathbb{A}%
e^{-i\mathbb{H}_{0}t}\int_{0}^{t}\mathbb{F}_{H}\left(  t^{\prime}\right)
dt^{\prime}-\int_{0}^{t}\mathbb{F}_{H}\left(  t^{\prime}\right)  dt^{\prime
}e^{i\mathbb{H}_{0}t}\mathbb{A}e^{-i\mathbb{H}_{0}t}\right\}  \mathbf{z}_{c}.
\end{align}
Eq. $\left(  \ref{forder}\right)  $ directly shows that the linear response of
the observable $\mathcal{A}$ is
\begin{align}
\delta^{1}\mathcal{A}\left(  \mathbf{\bar{z}}_{c},\mathbf{z}_{c},t\right)   &
=\frac{1}{\mathbf{z}_{c}^{\dagger}\mathbf{z}_{c}}\mathbf{z}_{c}^{\dagger
}\left\{  -i\int_{0}^{t}\left[  e^{i\mathbb{H}_{0}t}\mathbb{A}e^{-i\mathbb{H}%
_{0}t},\mathbb{F}_{H}\left(  t^{\prime}\right)  \right]  dt^{\prime}\right\}
\mathbf{z}_{c}\nonumber\\
&  =\frac{1}{\mathbf{z}_{c}^{\dagger}\mathbf{z}_{c}}\left\{  -i\sum_{r,s}%
\int_{0}^{t}\left\{  \mathbf{z}_{c}^{\dagger}\left[  e^{i\mathbb{H}_{0}%
t}\mathbb{A}e^{-i\mathbb{H}_{0}t},e^{i\mathbb{H}_{0}t^{\prime}}\mathbf{a}%
_{r}^{\dagger}\mathbf{a}_{s}e^{-i\mathbb{H}_{0}t^{\prime}}\right]
\mathbf{z}_{c}\right\}  f_{rs}\left(  t^{\prime}\right)  dt^{\prime}\right\}
.
\end{align}
Noticing that $e^{-i\mathbb{H}_{0}t}\mathbf{z}_{c}=e^{-iE_{0}t}\mathbf{z}_{c}$
eq. $\left(  \ref{lr}\right)  $ leads to
\begin{align}
&  \delta^{1}\mathcal{A}\left(  \mathbf{\bar{z}}_{c},\mathbf{z}_{c},t\right)
=\nonumber\\
&  \frac{1}{\mathbf{z}_{c}^{\dagger}\mathbf{z}_{c}}\left\{  -i\sum_{r,s}%
\int_{0}^{t}\left\{  \mathbf{z}_{c}^{\dagger}e^{i\mathbb{H}_{0}\left(
t-t^{\prime}\right)  }\mathbb{A}e^{-i\mathbb{H}_{0}\left(  t-t^{\prime
}\right)  }\mathbf{a}_{r}^{\dagger}\mathbf{a}_{s}\mathbf{z}_{c}-\mathbf{z}%
_{c}^{\dagger}\mathbf{a}_{r}^{\dagger}\mathbf{a}_{s}e^{i\mathbb{H}_{0}\left(
t-t^{\prime}\right)  }\mathbb{A}e^{-i\mathbb{H}_{0}\left(  t-t^{\prime
}\right)  }\mathbf{z}_{c}\right\}  f_{rs}\left(  t^{\prime}\right)
dt^{\prime}\right\}  ,
\end{align}
where $\mathbf{a}_{r}^{\dagger}\mathbf{a}_{s}$ is the matrix given by
\begin{equation}
\left(  \mathbf{a}_{r}^{\dagger}\mathbf{a}_{s}\right)  _{kl}=\left\langle
\Phi_{k}\mathbf{|}a_{r}^{\dagger}a_{s}\Phi_{l}\right\rangle
\end{equation}
and its expectation value wrt $\mathbf{z}_{c}$ is the $\left(  s,r\right)  $
matrix elements of the FORDM\ of the state $\left\vert \Phi\left(
\mathbf{z}_{c}\right)  \right\rangle $ i.e.
\begin{equation}
\rho_{sr}\left(  \mathbf{\bar{z}}_{c},\mathbf{z}_{c}\right)  =\mathbf{z}%
_{c}^{\dagger}\left(  \mathbf{a}_{r}^{\dagger}\mathbf{a}_{s}\right)
\mathbf{z}_{c}.
\end{equation}
The linear response expression eq. $\left(  \ref{resclass}\right)  $ can
succinctly written as
\begin{equation}
\delta^{1}\mathcal{A}\left(  \mathbf{\bar{z}}_{c},\mathbf{z}_{c},t\right)
=\frac{-i}{\mathbf{z}_{c}^{\dagger}\mathbf{z}_{c}}\int_{0}^{t}\mathbf{z}%
_{c}^{\dagger}\left[  \mathbb{A}_{H}\left(  t-t^{\prime}\right)
,\mathbb{F}\left(  t^{\prime}\right)  \right]  \mathbf{z}_{c}dt^{\prime
}=-i\int_{0}^{t}\frac{\left\langle \left.  \Phi\left(  \mathbf{z}_{c}\right)
\right\vert \left[  A_{H}\left(  t-t^{\prime}\right)  ,F\left(  t^{\prime
}\right)  \right]  \Phi\left(  \mathbf{z}_{c}\right)  \right\rangle
}{\left\langle \left.  \Phi\left(  \mathbf{z}_{c}\right)  \right\vert
\Phi\left(  \mathbf{z}_{c}\right)  \right\rangle }dt^{\prime},
\end{equation}
where
\begin{equation}
\mathbb{F}\left(  t^{\prime}\right)  =\sum_{r,s}\mathbf{a}_{r}^{\dagger
}\mathbf{a}_{s}f_{rs}\left(  t^{\prime}\right)
\end{equation}
which should be compared to eq. $\left(  \ref{resquant}\right)  .$ Recognizing
that the derivatives of a classical observable $\mathcal{X}$ defined by eq.
$\left(  \ref{qsym}\right)  $ are given by
\begin{align}
\frac{\partial\mathcal{X}\left(  \mathbf{\bar{z}},\mathbf{z}\right)
}{\partial\mathbf{\bar{z}}}  &  =\frac{1}{\mathbf{z}^{\dagger}\mathbf{z}%
}\left\{  \mathbb{X}-\mathcal{X}\left(  \mathbf{\bar{z},z}\right)
\mathbb{I}\right\}  \mathbf{z}\nonumber\\
\frac{\partial\mathcal{X}\left(  \mathbf{\bar{z}},\mathbf{z}\right)
}{\partial\mathbf{z}}  &  =\frac{1}{\mathbf{z}^{\dagger}\mathbf{z}}\left\{
\overline{\mathbb{X}}-\mathcal{X}\left(  \mathbf{\bar{z},z}\right)
\mathbb{I}\right\}  \mathbf{\bar{z}}%
\end{align}
and that the matrix $\mathbb{X}$ is hermitian one can establish that the terms
involving $\mathcal{X}\left(  \mathbf{\bar{z},z}\right)  \mathbb{I}$ cancel
out and obtain that the linear response of the classical observable
$\mathcal{A}$ about the point $\left(  \mathbf{\bar{z}}_{c},\mathbf{z}%
_{c}\right)  $ is
\begin{align}
&  \delta^{1}\mathcal{A}\left(  \mathbf{\bar{z}}_{c},\mathbf{z}_{c},t\right)
=\nonumber\\
&  -i\sum_{r,s}\int_{0}^{t}\left\{  \frac{\partial\mathcal{A}_{H}\left(
\mathbf{\bar{z}}_{c},\mathbf{z}_{c},t-t^{\prime}\right)  }{\partial
\mathbf{\bar{z}}}\frac{\partial\rho_{sr}\left(  \mathbf{\bar{z}}%
_{c},\mathbf{z}_{c}\right)  }{\partial\mathbf{z}}-\frac{\partial\rho
_{sr}\left(  \mathbf{\bar{z}}_{c},\mathbf{z}_{c}\right)  }{\partial
\mathbf{\bar{z}}}\frac{\partial\mathcal{A}_{H}\left(  \mathbf{\bar{z}}%
_{c},\mathbf{z}_{c},t-t^{\prime}\right)  }{\partial\mathbf{z}}\right\}
f_{rs}\left(  t^{\prime}\right)  dt^{\prime}.
\end{align}
The expression in eq. $\left(  \ref{reaA}\right)  $ can be formulated in terms
of the Poisson bracket induced by the K\"{a}hler metric for the $SU\left(
\mathcal{H}^{N}\right)  /U\left(  1\right)  $ CS-manifold, after noting that
\begin{equation}
\mathbf{z}^{\dagger}\left\{  \mathbb{X}\left(  t\right)  -\mathcal{X}\left(
t\right)  \right\}  \mathbf{z=z}^{\dagger}\mathbb{X}\left(  t\right)
\mathbf{z}-\mathcal{X}\left(  t\right)  \mathbf{z}^{\dagger}\mathbf{z}%
=\mathcal{X}\left(  t\right)  \mathbf{z}^{\dagger}\mathbf{z-}\mathcal{X}%
\left(  t\right)  \mathbf{z}^{\dagger}\mathbf{z=0,}%
\end{equation}
which shows that $\mathbf{z}$ is always orthogonal to $\left\{  \mathbb{X}%
\left(  t\right)  -\mathcal{X}\left(  t\right)  \right\}  \mathbf{z}$ and
hence
\begin{equation}
\mathbf{P}_{\mathbf{z}}^{\bot}\left\{  \mathbb{X}\left(  t\right)
-\mathcal{X}\left(  t\right)  \right\}  \mathbf{z=}\left\{  \mathbb{X}\left(
t\right)  -\mathcal{X}\left(  t\right)  \right\}  \mathbf{z,}%
\end{equation}
as
\begin{equation}
\delta^{1}\mathcal{A}\left(  t\right)  =-\sum_{r,s}\int_{0}^{t}\left\{
\mathcal{A}_{H}\left(  t-t^{\prime}\right)  ,\rho_{sr}\right\}  f_{rs}\left(
t^{\prime}\right)  dt^{\prime}=-\sum_{r,s}\int_{-\infty}^{\infty}\theta
_{+}\left(  t-t^{\prime}\right)  \left\{  \mathcal{A}_{H}\left(  t-t^{\prime
}\right)  ,\rho_{sr}\right\}  f_{rs}\left(  t^{\prime}\right)  dt^{\prime},
\end{equation}
where
\begin{equation}
\mathcal{A}_{H}\left(  \mathbf{\bar{z},z,}\tau\right)  =\frac{\left\langle
\left.  \Phi\left(  \mathbf{z}\right)  \right\vert A_{H}\left(  \tau\right)
\Phi\left(  \mathbf{z}\right)  \right\rangle }{\left\langle \left.
\Phi\left(  \mathbf{z}\right)  \right\vert \Phi\left(  \mathbf{z}\right)
\right\rangle }=\frac{\left\langle \left.  \Phi\left(  \mathrm{z}_{0}\left(
\tau\right)  \right)  \right\vert A\Phi\left(  \mathrm{z}_{0}\left(
\tau\right)  \right)  \right\rangle }{\left\langle \left.  \Phi\left(
\mathbf{z}\right)  \right\vert \Phi\left(  \mathbf{z}\right)  \right\rangle }.
\end{equation}
We have thus reformulated the definition of the response function from eq.
$\left(  \ref{resdef}\right)  $ in terms of classical observables as
\begin{equation}
R_{Ars}\left(  \tau\right)  =\theta_{+}\left(  \tau\right)  \left\{
\mathcal{A}_{H}\left(  \tau\right)  ,\rho_{sr}\left(  0\right)  \right\}  .
\end{equation}
and obtain eq. $\left(  \ref{res}\right)  $ in the form
\begin{equation}
\delta^{1}\mathcal{A}\left(  t\right)  =\sum_{k,l}\int_{-\infty}^{\infty
}R_{Ars}\left(  t-t^{\prime}\right)  f_{rs}\left(  t^{\prime}\right)
dt^{\prime}.
\end{equation}
In particular the response of any one particle expectation value can be
expressed in terms of the response of the FORDM $\mathbf{\rho}\left(
0\right)  $ given by
\begin{equation}
\delta^{1}\rho_{ji}\left(  t\right)  =\sum_{k,l}\int_{-\infty}^{\infty
}R_{ijrs}\left(  t-t^{\prime}\right)  f_{rs}\left(  t^{\prime}\right)
dt^{\prime},
\end{equation}
where
\begin{align}
R_{ijrs}\left(  \tau\right)   &  =\theta_{+}\left(  \tau\right)  \left\{
\rho_{jiH}\left(  \tau\right)  ,\rho_{sr}\left(  0\right)  \right\}
\nonumber\\
&  =\theta_{+}\left(  \tau\right)  \left(
\begin{array}
[c]{cc}%
\frac{\partial\rho\left(  \mathrm{z}_{0}\left(  \tau\right)  ,\mathrm{\bar{z}%
}_{0}\left(  \tau\right)  \right)  _{ji}}{\partial\mathbf{\bar{z}}} &
\frac{\partial\rho\left(  \mathrm{z}_{0}\left(  \tau\right)  ,\mathrm{\bar{z}%
}_{0}\left(  \tau\right)  \right)  _{ji}}{\partial\mathbf{z}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbf{0} & i\mathbf{P}_{\mathrm{z}_{0}\left(  0\right)  }^{\bot}\\
-i\mathbf{P}_{\mathrm{\bar{z}}_{0}\left(  0\right)  }^{\bot} & \mathbf{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\frac{\partial\rho\left(  \mathrm{z}_{0}\left(  0\right)  ,\mathrm{\bar{z}%
}_{0}\left(  0\right)  \right)  _{sr}}{\partial\mathbf{\bar{z}}}\\
\frac{\partial\rho\left(  \mathrm{z}_{0}\left(  0\right)  ,\mathrm{\bar{z}%
}_{0}\left(  0\right)  \right)  _{sr}}{\partial\mathbf{z}}%
\end{array}
\right)
\end{align}


\section{Different Time Poisson Brackets\label{DifTPB}}

Kramer and Saraceno \cite{KS} show that if the operators $O_{1}$ and $O_{2}$
belong to the representation, $\mathcal{R}_{\mathcal{H}^{N}}\left(
\mathcal{G}\right)  $, of the Lie algebra, $\mathcal{G}$, of $G$ on the
Hilbert space $\mathcal{H}^{N}$, i.e.
\begin{equation}
O_{k}=\sum_{1\leq j\leq\nu}\alpha_{kj}X_{j};\qquad k=1,2
\end{equation}
and
\begin{equation}
\exp\left\{  \sum_{1\leq j\leq\nu}\alpha_{kj}X_{j}\right\}  \in\mathcal{R}%
_{\mathcal{H}^{N}}\left(  G\right)
\end{equation}
then
\begin{equation}
\left\{  \mathcal{O}_{1},\mathcal{O}_{2}\right\}  _{\mathbf{z}}=\frac
{\left\langle \left.  \Phi\left(  \mathbf{z}\right)  \right\vert \left[
O_{1},O_{2}\right]  \Phi\left(  \mathbf{z}\right)  \right\rangle
}{\left\langle \left.  \Phi\left(  \mathbf{z}\right)  \right\vert \Phi\left(
\mathbf{z}\right)  \right\rangle },
\end{equation}
where
\begin{equation}
\exp\left\{  \sum_{1\leq j\leq\nu}\alpha_{kj}Q_{j}\right\}  \in\mathcal{R}%
_{\mathcal{H}^{N}}\left(  G/K\right)
\end{equation}
and
\begin{equation}
\left\vert \Phi\left(  \mathbf{z}\right)  \right\rangle =\exp\left\{
\sum_{1\leq j\leq\nu}z_{j}Q_{j}\right\}  \left\vert \Phi_{ref}\right\rangle .
\end{equation}
This relationship can be made time dependent by
\begin{equation}
\left\{  \mathcal{O}_{1}\left(  t_{1}\right)  ,\mathcal{O}_{2}\left(
t_{2}\right)  \right\}  _{\mathbf{z}}=\frac{\left\langle \left.  \Phi\left(
\mathbf{z}\right)  \right\vert \left[  O_{1}\left(  t_{1}\right)
,O_{2}\left(  t_{2}\right)  \right]  \Phi\left(  \mathbf{z}\right)
\right\rangle }{\left\langle \left.  \Phi\left(  \mathbf{z}\right)
\right\vert \Phi\left(  \mathbf{z}\right)  \right\rangle },
\end{equation}
where $O_{1}\left(  t_{1}\right)  $ and $O_{2}\left(  t_{2}\right)  $ belong
to $\mathcal{R}_{\mathcal{H}^{N}}\left(  \mathcal{G}\right)  .$ If we consider
a linear time evolution given by
\begin{equation}
O_{k}\left(  t_{k}\right)  =e^{iht_{k}}O_{k}e^{-iht_{k}}\quad\in
\mathcal{R}_{\mathcal{H}^{N}}\left(  \mathcal{G}\right)  .
\end{equation}
expression eq. $\left(  \ref{tdbra}\right)  $ can be developed to give
\begin{align}
&  \left\{  \mathcal{O}_{1}\left(  t_{1}\right)  ,\mathcal{O}_{2}\left(
t_{2}\right)  \right\}  _{\mathbf{z}}=\frac{\left\langle \left.  \Phi\left(
\mathbf{z}\right)  \right\vert \left\{  e^{iht_{1}}O_{1}e^{-ih\left(
t_{1}-t_{2}\right)  }O_{2}e^{-iht_{2}}-e^{iht_{2}}O_{2}e^{ih\left(
t_{1}-t_{2}\right)  }O_{1}e^{-iht_{1}}\right\}  \Phi\left(  \mathbf{z}\right)
\right\rangle }{\left\langle \left.  \Phi\left(  \mathbf{z}\right)
\right\vert \Phi\left(  \mathbf{z}\right)  \right\rangle }\nonumber\\
&  =\frac{\left\langle \left.  e^{-iht_{2}}\Phi\left(  \mathbf{z}\right)
\right\vert \left\{  e^{ih\left(  t_{1}-t_{2}\right)  }O_{1}e^{-ih\left(
t_{1}-t_{2}\right)  }O_{2}e^{-iht_{2}}-e^{-iht_{2}}O_{2}e^{ih\left(
t_{1}-t_{2}\right)  }O_{1}e^{-ih\left(  t_{1}-t_{2}\right)  }\right\}
e^{-iht_{2}}\Phi\left(  \mathbf{z}\right)  \right\rangle }{\left\langle
\left.  \Phi\left(  \mathbf{z}\right)  \right\vert \Phi\left(  \mathbf{z}%
\right)  \right\rangle }\nonumber\\
&  =\frac{\left\langle \left.  e^{-iht_{2}}\Phi\left(  \mathbf{z}\right)
\right\vert \left[  O_{1}\left(  t_{1}-t_{2}\right)  ,O_{2}\right]
e^{-iht_{2}}\Phi\left(  \mathbf{z}\right)  \right\rangle }{\left\langle
\left.  \Phi\left(  \mathbf{z}\right)  \right\vert \Phi\left(  \mathbf{z}%
\right)  \right\rangle }=\frac{\left\langle \left.  \Phi\left(  \mathrm{\chi
}\left(  t_{2}\right)  \right)  \right\vert \left[  O_{1}\left(  t_{1}%
-t_{2}\right)  ,O_{2}\right]  \Phi\left(  \mathrm{\chi}\left(  t_{2}\right)
\right)  \right\rangle }{\left\langle \left.  \Phi\left(  \mathbf{z}\right)
\right\vert \Phi\left(  \mathbf{z}\right)  \right\rangle }\nonumber\\
&  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad\qquad\qquad\qquad\right.  =\left\{  \mathcal{O}_{1}\left(  t_{1}%
-t_{2}\right)  ,\mathcal{O}_{2}\right\}  _{\mathbf{z}},
\end{align}
where
\begin{equation}
\exp\left\{  \sum_{1\leq j\leq\nu}\mathrm{\chi}_{j}\left(  t\right)
Q_{j}\right\}  \left\vert \Phi_{ref}\right\rangle =e^{-iht}\exp\left\{
\sum_{1\leq j\leq\nu}z_{j}Q_{j}\right\}  \left\vert \Phi_{ref}\right\rangle
\end{equation}
and
\begin{equation}
\left\langle \left.  \Phi\left(  \mathrm{\chi}\left(  t\right)  \right)
\right\vert \Phi\left(  \mathrm{\chi}\left(  t\right)  \right)  \right\rangle
=\left\langle \left.  \Phi\left(  \mathbf{z}\right)  \right\vert \Phi\left(
\mathbf{z}\right)  \right\rangle \quad\forall t.
\end{equation}


