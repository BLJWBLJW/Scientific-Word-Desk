where

\begin{enumerate}
\item
\begin{equation}
\hat{O}_{\left(  2\right)  }=\frac{1}{4}\sum_{1\leq j<k\leq r}O_{jkjk}\left(
\overset{}{I_{\mathcal{H}_{\mathcal{F}}}+i\left(  x_{j}x _{2j}+x _{k}%
x_{k+r}\right)  -x_{j}x_{j+r}x _{k}x_{k+r}}\right)  .
\end{equation}


\item
\begin{align}
&  \hat{O}_{\left(  3\right)  }=\frac{1}{8}\sum_{j\neq k\neq l}O_{jkjl}\left(
\overset{}{x_{j}x_{l}+x_{j+r}x_{l+r}+i\left(  x_{j}x_{l+r}-x_{j+r}%
x_{l}\right)  }\right. \\
&  \hspace{2in}+\left.  \overset{}{x_{j+r}x_{l}x _{k}x_{k+r}-x_{j}x_{l+r}x
_{k}x_{k+r}+i\left(  x_{j+r}x_{l+r}x _{k}x_{k+r}+x_{j}x _{2l-1}x _{k}%
x_{k+r}\right)  }\right)  .
\end{align}


\item
\begin{align}
&  \hat{O}_{\left(  4\right)  }=\frac{1}{16}\sum_{i\neq j\neq k\neq l}%
O_{ijkl}\left(
\begin{array}
[c]{c}%
\overset{}{x_{j}x_{j}x _{k}x_{l}+x _{2i-1}x_{j}x_{k+r}x_{l+r}-x_{j}x_{j+r}x
_{k}x_{l+r}+x_{j}x_{j+r}x_{k+r}x_{l}}\\
+x_{j+r}x_{j}x _{k}x_{l+r}-x_{j+r}x _{2j-1}x_{k+r}x_{l}+x_{j+r}x_{j+r}x
_{k}x_{l}+x_{j+r}x_{j+r}x_{k+r}x_{l+r}%
\end{array}
\right. \\
&  \qquad\quad\quad+\left.  i\left(
\begin{array}
[c]{c}%
x_{j}x_{j+r}x _{k}x_{l}+x_{j}x _{2j}x_{k+r}x_{l+r}-x_{j+r}x_{j}x _{k}x
_{2l-1}+x_{j}x_{j}x _{k}x_{l+r}\\
-x_{j}x_{j}x_{k+r}x_{l}+\overset{}{x _{2i}x_{j}x_{k+r}x_{l+r}+x_{j+r}x_{j+r}x
_{k}x_{l+r}-x_{j+r}x_{j+r}x_{k+r}x_{l}}%
\end{array}
\right)  \right)  ,\hspace{2in}.
\end{align}

\end{enumerate}
\end{remark}

\begin{remark}
The terms of similar degree can be collected together to give
\begin{gather}
\hat{O}\\
\parallel\\
\frac{1}{4}\sum_{1\leq j<k\leq r}O_{jkjk}I_{\mathcal{H}_{\mathcal{F}}}\\
+
\end{gather}%
\begin{gather}
\frac{1}{4}\sum_{1\leq j<k\leq r}O_{jkjk}i\left(  \overset{}{x _{2j-1}%
x_{j+r}+x _{k}x_{k+r}}\right)  +\frac{1}{8}\sum_{j\neq k\neq l}O_{jkjl}\left(
\overset{}{x_{j}x_{l}+x _{2j}x_{l+r}+i\left(  x_{j}x_{l+r}-x_{j+r}x
_{2l-1}\right)  }\right) \\
+
\end{gather}%
\begin{gather}
-\frac{1}{4}\sum_{1\leq j<k\leq r}O_{jkjk}x_{j}x_{j+r}x _{k}x_{k+r}+\frac
{1}{8}\sum_{j\neq k\neq l}O_{jkjl}\left(  \overset{}{x_{j+r}x_{l}x _{k}%
x_{k+r}-x _{2j-1}x_{l+r}x _{k}x_{k+r}+i\left(  x_{j}x _{2l-1}x _{k}%
x_{k+r}+x_{j+r}x_{l+r}x _{k}x _{2k}\right)  }\right) \\
+
\end{gather}%
\begin{gather}
\frac{1}{16}\sum_{i\neq j\neq k\neq l}O_{ijkl}\left(
\begin{array}
[c]{c}%
\overset{}{x_{j}x_{j}x _{k}x_{l}+x _{2i-1}x_{j}x_{k+r}x_{l+r}}-x_{j}x_{j+r}x
_{k}x_{l+r}+x_{j}x_{j+r}x_{k+r}x_{l}\\
+x_{j+r}x_{j}x _{k}x_{l+r}-x_{j+r}x _{2j-1}x_{k+r}x_{l}+x_{j+r}x_{j+r}x
_{k}x_{l}+x_{j+r}x_{j+r}x_{k+r}x_{l+r}%
\end{array}
\right. \\
\hspace{2in}+\left.  \overset{}{%
\begin{array}
[c]{c}%
+\left(  \overset{}{ix_{j}x_{j+r}x_{k+r}x_{l+r}-ix_{j+r}x_{j}x _{k}%
x_{l}+ix_{j}x_{j}x _{k}x_{l+r}-ix_{j}x_{j}x _{2k}x_{l}}\right. \\
+\left.  i\overset{}{\left(  x_{j}x_{j+r}x _{k}x_{l}+x_{j+r}x_{j}%
x_{k+r}x_{l+r}+x_{j+r}x_{j+r}x _{k}x_{l+r}-x_{j+r}x_{j+r}x_{k+r}x_{l}\right)
}\right)
\end{array}
}\right)  .
\end{gather}

\end{remark}

\begin{enumerate}
\item
\begin{equation}
\frac{1}{4}\sum_{1\leq j<k\leq r}O_{jkjk}I_{\mathcal{H}_{\mathcal{F}}}%
=\frac{1}{8}\operatorname*{Tr}\left(  \widehat{O}\right)
\end{equation}


\item
\begin{equation}
\frac{i}{4}\sum_{\left(  j,k\right)  \in\mathfrak{I}_{3}^{4}}O_{jkjk}\left(
\overset{}{x_{j}x_{j+r}+x _{k}x_{k+r}}\right)  =\frac{i}{2}\sum_{\left(
j,k\right)  \in\mathfrak{I}_{3}^{4}}O_{jkjk}x_{j}x_{j+r}%
\end{equation}


\item
\begin{align}
&  \frac{1}{8}\sum_{\left(  j,k,l\right)  \in\mathfrak{I}_{3}^{4}}\left\{
\overset{}{O_{jkjl}x_{j}x_{l}+O_{jkjl}x_{j+r}x _{l+r}+i\left(  O_{jkjl}%
x_{j}x_{l+r}-O_{jkjl}x_{j+r}x_{l}\right)  }\right\} \\
&  =\frac{1}{8}\sum_{\left(  j,k,l\right)  \in\mathfrak{I}_{3}^{4}}\left\{
\overset{}{O_{jkjl}x_{j}x_{l}+O_{jkjl}x_{j+r}x _{l+r}+i\left(  O_{jkjl}%
x_{j}x_{l+r}-O_{jkjl}x_{j+r}x_{l}\right)  }\right\}
\end{align}


\item
\begin{gather}
\frac{1}{16}\sum_{\left(  i,j,k,l\right)  \in\mathfrak{I}_{4}^{4}}%
O_{ijkl}\left\{  \overset{}{\left(  x_{j}x_{j}x _{k}x_{l}+x_{j}x_{j}%
x_{k+r}x_{l+r}-x_{j}x_{j+r}x _{k}x_{l+r}+x_{j}x _{2j}x_{k+r}x_{l}\right.
}\right. \\
+\left.  \overset{}{x_{j+r}x_{j}x _{k}x_{l+r}-x_{j+r}x_{j}x_{k+r}x_{l}%
x_{j+r}x_{j+r}x _{k}x_{l}+x_{j+r}x_{j+r}x_{k+r}x_{l+r}}\right)  \quad\quad\\
+i\left(  \overset{}{x_{j}x_{j}x _{k}x_{l+r}-x_{j}x_{j}x_{k+r}x_{l}+x_{j}x
_{2j}x _{k}x_{l}+x_{j}x_{j+r}x_{k+r}x _{l+r}}\right. \\
\hspace{2in}+\left.  \overset{}{\left.  x_{j+r}x_{j}x _{2k}-x_{j+r}x_{j}x
_{k}x_{l}++x_{l+r}x_{j+r}x_{j+r}x _{k}-x_{j+r}x_{j+r}x_{k+r}x_{l}\right)
}\right\}  .
\end{gather}

\end{enumerate}

\subsection*{3. Expansion in Majorana Operators}

Substituting $a_{j}, a_{j}^{\dagger}$ in terms of $x_{i}$, we expand $\hat{O}$
into products of up to four Majorana operators, grouped by degree:

\subsubsection*{Degree 0 (Constant Term)}%

\[
CI_{\mathcal{H}_{\mathcal{F}}}=\operatorname*{Tr}(\hat{O})I_{\mathcal{H}%
_{\mathcal{F}}}=\frac{1}{2^{r}}\operatorname*{Tr}(\hat{O})I_{\mathcal{H}%
_{\mathcal{F}}}=\frac{1}{8}\sum_{i,j}O_{ijji}I_{\mathcal{H}_{\mathcal{F}}%
}\quad\text{(as previously derived)}.
\]


\subsubsection*{Degree 2 (Quadratic Terms)}

After full antisymmetrization and index relabeling:
\begin{equation}
\hat{O}_{2}=\sum_{j<k}\alpha_{jk}x_{j}x_{k},
\end{equation}
where
\[
\alpha_{jk}=\frac{1}{4}\sum_{r,s}%
\begin{cases}
\;\,\operatorname*{Re}(O_{jrsk}-O_{jsrk}) & \text{if }j=2m-1,k=2n-1\\
\;\,\operatorname*{Re}(O_{jrsk}+O_{jsrk}) & \text{if }j=2m,k=2n\\
-i\operatorname*{Im}(O_{jrsk}-O_{jsrk}) & \text{if }j=2m-1,k=2n\\
+i\operatorname*{Im}(O_{jrsk}+O_{jsrk}) & \text{if }j=2m,k=2n-1
\end{cases}
.
\]


\subsubsection*{Degree 4 (Quartic Terms)}

Fully uncontracted products of four Majorana operators:
\[
\hat{O}_{4}=\sum_{i<j<k<l}\beta_{ijkl}\,x_{i}x_{j}x_{k}x_{l},
\]
where the coefficients $\beta_{ijkl}$ are given by the fully antisymmetrized
expression becomes:
\[
\beta_{ijkl}=\frac{1}{16}\sum_{\substack{\sigma\in S_{4}\\\text{distinct
}i,j,k,l}}\text{sgn}(\sigma)\tilde{O}_{\sigma(p)\sigma(q)\sigma(r)\sigma(s)},
\]
where $\tilde{O}_{pqrs}$ maps fermionic indices to Majorana indices:
\[
\tilde{O}_{pqrs}=%
\begin{cases}
\;\,O_{pqrs} & \text{even }x\text{-parity}\\
-iO_{pqrs} & \text{odd }x\text{-parity}%
\end{cases}
\]
The quartic coefficient $\beta_{ijkl}$ in the Majorana expansion is given by
the fully antisymmetrized combination:%

\[
\beta_{ijkl}=\frac{1}{16}\sum_{\sigma\in S_{4}}\text{sgn}(\sigma)\tilde
{O}_{\sigma(p)\sigma(q)\sigma(r)\sigma(s)}%
\]


where:

\begin{itemize}
\item $S_{4}$ is the symmetric group of all permutations of 4 elements

\item $\text{sgn}(\sigma)$ is the sign of the permutation ($+1$ for even, $-1$
for odd)

\item The indices $(i,j,k,l)$ correspond to the Majorana operator ordering

\item $(p,q,r,s)$ are the original fermionic mode indices mapped to
$(2p-1,2p,2q-1,2q)$.
\end{itemize}

This represents the sum over all 24 possible permutations of the four indices
with appropriate sign factors.

\subsection*{4. Final Majorana Expansion}

\begin{remark}
The expansion of two particle operators in terms of the corresponding Majorana
operators can organized into homogeneous terms of zeroth, second and fourth
degree, but these terms are \textbf{not} linearly independent.
\end{remark}

Combining all terms, the operator $\hat{O}$ becomes:
\[
\hat{O} = \sum_{i < j} \alpha_{ij} \, x_{i} x_{j} + \sum_{i < j < k < l}
\beta_{ijkl} \, x_{i} x_{j} x_{k} x_{l}.
\]


\subsection*{5. Key Observations}

\begin{itemize}
\item Quadratic terms ($\alpha_{ij}$) depend on off-diagonal elements of
$O_{ijkl}$.

\item Quartic terms ($\beta_{ijkl}$) are fully antisymmetrized four-Majorana
interactions.Consistency Checks
\end{itemize}

\begin{enumerate}
\item \textbf{Antisymmetry Preservation}: All coefficients satisfy:
\[
\alpha_{pq} = -\alpha_{qp}, \quad\beta_{ijkl} = \text{totally antisymmetric}.
\]


\item \textbf{Trace Conditions}:
\[
\text{Tr}(x_{i}x_{j}) = 0, \quad\text{Tr}(x_{i}x_{j}x_{k}x_{l}) = 0
\quad\Rightarrow\quad\text{Tr}(\hat{O}) = 2^{N} C.
\]


\item \textbf{Example: Hubbard Interaction}: For $U\sum_{i}n_{i\uparrow
}n_{i\downarrow}$:
\[
C=\frac{UN}{8},\quad\alpha_{2i-1,2i}=\frac{U}{4},\quad\text{other }%
\alpha,\beta=0.
\]

\end{enumerate}


