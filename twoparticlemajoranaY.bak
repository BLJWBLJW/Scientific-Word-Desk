\section{Majorana Expansion of a Two-Particle Operator}

\subsection*{1. Majorana Operator Basis}

\begin{enumerate}
\item The Majorana operators $\left\{  x_{j},1\leq j\leq2r\right\}  $ are
hermitian and satisfy the Clifford algebra relationships
\[
\{x_{j},x_{k}\}=2\delta_{jk}I_{\mathcal{H}_{\mathcal{F}}},\quad1\leq j,k\leq2r
\]
hence one obtains the normalization
\begin{equation}
x_{j}^{2}=I_{\mathcal{H}_{\mathcal{F}}},\quad1\leq j\leq2r
\end{equation}
and antisymmetry
\begin{equation}
x_{j}x_{k}=-x_{k}x_{j},\quad1\leq j,k\leq2r.
\end{equation}
For a system with $r$ fermionic modes, $2r$ Majorana operators are define in
terms of creation $\left\{  a_{j}^{\dagger},1\leq j\leq r\right\}  $ and
annihilation $\left\{  a_{j},1\leq j\leq r\right\}  $ operators:
\[
x_{j}=a_{j}+a_{j}^{\dagger},\quad x_{j+r}=-i(a_{j}-a_{j}^{\dagger}),\quad1\leq
j\leq r
\]
giving
\begin{equation}
\left(  \boldsymbol{x}\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}\\
\boldsymbol{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
i\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{a}^{\dagger}\\
\boldsymbol{a}%
\end{array}
\right)  .
\end{equation}


\item The inverse relations are:
\[
a_{j}=\frac{1}{2}(x_{j}+ix_{j+r}),\quad a_{j}^{\dagger}=\frac{1}{2}%
(x_{j}-ix_{j+r})
\]
giving
\begin{equation}
\left(  \boldsymbol{a}^{\dagger},\boldsymbol{a}\right)  \equiv\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{c}%
\boldsymbol{a}^{\dagger}\\
\boldsymbol{a}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & -i\mathbb{I}_{r}\\
\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}\\
\boldsymbol{x}_{2}%
\end{array}
\right)  .
\end{equation}


\item
\begin{align}
\left\{  a_{j}^{\dagger},a_{j}\right\}    & =\left\{  \frac{1}{2}%
(x_{j}-ix_{j+r}),\frac{1}{2}(x_{j}+ix_{j+r})\right\}  \\
& =\frac{1}{4}\left(  (x_{j}-ix_{j+r})(x_{j}+ix_{j+r})+(x_{j}+ix_{j+r}%
)(x_{j}-ix_{j+r})\right)  \\
& =\frac{1}{4}\left(  x_{j}x_{j}+ix_{j}x_{j+r}-ix_{j+r}x_{j}+x_{j+r}%
x_{j+r}+x_{j}x_{j}-ix_{j}x_{j+r}+ix_{j+r}x_{j}+x_{j+r}x_{j+r}\right)  \\
& =\frac{1}{4}\left(  I_{\mathcal{H}_{\mathcal{F}}}+ix_{j}x_{j+r}%
-ix_{j+r}x_{j}+I_{\mathcal{H}_{\mathcal{F}}}+I_{\mathcal{H}_{\mathcal{F}}%
}-ix_{j}x_{j+r}+ix_{j+r}x_{j}+I_{\mathcal{H}_{\mathcal{F}}}\right)  \\
& =I_{\mathcal{H}_{\mathcal{F}}}.
\end{align}


\item
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{y}_{1} & \boldsymbol{y}_{2}%
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)
\end{equation}%
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\boldsymbol{y}_{1} & \boldsymbol{y}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)
\end{equation}%
\begin{equation}
\left(  \boldsymbol{y}\right)  =\frac{1}{\sqrt{2}}\left(  \boldsymbol{x}%
\right)
\end{equation}


\item In particular
\begin{align}
\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{0}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}\\
-i\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \\
\left(
\begin{array}
[c]{c}%
\boldsymbol{a}\\
\boldsymbol{0}%
\end{array}
\right)   &  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{O} & \mathbb{O}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}\\
\boldsymbol{x}_{2}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}+i\boldsymbol{x}_{2}\\
\boldsymbol{0}%
\end{array}
\right)  .
\end{align}


\item This gives one particle particle conserving operators in super vector
form as
\begin{align}
\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{a}\\
\boldsymbol{0}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{1}+i\boldsymbol{x}_{2}\\
\boldsymbol{0}%
\end{array}
\right)  =\frac{1}{4}\left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)
\left(  \boldsymbol{x}_{1}+i\boldsymbol{x}_{2}\right)  \\
&  =\frac{1}{4}\left(  \boldsymbol{x}_{1}\boldsymbol{x}_{1}+i\boldsymbol{x}%
_{1}\boldsymbol{x}_{2}-i\boldsymbol{x}_{2}\boldsymbol{x}_{1}+\boldsymbol{x}%
_{2}\boldsymbol{x}_{2}\right)  =\frac{1}{4}\left(  \boldsymbol{x}%
_{1}\boldsymbol{x}_{1}+\boldsymbol{x}_{2}\boldsymbol{x}_{2}+i\left(
\boldsymbol{x}_{1}\boldsymbol{x}_{2}-\boldsymbol{x}_{2}\boldsymbol{x}%
_{1}\right)  \right)
\end{align}
giving the following expression for individual operators
\begin{equation}
a_{j}^{\dagger}a_{k}=\frac{1}{4}\left(  x_{j}x_{k}+ix_{j}x_{k+r}-ix_{j+r}%
x_{k}+x_{j+r}x_{k+r}\right)  =\frac{1}{4}\left(  x_{j}x_{k}+x_{j+r}%
x_{k+r}+i\left(  x_{j}x_{k+r}-x_{j+r}x_{k}\right)  \right)  ,\quad1\leq
j,k\leq r.
\end{equation}

\end{enumerate}

\begin{notation}


\begin{enumerate}
\item
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
a_{1} & \cdots & a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
b_{1}\\
\vdots\\
b_{r}%
\end{array}
\right)  \equiv\left(
\begin{array}
[c]{ccc}%
a_{1} & \cdots & a_{r}%
\end{array}
\right)  \cdot\left(
\begin{array}
[c]{c}%
b_{1}\\
\vdots\\
b_{r}%
\end{array}
\right)  =\sum_{1\leq j\leq r}a_{j}b_{j}%
\end{equation}


\item
\begin{equation}
\left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
b_{1} & \cdots & b_{r}%
\end{array}
\right)  \equiv\left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{ccc}%
b_{1} & \cdots & b_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
a_{1}b_{1} & \cdots & a_{1}b_{r}\\
\vdots & \ddots & \vdots\\
a_{r}b_{1} & \cdots & a_{r}b_{r}%
\end{array}
\right)
\end{equation}


\item
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
a_{1} & \cdots & a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
b_{1} & \cdots & b_{r}%
\end{array}
\right)  \equiv\left(
\begin{array}
[c]{ccc}%
a_{1} & \cdots & a_{r}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{ccc}%
b_{1} & \cdots & b_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\left(
\begin{array}
[c]{ccc}%
a_{1}b_{1} & \cdots & a_{1}b_{r}%
\end{array}
\right)   & \cdots & \left(
\begin{array}
[c]{ccc}%
a_{r}b_{1} & \cdots & a_{r}b_{r}%
\end{array}
\right)
\end{array}
\right)
\end{equation}


\item
\begin{equation}
\left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
b_{1}\\
\vdots\\
b_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \otimes\left(
\begin{array}
[c]{c}%
b_{1}\\
\vdots\\
b_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\left(
\begin{array}
[c]{c}%
a_{1}b_{1}\\
\vdots\\
a_{1}b_{r}%
\end{array}
\right)  \\
\vdots\\
\left(
\begin{array}
[c]{c}%
a_{r}b_{1}\\
\vdots\\
a_{r}b_{r}%
\end{array}
\right)
\end{array}
\right)
\end{equation}

\end{enumerate}
\end{notation}

This gives two particle conserving operators in super vector form as%
\begin{align}
&  \left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}^{\dagger}\boldsymbol{aa}%
\right)  =\left(  \boldsymbol{a}^{\dagger}\right)  \left(  \boldsymbol{a}%
^{\dagger}\right)  \left(  \boldsymbol{a}\right)  \left(  \boldsymbol{a}%
\right)  =\left(  \left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger} & \cdots & a_{r}^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger} & \cdots & a_{r}^{\dagger}%
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \right)  \\
&  =\frac{1}{16}\left(  \left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1}-i\boldsymbol{x}_{2} & \boldsymbol{0}%
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{3}+i\boldsymbol{x}_{4}\\
\boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{x}_{3}+i\boldsymbol{x}_{4}\\
\boldsymbol{0}%
\end{array}
\right)  \right)  \\
&  =\frac{1}{16}\left(  \left(
\begin{array}
[c]{cccc}%
\left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)  \left(  \boldsymbol{x}%
_{1}-i\boldsymbol{x}_{2}\right)   & \boldsymbol{0} & \boldsymbol{0} &
\boldsymbol{0}%
\end{array}
\right)  \right)  \left(
\begin{array}
[c]{c}%
\left(  \boldsymbol{x}_{3}+i\boldsymbol{x}_{4}\right)  \left(  \boldsymbol{x}%
_{3}+i\boldsymbol{x}_{4}\right)  \\
\boldsymbol{0}\\
\boldsymbol{0}\\
\boldsymbol{0}%
\end{array}
\right)  \\
&  =\frac{1}{16}\left(  \left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)
\left(  \boldsymbol{x}_{1}-i\boldsymbol{x}_{2}\right)  \left(  \boldsymbol{x}%
_{3}+i\boldsymbol{x}_{4}\right)  \left(  \boldsymbol{x}_{3}+i\boldsymbol{x}%
_{4}\right)  \right)
\end{align}
giving the following expression for individual operators
\begin{align*}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m} &  =\frac{1}{16}(x_{j}-ix_{j+r}%
)(x_{k}-ix_{k})(x_{l}+ix_{l})(x_{m}+ix_{m+r}),\\
\quad1 &  \leq j<k\leq r,\quad1\leq l<m\leq r
\end{align*}
that number
\begin{equation}
\binom{r}{2}^{2}=\frac{r^{2}}{4}\left(  r-1\right)  ^{2}=\frac{1}{4}\left(
r^{4}-2r^{3}+r^{2}\right)  .
\end{equation}
In particular these operators can be classified into:

\begin{enumerate}
\item
\begin{enumerate}
\item Operators that can be described by two unequal subscripts
\begin{gather*}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}=n_{j}n_{k}=\frac{1}{2}\left(
I_{\mathcal{H}_{\mathcal{F}}}+ix_{j}x_{j+r}\right)  \frac{1}{2}\left(
I_{\mathcal{H}_{\mathcal{F}}}+ix_{k}x_{k+r}\right)  \\
\parallel\\
\frac{1}{4}\left(  I_{\mathcal{H}_{\mathcal{F}}}+ix_{j}x_{j+r}+ix_{k}%
x_{k+r}-x_{j}x_{j+r}x_{k}x_{k+r}\right)  ,
\end{gather*}
that number
\begin{equation}
\binom{r}{2}=\frac{r}{2}\left(  r-1\right)  =\frac{r\left(  r-1\right)
}{\left(  1\right)  \left(  2\right)  }.
\end{equation}
In the case $r=4$ the subscripts are
\begin{equation}
1212,1313,1414,2323,2424,3434.
\end{equation}


\item Operators that can be described by three unequal subscripts%
\begin{gather}
a_{j}^{\dagger}a_{l}a_{k}^{\dagger}a_{k}=a_{j}^{\dagger}a_{l}n_{k}=n_{k}%
a_{j}^{\dagger}a_{l}\\
\parallel\\
\frac{1}{8}\left\{  \overset{}{x_{j}x_{l}+ix_{j}x_{l+r}-ix_{j+r}x_{l}%
+x_{j+r}x_{l+r}}+\overset{}{ix_{j}x_{l}x_{k}x_{k+r}-x_{j}x_{l+r}x_{k}%
x_{k+r}+x_{j+r}x_{l}x_{k}x_{k+r}+ix_{j+r}x_{l+r}x_{k}x_{k+r}}\right\}  \\
\parallel\\
\frac{1}{8}\left\{  \overset{}{x_{j}x_{l}+x_{j+r}x_{l+r}+i\left(  x_{j}%
x_{l+r}-x_{j+r}x_{l}\right)  -x_{j}x_{l+r}x_{k}x_{k+r}+x_{j+r}x_{l}%
x_{k}x_{k+r}}+\overset{}{i\left(  x_{j}x_{l}x_{k}x_{k+r}+x_{j+r}x_{l+r}%
x_{k}x_{k+r}\right)  }\right\}  ,
\end{gather}
that number%
\begin{equation}
\#=2\binom{r-1}{2}\binom{r}{1}=\left(  r-1\right)  \left(  r-2\right)  \left(
r\right)  =\left(  r-1\right)  \left(  r-2\right)  \left(  r\right)  =r\left(
r-1\right)  \left(  r-2\right)  .
\end{equation}
In the case $r=4$ the subscripts are
\begin{equation}
1233,1433,2433,2133,4133,4233,3312,3314,3324,3321,3341,3342
\end{equation}

\end{enumerate}
\end{enumerate}

\begin{remark}
Operators that can be described by four unequal subscripts%
\begin{gather}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=a_{j}^{\dagger}a_{l}a_{k}^{\dagger
}a_{m}\\
\parallel\\
\frac{1}{16}\left\{  \overset{}{x_{j}x_{j}x_{k}x_{l}+ix_{j}x_{j}x_{k}%
x_{l+r}-ix_{j}x_{j}x_{k+r}x_{l}+x_{j}x_{j}x_{k+r}x_{l+r}+ix_{j}x_{j+r}%
x_{k}x_{l}}\right.  \\
-x_{j}x_{j+r}x_{k}x_{l+r}+x_{j}x_{j+r}x_{k+r}x_{l}+ix_{j}x_{j+r}x_{k+r}%
x_{l+r}-ix_{j+r}x_{j}x_{k}x_{l}+x_{j+r}x_{j}x_{k}x_{l+r}-x_{j+r}x_{j}%
x_{k+r}x_{l}\\
\left.  \overset{}{-ix_{j+r}x_{j}x_{k+r}x_{l+r}+x_{j+r}x_{j+r}x_{k}%
x_{l}+ix_{j+r}x_{j+r}x_{k}x_{l+r}-ix_{j+r}x_{j+r}x_{k+r}x_{l}+x_{j+r}%
x_{j+r}x_{k+r}x_{l+r}}\right\}  ,
\end{gather}%
\begin{gather}
\parallel\\
\frac{1}{16}\left\{  \overset{}{\left(  \overset{}{x_{j}x_{j}x_{k}x_{l}%
+x_{j}x_{j}x_{k+r}x_{l+r}-x_{j}x_{j+r}x_{k}x_{l+r}+x_{j}x_{j+r}x_{k+r}x_{l}%
}\right.  }\right.  \\
\left.  \overset{}{+\,x_{j+r}x_{j}x_{k}x_{l+r}-x_{j+r}x_{j}x_{k+r}%
x_{l}+x_{j+r}x_{j+r}x_{k}x_{l}+x_{j+r}x_{j+r}x_{k+r}x_{l+r}}\right)  \\
+i\left(  \overset{}{\,x_{j}x_{j+r}x_{k+r}x_{l+r}-x_{j+r}x_{j}x_{k}x_{l}%
+x_{j}x_{j}x_{k}x_{l+r}-x_{j}x_{j}x_{k+r}x_{l}}\right.  \\
\left.  \overset{}{\left.  \overset{}{+\,x_{j}x_{j+r}x_{k}x_{l}-x_{j+r}%
x_{j}x_{k+r}x_{l+r}+x_{j+r}x_{j+r}x_{k}x_{l+r}-x_{j+r}x_{j+r}x_{k+r}x_{l}%
}\right)  }\right\}  ,
\end{gather}%
\begin{gather}
\frac{1}{4}\left(  \overset{}{x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}}-x_{j_{1}%
}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}-x_{j_{4}}x_{j_{3}}x_{j_{1}+r}x_{j_{2}%
+r}+x_{j_{1}}x_{j_{3}}x_{j_{2}+r}x_{j_{4}+r}-x_{j_{1}}x_{j_{4}}x_{j_{2}%
+r}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}+r}x_{j_{3}}+x_{j_{2}}x_{j_{4}%
}x_{j_{1}+r}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}}\right.
\\
+\left.  i\left(  \overset{}{x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}%
+r}-x_{j_{1}}x_{j_{4}}x_{j_{3}}x_{j_{2}+r}+x_{j_{2}}x_{j_{4}}x_{j_{3}}%
x_{j_{1}+r}-x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}+r}-x_{j_{2}}x_{j_{1}%
+r}x_{j_{4}+r}x_{j_{3}+r}+x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}+r}-x_{j_{1}%
+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}+r}%
}\right)  \right)
\end{gather}
that number
\begin{equation}
\#=\binom{r}{2}\binom{r-2}{2}=\frac{r}{2}\left(  r-1\right)  \left(
r-2\right)  \left(  r-3\right)  .
\end{equation}
In the case $r=4$ the subscripts are%
\[
1234,1324,1423,2314,2413,3412.
\]%
\begin{align}
\sigma\left(  \left\{  1,2,3,4\right\}  \right)  ,\quad\sigma &  \in C_{4}%
^{r}\subset S_{r},\,\sigma=\alpha\left(  \left\{  j,k\right\}  \right)
\beta\left(  \left\{  l,m\right\}  \right)  ,\quad\alpha\in C_{2}^{r}\subset
S_{r},\quad\beta\in C_{2}^{r-2}\subset S_{r-2}\\
S_{2}\times S_{r-2} &  \subset S_{r}%
\end{align}%
\begin{gather}
1234,1324,1423,2314,2413,3412\\
\parallel\\
j,k,j+r,k+r;\quad1\leq j<k\leq4=1,2,3,4
\end{gather}

\end{remark}

\begin{definition}
The complex vector space of two particle operators
\begin{equation}
\mathcal{A}_{a2}=\mathbb{C}\text{-}\operatorname{linspan}\left\{  \left.
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\right\vert 1\leq j<k\leq r,1\leq
m<l\leq r\right\}  .
\end{equation}

\end{definition}

\begin{definition}
Decomposition of $\mathcal{A}_{a2}$

\begin{enumerate}
\item Two out of four subscripts different

\begin{enumerate}
\item The subspace of operators $\mathcal{A}_{a2\left(  2\right)  }%
\subset\mathcal{A}_{a2}$
\begin{equation}
\mathcal{A}_{a2\left(  2\right)  }=\mathbb{C}\text{-}\operatorname{linspan}%
\left\{  \left.  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}\right\vert 1\leq
j<k\leq r\right\}  .
\end{equation}


\item The index set $\mathfrak{I}_{2}^{4}$
\begin{equation}
\mathfrak{I}_{2}^{4}=\left\{  \left.  \left(  j,k\right)  \right\vert 1\leq
j<k\leq r\right\}  .
\end{equation}

\end{enumerate}

\item Three subscripts out of four different

\begin{enumerate}
\item The subspace of operators $\mathcal{A}_{a2\left(  3\right)  }%
\subset\mathcal{A}_{a2}$%
\begin{equation}
\mathcal{A}_{a2\left(  3\right)  }=\mathbb{C}\text{-}\operatorname{linspan}%
\left\{  \left.  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\right\vert 1\leq
k\neq j\neq l\leq r\right\}
\end{equation}


\item The index set $\mathfrak{I}_{3}^{4}$%
\begin{equation}
\mathfrak{I}_{3}^{4}=\left\{  \left.  \left(  j,l,k\right)  \right\vert 1\leq
k\neq j\neq l\leq r\right\}
\end{equation}

\end{enumerate}

\item Four subscripts out of four different

\begin{enumerate}
\item The subspace of operators $\mathcal{A}_{a2\left(  3\right)  }%
\subset\mathcal{A}_{a2}$%
\begin{equation}
\mathcal{A}_{a2\left(  4\right)  }=\mathbb{C}\text{-}\operatorname{linspan}%
\left\{  \left.  a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\right\vert 1\leq
i<j\leq r,1\leq l<k\leq r,\left(  i,j\right)  \neq\left(  l,k\right)
\right\}
\end{equation}


\item The index set $\mathfrak{I}_{4}^{4}$%
\begin{equation}
\mathfrak{I}_{4}^{4}=\left\{  \left.  \left(  i,j,k,l\right)  \right\vert
1\leq i<j\leq r,1\leq l<k\leq r,\left(  i,j\right)  \neq\left(  l,k\right)
\right\}
\end{equation}

\end{enumerate}
\end{enumerate}
\end{definition}

\begin{lemma}
The three subspaces $\left\{  \mathcal{A}_{a2\left(  2\right)  }%
,\mathcal{A}_{a2\left(  3\right)  },\mathcal{A}_{a2\left(  4\right)
}\right\}  $ are disjoint and
\begin{equation}
\mathcal{A}_{a2}=\mathcal{A}_{a2\left(  2\right)  }\oplus\mathcal{A}%
_{a2\left(  3\right)  }\oplus\mathcal{A}_{a2\left(  4\right)  }.
\end{equation}

\end{lemma}

\begin{lemma}
The vector spaces $\left\{  \mathcal{A}_{a2},\mathcal{A}_{a2\left(  2\right)
},\mathcal{A}_{a2\left(  3\right)  },\mathcal{A}_{a2\left(  4\right)
}\right\}  $ have the dimensions

\begin{enumerate}
\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2}\right\}  =\binom{r}{2}^{2}%
\end{equation}


\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2\left(  2\right)  }\right\}  =\binom{r}{2}%
\end{equation}


\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2\left(  3\right)  }\right\}  =2\binom{r-1}%
{2}\binom{r}{1}%
\end{equation}


\item
\begin{equation}
\dim\left\{  \mathcal{A}_{a2\left(  4\right)  }\right\}  =\binom{r}{2}%
\binom{r-2}{2}.
\end{equation}

\end{enumerate}
\end{lemma}

\begin{lemma}%
\begin{equation}
\binom{r}{2}^{2}=\binom{r}{2}+2\binom{r-1}{2}\binom{r}{1}+\binom{r}{2}%
\binom{r-2}{2}%
\end{equation}

\end{lemma}

\begin{proof}
\begin{enumerate}
\item
\begin{enumerate}
\item
\begin{equation}
\binom{r}{2}=\frac{r\left(  r-1\right)  }{2}=\frac{1}{2}r^{2}-\frac{1}%
{2}r=\frac{1}{4}\left(  2r^{2}-2r\right)
\end{equation}


\item In the case $r=4$%
\begin{equation}
\frac{4\left(  4-1\right)  }{2}=6.
\end{equation}


\item
\begin{equation}
\binom{r}{2}^{2}=\frac{r\left(  r-1\right)  }{2}\frac{r\left(  r-1\right)
}{2}=\frac{1}{4}r^{2}\left(  r^{2}-2r+1\right)  =\frac{1}{4}r^{4}-\frac{1}%
{2}r^{3}+\frac{1}{4}r^{2}=\frac{1}{4}\left(  r^{4}-2r^{3}+r^{2}\right)
\end{equation}


\item[b] In the case $r=4$%
\begin{equation}
\frac{1}{4}4^{4}-\frac{1}{2}4^{3}+\frac{1}{4}4^{2}=64-32+4=36
\end{equation}


\item
\begin{equation}
\binom{r}{2}=\frac{r\left(  r-1\right)  }{2}=\frac{1}{2}r^{2}-\frac{1}%
{2}r=\frac{1}{4}\left(  2r^{2}-2r\right)
\end{equation}


\item In the case $r=4$%
\begin{equation}
\frac{4\left(  4-1\right)  }{2}=6
\end{equation}


\item
\begin{equation}
2\binom{r-1}{2}\binom{r}{1}=r\left(  r-1\right)  \left(  r-2\right)  =r\left(
r^{2}-3r+2\right)  =r^{3}-3r^{2}+2r=\frac{1}{4}\left(  4r^{3}-12r^{2}%
+8r\right)
\end{equation}


\item In the case $r=4$%
\begin{align}
4^{3}-\left(  3\right)  4^{2}+\left(  2\right)  4  &  =64-48+8=24\\
2\binom{4-1}{2}\binom{4}{1}  &  =2\binom{3}{2}\binom{4}{1}=4\left(
4-1\right)  \left(  4-2\right)  =4\left(  4^{2}-\left(  3\right)  4+2\right)
=4^{3}-3\left(  4^{2}\right)  +2\left(  4\right)  =64-48+8=24
\end{align}


\item
\begin{align}
\binom{r}{2}\binom{r-2}{2}  &  =\frac{1}{4}\left(  r^{2}-\frac{1}{2}r\right)
\left(  r-2\right)  \left(  r-3\right)  =\frac{1}{4}\left(  r^{2}-r\right)
\left(  r^{2}-5r+6\right) \\
&  =\frac{1}{4}\left(  r^{2}\left(  r^{2}-5r+6\right)  -r\left(
r^{2}-5r+6\right)  \right)  =\frac{1}{4}\left(  r^{4}-5r^{3}+6r^{2}%
-r^{3}+5r^{2}-6r\right) \\
&  =\frac{1}{4}\left(  r^{4}-6r^{3}+11r^{2}-6r\right)
\end{align}


\item In the case $r=4$%
\begin{equation}
\frac{1}{4}4\left(  4^{3}-6\left(  4^{2}\right)  +11\left(  4\right)
-6\right)  =64-96+44-6=108-102=6
\end{equation}

\end{enumerate}

\item The sum of these three terms are
\begin{align}
&  \frac{1}{4}\left(  2r^{2}-2r\right)  +\frac{1}{4}\left(  4r^{3}%
-12r^{2}+8r\right)  +\frac{1}{4}\left(  r^{4}-6r^{3}+11r^{2}-6r\right) \\
&  =\frac{1}{4}\left(  2r^{2}-2r+4r^{3}-12r^{2}+8r+r^{4}-6r^{3}+11r^{2}%
-6r\right) \\
&  =\frac{1}{4}\left(  r^{2}-2r^{3}+r^{4}\right)  ,
\end{align}
which equals $\binom{r}{2}^{2}$ i.e.%
\begin{equation}
\frac{1}{4}\left(  r^{4}-2r^{3}+r^{2}\right)  .
\end{equation}

\end{enumerate}
\end{proof}

\begin{enumerate}
\item
\begin{example}
Let $r=4$ then

\begin{enumerate}
\item The full basis has cardenality given by

\begin{enumerate}
\item
\begin{equation}
\binom{r}{2}^{2}=\frac{r^{2}}{4}\left(  r-1\right)  ^{2}=\frac{16}{4}\left(
4-1\right)  ^{2}=\left(  4\right)  \left(  9\right)  =36
\end{equation}
in detail

\item
\begin{gather}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}\\
\parallel\\
1212,1213,1214,1223,1224,1234,\quad1312,1313,1314,1323,1324,1334,\quad
1412,1413,1414,1423,1424,1434,\\
2312,2313,2314,2323,2324,2334,\quad2412,2413,2414,2423,2424,2434,\quad
3412,3413,3414,3423,3424,3434,
\end{gather}

\end{enumerate}

\item The subset of the basis describes by two subscripts has cardenality
given by

\begin{enumerate}
\item
\begin{equation}
\binom{r}{2}=\frac{r}{2}\left(  r-1\right)  =\left(  \frac{4\left(
4-1\right)  }{\left(  1\right)  \left(  2\right)  }\right)  =6
\end{equation}
in detail

\item
\begin{gather}
a_{j}^{\dagger}a_{j}a_{k}^{\dagger}a_{k}=n_{j}n_{k}\\
\parallel\\
1212,\quad1313,\quad1414,\quad2323,\quad2424,\quad3434
\end{gather}

\end{enumerate}

\item The subset of the basis describes by three subscripts has cardenality
given by

\begin{enumerate}
\item
\begin{equation}
2\binom{r-1}{2}\binom{r}{1}=2\frac{\left(  r-1\right)  \left(  r-2\right)
}{2}\left(  r\right)  =\left(  r-1\right)  \left(  r-2\right)  \left(
r\right)  =\left(  4-1\right)  \left(  4-2\right)  \left(  4\right)  =\left(
3\right)  \left(  2\right)  \left(  4\right)  =24
\end{equation}
in detail

\item
\begin{gather}
a_{j}^{\dagger}a_{k}a_{l}^{\dagger}a_{l}=a_{j}^{\dagger}a_{k}n_{l}\\
\parallel\\
1233,1433,2433,2133,4133,4233,\quad1244,1344,2344,2144,3144,3244,\\
1322,1422,3422,3122,4122,4322,\quad4211,4311,2311,2411,3411,3211,
\end{gather}

\end{enumerate}

\item The subset of the basis describes by four subscripts has cardenality
given by

\begin{enumerate}
\item
\begin{equation}
\binom{r}{2}\binom{r-2}{2}=\binom{4}{2}\binom{2}{2}=\left(  6\right)  \left(
1\right)  =6
\end{equation}
in detail

\item
\begin{gather}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m}=-a_{j}^{\dagger}a_{l}a_{k}^{\dagger
}a_{m}\\
\parallel\\
1234,1324,1423,2314,2413,3412.
\end{gather}

\end{enumerate}
\end{enumerate}
\end{example}
\end{enumerate}

\subsection*{2. General Two-Particle Operator in Second Quantization}

A general two-particle operator $\hat{O}$ is written as:
\[
\hat{O}=\sum_{i,j,k,l}O_{ijkl}\,a_{j}^{\dagger}a_{j}^{\dagger}a_{k}a_{l}%
=\frac{1}{4}\sum_{i<j<k<l}O_{ijkl}\,a_{j}^{\dagger}a_{j}^{\dagger}a_{k}a_{l},
\]
where $O_{ijkl}$ are antisymmetric under $i\leftrightarrow j$ or
$k\leftrightarrow l$. In the special case $a_{i_{0}}^{\dagger}a_{j_{0}%
}^{\dagger}a_{k_{0}}a_{l_{0}}$ the coefficients are
\begin{equation}
O_{i_{0}j_{0}k_{0}l_{0}}=\delta_{ii_{0}}\delta_{jj_{0}}\delta_{kk_{0}}%
\delta_{li_{0}}%
\end{equation}


\begin{example}
Coulomb Interaction
\end{example}

For electrons in a basis $\{\phi_{j}(\mathbf{r})\}$:
\[
O_{jklm}=V_{jklm}=\int d\mathbf{r}_{1}d\mathbf{r}_{2}\phi_{j}^{\ast
}(\mathbf{r}_{1})\phi_{k}^{\ast}(\mathbf{r}_{2})\frac{e^{2}}{|\mathbf{r}%
_{1}-\mathbf{r}_{2}|}\phi_{l}(\mathbf{r}_{1})\phi_{m}(\mathbf{r}_{2}).
\]


\subsection*{Basis Construction}

The field operator basis for second degree particle conserving operators is
\begin{equation}
\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}^{\dagger}\boldsymbol{aa}%
\right)  =\left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{1}a_{2} & \cdots & a_{r-1}^{\dagger}%
a_{r}^{\dagger}a_{r-1}a_{r}%
\end{array}
\right)
\end{equation}
such that
\begin{equation}
\text{cardenality}=\left(
\begin{array}
[c]{ccc}%
\frac{r}{2}\left(  r-1\right)  & r\left(  r-1\right)  \left(  r-2\right)  &
\frac{r}{4}\left(  r-1\right)  \left(  r-2\right)  \left(  r-3\right)
\end{array}
\right)  ,
\end{equation}


which can be expressed in Majorana form as
\begin{align}
&  \left\{  \left\{  \left.  \overset{}{\frac{1}{4}\left(  I_{\mathcal{H}%
_{\mathcal{F}}}+i\left(  x_{j}x_{j+r}+x _{k}x _{2k}\right)  -x_{j}x_{j+r}x
_{k}x_{k+r}\right)  }\right\vert 1\leq j<k\leq r\right\}  ,\right. \\
&  \left\{
\begin{array}
[c]{c}%
\left.  \frac{1}{8}\left(  \overset{}{x_{j}x_{l}+x _{2j}x_{l+r}}+i\left(
x_{j}x_{l+r}-x_{j+r}x _{2l-1}\right)  -x_{j}x_{l+r}x _{k}x_{k+r}+x _{2j}x_{l}x
_{k}x_{k+r}+i\left(  x_{j+r}x _{l+r}x _{k}x_{k+r}+x_{j}x_{l}x _{k}%
x_{k+r}\right)  \right)  \right\vert \\
j,k,l,
\end{array}
\right\}  ,\\
&  \left\{  \frac{1}{16}\left(  \overset{\overset{}{}}{x_{j}x_{j}x _{k}%
x_{l}+x_{j}x_{j}x _{2k}x_{l+r}-x_{j}x_{j+r}x _{k}x_{l+r}+x_{j}x_{j+r}%
x_{k+r}x_{l}+x_{j+r}x _{2j-1}x _{k}x_{l+r}-x_{j+r}x_{j}x_{k+r}x_{l}%
+x_{j+r}x_{j+r}x _{k}x_{l}+x _{2i}x_{j+r}x_{k+r}x_{l+r}}\right.  \right. \\
&  \left.  \overset{}{+i\left(  x_{j}x_{j}x _{k}x_{l+r}-x_{j}x_{j}x_{k+r}%
x_{l}+x _{2i-1}x_{j+r}x_{k+r}x_{l+r}-x_{j+r}x_{j}x _{k}x_{l}+x_{j}x_{j+r}x
_{k}x _{2l-1}-\overset{}{\,x_{j+r}x_{j}x_{k+r}x_{l+r}+x_{j+r}x_{j+r}x
_{k}x_{l+r}-x_{j+r}x_{j+r}x_{k+r}x_{l}}\right)  }\right) \\
&  \left.  \overset{}{i,j,k,l}\right\}
\end{align}
such that
\begin{equation}
\text{cardenality}=\left(
\begin{array}
[c]{ccc}%
\frac{r}{2}\left(  r-1\right)  & r\left(  r-1\right)  \left(  r-2\right)  &
\frac{r}{4}\left(  r-1\right)  \left(  r-2\right)  \left(  r-3\right)
\end{array}
\right)  .
\end{equation}


\begin{remark}%
\begin{equation}
\hat{O}=\hat{O}_{\left(  2\right)  }+\hat{O}_{\left(  3\right)  }+\hat
{O}_{\left(  4\right)  }%
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
&  \hat{O}=\frac{1}{4}\sum_{1\leq j<k\leq r}O_{jkjk}\left(
\overset{}{I_{\mathcal{H}_{\mathcal{F}}}+i\left(  x_{j}x _{2j}+x _{k}%
x_{k+r}\right)  -x_{j}x_{j+r}x _{k}x_{k+r}}\right) \\
&  +\frac{1}{8}\sum_{j\neq k\neq l}O_{jkjl}\left(  \overset{}{x _{2j-1}%
x_{l}+x_{j+r}x_{l+r}+i\left(  x_{j}x _{l+r}-x_{j+r}x_{l}\right)  }\right. \\
&  \hspace{2in}+\left.  \overset{}{x_{j+r}x_{l}x _{k}x_{k+r}-x_{j}x_{l+r}x
_{k}x_{k+r}+i\left(  x_{j+r}x_{l+r}x _{k}x_{k+r}+x_{j}x _{2l-1}x _{k}%
x_{k+r}\right)  }\right) \\
&  +\frac{1}{16}\sum_{i\neq j\neq k\neq l}O_{ijkl}\left(
\begin{array}
[c]{c}%
\overset{}{x_{j}x_{j}x _{k}x_{l}+x _{2i-1}x_{j}x_{k+r}x_{l+r}-x_{j}x_{j+r}x
_{k}x_{l+r}+x_{j}x_{j+r}x_{k+r}x_{l}}\\
+x_{j+r}x_{j}x _{k}x_{l+r}-x_{j+r}x _{2j-1}x_{k+r}x_{l}+x_{j+r}x_{j+r}x
_{k}x_{l}+x_{j+r}x_{j+r}x_{k+r}x_{l+r}%
\end{array}
\right. \\
&  \qquad\quad\quad+\left.  i\left(
\begin{array}
[c]{c}%
x_{j}x_{j+r}x _{k}x_{l}+x_{j}x _{2j}x_{k+r}x_{l+r}-x_{j+r}x_{j}x _{k}x
_{2l-1}+x_{j}x_{j}x _{k}x_{l+r}\\
-x_{j}x_{j}x_{k+r}x_{l}+\overset{}{x _{2i}x_{j}x_{k+r}x_{l+r}+x_{j+r}x_{j+r}x
_{k}x_{l+r}-x_{j+r}x_{j+r}x_{k+r}x_{l}}%
\end{array}
\right)  \right)  ,\hspace{2in}.
