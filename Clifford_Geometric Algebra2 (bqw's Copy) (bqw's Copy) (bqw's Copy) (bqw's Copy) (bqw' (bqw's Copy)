\section{General Self Adjoint Field Operators}

In general
\begin{align}
X\left(  \left\vert u\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  +\Phi\left(
\left\vert u\right\rangle \right)  \right) \\
Y\left(  \left\vert u\right\rangle \right)   &  =\frac{i}{\sqrt{2}}\left(
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  -\Phi\left(
\left\vert u\right\rangle \right)  \right)
\end{align}%
\begin{align}
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)   &  =\frac{1}%
{\sqrt{2}}\left(  X\left(  \left\vert u\right\rangle \right)  -iY\left(
\left\vert u\right\rangle \right)  \right) \\
\Phi\left(  \left\vert u\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
X\left(  \left\vert u\right\rangle \right)  +iY\left(  \left\vert
u\right\rangle \right)  \right)  .
\end{align}
Hence
\begin{align}
&  \left\{  X\left(  \left\vert u\right\rangle \right)  ,X\left(  \left\vert
v\right\rangle \right)  \right\}  =\frac{1}{2}\left\{  \left(  \Phi^{\dagger
}\left(  \left\vert u\right\rangle \right)  +\Phi\left(  \left\vert
u\right\rangle \right)  \right)  ,\left(  \Phi^{\dagger}\left(  \left\vert
v\right\rangle \right)  +\Phi\left(  \left\vert v\right\rangle \right)
\right)  \right\} \nonumber\\
&  =\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}  +\left\{
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  +\left\{  \Phi\left(  \left\vert
u\right\rangle \right)  ,\Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  \right\}  +\left\{  \Phi\left(  \left\vert u\right\rangle \right)
,\Phi\left(  \left\vert v\right\rangle \right)  \right\} \nonumber\\
&  =0+\overline{\left\langle \left.  u\right\vert v\right\rangle
}I_{\mathcal{F}}+\left\langle \left.  u\right\vert v\right\rangle
I_{\mathcal{F}}+0=\operatorname{Re}\left\langle \left.  u\right\vert
v\right\rangle I_{\mathcal{F}}\\
&  \left\{  X\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
v\right\rangle \right)  \right\}  =\left\{  \left(  \Phi^{\dagger}\left(
\left\vert u\right\rangle \right)  +\Phi\left(  \left\vert u\right\rangle
\right)  \right)  ,i\left(  \Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  -\Phi\left(  \left\vert v\right\rangle \right)  \right)  \right\}
\nonumber\\
&  =i\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}  -i\left\{
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  +i\left\{  \Phi\left(  \left\vert
u\right\rangle \right)  ,\Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  \right\}  -i\left\{  \Phi\left(  \left\vert u\right\rangle \right)
,\Phi\left(  \left\vert v\right\rangle \right)  \right\} \nonumber\\
&  =0-i\overline{\left\langle \left.  u\right\vert v\right\rangle
}I_{\mathcal{F}}+i\left\langle \left.  u\right\vert v\right\rangle
I_{\mathcal{F}}=\operatorname{Im}\left\langle \left.  u\right\vert
v\right\rangle I_{\mathcal{F}}\\
&  \left\{  Y\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
v\right\rangle \right)  \right\}  =\left\{  i\left(  \Phi^{\dagger}\left(
\left\vert u\right\rangle \right)  -\Phi\left(  \left\vert u\right\rangle
\right)  \right)  ,i\left(  \Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  -\Phi\left(  \left\vert v\right\rangle \right)  \right)  \right\}
\nonumber\\
&  =-\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}  +\left\{
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  +\left\{  \Phi\left(  \left\vert
u\right\rangle \right)  ,\Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  \right\}  -\left\{  \Phi\left(  \left\vert u\right\rangle \right)
,\Phi\left(  \left\vert v\right\rangle \right)  \right\} \nonumber\\
&  =0+\overline{\left\langle \left.  u\right\vert v\right\rangle
}I_{\mathcal{F}}+\left\langle \left.  u\right\vert v\right\rangle
I_{\mathcal{F}}+0=\operatorname{Re}\left\langle \left.  u\right\vert
v\right\rangle I_{\mathcal{F}}%
\end{align}
and
\begin{align}
\left\{  X\left(  \left\vert u\right\rangle \right)  ,X\left(  \left\vert
u\right\rangle \right)  \right\}   &  =\left\langle \left.  u\right\vert
u\right\rangle I_{\mathcal{F}}\\
\left\{  X\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
u\right\rangle \right)  \right\}   &  =0\\
\left\{  Y\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
u\right\rangle \right)  \right\}   &  =\left\langle \left.  u\right\vert
u\right\rangle I_{\mathcal{F}}.
\end{align}
In particular for a conb $\left\{  \left.  \left\vert u_{i}\right\rangle
\right\vert 1\leq j\leq r\right\}  $%
\begin{align}
\left\{  X\left(  \left\vert u_{i}\right\rangle \right)  ,X\left(  \left\vert
u_{j}\right\rangle \right)  \right\}   &  =\delta_{ij}I_{\mathcal{F}}\\
\left\{  X\left(  \left\vert u_{i}\right\rangle \right)  ,Y\left(  \left\vert
u_{j}\right\rangle \right)  \right\}   &  =0\\
\left\{  Y\left(  \left\vert u_{i}\right\rangle \right)  ,Y\left(  \left\vert
u_{j}\right\rangle \right)  \right\}   &  =\delta_{ij}I_{\mathcal{F}}.
\end{align}


\section{Self Adjoint Bases of the CAR Fock Algebra $\mathcal{F}$}

One can define self adjoint operators
\begin{align}
x_{j}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
=x_{j}^{\dagger}\\
x_{j+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
=x_{j+r}^{\dagger}.
\end{align}
Then noting that
\begin{equation}
-ix_{j+r}=\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
\end{equation}
gives the inverse relationships
\begin{align}
a_{j}^{\dagger}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right) \\
a_{j}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right)  .
\end{align}
This can be checked by
\begin{align}
\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)   &  =\frac{1}%
{2}\left(  \left(  x_{j}-ix_{j+r}\right)  +\left(  x_{j}+ix_{j+r}\right)
\right)  =x_{j}\nonumber\\
\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)   &  =\frac{i}%
{2}\left(  \left(  x_{j}-ix_{j+r}\right)  -\left(  x_{j}+ix_{j+r}\right)
\right)  =x_{j+s}.
\end{align}


In matrix notation the transformation between the $\left\{  \left.
a_{j},a_{j}^{\dagger}\right\vert 1\leq j\leq r\right\}  $ and $\left\{
\left.  x_{j}\right\vert 1\leq j\leq2r\right\}  $ bases is given by
\begin{align}
\left(  \mathbf{x}\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =J\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
