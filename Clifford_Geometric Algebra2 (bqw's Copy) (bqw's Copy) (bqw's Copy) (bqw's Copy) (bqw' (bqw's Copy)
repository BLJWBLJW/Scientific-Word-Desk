\subsubsection{One Particle and One Hole Idempotents}

The creators and annihilators
\begin{align}
a_{j}^{\dagger}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right) \\
a_{j}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right)
\end{align}
produce the one particle operators%
\begin{align}
a_{j}^{\dagger}a_{k}  &  =\frac{1}{2}\left(  x_{j}-ix_{j+r}\right)  \left(
x_{k}+ix_{k+r}\right)  =\frac{1}{2}\left(  x_{j}x_{k}+ix_{j}x_{k+r}%
-ix_{j+r}x_{k}+x_{j+r}x_{k+r}\right) \\
&  =\frac{1}{2}\left\{  \left(  x_{j}x_{k}+x_{j+r}x_{k+r}\right)  +i\left(
x_{j}x_{k+r}-x_{j+r}x_{k}\right)  \right\}  .
\end{align}
One particle idempotents are given by%
\begin{align}
n_{j}  &  =a_{j}^{\dagger}a_{j}=\frac{1}{2}\left(  x_{j}-ix_{j+r}\right)
\left(  x_{j}+ix_{j+r}\right)  =\frac{1}{2}\left(  x_{j}^{2}+ix_{j}%
x_{j+r}-ix_{j+r}x_{j}+x_{j+r}^{2}\right) \\
&  =\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\\
\left(  n_{j}\right)  ^{2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}%
+ix_{j}x_{j+r}\right)  ^{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}%
x_{j+r}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}+\frac{1}{2}ix_{j}x_{j+r}+\frac{1}{2}%
ix_{j}x_{j+r}-x_{j}x_{j+r}x_{j}x_{j+r}\\
&  =\frac{1}{4}I_{\mathcal{F}}+ix_{j}x_{j+r}+\frac{1}{4}I_{\mathcal{F}}%
=\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}=n_{j}.
\end{align}
and one hole idempotents are given by
\begin{align}
h_{j}  &  =a_{j}a_{j}^{\dagger}=\frac{1}{2}\left(  x_{j}+ix_{j+r}\right)
\left(  x_{j}-ix_{j+r}\right)  =\frac{1}{2}\left(  x_{j}^{2}-ix_{j}%
x_{j+r}+ix_{j+r}x_{j}+x_{j+r}^{2}\right) \\
&  =\frac{1}{2}I_{\mathcal{F}}-ix_{j}x_{j+r}.
\end{align}


The projectors $\left\{  n_{j},h_{j}\right\}  $ are infinite dimensional when
$r=\infty$.

Consider
\begin{equation}
p=\frac{1}{2}I_{\mathcal{F}}+ixy,
\end{equation}
where
\begin{equation}
x^{2}=y^{2}=\frac{1}{2}I_{\mathcal{F}},
\end{equation}
then
\begin{equation}
p^{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ixy\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ixy\right)  =\frac{1}{4}I_{\mathcal{F}}+\frac{1}%
{2}ixy+\frac{1}{2}ixy-xyxy=\frac{1}{2}I_{\mathcal{F}}+ixy=p.
\end{equation}
Noting that
\begin{align}
x_{j}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
=x_{j}^{\dagger}\\
x_{j+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
=x_{j+r}^{\dagger}%
\end{align}
one can see that in particular
\begin{equation}
p_{12}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{2}\right)  =\frac{1}%
{2}\left(  I_{\mathcal{F}}+i\left(  a_{1}^{\dagger}a_{2}^{\dagger}+a_{1}%
a_{2}^{\dagger}+a_{1}^{\dagger}a_{2}+a_{1}a_{2}\right)  \right)  .
\end{equation}
One can also note that
\begin{equation}
p=\frac{1}{\sqrt{2}}\left(  I_{\mathcal{F}}+\sqrt{2}x\right)
\end{equation}
are also idempotents when
\begin{equation}
x^{2}=\frac{1}{2}I_{\mathcal{F}}.
\end{equation}


