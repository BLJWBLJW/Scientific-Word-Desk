\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ,
\end{align}
where
\begin{equation}
