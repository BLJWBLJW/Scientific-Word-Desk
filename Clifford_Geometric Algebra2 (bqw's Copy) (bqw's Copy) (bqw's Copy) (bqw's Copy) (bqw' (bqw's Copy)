\section{Clifford Algebra}

The squares of the self adjoint operators $\left\{  \left.  x_{j}\right\vert
1\leq j\leq2r\right\}  $ are multiples of the identity i.e.%
\begin{equation}
x_{j}^{2}=\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  \frac
{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}%
\end{equation}%
\begin{equation}
x_{j+r}^{2}=\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)  \frac
{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}%
\end{equation}
Thus
\begin{equation}
\left\Vert x_{j}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }=\frac{1}{\sqrt{2}},1\leq j\leq2r.
\end{equation}


The products for $1\leq j\neq k\leq r$ are
\begin{align}
x_{j}x_{k}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
\frac{1}{\sqrt{2}}\left(  a_{k}^{\dagger}+a_{k}\right)  =\frac{1}{2}\left(
a_{j}^{\dagger}a_{k}+a_{j}a_{k}+a_{j}^{\dagger}a_{k}^{\dagger}+a_{j}%
a_{k}^{\dagger}\right) \nonumber\\
x_{k}x_{j}  &  =\frac{1}{\sqrt{2}}\left(  a_{k}^{\dagger}+a_{k}\right)
\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  =\frac{1}{2}\left(
a_{k}^{\dagger}a_{j}+a_{k}a_{j}+a_{k}^{\dagger}a_{j}^{\dagger}+a_{k}%
a_{j}^{\dagger}\right)
\end{align}
hence
\begin{equation}
x_{j}x_{k}=-x_{k}x_{j}.
\end{equation}


The products for $r+1\leq j+r\neq k+r\leq2r$ are%
\begin{align}
x_{j+r}x_{k+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)  =\frac{1}{2}\left(
-a_{j}^{\dagger}a_{k}^{\dagger}+a_{j}^{\dagger}a_{k}+a_{j}a_{k}^{\dagger
}-a_{j}a_{k}\right) \nonumber\\
x_{k+r}x_{j+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)
\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)  =\frac{1}{2}\left(
-a_{k}^{\dagger}a_{j}^{\dagger}+a_{k}^{\dagger}a_{j}+a_{k}a_{j}^{\dagger
}-a_{k}a_{j}\right)
\end{align}
hence
\begin{equation}
x_{j+r}x_{k+r}=-x_{k+r}x_{j+r}.
\end{equation}


The products for $1\leq j\leq r;$ $r+1\leq k+r\leq2r$ are
\begin{align}
x_{j}x_{k+r}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)  =\frac{1}{2}\left(
ia_{j}^{\dagger}a_{k}^{\dagger}-ia_{j}^{\dagger}a_{k}+ia_{j}a_{k}^{\dagger
}-ia_{j}a_{k}\right) \nonumber\\
x_{k+r}x_{j}  &  =\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)
\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  =\left(  x_{j}%
x_{k+s}\right)  ^{\dagger}=\frac{1}{2}\left(  ia_{k}^{\dagger}a_{j}^{\dagger
}+ia_{k}^{\dagger}a_{j}-ia_{k}a_{j}^{\dagger}-ia_{k}a_{j}\right)
\end{align}
hence $x_{j}x_{k+r}=-x_{k+r}x_{j}.$

The squares for $1\leq j\leq r$ are%

\begin{align}
x_{j}^{2}  &  =x_{j}x_{j}=\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}%
+a_{j}\right)  \frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
=\frac{1}{2}\left(  a_{j}a_{j}^{\dagger}+a_{j}a_{j}+a_{j}^{\dagger}%
a_{j}^{\dagger}+a_{j}^{\dagger}a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}%
}\nonumber\\
x_{j+r}^{2}  &  =x_{j+r}x_{j+r}=\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger
}-a_{j}\right)  \frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
\nonumber\\
&  =-\frac{1}{2}\left(  a_{j}^{\dagger}a_{j}^{\dagger}-a_{j}^{\dagger}%
a_{j}-a_{j}a_{j}^{\dagger}+a_{j}a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}.
\end{align}


Thus the self adjoint operators $\left\{  \left.  x_{j}\right\vert 1\leq
j\leq2r\right\}  $ satisfy the CAR's
\begin{equation}
\left\{  x_{j},x_{k}\right\}  =\delta_{jk}I_{\mathcal{F}};\,1\leq i,j\leq2r.
\end{equation}


The Fermi Fock algebra $\mathcal{F},$ which is representation of a CAR
algebra, is generated by \emph{complex} polynomials of the generators
$\left\{  \left.  x_{j}\right\vert 1\leq j\leq2r\right\}  $ that satisfy the
conditions
\begin{align}
x_{j}x_{k}  &  =-x_{k}x_{j},\,1\leq j<k\leq2r\\
x_{j}^{2}  &  =\frac{1}{2}I_{\mathcal{F}},\,1\leq j\leq2r
\end{align}
or equivalently
\begin{equation}
\left\{  x_{j},x_{k}\right\}  =\delta_{jk}I_{\mathcal{F}};\,1\leq i,j\leq2r,
\end{equation}
thus is a \emph{Clifford Algebra}. This is a graded algebra and be expressed
as the exterior algebra over $\mathcal{\mathcal{F}}_{1}$ i.e. as the vector
space direct sum
\begin{equation}
\mathcal{F=}%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\mathcal{\mathcal{F}}_{1}=%
%TCIMACRO{\dbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\mathcal{F}_{n},
\end{equation}
where $\mathcal{F}_{n}$ are multilinear homogeneous polynomials of degree $n$
in $\left\{  x_{j}\right\}  $ and the scaler part is defined as
\begin{equation}
\mathcal{F}_{0}=\left\{  \left.  zI_{\mathcal{F}}\right\vert z\in
\mathbb{C}\right\}  .
\end{equation}
One needs to show that
\[
I_{\mathcal{F}}\neq\sum_{1\leq n\leq2r}\sum_{1\leq j_{1}<\cdots<j_{n}\leq
2r}A_{j_{1}\cdots j_{2r}}x_{j_{1}\cdots}x_{j_{n}}%
\]
in order that the subspaces $\left\{  \mathcal{F}_{n}\right\}  $ are disjoint.

This is a different decomposition to the ones introduced before i.e. in terms
of degrees of creation and annihilation operators
\begin{equation}
\mathcal{F=}%
%TCIMACRO{\dbigoplus \limits_{0\leq n,m\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq n,m\leq r}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{nm}%
\end{equation}
and mappings between the component Hilbert spaces%
\begin{equation}
\mathcal{F=}%
%TCIMACRO{\dbigoplus \limits_{0\leq n,m\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq n,m\leq r}}
%EndExpansion
\mathcal{B}_{nm}\left(  \mathcal{H}_{\mathcal{F}}\right)  =%
%TCIMACRO{\dbigoplus \limits_{0\leq n,m\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq n,m\leq r}}
%EndExpansion
\mathcal{B}_{nm}\left(  \mathcal{H}^{n},\mathcal{H}^{m}\right)  .
\end{equation}
One should observe that
\begin{equation}
\mathcal{F}_{n}=%
%TCIMACRO{\dbigoplus \limits_{\substack{p+q=n\\0\leq p,q\leq r}}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{\substack{p+q=n\\0\leq p,q\leq r}}}
%EndExpansion
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{pq}.
\end{equation}


\bigskip If $A$ is a general element of $\mathcal{F}$ then
\begin{equation}
A=\sum_{0\leq n\leq2r}\left\langle A\right\rangle _{n}=\sum_{0\leq n\leq
2r}A_{n},
\end{equation}
where
\begin{equation}
\left\langle A\right\rangle _{n}=A_{n}\in\mathcal{F}_{n}.
\end{equation}
Thus
\begin{equation}
\left\langle A\right\rangle _{n}=\sum_{1\leq j_{1}<\cdots<j_{n}\leq
2r}A_{nj_{1}\cdots j_{n}}x_{j_{1}}\cdots x_{j_{n}}=\sum_{1\leq j_{1}%
<\cdots<j_{n}\leq2r}A_{nj_{1}\cdots j_{n}}x_{j_{1}}\wedge\cdots\wedge
x_{j_{n}}%
\end{equation}
and
\begin{equation}
\left\langle A\right\rangle _{0}=\alpha I_{\mathcal{F}}=A_{0};\alpha
\in\mathbb{C}.
\end{equation}
Thus
\begin{equation}
\left\langle A_{n}\right\rangle _{m}=\delta_{nm}A_{n}.
\end{equation}


\section{Geometric Algebra I}

\subsection{Scaler Product}

The product $C_{1}D_{1}$ of two grade 1 operators (vectors) can be expressed
as the sum of a symmetric and antisymmetric part of the operator product in
$\mathcal{F}$ i.e.
\begin{equation}
C_{1}D_{1}=\frac{1}{2}\left\{  C_{1}D_{1}+D_{1}C_{1}\right\}  +\frac{1}%
{2}\left\{  C_{1}D_{1}-D_{1}C_{1}\right\}  =\frac{1}{2}\left\{  C_{1}%
,D_{1}\right\}  +\frac{1}{2}\left[  C_{1},D_{1}\right]  =C_{1}\vee D_{1}%
+C_{1}\wedge D_{1},
\end{equation}
which allows one to define a scalar product $(\cdot|\cdot)$ between vectors
as
\begin{equation}
(C_{1}|D_{1})=C_{1}\vee D_{1}=\frac{1}{2}\left\{  C_{1},D_{1}\right\}  .
\end{equation}


The basis $\left\{  \left.  x_{j}\right\vert \,1\leq j\leq2r\right\}  $ is
orthogonal with respect to this scalar product i.e.
\begin{equation}
(x_{j}|x_{k})=x_{j}\vee x_{k}=\frac{1}{2}\left\{  x_{j}x_{k}+x_{k}%
x_{j}\right\}  =\left\{  x_{j},x_{k}\right\}  =\frac{1}{2}\delta
_{jk}I_{\mathcal{F}};1\leq j\leq2r,
\end{equation}
but not normalized. One can define normalized vectors by
\begin{equation}
\tilde{x}_{j}=\sqrt{2}x_{j};1\leq j\leq2r,
\end{equation}
but these vectors do not satisfy the CAR as
\[
\left\{  \tilde{x}_{j},\tilde{x}_{k}\right\}  =2\delta_{jk}I_{\mathcal{F}}.
\]


One can expand any two vectors $C_{1}$ and $D_{1}$ in terms of this
orthonormal basis as
\begin{align}
C_{1}  &  =\sum_{1\leq j\leq2r}c_{j}\tilde{x}_{j}\\
D_{1}  &  =\sum_{1\leq j\leq2r}d_{j}\tilde{x}_{j}%
\end{align}
and obtain
\begin{equation}
(C_{1}|D_{1})=(D_{1}|C_{1})=\sum_{1\leq j\leq2r}c_{j}d_{j}I_{\mathcal{F}}.
\end{equation}


The CAR's can then be expressed in terms of this scalar product as
\begin{equation}
\left\{  C_{1},D_{1}\right\}  =\sum_{1\leq j,k\leq2r}c_{j}d_{k}\left\{
\tilde{x}_{j},\tilde{x}_{k}\right\}  I_{\mathcal{F}}=\sum_{1\leq j\leq2r}%
c_{j}d_{j}I_{\mathcal{F}}=2(C|D).
\end{equation}


The invariance group of the scalar product $(\cdot|\cdot)$ is $O\left(
2r,\mathbb{C}\right)  .$

One can define a quadratic function $Q$ in terms of this scalar product by
\begin{equation}
Q\left(  C_{1}\right)  =\left(  C_{1}\left\vert C_{1}\right.  \right)
\end{equation}
and then one can recover the scalar product by using the polarization
identity
\begin{equation}
\left(  C_{1}\left\vert D_{1}\right.  \right)  =Q\left(  C_{1}+D_{1}\right)
-Q\left(  C_{1}\right)  -Q\left(  D_{1}\right)  .
\end{equation}


\subsection{Contraction}

Left and right contraction are defined by
\begin{align*}
v\rfloor D  &  =\frac{1}{2}\left\{  vD-\hat{D}v\right\} \\
v\lfloor D  &  =\frac{1}{2}\left\{  Dv-v\hat{D}\right\}  ,
\end{align*}
where the \emph{grade involution operation }%
\[
\widehat{}:D\rightarrow\hat{D},
\]
is defined by
\begin{align*}
D  &  =\sum_{0\leq n\leq2r}D_{n}\\
\hat{D}_{n}  &  =\left(  -1\right)  ^{n}D_{n}.
\end{align*}
The scaler product is a special case of contraction i.e.
\[
\left(  C_{1}\left\vert D_{1}\right.  \right)  =\frac{1}{2}\left\{  C_{1}%
D_{1}-\left(  -1\right)  ^{1}D_{1}C_{1}\right\}  .
\]


Contraction can be generalized to act between any elements of the G{}A by
\begin{align}
A\rfloor B  &  =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q}\\
A\lfloor B  &  =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{q-p}.
\end{align}


\subsection{Wedge Product}

