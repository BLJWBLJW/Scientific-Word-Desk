\subsection{Grassmann Powers}

The identity
\begin{equation}
A\wedge B=\left(  -1\right)  ^{pq}B\wedge A,
\end{equation}
where
\begin{equation}
A=\left\langle A\right\rangle _{p},B=\left\langle B\right\rangle _{q}%
\end{equation}
gives
\begin{equation}
A\wedge A=\left(  -1\right)  ^{p^{2}}A\wedge A
\end{equation}
thus if $p^{2}$ is odd then
\begin{equation}
A\wedge A=0,
\end{equation}
i.e.
\begin{equation}
A\wedge A=0;p=1,3,5,\cdots
\end{equation}


\begin{enumerate}
