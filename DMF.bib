@ARTICLE{Staroverov02,
  author = {V.N. Staroverov and G.E. Scuseria},
  month = {8 Aug. 2002},
  year = 2002,
  title = {Assessment of simple exchange-correlation energy functionals of the
          one-particle density matrix},
  journal = {J. Chem. Phys.},
  volume = 117,
  number = 6,
  pages = {2489-95},
  publisher = {AIP},
  abstract = {An improved density matrix functional (DMF) combining the
             properties of the 'corrected Hartree' (CH) and 'corrected
             Hartree-Fock' (CHF) approximations is proposed. Functionals of
             the CH/CHF type and the closely related natural orbital
             functional of Goedecker and Umrigar (GU) are tested in fully
             variational finite basis set calculations of light atoms, the
             lowest energy singlet methylene, and, for the first time,
             potential energy curves of diatomic molecules. Although
             CH/CHF-style DMFs may give reasonable energies for atoms and
             molecules near equilibrium geometries, they predict
             unrealistically shallow minima in the potential energy curves for
             diatomic molecules with more than two electrons. The calculated
             CH and CHF molecular dissociation curves exhibit the same
             patterns of over- and under-correlations as the corresponding
             correlation energy plots for the homogeneous electron gas
             undergoing a transition from high to low densities. In contrast,
             the GU functional yields not only accurate atomic and molecular
             energies but also plausible dissociation curves. The reasons
             behind the observed performance are analyzed.},
  keywords = {Atomic structure; HF calculations; Molecular electronic states;
             Orbital calculations; Potential energy surfaces; Variational
             techniques; Simple exchange-correlation energy functionals;
             Corrected Hartree approximations; Corrected Hartree-Fock
             approximations; Natural orbital functional; Fully variational
             finite basis set calculations; Light atoms; Lowest energy singlet
             methylene; Potential energy curves; Diatomic molecules;
             Equilibrium geometries; Unrealistically shallow minima;
             Homogeneous electron gas; Molecular dissociation curves;
             Correlations; Correlation energy plots; Atomic energies;
             Dissociation curves; Energy functional; Molecular energies},
  language = {English}
}

@ARTICLE{Yasuda02,
  author = {K. Yasuda},
  month = {4 Feb. 2002},
  year = 2002,
  title = {Local approximation of the correlation energy functional in the
          density matrix functional theory},
  journal = {Phys. Rev. Lett.},
  volume = 88,
  number = 5,
  pages = {053001/1-4},
  publisher = {APS},
  abstract = {A local approximation formula of the correlation energy
             functional E/sub c/ in terms of the first-order reduced density
             matrix (1-RDM) is presented. With the contracted Schrodinger
             equation the principal dependence of E/sub c/ on the natural
             occupation numbers n/sub i/ is identified. Using the effective
             mass theory, E/sub c/ is expressed as a functional of the local
             density and the local variable, J= Sigma /sub i/ square root
             (n/sub i/(1-n/sub i/)| phi /sub i/|/sup 2/), where phi /sub i/
             are the natural spin orbitals. This local approximation satisfies
             the homogeneous coordinate scaling relation, gives the exact
             result for a one-electron system, and is almost free from the
             exchange energy error. It reproduced about 90% of the correlation
             energies of atoms and molecules.},
  keywords = {Density functional theory; Effective mass; Exchange interactions
             [electron]; Ground states; Schrodinger equation; Local
             approximation formula; Correlation energy functional; First-order
             reduced density matrix; Contracted Schrodinger equation; Natural
             occupation numbers; Effective mass theory; Local density; Local
             variable; Spin orbitals; Homogeneous coordinate scaling relation;
             One-electron system; Exchange energy error},
  language = {English}
}

@ARTICLE{Cioslowski02,
  author = {J. Cioslowski and K. Pernal},
  month = {22 March 2002},
  year = 2002,
  title = {Density matrix functional theory of weak intermolecular
          interactions},
  journal = {J. Chem. Phys.},
  volume = 116,
  number = 12,
  pages = {4802-7},
  publisher = {AIP},
  abstract = {The known asymptotic behavior of the total energy of two weakly
             interacting systems imposes stringent conditions on the
             exchange-correlation energy as a functional of the one-electron
             reduced density matrix. Although the first-order conditions that
             involve Coulomb-type two-electron integrals are relatively
             trivial to satisfy, the exact functional should also conform to
             two second-order expressions, and consequently to certain sum
             rules. The primitive natural spin-orbital functionals satisfy the
             first-order conditions but, lacking terms quadratic in
             two-electron integrals, are found to be incapable of recovering
             the dispersion component of the interaction energy. Violating the
             sum rules, the recently proposed Yasuda functional yields
             nonvanishing dispersion energy with spurious asymptotic terms
             that scale like inverse fourth and fifth powers of the
             intersystem distance.},
  keywords = {Density functional theory; Intermolecular mechanics; Density
             matrix functional theory; Weak intermolecular interactions;
             Asymptotic behavior; Total energy; Exchange-correlation energy;
             One-electron reduced density matrix; First-order conditions;
             Coulomb-type two-electron integrals; Exact functional;
             Second-order expressions; Primitive natural spin-orbital
             functionals; Two-electron integrals; Sum rules; Yasuda
             functional; Dispersion energy; Intersystem distance},
  language = {English}
}

@ARTICLE{Cioslowski01,
  author = {J. Cioslowski and P. Ziesche and K. Pernal},
  month = {15 Nov. 2001},
  year = 2001,
  title = {Description of a high-density homogeneous electron gas with the
          Yasuda density matrix functional},
  journal = {J. Chem. Phys.},
  volume = 115,
  number = 19,
  pages = {8725-30},
  publisher = {AIP},
  abstract = {Description of a spin-unpolarized homogeneous electron gas with
             the Yasuda functional applied to the exact 1-matrix gives rise to
             a formalism that correctly accounts for the logarithmic
             divergence of the correlation energy per volume at the
             high-density limit. The linear dependence of the on-top pair
             distribution function for antiparallel spins on the r/sub S/
             parameter is also correctly reproduced. A comparison of the
             relevant proportionality constant with its exact counterpart
             fixes the value of the adjustable parameter that enters the
             Yasuda functional.},
  keywords = {Electron gas; High-density homogeneous electron gas; Yasuda
             density matrix functional; Spin-unpolarized homogeneous electron
             gas; I-matrix; Logarithmic divergence; Correlation energy;
             High-density limit; Linear dependence; On-top pair distribution
             function; Antiparallel spins; R/sub S/ parameter; Proportionality
             constant; Adjustable parameter; Yasuda functional},
  language = {English}
}

@ARTICLE{Manby01,
  author = {F.R. Manby and P.J. Knowles and A.W. Lloyd},
  month = {2 March 2001},
  year = 2001,
  title = {Density matrix functional theory in average and relative
          coordinates},
  journal = {Chem. Phys. Lett.},
  volume = 335,
  number = {5-6},
  pages = {409-19},
  publisher = {Elsevier},
  abstract = {A general density matrix functional theory is formulated in
             terms of a basis representation of the density matrix in average
             (R=(r/sub 1/+r/sub 2/)/2) and relative (r=r/sub 2/-r/sub 1/)
             coordinates. This representation involves a parameter set whose
             dimension by construction grows strictly linearly with system
             size. Furthermore, the two-electron Coulomb and exchange
             contributions to the Hartree-Fock and Kohn-Sham energies
             factorize, and can be computed with reference only to two-index
             integrals. The problem of N-representability is addressed and
             solutions are presented. Kinetic energy transpires to be the
             hardest term to compute accurately, and three different
             approaches are discussed. The subtle relationship between
             N-representability and kinetic energy is investigated.},
  keywords = {Density functional theory; HF calculations; Minimisation;
             Molecular electronic states; Orbital calculations; Variational
             techniques; Density matrix functional theory; Relative
             coordinates; Average and relative coordinates; General density
             matrix functional theory; Basis representation; Density matrix;
             Average coordinates; Parameter set; Construction dimension;
             System size; Two-electron Coulomb contributions; Exchange
             contributions; Hartree-Fock energies; Kohn-Sham energies;
             Two-index integrals; N-representability; Kinetic energy},
  language = {English}
}

@ARTICLE{Yasuda01,
  author = {K. Yasuda},
  month = {March 2001},
  year = 2001,
  title = {Correlation energy functional in the density-matrix functional
          theory},
  journal = {Phys. Rev. A},
  volume = 63,
  number = 3,
  pages = {032517/1-11},
  publisher = {APS through AIP},
  abstract = {A new systematic method is presented to construct a correlation
             energy functional in the density-matrix functional theory. A new
             exact relation, particle-hole symmetry, is presented, which
             states that the exact functional gives the same correlation
             energy for the first-order reduced density matrix (1-RDM) and the
             corresponding hole 1-RDM. Nakatsuji's density equations of the
             first and the second orders together with the decoupling
             approximation of the 3- and 4-RDMs are solved numerically to
             examine the properties of the correlation energy functional. This
             functional, defined as the solution of the set of equations,
             satisfies Levy's homogeneous coordinate scaling and the
             particle-hole symmetry and reproduces about 95% of the
             correlation energies of several molecules. By expanding these
             equations in perturbation series the leading term of the
             correlation energy functional is identified. Numerical analysis
             shows that this simplified functional, which contains one fitting
             parameter, reproduces the energies of several molecules
             accurately. The direction of further study is discussed.},
  keywords = {Density functional theory; Matrix algebra; Perturbation theory;
             Correlation energy functional; Density-matrix functional theory;
             Systematic method; Density matrix functional theory; Exact
             relation particle-hole symmetry; Exact functional; Correlation
             energy; First-order reduced density matrix; Nakatsuji's density
             equations; Decoupling approximation; Levy's homogeneous
             coordinate scaling; Particle-hole symmetry; Correlation energies;
             Perturbation series; Numerical analysis},
  language = {English}
}

@ARTICLE{Schulz00,
  author = {M.F. Schulz and V. Chernyak and S. Mukamel},
  month = {1 Sept. 2000},
  year = 2000,
  title = {Coherent-state representation of reduced density matrices of
          correlated electronic systems},
  journal = {Chem. Phys. Lett.},
  volume = 327,
  number = {1-2},
  pages = {29-37},
  publisher = {Elsevier},
  abstract = {The one-particle reduced density matrix of correlated electronic
             systems is computed by expressing the many-electron wavefunction
             as a superposition of generalized coherent states, each
             representing a single Slater determinant. This representation
             could be used for developing a density matrix functional theory.
             The sensitivity of the density matrix to the parameters is
             demonstrated.},
  keywords = {Density functional theory; Determinants; Matrix algebra;
             Coherent-state representation; Reduced density matrices;
             Correlated electronic systems; One-particle reduced density
             matrix; Many-electron wavefunction; Superposition of generalized
             coherent states; Slater determinant; Density matrix functional
             theory},
  language = {English}
}

@article{Weitao Yang; Yingkai Zhang; Ayers00,
	author = {Weitao Yang and Yingkai Zhang and P.W. Ayers},
	title = {Degenerate ground states and a fractional number of electrons in density and reduced density matrix functional theory},
	journal = {Physical Review Letters},
	volume = {84},
	number = {22},
	pages = {5172-5},
	publisher = {APS},
	month = {29 May 2000},
	year = {2000},
	keywords = {Density functional theory; Ground states; Degenerate ground states; Fractional number electrons; Density functional theory; Reduced density matrix functional theory; Electron densities; Energy functional; Ground state energy; Ground state densities; Interaction energy; Kinetic energy; Grand canonical ensemble formulation},
	language = {English},
	abstract = {For a linear combination of electron densities of degenerate ground states, it is shown that the value of any energy functional is the ground state energy, if the energy functional is exact for ground state densities, size consistent, and translational invariant. The corresponding functional of kinetic and interaction energy is the linear combination of the functionals of the degenerate densities. Without invoking ensembles, it is shown that the energy functional of fractional number electrons is a series of straight lines interpolating its values at integers. These results underscore the importance of grand canonical ensemble formulation in density functional theory.}
}

@ARTICLE{Holas99,
  author = {A. Holas},
  month = {May 1999},
  year = 1999,
  title = {Properties of the Goedecker-Umrigar functional for the
          many-electron problem and its generalization},
  journal = {Phys. Rev. A},
  volume = 59,
  number = 5,
  pages = {3454-61},
  publisher = {APS through AIP},
  abstract = {The calculational scheme for an approximate ground-state energy
             of a many-electron system, recently proposed by Goedecker and
             Umrigar (GU) [Phys. Rev. Lett. 81, 866 (1998)], is analyzed in
             terms of the reduced-density-matrix approach. Its underlying
             object, the GU density-matrix functional, is generalized,
             possibly leading to improved energies. Properties of the
             solutions of the ground-state problem obtained from the original
             and the generalized GU functionals are established.},
  keywords = {Atomic structure; Density functional theory; Fermion systems;
             Ground states; HF calculations; Molecular electronic states;
             Goedecker-Umrigar functional; Many-electron problem;
             Calculational scheme; Ground-state energy; Many-electron system;
             Reduced-density-matrix approach; Density matrix functional;
             Ground-state problem},
  language = {English}
}

@ARTICLE{Johnsen96,
  author = {K. Johnsen and J. Yngvason},
  month = {Sept. 1996},
  year = 1996,
  title = {Density-matrix-functional calculations for matter in strong
          magnetic fields: ground states of heavy atoms},
  journal = {Phys. Rev. A},
  volume = 54,
  number = 3,
  pages = {1936-46},
  publisher = {APS through AIP},
  abstract = {We report on a numerical study of the density matrix functional
             introduced by Lieb, Solovej, and Yngvason (1994) for the
             investigation of heavy atoms in high magnetic fields. This
             functional describes exactly the quantum mechanical ground state
             of atoms and ions in the limit when the nuclear charge Z and the
             electron number N tend to infinity with N/Z fixed, and the
             magnetic field B tends to infinity in such a way that B/Z/sup
             4/3/ to infinity . We have calculated electronic density profiles
             and ground-state energies for values of the parameters that
             prevail on neutron star surfaces and compared them with results
             obtained by other methods. For iron at B=10/sup 12/ G the
             ground-state energy differs by less than 2% from the Hartree-Fock
             value. We have also studied the maximal negative ionization of
             heavy atoms in this model at various field strengths. In contrast
             to Thomas-Fermi type theories atoms can bind excess negative
             charge in the density matrix model. For iron at B=10/sup 12/ G
             the maximal excess charge in this model corresponds to about one
             electron.},
  keywords = {Density functional theory; Ground states; Magnetic field
             effects; Density matrix functional; Matter in strong magnetic
             fields; Ground state energies; Heavy atoms; Quantum mechanical
             ground state; Nuclear charge; Electron number; Electronic density
             profiles; Fe; Neutron star surfaces; Density matrix model;
             Hartree-Fock value; Maximal negative ionization; Field strengths;
             Excess negative charge; Maximal excess charge; Numerical
             minimisation; Homogeneous magnetic field},
  language = {English}
}

@ARTICLE{Morrison89,
  author = {R.C. Morrison},
  year = 1989,
  title = {An explicit density matrix functional of the (N-1)-particle system
          when the N-particle system is known},
  journal = {Int. J. Quantum Chem., Quantum Chemistry Symposia},
  number = {no.23},
  pages = {583-90},
  note = {From conference: International Symposium on Quantum Chemistry,
         Solid-State Theory and Molecular Dynamics, 1-8 April 1989},
  abstract = {An explicit 1-particle density matrix functional is derived for
             the ground state of an (N-1)-particle system when the ground
             state wavefunction of the N-particle system is known. The
             extended Koopmans' theorem is used to express the (N-1)-particle
             wavefunction in terms of the N-particle wavefunction. The
             electron repulsion part of the energy expression is an integral
             of a product of the 1-particle density matrix of the
             (N-1)-particle system and an explicit function that contains
             correlation and exchange information from the N-particle system.},
  keywords = {Density functional theory; Eigenvalues and eigenfunctions;
             Statistical mechanics; Explicit density matrix functional;
             (N-1)-particle system; N-particle system; Ground state;
             Wavefunction; Extended Koopmans' theorem; Electron repulsion;
             Correlation; Exchange information},
  language = {English},
  location = {St. Augustine, FL, USA}
}

@ARTICLE{Wunsche80,
  author = {H.-J. Wunsche and K. Henneberger},
  month = {1 July 1980},
  year = 1980,
  title = {A density-matrix functional approach to bound multiexciton
          complexes},
  journal = {Physica Stat. Solidi B},
  volume = 100,
  number = 1,
  pages = {191-200},
  abstract = {A general Hamiltonian is introduced describing multiexciton
             complexes bound to impurities in semiconductors. Band couplings
             by the impurity potential as, e.g., the valley-orbit or
             intervalence band couplings in cubic many-valley semiconductors
             are involved and require a generalization of the conventional
             density-functional formalism (DFF). Therefore, instead of the
             usual densities, the reduced one-particle density matrices of the
             electrons and holes are introduced as basic quantities. Within
             the resulting density-matrix functional formalism (DMFF) the
             inhomogeneous multiparticle systems are also described by a
             system of selfconsistent one-particle equations. Some general
             properties of these equations are discussed, especially the
             consequences concerning the shell structure of bound multiexciton
             complexes. In case of uncoupled bands they are shown to transform
             into the conventional Kohn-Sham equations.},
  keywords = {Excitonic molecules; Many-valley semiconductors; Bound
             multiexciton complexes; Hamiltonian; Impurity potential;
             Intervalence band couplings; Inhomogeneous multiparticle systems;
             Shell structure; Uncoupled bands; Density matrix functional
             formalism; Band couplings; Many valley semiconductors; Valley
             orbit couplings; Kohn Sham equations; One particle density
             matrices},
  language = {English}
}

