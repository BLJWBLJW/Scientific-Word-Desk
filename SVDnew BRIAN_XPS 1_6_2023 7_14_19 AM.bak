\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  v\right)
_{k}e_{j\ }\right)  =%
%TCIMACRO{\dsum \limits_{1\leq k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(
v\right)  _{k}}e_{j\ }=\left[  \sigma_{e}h\sigma_{e}\right]  \left(  v\right)
\end{align}


\begin{lemma}
The value of $\mathfrak{h}$ is basis independent
\begin{equation}%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  h\right)  _{jk}\mathcal{R}_{e}\left(  \sigma_{e}\left(
v_{1}\right)  \right)  _{j}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{f}\left(  h\right)  _{jk}\mathcal{R}_{f}\left(  \sigma_{f}\left(
v_{1}\right)  \right)  _{j}\mathcal{R}_{f}\left(  v_{2}\right)  _{k}.
\end{equation}

\end{lemma}

\begin{lemma}
The form $\mathfrak{h}$ can always be generated by an element of the
sesquilinear symmetric tensor product space $\mathcal{\sigma}_{e}^{d}\left(
V^{d}\right)  \vee V^{d}$ where the sesquilinear symmetric tensor product
space is given by
\begin{equation}
\mathcal{\sigma}_{e}^{d}\left(  V^{d}\right)  \vee\left(  V^{d}\right)
=\mathbb{C}\text{-}\operatorname*{linspan}\left\{  \left.  \mathcal{\sigma
}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}^{d}\right\vert 1\leq j\leq
r,1\leq k\leq r\right\}  ,
\end{equation}
where
\begin{equation}
\mathcal{S}_{2}\left(  \mathcal{\sigma}_{e}^{d}\left(  e_{j}^{d}\right)
\otimes e_{k}^{d}\right)  =\mathcal{\sigma}_{e}^{d}\left(  e_{j}^{d}\right)
\vee e_{k}^{d}=\frac{1}{2}\left(  \mathcal{\sigma}_{e}^{d}\left(  e_{j}%
^{d}\right)  \otimes e_{k}^{d}\right)  +\left(  e_{k}^{d}\otimes
\mathcal{\sigma}_{e}^{d}\left(  e_{j}^{d}\right)  \right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\mathcal{\sigma}_{e}^{d}\left(  v_{1}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{\sigma}_{e}%
^{d}\left(  e_{j}^{d}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}e_{j}^{d}%
\end{equation}%
\begin{align}
\mathcal{\sigma}_{e}\left(  v_{1}\right)  \vee v_{2} &  =\frac{1}{2}\left(
\mathcal{\sigma}_{e}\left(  v_{1}\right)  \otimes v_{2}\right)  +\left(
v_{2}\otimes\mathcal{\sigma}_{e}\left(  v_{1}\right)  \right)  \\
&  =\frac{1}{2}\left(  \left(
%TCIMACRO{\dsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}e_{j}\right)  \otimes
v_{2}\right)  +\left(  v_{2}\otimes\left(
%TCIMACRO{\dsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}e_{j}\right)  \right)  \\
&  =\frac{1}{2}\left(  \left(
%TCIMACRO{\dsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}e_{j}\right)  \otimes%
%TCIMACRO{\dsum \limits_{1\leq k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{k}e_{k}\right)  +\left(
%TCIMACRO{\dsum \limits_{1\leq k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{k}e_{k}\otimes\left(
%TCIMACRO{\dsum \limits_{1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}e_{j}\right)  \right)  \\
&  =\frac{1}{2}\left(
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{R}_{e}\left(
v_{2}\right)  _{k}e_{j}\otimes e_{k}\right)  +\left(
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\overline{\mathcal{R}_{e}\left(
v_{1}\right)  _{j}}e_{k}\otimes e_{j}\right)  \\
&  =\frac{1}{2}%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\left\{  \overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{R}%
_{e}\left(  v_{2}\right)  _{k}+\mathcal{R}_{e}\left(  v_{2}\right)
_{j}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{k}}\right\}  e_{j}\otimes
e_{k}%
\end{align}%
\begin{equation}
\end{equation}%
\begin{align}
\mathfrak{h}\left(  v_{1},v_{2}\right)   &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j}^{d}\left(  \sigma_{e}\left(  v_{1}\right)  \right)  \mathcal{R}%
_{e}\left(  h\right)  _{jk}e_{k}^{d}\left(  v_{2}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{R}_{e}\left(
h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}\\
\mathfrak{h}\left(  v_{2},v_{1}\right)   &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
e_{j}^{d}\left(  \sigma_{e}\left(  v_{2}\right)  \right)  \mathcal{R}%
_{e}\left(  h\right)  _{jk}e_{k}^{d}\left(  v_{1}\right)  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{2}\right)  _{j}}\mathcal{R}_{e}\left(
h\right)  _{jk}\mathcal{R}_{e}\left(  v_{1}\right)  _{k}\\
\overline{\mathfrak{h}\left(  v_{2},v_{1}\right)  } &  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{e_{j}^{d}\left(  \sigma_{e}\left(  v_{2}\right)  \right)
\mathcal{R}_{e}\left(  h\right)  _{jk}e_{k}^{d}\left(  v_{1}\right)  }\\
&  =%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\mathcal{R}_{e}\left(  v_{2}\right)  _{j}\mathcal{R}_{e}\left(  h\right)
_{kj}\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{k}}=%
%TCIMACRO{\dsum \limits_{1\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{1\leq j,k\leq r}}
%EndExpansion
\overline{\mathcal{R}_{e}\left(  v_{1}\right)  _{j}}\mathcal{R}_{e}\left(
h\right)  _{jk}\mathcal{R}_{e}\left(  v_{2}\right)  _{k}=\mathfrak{h}\left(
v_{1},v_{2}\right)  .
\end{align}

\end{proof}

\item The forms $\mathfrak{h}$ are explicitly given by
\begin{equation}
\left\langle \left.  v_{1}\right\vert v_{2}\right\rangle _{\mathfrak{h}%
}=\mathfrak{h}\left(  v_{1},v_{2}\right)  =\left[  \sum_{1\leq j\leq
r}\mathcal{K}_{e}^{d}\left(  w_{j}^{d}\right)  \vee x_{j}^{d}\right]  \left(
v_{1}\ ,v_{2}\right)  =\overline{\left[  \sum_{1\leq j\leq r}\mathcal{K}%
_{e}^{d}\left(  w_{j}^{d}\right)  \vee x_{j}^{d}\right]  \left(  v_{2}%
,v_{1}\right)  }=\overline{\mathfrak{h}\left(  v_{2},v_{1}\right)  }%
=\overline{\left\langle \left.  v_{2}\right\vert v_{1}\right\rangle },
\end{equation}
which can be seen from
\begin{equation}
\left[  2\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}^{d}\right]
\left(  v_{1},v_{2}\right)  =\left[  \left(  \mathcal{K}_{e}^{d}\left(
e_{j}^{d}\right)  \otimes e_{k}^{d}\right)  +\left(  e_{k}^{d}\otimes
\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \right)  \right]  \left(
v_{1},v_{2}\right)  =\overline{e_{j}^{d}\left(  v_{1}\right)  }e_{k}%
^{d}\left(  v_{2}\right)  +\overline{e_{k}^{d}\left(  v_{1}\right)  }e_{j}%
^{d}\left(  v_{2}\right)
\end{equation}
and%
\begin{align}
\left[  2\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}^{d}\right]
\left(  v_{2},v_{1}\right)   &  =\left[  \left(  \mathcal{K}_{e}^{d}\left(
e_{j}^{d}\right)  \otimes e_{k}^{d}\right)  +\left(  e_{k}^{d}\otimes
\mathcal{K}^{d}\left(  e_{j}^{d}\right)  \right)  \right]  \left(  v_{2}%
,v_{1}\right)  =\overline{e_{j}^{d}\left(  v_{2}\right)  }e_{k}^{d}\left(
v_{1}\right)  +\overline{e_{k}^{d}\left(  v_{2}\right)  }e_{j}^{d}\left(
v_{1}\right)  \\
&  \Downarrow\\
\overline{\left[  2\mathcal{K}_{e}^{d}\left(  e_{j}^{d}\right)  \vee e_{k}%
^{d}\right]  \left(  v_{2},v_{1}\right)  } &  =e_{j}^{d}\left(  v_{2}\right)
\overline{e_{k}^{d}\left(  v_{1}\right)  }+e_{k}^{d}\left(  v_{2}\right)
\overline{e_{j}^{d}\left(  v_{1}\right)  }=\overline{e_{j}^{d}\left(
v_{1}\right)  }e_{k}^{d}\left(  v_{2}\right)  +\overline{e_{k}^{d}\left(
v_{1}\right)  }e_{j}^{d}\left(  v_{2}\right)  .
\end{align}

\end{enumerate}
\end{enumerate}

\begin{definition}
$\mathfrak{b}$-\emph{biorthogonal} bases sets $\left\{  \left.  e_{j}%
^{b}\right\vert 1\leq j\leq r\right\}  $ and $\left\{  \left.  e_{j}%
\right\vert 1\leq j\leq r\right\}  $ wrt a bilinear form $\mathfrak{b}$ are
bases that have the property
\begin{equation}
\mathfrak{b}\left(  e_{j}^{b},e_{k}\right)  =\delta_{jk},\quad1\leq j,k\leq r.
\end{equation}

\end{definition}

\begin{remark}
If $T\in GL\left(  V\right)  $ then conjugate bilinear forms can be defined
by
\begin{equation}
\left[  \left(  T^{d}\otimes T^{d}\right)  \mathfrak{b}\right]  \left(
v_{1},v_{2}\right)  =\left[  \sum_{1\leq j\leq r}\left(  Tw\right)  _{j}%
^{d}\otimes\left(  Tx\right)  _{j}^{d}\right]  \left(  v_{1}\otimes
v_{2}\right)  =\left[  \sum_{1\leq j\leq r}w_{j}^{d}\otimes x_{j}^{d}\right]
\left(  Tv_{1}\otimes Tv_{2}\right)  .
\end{equation}

\end{remark}

\begin{remark}
A complex nondegenerate bilinear form $\mathfrak{b}$ defines a complex linear
injection $\mathfrak{I}_{\mathfrak{b}}$ from the complex linear space $V$ to
its dual $V^{d}$
\begin{equation}
\mathfrak{I}_{\mathfrak{b}}:V\rightarrow V^{d}%
\end{equation}
given by%
\begin{equation}
w_{1}^{d}=\mathfrak{I}_{\mathfrak{b}}\left(  v_{1}\right)  ,
\end{equation}
where%
\begin{equation}
w_{1}^{d}\left(  v_{2}\right)  =\mathfrak{b}\left(  v_{1},v_{2}\right)
=\left[  \mathfrak{I}_{\mathfrak{b}}\left(  v_{1}\right)  \right]  \left(
v_{2}\right)  ,\quad\forall v_{2}\in V.
\end{equation}

\end{remark}

\begin{definition}
The \emph{Form matrix} $\mathcal{M}_{e}\left(  \mathfrak{b}\right)
\in\mathcal{M}\left(  r,r,\mathbb{C}\right)  $ of $\mathfrak{b}$ wrt a basis
$\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ of $V$ is
\begin{equation}
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{b}\left(  e_{1},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{1},e_{r}\right) \\
\vdots & \ddots & \vdots\\
\mathfrak{b}\left(  e_{r},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{r},e_{r}\right)
\end{array}
\right)  .
\end{equation}

\end{definition}

\begin{lemma}%
\begin{align}
\mathfrak{b}\left(  T\boldsymbol{e},\boldsymbol{e}\right)   &  =\mathcal{R}%
_{e}\left(  T\right)  ^{t}\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}%
\right) \\
\mathfrak{b}\left(  \boldsymbol{e},T\boldsymbol{e}\right)   &  =\mathfrak{b}%
\left(  \boldsymbol{e},\boldsymbol{e}\right)  \mathcal{R}_{e}\left(  T\right)
.
\end{align}

\end{lemma}

\begin{proof}
In terms of matrix elements one has
\begin{equation}
\mathfrak{b}\left(  Te_{p},e_{q}\right)  =\mathfrak{b}\left(  \sum_{1\leq
j\leq r}e_{j}\mathcal{R}_{e}\left(  T\right)  _{jp},e_{q}\right)  =\sum_{1\leq
j\leq r}\mathcal{R}_{e}\left(  T\right)  _{jp}\mathfrak{b}\left(  e_{j}%
,e_{q}\right)  =\sum_{1\leq j\leq r}\mathcal{R}_{e}\left(  T\right)  _{pj}%
^{t}\mathfrak{b}\left(  e_{j},e_{q}\right)
\end{equation}
and
\begin{equation}
\mathfrak{b}\left(  e_{p},Te_{q}\right)  =\mathfrak{b}\left(  e_{p}%
,\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(  T\right)  _{jq},\right)
=\sum_{1\leq j\leq r}\mathfrak{b}\left(  e_{p},e_{j}\right)  \mathcal{R}%
_{e}\left(  T\right)  _{jq}.
\end{equation}

\end{proof}

\begin{remark}
The Form matrices wrt different bases $\left(  \boldsymbol{e}\right)  $ and
$\left(  \boldsymbol{f}\right)  ,$ where
\begin{equation}
\left(  \boldsymbol{f}\right)  =T_{fe}\left(  \boldsymbol{e}\right)  =\left(
\boldsymbol{e}\right)  \mathcal{R}_{e}\left(  T_{fe}\right)
\end{equation}
and
\begin{equation}
T_{fe}\in GL\left(  V\right)
\end{equation}
are related by
\begin{equation}
\mathfrak{b}\left(  \boldsymbol{f},\boldsymbol{f}\right)  =\mathfrak{b}\left(
T_{fe}\boldsymbol{e},T_{fe}\boldsymbol{e}\right)  =\mathcal{M}_{f}\left(
\mathfrak{b}\right)  =\mathcal{R}_{e}\left(  T_{fe}\right)  ^{t}%
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  \mathcal{R}_{e}\left(
T_{fe}\right)  =\mathcal{R}_{e}\left(  T_{fe}\right)  ^{t}\mathfrak{b}\left(
\boldsymbol{e},\boldsymbol{e}\right)  \mathcal{R}_{e}\left(  T_{fe}\right)  .
\end{equation}

\end{remark}

\begin{remark}
One can form dual basis $\left(  \boldsymbol{e}^{d}\right)  $ from $\left(
\boldsymbol{e}\right)  $ by forming the biorthogonal basis $\left(
\boldsymbol{e}^{b}\right)  $
\begin{equation}
\left(  \boldsymbol{e}^{b}\right)  =\left(  \left.  \boldsymbol{e}\right\vert
\boldsymbol{e}\right)  ^{-1}\left(  \boldsymbol{e}\right)  =\mathfrak{b}%
\left(  \boldsymbol{e},\boldsymbol{e}\right)  ^{-1}\left(  \boldsymbol{e}%
\right)
\end{equation}
and then defining
\begin{equation}
\boldsymbol{e}^{d}=\mathfrak{I}_{\mathfrak{b}}\left(  \boldsymbol{e}%
^{b}\right)  ,
\end{equation}
where one uses the matrix SVD
\begin{equation}
\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  \equiv
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  =\left(  \mathfrak{I}%
_{\mathfrak{b}}\boldsymbol{e}^{d}\right)  \left(  \boldsymbol{e}\right)
=\mathbb{U}\boldsymbol{\Sigma}\mathbb{V}%
\end{equation}
to obtain the inverse of the form matrix $\mathcal{M}_{e}\left(
\mathfrak{b}\right)  $
\begin{equation}
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  ^{-1}=\left(  \left[
\mathfrak{I}_{\mathfrak{b}}\left(  \overset{}{\boldsymbol{e}^{d}}\right)
\right]  \left(  \overset{}{\boldsymbol{e}}\right)  \right)  ^{-1}%
=\mathbb{V}^{\dagger}\boldsymbol{\Sigma}^{-1}\mathbb{U}^{\dagger}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{gather}
\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  \equiv\left(
\left.  \boldsymbol{e}\right\vert \boldsymbol{e}\right)  =\mathcal{M}%
_{e}\left(  \mathfrak{b}\right) \\
\left(  \boldsymbol{e}^{d}\right)  =\mathfrak{I}_{\mathfrak{b}}\left(  \left(
\boldsymbol{e}\right)  \left(  \left.  \boldsymbol{e}\right\vert
\boldsymbol{e}\right)  ^{-1}\right)  =\mathfrak{I}_{\mathfrak{b}}\left(
\left(  \boldsymbol{e}\right)  \mathfrak{b}\left(  \boldsymbol{e}%
,\boldsymbol{e}\right)  ^{-1}\right)  =\mathfrak{I}_{\mathfrak{b}}\left(
\left(  \boldsymbol{e}^{b}\right)  \right)  .
\end{gather}

\end{remark}

\begin{conjecture}
For each $\left(  \boldsymbol{e}\right)  $ the dual basis $\left(
\boldsymbol{e}^{d}\right)  $ is unique thus the expression $\mathfrak{I}%
_{\mathfrak{b}}\left(  \left(  \boldsymbol{e}\right)  \mathfrak{b}\left(
\boldsymbol{e},\boldsymbol{e}\right)  ^{-1}\right)  $ is independent of
$\mathfrak{b.}$
\end{conjecture}

\begin{remark}%
\begin{equation}
\mathfrak{b}\left(  \boldsymbol{e},\boldsymbol{e}\right)  \equiv
\mathcal{M}_{e}\left(  \mathfrak{b}\right)  =\left(
\begin{array}
[c]{ccc}%
w_{1}^{d}\left(  e_{1}\right)  & \cdots & w_{1}^{d}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
w_{r}^{d}\left(  e_{1}\right)  & \cdots & w_{r}^{d}\left(  e_{r}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{I}_{\mathfrak{b}}\left(  e_{1}\right)  \left(  e_{1}\right)  &
\cdots & \mathfrak{I}_{\mathfrak{b}}\left(  e_{1}\right)  \left(  e_{r}\right)
\\
\vdots & \ddots & \vdots\\
\mathfrak{I}_{\mathfrak{b}}\left(  e_{r}\right)  \left(  e_{1}\right)  &
\cdots & \mathfrak{I}_{\mathfrak{b}}\left(  e_{r}\right)  \left(
e_{r}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{b}\left(  e_{1},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{1},e_{r}\right) \\
\vdots & \ddots & \vdots\\
\mathfrak{b}\left(  e_{r},e_{1}\right)  & \cdots & \mathfrak{b}\left(
e_{r},e_{r}\right)
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{remark}
In finite dimensions the injections $\mathfrak{I}_{V}$ are also surjective and
thus are isomorphisms.
\end{remark}

\subparagraph{Representations}

The matrix representation $\mathcal{R}_{e}\left(  A\right)  \in\mathcal{M}%
\left(  m,n,\mathbb{C}\right)  $ of $A\in\mathcal{B}\left(  \mathcal{W}%
,\mathcal{V}\right)  $ wrt bases $\left\{  \left.  e_{j}\right\vert 1\leq
j\leq n\right\}  $ and $\left\{  \left.  f_{j}\right\vert 1\leq j\leq
m\right\}  $ generated by the linear map $A$ can be displayed as
\begin{equation}
A\left(  \boldsymbol{e}\right)  =A\left(  e_{1},\cdots,e_{n}\right)  =\left(
e_{1},\cdots,e_{n}\right)  \mathcal{R}_{e}\left(  A\right)  =\left(
\boldsymbol{f}\right)  =\left(  e_{1},\cdots,e_{m}\right)  \mathcal{M}%
_{f^{d}e}\left(  A\right)  ,
\end{equation}
where the matrices $\mathcal{R}_{e}\left(  A\right)  $ and $\mathcal{M}%
_{f^{d}e}\left(  A\right)  $ are given by
\begin{equation}
\mathcal{R}_{e}\left(  A\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{fe}\left(  A\right)  _{11} & \cdots & \mathcal{R}_{fe}\left(
A\right)  _{1n}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{fe}\left(  A\right)  _{m1} & \cdots & \mathcal{R}_{fe}\left(
A\right)  _{mn}%
\end{array}
\right)  =\mathcal{M}_{f^{d}e}\left(  A\right)
\end{equation}
and%
\begin{equation}
\mathcal{M}_{f^{d}e}\left(  A\right)  =\left(
\begin{array}
[c]{ccc}%
f_{1}^{d}\left(  Ae_{1}\right)  & \cdots & f_{1}^{d}\left(  Ae_{n}\right) \\
\vdots & \ddots & \vdots\\
f_{m}^{d}\left(  Ae_{1}\right)  & \cdots & f_{m}^{d}\left(  Ae_{n}\right)
\end{array}
\right)  =\boldsymbol{f}^{d}\left(  A\boldsymbol{e}\right)  .
\end{equation}


\subparagraph{Tensor Product Spaces}

We consider the tensor product spaces

\begin{enumerate}
\item
\begin{equation}
\mathcal{W}\otimes\mathcal{V}^{d}=\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  f_{j}\otimes e_{k}^{d}\right\vert 1\leq k\leq m,1\leq k\leq
n\right\}
\end{equation}
and

\item
\begin{equation}
\mathcal{W}\otimes\mathcal{V}=\mathbb{C}\text{-}\operatorname*{linspan}%
\left\{  \left.  f_{j}\otimes e_{k}\right\vert 1\leq k\leq m,1\leq k\leq
n\right\}  .
\end{equation}

\end{enumerate}

\begin{definition}
Of the product "\#"
\begin{align}
x\#y^{d}  &  \in\mathcal{B}\left(  \mathcal{W},\mathcal{V}\right) \\
\left(  x\#y^{d}\right)  \left(  v\right)   &  =y^{d}\left(  v\right)
x\quad\forall v\in\mathcal{V},\,\,x\in\mathcal{W},\,y^{d}\in\mathcal{V}^{d}.
\end{align}

\end{definition}

\begin{notation}%
\begin{equation}
E_{xy}\equiv x\#y^{d}.
\end{equation}

\end{notation}

\begin{theorem}
$\left(  \text{Greu\ss }\right)  $ If $a\in\mathcal{W}\otimes\mathcal{V}$
then
\begin{equation}
a=\sum_{1\leq j\leq p}w_{j}\otimes v_{j}\quad\in\mathcal{W}\otimes
\mathcal{V},\quad w_{j}\in\mathcal{W},v_{j}\in\mathcal{V},\mathcal{\quad}1\leq
j\leq p,
\end{equation}
where $p=\min\left(  m,n\right)  $, $\left\{  \left.  w_{j}\right\vert 1\leq
j\leq p\right\}  $ and $\left\{  \left.  v_{j}\right\vert 1\leq k\leq
p\right\}  $ are linearly independent sets of vectors in $\mathcal{W}$ and
$\mathcal{V}$ respectively.
\end{theorem}

\begin{corollary}
If $\mathcal{W}$ and $\mathcal{V}$ are normed spaces one can express
$a\in\mathcal{W}\otimes\mathcal{V}$ in terms of normed vectors as
\begin{equation}
a=\sum_{1\leq j\leq p}\sigma_{j}\widetilde{w_{j}}\otimes\widetilde{v_{j}},
\end{equation}
where

\begin{enumerate}
\item
\begin{equation}
\left\Vert \widetilde{w_{j}}\right\Vert _{\mathcal{W}}=\left\Vert
\widetilde{v_{j}}\right\Vert _{\mathcal{V}}=1,\quad1\leq j\leq p.
\end{equation}


\item
\begin{align}
\widetilde{w_{j}}  &  =\frac{w_{j}}{\left\Vert w_{j}\right\Vert _{\mathcal{W}%
}}\\
\widetilde{v_{j}}  &  =\frac{v_{j}}{\left\Vert v_{j}\right\Vert _{\mathcal{W}%
}}\\
1  &  \leq j\leq p.
\end{align}


\item
\begin{equation}
\sigma_{j}>0,\quad1\leq j\leq p.
\end{equation}

\end{enumerate}
\end{corollary}

\begin{theorem}
The spaces $\mathcal{B}_{00}\left(  \mathcal{W},\mathcal{V}\right)
$,$\mathcal{W}\otimes\mathcal{V}^{d}$ and $\mathcal{W}\otimes\mathcal{V}$ are
linearly isomorphic i.e.
\begin{equation}
\mathcal{B}_{00}\left(  \mathcal{W},\mathcal{V}\right)  \cong\mathcal{W}%
\otimes\mathcal{V}^{d}\cong\mathcal{W}\otimes\mathcal{V},
\end{equation}
where the isomorphisms, denoted by $\Upsilon,$ and $\Xi$ are given by
\end{theorem}

\begin{enumerate}
\item
\begin{gather}
\Upsilon:\mathcal{W}\otimes\mathcal{V}^{d}\rightarrow\mathcal{B}_{00}\left(
\mathcal{W},\mathcal{V}\right) \\
\Upsilon\left(  f_{j}\otimes e_{k}^{d}\right)  =f_{j}\#e_{k}^{d}\equiv E_{fe}.
\end{gather}
and

\item
\begin{gather}
\Xi:\mathcal{W}\otimes\mathcal{V}\rightarrow\mathcal{B}_{00}\left(
\mathcal{W},\mathcal{V}\right) \\
\Xi\left(  f_{j}\otimes e_{k}\right)  =f_{j}\#e_{k}^{d}\equiv E_{fe}.
\end{gather}

\end{enumerate}

\begin{lemma}
The mapping $A\in\mathcal{B}_{00}\left(  \mathcal{W},\mathcal{V}\right)  $ can
be expanded as
\[
A=\sum_{1\leq j\leq p}E_{\eta_{j}\varsigma_{j}}=\sum_{1\leq j\leq p}\eta
_{j}\#\varsigma_{j}^{d}=\sum_{1\leq j\leq p}\widetilde{\eta_{j}}\#\left(
\sigma_{j}\widetilde{\varsigma_{j}}^{d}\right)  =\sum_{1\leq j\leq p}%
\sigma_{j}\widetilde{\eta}_{j}^{d}\#\widetilde{\varsigma}_{j}=\left(
\widetilde{\boldsymbol{\eta}}\right)  \mathcal{R}_{\boldsymbol{\varsigma}%
}\left(  A\right)  \left(  \widetilde{\boldsymbol{\varsigma}}^{d}\right)
^{t}=\left(  \widetilde{\boldsymbol{\eta\#\varsigma}^{d}}\right)
\cdot\mathcal{R}_{\boldsymbol{\varsigma}}\left(  A\right)  ,
\]
where
\begin{equation}
\widetilde{\eta_{j}}=\sigma_{j}^{\frac{1}{2}}\eta_{j}%
\end{equation}
and
\begin{equation}
\widetilde{\varsigma_{j}}=\sigma_{j}^{\frac{1}{2}}\varsigma_{j}.
\end{equation}

\end{lemma}

\begin{remark}
The expansion of $A$ wrt a general bases is
\begin{equation}
A=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}E_{f_{j}e_{k}}\mathcal{R}%
_{\boldsymbol{e}}\left(  A\right)  _{jk}.
\end{equation}

\end{remark}

If $\mathcal{W}$ and $\mathcal{V}$ are Hilbert spaces

\begin{enumerate}
\item
\begin{align*}
E_{\eta_{j}\varsigma_{k}}  &  =\eta_{j}\#\varsigma_{k}^{d}=\left\vert \eta
_{j}\right\rangle \left\langle \varsigma_{k}\right\vert \in\mathcal{B}\left(
\mathcal{W},\mathcal{V}\right) \\
\left\vert \varsigma_{k}\right\rangle \left\langle \eta_{j}\right\vert  &
=\left\vert \eta_{j}\right\rangle \left\langle \varsigma_{k}\right\vert
^{\dagger}=\left(  E_{\eta_{j}\varsigma_{k}}\right)  ^{\dagger}\in
\mathcal{B}\left(  \mathcal{V},\mathcal{W}\right)  .
\end{align*}


\item Resolutions of the identity%
\begin{align*}
\left\vert \mathbf{u}\right\rangle \left\langle \mathbf{u}\right\vert  &
=I_{\mathcal{W}}\\
\left\vert \mathbf{v}\right\rangle \left\langle \mathbf{v}\right\vert  &
=I_{\mathcal{V}}.
\end{align*}


\item The operator SVD%
\[
\left\vert \mathbf{u}\right\rangle \left\langle \mathbf{u}\right\vert \left(
\overset{}{\left\vert \boldsymbol{\eta}\right\rangle \mathcal{R}%
_{\varsigma\eta}\left(  A\right)  \left\langle \boldsymbol{\varsigma
}\right\vert }\right)  \left\vert \mathbf{v}\right\rangle \left\langle
\mathbf{v}\right\vert =\left\vert \mathbf{u}\right\rangle \left(
\overset{}{\left\langle \mathbf{u}\right\vert \left(  \overset{}{\left\vert
\boldsymbol{\eta}\right\rangle \mathcal{R}_{\varsigma\eta}\left(  A\right)
\left\langle \boldsymbol{\varsigma}\right\vert }\right)  \left\vert
\mathbf{v}\right\rangle }\right)  \left\langle \mathbf{v}\right\vert
=\left\vert \mathbf{u}\right\rangle \mathcal{R}_{uv}\left(  A\right)
\left\langle \mathbf{v}\right\vert .
\]


\item The matrix SVD
\[
\mathcal{R}_{uv}\left(  A\right)  =\left(  \overset{}{\left\langle
\mathbf{u}\right\vert \left\vert \boldsymbol{\eta}\right\rangle }\right)
\left(  \overset{}{\mathcal{R}_{\varsigma\eta}\left(  A\right)  }\right)
\left(  \overset{}{\left\langle \boldsymbol{\varsigma}\right\vert \left\vert
\mathbf{v}\right\rangle }\right)  .
\]


\item Transformation of bases
\begin{align*}
\mathbf{u\#}\boldsymbol{\eta}^{d}  &  =T_{u\eta}=\left\vert \mathbf{u}%
\right\rangle \left\langle \boldsymbol{\eta}\right\vert \in\mathcal{B}\left(
\mathcal{W}\right) \\
\boldsymbol{\eta}\mathbf{\#}\boldsymbol{u}^{d}  &  =T_{u\eta}^{\dagger
}=\left\vert \boldsymbol{\eta}\right\rangle \left\langle \mathbf{u}\right\vert
\in\mathcal{B}\left(  \mathcal{W}\right) \\
\mathbf{v\#}\boldsymbol{\varsigma}^{d}  &  =T_{v\varsigma}=\left\vert
\mathbf{v}\right\rangle \left\langle \boldsymbol{\varsigma}\right\vert
\in\mathcal{B}\left(  \mathcal{V}\right) \\
\boldsymbol{\varsigma}\mathbf{\#v}^{d}  &  =T_{v\varsigma}^{\dagger
}=\left\vert \boldsymbol{\varsigma}\right\rangle \left\langle \mathbf{v}%
\right\vert \in\mathcal{B}\left(  \mathcal{V}\right)
\end{align*}


\item Unitary property%
\begin{align*}
T_{u\eta}T_{u\eta}^{\dagger}  &  =T_{u\eta}^{\dagger}T_{u\eta}=I_{\mathcal{W}%
}\\
T_{v\varsigma}T_{v\varsigma}^{\dagger}  &  =T_{v\varsigma}^{\dagger
}T_{v\varsigma}=I_{\mathcal{V}}.
\end{align*}


\item Representations of bases transformations%
\begin{align*}
\mathcal{R}_{\eta}\left(  T_{u\eta}\right)   &  =\mathcal{M}_{\eta}\left(
\left\vert \mathbf{u}\right\rangle \left\langle \boldsymbol{\eta}\right\vert
\right)  =\mathcal{R}_{\eta}\left(  \left\vert \mathbf{u}\right\rangle
\left\langle \boldsymbol{\eta}\right\vert \right)  =\left\langle \left.
\boldsymbol{\eta}\right\vert \mathbf{u}\right\rangle \in\mathcal{M}\left(
\mathcal{W},\mathcal{W},\mathbb{C}\right)  \equiv\mathcal{M}\left(
m,m,\mathbb{C}\right) \\
\mathcal{R}_{\eta}\left(  T_{u\eta}^{\dagger}\right)   &  =\mathcal{M}_{\eta
}\left(  \left\vert \boldsymbol{\eta}\right\rangle \left\langle \mathbf{u}%
\right\vert \right)  =\mathcal{R}_{\eta}\left(  \left\vert \boldsymbol{\eta
}\right\rangle \left\langle \mathbf{u}\right\vert \right)  =\left\langle
\left.  \boldsymbol{u}\right\vert \boldsymbol{\eta}\right\rangle
\in\mathcal{M}\left(  \mathcal{W},\mathcal{W},\mathbb{C}\right)
\equiv\mathcal{M}\left(  m,m,\mathbb{C}\right) \\
\mathcal{R}_{u}\left(  T_{u\eta}\right)   &  =\mathcal{M}_{u}\left(
\left\vert \mathbf{u}\right\rangle \left\langle \boldsymbol{\eta}\right\vert
\right)  =\mathcal{R}_{u}\left(  \left\vert \mathbf{u}\right\rangle
\left\langle \boldsymbol{\eta}\right\vert \right)  =\left\langle \left.
\boldsymbol{\eta}\right\vert \mathbf{u}\right\rangle \in\mathcal{M}\left(
\mathcal{W},\mathcal{W},\mathbb{C}\right)  \equiv\mathcal{M}\left(
m,m,\mathbb{C}\right) \\
\mathcal{R}_{u}\left(  T_{u\eta}^{\dagger}\right)   &  =\mathcal{M}_{u}\left(
\left\vert \boldsymbol{\eta}\right\rangle \left\langle \mathbf{u}\right\vert
\right)  =\mathcal{R}_{u}\left(  \left\vert \boldsymbol{\eta}\right\rangle
\left\langle \mathbf{u}\right\vert \right)  =\left\langle \left.
\boldsymbol{u}\right\vert \boldsymbol{\eta}\right\rangle \in\mathcal{M}\left(
\mathcal{W},\mathcal{W},\mathbb{C}\right)  \equiv\mathcal{M}\left(
m,m,\mathbb{C}\right) \\
\mathcal{R}_{\varsigma}\left(  T_{v\varsigma}\right)   &  =\mathcal{M}%
_{v}\left(  \left\vert \mathbf{v}\right\rangle \left\langle
\boldsymbol{\varsigma}\right\vert \right)  =\mathcal{R}_{\varsigma}\left(
\left\vert \mathbf{v}\right\rangle \left\langle \boldsymbol{\varsigma
}\right\vert \right)  =\left\langle \left.  \boldsymbol{\varsigma}\right\vert
\mathbf{v}\right\rangle \in\mathcal{M}\left(  \mathcal{V},\mathcal{V}%
,\mathbb{C}\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right) \\
\mathcal{R}_{\varsigma}\left(  T_{v\varsigma}^{\dagger}\right)   &
=\mathcal{M}_{\varsigma}\left(  \left\vert \boldsymbol{\varsigma}\right\rangle
\left\langle \mathbf{v}\right\vert \right)  =\mathcal{R}_{\varsigma}\left(
\left\vert \boldsymbol{\varsigma}\right\rangle \left\langle \mathbf{v}%
\right\vert \right)  =\left\langle \left.  \mathbf{v}\right\vert
\boldsymbol{\varsigma}\right\rangle \in\mathcal{M}\left(  \mathcal{V}%
,\mathcal{V},\mathbb{C}\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right)
\\
\mathcal{R}_{v}\left(  T_{v\varsigma}\right)   &  =\mathcal{M}_{v}\left(
\left\vert \mathbf{v}\right\rangle \left\langle \boldsymbol{\varsigma
}\right\vert \right)  =\mathcal{R}_{v}\left(  \left\vert \mathbf{v}%
\right\rangle \left\langle \boldsymbol{\varsigma}\right\vert \right)
=\left\langle \left.  \boldsymbol{\varsigma}\right\vert \mathbf{v}%
\right\rangle \in\mathcal{M}\left(  \mathcal{V},\mathcal{V},\mathbb{C}\right)
\equiv\mathcal{M}\left(  n,n,\mathbb{C}\right) \\
\mathcal{R}_{v}\left(  T_{v\varsigma}^{\dagger}\right)   &  =\mathcal{M}%
_{v}\left(  \left\vert \boldsymbol{\varsigma}\right\rangle \left\langle
\mathbf{v}\right\vert \right)  =\mathcal{R}_{v}\left(  \left\vert
\boldsymbol{\varsigma}\right\rangle \left\langle \mathbf{v}\right\vert
\right)  =\left\langle \left.  \mathbf{v}\right\vert \boldsymbol{\varsigma
}\right\rangle \in\mathcal{M}\left(  \mathcal{V},\mathcal{V},\mathbb{C}%
\right)  \equiv\mathcal{M}\left(  n,n,\mathbb{C}\right)
\end{align*}

\end{enumerate}

\begin{theorem}
The Singular Valued Decomposition any operator $A\in\mathcal{B}_{0}\left(
\mathcal{W},\mathcal{V}\right)  $ is given by the expansion
\begin{equation}
A=\sum_{1\leq j\leq p}\mathcal{R}_{\varsigma}\left(  A\right)  _{jj}%
E_{\eta_{j}\varsigma_{j}^{d}}=\sum_{1\leq j\leq p}\mathcal{R}_{\varsigma
}\left(  A\right)  _{jj}\eta_{j}\#\varsigma_{j}^{d}=\sum_{1\leq j\leq
p}\mathcal{R}_{\varsigma}\left(  A\right)  _{jj}\Xi\left(  \eta_{j}%
\otimes\varsigma_{j}\right)  =\Xi\left(  \sum_{1\leq j\leq p}\mathcal{R}%
_{\varsigma}\left(  A\right)  _{jj}\eta_{j}\otimes\varsigma_{j}\right)  .
\end{equation}

\end{theorem}

\begin{remark}
\begin{enumerate}
\item
\begin{equation}
A=\left(  \boldsymbol{E}_{\eta\varsigma}\right)  \mathcal{R}_{\varsigma
}\left(  A\right)
\end{equation}


\item
\begin{equation}
\boldsymbol{E}_{uv}=T_{u\eta}\boldsymbol{E}_{\eta\varsigma}T_{v\varsigma}%
^{t}=\left(  \mathbf{u\#}\boldsymbol{\eta}^{d}\right)  \boldsymbol{E}%
_{\eta\varsigma}\left(  \boldsymbol{\varsigma}\mathbf{\#v}^{d}\right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{v}\left(  A\right)  =\mathcal{R}_{\varsigma}\left(  T_{u\eta
}AT_{v\varsigma}^{t}\right)  =\mathcal{R}_{\varsigma}\left(  T_{u\eta}\right)
\mathcal{R}_{\varsigma}\left(  A\right)  \mathcal{R}_{\varsigma}\left(
T_{v\varsigma}^{t}\right)  .
\end{equation}

\end{enumerate}
\end{remark}

\begin{corollary}
In any non canonical bases the operator SVD expansion is
\begin{equation}
A=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\mathcal{R}_{v}\left(
A\right)  _{jk}E_{u_{j}v_{k}}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq
n}}\mathcal{R}_{\varsigma}\left(  T_{u\eta}AT_{v\varsigma}^{t}\right)
_{jk}E_{u_{j}v_{k}}=\sum_{1\leq j\leq p}\mathcal{R}_{\varsigma}\left(
A\right)  _{jj}E_{\eta_{j}\varsigma_{j}}%
\end{equation}

\end{corollary}

\appendix{}

\begin{notation}
Products in super vector notation
\end{notation}

\begin{enumerate}
\item $\left(  \boldsymbol{e}\right)  $-basis scalar sum of scalar products of
vectors
\[
\left(  \boldsymbol{e}^{d}\right)  \cdot\left(  \boldsymbol{e}\right)
^{t}=\left(  e_{1}^{d},\cdots,e_{m}^{d}\right)  \cdot\left(  e_{1}%
,\cdots,e_{m}\right)  ^{t}=\left(  e_{1}^{d},\cdots,e_{m}^{d}\right)
\cdot\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{m}%
\end{array}
\right)  =\sum_{1\leq j\leq n}e_{j}^{d}\left(  e_{j}\right)  =n.
\]


\item $\left(  \boldsymbol{e}\right)  $-basis matrix of scalar products of
vectors%
\begin{align}
\left(  \boldsymbol{e}^{d}\right)  ^{t}\cdot\left(  \boldsymbol{e}\right)   &
=\left(  e_{1}^{d},\cdots,e_{n}^{d}\right)  ^{t}\cdot\left(  e_{1}%
,\cdots,e_{n}\right)  =\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  \cdot\left(  e_{1},\cdots,e_{n}\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
e_{1}^{d}\left(  e_{1}\right)  & \cdots & e_{1}^{d}\left(  e_{n}\right) \\
\vdots & \ddots & \vdots\\
e_{n}^{d}\left(  e_{1}\right)  & \cdots & e_{n}^{d}\left(  e_{n}\right)
\end{array}
\right)  =\mathcal{R}_{e}\left(  I_{\mathcal{W}}\right)  =\mathbb{I}_{n}%
\in\mathcal{M}\left(  n,n,\mathbb{C}\right)  .
\end{align}


\item $\left(  \boldsymbol{e}\right)  $-basis matrix of operator products of
vectors%
\[
\left(  \boldsymbol{e}\right)  \#\left(  \boldsymbol{e}^{d}\right)
^{t}=\left(  e_{1},\cdots,e_{n}\right)  ^{t}\#\left(  e_{1}^{d},\cdots
,e_{n}^{d}\right)  =\left(
\begin{array}
[c]{c}%
e_{1}\\
\vdots\\
e_{n}%
\end{array}
\right)  \#\left(  e_{1}^{d},\cdots,e_{n}^{d}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1}\#e_{1}^{d} & \cdots & e_{n}\#e_{1}^{d}\\
\vdots & \ddots & \vdots\\
e_{1}\#e_{n}^{d} & \cdots & e_{n}\#e_{n}^{d}%
\end{array}
\right)  \in\mathcal{M}\left(  n,n,\mathcal{B}\left(  \mathcal{W}%
,\mathcal{W}\right)  \right)  .
\]


\item $\left(  \boldsymbol{e}\right)  $-basis operator sum of operator
products of vectors%
\begin{equation}
\left(  \boldsymbol{e}\right)  \#\left(  \boldsymbol{e}^{d}\right)
^{t}=\left(  e_{1},\cdots,e_{n}\right)  \#\left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  =\sum_{1\leq j\leq n}e_{j}\#e_{j}^{d}=I_{\mathcal{W}}\in
\mathcal{B}\left(  \mathcal{W},\mathcal{W}\right)  .
\end{equation}

\end{enumerate}


