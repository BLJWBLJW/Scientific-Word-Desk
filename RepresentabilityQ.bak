\sum_{1\leq j\leq r}D_{1jj}=\frac{1}{\left(  N-1\right)  }\sum_{1\leq j,l\leq
r}D_{2jljl}=\frac{1}{\left(  N-1\right)  }N\left(  N-1\right)  =N
\end{equation}


\bigskip

Theorem ([Kad, Pe1]). Let A be a unital C -algebra. Then the extreme

points of the closed unit ball of A are precisely those elements v of A for

which (1 - v$^{\dagger}$v)A(1 - vv$^{\dagger}$) = \{0\}. In this case v is a
partial isometry, i.e.

v$^{\dagger}$v and vv$^{\dagger}$ are projections.

[Kad] R. V. Kadi son, Isometries. of operator algebras, Ann. of Math. 54 (1951),

325--338.

[Pe1] G. K. Pede r s e n, C -Algebras and Their Automorphism Groups, London Math.

Soc. Monographs 13, Academic Press, London, 1979.%
\begin{equation}
\left(  1-a^{\dagger}a\right)  \left(  1-aa^{\dagger}\right)  =1-\left(
a^{\dagger}a+aa^{\dagger}\right)  +a^{\dagger}aaa^{\dagger}=0
\end{equation}%
\begin{align}
a^{\dagger}aa^{\dagger}b  &  =a^{\dagger}\left(  1-a^{\dagger}a\right)
b=a^{\dagger}b\\
a^{\dagger}ba^{\dagger}a  &  =0\\
a^{\dagger}ab^{\dagger}a  &  =0\\
b^{\dagger}aa^{\dagger}a  &  =b^{\dagger}\left(  1-a^{\dagger}a\right)
a=b^{\dagger}a
\end{align}%
\begin{align}
aa^{\dagger}Aa^{\dagger}a  &  =\\
a^{\dagger}aAaa^{\dagger}  &  =a^{\dagger}baa^{\dagger}=a^{\dagger}b\left(
1-a^{\dagger}a\right)  =a^{\dagger}b
\end{align}


\section{Projectors in $\mathcal{B}_{+}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}$}

Are $\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right\}  $ the only projectors? i.e. can
\begin{equation}
g^{\dagger}gg^{\dagger}g=g^{\dagger}g,
\end{equation}
only when
\begin{equation}
g^{\dagger}g\neq a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}?
\end{equation}
First one must determine the commutator%
\begin{equation}
\left[  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger},a_{j_{4}}a_{j_{3}}\right]
\end{equation}
thus one brings $a_{j_{4}}a_{j_{3}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}$ to
normal form as
\begin{align}
&  a_{j_{4}}a_{j_{3}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=a_{j_{4}}\left(
I\delta_{j_{3}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{3}}\right)  a_{j_{2}}^{\dagger
}=a_{j_{4}}a_{j_{2}}^{\dagger}\delta_{j_{3}j_{1}}-a_{j_{4}}a_{j_{1}}^{\dagger
}a_{j_{3}}a_{j_{2}}^{\dagger}=\nonumber\\
&  \left(  \delta_{j_{4}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{4}}\right)
\delta_{j_{3}j_{1}}-\left(  I\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{4}%
}\right)  \left(  I\delta_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{3}}\right)
=\nonumber\\
&  I\delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-a_{j_{2}}^{\dagger}a_{j_{4}}%
\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta_{j_{3}j_{2}}+a_{j_{1}}%
^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{4}}a_{j_{2}}^{\dagger}a_{j_{3}%
}=\nonumber\\
I  &  \delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-a_{j_{2}}^{\dagger}a_{j_{4}%
}\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta_{j_{3}j_{2}}+a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}\left(  \delta_{j_{4}j_{2}}-a_{j_{2}%
}^{\dagger}a_{j_{4}}\right)  a_{j_{3}}=\nonumber\\
I  &  \delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta
_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{1}}+a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{3}}\delta_{j_{4}j_{2}}+a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{4}}a_{j_{3}},
\end{align}
hence
\begin{align}
&  a_{j_{4}}a_{j_{3}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=\nonumber\\
&  I\delta_{j_{4}j_{2}}\delta_{j_{3}j_{1}}-I\delta_{j_{4}j_{1}}\delta
_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{1}}+a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}+a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}-a_{j_{1}}^{\dagger}a_{j_{3}}\delta_{j_{4}j_{2}}+a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{4}}a_{j_{3}}%
\end{align}
and
\begin{equation}
\left[  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger},a_{j_{4}}a_{j_{3}}\right]
=I\delta_{j_{4}j_{1}}\delta_{j_{3}j_{2}}-I\delta_{j_{4}j_{2}}\delta
_{j_{3}j_{1}}+a_{j_{2}}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{1}}-a_{j_{1}%
}^{\dagger}a_{j_{4}}\delta_{j_{3}j_{2}}-a_{j_{2}}^{\dagger}a_{j_{3}}%
\delta_{j_{4}j_{1}}+a_{j_{1}}^{\dagger}a_{j_{3}}\delta_{j_{4}j_{2}}%
\end{equation}


\begin{theorem}
\bigskip$g^{\dagger}gg^{\dagger}g=g^{\dagger}g\Longleftrightarrow g^{\dagger
}=a_{j}^{\dagger}a_{k}^{\dagger},$ when $\left\Vert g\right\Vert
_{\mathcal{H}^{2}}^{2}=1$ and $c_{1}\neq0$%
\begin{equation}
g^{\dagger}gg^{\dagger}g=\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq s}a_{j_{1}%
}^{\dagger}a_{j_{1+s}}^{\dagger}a_{j_{2}}a_{j_{2+s}}a_{j_{3}}^{\dagger
}a_{j_{3+s}}^{\dagger}a_{j_{4}}a_{j_{4+s}}c_{j_{1}}c_{j_{2}}c_{j_{3}}c_{j_{4}}%
\end{equation}
Observing that
\begin{align}
&  a_{j_{2}}a_{j_{2+s}}a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}\nonumber\\
&  =\delta_{j_{2}j_{3+s}}\delta_{j_{2+s}j_{3}}-\delta_{j_{2}j_{3}}%
\delta_{j_{2+s}j_{3+s}}-a_{j_{3+s}}^{\dagger}a_{j_{2}}\delta_{j_{2+s}j_{3}%
}+\nonumber\\
&  \quad+a_{j_{3}}^{\dagger}a_{j_{2}}\delta_{j_{2+s}j_{3+s}}+a_{j_{3+s}%
}^{\dagger}a_{j_{2+s}}\delta_{j_{2}j_{3}}-a_{j_{3}}^{\dagger}a_{j_{2+s}}%
\delta_{j_{2}j_{3+s}}+a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}a_{j_{2+s}%
}a_{j_{2}}\nonumber\\
&  =-I\delta_{j_{2}j_{3}}+a_{j_{3}}^{\dagger}a_{j_{2}}\delta_{j_{2}j_{3}%
}+a_{j_{3}}^{\dagger}a_{j_{2}}\delta_{j_{2}j_{3}}+a_{j_{3}}^{\dagger
}a_{j_{3+s}}^{\dagger}a_{j_{2+s}}a_{j_{2}}%
\end{align}
one obtains%
\begin{align}
&  g^{\dagger}gg^{\dagger}g=\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq s}%
a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger}\left(  -\delta_{j_{2}j_{3}}+a_{j_{3}%
}^{\dagger}a_{j_{2}}\delta_{j_{2}j_{3}}+a_{j_{3}+s}^{\dagger}a_{j_{2}+s}%
\delta_{j_{2}j_{3}}+a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}a_{j_{2+s}%
}a_{j_{2}}\right) \nonumber\\
&  \qquad\qquad\qquad\times a_{j_{4}}a_{j_{4+s}}c_{j_{1}}c_{j_{2}}c_{j_{3}%
}c_{j_{4}}\nonumber\\
&  =\sum_{1\leq j_{1},j_{4}\leq s}a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger
}a_{j_{4+s}}a_{j_{4}}c_{j_{1}}c_{j_{4}}\left\Vert g\right\Vert _{\mathcal{H}%
^{2}}^{2}\\
&  \qquad+\sum_{1\leq j_{1},j_{2},j_{4}\leq s}a_{j_{1}}^{\dagger}a_{j_{1+s}%
}^{\dagger}\left(  a_{j_{2}}^{\dagger}a_{j_{2}}+a_{j_{2}+s}^{\dagger}%
a_{j_{2}+s}\right)  a_{j_{4}}a_{j_{4+s}}c_{j_{1}}n_{j_{2}}c_{j_{4}}\\
&  \quad\qquad+\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq s}a_{j_{1}}^{\dagger
}a_{j_{1+s}}^{\dagger}a_{j_{3}}^{\dagger}a_{j_{3+s}}^{\dagger}a_{j_{2+s}%
}a_{j_{2}}a_{j_{4}}a_{j_{4+s}}c_{j_{1}}c_{j_{2}}c_{j_{3}}c_{j_{4}}.
\end{align}
Hence
\begin{align}
g^{\dagger}gg^{\dagger}g-g^{\dagger}g  &  =0\Rightarrow\\
a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger}\left(  a_{j_{2}}^{\dagger}a_{j_{2}%
}+a_{j_{2}+s}^{\dagger}a_{j_{2}+s}\right)  a_{j_{4}}a_{j_{4+s}}  &  =0\\
a_{j_{1}}^{\dagger}a_{j_{1+s}}^{\dagger}a_{j_{3}}^{\dagger}a_{j_{3+s}%
}^{\dagger}a_{j_{2+s}}a_{j_{2}}a_{j_{4}}a_{j_{4+s}}  &  =0
\end{align}
and the only solution is $s=1.$ Consider $s=2$ then e.g.%
\begin{align}
a_{1}^{\dagger}a_{3}^{\dagger}\left(  a_{2}^{\dagger}a_{2}+a_{4}^{\dagger
}a_{4}\right)  a_{1}a_{3}n_{1}n_{2}  &  =0\\
a_{1}^{\dagger}a_{3}^{\dagger}a_{2}^{\dagger}a_{4}^{\dagger}a_{3}a_{1}%
a_{2}a_{4}n_{1}n_{2}  &  =0,
\end{align}
which is not possible unless $n_{2}=0.$
\end{theorem}

\section{Generalized P-Condition}

The generalized P-condition is based on the product
\begin{equation}
A^{\dagger}A,
\end{equation}
where
\begin{equation}
A=a_{j_{2}}a_{j_{1}},
\end{equation}
i.e.%
\begin{equation}
A^{\dagger}A=a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}.
\end{equation}


If $f$ is a state then%
\begin{equation}
1\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\right)  \geq0
\end{equation}


\section{Generalized Q-Condition}

The generalized Q-condition is based on the product
\begin{equation}
A^{\dagger}A,
\end{equation}
where
\begin{equation}
A=a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger},
\end{equation}
i.e.%
\begin{equation}
A^{\dagger}A=a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}.
\end{equation}


Noting that
\begin{equation}
a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}=I_{\mathcal{H}%
_{\mathcal{F}}}-a_{j_{2}}^{\dagger}a_{j_{2}}-a_{j_{1}}^{\dagger}a_{j_{1}%
}+a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}%
\end{equation}
one has
\begin{equation}
f\left(  a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\right)
=1-f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)  -f\left(  a_{j_{1}}^{\dagger
}a_{j_{1}}\right)  +f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}%
}a_{j_{1}}\right)
\end{equation}
and if $f$ is a state then
\begin{align}
1  &  \geq f\left(  a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\right)  \geq0\Leftrightarrow1\geq1-f\left(  a_{j_{2}}^{\dagger}a_{j_{2}%
}\right)  -f\left(  a_{j_{1}}^{\dagger}a_{j_{1}}\right)  +f\left(  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0\nonumber\\
&  \Leftrightarrow0\geq f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{j_{2}}a_{j_{1}}\right)  -f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)
-f\left(  a_{j_{1}}^{\dagger}a_{j_{1}}\right)  \geq-1\nonumber\\
&  \Leftrightarrow1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)
+f\left(  a_{j_{1}}^{\dagger}a_{j_{1}}\right)  -f\left(  a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  \geq0
\end{align}
One should note that
\begin{equation}
a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}\notin\Lambda
_{2}=\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e1}\oplus
\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  _{e2}.
\end{equation}


\section{Generalized G-Condition}

The generalized G-condition is based on the product
\begin{equation}
A^{\dagger}A,
\end{equation}
where
\begin{equation}
A=a_{j_{1}}^{\dagger}a_{j_{2}},
\end{equation}
i.e.%
\begin{equation}
A^{\dagger}A=a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}%
=a_{j_{2}}^{\dagger}\left(  I-a_{j_{1}}^{\dagger}a_{j_{1}}\right)  a_{j_{2}%
}=a_{j_{2}}^{\dagger}a_{j_{2}}-a_{j_{2}}^{\dagger}a_{j_{1}}^{\dagger}a_{j_{1}%
}a_{j_{2}}.
\end{equation}
The operator $a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}$ is a
projector as
\begin{align}
\left[  a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}\right]
\left[  a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}\right]   &
=a_{j_{2}}^{\dagger}a_{j_{2}}\left(  I-a_{j_{1}}^{\dagger}a_{j_{1}}\right)
\left(  I-a_{j_{1}}^{\dagger}a_{j_{1}}\right) \nonumber\\
&  =a_{j_{2}}^{\dagger}a_{j_{2}}\left(  I-a_{j_{1}}^{\dagger}a_{j_{1}}\right)
=a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}a_{j_{1}}^{\dagger}%
\end{align}
and
\begin{equation}
a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}}\in\Lambda_{2}.
\end{equation}


If $f$ is a state then%
\begin{align}
1  &  \geq f\left(  a_{j_{2}}^{\dagger}a_{j_{1}}a_{j_{1}}^{\dagger}a_{j_{2}%
}\right)  =f\left(  a_{j_{2}}^{\dagger}\left(  I-a_{j_{1}}^{\dagger}a_{j_{1}%
}\right)  a_{j_{2}}\right)  =f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}-a_{j_{2}%
}^{\dagger}a_{j_{1}}^{\dagger}a_{j_{1}}a_{j_{2}}\right)  \geq0\nonumber\\
&  \Leftrightarrow1\geq f\left(  a_{j_{2}}^{\dagger}a_{j_{2}}\right)
-f\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)
\geq0
\end{align}


\section{Energy Variation}%

\begin{equation}
E_{N}\left(  \mathbb{D}_{2}\right)  =\operatorname{Tr}\left\{  HD^{N}\right\}
=\operatorname{Tr}\left\{  \Gamma_{2}^{N}\left(  K\right)  D^{N}\right\}
=\operatorname{Tr}\left\{  KL_{N}^{2}\left(  D^{N}\right)  \right\}  =\frac
{1}{2}\operatorname{Tr}\left\{  \mathbb{KD}_{2}\right\}
\end{equation}%
\begin{equation}
D_{2}=L_{N}^{2}\left(  D^{N}\right)  =\sum_{\substack{1\leq j_{1}<j_{2}%
\leq\infty\\1\leq k_{1}<k_{2}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}  a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}%
\end{equation}%
\begin{align}
u\wedge uD_{2}\left(  u\wedge u\right)  ^{\dagger}  &  =\sum_{\substack{1\leq
j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty}}\operatorname{Tr}\left\{
a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}
b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{k_{2}}b_{k_{1}}\nonumber\\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\operatorname{Tr}\left\{  b_{j_{1}}^{\dagger}b_{j_{2}}^{\dagger}b_{k_{2}%
}b_{k_{1}}D^{N}\right\}  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}%
\end{align}
The extension condition can be expressed as
\begin{equation}
f\left(  ua_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}u^{\dagger
}\right)  \leq1\forall u\in U\left(  \mathcal{H}^{1}\right)  .
\end{equation}
One can note
\begin{equation}
U\left(  \mathcal{H}^{1}\right)  :\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  _{e2}\rightarrow\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
_{e2}%
\end{equation}
giving a reducible representation.%

\begin{equation}
D_{2}=\sum_{\substack{1\leq j_{1}<j_{2}\leq r\\1\leq k_{1}<k_{2}\leq
r}}D_{2j_{1}j_{2}k_{1}k_{2}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}=\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}g_{l}^{\dagger}g_{l},
\end{equation}
where%
\begin{equation}
g_{l}^{\dagger}=\sum_{1\leq j_{1}<j_{2}\leq r}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}g_{l2j_{1}j_{2}}%
\end{equation}%
\begin{equation}
\mathbb{D}_{2}=\sum_{1\leq l\leq\binom{r}{2}}\beta_{l}\left\vert
g_{l}\right\rangle \left\langle g_{l}\right\vert
\end{equation}


\section{Extra}

and
\begin{equation}
\left.  T_{N2}\right\vert _{\mathcal{H}^{2}}=\binom{N}{2}L_{N}^{2}\left(
D^{N}\right)
\end{equation}
Consider
\begin{equation}
T_{NP}=\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots
a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}D^{N}\right\}  a_{j_{1}}^{\dagger
}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}%
\end{equation}
then
\begin{equation}
0\leq\left\langle \left.  \Phi\right\vert T_{NP}\Phi\right\rangle \leq
\binom{N}{P}\left\langle \left.  \Phi\right\vert \Phi\right\rangle \text{
}\forall\Phi\in\mathcal{H}^{P}%
\end{equation}
and for $\Phi\in\mathcal{H}^{P}$
\begin{align}
&  \sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots
a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}D^{N}\right\}  \left\langle
\left.  \Phi\right\vert a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}%
}\cdots a_{k_{1}}\Phi\right\rangle \\
&  =\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}\cdots
a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}}D^{N}\right\}  \bar{C}%
_{j_{1}\cdots j_{P}}C_{k_{1}\cdots k_{P}}\\
&  =\sum_{\substack{1\leq j_{1}<\cdots<j_{P}\leq\infty\\1\leq k_{1}%
<\cdots<k_{P}\leq\infty}}D_{NPj_{1}\cdots j_{P}k_{1}\cdots k_{P}}\bar
{C}_{j_{1}\cdots j_{P}}C_{k_{1}\cdots k_{P}}\geq0.
\end{align}
In particular for $\Phi\in\mathcal{H}^{2}$
\begin{equation}
0\leq\left\langle \left.  \Phi\right\vert T_{N2}\Phi\right\rangle \leq
\binom{N}{2}\left\langle \left.  \Phi\right\vert \Phi\right\rangle \text{
}\forall\Phi\in\mathcal{H}^{2},
\end{equation}%
\begin{align}
\left\langle \left.  \Phi\right\vert T_{N2}\Phi\right\rangle =  &
\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}D^{N}\right\}  \left\langle \left.  \Phi\right\vert a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\Phi\right\rangle \\
&  \sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}D^{N}\right\}  \left\langle \left.  a_{j_{1}}a_{j_{2}}%
\Phi\right\vert a_{k_{2}}a_{k_{1}}\Phi\right\rangle \\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}D^{N}\right\}  \bar{C}_{j_{1}j_{2}}C_{k_{1}k_{2}}\\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}D_{NPj_{1}j_{2}k_{1}k_{2}}\bar{C}_{j_{1}j_{2}}C_{k_{1}k_{2}}\geq0.
\end{align}
Let $\Phi\in\mathcal{H}^{P};3\leq P\leq N$ then%
\begin{align}
\left\langle \left.  a_{j_{1}}a_{j_{2}}\Phi\right\vert a_{k_{2}}a_{k_{1}}%
\Phi\right\rangle  &  =\sum_{1\leq m,m^{\prime}\leq\infty}\overline{C}%
_{j_{1}j_{2}m^{\prime}}C_{k_{1}k_{2}m}\left\langle \left.  \varphi_{m^{\prime
}}\right\vert \varphi_{m}\right\rangle =\sum_{1\leq m\leq\infty}\overline
{C}_{j_{1}j_{2}m}C_{k_{1}k_{2}m}=R_{j_{1}j_{2}k_{1}k_{2}}\\
\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\overline{V}_{j_{1}j_{2}}R_{j_{1}j_{2}k_{1}k_{2}}V_{k_{1}k_{2}}  &
=\sum_{1\leq m\leq\infty}\left(  \sum_{1\leq j_{1}<j_{2}\leq\infty}%
\overline{V}_{j_{1}j_{2}}\overline{C}_{j_{1}j_{2}m}\right)  \left(
\sum_{1\leq k_{1}<k_{2}\leq\infty}C_{k_{1}k_{2}m}V_{k_{1}k_{2}}\right)  \geq0
\end{align}%
\begin{align}
\left\langle \left.  \Phi\right\vert T_{N2}\Phi\right\rangle =  &
\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}D^{N}\right\}  \left\langle \left.  \Phi\right\vert a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}\Phi\right\rangle \\
=  &  \sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq
\infty}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{k_{2}}a_{k_{1}}D^{N}\right\}  \left\langle \left.  a_{j_{1}}a_{j_{2}}%
\Phi\right\vert a_{k_{2}}a_{k_{1}}\Phi\right\rangle \\
&  =\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}\leq\infty
}}\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}\left\vert \Phi\right\rangle \left\langle \Phi\right\vert \right\}
\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}D^{N}\right\} \\
&  \equiv\sum_{\substack{1\leq j_{1}<j_{2}\leq\infty\\1\leq k_{1}<k_{2}%
\leq\infty}}f_{j_{1}j_{2}k_{1}k_{2}}X_{j_{1}j_{2}k_{1}k_{2}}=f(X);\text{ }%
f\in\mathcal{B}_{1sa}\left(  \mathcal{H}^{2}\right)  ,X\in\mathcal{B}%
_{sa}\left(  \mathcal{H}^{2}\right)  ,
\end{align}
where
\begin{equation}
f_{j_{1}j_{2}k_{1}k_{2}}=\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}%
a_{j_{2}}^{\dagger}a_{k_{2}}a_{k_{1}}D^{N}\right\}  ;X_{j_{1}j_{2}k_{1}k_{2}%
}=\operatorname{Tr}\left\{  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}\left\vert \Phi\right\rangle \left\langle \Phi\right\vert \right\}
.
\end{equation}


\section{Extra}

This can also be seen coordinate wise by considering the special case
$X_{2}=P_{2}$ then
\begin{align}
3\Gamma_{2}^{3}\left(  P_{\mathcal{H}^{2}}\right)   &  =\frac{1}{4\left(
3!\right)  }\sum_{\substack{1\leq j_{1},j_{2}\leq\infty\\1\leq k_{1},k_{2}%
\leq\infty\\1\leq l_{1},l_{2},l_{3}\leq\infty}}\delta_{\left(  j_{1}%
j_{2}\right)  \left(  k_{1}k_{2}\right)  }a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{k_{2}}a_{k_{1}}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}%
\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{l_{2}%
}\varphi_{l_{3}}\right\vert \\
&  =\frac{3}{4\left(  3!\right)  }\sum_{\substack{1\leq j_{1},j_{2}\leq
\infty\\1\leq l_{1},l_{2},l_{3}\leq\infty}}\delta_{\left(  j_{1}j_{2}\right)
\left(  l_{1}l_{2}\right)  }\left\vert \varphi_{j_{1}}\varphi_{j_{2}}%
\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{l_{2}%
}\varphi_{l_{3}}\right\vert \\
&  =\frac{\left(  3\right)  \left(  4\right)  }{4\left(  3!\right)  }%
\sum_{1\leq l_{1},l_{2},l_{3}\leq\infty}\left\vert \varphi_{l_{1}}%
\varphi_{l_{2}}\varphi_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}%
}\varphi_{l_{2}}\varphi_{l_{3}}\right\vert \\
&  =\frac{\left(  3\right)  \left(  4\right)  }{4}\sum_{1\leq l_{1}%
<l_{2}<l_{3}\leq\infty}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\varphi
_{l_{3}}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{l_{2}}%
\varphi_{l_{3}}\right\vert ,
\end{align}
hence%
\begin{equation}
\Gamma_{2}^{3}\left(  P_{\mathcal{H}^{2}}\right)  =P_{\mathcal{H}^{3}}.
\end{equation}
Consider $\left.  \Gamma\left(  X_{P}\right)  \right\vert _{\mathcal{H}^{P+1}%
}=\left(  P+1\right)  \Gamma_{P}^{P+1}\left(  X_{P}\right)  $
\begin{align}
\left.  \Gamma\left(  X_{P}\right)  \right\vert _{\mathcal{H}^{P+1}}  &
=\left(  P+1\right)  \Gamma_{P}^{P+1}\left(  X_{P}\right) \\
&  =\frac{1}{\left(  P!\right)  ^{3}\left(  P+1\right)  }\sum_{\substack{1\leq
j_{1},\cdots,j_{P}\leq\infty\\1\leq k_{1},\cdots,k_{P}\leq\infty\\1\leq
l_{1},\cdots,l_{P+1}\leq\infty}}X_{j_{1}\cdots j_{P}k_{1}\cdots k_{P}}%
a_{j_{1}}^{\dagger}\cdots a_{j_{P}}^{\dagger}a_{k_{P}}\cdots a_{k_{1}%
}\left\vert \varphi_{l_{1}}\cdots\varphi_{l_{P+1}}\right\rangle \left\langle
\varphi_{l_{1}}\cdots\varphi_{l_{P+1}}\right\vert \\
&  =\frac{1}{\left(  P!\right)  ^{2}\left(  P+1\right)  }\sum_{\substack{1\leq
j_{1},\cdots,j_{P}\leq\infty\\1\leq l_{1},\cdots,l_{P+1}\leq\infty}%
}X_{j_{1}\cdots j_{P}l_{1}\cdots l_{P}}\left\vert \varphi_{j_{1}}\cdots
\varphi_{j_{P}}\varphi_{l_{P+1}}\right\rangle \left\langle \varphi_{l_{1}%
}\cdots\varphi_{l_{P}}\varphi_{l_{P+1}}\right\vert \Rightarrow\\
\Gamma_{P}^{P+1}\left(  X_{P}\right)   &  =\sum_{\substack{1\leq j_{1}%
<\cdots,<j_{P}\leq\infty\\1\leq l_{1}<\cdots<l_{P+1}\leq\infty}}X_{j_{1}\cdots
j_{P}l_{1}\cdots l_{P}}\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{P}}%
\varphi_{l_{P+1}}\right\rangle \left\langle \varphi_{l_{1}}\cdots
\varphi_{l_{P}}\varphi_{l_{P+1}}\right\vert .
\end{align}
Consider $\left.  \Gamma\left(  X_{2}\right)  \right\vert _{\mathcal{H}^{3}%
}=3\Gamma_{2}^{3}\left(  X_{2}\right)  $
\begin{align}
\left.  \Gamma\left(  X_{2}\right)  \right\vert _{\mathcal{H}^{3}}  &
=3\Gamma_{2}^{3}\left(  X_{2}\right) \\
&  =\frac{1}{\left(  2\right)  ^{3}3}\sum_{\substack{1\leq j_{1},j_{2}%
\leq\infty\\1\leq k_{1},k_{2}\leq\infty\\1\leq l_{1},l_{2},l_{3}\leq\infty
}}X_{j_{1}j_{2}k_{1}k_{2}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{2}}\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\varphi_{l_{3}%
}\right\rangle \left\langle \varphi_{l_{1}}\varphi_{l_{2}}\varphi_{l_{3}%
}\right\vert \\
&  =\frac{1}{\left(  2\right)  ^{3}3}\sum_{\substack{1\leq j_{1},j_{2}%
\leq\infty\\1\leq l_{1},l_{2},l_{3}\leq\infty}}X_{j_{1}j_{2}l_{1}l_{2}%
}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\varphi_{l_{3}}\right\rangle
\left\langle \varphi_{l_{1}}\varphi_{l_{2}}\varphi_{l_{3}}\right\vert .
\end{align}
Let
\begin{equation}
X_{P}=\left.  \Gamma\left(  X_{P}\right)  \right\vert _{\mathcal{H}^{P}}%
=\sum_{1\leq j\leq\infty}\alpha_{j}\left\vert \Phi_{Pj}\right\rangle
\left\langle \Phi_{Pj}\right\vert -\sum_{1\leq j\leq\infty}\beta_{j}\left\vert
\Phi_{Pj}\right\rangle \left\langle \Phi_{Pj}\right\vert ;\alpha_{j},\beta
_{j}\geq0\,
\end{equation}
and
\begin{equation}
\left\langle \left.  \Gamma_{P}^{N}\left(  X_{P}\right)  \right\vert
\left\vert \Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert
\right\rangle _{N}=\left\langle \left.  X_{P}\right\vert L_{N}^{P}\left(
\left\vert \Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert \right)
\right\rangle _{P}\geq0\,\forall\Psi_{N}.
\end{equation}
Then
\begin{align}
&  \left\langle \left.  \left\{  \sum_{1\leq j\leq\infty}\alpha_{j}\left\vert
\Phi_{Pj}^{+}\right\rangle \left\langle \Phi_{Pj}^{+}\right\vert -\sum_{1\leq
j\leq\infty}\beta_{j}\left\vert \Phi_{Pj}^{-}\right\rangle \left\langle
\Phi_{Pj}^{-}\right\vert \right\}  \right\vert L_{N}^{P}\left(  \left\vert
\Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert \right)  \right\rangle
_{P}=\\
&  \left\langle \left.  \Gamma_{P}^{N}\left(  \sum_{1\leq j\leq\infty}%
\alpha_{j}\left\vert \Phi_{Pj}^{+}\right\rangle \left\langle \Phi_{Pj}%
^{+}\right\vert \right)  \right\vert \left\vert \Psi_{N}\right\rangle
\left\langle \Psi_{N}\right\vert \right\rangle _{N}-\left\langle \left.
\Gamma_{P}^{N}\left(  \sum_{1\leq j\leq\infty}\beta_{j}\left\vert \Phi
_{Pj}^{-}\right\rangle \left\langle \Phi_{Pj}^{-}\right\vert \right)
\right\vert \left\vert \Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert
\right\rangle _{N}\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  \geq\right.
0\qquad\forall\Psi_{N},
\end{align}
or more generally
\begin{equation}
\left\langle \left.  \Gamma_{P}^{N}\left(  \sum_{1\leq j\leq\infty}\alpha
_{j}\left\vert \Phi_{Pj}^{+}\right\rangle \left\langle \Phi_{Pj}%
^{+}\right\vert \right)  \right\vert \left\vert \Psi_{N}\right\rangle
\left\langle \Psi_{N}\right\vert \right\rangle _{N}\geq\left\langle \left.
\Gamma_{P}^{N}\left(  \sum_{1\leq j\leq\infty}\beta_{j}\left\vert \Phi
_{Pj}^{-}\right\rangle \left\langle \Phi_{Pj}^{-}\right\vert \right)
\right\vert \left\vert \Psi_{N}\right\rangle \left\langle \Psi_{N}\right\vert
\right\rangle _{N}\forall\Psi_{N}%
\end{equation}


\begin{theorem}
\begin{proof}
Is
\begin{equation}
\Gamma_{P}^{N}\left(  \left\vert \Phi_{Pj}^{+}\right\rangle \left\langle
\Phi_{Pj}^{+}\right\vert \right)  \bot\Gamma_{P}^{N}\left(  \left\vert
\Phi_{Pj}^{-}\right\rangle \left\langle \Phi_{Pj}^{-}\right\vert \right)
\end{equation}
i.e.%
\begin{align}
\left(  \Gamma_{P}^{N}\left(  \left\vert \Phi_{Pj}^{+}\right\rangle
\left\langle \Phi_{Pj}^{+}\right\vert \right)  \left\vert \Gamma_{P}%
^{N}\left(  \left\vert \Phi_{Pj}^{-}\right\rangle \left\langle \Phi_{Pj}%
^{-}\right\vert \right)  \right.  \right)  _{N}  &  =\left(  L_{N}^{P}%
\Gamma_{P}^{N}\left(  \left\vert \Phi_{Pj}^{+}\right\rangle \left\langle
\Phi_{Pj}^{+}\right\vert \right)  \left\vert \left\vert \Phi_{Pj}%
^{-}\right\rangle \left\langle \Phi_{Pj}^{-}\right\vert \right.  \right)
_{P}\\
&  =\left(  \left\vert \Phi_{Pj}^{+}\right\rangle \left\langle \Phi_{Pj}%
^{+}\right\vert \left\vert L_{N}^{P}\Gamma_{P}^{N}\left(  \left\vert \Phi
_{Pj}^{-}\right\rangle \left\langle \Phi_{Pj}^{-}\right\vert \right)  \right.
\right)  _{P}=0
\end{align}
$\lceil$yes, think of $AA^{\dagger}$ and $A^{\dagger}A$ if $A$ is compact$,$%
\begin{align}
A  &  =\sum_{1\leq j\leq\infty}\alpha_{j}\left\vert f_{j}\right\rangle
\left\langle e_{j}^{d}\right\vert ;\,A^{\dagger}=\sum_{1\leq j\leq\infty
}\overline{\alpha}_{j}\left\vert e_{j}\right\rangle \left\langle f_{j}%
^{d}\right\vert \\
A  &  :E\rightarrow F;\quad A^{\dagger}:F^{d}\rightarrow E^{d}\\
\text{Let }F  &  \subset F^{d}\text{ and }E\subset E^{d}\\
AA^{\dagger}  &  =\sum_{1\leq j\leq\infty}\left\vert \alpha_{j}\right\vert
^{2}\left\vert f_{j}\right\rangle \left\langle f_{j}^{d}\right\vert
\,;\,A^{\dagger}A=\sum_{1\leq j\leq\infty}\left\vert \alpha_{j}\right\vert
^{2}\left\vert e_{j}\right\rangle \left\langle e_{j}^{d}\right\vert \\
AA^{\dagger}  &  :F\rightarrow F;\quad A^{\dagger}A:E\rightarrow E,
\end{align}
where $\left\{  \left\vert e_{j}\right\rangle ,\left\langle e_{j}%
^{d}\right\vert \right\}  $ and $\left\{  \left\vert f_{j}\right\rangle
,\left\langle f_{j}^{d}\right\vert \right\}  $ are biorthogonal bases. So
\begin{align}
\left\langle \left.  e_{k}\right\vert e_{l}\right\rangle _{E}  &  =\delta
_{kl}\\
\left\langle \left.  Ae_{k}\right\vert Ae_{l}\right\rangle _{F}  &
=\left\langle \left.  e_{k}\right\vert A^{\dagger}Ae_{l}\right\rangle
_{E}=\left\langle e_{k}\left\vert \sum_{1\leq j\leq\infty}\left\vert
\alpha_{j}\right\vert ^{2}\left\vert e_{j}\right\rangle \left\langle e_{j}%
^{d}\right\vert e_{l}\right.  \right\rangle _{E}\\
&  =\delta_{kl}.\rfloor
\end{align}%
\begin{equation}
a_{j}^{\dagger}a_{k}=\left(  \sum_{0\leq N\leq\infty}P_{N}\right)
a_{j}^{\dagger}a_{k}\left(  \sum_{0\leq N\leq\infty}P_{N}\right)  =\sum_{0\leq
N\leq\infty}P_{N}a_{j}^{\dagger}a_{k}P_{N},
\end{equation}
where%
\begin{equation}
\sum_{0\leq N\leq\infty}P_{N}=I_{F}.
\end{equation}
The trace condition eq.$\left(  \ref{Trcon}\right)  $ coupled with the
condition $\left(  \ref{occnum}\right)  $ imply that there exists an operator
\begin{equation}
\eta_{1}=\sum_{1\leq l\leq N}b_{l}^{\dagger}b_{l}%
\end{equation}
such that
\begin{equation}
f_{1}\left(  \eta_{1}\right)  =\operatorname*{Tr}\left\{  \eta_{1}D\right\}
=N
\end{equation}
and
\begin{align}
f_{1}\left(  b_{l}^{\dagger}b_{l}\right)   &  =\operatorname*{Tr}\left\{
b_{l}^{\dagger}b_{l}D\right\}  =1,1\leq l\leq N\\
f_{1}\left(  b_{l}^{\dagger}b_{l}\right)   &  =\operatorname*{Tr}\left\{
b_{l}^{\dagger}b_{l}D\right\}  =0,N+1\leq l\leq r.
\end{align}%
\begin{equation}
\operatorname*{Tr}\left\{  \left(  \mathcal{N}_{1}-\eta_{1}\right)  D\right\}
=0.
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  \left(  \mathcal{N}_{1}-\eta_{1}\right)  \sum
_{N,j}\alpha_{Nj}D_{j}^{N}\right\}  =0.
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  \left(  \mathcal{N}_{1}-\eta_{1}\right)  \sum
_{N,j}\alpha_{Nj}\left\vert \Psi_{Nj}\right\rangle \left\langle \Psi
_{Nj}\right\vert \right\}  =0.
\end{equation}%
\begin{equation}
\sum_{1\leq N,j\leq\infty}\alpha_{Pj}\left\langle \Psi_{Pj}\left\vert \left(
\mathcal{N}_{1}-\eta_{1}\right)  \right.  \Psi_{Pj}\right\rangle =0.
\end{equation}%
\begin{equation}
\left\langle \Psi_{Pj}\left\vert \left(  \mathcal{N}_{1}-\eta_{1}\right)
\right.  \Psi_{Pj}\right\rangle =0,1\leq P,j\leq\infty
\end{equation}%
\begin{equation}
\sum_{1\leq P,j\leq\infty}\alpha_{Pj}\left\langle \Psi_{Pj}\left\vert \eta
_{1}\right.  \Psi_{Pj}\right\rangle =N.
\end{equation}%
\begin{align}
&  \sum_{\substack{1\leq P,j\leq\infty\\1\leq l\leq N}}\alpha_{Pj}\left\langle
\Psi_{Pj}\left\vert b_{l}^{\dagger}b_{l}\right.  \Psi_{Pj}\right\rangle =N,\\
&  \sum_{1\leq P,j\leq\infty}\alpha_{Pj}\left\langle \Psi_{Pj}\left\vert
b_{l}^{\dagger}b_{l}\right.  \Psi_{Pj}\right\rangle =1,1\leq l\leq N\\
&  \sum_{\substack{1\leq P,j\leq\infty\\N+1\leq l\leq r}}\alpha_{Pj}%
\left\langle \Psi_{Pj}\left\vert b_{l}^{\dagger}b_{l}\right.  \Psi
_{Pj}\right\rangle =0\Rightarrow\left\langle \Psi_{Pj}\left\vert
b_{l}^{\dagger}b_{l}\right.  \Psi_{Pj}\right\rangle =0\\
&  \Rightarrow\left\langle \Psi_{Pj}\left\vert \left(  b_{l}^{\dagger}%
b_{l}\right)  ^{2}\right.  \Psi_{Pj}\right\rangle =0\Rightarrow b_{l}%
^{\dagger}b_{l}\left\vert \Psi_{Pj}\right\rangle =0,\\
1  &  \leq P,j\leq\infty,N+1\leq l\leq r
\end{align}%
\begin{align}
&  \Rightarrow b_{l_{1}}^{\dagger}b_{l_{1}}\cdots b_{l_{N+1}}^{\dagger
}b_{l_{N+1}}\left\vert \Psi_{Pj}\right\rangle =0\forall P,j,1\leq l_{1}%
<\cdots<l_{N+1}\leq\infty\\
&  \equiv b_{l_{1}}^{\dagger}\cdots b_{l_{N+1}}^{\dagger}b_{l_{N+1}}\cdots
b_{l_{1}}\left\vert \Psi_{Pj}\right\rangle =0\forall P,j,1\leq l_{1}%
<\cdots<l_{N+1}\leq\infty
\end{align}%
\begin{equation}
\Rightarrow\left\vert \Psi_{Pj}\right\rangle =0,P>N
\end{equation}%
\begin{equation}
b_{l}^{\dagger}b_{l}\left\vert \psi_{1}\cdots\psi_{N+1}\right\rangle
=0,N+1\leq l\leq r
\end{equation}%
\begin{equation}
\sum_{\substack{1\leq j\leq\infty\\1\leq P\leq N}}\alpha_{Pj}\left\langle
\Psi_{Pj}\left\vert b_{l}^{\dagger}b_{l}\right.  \Psi_{Pj}\right\rangle
=1,1\leq l\leq N
\end{equation}%
\begin{equation}
\sum_{\substack{1\leq j\leq\infty\\1\leq P\leq N\\_{\substack{1\leq
k_{1}<\cdots<k_{N}\leq\infty\\1\leq m_{1}<\cdots<m_{N}\leq\infty}}}%
}\alpha_{Pj}c_{jk_{1}\cdots k_{P}}\bar{c}_{jm_{1}\cdots m_{P}}\left\langle
\psi_{m_{1}}\cdots\psi_{m_{P}}b_{l}^{\dagger}b_{l}\left\vert \psi_{k_{1}%
}\cdots\psi_{k_{P}}\right.  \right\rangle =1,1\leq l\leq N
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  \mathcal{N}_{1}^{2}D\right\}  =N^{2}%
\end{equation}
are sufficient that there exist $f_{1}^{N}$ such that
\end{proof}
\end{theorem}


