^{\dagger}a_{1}a_{2},a_{1}^{\dagger}a_{1}a_{3},a_{2}^{\dagger}a_{1}a_{3}%
,a_{3}^{\dagger}a_{1}a_{3},a_{1}^{\dagger}a_{2}a_{3},a_{2}^{\dagger}a_{2}%
a_{3},a_{3}^{\dagger}a_{2}a_{3}\right\}  ,\\
