a_{3}^{\dagger}a_{3}a_{1},a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}%
,a_{1}^{\dagger}a_{2}^{\dagger}a_{3}a_{1},a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}a_{2},a_{1}^{\dagger}a_{3}^{\dagger}a_{2}a_{1},a_{1}^{\dagger}%
a_{3}^{\dagger}a_{3}a_{2},a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{1}%
,a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}\right\}  ,\\
&  \left\{  a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}\right\}  ,\left\{
a_{1}a_{2}a_{3}\right\}  ,\left\{  a_{1}^{\dagger}a_{2}^{\dagger}%
a_{3}^{\dagger}a_{1},a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{2}%
,a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}\right\}  ,\left\{
a_{1}^{\dagger}a_{1}a_{2}a_{3},a_{2}^{\dagger}a_{1}a_{2}a_{3},a_{2}^{\dagger
}a_{1}a_{2}a_{3}\right\}  ,\\
&  \left\{  a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{1}a_{2}%
,a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{1}a_{3},a_{1}^{\dagger}%
a_{2}^{\dagger}a_{3}^{\dagger}a_{2}a_{3}\right\}  ,\left\{  a_{1}^{\dagger
}a_{2}^{\dagger}a_{1}a_{2}a_{3},a_{1}^{\dagger}a_{3}^{\dagger}a_{1}a_{2}%
a_{3},a_{2}^{\dagger}a_{3}^{\dagger}a_{1}a_{2}a_{3}\right\}  ,\left\{
a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}a_{1}a_{2}a_{3}\right\} \\
&  \dim\left\{
\begin{array}
[c]{c}%
\mathcal{A}_{00}\oplus\left(  \mathcal{A}_{10}\oplus\mathcal{A}_{01}\right)
\oplus\mathcal{A}_{11}\oplus\left(  \mathcal{A}_{20}\oplus\mathcal{A}%
_{02}\right)  \oplus\left(  \mathcal{A}_{21}\oplus\mathcal{A}_{12}\right)
\oplus\mathcal{A}_{22}\\
\oplus\left(  \mathcal{A}_{30}\oplus\mathcal{A}_{03}\right)  \oplus\left(
\mathcal{A}_{31}\oplus\mathcal{A}_{13}\right)  \oplus\left(  \mathcal{A}%
_{23}\oplus\mathcal{A}_{32}\right)  \oplus\mathcal{A}_{33}%
\end{array}
\right\} \\
&  =\binom{r}{0}^{2}+2\binom{r}{0}\binom{r}{1}+2\binom{r}{0}\binom{r}%
{2}+2\binom{r}{0}\binom{r}{3}+\binom{r}{1}^{2}+2\binom{r}{1}\binom{r}{2}\\
&  +2\binom{r}{1}\binom{r}{3}+\binom{r}{2}^{2}+2\binom{r}{2}\binom{r}%
{3}+\binom{r}{3}^{2}\\
&  =\left(  \binom{r}{0}+\binom{r}{1}+\binom{r}{2}+\binom{r}{3}\right)
\left(  \binom{r}{0}+\binom{r}{1}+\binom{r}{2}+\binom{r}{3}\right)  =\left(
2^{r}\right)  ^{2}\\
&  =\left(  \binom{3}{0}+\binom{3}{1}+\binom{3}{2}+\binom{3}{3}\right)
\left(  \binom{3}{0}+\binom{3}{1}+\binom{3}{2}+\binom{3}{3}\right) \\
&  =\left(  1+3+3+1\right)  ^{2}=64=2^{6}\\
&  =\binom{3}{0}^{2}+2\binom{3}{0}\binom{3}{1}+2\binom{3}{0}\binom{3}%
{2}+2\binom{3}{0}\binom{3}{3}+\binom{3}{1}^{2}+2\binom{3}{1}\binom{3}{2}\\
&  +2\binom{3}{1}\binom{3}{3}+\binom{3}{2}^{2}+2\binom{3}{2}\binom{3}%
{3}+\binom{3}{3}^{2}\\
&  =1+6+6+2+9+18+6+9+6+1=64=2^{6}\\
&  \dim\left\{  \mathcal{A}_{00}\oplus\mathcal{A}_{11}\oplus\mathcal{A}%
_{22}\oplus\mathcal{A}_{33}\right\}  =\binom{3}{0}^{2}+\binom{3}{1}^{2}%
+\binom{3}{2}^{2}+\binom{3}{3}^{2}=1+9+9+1=20
\end{align}
and by
\begin{align}
&  I_{\mathcal{F}},\left\{  x_{1},x_{2},x_{3},x_{4},x_{5},x_{6}\right\}
,\left\{  x_{1}x_{2},x_{1}x_{3},x_{1}x_{4},,x_{1}x_{5},x_{1}x_{6},x_{2}%
