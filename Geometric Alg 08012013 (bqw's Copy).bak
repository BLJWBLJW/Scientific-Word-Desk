{\displaystyle\sum\limits_{0\leq j\leq r}}
%EndExpansion
\binom{2r}{2j}=2^{2r-1},
\end{align}
and
\begin{align}
\mathcal{F}  &  \mathcal{=}%
%TCIMACRO{\dbigoplus \limits_{0\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq j,k\leq r}}
%EndExpansion
\mathcal{A}_{jk}\\
\dim\left\{  \mathcal{F}\right\}   &  =%
%TCIMACRO{\dsum \limits_{0\leq j,k\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{0\leq j,k\leq r}}
%EndExpansion
\binom{r}{j}\binom{r}{k}=\left(
%TCIMACRO{\dsum \limits_{0\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{0\leq j\leq r}}
%EndExpansion
\binom{r}{j}\right)  ^{2}=\left(  2^{r}\right)  ^{2}=2^{2r}\\
\mathcal{F}_{+}  &  \supset\mathcal{F}_{con}\,\mathcal{=}%
%TCIMACRO{\dbigoplus \limits_{0\leq j\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq j\leq r}}
%EndExpansion
\mathcal{A}_{jj}\\
\dim\left\{  \mathcal{F}_{con}\right\}   &  =%
%TCIMACRO{\dsum \limits_{0\leq j\leq r}}%
%BeginExpansion
{\displaystyle\sum\limits_{0\leq j\leq r}}
%EndExpansion
\binom{r}{j}^{2}.
\end{align}


The $\mathcal{A}$ filtration is finer than the $\mathcal{F}$ filtration.
$\mathcal{F}_{+}$ and $\mathcal{F}_{con}$ are subalgebras of $\mathcal{F}.$

\section{Spin Operators}%

\begin{align}
S_{0}  &  =\frac{1}{2}\sum_{1\leq j\leq s}\left\{  a_{j}^{\dagger}%
a_{j}-a_{j+s}^{\dagger}a_{j+s}\right\} \\
S_{+1}  &  =\sum_{1\leq j\leq s}a_{j}^{\dagger}a_{j+s}\\
S_{-1}  &  =\sum_{1\leq j\leq s}a_{j+s}^{\dagger}a_{j}\\
S^{2}  &  =S_{-1}S_{+1}+S_{0}\left(  S_{0}+I_{\mathcal{F}}\right)  ,
\end{align}
where
\begin{align}
S_{+1}\left\vert \varphi_{k}\right\rangle  &  =0\nonumber\\
S_{+1}\left\vert \varphi_{k+s}\right\rangle  &  =\left\vert \varphi
_{k}\right\rangle \nonumber\\
S_{-1}\left\vert \varphi_{k}\right\rangle  &  =\left\vert \varphi
_{k+s}\right\rangle \nonumber\\
S_{-1}\left\vert \varphi_{k+s}\right\rangle  &  =0\nonumber\\
S_{0}\left\vert \varphi_{k}\right\rangle  &  =\frac{1}{2}\left\vert
\varphi_{k}\right\rangle \nonumber\\
S_{0}\left\vert \varphi_{k+s}\right\rangle  &  =-\frac{1}{2}\left\vert
\varphi_{k+s}\right\rangle \nonumber\\
1  &  \leq k\leq s.
\end{align}


