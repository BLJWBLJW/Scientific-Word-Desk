\mathcal{F}_{j}\\
\dim\left\{  \mathcal{F}\right\}   &  =%
%TCIMACRO{\dsum \limits_{0\leq j\leq2r}}%
%BeginExpansion
{\displaystyle\sum\limits_{0\leq j\leq2r}}
%EndExpansion
\binom{2r}{j}=2^{2r}\\
\mathcal{F}_{+}  &  \mathcal{=}%
%TCIMACRO{\dbigoplus \limits_{0\leq j\leq r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq j\leq r}}
