\end{array}
\right)  \otimes\cdots\otimes\overset{r}{\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  }\nonumber\\
&  =h_{1}\otimes\cdots\otimes h_{j_{1}-1}\otimes p_{j_{1}}\otimes h_{j_{1}%
+1}\otimes\cdots\otimes h_{j_{p}-1}\otimes p_{j_{p}}\otimes h_{j_{p}+1}%
\otimes\cdots\otimes h_{r}.
\end{align}


The ket-bra operators
\begin{equation}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{q}}\right\vert
\end{equation}
are then represented by
\begin{align}
&  \left[  h_{1}\otimes\cdots\otimes h_{j_{1}-1}\otimes p_{j_{1}}\otimes
h_{j_{1}+1}\otimes\cdots\otimes h_{j_{p}-1}\otimes p_{j_{p}}\otimes
h_{j_{p}+1}\otimes\cdots\otimes h_{r}\right]  \times\nonumber\\
&  \left[  h_{1}\otimes\cdots\otimes h_{k_{1}-1}\otimes p_{k_{1}}\otimes
h_{k_{1}+1}\otimes\cdots\otimes h_{k_{q}-1}\otimes p_{k_{q}}\otimes
h_{k_{q}+1}\otimes\cdots\otimes h_{r}\right]  ^{\dagger}%
\end{align}


The replacement operation
\begin{equation}
a_{2}^{\dagger}a_{1}\left\vert \varphi_{1}\varphi_{j_{2}}\cdots\varphi_{j_{p}%
}\right\rangle =\left\vert \varphi_{2}\varphi_{j_{2}}\cdots\varphi_{j_{p}%
}\right\rangle \equiv a_{2}^{\dagger}a_{1}\left\vert 10\cdots0\overset{j_{2}%
\cdots}{1}0\cdots0\overset{\cdots j_{p}}{1}0\cdots\overset{r}{0}\right\rangle
=\left\vert 01\cdots0\overset{j_{2}\cdots}{1}0\cdots0\overset{\cdots j_{p}%
}{1}0\cdots\overset{r}{0}\right\rangle
\end{equation}
is expressed in the Pauli representation in $\mathbb{C}^{2^{r}}$ as
\begin{align}
&  \left(  \left(
