0
\end{array}
\right)  }%
\end{equation}
which is the image of
\begin{equation}
\left\vert \phi\right\rangle \equiv\left\vert \overset{1}{0}\cdots
\overset{r}{0}\right\rangle \in\mathcal{H}_{\mathcal{F}}.
\end{equation}


\section{Properties of Clifford Algebras}

\subsection{Trace}

The multiplicative unit is $I_{\mathcal{F}}$ and has the property
\begin{equation}
\left\langle I_{\mathcal{F}}\right\rangle _{0}=I_{\mathcal{F}}%
\end{equation}
and
\begin{equation}
\left\langle \alpha I_{\mathcal{F}}\right\rangle _{0}=\alpha I_{\mathcal{F}%
};\alpha\in\mathbb{C}.
\end{equation}
One can define an $\mathcal{F}$ -valued trace on $\mathcal{F}$ by
\begin{equation}
\operatorname*{Trace}\left\{  A\right\}  =\left\langle A\right\rangle _{0}.
\end{equation}
This has the trace properties as it is symmetric
\begin{equation}
\left\langle A_{1}A_{2}\right\rangle _{0}=\left\langle A_{2}A_{1}\right\rangle
_{0},
\end{equation}
which leads to the cyclic property
\begin{equation}
\left\langle A_{1}A_{2}\cdots A_{k}\right\rangle _{0}=\left\langle A_{2}\cdots
A_{k}A_{1}\right\rangle _{0}=\left\langle A_{p}\cdots A_{k}A_{1}\cdots
A_{p-1}\right\rangle _{0}.
\end{equation}
One can introduce a linear functional-the \emph{normalized trace},
$\operatorname*{tr},$%
\begin{align}
\operatorname*{tr}  &  :\mathcal{F}\longrightarrow\mathbb{C}\\
\operatorname*{tr}\left\{  A\right\}   &  =\left\langle \left\langle
A\right\rangle \right\rangle _{0}\in\mathbb{C}%
\end{align}
that has the properties
\begin{align}
\left\langle A\right\rangle _{0}  &  =\operatorname*{tr}\left\{  A\right\}
I_{\mathcal{F}}\\
\operatorname*{tr}\left\{  I_{\mathcal{F}}\right\}   &  =1\\
\operatorname*{tr}\left\{  \alpha I_{\mathcal{F}}\right\}   &  =\alpha\\
\operatorname*{tr}\left\{  A+B\right\}   &  =\operatorname*{tr}\left\{
A\right\}  +\operatorname*{tr}\left\{  B\right\} \\
\operatorname*{tr}\left\{  AB\right\}   &  =\operatorname*{tr}\left\{
BA\right\} \\
\operatorname*{tr}\left\{  ABC\right\}   &  =\operatorname*{tr}\left\{
CAB\right\}  =\operatorname*{tr}\left\{  BCA\right\} \\
\left\langle A^{\dagger}B\right\rangle _{0}  &  =\operatorname*{tr}\left\{
A^{\dagger}B\right\}  I_{\mathcal{F}}\\
\left\vert A\right\vert _{HS}^{2}  &  =\left\langle A^{\dagger}A\right\rangle
_{0}=\operatorname*{tr}\left\{  A^{\dagger}A\right\}  I_{\mathcal{F}}\\
\left\Vert A\right\Vert _{HS}^{2}  &  =\operatorname*{tr}\left\{  A^{\dagger
}A\right\}
\end{align}
and
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =2^{-r}\operatorname*{Tr}\left\{
A\right\}  ,
\end{equation}
where $\operatorname*{Tr}$ is the normal trace in the Fock representation
i.e.
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\sum_{0\leq p\leq r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq r}\left\langle \varphi_{j_{1}}\cdots\varphi_{j_{p}%
}\left\vert A\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right.  \right\rangle ,
\end{equation}
and $\left\{  \varphi_{j_{1}},\cdots,\varphi_{j_{r}}\right\}  $ is a conb of
$\mathcal{H}^{1}$. The above definitions of $\operatorname*{tr}$ and
$\operatorname*{Trace}$ are valid in an abstract Clifford/CAR\ algebra not
just the Fock representation. Obviously
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\infty\text{ if }A\notin\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)
\end{equation}
and
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\frac{\infty}{2^{\infty}}%
\end{equation}
so the set
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  <\infty
\end{equation}
is not obvious.

The Hilbert-Schmidt type Clifford inner and scalar products can be expressed
in terms of the trace as
\begin{align}
\left(  \left.  A\right\vert B\right)  _{\dagger}  &  =\left\langle
A^{\dagger}B\right\rangle _{0}=\operatorname*{Trace}\left\{  A^{\dagger
}B\right\} \\
\left(  \left.  A\right\vert B\right)  _{t}  &  =\left\langle A^{t}%
B\right\rangle _{0}=\operatorname*{Trace}\left\{  A^{t}B\right\} \\
\left(  \left.  A\right\vert B\right)  _{s\dagger}  &  =\left\langle
\left\langle A^{\dagger}B\right\rangle \right\rangle _{0}=\operatorname*{tr}%
\left\{  A^{\dagger}B\right\} \\
\left(  \left.  A\right\vert B\right)  _{st}  &  =\left\langle \left\langle
A^{t}B\right\rangle \right\rangle _{0}=\operatorname*{tr}\left\{
A^{t}B\right\}  .
\end{align}


\emph{The trace is zero on}
\begin{equation}%
%TCIMACRO{\dbigoplus \limits_{1\leq n\leq2r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{1\leq n\leq2r}}
%EndExpansion
\mathcal{F}_{n}%
\end{equation}
as
\begin{equation}
\left\langle \sum_{1\leq n\leq2r}A_{n}\right\rangle _{0}=0.
\end{equation}
The subspaces $\left\{  \mathcal{F}_{n}\right\}  $ are orthogonal i.e.
\begin{equation}
\mathcal{F}_{n}\bot\mathcal{F}_{m};0\leq n\neq m\leq2r,
\end{equation}
as
\begin{equation}
A_{m}^{\dagger}B_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}^{\dagger}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j},
\end{equation}
which can never have a zeroth component if $m\neq n$ giving that
\begin{equation}
\left\langle A_{m}^{\dagger}B_{n}\right\rangle _{0}=\left\langle A_{m}%
^{t}B_{n}\right\rangle _{0}=0,\,m\neq n.
\end{equation}


\subsection{Basis of $\mathbb{C}^{2^{r}}$}

One can introduce a conb in $\mathbb{C}^{2^{r}}$ by the correspondence between
a number basis and GSO basis of $\mathcal{H}_{\mathcal{F}}$ and
\begin{gather}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle =\left\vert
0\cdots0\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}0\cdots0\overset{j_{p}%
}{1}0\cdots0\right\rangle \\
\updownarrow\\
\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  ^{m_{1}\otimes}\otimes\overset{j_{1}}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  ^{m_{2}\otimes}\otimes\cdots\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  ^{m_{p-1}\otimes}\otimes\overset{j_{p}}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  ^{m_{p}\otimes}.
\end{gather}
(Note that $\left\vert 0\cdots0\cdots0\cdots0\cdots0\right\rangle $ is not the
zero vector.)

The inner product in
\begin{equation}
\mathbb{C}^{2^{r}}\cong\,\overset{r}{\overbrace{\mathbb{C}^{2}\otimes
\cdots\otimes\mathbb{C}^{2}}}%
\end{equation}
is given as the usual tensor product inner product
\begin{equation}
\left\langle a_{1}\otimes\cdots\otimes a_{r}\left\vert b_{1}\otimes
\cdots\otimes b_{r}\right.  \right\rangle =%
%TCIMACRO{\dprod \limits_{1\leq p\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq p\leq r}}
%EndExpansion
\left\langle a_{p}\left\vert b_{p}\right.  \right\rangle ,
\end{equation}
which can be extended to the trace in $M\left(  2^{r},\mathbb{C}\right)  $ as
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\sum_{1\leq j_{1},\cdots,j_{r}\leq
2}\left\langle e_{j_{1}}\otimes\cdots\otimes e_{j_{r}}\left\vert Ae_{j_{1}%
}\otimes\cdots\otimes e_{j_{r}}\right.  \right\rangle ,
\end{equation}
where
\begin{align}
e_{1}  &  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  =\left\vert h\right\rangle \\
e_{2}  &  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  =\left\vert p\right\rangle .
\end{align}


\subsection{Bases of $M\left(  2^{r},\mathbb{C}\right)  $ and of $\mathcal{F}%
$}

A basis of $M\left(  2^{r},\mathbb{C}\right)  $ is given by
\begin{equation}
\left\{  \left.  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \phi\right\rangle \left\langle e_{j_{1}}\otimes\cdots\otimes
e_{j_{r}}\right\vert ,\left\vert e_{j_{1}}\otimes\cdots\otimes e_{j_{r}%
}\right\rangle \left\langle \phi\right\vert ,\left\vert e_{j_{1}}\otimes
\cdots\otimes e_{j_{r}}\right\rangle \left\langle e_{j_{1}}\otimes
\cdots\otimes e_{j_{r}}\right\vert \right\vert 1\leq j_{1},\cdots,j_{r}%
\leq2\right\}  .
\end{equation}
$\lceil$%
\begin{align}
r  &  =2\\
\dim\left\{  \mathcal{H}^{0}\right\}   &  =1=\dim\left\{
\operatorname*{linspan}\left\{  \left\vert \phi\right\rangle \right\}
\right\} \\
\dim\left\{  \mathcal{H}^{1}\right\}   &  =2=\dim\left\{
\operatorname*{linspan}\left\{  \left\vert e_{1}\right\rangle ,\left\vert
e_{2}\right\rangle \right\}  \right\} \\
\dim\left\{  \mathcal{H}^{2}\right\}   &  =1=\dim\left\{
\operatorname*{linspan}\left\{  \left\vert e_{1}\right\rangle \otimes
\left\vert e_{2}\right\rangle \right\}  \right\} \\
\dim\left\{  \mathcal{H}_{\mathcal{F}}\right\}   &  =4=\dim\left\{
\operatorname*{linspan}\left\{  \left\vert e_{1}\right\rangle \otimes
\left\vert e_{2}\right\rangle ,\left\vert e_{1}\right\rangle ,\left\vert
e_{2}\right\rangle ,\left\vert \phi\right\rangle \right\}  \right\}
=2^{2}=4\\
\mathcal{H}_{\mathcal{F}}  &  =\mathcal{H}^{0}\oplus\mathcal{H}^{1}%
\oplus\mathcal{H}^{2}%
\end{align}%
\begin{align}
&  M\left(  2^{2},\mathbb{C}\right)  =M\left(  4,\mathbb{C}\right)
\cong\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right) \\
&  M\left(  4,\mathbb{C}\right)  =\operatorname*{linspan}\left\{
\begin{array}
[c]{c}%
\left\vert \phi\right\rangle \left\langle \phi\right\vert ,\left\vert
\phi\right\rangle \left\langle e_{1}\right\vert ,\left\vert \phi\right\rangle
\left\langle e_{2}\right\vert ,\left\vert e_{1}\right\rangle \left\langle
\phi\right\vert ,\left\vert e_{2}\right\rangle \left\langle \phi\right\vert
,\left\vert e_{1}\right\rangle \left\langle e_{1}\right\vert ,\left\vert
e_{2}\right\rangle \left\langle e_{2}\right\vert ,\left\vert e_{1}%
\right\rangle \left\langle e_{2}\right\vert ,\left\vert e_{2}\right\rangle
\left\langle e_{1}\right\vert ,\left\vert e_{1}\otimes e_{2}\right\rangle
\left\langle e_{1}\otimes e_{2}\right\vert ,\\
\left\vert e_{1}\otimes e_{2}\right\rangle \left\langle \phi\right\vert
,\left\vert \phi\right\rangle \left\langle e_{1}\otimes e_{2}\right\vert
,\left\vert e_{1}\right\rangle \left\langle e_{1}\otimes e_{2}\right\vert
,\,\left\vert e_{2}\right\rangle \left\langle e_{1}\otimes e_{2}\right\vert
,\left\vert e_{1}\otimes e_{2}\right\rangle \left\langle e_{1}\right\vert
,\left\vert e_{1}\otimes e_{2}\right\rangle \left\langle e_{2}\right\vert
\end{array}
\right\} \\
&  \dim\left\{  M\left(  4,\mathbb{C}\right)  \right\}  =2^{4}=16
\end{align}
$\rfloor$

which contains in particular the set of $\emph{primitive}$ (\emph{atomic})
self adjoint idempotents
\begin{equation}
\left\{  \left.  \left\vert \phi\right\rangle \left\langle \phi\right\vert
,\left\vert \phi\right\rangle \left\langle e_{j_{1}}\otimes\cdots\otimes
e_{j_{r}}\right\vert ,\left\vert e_{j_{1}}\otimes\cdots\otimes e_{j_{r}%
}\right\rangle \left\langle \phi\right\vert ,\left\vert e_{j_{1}}\otimes
\cdots\otimes e_{j_{r}}\right\rangle \left\langle e_{j_{1}}\otimes
\cdots\otimes e_{j_{r}}\right\vert \right\vert 1\leq j_{1},\cdots,j_{r}%
\leq2\right\}  .
\end{equation}


The matrix elements of this basis wrt the conb $\left\{  \left.  e_{j_{1}%
}\otimes\cdots\otimes e_{j_{r}}\right\vert 1\leq j_{1},\cdots,j_{r}%
\leq2\right\}  $ are given by
\begin{align}
&  \left\langle e_{l_{1}}\otimes\cdots\otimes e_{l_{r}}\left\vert \left\vert
e_{j_{1}}\otimes\cdots\otimes e_{j_{r}}\right\rangle \left\langle e_{k_{1}%
}\otimes\cdots\otimes e_{k_{r}}\right\vert e_{m_{1}}\otimes\cdots\otimes
e_{m_{r}}\right.  \right\rangle \nonumber\\
&  =\left\langle e_{l_{1}}\left\vert e_{j_{1}}\right.  \right\rangle
\cdots\left\langle e_{l_{r}}\left\vert e_{j_{r}}\right.  \right\rangle
\left\langle e_{k_{1}}\left\vert e_{m_{1}}\right.  \right\rangle
\cdots\left\langle e_{k_{r}}\left\vert e_{m_{r}}\right.  \right\rangle =%
%TCIMACRO{\dprod \limits_{\substack{1\leq l_{1},\cdots,l_{r}\leq2\\1\leq
%j_{1},\cdots,j_{r}\leq2\\1\leq k_{1},\cdots,k_{r}\leq2\\1\leq m_{1}%
%,\cdots,m_{r}\leq2}}}%
%BeginExpansion
{\displaystyle\prod\limits_{\substack{1\leq l_{1},\cdots,l_{r}\leq2\\1\leq
j_{1},\cdots,j_{r}\leq2\\1\leq k_{1},\cdots,k_{r}\leq2\\1\leq m_{1}%
,\cdots,m_{r}\leq2}}}
%EndExpansion
\delta_{l_{1}j_{1}}\delta_{k_{1}m_{1}}%
\end{align}


A standard basis of $\mathcal{F}$ is given by (do expansions converge in norm
or strong/weak operator topology?)
\begin{equation}
\left\{  \left.  \left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}%
}\right\vert \right\vert 1\leq p,q\leq r,1\leq j_{1}<\cdots<j_{p}\leq r;1\leq
k_{1}<\cdots<k_{q}\leq r\right\}  ,
\end{equation}
which contains in particular the set of self adjoint idempotents
\begin{equation}
\left\{  \left.  \left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}%
}\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}%
}\right\vert \right\vert 1\leq p\leq r,1\leq j_{1}<\cdots<j_{p}\leq
r.\right\}  .
\end{equation}


The matrix elements of this basis wrt the conb $\left\{  \left.  \left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \right\vert
1\leq p\leq r,1\leq j_{1}<\cdots<j_{p}\leq r\right\}  $ are given by
\begin{align}
&  \left\langle \left\langle \varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{p}%
}\right\vert \left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{m}%
}\right\rangle \right\rangle \left\langle \left\langle \varphi_{k_{1}}%
\wedge\cdots\wedge\varphi_{k_{q}}\right\vert \left\vert \varphi_{s_{1}}%
\wedge\cdots\wedge\varphi_{s_{n}}\right\rangle \right\rangle \nonumber\\
&  =\det\left\{  \left\langle \varphi_{l_{1}}\left\vert \varphi_{j_{1}%
}\right.  \right\rangle \cdots\left\langle \varphi_{l_{p}}\left\vert
\varphi_{j_{p}}\right.  \right\rangle \right\}  \det\left\{  \left\langle
\varphi_{k_{1}}\left\vert \varphi_{s_{1}}\right.  \right\rangle \cdots
\left\langle \varphi_{k_{q}}\left\vert \varphi_{s_{q}}\right.  \right\rangle
\right\}  \delta_{mp}\delta_{qn}%
\end{align}


\subsection{Volume Element}%

\begin{equation}
\mathbf{I}=x_{1}\wedge\cdots\wedge x_{2r}%
\end{equation}
If $r=\infty$ then this definition needs careful analysis.

\subsection{Geometric Product}

The geometric product between two general elements is defined as
\begin{equation}
AB=\sum_{0\leq m,n\leq2r}A_{m}B_{n},
\end{equation}
where
\begin{equation}
A_{m}B_{n}=\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle A_{m}%
B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}.
\end{equation}
E.g. let
\begin{align}
A  &  =A_{0}+A_{1}+A_{2}\\
B  &  =B_{0}+B_{1}+B_{2}+B_{3}+B_{4}%
\end{align}
then
\begin{equation}
AB=A_{0}\left(  B_{0}+B_{1}+B_{2}+B_{3}+B_{4}\right)  +A_{1}\left(
B_{0}+B_{1}+B_{2}+B_{3}+B_{4}\right)  +A_{2}\left(  B_{0}+B_{1}+B_{2}%
+B_{3}+B_{4}\right)  .
\end{equation}
In particular
\begin{align}
\left\langle AB\right\rangle _{0}  &  =\sum_{0\leq m,n\leq4}\sum_{j=0}%
^{2}\left\langle A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}%
=\sum_{0\leq m,n\leq4}\left\{  \left\langle A_{m}B_{n}\right\rangle
_{\left\vert m-n\right\vert }+\left\langle A_{m}B_{n}\right\rangle
_{\left\vert m-n\right\vert +1}+\left\langle A_{m}B_{n}\right\rangle
_{\left\vert m-n\right\vert +2}\right\} \\
&  =\left\langle A_{0}B_{0}\right\rangle _{0}+\left\langle A_{1}%
B_{1}\right\rangle _{0}+\left\langle A_{2}B_{2}\right\rangle _{0}%
\end{align}
The parts containing $A_{1}$ are given by
\begin{align}
A_{1}B_{1}  &  =\sum_{j=0}^{1}\left\langle A_{1}B_{1}\right\rangle
_{2j}=\left\langle A_{1}B_{1}\right\rangle _{0}+\left\langle A_{1}%
B_{1}\right\rangle _{2}\\
A_{1}B_{2}  &  =\sum_{j=0}^{1}\left\langle A_{1}B_{2}\right\rangle
_{1+2j}=\left\langle A_{1}B_{2}\right\rangle _{1}+\left\langle A_{1}%
B_{2}\right\rangle _{3}\\
A_{1}B_{3}  &  =\sum_{j=0}^{1}\left\langle A_{1}B_{3}\right\rangle
_{2+2j}=\left\langle A_{1}B_{3}\right\rangle _{2}+\left\langle A_{1}%
B_{3}\right\rangle _{4}\\
A_{1}B_{4}  &  =\sum_{j=0}^{1}\left\langle A_{1}B_{4}\right\rangle
_{3+2j}=\left\langle A_{1}B_{4}\right\rangle _{3}+\left\langle A_{1}%
B_{4}\right\rangle _{5}.
\end{align}
Expanding the operators in a basis gives
\begin{align}
\left\langle A_{1}B_{1}\right\rangle _{0}  &  =\left\langle \sum_{1\leq
j,k\leq2r}A_{1j}B_{1k}x_{j}x_{k}\right\rangle _{0}=\sum_{1\leq j\leq2r}%
A_{1j}B_{1k}x_{j}^{2}\\
\left\langle A_{1}B_{1}\right\rangle _{2}  &  =\left\langle \sum_{1\leq
j,k\leq2r}A_{1j}B_{1k}x_{j}x_{k}\right\rangle _{2}=\sum_{1\leq j<k\leq
2r}\left(  A_{1j}B_{1k}-A_{1k}B_{1j}\right)  x_{j}x_{k}=\sum_{1\leq j<k\leq
2r}\left\vert
\begin{array}
[c]{cc}%
A_{1j} & A_{1k}\\
B_{1j} & B_{1k}%
\end{array}
\right\vert x_{j}x_{k}%
\end{align}%
\begin{align}
\left\langle A_{1}B_{2}\right\rangle _{1}  &  =\left\langle \frac{1}{2}%
\sum_{1\leq j,k,l\leq2r}A_{1j}B_{2kl}x_{j}x_{k}x_{l}\right\rangle _{1}%
=\frac{1}{2}\sum_{1\leq j,k\leq2r}\left(  A_{1j}B_{2jk}-A_{1j}B_{2kj}\right)
x_{j}^{2}x_{k}\\
\left\langle A_{1}B_{2}\right\rangle _{3}  &  =\left\langle \frac{1}{2}%
\sum_{1\leq j,k,l\leq2r}A_{1j}B_{2kl}x_{j}x_{k}x_{l}\right\rangle _{3}%
=\sum_{1\leq j<k<l\leq2r}\left(  A_{1j}B_{2kl}-A_{1k}B_{2jl}+A_{1l}%
B_{kj}\right)  x_{j}x_{k}x_{l}%
\end{align}%
\begin{align}
\left\langle A_{1}B_{3}\right\rangle _{2}  &  =\left\langle \frac{1}{6}%
\sum_{1\leq j,k,l,m\leq2r}A_{1j}B_{3klm}x_{j}x_{k}x_{l}x_{m}\right\rangle
_{2}\\
&  =\frac{1}{3}\left\{  \sum_{1\leq j<k,l\leq2r}\left(  A_{1j}B_{3kll}%
-A_{1j}B_{3lkl}+A_{1l}B_{3ljk}\right)  x_{j}x_{k}x_{l}^{2}\right\} \\
\left\langle A_{1}B_{3}\right\rangle _{4}  &  =\left\langle \frac{1}{6}%
\sum_{1\leq j,k,l,m\leq2r}A_{1j}B_{3klm}x_{j}x_{k}x_{l}x_{m}\right\rangle
_{4}\\
&  =\sum_{1\leq j<k<l<m\leq2r}\left(  A_{1j}B_{3klm}-A_{1k}B_{3jlm}%
+A_{1l}B_{3kjm}-A_{1m}B_{3klj}\right)  x_{j}x_{k}x_{l}x_{m}%
\end{align}%
\begin{align}
&  \left\langle A_{1}B_{4}\right\rangle _{3}=\left\langle \frac{1}{24}%
\sum_{1\leq j_{1},j_{2},j_{3},j_{4},j_{5}\leq2r}A_{1j_{1}}B_{4j_{2}j_{3}%
j_{4}j_{5}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}\right\rangle _{3}=\\
&  \frac{1}{24}\sum_{1\leq j_{1},j_{2},j_{3},j_{4},j_{5}\leq2r}A_{1j_{1}%
}B_{4j_{2}j_{3}j_{4}j_{5}}\left\{  \delta_{j_{1}j_{2}}x_{j_{3}}\wedge
x_{j_{4}}\wedge x_{j_{5}}-\delta_{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}\wedge
x_{j_{5}}+\delta_{j_{1}j_{4}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{5}}%
+\delta_{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}\wedge x_{j_{5}}\right. \\
&  -\delta_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\delta
_{j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{5}}+\delta_{j_{4}j_{5}%
}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}-\delta_{j_{3}j_{5}}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{4}}\\
&  +\left.  \delta_{j_{2}j_{5}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}%
}-\delta_{j_{1}j_{5}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\right\} \\
&  \left\langle A_{1}B_{4}\right\rangle _{5}=\left\langle \frac{1}{24}%
\sum_{1\leq j_{1},j_{2},j_{3},j_{4},j_{5}\leq2r}A_{1j_{1}}B_{4j_{2}j_{3}%
j_{4}j_{5}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}\right\rangle _{5}\\
&  =\frac{1}{24}\sum_{1\leq j_{1},j_{2},j_{3},j_{4},j_{5}\leq2r}A_{1j_{1}%
}B_{4j_{2}j_{3}j_{4}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge
x_{j_{4}}\wedge x_{j_{5}}%
\end{align}%
\begin{align}
&  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}=x_{j_{1}}\wedge x_{j_{2}%
}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\nonumber\\
&  +\Delta_{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}-\Delta
_{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{5}}+\Delta_{j_{1}j_{4}%
}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\Delta_{j_{2}j_{3}}x_{j_{1}}\wedge
x_{j_{4}}\wedge x_{j_{5}}\nonumber\\
&  -\Delta_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\Delta
_{j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{5}}+\Delta_{j_{4}j_{5}%
}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}-\Delta_{j_{3}j_{5}}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{4}}\nonumber\\
&  +\Delta_{j_{2}j_{5}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}-\Delta
_{j_{1}j_{5}}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\nonumber\\
&  +\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{j_{2}j_{3}j_{4}j_{5}%
}x_{j_{1}}-\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{j_{1}j_{3}%
j_{4}j_{5}}x_{j}+\operatorname*{Pf}\left(  \mathbf{\Delta}\right)
_{j_{1}j_{2}j_{4}j_{5}}x_{j_{3}}-\operatorname*{Pf}\left(  \mathbf{\Delta
}\right)  _{j_{1}j_{2}j_{3}j_{5}}x_{j_{4}}+\operatorname*{Pf}\left(
\mathbf{\Delta}\right)  _{j_{1}j_{2}j_{3}j_{4}}x_{j_{5}},
\end{align}%
\begin{equation}
\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{j_{1}j_{2}j_{3}j_{4}%
}=\Delta_{j_{1}j_{2}}\Delta_{j_{3}j_{4}}-\Delta_{j_{1}j_{3}}\Delta_{j_{2}%
j_{4}}+\Delta_{j_{1}j_{4}}\Delta_{j_{2}j_{3}}.
\end{equation}
The parts containing $A_{2}$ are given by
\begin{align}
A_{2}B_{1}  &  =\sum_{j=0}^{1}\left\langle A_{2}B_{1}\right\rangle
_{1+2j}=\left\langle A_{2}B_{1}\right\rangle _{1}+\left\langle A_{2}%
B_{1}\right\rangle _{3}\\
A_{2}B_{2}  &  =\sum_{j=0}^{2}\left\langle A_{2}B_{2}\right\rangle
_{2j}=\left\langle A_{2}B_{2}\right\rangle _{0}+\left\langle A_{2}%
B_{2}\right\rangle _{2}+\left\langle A_{2}B_{2}\right\rangle _{4}\\
A_{2}B_{3}  &  =\sum_{j=0}^{2}\left\langle A_{2}B_{3}\right\rangle
_{1+2j}=\left\langle A_{2}B_{3}\right\rangle _{1}+\left\langle A_{2}%
B_{3}\right\rangle _{3}+\left\langle A_{2}B_{3}\right\rangle _{5}\\
A_{2}B_{4}  &  =\sum_{j=0}^{2}\left\langle A_{2}B_{4}\right\rangle
_{2+2j}=\left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle A_{2}%
B_{4}\right\rangle _{4}+\left\langle A_{2}B_{4}\right\rangle _{6},
\end{align}
where *****
\begin{align}
\left\langle A_{2}B_{1}\right\rangle _{1}  &  =\\
\left\langle A_{2}B_{1}\right\rangle _{3}  &  =
\end{align}
%

\begin{align}
\left\langle A_{2}B_{2}\right\rangle _{0}  &  =\\
\left\langle A_{2}B_{2}\right\rangle _{2}  &  =\\
\left\langle A_{2}B_{2}\right\rangle _{4}  &  =
\end{align}
%

\begin{align}
\left\langle A_{2}B_{3}\right\rangle _{1}  &  =\\
\left\langle A_{2}B_{3}\right\rangle _{3}  &  =\\
\left\langle A_{2}B_{3}\right\rangle _{5}  &  =
\end{align}%
\begin{align}
\left\langle A_{2}B_{4}\right\rangle _{2}  &  =\\
\left\langle A_{2}B_{4}\right\rangle _{4}  &  =\\
\left\langle A_{2}B_{4}\right\rangle _{6}  &  =
\end{align}


\subsection{Blades and Versors}

A blade is
\begin{equation}
\mathrm{b}_{p}=v_{1}\wedge\cdots\wedge v_{p}=\left\langle v_{1}\wedge
\cdots\wedge v_{p}\right\rangle _{p}%
\end{equation}
while a versor is
\begin{equation}
\mathrm{v}_{p}=v_{1}\cdots v_{p}=\sum_{0\leq q\leq p}\left\langle v_{1}\cdots
v_{p}\right\rangle _{q}.
\end{equation}
E.g.%
\begin{equation}
\mathrm{v}_{2}=\sum_{1\leq j\leq k\leq2r}v_{jk}x_{j}x_{k}=\left(  \sum_{1\leq
j\leq2r}v_{jj}\right)  I_{\mathcal{F}}+\sum_{1\leq j<k\leq2r}v_{jk}x_{j}x_{k}.
\end{equation}


\subsection{Reversion t}%

\begin{equation}
\mathrm{v}_{p}^{t}=v_{p}\cdots v_{1}=\left(  -1\right)  ^{\frac{p\left(
p-1\right)  }{2}}v_{1}\cdots v_{p}.
\end{equation}


\subsection{Inverse}

\bigskip If $\mathrm{v}_{p}$ is invertible its inverse is given by
\begin{equation}
\mathrm{v}_{p}^{-1}=\frac{\mathrm{v}_{p}^{\dagger}}{\left\Vert \mathrm{v}%
_{p}\right\Vert _{HS}^{2}}.
\end{equation}
Thus all non null elements are invertible.

\subsection{Hermitian Reversion $\dagger$}

$\dagger$ is reversion composed with complex conjugation
\begin{equation}
\mathrm{v}_{p}^{\dagger}=v_{p}\cdots v_{1}=\left(  -1\right)  ^{\frac{p\left(
p-1\right)  }{2}}\overline{v_{1}\cdots v_{p}}%
\end{equation}


\subparagraph{Grade involution $\ast$
\begin{equation}
\mathrm{v}_{p}^{\ast}=\left(  -1\right)  ^{p}\mathrm{v}_{p}%
\end{equation}
}

\subparagraph{Scaler (inner) products%
\begin{align}
\left(  \left.  \mathrm{v}_{p}\right\vert \mathrm{w}_{p}\right)  _{h}  &
=\left\langle \left.  \mathrm{v}_{p}\right\vert \mathrm{v}_{p}\right\rangle
=\left\langle \mathrm{v}_{p}^{\dagger}\mathrm{w}_{p}\right\rangle
_{0}=\overline{v_{1}}w_{1}\cdots\overline{v_{p}}w_{p}\\
\left(  \left.  \mathrm{v}_{p}\right\vert \mathrm{w}_{p}\right)  _{s}  &
=\left\langle \mathrm{v}_{p}^{t}\mathrm{w}_{p}\right\rangle _{0}=v_{1}%
w_{1}\cdots v_{p}w_{p}%
\end{align}
}

\subparagraph{Norm
\begin{equation}
\left\Vert \mathrm{v}_{p}\right\Vert _{HS}^{2}=\left\langle \left.
\mathrm{v}_{p}\right\vert \mathrm{v}_{p}\right\rangle =\left\langle
\left\langle \mathrm{v}_{p}^{\dagger}\mathrm{v}_{p}\right\rangle \right\rangle
_{0}=\left\Vert v_{1}\right\Vert ^{2}\cdots\left\Vert v_{p}\right\Vert ^{2}.
\end{equation}
}

\subparagraph{Clifford conjugation
\begin{equation}
\mathrm{v}_{p}^{\ddagger}=\mathrm{v}_{p}^{\dagger\ast}=\left(  -1\right)
^{\frac{2p+p\left(  p-1\right)  }{2}}v_{1}\cdots v_{p}=\left(  -1\right)
^{\frac{p\left(  p+1\right)  }{2}}v_{1}\cdots v_{p}.
\end{equation}
}

\subsection{Generalized Inner Products}

Left and right contractions are defined as
\begin{align}
A\rfloor B  &  =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{p-q}\\
A\lfloor B  &  =\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{q-p}%
\end{align}
In particular
\begin{align}
a\rfloor A_{p}  &  =\frac{1}{2}\left(  aA_{p}-\left(  -1\right)  ^{p}%
A_{p}a\right) \\
a\lfloor A_{p}  &  =\frac{1}{2}\left(  A_{p}a-\left(  -1\right)  ^{p}%
aA_{p}\right)
\end{align}
and
\begin{equation}
\left(  \left.  a\right\vert b\right)  =a\rfloor b=\left\langle
ab\right\rangle _{0}.
\end{equation}


\emph{Thin dot}%

\begin{equation}
A\cdot B=\sum_{1\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{\left\vert p-q\right\vert }%
\end{equation}
which is another generalization of $\left(  \left.  {}\right\vert \right)  $
from vectors.

\emph{fat dot}
\begin{equation}
A\bullet B=\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle
_{\left\vert p-q\right\vert }.
\end{equation}
and \emph{Trace}%
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\left\langle A\right\rangle _{0}.
\end{equation}


\subsection{Outer Product $\equiv\left(  \text{Vector}\right)  $ Wedge Product
$\equiv$ $\left(  \text{Vector}\right)  $ Exterior Product}%

\begin{equation}
A\wedge B=\sum_{0\leq p,q\leq2r}\left\langle A_{p}B_{q}\right\rangle _{q+p}%
\end{equation}
which gives in particular
\begin{align}
A\wedge A  &  =\sum_{0\leq p,q\leq4}\left\langle A_{p}A_{q}\right\rangle
_{q+p}=\\
&  +\left\langle A_{0}A_{0}\right\rangle _{0}+2\left\langle A_{1}%
A_{0}\right\rangle _{1}+2\left\langle A_{2}A_{0}\right\rangle _{2}%
+2\left\langle A_{3}A_{0}\right\rangle _{3}+2\left\langle A_{4}A_{0}%
\right\rangle _{4}\\
&  +2\left\langle A_{0}A_{1}\right\rangle _{2}+\left\langle A_{1}%
A_{1}\right\rangle _{2}+2\left\langle A_{2}A_{1}\right\rangle _{3}%
+2\left\langle A_{3}A_{1}\right\rangle _{4}+2\left\langle A_{4}A_{1}%
\right\rangle _{5}\\
&  +2\left\langle A_{0}A_{2}\right\rangle _{2}+2\left\langle A_{1}%
A_{2}\right\rangle _{3}+\left\langle A_{2}A_{2}\right\rangle _{4}%
+2\left\langle A_{3}A_{2}\right\rangle _{5}+2\left\langle A_{4}A_{2}%
\right\rangle _{6}\\
&  +2\left\langle A_{0}A_{3}\right\rangle _{3}+2\left\langle A_{1}%
A_{3}\right\rangle _{4}+2\left\langle A_{2}A_{3}\right\rangle _{5}%
+\left\langle A_{3}A_{3}\right\rangle _{6}+2\left\langle A_{4}A_{3}%
\right\rangle _{7}\\
&  +2\left\langle A_{0}A_{4}\right\rangle _{4}+2\left\langle A_{1}%
A_{4}\right\rangle _{5}+2\left\langle A_{2}A_{4}\right\rangle _{6}%
+2\left\langle A_{3}A_{4}\right\rangle _{7}+\left\langle A_{4}A_{4}%
\right\rangle _{8}.
\end{align}


\subsection{Scalar Product}%

\begin{align}
\left\langle \left.  A\right\vert B\right\rangle  &  =\left(  \left.
A\right\vert B\right)  _{h}=\left\langle A^{\dagger}B\right\rangle _{0}\vec
{=}\sum_{0\leq p\leq2r}\left(  \left.  A_{p}\right\vert B_{p}\right)
_{h}=\sum_{0\leq p\leq2r}A_{p}^{\dagger}\rfloor B_{p}=\sum_{0\leq p\leq
2r}A_{p}^{\dagger}\lfloor B_{p}\\
\left\vert A\right\vert _{HS}^{2}  &  =\left(  \left.  A\right\vert A\right)
\text{ (which could be zero, negative or even a number!)}\\
\left\langle \left.  A_{p}\right\vert B_{q}\right\rangle  &  =\left\langle
\left.  A_{p}\right\vert B_{p}\right\rangle \delta_{pq}.
\end{align}


Let
\begin{align}
A_{p}  &  =a_{1}\wedge\cdots\wedge a_{p}\\
B_{p}  &  =b_{1}\wedge\cdots\wedge b_{p}%
\end{align}
then
\begin{align}
\left\langle \left.  A_{p}\right\vert B_{p}\right\rangle  &  =\left(
-1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\left\langle \left.  a_{p}%
\wedge\cdots\wedge a_{1}\right\vert b_{1}\wedge\cdots\wedge b_{p}\right\rangle
=\left(  -1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\left\langle \left(
a_{p}\wedge\cdots\wedge a_{1}\right)  \left(  b_{1}\wedge\cdots\wedge
b_{p}\right)  \right\rangle _{0}\\
&  =\left(  -1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\sum_{\substack{1\leq
j_{1}<\cdots<j_{p}\leq2r\\1\leq k_{1}<\cdots<k_{p}\leq2r}}\left\langle
a_{pj_{1}}\cdots a_{1j_{1}}x_{j_{p}}\wedge\cdots\wedge x_{j_{1}}b_{pk_{p}%
}\cdots b_{1k_{1}}x_{k_{1}}\wedge\cdots\wedge x_{k_{p}}\right\rangle _{0}\\
&  =\left(  -1\right)  ^{\frac{p\left(  p-1\right)  }{2}}\sum_{\substack{1\leq
j_{1}<\cdots<j_{p}\leq2r\\1\leq k_{1}<\cdots<k_{p}\leq2r}}\left\vert
\begin{array}
[c]{ccc}%
\left(  \left.  a_{j_{1}}\right\vert b_{k_{1}}\right)  & \cdots & \left(
\left.  a_{j_{1}}\right\vert b_{k_{p}}\right) \\
\vdots & \vdots & \vdots\\
\left(  \left.  a_{j_{p}}\right\vert b_{k_{1}}\right)  & \cdots & \left(
\left.  a_{j_{p}}\right\vert b_{k_{p}}\right)
\end{array}
\right\vert .
\end{align}


\subsubsection{Frames and Matrices}

One can introduce orthonormal or biorthogonal bases in $\mathcal{F}$ using
these products.

The basis $\left\{  \left.  x_{j}\right\vert 1\leq j\leq2r\right\}  $ is frame
as
\begin{equation}
x_{1}\wedge\cdots\cdots\wedge x_{2r}\neq0,
\end{equation}
which is orthogonal
\begin{equation}
\left\langle \left.  x_{j}\right\vert x_{k}\right\rangle =\left\langle
\left\langle x_{j}^{\dagger}x_{k}\right\rangle \right\rangle _{0}%
I_{\mathcal{F}}=0
\end{equation}
but not normalized as
\begin{equation}
\left\langle x_{j}^{\dagger}x_{j}\right\rangle _{0}=\frac{1}{2}I_{\mathcal{F}%
}.
\end{equation}
It is easy to construct non orthogonal vectors e.g.
\begin{align}
v  &  =x_{1}+x_{2}\\
w  &  =2x_{1}-x_{2}\\
\left\langle \left.  v\right\vert w\right\rangle  &  =1-\frac{1}{2}=\frac
{1}{2}.
\end{align}


\subsection{Adjoint}

Let $F$ be a linear transformation
\begin{equation}
F:\mathcal{F}_{1}\rightarrow\mathcal{F}_{1}%
\end{equation}
then it can be naturally extended to
\begin{equation}
F:\mathcal{F}\rightarrow\mathcal{F}%
\end{equation}
and is an algebra homomorphism wrt the geometric product $\wedge$ i.e.%

\begin{equation}
F\left(  A\wedge B\right)  =F\left(  A\right)  \wedge F\left(  B\right)
\,\forall A,B\in\mathcal{F}%
\end{equation}
and if $F$ is an isometry i.e.
\begin{equation}
F\left(  A\rfloor B\right)  =F\left(  A\right)  \rfloor F\left(  B\right)
\forall A,B\in\mathcal{F}%
\end{equation}
then
\begin{equation}
F\left(  AB\right)  =F\left(  A\right)  F\left(  B\right)  \,\forall
A,B\in\mathcal{F}.
\end{equation}
The converse is also true i.e.
\begin{equation}
F\left(  AB\right)  =F\left(  A\right)  F\left(  B\right)  \,\forall
A,B\in\mathcal{F\Rightarrow}F\left(  A\rfloor B\right)  =F\left(  A\right)
\rfloor F\left(  B\right)  \forall A,B\in\mathcal{F}.
\end{equation}


The adjoint $\mathcal{F}^{\blacksquare}$ is defined by%
\begin{equation}
\left\langle \left.  \mathcal{F}^{\blacksquare}\left(  A\right)  \right\vert
B\right\rangle =\left\langle \left.  A\right\vert F\left(  B\right)
\right\rangle \forall B\in\mathcal{F}.
\end{equation}
One can show that
\begin{equation}
\blacksquare=\dagger.
\end{equation}


An element $A$ of a Clifford Algebra is \emph{positive} i.e. $A\geq0$
$\operatorname*{Iff}$
\begin{equation}
A=B^{\dagger}B.
\end{equation}
Thus
\begin{equation}
A\geq0\Rightarrow A=A^{\dagger}.
\end{equation}
\emph{Note that the square of an operator need not be positive} i.e. $C^{2}$
could be negative, zero or complex (think of complex eigenvalues)!

\subsubsection{Outer Nilpotency}

One can note that $\wedge$ is the adjoint of $\rfloor$
\begin{equation}
\left\langle \left.  \left(  A\wedge B\right)  \right\vert C\right\rangle
=\left\langle A\left\vert \left(  B\rfloor C\right)  \right.  \right\rangle .
\end{equation}
Thus
\begin{equation}
\left\langle \left.  \left(  A\wedge A\right)  \right\vert C\right\rangle
=\left\langle A\left\vert \left(  A\rfloor C\right)  \right.  \right\rangle .
\end{equation}
If
\begin{equation}
\left(  A_{4}\wedge A_{4}\right)  =0
\end{equation}
then
\begin{equation}
\left\langle \left.  A_{4}\right\vert \left(  A_{4}\rfloor C\right)
\right\rangle =\left\langle A_{4}\left\vert \left\langle \left(  A_{4}\rfloor
C\right)  \right\rangle _{4}\right.  \right\rangle =0\forall C.
\end{equation}
as%
\begin{equation}
A_{4}\rfloor C=\sum_{0\leq q\leq2r}\left\langle A_{4}C_{q}\right\rangle
_{q-4}=\left\langle A_{4}C_{4}\right\rangle _{0}+\left\langle A_{4}%
C_{5}\right\rangle _{1}+\left\langle A_{4}C_{6}\right\rangle _{2}+\left\langle
A_{4}C_{7}\right\rangle _{3}+\left\langle A_{4}C_{8}\right\rangle _{4}%
+\cdots+\left\langle A_{4}C_{2r}\right\rangle _{2r-4}%
\end{equation}
hence
\begin{equation}
\left\langle A_{4}\rfloor C\right\rangle _{4}=\left\langle A_{4}%
C_{8}\right\rangle _{4}%
\end{equation}
and%
\begin{equation}
\left\langle \left.  A_{4}\right\vert \left(  A_{4}\rfloor C\right)
\right\rangle =\left\langle A_{4}\left\vert \left\langle A_{4}C_{8}%
\right\rangle _{4}\right.  \right\rangle =0\forall C.
\end{equation}
This is equivalent to
\begin{equation}
\left\langle \left.  A_{4}\right\vert \left\langle A_{4}\rfloor x_{k_{1}%
}\wedge\cdots\wedge x_{k_{8}}\right\rangle _{4}\right\rangle =0,\,1\leq
k_{1}<\cdots<k_{8}\leq2r.
\end{equation}%
\begin{align}
&  A_{4}\rfloor x_{k_{1}}\wedge\cdots\wedge x_{k_{8}}=\left\langle
A_{4}x_{k_{1}}\wedge\cdots\wedge x_{k_{8}}\right\rangle _{4}\\
&  =\sum_{1\leq j_{1}<\cdots<j_{4}\leq2r}A_{j_{1}j_{2}j_{3}j_{4}}\left\langle
x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{k_{1}}x_{k_{2}}x_{k_{3}}x_{k_{4}%
}x_{k_{5}}x_{k_{6}}x_{k_{7}}x_{k_{8}}\right\rangle _{4}\\
&  =A_{k_{1}k_{2}k_{3}k_{4}}x_{k_{5}}x_{k_{6}}x_{k_{7}}x_{k_{8}}-A_{k_{1}%
k_{2}k_{3}k_{8}}x_{k_{4}}x_{k_{5}}x_{k_{6}}x_{k_{7}}+\cdots\\
&  \left\langle \left.  A_{4}\right\vert \left\langle A_{4}\rfloor x_{k_{1}%
}\wedge\cdots\wedge x_{k_{8}}\right\rangle _{4}\right\rangle =A_{k_{5}%
k_{6}k_{7}k_{8}}A_{k_{1}k_{2}k_{3}k_{4}}-A_{k_{4}k_{5}k_{6}k_{7}}A_{k_{1}%
k_{2}k_{3}k_{8}}+\cdots=0
\end{align}
i.e.
\begin{equation}
A_{5678}A_{1234}-A_{4567}A_{1238}+\cdots=0
\end{equation}
Let%
\[
A_{4}=A_{1234}e_{1234}+A_{1235}e_{1235}+A_{4678}e_{4678}+A_{5678}e_{5678}%
\]%
\begin{align}
&  A_{4}\wedge A_{4}\\
&  =\left(  A_{1234}e_{1234}+A_{1235}e_{1235}+A_{4678}e_{4678}+A_{5678}%
e_{5678}\right) \\
&  \wedge\left(  A_{1234}e_{1234}+A_{1235}e_{1235}+A_{4678}e_{4678}%
+A_{5678}e_{5678}\right) \\
&  =\left(  A_{1234}A_{5678}-A_{1235}A_{4678}\right)  e_{12345678}%
\end{align}%
\begin{align}
&  1234,1235,1236,1237,1238,\\
&  1245,1246,1247,1248,\\
&  1345,1346,1348,\\
&  1256,1257,1258,\\
&  1267,1268,\\
&  1278
\end{align}%
\begin{equation}
\binom{4}{1}+\binom{4}{2}+\binom{4}{3}=4+6+4=14
\end{equation}


\subsection{Determinant}

The determinant of $F,\det(F)\in$ $\mathcal{F}$ can be defined by
\begin{equation}
\det(F)\mathbf{I}=F\left(  \mathbf{I}\right)
\end{equation}
or equivalently
\begin{equation}
\det(F)=F\left(  \mathbf{I}\right)  ^{\bot}%
\end{equation}


\subsection{Dual (Hodge)}%

\begin{equation}
A^{\bot}=A\rfloor\mathbf{I}^{-1}=A\mathbf{I}^{-1}%
\end{equation}
where
\begin{equation}
\mathbf{I}^{-1}=\frac{\mathbf{I}^{\dagger}}{\left\Vert \mathbf{I}\right\Vert
_{HS}^{2}}%
\end{equation}
In particular
\begin{equation}
\left(  v_{1}\wedge\cdots\wedge v_{p}\right)  ^{\bot}=v_{p+1}\wedge
\cdots\wedge v_{2r}%
\end{equation}


\subsection{Projections and Rejections}

A vector $a$ can be decomposed as
\begin{equation}
a=amm^{-1}=\left\{  \left(  a\left\vert m\right.  \right)  +a\wedge m\right\}
m^{-1}=a_{\parallel m}+a_{\bot m},
\end{equation}
where $a_{\parallel m}$ is the \emph{Projection} of $a$ onto $m$ and $a_{\bot
m}$ is the \emph{Rejection} of $a$ onto $m.$ This can be expressed as
\begin{equation}
a=\mathcal{P}_{m}\left(  a\right)  +\mathcal{P}_{m}^{\bot}\left(  a\right)  ,
\end{equation}
where
\begin{align}
\mathcal{P}_{m}\left(  a\right)   &  =\left(  a\rfloor m^{-1}\right)  \rfloor
m=\left\vert m\right)  \left(  m^{r}\right\vert a\\
\mathcal{P}_{m}^{\bot}\left(  a\right)   &  =a-\mathcal{P}_{m}\left(
a\right)  .
\end{align}
These definitions generalize to
\begin{align}
A  &  =\mathcal{P}_{B}\left(  A\right)  +\mathcal{P}_{B}^{\bot}\left(
A\right) \\
\mathcal{P}_{B}\left(  A\right)   &  =\left(  A\rfloor B^{-1}\right)  \rfloor
A=\left\vert B\right)  \left(  \left.  B^{r}\right\vert A\right) \\
\mathcal{P}_{B}^{\bot}\left(  A\right)   &  =A-\mathcal{P}_{B}\left(
A\right)  ,
\end{align}
where $A$ is a general element and $B$ is a blade. E.g.%

\begin{equation}
\mathcal{P}_{x_{1}}\left(  a\right)  =\left\vert x_{1}\right)  \left(  \left.
x_{1}^{r}\right\vert a\right)
\end{equation}%
\begin{align}
\mathcal{P}_{x_{1}\wedge\cdots\wedge x_{p}}\left(  a\right)   &
=\sum_{\substack{1\leq p_{1}<\cdots p_{q}\leq q\\1\leq q\leq p}}\left\vert
x_{p_{1}}\wedge\cdots\wedge x_{p_{q}}\right)  \left(  \left.  \left(
x_{p_{1}}\wedge\cdots\wedge x_{p_{q}}\right)  ^{r}\right\vert a\right) \\
&  =\sum_{\substack{1\leq p_{1}<\cdots p_{q}\leq p\\1\leq q\leq p}}\left\vert
x_{p_{1}}\wedge\cdots\wedge x_{p_{q}}\right)  \left(  \left.  \left(
x_{p_{1}}\wedge\cdots\wedge x_{p_{q}}\right)  ^{r}\right\vert a\right) \\
&  =\sum_{1\leq p_{1}\leq p}\left\vert x_{p_{1}}\right)  \left(  \left.
\left(  x_{p_{1}}\right)  ^{r}\right\vert a\right)
\end{align}


\section{States}

\subsection{Definition}

\qquad A state is a positive normalized linear functional
\begin{align}
f  &  :\mathcal{F}\rightarrow\mathbb{C}\\
f\left(  I_{\mathcal{F}}\right)   &  =1\\
f  &  =f^{\dagger}\\
f  &  :\mathcal{F}_{sa}\rightarrow\mathbb{R}.
\end{align}
It is extremal if it cannot be decomposed into a convex sum of two other
states. A non extremal state can be expressed as a \emph{convex} sum of
extremal states i.e.
\begin{equation}
f=\sum_{1\leq j\leq p}\lambda_{j}f_{j}.
\end{equation}


\subsection{Density Operators}

A state $f_{D}$ is a Normal state if there exists a density operator
$D=D^{\dagger}\geq0\in\mathcal{F}$ such that
\begin{equation}
f_{D}\left(  A\right)  =\operatorname*{tr}\left\{  A^{\dagger}D\right\}
\,\forall A\in\mathcal{F}.
\end{equation}
As%
\begin{equation}
\left\langle \left.  A\right\vert D\right\rangle =\sum_{0\leq j\leq2^{2r}%
}\left\langle A_{j}^{\dagger}D_{j}\right\rangle _{0}=\sum_{0\leq j\leq2^{2r}%
}\operatorname*{tr}\left\{  \left\langle A_{j}^{\dagger}D_{j}\right\rangle
_{0}\right\}  I_{\mathcal{F}}%
\end{equation}
then
\begin{equation}
f_{D}\left(  A\right)  =\sum_{0\leq j\leq2^{2r}}\operatorname*{tr}\left\{
\left\langle A_{j}^{\dagger}D_{j}\right\rangle _{0}\right\}  .
\end{equation}
In particular as
\begin{equation}
D=\sum_{0\leq j\leq2^{2r}}\left\langle D\right\rangle _{j}\equiv\sum_{0\leq
j\leq2^{2r}}D_{j}%
\end{equation}
one has%
\begin{equation}
\left\langle \left\langle I_{\mathcal{F}}D\right\rangle \right\rangle
_{0}=D_{0}%
\end{equation}
and
\begin{equation}
f_{D}\left(  I_{\mathcal{F}}\right)  =\operatorname*{tr}\left\{
D_{0}\right\}  =1,
\end{equation}
thus
\begin{equation}
D=I_{\mathcal{F}}+\sum_{1\leq j\leq2^{2r}}D_{j}.
\end{equation}
$\lceil$%
\begin{equation}
\frac{1}{2^{r}}\operatorname{Tr}\left\{  D\right\}  =D_{0}\operatorname*{tr}%
\left\{  I\right\}  =\frac{D_{0}}{2^{r}}\operatorname{Tr}\left\{  I\right\}
=D_{0}=1
\end{equation}%
\begin{equation}
\operatorname{Tr}\left\{  \left\vert \varphi\right\rangle \left\langle
\varphi\right\vert \right\}  =1=\left\langle \left\langle \left\vert
\varphi\right\rangle \left\langle \varphi\right\vert \right\rangle
\right\rangle _{0}%
\end{equation}
$\rfloor$

If $\left\{  p_{j}\right\}  $ is a set of primitive self adjoint idempotents
of $\mathcal{F}$ which form a resolution of the identity
\begin{equation}
I_{\mathcal{F}}=\sum_{1\leq j\leq2^{2r}}p_{j}%
\end{equation}
and
\begin{equation}
f\left(  I_{\mathcal{F}}\right)  =1=\sum_{1\leq j\leq p}f\left(  p_{j}\right)
=\sum_{1\leq j,k\leq p}\lambda_{k}f_{k}\left(  p_{j}\right)  \Leftrightarrow
f_{k}\left(  p_{j}\right)  =\delta_{jk}%
\end{equation}
and thus there is a $1-1$ correspondence between extremal states and primitive
idempotents of $\mathcal{F}.$

\subsection{Extension Condition}

\subsubsection{Positivity}

A linear functional is positive on a subspace $\mathcal{S\subseteq F}$ if
\begin{equation}
f\left(  p\right)  \geq0
\end{equation}
\emph{for a generating set, $\mathfrak{P}\left(  \mathcal{S}\right)
\mathfrak{,}$ of \underline{\emph{self adjoint}} idempotents }$p\in
\mathcal{S}$\emph{$\mathfrak{.}$} If
\begin{equation}
I_{\mathcal{F}}\in\mathcal{F}%
\end{equation}
then
\begin{equation}
0\leq f\left(  p\right)  \leq1\,\,\forall p\in\emph{\mathfrak{P}\left(
\mathcal{S}\right)  .}%
\end{equation}


\subsubsection{Generating Set}

A generating set \emph{$\mathfrak{P}\left(  \mathcal{S}\right)  $ }is the
minimal set of projectors (self adjoint)
\begin{equation}
\emph{\mathfrak{P}\left(  \mathcal{S}\right)  }=\left\{  \left.  p_{j}%
\in\mathcal{S}\right\vert 1\leq j\leq q\right\}
\end{equation}
needed to generate all projectors in a subspace of $\mathcal{S}.$ This set
\emph{is not }closed under linear combinations even for orthogonal projectors
\begin{equation}
p_{j}p_{k}=p_{j}\delta_{jk};1\leq j\leq q,
\end{equation}
as in general
\begin{equation}
\left(  \sum_{1\leq j\leq q}\lambda_{j}p_{j}\right)  ^{2}\neq\sum_{1\leq j\leq
q}\lambda_{j}p_{j},
\end{equation}
as
\begin{equation}
\left(  \sum_{1\leq j\leq q}\lambda_{j}p_{j}\right)  ^{2}=\sum_{1\leq j\leq
q}\lambda_{j}p_{j}%
\end{equation}
Iff
\begin{equation}
\left(  \sum_{1\leq j\leq q}\lambda_{j}p_{j}\right)  ^{2}=\sum_{1\leq j\leq
q}\lambda_{j}^{2}p_{j}%
\end{equation}
i.e.
\begin{align}
\lambda_{j}-\lambda_{j}^{2}  &  =\lambda_{j}\left(  1-\lambda_{j}\right)  =0\\
&  \Rightarrow\lambda_{j}=0,1;1\leq j\leq q.
\end{align}


\subsubsection{States}

One has the relation
\begin{equation}
I_{\mathcal{F}}\geq p\geq0
\end{equation}
for all self adjoint idempotents $p.$

$\lceil$One can observe that
\begin{align}
\left(  I_{\mathcal{F}}-p\right)  ^{2}  &  =I_{\mathcal{F}}%
-2p+p=I_{\mathcal{F}}-p\\
I_{\mathcal{F}}-p  &  =\left(  I_{\mathcal{F}}-p\right)  ^{\dagger}\left(
I_{\mathcal{F}}-p\right)  ^{\dagger}\geq0,
\end{align}
thus
\begin{align}
I_{\mathcal{F}}-p  &  \geq0\\
p  &  \geq0\\
I_{\mathcal{F}}  &  \geq0.
\end{align}
In particular
\begin{equation}
I_{\mathcal{F}}-p\geq0\Rightarrow I_{\mathcal{F}}\geq p
\end{equation}
for all self adjoint idempotents $p.\rfloor$

Thus
\begin{equation}
f\left(  I_{\mathcal{F}}-p\right)  f\left(  I_{\mathcal{F}}\right)
0\Rightarrow f\left(  I_{\mathcal{F}}\right)  \geq f\left(  p\right)
\equiv1\geq f\left(  p\right)  \geq0
\end{equation}
for all self adjoint idempotents $p$ as $f\left(  I_{\mathcal{F}}\right)  =1.$

The necessary and sufficient condition for $f$ to be a state is thus
\begin{equation}
0\leq f\left(  p\right)  \leq1\,\forall p\in\emph{\mathfrak{P}\left(
\mathcal{F}\right)  }\,\text{and }f\left(  I_{\mathcal{F}}\right)  =1
\end{equation}
\emph{for a generating set, $\mathfrak{P}\left(  \mathcal{F}\right)
\mathfrak{,}$ of self adjoint idempotents }$p$\emph{$\mathfrak{.}$}

\subsubsection{Reduced States and Partial States}

A positive linear functional on a subspace $\mathcal{S\subseteq F}$ is a
\emph{Reduced State }if it is the restriction of a state and $I\notin%
\mathcal{S}$, while it is a \emph{Partial State }if it is the restriction of a
state and $I\in\mathcal{S}.$

The \emph{Necessary and sufficient condition for the existance of a state that
extends }a positive linear functional $f$ defined on a subspace
$\mathcal{S\subseteq F}$

\emph{is }for a reduced state\emph{ }%
\begin{equation}
0\leq f\left(  p\right)  \leq1\text{ if }I\notin\mathcal{S}%
\end{equation}
\emph{or }for a partial state\emph{ }%
\begin{equation}
0\leq f\left(  p\right)  \text{ and }f\left(  I\right)  =1\text{ if }%
I\in\mathcal{S}%
\end{equation}
\emph{for all self adjoint idempotents }$p\in$\emph{$\mathfrak{P}\left(
\mathcal{S}\right)  \mathfrak{.}$}

$\lceil$%
\begin{gather}
\text{If }\left\{  p_{j}\right\}  \in\mathcal{S}\text{ and }p_{j}p_{k}%
=p_{j}\delta_{jk}\text{ then }\\
0\leq f\left(
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
p_{j}\right)  \leq1\\
0\leq f\left(
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
\alpha_{j}p_{j}\right)  \leq1;0\leq\alpha_{j}\leq1,%
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
\alpha_{j}=1,1\leq j\leq q
\end{gather}
$\lceil$The sum of orthogonal projectors is also a projector i.e.
\begin{equation}
\left(
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
p_{j}\right)  ^{2}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
p_{j}^{2}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
p_{j},
\end{equation}
however the convex sum is not%
\begin{equation}
\left(
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
\alpha_{j}p_{j}\right)  ^{2}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
\alpha_{j}^{2}p_{j}^{2}=%
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
\alpha_{j}^{2}p_{j}.
\end{equation}
$\rfloor$

If $p$ is a non primitive self adjoint idempotent then
\begin{equation}
p=%
%TCIMACRO{\tsum \limits_{1\leq j\leq q}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j\leq q}}
%EndExpansion
p_{j},
\end{equation}
where $\left\{  p_{j}\right\}  $ are orthogonal projectors.

$\rfloor$\emph{ }

\subsection{Expectation Values and States}

The standard Hamiltonian of molecular and atomic systems is of the form
\begin{equation}
H=\eta_{0}I_{\mathcal{F}}+i\sum_{1\leq j_{1}<j_{2}\leq2r}\eta_{2j_{1}j_{2}%
}x_{j_{1}}x_{j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\eta
_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}%
\end{equation}
and the energy in a state $f_{D}$ is given by
\begin{align}
f_{D}\left(  H\right)   &  =\operatorname*{tr}\left\{  \left\langle H_{0}%
D_{0}\right\rangle _{0}\right\}  +\operatorname*{tr}\left\{  \left\langle
H_{2}D_{2}\right\rangle _{0}\right\}  +\operatorname*{tr}\left\{  \left\langle
H_{4}D_{4}\right\rangle _{0}\right\}  =\operatorname*{tr}\left\{  H\ast
D\right\} \nonumber\\
&  =\operatorname*{tr}\left\{  H_{0}\ast D_{0}+H_{2}\ast D_{2}+H_{4}\ast
D_{4}\right\} \nonumber\\
&  =\eta_{0}+\sum_{1\leq j_{1}<j_{2}\leq2r}\eta_{2j_{1}j_{2}}d_{2j_{2}j_{1}%
}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\eta_{4j_{1}j_{2}j_{3}j_{4}%
}d_{4j_{1}j_{2}j_{3}j_{4}}.
\end{align}
The Hamiltonian is defined by the real parameters $\left\{  \eta_{0}%
,\eta_{2j_{1}j_{2}},\eta_{4j_{1}j_{2}j_{3}j_{4}}\right\}  ,$where
\begin{align}
\eta_{0}  &  =\left\{  \lambda_{0}+\frac{1}{2}\left(  \operatorname*{Tr}%
\lambda_{1}\right)  +\frac{1}{4}\operatorname*{Tr}\left\{  \lambda
_{2}\right\}  \right\} \nonumber\\
\eta_{2j_{1}j_{2}}  &  =\left\{
\begin{array}
[c]{c}%
\frac{1}{2}\left(  \lambda_{1j_{1}j_{2}}-\lambda_{1j_{2}j_{1}}+L_{2}%
^{1}\left(  \lambda_{2}\right)  _{j_{1}j_{2}}-L_{2}^{1}\left(  \lambda
_{2}\right)  _{j_{2}j_{1}}\right)  ;1\leq j_{1}<j_{2}\leq r,r+1\leq
j_{1}<j_{2}\leq2r\\
\frac{i}{2}\left(  \lambda_{1j_{1}j_{2}-r}-\lambda_{1j_{2}-rj_{1}}+L_{2}%
^{1}\left(  \lambda_{2}\right)  _{j_{1}j_{2}-r}-L_{2}^{1}\left(  \lambda
_{2}\right)  _{j_{2}-rj_{1}}\right)  ;1\leq j_{1}\leq r,r+1\leq j_{2}\leq2r\\
\frac{-i}{2}\left(  \lambda_{1j_{1}-rj_{2}}-\lambda_{1j_{2}j_{1}-r}+L_{2}%
^{1}\left(  \lambda_{2}\right)  _{j_{1}-rj_{2}}-L_{2}^{1}\left(  \lambda
_{2}\right)  _{j_{2}j_{1}-r}\right)  ;1\leq j_{2}\leq r,r+1\leq j_{1}\leq2r
\end{array}
\right. \\
\eta_{4j_{1}j_{2}j_{3}j_{4}}  &  =\left\{  ?\right.
\end{align}
where the coefficients $\eta_{4j_{1}j_{2}j_{3}j_{4}}$ are antisymmetric and
given by
\begin{align*}
&  \frac{1}{16}\sum_{1\leq j_{1}\neq j_{2}\neq j_{3}\neq j_{4}\leq r}%
\lambda_{2j_{1}j_{2}j_{3}j_{4}}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}%
}\right. \\
&  -x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
+r}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}\\
&  -x_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
}x_{j_{3}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}+r}\\
&  +x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}}x_{j_{4}%
}x_{j_{3}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}+ix_{j_{1}}x_{j_{2}}%
x_{j_{4}}x_{j_{3}+r}\\
&  -\left.  ix_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}+ix_{j_{1}}x_{j_{2}%
+r}x_{j_{4}+r}x_{j_{3}+r}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}%
+r}+ix_{j_{1}+r}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}\right\}  .
\end{align*}
The variables $\left\{  d_{2j_{2}j_{1}}\right\}  $ and $\left\{
d_{4j_{1}j_{2}j_{3}j_{4}}\right\}  $ are determined by the extension to a
positive functional constraint
\begin{gather}
1\geq\alpha_{0}+\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}}%
d_{2j_{2}j_{1}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\alpha_{4j_{1}%
j_{2}j_{3}j_{4}}d_{4j_{1}j_{2}j_{3}j_{4}}\geq0\\
\forall\\
\alpha_{0}I_{\mathcal{F}}+i\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}%
}x_{j_{1}}x_{j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}\alpha
_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}\in
\emph{\mathfrak{P.}}%
\end{gather}


If the state $D$ is pure then
\begin{equation}
D=D^{2},
\end{equation}
while if it is mixed (ensemble) then
\begin{gather}
D\geq D^{2}\\
\Updownarrow\\
D=\sum_{1\leq j\leq q}\alpha_{j}D_{j},
\end{gather}
where $\left\{  D_{j}\right\}  $ are pure density operators i.e.
\begin{equation}
D_{j}=D_{j}^{2}%
\end{equation}
and
\begin{equation}
\sum_{1\leq j\leq q}\alpha_{j}=1;\qquad0\leq\alpha_{j}\leq1.
\end{equation}


Some properties%
\begin{equation}
D^{2}=\sum_{0\leq p,q\leq2r}\sum_{j=0}^{\min\left(  p,q\right)  }\left\langle
D_{p}D_{q}\right\rangle _{\left\vert p-q\right\vert +2j}=\sum_{0\leq n\leq
2r}\left\langle D^{2}\right\rangle _{n},
\end{equation}


In general
\begin{equation}
\left\langle D^{2}\right\rangle _{n}\neq\left\langle D\right\rangle _{n}.
\end{equation}


The condition for a state to be a pure state is
\begin{equation}
\sum_{0\leq p,q\leq2r}\sum_{j=0}^{\min\left(  p,q\right)  }\left\langle
D_{p}D_{q}\right\rangle _{\left\vert p-q\right\vert +2j}=\sum_{0\leq p\leq
2r}D_{p}.
\end{equation}
e.g. $r=3$ and
\begin{equation}
D=D_{0}+D_{2}+D_{4}+D_{6}%
\end{equation}
then
\begin{align}
&  \sum_{0\leq p,q\leq6}\sum_{j=0}^{\min\left(  p,q\right)  }\left\langle
D_{p}D_{q}\right\rangle _{\left\vert p-q\right\vert +2j}\nonumber\\
&  =\left\langle D_{0}D_{0}\right\rangle _{0}+\left\langle D_{2}%
D_{2}\right\rangle _{0}+\left\langle D_{2}D_{2}\right\rangle _{2}+\left\langle
D_{2}D_{2}\right\rangle _{4}+\left\langle D_{4}D_{4}\right\rangle
_{0}+\left\langle D_{4}D_{4}\right\rangle _{2}+\left\langle D_{4}%
D_{4}\right\rangle _{4}+\left\langle D_{4}D_{4}\right\rangle _{6}+\left\langle
D_{4}D_{4}\right\rangle _{8}\nonumber\\
&  +\left\langle D_{6}D_{6}\right\rangle _{0}+\left\langle D_{6}%
D_{6}\right\rangle _{2}+\left\langle D_{6}D_{6}\right\rangle _{4}+\left\langle
D_{6}D_{6}\right\rangle _{6}+\left\langle D_{6}D_{6}\right\rangle
_{8}+\left\langle D_{6}D_{6}\right\rangle _{10}+\left\langle D_{6}%
D_{6}\right\rangle _{12}\nonumber\\
&  +2\left\{
\begin{array}
[c]{c}%
\left\langle D_{0}D_{0}\right\rangle _{0}+\left\langle D_{0}D_{2}\right\rangle
_{0}+\left\langle D_{0}D_{2}\right\rangle _{2}+\left\langle D_{0}%
D_{4}\right\rangle _{0}+\left\langle D_{0}D_{4}\right\rangle _{2}+\left\langle
D_{0}D_{4}\right\rangle _{4}+\left\langle D_{0}D_{6}\right\rangle _{0}\\
+\left\langle D_{0}D_{6}\right\rangle _{2}+\left\langle D_{0}D_{6}%
\right\rangle _{4}+\left\langle D_{0}D_{6}\right\rangle _{6}%
\end{array}
\right. \nonumber\\
&  +\left\langle D_{2}D_{4}\right\rangle _{0}+\left\langle D_{2}%
D_{4}\right\rangle _{2}+\left\langle D_{2}D_{4}\right\rangle _{4}+\left\langle
D_{2}D_{4}\right\rangle _{6}+\left\langle D_{2}D_{6}\right\rangle
_{0}+\left\langle D_{2}D_{6}\right\rangle _{2}+\left\langle D_{2}%
D_{6}\right\rangle _{4}\nonumber\\
&  +\left\langle D_{2}D_{6}\right\rangle _{6}+\left\langle D_{2}%
D_{6}\right\rangle _{8}\\
&  +\left.  \left\langle D_{4}D_{6}\right\rangle _{0}+\left\langle D_{4}%
D_{6}\right\rangle _{2}+\left\langle D_{4}D_{6}\right\rangle _{4}+\left\langle
D_{4}D_{6}\right\rangle _{6}+\left\langle D_{4}D_{6}\right\rangle
_{8}+\left\langle D_{4}D_{6}\right\rangle _{10}\right\}
\end{align}
then
\begin{align}
D_{0}  &  =\left\langle D_{0}D_{0}\right\rangle _{0}+\left\langle D_{2}%
D_{2}\right\rangle _{0}+\left\langle D_{4}D_{4}\right\rangle _{0}+\left\langle
D_{6}D_{6}\right\rangle _{0}+2\left\{
\begin{array}
[c]{c}%
\left\langle D_{0}D_{2}\right\rangle _{0}+\left\langle D_{0}D_{4}\right\rangle
_{0}+\left\langle D_{0}D_{6}\right\rangle _{0}\\
+\left\langle D_{2}D_{4}\right\rangle _{0}+\left\langle D_{2}D_{6}%
\right\rangle _{0}+\left\langle D_{4}D_{6}\right\rangle _{0}%
\end{array}
\right\} \nonumber\\
D_{2}  &  =\left\langle D_{2}D_{2}\right\rangle _{2}+\left\langle D_{4}%
D_{4}\right\rangle _{2}+\left\langle D_{6}D_{2}\right\rangle _{4}+2\left\{
\begin{array}
[c]{c}%
\left\langle D_{0}D_{2}\right\rangle _{2}+\left\langle D_{0}D_{4}\right\rangle
_{2}+\left\langle D_{0}D_{6}\right\rangle _{2}+\left\langle D_{2}%
D_{4}\right\rangle _{2}\\
+\left\langle D_{2}D_{6}\right\rangle _{2}+\left\langle D_{4}D_{6}%
\right\rangle _{2}%
\end{array}
\right\} \nonumber\\
D_{4}  &  =\left\langle D_{2}D_{2}\right\rangle _{4}+\left\langle D_{4}%
D_{4}\right\rangle _{4}+\left\langle D_{6}D_{6}\right\rangle _{4}+2\left\{
\begin{array}
[c]{c}%
\left\langle D_{0}D_{4}\right\rangle _{4}+\left\langle D_{0}D_{6}\right\rangle
_{4}+\left\langle D_{2}D_{4}\right\rangle _{4}\\
+\left\langle D_{2}D_{6}\right\rangle _{4}+\left\langle D_{4}D_{6}%
\right\rangle _{4}%
\end{array}
\right\} \nonumber\\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{6}+\left\langle D_{6}%
D_{6}\right\rangle _{6}+\left\langle D_{0}D_{6}\right\rangle _{6}+\left\langle
D_{2}D_{4}\right\rangle _{6}+\left\langle D_{2}D_{6}\right\rangle
_{6}+\left\langle D_{4}D_{6}\right\rangle _{6}\nonumber\\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{8}+\left\langle D_{6}%
D_{6}\right\rangle _{8}+\left\langle D_{2}D_{6}\right\rangle _{8}+\left\langle
D_{4}D_{6}\right\rangle _{8}\nonumber\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{10}+\left\langle D_{4}%
D_{6}\right\rangle _{10}\nonumber\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{12}.
\end{align}
Noting that
\begin{equation}
D_{0}=I_{\mathcal{F}}%
\end{equation}
one obtains that (noting $\left\langle A_{j}B_{k}\right\rangle _{0}=\left(
\left.  A_{j}\right\vert B_{k}\right)  =\left\langle A_{j}B_{k}\right\rangle
_{0}\delta_{jk})$
\begin{align}
0  &  =\left\langle D_{2}D_{2}\right\rangle _{0}+\left\langle D_{4}%
D_{4}\right\rangle _{0}+\left\langle D_{6}D_{6}\right\rangle _{0}\\
D_{2}  &  =-\left\{  \left\langle D_{2}D_{2}\right\rangle _{2}+\left\langle
D_{4}D_{4}\right\rangle _{2}+\left\langle D_{6}D_{2}\right\rangle
_{4}+2\left\{  \left\langle D_{2}D_{4}\right\rangle _{2}+\left\langle
D_{2}D_{6}\right\rangle _{2}+\left\langle D_{4}D_{6}\right\rangle
_{2}\right\}  \right\} \\
D_{4}  &  =-\left\{  \left\langle D_{2}D_{2}\right\rangle _{4}+\left\langle
D_{4}D_{4}\right\rangle _{4}+\left\langle D_{6}D_{6}\right\rangle
_{4}+2\left\{  \left\langle D_{2}D_{4}\right\rangle _{4}+\left\langle
D_{2}D_{6}\right\rangle _{4}+\left\langle D_{4}D_{6}\right\rangle
_{4}\right\}  \right\} \\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{6}+\left\langle D_{6}%
D_{6}\right\rangle _{6}+\left\langle D_{6}\right\rangle _{6}+\left\langle
D_{2}D_{4}\right\rangle _{6}+\left\langle D_{2}D_{6}\right\rangle
_{6}+\left\langle D_{4}D_{6}\right\rangle _{6}\\
0  &  =\left\langle D_{4}D_{4}\right\rangle _{8}+\left\langle D_{6}%
D_{6}\right\rangle _{8}+\left\langle D_{2}D_{6}\right\rangle _{8}+\left\langle
D_{4}D_{6}\right\rangle _{8}\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{10}+\left\langle D_{4}%
D_{6}\right\rangle _{10}\\
0  &  =\left\langle D_{6}D_{6}\right\rangle _{12}.
\end{align}


The norms are given by%
\begin{align}
\left\vert D\right\vert ^{2}  &  =\left\langle DD\right\rangle _{0}%
=\left\langle D^{2}\right\rangle _{0}=\sum_{0\leq p\leq2r}D_{p}\ast D_{p}%
=\sum_{0\leq p\leq2r}\left\langle D_{p}^{2}\right\rangle =\sum_{0\leq p\leq
2r}\left\vert D_{p}\right\vert ^{2}\\
\left\vert D^{2}\right\vert ^{2}  &  =\left\langle D^{2}D^{2}\right\rangle
_{0}=\left\langle D^{4}\right\rangle _{0}=\sum_{0\leq p\leq2r}D_{p}^{2}\ast
D_{p}^{2}=\sum_{0\leq p\leq2r}\left\langle D_{p}^{4}\right\rangle _{0}%
=\sum_{0\leq p\leq2r}\left\vert D_{p}^{2}\right\vert ^{2}.
\end{align}


\subsubsection{The Number Operator}

If a state describes on the average $N$ particles then%
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  =\operatorname*{tr}\left\{  \left\langle
\mathcal{N}_{a0}D_{0}\right\rangle _{0}\right\}  +\operatorname*{tr}\left\{
\left\langle \mathcal{N}_{a2}D_{2}\right\rangle _{0}\right\}  =N_{a},
\end{equation}
where the number operator $\mathcal{N}$ is
\begin{equation}
\mathcal{N}_{a}=\sum_{1\leq j\leq r}n_{j}=\mathcal{N}_{a0}+\mathcal{N}%
_{a2}=\mathcal{N}_{a}=\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}%
x_{j}x_{j+r}.
\end{equation}
If it describes $N$ particles then
\begin{gather}
\left[  \mathcal{N}_{a},D\right]  =0\,\&\,\operatorname*{tr}\left\{
\left\langle \mathcal{N}_{a}D\right\rangle _{0}\right\}  =N_{a}\nonumber\\
\Updownarrow\nonumber\\
\operatorname*{tr}\left\{  \left\langle \mathcal{N}_{a}^{2}D\right\rangle
_{0}\right\}  -\left(  \operatorname*{tr}\left\{  \left\langle \mathcal{N}%
_{a}D\right\rangle _{0}\right\}  \right)  ^{2}=0,
\end{gather}
i.e.
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  ^{2}-f_{D}\left(  \mathcal{N}_{a}%
^{2}\right)  =0.
\end{equation}


The number operator expressed in the $\left\{  x_{j}\right\}  $ bases involves
$r$, which is infinity when $r=\infty,$ however the back transformation works
as one gets $\infty-\infty$ in the form of $r-r$ as can be seen from%
\begin{align}
\mathcal{N}_{x}  &  =\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\frac
{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  \frac{i}{\sqrt{2}}\left(
a_{j}^{\dagger}-a_{j}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\frac{i}{2}\left(
-a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}-\frac{1}{2}\sum_{1\leq j\leq r}\left(
-a_{j}^{\dagger}a_{j}+I_{\mathcal{F}}-a_{j}^{\dagger}a_{j}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}-\sum_{1\leq j\leq r}\left(  \frac{1}%
{2}I_{\mathcal{F}}-a_{j}^{\dagger}a_{j}\right) \nonumber\\
&  =\frac{r}{2}I_{\mathcal{F}}-\frac{r}{2}I_{\mathcal{F}}+\sum_{1\leq j\leq
r}a_{j}^{\dagger}a_{j}\nonumber\\
&  =\mathcal{N}_{a}.
\end{align}


The square of the number operator is given by
\begin{align}
\mathcal{N}_{a}^{2}  &  =\sum_{1\leq j,k\leq r}n_{j}n_{k}=\sum_{1\leq j\leq
r}n_{j}+2\sum_{1\leq j<k\leq r}n_{j}n_{k}=\sum_{1\leq j\leq r}n_{j}%
+2\sum_{1\leq j<k\leq r}a_{j}^{\dagger}a_{j}a_{k}^{\dagger}a_{k}\\
&  =\sum_{1\leq j\leq r}n_{j}+2\sum_{1\leq j<k\leq r}a_{j}^{\dagger}%
a_{k}^{\dagger}a_{k}a_{j}=\sum_{1\leq j\leq r}n_{j}+2\sum_{1\leq j<k\leq
r}n_{jk}=\mathcal{N}_{a}+2\mathcal{N}_{a2},
\end{align}
which gives in the Clifford basis
\begin{align}
\mathcal{N}_{x}^{2}  &  =\left(  \frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq
r}x_{j}x_{j+r}\right)  \left(  \frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq k\leq
r}x_{k}x_{k+r}\right) \nonumber\\
&  =\frac{r^{2}}{4}I_{\mathcal{F}}+i\frac{r}{2}\sum_{1\leq j\leq r}%
x_{j}x_{j+r}+\sum_{1\leq j,k\leq r}x_{j}x_{k}x_{j+r}x_{k+r}\nonumber\\
&  =\left(  \frac{r^{2}}{4}+\frac{r}{4}\right)  I_{\mathcal{F}}+i\frac{r}%
{2}\sum_{1\leq j\leq r}x_{j}x_{j+r}+2\sum_{1\leq j<k\leq r}x_{j}x_{k}%
x_{j+r}x_{k+r}\nonumber\\
&  =\frac{r\left(  r+1\right)  }{4}I_{\mathcal{F}}+i\frac{r}{2}\sum_{1\leq
j\leq r}x_{j}x_{j+r}+2\sum_{1\leq j<k\leq r}x_{j}x_{k}x_{j+r}x_{k+r}.
\end{align}


Thus a state describes a fixed number of particles iff
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  ^{2}-f_{D}\left(  \mathcal{N}_{a}%
^{2}\right)  =f_{D}\left(  \mathcal{N}_{a}\right)  ^{2}-f_{D}\left(
\mathcal{N}_{a}\right)  -2f_{D}\left(  \mathcal{N}_{a2}\right)  =f_{D}\left(
\mathcal{N}_{a}\right)  \left(  f_{D}\left(  \mathcal{N}_{a}\right)
-1\right)  -2f_{D}\left(  \mathcal{N}_{a2}\right)  =0,
\end{equation}
i.e.
\begin{equation}
f_{D}\left(  \mathcal{N}_{a}\right)  \left(  f_{D}\left(  \mathcal{N}%
_{a}\right)  -1\right)  =2f_{D}\left(  \mathcal{N}_{a2}\right)  .
\end{equation}


The pair operator $\mathcal{N}_{a2}$ can be expanded as
\begin{align}
\mathcal{N}_{a2}  &  =\sum_{1\leq j<k\leq r}n_{j}n_{k}=\sum_{1\leq j<k\leq
r}\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{k}x_{k+r}\right) \\
&  =\frac{1}{4}\binom{r}{2}I_{\mathcal{F}}+2i\sum_{1\leq j\leq r}x_{j}%
x_{j+r}-\sum_{1\leq j<k\leq r}x_{j}x_{j+r}x_{k}x_{k+r}=\left\langle
\mathcal{N}_{x2}\right\rangle _{0}+\left\langle \mathcal{N}_{x2}\right\rangle
_{2}+\left\langle \mathcal{N}_{x2}\right\rangle _{4}.
\end{align}


\paragraph{Majorana Number Operator}

One can define the following function of the number operator, which we call
the \emph{Majorana Number Operator}, \emph{ }
\begin{equation}
\mathcal{N}_{xM}=i\sum_{1\leq j\leq r}x_{j}x_{j+r},
\end{equation}
and has the following properties
\begin{equation}
\left[  A,\mathcal{N}_{xM}\right]  =0\Longleftrightarrow\left[  A,\mathcal{N}%
_{x}\right]  =0
\end{equation}
and
\begin{equation}
f\left(  \mathcal{N}_{xM}^{2}\right)  =f\left(  \mathcal{N}_{xM}\right)
^{2}\Longleftrightarrow f\left(  \mathcal{N}_{x}^{2}\right)  =f\left(
\mathcal{N}_{x}\right)  ^{2}\,\forall f\in\mathcal{S}\left(  \mathcal{F}%
\right)  .
\end{equation}%
\begin{align}
\mathcal{N}_{xM}  &  =i\sum_{1\leq j\leq r}\frac{1}{\sqrt{2}}\left(
a_{j}^{\dagger}+a_{j}\right)  \frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}%
-a_{j}\right)  =i\sum_{1\leq j\leq r}\frac{i}{2}\left(  a_{j}a_{j}^{\dagger
}-a_{j}^{\dagger}a_{j}\right) \nonumber\\
&  =-\frac{1}{2}\sum_{1\leq j\leq r}\left(  -a_{j}^{\dagger}a_{j}%
+I_{\mathcal{F}}-a_{j}^{\dagger}a_{j}\right)  =\sum_{1\leq j\leq r}\left(
a_{j}^{\dagger}a_{j}-\frac{1}{2}I_{\mathcal{F}}\right)  =\sum_{1\leq j\leq
r}\left(  n_{j}-\frac{1}{2}I_{\mathcal{F}}\right)  .
\end{align}
$\lceil$%
\begin{align}
\widehat{\mathcal{N}}_{xM}\left(  x_{k}\right)   &  =\left[  i\sum_{1\leq
j\leq r}x_{j}x_{j+r},x_{k}\right]  =-ix_{k+r}\\
\widehat{\mathcal{N}}_{xM}\left(  x_{k+r}\right)   &  =\left[  i\sum_{1\leq
j\leq r}x_{j}x_{j+r},x_{k+r}\right]  =ix_{k}%
\end{align}%
\begin{align}
\widehat{\mathcal{N}}_{xM}\left(  \widehat{\mathcal{N}}_{xM}\left(
x_{k}\right)  \right)   &  =\widehat{\mathcal{N}}_{xM}\left(  \left[
i\sum_{1\leq j\leq r}x_{j}x_{j+r},x_{k}\right]  \right)
=-i\widehat{\mathcal{N}}_{xM}\left(  x_{k+r}\right)  =-iix_{k}=x_{k}\\
\widehat{\mathcal{N}}_{xM}\left(  \widehat{\mathcal{N}}_{xM}\left(
x_{k+r}\right)  \right)   &  =\widehat{\mathcal{N}}_{xM}\left(  \left[
i\sum_{1\leq j\leq r}x_{j}x_{j+r},x_{k+r}\right]  \right)
=i\widehat{\mathcal{N}}_{xM}\left(  x_{k}\right)  =-iix_{k+r}=x_{k+r}%
\end{align}
Thus
\begin{equation}
\left.  -i\widehat{\mathcal{N}}_{xM}^{2}\right\vert _{\mathcal{F}_{1}%
}=-I_{\mathcal{F}_{1}}.
\end{equation}
$\rfloor$

The difference of two expansions of a number operator
\begin{equation}
\mathcal{N}_{a}-\mathcal{N}_{b}=\frac{r}{2}I_{\mathcal{F}}+i\sum_{1\leq j\leq
r}x_{j}x_{j+r}-\frac{r}{2}I_{\mathcal{F}}-i\sum_{1\leq j\leq r}y_{j}%
y_{j+r}=i\sum_{1\leq j\leq r}\left(  x_{j}x_{j+r}-y_{j}y_{j+r}\right)
=\mathcal{N}_{xM}-\mathcal{N}_{yM}.
\end{equation}


\section{Clifford Valued Functions}

Nonlinear functions can be defined on the Clifford algebra
\begin{equation}
f:\mathcal{F}\longrightarrow\mathcal{F}%
\end{equation}
e.g. the exponential function
\begin{equation}
\exp\left\{  A\right\}  =\sum_{0\leq n\leq\infty}\frac{1}{n!}A^{n}.
\end{equation}
In the special case when $A$ is a multivector i.e.
\begin{equation}
A=\left\langle A\right\rangle _{n}%
\end{equation}
one can deduce that
\begin{equation}
\exp\left\{  i\alpha\hat{A}\right\}  =\cos\left(  \alpha\right)  I+\hat{A}%
\sin\left(  \alpha\right)  ,
\end{equation}
where
\begin{align}
\alpha &  =\left\Vert A\right\Vert =\left\langle \left\langle A^{\dagger
}A\right\rangle \right\rangle _{0}^{\frac{1}{2}}\\
\hat{A}  &  =\frac{A}{\left\Vert A\right\Vert }\\
\alpha &  \in\mathbb{R}.
\end{align}


\section{Groups}

The commutator defines the \emph{Commutator Product}
\begin{equation}
A\times B=\frac{1}{2}\left[  A,B\right]  \,\forall A,B\in\mathcal{F}.
\end{equation}


\emph{Grade Involution} is defined as
\begin{equation}
\widehat{A_{k}}=\left(  -1\right)  ^{k}A_{k}.
\end{equation}


The \emph{Clifford }group action is defined by \emph{twisted} inner
automorphisms as
\begin{align}
\vartheta\left[  A\right]   &  :\mathcal{F\longrightarrow F}\\
\vartheta\left[  A\right]  \left(  B\right)   &  =\widehat{A}BA^{-1}%
\end{align}
and the \emph{Clifford }group $\mathcal{CG}\left(  \mathcal{F}\right)  $ by
\begin{equation}
\left\{  \left.  A\in\mathcal{F}\right\vert \vartheta\left[  A\right]
:\mathcal{F}_{1}\mathcal{\longrightarrow F}_{1}\right\}  .
\end{equation}
$g\in\mathcal{CG}\left(  \mathcal{F}\right)  $ Iff it is can be represented as
a versor i.e.
\begin{equation}
g=v_{1}\cdots v_{k},v_{j}\in\mathcal{F}_{1}.
\end{equation}
The following important subgroups of the Clifford group are

\subparagraph{Pin}%

\begin{equation}
\operatorname*{Pin}\left(  \mathcal{F}\right)  =\left\{  \left.
A\in\mathcal{CG}\left(  \mathcal{F}\right)  \right\vert \left\Vert
A\right\Vert =1\right\}
\end{equation}


If $g\in\operatorname*{Pin}\left(  \mathcal{F}\right)  $ then it can be
represented as a versor i.e.
\begin{equation}
g=v_{1}\cdots v_{k},v_{j}\in\mathcal{F}_{1}.
\end{equation}


\subparagraph{Spin}%

\begin{equation}
\operatorname*{Spin}\left(  \mathcal{F}\right)  =\left\{  \left.
A\in\operatorname*{Pin}\left(  \mathcal{F}\right)  \right\vert A\in
\mathcal{F}_{even}\right\}
\end{equation}


The Pin group is the double cover of $O(2r,\mathbb{R}),$ while the Spin group
is the double cover of $SO(2r,\mathbb{R}).$

\section{Idempotents}

If an idempotent $p$ is self adjoint
\begin{equation}
p=p^{\dagger}%
\end{equation}
it is positive as
\begin{equation}
p=p^{2}=p^{\dagger}p.
\end{equation}


It is possible to have non self adjoint idempotents (theses are associated
with non orthogonal projectors and nonorthogonal subspace decompositions),
which are non positive.

\subsection{Primitive Idempotents}

An idempotent $p$ is primitive if
\begin{equation}
p\neq\sum_{1\leq j\leq q}\eta_{j},q>1,
\end{equation}
where
\begin{equation}
\eta_{j}\eta_{k}=\eta_{j}\delta_{jk};1\leq j\leq q.
\end{equation}


A primitive idempotent could be of any order i.e.
\begin{equation}
p=\sum_{0\leq j\leq2^{2r}}\left\langle p\right\rangle _{j}=\sum_{0\leq
j\leq2^{2r}}p_{j},
\end{equation}
where $p_{j}=\left\langle p\right\rangle _{j}$ and is not in general
idempotent. The scalar part can be expressed as
\begin{equation}
p\ast I_{\mathcal{F}}=p_{0}=\operatorname*{tr}\left\{  p^{\dagger
}I_{\mathcal{F}}\right\}  I_{\mathcal{F}}.
\end{equation}
As $p=p^{2}$ one has in particular that
\begin{align}
p_{0}  &  =\left\langle p^{2}\right\rangle _{0}=\left\langle p^{\dagger
}p\right\rangle _{0}\geq0=\sum_{0\leq j\leq2^{2r}}\left\langle p_{j}^{\dagger
}p_{j}\right\rangle _{0}=p_{0}^{2}+\sum_{1\leq j\leq2^{2r}}\left\langle
p_{j}^{\dagger}p_{j}\right\rangle _{0}\\
p_{0}-p_{0}^{2}  &  =p_{0}\left(  I_{\mathcal{F}}-p_{0}\right)  =\sum_{1\leq
j\leq2^{2r}}\left\langle p_{j}^{\dagger}p_{j}\right\rangle _{0}\geq0,
\end{align}
so
\begin{equation}
0\leq p_{0}=\operatorname*{tr}\left\{  p_{0}I_{\mathcal{F}}\right\}
I_{\mathcal{F}}\leq I_{\mathcal{F}}\Longleftrightarrow0\leq\operatorname*{tr}%
\left\{  p_{0}I_{\mathcal{F}}\right\}  \leq1.
\end{equation}


\subsection{Non Primitive Idempotents}

\subsubsection{Simple Idempotents}

\paragraph{ Order 1 (Elementary)}%

\begin{align}
n_{j}  &  =a_{j}^{\dagger}a_{j}=\sum_{\substack{1\leq p\leq r\\1\leq
j_{2}<\cdots<j_{p}\leq r}}\left\vert \varphi_{j}\varphi_{j_{2}}\cdots
\varphi_{j_{p}}\right\rangle \left\langle \varphi_{j}\varphi_{j_{2}}%
\cdots\varphi_{j_{p}}\right\vert =\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\\
h_{j}  &  =a_{j}a_{j}^{\dagger}=\frac{1}{2}I_{\mathcal{F}}-n_{j}=\frac{1}%
{2}\sum_{\substack{0\leq p\leq r\\1\leq j_{1}<\cdots<j_{p}\leq r}}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\vert -\sum
_{\substack{1\leq p\leq r\\1\leq j_{2}<\cdots<j_{p}\leq r}}\left\vert
\varphi_{j}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\vert \\
&  =\frac{1}{2}I_{\mathcal{F}}-ix_{j}x_{j+r}.
\end{align}
$\lceil$Note that
\begin{align}
\operatorname{Tr}\left\{  n_{j}\right\}   &  =\binom{r-1}{0}+\binom{r-1}%
{1}+\cdots+\binom{r-1}{r-1}=2^{r-1}\\
\operatorname*{tr}\left\{  n_{j}\right\}   &  =\frac{2^{r-1}}{2^{r}}=\frac
{1}{2}%
\end{align}
$\rfloor$

\paragraph{Order 2 (Non-Elementary)}%

\begin{align}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}  &  =a_{j}^{\dagger}a_{j}%
a_{k}^{\dagger}a_{k}=n_{j}n_{k}=\sum_{3\leq p\leq r}\left\vert \varphi
_{j}\varphi_{k}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j}\varphi_{k}\varphi_{j_{2}}\cdots\varphi_{j_{p}}\right\vert \\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)  \left(  \frac
{1}{2}I_{\mathcal{F}}+ix_{k}x_{k+r}\right) \\
n_{j}h_{k}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{k}x_{k+r}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+i\left(  x_{j}x_{j+r}-x_{k}x_{k+r}\right)  +x_{j}%
x_{j+r}x_{k}x_{k+r}\\
h_{j}h_{k}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{j}x_{j+r}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{k}x_{k+r}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+i\left(  x_{k}x_{k+r}-x_{j}x_{j+r}\right)  +x_{k}%
x_{k+r}x_{j}x_{j+r}%
\end{align}
In terms of FQ
\begin{align}
n_{j}n_{k}=  &  a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}=\Gamma\left(
\left\vert \varphi_{j}\varphi_{k}\right\rangle \left\langle \varphi_{j}%
\varphi_{k}\right\vert \right) \nonumber\\
&  =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}\left\vert
\varphi_{j}\varphi_{k}\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\rangle
\left\langle \varphi_{j}\varphi_{k}\varphi_{j_{1}}\cdots\varphi_{j_{N}%
}\right\vert =\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq
r}P_{jkj_{1}\cdots j_{N}},
\end{align}
where
\begin{equation}
P_{jkj_{1}\cdots j_{N}};0\leq N\leq r,1\leq j_{1}<\cdots<j_{N}\leq r,0\leq
j<k\leq r
\end{equation}
are primitive idempotents.

$\lceil$Note that
\begin{equation}
\Gamma\left(  P_{j_{1}\cdots j_{N}}\right)  ^{2}=\Gamma\left(  P_{j_{1}\cdots
j_{N}}\right)  \Gamma\left(  P_{j_{1}\cdots j_{N}}\right)  =\Gamma\left(
P_{j_{1}\cdots j_{N}}\right)  =\Gamma\left(  P_{j_{1}\cdots j_{N}}^{2}\right)
=\Gamma\left(  P_{j_{1}\cdots j_{N}}P_{j_{1}\cdots j_{N}}\right)
\end{equation}
while
\begin{equation}
\Gamma\left(  P_{j_{1}\cdots j_{N}}\right)  \Gamma\left(  P_{k_{1}\cdots
k_{N}}\right)  \neq\Gamma\left(  P_{j_{1}\cdots j_{N}}P_{k_{1}\cdots k_{N}%
}\right)  ;\left(  j_{1}\cdots j_{N}\right)  \neq\left(  k_{1}\cdots
k_{N}\right)  .
\end{equation}


E.g.
\begin{align}
\Gamma\left(  P_{1}\right)  ^{2}  &  =\Gamma\left(  P_{1}\right)
=\Gamma\left(  P_{1}^{2}\right) \\
\Gamma\left(  P_{2}\right)  ^{2}  &  =\Gamma\left(  P_{2}\right)
=\Gamma\left(  P_{2}^{2}\right)  ,
\end{align}
while
\begin{align}
\Gamma\left(  P_{1}\right)  \Gamma\left(  P_{2}\right)   &  =n_{1}n_{2}%
=\Gamma\left(  P_{12}\right)  \neq0\\
\Gamma\left(  P_{1}P_{2}\right)   &  =0=\Gamma\left(  0\right)  .
\end{align}


$\rfloor.$

In general simple (Non-Elementary) non primitive idempotents are products of
simple idempotents e.g. an idempotent of order $n+m$ is given by
\begin{equation}
p_{n,m}=%
%TCIMACRO{\dprod \limits_{l=1,\cdots,m}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,\cdots,m}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=m+1,\cdots,n}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=m+1,\cdots,n}}
%EndExpansion
h_{i}=%
%TCIMACRO{\dprod \limits_{l=1,\cdots,m}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,\cdots,m}}
%EndExpansion
\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{l}x_{l+r}\right)
%TCIMACRO{\dprod \limits_{l=m+1,\cdots,n}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=m+1,\cdots,n}}
%EndExpansion
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{l}x_{l+r}\right)
\end{equation}
so that e.g.
\begin{align}
p_{2,0}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{1+r}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{2+r}\right)  =\frac{1}{4}I_{\mathcal{F}%
}+ix_{1}x_{1+r}+ix_{2}x_{2+r}+x_{1}x_{2}x_{1+r}x_{2+r}\\
p_{1,1}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{1+r}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{2+r}\right)  =\frac{1}{4}I_{\mathcal{F}%
}+ix_{1}x_{1+r}-ix_{2}x_{2+r}-x_{1}x_{2}x_{1+r}x_{2+r}\\
p_{0,2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{1+r}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{2+r}\right)  =\frac{1}{4}I_{\mathcal{F}%
}-ix_{1}x_{1+r}-ix_{2}x_{2+r}+x_{1}x_{2}x_{1+r}x_{2+r}.
\end{align}


One can also see (below) that Primitive idempotents are also products of
Elementary idempotents.

\subsubsection{Non Simple Idempotents}

One can postulate that one can construct non-simple, (non-primitive?)
idempotents by considering
\begin{equation}
g^{\dagger}g=\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r}}g_{jk}\bar
{g}_{lm}a_{j}^{\dagger}a_{k}^{\dagger}a_{m}a_{l}=\sum_{\substack{1\leq j<k\leq
r\\1\leq l<m\leq r}}\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq
r}g_{jk}\bar{g}_{lm}\left\vert \varphi_{j}\varphi_{k}\varphi_{j_{1}}%
\cdots\varphi_{j_{N}}\right\rangle \left\langle \varphi_{l}\varphi_{m}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}\right\vert ,
\end{equation}
where
\begin{equation}
\left\langle \left.  g\right\vert g\right\rangle =\mathbf{g}^{\dagger
}\mathbf{g}=1.
\end{equation}
$\lceil$%
\begin{align}
\left(  g^{\dagger}g\right)  ^{2}  &  =\sum_{\substack{1\leq j<k\leq r\\1\leq
l<m\leq r\\1\leq j^{\prime}<k^{\prime}\leq r\\1\leq l^{\prime}<m^{\prime}\leq
r}}\sum_{\substack{0\leq N\leq r\\0\leq N^{\prime}\leq r}}\sum
_{\substack{1\leq j_{1}<\cdots<j_{N}\leq r\\1\leq j_{1}^{\prime}<\cdots
<j_{N}^{\prime}\leq r}}g_{jk}\bar{g}_{lm}g_{j^{\prime}k^{\prime}}\bar
{g}_{l^{\prime}m^{\prime}}\left\vert \overset{}{\varphi_{j}\varphi_{k}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}}\right\rangle \left\langle
\overset{}{\varphi_{l}\varphi_{m}\varphi_{j_{1}}\cdots\varphi_{j_{N}}%
}\right\vert \left\vert \overset{}{\varphi_{j^{\prime}}\varphi_{k^{\prime}%
}\varphi_{j_{1}^{\prime}}\cdots\varphi_{j_{N^{\prime}}^{\prime}}}\right\rangle
\left\langle \overset{}{\varphi_{l^{\prime}}\varphi_{m^{\prime}}\varphi
_{j_{1}^{\prime}}\cdots\varphi_{j_{N^{\prime}}^{\prime}}}\right\vert \\
&  =\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r\\1\leq j^{\prime
}<k^{\prime}\leq r\\1\leq l^{\prime}<m^{\prime}\leq r}}\sum_{\substack{0\leq
N\leq r\\0\leq N^{\prime}\leq r}}\sum_{\substack{1\leq j_{1}<\cdots<j_{N}\leq
r\\1\leq j_{1}^{\prime}<\cdots<j_{N}^{\prime}\leq r}}g_{jk}\bar{g}%
_{lm}g_{j^{\prime}k^{\prime}}\bar{g}_{l^{\prime}m^{\prime}}\left\vert
\overset{}{\varphi_{j}\varphi_{k}\varphi_{j_{1}}\cdots\varphi_{j_{N}}%
}\right\rangle \delta_{lmj_{1}\cdots j_{N}j^{\prime};j^{\prime}k^{\prime}%
j_{1}^{\prime}\cdots j_{N}^{\prime}}\left\langle \overset{}{\varphi
_{l^{\prime}}\varphi_{m^{\prime}}\varphi_{j_{1}^{\prime}}\cdots\varphi
_{j_{N}^{\prime}}}\right\vert \\
&  =\sum_{\substack{1\leq j<k\leq r\\1\leq l<m\leq r\\1\leq l^{\prime
}<m^{\prime}\leq r}}\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq
r}g_{jk}\bar{g}_{lm}g_{lm}\bar{g}_{l^{\prime}m^{\prime}}\left\vert
\overset{}{\varphi_{j}\varphi_{k}\varphi_{j_{1}}\cdots\varphi_{j_{N}}%
}\right\rangle \left\langle \overset{}{\varphi_{l^{\prime}}\varphi_{m^{\prime
}}\varphi_{j_{1}}\cdots\varphi_{j_{N}}}\right\vert \\
&  =\sum_{\substack{1\leq j<k\leq r\\1\leq l^{\prime}<m^{\prime}\leq r}%
}\sum_{0\leq N\leq r}\sum_{1\leq j_{1}<\cdots<j_{N}\leq r}g_{jk}\bar
{g}_{l^{\prime}m^{\prime}}\left\vert \overset{}{\varphi_{j}\varphi_{k}%
\varphi_{j_{1}}\cdots\varphi_{j_{N}}}\right\rangle \left\langle
\overset{}{\varphi_{l^{\prime}}\varphi_{m^{\prime}}\varphi_{j_{1}}%
\cdots\varphi_{j_{N}}}\right\vert =g^{\dagger}g
\end{align}
However \emph{the preceding calculation is incorrect as }%
\begin{equation}
g^{\dagger}gg^{\dagger}g=\sum_{1\leq j,k,l,m\leq r}c_{j}c_{k}c_{l}c_{m}%
a_{j}^{\dagger}a_{j+s}^{\dagger}a_{k+s}a_{k}a_{l}^{\dagger}a_{l+s}^{\dagger
}a_{m+s}a_{m}%
\end{equation}
noting that%
\begin{align}
a_{k+s}a_{k}a_{l}^{\dagger}a_{l+s}^{\dagger}  &  =a_{k+s}\left(  \delta
_{kl}-a_{l}^{\dagger}a_{k}\right)  a_{l+s}^{\dagger}=a_{k+s}a_{l+s}^{\dagger
}\delta_{kl}-a_{k+s}a_{l}^{\dagger}a_{k}a_{l+s}^{\dagger}=\left(
1-a_{l+s}^{\dagger}a_{k+s}\right)  \delta_{kl}-a_{l}^{\dagger}a_{k+s}%
a_{l+s}^{\dagger}a_{k}\\
&  =\left(  1-a_{l+s}^{\dagger}a_{k+s}\right)  \delta_{kl}-a_{l}^{\dagger
}\left(  \delta_{kl}-a_{l+s}^{\dagger}a_{k+s}\right)  a_{k}=\delta
_{kl}-a_{l+s}^{\dagger}a_{k+s}\delta_{kl}-a_{l}^{\dagger}a_{k}\delta
_{kl}+a_{l}^{\dagger}a_{l+s}^{\dagger}a_{k+s}a_{k}%
\end{align}
we obtain%
\begin{align}
g^{\dagger}gg^{\dagger}g  &  =\sum_{1\leq j,k,l,m\leq r}c_{j}c_{k}c_{l}%
c_{m}a_{j}^{\dagger}a_{j+s}^{\dagger}\left(  \delta_{kl}-a_{l+s}^{\dagger
}a_{k+s}\delta_{kl}-a_{l}^{\dagger}a_{k}\delta_{kl}+a_{l}^{\dagger}%
a_{l+s}^{\dagger}a_{k+s}a_{k}\right)  a_{m+s}a_{m}\\
&  =\sum_{1\leq j,m\leq r}c_{j}c_{m}a_{j}^{\dagger}a_{j+s}^{\dagger}%
a_{m+s}a_{m}-\sum_{1\leq j,l,m\leq r}c_{j}c_{l}^{2}c_{m}a_{j}^{\dagger}%
a_{j+s}^{\dagger}a_{l+s}^{\dagger}a_{l+s}a_{m+s}a_{m}\\
&  -\sum_{1\leq j,l,m\leq r}c_{j}c_{l}^{2}c_{m}a_{j}^{\dagger}a_{j+s}%
^{\dagger}a_{l}^{\dagger}a_{l}a_{m+s}a_{m}+\sum_{1\leq j,k,l,m\leq r}%
c_{j}c_{k}c_{l}c_{m}a_{j}^{\dagger}a_{j+s}^{\dagger}a_{l}^{\dagger}%
a_{l+s}^{\dagger}a_{k+s}a_{k}a_{m+s}a_{m}\\
&  \neq g^{\dagger}g.
\end{align}
$\rfloor$

\subsubsection{Construction of Idempotents}

Let $\left\{  \left.  y_{j}\right\vert 1\leq j\leq2r\right\}  $ be an
orthonormal basis of $\mathcal{F}_{1}$ that generates the basis $\left\{
I_{\mathcal{F}},\left\{  \left.  y_{j_{1}}\cdots y_{j_{p}}\right\vert 1\leq
j_{1}<\cdots<j_{p}\leq2r;1\leq p\leq2r\right\}  \right\}  $ of $\mathcal{F}.$
Let
\begin{align}
p_{+j_{1}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right) \\
p_{-j_{1}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)
\end{align}
then%
\begin{align}
&  p_{+j_{1}}^{2}=\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}+2y_{j_{1}}+y_{j_{1}}^{2}\right)  =\frac{1}{4}\left(
2I_{\mathcal{F}}+2y_{j_{1}}\right)  =\frac{1}{2}\left(  I_{\mathcal{F}%
}+y_{j_{1}}\right)  =p_{+j_{1}}\\
&  p_{-j_{1}}^{2}=\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}-2y_{j_{1}}+y_{j_{1}}^{2}\right)  =\frac{1}{4}\left(
2I_{\mathcal{F}}-2y_{j_{1}}\right)  =\frac{1}{2}\left(  I_{\mathcal{F}%
}-y_{j_{1}}\right)  =p_{-j_{1}}\\
&  p_{+j_{1}}p_{-j_{1}}=\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}-y_{j_{1}}^{2}\right)  =0\\
&  p_{-j_{1}}+p_{+j_{1}}=\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
+\frac{1}{2}\left(  I_{\mathcal{F}}-y_{j_{1}}\right)  =I_{\mathcal{F}}%
\end{align}
and
\begin{align}
p_{+j_{1}}p_{+j_{2}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{2}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}+y_{j_{1}}+y_{j_{2}}+y_{j_{1}}y_{j_{2}}\right)  \neq p_{+j_{2}%
}p_{+j_{1}}\\
p_{+j_{2}}p_{+j_{1}}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{2}}\right)
\frac{1}{2}\left(  I_{\mathcal{F}}+y_{j_{1}}\right)  =\frac{1}{4}\left(
I_{\mathcal{F}}+y_{j_{1}}+y_{j_{2}}-y_{j_{1}}y_{j_{2}}\right)  \neq p_{+j_{1}%
}p_{+j_{2}}.
\end{align}


In general if
\begin{equation}
A^{2}=I_{\mathcal{F}}%
\end{equation}
then one can form the idempotents
\begin{align}
A_{+}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}+A\right) \\
A_{-}  &  =\frac{1}{2}\left(  I_{\mathcal{F}}-A\right)
\end{align}
such that
\begin{align}
A_{+}A_{-}  &  =0\\
A_{+}+A_{-}  &  =I_{\mathcal{F}}.
\end{align}
$\lceil$%
\begin{align}
\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}+A\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}+2A+I_{\mathcal{F}}\right)
=\frac{1}{2}\left(  I_{\mathcal{F}}+A\right) \\
\frac{1}{2}\left(  I_{\mathcal{F}}-A\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-A\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}-2A+I_{\mathcal{F}}\right)
=\frac{1}{2}\left(  I_{\mathcal{F}}-A\right) \\
\frac{1}{2}\left(  I_{\mathcal{F}}+A\right)  \frac{1}{2}\left(  I_{\mathcal{F}%
}-A\right)   &  =\frac{1}{4}\left(  I_{\mathcal{F}}-I_{\mathcal{F}}\right)  =0
\end{align}
$\rfloor$

The $\left\{  n_{j}\right\}  $ and $\left\{  h_{j}\right\}  $ are pairs of
projectors that satisfy the prceeding, where $A_{j}=$ $ix_{j}x_{j+r}$.

The inverse relationship is
\begin{equation}
A=2A_{+}-I_{\mathcal{F}}=2A_{-}+I_{\mathcal{F}}.
\end{equation}


If
\begin{equation}
A=A^{\dagger}%
\end{equation}
then the idempotents are self adjoint.

\subsection{Ket-Bra Primitive Idempotents}

\subsubsection{Operator and Vector Exterior Products in $\mathcal{F}$}

\subparagraph{Definitions of \emph{operator exterior product and vector
exterior product of operators}}

The \emph{Operator Exterior Products }$\boxtimes$ and the \emph{Vector
Exterior Products }$\overset{\text{vec}}{\wedge}$ of bra-ket basis elements of
the one particle operator space are defined by
\begin{align}
\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \boxtimes\cdots\boxtimes\left\vert \varphi_{j_{N}}\right\rangle
\left\langle \varphi_{k_{M}}\right\vert  & =\mathcal{A}_{N}\left(  \left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert
\otimes\cdots\otimes\left\vert \varphi_{j_{M}}\right\rangle \left\langle
\varphi_{k_{M}}\right\vert \right)  \mathcal{A}_{M}\\
& =\frac{1}{\left(  N!M!\right)  }\sum_{\substack{\sigma\in S_{N}\\\mu\in
S_{M}}}\left\vert \varphi_{j_{\sigma\left(  1\right)  }}\right\rangle
\left\langle \varphi_{k_{\mu\left(  1\right)  }}\right\vert \otimes
\cdots\otimes\left\vert \varphi_{j_{\sigma\left(  N\right)  }}\right\rangle
\left\langle \varphi_{k_{\mu\left(  M\right)  }}\right\vert
\end{align}
and
\begin{align}
\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \overset{\text{vec}}{\wedge}\cdots\overset{\text{vec}}{\wedge
}\left\vert \varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}%
}\right\vert  & =\mathcal{A}_{N}\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{k_{1}}\right\vert \otimes\cdots
\otimes\left\vert \varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}%
}\right\vert \right)  \\
& =\frac{1}{N!}\sum_{\sigma\in S_{N}}\left\vert \varphi_{j_{\sigma\left(
1\right)  }}\right\rangle \left\langle \varphi_{k_{\sigma\left(  1\right)  }%
}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{\sigma\left(
N\right)  }}\right\rangle \left\langle \varphi_{k_{\sigma\left(  N\right)  }%
}\right\vert .
\end{align}
Bra-ket elements (which can be defined intrinsically in the algebra
$\mathcal{F}$ -see Takesaki -independently of operating on a vector space) are
grade inhomogeneous (in terms of grades defined by self adjoint Majorana
operators) so it is important to note that (Chisholm eq.80) that in general
\begin{equation}
C\overset{\text{vec}}{\wedge}D=\sum\limits_{0\leq m,n\leq2r}\left\langle
C_{m}D_{n}\right\rangle _{m+n}%
\end{equation}
and that the product $\overset{\text{vec}}{\wedge}$ is associative and
\begin{equation}
C_{m}\overset{\text{vec}}{\wedge}D_{n}=\left(  -1\right)  ^{m+n}%
D_{n}\overset{\text{vec}}{\wedge}C_{m}%
\end{equation}


$\lceil$%
\begin{align}
&  \left(  \frac{{}}{{}}\left\vert \varphi_{p_{1}}\right\rangle \left\langle
\varphi_{p_{2}}\right\vert \boxtimes\left\vert \varphi_{q_{1}}\right\rangle
\left\langle \varphi_{q_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}%
}\wedge\varphi_{j_{2}}\right\rangle =\frac{1}{2!}\sum_{\sigma\in S_{2}%
}\left\vert \varphi_{\sigma\left(  p\right)  _{1}}\right\rangle \left\langle
\varphi_{\sigma\left(  p\right)  _{2}}\right\vert \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\left\vert \varphi_{\sigma\left(  q\right)  _{1}%
}\right\rangle \left\langle \varphi_{\sigma\left(  q\right)  _{2}}\right\vert
\left\vert \varphi_{j_{2}}\right\rangle \\
&  =\frac{1}{2}\left(  \left\vert \left\vert \varphi_{p_{1}}\right\rangle
\left\langle \varphi_{p_{2}}\right\vert \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\left\vert \varphi_{q_{1}}\right\rangle \left\langle
\varphi_{q_{2}}\right\vert \varphi_{j_{2}}\right\rangle +\left\vert \left\vert
\varphi_{q_{1}}\right\rangle \left\langle \varphi_{q_{2}}\right\vert
\left\vert \varphi_{j_{1}}\right\rangle \wedge\left\vert \varphi_{p_{1}%
}\right\rangle \left\langle \varphi_{p_{2}}\right\vert \varphi_{j_{2}%
}\right\rangle \right)  \\
&  =\frac{1}{2}\left(  \left\vert \varphi_{p_{1}}\right\rangle \wedge
\left\vert \varphi_{q_{1}}\right\rangle \delta_{p_{2}j_{1}}\delta_{q_{2}j_{2}%
}+\left\vert \varphi_{q_{1}}\right\rangle \wedge\left\vert \varphi_{p_{1}%
}\right\rangle \delta_{q_{2}j_{1}}\delta_{p_{2}j_{2}}\right)  \\
&  =\left(  \frac{{}}{{}}\left\vert \varphi_{q_{1}}\right\rangle \left\langle
\varphi_{q_{2}}\right\vert \boxtimes\left\vert \varphi_{p_{1}}\right\rangle
\left\langle \varphi_{p_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}%
}\wedge\varphi_{j_{2}}\right\rangle =\left(  \frac{1}{2}\left\vert
\varphi_{p_{1}}\varphi_{q_{1}}\right\rangle \left\langle \varphi_{p_{2}%
}\varphi_{q_{2}}\right\vert \right)  \left\vert \varphi_{j_{1}}\wedge
\varphi_{j_{2}}\right\rangle ,
\end{align}
where%
\begin{equation}
S_{2}=\left\{  \sigma_{1},\sigma_{2}\right\}
\end{equation}%
\begin{align}
\sigma_{1} &  :p\rightarrow p\\
\sigma_{1} &  :q\rightarrow q
\end{align}%
\begin{align}
\sigma_{2} &  :p\rightarrow q\\
\sigma_{2} &  :q\rightarrow p.
\end{align}%
\begin{equation}
\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \overset{\text{vec}}{\wedge}\left\vert \varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{2}}\right\vert =\frac{1}{2}\left(
\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \otimes\left\vert \varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{2}}\right\vert -\left\vert \varphi_{j_{2}}\right\rangle
\left\langle \varphi_{k_{2}}\right\vert \otimes\left\vert \varphi_{j_{1}%
}\right\rangle \left\langle \varphi_{k_{1}}\right\vert \right)
\end{equation}
$\rfloor$

In general%
\begin{equation}
A_{1}\boxtimes\cdots\boxtimes A_{p}=\mathcal{A}_{p}A_{1}\otimes\cdots\otimes
A_{p}\mathcal{A}_{p}%
\end{equation}
giving%
\begin{equation}
\left(  A_{1}\boxtimes\cdots\boxtimes A_{p}\right)  \left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle =\frac{1}{p!}\sum_{\sigma\in
S_{p}}\left\vert A_{\sigma\left(  1\right)  }\varphi_{j_{1}}\wedge\cdots\wedge
A_{\sigma\left(  p\right)  }\varphi_{j_{p}}\right\rangle .
\end{equation}
Note that
\begin{align}
A_{1}\otimes\cdots\otimes A_{p}  & \notin\mathcal{F}\\
\mathcal{A}_{p}  & \notin\mathcal{F}.
\end{align}


One can compare the action of the operator wedge product%

\begin{align}
&  \left(  \left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi
_{k_{1}}\right\vert \boxtimes\cdots\boxtimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)  \left\vert
\varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{N}}\right\rangle =\mathcal{A}%
_{N}\left(  \left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)  \left\vert
\varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{N}}\right\rangle \\
&  =\mathcal{A}_{N}\left(  \left\vert \varphi_{j_{1}}\right\rangle
\left\langle \varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)
\mathcal{A}_{N}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes\varphi_{l_{N}%
}\right\rangle \\
&  =\mathcal{A}_{N}\left(  \left\vert \varphi_{j_{1}}\right\rangle
\left\langle \varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \right)
\mathcal{A}_{N}^{2}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes
\varphi_{l_{N}}\right\rangle
\end{align}
to the vector space wedge product of operators on an antisymmetric vector
space (such as $\mathcal{F}$ itself as in the left regular Hilbert Schmidt
representation)
\begin{align}
&  \left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}%
}\right\vert \overset{\text{vec}}{\wedge}\cdots\overset{\text{vec}}{\wedge
}\left\vert \varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}%
}\right\vert \left\vert \varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{p}%
}\right\rangle =\mathcal{A}_{N}\left\vert \varphi_{j_{1}}\right\rangle
\left\langle \varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert
\varphi_{j_{N}}\right\rangle \left\langle \varphi_{k_{N}}\right\vert
\left\vert \varphi_{l_{1}}\wedge\cdots\wedge\varphi_{l_{p}}\right\rangle \\
&  =\mathcal{A}_{N}\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \mathcal{A}%
_{N}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes\varphi_{l_{N}}\right\rangle
\\
&  =\mathcal{A}_{N}\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \otimes\cdots\otimes\left\vert \varphi_{j_{N}%
}\right\rangle \left\langle \varphi_{k_{N}}\right\vert \mathcal{A}_{N}%
^{2}\left\vert \varphi_{l_{1}}\otimes\cdots\otimes\varphi_{l_{N}%
}\right\rangle
\end{align}
and see that they are \emph{identical. }

Recall the expressions for one particle and one hole projections
\begin{align}
n_{j} &  =a_{j}^{\dagger}a_{j}=\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}%
=n_{j}^{\dagger}\\
h_{j} &  =a_{j}a_{j}^{\dagger}=I_{\mathcal{F}}-n_{j}=\frac{1}{2}%
I_{\mathcal{F}}-ix_{j}x_{j+r}=h_{j}^{\dagger}.
\end{align}


Consider the $r=3$ case%

\begin{equation}
\mathcal{H}_{\mathcal{F}}=\operatorname*{linspan}\left\{  \left\vert
\phi\right\rangle ,\left\vert \varphi_{1}\right\rangle ,\left\vert \varphi
_{2}\right\rangle ,\left\vert \varphi_{3}\right\rangle ,\left\vert \varphi
_{1}\varphi_{2}\right\rangle ,\left\vert \varphi_{1}\varphi_{3}\right\rangle
,\left\vert \varphi_{2}\varphi_{3}\right\rangle ,\left\vert \varphi_{1}%
\varphi_{2}\varphi_{3}\right\rangle \right\}
\end{equation}
then as operators acting in $\mathcal{H}_{\mathcal{F}}$

1.
\begin{equation}
\left\vert \phi\right\rangle \left\langle \phi\right\vert =a_{3}a_{2}%
a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{3}^{\dagger}=a_{3}a_{3}^{\dagger}%
a_{2}a_{2}^{\dagger}a_{1}a_{1}^{\dagger}=h_{3}h_{2}h_{1}=%
%TCIMACRO{\dprod \limits_{l=1,2,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2,3}}
%EndExpansion
h_{i}%
\end{equation}%
\begin{align}
\left\vert \phi\right\rangle \left\langle \phi\right\vert  &  =%
%TCIMACRO{\dprod \limits_{1\leq j\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\leq3}}
%EndExpansion
h_{j}=h_{1}h_{2}h_{3}=\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{5}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{3}x_{6}\right)  \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-\frac{1}{2}ix_{1}x_{4}-\frac{1}%
{2}ix_{2}x_{5}-x_{1}x_{4}x_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right)  \\
&  =\left(  \frac{1}{8}I_{\mathcal{F}}-\frac{1}{4}ix_{1}x_{4}-\frac{1}%
{4}ix_{2}x_{5}-\frac{1}{2}x_{1}x_{4}x_{2}x_{5}-\frac{1}{4}ix_{3}x_{6}-\frac
{1}{2}x_{1}x_{4}x_{3}x_{6}-\frac{1}{2}x_{2}x_{5}x_{3}x_{6}+ix_{1}x_{4}%
x_{2}x_{5}x_{3}x_{6}\right)  \\
&  =\left(  \frac{1}{8}I_{\mathcal{F}}-\frac{1}{4}ix_{1}x_{4}-\frac{1}%
{4}ix_{2}x_{5}-\frac{1}{4}ix_{3}x_{6}-\frac{1}{2}x_{1}x_{4}x_{2}x_{5}-\frac
{1}{2}x_{1}x_{4}x_{3}x_{6}-\frac{1}{2}x_{2}x_{5}x_{3}x_{6}+ix_{1}x_{4}%
x_{2}x_{5}x_{3}x_{6}\right)  \\
&  =\left(  \frac{1}{8}I_{\mathcal{F}}-\frac{1}{4}i\left(  x_{1}x_{4}%
+x_{2}x_{5}+x_{3}x_{6}\right)  +\frac{1}{2}\left(  x_{1}x_{2}x_{4}x_{5}%
+x_{1}x_{3}x_{4}x_{6}+x_{2}x_{3}x_{5}x_{6}\right)  -ix_{1}x_{2}x_{3}x_{4}%
x_{5}x_{6}\right)  ,
\end{align}


2.%
\begin{equation}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
=a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}=a_{3}%
a_{3}^{\dagger}a_{2}a_{2}^{\dagger}a_{1}^{\dagger}a_{1}=h_{3}h_{2}n_{1}=%
%TCIMACRO{\dprod \limits_{l=1}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=2,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=2,3}}
%EndExpansion
h_{i},
\end{equation}
which one can check by%

\begin{align}
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\phi\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{1}\right\rangle  &  =\left\vert \varphi_{1}\right\rangle \\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{2}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{3}^{\dagger}a_{2}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{2}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{2}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\right\rangle  &  =0.
\end{align}
$\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert $ can
be expresses in the self adjoint basis as
\begin{align}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert  &  =%
%TCIMACRO{\dprod \limits_{1\leq j\neq1\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\neq1\leq3}}
%EndExpansion
h_{j}a_{j_{1}}^{\dagger}a_{j_{1}}=h_{2}h_{3}a_{1}^{\dagger}a_{1}=h_{2}%
h_{3}n_{1}=n_{1}h_{2}h_{3}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}%
x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{5}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}-ix_{3}x_{6}\right)  \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-i\frac{1}{2}x_{2}x_{5}+i\frac{1}%
{2}x_{1}x_{4}+x_{1}x_{4}x_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right)  \\
&  =\frac{1}{8}I_{\mathcal{F}}-i\frac{1}{4}x_{3}x_{6}-i\frac{1}{4}x_{2}%
x_{5}+i\frac{1}{4}x_{1}x_{4}+\frac{1}{2}x_{1}x_{4}x_{2}x_{5}-\frac{1}{2}%
x_{2}x_{5}x_{3}x_{6}+\frac{1}{2}x_{1}x_{4}x_{3}x_{6}-ix_{1}x_{4}x_{2}%
x_{5}x_{3}x_{6}\\
&  =\frac{1}{8}I_{\mathcal{F}}-i\frac{1}{4}\left(  x_{3}x_{6}+x_{2}x_{5}%
-x_{1}x_{4}\right)  +\frac{1}{2}\left(  -x_{1}x_{2}x_{4}x_{5}+x_{2}x_{3}%
x_{5}x_{6}-x_{1}x_{3}x_{4}x_{6}\right)  +ix_{1}x_{2}x_{3}x_{4}x_{5}x_{6}.
\end{align}


3.%
\begin{align}
\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert  & =%
%TCIMACRO{\dprod \limits_{1\leq j\neq2\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\neq2\leq3}}
%EndExpansion
h_{j}a_{j_{1}}^{\dagger}a_{j_{1}}=h_{1}h_{3}a_{2}^{\dagger}a_{2}=h_{1}%
h_{3}n_{2}=a_{3}a_{1}a_{2}^{\dagger}a_{2}a_{1}^{\dagger}a_{3}^{\dagger}%
=a_{3}a_{3}^{\dagger}a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}=h_{3}h_{1}n_{2}=%
%TCIMACRO{\dprod \limits_{l=2}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=2}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=1,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,3}}
%EndExpansion
h_{i}\\
& =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{5}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right)  .
\end{align}


4%
\begin{align}
\left\vert \varphi_{3}\right\rangle \left\langle \varphi_{3}\right\vert  & =%
%TCIMACRO{\dprod \limits_{1\leq j\neq3\leq3}}%
%BeginExpansion
{\displaystyle\prod\limits_{1\leq j\neq3\leq3}}
%EndExpansion
h_{j}a_{j_{1}}^{\dagger}a_{j_{1}}=h_{1}h_{2}a_{3}^{\dagger}a_{3}=h_{1}%
h_{2}n_{3}=a_{2}a_{1}a_{3}^{\dagger}a_{3}a_{1}^{\dagger}a_{2}^{\dagger}%
=a_{2}a_{2}^{\dagger}a_{1}a_{1}^{\dagger}a_{3}^{\dagger}a_{23}=h_{2}h_{1}%
n_{3}=%
%TCIMACRO{\dprod \limits_{l=3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=3}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=1,2}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2}}
%EndExpansion
h_{i}\\
& =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{3}x_{6}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{5}\right)  .
\end{align}


5.%
\begin{align}
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}%
\varphi_{2}\right\vert  & =a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}%
a_{3}^{\dagger}=a_{3}a_{3}^{\dagger}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}%
a_{2}=h_{3}n_{2}n_{1}=%
%TCIMACRO{\dprod \limits_{l=1,2}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{l=3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=3}}
%EndExpansion
h_{i}\\
& =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{4}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{3}x_{6}\right)  ,
\end{align}
which one can check by%

\begin{align}
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\phi\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{2}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =\left\vert \varphi_{1}\varphi
_{2}\right\rangle \\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{2}\varphi_{3}\right\rangle  &  =0\\
a_{3}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{3}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\varphi_{3}\right\rangle  &  =0.
\end{align}
6.%
\begin{equation}
\left\vert \varphi_{1}\varphi_{3}\right\rangle \left\langle \varphi_{1}%
\varphi_{3}\right\vert =h_{2}a_{1}^{\dagger}a_{3}^{\dagger}a_{3}a_{1}%
=h_{2}n_{1}n_{3},
\end{equation}
7.%
\begin{equation}
\left\vert \varphi_{2}\varphi_{3}\right\rangle \left\langle \varphi_{2}%
\varphi_{3}\right\vert =h_{1}a_{2}^{\dagger}a_{3}^{\dagger}a_{3}a_{2}%
=h_{1}n_{2}n_{3},
\end{equation}
8.%
\begin{align}
\left\vert \varphi_{1}\varphi_{2}\varphi_{3}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\varphi_{3}\right\vert  & =a_{1}^{\dagger}a_{1}%
a_{2}^{\dagger}a_{2}a_{3}^{\dagger}a_{3}=n_{3}n_{2}n_{1}=%
%TCIMACRO{\dprod \limits_{l=1,2,3}}%
%BeginExpansion
{\displaystyle\prod\limits_{l=1,2,3}}
%EndExpansion
n_{i}\\
& =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{4}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{2}x_{5}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}+ix_{3}x_{6}\right)
\end{align}


The projectors onto subspaces of fixed particle number are given by
\begin{align}
P_{0} &  =h_{1}h_{2}h_{3}\\
P_{1} &  =h_{2}h_{3}a_{1}^{\dagger}a_{1}+h_{1}h_{3}a_{2}^{\dagger}a_{2}%
+h_{1}h_{2}a_{3}^{\dagger}a_{3}=h_{2}h_{3}n_{1}+h_{1}h_{3}n_{2}+h_{1}%
h_{2}n_{3}\\
P_{2} &  =h_{1}n_{2}n_{3}+h_{2}n_{1}n_{3}+h_{3}n_{1}n_{2}\\
P_{3} &  =n_{1}n_{2}n_{3}%
\end{align}
giving%
\begin{equation}
I_{\mathcal{F}}=P_{0}+P_{1}+P_{2}+P_{3}.
\end{equation}


The identity operator for $r=2$ has the expansion
\begin{equation}
I_{\mathcal{F}}=P_{0}+P_{1}+P_{2}=h_{1}h_{2}+h_{2}n_{1}+h_{1}n_{2}+n_{1}n_{2},
\end{equation}
where%
\begin{align}
P_{0} &  =h_{1}h_{2}=\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
+x_{1}x_{2}x_{3}x_{4}\\
P_{0} &  =h_{1}h_{2}=\left(  I_{\mathcal{F}}-n_{1}\right)  \left(
I_{\mathcal{F}}-n_{2}\right)  =I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\\
P_{1} &  =h_{2}a_{1}^{\dagger}a_{1}+h_{1}a_{2}^{\dagger}a_{2}=h_{1}n_{2}%
+h_{2}n_{1}\\
&  =h_{1}n_{2}+h_{2}n_{1}=\left(  I_{\mathcal{F}}-n_{1}\right)  n_{2}+\left(
I_{\mathcal{F}}-n_{2}\right)  n_{1}=n_{2}-n_{1}n_{2}+n_{1}-n_{1}n_{2}%
=n_{1}+n_{2}-2n_{1}n_{2}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)  +\left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)
\\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{1}{2}ix_{1}x_{3}+\frac{1}{2}ix_{2}%
x_{4}+x_{1}x_{3}x_{2}x_{4}+\frac{1}{4}I_{\mathcal{F}}+\frac{1}{2}ix_{1}%
x_{3}-\frac{1}{2}ix_{2}x_{4}+x_{2}x_{4}x_{1}x_{3}\\
&  =\frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}\\
P_{2} &  =n_{1}n_{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
+x_{1}x_{2}x_{3}x_{4}.
\end{align}


In general bra-ket operators can be expressed as
\begin{align}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\vert  &  =%
%TCIMACRO{\dprod \limits_{0\leq l\leq p}}%
%BeginExpansion
{\displaystyle\prod\limits_{0\leq l\leq p}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{p+1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{p+1\leq l\leq r}}
%EndExpansion
h_{i}=%
%TCIMACRO{\dprod \limits_{0\leq l\leq p}}%
%BeginExpansion
{\displaystyle\prod\limits_{0\leq l\leq p}}
%EndExpansion
n_{i}%
%TCIMACRO{\dprod \limits_{p+1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{p+1\leq l\leq r}}
%EndExpansion
\left(  I_{\mathcal{F}}-n_{l}\right)  \\
&  =%
%TCIMACRO{\dprod \limits_{0\leq l\leq p}}%
%BeginExpansion
{\displaystyle\prod\limits_{0\leq l\leq p}}
%EndExpansion
\left\{  \frac{1}{2}I_{\mathcal{F}}+ix_{l}x_{l+r}\right\}
%TCIMACRO{\dprod \limits_{p+1\leq l\leq r}}%
%BeginExpansion
{\displaystyle\prod\limits_{p+1\leq l\leq r}}
%EndExpansion
\left\{  \frac{1}{2}I_{\mathcal{F}}-ix_{l}x_{l+r}\right\}  .
\end{align}


\subsubsection{Examples of vector exterior product of operators for $r=2,3$}

Consider the hole projectors $\left\{  \left.  h_{j}\right\vert 1\leq
j\leq3\right\}  $ the vector exterior products of operators given by
\begin{align}
h_{1} &  =\frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{4}\\
h_{2} &  =\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{5}%
\end{align}
is%
\begin{align}
h_{1}\wedge h_{1} &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-2ix_{1}x_{4}\\
h_{1}\wedge h_{2} &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{4}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{5}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-ix_{1}x_{4}-ix_{2}x_{5}-x_{1}x_{4}x_{2}x_{5}.
\end{align}
The vector exterior product of the operator $P_{1}$ is given by
\begin{equation}
P_{1}\wedge P_{1}=\left(  \frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}%
x_{4}\right)  \wedge\left(  \frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}%
x_{4}\right)  =\frac{1}{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}%
\end{equation}
$\lceil$%
\begin{align}
A\wedge B &  =AB-\left(  \left\langle A_{2}B_{2}\right\rangle _{0}%
+\left\langle A_{2}B_{2}\right\rangle _{2}+\left\langle A_{4}B_{2}%
\right\rangle _{2}+\left\langle A_{4}B_{2}\right\rangle _{4}\right.  \\
&  +\left.  \left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle A_{4}%
B_{4}\right\rangle _{0}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{4}\right\rangle _{4}+\left\langle A_{4}B_{4}\right\rangle _{6}\right)
\end{align}%
\begin{align}
P_{1}\wedge P_{1} &  =P_{1}-\left(  \left\langle P_{12}P_{12}\right\rangle
_{0}+\left\langle P_{12}P_{12}\right\rangle _{2}+\left\langle P_{14}%
P_{12}\right\rangle _{2}+\left\langle P_{14}P_{12}\right\rangle _{4}\right.
\\
&  +\left.  \left\langle P_{12}P_{14}\right\rangle _{2}+\left\langle
P_{14}P_{14}\right\rangle _{0}+\left\langle P_{14}P_{14}\right\rangle
_{2}+\left\langle P_{14}P_{14}\right\rangle _{4}+\left\langle P_{14}%
P_{14}\right\rangle _{6}\right)  \\
&  =P_{1}-\left\langle P_{14}P_{14}\right\rangle _{0}=\frac{1}{2}%
I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}I_{\mathcal{F}}=\frac{1}%
{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}%
\end{align}
$\rfloor$

The projectors onto subspaces of fixed particle number for $r=2$ case are
given by
\begin{align}
P_{0} &  =I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}-a_{2}^{\dagger}a_{2}%
+a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=I_{\mathcal{F}}-n_{1}-n_{2}%
+n_{1}n_{2}\\
P_{1} &  =a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}a_{2}-2a_{1}^{\dagger}%
a_{2}^{\dagger}a_{2}a_{1}=n_{1}+n_{2}-2n_{1}n_{2}\\
P_{2} &  =a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=n_{1}n_{2}.
\end{align}
Checking the orthogonality of these projectors one obtains
\begin{align*}
P_{0}P_{1} &  =\left(  I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\right)  \left(
n_{1}+n_{2}-2n_{1}n_{2}\right)  \\
&  =n_{1}+n_{2}-2n_{1}n_{2}-n_{1}\left(  n_{1}+n_{2}-2n_{1}n_{2}\right)
-n_{2}\left(  n_{1}+n_{2}-2n_{1}n_{2}\right)  +n_{1}n_{2}\left(  n_{1}%
+n_{2}-2n_{1}n_{2}\right)  \\
&  =n_{1}+n_{2}-2n_{1}n_{2}-n_{1}-n_{1}n_{2}+2n_{1}n_{2}-n_{2}n_{1}%
-n_{2}+2n_{1}n_{2}\\
&  =-2n_{1}n_{2}-n_{1}n_{2}+2n_{1}n_{2}-n_{2}n_{1}+2n_{1}n_{2}=0
\end{align*}%
\begin{equation}
P_{0}P_{2}=\left(  I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\right)  n_{1}%
n_{2}=n_{1}n_{2}-n_{1}n_{2}-n_{1}n_{2}+n_{1}n_{2}=0
\end{equation}%
\begin{equation}
P_{1}P_{2}=\left(  n_{1}+n_{2}-2n_{1}n_{2}\right)  n_{1}n_{2}=n_{1}n_{2}%
+n_{1}n_{2}-2n_{1}n_{2}=0
\end{equation}
If $r=2$ then atomic idempotents in the non self adjoint basis are
\begin{align}
\kappa_{0} &  =\left\vert \phi\right\rangle \left\langle \phi\right\vert
=h_{1}h_{2}=a_{1}a_{1}^{\dagger}a_{2}a_{2}^{\dagger}=\left(  1-a_{1}^{\dagger
}a_{1}\right)  \left(  1-a_{2}^{\dagger}a_{2}\right)  =I_{\mathcal{F}}%
-a_{1}^{\dagger}a_{1}-a_{2}^{\dagger}a_{2}+a_{1}^{\dagger}a_{1}a_{2}^{\dagger
}a_{2}=I_{\mathcal{F}}-n_{1}-n_{2}+n_{1}n_{2}\\
\kappa_{1} &  =\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert =h_{2}n_{1}=a_{2}a_{2}^{\dagger}a_{1}^{\dagger}a_{1}=\left(
1-a_{2}^{\dagger}a_{2}\right)  a_{1}^{\dagger}a_{1}=a_{1}^{\dagger}a_{1}%
-a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}=n_{1}-n_{1}n_{2}=n_{1}\left(
I_{\mathcal{F}}-n_{2}\right)  \\
\kappa_{2} &  =\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert =h_{1}n_{2}=a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}=\left(
1-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger}a_{2}=a_{2}^{\dagger}a_{2}%
-a_{2}^{\dagger}a_{1}^{\dagger}a_{1}a_{2}=n_{2}-n_{1}n_{2}=n_{2}\left(
I_{\mathcal{F}}-n_{1}\right)  \\
\kappa_{12} &  =\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert =n_{1}n_{2},
\end{align}%
\begin{equation}
\kappa_{1}\boxtimes\kappa_{2}=2\kappa_{12}%
\end{equation}
while in the self adjoint basis they are%
\begin{equation}
\kappa_{0}=\kappa_{00}+\kappa_{02}+\kappa_{04}=\left(  I_{\mathcal{F}}%
-n_{1}\right)  \left(  I_{\mathcal{F}}-n_{2}\right)  =\left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{4}\right)  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
\kappa_{1}=\kappa_{10}+\kappa_{12}+\kappa_{14}=n_{1}\left(  I_{\mathcal{F}%
}-n_{2}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
\kappa_{2}=\kappa_{20}+\kappa_{22}+\kappa_{24}=n_{2}\left(  I_{\mathcal{F}%
}-n_{1}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
\kappa_{12}=\kappa_{120}+\kappa_{122}+\kappa_{124}=\left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
=n_{1}n_{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)  =\frac{1}{4}I_{\mathcal{F}%
}+\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}.
\end{equation}
The vector exterior product gives
\begin{equation}
\kappa_{1}\wedge\kappa_{2}=\frac{1}{16}I_{\mathcal{F}}\neq\kappa_{12}%
\end{equation}
They sum to the identity%
\begin{align}
\kappa_{0}+\kappa_{1}+\kappa_{2}+\kappa_{12} &  =\frac{1}{4}I_{\mathcal{F}%
}-\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}%
+\frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\\
&  +\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}+\frac{1}{4}I_{\mathcal{F}}+\frac{i}%
{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\\
&  =I_{\mathcal{F}}.
\end{align}
Denoting the \emph{operator exterior product of operators} as $\boxtimes$ one
obtains
\begin{align}
&  \left(  n_{1}-n_{1}n_{2}\right)  \boxtimes\left(  n_{2}-n_{1}n_{2}\right)
=n_{1}\boxtimes n_{2}-n_{1}\boxtimes n_{1}n_{2}-n_{1}n_{2}\boxtimes
n_{2}+n_{1}n_{2}\boxtimes n_{1}n_{2}=\frac{1}{2}n_{1}n_{2}\\
&  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  \boxtimes\left(  \frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\right)  \\
&  =\frac{1}{2}\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)
\end{align}


The \emph{vector space exterior products} of $\kappa_{1}$ and $\kappa_{2}$ is
given by
\begin{align}
&  \kappa_{1}\wedge\kappa_{2}=\left(  \kappa_{10}+\kappa_{12}+\kappa
_{14}\right)  \wedge\left(  \kappa_{20}+\kappa_{22}+\kappa_{24}\right)
=\kappa_{10}\kappa_{20}+\kappa_{12}+\kappa_{14}+\kappa_{22}+\kappa
_{24}+\left\langle \kappa_{12}\kappa_{22}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle \left(  x_{1}x_{3}-x_{2}x_{4}\right)  \left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{1}%
{4}x_{1}x_{2}x_{3}x_{4}+\frac{1}{4}\left\langle \left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle x_{1}x_{3}x_{1}x_{3}-x_{2}x_{4}x_{1}x_{3}-x_{1}x_{3}x_{2}%
x_{4}+x_{2}x_{4}x_{2}x_{4}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle -\frac{1}{4}I_{\mathcal{F}}+x_{1}x_{2}x_{3}x_{4}+x_{1}%
x_{2}x_{3}x_{4}-\frac{1}{4}I_{\mathcal{F}}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{2}x_{1}x_{2}x_{3}x_{4}=\frac{1}{16}I_{\mathcal{F}}%
\end{align}
checked by%
\begin{align}
&  \kappa_{1}\wedge\kappa_{2}=\left(  \left(  \frac{1}{4}I_{\mathcal{F}}%
+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}%
x_{3}x_{4}\right)  \wedge\left(  \left(  \frac{1}{4}I_{\mathcal{F}}-\frac
{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}x_{3}%
x_{4}\right) \\
&  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  \right)  \wedge\left(  \frac{1}{4}I_{\mathcal{F}%
}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +\left(  \frac
{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right)  \wedge x_{1}x_{2}x_{3}x_{4}\right. \\
&  \left.  -x_{1}x_{2}x_{3}x_{4}\wedge\left(  \frac{1}{4}I_{\mathcal{F}}%
+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}%
x_{3}x_{4}\wedge x_{1}x_{2}x_{3}x_{4}\right) \\
&  \left(  \left(  \frac{1}{16}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-\frac{1}{4}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \wedge\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  \right)  +\left(  \frac{1}{4}I_{\mathcal{F}}+\frac
{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  \wedge x_{1}x_{2}%
x_{3}x_{4}\right. \\
&  -\left.  x_{1}x_{2}x_{3}x_{4}\wedge\left(  \frac{1}{4}I_{\mathcal{F}}%
+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +x_{1}x_{2}%
x_{3}x_{4}\wedge x_{1}x_{2}x_{3}x_{4}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{8}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  +\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{8}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  +\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \wedge\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{2}x_{2}x_{4}x_{1}x_{3}=\frac{1}{16}I_{\mathcal{F}}.
\end{align}
The \emph{vector space exterior products} of $\kappa_{1}$ and $\kappa_{1}$ is
given by%
\begin{align}
&  \kappa_{1}\wedge\kappa_{1}=\left(  \kappa_{10}+\kappa_{12}+\kappa
_{14}\right)  \wedge\left(  \kappa_{10}+\kappa_{12}+\kappa_{14}\right)
=\kappa_{10}\kappa_{10}+\kappa_{12}+\kappa_{14}+\kappa_{12}+\kappa
_{14}+\left\langle \kappa_{12}\kappa_{12}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}+\frac{i}{2}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}-\frac{1}%
{4}\left\langle \left(  x_{1}x_{3}-x_{2}x_{4}\right)  \left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+i\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}\left\langle x_{1}x_{3}x_{1}%
x_{3}-x_{2}x_{4}x_{1}x_{3}-x_{1}x_{3}x_{2}x_{4}+x_{2}x_{4}x_{2}x_{4}%
\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+i\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\neq0
\end{align}
which is correct as they are grade 1 elements.

The Clifford operator products by
\begin{align*}
\kappa_{1}\kappa_{2}  &  =\left(  \left(  \frac{1}{4}I_{\mathcal{F}}%
-x_{1}x_{2}x_{3}x_{4}\right)  +\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \right)  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}%
x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}x_{2}x_{3}x_{4}\right)  ^{2}%
+\frac{1}{4}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  ^{2}\\
&  =\left(  \frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}%
+x_{1}x_{2}x_{3}x_{4}x_{1}x_{2}x_{3}x_{4}\right)  +\frac{1}{4}\left(
x_{1}x_{3}x_{1}x_{3}-x_{1}x_{3}x_{2}x_{4}-x_{2}x_{4}x_{1}x_{3}+x_{2}x_{4}%
x_{2}x_{4}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{16}I_{\mathcal{F}}+\frac{1}{4}\left(  -\frac{1}{4}I_{\mathcal{F}}+x_{1}%
x_{2}x_{3}x_{4}+x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}I_{\mathcal{F}}\right) \\
&  =\frac{1}{8}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}%
{8}I_{\mathcal{F}}+\frac{1}{2}x_{1}x_{2}x_{3}x_{4}=0
\end{align*}%
\begin{align}
\kappa_{0}\kappa_{1}  &  =\left(  \left(  \frac{1}{4}I_{\mathcal{F}}%
+x_{1}x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  \right)  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}%
x_{2}x_{3}x_{4}\right)  +\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right) \\
&  =\left(  \left(  \frac{1}{4}I_{\mathcal{F}}+x_{1}x_{2}x_{3}x_{4}\right)
\left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}x_{2}x_{3}x_{4}\right)  +\left(
\frac{1}{4}I_{\mathcal{F}}+x_{1}x_{2}x_{3}x_{4}\right)  \frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \right. \\
&  \left.  -\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  \left(  \frac
{1}{4}I_{\mathcal{F}}-x_{1}x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  \frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right) \\
&  =\left(  \left(  \frac{1}{16}I_{\mathcal{F}}-x_{1}x_{2}x_{3}x_{4}x_{1}%
x_{2}x_{3}x_{4}\right)  +\frac{i}{2}\left(  \frac{1}{4}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \right)  \right. \\
&  \left.  -\frac{i}{2}\left(  \frac{1}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  -\left(  x_{1}x_{3}+x_{2}x_{4}\right)  x_{1}x_{2}x_{3}%
x_{4}\right)  +\frac{1}{4}\left(  x_{1}x_{3}x_{1}x_{3}-x_{2}x_{4}x_{2}%
x_{4}\right)  \right) \\
&  =0
\end{align}%
\begin{equation}
\kappa_{0}\kappa_{2}=\left(  \left(  \frac{1}{4}I_{\mathcal{F}}+x_{1}%
x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
\right)  \left(  \left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}x_{2}x_{3}%
x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)
\end{equation}%
\begin{equation}
\kappa_{0}\kappa_{12}=\left(  \left(  \frac{1}{4}I_{\mathcal{F}}+x_{1}%
x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
\right)  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)
\end{equation}%
\begin{equation}
\kappa_{1}\kappa_{12}=\left(  \left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}%
x_{2}x_{3}x_{4}\right)  +\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right)  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)
\end{equation}%
\begin{equation}
\kappa_{2}\kappa_{12}=\left(  \left(  \frac{1}{4}I_{\mathcal{F}}-x_{1}%
x_{2}x_{3}x_{4}\right)  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right)  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}%
x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)
\end{equation}%
\begin{equation}
\kappa_{1}=\kappa_{10}+\kappa_{12}+\kappa_{14}=n_{1}\left(  I_{\mathcal{F}%
}-n_{2}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
\kappa_{2}=\kappa_{20}+\kappa_{22}+\kappa_{24}=n_{2}\left(  I_{\mathcal{F}%
}-n_{1}\right)  =\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)
\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
AB=\sum_{0\leq m,n\leq2r}\sum_{j=0}^{\min\left(  m,n\right)  }\left\langle
A_{m}B_{n}\right\rangle _{\left\vert m-n\right\vert +2j}%
\end{equation}%
\begin{align}
\kappa_{1}\kappa_{2}  &  =\left(  \left\langle \kappa_{10}\kappa
_{20}\right\rangle _{0}\right)  +\left\langle \kappa_{12}\kappa_{22}%
\right\rangle _{0}+\left(  \left\langle \kappa_{12}\kappa_{22}\right\rangle
_{4}\right)  +\left\langle \kappa_{14}\kappa_{24}\right\rangle _{0}%
+\left\langle \kappa_{14}\kappa_{24}\right\rangle _{2}+\left\langle
\kappa_{14}\kappa_{24}\right\rangle _{6}+\left(  \left\langle \kappa
_{14}\kappa_{24}\right\rangle _{8}\right) \\
&  +\left(  \left\langle \kappa_{10}\kappa_{22}\right\rangle _{2}\right)
+\left(  \left\langle \kappa_{10}\kappa_{24}\right\rangle _{4}\right)
+\left(  \left\langle \kappa_{12}\kappa_{20}\right\rangle _{2}\right) \\
&  +\left(  \left\langle \kappa_{14}\kappa_{20}\right\rangle _{4}\right)
+\left\langle \kappa_{12}\kappa_{24}\right\rangle _{2}+\left\langle
\kappa_{12}\kappa_{24}\right\rangle _{4}+\left(  \left\langle \kappa
_{12}\kappa_{24}\right\rangle _{6}\right)  +\left\langle \kappa_{14}%
\kappa_{22}\right\rangle _{2}+\left\langle \kappa_{14}\kappa_{22}\right\rangle
_{4}+\left(  \left\langle \kappa_{14}\kappa_{22}\right\rangle _{6}\right)
\end{align}%
\begin{align}
&  =\left\langle \kappa_{12}\kappa_{22}\right\rangle _{0}+\left\langle
\kappa_{14}\kappa_{24}\right\rangle _{0}+\left\langle \kappa_{14}\kappa
_{24}\right\rangle _{2}+\left\langle \kappa_{14}\kappa_{24}\right\rangle
_{6}+\left\langle \kappa_{12}\kappa_{24}\right\rangle _{2}+\left\langle
\kappa_{12}\kappa_{24}\right\rangle _{4}+\left\langle \kappa_{14}\kappa
_{22}\right\rangle _{2}+\left\langle \kappa_{14}\kappa_{22}\right\rangle
_{4}\\
&  +\left(  \left\langle \kappa_{10}\kappa_{20}\right\rangle _{0}\right)
+\left(  \left\langle \kappa_{12}\kappa_{22}\right\rangle _{4}\right)
+\left(  \left\langle \kappa_{14}\kappa_{24}\right\rangle _{8}\right)
+\left(  \left\langle \kappa_{10}\kappa_{22}\right\rangle _{2}\right)
+\left(  \left\langle \kappa_{10}\kappa_{24}\right\rangle _{4}\right)
+\left(  \left\langle \kappa_{12}\kappa_{20}\right\rangle _{2}\right) \\
&  +\left(  \left\langle \kappa_{14}\kappa_{20}\right\rangle _{4}\right)
+\left(  \left\langle \kappa_{12}\kappa_{24}\right\rangle _{6}\right)
+\left(  \left\langle \kappa_{14}\kappa_{22}\right\rangle _{6}\right)
\end{align}%
\begin{align}
&  =\left\langle \kappa_{12}\kappa_{22}\right\rangle _{0}+\left\langle
\kappa_{14}\kappa_{24}\right\rangle _{0}+\left\langle \kappa_{14}\kappa
_{24}\right\rangle _{2}+\left\langle \kappa_{12}\kappa_{24}\right\rangle
_{2}+\left\langle \kappa_{12}\kappa_{24}\right\rangle _{4}+\left\langle
\kappa_{14}\kappa_{22}\right\rangle _{2}+\left\langle \kappa_{14}\kappa
_{22}\right\rangle _{4}\\
&  +\left(  \left\langle \kappa_{10}\kappa_{20}\right\rangle _{0}\right)
++\left(  \left\langle \kappa_{12}\kappa_{22}\right\rangle _{4}\right)
+\left(  \left\langle \kappa_{10}\kappa_{22}\right\rangle _{2}\right)
+\left(  \left\langle \kappa_{10}\kappa_{24}\right\rangle _{4}\right)
+\left(  \left\langle \kappa_{12}\kappa_{20}\right\rangle _{2}\right)
+\left(  \left\langle \kappa_{14}\kappa_{20}\right\rangle _{4}\right) \\
&  =0
\end{align}
If $r>2$ then these atomic projections contain terms of higher order in
$\left\{  \left.  a_{j}^{\dagger},a_{j}\right\vert 1\leq j\leq r\right\}  $
than $4,$ however one can still form \emph{atomic }idempotents $\left\{
\left.  \kappa_{0},\kappa_{j},\kappa_{jk}\right\vert 1\leq j<k\leq r\right\}
.$%

\begin{align*}
&  \kappa_{1}\wedge\kappa_{2}=\left\langle \kappa_{10}\kappa_{20}\right\rangle
_{0}+\left\langle \kappa_{10}\kappa_{22}\right\rangle _{2}+\left\langle
\kappa_{10}\kappa_{24}\right\rangle _{4}+\left\langle \kappa_{12}\kappa
_{20}\right\rangle _{2}+\left\langle \kappa_{12}\kappa_{22}\right\rangle
_{4}+\left\langle \kappa_{12}\kappa_{24}\right\rangle _{6}+\left\langle
\kappa_{14}\kappa_{20}\right\rangle _{4}+\left\langle \kappa_{14}\kappa
_{22}\right\rangle _{6}+\left\langle \kappa_{14}\kappa_{24}\right\rangle
_{8}\\
&  =\left\langle \kappa_{10}\kappa_{20}\right\rangle _{0}+\left\langle
\kappa_{10}\kappa_{22}\right\rangle _{2}+\left\langle \kappa_{10}\kappa
_{24}\right\rangle _{4}+\left\langle \kappa_{12}\kappa_{20}\right\rangle
_{2}+\left\langle \kappa_{12}\kappa_{22}\right\rangle _{4}+\left\langle
\kappa_{14}\kappa_{20}\right\rangle _{4}\\
&  =\left\langle \frac{1}{4}I_{\mathcal{F}}\frac{1}{4}I_{\mathcal{F}%
}\right\rangle _{0}+\left\langle \frac{1}{4}I_{\mathcal{F}}\left(  -x_{1}%
x_{2}x_{3}x_{4}\right)  \right\rangle _{4}+\left\langle -\left(  \frac{i}%
{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  \left(  \frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \right)  \right\rangle _{4}+\left\langle \left(
-x_{1}x_{2}x_{3}x_{4}\right)  \frac{1}{4}I_{\mathcal{F}}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{4}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}x_{1}x_{2}x_{3}x_{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}%
\end{align*}
\emph{The difference between the two defininions of exterior product is
displayed by }%
\begin{align}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
\boxtimes\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert  &  =\left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle
\left\langle \varphi_{1}\wedge\varphi_{2}\right\vert =\frac{1}{2}\left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \\
\kappa_{1}\wedge\kappa_{2}  &  \neq\left\vert \varphi_{1}\wedge\varphi
_{2}\right\rangle \left\langle \varphi_{1}\wedge\varphi_{2}\right\vert
=\frac{1}{2}\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert =\frac{1}{2}\kappa_{12}%
\end{align}
The Clifford exterior product between two non homogeneous fouth order elements
is given by formula
\begin{align}
A\wedge B  &  =AB-\left(  \left\langle A_{2}B_{2}\right\rangle _{0}%
+\left\langle A_{2}B_{2}\right\rangle _{2}+\left\langle A_{4}B_{2}%
\right\rangle _{2}+\left\langle A_{4}B_{2}\right\rangle _{4}\right. \\
&  +\left.  \left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle A_{4}%
B_{4}\right\rangle _{0}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{4}\right\rangle _{4}+\left\langle A_{4}B_{4}\right\rangle _{6}\right)
\end{align}
leading to
\begin{align}
A\wedge B  &  =A_{0}B_{0}+A_{0}B_{2}+A_{0}B_{4}+A_{2}B_{0}+A_{2}B_{2}%
+A_{2}B_{4}+A_{4}B_{0}+A_{4}B_{2}+A_{4}B_{4}\\
&  -\left(  \left\langle A_{2}B_{2}\right\rangle _{0}+\left\langle A_{2}%
B_{2}\right\rangle _{2}+\left\langle A_{4}B_{2}\right\rangle _{2}+\left\langle
A_{4}B_{2}\right\rangle _{4}\right. \\
&  +\left.  \left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle A_{4}%
B_{4}\right\rangle _{0}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{4}\right\rangle _{4}+\left\langle A_{4}B_{4}\right\rangle _{6}\right)
\end{align}
and
\begin{align}
A\wedge B  &  =A_{0}B_{0}+\left\langle A_{0}B_{2}\right\rangle _{0}%
+\left\langle A_{0}B_{2}\right\rangle _{2}+A_{0}B_{4}+A_{2}B_{0}+\left\langle
A_{2}B_{2}\right\rangle _{0}+\left\langle A_{2}B_{2}\right\rangle
_{2}+\left\langle A_{2}B_{2}\right\rangle _{4}+\left\langle A_{2}%
B_{4}\right\rangle _{2}+\left\langle A_{2}B_{4}\right\rangle _{4}+\left\langle
A_{2}B_{4}\right\rangle _{6}\\
&  +A_{4}B_{0}+\left\langle A_{4}B_{2}\right\rangle _{2}+\left\langle
A_{4}B_{2}\right\rangle _{4}+\left\langle A_{4}B_{2}\right\rangle
_{6}+\left\langle A_{4}B_{4}\right\rangle _{0}+\left\langle A_{4}%
B_{4}\right\rangle _{2}+\left\langle A_{4}B_{4}\right\rangle _{4}+\left\langle
A_{4}B_{4}\right\rangle _{6}+\left\langle A_{4}B_{4}\right\rangle _{8}\\
&  -\left(  \left\langle A_{2}B_{2}\right\rangle _{0}+\left\langle A_{2}%
B_{2}\right\rangle _{2}+\left\langle A_{4}B_{2}\right\rangle _{2}+\left\langle
A_{4}B_{2}\right\rangle _{4}\right. \\
&  +\left.  \left\langle A_{2}B_{4}\right\rangle _{2}+\left\langle A_{4}%
B_{4}\right\rangle _{0}+\left\langle A_{4}B_{4}\right\rangle _{2}+\left\langle
A_{4}B_{4}\right\rangle _{4}+\left\langle A_{4}B_{4}\right\rangle _{6}\right)
\end{align}
finally%
\begin{equation}
A\wedge B=A_{0}B_{0}+A_{0}B_{4}+A_{2}B_{0}+A_{0}B_{2}+A_{4}B_{0}+\left\langle
A_{2}B_{2}\right\rangle _{4}+\left\langle A_{2}B_{4}\right\rangle
_{6}+\left\langle A_{4}B_{2}\right\rangle _{6}+\left\langle A_{4}%
B_{4}\right\rangle _{8}.
\end{equation}


An example where $r=2$ using the operator definition of exterior product one
obtains
\begin{align}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert  &
=\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right) \\
\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert  &
=\left(  \frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right) \\
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
+\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert  &
=\frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4},
\end{align}
The operator wedge product gives
\begin{align}
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
\boxtimes\left\vert \varphi_{2}\right\rangle \left\langle \varphi
_{2}\right\vert  &  =\left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle
\left\langle \varphi_{1}\wedge\varphi_{2}\right\vert =\frac{1}{2}\left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert \\
&  =\frac{1}{2}n_{1}n_{2}=\frac{1}{2}\left(  \frac{1}{2}I_{\mathcal{F}}%
+ix_{1}x_{3}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}+ix_{2}x_{4}\right)
=\frac{1}{8}I_{\mathcal{F}}+\frac{i}{4}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
+\frac{1}{2}x_{1}x_{2}x_{3}x_{4}%
\end{align}
i.e.
\begin{align}
&  \left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  \boxtimes\left(  \frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\right) \\
&  =\frac{1}{8}I_{\mathcal{F}}+\frac{i}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +\frac{1}{2}x_{1}x_{2}x_{3}x_{4}.
\end{align}
The Clifford wedge product gives
\[
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
\wedge\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
=\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  \wedge\left(  \frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\right)  =\frac{1}{16}I_{\mathcal{F}},
\]
$\lceil$%
\begin{align}
&  =\left(  \frac{1}{4}I_{\mathcal{F}}\right)  \left(  \frac{1}{4}%
I_{\mathcal{F}}\right)  +\left(  \frac{1}{4}I_{\mathcal{F}}\right)  \left(
-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  +\left(  \frac
{1}{4}I_{\mathcal{F}}\right)  \left(  -x_{1}x_{2}x_{3}x_{4}\right)  +\left(
\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right)  \left(  \frac{1}%
{4}I_{\mathcal{F}}\right) \\
&  +\left(  -x_{1}x_{2}x_{3}x_{4}\right)  \left(  \frac{1}{4}I_{\mathcal{F}%
}\right)  +\left\langle \left(  \frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \right)  \left(  -\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \right)  \right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{i}{8}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}+\frac{i}{8}\left(  x_{1}%
x_{3}-x_{2}x_{4}\right)  -\frac{1}{4}x_{1}x_{2}x_{3}x_{4}+\frac{1}{4}\left(
-x_{1}x_{3}x_{2}x_{4}-x_{2}x_{4}x_{1}x_{3}\right) \\
&  =\frac{1}{16}I_{\mathcal{F}}.
\end{align}
$\rfloor$

$\lceil$Checking this we get%
\[
\left\vert \varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert
\wedge\left\vert \varphi_{2}\right\rangle \left\langle \varphi_{2}\right\vert
=\left(  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  \wedge\left(  \frac{1}%
{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
-x_{1}x_{2}x_{3}x_{4}\right)
\]%
\begin{align}
&  =\left\langle \frac{1}{4}I_{\mathcal{F}}\frac{1}{4}I_{\mathcal{F}%
}\right\rangle _{0}-\left\langle \frac{1}{4}I_{\mathcal{F}}\frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \right\rangle _{2}-\left\langle \frac{1}%
{4}I_{\mathcal{F}}x_{1}x_{2}x_{3}x_{4}\right\rangle _{4}\\
&  +\left\langle \frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \frac{1}%
{4}I_{\mathcal{F}}\right\rangle _{2}-\left\langle \frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)
\right\rangle _{4}-\left\langle \frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  x_{1}x_{2}x_{3}x_{4}\right\rangle _{6}\\
&  -\left\langle x_{1}x_{2}x_{3}x_{4}\frac{1}{4}I_{\mathcal{F}}\right\rangle
_{4}+\left\langle x_{1}x_{2}x_{3}x_{4}\frac{i}{2}\left(  x_{1}x_{3}-x_{2}%
x_{4}\right)  \right\rangle _{6}+\left\langle x_{1}x_{2}x_{3}x_{4}x_{1}%
x_{2}x_{3}x_{4}\right\rangle _{8}%
\end{align}%
\begin{align}
&  =\left\langle \frac{1}{4}I_{\mathcal{F}}\frac{1}{4}I_{\mathcal{F}%
}\right\rangle _{0}-\left\langle \frac{1}{4}I_{\mathcal{F}}\frac{i}{2}\left(
x_{1}x_{3}-x_{2}x_{4}\right)  \right\rangle _{2}+\left\langle \frac{i}%
{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \frac{1}{4}I_{\mathcal{F}%
}\right\rangle _{2}-\left\langle \frac{1}{4}I_{\mathcal{F}}x_{1}x_{2}%
x_{3}x_{4}\right\rangle _{4}-\left\langle x_{1}x_{2}x_{3}x_{4}\frac{1}%
{4}I_{\mathcal{F}}\right\rangle _{4}\\
&  -\left\langle \frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \frac{i}%
{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right\rangle _{4}=\left\langle
\frac{1}{4}I_{\mathcal{F}}\frac{1}{4}I_{\mathcal{F}}\right\rangle
_{0}-\left\langle \frac{1}{2}I_{\mathcal{F}}x_{1}x_{2}x_{3}x_{4}\right\rangle
_{4}-\left\langle \frac{i}{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \frac{i}%
{2}\left(  x_{1}x_{3}-x_{2}x_{4}\right)  \right\rangle _{4}%
\end{align}%
\begin{align}
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{4}\left\langle \left(  x_{1}x_{3}-x_{2}x_{4}\right)  \left(  x_{1}x_{3}%
-x_{2}x_{4}\right)  \right\rangle _{4}=\frac{1}{16}I_{\mathcal{F}}-\frac{1}%
{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}\left\langle x_{1}x_{3}x_{2}x_{4}%
-x_{2}x_{4}x_{1}x_{3}\right\rangle _{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{2}x_{1}x_{2}x_{3}x_{4}=\frac{1}{16}I_{\mathcal{F}}.
\end{align}
$\rfloor$

One can check that $\left\{  n_{1}n_{2},h_{1}n_{2}+h_{2}n_{1},h_{1}%
h_{2}\right\}  $ are mutaully orthogonal projectors onto $\mathcal{H}%
^{0},\mathcal{H}^{1}$ and $\mathcal{H}^{2}$ by noting that
\begin{align*}
n_{1}n_{2}\left\vert \varphi_{1}\varphi_{2}\right\rangle  &  =n_{2}%
n_{1}\left\vert \varphi_{1}\varphi_{2}\right\rangle =\left\vert \varphi
_{1}\varphi_{2}\right\rangle \\
\left(  h_{1}n_{2}+h_{2}n_{1}\right)  \left\vert \varphi_{1}\right\rangle  &
=\left\vert \varphi_{1}\right\rangle \\
\left(  h_{1}n_{2}+h_{2}n_{1}\right)  \left\vert \varphi_{2}\right\rangle  &
=\left\vert \varphi_{2}\right\rangle \\
h_{1}h_{2}\left\vert \phi\right\rangle  &  =\left\vert \phi\right\rangle
\end{align*}%
\begin{align}
\left(  h_{1}n_{2}+h_{2}n_{1}\right)  \left\vert \varphi_{1}\varphi
_{2}\right\rangle  &  =0\\
h_{1}h_{2}\left\vert \varphi_{1}\varphi_{2}\right\rangle  &  =0\\
n_{1}n_{2}\left(  h_{1}n_{2}+h_{2}n_{1}\right)   &  =a_{1}^{\dagger}a_{1}%
a_{2}^{\dagger}a_{2}\left(  a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
+a_{2}a_{2}^{\dagger}a_{1}^{\dagger}a_{1}\right) \\
&  =a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}\left(  a_{2}^{\dagger}a_{2}%
a_{1}a_{1}^{\dagger}+a_{1}^{\dagger}a_{1}a_{2}a_{2}^{\dagger}\right) \\
&  =a_{1}^{\dagger}a_{1}a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
+a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{2}a_{2}^{\dagger}\\
&  =a_{1}^{\dagger}a_{1}\left(  1-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger
}a_{2}+a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}\left(  1-a_{2}^{\dagger}%
a_{2}\right) \\
&  =a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}-a_{1}^{\dagger}a_{1}%
a_{2}^{\dagger}a_{2}+a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}-a_{1}^{\dagger
}a_{1}a_{2}^{\dagger}a_{2}\\
&  =0\\
n_{1}n_{2}h_{1}h_{2}  &  =a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}a_{1}%
a_{1}^{\dagger}a_{2}a_{2}^{\dagger}=a_{1}^{\dagger}a_{2}^{\dagger}a_{2}%
a_{1}a_{1}a_{1}^{\dagger}a_{2}a_{2}^{\dagger}=0.
\end{align}


\paragraph{Wedge Products}%

\begin{align}
\left\vert \phi\right\rangle \left\langle \phi\right\vert  &  =h_{1}%
h_{2}=\left\{  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right\}  \left\{
\frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right\}  =\frac{1}{4}I_{\mathcal{F}%
}-\frac{1}{2}ix_{1}x_{3}-\frac{1}{2}ix_{2}x_{4}-x_{1}x_{3}x_{2}x_{4}\\
\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert  &
=h_{2}a_{1}^{\dagger}=\left\{  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right\}
\frac{1}{\sqrt{2}}\left(  x_{1}-ix_{3}\right)  =\frac{1}{2\sqrt{2}}\left(
x_{1}-ix_{3}-ix_{2}x_{4}x_{1}\right)  -\frac{1}{2}x_{2}x_{4}x_{3}\\
\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert  &
=h_{1}a_{2}^{\dagger}=\left\{  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right\}
\frac{1}{\sqrt{2}}\left(  x_{2}-ix_{4}\right)  =\frac{1}{2\sqrt{2}}\left(
x_{2}-ix_{4}-ix_{1}x_{3}x_{2}\right)  -\frac{1}{2}x_{1}x_{3}x_{4}\\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \phi\right\vert
&  =a_{1}^{\dagger}a_{2}^{\dagger}=\frac{1}{2}\left(  x_{1}-ix_{3}\right)
\left(  x_{2}-ix_{4}\right)  =\frac{1}{2}\left(  x_{1}x_{2}-ix_{3}x_{2}%
-ix_{1}x_{4}-x_{3}x_{4}\right)
\end{align}
in the underlying Hilbert space in terms of Operators%
\begin{align}
&  \left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert
\wedge\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert
=\left\vert \varphi_{1}\wedge\varphi_{2}\right\rangle \left\langle \phi
\wedge\phi\right\vert =\frac{1}{2}\left\vert \varphi_{1}\varphi_{2}%
\right\rangle \left\langle \phi\phi\right\vert \\
&  =\left(  \frac{1}{2\sqrt{2}}\left(  x_{1}-ix_{3}-ix_{2}x_{4}x_{1}\right)
-\frac{1}{2}x_{2}x_{4}x_{3}\right)  \wedge\left(  \frac{1}{2\sqrt{2}}\left(
x_{2}-ix_{4}-ix_{1}x_{3}x_{2}\right)  -\frac{1}{2}x_{1}x_{3}x_{4}\right) \\
&  =\frac{1}{8}\left(  x_{1}-ix_{3}-ix_{2}x_{4}x_{1}\right)  \wedge\left(
x_{2}-ix_{4}-ix_{1}x_{3}x_{2}\right) \\
&  =\frac{1}{8}\left(  x_{1}-ix_{3}-ix_{2}x_{4}x_{1}\right)  \wedge
x_{2}-\frac{1}{8}\left(  x_{1}-ix_{3}-ix_{2}x_{4}x_{1}\right)  \wedge
ix_{4}-\frac{1}{8}\left(  x_{1}-ix_{3}-ix_{2}x_{4}x_{1}\right)  \wedge
ix_{1}x_{3}x_{2}\\
&  =\frac{1}{8}\left(  x_{1}x_{2}-ix_{3}x_{2}-ix_{1}x_{4}-x_{3}x_{4}\right)
\end{align}%
\begin{align}
\frac{1}{2}\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\phi\phi\right\vert  &  =\frac{1}{8}\left(  x_{1}x_{2}-ix_{3}x_{2}-ix_{1}%
x_{4}-x_{3}x_{4}\right) \\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \phi
\phi\right\vert  &  =\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \phi\right\vert =\frac{1}{4}\left(  x_{1}x_{2}-ix_{3}x_{2}%
-ix_{1}x_{4}-x_{3}x_{4}\right)  ,
\end{align}
where we have insisted that
\begin{align}
\left\vert \phi\phi\right\rangle  &  =\left\vert \phi\right\rangle \\
\left\vert \phi\phi\right\rangle  &  =\sqrt{2}\left\vert \phi\wedge
\phi\right\rangle .
\end{align}
$\lceil$%
\begin{align}
n_{1}  &  =a_{1}^{\dagger}a_{1}=\frac{1}{\sqrt{2}}\left(  x_{1}-ix_{3}\right)
\frac{1}{\sqrt{2}}\left(  x_{1}+ix_{3}\right) \\
&  =\frac{1}{2}\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}-ix_{3}%
x_{1}+\frac{1}{2}I_{\mathcal{F}}\right)  =\frac{1}{2}\left(  I_{\mathcal{F}%
}+2ix_{1}x_{3}\right)  =\frac{1}{2}I_{\mathcal{F}}+ix_{1}x_{3}\\
h_{1}  &  =I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}=I_{\mathcal{F}}-n_{1}=\frac
{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}%
\end{align}
$\rfloor$%
\begin{align}
\left\vert \phi\right\rangle \left\langle \phi\right\vert \left\vert
\phi\right\rangle  &  =h_{1}h_{2}\left\vert \phi\right\rangle =\left\vert
\phi\right\rangle \\
\left\vert \phi\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{1}\right\rangle  &  =h_{1}h_{2}\left\vert \varphi_{1}\right\rangle
=0\\
\left\vert \phi\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{2}\right\rangle  &  =h_{1}h_{2}\left\vert \varphi_{2}\right\rangle
=0\\
\left\vert \phi\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =h_{1}h_{2}\left\vert \varphi
_{1}\varphi_{2}\right\rangle =0
\end{align}%
\begin{align}
\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert \left\vert
\phi\right\rangle  &  =h_{2}a_{1}^{\dagger}\left\vert \phi\right\rangle
=\left\vert \varphi_{1}\right\rangle \\
\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{1}\right\rangle  &  =h_{2}a_{1}^{\dagger}\left\vert \varphi
_{1}\right\rangle =0\\
\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{2}\right\rangle  &  =h_{2}a_{1}^{\dagger}\left\vert \varphi
_{2}\right\rangle =0\\
\left\vert \varphi_{1}\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =h_{2}a_{1}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\right\rangle =0
\end{align}%
\begin{align}
\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert \left\vert
\phi\right\rangle  &  =h_{1}a_{2}^{\dagger}\left\vert \phi\right\rangle
=\left\vert \varphi_{2}\right\rangle \\
\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{1}\right\rangle  &  =h_{1}a_{2}^{\dagger}\left\vert \varphi
_{1}\right\rangle =0\\
\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{2}\right\rangle  &  =h_{1}a_{2}^{\dagger}\left\vert \varphi
_{2}\right\rangle =0\\
\left\vert \varphi_{2}\right\rangle \left\langle \phi\right\vert \left\vert
\varphi_{1}\varphi_{2}\right\rangle  &  =h_{1}a_{2}^{\dagger}\left\vert
\varphi_{1}\varphi_{2}\right\rangle =0
\end{align}%
\begin{align}
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \phi\right\vert
\left\vert \phi\right\rangle  &  =a_{1}^{\dagger}a_{2}^{\dagger}\left\vert
\phi\right\rangle =\left\vert \varphi_{1}\varphi_{2}\right\rangle \\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \phi\right\vert
\left\vert \varphi_{1}\right\rangle  &  =a_{1}^{\dagger}a_{2}^{\dagger
}\left\vert \varphi_{1}\right\rangle =0\\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \phi\right\vert
\left\vert \varphi_{2}\right\rangle  &  =a_{1}^{\dagger}a_{2}^{\dagger
}\left\vert \varphi_{2}\right\rangle =0\\
\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle \phi\right\vert
\left\vert \varphi_{1}\varphi_{2}\right\rangle  &  =a_{1}^{\dagger}%
a_{2}^{\dagger}\left\vert \varphi_{1}\varphi_{2}\right\rangle =0
\end{align}


The square of $P_{0}$ is given by
\begin{align}
P_{0}^{2}  &  =\left(  \frac{1}{4}I_{\mathcal{F}}-\left(  \frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  \right)  \left(
\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  \left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  \right) \\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{1}{2}\left(  \frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)  +\left(  \frac
{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  -x_{1}x_{2}x_{3}x_{4}\right)
^{2}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{i}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +\frac{1}{2}x_{1}x_{2}x_{3}x_{4}\\
&  -\frac{1}{4}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  ^{2}-\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  x_{1}x_{2}x_{3}x_{4}-\frac{i}{2}x_{1}x_{2}%
x_{3}x_{4}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}%
x_{1}x_{2}x_{3}x_{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{i}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +\frac{1}{2}x_{1}x_{2}x_{3}x_{4}\\
&
\begin{array}
[c]{c}%
-\frac{1}{4}\left(  x_{1}x_{3}x_{1}x_{3}+x_{1}x_{3}x_{2}x_{4}+x_{2}x_{4}%
x_{1}x_{3}+x_{2}x_{4}x_{2}x_{4}\right)  -\frac{i}{2}x_{1}x_{3}x_{1}x_{2}%
x_{3}x_{4}-\frac{i}{2}x_{2}x_{4}x_{1}x_{2}x_{3}x_{4}-\frac{i}{2}x_{1}%
x_{2}x_{3}x_{4}x_{1}x_{3}\\
-\frac{i}{2}x_{1}x_{2}x_{3}x_{4}x_{2}x_{4}+x_{1}x_{2}x_{3}x_{4}x_{1}x_{2}%
x_{3}x_{4}%
\end{array}
\\
&  =\frac{1}{16}I_{\mathcal{F}}-\frac{i}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +\frac{1}{2}x_{1}x_{2}x_{3}x_{4}\\
&  +\frac{1}{8}I_{\mathcal{F}}+\frac{1}{2}x_{1}x_{2}x_{3}x_{4}-i\frac{1}%
{4}x_{2}x_{4}-i\frac{1}{4}x_{1}x_{3}+\frac{1}{16}I_{\mathcal{F}}\\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}=P_{0},
\end{align}
which shows that $P_{0}$ is indeed idempotent.

$P_{0}$ can also be expressed in terms of creators and annihilators as
\begin{equation}
P_{0}=h_{1}h_{2}=\left(  I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}\right)  \left(
I_{\mathcal{F}}-a_{2}^{\dagger}a_{2}\right)  =I_{\mathcal{F}}-a_{1}^{\dagger
}a_{1}-a_{2}^{\dagger}a_{2}+a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}.
\end{equation}


The square of $P_{1}$ is given by
\begin{align}
&  \left(  \frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}\right)  \left(
\frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}+4x_{1}x_{2}x_{3}x_{4}x_{1}x_{2}%
x_{3}x_{4}\\
&  =\frac{1}{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}+4x_{1}x_{1}x_{2}%
x_{2}x_{3}x_{3}x_{4}x_{4}=\frac{1}{4}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}%
x_{4}+4\frac{1}{16}\\
&  =\frac{1}{2}I_{\mathcal{F}}-2x_{1}x_{2}x_{3}x_{4}%
\end{align}
i.e.
\begin{equation}
P_{1}^{2}=P_{1}.
\end{equation}
On the other hand
\begin{align}
P_{1}^{2}  &  =\left(  h_{1}n_{2}+h_{2}n_{1}\right)  \left(  h_{1}n_{2}%
+h_{2}n_{1}\right)  =h_{1}^{2}n_{2}^{2}+h_{1}n_{2}h_{2}n_{1}+h_{2}n_{1}%
h_{1}n_{2}+h_{2}^{2}n_{1}^{2}\\
&  =h_{1}n_{2}+2h_{1}h_{2}n_{1}n_{2}+h_{2}n_{1}\\
&  =a_{1}a_{1}^{\dagger}a_{2}^{\dagger}a_{2}+2a_{1}a_{1}^{\dagger}a_{2}%
a_{2}^{\dagger}a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}+a_{2}a_{2}^{\dagger
}a_{1}^{\dagger}a_{1}\\
&  =\left(  I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}\right)  a_{2}^{\dagger}%
a_{2}+2\left(  I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}\right)  \left(
I_{\mathcal{F}}-a_{2}^{\dagger}a_{2}\right)  a_{1}^{\dagger}a_{1}%
a_{2}^{\dagger}a_{2}+\left(  I_{\mathcal{F}}-a_{2}^{\dagger}a_{2}\right)
a_{1}^{\dagger}a_{1}\\
&  =a_{2}^{\dagger}a_{2}-a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}%
+2a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}-2a_{1}^{\dagger}a_{1}a_{1}%
^{\dagger}a_{1}a_{2}^{\dagger}a_{2}-2a_{2}^{\dagger}a_{2}a_{1}^{\dagger}%
a_{1}a_{2}^{\dagger}a_{2}+2a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}%
a_{1}^{\dagger}a_{1}a_{2}^{\dagger}a_{2}+a_{1}^{\dagger}a_{1}-a_{2}^{\dagger
}a_{2}a_{1}^{\dagger}a_{1}\\
&  =a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}a_{2}-2a_{1}^{\dagger}a_{2}^{\dagger
}a_{2}a_{1}%
\end{align}
comparing this to $P_{1}$
\begin{equation}
h_{1}n_{2}+h_{2}n_{1}=\left(  I_{\mathcal{F}}-a_{1}^{\dagger}a_{1}\right)
a_{2}^{\dagger}a_{2}+\left(  I_{\mathcal{F}}-a_{2}^{\dagger}a_{2}\right)
a_{1}^{\dagger}a_{1}=a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}a_{2}-2a_{1}%
^{\dagger}a_{1}a_{2}^{\dagger}a_{2}=a_{1}^{\dagger}a_{1}+a_{2}^{\dagger}%
a_{2}-2a_{1}^{\dagger}a_{2}^{\dagger}a_{2}a_{1}%
\end{equation}
one sees that this is another proof of idempotence.

The square of $P_{2}$ is given by
\begin{align}
P_{2}^{2}  &  =\left(  \frac{1}{4}I_{\mathcal{F}}+\left(  \frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)  \right)  \left(
\frac{1}{4}I_{\mathcal{F}}+\left(  \frac{i}{2}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)  \right) \\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{1}{2}\left(  \frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)  +\left(  \frac
{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)
^{2}\\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +\frac{1}{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}\left(  x_{1}%
x_{3}+x_{2}x_{4}\right)  ^{2}+\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
x_{1}x_{2}x_{3}x_{4}\\
&  +\frac{i}{2}x_{1}x_{2}x_{3}x_{4}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
+x_{1}x_{2}x_{3}x_{4}x_{1}x_{2}x_{3}x_{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{4}\left(  x_{1}x_{3}+x_{2}%
x_{4}\right)  +\frac{1}{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}{4}x_{1}x_{3}x_{1}%
x_{3}-\frac{1}{4}x_{2}x_{4}x_{1}x_{3}\\
&  -\frac{1}{4}x_{1}x_{3}x_{2}x_{4}-\frac{1}{4}x_{2}x_{4}x_{2}x_{4}+\frac
{i}{2}x_{1}x_{3}x_{1}x_{2}x_{3}x_{4}+\frac{i}{2}x_{2}x_{4}x_{1}x_{2}x_{3}%
x_{4}\\
&  +\frac{i}{2}x_{1}x_{2}x_{3}x_{4}x_{1}x_{3}+\frac{i}{2}x_{1}x_{2}x_{3}%
x_{4}x_{2}x_{4}+x_{1}x_{2}x_{3}x_{4}x_{1}x_{2}x_{3}x_{4}\\
&  =\frac{1}{16}I_{\mathcal{F}}+\frac{i}{4}x_{1}x_{3}+\frac{i}{4}x_{2}%
x_{4}+\frac{1}{2}x_{1}x_{2}x_{3}x_{4}+\frac{1}{16}I_{\mathcal{F}}+\frac{1}%
{2}x_{1}x_{2}x_{3}x_{4}-\frac{1}{16}x_{1}x_{2}x_{3}x_{4}+\frac{1}%
{16}I_{\mathcal{F}}\\
&  +\frac{i}{8}x_{2}x_{4}+\frac{i}{8}x_{1}x_{3}+\frac{i}{8}x_{2}x_{4}+\frac
{i}{8}x_{1}x_{3}+\frac{1}{16}I_{\mathcal{F}}\\
&  =\frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}x_{1}x_{3}+\frac{i}{2}x_{2}%
x_{4}+x_{1}x_{2}x_{3}x_{4}=P_{2}.
\end{align}


The wedge product of the projector $P_{0}$ with itself can be expressed as
\begin{align}
P_{0}\wedge P_{0}  &  =\left(  \frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}\right)  \wedge\left(
\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(  x_{1}x_{3}+x_{2}x_{4}\right)
+x_{1}x_{2}x_{3}x_{4}\right) \\
&  =h_{1}\wedge h_{2}\wedge h_{1}\wedge h_{2}=\left(  h_{1}\wedge
h_{2}\right)  ^{2\wedge}=P_{0}^{2\wedge}.
\end{align}
Using the following properties of $h_{1}$ and $h_{2}$ one can deduce that
\begin{equation}
P_{0}=P_{0}^{2\wedge}.
\end{equation}


The properties of $h_{1}$ and $h_{2}$ that are useful are:

\begin{enumerate}
\item
\begin{align}
h_{1}^{2}  &  =h_{1}\\
h_{1}\wedge h_{1}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  =\frac{1}%
{4}\left\langle I_{\mathcal{F}}\right\rangle _{0}-i\left\langle x_{1}%
x_{3}\right\rangle _{2}+\left\langle x_{1}^{2}x_{3}^{2}\right\rangle _{4}\\
&  =\frac{1}{4}\left\langle I_{\mathcal{F}}\right\rangle _{0}-i\left\langle
x_{1}x_{3}\right\rangle _{2}=\frac{1}{4}I_{\mathcal{F}}-ix_{1}x_{3}%
=h_{1}-\frac{1}{4}I_{\mathcal{F}}\neq h_{1}%
\end{align}


\item
\begin{equation}
\left[  h_{1},h_{2}\right]  =0
\end{equation}


\item
\begin{align}
\left(  h_{1}h_{2}\right)  ^{2}  &  =h_{1}^{2}h_{2}^{2}=\left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  ^{2}\left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{4}\right)  ^{2}\\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}{2}I_{\mathcal{F}%
}-ix_{2}x_{4}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-ix_{1}x_{3}-x_{1}x_{3}x_{1}%
x_{3}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}-x_{2}x_{4}%
x_{2}x_{4}\right) \\
&  =\left(  \frac{1}{4}I_{\mathcal{F}}-ix_{1}x_{3}+\frac{1}{4}I_{\mathcal{F}%
}\right)  \left(  \frac{1}{4}I_{\mathcal{F}}-ix_{2}x_{4}+\frac{1}%
{4}I_{\mathcal{F}}\right) \\
&  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)  \left(  \frac{1}%
{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}%
{2}x_{1}x_{3}-\frac{i}{2}x_{2}x_{4}+x_{1}x_{2}x_{3}x_{4}=h_{1}h_{2}.
\end{align}


\item
\begin{align}
h_{1}\wedge h_{2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{1}x_{3}\right)
\wedge\left(  \frac{1}{2}I_{\mathcal{F}}-ix_{2}x_{4}\right)  =\frac{1}%
{4}I_{\mathcal{F}}\wedge I_{\mathcal{F}}-\frac{i}{2}x_{1}x_{3}\wedge
I_{\mathcal{F}}-\frac{i}{2}I_{\mathcal{F}}\wedge x_{1}x_{3}-x_{1}x_{3}\wedge
x_{2}x_{4}\\
&  =\frac{1}{4}\left\langle I_{\mathcal{F}}I_{\mathcal{F}}\right\rangle
_{0}-\frac{i}{2}\left\langle x_{1}x_{3}I_{\mathcal{F}}\right\rangle _{2}%
-\frac{i}{2}\left\langle I_{\mathcal{F}}x_{2}x_{4}\right\rangle _{2}%
-\left\langle x_{1}x_{3}x_{2}x_{4}\right\rangle _{4}\\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}x_{1}x_{3}-\frac{i}{2}x_{2}%
x_{4}+x_{1}x_{2}x_{3}x_{4}=\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}\left(
x_{1}x_{3}+x_{2}x_{4}\right)  +x_{1}x_{2}x_{3}x_{4}.
\end{align}

\end{enumerate}

Hence
\begin{equation}
h_{1}h_{2}=h_{1}\wedge h_{2}.
\end{equation}
This gives
\begin{align}
h_{1}\wedge h_{2}\wedge h_{1}\wedge h_{2}  &  =\left(  h_{1}h_{2}\right)
\wedge\left(  h_{1}h_{2}\right)  =\sum_{0\leq p,q\leq4}\left\langle
h_{1p}h_{2q}\right\rangle _{p+q}\text{ , }\left[  \text{as }\left(  h_{1}%
h_{2}\right)  ^{2}=h_{1}h_{2}\right] \\
&  =\left\langle \frac{1}{4}I_{\mathcal{F}}^{2}\right\rangle _{0}+\left\langle
\frac{1}{2}I_{\mathcal{F}}\left(  ix_{2}x_{4}\right)  \right\rangle
_{2}+\left\langle \left(  -ix_{1}x_{3}\right)  \frac{1}{2}I_{\mathcal{F}%
}\right\rangle _{2}+\left\langle \frac{{}}{{}}\left(  -ix_{1}x_{3}\right)
\left(  -ix_{2}x_{4}\right)  \right\rangle _{4}\\
&  =\frac{1}{4}I_{\mathcal{F}}-\frac{i}{2}x_{1}x_{3}-\frac{i}{2}x_{2}%
x_{4}+x_{1}x_{2}x_{3}x_{4}=h_{1}\wedge h_{2},
\end{align}
i.e.
\begin{equation}
\left(  h_{1}\wedge h_{2}\right)  ^{2\wedge}=h_{1}\wedge h_{2}\equiv
P_{0}\wedge P_{0}=P_{0}.
\end{equation}
(Note that we cannot commute around "$\wedge"$ automatically using
\begin{equation}
\left\langle A\right\rangle _{p}\wedge\left\langle B\right\rangle _{q}=\left(
-1\right)  ^{pq}\left\langle B\right\rangle _{q}\wedge\left\langle
A\right\rangle _{p}%
\end{equation}
unless the terms are homogeneous, $h_{1},h_{2}$ and $h_{1}h_{2}$ are not
homogeneous.$\rfloor$%

