\section{Representations of Clifford Algebras}

The Pauli matrices are%
\begin{align}
\mathbb{\sigma}_{0}  &  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  =\mathbb{I}_{2}=\left\vert 1\right\rangle \left\langle 1\right\vert
+\left\vert 2\right\rangle \left\langle 2\right\vert =\left\vert
h\right\rangle \left\langle h\right\vert +\left\vert p\right\rangle
\left\langle p\right\vert \\
\mathbb{\sigma}_{1}  &  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  =\mathbb{\sigma}_{x}=\left\vert 1\right\rangle \left\langle
2\right\vert +\left\vert 2\right\rangle \left\langle 1\right\vert =\left\vert
h\right\rangle \left\langle p\right\vert +\left\vert p\right\rangle
\left\langle h\right\vert \\
\mathbb{\sigma}_{2}  &  =\left(
\begin{array}
[c]{cc}%
0 & -i\\
i & 0
\end{array}
\right)  =\mathbb{\sigma}_{y}=i\left(  \left\vert 2\right\rangle \left\langle
1\right\vert -\left\vert 1\right\rangle \left\langle 2\right\vert \right)
=i\left(  \left\vert p\right\rangle \left\langle h\right\vert -\left\vert
h\right\rangle \left\langle p\right\vert \right) \\
\mathbb{\sigma}_{3}  &  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & -1
\end{array}
\right)  =\mathbb{\sigma}_{z}=\left\vert 1\right\rangle \left\langle
1\right\vert -\left\vert 2\right\rangle \left\langle 2\right\vert =\left\vert
h\right\rangle \left\langle h\right\vert -\left\vert p\right\rangle
\left\langle p\right\vert ,
\end{align}
where
\begin{align}
\left\vert h\right\rangle  &  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right) \\
\left\vert p\right\rangle  &  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  .
\end{align}


Representations of the complex Clifford algebras in terms of tensor products
of the Pauli matrices are given by the isomorphisms
\begin{align}
\operatorname*{Cl}\left(  2r,\mathbb{C}\right)   &  \simeq M\left(
2^{r},\mathbb{C}\right) \\
\operatorname*{Cl}\left(  2r-1,\mathbb{C}\right)   &  \simeq M\left(
2^{r-1},\mathbb{C}\right)  \oplus M\left(  2^{r-1},\mathbb{C}\right)  ,
\end{align}
where
\begin{align}
M\left(  2^{r},\mathbb{C}\right)   &  :\mathbb{C}^{2^{r}}\rightarrow
\mathbb{C}^{2^{r}}\\
\mathbb{C}^{2r}  &  \simeq\,\overset{\text{r-times}}{\overbrace{\,\,\mathbb{C}%
^{2}\otimes\cdots\otimes\mathbb{C}^{2}}}\\
\dim\left\{  \operatorname*{Cl}\left(  2r,\mathbb{C}\right)  \right\}   &
=2^{2r}.
\end{align}
In the case of the Clifford algebra formed by the Fock algebra $\mathcal{F}$
this leads to the \emph{Jordan-Wigner isomorphisms }%
\begin{align}
JW  &  :\mathcal{F}\longrightarrow M\left(  2^{r},\mathbb{C}\right) \\
jw  &  :\mathcal{H}_{\mathcal{F}}\longrightarrow\mathbb{C}^{2^{r}}.
\end{align}
The space $\mathbb{C}^{2^{r}}$ does not have any intrinsic antisymmetric
structure but various graded structures can be imposed on it. The Clifford
product in $M\left(  2^{r},\mathbb{C}\right)  $ is the matrix product, but the
exterior (wedge) product does not obviously correspond to an antisymmetric
product in $\mathbb{C}^{2^{r}}.$

We can define annihilation and creation operators belonging to $%
%TCIMACRO{\dbigotimes \limits^{r}}%
%BeginExpansion
{\displaystyle\bigotimes\limits^{r}}
%EndExpansion
M\left(  2,\mathbb{C}\right)  ,$ by
\begin{align}
a_{k}  &  =%
%TCIMACRO{\dbigotimes \limits_{1\leq j\leq k-1}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{1\leq j\leq k-1}}
%EndExpansion
\mathbb{\sigma}_{z}\otimes a\otimes%
%TCIMACRO{\dbigotimes \limits_{k+1\leq j\leq r}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{k+1\leq j\leq r}}
%EndExpansion
\mathbb{I}_{2}=\overset{j-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes
\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes
\overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\nonumber\\
1  &  \leq k\leq r,
\end{align}
where
\begin{equation}
a=\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  .
\end{equation}
Note that
\begin{align}
\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \equiv a\left\vert p\right\rangle =\left\vert h\right\rangle \\
\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  \equiv a^{\dagger}\left\vert h\right\rangle =\left\vert
p\right\rangle \\
\left(
\begin{array}
[c]{cc}%
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \equiv a\left\vert h\right\rangle =0\\
\left(
\begin{array}
[c]{cc}%
0 & 0\\
1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)   &  =\left(
\begin{array}
[c]{c}%
0\\
0
\end{array}
\right)  \equiv a^{\dagger}\left\vert p\right\rangle =0.
\end{align}


A Clifford basis in terms of \emph{Majorano Spinors }is given by
\begin{align}
x_{k}  &  =\frac{1}{\sqrt{2}}\left(  a_{k}^{\dagger}+a_{k}\right) \nonumber\\
&  =\frac{1}{\sqrt{2}}\left(  \overset{j-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a^{\dagger}%
\otimes\overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes
\mathbb{I}_{2}}}+\,\overset{j-1}{\,\overbrace{\,\mathbb{\sigma}_{z}%
\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes a\otimes
\overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots\otimes\mathbb{I}_{2}}%
}\right) \nonumber\\
&  =\frac{1}{\sqrt{2}}\left(  \overset{j-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\otimes\left(  a^{\dagger
}+a\right)  \otimes\overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes
\cdots\otimes\mathbb{I}_{2}}}\right) \nonumber\\
&  =\frac{1}{\sqrt{2}}\left(  \overset{j-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right) \nonumber\\
x_{k+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-ia_{k}\right)
=\frac{i}{\sqrt{2}}\left(  \overset{j-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(  a^{\dagger
}-ia\right)  \overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right) \nonumber\\
&  =\frac{i}{\sqrt{2}}\left(  \overset{j-1}{\,\overbrace{\,\mathbb{\sigma}%
_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & -i\\
1 & 0
\end{array}
\right)  \otimes\overset{r-j}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  ,
\end{align}
e.g. $r=1$%
\begin{align}
x_{1}  &  =\frac{1}{\sqrt{2}}\left(
\overset{1-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{1-1}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{1}{\sqrt{2}}\left(  a^{\dagger
}+\,a\right) \\
x_{2}  &  =\frac{i}{\sqrt{2}}\left(  \overset{1-1}{\overbrace{\mathbb{\sigma
}_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\otimes\left(  a^{\dagger
}-a\right)  \otimes\overset{1-1}{\overbrace{\,\mathbb{I}_{2}\otimes
\cdots\otimes\mathbb{I}_{2}}}\right)  =\frac{i}{\sqrt{2}}\left(  a^{\dagger
}-a\right)
\end{align}


and $r=2$%
\begin{align}
x_{1}  &  =\frac{1}{\sqrt{2}}\left(
\overset{1-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{2-1}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{1}{\sqrt{2}}\left(  a^{\dagger}%
\otimes\,\mathbb{I}_{2}+a\otimes\,\mathbb{I}_{2}\right) \nonumber\\
x_{2}  &  =\frac{1}{\sqrt{2}}\left(
\overset{2-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & 1\\
1 & 0
\end{array}
\right)  \otimes\overset{2-2}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{1}{\sqrt{2}}\left(  \mathbb{\sigma}%
_{z}\otimes a^{\dagger}+\,\mathbb{\sigma}_{z}\otimes a\right) \nonumber\\
x_{3}  &  =\frac{i}{\sqrt{2}}\left(
\overset{1-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & -i\\
1 & 0
\end{array}
\right)  \otimes\overset{2-1}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{i}{\sqrt{2}}\left(  a^{\dagger}%
\otimes\mathbb{I}_{2}-a\otimes\mathbb{I}_{2}\right) \nonumber\\
x_{4}  &  =\frac{i}{\sqrt{2}}\left(
\overset{2-1}{\,\overbrace{\,\mathbb{\sigma}_{z}\otimes\cdots\otimes
\mathbb{\sigma}_{z}}}\otimes\left(
\begin{array}
[c]{cc}%
0 & -i\\
1 & 0
\end{array}
\right)  \otimes\overset{2-2}{\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\right)  =\frac{i}{\sqrt{2}}\left(  \mathbb{\sigma}%
_{z}\otimes a^{\dagger}-\mathbb{\sigma}_{z}\otimes a\right)
\end{align}


\subsubsection{Examples}

\paragraph{r=1 then}

\subparagraph{ even}

This is the algebra generated by the Pauli matrices themselves i.e.%
\begin{align}
\operatorname*{Cl}\left(  2,\mathbb{C}\right)   &  \simeq M\left(
2,\mathbb{C}\right) \\
M\left(  2,\mathbb{C}\right)   &  :\mathbb{C}^{2}\rightarrow\mathbb{C}^{2}%
\end{align}%
\begin{align}
a_{1}  &  =\,\overset{1-1}{\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\otimes a\otimes\overset{0}{\overbrace{\mathbb{\sigma
}_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\,=a\\
a_{1}^{\dagger}  &  =\overset{1-1}{\overbrace{\,\mathbb{I}_{2}\otimes
\cdots\otimes\mathbb{I}_{2}}}\otimes a^{\dagger}\otimes
\overset{0}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots\otimes\mathbb{\sigma
}_{z}}}\,=a^{\dagger}.
\end{align}


\subparagraph{odd%
\begin{equation}
\operatorname*{Cl}\left(  1,\mathbb{C}\right)  \simeq M\left(  2^{0}%
,\mathbb{C}\right)  \oplus M\left(  2^{0},\mathbb{C}\right)  \simeq
\mathbb{C}\oplus\mathbb{C},
\end{equation}
}

\paragraph{r=2 then}

\subparagraph{even}%

\begin{align}
\operatorname*{Cl}\left(  4,\mathbb{C}\right)   &  \simeq M\left(
4,\mathbb{C}\right) \\
M\left(  4,\mathbb{C}\right)   &  :\mathbb{C}^{4}\rightarrow\mathbb{C}^{4}%
\end{align}


\bigskip

The creators and annihilators are given by
\begin{align}
a_{1}  &  =\,\overset{2-1-0}{\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\otimes a\otimes\overset{0}{\overbrace{\mathbb{\sigma
}_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\,=\mathbb{I}_{2}\otimes a\\
a_{1}^{\dagger}  &  =\,\overset{2-1-0}{\overbrace{\,\mathbb{I}_{2}%
\otimes\cdots\otimes\mathbb{I}_{2}}}\otimes a^{\dagger}\otimes
\overset{0}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots\otimes\mathbb{\sigma
}_{z}}}\,=\mathbb{I}_{2}\otimes a^{\dagger}.
\end{align}%
\begin{align}
a_{2}  &  =\,\overset{2-1-1}{\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}\otimes a\otimes\overset{1}{\overbrace{\mathbb{\sigma
}_{z}\otimes\cdots\otimes\mathbb{\sigma}_{z}}}\,=a\otimes\mathbb{\sigma}_{z}\\
a_{2}^{\dagger}  &  =\,\overset{2-1-1}{\overbrace{\,\mathbb{I}_{2}%
\otimes\cdots\otimes\mathbb{I}_{2}}}\otimes a^{\dagger}\otimes
\overset{1}{\overbrace{\mathbb{\sigma}_{z}\otimes\cdots\otimes\mathbb{\sigma
}_{z}}}\,=a^{\dagger}\otimes\mathbb{\sigma}_{z}.
\end{align}
The dimensions of the associated Fock space is
\begin{equation}
\dim\left\{  \mathcal{H}_{\mathcal{F}}\right\}  =4=1+2+1=2^{2}=2^{r}%
\end{equation}
and Fock algebra is
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =16=\left(  2^{2}\right)  ^{2}=\left(
2^{r}\right)  ^{2}=2^{4}=2^{2r},
\end{equation}
as the number of degrees of freedom $\dim\left\{  \mathcal{H}^{1}\right\}
=r=2.$The scalar product is of rank $=2$. The dimension of the Clifford
algebra is thus $2$ and thus represented by matrices of order $2^{2}=4.$

\subparagraph{odd%
\begin{equation}
\operatorname*{Cl}\left(  3,\mathbb{C}\right)  \simeq M\left(  2,\mathbb{C}%
\right)  \oplus M\left(  2,\mathbb{C}\right)  .
\end{equation}
}

The identity element of $M\left(  2^{r},\mathbb{C}\right)  $ is given%

\begin{equation}
\mathbb{I}_{2r}=\overset{r}{\,\,\overbrace{\mathbb{I}_{2}\otimes\cdots
\otimes\mathbb{I}_{2}}}.
\end{equation}


\subsection{Fock Space Representations}

A basis for a Fock representation of the Clifford Algebra $\operatorname*{Cl}%
\left(  2r,\mathbb{C}\right)  \cong\mathcal{F}$ is given by a representation
of a basis set of majorana spinors belonging to $M\left(  2^{r},\mathbb{C}%
\right)  $
\begin{equation}
I_{\mathcal{F}},x_{j_{1}},x_{j_{1}}x_{j_{2}},\cdots,x_{j_{1}}\cdots x_{j_{2r}%
};1\leq j_{1}<\cdots<j_{2r}\leq2r.
\end{equation}
The number of basis elements and thus dimension of $\mathcal{F}$ is
\begin{equation}
2^{2r}=\sum_{0\leq j\leq2r}\binom{2r}{j}.
\end{equation}


\subsubsection{ Examples}

For $r=0$ the basis of $\mathcal{F}$ is
\begin{equation}
I_{\mathcal{F}}%
\end{equation}%
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{0}=1
\end{equation}


and
\begin{equation}
\mathcal{F}\cong M\left(  1,\mathbb{C}\right)  \cong\mathbb{C}.
\end{equation}
For $r=1$ the basis of $\mathcal{F}$ is
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{2}=4
\end{equation}


and
\begin{equation}
\mathcal{F}\cong M\left(  2,\mathbb{C}\right)  .
\end{equation}


For $r=2$ the basis of $\mathcal{F}$ is
\begin{equation}
I_{\mathcal{F}},x_{1},x_{2},x_{3},x_{4},x_{1}x_{2},x_{1}x_{3},x_{1}x_{4}%
,x_{2}x_{3},x_{2}x_{4},x_{3}x_{4},x_{1}x_{2}x_{3},x_{1}x_{2}x_{4},x_{1}%
x_{3}x_{4},x_{2}x_{3}x_{4},x_{1}x_{2}x_{3}x_{4}%
\end{equation}%
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{4}=16
\end{equation}


and
\begin{equation}
\mathcal{F}\cong M\left(  4,\mathbb{C}\right)  .
\end{equation}


For $r=3$ the basis of $\mathcal{F}$ is
\begin{align}
&  I_{\mathcal{F}},x_{1},x_{2},x_{3},x_{4},x_{5},x_{6},\nonumber\\
&  x_{1}x_{2},x_{1}x_{3},x_{1}x_{4},x_{1}x_{5},x_{1}x_{6},x_{2}x_{3}%
,x_{2}x_{4},x_{2}x_{5},x_{2}x_{6},x_{3}x_{4},x_{3}x_{5},x_{3}x_{6},x_{4}%
x_{5},x_{4}x_{6},x_{5}x_{6},\nonumber\\
&  x_{1}x_{2}x_{3},x_{1}x_{2}x_{4},x_{1}x_{2}x_{5},x_{1}x_{2}x_{6},x_{1}%
x_{3}x_{4},x_{1}x_{3}x_{5},x_{1}x_{3}x_{6},x_{2}x_{3}x_{4},x_{2}x_{3}%
x_{5},x_{2}x_{3}x_{6},x_{3}x_{4}x_{5},\nonumber\\
&  x_{3}x_{4}x_{6},x_{4}x_{5}x_{6},\nonumber\\
&  x_{1}x_{2}x_{3}x_{4},x_{1}x_{2}x_{3}x_{5},x_{1}x_{2}x_{3}x_{6},x_{1}%
x_{2}x_{4}x_{6},x_{1}x_{2}x_{5}x_{6},x_{1}x_{3}x_{4}x_{5},x_{1}x_{3}x_{4}%
x_{6},x_{1}x_{3}x_{5}x_{6},\nonumber\\
&  x_{2}x_{3}x_{4}x_{5},x_{2}x_{3}x_{4}x_{6},x_{2}x_{3}x_{5}x_{6},x_{3}%
x_{4}x_{5}x_{6},\nonumber\\
&  x_{1}x_{2}x_{3}x_{4}x_{5},x_{1}x_{2}x_{3}x_{4}x_{6},x_{1}x_{2}x_{3}%
x_{5}x_{6},x_{1}x_{2}x_{4}x_{5}x_{6},x_{1}x_{3}x_{4}x_{5}x_{6},x_{2}x_{3}%
x_{4}x_{5}x_{6},x_{1}x_{2}x_{3}x_{4}x_{5}x_{6},
\end{align}%
\begin{equation}
\dim\left\{  \mathcal{F}\right\}  =2^{6}=64,
\end{equation}
which corresponds to
\begin{align}
&  \binom{6}{0}+\binom{6}{1}+\binom{6}{2}+\binom{6}{3}+\binom{6}{4}+\binom
{6}{5}+\binom{6}{6}\nonumber\\
&  =1+6+15+20+15+6+1=64
\end{align}
and $\mathcal{F}\cong M\left(  8,\mathbb{C}\right)  .$

\subsection{Number Representation}

The sets of operators $\left\{  \left.  n_{j}\right\vert 1\leq j\leq
r\right\}  ,\left\{  \left.  h_{j}\right\vert 1\leq j\leq r\right\}  ,$ where
\begin{equation}
h_{j}=I_{\mathcal{F}}-n_{j},
\end{equation}
commute amongst themselves and each other. They are all orthogonal projection
operators thus their spectrum is $\left\{  0,1\right\}  .$ Also
\begin{equation}
n_{j}\left\vert \Psi\right\rangle =\left\vert \Psi\right\rangle
\Leftrightarrow h_{j}\left\vert \Psi\right\rangle =0,
\end{equation}
thus the simultaneous eigenbasis of $\left\{  \left.  n_{j}\right\vert 1\leq
j\leq r\right\}  $ (or $\left\{  \left.  h_{j}\right\vert 1\leq j\leq
r\right\}  )$ determines a basis for $\mathcal{H}_{\mathcal{F}}$ and which is
given by
\begin{equation}
\left\vert \eta_{1},\cdots,\eta_{r}\right\rangle ,
\end{equation}
where
\begin{equation}
\eta_{j}=0,1;\,1\leq j\leq r,
\end{equation}
showing that
\begin{equation}
\dim\left\{  \mathcal{H}_{\mathcal{F}}\right\}  =2^{r}.
\end{equation}


The correspondence between a number basis and a GSO basis of $\mathcal{H}%
_{\mathcal{F}}$ is
\begin{equation}
\left\vert \varphi_{j_{1}}\cdots\varphi_{j_{p}}\right\rangle =\left\vert
0\cdots0\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}0\cdots0\overset{j_{p}%
}{1}0\cdots0\right\rangle ;1\leq p\leq r,1\leq j_{1}<\cdots<j_{p}\leq r.
\end{equation}


The number basis can also be considered to belong to $\mathbb{C}^{2^{r}}$ by
setting
\begin{align}
&  \left\vert 0\cdots0\overset{j_{1}}{1}0\cdots0\overset{j_{2}}{1}%
0\cdots0\overset{j_{p}}{1}0\cdots\overset{r}{0}\right\rangle \nonumber\\
&  =\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\overset{j_{1}\cdots}{\left(
\begin{array}
[c]{c}%
0\\
1
\end{array}
\right)  }\otimes\left(
\begin{array}
[c]{c}%
1\\
0
\end{array}
\right)  \otimes\cdots\otimes\left(
\begin{array}
[c]{c}%
1\\
