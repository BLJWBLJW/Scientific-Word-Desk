}\otimes\cdots\otimes\overset{\cdots r}{\mathbb{I}}\right)  \left(
p_{1}\otimes h_{2}\otimes\cdots\otimes h_{j_{2}-1}\otimes p_{j_{2}}\otimes
h_{j_{2}+1}\otimes\cdots\otimes h_{j_{p}-1}\otimes p_{j_{p}}\otimes
h_{j_{p}+1}\otimes\cdots\otimes h_{r}\right) \nonumber\\
&  =h_{1}\otimes p_{2}\otimes\cdots\otimes h_{j_{2}-1}\otimes p_{j_{2}}\otimes
h_{j_{2}+1}\otimes\cdots\otimes h_{j_{p}-1}\otimes p_{j_{p}}\otimes
