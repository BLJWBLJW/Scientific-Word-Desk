\part{Tensor Products and Operator Topologies}

\begin{notation}
\begin{enumerate}
\item 
\begin{enumerate}
\item Contravariant tensor representation indices are superscripts i.e.
contravariant coordinates are labelled by superscripts.

conversely

\item contravariant tensors are labelled by subscripts
\end{enumerate}

\begin{enumerate}
\item Covariant tensor representation indices are subscripts i.e. covariant
coordinates are labelled by subscripts.

conversely

\item covariant tensor are labelled labels are superscripts.
\end{enumerate}
\end{enumerate}
\end{notation}

\begin{notation}
\begin{enumerate}
\item Both covariant and contravariant coordinates can be displayed as
either column vectors or as row vectors.

\item We take columns of scalar entries to be standard form and thus rows of
scalar entries to be transposes of columns of scalar entries

\item We take rows of vector or operator entries to be standard form and
thus columns of vector or operator entries to be transposes of columns of
vector or operator entries.
\end{enumerate}
\end{notation}

\begin{notation}
\begin{enumerate}
\item Mixed second rank tensors can be arranged as matrices $\mathbb{A}\in 
\mathcal{M}\left( r,r,\mathbb{C}\right) $ with matrix elements $A_{\func{row}%
,\func{col}}$ that are denoted by subscripts that refer to rows and columns
depending on whether they are acting on row or column vectors in the
following fashion i.e.

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) _{\func{col}}^{\func{row}}=\mathcal{M}%
_{e}\left( A\right) _{\func{row},\func{col}}.
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{\func{row}}^{\func{col}}=\mathcal{M}%
_{e}\left( A_{d}\right) _{\func{row},\func{col}},
\end{equation}%
hence covariant and contravariant indices can either refer to columns or
rows of a matrix.
\end{enumerate}
\end{enumerate}
\end{notation}

\begin{notation}
\begin{enumerate}
\item Supervectors constituted by bases of vector and dual vector spaces are
displayed as row vectors.

\item Supervectors constituted by coordinates of vectors and dual vectors
are displayed as column vectors.

This gives

\item 
\begin{gather}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) ^{1} & \cdots & \mathcal{R}_{e}\left(
v\right) ^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( v\right) ^{t}\left( \boldsymbol{e}\right) ^{t}
\end{gather}%
and 
\begin{gather}
v_{d}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{d}^{1} \\ 
\vdots \\ 
e_{d}^{r}%
\end{array}%
\right) =\mathcal{R}_{e_{d}}\left( v\right) ^{t}\left( \boldsymbol{e}%
_{d}\right) ^{t} \\
\parallel \\
v_{d}=\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v_{d}\right) _{r}%
\end{array}%
\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e_{d}}\left(
v_{d}\right) .
\end{gather}
\end{enumerate}
\end{notation}

\section{Covariant and Contravariant Tensors in Dual Spaces}

\subsubsection{Dual Spaces}

\begin{enumerate}
\item \bigskip Let $V$ be a vector space over $\mathbb{C}$ then%
\begin{equation}
V=\mathbb{C}\text{-}\func{linspan}\left\{ \left. e_{j}\right\vert 1\leq
j\leq r\right\} ,
\end{equation}%
where $\left( \boldsymbol{e}\right) =\left\{ \left. e_{j}\right\vert 1\leq
j\leq r\right\} $ is a $\mathbb{C}$-linearily independent basis of $V,$ that
are populated by \emph{contravariant vectors.}

\item The dual space $V^{d}$ of $\mathbb{C}$-linear functionals defined on $%
V $ is produced by 
\begin{equation}
V^{d}=\mathbb{C}\text{-}\func{linspan}\left\{ \left. h_{d}^{j}\right\vert
1\leq j\leq r\right\} ,
\end{equation}%
where $\left( \boldsymbol{h}_{d}\right) =\left\{ \left. h_{d}^{j}\right\vert
1\leq j\leq r\right\} $ is a $\mathbb{C}$-linearily independent basis of $%
V^{d},$\emph{\ }that are populated by \emph{covariant} vectors.
\end{enumerate}

\begin{definition}
Two bases $\left( \boldsymbol{e}\right) \in V$ 
\begin{equation}
\left( \boldsymbol{e}\right) =\left\{ \left. e_{j}\right\vert 1\leq j\leq
r\right\} \equiv \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right)
\end{equation}%
and $\left( \boldsymbol{e}_{b}\right) \in V^{d}$ 
\begin{equation}
\left( \boldsymbol{e}_{b}\right) =\left\{ \left. e_{b}^{j}\right\vert 1\leq
j\leq r\right\} \equiv \left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right)
\end{equation}%
are \emph{biorthogonal} bases of the pair $\left\{ V^{d},V\right\} $ if the
scalar products between the bases vectors have the property%
\begin{equation}
e_{b}^{j}\left( e_{k}\right) =\delta _{k}^{j}=\delta _{jk},\quad 1\leq
j,k\leq r.
\end{equation}
\end{definition}

\begin{remark}
The biorthogonality condition can be expressed as 
\begin{equation}
\mathbb{I}_{r}=\left( \boldsymbol{e}_{b}\right) ^{t}\left( \boldsymbol{e}%
\right) =\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b}^{1}\left( e_{1}\right) & \cdots & e_{b}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b}^{r}\left( e_{1}\right) & \cdots & e_{b}^{r}\left( e_{r}\right)%
\end{array}%
\right) ,
\end{equation}%
where the square brackets explicitly state that the components of the
transpose $\left( \boldsymbol{e}_{b}\right) ^{t}$ of the dual super vector $%
\left( \boldsymbol{e}_{b}\right) $ act as linear functionals on $V$ and are
evaluated on the super vector $\left( \boldsymbol{e}\right) .$
\end{remark}

\begin{definition}
\label{Biorthogonality Map} The biorthogonality map $b\in \mathcal{L}\left(
V^{d},V\right) $ 
\begin{equation}
b:V\rightarrow V^{d}
\end{equation}%
is defined 
\begin{equation}
b\left( v\right) =v_{b},
\end{equation}%
where
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
v_{b}\left( v\right) =\left[ b\left( v\right) \right] \left( v\right) =1
\end{equation}%
and

\item 
\begin{equation}
v_{b}\left( v^{c}\right) =0,
\end{equation}%
where%
\begin{equation}
V=V_{v}\oplus V_{v}^{c}
\end{equation}%
and 
\begin{eqnarray}
v &\in &V_{v} \\
v^{c} &\in &V_{v}^{c}.
\end{eqnarray}
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
\left( \boldsymbol{e}_{b}\right) =b\left( \boldsymbol{e}\right)
\end{equation}%
i.e. 
\begin{equation}
e_{b}^{j}=b\left( e_{j}\right) ,\quad 1\leq j\leq r.
\end{equation}
\end{remark}

\begin{theorem}
The action of $b$ is bases independent.

\begin{proof}
From the definition.
\end{proof}
\end{theorem}

\begin{remark}
If $V^{d}$ has a basis $\left( \boldsymbol{e}_{d}\right) $ that is
biorthogonal to a basis $\left( \boldsymbol{e}\right) $ of $V$ i.e. $\left( 
\boldsymbol{e}_{d}\right) =b\left( \boldsymbol{e}\right) =\left( \boldsymbol{%
e}_{b}\right) $ then the representation of a vector $v\in V$ is given by 
\begin{equation}
\mathcal{R}_{e}\left( v\right) =\left[ \left( \boldsymbol{e}_{d}\right) %
\right] \left( v\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( v\right) ^{j}=e_{d}^{j}\left( v\right) ,\quad 1\leq
j\leq r
\end{equation}%
and any vector $v\in V$ can be expanded as 
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}=\sum_{1\leq
j\leq r}e_{j}e_{d}^{j}\left( v\right) =\left( \boldsymbol{e}\right) \left[
\left( \boldsymbol{e}_{d}\right) ^{t}\right] \left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{d_{e}}^{1} \\ 
\vdots \\ 
e_{d_{e}}^{r}%
\end{array}%
\right) \right] \left( v\right) .
\end{equation}
\end{remark}

\begin{remark}
Thus $\left( \boldsymbol{e}\right) \left[ \left( \boldsymbol{e}_{b}\right)
^{t}\right] $ is a resolution of the identity $I_{V}$ of $V$ i.e. 
\begin{equation}
I_{V}=\left( \boldsymbol{e}\right) \left[ \left( \boldsymbol{e}_{b}\right)
^{t}\right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b_{e}}^{1} \\ 
\vdots \\ 
e_{b_{e}}^{r}%
\end{array}%
\right) \right] .
\end{equation}
\end{remark}

\begin{notation}
\begin{equation}
\left( \boldsymbol{e}\right) \left[ \left( \boldsymbol{e}_{b}\right) ^{t}%
\right] =\left[ \boldsymbol{ee}_{b}\right] .
\end{equation}
\end{notation}

\begin{remark}
Representations, $\mathcal{R}_{e}\left( v\right) \in \mathbb{C}^{r},$ of
vectors $v\in V$ are given by the expansions 
\begin{equation}
v=\left[ \boldsymbol{ee}_{b}\right] \left( v\right) =\left( \boldsymbol{e}%
\right) \mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}.
\end{equation}
\end{remark}

\begin{theorem}
\label{Contravariant Theorem} Let $A\in GL\left( V\right) $ then under
change of basis 
\begin{equation}
A:\left( \boldsymbol{e}\right) \rightarrow \left( \boldsymbol{f}\right)
=\left( A\boldsymbol{e}\right)
\end{equation}%
the coordinates of the representation $\mathcal{R}_{e}\left( v\right) $ of
the vector $v$ transform by the the inverse $\mathcal{R}_{e}\left( A\right)
^{-1}$ of the matrix representation $\mathcal{R}_{e}\left( A\right) $ of $A$
wrt the basis $\left( \boldsymbol{e}\right) $ i.e. 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right)
\end{equation}

\begin{proof}
\begin{eqnarray}
Av &=&\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left(
A\right) ^{-1}\mathcal{R}_{e}\left( v\right) \\
&=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{eqnarray}%
hence 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right) .\blacksquare
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
The reason why $v$ are called contravariant vectors is that their
coordinates transform "contra" to the bases vectors i.e the basis transforms
via a transformation matrix $\mathcal{R}_{e}\left( A\right) $ and the
coordinates via transformation matrix $\mathcal{R}_{e}\left( A\right) ^{-1}.$
\end{remark}

\begin{remark}
Representations, $\mathcal{R}_{e_{b}}\left( h_{d}\right) \in \mathbb{C}$ of
vectors $h_{d}\in V^{d}$ are given by the expansions%
\begin{equation}
h_{d}=\left[ \boldsymbol{e}_{b}\boldsymbol{e}\right] \left( h_{d}\right)
=\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e_{d}}\left( h_{d}\right)
=\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{b}^{j}\mathcal{R}_{e_{b}}\left( v\right)
_{j}.
\end{equation}
\end{remark}

\subparagraph{Duality Maps \label{Duality Maps}}

\begin{definition}
\label{Injections into dual space} Biorthogonal bases $\left\{ \left( 
\boldsymbol{e}_{b}\right) ,\left( \boldsymbol{e}\right) \right\} $ of the
pair $\left\{ V^{d},V\right\} $define injections $d_{e}\in \mathcal{L}\left(
V^{d},V\right) $ 
\begin{equation}
d_{e}:V\hookrightarrow V^{d}
\end{equation}%
given by 
\begin{equation}
d_{e}\left( v\right) =d_{e}\left( \sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( v\right) ^{j}\right) =\sum_{1\leq j\leq r}d_{e}\left(
e_{j}\right) \mathcal{R}_{e}\left( v\right) ^{j}=\sum_{1\leq j\leq
r}e_{b}^{j}\mathcal{R}_{e_{b}}\left( d_{e}\left( v\right) \right) _{j}.
\end{equation}
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
d_{e}\left( e_{j}\right) =e_{b}^{j},\quad 1\leq j\leq r.
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d_{e}\left( v\right) \right) _{j}=\mathcal{R}%
_{e}\left( v\right) ^{j},\quad 1\leq j\leq r.
\end{equation}
\end{enumerate}
\end{remark}

\begin{lemma}
The duality injection $d_{e}$ gives
\end{lemma}

\begin{remark}
\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
d_{e}\left( \boldsymbol{e}\right) =b\left( \boldsymbol{e}\right)
\end{equation}

\item 
\begin{equation}
d_{e}\left( e_{j}\right) =e_{d}^{j}=b\left( e_{j}\right) ,\quad 1\leq j\leq
r,
\end{equation}%
and in general
\end{enumerate}

\item 
\begin{equation}
d_{e}\left( v\right) =\left( \boldsymbol{e}_{d_{e}}\right) \mathcal{R}%
_{e_{d_{e}}}\left( d_{e}\left( v\right) \right) =\left( 
\begin{array}{ccc}
e_{d_{e}}^{1} & \cdots & e_{d_{e}}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( d_{e}\left( v\right) \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( d_{e}\left( v\right) \right) _{r}%
\end{array}%
\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left( v\right)
=\left( 
\begin{array}{ccc}
e_{b_{e}}^{1} & \cdots & e_{b_{e}}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{notation}
\begin{equation}
v_{d_{e}}=d_{e}\left( v\right) \equiv v^{d_{e}}.
\end{equation}
\end{notation}

\begin{remark}
By biorthogonality $V$ can be injected into $V^{d}$ i.e. $V\hookrightarrow
V^{d}.$ But different basis determine different biorthogonal bases
(obviously) more \emph{crucially} they can determine \emph{different}
injections i.e. consider $\left\{ \left( \boldsymbol{e}\right) ,\left( 
\boldsymbol{e}_{d}\right) \right\} $ and $\left\{ \left( \boldsymbol{f}%
\right) ,\left( \boldsymbol{f}_{d}\right) \right\} $ then in general 
\begin{equation}
d_{e}:V\rightarrow V^{d}
\end{equation}%
and 
\begin{equation}
d_{f}:V\rightarrow V^{d}
\end{equation}%
\emph{but in general}%
\begin{equation}
d_{e}\left( v\right) \neq d_{f}\left( v\right) !
\end{equation}
\end{remark}

\begin{remark}
Unless otherwise stated we limit ourselves to a fixed equivalence class of
biorthogonal bases that produce the same duality injection " $d$".
\end{remark}

\begin{remark}
\label{08/14}
\end{remark}

\begin{lemma}
If there exists a basis $\left( \boldsymbol{e}_{b}\right) $ biorthogonal to
the basis $\left( \boldsymbol{e}\right) $ of $V$ a transformation $A\in 
\mathcal{L}\left( V\right) $ induces a dual transformation $A^{d}\in 
\mathcal{L}\left( V^{d}\right) $ whose representation 
\begin{equation}
\mathcal{R}_{e_{b}}\left( A^{d}\right) \in \mathcal{M}\left( r,r,\mathbb{C}%
\right) ,
\end{equation}
is the matrix representation $\mathcal{R}_{e}\left( A\right) $ of $A,$ i.e. 
\begin{equation}
\mathcal{R}_{e_{b}}\left( A^{d}\right) =\mathcal{R}_{e}\left( A\right) .
\end{equation}

\begin{proof}
\begin{enumerate}
\item Transformations of vectors belonging to $V$ 
\begin{equation}
Av=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( Av\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left(
v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{equation}%
i.e. in this case 
\begin{equation}
\mathcal{M}_{e}\left( A\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e}\left( A\right) _{\func{col}}^{\func{row}}.
\end{equation}

\item The induced transformations of linear functionals belonging $V^{d}$ 
\begin{equation}
\left( Av\right) _{d}=A_{d}v_{d}=\left( \boldsymbol{e}_{d}\right) \mathcal{R}%
_{e_{d}}\left( A_{d}v_{d}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R%
}_{e_{d}}\left( A_{d}\right) \mathcal{R}_{e_{d}}\left( v_{d}\right) =\left( 
\boldsymbol{e}_{d}\right) \mathcal{R}_{e_{d}}\left( d\left( Av\right)
\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left( Av\right)
\end{equation}%
hence using the duality injection $d$ gives 
\begin{gather}
A_{d}v_{d} \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{gather}%
showing that 
\begin{equation}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ,
\end{equation}%
i.e. that 
\begin{equation}
\mathcal{M}_{e_{d}}\left( A_{d}\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{\func{row}}^{\func{col}}.\blacksquare
\end{equation}
\end{enumerate}
\end{proof}
\end{lemma}

\begin{remark}
Biorthogonality of the bases $\left\{ \left( \boldsymbol{e}_{b}\right)
,\left( \boldsymbol{e}\right) \right\} $ and $\left\{ \left( \boldsymbol{f}%
_{b}\right) ,\left( \boldsymbol{f}\right) \right\} $, where $\left( 
\boldsymbol{f}\right) =\left( A\boldsymbol{e}\right) $ gives 
\begin{equation}
\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b}^{1}\left( e_{1}\right) & \cdots & e_{b}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b}^{r}\left( e_{1}\right) & \cdots & e_{b}^{r}\left( e_{r}\right)%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{b}^{1}\left( f_{1}\right) & \cdots & f_{b}^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{b}^{r}\left( f_{1}\right) & \cdots & f_{b}^{r}\left( f_{r}\right)%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}
\end{remark}

\begin{definition}
of the biorthogonality preserving map $b\in \mathcal{L}\left( \overset{}{%
\mathcal{L}\left( V^{d}\right) ,\mathcal{L}\left( V\right) }\right) :$ Let $%
A\in GL\left( V\right) $ then $A$ induces a transformation $b\left( A\right)
\in \mathcal{L}\left( V^{d}\right) $, where $b\in \mathcal{L}\left( \overset{%
}{\mathcal{L}\left( V^{d}\right) ,\mathcal{L}\left( V\right) }\right) $,
(which is not the dual transformation map $d_{e}$),%
\begin{equation}
b:\mathcal{L}\left( V\right) \rightarrow \mathcal{L}\left( V^{d}\right)
\end{equation}%
i.e. 
\begin{equation}
b\left( A\right) =A_{b}\in \mathcal{L}\left( V^{d}\right)
\end{equation}%
is defined by 
\begin{equation}
b\left( A\right) \left( \boldsymbol{e}_{d}\right) =A_{b}\left( \boldsymbol{e}%
_{d}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left(
A_{b}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left(
A\right) ^{-t}=\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ^{-t}.
\end{equation}
\end{definition}

\begin{lemma}
Let $A\in GL\left( V\right) $ and $\left\{ \left( \boldsymbol{e}_{b}\right)
,\left( \boldsymbol{e}\right) \right\} $ be biorthogonal bases of $\left\{
V^{d},V\right\} $ then the bases $\left\{ \left( \boldsymbol{f}_{d}\right)
,\left( \boldsymbol{f}\right) \right\} ,$ defined by 
\begin{equation}
\left( \boldsymbol{f}\right) =\left( A\boldsymbol{e}\right)
\end{equation}%
and 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) =\left( A_{b}\boldsymbol{e}_{b}\right)
=b\left( A\right) \left( \boldsymbol{e}_{b}\right)
\end{equation}%
are biorthogonal.

\begin{proof}
\begin{enumerate}
\item 
\begin{equation}
A_{b}\left( \boldsymbol{e}\right) _{b}=A_{b}\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( A_{b}\right)
\end{equation}

\item 
\begin{equation}
\left( A_{b}\left( \boldsymbol{e}\right) _{b}\right) ^{t}=\left( A_{b}\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \right) ^{t}=\left( \left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( A_{b}\right) \right) ^{t}=\mathcal{R}%
_{e_{b}}\left( A_{b}\right) ^{t}\left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right)
\end{equation}

\item 
\begin{eqnarray}
\left[ \left( \boldsymbol{f}_{b}\right) ^{t}\right] \left( \boldsymbol{f}%
\right) &=&\left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\left[ \left( A_{b}\left( \boldsymbol{e}\right) _{b}\right) ^{t}\right]
\left( A\left( \boldsymbol{e}\right) \right) &=&\mathcal{R}_{e_{b}}\left(
A_{b}\right) ^{t}\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \\
&=&\mathcal{R}_{e_{b}}\left( A_{b}\right) ^{t}\left[ \overset{}{\left( 
\boldsymbol{e}_{b}\right) ^{t}}\right] \left( \overset{}{\boldsymbol{e}}%
\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e_{b}}\left(
A_{b}\right) ^{t}\mathcal{R}_{e}\left( A\right)
\end{eqnarray}

\item If $\left\{ \left( \boldsymbol{f}_{b}\right) ,\left( \boldsymbol{f}%
\right) \right\} $ are biorthogonal then 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A_{b}\right) ^{t}\mathcal{R}_{e}\left( A\right) =%
\mathbb{I}_{r}\Leftrightarrow \mathcal{R}_{e_{b}}\left( A_{b}\right) ^{t}=%
\mathcal{R}_{e}\left( A\right) ^{-1}\Leftrightarrow \mathcal{R}%
_{e_{b}}\left( A_{b}\right) =\mathcal{R}_{e}\left( A\right) ^{-t}\blacksquare
\end{equation}
\end{enumerate}
\end{proof}
\end{lemma}

\begin{theorem}
\label{Covariant Theorem} Let $A\in GL\left( V\right) $ then the induced
basis change $b\left( A\right) $ of $V^{d}$ 
\begin{equation}
b\left( A\right) :\left( \boldsymbol{e}_{b}\right) \rightarrow \left( 
\boldsymbol{f}_{b}\right) =\left( b\left( A\right) \boldsymbol{e}_{b}\right)
\end{equation}%
the coordinates of the representation $\mathcal{R}_{e_{b}}\left(
v_{d}\right) $ of the vector $v_{d}$ transform by the matrix representation $%
\mathcal{R}_{e}\left( A\right) $ of $A$ wrt the basis $\left( \boldsymbol{e}%
\right) $ i.e. 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) =\mathcal{R}_{e_{b}}\left( b\left(
A\right) \right) \mathcal{R}_{e}\left( v_{d}\right) =\mathcal{R}_{e}\left(
A\right) \mathcal{R}_{e}\left( v_{d}\right) .
\end{equation}

\begin{proof}
\begin{enumerate}
\item 
\begin{eqnarray}
\left[ \left( \boldsymbol{f}_{b}\right) ^{t}\right] \left( \boldsymbol{f}%
\right) &=&\left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\left[ \left( b\left( A\right) \left( \boldsymbol{e}\right) _{b}\right) ^{t}%
\right] \left( A\left( \boldsymbol{e}\right) \right) &=&\mathcal{R}%
_{e_{b}}\left( b\left( A\right) \right) ^{t}\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \\
&=&\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) ^{t}\left[ \overset{}{%
\left( \boldsymbol{e}_{b}\right) ^{t}}\right] \left( \overset{}{\boldsymbol{e%
}}\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e_{b}}\left( b\left(
A\right) \right) ^{t}\mathcal{R}_{e}\left( A\right) =\mathbb{I}_{r}
\end{eqnarray}%
hence

\item 
\begin{equation}
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) ^{t}=\mathcal{R}%
_{e}\left( A\right) ^{-1}
\end{equation}

\item 
\begin{eqnarray}
b\left( A\right) v_{d} &=&\left( \boldsymbol{e}_{b}\right) \mathcal{R}%
_{e_{b}}\left( \overset{}{b\left( A\right) }\right) \mathcal{R}%
_{e_{b}}\left( \overset{}{v_{d}}\right) =\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{1}^{1} & \cdots & 
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{r}^{1} & \cdots & 
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \\
&=&\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( A\right) \mathcal{R}_{e_{b}}\left( \overset{}{v_{d}}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
f_{b}^{1} & \cdots & f_{b}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( v\right) _{r}%
\end{array}%
\right) ,
\end{eqnarray}%
hence 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) =\mathcal{R}_{e}\left( A\right) 
\mathcal{R}_{e_{b}}\left( v_{d}\right) .\blacksquare
\end{equation}
\end{enumerate}
\end{proof}
\end{theorem}

\begin{remark}
The reason why $v_{d}\in V^{d}$ are called covariant vectors is that their
coordinates transform in the same way as the bases vectors $\left( 
\boldsymbol{e}\right) $ of $V$ i.e the basis transforms via a transformation
matrix $\mathcal{R}_{e}\left( A\right) ^{-1}$ and the coordinates via a
transformation matrix $\mathcal{R}_{e}\left( A\right) $ thus they transform
in covariant manner to the bases of $V.$
\end{remark}

\begin{remark}
The Duality and Biorthogonality maps have the properties
\end{remark}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
d_{e}\left( \boldsymbol{e}\right) =\boldsymbol{e}_{d}
\end{equation}

\item 
\begin{equation}
b\left( \boldsymbol{e}\right) =\boldsymbol{e}_{b}
\end{equation}

\item 
\begin{equation}
b\left( \boldsymbol{e}\right) =d_{e}\left( \boldsymbol{e}\right)
\end{equation}

\item 
\begin{equation}
\boldsymbol{e}_{d}=\boldsymbol{e}_{b}
\end{equation}
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
d_{e}\left( v\right) =\left( d_{e}\left( \boldsymbol{e}\right) \right) 
\mathcal{R}_{e_{d}}\left( v_{d_{e}}\right) =\left( d_{e}\left( \boldsymbol{e}%
\right) \right) \mathcal{R}_{e_{d}}\left( v_{d_{e}}\right) =\left(
d_{e}\left( \boldsymbol{e}\right) \right) \mathcal{R}_{e}\left( v\right)
=\left( b\left( \boldsymbol{e}\right) \right) \mathcal{R}_{e}\left( v\right)
\end{equation}

\item 
\begin{equation}
b\left( v\right) =\left( b_{e}\left( \boldsymbol{e}\right) \right) \mathcal{R%
}_{e_{b}}\left( v_{d_{e}}\right) =\left( b\left( \boldsymbol{e}\right)
\right) \mathcal{R}_{e_{b}}\left( v_{d_{e}}\right) =\left( b\left( 
\boldsymbol{e}\right) \right) \mathcal{R}_{e}\left( v\right)
\end{equation}
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
d\left( Av\right) =d\left( A\right) d\left( v\right) =A^{d}d\left( v\right)
=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}%
_{e}\left( v\right)
\end{equation}

\item 
\begin{equation}
b\left( Av\right) =b\left( A\right) b\left( v\right) =A_{b}b\left( v\right)
=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( v\right)
\end{equation}
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e_{d}}\left( d\left( Av\right) \right) =\mathcal{R}_{e}\left(
A\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) =\mathcal{R}_{e}\left(
A^{-1}\right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{corollary}
\label{Scalar Product} The scalar product $h_{d}\left( v\right) $ between $%
h_{d}$ and $v$ is invariant to biorthogonal bases used in the expansions of $%
h_{d}$ and $v.$

\begin{proof}
\label{08/15} The scalar product $h_{d}\left( v\right) $ can be expanded as 
\begin{gather}
h_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ^{t}\mathcal{R}_{e}\left( A\right)
^{-t}\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \right) \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left( A\right)
^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \right) \\
\parallel \\
\left( \left[ \left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \right] \mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}_{e}\left(
A\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \right) ^{t}\left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left( A\right)
^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \right)
\end{gather}%
\begin{gather}
\parallel \\
\left( \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \right) \times \\
\times \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \right) .
\end{gather}%
Showing that 
\begin{equation}
h_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( h_{d}\right) _{1}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{equation}%
where the coordinates of linear functionals i.e. dual vectors $h_{d}$
transform as 
\begin{gather}
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{eb}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t} \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\mathcal{R}_{e_{b}}\left( h_{b}\right) ^{t}\mathcal{R}_{e}\left(
A\right) ^{t} \\
\Updownarrow \\
\left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) \mathcal{R}_{e_{b}}\left(
h_{d}\right)
\end{gather}%
and the coordinates of vectors $v$ \TEXTsymbol{\backslash}transform as 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}_{e}\left( v\right) .
\end{equation}
\end{proof}
\end{corollary}

\begin{remark}
\begin{gather}
\left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) ^{-t}\left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
f_{b}^{1} & \cdots & f_{b}^{r}%
\end{array}%
\right) =b\left( A\right) \left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ^{-1},
\end{gather}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) =b\left( A\right) ^{-1}\left( \boldsymbol{e}%
_{b}\right) =\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e}\left( A\right)
^{-1}
\end{equation}%
where 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ,
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}\right) =A\left( \boldsymbol{e}\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) .
\end{equation}%
Thus 
\begin{equation}
\left[ \left( \boldsymbol{f}_{b}\right) ^{t}\right] \left( \boldsymbol{f}%
\right) =\left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \mathcal{R}_{e}\left( A\right) ^{-1}\left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\mathbb{I}_{r}.
\end{equation}
\end{remark}

\begin{remark}
The basis $\left( \boldsymbol{f}_{b}\right) $ is the dual biorthogonal basis
to $\left( \boldsymbol{f}\right) $, which can be expressed as
transformations of the basis $\left( \boldsymbol{e}_{b}\right) $ by

\begin{enumerate}
\item 
\begin{gather}
\left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
f_{b}^{1} & \cdots & f_{b}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b}^{1} & \cdots & e_{b}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}
\end{gather}%
which gives the following relationships between the resolution of the
identities

\item 
\begin{gather}
\left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e_{d}^{1} \\ 
\vdots \\ 
e_{d}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( \boldsymbol{f}_{b}\right) ^{t}\right] \left( \boldsymbol{f}%
\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{e}\right) \mathcal{R}_{e}\left(
A\right) .
\end{gather}
\end{enumerate}
\end{remark}

\begin{remark}
\textbf{IMPORTANT}%
\begin{equation}
f_{dj}=d\left( Ae_{j}\right)
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}_{d}\right) =d\left( A\boldsymbol{e}\right)
\end{equation}%
but 
\begin{equation}
f_{bj}\neq d\left( A^{-1}e_{j}\right) .
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) =b\left( A^{-1}\boldsymbol{e}\right)
\end{equation}%
$\left( \boldsymbol{f}_{d}\right) $ is not biorthogonal to $\boldsymbol{f}$
but $\left( \boldsymbol{f}_{b}\right) $ is.
\end{remark}

\begin{remark}
The dual $d\left( \left( \boldsymbol{Ae}\right) \right) =\left( \boldsymbol{%
Ae}\right) _{d}$ of the basis $\left( \boldsymbol{Ae}\right) $ is given by 
\begin{eqnarray}
d\left( \left( \boldsymbol{Ae}\right) \right) &=&\left( 
\begin{array}{ccc}
\left( Ae_{1}\right) _{d} & \cdots & \left( Ae_{r}\right) _{d}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{r}^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right)
\end{eqnarray}%
hence the transformed overlap $\equiv $ metric matrix $\mathbb{S}_{f}$ can
be expressed as 
\begin{gather}
\left[ \left( 
\begin{array}{c}
f_{d}^{1} \\ 
\vdots \\ 
f_{d}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{ccc}
\left( Ae_{1}\right) _{d} & \cdots & \left( Ae_{r}\right) _{d}%
\end{array}%
\right) ^{t}\right] \left( 
\begin{array}{ccc}
\left( Ae\right) _{1} & \cdots & \left( Ae\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( \left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \right) ^{t}\right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
e_{d}^{1} \\ 
\vdots \\ 
e_{d}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left[ \left( 
\begin{array}{c}
e_{d}^{1} \\ 
\vdots \\ 
e_{d}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right)
\end{gather}

\begin{enumerate}
\item Thus if $\mathbb{S}_{e}=\mathbb{I}_{r}$ then $\mathbb{S}_{f}=\mathbb{I}%
_{r}$ only if 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}%
i.e. 
\begin{equation}
A\in O\left( r,\mathbb{C}\right) .
\end{equation}%
However

\item 
\begin{equation}
\mathbb{I}_{r}=\mathcal{R}_{e}\left( A\right) ^{-t}\left[ \left( 
\begin{array}{c}
e_{b}^{1} \\ 
\vdots \\ 
e_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e}\left( A\right)
^{-1}\left( 
\begin{array}{ccc}
e_{b}^{1}\left( e_{1}\right) & \cdots & e_{b}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b}^{r}\left( e_{1}\right) & \cdots & e_{b}^{r}\left( e_{r}\right)%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{equation}%
is true for any $A\in GL\left( V\right) .$
\end{enumerate}
\end{remark}

\begin{remark}
The coordinates $\left\{ \left. \mathcal{R}_{e}\left( v\right)
^{j}\right\vert 1\leq j\leq r\right\} $ are \underline{\emph{contravariant
coordinates}}\emph{\ }as they transform in an \underline{inverse} manner
compared to transformations of the basis $\left( \boldsymbol{e}\right)
\equiv \left\{ \left. e_{j}\right\vert 1\leq j\leq r\right\} $ as can be
seen from 
\begin{equation}
v=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}%
_{e}\left( A\right) ^{-1}\mathcal{R}_{e}\left( v\right) =A\left( \boldsymbol{%
e}\right) \mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}_{e}\left( v\right)
=\left( \boldsymbol{f}\right) \mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}%
_{e}\left( v\right) =\left( \boldsymbol{f}\right) \mathcal{R}_{f}\left(
v\right) ,
\end{equation}%
where 
\begin{equation}
\left( \boldsymbol{f}\right) =A\left( \boldsymbol{e}\right)
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right) .
\end{equation}
\end{remark}

\begin{remark}
The coordinates $\left\{ \left. \mathcal{R}_{e_{b}}\left( h_{d}\right)
_{j}\right\vert 1\leq j\leq r\right\} $ are \underline{\emph{covariant
coordinates}}\emph{\ }as they transform in the \underline{same} manner as
the transformations of the basis $\left( \boldsymbol{e}\right) \equiv
\left\{ \left. e_{j}\right\vert 1\leq j\leq r\right\} ,$ as can be seen from 
\begin{equation}
h_{d}=\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( A\right) \mathcal{R}_{e_{d}}\left( h_{d}\right)
=A_{b}\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e}\left( A\right) 
\mathcal{R}_{e_{d}}\left( h_{d}\right) =\left( \boldsymbol{f}_{b}\right) 
\mathcal{R}_{f_{b}}\left( h_{d}\right) ,
\end{equation}%
where 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) =\left( A\boldsymbol{e}\right) _{b}
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{f_{b}}\left( h_{d}\right) =\mathcal{R}_{e}\left( A\right) 
\mathcal{R}_{e_{b}}\left( h_{d}\right) .
\end{equation}
\end{remark}

\begin{definition}
In general the overlap matrix $\equiv $ metric matrix $\mathbb{S}_{fe}$
between two bases $\left\{ \left( \boldsymbol{f}_{d}\right) ,\left( 
\boldsymbol{e}\right) \right\} $ is 
\begin{equation}
\mathbb{S}_{fe}=\left[ \left( \boldsymbol{f}_{d}\right) \right] ^{t}\left( 
\boldsymbol{e}\right) =\left( 
\begin{array}{c}
\left[ f_{d}^{1}\right] \\ 
\vdots \\ 
\left[ h_{d}^{r}\right]%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d}^{1}\left( e_{1}\right) & \cdots & f_{d}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{d}^{r}\left( e_{1}\right) & \cdots & f_{d}^{r}\left( e_{r}\right)%
\end{array}%
\right) .
\end{equation}
\end{definition}

\subparagraph{Resolutions of the identity}

\begin{enumerate}
\item 
\begin{equation}
I_{V}=\sum_{1\leq j\leq r}\left[ e_{i}e_{b}^{i}\right] .
\end{equation}

\item 
\begin{equation}
P_{V^{d}}=\sum_{1\leq j\leq r}\left[ e_{b}^{i}e_{bbi}\right] =\sum_{1\leq
j\leq r}\left[ e_{b}^{i}e_{i}\right] ,
\end{equation}%
where 
\begin{equation}
e_{bbi}\left( h_{d}\right) =h_{d}\left( e_{i}\right) .
\end{equation}
\end{enumerate}

\subparagraph{Scalar Product}

The scalar product between $w_{d}\in V^{d}$ 
\begin{equation}
w_{d}=\left( \boldsymbol{f}_{d}\right) \mathcal{R}_{f_{d}}\left(
w_{d}\right) =\left( 
\begin{array}{ccc}
f_{d}^{1} & \cdots & f_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d}^{1} & \cdots & f_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{1dd}\left( w_{d}\right) \\ 
\vdots \\ 
f_{rdd}\left( w_{d}\right)%
\end{array}%
\right) =\sum_{1\leq j\leq r}f_{d}^{j}\mathcal{R}_{f_{d}}\left( w_{d}\right)
_{j}
\end{equation}%
and $v\in V$ 
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1d}\left( v\right) \\ 
\vdots \\ 
e_{rd}\left( v\right)%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right)
=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}
\end{equation}%
is given by%
\begin{gather}
w_{d}\left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
f_{d}^{1} & \cdots & f_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \right) ^{t}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{d}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left[ f_{d}^{1}\right] \\ 
\vdots \\ 
\left[ f_{d}^{r}\right]%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{d}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d}^{1}\left( e_{1}\right) & \cdots & f_{d}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{d}^{r}\left( e_{1}\right) & \cdots & f_{d}^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\mathcal{R}_{f_{d}}\left( w_{d}\right) ^{t}\mathbb{S}_{fe}\mathcal{R}%
_{e}\left( v\right) =w_{d}\left( v\right) ,
\end{gather}%
which can be recast using resolutions of the identity as 
\begin{gather}
w_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{d}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left[ f_{d}^{1}\right] \\ 
\vdots \\ 
\left[ f_{d}^{r}\right]%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{dd1}\left( w_{d}\right) & \cdots & f_{ddr}\left( w_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left[ f_{d}^{1}\right] \\ 
\vdots \\ 
\left[ f_{d}^{r}\right]%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{d}^{1}\left( v\right) \\ 
\vdots \\ 
e_{d}^{r}\left( v\right)%
\end{array}%
\right) \\
\parallel \\
\left( \left( 
\begin{array}{ccc}
\left[ f_{d}^{1}\right] & \cdots & \left[ f_{d}^{r}\right]%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{dd1}\left( w_{d}\right) \\ 
\vdots \\ 
f_{ddr}\left( w_{d}\right)%
\end{array}%
\right) \right) ^{t}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{d}^{1}\left( v\right) \\ 
\vdots \\ 
e_{d}^{r}\left( v\right)%
\end{array}%
\right) \\
\parallel \\
\left( \left( \sum_{1\leq j\leq r}\left[ f_{d}^{j}\right] f_{ddj}\right)
\left( w_{d}\right) \right) ^{t}\left( \sum_{1\leq j\leq
r}e_{j}e_{d}^{j}\right) \left( v\right) =w_{d}\left( v\right) .
\end{gather}

\begin{remark}
The triple dual $V^{ddd}$ of the vector space $V$ and the dual vector space $%
V^{d}$ are isomorphic i.e. 
\begin{equation}
V^{ddd}\cong V^{d}
\end{equation}%
in \emph{both} infinite and finite cases, while the vector space $V$ can be
only in general be injected into the double dual $V^{dd}$ i.e. $%
V\hookrightarrow V^{dd}.$

\begin{enumerate}
\item The action of the dual space $V^{d}$ of linear functionals produces a
complex number i.e. 
\begin{equation}
h_{d}\left( v\right) \in \mathbb{C\quad }\forall v\in V.
\end{equation}

\item The injection%
\begin{equation}
\iota _{V^{dd}V}:V\hookrightarrow V^{dd}
\end{equation}
is given by 
\begin{equation}
v_{dd}=\iota _{V^{dd}V}\left( v\right) ,
\end{equation}%
where 
\begin{equation}
v_{dd}\left( h_{d}\right) =h_{d}\left( v\right) \in \mathbb{C\quad }\forall
h_{d}\in V^{d}.
\end{equation}

\item The isomorphism $V^{ddd}\cong V^{d}$ is given by 
\begin{equation}
h_{ddd}\left( f_{dd}\right) =f_{dd}\left( h_{d}\right) \in \mathbb{C\quad }%
\forall f_{dd}\in V^{dd}.
\end{equation}

\item If $f_{dd}=\iota _{V^{dd}V}\left( v\right) $ this gives 
\begin{equation}
h_{ddd}\left( \iota _{V^{dd}V}\left( v\right) \right) =\iota
_{V^{dd}V}\left( v\right) \left( h_{d}\right) =h_{d}\left( v\right) \in 
\mathbb{C\quad }\forall v\in V.
\end{equation}
\end{enumerate}
\end{remark}

\subparagraph{Expansions of Vectors}

We further analyse representations of vectors and linear functionals:

\begin{definition}
The $\mathbb{C}$-linear duality map $d_{e}\in \mathcal{L}\left(
V^{d},V\right) $ denoted by $d_{e}$ showing that it is basis dependent. 
\begin{equation}
d_{e}:V\rightarrow V^{d}
\end{equation}%
is defined by 
\begin{equation}
d_{e}\left( v\right) =d_{e}\left( \sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( v\right) ^{j}\right) =\sum_{1\leq j\leq r}e^{j}\mathcal{R}%
_{e_{d}}\left( v^{d}\right) _{j}=v_{d_{e}},
\end{equation}%
where 
\begin{equation}
\mathcal{R}_{e_{d_{e}}}\left( v_{d_{e}}\right) _{j}=\mathcal{R}_{e}\left(
v\right) ^{j},\quad 1\leq j\leq r.
\end{equation}%
Recall
\end{definition}

\begin{definition}
\begin{equation}
\left( \boldsymbol{e}_{d}\right) =\left( \boldsymbol{e}_{b}\right) .
\end{equation}
\end{definition}

\begin{remark}
The action on basis elements is 
\begin{equation}
e_{d_{e}j}=d_{e}\left( e_{j}\right) =e^{j},\,1\leq j\leq r,\quad \forall
\left( \boldsymbol{e}\right) \in \mathfrak{B}\left( V\right) .
\end{equation}
\end{remark}

\begin{notation}
\begin{equation}
d_{e}\left( e_{j}\right) =e_{d_{e}}^{j},\,1\leq j\leq r.
\end{equation}
\end{notation}

\begin{definition}
The $\mathbb{C}$-linear duality map $d_{e}\in \mathcal{L}\left(
V,V^{d}\right) $ (one uses the same symbol symbol for the duality maps $\in 
\mathcal{L}\left( V^{d},V\right) $ and $\mathcal{L}\left( V,V^{d}\right) $ 
\begin{equation}
d_{e}:V^{d}\rightarrow V
\end{equation}%
is defined by 
\begin{equation}
d_{e}\left( v_{d}\right) =d_{e}\left( \sum_{1\leq j\leq r}e_{dj}\mathcal{R}%
_{e_{d}}\left( v_{d}\right) _{j}\right) =\sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( v\right) ^{j}=v,
\end{equation}%
where 
\begin{equation}
\mathcal{R}_{e}\left( v\right) ^{j}=\mathcal{R}_{e_{d}}\left( v_{d}\right)
_{j},\quad 1\leq j\leq r.
\end{equation}%
The definition on basis elements is 
\begin{equation}
e_{j}=d_{e}\left( e_{dj}\right) ,\,1\leq j\leq r,\quad \forall \left( 
\boldsymbol{e}_{d}\right) \in \mathfrak{B}\left( V^{d}\right) .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
d_{e}^{2}=I_{V}.
\end{equation}
\end{remark}

\begin{enumerate}
\item Vectors $v\in V$ (contravariant vectors) can be expanded as

\begin{enumerate}
\item 
\begin{gather}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right)
=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j},
\end{gather}%
which gives the resolution of the identity on $V$ as

\item 
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}=\left[
\sum_{1\leq j\leq r}e_{j}e^{j}\right] \left( v\right) .
\end{equation}%
and if $\left( \boldsymbol{e}_{b}\right) $ exists one can define resolutions
of the identity as

\item 
\begin{equation}
I_{V}\overset{\limfunc{def}}{=}\left[ \boldsymbol{ee}_{b}\right] =\left( 
\boldsymbol{e}\right) \left( \boldsymbol{e}_{b}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{j}e^{j}.
\end{equation}
\end{enumerate}

Linear functionals $h_{d}\in V^{d}$ (covariant vectors or dual vectors) can
be expanded as

\item 
\begin{eqnarray}
h_{d} &=&\left( 
\begin{array}{ccc}
h^{1} & \cdots & h^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1}\left( h_{d}\right) & \cdots & e_{r}\left( h_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e_{bb1}\left( h_{d}\right) & \cdots & e_{bbr}\left( h_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
h_{d}\left( e_{1}\right) & \cdots & h_{d}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\mathcal{R}_{e_{b}e_{b}}\left( h_{d}\right) \left( \boldsymbol{e}%
_{b}\right) =\sum_{1\leq j\leq r}\mathcal{R}_{e_{b}e_{b}}\left( h_{d}\right)
_{j}e^{j}.
\end{eqnarray}

\begin{enumerate}
\item which gives the resolution of the identity 
\begin{equation}
I_{V^{d}}=\left[ \sum_{1\leq j\leq r}e^{j}e_{j}\right]
\end{equation}
on $V^{d}$ as 
\begin{equation}
h_{d}=\sum_{1\leq j\leq r}e^{j}\mathcal{R}_{e}\left( h_{d}\right)
_{j}=\sum_{1\leq j\leq r}e^{j}e_{j}\left( h_{d}\right) =\left[ \sum_{1\leq
j\leq r}e^{j}e_{j}\right] \left( h_{d}\right) ,
\end{equation}%
which can also be expressed as

\item 
\begin{equation}
I_{V^{d}}\overset{\limfunc{def}}{=}\left[ \boldsymbol{e}_{bbb}\boldsymbol{e}%
\right] =\left[ \boldsymbol{e}_{b}\boldsymbol{e}\right] =\left( \boldsymbol{e%
}_{b}\right) \left( \boldsymbol{e}\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{bj}e_{j}=\sum_{1\leq j\leq r}e^{j}e_{j}.
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{remark}
\label{08/17}%
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) ^{d}=\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}e_{b}}\left( v_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \overset{\text{as }v_{d}\text{ is the dual of }v}{=}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) ^{1} & \cdots & \mathcal{R}_{e}\left(
v\right) ^{r}%
\end{array}%
\right)
\end{equation}
\end{remark}

\begin{remark}
The dual space $V^{d}$ is the space of $\mathbb{C}$-linear functionals
defined on $V$ which have the effect 
\begin{gather}
h_{d}\left( v\right) =\sum_{1\leq j,k\leq r}\mathcal{R}_{e_{d}}\left(
h_{d}\right) _{j}e_{dj}\left( e_{k}\right) \mathcal{R}_{e}\left( v\right)
=\sum_{1\leq j,k\leq r}\mathcal{R}_{e_{d}}\left( h_{d}\right)
_{j}e^{j}\left( e_{k}\right) \mathcal{R}_{e}\left( v\right) _{k}=\sum_{1\leq
j,k\leq r}\mathcal{R}_{e_{d}}\left( h_{d}\right) _{j}\delta _{k}^{j}\mathcal{%
R}_{e}\left( v\right) _{k} \\
\parallel \\
\sum_{1\leq j\leq r}\mathcal{R}_{e_{d}}\left( h_{d}\right) \mathcal{R}%
_{e}\left( v\right) =\sum_{1\leq j\leq r}\mathcal{R}_{e_{d}}\left(
h_{d}\right) _{j}\mathcal{R}_{e}\left( v\right) ^{j}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{gather}%
i.e. 
\begin{equation}
h_{d}\left( v\right) =\mathcal{R}_{e_{d}}\left( h_{d}\right) \mathbb{S}%
\mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
S\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
S\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{equation}%
where the metric matrix $\mathcal{R}_{e}\left( S\right) $ in the case of
biorthogonal bases is given by 
\begin{equation}
\mathcal{R}_{e}\left( S\right) =\left( 
\begin{array}{ccc}
e^{1}\left( e_{1}\right) & \cdots & e^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( e_{1}\right) & \cdots & e^{r}\left( e_{r}\right)%
\end{array}%
\right) =\left( \boldsymbol{e}_{d}\right) \left( \boldsymbol{e}\right)
=\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}
\end{remark}

\begin{remark}
In general if $\left( \boldsymbol{e}\right) $ is a basis of $V$ and $\left( 
\boldsymbol{f}_{d}\right) $ is a basis of $V^{d}$ 
\begin{gather}
h_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( h\right) _{1} & \cdots & \mathcal{R}_{f_{d}}\left(
h\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{d}^{1} \\ 
\vdots \\ 
f_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{d}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{r_{d}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d}^{1}\left( e_{1}\right) & \cdots & f_{d}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{d}^{r}\left( e_{1}\right) & \cdots & f_{d}^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) = \\
\sum_{1\leq j,k\leq r}\mathcal{R}_{rf_{d}}\left( h_{d}\right)
_{j}f_{d}^{j}\left( e_{k}\right) \mathcal{R}_{e}\left( v\right) ^{k}=%
\mathcal{R}_{f_{d}}\left( h_{d}\right) ^{t}\boldsymbol{f}_{d}\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right)
\end{gather}%
and the overlap $\equiv $ metric matrix $\mathcal{R}_{f_{d}e}\left(
S_{f_{d}e}\right) $ is 
\begin{equation}
\mathcal{R}_{f_{d}e}\left( S_{f_{d}e}\right) =\boldsymbol{f}_{d}\left( 
\boldsymbol{e}\right) =\left( 
\begin{array}{ccc}
f_{d}^{1}\left( e_{1}\right) & \cdots & f_{d}^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{d}^{r}\left( e_{1}\right) & \cdots & f_{d}^{r}\left( e_{r}\right)%
\end{array}%
\right) .
\end{equation}
\end{remark}

\section{Changing Tensor Type}

\subsection{Types of Tensors}

\subsubsection{Rank 1 Tensors $\equiv $ vectors}

\begin{enumerate}
\item Contravariant 
\begin{equation}
v=t_{1}^{0}=\sum_{1\leq j\leq r}c^{j}e_{j}=\sum_{1\leq j\leq r}e_{j}\mathcal{%
R}_{e}\left( t_{1}^{0}\right) ^{j}=t_{1}=\left( \boldsymbol{e}\right) ^{t}%
\mathcal{R}_{e}\left( t_{1}^{0}\right)
\end{equation}

\item Covariant 
\begin{equation}
w_{d}=t_{0}^{1}=\sum_{1\leq j\leq r}c_{j}e_{d}^{j}=\sum_{1\leq j\leq r}%
\mathcal{R}_{e}\left( t_{0}^{1}\right) _{j}e_{d}^{j}=t^{1}=\mathcal{R}%
_{e}\left( t_{1}^{0}\right) ^{t}\left( \boldsymbol{e}_{d}\right)
\end{equation}
\end{enumerate}

\subsubsection{Rank 2 Tensors}

\begin{enumerate}
\item Contravaiant 
\begin{equation}
b=t_{0}^{2}=\sum_{1\leq j,k\leq r}c_{jk}e^{j}\otimes e^{k}=\sum_{1\leq
j,k\leq r}e^{j}\otimes e^{k}\mathcal{R}_{e_{d}e_{d}}\left( t_{0}^{2}\right)
_{jk}
\end{equation}

\item Covariant%
\begin{equation}
b_{d}=t_{2}^{0}=\sum_{1\leq j,k\leq r}c^{jk}e_{j}\otimes e_{k}=\sum_{1\leq
j,k\leq r}e_{j}\otimes e_{k}\mathcal{R}_{ee}\left( t_{2}^{0}\right) ^{jk}
\end{equation}

\item Mixed Contravaiant/Covariant%
\begin{equation}
A=t_{1}^{1}=\sum_{1\leq j,k\leq r}A_{k}^{j}e_{j}\otimes e^{k}=\sum_{1\leq
j,k\leq r}e_{j}\otimes e^{k}\mathcal{R}_{ee_{d}}\left( t_{1}^{1}\right)
_{k}^{j}
\end{equation}

\item Mixed Covariant/Contravaiant%
\begin{equation}
A^{d}=\left( t_{d}\right) _{1}^{1}=\sum A_{j}^{dk}e^{j}\otimes
e_{k}=\sum_{1\leq j,k\leq r}e^{j}\otimes e_{k}\mathcal{R}_{e_{d}e}\left(
\left( t_{d}\right) _{1}^{1}\right) _{j}^{k}
\end{equation}
\end{enumerate}

\subsection{Maps Transforming Tensor Types}

\subsubsection{Maps Transforming Rank 1 Tensors}

\begin{enumerate}
\item 
\begin{enumerate}
\item \emph{Contravariant to covariant transformations}

\begin{enumerate}
\item Tensors $t_{0}^{2}\in V^{d}\otimes V^{d}$ define bilinear forms $%
b_{d}\in \mathcal{BI}\left( V\right) $ defined on $V$ 
\begin{equation}
b_{d}:V\times V\rightarrow \mathbb{C}
\end{equation}%
by 
\begin{equation}
b_{d}\left( v_{1},v_{2}\right) =t_{0}^{2}\left( v_{1}\otimes v_{2}\right)
\end{equation}%
these

\item tensors $t_{0}^{2}\in V^{d}\otimes V^{d}$ can be expanded wrt a bases $%
\left( \boldsymbol{f}_{d}\otimes \boldsymbol{f}_{d}\right) $ as%
\begin{gather}
t_{0}^{2}=\left( \boldsymbol{f}_{d}\otimes \boldsymbol{f}_{d}\right) 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) =\sum_{1\leq j,k\leq
r}\left( f^{j}\otimes f^{k}\right) \mathcal{R}_{f_{d}f_{d}}\left(
t_{0}^{2}\right) _{jk}=\left( 
\begin{array}{ccccc}
f^{1}\otimes f^{1} & \cdots  & f^{j}\otimes f^{k} & \cdots  & f^{r}\otimes
f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{11} \\ 
\vdots  \\ 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{jk} \\ 
\vdots  \\ 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right)  \\
=\left( \overset{}{\left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) }\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{11} \\ 
\vdots  \\ 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{jk} \\ 
\vdots  \\ 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right) ,
\end{gather}%
where 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{11} \\ 
\vdots  \\ 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{jk} \\ 
\vdots  \\ 
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \overset{}{f_{dd1}\otimes f_{dd1}}\right) \left( \overset{}{t_{0}^{2}}%
\right)  \\ 
\vdots  \\ 
\left( \overset{}{f_{ddj}\otimes f_{ddk}}\right) \left( \overset{}{t_{0}^{2}}%
\right)  \\ 
\vdots  \\ 
\left( \overset{}{f_{ddr}\otimes f_{ddr}}\right) \left( \overset{}{t_{0}^{2}}%
\right) 
\end{array}%
\right) =\left( 
\begin{array}{c}
t_{0}^{2}\left( f_{1}\otimes f_{1}\right)  \\ 
\vdots  \\ 
t_{0}^{2}\left( f_{j}\otimes f_{k}\right)  \\ 
\vdots  \\ 
t_{0}^{2}\left( f_{r}\otimes f_{r}\right) 
\end{array}%
\right) .
\end{equation}

\item 
\begin{equation}
\left( \overset{}{\left( 
\begin{array}{ccc}
f^{1}\otimes f^{1} & \cdots  & f^{r}\otimes f^{r}%
\end{array}%
\right) }\right) \left( 
\begin{array}{c}
f_{1}\otimes f_{1} \\ 
\vdots  \\ 
f_{r}\otimes f_{r}%
\end{array}%
\right) \left( \overset{}{t_{0}^{2}}\right) =\left( \overset{}{\left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) }\right) \left( \left( 
\begin{array}{c}
f_{1} \\ 
\vdots  \\ 
f_{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
f_{1} \\ 
\vdots  \\ 
f_{r}%
\end{array}%
\right) \right) \left( \overset{}{t_{0}^{2}}\right) .
\end{equation}%
This produces

\item maps $\left[ t_{0}^{2}\right] \in \mathcal{L}\left( V^{d},V\right) $
that are contravariant to covariant transformations 
\begin{equation}
\left[ t_{0}^{2}\right] :V\rightarrow V^{d}
\end{equation}%
defined by%
\begin{equation}
\left[ f^{j}f^{k}\right] \left( e_{l}\right) =\left[ f^{j}\otimes f^{k}%
\right] \left( e_{l}\right) =\left( f^{j}\right) \left( f^{k}\left(
e_{l}\right) \right) ,\quad 1\leq j,k\leq r
\end{equation}%
giving the maps

\item 
\begin{equation}
\left[ t_{0}^{2}\right] =\left[ \boldsymbol{f}_{d}\boldsymbol{f}_{d}\right] 
\mathcal{R}_{f_{d}f_{d}}\left( \left[ t_{0}^{2}\right] \right) =\sum_{1\leq
j,k\leq r}\left[ f^{j}f^{k}\right] \mathcal{R}_{f_{d}f_{d}}\left( \left[
t_{0}^{2}\right] \right) _{jk}
\end{equation}%
that produce dual functionals $v_{d}=\left[ t_{0}^{2}\right] \left( v\right)
\in V^{d}$ that are covariant and are the images of contravariant vectors $v$
and have the action

\item 
\begin{equation}
v_{d}=\left[ t_{0}^{2}\right] \left( v\right) =b_{d}\left( \cdot ,v\right) ,
\end{equation}%
and have a detailed expansion  
\begin{eqnarray}
v_{d} &=&\left[ t_{0}^{2}\right] \left( v\right) =b_{d}\left( \cdot
,v\right) =\left( \overset{}{\left[ \boldsymbol{f}_{b}\boldsymbol{f}_{b}%
\right] \mathcal{R}_{f_{b}f_{b}}\left( b_{d}\right) }\right) \left( \overset{%
}{v}\right) =\left( \sum_{1\leq j,k\leq r}\left[ f^{j}f^{k}\right] \mathcal{R%
}_{f_{b}f_{b}}\left( b_{d}\right) _{jk}\right) \left( \sum_{1\leq l\leq
r}f_{l}\mathcal{R}_{f}\left( v\right) ^{l}\right)  \\
&=&\sum_{1\leq j\leq r}f^{j}\left( \sum_{1\leq k,l\leq r}f^{k}\left(
f_{l}\right) \mathcal{R}_{f_{b}f_{b}}\left( b_{d}\right) _{jk}\mathcal{R}%
_{f}\left( v\right) ^{l}\right) =\sum_{1\leq j\leq r}f^{j}\left( \sum_{1\leq
k,l\leq r}\delta _{l}^{k}\mathcal{R}_{f_{b}f_{b}}\left( b_{d}\right) _{jk}%
\mathcal{R}_{f}\left( v\right) ^{l}\right)  \\
&=&\sum_{1\leq j,k\leq r}f^{j}\left( \mathcal{R}_{f_{b}f_{b}}\left(
b_{d}\right) _{jk}\mathcal{R}_{f}\left( v\right) ^{k}\right) =\sum_{1\leq
j\leq r}f^{j}\left( \sum_{1\leq k\leq r}\mathcal{R}_{f_{b}f_{b}}\left(
b_{d}\right) _{jk}\mathcal{R}_{f}\left( v\right) ^{k}\right) =\sum_{1\leq
j\leq r}f^{j}\mathcal{R}_{f_{d}}\left( \overset{}{\left[ b_{d}\right] \left(
v\right) }\right) _{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{f_{b}}\left( \left[ b_{d}\right] \right) 
\mathcal{R}_{f_{b}}\left( v\right) }\right) _{j}=\sum_{1\leq k\leq r}%
\mathcal{R}_{f_{b}f_{b}}\left( b_{d}\right) _{jk}\mathcal{R}_{f}\left(
v\right) ^{k}=\left( \overset{}{\mathcal{R}_{f_{b}}\left( \left[ b_{d}\right]
v\right) }\right) _{j}.
\end{equation}

\item If one expands $v$ wrt the bases $\left( \boldsymbol{e}\right) $ one
obtains a more general expression of the conversion of contravariant
coordinates to covariant coordinates as 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) _{j}=\sum_{1\leq j\leq r}f_{jb}\left(
e_{k}\right) \mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq j\leq r}\left(
S_{fe}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}.
\end{equation}

\item 
\begin{equation}
\left[ \boldsymbol{f}_{d}\boldsymbol{e}_{b}\right] =\left( \boldsymbol{f}%
_{d}\right) \left[ \left( \boldsymbol{e}_{b}\right) \right] 
\end{equation}%
\begin{eqnarray}
\left( \boldsymbol{f}_{d}\right) \left[ \left( \boldsymbol{e}_{b}\right) %
\right] \left( v\right)  &=&\left( \boldsymbol{f}_{d}\right) \left[ \left( 
\boldsymbol{e}_{b}\right) ^{t}\right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right)  \\ 
\vdots  \\ 
e^{r}\left( v\right) 
\end{array}%
\right) =\left( \boldsymbol{f}_{d}\right) \left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots  \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)  \\
&=&\left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right)  \\ 
\vdots  \\ 
e^{r}\left( v\right) 
\end{array}%
\right)  \\
&=&\left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \left( v\right) 
\end{eqnarray}%
\begin{equation}
\left( \boldsymbol{f}_{d}\right) \left[ \left( \boldsymbol{e}_{b}\right) %
\right] \left( \sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right)
^{j}\right) =\left( \boldsymbol{f}_{d}\right) \left( \sum_{1\leq j\leq
r}e^{k}\left( e_{j}\right) \mathcal{R}_{e}\left( v\right) ^{j}\right)
=\left( \boldsymbol{f}_{d}\right) \left( \sum_{1\leq j\leq r}\delta _{j}^{k}%
\mathcal{R}_{e}\left( v\right) ^{j}\right) =\left( \boldsymbol{f}_{d}\right)
\left( \sum_{1\leq j\leq r}\delta _{j}^{k}\mathcal{R}_{e}\left( v\right)
^{j}\right) 
\end{equation}
\end{enumerate}
\end{enumerate}
\end{enumerate}

\begin{theorem}
In terms of the metric tensor representation matrix $S_{fe}$ 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) _{j}=\sum_{1\leq j\leq r}f_{jb}\left(
e_{k}\right) \mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq j\leq r}\left(
S_{fe}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}.
\end{equation}
\end{theorem}

\begin{enumerate}
\item 
\begin{remark}
\begin{equation}
h_{d}\in V^{d},\,v\in V,\quad \left[ t_{0}^{2}\right] \equiv b_{d}\in
\otimes ^{2}V^{d}.
\end{equation}
\end{remark}

\item \emph{Contravariant to contravariant maps} 
\begin{equation}
\left[ t_{1}^{1}\right] :V\rightarrow V
\end{equation}%
defined by 
\begin{equation}
\left[ t_{1}^{1}\right] =\left[ \boldsymbol{ee}_{d}\right] \mathcal{R}%
_{ee_{d}}\left( \left[ t_{1}^{1}\right] \right) 
\end{equation}%
produce contravariant to contravariant transformations%
\begin{eqnarray}
w &=&\left[ t_{1}^{1}\right] \left( v\right) =A\left( v\right) =\sum_{1\leq
j,k\leq r}\left[ e_{j}e^{k}\right] \mathcal{R}_{ee_{d}}\left( A\right)
_{k}^{j}\left( \sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left( v\right)
^{l}\right)  \\
&=&\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}e^{k}\left( e_{l}\right) 
\mathcal{R}_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left( v\right)
^{l}=\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}\delta _{l}^{k}\mathcal{R%
}_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left( v\right) ^{l} \\
&=&\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}_{ee_{d}}\left( A\right) _{k}^{j}%
\mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq j\leq r}e^{j}\sum_{1\leq
k\leq r}\mathcal{R}_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left(
v\right) ^{k}=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( \overset{}{%
A\left( v\right) }\right) ^{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{ee_{d}}\left( A\right) \mathcal{R}%
_{e_{d}}\left( v\right) }\right) ^{j}=\sum_{1\leq k\leq r}\mathcal{R}%
_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left( v\right) ^{k}=\left( 
\overset{}{\mathcal{R}_{e}\left( Av\right) }\right) ^{j}.
\end{equation}

\begin{enumerate}
\item 
\begin{remark}
One can inject tensors $t_{1}^{1}$ into nuclear operators belonging to $%
\mathcal{L}_{\text{nuclear}}\left( V\right) $ 
\begin{equation}
w\in V,\quad \left[ t_{1}^{1}\right] \equiv A\in V\otimes
V^{d}\hookrightarrow \mathcal{L}_{\text{nuclear}}\left( V\right) .
\end{equation}
\end{remark}
\end{enumerate}

\item \emph{Covariant to contravariant transformations}

\begin{enumerate}
\item 
The maps 
\begin{equation}
\left[ t_{2}^{0}\right] :V^{d}\rightarrow V
\end{equation}%
defined by 
\begin{equation}
\left[ t_{2}^{0}\right] =\left[ \boldsymbol{ee}\right] \mathcal{R}%
_{ee}\left( \left[ t_{2}^{0}\right] \right) 
\end{equation}%
produce covariant to contravariant transformations 
\begin{eqnarray}
w &=&\left[ t_{2}^{0}\right] \left( h_{d}\right) =b\left( ,h_{d}\right)
=\sum_{1\leq j,k\leq r}\left[ e_{j}e_{k}\right] \mathcal{R}_{ee}\left(
h_{d}\right) ^{jk}\left( \sum_{1\leq l\leq r}e_{dl}\mathcal{R}_{e_{d}}\left(
h_{d}\right) _{l}\right)  \\
&=&\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}e_{k}\left( e^{l}\right) 
\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}\mathcal{R}_{e}\left( v_{d}\right)
_{l}=\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}\delta _{k}^{l}\mathcal{R%
}_{ee}\left( h_{d}\right) ^{jk}\mathcal{R}_{e_{d}}\left( h_{d}\right) _{l} \\
&=&\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}%
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{l}=\sum_{1\leq j\leq
r}e_{j}\sum_{1\leq k\leq r}\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}\mathcal{%
R}_{e_{d}}\left( v_{d}\right) _{l}=\sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( \overset{}{\left[ h_{d}\right] \left( v_{d}\right) }\right) ^{j},
\end{eqnarray}%
recall%
\begin{eqnarray}
h_{d} &=&\left[ t_{0}^{2}\right] \left( v\right) =b_{d}\left( \cdot
,v\right) =\sum_{1\leq j,k\leq r}\left[ e^{j}e^{k}\right] \mathcal{R}%
_{e_{d}e_{d}}\left( b_{d}\right) _{jk}\left( \sum_{1\leq l\leq r}e_{l}%
\mathcal{R}_{e}\left( v\right) ^{l}\right)  \\
&=&\sum_{1\leq j\leq r}e^{j}\left( \sum_{1\leq k,l\leq r}e^{k}\left(
e_{l}\right) \mathcal{R}_{e_{d}e_{d}}\left( b_{d}\right) _{jk}\mathcal{R}%
_{e}\left( v\right) ^{l}\right) =\sum_{1\leq j\leq r}e^{j}\left( \sum_{1\leq
k,l\leq r}\delta _{l}^{k}\mathcal{R}_{e_{d}e_{d}}\left( b_{d}\right) _{jk}%
\mathcal{R}_{e}\left( v\right) ^{l}\right)  \\
&=&\sum_{1\leq j,k\leq r}e^{j}\left( \mathcal{R}_{e_{d}e_{d}}\left(
b_{d}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}\right) =\sum_{1\leq
j\leq r}e^{j}\left( \sum_{1\leq k\leq r}\mathcal{R}_{e_{d}e_{d}}\left(
b_{d}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}\right) =\sum_{1\leq
j\leq r}e^{j}\mathcal{R}_{e_{d}}\left( \overset{}{\left[ b_{d}\right] \left(
v\right) }\right) _{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{e_{d}}\left( \left[ h_{d}\right] \right) 
\mathcal{R}_{e_{d}}\left( v_{d}\right) }\right) ^{j}=\sum_{1\leq k\leq r}%
\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}\mathcal{R}_{e_{d}}\left(
v_{d}\right) _{k}=\left( \mathcal{R}_{e_{d}}\left( \overset{}{\left[ h_{d}%
\right] v_{d}}\right) \right) ^{j}
\end{equation}

\begin{remark}
\begin{equation}
w\in V,\,h_{d}\in V^{d}\quad \left[ t_{2}^{0}\right] \equiv b\in \otimes
^{2}V.
\end{equation}
\end{remark}

\item \emph{Covariant to covariant transformations}

The maps 
\begin{equation}
\left[ \left( t_{d}\right) _{1}^{1}\right] =\left[ \boldsymbol{e}_{d}%
\boldsymbol{e}\right] \mathcal{R}_{e_{d}e}\left( \left[ \left( t_{d}\right)
_{1}^{1}\right] \right)
\end{equation}%
produce covariant to covariant transformations 
\begin{eqnarray}
w_{d} &=&\left[ \left( t_{d}\right) _{1}^{1}\right] \left( v_{d}\right)
=A^{d}\left( v_{d}\right) =\sum_{1\leq j,k\leq r}\left[ e^{j}e_{k}\right] 
\mathcal{R}_{e_{d}e}\left( A^{d}\right) _{j}^{k}\left( \sum_{1\leq l\leq
r}e^{l}\mathcal{R}_{e_{d}}\left( v_{d}\right) _{l}\right) \\
&=&\sum_{1\leq j\leq r}e^{j}\sum_{1\leq k,l\leq r}e_{k}\left( e^{l}\right) 
\mathcal{R}_{e_{d}e}\left( A^{d}\right) _{j}^{k}\mathcal{R}_{e_{d}}\left(
v_{d}\right) _{l}=\sum_{1\leq j\leq r}e^{j}\sum_{1\leq k,l\leq r}\delta
_{k}^{l}\mathcal{R}_{e_{d}e}\left( A^{d}\right) _{j}^{k}\mathcal{R}%
_{e_{d}}\left( v_{d}\right) _{l} \\
&=&\sum_{1\leq j\leq r}e^{j}\mathcal{R}_{e_{d}e}\left( A^{d}\right) _{j}^{k}%
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{k}=\sum_{1\leq j\leq
r}e^{j}\sum_{1\leq k\leq r}\mathcal{R}_{e_{d}e}\left( A^{d}\right) _{j}^{k}%
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{k}=\sum_{1\leq j\leq r}e^{j}%
\mathcal{R}_{e_{d}}\left( \overset{}{\left[ A^{d}\right] \left( v\right) }%
\right) _{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{e_{d}}\left( \left[ A^{d}\right] \right) 
\mathcal{R}_{e_{d}}\left( v_{d}\right) }\right) _{j}=\sum_{1\leq k\leq r}%
\mathcal{R}_{e_{d}e}\left( A^{d}\right) _{j}^{k}\mathcal{R}_{e_{d}}\left(
v_{d}\right) _{k}=\left( \mathcal{R}_{e_{d}}\left( \left[ \overset{}{%
A^{d}v_{d}}\right] \right) \right) _{j}
\end{equation}
\end{enumerate}
\end{enumerate}

\subsubsection{Maps Transforming Rank 2 Tensors}

\begin{enumerate}
\item Transforming second rank covaraint tensors (bilinear forms on $V)$ to
mixed second rank tensors (operators acting in $V)$ 
\begin{equation}
t_{0}^{2}=\sum_{1\leq j,k\leq r}c_{jk}e^{j}\otimes e^{k}=\sum_{1\leq j,k\leq
r}e^{j}\otimes e^{k}\mathcal{R}_{e_{d}e_{d}}\left( t_{0}^{2}\right) _{jk}
\end{equation}

\item Transforming second rank contravaraint tensors to mixed second rank
tensors (operators acting in $V)$%
\begin{equation}
t_{2}^{0}=\sum_{1\leq j,k\leq r}c^{jk}e_{j}\otimes e_{k}=\sum_{1\leq j,k\leq
r}e_{j}\otimes e_{k}\mathcal{R}_{ee}\left( t_{2}^{0}\right) ^{jk}
\end{equation}

\item 
\begin{equation}
t_{1}^{1}=\sum_{1\leq j,k\leq r}c_{k}^{j}e_{j}\otimes e^{k}=\sum_{1\leq
j,k\leq r}c_{k}^{j}e_{j}\otimes e^{k}\mathcal{R}_{ee_{d}}\left(
t_{1}^{1}\right) _{k}^{j}
\end{equation}

\item 
\begin{equation}
\left( t_{d}\right) _{1}^{1}=\sum c_{j}^{k}e^{j}\otimes e_{k}=\sum_{1\leq
j,k\leq r}c_{k}^{j}e^{j}\otimes e_{k}\mathcal{R}_{e_{d}e}\left( \left(
t_{d}\right) _{1}^{1}\right) _{j}^{k}
\end{equation}
\end{enumerate}

\subsubsection{Expansions of Operators $A\in \mathcal{L}\left( V\right) $
and $A^{d}\in \mathcal{L}\left( V^{d}\right) $}

Let $A\in \mathcal{L}\left( V\right) $ then 
\begin{gather}
A=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \left( 
\boldsymbol{e}_{d}\right) =\sum_{1\leq j,k\leq r}\left( e_{j}\right) 
\mathcal{R}_{e}\left( A\right) _{k}^{j}\left( e^{k}\right) =\sum_{1\leq
j,k\leq r}\left( e_{j}\right) \left( e^{k}\right) \mathcal{R}_{e}\left(
A\right) _{k}^{j} \\
\parallel \\
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) .
\end{gather}

\begin{notation}
The indexing in the matrix array $\mathcal{R}_{e}\left( A\right) $ is 
\begin{equation}
\mathcal{R}_{e}\left( A\right) _{\func{col}}^{\func{row}}\text{ i.e. }%
\mathcal{R}_{e}\left( A\right) _{jk}\equiv \mathcal{R}_{e}\left( A\right)
_{k}^{j}.
\end{equation}
\end{notation}

\begin{definition}
of the operator dualizing map $d\in \mathcal{L}\left( \mathcal{L}\left(
V^{d}\right) ,\mathcal{L}\left( V\right) \right) $%
\begin{equation}
d:\mathcal{L}\left( V\right) \rightarrow \mathcal{L}\left( V^{d}\right)
\end{equation}%
is given by defining the dual $A^{d}\in \mathcal{L}\left( V^{d}\right) $ of $%
A\in \mathcal{L}\left( V\right) $ by 
\begin{equation}
\left( A^{d}\boldsymbol{e}_{d}\right) \left( e\right) =\left( \boldsymbol{e}%
_{d}\right) \left( Ae\right) \quad \forall \left( e\right) \in \mathfrak{B}%
\left( V\right) .
\end{equation}
\end{definition}

The expansion of $A^{d}\in \mathcal{L}\left( V^{d}\right) $ is given by 
\begin{equation}
A^{d}=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{ed}\left( A^{d}\right)
\left( \boldsymbol{e}\right) =\sum_{1\leq j,k\leq r}\left( e^{j}\right) 
\mathcal{R}_{e_{d}}\left( A^{d}\right) _{k}^{j}\left( e_{k}\right)
=\sum_{1\leq j,k\leq r}\left( e^{j}\right) \left( e_{k}\right) \mathcal{R}%
_{e_{d}}\left( A^{d}\right) _{k}^{j}.
\end{equation}

Hence 
\begin{equation}
\left( \sum_{1\leq j,k\leq r}\left( e_{j}\right) \mathcal{R}_{e}\left(
A\right) _{k}^{j}\left( e^{k}\right) \right) ^{d}=\sum_{1\leq j,k\leq
r}\left( e^{j}\right) \mathcal{R}_{e_{d}}\left( A^{d}\right) _{j}^{k}\left(
e_{k}\right) .
\end{equation}%
In detail 
\begin{eqnarray}
&&\left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right) ^{d}=\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) ^{d}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{d}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) ^{d} \\
&=&\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{d}\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A^{d}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{d}\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A^{d}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) .
\end{eqnarray}%
i.e. 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A^{d}\right) =\mathcal{R}_{e}\left( A\right) ^{t}.
\end{equation}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{d}\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A^{d}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{d}\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A^{d}\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{d}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}.
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) ^{d}=\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) ^{t}.
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) ^{d}=\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) ^{t}.
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{gather}
A^{d} \\
\parallel \\
\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{d}\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A^{d}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{d}\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A^{d}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \\
\parallel
\end{gather}
\end{remark}

\begin{remark}
The action of the operator $A\in \mathcal{L}\left( V\right) \ $on
contravariant vectors $v\in V$ is 
\begin{equation}
Av=A\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left(
v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}_{e}\left( A\right) _{k}^{j}%
\mathcal{R}_{e}\left( v\right) ^{k},
\end{equation}%
where the matrix representation has the form 
\begin{equation}
\mathcal{R}_{e}\left( A\right) _{\func{col}}^{\func{row}}.
\end{equation}
\end{remark}

\begin{theorem}
\begin{equation}
\mathcal{R}_{e_{d}}\left( A^{d}\right) =\mathcal{R}_{e}\left( A\right) ^{t}.
\end{equation}

\begin{proof}
\begin{eqnarray}
\left( A^{d}e_{dj}\right) \left( e_{k}\right) &=&e_{dj}\left( Ae_{k}\right)
\\
&\parallel & \\
\left( A^{d}e^{j}\right) \left( e_{k}\right) &=&e^{j}\left( Ae_{k}\right) \\
&\parallel & \\
\left( \sum_{1\leq l\leq r}e_{dl}\mathcal{R}_{e_{d}}\left( A^{d}\right)
_{j}^{l}\right) \left( e_{k}\right) &=&\left( e^{j}\right) \left(
\sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left( A\right) _{k}^{l}\right) \\
&\parallel & \\
\sum_{1\leq l\leq r}e_{dl}\left( e_{k}\right) \mathcal{R}_{e_{d}}\left(
A^{d}\right) _{j}^{l} &=&\sum_{1\leq l\leq r}e^{j}\left( e_{l}\right) 
\mathcal{R}_{e}\left( A\right) _{k}^{l} \\
&\parallel & \\
\mathcal{R}_{e_{d}}\left( A^{d}\right) _{j}^{k} &=&\mathcal{R}_{e}\left(
A\right) _{k}^{j}
\end{eqnarray}
\end{proof}
\end{theorem}

\begin{remark}
\begin{equation}
\left( \left( e_{j}\right) ^{d}\right) ^{d}=\left( e_{dj}\right) ^{d}=\left(
e^{j}\right) ^{d}=e_{j},\,1\leq j\leq r.
\end{equation}%
i.e. $d$ is a linear involution.
\end{remark}

\begin{remark}
In the infinite dimensional case $V^{d}$ has greater cardenality than $V$ so
the duality map is an injection but not a surjection.
\end{remark}

\subsubsection{Biorthogonal Transformation of Dual Bases}

Recall that biorthogonality is defined by 
\begin{equation}
\left( \boldsymbol{e}_{d}\right) \left( e\right) =\left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( e_{1}\right) & \cdots & e^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( e_{1}\right) & \cdots & e^{r}\left( e_{r}\right)%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}

A basis transformation $\left( \boldsymbol{e}\right) $ to $\left( 
\boldsymbol{f}\right) $ of $V$ is produced by a transformation $T\in
GL\left( V\right) $ given by 
\begin{equation}
f_{j}=Te_{j}=\sum_{1\leq k\leq r}e_{k}\mathcal{R}_{e}\left( T\right)
_{j}^{k},\,1\leq j\leq r
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}\right) =T\left( \boldsymbol{e}\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( T\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
T\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e^{1}\left( Te_{1}\right) & \cdots & e^{1}\left( Te_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( Te_{1}\right) & \cdots & e^{r}\left( Te_{r}\right)%
\end{array}%
\right) .
\end{equation}%
This produces the transformation of the dual basis $\left( \boldsymbol{e}%
_{d}\right) $ 
\begin{equation}
f_{dj}=f^{j}=T^{d}e_{dj}=\sum_{1\leq k\leq r}e^{k}\mathcal{R}_{e_{d}}\left(
T^{d}\right) _{k}^{j},\,1\leq j\leq r
\end{equation}%
i.e. 
\begin{eqnarray}
\left( \boldsymbol{f}_{d}\right) &=&T^{d}\left( \boldsymbol{e}_{d}\right)
=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e_{d}}\left( T^{d}\right)
=\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( T^{d}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( T^{d}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( T^{d}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e_{d}}\left( T^{d}\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{d1} & \cdots & e_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e^{1}\left( Te_{1}\right) & \cdots & e^{1}\left( Te_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( Te_{1}\right) & \cdots & e^{r}\left( Te_{r}\right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1}\left( T^{d}e^{1}\right) & \cdots & e_{1}\left( T^{d}e^{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{r}\left( T^{d}e^{1}\right) & \cdots & e_{r}\left( T^{d}e^{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( T^{d}e^{1}\right) \left( e_{1}\right) & \cdots & \left(
T^{d}e^{r}\right) \left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( T^{d}e^{1}\right) \left( e_{r}\right) & \cdots & \left(
T^{d}e^{r}\right) \left( e_{r}\right)%
\end{array}%
\right) .
\end{eqnarray}

As $T\in GL\left( V\right) $ then 
\begin{equation}
I_{V}=\left( \boldsymbol{e}_{d}\right) \left( e\right) =\left( \boldsymbol{e}%
_{d}\right) T^{-1}T\left( e\right) =\left( \boldsymbol{f}_{d}\right) \left( 
\boldsymbol{f}\right) =\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) T^{-1}T\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right)
\end{equation}%
\begin{equation}
\left( \boldsymbol{f}_{d}\right) \left( \boldsymbol{f}\right) =\left( \left(
T\boldsymbol{e}\right) ^{d}\right) \left( \left( T\boldsymbol{e}\right)
\right) =
\end{equation}

\begin{definition}
\begin{enumerate}
\item A vector $h$ is called \emph{covariant} if its coordinates transform
in the same way as the basis of $V$ transforms, their coordinate indices are
displayed as subscripts that index columns i.e. 
\begin{equation}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( h\right) _{1} & \cdots & \mathcal{R}_{e}\left(
h\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
h\left( e_{1}\right) & \cdots & h\left( e_{r}\right)%
\end{array}%
\right) ,
\end{equation}%
covariant vectors belong to the dual space $V^{d}$

\item A vector is called \emph{contravariant} if its coordinates transform
in the inverse way to basis transformations of $V$, their coordinate indices
are superscripts that index rows i.e. 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) ,
\end{equation}%
contravariant vectors belong to the space $V.$
\end{enumerate}
\end{definition}

\begin{enumerate}
\item Sets of \emph{covariant tensors} are indexed by superscripts i.e. $%
\left\{ \left. h^{j}\in V^{d}\right\vert 1\leq j\leq n\right\} .$

\item Sets of \emph{contravariant tensors} are indexed by subscripts i.e. $%
\left\{ \left. v_{j}\in V\right\vert 1\leq j\leq n\right\} .$hence

\item 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A^{d}\right) =\mathcal{R}_{e}\left( A\right) ^{t}.
\end{equation}
\end{enumerate}

\begin{remark}
\begin{enumerate}
\item Contravariant vector $v\in V$%
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}=\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) .
\end{equation}

\item Covariant vector $h\in V^{d}$ 
\begin{equation}
h=\sum_{1\leq j\leq r}e_{d}^{j}\mathcal{R}_{e_{d}}\left( h\right)
_{j}=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e_{d}}\left( h\right)
=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( h\right) _{1} & \cdots & \mathcal{R}_{e_{d}}\left(
h\right) _{1}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{d}^{1} \\ 
\vdots \\ 
e_{,d}^{r}%
\end{array}%
\right) \equiv \left( 
\begin{array}{ccc}
\mathcal{R}_{e^{d}}\left( h\right) _{1} & \cdots & \mathcal{R}_{e^{d}}\left(
h\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
Matrix elements

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
e^{j}\left( Ae_{k}\right) =e^{j}\left( \sum_{1\leq l\leq r}e_{l}\mathcal{R}%
_{e}\left( A\right) _{k}^{l}\right) =\sum_{1\leq l\leq r}e^{j}\left(
e_{l}\right) \mathcal{R}_{e}\left( A\right) _{k}^{l}=\mathcal{R}_{e}\left(
A\right) _{k}^{j}
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) _{\func{col}}^{\func{row}}=\mathcal{R}%
_{e}\left( A\right) _{\func{row},\func{col}}
\end{equation}%
giving%
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e^{1}\left( Ae_{1}\right) & \cdots & e^{r}\left( Ae_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{1}\left( Ae_{r}\right) & \cdots & e^{r}\left( Ae_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \equiv \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{11} & \cdots & \mathcal{R}_{e}\left(
A\right) _{1r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{r1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{rr}%
\end{array}%
\right)
\end{equation}%
note that the superscript corresponds to rows of the matrix while subscripts
to the columns.

\item 
\begin{equation}
\left( \boldsymbol{e}_{d}\right) \left( Ae\right) =\left[ \left( \boldsymbol{%
e}_{d}\right) \left( e\right) \right] \mathcal{R}_{e}\left( A\right) =%
\mathcal{R}_{e}\left( A\right) .
\end{equation}

\item 
\begin{equation}
A=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \left( 
\boldsymbol{e}_{d}\right) =\sum_{1\leq j,k\leq r}\left( e_{j}\right) \left(
e^{j}\right) A\left( e_{k}\right) \left( e^{k}\right) =\sum_{1\leq j,k\leq
r}\left( e_{j}\right) \left( e^{k}\right) \mathcal{R}_{e}\left( A\right)
_{k}^{j}
\end{equation}
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
\left( A^{d}e^{j}\right) \left( e_{k}\right) =\left( \sum_{1\leq l\leq
r}e^{l}\mathcal{R}_{e_{d}}\left( A^{d}\right) _{l}^{j}\right) \left(
e_{k}\right) =\sum_{1\leq l\leq r}e^{l}\left( e_{k}\right) \mathcal{R}%
_{e_{d}}\left( A^{d}\right) _{l}^{j}=\mathcal{R}_{e_{d}}\left( A^{d}\right)
_{k}^{j}
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A^{d}\right) =\left( 
\begin{array}{ccc}
\left( A^{d}e^{1}\right) \left( e_{1}\right) & \cdots & \left(
A^{d}e^{1}\right) \left( Ae_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( A^{d}e^{r}\right) \left( Ae_{r}\right) & \cdots & \left(
A^{d}e^{r}\right) \left( Ae_{r}\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\left( A^{d}\boldsymbol{e}_{d}\right) \left( e\right) =\left( \boldsymbol{e}%
_{d}\right) \left( e\right) \mathcal{R}_{e_{d}}\left( A^{d}\right) =\mathcal{%
R}_{e_{d}}\left( A^{d}\right) .
\end{equation}

\item 
\begin{equation}
A^{d}=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e_{d}}\left(
A^{d}\right) \left( \boldsymbol{e}\right) =\sum_{1\leq j,k\leq r}\left(
e^{j}\right) \left( A^{d}e^{j}\right) \left( e_{k}\right) \left(
e_{k}\right) =\sum_{1\leq j,k\leq r}\left( e^{j}\right) \left( e_{k}\right) 
\mathcal{R}_{e_{d}}\left( A^{d}\right) _{j}^{k}
\end{equation}%
Hence 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A^{d}\right) =\mathcal{R}_{e}\left( A\right) .
\end{equation}%
\begin{equation}
\left( \boldsymbol{e}_{d}\right) \left( Ae\right) =\left( \boldsymbol{e}%
_{d}\right) \left( e\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}%
_{e}\left( A\right) .
\end{equation}
\end{enumerate}
\end{enumerate}
\end{remark}

\subsubsection{Expansion of Vectors}

\begin{enumerate}
\item Let $v\in V$ then 
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{e}\right) \boldsymbol{e}_{d}\left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\boldsymbol{e}_{d1}\left( v\right) \\ 
\vdots \\ 
\boldsymbol{e}_{dr}\left( v\right)%
\end{array}%
\right) ,
\end{equation}%
i.e.

\begin{enumerate}
\item The expansions can be expressed as 
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}=\sum_{1\leq
j\leq r}e_{j}e_{dj}\left( v\right) =\sum_{1\leq j\leq r}e_{j}e^{j}\left(
v\right) .
\end{equation}

\item The action of $V\otimes V^{d}$ on $V$ can be expressed by 
\begin{equation}
I_{V}\overset{\limfunc{def}}{=}\left[ \boldsymbol{ee}_{d}\right] =\left( 
\boldsymbol{e}\right) \left( \boldsymbol{e}_{d}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{d1} \\ 
\vdots \\ 
e_{dr}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{1}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{j}e_{dj}=\sum_{1\leq j\leq r}e_{j}e^{j},
\end{equation}

\item giving%
\begin{eqnarray}
v &=&I_{V}v=\left[ \boldsymbol{ee}_{d}\right] \left( v\right) =\left( 
\boldsymbol{e}\right) \boldsymbol{e}_{d}\left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{d1}\left( v\right) \\ 
\vdots \\ 
e_{dr}\left( v\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) \\
&=&\sum_{1\leq j\leq r}e_{j}e_{dj}\left( v\right) =\sum_{1\leq j\leq
r}e_{j}e^{j}\left( v\right) =\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left(
v\right) ^{j}.
\end{eqnarray}
\end{enumerate}
\end{enumerate}

\subsubsection{Basis Transformations}

\begin{enumerate}
\item 
\begin{enumerate}
\item Let $A\in GL\left( V\right) $ then 
\begin{gather}
A\left( \boldsymbol{e}\right) =A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \\
\parallel \\
\left( \boldsymbol{f}\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) .
\end{gather}

\item As 
\begin{equation}
A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right)
\end{equation}%
one obtains 
\begin{eqnarray}
v &=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( v\right) \\
&=&A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( v\right)
\end{eqnarray}%
hence 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right) .
\end{equation}

\item $A$ can be expressed in terms of the biorthogonal bases $\left\{ 
\boldsymbol{e}_{d}\boldsymbol{,e}\right\} $ and $\left\{ \boldsymbol{f}_{d}%
\boldsymbol{,f}\right\} $ as 
\begin{equation}
A=\left[ \boldsymbol{fe}_{d}\right] .
\end{equation}

\item A vector $v\in \mathcal{B}\left( V\right) $ can be expressed as 
\begin{equation}
v=\left( \boldsymbol{f}\right) \mathcal{R}_{f}\left( v\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right)
\end{equation}

\item giving the effect of basis transformation as 
\begin{equation}
v=\left( \boldsymbol{f}\right) \mathcal{R}_{f}\left( f\right) =A\left( 
\boldsymbol{e}\right) \mathcal{R}_{f}\left( v\right) =\left( \boldsymbol{e}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{f}\left( v\right)
=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) ,
\end{equation}

\item hence%
\begin{gather}
\mathcal{R}_{e}\left( v\right) =\mathcal{R}_{e}\left( A\right) \mathcal{R}%
_{f}\left( v\right) \\
\Downarrow \\
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right) ,
\end{gather}%
so the representation $\mathcal{R}_{e}\left( v\right) $ of $v$ transform by
the inverse of the representation $\mathcal{R}_{e}\left( A\right) .$

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
Ae_{j}=\sum_{1\leq k\leq r}e_{k}\mathcal{R}_{e}\left( A\right)
_{j}^{k},\,1\leq j\leq r
\end{equation}

\item 
\begin{equation}
A^{d}e_{dj}=\sum_{1\leq k\leq r}e_{dk}\mathcal{R}_{e}\left( A^{d}\right)
_{j}^{k}=\sum_{1\leq k\leq r}e^{k}\mathcal{R}_{e}\left( A^{d}\right)
_{j}^{k},\,1\leq j\leq r
\end{equation}

\item 
\begin{equation}
\left( Ae_{j}\right) ^{d}=A^{d}e_{dj}=\left( \sum_{1\leq k\leq r}e_{k}%
\mathcal{R}_{e}\left( A\right) _{j}^{k}\right) ^{d}=\sum_{1\leq k\leq
r}e_{dk}\mathcal{R}_{e}\left( A^{d}\right) _{j}^{k}=\sum_{1\leq k\leq r}e^{k}%
\mathcal{R}_{e}\left( A^{d}\right) _{j}^{k},\,1\leq j\leq r
\end{equation}

\item 
\begin{equation}
Ae_{j}=\sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left( A\right)
_{j}^{l},\,1\leq j\leq r
\end{equation}%
\begin{equation}
A^{d}e^{j}=\sum_{1\leq l\leq r}e^{l}\mathcal{R}_{e_{d}}\left( A^{d}\right)
_{l}^{j},\,1\leq j\leq r
\end{equation}
\end{enumerate}

\begin{definition}
The dual transformation is defined as 
\begin{equation}
\left( A_{d}\boldsymbol{e}_{d}\right) \left( \boldsymbol{e}\right) =\left( 
\boldsymbol{e}_{d}\right) \left( A\boldsymbol{e}\right)
\end{equation}%
\begin{equation}
\,\,e^{j}\left( Ae_{k}\right) =\,e^{j}\left( \sum_{1\leq l\leq r}e_{l}%
\mathcal{R}_{e}\left( A\right) _{k}^{l}\right) =\sum_{1\leq l\leq
r}\,e^{j}\left( e_{l}\right) \mathcal{R}_{e}\left( A\right) _{k}^{l}=%
\mathcal{R}_{e}\left( A\right) _{k}^{j}
\end{equation}%
\begin{equation}
\left( A_{d}\,\,e^{j}\right) \left( e_{k}\right) =\left( \sum_{1\leq l\leq
r}e^{l}\mathcal{R}_{e_{d}}\left( A^{d}\right) _{l}^{j}\right) \left(
e_{k}\right) =\sum_{1\leq l\leq r}e^{l}\left( e_{k}\right) \mathcal{R}%
_{e_{d}}\left( A^{d}\right) _{l}^{j}=\mathcal{R}_{e_{d}}\left( A^{d}\right)
_{k}^{j}
\end{equation}
\end{definition}
\end{remark}

\begin{remark}
This gives 
\begin{equation}
\left( Ae_{j}\right) ^{d}=\left( \sum_{1\leq k\leq r}e_{k}\mathcal{R}%
_{e}\left( A\right) _{j}^{k}\right) ^{d}=\sum_{1\leq k\leq r}e_{k}^{d}%
\mathcal{R}_{e}\left( A\right) _{j}^{k}=\sum_{1\leq k\leq r}e^{k}\mathcal{R}%
_{e}\left( A\right) _{j}^{k}
\end{equation}
\end{remark}

\item 
\begin{equation}
\mathbb{I}_{r}=\left( 
\begin{array}{c}
e_{1}^{d} \\ 
\vdots \\ 
e_{r}^{d}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f_{1}^{d} \\ 
\vdots \\ 
f_{r}^{d}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{equation}%
\begin{equation}
\mathbb{I}_{r}=\left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e^{1}A^{d} \\ 
\vdots \\ 
e^{r}A^{d}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
A^{d}e_{1} & \cdots & A^{d}e_{r}%
\end{array}%
\right)
\end{equation}
\end{enumerate}

\item An operator $A\in \mathcal{B}\left( V\right) $ can be expressed in
dydadic form as 
\begin{equation}
A=\left[ \boldsymbol{eAe}^{d}\right] =\left( \boldsymbol{e}\right) A\left( 
\boldsymbol{e}^{d}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) A\left( 
\begin{array}{c}
e_{1}^{d} \\ 
\vdots \\ 
e_{r}^{d}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) A\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}_{e}\left( A\right)
_{k}^{j}e^{k}
\end{equation}

\begin{enumerate}
\item The identity matrix $\mathbb{I}_{r}\in \mathcal{M}\left( r,r,\mathbb{C}%
\right) $ can be expressed as 
\begin{equation}
\mathbb{I}_{r}=\boldsymbol{f}^{d}\left( \boldsymbol{f}\right) =\boldsymbol{e}%
^{d}\left( \boldsymbol{e}\right) =\boldsymbol{f}^{d}\left( A\boldsymbol{e}%
\right) =\boldsymbol{A}^{d}\boldsymbol{f}^{d}\left( \boldsymbol{e}\right) ,
\end{equation}%
which in detail gives%
\begin{equation}
\boldsymbol{f}^{d}\left( \boldsymbol{f}\right) =\boldsymbol{f}^{d}\left( A%
\boldsymbol{e}\right) =\boldsymbol{f}^{d}\left( \boldsymbol{e}\right) 
\mathcal{R}_{e}\left( A\right) =\sum_{1\leq j,k,l\leq r}f^{j}\left(
e_{k}\right) \mathcal{R}_{e}\left( A\right) _{l}^{k}=\left[ \boldsymbol{f}%
_{e}^{d}\mathcal{R}_{e}\left( A\right) \right] \left( \boldsymbol{e}\right) =%
\left[ \sum_{1\leq j,k,l\leq r}\mathcal{R}_{f}\left( A\right)
_{j}^{k}f_{e}^{j}\right] \left( e_{l}\right)
\end{equation}%
showing that%
\begin{equation}
\boldsymbol{f}^{d}\left( A\boldsymbol{e}\right) =\mathcal{R}_{f}\left(
A\right) \boldsymbol{f}^{d}\left( \boldsymbol{e}\right) .
\end{equation}

\item 
\begin{equation}
v^{d}=\left( \boldsymbol{f}^{d}\right) \mathcal{R}_{f}\left( v^{d}\right)
=\left( \boldsymbol{e}^{d}\right) \mathcal{R}_{e}\left( v^{d}\right)
\end{equation}
\end{enumerate}
\end{enumerate}

\subsubsection{\textbf{Contravariant tensors} (rank-1) are vectors in $V$.}

\begin{definition}
\begin{equation}
\mathcal{R}_{e}\left( v_{1}\right) ^{i}\rightarrow \sum_{1\leq j\leq r}(%
\mathcal{R}_{e}\left( A\right) ^{-1})_{j}^{i}\mathcal{R}_{e}\left(
v_{1}\right) ^{j}.
\end{equation}
\end{definition}

They have upper index coordinates i.e. 
\begin{equation}
v_{1}=\sum_{1\leq i\leq r}e_{i}\mathcal{R}_{e}\left( v_{1}\right) ^{i}
\end{equation}%
i.e.%
\begin{equation}
v_{1}=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v_{1}\right)
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v_{1}\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v_{1}\right) ^{r}%
\end{array}%
\right) .
\end{equation}%
They are called contravariant vectors as under a basis transformation from $%
\{e_{i}\}$ to $\{f_{i}\}$, they transform inversely : The transformation of
the basis $\{e_{i}\}$ gives 
\begin{gather}
v_{d}^{1}=\left( \boldsymbol{f}_{d}\right) \mathcal{R}_{f_{d}}\left(
v_{d}^{1}\right) =A\left( \boldsymbol{e}_{d}\right) \mathcal{R}%
_{f_{d}}\left( v_{d}^{1}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}%
_{e_{d}}\left( A\right) \mathcal{R}_{f_{d}}\left( v_{d}^{1}\right) \\
\Downarrow \\
\mathcal{R}_{e_{d}}\left( v_{d}^{1}\right) =\mathcal{R}_{e_{d}}\left(
A\right) \mathcal{R}_{f}\left( v_{d}^{1}\right) \\
\Downarrow \\
\mathcal{R}_{f}\left( v_{d}^{1}\right) =\mathcal{R}_{e_{d}}\left( A\right)
^{-1}\mathcal{R}_{e_{d}}\left( v_{d}^{1}\right) .
\end{gather}

\subsubsection{\textbf{Covariant tensors} (rank-1) are covectors in $V^{d}.$
They have lower index coordinates i.e. 
\protect\begin{equation}
v_{d}^{1}=\sum_{1\leq i\leq r}e_{i}\mathcal{R}_{e}\left( v_{d}^{1}\right)
^{i} 
\protect\end{equation}%
i.e.%
\protect\begin{equation}
v_{d}^{1}=\mathcal{R}_{e}\left( v_{d}^{1}\right) \left( \boldsymbol{e}%
_{d}\right) =\left( 
\protect\begin{array}{ccc}
\mathcal{R}_{e}\left( v_{d}^{1}\right) _{1} & \cdots & \mathcal{R}_{e}\left(
v_{d}^{1}\right) _{r}%
\protect\end{array}%
\right) \left( 
\protect\begin{array}{c}
e_{d}^{1}\protect \\ 
\vdots \protect \\ 
e_{d}^{r}%
\protect\end{array}%
\right) . 
\protect\end{equation}%
Their components transform the same as basis as: 
\protect\begin{equation*}
\mathcal{R}_{e}\left( v_{d}^{1}\right) ^{i}\rightarrow \sum_{1\leq j\leq r}(%
\mathcal{R}_{e}\left( A\right) ^{-1})_{j}^{i}\mathcal{R}_{e}\left(
v_{d}^{1}\right) ^{j}. 
\protect\end{equation*}%
\protect\begin{equation*}
f_{j}^{1}\rightarrow \sum_{1\leq i\leq r}\mathcal{R}_{e}\left( A\right)
_{j}^{i}\mathcal{R}_{e}\left( f^{1}\right) _{i}. 
\protect\end{equation*}%
They have lower index coordinates i.e. 
\protect\begin{equation}
f^{1}=\sum_{1\leq i\leq r}f^{di}\mathcal{R}_{e}\left( f^{1}\right) _{i} 
\protect\end{equation}%
They are called covariant vectors as under a basis transformation from $%
\{e_{i}\}$ to $\{f_{i}\}$, they transform in the same way as the basis: 
\protect\begin{equation*}
\mathcal{R}_{e}\left( f^{1}\right) _{i}\rightarrow \sum_{1\leq j\leq r}(%
\mathcal{R}_{e}\left( A\right) )_{j}^{i}\mathcal{R}_{e}\left( f_{1}\right)
_{j}. 
\protect\end{equation*}%
They have upper index coordinates i.e. 
\protect\begin{equation}
v_{1}=\sum_{1\leq i\leq r}e_{i}\mathcal{R}_{e}\left( v_{1}\right) ^{i} 
\protect\end{equation}%
i.e.%
\protect\begin{equation}
f^{1}=\mathcal{R}_{e^{d}}\left( f^{1}\right) \left( \boldsymbol{e}%
^{d}\right) =\left( 
\protect\begin{array}{ccc}
\mathcal{R}_{e^{d}}\left( f^{1}\right) _{1} & \cdots & \mathcal{R}%
_{e^{d}}\left( f^{1}\right) _{r}%
\protect\end{array}%
\right) \left( 
\protect\begin{array}{c}
e_{1}^{d}\protect \\ 
\vdots \protect \\ 
e_{r}^{d}%
\protect\end{array}%
\right) 
\protect\end{equation}%
}

The \textbf{metric tensor} $g$ provides an isomorphism $V\leftrightarrow
V^{d}$, allowing index raising/lowering: 
\begin{equation*}
\mathcal{R}_{e^{d}}\left( v\right) _{j}=\sum_{1\leq i\leq r}g_{ji}\mathcal{R}%
_{e^{d}}\left( v\right) \left( v\right) ^{i},\quad \mathcal{R}_{e^{d}}\left(
v\right) ^{i}=\sum_{1\leq i\leq r}g^{ij}v_{j}.
\end{equation*}

\section{Operators as Mixed (1,1)-Tensors}

A linear operator $T: V \to V $ corresponds to a \textbf{mixed tensor} $%
\mathbf{T} = T_i^j e_j \otimes e^i \in V \otimes V^* $:

\begin{itemize}
\item Acts on vectors: $\mathbf{T}(v) = T_i^j v^i e_j $.

\item Acts on covectors: $\mathbf{T}(\omega) = T_i^j \omega_j e^i $.

\item In quantum mechanics, this becomes $\hat{T}=T_{ij}\left\vert
e_{i}\right\rangle \left\langle e_{j}\right\vert $.
\end{itemize}

\section{Antilinearity in Quantum Mechanics}

For a complex Hilbert space $\mathcal{H} $:

\begin{itemize}
\item The inner product induces an \textbf{antilinear isomorphism} $\mathcal{%
H}\simeq \mathcal{H}^{\ast }$: 
\begin{equation*}
\left\vert \varphi \right\rangle \mapsto \left\langle \varphi \right\vert
,\quad \text{where }\left\langle a\varphi \right\vert \text{ }=a^{\ast
}\left\langle \varphi \right\vert .
\end{equation*}

\item This ensures probability conservation: $|\left\langle \phi |\psi %
\middle||\right\rangle ^{2}$ is invariant under $\left\vert \psi
\right\rangle \rightarrow e^{i\theta }\left\vert \psi \right\rangle $.
\end{itemize}

\section{Hilbert-Schmidt Operators vs. Bounded Operators}

The space $\text{HS}(\mathcal{H}) $ of Hilbert-Schmidt operators is a proper
subset of $\mathcal{B}(\mathcal{H}) $ in infinite dimensions:

\begin{itemize}
\item \textbf{Surjectivity failure}: The identity $I $ is bounded but not
Hilbert-Schmidt: 
\begin{equation*}
\|I\|_{\text{op}} = 1 < \infty, \quad \|I\|_{\text{HS}}^2 =
\sum_{n=1}^\infty 1 = \infty.
\end{equation*}

\item \textbf{Norm inequivalence}: For finite-rank projections $P_N $: 
\begin{equation*}
\|P_N\|_{\text{op}} = 1, \quad \|P_N\|_{\text{HS}} = \sqrt{N} \to \infty.
\end{equation*}

\item No Banach isomorphism exists because $\text{HS}(\mathcal{H}) $ is
neither closed in $\mathcal{B}(\mathcal{H}) $ nor norm-equivalent.
\end{itemize}

\section*{Key Takeaways}

\begin{itemize}
\item \textbf{Covariant/contravariant distinction} arises from dual spaces
and metric-induced isomorphisms.

\item \textbf{Antilinearity} in QM ensures consistency with probability
rules.

\item \textbf{Hilbert-Schmidt operators} form a strict subspace of bounded
operators in infinite dimensions, with no norm-preserving isomorphism.
\end{itemize}

\begin{remark}
The set of nuclear operators acting in an infinite dimensional complex
Hilbert space when closed under the trace class norm produces the subspace
of trace class operators, when closed under the Hilbert-Schmidt norm
produces the Hilbert-Schmidt operators, when closed under the operator
normproduces the compact operators. The space of nuclear operators is
isomorphito the spaces of second rank covariant, the space of second order
contravariant and the space of mixed contra-covariant tensors. Can one
define norms on these spaces using the underlying Hilbert space that mimics
these norms and the strong operator topology norm by using the
bilinearnature of these tensors on the underlying Hilbert space.
\end{remark}

\begin{remark}
Yes, one can define norms on the spaces of second-rank covariant,
contravariant, and mixed tensors over a Hilbert space $\mathcal{H}$ that
mimic the trace-class, Hilbert-Schmidt, and operator norms, as well as the
strong operator topology. The key is to leverage the bilinear (or
sesquilinear) nature of these tensors and the underlying Hilbert space
structure.
\end{remark}

\begin{definition}
The anti linear injection $\digamma \in \mathcal{B}\left( \mathcal{H}^{d},%
\mathcal{H}\right) $%
\begin{equation}
\digamma :\mathcal{H}\rightarrow \mathcal{H}^{d}
\end{equation}%
is given by 
\begin{equation}
\left\vert y^{d}\right\rangle =\digamma \left( \left\vert y\right\rangle
\right) =\left\langle y_{j}\right\vert .
\end{equation}
\end{definition}

\begin{definition}
The map $\Xi _{1}^{1}\in \mathcal{B}\left( \mathcal{B}_{00}\left( \mathcal{H}%
\right) ,\otimes _{1}^{1}\mathcal{H}\right) $ 
\begin{equation}
\Xi _{1}^{1}:\otimes _{1}^{1}\mathcal{H\rightarrow B}_{00}\left( \mathcal{H}%
\right)
\end{equation}%
is defined as%
\begin{equation}
\Xi _{1}^{1}\left( T\right) =\Xi _{1}^{1}\left( \sum_{1\leq i,j\leq
r}x_{i}\otimes y_{j}^{d}\right) =\Xi _{1}^{1}\left( \sum_{1\leq i,j\leq
r}\left\vert x_{i}\right\rangle \otimes \left\langle y_{j}\right\vert
\right) =\sum_{1\leq i,j\leq r}\left\vert x_{i}\right\rangle \left\langle
y_{j}\right\vert .
\end{equation}
\end{definition}

\section{Tensor Representations of Bilinear Forms and Operators}

Let $\mathcal{H}$ be a complex Hilbert space, and let $\mathcal{H}^{d}$ be
its dual. The spaces you mentioned correspond to the following tensor
products:

\begin{enumerate}
\item \textbf{Second-rank covariant tensors}: $T^{\left( 2\right) }\equiv
T^{d}\in \mathcal{H}^{d}\otimes \mathcal{H}^{d}$ (bilinear forms on $%
\mathcal{H}\times \mathcal{H}$)%
\begin{eqnarray}
\left\langle \overset{}{T^{\left( 2\right) },v_{1}\otimes v_{2}}%
\right\rangle &=&T^{\left( 2\right) }\left( v_{1},v_{2}\right) =\left[
\sum_{1\leq i,j\leq r}x_{i}^{d}\otimes y_{j}^{d}\right] \left(
v_{1},v_{2}\right) \\
&=&\sum_{1\leq i,j\leq r}x_{i}^{d}\left( v_{1}\right) y_{j}^{d}\left(
v_{2}\right) =\left\langle \left. \sum_{1\leq i,j\leq r}x_{i}\otimes
y_{j}\right\vert v_{1}\otimes v_{2}\right\rangle =\sum_{1\leq i,j\leq
r}\left\langle \left. x_{i}\right\vert v_{1}\right\rangle \left\langle
\left. y_{i}\right\vert v_{2}\right\rangle .
\end{eqnarray}

\item \textbf{Second-rank contravariant tensors}: $T_{\left( 2\right)
}\equiv T\in \mathcal{H}\otimes \mathcal{H}$ (bilinear forms on $\mathcal{H}%
^{d}\times \mathcal{H}^{d}$)%
\begin{eqnarray}
\left\langle \overset{}{v_{1}^{d}\otimes v_{2}^{d},}T_{\left( 2\right)
}\right\rangle &=&T_{\left( 2\right) }\left( v_{1}^{d},v_{2}^{d}\right) =%
\left[ \sum_{1\leq i,j\leq r}x_{j}\otimes y_{j}\right] \left(
v_{1}^{d},v_{2}^{d}\right) \\
&=&\sum_{1\leq i,j\leq r}x_{i}\left( v_{1}^{d}\right) y_{j}\left(
v_{2}^{d}\right) =\sum_{1\leq i,j\leq r}v_{1}^{d}\left( x_{i}\right)
v_{2}^{d}\left( x_{j}\right) =\left\langle \left. \overset{}{v_{1}\otimes
v_{2}}\right\vert \sum_{1\leq i,j\leq r}x_{i}\otimes y_{j}\right\rangle
=\sum_{1\leq i,j\leq r}\left\langle \left. v_{1}\right\vert
x_{i}\right\rangle \left\langle \left. v_{2}\right\vert y_{i}\right\rangle .
\end{eqnarray}

\item \textbf{Mixed (contra-covariant) tensors}: 
\begin{equation}
T_{\left( 1\right) }^{\left( 1\right) }=\sum_{1\leq i,j\leq r}x_{i}\otimes
y_{j}^{d}\in \mathcal{H}\otimes \mathcal{H}^{d}
\end{equation}%
produce linear maps 
\begin{equation}
T=\Xi _{1}^{1}\left( T_{\left( 1\right) }^{\left( 1\right) }\right) :%
\mathcal{H}\rightarrow \mathcal{H}
\end{equation}%
that act as operators $\Xi _{1}^{1}\left( T_{\left( 1\right) }^{\left(
1\right) }\right) \in \mathcal{B}\left( \mathcal{H}\right) $ in $\mathcal{H}$
by 
\begin{equation}
\Xi _{1}^{1}\left( T_{\left( 1\right) }^{\left( 1\right) }\right) \left( 
\overset{}{\left\vert z\right\rangle }\right) =\left[ \Xi _{1}^{1}\left(
\sum_{1\leq i,j\leq r}x_{i}\otimes y_{j}^{d}\right) \right] \left( \overset{}%
{\left\vert z\right\rangle }\right) =\sum_{1\leq i,j\leq r}\left\vert
x_{i}\right\rangle \left( \overset{}{y_{j}^{d}\left( z\right) }\right) =%
\left[ \sum_{1\leq i,j\leq r}\left\vert x_{i}\right\rangle \otimes
\left\langle y_{j}\right\vert \right] \left( \overset{}{\left\vert
z\right\rangle }\right) =\sum_{1\leq i\leq r}\left\vert \overset{}{x_{i}}%
\right\rangle \left( \sum_{1\leq j\leq r}\left\langle \left.
y_{j}\right\vert z\right\rangle \right) ,
\end{equation}%
producing the matrix elements of $T=\Xi _{1}^{1}\left( T_{\left( 1\right)
}^{\left( 1\right) }\right) \in \mathcal{B}\left( \mathcal{H}\right) $ 
\begin{equation}
\left\langle \overset{}{T_{\left( 1\right) }^{\left( 1\right) },v_{1}\otimes
v_{2}^{d}}\right\rangle =\left\langle \overset{}{\sum_{1\leq i,j\leq
r}x_{i}^{d}\otimes y_{j},v_{1}\otimes v_{2}^{d}}\right\rangle =\sum_{1\leq
i,j\leq r}\left\langle \overset{}{x_{i}^{d},v_{1}}\right\rangle \left\langle 
\overset{}{v_{2}^{d},y_{j}}\right\rangle =\left\langle \left. \overset{}{%
v_{2}}\right\vert Tv_{1}\right\rangle \equiv \left\langle \left. \overset{}{%
v_{2}}\right\vert \Xi _{1}^{1}\left( T_{\left( 1\right) }^{\left( 1\right)
}\right) v_{1}\right\rangle .
\end{equation}
\end{enumerate}

\begin{remark}
Nuclear operators correspond to $\mathcal{H}\otimes \mathcal{H}^{d}$ or $%
\mathcal{H}^{d}\otimes \mathcal{H}$, depending on convention, and the
bijection $\Xi _{1}^{1}$ is given by the duality pairing $\digamma $.
\end{remark}

\subsection{Relationships between Tensor Product Spaces}

\begin{enumerate}
\item These tensor product spaces are related by 
\begin{equation}
\mathcal{H}^{d}\otimes \mathcal{H}^{d}\subseteq \mathcal{H}\otimes \mathcal{H%
}^{d}\cong \mathcal{H}^{d}\otimes \mathcal{H}\subseteq \mathcal{H}\otimes 
\mathcal{H}.
\end{equation}
\end{enumerate}

\section{Norms on Tensor Spaces}

\begin{remark}
\begin{equation}
\left\Vert x\right\Vert =\left( \overset{}{\left\langle \left. x\right\vert
x\right\rangle }\right) ^{\frac{1}{2}}
\end{equation}
\end{remark}

We can define norms on these tensor spaces that mimic the standard operator
norms:

\subsubsection*{Trace-Class (Nuclear) Norm}

For a mixed tensor $T_{1}^{1}\in \mathcal{H}\otimes \mathcal{H}^{\ast }$
(interpreted as an operator), the trace-class norm is: 
\begin{equation*}
\left\Vert \overset{}{T_{1}^{1}}\right\Vert
_{_{1}}==\inf_{x_{i},y_{i}}\left\{ \sum_{1\leq i\leq r}\Vert x_{i}\Vert
\Vert y_{i}^{d}\Vert :\right\} ,T_{1}^{1}=\sum_{1\leq i\leq r}x_{i}\otimes
y_{i}^{d},\quad x_{i},y_{i}\in \mathcal{H},
\end{equation*}%
where the infimum is over all representations of $T_{1}^{1}$ as a sum of
elementary tensors.

\subsubsection*{Hilbert-Schmidt Norm}

The Hilbert-Schmidt norm for $T_{1}^{1}\in \mathcal{H}\otimes \mathcal{H}%
^{\ast }$ is: 
\begin{equation*}
\left\Vert \overset{}{T_{1}^{1}}\right\Vert _{2}=\left[ \sum_{1\leq i,j\leq
r}x_{i}\otimes y_{j}^{d}\right] \left\vert v\right\rangle =\left(
\sum_{i,j}\left\vert \left\langle \left. \overset{}{x_{i}}\right\vert \left[ 
\overset{}{\Xi _{1}^{1}\left( T_{1}^{1}\right) }\right] \left( y_{j}\right)
\right\rangle \right\vert ^{2}\right) ^{1/2},
\end{equation*}%
where $\{e_{i}\},\{f_{j}\}$ are orthonormal bases.

\subsubsection*{Operator Norm}

For $T\in \mathcal{H}\otimes \mathcal{H}^{\ast }$, the operator norm is: 
\begin{equation*}
\Vert T\Vert _{\text{op}}=\sup_{\Vert x\Vert =1}\Vert Tx\Vert
\end{equation*}

\section{Strong Operator Topology (SOT) Mimicry}

The strong operator topology is not normable, but we can define a family of
seminorms on tensors that mimic it. For $T \in \mathcal{H} \otimes \mathcal{H%
}^*$, define the seminorms: 
\begin{equation*}
p_x(T) = \|Tx\|, \quad x \in \mathcal{H}.
\end{equation*}

\begin{remark}
Hence is there an isomorphism between the space of such mixed tensors and
the space of bounded operators acting on the Hilbert space in the strong
operator topologies?
\end{remark}

\begin{remark}
Yes, there is an isomorphism between the space of mixed tensors $\mathcal{H}%
\otimes \mathcal{H}^{\ast }$interpreted as finite-rank operators) and the
space of $\mathcal{B}\left( \mathcal{H}\right) $ when considering
appropriate topologies. However, the precise nature of this isomorphism
depends on the \TEXTsymbol{\backslash}textbf\{closure\} of these spaces
under different topologies:
\end{remark}

\subsection*{1. Algebraic Isomorphism (Finite-Rank Case)}

At the purely algebraic level (ignoring topology), there is a natural
isomorphism: $\left( \text{anti linear}\right) $ 
\begin{equation*}
\mathcal{H}\otimes \mathcal{H}^{\ast }\cong \text{Finite-rank operators on }%
\mathcal{H},
\end{equation*}%
where a tensor $x\otimes y^{\ast }$ corresponds to the rank-1 operator $%
z\mapsto \langle y,z\rangle x$.

\subsection*{2. Topological Considerations}

The key question is whether this isomorphism extends to \textbf{infinite-rank%
} operators when considering completions under different topologies:

\subsubsection*{(a) Uniform (Operator Norm) Topology}

\begin{itemize}
\item The completion of $\mathcal{H} \otimes \mathcal{H}^*$ under the
operator norm $\|\cdot\|_{\text{op}}$ yields the space of \textbf{compact
operators} $\mathcal{K}(\mathcal{H})$.

\item However, $\mathcal{B}(\mathcal{H})$ includes non-compact operators
(like the identity), so the isomorphism does \textbf{not} extend to all
bounded operators under this topology.
\end{itemize}

\subsubsection*{(b) Strong Operator Topology (SOT)}

\begin{itemize}
\item Finite-rank operators are \textbf{SOT-dense} in $\mathcal{B}(\mathcal{H%
})$.

\item The space $\mathcal{H} \otimes \mathcal{H}^*$ is \textbf{not complete}
in the SOT (its SOT-closure is $\mathcal{B}(\mathcal{H})$).

\item Thus, while there is a \textbf{dense embedding} $\mathcal{H} \otimes 
\mathcal{H}^* \hookrightarrow \mathcal{B}(\mathcal{H})$, it is not an
isomorphism of complete spaces.
\end{itemize}

\begin{remark}
But if you take the analogous SOT completion of the mixed tensor product,
does that map onto the complete space of bounded operators?
\end{remark}

\subsection*{Answer: Yes, the SOT-Completion of $\mathcal{H} \otimes 
\mathcal{H}^*$ is $\mathcal{B}(\mathcal{H})$}

The \textbf{mixed tensor product} $\mathcal{H} \otimes \mathcal{H}^*$
(interpreted as finite-rank operators) is \textbf{dense in $\mathcal{B}(%
\mathcal{H})$ in the Strong Operator Topology (SOT)}. This means that every
bounded operator can be approximated by finite-rank operators in the SOT
sense, and thus the SOT-completion of $\mathcal{H} \otimes \mathcal{H}^*$ is
indeed the entire space $\mathcal{B}(\mathcal{H})$.

\subsection*{Key Points}

1. \textbf{Finite-Rank Operators are SOT-Dense in $\mathcal{B}(\mathcal{H})$}
For any $T \in \mathcal{B}(\mathcal{H})$ and any finite set of vectors $%
\{x_1, \dots, x_n\} \subset \mathcal{H}$, there exists a finite-rank
operator $T_0$ such that: 
\begin{equation*}
\|(T - T_0)x_i\| < \epsilon \quad \forall i.
\end{equation*}

2. \textbf{SOT is Weaker Than the Operator Norm} The SOT does \textbf{not}
require uniform convergence, so even non-compact operators (like the
identity) can be approximated by finite-rank operators in this topology.

3. \textbf{No Banach Space Isomorphism, but a Topological Vector Space
Isomorphism} The algebraic isomorphism $\mathcal{H}\otimes \mathcal{H}^{\ast
}\cong \text{Finite-rank operators}$ extends to a \textbf{set-theoretic
bijection} between their SOT-completions. However, $\mathcal{B}(\mathcal{H})$
is \textbf{not a normable space under SOT}.

\begin{notation}
\begin{enumerate}
\item 
\begin{enumerate}
\item The $\left\langle \left. {}\right\vert \right\rangle $-biorthogonal
bases $\left\vert \mathbf{e}^{b}\right\rangle $ is given by 
\begin{equation}
\left\vert \mathbf{e}^{b}\right\rangle =\left\vert \mathbf{e}\right\rangle
\left\langle \left. \mathbf{e}\right\vert \mathbf{e}\right\rangle
^{-1}=\left( \mathbf{e}\right) \left\langle \left. \mathbf{e}\right\vert 
\mathbf{e}\right\rangle ^{-1}.
\end{equation}

\item This gives%
\begin{align}
\mathbf{e}^{d}\left( \mathbf{e}\right) & =\left( \mathbf{e}^{d}\right)
^{t}\cdot\left( \mathbf{e}\right) =\left\langle \left. \mathbf{e}%
^{b}\right\vert \mathbf{e}\right\rangle =\left\langle \mathbf{e}%
^{b}\right\vert \cdot\left\vert \mathbf{e}\right\rangle =\left( 
\begin{array}{c}
\left\langle e_{1}^{b}\right\vert \\ 
\vdots \\ 
\left\langle e_{r}^{b}\right\vert%
\end{array}
\right) \cdot\left( 
\begin{array}{ccc}
\left\vert e_{1}\right\rangle & \cdots & \left\vert e_{r}\right\rangle%
\end{array}
\right) \\
& =\left\langle \left( \mathbf{e}\right) \left\langle \left. \mathbf{e}%
\right\vert \mathbf{e}\right\rangle ^{-1}\right\vert \cdot\left\vert \mathbf{%
e}\right\rangle =\left( \left\langle \left. \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \mathbf{e}\right\vert \right) \left\vert 
\mathbf{e}\right\rangle =\left\langle \left. \mathbf{e}\right\vert \mathbf{e}%
\right\rangle ^{-1}\left\langle \left. \mathbf{e}\right\vert \mathbf{e}%
\right\rangle =\mathbb{I}_{r}.
\end{align}
\end{enumerate}

\item A complex symmetric $\left( \left. {}\right\vert \right) $-conb of $%
\mathcal{H}^{1}$ is denoted by $\left\vert \mathbf{e}\right) .$

\begin{enumerate}
\item The $\left( \left. {}\right\vert \right) $-biorthogonal bases $%
\left\vert \mathbf{e}^{b}\right) $ is given by 
\begin{equation}
\left\vert \mathbf{e}^{b}\right) =\left\vert \mathbf{e}\right) \left( \left. 
\mathbf{e}\right\vert \mathbf{e}\right) ^{-1}.
\end{equation}

\item This gives%
\begin{align}
\mathbf{e}^{d}\left( \mathbf{e}\right) & =\left( \mathbf{e}^{d}\right)
^{t}\cdot \left( \mathbf{e}\right) =\left( \left. \mathbf{e}^{b}\right\vert 
\mathbf{e}\right) =\left( \mathbf{e}^{b}\right\vert \cdot \left\vert \mathbf{%
e}\right) =\left( 
\begin{array}{c}
\left( e_{1}^{b}\right\vert \\ 
\vdots \\ 
\left( e_{r}^{b}\right\vert%
\end{array}%
\right) \cdot \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{r}\right)%
\end{array}%
\right) \\
& =\left\langle \left( \mathbf{e}\right) \left( \left. \mathbf{e}\right\vert 
\mathbf{e}\right) ^{-1}\right\vert \cdot \left\vert \mathbf{e}\right)
=\left( \left( \left. \mathbf{e}\right\vert \mathbf{e}\right) ^{-1}\left( 
\mathbf{e}\right\vert \right) \left\vert \mathbf{e}\right) =\left( \left. 
\mathbf{e}\right\vert \mathbf{e}\right) ^{-1}\left( \left. \mathbf{e}%
\right\vert \mathbf{e}\right) =\mathbb{I}_{r}.
\end{align}
\end{enumerate}
\end{enumerate}
\end{notation}

