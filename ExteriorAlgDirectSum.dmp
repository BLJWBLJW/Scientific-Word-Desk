\part{Exterior Algebra Over a Direct Sum}

\begin{enumerate}
\item The exterior algebra generated by direct sum $\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}$ of dual Hilbert spaces $\mathcal{H}^{1},\mathcal{H}%
^{1d}$ is
\begin{equation}
\mathcal{F}={\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{m}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n-p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n-p}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  ,
\end{equation}
where
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{n-p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n-p}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{equation}


\item The injections $i_{\mathcal{H}^{1}},i_{\mathcal{H}^{1d}}$ of each of the
summands into the direct sum%
\begin{align}
i_{\mathcal{H}^{1}}  & :\mathcal{H}^{1}\rightarrow\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\\
i_{\mathcal{H}^{1d}}  & :\mathcal{H}^{1d}\rightarrow\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}.
\end{align}
can be extended to the exterior algebras generated by the direct sum of these
dual subspaces
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }  & :{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }  & :{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)
\end{align}
by the 

\begin{definition}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
},i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$%
\begin{gather}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \right)  =\left(  \left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle ,0\right)
=\left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p}}\right\rangle +0=\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)  =\left(  0,\left\langle \varphi_{k_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \right)
=0+\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle
\varphi_{k_{q}}\right\vert =\left\langle \varphi_{k_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \\
0\leq j_{1}<\cdots<j_{p}\leq r;0\leq k_{1}<\cdots<k_{q}\leq r.
\end{gather}

\end{definition}

\begin{definition}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
},i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$ can also be expressed
as
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \right)    & =\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \otimes\left\langle
\phi\right\vert \equiv\left\vert \varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{p}}\right\rangle \left\langle \phi\right\vert \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)    & =\left\vert \varphi_{j_{1}}\right\rangle
\otimes\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle
\varphi_{k_{q}}\right\vert \equiv\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert \\
0  & \leq j_{1}<\cdots<j_{p}\leq r;1\leq k_{1}<\cdots<k_{q}\leq r,
\end{align}
in particular
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \right)    & =\left\vert \varphi_{j}\right\rangle
\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \right)    & =I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\otimes\left\langle \varphi_{j}\right\vert \\
1  & \leq j\leq r.
\end{align}

\end{definition}

\item The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and
$i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ are \emph{algebra maps
i.e. }

\begin{lemma}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and
$i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ are \emph{algebra
homomorphisms} i.e.
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x\wedge y\right)
=\left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x\right)
\right)  \cdot\left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\left(  y\right)  \right)
\end{equation}
and
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  x^{d}\wedge
y^{d}\right)  =\left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\left(  x^{d}\right)  \right)  \cdot\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  y^{d}\right)  \right)  .
\end{equation}


\begin{proof}%
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \right)  =i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\left(  \left\vert \varphi_{j_{1}}\right\rangle \right)  \cdot\cdots\cdot
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{p}}\right\rangle \right)  =\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \left\langle
\phi\right\vert
\end{equation}
and
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)  =i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\left(  \left\langle \varphi_{k_{1}}\right\vert \right)  \cdot\cdots\cdot
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{q}}\right\vert \right)  =\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert .
\end{equation}

\end{proof}
\end{lemma}

\item 

\begin{definition}
The tensor algebras $%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  $ and  $%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  $ can be equipped with a \emph{skew product}
"$@$" i.e.
\begin{align}
@  & :%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \times%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \rightarrow%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \\
@  & :%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  \times%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  \rightarrow%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)
\end{align}
defined by
\begin{align}
x_{p_{1}}@x_{p_{2}}  & =\left(  -1\right)  ^{p_{1}p_{2}}x_{p_{2}}\otimes
x_{p_{1}},\quad x_{p_{1}},x_{p_{2}}\in\mathcal{H}^{1}\\
x_{p_{1}}^{d}@x_{p_{2}}^{d}  & =\left(  -1\right)  ^{p_{1}p_{2}}x_{p_{2}}%
^{d}\otimes x_{p_{1}}^{d},\quad x_{p_{1}}^{d},x_{p_{2}}^{d}\in\mathcal{H}%
^{d1}.
\end{align}

\end{definition}

\begin{definition}
The tensor product
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ={\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)
\end{equation}
of the dual exterior algebras ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $
and ${\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ can be equipped with a
\emph{skew product} "$@$"%
\begin{equation}
@:\left[  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  \right]  \times\left[  {\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\right]  \rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  ,
\end{equation}
defined on \emph{homogeneous} elements by
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}^{d}\right)  @\left(  x_{p_{2}}\otimes
y_{q_{2}}^{d}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge
x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  ,
\end{equation}
to produce 
\end{definition}

\begin{notation}
The \emph{Skew Tensor} product mixed exterior algebra
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  ,
\end{equation}
where "$\wedge$" is the exterior product in the exterior algebras
${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and ${\huge \wedge}\left(
\mathcal{H}^{1d}\right)  $ i.e.
\begin{align}
\wedge & :{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \times{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \\
\wedge & :{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \times{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(
\mathcal{H}^{1d}\right)
\end{align}
and
\begin{align}
p_{2} &  =\deg\left(  x_{p_{2}}\right)  \\
q_{1} &  =\deg\left(  y_{q_{1}}\right)  .
\end{align}

\end{notation}
\end{enumerate}

\begin{lemma}
In ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $
\begin{equation}
w_{1}@w_{2}=\left(  -1\right)  ^{\left(  p_{1}+p_{2}\right)  \left(
q_{1}+q_{2}\right)  }w_{2}@w_{1},
\end{equation}
where
\begin{align}
w_{1}  & \in%
%TCIMACRO{\tbigwedge \nolimits_{p_{2}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{2}}^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \\
w_{2}  & \in%
%TCIMACRO{\tbigwedge \nolimits_{q_{2}}^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{2}}^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{q_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{align}

\end{lemma}

\begin{remark}
If $\left(  p_{1}+p_{2}\right)  $ or $\left(  q_{1}+q_{2}\right)  $ are even
then
\begin{equation}
w_{1}@w_{2}=w_{2}@w_{1}.
\end{equation}

\end{remark}

\begin{example}%
\begin{equation}
\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert
@\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}}\right\vert =\left(
-1\right)  ^{p_{2}q_{1}}\left\vert x_{p_{1}}\wedge x_{p_{2}}\right\rangle
\left\langle y_{q_{1}}\wedge y_{q_{2}}\right\vert
\end{equation}
in particular let
\begin{gather}
p_{2}=\deg\left(  x_{p_{2}}\right)  =1\\
q_{1}=\deg\left(  y_{q_{1}}\right)  =1\\
p_{1}=q_{2}=0
\end{gather}
then
\begin{equation}
\left\vert \phi\right\rangle \left\langle y_{1}\right\vert @\left\vert
x_{2}\right\rangle \left\langle \phi\right\vert =-\left\vert \phi\wedge
x_{2}\right\rangle \left\langle y_{1}\wedge\phi\right\vert =-\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert
\end{equation}
and
\begin{equation}
\left\vert x_{2}\right\rangle \left\langle \phi\right\vert @\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert =-\left\vert x_{2}\wedge
\phi\right\rangle \left\langle \phi\wedge y_{1}\ \right\vert =-\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert .
\end{equation}

\end{example}

\begin{definition}
The tensor product
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ={\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)
\end{equation}
equipped with the mixed exterior product "$\cdot$" is the \emph{mixed exterior
algebra} ${\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  .$
\end{definition}

\begin{definition}
\bigskip The mixed exterior product "$\cdot$"
\begin{equation}
\cdot:\left[  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \right]  \times\left[
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \right]  \rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
is defined on homogeneous elements by
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes
y_{q_{2}}\right)  =\left(  x_{p_{1}}\wedge x_{p_{2}}\right)  \otimes\left(
y_{q_{1}}\wedge y_{q_{2}}\right)  .
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert
\cdot\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}}\right\vert
=\left\vert x_{p_{1}}\wedge x_{p_{2}}\right\rangle \left\langle y_{q_{1}%
}\wedge y_{q_{2}}\right\vert
\end{equation}
in particular let
\begin{gather}
p_{2}=\deg\left(  x_{p_{2}}\right)  =1\\
q_{1}=\deg\left(  y_{q_{1}}\right)  =1\\
p_{1}=q_{2}=0
\end{gather}
then
\begin{equation}
\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \cdot\left\vert
x_{2}\right\rangle \left\langle \phi\right\vert =\left\vert \phi\wedge
x_{2}\right\rangle \left\langle y_{1}\wedge\phi\right\vert =\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert
\end{equation}
and
\begin{equation}
\left\vert x_{2}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert =\left\vert x_{2}\wedge
\phi\right\rangle \left\langle \phi\wedge y_{1}\ \right\vert =\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert .
\end{equation}

\end{remark}

\begin{remark}
On \emph{homogeneous elements} the \emph{skew product} "$@$" and "$\cdot$" are
related by
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes
y_{q_{2}}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\otimes
y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}}\right)  .
\end{equation}

\end{remark}

\begin{remark}
The mixed exterior algebra ${\huge \wedge}\left(  \mathcal{H}^{1}%
,\mathcal{H}^{1d}\right)  ={\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ is a graded algebra
that can be decomposed as
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ={\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits_{m}^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{m}^{n}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ,
\end{equation}
where
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits_{m}^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{m}^{n}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{m}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{remark}

\begin{remark}
For \emph{homogeneous} $w_{1}$ and $w_{2}$%
\begin{equation}
w_{1}\cdot w_{2}=\left(  -1\right)  ^{p_{1}p_{2}+q_{1}q_{2}}w_{2}\cdot w_{1},
\end{equation}
where
\begin{align}
w_{1}  & \in%
%TCIMACRO{\tbigwedge \nolimits_{p_{2}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{2}}^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \\
w_{2}  & \in%
%TCIMACRO{\tbigwedge \nolimits_{q_{2}}^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{2}}^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{q_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{align}

\end{remark}

\begin{example}%
\begin{align}
w_{1}  & =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert \in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{1}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \\
w_{2}  & =\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \in%
%TCIMACRO{\tbigwedge \nolimits_{1}^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{1}^{0}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)
\end{align}
then
\begin{equation}
w_{1}\cdot w_{2}=\left(  -1\right)  ^{0+0}w_{2}\cdot w_{1}=w_{2}\cdot w_{1}%
\end{equation}
and
\begin{equation}
\left\vert x_{1}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert =\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert \cdot\left\vert x_{1}\right\rangle \left\langle
\phi\right\vert =\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert .
\end{equation}


\begin{definition}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and
$i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$ can also be expressed as
mappings
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }  & :{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1},\mathcal{H}^{1d}\right)  \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }  & :{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1},\mathcal{H}^{1d}\right)
\end{align}
defined by%
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \right)    & =\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \otimes\left\langle
\phi\right\vert \equiv\left\vert \varphi_{j_{1}}\right\rangle \wedge
\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \otimes\left\langle
\phi\right\vert =\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\phi\right\vert \cdot\cdots\cdot\left\vert \varphi_{j_{p}}\right\rangle
\left\langle \phi\right\vert \\
& =i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \left\langle \phi\right\vert \right)  \cdot
\cdots\cdot i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(
\left\vert \varphi_{j_{p}}\right\rangle \left\langle \phi\right\vert \right)
\\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)    & =\left\vert \phi\right\rangle \otimes\left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \equiv\left\vert \phi\right\rangle \left\langle \varphi_{k_{1}%
}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert =\left\vert \phi\right\rangle
\left\langle \varphi_{k_{1}}\right\vert \cdot\cdots\cdot\left\vert
\phi\right\rangle \left\langle \varphi_{k_{q}}\right\vert \\
& =i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\vert
\phi\right\rangle \left\langle \varphi_{k_{1}}\right\vert \right)  \cdot
\cdots\cdot i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(
\left\vert \phi\right\rangle \left\langle \varphi_{k_{q}}\right\vert \right)
.
\end{align}

\end{definition}
\end{example}

\begin{lemma}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and
$i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$ are algebra homomorphisms.
\end{lemma}

\begin{definition}
A linear map $\digamma$ from the skew tensor product of the dual exterior
algebras ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and ${\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  $
\begin{equation}
\digamma:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
is given by
\begin{equation}
\digamma\left(  u\otimes v^{d}\right)  =i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \wedge i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  v^{d}\right)  ;\quad u\in{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  ,v^{d}\in{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  .
\end{equation}

\end{definition}

\begin{lemma}
The map $\digamma$
\begin{equation}
\digamma:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,
\end{equation}
\emph{is an algebra homomorphism} i.e.%
\begin{equation}
\digamma\left(  X@Y\right)  =\digamma\left(  X\right)  \wedge\digamma\left(
Y\right)  ,\quad X,Y\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{lemma}

\begin{proof}
Noting 

\begin{enumerate}
\item
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}%
}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge x_{p_{2}%
}\right)  \otimes\left(  y_{q_{1}}\wedge y_{q_{2}}\right)
\end{equation}


\item
\begin{equation}
y_{q_{1}}\wedge x_{p_{2}}=\left(  -1\right)  ^{p_{2}q_{1}}x_{p_{2}}\wedge
y_{q_{1}}%
\end{equation}


\item
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x\wedge y\right)
& =i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x\right)  \wedge
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  y\right)  \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  x^{d}\wedge
y^{d}\right)    & =i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(
x^{d}\right)  \wedge i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\left(  y^{d}\right)
\end{align}
and

\item
\begin{equation}
\digamma\left(  u\otimes v^{d}\right)  =\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  v^{d}\right)
\right)
\end{equation}
one obtains that $\digamma$ is an algebra homomorphism as
\begin{gather}
\digamma\left(  \overset{}{\left(  x_{p_{1}}\otimes y_{q_{1}}^{d}\right)
@\left(  x_{p_{2}}\otimes y_{q_{2}}^{d}\right)  }\right)  =\digamma\left(
\overset{}{\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge x_{p_{2}%
}\right)  \otimes\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  }\right)
\\
=\left(  -1\right)  ^{p_{2}q_{1}}\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  x_{p_{1}}\wedge x_{p_{2}}\right)  \right)
{\Large \wedge}\left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  \right)  \\
=\left(  -1\right)  ^{p_{2}q_{1}}\left(  \left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  x_{p_{1}}\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x_{p_{2}}\right)
\right)  \right)  {\Large \wedge}\left(  \left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  y_{q_{1}}^{d}\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  y_{q_{2}}%
^{d}\right)  \right)  \right)  \\
=\left(  \left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(
x_{p_{1}}\right)  \right)  {\Large \wedge}\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  y_{q_{1}}^{d}\right)  \right)  \right)
{\Large \wedge}\left(  \left(  i_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\left(  x_{p_{2}}\right)  \right)  {\Large \wedge}\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  y_{q_{2}}%
^{d}\right)  \right)  \right)  \\
=\digamma\left(  x_{p_{1}}@y_{q_{1}}^{d}\right)  {\Large \wedge}%
\digamma\left(  x_{p_{2}}@y_{q_{2}}^{d}\right)  \\
\quad x_{p_{1}}\in{\huge \wedge}^{p_{1}}\left(  \mathcal{H}^{1}\right)
,x_{p_{2}}\in{\huge \wedge}^{p_{2}}\left(  \mathcal{H}^{1}\right)  ,\quad
y_{q_{1}}^{d}\in{\huge \wedge}^{q_{1}}\left(  \mathcal{H}^{1d}\right)
,y_{q_{2}}^{d}\in{\huge \wedge}^{q_{2}}\left(  \mathcal{H}^{1d}\right)  ,
\end{gather}
i.e.
\begin{equation}
\digamma\left(  \overset{}{\left(  x_{p_{1}}\otimes y_{q_{1}}^{d}\right)
@\left(  x_{p_{2}}\otimes y_{q_{2}}^{d}\right)  }\right)  =\digamma\left(
\overset{}{x_{p_{1}}@y_{q_{1}}^{d}}\right)  {\Large \wedge}\digamma\left(
\overset{}{x_{p_{2}}@y_{q_{2}}^{d}}\right)  .
\end{equation}

\end{enumerate}
\end{proof}

\begin{definition}
The linear injection $\eta$
\begin{equation}
\eta:\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \,\widehat{\otimes}\,{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \overset{linear}{\cong}{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
given by
\begin{equation}
\eta\left(  z\right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d},
\end{equation}
where the projections $\pi_{\mathcal{H}^{1}}$ and $\pi_{\mathcal{H}^{1d}}$
\begin{align}
\pi_{\mathcal{H}^{1}}  & :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow
\mathcal{H}^{1}\\
\pi_{\mathcal{H}^{1d}}  & :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\rightarrow\mathcal{H}^{1d}%
\end{align}
are given by
\begin{align}
\pi_{\mathcal{H}^{1}}\left(  z\right)    & =\pi_{\mathcal{H}^{1}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1}}\\
\pi_{\mathcal{H}^{1d}}\left(  z\right)    & =\pi_{\mathcal{H}^{1d}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1d}}.
\end{align}

\end{definition}

\begin{remark}%
\begin{gather}
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }=\left\vert \phi
\right\rangle \\
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }=\left\vert \phi
^{d}\right\rangle =\left\langle \phi\right\vert
\end{gather}

\end{remark}

\begin{remark}
The linear injection $\eta$ is related to the injections $i_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }$ and $i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }$ by
\begin{align}
\eta\left(  \pi_{\mathcal{H}^{1}}\left(  z\right)  \right)    &
=i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \pi_{\mathcal{H}%
^{1}}\left(  z\right)  \right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)
\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }=\left\vert
\pi_{\mathcal{H}^{1}}\left(  z\right)  \right\rangle \left\langle
\phi\right\vert \\
\eta\left(  \pi_{\mathcal{H}^{1d}}\left(  z\right)  \right)    &
=i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \pi_{\mathcal{H}%
^{1d}}\left(  z\right)  \right)  =I_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  =\left\vert
\phi\right\rangle \left\langle \pi_{\mathcal{H}^{1d}}\left(  z\right)
\right\vert .
\end{align}

\end{remark}

\begin{example}%
\begin{align}
\eta\left(  x_{1}+y_{1}^{d}\right)    & =x_{1}\otimes I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes y_{1}^{d}\\
& =\left\vert x_{1}\right\rangle \otimes\left\langle \phi\right\vert
+\left\vert \phi\right\rangle \otimes\left\langle y_{1}\right\vert \\
& =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert .
\end{align}

\end{example}

\begin{lemma}%
\begin{equation}
\left(  \boxtimes\eta\right)  \left(  \alpha\wedge\beta\right)  =\left(
\overset{}{\left(  \boxtimes\eta\right)  \left(  \alpha\right)  }\right)
\cdot\left(  \overset{}{\left(  \boxtimes\eta\right)  \left(  \beta\right)
}\right)  =\eta\left(  \alpha\right)  \cdot\eta\left(  \beta\right)
,\quad\alpha,\beta\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\end{equation}

\end{lemma}

\begin{proof}%
\begin{equation}
\left(  \left\vert x_{1}\right\rangle +\left\vert y_{1}^{d}\right\rangle
\right)  \wedge\left(  \left\vert x_{2}\right\rangle +\left\vert y_{2}%
^{d}\right\rangle \right)  =\left\vert x_{1}\wedge x_{2}\right\rangle
+\left\vert x_{1}\wedge y_{2}^{d}\right\rangle +\left\vert y_{1}^{d}\wedge
x_{2}\right\rangle +\left\vert y_{1}^{d}\wedge y_{2}^{d}\right\rangle
\end{equation}%
\begin{equation}
\left(  \boxtimes\eta\right)  \left(  \left\vert x_{1}\wedge x_{2}%
\right\rangle +\left\vert x_{1}\wedge y_{2}^{d}\right\rangle +\left\vert
y_{1}^{d}\wedge x_{2}\right\rangle +\left\vert y_{1}^{d}\wedge y_{2}%
^{d}\right\rangle \right)  =\left\vert x_{1}\wedge x_{2}\right\rangle
\left\langle \phi\right\vert +\left\vert x_{1}\wedge y_{2}^{d}\right\rangle
+\left\vert y_{1}^{d}\wedge x_{2}\right\rangle +\left\vert y_{1}^{d}\wedge
y_{2}^{d}\right\rangle
\end{equation}%
\begin{equation}
\left(  \left\vert x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert \right)  \cdot\left(
\left\vert x_{2}\right\rangle \left\langle \phi\right\vert +\left\vert
\phi\right\rangle \left\langle y_{2}\right\vert \right)  =
\end{equation}

\end{proof}

\begin{example}
The $@$ product
\begin{align}
& \eta\left(  x_{1}+y_{1}^{d}\right)  @\eta\left(  x_{1}+y_{1}^{d}\right)
=\left(  \left\vert x_{1}\right\rangle \left\langle \phi\right\vert
+\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \right)  @\left(
\left\vert x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert \right)  \\
& =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert @\left\vert
x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert @\left\vert x_{1}\right\rangle \left\langle
\phi\right\vert +\left\vert x_{1}\right\rangle \left\langle \phi\right\vert
@\left\vert \phi\right\rangle \left\langle y_{1}\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert @\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert =-\left\vert x_{1}\right\rangle \left\langle
y_{1}\right\vert +\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert
=0.
\end{align}

\end{example}

\begin{example}
The $\cdot$ product%
\begin{align}
& \eta\left(  x_{1}+y_{1}^{d}\right)  \cdot\eta\left(  x_{1}+y_{1}^{d}\right)
=\left(  \left\vert x_{1}\right\rangle \left\langle \phi\right\vert
+\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \right)
\cdot\left(  \left\vert x_{1}\right\rangle \left\langle \phi\right\vert
+\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \right)  \\
& =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert \cdot\left\vert x_{1}\right\rangle \left\langle
\phi\right\vert +\left\vert x_{1}\right\rangle \left\langle \phi\right\vert
\cdot\left\vert \phi\right\rangle \left\langle y_{1}\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert \cdot\left\vert \phi
\right\rangle \left\langle y_{1}\right\vert \\
& =\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert +\left\vert
x_{1}\right\rangle \left\langle y_{1}\right\vert =2\left(  \left\vert
x_{1}\right\rangle \left\langle y_{1}\right\vert +\left\vert x_{1}%
\right\rangle \left\langle y_{1}\right\vert \right)  .
\end{align}

\end{example}

\begin{lemma}%
\begin{equation}
\eta\left(  z\right)  @\eta\left(  z\right)  =0,\quad z\in\mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{align}
\eta\left(  z\right)  @\eta\left(  z\right)    & =\left(  \overset{}{\pi
_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)
}\right)  @\left(  \overset{}{\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}+I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z\right)  }\right)  \\
& =\left[  \overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)
@\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]  +\left[
\overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  @\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z\right)  \right)  }\right]  \\
& +\left[  \overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \right)  @\left(
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]  +\left[
\overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }%
\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \right)  @\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z\right)  \right)  }\right]  \\
& =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \right)  \otimes\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z\right)  \wedge I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right)  \otimes\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(
z\right)  \right)  \\
& -\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \right)  \otimes\left(
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\wedge I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\right)  \otimes\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z\right)  \wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \right)
\\
& =0
\end{align}

\end{proof}

\begin{remark}%
\begin{equation}
z\wedge z=\left(  -1\right)  ^{1}z\wedge z=0,\quad z\in\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}.
\end{equation}

\end{remark}

\begin{remark}
The tensor product of the exterior algebras ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  $ and ${\huge \wedge}\left(  \mathcal{H}^{d1}\right)
$ can be expanded as
\begin{align}
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(
\mathcal{H}^{d1}\right)    & =%
%TCIMACRO{\tbigoplus \limits_{0\leq m\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m\leq r}}
%EndExpansion
{\huge \wedge}^{m}\mathcal{H}\otimes%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\huge \wedge}^{n}\mathcal{H}^{d1}=%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion
\left(  {\huge \wedge}^{m}\mathcal{H}\otimes{\huge \wedge}^{n}\mathcal{H}%
^{d1}\right)  \\
& =\left[  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right]  \oplus\left[
{\huge \wedge}^{1}\mathcal{H}\otimes I_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\right]  \oplus\left[  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes{\huge \wedge}^{1}\mathcal{H}^{d1}\right]  \oplus
\cdots\oplus{\huge \wedge}^{r}\mathcal{H}\otimes{\huge \wedge}^{r}%
\mathcal{H}^{dr}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left(  {\huge \wedge}^{p}\left(  \mathcal{H}^{1}\right)  \otimes
{\huge \wedge}^{n-p}\left(  \mathcal{H}^{1d}\right)  \right)  \equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{H}^{p}\otimes\mathcal{H}^{\left(  n-p\right)  d}.
\end{equation}

\end{remark}

\begin{remark}
\begin{equation}
\eta\left(  z\right)  \in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{d1}\right)
\end{equation}
thus by definition
\begin{equation}
\eta\left(  z\right)  \in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\,\widehat{\otimes}\,{\huge \wedge}\left(  \mathcal{H}^{d1}\right)  .
\end{equation}

\end{remark}

\begin{definition}
$\eta$ extends to a linear homomorphism
\begin{equation}
{\large \boxtimes}\left(  \eta\right)  :{\huge \wedge}\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}
given by
\begin{equation}
{\large \boxtimes}\left(  \eta\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\large \boxtimes}^{n}\left(  \eta\right)  ,
\end{equation}
where
\begin{equation}
{\large \boxtimes}^{n}\left(  \eta\right)  :{\huge \wedge}^{n}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}%
^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
and
\begin{equation}
{\large \boxtimes}^{n}\left(  \eta\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq p}}
%EndExpansion
{\large \boxtimes}_{p}^{n-p}\left(  \eta\right)
\end{equation}
is defined by its action on basis elements
\begin{gather}
\left(  {\large \boxtimes}_{p}^{n-p}\left(  \eta\right)  \right)  \left(
\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p}}\right\rangle \right)  \otimes\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  \right)  =\left(  \eta\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \right)  \wedge\cdots\wedge\eta\left(  \left\vert
\varphi_{j_{p}}\right\rangle \right)  \right)  \otimes\left(  \eta\left(
\left\langle \varphi_{j_{p+1}}\right\vert \right)  \wedge\cdots\wedge
\eta\left(  \left\langle \varphi_{j_{n}}\right\vert \right)  \right)  \\
0\leq p\leq n,1\leq j_{1}<\cdots<j_{p}\leq r,1\leq j_{p+1}<\cdots<j_{n}\leq r,
\end{gather}
where
\begin{equation}
{\large \boxtimes}^{n}\left(  \eta\right)  \left(  Z\right)  =\sum_{0\leq
p\leq n}{\large \boxtimes}_{p}^{n-p}\left(  \eta\right)  \left(
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  Z\right)
\right)  ,\quad Z\in{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}%
^{1d}\right)  .
\end{equation}

\end{definition}

\begin{remark}%
\begin{equation}
Z_{n}=\sum_{0\leq p\leq n}\sum_{\substack{1\leq j_{1}<\cdots<j_{p}\leq
r\\1\leq j_{p+1}<\cdots<j_{n}\leq r}}Z_{nj_{1}\cdots j_{p}j_{p+1}\cdots j_{n}%
}\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p}}\right\rangle \right)  \otimes\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  =\sum_{0\leq p\leq n}Z_{\mathcal{H}^{p}\mathcal{H}%
^{d\left(  n-p\right)  }}=%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}%
\end{equation}

\end{remark}

\begin{remark}
The projections
\begin{equation}
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}:{\huge \wedge}%
^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow
\mathcal{H}^{p}\wedge\mathcal{H}^{d\left(  n-p\right)  };\quad0\leq p\leq n
\end{equation}
are given by
\begin{equation}
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  Z_{n}\right)
=\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  \sum_{0\leq
p\leq n}Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\right)
=Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\pi_{\mathcal{H}^{1}}  & \equiv\pi_{\mathcal{H}^{1}\mathcal{H}^{0d}}\\
\pi_{\mathcal{H}^{1d}}  & \equiv\pi_{\mathcal{H}^{0}\mathcal{H}^{1d}}.
\end{align}

\end{remark}

\begin{lemma}%
\begin{equation}
\boxtimes\left(  \eta\right)  :\mathcal{H}^{p}\wedge\mathcal{H}^{d\left(
n-p\right)  }\rightarrow\mathcal{H}^{p}\wedge\mathcal{H}^{d\left(  n-p\right)
}%
\end{equation}
and
\begin{equation}
\left.  \boxtimes\left(  \eta\right)  \right\vert _{\mathcal{H}^{p}%
\wedge\mathcal{H}^{d\left(  n-p\right)  }}={\large \boxtimes}_{p}^{n-p}\left(
\eta\right)  .
\end{equation}

\end{lemma}

\begin{lemma}
$\boxtimes\left(  \eta\right)  $ acts on the mixed exterior algebra
\begin{align}
\boxtimes\left(  \eta\right)  \left(  \overset{}{\left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \left\langle \varphi_{j_{p+1}%
}\wedge\cdots\wedge\varphi_{j_{n}}\right\vert }\right)    & =\left(
\boxtimes\left(  \eta\right)  \left(  \overset{}{\left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \left\langle \phi\right\vert
}\right)  \right)  \otimes\left(  \boxtimes\left(  \eta\right)  \left(
\overset{}{\left\vert \phi\right\rangle \left\langle \varphi_{j_{p+1}}%
\wedge\cdots\wedge\varphi_{j_{n}}\right\vert }\right)  \right)  \\
& =\boxtimes\left(  \eta\right)  \left(  \overset{}{\left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \left\langle \phi\right\vert
}\right)  \left\langle \boxtimes\left(  \eta\right)  ^{\dagger}\left(
\overset{}{\left\vert \phi\right\rangle \left\langle \varphi_{j_{p+1}}%
\wedge\cdots\wedge\varphi_{j_{n}}\right\vert }\right)  \right\vert \\
& =\left(  \boxtimes_{0}^{p}\left(  \eta\right)  \left(  \overset{}{\left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \left\langle
\phi\right\vert }\right)  \left\langle \boxtimes^{n-p}\left(  \eta\right)
^{\dagger}\left(  \overset{}{\varphi_{j_{p+1}}\wedge\cdots\wedge\varphi
_{j_{n}}}\right)  \right\vert \right)  .
\end{align}

\end{lemma}

\begin{lemma}
$\boxtimes\left(  \eta\right)  $ is an algebra homorphism wrt $@$ i.e.
\begin{equation}
\left(  \boxtimes\left(  \eta\right)  \left(  \ Z_{a}\right)  \right)
@\left(  \boxtimes\left(  \eta\right)  \left(  \ Z_{b}\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  \ Z_{a}@\ Z_{b}\right)  .
\end{equation}

\end{lemma}

\begin{proof}%
\begin{align}
& \left(  \boxtimes\left(  \eta\right)  \left(  \overset{}{\left\vert
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge
\left\vert \varphi_{j_{p}}\right\rangle }\right\rangle \left\langle
\overset{}{\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge
\left\langle \varphi_{k_{q}}\right\vert }\right\vert }\right)  \right)
@\left(  \overset{}{\left\vert \overset{}{\left\vert \varphi_{l_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{l_{m}}\right\rangle
}\right\rangle \left\langle \overset{}{\left\langle \varphi_{d_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{d_{n}}\right\vert }\right\vert
}\right)  =\\
& \left(  -1\right)  ^{mq}\left(  \boxtimes\left(  \eta\right)  \left(
\overset{}{\left(  \left\vert \overset{}{\left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle
}\right\rangle \right)  \wedge\left(  \left\vert \overset{}{\left\vert
\varphi_{l_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{l_{m}%
}\right\rangle }\right\rangle \right)  }\right)  \right)  \otimes\left(
\overset{}{\left(  \left\langle \overset{}{\left\langle \varphi_{k_{1}%
}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert
}\right\vert \right)  \wedge\left(  \left\langle \overset{}{\left\langle
\varphi_{d_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{d_{n}%
}\right\vert }\right\vert \right)  }\right)  \\
& \left.  =\right.  \left(  -1\right)  ^{mq}\boxtimes\left(  \eta\right)
\left(  \left\vert \overset{}{\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \wedge
}\overset{}{\left\vert \varphi_{l_{1}}\right\rangle \wedge\cdots
\wedge\left\vert \varphi_{l_{m}}\right\rangle }\right\rangle \left\langle
\overset{}{\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge
\left\langle \varphi_{k_{q}}\right\vert }\wedge\overset{}{\left\langle
\varphi_{d_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{d_{n}%
}\right\vert }\right\vert \right)  \\
& \left.  =\right.  \left(  -1\right)  ^{mq}\left(  \left\vert \boxtimes
\left(  \eta\right)  \left(  \overset{}{\left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle
\wedge}\overset{}{\left\vert \varphi_{l_{1}}\right\rangle \wedge\cdots
\wedge\left\vert \varphi_{l_{m}}\right\rangle }\right)  \right\rangle
\left\langle \boxtimes\left(  \eta\right)  \left(  \overset{}{\left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert }\wedge\overset{}{\left\langle \varphi_{d_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{d_{n}}\right\vert }\right)
\right\vert \right)
\end{align}%
\begin{align}
& \left(  \boxtimes\left(  \eta\right)  \left\vert \overset{}{\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle }\right\rangle \left\langle \overset{}{\left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert }\right\vert \right)  @\left(  \boxtimes\left(  \eta\right)
\left(  \left\vert \overset{}{\left\vert \varphi_{l_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{l_{m}}\right\rangle }\right\rangle
\left\langle \overset{}{\left\langle \varphi_{d_{1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{d_{n}}\right\vert }\right\vert \right)
\right)  \\
& =
\end{align}

\end{proof}

\begin{lemma}
$\boxtimes\left(  \eta\right)  $ is an algebra homorphism i.e.
\begin{equation}
\left(  \boxtimes\left(  \eta\right)  \left(  \ Z_{a}\right)  \right)
@\left(  \boxtimes\left(  \eta\right)  \left(  \ Z_{b}\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  \ Z_{a}\wedge\ Z_{b}\right)  .
\end{equation}

\end{lemma}

\begin{proof}
Let $x_{11},x_{12}\in\mathcal{H}^{1}\oplus$ $\mathcal{H}^{1d}$ then%
\begin{equation}
\boxtimes\left(  \eta\right)  \left(  \ z_{1}\wedge z_{2}\right)  =\eta\left(
z_{1}\right)  \wedge\eta\left(  z_{2}\right)
\end{equation}%
\begin{equation}
\eta\left(  z\right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\end{equation}%
\begin{equation}
\left(  \boxtimes\left(  \eta\right)  \left(  x_{11}\otimes x_{12}\right)
\right)  \cdot\left(  \boxtimes\left(  \eta\right)  \left(  y_{11}\otimes
y_{21}\right)  \right)  =-\eta\left(  x_{11}\otimes x_{12}\right)
@\eta\left(  y_{11}\otimes y_{21}\right)  =-\left(  x_{11}\wedge
x_{12}\right)  \otimes\left(  y_{11}\wedge y_{21}\right)
\end{equation}%
\begin{equation}
\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(  z_{1}\right)
}\right)  @\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(
z_{2}\right)  }\right)  =\eta\left(  z_{1}\right)  @\eta\left(  z_{2}\right)
\end{equation}%
\begin{equation}
\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(  z_{1}\right)
}\right)  \cdot\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(
z_{2}\right)  }\right)  =\eta\left(  z_{1}\right)  \cdot\eta\left(
z_{2}\right)
\end{equation}%
\begin{align}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}%
}\right)    & =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge
x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}\wedge y_{q_{2}}\right)  \ \\
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes
y_{q_{2}}\right)    & =\left(  x_{p_{1}}\wedge x_{p_{2}}\right)
\otimes\left(  y_{q_{1}}\wedge y_{q_{2}}\right)  \\
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}%
}\right)    & =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\otimes
y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes y_{q_{2}}\right)
\end{align}%
\begin{align}
& =\left(  \overset{}{\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)
\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(
z_{1}\right)  }\right)  @\left(  \overset{}{\pi_{\mathcal{H}^{1}\mathcal{\ }%
}\left(  z_{2}\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }+I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes
\pi_{\mathcal{H}^{1d}}\left(  z_{2}\right)  }\right)  \\
& =\left[  \overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{1}\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)
\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]
+\left[  \overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{1}\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\right)  @\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }%
\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)
}\right]  \\
& +\left[  \overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)  \right)
@\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]  +\left[
\overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }%
\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)
@\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)  }\right]  \\
& =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)  \right)  \otimes\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right)  \otimes\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(
z_{2}\right)  \right)  \\
& -\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \right)  \otimes\left(
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }\right)  \otimes\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z_{2}\right)  \wedge\pi_{\mathcal{H}^{1d}%
\mathcal{\ }}\left(  z_{2}\right)  \right)
\end{align}%
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}%
}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge x_{p_{2}%
}\right)  \otimes\left(  y_{q_{1}}\wedge y_{q_{2}}\right)
\end{equation}%
\begin{align}
& =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)  \right)  \otimes\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  =\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }%
}\left(  z_{2}\right)  \wedge I_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\right)  \\
& \left.  +\right.  \left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{1}\right)  \wedge I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\right)  \otimes\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)
=\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  @\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)  \\
& -\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \right)  \otimes\left(
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  =-\left(
-1\right)  ^{p_{2}q_{1}}\left(  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)
\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)
\wedge I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  \\
& \left.  +\right.  \left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\wedge I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\right)
\otimes\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)
\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)
=\left(  -1\right)  ^{p_{2}q_{1}}\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\wedge\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{2}\right)  \right)  @\left(  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)
\right)
\end{align}

\end{proof}

\begin{lemma}
$\bigskip\digamma$ is a linear injection (in finite dimension it is a linear
isomorphism) and
\begin{equation}
\boxtimes\left(  \eta\right)  =\digamma^{-1}.
\end{equation}


\begin{proof}


\begin{enumerate}
\item
\begin{gather}
\left(  \boxtimes\left(  \eta\right)  \circ\digamma\right)  \left(  x\otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  =\boxtimes\left(
\eta\right)  \left(  \digamma\left(  x\otimes I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right)  \right)  =\boxtimes\left(  \eta\right)
\left(  i_{1\wedge}\left(  x\otimes I_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\right)  \right)  =\boxtimes\left(  \eta\right)  \left(
i_{1\wedge}\left(  x\right)  \right)  =\eta\left(  i_{1\wedge}\left(
x\right)  \right)  =x,\\
\quad x\in\mathcal{H}^{1}%
\end{gather}


\item
\begin{gather}
\left(  \boxtimes\left(  \eta\right)  \circ\digamma\right)  \left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes y^{d}\right)
=\boxtimes\left(  \eta\right)  \left(  \digamma\left(  I_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }\otimes y^{d}\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  i_{1d\wedge}\left(  I_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }\otimes y^{d}\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  i_{1d\wedge}\left(  y^{d}\right)
\right)  =\eta\left(  i_{1d\wedge}\left(  y^{d}\right)  \right)  =y,\\
\quad y^{d}\in\mathcal{H}^{1d}.
\end{gather}

\end{enumerate}
\end{proof}
\end{lemma}

\begin{remark}
Recall
\begin{align}
\digamma & :{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \\
\digamma\left(  u\otimes v^{d}\right)    & =i_{1\wedge}\left(  u\right)
\wedge i_{1d\wedge}\left(  v^{d}\right)  \\
\quad z  & \in\mathcal{H}^{1}\oplus\mathcal{H}^{1d};u\in{\huge \wedge}\left(
\mathcal{H}^{1}\right)  ,v\in{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{align}
and
\begin{align}
\boxtimes\left(  \eta\right)    & :{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\\
\boxtimes\left(  \eta\right)  \left(  Z\right)    & =%
%TCIMACRO{\tsum \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tsum \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\sum\limits_{0\leq p\leq n}}
%EndExpansion
\boxtimes^{n}\left(  \eta\right)  \left(  \pi_{\mathcal{H}^{p}\mathcal{H}%
^{d\left(  n-p\right)  }}\left(  Z\right)  \right)  \ \\
\eta\left(  z\right)    & =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d}.
\end{align}

\end{remark}

\begin{corollary}
$\digamma$ and $\boxtimes\left(  \eta\right)  $ are algebra isomorphisms i.e. 

\begin{enumerate}
\item
\begin{equation}
\digamma\left(  \left(  u\otimes v^{d}\right)  @\left(  w\otimes x^{d}\right)
\right)  =\digamma\left(  u\otimes v^{d}\right)  \wedge\digamma\left(
w\otimes x^{d}\right)  ;u,w\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
;v^{d},x^{d}\in{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}


\item
\begin{equation}
\boxtimes\left(  \eta\right)  \left(  A\wedge B\right)  =\boxtimes\left(
\eta\right)  \left(  A\right)  @\boxtimes\left(  \eta\right)  \left(
B\right)
\end{equation}

\end{enumerate}
\end{corollary}

\begin{proof}

\end{proof}

\begin{example}%
\begin{equation}
\left(  x_{1_{1}}\otimes y_{1_{1}}\right)  @\left(  x_{1_{2}}\otimes y_{1_{2}%
}\right)  =-\left(  x_{1_{1}}\wedge x_{1_{2}}\right)  \otimes\left(  y_{1_{1}%
}\wedge y_{1_{2}}\right)
\end{equation}

\end{example}

\begin{remark}%
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\supset%
%TCIMACRO{\tbigoplus \limits_{0\leq p+q=n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p+q=n\leq r}}
%EndExpansion
{\huge \wedge}^{p}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}%
^{q}\left(  \mathcal{H}^{d1}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{H}^{1\oplus1d}=\mathcal{H}^{1}\oplus\mathcal{H}^{1d}.
\end{equation}

\end{remark}

\begin{theorem}
\begin{equation}%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1\oplus1d}\right)  =%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \cong{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \,\widehat{\otimes}\,{\huge \wedge}\left(
\mathcal{H}^{d1}\right)  .
\end{equation}

\end{theorem}


