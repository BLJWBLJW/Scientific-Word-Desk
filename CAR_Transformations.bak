\begin{document}

\title{Proof that Only $\mathrm{U}(n,n)$ Transformations Preserve the
Fermionic CAR}
\author{}
\date{\today}

\begin{abstract}
We prove that the most general linear transformations preserving the
canonical anticommutation relations (CAR) for $n$ fermionic creation and
annihilation operators, while respecting the Hermitian conjugation
structure, belong to the indefinite unitary group $\mathrm{U}(n,n)$.
\end{abstract}

\maketitle

\section{Introduction}

Consider $n$ fermionic annihilation operators $a_i$ and creation operators $%
a_i^\dagger$ ($i=1,\dots,n$) satisfying the CAR: 
\begin{align}
\{a_i, a_j^\dagger\} &= \delta_{ij} \mathbf{1}, \\
\{a_i, a_j\} &= 0, \quad \{a_i^\dagger, a_j^\dagger\} = 0.
\end{align}
We ask: what are the most general linear transformations mixing $a$ and $%
a^\dagger$ that preserve these relations?

\section{Notation and Matrix Form of CAR}

Define the $2n$-component operator vector 
\begin{equation}
\Gamma = 
\begin{pmatrix}
a \\ 
a^\dagger%
\end{pmatrix}%
, \quad a = 
\begin{pmatrix}
a_1 \\ 
\vdots \\ 
a_n%
\end{pmatrix}%
, \quad a^\dagger = 
\begin{pmatrix}
a_1^\dagger \\ 
\vdots \\ 
a_n^\dagger%
\end{pmatrix}%
.
\end{equation}
Its Hermitian conjugate row vector is 
\begin{equation}
\Gamma^\dagger = (a^\dagger, a).
\end{equation}
The CAR become 
\begin{equation}
\{ \Gamma_\alpha, (\Gamma^\dagger)_\beta \} = \delta_{\alpha\beta} \mathbf{1}%
,
\end{equation}
or equivalently, introducing the matrix 
\begin{equation}
C = 
\begin{pmatrix}
0 & I_n \\ 
I_n & 0%
\end{pmatrix}%
,
\end{equation}
we have 
\begin{equation}
\{ \Gamma_\alpha, \Gamma_\beta \} = C_{\alpha\beta} \mathbf{1}.
\end{equation}

\section{General Linear Transformation}

Consider an invertible complex $2n\times 2n$ matrix $M$: 
\begin{equation}
\Gamma ^{\prime }=M\Gamma ,\quad M=%
\begin{pmatrix}
A & B \\ 
C & D%
\end{pmatrix}%
,
\end{equation}%
where $A,B,C,D$ are $n\times n$ blocks. For $\Gamma ^{\prime }$ to have the
same interpretation (first $n$ components are annihilation operators, last $n
$ are creation operators), we require 
\begin{equation}
\begin{pmatrix}
Aa+Ba^{\dagger } \\ 
Ca+Da^{\dagger }%
\end{pmatrix}%
=%
\begin{pmatrix}
a^{\prime } \\ 
a^{\prime \dagger }%
\end{pmatrix}%
.
\end{equation}%
The Hermitian conjugate of the first $n$ components must equal the last $n$
components: 
\begin{equation}
Ca+Da^{\dagger }=(Aa+Ba^{\dagger })^{\dagger }=a^{\dagger }A^{\dagger
}+aB^{\dagger }.
\end{equation}%
This yields the conditions 
\begin{equation}
C=B^{\dagger },\quad D=A^{\dagger }.
\end{equation}%
Thus 
\begin{equation}
M=%
\begin{pmatrix}
A & B \\ 
B^{\dagger } & A^{\dagger }%
\end{pmatrix}%
.
\end{equation}

\section{Preserving the CAR}

The new operators are 
\begin{equation}
a^{\prime \dagger },\quad a^{\prime \dagger }=B^{\dagger }a+A^{\dagger
}a^{\dagger }.
\end{equation}%
Imposing $\{a_{i}^{\prime },a_{j}^{\prime }{}^{\dagger }\}=\delta _{ij}$
gives 
\begin{equation}
\sum_{k}(A_{ik}\bar{A}_{kj}+B_{ik}\bar{B}_{kj})=\delta
_{ij}\;\Longrightarrow \;AA^{\dagger }+BB^{\dagger }=I_{n}.
\end{equation}%
Imposing $\{a_{i}^{\prime },a_{j}^{\prime }\}=0$ gives 
\begin{equation}
\sum_{k}(A_{ik}B_{jk}+B_{ik}A_{jk})=0\;\Longrightarrow \;AB^{T}+BA^{T}=0.
\end{equation}%
The condition $\{(a_{i}^{\prime \dagger },(a_{j}^{\prime \dagger }\}=0$
yields the Hermitian conjugate of the latter, thus the same condition.

\section{Connection to $\mathrm{U}(n,n)$}

Define the indefinite Hermitian metric 
\begin{equation}
\eta = 
\begin{pmatrix}
I_n & 0 \\ 
0 & -I_n%
\end{pmatrix}%
.
\end{equation}
A matrix $M$ preserves this metric if $M^\dagger \eta M = \eta$. Writing $M$
in the block form above, we compute: 
\begin{align}
M^\dagger \eta M &= 
\begin{pmatrix}
A^\dagger & B \\ 
B^\dagger & A%
\end{pmatrix}
\begin{pmatrix}
I_n & 0 \\ 
0 & -I_n%
\end{pmatrix}
\begin{pmatrix}
A & B \\ 
B^\dagger & A^\dagger%
\end{pmatrix}
\\
&= 
\begin{pmatrix}
A^\dagger A - B B^\dagger & A^\dagger B - B A^\dagger \\ 
B^\dagger A - A B^\dagger & B^\dagger B - A A^\dagger%
\end{pmatrix}%
.
\end{align}
Setting this equal to $\eta$ gives precisely 
\begin{align}
A^\dagger A - B B^\dagger &= I_n, \\
A^\dagger B - B A^\dagger &= 0, \\
B^\dagger A - A B^\dagger &= 0, \\
B^\dagger B - A A^\dagger &= -I_n.
\end{align}
These are equivalent to the conditions $A A^\dagger + B B^\dagger = I_n$ and 
$A B^T + B A^T = 0$ derived earlier, given the block structure of $M$.

Thus the set of matrices $M$ of the form $%
\begin{pmatrix}
A & B \\ 
B^\dagger & A^\dagger%
\end{pmatrix}%
$ satisfying these conditions is exactly the unitary group $\mathrm{U}(n,n)$
of the metric $\eta$.

\section{Preservation of the Anticommutation Matrix $C$}

Additionally, preservation of $\{\Gamma_\alpha, \Gamma_\beta\} =
C_{\alpha\beta}$ requires 
\begin{equation}
M C M^T = C,
\end{equation}
which is automatically satisfied by matrices in $\mathrm{U}(n,n)$ with the
given block structure, as can be verified directly.

\section{Conclusion}

The most general linear transformations on the vector $\Gamma = (a,
a^\dagger)^T$ that preserve both the CAR and the Hermitian conjugation
structure (so that transformed creation operators are Hermitian conjugates
of transformed annihilation operators) are exactly those described by
matrices $M$ belonging to the indefinite unitary group $\mathrm{U}(n,n)$.
Any such transformation is a Bogoliubov transformation, and conversely, any
Bogoliubov transformation of this linear type corresponds to an element of $%
\mathrm{U}(n,n)$.

\begin{theorem}
The group of linear transformations $\Gamma \mapsto M\Gamma$ preserving the fermionic CAR $\{\Gamma_\alpha, \Gamma_\beta\} = C_{\alpha\beta}$ and the Hermiticity condition $(\Gamma'_{1\dots n})^\dagger = \Gamma'_{n+1\dots 2n}$ is isomorphic to $\mathrm{U}(n,n)$.
\end{theorem}

