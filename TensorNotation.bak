\part{Tensor Notation}

\section{Representation indices}

\begin{enumerate}
\item
\begin{enumerate}
\item Contravariant \emph{coordinate} indices are superscripts

\item Contravariant \emph{vector} indices are subscripts

\item Representation of a contravariant vector
\begin{equation}
v=\left(  \boldsymbol{e}\right)  ^{t}\mathcal{R}_{e}\left(  v\right)  =\left(
%
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)
\end{equation}


\item Covariant \emph{coordinate} indices are subscripts

\item Covariant \emph{vector} indices are superscripts

\item Representation of a covariant vector%
\begin{equation}
w_{d}=\left(  \boldsymbol{f}_{d}\right)  ^{t}\mathcal{R}_{f_{d}}\left(
w_{d}\right)  =\left(
\begin{array}
[c]{ccc}%
f_{d}^{1} & \cdots & f_{d}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f_{d}}\left(  w_{d}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f_{d}}\left(  w_{d}\right)  _{r}%
\end{array}
\right)
\end{equation}

\end{enumerate}
\end{enumerate}

\begin{notation}
$r\times r$ Matrices are produced by
\begin{equation}
\left[  \left(
\begin{array}
[c]{c}%
f_{d}^{1}\\
\vdots\\
f_{d}^{r}%
\end{array}
\right)  \right]  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
f_{d}^{1}\left(  e_{1}\right)  & \cdots & f_{d}^{1}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
f_{d}^{r}\left(  e_{1}\right)  & \cdots & f_{d}^{r}\left(  e_{r}\right)
\end{array}
\right)
\end{equation}
while operators belonging to $\mathcal{L}\left(  V\right)  $ are produced by
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f_{d}^{1}\\
\vdots\\
f_{d}^{r}%
\end{array}
\right)  \right]  =\sum_{1\leq j\leq r}e_{j}\left[  f_{d}^{j}\right]  .
\end{equation}

\end{notation}

\begin{definition}
The bases $\left(  \boldsymbol{e}\right)  $ of $V$ and $\left(  \boldsymbol{f}%
_{d}\right)  $ of $V^{d}$ are biorthogonal if
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
f_{d}^{1}\left(  e_{1}\right)  & \cdots & f_{d}^{1}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
f_{d}^{r}\left(  e_{1}\right)  & \cdots & f_{d}^{r}\left(  e_{r}\right)
\end{array}
\right)  =\left[  \left(  \boldsymbol{f}_{d}\right)  \right]  \left(
\boldsymbol{e}\right)  ^{t}=\left[  \left(
\begin{array}
[c]{c}%
f_{d}^{1}\\
\vdots\\
f_{d}^{r}%
\end{array}
\right)  \right]  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\mathbb{I}_{r}.
\end{equation}

\end{definition}

\begin{notation}
If $\left(  \boldsymbol{f}_{d}\right)  $ is biorthogonal to $\left(
\boldsymbol{e}\right)  $ i.e.
\begin{equation}
\left(  \boldsymbol{f}_{d}\right)  \,\bot\,\left(  \boldsymbol{e}\right)
\end{equation}
\emph{then it is denoted by} $\left(  \boldsymbol{e}_{b}\right)  $ i.e.
\begin{equation}
\left(  \boldsymbol{e}_{b}\right)  =\left(  \boldsymbol{f}_{d}\right)
=\left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  .
\end{equation}

\end{notation}

\begin{lemma}
If $\left(  \boldsymbol{e}_{b}\right)  \,\bot\,\left(  \boldsymbol{e}\right)
$ then they form

\begin{enumerate}
\item Identity matrix%
\begin{equation}
\left[  \left(  \boldsymbol{e}_{b}\right)  \right]  \left(  \boldsymbol{e}%
\right)  ^{t}=\left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\mathbb{I}_{r}%
\end{equation}
and

\item Identity operator
\begin{equation}
\left(  \boldsymbol{e}\right)  ^{t}\left[  \left(  \boldsymbol{e}_{b}\right)
\right]  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  =I_{r}.
\end{equation}

\end{enumerate}
\end{lemma}

\begin{definition}
Representations $\mathcal{R}_{e}\left(  A\right)  $ of an operator
$A\in\mathcal{L}\left(  V\right)  $ wrt a basis $\left(  \boldsymbol{e}%
\right)  $ are \emph{defined by}
\begin{equation}
A\left(  \boldsymbol{e}\right)  ^{t}=\left(  \boldsymbol{e}\right)
^{t}\mathcal{R}_{e}\left(  A\right)
\end{equation}
i.e.
\begin{equation}
A\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  A\right)  _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right)  _{r}^{1}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  A\right)  _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right)  _{r}^{r}%
\end{array}
\right)  .
\end{equation}

\end{definition}

\begin{remark}
The basis transformation $S_{fe}\in GL\left(  V\right)  \subset\mathcal{L}%
\left(  V\right)  $
\begin{gather}
S_{fe}:\left(  \boldsymbol{e}\right)  ^{t}\rightarrow\left(  \boldsymbol{f}%
\right)  ^{t}\\
\parallel\\
S_{fe}\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)
\end{gather}
of $V$ is given by the operator
\begin{gather}
\left(  \boldsymbol{f}\right)  ^{t}\left[  \left(  \boldsymbol{e}_{b}\right)
\right]  =\left(  \boldsymbol{e}\right)  ^{t}\left(  \mathcal{R}_{e}\left(
\overset{}{\left(  \boldsymbol{f}\right)  \left[  \left(  \boldsymbol{e}%
_{b}\right)  ^{t}\right]  }\right)  \right)  \left[  \left(  \boldsymbol{e}%
_{b}\right)  \right]  =\left(  \boldsymbol{e}\right)  ^{t}\left(
\overset{}{\left[  \left(  \boldsymbol{e}_{b}\right)  ^{t}\right]  \left(
\boldsymbol{f}\right)  \left[  \left(  \boldsymbol{e}_{b}\right)  \right]
}\right)  \left[  \left(  \boldsymbol{e}_{b}\right)  \right]  =\left(
\boldsymbol{e}\right)  ^{t}\mathcal{R}_{e}\left(  S_{fe}\right)  \left[
\left(  \boldsymbol{e}_{b}\right)  \right] \\
\parallel\\
\left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right] \\
\parallel\\
\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  \overset{}{\left(  \boldsymbol{f}\right)  \left[
\left(  \boldsymbol{e}_{b}\right)  ^{t}\right]  }\right)  _{1}^{1} & \cdots &
\mathcal{R}_{e}\left(  \overset{}{\left(  \boldsymbol{f}\right)  \left[
\left(  \boldsymbol{e}_{b}\right)  ^{t}\right]  }\right)  _{1}^{r}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  \overset{}{\left(  \boldsymbol{f}\right)  \left[
\left(  \boldsymbol{e}_{b}\right)  ^{t}\right]  }\right)  _{r}^{1} & \cdots &
\mathcal{R}_{e}\left(  \overset{}{\left(  \boldsymbol{f}\right)  \left[
\left(  \boldsymbol{e}_{b}\right)  ^{t}\right]  }\right)  _{r}^{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right] \\
\parallel\\
\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
e^{1}\left(  f_{1}\right)  & \cdots & e^{1}\left(  f_{r}\right) \\
\vdots & \ddots & \vdots\\
e^{r}\left(  f_{1}\right)  & \cdots & e^{r}\left(  f_{r}\right)
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  S_{fe}\right)  _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left(  S_{fe}\right)  _{r}^{1}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  S_{fe}\right)  _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left(  S_{fe}\right)  _{r}^{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \mathbb{S}_{fe}\left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]
\end{gather}

\end{remark}

\begin{remark}
We \emph{emphasize}
\begin{equation}
\mathcal{R}_{e}\left(  S_{fe}\right)  =\mathcal{R}_{e}\left(
\overset{}{\left(  \boldsymbol{f}\right)  ^{t}\left[  \left(  \boldsymbol{e}%
_{b}\right)  \right]  }\right)  =\mathcal{M}_{e}\left(  \overset{}{\left(
\boldsymbol{f}\right)  ^{t}\left[  \left(  \boldsymbol{e}_{b}\right)  \right]
}\right)  =\left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  \left(  \left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  \right)  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e^{1}\left(  f_{1}\right)   & \cdots & e^{1}\left(  f_{r}\right)  \\
\vdots & \ddots & \vdots\\
e^{r}\left(  f_{1}\right)   & \cdots & e^{r}\left(  f_{r}\right)
\end{array}
\right)  .
\end{equation}

\end{remark}

\begin{definition}
The matrix $\mathcal{R}_{e}\left(  S_{fe}\right)  \in\mathcal{M}\left(
r,r,\mathbb{C}\right)  $ is called the overlap matrix $\mathbb{S}_{fe}$
between the bases $\left(  \boldsymbol{e}_{b}\right)  $ and $\left(
\boldsymbol{f}\right)  .$
\end{definition}

\begin{remark}
Note the representation
\begin{equation}
\mathcal{R}_{e}\left(  \overset{}{\left(  \boldsymbol{f}\right)  ^{t}\left[
\left(  \boldsymbol{e}_{b}\right)  \right]  }\right)  =\left[  \left(
\boldsymbol{e}_{b}\right)  \right]  \left(  \overset{}{\left(  \boldsymbol{f}%
\right)  ^{t}\left[  \left(  \boldsymbol{e}_{b}\right)  \right]  }\right)
\left(  \boldsymbol{e}_{b}\right)  ^{t}=\left(
\begin{array}
[c]{ccc}%
e^{1}\left(  f_{1}\right)  & \cdots & e^{1}\left(  f_{r}\right) \\
\vdots & \ddots & \vdots\\
e^{r}\left(  f_{1}\right)  & \cdots & e^{r}\left(  f_{r}\right)
\end{array}
\right)
\end{equation}
of the operator $\left(  \boldsymbol{f}\right)  ^{t}\left[  \left(
\boldsymbol{e}_{b}\right)  \right]  $ has $e$ and $f$ in the matrix in
reversed order to the operator.
\end{remark}

\begin{remark}
The inverse $\left(  \left(  \boldsymbol{f}\right)  ^{t}\left[  \left(
\boldsymbol{e}_{b}\right)  \right]  \right)  ^{-1}$ of $\left(  \boldsymbol{f}%
\right)  ^{t}\left[  \left(  \boldsymbol{e}_{b}\right)  \right]  $ is $\left(
\boldsymbol{e}\right)  ^{t}\left[  \left(  \boldsymbol{f}_{b}\right)  \right]
$ as
\begin{align}
\left(  \overset{}{\left(  \boldsymbol{e}\right)  ^{t}\left[  \left(
\boldsymbol{f}_{b}\right)  \right]  }\right)  \left(  \overset{}{\left(
\boldsymbol{f}\right)  ^{t}\left[  \left(  \boldsymbol{e}_{b}\right)  \right]
}\right)   &  =\left(  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  \right)  \left(  \left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  \right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \mathbb{I}_{r}\left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  =I_{r}\\
\left(  \overset{}{\left(  \boldsymbol{f}\right)  ^{t}\left[  \left(
\boldsymbol{e}_{b}\right)  \right]  }\right)  \left(  \overset{}{\left(
\boldsymbol{e}\right)  ^{t}\left[  \left(  \boldsymbol{f}_{b}\right)  \right]
}\right)   &  =\left(  \left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  \right)  \left(  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  \right)  =\left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)  \mathbb{I}_{r}\left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{ccc}%
f_{1} & \cdots & f_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  =I_{r}%
\end{align}
i.e.
\begin{equation}
S_{ef}=S_{fe}^{-1}.
\end{equation}

\end{remark}

\subparagraph{Scalar Vectors \label{Scalar Vectors}}

\begin{definition}
Scalar Product
\begin{gather}
w_{d}\left(  v\right)  =w_{d}^{t}v=\left(  \left(  \boldsymbol{f}_{b}\right)
^{t}\mathcal{R}_{f_{b}}\left(  w_{d}\right)  \right)  ^{t}\left(
\boldsymbol{e}\right)  ^{t}\mathcal{R}_{e}\left(  v\right)  =\mathcal{R}%
_{f_{b}}\left(  w_{d}\right)  ^{t}\left(  \overset{}{\left[  \left(
\boldsymbol{f}_{b}\right)  \right]  \left(  \boldsymbol{e}\right)  ^{t}%
}\right)  \mathcal{R}_{e}\left(  v\right) \\
\parallel\\
\left(  \left(
\begin{array}
[c]{ccc}%
f^{1} & \cdots & f^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \right)  ^{t}\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right) \\
\parallel\\
\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
f^{1}\left(  e_{1}\right)  & \cdots & f^{1}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
f^{r}\left(  e_{1}\right)  & \cdots & f^{r}\left(  e_{r}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right) \\
\parallel\\
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  ^{t}\left(  \overset{}{\mathbb{S}%
_{fe}^{-1}}\right)  \mathcal{R}_{e}\left(  v\right)  =\mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  ^{t}\left(  \mathcal{R}_{e}\left(  \overset{}{\left(
\boldsymbol{f}\right)  \left[  \left(  \boldsymbol{e}_{b}\right)  ^{t}\right]
}\right)  \right)  \mathcal{R}_{e}\left(  v\right)  .
\end{gather}

\end{definition}

\begin{notation}
The Overlap Matrix $\mathbb{S}_{fe}$ between the bases $\left(  \boldsymbol{f}%
\right)  $ and $\left(  \boldsymbol{e}\right)  $
\begin{equation}
\mathbb{S}_{fe}=\left[  \left(  \boldsymbol{e}_{b}\right)  \right]  \left(
\overset{}{\left(  \boldsymbol{e}\right)  \left[  \left(  \boldsymbol{f}%
_{b}\right)  ^{t}\right]  }\right)  \left(  \boldsymbol{e}\right)
^{t}=\left[  \left(
\begin{array}
[c]{c}%
e^{1}\\
\vdots\\
e^{r}%
\end{array}
\right)  \right]  \left(  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  \right)  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
f^{1}\left(  e_{1}\right)   & \cdots & f^{1}\left(  e_{r}\right)  \\
\vdots & \ddots & \vdots\\
f^{r}\left(  e_{1}\right)   & \cdots & f^{r}\left(  e_{r}\right)
\end{array}
\right)
\end{equation}
is the inverse of the Metric Matrix $\mathbb{G}_{fe}$ i.e.
\begin{equation}
\mathbb{G}_{fe}=\mathbb{S}_{fe}^{-1}=\mathbb{S}_{ef}=\mathcal{R}_{e}\left(
G_{fe}\right)  .
\end{equation}

\end{notation}

\begin{remark}%
\begin{equation}
w_{d}\left(  v\right)  =w_{d}^{t}v=\mathcal{R}_{f_{b}}\left(  w_{d}\right)
^{t}\mathbb{G}_{fe}\mathcal{R}_{e}\left(  v\right)  .
\end{equation}

\end{remark}

\begin{definition}
\begin{enumerate}
\item Repeated index notation implies sums and corresponds to scalar products
$=$ contraction i.e.%
\begin{equation}
w_{d}\left(  v\right)  =\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{j}\mathcal{R}_{e}\left(  v\right)  ^{j}=\sum_{1\leq j\leq r}\mathcal{R}%
_{e_{b}}\left(  w_{d}\right)  _{j}\mathcal{R}_{e}\left(  v\right)
^{j}=\left(  \mathcal{R}_{e_{b}}\left(  w_{d}\right)  \right)  ^{t}%
\mathcal{R}_{e}\left(  v\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  =z\in\mathbb{C}%
\end{equation}


\item The order of the coordinates does not matter%
\begin{equation}
w_{d}\left(  v\right)  =\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}%
_{e_{b}}\left(  w_{d}\right)  _{j}=\sum_{1\leq j\leq r}\mathcal{R}_{e}\left(
v\right)  ^{j}\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{j}=\left(
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  \right)  ^{t}\mathcal{R}_{e}\left(
v\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  =z\in\mathbb{C}=\mathcal{M}\left(  1,1,\mathbb{C}\right)
\end{equation}


\item Resulting unpaired indices implies increased rank i.e corresponds to
tensor product i.e.
\begin{align}
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{k}  &  =\mathcal{R}_{e}\left(  v\right)  \otimes\left(  \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  \right)  ^{t}=\mathcal{R}_{e}\left(  v\right)  \left(
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  \right)  ^{t}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right) \\
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{k}  &  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  =\mathcal{R}_{e_{b}e}\left(  \overset{}{vw_{d}^{t}}\right)  _{k}%
^{j}\equiv\mathcal{R}_{e_{b}}\left(  \overset{}{vw_{d}^{t}}\right)
\in\mathcal{L}\left(  V\right)  =\mathcal{M}_{e_{b}e}\left(  vw_{d}%
^{t}\right)  \in\mathcal{M}\left(  r,r,\mathbb{C}\right)
\end{align}


\item The order of the coordinates does not matter%
\begin{equation}
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{k}\mathcal{R}_{e}\left(  v\right)
^{j}=\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{eb}\left(
w_{d}\right)  _{k}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  .
\end{equation}

\end{enumerate}
\end{definition}

\begin{remark}
The tensor product is given by
\begin{equation}
\mathcal{R}_{e}\left(  v\otimes w_{d}\right)  =\mathcal{R}_{e}\left(
v\right)  ^{j}\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{k}=\mathcal{R}%
_{e_{d}}\left(  w_{d}\right)  _{k}\mathcal{R}_{e}\left(  v\right)
^{j}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)
\end{equation}
and the scalar product by
\begin{equation}
w_{d}\left(  v\right)  =\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}%
_{e_{b}}\left(  w_{d}\right)  _{j}=\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{j}\mathcal{R}_{e}\left(  v\right)  ^{j}=\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  .
\end{equation}

\end{remark}

\subparagraph{Super Vectors \label{Super Vectors}}

\begin{definition}
\begin{enumerate}
\item
\begin{enumerate}
\item Repeated index notation implies sums and corresponds to tensor products
i.e.%
\begin{equation}
e_{j}f_{d}^{j}=\sum_{1\leq j\leq r}e_{j}f_{d}^{j}=\left(  \boldsymbol{e}%
\right)  ^{t}\otimes\left(  \boldsymbol{f}_{d}\right)  =\left(  \boldsymbol{e}%
\right)  ^{t}\left(  \boldsymbol{f}_{d}\right)  \leftrightarrow\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{j}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f_{d}^{1}\\
\vdots\\
f_{d}^{r}%
\end{array}
\right)  \right]  \in\mathcal{L}\left(  V\right)
\end{equation}


\item The order of the entries {\Large do} matter%
\begin{equation}
f_{d}^{j}e_{j}=\left[  \left(  \boldsymbol{f}_{d}\right)  \right]  \left(
\boldsymbol{e}\right)  ^{t}=\left(  \boldsymbol{f}_{d}\right)  \left(
\boldsymbol{e}\right)  ^{t}=\left[  \left(
\begin{array}
[c]{c}%
f_{d}^{1}\\
\vdots\\
f_{d}^{r}%
\end{array}
\right)  \right]  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{j}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
f_{d}^{1}\left(  e_{1}\right)  & \cdots & f_{d}^{1}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
f_{d}^{r}\left(  e_{1}\right)  & \cdots & f_{d}^{r}\left(  e_{r}\right)
\end{array}
\right)  \in\mathcal{M}\left(  r,r,\mathbb{C}\right)
\end{equation}


\item Unpaired indices implies increased rank i.e corresponds to tensor
product i.e.
\begin{gather}
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{k}=\mathcal{R}_{e}\left(  v\right)  \otimes\left(  \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  \right)  ^{t}=\mathcal{R}_{e}\left(  v\right)  \left(
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  \right)  ^{t}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \\
\parallel\\
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{k}=\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  =\mathcal{R}_{e_{b}e}\left(  vw_{d}^{t}\right)  _{k}^{j}%
\equiv\mathcal{R}_{e_{b}e}\left(  vw_{d}^{t}\right)  \in\mathcal{L}\left(
V\right)  =\mathcal{M}_{e_{b}e}\left(  vw_{d}^{t}\right)  \in\mathcal{M}%
\left(  r,r,\mathbb{C}\right)
\end{gather}


\item The order of the scalar coordinates do not matter%
\begin{equation}
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{k}\mathcal{R}_{e}\left(  v\right)
^{j}=\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{b}}\left(
w_{d}\right)  _{k}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{eb}\left(
w_{d}\right)  _{r}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{b}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{eb}\left(
w_{d}\right)  _{r}%
\end{array}
\right)  .
\end{equation}

\end{enumerate}
\end{enumerate}
\end{definition}

\begin{remark}
\emph{Contravariant} vector $v$ representations $\mathcal{R}_{e}\left(
v\right)  $ transform as $\mathcal{R}_{e}\left(  A\right)  ^{-1}%
\mathcal{R}_{e}\left(  v\right)  $, where $A\in GL\left(  V\right)  $ is the
transformation of the basis.
\end{remark}

\begin{remark}
\emph{Covariant} vector $v_{d}$ representations $\mathcal{R}_{e}\left(
v_{d}\right)  $ transform as $\mathcal{R}_{e}\left(  A_{d}\right)
^{-1}\mathcal{R}_{e}\left(  v_{d}\right)  $, where $A_{d}\in GL\left(
V_{d}\right)  $ is the transformation of the basis.
\end{remark}

\begin{theorem}
Let $A\in GL\left(  V\right)  $ then the induced basis change $b\left(
A\right)  $ of $V^{d}$ by the basis change $A$ of $V$
\begin{equation}
b\left(  A\right)  :\left(  \boldsymbol{e}_{b}\right)  \rightarrow\left(
\boldsymbol{f}_{b}\right)  =\left(  \overset{}{b\left(  A\right)
\boldsymbol{e}_{b}}\right)
\end{equation}
shows that the coordinates of the representation $\mathcal{R}_{e_{b}}\left(
v_{d}\right)  $ of the vector $v_{d}$ transform by the matrix representation
$\mathcal{R}_{e}\left(  A\right)  $ of $A$ wrt the basis $\left(
\boldsymbol{e}\right)  $ i.e.
\begin{equation}
\mathcal{R}_{f_{b}}\left(  v_{d}\right)  =\mathcal{R}_{e_{b}}\left(  b\left(
A\right)  \right)  \mathcal{R}_{e}\left(  v_{d}\right)  =\mathcal{R}%
_{e}\left(  A\right)  \mathcal{R}_{e}\left(  v_{d}\right)
\end{equation}
i.e.%
\begin{equation}
\mathcal{R}_{e_{b}}\left(  b\left(  A\right)  \right)  =\mathcal{R}_{e}\left(
A\right)  .
\end{equation}

\end{theorem}

\begin{enumerate}
\item Representation of vectors
\begin{equation}
v=\left(  \boldsymbol{e}\right)  ^{t}\mathcal{R}_{e}\left(  v\right)  =\left(
%
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)
\end{equation}


\item Representation of dual vectors%
\begin{equation}
w_{d}=\left(  \boldsymbol{f}_{b}\right)  ^{t}\mathcal{R}_{f_{d}}\left(
w_{d}\right)  =\left(
\begin{array}
[c]{ccc}%
f^{1} & \cdots & f^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{r}%
\end{array}
\right)
\end{equation}


\item General Form of Scalar Product \label{General Form of Scalar Product}%
\begin{align}
w_{d}\left(  v\right)   &  =\left(  \left(
\begin{array}
[c]{ccc}%
f^{1} & \cdots & f^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1}\\
\vdots\\
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \right)  ^{t}\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left[  \left(
\begin{array}
[c]{c}%
f^{1}\\
\vdots\\
f^{r}%
\end{array}
\right)  \right]  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
f^{1}\left(  e_{1}\right)  & \cdots & f^{1}\left(  e_{r}\right) \\
\vdots & \ddots & \vdots\\
f^{r}\left(  e_{1}\right)  & \cdots & f^{r}\left(  e_{r}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \mathbb{S}_{fe}^{-1}\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{f_{b}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{f_{b}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \mathbb{G}_{fe}\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  .
\end{align}

\end{enumerate}

