\sum_{\substack{1\leq j_{3}\leq n\\1\leq k_{1}\leq m}}\left[  u_{j_{3}%
}z_{k_{1}}^{d}\right]  \mathcal{R}_{uz}\left(  \U{3a3} \right)  _{j_{3}k_{1}%
}=\sum_{1\leq j_{3}\leq\min\left(  n,m\right)  }\left[  u_{j_{3}}z_{j_{3}}%
^{d}\right]  \mathcal{R}_{uz}\left(  \U{3a3} \right)  _{j_{3}j_{3}}%
\end{equation}


\item The columns of $V$ (right-singular vectors) are eigenvectors of
