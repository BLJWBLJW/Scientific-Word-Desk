\section{Singular Valued Decomposition (SVD)}

Let $\mathcal{V}$ and $\mathcal{W}$ be normed spaces and consider the linear
map
\begin{equation}
M:\mathcal{V}\rightarrow\mathcal{W},\quad M\in\mathcal{L}\left(
\mathcal{V},\mathcal{W}\right)
\end{equation}
and the dual map
\begin{equation}
M^{d}:\mathcal{W}^{d}\rightarrow\mathcal{V}^{d},\quad M^{d}\in\mathcal{L}%
\left(  \mathcal{W}^{d},\mathcal{V}^{d}\right)
\end{equation}
defined by%
\begin{equation}
\left\langle w^{d},Mv\right\rangle =\left\langle M^{d}w^{d},v\right\rangle .
\end{equation}
The map $M$ is a surjection (\emph{submersion}) if
\begin{equation}
\operatorname*{Range}\left\{  M\right\}  =\mathcal{W}%
\end{equation}
if it is injective it is an \emph{immersion} and it \emph{embeds}
$\mathcal{V}$ in $\mathcal{W}.$

\begin{definition}
A complete normed space is a Banach space. 
\end{definition}

\begin{definition}
Let $\mathcal{X}$ and $\mathcal{Y}$ be Banach spaces such that dim$\left\{
\mathcal{X}\right\}  \leq\,$dim$\left\{  \mathcal{Y}\right\}  $ with bases
$\left\{  e_{1},\cdots,e_{q}\right\}  $ and $\left\{  f_{1},\cdots
,f_{q},f_{q+1,\cdots,}f_{p}\right\}  $ then $\mathcal{Y}$ \emph{envelopes
}$\mathcal{X}$ and $\mathcal{X}$ is \emph{embedded }in $\mathcal{Y}$ through
an injection $\mathfrak{i}_{ef}\in\mathcal{L}\left(  \mathcal{X}%
,\mathcal{Y}\right)  $
\begin{equation}
\mathfrak{i}_{ef}:\left\{  e_{1},\cdots,e_{q}\right\}  \rightarrow\left\{
f_{1},\cdots,f_{q},f_{q+1,\cdots,}f_{p}\right\}  ,
\end{equation}
where
\begin{equation}
\operatorname{Ran}\left\{  \mathfrak{i}\right\}  ^{c}=\mathbb{C}%
\text{-}\operatorname*{linspan}\left\{  f_{q+1,\cdots,}f_{p}\right\}
\end{equation}
and
\begin{equation}
\operatorname{Ran}\left\{  \mathfrak{i}\right\}  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  f_{1},\cdots,f_{q}\right\}  .
\end{equation}


\begin{example}

\end{example}
\end{definition}

\begin{example}
\begin{enumerate}
\item The injection $\mathfrak{i}_{ef}$ embeds $\mathcal{X}=\mathbb{C}^{2}$
into $\mathcal{Y}=\mathbb{C}^{3}$

\begin{enumerate}
\item It has the following properties%
\begin{gather}
\mathfrak{i}_{ef}:\mathbb{C}^{2}\rightarrow\mathbb{C}^{3}\\
\mathfrak{i}_{ef}:\ker\left\{  \mathfrak{i}_{ef}\right\}  ^{c}\subseteq
\mathcal{X}\rightarrow\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}
\subseteq\mathcal{Y}\\
\ker\left\{  \mathfrak{i}_{ef}\right\}  ^{c}\cong\operatorname{Ran}\left\{
\mathfrak{i}_{ef}\right\}  .
\end{gather}


\item It transforms the basis $\left(  \mathbf{e}\right)  $ of $\mathcal{X}$
into the basis $\left(  \mathbf{f}\right)  $ of $\mathcal{Y}$
\begin{equation}
\mathfrak{i}_{ef}:\left\{  e_{1},e_{2}\right\}  \rightarrow\left\{
f_{1},f_{2},f_{3}\right\}  =\left\{  \mathfrak{i}_{ef}\left(  e_{1}\right)
,\mathfrak{i}_{ef}\left(  e_{2}\right)  ,f_{3}\right\}  ,\quad f_{3}%
\in\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}  ^{c}.
\end{equation}


\item And embeds the basis $\left(  \mathbf{e}\right)  $ into $\mathcal{Y}$
\begin{gather}
\mathfrak{i}_{ef}\left(  \left(  \mathbf{e}\right)  \right)  =\mathfrak{i}%
_{ef}\left(  \left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \right)  =\left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \mathcal{R}_{e}\left(  \mathfrak{i}_{ef}\right)  =\left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{i}_{ef}\left(  e_{1}\right)   & \mathfrak{i}_{ef}\left(
e_{2}\right)   & 0
\end{array}
\right)  \\
=\left(
\begin{array}
[c]{ccc}%
\mathfrak{i}_{ef}\left(  e_{1}\right)   & \mathfrak{i}_{ef}\left(
e_{2}\right)   & f_{3}%
\end{array}
\right)  \mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{i}_{ef}\left(  e_{1}\right)   & \mathfrak{i}_{ef}\left(
e_{2}\right)   & f_{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{i}_{ef}\left(  e_{1}\right)   & \mathfrak{i}_{ef}\left(
e_{2}\right)   & 0
\end{array}
\right)  ,
\end{gather}
where $\mathcal{R}_{e}\left(  \mathfrak{i}_{ef}\right)  $ is the $\left(
\mathbf{e}\right)  $-representation of the injection $\mathfrak{i}_{ef}$ and
$\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\right)  $ is the
\emph{corresponding} $\left(  \mathbf{f}\right)  $-representation of the
injection $\mathfrak{i}_{ef}.$ $\mathcal{R}_{e}\left(  \mathfrak{i}%
_{ef}\right)  $ is the representaion of the injection $\equiv$ embedding
$\mathfrak{i}_{ef}$ wrt the basis $\left(  \mathbf{e}\right)  $ i.e.

\begin{description}
\item[*]
\begin{equation}
\mathcal{R}_{e}\left(  \mathfrak{i}_{ef}\right)  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0
\end{array}
\right)
\end{equation}
and 

\item[*] $\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\right)  $ is the
representaion of the image of the injection $\equiv$ embedding $\mathfrak{i}%
_{ef}\in$ $\mathcal{L}\left(  \mathcal{X},\mathcal{Y}\right)  $ considered as
an operator belonging to $\mathcal{L}\left(  \mathcal{Y}\right)  $ wrt the
basis $\left(  \mathbf{f}\right)  $ i.e.
\begin{equation}
\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\right)  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  .
\end{equation}

\end{description}

\item Embedding of vectors $z\in\mathcal{X}$%
\begin{align}
\mathfrak{i}_{ef}\left(  z\right)   &  =\mathfrak{i}_{ef}\left(
\overset{}{\left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \mathcal{R}_{e}\left(  z\right)  }\right)  =\mathfrak{i}_{ef}\left(
\left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}%
\end{array}
\right)  \right)  =\mathfrak{i}_{ef}\left(  \left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \right)  \mathfrak{i}_{ef}\left(  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}%
\end{array}
\right)  \right)  \\
&  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{i}_{ef}\left(  e_{1}\right)   & \mathfrak{i}_{ef}\left(
e_{2}\right)   & f_{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathfrak{i}_{ef}\left(  e_{1}\right)   & \mathfrak{i}_{ef}\left(
e_{2}\right)   & f_{3}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  z\right)  _{1}\\
\mathcal{R}_{f}\left(  z\right)  _{2}\\
0
\end{array}
\right)  .
\end{align}


\begin{description}
\item[*] $\mathcal{R}_{e}\left(  z\right)  $ is the representaion of the
vector $z\in$ $\mathcal{X}$ wrt the basis $\left(  \mathbf{e}\right)  $ i.e.
\begin{equation}
\mathcal{R}_{e}\left(  z\right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}%
\end{array}
\right)
\end{equation}
and

\item[*] $\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\left(  z\right)  \right)  $
is the representaion of the image $\mathfrak{i}_{ef}\left(  z\right)
\in\mathcal{Y}$ of the vector $z\in$ $\mathcal{X}$ wrt the basis $\left(
\mathbf{f}\right)  $ i.e.
\begin{equation}
\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\left(  z\right)  \right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  z\right)  _{1}\\
\mathcal{R}_{f}\left(  z\right)  _{2}\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}\\
0
\end{array}
\right)  .
\end{equation}

\end{description}

\item Representation of the injection process%
\begin{equation}
\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\left(  z\right)  \right)
=\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\left(  \overset{}{\left(
\mathbf{e}\right)  \mathcal{R}_{e}\left(  z\right)  }\right)  \right)
=\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\left(  \left(
\begin{array}
[c]{cc}%
e_{1} & e_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}%
\end{array}
\right)  \right)  \right)  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  z\right)  _{1}\\
\mathcal{R}_{f}\left(  z\right)  _{2}\\
0
\end{array}
\right)  .
\end{equation}


\item Embedding correspondence%
\begin{equation}
\left(
\begin{array}
[c]{c}%
\mathcal{R}_{f}\left(  z\right)  _{1}\\
\mathcal{R}_{f}\left(  z\right)  _{2}\\
0
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  z\right)  _{1}\\
\mathcal{R}_{e}\left(  z\right)  _{2}\\
0
\end{array}
\right)  .
\end{equation}


\item $e$-representation of the injection $\mathfrak{i}_{ef}$%
\begin{equation}
\mathcal{R}_{fe}\left(  \mathfrak{i}_{ef}\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1\\
0 & 0
\end{array}
\right)  .
\end{equation}


\item $f$-representation of the injection $\mathfrak{i}_{ef}$%
\begin{equation}
\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\right)  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  .
\end{equation}


\item The inverse $\mathfrak{i}_{ef}^{-1}$ of the injection $\mathfrak{i}%
_{ef}$
\begin{equation}
\mathfrak{i}_{ef}^{-1}:\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}
\rightarrow\mathcal{X}%
\end{equation}


\item $f$-representation of the injection $\mathfrak{i}_{ef}^{-1}$%
\begin{equation}
\mathcal{R}_{fe}\left(  \mathfrak{i}_{ef}^{-1}\right)  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0
\end{array}
\right)
\end{equation}


\item $e$-representation of the injection $\mathfrak{i}_{ef}^{-1}$%
\begin{equation}
\mathcal{R}_{e}\left(  \mathfrak{i}_{ef}^{-1}\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)
\end{equation}


\item
\begin{gather}
\mathfrak{i}_{ef}\mathfrak{i}_{ef}^{-1}:\operatorname{Ran}\left\{
\mathfrak{i}_{ef}\right\}  \rightarrow\operatorname{Ran}\left\{
\mathfrak{i}_{ef}\right\}  \\
\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}  \subseteq\mathcal{Y}\\
\mathfrak{i}_{ef}^{-1}\mathfrak{i}_{ef}:\operatorname{Ker}\left\{
\mathfrak{i}_{ef}\right\}  ^{c}\rightarrow\operatorname{Ker}\left\{
\mathfrak{i}_{ef}\right\}  ^{c}\\
\operatorname{Ker}\left\{  \mathfrak{i}_{ef}\right\}  ^{c}\subseteq\mathcal{X}%
\end{gather}


\item
\begin{align}
\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}^{-1}\right)  \mathcal{R}_{e}\left(
\mathfrak{i}_{ef}\right)   &  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1\\
0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  =\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}^{-1}\mathfrak{i}%
_{ef}\right)  =\mathcal{R}_{e}\left(  P_{\operatorname{Ker}\left\{
\mathfrak{i}_{ef}\right\}  ^{c}}\right)  \\
\mathcal{R}_{e}\left(  \mathfrak{i}_{ef}\right)  \mathcal{R}_{f}\left(
\mathfrak{i}_{ef}^{-1}\right)   &  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1\\
0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  =\mathcal{R}_{f}\left(  \mathfrak{i}_{ef}\mathfrak{i}_{ef}%
^{-1}\right)  =\mathcal{R}_{f}\left(  P_{\operatorname{Ran}\left\{
\mathfrak{i}_{ef}\right\}  }\right)
\end{align}


\item
\begin{align}
A  & =P_{\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}  }%
AP_{\operatorname{Ker}\left\{  \mathfrak{i}_{ef}\right\}  ^{c}}=\left[
\mathfrak{i}_{ef}\left(  \mathbf{e}\right)  \left(  \overset{}{\mathfrak{i}%
_{ef}\left(  \mathbf{e}\right)  }\right)  ^{d}\right]  A\left[  \left(
\mathbf{e}\right)  \left(  \mathbf{e}\right)  ^{d}\right]  \\
& =\mathfrak{i}_{ef}\left(  \mathbf{e}\right)  \left(  \overset{}{\left(
\overset{}{\mathfrak{i}_{ef}\left(  \mathbf{e}\right)  }\right)  ^{d}\left(
A\left(  \mathbf{e}\right)  \right)  }\right)  \left(  \mathbf{e}\right)
^{d}=\sum_{\substack{1\leq j\leq3\\1\leq k\leq2}}\left[  \left(
\overset{}{\mathfrak{i}_{ef}\left(  e_{j}\right)  }\right)  ^{d}e_{k}\right]
\mathcal{R}_{fe}\left(  A\right)  _{jk}%
\end{align}


\item
\begin{equation}
\left(  \overset{}{\mathfrak{i}_{ef}\left(  \mathbf{e}\right)  ^{d}\left(
A\left(  \mathbf{e}\right)  \right)  }\right)  _{jk}=\mathfrak{i}_{ef}\left(
e_{j}\right)  ^{d}\left(  \overset{}{Ae_{k}}\right)  =\mathcal{M}_{fe}\left(
A\right)  _{jk}=\mathcal{R}_{fe}\left(  A\right)  _{jk},\quad1\leq
j\leq3,1\leq k\leq2
\end{equation}


\item
\begin{align}
\mathcal{R}_{fe}\left(  A\right)   &  =\mathcal{R}_{fe}\left(
P_{\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}  }%
AP_{\operatorname{Ker}\left\{  \mathfrak{i}_{ef}\right\}  ^{c}}\right)
=\mathcal{R}_{f}\left(  P_{\operatorname{Ran}\left\{  \mathfrak{i}%
_{ef}\right\}  }\right)  \mathcal{R}_{fe}\left(  A\right)  \mathcal{R}%
_{e}\left(  P_{\operatorname{Ker}\left\{  \mathfrak{i}_{ef}\right\}  ^{c}%
}\right)  \\
= &  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathcal{R}_{fe}\left(  A\right)  _{11} & \mathcal{R}_{fe}\left(  A\right)
_{12}\\
\mathcal{R}_{fe}\left(  A\right)  _{21} & \mathcal{R}_{fe}\left(  A\right)
_{22}\\
\mathcal{R}_{fe}\left(  A\right)  _{31} & \mathcal{R}_{fe}\left(  A\right)
_{32}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{e}\left(  A\right)  _{11} & \mathcal{R}_{e}\left(  A\right)
_{12}\\
\mathcal{R}_{e}\left(  A\right)  _{21} & \mathcal{R}_{e}\left(  A\right)
_{22}\\
\mathcal{R}_{e}\left(  A\right)  _{31} & \mathcal{R}_{e}\left(  A\right)
_{32}%
\end{array}
\right)  ,
\end{align}
i.e.%
\begin{equation}
\mathcal{R}_{fe}\left(  A\right)  =\mathcal{M}_{fe}\left(  A\right)  =\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{fe}\left(  A\right)  _{11} & \mathcal{R}_{fe}\left(  A\right)
_{12}\\
\mathcal{R}_{fe}\left(  A\right)  _{21} & \mathcal{R}_{fe}\left(  A\right)
_{22}\\
\mathcal{R}_{fe}\left(  A\right)  _{31} & \mathcal{R}_{fe}\left(  A\right)
_{32}%
\end{array}
\right)  .
\end{equation}


\item
\begin{equation}
\left(  A\mathfrak{i}_{ef}^{-1}\right)  :\mathcal{Y\rightarrow Y}.
\end{equation}


\item The matrix of the embedded operator $A$ i.e. the corresponding operator
\begin{equation}
\mathcal{R}_{f}\left(  A\mathfrak{i}_{ef}^{-1}\right)  =\mathcal{R}%
_{fe}\left(  A\right)  \mathcal{R}_{fe}\left(  \mathfrak{i}_{ef}^{-1}\right)
=\left(
\begin{array}
[c]{cc}%
\mathcal{R}_{fe}\left(  A\right)  _{11} & \mathcal{R}_{fe}\left(  A\right)
_{12}\\
\mathcal{R}_{fe}\left(  A\right)  _{21} & \mathcal{R}_{fe}\left(  A\right)
_{22}\\
\mathcal{R}_{fe}\left(  A\right)  _{31} & \mathcal{R}_{fe}\left(  A\right)
_{32}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{fe}\left(  A\right)  _{11} & \mathcal{R}_{fe}\left(  A\right)
_{12} & 0\\
\mathcal{R}_{fe}\left(  A\right)  _{21} & \mathcal{R}_{fe}\left(  A\right)
_{22} & 0\\
\mathcal{R}_{fe}\left(  A\right)  _{31} & \mathcal{R}_{fe}\left(  A\right)
_{32} & 0
\end{array}
\right)  .
\end{equation}

\end{enumerate}

\item The general map $A\in\mathcal{L}\left(  \mathcal{X},\mathcal{Y}\right)
$

\begin{enumerate}
\item
\begin{align}
Az &  =\eta,\quad A\in\mathcal{L}\left(  \mathcal{X},\mathcal{Y}\right)
,\quad z\in\mathcal{X},\quad\mathcal{Y}\\
\left(  A\mathfrak{i}_{ef}^{-1}\right)  \left(  \mathfrak{i}_{ef}\left(
z\right)  \right)   &  =\eta\in\mathcal{Y}\\
\mathfrak{i}_{ef}\left(  z\right)   &  \in\mathcal{Y}\\
\left(  A\mathfrak{i}_{ef}^{-1}\right)   &  \in\mathcal{L}\left(
P_{\operatorname{Ran}\left\{  \mathfrak{i}_{ef}\right\}  }\mathcal{Y}\right)
\subseteq\mathcal{L}\left(  \mathcal{Y}\right)  .
\end{align}


\item
