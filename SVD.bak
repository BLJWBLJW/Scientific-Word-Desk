\end{array}
\right)  \right]  \left[  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
z_{1}\\
z_{2}\\
\widetilde{z_{3}}%
\end{array}
\right)  \right]  =\left(
\begin{array}
[c]{c}%
\eta_{1}\\
\eta_{2}\\
\eta_{3}%
\end{array}
\right)
\end{gather}
where

\begin{enumerate}
\item $P_{2}$ is the projector onto the $\operatorname{Ran}\left\{
\mathfrak{i}\right\}  $ of $\mathfrak{i.}$

\item The projection $P_{2}\widetilde{A}P_{2}$ of $\widetilde{A}\in
\mathcal{L}\left(  \mathcal{Y}\right)  $ producing $\mathfrak{i}\left(
A\right)  ,$ where $A\in\mathcal{L}\left(  \mathcal{X},\mathcal{Y}\right)  $
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
A_{11} & A_{12} & A_{13}\\
A_{21} & A_{22} & A_{23}\\
A_{31} & A_{32} & A_{33}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
A_{11} & A_{12} & 0\\
A_{21} & A_{22} & 0\\
A_{31} & A_{32} & 0
\end{array}
\right)
\end{equation}
and

\item
\begin{equation}
\left(
\begin{array}
[c]{ccc}%
1 & 0 & 0\\
0 & 1 & 0\\
0 & 0 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
z_{1}\\
z_{2}\\
z_{3}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
z_{1}\\
z_{2}\\
0
\end{array}
\right)  .
\end{equation}
One can always find many $\widetilde{A}\in$ $\mathcal{L}\left(  \mathcal{Y}%
\right)  $ such that
\begin{equation}
P_{2}\widetilde{A}P_{2}=P_{2}\left(  \mathfrak{i}A\mathfrak{i}^{-1}\right)
P_{2}.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{example}

\begin{remark}
A complete normed space is a Banach space.
\end{remark}

\begin{definition}
One can define an adjoint $A^{\dagger}$ of a closed densely defined operator
$A\in\mathcal{L}\left(  \mathcal{V}\right)  $ by
\end{definition}

\begin{enumerate}
\item
\begin{equation}
\left(  zA\right)  ^{\dagger}=\overline{z}A^{\dagger}%
\end{equation}


\item
\begin{equation}
A^{\dagger\dagger}=A
\end{equation}


\item
\begin{equation}
\left(  A+B\right)  ^{\dagger}=A^{\dagger}+B^{\dagger}%
\end{equation}


\item
\begin{equation}
A^{\dagger}B^{\dagger}=\left(  BA\right)  ^{\dagger}\text{ on }%
\operatorname*{Dom}\left\{  A^{\dagger}\right\}  \cap\operatorname*{Dom}%
\left\{  B^{\dagger}\right\}
\end{equation}


\item if $A\in\mathcal{L}\left(  \mathcal{V}\right)  ,$ then
\begin{equation}
\Vert A^{\dagger}A\Vert_{\mathcal{L}\left(  \mathcal{V}\right)  }\leq M\Vert
A\Vert_{\mathcal{L}\left(  \mathcal{V}\right)  }^{2}%
\end{equation}


\item if $A\in\mathcal{L}\left(  \mathcal{V}\right)  ,$ it has a bounded
extension to $\mathcal{L}[H]$
\end{enumerate}

\begin{remark}%
\begin{gather}
\mathcal{V}\overset{M}{------\rightarrow}\mathcal{W}\\
\left\vert \qquad\quad\qquad\qquad\qquad\right\vert \\
\digamma_{v}\left\vert \qquad\quad\quad\quad\qquad\,\,\qquad\right\vert
\digamma_{w}\\
\downarrow\quad\qquad\qquad\quad\qquad\downarrow\,\\
\mathcal{V}^{d}\overset{M^{d}}{\longleftarrow------}\mathcal{W}^{d}%
\end{gather}

\end{remark}

\begin{remark}
One has the dual "bases"
\begin{align}
v_{j},v_{j}^{d},\quad1  &  \leq j\leq m\\
w_{j},w_{j}^{d},\quad1  &  \leq j\leq n,
\end{align}
where
\begin{equation}
\dim\left\{  \mathcal{V}\right\}  =m\text{ and }\dim\left\{  \mathcal{W}%
\right\}  =n.
\end{equation}

\end{remark}

\begin{remark}
In the following $1\leq j\leq m,1\leq k\leq n.$One can form the following
injections from tensor product spaces to operator spaces

\begin{enumerate}
\item The tensor product space $\mathcal{W\otimes V}^{d}$
\begin{equation}
\Lambda_{wv^{d}}:\mathcal{W\otimes V}^{d}\rightarrow\mathcal{L}\left(
\mathcal{V},\mathcal{W}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
w_{j}v_{k}^{d}\right]  \right\}  .$

\item The tensor product space $\mathcal{V\otimes W}^{d}$%
\begin{equation}
\Lambda_{wv^{d}}:\mathcal{V\otimes W}^{d}\rightarrow\mathcal{L}\left(
\mathcal{W},\mathcal{V}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
v_{j}w_{k}^{d}\right]  \right\}  =\left\{  \left[  w_{j}v_{k}^{d}\right]
^{d}\right\}  .$

\item The tensor product space $\mathcal{V}^{d}\mathcal{\otimes W}$%
\begin{equation}
\Lambda_{v^{d}w}:\mathcal{V}^{d}\mathcal{\otimes W}\rightarrow\mathcal{L}%
\left(  \mathcal{W}^{d},\mathcal{V}^{d}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
v_{j}^{d}w_{k}\right]  \right\}  .$

\item The tensor product space $\mathcal{W}^{d}\mathcal{\otimes V}$%
\begin{equation}
\Lambda_{w^{d}v}:\mathcal{W}^{d}\mathcal{\otimes V}\rightarrow\mathcal{L}%
\left(  \mathcal{V}^{d},\mathcal{W}^{d}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
w_{j}^{d}v_{k}\right]  \right\}  =\left\{  \left[  v_{j}^{d}w_{k}\right]
^{d}\right\}  .$

\item The tensor product space $\mathcal{W\otimes W}^{d}$%
\begin{equation}
\Lambda_{ww^{d}}:\mathcal{W\otimes W}^{d}\rightarrow\mathcal{L}\left(
\mathcal{W},\mathcal{W}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
w_{j}w_{k}^{d}\right]  \right\}  .$

\item The tensor product space $\mathcal{W}^{d}\mathcal{\otimes W}$%
\begin{equation}
\Lambda_{w^{d}w}:\mathcal{W}^{d}\mathcal{\otimes W}\rightarrow\mathcal{L}%
\left(  \mathcal{W}^{d},\mathcal{W}^{d}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
w_{j}^{d}w_{k}\right]  \right\}  =\left\{  \left[  w_{j}w_{k}^{d}\right]
^{d}\right\}  $

\item The tensor product space $\mathcal{V\otimes V}^{d}$%
\begin{equation}
\Lambda_{vv^{d}}:\mathcal{V\otimes V}^{d}\rightarrow\mathcal{L}\left(
\mathcal{V},\mathcal{V}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
v_{j}v_{k}^{d}\right]  \right\}  .$

\item The tensor product space $\mathcal{V}^{d}\mathcal{\otimes V}$%
\begin{equation}
\Lambda_{v^{d}w}:\mathcal{V}^{d}\mathcal{\otimes V}\rightarrow\mathcal{L}%
\left(  \mathcal{V}^{d},\mathcal{V}^{d}\right)
\end{equation}
the operator space is generated by the elementary operators $\left\{  \left[
v_{j}^{d}v_{k}\right]  \right\}  =\left\{  \left[  v_{j}v_{k}^{d}\right]
^{d}\right\}  .$
\end{enumerate}
\end{remark}

\begin{remark}
\begin{enumerate}
\item One has the injections

\begin{enumerate}
\item
\begin{equation}
\digamma_{v}:\mathcal{V}\rightarrow\mathcal{V}^{d}%
\end{equation}
and

\item
\begin{equation}
\digamma_{v^{d}}^{-1}:\operatorname*{Range}\left\{  \digamma_{v}\right\}
\rightarrow\mathcal{V},
\end{equation}

\end{enumerate}

\item One has the injections

\begin{enumerate}
\item
\begin{equation}
\digamma_{w}:\mathcal{W}\rightarrow\mathcal{W}^{d}%
\end{equation}
and

\item
\begin{equation}
\digamma_{w^{d}}^{-1}:\operatorname*{Range}\left\{  \digamma_{w}\right\}
\rightarrow\mathcal{W},
\end{equation}

\end{enumerate}

\item leading to
\begin{equation}
\widehat{\digamma_{vw}}:\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)
\rightarrow\mathcal{L}\left(  \mathcal{W}^{d},\mathcal{V}^{d}\right)
\end{equation}
by

\begin{enumerate}
\item
\begin{equation}
A^{d}=\widehat{\digamma_{vw}}\left(  A\right)  =\digamma_{w}\circ
A\circ\digamma_{v^{d}}^{-1}%
\end{equation}
and its inverse

\item
\begin{equation}
\widehat{\digamma_{vw}^{-1}}:\mathcal{L}\left(  \mathcal{W}^{d},\mathcal{V}%
^{d}\right)  \rightarrow\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)
\end{equation}
by

\item
\begin{equation}
A=\widehat{\digamma_{vw}^{-1}}\left(  A^{d}\right)  =\digamma_{w}^{-1}\circ
A^{d}\circ\digamma_{v^{d}}.
\end{equation}

\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
In the case $\digamma_{v}=\digamma_{\left\vert v\right\rangle }$ and
$\digamma_{w}=\digamma_{\left\vert w\right\rangle }$ one has for
$A\in\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)  $
\begin{equation}
A^{\dagger}=\widehat{\digamma_{\left\vert vw\right\rangle }}\left(  A\right)
,
\end{equation}
where $A^{\dagger}\in\mathcal{L}\left(  \mathcal{W}^{d},\mathcal{V}%
^{d}\right)  .$
\end{remark}

\begin{remark}
In finite dimensions $\mathcal{W}\cong\mathcal{W}^{d}$ and $\mathcal{V}%
\cong\mathcal{V}^{d}$ and if they are Hilbert spaces one can use $\digamma
_{e}=\digamma_{\left\vert e\right\rangle }$ and consider $\mathcal{W}%
=\mathcal{W}^{d}$ and $\mathcal{V}=\mathcal{V}^{d}.$
\end{remark}

One can always decompose $\mathcal{V}$ as the direct sum
\begin{equation}
\mathcal{V}=\operatorname{Ker}\left\{  M\right\}  \oplus\operatorname{Ker}%
\left\{  M\right\}  ^{c}%
\end{equation}
and $\mathcal{W}$ as the direct sum
\begin{equation}
\mathcal{W}=\operatorname*{Range}\left\{  M\right\}  \oplus
\operatorname*{Range}\left\{  M\right\}  ^{c}%
\end{equation}
then
\begin{equation}
M:\operatorname{Ker}\left\{  M\right\}  ^{c}\rightarrow\operatorname*{Range}%
\left\{  M\right\}  \subseteq\mathcal{W}%
\end{equation}
is an injection. If

\begin{enumerate}
\item $\dim\left\{  \mathcal{V}\right\}  <\dim\left\{  \mathcal{W}\right\}  $
then
\begin{equation}
\operatorname*{Range}\left\{  M\right\}  \subset\mathcal{W}%
\end{equation}
and
\begin{equation}
\operatorname{Ker}\left\{  M\right\}  \supseteq\phi.
\end{equation}


\item $\dim\left\{  \mathcal{V}\right\}  >\dim\left\{  \mathcal{W}\right\}  $
then%
\begin{equation}
\operatorname{Ker}\left\{  M\right\}  \supsetneqq\phi
\end{equation}
and
\begin{equation}
M:\operatorname{Ker}\left\{  M\right\}  ^{c}\rightarrow\mathcal{W}%
\end{equation}
is an injection but may or may not be a surjection i.e.
\begin{equation}
\operatorname*{Range}\left\{  M\right\}  \subseteq\mathcal{W}.
\end{equation}


\item $\dim\left\{  \mathcal{V}\right\}  =\dim\left\{  \mathcal{W}\right\}  $
then
\begin{equation}
M:\operatorname{Ker}\left\{  M\right\}  ^{c}\rightarrow\mathcal{W}%
\end{equation}
is an injection and
\begin{equation}
\operatorname*{Range}\left\{  M\right\}  \subseteq\mathcal{W}.
\end{equation}

\end{enumerate}

\begin{definition}
A \emph{non-negative} real number $\U{3c3} _{k}$ is a singular value for
$M\in\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)  $ \emph{if and only
if} there exist unit-length vectors $\left\{  \left.  u_{k}\right\vert 1\leq
k\leq\min(m,n)\right\}  $ in $\mathcal{W}$ and $\left\{  \left.  \zeta
_{k}\right\vert 1\leq k\leq\min(m,n)\right\}  $ in $\mathcal{V}$ defined by
\begin{equation}
M\zeta_{k}=\U{3c3} _{k}u_{k},\quad1\leq k\leq\min(m,n)
\end{equation}
and
\begin{equation}
M^{\dagger}u_{k}=\U{3c3} _{k}\zeta_{k},\quad1\leq k\leq\min(m,n).
\end{equation}

\end{definition}

\begin{definition}
The vectors $u_{k}$ and $\zeta_{k}$ are called \emph{left-singular} and
\emph{right-singular} vectors for $\U{3c3} _{k}$, respectively. The first
$p=\min(m,n)$ \emph{column operators} of $U$ and $V$ correspond to \emph{left-
and right-singular vectors for the corresponding singular values }respectively.
\end{definition}

Hence
\begin{equation}
\mathfrak{C}_{e}\left(  U\right)  _{k}=\sum_{1\leq j\leq m}\left[  w_{j}%
w_{k}^{d}\right]  \mathcal{R}_{e}\left(  U\right)  _{jk},\quad1\leq k\leq
p=\min(m,n)
\end{equation}
and%
\begin{equation}
\mathfrak{C}_{e}\left(  V^{\dagger}\right)  _{k}=\sum_{1\leq j\leq n}\left[
v_{j}v_{k}^{d}\right]  \mathcal{R}_{e}\left(  V^{\dagger}\right)  _{jk}%
,\quad1\leq k\leq p=\min(m,n).
\end{equation}


\begin{remark}
\begin{enumerate}
\item
\begin{equation}
\mathfrak{C}_{e}\left(  U\right)  _{k}\in\mathcal{L}\left(  \mathcal{W}%
,\mathcal{W}\right)  ,\quad1\leq k\leq p=\min(m,n)
\end{equation}
and

\item
\begin{equation}
\mathfrak{C}_{e}\left(  V\right)  _{k}\in\mathcal{L}\left(  \mathcal{V}%
,\mathcal{V}\right)  ,\quad1\leq k\leq p=\min(m,n)
\end{equation}

\end{enumerate}
\end{remark}

\begin{lemma}
If $u_{k}$ and $v_{k}$ are called \emph{left-singular} and
\emph{right-singular} vectors for $\U{3c3} _{k}$ for $M$ has a SVD given by
\end{lemma}

%

\begin{equation}
M=U\U{3a3} V^{\dagger},
\end{equation}
where
\begin{equation}
\U{3a3} =\sum_{1\leq j\leq\min(m,n)}\U{3c3} _{k}\left[  v_{j}w_{j}^{d}\right]
.
\end{equation}


\begin{remark}%
\begin{equation}
V^{\dagger}\in\mathcal{L}\left(  \mathcal{V},\mathcal{V}\right)
\end{equation}%
\begin{equation}
\U{3a3} \in\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)
\end{equation}%
\begin{equation}
U\in\mathcal{L}\left(  \mathcal{W},\mathcal{W}\right)
\end{equation}

\end{remark}

\begin{remark}
In any singular value decomposition%
\begin{equation}
M=U\U{3a3} V^{\dagger}%
\end{equation}
one has the expansions
\begin{align*}
M  &  =\sum_{\substack{1\leq j,\leq n\\1\leq k\leq m}}\left[  v_{j}w_{k}%
^{d}\right]  \mathcal{R}_{vw}\left(  M\right)  _{jk}\\
&  =\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq k_{3}\leq m}}\left[
w_{j_{1}}w_{j_{2}}^{d}\right]  \left[  w_{j_{3}}v_{j_{3}}^{d}\right]  \left[
v_{k_{2}}v_{k_{3}}^{d}\right]  \mathcal{R}_{w}\left(  U\right)  _{j_{1}j_{2}%
}\mathcal{R}_{wv}\left(  \U{3a3} \right)  _{j_{2}j_{2}}\mathcal{R}_{v}\left(
V^{\dagger}\right)  _{j_{2}k_{3}}\\
&  =\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq j_{2}\leq\min\left(
n,m\right)  \\1\leq k_{3}\leq m}}\left[  w_{j_{1}}v_{k_{3}}^{d}\right]
\mathcal{R}_{w}\left(  U\right)  _{j_{1}j_{2}}\U{3c3} _{j_{2}}\mathcal{R}%
_{v}\left(  V^{\dagger}\right)  _{j_{2}k_{3}}%
\end{align*}

\end{remark}

\begin{theorem}
If
\begin{equation}
Mv_{k}=\U{3c3} _{k}u_{k}^{d},\quad1\leq k\leq\min(m,n)
\end{equation}
and
\begin{equation}
M^{d}u_{k}^{d}=\U{3c3} _{k}v_{k},\quad1\leq k\leq\min(m,n).
\end{equation}
then
\begin{equation}
M=U\U{3a3} V^{d}=\sum_{1\leq k\leq\min(m,n)}\left[  u_{k}v_{k}\right]  \U{3c3}
_{k}%
\end{equation}
and
\begin{align}
M  &  =U\U{3a3} V^{d}\\
&  \parallel
\end{align}%
\begin{gather*}
\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq k_{3}\leq m}}\left[  u_{j_{1}%
}w_{j_{2}}^{d}\right]  \left[  u_{j_{3}}v_{j_{3}}\right]  \left[  v_{k_{2}%
}^{d}v_{k_{3}}\right]  \mathcal{R}_{u}\left(  U\right)  _{j_{1}j_{2}%
}\mathcal{R}_{uv^{d}}\left(  \U{3a3} \right)  _{j_{2}j_{2}}\mathcal{R}_{v^{d}%
}\left(  V^{d}\right)  _{j_{2}k_{3}}\\
\parallel\\
\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq j_{2}\leq\min\left(
n,m\right)  \\1\leq k_{3}\leq m}}\left[  u_{j_{1}}v_{k_{3}}\right]
\mathcal{R}_{u}\left(  U\right)  _{j_{1}j_{2}}\U{3c3} _{j_{2}}\mathcal{R}%
_{v^{d}}\left(  V^{d}\right)  _{j_{2}k_{3}}.
\end{gather*}

\end{theorem}

\begin{remark}
\begin{enumerate}
\item In any singular value decomposition%
\begin{equation}
M=U\U{3a3} Z^{\dagger}%
\end{equation}
the "diagonal entries" of $\U{3a3} $ are equal to the singular values of $M$.

\item
\begin{equation}
MM^{\dagger}=U\U{3a3} Z^{\dagger}Z\U{3a3} ^{\dagger}U^{\dagger}=U\U{3a3}
\U{3a3} ^{\dagger}U^{\dagger}%
\end{equation}


\item
\begin{equation}
M^{\dagger}M=Z\U{3a3} ^{\dagger}U^{\dagger}U\U{3a3} Z^{\dagger}=Z\U{3a3}
^{\dagger}\U{3a3} Z^{\dagger}%
\end{equation}


\item $Z$ is unitary
\begin{equation}
Z,Z^{\dagger}:\mathcal{V}\rightarrow\mathcal{V},\quad Z\in\mathcal{L}\left(
\mathcal{V}\right)  \cong\mathcal{L}\left(  \mathbb{C}^{m}\right)
\end{equation}
i.e.
\begin{equation}
Z^{\dagger}Z=I_{m}.
\end{equation}


\item
\begin{equation}
\U{3a3} :\mathcal{V}\rightarrow\mathcal{W},\quad\in\mathcal{L}\left(
\mathcal{V},\mathcal{W}\right)  \cong\mathcal{L}\left(  \mathbb{C}%
^{m},\mathbb{C}^{n}\right)
\end{equation}


\item $U$ is unitary%
\begin{equation}
U,U^{\dagger}:\mathcal{W\rightarrow W},\quad U\in\mathcal{L}\left(
\mathcal{W}\right)  \cong\mathcal{L}\left(  \mathbb{C}^{n}\right)
\end{equation}
i.e.
\begin{equation}
U^{\dagger}U=I_{n}.
\end{equation}


\item
\begin{equation}
\U{3a3} =\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}\left[
w_{j}v_{j}^{d}\right]  =\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma
_{j}E_{w_{j}v_{j}^{d}},\quad E_{w_{j}v_{j}^{d}}=\left[  w_{j}v_{j}^{d}\right]
\in\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)  \cong\mathcal{L}\left(
\mathbb{C}^{m},\mathbb{C}^{n}\right)  ,\quad\sigma_{j}\geq0
\end{equation}
where
\begin{equation}
E_{w_{j}v_{j}^{d}}:\mathcal{V}\rightarrow\mathcal{W},\quad\in\mathcal{L}%
\left(  \mathcal{V},\mathcal{W}\right)  \cong\mathcal{L}\left(  \mathbb{C}%
^{m},\mathbb{C}^{n}\right)  .
\end{equation}
Note that it is possible $\sigma_{j}=0$ for some $j\in\mathbb{N}^{\min\left(
m,n\right)  }.$

\item
\begin{equation}
M=U\left(  \sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}\left[
w_{j}z_{j}^{d}\right]  \right)  Z^{\dagger}%
\end{equation}


\item
\begin{equation}
\operatorname*{Range}\left(  M\right)  =\mathbb{C}\text{-}%
\operatorname*{linspan}\left\{  \left.  w_{j}\right\vert 1\leq j\leq
n\right\}
\end{equation}


\item
\begin{equation}
\U{3a3} z_{j}=\sigma_{j}u_{j},\quad1\leq j\leq\min\left(  m,n\right)
\end{equation}


\item
\begin{equation}
\U{3a3} ^{d}u_{j}^{d}=\sigma_{j}z_{j}^{d}%
\end{equation}


\item
\begin{align}
T  &  :\mathcal{V}\rightarrow\mathcal{W}\\
T  &  =\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}}\left[  w_{j}v_{k}%
^{d}\right]  T_{jk}\\
T\left(  \mathbf{v}\right)   &  =\mathcal{R}_{v}\left(  T\right) \\
\mathcal{R}_{v}\left(  T\right)   &  \in\mathcal{M}\left(  m,n,\mathbb{C}%
\right)
\end{align}


\item
\begin{align}
v  &  =\left(  \mathbf{v}\right)  \mathcal{R}_{v}\left(  v\right)
=\sum_{1\leq j\leq m}v_{j}\mathcal{R}_{v}\left(  v\right)  _{j}\\
T\left(  \mathbf{v}\right)   &  =\left(  \mathbf{v}\right)  \mathcal{R}%
_{wv}\left(  T\right)  =\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}%
}w_{k}\mathcal{R}_{wv}\left(  T\right)  _{kj}\\
Tv  &  =T\left(  \mathbf{v}\right)  \mathcal{R}_{v}\left(  v\right)  =\left(
\mathbf{v}\right)  \mathcal{R}_{wv}\left(  T\right)  \mathcal{R}_{v}\left(
v\right)  =\sum_{\substack{1\leq j\leq n\\1\leq k\leq m}}w_{k}\mathcal{R}%
_{wv}\left(  T\right)  _{kj}\mathcal{R}_{v}\left(  v\right)  _{j}%
\end{align}


\item
\begin{equation}
\left(  \sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}u_{j}z_{j}%
^{d}\right)  \left(  \mathbf{v}\right)  =\left(  \sum_{1\leq j\leq\min\left(
m,n\right)  }\sigma_{j}u_{j}z_{j}^{d}\right)  \left(  z_{1},\cdots
,z_{r}\right)  =\left(  \sigma_{1}u_{1},\cdots,\sigma_{r}u_{r}\right)
=\left(  z_{1},\cdots,z_{r}\right)  \mathcal{R}_{z}\left(  \U{3a3} \right)
\end{equation}


\item
\begin{equation}
\left(  \mathbf{w}\right)  =\U{3a3} \left(  \mathbf{v}\right)  =\left(
\mathbf{v}\right)  \mathcal{R}_{z}\left(  \U{3a3} \right)  =\left(
\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}u_{j}z_{j}^{d}\right)
\left(  \mathbf{z}\right)  =\left(  \mathbf{z}\right)  \mathcal{R}_{z}\left(
\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}u_{j}z_{j}^{d}\right)
\end{equation}


\item
\begin{equation}
\mathcal{R}_{z}\left(  \U{3a3} \right)  =\mathcal{R}_{v}\left(  \sum_{1\leq
j\leq\min\left(  m,n\right)  }\sigma_{j}u_{j}z_{j}^{d}\right)  =\mathcal{M}%
_{uz}\left(  \U{3a3} \right)
\end{equation}

\end{enumerate}
\end{remark}

\begin{enumerate}
\item
\begin{definition}%
\begin{equation}
\left(  E_{w_{j}v_{j}^{d}}\right)  ^{\dagger}=E_{v_{j}w_{j}^{d}}=v_{j}%
w_{j}^{d},
\end{equation}
where
\begin{equation}
E_{v_{j}w_{j}^{d}}:\mathcal{W}\rightarrow\mathcal{V},\quad\in\mathcal{L}%
\left(  \mathcal{W},\mathcal{V}\right)  \cong\mathcal{L}\left(  \mathbb{C}%
^{n},\mathbb{C}^{m}\right)  .
\end{equation}

\end{definition}

\item
\begin{align}
\U{3a3}  &  =\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}u_{j}%
z_{j}^{d}=\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}E_{u_{j}%
z_{j}^{d}},\quad E_{u_{j}z_{j}^{d}}=\left[  u_{j}z_{j}^{d}\right]
\in\mathcal{L}\left(  \mathcal{V},\mathcal{W}\right)  \cong\mathcal{L}\left(
\mathbb{C}^{m},\mathbb{C}^{n}\right) \\
\U{3a3} ^{\dagger}  &  =\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma
_{j}z_{j}u_{j}^{d}=\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma
_{j}E_{z_{j}u_{j}^{d}},\quad E_{z_{j}u_{j}^{d}}=\left[  z_{j}u_{j}^{d}\right]
\in\mathcal{L}\left(  \mathcal{W},\mathcal{V}\right)  \cong\mathcal{L}\left(
\mathbb{C}^{n},\mathbb{C}^{m}\right)  .
\end{align}


\begin{enumerate}
\item
\begin{equation}
\U{3a3} z_{j}=\sigma_{j}u_{j}%
\end{equation}


\item
\begin{equation}
\U{3a3} ^{\dagger}u_{j}=\sigma_{j}z_{j}%
\end{equation}


\item
\begin{equation}
u_{j}^{d}\U{3a3} =\sigma_{j}z_{j}^{d}%
\end{equation}


\item
\begin{equation}
z_{j}^{d}\U{3a3} ^{\dagger}=\sigma_{j}u_{j}^{d}.
\end{equation}

\end{enumerate}
\end{enumerate}

\begin{remark}
\begin{enumerate}
\item Products of $\left[  w_{l}v_{m}^{d}\right]  $ and their adjoints

\begin{enumerate}
\item
\begin{equation}
\left[  w_{j}v_{k}^{d}\right]  ^{\dagger}\left[  w_{l}v_{m}^{d}\right]
=\left[  v_{k}w_{j}^{d}\right]  \left[  w_{l}v_{m}^{d}\right]  =\left[
v_{k}v_{m}^{d}\right]  \delta_{jl}%
\end{equation}
and

\item
\begin{equation}
\left[  w_{l}v_{m}^{d}\right]  \left[  w_{j}v_{k}^{d}\right]  ^{\dagger
}=\left[  w_{l}v_{m}^{d}\right]  \left[  v_{k}w_{j}^{d}\right]  =\left[
w_{l}w_{j}^{d}\right]  \delta_{km}.
\end{equation}

\end{enumerate}

\item $\left[  w_{j}v_{j}^{d}\right]  $ are not normal operators as in general as

\begin{enumerate}
\item
\begin{equation}
\left[  w_{j}v_{j}^{d}\right]  ^{\dagger}\left[  w_{k}v_{k}^{d}\right]
=\left[  v_{j}w_{j}^{d}\right]  \left[  w_{k}v_{k}^{d}\right]  =\left[
v_{j}v_{k}^{d}\right]  w_{j}^{d}\left(  w_{k}\right)  =\left[  v_{j}v_{j}%
^{d}\right]  \delta_{jk}.
\end{equation}


\item
\begin{equation}
\left[  w_{j}v_{j}^{d}\right]  \left[  w_{k}v_{k}^{d}\right]  ^{\dagger
}=\left[  w_{j}v_{j}^{d}\right]  \left[  v_{k}w_{k}^{d}\right]  =\left[
w_{j}w_{k}^{d}\right]  v_{j}^{d}\left(  v_{k}\right)  =\left[  w_{j}w_{j}%
^{d}\right]  \delta_{jk}.
\end{equation}

\end{enumerate}

\item $\left[  w_{j}v_{j}^{d}\right]  $ are partial isometries as $\left[
v_{j}v_{j}^{d}\right]  $ and $\left[  w_{j}w_{j}^{d}\right]  $ are projectors
i.e.
\begin{equation}
\left[  v_{j}v_{j}^{d}\right]  ^{2}=\left[  v_{j}v_{j}^{d}\right]
\end{equation}
and
\begin{equation}
\left[  w_{j}w_{j}^{d}\right]  ^{2}=\left[  w_{j}w_{j}^{d}\right]  .
\end{equation}


\begin{enumerate}
\item
\begin{equation}
\U{3a3} =\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}\left[
u_{j}z_{j}^{d}\right]  ,\quad\sigma_{j}>0.
\end{equation}


\item
\begin{equation}
\U{3a3} ^{\dagger}=\sum_{1\leq j,k\leq\min\left(  m,n\right)  }\sigma
_{j}\left[  z_{j}u_{j}^{d}\right]  ,\quad\sigma_{j}>0.
\end{equation}


\item
\begin{align}
\U{3a3} ^{\dagger}\U{3a3}  &  =\sum_{1\leq j,k\leq\min\left(  m,n\right)
}\sigma_{j}\sigma_{k}\left[  u_{j}z_{j}^{d}\right]  ^{\dagger}\left[
u_{j}z_{j}^{d}\right]  =\sum_{1\leq j,k\leq\min\left(  m,n\right)  }\sigma
_{j}\sigma_{k}\left[  z_{j}u_{j}^{d}\right]  \left[  u_{k}z_{k}^{d}\right] \\
&  =\sum_{1\leq j,k\leq\min\left(  m,n\right)  }\sigma_{j}\sigma_{k}\left[
z_{j}z_{j}^{d}\right]  u_{j}^{d}\left(  u_{k}\right)  =\sum_{1\leq j,k\leq
\min\left(  m,n\right)  }\sigma_{j}\sigma_{k}\left[  z_{j}z_{j}^{d}\right]
\delta_{jk}=\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}^{2}\left[
z_{j}z_{j}^{d}\right]  .
\end{align}


\item
\begin{align}
\U{3a3} \U{3a3} ^{\dagger}  &  =\sum_{1\leq j,k\leq\min\left(  m,n\right)
}\sigma_{j}\sigma_{k}\left[  u_{j}z_{j}^{d}\right]  \left[  u_{k}z_{k}%
^{d}\right]  ^{\dagger}=\sum_{1\leq j,k\leq\min\left(  m,n\right)  }\sigma
_{j}\sigma_{k}\left[  u_{j}z_{j}^{d}\right]  \left[  z_{k}u_{k}^{d}\right] \\
&  =\sum_{1\leq j,k\leq\min\left(  m,n\right)  }\sigma_{j}^{2}\left[
u_{j}u_{k}^{d}\right]  z_{j}^{d}\left(  z_{k}\right)  =\sum_{1\leq j,k\leq
\min\left(  m,n\right)  }\sigma_{j}\sigma_{k}\left[  u_{j}u_{k}^{d}\right]
\delta_{jk}=\sum_{1\leq j\leq\min\left(  m,n\right)  }\sigma_{j}^{2}\left[
u_{j}u_{j}^{d}\right]  .
\end{align}

\end{enumerate}

\item
\begin{align}
M  &  =\sum_{\substack{1\leq j,\leq n\\1\leq k\leq m}}\left[  z_{j}u_{k}%
^{d}\right]  \mathcal{R}_{zu}\left(  M\right)  _{jk}=\sum_{1\leq j_{1}%
,j_{2}\leq n}\left[  u_{j_{1}}u_{j_{2}}^{d}\right]  \mathcal{R}_{u}\left(
U\right)  _{j_{1}j_{2}}\sum_{\substack{1\leq j_{3}\leq n\\1\leq k_{1}\leq
m}}\left[  u_{j_{3}}z_{k_{1}}^{d}\right]  \mathcal{R}_{uz}\left(  \U{3a3}
\right)  _{j_{3}k_{1}}\sum_{1\leq k_{2},k_{3}\leq m}\left[  z_{k_{2}}z_{k_{3}%
}^{d}\right]  \mathcal{R}_{z}\left(  Z^{\dagger}\right)  _{k_{2}k_{3}}\\
&  =\sum_{\substack{1\leq j_{1},j_{2},j_{3}\leq n\\1\leq k_{1},k_{2},k_{3}\leq
m}}\left[  u_{j_{1}}u_{j_{2}}^{d}\right]  \left[  u_{j_{3}}z_{k_{1}}%
^{d}\right]  \left[  z_{k_{2}}z_{k_{3}}^{d}\right]  \mathcal{R}_{u}\left(
U\right)  _{j_{1}j_{2}}\mathcal{R}_{uz}\left(  \U{3a3} \right)  _{j_{3}k_{1}%
}\mathcal{R}_{z}\left(  Z^{\dagger}\right)  _{k_{2}k_{3}}\\
&  =\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq k_{1},k_{3}\leq m}}\left[
u_{j_{1}}z_{k_{3}}^{d}\right]  \mathcal{R}_{u}\left(  U\right)  _{j_{1}j_{2}%
}\mathcal{R}_{uz}\left(  \U{3a3} \right)  _{j_{2}k_{1}}\mathcal{R}_{z}\left(
Z^{\dagger}\right)  _{k_{1}k_{3}}\\
&  =\sum_{\substack{1\leq j_{1},j_{2}\leq n\\1\leq j_{2}\leq\min\left(
