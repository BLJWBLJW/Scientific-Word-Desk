\section{Mixed Particle Operator Idempotency}

The following relationship will be important 
\begin{align*}
& \Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) =\hat{\lambda}_{1}\wedge P_{%
\mathcal{H}^{1}}=\sum_{\substack{ 1\leq j_{1}\leq 4  \\ 1\leq j_{2}\leq 4}}%
\lambda _{1j_{1}j_{1}}\left\vert \varphi _{j_{1}}\right\rangle \left\langle
\varphi _{j_{1}}\right\vert \wedge \left\vert \varphi _{j_{2}}\right\rangle
\left\langle \varphi _{j_{2}}\right\vert \\
& =\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq 4}\left( \lambda
_{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) \left\vert \varphi
_{j_{1}}\varphi _{j_{2}}\right\rangle \left\langle \varphi _{j_{1}}\varphi
_{j_{2}}\right\vert
\end{align*}

The idempotency condition for a mixed one and two particle operator leads to
the evaluation of 
\begin{eqnarray*}
&&\Gamma \left( \hat{\lambda}_{1}+\hat{\lambda}_{2}\right) ^{2}-\Gamma
\left( \hat{\lambda}_{1}+\hat{\lambda}_{2}\right) =\left( \sum_{1\leq N\leq
r}\Gamma _{N}\left( \hat{\lambda}_{1}+\hat{\lambda}_{2}\right) \right)
^{2}-\Gamma \left( \hat{\lambda}_{1}+\hat{\lambda}_{2}\right) \\
&=&\left( \sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \hat{\lambda}%
_{1}\right) +\sum_{2\leq N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \hat{%
\lambda}_{2}\right) \right) ^{2}-\left( \sum_{1\leq N\leq r}N\Gamma
_{1}^{N}\left( \hat{\lambda}_{1}\right) +\sum_{2\leq N\leq r}\binom{N}{2}%
\Gamma _{2}^{N}\left( \hat{\lambda}_{2}\right) \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \hat{\lambda}_{1}\right)
\left( N\Gamma _{1}^{N}\left( \hat{\lambda}_{1}\right) -P_{\mathcal{H}%
^{N}}\right) +\sum_{2\leq N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \hat{%
\lambda}_{2}\right) \left( \binom{N}{2}\Gamma _{2}^{N}\left( \hat{\lambda}%
_{2}\right) -P_{\mathcal{H}^{N}}\right) \\
&&+\sum_{1\leq N\leq r}N\binom{N}{2}\left\{ \Gamma _{1}^{N}\left( \hat{%
\lambda}_{1}\right) \Gamma _{2}^{N}\left( \hat{\lambda}_{2}\right) +\Gamma
_{2}^{N}\left( \hat{\lambda}_{2}\right) \Gamma _{1}^{N}\left( \hat{\lambda}%
_{1}\right) \right\}
\end{eqnarray*}%
\begin{gather*}
\quad \parallel \\
\Gamma _{2}^{2}\left( \hat{\lambda}_{2}\right) ^{2}+9\Gamma _{2}^{3}\left( 
\hat{\lambda}_{2}\right) ^{2}+36\Gamma _{2}^{4}\left( \hat{\lambda}%
_{2}\right) ^{2}+\cdots +\binom{r}{2}^{2}\Gamma _{2}^{r}\left( \hat{\lambda}%
_{2}\right) ^{2} \\
-\left( \Gamma _{2}^{2}\left( \hat{\lambda}_{2}\right) +3\Gamma
_{2}^{3}\left( \hat{\lambda}_{2}\right) +6\Gamma _{2}^{4}\left( \hat{\lambda}%
_{2}\right) +\cdots +\binom{r}{2}\Gamma _{2}^{r}\left( \hat{\lambda}%
_{2}\right) \right) + \\
\\
2\left\{ \Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) \hat{\lambda}_{2}+%
\hat{\lambda}_{2}\Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) \right\}
+9\left\{ \Gamma _{1}^{3}\left( \hat{\lambda}_{1}\right) \Gamma
_{2}^{3}\left( \hat{\lambda}_{2}\right) +\Gamma _{2}^{3}\left( \hat{\lambda}%
_{2}\right) \Gamma _{1}^{3}\left( \hat{\lambda}_{1}\right) \right\} \\
+\cdots +r\binom{r}{2}\left\{ \Gamma _{1}^{r}\left( \hat{\lambda}_{1}\right)
\Gamma _{2}^{r}\left( \hat{\lambda}_{2}\right) +\Gamma _{2}^{r}\left( \hat{%
\lambda}_{2}\right) \Gamma _{1}^{r}\left( \hat{\lambda}_{1}\right) \right\} +
\\
\parallel \\
\Gamma _{1}^{1}\left( \hat{\lambda}_{1}\right) ^{2}+4\Gamma _{1}^{2}\left( 
\hat{\lambda}_{1}\right) ^{2}+9\Gamma _{1}^{3}\left( \hat{\lambda}%
_{1}\right) ^{2}+\cdots +\binom{r}{1}^{2}\Gamma _{1}^{r}\left( \hat{\lambda}%
_{1}\right) ^{2} \\
-\left( \Gamma _{1}^{1}\left( \hat{\lambda}_{1}\right) +2\Gamma
_{1}^{2}\left( \hat{\lambda}_{1}\right) +3\Gamma _{1}^{3}\left( \hat{\lambda}%
_{1}\right) +\cdots +\binom{r}{1}\Gamma _{1}^{r}\left( \hat{\lambda}%
_{1}\right) \right)
\end{gather*}%
\begin{gather*}
\parallel \\
\Gamma _{1}^{1}\left( \hat{\lambda}_{1}\right) ^{2}-\Gamma _{1}^{1}\left( 
\hat{\lambda}_{1}\right) \\
+4\Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) ^{2}-2\Gamma _{1}^{2}\left( 
\hat{\lambda}_{1}\right) +\Gamma _{2}^{2}\left( \hat{\lambda}_{2}\right)
^{2}-\Gamma _{2}^{2}\left( \hat{\lambda}_{2}\right) +2\left\{ \Gamma
_{1}^{2}\left( \hat{\lambda}_{1}\right) \hat{\lambda}_{2}+\hat{\lambda}%
_{2}\Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) \right\} \\
+9\Gamma _{1}^{3}\left( \hat{\lambda}_{1}\right) ^{2}-3\Gamma _{1}^{3}\left( 
\hat{\lambda}_{1}\right) +9\Gamma _{2}^{3}\left( \hat{\lambda}_{2}\right)
^{2}-3\Gamma _{2}^{3}\left( \hat{\lambda}_{2}\right) +9\left\{ \Gamma
_{1}^{3}\left( \hat{\lambda}_{1}\right) \Gamma _{2}^{3}\left( \hat{\lambda}%
_{2}\right) +\Gamma _{2}^{3}\left( \hat{\lambda}_{2}\right) \Gamma
_{1}^{3}\left( \hat{\lambda}_{1}\right) \right\} \\
+16\Gamma _{1}^{4}\left( \hat{\lambda}_{1}\right) ^{2}-4\Gamma
_{1}^{4}\left( \hat{\lambda}_{1}\right) +36\Gamma _{2}^{4}\left( \hat{\lambda%
}_{2}\right) ^{2}-6\Gamma _{2}^{4}\left( \hat{\lambda}_{2}\right) +24\left\{
\Gamma _{1}^{4}\left( \hat{\lambda}_{1}\right) \Gamma _{2}^{4}\left( \hat{%
\lambda}_{2}\right) +\Gamma _{2}^{4}\left( \hat{\lambda}_{2}\right) \Gamma
_{1}^{4}\left( \hat{\lambda}_{1}\right) \right\} + \\
+ \\
\vdots \\
+ \\
\binom{r}{1}^{2}\Gamma _{1}^{r}\left( \hat{\lambda}_{1}\right) ^{2}-\binom{r%
}{1}\Gamma _{1}^{r}\left( \hat{\lambda}_{1}\right) +\binom{r}{2}^{2}\Gamma
_{2}^{r}\left( \hat{\lambda}_{2}\right) ^{2}-\binom{r}{2}\Gamma
_{2}^{r}\left( \hat{\lambda}_{2}\right) +r\binom{r}{2}\left\{ \Gamma
_{1}^{r}\left( \hat{\lambda}_{1}\right) \Gamma _{2}^{r}\left( \hat{\lambda}%
_{2}\right) +\Gamma _{2}^{r}\left( \hat{\lambda}_{2}\right) \Gamma
_{1}^{r}\left( \hat{\lambda}_{1}\right) \right\}
\end{gather*}

\subsubsection{Examples}

\paragraph{Example 1}

\begin{eqnarray*}
&&a_{1}^{\dagger }a_{1}+a_{2}^{\dagger }a_{2}-a_{1}^{\dagger }a_{2}^{\dagger
}a_{2}a_{1}=\Gamma \left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert +\left\vert \varphi _{2}\right\rangle \left\langle
\varphi _{2}\right\vert -\left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{0\leq N\leq r}\Gamma _{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert -\left\vert \varphi
_{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}\Gamma _{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\sum_{2\leq
N\leq r}\Gamma _{N}\left( \left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
is a projector. \ The FQ parts are given by 
\begin{eqnarray*}
&&\Gamma _{1}^{N}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert +\left\vert \varphi _{2}\right\rangle \left\langle
\varphi _{2}\right\vert \right) \\
&=&\frac{1}{\left( N-1\right) !}\sum_{1\leq j_{2},\cdots ,j_{N}\leq r}\left(
\left\vert \varphi _{1}\right\rangle \left\langle \varphi _{1}\right\vert
+\left\vert \varphi _{2}\right\rangle \left\langle \varphi _{2}\right\vert
\right) \wedge \left\vert \varphi _{j_{2}}\cdots \varphi
_{j_{N}}\right\rangle \left\langle \varphi _{j_{2}}\cdots \varphi
_{j_{N}}\right\vert \\
&=&\sum_{1\leq j_{2},\cdots ,j_{N}\leq r}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) \wedge
\left\vert \varphi _{j_{2}}\wedge \cdots \wedge \varphi
_{j_{N}}\right\rangle \left\langle \varphi _{j_{2}}\wedge \cdots \wedge
\varphi _{j_{N}}\right\vert \\
&=&\sum_{1\leq j_{2},\cdots ,j_{N}\leq r}\left\{ \left\vert \varphi
_{1}\wedge \varphi _{j_{2}}\wedge \cdots \wedge \varphi
_{j_{N}}\right\rangle \left\langle \varphi _{1}\wedge \varphi _{j_{2}}\wedge
\cdots \wedge \varphi _{j_{N}}\right\vert \right. \\
&&\left. +\left\vert \varphi _{2}\wedge \varphi _{j_{2}}\wedge \cdots \wedge
\varphi _{j_{N}}\right\rangle \left\langle \varphi _{2}\wedge \varphi
_{j_{2}}\wedge \cdots \wedge \varphi _{j_{N}}\right\vert \right\} \\
&=&\frac{\left( N-1\right) !}{N!}\sum_{1\leq j_{2}<\cdots <j_{N}\leq
r}\left\{ \left\vert \varphi _{1}\varphi _{j_{2}}\cdots \varphi
_{j_{N}}\right\rangle \left\langle \varphi _{1}\varphi _{j_{2}}\cdots
\varphi _{j_{N}}\right\vert +\left\vert \varphi _{2}\varphi _{j_{2}}\cdots
\varphi _{j_{N}}\right\rangle \left\langle \varphi _{2}\varphi
_{j_{2}}\cdots \varphi _{j_{N}}\right\vert \right\} \\
&=&\frac{1}{N}\sum_{1\leq j_{2}<\cdots <j_{N}\leq r}\left\{ \left\vert
\varphi _{1}\varphi _{j_{2}}\cdots \varphi _{j_{N}}\right\rangle
\left\langle \varphi _{1}\varphi _{j_{2}}\cdots \varphi _{j_{N}}\right\vert
+\left\vert \varphi _{2}\varphi _{j_{2}}\cdots \varphi _{j_{N}}\right\rangle
\left\langle \varphi _{2}\varphi _{j_{2}}\cdots \varphi _{j_{N}}\right\vert
\right\} .
\end{eqnarray*}

The relationship%
\begin{equation*}
\left( \Gamma _{N}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert +\left\vert \varphi _{2}\right\rangle \left\langle
\varphi _{2}\right\vert -\left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \right) ^{2}=\Gamma
_{N}\left( \left\vert \varphi _{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi _{2}\right\rangle \left\langle \varphi
_{2}\right\vert -\left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{equation*}%
gives 
\begin{eqnarray*}
&&\left( \sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\right) ^{2} \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
leading to 
\begin{eqnarray*}
&&\left( \sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) \right)
^{2}+\left( \sum_{2\leq N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) \right) ^{2} \\
&&-2\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) \sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
and 
\begin{eqnarray*}
&&\sum_{1\leq N\leq r}\left( N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) \right)
^{2}+\sum_{2\leq N\leq r}\left( \binom{N}{2}\Gamma _{2}^{N}\left( \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) \right) ^{2} \\
&&-2\sum_{2\leq N\leq r}N\binom{N}{2}\Gamma _{1}^{N}\left( \left\vert
\varphi _{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert
\varphi _{2}\right\rangle \left\langle \varphi _{2}\right\vert \right)
\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
Thus for $N=1$ 
\begin{equation*}
\left( \left\vert \varphi _{1}\right\rangle \left\langle \varphi
_{1}\right\vert +\left\vert \varphi _{2}\right\rangle \left\langle \varphi
_{2}\right\vert \right) ^{2}=\left\vert \varphi _{1}\right\rangle
\left\langle \varphi _{1}\right\vert +\left\vert \varphi _{2}\right\rangle
\left\langle \varphi _{2}\right\vert
\end{equation*}%
and for $N=2$%
\begin{equation*}
\Gamma _{1}^{2}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert +\left\vert \varphi _{2}\right\rangle \left\langle
\varphi _{2}\right\vert \right) =\left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert
\end{equation*}%
\begin{eqnarray*}
&\left( 2\Gamma _{1}^{2}\left( \left\vert \varphi _{1}\right\rangle
\left\langle \varphi _{1}\right\vert +\left\vert \varphi _{2}\right\rangle
\left\langle \varphi _{2}\right\vert \right) \right) ^{2}+\left( \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) ^{2}&-4\Gamma _{1}^{2}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \\
&&\left. =2\right. \Gamma _{1}^{2}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert +\left\vert \varphi
_{2}\right\rangle \left\langle \varphi _{2}\right\vert \right) -\left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert
\end{eqnarray*}%
which gives%
\begin{eqnarray*}
&&4\left( \left\vert \varphi _{1}\varphi _{2}\right\rangle \left\langle
\varphi _{1}\varphi _{2}\right\vert \right) ^{2}+\left( \left\vert \varphi
_{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) ^{2}-4\left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert
\left\vert \varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi
_{1}\varphi _{2}\right\vert \\
&&\left. =2\right. \left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert -\left\vert \varphi
_{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert
\end{eqnarray*}%
which balances.

\paragraph{Example 2}

Another projector is 
\begin{eqnarray*}
&&a_{1}^{\dagger }a_{1}-a_{1}^{\dagger }a_{2}^{\dagger }a_{2}a_{1}=\Gamma
\left( \left\vert \varphi _{1}\right\rangle \left\langle \varphi
_{1}\right\vert -\left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{0\leq N\leq r}\Gamma _{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert -\left\vert \varphi
_{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) =\sum_{1\leq N\leq r}\Gamma _{N}\left( \left\vert
\varphi _{1}\right\rangle \left\langle \varphi _{1}\right\vert \right)
-\sum_{2\leq N\leq r}\Gamma _{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
Its FQ parts are given by 
\begin{eqnarray*}
&&\Gamma _{1}^{N}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert \right) =\frac{1}{\left( N-1\right) !}\sum_{1\leq
j_{2},\cdots ,j_{N}\leq r}\left( \left\vert \varphi _{1}\right\rangle
\left\langle \varphi _{1}\right\vert \right) \wedge \left\vert \varphi
_{j_{2}}\cdots \varphi _{j_{N}}\right\rangle \left\langle \varphi
_{j_{2}}\cdots \varphi _{j_{N}}\right\vert \\
&=&\sum_{1\leq j_{2},\cdots ,j_{N}\leq r}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) \wedge
\left\vert \varphi _{j_{2}}\wedge \cdots \wedge \varphi
_{j_{N}}\right\rangle \left\langle \varphi _{j_{2}}\wedge \cdots \wedge
\varphi _{j_{N}}\right\vert \\
&=&\sum_{1\leq j_{2},\cdots ,j_{N}\leq r}\left\vert \varphi _{1}\wedge
\varphi _{j_{2}}\wedge \cdots \wedge \varphi _{j_{N}}\right\rangle
\left\langle \varphi _{1}\wedge \varphi _{j_{2}}\wedge \cdots \wedge \varphi
_{j_{N}}\right\vert \\
&=&\frac{\left( N-1\right) !}{N!}\sum_{1\leq j_{2}<\cdots <j_{N}\leq
r}\left\vert \varphi _{1}\varphi _{j_{2}}\cdots \varphi
_{j_{N}}\right\rangle \left\langle \varphi _{1}\varphi _{j_{2}}\cdots
\varphi _{j_{N}}\right\vert \\
&=&\frac{1}{N}\sum_{1\leq j_{2}<\cdots <j_{N}\leq r}\left\vert \varphi
_{1}\varphi _{j_{2}}\cdots \varphi _{j_{N}}\right\rangle \left\langle
\varphi _{1}\varphi _{j_{2}}\cdots \varphi _{j_{N}}\right\vert .
\end{eqnarray*}%
The idempotency condition is 
\begin{equation*}
\left( \Gamma _{N}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert -\left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \right) ^{2}=\Gamma
_{N}\left( \left\vert \varphi _{1}\right\rangle \left\langle \varphi
_{1}\right\vert -\left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) ,
\end{equation*}%
which gives 
\begin{eqnarray*}
&&\left( \sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\right) ^{2} \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
leading to 
\begin{eqnarray*}
&&\left( \sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) \right)
^{2}+\left( \sum_{2\leq N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) \right) ^{2} \\
&&-2\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) \sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
and 
\begin{eqnarray*}
&&\sum_{1\leq N\leq r}\left( N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) \right)
^{2}+\sum_{2\leq N\leq r}\left( \binom{N}{2}\Gamma _{2}^{N}\left( \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) \right) ^{2} \\
&&-2\sum_{2\leq N\leq r}N\binom{N}{2}\Gamma _{1}^{N}\left( \left\vert
\varphi _{1}\right\rangle \left\langle \varphi _{1}\right\vert \right)
\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \right) \\
&=&\sum_{1\leq N\leq r}N\Gamma _{1}^{N}\left( \left\vert \varphi
_{1}\right\rangle \left\langle \varphi _{1}\right\vert \right) -\sum_{2\leq
N\leq r}\binom{N}{2}\Gamma _{2}^{N}\left( \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \right)
\end{eqnarray*}%
Thus for $N=1$ 
\begin{equation*}
\left( \left\vert \varphi _{1}\right\rangle \left\langle \varphi
_{1}\right\vert \right) ^{2}=\left\vert \varphi _{1}\right\rangle
\left\langle \varphi _{1}\right\vert
\end{equation*}%
and for $N=2$%
\begin{equation*}
\Gamma _{1}^{2}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert \right) =\frac{1}{2}\left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert
\end{equation*}%
\begin{eqnarray*}
&&\left( 2\Gamma _{1}^{2}\left( \left\vert \varphi _{1}\right\rangle
\left\langle \varphi _{1}\right\vert \right) \right) ^{2}+\left( \left\vert
\varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi _{1}\varphi
_{2}\right\vert \right) ^{2} \\
&&-4\Gamma _{1}^{2}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert \right) \left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \\
&=&2\Gamma _{1}^{2}\left( \left\vert \varphi _{1}\right\rangle \left\langle
\varphi _{1}\right\vert \right) -\left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert
\end{eqnarray*}%
which gives%
\begin{eqnarray*}
&&\left\vert \varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi
_{1}\varphi _{2}\right\vert +\left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert \\
&&-2\left\vert \varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi
_{1}\varphi _{2}\right\vert \left\vert \varphi _{1}\varphi _{2}\right\rangle
\left\langle \varphi _{1}\varphi _{2}\right\vert \\
&=&\left\vert \varphi _{1}\varphi _{2}\right\rangle \left\langle \varphi
_{1}\varphi _{2}\right\vert -\left\vert \varphi _{1}\varphi
_{2}\right\rangle \left\langle \varphi _{1}\varphi _{2}\right\vert
\end{eqnarray*}%
which balances.

\subsection{The one particle condition}

is 
\begin{equation*}
\Gamma _{1}^{1}\left( \hat{\lambda}_{1}\right) ^{2}-\Gamma _{1}^{1}\left( 
\hat{\lambda}_{1}\right) =0.
\end{equation*}%
The one particle expansion gives 
\begin{equation*}
\hat{\lambda}_{1}^{2}-\hat{\lambda}_{1}=0,
\end{equation*}%
which shows that $\hat{\lambda}_{1}$ is a projector, i.e. 
\begin{equation*}
\hat{\lambda}_{1}=P_{\nu },
\end{equation*}%
where $\nu $ is the dimension of the projector, thus 
\begin{equation*}
\lambda _{1j_{1}j_{1}}=1\text{ or }0.
\end{equation*}

\subsection{The two particle condition}

is 
\begin{eqnarray*}
0 &=&\hat{\lambda}_{2}^{2}+2\left\{ \Gamma _{1}^{2}\left( \hat{\lambda}%
_{1}\right) \hat{\lambda}_{2}+\hat{\lambda}_{2}\Gamma _{1}^{2}\left( \hat{%
\lambda}_{1}\right) \right\} +4\Gamma _{1}^{2}\left( \hat{\lambda}%
_{1}\right) ^{2}-2\Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) -\hat{%
\lambda}_{2} \\
&=&\hat{\lambda}_{2}\left( \hat{\lambda}_{2}-P_{\mathcal{H}^{2}}\right)
+2\Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) \left( \hat{\lambda}_{2}-P_{%
\mathcal{H}^{2}}\right) +2\left( \hat{\lambda}_{2}-P_{\mathcal{H}%
^{2}}\right) \Gamma _{1}^{2}\left( \hat{\lambda}_{1}\right) +2\Gamma
_{1}^{2}\left( \hat{\lambda}_{1}\right) \left( 2\Gamma _{1}^{2}\left( \hat{%
\lambda}_{1}\right) +P_{\mathcal{H}^{2}}\right)
\end{eqnarray*}%
The expansion of the projector 
\begin{equation*}
\hat{\lambda}_{1}=P_{\mathcal{\nu }}
\end{equation*}%
gives in the 1$\rightarrow 2$ case 
\begin{align*}
& \Gamma _{1}^{2}\left( P_{\mathcal{\nu }}\right) =P_{\mathcal{\nu }}\wedge
P_{\mathcal{H}^{1}}=\sum_{\substack{ 1\leq j_{1}\leq \nu  \\ 1\leq j_{2}\leq
r}}\left\vert \varphi _{j_{1}}\right\rangle \left\langle \varphi
_{j_{1}}\right\vert \wedge \left\vert \varphi _{j_{2}}\right\rangle
\left\langle \varphi _{j_{2}}\right\vert \\
& =\frac{1}{2}\sum_{1\leq j_{1}<j_{2}\leq r}\left( \lambda
_{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) \left\vert \varphi
_{j_{1}}\varphi _{j_{2}}\right\rangle \left\langle \varphi _{j_{1}}\varphi
_{j_{2}}\right\vert .
\end{align*}%
$\lceil $Let $\nu =3$ then 
\begin{eqnarray*}
\Gamma _{1}^{2}\left( P_{3}\right) &=&\frac{1}{2}\left( 2\left\vert
12\right\rangle \left\langle 12\right\vert +2\left\vert 13\right\rangle
\left\langle 13\right\vert +\left\vert 14\right\rangle \left\langle
14\right\vert +2\left\vert 23\right\rangle \left\langle 23\right\vert
+\left\vert 24\right\rangle \left\langle 24\right\vert \right) \\
&=&\left\vert 12\right\rangle \left\langle 12\right\vert +\left\vert
13\right\rangle \left\langle 13\right\vert +\left\vert 23\right\rangle
\left\langle 23\right\vert +\frac{1}{2}\left( \left\vert 14\right\rangle
\left\langle 14\right\vert +\left\vert 24\right\rangle \left\langle
24\right\vert \right) ,
\end{eqnarray*}%
which shows that $\Gamma _{1}^{2}\left( P_{3}\right) $ is \emph{not} a
projector.$\rfloor $

Hence 
\begin{eqnarray*}
&&\hat{\lambda}_{2}\left( \hat{\lambda}_{2}-P_{\mathcal{H}^{2}}\right)
+2\Gamma _{1}^{2}\left( P_{\mathcal{\nu }}\right) \left( \hat{\lambda}%
_{2}-P_{\mathcal{H}^{2}}\right) +2\left( \hat{\lambda}_{2}-P_{\mathcal{H}%
^{2}}\right) \Gamma _{1}^{2}\left( P_{\mathcal{\nu }}\right) + \\
&&\qquad \qquad \qquad 2\Gamma _{1}^{2}\left( P_{\mathcal{\nu }}\right)
\left( 2\Gamma _{1}^{2}\left( P_{\mathcal{\nu }}\right) +P_{\mathcal{H}%
^{2}}\right) =0
\end{eqnarray*}

\paragraph{Example}

The two particle condition for decomposable diagonal operators gives 
\begin{eqnarray*}
&&\left\{ \left( \lambda _{2}^{2}\right) _{j_{1}j_{2}j_{1}j_{2}}-\lambda
_{2j_{1}j_{2}j_{1}j_{2}}\right\} +2\left( \lambda _{1j_{1}j_{1}}+\lambda
_{1j_{2}j_{2}}\right) \lambda _{2j_{1}j_{2}j_{1}j_{2}} \\
&&\left. +\right. \left\{ \left( \lambda _{1j_{1}j_{1}}+\lambda
_{1j_{2}j_{2}}\right) ^{2}-\left( \lambda _{1j_{1}j_{1}}+\lambda
_{1j_{2}j_{2}}\right) \right\} =0,1\leq j_{1}<j_{2}\leq r,
\end{eqnarray*}%
which factorizes to give%
\begin{eqnarray*}
&=&\lambda _{2j_{1}j_{2}j_{1}j_{2}}\left( \lambda
_{2j_{1}j_{2}j_{1}j_{2}}-1\right) \left. +\right. 2\left( \lambda
_{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) \left( \lambda
_{2j_{1}j_{2}j_{1}j_{2}}\right) +\left( \lambda _{1j_{1}j_{1}}+\lambda
_{1j_{2}j_{2}}\right) \left( \left( \lambda _{1j_{1}j_{1}}+\lambda
_{1j_{2}j_{2}}\right) -1\right) \\
&=&\lambda _{2j_{1}j_{2}j_{1}j_{2}}\left( \lambda
_{2j_{1}j_{2}j_{1}j_{2}}-1\right) \left. +\right. \left( \lambda
_{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) \left\{ 2\lambda
_{2j_{1}j_{2}j_{1}j_{2}}+\lambda _{1j_{1}j_{1}}+\lambda
_{1j_{2}j_{2}}-1\right\} \\
&=&0;1\leq j_{1}<j_{2}\leq r.
\end{eqnarray*}

\paragraph{If $P_{\mathcal{\protect\nu }}$ is zero dimensional i.e. $\hat{%
\protect\lambda}_{1}=0$ then}

\begin{equation*}
\lambda _{1j_{1}j_{1}}=\lambda _{1j_{2}j_{2}}=0;\,1\leq j_{1}<j_{2}\leq r
\end{equation*}%
and we obtain for decomposable diagonal operators 
\begin{equation*}
\lambda _{2j_{1}j_{2}j_{1}j_{2}}\left( \lambda
_{2j_{1}j_{2}j_{1}j_{2}}-1\right) =0\Leftrightarrow \lambda
_{2j_{1}j_{2}j_{1}j_{2}}=0\text{ or }1;1\leq j_{1}<j_{2}\leq r
\end{equation*}%
and thus $\hat{\lambda}_{2}$ is a projector.

\paragraph{ If $P_{\mathcal{\protect\nu }}$ is one dimensional then}

\begin{eqnarray*}
\lambda _{111} &=&1 \\
\lambda _{1jj} &=&0;2\leq j\leq r,
\end{eqnarray*}%
we obtain for decomposable diagonal operators 
\begin{eqnarray*}
&&\lambda _{21j1j}\left( \lambda _{21j1j}+1\right) =0,\, \\
&&\left. \Rightarrow \right. \lambda _{21j1j}=0\text{ or }-1;2\leq j\leq r,
\end{eqnarray*}%
while 
\begin{eqnarray*}
&&\lambda _{2jkjk}\left( \lambda _{2jkjk}-1\right) =0,\, \\
&&\left. \Rightarrow \right. \lambda _{2jkjk}=0\text{ or }1;2\leq j<k\leq r
\end{eqnarray*}

$\lceil $The set of solutions for decomposable diagonal operators for $r=4$
are 
\begin{eqnarray*}
&&\left\{ \lambda _{21212},\lambda _{21313},\lambda _{21414},\lambda
_{22323},\lambda _{22424},\lambda _{23434}\right\} = \\
&&\left\{ 
\begin{array}{c}
\left\{ 0,0,0,0,0,0\right\} ,\left\{ 0,0,0,1,0,0\right\} ,\left\{
0,0,0,1,1,0\right\} ,\left\{ 0,0,0,1,1,1\right\} \\ 
\left\{ -1,0,0,0,0,0\right\} ,\left\{ -1,0,0,1,0,0\right\} ,\left\{
-1,0,0,1,1,0\right\} ,\left\{ -1,0,0,1,1,1\right\} \\ 
\left\{ -1,-1,0,0,0,0\right\} ,\left\{ -1,-1,0,1,0,0\right\} ,\left\{
-1,-1,0,1,1,0\right\} ,\left\{ -1,-1,0,1,1,1\right\} \\ 
\left\{ -1,-1,-1,0,0,0\right\} ,\left\{ -1,-1,-1,1,0,0\right\} ,\left\{
-1,-1,-1,1,1,0\right\} ,\left\{ -1,-1,-1,1,1,1\right\}%
\end{array}%
\right. \\
&&\rfloor
\end{eqnarray*}

\subparagraph{Example showing that this condition is not sufficient}

\begin{eqnarray*}
\lambda &=&n_{1}-n_{1}n_{2}-n_{1}n_{3}=\,n_{1}\left( 1-n_{2}-n_{3}\right) \\
\lambda ^{2} &=&n_{1}\left( 1-\left( n_{2}+n_{3}\right) \right)
^{2}=n_{1}\left( 1-2n_{2}-2n_{3}+n_{2}+2n_{2}n_{3}+n_{3}\right) \\
&=&n_{1}\left( 1-n_{2}-n_{3}+2n_{2}n_{3}\right)
=n_{1}-n_{1}n_{2}-n_{1}n_{3}+2n_{1}n_{2}n_{3}\neq \lambda
\end{eqnarray*}%
even though the two particle idempotency conditions are satisfied. This is
consistent as the restriction of $\lambda $ to $\mathcal{H}^{2}$ is
idempotent i.e. 
\begin{equation*}
\left( \left. \lambda \right\vert _{\mathcal{H}^{2}}\right) ^{2}=\left(
\left. \left( n_{1}-n_{1}n_{2}-n_{1}n_{3}\right) \right\vert _{\mathcal{H}%
^{2}}\right) ^{2}=\left. \left( n_{1}-n_{1}n_{2}-n_{1}n_{3}\right)
\right\vert _{\mathcal{H}^{2}}
\end{equation*}%
and 
\begin{equation*}
\left. \lambda ^{2}\right\vert _{\mathcal{H}^{2}}=\left( \left. \lambda
\right\vert _{\mathcal{H}^{2}}\right) ^{2}
\end{equation*}%
as $\lambda $ is particle conserving. The higher order conditions rule out $%
n_{1}-n_{1}n_{2}-n_{1}n_{3}$ being a projector.

\paragraph{If $P_{\mathcal{\protect\nu }}$ is two dimensional}

(again for for decomposable diagonal operators)%
\begin{eqnarray*}
\lambda _{111} &=&1 \\
\lambda _{122} &=&1 \\
\lambda _{1jj} &=&0;\,3\leq j\leq r
\end{eqnarray*}%
i.e. 
\begin{equation}
\lambda =a_{1}^{\dagger }a_{1}+a_{2}^{\dagger }a_{2}+\sum_{1\leq j<k\leq
r}\lambda _{2bjkjk}a_{j}^{\dagger }a_{k}^{\dagger }a_{k}a_{j},
\end{equation}%
the condition 
\begin{eqnarray}
&&\left( \lambda _{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) \left( \left(
\lambda _{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) -1\right)  \notag \\
&&+2\left( \lambda _{1j_{1}j_{1}}+\lambda _{1j_{2}j_{2}}\right) \left(
\lambda _{2j_{1}j_{2}j_{1}j_{2}}\right)  \notag \\
&&+\lambda _{2j_{1}j_{2}j_{1}j_{2}}\left( \lambda
_{2j_{1}j_{2}j_{1}j_{2}}-1\right) =0  \notag \\
&&1\leq j_{1}<j_{2}\leq r,
\end{eqnarray}%
gives that 
\begin{eqnarray}
0 &=&\lambda _{21212}^{2}+3\lambda _{21212}+2  \notag \\
&=&\left( \lambda _{21212}+1\right) \left( \lambda _{21212}+2\right)  \notag
\\
&\Rightarrow &\lambda _{21212}=-1\text{ or }-2,
\end{eqnarray}%
while (in the case $r=4$)

\begin{equation*}
\lambda _{21414},\lambda _{22424},\lambda _{21313},\lambda _{22323}=0\text{
or }-1
\end{equation*}%
and 
\begin{equation*}
\lambda _{23434}=0\text{ or }1.
\end{equation*}%
Thus the set of solutions (in the case $r=4$) are 
\begin{eqnarray*}
&&\left\{ \lambda _{21212},\lambda _{21313},\lambda _{21414},\lambda
_{22323},\lambda _{22424},\lambda _{23434}\right\} = \\
&&\left\{ 
\begin{array}{c}
\begin{array}{c}
\left\{ -1,-1,0,0,0,0\right\} ,\left\{ -1,-1,0,0,0,1\right\} ,\left\{
-1,-1,-1,0,0,0\right\} ,\left\{ -1,-1,-1,0,0,1\right\} \\ 
\left\{ -1,-1,-1,-1,0,0\right\} ,\left\{ -1,-1,-1,-1,0,1\right\} ,\left\{
-1,-1,-1,-1,-1,0\right\} , \\ 
\left\{ -1,-1,-1,-1,-1,1\right\} ,\left\{ -2,0,0,0,0,0\right\}%
\end{array}
\\ 
\begin{array}{c}
\left\{ -2,-1,0,0,0,0\right\} ,\left\{ -2,-1,0,0,0,1\right\} ,\left\{
-2,-1,-1,0,0,0\right\} ,\left\{ -2,-1,-1,0,0,1\right\} \\ 
\left\{ -2,-1,-1,-1,0,0\right\} ,\left\{ -2,-1,-1,-1,0,1\right\} ,\left\{
-2,-1,-1,-1,-1,0\right\} , \\ 
\left\{ -2,-1,-1,-1,-1,1\right\}%
\end{array}
\\ 
\begin{array}{c}
\left\{ -2,-2,0,0,0,0\right\} ,\left\{ -2,-2,0,0,0,1\right\} ,\left\{
-2,-2,-1,0,0,0\right\} ,\left\{ -2,-2,-1,0,0,1\right\} \\ 
\left\{ -2,-2,-1,-1,0,0\right\} ,\left\{ -2,-2,-1,-1,0,1\right\} ,\left\{
-2,-2,-1,-1,-1,0\right\} , \\ 
\left\{ -2,-2,-1,-1,-1,1\right\}%
\end{array}%
\end{array}%
\right.
\end{eqnarray*}

\subparagraph{Example}

\begin{equation*}
\lambda =a_{1}^{\dagger }a_{1}+a_{2}^{\dagger }a_{2}-2a_{1}^{\dagger
}a_{2}^{\dagger }a_{2}a_{1}=n_{1}+n_{2}-2n_{1}n_{2}
\end{equation*}%
\begin{eqnarray*}
\lambda ^{2} &=&\left( n_{1}+n_{2}-2n_{1}n_{2}\right) ^{2}=\left(
n_{1}+n_{2}\right) ^{2}-4\left( n_{1}+n_{2}\right) n_{1}n_{2}+\left(
2n_{1}n_{2}\right) ^{2} \\
&=&n_{1}+n_{2}+2n_{1}n_{2}-8n_{1}n_{2}+4n_{1}n_{2}=n_{1}+n_{2}-2n_{1}n_{2}=%
\lambda .
\end{eqnarray*}

\paragraph{ If $P_{\mathcal{\protect\nu }}$ is three dimensional}

(again for decomposable diagonal operators)%
\begin{eqnarray*}
\lambda _{111} &=&1 \\
\lambda _{122} &=&1 \\
\lambda _{133} &=&1 \\
\lambda _{144} &=&0
\end{eqnarray*}%
we obtain 
\begin{eqnarray*}
0 &=&\lambda _{21212}^{2}+3\lambda _{21212}+2 \\
&=&\left( \lambda _{21212}+1\right) \left( \lambda _{21212}+2\right) \\
&\Rightarrow &\lambda _{21212}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{21313}+1\right) \left( \lambda _{21313}+2\right) \\
&\Rightarrow &\lambda _{21313}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{22323}+1\right) \left( \lambda _{22323}+2\right) \\
&\Rightarrow &\lambda _{22323}=-1\text{ or }-2,
\end{eqnarray*}%
while

\begin{equation*}
\lambda _{21414},\lambda _{22424},\lambda _{23434}=0\text{ or }-1.
\end{equation*}%
The set of solutions is ........

\subparagraph{Example showing conditions are not sufficient}

\begin{eqnarray*}
\lambda &=&a_{1}^{\dagger }a_{1}+a_{2}^{\dagger }a_{2}+a_{3}^{\dagger
}a_{3}-a_{1}^{\dagger }a_{2}^{\dagger }a_{2}a_{1}-2a_{1}^{\dagger
}a_{3}^{\dagger }a_{3}a_{1}-2a_{2}^{\dagger }a_{3}^{\dagger }a_{3}a_{2} \\
&=&n_{1}+n_{2}+n_{3}-n_{1}n_{2}-2n_{1}n_{3}-2n_{2}n_{3}
\end{eqnarray*}%
then%
\begin{eqnarray*}
\lambda ^{2} &=&\left(
n_{1}+n_{2}+n_{3}-n_{1}n_{2}-2n_{1}n_{3}-2n_{2}n_{3}\right) ^{2} \\
&=&\left\{ \left( n_{1}+n_{2}+n_{3}\right) -\left(
n_{1}n_{2}+2n_{1}n_{3}+2n_{2}n_{3}\right) \right\} ^{2} \\
&\neq &\lambda .
\end{eqnarray*}

$\lceil $ As%
\begin{eqnarray}
\left( n_{1}+n_{2}+n_{3}\right) ^{2} &=&\left( n_{1}+n_{2}+n_{3}\right)
\left( n_{1}+n_{2}+n_{3}\right)  \notag \\
&=&n_{1}+n_{2}+n_{3}+2n_{1}n_{2}+2n_{1}n_{3}+2n_{2}n_{3}
\end{eqnarray}

\begin{eqnarray}
&&2\left( n_{1}+n_{2}+n_{3}\right) \left(
n_{1}n_{2}+2n_{1}n_{3}+2n_{2}n_{3}\right)  \notag \\
&=&2n_{1}n_{2}+4n_{1}n_{3}+4n_{1}n_{2}n_{3}+2n_{1}n_{2}+4n_{2}n_{3}+2n_{1}n_{2}n_{3}+4n_{2}n_{3}+4n_{1}n_{3}+2n_{1}n_{2}n_{3}
\notag \\
&=&4n_{1}n_{2}+8n_{1}n_{3}+8n_{1}n_{2}n_{3}+8n_{2}n_{3}
\end{eqnarray}%
\begin{eqnarray}
&&\left( n_{1}n_{2}+2n_{1}n_{3}+2n_{2}n_{3}\right) ^{2}=\left(
n_{1}n_{2}+2n_{1}n_{3}+2n_{2}n_{3}\right) \left(
n_{1}n_{2}+2n_{1}n_{3}+2n_{2}n_{3}\right)  \notag \\
&=&n_{1}n_{2}+2n_{1}n_{2}n_{3}+2n_{1}n_{2}n_{3}+2n_{1}n_{2}n_{3}+4n_{1}n_{3}+4n_{1}n_{2}n_{3}+2n_{1}n_{2}n_{3}+4n_{1}n_{2}n_{3}+4n_{2}n_{3}
\notag \\
&=&n_{1}n_{2}+4n_{1}n_{3}+4n_{2}n_{3}+16n_{1}n_{2}n_{3}
\end{eqnarray}%
$\rfloor $

\paragraph{If $P_{\mathcal{\protect\nu }}$ is four dimensional}

\begin{eqnarray*}
\lambda _{111} &=&1 \\
\lambda _{122} &=&1 \\
\lambda _{133} &=&1 \\
\lambda _{144} &=&1
\end{eqnarray*}%
we obtain 
\begin{eqnarray*}
0 &=&\left( \lambda _{21212}+1\right) \left( \lambda _{21212}+2\right) \\
&\Rightarrow &\lambda _{21212}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{21313}+1\right) \left( \lambda _{21313}+2\right) \\
&\Rightarrow &\lambda _{21313}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{21414}+1\right) \left( \lambda _{21414}+2\right) \\
&\Rightarrow &\lambda _{21414}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{22323}+1\right) \left( \lambda _{22323}+2\right) \\
&\Rightarrow &\lambda _{22323}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{22424}+1\right) \left( \lambda _{22424}+2\right) \\
&\Rightarrow &\lambda _{22424}=-1\text{ or }-2,
\end{eqnarray*}%
\begin{eqnarray*}
0 &=&\left( \lambda _{23434}+1\right) \left( \lambda _{23434}+2\right) \\
&\Rightarrow &\lambda _{23434}=-1\text{ or }-2.
\end{eqnarray*}

