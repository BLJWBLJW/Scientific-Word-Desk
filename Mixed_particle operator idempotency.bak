_{1j_{3}j_{3}}=0;\,1\leq j_{1}<j_{2}<j_{3}\leq 4
\end{equation*}%
and we obtain 
\begin{eqnarray*}
&&\left( \lambda _{21j_{2}1j_{2}}+\lambda _{21j_{3}1j_{3}}+\lambda
_{2j_{2}j_{3}j_{2}j_{3}}\right) \left( \left( \lambda
_{21j_{2}1j_{2}}+\lambda _{21j_{3}1j_{3}}+\lambda
