\end{eqnarray}%
\begin{eqnarray*}
&&\lambda ^{2}-\lambda = \\
&&\left( 2+3\lambda _{21212}+\lambda _{21212}^{2}\right) n_{1}n_{2}+\left(
2+3\lambda _{21313}+\lambda _{21313}^{2}\right) n_{1}n_{3}+\left( 2+3\lambda
_{21414}+\lambda _{21414}^{2}\right) n_{1}n_{4} \\
&&+\left( 2+3\lambda _{22323}+\lambda _{22323}^{2}\right) n_{2}n_{3}+\left(
