\section{The General Case}

\paragraph{\protect\bigskip Commutation Relationships}

\begin{equation}
\left[ a_{l}^{\dagger }a_{l},a_{k}^{\dagger }\right] =a_{l}^{\dagger
}a_{l}a_{k}^{\dagger }-a_{k}^{\dagger }a_{l}^{\dagger }a_{l}=a_{l}^{\dagger
}\delta _{lk}+a_{k}^{\dagger }a_{l}^{\dagger }a_{l}-a_{k}^{\dagger
}a_{l}^{\dagger }a_{l}=a_{l}^{\dagger }\delta _{lk}
\end{equation}%
hence%
\begin{equation}
\left[ a_{l}^{\dagger }a_{l},a_{k}\right] =\left[ n_{l},a_{k}\right]
=-a_{l}\delta _{lk}
\end{equation}%
and 
\begin{equation}
\left[ n_{l},a_{k}^{\dagger }\right] =a_{l}^{\dagger }\delta _{lk}.
\end{equation}%
This gives 
\begin{eqnarray}
\left[ a_{l}^{\dagger }a_{l},a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}\right]  &=&\left[ a_{l}^{\dagger
}a_{l},a_{l_{1}}^{\dagger }\right] a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}+a_{l_{1}}^{\dagger }\left[ a_{l}^{\dagger
}a_{l},a_{l_{2}}^{\dagger }\right] a_{l_{4}}a_{l_{3}}+a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }\left[ a_{l}^{\dagger }a_{l},a_{l_{4}}\right]
a_{l_{3}}+a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l_{4}}\left[
a_{l}^{\dagger }a_{l},a_{l_{3}}\right]  \\
&=&a_{l}^{\dagger }a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}\delta
_{ll_{1}}+a_{l_{1}}^{\dagger }a_{l}^{\dagger }a_{l_{4}}a_{l_{3}}\delta
_{ll_{2}}-a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l}a_{l_{3}}\delta
_{ll_{4}}-a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l_{4}}a_{l}^{\dagger
}\delta _{ll_{3}}
\end{eqnarray}%
and 
\begin{eqnarray}
&&\sum_{\substack{ 1\leq l_{1}<l_{2}\leq r \\ 1\leq l_{3}<l_{4}\leq r}}%
\lambda _{2l_{1}l_{2}l_{3}l_{4}}\left[ a_{l}^{\dagger
}a_{l},a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}\right] = 
\notag \\
&&\frac{1}{4}\sum_{\substack{ 1\leq l_{1},l_{2}\leq r \\ 1\leq
l_{3},l_{4}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l_{4}}\left\{ a_{l}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}\delta _{ll_{1}}+a_{l_{1}}^{\dagger
}a_{l}^{\dagger }a_{l_{4}}a_{l_{3}}\delta _{ll_{2}}-a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l}a_{l_{3}}\delta _{ll_{4}}-a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l}^{\dagger }\delta _{ll_{3}}\right\}  
\notag \\
&=&\frac{1}{4}\sum_{\substack{ 1\leq l_{1},l_{2}\leq r \\ 1\leq
l_{3},l_{4}\leq r}}\left\{ \lambda _{2ll_{2}l_{3}l_{4}}a_{l}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}+\lambda
_{2l_{1}ll_{3}l_{4}}a_{l_{1}}^{\dagger }a_{l}^{\dagger
}a_{l_{4}}a_{l_{3}}-\lambda _{2l_{1}l_{2}l_{3}l}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l}a_{l_{3}}-\lambda
_{2l_{1}l_{2}ll_{4}}a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l}\right\}   \notag \\
&=&\frac{1}{2}\left\{ \sum_{\substack{ 1\leq l_{2}\leq r \\ 1\leq
l_{3},l_{4}\leq r}}\lambda _{2ll_{2}l_{3}l_{4}}a_{l}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}-\sum_{\substack{ 1\leq
l_{1},l_{2}\leq r \\ 1\leq l_{3}\leq r}}\lambda
_{2l_{1}l_{2}l_{3}l}a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l}a_{l_{3}}\right\} .
\end{eqnarray}%
Thus 
\begin{equation}
n_{l}\sum_{\substack{ 1\leq l_{1}<l_{2}\leq r \\ 1\leq l_{3}<l_{4}\leq r}}%
\lambda _{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}=\sum_{\substack{ 1\leq l_{1}<l_{2}\leq r \\ 1\leq
l_{3}<l_{4}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}n_{l}+\frac{1}{2}\left\{ \sum
_{\substack{ 1\leq l_{2}\leq r \\ 1\leq l_{3},l_{4}\leq r}}\lambda
_{2ll_{2}l_{3}l_{4}}a_{l}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}-\sum_{\substack{ 1\leq l_{1},l_{2}\leq r \\ 1\leq
l_{3}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l}a_{l_{3}}\right\} 
\end{equation}%
and 
\begin{equation}
n_{l}\lambda _{2}+\lambda _{2}n_{l}=2n_{l}\lambda _{2}-\sum_{\substack{ %
1\leq l_{2}\leq r \\ 1\leq l_{3}<l_{4}\leq r}}\lambda
_{2ll_{2}l_{3}l_{4}}a_{l}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}-\sum_{\substack{ 1\leq l_{1}<l_{2}\leq r \\ 1\leq
l_{3}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l}a_{l_{3}}.
\end{equation}%
Hence 
\begin{equation}
n_{l}\lambda _{2}+\lambda _{2}n_{l}=\sum_{\substack{ 1\leq l_{1}<l_{2}\leq r
\\ 1\leq l_{3}<l_{4}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l_{4}}a_{l}^{\dagger
}a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l}a_{l_{4}}a_{l_{3}}+\sum
_{\substack{ 1\leq l_{2}\leq r \\ 1\leq l_{3}<l_{4}\leq r}}\lambda
_{2ll_{2}l_{3}l_{4}}a_{l}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}-\sum_{\substack{ 1\leq l_{1}\leq r \\ 1\leq
l_{3}<l_{4}\leq r}}\lambda _{2l_{1}ll_{3}l_{4}}a_{l}^{\dagger
}a_{l_{1}}^{\dagger }a_{l_{4}}a_{l_{3}}
\end{equation}

The idempotency condition gives 
\begin{equation}
\Lambda _{111}=\sum_{1\leq l\leq r}\alpha _{l}\left( \alpha _{l}-1\right)
a_{l}^{\dagger }a_{l}=0\Leftrightarrow \alpha _{l}=1\text{ or }\alpha _{l}=0
\end{equation}%
\begin{align}
& \Lambda _{112}+\Lambda _{222}+\Lambda _{122}=2\sum_{1\leq l_{1}<l_{2}\leq
\nu }a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l_{2}}a_{l_{1}}+\sum
_{\substack{ 1\leq l_{1}<l_{2}\leq r \\ 1\leq k_{3}<k_{4}\leq r}}\left\{
\lambda _{2l_{1}l_{2}k_{3}k_{4}}^{2}-\lambda
_{2l_{1}l_{2}k_{3}k_{4}}\right\} a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{k_{4}}a_{k_{3}}  \notag \\
& +\frac{1}{4}\left( \sum_{\substack{ 1\leq l_{1}\leq \nu ,\nu +1\leq
l_{2}\leq r \\ \nu +1\leq l_{3},l_{4}\leq r}}\lambda
_{2l_{1}l_{2}l_{3}l_{4}}+\sum_{\substack{ \nu +1\leq l_{1}\leq r,1\leq
l_{2}\leq \nu  \\ \nu +1\leq l_{3},l_{4}\leq r}}\lambda
_{2l_{1}l_{2}l_{3}l_{4}}+\sum_{\substack{ 1\leq l_{1},l_{2}\leq r \\ 1\leq
l_{3}\leq \nu ,\nu +1\leq l_{4}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l_{4}}+\sum
_{\substack{ 1\leq l_{1},l_{2}\leq r \\ \nu +1\leq l_{3}\leq r,1\leq
l_{4}\leq \nu }}\lambda _{2l_{1}l_{2}l_{3}l_{4}}\right) a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}=0  \notag
\end{align}%
The last term is equal to%
\begin{eqnarray}
\Lambda _{122} &=&4\sum_{\substack{ 1\leq l_{1}<l_{2}\leq \nu , \\ 1\leq
l_{3}<l_{4}\leq \nu }}\lambda _{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}+\sum_{\substack{ 1\leq l_{1}\leq \nu
,\nu +1\leq l_{2}\leq r \\ \nu +1\leq l_{3},l_{4}\leq r}}\lambda
_{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}  \notag \\
&&+\sum_{\substack{ 1\leq l_{1},l_{2}\leq r \\ 1\leq l_{3}\leq \nu ,\nu
+1\leq l_{4}\leq r}}\lambda _{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}}+\sum_{\substack{ 1\leq
l_{1},l_{2}\leq r \\ \nu +1\leq l_{3}\leq r,1\leq l_{4}\leq \nu }}\lambda
_{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}\left. =\right. 0
\end{eqnarray}%
giving 
\begin{eqnarray}
\Lambda _{112}+\Lambda _{222}+\Lambda _{122} &=&\sum_{\substack{ 1\leq
l_{1}<l_{2}\leq \nu , \\ 1\leq l_{3}<l_{4}\leq \nu }}\left( 2\delta
_{l_{1}l_{3}}\delta _{l_{2}l_{4}}+3\lambda _{2l_{1}l_{2}l_{3}l_{4}}+\lambda
_{2l_{1}l_{2}l_{3}l_{4}}^{2}\right) a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}} \\
&&+\sum_{\substack{ \nu +1\leq l_{1}\leq \nu ,1\leq l_{2}\leq \nu , \\ \nu
+1\leq l_{3}<l_{4}\leq r}}\left( \lambda
_{2l_{1}l_{2}k_{3}k_{4}}^{2}+\lambda _{2l_{1}l_{2}k_{3}k_{4}}\right)
a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger }a_{l_{4}}a_{l_{3}} \\
&&+\sum_{\substack{ \nu +1\leq l_{1},l_{2}\leq r \\ 1\leq l_{3}\leq \nu ,\nu
+1\leq l_{4}\leq r}}\left( \lambda _{2l_{1}l_{2}k_{3}k_{4}}^{2}+\lambda
_{2l_{1}l_{2}k_{3}k_{4}}\right) a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}} \\
&&+\sum_{\substack{ \nu +1\leq l_{1},l_{2}\leq r \\ \nu +1\leq l_{3}\leq
r,1\leq l_{4}\leq \nu }}\left( \lambda _{2l_{1}l_{2}k_{3}k_{4}}^{2}+\lambda
_{2l_{1}l_{2}k_{3}k_{4}}\right) a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}} \\
&&+\sum_{\substack{ \nu +1\leq l_{1}<l_{2}\leq r, \\ \nu +1\leq
l_{3}<l_{4}\leq r}}\left( \lambda _{2l_{1}l_{2}k_{3}k_{4}}^{2}-\lambda
_{2l_{1}l_{2}k_{3}k_{4}}\right) a_{l_{1}}^{\dagger }a_{l_{2}}^{\dagger
}a_{l_{4}}a_{l_{3}}\left. =\right. 0
\end{eqnarray}%
\begin{align}
& \Lambda _{223}+\Lambda _{123}=9\sum_{\substack{ 1\leq
l_{1}<l_{2}<k_{2}\leq r \\ 1\leq l_{3}<k_{3}<k_{4}\leq r}}\sum_{\substack{ %
\sigma ,\eta \in S_{3} \\ 1\leq l_{4}\leq r}}\left( -1\right) ^{\pi \left(
