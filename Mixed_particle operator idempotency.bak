}a_{l_{2}}^{\dagger }a_{k_{2}}^{\dagger }a_{l_{3}}a_{k_{4}}a_{k_{3}}  \notag
\\
& +\sum_{\substack{ 1\leq l_{1}<l_{2}\leq r \\ 1\leq l_{3}<l_{4}\leq r \\ %
1\leq l\leq \nu }}\lambda _{2l_{1}l_{2}l_{3}l_{4}}a_{l_{1}}^{\dagger
}a_{l_{2}}^{\dagger }a_{l}^{\dagger }a_{l}a_{l_{4}}a_{l_{3}}\left. =\right. 0
\notag
\end{align}%
\begin{subequations}
\begin{align}
& \Lambda _{224}=36\sum_{\substack{ 1\leq l_{1}<l_{2}<k_{1}<k_{2}\leq r \\ %
1\leq l_{3}<l_{4}<k_{3}<k_{4}\leq r \\ \sigma ,\eta \in S_{4}}}\left(
