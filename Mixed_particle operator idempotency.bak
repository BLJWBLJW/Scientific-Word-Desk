\begin{array}{c}
\lambda _{21212}n_{1}n_{2}+\lambda _{21313}n_{1}n_{3}+\lambda
_{21414}n_{1}n_{4}+ \\ 
\lambda _{22323}n_{2}n_{3}+\lambda _{22424}n_{2}n_{4}+\lambda
