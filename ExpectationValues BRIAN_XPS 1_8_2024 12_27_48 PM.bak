\begin{align}
\mathcal{R}_{x}\left( O\left( r,\mathbb{R}\right) \right) & =\left( 
\begin{array}{cc}
\cos\boldsymbol{\theta} & \mathbb{O} \\ 
\mathbb{O} & \cos\boldsymbol{\theta}%
\end{array}
\right) \\
\mathcal{R}_{x}\left( U\left( r\right) \right) & =\left( 
\begin{array}{cc}
\cos\boldsymbol{\theta} & \sin\boldsymbol{\theta} \\ 
-\sin\boldsymbol{\theta} & \cos\boldsymbol{\theta}%
\end{array}
\right) \\
\mathcal{R}_{x}\left( O\left( 2r,\mathbb{R}\right) \right) & =\left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & \func{Im}\left( \mathbb{V+U}\right) \\ 
\func{Im}\left( \mathbb{V}-\mathbb{U}\right) & \func{Re}\left( \mathbb{U-V}%
\right)%
\end{array}
\right) .
\end{align}

\subsection{Complexification of $\mathcal{A}_{1x\mathbb{R}}$}

The space $\mathcal{A}_{1x\mathbb{R}}$ can be complexified to give $\mathcal{%
A}_{1x\mathbb{C}}$ by introducing the definition 
\begin{equation}
ia\equiv \widehat{J_{2rx}^{t}}a=-\widehat{J_{2rx}}a;a\in \mathcal{A}_{1x%
\mathbb{R}}
\end{equation}%
and $\widehat{J_{2rx}}$ is defined as above. Hence $\mathcal{A}_{1x\mathbb{C}%
}$ is given as 
\begin{equation}
\mathcal{A}_{1x\mathbb{C}}=\left\{ \left. a=\left( a_{1},a_{2}\right)
\right\vert a=a_{1}+a_{2}\right\} =\left\{ \left. a_{1}+ia_{2}\right\vert
a=a_{1}+a_{2}\right\}
\end{equation}%
and%
\begin{equation}
i\left( a_{1}+ia_{2}\right) =ia_{1}-a_{2}=-a_{2}+ia_{1}\equiv \left(
-a_{2},a_{1}\right)
\end{equation}%
\begin{equation}
-\widehat{J_{2rx}}a=-\widehat{J_{2rx}}\left( a_{1},a_{2}\right) =\left(
-a_{2},a_{1}\right)
\end{equation}%
$\lceil $%
\begin{equation}
\widehat{J_{2rx}}a=\widehat{J_{2rx}}\left( \mathbf{x}_{1}\mathbf{x}%
_{2}\right) \left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{a}_{2}%
\end{array}%
\right) =\left( \mathbf{x}_{1}\mathbf{x}_{2}\right) \mathbb{J}_{2rx}\left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{a}_{2}%
\end{array}%
\right) =\left( \mathbf{x}_{1}\mathbf{x}_{2}\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{a}_{2}%
\end{array}%
\right) =\left( \mathbf{x}_{1}\mathbf{x}_{2}\right) \left( 
\begin{array}{c}
\mathbf{a}_{2} \\ 
-\mathbf{a}_{1}%
\end{array}%
\right)
\end{equation}%
\begin{align}
\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{a}_{2}%
\end{array}%
\right) & =\left( 
\begin{array}{c}
\mathbf{a}_{2} \\ 
-\mathbf{a}_{1}%
\end{array}%
\right) \\
\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{a}_{1} \\ 
\mathbf{0}%
\end{array}%
\right) & =\left( 
\begin{array}{c}
\mathbf{0} \\ 
-\mathbf{a}_{1}%
\end{array}%
\right) \\
\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{0} \\ 
\mathbf{a}_{2}%
\end{array}%
\right) & =\left( 
\begin{array}{c}
\mathbf{a}_{2} \\ 
0%
\end{array}%
\right)
\end{align}%
$\rfloor \lceil $%
\begin{align}
& z_{1}\left( a_{1},a_{2}\right) +z_{2}\left( b_{1},b_{2}\right)
=z_{1}a+z_{2}b=\left( \func{Re}\left( z_{1}\right) +i\func{Im}\left(
z_{1}\right) \right) a+\left( \func{Re}\left( z_{2}\right) +i\func{Im}\left(
z_{2}\right) \right) b \\
& =\func{Re}\left( z_{1}\right) a+\func{Re}\left( z_{2}\right) b+\func{Im}%
\left( z_{1}\right) ia+\func{Im}\left( z_{2}\right) ib \\
& =\func{Re}\left( z_{1}\right) \left( a_{1},a_{2}\right) +\func{Re}\left(
z_{2}\right) \left( b_{1},b_{2}\right) +\func{Im}\left( z_{1}\right) i\left(
a_{1},a_{2}\right) +\func{Im}\left( z_{2}\right) i\left( b_{1},b_{2}\right)
\\
& =\left( \func{Re}\left( z_{1}\right) a_{1},\func{Re}\left( z_{1}\right)
a_{2}\right) +\left( \func{Re}\left( z_{2}\right) b_{1},\func{Re}\left(
z_{2}\right) b_{2}\right) +\func{Im}\left( z_{1}\right) J_{2rx}\left(
a_{1},a_{2}\right) +\func{Im}\left( z_{2}\right) J_{2rx}\left(
b_{1},b_{2}\right) \\
& =\left( \func{Re}\left( z_{1}\right) a_{1},\func{Re}\left( z_{1}\right)
a_{2}\right) +\left( \func{Re}\left( z_{2}\right) b_{1},\func{Re}\left(
z_{2}\right) b_{2}\right) +\left( \func{Im}\left( z_{1}\right) a_{2},-\func{%
Im}\left( z_{1}\right) a_{1}\right) +\left( \func{Im}\left( z_{2}\right)
b_{2},-\func{Im}\left( z_{2}\right) b_{1}\right) \\
& =\left( \func{Re}\left( z_{1}\right) a_{1}+\func{Im}\left( z_{1}\right)
a_{2}+\func{Re}\left( z_{2}\right) b_{1}+\func{Im}\left( z_{2}\right) b_{2},%
\func{Re}\left( z_{1}\right) a_{2}-\func{Im}\left( z_{1}\right) a_{1}+\func{%
Re}\left( z_{2}\right) b_{2}-\func{Im}\left( z_{2}\right) b_{1}\right)
\end{align}%
$\rfloor \lceil $%
\begin{align}
\mathcal{F}_{1x\mathbb{C}}& =\mathcal{F}_{1x\mathbb{R+}}\oplus \widehat{%
J_{2rx}^{t}}\mathcal{F}_{1x\mathbb{R-}} \\
\mathcal{F}_{1x\mathbb{R}}& =\mathcal{F}_{1x\mathbb{R+}}\oplus \mathcal{F}%
_{1x\mathbb{R-}} \\
\dim \left( \mathcal{F}_{1x\mathbb{R}}\right) & =2r;\dim \left( \mathcal{F}%
_{1x\mathbb{R+}}\right) =\dim \left( \mathcal{F}_{1x\mathbb{R-}}\right) =r
\end{align}%
$\rfloor $

$\mathcal{A}_{1x\mathbb{C}}$ can then be given a Hilbert space structure by
defining an inner product $\left\langle \left. \cdot \right\vert \cdot
\right\rangle _{\mathcal{A}_{1x\mathbb{C}}}$as 
\begin{equation}
\left\langle \left. a\right\vert b\right\rangle _{\mathcal{A}_{1x\mathbb{C}%
}}=\left( \left. a\right\vert b\right) _{\mathcal{A}_{1}}+i\left\{ \left.
a\right\vert b\right\} _{\mathcal{A}_{1x}}=\left( \left. a\right\vert
b\right) _{\mathcal{A}_{1}}+i\left( \left. a\right\vert \widehat{J_{2rx}}%
b\right) _{\mathcal{A}_{1}}.
\end{equation}%
The unitary group based on $\left\langle \left. \cdot \right\vert \cdot
\right\rangle _{\mathcal{A}_{1\mathbb{C}}}$ is given by 
\begin{equation}
\left\{ \left. u\in \mathcal{B}\left( \mathcal{A}_{1\mathbb{C}}\right)
\right\vert \left\langle \left. u\left( a\right) \right\vert u\left(
b\right) \right\rangle _{\mathcal{A}_{1\mathbb{C}}}=\left\langle \left.
a\right\vert b\right\rangle _{\mathcal{A}_{1\mathbb{C}}}\forall a,b\in 
\mathcal{A}_{1\mathbb{C}}\right\} ,
\end{equation}%
which leads to 
\begin{align}
\left\langle \left. u\left( a\right) \right\vert u\left( b\right)
\right\rangle _{\mathcal{A}_{1\mathbb{C}}}& =\left( \left. t\left( a\right)
\right\vert t\left( b\right) \right) _{\mathcal{A}_{1}}+i\left\{ \left.
t\left( a\right) \right\vert t\left( b\right) \right\} _{\mathcal{A}%
_{1x}}=\left( \left. t\left( a\right) \right\vert t\left( b\right) \right) _{%
\mathcal{A}_{1}}+i\left\{ \left. t\left( a\right) \right\vert t\left(
b\right) \right\} _{\mathcal{A}_{1x}} \\
& =\left( \left. a\right\vert t^{\dagger }tb\right) _{\mathcal{A}%
_{1}}+i\left( \left. a\right\vert t^{\dagger }\widehat{J_{2rx}}tb\right) _{%
\mathcal{A}_{1}} \\
& =\left( \left. a\right\vert b\right) _{\mathcal{A}_{1}}+i\left( \left.
a\right\vert \widehat{J_{2rx}}b\right) _{\mathcal{A}_{1}},
\end{align}%
so that 
\begin{equation}
t^{\dagger }t=I_{\mathcal{A}_{1}}\in \mathcal{B}\left( \mathcal{A}%
_{1}\right) ;t^{\dagger }\widehat{J_{2rx}}t=\widehat{J_{2rx}}
\end{equation}%
i.e. $t\in O\left( 2r,\mathbb{R}\right) \cap Sp\left( 2r,\mathbb{R}\right) ,$
hence 
\begin{equation}
U\left( r\right) =O\left( 2r,\mathbb{R}\right) \cap Sp\left( 2r,\mathbb{R}%
\right) .
\end{equation}

As vector spaces 
\begin{gather}
\mathcal{A}_{1x\mathbb{C}}=\mathcal{A}_{1y\mathbb{C}}\quad \\
\mathcal{A}_{1x\mathbb{R}}\cong \mathcal{A}_{1y\mathbb{R}}\quad \\
\forall \text{bases }\left\{ x,y\right\} ,
\end{gather}%
but as complex Hilbert spaces it is not always true that $\mathcal{A}_{1x%
\mathbb{C}}=\mathcal{A}_{1y\mathbb{C}}$ in terms of unitary equivalence i.e.%
\begin{align}
\left\langle \left. u\left( a\right) \right\vert u\left( b\right)
\right\rangle _{\mathcal{A}_{1\mathbb{C}}}& =\left( \left. t\left( a\right)
\right\vert t\left( b\right) \right) _{\mathcal{A}_{1}}+i\left\{ \left.
t\left( a\right) \right\vert t\left( b\right) \right\} _{\mathcal{A}%
_{1x}}=\left( \left. t\left( a\right) \right\vert t\left( b\right) \right) _{%
\mathcal{A}_{1}}+i\left\{ \left. t\left( a\right) \right\vert t\left(
b\right) \right\} _{\mathcal{A}_{1x}} \\
& =\left( \left. a\right\vert t^{\dagger }tb\right) _{\mathcal{A}%
_{1}}+i\left( \left. a\right\vert t^{\dagger }\widehat{J_{2rx}}tb\right) _{%
\mathcal{A}_{1}}=\left( \left. a\right\vert b\right) _{\mathcal{A}%
_{1}}+i\left( \left. a\right\vert t^{\dagger }\widehat{J_{2rx}}tb\right) _{%
\mathcal{A}_{1}}.
\end{align}%
\begin{equation}
\widehat{J_{2rt}}=t^{\dagger }\widehat{J_{2rx}}t
\end{equation}%
If $t$ $\in Sp\left( 2r,\mathbb{R}\right) $ then 
\begin{equation}
\widehat{J_{2rt}}=\widehat{J_{2rx}}.
\end{equation}

\appendix

\section{Types of $c^{\ast }$-algebra and $w^{\ast }$-algebras\label{Types}}

\begin{enumerate}
\item A $c^{\ast }$-algebra $\mathcal{A}$ is of type $I$ if and only if for
all non-degenerate representations $\Pi $ of $\mathcal{A}$ the von Neumann
algebra $\Pi $($\mathcal{A}$)$^{\prime \prime }$ (that is, the bicommutant
of $\Pi $($\mathcal{A}$)) is a type $I$ von Neumann algebra. In fact it is
sufficient to consider only factor representations, i.e. representations $%
\Pi $ for which $\Pi $($\mathcal{A}$)$^{\prime \prime }$ is a factor.

\item A locally compact group is said to be of type $I$ if and only if its
group $c^{\ast }$-algebra is type $I$.

\item If a $c^{\ast }$-algebra has non-type $I$ representations, then by
results of James Glimm it also has representations of type $II$ and type $%
III $. Thus for $c^{\ast }$-algebras and locally compact groups, it is only
meaningful to speak of type $I$ and non type $I$ properties.
\end{enumerate}

\section{Topologies \label{Topologies}}

\begin{enumerate}
\item The \emph{norm} topology or uniform topology or uniform operator
topology is defined by the usual norm $||x||$ on $B(H)$. It is stronger than
all the other topologies below.

\item The \emph{weak} (Banach space) topology is $\U{3c3} (B(H),B(H)_{\ast
}) $, in other words the weakest topology such that all elements of the dual 
$B(H)^{\emph{\ast }}$are continuous. It is the \emph{weak} topology on the
Banach space $B(H)$. It is stronger than the \emph{ultraweak} and \emph{weak}
operator topologies. (Warning: the weak Banach space topology and the weak
operator topology and the ultraweak topology are all sometimes called the
weak topology, but they are different.)

\item The Mackey topology or Arens-Mackey topology is the strongest locally
convex topology on B(H) such that the dual is B(H)*, and is also the uniform
convergence topology on $\U{3c3} (B(H)^{\ast },B(H)$-compact convex subsets
of $B(H)^{\ast }$. It is stronger than all topologies below.

\item The \U{3c3}-strong-* topology or ultrastrong-* topology is the weakest
topology stronger than the ultrastrong topology such that the adjoint map is
continuous. It is defined by the family of seminorms pw(x) and pw(x*) for
positive elements w of $B(H)^{\ast }$. It is stronger than all topologies
below.

\item The \U{3c3}-strong topology or ultrastrong topology or strongest
topology or strongest operator topology is defined by the family of
seminorms pw(x) for positive elements w of $B(H)^{\ast }$. It is stronger
than all the topologies below other than the strong $\ast $ topology.
Warning: in spite of the name "strongest topology", it is weaker than the
norm topology.

\item The \U{3c3}-weak topology or ultraweak topology or weak-* operator
topology or weak-* topology or weak topology or \U{3c3}(B(H), B(H)*)
topology is defined by the family of seminorms \TEXTsymbol{\vert}(w, x)%
\TEXTsymbol{\vert} for elements w of B(H)*. It is stronger than the weak
operator topology. (Warning: the weak Banach space topology and the weak
operator topology and the ultraweak topology are all sometimes called the
weak topology, but they are different.)

\item The strong-* operator topology or strong-* topology is defined by the
seminorms \TEXTsymbol{\vert}\TEXTsymbol{\vert}x(h)\TEXTsymbol{\vert}%
\TEXTsymbol{\vert} and \TEXTsymbol{\vert}\TEXTsymbol{\vert}x*(h)\TEXTsymbol{%
\vert}\TEXTsymbol{\vert} for h \U{2208} H. It is stronger than the strong
and weak operator topologies.

\item The strong operator topology (SOT) or strong topology is defined by
the seminorms \TEXTsymbol{\vert}\TEXTsymbol{\vert}x(h)\TEXTsymbol{\vert}%
\TEXTsymbol{\vert} for h \U{2208} H. It is stronger than the weak operator
topology.

\item The weak operator topology (WOT) or weak topology is defined by the
seminorms \TEXTsymbol{\vert}(x(h1), h2)\TEXTsymbol{\vert} for h1, h2 \U{2208}
H. (Warning: the weak Banach space topology, the weak operator topology, and
the ultraweak topology are all sometimes called the weak topology, but they
are different.)
\end{enumerate}

\subsection{Relations between the topologies}

\begin{enumerate}
\item The continuous linear functionals $\in \mathcal{B(H)}^{d}$ on $%
\mathcal{B(H)}$ for the weak, strong, and strong$\ast $ (operator)
topologies are the same, and are the finite linear combinations of the
linear functionals $\left\langle \left. h_{1}\right\vert Xh_{2}\right\rangle 
$ for $h_{1}$, $h_{2}$ $\in $ $\mathcal{H}$. The continuous linear
functionals on $\mathcal{B(H)}$ for the ultraweak, ultrastrong, ultrastrong$%
\ast $ and Arens-Mackey topologies are the same, and are the elements of the
predual $\mathcal{B(H)}_{d}$.

\item By definition, the continuous linear functionals in the norm topology
are the same as those in the weak Banach space topology. This dual is a
rather large space with many pathological elements.

\item On norm bounded sets of $\mathcal{B(H)}$, the weak (operator) and
ultraweak topologies coincide. This can be seen via, for instance, the
Banach--Alaoglu theorem. For essentially the same reason, the ultrastrong
topology is the same as the strong topology on any (norm) bounded subset of $%
\mathcal{B(H)}$. Same is true for the Arens-Mackey topology, the ultrastrong$%
\ast $, and the strong$\ast $ topology.

\item In locally convex spaces, closure of convex sets can be characterized
by the continuous linear functionals. Therefore, for a convex subset $K$ of $%
\mathcal{B(H)}$, the conditions that $K$ be closed in the ultrastrong$\ast $%
, ultrastrong, and ultraweak topologies are all equivalent and are also
equivalent to the conditions that for all $r>0$, K has closed intersection
with the closed ball of radius $r$ in the strong$\ast $, strong, or weak
(operator) topologies.

\item The norm topology is metrizable and the others are not; in fact they
fail to be first-countable. However, when $\mathcal{H}$ is separable, all
the topologies above are metrizable when restricted to the unit ball (or to
any norm-bounded subset).
\end{enumerate}

\subsection{Topology to use}

The most commonly used topologies are the norm, strong, and weak operator
topologies.

\begin{enumerate}
\item The weak operator topology is useful for compactness arguments,
because the unit ball is compact by the Banach--Alaoglu theorem.

\item The norm topology is fundamental because it makes $\mathcal{B(H)}$
into a Banach space, but it is too strong for many purposes; for example, $%
\mathcal{B(H)}$ is not separable in this topology.

\item The strong operator topology could be the most commonly used.

\item The ultraweak and ultrastrong topologies are better-behaved than the
weak and strong operator topologies, but their definitions are more
complicated, so they are usually not used unless their better properties are
really needed. For example, the dual space of $\mathcal{B(H)}$ in the weak
or strong operator topology is too small to have much analytic content.

\item The adjoint map is not continuous in the strong operator and
ultrastrong topologies, while the strong$\ast $ and ultrastrong$\ast $
topologies are modifications so that the adjoint becomes continuous. They
are not used very often.

\item The Arens--Mackey topology and the weak Banach space topology are
relatively rarely used.

\item To summarize, the three essential topologies on $\mathcal{B(H)}$ are
the norm, ultrastrong, and ultraweak topologies. The weak and strong
operator topologies are widely used as convenient approximations to the
ultraweak and ultrastrong topologies. The other topologies are relatively
obscure.
\end{enumerate}

