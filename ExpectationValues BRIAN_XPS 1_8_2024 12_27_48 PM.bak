\begin{definition}
Let $f\in \mathcal{S}\left( \mathcal{A}\right) \subset \mathcal{A}^{d}$ then
define the possibly unbounded linear functional $\limfunc{Tr}\nolimits_{f}$ 
\begin{equation}
\limfunc{Tr}\nolimits_{f}:\mathcal{A}\rightarrow \mathbb{C}
\end{equation}%
by%
\begin{equation}
\limfunc{Tr}\nolimits_{f}\left\{ A\right\} =\sum_{0\leq m\leq r}\sum_{1\leq
j_{1}<\cdots <j_{m}\leq 2r}\left\langle \left. \Phi _{f}\left( \widetilde{x}%
_{j_{1}}\cdots \widetilde{x}_{j_{m}}\right) \right\vert \Pi _{f}\left(
A\right) \Phi _{f}\left( \widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{m}}\right) \right\rangle _{\Phi _{f}\left( \mathcal{A}\right) },
\end{equation}%
which is equivalent to 
\begin{equation}
\limfunc{Tr}\nolimits_{f}\left\{ A\right\} =\sum_{0\leq m\leq r}\sum_{1\leq
j_{1}<\cdots <j_{m}\leq 2r}f\left( \left( \widetilde{x}_{j_{1}}\cdots 
\widetilde{x}_{j_{m}}\right) ^{\dagger }A\widetilde{x}_{j_{1}}\cdots 
\widetilde{x}_{j_{m}}\right) =\sum_{0\leq m\leq r}\sum_{1\leq j_{1}<\cdots
<j_{m}\leq 2r}f\left( \widetilde{x}_{j_{m}}\cdots \widetilde{x}_{j_{1}}A%
\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{m}}\right) .
\end{equation}
\end{definition}

\begin{lemma}
$\limfunc{Tr}\nolimits_{f}\in \mathcal{A}^{d}$ $\limfunc{Iff}$ $\Pi
_{f}\left( A\right) \in \mathcal{B}_{1}\left( \Phi _{f}\left( \mathcal{A}%
\right) \right) .$
\end{lemma}

\begin{theorem}
R. T.Moore: $\mathcal{S}\left( \mathcal{A}\right) $ generate $\mathcal{A}%
^{d} $ as every element of $\mathcal{A}^{d}$ is a linear combination of $4$
elements of $\mathcal{S}\left( \mathcal{A}\right) .$
\end{theorem}

\begin{theorem}
For \emph{any state} $f\in \mathcal{S}\left( \mathcal{A}\right) \subset 
\mathcal{A}^{d}$%
\begin{equation}
\limfunc{Tr}\nolimits_{f}\left\{ I_{\mathcal{A}}\right\} =\sum_{0\leq m\leq
r}\sum_{1\leq j_{1}<\cdots <j_{m}\leq 2r}f\left( \widetilde{x}_{j_{m}}\cdots 
\widetilde{x}_{j_{1}}I_{\mathcal{A}}\widetilde{x}_{j_{1}}\cdots \widetilde{x}%
_{j_{m}}\right) =\sum_{0\leq m\leq r}\sum_{1\leq j_{1}<\cdots <j_{m}\leq
2r}1=\sum_{0\leq m\leq r}\binom{2r}{m}=2^{2r},
\end{equation}%
where $\left\{ \left. \widetilde{x}_{j_{1}}\right\vert 1\leq j_{1}\leq
2r\right\} $ is a set of linearly independent of self adjoint idempotents 
\begin{equation}
\widetilde{x}_{j_{1}}^{2}=I_{\mathcal{A}},\,1\leq j_{1}\leq 2r
\end{equation}%
that generate $\mathcal{A}.$
\end{theorem}

$\lceil $%
\begin{gather}
r=0\rightarrow \limfunc{Tr}\nolimits_{f}\left\{ I_{\mathcal{A}}\right\} =1 \\
r=1\rightarrow \limfunc{Tr}\nolimits_{f}\left\{ I_{\mathcal{A}}\right\}
=\sum_{0\leq m\leq 1}\sum_{1\leq j_{1}<\cdots <j_{m}\leq 2}f\left(
x_{j_{m}}\cdots x_{j_{1}}x_{j_{1}}\cdots x_{j_{m}}\right) =\sum_{0\leq m\leq
1}\left( 1+\sum_{1\leq j_{1}\leq 2}f\left( x_{j_{1}}x_{j_{1}}\right) \right)
=1+\frac{1}{2}\binom{2}{1}=2 \\
r=2\rightarrow \limfunc{Tr}\nolimits_{f}\left\{ I_{\mathcal{A}}\right\}
=\sum_{0\leq m\leq 2}\sum_{1\leq j_{1}<\cdots <j_{m}\leq 4}f\left(
x_{j_{m}}\cdots x_{j_{1}}x_{j_{1}}\cdots x_{j_{m}}\right) =1+\sum_{1\leq
j_{1}\leq 4}f\left( x_{j_{1}}x_{j_{1}}\right) +\sum_{1\leq j_{1}<j_{2}\leq
4}f\left( x_{j_{2}}x_{j_{1}}x_{j_{1}}x_{j_{2}}\right) =1+\frac{1}{2}\binom{4%
}{1}+\frac{1}{4}\binom{4}{2}=\frac{7}{2} \\
r=3\rightarrow \limfunc{Tr}\nolimits_{f}\left\{ I_{\mathcal{A}}\right\}
=\sum_{0\leq m\leq 3}\sum_{1\leq j_{1}<\cdots <j_{m}\leq 6}f\left(
x_{j_{m}}\cdots x_{j_{1}}x_{j_{1}}\cdots x_{j_{m}}\right) =1+\sum_{1\leq
j_{1}\leq 6}f\left( x_{j_{1}}x_{j_{1}}\right) +\sum_{1\leq j_{1}<j_{2}\leq
6}f\left( x_{j_{2}}x_{j_{1}}x_{j_{1}}x_{j_{2}}\right) +\sum_{1\leq
j_{1}<j_{2}<j_{3}\leq 6}f\left(
x_{j_{3}}x_{j_{2}}x_{j_{1}}x_{j_{1}}x_{j_{2}}x_{j_{3}}\right) \\
=1\binom{6}{0}+\frac{1}{2}\binom{6}{1}+\frac{1}{4}\binom{6}{2}+\frac{1}{8}%
\binom{6}{3}= \\
\vdots \\
\limfunc{Tr}\nolimits_{f}\left\{ I_{\mathcal{A}}\right\} =\sum_{0\leq m\leq
r}\frac{1}{2^{m}}\binom{2r}{m},
\end{gather}%
which converges as 
\begin{equation}
\frac{\frac{1}{2^{m+1}}\binom{2r}{m+1}}{\frac{1}{2^{m}}\binom{2r}{m}}=\frac{%
2^{m}}{2^{m+1}}\frac{\binom{2r}{m+1}}{\binom{2r}{m}}=\frac{1}{2}\frac{\frac{%
2r!}{\left( 2r-m-1\right) !\left( m+1\right) !}}{\frac{2r!}{\left(
2r-m\right) !\left( m\right) !}}=\frac{1}{2}\frac{\left( 2r-m\right) !\left(
m\right) !}{\left( 2r-m-1\right) !\left( m+1\right) !}=\frac{1}{2\left(
2r-m-1\right) }.
\end{equation}

