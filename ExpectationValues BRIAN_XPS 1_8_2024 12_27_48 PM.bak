_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) }_{22} \\
&=&\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }_{1}\right)
\right) ^{\dagger }=\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi 
}_{1}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{11}+\mathfrak{s}\left( \boldsymbol{%
\varphi }_{1}\right) \overline{\mathfrak{R}_{\left( \boldsymbol{\varphi }%
_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) }_{21}\right)
^{\dagger } \\
&=&\mathfrak{s}\left( \boldsymbol{\varphi }_{1}\right) \overline{\mathfrak{R}%
_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) }_{11}+\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }%
_{1}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{21}
\end{eqnarray}%
and

\item 
\begin{equation}
\mathfrak{s}\left( \boldsymbol{\psi }_{1}\right) =\mathfrak{s}^{\dagger
}\left( \boldsymbol{\varphi }_{1}\right) \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{12}+%
\mathfrak{s}\left( \boldsymbol{\varphi }_{1}\right) \overline{\mathfrak{R}%
_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left(
T\right) }_{22}
\end{equation}%
hence

\item 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{12}=\mathfrak{R}_{\left( \boldsymbol{\varphi }%
_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{21}
\end{equation}%
and 
\begin{equation}
\overline{\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi 
}_{1}\right) }\left( T\right) }_{11}=\overline{\mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) }%
_{22}
\end{equation}%
thus 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{12} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{12} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{21} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{11}%
\end{array}%
\right)
\end{equation}%
and the structure of $\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},%
\boldsymbol{\varphi }_{1}\right) }\left( T_{\mathcal{A}_{1}}\right) $ and $%
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) $ that produce CAR's are 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T_{\mathcal{A}_{1}}\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) _{12} \\ 
\overline{\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi 
}_{1}\right) }\left( T\right) }_{12} & \overline{\mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) }%
_{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{11} & \overline{\mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) }%
_{21} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{1}\right) }\left( T\right) _{21} & \overline{\mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{1}\right) }\left( T\right) }%
_{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
U & \overline{V} \\ 
V & \overline{U}%
\end{array}%
\right) .
\end{equation}

\item $\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) $ induces $\mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T_{\mathcal{A}%
_{1}}\right) .$
\end{enumerate}
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
As $\Upsilon $ is sesquilinear on $\mathfrak{H}_{\mathbb{C}}=\mathfrak{%
H\oplus }_{\mathbb{C}}\mathfrak{H\subset H\times H}$ one has for conbs $%
\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq r\right\} $ and $\left\{
\left. \psi _{j}\right\vert 1\leq j\leq r\right\} $ of $\mathfrak{H}$ that 
\begin{equation}
\Upsilon \left( f,g\right) =\Upsilon \left( f\oplus _{\mathbb{C}}g\right) =%
\mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left( g\right) =%
\mathfrak{s}^{\dagger }\left( \sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}%
_{\varphi }\left( f\right) _{j}\right) +\mathfrak{s}\left( \sum_{1\leq j\leq
r}\psi _{j}\mathcal{R}_{\psi }\left( g\right) _{j}\right) =\sum_{1\leq j\leq
r}\mathfrak{s}^{\dagger }\left( \varphi _{j}\right) \mathcal{R}_{\varphi
}\left( f\right) _{j}+\sum_{1\leq j\leq r}\mathfrak{s}\left( \psi
_{j}\right) \overline{\mathcal{R}_{\psi }\left( g\right) }_{j}
\end{equation}%
giving for $T\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{C}}\right) $ that 
\begin{eqnarray}
\Upsilon \left( T\left( f,g\right) \right) &=&\Upsilon \left( T\left(
f\oplus _{\mathbb{C}}g\right) \right) =\mathfrak{s}^{\dagger }\left( T\left(
f\right) \right) +\mathfrak{s}\left( T\left( g\right) \right) =\mathfrak{s}%
^{\dagger }\left( T\left( \sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}%
_{\varphi }\left( f\right) _{j}\right) \right) +\mathfrak{s}\left( T\left(
\sum_{1\leq j\leq r}\psi _{j}\mathcal{R}_{\psi }\left( g\right) _{j}\right)
\right) =\sum_{1\leq j\leq r}\mathfrak{s}^{\dagger }\left( T\varphi
_{j}\right) \mathcal{R}_{\varphi }\left( f\right) _{j}+\sum_{1\leq j\leq r}%
\mathfrak{s}\left( T\psi _{j}\right) \overline{\mathcal{R}_{\psi }\left(
g\right) }_{j} \\
&=&\mathfrak{s}^{\dagger }\left( T\left( \sum_{1\leq j\leq r}\varphi _{j}%
\mathcal{R}_{\varphi }\left( f\right) _{j}\right) \right) +\mathfrak{s}%
\left( T\left( \sum_{1\leq j\leq r}\psi _{j}\mathcal{R}_{\psi }\left(
g\right) _{j}\right) \right) =\sum_{1\leq j,k\leq r}\mathfrak{s}^{\dagger
}\left( \varphi _{k}\right) \mathcal{R}_{\varphi }\left( T\right) _{kj}%
\mathcal{R}_{\varphi }\left( f\right) _{j}+\sum_{1\leq j,k\leq r}\mathfrak{s}%
\left( \psi _{k}\right) \overline{\mathcal{R}_{\psi }\left( T\right) }_{kj}%
\overline{\mathcal{R}_{\psi }\left( g\right) }_{j}.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\Upsilon _{d}\left( T\left( f,f\right) \right) =\sum_{1\leq j\leq r}%
\mathfrak{s}^{\dagger }\left( T\varphi _{j}\right) \mathcal{R}_{\varphi
}\left( f\right) _{j}+\sum_{1\leq j\leq r}\mathfrak{s}\left( T\varphi
_{j}\right) \overline{\mathcal{R}_{\varphi }\left( f\right) }%
_{j}=\sum_{1\leq j\leq r}\mathfrak{s}^{\dagger }\left( \varphi _{k}\right) 
\mathcal{R}_{\varphi }\left( T\right) _{kj}\mathcal{R}_{\varphi }\left(
f\right) _{j}+\sum_{1\leq j\leq r}\mathfrak{s}\left( \varphi _{k}\right) 
\overline{\mathcal{R}_{\varphi }\left( T\right) }_{kj}\overline{\mathcal{R}%
_{\varphi }\left( f\right) }_{j}
\end{equation}

\item 
\begin{eqnarray}
\Upsilon _{d}\left( T\left( \boldsymbol{\varphi },\boldsymbol{\varphi }%
\right) \right) &=&\Upsilon _{d}\left( \left( T\boldsymbol{\varphi },T%
\boldsymbol{\varphi }\right) \right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( T\boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( T\boldsymbol{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( T\right) _{11} & \mathfrak{R}_{\varphi }\left(
T\right) _{12} \\ 
\overline{\mathfrak{R}_{\varphi }\left( T\right) }_{21} & \overline{%
\mathfrak{R}_{\varphi }\left( T\right) _{22}}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( T\right) _{11} & \mathcal{R}_{\varphi }\left(
T\right) _{12} \\ 
\overline{\mathcal{R}_{\varphi }\left( T\right) }_{21} & \overline{\mathcal{R%
}_{\varphi }\left( T\right) }_{22}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }\right) & \mathfrak{s}\left( 
\boldsymbol{\psi }\right)%
\end{array}%
\right) .
\end{eqnarray}

\item 
\begin{equation}
T\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
T\boldsymbol{\varphi } & T\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( T\right) _{11} & \mathfrak{R}_{\varphi }\left(
T\right) _{12} \\ 
\mathfrak{R}_{\varphi }\left( T\right) _{12} & \mathfrak{R}_{\varphi }\left(
T\right) _{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\psi } & \boldsymbol{\psi }%
\end{array}%
\right)
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{eqnarray}
C\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( C\right) _{11} & \overline{\mathfrak{R}%
_{\varphi }\left( C\right) _{12}} \\ 
\mathfrak{R}_{\varphi }\left( C\right) _{21} & \overline{\mathfrak{R}%
_{\varphi }\left( C\right) _{22}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U} & \overline{\mathbb{V}} \\ 
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }\right) & \mathfrak{s}\left( 
\boldsymbol{\psi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( T\boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( T\boldsymbol{\varphi }\right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( T\right) _{11} & \mathfrak{R}_{\varphi }\left(
T\right) _{12} \\ 
\overline{\mathfrak{R}_{\varphi }\left( T\right) }_{21} & \overline{%
\mathfrak{R}_{\varphi }\left( T\right) _{22}}%
\end{array}%
\right)
\end{eqnarray}%
\begin{equation}
\left( 
\begin{array}{cc}
\boldsymbol{\psi } & \boldsymbol{\psi }%
\end{array}%
\right) =T\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
T\boldsymbol{\varphi } & T\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \mathfrak{R}_{\varphi \varphi }\left( T\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( T\right) _{11} & \mathfrak{R}_{\varphi }\left(
T\right) _{12} \\ 
\mathfrak{R}_{\varphi }\left( T\right) _{21} & \mathfrak{R}_{\varphi }\left(
T\right) _{22}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( T\right) _{11} & \mathfrak{R}_{\varphi }\left(
T\right) _{12} \\ 
\mathfrak{R}_{\varphi }\left( T\right) _{12} & \mathfrak{R}_{\varphi }\left(
T\right) _{11}%
\end{array}%
\right)
\end{equation}%
\begin{equation}
\left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( C\right) _{11} & \overline{\mathfrak{R}%
_{\varphi }\left( C\right) _{21}} \\ 
\mathfrak{R}_{\varphi }\left( C\right) _{21} & \overline{\mathfrak{R}%
_{\varphi }\left( C\right) _{11}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi }\left( T\right) _{11} & \mathfrak{R}_{\varphi }\left(
T\right) _{12} \\ 
\overline{\mathfrak{R}_{\varphi }\left( T\right) }_{21} & \overline{%
\mathfrak{R}_{\varphi }\left( T\right) _{22}}%
\end{array}%
\right)
\end{equation}%
\begin{eqnarray}
\mathfrak{R}_{\varphi }\left( C\right) _{11} &=&\mathfrak{R}_{\varphi
}\left( T\right) _{11} \\
\mathfrak{R}_{\varphi }\left( C\right) _{21} &=&\overline{\mathfrak{R}%
_{\varphi }\left( T\right) }_{21} \\
\overline{\mathfrak{R}_{\varphi }\left( C\right) _{21}} &=&\mathfrak{R}%
_{\varphi }\left( T\right) _{12} \\
\overline{\mathfrak{R}_{\varphi }\left( C\right) _{11}} &=&\overline{%
\mathfrak{R}_{\varphi }\left( T\right) _{22}}
\end{eqnarray}%
In order for $T$ to induce a canonical transformation

\begin{enumerate}
\item 
\begin{eqnarray}
\mathfrak{R}_{\varphi }\left( T\right) _{22} &=&\mathfrak{R}_{\varphi
}\left( T\right) _{11} \\
\mathfrak{R}_{\varphi }\left( T\right) _{12} &=&\mathfrak{R}_{\varphi
}\left( T\right) _{21}
\end{eqnarray}

\item 
\begin{equation}
\mathfrak{R}_{\varphi }\left( T\right) =\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( T\right) _{11} & \mathcal{R}_{\varphi }\left(
T\right) _{21} \\ 
\mathcal{R}_{\varphi }\left( T\right) _{21} & \mathcal{R}_{\varphi }\left(
T\right) _{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{V} \\ 
\mathbb{V} & \mathbb{U}%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right)
}\left( T_{\mathcal{A}_{1}}\right) =\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( T\right) _{11} & \overline{\mathcal{R}_{\varphi
}\left( T\right) }_{21} \\ 
\mathcal{R}_{\varphi }\left( T\right) _{21} & \overline{\mathcal{R}_{\varphi
}\left( T\right) }_{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{V} \\ 
\mathbb{V} & \mathbb{U}%
\end{array}%
\right)
\end{equation}
\end{enumerate}
\end{remark}

\begin{lemma}
If 
\begin{equation}
\Upsilon _{d}\left( \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right)
\end{equation}%
then 
\begin{equation}
\mathcal{R}_{\varphi }\left( T\right) =\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( T\right) _{11} & \mathcal{R}_{\varphi }\left(
T\right) _{21} \\ 
\mathcal{R}_{\varphi }\left( T\right) _{21} & \mathcal{R}_{\varphi }\left(
T\right) _{11}%
\end{array}%
\right)
\end{equation}%
and%
\begin{equation}
\mathcal{R}_{\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right)
}\left( T_{\mathcal{A}_{1}}\right) =\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( T\right) _{11} & \overline{\mathcal{R}_{\varphi
}\left( T\right) }_{21} \\ 
\mathcal{R}_{\varphi }\left( T\right) _{21} & \overline{\mathcal{R}_{\varphi
}\left( T\right) }_{11}%
\end{array}%
\right)
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
\mathfrak{s}\left( T\varphi _{j}\right) =\left( \mathfrak{s}^{\dagger
}\left( T\varphi _{j}\right) \right) ^{\dagger }
\end{equation}%
and 
\begin{equation}
\mathfrak{s}^{\dagger }\left( T\varphi _{j}\right) =\sum_{1\leq j,k\leq r}%
\mathfrak{s}^{\dagger }\left( \varphi _{k}\right) \mathcal{R}_{\varphi
}\left( T\right) _{kj}
\end{equation}%
giving 
\begin{equation}
\mathfrak{s}\left( T\varphi _{j}\right) =\left( \mathfrak{s}^{\dagger
}\left( T\varphi _{j}\right) \right) ^{\dagger }=\left( \sum_{1\leq j,k\leq
r}\mathfrak{s}^{\dagger }\left( \varphi _{k}\right) \mathcal{R}_{\varphi
}\left( T\right) _{kj}\right) ^{\dagger }=\sum_{1\leq j,k\leq r}\mathfrak{s}%
\left( \varphi _{k}\right) \overline{\mathcal{R}_{\varphi }\left( T\right)
_{kj}}
\end{equation}
\end{proof}

\begin{remark}
$\mathcal{M}$ is not a canonical map (obviously as it changes second
quantized operators to Majorano opertators)%
\begin{eqnarray}
\mathfrak{R}_{\mathfrak{s}^{\dagger }\left( \varphi \right) }\left( \mathcal{%
M}\right) &=&\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \\
\mathfrak{R}_{\varphi }\left( \mathcal{M}\right) &=&\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & iI_{\mathfrak{H}}%
\end{array}%
\right) .
\end{eqnarray}
\end{remark}

\begin{remark}
The real linear diagonal map%
\begin{equation}
\Upsilon _{d}:\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}\rightarrow 
\mathcal{A}
\end{equation}%
can be modified into a complex linear map 
\begin{equation}
\Upsilon _{d\sigma _{\varphi }}:\mathfrak{H}\oplus _{\mathbb{C}}\sigma
_{\varphi }\left( \mathfrak{H}\right) \rightarrow \mathcal{A}
\end{equation}%
defined by 
\begin{equation}
\Upsilon _{d\sigma _{\varphi }}\left( f\,\right) =\Upsilon \left( f\,,\sigma
_{\varphi }\left( f\right) \right) =\mathfrak{s}^{\dagger }\left( f\right) +%
\mathfrak{s}\left( \sigma _{\varphi }\left( f\right) \right) =\Omega
_{\sigma _{\varphi }}\left( f,0\right) +\Omega _{\sigma _{\varphi }}\left(
0,\sigma _{\varphi }\left( f\right) \right)
\end{equation}%
but does not in general produce self adjoint operators as%
\begin{equation}
\left( \mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left( \sigma
_{\varphi }\left( f\right) \right) \right) ^{\dagger }\neq \mathfrak{s}%
^{\dagger }\left( f\right) +\mathfrak{s}\left( \sigma _{\varphi }\left(
f\right) \right) \text{ unless }\func{Re}_{\varphi }\left( f\right) =f.
\end{equation}
\end{remark}

\begin{remark}
As $\mathcal{A}$ is a $c^{\ast }$-algebra the $\left\Vert {}\right\Vert _{%
\mathcal{A}}$-closure of all complex sums of elements of $\mathcal{A}$ is $%
\mathcal{A}.$
\end{remark}

\begin{remark}
Recall that the Hilbert space $\mathfrak{H}$ is anti isomorphic to its dual $%
\mathfrak{H}^{d}$ through the anti isomorphism $\digamma _{\left\vert
{}\right\rangle }$ i.e. 
\begin{equation}
\mathfrak{H}^{d}=\digamma _{\left\vert {}\right\rangle }\left\{ \mathfrak{H}%
\right\} .
\end{equation}
\end{remark}

\begin{remark}
If $\mathfrak{H}$ is a \emph{seperable} complex Hilbert space then the
introduction of any countable basis $\left\{ \mathbf{\varphi }\right\} $
produces an isomorphism 
\begin{equation}
\mathfrak{H}\cong l^{2}\left( \mathbb{C}\right) ,
\end{equation}%
through the expansion of $f$ wrt the basis $\left\{ \mathbf{\varphi }%
\right\} $ i.e. 
\begin{equation}
f=\sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\varphi }\left( f\right)
_{j}=\left( \mathbf{\varphi }\right) \mathcal{R}_{\varphi }\left( f\right)
=\left( \mathbf{\varphi }\right) \left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( f\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\varphi }\left( f\right) _{r}%
\end{array}%
\right)
\end{equation}%
and the isomorphism $\mathcal{R}_{\varphi }$ $\equiv \mathcal{R}_{\left\vert
\varphi \right\rangle }$ 
\begin{equation}
\mathcal{R}_{\varphi }:\mathfrak{H}\rightarrow l^{2}\left( \mathbb{C}\right)
\end{equation}%
is 
\begin{equation}
\mathcal{R}_{\varphi }\left( f\right) =\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( f\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{\varphi }\left( f\right) _{r}%
\end{array}%
\right) \in l^{2}\left( \mathbb{C}\right) .
\end{equation}
\end{remark}

\begin{remark}
$\mathcal{R}_{\varphi }$ is a linear representation of $\mathfrak{H}.$
\end{remark}

\begin{definition}
The antilinear isomorphisms $\mathcal{R}_{\left\langle \varphi \right\vert }$
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }:\mathfrak{H}\rightarrow 
\overline{l^{2}\left( \mathbb{C}\right) }
\end{equation}%
is defined by 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }\left( f\right) =\overline{%
\mathcal{R}_{\varphi }\left( f\right) }=\left( 
\begin{array}{c}
\overline{\mathcal{R}_{\varphi }\left( f\right) _{1}} \\ 
\vdots \\ 
\overline{\mathcal{R}_{\varphi }\left( f\right) _{r}}%
\end{array}%
\right) \in \overline{l^{2}\left( \mathbb{C}\right) }
\end{equation}%
and gives the complex conjugate representation.
\end{definition}

\begin{definition}
The linear isomorphisms $\mathcal{R}_{\left\langle \varphi \right\vert }$ 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }:\mathfrak{H}^{d}\rightarrow 
\overline{l^{2}\left( \mathbb{C}\right) }
\end{equation}%
is defined by 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }\left( \left\langle
f\right\vert \right) =\overline{\mathcal{R}_{\varphi }\left( f\right) }%
=\left( 
\begin{array}{c}
\overline{\mathcal{R}_{\varphi }\left( f\right) _{1}} \\ 
\vdots \\ 
\overline{\mathcal{R}_{\varphi }\left( f\right) _{r}}%
\end{array}%
\right) \in \overline{l^{2}\left( \mathbb{C}\right) }.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\digamma _{\left\vert {}\right\rangle }\left( f\right) =\left\langle
f\right\vert =\left\langle \sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}%
_{\left\vert \varphi \right\rangle }\left( f\right) _{j}\right\vert
=\sum_{1\leq j\leq r}\left\langle \varphi _{j}\right\vert \overline{\mathcal{%
R}_{\left\vert \varphi \right\rangle }\left( f\right) _{j}}=\left\langle
\sum_{1\leq j\leq r}\psi _{j}\mathcal{R}_{\left\vert \psi \right\rangle
}\left( f\right) _{j}\right\vert =\sum_{1\leq j\leq r}\left\langle \psi
_{j}\right\vert \overline{\mathcal{R}_{\left\vert \psi \right\rangle }\left(
f\right) _{j}}
\end{equation}%
thus 
\begin{equation}
\digamma _{\left\vert {}\right\rangle }:\mathfrak{H\rightarrow H}^{d}
\end{equation}%
is basis independent.
\end{lemma}

\begin{definition}
The complex conjugate $\overline{\mathcal{R}_{\varphi }}$ of the $\mathcal{R}%
_{\varphi }$ representation of $\mathfrak{H}$ is given by 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }\left( f\right) =\mathcal{R}%
_{\varphi }\left( \digamma _{\left\vert {}\right\rangle }\left( f\right)
\right) =\overline{\mathcal{R}_{\varphi }\left( f\right) }=\overline{%
\mathcal{R}_{\varphi }}\left( f\right) \equiv \overline{\mathcal{R}%
_{\left\vert \varphi \right\rangle }}\left( f\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }\left( f\right) =\overline{%
\mathcal{R}_{\left\vert \varphi \right\rangle }}\left( f\right) \equiv 
\overline{\mathcal{R}_{\left\vert \varphi \right\rangle }}\left( f\right) .
\end{equation}
\end{definition}

\begin{remark}
This shows that

\begin{enumerate}
\item $\mathcal{R}_{\left\langle \varphi \right\vert }$ is an antilinear
representation of $\mathfrak{H}$ 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }:\mathfrak{H}\rightarrow 
\overline{l^{2}\left( \mathbb{C}\right) }
\end{equation}%
and hence $\mathfrak{H}$ is anti isomorphic to $\overline{l^{2}\left( 
\mathbb{C}\right) }$

and

\item $\mathcal{R}_{\left\langle \varphi \right\vert }$ is a linear
representation of $\mathfrak{H}^{d}$ 
\begin{equation}
\mathcal{R}_{\left\langle \varphi \right\vert }:\mathfrak{H}^{d}\rightarrow 
\overline{l^{2}\left( \mathbb{C}\right) }
\end{equation}%
and hence $\mathfrak{H}^{d}$ is isomorphic to $\overline{l^{2}\left( \mathbb{%
C}\right) }.$
\end{enumerate}
\end{remark}

\begin{remark}
The isomorphisms $\mathcal{R}_{\left\vert \varphi \right\rangle }$ and $%
\mathcal{R}_{\left\langle \varphi \right\vert }$ give 
\begin{equation}
\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}^{d}\cong l^{2}\left( \mathbb{C}%
\right) {\large \,\oplus }_{\mathbb{C}}\,\overline{l^{2}\left( \mathbb{C}%
\right) }
\end{equation}
\end{remark}

\begin{remark}
$v\in l^{2}\left( \mathbb{C}\right) $ $\limfunc{Iff}$ $\overline{v}\in
l^{2}\left( \mathbb{C}\right) $ hence 
\begin{equation}
\overline{l^{2}\left( \mathbb{C}\right) }=l^{2}\left( \mathbb{C}\right) .
\end{equation}
\end{remark}

\begin{remark}
Unlike the Hilbert space $l^{2}\left( \mathbb{C}\right) $ the Hilbert space $%
\mathfrak{H}$ does not have a single complex conjugate but rather a family
of complex conjugates $\mathfrak{c}\left( \mathfrak{H}\right) =\left\{
\sigma _{\varphi }\left\{ \mathfrak{H}\right\} \right\} ,$ where $\mathfrak{c%
}\left( \mathfrak{H}\right) $ is the set of non equivalent conjugations of $%
\mathfrak{H}$ corresponding to classes of conbs that are not unitarily
equivalent to each other via real orthogonal transformations i.e. by
transformations $\in O\left( \mathfrak{H},\mathbb{R}\right) $ $\subset
U\left( \mathfrak{H}\right) .$
\end{remark}

\begin{definition}
\begin{equation}
\mathfrak{H}\cong \sigma _{\varphi }\left\{ \mathfrak{H}\right\} \cong
l^{2}\left( \mathbb{C}\right) \cong \overline{l^{2}\left( \mathbb{C}\right) }%
.
\end{equation}
\end{definition}

\begin{notation}
When $\mathcal{A}$ is equipped with the Filtration generated by $\left\{
\left. \mathcal{A}_{mn}^{CAR}\right\vert 0\leq m\leq r,\,0\leq n\leq
r\right\} $ it is denoted by $\mathcal{A}^{CAR}.$
\end{notation}

\begin{definition}
$\left( \text{again}\right) $Let $\mathfrak{H}$ be a \emph{seperable complex}
Hilbert space, with conb's $\left\{ \left. \varphi _{j}\right\vert 1\leq
j\leq r\right\} $ and $\mathfrak{s}^{\dagger }$ a $\mathbb{C}$-\underline{%
linear map} into a \emph{Filtered} (\ref{Filtered}) algebra $\mathcal{A}%
^{CAR}$ (the algebra $\mathcal{A}$ with filtering/gradation structure
induced by the ordered form of polynomials of $\left\{ \mathfrak{s}\left(
f\right) ,\mathfrak{s}\left( g\right) ^{\dagger }\right\} ,$ $f\in \mathfrak{%
H}$) equipped with a $c^{\ast }$-algebra norm $\left\Vert {}\right\Vert _{%
\mathcal{A}},$ then $\mathfrak{s}^{\dagger }$ is a \emph{CAR Algebra }$%
\mathfrak{H}$-\emph{representation} 
\begin{equation}
\mathfrak{s}^{\dagger }:\mathfrak{H}\rightarrow \mathcal{A}%
_{10}^{CAR}\subset \mathcal{A}^{CAR}=\bigoplus\limits_{0\leq m,n\leq r}%
\mathcal{A}_{mn}^{CAR}
\end{equation}%
if

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}^{\dagger }\left(
g\right) +\mathfrak{s}^{\dagger }\left( g\right) \mathfrak{s}^{\dagger
}\left( f\right) =\left\{ \mathfrak{s}^{\dagger }\left( f\right) ,\mathfrak{s%
}^{\dagger }\left( g\right) \right\} =0
\end{equation}%
and

\item 
\begin{equation}
\left\{ \mathfrak{s}\left( f\right) ,\mathfrak{s}\left( g\right) ^{\dagger
}\right\} =\mathfrak{s}\left( f\right) \mathfrak{s}\left( g\right) ^{\dagger
}+\mathfrak{s}\left( g\right) ^{\dagger }\mathfrak{s}\left( f\right)
=\left\langle f\left\vert g\right. \right\rangle _{\mathfrak{H}}I_{\mathcal{A%
}},
\end{equation}%
where $\mathfrak{s}$ is the anti linear map 
\begin{equation}
\mathfrak{s}:\mathfrak{H}\rightarrow \mathcal{A}_{01}^{CAR}\subset \mathcal{A%
}
\end{equation}%
defined by%
\begin{equation}
\mathfrak{s}\left( f\right) =\left( \mathfrak{s}^{\dagger }\left( f\right)
\right) ^{\dagger }.
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
\begin{equation}
\mathfrak{s:\sigma }_{\varphi }\left( \mathfrak{H}\right) \rightarrow 
\mathcal{A}_{01}^{CAR}
\end{equation}%
is a $\mathbb{C}$-linear map, when $\mathfrak{\sigma }_{\varphi }$ is a
conjugation of $\mathfrak{H.}$
\end{lemma}

\begin{remark}
\begin{enumerate}
\item $\mathfrak{s}$ is complex anti linear on $\mathfrak{H}$ i.e. 
\begin{equation}
\mathfrak{s}\left( i\varphi \right) =-i\mathfrak{s}\left( \varphi \right)
\end{equation}

\item $\mathfrak{s\circ \sigma }_{\varphi }$ is complex linear on $\mathfrak{%
H}$ i.e. 
\begin{equation}
\mathfrak{s\circ \sigma }_{\varphi }\left( i\varphi \right) =\mathfrak{s}%
\left( \mathfrak{\sigma }_{\varphi }\left( i\varphi \right) \right) =%
\mathfrak{s}\left( -i\mathfrak{\sigma }_{\varphi }\left( \varphi \right)
\right) =i\mathfrak{s}\left( \mathfrak{\sigma }_{\varphi }\left( \varphi
\right) \right)
\end{equation}

\item $\mathfrak{s}^{\dagger }$ is complex linear on $\mathfrak{H}$ i.e. 
\begin{equation}
\mathfrak{s}^{\dagger }\left( i\varphi \right) =i\mathfrak{s}^{\dagger
}\left( \varphi \right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{definition}
The $\mathfrak{H}$-basis dependent creation operators $\left\{ \left.
a_{j}^{\dagger }\right\vert 1\leq j\leq r\right\} $ are defined as 
\begin{equation}
a_{j}^{\dagger }=\mathfrak{s}^{\dagger }\left( \varphi _{j}\right) ,\quad
1\leq j\leq r.
\end{equation}
\end{definition}

\begin{definition}
Subspaces $\mathcal{A}_{mn}^{Cliff}$ 
\begin{equation}
\mathcal{A}_{mn}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{X}\left( \varphi _{j_{1}}\right) \cdots \mathfrak{X}\left( \varphi
_{j_{m}}\right) \mathfrak{X}\left( i\varphi _{k_{1}}\right) \cdots \mathfrak{%
X}\left( i\varphi _{k_{n}}\right) \right\vert 1\leq j_{1}\,<\cdots
<j_{m}\leq r,1\leq k_{1}<\cdots <k_{n}\leq r,\,0\leq m\leq r,\,0\leq n\leq
r\right\} .
\end{equation}
\end{definition}

\begin{definition}
\begin{equation}
\mathcal{A}_{n}^{Cliff}=\bigoplus\limits_{p+q=n}\mathcal{A}%
_{pq}^{Cliff},\,\,0\leq p,q\leq r.
\end{equation}
\end{definition}

\begin{remark}
\begin{align}
\mathcal{A}_{1}^{Cliff}\wedge \mathcal{A}_{1}^{Cliff}& =\left( \mathcal{A}%
_{10}^{Cliff}\oplus \mathcal{A}_{01}^{Cliff}\right) \wedge \left( \mathcal{A}%
_{10}^{Cliff}\oplus \mathcal{A}_{01}^{Cliff}\right) =\left( \mathcal{A}%
_{10}^{Cliff}+\mathcal{A}_{01}^{Cliff}\right) \wedge \left( \mathcal{A}%
_{10}^{Cliff}+\mathcal{A}_{01}^{Cliff}\right) \\
& =\mathcal{A}_{10}^{Cliff}\wedge \mathcal{A}_{10}^{Cliff}+\mathcal{A}%
_{10}^{Cliff}\wedge \mathcal{A}_{01}^{Cliff}+\mathcal{A}_{01}^{Cliff}\wedge 
\mathcal{A}_{10}^{Cliff}+\mathcal{A}_{01}^{Cliff}\wedge \mathcal{A}%
_{01}^{Cliff} \\
& =\mathcal{A}_{10}^{Cliff}\wedge \mathcal{A}_{10}^{Cliff}+\mathcal{A}%
_{10}^{Cliff}\wedge \mathcal{A}_{01}^{Cliff}+\mathcal{A}_{01}^{Cliff}\wedge 
\mathcal{A}_{01}^{Cliff} \\
& =\mathcal{A}_{10}^{Cliff}\wedge \mathcal{A}_{10}^{Cliff}\oplus \mathcal{A}%
_{10}^{Cliff}\wedge \mathcal{A}_{01}^{Cliff}\oplus \mathcal{A}%
_{01}^{Cliff}\wedge \mathcal{A}_{01}^{Cliff}
\end{align}%
as 
\begin{equation}
\mathcal{A}_{10}^{Cliff}\wedge \mathcal{A}_{01}^{Cliff}=\mathcal{A}%
_{01}^{Cliff}\wedge \mathcal{A}_{10}^{Cliff},
\end{equation}%
which is shown by 
\begin{equation}
\left( x_{1}\oplus y_{1}\right) \wedge \left( x_{2}\oplus y_{2}\right)
=x_{1}\wedge x_{2}+\left[ x_{1}\wedge y_{2}+y_{1}\wedge x_{2}\right]
+y_{1}\wedge y_{2}.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\bigwedge\nolimits^{2r}\left( \mathcal{A}_{1}^{Cliff}\right) =\mathcal{A}%
_{10}^{Cliff}\overset{r}{\overbrace{\wedge \cdots \wedge }}\mathcal{A}%
_{10}^{Cliff}\wedge \mathcal{A}_{01}^{Cliff}\overset{r}{\overbrace{\wedge
\cdots \wedge }}\mathcal{A}_{01}^{Cliff}=\mathcal{A}_{01}^{Cliff}\overset{r}{%
\overbrace{\wedge \cdots \wedge }}\mathcal{A}_{01}^{Cliff}\wedge \mathcal{A}%
_{10}^{Cliff}\overset{r}{\overbrace{\wedge \cdots \wedge }}\mathcal{A}%
_{10}^{Cliff}
\end{equation}
\end{remark}

\begin{notation}
The algebra $\mathcal{A}$ equipped with the Filtration generated by $\left\{
\left. \mathcal{A}_{mn}^{Cliff}\right\vert 0\leq m\leq r,\,0\leq n\leq
r\right\} $ is denoted by $\mathcal{A}^{Cliff}.$
\end{notation}

\begin{example}
Consider the indexing 
\begin{equation}
\left( m,n\right) =\left[ \left( 0,0\right) \right] ,\left[ \left(
1,0\right) \left( 0,1\right) \right] ,\left[ \left( 2,0\right) ,\left(
1,1\right) ,\left( 0,2\right) \right] ,\left[ \left( 3,0\right) ,\left(
2,1\right) ,\left( 1,2\right) ,\left( 0,3\right) \right] ,\left[ \left(
4,0\right) ,\left( 3,1\right) ,\left( 2,2\right) ,\left( 1,3\right) ,\left(
0,4\right) \right]
\end{equation}%
then 
\begin{eqnarray}
\mathcal{A}_{1}^{Cliff} &=&\mathcal{A}_{10}^{Cliff}\oplus \mathcal{A}%
_{01}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{X}%
\left( \varphi _{j_{1}}\right) ,\mathfrak{X}\left( i\varphi _{k_{1}}\right)
\right\vert 1\leq j_{1}\,\leq r,1\leq k_{1}\,\leq r\right\} \\
\mathcal{A}_{2}^{Cliff} &=&\mathcal{A}_{20}^{Cliff}\oplus \mathcal{A}%
_{11}^{Cliff}\oplus \mathcal{A}_{02}^{Cliff}=\mathbb{C}\text{-}\limfunc{%
linspan}\left\{ \left. \mathfrak{X}\left( \varphi _{j_{1}}\right) \mathfrak{X%
}\left( \varphi _{j_{2}}\right) ,\mathfrak{X}\left( \varphi _{j_{1}}\right) 
\mathfrak{X}\left( i\varphi _{k_{1}}\right) ,\mathfrak{X}\left( i\varphi
_{k_{1}}\right) \mathfrak{X}\left( i\varphi _{k_{2}}\right) \right\vert
1\leq j_{1}\,<j_{2}\leq r,1\leq k_{1}\,<k_{2}\leq r\right\} \\
\mathcal{A}_{3}^{Cliff} &=&\mathcal{A}_{30}^{Cliff}\oplus \mathcal{A}%
_{21}^{Cliff}\oplus \mathcal{A}_{12}^{Cliff}\oplus \mathcal{A}_{03}^{Cliff}=%
\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{X}\left( \varphi
_{j_{1}}\right) \mathfrak{X}\left( \varphi _{j_{2}}\right) \mathfrak{X}%
\left( \varphi _{j_{3}}\right) ,\mathfrak{X}\left( \varphi _{j_{1}}\right) 
\mathfrak{X}\left( \varphi _{j_{2}}\right) \mathfrak{X}\left( i\varphi
_{k_{1}}\right) ,\mathfrak{X}\left( \varphi _{j_{1}}\right) \mathfrak{X}%
\left( i\varphi _{k_{1}}\right) \mathfrak{X}\left( i\varphi _{k_{2}}\right) ,%
\mathfrak{X}\left( i\varphi _{k_{1}}\right) \mathfrak{X}\left( i\varphi
_{k_{2}}\right) \mathfrak{X}\left( i\varphi _{k_{3}}\right) \right\vert
\right. \\
&&\left. 1\leq j_{1}\,<j_{2}<j_{3}\leq r,1\leq k_{1}\,<k_{2}<k_{3}\leq
r\right\} \\
\mathcal{A}_{4}^{Cliff} &=&\mathcal{A}_{40}^{Cliff}\oplus \mathcal{A}%
_{31}^{Cliff}\oplus \mathcal{A}_{22}^{Cliff}\oplus \mathcal{A}%
_{13}^{Cliff}\oplus \mathcal{A}_{04}^{Cliff} \\
&=&\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{X}\left(
\varphi _{j_{1}}\right) \mathfrak{X}\left( \varphi _{j_{2}}\right) \mathfrak{%
X}\left( \varphi _{j_{3}}\right) ,\mathfrak{X}\left( \varphi _{j_{1}}\right) 
\mathfrak{X}\left( \varphi _{j_{2}}\right) \mathfrak{X}\left( i\varphi
_{k_{1}}\right) ,\mathfrak{X}\left( \varphi _{j_{1}}\right) \mathfrak{X}%
\left( i\varphi _{k_{1}}\right) \mathfrak{X}\left( i\varphi _{k_{2}}\right) ,%
\mathfrak{X}\left( i\varphi _{k_{1}}\right) \mathfrak{X}\left( i\varphi
_{k_{2}}\right) \mathfrak{X}\left( i\varphi _{k_{2}}\right) \right\vert
\right. \\
&&\left. 1\leq j_{1}\,<j_{2}<j_{3}<j_{4}\leq r,1\leq
k_{1}\,<k_{2}<k_{3}<k_{4}\leq r\right\} .
\end{eqnarray}
\end{example}

\begin{lemma}
\begin{equation}
\mathcal{A}_{nn}^{Cliff}=\tbigwedge\nolimits^{n}\mathcal{A}%
_{11}^{Cliff},\,0\leq n\leq r\,\equiv \mathcal{A}_{n}^{Cliff}=\tbigwedge%
\nolimits^{n}\mathcal{A}_{1}^{Cliff},\,0\leq n\leq r\,.
\end{equation}
\end{lemma}

\begin{remark}
The direct sum expansions of $\mathcal{A}$

\begin{enumerate}
\item 
\begin{equation}
\mathcal{A}^{Cliff}=\bigwedge \left( \mathcal{A}_{1}^{Cliff}\right)
=\bigoplus\limits_{0\leq n\leq 2r}\mathcal{A}_{n}^{Cliff}==\bigoplus%
\limits_{0\leq m.n\leq r}\mathcal{A}_{mn}^{Cliff}
\end{equation}%
and

\item 
\begin{equation}
\mathcal{A}^{CAR}=\tbigoplus\limits_{0\leq m.n\leq r}\mathcal{A}_{mn}^{CAR}
\end{equation}%
demonstrate the \emph{different} filterations of $\mathcal{A=A}^{Cliff}=%
\mathcal{A}^{CAR}.$
\end{enumerate}
\end{remark}

\begin{definition}
The map $\mathcal{M\in B}\left( \mathcal{A}_{1}^{Cliff}\right) $ can be
extended to the map $\boxtimes \left( \mathcal{M}\right) \in \mathcal{B}%
\left( \mathcal{A}^{Cliff}\right) ,$ where 
\begin{equation}
\mathcal{A}^{Cliff}=\tbigwedge \left( \mathcal{A}_{1}^{Cliff}\right) =%
\mathcal{A}^{CAR}=\mathcal{A}
\end{equation}%
by the usual definition of $\boxtimes \left( \mathcal{M}\right) $ in the
category of exterior algebras.
\end{definition}

\begin{remark}
$\mathcal{M}\in \mathcal{U}\left( \mathcal{A}_{1}^{Cliff}\right) $ and $%
\boxtimes \left( \mathcal{M}\right) \in \mathcal{U}\left( \mathcal{A}\right)
.$
\end{remark}

\begin{remark}
$\mathfrak{X}$ is the diagonal restriction of $\Upsilon $ i.e. 
\begin{equation}
\mathfrak{X}\left( f\right) =\frac{1}{\sqrt{2}}\Upsilon \left( f,f\right)
\end{equation}%
and conversely $\mathfrak{\Upsilon }$ is the off diagonal generalization of $%
\mathfrak{X}$%
\begin{equation}
\mathfrak{\Upsilon }:\mathfrak{H}\oplus \mathfrak{H}\rightarrow \mathcal{A}
\end{equation}%
given by 
\begin{equation}
\mathfrak{\Upsilon }\left( f,g\right) =\mathfrak{s}^{\dagger }\left(
f\right) +\mathfrak{s}\left( g\right) .
\end{equation}
\end{remark}

\begin{remark}
Recall%
\begin{equation}
\mathfrak{X}\left( if\right) =\mathfrak{\Upsilon }\left( if,if\right) =\frac{%
1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( if\right) +\mathfrak{s}%
\left( if\right) \right) =\frac{1}{\sqrt{2}}\left( i\mathfrak{s}^{\dagger
}\left( f\right) -i\mathfrak{s}\left( f\right) \right) =\frac{i}{\sqrt{2}}%
\left( \mathfrak{s}^{\dagger }\left( f\right) -\mathfrak{s}\left( f\right)
\right)
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{A}_{1}^{CAR}=\mathcal{A}_{10}^{CAR}+\mathcal{A}_{01}^{CAR}=\mathcal{%
A}_{10}^{CAR}\oplus \mathcal{A}_{01}^{CAR}=\mathcal{A}_{10}^{Cliff}\oplus 
\mathcal{A}_{01}^{Cliff}=\mathcal{A}_{10}^{Cliff}+\mathcal{A}_{01}^{Cliff}=%
\mathcal{A}_{1}^{Cliff}
\end{equation}
\end{remark}

\begin{remark}
The inverse transformation $\mathcal{M}^{-1}\in \mathcal{B}\left( \mathcal{A}%
_{1}^{CAR}\right) =\mathcal{B}\left( \mathcal{A}_{1}^{Cliff}\right) $ is
given by 
\begin{equation}
\mathfrak{X}\left( f\right) -i\mathfrak{X}\left( if\right) =\frac{1}{\sqrt{2}%
}\left( \mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left( f\right)
\right) +\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( f\right) -%
\mathfrak{s}\left( f\right) \right) =\frac{2}{\sqrt{2}}\mathfrak{s}^{\dagger
}\left( f\right) =\sqrt{2}\mathfrak{s}^{\dagger }\left( f\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{X}\left( f\right) +i\mathfrak{X}\left( if\right) =\frac{1}{\sqrt{2}%
}\left( \mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left( f\right)
\right) -\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( f\right) -%
\mathfrak{s}\left( f\right) \right) =\frac{2}{\sqrt{2}}\mathfrak{s}\left(
f\right) =\sqrt{2}\mathfrak{s}\left( f\right)
\end{equation}%
hence 
\begin{equation}
\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( f\right) & \mathfrak{s}\left( f\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\left( \mathfrak{X}\left( f\right) -i\mathfrak{X}\left(
if\right) \right) & \frac{1}{\sqrt{2}}\left( \mathfrak{X}\left( f\right) +i%
\mathfrak{X}\left( if\right) \right)%
\end{array}%
\right) =\mathcal{M}^{-1}\left( 
\begin{array}{cc}
\mathfrak{X}\left( f\right) & \mathfrak{X}\left( if\right)%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{definition}
$\left[ \boxtimes \left( \mathfrak{X}\right) \right] \in \mathcal{B}_{%
\mathbb{R}}\left( \mathcal{A}^{Cliff},\tbigwedge \left( \mathfrak{H}\right)
\right) $%
\begin{gather}
\left[ \boxtimes \left( \mathfrak{X}\right) \right] \left( \varphi
_{j_{1}}\wedge \cdots \wedge \varphi _{j_{m}}\wedge i\varphi _{k_{1}}\wedge
\cdots \wedge i\varphi _{k_{n}}\right) =\mathfrak{X}\left( \varphi
_{j_{1}}\right) \cdots \mathfrak{X}\left( \varphi _{j_{m}}\right) \mathfrak{X%
}\left( i\varphi _{k_{1}}\right) \cdots \mathfrak{X}\left( i\varphi
_{k_{n}}\right) , \\
\,1\leq j_{1}\,<\cdots <j_{m}\leq r,1\leq k_{1}\,<\cdots <k_{n}\leq
r,\,0\leq m\leq r,\,0\leq n\leq r.
\end{gather}
\end{definition}

\begin{remark}
$\mathfrak{X}$ has to be real otherwise its range is not self adjoint
operators.
\end{remark}

\begin{remark}
$\mathcal{A}$ is a $c^{\ast }$-algebra with norm $\left\Vert {}\right\Vert _{%
\mathcal{A}}$ and can be expanded in terms of a self adjoint basis as 
\begin{equation}
\mathcal{A}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{X}%
\left( \varphi _{j_{1}}\right) \cdots \mathfrak{X}\left( \varphi
_{j_{m}}\right) \mathfrak{X}\left( i\varphi _{k_{1}}\right) \cdots \mathfrak{%
X}\left( i\varphi _{k_{n}}\right) \right\vert 1\leq j_{1}\,<\cdots
<j_{m}\leq r,1\leq k_{1}\,<\cdots <k_{n}\leq r,\,0\leq m\leq r,\,0\leq n\leq
r\right\} ,
\end{equation}%
where 
\begin{equation}
\left[ \boxtimes \left( \mathfrak{X}\right) \right] \left( \phi _{\mathfrak{H%
}}\right) =\left[ \boxtimes \left( \mathfrak{X}\right) \right] \left(
\varphi _{j_{0}}\right) =\left[ \boxtimes \left( \mathfrak{X}\right) \right]
\left( i\varphi _{j_{0}}\right) =\left[ \boxtimes \left( \mathfrak{X}\right) %
\right] \left( i\phi _{\mathfrak{H}}\right) =I_{\mathcal{A}}.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\boxtimes \left( \mathcal{M}\right) \in \mathcal{B}\left( \mathcal{A}%
^{Cliff}\right) =\mathcal{B}\left( \left[ \overset{}{\boxtimes \left( 
\mathfrak{X}\right) }\right] \left\{ \overset{}{\mathfrak{H}}\right\}
\right) ,
\end{equation}%
while%
\begin{equation}
\left[ \boxtimes \left( \mathfrak{X}\right) \right] \in \mathcal{B}_{\mathbb{%
R}}\left( \mathcal{A}^{Cliff},\mathfrak{H}\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left[ \boxtimes \left( \mathcal{M}\right) ^{-1}\left( \overset{}{\boxtimes
\left( \mathfrak{X}\right) }\right) \right] =\boxtimes \left( \mathfrak{s}%
^{\dagger }\right) :\mathfrak{H}\rightarrow \mathcal{A},
\end{equation}%
while%
\begin{equation}
\left[ \boxtimes \left( \mathcal{M}\right) \left( \overset{}{\boxtimes
\left( \mathfrak{s}^{\dagger }\right) }\right) \right] =\boxtimes \left( 
\mathfrak{X}\right) :\mathfrak{H}\rightarrow \mathcal{A}.
\end{equation}
\end{remark}

\begin{remark}
If $v\in \mathfrak{H}$ then 
\begin{equation}
v\wedge iv=0
\end{equation}%
as $v$ and $iv$ are $\mathbb{C}$-linearly \emph{dependent}, but their image
under $\boxtimes \left( \mathfrak{X}\right) $ are $\mathbb{C}$-linearly\emph{%
\ independent}.
\end{remark}

\begin{remark}
Any vector $v\in \mathfrak{H}$ can be expanded wrt a conb $\left( \mathbf{%
\varphi }\right) $ as 
\begin{align}
v& =\sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\mathcal{\varphi }}\left(
v\right) _{j} \\
& =\sum_{1\leq j\leq r}\varphi _{j}\left\{ \func{Re}\left( \mathcal{R}_{%
\mathcal{\varphi }}\left( v\right) _{j}\right) +i\func{Im}\left( \mathcal{R}%
_{\mathcal{\varphi }}\left( v\right) _{j}\right) \right\} \\
& =\sum_{1\leq j\leq r}\varphi _{j}\left\{ \mathcal{R}_{\mathcal{\varphi }%
}\left( \func{Re}_{\varphi }\left( v\right) \right) _{j}+i\mathcal{R}_{%
\mathcal{\varphi }}\left( \func{Im}_{\varphi }\left( v\right) \right)
_{j}\right\} \\
& =\sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\mathcal{\varphi }}\left( 
\func{Re}_{\varphi }\left( v\right) \right) _{j}+\sum_{1\leq j\leq
r}i\varphi _{j}\mathcal{R}_{\mathcal{\varphi }}\left( \func{Im}_{\varphi
}\left( v\right) \right) _{j} \\
& =\func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right)
.
\end{align}
\end{remark}

\begin{definition}
of the real and imaginary part maps $\func{Re}_{\varphi },\func{Im}_{\varphi
}\in \mathcal{B}_{\mathbb{R}}\left( \mathfrak{H}_{\mathbb{R}},\mathfrak{H}%
\right) $

\begin{enumerate}
\item The real Hilbert space $\mathfrak{H}_{\mathbb{R}}$ of dimension $2r$
is given 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
\varphi _{j},i\varphi _{j}\right\vert 1\leq j\leq r\right\} =\mathfrak{H}%
_{\varphi r}\oplus _{\mathbb{R}}\mathfrak{H}_{\varphi i}.
\end{equation}

\item 
\begin{equation}
\func{Re}_{\varphi }:\mathfrak{H}\rightarrow \mathfrak{H}_{\varphi r}\subset 
\mathfrak{H}_{\mathbb{R}}.
\end{equation}

\item 
\begin{equation}
\func{Im}_{\varphi }:\mathfrak{H}\rightarrow \mathfrak{H}_{\varphi i}\subset 
\mathfrak{H}_{\mathbb{R}}.
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{H}_{\varphi r}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
\varphi _{j}\right\vert 1\leq j\leq r\right\}
\end{equation}

\item 
\begin{equation}
\mathfrak{H}_{\varphi i}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
i\varphi _{j}\right\vert 1\leq j\leq r\right\} .
\end{equation}
\end{enumerate}
\end{enumerate}
\end{definition}

\begin{lemma}
\begin{equation}
\mathfrak{H=H}_{\varphi r}\oplus _{\mathbb{R}}\mathfrak{H}_{\varphi i}=%
\mathfrak{H}_{\varphi r}\,{\large +}_{\mathbb{R}}\,\,\mathfrak{H}_{\varphi
i}.
\end{equation}
\end{lemma}

\begin{proof}
\begin{enumerate}
\item Any vector $v\in \mathfrak{H}_{\varphi r}\oplus _{\mathbb{R}}i%
\mathfrak{H}_{\varphi i}$ can be expanded a 
\begin{equation}
\sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\mathcal{\varphi }}\left(
v_{1}\right) _{j}+\sum_{1\leq j\leq r}i\varphi _{j}\mathcal{R}_{\mathcal{%
\varphi }}\left( v_{2}\right) _{j}=\func{Re}_{\varphi }\left( v_{1}\right) +i%
\func{Im}_{\varphi }\left( v_{2}\right) ,
\end{equation}%
where $\mathcal{R}_{\mathcal{\varphi }}\left( v_{1}\right) ,\mathcal{R}_{%
\mathcal{\varphi }}\left( v_{2}\right) \in l^{2}\left( \mathbb{R}\right) $
and $v_{1}\in \mathfrak{H}_{\varphi r},\,v_{2}\in \mathfrak{H}_{\varphi i}.$

\item Any vector $v\in \mathfrak{H}_{\varphi r}\oplus _{\mathbb{R}}i%
\mathfrak{H}_{\varphi i}$ can be produced from vectors $v_{1}\in \mathfrak{h}%
_{1}\left( T\right) ,\,v_{2}\in \mathfrak{h}_{2}\left( T\right) $ and hence
vectors $\mathcal{R}_{\mathcal{\varphi }}\left( v_{1}\right) ,\mathcal{R}_{%
\mathcal{\varphi }}\left( v_{2}\right) \in l_{2}\left( \mathbb{R}\right) .$
\end{enumerate}
\end{proof}

\begin{definition}
\begin{eqnarray}
e_{j} &=&\func{Re}_{\varphi }\left( \varphi _{j}\right) \\
e_{j+r} &=&\func{Im}_{\varphi }\left( \varphi _{j}\right) \\
1 &\leq &j\leq r
\end{eqnarray}
\end{definition}

\begin{definition}
\begin{enumerate}
\item $\left( \mathbf{\varphi }\right) $%
\begin{equation}
\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq r\right\}
\end{equation}%
is a reference basis of $\mathfrak{H.}$

\item $\left( \mathbf{\varphi }_{1}\mathbf{,\varphi }_{2}\right) $%
\begin{equation}
\left\{ \left. \varphi _{1j},\varphi _{2j}\right\vert 1\leq j\leq r\right\}
\end{equation}%
is a reference basis of $\mathfrak{H}_{\mathbb{C}}\mathfrak{.}$

\item $\left( \mathbf{e}\right) $%
\begin{equation}
\left\{ \left. e_{j}\right\vert 1\leq j\leq 2r\right\}
\end{equation}%
is a reference basis of $\mathfrak{H}_{\mathbb{R}}.$
\end{enumerate}
\end{definition}

\begin{notation}
$T\in O\left( \mathfrak{H}_{\mathbb{R}}\right) \cong O\left( 2r,\mathbb{R}%
\right) .$
\end{notation}

\begin{remark}
$\mathfrak{H}_{\mathbb{R}}$ is a homogeneous manifold for $O\left( \mathfrak{%
H}_{\mathbb{R}}\right) .$
\end{remark}

\begin{definition}
The subgroup $\mathfrak{O}\left( \mathbf{e}\right) \subset $ $O\left( 
\mathfrak{H}_{\mathbb{R}}\right) $ associated with an conb $\left( \mathbf{e}%
\right) \ $of $\mathfrak{H}_{\mathbb{R}}$ of the orthogonal group $O\left( 
\mathfrak{H}_{\mathbb{R}}\right) $ is defined as 
\begin{equation}
\mathfrak{O}\left( \mathbf{e}\right) =\left\{ \left.
T_{jk}e_{k}=e_{j}\right\vert T\in O\left( \mathfrak{H}_{\mathbb{R}}\right)
,e_{j},e_{k}\in \left( \mathbf{e}\right) ,1\leq j,k\leq 2r\right\} .
\end{equation}
\end{definition}

\begin{lemma}
$\mathfrak{O}\left( \mathbf{e}\right) $ is a subgroup of $O\left( \mathfrak{H%
}_{\mathbb{R}}\right) $
\end{lemma}

\begin{proof}
\begin{enumerate}
\item $\mathfrak{O}\left( \mathbf{e}\right) $ is closed under multiplication
i.e. 
\begin{equation}
T_{j}T_{k}=T_{jk}\in \mathfrak{O}\left( e\right) .
\end{equation}%
as%
\begin{eqnarray}
T_{j}e_{1} &=&e_{j} \\
Te_{j} &=&e_{k}=TT_{j}e_{1}=T_{k}e_{1}.
\end{eqnarray}

\item If $T\in $ $\mathfrak{O}\left( \mathbf{e}\right) $ then $T^{-1}\in 
\mathfrak{O}\left( \mathbf{e}\right) $ as $TT^{-1}=I_{O\left( \mathfrak{H}_{%
\mathbb{R}}\right) }\in \mathfrak{O}\left( \mathbf{e}\right) $ and if 
\begin{equation}
T_{j}T_{k}=I_{O\left( \mathfrak{H}_{\mathbb{R}}\right) }
\end{equation}%
then $T_{k}=T_{j}^{-1}.$
\end{enumerate}
\end{proof}

\begin{lemma}
$\mathfrak{O}\left( t\mathbf{e}\right) =t^{-1}\mathfrak{O}\left( \mathbf{e}%
\right) t$ i.e. $\mathfrak{O}\left( t\mathbf{e}\right) $ the subgroups of $%
\mathfrak{O}\left( \mathbf{e}\right) $ and $\mathfrak{O}\left( t\mathbf{e}%
\right) $ are conjugate
\end{lemma}

\begin{proof}
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{O}\left( t\mathbf{e}\right) =\left\{ \left. S_{tj}\right\vert
1\leq j\leq 2r,S_{tj}\in O\left( \mathfrak{H}_{\mathbb{R}}\right) ,\left(
te_{j}\right) =S_{tj}\left( te_{1}\right) \right\}
\end{equation}

\item 
\begin{equation}
\mathfrak{O}\left( \mathbf{e}\right) =\left\{ \left. S_{j}\right\vert 1\leq
j\leq 2r,S_{j}\in O\left( \mathfrak{H}_{\mathbb{R}}\right)
,e_{j}=S_{j}e_{1}\right\}
\end{equation}

\item 
\begin{equation}
tS_{tj}t^{-1}te_{1}=te_{j}=S_{j}e\Longleftrightarrow tS_{tj}t^{-1}=S_{j}
\end{equation}%
thus

\item 
\begin{equation}
\mathfrak{O}\left( \mathbf{e}\right) =t\mathfrak{O}\left( t\mathbf{e}\right)
t^{-1}\Longleftrightarrow t^{-1}\mathfrak{O}\left( \mathbf{e}\right) t=%
\mathfrak{O}\left( te\right) .
\end{equation}
\end{enumerate}
\end{proof}

\begin{definition}
of the real Hilbert subspaces $\mathfrak{h}_{1}\left( T\right) $ and $%
\mathfrak{h}_{2}\left( T\right) $ of $\mathfrak{H}_{\mathbb{R}}$ 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{h}_{1}\left( T\right) \oplus _{_{\mathbb{%
R}}}\mathfrak{h}_{2}\left( T\right) ,\quad T\in O\left( \mathfrak{H}_{%
\mathbb{R}}\right)
\end{equation}%
when 
\begin{equation}
\dim \left\{ \mathfrak{h}_{1}\left( T\right) \right\} =\dim \left\{ 
\mathfrak{h}_{2}\left( T\right) \right\} =r
\end{equation}%
and hence 
\begin{equation}
\dim \left\{ \mathfrak{H}_{\mathbb{R}}\right\} =2r.
\end{equation}
\end{definition}

These subspaces can also be defined via

\begin{definition}
\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{h}_{1}\left( T\right) =\mathbb{R}\text{-}\limfunc{linspan}\left\{
\left. T_{j1}e_{1}\right\vert T_{j}\in O\left( \mathfrak{H}_{\mathbb{R}%
}\right) ,1\leq j\leq r\right\}
\end{equation}%
and

\item 
\begin{equation}
\mathfrak{h}_{2}\left( T\right) =\mathbb{R}\text{-}\limfunc{linspan}\left\{
\left. T_{j1}e_{1}\right\vert T_{j+r}\in O\left( \mathfrak{H}_{\mathbb{R}%
}\right) ,1\leq j\leq r\right\} .
\end{equation}
\end{enumerate}

\item 
\begin{equation}
\mathfrak{h}_{2}\left( T\right) =\mathfrak{H}_{\mathbb{R}}\ominus \mathfrak{h%
}_{1}\left( T\right) .
\end{equation}
\end{enumerate}
\end{definition}

\begin{notation}
\begin{equation}
\mathfrak{h}_{1}=\mathfrak{h}_{1}\left( I_{O\left( \mathfrak{H}_{\mathbb{R}%
}\right) }\right) .
\end{equation}
\end{notation}

\begin{definition}
Orbit of the standard basis of $\mathfrak{H}_{\mathbb{R}}$

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{O}_{\mathfrak{h}_{1}}\left( e\right) =\left\{ \left.
S_{j}\right\vert 1\leq j\leq r,S_{j}\in O\left( \mathfrak{H}_{\mathbb{R}%
}\right) ,e_{j}=S_{j}e_{1}\right\} .
\end{equation}

\item 
\begin{equation}
\mathfrak{O}_{\mathfrak{h}_{2}}\left( e\right) =\left\{ \left.
S_{j}\right\vert r+1\leq j\leq 2r,S_{j}\in O\left( \mathfrak{H}_{\mathbb{R}%
}\right) ,e_{j}=S_{j}e_{1}\right\} .
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
Let $\left\{ \left. S_{j}e_{1}\right\vert S_{j}\in O\left( \mathfrak{H}_{%
\mathbb{R}}\right) ,1\leq j\leq r\right\} $ be a conb of $\mathfrak{h}_{1}$
then $\left\{ \left. S_{j}\right\vert 1\leq j\leq r\right\} $ forms a
subgroup $O\left( \mathfrak{h}_{1}\right) \cong O\left( r,\mathbb{R}\right) $
of $O\left( \mathfrak{H}_{\mathbb{R}}\right) $.
\end{lemma}

\begin{proof}
\begin{equation}
\end{equation}
\end{proof}

\begin{lemma}
\begin{equation}
O\left( \mathfrak{h}_{1}\right) \cong O\left( r,\mathbb{R}\right) =\left\{
\left. t\right\vert t^{-1}\mathfrak{O}_{\mathfrak{h}_{1}}\left( e\right) t=%
\left[ \mathfrak{O}_{\mathfrak{h}_{1}}\left( e\right) \right] \left(
te\right) =\left[ \mathfrak{O}_{\mathfrak{h}_{1}}\left( e\right) \right]
\left( e\right) ,\,t\in O\left( \mathfrak{H}_{\mathbb{R}}\right) \right\} .
\end{equation}
\end{lemma}

\begin{lemma}
The coset 
\begin{equation}
O\left( \mathfrak{H}_{\mathbb{R}}\right) \left/ O\left( \mathfrak{h}%
_{1}\right) \right.
\end{equation}%
labels the distinct direct sum decompositions of $\mathfrak{H}_{\mathbb{R}}$
i.e. 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{h}_{1}\left( T\right) \oplus _{_{\mathbb{%
R}}}\mathfrak{h}_{2}\left( T\right) ,\quad T\in O\left( \mathfrak{H}_{%
\mathbb{R}}\right) \left/ O\left( \mathfrak{h}_{1}\right) \right. .
\end{equation}
\end{lemma}

\begin{lemma}
$\mathfrak{H}$ is the complexification of $\mathfrak{h}_{1}\left( T\right) $
i.e.

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{H}=\left[ \mathcal{J}\left( T\right) \right] \left( \mathfrak{h}%
_{1}\left( T\right) \right)
\end{equation}

\item 
\begin{equation}
\mathfrak{H}=\mathfrak{h}_{1}\left( T\right) \otimes _{\mathbb{R}}\mathbb{C}=%
\mathfrak{h}_{1}\left( T\right) \otimes _{\mathbb{R}}\left( \mathbb{R}\oplus
i\mathbb{R}\right) .
\end{equation}
\end{enumerate}
\end{lemma}

\begin{remark}
\begin{equation}
\mathfrak{h}_{\mathbb{R}}=\mathfrak{h}_{1}\left( T\right) \oplus _{\mathbb{R}%
}J\left( T\right) \mathfrak{h}_{1}\left( T\right) =\mathfrak{h}_{1}\left(
T\right) +_{\mathbb{R}}J\left( T\right) \mathfrak{h}_{1}\left( T\right) ,
\end{equation}%
for a complex unit $J\left( T\right) \in \mathfrak{C}\left( \mathfrak{h}_{%
\mathbb{R}}\right) .$
\end{remark}

\begin{remark}
\begin{equation}
\mathfrak{H}=\left[ \mathcal{J}\left( T\right) \right] \left( \mathfrak{h}_{%
\mathbb{R}}\right) =\mathfrak{H}_{\varphi r}\oplus _{\mathbb{R}}i\mathfrak{H}%
_{\varphi r}=\left[ \mathcal{J}\left( T\right) \right] \left\{ \mathfrak{h}%
_{i}\left( T\right) \right\} \oplus _{\mathbb{R}}i\left[ \mathcal{J}\left(
T\right) \right] \left\{ \mathfrak{h}_{2}\left( T\right) \right\} ,
\end{equation}%
gives

\begin{enumerate}
\item 
\begin{equation}
\left[ \mathcal{J}\left( I_{O\left( \mathfrak{H}_{\mathbb{R}}\right)
}\right) \right] \left( e_{j}\right) =\varphi _{j},\quad 1\leq j\leq r
\end{equation}%
and

\item 
\begin{equation}
\left[ \mathcal{J}\left( I_{O\left( \mathfrak{H}_{\mathbb{R}}\right)
}\right) \right] \left( e_{j+r}\right) =i\varphi _{j},\quad 1\leq j\leq r.
\end{equation}
\end{enumerate}
\end{remark}

\begin{notation}
\begin{equation}
\varphi _{j}\equiv \varphi _{j}\left( e_{j}\right) ,\quad 1\leq j\leq r.
\end{equation}
\end{notation}

\begin{remark}
Thus for any $T\in O\left( \mathfrak{H}_{\mathbb{R}}\right) $

\begin{enumerate}
\item The \emph{complexifications} of $\mathfrak{H}_{\mathbb{R}}$ 
\begin{equation}
\mathcal{J}\left( T\right) :\mathfrak{h}_{\mathbb{R}}=\mathfrak{h}_{1}\left(
T\right) \oplus _{\mathbb{R}}J\left( T\right) \mathfrak{h}_{1}\left(
T\right) ---\longrightarrow \mathfrak{H}=\mathfrak{h}_{1}\left( T\right)
\oplus _{\mathbb{R}}i\mathfrak{h}_{1}\left( T\right)
\end{equation}

\item The \emph{realifications} of $\mathfrak{H}$ i.e. inverses of the
complexifications of $\mathfrak{H}$

\begin{enumerate}
\item 
\begin{equation}
\left[ \mathcal{J}^{-1}\left( T\right) \right] \left( iT\varphi _{j}\right) =%
\left[ iT\varphi _{j}\right] =Te_{j+r}\equiv Te_{j+r}\left( \varphi \right)
\end{equation}%
and

\item 
\begin{equation}
\left[ \mathcal{J}^{-1}\left( T\right) \right] \left( T\varphi _{j}\right) =%
\left[ T\varphi _{j}\right] =Te_{j}\equiv Te_{j}\left( \varphi \right)
\end{equation}
\end{enumerate}

\item The connection to the real and imaginary part maps $\func{Re}_{\varphi
\left( e\right) }$ and $\func{Im}_{\varphi \left( e\right) }$ wrt the basis $%
\left\{ \left. \varphi _{j}\left( e_{j}\right) \right\vert 1\leq j\leq
r\right\} $

\begin{enumerate}
\item 
\begin{equation}
\left[ \mathcal{J}\left( T\right) \right] \left\{ \mathfrak{h}_{\varphi
r}\right\} =\mathfrak{h}_{i}\left( T\right) \equiv \mathfrak{h}_{2}\left(
T\right) =\mathfrak{h}_{\mathbb{R}}\ominus \mathfrak{h}_{r}\left( T\right)
\end{equation}%
and%
\begin{equation}
\left[ \mathcal{J}\left( T\right) \right] \left\{ \mathfrak{h}_{\varphi
i}\right\} =\mathfrak{h}_{r}\left( T\right) \equiv \mathfrak{h}_{1}\left(
T\right) =\mathfrak{h}_{\mathbb{R}}\ominus \mathfrak{h}_{i}\left( T\right) .
\end{equation}
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{remark}
Complex units $J\left( T\right) $ and conjugations $\sigma \left( T\right) $
belonging to $\mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right) $ can be
expressed in terms of the partial isometries $\left\{ \left. \text{\ng }%
_{j}\left( T\right) \right\vert 1\leq j\leq r\right\} ,$\NG $_{\mathfrak{h}%
_{1}\left( T\right) }\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right) $

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) =\sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert =T\sum_{1\leq j\,\leq
r}\left\vert e_{j}\right) \left( e_{j+r}\right\vert T^{t}=\sum_{1\leq
j\,\leq r}\text{\ng }_{j}\left( T\right) ,\,T\in O\left( \mathfrak{h}_{%
\mathbb{R}}\right) .
\end{equation}

\item 
\begin{eqnarray}
J\left( T\right) &=&\text{\NG }_{\mathfrak{h}_{1}\left( T\right) }-\text{\NG 
}_{\mathfrak{h}_{1}\left( T\right) }^{t} \\
\sigma \left( T\right) &=&P_{\mathfrak{h}_{1}\left( T\right) }-P_{\mathfrak{h%
}_{2}\left( T\right) }.
\end{eqnarray}
\end{enumerate}

\item Commutation relationships

\begin{enumerate}
\item 
\begin{eqnarray}
J\left( T\right) P_{\mathfrak{h}_{1}\left( T\right) } &=&\sum_{1\leq j\,\leq
r}\left\{ \left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} \sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j}\right\vert =-\sum_{1\leq j\,\leq
r}\left\vert Te_{j+r}\right) \left( Te_{j}\right\vert =-\text{\NG }_{%
\mathfrak{h}_{1}\left( T\right) }^{t} \\
P_{\mathfrak{h}_{1}\left( T\right) }J\left( T\right) &=&\sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j}\right\vert \sum_{1\leq j\,\leq
r}\left\{ \left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} =\sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert =\text{\NG }_{%
\mathfrak{h}_{1}\left( T\right) } \\
J\left( T\right) P_{\mathfrak{h}_{2}\left( T\right) } &=&\sum_{1\leq j\,\leq
r}\left\{ \left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} \sum_{1\leq j\,\leq
r}\left\vert Te_{j+r}\right) \left( Te_{j+r}\right\vert =\sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert =\text{\NG }_{%
\mathfrak{h}_{1}\left( T\right) } \\
P_{\mathfrak{h}_{2}\left( T\right) }J\left( T\right) &=&\sum_{1\leq j\,\leq
r}\left\vert Te_{j+r}\right) \left( Te_{j+r}\right\vert \sum_{1\leq j\,\leq
r}\left\{ \left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} =-\sum_{1\leq j\,\leq
r}\left\vert Te_{j+r}\right) \left( Te_{j}\right\vert =-\text{\NG }_{%
\mathfrak{h}_{1}\left( T\right) }^{t}.
\end{eqnarray}

\item 
\begin{eqnarray}
\left\{ P_{\mathfrak{h}_{1}\left( T\right) },J\left( T\right) \right\} &=&%
\text{\NG }_{\mathfrak{h}_{1}\left( T\right) }-\text{\NG }_{\mathfrak{h}%
_{1}\left( T\right) }^{t} \\
\left\{ P_{\mathfrak{h}_{2}\left( T\right) },J\left( T\right) \right\} &=&%
\text{\NG }_{\mathfrak{h}_{1}\left( T\right) }^{t}-\text{\NG }_{\mathfrak{h}%
_{1}\left( T\right) } \\
\left\{ P_{\mathfrak{h}_{2}\left( T\right) },J\left( T\right) \right\}
&=&\left\{ P_{\mathfrak{h}_{1}\left( T\right) },J\left( T\right) \right\}
^{t}.
\end{eqnarray}

\item 
\begin{gather}
\sigma \left( T\right) J\left( T\right) =\left( P_{\mathfrak{h}_{1}\left(
T\right) }-P_{\mathfrak{h}_{2}\left( T\right) }\right) \sum_{1\leq j\,\leq
r}\left\{ \left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} \\
=P_{\mathfrak{h}_{1}\left( T\right) }\sum_{1\leq j\,\leq r}\left\{
\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} -P_{\mathfrak{h}_{\varphi
i}}\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right) \left(
Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left( Te_{j}\right\vert
\right\} =\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right) \left(
Te_{j+r}\right\vert +\left\vert Te_{j+r}\right) \left( Te_{j}\right\vert
\right\} \\
=\text{\NG }_{\mathfrak{h}_{1}\left( T\right) }+\text{\NG }_{\mathfrak{h}%
_{1}\left( T\right) }^{t} \\
J\left( T\right) \sigma \left( T\right) =\sum_{1\leq j\,\leq r}\left\{
\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} \left( P_{\mathfrak{h}%
_{1}\left( T\right) }-P_{\mathfrak{h}_{2}\left( T\right) }\right) \\
=\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right) \left(
Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left( Te_{j}\right\vert
\right\} P_{\mathfrak{h}_{1}\left( T\right) }-\left\{ \left\vert
Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left(
Te_{j}\right\vert \right\} P_{\mathfrak{h}_{2}\left( T\right) }=-\sum_{1\leq
j\,\leq r}\left\{ \left\vert Te_{j+r}\right) \left( Te_{j}\right\vert
+\left\vert Te_{j+r}\right) \left( Te_{j}\right\vert \right\} \\
=-\left( \text{\NG }_{\mathfrak{h}_{1}\left( T\right) }+\text{\NG }_{%
\mathfrak{h}_{1}\left( T\right) }^{t}\right) \\
\left\{ \sigma \left( T\right) ,J\left( T\right) \right\} =0
\end{gather}

\item 
\begin{gather}
\sigma \left( T\right) P_{\mathfrak{h}_{1}\left( T\right) }=\left( P_{%
\mathfrak{h}_{1}\left( T\right) }-P_{\mathfrak{h}_{2}\left( T\right)
}\right) P_{\mathfrak{h}_{1}\left( T\right) }=P_{\mathfrak{h}_{1}\left(
T\right) } \\
P_{\mathfrak{h}_{1}\left( T\right) }\sigma =P_{\mathfrak{h}_{1}\left(
T\right) }\left( P_{\mathfrak{h}_{1}\left( T\right) }-P_{\mathfrak{h}%
_{2}\left( T\right) }\right) =P_{\mathfrak{h}_{1}\left( T\right) } \\
\sigma P_{\mathfrak{h}_{2}\left( T\right) }=\left( P_{\mathfrak{h}_{1}\left(
T\right) }-P_{\mathfrak{h}_{2}\left( T\right) }\right) P_{\mathfrak{h}%
_{2}\left( T\right) }=-P_{\mathfrak{h}_{2}\left( T\right) } \\
P_{\mathfrak{h}_{2}\left( T\right) }\sigma =P_{\mathfrak{h}_{\varphi
i}}\left( P_{\mathfrak{h}_{1}\left( T\right) }-P_{\mathfrak{h}_{2}\left(
T\right) }\right) =-P_{\mathfrak{h}_{2}\left( T\right) } \\
\left[ \sigma \left( T\right) ,P_{\mathfrak{h}_{1}\left( T\right) }\right] =0
\\
\left[ \sigma \left( T\right) ,P_{\mathfrak{h}_{2}\left( T\right) }\right] =0
\end{gather}
\end{enumerate}
\end{enumerate}
\end{remark}

\begin{definition}
The involution $\sigma _{\varphi }\in \mathcal{B}_{anti}\left( \mathfrak{H}%
\right) \subset \mathcal{B}_{\mathbb{R}}\left( \mathfrak{H}\right) $ 
\begin{equation}
\sigma _{\varphi }^{2}=I_{\mathcal{A}}
\end{equation}%
by%
\begin{equation}
\sigma _{\varphi }\left( v\right) =\func{Re}_{\varphi }\left( v\right) -i%
\func{Im}_{\varphi }\left( v\right) ,
\end{equation}%
where $\left\vert \boldsymbol{\varphi }\right\rangle $ is a conb of $%
\mathfrak{H.}$
\end{definition}

\begin{lemma}
\begin{equation}
\sigma _{\varphi }\left( v\right) =v\text{ }\limfunc{Iff}\,v\in \text{ }%
\mathfrak{H}_{\varphi r}=\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\}
\end{equation}%
and%
\begin{equation}
\sigma _{\varphi }\left( v\right) =-v\text{ }\limfunc{Iff}\,v\in \mathfrak{H}%
_{\varphi i}=\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\}
\end{equation}%
hence 
\begin{equation}
\sigma _{\varphi }=P_{\mathfrak{H}_{\varphi r}}-P_{\mathfrak{H}_{\varphi i}}.
\end{equation}
\end{lemma}

\begin{remark}
$\mathfrak{H}_{\varphi r}$ and $\mathfrak{H}_{\varphi i}$ are eigen spaces
of $\sigma _{\varphi }$ associated with the eigenvalues $+1$ and $-1$
respectively.
\end{remark}

\begin{lemma}
The maps $\func{Re}_{\varphi },\func{Im}_{\varphi }$ are related to $\sigma
_{\varphi }$ by 
\begin{eqnarray}
\func{Re}_{\varphi }\left( v\right) &=&\frac{1}{2}\left( v+\sigma _{\varphi
}\left( v\right) \right) \\
\func{Im}_{\varphi }\left( v\right) &=&\frac{1}{2i}\left( v-\sigma _{\varphi
}\left( v\right) \right) \\
v &\in &\mathfrak{H}.
\end{eqnarray}%
Recall the
\end{lemma}

\begin{definition}
The real Hilbert spaces $\mathfrak{H}_{\sigma r}$,$\mathfrak{H}_{\sigma i}$

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{H}_{\sigma r}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
\varphi _{j}\right\vert 1\leq j\leq r\right\}
\end{equation}

\item 
\begin{equation}
\mathfrak{H}_{\sigma i}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
i\varphi _{j}\right\vert 1\leq j\leq r\right\} .
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
The real exterior algebra $\tbigwedge \left( \mathfrak{H}_{\sigma \mathbb{R}%
}\right) $ 
\begin{equation}
\tbigwedge \left( \mathfrak{H}_{\sigma \mathbb{R}}\right) =\tbigwedge \left( 
\overset{}{\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} \oplus _{\mathbb{%
R}}i\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} }\right) =\tbigwedge
\left( \overset{}{\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} \,{\Large %
+}_{\mathbb{R}}\,i\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} }\right) .
\end{equation}

\begin{remark}
The real Hilbert space $\mathfrak{H}_{\sigma \mathbb{R}}$ is the real
hilbert space $\mathfrak{H}_{\mathbb{R}}$ viewed with the specific direct
the sum decomposition 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\sigma \mathbb{R}}=\func{Re}%
_{\varphi }\left\{ \mathfrak{H}\right\} \oplus _{\mathbb{R}}i\func{Im}%
_{\varphi }\left\{ \mathfrak{H}\right\} =\func{Re}_{\varphi }\left\{ 
\mathfrak{H}\right\} \,{\Large +}_{\mathbb{R}}\,i\func{Im}_{\varphi }\left\{ 
\mathfrak{H}\right\} .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\tbigwedge \left( \overset{}{\func{Re}_{\varphi }\left\{ \mathfrak{H}%
\right\} \oplus _{\mathbb{R}}i\func{Im}_{\varphi }\left\{ \mathfrak{H}%
\right\} }\right) \cong \tbigwedge \left( \overset{}{\func{Re}_{\varphi
}\left\{ \mathfrak{H}\right\} }\right) \,\widehat{\otimes }_{\mathbb{R}%
}\,\tbigwedge \left( \overset{}{i\func{Im}_{\varphi }\left\{ \mathfrak{H}%
\right\} }\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{enumerate}
\item The vectors $v$,$iv\in \mathfrak{H}$ are $\mathbb{R}$-\emph{linearly
independent} i.e. 
\begin{equation}
c_{1}v+c_{2}iv=0,\quad c_{1},c_{2}\in \mathbb{R}
\end{equation}%
only has the solution 
\begin{equation}
c_{1}=c_{2}=0
\end{equation}%
hence

\item as elements of a real vector space 
\begin{equation}
v\wedge iv\neq 0.
\end{equation}
\end{enumerate}
\end{remark}
\end{definition}

\begin{definition}
of the real multilinear map $\boxtimes \left( \mathfrak{X}\right) $%
\begin{equation}
\boxtimes \left( \mathfrak{X}\right) :\tbigwedge \left( \mathfrak{H}_{\sigma 
\mathbb{R}}\right) \rightarrow \mathcal{A}
\end{equation}%
by%
\begin{equation}
\boxtimes \left( \mathfrak{X}\right) \left( \widetilde{\varphi }%
_{j_{1}}\wedge \cdots \wedge \widetilde{\varphi }_{j_{n}}\right) =\boxtimes
^{n}\left( \mathfrak{X}\right) \left( \widetilde{\varphi }_{j_{1}}\wedge
\cdots \wedge \widetilde{\varphi }_{j_{n}}\right) =\mathfrak{X}\left( 
\widetilde{\varphi }_{j_{1}}\right) \cdots \mathfrak{X}\left( \widetilde{%
\varphi }_{j_{n}}\right) ;\,0\leq n\leq 2r,\,1\leq j_{1}<\cdots <j_{n}\leq
2r,
\end{equation}%
where%
\begin{equation}
\widetilde{\varphi }_{j}=\left\{ 
\begin{array}{c}
\varphi _{j},\,1\leq j\leq r \\ 
i\varphi _{j},\,r+1\leq j\leq 2r%
\end{array}%
\right.
\end{equation}%
and 
\begin{equation}
\boxtimes \left( \mathfrak{X}\right) =\tbigoplus\limits_{0\leq n\leq
r}\boxtimes ^{n}\left( \mathfrak{X}\right) .
\end{equation}
\end{definition}

\begin{remark}
One should note that 
\begin{equation}
\mathcal{A}_{1}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{X}\left( \varphi _{j_{1}}\right) ,\mathfrak{X}\left( i\varphi
_{k_{1}}\right) \right\vert 1\leq j_{1}\,\leq r,1\leq k_{1}\,\leq r\right\}
\end{equation}%
even though the map $\mathfrak{X}$ is only a real map.
\end{remark}

\begin{remark}
$\mathfrak{X}$ and $\boxtimes \left( \mathfrak{X}\right) $ depend on the
direct sum decomposition of $\mathfrak{H}_{\mathbb{R}}$ determined by $%
J\left( T\right) $, $\sigma \left( T\right) $ for $T\in O\left( \mathfrak{H}%
_{\mathbb{R}}\right) .$
\end{remark}

\subparagraph{Complexifications of a Real Hilbert Space}

\begin{notation}
Let $\mathfrak{h}_{1}$ and $\mathfrak{h}_{2}$ be real Hilbert spaces of
dimension $r$ with conbs $\left\{ \left. e_{j}\right\vert 1\leq j\,\leq
r\right\} $ and $\left\{ \left. e_{j}\right\vert r+1\leq j\,\leq 2r\right\} $
respectively then we denote the real direct sum $\mathfrak{h}_{1}\oplus _{%
\mathbb{R}}\mathfrak{h}_{2}$ by $\mathfrak{h}_{\mathbb{R}}$ i.e. 
\begin{equation}
\mathfrak{h}_{\mathbb{R}}=\mathfrak{h}_{1}\oplus _{\mathbb{R}}\mathfrak{h}%
_{2}.
\end{equation}
\end{notation}

\begin{definition}
The orthogonal projectors 
\begin{equation}
P_{\mathfrak{h}_{1}}=\sum_{1\leq j\,\leq r}\left\vert e_{j}\right) \left(
e_{j}\right\vert =\sum_{1\leq j\,\leq r}p_{j}
\end{equation}%
and 
\begin{equation}
P_{\mathfrak{h}_{2}}=\sum_{1\leq j\,\leq r}\left\vert e_{j+r}\right) \left(
e_{j+r}\right\vert =\sum_{1\leq j\,\leq r}p_{j+r}
\end{equation}%
for a fixed basis standard $\left\vert \boldsymbol{e}\right) .$
\end{definition}

\begin{remark}
\begin{equation}
\mathfrak{h}_{1}=P_{\mathfrak{h}_{1}}\mathfrak{h}_{\mathbb{R}}
\end{equation}%
and 
\begin{equation}
\mathfrak{h}_{2}=P_{\mathfrak{h}_{2}}\mathfrak{h}_{\mathbb{R}}.
\end{equation}
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
I_{\mathfrak{h}_{\mathbb{R}}}=P_{\mathfrak{h}_{1}}+P_{\mathfrak{h}_{2}}.
\end{equation}

\item 
\begin{equation}
P_{\mathfrak{h}_{1}}P_{\mathfrak{h}_{2}}=0.
\end{equation}

\item 
\begin{eqnarray}
P_{\mathfrak{h}_{1}} &=&P_{\mathfrak{h}_{1}}^{t} \\
P_{\mathfrak{h}_{2}} &=&P_{\mathfrak{h}_{2}}^{t}.
\end{eqnarray}

\item 
\begin{equation}
p_{j}p_{k}=\delta _{jk}p_{j},\,1\leq j\,,k\leq 2r,
\end{equation}%
where 
\begin{equation}
p_{j}=\left\vert e_{j}\right) \left( e_{j}\right\vert ,\,1\leq j\,,k\leq 2r.
\end{equation}
\end{enumerate}
\end{remark}

\begin{definition}
The orthogonal group $O\left( \mathfrak{h}_{\mathbb{R}}\right) $ is defined
as 
\begin{equation}
O\left( \mathfrak{h}_{\mathbb{R}}\right) =\left\{ \left. T\in \mathcal{B}%
\left( \mathfrak{h}_{\mathbb{R}}\right) \right\vert \left\{ \left( \left.
Tv\right\vert Tw\right) =\left( \left. v\right\vert w\right) \,\forall
v,w\in \mathfrak{h}_{\mathbb{R}}\right\} \Leftrightarrow \left\{
TT^{t}=T^{t}T=I_{\mathfrak{h}_{\mathbb{R}}}\right\} \right\} .
\end{equation}
\end{definition}

\begin{definition}
The orthogonal subgroups$\left\{ \left. O\left( \mathfrak{h}_{j}\right)
\right\vert 1\leq j\leq 2\right\} $ are defined as 
\begin{equation}
O\left( \mathfrak{h}_{j}\right) =\left\{ \left. T\in \mathcal{B}\left( 
\mathfrak{h}_{j}\right) \right\vert \left\{ \left( \left. Tv\right\vert
Tw\right) =\left( \left. v\right\vert w\right) \,\forall v,w\in \mathfrak{h}%
_{j}\right\} \Leftrightarrow \left\{ TT^{t}=T^{t}T=I_{\mathfrak{h}%
_{j}}\right\} ,\,1\leq j\leq 2\right\} .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
O\left( \mathcal{T}\left\{ \mathfrak{h}_{1}\right\} \right) =O\left( 
\mathcal{T}\left\{ \mathfrak{h}_{2}\right\} \right) ,\,\mathcal{T}\in
O\left( \mathfrak{h}_{\mathbb{R}}\right) .
\end{equation}
\end{remark}

\begin{definition}
\begin{equation}
O\left( \mathfrak{h}_{j}\right) \times O\left( \mathfrak{h}_{k}\right)
=\left\{ \left. \left( g_{1},g_{2}\right) \right\vert g_{1}\in O\left( 
\mathfrak{h}_{j}\right) ,g_{2}\in O\left( \mathfrak{h}_{k}\right) ,\,\,1\leq
j\,,k\leq 2\right\} .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
O\left( \mathfrak{h}_{j}\right) \times O\left( \mathfrak{h}_{k}\right)
\subset O\left( \mathfrak{h}_{\mathbb{R}}\right) ,\,\,1\leq j\,,k\leq 2.
\end{equation}
\end{remark}

\begin{lemma}
\begin{equation}
O\left( \mathcal{T}\left\{ \mathfrak{h}_{j}\right\} \right) \times O\left( 
\mathcal{T}\left\{ \mathfrak{h}_{k}\right\} \right) =O\left( \mathfrak{h}%
_{1}\right) \times O\left( \mathfrak{h}_{1}\right) ,\,\,1\leq j\,,k\leq 2,\,%
\mathcal{T}\in O\left( \mathfrak{h}_{\mathbb{R}}\right) .
\end{equation}
\end{lemma}

\begin{lemma}
\begin{equation}
\mathfrak{R}_{\mathfrak{h}_{\mathbb{R}}}\left( O\left( \mathfrak{h}%
_{1}\right) \times O\left( \mathfrak{h}_{1}\right) \right) =\mathfrak{R}_{%
\mathfrak{h}_{1}}\left( O\left( \mathfrak{h}_{1}\right) \right) \oplus _{%
\mathbb{R}}\mathfrak{R}_{\mathfrak{h}_{2}}\left( O\left( \mathfrak{h}%
_{1}\right) \right) .
\end{equation}
\end{lemma}

\begin{lemma}
The subgroup $O\left( \mathfrak{h}_{1}\right) \times O\left( \mathfrak{h}%
_{1}\right) $ respects the direct sum decompositions $T\mathfrak{h}%
_{1}\oplus _{\mathbb{R}}T\mathfrak{h}_{2},\,T\in O\left( \mathfrak{h}_{%
\mathbb{R}}\right) ,$ i.e. 
\begin{equation}
O\left( \mathfrak{h}_{1}\right) \times O\left( \mathfrak{h}_{1}\right) :T%
\mathfrak{h}_{j}\rightarrow T\mathfrak{h}_{j},\,1\leq j\leq 2.
\end{equation}
\end{lemma}

\begin{definition}
Partial isometries 
\begin{equation}
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) =\sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert =T\sum_{1\leq j\,\leq
r}\left\vert e_{j}\right) \left( e_{j+r}\right\vert T^{t}=\sum_{1\leq
j\,\leq r}\text{\ng }_{j}\left( T\right) ,\,T\in O\left( \mathfrak{h}_{%
\mathbb{R}}\right) .
\end{equation}
\end{definition}

\begin{definition}
\begin{equation}
\text{\ng }_{j}\left( T\right) =\left\vert Te_{j}\right) \left(
Te_{j+r}\right\vert ,\quad 1\leq j\,\leq r,\,T\in O\left( \mathfrak{h}_{%
\mathbb{R}}\right) .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) =\sum_{1\leq j\,\leq r}\text{%
\ng }_{j}\left( T\right) ,\,T\in O\left( \mathfrak{h}_{\mathbb{R}}\right) .
\end{equation}
\end{remark}

\begin{remark}
For $T\in O\left( \mathfrak{h}_{\mathbb{R}}\right) $ and $1\leq j\,\leq r$ 
\begin{eqnarray}
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) \text{\NG }_{\mathfrak{h}%
_{1}}\left( T\right) ^{t} &=&P_{\mathfrak{h}_{1}}\left( T\right) \\
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) ^{t}\text{\NG }_{\mathfrak{h}%
_{1}}\left( T\right) &=&P_{\mathfrak{h}_{2}}\left( T\right)
\end{eqnarray}%
and%
\begin{eqnarray}
\text{\ng }_{j}\left( T\right) \text{\ng }_{j}\left( T\right) ^{t} &=&p_{%
\mathfrak{h}_{1}}\left( T\right) _{j} \\
\text{\ng }_{j}\left( T\right) ^{t}\text{\ng }_{j}\left( T\right) &=&p_{%
\mathfrak{h}_{1}}\left( T\right) _{j+r}.
\end{eqnarray}
\end{remark}

\begin{remark}
Partial isometries properties%
\begin{eqnarray}
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) \text{\NG }_{\mathfrak{h}%
_{1}}\left( T\right) ^{t} &=&T\sum_{1\leq j\,\leq r}\left\vert e_{j}\right)
\left( e_{j}\right\vert T^{t}=P_{\mathfrak{h}_{1}}\left( T\right) =TP_{%
\mathfrak{h}_{1}}T^{t} \\
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) ^{t}\text{\NG }_{\mathfrak{h}%
_{1}}\left( T\right) &=&T\sum_{1\leq j\,\leq r}\left\vert e_{j}+r\right)
\left( e_{j+r}\right\vert T^{t}=P_{\mathfrak{h}_{2}}\left( T\right) =TP_{%
\mathfrak{h}_{2}}T^{t}.
\end{eqnarray}
\end{remark}

\begin{remark}
One can generate all possible orthogonal direct sum decompositions by the
action of the orthogonal group $T\in O\left( \mathfrak{h}_{\mathbb{R}%
}\right) $ on reference projectors and partial isometries based on the conb $%
\left\vert \boldsymbol{e}\right) $ of $\mathfrak{h}_{\mathbb{R}}$ by

\begin{enumerate}
\item 
\begin{equation}
P_{\mathfrak{h}_{1}}\left( T\right) =\sum_{1\leq j\,\leq r}\left\vert
Te_{j}\right) \left( Te_{j}\right\vert =TP_{\mathfrak{h}_{1}}T^{t}=\widehat{T%
}\left( P_{\mathfrak{h}_{1}}\right) .
\end{equation}

\item 
\begin{equation}
P_{\mathfrak{h}_{2}}\left( T\right) =\sum_{1\leq j\,\leq r}\left\vert
Te_{j+r}\right) \left( Te_{j+r}\right\vert =TP_{\mathfrak{h}_{2}}T^{t}=%
\widehat{T}\left( P_{\mathfrak{h}_{2}}\right) .
\end{equation}

\item 
\begin{equation}
\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) =\sum_{1\leq j\,\leq
r}\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert =T\text{\NG }_{%
\mathfrak{h}_{1}}T^{t}=\widehat{T}\left( \text{\NG }_{\mathfrak{h}%
_{1}}\right) .
\end{equation}

\item 
\begin{equation}
P_{\mathfrak{h}_{1}}\left( T\right) +P_{\mathfrak{h}_{2}}\left( T\right) =I_{%
\mathfrak{h}_{\mathbb{R}}}
\end{equation}%
hence $P_{\mathfrak{h}_{1}}\left( T\right) $ determines $P_{\mathfrak{h}%
_{2}}\left( T\right) .$
\end{enumerate}
\end{remark}

\begin{remark}
\begin{eqnarray}
\mathfrak{h}_{1}\left( T\right) &=&P_{\mathfrak{h}_{1}}\left( T\right) 
\mathfrak{h}_{\mathbb{R}} \\
\mathfrak{h}_{2}\left( T\right) &=&P_{\mathfrak{h}_{2}}\left( T\right) 
\mathfrak{h}_{\mathbb{R}}
\end{eqnarray}%
giving%
\begin{equation}
\mathfrak{h}_{\mathbb{R}}=\mathfrak{h}_{1}\left( T\right) \oplus _{\mathbb{R}%
}\mathfrak{h}_{2}\left( T\right) =P_{\mathfrak{h}_{1}}\left( T\right) 
\mathfrak{h}_{\mathbb{R}}\oplus _{\mathbb{R}}P_{\mathfrak{h}_{2}}\left(
T\right) \mathfrak{h}_{\mathbb{R}}.
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
O\left( \mathfrak{h}_{1}\right) \times O\left( \mathfrak{h}_{1}\right) &:&P_{%
\mathfrak{h}_{1}}\left( T\right) \mathfrak{h}_{\mathbb{R}}\rightarrow P_{%
\mathfrak{h}_{1}}\left( T\right) \mathfrak{h}_{\mathbb{R}} \\
O\left( \mathfrak{h}_{1}\right) \times O\left( \mathfrak{h}_{1}\right) &:&P_{%
\mathfrak{h}_{2}}\left( T\right) \mathfrak{h}_{\mathbb{R}}\rightarrow P_{%
\mathfrak{h}_{2}}\left( T\right) \mathfrak{h}_{\mathbb{R}}
\end{eqnarray}%
hence distinct direct sum decompositions can be indexed by the coset 
\begin{equation}
\mathfrak{C}_{O\left( \mathfrak{h}_{\mathbb{R}}\right) }\left( O\left( 
\mathfrak{h}_{1}\right) \right) =O\left( \mathfrak{h}_{\mathbb{R}}\right)
\left/ \left( \overset{}{O\left( \mathfrak{h}_{1}\right) \times O\left( 
\mathfrak{h}_{1}\right) }\right) \right. .
\end{equation}
\end{remark}

\begin{definition}
Complex units $J\left( T\right) ,\,T\in O\left( \mathfrak{h}_{\mathbb{R}%
}\right) $

\begin{enumerate}
\item 
\begin{equation}
J\left( T\right) :T\mathfrak{h}_{1}\rightarrow T\mathfrak{h}_{2}.
\end{equation}

\item 
\begin{equation}
J\left( T\right) :T\mathfrak{h}_{1}\rightarrow T\mathfrak{h}_{2}.
\end{equation}

\item 
\begin{equation}
J\left( T\right) :T\mathfrak{h}_{1}\oplus _{\mathbb{R}}T\mathfrak{h}%
_{2}\rightarrow T\mathfrak{h}_{1}\oplus _{\mathbb{R}}T\mathfrak{h}_{2}.
\end{equation}%
where
\end{enumerate}
\end{definition}

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{h}_{\mathbb{R}}=T\mathfrak{h}_{1}\oplus _{\mathbb{R}}T\mathfrak{h}%
_{2},\,\forall T\in .
\end{equation}

\item 
\begin{equation}
J\left( T\right) ^{2}=-I_{\mathfrak{h}_{\mathbb{R}}}.
\end{equation}

\item 
\begin{equation}
J\left( T\right) =-J\left( T\right) ^{t}.
\end{equation}
\end{enumerate}

\begin{definition}
\begin{equation}
P_{\mathfrak{h}_{j}}\left( T\right) =TP_{\mathfrak{h}_{j}}T^{t}=\widehat{T}%
\left( P_{\mathfrak{h}_{j}}\right) ,1\leq j\leq 2.
\end{equation}
\end{definition}

\begin{definition}
The complex units $J\left( T_{1}\right) $ and $J\left( T_{2}\right) $ are
equivalent 
\begin{equation}
J\left( T_{1}\right) \sim J\left( T_{2}\right) \,\limfunc{Iff}\,P_{\mathfrak{%
h}_{1}}\left( T_{1}\right) \mathfrak{h}_{\mathbb{R}}\,=P_{\mathfrak{h}%
_{1}}\left( T_{2}\right) \mathfrak{h}_{\mathbb{R}}
\end{equation}
\end{definition}

\begin{lemma}
$J\left( T_{1}\right) \sim J\left( T_{2}\right) \,\limfunc{Iff}$ $%
T_{1}=tT_{2}t^{-1}$ where 
\begin{equation}
t\in O\left( \mathfrak{h}_{1}\right) \times O\left( \mathfrak{h}_{1}\right) .
\end{equation}
\end{lemma}

\begin{definition}
Using this equivalence relationship the set of all complex units $\mathfrak{C%
}\left( \mathfrak{h}_{\mathbb{R}}\right) =\left\{ \left. J\left( T\right)
\right\vert T\in O\left( \mathfrak{h}_{\mathbb{R}}\right) \right\} $ based
on the real Hilbert space $\mathfrak{h}_{\mathbb{R}}$ can be classified into
classes $\left[ \mathfrak{C}\left( \mathfrak{h}_{\mathbb{R}}\right) \right]
=\left\{ \left. \left[ J\left( T\right) \right] \right\vert T\in \left.
O\left( \mathfrak{h}_{\mathbb{R}}\right) \right/ \left( O\left( \mathfrak{h}%
_{1}\right) \times O\left( \mathfrak{h}_{1}\right) \right) =\mathfrak{C}%
_{O\left( \mathfrak{h}_{\mathbb{R}}\right) }\left( O\left( \mathfrak{h}%
_{1}\right) \right) \right\} .$
\end{definition}

\begin{lemma}
All complex units can be expressed as 
\begin{equation}
J\left( T\right) =\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right)
\left( Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left(
Te_{j}\right\vert \right\}
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
J\left( T\right) =\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right)
\left( Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left(
Te_{j}\right\vert \right\} =\sum_{1\leq j\,\leq r}\left\{ \left\vert
f_{j}\right) \left( f_{j+r}\right\vert -\left\vert f_{j+r}\right) \left(
f_{j}\right\vert \right\}
\end{equation}%
and $T$ generates all conbs $\left\vert \boldsymbol{f}\right) $ of $%
\mathfrak{h}_{\mathbb{R}}$ from $\left\vert \boldsymbol{e}\right) .$
\end{proof}

\begin{remark}
Properties of complex units%
\begin{eqnarray}
J\left( T\right) ^{-1} &=&-J\left( T\right) ^{t} \\
J\left( T\right) J\left( T\right) ^{t} &=&J\left( T\right) ^{t}J\left(
T\right) =\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right) \left(
Te_{j}\right\vert +\left\vert Te_{j+r}\right) \left( Te_{j+r}\right\vert
\right\} =I_{\mathfrak{h}_{\mathbb{R}}} \\
J\left( T\right) ^{2} &=&\sum_{1\leq j\,\leq r}\left\{ \left\vert
Te_{j}\right) \left( Te_{j}\right\vert +\left\vert Te_{j+r}\right) \left(
Te_{j+r}\right\vert \right\} =-I_{\mathfrak{h}_{\mathbb{R}}}.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{equation}
J\left( T\right) =\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) -\text{\NG }%
_{\mathfrak{h}_{1}}\left( T\right) ^{t}.
\end{equation}
\end{remark}

\begin{remark}
As abstract groups 
\begin{equation}
O\left( \mathfrak{h}_{1}\right) =O\left( \mathfrak{h}_{2}\right) .
\end{equation}
\end{remark}

\begin{remark}
If $T\in O\left( \mathfrak{h}_{1}\right) =O\left( \mathfrak{h}_{2}\right) $
then operator representations are

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{R}_{\mathfrak{h}_{1}}\left( T\right) \in \mathfrak{R}_{\mathfrak{h}%
_{1}}\left( O\left( \mathfrak{h}_{1}\right) \right) =\mathfrak{R}_{\mathfrak{%
h}_{1}}\left( O\left( \mathfrak{h}_{2}\right) \right) \subset \mathcal{B}%
\left( \mathfrak{h}_{1}\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{R}_{T\mathfrak{h}_{1}}\left( T\right) \mathfrak{R}_{T\mathfrak{h}%
_{1}}\left( T\right) ^{t}=\mathfrak{R}_{T\mathfrak{h}_{1}}\left( T\right)
^{t}\mathfrak{R}_{T\mathfrak{h}_{1}}\left( T\right) =I_{\mathfrak{h}_{1}}
\end{equation}

\item 
\begin{equation}
\mathfrak{R}_{T\mathfrak{h}_{2}}\left( T\right) \in \mathfrak{R}_{T\mathfrak{%
h}_{2}}\left( O\left( \mathfrak{h}_{2}\right) \right) =\mathfrak{R}_{T%
\mathfrak{h}_{2}}\left( O\left( T\mathfrak{h}_{1}\right) \right) \subset 
\mathcal{B}\left( T\mathfrak{h}_{2}\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{R}_{T\mathfrak{h}_{2}}\left( T\right) \mathfrak{R}_{T\mathfrak{h}%
_{2}}\left( T\right) ^{t}=\mathfrak{R}_{T\mathfrak{h}_{2}}\left( T\right)
^{t}\mathfrak{R}_{T\mathfrak{h}_{2}}\left( T\right) =I_{T\mathfrak{h}_{2}}
\end{equation}

\item 
\begin{equation}
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( T\right) \in 
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( O\left( T%
\mathfrak{h}_{1}\right) \right) =\mathfrak{R}_{\mathfrak{h}_{1}\oplus 
\mathfrak{h}_{2}}\left( O\left( T\mathfrak{h}_{2}\right) \right) \subset 
\mathcal{B}\left( T\mathfrak{h}_{1}\right)
\end{equation}
and%
\begin{equation}
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( T\right) 
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( T\right) ^{t}=%
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( T\right) ^{t}%
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( T\right) =I_{%
\mathfrak{h}_{\mathbb{R}}}=I_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}.
\end{equation}

\item Scalar representations are 
\begin{eqnarray}
\mathcal{R}_{Te}\left( J\left( T\right) \right) \mathcal{R}_{Te}\left(
J\left( T\right) \right) &=&\left( 
\begin{array}{cc}
\mathbb{O}_{r} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O}_{r} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-\mathbb{I}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & -\mathbb{I}_{r}%
\end{array}%
\right) =-\mathbb{I}_{2r} \\
\mathcal{R}_{Te}\left( J\left( T\right) \right) \mathcal{R}_{Te}\left(
\left( Te\right) _{n}\right) &=&\left( 
\begin{array}{cc}
\mathbb{O}_{r} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
1_{n} \\ 
\mathbf{0}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\mathbf{0} \\ 
1_{n}%
\end{array}%
\right) =\mathcal{R}_{Te}\left( \left( Te\right) _{r+n}\right) \\
\mathcal{R}_{Te}\left( J\right) \mathcal{R}_{Te}\left( \left( Te\right)
_{r+n}\right) &=&\left( 
\begin{array}{cc}
\mathbb{O}_{r} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{0} \\ 
1_{n}%
\end{array}%
\right) =\left( 
\begin{array}{c}
-1_{n} \\ 
\mathbf{0}%
\end{array}%
\right) =-\mathcal{R}_{Te}\left( \left( Te\right) _{n}\right)
\end{eqnarray}

\item 
\begin{equation}
O\left( T\mathfrak{h}_{1}\right) =O\left( T\mathfrak{h}_{2}\right) \subset
O\left( \mathfrak{h}_{1}\oplus \mathfrak{h}_{2}\right) \equiv O\left( 
\mathfrak{h}_{\mathbb{R}}\right) .
\end{equation}

\item 
\begin{equation}
\mathfrak{R}_{\mathfrak{h}_{1}\oplus \mathfrak{h}_{2}}\left( T\right) =%
\mathfrak{R}_{\mathfrak{h}_{1}}\left( T\right) \oplus _{\mathbb{R}}\mathfrak{%
R}_{\mathfrak{h}_{2}}\left( T\right) \overset{\mathcal{R}_{e}}{%
\longrightarrow }\left( 
\begin{array}{cc}
\mathcal{R}_{e}\left( T\right) & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathcal{R}_{e}\left( T\right)%
\end{array}%
\right) .
\end{equation}

\item Let $T\in O\left( \mathfrak{h}\right) $ then

\begin{enumerate}
\item 
\begin{equation}
J\left( T\right) =T^{t}JT=\sum_{1\leq j\,\leq r}\left\{ \left\vert
Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left(
Te_{j}\right\vert \right\}
\end{equation}%
is still a complex unit.

\item In fact all complex units are given by 
\begin{equation}
J\left( T\right) =\sum_{1\leq j\,\leq r}\left\{ \left\vert Te_{j}\right)
\left( Te_{j+r}\right\vert -\left\vert Te_{j+r}\right) \left(
Te_{j}\right\vert \right\} =TJ_{e}T^{t};\quad T\in O\left( \mathfrak{h}_{%
\mathbb{R}}\right) ,
\end{equation}%
as 
\begin{equation}
J\left( T\right) ^{2}=J\left( T\right) J\left( T\right)
=TJ_{e}T^{t}TJ_{e}T^{t}=TJ_{e}^{2}T^{t}=-TI_{\mathfrak{h}_{\mathbb{R}%
}}T^{t}=-I_{\mathfrak{h}_{\mathbb{R}}},
\end{equation}%
where the reference complex unit is defined as 
\begin{equation}
J_{e}=\sum_{1\leq j\,\leq r}\left\{ \left\vert e_{j}\right) \left(
e_{j+r}\right\vert -\left\vert e_{j+r}\right) \left( e_{j}\right\vert
\right\}
\end{equation}%
for a reference conbs $\left\{ \left. e_{j}\right\vert 1\leq j\,\leq
2r\right\} .$

\item Inner product definition of the orthogonal group $O\left( \mathfrak{h}%
_{\mathbb{R}}\right) $%
\begin{equation}
T\in O\left( \mathfrak{h}_{\mathbb{R}}\right) \Leftrightarrow \left( \left.
Tv\right\vert Tv\right) _{\mathfrak{h}_{\mathbb{R}}}=\left( \left.
v\right\vert v\right) _{\mathfrak{h}_{\mathbb{R}}}\forall v\in \mathfrak{h}_{%
\mathbb{R}}\mathfrak{.}
\end{equation}

\item Let 
\begin{equation}
t\in O\left( \mathfrak{h}_{1}\right) =O\left( \mathfrak{h}_{2}\right)
\end{equation}%
then 
\begin{equation}
tJ\left( T\right) t^{t}=J\left( tTt^{-1}\right)
\end{equation}%
are equivalent complex units.

\item The standard complex unit $J_{e}$ can be obtained from any complex
unit $J\left( T\right) $ by 
\begin{equation}
T^{t}J\left( T\right) T=J_{e}
\end{equation}

\item The complex unit is a sum of partial isometries $\left\{ \left. \text{%
\ng }_{j}\left( T\right) \right\vert 1\leq j\leq r\right\} ,$\NG $_{%
\mathfrak{h}_{1}}\left( T\right) \in \mathcal{B}\left( \mathfrak{h}%
_{1}\left( T\right) ,\mathfrak{h}_{2}\left( T\right) \right) $ 
\begin{equation}
J\left( T\right) =\text{\NG }_{\mathfrak{h}_{1}}\left( T\right) -\text{\NG }%
_{\mathfrak{h}_{1}}\left( T\right) ^{t}=\sum_{1\leq j\,\leq r}\left\{
\left\vert Te_{j}\right) \left( Te_{j+r}\right\vert -\left\vert
Te_{j+r}\right) \left( Te_{j}\right\vert \right\} =\sum_{1\leq j\,\leq
r}\left\{ \text{\ng }_{j}\left( T\right) -\text{\ng }_{j}\left( T\right)
^{t}\right\} ,
\end{equation}%
where the partial isometries $\left\{ \left. \text{\ng }_{j}\left( T\right)
\right\vert 1\leq j\,\leq r\right\} $ are defined by 
\begin{equation}
\text{\ng }_{j}\left( T\right) =\left\vert Te_{j}\right) \left(
Te_{j+r}\right\vert =T\left\vert e_{j}\right) \left( e_{j+r}\right\vert T^{t}
\end{equation}%
and shown to be partial isometries by

\begin{enumerate}
\item 
\begin{eqnarray}
\text{\ng }_{j}\left( T\right) \text{\ng }_{j}\left( T\right) ^{t} &=&p_{%
\mathfrak{h}_{1}}\left( T\right) _{j} \\
\text{\ng }_{j}\left( T\right) ^{t}\text{\ng }_{j}\left( T\right) &=&p_{%
\mathfrak{h}_{2}}\left( T\right) _{j} \\
1 &\leq &j\,\leq r
\end{eqnarray}%
and

\item 
\begin{eqnarray}
p_{\mathfrak{h}_{1}}\left( T\right) _{j}^{2} &=&p_{\mathfrak{h}_{1}}\left(
T\right) _{j}=p_{\mathfrak{h}_{1}}\left( T\right) _{j}^{t} \\
p_{\mathfrak{h}_{2}}\left( T\right) _{j}^{2} &=&p_{\mathfrak{h}_{2}}\left(
T\right) _{j}=p_{\mathfrak{h}_{2}}\left( T\right) _{j}^{t}
\end{eqnarray}%
where

\item 
\begin{equation}
P_{\mathfrak{h}_{1}}\left( T\right) =\sum_{1\leq j\,\leq r}p_{\mathfrak{h}%
_{1}}\left( T\right) _{j}
\end{equation}%
and 
\begin{equation}
P_{\mathfrak{h}_{2}}\left( T\right) =\sum_{1\leq j\,\leq r}p_{\mathfrak{h}%
_{2}}\left( T\right) _{j}.
\end{equation}
\end{enumerate}
\end{enumerate}

\item Conjugations $\sigma \left( T\right) \in \mathcal{B}\left( \mathfrak{h}%
_{\mathbb{R}}\right) $ associated with complex units $J\left( T\right) $ are
defined as 
\begin{equation}
\sigma \left( T\right) =\sum_{1\leq j\,\leq r}\left\{ \left\vert
Te_{j}\right) \left( Te_{j}\right\vert -\left\vert Te_{j+r}\right) \left(
Te_{j+r}\right\vert \right\} =P_{\mathfrak{h}_{1}}\left( T\right) -P_{%
\mathfrak{h}_{2}}\left( T\right) =TP_{\mathfrak{h}_{1}}T^{t}-TP_{\mathfrak{h}%
_{2}}T^{t};\quad T\in O\left( \mathfrak{h}_{\mathbb{R}}\right)
\end{equation}%
and are idempotents i.e. 
\begin{equation}
\sigma \left( T\right) ^{2}=I_{\mathfrak{h}_{\mathbb{R}}}
\end{equation}%
that have the properties

\begin{enumerate}
\item 
\begin{equation}
\sigma \left( T\right) J\left( T\right) =-J\left( T\right) .
\end{equation}%
and

\item 
\begin{eqnarray}
\sigma \left( T\right) P_{\mathfrak{h}_{1}}\left( T\right) &=&P_{\mathfrak{h}%
_{1}}\left( T\right) \\
\sigma \left( T\right) P_{\mathfrak{h}_{2}}\left( T\right) &=&-P_{\mathfrak{h%
}_{2}}\left( T\right) .
\end{eqnarray}
\end{enumerate}

\item If $S\in Sp\left( 2r,\mathbb{R}\right) \cong Sp\left( \mathfrak{h}_{%
\mathbb{R}}\right) $ then

\begin{enumerate}
\item 
\begin{equation}
S^{t}J\left( T\right) S=J\left( S^{t}TS\right) =J\left( T\right)
\end{equation}%
and hence

\item 
\begin{equation}
\mathfrak{R}_{\mathfrak{h}_{\mathbb{R}}}\left( S\right) ^{t}\mathfrak{R}_{%
\mathfrak{h}_{\mathbb{R}}}\left( J_{e}\right) \mathfrak{R}_{\mathfrak{h}_{%
\mathbb{R}}}\left( S\right) =\mathcal{R}_{e}\left( S\right) ^{t}\mathcal{R}%
_{e}\left( J_{e}\right) \mathcal{R}_{e}\left( S\right) =\mathcal{R}%
_{e}\left( S\right) ^{t}\left( 
\begin{array}{cc}
\mathbb{O}_{r} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( S\right) =\mathcal{R}_{e}\left( J_{e}\right)
=\left( 
\begin{array}{cc}
\mathbb{O}_{r} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right)
\end{equation}%
and

\item 
\begin{equation}
S\in Sp\left( \mathfrak{h}_{\mathbb{R}}\right) \Leftrightarrow \left( \left.
Sv\right\vert J\left( T\right) Sv\right) _{\mathfrak{h}_{\mathbb{R}%
}}=\left\{ \left. Sv\right\vert Sv\right\} _{\mathfrak{h}_{\mathbb{R}}}\quad
\forall v\in \mathfrak{h}_{\mathbb{R}}\mathfrak{.}
\end{equation}

\begin{lemma}
\begin{equation}
\left\{ \left. \overset{}{S}\right\vert \left( \left. Sv\right\vert J\left(
T\right) Sw\right) _{\mathfrak{h}_{\mathbb{R}}}=\left( \left. v\right\vert
J\left( T\right) w\right) _{\mathfrak{h}_{\mathbb{R}}}\right\} =\left\{
\left. \underset{}{S}\right\vert \left( \left. Sv\right\vert J\left(
T^{\prime }\right) Sw\right) _{\mathfrak{h}_{\mathbb{R}}}=\left( \left.
v\right\vert J\left( T^{\prime }\right) w\right) _{\mathfrak{h}_{\mathbb{R}%
}}\right\} \quad \forall T,T^{\prime }\in O\left( \mathfrak{h}_{\mathbb{R}%
}\right) ,\forall v,w\in \mathfrak{h}_{\mathbb{R}}.
\end{equation}
\end{lemma}
\end{enumerate}
\end{enumerate}
\end{remark}

\subparagraph{The Complexification Maps $\mathcal{J}\left( T\right) \in 
\mathcal{B}_{\mathbb{R}}\left( \mathfrak{h}_{\mathbb{C}\left( T\right) },%
\mathfrak{h}_{\mathbb{R}}\right) $ and $\protect\widehat{\mathcal{J}\left(
T\right) }\in \mathcal{B}_{\mathbb{R}}\left( \mathcal{B}_{\mathbb{R}}\left( 
\mathfrak{h}_{\mathbb{C}\left( T\right) }\right) ,_{\mathbb{R}}\left( 
\mathfrak{h}_{\mathbb{R}}\right) \right) $}

\begin{equation}
\mathfrak{h}_{1}=J\left( T\right) \mathfrak{h}_{2},\quad J\left( T\right)
\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right) =\mathcal{B}\left( 
\mathfrak{h}_{1}\oplus _{\mathbb{R}}\mathfrak{h}_{2}\right)
\end{equation}

\begin{definition}
The complexification maps

\begin{enumerate}
\item $\mathcal{J}\left( T\right) \in \mathcal{B}_{\mathbb{R}}\left( 
\mathfrak{h}_{\mathbb{C}\left( T\right) },\mathfrak{h}_{\mathbb{R}}\right) $ 
\begin{equation}
\mathcal{J}\left( T\right) :\mathfrak{h}_{\mathbb{R}}=\mathfrak{h}_{1}\oplus
_{\mathbb{R}}\mathfrak{h}_{2}\cong \mathfrak{h}_{1}\times \mathfrak{h}%
_{1}\rightarrow \mathfrak{h}_{\mathbb{C}\left( T\right) },
\end{equation}%
and

\item $\widehat{\mathcal{J}\left( T\right) }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathcal{B}_{\mathbb{R}}\left( \mathfrak{h}_{\mathbb{C}\left(
T\right) }\right) ,\mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right)
\right) $%
\begin{equation}
\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( X\right) =%
\mathcal{J}\left( T\right) X\mathcal{J}\left( T\right) ^{-1}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
\begin{gather}
\limfunc{Dom}\left\{ \widehat{\mathcal{J}\left( T\right) }\right\} \\
\parallel \\
\left\{ \left. X\right\vert X=\left\vert \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right\rangle \left\langle \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right\vert \mathfrak{R}_{e_{_{h_{1}}}\left( T\right)
}\left( X_{1}\right) -\left\vert \boldsymbol{e}_{\mathfrak{h}_{1}}\left(
T\right) \right\rangle \left\langle \boldsymbol{e}_{\mathfrak{h}_{2}}\left(
T\right) \right\vert \mathfrak{R}_{e_{_{h_{2}h_{1}}}\left( T\right) }\left(
X_{2}\right) +\left\vert \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right)
\right\rangle \left\langle \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right)
\right\vert \mathfrak{R}_{e_{_{h_{2}h_{1}}}\left( T\right) }\left(
X_{2}\right) ^{t}+\left\vert \boldsymbol{e}_{\mathfrak{h}_{2}}\left(
T\right) \right\rangle \left\langle \boldsymbol{e}_{\mathfrak{h}_{2}}\left(
T\right) \right\vert \mathfrak{R}_{e_{h_{1}}\left( T\right) }\left(
X_{1}\right) \right\} ,
\end{gather}%
where 
\begin{equation}
X_{1}\in \mathcal{B}\left( \mathfrak{h}_{1}\right) ,X_{2}\in \mathcal{B}%
\left( \mathfrak{h}_{2},\mathfrak{h}_{1}\right) .
\end{equation}
\end{definition}

\begin{lemma}
$\limfunc{Dom}\left\{ \widehat{\mathcal{J}\left( T\right) }\right\} $ is a
real subspace of $\mathcal{B}\left( \mathfrak{h}\right) $
\end{lemma}

\begin{remark}
\begin{equation}
\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( J\left( T\right)
\right) =\mathcal{J}\left( T\right) J\left( T\right) \mathcal{J}\left(
T\right) ^{-1}=iI_{\mathfrak{h}_{\mathbb{C}\left( T\right) }},\quad J\left(
T\right) \in \mathfrak{C}\left( \mathfrak{h}_{\mathbb{R}}\right) ,\quad 
\widehat{\mathcal{J}\left( T\right) }\in \mathcal{B}_{\mathbb{R}}\left( 
\mathcal{B}\left( \mathfrak{h}_{\mathbb{C}\left( T\right) }\right) ,\mathcal{%
B}\left( \mathfrak{h}_{\mathbb{R}}\right) \right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{J}\left( T\right) \left( x_{r}\right) =\mathcal{J}\left( T\right)
\left( x_{1}+J\left( T\right) x_{2}\right) =\mathcal{J}\left( T\right)
\left( x_{1},x_{2}\right) =x_{1}+ix_{2}.
\end{equation}
\end{remark}

\begin{lemma}
$\mathcal{J}\left( T\right) $ is injective i.e.%
\begin{equation}
\ker \left( \mathcal{J}\left( T\right) \right) =\phi
\end{equation}
\end{lemma}

\begin{definition}
\begin{lemma}
\begin{proof}
\begin{equation}
\mathcal{J}\left( T\right) \left( x_{r}\right) =\mathcal{J}\left( T\right)
\left( x_{1}+J\left( T\right) x_{2}\right) =\mathcal{J}\left( T\right)
\left( x_{1},x_{2}\right) =x_{1}+ix_{2}
\end{equation}
\end{proof}
\end{lemma}

\begin{lemma}
$\mathcal{J}\left( T\right) $ is surjective i.e.%
\begin{equation}
\limfunc{Ran}\left( \mathcal{J}\left( T\right) \right) =\mathfrak{h}_{%
\mathbb{C}\left( T\right) }.
\end{equation}
\end{lemma}

\begin{lemma}
$\mathcal{J}\left( T\right) $ is real vector space isomorphism.
\end{lemma}
\end{definition}

\begin{remark}
\begin{equation}
O\left( \mathfrak{h}_{1}\right) =O\left( \mathfrak{h}_{2}\right) \subset
O\left( \mathfrak{h}_{\mathbb{R}}\right) =O\left( \mathfrak{h}_{1}\oplus _{%
\mathbb{R}}\mathfrak{h}_{2}\right)
\end{equation}%
in terms of scalar representations 
\begin{equation}
O\left( r,\mathbb{R}\right) \subset O\left( 2r,\mathbb{R}\right) =O\left( 
\mathbb{R}^{r}\oplus _{\mathbb{R}}\mathbb{R}^{r}\right) =O\left( \mathbb{R}%
^{2r}\right) .
\end{equation}
\end{remark}

\begin{definition}
\begin{enumerate}
\item 
\begin{equation}
G\boxtimes G=\left\{ \left. \left( g,g\right) \right\vert g\in G\right\}
\end{equation}

\item 
\begin{equation}
G\times G=\left\{ \left. \left( g,h\right) \right\vert g,h\in G\right\}
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
\begin{equation}
G\boxtimes G\equiv G\subset G\times G
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( U\left( \mathfrak{h}_{\mathbb{C%
}\left( T\right) }\right) \right) =\mathcal{R}_{\mathfrak{h}_{1}\oplus _{%
\mathbb{R}}\mathfrak{h}_{2}}\left( U\left( \mathfrak{h}_{\mathbb{C}\left(
T\right) }\right) \right) =\mathcal{R}_{\mathfrak{h}_{1}}\left( O\left( 
\mathfrak{h}_{1}\right) \right) \oplus _{\mathbb{R}}\mathcal{R}_{\mathfrak{h}%
_{1}}\left( O\left( \mathfrak{h}_{1}\right) \right)
\end{equation}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left( O\left( 
\mathfrak{h}_{\mathbb{R}}\right) \right) \subset \mathcal{B}\left( \mathfrak{%
h}_{\mathbb{C}\left( T\right) }\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( O\left( \mathfrak{h}_{\mathbb{R%
}}\right) \right) \subset \mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right)
\end{equation}
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left( Sp\left( 
\mathfrak{h}_{\mathbb{R}}\right) \right) \subset \mathcal{B}\left( \mathfrak{%
h}_{\mathbb{C}\left( T\right) }\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( Sp\left( \mathfrak{h}_{\mathbb{%
R}}\right) \right) \subset \mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right)
\end{equation}
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left( U\left( 
\mathfrak{h}_{\mathbb{C}\left( T\right) }\right) \right) \subset \mathcal{B}%
\left( \mathfrak{h}_{\mathbb{C}\left( T\right) }\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( U\left( \mathfrak{h}_{\mathbb{C%
}\left( T\right) }\right) \right) \subset \mathcal{B}\left( \mathfrak{h}_{%
\mathbb{R}}\right)
\end{equation}
\end{enumerate}

\item For the representations $\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left(
T\right) }}\left( O\left( \mathfrak{h}_{\mathbb{R}}\right) \right) ,\mathcal{%
R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left( Sp\left( \mathfrak{h}_{%
\mathbb{R}}\right) \right) ,\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left(
T\right) }}\left( U\left( \mathfrak{h}_{\mathbb{C}\left( T\right) }\right)
\right) $ one has 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left( O\left( 
\mathfrak{h}_{\mathbb{R}}\right) \right) \cap \mathcal{R}_{\mathfrak{h}_{%
\mathbb{C}\left( T\right) }}\left( Sp\left( \mathfrak{h}_{\mathbb{R}}\right)
\right) =\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left(
U\left( \mathfrak{h}_{\mathbb{C}\left( T\right) }\right) \right) ,
\end{equation}%
where

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{h}_{\mathbb{C}\left( T\right) }=\mathcal{J}\left( T\right) \left( 
\overset{}{\mathfrak{h}_{1}\oplus _{\mathbb{R}}J\left( T\right) \mathfrak{h}%
_{1}}\right) ,
\end{equation}%
i.e. the \emph{complexification} 
\begin{equation}
\mathcal{J}\left( T\right) :\mathfrak{h}_{1}\times \mathfrak{h}%
_{1}\rightarrow \mathfrak{h}_{\mathbb{C}\left( T\right) }
\end{equation}%
is given by 
\begin{equation}
\mathcal{J}\left( T\right) \left( v_{r}\right) =v_{1}+_{\mathbb{R}}iv_{2}\in 
\mathfrak{h}_{\mathbb{C}\left( T\right) },
\end{equation}%
where for 
\begin{equation}
v_{r}\in \mathfrak{h}_{\mathbb{R}}
\end{equation}%
one has 
\begin{equation}
v_{r}=v_{1}\oplus _{\mathbb{R}}J\left( T\right) v_{2}=v_{1}+_{\mathbb{R}%
}J\left( T\right) v_{2},\quad \,v_{1},v_{2}\in \mathfrak{h}_{1}.
\end{equation}

\item The hermitian inner product $\left\langle \left. {}\right\vert
\right\rangle _{\mathfrak{h}_{\mathbb{C}\left( T\right) }}$ in $\mathfrak{h}%
_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}$ is defined as 
\begin{equation}
\left\langle \left. \mathcal{J}\left( T\right) \left( v_{r}\right)
\right\vert \mathcal{J}\left( T\right) \left( w_{r}\right) \right\rangle _{%
\mathfrak{h}_{\mathbb{C}\left( T\right) }}=\left\langle \left.
v_{c}\right\vert w_{c}\right\rangle _{\mathfrak{h}_{\mathbb{C}\left(
T\right) }}=\left( \left. v_{r}\right\vert w_{r}\right) _{\mathfrak{h}_{%
\mathbb{R}}}+i\left( \left. v_{r}\right\vert J\left( T\right) w_{r}\right) _{%
\mathfrak{h}_{\mathbb{R}}}=\left( \left. v_{r}\right\vert w_{r}\right) _{%
\mathfrak{h}_{\mathbb{R}}}+i\left\{ \left. {}\right\vert \right\} _{%
\mathfrak{h}_{\mathbb{R}}\left( T\right) },\quad v_{c},w_{c}\in \mathfrak{h}%
_{\mathfrak{h}_{\mathbb{C}\left( T\right) }},
\end{equation}%
where 
\begin{eqnarray}
v_{c} &=&\mathcal{J}\left( T\right) \left( v_{r}\right) \in \mathfrak{h}_{%
\mathbb{C}\left( T\right) } \\
w_{c} &=&\mathcal{J}\left( T\right) \left( w_{r}\right) \in \mathfrak{h}_{%
\mathbb{C}\left( T\right) }
\end{eqnarray}%
and the real symplectic form $\left\{ \left. {}\right\vert \right\} _{%
\mathfrak{h}_{\mathbb{R}}\left( T\right) }$ is defined by 
\begin{equation}
\left\{ \left. {}\right\vert \right\} _{\mathfrak{h}_{\mathbb{R}}\left(
T\right) }=\left( \left. v_{r}\right\vert J\left( T\right) w_{r}\right) _{%
\mathfrak{h}_{\mathbb{R}}}\quad v_{r},w_{r}\in \mathfrak{h}_{\mathbb{R}}.
\end{equation}

\item The real and imaginary parts of the inner product $\left\langle \left.
{}\right\vert \right\rangle _{\mathfrak{h}_{\mathbb{C}\left( T\right) }}$
are given by 
\begin{eqnarray}
\left\langle \left. v_{c}\right\vert w_{c}\right\rangle _{\mathfrak{h}_{%
\mathbb{C}\left( T\right) }}+\overline{\left\langle \left. v_{c}\right\vert
w_{c}\right\rangle }_{\mathfrak{h}_{\mathbb{C}\left( T\right) }} &=&2\func{Re%
}\left( \left\langle \left. v_{c}\right\vert w_{c}\right\rangle _{\mathfrak{h%
}_{\mathbb{C}\left( T\right) }}\right) =2\left( \left. v_{r}\right\vert
w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}} \\
\left\langle \left. v_{c}\right\vert w_{c}\right\rangle _{\mathfrak{h}_{%
\mathbb{C}\left( T\right) }}-\overline{\left\langle \left. v_{c}\right\vert
w_{c}\right\rangle }_{\mathfrak{h}_{1\mathbb{C}}} &=&2\func{Im}\left(
\left\langle \left. v_{c}\right\vert w_{c}\right\rangle _{\mathfrak{h}_{%
\mathbb{C}\left( T\right) }}\right) =2i\left\{ \left. v_{r}\right\vert
w_{r}\right\} _{\mathfrak{h}_{\mathbb{R}}}=2i\left( \left. v_{r}\right\vert
J\left( T\right) w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}}.
\end{eqnarray}
\end{enumerate}

\item The unitray group $U\left( \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right) $ of $\mathfrak{h}_{\mathbb{C}\left( T\right) }$ is defined by 
\begin{equation}
U\left( \mathfrak{h}_{\mathbb{C}\left( T\right) }\right) =\left\{ \left. 
\overset{}{\mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left(
u\right) }\right\vert \left\langle \left. \overset{}{\mathcal{R}_{\mathfrak{h%
}_{\mathbb{C}\left( T\right) }}\left( u\right) v_{c}}\right\vert \mathcal{R}%
_{\mathfrak{h}_{\mathbb{C}\left( T\right) }}\left( u\right)
w_{c}\right\rangle _{\mathfrak{h}_{\mathbb{C}\left( T\right) }}=\left\langle
\left. v_{c}\right\vert w_{c}\right\rangle _{\mathfrak{h}_{\mathbb{C}\left(
T\right) }}\,\forall v_{c},w_{c}\in \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right\}
\end{equation}%
giving

\begin{enumerate}
\item 
\begin{eqnarray}
\left\langle \left. \mathcal{R}_{\mathfrak{h}_{\mathbb{C}\left( T\right)
}}\left( u\right) v_{c}\right\vert \mathcal{R}_{\mathfrak{h}_{\mathbb{C}%
\left( T\right) }}\left( u\right) w_{c}\right\rangle _{\mathfrak{h}_{\mathbb{%
C}\left( T\right) }} &=&\left( \left. \mathcal{R}_{\mathfrak{h}_{\mathbb{R}%
}}\left( u\right) v_{r}\right\vert \mathcal{R}_{\mathfrak{h}_{\mathbb{R}%
}}\left( u\right) w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}}+\left( \left. 
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right) v_{r}\right\vert
J\left( T\right) \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}} \\
&=&\left( \left. \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
v_{r}\right\vert \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}}+i\left\{ \left. \mathcal{R}_{%
\mathfrak{h}_{\mathbb{R}}}\left( u\right) v_{r}\right\vert \mathcal{R}_{%
\mathfrak{h}_{\mathbb{R}}}\left( u\right) w_{r}\right\} _{\mathfrak{h}_{%
\mathbb{R}}}=\left( \left. v_{r}\right\vert w_{r}\right) _{\mathfrak{h}_{%
\mathbb{R}}}+i\left( \left. v_{r}\right\vert J\left( T\right) w_{r}\right) _{%
\mathfrak{h}_{\mathbb{R}}}
\end{eqnarray}%
hence

\item the real orthogonal group $O\left( \mathfrak{h}_{\mathbb{R}}\right) $
condition 
\begin{equation}
\left( \left. \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
v_{r}\right\vert \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}}=\left( \left. v_{r}\right\vert
w_{r}\right) _{\mathfrak{h}_{\mathbb{R}}}\Leftrightarrow u\in O\left( 
\mathfrak{h}_{\mathbb{R}}\right)
\end{equation}%
and

\item the real symplectic group $Sp\left( \mathfrak{h}_{\mathbb{R}}\right) $
condition 
\begin{equation}
\left\{ \left. \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
v_{r}\right\vert \mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right)
w_{r}\right\} _{\mathfrak{h}_{\mathbb{R}}}=\left( \left. \mathcal{R}_{%
\mathfrak{h}_{\mathbb{R}}}\left( u\right) v\right\vert J\left( T\right) 
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( u\right) w\right) _{\mathfrak{h%
}_{\mathbb{R}}}=\left\{ \left. v_{r}\right\vert w_{r}\right\} _{\mathfrak{h}%
_{\mathbb{R}}}=\left( \left. v_{r}\right\vert J\left( T\right) w_{r}\right)
_{\mathfrak{h}_{\mathbb{R}}}\Leftrightarrow \mathcal{R}_{\mathfrak{h}_{%
\mathbb{R}}}\left( u\right) \in Sp\left( \mathfrak{h}_{\mathbb{R}}\right)
\end{equation}%
give

\item the unitary group $U\left( \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right) \subset \mathcal{B}\left( \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right) $ identification 
\begin{equation}
\mathcal{R}_{\mathfrak{h}_{\mathbb{R}}}\left( U\left( \mathfrak{h}_{\mathbb{C%
}\left( T\right) }\right) \right) =\mathcal{R}_{\mathfrak{h}_{\mathbb{R}%
}}\left( O\left( \mathfrak{h}_{\mathbb{R}}\right) \right) \cap \mathcal{R}_{%
\mathfrak{h}_{\mathbb{R}}}\left( Sp\left( \mathfrak{h}_{\mathbb{R}}\right)
\right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{lemma}
The definitions of the groups $O\left( \mathfrak{h}_{\mathbb{R}}\right) $
and $Sp\left( \mathfrak{h}_{\mathbb{R}}\right) $ 
\begin{equation}
O\left( \mathfrak{h}_{\mathbb{R}}\right) =\left\{ \left. T\right\vert \left(
\left. Tx\right\vert Ty\right) =\left( \left. x\right\vert y\right) =\left(
\left. x\right\vert I_{\mathfrak{h}_{\mathbb{R}}}y\right) \quad \forall
x,y\in \mathfrak{h}_{\mathbb{R}}\right\} ,
\end{equation}%
where 
\begin{equation}
I_{\mathfrak{h}_{\mathbb{R}}}=\sum_{1\leq j\leq 2r}\left\vert e_{j}\right)
\left( e_{j}\right\vert
\end{equation}%
and 
\begin{equation}
Sp\left( \mathfrak{h}_{\mathbb{R}}\right) =\left\{ \left. T\right\vert
\left( \left. Tx\right\vert J_{e}Ty\right) =\left( \left. x\right\vert
J_{e}y\right) \quad \forall x,y\in \mathfrak{h}_{\mathbb{R}}\right\} \equiv
\left\{ \left. T\right\vert \equiv \left\{ \left. Tx\right\vert Ty\right\}
=\left\{ \left. x\right\vert J_{e}y\right\} \quad \forall x,y\in \mathfrak{h}%
_{\mathbb{R}}\right\} ,
\end{equation}%
where 
\begin{equation}
J_{e}\equiv J\left( I_{O\left( \mathfrak{h}_{\mathbb{R}}\right) }\right)
=\sum_{1\leq j\leq r}\left\{ \left\vert e_{j}\right) \left(
e_{j+r}\right\vert -\left\vert e_{j+r}\right) \left( e_{j}\right\vert
\right\}
\end{equation}%
are basis independent.
\end{lemma}
\end{enumerate}
\end{remark}

\begin{proof}
All conbs are given by $\left\{ \left. Se_{j}\right\vert 1\leq j\leq 2r,S\in
O\left( \mathfrak{h}_{\mathbb{R}}\right) \right\} $ 
\begin{equation}
\left( \left. x\right\vert I_{\mathfrak{h}_{\mathbb{R}}}y\right) =\left(
\left. \overset{\overset{}{}}{x}\right\vert TS^{t}S\sum_{1\leq j\leq
2r}\left\vert \overset{\overset{}{}}{e_{j}}\right) \left( \overset{\overset{}%
{}}{e_{j}}\right\vert TS^{t}Sy\right) ,\quad \forall S\in O\left( \mathfrak{h%
}_{\mathbb{R}}\right)
\end{equation}%
as 
\begin{equation}
S^{t}\left( S\sum_{1\leq j\leq 2r}\left\vert \overset{\overset{}{}}{e_{j}}%
\right) \left( \overset{\overset{}{}}{e_{j}}\right\vert S^{t}\right) S=I_{%
\mathfrak{h}_{\mathbb{R}}}
\end{equation}%
hence the orthogonal group is given by 
\begin{equation}
O\left( \mathfrak{h}_{\mathbb{R}}\right) =\left\{ \left. TS^{t}\right\vert
\left( \left. TS^{t}x\right\vert TS^{t}y\right) =\left( \left. x\right\vert
y\right) =\left( \left. x\right\vert I_{\mathfrak{h}_{\mathbb{R}}}y\right)
\quad \forall x,y\in \mathfrak{h}_{\mathbb{R}}\right\}
\end{equation}%
as for a fixed $S$ 
\begin{equation}
T^{\prime }=TS\Rightarrow T^{\prime }=TSS^{t}=T.
\end{equation}%
In the same way 
\begin{equation}
SJ_{e}S^{t}=S\sum_{1\leq j\leq r}\left\{ \left\vert e_{j}\right) \left(
e_{j+r}\right\vert -\left\vert e_{j+r}\right) \left( e_{j}\right\vert
\right\} S^{t}
\end{equation}%
produces all complex units and hence the symplectic group is given by 
\begin{equation}
Sp\left( \mathfrak{h}_{\mathbb{R}}\right) =\left\{ \left. TS^{t}\right\vert
\left( \left. TS^{t}x\right\vert SJ_{e}S^{t}TS^{t}y\right) =\left( \left.
x\right\vert SJ_{e}S_{e}^{t}y\right) \quad \forall x,y\in \mathfrak{h}_{%
\mathbb{R}}\right\} \equiv \left\{ \left. TS^{t}\right\vert \equiv \left\{
\left. TS^{t}x\right\vert TS^{t}y\right\} =\left\{ \left. x\right\vert
SJ_{e}S_{e}^{t}y\right\} \quad \forall x,y\in \mathfrak{h}_{\mathbb{R}%
}\right\} ,
\end{equation}%
as for a fixed $S$ 
\begin{equation}
T^{\prime }=TS\Rightarrow T^{\prime }=TSS^{t}=T.
\end{equation}
\end{proof}

\begin{remark}
\begin{enumerate}
\item The inverse complexification map $\widehat{\mathcal{J}\left( T\right) }%
^{-1}$ acting on any operator $Z\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{C%
}\left( T\right) }\right) $ gives 
\begin{equation}
\left[ \widehat{\mathcal{J}\left( T\right) }^{-1}\right] \left( Z\right)
=\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
X_{1} & -X_{2} \\ 
X_{2} & X_{1}%
\end{array}%
\right) =X.
\end{equation}

\item The $O\left( 2r,\mathbb{R}\right) \cong O\left( \mathfrak{h}_{\mathbb{R%
}}\right) $-real orthogonal group condition for $\left[ \widehat{\mathcal{J}%
\left( T\right) }^{-1}\right] \left( Z\right) $ gives

$\lceil $%
\begin{eqnarray}
\left( 
\begin{array}{cc}
a^{t} & b^{t} \\ 
-b^{t} & a^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
a & -b \\ 
b & a%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
a^{t}a+b^{t}b & b^{t}a-a^{t}b \\ 
a^{t}b-b^{t}a & a^{t}a+b^{t}b%
\end{array}%
\right) =\left( 
\begin{array}{cc}
1 & 0 \\ 
0 & 1%
\end{array}%
\right) \\
a^{t}a+b^{t}b &=&1 \\
a^{t}b &=&b^{t}a
\end{eqnarray}%
$\rfloor $ 
\begin{gather}
\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t} & \func{Im}_{T\left(
e\right) }\left( Z\right) ^{t} \\ 
-\func{Im}_{T\left( e\right) }\left( Z\right) ^{t} & \func{Re}_{T\left(
e\right) }\left( Z\right) ^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right)
}\left( Z\right) +\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) & \func{Im}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Re}_{T\left( e\right) }\left( Z\right) -\func{Re}%
_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}_{T\left( e\right) }\left(
Z\right) \\ 
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}_{T\left( e\right)
}\left( Z\right) -\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}%
_{T\left( e\right) }\left( Z\right) ^{\prime } & \func{Re}_{T\left( e\right)
}\left( Z\right) ^{t}\func{Re}_{T\left( e\right) }\left( Z\right) +\func{Im}%
_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}_{T\left( e\right) }\left(
Z\right)%
\end{array}%
\right) =I_{2r}
\end{gather}%
\begin{gather}
\Updownarrow \\
\left( \overset{}{\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) -\func{Im}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Re}_{T\left( e\right) }\left( Z\right) =0}\right)
\Longleftrightarrow \left( \overset{}{\func{Re}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Im}_{T\left( e\right) }\left( Z\right) =\func{Im}%
_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right) }\left(
Z\right) }\right) \\
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right)
}\left( Z\right) +\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) =I_{r}.
\end{gather}

\item The $Sp\left( 2r,\mathbb{R}\right) \cong Sp\left( \mathfrak{h}_{%
\mathbb{R}}\right) $-real symplectic group condition on $\left[ \widehat{%
\mathcal{J}\left( T\right) }^{-1}\right] \left( Z\right) $ gives

$\lceil $Note that%
\begin{eqnarray}
\left( 
\begin{array}{cc}
a^{t} & b^{t} \\ 
-b^{t} & a^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
0 & -1 \\ 
1 & 0%
\end{array}%
\right) \left( 
\begin{array}{cc}
a & -b \\ 
b & a%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
b^{t} & -a^{t} \\ 
a^{t} & b^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
a & -b \\ 
b & a%
\end{array}%
\right) =\left( 
\begin{array}{cc}
b^{t}a-a^{t}b & -\left( a^{t}a+b^{t}b\right) \\ 
a^{t}a+b^{t}b & b^{t}a-a^{t}b%
\end{array}%
\right) =\left( 
\begin{array}{cc}
0 & -1 \\ 
1 & 0%
\end{array}%
\right) \\
b^{t}a &=&a^{t}b \\
a^{t}a+b^{t}b &=&1
\end{eqnarray}%
$\rfloor $ 
\begin{gather}
\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{cc}
0 & -I_{r} \\ 
I_{r} & 0%
\end{array}%
\right) \left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t} & \func{Im}_{T\left(
e\right) }\left( Z\right) ^{t} \\ 
-\func{Im}_{T\left( e\right) }\left( Z\right) ^{t} & \func{Re}_{T\left(
e\right) }\left( Z\right) ^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
0 & -I_{r} \\ 
I_{r} & 0%
\end{array}%
\right) \left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{cc}
0 & -I_{r} \\ 
I_{r} & 0%
\end{array}%
\right) \\
\parallel
\end{gather}%
\begin{eqnarray}
&=&\left( 
\begin{array}{cc}
\func{Im}_{T\left( e\right) }\left( Z\right) ^{t} & -\func{Re}_{T\left(
e\right) }\left( Z\right) ^{t} \\ 
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t} & \func{Im}_{T\left(
e\right) }\left( Z\right) ^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right)
}\left( Z\right) -\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Im}_{T\left( e\right) }\left( Z\right) -\func{Re}%
_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right) }\left(
Z\right) \\ 
\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right)
}\left( Z\right) +\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) & -\func{Re}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Im}_{T\left( e\right) }\left( Z\right) +\func{Im}%
_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right) }\left(
Z\right)%
\end{array}%
\right)
\end{eqnarray}%
\begin{gather}
\Updownarrow \\
\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}_{T\left( e\right)
}\left( Z\right) +\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}%
_{T\left( e\right) }\left( Z\right) =I_{r} \\
\left( \overset{}{\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) -\func{Im}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Re}_{T\left( e\right) }\left( Z\right) =0}\right)
\Longleftrightarrow \left( \overset{}{\func{Re}_{T\left( e\right) }\left(
Z\right) ^{t}\func{Im}_{T\left( e\right) }\left( Z\right) =\func{Im}%
_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right) }\left(
Z\right) }\right) .
\end{gather}

\item The combination of the symplectic and orthogonal group conditions on $%
\left[ \widehat{\mathcal{J}\left( T\right) }^{-1}\right] \left( Z\right) $ $%
\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{R}}\right) $ gives

$\lceil $%
\begin{eqnarray}
a^{t}a+b^{t}b &=&1 \\
a^{t}b &=&b^{t}a
\end{eqnarray}%
\begin{eqnarray}
b^{t}a &=&a^{t}b \\
a^{t}a+b^{t}b &=&1
\end{eqnarray}%
$\rfloor $ 
\begin{gather}
\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}_{T\left( e\right)
}\left( Z\right) +\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}%
_{T\left( e\right) }\left( Z\right) =I_{r} \\
\func{Im}_{T\left( e\right) }\left( Z\right) ^{t}\func{Re}_{T\left( e\right)
}\left( Z\right) -\func{Re}_{T\left( e\right) }\left( Z\right) ^{t}\func{Im}%
_{T\left( e\right) }\left( Z\right) =0
\end{gather}%
as the orthogonal and symplectic conditions \underline{\emph{are the \emph{sa%
}me}} for real transformations $X\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{%
R}}\right) $ that correspond to complex transformations i.e. for $X$ and $Z$ 
\begin{equation}
Z=\widehat{\mathcal{J}\left( T\right) }\left( X\right) \in \mathcal{B}\left( 
\mathfrak{h}_{\mathbb{C}\left( T\right) }\right) \Longleftrightarrow X=%
\widehat{\mathcal{J}\left( T\right) }^{-1}\left( Z\right) \in \mathcal{B}%
\left( \mathfrak{h}_{\mathbb{R}}\right) .
\end{equation}

\begin{lemma}
\begin{equation}
u\in U\left( \mathfrak{h}_{\mathbb{C}\left( T\right) }\right)
\Longleftrightarrow \left( \widehat{\mathcal{J}\left( T\right) }^{-1}\left(
u\right) \in O\left( \mathfrak{h}_{\mathbb{R}}\right) \text{ and }\widehat{%
\mathcal{J}\left( T\right) }^{-1}\left( u\right) \in Sp\left( \mathfrak{h}_{%
\mathbb{R}}\right) \right) .
\end{equation}

\begin{proof}
This comes from the definition of $\left\langle \left. {}\right\vert
\right\rangle _{\mathfrak{h}_{\mathbb{C}\left( T\right) }}$ in terms of $%
\left( \left. {}\right\vert \right) _{\mathfrak{h}_{\mathbb{R}}}$ and $%
\left\{ \left. {}\right\vert \right\} _{\mathfrak{h}_{\mathbb{R}}\left(
T\right) }.$
\end{proof}
\end{lemma}
\end{enumerate}
\end{remark}

\begin{remark}
Unitary representations $\mathcal{R}_{\varphi }\left( \mathcal{G}%
_{can}\left( r\right) \right) $ of the Canonical Transformation Group $%
\mathcal{G}_{can}\left( r\right) \subset U\left( 2r\right) $%
\begin{equation}
\mathcal{R}_{\varphi }\left( \mathcal{U}_{can}\right) =\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) & \overline{\mathcal{R}_{\varphi
}\left( V\right) } \\ 
\mathcal{R}_{\varphi }\left( V\right) & \overline{\mathcal{R}_{\varphi
}\left( U\right) }%
\end{array}%
\right)
\end{equation}%
can be transformed into real form by 
\begin{gather}
\left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{1}{\sqrt{2}}\mathbb{I}_{r} \\ 
-\frac{i}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) & \overline{\mathcal{R}_{\varphi
}\left( V\right) } \\ 
\mathcal{R}_{\varphi }\left( V\right) & \overline{\mathcal{R}_{\varphi
}\left( U\right) }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r} \\ 
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{-i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}%
\right) =\frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) & \overline{\mathcal{R}_{\varphi
}\left( V\right) } \\ 
\mathcal{R}_{\varphi }\left( V\right) & \overline{\mathcal{R}_{\varphi
}\left( U\right) }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) \\
=\frac{1}{2}\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) +\mathcal{R}_{\varphi }\left( V\right)
& \overline{\mathcal{R}_{\varphi }\left( V\right) }+\overline{\mathcal{R}%
_{\varphi }\left( U\right) } \\ 
i\mathcal{R}_{\varphi }\left( V\right) -i\mathcal{R}_{\varphi }\left(
U\right) & i\overline{\mathcal{R}_{\varphi }\left( U\right) }-i\overline{%
\mathcal{R}_{\varphi }\left( V\right) }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r} \\ 
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{-i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}%
\right) \\
=\frac{1}{2}\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) +\mathcal{R}_{\varphi }\left( V\right)
+\overline{\mathcal{R}_{\varphi }\left( V\right) }+\overline{\mathcal{R}%
_{\varphi }\left( U\right) } & i\left( \mathcal{R}_{\varphi }\left( U\right)
+\mathcal{R}_{\varphi }\left( V\right) -\overline{\mathcal{R}_{\varphi
}\left( V\right) }-\overline{\mathcal{R}_{\varphi }\left( U\right) }\right)
\\ 
i\left( \mathcal{R}_{\varphi }\left( V\right) -\mathcal{R}_{\varphi }\left(
U\right) +\overline{\mathcal{R}_{\varphi }\left( U\right) }-\overline{%
\mathcal{R}_{\varphi }\left( V\right) }\right) & -\mathcal{R}_{\varphi
}\left( V\right) +\mathcal{R}_{\varphi }\left( U\right) +\overline{\mathcal{R%
}_{\varphi }\left( U\right) }-\overline{\mathcal{R}_{\varphi }\left(
V\right) }%
\end{array}%
\right) \\
=\left( 
\begin{array}{cc}
\func{Re}\left( \mathcal{R}_{\varphi }\left( U+V\right) \right) & -\func{Im}%
\left( \mathcal{R}_{\varphi }\left( U+V\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi }\left( U-V\right) \right) & \func{Re}%
\left( \mathcal{R}_{\varphi }\left( U-V\right) \right)%
\end{array}%
\right) =\mathcal{R}_{x}\left( \mathcal{U}_{can}\right) ,
\end{gather}%
which shows that 
\begin{equation}
\mathcal{G}_{can}\left( r\right) \cong O\left( 2r,\mathbb{R}\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
U,V\in \mathcal{B}\left( \mathfrak{H}\right) .
\end{equation}
\end{remark}

\begin{remark}
The complexifications $\mathcal{J}\left( T\right) ,$ $T\in O\left( 2r,%
\mathbb{R}\right) $ of $\mathfrak{h}$ is $\mathfrak{H}$ and their dimensions
are 
\begin{eqnarray}
\mathbb{R}\text{-}\dim \left\{ \mathfrak{h}\right\} &=&2r \\
\mathbb{C}\text{-}\dim \left\{ \mathfrak{H}\right\} &=&r.
\end{eqnarray}
\end{remark}

\begin{definition}
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{h=h}_{1}\left( T\right) \oplus _{\mathbb{R}}\mathfrak{h}_{2}\left(
T\right) ,\quad T\in O\left( 2r,\mathbb{R}\right)
\end{equation}

\item 
\begin{equation}
\mathfrak{h}_{\mathbb{R}}=\mathfrak{h}\oplus _{\mathbb{R}}\mathfrak{h}
\end{equation}

\item 
\begin{equation}
\mathfrak{h}_{\mathbb{C}}=\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
\begin{eqnarray}
\mathbb{R}\text{-}\dim \left\{ \mathfrak{h}_{\mathbb{R}}\right\} &=&4r \\
\mathbb{C}\text{-}\dim \left\{ \mathfrak{h}_{\mathbb{C}}\right\} &=&2r.
\end{eqnarray}
\end{remark}

\begin{definition}
Representations $\mathcal{R\in B}\left( \mathcal{M}\left( \overset{}{2r,2r,%
\mathbb{C}}\right) ,\mathcal{G}_{can}\left( \overset{}{r}\right) \right) $
of $\mathcal{G}_{can}\left( r\right) $ 
\begin{eqnarray}
\mathcal{R}_{x} &:&\mathcal{G}_{can}\left( r\right) \rightarrow \mathcal{M}%
\left( 2r,2r,\mathbb{R}\right) \\
\mathcal{R}_{\varphi } &:&\mathcal{G}_{can}\left( r\right) \rightarrow 
\mathcal{M}\left( 2r,2r,\mathbb{C}\right) \subset \mathcal{M}\left( 2r,2r,%
\mathbb{R}\right)
\end{eqnarray}%
\begin{equation}
\mathcal{R}_{x}\left( \mathcal{U}_{can}\right) =\left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r} \\ 
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{-i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) & \overline{\mathcal{R}_{\varphi
}\left( V\right) } \\ 
\mathcal{R}_{\varphi }\left( V\right) & \overline{\mathcal{R}_{\varphi
}\left( U\right) }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r} \\ 
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{-i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}%
\right) =\mathcal{R}_{\varphi }\left( K_{a}^{-1}\right) \mathcal{R}_{\varphi
}\left( \mathcal{U}_{can}\right) \mathcal{R}_{\varphi }\left( K_{a}\right) ,
\end{equation}%
where%
\begin{equation}
\mathcal{R}_{\varphi }\left( K_{a}\right) =\left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r} \\ 
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{-i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
K_{a}\in U\left( \mathfrak{h}_{\mathbb{C}}\right) \cong U\left( 2r\right)
\subset \mathcal{B}\left( \mathfrak{h}_{\mathbb{C}}\right) \cong \mathcal{B}%
\left( 2r,\mathbb{C}\right) .
\end{equation}
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) =\boldsymbol{a}%
^{\dagger }
\end{equation}

\item 
\begin{equation}
\mathcal{J}\left( T\right) \left( \boldsymbol{e}\right) =\mathbf{\varphi }
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{J}\left( T\right) :\mathfrak{h}_{1}\left( T\right) \oplus _{\mathbb{%
R}}J\left( T\right) \mathfrak{h}_{1}\left( T\right) \rightarrow \mathfrak{H}
\end{equation}%
\begin{eqnarray}
\mathcal{J}\left( T\right) \left( e_{1}\right) &=&\varphi _{1} \\
\mathcal{J}\left( T\right) \left( e_{1+r}\right) &=&\mathcal{J}\left(
T\right) \left( J\left( T\right) e_{1}\right) =i\varphi _{1} \\
\mathcal{J}\left( T\right) \left( e_{1}\right) +i\mathcal{J}\left( T\right)
\left( e_{1+r}\right) &=&0
\end{eqnarray}%
Thus $\mathcal{J}\left( T\right) \left( e_{1}\right) $ and $\mathcal{J}%
\left( T\right) \left( e_{1+r}\right) $ are $\mathbb{C}$-linearly dependent. 
\begin{equation}
\mathcal{J}\left( T\right) \left( e_{1}-J\left( T\right) e_{1}\right) =%
\mathcal{J}\left( T\right) \left( e_{1}\right) -\mathcal{J}\left( T\right)
\left( J\left( T\right) e_{1}\right)
\end{equation}
\end{remark}

\begin{remark}
The maps $\mathcal{J}\left( T\right) $ and $\widehat{\mathcal{J}\left(
T\right) }$ are \emph{not linear} but are maps between normed spaces thus
can be treated as topological maps.
\end{remark}

\begin{remark}
\begin{enumerate}
\item Isomorphism is a more general term than homeomorphism. An isomorphism
is a bijective function between two algebraic structures that preserves the
operations of the structures. For example, an isomorphism between two groups
is a bijective function between the groups that preserves the group
operation (addition).

\item A homeomorphism is a bijective function between two topological spaces
that preserves the topological properties of the spaces. For example, a
homeomorphism between two circles is a bijective function between the
circles that preserves the continuity of open sets.

\item It is important to note that every homeomorphism is also an
isomorphism. However, the converse is not necessarily true.
\end{enumerate}
\end{remark}

\begin{lemma}
$\mathcal{J}\left( T\right) \in \mathcal{B}_{\mathbb{R}}\left( \mathfrak{H},%
\mathfrak{h}\right) $ is bijective (injective and surjective) i.e,%
\begin{equation}
\ker \left\{ \mathcal{J}\left( T\right) \right\} =\phi
\end{equation}%
and%
\begin{equation}
\limfunc{Ran}\left\{ \mathcal{J}\left( T\right) \right\} =\mathfrak{H}
\end{equation}%
and thus is a homeomorpism $\equiv $ topological isomorphism.
\end{lemma}

\begin{proof}
If $v\in \mathfrak{H}$ then 
\begin{equation}
v\rightarrow \left( \func{Re}_{\varphi \left( Te\right) }\left( v\right) ,%
\func{Im}_{\varphi \left( Te\right) }\left( v\right) \right) =\left(
x_{1},x_{2}\right) =\mathcal{J}\left( T\right) \left( x\right) ,\quad \quad
x\in \mathfrak{h},x_{1}\in \mathfrak{h}_{1}\left( T\right) ,x_{2}\in 
\mathfrak{h}_{2}\left( T\right) ,v\in \mathfrak{H}.
\end{equation}%
If $x\in \mathfrak{h}$ then 
\begin{equation}
x=\left( x_{1},x_{2}\right) =\left( \func{Re}_{\varphi \left( Te\right)
}\left( v\right) ,\func{Im}_{\varphi \left( Te\right) }\left( v\right)
\right) \rightarrow v,\quad x\in \mathfrak{h},x_{1}\in \mathfrak{h}%
_{1}\left( T\right) ,x_{2}\in \mathfrak{h}_{2}\left( T\right) ,v\in 
\mathfrak{H}.
\end{equation}
\end{proof}

\begin{lemma}
$\widehat{\mathcal{J}\left( T\right) }$ $\in \mathcal{B}_{\mathbb{R}}\left( 
\mathcal{B}\left( \mathfrak{H}\right) ,\mathcal{B}\left( \mathfrak{h}\right)
\right) $ is surjective i.e,%
\begin{equation}
\limfunc{Ran}\left\{ \widehat{\mathcal{J}\left( T\right) }\right\} =\mathcal{%
B}\left( \mathfrak{H}\right) \mathfrak{.}
\end{equation}
\end{lemma}

\begin{proof}
If $Z=\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( X\right)
\in \mathcal{B}\left( \mathfrak{H}\right) $ where 
\begin{equation}
X=\left\vert \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right\rangle
\left\langle \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right\vert 
\mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{1}\left(
T\right) \mathfrak{h}_{1}\left( T\right) }+\left\vert \boldsymbol{e}_{%
\mathfrak{h}_{1}}\left( T\right) \right\rangle \left\langle \boldsymbol{e}_{%
\mathfrak{h}_{2}}\left( T\right) \right\vert \mathfrak{R}_{e\left( T\right)
}\left( X\right) _{\mathfrak{h}_{1}\left( T\right) \mathfrak{h}_{2}\left(
T\right) }+\left\vert \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right)
\right\rangle \left\langle \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right)
\right\vert \mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}%
_{2}\left( T\right) \mathfrak{h}_{1}\left( T\right) }+\left\vert \boldsymbol{%
e}_{\mathfrak{h}_{2}}\left( T\right) \right\rangle \left\langle \boldsymbol{e%
}_{\mathfrak{h}_{2}}\left( T\right) \right\vert \mathfrak{R}_{e\left(
T\right) }\left( X\right) _{\mathfrak{h}_{2}\left( T\right) \mathfrak{h}%
_{2}\left( T\right) }
\end{equation}%
then%
\begin{eqnarray}
Z &=&\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( X\right) =%
\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \overset{}{%
\left\vert \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right\rangle
\left\langle \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right\vert }%
\right) \mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}%
_{1}\left( T\right) \mathfrak{h}_{1}\left( T\right) }+\left[ \widehat{%
\mathcal{J}\left( T\right) }\right] \left( \overset{}{\left\vert \boldsymbol{%
e}_{\mathfrak{h}_{1}}\left( T\right) \right\rangle \left\langle \boldsymbol{e%
}_{\mathfrak{h}_{2}}\left( T\right) \right\vert }\right) \mathfrak{R}%
_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{1}\left( T\right) 
\mathfrak{h}_{2}\left( T\right) } \\
&&+\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \overset{}{%
\left\vert \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right) \right\rangle
\left\langle \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right) \right\vert }%
\right) \mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}%
_{2}\left( T\right) \mathfrak{h}_{1}\left( T\right) }+\left[ \widehat{%
\mathcal{J}\left( T\right) }\right] \left( \overset{}{\left\vert \boldsymbol{%
e}_{\mathfrak{h}_{2}}\left( T\right) \right\rangle \left\langle \boldsymbol{e%
}_{\mathfrak{h}_{2}}\left( T\right) \right\vert }\right) \mathfrak{R}%
_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{2}\left( T\right) 
\mathfrak{h}_{2}\left( T\right) }
\end{eqnarray}%
giving%
\begin{eqnarray}
Z &=&\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{1}\left(
T\right) \mathfrak{h}_{1}\left( T\right) }+\left\vert \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right)
\right\rangle \left\langle \boldsymbol{\varphi }\left( \boldsymbol{e}_{%
\mathfrak{h}_{2}}\left( T\right) \right) \right\vert \mathfrak{R}_{e\left(
T\right) }\left( X\right) _{\mathfrak{h}_{1}\left( T\right) \mathfrak{h}%
_{2}\left( T\right) } \\
&&+\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{2}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{2}\left(
T\right) \mathfrak{h}_{1}\left( T\right) }+\left\vert \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right) \right)
\right\rangle \left\langle \boldsymbol{\varphi }\left( \boldsymbol{e}_{%
\mathfrak{h}_{2}}\left( T\right) \right) \right\vert \mathfrak{R}_{e\left(
T\right) }\left( X\right) _{\mathfrak{h}_{2}\left( T\right) \mathfrak{h}%
_{2}\left( T\right) } \\
&=&\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Re}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right)
+i\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Im}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) \\
&&+i\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Im}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right)
+\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{2}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Re}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) \\
&=&2\left( \left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h%
}_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi 
}\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Re}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right)
+i\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Im}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) \right) \\
&=&2\left( \left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h%
}_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi 
}\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert
\left( \mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Re%
}_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) +%
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( i\func{Im}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) \right)
\right) \\
&=&\left\vert \boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}%
_{1}}\left( T\right) \right) \right\rangle \left\langle \boldsymbol{\varphi }%
\left( \boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) \right\vert 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( Z\right)
\end{eqnarray}%
as 
\begin{equation}
\boldsymbol{\varphi }\left( \boldsymbol{e}_{\mathfrak{h}_{2}}\left( T\right)
\right) =\boldsymbol{\varphi }\left( J\left( T\right) \boldsymbol{e}_{%
\mathfrak{h}_{1}}\left( T\right) \right) =i\boldsymbol{\varphi }\left( 
\boldsymbol{e}_{\mathfrak{h}_{1}}\left( T\right) \right) .
\end{equation}
\end{proof}

\begin{lemma}
$\widehat{\mathcal{J}\left( T\right) }$ $\in \mathcal{B}_{\mathbb{R}}\left( 
\mathcal{B}\left( \mathfrak{H}\right) ,\mathcal{B}\left( \mathfrak{h}\right)
\right) $ is injective i.e. 
\begin{equation}
\ker \left\{ \widehat{\mathcal{J}\left( T\right) }\right\} =\phi \mathfrak{.}
\end{equation}
\end{lemma}

\begin{proof}
\begin{gather}
\mathfrak{R}_{x\left( T\left( e\right) \right) }\left( \overset{}{Z}\right)
=\left( 
\begin{array}{cc}
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Re}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) & -%
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Im}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) \\ 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Im}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right) & 
\mathfrak{R}_{\varphi \left( T\left( e\right) \right) }\left( \func{Re}%
_{\varphi \left( T\left( e\right) \right) }\left( Z\right) \right)%
\end{array}%
\right) =\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( 
\begin{array}{cc}
\mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{1}\left(
T\right) \mathfrak{h}_{1}\left( T\right) } & \mathfrak{R}_{e\left( T\right)
}\left( X\right) _{\mathfrak{h}_{1}\left( T\right) \mathfrak{h}_{2}\left(
T\right) } \\ 
-\mathfrak{R}_{e\left( T\right) }\left( X\right) _{\mathfrak{h}_{1}\left(
T\right) \mathfrak{h}_{2}\left( T\right) } & \mathfrak{R}_{e\left( T\right)
}\left( X\right) _{\mathfrak{h}_{1}\left( T\right) \mathfrak{h}_{1}\left(
T\right) }%
\end{array}%
\right) \\
=\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \mathfrak{R}%
_{e\left( T\right) }\left( \overset{}{X}\right) \right) .
\end{gather}%
The representations of $X$ that produce complex transformations $Z\in 
\mathcal{B}\left( \mathfrak{H}\right) \cong \mathcal{B}\left( \mathbb{C}%
^{r}\right) $ are of the form 
\begin{equation}
\mathfrak{R}_{e\left( T\right) }\left( \overset{}{X}\right) =\left( 
\begin{array}{cc}
X_{1} & -X_{2} \\ 
X_{2} & X_{1}%
\end{array}%
\right) ,
\end{equation}%
where $X\in \mathcal{B}\left( \mathfrak{h}\right) \cong \mathcal{B}\left( 
\mathbb{R}^{2r}\right) $ and $X_{1}$ and $X_{2}$ are arbitary thus produce 
\emph{uniquely any} $\mathfrak{R}_{\varphi \left( T\left( e\right) \right)
}\left( \overset{}{Z}\right) .$
\end{proof}

\begin{corollary}
$\widehat{\mathcal{J}\left( T\right) }$ is a homeomorphism.
\end{corollary}

\begin{lemma}
$\widehat{\mathcal{J}\left( T\right) }$ $\in \mathcal{B}_{\mathbb{R}}\left( 
\mathcal{B}\left( \mathfrak{H}\right) ,\mathcal{B}\left( \mathfrak{h}\right)
\right) $ is an algebra map i.e., 
\begin{equation}
\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( XY\right) =\left( %
\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( X\right) \right)
\left( \left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( Y\right)
\right) .
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
w=Zv=\left[ \left[ \widehat{\mathcal{J}\left( T\right) }\right] \left(
X\right) \right] \left( v\right) =\left[ \mathcal{J}\left( T\right) X%
\mathcal{J}\left( T\right) ^{-1}\right] \left( v\right) =\left[ \mathcal{J}%
\left( T\right) X\right] \left( x\right) =\left[ \mathcal{J}\left( T\right) %
\right] \left( X\left( x\right) \right) =\left[ \mathcal{J}\left( T\right) %
\right] \left( y\right) =w.
\end{equation}
\end{proof}

\begin{remark}
\begin{equation}
J\left( T\right) ^{2}=-I_{\mathfrak{h}}
\end{equation}%
\begin{eqnarray}
\widehat{\mathcal{J}\left( T\right) }\left( J\left( T\right) \right) &=&i \\
\widehat{\mathcal{J}\left( T\right) }\left( I_{\mathfrak{h}}\right) &=&I_{%
\mathfrak{H}}
\end{eqnarray}%
\begin{equation}
\widehat{\mathcal{J}\left( T\right) }\left( X-Y\right) =0\overset{?}{%
\Leftrightarrow }X=Y
\end{equation}
\end{remark}

\begin{remark}
The complexification 
\begin{equation}
\widehat{\mathcal{J}\left( T\right) }\in \mathcal{B}_{\mathbb{R}}\left( 
\mathcal{B}\left( \mathfrak{H}\right) ,\mathcal{B}\left( \mathfrak{h}\right)
\right)
\end{equation}%
and hence maps 
\begin{equation}
\widehat{\mathcal{J}\left( T\right) }:\mathcal{B}\left( \mathfrak{h}\right)
\rightarrow \mathcal{B}\left( \mathfrak{H}\right)
\end{equation}%
its inverse 
\begin{equation}
\left[ \widehat{\mathcal{J}\left( T\right) }\right] ^{-1}:\mathcal{B}\left( 
\mathfrak{H}\right) \rightarrow \mathcal{B}\left( \mathfrak{h}\right)
\end{equation}%
and has the effect%
\begin{equation}
\left[ \widehat{\mathcal{J}\left( T\right) }\right] ^{-1}\left( Z\right)
=\left( 
\begin{array}{cc}
X_{1} & -X_{2} \\ 
X_{2} & X_{1}%
\end{array}%
\right) \equiv \mathfrak{R}_{\mathfrak{h}_{1}}\left( \left[ \widehat{%
\mathcal{J}\left( T\right) }\right] ^{-1}\left( Z\right) \right) .
\end{equation}
\end{remark}

\begin{remark}
If the complex transformation $Z$ is canonical and then it has a real
representation $\mathcal{R}_{x}\left( \mathcal{U}_{can}\right) \in \mathcal{M%
}\left( 2r,\mathbb{R}\right) $ given by 
\begin{equation}
\mathcal{R}_{x}\left( \mathcal{U}_{can}\right) =\left( 
\begin{array}{cc}
\func{Re}\left( \mathcal{R}_{\varphi }\left( U+V\right) \right) & -\func{Im}%
\left( \mathcal{R}_{\varphi }\left( U+V\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi }\left( U-V\right) \right) & \func{Re}%
\left( \mathcal{R}_{\varphi }\left( U-V\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
X_{1} & -X_{2} \\ 
X_{2} & X_{1}%
\end{array}%
\right) \equiv \mathfrak{R}_{x}\left( \mathcal{U}_{can}\right) ,
\end{equation}%
which gives 
\begin{eqnarray}
\func{Re}\left( \mathcal{R}_{\varphi }\left( U+V\right) \right) &=&\func{Re}%
\left( \mathcal{R}_{\varphi }\left( U-V\right) \right) \Rightarrow \func{Re}%
\left( \mathcal{R}_{\varphi }\left( V\right) \right) =0 \\
\func{Im}\left( \mathcal{R}_{\varphi }\left( U+V\right) \right) &=&\func{Im}%
\left( \mathcal{R}_{\varphi }\left( U-V\right) \right) \Rightarrow \func{Im}%
\left( \mathcal{R}_{\varphi }\left( V\right) \right) =0
\end{eqnarray}%
hence 
\begin{equation}
\mathcal{R}_{x}\left( \left[ \widehat{\mathcal{J}\left( T\right) }\right]
^{-1}\left( \mathcal{U}_{can}\right) \right) =\left( 
\begin{array}{cc}
\func{Re}\left( \mathcal{R}_{\varphi }\left( U\right) \right) & -\func{Im}%
\left( \mathcal{R}_{\varphi }\left( U\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi }\left( U\right) \right) & \func{Re}%
\left( \mathcal{R}_{\varphi }\left( U\right) \right)%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\widehat{\mathcal{J}\left( T\right) }\left( \left( 
\begin{array}{cc}
\func{Re}\left( \mathcal{R}_{\varphi }\left( U\right) \right) & -\func{Im}%
\left( \mathcal{R}_{\varphi }\left( U\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi }\left( U\right) \right) & \func{Re}%
\left( \mathcal{R}_{\varphi }\left( U\right) \right)%
\end{array}%
\right) \right) =\left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) & \mathbb{O} \\ 
\mathbb{O} & \overline{\mathcal{R}_{\varphi }\left( U\right) }%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{definition}
The $\ast $-representations $\Pi _{1}\left( \mathcal{A}\right) $ and $\Pi
_{2}\left( \mathcal{A}\right) $ of the algebra $\mathcal{A}$ on the Hilbert
spaces $\Phi _{1}\left( \mathcal{A}\right) $ and $\Phi _{2}\left( \mathcal{A}%
\right) $ are unitarily equivalent$\ $if there is a unitary operator $U\in 
\mathcal{B}\left( \mathcal{H}_{2},\mathcal{H}_{1}\right) $ from $\mathcal{H}%
_{1}=\Phi _{1}\left( \mathcal{A}\right) \rightarrow $ $\mathcal{H}_{2}=$ $%
\Phi _{2}\left( \mathcal{A}\right) $ such that 
\begin{equation}
\Pi _{2}\left( A\right) =U\Pi _{1}\left( A\right) U^{\dagger }
\end{equation}
for all $A$ in $\mathcal{A},$ otherwise they are unitarily inequivalent.
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{T\left( e\right) }\left( T\left( e_{1}\right) \right) ,\cdots ,%
\mathcal{R}_{T\left( e\right) }\left( T\left( e_{r}\right) \right) ,\mathcal{%
R}_{T\left( e\right) }\left( T\left( e_{r+1}\right) \right) ,\cdots ,%
\mathcal{R}_{T\left( e\right) }\left( T\left( e_{2r}\right) \right) =\left( 
\begin{array}{c}
1_{1} \\ 
0%
\end{array}%
\right) ,\cdots ,\left( 
\begin{array}{c}
1_{r} \\ 
0%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
0 & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
1_{1} \\ 
0%
\end{array}%
\right) ,\cdots ,\left( 
\begin{array}{cc}
0 & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
1_{r} \\ 
0%
\end{array}%
\right)
\end{equation}

\item 
\begin{eqnarray}
\mathcal{R}_{e}\left( e_{n}\right) &=&1_{n}=\left( 
\begin{array}{c}
\mathbf{0}_{n} \\ 
1 \\ 
\mathbf{0}_{r-n-1}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\mathbf{0}_{n} \\ 
1 \\ 
\mathbf{0}_{r-n-1} \\ 
\mathbf{0}_{r-n-1}%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( Je_{n}\right) &=&1_{r+n}=\left( 
\begin{array}{c}
\mathbf{0}_{n} \\ 
1 \\ 
\mathbf{0}_{r-n-1} \\ 
\mathbf{0}_{r-n-1}%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
\sigma _{e}\longleftrightarrow \left[ e\right] \longleftrightarrow \func{Re}%
_{e}\longleftrightarrow \func{Im}_{e}\longleftrightarrow J_{e}
\end{equation}
\end{remark}

\begin{remark}
The Majorano map $\mathfrak{X\in }$ $\mathcal{B}\left( \mathcal{A}%
_{1}^{Cliff},\mathfrak{\mathfrak{h}}_{1}\oplus \mathfrak{\mathfrak{h}}%
_{2}\right) $ $\equiv \mathcal{B}\left( \mathcal{A}_{1}^{Cliff},\mathfrak{%
\mathfrak{h}}_{\mathbb{R}}\right) $ \emph{is a real map} 
\begin{equation}
\mathfrak{X:\mathfrak{h}}_{1}\mathfrak{\oplus _{\mathbb{R}}\mathfrak{h}}_{2}=%
\mathfrak{h}_{1}\oplus _{\mathbb{R}}J\left( T\right) \mathfrak{h}%
_{1}\rightarrow \mathcal{A}_{1}^{Cliff},
\end{equation}%
where $\dim \left\{ \mathfrak{\mathfrak{h}}_{1}\right\} =\dim \left\{ 
\mathfrak{\mathfrak{h}}_{2}\right\} =r$ and $J\left( T\right) \in \mathcal{B}%
\left( \mathfrak{\mathfrak{h}}_{1}\mathfrak{\oplus _{\mathbb{R}}\mathfrak{h}}%
_{2}\right) ,$ where $T\in O\left( \mathfrak{\mathfrak{h}}_{1}\mathfrak{%
\oplus _{\mathbb{R}}\mathfrak{h}}_{2}\right) $ is a complex unit.
\end{remark}

\begin{remark}
\begin{enumerate}
\item A real vector $x\in \mathfrak{\mathfrak{h}}_{\mathbb{R}}$ can be
identified with a complex vector $v\in \mathfrak{h}_{\mathbb{C}\left(
T\right) }$ by

\begin{enumerate}
\item 
\begin{equation}
v=\left[ \mathcal{J}\left( T\right) \right] \left( x\right) =\func{Re}%
_{T\left( e\right) }\left( v\right) +i\func{Im}_{T\left( e\right) }\left(
v\right) ,
\end{equation}%
where 
\begin{equation}
x=\left( 
\begin{array}{c}
\func{Re}_{T\left( e\right) }\left( v\right) \\ 
\func{Im}_{T\left( e\right) }\left( v\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\func{Re}_{T\left( e\right) }\left( v\right) \\ 
0%
\end{array}%
\right) +J\left( T\right) \left( 
\begin{array}{c}
\func{Im}_{T\left( e\right) }\left( v\right) \\ 
0%
\end{array}%
\right)
\end{equation}%
and inversely

\item a complex vector $v\in \mathfrak{h}_{\mathbb{C}\left( T\right) }$ with
a real vector a real vector $x\in \mathfrak{\mathfrak{h}}_{\mathbb{R}}$ 
\begin{equation}
x=\left[ \mathcal{J}\left( T\right) \right] ^{-1}\left( v\right) =\left[ 
\mathcal{J}\left( T\right) \right] ^{-1}\left( \func{Re}_{T\left( e\right)
}\left( v\right) +i\func{Im}_{T\left( e\right) }\left( v\right) \right) .
\end{equation}
\end{enumerate}

\item A real transformation $X\in \mathcal{B}\left( \mathfrak{\mathfrak{h}}%
_{1}\oplus \mathfrak{\mathfrak{h}}_{2}\right) \equiv \mathcal{B}\left( 
\mathfrak{\mathfrak{h}}_{\mathbb{R}}\right) $ can be identified with a
complex transformation $Z\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{C}%
\left( T\right) }\right) $ by

\begin{enumerate}
\item the complexification map $\widehat{\mathcal{J}\left( T\right) }\in 
\mathcal{B}\left( \mathcal{B}\left( \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right) ,\mathcal{B}\left( \mathfrak{\mathfrak{h}}_{\mathbb{R}}\right)
\right) $ 
\begin{equation}
Z=\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \overset{}{X}%
\right) \in \mathcal{B}\left( \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right) ,
\end{equation}
i.e.%
\begin{equation}
Z=\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \overset{}{X}%
\right) :\mathfrak{h}_{\mathbb{C}\left( T\right) }\rightarrow \mathfrak{h}_{%
\mathbb{C}\left( T\right) }
\end{equation}%
and inversely

\item a complex transformation $Z\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{%
C}\left( T\right) }\right) $ can be identified with a real transformation $%
X\in \mathcal{B}\left( \mathfrak{\mathfrak{h}}_{1}\oplus \mathfrak{\mathfrak{%
h}}_{2}\right) \equiv \mathcal{B}\left( \mathfrak{\mathfrak{h}}_{\mathbb{R}%
}\right) $ by 
\begin{gather}
X=\left[ \widehat{\mathcal{J}\left( T\right) }\right] ^{-1}\left( Z\right) =%
\left[ \widehat{\mathcal{J}\left( T\right) }\right] ^{-1}\left( \overset{}{%
\func{Re}_{T\left( e\right) }\left( Z\right) +i\func{Im}_{T\left( e\right)
}\left( Z\right) }\right) =\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
0 & 0%
\end{array}%
\right) +J\left( T\right) \left( 
\begin{array}{cc}
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right) \\ 
0 & 0%
\end{array}%
\right) .
\end{gather}
\end{enumerate}

\item Let $Z\in \mathcal{B}\left( \mathfrak{h}_{\mathbb{C}\left( T\right)
}\right) $ and $v\in \mathfrak{h}_{\mathbb{C}\left( T\right) }$ then

\begin{enumerate}
\item 
\begin{eqnarray}
Zv &=&\left( \overset{}{\func{Re}_{T\left( e\right) }\left( Z\right) +i\func{%
Im}_{T\left( e\right) }\left( Z\right) }\right) \left( \overset{}{\func{Re}%
_{T\left( e\right) }\left( v\right) +i\func{Im}_{T\left( e\right) }\left(
v\right) }\right) \\
&=&\left( \overset{}{\func{Re}_{T\left( e\right) }\left( Z\right) \func{Re}%
_{T\left( e\right) }\left( v\right) -\func{Im}_{T\left( e\right) }\left(
Z\right) \func{Im}_{T\left( e\right) }\left( v\right) }\right) +i\left( 
\overset{}{\func{Im}_{T\left( e\right) }\left( Z\right) \func{Re}_{T\left(
e\right) }\left( v\right) +\func{Re}_{T\left( e\right) }\left( Z\right) 
\func{Im}_{T\left( e\right) }\left( v\right) }\right)
\end{eqnarray}%
and in terms of the complexification maps $\widehat{\mathcal{J}\left(
T\right) }$ and $\mathcal{J}\left( T\right) $

\item 
\begin{eqnarray}
Zv &=&\left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \overset{}{X%
}\right) \left( \overset{}{\left[ \mathcal{J}\left( T\right) \right] \left(
x\right) }\right) =\func{Re}_{T\left( e\right) }\left( \left[ \widehat{%
\mathcal{J}\left( T\right) }\right] \left( \overset{}{X}\right) \right)
\left( \overset{}{\func{Re}_{T\left( e\right) }\left( \left[ \mathcal{J}%
\left( T\right) \right] \left( x\right) \right) }\right) -\func{Im}_{T\left(
e\right) }\left( \left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( 
\overset{}{X}\right) \right) \left( \overset{}{\func{Im}_{T\left( e\right)
}\left( \left[ \mathcal{J}\left( T\right) \right] \left( x\right) \right) }%
\right) \\
&&+i\left( \func{Im}_{T\left( e\right) }\left( \left[ \widehat{\mathcal{J}%
\left( T\right) }\right] \left( \overset{}{X}\right) \right) \left( \overset{%
}{\func{Re}_{T\left( e\right) }\left( \left[ \mathcal{J}\left( T\right) %
\right] \left( x\right) \right) }\right) +\func{Re}_{T\left( e\right)
}\left( \left[ \widehat{\mathcal{J}\left( T\right) }\right] \left( \overset{}%
{X}\right) \right) \left( \overset{}{\func{Im}_{T\left( e\right) }\left( %
\left[ \mathcal{J}\left( T\right) \right] \left( x\right) \right) }\right)
\right) .
\end{eqnarray}

\item The inverse vector complexifiction map $\left[ \mathcal{J}\left(
T\right) \right] ^{-1}$ gives

\begin{enumerate}
\item 
\begin{equation}
\left[ \mathcal{J}\left( T\right) \right] ^{-1}\left( v\right) =\left( 
\begin{array}{c}
\func{Re}_{T\left( e\right) }\left( v\right) \\ 
\func{Im}_{T\left( e\right) }\left( v\right)%
\end{array}%
\right) =\func{Re}_{T\left( e\right) }\left( v\right) \oplus _{\mathbb{R}}%
\func{Im}_{T\left( e\right) }\left( v\right)
\end{equation}%
and

\item 
\begin{equation}
\left[ \mathcal{J}\left( T\right) \right] ^{-1}\left( w\right) =\left( 
\begin{array}{c}
\func{Re}_{T\left( e\right) }\left( w\right) \\ 
\func{Im}_{T\left( e\right) }\left( w\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
\func{Re}_{T\left( e\right) }\func{Re}_{T\left( e\right) }\left( v\right) -%
\func{Im}_{T\left( e\right) }\left( Z\right) \func{Im}_{T\left( e\right)
}\left( v\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) \func{Re}_{T\left( e\right)
}\left( v\right) +\func{Re}_{T\left( e\right) }\left( Z\right) \func{Im}%
_{T\left( e\right) }\left( v\right)%
\end{array}%
\right)
\end{equation}

\item the inverse operator complexifiction map gives%
\begin{gather}
\left[ \widehat{\mathcal{J}\left( T\right) }\right] ^{-1}\left( \overset{}{Z}%
\right) =\left( 
\begin{array}{cc}
\func{Re}_{T\left( e\right) }\left( Z\right) & -\func{Im}_{T\left( e\right)
}\left( Z\right) \\ 
\func{Im}_{T\left( e\right) }\left( Z\right) & \func{Re}_{T\left( e\right)
}\left( Z\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
{\Large \eta } & -{\Large \zeta } \\ 
{\Large \zeta } & {\Large \eta }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
P_{T\mathfrak{h}_{1}}XP_{T\mathfrak{h}_{1}} & -P_{T\mathfrak{h}_{1}}XP_{T%
\mathfrak{h}_{2}} \\ 
P_{T\mathfrak{h}_{1}}XP_{T\mathfrak{h}_{2}} & P_{T\mathfrak{h}_{1}}XP_{T%
\mathfrak{h}_{1}}%
\end{array}%
\right) =X \\
=\sum_{1\leq j,k\leq r}\left\{ \left\vert Te_{j}\right) \left(
Te_{k}\right\vert \mathcal{R}_{Te}\left( X\right) _{jk}-\left\vert
Te_{j}\right) \left( Te_{k+r}\right\vert \mathcal{R}_{Te}\left( X\right)
_{j+rk}+\left\vert Te_{j+r}\right) \left( Te_{k}\right\vert \mathcal{R}%
_{Te}\left( X\right) _{j+rk}+\left\vert Te_{j+r}\right) \left(
Te_{k+r}\right\vert \mathcal{R}_{Te}\left( X\right) _{jk}\right\} \\
=\sum_{1\leq j,k\leq r}\left\{ \left\vert Te_{j}\right) \left(
Te_{k}\right\vert \eta _{jk}-\left\vert Te_{j}\right) \left(
Te_{k+r}\right\vert \mathcal{\zeta }_{jk}+\left\vert Te_{j+r}\right) \left(
Te_{k}\right\vert \mathcal{\zeta }_{jk}+\left\vert Te_{j+r}\right) \left(
Te_{k+r}\right\vert \eta _{jk}\right\} ,
\end{gather}%
where 
\begin{eqnarray}
{\Large \eta } &=&P_{T\mathfrak{h}_{1}}XP_{T\mathfrak{h}_{1}} \\
{\Large \zeta } &=&P_{T\mathfrak{h}_{1}}XP_{T\mathfrak{h}_{2}}.
\end{eqnarray}

