\begin{lemma}
The map $\mathfrak{X}$ is independent of the choice of basis of $\mathfrak{H.%
}$
\end{lemma}

\begin{proof}
\begin{eqnarray}
\mathfrak{X}\left( f\right) &=&\mathfrak{X}\left( \func{Re}_{\varphi }\left(
f\right) +i\func{Im}_{\varphi }\left( f\right) \right) =\mathfrak{X}\left(
\sum_{1\leq j\leq r}\varphi _{j}\left( \func{Re}_{\varphi }\left( f\right)
_{j}+i\func{Im}_{\varphi }\left( f\right) _{j}\right) \right) =\mathfrak{X}%
\left( \func{Re}_{\varphi }\left( f\right) +i\func{Im}_{\varphi }\left(
f\right) \right) =\sum_{1\leq j\leq r}\left\{ \mathfrak{X}\left( \varphi
_{j}\right) \func{Re}_{\varphi }\left( f\right) _{j}+\mathfrak{X}\left(
i\varphi _{j}\right) \func{Im}_{\varphi }\left( f\right) _{j}\right\} \\
&=&\mathfrak{X}\left( \func{Re}_{\psi }\left( f\right) +i\func{Im}_{\psi
}\left( f\right) \right) =\mathfrak{X}\left( \sum_{1\leq j\leq r}\psi
_{j}\left( \func{Re}_{\psi }\left( f\right) _{j}+i\func{Im}_{\psi }\left(
f\right) _{j}\right) \right) =\mathfrak{X}\left( \func{Re}_{\psi }\left(
f\right) +i\func{Im}_{\psi }\left( f\right) \right) =\sum_{1\leq j\leq
r}\left\{ \mathfrak{X}\left( \psi _{j}\right) \func{Re}_{\psi }\left(
f\right) _{j}+\mathfrak{X}\left( i\psi _{j}\right) \func{Im}_{\psi }\left(
f\right) _{j}\right\}
\end{eqnarray}
\end{proof}

\begin{remark}
\begin{equation}
\mathfrak{X}\left( f\right) =\mathfrak{X}\left( \overset{}{\left( \mathbf{%
\varphi }\right) \func{Re}_{\varphi }\left( f\right) +\left( i\mathbf{%
\varphi }\right) \func{Im}_{\varphi }\left( f\right) }\right) =\mathfrak{X}%
\left( \overset{}{\left( 
\begin{array}{cc}
\mathbf{\varphi } & i\mathbf{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}_{\varphi }\left( f\right) \\ 
\func{Im}_{\varphi }\left( f\right)%
\end{array}%
\right) }\right) =\mathfrak{X}\left( \left( 
\begin{array}{cc}
\mathbf{\psi } & i\mathbf{\psi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}_{\psi }\left( f\right) \\ 
\func{Im}_{\psi }\left( f\right)%
\end{array}%
\right) \right)
\end{equation}%
and
\end{remark}

\begin{equation}
\mathfrak{X}\left( f\right) \overset{}{=\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}_{\varphi }\left( f\right) \\ 
\func{Im}_{\varphi }\left( f\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\psi }\right) & \mathfrak{X}\left( i\mathbf{\psi }%
\right)%
