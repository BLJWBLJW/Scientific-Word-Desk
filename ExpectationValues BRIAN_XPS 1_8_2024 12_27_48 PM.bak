\section{Representations of CAR algebras}

\subsection{$C^{\ast }$-Algebra Representations of the CAR Algebra}

\begin{notation}
Let $\mathcal{A}$ be a $c^{\ast }$-algebra with norm $\left\Vert
{}\right\Vert _{\mathcal{A}}.$
\end{notation}

\begin{notation}
Let $\mathfrak{H}$ be a \emph{seperable} Hilbert space of dimension $r$ with
norm $\left\Vert {}\right\Vert _{\mathfrak{H}}$ and inner product $%
\left\langle \left. {}\right\vert \right\rangle _{\mathfrak{H}}$ so that 
\begin{equation}
\left\Vert {}\right\Vert _{\mathfrak{H}}=\sqrt{\left\langle \left.
{}\right\vert \right\rangle _{\mathfrak{H}}}.
\end{equation}
\end{notation}

\begin{notation}
$\left( \boldsymbol{\varphi }\right) $ are conbs of $\mathfrak{H.}$
\end{notation}

\begin{definition}
$\mathfrak{B}\left( \mathfrak{H}\right) $ is the set of conbs of $\mathfrak{%
H.}$
\end{definition}

\begin{notation}
Elements of $\mathfrak{H\times H}$ are denoted as $\left( v_{1},v_{2}\right)
,$ where $v_{1},v_{2}\in \mathfrak{H.}$
\end{notation}

\begin{notation}
Elements of $\mathfrak{H\times H}$ when equipped with a direct sum structure
are denoted as $\left( v_{1},v_{2}\right) _{\oplus },$ where $v_{1},v_{2}\in 
\mathfrak{H.}$
\end{notation}

\begin{notation}
Elements of $\mathfrak{H\times H}$ when equipped with a tensor product
structure are denoted as $\left( v_{1},v_{2}\right) _{\otimes },$ where $%
v_{1},v_{2}\in \mathfrak{H.}$
\end{notation}

\begin{notation}
When the context is obvious or explicitly defined $\left( v_{1},v_{2}\right)
_{\oplus }$ and $\left( v_{1},v_{2}\right) _{\otimes }$ are denoted as $%
\left( v_{1},v_{2}\right) .$
\end{notation}

\begin{definition}
The complex Exterior Hilbert algebra $\tbigwedge \left( \mathfrak{H}\right) $
generated by $\mathfrak{H}$ is 
\begin{equation}
\tbigwedge \left( \mathfrak{H}\right) =\tbigoplus\limits_{0\leq n\leq
r}\tbigwedge\nolimits^{n}\mathfrak{H.}
\end{equation}
\end{definition}

\begin{remark}
The complex conjugation $\sigma _{\mathbb{C}}$ acting on the complex numbers 
\begin{equation}
\sigma _{\mathbb{C}}\left( z\right) =\overline{z}
\end{equation}%
in $\mathbb{C}$ is an algebraic map as 
\begin{eqnarray}
\overline{z_{1}z_{2}} &=&\left( \overline{z_{1}}\right) \left( \overline{%
z_{2}}\right) \\
z_{1}z_{2} &=&\left( x_{1}+iy_{1}\right) \left( x_{2}+iy_{2}\right) =\left(
x_{1}\left( x_{2}+iy_{2}\right) +iy_{1}\left( x_{2}+iy_{2}\right) \right)
=x_{1}x_{2}+x_{1}iy_{2}+iy_{1}x_{2}+iy_{1}iy_{2}=x_{1}x_{2}-y_{1}y_{2}+i%
\left( x_{1}y_{2}+y_{1}x_{2}\right) \\
\overline{z_{1}z_{2}} &=&x_{1}x_{2}-y_{1}y_{2}-i\left(
x_{1}y_{2}+y_{1}x_{2}\right) \\
\left( \overline{z_{1}}\right) \left( \overline{z_{2}}\right) &=&\left(
x_{1}-iy_{1}\right) \left( x_{2}-iy_{2}\right) =\left( x_{1}\left(
x_{2}-iy_{2}\right) -iy_{1}\left( x_{2}-iy_{2}\right) \right)
=x_{1}x_{2}-x_{1}iy_{2}-iy_{1}x_{2}+iy_{1}iy_{2}=x_{1}x_{2}-y_{1}y_{2}-i%
\left( x_{1}y_{2}+y_{1}x_{2}\right) ,
\end{eqnarray}%
i.e.%
\begin{equation}
\sigma _{\mathbb{C}}\left( z_{1}\right) \sigma _{\mathbb{C}}\left(
z_{2}\right) =\sigma _{\mathbb{C}}\left( z_{1}z_{2}\right) .
\end{equation}
\end{remark}

\begin{definition}
Complex conjugations $\sigma _{\left\vert \varphi \right\rangle }\in 
\mathcal{B}_{anti}\left( \mathfrak{H}\right) $ acting in a Hilbert space $%
\mathfrak{H}$ are defined by 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) =\sum_{1\leq
j\leq r}\varphi _{j}\left( \func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) -i\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \right) ,\,\forall v\in \mathfrak{H}.
\end{equation}
\end{definition}

\begin{definition}
The complex conjugate $\sigma _{\left\vert \varphi \right\rangle }\left(
v\right) $ of the vector $v\in \mathfrak{H}$ is defined by 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) =\sum_{1\leq
j\leq r}\varphi _{j}\left( \func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) -i\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \right) =\sum_{1\leq j\leq r}\varphi _{j}\overline{\mathcal{R}%
_{\varphi }\left( v\right) }.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( cf\right) =\overline{c}%
\sigma _{\left\vert \varphi \right\rangle }\left( f\right)
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( zf\right) =\sigma
_{\left\vert \varphi \right\rangle }\left( \sum_{1\leq j\leq r}\left\vert
\varphi _{j}\right\rangle z\mathcal{R}_{\varphi }\left( f\right) _{j}\right)
=\sum_{1\leq j\leq r}\left\vert \varphi _{j}\right\rangle \overline{z%
\mathcal{R}_{\varphi }\left( f\right) _{j}}=\sum_{1\leq j\leq r}\left\vert
\varphi _{j}\right\rangle \overline{z}\overline{\mathcal{R}_{\varphi }\left(
f\right) _{j}}=\overline{z}\sum_{1\leq j\leq r}\left\vert \varphi
_{j}\right\rangle \overline{\mathcal{R}_{\varphi }\left( f\right) _{j}}=%
\overline{z}\sigma _{\left\vert \varphi \right\rangle }\left( f\right) .
\end{equation}
\end{proof}

\begin{definition}
Complex conjugate spaces $\sigma _{\left\vert \varphi \right\rangle }\left( 
\mathfrak{H}\right) $ of $\mathfrak{H}$ are defined by 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( \mathfrak{H}\right) =%
\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \sigma _{\left\vert
\varphi \right\rangle }\left( v\right) \right\vert v\in \mathfrak{H}\right\}
.
\end{equation}
\end{definition}

\begin{remark}
It is obvious that 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( \mathfrak{H}\right) =%
\mathfrak{H\,}\forall \sigma _{\left\vert \varphi \right\rangle }\in 
\mathcal{B}_{anti}\left( \mathfrak{H}\right) .
\end{equation}
\end{remark}

\begin{definition}
The complex unit $J\in \mathcal{B}\left( \mathfrak{H}\right) $ is defined as 
\begin{equation}
Jv=iv,\forall \,v\in \mathfrak{H}
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\circ J=-J\circ \sigma
_{\left\vert \varphi \right\rangle }
\end{equation}%
i.e 
\begin{equation}
\left\{ \sigma _{\left\vert \varphi \right\rangle },J\right\} =0\,\forall
\left( \mathbf{\varphi }\right) \in \mathfrak{B}\left( \mathfrak{H}\right) .
\end{equation}
\end{remark}

\begin{definition}
The real and imaginary parts of a vector wrt a basis $\left( \boldsymbol{%
\varphi }\right) $ of $\mathfrak{H}$ are produced by the the \emph{real
linear} maps $\func{Re}_{\varphi }$ and $\func{Im}_{\varphi }\in \mathcal{B}%
_{\mathbb{R}}\left( \mathfrak{H}\right) $
\end{definition}

\begin{enumerate}
\item The real part map $\func{Re}_{\varphi }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}\right) $ wrt a basis $\left( \boldsymbol{\varphi }%
\right) $ of $\mathfrak{H}$

\begin{enumerate}
\item 
\begin{equation}
\func{Re}_{\varphi }:\mathfrak{H\rightarrow H.}
\end{equation}%
is defined by

\item 
\begin{equation}
\func{Re}_{\varphi }\left( v\right) =\sum_{1\leq j\leq r}\varphi _{j}\func{Re%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) .
\end{equation}
\end{enumerate}

\item The imaginary part map $\func{Im}_{\varphi }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}\right) $ wrt a basis $\left( \boldsymbol{\varphi }%
\right) $ of $\mathfrak{H}$

\begin{enumerate}
\item 
\begin{equation}
\func{Im}_{\varphi }:\mathfrak{H\rightarrow H.}
\end{equation}%
is defined by

\item 
\begin{equation}
\func{Im}_{\varphi }\left( v\right) =\sum_{1\leq j\leq r}\varphi _{j}\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{remark}
The maps $\func{Re}_{\varphi }$ and $\func{Im}_{\varphi }$ are not $\mathbb{C%
}$-linear as 
\begin{equation}
\func{Re}_{\varphi }\left( iv\right) \neq i\func{Re}_{\varphi }\left(
v\right)
\end{equation}%
nor 
\begin{equation}
\func{Im}_{\varphi }\left( iv\right) \neq i\func{Im}_{\varphi }\left(
v\right) .
\end{equation}
\end{remark}

\begin{lemma}
\begin{equation}
\func{Re}_{\varphi }\left( zv\right) \neq z\func{Re}_{\varphi }\left(
v\right) \quad \text{unless }z\in \mathbb{R}
\end{equation}
\end{lemma}

\begin{proof}
\begin{enumerate}
\item 
\begin{equation}
\func{Re}_{\varphi }\left( iv\right) =\func{Re}_{\varphi }\left( i\left( 
\func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right)
\right) \right) =\func{Re}_{\varphi }\left( i\func{Re}_{\varphi }\left(
v\right) -\func{Im}_{\varphi }\left( v\right) \right) =-\func{Im}_{\varphi
}\left( v\right)
\end{equation}

\item 
\begin{equation}
\func{Re}_{\varphi }\left( 1v\right) =\func{Re}_{\varphi }\left( 1\func{Re}%
_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right) \right) =%
\func{Re}_{\varphi }\left( \func{Re}_{\varphi }\left( v\right) +i\func{Im}%
_{\varphi }\left( v\right) \right) =\func{Re}_{\varphi }\left( 1v\right) .
\end{equation}
\end{enumerate}
\end{proof}

\begin{lemma}
\begin{equation}
\func{Im}_{\varphi }\left( zv\right) \neq z\func{Im}_{\varphi }\left(
v\right) \quad \text{unless }z\in \mathbb{R}
\end{equation}
\end{lemma}

\begin{corollary}
\begin{eqnarray}
\func{Re}_{\varphi }\left( z_{1}v_{1}+z_{2}v_{2}\right) &\neq &z_{1}\func{Re}%
_{\varphi }\left( v_{1}\right) +z_{2}\func{Re}_{\varphi }\left( v_{2}\right)
\\
\func{Im}_{\varphi }\left( z_{1}v_{1}+z_{2}v_{2}\right) &\neq &z_{1}\func{Im}%
_{\varphi }\left( v_{1}\right) +z_{2}\func{Im}_{\varphi }\left( v_{2}\right)
.
\end{eqnarray}
\end{corollary}

\begin{corollary}
\begin{equation}
\func{Re}_{\varphi }\left( iv\right) =-\func{Im}_{\varphi }\left( v\right)
\end{equation}%
and 
\begin{equation}
\func{Im}_{\varphi }\left( iv\right) =\func{Re}_{\varphi }\left( v\right) .
\end{equation}
\end{corollary}

\begin{remark}
$\func{Re}_{\varphi }$ and $\func{Im}_{\varphi }$ \emph{are not }injective
as 
\begin{eqnarray}
\func{Re}_{\varphi }\left( v_{1}-v_{2}\right) &=&0\nRightarrow v_{1}=v_{2} \\
\func{Im}_{\varphi }\left( v_{1}-v_{2}\right) &=&0\nRightarrow v_{1}=v_{2}.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{eqnarray}
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) &=&\mathcal{R}%
_{\varphi }\left( \func{Re}_{\varphi }v\right) \\
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) &=&\mathcal{R}%
_{\varphi }\left( \func{Im}_{\varphi }v\right) ,
\end{eqnarray}%
i.e.%
\begin{eqnarray}
\func{Re}\circ \mathcal{R}_{\varphi } &=&\mathcal{R}_{\varphi }\circ \func{Re%
}_{\varphi } \\
\func{Im}\circ \mathcal{R}_{\varphi } &=&\mathcal{R}_{\varphi }\circ \func{Im%
}_{\varphi }.
\end{eqnarray}
\end{remark}

\begin{definition}
$\mathfrak{c}\left( \mathfrak{H}\right) $ is the set of $\func{complex}$
conjugation operators of $\mathfrak{H.}$
\end{definition}

\begin{definition}
$\left[ \boldsymbol{\varphi }\right] $ is the set of \emph{distinct} of
equivalence classes of conbs of $\mathfrak{H,}$ where bases are in same
equivalence class i.e. 
\begin{equation}
\boldsymbol{\varphi }\sim \boldsymbol{\psi }
\end{equation}%
if they are related to each other by transformations belonging to $O\left( 
\mathfrak{H},\mathbb{R}\right) .$
\end{definition}

\begin{definition}
An Operator Representation $\mathfrak{R}_{\mathfrak{H}}$ of a group $G$ 
\begin{equation}
\mathfrak{R}_{\mathfrak{H}}:G\rightarrow \mathfrak{R}_{\mathfrak{H}}\left\{
G\right\} \subset \mathcal{B}\left( \mathfrak{H}\right) 
\end{equation}%
is defined as a group isomorphism from the group $G$ into the set of bounded
operators acting in $\mathfrak{H.}$ If the representation is reducible and 
\begin{equation}
\mathfrak{H=}\bigoplus\limits_{1\leq j\leq d}\mathfrak{V}_{j}
\end{equation}%
then the representation on 
\begin{equation}
\mathfrak{R}_{\mathfrak{H}}:G\rightarrow \mathfrak{R}_{\mathfrak{H}}\left\{
G\right\} \subset \mathcal{B}\left( \mathfrak{H}\right) 
\end{equation}%
is reduced by the direct sum decomposition   
\begin{equation}
\mathfrak{H}=\bigoplus\limits_{1\leq j\leq d}\mathfrak{V}_{j}
\end{equation}%
and is denoted by $\mathfrak{R}_{\mathfrak{H}_{1}\oplus \cdots \oplus 
\mathfrak{H}_{d}}.$
\end{definition}

\begin{notation}
For $g\in G$ 
\begin{equation}
\mathfrak{R}_{\mathfrak{H}_{1}\oplus \cdots \oplus \mathfrak{H}_{d}}\left(
g\right) =\left( 
\begin{array}{ccc}
\mathfrak{R}_{\mathfrak{H}_{1}\mathfrak{H}_{1}}\left( g\right)  & \cdots  & 
\mathfrak{R}_{\mathfrak{H}_{1}\mathfrak{H}_{d}}\left( g\right)  \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathfrak{R}_{\mathfrak{H}_{d}\mathfrak{H}_{1}}\left( g\right)  & \cdots  & 
\mathfrak{R}_{\mathfrak{H}_{d}\mathfrak{H}_{d}}\left( g\right) 
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathfrak{R}\left( g\right) _{\mathfrak{H}_{1}\mathfrak{H}_{1}} & \cdots  & 
\mathfrak{R}\left( g\right) _{\mathfrak{H}_{1}\mathfrak{H}_{d}} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathfrak{R}\left( g\right) _{\mathfrak{H}_{d}\mathfrak{H}_{1}} & \cdots  & 
\mathfrak{R}\left( g\right) _{\mathfrak{H}_{d}\mathfrak{H}_{d}}%
\end{array}%
\right) .
\end{equation}
\end{notation}

\begin{definition}
The irreducible operator representation $\mathfrak{R}_{\mathfrak{H}}$ is the 
\emph{defining representation} of the group $G$ if $\mathfrak{R}_{\mathfrak{H%
}}\left( G\right) \cong G.$ 
\end{definition}

\begin{lemma}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) \neq \sigma
_{\left\vert \psi \right\rangle }\left( v\right) \Leftrightarrow \varphi
\nsim \psi .
\end{equation}
\end{lemma}

\begin{lemma}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( iv\right) =-i\sigma
_{\left\vert \varphi \right\rangle }\left( v\right) \,\forall v\in \mathfrak{%
H,\forall }\left( \boldsymbol{\varphi }\right) \in \left[ \boldsymbol{%
\varphi }\right] \equiv \mathfrak{\forall }\sigma _{\left\vert \varphi
\right\rangle }\in \mathfrak{c}\left( \mathfrak{H}\right) \mathfrak{.}
\end{equation}
\end{lemma}

\begin{lemma}
Complex conjugation maps are real isometric automorphisms of $\mathfrak{H}$
i.e.$\sigma _{\left\vert \varphi \right\rangle }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}\right) $ and  
\begin{equation}
\mathfrak{H}=\sigma _{\left\vert \varphi \right\rangle }\left( \mathfrak{H}%
\right) \,\forall v\in \mathfrak{c}\left( \mathfrak{H}\right) ,
\end{equation}%
where $\mathfrak{c}\left( \mathfrak{H}\right) $ is the set of \emph{distinct}
conjugation operators of $\mathfrak{H.}$
\end{lemma}

\begin{remark}
The inner product $\left\langle \left. {}\right\vert \right\rangle _{%
\mathfrak{H}}$ in $\mathfrak{H}$ can be decomposed into real and imaginary
parts as 
\begin{align}
\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}}&
=\left\langle \left. \left( \func{Re}_{\varphi }\left( v\right) +i\func{Im}%
_{\varphi }\left( v\right) \right) \right\vert \left( \func{Re}_{\varphi
}\left( w\right) +i\func{Im}_{\varphi }\left( w\right) \right) \right\rangle
_{\mathfrak{H}} \\
& =\left( \left\langle \left. \func{Re}_{\varphi }\left( v\right)
\right\vert \func{Re}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}%
}+\left\langle \left. \func{Re}_{\varphi }\left( v\right) \right\vert i\func{%
Im}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}}\right) +\left(
\left\langle \left. i\func{Im}_{\varphi }\left( v\right) \right\vert \func{Re%
}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}}+\left\langle
\left. i\func{Im}_{\varphi }\left( v\right) \right\vert i\func{Im}_{\varphi
}\left( w\right) \right\rangle _{\mathfrak{H}}\right)  \\
& =\left( \overset{}{\left\langle \left. \func{Re}_{\varphi }\left( v\right)
\right\vert \func{Re}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}%
}+\left\langle \left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{%
Im}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}}}\right) +i\left( 
\overset{}{\left\langle \left. \func{Re}_{\varphi }\left( v\right)
\right\vert \func{Im}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}%
}-\left\langle \left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{%
Re}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}}}\right)  \\
& =\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( w\right) \right) +%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}%
\left( \mathcal{R}_{\varphi }\left( w\right) \right) }\right) +i\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( w\right) \right) -\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( 
\mathcal{R}_{\varphi }\left( w\right) \right) }\right)  \\
& =\left( \left. v\right\vert w\right) _{\mathfrak{H}}+i\left\{ \left.
v\right\vert w\right\} _{\mathfrak{H}} \\
& =\func{Re}\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}}+i%
\func{Im}\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}},
\end{align}%
for any conb $\left\vert \boldsymbol{\varphi }\right\rangle $ one defines
the real Euclidean inner product 
\begin{equation}
\left( \left. {}\right\vert \right) _{\mathfrak{H}}:\mathfrak{H\times H}%
\rightarrow \mathbb{R}
\end{equation}%
and the real Symplectic form 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{\mathfrak{H}}:\mathfrak{H\times H}%
\rightarrow \mathbb{R}
\end{equation}%
by
\end{remark}

\begin{definition}
\begin{enumerate}
\item Real symmetric inner (bilinear) product 
\begin{equation}
\left( \left. {}\right\vert \right) _{\mathfrak{H}}:\mathfrak{H\times H}%
\rightarrow \mathbb{R}
\end{equation}%
by%
\begin{equation}
\left( \left. v\right\vert w\right) _{\mathfrak{H}}=\func{Re}\left(
\left\langle \left. v\right\vert w\right\rangle \right) =\left\langle \left. 
\func{Re}_{\varphi }\left( v\right) \right\vert \func{Re}_{\varphi }\left(
w\right) \right\rangle _{\mathfrak{H}}+\left\langle \left. \func{Im}%
_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi }\left( w\right)
\right\rangle _{\mathfrak{H}}\text{ for any conbs }\left\vert \boldsymbol{%
\varphi }\right\rangle \text{ of }\mathfrak{H}.
\end{equation}

\item Real Symplectic (antisymmetric bilinear) form%
\begin{equation}
\left\{ \left. {}\right\vert \right\} _{\mathfrak{H}}:\mathfrak{H\times H}%
\rightarrow \mathbb{R}
\end{equation}%
by%
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{\mathfrak{H}}=-i\func{Im}\left(
\left\langle \left. v\right\vert w\right\rangle \right) =\left\langle \left. 
\func{Re}_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi }\left(
w\right) \right\rangle _{\mathfrak{H}}-\left\langle \left. \func{Im}%
_{\varphi }\left( v\right) \right\vert \func{Re}_{\varphi }\left( w\right)
\right\rangle _{\mathfrak{H}}\text{ for any conbs }\left\vert \boldsymbol{%
\varphi }\right\rangle \text{ of }\mathfrak{H}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
It is self evident from the definitions that $\left( \left. {}\right\vert
\right) _{\mathfrak{H}}$ is symmetric i.e 
\begin{equation}
\left( \left. v\right\vert w\right) _{\mathfrak{H}}=\left( \left.
w\right\vert v\right) _{\mathfrak{H}}
\end{equation}%
and $\left\{ \left. {}\right\vert \right\} _{\mathfrak{H}}$ is antisymmetric
i.e. 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{\mathfrak{H}}=-\left\{ \left.
w\right\vert v\right\} _{\mathfrak{H}}.
\end{equation}
\end{remark}

\begin{definition}
One can consider the real Hilbert space $\mathfrak{H}_{\mathfrak{R}}$
defined as real linear combinations of vectors $v\in \mathfrak{H}$ i.e.%
\begin{equation}
\mathfrak{H}_{\mathfrak{R}}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ v\in 
\mathfrak{H}\right\} .
\end{equation}
\end{definition}

\begin{remark}
Obviously as a set 
\begin{equation}
\mathfrak{H}_{\mathfrak{R}}=\mathfrak{H.}
\end{equation}
\end{remark}

\begin{lemma}
The real dimension of $\mathfrak{H}_{\mathfrak{R}}$ is $2r.$
\end{lemma}

\begin{proof}
$\mathfrak{H}_{\mathfrak{R}}$ has bases of the form $\left( \boldsymbol{%
\varphi },i\boldsymbol{\varphi }\right) .$
\end{proof}

\begin{lemma}
The vectors $v$ and $iv$ are $\left( \left. {}\right\vert \right) _{%
\mathfrak{H}}$-orthogonal 
\begin{equation}
\left( \left. v\right\vert iv\right) _{\mathfrak{H}}=0.
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
\left\langle \left. \func{Re}_{\varphi }\left( v\right) \right\vert \func{Re}%
_{\varphi }\left( iv\right) \right\rangle _{\mathfrak{H}}+\left\langle
\left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi
}\left( iv\right) \right\rangle _{\mathfrak{H}}=-\left\langle \left. \func{Re%
}_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi }\left( v\right)
\right\rangle _{\mathfrak{H}}+\left\langle \left. \func{Im}_{\varphi }\left(
v\right) \right\vert \func{Re}_{\varphi }\left( v\right) \right\rangle _{%
\mathfrak{H}}=0
\end{equation}
\end{proof}

\begin{lemma}
\begin{equation}
\left\{ \left. v\right\vert iv\right\} _{\mathfrak{H}}=\func{Re}\left\langle
\left. v\right\vert v\right\rangle _{\mathfrak{H}}=\left( \left.
v\right\vert v\right) _{\mathfrak{H}}.
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
\left\langle \left. \func{Re}_{\varphi }\left( v\right) \right\vert \func{Im}%
_{\varphi }\left( iv\right) \right\rangle _{\mathfrak{H}}-\left\langle
\left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{Re}_{\varphi
}\left( iv\right) \right\rangle _{\mathfrak{H}}=\left\langle \left. \func{Re}%
_{\varphi }\left( v\right) \right\vert \func{Re}_{\varphi }\left( v\right)
\right\rangle _{\mathfrak{H}}+\left\langle \left. \func{Im}_{\varphi }\left(
v\right) \right\vert \func{Im}_{\varphi }\left( iv\right) \right\rangle _{%
\mathfrak{H}}=0
\end{equation}%
as 
\begin{equation}
v=\func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right)
\end{equation}%
giving%
\begin{equation}
iv=i\func{Re}_{\varphi }\left( v\right) -\func{Im}_{\varphi }\left( v\right)
.
\end{equation}
\end{proof}

\begin{corollary}
One can define real symmetric and real antisymmetric bilinear forms $\left(
\left. {}\right\vert \right) _{\mathfrak{H}_{\mathfrak{R}}}$ and $\left\{
\left. {}\right\vert \right\} _{\mathfrak{H}_{\mathfrak{R}}}$ 
\begin{equation}
\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathfrak{R}}},\left\{
\left. {}\right\vert \right\} _{\mathfrak{H}_{\mathfrak{R}}}:\mathfrak{H}_{%
\mathfrak{R}}\times \mathfrak{H}_{\mathfrak{R}}\rightarrow \mathbb{R}
\end{equation}%
on the real space $\mathfrak{H}_{\mathfrak{R}}$ by 
\begin{equation}
\left( \left. v\right\vert w\right) _{\mathfrak{H}_{\mathfrak{R}}}=\left(
\left. v\right\vert w\right) _{\mathfrak{H}}
\end{equation}%
and 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{\mathfrak{H}_{\mathfrak{R}}}=\left\{
\left. v\right\vert w\right\} _{\mathfrak{H}}.
\end{equation}
\end{corollary}

\begin{definition}
Real Hilbert spaces $\mathfrak{H}_{r\varphi }$ of dimension $r$ associated
with a conb $\left\vert \boldsymbol{\varphi }\right\rangle $ of $\mathfrak{H}
$ are defined as 
\begin{equation}
\mathfrak{H}_{r\varphi }=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
\varphi _{j}\right\vert 1\leq j\leq r\right\} .
\end{equation}
\end{definition}

\begin{lemma}
$\mathfrak{H}_{r\varphi }$ is generated by bases in the same equivalence
class $\left[ \varphi \right] $ as $\left\vert \varphi \right\rangle $ i.e. 
\begin{equation}
\mathfrak{H}_{r\varphi }=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
\left\vert o\varphi _{j}\right\rangle \right\vert 1\leq j\leq r,\,\forall
o\in O\left( \mathfrak{H},\mathbb{R}\right) \right\} .
\end{equation}
\end{lemma}

\begin{proof}
\end{proof}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\dim \left\{ \mathfrak{H}_{r\varphi }\right\} =r
\end{equation}

\item 
\begin{equation}
\dim \left\{ \mathfrak{H}_{\mathfrak{R}}\right\} =2r
\end{equation}%
and

\item 
\begin{equation}
\mathfrak{R}\left( \mathfrak{H}\right) \supset \mathfrak{H}_{r\varphi
},\,\forall \left\vert \mathbb{\varphi }\right\rangle \in \mathfrak{B}\left( 
\mathfrak{H}\right) .
\end{equation}
\end{enumerate}
\end{remark}

Recall

\begin{definition}
\bigskip Real bilinear products $\left( \left. {}\right\vert \right) _{%
\mathfrak{H}_{\mathbb{R}}}$ and $\left\{ \left. v\right\vert w\right\} _{%
\mathfrak{H}_{\mathbb{R}}}$ induced from $\left( \left. {}\right\vert
\right) _{\mathfrak{H}}$ and $\left\{ \left. v\right\vert w\right\} _{%
\mathfrak{H}}$ are defined in the real space $\mathfrak{H}_{\mathbb{R}}$ by 
\begin{equation}
\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}:\mathfrak{H}%
_{\mathbb{R}}\times \mathfrak{H}_{\mathbb{R}}\rightarrow \mathbb{R}
\end{equation}%
and 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{\mathfrak{H}_{\mathbb{R}}}:\mathfrak{%
H}_{\mathbb{R}}\times \mathfrak{H}_{\mathbb{R}}\rightarrow \mathbb{R}
\end{equation}%
where

\begin{enumerate}
\item the inner product in $\mathfrak{H}_{\mathbb{R}}$ 
\begin{equation}
\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}:\mathfrak{H}%
_{\mathbb{R}}\times \mathfrak{H}_{\mathbb{R}}\rightarrow \mathbb{R}
\end{equation}%
is defined as%
\begin{equation}
\left( \left. v\right\vert w\right) _{\mathfrak{H}_{\mathbb{R}}}=\func{Re}%
\left( \left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}%
}\right) =\left\langle \left. \func{Re}_{\varphi }\left( v\right)
\right\vert \func{Re}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}%
}+\left\langle \left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{%
Im}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}}.
\end{equation}

\item the symplectic product in $\mathfrak{H}_{r\varphi }$ 
\begin{equation}
\left\{ \left. {}\right\vert \right\} _{\mathfrak{H}_{\mathbb{R}}}:\mathfrak{%
H}_{\mathbb{R}}\times \mathfrak{H}_{\mathbb{R}}\rightarrow \mathbb{R}
\end{equation}%
is defined as 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{\mathfrak{H}_{\mathbb{R}}}=\left\{
\left. v\right\vert w\right\} _{\mathfrak{H}}=-i\func{Im}\left( \left\langle
\left. v\right\vert w\right\rangle _{\mathfrak{H}}\right) =\left\langle
\left. \func{Re}_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi
}\left( w\right) \right\rangle _{\mathfrak{H}}-\left\langle \left. \func{Im}%
_{\varphi }\left( v\right) \right\vert \func{Re}_{\varphi }\left( w\right)
\right\rangle _{\mathfrak{H}}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
The norm in $\mathfrak{H}_{r\varphi }$ is defined as 
\begin{equation}
\left\Vert v\right\Vert _{\mathfrak{H}_{\mathbb{R}}}=\sqrt{\left\langle
\left. v\right\vert w\right\rangle _{\mathfrak{H}_{\mathbb{R}}}}=\sqrt{%
\left( \left\langle \left. \func{Re}_{\varphi }\left( v\right) \right\vert 
\func{Re}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}%
}+\left\langle \left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{%
Im}_{\varphi }\left( w\right) \right\rangle _{\mathfrak{H}}\right) }.
\end{equation}
\end{definition}

\begin{definition}
The real form $\mathfrak{H}_{\mathfrak{R}}$ of the complex space $\mathfrak{H%
}$ 
\begin{equation}
\mathfrak{R}_{\varphi }:\mathfrak{H\rightarrow H}_{\mathfrak{R}%
},\,\left\vert \boldsymbol{\varphi }\right\rangle \in \mathfrak{B}\left( 
\mathfrak{H}\right) 
\end{equation}%
by 
\begin{equation}
\mathfrak{R}_{\varphi }\left( v\right) =\func{Re}_{\varphi }\left( v\right)
\oplus _{\mathbb{R}}\func{Im}_{\varphi }\left( v\right) =\left( \boldsymbol{%
\varphi }\right) \mathcal{R}_{\varphi }\left( \func{Re}_{\varphi }\left(
v\right) \right) +\oplus _{\mathbb{R}}\left( i\boldsymbol{\varphi }\right) 
\mathcal{R}_{\varphi }\left( \func{Im}_{\varphi }\left( v\right) \right)
=\left( \boldsymbol{\varphi }\right) \func{Re}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) +\oplus _{\mathbb{R}}\left( i\boldsymbol{\varphi }%
\right) \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
,\,v\in \mathfrak{H}.
\end{equation}
\end{definition}

\begin{definition}
The real Hilbert space $\mathfrak{H}_{\mathbb{R}}$ defined as 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{r\varphi }\oplus _{\mathbb{R}}%
\mathfrak{H}_{r\varphi },
\end{equation}%
is independent of the conb $\left\vert \boldsymbol{\varphi }\right\rangle $
of $\mathfrak{H}$ but expresses different dirct sum decompositions of $%
\mathfrak{H}_{\mathbb{R}}.$
\end{definition}

\begin{lemma}
$\mathfrak{H}_{\mathbb{R}}$ is the real form of $\mathfrak{H}$ i.e. 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathfrak{R}}.
\end{equation}
\end{lemma}

\begin{definition}
Real inclusion maps $\mathfrak{r}_{\varphi }\in $ $\mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}},\mathfrak{H\times H}\right) $%
\begin{equation}
\mathfrak{r}_{\varphi }:\mathfrak{H\times H}\rightarrow \mathfrak{H}_{%
\mathbb{R}}=\mathfrak{H}_{r\varphi }\oplus _{\mathbb{R}}\mathfrak{H}%
_{r\varphi }
\end{equation}%
are defined by%
\begin{equation}
\mathfrak{r}_{\varphi }\left( v\right) =\func{Re}_{\varphi }\left( v\right)
\oplus _{\mathbb{R}}\func{Im}_{\varphi }\left( v\right) .
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\mathfrak{r}_{\varphi }=\mathfrak{R}_{\varphi }.
\end{equation}
\end{lemma}

\begin{remark}
The inner product in $\mathfrak{H}$ can be expressed in terms of the inner
and symplectic products in $\mathfrak{H}_{\mathbb{R}}$ as 
\begin{eqnarray}
\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}} &=&\left(
\left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r}%
_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{\mathbb{R}}}+i\left\{
\left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r}%
_{\varphi }\left( w\right) \right\} _{\mathfrak{H}_{\mathbb{R}}} \\
&=&\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( w\right) \right) +%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}%
\left( \mathcal{R}_{\varphi }\left( w\right) \right) }\right) +i\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( w\right) \right) -\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( 
\mathcal{R}_{\varphi }\left( w\right) \right) }\right) .
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{eqnarray}
\left( \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r}%
_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{\mathbb{R}}} &=&\left(
\left. \left( \func{Re}_{\varphi }\left( v\right) \mathfrak{,}\func{Im}%
_{\varphi }\left( v\right) \right) \right\vert \left( \func{Re}_{\varphi
}\left( w\right) \mathfrak{,}\func{Im}_{\varphi }\left( w\right) \right)
\right) _{\mathfrak{H}_{\mathbb{R}}}=\left( \left. \func{Re}_{\varphi
}\left( v\right) \right\vert \func{Re}_{\varphi }\left( w\right) \right) _{%
\mathfrak{H}_{r\varphi }}+\left( \left. \func{Im}_{\varphi }\left( v\right)
\right\vert \func{Im}_{\varphi }\left( w\right) \right) _{\mathfrak{H}%
_{r\varphi }} \\
\left\{ \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r%
}_{\varphi }\left( w\right) \right\} _{\mathfrak{H}_{\mathbb{R}}} &=&\left\{
\left. \left( \func{Re}_{\varphi }\left( v\right) \mathfrak{,}\func{Im}%
_{\varphi }\left( v\right) \right) \right\vert \left( \func{Re}_{\varphi
}\left( w\right) \mathfrak{,}\func{Im}_{\varphi }\left( w\right) \right)
\right\} _{\mathfrak{H}_{\mathbb{R}}}=\left( \left. \func{Re}_{\varphi
}\left( v\right) \right\vert \func{Im}_{\varphi }\left( w\right) \right) _{%
\mathfrak{H}_{r\varphi }}-\left( \left. \func{Im}_{\varphi }\left( v\right)
\right\vert \func{Re}_{\varphi }\left( w\right) \right) _{\mathfrak{H}%
_{r\varphi }}
\end{eqnarray}
\end{remark}

\begin{lemma}
$\mathfrak{H}_{r\varphi }$ is a real subspace of $\mathfrak{H}_{\mathbb{R}}$
\end{lemma}

\begin{proof}
\end{proof}

\begin{definition}
The operators $\left\vert \left( a,b\right) \right) \left( \left( c,d\right)
\right\vert \in \mathcal{B}\left( \mathfrak{H}_{\mathbb{R}}\right) ,$ that
depend on the selection of a real subspace $\mathfrak{H}_{r\varphi }$ and
hence of conb $\left\vert \boldsymbol{\varphi }\right\rangle ,$ are defined
by 
\begin{equation}
\left\vert \overset{}{\left( a,b\right) }\right) \left( \overset{}{\left(
c,d\right) }\right\vert \left\vert \overset{}{\left( e,f\right) }\right)
=\left( \overset{}{\left. \left( c,d\right) \right\vert \left( e,f\right) }%
\right) _{\mathfrak{H}_{\mathbb{R}}}\left\vert \overset{}{\left( a,b\right) }%
\right) ,
\end{equation}%
where 
\begin{equation}
a,b,c,d,e,f\in \mathfrak{H}_{r\varphi }.
\end{equation}
\end{definition}

\begin{definition}
Let $\left\vert \boldsymbol{\varphi }\right\rangle $ be a conb of $\mathfrak{%
H}$ then a conb of $\mathfrak{H}_{\mathbb{C}}$ is given by 
\begin{eqnarray}
\left\vert \Phi _{j}\right\rangle  &=&\left\vert \left( \varphi
_{j},0\right) \right\rangle  \\
\left\vert \Phi _{j+r}\right\rangle  &=&\left\vert \left( 0,\varphi
_{j}\right) \right\rangle  \\
1 &\leq &j\leq r.
\end{eqnarray}
\end{definition}

\begin{definition}
Let $\left\vert \boldsymbol{\varphi }\right\rangle $-conb of $\mathfrak{H}$
and thus $\left\vert \boldsymbol{\varphi }\right) $-conb of $\mathfrak{H}$
then it gives a $\left\vert {}\right) $-conb of $\mathfrak{H}_{\mathbb{R}}$
by 
\begin{eqnarray}
\left\vert \Phi _{j}\right)  &=&\left\vert \left( \varphi _{j},0\right)
\right)  \\
\left\vert \Phi _{j+r}\right)  &=&\left\vert \left( 0,\varphi _{j}\right)
\right)  \\
1 &\leq &j\leq r.
\end{eqnarray}
\end{definition}

\begin{remark}
The real symplectic form $\left\{ \left. {}\right\vert \right\} _{\mathfrak{H%
}_{\mathbb{R}}}$ can be expressed in terms of the real inner product $\left(
\left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}$, the complex unit 
$J_{\left\vert \varphi \right) }\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{R%
}}\right) $ and complex vectors $v,w\in \mathfrak{H}$ as 
\begin{equation}
\left\{ \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r%
}_{\varphi }\left( w\right) \right\} _{\mathfrak{H}_{\mathbb{R}}}=\left(
\left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert J_{\varphi }%
\mathfrak{r}_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{\mathbb{R}%
}},\quad v,w\in \mathfrak{H,}
\end{equation}%
where the 
\end{remark}

\begin{definition}
of the complex unit $J_{\left\vert \varphi \right) }\in \mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}}\right) $ is a real antisymmetric operator defined
as 
\begin{equation}
J_{\left\vert \varphi \right) }=\sum_{1\leq j\leq r}\left\{ \left\vert
\left( \varphi _{j},0\right) \right) \left( \left( 0,\varphi _{j}\right)
\right\vert -\left\vert \left( 0,\varphi _{j}\right) \right) \left( \left(
\varphi _{j},0\right) \right\vert \right\} =\sum_{1\leq j\leq r}\left\{
\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert -\left\vert \Phi
_{j+r}\right) \left( \Phi _{j}\right\vert \right\} .
\end{equation}
\end{definition}

\begin{definition}
The real conjugation $\sigma _{\left\vert \varphi \right) }\in \mathcal{B}%
\left( \mathfrak{H}_{\mathbb{R}}\right) $ associated with $J_{\left\vert
\varphi \right) }$ is defined as the self adjoint operator%
\begin{equation}
\sigma _{\left\vert \varphi \right) }=\sum_{1\leq j\leq r}\left\{ \left\vert
\left( \varphi _{j},0\right) \right) \left( \left( \varphi _{j},0\right)
\right\vert -\left\vert \left( 0,\varphi _{j}\right) \right) \left( \left(
0,\varphi _{j}\right) \right\vert \right\} =\sum_{1\leq j\leq r}\left\{
\left\vert \Phi _{j}\right) \left( \Phi _{j}\right\vert -\left\vert \Phi
_{j+r}\right) \left( \Phi _{j+r}\right\vert \right\} =\sum_{1\leq j\leq
r}\left\{ P_{\Phi _{j}}-P_{\Phi _{j+r}}\right\} =P_{\left( \mathfrak{H}%
_{r\varphi },0\right) }-P_{\left( 0,\mathfrak{H}_{r\varphi }\right) }.
\end{equation}
\end{definition}

\begin{remark}
$\sigma _{\left\vert \varphi \right) }\in O\left( \mathfrak{H}_{\mathbb{R}},%
\mathbb{R}\right) $ i.e. $\sigma _{\varphi }$ is a real orthogonal operator
i.e. belongs to the orthogonal group $O\left( \mathfrak{H}_{\mathbb{R}},%
\mathbb{R}\right) $ as 
\begin{equation}
\left( \sum_{1\leq j\leq r}\left\{ \left\vert \Phi _{j}\right) \left( \Phi
_{j}\right\vert -\left\vert \Phi _{j+r}\right) \left( \Phi _{j+r}\right\vert
\right\} \right) ^{t}\left( \sum_{1\leq j\leq r}\left\{ \left\vert \Phi
_{j}\right) \left( \Phi _{j}\right\vert -\left\vert \Phi _{j+r}\right)
\left( \Phi _{j+r}\right\vert \right\} \right) =\sum_{1\leq j\leq r}\left\{
\left\vert \Phi _{j}\right) \left( \Phi _{j}\right\vert +\left\vert \Phi
_{j+r}\right) \left( \Phi _{j+r}\right\vert \right\} =I_{\mathfrak{H}_{%
\mathbb{R}}}.
\end{equation}
\end{remark}

\begin{remark}
$\sigma _{\left\vert \varphi \right) }$ is an real orthogonal involution 
\begin{equation}
\sigma _{\left\vert \varphi \right) }^{2}=\sigma _{\left\vert \varphi
\right) }^{t}\sigma _{\left\vert \varphi \right) }=I_{\mathfrak{H}_{\mathbb{R%
}}}.
\end{equation}
\end{remark}

\begin{remark}
The complex inner product in $\mathfrak{H}$ can be expressed in terms of the
real inner product in $\mathfrak{H}_{\mathbb{R}}$ as 
\begin{eqnarray}
\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}} &=&\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( w\right) \right) +\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}\left( 
\mathcal{R}_{\varphi }\left( w\right) \right) }\right) +i\left( \overset{}{%
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}%
\left( \mathcal{R}_{\varphi }\left( w\right) \right) -\func{Im}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( \mathcal{%
R}_{\varphi }\left( w\right) \right) }\right) \\
&=&\left( \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert 
\mathfrak{r}_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{\mathbb{R}%
}}+i\left\{ \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert 
\mathfrak{r}_{\varphi }\left( w\right) \right\} _{\mathfrak{H}_{\mathbb{R}%
}}=\left( \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert 
\mathfrak{r}_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{\mathbb{R}%
}}+i\left( \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert
J_{\varphi }\mathfrak{r}_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{%
\mathbb{R}}}.
\end{eqnarray}
\end{remark}

\begin{remark}
The inner products of conjugate vectors in $\mathfrak{H}$

\begin{enumerate}
\item 
\begin{equation}
\left\langle \left. v\right\vert v\right\rangle _{\mathfrak{H}}=\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) }\right) +i\left( \overset{}{%
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) -\func{Im}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( \mathcal{%
R}_{\varphi }\left( v\right) \right) }\right)
\end{equation}

\item 
\begin{equation}
\left\langle \left. v\right\vert \sigma _{\left\vert \varphi \right) }\left(
v\right) \right\rangle _{\mathfrak{H}}=\left( \overset{}{\func{Re}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( \mathcal{%
R}_{\varphi }\left( v\right) \right) -\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) }\right) -i\left( \overset{}{\func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) \cdot \func{Im}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) +\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) }\right)
\end{equation}

\item 
\begin{equation}
\left\langle \left. \sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert v\right\rangle _{\mathfrak{H}}=\left( \overset{}{\func{Re}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( \mathcal{%
R}_{\varphi }\left( v\right) \right) -\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) }\right) +i\left( \overset{}{\func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) \cdot \func{Im}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) +\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) }\right)
\end{equation}

\item 
\begin{equation}
\left\langle \left. \sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert \sigma _{\left\vert \varphi \right) }\left( v\right)
\right\rangle _{\mathfrak{H}}=\left( \overset{}{\func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) +\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) }\right) -i\left( \overset{}{\func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) \cdot \func{Im}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) -\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) }\right)
\end{equation}

\item 
\begin{eqnarray}
&&\left\langle \left. v\right\vert v\right\rangle _{\mathfrak{H}%
}-\left\langle \left. \sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert \sigma _{\left\vert \varphi \right) }\left( v\right)
\right\rangle _{\mathfrak{H}} \\
\quad &=&\quad \left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) +\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) }%
\right) +i\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) -\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot 
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right) \\
&&-\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right) +i\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) -\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) }\right) \\
&=&2i\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) -%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right)
\end{eqnarray}

\item 
\begin{eqnarray}
&&\left\langle \left. \sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert v\right\rangle _{\mathfrak{H}}-\left\langle \left. v\right\vert
\sigma _{\left\vert \varphi \right) }\left( v\right) \right\rangle _{%
\mathfrak{H}} \\
&=&\quad \left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left(
v\right) \right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) -\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot 
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right)
+i\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right) \\
&&-\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) -%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Im}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right) +i\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) }\right) \\
&=&2i\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right)
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{remark}
The inner products of real and imaginary vectors in $\mathfrak{H}$ 
\begin{eqnarray}
\left\langle \left. v+\sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert v-\sigma _{\left\vert \varphi \right) }\left( v\right)
\right\rangle _{\mathfrak{H}} &=&\left\langle \left. v\right\vert
v\right\rangle _{\mathfrak{H}}-\left\langle \left. \sigma _{\left\vert
\varphi \right) }\left( v\right) \right\vert \sigma _{\left\vert \varphi
\right) }\left( v\right) \right\rangle _{\mathfrak{H}}+\left\langle \left.
\sigma _{\left\vert \varphi \right) }\left( v\right) \right\vert
v\right\rangle _{\mathfrak{H}}-\left\langle \left. v\right\vert \sigma
_{\left\vert \varphi \right) }\left( v\right) \right\rangle _{\mathfrak{H}}
\\
&=&2i\left( \overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) -%
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) }\right) +2i\left( 
\overset{}{\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \cdot \func{Re}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) }\right) \\
&=&4i\left( \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \right)
\end{eqnarray}%
So in general are not perpendicular wrt $\left\langle \left. {}\right\vert
\right\rangle _{\mathfrak{H}}$ i.e. 
\begin{equation}
\left\langle \left. v+\sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert v-\sigma _{\left\vert \varphi \right) }\left( v\right)
\right\rangle _{\mathfrak{H}}\neq 0
\end{equation}%
and 
\begin{equation}
\mathfrak{H}_{r\varphi }\,\NEG{\bot}\,\mathfrak{H}_{i\varphi }.
\end{equation}
\end{remark}

\begin{remark}
Hence 
\begin{equation}
\mathfrak{H=H}_{r\varphi }+\mathfrak{H}_{i\varphi }\neq \mathfrak{H}%
_{r\varphi }\oplus _{\mathbb{C}}\mathfrak{H}_{i\varphi }.
\end{equation}
\end{remark}

\begin{remark}
However%
\begin{equation}
\left( \left. v+\sigma _{\left\vert \varphi \right) }\left( v\right)
\right\vert v-\sigma _{\left\vert \varphi \right) }\left( v\right) \right) _{%
\mathfrak{H}}=\func{Re}\left( \left\langle \left. v+\sigma _{\left\vert
\varphi \right) }\left( v\right) \right\vert v-\sigma _{\left\vert \varphi
\right) }\left( v\right) \right\rangle _{\mathfrak{H}}\right) =\func{Re}%
\left( 4i\left( \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \cdot \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right)
\right) \right) =0
\end{equation}%
so $v+\sigma _{\left\vert \varphi \right) }\left( v\right) $ and $v-\sigma
_{\left\vert \varphi \right) }\left( v\right) $ are perpendicular wrt $%
\left( \left. {}\right\vert \right) _{\mathfrak{H}}$ and 
\begin{equation}
\mathfrak{H=H}_{r\varphi }+_{\mathbb{R}}\mathfrak{H}_{i\varphi }=\mathfrak{H}%
_{r\varphi }\oplus _{\mathbb{R}}\mathfrak{H}_{i\varphi }.
\end{equation}
\end{remark}

\begin{remark}
The complex unit $J_{\left\vert \varphi \right) }\in $ $\mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}}\right) $ defines a complexification that produces $%
\mathfrak{H}$ from $\mathfrak{H}_{\mathbb{R}}$ i.e. 
\begin{equation}
\mathcal{J}\left( J_{\left\vert \varphi \right) }\right) =J,
\end{equation}%
where 
\begin{eqnarray}
J_{\left\vert \varphi \right) } &\in &\mathcal{B}\left( \mathfrak{H}_{%
\mathbb{R}}\right) \\
J &\in &\mathcal{B}\left( \mathfrak{H}\right) \\
\mathcal{J} &\in &\mathcal{B}_{\mathbb{R}}\left( \mathcal{B}\left( \mathfrak{%
H}\right) ,\mathcal{B}\left( \mathfrak{H}_{\mathbb{R}}\right) \right)
\end{eqnarray}%
and 
\begin{equation}
Jv=\mathcal{J}\left( J_{\left\vert \varphi \right) }\right) v=iv,\,\forall
v\in \mathfrak{H.}
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{J}\left( J_{\left\vert \varphi \right) }-J_{\left\vert \psi \right)
}\right) =0.
\end{equation}
\end{remark}

\begin{remark}
The real symplectic form $\left\{ \left. {}\right\vert \right\} _{\mathfrak{H%
}_{\mathbb{R}}}$ can be expressed in terms of the dual real antisymmetric
bivector $g_{\varphi }^{d}\in {\Large \wedge }^{2}\mathfrak{H}_{\mathbb{R}}$
as 
\begin{equation}
\left\{ \left. a\right\vert b\right\} _{\mathfrak{H}_{r\varphi }}=g_{\varphi
}^{d}\left( a\wedge b\right) ,
\end{equation}%
where

\begin{enumerate}
\item 
\begin{equation}
g_{\varphi }^{d}\in {\LARGE \wedge }^{2}\mathfrak{H}_{\mathbb{R}}^{d},
\end{equation}

\item 
\begin{equation}
g_{\varphi }^{d}=\sum_{1\leq j\leq r}\left( \overset{}{\left( \varphi
_{j},0\right) \wedge \left( 0,\varphi _{j}\right) }\right\vert =\sum_{1\leq
j\leq r}\left( \Phi _{j}\wedge \Phi _{j+r}\right\vert =\left( \overset{}{g}%
\right\vert
\end{equation}%
and

\item 
\begin{equation}
a\wedge b\in {\LARGE \wedge }^{2}\mathfrak{H}_{\mathbb{R}}.
\end{equation}
\end{enumerate}
\end{remark}

\begin{lemma}
$\sigma _{\left\vert \varphi \right\rangle }=\mathcal{J}\left( \sigma
_{\left\vert \varphi \right) }\right) $ is \emph{antiunitary} i.e.%
\begin{eqnarray}
\left\langle \left. \sigma _{\left\vert \varphi \right\rangle }\left(
v\right) \right\vert \sigma _{\left\vert \varphi \right\rangle }\left(
w\right) \right\rangle _{\mathfrak{H}} &=&\left\langle \left. v\right\vert
w\right\rangle _{\mathfrak{H}} \\
\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}}
&=&\sum_{1\leq j\leq r}\overline{\mathcal{R}_{\varphi }\left( v\right) }%
\mathcal{R}_{\varphi }\left( w\right) \\
\left\langle \left. \sigma _{\left\vert \varphi \right\rangle }\left(
v\right) \right\vert \sigma _{\left\vert \varphi \right\rangle }\left(
w\right) \right\rangle _{\mathfrak{H}} &=&\sum_{1\leq j\leq r}\mathcal{R}%
_{\varphi }\left( v\right) \overline{\mathcal{R}_{\varphi }\left( w\right) }=%
\overline{\left\langle \left. v\right\vert w\right\rangle }_{\mathfrak{H}%
}=\left\langle \left. w\right\vert v\right\rangle _{\mathfrak{H}}
\end{eqnarray}%
and 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }^{2}=I_{\mathfrak{H}}.
\end{equation}
\end{lemma}

\begin{remark}
As%
\begin{equation}
\left\langle \left. \sigma _{\left\vert \varphi \right\rangle }^{\dagger
}\left( v\right) \right\vert w\right\rangle _{\mathfrak{H}}=\left\langle
\left. v\right\vert \sigma _{\left\vert \varphi \right\rangle }\left(
w\right) \right\rangle _{\mathfrak{H}}\,\forall v,w\in \mathfrak{H}
\end{equation}%
one has 
\begin{eqnarray}
\left\langle \left. v\right\vert \sigma _{\left\vert \varphi \right\rangle
}\left( w\right) \right\rangle _{\mathfrak{H}} &=&\sum_{1\leq j\leq r}%
\overline{\mathcal{R}_{\varphi }\left( v\right) }\overline{\mathcal{R}%
_{\varphi }\left( w\right) } \\
\left\langle \left. \sigma _{\left\vert \varphi \right\rangle }^{\dagger
}\left( v\right) \right\vert w\right\rangle _{\mathfrak{H}} &=&\sum_{1\leq
j\leq r}\overline{\mathcal{R}_{\varphi }\left( v\right) }\overline{\mathcal{R%
}_{\varphi }\left( w\right) }=\sum_{1\leq j\leq r}\overline{\mathcal{R}%
_{\varphi }\left( \sigma _{\left\vert \varphi \right\rangle }^{\dagger
}\left( v\right) \right) }\mathcal{R}_{\varphi }\left( w\right) .
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{equation}
v=\left( \boldsymbol{\varphi }\right) \mathcal{R}_{\varphi }\left( v\right)
=\left( \boldsymbol{\varphi }\right) \left( \func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) +i\func{Im}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) \right) =\left( \boldsymbol{\varphi }\right) \func{%
Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) +\left( i\boldsymbol{%
\varphi }\right) \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) =\left( \boldsymbol{\varphi }\right) \mathcal{R}_{\varphi }\left( 
\func{Re}_{\varphi }\left( v\right) \right) +\left( i\boldsymbol{\varphi }%
\right) \mathcal{R}_{\varphi }\left( \func{Im}_{\varphi }\left( v\right)
\right) .
\end{equation}

\begin{definition}
The complex subspaces $V_{\sigma \left( \varphi \right) +1}$ and $V_{\sigma
\left( \varphi \right) -1}$ of $\mathfrak{H}$ are eigenspaces of the
antunitary complex conjugation operator $\sigma _{\left\vert \varphi
\right\rangle }$ that are defined by

\begin{enumerate}
\item 
\begin{equation}
V_{\sigma \left( \varphi \right) +1}=\func{Re}_{\varphi }\left\{ \mathfrak{H}%
\right\} =\left\{ v\left\vert \sigma _{\left\vert \varphi \right\rangle
}\left( v\right) =v,v\in \mathfrak{H}\right. \right\} .
\end{equation}

\item 
\begin{equation}
V_{\sigma \left( \varphi \right) -1}=i\func{Im}_{\varphi }\left\{ \mathfrak{H%
}\right\} =\left\{ v\left\vert \sigma _{\left\vert \varphi \right\rangle
}\left( v\right) =-v,v\in \mathfrak{H}\right. \right\} .
\end{equation}
\end{enumerate}
\end{definition}
\end{remark}

Hence 
\begin{equation}
\mathfrak{H}=\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} \oplus _{%
\mathbb{R}}i\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} =V_{\sigma
\left( \varphi \right) +1}\oplus _{\mathbb{R}}V_{\sigma \left( \varphi
\right) -1}
\end{equation}%
\emph{and} 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\}
\oplus _{\mathbb{R}}\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} =%
\mathfrak{H}_{r\varphi }\oplus _{\mathbb{R}}\mathfrak{H}_{r\varphi }.
\end{equation}

\begin{lemma}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) =v\Leftrightarrow
v=\frac{1}{2}\left( w+\sigma _{\left\vert \varphi \right\rangle }\left(
w\right) \right)
\end{equation}
\end{lemma}

\begin{proof}
\begin{eqnarray}
\frac{1}{2}\left( \func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi
}\left( v\right) +\func{Re}_{\varphi }\left( v\right) -i\func{Im}_{\varphi
}\left( v\right) \right) &=&\frac{1}{2}\left( \func{Re}_{\varphi }\left(
v\right) +\func{Re}_{\varphi }\left( v\right) \right) =\func{Re}_{\varphi
}\left( v\right) \\
\sigma _{\left\vert \varphi \right\rangle }\left( \func{Re}_{\varphi }\left(
v\right) \right) &=&\func{Re}_{\varphi }\left( v\right) .
\end{eqnarray}
\end{proof}

\begin{lemma}
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right)
=-v\Leftrightarrow v=\frac{1}{2}\left( w-\sigma _{\left\vert \varphi
\right\rangle }\left( w\right) \right)
\end{equation}
\end{lemma}

\begin{proof}
\begin{eqnarray}
\frac{1}{2}\left( \func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi
}\left( v\right) -\left( \func{Re}_{\varphi }\left( v\right) -i\func{Im}%
_{\varphi }\left( v\right) \right) \right) &=&\frac{1}{2}\left( i\func{Im}%
_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right) \right) =i%
\func{Im}_{\varphi }\left( v\right) \\
\sigma _{\left\vert \varphi \right\rangle }\left( i\func{Im}_{\varphi
}\left( v\right) \right) &=&-i\func{Im}_{\varphi }\left( v\right) .
\end{eqnarray}
\end{proof}

\begin{remark}
For 
\begin{equation}
v\in \mathfrak{H}
\end{equation}%
one has 
\begin{equation}
v=\left( \boldsymbol{\varphi }_{+}\right) \mathcal{R}_{\varphi }\left( \func{%
Re}_{\varphi }\left( v\right) \right) +\left( \boldsymbol{\varphi }%
_{-}\right) \mathcal{R}_{\varphi }\left( \func{Im}_{\varphi }\left( v\right)
\right) =\left( \boldsymbol{\varphi }_{+}\right) \mathcal{R}_{\varphi
}\left( \func{Re}_{\varphi }\left( v\right) \right) \oplus _{\mathbb{R}%
}\left( \boldsymbol{\varphi }_{-}\right) \mathcal{R}_{\varphi }\left( \func{%
Im}_{\varphi }\left( v\right) \right) =\left( \boldsymbol{\varphi }\right) 
\mathcal{R}_{\varphi }\left( \overset{}{\func{Re}_{\varphi }\left( v\right)
+i\func{Im}_{\varphi }\left( v\right) }\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left( \boldsymbol{\varphi }_{\boldsymbol{-}}\right) =\left( i\boldsymbol{%
\varphi }\right) =i\left( \boldsymbol{\varphi }_{+}\right)
\end{equation}
\end{remark}

\begin{lemma}
The complex conjugation $\sigma _{\left\vert \varphi \right\rangle }\in 
\mathcal{B}_{anti}\left( \mathfrak{H}\right) \subset \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}\right) $ can be expressed as in terms of partial
isometries as 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }=\sum_{1\leq j\leq r}\left\{
\left\vert \varphi _{j}\right) \left( \varphi _{j}\right\vert -\left\vert
i\varphi _{j}\right) \left( i\varphi _{j}\right\vert \right\}
\end{equation}%
where

\begin{enumerate}
\item 
\begin{equation}
\left\vert a\right) \left( b\right\vert \in \mathcal{B}_{\mathbb{R}}\left( 
\mathfrak{H}\right)
\end{equation}

\item 
\begin{equation}
\left\vert a\right) \left( b\right\vert v=\left( \left. b\right\vert
v\right) _{\mathfrak{H}}a
\end{equation}

\item 
\begin{equation}
\left( \left. b\right\vert v\right) _{\mathfrak{H}}=\func{Re}\left\langle
\left. b\right\vert a\right\rangle
\end{equation}

\item 
\begin{equation}
\left( \boldsymbol{\varphi }\right) \func{Re}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) +\left( i\boldsymbol{\varphi }\right) \func{Im}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) =\left( \boldsymbol{%
\varphi }\right) \mathcal{R}_{\varphi }\left( \func{Re}_{\varphi }\left(
v\right) \right) +\left( i\boldsymbol{\varphi }\right) \mathcal{R}_{\varphi
}\left( \func{Im}_{\varphi }\left( v\right) \right) .
\end{equation}
\end{enumerate}
\end{lemma}

\begin{proof}
\begin{eqnarray}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) &=&\sum_{1\leq
j\leq r}\left\{ \left\vert \varphi _{j}\right) \left( \varphi
_{j}\right\vert \left( v\right) -\left\vert i\varphi _{j}\right) \left(
i\varphi _{j}\right\vert \left( v\right) \right\} =\sum_{1\leq j\leq
r}\left\{ \left\vert \varphi _{j}\right) \left( \varphi _{j}\right\vert
\left( \left( \boldsymbol{\varphi }\right) \func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) +\left( i\boldsymbol{\varphi }\right) 
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \right)
-\left\vert i\varphi _{j}\right) \left( i\varphi _{j}\right\vert \left(
\left( \boldsymbol{\varphi }\right) \func{Re}\left( \mathcal{R}_{\varphi
}\left( v\right) \right) +\left( i\boldsymbol{\varphi }\right) \func{Im}%
\left( \mathcal{R}_{\varphi }\left( v\right) \right) \right) \right\} \\
&=&\sum_{1\leq j\leq r}\left\{ \left\vert \varphi _{j}\right) \left( \varphi
_{j}\right\vert \left( \left( \boldsymbol{\varphi }\right) \func{Re}\left( 
\mathcal{R}_{\varphi }\left( v\right) \right) \right) -\left\vert i\varphi
_{j}\right) \left( i\varphi _{j}\right\vert \left( \left( i\boldsymbol{%
\varphi }\right) \func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) \right) \right\} =\sum_{1\leq j\leq r}\left\{ \left\vert \varphi
_{j}\right) \func{Re}\left( \mathcal{R}_{\varphi }\left( v_{j}\right)
\right) -\left\vert i\varphi _{j}\right) \func{Im}\left( \mathcal{R}%
_{\varphi }\left( v\right) _{j}\right) \right\} \\
&=&\sum_{1\leq j\leq r}\left\vert \varphi _{j}\right) \left( \func{Re}\left( 
\mathcal{R}_{\varphi }\left( v_{j}\right) \right) -i\func{Im}\left( \mathcal{%
R}_{\varphi }\left( v\right) _{j}\right) \right) =\sum_{1\leq j\leq
r}\left\vert \varphi _{j}\right) \left( \mathcal{R}_{\varphi }\left( \func{Re%
}_{\varphi }\left( v\right) \right) _{j}-i\mathcal{R}_{\varphi }\left( \func{%
Im}_{\varphi }\left( v\right) \right) _{j}\right) =\sum_{1\leq j\leq
r}\left\vert \varphi _{j}\right) \overline{\mathcal{R}_{\varphi }\left(
v\right) _{j}}.
\end{eqnarray}
\end{proof}

\begin{remark}
In general 
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) \neq \sum_{1\leq
j\leq r}\left\vert \psi _{j}\right) \overline{\mathcal{R}_{\psi }\left(
v\right) _{j}}
\end{equation}%
unless 
\begin{equation}
\left( \boldsymbol{\varphi }\right) \backsim \left( \boldsymbol{\psi }%
\right) .
\end{equation}
\end{remark}

\begin{remark}
Recall%
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\}
\oplus _{\mathbb{R}}\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} .
\end{equation}
\end{remark}

\begin{definition}
The normalized map $\beta _{r}$ from the complex Hilbert space $\mathfrak{H}$
to the real Hilbert subspace $\func{Re}_{\varphi }\left\{ \mathfrak{H}%
\right\} $ 
\begin{equation}
\beta _{r}:V_{\sigma _{\varphi }+1}\rightarrow \func{Re}_{\varphi }\left\{ 
\mathfrak{H}\right\}
\end{equation}%
by 
\begin{equation}
\beta _{r}\left( v\right) =\frac{1}{\sqrt{2}}\left( v+\sigma _{\left\vert
\varphi \right\rangle }\left( v\right) \right) =\sqrt{2}\func{Re}_{\varphi
}\left( v\right) .
\end{equation}
\end{definition}

\begin{definition}
The normalized map $\beta _{i}$ from the complex Hilbert space $\mathfrak{H}$
to the real Hilbert subspace $\func{Im}_{\varphi }\left\{ \mathfrak{H}%
\right\} $ 
\begin{equation}
\beta _{i}:V_{\sigma \left( \varphi \right) -1}\rightarrow \func{Im}%
_{\varphi }\left\{ \mathfrak{H}\right\}
\end{equation}%
by 
\begin{equation}
\beta _{i}\left( v\right) =\frac{1}{\sqrt{2}}\left( v-\sigma _{\left\vert
\varphi \right\rangle }\left( v\right) \right) =\sqrt{2}\func{Im}_{\varphi
}\left( v\right) .
\end{equation}
\end{definition}

\begin{remark}
The maps $\beta _{r}$ and $\beta _{i}$ are the normalized form of $\mathfrak{%
r}_{\varphi }.$
\end{remark}

\begin{lemma}
The maps 
\begin{equation}
\beta _{r}:V_{\sigma _{\varphi }+1}\rightarrow \func{Re}_{\varphi }\left\{ 
\mathfrak{H}\right\}
\end{equation}%
and 
\begin{equation}
\beta _{i}:V_{\sigma _{\varphi }-1}\rightarrow \func{Im}_{\varphi }\left\{ 
\mathfrak{H}\right\}
\end{equation}%
are isometric isomorphisms from the complex Hilbert subspaces $V_{\sigma
_{\varphi }+1}$ and $V_{\sigma _{\varphi }-1}$ to the real Hilbert subspaces 
$\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} $ and $\func{Im}_{\varphi
}\left\{ \mathfrak{H}\right\} .$
\end{lemma}

\begin{remark}
Congruent transformations of planes form two different classes:

\begin{enumerate}
\item The first class preserves orientation and is generated by translation
and rotation and correspond to unitary transformations.

\item The second class does not preserve orientation and is obtained from
the first by applying reflection and correspond to antiunitary
transformations.
\end{enumerate}
\end{remark}

\begin{remark}
One can start with real

\begin{enumerate}
\item Hilbert spaces $\mathfrak{H}_{\mathbb{R}}$ of dimension $2r$ equipped
with an inner product $\left( \left. {}\right\vert \right) _{\mathfrak{H}_{%
\mathbb{R}}}$ and symplectic forms $\left\{ \left. {}\right\vert \right\} _{%
\mathfrak{H}_{\mathbb{R}}}$ and construct complex Hilbert spaces

or equivently

\item Hilbert spaces $\mathfrak{H}_{\mathbb{R}}$ of dimension $2r$ and
degenerate non singular two forms (geminals) $g$ and then construct complex
Hilbert spaces$.$
\end{enumerate}
\end{remark}

\begin{theorem}
Let $\mathfrak{H}$ be a complex Hilbert space

\begin{enumerate}
\item A complex conjugation $\sigma _{\left\vert \varphi \right\rangle }\in 
\mathcal{B}_{anti}\left( \mathfrak{H}\right) $ determines an Euclidean
subspace $V_{\sigma _{\varphi }+1}$ of $\mathfrak{H}$ by%
\begin{equation}
\sigma _{\left\vert \varphi \right\rangle }\left( v\right) =\func{Re}%
_{\varphi }\left( v\right) -i\func{Im}_{\varphi }\left( v\right) .
\end{equation}

\item The conjugation complex $\sigma _{\left\vert \varphi \right\rangle
}\in \mathcal{B}_{anti}\left( \mathfrak{H}\right) $ determines an Euclidean
subspace $V_{\sigma _{\varphi }+1}$ of $\mathfrak{H}$ by 
\begin{equation}
V_{\sigma _{\varphi }+1}=\left\{ \sigma _{\left\vert \varphi \right\rangle
}\left( v\right) =v\left\vert v\in \mathfrak{H}\right. \right\} .
\end{equation}

\begin{definition}
The real Hilbert space $\mathrm{V}_{\sigma _{\varphi }+1}$ by 
\begin{equation}
\mathrm{V}_{\sigma _{\varphi }+1}\cong V_{\sigma _{\varphi }+1}.
\end{equation}
\end{definition}

\item $\mathrm{V}_{\sigma _{\varphi }+1}$ can be complexified to give $%
\mathfrak{H}$ i.e. 
\begin{equation}
V_{\sigma _{\varphi }+1}\otimes _{\mathbb{R}}\mathbb{C}=\mathfrak{H}.
\end{equation}

\begin{definition}
One can define an isometric isomorphism $\beta _{r}\in \mathcal{B}_{\mathbb{R%
}}\left( \mathrm{V}_{\sigma _{\varphi }+1},V_{\sigma _{\varphi }+1}\right) $ 
\begin{equation}
\beta _{r}:V_{\sigma _{\varphi }+1}\rightarrow \func{Re}_{\varphi }\left\{ 
\mathfrak{H}\right\} =\mathrm{V}_{\sigma _{\varphi }+1},
\end{equation}%
with respect to the euclidean structures on the complex space $V_{\sigma
_{\varphi }+1}$ and the real space $\func{Re}_{\varphi }\left\{ \mathfrak{H}%
\right\} =\mathrm{V}_{\sigma _{\varphi }+1}$ induced by the Hermitian scalar
product $\left\langle \left. {}\right\vert \right\rangle _{\mathfrak{H}}$ by 
\begin{equation}
\beta _{r}\left( v\right) =\frac{1}{\sqrt{2}}\left( v+\sigma _{\left\vert
\varphi \right\rangle }\left( v\right) \right) =\sqrt{2}\func{Re}_{\varphi
}\left( v\right) .
\end{equation}
\end{definition}

\item The Hilbert space $\mathfrak{H}$ and $\mathfrak{H}_{\mathbb{R}}$ have
orthogonal decompositons wrt $\left\langle \left. {}\right\vert
\right\rangle _{\mathfrak{H}}$ and $\left( \left. {}\right\vert \right) _{%
\mathfrak{H}_{\mathbb{R}}}$ as the direct sums

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{H}=V_{\sigma _{\varphi }+1}\oplus _{\mathbb{R}}V_{\sigma _{\varphi
}-1}
\end{equation}%
and

\item 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\}
\oplus _{\mathbb{R}}\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} .
\end{equation}
\end{enumerate}

\item A complex structure \emph{is induced by the action} of the real
orthogonal complex structure $J_{\varphi }\in O\left( \mathfrak{H}_{\mathbb{R%
}}\right) \subset \mathcal{B}\left( \mathfrak{H}_{\mathbb{R}}\right) $
induced by the real subspace $\mathrm{V}_{\sigma _{\varphi }+1}\subset 
\mathfrak{H}_{\mathbb{R}}$ on $\func{Re}_{\varphi }\left\{ \mathfrak{H}%
\right\} $ by%
\begin{equation}
\beta _{r}:V_{\sigma \left( \varphi \right) +1}\rightarrow \mathcal{J}%
\left\{ \func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} \right\}
\end{equation}%
and 
\begin{equation}
\mathcal{J}\left( J_{\varphi }\right) =iI_{\mathfrak{H}},
\end{equation}%
giving%
\begin{equation}
J_{\varphi }v=\beta _{r}\left( i\overset{}{\beta _{r}^{-1}(v)}\right)
,\,v\in \func{Re}_{\varphi }\left\{ \mathfrak{H}\right\}
\end{equation}%
showing that $\beta _{r}$ is a complex-linear isometry between the complex
space $\mathfrak{H}$ and the $J_{\varphi }$-complexification $\func{Re}%
_{\varphi }\mathfrak{H}\otimes _{\mathbb{R}}\mathbb{C}$.
\end{enumerate}
\end{theorem}

\subparagraph{Construction of a Complex Hilbert Space $\mathfrak{H}$ of
dimension $r$ from a Real Hilbert Space $\mathfrak{H}_{\mathbb{R}}$ of
dimension $2r$.}

\begin{notation}
In the following the inner product in $\mathfrak{H}$ and $\mathfrak{H}_{%
\mathbb{R}}$ are denoted by $\left\langle \left. {}\right\vert \right\rangle 
$ and $\left( \left. {}\right\vert \right) $ and not $\left\langle \left.
{}\right\vert \right\rangle _{\mathfrak{H}}$ and $\left( \left.
{}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}.$
\end{notation}

A \emph{real conjugation} $\sigma _{\mathrm{V}}\in \mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}}\right) $ is a self adjoint involution with
eigenvalues $\pm 1$ and eigenvectors $\left\{ \left. \Phi _{j}\right\vert
1\leq j\leq 2r\right\} $ 
\begin{equation}
\sigma _{\mathrm{V}}:\mathfrak{H}_{\mathbb{R}}\rightarrow \mathfrak{H}_{%
\mathbb{R}}
\end{equation}%
with the properties:

\begin{enumerate}
\item It defines a\ $r$ -dimensional subspace $\mathrm{V}\subset $ $%
\mathfrak{H}_{\mathbb{R}}$ by  
\begin{equation}
\mathrm{V}=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left. \Phi
_{j}\right\vert \sigma _{\mathrm{V}}\left\vert \Phi _{j}\right) =\left\vert
\Phi _{j}\right) ,1\leq j\leq r\right\} =
\end{equation}%
and a orthogonal complement 
\begin{equation}
\mathrm{V}^{\bot }=\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left. \Phi
_{j}\right\vert \sigma _{\mathrm{V}}\left\vert \Phi _{j}\right) =-\left\vert
\Phi _{j}\right) ,r+1\leq j\leq 2r\right\} .
\end{equation}

\item It is an involution 
\begin{equation}
\sigma _{\mathrm{V}}^{2}=I_{\mathfrak{H}_{\mathbb{R}}}.
\end{equation}

\item It is a real symmetric%
\begin{equation}
\sigma _{\mathrm{V}}=\sigma _{\mathrm{V}}^{t}.
\end{equation}

\item It has a Spectral decomposition  
\begin{equation}
\sigma _{\mathrm{V}}=\sum_{1\leq j\leq r}\left\{ \left\vert \Phi _{j}\right)
\left( \Phi _{j}\right\vert -\left\vert \Phi _{j+r}\right) \left( \Phi
_{j+r}\right\vert \right\} =\sum_{1\leq j\leq r}\left\{ P_{\Phi
_{j}}-P_{\Phi _{j+r}}\right\} =P_{\mathrm{V}}-P_{\mathrm{V}^{\bot }},
\end{equation}%
where the eigenvectors $\left\{ \left. \Phi \right\vert \right\} $ $%
\left\vert 1\leq j\leq 2r\right) $ of $\sigma _{\mathrm{V}}$ is a conb of $%
\mathfrak{H}_{\mathbb{R}}$ and $P_{\mathrm{V}}$ and $P_{\mathrm{V}^{\bot }}$
are orthogonal projectors onto the real orthogonal isometric isomorphic
subspaces $\mathrm{V}_{\sigma _{\mathrm{V}}}$ and $\mathrm{V}_{\sigma _{%
\mathrm{V}}}^{\bot }.$

\item Equivalence relation between bases 
\begin{equation}
\left( \overset{}{\left\vert \boldsymbol{\Phi }\right) \backsim \left\vert 
\boldsymbol{\Psi }\right) }\right) \Leftrightarrow \left( \overset{}{%
o\left\vert \boldsymbol{\Phi }\right) =\left\vert \boldsymbol{\Psi }\right) }%
\right) ,\,o\in O\left( P_{\mathrm{V}}\mathfrak{H}_{\mathbb{R}}\right)
=O\left( P_{\mathrm{V}^{\bot }}\right) .
\end{equation}

\item Equivalence classes of based%
\begin{equation}
\left[ \boldsymbol{\Phi }\right] =\left\{ \left. \overset{}{\left\vert 
\boldsymbol{\Psi }\right) }\right\vert \overset{}{\left\vert \boldsymbol{%
\Psi }\right) =o\left\vert \boldsymbol{\Phi }\right) ,o\in }O\left( P_{%
\mathrm{V}}\mathfrak{H}_{\mathbb{R}}\right) \right\} .
\end{equation}

\item Eigenspaces $\mathrm{V},\mathrm{V}^{\bot }$ of $\sigma _{\mathrm{V}}$
produce the direct sum decomposition of $\mathfrak{H}_{\mathbb{R}}$ 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathrm{V}\oplus _{\mathbb{R}}\mathrm{V}^{\bot },
\end{equation}%
where

\begin{definition}
\begin{enumerate}
\item 
\begin{equation}
\mathrm{V}_{\sigma _{\Phi }+1}=\left\{ \left. v\right\vert \sigma _{\mathrm{V%
}}\left( v\right) =v,v\in \mathfrak{H}_{\mathbb{R}}\right\} =P_{\mathrm{V}}%
\mathfrak{H}_{\mathbb{R}}
\end{equation}%
and

\item 
\begin{equation}
\mathrm{V}_{\sigma _{\Phi }-1}=\left\{ \left. v\right\vert \sigma _{\mathrm{V%
}}\left( v\right) =-v,v\in \mathfrak{H}_{\mathbb{R}}\right\} =P_{\mathrm{V}%
^{\bot }}\mathfrak{H}_{\mathbb{R}}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
The subspaces $\mathrm{V}$ and $\mathrm{V}^{\bot }$ are isometrically
isomorphic i.e. 
\begin{equation}
\mathrm{V}\cong \mathrm{V}^{\bot }\,.
\end{equation}
\end{lemma}

\item One can select a real subspace $\mathrm{V}\subset \mathfrak{H}_{%
\mathbb{R}}$ of dimension $r,$ this dertermines:

\begin{enumerate}
\item The orthogonal projector $P_{\mathrm{V}}$ 
\begin{equation}
P_{\mathrm{V}}:\mathfrak{H}_{\mathbb{R}}\rightarrow \mathrm{V}
\end{equation}%
onto $\mathrm{V.}$

\item The orthogonal complement 
\begin{equation}
\mathrm{V}^{\bot }\subset \mathfrak{H}_{\mathbb{R}}
\end{equation}%
of $\mathrm{V.}$

\item The complimentary orthogonal projector 
\begin{equation}
P_{\mathrm{V}}^{\bot }:\mathfrak{H}_{\mathbb{R}}\rightarrow \mathrm{V}^{\bot
}
\end{equation}
onto $\mathrm{V}^{\bot }$ that is given by 
\begin{equation}
P_{\mathrm{V}}^{\bot }=I_{\mathfrak{H}_{\mathbb{R}}}-P_{\mathrm{V}}=P_{%
\mathrm{V}^{\bot }}.
\end{equation}%
$.$

\item One can construct a real conjugation $\sigma _{\mathrm{V}}$ that has $%
\mathrm{V}$ and $\mathrm{V}^{\bot }$ as invariant subspaces i.e 
\begin{equation}
\left[ \sigma _{\mathrm{V}},P_{\mathrm{V}}\right] =\left[ \sigma _{\mathrm{V}%
},P_{\mathrm{V}}^{\bot }\right] =0
\end{equation}

\item The direct sum decomposition 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathrm{V}_{\sigma _{\Phi }+1}\oplus _{\mathbb{R}}%
\mathrm{V}_{\sigma _{\Phi }-1},
\end{equation}

\item The conbs $\left\vert \boldsymbol{\Phi }\right) $ can be decomposed
into two sets 
\begin{equation}
\left\vert \boldsymbol{\Phi }\right) =\left\vert \boldsymbol{\Phi }_{+1},%
\boldsymbol{\Phi }_{-1}\right) =\left\vert P_{\mathrm{V}}\boldsymbol{\Phi }%
,P_{\mathrm{V}}^{\bot }\boldsymbol{\Phi }\right) 
\end{equation}%
one a basis for $\mathrm{V}$ the other a basis for $\mathrm{V}^{\bot },$
where 
\begin{equation}
\Phi _{+1j}=\Phi _{j}
\end{equation}%
and 
\begin{equation}
\Phi _{-1j}=\Phi _{j+r.}
\end{equation}%
The bases $\left\{ \left\vert \boldsymbol{\Phi }_{+1}\right) ,\left\vert 
\boldsymbol{\Phi }_{-1}\right) \right\} $ are only unique up to $O\left( 
\mathrm{V}\right) $ transformations. 

\item  Clearly 
\begin{equation}
\mathrm{V}\leftrightarrow P_{\mathrm{V}}\leftrightarrow P_{\mathrm{V}}%
\boldsymbol{\Phi }=\left\vert \boldsymbol{\Phi }_{+1}\right) \leftrightarrow
P_{\mathrm{V}}^{\bot }\boldsymbol{\Phi }=\left\vert \boldsymbol{\Phi }%
_{-1}\right) \leftrightarrow \sigma _{\mathrm{V}}.
\end{equation}

\item As described previously 
\begin{equation}
\sigma _{\mathrm{V}}\leftrightarrow J_{\mathrm{V}}.
\end{equation}

\item One can construct a complexifications $\mathfrak{H}_{\mathrm{V}}=%
\mathcal{J}_{\mathrm{V}}\left( \mathfrak{H}_{\mathbb{R}}\right) $ of $%
\mathfrak{H}_{\mathbb{R}}$ by

\begin{enumerate}
\item  
\begin{equation}
\mathcal{J}_{\mathrm{V}}\left( J_{\mathrm{V}}\right) =i
\end{equation}

\item 
\begin{eqnarray}
\mathcal{J}_{\mathrm{V}}\left( \Phi _{j}\right)  &=&\varphi _{j},\,1\leq
j\leq r \\
\mathcal{J}_{\mathrm{V}}\left( \Phi _{j+r}\right)  &=&\mathcal{J}_{\mathrm{V}%
}\left( J_{\mathrm{V}}\right) \varphi _{j}=i\varphi _{j},\,1\leq j\leq r.
\end{eqnarray}

\item equipped with the inner product%
\begin{equation}
\left\langle \left. {}\right\vert \right\rangle _{\mathfrak{H}_{\mathrm{V}%
}}=\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}+i\left(
\left. {}\right\vert J_{\mathrm{V}}\right) _{\mathfrak{H}_{\mathbb{R}%
}}=\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}+i\left\{
\left. {}\right\vert \right\} _{J_{\mathrm{V}}}
\end{equation}
\end{enumerate}

\item giving the complex conjugation%
\begin{equation}
\sigma _{\varphi }\equiv \sigma _{V_{\varphi +}}=\mathcal{J}_{\mathrm{V}%
}\left( \sigma _{\mathrm{V}}\right) .
\end{equation}

\item The realification $\mathcal{R}_{V_{\varphi +}}$ is the the inverse of
the complexification $\mathcal{J}_{\mathrm{V}}^{-1}$ i.e.

\begin{enumerate}
\item 
\begin{equation}
\mathcal{J}_{\mathrm{V}}^{-1}\left( \func{Re}_{\varphi }\left\{ \mathfrak{H}%
_{\mathrm{V}}\right\} \right) =\mathcal{J}_{\mathrm{V}}^{-1}\left(
V_{\varphi +}\right) =\mathrm{V}
\end{equation}%
and 

\item 
\begin{equation}
\mathcal{J}_{\mathrm{V}}^{-1}\left( \func{Im}_{\varphi }\left\{ \mathfrak{H}%
_{\mathrm{V}}\right\} \right) =\mathcal{J}_{\mathrm{V}}^{-1}\left(
iV_{\varphi -}\right) =\mathrm{V}^{\bot }
\end{equation}
\end{enumerate}
\end{enumerate}

\item Real conjugations $\sigma _{\mathrm{V}}$ have zero trace i.e. 
\begin{equation}
\limfunc{Tr}\left( \sigma _{\mathrm{V}}\right) =0.
\end{equation}

\item Corresponding with each real conjugation $\sigma _{\mathrm{V}}$ is a
complex unit $J_{\mathrm{V}}\in $ $\mathcal{B}\left( \mathfrak{H}_{\mathbb{R}%
}\right) $ defined by 
\begin{equation}
J_{\mathrm{V}}=\sum_{1\leq j\leq r}\left\{ \left\vert \Phi _{j}\right)
\left( \Phi _{j+r}\right\vert -\left\vert \Phi _{j+r}\right) \left( \Phi
_{j}\right\vert \right\} =\sum_{1\leq j\leq r}\left\{ p\left( \Phi \right)
_{jj+r}-p\left( \Phi \right) _{j+rj}\right\} =p\left( \Phi \right) -p\left(
\Phi \right) ^{t},
\end{equation}%
where 
\begin{equation}
p\left( \Phi \right) _{jj+r}=\left\vert \Phi _{j}\right) \left( \Phi
_{j+r}\right\vert 
\end{equation}%
and 
\begin{equation}
p\left( \Phi \right) =\sum_{1\leq j\leq r}p\left( \Phi \right)
_{jj+r}=\sum_{1\leq j\leq r}\left\vert \Phi _{j}\right) \left( \Phi
_{j+r}\right\vert .
\end{equation}

\item The operators 
\begin{equation}
\left\{ \left. p\left( \Phi \right) _{jj+r}=\left\vert \Phi _{j}\right)
\left( \Phi _{j+r}\right\vert \right\vert 1\leq j\leq r\right\} 
\end{equation}%
are partial isometries i.e. 
\begin{equation}
p\left( \Phi \right) _{jj+r}^{t}p\left( \Phi \right) _{j+rj}=\left(
\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert \right) ^{t}\left(
\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert \right) =P_{\Phi
_{j+r}},1\leq j\leq r
\end{equation}%
and 
\begin{equation}
p\left( \Phi \right) _{j+rj}p\left( \Phi \right) _{jj+r}^{t}=P_{\Phi
_{j}},1\leq j\leq r,
\end{equation}%
where $\left\{ \left. P_{\Phi _{j}}\right\vert 1\leq j\leq 2r\right\} $ are
orthogonal projectors onto the one dimensional subspaces generated by the
eigenvectors $\left\{ \left. \Phi _{j}\right\vert 1\leq j\leq 2r\right\} .$

\item The operator $p\left( \Phi \right) $ is a partial isometry as 
\begin{equation}
p\left( \Phi \right) ^{t}p\left( \Phi \right) =\left( \sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert \right)
^{t}\left( \sum_{1\leq j\leq r}\left\vert \Phi _{j}\right) \left( \Phi
_{j+r}\right\vert \right) =\sum_{1\leq j\leq r}\left\vert \Phi _{j+r}\right)
\left( \Phi _{j}\right\vert \left\vert \Phi _{j}\right) \left( \Phi
_{j+r}\right\vert =\sum_{1\leq j\leq r}\left\vert \Phi _{j+r}\right) \left(
\Phi _{j+r}\right\vert =P_{\Phi _{-}}
\end{equation}%
as%
\begin{equation}
p\left( \Phi \right) p\left( \Phi \right) ^{t}=\left( \sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert \right) \left(
\sum_{1\leq j\leq r}\left\vert \Phi _{j}\right) \left( \Phi
_{j+r}\right\vert \right) ^{t}=\sum_{1\leq j\leq r}\left\vert \Phi
_{j}\right) \left( \Phi _{j+r}\Phi _{j}\right\vert \left\vert \Phi
_{j+r}\right) \left( \Phi _{j}\right\vert =\sum_{1\leq j\leq r}\left\vert
\Phi _{j}\right) \left( \Phi _{j}\right\vert =P_{\Phi _{+}}.
\end{equation}

\begin{enumerate}
\item 
\begin{eqnarray}
p\left( \Phi \right) P_{\Phi _{-}} &=&\sum_{1\leq j\leq r}\left\vert \Phi
_{j}\right) \left( \Phi _{j+r}\right\vert \sum_{1\leq j\leq r}\left\vert
\Phi _{j+r}\right) \left( \Phi _{j+r}\right\vert =\sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert =p\left( \Phi
\right)  \\
P_{\Phi _{-}}p\left( \Phi \right)  &=&\sum_{1\leq j\leq r}\left\vert \Phi
_{j+r}\right) \left( \Phi _{j+r}\right\vert \sum_{1\leq j\leq r}\left\vert
\Phi _{j}\right) \left( \Phi _{j+r}\right\vert =0 \\
P_{\Phi _{-}}p\left( \Phi \right) P_{\Phi _{-}} &=&0 \\
p\left( \Phi \right) P_{\Phi _{+}} &=&\sum_{1\leq j\leq r}\left\vert \Phi
_{j}\right) \left( \Phi _{j+r}\right\vert \sum_{1\leq j\leq r}\left\vert
\Phi _{j}\right) \left( \Phi _{j}\right\vert =0 \\
P_{\Phi _{+}}p\left( \Phi \right)  &=&\sum_{1\leq j\leq r}\left\vert \Phi
_{j}\right) \left( \Phi _{j}\right\vert \sum_{1\leq j\leq r}\left\vert \Phi
_{j}\right) \left( \Phi _{j+r}\right\vert =\sum_{1\leq j\leq r}\left\vert
\Phi _{j}\right) \left( \Phi _{j+r}\right\vert =p\left( \Phi \right)  \\
P_{\Phi _{+}}p\left( \Phi \right) P_{\Phi _{+}} &=&0
\end{eqnarray}

\item 
\begin{eqnarray}
p\left( \Phi \right) ^{t}P_{\Phi _{-}} &=&\left( P_{\Phi _{-}}p\left( \Phi
\right) \right) ^{t}=0 \\
P_{\Phi _{-}}p\left( \Phi \right) ^{t} &=&\left( p\left( \Phi \right)
P_{\Phi _{-}}\right) ^{t}=p\left( \Phi \right) ^{t} \\
P_{\Phi _{-}}p\left( \Phi \right) ^{t}P_{\Phi _{-}} &=&0 \\
p\left( \Phi \right) ^{t}P_{\Phi _{+}} &=&\left( P_{\Phi _{+}}p\left( \Phi
\right) \right) ^{t}=p\left( \Phi \right) ^{t} \\
P_{\Phi _{+}}p\left( \Phi \right) ^{t} &=&\left( p\left( \Phi \right)
P_{\Phi _{+}}\right) ^{t}=0 \\
P_{\Phi _{+}}p\left( \Phi \right) ^{t}P_{\Phi _{+}} &=&0
\end{eqnarray}

\item 
\begin{eqnarray}
P_{\Phi _{+}}p\left( \Phi \right) P_{\Phi _{-}} &=&\sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j}\right\vert \sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert \sum_{1\leq
j\leq r}\left\vert \Phi _{j+r}\right) \left( \Phi _{j+r}\right\vert =p\left(
\Phi \right)  \\
P_{\Phi _{-}}p\left( \Phi \right) P_{\Phi _{+}} &=&\sum_{1\leq j\leq
r}\left\vert \Phi _{j+r}\right) \left( \Phi _{j+r}\right\vert \sum_{1\leq
j\leq r}\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert
\sum_{1\leq j\leq r}\left\vert \Phi _{j}\right) \left( \Phi _{j}\right\vert
=0
\end{eqnarray}

\item 
\begin{eqnarray}
P_{\Phi _{+}}p\left( \Phi \right) ^{t}P_{\Phi _{-}} &=&\sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j}\right\vert \sum_{1\leq j\leq
r}\left\vert \Phi _{j+r}\right) \left( \Phi _{j}\right\vert \sum_{1\leq
j\leq r}\left\vert \Phi _{j+r}\right) \left( \Phi _{j+r}\right\vert =0 \\
P_{\Phi _{-}}p\left( \Phi \right) ^{t}P_{\Phi _{+}} &=&\sum_{1\leq j\leq
r}\left\vert \Phi _{j+r}\right) \left( \Phi _{j+r}\right\vert \sum_{1\leq
j\leq r}\left\vert \Phi _{j+r}\right) \left( \Phi _{j}\right\vert
\sum_{1\leq j\leq r}\left\vert \Phi _{j}\right) \left( \Phi _{j}\right\vert
=p\left( \Phi \right) ^{t}
\end{eqnarray}
\end{enumerate}

\item Imaginary unit property%
\begin{equation}
J_{\Phi }^{2}=-I_{\mathfrak{H}_{\mathbb{R}}}.
\end{equation}

\item $J_{\Phi }$ is antisymmetric 
\begin{equation}
J_{\Phi }^{t}=-J_{\Phi }.
\end{equation}

\item $J_{\Phi }$ is an orthogonal transfromation i.e. belongs to the
orthogonal group $O\left( \mathfrak{H}_{\mathbb{R}}\right) $ i.e. 
\begin{equation}
J_{\Phi }J_{\Phi }^{t}=J_{\Phi }^{t}J_{\Phi }=I_{\mathfrak{H}_{\mathbb{R}}}.
\end{equation}

\item $J_{\mathrm{V}}$ defines a Symplectic form $\left\{ \left.
{}\right\vert \right\} _{J_{\mathrm{V}}}$ given by 
\begin{eqnarray}
\left\{ \left. x\right\vert y\right\} _{J_{\mathrm{V}}} &=&\left( \left.
x\right\vert J_{\mathrm{V}}y\right)  \\
&=&\left( \left. x\right\vert \left( p\left( \Phi \right) -p\left( \Phi
\right) ^{t}\right) y\right) =\left( \left. \left( P_{\Phi _{+}}+P_{\Phi
_{-}}\right) x\right\vert \left( p\left( \Phi \right) -p\left( \Phi \right)
^{t}\right) \left( P_{\Phi _{+}}+P_{\Phi _{-}}\right) y\right)  \\
&=&\left( \left. \left( P_{\Phi _{+}}+P_{\Phi _{-}}\right) x\right\vert
p\left( \Phi \right) \left( P_{\Phi _{+}}+P_{\Phi _{-}}\right) y\right)
-\left( \left. \left( P_{\Phi _{+}}+P_{\Phi _{-}}\right) x\right\vert
p\left( \Phi \right) ^{t}\left( P_{\Phi _{+}}+P_{\Phi _{-}}\right) y\right) 
\\
&=&\left( \left. x\right\vert P_{\Phi _{+}}p\left( \Phi \right) P_{\Phi
_{+}}y\right) +\left( \left. x\right\vert P_{\Phi _{+}}p\left( \Phi \right)
P_{\Phi _{-}}y\right) +\left( \left. x\right\vert P_{\Phi _{-}}p\left( \Phi
\right) P_{\Phi _{+}}y\right) +\left( \left. x\right\vert P_{\Phi
_{-}}p\left( \Phi \right) P_{\Phi _{-}}y\right)  \\
&&-\left( \left. x\right\vert P_{\Phi _{+}}p\left( \Phi \right) ^{t}P_{\Phi
_{+}}y\right) -\left( \left. x\right\vert P_{\Phi _{+}}p\left( \Phi \right)
^{t}P_{\Phi _{-}}y\right) -\left( \left. x\right\vert P_{\Phi _{-}}p\left(
\Phi \right) ^{t}P_{\Phi _{+}}y\right) -\left( \left. x\right\vert P_{\Phi
_{-}}p\left( \Phi \right) ^{t}P_{\Phi _{-}}y\right)  \\
&=&\left( \left. x\right\vert P_{\Phi _{+}}p\left( \Phi \right) P_{\Phi
_{-}}y\right) -\left( \left. x\right\vert P_{\Phi _{-}}p\left( \Phi \right)
^{t}P_{\Phi _{+}}y\right)  \\
&=&\left( \left. P_{\Phi _{+}}x\right\vert p\left( \Phi \right) P_{\Phi
_{-}}y\right) -\left( \left. x\right\vert P_{\Phi _{-}}p\left( \Phi \right)
^{t}P_{\Phi _{+}}y\right) 
\end{eqnarray}%
i.e.%
\begin{eqnarray}
\left\{ \left. x\right\vert y\right\} _{J_{\mathrm{V}}} &=&\left( \left.
P_{\Phi _{+}}x\right\vert p\left( \Phi \right) P_{\Phi _{-}}y\right) -\left(
\left. P_{\Phi _{-}}x\right\vert p\left( \Phi \right) ^{t}P_{\Phi
_{+}}y\right)  \\
&=&\left( \left. \overset{}{P_{\Phi _{+}}x}\right\vert \sum_{1\leq j\leq
r}\left\vert \Phi _{j}\right) \left( \Phi _{j+r}\right\vert P_{\Phi
_{-}}y\right) -\left( \left. \overset{}{P_{\Phi _{-}}x}\right\vert
\sum_{1\leq j\leq r}\left\vert \Phi _{j+r}\right) \left( \Phi
_{j}\right\vert P_{\Phi _{+}}y\right) .
\end{eqnarray}

\item The Symplectic form $\left\{ \left. {}\right\vert \right\} _{J_{\Phi }}
$ corresponds to a dual $2$-form $g_{\Phi }^{d}$ by 
\begin{equation}
\left\{ \left. x\right\vert y\right\} _{J_{\Phi }}=g_{\Phi }^{d}\left(
x,y\right) =\left\langle \left. g_{\Phi }\right\vert x\wedge y\right\rangle
_{\wedge ^{2}\mathfrak{H}_{\mathbb{R}}},
\end{equation}%
where 
\begin{equation}
g_{\Phi }=\sum_{1\leq j\leq r}\Phi _{j}\wedge \Phi _{j+r}.
\end{equation}

\item The invariance group of $\sigma _{\mathrm{V}}$ is $O\left( \mathrm{V}%
\right) $ as for $a\in O\left( \mathrm{V}\right) $ one has 
\begin{equation}
\sigma _{\mathrm{V}}=\mathfrak{R}_{\Phi }\left( a\right) \sigma _{\mathrm{V}%
}\Phi \left( a^{-1}\right) =\mathfrak{R}_{\Phi }\left( a\right) \sigma _{%
\mathrm{V}}\Phi \left( a\right) ^{-1}=\widehat{\mathfrak{R}_{\Phi }\left(
a\right) }\left( \sigma _{\mathrm{V}}\right) =\limfunc{Adj}\left( \mathfrak{R%
}_{\Phi }\left( a\right) \right) \left( \sigma _{\mathrm{V}}\right) =%
\mathfrak{R}_{\Phi }\left( a\right) \sigma _{\mathrm{V}}\mathfrak{R}_{\Phi
}\left( a\right) ^{t},
\end{equation}%
where

\begin{enumerate}
\item 
\begin{definition}
$\mathfrak{R}_{\Phi }$ is the operator representation of groups $G$ in $%
\mathcal{M}\left( 2,2,\mathcal{B}\left( \mathfrak{H}_{\mathbb{R}}\right)
\right) $ wrt the basis $\left( \boldsymbol{\Phi }\right) =\left( 
\boldsymbol{\Phi }_{1},\boldsymbol{\Phi }_{2}\right) $ e.g.%
\begin{equation}
\mathfrak{R}_{\Phi }:G\rightarrow \mathfrak{R}_{\Phi }\left( G\right)
\subset \mathcal{M}\left( 2,2,\mathcal{B}\left( \mathfrak{H}_{\mathbb{R}%
}\right) \right) 
\end{equation}
\end{definition}

\item on the direct sum 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathrm{V}_{\sigma _{\Phi }+1}\oplus _{\mathbb{R}}%
\mathrm{V}_{\sigma _{\Phi }-1}
\end{equation}%
giving 
\begin{equation}
\mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}\left( a\right) =\mathfrak{R}_{\Phi
}\left( a\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}_{\sigma _{\Phi }+1}\mathrm{V%
}_{\sigma _{\Phi }+1}} & \mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}%
_{\sigma _{\Phi }+1}\mathrm{V}_{\sigma _{\Phi }-1}} \\ 
\mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}_{\sigma _{\Phi }-1}\mathrm{V%
}_{\sigma _{\Phi }+1}} & \mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}%
_{\sigma _{\Phi }-1}\mathrm{V}_{\sigma _{\Phi }+1}}%
\end{array}%
\right) ,\,a\in G.
\end{equation}

\item Hence for the Orthogonal group $O\left( \mathrm{V}\right) $ 
\begin{equation}
\mathfrak{R}_{\Phi }:O\left( \mathrm{V}\right) \rightarrow \mathfrak{R}%
_{\Phi }\left( O\left( \mathrm{V}\right) \right) =O\left( \mathrm{V}_{\sigma
_{\Phi }+1}\right) =\mathfrak{R}_{\Phi }\left( O\left( \mathrm{V}_{\sigma
_{\Phi }+1}\right) \right) \subset \mathcal{M}\left( 2,2,\mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}}\right) \right) 
\end{equation}%
giving explicitly

\item 
\begin{equation}
\mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}\left( a\right) =\mathfrak{R}_{\Phi
}\left( a\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}_{\sigma _{\Phi }+1}\mathrm{V%
}_{\sigma _{\Phi }+1}} & O_{\mathrm{V}_{\sigma _{\Phi }+1}\mathrm{V}_{\sigma
_{\Phi }-1}} \\ 
O_{\mathrm{V}_{\sigma _{\Phi }-1}\mathrm{V}_{\sigma _{\Phi }+1}} & \mathfrak{%
R}_{\Phi }\left( a\right) _{\mathrm{V}_{\sigma _{\Phi }-1}\mathrm{V}_{\sigma
_{\Phi }+1}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\mathrm{V}_{\sigma _{\Phi }+1}}\left( a\right)  & O_{\mathrm{V}%
_{\sigma _{\Phi }+1}\mathrm{V}_{\sigma _{\Phi }-1}} \\ 
O_{\mathrm{V}_{\sigma _{\Phi }-1}\mathrm{V}_{\sigma _{\Phi }+1}} & \mathfrak{%
R}_{\mathrm{V}_{\sigma _{\Phi }-1}}\left( a\right) 
\end{array}%
\right) =\mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}_{\sigma _{\Phi
}+1}}\oplus _{\mathbb{R}}\mathfrak{R}_{\Phi }\left( a\right) _{\mathrm{V}%
_{\sigma _{\Phi }-1}}.
\end{equation}
\end{enumerate}

\item The invariance group of $J_{\mathrm{V}}$ \emph{contains} the real
Orthogonal group $O\left( \mathrm{V}_{\sigma _{\Phi }+1}\right) $ as%
\begin{equation}
J_{\mathrm{V}}=\widehat{\mathfrak{R}_{\Phi }\left( a\right) }\left( J_{%
\mathrm{V}}\right) ,\,a\in O\left( \mathrm{V}\right) .
\end{equation}

\item The invariance group of $J_{\mathrm{V}}$ is the real Symplectic group $%
\mathfrak{R}_{\Phi }\left( Sp\left( \mathfrak{H}_{\mathbb{R}}\right) \right) 
$%
\begin{eqnarray}
\mathfrak{R}_{\Phi }\left( Sp\left( \mathfrak{H}_{\mathbb{R}}\right) \right)
&=&\left\{ \mathfrak{R}_{\Phi }\left( a\right) \left\vert \overset{}{\left\{
\left. \limfunc{Adj}\left( \mathfrak{R}_{\Phi }\left( a\right) \right)
v\right\vert \limfunc{Adj}\left( \mathfrak{R}_{\Phi }\left( a\right) \right)
w\right\} _{J_{\mathrm{V}}}}\right. \right\}  \\
&=&\left\{ \left. \overset{}{\mathfrak{R}_{\Phi }\left( a\right) }%
\right\vert \limfunc{Adj}\left( \mathfrak{R}_{\Phi }\left( a\right) \right)
\left( J_{\mathrm{V}}\right) =J_{\mathrm{V}}\right\} ,
\end{eqnarray}%
where 
\begin{equation}
\mathfrak{R}_{\Phi }:Sp\left( \mathfrak{H}_{\mathbb{R}}\right) \rightarrow 
\mathcal{M}\left( 2,2,\mathcal{B}\left( \mathfrak{H}_{\mathbb{R}}\right)
\right) \subset \mathcal{B}\left( \mathcal{B}\left( \mathfrak{H}_{\mathbb{R}%
}\right) \right) .
\end{equation}

\item The real Symplectic group $Sp\left( \mathfrak{H}_{\mathbb{R}}\right) $
contains the real Orthogonal group $O\left( \mathrm{V}\right) $ 
\begin{equation}
Sp\left( \mathfrak{H}_{\mathbb{R}}\right) \supset O\left( \mathrm{V}\right) 
\end{equation}

\item The invariance Group of $\left( \left. {}\right\vert \right) $ is the
real Orthogonal group $O\left( \mathfrak{H}_{\mathbb{R}}\right) $ defined by 
\begin{equation}
\left\{ \left. \overset{}{a}\right\vert \left( \left. \overset{}{\mathfrak{R}%
_{\Phi }\left( a\right) v}\right\vert \mathfrak{R}_{\Phi }\left( a\right)
w\right) =\left( \left. v\right\vert w\right) ,\,v,w\in \mathfrak{H}_{%
\mathbb{R}}\right\} .
\end{equation}

\begin{enumerate}
\item The real Orthogonal Symplectic group $OSp\left( \mathfrak{H}_{\mathbb{R%
}}\right) $ is defined as 
\begin{equation}
OSp\left( \mathfrak{H}_{\mathbb{R}}\right) =O\left( \mathfrak{H}_{\mathbb{R}%
}\right) \cap Sp\left( \mathfrak{H}_{\mathbb{R}}\right) .
\end{equation}

\item The intersection of the real Orthogonal and Symplectic groups $O\left( 
\mathfrak{H}_{\mathbb{R}}\right) ,Sp\left( \mathfrak{H}_{\mathbb{R}}\right) $
contains the real Orthogonal group $O\left( \mathrm{V}\right) $ i.e. 
\begin{equation}
O\left( \mathfrak{H}_{\mathbb{R}}\right) \cap Sp\left( \mathfrak{H}_{\mathbb{%
R}}\right) \supset O\left( \mathrm{V}\right) .
\end{equation}

\item In particular in the $\mathfrak{R}_{\Phi }$-operator representation 
\begin{equation}
\mathfrak{R}_{\Phi }\left( \overset{}{O\left( \mathfrak{H}_{\mathbb{R}%
}\right) \cap Sp\left( \mathfrak{H}_{\mathbb{R}}\right) }\right) =\mathfrak{R%
}_{\Phi }\left( \overset{}{O\left( \mathfrak{H}_{\mathbb{R}}\right) }\right)
\,{\large \cap \,\,}\mathfrak{R}_{\Phi }\left( \overset{}{Sp\left( \mathfrak{%
H}_{\mathbb{R}}\right) }\right) \supset \mathfrak{R}_{\Phi }\left( \overset{}%
{O\left( \mathrm{V}\right) }\right) .
\end{equation}

\item If $T\in OSp\left( \mathfrak{H}_{\mathbb{R}}\right) $ then 
\begin{equation}
\left( \left. \overset{}{\mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}\left(
T\right) v}\right\vert \mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}\left(
T\right) w\right) +\left\{ \left. \overset{}{\mathfrak{R}_{\mathfrak{H}_{%
\mathbb{R}}}\left( T\right) v}\right\vert \mathfrak{R}_{\mathfrak{H}_{%
\mathbb{R}}}\left( T\right) Tw\right\} =\left( \left. v\right\vert w\right)
+\left\{ \left. v\right\vert w\right\} _{\mathrm{V}}=\left( \left.
v\right\vert w\right) +\left( \left. v\right\vert J_{\mathrm{V}}w\right)
,\,\,v,w\in \mathfrak{H}_{\mathbb{R}},
\end{equation}%
as 
\begin{equation}
T^{t}J_{\mathrm{V}}T=J_{\mathrm{V}},
\end{equation}%
where%
\begin{equation}
\mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}:O\left( \mathfrak{H}_{\mathbb{R}%
}\right) \rightarrow \mathcal{M}\left( 2,2,\mathcal{B}\left( \mathfrak{H}_{%
\mathbb{R}}\right) \right) \subset \mathcal{B}\left( \mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}}\right) \right) 
\end{equation}%
and%
\begin{equation}
\mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}:Sp\left( \mathfrak{H}_{\mathbb{R}%
}\right) \rightarrow \mathcal{M}\left( 2,2,\mathcal{B}\left( \mathfrak{H}_{%
\mathbb{R}}\right) \right) \subset \mathcal{B}\left( \mathcal{B}\left( 
\mathfrak{H}_{\mathbb{R}}\right) \right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{lemma}
The following are in $1-1$ correspondence 
\begin{equation}
J_{\mathrm{V}}\leftrightarrow \left[ \Phi _{\mathrm{V}}\right]
\leftrightarrow \sigma _{\mathrm{V}}\leftrightarrow \mathrm{V}%
\leftrightarrow P_{\mathrm{V}}\leftrightarrow \mathrm{V}_{\sigma _{\mathrm{V}%
}+1}\leftrightarrow P_{\sigma _{\mathrm{V}}+1}\leftrightarrow \mathrm{V}%
_{\sigma _{\mathrm{V}}-1}\leftrightarrow P_{\sigma \mathrm{V}-1}.
\end{equation}
\end{lemma}

\begin{definition}
$\left[ \Phi _{\mathrm{V}}\right] $ is the set of conbs of the real subspace 
$\mathrm{V.}$
\end{definition}

\begin{definition}
The $\mathcal{J}_{\mathrm{V}}$-complexification of the real Hilbert space $%
\mathfrak{H}_{\mathbb{R}}$ induced by the complex unit $\mathcal{J}_{\mathrm{%
V}}$ 
\begin{equation}
\mathfrak{H}_{\mathrm{V}}=\mathcal{J}_{\mathrm{V}}\left( \mathfrak{H}_{%
\mathbb{R}}\right) 
\end{equation}%
is given by

\begin{enumerate}
\item 
\begin{equation}
\mathcal{J}_{\mathrm{V}}\in \mathcal{B}_{\mathbb{R}}\left( \mathfrak{H}_{%
\mathrm{V}},\mathfrak{H}_{\mathbb{R}}\right) 
\end{equation}

\item 
\begin{equation}
\mathcal{J}_{\mathrm{V}}\left( J_{\mathrm{V}}\right) =\mathcal{J}\left( J_{%
\mathrm{V}}\right) =i
\end{equation}

\item 
\begin{equation}
\left\langle \left. {}\right\vert \right\rangle _{\mathfrak{H}_{\mathrm{V}%
}}=\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}+i\left(
\left. {}\right\vert J_{\mathrm{V}}\right) _{\mathfrak{H}_{\mathbb{R}%
}}=\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}+i\left\{
\left. {}\right\vert \right\} _{\mathrm{V}}
\end{equation}

\item 
\begin{eqnarray}
\mathcal{J}_{\mathrm{V}}\left( \Phi _{j}\right)  &=&\varphi _{j},\,1\leq
j\leq r \\
\mathcal{J}_{\mathrm{V}}\left( \Phi _{j+r}\right)  &=&\mathcal{J}_{\mathrm{V}%
}\left( J_{\mathrm{V}}\right) \varphi _{j}=i\varphi _{j},\,1\leq j\leq r
\end{eqnarray}

\item 
\begin{equation}
\mathcal{J}_{\mathrm{V}}\left( v\right) =\func{Re}_{\varphi }\left( \mathcal{%
J}_{\mathrm{V}}\left( v\right) \right) +\mathcal{J}_{\mathrm{V}}\left( J_{%
\mathrm{V}}\right) \func{Im}_{\varphi }\left( \mathcal{J}_{\mathrm{V}}\left(
v\right) \right) =\func{Re}_{\varphi }\left( \mathcal{J}_{\mathrm{V}}\left(
v\right) \right) +i\func{Im}_{\varphi }\left( \mathcal{J}_{\mathrm{V}}\left(
v\right) \right) 
\end{equation}

\item 
\begin{equation}
U\left( \mathfrak{H}_{J_{\mathrm{V}}}\right) =O\left( \mathfrak{H}_{\mathbb{R%
}}\right) \cap Sp\left( \mathfrak{H}_{\mathbb{R}\mathrm{V}}\right) 
\end{equation}

\item \emph{Distinct} imaginary units $J_{\mathrm{V}_{1}},J_{\mathrm{V}_{2}}$
are produced by 
\begin{equation}
J_{\mathrm{V}_{2}}=TJ_{\mathrm{V}_{1}}T^{t},\,T\in \mathfrak{R}_{\Phi
}\left( O\left( \mathfrak{H}_{\mathbb{R}}\right) \right) ,\,T\notin 
\mathfrak{R}_{\mathfrak{H}_{\mathbb{R}}}\left( O\left( \mathrm{V}_{1}\right)
\right) 
\end{equation}

\item Different Symplectic forms

\begin{enumerate}
\item  
\begin{equation}
\left\{ \left. {}\right\vert \right\} _{J_{\mathrm{V}_{1}}}=\left( \left.
{}\right\vert J_{\mathrm{V}_{1}}\right) _{\mathfrak{H}_{\mathbb{R}}}
\end{equation}

\item 
\begin{equation}
\left\{ \left. {}\right\vert \right\} _{J_{\mathrm{V}_{2}}}=\left( \left.
{}\right\vert J_{\mathrm{V}_{2}}\right) _{\mathfrak{H}_{\mathbb{R}}}
\end{equation}%
are produced when $\mathrm{V}_{1}\neq \mathrm{V}_{2}$ then

\item 
\begin{equation}
J_{\mathrm{V}_{1}}\neq J_{\mathrm{V}_{2}}.
\end{equation}

\item Different maginary units are produced when  
\begin{equation}
J_{\mathrm{V}_{2}}=\left( \overset{}{\mathfrak{R}_{\Phi }\left( a\right) J_{%
\mathrm{V}_{1}}\mathfrak{R}_{\Phi }\left( a\right) ^{t},\,a\in O\left( 
\mathfrak{H}_{\mathbb{R}}\right) ,a\notin O\left( \mathrm{V}_{1}\right) }%
\right) \Leftrightarrow \left( \overset{}{\left\vert \boldsymbol{\Psi }%
\right) \nsim \left\vert \boldsymbol{\Phi }\right) }\right) .
\end{equation}
\end{enumerate}

\item 
\begin{equation}
Sp\left( \mathfrak{H}_{\mathbb{R}}\right) =\limfunc{Adj}\left( a\right)
\left\{ Sp_{\Phi }\left( \mathfrak{H}_{\mathbb{R}}\right) \right\} ,\,\,a\in
O\left( \mathfrak{H}_{\mathbb{R}}\right) .
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
\begin{equation}
U\left( \mathfrak{H}\right) =O\left( \mathfrak{H}_{\mathbb{R}}\right) \cap
Sp\left( \mathfrak{H}_{\mathbb{R}}\right) 
\end{equation}
\end{lemma}

\begin{lemma}
The distinct inner products $\left\langle \left. {}\right\vert \right\rangle
_{\mathfrak{H}_{\mathbb{\Phi }}}=\left\langle \left. {}\right\vert
\right\rangle _{\mathfrak{\varphi }}$ are labelled by the homogeneous
manifold 
\begin{equation}
\frac{O\left( \mathfrak{H}_{\mathbb{R}}\right) }{O\left( \mathfrak{H}_{%
\mathbb{R}}\right) \cap Sp\left( \mathfrak{H}_{\mathbb{R}}\right) }=\frac{%
O\left( \mathfrak{H}_{\mathbb{R}}\right) }{U\left( \mathfrak{H}\right) }.
\end{equation}
\end{lemma}

\begin{remark}
The inner product in $\mathfrak{H}_{\mathrm{V}}$ 
\begin{equation}
\left\langle \left. {}\right\vert \right\rangle _{\mathfrak{H}_{\mathrm{V}%
}}=\left( \left. {}\right\vert \right) _{\mathfrak{H}_{\mathbb{R}}}+ig_{%
\mathrm{V}}^{d}\left( {}\right) =s^{d}\left( {}\right) +ig_{\mathrm{V}%
}^{d}\left( {}\right) 
\end{equation}%
so different inner products $\left\langle \left. {}\right\vert \right\rangle
_{\mathfrak{H}_{\mathrm{V}}}$ are produced by non equivalent geminals.
\end{remark}

\begin{definition}
The unitary group defined by $\left\langle \left. {}\right\vert
\right\rangle _{\mathfrak{H}_{\mathrm{V}}}$ is produced by transformations
belonging to $O\left( \mathfrak{H}_{\mathbb{R}}\right) \cap \limfunc{Isom}%
\left( \overset{}{g_{\mathrm{V}}}\right) $, where the isometry group of $g_{%
\mathrm{V}}$ is defined by 
\begin{equation}
\limfunc{Isom}\left( \overset{}{g_{\mathrm{V}}}\right) =\left\{ \left. T\in
GL\left( {\Large \wedge }^{2}\mathfrak{H}_{\mathbb{R}}\right) \right\vert
T\left\vert g_{\mathrm{V}}\right) =\left\vert g_{\mathrm{V}}\right) \right\}
\cong Sp\left( \mathfrak{H}_{\mathbb{R}}\right) .
\end{equation}
\end{definition}

\begin{remark}
When are these Hilbert spaces the same or unitarily equivalent? 
\end{remark}

\begin{remark}
What are the physical interpretation of geminals in a geometric algebra?
\end{remark}

\begin{remark}
Consider transformations $T\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{R}%
}\right) $ that correspond to transformations $\mathcal{J}_{\mathrm{V}%
}\left( T\right) \in \mathcal{B}\left( \mathfrak{H}_{\mathbb{\Phi }}\right) $
\end{remark}

\begin{definition}
The $2r$-dimensional complex Hilbert space $\mathfrak{H}_{\mathbb{C}}$ is
defined by 
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H.}
\end{equation}
\end{definition}

\begin{remark}
The inner product and norm in $\mathfrak{H}_{\mathbb{C}}$ are given by%
\begin{eqnarray}
\left\langle \left. v\right\vert w\right\rangle _{\mathfrak{H}_{\mathbb{C}}}
&=&\left\langle \left. \mathfrak{i}\left( v_{1},v_{2}\right) \right\vert 
\mathfrak{i}\left( w_{1},w_{2}\right) \right\rangle _{\mathfrak{H}_{\mathbb{C%
}}}=\left\langle \left. \left( v_{1},v_{2}\right) \right\vert \left( \left(
w_{1},w_{2}\right) \right) \right\rangle _{\mathfrak{H}_{\mathbb{C}}} \\
&=&\left\langle \left. v_{1}\right\vert w_{1}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{1}\right\vert w_{2}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{2}\right\vert w_{1}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}%
}=\left\langle \left. v_{1}\right\vert w_{1}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}}
\end{eqnarray}%
and 
\begin{equation}
\left\Vert v\right\Vert _{\mathfrak{H}_{\mathbb{C}}}=\sqrt{\left\langle
\left. v\right\vert v\right\rangle _{\mathfrak{H}_{\mathbb{C}}}}=\sqrt{%
\left( \left\langle \left. v_{1}\right\vert v_{1}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{2}\right\vert vw_{2}\right\rangle _{\mathfrak{H}%
}\right) }.
\end{equation}
\end{remark}

\begin{definition}
The injection $\mathfrak{i}$ 
\begin{equation}
\mathfrak{i}:\mathfrak{H\times H\rightarrow H}_{\mathbb{C}}
\end{equation}%
by 
\begin{equation}
\mathfrak{i}\left( v,w\right) =\mathfrak{i}_{1}\left( v\right) +\mathfrak{i}%
_{2}\left( w\right) =\left( v,w\right) \in \mathfrak{H}_{\mathbb{C}},
\end{equation}%
produced by the injections $\mathfrak{i}_{1}$ and $\mathfrak{i}_{2}$ given
by 
\begin{equation}
\mathfrak{i}_{1}\left( v\right) =\left( v,0\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{i}_{2}\left( v\right) =\left( 0,v\right) .
\end{equation}
\end{definition}

\begin{remark}
The \emph{isometric injections } $\mathfrak{i}_{1}$ and $\mathfrak{i}_{2}$ 
\begin{equation}
\mathfrak{i}_{1},\mathfrak{i}_{2}:\mathfrak{H}\rightarrow \mathfrak{H}_{%
\mathbb{C}}
\end{equation}%
are given by 
\begin{equation}
\mathfrak{i}_{1}\left( v\right) =\left( v,0\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{i}_{2}\left( v\right) =\left( 0,v\right)
\end{equation}%
clearly

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{i}_{1}\left( v\right) \,\bot \,\mathfrak{i}_{2}\left( v\right)
\Leftrightarrow \left\langle \left. \mathfrak{i}_{1}\left( v\right)
\right\vert \mathfrak{i}_{2}\left( v\right) \right\rangle _{\mathfrak{H}_{%
\mathbb{C}}}=0
\end{equation}%
and

\item 
\begin{eqnarray}
\left\Vert \mathfrak{i}_{1}\left( v_{1}\right) \right\Vert _{\mathfrak{H}_{%
\mathbb{C}}} &=&\left\Vert v_{1}\right\Vert _{\mathfrak{H}} \\
\left\Vert \mathfrak{i}_{2}\left( v_{2}\right) \right\Vert _{\mathfrak{H}_{%
\mathbb{C}}} &=&\left\Vert v_{2}\right\Vert _{\mathfrak{H}}.
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
\mathfrak{i}_{1}\left( \boldsymbol{\varphi }\right) =\left( \boldsymbol{%
\varphi },\boldsymbol{0}\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{i}_{2}\left( \boldsymbol{\varphi }\right) =\left( \boldsymbol{0},%
\boldsymbol{\varphi }\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
\left\langle \left. \mathfrak{i}_{1}\left( v_{1}\right) \right\vert 
\mathfrak{i}_{1}\left( w_{1}\right) \right\rangle _{\mathfrak{H}_{\mathbb{C}%
}} &=&\left\langle \left. v_{1}\right\vert w_{1}\right\rangle _{\mathfrak{H}}
\\
\left\langle \left. \mathfrak{i}_{2}\left( v_{2}\right) \right\vert 
\mathfrak{i}_{2}\left( w_{2}\right) \right\rangle _{\mathfrak{H}_{\mathbb{C}%
}} &=&\left\langle \left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}%
}.
\end{eqnarray}
\end{remark}

\begin{remark}
The inner product and norm in $\mathfrak{H}_{\mathbb{C}}$ are given by%
\begin{equation}
\left\langle \left. \mathfrak{i}\left( v\right) \right\vert \mathfrak{i}%
\left( w\right) \right\rangle _{\mathfrak{H}_{\mathbb{C}}}=\left\langle
\left. \mathfrak{i}\left( v_{1},v_{2}\right) \right\vert i\left(
w_{1},w_{2}\right) \right\rangle _{\mathfrak{H}_{\mathbb{C}}}=\left\langle
\left. v_{1}\right\vert w_{1}\right\rangle _{\mathfrak{H}}+\left\langle
\left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}}
\end{equation}%
and 
\begin{equation}
\left\Vert v\right\Vert _{\mathfrak{H}_{\mathbb{C}}}=\sqrt{\left\langle
\left. v\right\vert w\right\rangle _{\mathfrak{H}_{\mathbb{C}}}}=\sqrt{%
\left( \left\langle \left. v_{1}\right\vert w_{1}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}%
}\right) }.
\end{equation}
\end{remark}

\begin{remark}
If the components $\left\{ v_{1},v_{2}\right\} $ of $v\in \mathfrak{H}_{%
\mathbb{C}}$ are normalized wrt $\left\Vert {}\right\Vert _{\mathfrak{H}}$
then 
\begin{equation}
\left\langle \left. v_{1}\right\vert w_{1}\right\rangle _{\mathfrak{H}%
}=\left\langle \left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}}=1
\end{equation}%
and 
\begin{equation}
\left\Vert \mathfrak{i}\left( v\right) \right\Vert _{\mathfrak{H}_{\mathbb{C}%
}}=\sqrt{2},
\end{equation}
\end{remark}

\begin{remark}
Consider the diagonal of the map $\mathfrak{i}\in \mathcal{B}\left( 
\mathfrak{H}_{\mathbb{C}},\mathfrak{H\times H}\right) $ 
\begin{equation}
\mathfrak{i:H\times H\rightarrow H}_{\mathbb{C}}
\end{equation}%
given by 
\begin{equation}
\mathfrak{i}\left( v,v\right) =\left( v,0\right) +\left( 0,v\right)
\end{equation}%
producing 
\begin{equation}
\mathfrak{i}_{d}\left( v\right) =\mathfrak{i}\left( v,v\right) =\left(
v,0\right) +\left( 0,v\right) .
\end{equation}%
The map $\mathfrak{i}_{d}$ \emph{is} not a complex linear isometry as\emph{\ 
}%
\begin{equation}
\left\Vert \left( v,v\right) \right\Vert _{\mathfrak{H}_{\mathbb{C}}}=\sqrt{%
\left\langle \left. \left( v,v\right) \right\vert \left( v,v\right)
\right\rangle _{\mathfrak{H}_{\mathbb{C}}}}=\sqrt{\left\langle \left.
v\right\vert v\right\rangle _{\mathfrak{H}}+\left\langle \left. v\right\vert
v\right\rangle _{\mathfrak{H}}}=\sqrt{\left\Vert v\right\Vert _{\mathfrak{H}%
}^{2}+\left\Vert v\right\Vert _{\mathfrak{H}}^{2}}=\sqrt{2}\left\Vert
v\right\Vert _{\mathfrak{H}}^{2}.
\end{equation}
\end{remark}

\begin{remark}
If the components $v_{1}$ and $v_{2}$ are normalized i.e. 
\begin{equation}
\left\langle \left. v_{1}\right\vert v_{1}\right\rangle _{\mathfrak{H}%
}=\left\langle \left. v_{2}\right\vert v_{2}\right\rangle _{\mathfrak{H}}=1
\end{equation}%
then 
\begin{equation}
\left\Vert i\left( v\right) \right\Vert _{\mathfrak{H}_{\mathbb{C}}}=\sqrt{2}%
.
\end{equation}
\end{remark}

\begin{remark}
Normalized $\mathfrak{i}\left( v\right) \in \mathfrak{H}_{\mathbb{C}}$ wrt $%
\left\Vert {}\right\Vert _{\mathfrak{H}_{\mathbb{C}}}$ produced from
normalized $v_{1},v_{2}\in $ $\mathfrak{H}$ are defined by 
\begin{equation}
\mathfrak{i}\left( c_{1}v_{1},c_{2}v_{2}\right) =\mathfrak{i}\left(
c_{1}v_{1}\right) +\mathfrak{i}\left( c_{2}v_{2}\right) =c_{1}\mathfrak{i}%
\left( v_{1}\right) +c_{2}\mathfrak{i}\left( v_{2}\right) =c_{1}\mathfrak{i}%
_{1}\left( v_{1}\right) +c_{2}\mathfrak{i}_{2}\left( v_{2}\right) ,
\end{equation}%
where%
\begin{equation}
\left\langle \left. \mathfrak{i}\left( c_{1}v_{1},c_{2}v_{2}\right)
\right\vert \mathfrak{i}\left( c_{1}v_{1},c_{2}v_{2}\right) \right\rangle _{%
\mathfrak{H}_{\mathbb{C}}}=\left\vert c_{1}\right\vert ^{2}+\left\vert
c_{2}\right\vert ^{2}=1.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\text{If }v=v_{1}=v_{2}\text{ then }c=c_{1}=c_{2}=\frac{1}{\sqrt{2}}.
\end{equation}
\end{remark}

\begin{remark}
In $\mathfrak{H}$ one should observe that 
\begin{equation}
v\neq {\large \,}v_{1}+v_{2}
\end{equation}%
even though 
\begin{equation}
\mathfrak{i}\left( \left( v_{1},v_{2}\right) \right) =\mathfrak{i}\left(
v_{1}\right) +\mathfrak{i}\left( v_{2}\right) .
\end{equation}
\end{remark}

\begin{notation}
Conbs of $\mathfrak{H}_{\mathbb{C}}$ are of the form $\left( \boldsymbol{%
\Phi }\right) =\left( \left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right)
,\left( \boldsymbol{0},\boldsymbol{\varphi }_{2}\right) \right) $ where $%
\left( \boldsymbol{\varphi }_{1}\right) $ and $\left( \boldsymbol{\varphi }%
_{2}\right) $ are conbs of $\mathfrak{H.}$In particular 
\begin{equation}
\mathfrak{H}_{\varphi _{1}}=\mathbb{C}-\limfunc{linspan}\left\{ \left.
\left( \varphi _{1j},0\right) \right\vert 1\leq j\leq r\right\}
\end{equation}%
and 
\begin{equation}
\mathfrak{H}_{\varphi _{2}}=\mathbb{C}-\limfunc{linspan}\left\{ \left.
\left( 0,\varphi _{2j}\right) \right\vert 1\leq j\leq r\right\}
\end{equation}%
giving 
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}_{\varphi _{1}}\oplus _{\mathbb{C}}%
\mathfrak{H}_{\varphi _{2}}=\mathfrak{H}_{\varphi _{1}}+_{\mathbb{C}}%
\mathfrak{H}_{\varphi _{2}}.
\end{equation}
\end{notation}

\begin{notation}
\begin{equation}
\mathfrak{H}_{\varphi }=\mathbb{C}-\limfunc{linspan}\left\{ \left. \varphi
_{j}\right\vert 1\leq j\leq r\right\}
\end{equation}
\end{notation}

\begin{remark}
In particular one has 
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}_{\varphi }\oplus _{\mathbb{C}}\sigma
_{\varphi }\left\{ \mathfrak{H}_{\varphi }\right\} .
\end{equation}
\end{remark}

\begin{remark}
The map $\mathfrak{i}\in $ $\mathcal{B}\left( \mathfrak{H}_{\mathbb{C}},%
\mathfrak{H\times H}\right) $%
\begin{equation}
\mathfrak{i}:\mathfrak{H}\times \mathfrak{H}\rightarrow \mathfrak{H}_{%
\mathbb{C}}=\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}
\end{equation}%
is given by 
\begin{eqnarray}
\mathfrak{i}\left( \left( v_{1},v_{2}\right) \right) &=&\left( \left( 
\boldsymbol{\varphi }_{1},\boldsymbol{0}\right) _{\oplus },\left( 
\boldsymbol{0},\boldsymbol{\varphi }_{2}\right) _{\oplus }\right) \left( 
\begin{array}{c}
\mathcal{R}_{\varphi _{_{1}}}\left( v_{1}\right) \\ 
\mathcal{R}_{\varphi _{_{2}}}\left( v_{2}\right)%
\end{array}%
\right) =\left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right) _{\oplus }%
\mathcal{R}_{\varphi _{_{1}}}\left( v_{1}\right) +\left( \boldsymbol{0},%
\boldsymbol{\varphi }_{2}\right) _{\oplus }\mathcal{R}_{\varphi
_{_{2}}}\left( v_{2}\right) \\
&=&\left( \left( \boldsymbol{\varphi }_{1}\right) \mathcal{R}_{\varphi
_{_{1}}}\left( v_{1}\right) ,\left( \boldsymbol{\varphi }_{2}\right) 
\mathcal{R}_{\varphi _{_{2}}}\left( v_{2}\right) \right) _{\oplus }=\left(
v_{1},v_{2}\right) _{\oplus }=\left( v_{1},0\right) _{\oplus }+\left(
0,v_{2}\right) _{\oplus }=v_{1}\left( \boldsymbol{\varphi }\right) \oplus _{%
\mathbb{C}}v_{2}.
\end{eqnarray}
\end{remark}

\begin{definition}
The map 
\begin{equation}
\mathfrak{i}_{\varphi ri}:\mathfrak{H}\rightarrow \mathfrak{H}_{\mathbb{C}}=%
\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}
\end{equation}%
by 
\begin{equation}
\mathfrak{i}_{ri}\left( v\right) =\mathfrak{i}\left( \left( \func{Re}%
_{\varphi }\left( v\right) ,\func{Im}_{\varphi }\left( v\right) \right)
\right) =\mathfrak{i}_{1}\left( \func{Re}_{\varphi }\left( v\right) \right)
\oplus _{\mathbb{C}}\mathfrak{i}_{2}\left( i\func{Im}_{\varphi }\left(
v\right) \right) .
\end{equation}
\end{definition}

\begin{definition}
The maps $\mathfrak{r}_{\Phi }\in $ $\mathcal{B}\left( \mathfrak{H}_{\mathbb{%
R}},\mathfrak{H\times H}\right) $%
\begin{equation}
\mathfrak{r}_{\Phi }:\mathfrak{H\times H}\rightarrow \mathfrak{H}_{\mathbb{R}%
}=\mathfrak{H}_{r\varphi _{_{1}}}\oplus _{\mathbb{R}}\mathfrak{H}_{r\varphi
_{_{2}}}
\end{equation}%
is given by 
\begin{eqnarray}
\mathfrak{r}_{\Phi }\left( \left( v_{1},v_{2}\right) \right) &=&\left(
\left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right) _{\oplus },\left( 
\boldsymbol{0},\boldsymbol{\varphi }_{2}\right) _{\oplus }\right) \left( 
\begin{array}{c}
\func{Re}\left( \mathcal{R}_{\varphi _{_{1}}}\left( v_{1}\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi _{_{2}}}\left( v_{2}\right) \right)%
\end{array}%
\right) =\left( \left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right)
_{\oplus },\left( \boldsymbol{0},\boldsymbol{\varphi }_{2}\right) _{\oplus
}\right) \left( 
\begin{array}{c}
\mathcal{R}_{\varphi _{_{1}}}\left( \func{Re}_{\varphi _{1}}\left(
v_{1}\right) \right) \\ 
\mathcal{R}_{\varphi _{_{2}}}\left( \func{Im}_{\varphi _{2}}\left(
v_{2}\right) \right)%
\end{array}%
\right) \\
&=&\left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right) _{\oplus }\mathcal{%
R}_{\varphi _{_{1}}}\left( \func{Re}_{\varphi _{1}}\left( v_{1}\right)
\right) +\left( \boldsymbol{0},\boldsymbol{\varphi }_{2}\right) _{\oplus }%
\mathcal{R}_{\varphi _{_{2}}}\left( \func{Im}_{\varphi _{2}}\left(
v_{2}\right) \right) =\left( \left( \boldsymbol{\varphi }_{1}\right) 
\mathcal{R}_{\varphi _{_{1}}}\left( \func{Re}_{\varphi _{1}}\left(
v_{1}\right) \right) ,\left( \boldsymbol{\varphi }_{2}\right) \mathcal{R}%
_{\varphi _{_{2}}}\left( \func{Im}_{\varphi _{2}}\left( v_{2}\right) \right)
\right) _{\oplus }=\left( \func{Re}_{\varphi _{1}}\left( v_{1}\right) ,\func{%
Im}_{\varphi _{2}}\left( v_{2}\right) \right) _{\oplus } \\
&=&\left( \func{Re}_{\varphi _{1}}\left( v_{1}\right) ,0\right) _{\oplus
}+\left( 0,\func{Im}_{\varphi _{2}}\left( v_{2}\right) \right) _{\oplus }=%
\mathfrak{r}_{\Phi }\left( \func{Re}_{\varphi _{1}}\left( v_{1}\right) ,%
\func{Im}_{\varphi _{2}}\left( v_{2}\right) \right) =\mathfrak{r}_{\varphi
_{1}1}\left( \func{Re}_{\varphi }\left( v\right) \right) +\mathfrak{r}%
_{\varphi _{2}2}\left( \func{Im}_{\varphi }\left( v\right) \right) =\func{Re}%
_{\varphi _{1}}\left( v_{1}\right) \oplus _{\mathbb{R}}\func{Im}_{\varphi
_{2}}\left( v_{2}\right) .
\end{eqnarray}
\end{definition}

\begin{remark}
In particular

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{r}_{\varphi }\left( v\right) =\mathfrak{r}_{\varphi }\left( \left( 
\func{Re}_{\varphi }\left( v\right) ,\func{Im}_{\varphi }\left( v\right)
\right) \right) =\func{Re}_{\varphi }\left( v\right) \oplus _{\mathbb{R}}%
\func{Im}_{\varphi }\left( v\right) =\mathfrak{r}_{\varphi 1}\left( \func{Re}%
_{\varphi }\left( v\right) \right) +\mathfrak{r}_{\varphi 2}\left( \func{Im}%
_{\varphi }\left( v\right) \right) .
\end{equation}

\item 
\begin{equation}
\left( \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r}%
_{\varphi }\left( w\right) \right) _{\mathfrak{H}_{r\varphi }}=\left( \left.
v\right\vert w\right) _{\mathfrak{H}}=\func{Re}\left( \left\langle \left.
v\right\vert w\right\rangle \right) =\left\langle \left. \func{Re}_{\varphi
}\left( v\right) \right\vert \func{Re}_{\varphi }\left( w\right)
\right\rangle _{\mathfrak{H}}+\left\langle \left. \func{Re}_{\varphi }\left(
v\right) \right\vert \func{Im}_{\varphi }\left( w\right) \right\rangle _{%
\mathfrak{H}}\text{ for any conbs }\left( \boldsymbol{\varphi }\right) .
\end{equation}

\item 
\begin{equation}
\left\{ \left. \mathfrak{r}_{\varphi }\left( v\right) \right\vert \mathfrak{r%
}_{\varphi }\left( w\right) \right\} _{\mathfrak{H}_{r\varphi }}=\left\{
\left. v\right\vert w\right\} _{\mathfrak{H}}=-i\func{Im}\left( \left\langle
\left. v\right\vert w\right\rangle \right) =\left\langle \left. \func{Re}%
_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi }\left( w\right)
\right\rangle _{\mathfrak{H}}-\left\langle \left. \func{Im}_{\varphi }\left(
v\right) \right\vert \func{Re}_{\varphi }\left( w\right) \right\rangle _{%
\mathfrak{H}}\text{ for any conbs }\left( \boldsymbol{\varphi }\right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
The unitray transformation $\mathcal{K}\in \mathcal{B}\left( \mathfrak{H}_{%
\mathbb{C}}\right) $ has the effect 
\begin{equation}
\mathcal{K}\left( \left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right)
,\left( \boldsymbol{0},\boldsymbol{\varphi }_{2}\right) \right) =\left(
\left( \boldsymbol{\varphi }_{1},\boldsymbol{0}\right) ,\left( \boldsymbol{0}%
,\boldsymbol{\varphi }_{2}\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\left( \left( \frac{1}{\sqrt{2}}\overset{}{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{0}\right) +\left( \boldsymbol{0},\boldsymbol{%
\varphi }_{2}\right) }\right) ,\frac{i}{\sqrt{2}}\left( \overset{}{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{0}\right) -\left( \boldsymbol{0},%
\boldsymbol{\varphi }_{2}\right) }\right) \right) .
\end{equation}%
In particular 
\begin{equation}
\mathcal{K}\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) =\left( \left( 
\boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( \boldsymbol{0},%
\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\left( \frac{1}{\sqrt{2}}\left( \overset{}{\left( \boldsymbol{%
\varphi },\boldsymbol{0}\right) +\left( \boldsymbol{0},\boldsymbol{\varphi }%
\right) }\right) ,\frac{i}{\sqrt{2}}\left( \overset{}{\left( \boldsymbol{%
\varphi },\boldsymbol{0}\right) -\left( \boldsymbol{0},\boldsymbol{\varphi }%
\right) }\right) \right)
\end{equation}%
giving the action on basis elements 
\begin{eqnarray}
\mathcal{K}\left( \left( \varphi _{j},0\right) \right) &=&\frac{1}{\sqrt{2}}%
\left( \left( \varphi _{j},0\right) +\left( 0,\varphi _{j}\right) \right) \\
\mathcal{K}\left( \left( 0,\varphi _{j}\right) \right) &=&\frac{i}{\sqrt{2}}%
\left( \left( \varphi _{j},0\right) -\left( 0,\varphi _{j}\right) \right) \\
&&1\leq j\leq r.
\end{eqnarray}
\end{remark}

\begin{enumerate}
\item In the special case $\boldsymbol{\varphi }_{2}=\boldsymbol{\varphi }%
_{1}$ one has 
\begin{equation}
\mathfrak{i}\left( \left( v,\sigma _{\varphi }\left( v\right) \right)
\right) =\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\mathcal{R}_{\varphi }\left( \sigma _{\varphi }\left( v\right) \right)%
\end{array}%
\right) =\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\overline{\mathcal{R}_{\varphi }}\left( v\right)%
\end{array}%
\right)
\end{equation}%
giving

\item 
\begin{gather}
\mathcal{K}\left( \overset{}{\mathfrak{i}\left( \left( v,\sigma _{\varphi
}\left( v\right) \right) \right) }\right) =\mathcal{K}\left( \left( \left( 
\boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( \boldsymbol{0},%
\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\mathcal{R}_{\varphi }\left( \sigma _{\varphi }\left( v\right) \right)%
\end{array}%
\right) \right) \\
=\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \mathcal{R}_{\varphi
\varphi }\left( \mathcal{K}\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\mathcal{R}_{\varphi }\left( \sigma _{\varphi }\left( v\right) \right)%
\end{array}%
\right) =\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\overline{\mathcal{R}_{\varphi }}\left( v\right)%
\end{array}%
\right) \\
=\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) +\overline{\mathcal{R}_{\varphi }}%
\left( v\right) \\ 
i\left( \mathcal{R}_{\varphi }\left( v\right) -\overline{\mathcal{R}%
_{\varphi }}\left( v\right) \right)%
\end{array}%
\right) \\
=\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \frac{1}{\sqrt{2}}\frac{1%
}{\sqrt{2}}\left( 
\begin{array}{c}
2\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \\ 
2\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right)%
\end{array}%
\right) =\left( \left( \boldsymbol{\varphi },\boldsymbol{0}\right) ,\left( 
\boldsymbol{0},\boldsymbol{\varphi }\right) \right) \left( 
\begin{array}{c}
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right)%
\end{array}%
\right) .
\end{gather}
\end{enumerate}

\begin{remark}
\begin{equation}
i\left( z-\overline{z}\right) =i\left( \left( x+iy\right) -\left(
x-iy\right) \right) =i\left( x+iy-x+iy\right) =-2y.
\end{equation}
\end{remark}

\begin{lemma}
\begin{equation}
\mathcal{K}\left( \overset{}{\mathfrak{r}_{\varphi }\left( \frac{1}{\sqrt{2}}%
\left( v,\sigma _{\varphi }\left( v\right) \right) \right) }\right) =%
\mathfrak{r}_{\varphi }\left( \func{Re}_{\varphi }\left( v\right) \right)
\oplus _{\mathbb{R}}\mathfrak{r}_{\varphi }\left( \func{Im}_{\varphi }\left(
v\right) \right) .
\end{equation}
\end{lemma}

\begin{definition}
The $r$-dimensional \emph{real} Hilbert spaces $\mathfrak{H}_{r_{\varphi }}$
are defined by%
\begin{equation}
\mathfrak{H}_{r_{\varphi }}=\mathbb{R}\text{-}\limfunc{linspan}\left\{
\left. \varphi _{j}\right\vert 1\leq j\leq r\right\} ,
\end{equation}%
where $\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq r\right\} $ are
conbs of the complex Hilbert space $\mathfrak{H}.$
\end{definition}

\begin{definition}
The $2r$-dimensional real Hilbert spaces $\mathfrak{H}_{\mathbb{R\Phi }}$
are defined by 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathbb{R\Phi }}=\mathfrak{H}%
_{r\varphi _{_{1}}}\oplus _{\mathbb{R}}\mathfrak{H}_{r\varphi _{_{2}}}%
\mathfrak{.}
\end{equation}
\end{definition}

\begin{definition}
In the case $\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) =\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right) $ the 
$2r$-dimensional real Hilbert spaces $\mathfrak{H}_{\mathbb{R\varphi }}$ are
defined as 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathbb{R\varphi }}=\mathfrak{H}%
_{r\varphi }\oplus _{\mathbb{R}}\mathfrak{H}_{r\varphi }\mathfrak{.}
\end{equation}
\end{definition}

\begin{notation}
$\mathfrak{H}_{\mathbb{R\Phi }},\mathfrak{H}_{\mathbb{R\varphi }},\mathfrak{H%
}_{\mathbb{R}ri}$ denote different direct sum decompositions of $\mathfrak{H}%
_{\mathbb{R}}$ produced by different bases of $\mathfrak{H}_{\mathbb{R}}.$
\end{notation}

The various Hilbert spaces $\mathfrak{H}_{\mathbb{C}},\mathfrak{H}_{\mathbb{%
R\Phi }}$ and $\mathfrak{H}_{\mathbb{R\varphi }}$ can also be defined by

\begin{definition}
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathbb{C}-\limfunc{linspan}\left\{ \left. \left(
v_{1},v_{2}\right) \right\vert v_{1},v_{2}\in \mathfrak{H}\right\} .
\end{equation}
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\left\Vert v\right\Vert _{\mathfrak{H}}=\sqrt{\left\langle \left.
v\right\vert v\right\rangle _{\mathfrak{H}}}
\end{equation}

\item 
\begin{equation}
\left\langle \left. \left( v_{1},v_{2}\right) \right\vert \left(
v_{1},v_{2}\right) \right\rangle _{\mathfrak{H}_{\mathbb{C}}}=\left\langle
\left. v_{1}\right\vert v_{1}\right\rangle _{\mathfrak{H}}+\left\langle
\left. v_{2}\right\vert v_{2}\right\rangle _{\mathfrak{H}}
\end{equation}

\item 
\begin{equation}
\left\Vert \left( v_{1},v_{2}\right) \right\Vert _{\mathfrak{H}_{\mathbb{C}%
}}=\sqrt{\left\langle \left. \left( v_{1},v_{2}\right) \right\vert \left(
v_{1},v_{2}\right) \right\rangle _{\mathfrak{H}_{\mathbb{C}}}}=\sqrt{%
\left\langle \left. v_{1}\right\vert v_{1}\right\rangle _{\mathfrak{H}%
}+\left\langle \left. v_{2}\right\vert v_{2}\right\rangle _{\mathfrak{H}}}=%
\sqrt{\left\Vert v_{1}\right\Vert _{\mathfrak{H}}^{2}+\left\Vert
v_{2}\right\Vert _{\mathfrak{H}}^{2}}
\end{equation}
\end{enumerate}
\end{remark}

\begin{definition}
Different bases for the subspaces in the direct sum 
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathbb{R\Phi }}=\mathbb{R}-\limfunc{%
linspan}\left\{ \left. \left( \boldsymbol{\Phi }\right) =\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) \right\vert \right\} .
\end{equation}
\end{definition}

\begin{definition}
Same basis for the subspaces in the direct sum%
\begin{equation}
\mathfrak{H}_{\mathbb{R}}=\mathfrak{H}_{\mathbb{R\varphi }}=\mathbb{R}-%
\limfunc{linspan}\left\{ \left. \left( \boldsymbol{\Phi }\right) =\left( 
\boldsymbol{\varphi },\boldsymbol{\varphi }\right) \right\vert \right\} .
\end{equation}
\end{definition}

\begin{remark}
The complex Hilbert space $\mathfrak{H}_{\mathbb{C}}$ can be expressed as
the direct sums 
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\func{Re}_{\varphi }\left\{ \mathfrak{H}_{\mathbb{C%
}}\right\} \oplus _{\mathbb{R}}i\func{Im}_{\varphi }\left\{ \mathfrak{H}_{%
\mathbb{C}}\right\} .
\end{equation}
\end{remark}

\begin{definition}
The real injections $\mathfrak{r}_{\varphi }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}_{\mathbb{R}},\mathfrak{H\times H}\right) $ 
\begin{equation}
\mathfrak{r}_{\varphi }:\mathfrak{H\times H}\rightarrow \mathfrak{H}_{%
\mathbb{R}}=\mathfrak{H}_{r\varphi _{_{1}}}\oplus _{\mathbb{R}}\mathfrak{H}%
_{r\varphi _{_{2}}}
\end{equation}%
are defined by 
\begin{equation}
\mathfrak{r}_{\varphi }\left( v_{1},v_{2}\right) =\left( \mathfrak{r}%
_{\varphi 1}\left( v_{1}\right) ,\mathfrak{r}_{\varphi 2}\left( v_{2}\right)
\right) ,
\end{equation}%
where 
\begin{equation}
\mathfrak{r}_{\varphi 1}\in \mathcal{B}_{\mathbb{R}}\left( \mathfrak{H}%
_{r\varphi _{_{1}}},\mathfrak{H}\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{r}_{\varphi 2}\in \mathcal{B}_{\mathbb{R}}\left( \mathfrak{H}%
_{r\varphi _{_{2}}},\mathfrak{H}\right) .
\end{equation}
\end{definition}

Recall the

\begin{definition}
\begin{gather}
\func{Re}_{\varphi }\left( v\right) =\sum_{1\leq j\leq r}\varphi _{j}\func{Re%
}\left( \mathcal{R}_{\varphi }\left( v\right) _{j}\right) =\sum_{1\leq j\leq
r}\varphi _{j}\mathcal{R}_{\varphi }\left( \func{Re}_{\varphi }\left(
v\right) \right) _{j}\in \func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} \\
\func{Im}_{\varphi }\left( v\right) =\sum_{1\leq j\leq r}\varphi _{j}\func{Im%
}\left( \mathcal{R}_{\varphi }\left( v\right) _{j}\right) =\sum_{1\leq j\leq
r}\varphi _{j}\mathcal{R}_{\varphi }\left( \func{Im}_{\varphi }\left(
v\right) \right) _{j}\in \func{Im}_{\varphi }\left\{ \mathfrak{H}\right\} \\
v\in \mathfrak{H.}
\end{gather}
\end{definition}

\begin{remark}
The inner product $\left( \left. {}\right\vert \right) _{\mathfrak{H}_{%
\mathbb{R}}}$ and norm $\left\Vert \mathfrak{i}\left( v_{1},v_{2}\right)
\right\Vert _{\mathfrak{H}_{\mathbb{R}}}$ in $\mathfrak{H}_{\mathbb{R}}$ are
given by%
\begin{equation}
\left( \left. \mathfrak{r}_{\varphi }\left( v_{1},v_{2}\right) \right\vert 
\mathfrak{r}_{\varphi }\left( w_{1},w_{2}\right) \right) _{\mathfrak{H}_{%
\mathbb{R}}}=\left( \left. v_{1}\right\vert w_{1}\right) _{\mathfrak{H}_{%
\mathbb{R}}}+\left( \left. v_{2}\right\vert w_{2}\right) _{\mathfrak{H}_{%
\mathbb{R}}}=\func{Re}\left( \left\langle \left. v_{1}\right\vert
w_{1}\right\rangle _{\mathfrak{H}}\right) +\func{Re}\left( \left\langle
\left. v_{2}\right\vert w_{2}\right\rangle _{\mathfrak{H}}\right)
\end{equation}%
and 
\begin{equation}
\left\Vert \mathfrak{r}_{\varphi }\left( v_{1},v_{2}\right) \right\Vert _{%
\mathfrak{H}_{\mathbb{R}}}=\sqrt{\left( \left. \mathfrak{r}_{\varphi }\left(
v_{1},v_{2}\right) \right\vert \mathfrak{r}_{\varphi }\left(
w_{1},w_{2}\right) \right) _{\mathfrak{H}_{\mathbb{R}}}}=\sqrt{\left( \left(
\left. \mathfrak{r}_{\varphi 1}\left( v_{1}\right) \right\vert \mathfrak{r}%
_{\varphi 1}\left( v_{1}\right) \right) _{\mathfrak{H}_{\mathbb{R}}}+\left(
\left. \mathfrak{r}_{\varphi 2}\left( v_{2}\right) \right\vert \mathfrak{r}%
_{\varphi 2}\left( v_{2}\right) \right) _{\mathfrak{H}_{\mathbb{R}}}\right) }%
=\sqrt{\func{Re}\left( \left\langle \left. v_{1}\right\vert
v_{1}\right\rangle _{\mathfrak{H}}\right) +\func{Re}\left( \left\langle
\left. v_{2}\right\vert v_{2}\right\rangle _{\mathfrak{H}}\right) }.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\func{Re}\left( \left\langle \left. v\right\vert v\right\rangle _{\mathfrak{H%
}}\right) =\left( \left. v\right\vert v\right) _{\mathfrak{H}_{\mathbb{R}%
}}=\left\langle \left. \func{Re}_{\varphi }\left( v\right) \right\vert \func{%
Re}_{\varphi }\left( v\right) \right\rangle _{\mathfrak{H}}+\left\langle
\left. \func{Im}_{\varphi }\left( v\right) \right\vert \func{Im}_{\varphi
}\left( v\right) \right\rangle _{\mathfrak{H}}\,\text{for any conb basis }%
\left( \mathbb{\varphi }\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
\mathfrak{r}_{\varphi _{1}1}\left( v\right) &=&\left( v,0\right) ,\,v\in 
\mathfrak{H}_{r\varphi _{1}} \\
\mathfrak{r}_{\varphi _{2}2}\left( v\right) &=&\left( 0,v\right) ,\,v\in 
\mathfrak{H}_{r\varphi _{1}}.
\end{eqnarray}
\end{remark}

\begin{remark}
If the components are normalized then 
\begin{eqnarray}
\left\langle \left. \mathfrak{r}_{1}\left( v_{1}\right) \right\vert 
\mathfrak{r}_{1}\left( v_{1}\right) \right\rangle _{\mathfrak{H}_{r\varphi
_{1}}} &=&\left\langle \left. \mathfrak{r}_{2}\left( v_{2}\right)
\right\vert \mathfrak{r}_{2}\left( v_{2}\right) \right\rangle _{\mathfrak{H}%
_{r\varphi _{2}}}=1 \\
\left\Vert \mathfrak{r}\left( v_{1},v_{2}\right) \right\Vert _{\mathfrak{H}_{%
\mathbb{R\Phi }}} &=&\sqrt{2}.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{eqnarray}
v &=&\sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\varphi }\left( v\right)
_{j}=\func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left(
v\right) \\
&=&\sum_{1\leq j\leq r}\varphi _{j}\left\{ \func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) _{j}\right) +i\func{Im}\left( \mathcal{R}%
_{\varphi }\left( v\right) _{j}\right) \right\} \\
&=&\frac{1}{2}\sum_{1\leq j\leq r}\varphi _{j}\left\{ \mathcal{R}_{\varphi
}\left( v+\sigma _{\varphi }\left( v\right) \right) _{j}+\mathcal{R}%
_{\varphi }\left( v-\sigma _{\varphi }\left( v\right) \right) _{j}\right\} \\
&=&\sum_{1\leq j\leq r}\left\{ \varphi _{j}\func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) _{j}\right) +i\varphi _{j}\func{Im}\left( 
\mathcal{R}_{\varphi }\left( v\right) _{j}\right) \right\} \\
&=&\func{Re}_{\varphi }\left( v\right) \oplus _{\mathbb{R}}i\func{Im}%
_{\varphi }\left( v\right) .
\end{eqnarray}
\end{remark}

\begin{definition}
The real injection $\mathfrak{r}_{\varphi }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}_{\varphi \mathbb{R}},\mathfrak{H}\right) $ 
\begin{equation}
\mathfrak{r}_{\varphi }:\mathfrak{H}\rightarrow \mathfrak{H}_{\varphi 
\mathbb{R}}=\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} \oplus _{%
\mathbb{R}}\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\}
\end{equation}%
by 
\begin{equation}
\mathfrak{r}_{\varphi }\left( v\right) =\left( \mathfrak{r}_{\varphi
1}\left( v\right) ,\mathfrak{r}_{\varphi 2}\left( v\right) \right) =\frac{1}{%
\sqrt{2}}\left( \func{Re}_{\varphi }\left( v\right) ,\func{Im}_{\varphi
}\left( v\right) \right) ,
\end{equation}%
where 
\begin{equation}
\mathfrak{r}_{\varphi 1}\in \mathcal{B}_{\mathbb{R}}\left( \func{Re}%
_{\varphi }\left\{ \mathfrak{H}\right\} ,\mathfrak{H}\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{r}_{\varphi 2}\in \mathcal{B}_{\mathbb{R}}\left( \func{Im}%
_{\varphi }\left\{ \mathfrak{H}\right\} ,\mathfrak{H}\right)
\end{equation}
\end{definition}

\begin{remark}
recall 
\begin{equation}
\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\} =\func{Im}_{\varphi
}\left\{ \mathfrak{H}\right\} =\mathbb{R}\text{-}\limfunc{linspan}\left\{
\left. \varphi _{j}\right\vert 1\leq j\leq r\right\} .
\end{equation}
\end{remark}

\begin{remark}
The factor $\sqrt{2}$ is needed to make $\mathfrak{r}_{\varphi }$ an
isometry as
\end{remark}

\begin{enumerate}
\item 
\begin{equation}
\left\Vert \mathfrak{r}_{\varphi }\left( v\right) \right\Vert _{\mathfrak{H}%
_{\varphi \mathbb{R}}}=\sqrt{\func{Re}_{\varphi }\left( v\right) ^{2}+\func{%
Im}_{\varphi }\left( v\right) ^{2}}
\end{equation}

\item 
\begin{equation}
\left\Vert v\right\Vert _{\mathfrak{H}}=\sqrt{\left\langle \left. \func{Re}%
_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right) \right\vert 
\func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right)
\right\rangle }=\sqrt{\func{Re}_{\varphi }\left( v\right) ^{2}+\func{Im}%
_{\varphi }\left( v\right) ^{2}}.
\end{equation}
\end{enumerate}

\begin{definition}
The complex injection $\mathfrak{i}_{\varphi }\in \mathcal{B}_{\mathbb{R}%
}\left( \mathfrak{H}_{\mathbb{C}},\mathfrak{H}\right) $%
\begin{equation}
\mathfrak{i}_{\varphi }:\mathfrak{H\rightarrow H}_{\mathbb{C}}=\mathfrak{H}%
\oplus _{\mathbb{C}}\mathfrak{H}
\end{equation}%
by%
\begin{eqnarray}
\mathfrak{i}_{\varphi }\left( v\right) &=&\left( \mathfrak{i}_{\varphi
1}\left( v\right) ,\mathfrak{i}_{\varphi 2}\left( v\right) \right) =\left( 
\func{Re}_{\varphi }\left( v\right) ,i\func{Im}_{\varphi }\left( v\right)
\right) \\
&=&\sum_{1\leq j\leq r}\left\{ \varphi _{j}\func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) _{j}\right) \oplus i\varphi _{j}\func{Im}\left( 
\mathcal{R}_{\varphi }\left( v\right) _{j}\right) \right\} \\
&=&\sum_{1\leq j\leq r}\left\{ \mathfrak{i}_{\varphi 1}\left( \varphi
_{j}\right) \func{Re}\left( \mathcal{R}_{\varphi }\left( v\right)
_{j}\right) +\mathfrak{i}_{\varphi 2}\left( i\varphi _{j}\right) \func{Im}%
\left( \mathcal{R}_{\varphi }\left( v\right) _{j}\right) \right\} \\
&=&\func{Re}_{\varphi }\left( v\right) \oplus i\func{Im}_{\varphi }\left(
v\right) .
\end{eqnarray}
\end{definition}

\begin{definition}
The conjugate Hilbert space $\sigma _{\varphi }\left\{ \mathfrak{H}\right\} $
for $\sigma _{\varphi }\in \mathcal{B}_{anti}\left( \mathfrak{H}\right) $ 
\begin{equation}
\sigma _{\varphi }\left\{ \mathfrak{H}\right\} =\mathbb{C}-\limfunc{linspan}%
\left\{ \left. \sigma _{\varphi }\left( v\right) =\func{Re}_{\varphi }\left(
v\right) -i\func{Im}_{\varphi }\left( v\right) \right\vert v\in \mathfrak{H}%
\right\} .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\sigma _{\varphi }\left\{ \mathfrak{H}\right\} =\mathfrak{H}.
\end{equation}
\end{remark}

\begin{lemma}
The $2r$-dimensional complex Hilbert space $\mathfrak{H}_{\mathbb{C}}$ is
also defined by 
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}\oplus _{\mathbb{C}}\sigma _{\varphi
}\left\{ \mathfrak{H}\right\}
\end{equation}%
for any $\sigma _{\varphi }\in \mathfrak{c}\left( \mathfrak{H}\right) .$
\end{lemma}

\begin{definition}
\begin{eqnarray}
\mathfrak{H}_{\varphi r} &=&\func{Re}_{\varphi }\left\{ \mathfrak{H}\right\}
=\mathbb{R}-\limfunc{linspan}\left\{ \left. \frac{1}{\sqrt{2}}\left( \sigma
_{\varphi }\left( v\right) +v\right) \right\vert v\in \mathfrak{H}\right\}
\subset \mathfrak{H}_{\mathbb{C}} \\
\mathfrak{H}_{\varphi i} &=&\func{Im}_{\varphi }\left\{ \mathfrak{H}\right\}
=\mathbb{R}-\limfunc{linspan}\left\{ \left. \frac{1}{\sqrt{2}}\left( \sigma
_{\varphi }\left( v\right) -v\right) \right\vert v\in \mathfrak{H}\right\}
\subset \mathfrak{H}_{\mathbb{C}}.
\end{eqnarray}
\end{definition}

\begin{notation}
\begin{eqnarray}
\mathfrak{H}_{\func{Re}_{\varphi }} &=&\func{Re}_{\varphi }\left\{ \mathfrak{%
H}\right\} =\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left. \,\left(
v+\sigma _{\varphi }\left( v\right) \right) \right\vert v\in \mathfrak{H}%
\right\} \\
\mathfrak{H}_{\func{Im}_{\varphi }} &=&\func{Im}_{\varphi }\left\{ \mathfrak{%
H}\right\} =\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left. i\left(
v-\sigma _{\varphi }\left( v\right) \right) \right\vert v\in \mathfrak{H}%
\right\} .
\end{eqnarray}
\end{notation}

\begin{lemma}
\begin{equation}
\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}_{\func{Re}_{\varphi }}\oplus _{%
\mathbb{R}}i\mathfrak{H}_{\func{Im}_{\varphi }}.
\end{equation}
\end{lemma}

\begin{notation}
Recall%
\begin{equation}
\left( \boldsymbol{\Phi }\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right)
\end{equation}%
then
\end{notation}

\begin{enumerate}
\item 
\begin{equation}
w=w\left( \boldsymbol{\Phi }\right) =\left( \boldsymbol{\Phi }\right) 
\mathcal{R}_{\Phi }\left( w\right) .
\end{equation}

\item 
\begin{equation}
\func{Re}_{\Phi }\left( w\right) \left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \func{Re}\left( \mathcal{R}_{\Phi }\left( w\right) \right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}\left( \mathcal{R}_{\varphi _{_{1}}}\left( w_{1}\right) \right) \\ 
\func{Re}\left( \mathcal{R}_{\varphi _{2}}\left( w_{2}\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}\left( \mathcal{R}_{\varphi _{_{1}}}\left( w_{1}\right) \right) \\ 
\func{Re}\left( \mathcal{R}_{\varphi _{2}}\left( w_{2}\right) \right)%
\end{array}%
\right) .\quad w\in \mathfrak{H}_{\mathbb{C}}.
\end{equation}

\item 
\begin{equation}
\func{Im}_{\Phi }\left( w\right) \left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \func{Im}\left( \mathcal{R}_{\Phi }\left( w\right) \right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Im}\left( \mathcal{R}_{\varphi _{_{1}}}\left( w_{1}\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi _{2}}\left( w_{2}\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Im}\left( \mathcal{R}_{\varphi _{_{1}}}\left( w_{1}\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi _{2}}\left( w_{2}\right) \right)%
\end{array}%
\right) .\quad w\in \mathfrak{H}_{\mathbb{C}}.
\end{equation}
\end{enumerate}

\begin{remark}
\begin{enumerate}
\item In particular 
\begin{eqnarray}
\mathfrak{r}_{\varphi } &:&\mathfrak{H\rightarrow H}_{\varphi \mathbb{R}} \\
\mathfrak{r}_{\varphi }\left( v\right) &\rightarrow &\left( 
\begin{array}{c}
\func{Re}_{\varphi }\left( v\right) \\ 
\func{Im}_{\varphi }\left( v\right)%
\end{array}%
\right) =\mathfrak{i}_{1}\left( \func{Re}_{\varphi }\left( v\right) \right) +%
\mathfrak{i}_{2}\left( \func{Im}_{\varphi }\left( v\right) \right) =\left( 
\func{Re}_{\varphi }\left( v\right) ,\func{Im}_{\varphi }\left( v\right)
\right)
\end{eqnarray}

\item The $\mathcal{K}$ transformation is unitary 
\begin{equation}
\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) ^{\dagger }=\frac{1}{2}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \left( 
\begin{array}{cc}
I_{\mathfrak{H}} & I_{\mathfrak{H}} \\ 
-iI_{\mathfrak{H}} & iI_{\mathfrak{H}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & 0 \\ 
0 & I_{\mathfrak{H}}%
\end{array}%
\right)
\end{equation}%
and%
\begin{equation}
\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) ^{\dagger }\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\frac{1}{2}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & I_{\mathfrak{H}} \\ 
-iI_{\mathfrak{H}} & iI_{\mathfrak{H}}%
\end{array}%
\right) \left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & 0 \\ 
0 & I_{\mathfrak{H}}%
\end{array}%
\right) .
\end{equation}

\begin{definition}
\begin{equation}
\mathfrak{i}_{n}\left( v,\sigma _{\varphi }\left( v\right) \right) =\frac{1}{%
\sqrt{2}}\mathfrak{i}\left( v,\sigma _{\varphi }\left( v\right) \right) .
\end{equation}
\end{definition}

\item 
\begin{equation}
\mathfrak{i}\left( v,\sigma _{\varphi }\left( v\right) \right) \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\mathcal{R}_{\varphi }\left( \sigma _{\varphi }\left( v\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\overline{\mathcal{R}_{\varphi }\left( v\right) }%
\end{array}%
\right) =\left( \boldsymbol{\varphi }\right) \mathcal{R}_{\varphi }\left(
v\right) \oplus _{\mathbb{C}}\left( \boldsymbol{\varphi }\right) \overline{%
\mathcal{R}_{\varphi }\left( v\right) }
\end{equation}

\item 
\begin{equation}
\mathfrak{i}\left( v,\sigma _{\varphi }\left( v\right) \right) \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \\ 
i\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right)%
\end{array}%
\right) =\left( \boldsymbol{\varphi }\right) \func{Re}\left( \mathcal{R}%
_{\varphi }\left( v\right) \right) \oplus _{\mathbb{C}}\left( \boldsymbol{%
\varphi }\right) i\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right)
\right) =\mathfrak{i}_{d}\left( v\right) =\mathfrak{i}_{d}\left( \overset{}{%
\func{Re}_{\varphi }\left( v\right) +i\func{Im}_{\varphi }\left( v\right) }%
\right) ,\quad v\in \mathfrak{H}.
\end{equation}

\item 
\begin{eqnarray}
\mathcal{K}\left( \overset{}{\mathfrak{i}_{n}\left( v,\sigma _{\varphi
}\left( v\right) \right) }\right) \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \mathcal{R}_{\varphi \varphi }\left( \mathcal{K}\right) \mathcal{R}%
_{\varphi }\left( \mathfrak{i}_{n}\left( v\right) \right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( v\right) \\ 
\mathcal{R}_{\varphi }\left( \sigma _{\varphi }\left( v\right) \right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{\varphi }\left( \func{Re}_{\varphi }\left( v\right) \right) \\ 
\mathcal{R}_{\varphi }\left( \func{Im}_{\varphi }\left( v\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{c}
\func{Re}\left( \mathcal{R}_{\varphi }\left( v\right) \right) \\ 
\func{Im}\left( \mathcal{R}_{\varphi }\left( v\right) \right)%
\end{array}%
\right) ,\quad v\in \mathfrak{H}.
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{remark}
As $\mathcal{A}$ is a $c^{\ast }$-algebra it is isometrically isomorphic to
a subalgebra of the bounded operators $\mathcal{B}\left( \mathcal{H}\right) $
acting in\emph{\ some Hilbert space} $\mathcal{H}$ that is equipped with
inner product $\left\langle \left. {}\right\vert \right\rangle _{\mathcal{H}%
} $ and norm 
\begin{equation}
\left\Vert {}\right\Vert _{\mathcal{H}}=\sqrt{\left\langle \left.
{}\right\vert \right\rangle _{\mathcal{H}}}.
\end{equation}%
Hence 
\begin{equation}
\left\Vert {}\right\Vert _{\mathcal{A}}=\left\Vert {}\right\Vert _{\mathcal{B%
}\left( \mathcal{H}\right) }.
\end{equation}
\end{remark}

\begin{remark}
$\mathfrak{H}$ can have additional structure e.g. it could be a Hilbert
exterior algebra i.e. 
\begin{equation}
\mathfrak{H}={\LARGE \wedge }\left( \mathsf{h}\right) ,
\end{equation}%
where $\mathsf{h}$ is some other Hilbert space.
\end{remark}

\subparagraph{\emph{Fermion} \emph{Second Quantization map}}

The \emph{Fermion} \emph{second quantization map} $\equiv $ \emph{CAR
Algebra }$\mathfrak{H}$-\emph{representation} $\mathfrak{s}^{\dagger }\in 
\mathcal{L}\left( \mathcal{A},\mathfrak{H}\right) ,$ (the algebra of $%
\mathbb{C}$-linear operators mapping $\mathfrak{H}$ to $\mathcal{A}$), is
characterized by the

\begin{definition}
\begin{enumerate}
\item A \emph{CAR Algebra }$\mathfrak{H}$-\emph{representation} $\mathfrak{s}%
^{\dagger }\in \mathcal{L}\left( \mathcal{A},\mathfrak{H}\right) $ is a
complex linear map from a \emph{seperable} Hilbert space $\mathfrak{H}$ into
the $c^{\ast }$-algebra $\mathcal{A}$ that produces \emph{creation}
operators $\mathfrak{s}^{\dagger }\left( f\right) $ 
\begin{equation}
\mathfrak{s}^{\dagger }:\mathfrak{H}\rightarrow \mathcal{A}_{1}\subset 
\mathcal{A},
\end{equation}%
which produce complex antilinear maps

\item $\mathfrak{s}\in \mathcal{L}_{anti}\left( \mathcal{A},\mathfrak{H}%
\right) $ that are \emph{annihilation} operators $\mathfrak{s}\left(
f\right) $ 
\begin{equation}
\mathfrak{s}:\mathfrak{H}\rightarrow \mathcal{A}_{1}\subset \mathcal{A}
\end{equation}%
by 
\begin{equation}
\mathfrak{s}\left( f\right) =\left( \mathfrak{s}^{\dagger }\left( f\right)
\right) ^{\dagger },
\end{equation}%
which satisfy

\item the defining relationships for $\mathfrak{s}^{\dagger },$ that are $%
\forall f,g\in \mathfrak{H}$

\begin{enumerate}
\item 
\begin{equation}
\left\{ \mathfrak{s}^{\dagger }\left( f\right) ,\mathfrak{s}\left( g\right)
\right\} =\left\langle \left. f\right\vert g\right\rangle _{\mathfrak{H}}I_{%
\mathcal{A}}
\end{equation}

\item 
\begin{equation}
\left\{ \mathfrak{s}^{\dagger }\left( f\right) ,\mathfrak{s}^{\dagger
}\left( g\right) \right\} =0
\end{equation}

\item 
\begin{equation}
\left\{ \mathfrak{s}\left( f\right) ,\mathfrak{s}\left( g\right) \right\} =0.
\end{equation}
\end{enumerate}
\end{enumerate}
\end{definition}

\begin{definition}
We will see later that $\boxtimes \left( \mathfrak{s}^{\dagger }\right) \in 
\mathcal{L}\left( \mathcal{A},{\large \wedge }\left( \mathfrak{H}\right)
\right) $, when one considers $\mathcal{A}={\large \wedge }\left( \mathcal{A}%
_{1}\right) .$
\end{definition}

\begin{definition}
Number and Hole operators $\mathfrak{n}\left( f\right) $ and $\mathfrak{h}%
\left( f\right) $ that belong to $\mathcal{A}$

\begin{enumerate}
\item Number operators 
\begin{equation}
\mathfrak{n}\left( f\right) =\mathfrak{s}^{\dagger }\left( f\right) 
\mathfrak{s}\left( f\right) .
\end{equation}

\item Hole operators 
\begin{equation}
\mathfrak{h}\left( f\right) =\mathfrak{s}\left( f\right) \mathfrak{s}%
^{\dagger }\left( f\right) .
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
If $f$ is normalized 
\begin{equation}
\left\Vert f\right\Vert _{\mathfrak{H}}^{2}=\left\langle \left. f\right\vert
f\right\rangle _{\mathfrak{H}}=1
\end{equation}%
then 
\begin{equation}
\mathfrak{n}\left( f\right) =\mathfrak{s}^{\dagger }\left( f\right) 
\mathfrak{s}\left( f\right)
\end{equation}
and 
\begin{equation}
\mathfrak{h}\left( f\right) =\mathfrak{s}\left( f\right) \mathfrak{s}%
^{\dagger }\left( f\right)
\end{equation}
are orthogonal projectors.
\end{lemma}

\begin{proof}
In general 
\begin{eqnarray}
\mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}\left( f\right) \mathfrak{%
s}^{\dagger }\left( f\right) \mathfrak{s}\left( f\right) &=&\mathfrak{s}%
^{\dagger }\left( f\right) \left( \left\langle \left. f\right\vert
f\right\rangle _{\mathfrak{H}}I_{\mathcal{A}}-\mathfrak{s}^{\dagger }\left(
f\right) \mathfrak{s}\left( f\right) \right) \mathfrak{s}\left( f\right) =%
\mathfrak{s}^{\dagger }\left( f\right) \left( I\left\langle \left.
f\right\vert f\right\rangle _{\mathfrak{H}\mathcal{A}}\right) \mathfrak{s}%
\left( f\right) -\mathfrak{s}^{\dagger }\left( f\right) \left( \mathfrak{s}%
^{\dagger }\left( f\right) \mathfrak{s}\left( f\right) \right) \mathfrak{s}%
\left( f\right) =\left\langle \left. f\right\vert f\right\rangle _{\mathfrak{%
H}}\mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}\left( f\right) \\
\mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left( f\right) \mathfrak{%
s}\left( f\right) \mathfrak{s}^{\dagger }\left( f\right) &=&\mathfrak{s}%
\left( f\right) \left( \left\langle \left. f\right\vert f\right\rangle _{%
\mathfrak{H}}I_{\mathcal{A}}-\mathfrak{s}\left( f\right) \mathfrak{s}%
^{\dagger }\left( f\right) \right) \mathfrak{s}^{\dagger }\left( f\right) =%
\mathfrak{s}\left( f\right) \left( \left\langle \left. f\right\vert
f\right\rangle _{\mathfrak{H}}I_{\mathcal{A}}\right) \mathfrak{s}^{\dagger
}\left( f\right) -\mathfrak{s}\left( f\right) \left( \mathfrak{s}\left(
f\right) \mathfrak{s}^{\dagger }\left( f\right) \right) \mathfrak{s}%
^{\dagger }\left( f\right) =\left\langle \left. f\right\vert f\right\rangle
_{\mathfrak{H}}\mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left(
f\right) ,
\end{eqnarray}%
hence if $f$ is normalized they are idempotents i.e. 
\begin{equation}
\left( \mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}\left( f\right)
\right) ^{2}=\mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}\left(
f\right) ,
\end{equation}%
\begin{equation}
\left( \mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left( f\right)
\right) ^{2}=\mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left(
f\right)
\end{equation}%
and $\mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}\left( f\right) $
and $\mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left( f\right) $
are self adjoint.
\end{proof}

\begin{corollary}
If $f$ is normalized then $\mathfrak{n}\left( f\right) $ and $\mathfrak{h}%
\left( f\right) $ are complimentary orthogonal projectors i.e.

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{n}\left( f\right) +\mathfrak{h}\left( f\right) =I_{\mathcal{A}}
\end{equation}

\item 
\begin{equation}
\mathfrak{n}\left( f\right) \mathfrak{h}\left( f\right) =\mathfrak{h}\left(
f\right) \mathfrak{n}\left( f\right) =0
\end{equation}

\item 
\begin{equation}
\left[ \mathfrak{n}\left( f,\right) \mathfrak{h}\left( f\right) \right] =0.
\end{equation}
\end{enumerate}
\end{corollary}

\begin{lemma}
\begin{equation}
\left\Vert \mathfrak{s}^{\dagger }\left( f\right) \right\Vert _{\mathcal{A}%
}=\left\Vert f\right\Vert _{\mathfrak{H}}.
\end{equation}
\end{lemma}

\begin{proof}
\begin{equation}
\left\Vert \mathfrak{s}^{\dagger }\left( f\right) \right\Vert _{\mathcal{A}%
}^{2}=\left\Vert \mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left(
f\right) \right\Vert _{\mathcal{A}}=\left\Vert \mathfrak{s}\left(
\left\langle \left. f\right\vert f\right\rangle _{\mathfrak{H}}^{\frac{1}{2}}%
\widetilde{f}\right) \mathfrak{s}^{\dagger }\left( \left\langle \left.
f\right\vert f\right\rangle _{\mathfrak{H}}^{\frac{1}{2}}\widetilde{f}%
\right) \right\Vert _{\mathcal{A}}=\left\langle \left. f\right\vert
f\right\rangle _{\mathfrak{H}}\left\Vert \mathfrak{s}\left( \widetilde{f}%
\right) \mathfrak{s}^{\dagger }\left( \widetilde{f}\right) \right\Vert _{%
\mathcal{A}}=\left\langle \left. f\right\vert f\right\rangle _{\mathfrak{H}},
\end{equation}%
where $\widetilde{f}$ is the normalized vector given by 
\begin{equation}
\widetilde{f}=\frac{1}{\left\langle \left. f\right\vert f\right\rangle _{%
\mathfrak{H}}^{\frac{1}{2}}}f
\end{equation}%
and 
\begin{equation}
\left\Vert \left( \mathfrak{s}\left( \widetilde{f}\right) \mathfrak{s}%
^{\dagger }\left( \widetilde{f}\right) \right) \left( \mathfrak{s}\left( 
\widetilde{f}\right) \mathfrak{s}^{\dagger }\left( \widetilde{f}\right)
\right) ^{\dagger }\right\Vert _{\mathcal{A}}=\left\Vert \left( \mathfrak{s}%
\left( \widetilde{f}\right) \mathfrak{s}^{\dagger }\left( \widetilde{f}%
\right) \right) \right\Vert _{\mathcal{A}}^{2}=\left\Vert \mathfrak{s}\left( 
\widetilde{f}\right) \mathfrak{s}^{\dagger }\left( \widetilde{f}\right)
\right\Vert _{\mathcal{A}}
\end{equation}%
hence 
\begin{equation}
\left\Vert \mathfrak{s}\left( \widetilde{f}\right) \mathfrak{s}^{\dagger
}\left( \widetilde{f}\right) \right\Vert _{\mathcal{A}}=1.
\end{equation}
\end{proof}

\begin{definition}
The \emph{Ket-Bra} isomorphism $\digamma _{\left\vert {}\right\rangle }$
between the Hilbert space $\mathfrak{H}$ and its dual $\mathfrak{H}^{d}$ is
given by the map 
\begin{equation}
\digamma _{\left\vert {}\right\rangle }:\mathfrak{H}\rightarrow \mathfrak{H}%
^{d}
\end{equation}%
defined by 
\begin{equation}
\digamma _{\left\vert {}\right\rangle }\left( f\right) =\left\langle
f\right\vert .
\end{equation}%
The map $\digamma _{\left\vert {}\right\rangle }$ is $\mathbb{C}$-antilinear
i.e. 
\begin{equation}
\digamma _{\left\vert {}\right\rangle }\left( c_{1}f_{1}+c_{1}f_{2}\right) =%
\overline{c_{1}}\left\langle f_{1}\right\vert +\overline{c_{2}}\left\langle
f_{2}\right\vert .
\end{equation}
\end{definition}

\begin{definition}
$\mathbb{C}$-linear maps $\digamma _{\sigma _{\varphi }\left( \left\vert
{}\right\rangle \right) }=\left[ \digamma _{\left\vert {}\right\rangle
}\circ \sigma _{\varphi }\right] \in \mathcal{L}\left( \mathfrak{H}^{d},%
\mathfrak{H}\right) $ composed from $\digamma _{\left\vert {}\right\rangle }$
and $\sigma _{\varphi }$ from the Hilbert space $\mathfrak{H}$ to its dual $%
\mathfrak{H}^{d}$ 
\begin{equation}
\digamma _{\sigma _{\varphi }\left( \left\vert {}\right\rangle \right)
}\equiv \left[ \digamma _{\left\vert {}\right\rangle }\circ \sigma _{\varphi
}\right] :\mathfrak{H}\rightarrow \mathfrak{H}^{d}
\end{equation}%
are defined by 
\begin{equation}
\digamma _{\sigma _{\varphi }\left( \left\vert {}\right\rangle \right)
}\left( v\right) =\left[ \digamma _{\left\vert {}\right\rangle }\circ \sigma
_{\varphi }\right] \left( v\right) =\left\langle \sigma _{\varphi }\left(
v\right) \right\vert .
\end{equation}
\end{definition}

\begin{lemma}
The maps $\digamma _{\sigma _{\varphi }\left( \left\vert {}\right\rangle
\right) }=\left[ \digamma _{\left\vert {}\right\rangle }\circ \sigma
_{\varphi }\right] \in \mathcal{L}\left( \mathfrak{H}^{d},\mathfrak{H}%
\right) $ are $\mathbb{C}$-linear as 
\begin{eqnarray}
\digamma _{\sigma _{\varphi }\left( \left\vert {}\right\rangle \right)
}\left( c_{1}v_{1}+c_{2}v_{2}\right) &=&\digamma _{\left\vert
{}\right\rangle }\circ \sigma _{\varphi }\left( c_{1}v_{1}+c_{2}v_{2}\right)
=\digamma _{\left\vert {}\right\rangle }\left( \sigma _{\varphi }\left(
c_{1}v_{1}\right) +\sigma _{\varphi }\left( c_{2}v_{2}\right) \right) \\
&=&\digamma _{\left\vert {}\right\rangle }\left( \overline{c_{1}}\sigma
_{\varphi }\left( v_{1}\right) +\overline{c_{2}}\sigma _{\varphi }\left(
v_{2}\right) \right) =c_{1}\left\langle \sigma _{\varphi }\left(
v_{1}\right) \right\vert +c_{2}\left\langle \sigma _{\varphi }\left(
v_{2}\right) \right\vert =c_{1}\digamma _{\sigma _{\varphi }\left(
\left\vert {}\right\rangle \right) }\left( v_{1}\right) +c_{2}\digamma
_{\sigma _{\varphi }\left( \left\vert {}\right\rangle \right) }\left(
v_{2}\right) .
\end{eqnarray}
\end{lemma}

\begin{notation}
\begin{equation}
v^{d}=\left\langle v\right\vert =\digamma _{\left\vert {}\right\rangle
}\left( v\right) \in \mathfrak{H}^{d}.
\end{equation}
\end{notation}

\begin{lemma}
The complex \emph{anti linear} map 
\begin{equation}
\mathfrak{s:H}\rightarrow \mathcal{A}
\end{equation}%
can be thought of as a complex\emph{\ linear} map 
\begin{equation}
\mathfrak{s:H}^{d}\rightarrow \mathcal{A}
\end{equation}%
as 
\begin{equation}
\mathfrak{H}^{d}=\digamma _{\left\vert {}\right\rangle }\left\{ \mathfrak{H}%
\right\} .
\end{equation}
\end{lemma}

\begin{definition}
The\emph{\ complex linear} map $\Omega \in \mathcal{B}\left( \mathcal{A},%
\mathfrak{H\oplus _{\mathbb{C}}H}^{d}\right) $ from the direct sum of dual
spaces $\mathfrak{H}$ and $\mathfrak{H}^{d}$ 
\begin{equation}
\Omega :\mathfrak{H\oplus _{\mathbb{C}}H}^{d}\rightarrow \mathcal{A}%
_{1}\subset \mathcal{A}
\end{equation}%
is given by%
\begin{equation}
\Omega \left( f\,,{\small \,g}^{d}\right) =\Omega \left( f\,\oplus _{\mathbb{%
C}}{\small \,g}^{d}\right) =\Omega \left( f\,+{\small \,g}^{d}\right) ,\quad
f\in \mathfrak{H,}{\small \,g}^{d}\in \mathfrak{H}^{d},
\end{equation}%
where 
\begin{equation}
\Omega \left( f\,,{\small \,g}^{d}\right) =\mathfrak{s}^{\dagger }\left(
\left\vert f\right\rangle \right) +\mathfrak{s}\left( \left\langle
g\right\vert \right) .
\end{equation}
\end{definition}

\begin{definition}
We will see later that one can define $\boxtimes \left( \Omega \right) \in 
\mathcal{B}\left( \mathcal{A},{\large \wedge }\left( \mathfrak{H\oplus _{%
\mathbb{C}}H}^{d}\right) \right) $ when one considers $\mathcal{A}={\large %
\wedge }\left( \mathcal{A}_{1}\right) .$
\end{definition}

\begin{lemma}
$\Omega $ is injective.
\end{lemma}

\begin{remark}
As $\Omega $ is injective its inverse always exists on $\limfunc{Ran}\left(
\Omega \right) .$
\end{remark}

\begin{definition}
The \emph{complex linear} map $\Omega ^{-1}\in \mathcal{B}\left( \mathfrak{%
H\oplus _{\mathbb{C}}H}^{d},\mathcal{A}_{1}\right) $ from $\mathcal{A}$ to
the direct sum of dual spaces $\mathfrak{H}$ and $\mathfrak{H}^{d}$ 
\begin{equation}
\Omega ^{-1}:\mathcal{A}_{1}\rightarrow \mathfrak{H\oplus _{\mathbb{C}}H}^{d}
\end{equation}%
is given by%
\begin{equation}
\Omega ^{-1}\left( \mathfrak{s}^{\dagger }\left( f\right) ,\mathfrak{s}%
\left( g\right) \right) =\Omega ^{-1}\left( \mathfrak{s}^{\dagger }\left(
f\right) +\mathfrak{s}\left( g\right) \right) =\left( f,{\small \,g}%
^{d}\right) =f\,\oplus _{\mathbb{C}}{\small \,g}^{d}=f\,+{\small \,g}%
^{d},\quad f\in \mathfrak{H,}{\small \,g}^{d}\in \mathfrak{H}^{d},\mathfrak{s%
}^{\dagger }\left( f\right) ,\mathfrak{s}\left( g\right) \in \mathcal{A}_{1}.
\end{equation}
\end{definition}

\begin{definition}
C\emph{omplex} linear maps $\Omega _{\sigma _{\varphi }}\in \mathcal{B}%
\left( \mathcal{A},\mathfrak{H\oplus _{\mathbb{C}}H}\right) $%
\begin{equation}
\Omega _{\sigma _{\varphi }}:\mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}%
\rightarrow \mathcal{A}_{1}
\end{equation}%
are defined by 
\begin{gather}
\Omega _{\sigma _{\varphi }}\left( \left\vert f\,\right\rangle ,\left\vert 
{\small g}\right\rangle \right) =\Omega _{\sigma _{\varphi }}\left(
\left\vert f\,\right\rangle \oplus _{\mathbb{C}}\left\vert {\small g}%
\right\rangle \right) =\Omega _{\sigma _{\varphi }}\left( \left\vert
f\,\right\rangle +\left\vert {\small g}\right\rangle \right) =\Omega
_{\sigma _{\varphi }}\left( \left\vert f\,\right\rangle \right) +\Omega
_{\sigma _{\varphi }}\left( \left\vert {\small g}\right\rangle \right)
=\Omega \left( \left\vert f\,\right\rangle \right) +\Omega _{\sigma
_{\varphi }}\left( \left\vert {\small g}\right\rangle \right) \\
=\Omega \left( \overset{}{\left\vert f\,\right\rangle \oplus _{\mathbb{C}}%
\left[ \digamma _{\left\vert {}\right\rangle }\circ \sigma _{\varphi }\right]
{\small \,}\left( \left\vert {\small g}\right\rangle \right) }\right)
=\Omega \left( \overset{}{\left\vert f\,\right\rangle \oplus _{\mathbb{C}%
}\digamma _{\sigma _{\varphi }\left( \left\vert {}\right\rangle \right) }%
{\small \,}\left( \left\vert {\small g}\right\rangle \right) }\right) ,\quad
\\
\left\vert f\,\right\rangle ,\left\vert {\small g}\right\rangle \in 
\mathfrak{H},\quad \Omega _{\sigma _{\varphi }}\left( \left\vert
f\,\right\rangle +\left\vert {\small g}\right\rangle \right) \in \mathcal{A}%
_{1}.
\end{gather}
\end{definition}

\begin{definition}
We will see later that one can define $\boxtimes \left( \Omega _{\sigma
_{\varphi }}\right) \in \mathcal{B}\left( \mathcal{A},{\large \wedge }\left( 
\mathfrak{H\oplus _{\mathbb{C}}H}^{d}\right) \right) $ when one considers $%
\mathcal{A}={\large \wedge }\left( \mathcal{A}_{1}\right) .$
\end{definition}

\begin{remark}
Using the Ket-Bra map $\digamma _{\left\vert {}\right\rangle }$ one can
express the map $\Omega $ as 
\begin{equation}
\Omega \left( \overset{}{\left\vert f\,\right\rangle \oplus _{\mathbb{C}}%
{\small \,}\digamma _{\left\vert {}\right\rangle }\left( \left\vert {\small g%
}\right\rangle \right) }\right) =\Omega \left( \left\vert f\,\right\rangle +%
{\small \,}\left\langle {\small g}\right\vert \right) =\Omega \left(
\left\vert f\,\right\rangle \right) +\Omega \left( \left\langle {\small g}%
\right\vert \right) ,\quad \left\vert f\,\right\rangle ,\in \mathfrak{H,}%
\left\langle {\small g}\right\vert \in \mathfrak{H}^{d},\quad \Omega \left(
\left\vert f\,\right\rangle \oplus _{\mathbb{C}}{\small \,}\left\langle 
{\small g}\right\vert \right) \in \mathcal{A}_{1}
\end{equation}%
leading to 
\begin{equation}
\Omega \left( \left\vert f\,\right\rangle \oplus _{\mathbb{C}}{\small \,}%
\digamma _{\left\vert {}\right\rangle }\left( \left\vert {\small g}%
\right\rangle \right) \right) =\Omega \left( \left\vert f\,\right\rangle +%
{\small \,}\digamma _{\left\vert {}\right\rangle }\left( \left\vert {\small g%
}\right\rangle \right) \right) =\Omega \left( \left\vert f\,\right\rangle
\right) +\Omega \left( {\small \,}\digamma _{\left\vert {}\right\rangle
}\left( \left\vert {\small g}\right\rangle \right) \right) ,\quad \left\vert
f\,\right\rangle \mathfrak{,}\left\vert {\small g}\right\rangle \in 
\mathfrak{H},\quad \Omega \left( \left\vert f\,\right\rangle +{\small \,}%
\digamma _{\left\vert {}\right\rangle }\left( \left\vert {\small g}%
\right\rangle \right) \right) \in \mathcal{A}_{1}.
\end{equation}
\end{remark}

\begin{definition}
The \emph{combination} $\Omega _{\digamma _{\left\vert {}\right\rangle }}$
of $\Omega $ and ${\small \,}\digamma _{\left\vert {}\right\rangle }$
produces a \emph{sesquilinear} map%
\begin{equation}
\Omega _{\digamma _{\left\vert {}\right\rangle }}:\mathfrak{H}\oplus _{%
\mathbb{C}}\mathfrak{H}\rightarrow \mathcal{A}_{1}
\end{equation}%
defined by 
\begin{gather}
\Omega _{\digamma _{\left\vert {}\right\rangle }}\left( \left\vert
f\,\right\rangle ,\left\vert {\small g}\right\rangle \right) =\Omega
_{\digamma _{\left\vert {}\right\rangle }}\left( \left\vert f\,\right\rangle
\oplus _{\mathbb{C}}\left\vert {\small g}\right\rangle \right) =\Omega
_{\digamma _{\left\vert {}\right\rangle }}\left( \left\vert f\,\right\rangle
+\left\vert {\small g}\right\rangle \right) =\Omega \left( \left\vert
f\,\right\rangle \right) +\Omega \left( {\small \,}\digamma _{\left\vert
{}\right\rangle }\left( \left\vert {\small g}\right\rangle \right) \right) \\
\left\vert f\,\right\rangle ,\left\vert {\small g}\right\rangle \in 
\mathfrak{H},\quad \Omega _{\sigma _{\varphi }}\left( \left\vert
f\,\right\rangle +\left\vert {\small g}\right\rangle \right) \in \mathcal{A}%
_{1}.
\end{gather}
\end{definition}

\begin{definition}
We will see later that one can define $\boxtimes \left( \Omega _{\digamma
_{\left\vert {}\right\rangle }}\right) \in \mathcal{B}\left( \mathcal{A},%
{\large \wedge }\left( \mathfrak{H\oplus _{\mathbb{C}}H}^{d}\right) \right) $
when one considers $\mathcal{A}={\large \wedge }\left( \mathcal{A}%
_{1}\right) .$
\end{definition}

\begin{definition}
The \emph{combination} of $\Omega $ and $\digamma _{\left\vert
{}\right\rangle }$ is formalized in the \emph{sesquilinear} quantization map 
$\Upsilon \equiv \Omega _{\digamma _{\left\vert {}\right\rangle }}$ 
\begin{equation}
\Upsilon :\mathfrak{H}\times \mathfrak{H}\rightarrow \mathcal{A}_{1},
\end{equation}%
which is given by 
\begin{equation}
\Upsilon \left( \left\vert f\,\right\rangle ,\left\vert {\small g}%
\right\rangle \right) =\Omega \left( \left\vert f\,\right\rangle \,,{\small %
\,g}^{d}\right) =\Omega \left( f\,,{\small \,}\digamma _{\left\vert
{}\right\rangle }\left( g\right) \right) \equiv \Omega \left( \left\vert
f\,\right\rangle ,\left\langle {\small g}\right\vert \right) ,\quad \Upsilon
\left( \left\vert f\,\right\rangle ,\left\vert {\small g}\right\rangle
\right) \in \mathcal{A}_{1},
\end{equation}%
so that $\Upsilon \left( f\,,{\small \,g}\right) \equiv \Upsilon \left(
\left\vert f\,\right\rangle ,\left\vert {\small g}\right\rangle \right) =%
\mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left( g\right) .$
\end{definition}

\begin{definition}
We will see later that one can define $\boxtimes \left( \Upsilon \right) \in 
\mathcal{B}\left( \mathcal{A},{\large \wedge }\left( \mathfrak{H\oplus _{%
\mathbb{C}}H}^{d}\right) \right) $ when one considers $\mathcal{A}={\large %
\wedge }\left( \mathcal{A}_{1}\right) .$
\end{definition}

\begin{remark}
\begin{equation}
\Upsilon \in \mathcal{B}_{\mathbb{R}}\left( \mathcal{A}_{1},\mathfrak{H}_{%
\mathbb{C}}\right) .
\end{equation}
\end{remark}

\begin{definition}
The diagonal $\Upsilon _{d}$ $\equiv \mathfrak{X}$ of the map $\Upsilon $
can be thought of as a real linear map 
\begin{equation}
\Upsilon _{d}:\mathfrak{H}\rightarrow \mathcal{A}_{1},
\end{equation}%
where the real linear map $\Upsilon _{d}\in \mathcal{B}_{\mathbb{R}}\left( 
\mathcal{A}_{1},\mathfrak{H}\right) $ is defined by%
\begin{equation}
\mathfrak{X}\left( f\,\right) =\Upsilon _{d}\left( f\,\right) =\frac{1}{%
\sqrt{2}}\Upsilon \left( f\,,\,f\right) =\frac{1}{\sqrt{2}}\left( \mathfrak{s%
}^{\dagger }\left( f\right) +\mathfrak{s}\left( f\right) \right) ,\,\forall
f\in \mathfrak{H}.
\end{equation}
\end{definition}

\begin{definition}
We call the diagonal map $\Upsilon _{d}\in \mathcal{B}_{\mathbb{R}}\left( 
\mathfrak{H}_{\mathbb{C}},\mathcal{A}_{1}\right) $ a \emph{Majorona} map,
which we also denote as $\mathfrak{X.}$
\end{definition}

\begin{definition}
We will see later that one can define $\boxtimes \left( \Upsilon _{d}\right)
\equiv \boxtimes \left( \mathfrak{X}\right) \in \mathcal{B}\left( \mathcal{A}%
,{\large \wedge }\left( \mathfrak{H\oplus _{\mathbb{C}}H}^{d}\right) \right) 
$ when one considers $\mathcal{A}={\large \wedge }\left( \mathcal{A}%
_{1}\right) .$
\end{definition}

\begin{definition}
$\mathfrak{s}^{\dagger }$ is a $c^{\ast }$-algebra \emph{representation} of
the CAR if it generates $\mathcal{A}$ as the $c^{\ast }$-\emph{norm limit }%
of the set of all finite order polynomials in 
\begin{equation}
\left\{ \left. \mathfrak{s}^{\dagger }\left( \varphi _{j}\right) ,\mathfrak{s%
}\left( \varphi _{j}\right) \right\vert \,\varphi _{j}\in \mathfrak{H,}1\leq
j\leq r\right\}
\end{equation}%
i.e. 
\begin{equation}
\mathcal{A}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{s}%
^{\dagger }\left( \varphi _{j_{1}}\right) \cdots \mathfrak{s}^{\dagger
}\left( \varphi _{j_{m}}\right) \mathfrak{s}\left( \varphi _{k_{1}}\right)
\cdots \mathfrak{s}\left( \varphi _{k_{n}}\right) \right\vert 1\leq
j_{1}\,<\cdots <j_{m}\leq r,\,1\leq n\leq r,1\leq k_{1}\,<\cdots <k_{n}\leq
r,0\leq m\leq r,\,0\leq n\leq r\right\} .
\end{equation}
\end{definition}

\begin{definition}
Subspaces $\left\{ \mathcal{A}_{mn}^{CAR},0\leq m\leq r,\,0\leq n\leq
r\right\} $ of the algebra $\mathcal{A}$ are defined by 
\begin{equation}
\mathcal{A}_{mn}^{CAR}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{s}^{\dagger }\left( \varphi _{j_{1}}\right) \cdots \mathfrak{s}%
^{\dagger }\left( \varphi _{j_{m}}\right) \mathfrak{s}\left( \varphi
_{k_{1}}\right) \cdots \mathfrak{s}\left( \varphi _{k_{n}}\right)
\right\vert 1\leq j_{1}\,<\cdots <j_{m}\leq r,1\leq k_{1}\,<\cdots
<k_{n}\leq r\right\} ,\,0\leq m\leq r,\,0\leq n\leq r.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\mathcal{A}=\bigoplus\limits_{0\leq m,n\leq r,}\mathcal{A}_{mn}^{CAR}=%
\mathcal{A}^{CAR}
\end{equation}
\end{lemma}

\begin{definition}
$\mathfrak{H}$ is a CAR \emph{Index Space.}
\end{definition}

\begin{definition}
$\mathcal{A}_{n}^{CAR},0\leq n\leq 2r$%
\begin{equation}
\mathcal{A}_{n}^{CAR}=\bigoplus\limits_{\substack{ 0\leq p,q\leq r  \\ 0\leq
p+q=n\leq r,}}\mathcal{A}_{pq}^{CAR}.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\mathcal{A}^{CAR}=\bigoplus\limits_{0\leq n\leq r,}\mathcal{A}_{n}^{CAR}.
\end{equation}
\end{lemma}

\begin{example}
$r=2$

\begin{enumerate}
\item 
\begin{equation}
\mathcal{A}_{20}^{CAR}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{s}^{\dagger }\left( \varphi _{j_{1}}\right) \mathfrak{s}^{\dagger
}\left( \varphi _{j_{2}}\right) \right\vert 1\leq j_{1}\,<j_{2}\leq
2\right\} .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{11}^{CAR}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{s}^{\dagger }\left( \varphi _{j_{1}}\right) \mathfrak{s}\left(
\varphi _{k_{1}}\right) \right\vert 1\leq j_{1}\,\leq 2,1\leq k_{1}\,\leq
2\right\} .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{02}^{CAR}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{s}\left( \varphi _{k_{1}}\right) \mathfrak{s}\left( \varphi
_{k_{2}}\right) \right\vert 1\leq k_{1}\,<k_{2}\leq 2\right\} .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{2}^{CAR}=\bigoplus\limits_{0\leq p+q\leq 2,}\mathcal{A}%
_{pq}^{CAR}=\mathcal{A}_{20}^{CAR}\oplus \mathcal{A}_{11}^{CAR}\oplus 
\mathcal{A}_{02}^{CAR}.
\end{equation}
\end{enumerate}
\end{example}

\begin{example}
\begin{enumerate}
\item 
\begin{equation}
\mathcal{A}_{rr}^{CAR}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{s}^{\dagger }\left( \varphi _{j_{1}}\right) \cdots \mathfrak{s}%
^{\dagger }\left( \varphi _{j_{r}}\right) \mathfrak{s}\left( \varphi
_{k_{1}}\right) \cdots \mathfrak{s}\left( \varphi _{k_{r}}\right)
\right\vert 1\leq j_{1}\,<\cdots <j_{r}\leq r,1\leq k_{1}\,<\cdots
<k_{r}\leq r\right\} =\left\{ \mathfrak{s}^{\dagger }\left( \varphi
_{1}\right) \cdots \mathfrak{s}^{\dagger }\left( \varphi _{r}\right) 
\mathfrak{s}\left( \varphi _{1}\right) \cdots \mathfrak{s}\left( \varphi
_{r}\right) \right\} ,
\end{equation}%
which is the same as

\item 
\begin{equation}
\mathcal{A}_{r}^{CAR}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{s}^{\dagger }\left( \varphi _{j_{1}}\right) \cdots \mathfrak{s}%
^{\dagger }\left( \varphi _{j_{r}}\right) \mathfrak{s}\left( \varphi
_{k_{1}}\right) \cdots \mathfrak{s}\left( \varphi _{k_{r}}\right)
\right\vert 1\leq j_{1}\,<\cdots <j_{r}\leq r,1\leq k_{1}\,<\cdots
<k_{r}\leq r\right\} =\left\{ \mathfrak{s}^{\dagger }\left( \varphi
_{1}\right) \cdots \mathfrak{s}^{\dagger }\left( \varphi _{r}\right) 
\mathfrak{s}\left( \varphi _{1}\right) \cdots \mathfrak{s}\left( \varphi
_{r}\right) \right\} .
\end{equation}
\end{enumerate}
\end{example}

\begin{definition}
$\mathfrak{X}\ $is a $c^{\ast }$-algebra \emph{representation} $\mathcal{A}%
^{Cliff}$ of a complex Clifford algebra over the Hilbert space $\mathfrak{H}$
as it generates $\mathcal{A}$ as the $c^{\ast }$-\emph{norm limit }of the
set of all finite order polynomials in 
\begin{equation}
\left\{ \left. \mathfrak{X}\left( \varphi _{j}\right) ,\mathfrak{X}\left(
i\varphi _{j}\right) \right\vert \,\varphi _{j}\in \mathfrak{H,}1\leq j\leq
r\right\}
\end{equation}%
i.e. 
\begin{equation}
\mathcal{A}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{X}%
\left( \varphi _{j_{1}}\right) \cdots \mathfrak{X}\left( \varphi
_{j_{m}}\right) \mathfrak{X}\left( i\varphi _{k_{1}}\right) \cdots \mathfrak{%
X}\left( i\varphi _{k_{n}}\right) \right\vert 1\leq j_{1}\,<\cdots
<j_{m}\leq r,1\leq k_{1}<\cdots <k_{n}\leq r,\,0\leq m\leq r,\,0\leq n\leq
r\right\} .
\end{equation}
\end{definition}

\begin{definition}
Subspaces $\left\{ \mathcal{A}_{mn}^{Cliff},0\leq m\leq r,\,0\leq n\leq
r\right\} $ of the algebra $\mathcal{A}$ are defined by 
\begin{equation}
\mathcal{A}_{mn}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{X}\left( \varphi _{j_{1}}\right) \cdots \mathfrak{X}\left( \varphi
_{j_{m}}\right) \mathfrak{X}\left( i\varphi _{k_{1}}\right) \cdots \mathfrak{%
X}\left( i\varphi _{k_{n}}\right) \right\vert 1\leq j_{1}\,<\cdots
<j_{m}\leq r,1\leq k_{1}<\cdots <k_{n}\leq r\right\} ,\,0\leq m\leq
r,\,0\leq n\leq r.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\mathcal{A}=\bigoplus\limits_{0\leq m,n\leq r,}\mathcal{A}_{mn}^{Cliff}=%
\mathcal{A}^{Cliff}
\end{equation}
\end{lemma}

\begin{definition}
$\mathfrak{H}$ is a Clifford Algebra \emph{Index Space.}
\end{definition}

\begin{definition}
$\mathcal{A}_{n}^{Cliff},0\leq n\leq 2r$%
\begin{equation}
\mathcal{A}_{n}^{Cliff}=\bigoplus\limits_{\substack{ 0\leq p,q\leq r  \\ %
0\leq p+q=n\leq r,}}\mathcal{A}_{pq}^{Cliff}.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\mathcal{A}^{Cliff}=\bigoplus\limits_{0\leq n\leq 2r,}\mathcal{A}%
_{n}^{Cliff}.
\end{equation}
\end{lemma}

\begin{example}
\begin{enumerate}
\item 
\begin{equation}
\mathcal{A}_{20}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{X}\left( \varphi _{j_{1}}\right) \mathfrak{X}\left( \varphi
_{j_{2}}\right) \right\vert 1\leq j_{1}\,<j_{2}\leq r\right\} .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{11}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{X}\left( \varphi _{j_{1}}\right) \mathfrak{X}\left( i\varphi
_{k_{1}}\right) \right\vert 1\leq j_{1}\,,k_{1}\leq r\right\} .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{02}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. 
\mathfrak{X}\left( i\varphi _{k_{1}}\right) \mathfrak{X}\left( i\varphi
_{k_{2}}\right) \right\vert 1\leq k_{1}<k_{2}\leq r\right\} .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{2}^{Cliff}=\bigoplus\limits_{0\leq p+q\leq 2,}\mathcal{A}%
_{pq}^{CAR}=\mathcal{A}_{20}^{CAR}\oplus \mathcal{A}_{11}^{CAR}\oplus 
\mathcal{A}_{02}^{CAR}=\mathcal{A}_{2}^{CAR}.
\end{equation}
\end{enumerate}
\end{example}

\begin{example}
Let 
\begin{eqnarray}
x_{j} &=&\mathfrak{X}\left( \varphi _{j}\right) ,\,1\leq j\leq r \\
x_{j+r} &=&\mathfrak{X}\left( i\varphi _{j}\right) ,\,1\leq j\leq r
\end{eqnarray}%
then 
\begin{equation}
\mathcal{A}_{n}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
x_{j_{1}}\cdots x_{j_{n}}\right\vert 1\leq j_{1}\,<\cdots <j_{n}\leq
2r,\right\} ,\,0\leq n\leq 2r.
\end{equation}
\end{example}

\begin{example}
\begin{enumerate}
\item 
\begin{equation}
\mathcal{A}_{2}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
x_{j_{1}}x_{j_{2}}\right\vert 1\leq j_{1}<j_{2}\leq 2r\right\}
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{r}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
x_{j_{1}}\cdots x_{j_{r}}\right\vert 1\leq j_{1}\,<\cdots <j_{r}\leq
2r\right\}
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{2r}^{Cliff}=\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
x_{j_{1}}\cdots x_{j_{2r}}\right\vert 1\leq j_{1}\,<\cdots <j_{2r}\leq
2r\right\} =\left\{ x_{1}\cdots x_{2r}\right\} .
\end{equation}
\end{enumerate}
\end{example}

\begin{remark}
In general 
\begin{equation}
\mathcal{A}_{pq}^{CAR}\neq \mathcal{A}_{pq}^{Cliff}.
\end{equation}
\end{remark}

\begin{lemma}
$\left\{ \left. \mathfrak{X}\left( \varphi _{j}\right) ,\mathfrak{X}\left(
i\varphi _{j}\right) \right\vert 1\leq j\,\leq r\right\} $ satisfy the
Clifford Algebra CR's%
\begin{eqnarray}
&&\left\{ \mathfrak{X}\left( \varphi _{j}\right) ,\mathfrak{X}\left( \varphi
_{k}\right) \right\} =\left\langle \left. \varphi _{j}\right\vert \varphi
_{k}\right\rangle I_{\mathcal{A}} \\
&&\left\{ \mathfrak{X}\left( i\varphi _{j}\right) ,\mathfrak{X}\left(
i\varphi _{k}\right) \right\} =\left\langle \left. \varphi _{j}\right\vert
\varphi _{k}\right\rangle I_{\mathcal{A}} \\
&&\left\{ \mathfrak{X}\left( \varphi _{j}\right) ,\mathfrak{X}\left(
i\varphi _{k}\right) \right\} =0 \\
&&\qquad \qquad 1\leq j\,,k\leq r.
\end{eqnarray}
\end{lemma}

\begin{definition}
Clifford Algebra Presentation $\mathfrak{X}$: Let $\mathfrak{X}\in \mathcal{B%
}_{\mathbb{R}}\left( \mathcal{A},\mathfrak{H}\right) $ be a \underline{$%
\mathbb{R}$-linear map} 
\begin{equation}
\mathfrak{X}:\mathfrak{H}\rightarrow \mathcal{A}_{10}^{Cliff}\oplus \mathcal{%
A}_{01}^{Cliff}\equiv \mathcal{A}_{1}^{Cliff}\subset \mathcal{A}%
=\bigoplus\limits_{0\leq m,n\leq r}\mathcal{A}_{mn}^{Cliff}=\bigoplus%
\limits_{0\leq m\leq 2r}\mathcal{A}_{m}^{Cliff}
\end{equation}%
defined by

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{X}\left( f\right) =\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger
}\left( f\right) +\mathfrak{s}\left( f\right) \right) =\mathfrak{X}\left(
f\right) ^{\dagger },\quad \forall f\in \mathfrak{H}
\end{equation}%
or equivalently

\item 
\begin{equation}
\mathfrak{X}\left( if\right) =\frac{i}{\sqrt{2}}\left( \mathfrak{s}^{\dagger
}\left( f\right) -\mathfrak{s}\left( f\right) \right) =\mathfrak{X}\left(
if\right) ^{\dagger },\quad \forall f\in \mathfrak{H.}
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
Athough%
\begin{equation}
\mathcal{A}_{1}^{Cliff}=\mathcal{A}_{1}^{CAR}=\mathcal{A}_{1}
\end{equation}%
in general 
\begin{equation}
\mathcal{A}_{n}^{Cliff}\neq \mathcal{A}_{n}^{CAR}\text{ for }n>1.
\end{equation}
\end{remark}

\begin{definition}
The complex linear \emph{Majorona} map $\mathcal{M\in B}\left( \mathcal{A}%
_{1}\right) $%
\begin{equation}
\mathcal{M}:\mathcal{A}_{1}\rightarrow \mathcal{A}_{1}
\end{equation}%
is defined by

\begin{enumerate}
\item 
\begin{equation}
\mathcal{M}\left( \mathfrak{s}^{\dagger }\left( f\right) \right) =\frac{1}{%
\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left(
f\right) \right) =\mathfrak{X}\left( f\right)
\end{equation}%
or equivalently

\item 
\begin{equation}
\mathcal{M}\left( \mathfrak{s}\left( f\right) \right) =\frac{i}{\sqrt{2}}%
\left( \mathfrak{s}^{\dagger }\left( f\right) -\mathfrak{s}\left( f\right)
\right) =\mathfrak{X}\left( if\right) .
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
This gives the change of $\mathcal{A}_{1}^{Cliff}=\mathcal{A}_{1}^{CAR}$ $=%
\mathcal{A}_{1}$ basis map $\mathcal{M\in B}\left( \mathcal{A}%
_{1}^{Cliff}\right) =\mathcal{B}\left( \mathcal{A}_{1}^{CAR}\right) =%
\mathcal{B}\left( \mathcal{A}_{1}\right) $ 
\begin{equation}
\mathcal{M}\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right)
\end{equation}%
from a creation and annihilation basis to a Majorona basis. The operator $%
\mathfrak{R}_{\varphi }\left( \mathcal{M}\right) $ and scalar
representations $\mathcal{R}_{\varphi }\left( \mathcal{M}\right) $ of $%
\mathcal{M}$ are 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) &=&\mathcal{M}\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \mathfrak{R}_{\varphi }\left( \mathcal{M}\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( \mathcal{M}\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{\mathfrak{H}} & i\mathbb{I}_{\mathfrak{H}} \\ 
\mathbb{I}_{\mathfrak{H}} & -i\mathbb{I}_{\mathfrak{H}}%
\end{array}%
\right) ,
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{M\in U}\left( \mathfrak{H}_{\mathbb{C}}\right) \equiv \mathcal{U}%
\left( \mathfrak{H}\oplus _{\mathbb{C}}\mathfrak{H}\right) \equiv \mathcal{U}%
\left( \mathcal{A}_{10}^{CAR}\oplus _{\mathbb{C}}\mathcal{A}%
_{01}^{CAR}\right) \equiv \mathcal{U}\left( \mathcal{A}_{1}\right) \text{ }
\end{equation}%
as%
\begin{equation}
\text{ }\mathfrak{R}_{\varphi }\left( \mathcal{M}\right) ,\mathcal{R}%
_{\varphi }\left( \mathcal{M}\right) \in \mathcal{U}\left( 2r\right) .
\end{equation}
\end{remark}

\begin{definition}
$T\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{C}}\right) $ is a CAR
transformation if 
\begin{equation}
\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }\right) & \mathfrak{s}\left( 
\boldsymbol{\psi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( T\boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( T\boldsymbol{\varphi }\right)%
\end{array}%
\right)
\end{equation}
\end{definition}

\begin{remark}
$T$ is not a $CAR$ transformation if 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\boldsymbol{\psi }_{1} & \boldsymbol{\psi }_{2}%
\end{array}%
\right) &=&T\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \mathcal{R}_{\varphi \varphi }\left( T\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{12} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{22}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }\right) \mathcal{R}_{\left( \boldsymbol{\varphi }%
,\boldsymbol{\varphi }\right) }\left( T\right) _{11}+\left( \boldsymbol{%
\varphi }\right) \mathcal{R}_{\left( \boldsymbol{\varphi },\boldsymbol{%
\varphi }\right) }\left( T\right) _{21} & \left( \boldsymbol{\varphi }%
\right) \mathcal{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }%
\right) }\left( T\right) _{12}+\left( \boldsymbol{\varphi }\right) \mathcal{R%
}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right) }\left(
T\right) _{22}%
\end{array}%
\right)
\end{eqnarray}%
and 
\begin{equation}
\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{12} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{22}%
\end{array}%
\right) \neq \left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{21} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{11}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{enumerate}
\item $T$ is a $CAR$ transformation if 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{12} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{12} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{11}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{21} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{\varphi },%
\boldsymbol{\varphi }\right) }\left( T\right) _{11}%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\mathfrak{X}\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{\mathfrak{H}} & i\mathbb{I}_{\mathfrak{H}} \\ 
\mathbb{I}_{\mathfrak{H}} & -i\mathbb{I}_{\mathfrak{H}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\mathcal{M}\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) .
\end{equation}

\item If 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T_{\mathcal{A}_{1}}\right) =\mathfrak{R}_{\left( \boldsymbol{\varphi 
},\boldsymbol{\varphi }\right) }\left( \mathcal{M}\right) =\frac{1}{\sqrt{2}}%
\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right)
\end{equation}%
then 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi },\boldsymbol{\varphi }\right)
}\left( T\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & -iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & iI_{\mathfrak{H}}%
\end{array}%
\right) .
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & I_{\mathfrak{H}} \\ 
iI_{\mathfrak{H}} & iI_{\mathfrak{H}}%
\end{array}%
\right) =\sqrt{2}\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }\right) & \boldsymbol{0}%
\end{array}%
\right) .
\end{equation}

\item 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\boldsymbol{\psi }_{1} & \boldsymbol{\psi }_{2}%
\end{array}%
\right) &=&T\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \mathcal{R}_{\varphi \varphi }\left( T\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & \boldsymbol{\varphi }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & -iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & iI_{\mathfrak{H}}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }\right) \mathbb{I}_{\mathfrak{H}}+\left( 
\boldsymbol{\varphi }\right) \mathbb{I}_{\mathfrak{H}} & -i\left( 
\boldsymbol{\varphi }\right) \mathbb{I}_{\mathfrak{H}}+i\left( \boldsymbol{%
\varphi }\right) \mathbb{I}_{\mathfrak{H}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\sqrt{2}\left( \boldsymbol{\varphi }\right) \mathbb{I}_{\mathfrak{H}} & 
\boldsymbol{0}%
\end{array}%
\right)
\end{eqnarray}

\item 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) &=&\left[ \mathfrak{X}^{-1}\circ \mathcal{M}\right] \left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \\
\left[ \mathfrak{X}\circ \mathcal{M}^{-1}\right] \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right)
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{definition}
The composition map $\gamma =\left[ \mathfrak{X}\circ \mathcal{M}^{-1}\right]
$ is a Second Quantization map 
\begin{equation}
\gamma =\left[ \mathcal{M}^{-1}\circ \mathfrak{X}\right] \in \mathcal{B}_{%
\mathbb{R}}\left( \mathcal{A}_{1},\mathfrak{H}_{\mathbb{C}}\right)
\end{equation}%
which is defined by 
\begin{equation}
\mathfrak{X}\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) =\mathcal{M}\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) =\left[ \mathcal{M}^{-1}\circ \mathfrak{X}\right] \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\gamma \left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) .
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\gamma =\left[ \mathcal{M}^{-1}\circ \mathfrak{X}\right] \in \mathcal{B}%
\left( \mathcal{A}_{1},\mathfrak{H}_{\mathbb{C}}\right) ,\,\mathcal{M}^{-1}%
\mathcal{\in B}\left( \mathcal{A}_{1}\right) ,\,\mathfrak{X}\in \mathcal{B}%
\left( \mathcal{A}_{1},\mathfrak{H}_{\mathbb{C}}\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
x+iy+x-iy &=&2x \\
x+iy-x+iy &=&2iy
\end{eqnarray}%
\begin{equation}
\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1}+\boldsymbol{\varphi }_{2} & i\left( \boldsymbol{%
\varphi }_{1}-\boldsymbol{\varphi }_{2}\right)%
\end{array}%
\right)
\end{equation}%
\begin{eqnarray}
\boldsymbol{\varphi }_{1}+\overline{\boldsymbol{\varphi }}_{1} &=&2\func{Re}%
\left( \boldsymbol{\varphi }_{1}\right) \\
i\left( \boldsymbol{\varphi }_{1}-\boldsymbol{\varphi }_{2}\right) &=&i2i%
\func{Im}\left( \boldsymbol{\varphi }_{1}\right) =-2\func{Im}\left( 
\boldsymbol{\varphi }_{1}\right)
\end{eqnarray}%
\begin{equation}
\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{\mathfrak{H}} & iI_{\mathfrak{H}} \\ 
I_{\mathfrak{H}} & -iI_{\mathfrak{H}}%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1}+i\boldsymbol{\varphi }_{1} & i\left( \boldsymbol{%
\varphi }_{1}-i\boldsymbol{\varphi }_{1}\right)%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1}+i\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }%
_{1}+i\boldsymbol{\varphi }_{1}%
\end{array}%
\right)
\end{equation}
\end{remark}

\begin{remark}
The diagonal $\mathfrak{X}=\Upsilon _{d}\in \mathcal{B}_{\mathbb{R}}\left( 
\mathfrak{H}_{\mathbb{C}},\mathcal{A}_{1}\right) $ 
\begin{equation}
\mathfrak{X}:\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}\oplus _{\mathbb{C}}%
\mathfrak{H}\rightarrow \mathcal{A}_{1}
\end{equation}%
of the map $\mathfrak{X}$ is a real linear map that produces self adjoint
operators i.e.

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{X}\left( f\,\right) =\frac{1}{\sqrt{2}}\Upsilon \left( f\,,{\small %
\,}f\right) =\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( f\right)
+\mathfrak{s}\left( f\right) \right)
\end{equation}%
and

\item 
\begin{equation}
\mathfrak{X}\left( if\,\right) =\Upsilon \left( if\,,{\small if}\right) =%
\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( if\right) +\mathfrak{s%
}\left( if\right) \right) =\frac{i}{\sqrt{2}}\left( \mathfrak{s}^{\dagger
}\left( f\right) -\mathfrak{s}\left( f\right) \right) .
\end{equation}
\end{enumerate}

\item The transformation $\mathcal{M}\in \mathcal{B}\left( \mathcal{A}%
_{1}\right) $ between the image of a second quantized map $\mathfrak{s}%
^{\dagger }$ and the image of the associated Majorona map $\mathfrak{X}$ is
defined by

\begin{enumerate}
\item 
\begin{equation}
\mathcal{M}\left( \mathfrak{s}^{\dagger }\left( f\right) \right) =\frac{1}{%
\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( f\right) +\mathfrak{s}\left(
f\right) \right) =\mathfrak{X}\left( f\right) .
\end{equation}

\item 
\begin{equation}
\mathcal{M}\left( \mathfrak{s}\left( f\right) \right) =\frac{i}{\sqrt{2}}%
\left( \mathfrak{s}^{\dagger }\left( f\right) -\mathfrak{s}\left( f\right)
\right) =\mathfrak{X}\left( if\right) .
\end{equation}

\item giving%
\begin{eqnarray}
\mathcal{M}\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }%
\right) +\mathfrak{s}\left( \boldsymbol{\varphi }\right) \right) & \frac{i}{%
\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) -%
\mathfrak{s}\left( \boldsymbol{\varphi }\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \mathcal{R}_{a}\left( \mathcal{M}\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( f\right) & \mathfrak{X}\left( if\right)%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}

\item The inverse relationships defining $\mathcal{M}^{-1}\in \mathcal{B}%
\left( \mathcal{A}_{1}\right) $ are

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{s}^{\dagger }\left( f\right) =\frac{1}{\sqrt{2}}\left( \Upsilon
_{d}\left( f\,\right) -i\Upsilon _{d}\left( if\,\right) \right) =\frac{1}{%
\sqrt{2}}\left( \mathfrak{X}\left( f\,\right) -i\mathfrak{X}\left(
if\,\right) \right) =\mathcal{M}^{-1}\left( \mathfrak{X}\left( f\,\right)
\right)
\end{equation}

\item 
\begin{equation}
\mathfrak{s}\left( f\right) =\frac{i}{\sqrt{2}}\left( \Upsilon _{d}\left(
f\,\right) +i\Upsilon _{d}\left( if\,\right) \right) =\frac{i}{\sqrt{2}}%
\left( \mathfrak{X}\left( f\,\right) +i\mathfrak{X}\left( if\,\right)
\right) =\mathcal{M}^{-1}\left( \mathfrak{X}\left( if\,\right) \right)
\end{equation}

\item giving 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }\right)%
\end{array}%
\right) &=&\mathcal{M}^{-1}\left( 
\begin{array}{cc}
\mathfrak{X}\left( f\right) & \mathfrak{X}\left( if\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( f\right) & \mathfrak{X}\left( if\right)%
\end{array}%
\right) \mathcal{R}_{x}\left( \mathcal{M}^{-1}\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{X}\left( f\right) & \mathfrak{X}\left( if\right)%
\end{array}%
\right) \mathcal{R}_{a}\left( \mathcal{M}\right) ^{\dagger }=\left( 
\begin{array}{cc}
\mathfrak{X}\left( f\right) & \mathfrak{X}\left( if\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}

\item The action of $\mathfrak{X}\in \mathcal{B}\left( \mathcal{A}_{1},%
\mathfrak{H}_{\mathbb{C}}\right) $ on a basis $\left\{ \boldsymbol{\varphi }%
,i\boldsymbol{\varphi }\right\} $ of $\mathfrak{H}_{\mathbb{C}}=\mathfrak{H}%
\oplus _{\mathbb{C}}\mathfrak{H}$ is expressed as

\begin{enumerate}
\item 
\begin{equation}
\mathfrak{X}\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \mathfrak{R}_{\varphi }\left( \mathfrak{X}\right) =\mathfrak{X}%
\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( \mathfrak{X}\right)
\end{equation}

\item 
\begin{equation}
\mathfrak{X}\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( \mathfrak{X}\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\mathfrak{X}\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
I_{r} & iI_{r} \\ 
I_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) \mathfrak{R}_{\varphi }\left( \mathfrak{X}\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right)
\end{equation}

\item This shows that 
\begin{equation}
\mathcal{R}_{\varphi }\left( \mathfrak{X}\right) =\mathcal{R}_{a}\left( 
\mathcal{M}\right) .
\end{equation}

\item The action of $\mathfrak{X}^{-1}$ $\in \mathcal{B}\left( \mathfrak{H}_{%
\mathbb{C}},\mathcal{A}\right) $ on a basis $\left\{ \mathfrak{s}^{\dagger
}\left( \boldsymbol{\varphi }\right) ,\mathfrak{s}\left( \boldsymbol{\varphi 
}\right) \right\} $ of $\mathcal{A}_{1}^{CAR}=\mathcal{A}_{10}^{CAR}\oplus _{%
\mathbb{C}}\mathcal{A}_{01}^{CAR}$ is expressed as%
\begin{eqnarray}
\mathfrak{X}^{-1}\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) &=&\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( \mathfrak{X}^{-1}\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{X}\left( \boldsymbol{\varphi }\right) & \mathfrak{X}\left( i%
\boldsymbol{\varphi }\right)%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( \mathfrak{X}\right) ^{\dagger }=\left( 
\begin{array}{cc}
\boldsymbol{\varphi } & i\boldsymbol{\varphi }%
\end{array}%
\right) ,
\end{eqnarray}%
where 
\begin{equation}
\mathcal{R}_{\varphi }\left( \mathfrak{X}\right) ^{\dagger }=\mathcal{R}%
_{\varphi }\left( \mathfrak{X}^{-1}\right) =\mathcal{R}_{\varphi }\left( 
\mathfrak{X}\right) ^{-1}.
\end{equation}
\end{enumerate}

\item The complex linear creation map $\mathfrak{s}^{\dagger }$ 
\begin{equation}
\mathfrak{s}^{\dagger }:\mathfrak{H}\rightarrow \mathcal{A}
\end{equation}%
is given by 
\begin{equation}
\mathfrak{s}^{\dagger }\left( f\right) =\Upsilon \left( f,0\right) =\Omega
_{\digamma _{\left\vert {}\right\rangle }}\left( f,0\right) =\Omega _{\sigma
_{\varphi }}\left( f,0\right)
\end{equation}

\item the complex antilinear annihilation map $\mathfrak{s}$ 
\begin{equation}
\mathfrak{s}:\mathfrak{H}\rightarrow \mathcal{A}
\end{equation}%
is given by 
\begin{equation}
\mathfrak{s}\left( f\right) =\Upsilon \left( 0,f\right) =\Omega _{\digamma
_{\left\vert {}\right\rangle }}\left( 0,f\right) =\Omega _{\sigma _{\varphi
}}\left( 0,\sigma _{\varphi }\left( f\right) \right)
\end{equation}

\item hence 
\begin{equation}
\mathfrak{s}\left( \sigma _{\varphi }\left( f\right) \right) =\Omega
_{\sigma _{\varphi }}\left( 0,f\right)
\end{equation}%
and 
\begin{equation}
\mathfrak{s}\left( \sigma _{\varphi }\left( f\right) \right) =\sum_{1\leq
j\leq r}\mathfrak{s}\left( \varphi _{j}\right) \overline{\mathcal{R}%
_{\varphi }\left( f\right) }_{j}.
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
Let $T\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{C}}\right) $ i.e. 
\begin{equation}
T:\mathfrak{H}_{\mathbb{C}}\rightarrow \mathfrak{H}_{\mathbb{C}}
\end{equation}%
and $\left( \boldsymbol{\varphi }\right) =\left( \boldsymbol{\varphi }_{1},%
\boldsymbol{\varphi }_{2}\right) $ be a conb of $\mathfrak{H}_{\mathbb{C}}$
then

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
v=\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }_{1}\right) & \left( \boldsymbol{\varphi }%
_{2}\right)%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( v\right) =\sum_{1\leq j\leq r}\varphi
_{1j}\mathcal{R}_{\varphi _{1}}\left( v\right) _{j}+\sum_{1\leq j\leq
r}\varphi _{2j}\mathcal{R}_{\varphi _{2}}\left( v\right) _{j}=\sum_{1\leq
j\leq 2r}\varphi _{j}\mathcal{R}_{\varphi }\left( v\right) _{j}.
\end{equation}

\item 
\begin{eqnarray}
T\left( \boldsymbol{\varphi }\right) &=&T\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }_{1}\right) & \left( \boldsymbol{\varphi }%
_{2}\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
T\left( \boldsymbol{\varphi }_{1}\right) & T\left( \boldsymbol{\varphi }%
_{2}\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }_{1}\right) & \left( \boldsymbol{\varphi }%
_{2}\right)%
\end{array}%
\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) \\
&=&\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }_{1}\right) & \left( \boldsymbol{\varphi }%
_{2}\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{12} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{22}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\left( \boldsymbol{\varphi }_{1}\right) \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{11}+\left( 
\boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }%
_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{21} & \left( 
\boldsymbol{\varphi }_{1}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }%
_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{21}+\left( 
\boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }%
_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{22}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\left( \boldsymbol{\psi }_{1}\right) & \left( \boldsymbol{\psi }_{2}\right)%
\end{array}%
\right) =\left( \boldsymbol{\psi }\right) .
\end{eqnarray}%
i.e.

\item 
\begin{equation}
T\left( \boldsymbol{\varphi }_{1}\right) =\left( \boldsymbol{\varphi }%
_{1}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{11}+\left( \boldsymbol{\varphi }%
_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{21}=\left( \boldsymbol{\psi }%
_{1}\right)
\end{equation}%
and%
\begin{equation}
T\left( \boldsymbol{\varphi }_{2}\right) =\left( \boldsymbol{\varphi }%
_{1}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{21}+\left( \boldsymbol{\varphi }%
_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{22}=\left( \boldsymbol{\psi }%
_{2}\right) .
\end{equation}

\item The $2\times 2$ operator representation equals the $2r\times 2r$
scalar representation i.e. 
\begin{equation}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) =\mathcal{R}_{\left( \boldsymbol{\varphi }_{1},%
\boldsymbol{\varphi }_{2}\right) }\left( T\right) .
\end{equation}
\end{enumerate}

\item Let $T_{\mathcal{A}_{1}}\in \mathcal{B}\left( \mathcal{A}_{1}\right) $
and $T\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{C}}\right) $ then

\begin{enumerate}
\item 
\begin{align}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }_{1}\right) & =\mathfrak{s}%
^{\dagger }\left( T\left( \boldsymbol{\varphi }_{1}\right) \right) \\
& =\mathfrak{s}^{\dagger }\left( \left( \boldsymbol{\varphi }_{1}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{11}+\left( \boldsymbol{\varphi }_{2}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{21}\right) \\
& =\mathfrak{s}^{\dagger }\left( \left( \boldsymbol{\varphi }_{1}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{11}\right) +\mathfrak{s}^{\dagger }\left(
\left( \boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{21}\right)
\\
& =\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }_{1}\right) \mathfrak{R%
}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) _{11}+\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }%
_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{21} \\
& =T_{\mathcal{A}_{1}}\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{%
\varphi }_{1}\right) \right)
\end{align}

\item 
\begin{align}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }_{2}\right) & =\mathfrak{s}%
^{\dagger }\left( T\left( \boldsymbol{\varphi }_{2}\right) \right) \\
& =\mathfrak{s}^{\dagger }\left( \left( \boldsymbol{\varphi }_{1}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{12}+\left( \boldsymbol{\varphi }_{2}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{22}\right) \\
& =\mathfrak{s}^{\dagger }\left( \left( \boldsymbol{\varphi }_{1}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{12}\right) +\mathfrak{s}^{\dagger }\left(
\left( \boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{22}\right)
\\
& =\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }_{1}\right) \mathfrak{R%
}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) _{12}+\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }%
_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{22} \\
& =T_{\mathcal{A}_{1}}\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{%
\varphi }_{2}\right) \right)
\end{align}

\item Let $T_{\mathcal{A}_{1}}\in \mathcal{B}\left( \mathcal{A}_{1}\right) $
and $T\in \mathcal{B}\left( \mathfrak{H}_{\mathbb{C}}\right) $ then

\begin{enumerate}
\item 
\begin{align}
\mathfrak{s}\left( \boldsymbol{\psi }_{1}\right) & =\mathfrak{s}\left(
T\left( \boldsymbol{\varphi }_{1}\right) \right) =\left( \mathfrak{s}%
^{\dagger }\left( T\left( \boldsymbol{\varphi }_{1}\right) \right) \right)
^{\dagger } \\
& =\left( \left( \boldsymbol{\varphi }_{1}\right) \mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right)
_{11}+\left( \boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right)
_{21}\right) \\
& =\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }_{1}\right) 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{11}\right) ^{\dagger }+\mathfrak{s}^{\dagger
}\left( \left( \boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right)
_{21}\right) ^{\dagger } \\
& =\mathfrak{s}\left( \boldsymbol{\varphi }_{1}\right) \overline{\mathfrak{R}%
_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) }_{11}+\mathfrak{s}\left( \boldsymbol{\varphi }_{2}\right) 
\overline{\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi 
}_{2}\right) }\left( T\right) }_{21} \\
& =T_{\mathcal{A}_{1}}\left( \mathfrak{s}\left( \boldsymbol{\varphi }%
_{1}\right) \right)
\end{align}

\item 
\begin{align}
\mathfrak{s}\left( \boldsymbol{\psi }_{2}\right) & =\mathfrak{s}\left(
T\left( \boldsymbol{\varphi }_{2}\right) \right) =\left( \mathfrak{s}%
^{\dagger }\left( T\left( \boldsymbol{\varphi }_{2}\right) \right) \right)
^{\dagger } \\
& =\mathfrak{s}\left( \left( \boldsymbol{\varphi }_{1}\right) \mathfrak{R}%
_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) _{12}+\left( \boldsymbol{\varphi }_{2}\right) \mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right)
_{22}\right) \\
& =\left( \mathfrak{s}^{\dagger }\left( \left( \boldsymbol{\varphi }%
_{1}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{12}\right) \right) ^{\dagger
}+\left( \mathfrak{s}^{\dagger }\left( \left( \boldsymbol{\varphi }%
_{2}\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{%
\varphi }_{2}\right) }\left( T\right) _{22}\right) \right) ^{\dagger } \\
& =\mathfrak{s}\left( \boldsymbol{\varphi }_{1}\right) \overline{\mathfrak{R}%
_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left(
T\right) }_{12}+\mathfrak{s}\left( \boldsymbol{\varphi }_{2}\right) 
\overline{\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi 
}_{2}\right) }\left( T\right) }_{22} \\
& =T_{\mathcal{A}_{1}}\left( \mathfrak{s}\left( \boldsymbol{\varphi }%
_{2}\right) \right) .
\end{align}%
This gives
\end{enumerate}

\item 
\begin{equation}
\left( 
\begin{array}{cc}
\boldsymbol{\psi }_{1} & \boldsymbol{\psi }_{2}%
\end{array}%
\right) =T\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{12} \\ 
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{21} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{22}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\boldsymbol{\varphi }_{1} & \boldsymbol{\varphi }_{2}%
\end{array}%
\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) .
\end{equation}%
and

\item 
\begin{eqnarray}
&&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\psi }_{1}\right) & \mathfrak{s}%
\left( \boldsymbol{\psi }_{2}\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( T\boldsymbol{\varphi }_{1}\right) & \mathfrak{s%
}\left( T\boldsymbol{\varphi }_{2}\right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }_{1}\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }_{2}\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T\right) _{11} & \mathfrak{R}_{\left( \boldsymbol{%
\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) _{12} \\ 
\overline{\mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi 
}_{2}\right) }\left( T\right) }_{21} & \overline{\mathfrak{R}_{\left( 
\boldsymbol{\varphi }_{1},\boldsymbol{\varphi }_{2}\right) }\left( T\right) }%
_{22}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
T_{\mathcal{A}_{1}}\left( \mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }%
_{1}\right) \right) & T_{\mathcal{A}_{1}}\left( \mathfrak{s}\left( 
\boldsymbol{\varphi }_{2}\right) \right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \boldsymbol{\varphi }_{1}\right) & \mathfrak{s}%
\left( \boldsymbol{\varphi }_{2}\right)%
\end{array}%
\right) \mathfrak{R}_{\left( \boldsymbol{\varphi }_{1},\boldsymbol{\varphi }%
_{2}\right) }\left( T_{\mathcal{A}_{1}}\right) \\
&=&T_{\mathcal{A}_{1}}\left( 
\begin{array}{cc}
