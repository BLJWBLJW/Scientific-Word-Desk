$\rfloor $

\begin{theorem}
$f_{a}$ is a pure normal vacuum state if
\end{theorem}

\begin{enumerate}
\item 
\begin{equation}
QQ^{\dagger}QQ^{\dagger}=QQ^{\dagger}
\end{equation}

\item 
\begin{eqnarray}
Q &=&\sum_{0\leq n\leq r}\sum_{1\leq j_{1}<\cdots <j_{n}\leq r}\alpha
_{j_{1}\cdots j_{n}}b_{j_{1}}^{\dagger }\cdots b_{j_{n}}^{\dagger } \\
&=&\lambda _{0}I_{\mathcal{F}}+\sum_{1\leq n\leq r}\sum_{1\leq j_{1}<\cdots
<j_{n}\leq 2r}\lambda _{j_{1}\cdots j_{n}}\frac{1}{\sqrt{2}}\left(
x_{bj_{1}}-ix_{bj_{1+r}}\right) \cdots \frac{1}{\sqrt{2}}\left(
x_{bj_{n}}-ix_{bj_{n+r}}\right)
\end{eqnarray}%
for some canonical generating set $\left\{ b_{1},\cdots ,b_{r}\right\} $ of $%
\mathcal{A}.$
\end{enumerate}

\paragraph{ Ket Bra Operators in the Fock Reprentation $\Pi _{f_{a}}$}

\begin{enumerate}
\item 
\begin{equation}
\left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle
\left\langle \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\vert
\left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle
=\left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle
\end{equation}

\item 
\begin{equation}
\left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle
\left\langle \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\vert
\left\vert \Phi _{f_{a}}\left( a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger
}\right) \right\rangle =\left\langle \left. \Phi _{f_{a}}\left( I_{\mathcal{F%
}}\right) \right\vert \Phi _{f_{a}}\left( a_{l_{1}}^{\dagger }\cdots
a_{l_{p}}^{\dagger }\right) \right\rangle _{f_{a}}\left\vert \Phi
_{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle =\limfunc{tr}\left\{
a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger }D_{f_{a}}\right\} \left\vert
\Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle =0
\end{equation}

\item 
\begin{equation}
\left\vert \overset{}{\Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots
a_{j_{n}}^{\dagger }\right) }\right\rangle \left\langle \overset{}{\Phi
_{f_{a}}\left( I_{\mathcal{F}}\right) }\right\vert \left\vert \Phi
_{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle =\left\vert \Phi
_{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots a_{j_{n}}^{\dagger }\right)
\right\rangle
\end{equation}

\item 
\begin{align}
\left\vert \overset{}{\Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots
a_{j_{n}}^{\dagger }\right) }\right\rangle \left\langle \overset{}{\Phi
_{f_{a}}\left( I_{\mathcal{F}}\right) }\right\vert \left\vert \Phi
_{f_{a}}\left( a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger }\right)
\right\rangle & =\left\langle \left. \overset{}{\Phi _{f_{a}}\left( I_{%
\mathcal{F}}\right) }\right\vert \Phi _{f_{a}}\left( a_{l_{1}}^{\dagger
}\cdots a_{l_{p}}^{\dagger }\right) \right\rangle _{f_{a}}\left\vert \Phi
_{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots a_{j_{n}}^{\dagger }\right)
\right\rangle \\
& =\limfunc{tr}\left\{ a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger
}D_{f_{a}}\right\} \left\vert \Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots
a_{j_{n}}^{\dagger }\right) \right\rangle =0
\end{align}

\item 
\begin{gather}
\left\vert \Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots a_{j_{n}}^{\dagger
}\right) \right\rangle \left\langle \Phi _{f_{a}}\left( a_{k_{1}}^{\dagger
}\cdots a_{k_{m}}^{\dagger }\right) \right\vert \left\vert \Phi
_{f_{a}}\left( a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger }\right)
\right\rangle _{f_{a}} \\
=\left\langle \left. \Phi _{f_{a}}\left( a_{k_{1}}^{\dagger }\cdots
a_{k_{m}}^{\dagger }\right) \right\vert \Phi _{f_{a}}\left(
a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger }\right) \right\rangle
\left\vert \Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots a_{j_{n}}^{\dagger
}\right) \right\rangle \\
=\limfunc{tr}\left\{ \left( a_{k_{1}}^{\dagger }\cdots a_{k_{m}}^{\dagger
}\right) ^{\dagger }a_{l_{1}}^{\dagger }\cdots a_{l_{p}}^{\dagger
}D_{f_{a}}\right\} \left\vert \Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\cdots
a_{j_{n}}^{\dagger }\right) \right\rangle .
\end{gather}

\item 
\begin{align}
& \left\vert \Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\right) \right\rangle
\left\langle \Phi _{f_{a}}\left( a_{k_{1}}^{\dagger }\right) \right\vert
\boxtimes \left\vert \Phi _{f_{a}}\left( a_{j_{2}}^{\dagger }\right)
\right\rangle \left\langle \Phi _{f_{a}}\left( a_{k_{2}}^{\dagger }\right)
\right\vert \\
& =\left\vert \Phi _{f_{a}}\left( a_{j_{1}}^{\dagger }\right) \wedge \Phi
_{f_{a}}\left( a_{j_{2}}^{\dagger }\right) \right\rangle \left\langle \Phi
_{f_{a}}\left( a_{k_{1}}^{\dagger }\right) \wedge \Phi _{f_{a}}\left(
a_{k_{2}}^{\dagger }\right) \right\vert \\
& \left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle
\left\langle \Phi _{f_{a}}\left( a_{k_{1}}^{\dagger }\right) \right\vert
\boxtimes \left\vert \Phi _{f_{a}}\left( a_{j_{2}}^{\dagger }\right)
\right\rangle \left\langle \Phi _{f_{a}}\left( a_{k_{2}}^{\dagger }\right)
\right\vert \\
& =\left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \wedge \Phi
_{f_{a}}\left( a_{j_{2}}^{\dagger }\right) \right\rangle \left\langle \Phi
_{f_{a}}\left( a_{k_{1}}^{\dagger }\right) \wedge \Phi _{f_{a}}\left(
a_{k_{2}}^{\dagger }\right) \right\vert \\
& \left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle
\left\langle \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \right\vert
\boxtimes \left\vert \Phi _{f_{a}}\left( a_{j_{2}}^{\dagger }\right)
\right\rangle \left\langle \Phi _{f_{a}}\left( a_{k_{2}}^{\dagger }\right)
\right\vert \\
& =\left\vert \Phi _{f_{a}}\left( I_{\mathcal{F}}\right) \wedge \Phi
_{f_{a}}\left( I_{\mathcal{F}}\right) \right\rangle \left\langle \Phi
_{f_{a}}\left( a_{k_{1}}^{\dagger }\right) \wedge \Phi _{f_{a}}\left(
a_{k_{2}}^{\dagger }\right) \right\vert .
\end{align}
\end{enumerate}

\subsection{Hamiltonians and Time Evolutions}

In the vacuum representation the expectation value of a one particle
Hamiltonian is given by 
\begin{align}
& \left\langle \left. \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( a_{j}^{\dagger }\right) \right\vert \Pi _{\left\vert
\phi \right\rangle \left\langle \phi \right\vert }\left( \widehat{H}\right)
\Phi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{j}^{\dagger }\right) \right\rangle =\limfunc{tr}\left\{ a_{j}\widehat{H}%
\left( a_{j}^{\dagger }\right) \left\vert \phi \right\rangle \left\langle
\phi \right\vert \right\} =E_{j}\limfunc{tr}\left\{ a_{j}a_{j}^{\dagger
}\left\vert \phi \right\rangle \left\langle \phi \right\vert \right\} \\
& =\limfunc{tr}\left\{ a_{j}\left( Ha_{j}^{\dagger }-a_{j}^{\dagger
}H\right) \left\vert \phi \right\rangle \left\langle \phi \right\vert
\right\} =\limfunc{tr}\left\{ a_{j}Ha_{j}^{\dagger }\left\vert \phi
\right\rangle \left\langle \phi \right\vert \right\} -\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger }H\left\vert \phi \right\rangle \left\langle \phi
\right\vert \right\} \\
& =\limfunc{tr}\left\{ a_{j}Ha_{j}^{\dagger }\left\vert \phi \right\rangle
\left\langle \phi \right\vert \right\} =E_{j}\limfunc{tr}\left\{
a_{j}a_{j}^{\dagger }\left\vert \phi \right\rangle \left\langle \phi
\right\vert \right\} =E_{j},
\end{align}%
as 
\begin{equation}
H\left\vert \phi \right\rangle \left\langle \phi \right\vert =0,
\end{equation}%
which also means that $\Pi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( \widehat{u}\right) $ and $\Pi _{\left\vert \phi
\right\rangle \left\langle \phi \right\vert }\left( \widehat{H}\right) $ are
well defined. Thus 
\begin{equation}
\limfunc{tr}\left\{ A\right\} =2^{-r}\limfunc{Tr}\left\{ A\right\} ,
\end{equation}%
\begin{equation}
\left\langle \left. \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( a_{j}^{\dagger }\right) \right\vert \Pi _{\left\vert
\phi \right\rangle \left\langle \phi \right\vert }\left( \widehat{H}\right)
\Phi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{j}^{\dagger }\right) \right\rangle =\left\langle \left. \varphi
_{j}\right\vert H\varphi _{j}\right\rangle ,
\end{equation}%
and 
\begin{align}
\left\langle \left. \varphi _{j}\right\vert H\varphi _{j}\right\rangle &
=E_{j}=\func{Tr}\left\{ H\left\vert \varphi _{j}\right\rangle \left\langle
\varphi _{j}\right\vert \right\} =\func{Tr}\left\{ Ha_{j}^{\dagger
}\left\vert \phi \right\rangle \left\langle \phi \right\vert a_{j}\right\} =%
\func{Tr}\left\{ a_{j}Ha_{j}^{\dagger }\left\vert \phi \right\rangle
\left\langle \phi \right\vert \right\} \\
& =\func{Tr}\left\{ \left( a_{j}Ha_{j}^{\dagger }-a_{j}a_{j}^{\dagger
}H\right) \left\vert \phi \right\rangle \left\langle \phi \right\vert
\right\} =\func{Tr}\left\{ a_{j}\widehat{H}\left( a_{j}^{\dagger }\right)
\left\vert \phi \right\rangle \left\langle \phi \right\vert \right\} \\
& =\left\langle \left. \Phi _{\left\vert \phi \right\rangle \left\langle
\phi \right\vert }\left( a_{j}^{\dagger }\right) \right\vert \Pi
_{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left( 
\widehat{H}\right) \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( a_{j}^{\dagger }\right) \right\rangle .
\end{align}%
A time evolution in $\mathcal{H}^{1}$ is given by 
\begin{equation}
\left\vert \psi \left( t\right) \right\rangle =u\left( t\right) \left\vert
\psi \right\rangle =e^{-iHt}\left\vert \psi \right\rangle
\end{equation}%
and in $\mathcal{A}$ by 
\begin{equation}
A\left( t\right) =\widehat{u}\left( t\right) \left( A\right) =u\left(
t\right) Au\left( t\right) ^{\dagger }=e^{-iHt}Ae^{iHt}=\exp \left\{ -i\func{%
adj}\left( H\right) \right\} \left( A\right) ,
\end{equation}%
where 
\begin{equation}
\widehat{H}\left( A\right) =\func{adj}\left( H\right) \left( A\right) =\left[
H,A\right] .
\end{equation}%
This gives 
\begin{align}
u\left( t\right) a_{j}^{\dagger }u\left( t\right) ^{\dagger }&
=a_{j}^{\dagger }\left( u\left( t\right) \varphi _{j}\right) =\Gamma \left(
u\left( t\right) \left\vert \varphi _{j}\right\rangle \left\langle \phi
\right\vert u\left( t\right) ^{\dagger }\right) \\
\widehat{H}\left( a_{j}^{\dagger }\right) & =\left[ H,a_{j}^{\dagger }\right]
=a_{j}^{\dagger }\left( H\varphi _{j}\right) =\Gamma \left( H\left\vert
\varphi _{j}\right\rangle \left\langle \phi \right\vert -\left\vert \varphi
_{j}\right\rangle \left\langle \phi \right\vert H\right) ,
\end{align}%
which shows 
\begin{align}
H\varphi _{j}& =E_{j}\varphi _{j} \\
\widehat{H}\left( \left\vert \varphi _{j}\right\rangle \left\langle \phi
\right\vert \right) & =E_{j}\left\vert \varphi _{j}\right\rangle
\left\langle \phi \right\vert \\
\widehat{H}\left( a_{j}^{\dagger }\right) & =E_{j}a_{j}^{\dagger }.
\end{align}%
$\lceil $

\begin{align}
\left[ \sum_{1\leq j\leq r}E_{j}a_{j}^{\dagger }a_{j},a_{k}^{\dagger }\right]
& =\sum_{1\leq j\leq r}E_{j}\left[ a_{j}^{\dagger }a_{j},a_{k}^{\dagger }%
\right] =\sum_{1\leq j\leq r}E_{j}\left( a_{j}^{\dagger }a_{j}a_{k}^{\dagger
}-a_{k}^{\dagger }a_{j}^{\dagger }a_{j}\right) =E_{k}\left( a_{k}^{\dagger
}a_{k}a_{k}^{\dagger }-a_{k}^{\dagger }a_{k}^{\dagger }a_{k}\right)
=E_{k}a_{k}^{\dagger } \\
& =a^{\dagger }\left( E_{k}\varphi _{k}\right) =a^{\dagger }\left( H\varphi
_{k}\right) =E_{k}a^{\dagger }\left( \varphi _{k}\right) .
\end{align}%
and%
\begin{equation}
e^{-iHt}a_{k}^{\dagger }e^{iHt}=e^{-iE_{k}t}a_{k}^{\dagger }.
\end{equation}%
$\rfloor $

The states $\left\{ \left. a_{j}^{\dagger }a_{j}\right\vert 1\leq j\leq
r\right\} $ and $\left\{ \left. a_{j}a_{j}^{\dagger }\right\vert 1\leq j\leq
r\right\} $ are stationary and $\left\{ \left. a_{j}^{\dagger
},a_{j}\right\vert 1\leq j\leq r\right\} $ are eigen amplitudes of $\widehat{%
H}$ i.e. 
\begin{align}
\widehat{u}\left( t\right) \left( a_{j}^{\dagger }a_{j}\right) &
=a_{j}^{\dagger }a_{j};\widehat{u}\left( t\right) \left( a_{j}a_{j}^{\dagger
}\right) =a_{j}a_{j}^{\dagger } \\
\left[ H,a_{j}^{\dagger }a_{j}\right] & =\left[ H,a_{j}a_{j}^{\dagger }%
\right] =0 \\
\widehat{H}\left( a_{j}^{\dagger }\right) & =E_{j}a_{j}^{\dagger };1\leq
j\leq r \\
\widehat{H}\left( a_{j}\right) & =-E_{j}a_{j};1\leq j\leq r.
\end{align}%
Hence%
\begin{align}
\left\langle a_{j}^{\dagger }\left\vert \widehat{H}a_{j}^{\dagger }\right.
\right\rangle _{\left\vert \phi \right\rangle \left\langle \phi \right\vert
}& =\limfunc{tr}\left\{ a_{j}\left[ H,a_{j}^{\dagger }\right] \right\} =%
\limfunc{tr}\left\{ a_{j}\left( Ha_{j}^{\dagger }-a_{j}^{\dagger }H\right)
\right\} =\limfunc{tr}\left\{ a_{j}Ha_{j}^{\dagger }\right\} -\limfunc{tr}%
\left\{ a_{j}a_{j}^{\dagger }H\right\} \\
& =\limfunc{tr}\left\{ Ha_{j}^{\dagger }a_{j}\right\} -\limfunc{tr}\left\{
Ha_{j}a_{j}^{\dagger }\right\} =E_{j}\limfunc{tr}\left\{ a_{j}a_{j}^{\dagger
}\right\} \\
& =\limfunc{tr}\left\{ Ha_{j}^{\dagger }a_{j}\right\} -\limfunc{tr}\left\{
H\left( 1-a_{j}^{\dagger }a_{j}\right) \right\} =2\limfunc{tr}\left\{
Ha_{j}^{\dagger }a_{j}\right\} -\limfunc{tr}\left\{ H\right\} \\
& \Rightarrow \frac{\left\langle a_{j}^{\dagger }\left\vert \widehat{H}%
a_{j}^{\dagger }\right. \right\rangle _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }}{\left\langle a_{j}^{\dagger }\left\vert
a_{j}^{\dagger }\right. \right\rangle _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }}=E_{j}.
\end{align}%
However 
\begin{equation}
\Pi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left( 
\widehat{H}\right) \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( a_{j}^{\dagger }\right) =\Phi _{\left\vert \phi
\right\rangle \left\langle \phi \right\vert }\left( Ha_{j}^{\dagger
}-a_{j}^{\dagger }H\right) =\Phi _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }\left( Ha_{j}^{\dagger }\right) =\Pi
_{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
H\right) \Phi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert
}\left( a_{j}^{\dagger }\right) =E_{j}\Phi _{\left\vert \phi \right\rangle
\left\langle \phi \right\vert }\left( a_{j}^{\dagger }\right)
\end{equation}%
as 
\begin{equation}
\left\langle \left. \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( a_{j}^{\dagger }H\right) \right\vert \Phi _{\left\vert
\phi \right\rangle \left\langle \phi \right\vert }\left( a_{j}^{\dagger
}H\right) \right\rangle _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }=\limfunc{tr}\left\{ Ha_{j}a_{j}^{\dagger }H\left\vert \phi
\right\rangle \left\langle \phi \right\vert \right\} =0
\end{equation}%
i.e. 
\begin{equation}
a_{j}^{\dagger }H\in \ker \Phi _{\left\vert \phi \right\rangle \left\langle
\phi \right\vert }
\end{equation}%
and%
\begin{equation}
\left\langle \left. \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( Ha_{j}^{\dagger }\right) \right\vert \Phi _{\left\vert
\phi \right\rangle \left\langle \phi \right\vert }\left( Ha_{j}^{\dagger
}\right) \right\rangle _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }=\limfunc{tr}\left\{ a_{j}HHa_{j}^{\dagger }\left\vert \phi
\right\rangle \left\langle \phi \right\vert \right\} \neq 0.
\end{equation}%
On the other hand 
\begin{equation}
\Phi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left(
a_{j}\right) =0
\end{equation}%
i.e. 
\begin{equation}
a_{j}\in \ker \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }
\end{equation}%
thus 
\begin{equation}
\Pi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left( 
\widehat{H}\right) \Phi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( a_{j}\right) =0,
\end{equation}%
so the eigenvalues $\left\{ -E_{j}\right\} $ associated with $\left\{
a_{j}\right\} $ \emph{are eliminated} and 
\begin{equation}
\Pi _{\left\vert \phi \right\rangle \left\langle \phi \right\vert }\left( 
\widehat{H}\right) =\Pi _{\left\vert \phi \right\rangle \left\langle \phi
\right\vert }\left( H\right) .
\end{equation}%
\label{rep check}

\section{Ket Bra Operators $\in \mathcal{B}\left( \mathcal{A}_{HS}\right) $}

The Hilbert space $\mathcal{A}_{HS}$ is defined by the closure of $\mathcal{A%
}_{0}$ $\left( \text{the analog of finite rank operators}\right) $ in the
norm given by 
\begin{equation}
\left\Vert A\right\Vert _{HS}=\left( \limfunc{tr}\left\{ A^{\dagger
}A\right\} \right) ^{\frac{1}{2}}=\left\langle \left. A\right\vert
A\right\rangle _{\mathcal{A}}^{\frac{1}{2}}=\left( \left\langle \left\langle
A^{\dagger }A\right\rangle \right\rangle _{0}\right) ^{\frac{1}{2}}
\end{equation}%
or equivalently by the GNS\ carrier space defined by the faithful tracial
state $\limfunc{tr},$ i.e. by $\Phi _{\limfunc{tr}}\left( \mathcal{A}%
^{c}\right) .$ The representation $\Pi _{\limfunc{tr}}\left( \mathcal{A}%
^{c}\right) $ of $\mathcal{A}^{c}$ on $\Phi _{\limfunc{tr}}\left( \mathcal{A}%
^{c}\right) \equiv \mathcal{A}_{HS}$ is contained in $\mathcal{B}\left( 
\mathcal{A}_{HS}\right) $.

By redefining the norms of $\left\{ x_{j}\right\} $ one can define an
orthonormal basis of $\Phi _{\limfunc{tr}}\left( \mathcal{A}^{c}\right) $ as 
$\left\{ \Phi _{\mathit{\limfunc{tr}}}\left( I_{\mathcal{A}}\right) ,\left\{
\left. \Phi _{\mathit{\limfunc{tr}}}\left( x_{j_{1}}\cdots x_{j_{p}}\right)
\right\vert 1\leq j_{1}<\cdots <j_{p}\leq 2r\right\} ;1\leq p\leq 2r\right\} 
$ and $\mathcal{A}_{HS}$ as $\left\{ I_{\mathcal{A}},\left\{ \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert 1\leq j_{1}<\cdots <j_{p}\leq
2r\right\} ;1\leq p\leq 2r\right\} $, but note that there is no difference
between $\Phi _{\limfunc{tr}}\left( \mathcal{A}^{c}\right) $ and $\mathcal{A}%
_{HS}$ as vector spaces so we shall denote the Hilbert space as $\mathcal{A}%
_{HS}$ from now on. However it also is an algebra, in fact a Hilbert
algebra. For vectors in $\mathcal{A}_{HS}$ one has the equivalence 
\begin{equation}
A\equiv \Phi _{\mathit{\limfunc{tr}}}\left( A\right) .
\end{equation}%
A resolution of the identity $I_{\mathcal{A}_{HS}}\in \mathcal{B}\left( 
\mathcal{A}_{HS}\right) ,$ (One should observe that the action of $I_{%
\mathcal{A}}$ and $I_{\mathcal{A}_{HS}}$ on $\mathcal{A}_{HS}$ are
identical), is thus given by 
\begin{equation}
I_{\mathcal{A}_{HS}}=\left\vert I_{\mathcal{A}}\right\rangle \left\langle I_{%
\mathcal{A}}\right\vert +\sum_{1\leq p\leq 2r}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq 2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \left\langle
x_{j_{1}}\cdots x_{j_{p}}\right\vert ,
\end{equation}%
note that 
\begin{equation}
\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle \equiv x_{j_{1}}\cdots
x_{j_{p}},
\end{equation}%
leading to the vector expansion 
\begin{align}
A& =I_{\mathcal{A}_{HS}}A=\left( \left\vert I_{\mathcal{A}}\right\rangle
\left\langle I_{\mathcal{A}}\right\vert +\sum_{1\leq p\leq 2r}\sum_{1\leq
j_{1}<\cdots <j_{p}\leq 2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle x_{j_{1}}\cdots x_{j_{p}}\right\vert \right) A \\
& =\left\vert I_{\mathcal{A}}\right\rangle \left\langle \left. I_{\mathcal{A}%
}\right\vert A\right\rangle _{\mathcal{A}}+\sum_{1\leq p\leq 2r}\sum_{1\leq
j_{1}<\cdots <j_{p}\leq 2r}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert A\right\rangle _{%
\mathcal{A}} \\
& =\left\vert I_{\mathcal{A}}\right\rangle \limfunc{tr}\left\{ A\right\}
+\sum_{1\leq p\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\left\vert
x_{j_{1}}\cdots x_{j_{p}}\right\rangle \limfunc{tr}\left\{ x_{j_{p}}\cdots
x_{j_{1}}A\right\} \\
& =\limfunc{tr}\left\{ A\right\} I_{\mathcal{A}}+\sum_{1\leq p\leq
2r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\limfunc{tr}\left\{
x_{j_{p}}\cdots x_{j_{1}}A\right\} x_{j_{1}}\cdots x_{j_{p}} \\
& =\left\langle \left\langle A\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq p\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\left\langle
\left\langle x_{j_{p}}\cdots x_{j_{1}}A\right\rangle \right\rangle
_{0}x_{j_{1}}\cdots x_{j_{p}}.
\end{align}%
Thus one can make the identifications 
\begin{equation}
\left\langle A\right\rangle _{p}=\sum_{1\leq j_{1}<\cdots <j_{p}\leq
2r}\left\langle \left\langle x_{j_{p}}\cdots x_{j_{1}}A\right\rangle
\right\rangle _{0}x_{j_{1}}\cdots x_{j_{p}}=\sum_{1\leq j_{1}<\cdots
<j_{p}\leq 2r}A_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}};0\leq p\leq 2r
\end{equation}

Any nuclear operator $T\in \mathcal{B}\left( \mathcal{A}_{HS}\right) $ can
be expressed as 
\begin{eqnarray}
T &=&\sum_{0\leq p,q\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq
2r  \\ 0\leq k_{1}<\cdots <k_{q}\leq 2r}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle T_{j_{1}\cdots j_{p}k_{1}\cdots k_{q}}\left\langle
x_{k_{1}}\cdots x_{k_{q}}\right\vert \\
&=&\sum_{0\leq p,q\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r 
\\ 0\leq k_{1}<\cdots <k_{q}\leq 2r}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle \left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert T\left( x_{k_{1}}\cdots x_{k_{q}}\right) \right\rangle
_{\mathcal{A}}\left\langle x_{k_{1}}\cdots x_{k_{q}}\right\vert ,
\end{eqnarray}%
where 
\begin{equation}
T_{j_{1}\cdots j_{p}k_{1}\cdots k_{q}}=\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert T\left( x_{k_{1}}\cdots x_{k_{q}}\right) \right\rangle
_{\mathcal{A}}
\end{equation}%
and any operator belonging to $\mathcal{B}\left( \mathcal{A}_{HS}\right) $
can be obtained by taking the strong operator limit of sequences of nuclear
operators.

In particular left multiplication operators $A_{L}$acting as 
\begin{equation}
A_{L}(B)=AB
\end{equation}%
belonging to $\mathcal{B}\left( \mathcal{A}_{HS}\right) $ can be thought of
as $\Pi _{\mathit{\limfunc{tr}}}\left( A\right) $ (as $\left\{ \Pi _{\mathit{%
\limfunc{tr}}}\left( A\right) \right\} $ are always well defined)$,$ hence 
\begin{equation}
\Pi _{\mathit{\limfunc{tr}}}\left( A\right) \Phi _{\mathit{\limfunc{tr}}%
}\left( B\right) =\Phi _{\mathit{\limfunc{tr}}}\left( AB\right) =\Pi _{%
\mathit{\limfunc{tr}}}\left( AB\right) \Phi _{\mathit{\limfunc{tr}}}\left(
I_{\mathcal{A}}\right) .
\end{equation}%
This leads to 
\begin{align}
\left( x_{l_{1}}\cdots x_{l_{m}}\right) _{L}& =\sum_{0\leq p,q\leq 2r}\sum 
_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r  \\ 0\leq k_{1}<\cdots
<k_{q}\leq 2r}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A%
}}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert \left(
x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots x_{k_{q}}\right)
\right\rangle _{\mathcal{A}}\left\langle x_{k_{1}}\cdots x_{k_{q}}\right\vert
\\
& =\sum_{0\leq p,q\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r 
\\ 0\leq k_{1}<\cdots <k_{q}\leq 2r}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert x_{l_{1}}\cdots x_{l_{m}}x_{k_{1}}\cdots
x_{k_{q}}\right\rangle \left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle
\left\langle x_{k_{1}}\cdots x_{k_{q}}\right\vert
\end{align}%
and 
\begin{equation}
A_{L}=\sum_{0\leq p,q,m\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots
<j_{p}\leq 2r  \\ 0\leq k_{1}<\cdots <k_{q}\leq 2r  \\ 0\leq l_{1}<\cdots
<l_{m}\leq 2r}}A_{l_{1}\cdots l_{m}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert \left( x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left(
x_{k_{1}}\cdots x_{k_{q}}\right) \right\rangle _{\mathcal{A}}\left\langle
x_{k_{1}}\cdots x_{k_{q}}\right\vert .
\end{equation}%
Thus the action of $A_{L}$ on $\mathcal{A}_{HS}$ is given by 
\begin{align}
& A_{L}\left( x_{i_{1}}\cdots x_{i_{t}}\right) \\
& =\sum_{0\leq p,q,m\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq
2r  \\ 0\leq k_{1}<\cdots <k_{q}\leq 2r  \\ 0\leq l_{1}<\cdots <l_{m}\leq 2r 
}}A_{l_{1}\cdots l_{m}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{%
\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert \left(
x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots x_{k_{q}}\right)
\right\rangle _{\mathcal{A}}\left\langle \left. x_{k_{1}}\cdots
x_{k_{q}}\right\vert x_{i_{1}}\cdots x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{0\leq p,m\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r 
\\ 0\leq l_{1}<\cdots <l_{m}\leq 2r}}A_{l_{1}\cdots l_{m}}\left\vert
x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert \left( x_{l_{1}}\cdots x_{l_{m}}\right)
_{L}\left( x_{i_{1}}\cdots x_{i_{t}}\right) \right\rangle _{\mathcal{A}} \\
& =\sum_{0\leq p,m\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r 
\\ 0\leq l_{1}<\cdots <l_{m}\leq 2r}}A_{l_{1}\cdots l_{m}}\left\vert
x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left.
x_{j_{1}}\cdots x_{j_{p}}\right\vert x_{l_{1}}\cdots
x_{l_{m}}x_{i_{1}}\cdots x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{0\leq m\leq 2r}\sum_{0\leq l_{1}<\cdots <l_{m}\leq
2r}A_{l_{1}\cdots l_{m}}\left\vert x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle =\sum_{0\leq m\leq 2r}\left( \sum_{0\leq l_{1}<\cdots
<l_{m}\leq 2r}A_{Ll_{1}\cdots l_{m}}x_{l_{1}}\cdots x_{l_{m}}\right)
x_{i_{1}}\cdots x_{i_{t}}
\end{align}%
which can formally be extended to $\mathcal{A}^{w}.$

Hence multiplication in $\mathcal{A}$ can then be expressed as 
\begin{align}
& A_{L}\left( B\right) \\
& =A_{L}\left( \sum_{\substack{ 0\leq i_{1}<\cdots <i_{t}\leq 2r  \\ 0\leq
t\leq 2r}}B_{i_{1}\cdots i_{t}}x_{i_{1}}\cdots x_{i_{t}}\right) \\
& =\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r  \\ 0\leq k_{1}<\cdots
<k_{q}\leq 2r  \\ 0\leq l_{1}<\cdots <l_{m}\leq 2r  \\ 0\leq i_{1}<\cdots
<i_{t}\leq 2r  \\ 0\leq p,q,m,t\leq 2r}}A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots
i_{t}}\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}%
}\left\langle \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert \left(
x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left( x_{k_{1}}\cdots x_{k_{q}}\right)
\right\rangle _{\mathcal{A}}\left\langle \left. x_{k_{1}}\cdots
x_{k_{q}}\right\vert x_{i_{1}}\cdots x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r  \\ 0\leq l_{1}<\cdots
<l_{m}\leq 2r  \\ 0\leq i_{1}<\cdots <i_{t}\leq 2r  \\ 0\leq p,m,t\leq 2r}}%
A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots i_{t}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert \left( x_{l_{1}}\cdots x_{l_{m}}\right) _{L}\left(
x_{i_{1}}\cdots x_{i_{t}}\right) \right\rangle _{\mathcal{A}} \\
& =\sum_{\substack{ 0\leq j_{1}<\cdots <j_{p}\leq 2r  \\ 0\leq l_{1}<\cdots
<l_{m}\leq 2r  \\ 0\leq i_{1}<\cdots <i_{t}\leq 2r  \\ 0\leq p,m,t\leq 2r}}%
A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots i_{t}}\left\vert x_{j_{1}}\cdots
x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{\mathcal{A}} \\
& =\sum_{\substack{ 0\leq l_{1}<\cdots <l_{m}\leq 2r  \\ 0\leq i_{1}<\cdots
<i_{t}\leq 2r  \\ 0\leq m,t\leq 2r}}A_{l_{1}\cdots l_{m}}B_{i_{1}\cdots
i_{t}}\left\vert x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle =\sum_{\substack{ 0\leq l_{1}<\cdots <l_{m}\leq 2r 
\\ 0\leq i_{1}<\cdots <i_{t}\leq 2r  \\ 0\leq m,t\leq 2r}}A_{l_{1}\cdots
l_{m}}B_{i_{1}\cdots i_{t}}x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots x_{i_{t}}
\end{align}

\paragraph{Orthogonal Projection Operators}

\begin{equation}
\left\vert \widetilde{x_{j_{1}}\cdots x_{j_{p}}}\right\rangle \left\langle 
\widetilde{x_{j_{1}}\cdots x_{j_{p}}}\right\vert \left\vert \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\rangle \left\langle \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\vert =\left\vert \widetilde{x_{j_{1}}\cdots
x_{j_{p}}}\right\rangle \left\langle \widetilde{x_{j_{1}}\cdots x_{j_{p}}}%
\right\vert \limfunc{tr}\left\{ \widetilde{x_{j_{p}}\cdots x_{j_{1}}}%
\widetilde{x_{j_{1}}\cdots x_{j_{p}}}\right\} =\left\vert \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\rangle \left\langle \widetilde{%
x_{j_{1}}\cdots x_{j_{p}}}\right\vert
\end{equation}%
are all projectors of the form

\begin{equation}
\sum_{0\leq p,q\leq2r}\left\vert \sum_{\substack{ 0\leq
j_{1}<\cdots<j_{p}\leq2r}}c_{j_{1}\cdots j_{p}}\widetilde{x_{j_{1}}\cdots
x_{j_{p}}}\right\rangle \left\langle \sum_{\substack{ 0\leq
k_{1}<\cdots<k_{q}\leq 2r}}c_{j_{1}\cdots j_{p}}\widetilde{x_{k_{1}}\cdots
x_{k_{q}}}\right\vert
\end{equation}
In particular 
\begin{equation}
f_{D}\left( \left\vert \widetilde{x_{j_{1}}x_{j_{2}}}\right\rangle
\left\langle \widetilde{x_{j_{1}}x_{j_{2}}}\right\vert \right) =\limfunc{tr}%
\left\{ \left\vert \widetilde{x_{j_{1}}x_{j_{2}}}\right\rangle \left\langle 
\widetilde{x_{j_{1}}x_{j_{2}}}\right\vert D\right\} =\left\langle \left. 
\widetilde{x_{j_{1}}x_{j_{2}}}\right\vert D\widetilde{x_{j_{1}}x_{j_{2}}}%
\right\rangle
\end{equation}

\subsection{Second Quantization of the Clifford Algebra $\mathcal{A}%
=\bigwedge \mathcal{A}_{1}$}

One can construct a basis of $\mathcal{L}\left( \mathcal{A}\right) $ from
second quantized operators $\left\{ \mathfrak{a}_{j}^{\dagger },\mathfrak{a}%
_{j};1\leq j\leq 2r\right\} $ defined by 
\begin{align}
\mathfrak{a}_{j}& =\left\vert I_{\mathcal{A}}\right\rangle \left\langle
x_{j}\right\vert +\sum_{1\leq N\leq \infty }\sum_{1\leq j\neq j_{1}<\cdots
<j_{N}\leq \infty }\left\vert x_{j_{1}}\cdots x_{j_{N}}\right\rangle
\left\langle x_{j}x_{j_{1}}\cdots x_{j_{N}}\right\vert  \notag \\
& =\sum_{0\leq N\leq \infty }\sum_{1\leq j\neq j_{1}<\cdots <j_{N}\leq
\infty }\left\vert x_{j_{1}}\cdots x_{j_{N}}\right\rangle \left\langle
x_{j}x_{j_{1}}\cdots x_{j_{N}}\right\vert  \notag \\
& =\sum_{0\leq N\leq \infty }\sum_{1\leq j_{1},\cdots ,j_{N}\leq \infty }%
\sqrt{\left( N+1\right) }\left\vert x_{j_{1}}\wedge \cdots \wedge
x_{j_{N}}\right\rangle \left\langle x_{j}\wedge x_{j_{1}}\wedge \cdots
\wedge x_{j_{N}}\right\vert ,
\end{align}%
where $\left\{ I_{\mathcal{A}},x_{j_{1}},\cdots ,x_{j_{2r}}\right\} $
generate $\mathcal{A}.$

\begin{align}
& \mathfrak{a}_{1}=\left\vert I_{\mathcal{A}}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}\right\vert +\left\vert x_{2}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{%
\mathcal{A}}\left\langle x_{1}x_{3}\right\vert +\left\vert
x_{2}x_{3}\right\rangle _{\mathcal{A}}\left\langle x_{1}x_{2}x_{3}\right\vert
\\
& \left( \mathfrak{a}_{1}\right) ^{2}= \\
& \left( \left\vert I_{\mathcal{A}}\right\rangle _{\mathcal{A}}\left\langle
x_{1}\right\vert +\left\vert x_{2}\right\rangle _{\mathcal{A}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}x_{3}\right\vert +\left\vert x_{2}x_{3}\right\rangle _{%
\mathcal{A}}\left\langle x_{1}x_{2}x_{3}\right\vert \right) \\
& \times \left( \left\vert I_{\mathcal{A}}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}\right\vert +\left\vert x_{2}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{%
\mathcal{A}}\left\langle x_{1}x_{3}\right\vert +\left\vert
x_{2}x_{3}\right\rangle _{\mathcal{A}}\left\langle
x_{1}x_{2}x_{3}\right\vert \right) =0
\end{align}%
and%
\begin{align}
\mathfrak{a}_{1}\mathfrak{a}_{2}& =\left( \left\vert I_{\mathcal{A}%
}\right\rangle _{\mathcal{A}}\left\langle x_{1}\right\vert +\left\vert
x_{2}\right\rangle _{\mathcal{A}}\left\langle x_{1}x_{2}\right\vert
+\left\vert x_{3}\right\rangle _{\mathcal{A}}\left\langle
x_{1}x_{3}\right\vert +\left\vert x_{2}x_{3}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}x_{2}x_{3}\right\vert \right) \\
& \left( \left\vert I_{\mathcal{A}}\right\rangle _{\mathcal{A}}\left\langle
x_{2}\right\vert +\left\vert x_{1}\right\rangle _{\mathcal{A}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}x_{3}\right\vert +\left\vert x_{1}x_{3}\right\rangle _{%
\mathcal{A}}\left\langle x_{1}x_{2}x_{3}\right\vert \right) \\
& =\left\vert I_{\mathcal{A}}\right\rangle _{\mathcal{A}}\left\langle
x_{1}x_{2}\right\vert +\left\vert x_{3}\right\rangle _{\mathcal{A}%
}\left\langle x_{1}x_{2}x_{3}\right\vert \\
& \Rightarrow \mathfrak{a}_{1}\mathfrak{a}_{2}=-\mathfrak{a}_{2}\mathfrak{a}%
_{1}.
\end{align}

The annihilation property

\begin{equation}
\mathfrak{a}_{k}\left\vert I_{\mathcal{A}}\right\rangle =0;1\leq k\leq 2r
\end{equation}%
wrt the vacuum state $\left\vert I_{\mathcal{A}}\right\rangle $ is
demonstrated by%
\begin{equation}
\mathfrak{a}_{k}\left\vert I_{\mathcal{A}}\right\rangle =\sum_{0\leq N\leq
\infty }\sum_{1\leq k\neq j_{1}<\cdots <j_{N}\leq \infty }\left\vert
x_{j_{1}}\cdots x_{j_{N}}\right\rangle _{\mathcal{A}}\left\langle
x_{k}x_{j_{1}}\cdots x_{j_{N}}\right\vert \left\vert I_{\mathcal{A}%
}\right\rangle =0,
\end{equation}%
as 
\begin{equation}
\left\langle x_{k}x_{j_{1}}\cdots x_{j_{N}}\left\vert I_{\mathcal{A}}\right.
\right\rangle =\limfunc{tr}\left\{ x_{k}x_{j_{1}}\cdots x_{j_{N}}\right\}
=\left\langle \left\langle x_{k}x_{j_{1}}\cdots x_{j_{N}}I_{\mathcal{A}%
}\right\rangle \right\rangle _{0}=0.
\end{equation}%
The creation property is demonstrated by 
\begin{equation}
\mathfrak{a}_{k}^{\dagger }\left\vert I_{\mathcal{A}}\right\rangle
=\left\vert x_{k}\right\rangle _{\mathcal{A}}\left\langle I_{\mathcal{A}%
}\right\vert \left\vert I_{\mathcal{A}}\right\rangle +\sum_{1\leq N\leq
\infty }\sum_{1\leq k\neq j_{1}<\cdots <j_{N}\leq \infty }\left\vert
x_{j}x_{j_{1}}\cdots x_{j_{N}}\right\rangle _{\mathcal{A}}\left\langle
x_{j_{1}}\cdots x_{j_{N}}\right\vert \left\vert I_{\mathcal{A}}\right\rangle
=\left\vert x_{k}\right\rangle
\end{equation}

$\lceil$%
\begin{align}
x_{j}\wedge x_{k} & =\frac{1}{2}\left[ x_{j},x_{k}\right] \\
\left\vert x_{j}\wedge x_{k}\right\rangle & =\sqrt{2}\left[ x_{j},x_{k}%
\right] =\frac{1}{\sqrt{2}}x_{j}\wedge x_{k}
\end{align}
$\rfloor$

The second quantization operators $\left\{ \mathfrak{a}_{j}^{\dagger },%
\mathfrak{a}_{j}\right\} $ can be considered as the images of the maps 
\begin{align}
\mathfrak{a}^{\dagger },\mathfrak{a}& :\mathcal{A}_{1}\rightarrow \mathcal{B}%
\left( \mathcal{A}\right) \\
\mathfrak{a}^{\dagger }\left( \sum_{1\leq j\leq 2r}\zeta _{j}x_{j}\right) &
=\sum_{1\leq j\leq 2r}\zeta _{j}\mathfrak{a}^{\dagger }\left( x_{j}\right)
=\sum_{1\leq j\leq 2r}\zeta _{j}\mathfrak{a}_{j}^{\dagger } \\
\mathfrak{a}\left( \sum_{1\leq j\leq 2r}\zeta _{j}x_{j}\right) &
=\sum_{1\leq j\leq 2r}\overline{\zeta }_{j}\mathfrak{a}\left( x_{j}\right)
=\sum_{1\leq j\leq 2r}\overline{\zeta }_{j}\mathfrak{a}_{j} \\
& \left\{ \left. \zeta _{j}\in \mathbb{C}\right\vert 1\leq j\leq 2r\right\} .
\end{align}

If one completes $\mathcal{A}_{0}$ in the trace norm one obtains the Hilbert
space $\mathcal{A}_{HS}$ and the operator norm can be defined in $\mathcal{L}%
\left( \mathcal{A}\right) $ to obtain the VNA\ algebra $\mathcal{B}\left( 
\mathcal{A}\right) $ and any operator $\mathfrak{A}$ in $\mathfrak{A}\equiv 
\mathcal{B}\left( \mathcal{A}\right) \equiv \tbigwedge \left( \mathfrak{A}%
_{1}\right) $ can be expanded as 
\begin{equation}
\mathfrak{A}=\sum_{1\leq p,q\leq 2r}\sum_{\substack{ 1\leq j_{1}<\cdots
<j_{p}\leq 2r  \\ 1\leq k_{1}<\cdots <k_{q}\leq 2r}}\mathfrak{A}_{\mathfrak{a%
}j_{1}\cdots j_{p}k_{q}\cdots k_{1}}\mathfrak{a}_{j_{1}}^{\dagger }\cdots 
\mathfrak{a}_{j_{p}}^{\dagger }\mathfrak{a}_{k_{1}}\cdots \mathfrak{a}%
_{k_{q}}=\sum_{0\leq p\leq 4r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 4r}%
\mathfrak{A}_{\mathfrak{x}j_{1}\cdots j_{p}k_{q}\cdots k_{1}}\mathfrak{x}%
_{j_{1}\cdots }.\mathfrak{x}_{j_{p}}.
\end{equation}%
$\mathfrak{A}$ contains as subalgebras the sets of left, right and mixed
multiplication operators formed by elements of $\mathcal{A}.$

The algebra, $\mathfrak{A},$ which is a Clifford algebra, is the universal
covering algebra of $O\left( 4r+1,\mathbb{C}\right) $ and contains, in
particular, representations of $O\left( 4r+1,\mathbb{C}\right) ,O\left( 4r,%
\mathbb{C}\right) $ as \emph{inner automorphisms} of $\mathfrak{A}\equiv 
\mathcal{B}\left( \mathcal{A}\right) .$

The group $O\left( 4r+1,\mathbb{C}\right) $ acts in an irreducible way on $%
\mathfrak{A}_{1}\oplus \mathfrak{A}_{2}$ i.e. 
\begin{equation}
O\left( 4r+1,\mathbb{C}\right) :\mathfrak{A}_{1}\oplus \mathfrak{A}%
_{2}\rightarrow \mathfrak{A}_{1}\oplus \mathfrak{A}_{2},
\end{equation}%
while $O\left( 4r,\mathbb{C}\right) $ is reducible 
\begin{align}
O\left( 4r,\mathbb{C}\right) & :\mathfrak{A}_{1}\rightarrow \mathfrak{A}_{1}
\\
O\left( 4r,\mathbb{C}\right) & :\mathfrak{A}_{2}\rightarrow \mathfrak{A}_{2}.
\end{align}%
It is trivial that 
\begin{align}
O\left( 4r+1,\mathbb{C}\right) & :\mathfrak{A}_{0}\rightarrow \mathfrak{A}%
_{0} \\
O\left( 4r,\mathbb{C}\right) & :\mathfrak{A}_{0}\rightarrow \mathfrak{A}_{0}.
\end{align}

The operators $\left\{ \mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k};1\leq
j,k\leq 2r\right\} $ form a basis for the Lie algebra $gl\left( 2r,\mathbb{C}%
\right) $ as 
\begin{align}
\left[ \mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k},\mathfrak{a}_{l}^{\dagger
}\mathfrak{a}_{m}\right] & =\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}%
\mathfrak{a}_{l}^{\dagger }\mathfrak{a}_{m}-\mathfrak{a}_{l}^{\dagger }%
\mathfrak{a}_{m}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}=\mathfrak{a}%
_{j}^{\dagger }\left( \delta _{kl}-\mathfrak{a}_{l}^{\dagger }\mathfrak{a}%
_{k}\right) \mathfrak{a}_{m}-\mathfrak{a}_{l}^{\dagger }\left( \delta _{mj}-%
\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{m}\right) \mathfrak{a}_{k} \\
& =\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{m}\delta _{kl}-\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{l}^{\dagger }\mathfrak{a}_{k}\mathfrak{a}_{m}-%
\mathfrak{a}_{l}^{\dagger }\mathfrak{a}_{k}\delta _{mj}+\mathfrak{a}%
_{l}^{\dagger }\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{m}\mathfrak{a}_{k} \\
& =\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{m}\delta _{kl}-\mathfrak{a}%
_{l}^{\dagger }\mathfrak{a}_{k}\delta _{mj}.
\end{align}%
After noting that 
\begin{align}
\left[ \mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k},\mathfrak{a}_{l}^{\dagger
}\right] & =\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\mathfrak{a}%
_{l}^{\dagger }-\mathfrak{a}_{l}^{\dagger }\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}=\mathfrak{a}_{j}^{\dagger }\left( \delta _{kl}-\mathfrak{a}%
_{l}^{\dagger }\mathfrak{a}_{k}\right) -\mathfrak{a}_{l}^{\dagger }\mathfrak{%
a}_{j}^{\dagger }\mathfrak{a}_{k}=\mathfrak{a}_{j}^{\dagger }\delta _{kl} \\
\left[ \mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k},\mathfrak{a}_{l}\right] &
=\left( \left( \left[ \mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k},\mathfrak{a%
}_{l}\right] \right) ^{\dagger }\right) ^{\dagger }=\left( \left[ \mathfrak{a%
}_{l}^{\dagger },\mathfrak{a}_{k}^{\dagger }\mathfrak{a}_{j}\right] \right)
^{\dagger }=\left( -\mathfrak{a}_{k}^{\dagger }\delta _{jl}\right) ^{\dagger
}=-\mathfrak{a}_{k}\delta _{jl}
\end{align}%
one observes%
\begin{align}
& \exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}^{\dagger }\exp
\left\{ -\tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}\right\} \\
& =\left( I+\tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}+\frac{1}{2}\left( \tsum\limits_{1\leq j,k\leq 2r}z_{jk}%
\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\right) ^{2}+\cdots \right) 
\mathfrak{a}_{l}^{\dagger } \\
& \times \left( I-\tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}+\frac{1}{2}\left( \tsum\limits_{1\leq
j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\right)
^{2}+\cdots \right) \\
& =\exp \left\{ adj\left( \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}\right) \right\} \mathfrak{a}_{l}^{\dagger
}=\exp \left\{ \left[ \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k},\right] \right\} \mathfrak{a}_{l}^{\dagger
}=\exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\delta _{kl}\right\} \\
& =\mathfrak{a}_{l}^{\dagger }+\tsum\limits_{1\leq j,k\leq 2r}z_{jk}\left[ 
\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k},\mathfrak{a}_{l}^{\dagger }%
\right] +\frac{1}{2}\tsum\limits_{\substack{ 1\leq j_{1},j_{2}\leq 2r  \\ %
1\leq k_{1},k_{2}\leq 2r}}z_{j_{1}k_{1}}z_{j_{2}k_{2}}\left[ \mathfrak{a}%
_{j_{2}}^{\dagger }\mathfrak{a}_{k_{2}},\left[ \mathfrak{a}_{j_{1}}^{\dagger
}\mathfrak{a}_{k_{1}},\mathfrak{a}_{l}^{\dagger }\right] \right] \\
& +\frac{1}{3!}\tsum\limits_{\substack{ 1\leq j_{1},j_{2}\leq 2r  \\ 1\leq
k_{1},k_{2}\leq 2r}}z_{j_{1}k_{1}}z_{j_{2}k_{2}}z_{j_{3}k_{3}}\left[ 
\mathfrak{a}_{j_{3}}^{\dagger }\mathfrak{a}_{k_{3}},\left[ \mathfrak{a}%
_{j_{2}}^{\dagger }\mathfrak{a}_{k_{2}},\left[ \mathfrak{a}_{j_{1}}^{\dagger
}\mathfrak{a}_{k_{1}},\mathfrak{a}_{l}^{\dagger }\right] \right] \right]
+\cdots \\
& =\mathfrak{a}_{l}^{\dagger }+\tsum\limits_{1\leq j_{1}\leq 2r}z_{j_{1}l}%
\mathfrak{a}_{j_{1}}^{\dagger }+\frac{1}{2}\tsum\limits_{\substack{ 1\leq
j_{1},j_{2}\leq 2r  \\ 1\leq k_{2}\leq 2r}}z_{j_{1}l}z_{j_{2}k_{2}}\left[ 
\mathfrak{a}_{j_{2}}^{\dagger }\mathfrak{a}_{k_{2}},\mathfrak{a}%
_{j_{1}}^{\dagger }\right] \\
& +\frac{1}{3!}\tsum\limits_{\substack{ 1\leq j_{1},j_{2},j_{3}\leq 2r  \\ %
1\leq k_{2},k_{3}\leq 2r}}z_{j_{1}l}z_{j_{2}k_{2}}z_{j_{3}k_{3}}\left[ 
\mathfrak{a}_{j_{3}}^{\dagger }\mathfrak{a}_{k_{3}},\left[ \mathfrak{a}%
_{j_{2}}^{\dagger }\mathfrak{a}_{k_{2}},\mathfrak{a}_{j_{1}}^{\dagger }%
\right] \right] +\cdots \\
& =\mathfrak{a}_{l}^{\dagger }+\tsum\limits_{1\leq j_{1}\leq 2r}z_{j_{1}l}%
\mathfrak{a}_{j_{1}}^{\dagger }+\frac{1}{2}\tsum\limits_{1\leq
j_{1},j_{2}\leq 2r}z_{j_{1}l}z_{j_{2}j_{1}}\mathfrak{a}_{j_{2}}^{\dagger }+%
\frac{1}{3!}\tsum\limits_{1\leq j_{1},j_{2},j_{3}\leq
2r}z_{j_{1}l}z_{j_{2}j_{1}}z_{j_{3}j_{2}}\mathfrak{a}_{j_{3}}^{\dagger
}+\cdots \\
& =\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}_{j_{1}}^{\dagger }\left( e^{%
\mathbf{Z}}\right) _{j_{1}l}
\end{align}

i.e. 
\begin{align}
& \exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}^{\dagger }\exp
\left\{ -\tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}\right\} =\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}%
_{j_{1}}^{\dagger }\left( e^{\mathbf{Z}}\right) _{j_{1}l} \\
& \mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{l}^{\dagger }\mathfrak{g%
}\left( \mathbf{z}\right) ^{-1}=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}%
_{j_{1}}^{\dagger }\left( e^{\mathbf{Z}}\right)
_{j_{1}l}=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}_{j_{1}}^{\dagger }%
\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}\right) \right) _{j_{1}l},
\end{align}%
where 
\begin{align}
\mathfrak{g}\left( \mathbf{z}\right) & =\exp \left\{ \tsum\limits_{1\leq
j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\right\} \\
\mathfrak{g}\left( -\mathbf{z}\right) & =\exp \left\{ -\tsum\limits_{1\leq
j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\right\} =%
\mathfrak{g}\left( \mathbf{z}\right) ^{-1}
\end{align}%
The adjoint of this gives 
\begin{eqnarray}
\mathfrak{g}\left( \mathbf{z}\right) ^{\dagger } &=&\exp \left\{
\tsum\limits_{1\leq j,k\leq 2r}\overline{z}_{jk}\mathfrak{a}_{k}^{\dagger }%
\mathfrak{a}_{j}\right\} =\exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}%
\overline{z}_{kj}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\right\} =\exp
\left\{ \tsum\limits_{1\leq j,k\leq 2r}\overline{z}_{kj}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}\right\} \\
&=&\exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}\left( \mathbf{z}^{\dagger
}\right) _{kj}\mathfrak{a}_{k}^{\dagger }\mathfrak{a}_{j}\right\} =\mathfrak{%
g}\left( \mathbf{z}^{\dagger }\right) ,
\end{eqnarray}%
leading to 
\begin{align}
& \mathfrak{g}\left( \mathbf{z}\right) ^{-\dagger }\mathfrak{a}_{l}\mathfrak{%
g}\left( \mathbf{z}\right) ^{\dagger }=\left( \exp \left\{
\tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}%
_{k}\right\} \mathfrak{a}_{l}^{\dagger }\exp \left\{ -\tsum\limits_{1\leq
j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}_{k}\right\} \right)
^{\dagger } \\
& =\exp \left\{ -\tsum\limits_{1\leq j,k\leq 2r}\overline{z}_{jk}\mathfrak{a}%
_{k}^{\dagger }\mathfrak{a}_{j}\right\} \mathfrak{a}_{l}\exp \left\{
\tsum\limits_{1\leq j,k\leq 2r}\overline{z}_{jk}\mathfrak{a}_{k}^{\dagger }%
\mathfrak{a}_{j}\right\} \\
& =\exp \left\{ -\tsum\limits_{1\leq j,k\leq 2r}\left( \mathbf{z}^{\dagger
}\right) _{kj}\mathfrak{a}_{k}^{\dagger }\mathfrak{a}_{j}\right\} \mathfrak{a%
}_{l}\exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}\left( \mathbf{z}^{\dagger
}\right) _{kj}\mathfrak{a}_{k}^{\dagger }\mathfrak{a}_{j}\right\}
=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}_{j_{1}}\overline{\left( e^{%
\mathbf{z}}\right) }_{j_{1}l}=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}%
_{j_{1}}\overline{\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}\right)
\right) }_{j_{1}l} \\
& \equiv \exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}\exp \left\{
\tsum\limits_{1\leq j,k\leq 2r}-z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}%
_{k}\right\} =\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}_{j_{1}}\left(
e^{-\mathbf{z}^{\dagger }}\right) _{j_{1}l}
\end{align}%
i.e. 
\begin{align}
& \exp \left\{ \tsum\limits_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}\right\} \mathfrak{a}_{l}\exp \left\{
\tsum\limits_{1\leq j,k\leq 2r}-z_{jk}\mathfrak{a}_{j}^{\dagger }\mathfrak{a}%
_{k}\right\} =\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}_{j_{1}}\left(
e^{-\mathbf{z}^{\dagger }}\right) _{j_{1}l} \\
& \mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{l}\mathfrak{g}\left( 
\mathbf{z}\right) ^{-1}=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}%
_{j_{1}}\left( e^{-\mathbf{z}^{\dagger }}\right)
_{j_{1}l}=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}_{j_{1}}\mathcal{R}%
_{a}\left( \mathfrak{g}\left( -\mathbf{z}^{\dagger }\right) \right)
_{j_{1}l}.
\end{align}%
This gives 
\begin{align}
& \mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{l}^{\dagger }\mathfrak{a%
}_{k}\mathfrak{g}\left( \mathbf{z}\right) ^{-1}=\mathfrak{g}\left( \mathbf{z}%
\right) \mathfrak{a}_{l}^{\dagger }\mathfrak{g}\left( \mathbf{z}\right) ^{-1}%
\mathfrak{g}\left( \mathbf{z}\right) \mathfrak{a}_{k}\mathfrak{g}\left( 
\mathbf{z}\right) ^{-1}=\tsum\limits_{1\leq j_{1}\leq 2r}\mathfrak{a}%
_{j_{1}}^{\dagger }\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}%
\right) \right) _{j_{1}l}\tsum\limits_{1\leq j_{2}\leq 2r}\mathfrak{a}%
_{j_{2}}\mathcal{R}_{a}\left( \mathfrak{g}\left( -\mathbf{z}^{\dagger
}\right) \right) _{j_{2}k} \\
& =\tsum\limits_{1\leq j_{1},j_{2}\leq 2r}\mathfrak{a}_{j_{1}}^{\dagger }%
\mathfrak{a}_{j_{2}}\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}%
\right) \right) _{j_{1}l}\mathcal{R}_{a}\left( \mathfrak{g}\left( -\mathbf{z}%
^{\dagger }\right) \right) _{j_{2}k}=\tsum\limits_{1\leq j_{1},j_{2}\leq 2r}%
\mathcal{R}_{a}\left( \mathfrak{g}\left( \mathbf{z}\right) \right)
_{lj_{1}}^{t}\mathfrak{a}_{j_{1}}^{\dagger }\mathfrak{a}_{j_{2}}\mathcal{R}%
_{a}\left( \mathfrak{g}\left( -\mathbf{z}^{\dagger }\right) \right)
_{j_{2}k}.
\end{align}%
$\lceil $From the preceding 
\begin{equation}
T\mathfrak{a}_{l}^{\dagger }T^{-1}=\tsum\limits_{1\leq i\leq 2r}\mathfrak{a}%
_{i}^{\dagger }T_{il}=\tsum\limits_{1\leq i\leq 2r}\mathfrak{a}_{i}^{\dagger
}\mathcal{R}_{a}\left( T\right) _{il}
\end{equation}%
\begin{equation}
T^{-\dagger }\mathfrak{a}_{k}T^{\dagger }=\tsum\limits_{1\leq j\leq 2r}%
\mathfrak{a}_{j}\overline{T}_{jk}\Rightarrow T\mathfrak{a}%
_{l}T^{-1}=\tsum\limits_{1\leq j\leq 2r}\mathfrak{a}_{j}T_{jk}^{-\dagger }
\end{equation}%
\begin{align}
T\mathfrak{a}_{l}^{\dagger }\mathfrak{a}_{k}T^{-1}& =T\mathfrak{a}%
_{l}^{\dagger }T^{-1}T\mathfrak{a}_{k}T^{-1}=\tsum\limits_{1\leq i\leq 2r}%
\mathfrak{a}_{i}^{\dagger }T_{il}\tsum\limits_{1\leq j\leq 2r}\mathfrak{a}%
_{j}T_{jk}^{-\dagger } \\
& =\tsum\limits_{1\leq i,j\leq 2r}\mathfrak{a}_{i}^{\dagger }\mathfrak{a}%
_{j}T_{il}T_{jk}^{-\dagger }=\tsum\limits_{1\leq i,j\leq 2r}T_{li}^{t}%
\mathfrak{a}_{i}^{\dagger }\mathfrak{a}_{j}T_{jk}^{-\dagger }
\end{align}%
$\rfloor $

Thus 
\begin{align}
GL\left( 2r,\mathbb{C}\right) & :\mathfrak{A}_{+}\rightarrow \mathfrak{A}_{+}
\\
GL\left( 2r,\mathbb{C}\right) & :\mathfrak{A}_{-}\rightarrow \mathfrak{A}_{-}
\\
\mathfrak{A}_{1}& =\mathfrak{A}_{+}\oplus \mathfrak{A}_{-}.
\end{align}%
This group does not leave invariant real decompositions via inner
automorphisms as can be seen by considering 
\begin{equation}
\mathfrak{g}\left( \mathbf{z}\right) \left( \mathfrak{a}_{j}^{\dagger }+%
\mathfrak{a}_{j}\right) \mathfrak{g}\left( \mathbf{z}\right)
^{-1}=\tsum\limits_{1\leq j_{1}\leq 2r}\left\{ \mathfrak{a}_{j_{1}}^{\dagger
}\left( e^{\mathbf{z}}\right) _{j_{1}j}+\mathfrak{a}_{j_{1}}\left( e^{-%
\mathbf{z}^{\dagger }}\right) _{j_{1}j}\right\} ,
\end{equation}%
which only equals 
\begin{equation}
\tsum\limits_{1\leq j_{1}\leq 2r}\left\{ \mathfrak{a}_{j_{1}}^{\dagger }+%
\mathfrak{a}_{j_{1}}\right\} \left( e^{\mathbf{z}}\right) _{j_{1}j}
\end{equation}%
if 
\begin{equation}
\mathbf{z=}-\mathbf{z}^{\dagger },
\end{equation}%
i.e. 
\begin{equation}
\mathfrak{g}\left( \mathbf{z}\right) \in U\left( 2r\right) ,
\end{equation}%
which are star inner automorphism's, while $\mathfrak{g}\left( \mathbf{z}%
\right) \left( \mathfrak{a}_{j}^{\dagger }+\mathfrak{a}_{j}\right) \mathfrak{%
g}\left( \mathbf{z}\right) ^{-1}$ are inner automorhisms but not star ones.
However $\mathfrak{g}\left( \mathbf{z}\right) \left( \mathfrak{a}%
_{j}^{\dagger }+\mathfrak{a}_{j}\right) \mathfrak{g}\left( \mathbf{z}\right)
^{-1}\in \mathcal{F}.$ ??The groups $GL\left( 2r,\mathbb{R}\right) $ and $%
Sp\left( 2r,\mathbb{R}\right) $ do not leave invariant real decompositions
via inner automorphisms, though $O\left( 2r,\mathbb{R}\right) $ does??.

The action of $O\left( 4r+1,\mathbb{C}\right) $ on $\mathcal{A}_{\left(
2\right) }$ is given by 
\begin{align}
& \exp \left\{ \sum_{1\leq j<k\leq 2r}\left( z_{+jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}^{\dagger }+z_{-jk}\mathfrak{a}_{j}\mathfrak{a%
}_{k}\right) +\sum_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}+\sum_{1\leq j\leq 2r}\left( z_{+j}\mathfrak{a}_{j}^{\dagger
}\mathfrak{+}z_{-j}\mathfrak{a}_{j}\right) +zI_{\mathcal{F}}\right\} A\times
\\
& \exp \left\{ -\sum_{1\leq j<k\leq 2r}\left( z_{+jk}\mathfrak{a}%
_{j}^{\dagger }\mathfrak{a}_{k}^{\dagger }+z_{-jk}\mathfrak{a}_{j}\mathfrak{a%
}_{k}\right) +\sum_{1\leq j,k\leq 2r}z_{jk}\mathfrak{a}_{j}^{\dagger }%
\mathfrak{a}_{k}+\sum_{1\leq j\leq 2r}\left( z_{+j}\mathfrak{a}_{j}^{\dagger
}\mathfrak{+}z_{-j}\mathfrak{a}_{j}\right) +zI_{\mathcal{F}}\right\} =B \\
& A,B\in \mathcal{F}_{\left( 2\right) }
\end{align}%
The representation matrices wrt to the real basis $\left\{ I_{\mathcal{A}%
},\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\} ,\left\{ \left.
x_{j}x_{k}\right\vert 1\leq j<k\leq 2r\right\} \right\} $ are of the form 
\begin{align}
T\left( I_{\mathcal{A}},\mathbf{x,x\wedge x}\right) & =\left( I_{\mathcal{A}%
},\mathbf{x,x\wedge x}\right) \mathcal{R}_{x}\left( T\right) \\
\mathcal{R}_{x}\left( T\right) & =\left( 
\begin{array}{ccc}
\overset{\underset{\leftrightarrow }{1}}{\alpha } & \overset{\underset{%
\leftrightarrow }{2r}}{\mathbf{\beta }} & \overset{\underset{\leftrightarrow 
}{r\left( 2r-1\right) }}{\mathbf{\gamma }} \\ 
\mathbf{\delta } & \mathbf{\varepsilon } & \mathbf{\zeta } \\ 
\epsilon & \mathbf{\eta } & \mathbf{\theta }%
\end{array}%
\right) \\
T& =\sum \left\{ \left\vert x_{j}\right\rangle \left\langle x_{k}\right\vert
\varepsilon _{jk}+\left\vert x_{j}x_{k}\right\rangle \left\langle
x_{l}x_{m}\right\vert \theta _{jklm}+\left\vert x_{j}\right\rangle
\left\langle x_{l}x_{m}\right\vert \zeta _{jlm}+\left\vert
x_{j}x_{k}\right\rangle \left\langle x_{l}\right\vert \eta _{jkl}\right. \\
& \left. +\left\vert I_{\mathcal{F}}\right\rangle \left\langle
x_{k}\right\vert \delta _{k}+\left\vert x_{j}\right\rangle \left\langle I_{%
\mathcal{F}}\right\vert \beta _{j}+\left\vert I_{\mathcal{F}}\right\rangle
\left\langle x_{l}x_{m}\right\vert \gamma _{lm}\left\vert
x_{j}x_{k}\right\rangle \left\langle I_{\mathcal{F}}\right\vert \epsilon
_{jk}\right\} +\left\vert I_{\mathcal{A}}\right\rangle \left\langle I_{%
\mathcal{A}}\right\vert \alpha
\end{align}

The group $GL\left( 4r,\mathbb{C}\right) $ is reducibly represented on $%
\mathfrak{F}\equiv \mathcal{B}\left( \mathcal{A}\right) \equiv \tbigwedge 
\mathfrak{A}_{1}$ as 
\begin{equation}
GL\left( 4r,\mathbb{C}\right) :\tbigwedge\nolimits^{n}\mathfrak{A}%
_{1}\rightarrow \tbigwedge\nolimits^{n}\mathfrak{A}_{1}.
\end{equation}

\subsubsection{Symplectic Group $Sp\left( 2r,\mathbb{C}\right) $}

Every element $g\in \mathcal{A}_{2}$ induces a complex antisymmetric
bilinear forms 
\begin{align}
g& :\mathcal{A}_{1}\times \mathcal{A}_{1}\rightarrow \mathbb{C} \\
g\left( v_{1},v_{2}\right) & =-g\left( v_{2},v_{1}\right)
\end{align}%
by the hermitian inner product%
\begin{equation}
g_{h}\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{ g^{\dagger }\left(
v_{1}\wedge v_{2}\right) \right\} =\left\langle \left. g\right\vert
v_{1}\wedge v_{2}\right\rangle _{\mathcal{A}}=\left\langle \left\langle
g^{\dagger }\left( v_{1}\wedge v_{2}\right) \right\rangle \right\rangle _{0},
\end{equation}%
by the complex symmetric inner product 
\begin{equation}
g_{a}\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{ g^{t}\left( v_{1}\wedge
v_{2}\right) \right\} =\left( \left. g\right\vert v_{1}\wedge v_{2}\right) _{%
\mathcal{A}}=\left\langle \left\langle g^{t}\left( v_{1}\wedge v_{2}\right)
\right\rangle \right\rangle _{0}
\end{equation}%
or by 
\begin{equation}
g\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{ g\left( v_{1}\wedge
v_{2}\right) \right\} =\left\langle \left\langle g\left( v_{1}\wedge
v_{2}\right) \right\rangle \right\rangle _{0}.
\end{equation}%
The forms $g,g_{h},g_{a}$ are determined by their values on the orthonormal
basis $\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\} $ i.e. 
\begin{align}
& g_{h}\left( x_{j},x_{k}\right) =\left\langle \left\langle g^{\dagger
}\left( x_{j}\wedge x_{k}\right) \right\rangle \right\rangle _{0}=\frac{1}{2}%
\sum_{1\leq l\neq m\leq 2r}\bar{g}_{lm}\left\langle \left\langle
x_{m}x_{l}x_{j}x_{k}\right\rangle \right\rangle _{0} \\
& =\frac{1}{2}\sum_{1\leq l\neq m\leq 2r}\bar{g}_{lm}\left( \delta
_{km}\delta _{lj}-\delta _{jm}\delta _{lk}\right) =\frac{1}{2}\left( \bar{g}%
_{jk}-\bar{g}_{kj}\right) =\bar{g}_{jk} \\
& g_{a}\left( x_{j},x_{k}\right) =g_{jk} \\
& g\left( x_{j},x_{k}\right) =-g_{jk}
\end{align}%
One can define an injection 
\begin{equation}
M:\mathcal{A}_{2}\rightarrow \mathcal{B}\left( \mathcal{A}_{1}\right)
\end{equation}%
\begin{equation*}
g=\sum_{1\leq j<k\leq 2r}g_{jk}x_{j}\wedge x_{k}=\sum_{1\leq j<k\leq
2r}g_{jk}x_{j}x_{k}\longleftrightarrow M\left( g\right) =\frac{1}{2}%
\sum_{1\leq j,k\leq 2r}g_{jk}\left\vert x_{j}\right\rangle _{\mathcal{A}%
}\left\langle x_{k}\right\vert ;g_{kj}=-g_{jk},1\leq j\leq k\leq 2r,
\end{equation*}%
such that 
\begin{equation}
\left\langle \left. x_{j}\right\vert M\left( g\right) x_{k}\right\rangle _{%
\limfunc{tr}}=g_{jk}=g_{a}\left( x_{j},x_{k}\right) .
\end{equation}%
$\lceil $%
\begin{align}
\left\langle \left. g\right\vert h\right\rangle _{\mathcal{A}}& =\frac{1}{4}%
\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}\overline{g}%
_{jk}h_{lm}\left\langle \left\langle x_{k}x_{j}x_{l}x_{m}\right\rangle
\right\rangle _{0}=\frac{1}{4}\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq
l,m\leq 2r}}\overline{g}_{jk}h_{lm}\left( \delta _{jl}\delta _{km}-\delta
_{jm}\delta _{kl}\right) \\
& =\sum_{_{1\leq j<k\leq 2r}}\overline{g}_{jk}h_{jk}=\mathbf{g}^{\dagger }%
\mathbf{h} \\
& =\frac{1}{2}\sum_{_{1\leq j,k\leq 2r}}\overline{g}_{jk}h_{jk}=\frac{1}{2}%
\sum_{_{1\leq j,k\leq 2r}}\mathbb{G}_{kj}^{\dagger }h_{jk}=\frac{1}{2}\func{%
Tr}\left\{ \mathbb{G}^{\dagger }\mathbb{H}\right\}
\end{align}%
\begin{align}
\left( \left. g\right\vert h\right) _{\mathcal{A}}& =\frac{1}{4}\sum 
_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}g_{jk}h_{lm}\left\langle
x_{k}x_{j}x_{l}x_{m}\right\rangle _{0}=\frac{1}{4}\sum_{\substack{ 1\leq
j,k\leq 2r  \\ 1\leq l,m\leq 2r}}g_{jk}h_{lm}\left( \delta _{jl}\delta
_{km}-\delta _{jm}\delta _{kl}\right) \\
& =\sum_{_{1\leq j<k\leq 2r}}g_{jk}h_{jk}=\mathbf{g}^{t}\mathbf{h} \\
& =\frac{1}{2}\sum_{_{1\leq j,k\leq 2r}}g_{jk}h_{jk}=\frac{1}{2}%
\sum_{_{1\leq j,k\leq 2r}}\mathbb{G}_{kj}^{t}h_{jk}=\frac{1}{2}\func{Tr}%
\left\{ \mathbb{G}^{t}\mathbb{H}\right\}
\end{align}%
\begin{align}
& g_{h}\left( v_{1},v_{2}\right) =\left\langle \left. g\right\vert
v_{1}\wedge v_{2}\right\rangle _{\mathcal{A}}=\frac{1}{2}\sum_{\substack{ %
1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}\overline{g}_{kj}v_{1l}v_{2m}\left%
\langle \left\langle x_{j}x_{k}x_{l}x_{m}\right\rangle \right\rangle _{0} \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}%
\overline{g}_{kj}v_{1l}v_{2m}\left( \delta _{jm}\delta _{kl}-\delta
_{jl}\delta _{km}\right) =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq 2r  \\ %
1\leq l,m\leq 2r}}\left( \overline{g}_{kj}v_{1k}v_{2j}-\overline{g}%
_{kj}v_{1j}v_{2k}\right) \\
& =\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}v_{1k}\overline{g}%
_{kj}v_{2j}=\mathbf{v}_{1}^{t}\overline{\mathbb{G}}\mathbf{v}_{2}
\end{align}%
\begin{align}
g_{a}\left( v_{1},v_{2}\right) & =\left( \left. g\right\vert v_{1}\wedge
v_{2}\right) _{\mathcal{A}}=\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq 2r  \\ %
1\leq l,m\leq 2r}}g_{kj}v_{1l}v_{2m}\left\langle \left\langle
x_{j}x_{k}x_{l}x_{m}\right\rangle \right\rangle _{0} \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}%
g_{kj}v_{1l}v_{2m}\left( \delta _{jm}\delta _{kl}-\delta _{jl}\delta
_{km}\right) =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq
2r}}\left( g_{kj}v_{1k}v_{2j}-g_{kj}v_{1j}v_{2k}\right) \\
& =\sum_{\substack{ 1\leq j,k\leq 2r  \\ 1\leq l,m\leq 2r}}%
v_{1k}g_{kj}v_{2j}=\mathbf{v}_{1}^{t}\mathbb{G}\mathbf{v}_{2}
\end{align}%
$\rfloor $

The complex antisymmetric matrix 
\begin{equation}
\mathbb{G}\equiv\left\{ \left. g_{jk}\right\vert 1\leq j,k\leq2r\right\}
\end{equation}
\emph{cannot} always be diagonalized, unless it is real, though it always
has eigenvalues $\left\{ \left. 0,\lambda_{j},-\lambda_{j}\right\vert 1\leq
j\leq2p\right\} .$

A realization of $Sp\left( 2r,\mathbb{C}\right) $ is given by 
\begin{align}
Sp\left( 2r,\mathbb{C}\right) & \cong \left\{ \left. T\in \mathcal{B}\left( 
\mathcal{A}_{1}\right) \right\vert g_{a}\left( T\left( v_{1}\right) ,T\left(
v_{2}\right) \right) =g_{a}\left( v_{1},v_{2}\right) =\limfunc{tr}\left\{
g^{t}\left( T\left( v_{1}\right) \right) \wedge \left( T\left( v_{2}\right)
\right) \right\} \right. \\
& \left. =\left\langle g^{t}\left( T\left( v_{1}\right) \right) \wedge
\left( T\left( v_{2}\right) \right) \right\rangle _{0}=\left( \left.
g\right\vert v_{1}\wedge v_{2}\right) _{\mathcal{A}}\right\}
\end{align}%
$\lceil $One should check 
\begin{align}
T& \notin \limfunc{Inn}\left\{ \mathcal{A}\right\} \\
T\left( v_{1}\right) & \neq tv_{1}t^{-1}
\end{align}%
\begin{align}
\left( T\wedge T\right) \left( v_{1}\wedge v_{2}\right) & =\left(
Tv_{1}\right) \wedge \left( Tv_{2}\right) \\
\text{ is it possible }\left( T\wedge T\right) & \notin \mathcal{A},\text{
but }\left( T\wedge T\right) \left( g\right) =tgt^{t}.
\end{align}%
$\rfloor $%
\begin{equation}
\wedge ^{2}:\mathcal{B}\left( \mathcal{A}_{1}\right) \rightarrow \mathcal{B}%
\left( \mathcal{A}_{2}\right)
\end{equation}%
\begin{equation*}
\left( \wedge ^{2}T\right) \left( v_{1}\wedge v_{2}\right) =\left(
T\boxtimes T\right) \left( v_{1}\wedge v_{2}\right) =\left( Tv_{1}\right)
\wedge \left( Tv_{2}\right)
\end{equation*}%
\begin{align}
\left( \wedge ^{2}T\right) & =T\boxtimes T:\mathcal{A}_{2}\rightarrow 
\mathcal{A}_{2} \\
& \equiv \left( \wedge ^{2}T\right) =T\boxtimes T\in \mathcal{B}\left( 
\mathcal{A}_{2}\right) \\
& \equiv \left( \wedge ^{2}T\right) =T\boxtimes T\in \mathcal{B}\left( 
\mathcal{B}\left( \mathcal{A}_{1}\right) \right)
\end{align}

\paragraph{Various formulations of evaluations of transformed $g$}

\begin{equation}
\left( \left. g\right\vert \left( Tv_{1}\right) \wedge \left( Tv_{2}\right)
\right) _{\mathcal{A}}=\left( \left. g\right\vert \left( T\boxtimes T\right)
\left( v_{1}\wedge v_{2}\right) \right) _{\mathcal{A}}=\left( \left. \left(
T\boxtimes T\right) ^{t}g\right\vert \left( v_{1}\wedge v_{2}\right) \right)
_{\mathcal{A}}
\end{equation}

\subparagraph{Matrix Product Form}

\begin{align}
& \left( \left. g\right\vert \left( Tv_{1}\right) \wedge \left(
Tv_{2}\right) \right) _{\mathcal{A}}=\limfunc{tr}\left\{ g^{t}\left(
Tv_{1}\right) \wedge \left( Tv_{2}\right) \right\} =\frac{1}{2}\sum 
_{\substack{ 1\leq j,k,l,m\leq 2r  \\ j\neq k,l\neq m}}\mathcal{R}_{x}\left(
g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{l}\mathcal{R}_{x}\left(
Tv_{2}\right) _{m}\left\langle x_{k}x_{j}x_{l}x_{m}\right\rangle _{0} \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k,l,m\leq 2r  \\ j\neq k,l\neq m}}%
\mathcal{R}_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{l}%
\mathcal{R}_{x}\left( Tv_{2}\right) _{m}\left( \delta _{km}\delta
_{jl}-\delta _{kl}\delta _{jm}\right) \\
& =\frac{1}{2}\sum_{\substack{ 1\leq j,k\leq 2r  \\ j\neq k}}\left\{ 
\mathcal{R}_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{j}%
\mathcal{R}_{x}\left( Tv_{2}\right) _{k}-\mathcal{R}_{x}\left( g\right) _{jk}%
\mathcal{R}_{x}\left( Tv_{1}\right) _{k}\mathcal{R}_{x}\left( Tv_{2}\right)
_{j}\right\} \\
& =\frac{1}{2}\sum_{1\leq j,k\leq 2r}\left\{ \mathcal{R}_{x}\left(
Tv_{1}\right) _{j}\mathcal{R}_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left(
Tv_{2}\right) _{k}-\mathcal{R}_{x}\left( Tv_{2}\right) _{j}\mathcal{R}%
_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{1}\right) _{k}\right\} \\
& =\sum_{1\leq j,k\leq 2r}\mathcal{R}_{x}\left( Tv_{1}\right) _{j}\mathcal{R}%
_{x}\left( g\right) _{jk}\mathcal{R}_{x}\left( Tv_{2}\right) _{k}=\mathcal{R}%
_{x}\left( Tv_{1}\right) ^{t}\mathcal{R}_{x}\left( g\right) \mathcal{R}%
_{x}\left( Tv_{2}\right) \\
& =\mathcal{R}_{x}\left( v_{1}\right) ^{t}\mathcal{R}_{x}\left( T\right) ^{t}%
\mathcal{R}_{x}\left( g\right) \mathcal{R}_{x}\left( T\right) \mathcal{R}%
_{x}\left( v_{2}\right) ,
\end{align}%
where the connection with the dot product form is given by 
\begin{align}
& \left( \mathcal{R}_{x}\left( T\right) ^{t}\mathcal{R}_{x}\left( g\right) 
\mathcal{R}_{x}\left( T\right) \right) _{jk}=\frac{1}{2}\sum_{1\leq l,m\leq
2r}\mathcal{R}_{x}\left( T\right) _{jl}^{t}\mathcal{R}_{x}\left( g\right)
_{lm}\mathcal{R}_{x}\left( T\right) _{mk} \\
& =\sum_{1\leq j<l\leq 2r}\left( \mathcal{R}_{x}\left( T\boxtimes T\right)
\right) _{jklm}\mathcal{R}_{x}\left( g\right) _{lm}=\sum_{1\leq j<l\leq
2r}\left( \mathcal{R}_{x}\left( \wedge ^{2}T\right) \right) _{jklm}\mathcal{R%
}_{x}\left( g\right) _{lm}.
\end{align}%
The representation of the antisymmetric operator tensor product is given by 
\begin{align}
& TgT^{t}=\frac{1}{4}\sum_{\substack{ 1\leq j,k,l,m\leq 2r  \\ j\neq l,k\neq
m }}\mathcal{R}_{x}\left( T\right) _{kj}g_{jl}\mathcal{R}_{x}\left( T\right)
_{lm}x_{k}x_{m}=\frac{1}{4}\sum_{\substack{ 1\leq j,k,l,m\leq 2r  \\ j\neq
l,k\neq m}}\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left(
T\right) _{lm}g_{jl}x_{k}x_{m} \\
& =\frac{1}{4}\sum_{\substack{ 1\leq j,k,l,m\leq 2r  \\ j\neq l,k\neq m}}%
\mathcal{R}_{x}\left( T\right) _{kj}g_{jl}\mathcal{R}_{x}\left( T\right)
_{lm}x_{k}x_{m} \\
& =\frac{1}{4}\sum_{\substack{ 1\leq k<m\leq 2r  \\ 1\leq j<l\leq 2r}}\left( 
\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left( T\right) _{lm}-%
\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}_{x}\left( T\right) _{lk}-%
\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( T\right) _{jm}+%
\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left( T\right)
_{jk}\right) g_{jl}x_{k}x_{m} \\
& =\sum_{\substack{ 1\leq k<m\leq 2r  \\ 1\leq j<l\leq 2r}}\left( \mathcal{R}%
_{x}\left( T\right) \boxtimes \mathcal{R}_{x}\left( T\right) \right)
_{kmjl}g_{jl}x_{k}x_{m} \\
& \left( \mathcal{R}_{x}\left( T\right) \boxtimes \mathcal{R}_{x}\left(
T\right) \right) _{kmjl} \\
& =\frac{1}{4}\left( \mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}%
_{x}\left( T\right) _{lm}-\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}%
_{x}\left( T\right) _{lk}-\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}%
_{x}\left( T\right) _{jm}+\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}%
_{x}\left( T\right) _{jk}\right) .
\end{align}%
Giving%
\begin{equation}
\left( T\wedge T\right) \left( v_{1}\wedge v_{2}\right) =\left( \mathbf{x}%
\wedge \mathbf{x}\right) \left( \mathcal{R}_{x}\left( T\right) \wedge 
\mathcal{R}_{x}\left( T\right) \right) \left( \mathcal{R}_{x}\left(
v_{1}\right) \wedge \mathcal{R}_{x}\left( v_{2}\right) \right) ,
\end{equation}%
where%
\begin{eqnarray}
\left( \mathcal{R}_{x}\left( v_{1}\right) \wedge \mathcal{R}_{x}\left(
v_{2}\right) \right) _{jl} &=&\frac{1}{2}\left( \mathcal{R}_{x}\left(
v_{1}\right) _{j}\mathcal{R}_{x}\left( v_{2}\right) _{l}-\mathcal{R}%
_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left( v_{1}\right) _{l}\right) \\
&=&\frac{1}{2}\left( \mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}%
_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left( v_{1}\right) _{l}\mathcal{%
R}_{x}\left( v_{2}\right) _{j}\right) .
\end{eqnarray}%
Thus%
\begin{align}
& \mathcal{R}_{x}\left( \left( T\boxtimes T\right) \left( v_{1}\wedge
v_{2}\right) \right) _{jk}=\sum_{1\leq j<l\leq 2r}\mathcal{R}_{x}\left(
T\boxtimes T\right) _{kmjl}\mathcal{R}_{x}\left( v_{1}\wedge v_{2}\right)
_{jl} \\
& =\sum_{1\leq j<l\leq 2r}\left( \mathcal{R}_{x}\left( T\right) \boxtimes 
\mathcal{R}_{x}\left( T\right) \right) _{kmjl}\left( \mathcal{R}_{x}\left(
v_{1}\right) \wedge \mathcal{R}_{x}\left( v_{2}\right) \right) _{jl} \\
& =\sum_{1\leq j,l\leq 2r}\frac{1}{4}\left( \mathcal{R}_{x}\left( T\right)
_{kj}\mathcal{R}_{x}\left( T\right) _{lm}-\mathcal{R}_{x}\left( T\right)
_{mj}\mathcal{R}_{x}\left( T\right) _{lk}-\mathcal{R}_{x}\left( T\right)
_{kl}\mathcal{R}_{x}\left( T\right) _{jm}+\mathcal{R}_{x}\left( T\right)
_{ml}\mathcal{R}_{x}\left( T\right) _{jk}\right) \times \\
& \frac{1}{2}\left( \mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}%
_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{%
R}_{x}\left( v_{1}\right) _{l}\right)
\end{align}%
\begin{align}
& =\frac{1}{8}\sum_{1\leq j,l\leq 2r}\left\{ \mathcal{R}_{x}\left( T\right)
_{kj}\mathcal{R}_{x}\left( T\right) _{lm}\mathcal{R}_{x}\left( v_{1}\right)
_{j}\mathcal{R}_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left( T\right)
_{mj}\mathcal{R}_{x}\left( T\right) _{lk}\mathcal{R}_{x}\left( v_{1}\right)
_{j}\mathcal{R}_{x}\left( v_{2}\right) _{l}\right. \\
& -\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( T\right) _{jm}%
\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left( v_{2}\right)
_{l}+\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left( T\right) _{jk}%
\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left( v_{2}\right)
_{l} \\
& -\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left( T\right) _{lm}%
\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left( v_{1}\right)
_{l}+\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}_{x}\left( T\right) _{lk}%
\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left( v_{1}\right)
_{l} \\
& \left. \mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( T\right)
_{jm}\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left(
v_{1}\right) _{l}-\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left(
T\right) _{jk}\mathcal{R}_{x}\left( v_{2}\right) _{j}\mathcal{R}_{x}\left(
v_{1}\right) _{l}\right\}
\end{align}%
\begin{align}
& =\frac{1}{8}\sum_{1\leq j,l\leq 2r}\left\{ \mathcal{R}_{x}\left( T\right)
_{kj}\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left( T\right)
_{ml}^{t}\mathcal{R}_{x}\left( v_{2}\right) _{l}-\mathcal{R}_{x}\left(
T\right) _{mj}\mathcal{R}_{x}\left( v_{1}\right) _{j}\mathcal{R}_{x}\left(
T\right) _{kl}^{t}\mathcal{R}_{x}\left( v_{2}\right) _{l}\right. \\
& -\mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left( v_{2}\right)
_{l}\mathcal{R}_{x}\left( T\right) _{mj}^{t}\mathcal{R}_{x}\left(
v_{1}\right) _{j}+\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}_{x}\left(
v_{2}\right) _{l}\mathcal{R}_{x}\left( T\right) _{kj}^{t}\mathcal{R}%
_{x}\left( v_{1}\right) _{j} \\
& -\mathcal{R}_{x}\left( T\right) _{kj}\mathcal{R}_{x}\left( v_{2}\right)
_{j}\mathcal{R}_{x}\left( T\right) _{ml}^{t}\mathcal{R}_{x}\left(
v_{1}\right) _{l}+\mathcal{R}_{x}\left( T\right) _{mj}\mathcal{R}_{x}\left(
v_{1}\right) _{j}\mathcal{R}_{x}\left( T\right) _{kl}^{t}\mathcal{R}%
_{x}\left( v_{2}\right) _{l} \\
& \left. \mathcal{R}_{x}\left( T\right) _{kl}\mathcal{R}_{x}\left(
v_{1}\right) _{l}\mathcal{R}_{x}\left( T\right) _{mj}^{t}\mathcal{R}%
_{x}\left( v_{2}\right) _{j}-\mathcal{R}_{x}\left( T\right) _{ml}\mathcal{R}%
_{x}\left( v_{1}\right) _{l}\mathcal{R}_{x}\left( T\right) _{kj}^{t}\mathcal{%
R}_{x}\left( v_{2}\right) _{j}\right\} .
\end{align}

\subsection{Orthogonal Projections}

The projection condition is 
\begin{equation}
P^{2}=P;P=P^{\dagger}
\end{equation}
giving%
\begin{equation}
\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r  \\ 0\leq
i_{1}<\cdots<i_{t}\leq2r  \\ 0\leq m,t\leq2r}}P_{l_{1}\cdots
l_{m}}P_{i_{1}\cdots i_{t}}x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}=\sum_{\substack{ 0\leq j_{1}<\cdots<j_{n}\leq2r  \\ 0\leq n\leq2r}}%
P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
and%
\begin{equation}
\sum_{\substack{ 0\leq j_{1}<\cdots<j_{n}\leq2r  \\ 0\leq n\leq2r}}%
P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}}=\sum_{\substack{ 0\leq
j_{1}<\cdots<j_{n}\leq2r  \\ 0\leq n\leq2r}}\overline{P}_{i_{1}\cdots
i_{n}}x_{j_{n}}\cdots x_{j_{1}}.
\end{equation}

$\lceil$%
\begin{align}
P_{1}x_{1} & =\left( P_{1}x_{1}\right) ^{\dagger}=\overline{P_{1}}%
x_{1}\Rightarrow P_{1}\in\mathbb{R} \\
P_{12}x_{1}x_{2} & =\left( P_{12}x_{1}x_{2}\right) ^{\dagger}=-\overline{%
P_{12}}x_{1}x_{2}\Rightarrow P_{12}=ip_{12};p_{12}\in\mathbb{R} \\
P_{123}x_{1}x_{2}x_{3} & =\left( P_{123}x_{1}x_{2}x_{3}\right) ^{\dagger }=%
\overline{P_{123}}x_{3}x_{2}x_{1}=-\overline{P_{123}}x_{1}x_{2}x_{3}%
\Rightarrow P_{123}=ip_{123};p_{123}\in\mathbb{R} \\
P_{1234}x_{1}x_{2}x_{3}x_{4} & =\left( P_{1234}x_{1}x_{2}x_{3}x_{4}\right)
^{\dagger}=\overline{P_{1234}}x_{4}x_{3}x_{2}x_{1}=\overline{P_{1234}}%
x_{1}x_{2}x_{3}x_{4}\Rightarrow P_{1234}=\overline{P_{1234}}\Rightarrow
P_{1234}\in\mathbb{R}
\end{align}
$\rfloor$

The first condition gives 
\begin{align}
& \sum_{0\leq j_{1}<\cdots<j_{n}\leq2r}P_{j_{1}\cdots j_{n}}x_{j_{1}}\cdots
x_{j_{n}}=\left\langle \sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r  \\ %
0\leq i_{1}<\cdots<i_{t}\leq2r  \\ 0\leq m,t\leq2r}}P_{l_{1}\cdots
l_{m}}P_{i_{1}\cdots i_{t}}x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{n} \\
& =\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r  \\ 0\leq i_{1}<\cdots
<i_{t}\leq2r  \\ 0\leq m,t\leq2r}}P_{l_{1}\cdots l_{m}}P_{i_{1}\cdots
i_{t}}\left\langle x_{l_{1}}\cdots x_{l_{m}}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{n},
\end{align}
while the second condition gives 
\begin{equation}
\left( P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger
}=P_{i_{1}\cdots i_{n}}x_{j_{1}}\cdots x_{j_{n}},
\end{equation}
i.e. 
\begin{equation}
\overline{P}_{i_{1}\cdots i_{n}}x_{j_{n}}\cdots x_{j_{1}}=P_{i_{1}\cdots
i_{n}}x_{j_{1}}\cdots x_{j_{n}}.
\end{equation}
As 
\begin{equation}
x_{j_{n}}\cdots x_{j_{1}}=\left( -1\right) ^{\binom{n-1}{2}}x_{j_{1}}\cdots
x_{j_{n}}=e^{\frac{n\left( n-1\right) }{2}\pi i}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
and 
\begin{equation}
P_{i_{1}\cdots i_{n}}=\left\vert P_{i_{1}\cdots i_{n}}\right\vert
e^{i\theta}.
\end{equation}
Then 
\begin{equation}
\overline{P}_{i_{1}\cdots i_{n}}x_{j_{n}}\cdots x_{j_{1}}=P_{i_{1}\cdots
i_{n}}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
gives 
\begin{equation}
\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{-i\theta}e^{\frac{n\left(
n-1\right) }{2}\pi i}x_{j_{1}}\cdots x_{j_{n}}=\left\vert P_{i_{1}\cdots
i_{n}}\right\vert e^{i\theta}x_{j_{1}}\cdots x_{j_{n}}
\end{equation}
leading to 
\begin{equation}
e^{-i\theta}e^{\frac{n\left( n-1\right) }{2}\pi i}=e^{i\theta}
\end{equation}
i.e%
\begin{align}
e^{\frac{n\left( n-1\right) }{2}\pi i} & =e^{2i\theta} \\
\theta & =\frac{n\left( n-1\right) }{4}\pi,
\end{align}
hence 
\begin{equation}
P_{i_{1}\cdots i_{n}}=\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{\frac{%
n\left( n-1\right) }{4}i\pi}.
\end{equation}
Checking this gives 
\begin{align}
\overline{P}_{i_{1}\cdots i_{n}}x_{j_{n}}\cdots x_{j_{1}} & =P_{i_{1}\cdots
i_{n}}x_{j_{1}}\cdots x_{j_{n}} \\
\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{-\frac{n\left( n-1\right) }{4}%
i\pi}e^{\frac{n\left( n-1\right) }{2}\pi i}x_{j_{1}}\cdots x_{j_{n}} &
=\left\vert P_{i_{1}\cdots i_{n}}\right\vert e^{\frac{n\left( n-1\right) }{4}%
i\pi}x_{j_{1}}\cdots x_{j_{n}} \\
e^{\frac{n\left( n-1\right) }{4}\pi i} & =e^{\frac{n\left( n-1\right) }{4}%
i\pi},
\end{align}
which confirms the value of $P_{i_{1}\cdots i_{n}}.$

$\lceil $%
\begin{align}
21& =-12=\sigma \left( 21\right) 12=\left( -1\right) ^{1}12 \\
321& =-123=\sigma \left( 32\right) \sigma \left( 31\right) \sigma \left(
21\right) 123=\left( -1\right) ^{1}\left( -1\right) ^{2}123 \\
4321& =-4123=1234=\sigma \left( 41\right) \sigma \left( 42\right) \sigma
\left( 43\right) \sigma \left( 32\right) \sigma \left( 31\right) \sigma
\left( 21\right) 1234=\left( -1\right) ^{1}\left( -1\right) ^{2}\left(
-1\right) ^{3}1234 \\
54321& =51234=12345=\sigma \left( 51\right) \sigma \left( 52\right) \sigma
\left( 53\right) \sigma \left( 54\right) \sigma \left( 41\right) \sigma
\left( 42\right) \sigma \left( 43\right) \sigma \left( 32\right) \sigma
\left( 31\right) \sigma \left( 21\right) 12345 \\
& =\left( -1\right) ^{1}\left( -1\right) ^{2}\left( -1\right) ^{3}\left(
-1\right) ^{4}12345 \\
654321& =612345=-123456= \\
& =\sigma \left( 61\right) \sigma \left( 62\right) \sigma \left( 63\right)
\sigma \left( 64\right) \sigma \left( 65\right) \sigma \left( 51\right)
\sigma \left( 52\right) \sigma \left( 53\right) \\
& \sigma \left( 54\right) \sigma \left( 41\right) \sigma \left( 42\right)
\sigma \left( 43\right) \sigma \left( 32\right) \sigma \left( 31\right)
\sigma \left( 21\right) 123456 \\
& =\left( -1\right) ^{1}\left( -1\right) ^{2}\left( -1\right) ^{3}\left(
-1\right) ^{4}\left( -1\right) ^{5}123456 \\
7654321& =-7123456=-1234567=\left( -1\right) ^{1+2+3+4+5+6}1234567 \\
87654321& =-81234567=12345678=\left( -1\right) ^{1+2+3+4+5+6+7}12345678 \\
S_{n}& =\frac{n\left( a_{1}+a_{n}\right) }{2},S_{1}=\frac{1\left( 1+1\right) 
}{2}=1,S_{2}=\frac{2\left( 1+2\right) }{2}=3, \\
S_{3}& =\frac{3\left( 1+3\right) }{2}=6,S_{4}=\frac{4\left( 1+4\right) }{2}%
=10, \\
S_{5}& =\frac{5\left( 1+5\right) }{2}=15,S_{6}=\frac{6\left( 1+6\right) }{2}%
=21,S_{n}=\frac{n\left( 1+n\right) }{2}
\end{align}%
\begin{align}
e^{\frac{n\pi }{2}i}& =\cos \left( \frac{n\pi }{2}\right) +i\sin \left( 
\frac{n\pi }{2}\right) \\
e^{\frac{\pi }{2}i}& =\cos \left( \frac{\pi }{2}\right) +i\sin \left( \frac{%
\pi }{2}\right) =i \\
e^{\pi i}& =\cos \left( \pi \right) +i\sin \left( \pi \right) =-1 \\
e^{\frac{3\pi }{2}i}& =\cos \left( \frac{3\pi }{2}\right) +i\sin \left( 
\frac{3\pi }{2}\right) =-i \\
e^{\frac{2\pi }{2}i}& =\cos \left( 2\pi \right) +i\sin \left( 2\pi \right) =1
\end{align}%
$\rfloor $

\begin{equation}
P=P_{0}I_{\mathcal{A}}+\sum_{1\leq m\leq 2r}P_{m}.
\end{equation}%
giving%
\begin{align}
P^{2}& =P^{\dagger }P=\sum_{0\leq m,n\leq 2r}P_{m}P_{n}=\left\Vert
P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq m\leq
2r}P_{m}+\sum_{1\leq m,n\leq 2r}P_{m}P_{n} \\
& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq m\leq
2r}P_{m}+\sum_{1\leq m,n\leq 2r}\sum_{j=0}^{\min \left( m,n\right)
}\left\langle P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{align}%
As%
\begin{equation}
P=P_{0}+\sum_{1\leq m\leq 2r}P_{m}
\end{equation}%
one has%
\begin{align}
P_{0}& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}} \\
P_{m}& =2P_{0}P_{m}+\left\langle \sum_{1\leq m,n\leq 2r}\sum_{j=0}^{\min
\left( m,n\right) }\left\langle P_{m}P_{n}\right\rangle _{\left\vert
m-n\right\vert +2j}\right\rangle _{m}.
\end{align}%
$\lceil $%
\begin{align}
\left\langle A_{r}B_{s}\right\rangle _{r+s-2j}& =\left( -1\right)
^{rs-j}\left\langle B_{s}A_{r}\right\rangle _{r+s-2j} \\
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}& =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j}
\end{align}%
\begin{align}
m,n\text{ even }& \Rightarrow mn\text{ even }\left( 2s\right)
^{2}=4s^{2}\Rightarrow \pi \left( mn-j\right) =\pi \left( j\right)
\Rightarrow \left\langle P_{m}P_{n}\right\rangle _{m+n-2j}=\left( -1\right)
^{j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
m\text{ even,}n\text{ odd}& \Rightarrow mn\text{ even }\left( 2s\right)
\left( 2s+1\right) =2\left( 2s^{2}+s\right) \Rightarrow \pi \left(
mn-j\right) \\
& =\pi \left( j\right) \Rightarrow \left\langle P_{m}P_{n}\right\rangle
_{m+n-2j}=\left( -1\right) ^{j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j}
\\
m\text{ odd,}n\text{ odd}& \Rightarrow mn\text{ odd }\left( 2s+1\right)
^{2}=4s^{2}+4s+1\Rightarrow \pi \left( mn-j\right) \\
& =\pi \left( j+1\right) \Rightarrow \left\langle P_{m}P_{n}\right\rangle
_{m+n-2j}=\left( -1\right) ^{j+1}\left\langle P_{n}P_{m}\right\rangle
_{m+n-2j}
\end{align}%
\begin{align}
P^{2}& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq
m\leq 4}P_{m}+\sum_{1\leq m,n\leq 4}P_{m}P_{n} \\
& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\left(
P_{1}+P_{2}+P_{3}+P_{4}\right) +P_{1}P_{1}+P_{2}P_{2}+P_{3}P_{3}+P_{4}P_{4}
\\
&
+P_{1}P_{2}+P_{1}P_{3}+P_{1}P_{4}+P_{2}P_{3}+P_{2}P_{4}+P_{3}P_{4}+P_{2}P_{1}+P_{3}P_{1}+P_{4}P_{1}+P_{3}P_{2}+P_{4}P_{2}+P_{4}P_{3}
\end{align}%
$\rfloor $

and%
\begin{equation}
\left\Vert P\right\Vert _{HS}^{2}=\left\langle \sum_{\substack{ 0\leq
l_{1}<\cdots<l_{m}\leq2r  \\ 0\leq i_{1}<\cdots<i_{t}\leq2r  \\ 0\leq
m,t\leq 2r}}\overline{P}_{l_{1}\cdots l_{m}}P_{i_{1}\cdots i_{t}}\left(
x_{l_{1}}\cdots x_{l_{m}}\right) ^{\dagger}x_{i_{1}}\cdots
x_{i_{t}}\right\rangle _{0}=\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r 
\\ 0\leq m\leq2r}}\overline{P}_{l_{1}\cdots l_{m}}P_{l_{1}\cdots l_{m}}.
\end{equation}
The general formula is 
\begin{equation}
\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}\sum_{1\leq m\leq
2r}P_{m}+\sum_{1\leq m,n\leq2r}\sum_{j=0}^{\min\left( m,n\right)
}\left\langle P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{equation}
giving

\begin{enumerate}
\item $m=0$%
\begin{equation}
P_{0}=p_{0}I_{\mathcal{A}}\,=\sum_{\substack{ 0\leq l_{1}<\cdots<l_{m}\leq2r 
\\ 0\leq m\leq4}}\left\vert P\right\vert _{l_{1}\cdots l_{m}}^{2}I_{\mathcal{%
A}}=\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}.
\end{equation}

\item $m=1$%
\begin{align*}
& P_{1}=2P_{0}P_{1}+\sum_{1\leq m\leq4}\left\{ \left\langle
P_{m-1}P_{m}\right\rangle _{1}+\left\langle P_{m}P_{m-1}\right\rangle
_{1}\right\} \\
& =2P_{0}P_{1}+\left\langle P_{1}P_{2}\right\rangle _{1}+\left\langle
P_{2}P_{1}\right\rangle _{1}+\left\langle P_{2}P_{3}\right\rangle
_{1}+\left\langle P_{3}P_{2}\right\rangle _{1}+\left\langle
P_{3}P_{4}\right\rangle _{1}+\left\langle P_{4}P_{3}\right\rangle _{1}
\end{align*}
as 
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j} & =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{1}P_{2}\right\rangle _{3-2} & =\left( -1\right)
^{1}\left\langle P_{2}P_{1}\right\rangle _{1} \\
\left\langle P_{2}P_{3}\right\rangle _{1} & =\left( -1\right)
^{6-2}\left\langle P_{3}P_{2}\right\rangle _{5-2x2}=\left\langle
P_{3}P_{2}\right\rangle _{1} \\
\left\langle P_{3}P_{4}\right\rangle _{1} & =\left( -1\right)
^{12-3}\left\langle P_{4}P_{3}\right\rangle _{7-2x3}=\left( -1\right)
^{9}\left\langle P_{4}P_{3}\right\rangle _{1}=-\left\langle
P_{4}P_{3}\right\rangle _{1}
\end{align}
one has 
\begin{equation}
P_{1}=2P_{0}P_{1}+2\left\langle P_{2}P_{3}\right\rangle _{1}
\end{equation}%
\begin{equation}
\Downarrow
\end{equation}%
\begin{equation}
P_{1}\left( 2P_{0}-I_{\mathcal{A}}\right) +2\left\langle
P_{2}P_{3}\right\rangle _{1}=0.
\end{equation}

\item $m=2$%
\begin{align}
P_{2}& =2P_{0}P_{2}+\sum_{1\leq m\leq 4}\left\{ \left\langle
P_{m-2}P_{m}\right\rangle _{2}+\left\langle P_{m}P_{m-2}\right\rangle
_{2}+\left\langle P_{m}P_{m}\right\rangle _{2}\right\} \\
& =2P_{0}P_{2}+\left\langle P_{1}P_{3}\right\rangle _{2}+\left\langle
P_{3}P_{1}\right\rangle _{2}+\left\langle P_{2}P_{4}\right\rangle
_{2}+\left\langle P_{4}P_{2}\right\rangle _{2}+\left\langle
P_{1}P_{1}\right\rangle _{2}+\left\langle P_{2}P_{2}\right\rangle
_{2}+\left\langle P_{3}P_{3}\right\rangle _{2}+\left\langle
P_{4}P_{4}\right\rangle _{2}
\end{align}%
and%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}& =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{1}P_{3}\right\rangle _{4-2}& =\left( -1\right)
^{3-1}\left\langle P_{3}P_{1}\right\rangle _{4-2}\Rightarrow \left\langle
P_{1}P_{3}\right\rangle _{2}=\left\langle P_{3}P_{1}\right\rangle _{2} \\
\left\langle P_{2}P_{4}\right\rangle _{6-4}& =\left( -1\right)
^{8-2}\left\langle P_{4}P_{2}\right\rangle _{6-4}\Rightarrow \left\langle
P_{2}P_{4}\right\rangle _{2}=\left\langle P_{4}P_{2}\right\rangle _{2}.
\end{align}%
Hence 
\begin{equation}
P_{2}=2P_{0}P_{2}+2\left\langle P_{1}P_{3}\right\rangle _{2}+2\left\langle
P_{2}P_{4}\right\rangle _{2}+\left\langle P_{1}P_{1}\right\rangle
_{2}+\left\langle P_{2}P_{2}\right\rangle _{2}+\left\langle
P_{3}P_{3}\right\rangle _{2}+\left\langle P_{4}P_{4}\right\rangle _{2}
\end{equation}

\item $m=3$%
\begin{align}
P_{3}& =2P_{0}P_{3}+\sum_{1\leq m\leq 4}\left\{ \left\langle
P_{m-3}P_{m}\right\rangle _{3}+\left\langle P_{m}P_{m-3}\right\rangle
_{3}+\left\langle P_{m-1}P_{m}\right\rangle _{3}+\left\langle
P_{m}P_{m-1}\right\rangle _{3}\right\} \\
& =2P_{0}P_{3}+\left\langle P_{1}P_{4}\right\rangle _{3}+\left\langle
P_{4}P_{1}\right\rangle _{3}+\left\langle P_{1}P_{2}\right\rangle
_{3}+\left\langle P_{2}P_{1}\right\rangle _{3} \\
& +\left\langle P_{2}P_{3}\right\rangle _{3}+\left\langle
P_{3}P_{2}\right\rangle _{3}+\left\langle P_{4}P_{3}\right\rangle
_{3}+\left\langle P_{3}P_{4}\right\rangle _{3}
\end{align}%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}& =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{1}P_{4}\right\rangle _{5-2}& =\left( -1\right)
^{4-1}\left\langle P_{1}P_{4}\right\rangle _{5-2}=-\left\langle
P_{4}P_{1}\right\rangle _{3} \\
\left\langle P_{1}P_{2}\right\rangle _{3-0}& =\left( -1\right)
^{2-0}\left\langle P_{1}P_{2}\right\rangle _{3-0}=\left\langle
P_{2}P_{1}\right\rangle _{3} \\
\left\langle P_{2}P_{3}\right\rangle _{5-2}& =\left( -1\right)
^{6-1}\left\langle P_{2}P_{3}\right\rangle _{5-2}=-\left\langle
P_{3}P_{2}\right\rangle _{3} \\
\left\langle P_{3}P_{4}\right\rangle _{7-4}& =\left( -1\right)
^{12-2}\left\langle P_{4}P_{3}\right\rangle _{7-4}=\left\langle
P_{4}P_{3}\right\rangle _{3}
\end{align}%
Hence 
\begin{equation}
P_{3}=2\left\langle P_{1}P_{2}\right\rangle _{3}+2\left\langle
P_{4}P_{3}\right\rangle _{3}
\end{equation}

\item $m=4$%
\begin{align}
P_{4} & =2P_{0}P_{4}+\sum_{1\leq m\leq4}\left\{ \left\langle
P_{m-4}P_{m}\right\rangle _{4}+\left\langle P_{m}P_{m-4}\right\rangle
_{4}+\left\langle P_{m-2}P_{m}\right\rangle _{4}+\left\langle
P_{m}P_{m-2}\right\rangle _{4}+\left\langle P_{m}P_{m}\right\rangle
_{4}\right\} \\
& =2P_{0}P_{4}+\left\langle P_{1}P_{3}\right\rangle _{4}+\left\langle
P_{3}P_{1}\right\rangle _{4}+\left\langle P_{2}P_{4}\right\rangle
_{4}+\left\langle P_{4}P_{2}\right\rangle _{4}+\left\langle
P_{2}P_{2}\right\rangle _{4}+\left\langle P_{3}P_{3}\right\rangle
_{4}+\left\langle P_{4}P_{4}\right\rangle _{4}
\end{align}%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j} & =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{1}P_{3}\right\rangle _{4-0} & =\left( -1\right)
^{3-0}\left\langle P_{3}P_{1}\right\rangle _{4}=-\left\langle
P_{3}P_{1}\right\rangle _{4} \\
\left\langle P_{2}P_{4}\right\rangle _{6-2} & =\left( -1\right)
^{8-1}\left\langle P_{4}P_{2}\right\rangle _{4}=-\left\langle
P_{4}P_{2}\right\rangle _{4}
\end{align}
hence 
\begin{equation}
P_{4}=2P_{0}P_{4}+\left\langle P_{2}P_{2}\right\rangle _{4}+\left\langle
P_{3}P_{3}\right\rangle _{4}+\left\langle P_{4}P_{4}\right\rangle _{4}
\end{equation}

\item $m=5$%
\begin{equation}
P_{5}=0=\sum_{1\leq m,n\leq4}\sum_{j=0}^{\min\left( m,n\right) }\left\langle
P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert +2j}=\left\langle
P_{1}P_{4}\right\rangle _{5}+\left\langle P_{4}P_{1}\right\rangle
_{5}+\left\langle P_{3}P_{4}\right\rangle _{5}+\left\langle
P_{4}P_{3}\right\rangle _{5}
\end{equation}%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j} & =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{1}P_{4}\right\rangle _{4+1-0} & =\left( -1\right)
^{4-0}\left\langle P_{4}P_{1}\right\rangle _{4+1-0}=\left\langle
P_{4}P_{1}\right\rangle _{5} \\
\left\langle P_{3}P_{4}\right\rangle _{7-2} & =\left( -1\right)
^{12-1}\left\langle P_{4}P_{3}\right\rangle _{5}=-\left\langle
P_{4}P_{3}\right\rangle _{5}
\end{align}
hence%
\begin{equation}
P_{5}=0=2\left\langle P_{1}P_{4}\right\rangle _{5}
\end{equation}

\item $m=6$%
\begin{equation}
P_{6}=0=\sum_{1\leq m,n\leq 4}\sum_{j=0}^{\min \left( m,n\right)
}\left\langle P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert
+2j}=\left\langle P_{2}P_{4}\right\rangle _{6}+\left\langle
P_{4}P_{2}\right\rangle _{6}+\left\langle P_{3}P_{3}\right\rangle
_{6}+\left\langle P_{4}P_{4}\right\rangle _{6}
\end{equation}%
and%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}& =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{2}P_{4}\right\rangle _{4+2-0}& =\left( -1\right)
^{8-0}\left\langle P_{4}P_{2}\right\rangle _{6}=\left\langle
P_{4}P_{2}\right\rangle _{6}
\end{align}%
hence 
\begin{equation}
P_{6}=0=2\left\langle P_{2}P_{4}\right\rangle _{6}+\left\langle
P_{3}P_{3}\right\rangle _{6}+\left\langle P_{4}P_{4}\right\rangle _{6}
\end{equation}

\item $m=7$%
\begin{equation}
P_{7}=0=\sum_{1\leq m,n\leq 4}\sum_{j=0}^{\min \left( m,n\right)
}\left\langle P_{m}P_{n}\right\rangle _{\left\vert m-n\right\vert
+2j}=\left\langle P_{3}P_{4}\right\rangle _{7}+\left\langle
P_{4}P_{3}\right\rangle _{7}
\end{equation}%
and%
\begin{align}
\left\langle P_{m}P_{n}\right\rangle _{m+n-2j}& =\left( -1\right)
^{mn-j}\left\langle P_{n}P_{m}\right\rangle _{m+n-2j} \\
\left\langle P_{3}P_{4}\right\rangle _{4+3-0}& =\left( -1\right)
^{12-0}\left\langle P_{4}P_{3}\right\rangle _{7}=\left\langle
P_{4}P_{3}\right\rangle _{7}
\end{align}%
hence 
\begin{equation}
P_{7}=0=2\left\langle P_{3}P_{4}\right\rangle _{7}
\end{equation}

\item $m=8$%
\begin{equation}
P_{8}=0=\left\langle P_{4}P_{4}\right\rangle _{8}.
\end{equation}%
Since we are only interested in gauge invariant projectors 
\begin{align}
P& =P_{0}+P_{2}+P_{4}=P^{2} \\
& =\left\Vert P\right\Vert _{HS}^{2}I_{\mathcal{A}}+2P_{0}P_{2}+2\left%
\langle P_{2}P_{4}\right\rangle _{2}+\left\langle P_{2}P_{2}\right\rangle
_{2}+\left\langle P_{4}P_{4}\right\rangle _{2} \\
& +2P_{0}P_{4}+\left\langle P_{2}P_{2}\right\rangle _{4},
\end{align}%
giving 
\begin{align}
& 2P_{0}P_{2}-P_{2}+2\left\langle P_{2}P_{4}\right\rangle _{2}+\left\langle
P_{2}P_{2}\right\rangle _{2}+\left\langle P_{4}P_{4}\right\rangle _{2}=0 \\
& 2P_{0}P_{4}-P_{4}+\left\langle P_{2}P_{2}\right\rangle _{4}+\left\langle
P_{4}P_{4}\right\rangle _{4}=0 \\
& 2\left\langle P_{2}P_{4}\right\rangle _{6}+\left\langle
P_{4}P_{4}\right\rangle _{6}=0 \\
& \left\langle P_{4}P_{4}\right\rangle _{8}=0 \\
& P_{0}=\left\Vert P\right\Vert _{HS}I_{\mathcal{A}}.
\end{align}%
The various products are given by

\begin{enumerate}
\item 
\begin{align}
& P_{2}P_{2}=\sum_{\substack{ 1\leq j_{1}<j_{2}\leq 2r  \\ 1\leq
j_{3}<j_{4}\leq 2r}}P_{2j_{1}j_{2}}P_{2j_{3}j_{4}}\left\{ x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\right.  \notag \\
& -\Delta _{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}+\Delta
_{j_{1}j_{4}}x_{j_{2}}\wedge x_{j_{3}}  \notag \\
& +\Delta _{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}-\Delta
_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}  \notag \\
& +\left. \Delta _{j_{1}j_{4}}\Delta _{j_{2}j_{3}}I_{\mathcal{F}}-\Delta
_{j_{1}j_{3}}\Delta _{j_{2}j_{4}}I_{\mathcal{F}}\right\} .
\end{align}

\item 
\begin{align}
P_{4}P_{2}& =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r  \\ 1\leq
j_{5}<j_{6}\leq 2r}}P_{4j_{1}j_{2}j_{3}j_{4}}P_{2j_{5}j_{6}}\left\{
x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge
x_{j_{5}}\wedge x_{j_{6}}\right.  \notag \\
& +\sum_{\sigma \in S_{6}/\left( S_{4}\times S_{2}\right) }\pi \left( \sigma
\right) \Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right)
}}x_{j_{\sigma \left( 3\right) }}\wedge x_{j_{\sigma \left( 4\right)
}}\wedge x_{j_{\sigma \left( 5\right) }}\wedge x_{j_{\sigma \left( 6\right)
}}  \notag \\
& +\sum_{\sigma \in S_{6}/\left( S_{4}\times S_{4}\right) }\pi \left( \sigma
\right) \limfunc{Pf}\left( \mathbf{\Delta }_{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }j_{\sigma \left( 3\right) }j_{\sigma \left(
4\right) }}\right) x_{j_{\sigma \left( 5\right) }}\wedge x_{j_{\sigma \left(
6\right) }}  \notag \\
& +\left. \limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}}\right) I_{\mathcal{F}}\right\} .
\end{align}

\item 
\begin{align}
P_{4}P_{4}& =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r  \\ 1\leq
j_{5}<j_{6}\,<j_{7}<j_{8}\leq 2r}}%
P_{4j_{1}j_{2}j_{3}j_{4}}P_{4j_{5}j_{6}j_{7}j_{8}}\left\{ x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge
x_{j_{6}}\wedge x_{j_{7}}\wedge x_{j_{8}}\right. \\
& +\sum_{\sigma \in S_{8}/\left( S_{2}\times S_{6}\right) }\pi \left( \sigma
\right) \Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right)
}}x_{j_{\sigma \left( 3\right) }}\wedge x_{j_{\sigma \left( 4\right)
}}\wedge x_{j_{\sigma \left( 5\right) }}\wedge x_{j_{\sigma \left( 6\right)
}}\wedge x_{j_{\sigma \left( 7\right) }}\wedge x_{j_{\sigma \left( 8\right)
}} \\
& +\sum_{\sigma \in S_{8}/\left( S_{4}\times S_{4}\right) }\pi \left( \sigma
\right) \limfunc{Pf}\left( \mathbf{\Delta }_{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }j_{\sigma \left( 3\right) }j_{\sigma \left(
4\right) }}\right) x_{j_{\sigma \left( 5\right) }}\wedge x_{j_{\sigma \left(
6\right) }}\wedge x_{j_{\sigma \left( 7\right) }}\wedge x_{j_{\sigma \left(
8\right) }} \\
& +\left. \sum_{\sigma \in S_{8}/\left( S_{6}\times S_{2}\right) }\pi \left(
\sigma \right) \limfunc{Pf}\left( \mathbf{\Delta }_{j_{\sigma \left(
1\right) }j_{\sigma \left( 2\right) }j_{\sigma \left( 3\right) }j_{\sigma
\left( 4\right) }j_{\sigma \left( 5\right) }j_{\sigma \left( 6\right)
}}\right) x_{j_{\sigma \left( 7\right) }}\wedge x_{j_{\sigma \left( 8\right)
}}+\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}j_{7}j_{8}}\right) I_{\mathcal{F}}\right\} .
\end{align}
\end{enumerate}
\end{enumerate}

\section{Positivity Constraints}

\begin{theorem}
A partial state $f_{\left( 4\right) }$ defined on $\mathcal{A}_{\left(
4\right) }$ can be extended to a state $f$ of $\mathcal{A}$ if and only if 
\begin{equation}
0\leq f_{\left( 4\right) }\left( P\right) \leq 1\quad \forall P\in \Pr
\left\{ \mathcal{F}_{\left( 4\right) }\right\} ,
\end{equation}%
where $\Pr \left\{ \mathcal{A}_{\left( 4\right) }\right\} $ is the set of
orthogonal projections (orthogonal idempotents $\equiv $ self adjoint
idempotents) belonging to $\mathcal{A}_{\left( 4\right) }.$
\end{theorem}

If $f_{\left( 4\right) }$ is a normal partial state 
\begin{equation}
f_{\left( 4\right) }\left( P\right) =\limfunc{tr}\left\{ PD_{\left( 4\right)
}\right\} =\limfunc{tr}\left\{ P\left( I_{\mathcal{F}%
}+d_{1}+d_{2}+d_{3}+d_{4}\right) \right\}
\end{equation}%
and if $f_{\left( 4\right) }$ is gauge invariant normal state 
\begin{equation}
f_{\left( 4\right) }\left( P\right) =\limfunc{tr}\left\{ PD_{\left( 4\right)
}\right\} =\limfunc{tr}\left\{ P\left( I_{\mathcal{F}}+d_{2}+d_{4}\right)
\right\} =\limfunc{tr}\left\{ P_{0}I_{\mathcal{F}}+P_{2}d_{2}+P_{4}d_{4}%
\right\} =P_{0}+\limfunc{tr}\left\{ P_{2}d_{2}+P_{4}d_{4}\right\} .
\end{equation}%
A gauge invariant partial state can be extended iff 
\begin{equation}
D_{\left( 4\right) }=\left\langle QQ^{\dagger }\right\rangle
_{0}+\left\langle QQ^{\dagger }\right\rangle _{2}+\left\langle QQ^{\dagger
}\right\rangle _{4},
\end{equation}%
for \emph{some }$Q$ (there could be many $Q^{\prime }s$ defining the same $%
D_{\left( 4\right) }),$ where in general 
\begin{equation}
Q=\sum_{0\leq j\leq 2r}\left\langle Q\right\rangle _{j}.
\end{equation}%
Orthogonal idempotents/projections are positive thus 
\begin{equation}
P=pp^{\dagger },
\end{equation}%
where $p$ is a partial isometry ($\limfunc{PIsom}$), thus for normal partial
states 
\begin{equation}
f_{\left( 4\right) }\left( P\right) =\left\langle \left\langle PD_{\left(
4\right) }\right\rangle \right\rangle _{0}=\limfunc{tr}\left\{ PD_{\left(
4\right) }\right\} =\limfunc{tr}\left\{ pp^{\dagger }D_{\left( 4\right)
}\right\} =\limfunc{tr}\left\{ p^{\dagger }D_{\left( 4\right) }p\right\}
=\left\langle \left. p\right\vert D_{\left( 4\right) }p\right\rangle _{%
\mathcal{A}}.
\end{equation}%
and 
\begin{equation}
0\leq \left\langle \left. p\right\vert D_{\left( 4\right) }p\right\rangle _{%
\mathcal{A}}\leq 1.
\end{equation}%
If 
\begin{equation}
P\in \Pr \left\{ \mathcal{A}_{\left( 4\right) }\right\} \overset{?}{%
\Leftrightarrow }p\in \mathcal{A}_{\left( 4\right) }
\end{equation}%
then the positivity (representability) constraint becomes 
\begin{equation}
0\leq \left\langle \left. p\right\vert D_{\left( 4\right) }p\right\rangle _{%
\mathcal{A}}\leq 1\forall p\in \limfunc{PIsom}\left\{ \mathcal{A}_{\left(
4\right) }\right\} .
\end{equation}%
Also%
\begin{equation}
\limfunc{tr}\left\{ P\right\} =\limfunc{tr}\left\{ pp^{\dagger }\right\} =%
\limfunc{tr}\left\{ p^{\dagger }p\right\} =\left\Vert p\right\Vert
_{HS}^{2}\leq 1.
\end{equation}%
We also have 
\begin{align}
\left\langle \left\langle PD_{\left( 4\right) }\right\rangle \right\rangle
_{0}& =\limfunc{tr}\left\{ PD_{\left( 4\right) }\right\} =P_{0}+\limfunc{tr}%
\left\{ \left\langle pp^{\dagger }\right\rangle _{2}d_{2}+\left\langle
pp^{\dagger }\right\rangle _{4}d_{4}\right\} =P_{0}+\limfunc{tr}\left\{
\left\langle pp^{\dagger }\right\rangle _{2}d_{2}+\left\langle pp^{\dagger
}\right\rangle _{4}d_{4}\right\} \\
& =P_{0}+\limfunc{tr}\left\{ \left\langle pp^{\dagger }\right\rangle
_{2}\left\langle QQ^{\dagger }\right\rangle _{2}+\left\langle pp^{\dagger
}\right\rangle _{4}\left\langle QQ^{\dagger }\right\rangle _{4}\right\}
\end{align}%
Note 
\begin{align}
\limfunc{tr}\left\{ \left\langle pp^{\dagger }\right\rangle
_{2}d_{2}\right\} & =\left\langle \left\langle \left\langle pp^{\dagger
}\right\rangle _{2}d_{2}\right\rangle \right\rangle _{0}=\limfunc{tr}\left\{
\left\langle pp^{\dagger }\right\rangle _{2}\left\langle QQ^{\dagger
}\right\rangle _{2}\right\} =\left\langle \left\langle \left\langle
pp^{\dagger }\right\rangle _{2}\left\langle QQ^{\dagger }\right\rangle
_{2}\right\rangle \right\rangle _{0}\neq 0\text{ in general} \\
\limfunc{tr}\left\{ \left\langle pp^{\dagger }\right\rangle
_{4}d_{4}\right\} & =\left\langle \left\langle \left\langle pp^{\dagger
}\right\rangle _{4}d_{4}\right\rangle \right\rangle _{0}=\limfunc{tr}\left\{
\left\langle pp^{\dagger }\right\rangle _{4}\left\langle QQ^{\dagger
}\right\rangle _{4}\right\} =\left\langle \left\langle \left\langle
pp^{\dagger }\right\rangle _{4}\left\langle QQ^{\dagger }\right\rangle
_{4}\right\rangle \right\rangle _{0}\neq 0\text{ in general}
\end{align}%
$\lceil $If $p=p^{2}=p^{\dagger }$ and $p$ is order of $4$ then 
\begin{equation}
\left\langle \left\langle p^{\dagger }Dp\right\rangle \right\rangle
_{0}=\left\langle \left\langle pD\right\rangle \right\rangle
_{0}=\left\langle \left\langle pD_{\left( 4\right) }\right\rangle
\right\rangle _{0}=\left\langle \left\langle p^{\dagger }D_{\left( 4\right)
}p\right\rangle \right\rangle _{0}=p_{0}+\limfunc{tr}\left\{
p_{2}\left\langle QQ^{\dagger }\right\rangle _{2}\right\} +\limfunc{tr}%
\left\{ p_{4}\left\langle QQ^{\dagger }\right\rangle _{4}\right\} .
\end{equation}%
$\rfloor $

$\lceil $ Projection operations correspond to singular transformations, and
we now see that these are represented by products of null multivectors in $%
\mathbb{R}_{n,n}.$This is sufficient to ensure that singular transformations
can also be represented by an even product of vectors, some of which may now
be null.

\begin{equation}
\frac{1}{\sqrt{2}}\left( x_{j}-ix_{j+r}\right) \frac{1}{\sqrt{2}}\left(
x_{j}-ix_{j+r}\right) =\frac{1}{2}\left( 1-1\right) =0
\end{equation}
$\rfloor$

\subsubsection{Ket Bra Projectors}

\begin{equation}
\left\vert Q\right\rangle _{\mathcal{A}}\left\langle Q\right\vert \notin%
\mathcal{A}
\end{equation}%
\begin{equation}
\left\vert x_{j_{1}}\cdots x_{j_{p}}\right\rangle _{\mathcal{A}}\left\langle
x_{j_{1}}\cdots x_{j_{p}}\right\vert \notin\mathcal{A}
\end{equation}

\section{Generation of the Geometric Algebra}

It is always true that 
\begin{equation}
\mathcal{A}=\tbigwedge \left( \mathcal{A}_{1}\right) ,
\end{equation}%
if $\mathcal{A}_{1}$ is even dimensional it can be expressed in terms of a
self adjoint orthogonal basis $\left\{ \left. x_{j}\right\vert 1\leq j\leq
2r\right\} $ that leads to a direct sum decomposition%
\begin{equation}
\mathcal{A}_{1}=\mathbf{x}_{1}\oplus \mathbf{x}_{2}.
\end{equation}%
This basis can be used to construct a \emph{non self adjoint nilpotent }%
basis $\left\{ \left. b_{j}^{\dagger },b_{j}\right\vert 1\leq j\leq
r\right\} ,$ that is orthogonal wrt $\left\langle \left. a\right\vert
b\right\rangle _{\mathcal{A}}=\left\langle \left\langle a^{\dagger
}b\right\rangle \right\rangle ,$ but isotropic wrt $\left( \left.
a\right\vert b\right) _{\mathcal{A}}=\left\langle \left\langle
ab\right\rangle \right\rangle _{0},$ which produces the direct sum
decomposition 
\begin{equation}
\mathcal{A}_{1}=\mathbf{b}^{\dagger }\oplus \mathbf{b}\equiv \mathcal{A}%
_{b10}\oplus \mathcal{A}_{b01}\equiv \left( \mathbf{x}_{1}+i\mathbf{x}%
_{2}\right) \oplus \left( \mathbf{x}_{1}-i\mathbf{x}_{2}\right) .
\end{equation}%
These bases are related by a transformation $K_{x}\in U\left( 2r\right) $
expressd by 
\begin{align}
K_{2rx}\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) & =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \mathcal{R}_{x}\left( K_{x}\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \mathbb{K}_{x}^{\dagger } \\
& =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbf{x}_{1}-i\mathbf{x}_{2} & \mathbf{x}_{1}+i\mathbf{x}_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger } & \mathbf{b}%
\end{array}%
\right)
\end{align}%
and are defined in terms of the action of the complexification $\widehat{%
J_{x}}.$ The spaces $\mathcal{A}_{b10},\mathcal{A}_{b10},\mathbf{b}^{\dagger
}$ and $\mathbf{b}$ are each closed under real linear combinations, while $%
\mathbf{b}^{\dagger }$ and $\mathbf{b}$ are also closed complex linear
combinations. The isotropic decomposition corresponds to the real bivector
(real geminal) complexification 
\begin{equation}
J_{x}\equiv g_{x}=\sum_{1\leq j\leq r}x_{j}x_{j+r}
\end{equation}%
as 
\begin{align}
\widehat{J_{x}}\left( \left( x_{k}+ix_{k+r}\right) \right) & =\left[
\sum_{1\leq j\leq r}x_{j}x_{j+r},\left( x_{k}+ix_{k+r}\right) \right]
=i\left( x_{k}+ix_{k+r}\right) \\
\widehat{J_{x}}\left( \left( x_{k}-ix_{k+r}\right) \right) & =\left[
\sum_{1\leq j\leq r}x_{j}x_{j+r},\left( x_{k}-ix_{k+r}\right) \right]
=-i\left( x_{k}-ix_{k+r}\right) ,
\end{align}%
leading to 
\begin{align}
i\widehat{J_{x}}\left( \left( x_{k}+ix_{k+r}\right) \right) & =\widehat{%
\mathcal{N}_{b}}\left( \left( x_{k}+ix_{k+r}\right) \right) =-\left(
x_{k}+ix_{k+r}\right) \\
i\widehat{J_{x}}\left( \left( x_{k}-ix_{k+r}\right) \right) & =\widehat{%
\mathcal{N}_{b}}\left( \left( x_{k}-ix_{k+r}\right) \right) =\left(
x_{k}-ix_{k+r}\right) ,
\end{align}%
and 
\begin{align}
\widehat{J_{x}}\left( x_{k}\right) & =-x_{k+r} \\
\widehat{J_{x}}\left( x_{k+r}\right) & =x_{k}.
\end{align}%
$\lceil $%
\begin{align}
& \left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,x_{1}\right]
=x_{1}x_{3}x_{1}+x_{2}x_{4}x_{1}-x_{1}x_{1}x_{3}-x_{1}x_{2}x_{4}=-\frac{1}{2}%
x_{3}-\frac{1}{2}x_{3}=-x_{3} \\
& \left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,x_{2}\right]
=x_{1}x_{3}x_{3}+x_{2}x_{4}x_{3}-x_{3}x_{1}x_{3}-x_{3}x_{2}x_{4}=\frac{1}{2}%
x_{1}+\frac{1}{2}x_{1}=x_{1}
\end{align}%
\begin{align}
& \left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}+ix_{3}\right) %
\right] \\
& =x_{1}x_{3}\left( x_{1}+ix_{3}\right) +x_{2}\left( x_{1}+ix_{3}\right)
-\left( x_{1}+ix_{3}\right) x_{1}x_{3}-\left( x_{1}+ix_{3}\right)
x_{2}x_{4}=-x_{3}+ix_{1}=i\left( x_{1}+ix_{3}\right) \\
& \left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}-ix_{3}\right) %
\right] \\
& =x_{1}x_{3}\left( x_{1}-ix_{3}\right) +x_{2}\left( x_{1}-ix_{3}\right)
-\left( x_{1}-ix_{3}\right) x_{1}x_{3}-\left( x_{1}-ix_{3}\right)
x_{2}x_{4}=-x_{3}-ix_{1}=-i\left( x_{1}-ix_{3}\right)
\end{align}%
\begin{align}
\left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}+ix_{3}\right) %
\right] & =i\left( x_{1}+ix_{3}\right) \\
\left[ \left( x_{1}x_{3}+x_{2}x_{4}\right) ,\left( x_{1}-ix_{3}\right) %
\right] & =-i\left( x_{1}-ix_{3}\right)
\end{align}%
$\rfloor $

Note that $K_{x}\in U\left( \mathcal{A}_{1}\right) \subset \mathcal{B}\left( 
\mathcal{A}_{1}\right) $ and \emph{cannot} be expressed as $\func{adj}\left(
k\right) ,$where $k\in \mathcal{A}_{\left( 2\right) \text{ }}$i.e$.$this
group \emph{cannot be realized as inner autmorphism generated the Lie algebra%
} $\mathcal{A}_{\left( 2\right) \text{ }}.$

The space $\mathbf{x}_{1}$ can be viewed as a $r$-dimensional complex space
by taking complex linear combinations of $\left\{ \left. x_{j}\right\vert
1\leq j\leq r\right\} $ i.e. 
\begin{equation}
\mathbf{x}_{1\mathbb{C}}=\mathbb{C-}\limfunc{linspan}\left\{ \left.
x_{j}\right\vert 1\leq j\leq r\right\} =\mathbf{x}_{1}\oplus _{\mathbb{C}}i%
\mathbf{x}_{1}=\mathbf{x}_{1}\oplus _{\mathbb{C}}\widehat{J_{x}}\mathbf{x}%
_{1}\cong \mathbf{x}_{1}\oplus _{\mathbb{C}}\mathbf{x}_{2}.
\end{equation}%
This produces a $2r$-dimensional real space 
\begin{equation}
\mathbf{x}_{1\mathbb{R}}=\mathbb{R-}\limfunc{linspan}\left\{ \left.
x_{j},ix_{j}\right\vert 1\leq j\leq r\right\} ,
\end{equation}%
which can be expressed as the real direct sum 
\begin{equation}
\mathbf{x}_{1\mathbb{R}}=\mathbf{x}_{1}\oplus _{\mathbb{R}}i\mathbf{x}_{1}=%
\mathbf{x}_{1}\oplus _{\mathbb{R}}\widehat{J_{x}}\mathbf{x}_{1}\cong \mathbf{%
x}_{1}\oplus _{\mathbb{R}}\mathbf{x}_{2},
\end{equation}%
leading to 
\begin{equation}
\mathcal{F}_{1\mathbb{R}}\cong \mathbf{x}_{1\mathbb{R}}\oplus _{\mathbb{R}}%
\mathbf{x}_{2\mathbb{R}}.
\end{equation}%
The spaces $\mathbf{x}_{2\mathbb{C}}$ and $\mathbf{x}_{2\mathbb{R}}$ can be
defined in a similar manner. The $2r$-complex space $\mathcal{A}_{1}$ can be
expressed as the complex direct sum 
\begin{equation}
\mathcal{A}_{1}\cong \mathcal{A}_{1\mathbb{C}}=\mathbf{x}_{1\mathbb{C}%
}\oplus _{\mathbb{C}}\mathbf{x}_{2\mathbb{C}}=\mathbf{x}_{1\mathbb{C}}\oplus
_{\mathbb{R}}\mathbf{x}_{2\mathbb{C}}=\mathbf{x}_{1\mathbb{R}}\oplus _{%
\mathbb{C}}\mathbf{x}_{2\mathbb{R}}.
\end{equation}%
(This space of course generates a $4r$-dimensional real space which we do
not use)

The geminal and associated complexification have cannonicl representations 
\begin{gather}
\widehat{J_{x}}\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \mathbb{J}_{x}=\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) ;\widehat{J_{x}}\in \mathcal{B}\left( \mathcal{A}_{1\mathbb{R}%
}\right) \\
g_{x}\left( \left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \wedge \left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}%
\right) \right) \\
=g_{x}\left( 
\begin{array}{ccc}
\mathbf{x}_{1}\wedge \mathbf{x}_{1} & \mathbf{x}_{1}\wedge \mathbf{x}_{2} & 
\mathbf{x}_{2}\wedge \mathbf{x}_{2}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathbf{x}_{1}\wedge \mathbf{x}_{1} & \mathbf{x}_{1}\wedge \mathbf{x}_{2} & 
\mathbf{x}_{2}\wedge \mathbf{x}_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{0} \\ 
\mathbf{1} \\ 
\mathbf{0}%
\end{array}%
\right) \\
g_{x}\in \mathcal{A}_{2\mathbb{R}}\subset \mathcal{A}_{2},\,\widehat{J_{x}}%
\in \mathcal{B}_{a}\left( \mathcal{A}_{1\mathbb{R}}\right) \subset \mathcal{B%
}\left( \mathcal{A}_{1\mathbb{R}}\right) .
\end{gather}%
The correspondence $g_{x}\longleftrightarrow \widehat{J_{x}}$ displays the
isomorphism 
\begin{equation}
\mathcal{A}_{2\mathbb{R}x}\cong \mathcal{B}_{a}\left( \mathcal{A}_{1\mathbb{R%
}}\right) .
\end{equation}%
The representation of the complexification has the properties%
\begin{align}
\mathbb{J}_{x}^{2}& =-\mathbb{I}_{\mathcal{A}_{1}}=\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-\mathbb{I}_{r} & \mathbb{O} \\ 
\mathbb{O} & -\mathbb{I}_{r}%
\end{array}%
\right) \\
\mathbb{J}_{x}^{t}\mathbb{J}_{x}& =\mathbb{J}_{x}\mathbb{J}_{x}^{t}=\mathbb{I%
}_{\mathcal{A}_{1}}=\left( 
\begin{array}{cc}
\mathbb{O} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & -\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{I}_{r}%
\end{array}%
\right) ,
\end{align}%
i.e. $\widehat{J_{x}},\mathbb{J}_{x}\in O\left( 2r,\mathbb{R}\right) $ is a
complex structure. Moreover it defines a symplectic (antisymmetric bilinear)
form $\left\{ \left. a\right\vert b\right\} _{\mathcal{A}_{1x}}$ on the real
vector space $\mathcal{A}_{1\mathbb{R}x}$ by 
\begin{equation}
\left\{ \left. a\right\vert b\right\} _{\mathcal{A}_{1x}}=\left( a\left\vert 
\widehat{J_{x}}\right. b\right) _{\mathcal{A}_{1}},
\end{equation}%
where 
\begin{equation}
\left( \left. a\right\vert \widehat{J_{2rx}}b\right) _{\mathcal{A}%
_{1}}=\left. \left( \left. a\right\vert \widehat{J_{x}}b\right) \right\vert
_{_{\mathcal{A}}},
\end{equation}%
from the inner product 
\begin{equation}
\left( \left. a\right\vert b\right) _{\mathcal{A}_{1}}=\left\langle
\left\langle ab\right\rangle \right\rangle _{0}.
\end{equation}%
In terms of real matrix representations 
\begin{equation}
\left\{ \left. a\right\vert b\right\} _{\mathcal{A}_{1x}}=\left( 
\begin{array}{cc}
\mathbf{a}^{\dagger } & \mathbf{a}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{b}^{\dagger } \\ 
\mathbf{b}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-\mathbf{a} & \mathbf{a}^{\dagger }%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{b}^{\dagger } \\ 
\mathbf{b}%
\end{array}%
\right) =\left( \mathbf{a}^{\dagger }\right) ^{t}\mathbf{b}^{\dagger }-%
\mathbf{a}^{t}\mathbf{b}^{\dagger }.
\end{equation}%
The complex structure $\widehat{J_{x}}$ is left invariant by $O\left( r,%
\mathbb{R}\right) $ 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbb{A}^{t} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{A}^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{A} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{A}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{A}^{t} & \mathbb{O} \\ 
\mathbb{O} & \mathbb{A}^{t}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{A} \\ 
-\mathbb{A} & \mathbb{O}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) .
\end{equation}%
The symplectic form $\left\{ \left. \cdot \right\vert \cdot \right\} _{%
\mathcal{A}_{1x}}$ defines the symplectic group $Sp\left( 2r,\mathbb{R}%
\right) $ by 
\begin{equation}
Sp\left( 2r,\mathbb{R}\right) =\left\{ \left. T\in \mathcal{B}\left( 
\mathcal{A}_{1\mathbb{R}}\right) \right\vert \left\{ \left. Ta\right\vert
Tb\right\} _{\mathcal{A}_{1x}}=\left\{ \left. a\right\vert b\right\} _{%
\mathcal{A}_{1x}}\right\} ,
\end{equation}%
which gives in terms of representations 
\begin{equation}
\mathbb{T}_{x}^{t}\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) \mathbb{T}_{x}=\left( 
\begin{array}{cc}
\mathbb{O} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}%
\end{array}%
\right) .
\end{equation}

General transformations of the bases that preserve the CAR are given by 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U} & \overline{\mathbb{V}} \\ 
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)
\end{equation}%
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{y}_{+} & \mathbf{y}_{-}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & \func{Im}\left( \mathbb{V+U}\right) \\ 
\func{Im}\left( \mathbb{V}-\mathbb{U}\right) & \func{Re}\left( \mathbb{U-V}%
\right)%
\end{array}
\right) .
\end{equation}
If $\mathbb{V=O}$ 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{O} \\ 
\mathbb{O} & \overline{\mathbb{U}}%
\end{array}
\right) ,
\end{equation}
the direct sum decomposition 
\begin{equation}
\mathbf{b}^{\dagger}\oplus\mathbf{b}
\end{equation}
is maintained and 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{O} \\ 
\mathbb{O} & \overline{\mathbb{U}}%
\end{array}
\right) \in U\left( r\right) .
\end{equation}
However 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U+V}\right) & \func{Im}\left( \mathbb{V+U}\right) \\ 
\func{Im}\left( \mathbb{V}-\mathbb{U}\right) & \func{Re}\left( \mathbb{U-V}%
\right)%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U}\right) & \func{Im}\left( \mathbb{U}\right) \\ 
-\func{Im}\left( \mathbb{U}\right) & \func{Re}\left( \mathbb{U}\right)%
\end{array}
\right)
\end{equation}
and the direct sum decomposition 
\begin{equation}
\mathbf{b}^{\dagger}\oplus\mathbf{b}
\end{equation}
is not in general maintained, unless 
\begin{equation}
\func{Im}\left( \mathbb{U}\right) =\mathbb{O},
\end{equation}
i.e. 
\begin{equation}
\left( 
\begin{array}{cc}
\func{Re}\left( \mathbb{U}\right) & \mathbb{O} \\ 
\mathbb{O} & \func{Re}\left( \mathbb{U}\right)%
\end{array}
\right) \in O\left( r,\mathbb{R}\right) .
\end{equation}

$\lceil$Example for $\func{Im}\left( \mathbb{U}\right) \neq\mathbb{O}$%
\begin{align}
\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) & =\left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}} & 0 \\ 
0 & e^{-i\boldsymbol{\theta}}%
\end{array}
\right) =\left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}}\mathbf{b}^{\dagger} & e^{-i\boldsymbol{\theta}}%
\mathbf{b}%
\end{array}
\right) \\
\left( 
\begin{array}{cc}
\mathbf{y}_{+} & \mathbf{y}_{-}%
\end{array}
\right) & =\left( 
\begin{array}{cc}
\mathbf{c}^{\dagger} & \mathbf{c}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}}\mathbf{b}^{\dagger}+e^{-i\boldsymbol{\theta}}%
\mathbf{b} & ie^{i\boldsymbol{\theta}}\mathbf{b}^{\dagger}-ie^{-i\boldsymbol{%
\theta}}\mathbf{b}%
\end{array}
\right) \\
& =\left[ \left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) \right] \left[ \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & \mathbb{I} \\ 
-i\mathbb{I} & i\mathbb{I}%
\end{array}
\right) \left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}} & 0 \\ 
0 & e^{-i\boldsymbol{\theta}}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) \right] \\
& =\left[ \left( 
\begin{array}{cc}
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I} & i\mathbb{I} \\ 
\mathbb{I} & -i\mathbb{I}%
\end{array}
\right) \right] \left[ \frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{I} & \mathbb{I} \\ 
-i\mathbb{I} & i\mathbb{I}%
\end{array}
\right) \left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}} & ie^{i\boldsymbol{\theta}} \\ 
e^{-i\boldsymbol{\theta}} & -ie^{-i\boldsymbol{\theta}}%
\end{array}
\right) \right] \\
& =\left( 
\begin{array}{cc}
\mathbf{x}_{+} & \mathbf{x}_{-}%
\end{array}
\right) \frac{1}{2}\left( 
\begin{array}{cc}
e^{i\boldsymbol{\theta}}+e^{-i\boldsymbol{\theta}} & i\left( e^{i\boldsymbol{%
\theta}}\mathbb{-}e^{-i\boldsymbol{\theta}}\right) \\ 
i\left( e^{-i\boldsymbol{\theta}}\mathbb{-}e^{i\boldsymbol{\theta}}\right) & 
e^{i\boldsymbol{\theta}}+e^{-i\boldsymbol{\theta}}%
\end{array}
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{+} & \mathbf{x}_{-}%
\end{array}
\right) \left( 
\begin{array}{cc}
\cos\boldsymbol{\theta} & \sin\boldsymbol{\theta} \\ 
-\sin\boldsymbol{\theta} & \cos\boldsymbol{\theta}%
\end{array}
\right) ,
\end{align}
as%
\begin{align}
2\cos\theta & =e^{i\theta}+e^{-i\theta} \\
2\sin\theta & =i\left( e^{i\theta}-e^{-i\theta}\right) .
\end{align}
$\rfloor$

\bigskip

Hence 
\begin{align}
\mathcal{A}& =\tbigwedge \mathcal{A}_{1}=\tbigwedge \left( \mathbf{b}%
^{\dagger }\oplus \mathbf{b}\right) =\tbigwedge \mathbf{b}^{\dagger }\otimes
\tbigwedge \mathbf{b} \\
\mathcal{A}& =\tbigwedge \mathcal{A}_{1}=\tbigwedge \left( \mathbf{x}%
_{1}\oplus \mathbf{x}_{2}\right) =\tbigwedge \mathbf{x}_{1}\otimes
\tbigwedge \mathbf{x}_{2}.
\end{align}%
$\lceil K_{2rx}$ is unitary $\in U\left( 2r\right) $ i.e. 
\begin{align}
\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) & =\frac{1}{2}\left( 
\begin{array}{cc}
2\mathbb{I}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & 2\mathbb{I}_{r}%
\end{array}%
\right) =\mathbb{I}_{2r} \\
\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) & =\frac{1}{2}\left( 
\begin{array}{cc}
2\mathbb{I}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & 2\mathbb{I}_{r}%
\end{array}%
\right) =\mathbb{I}_{2r}
\end{align}%
and left invariant by the unitary group $U\left( r\right) $ i.e. 
\begin{align}
& \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger } & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger }%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger } & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger }%
\end{array}%
\right) \\
& =\left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right) \mathbb{I}_{2r}\left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger } & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger }%
\end{array}%
\right) =\mathbb{I}_{2r}
\end{align}%
and%
\begin{align*}
& \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger } & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger }%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{U}_{r} \\ 
-i\mathbb{U}_{r} & i\mathbb{U}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r}^{\dagger } & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}^{\dagger }%
\end{array}%
\right) \\
& =\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{U}_{r}\mathbb{U}_{r}^{\dagger } \\ 
-i\mathbb{U}_{r}\mathbb{U}_{r}^{\dagger } & i\mathbb{I}_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) .
\end{align*}%
$\rfloor \lceil $%
\begin{align}
& \frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \\
& =\frac{1}{2}\left( 
\begin{array}{cc}
\mathbb{U}_{r} & i\mathbb{U}_{r} \\ 
\mathbb{U}_{r} & -i\mathbb{U}_{r}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right)
\end{align}%
\begin{equation}
\left[ \left( 
\begin{array}{cc}
\mathbb{U}_{r} & \mathbb{O}_{r} \\ 
\mathbb{O}_{r} & \mathbb{U}_{r}%
\end{array}%
\right) ,\left( 
\begin{array}{cc}
\mathbb{I}_{r} & \mathbb{I}_{r} \\ 
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}%
\right) \right] =\mathbb{O}_{2r}
\end{equation}%
$\rfloor $

Different decompositions are determined by the coset 
\begin{equation}
\left[ O\left( 2r,\mathbb{R}\right) /U\left( r\right) \right] \left[ U\left(
r\right) /O\left( r,\mathbb{R}\right) \right]
\end{equation}%
\begin{equation}
O\left( 2r,\mathbb{R}\right) \supset U\left( r\right) \supset O\left( r,%
\mathbb{R}\right)
