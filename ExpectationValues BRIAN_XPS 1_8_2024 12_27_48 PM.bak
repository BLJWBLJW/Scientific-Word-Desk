\begin{definition}
The real Hilbert spaces $\mathfrak{H}_{\varphi \mathbb{R}}$ 
\begin{equation}
\mathfrak{H}_{\varphi \mathbb{R}}=\mathfrak{H\oplus }_{\mathbb{R}}\sigma
_{\varphi }\left( \mathfrak{H}\right)
\end{equation}%
are Clifford Algebra \emph{Index Spaces.}
\end{definition}

\begin{remark}
\begin{equation}
\mathfrak{H}\cong \mathfrak{H}_{\varphi \mathbb{R}}\oplus _{\mathbb{R}}i%
\mathfrak{H}_{\varphi \mathbb{R}}\cong \mathfrak{H}_{\psi \mathbb{R}}\oplus
_{\mathbb{R}}i\mathfrak{H}_{\psi \mathbb{R}}.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathfrak{X:H}_{\varphi \mathbb{R}}\oplus _{\mathbb{R}}i\mathfrak{H}%
_{\varphi \mathbb{R}}\rightarrow \mathcal{A}_{1}^{Cliff}\subset \mathcal{A}.
\end{equation}
\end{remark}

\begin{lemma}
\begin{equation}
\mathcal{A}_{m}^{Cliff}=\bigwedge\nolimits^{m}\mathcal{A}_{1}^{Cliff}.
\end{equation}
\end{lemma}

\begin{lemma}
$\mathcal{A}$ can be generated as the exterior algebra generated by the
grade $1$ subspace $\mathcal{A}_{1}^{Cliff}$ 
\begin{equation}
\mathcal{A}=\bigoplus\limits_{0\leq m\leq 2r}\mathcal{A}_{m}^{Cliff}=%
\bigwedge \left( \mathcal{A}_{1}^{Cliff}\right) .
\end{equation}%
The operators $\mathfrak{X}\left( \varphi \right) $ are self adjoint 
\begin{equation}
\mathfrak{X}\left( \varphi \right) =\frac{1}{\sqrt{2}}\left( \mathfrak{s}%
^{\dagger }\left( \varphi \right) +\mathfrak{s}\left( \varphi \right)
\right) =\mathfrak{X}\left( \varphi \right) ^{\dagger }
\end{equation}%
and this leads to
\end{lemma}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{X}\left( i\varphi \right) =\frac{1}{\sqrt{2}}\left( \mathfrak{s}%
^{\dagger }\left( i\varphi \right) +\mathfrak{s}\left( i\varphi \right)
\right) =\frac{i}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( \varphi
\right) -\mathfrak{s}\left( \varphi \right) \right) =\mathfrak{X}\left(
i\varphi \right) ^{\dagger }
\end{equation}

and

\item 
\begin{equation}
\mathfrak{X}\left( \varphi \right) -i\mathfrak{X}\left( i\varphi \right) =%
\frac{1}{\sqrt{2}}\left( \mathfrak{s}^{\dagger }\left( \varphi \right) +%
\mathfrak{s}\left( \varphi \right) \right) +\frac{1}{\sqrt{2}}\left( 
\mathfrak{s}^{\dagger }\left( \varphi \right) -\mathfrak{s}\left( \varphi
\right) \right) =\frac{2}{\sqrt{2}}\mathfrak{s}^{\dagger }\left( \varphi
\right) =\sqrt{2}\mathfrak{s}^{\dagger }\left( \varphi \right)
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{remark}
The inverse transformations Majorano to Creation and Annihiation operators
are
\end{remark}

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\mathfrak{s}^{\dagger }\left( \varphi \right) =\frac{1}{\sqrt{2}}\left( 
\mathfrak{X}\left( \varphi \right) -i\mathfrak{X}\left( i\varphi \right)
\right)
\end{equation}%
and

\item 
\begin{equation}
\mathfrak{s}\left( \varphi \right) =\frac{1}{\sqrt{2}}\left( \mathfrak{X}%
\left( \varphi \right) +i\mathfrak{X}\left( i\varphi \right) \right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\begin{definition}
\begin{equation}
\mathfrak{s}^{\dagger }\left( f\right) =\mathfrak{s}\left( f\right)
^{\dagger },\,f\in \mathfrak{H.}
\end{equation}
\end{definition}

\begin{definition}
The exterior algebra ${\large \wedge }\left( \mathfrak{H}\right) $%
\begin{equation}
{\Large \wedge }\left( \mathfrak{H}\right) =\bigoplus\limits_{0\leq n\leq r}%
{\large \wedge }^{n}\mathfrak{H.}
\end{equation}

\begin{enumerate}
\item The exterior algebra ${\Large \wedge }\left( \mathfrak{H\oplus H}%
\right) $%
\begin{equation}
{\Large \wedge }\left( \mathfrak{H\oplus H}\right) =\bigoplus\limits_{0\leq
n\leq r}{\large \wedge }^{n}\left( \mathfrak{H\oplus H}\right)
\,=\bigoplus\limits_{0\leq n\leq r}\overset{n}{\overbrace{\left( \mathfrak{%
H\oplus H}\right) \wedge \mathfrak{\cdots }\wedge \left( \mathfrak{H\oplus H}%
\right) }}\,=\bigoplus\limits_{0\leq n\leq r}{\large \oplus }^{2^{n}}%
\mathfrak{H}^{n}
\end{equation}%
$\lceil $This can be seen by 
\begin{eqnarray}
{\Large \wedge }^{2}\left( \mathfrak{H}\oplus \mathfrak{H}\right) &=&\left( 
\mathfrak{H}\oplus \mathfrak{H}\right) \wedge \left( \mathfrak{H}\oplus 
\mathfrak{H}\right) =\mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}%
\wedge \mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}%
\wedge \mathfrak{H=H}^{2}\oplus \mathfrak{H}^{2}\oplus \mathfrak{H}%
^{2}\oplus \mathfrak{H}^{2}=4\mathfrak{H}^{2}=2^{2}\mathfrak{H}^{2}\equiv 
{\large \oplus }^{2^{2}}\mathfrak{H}^{2} \\
{\Large \wedge }^{3}\left( \mathfrak{H}\oplus \mathfrak{H}\right) &=&\left( 
\mathfrak{H}\oplus \mathfrak{H}\right) \wedge \left( \mathfrak{H}\oplus 
\mathfrak{H}\right) \wedge \left( \mathfrak{H}\oplus \mathfrak{H}\right) =%
\mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\oplus 
\mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\wedge
\left( \mathfrak{H}\oplus \mathfrak{H}\right) \\
&=&\mathfrak{H}\wedge \mathfrak{H}\wedge \mathfrak{H\oplus H}\wedge 
\mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\wedge 
\mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\wedge \mathfrak{H}\oplus 
\mathfrak{H}\wedge \mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}\wedge 
\mathfrak{H}\wedge \mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\wedge 
\mathfrak{H}\oplus \mathfrak{H}\wedge \mathfrak{H}\wedge \mathfrak{H} \\
&=&\mathfrak{H}^{3}\oplus \mathfrak{H}^{3}\oplus \mathfrak{H}^{3}\oplus 
\mathfrak{H}^{3}\oplus \mathfrak{H}^{3}\oplus \mathfrak{H}^{3}\oplus 
\mathfrak{H}^{3}\oplus \mathfrak{H}^{3}=2^{3}\mathfrak{H}^{3}\equiv {\large %
\oplus }^{2^{3}}\mathfrak{H}^{3} \\
&&\vdots \\
{\large \wedge }^{n}\left( \mathfrak{H\oplus H}\right) \, &=&\,\overset{n}{%
\overbrace{\left( \mathfrak{H}\oplus \mathfrak{H}\right) \wedge \mathfrak{%
\cdots }\wedge \left( \mathfrak{H}\oplus \mathfrak{H}\right) }}\,={\large %
\oplus }^{2^{n}}\mathfrak{H}^{n} \\
\bigoplus\limits_{0\leq n\leq r}{\large \wedge }^{n}\left( \mathfrak{H}%
\oplus \mathfrak{H}\right) &=&\bigoplus\limits_{0\leq n\leq r}{\large \oplus 
}^{2^{n}}\mathfrak{H}^{n}.
\end{eqnarray}%
$\rfloor $

\item The exterior algebra ${\large \wedge }\left( \mathfrak{H\oplus H}%
^{d}\right) $%
\begin{equation}
{\Large \wedge }\left( \mathfrak{H\oplus H}^{d}\right)
=\bigoplus\limits_{0\leq n\leq r}{\large \wedge }^{n}\left( \mathfrak{%
H\oplus H}^{d}\right) =\bigoplus\limits_{0\leq m,n\leq r}\left( \left( 
{\large \oplus }^{2^{m}}\mathfrak{H}^{m}\right) \wedge \left( {\large \oplus 
}^{2^{n}}\mathfrak{H}^{dn}\right) \right) .
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
The extension $\boxtimes \left( \mathfrak{s}^{\dagger }\right) $ 
\begin{equation}
\boxtimes \left( \mathfrak{s}^{\dagger }\right) :{\Large \wedge }\left( 
\mathfrak{H}\right) \rightarrow \mathcal{A}
\end{equation}%
of $\mathfrak{s}^{\dagger }$ to the exterior algebra ${\large \wedge }\left( 
\mathfrak{H}\right) $ by 
\begin{equation}
\left. \boxtimes \left( \mathfrak{s}^{\dagger }\right) \right\vert
_{n}=\boxtimes ^{n}\mathfrak{s}^{\dagger },
\end{equation}%
where for a basis $\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq
r\right\} $ the action of $\boxtimes \left( \mathfrak{s}^{\dagger }\right) $
is

\begin{enumerate}
\item 
\begin{equation}
\boxtimes \left( \mathfrak{s}^{\dagger }\right) \left( \varphi
_{j_{1}}\wedge \cdots \wedge \varphi _{j_{n}}\right) =\mathfrak{s}^{\dagger
}\left( \varphi _{j_{1}}\right) \cdots \mathfrak{s}^{\dagger }\left( \varphi
_{j_{n}}\right) ,\,1\leq j_{1}\,<\cdots <j_{n}\leq r,\,1\leq n\leq r
\end{equation}%
and

\item 
\begin{equation}
\boxtimes \left( \mathfrak{s}^{\dagger }\right) \left( \left\vert \phi _{%
\mathfrak{H}}\right\rangle \right) =I_{\mathcal{A}},
\end{equation}%
where $\left\vert \phi _{\mathfrak{H}}\right\rangle $ is the normalized
vector (unique up to a phase factor) generating the grade zero subspace $%
\mathfrak{H}^{0}\equiv {\large \wedge }^{0}\mathfrak{H}$ of the exterior
algebra ${\large \wedge }\left( \mathfrak{H}\right) $ and is the identity
element of this algebra.
\end{enumerate}
\end{definition}

\begin{definition}
The extension $\boxtimes \left( \mathfrak{\Upsilon }\right) $ 
\begin{equation}
\boxtimes \left( \mathfrak{\Upsilon }\right) :{\large \wedge }\left( 
\mathfrak{H\oplus H}\right) \rightarrow \mathcal{A}
\end{equation}%
of $\mathfrak{\Upsilon }$ to the exterior algebra ${\large \wedge }\left( 
\mathfrak{H\oplus H}\right) $ by 
\begin{equation}
\left. \boxtimes \left( \mathfrak{\Upsilon }\right) \right\vert
_{n}=\boxtimes ^{n}\mathfrak{\Upsilon ,}
\end{equation}%
where for bases $\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq
r\right\} $ and $\left\{ \left. \psi _{k}\right\vert 1\leq k\leq r\right\} $
the action of $\mathfrak{C}$ is

\begin{enumerate}
\item 
\begin{equation}
\boxtimes \left( \mathfrak{\Upsilon }\right) \left( \left( \varphi
_{j_{1}}\oplus \psi _{j_{1}}^{d}\right) \wedge \cdots \wedge \left( \varphi
_{j_{n}}\oplus \psi _{j_{n}}^{d}\right) \right) =\mathfrak{\Upsilon }\left(
\varphi _{j_{1}},\psi _{j_{1}}\right) \cdots \mathfrak{\Upsilon }\left(
\varphi _{j_{m}},\psi _{j_{n}}\right) ,1\leq j_{1}\,<\cdots <j_{n}\leq
r,\,1\leq n\leq r
\end{equation}%
and

\item 
\begin{equation}
\boxtimes \left( \mathfrak{\Upsilon }\right) \left( \left\vert \phi _{%
\mathfrak{H}},\phi _{\mathfrak{H}}\right\rangle \right) =I_{\mathcal{A}}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
The extension $\boxtimes \left( \mathfrak{X}\right) $ 
\begin{equation}
\boxtimes \left( \mathfrak{X}\right) :{\large \wedge }\left( \mathfrak{H}%
\right) \rightarrow \mathcal{A}
\end{equation}%
of $\mathfrak{X}$ to the exterior algebra ${\large \wedge }\left( \mathfrak{H%
}\right) $ by 
\begin{equation}
\boxtimes \left( \mathfrak{\Upsilon }\right) \left( \varphi _{j_{1}}\wedge
\cdots \wedge \varphi _{j_{n}}\right) =\mathfrak{\Upsilon }\left( \varphi
_{j_{1},}\varphi _{j_{1},}\right) \cdots \mathfrak{\Upsilon }\left( \varphi
_{j_{n}},\varphi _{j_{n}}\right) =\mathfrak{X}\left( \varphi _{j_{1}}\right)
\cdots \mathfrak{X}\left( \varphi _{j_{n}}\right) ,\,1\leq j_{1}\,<\cdots
<j_{n}\leq r,\,1\leq n\leq r
\end{equation}%
where

\begin{enumerate}
\item 
\begin{equation}
\boxtimes \left( \mathfrak{X}\right) \left( \left\vert \phi _{\mathfrak{H}%
}\right\rangle \right) =I_{\mathcal{A}}.
\end{equation}%
and

\item 
\begin{equation}
\left. \boxtimes \left( \mathfrak{X}\right) \right\vert _{n}=\boxtimes ^{n}%
\mathfrak{X.}
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
The extension $\boxtimes \left( \Omega \right) $%
\begin{equation}
\boxtimes \left( \Omega \right) :{\large \wedge }\left( \mathfrak{H\oplus H}%
^{d}\right) \rightarrow \mathcal{A}
\end{equation}%
of $\Omega $ to the exterior algebra ${\large \wedge }\left( \mathfrak{%
H\oplus H}^{d}\right) $ by 
\begin{equation}
\left. \boxtimes \left( \Omega \right) \right\vert _{n}=\boxtimes ^{n}\Omega
,
\end{equation}%
where

\begin{enumerate}
\item 
\begin{equation}
\boxtimes \left( \Omega \right) \left( \left( \varphi _{j_{1}}\oplus \psi
_{j_{1}}^{d}\right) \wedge \cdots \wedge \left( \varphi _{j_{n}}\oplus \psi
_{j_{n}}^{d}\right) \right) =\Omega \left( \varphi _{j_{1}},\psi
_{j_{1}}^{d}\right) \cdots \Omega \left( \varphi _{j_{n}},\psi
_{j_{n}}^{d}\right) ,\,1\leq j_{1}\,<\cdots <j_{n}\leq r,\,1\leq n\leq r
\end{equation}%
and

\item 
\begin{equation}
\boxtimes \left( \Omega \right) \left( \left\vert \phi _{\mathfrak{H}},\phi
_{\mathfrak{H}}^{d}\right\rangle \right) =I_{\mathcal{A}}.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
Creation operators $\left\{ \left. a_{j}^{\dagger }\right\vert 1\leq j\leq
r\right\} $ wrt a basis $\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq
r\right\} $%
\begin{equation}
a_{j}^{\dagger }=\mathfrak{s}^{\dagger }\left( \varphi _{j}\right) ,\,1\leq
j\leq r.
\end{equation}

\begin{enumerate}
\item Majorona operators $\left\{ \left. x_{j}\right\vert 1\leq j\leq
2r\right\} $ wrt a basis $\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq
r\right\} $

\begin{enumerate}
\item 
\begin{equation}
x_{j}=\mathfrak{X}\left( \varphi _{j}\right) =\frac{1}{\sqrt{2}}\left( 
\mathfrak{s}^{\dagger }\left( \varphi _{j}\right) +\mathfrak{s}\left(
\varphi _{j}\right) \right) ,\,1\leq j\leq r
\end{equation}

\item 
\begin{equation}
x_{j+r}=\mathfrak{X}\left( i\varphi _{j}\right) =\frac{i}{\sqrt{2}}\left( 
\mathfrak{s}^{\dagger }\left( \varphi _{j}\right) -\mathfrak{s}\left(
\varphi _{j}\right) \right) ,\,1\leq j\leq r.
\end{equation}
\end{enumerate}
\end{enumerate}
\end{definition}

\begin{remark}
Recall 
\begin{equation}
\mathfrak{X:H}_{\varphi \mathbb{R}}\oplus _{\mathbb{R}}i\mathfrak{H}%
_{\varphi \mathbb{R}}\rightarrow \mathcal{A}_{1}^{Cliff}\subset \mathcal{A}
\end{equation}%
and 
\begin{equation}
\mathfrak{\Upsilon }:\mathfrak{H}\oplus \mathfrak{H}\rightarrow \mathcal{A}.
\end{equation}
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{x}_{<} & \mathbf{x}_{>}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{a}^{\dagger } & \mathbf{a}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbf{a}^{\dagger }+\mathbf{a} & i\left( \mathbf{a}^{\dagger }-\mathbf{a}%
\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) & \mathfrak{s}\left( 
\mathbf{\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
