\prod\limits_{1\leq k\leq 2}\left( \widetilde{x}_{j_{k}}+i\widetilde{x}%
_{r+j_{k}}\right) =\sum_{1\leq \sigma _{1},\cdots ,\sigma _{2}\leq
2}i^{\tsum\limits_{1\leq k\leq n}\epsilon \left( \sigma _{k}\right)
}\prod\limits_{1\leq k\leq n}\widetilde{x}_{\lambda \left( \sigma
_{k}\right) +j_{k}}=\sum_{1\leq \sigma _{1},\sigma _{2}\leq 2}i^{\epsilon
\left( \sigma _{1}\right) +\epsilon \left( \sigma _{2}\right) }x_{\lambda
\left( \sigma _{1}\right) +j_{1}}x_{\lambda \left( \sigma _{2}\right) +j_{2}}
\end{equation*}

\item 
\begin{eqnarray}
\lambda \left( 1\right) &=&0,\lambda \left( 2\right) =r,\qquad \epsilon
\left( 1\right) =0,\epsilon \left( 2\right) =1 \\
&&%
\begin{array}{cccc}
x_{j_{1}}x_{j_{2}} & ix_{r+j_{1}}x_{j_{2}} & ix_{j_{1}}x_{r+j_{2}} & 
i^{2}x_{r+j_{1}}x_{r+j_{2}} \\ 
i^{\epsilon \left( \sigma _{1}\right) +\epsilon \left( \sigma _{2}\right)
}x_{\lambda \left( \sigma _{1}\right) +j_{1}}x_{\lambda \left( \sigma
_{2}\right) +j_{2}} & i^{\epsilon \left( \sigma _{1}\right) +\epsilon \left(
\sigma _{2}\right) }x_{\lambda \left( \sigma _{1}\right) +j_{1}}x_{\lambda
\left( \sigma _{2}\right) +j_{2}} & i^{\epsilon \left( \sigma _{1}\right)
+\epsilon \left( \sigma _{2}\right) }x_{\lambda \left( \sigma _{1}\right)
+j_{1}}x_{\lambda \left( \sigma _{2}\right) +j_{2}} & i^{\epsilon \left(
\sigma _{1}\right) +\epsilon \left( \sigma _{2}\right) }x_{\lambda \left(
\sigma _{1}\right) +j_{1}}x_{\lambda \left( \sigma _{2}\right) +j_{2}} \\ 
i^{\epsilon \left( 1\right) +\epsilon \left( 1\right) }x_{\lambda \left(
1\right) +j_{1}}x_{\lambda \left( 1\right) +j_{2}} & i^{\epsilon \left(
2\right) +\epsilon \left( 1\right) }x_{\lambda \left( 2\right)
+j_{1}}x_{\lambda \left( 1\right) +j_{2}} & i^{\epsilon \left( 1\right)
+\epsilon \left( 1\right) }x_{\lambda \left( 1\right) +j_{1}}x_{\lambda
\left( 2\right) +j_{2}} & i^{\epsilon \left( 1\right) +\epsilon \left(
2\right) }x_{\lambda \left( 2\right) +j_{1}}x_{\lambda \left( 2\right)
+j_{2}}%
\end{array}%
\end{eqnarray}
\end{enumerate}

\begin{corollary}
$f$ is a fock state i.e. quasi free if 
\begin{gather}
\sum_{1\leq \sigma _{1},\cdots ,\sigma _{n}\leq 2}i^{\tsum\limits_{1\leq
k\leq n}\epsilon \left( \sigma _{k}\right) }\Phi _{f}\left(
\prod\limits_{1\leq k\leq n}\left( \widetilde{x}_{\lambda \left( \sigma
_{k}\right) +j_{k}}\right) \right) =0 \\
\quad 1\leq j_{1}<\cdots <j_{n}\leq r,1\leq n\leq r.
\end{gather}
\end{corollary}

\begin{proof}
$\phi $%
\begin{eqnarray}
\Phi _{f}\left( \left( \widetilde{x}_{j_{1}}+i\widetilde{x}_{j_{1}+r}\right)
\cdots \left( \widetilde{x}_{j_{n}}+i\widetilde{x}_{j_{n}+r}\right) \right)
&=&\Phi _{f}\left( \prod\limits_{1\leq k\leq n}\left( \widetilde{x}_{j_{k}}+i%
\widetilde{x}_{r+j_{k}}\right) \right) =\Phi _{f}\left( \sum_{1\leq \sigma
_{1},\cdots ,\sigma _{n}\leq 2}i^{\tsum\limits_{1\leq k\leq n}\epsilon
\left( \sigma _{k}\right) }\prod\limits_{1\leq k\leq n}\widetilde{x}%
_{\lambda \left( \sigma _{k}\right) +j_{k}}\right) \\
&=&\sum_{1\leq \sigma _{1},\cdots ,\sigma _{n}\leq 2}i^{\tsum\limits_{1\leq
k\leq n}\epsilon \left( \sigma _{k}\right) }\Phi _{f}\left(
\prod\limits_{1\leq k\leq n}\left( \widetilde{x}_{\lambda \left( \sigma
_{k}\right) +j_{k}}\right) \right)
\end{eqnarray}
\end{proof}

\begin{example}
$r=2,n=2$%
\begin{eqnarray}
\Phi _{f}\left( \left( \widetilde{x}_{1}+i\widetilde{x}_{3}\right) \left( 
\widetilde{x}_{2}+i\widetilde{x}_{4}\right) \right) &=&\Phi _{f}\left( 
\widetilde{x}_{1}\widetilde{x}_{2}\right) +i\Phi _{f}\left( \widetilde{x}_{1}%
\widetilde{x}_{4}\right) +i\Phi _{f}\left( \widetilde{x}_{3}\widetilde{x}%
_{2}\right) -\Phi _{f}\left( \widetilde{x}_{3}\widetilde{x}_{4}\right) =0 \\
&\Rightarrow &\Phi _{f}\left( \widetilde{x}_{1}\widetilde{x}_{2}\right)
=\Phi _{f}\left( \widetilde{x}_{3}\widetilde{x}_{4}\right) \quad \&\quad
\Phi _{f}\left( \widetilde{x}_{1}\widetilde{x}_{4}\right) =\Phi _{f}\left( 
\widetilde{x}_{2}\widetilde{x}_{3}\right) .
\end{eqnarray}
\end{example}

\begin{example}
$r=2,n=1$%
\begin{eqnarray}
\Phi _{f}\left( \left( \widetilde{x}_{1}+i\widetilde{x}_{3}\right) \right)
&=&\Phi _{f}\left( \widetilde{x}_{1}\right) +i\Phi _{f}\left( \widetilde{x}%
_{3}\right) =0 \\
&\Rightarrow &\Phi _{f}\left( \widetilde{x}_{1}\right) =\Phi _{f}\left( 
\widetilde{x}_{3}\right) =0.
\end{eqnarray}
\end{example}

\begin{remark}
$f$ is faithful if 
\begin{equation}
f\left( X^{\dagger }X\right) =0\,\forall X\in \mathcal{A\,}\Leftrightarrow
f=0.
\end{equation}
\end{remark}

\begin{remark}
$f$ is faithful $\Leftrightarrow $ $\Phi _{f}$ is faithful $\Leftrightarrow $
$\ker \left\{ \Phi _{f}\right\} $ $=\phi .$
\end{remark}

\subparagraph{Expansions of Operators belonging to $\mathcal{A}$}

\begin{remark}
\begin{enumerate}
\item If $r<\infty $ then 
\begin{gather}
X_{\left[ r\right] }=\sum_{0\leq j_{1}<\cdots <j_{n}\leq r}x_{j_{1}}\cdots
x_{j_{n}}\mathcal{R}_{x}\left( X_{\left[ r\right] n}\right) _{j_{1}\cdots
j_{n}}=\left\langle \left\langle X_{\left[ r\right] }\right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq n\leq r}\sum_{1\leq
j_{1}<\cdots <j_{n}\leq r}x_{j_{1}}\cdots x_{j_{n}}\mathcal{R}_{x}\left( X_{%
\left[ r\right] n}\right) _{j_{1}\cdots j_{n}} \\
=\limfunc{tr}\left\{ \mathcal{R}_{a}\left( X_{\left[ r\right] }\right)
\right\} I_{\mathcal{A}}+\sum_{1\leq n\leq r}\sum_{1\leq j_{1}<\cdots
<j_{n}\leq r}x_{j_{1}}\cdots x_{j_{n}}\mathcal{R}_{x}\left( X_{\left[ r%
\right] n}\right) _{j_{1}\cdots j_{n}} \\
\parallel \\
\sum_{0\leq m,n\leq r}\sum_{\substack{ 1\leq j_{1}<\cdots <j_{m}\leq r  \\ %
1\leq k_{1}<\cdots <k_{n}\leq r}}a_{j_{1}}^{\dagger }\cdots
a_{j_{m}}^{\dagger }a_{k_{n}}\cdots a_{k_{1}}\mathcal{R}_{a}\left( X_{\left[
r\right] }\right) _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}=\mathcal{R}%
_{a}\left( X\right) _{00}I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq
r}a_{j_{1}}^{\dagger }\mathcal{R}_{a}\left( X_{\left[ r\right] }\right)
_{j_{1}0}+\sum_{1\leq j_{1}\leq r}a_{j_{1}}\mathcal{R}_{a}\left( X_{\left[ r%
\right] }\right) _{0j_{1}} \\
+\sum_{1\leq m,n\leq r}\sum_{\substack{ 1\leq j_{1}<\cdots <j_{m}\leq r  \\ %
1\leq k_{1}<\cdots <k_{n}\leq r}}a_{j_{1}}^{\dagger }\cdots
a_{j_{m}}^{\dagger }a_{k_{n}}\cdots a_{k_{1}}\mathcal{R}_{a}\left( X_{\left[
r\right] }\right) _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}},
\end{gather}%
where%
\begin{equation}
\limfunc{tr}\left\{ I_{\mathcal{A}}\right\} =2^{-2r}\limfunc{Tr}\left\{ I_{%
\mathcal{A}}\right\} =1.
\end{equation}

\item The Clifford Algebra norm $\left\Vert X_{\left[ r\right] }\right\Vert
_{Cl\left( \mathcal{A}\right) }^{2}$ is defined as 
\begin{equation}
\left\Vert X_{\left[ r\right] }\right\Vert _{Cl\left( \mathcal{A}\right)
}^{2}=\sum_{0\leq p\leq r}\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots <j_{p}\leq
2r}\left\vert \mathcal{R}_{x}\left( X_{\left[ r\right] p}\right)
_{j_{1}\cdots j_{p}}\right\vert ^{2}=\left\langle \left\langle X_{\left[ r%
\right] }^{\dagger }X_{\left[ r\right] }\right\rangle \right\rangle _{0}.
\end{equation}

\item If $r=\infty $ let%
\begin{equation}
X=w^{\ast }\text{-}\lim_{r\rightarrow \infty }\left\{ X_{\left[ r\right]
}\right\}
\end{equation}%
then%
\begin{equation}
\limfunc{Tr}\left\{ X\right\} =\limfunc{Tr}\left\{ w^{\ast }\text{-}%
\lim_{r\rightarrow \infty }\left\{ X_{\left[ r\right] }\right\} \right\}
\neq w^{\ast }\text{-}\lim_{r\rightarrow \infty }\left\{ \limfunc{Tr}\left\{
X_{\left[ r\right] }\right\} \right\}
\end{equation}
\end{enumerate}
\end{remark}

The adjoint operation in a Clifford algebra is defined in terms of complex
conjugation and reversion i.e. 
\begin{equation}
\left( \mathcal{R}_{x}\left( X\right) _{j_{1}\cdots j_{p}}x_{j_{1}}\cdots
x_{j_{p}}\right) ^{\dagger }=\overline{\mathcal{R}_{x}\left( X\right) }%
_{j_{1}\cdots j_{p}}x_{j_{p}}\cdots x_{j_{1}}
\end{equation}%
and 
\begin{equation}
x_{j}^{\dagger }=x_{j};1\leq j\leq 2r.
\end{equation}%
The \emph{scalar coefficient} $\left\langle \left\langle {}\right\rangle
\right\rangle _{0}$ is faithful i.e. 
\begin{equation}
\left\langle \left\langle \xi ^{\dagger }\xi \right\rangle \right\rangle
_{0}=0\Longleftrightarrow \xi =0,
\end{equation}%
as%
\begin{align}
\xi ^{\dagger }\xi & =\left( \left\langle \left\langle \xi \right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq p\leq 2r}\left\langle \xi
^{\dagger }\right\rangle _{p}\right) \left( \sum_{1\leq q\leq
2r}\left\langle \left\langle \xi \right\rangle \right\rangle _{0}I_{\mathcal{%
A}}+\sum_{1\leq q\leq 2r}\left\langle \xi \right\rangle _{q}\right)
=\left\vert \left\langle \left\langle \xi \right\rangle \right\rangle
_{0}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq p\leq 2r}\left\langle \xi
^{\dagger }\right\rangle _{p}+\sum_{1\leq q\leq 2r}\left\langle \xi
\right\rangle _{q}+\sum_{1\leq p,q\leq 2r}\left\langle \xi ^{\dagger
}\right\rangle _{p}\left\langle \xi \right\rangle _{q} \\
& =\left( \left\langle \left\langle \xi \right\rangle \right\rangle _{0}I_{%
\mathcal{A}}+\sum_{1\leq p\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}%
\mathcal{R}_{x}\left( \xi \right) _{j_{1}\cdots j_{p}}x_{j_{1}}\cdots
x_{j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right) ^{\dagger }\left( \left\langle
\left\langle \xi \right\rangle \right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq
q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}_{x}\left( \xi
\right) _{k_{1}\cdots k_{q}}x_{j_{1}}\cdots x_{j_{p}}x_{k_{1}}\cdots
x_{k_{q}}\right) \\
& =\left\vert \left\langle \left\langle \xi \right\rangle \right\rangle
_{0}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq p,q\leq 2r}\sum_{\substack{ %
1\leq j_{1}<\cdots <j_{p}\leq 2r  \\ 1\leq k_{1}<\cdots <k_{q}\leq 2r}}%
\overline{\mathcal{R}_{x}\left( \xi \right) }_{j_{1}\cdots j_{p}}\mathcal{R}%
_{x}\left( \xi \right) _{k_{1}\cdots k_{q}}x_{j_{p}}\cdots
x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}} \\
& =\left( \left\vert \left\langle \left\langle \xi \right\rangle
\right\rangle _{0}\right\vert ^{2}+\sum_{1\leq p\leq r}\left\langle
\left\langle \xi _{p}^{\dagger }\xi _{p}\right\rangle \right\rangle
_{0}\right) I_{\mathcal{A}}+\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots
<k_{q}\leq 2r}\mathcal{R}_{x}\left( \xi ^{\dagger }\xi \right) _{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}=\sum_{0\leq p\leq 2r}\left\langle \xi
^{\dagger }\xi \right\rangle _{p}
\end{align}%
this becomes 
\begin{equation}
\left\vert \left\langle \left\langle \xi ^{\dagger }\xi \right\rangle
\right\rangle _{0}\right\vert ^{2}=\left( \left\vert \left\langle
\left\langle \xi \right\rangle \right\rangle _{0}\right\vert
^{2}+\sum_{1\leq p\leq r}\left\langle \left\langle \xi _{p}^{\dagger }\xi
_{p}\right\rangle \right\rangle _{0}\right) =0\Longleftrightarrow \xi =0
\end{equation}%
i.e. 
\begin{equation}
\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}%
_{x}\left( \xi ^{\dagger }\xi \right) _{k_{1}\cdots k_{q}}x_{k_{1}}\cdots
x_{k_{q}}=0.
\end{equation}%
The scalar term $\left\langle \left\langle \xi _{p}^{\dagger }\xi
_{p}\right\rangle \right\rangle _{0}$ of $\xi _{p}^{\dagger }\xi _{p}$ is
given by 
\begin{equation}
\left\langle \left\langle \xi _{p}^{\dagger }\xi _{p}\right\rangle
\right\rangle _{0}=\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\overline{\mathcal{%
R}_{x}\left( \xi _{p}\right) }_{j_{1}\cdots j_{p}}\mathcal{R}_{x}\left( \xi
_{p}\right) _{j_{1}\cdots j_{p}}=\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots
<j_{p}\leq 2r}\left\vert \mathcal{R}_{x}\left( \xi _{p}\right) _{j_{1}\cdots
j_{p}}\right\vert ^{2},
\end{equation}%
which shows that 
\begin{equation}
\left\langle \left\langle \xi _{p}^{\dagger }\xi _{p}\right\rangle
\right\rangle _{0}\geq 0
\end{equation}%
and 
\begin{equation}
\left\langle \left\langle \xi _{p}^{\dagger }\xi _{p}\right\rangle
\right\rangle _{0}=0\Longleftrightarrow \xi _{p}=0.
\end{equation}%
This reasoning can be extended to $\xi $ to obtain 
\begin{equation}
\left\langle \left\langle \xi ^{\dagger }\xi \right\rangle \right\rangle
_{0}=0\Longleftrightarrow \xi =0,
\end{equation}%
\emph{where} 
\begin{equation}
\left\langle \left\langle \xi ^{\dagger }\xi \right\rangle \right\rangle
_{0}=\sum_{1\leq p\leq r}\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots <j_{p}\leq
2r}\left\vert \mathcal{R}_{x}\left( \xi _{p}\right) _{j_{1}\cdots
j_{p}}\right\vert ^{2}.
\end{equation}%
This shows that $\left\langle \left\langle {}\right\rangle \right\rangle
_{0} $ is faithful as%
\begin{equation}
\left\langle \left\langle \xi ^{\dagger }\xi \right\rangle \right\rangle
_{0}=0\Leftrightarrow \xi =0.
\end{equation}

\begin{theorem}
If $\mathcal{A}$ is $w^{\ast }$-complete then each element $X\in \mathcal{A}$
has a Majorona and Creation/Annihilation $w^{\ast }$-convergent expansion.
\end{theorem}

\begin{remark}
Does this mean they have bases?
\end{remark}

\begin{definition}
\begin{equation}
\left\Vert X\right\Vert _{Cl\left( \mathcal{A}\right) }^{2}=\sum_{0\leq
p\leq r}\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\left\vert 
\mathcal{R}_{x}\left( X_{p}\right) _{j_{1}\cdots j_{p}}\right\vert
^{2}=\left\langle \left\langle X^{\dagger }X\right\rangle \right\rangle _{0}
\end{equation}
\end{definition}

\begin{remark}
Is this norm the same as $\left\Vert {}\right\Vert _{\mathcal{A}}?$ Is this
norm basis$\equiv $generator independent?
\end{remark}

\begin{theorem}
\begin{equation}
X\in \mathcal{A\Rightarrow }\sum_{0\leq p\leq r}\frac{1}{2^{p}}\sum_{1\leq
j_{1}<\cdots <j_{p}\leq 2r}\left\vert \mathcal{R}_{x}\left( X_{p}\right)
_{j_{1}\cdots j_{p}}\right\vert ^{2}=\left\langle \left\langle X^{\dagger
}X\right\rangle \right\rangle _{0}<\infty .
\end{equation}
\end{theorem}

\subsubsection{Positive Elements}

\begin{definition}
Clifford Algebra Hermitian inner product 
\begin{equation}
\left\langle \left. {}\right\vert \right\rangle _{\mathcal{A}}:\mathcal{%
A\times A}\rightarrow \mathbb{C}
\end{equation}%
by%
\begin{equation}
\left\langle \left. \xi \right\vert \eta \right\rangle _{\mathcal{A}%
}=\left\langle \left\langle \xi ^{\dagger }\eta \right\rangle \right\rangle
_{0}=\left\langle \left\langle \xi \right\rangle \right\rangle
_{0}\left\langle \left\langle \eta \right\rangle \right\rangle
_{0}+\sum_{1\leq p\leq 2r}\frac{1}{2^{p}}\sum_{1\leq j_{1}<\cdots <j_{p}\leq
2r}\overline{\mathcal{R}_{x}\left( \xi _{p}\right) }_{j_{1}\cdots j_{p}}%
\mathcal{R}_{x}\left( \eta _{p}\right) _{j_{1}\cdots j_{p}}.
\end{equation}
\end{definition}

In general%
\begin{eqnarray}
\xi ^{\dagger }\eta &=&\left( \left\langle \left\langle \xi \right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq p\leq 2r}\sum_{1\leq
j_{1}<\cdots <j_{p}\leq 2r}\mathcal{R}_{x}\left( \xi _{p}\right)
_{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right) ^{\dagger }\left(
\left\langle \left\langle \eta \right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}%
_{x}\left( \eta _{q}\right) _{k_{1}\cdots k_{q}}x_{k_{1}}\cdots
x_{k_{q}}\right) \\
&=&\left\langle \left\langle \xi ^{\dagger }\eta \right\rangle \right\rangle
_{0}I_{\mathcal{A}}+\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq
2r}\mathcal{R}_{x}\left( \xi ^{\dagger }\eta \right) _{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}} \\
&=&\left\langle \left. \xi \right\vert \eta \right\rangle _{\mathcal{A}}I_{%
\mathcal{A}}+\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}%
\mathcal{R}_{x}\left( \xi ^{\dagger }\eta \right) _{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}.
\end{eqnarray}

All positive elements can be expressed as the products 
\begin{align}
\kappa & =\xi ^{\dagger }\xi \\
& =\left( \left\langle \left\langle \xi \right\rangle \right\rangle _{0}I_{%
\mathcal{A}}+\sum_{1\leq p\leq 2r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}%
\mathcal{R}_{x}\left( \xi _{p}\right) _{j_{1}\cdots j_{p}}x_{j_{1}}\cdots
x_{j_{p}}\right) ^{\dagger }\left( \left\langle \left\langle \xi
\right\rangle \right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq p\leq
2r}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\mathcal{R}_{x}\left( \xi
_{p}\right) _{j_{1}\cdots j_{p}}x_{j_{1}}\cdots x_{j_{p}}\right) \\
& =\left\langle \left\langle \xi ^{\dagger }\xi \right\rangle \right\rangle
_{0}I_{\mathcal{A}}+\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq
2r}\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger }\xi \right\rangle
_{q}\right) _{k_{1}\cdots k_{q}}x_{k_{1}}\cdots x_{k_{q}} \\
& =\left\vert \left\langle \xi \right\rangle _{0}\right\vert ^{2}I_{\mathcal{%
A}}+\sum_{1\leq p,q\leq 2r}\sum_{\substack{ 1\leq j_{1}<\cdots <j_{p}\leq 2r 
\\ 1\leq k_{1}<\cdots <k_{q}\leq 2r}}\overline{\mathcal{R}_{x}\left( \xi
_{p}\right) }_{j_{1}\cdots j_{p}}\mathcal{R}_{x}\left( \xi _{q}\right)
_{k_{1}\cdots k_{q}}x_{j_{p}}\cdots x_{j_{1}}x_{k_{1}}\cdots x_{k_{q}} \\
& =\left\Vert \xi \right\Vert _{\mathcal{A}}^{2}I_{\mathcal{A}}+\sum_{1\leq
q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}_{x}\left(
\left\langle \xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}.
\end{align}%
If $\mathit{\limfunc{tr}}$ is a normalized faithful trace then 
\begin{equation}
\left\Vert \xi \right\Vert _{\mathcal{A}}^{2}=\mathit{\limfunc{tr}}\left\{
\xi ^{\dagger }\xi \right\} =\left\vert \left\langle \left\langle \xi
\right\rangle \right\rangle _{0}\right\vert ^{2}+\sum_{1\leq p\leq 2r}\frac{1%
}{2^{p}}\sum_{1\leq j_{1}<\cdots <j_{p}\leq 2r}\left\vert \mathcal{R}%
_{x}\left( \xi _{p}\right) _{j_{1}\cdots j_{p}}\right\vert ^{2}\in \mathbb{R}%
^{+},
\end{equation}%
thus $\mathit{\limfunc{tr}}$ and the norm $\left\Vert {}\right\Vert _{%
\mathcal{A}}$ in $\mathcal{A}$ can be related by 
\begin{equation}
\left\Vert \xi \right\Vert _{\mathcal{A}}=+\sqrt{\mathit{\limfunc{tr}}%
\left\{ \xi ^{\dagger }\xi \right\} }.
\end{equation}%
(One has to use $^{\dagger }$ and not $^{t}$ as $\mathit{\limfunc{tr}}\left(
\xi ^{t}\xi \right) $ is not neccesarily real. Of course one could start
with a real algebra and construct a complex algebra by cannonical
complexifications, then $^{t}$ would be appropiate. In general $^{\dagger }$
produces a hermitian inner product, while $^{t}$ a complex symmetric one.)

\begin{remark}
$\mathcal{A}$ is a Banach space with norm $\left\Vert {}\right\Vert _{%
\mathcal{A}}$
\end{remark}

\begin{remark}
If $\mathcal{A}$ is a $\infty $-dimensional Clifford algebra and
\end{remark}

\begin{enumerate}
\item $\mathcal{A}$ is a $w^{\ast }$-algebra.

\item $\mathcal{A}$ is not a factor in general as Clifford Algebras are
semisimple.

\item $\tau $ is a normalized faithful trace defined in $\mathcal{A}$ i.e. 
\begin{equation}
\tau :\mathcal{A}\rightarrow \mathbb{C}
\end{equation}

then $\mathcal{A}$ is a Type $II_{1}$ $w^{\ast }$-algebra factor if it is
simple.
\end{enumerate}

As $\xi ^{\dagger }\xi \geq 0$ it must be self adjoint i.e. 
\begin{equation}
\left( \xi ^{\dagger }\xi \right) ^{\dagger }=\xi ^{\dagger }\xi ,
\end{equation}%
one obtains that 
\begin{equation}
\left( \left\Vert \xi \right\Vert ^{2}I_{\mathcal{A}}+\sum_{1\leq q\leq
2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}_{x}\left( \left\langle
\xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}\right) ^{\dagger }=\left\Vert \xi
\right\Vert ^{2}I_{\mathcal{A}}+\sum_{1\leq q\leq 2r}\sum_{1\leq
k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger
}\xi \right\rangle _{q}\right) _{k_{1}\cdots k_{q}}x_{k_{1}}\cdots x_{k_{q}}
\end{equation}%
i.e.%
\begin{equation}
\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\overline{%
\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger }\xi \right\rangle
_{q}\right) _{k_{1}\cdots k_{q}}}x_{k_{q}}\cdots x_{k_{1}}=\sum_{1\leq q\leq
2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}_{x}\left( \left\langle
\xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}x_{k_{1}}\cdots x_{k_{q}}.
\end{equation}%
As 
\begin{equation}
\tsum\limits_{1\leq j\leq q-1}j=\frac{q\left( q-1\right) }{2}
\end{equation}%
one has in the case of a CAR/Clifford algebra 
\begin{eqnarray}
\sum_{1\leq q\leq 2r}\sum_{1\leq k_{1}<\cdots <k_{q}\leq 2r}\overline{%
\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger }\xi \right\rangle
_{q}\right) _{k_{1}\cdots k_{q}}}\left( -1\right) ^{\frac{q\left( q-1\right) 
}{2}}x_{k_{1}}\cdots x_{k_{q}} &=&\sum_{1\leq q\leq 2r}\sum_{1\leq
k_{1}<\cdots <k_{q}\leq 2r}\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger
}\xi \right\rangle _{q}\right) _{k_{1}\cdots k_{q}}x_{k_{1}}\cdots x_{k_{q}}
\\
\overline{\Xi _{k_{1}\cdots k_{q}}}\left( -1\right) ^{\frac{q\left(
q-1\right) }{2}} &=&\Xi _{k_{1}\cdots k_{q}}.
\end{eqnarray}%
If 
\begin{equation}
\frac{q\left( q-1\right) }{2}=\text{even}
\end{equation}%
then 
\begin{equation}
\overline{\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger }\xi
\right\rangle _{q}\right) _{k_{1}\cdots k_{q}}}=\mathcal{R}_{x}\left(
\left\langle \xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}\Rightarrow \overline{\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger
}\xi \right\rangle _{q}\right) _{k_{1}\cdots k_{q}}}+\mathcal{R}_{x}\left(
\left\langle \xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}=2\func{Re}\left\{ \mathcal{R}_{x}\left( \left\langle \xi ^{\dagger
}\xi \right\rangle _{q}\right) _{k_{1}\cdots k_{q}}\right\}
\end{equation}%
if 
\begin{equation}
\frac{q\left( q-1\right) }{2}=\text{odd}
\end{equation}%
then 
\begin{equation}
-\overline{\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger }\xi
\right\rangle _{q}\right) _{k_{1}\cdots k_{q}}}=\mathcal{R}_{x}\left(
\left\langle \xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}\Rightarrow \overline{\mathcal{R}_{x}\left( \left\langle \xi ^{\dagger
}\xi \right\rangle _{q}\right) _{k_{1}\cdots k_{q}}}+\mathcal{R}_{x}\left(
\left\langle \xi ^{\dagger }\xi \right\rangle _{q}\right) _{k_{1}\cdots
k_{q}}=2i\func{Im}\left\{ \mathcal{R}_{x}\left( \left\langle \xi ^{\dagger
}\xi \right\rangle _{q}\right) _{k_{1}\cdots k_{q}}\right\}
\end{equation}

\begin{remark}
\begin{eqnarray}
x_{2}x_{1} &=&\left( -1\right) ^{1}x_{1}x_{2}=-x_{1}x_{2}\qquad \frac{%
q\left( q-1\right) }{2}=\frac{2\left( 1\right) }{2}=1\text{ odd} \\
x_{3}x_{2}x_{1} &=&\left( -1\right) ^{2}\left( -1\right) ^{1}x_{1}x_{2}x_{3}
\\
&=&\left( -1\right) ^{3}x_{1}x_{2}x_{3}=-x_{1}x_{2}x_{3}\qquad \frac{q\left(
q-1\right) }{2}=\frac{3\left( 2\right) }{2}=3\text{ odd} \\
x_{4}x_{3}x_{2}x_{1} &=&\left( -1\right) ^{3}\left( -1\right) ^{2}\left(
-1\right) ^{1}x_{1}x_{2}x_{3}x_{4} \\
&=&\left( -1\right) ^{6}x_{1}x_{2}x_{3}x_{4}=x_{1}x_{2}x_{3}x_{4}\qquad 
\frac{q\left( q-1\right) }{2}=\frac{4\left( 3\right) }{2}=6\text{ even} \\
x_{5}x_{4}x_{3}x_{2}x_{1} &=&\left( -1\right) ^{4}\left( -1\right)
^{3}\left( -1\right) ^{2}\left( -1\right) ^{1}x_{1}x_{2}x_{3}x_{4}x_{5} \\
&=&\left( -1\right)
^{10}x_{1}x_{2}x_{3}x_{4}x_{5}=x_{1}x_{2}x_{3}x_{4}x_{5}\qquad \frac{q\left(
q-1\right) }{2}=\frac{5\left( 4\right) }{2}=10\text{ even} \\
x_{6}x_{5}x_{4}x_{3}x_{2}x_{1} &=&\left( -1\right) ^{5}\left( -1\right)
^{4}\left( -1\right) ^{3}\left( -1\right) ^{2}\left( -1\right)
^{1}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6} \\
&=&\left( -1\right)
^{15}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}=-x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}\text{ odd%
} \\
x_{7}x_{6}x_{5}x_{4}x_{3}x_{2}x_{1} &=&\left( -1\right) ^{6}\left( -1\right)
^{5}\left( -1\right) ^{4}\left( -1\right) ^{3}\left( -1\right) ^{2}\left(
-1\right) ^{1}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7} \\
&=&\left( -1\right)
^{21}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}=-x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}%
\text{ odd} \\
x_{8}x_{7}x_{6}x_{5}x_{4}x_{3}x_{2}x_{1} &=&\left( -1\right) ^{7}\left(
-1\right) ^{6}\left( -1\right) ^{5}\left( -1\right) ^{4}\left( -1\right)
^{3}\left( -1\right) ^{2}\left( -1\right)
^{1}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}x_{8} \\
&=&\left( -1\right)
^{28}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}x_{8}=x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}x_{8}%
\text{ even} \\
x_{9}x_{8}x_{7}x_{6}x_{5}x_{4}x_{3}x_{2}x_{1} &=&\left( -1\right) ^{8}\left(
-1\right) ^{7}\left( -1\right) ^{6}\left( -1\right) ^{5}\left( -1\right)
^{4}\left( -1\right) ^{3}\left( -1\right) ^{2}\left( -1\right)
^{1}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}x_{8}x_{9} \\
&=&\left( -1\right)
^{36}x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}x_{8}x_{9}=x_{1}x_{2}x_{3}x_{4}x_{5}x_{6}x_{7}x_{8}x_{9}%
\text{ even.}
\end{eqnarray}
\end{remark}

Positive elements that belong to $\mathcal{F}_{\left( 2\right) }$ formed
from elements of $\mathcal{F}_{\left( 1\right) }$ have the following form:
letting 
\begin{equation}
\eta =\left\langle \left\langle \xi ^{\dagger }\xi \right\rangle
\right\rangle _{0}\in \mathbb{C}
\end{equation}%
one observes 
\begin{eqnarray}
\kappa _{2} &=&\kappa _{1}^{\dagger }\kappa _{1}=\left\vert \left\langle
\left\langle \xi ^{\dagger }\xi \right\rangle \right\rangle _{0}\right\vert
^{2}I_{\mathcal{A}}+\eta \sum_{1\leq j_{1}\leq 2r}\overline{\mathcal{R}%
_{x}\left( \xi \right) }_{j_{1}}x_{j_{1}}+\overline{\eta }\sum_{1\leq
j_{1}\leq 2r}\mathcal{R}_{x}\left( \xi \right) _{j_{1}}x_{j_{1}}+\sum 
_{\substack{ 1\leq j_{1}\leq 2r  \\ 1\leq k_{1}\leq 2r}}\overline{\mathcal{R}%
_{x}\left( \xi \right) }_{j_{1}}\mathcal{R}_{x}\left( \xi \right)
_{k_{1}}x_{j_{1}}x_{k_{1}} \\
&=&\left\vert \kappa _{1}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq
j_{1}\leq 2r}\left( \overline{\eta }\overline{\mathcal{R}_{x}\left( \xi
\right) }_{j_{1}}+\eta \xi _{j_{1}}\right) x_{j_{1}}+\frac{1}{2}\sum_{1\leq
j_{1}\leq 2r}^{2}\left\vert \mathcal{R}_{x}\left( \xi \right)
_{k_{1}}\right\vert ^{2}I_{\mathcal{A}}+\sum_{1\leq j_{1}<k_{1}\leq
2r}\left( \overline{\mathcal{R}_{x}\left( \xi \right) }_{j_{1}}\mathcal{R}%
_{x}\left( \xi \right) _{k_{1}}x_{j_{1}}x_{k_{1}}+\overline{\mathcal{R}%
_{x}\left( \xi \right) }_{k_{1}}\mathcal{R}_{x}\left( \xi \right)
_{j_{1}}x_{k_{1}}x_{j_{1}}\right) \\
&=&\left( \left\vert \kappa _{1}\right\vert ^{2}+\frac{1}{2}\sum_{1\leq
j_{1}\leq 2r}\left\vert \mathcal{R}_{x}\left( \xi \right)
_{j_{1}}\right\vert ^{2}\right) I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq
2r}\left( \overline{\eta }\overline{\mathcal{R}_{x}\left( \xi \right) }%
_{j_{1}}+\eta \mathcal{R}_{x}\left( \xi \right) _{j_{1}}\right)
x_{j_{1}}+\sum_{1\leq j_{1}<k_{1}\leq 2r}\left( \overline{\mathcal{R}%
_{x}\left( \xi \right) }_{j_{1}}\mathcal{R}_{x}\left( \xi \right) _{k_{1}}-%
\overline{\mathcal{R}_{x}\left( \xi \right) }_{k_{1}}\mathcal{R}_{x}\left(
\xi \right) _{j_{1}}\right) x_{j_{1}}x_{k_{1}} \\
&=&\left( \left\vert \kappa _{1}\right\vert ^{2}+\frac{1}{2}\sum_{1\leq
j_{1}\leq 2r}\left\vert \mathcal{R}_{x}\left( \xi \right)
_{j_{1}}\right\vert ^{2}\right) I_{\mathcal{A}}+2\sum_{1\leq j_{1}\leq 2r}%
\func{Re}\left\{ \eta \overline{\mathcal{R}_{x}\left( \xi \right) }%
_{j_{1}}\right\} x_{j_{1}}+2i\sum_{1\leq j_{1}<k_{1}\leq 2r}\func{Im}\left\{ 
\overline{\mathcal{R}_{x}\left( \xi \right) }_{j_{1}}\mathcal{R}_{x}\left(
\xi \right) _{k_{1}}\right\} x_{j_{1}}x_{k_{1}}.
\end{eqnarray}%
\newline

Positive and self adjoint elements are of the form 
\begin{align}
& \kappa _{1}=\left( \left\Vert \kappa _{1}\right\Vert _{\mathcal{A}%
}^{2}\right) I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq 2r}\mathcal{R}_{x}\left(
\left\langle \kappa _{1}\right\rangle _{1}\right) _{j_{1}}x_{j_{1}} \\
& \kappa _{2}=\left( \left\Vert \kappa _{2}\right\Vert _{\mathcal{A}%
}^{2}\right) I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq 2r}\mathcal{R}_{x}\left(
\left\langle \kappa _{2}\right\rangle _{1}\right)
_{j_{1}}x_{j_{1}}+2i\sum_{1\leq j_{1}<j_{2}\leq 2r}\mathcal{R}_{x}\left(
\left\langle \kappa _{2}\right\rangle _{2}\right)
_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}};\text{ \quad }\mathcal{R}_{x}\left(
\left\langle \kappa _{2}\right\rangle _{1}\right) _{j_{1}},\mathcal{R}%
_{x}\left( \left\langle \kappa _{2}\right\rangle _{2}\right)
_{j_{1}j_{2}}\in \mathbb{R}, \\
& \kappa _{3}=\left( \left\Vert \kappa _{3}\right\Vert _{\mathcal{A}%
}^{2}\right) I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq 2r}\mathcal{R}_{x}\left(
\left\langle \kappa _{3}\right\rangle _{1}\right)
_{j_{1}}x_{j_{1}}+2i\sum_{1\leq j_{1}<k_{1}\leq 2r}\mathcal{R}_{x}\left(
\left\langle \kappa _{3}\right\rangle _{2}\right)
_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}+2i\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}%
\mathcal{R}_{x}\left( \left\langle \kappa _{3}\right\rangle _{2}\right)
_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}};\quad \\
& \mathcal{R}_{x}\left( \left\langle \kappa _{3}\right\rangle _{1}\right)
_{j_{1}},\mathcal{R}_{x}\left( \left\langle \kappa _{3}\right\rangle
_{2}\right) _{j_{1}j_{2}},\mathcal{R}_{x}\left( \left\langle \kappa
_{3}\right\rangle _{2}\right) _{j_{1}j_{2}j_{3}}\in \mathbb{R}, \\
& \kappa _{4}=\left( \left\Vert \kappa _{4}\right\Vert ^{2}\right) I_{%
\mathcal{A}}+\sum_{1\leq j_{1}\leq 2r}\mathcal{R}_{x}\left( \xi \right)
_{j_{1}}x_{j_{1}}+2i\sum_{1\leq j_{1}<j_{2}\leq 2r}\mathcal{R}_{x}\left( \xi
\right) _{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}+2i\sum_{1\leq j_{1}<j_{2}<j_{3}\leq
2r}\mathcal{R}_{x}\left( \xi \right)
_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}}+2\sum_{1\leq
j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}\mathcal{R}_{x}\left( \xi \right)
_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}};\text{ } \\
& \mathcal{R}_{x}\left( \xi \right) _{j_{1}},\mathcal{R}_{x}\left( \xi
\right) _{j_{1}j_{2}},\mathcal{R}_{x}\left( \xi \right) _{j_{1}j_{2}j_{3}},%
\mathcal{R}_{x}\,\left( \xi \right) _{j_{1}j_{2}j_{3}j_{4}}\in \mathbb{R},
\end{align}%
where the coefficients are real.

Positivity is maintained through GNS representations thus 
\begin{equation}
\left\langle \left. \Phi _{f}\left( X\right) \right\vert \Pi _{f}\left(
A\right) \Phi _{f}\left( X\right) \right\rangle \geq 0\text{ }\forall X\in 
\mathcal{A}\text{ }\forall f\in \mathcal{S}\left( \mathcal{A}\right) \subset 
\mathcal{A}^{d}\text{ }\Leftrightarrow \text{ }A\geq 0,
\end{equation}%
which is the same as 
\begin{equation}
f\left( X^{\dagger }AX\right) \geq 0\text{ }\forall X\in \mathcal{A}\text{ }%
\forall f\in \mathcal{S}\left( \mathcal{A}\right) \subset \mathcal{A}^{d}%
\text{ }\Leftrightarrow \text{ }A\geq 0.
\end{equation}%
A necessary condition for $\kappa _{2}\geq 0$ is that 
\begin{equation}
f\left( \left( x_{j_{1}}\cdots x_{j_{n}}\right) ^{\dagger }\kappa
_{2}x_{j_{1}}\cdots x_{j_{n}}\right) =f\left( x_{j_{n}}\cdots
x_{j_{1}}\kappa _{2}x_{j_{1}}\cdots x_{j_{n}}\right) \geq 0
\end{equation}%
for any basis of $\mathcal{A}$ giving 
\begin{equation}
f\left( x_{j_{n}}\cdots x_{j_{1}}\left( \left( \left\vert \kappa
_{2}\right\vert ^{2}\right) I_{\mathcal{A}}+\sum_{1\leq k_{1}\leq 2r}%
\mathcal{R}_{x}\left( \xi _{1}\right) _{k_{1}}x_{k_{1}}+2i\sum_{1\leq
k_{1}<k_{2}\leq 2r}\mathcal{R}_{x}\left( \xi _{2}\right)
_{k_{1}k_{2}}x_{k_{1}}x_{k_{2}}\right) x_{j_{1}}\cdots x_{j_{n}}\right) \geq
0,
\end{equation}%
which gives 
\begin{equation}
\frac{\left\vert \kappa _{2}\right\vert ^{2}}{2^{n}}+\left( -1\right) ^{n}%
\frac{1}{2^{n}}\sum_{1\leq k_{1}\leq 2r}\mathcal{R}_{x}\left( \xi
_{1}\right) _{k_{1}}f\left( x_{k_{1}}\right) +\frac{i}{2^{n-1}}\sum_{1\leq
k_{1}<k_{2}\leq 2r}\mathcal{R}_{x}\left( \xi _{2}\right)
_{k_{1}k_{2}}f\left( x_{k_{1}}x_{k_{2}}\right) \geq 0.
\end{equation}%
As the individual terms are given by 
\begin{equation}
\left\vert \kappa _{2}\right\vert ^{2}f\left( x_{j_{n}}\cdots
x_{j_{1}}x_{j_{1}}\cdots x_{j_{n}}\right) =\frac{\left\vert \kappa
_{2}\right\vert ^{2}}{2^{n}}\left( -1\right) ^{n}\sum_{1\leq k_{1}\leq 2r}%
\mathcal{R}_{x}\left( \left\langle \kappa _{2}\right\rangle _{1}\right)
_{k_{1}}f\left( x_{k_{1}}x_{j_{n}}\cdots x_{j_{1}}x_{j_{1}}\cdots
x_{j_{n}}\right) =\left( -1\right) ^{n}\frac{1}{2^{n}}\sum_{1\leq k_{1}\leq
2r}\mathcal{R}_{x}\left( \left\langle \kappa _{2}\right\rangle _{1}\right)
_{k_{1}}f\left( x_{k_{1}}\right)
\end{equation}%
and%
\begin{equation}
2i\sum_{1\leq k_{1}<k_{2}\leq 2}\mathcal{R}_{x}\left( \left\langle \kappa
_{2}\right\rangle _{2}\right) _{k_{1}k_{2}}f\left( x_{j_{n}}\cdots
x_{j_{1}}x_{k_{1}}x_{k_{2}}x_{j_{1}}\cdots x_{j_{n}}\right) =2i\frac{1}{2^{n}%
}\sum_{1\leq k_{1}<k_{2}\leq 2r}\mathcal{R}_{x}\left( \left\langle \kappa
_{2}\right\rangle _{2}\right) _{k_{1}k_{2}}f\left( x_{k_{1}}x_{k_{2}}\right)
.
\end{equation}%
$\lceil $

\begin{enumerate}
\item First order

\begin{enumerate}
\item same 
\begin{equation}
\xi _{1}f\left( x_{3}x_{2}x_{1}\left( x_{1}\right) x_{1}x_{2}x_{3}\right)
=\xi _{1}\frac{1}{2}f\left( x_{3}x_{2}x_{1}x_{2}x_{3}\right) =\xi _{1}\frac{1%
}{2^{3}}f\left( x_{1}\right)
\end{equation}%
\begin{equation}
\xi _{2}f\left( x_{3}x_{2}x_{1}\left( x_{2}\right) x_{1}x_{2}x_{3}\right)
=-\xi _{1}\frac{1}{2}f\left( x_{3}x_{2}x_{3}\right) =\xi _{2}\frac{1}{2^{3}}%
f\left( x_{2}\right)
\end{equation}%
\begin{equation}
\xi _{3}f\left( x_{3}x_{2}x_{1}\left( x_{3}\right) x_{1}x_{2}x_{3}\right)
=\xi _{1}\frac{1}{2}f\left( x_{3}x_{2}x_{3}x_{2}x_{3}\right) =-\xi _{3}\frac{%
1}{2^{3}}f\left( x_{3}\right)
\end{equation}

\item different%
\begin{equation}
\xi _{1}f\left( x_{4}x_{3}x_{2}\left( x_{1}\right) x_{2}x_{3}x_{4}\right)
=-\xi _{1}\frac{1}{2}f\left( x_{1}x_{4}x_{3}x_{2}x_{2}x_{3}x_{4}\right)
=-\xi _{1}\frac{1}{2^{3}}f\left( x_{1}\right)
\end{equation}

\item giving%
\begin{eqnarray}
\sum_{1\leq k\leq 3}\xi _{k}f\left(
x_{3}x_{2}x_{1}x_{k}x_{1}x_{2}x_{3}\right) &=&\xi _{1}\frac{1}{2^{3}}f\left(
x_{1}\right) -\xi _{2}\frac{1}{2^{3}}f\left( x_{2}\right) +\xi _{3}\frac{1}{%
2^{3}}f\left( x_{3}\right) \\
\sum_{4\leq j\leq 2r}\xi _{k}f\left(
x_{3}x_{2}x_{1}x_{j}x_{k}x_{1}x_{2}x_{3}\right) &=&\left( -1\right) ^{3}%
\frac{1}{2^{3}}\sum_{4\leq k\leq 2r}\xi _{k}f\left( x_{k}\right) .
\end{eqnarray}
\end{enumerate}

\item Second order both same%
\begin{equation}
\xi _{12}f\left( x_{3}x_{2}x_{1}\left( x_{1}x_{2}\right)
x_{1}x_{2}x_{3}\right) =\xi _{12}\frac{1}{4}f\left(
x_{3}x_{1}x_{2}x_{3}\right) =\xi _{12}\frac{1}{2^{3}}f\left(
x_{1}x_{2}\right)
\end{equation}%
\begin{equation}
\xi _{13}f\left( x_{3}x_{2}x_{1}\left( x_{1}x_{3}\right)
x_{1}x_{2}x_{3}\right) =\xi _{13}\frac{1}{8}f\left( x_{1}x_{3}\right)
\end{equation}%
\begin{equation}
\xi _{23}f\left( x_{3}x_{2}x_{1}\left( x_{2}x_{3}\right)
x_{1}x_{2}x_{3}\right) =\xi _{23}\frac{1}{8}f\left( x_{2}x_{3}\right)
\end{equation}

\begin{enumerate}
\item giving 
\begin{eqnarray}
\sum_{1\leq j<k\leq 3}\xi _{jk}f\left( x_{3}x_{2}x_{1}\left(
x_{j}x_{k}\right) x_{1}x_{2}x_{3}\right) &=&\xi _{12}\frac{1}{2^{3}}f\left(
x_{1}x_{2}\right) +\xi _{13}\frac{1}{8}f\left( x_{1}x_{3}\right) +\xi _{23}%
\frac{1}{8}f\left( x_{2}x_{3}\right) \\
\sum_{4\leq j<k\leq 2r}\xi _{jk}f\left(
x_{3}x_{2}x_{1}x_{j}x_{k}x_{1}x_{2}x_{3}\right) &=&\frac{1}{2^{3}}%
\sum_{4\leq k\leq 2r}\xi _{jk}f\left( x_{j}x_{k}\right)
\end{eqnarray}%
one 
\begin{equation}
\xi _{12}f\left( x_{3}x_{2}x_{1}\left( x_{1}x_{4}\right)
x_{1}x_{2}x_{3}\right) =\xi _{12}\frac{1}{4}f\left( x_{4}x_{1}\right)
\end{equation}

\item giving 
\begin{eqnarray}
\sum_{1\leq j<k\leq 3}\xi _{jk}f\left( x_{3}x_{2}x_{1}\left(
x_{j}x_{k}\right) x_{1}x_{2}x_{3}\right) &=&\xi _{12}\frac{1}{2^{3}}f\left(
x_{1}x_{2}\right) +\xi _{13}\frac{1}{8}f\left( x_{1}x_{3}\right) +\xi _{23}%
\frac{1}{8}f\left( x_{2}x_{3}\right) \\
\sum_{4\leq j<k\leq 2r}\xi _{jk}f\left(
x_{3}x_{2}x_{1}x_{j}x_{k}x_{1}x_{2}x_{3}\right) &=&\frac{1}{2^{3}}%
\sum_{4\leq k\leq 2r}\xi _{jk}f\left( x_{j}x_{k}\right)
\end{eqnarray}
\end{enumerate}
\end{enumerate}

$\lceil $Let $r=1$ then%
\begin{eqnarray}
&&\left( \eta I_{\mathcal{A}}+\mathcal{\alpha }_{1}x_{1}+\mathcal{\alpha }%
_{2}x_{2}\right) ^{\dagger }\left( \eta I_{\mathcal{A}}+\mathcal{\alpha }%
_{1}x_{1}+\mathcal{\alpha }_{2}x_{2}\right) =\left( \overline{\eta }I_{%
\mathcal{A}}+\overline{\mathcal{\alpha }_{1}}x_{1}+\overline{\mathcal{\alpha 
}_{2}}x_{2}\right) \left( \eta I_{\mathcal{A}}+\mathcal{\alpha }_{1}x_{1}+%
\mathcal{\alpha }_{2}x_{2}\right) \\
&=&\left\vert \eta \right\vert ^{2}I_{\mathcal{A}}+\overline{\eta }\left( 
\mathcal{\alpha }_{1}x_{1}+\mathcal{\alpha }_{2}x_{2}\right) +\overline{%
\mathcal{\alpha }_{1}}x_{1}\left( \eta I_{\mathcal{A}}+\mathcal{\alpha }%
_{1}x_{1}+\mathcal{\alpha }_{2}x_{2}\right) +\overline{\mathcal{\alpha }_{2}}%
x_{2}\left( \eta I_{\mathcal{A}}+\mathcal{\alpha }_{1}x_{1}+\mathcal{\alpha }%
_{2}x_{2}\right) \\
&=&\left\vert \eta \right\vert ^{2}I_{\mathcal{A}}+\left( \overline{\eta }%
\mathcal{\alpha }_{1}+\overline{\mathcal{\alpha }_{1}}\eta \right)
x_{1}+\left( \overline{\eta }\mathcal{\alpha }_{2}+\overline{\mathcal{\alpha 
}_{2}}\eta \right) x_{2}+\frac{1}{2}\left( \left\vert \mathcal{\alpha }%
_{1}\right\vert ^{2}+\left\vert \mathcal{\alpha }_{2}\right\vert ^{2}\right)
I_{\mathcal{A}}+\overline{\mathcal{\alpha }_{1}}\mathcal{\alpha }%
_{2}x_{1}x_{2}+\overline{\mathcal{\alpha }_{2}}\mathcal{\alpha }%
_{1}x_{2}x_{1} \\
&=&\left( \left\vert \eta \right\vert ^{2}+\frac{1}{2}\left( \left\vert 
\mathcal{\alpha }_{1}\right\vert ^{2}+\left\vert \mathcal{\alpha }%
_{2}\right\vert ^{2}\right) \right) I_{\mathcal{A}}+2\func{Re}\left\{ \eta 
\overline{\mathcal{\alpha }_{1}}\right\} x_{1}+2\func{Re}\left\{ \eta 
\overline{\mathcal{\alpha }_{2}}\right\} x_{2}+\left( \overline{\mathcal{%
\alpha }_{1}}\mathcal{\alpha }_{2}-\overline{\mathcal{\alpha }_{2}}\mathcal{%
\alpha }_{1}\right) x_{1}x_{2} \\
&=&\left( \left\vert \eta \right\vert ^{2}+\frac{1}{2}\left( \left\vert 
\mathcal{\alpha }_{1}\right\vert ^{2}+\left\vert \mathcal{\alpha }%
_{2}\right\vert ^{2}\right) \right) I_{\mathcal{A}}+2\func{Re}\left\{ \eta 
\overline{\mathcal{\alpha }_{1}}\right\} x_{1}+2\func{Re}\left\{ \eta 
\overline{\mathcal{\alpha }_{2}}\right\} x_{2}+2i\func{Im}\left\{ \overline{%
\mathcal{\alpha }_{1}}\mathcal{\alpha }_{2}\right\} x_{1}x_{2}.
\end{eqnarray}%
\begin{eqnarray}
&&f\left( I_{\mathcal{A}}\left( \left( \left\vert \eta \right\vert ^{2}+%
\frac{1}{2}\left( \left\vert \mathcal{\alpha }_{1}\right\vert
^{2}+\left\vert \mathcal{\alpha }_{2}\right\vert ^{2}\right) \right) I_{%
\mathcal{A}}+2\func{Re}\left\{ \eta \overline{\mathcal{\alpha }_{1}}\right\}
x_{1}+2\func{Re}\left\{ \eta \overline{\mathcal{\alpha }_{2}}\right\}
x_{2}+2i\func{Im}\left\{ \overline{\mathcal{\alpha }_{1}}\mathcal{\alpha }%
_{2}\right\} x_{1}x_{2}\right) I_{\mathcal{A}}\right) \\
&=&\left\vert \eta \right\vert ^{2}+\frac{1}{2}\left( \left\vert \mathcal{%
\alpha }_{1}\right\vert ^{2}+\left\vert \mathcal{\alpha }_{2}\right\vert
^{2}\right) +2\func{Re}\left\{ \eta \overline{\mathcal{\alpha }_{1}}\right\}
f\left( x_{1}\right) +2\func{Re}\left\{ \eta \overline{\mathcal{\alpha }_{2}}%
\right\} f\left( x_{2}\right) +2i\func{Im}\left\{ \overline{\mathcal{\alpha }%
_{1}}\mathcal{\alpha }_{2}\right\} f\left( x_{1}x_{2}\right)
\end{eqnarray}%
The product $x_{1}x_{2}$ is anti self adjoint i.e. 
\begin{equation}
x_{1}x_{2}=-\left( x_{1}x_{2}\right) ^{\dagger }\Rightarrow x_{1}x_{2}=iA,
\end{equation}%
where 
\begin{equation}
A=A^{\dagger }.
\end{equation}%
Let $r=2$ then%
\begin{eqnarray}
&&\left( \eta I_{\mathcal{A}}+\mathcal{\alpha }_{1}x_{1}+\mathcal{\alpha }%
_{2}x_{2}+\mathcal{\alpha }_{3}x_{3}+\mathcal{\alpha }_{4}x_{4}\right)
