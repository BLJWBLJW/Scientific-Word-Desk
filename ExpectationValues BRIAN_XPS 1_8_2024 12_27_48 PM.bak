\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) -i\mathfrak{X}\left( i\mathbf{%
\varphi }\right) & \mathfrak{X}\left( \mathbf{\varphi }\right) +i\mathfrak{X}%
\left( i\mathbf{\varphi }\right)%
\end{array}%
\right)
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
We consider the linear maps $T\in \mathcal{L}\left( \mathfrak{H\oplus }_{%
\mathbb{R}}\,\sigma \left( \mathfrak{H}\right) \right) $ 
\begin{equation}
T:\mathfrak{H\oplus }_{\mathbb{R}}\,\sigma \left( \mathfrak{H}\right)
\rightarrow \mathfrak{H\oplus }_{\mathbb{R}}\,\sigma \left( \mathfrak{H}%
\right) ,
\end{equation}%
and note that%
\begin{equation}
\mathfrak{H\oplus }_{\mathbb{R}}\,\sigma \left( \mathfrak{H}\right) \subset 
\mathfrak{H\oplus }_{\mathbb{C}}\,\mathfrak{H.}
\end{equation}

\begin{enumerate}
\item Representations of $S\in \mathcal{L}\left( \mathfrak{H}_{\varphi 
\mathbb{R}}\right) \equiv \mathcal{L}\left( \mathfrak{H\oplus }_{\mathbb{R}%
}\,\sigma \left( \mathfrak{H}\right) \right) \subset \mathcal{L}\left(
\Upsilon \left\{ \mathfrak{H\oplus }_{\mathbb{C}}\,\mathfrak{H}\right\}
\right) $ as a complex linear map $T\left( S\right) \in \mathcal{L}\left(
\Upsilon \left\{ \mathfrak{H\oplus }_{\mathbb{C}}\,\mathfrak{H}\right\}
\right) $ 
\begin{equation}
T\left( S\right) :\Upsilon \left\{ \mathfrak{H\oplus }_{\mathbb{C}}\,%
\mathfrak{H}\right\} \rightarrow \Upsilon \left\{ \mathfrak{H\oplus }_{%
\mathbb{C}}\,\mathfrak{H}\right\}
\end{equation}%
are given by 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\psi }\right) & \mathfrak{s}\left( 
\mathbf{\psi }\right)%
\end{array}%
\right) &=&T\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) & \mathfrak{s}\left( 
\mathbf{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( T\mathbf{\varphi }\right) & \mathfrak{s}\left(
T\mathbf{\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) & \mathfrak{s}\left( 
\mathbf{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathfrak{R}_{\mathfrak{a}}\left( T\right) _{11} & \mathfrak{R}_{\mathfrak{a}%
}\left( T\right) _{12} \\ 
\mathfrak{R}_{\mathfrak{a}}\left( T\right) _{21} & \mathfrak{R}_{\mathfrak{a}%
}\left( T\right) _{22}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) & \mathfrak{s}\left( 
\mathbf{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( T\right) _{11} & \overline{\mathcal{R}_{\varphi
}\left( T\right) _{12}} \\ 
\mathcal{R}_{\varphi }\left( T\right) _{21} & \overline{\mathcal{R}_{\varphi
}\left( T\right) _{22}}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) & \mathfrak{s}\left( 
\mathbf{\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( U\right) & \overline{\mathcal{R}_{\varphi
}\left( V\right) } \\ 
\mathcal{R}_{\varphi }\left( V\right) & \overline{\mathcal{R}_{\varphi
}\left( U\right) }%
\end{array}%
\right)
\end{eqnarray}

\item Representations of $S=S\left( T\right) \in \mathcal{L}\left( \mathfrak{%
H}_{\varphi \mathbb{R}}\right) \equiv \mathcal{L}\left( \mathfrak{H\oplus }_{%
\mathbb{R}}\,\sigma \left( \mathfrak{H}\right) \right) \subset \mathcal{L}%
\left( \Upsilon \left\{ \mathfrak{H\oplus }_{\mathbb{C}}\,\mathfrak{H}%
\right\} \right) $ as a real linear map 
\begin{equation}
S:\mathfrak{H\oplus }_{\mathbb{R}}\,\sigma \left( \mathfrak{H}\right)
\rightarrow \mathfrak{H\oplus }_{\mathbb{R}}\,\sigma \left( \mathfrak{H}%
\right)
\end{equation}%
are given by 
\begin{eqnarray}
\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\psi }\right) & \mathfrak{X}\left( i\mathbf{\psi }%
\right)%
\end{array}%
\right) &=&S\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( S\mathbf{\varphi }\right) & \mathfrak{X}\left( iS\mathbf{%
\varphi }\right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\func{Re}_{\varphi }\left( \mathfrak{R}_{\mathfrak{a}}\left( T\right) _{11}+%
\mathfrak{R}_{\mathfrak{a}}\left( T\right) _{21}\right) & -\func{Im}%
_{\varphi }\left( \mathfrak{R}_{\mathfrak{a}}\left( T\right) _{11}+\mathfrak{%
R}_{\mathfrak{a}}\left( T\right) _{21}\right) \\ 
\func{Im}_{\varphi }\left( \mathfrak{R}_{\mathfrak{a}}\left( T\right) _{11}-%
\mathfrak{R}_{\mathfrak{a}}\left( T\right) _{21}\right) & \func{Re}_{\varphi
}\left( \mathfrak{R}_{\mathfrak{a}}\left( T\right) _{11}-\mathfrak{R}_{%
\mathfrak{a}}\left( T\right) _{21}\right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\func{Re}\left( \mathcal{R}_{\varphi }\left( U\right) +\mathcal{R}_{\varphi
}\left( V\right) \right) & -\func{Im}\left( \mathcal{R}_{\varphi }\left(
U\right) +\mathcal{R}_{\varphi }\left( V\right) \right) \\ 
\func{Re}\left( \mathcal{R}_{\varphi }\left( U\right) -\mathcal{R}_{\varphi
}\left( V\right) \right) & \func{Re}\left( \mathcal{R}_{\varphi }\left(
U\right) -\mathcal{R}_{\varphi }\left( V\right) \right)%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathcal{R}_{\varphi }\left( S\right) _{11} & \mathcal{R}_{\varphi }\left(
S\right) _{12} \\ 
\mathcal{R}_{\varphi }\left( S\right) _{21} & \mathcal{R}_{\varphi }\left(
S\right) _{22}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{X}\left( \mathbf{\varphi }\right) & \mathfrak{X}\left( i\mathbf{%
\varphi }\right)%
\end{array}%
\right) \mathcal{R}_{\varphi }\left( S\right) .
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{lemma}
\begin{gather}
\left\{ \mathfrak{X}\left( \varphi _{j}\right) ,\mathfrak{X}\left( \varphi
_{k}\right) \right\} =\left\{ \mathfrak{X}\left( i\varphi _{j}\right) ,%
\mathfrak{X}\left( i\varphi _{k}\right) \right\} =\delta _{jk}I_{\mathcal{A}%
}=\left\langle \varphi _{j}\left\vert \varphi _{k}\right. \right\rangle _{%
\mathfrak{H}}I_{\mathcal{A}} \\
\left\{ \mathfrak{X}\left( \varphi _{j}\right) ,\mathfrak{X}\left( i\varphi
_{k}\right) \right\} =0
\end{gather}%
In paticular 
\begin{equation}
\mathfrak{X}\left( \varphi _{j}\right) ^{2}=\mathfrak{X}\left( i\varphi
_{j}\right) ^{2}=\frac{1}{2}I_{\mathcal{A}}.
\end{equation}
\end{lemma}

\begin{proof}
This comes from the Clifford Algebra CR's.
\end{proof}

\begin{remark}
Clifford Algebra CR's 
\begin{eqnarray}
\left\{ \mathfrak{X}\left( f\right) ,\mathfrak{X}\left( g\right) \right\}
&=&\sum_{1\leq j,k\leq r}\left\{ \mathfrak{X}\left( \varphi _{j}f_{j}\right)
,\mathfrak{X}\left( \varphi _{k}g_{k}\right) \right\} =\sum_{1\leq j,k\leq
r}\left\{ \mathfrak{X}\left( \varphi _{j}\func{Re}\left( f_{j}\right)
+i\varphi _{j}\func{Im}\left( f_{j}\right) \right) ,\mathfrak{X}\left(
\varphi _{j}\func{Re}\left( g_{k}\right) +i\varphi _{j}\func{Im}\left(
g_{k}\right) \right) \right\} \\
&=&\sum_{1\leq j,k\leq r}\left\{ \mathfrak{X}\left( \varphi _{j}\right) ,%
\mathfrak{X}\left( \varphi _{k}\right) \right\} \func{Re}\left( f_{j}\right) 
\func{Re}\left( g_{k}\right) +\sum_{1\leq j,k\leq r}\left\{ \mathfrak{X}%
\left( \varphi _{j}\right) ,\mathfrak{X}\left( i\varphi _{k}\right) \right\} 
\func{Re}\left( f_{j}\right) \func{Im}\left( g_{k}\right) \\
&&+\sum_{1\leq j,k\leq r}\left\{ \mathfrak{X}\left( i\varphi _{j}\right) ,%
\mathfrak{X}\left( \varphi _{k}\right) \right\} \func{Im}\left( f_{j}\right) 
\func{Re}\left( g_{k}\right) +\sum_{1\leq j,k\leq r}\left\{ \mathfrak{X}%
\left( i\varphi _{j}\right) ,\mathfrak{X}\left( i\varphi _{k}\right)
\right\} \func{Im}\left( f_{j}\right) \func{Im}\left( g_{k}\right) \\
&=&\sum_{1\leq j,\leq r}\left\{ \mathfrak{X}\left( \varphi _{j}\right) ,%
\mathfrak{X}\left( \varphi _{j}\right) \right\} \func{Re}\left( f_{j}\right) 
\func{Re}\left( g_{j}\right) +\sum_{1\leq j,\leq r}\left\{ \mathfrak{X}%
\left( i\varphi _{j}\right) ,\mathfrak{X}\left( i\varphi _{k}\right)
\right\} \func{Im}\left( f_{j}\right) \func{Im}\left( g_{j}\right) \\
&=&\frac{1}{2}\left\langle f\left\vert g\right. \right\rangle _{\mathfrak{H}%
}I_{\mathcal{A}},
\end{eqnarray}%
hence 
\begin{gather}
\left\{ \mathfrak{X}\left( f\right) ,\mathfrak{X}\left( f\right) \right\}
=\left\langle f\left\vert f\right. \right\rangle _{\mathfrak{H}}I_{\mathcal{A%
}} \\
\Updownarrow \\
\mathfrak{X}\left( f\right) ^{2}=\frac{1}{2}\left\langle f\left\vert
f\right. \right\rangle _{\mathfrak{H}}I_{\mathcal{A}}.
\end{gather}
\end{remark}

\begin{remark}
\begin{eqnarray}
\mathfrak{X}\left( f\right) &=&\mathfrak{X}\left( \sum_{1\leq j\leq
r}\varphi _{j}\mathcal{R}_{\varphi }\left( f\right) _{j}\right) \\
&=&\mathfrak{X}\left( \sum_{1\leq j\leq r}\varphi _{j}\left( \func{Re}\left( 
\mathcal{R}_{\varphi }\left( f\right) _{j}\right) +i\func{Im}\left( \mathcal{%
R}_{\varphi }\left( f\right) _{j}\right) \right) \right) \\
&=&\sum_{1\leq j\leq r}\mathfrak{X}\left( \varphi _{j}\left( \func{Re}\left( 
\mathcal{R}_{\varphi }\left( f\right) _{j}\right) +i\func{Im}\left( \mathcal{%
R}_{\varphi }\left( f\right) _{j}\right) \right) \right) \\
&=&\sum_{1\leq j\leq r}\left\{ \mathfrak{X}\left( \varphi _{j}\right) \func{%
Re}\mathcal{R}_{\varphi }\left( f\right) _{j}+\mathfrak{X}\left( i\varphi
_{j}\right) \func{Im}\mathcal{R}_{\varphi }\left( f\right) _{j}\right\} \\
&=&\sum_{1\leq j\leq r}\left\{ x_{j}\func{Re}\left( \mathcal{R}_{\varphi
}\left( f\right) _{j}\right) +x_{j+r}\func{Im}\left( \mathcal{R}_{\varphi
}\left( f\right) _{j}\right) \right\} \\
&=&\sum_{1\leq j\leq r}\left\{ x_{j}\mathcal{R}_{x}\left( \mathfrak{X}\left(
f\right) \right) _{j}+x_{j+r}\mathcal{R}_{x}\left( \mathfrak{X}\left(
f\right) \right) _{j+r}\right\} \\
&=&\sum_{1\leq j\leq r}\left\{ x_{j}\func{Re}\left( \mathcal{R}_{\varphi
}\left( f\right) \right) _{j}+x_{j+r}\func{Im}\left( \mathcal{R}_{\varphi
}\left( f\right) _{j}\right) \right\} ,
\end{eqnarray}%
where 
\begin{equation}
\mathcal{R}_{x}\left( \mathfrak{X}\left( f\right) \right) _{j},\mathcal{R}%
_{x}\left( \mathfrak{X}\left( f\right) \right) _{j+r}\in \mathbb{R},\,1\leq
j\leq r.
\end{equation}
\end{remark}

\begin{remark}
This displays $\mathfrak{X}$ as a real linear map. 
\begin{equation}
\mathfrak{X:H}\overset{\mathbb{R}}{\cong }\left( \mathfrak{H}\oplus _{%
\mathbb{R}}\sigma _{\varphi }\left( \mathfrak{H}\right) \right) \oplus _{%
\mathbb{R}}\left( \mathfrak{H}\ominus _{\mathbb{R}}\sigma _{\varphi }\left( 
\mathfrak{H}\right) \right) =\mathfrak{H}_{\sigma _{\varphi }\mathbb{R}}%
\overset{\mathbb{R}}{\rightarrow }\mathcal{F}_{1\sigma _{x}\mathbb{R}}=%
\boldsymbol{x}_{1}\oplus _{\mathbb{R}}\boldsymbol{x}_{2}.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{F}_{1}=\boldsymbol{x}_{1}\oplus _{\mathbb{C}}\boldsymbol{x}_{2}.
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
\mathcal{F}_{1x_{1}} &=&\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
x_{j}\right\vert 1\leq j\leq r\right\} \\
\mathcal{F}_{1x_{2}} &=&\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
x_{j+r}\right\vert 1\leq j\leq r\right\} .
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{eqnarray}
\mathbb{C}\text{-}\dim \left\{ \mathfrak{H}\right\} &=&r \\
\mathbb{R}\text{-}\dim \left\{ \mathfrak{H}\right\} &=&\mathbb{R}\text{-}%
\dim \left\{ \mathfrak{H}_{\sigma _{\varphi }\mathbb{R}}\right\} =2r \\
\mathbb{R}\text{-}\dim \left\{ \mathfrak{H}\oplus _{\mathbb{R}}\sigma
_{\varphi }\left( \mathfrak{H}\right) \right\} &=&\mathbb{R}\text{-}\dim
\left\{ \mathfrak{H}\ominus _{\mathbb{R}}\sigma _{\varphi }\left( \mathfrak{H%
}\right) \right\} =r \\
\mathbb{R}\text{-}\dim \left\{ \boldsymbol{x}_{1}\right\} &=&\mathbb{R}\text{%
-}\dim \left\{ \boldsymbol{x}_{2}\right\} =r \\
\mathbb{R}\text{-}\dim \left\{ \mathcal{F}_{1}\right\} &=&\mathbb{R}\text{-}%
\dim \left\{ \mathcal{F}_{1\sigma _{x}\mathbb{R}}\right\} =2r \\
\mathbb{C}\text{-}\dim \left\{ \mathcal{F}_{1}\right\} &=&r.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{gather}
\sigma \in \mathcal{B}_{anti}\left( \mathfrak{H}\right) \\
\mathfrak{H}_{\sigma +}=\left\{ \left. \sigma \left( v\right) =v\right\vert
v\in \mathfrak{H}\right\} \\
\mathfrak{H}_{\sigma -}=\left\{ \left. \sigma \left( v\right) =-v\right\vert
v\in \mathfrak{H}\right\} .
\end{gather}
\end{remark}

\begin{definition}
The Hilbert subspaces $\mathfrak{H}_{\sigma +}$ and $\mathfrak{H}_{\sigma -}$%
are real Hilbert spaces and one defines the set of isomorphic real Hilbert
spaces 
\begin{equation}
\mathfrak{H}_{\sigma \mathbb{R}}=\mathfrak{H}_{\sigma +}\oplus _{\mathbb{R}}%
\mathfrak{H}_{\sigma -}.
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\limfunc{range}\left\{ \mathfrak{X}\right\} =\mathbb{R}\text{-}\limfunc{%
linspan}\left\{ \left. x_{j}\right\vert 1\leq j\leq r\right\} \oplus _{%
\mathbb{R}}\mathbb{R}\text{-}\limfunc{linspan}\left\{ \left.
x_{j+r}\right\vert 1\leq j\leq r\right\} =\boldsymbol{x}_{1\mathbb{R}}\oplus
_{\mathbb{R}}\boldsymbol{x}_{2\mathbb{R}}
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
\mathfrak{X}\left( f\right) ^{2} &=&\frac{1}{2}\left\langle f\left\vert
f\right. \right\rangle _{\mathfrak{H}}I_{\mathcal{A}}=\frac{1}{2}%
\left\langle \sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\varphi }\left(
f\right) _{j}\left\vert \sum_{1\leq j\leq r}\varphi _{j}\mathcal{R}_{\varphi
}\left( f\right) _{j}\right. \right\rangle _{\mathfrak{H}}I_{\mathcal{A}}=%
\frac{1}{2}\sum_{1\leq j\leq r}\left\vert \mathcal{R}_{\varphi }\left(
f\right) _{j}\right\vert ^{2}I_{\mathcal{A}} \\
\mathfrak{X}\left( f\right) ^{2} &=&\sum_{1\leq j\leq 2r}x_{j}\mathcal{R}%
_{x}\left( \mathfrak{X}\left( f\right) \right) _{j}\sum_{1\leq k\leq 2r}x_{k}%
\mathcal{R}_{x}\left( \mathfrak{X}\left( f\right) \right) _{k}=\frac{1}{2}%
\sum_{1\leq j\leq 2r}\mathcal{R}_{x}\left( \mathfrak{X}\left( f\right)
\right) _{j}^{2}I_{\mathcal{A}}
\end{eqnarray}%
hence%
\begin{equation}
\sum_{1\leq j\leq r}\left\vert \mathcal{R}_{\varphi }\left( f\right)
_{j}\right\vert ^{2}=\sum_{1\leq j\leq 2r}\mathcal{R}_{x}\left( \mathfrak{X}%
\left( f\right) \right) _{j}^{2}
\end{equation}%
showing that%
\begin{equation}
\mathcal{R}_{x}\left( \mathfrak{X}\left( f\right) \right) _{j}=\mathcal{R}%
_{\varphi }\left( f\right) _{j},1\leq j\leq r.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left\langle \left\langle \mathfrak{X}\left( f\right) ^{2}\right\rangle
\right\rangle _{0}=\left\langle \left\langle \mathfrak{X}\left( f\right)
^{\dagger }\mathfrak{X}\left( f\right) \right\rangle \right\rangle _{0}=%
\frac{1}{2}\sum_{1\leq j\leq 2r}\mathcal{R}_{x}\left( \mathfrak{X}\left(
f\right) \right) _{j}^{2}=\frac{1}{2}\sum_{1\leq j\leq r}\left\vert \mathcal{%
R}_{\varphi }\left( f\right) _{j}\right\vert ^{2}.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\widetilde{x}_{j}=\sqrt{2}x_{j},\,1\leq j\leq r,
\end{equation}%
giving 
\begin{equation}
\widetilde{x}_{j}^{2}=I_{\mathcal{A}},\,1\leq j\leq r.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\mathfrak{X}\left( F\right) =\sum_{0\leq n\leq 2r}\sum_{0\leq j_{1}<\cdots
<j_{n}\leq 2r}\widetilde{x}_{j_{1}}\cdots \widetilde{x}_{j_{n}}\mathcal{R}%
_{x}\left( \mathfrak{X}\left( F\right) _{n}\right) _{j_{1}\cdots j_{n}},
\end{equation}%
where 
\begin{equation}
F=\sum_{0\leq m,n\leq 2r}\sum_{\substack{ 0\leq j_{1}<\cdots <j_{m}\leq r 
\\ 0\leq k_{1}<\cdots <k_{n}\leq r}}\left\vert \varphi _{j_{1}}\cdots
\varphi _{j_{m}}i\varphi _{k_{1}}\cdots i\varphi _{k_{n}}\right\rangle 
\mathcal{R}_{\varphi }\left( F_{n+m}\right) _{j_{1}\cdots j_{m}k_{1}<\cdots
<k_{n}}
\end{equation}%
and 
\begin{equation}
\left\vert \varphi _{j_{1}}\cdots \varphi _{j_{m}}i\varphi _{k_{1}}\cdots
i\varphi _{k_{n}}\right\rangle =\sqrt{m+n}\varphi _{j_{1}}\wedge \cdots
\wedge \varphi _{j_{m}}\wedge i\varphi _{k_{1}}\wedge \cdots \wedge i\varphi
_{k_{n}},\,1\leq j_{1}<\cdots <j_{m}\leq r,1\leq k_{1}<\cdots <k_{n}\leq r.
\end{equation}
\end{remark}

\begin{remark}
\begin{eqnarray}
\left\langle \mathfrak{X}\left( F\right) ^{\dagger }\mathfrak{X}\left(
F\right) \right\rangle _{0} &=&\left\langle \left( \sum_{0\leq n\leq
2r}\sum_{0\leq j_{1}<\cdots <j_{n}\leq 2r}\widetilde{x}_{j_{1}}\cdots 
\widetilde{x}_{j_{n}}\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right)
_{n}\right) _{j_{1}\cdots j_{n}}\right) ^{\dagger }\left( \sum_{0\leq n\leq
2r}\sum_{0\leq j_{1}<\cdots <j_{n}\leq 2r}\widetilde{x}_{j_{1}}\cdots 
\widetilde{x}_{j_{n}}\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right)
_{n}\right) _{j_{1}\cdots j_{n}}\right) \right\rangle _{0} \\
&=&\left\langle \left( \sum_{0\leq n\leq 2r}\sum_{0\leq j_{1}<\cdots
<j_{n}\leq 2r}\widetilde{x}_{j_{n}}\cdots \widetilde{x}_{j_{1}}\mathcal{R}%
_{x}\left( \mathfrak{X}\left( F\right) _{n}\right) _{j_{1}\cdots
j_{n}}\right) \left( \sum_{0\leq m\leq 2r}\sum_{0\leq k_{1}<\cdots
<k_{m}\leq 2r}\widetilde{x}_{k_{1}}\cdots \widetilde{x}_{k_{m}}\mathcal{R}%
_{x}\left( \mathfrak{X}\left( F\right) _{m}\right) _{k_{1}\cdots
k_{m}}\right) \right\rangle _{0} \\
&=&\left\langle \sum_{0\leq n\leq 2r}\sum_{0\leq j_{1}<\cdots <j_{n}\leq
2r}\sum_{0\leq m\leq 2r}\sum_{0\leq k_{1}<\cdots <k_{m}\leq 2r}\widetilde{x}%
_{j_{n}}\cdots \widetilde{x}_{j_{1}}\widetilde{x}_{k_{1}}\cdots \widetilde{x}%
_{k_{m}}\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right) _{n}\right)
_{j_{1}\cdots j_{n}}\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right)
_{m}\right) _{k_{1}\cdots k_{m}}\right\rangle _{0} \\
&=&\left\langle \sum_{0\leq n\leq 2r}\sum_{0\leq j_{1}<\cdots <j_{n}\leq 2r}%
\widetilde{x}_{j_{n}}\cdots \widetilde{x}_{j_{1}}\widetilde{x}_{j_{1}}\cdots 
\widetilde{x}_{j_{n}}\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right)
_{n}\right) _{j_{1}\cdots j_{n}}\mathcal{R}_{x}\left( \mathfrak{X}\left(
F\right) _{m}\right) _{k_{1}\cdots k_{m}}\right\rangle _{0} \\
&=&\left( \sum_{0\leq n\leq 2r}\sum_{0\leq j_{1}<\cdots <j_{n}\leq 2r}%
\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right) _{n}\right) _{j_{1}\cdots
j_{n}}\mathcal{R}_{x}\left( \mathfrak{X}\left( F\right) _{n}\right)
_{j_{1}\cdots j_{n}}\right) I_{\mathcal{A}}=\left\langle \left\langle 
\mathfrak{X}\left( F\right) ^{\dagger }\mathfrak{X}\left( F\right)
\right\rangle \right\rangle _{0}I_{\mathcal{A}}=\left\Vert \mathfrak{X}%
\left( F\right) \right\Vert _{\mathcal{A}}^{2}I_{\mathcal{A}}.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{equation}
\left\Vert \mathfrak{X}\left( F\right) \right\Vert _{\mathcal{A}%
}^{2}=\left\Vert F\right\Vert _{\mathcal{\wedge }\left( \mathfrak{H}\right)
}^{2}.
\end{equation}
\end{remark}

\begin{lemma}
As a complex vector space 
\begin{eqnarray}
\mathcal{A} &=&\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left. \mathfrak{s}%
^{\dagger }\left( \varphi _{j_{1}}\right) \cdots \mathfrak{s}^{\dagger
}\left( \varphi _{j_{m}}\right) \mathfrak{s}\left( \varphi _{k_{1}}\right)
\cdots \mathfrak{s}\left( \varphi _{k_{n}}\right) \right\vert 1\leq
j_{1}\,<\cdots <j_{m}\leq r,\,1\leq n\leq r,1\leq k_{1}\,<\cdots <k_{n}\leq
r,0\leq m\leq r,\,0\leq n\leq r\right\} \\
&\equiv &\mathbb{C}\text{-}\limfunc{linspan}\left\{ \left.
a_{j_{1}}^{\dagger }\cdots a_{j_{m}}^{\dagger }a_{k_{1}}\cdots
a_{k_{m}}\right\vert 1\leq j_{1}\,<\cdots <j_{m}\leq r,\,1\leq n\leq r,1\leq
k_{1}\,<\cdots <k_{n}\leq r,0\leq m\leq r,\,0\leq n\leq r\right\} .
\end{eqnarray}
\end{lemma}

\begin{lemma}
$\mathcal{A}$ is a closed CAR $c^{\ast }$-algebra with norm $\left\Vert
{}\right\Vert _{\mathcal{A}},$ i.e. multiplication in $\mathcal{A}$ is
continuous wrt $\left\Vert {}\right\Vert _{\mathcal{A}}.$
\end{lemma}

\begin{remark}
Clifford Algebra generators $\left\{ \left. x_{j_{1}}\right\vert 1\leq
j_{1}\,<\cdots <j_{n}\leq 2r\right\} $%
\begin{eqnarray}
I_{\mathcal{A}} &=&\mathfrak{X}\left( \varphi _{0}\right) \\
x_{j} &=&\mathfrak{X}\left( \varphi _{j}\right) \\
x_{j+r} &=&\mathfrak{X}\left( i\varphi _{j}\right) \\
1 &\leq &j\,\leq r.
\end{eqnarray}
\end{remark}

\begin{lemma}
$\mathcal{A}$ is a closed Clifford $c^{\ast }$-algebra with norm $\left\Vert
{}\right\Vert _{\mathcal{A}},$ i.e. multiplication in $\mathcal{A}$ is
continuous wrt $\left\Vert {}\right\Vert _{\mathcal{A}}.$
\end{lemma}

\begin{remark}
\emph{Clifford algebras} 
%TCIMACRO{%
%\hyperref{https://en.wikipedia.org/wiki/Clifford\_algebra}{}{}{https://en.wikipedia.org/wiki/Clifford_algebra} }%
%BeginExpansion
\msihyperref{https://en.wikipedia.org/wiki/Clifford\_algebra}{}{}{https://en.wikipedia.org/wiki/Clifford_algebra}
%EndExpansion
over a vector space $V$ are defined in terms of quadratic forms defined in $%
V $. The exterior algebra ${\large \wedge }\left( V\right) $ over $V$ is a
special case of a Clifford algebra over $V$ thus the definition of $%
\mathfrak{\boxtimes }\left( \mathfrak{s}^{\dagger }\right) $ could be
extended to \emph{index spaces} that are Clifford algebras.
\end{remark}

\begin{remark}
Let 
\begin{equation}
\left\Vert f\right\Vert _{\mathfrak{H}}=1
\end{equation}%
then 
\begin{equation}
\mathfrak{s}\left( f\right) \mathfrak{s}^{\dagger }\left( f\right) +%
\mathfrak{s}^{\dagger }\left( f\right) \mathfrak{s}\left( f\right) =I_{%
\mathcal{A}}.
\end{equation}
\end{remark}

Let $\omega \in \mathcal{S}\left( \mathcal{A}\right) \subset \mathcal{A}^{d}$
be a state of $\mathcal{A}$ and $\Phi _{\omega }\left( \mathcal{A}\right) $
be the GNS carrier space of the representation $\Pi _{\omega }\left( 
\mathcal{A}\right) $ of $\mathcal{A}$ associated with $\omega $ i.e. 
\begin{equation}
\Phi _{\omega }:\mathcal{A\rightarrow H}_{\omega }=\Phi _{\omega }\left( 
\mathcal{A}\right)
\end{equation}%
and 
\begin{equation}
\Pi _{\omega }:\mathcal{A\rightarrow B}\left( \mathcal{H}_{\omega }\right) ,
\end{equation}%
where 
\begin{equation}
\Pi _{\omega }\left( \mathcal{A}\right) \subseteq \mathcal{B}\left( \mathcal{%
H}_{\omega }\right) .
\end{equation}

\begin{notation}
\begin{enumerate}
\item 
\begin{equation}
\mathcal{H}_{\omega }\equiv \Phi _{\omega }\left( \mathcal{A}\right) .
\end{equation}

\item 
\begin{equation}
\mathcal{A}_{\omega }\equiv \mathcal{A}\left( \mathcal{H}_{\omega }\right)
\equiv \Pi _{\omega }\left( \mathcal{A}\right) .
\end{equation}
\end{enumerate}
\end{notation}

\begin{remark}
The identity of the representation $\mathcal{A}\left( \mathcal{H}_{\omega
}\right) $ is $I_{\mathcal{A}\left( \mathcal{H}_{\omega }\right) }$ and 
\begin{equation}
I_{\mathcal{B}\left( \mathcal{H}_{\omega }\right) }\geq I_{\mathcal{A}\left( 
\mathcal{H}_{\omega }\right) },
\end{equation}%
($I_{\mathcal{A}\left( \mathcal{H}_{\omega }\right) }$ might be an
orthogonal projector in $\mathcal{B}\left( \mathcal{H}_{\omega }\right) $)$.$
\end{remark}

\begin{definition}
The operator norm $\equiv c^{\ast }$-algebra norm in $\mathcal{B}\left( 
\mathcal{H}_{\omega }\right) $%
\begin{equation}
\left\Vert A\right\Vert _{\mathcal{B}\left( \mathcal{H}_{\omega }\right)
}=\left\Vert A\right\Vert _{\mathcal{A}\left( \mathcal{H}_{\omega }\right) }
\end{equation}%
is defined by%
\begin{equation}
\left\Vert \Pi _{\omega }\left( \mathfrak{s}\left( f\right) \right)
\right\Vert _{\mathcal{B}\left( \mathcal{H}_{\omega }\right) }=\left\Vert
\Pi _{\omega }\left( \mathfrak{s}^{\dagger }\left( f\right) \right)
\right\Vert _{\mathcal{B}\left( \mathcal{H}_{\omega }\right) }=\left\Vert
f\right\Vert _{\mathfrak{H}}.
\end{equation}
\end{definition}

\begin{remark}
\begin{eqnarray}
\left\Vert \Pi _{\omega }\left( \mathfrak{s}\left( f\right) \right)
\right\Vert _{\mathcal{B}\left( \mathcal{H}_{\omega }\right) }
&=&\sup_{\left\Vert \Phi _{w}\left( X\right) \right\Vert _{\mathcal{H}%
_{\omega }}=1}\left\Vert \Pi _{\omega }\left( \mathfrak{s}\left( f\right)
\right) \Phi _{w}\left( X\right) \right\Vert _{\mathcal{H}_{\omega
}}=\sup_{\left\Vert \Phi _{w}\left( X\right) \right\Vert _{\mathcal{H}%
_{\omega }}=1}\sqrt{\left\langle \left. \Pi _{\omega }\left( \mathfrak{s}%
\left( f\right) \right) \Phi _{\omega }\left( X\right) \right\vert \Pi
_{\omega }\left( \mathfrak{s}\left( f\right) \right) \Phi _{\omega }\left(
X\right) \right\rangle _{\mathcal{H}_{\omega }}} \\
&=&\sup_{\left\Vert \Phi _{w}\left( \mathfrak{s}\left( g\right) \right)
\right\Vert _{\mathcal{H}_{\omega }}=1}\sqrt{\left\langle \left. \Phi
_{\omega }\left( \mathfrak{s}\left( f\right) \mathfrak{s}\left( g\right)
\right) \right\vert \Phi _{\omega }\left( \mathfrak{s}\left( f\right) 
\mathfrak{s}\left( g\right) \right) \right\rangle _{\mathcal{H}_{\omega }}}%
=\sup_{\left\Vert \Phi _{w}\left( \mathfrak{s}\left( g\right) \right)
\right\Vert _{\mathcal{H}_{\omega }}=1}\sqrt{\left\langle \left. \Phi
_{\omega }\left( \mathfrak{s}\left( fg\right) \right) \right\vert \Phi
_{\omega }\left( \mathfrak{s}\left( fg\right) \right) \right\rangle _{%
\mathcal{H}_{\omega }}}.
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{equation}
\left\Vert \Phi _{w}\left( \mathfrak{s}\left( g\right) \right) \right\Vert _{%
\mathcal{H}_{\omega }}=\left\langle \left. \Phi _{\omega }\left( \mathfrak{s}%
\left( g\right) \right) \right\vert \Phi _{\omega }\left( \mathfrak{s}\left(
g\right) \right) \right\rangle =\omega \left( \mathfrak{s}\left( g\right)
^{\dagger }\mathfrak{s}\left( g\right) \right) .
\end{equation}
\end{remark}

\begin{definition}
\begin{eqnarray}
\mathfrak{n}\left( \varphi _{j}\right) &=&\mathfrak{s}\left( \varphi
_{j}\right) ^{\dagger }\mathfrak{s}\left( \varphi _{j}\right) \in \mathcal{A}
\\
\mathfrak{h}\left( \varphi _{j}\right) &=&\mathfrak{s}\left( \varphi
_{j}\right) \mathfrak{s}\left( \varphi _{j}\right) ^{\dagger }\in \mathcal{A}%
,
\end{eqnarray}%
where $\left\{ \left. \varphi _{j}\right\vert 1\leq j\leq r\right\} $is a
conbs of $\mathfrak{H.}$
\end{definition}

\begin{remark}
Then%
\begin{gather}
\mathfrak{n}\left( \varphi _{j}\right) \mathfrak{s}\left( \varphi
_{j}\right) ^{\dagger }=\mathfrak{s}\left( \varphi _{j}\right) ^{\dagger }%
\mathfrak{s}\left( \varphi _{j}\right) \mathfrak{s}\left( \varphi
_{j}\right) ^{\dagger }=\mathfrak{s}\left( \varphi _{j}\right) ^{\dagger }%
\mathfrak{h}\left( \varphi _{j}\right) =\mathfrak{s}\left( \varphi
_{j}\right) ^{\dagger }\left( I_{\mathcal{A}}-\mathfrak{s}\left( \varphi
_{j}\right) ^{\dagger }\mathfrak{s}\left( \varphi _{j}\right) \right) =%
\mathfrak{s}\left( \varphi _{j}\right) ^{\dagger } \\
\mathfrak{s}\left( \varphi _{j}\right) \mathfrak{n}\left( \varphi
_{j}\right) =\mathfrak{h}\left( \varphi _{j}\right) \mathfrak{s}\left(
\varphi _{j}\right) =\mathfrak{s}\left( \varphi _{j}\right)
\end{gather}%
and the operators $\mathfrak{n}\left( \varphi _{j}\right) $ and $\mathfrak{h}%
\left( \varphi _{j}\right) $ are selfadjoint, idempotents and orthogonal to
each other i.e. 
\begin{eqnarray}
\mathfrak{n}\left( \varphi _{j}\right) ^{2} &=&n\left( \varphi _{j}\right) \\
\mathfrak{h}\left( \varphi _{j}\right) ^{2} &=&\mathfrak{h}\left( \varphi
_{j}\right) \\
\mathfrak{n}\left( \varphi _{j}\right) ^{\dagger } &=&\mathfrak{n}\left(
\varphi _{j}\right) \\
\mathfrak{h}\left( \varphi _{j}\right) ^{\dagger } &=&\mathfrak{h}\left(
\varphi _{j}\right) \\
\mathfrak{n}\left( \varphi _{j}\right) \mathfrak{h}\left( \varphi
_{j}\right) &=&\mathfrak{n}\left( \varphi _{j}\right) \left( I_{\mathcal{A}}-%
\mathfrak{n}\left( \varphi _{j}\right) \right) =0.
\end{eqnarray}
\end{remark}

\begin{definition}
The operators $u\left( \varphi _{j}\right) ,v\left( \varphi _{j}\right) $ 
\begin{eqnarray}
u\left( \varphi _{j}\right) &=&\left( \mathfrak{n}\left( \varphi _{j}\right)
-\mathfrak{h}\left( \varphi _{j}\right) \right) \\
v\left( \varphi _{j}\right) &=&\left( \mathfrak{n}\left( \varphi _{j}\right)
+\mathfrak{h}\left( \varphi _{j}\right) \right) =I_{\mathcal{A}\left( 
\mathcal{H}\right) }
\end{eqnarray}%
are commuting self adjoint \emph{unitaries in the algebra }$\mathcal{A}$ as%
\emph{\ } 
\begin{equation}
\left( \mathfrak{n}\left( \varphi _{j}\right) -\mathfrak{h}\left( \varphi
_{j}\right) \right) ^{\dagger }\left( \mathfrak{n}\left( \varphi _{j}\right)
-\mathfrak{h}\left( \varphi _{j}\right) \right) =\mathfrak{n}\left( \varphi
_{j}\right) -2\mathfrak{n}\left( \varphi _{j}\right) \mathfrak{h}\left(
\varphi _{j}\right) +\mathfrak{h}\left( \varphi _{j}\right) =\mathfrak{s}%
\left( \varphi _{j}\right) ^{\dagger }\mathfrak{s}\left( \varphi _{j}\right)
+\mathfrak{s}\left( \varphi _{j}\right) \mathfrak{s}\left( \varphi
_{j}\right) ^{\dagger }=I_{\mathcal{A}}.
\end{equation}
\end{definition}

\begin{definition}
of product unitaries by 
\begin{equation}
u_{j-1}\left( \varphi \right) =\tprod\limits_{1\leq k\leq j-1}u\left(
\varphi _{k}\right) =u\left( \varphi _{1}\right) \cdots u\left( \varphi
_{j-1}\right) =\left( \mathfrak{n}\left( \varphi _{1}\right) -\mathfrak{h}%
\left( \varphi _{1}\right) \right) \cdots \left( \mathfrak{n}\left( \varphi
_{j-1}\right) -\mathfrak{h}\left( \varphi _{j-1}\right) \right) ;\,1\leq
j\leq r=\dim \left\{ \mathfrak{H}\right\} .
\end{equation}
\end{definition}

\begin{definition}
The operators $\left\{ \left. e_{kl}\left( \varphi _{j}\right) \right\vert
1\leq k,l\leq 2,1\leq j\leq r\right\} $ by 
\begin{eqnarray}
e_{11}\left( \varphi _{j}\right) &=&\mathfrak{h}\left( \varphi _{j}\right) \\
e_{12}\left( \varphi _{j}\right) &=&u_{j-1}\left( \varphi \right) \mathfrak{s%
}\left( \varphi _{j}\right) \\
e_{21}\left( \varphi _{j}\right) &=&u_{j-1}\left( \varphi \right) \mathfrak{s%
}\left( \varphi _{j}\right) ^{\dagger } \\
e_{22}\left( \varphi _{j}\right) &=&\mathfrak{n}\left( \varphi _{j}\right) .
\end{eqnarray}
\end{definition}

\begin{definition}
$2\times 2$ matrices $\left\{ \left. \mathfrak{e}\left( \left( \varphi
_{j}\right) \right) \right\vert 1\leq j\leq r\right\} $ with matrix elements 
\begin{equation}
\left\{ \left\{ \left. e_{kl}\left( \varphi _{j}\right) \right\vert 1\leq
k,l\leq 2\right\} ;1\leq j\leq r\right\} \cong \mathcal{M}\left( 2,2,%
\mathcal{A}\right)
\end{equation}%
by 
\begin{equation}
\mathfrak{e}\left( \varphi _{j}\right) =\left( 
\begin{array}{cc}
\mathfrak{h}\left( \varphi _{j}\right) & u_{j}\left( \varphi \right) 
\mathfrak{s}\left( \varphi _{j}\right) \\ 
u_{j}\left( \varphi \right) \mathfrak{s}\left( \varphi _{j}\right) ^{\dagger
} & \mathfrak{n}\left( \varphi _{j}\right)%
\end{array}%
\right) ,\,1\leq j\leq r,
\end{equation}%
where 
\begin{equation}
u_{0}\left( \varphi \right) =I_{\mathcal{A}}.
\end{equation}
\end{definition}

\begin{remark}
The set $\left\{ \left. \mathfrak{e}\left( \varphi _{j}\right) \right\vert
1\leq j\leq r\right\} $ is a system of $r$-$\left( 2\times 2\right) $-\emph{%
operator} matrix units. These units commute for different $j.$
\end{remark}

\begin{remark}
For $r=1$ and thus $j=1$%
\begin{equation}
\mathfrak{e}\left( \varphi _{j}\right) \in \mathcal{M}\left( 2,2,\mathcal{A}%
\right) \equiv \mathcal{B}\left( \mathcal{A}^{2}\right) .
\end{equation}
\end{remark}

\begin{example}
For $r=1$ and thus $j=1$ one has

\begin{enumerate}
\item 
\begin{eqnarray}
u\left( \varphi _{1}\right) &=&\left( \mathfrak{n}\left( \varphi _{1}\right)
-\mathfrak{h}\left( \varphi _{1}\right) \right) \\
v\left( \varphi _{1}\right) &=&\left( \mathfrak{n}\left( \varphi _{1}\right)
+\mathfrak{h}\left( \varphi _{1}\right) \right) =I_{\mathcal{A}\left( 
\mathcal{H}\right) }
\end{eqnarray}

\item 
\begin{equation}
u_{0}\left( \varphi \right) =\tprod\limits_{1\leq k\leq 1}u\left( \varphi
_{k}\right) =u\left( \varphi _{1}\right) ;\,1\leq m\leq 1=\dim \left\{ 
\mathfrak{H}\right\} .
\end{equation}

\item 
\begin{eqnarray}
e_{11}\left( \varphi _{1}\right) &=&\mathfrak{h}\left( \varphi _{1}\right) \\
e_{12}\left( \varphi _{1}\right) &=&u_{0}\left( \varphi _{1}\right) 
\mathfrak{s}\left( \varphi _{1}\right) \\
e_{21}\left( \varphi _{1}\right) &=&u_{0}\left( \varphi _{1}\right) 
\mathfrak{s}\left( \varphi _{1}\right) ^{\dagger } \\
e_{22}\left( \varphi _{1}\right) &=&\mathfrak{n}\left( \varphi _{1}\right)
\end{eqnarray}%
hence

\item 
\begin{equation}
\mathfrak{e}\left( \varphi _{1}\right) =\left( 
\begin{array}{cc}
\mathfrak{h}\left( \varphi _{1}\right) & u_{0}\left( \varphi _{1}\right) 
\mathfrak{s}\left( \varphi _{1}\right) \\ 
u_{0}\left( \varphi _{1}\right) \mathfrak{s}\left( \varphi _{1}\right)
^{\dagger } & \mathfrak{n}\left( \varphi _{1}\right)%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathfrak{h}\left( \varphi _{1}\right) & \mathfrak{s}\left( \varphi
_{1}\right) \\ 
\mathfrak{s}\left( \varphi _{1}\right) ^{\dagger } & \mathfrak{n}\left(
\varphi _{1}\right)%
\end{array}%
\right) \in \mathcal{M}\left( 2,2,\mathcal{A}\right) \cong \mathcal{B}\left( 
\mathcal{A}^{2}\right) ,\,1\leq j\leq r.
\end{equation}
\end{enumerate}
\end{example}

\begin{remark}
\begin{equation}
\mathcal{M}\left( 2,2,\mathcal{A}\right) \cong \mathcal{M}\left( 2,2,\mathbb{%
C}\right)
\end{equation}
\end{remark}

\begin{remark}
One can think of $\mathfrak{H}$ as being a "one particle " or indexing space$%
.$
\end{remark}

\begin{enumerate}
\item The $c^{\ast }$-algebra $\mathcal{A}\left( \mathcal{H}\right)
\subseteq \mathcal{B}\left( \mathcal{H}\right) $ generated by $\left\{
\left. \Pi \left( \mathfrak{s}^{\dagger }\left( \varphi _{j}\right) \right)
,\Pi \left( \mathfrak{s}\left( \varphi _{j}\right) \right) \right\vert 1\leq
j\leq r\right\} $ is isomorphic to subspaces contained in the space $%
\mathcal{M}\left( 2^{r},2^{r},\mathbb{C}\right) $ the algebra of complex $%
2^{r}\times 2^{r}$ $\mathbb{C}$-matrices.

\item If $r=\infty $ then $\mathcal{A}\left( \mathcal{H}\right) $ is $%
c^{\ast }$-algebra isomorphic to the infinite tensor product of $\mathcal{M}%
\left( 2,\mathbb{C}\right) $ and the resulting $c^{\ast }$-algebra is the
CAR algebra, $CAR\left\{ \mathcal{H}\right\} ,$contained in operators acting
in the GNS Hilbert space $\mathcal{H=\Phi }\left( \mathcal{A}\right) $.

\item This algebra is simple i.e. not a direct sum of subalgebras.

\item The infinite tensor product in this case means the proper $c^{\ast }$%
-algebra \emph{inductive limit} of the sub algebras $\otimes ^{r}\mathcal{M}%
\left( 2,2,\mathbb{C}\right) $ and thus is an \emph{Almost Finite (AF)} $%
c^{\ast }$-algebra$.$
\end{enumerate}

\subsection{$w^{\ast }$-algebras generated by $\mathcal{A}\left( \mathcal{%
\Phi }\left( \mathcal{A}\right) \right) .$}

This section is based on \textbf{M. Takesaki, Theory of Operator Algebras
III, (Encyclopaedia of Mathematical Sciences }

Volume $127,$pp$91-\cdots ,$year $2001$\textbf{).}

\begin{definition}
A state $\omega \in \mathcal{S}\left( \mathcal{A}\right) $ can be determined
by a set of positive functions $\left\{ W_{m,n}^{\omega }\left( f_{1},\cdots
,f_{m};g_{1},\cdots ,g_{n}\right) \right\} $ (\emph{Wightman functions})%
\begin{equation}
W_{m,n}^{\omega }:{\Large X}^{m+n}\left( \mathfrak{H}\right) \rightarrow 
\mathbb{C}
\end{equation}%
and is defined by 
\begin{equation}
\omega \left( \mathfrak{s}\left( g_{1}\right) ^{\dagger }\cdots \mathfrak{s}%
\left( g_{m}\right) ^{\dagger }\mathfrak{s}\left( f_{1}\right) \cdots 
\mathfrak{s}\left( f_{n}\right) \right) =W_{m,n}^{\omega }\left(
f_{1},\cdots ,f_{m};g_{1},\cdots ,g_{n}\right) ,
\end{equation}%
where 
\begin{equation}
W_{m,m}^{\omega }\left( f_{1},\cdots ,f_{m};f_{1},\cdots ,f_{m}\right) \geq
0.
\end{equation}
\end{definition}

\begin{remark}
The state $\omega \in \mathcal{S}\left( \mathcal{A}\right) $ produces a
representation, $\Pi _{\omega }\left( \mathcal{A}\right) $ of $\mathcal{A}$
via the GNS procedure.
\end{remark}

Let $T\in \mathcal{B}_{0}\left( \mathfrak{H}\right) $ $\left( \text{compact
operators}\right) $ with $0\leq T\leq I_{\mathfrak{H}},$ so that 
\begin{equation}
T=\sum_{1\leq j\leq \infty }\lambda _{j}P_{j},0\leq \lambda _{j}\leq 1,
\end{equation}%
where $\left\{ \left. P_{j}\right\vert P_{j}\in \mathcal{B}_{0}\left( 
\mathfrak{H}\right) \right\} $ is a family of orthogonal projectors. Each
one of these projectors defines a subspace 
\begin{equation}
\mathfrak{M}_{j}=P_{j}\mathfrak{H},
\end{equation}%
which defines an orthogonal decomposition 
\begin{equation}
\mathfrak{H}=\dbigoplus\limits_{1\leq j\leq \infty }\mathfrak{M}_{j}.
\end{equation}%
The subspaces $\left\{ \mathfrak{M}_{j}\right\} $ generate the sub exterior
algebras $\left\{ \mathcal{E}\left( \mathfrak{M}_{j}\right) \equiv
\tbigwedge \left( \mathfrak{M}_{j}\right) \right\} $ and it can be shown
that 
\begin{equation}
\mathcal{E}\left( \mathfrak{H}\right) =\tbigwedge \left( \mathfrak{H}\right)
=\tbigoplus_{0\leq n\leq \infty }\tbigwedge\nolimits^{n}\left( \mathfrak{H}%
\right) =\dbigwedge \left( \tbigoplus_{1\leq j\leq \infty }\mathfrak{M}%
_{j}\right) =\dbigotimes\limits_{1\leq j\leq \infty }\tbigwedge \left( 
\mathfrak{M}_{j}\right) =\dbigotimes\limits_{1\leq j\leq \infty }\mathcal{E}%
\left( \mathfrak{M}_{j}\right)
\end{equation}%
and%
\begin{equation}
\mathcal{E}\left( \mathfrak{H}\right) =\tbigoplus_{0\leq n\leq \infty
}\tbigwedge\nolimits^{n}\left( \mathfrak{H}\right) =\tbigoplus_{0\leq n\leq
\infty }\tbigwedge\nolimits^{2n+1}\left( \mathfrak{H}\right) \oplus
\tbigoplus_{0\leq n\leq \infty }\tbigwedge\nolimits^{2n}\left( \mathfrak{H}%
\right) =\mathcal{E}\left( \mathfrak{H}\right) _{odd}\oplus \mathcal{E}%
\left( \mathfrak{H}\right) _{even}.
\end{equation}%
One can show that if $\mathfrak{M}_{j}{\large \bot }\mathfrak{M}_{k}$ (so
obviously $j\neq k$) then 
\begin{gather}
\left[ x,y\right] =0\text{ if }x\in \mathcal{A}\left( \mathfrak{M}%
_{j}\right) \text{ and }y\in \mathcal{A}\left( \mathfrak{M}_{k}\right) \\
\text{ }x\in \mathcal{A}_{even}\text{ \emph{or} }y\in \mathcal{A}_{even}
\end{gather}%
and 
\begin{gather}
\left\{ x,y\right\} =0\text{ if }x\in \mathcal{A}\left( \mathfrak{M}%
_{j}\right) \text{ and }y\in \mathcal{A}\left( \mathfrak{M}_{k}\right) \\
x\in \mathcal{A}_{odd}\text{ \emph{and} }y\in \mathcal{A}_{odd}.
\end{gather}

\begin{definition}
A state $\omega $ is a \emph{product state} relative to $\left\{ \left. 
\mathfrak{M}_{j}\right\vert 1\leq j\leq \infty \right\} $ if 
\begin{equation}
\omega \left( xy\right) =\omega \left( x\right) \omega \left( y\right)
\forall x\in \mathcal{A}\left( \mathfrak{M}_{j}\right) ,\forall y\in 
\mathcal{A}\left( \mathfrak{M}_{k}\right) ;1\leq j\neq k\leq \infty .
\end{equation}
\end{definition}

\begin{definition}
Define a state $\omega _{T}$ by the set of functions $\left\{
W_{n,m}^{T}\right\} $ 
\begin{equation}
W_{n,m}^{T}\left( f_{1}\cdots f_{n};g_{1}\cdots g_{m}\right) =\det \left\{
\left\langle \left. Tf_{j}\right\vert g_{k}\right\rangle \right\} \delta
_{nm}
\end{equation}
\end{definition}

then $\left\{ W_{n,m}^{T}\right\} $ determines an even state, $\omega _{T},$
on $\mathcal{A}$ i.e.%
\begin{equation}
\omega _{T}\left( \mathcal{A}_{odd}\right) =0.
\end{equation}

If $T=0$ then the state $\omega _{0}$ is defined by 
\begin{equation}
\omega _{0}\left( \mathfrak{s}\left( g_{1}\right) ^{\dagger }\cdots 
\mathfrak{s}\left( g_{m}\right) ^{\dagger }\mathfrak{s}\left( f_{1}\right)
\cdots \mathfrak{s}\left( f_{n}\right) \right) =W_{n,m}^{0}\left(
f_{1}\cdots f_{n};g_{1}\cdots g_{m}\right) =0,
\end{equation}%
and produces a Fock vacuum vector%
\begin{equation}
\left\vert \phi _{\omega _{0}}\right\rangle =\Phi _{\omega _{0}}\left( I_{%
\mathcal{A}}\right)
\end{equation}%
in the Fock representation 
\begin{equation}
\Pi _{\omega _{0}}\left( \mathcal{A}\right) \equiv \mathcal{B}\left( {\LARGE %
\wedge }\left( \Phi _{\omega _{0}}\left( \mathcal{A}\right) \right) \right) .
\end{equation}%
In this case $\Pi _{\omega _{0}}\left( \mathcal{A}\right) $ is a $c^{\ast }$%
-algebra that is a Type $I_{r}$ Von Neumann algebra$.$

\begin{remark}
\emph{Different Fock} representations come from \emph{different} $\mathfrak{H%
}^{\prime }s.$ \emph{These are generated by different real form
decompositions of }$\mathfrak{H},$\emph{\ \underline{\emph{some}} of which
are unitarily inequivalent.}
\end{remark}

\begin{notation}
We denote Clifford/CAR $c^{\ast }$-algebras by $\mathcal{A}$ and Fock
representations of such algebras by $\mathcal{F}.$ The difference between $%
\mathcal{A}$ and $\mathcal{F}$ are

\begin{enumerate}
\item $\mathcal{F}$ acts in a Hilbert space $\mathcal{H}_{\mathcal{F}%
}=\tbigwedge \left( \mathcal{H}^{1}\right) $ that contains a bare vacuum
vector $\left\vert \phi \right\rangle \in \tbigwedge^{0}\left( \mathcal{H}%
^{1}\right) .$

\item $\mathcal{A}$ does \emph{not act} in a Hilbert space and thus contains 
\emph{NO }ket-bra operators $\left\vert \Phi \right\rangle \left\langle \Psi
\right\vert $\emph{\ formed from vectors belonging to a Hilbert space. }
\end{enumerate}
\end{notation}

If $T=\frac{1}{2}I_{\mathfrak{H}}$ then 
\begin{equation}
\omega _{\frac{1}{2}I_{\mathfrak{H}}}\left( \mathfrak{s}\left( g_{1}\right)
^{\dagger }\cdots \mathfrak{s}\left( g_{m}\right) ^{\dagger }\mathfrak{s}%
\left( f_{1}\right) \cdots \mathfrak{s}\left( f_{n}\right) \right) =W_{n,m}^{%
\frac{1}{2}I_{\mathfrak{H}}}\left( f_{1}\cdots f_{n};g_{1}\cdots
g_{m}\right) =\frac{1}{2^{n}}\det \left\{ \left\langle \left.
f_{j}\right\vert g_{k}\right\rangle \right\} \delta _{nm}
\end{equation}%
and $\tau =\omega _{\frac{1}{2}I_{\mathfrak{H}}}$ is a tracial state on $%
\mathcal{A}$. The enveloping von Neumann algebra generated by $\pi _{\omega
_{\frac{1}{2}I_{\mathfrak{H}}}}$ is isomorphic to a subspace of $%
\dbigotimes^{\infty }\left( \mathcal{M}\left( 2,2;\mathbb{C}\right) \right) $
relative to the normalized trace $\tau $ and is a factor of type $II_{1}$
(Takesaki).

\begin{align}
\tau \left( \mathfrak{s}\left( f\right) ^{\dagger }\mathfrak{s}\left(
f\right) \right) & =\left\langle \left. \Phi _{\omega _{\frac{1}{2}I_{%
\mathfrak{H}}}}\left( \mathfrak{s}\left( f\right) \right) \right\vert \Phi
_{\omega _{\frac{1}{2}I_{\mathfrak{H}}}}\left( \mathfrak{s}\left( f\right)
\right) \right\rangle _{\omega _{\frac{1}{2}I_{\mathcal{H}}}}=\omega _{\frac{%
1}{2}I_{\mathfrak{H}}}\left( \mathfrak{s}\left( f\right) ^{\dagger }%
\mathfrak{s}\left( f\right) \right) =\frac{1}{2}\left\langle \left.
f\right\vert f\right\rangle \\
& =\left\langle \left. \Phi _{\omega _{\frac{1}{2}I_{\mathfrak{H}}}}\left( 
\mathfrak{s}\left( f\right) \right) \right\vert \Pi _{\omega _{\frac{1}{2}I_{%
\mathfrak{H}}}}\left( \mathfrak{s}\left( f\right) \right) \Phi _{\omega _{%
\frac{1}{2}I_{\mathfrak{H}}}}\left( I\right) \right\rangle _{\omega _{\frac{1%
}{2}I_{\mathcal{H}}}} \\
& =\left\langle \left. \Pi _{\omega _{\frac{1}{2}I_{\mathcal{H}}}}\left( 
\mathfrak{s}\left( f\right) \right) \omega _{\frac{1}{2}I_{\mathfrak{H}%
}}\left( I\right) \right\vert \Pi _{\omega _{\frac{1}{2}I_{\mathfrak{H}%
}}}\left( \mathfrak{s}\left( f\right) \right) \omega _{\frac{1}{2}I_{%
\mathfrak{H}}}\left( I\right) \right\rangle _{\omega _{\frac{1}{2}I_{%
\mathcal{H}}}} \\
& =\left\langle \left. \omega _{\frac{1}{2}I_{\mathfrak{H}}}\left( I\right)
\right\vert \Pi _{\omega _{\frac{1}{2}I_{\mathfrak{H}}}}\left( \mathfrak{s}%
\left( f\right) ^{\dagger }\mathfrak{s}\left( f\right) \right) \omega _{%
\frac{1}{2}I_{\mathfrak{H}}}\left( I\right) \right\rangle _{\omega _{\frac{1%
}{2}I_{\mathcal{H}}}}.
\end{align}

If $T=\mu I_{\mathcal{H}},$ $0<\mu <\frac{1}{2},$the state $\omega _{\mu I_{%
\mathfrak{H}}}$ gives rise to a factor of Type $III_{\lambda }$, where 
\begin{equation}
\lambda =\frac{\mu }{\left( 1-\mu \right) }.
\end{equation}

\begin{remark}
The von Neumann algebras generated by \emph{cyclic }representations $\pi
_{\omega _{T}}$ are AFD (\emph{Almost Finite Dimension}) factors for any $T.$
\end{remark}

\begin{remark}
The construction of CAR representations can be extended by considering
Gelfand Triples, $\Xi ^{d}\supseteq \mathfrak{H}$ $\supseteq $ $\Xi ,$ of $%
\mathfrak{H}$ where the test function spaces $\Xi $ are dense subspaces of $%
\mathfrak{H}$ and $\Xi ^{d}$ is the corresponding space of distributions.
\end{remark}

\begin{theorem}
If $r=\infty $ then $\mathfrak{X}$ generates a Clifford Algebra from $%
\mathfrak{H}$ through the state $\omega _{\frac{1}{2}I_{\mathfrak{H}}}.$
\end{theorem}

\begin{remark}
Does this mean that in the $r=\infty $ limit the only $c^{\ast }$-algebras
that are both Clifford algebras and CAR algebras are Type $II_{1}$ $w^{\ast
} $-algebras?.
\end{remark}

\section{Polynomial *-Algebras}

Let $\left\{ I_{\mathcal{A}},\left\{ \left. x_{j_{1}}\cdots
x_{j_{p}}\right\vert 1\leq j_{1},\cdots ,j_{p}\leq 2r\right\} \right\} $ be
a possibly over complete basis for a complex algebra $\mathcal{A}_{finite}$,
generated by $\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\} ,$ i.e. 
\begin{equation}
\mathcal{A}_{finite}=\mathbb{C}\text{-}\limfunc{linspan}\limfunc{poly}%
\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\}
\end{equation}%
and the linear span is limited to all \emph{finite} complex linear
combination of products of the generators of $\mathcal{A}_{finite},$ i.e. by
finite complex polynomials of the generators even when $r=\infty $. It is
possible to consider the collection of infinite complex polynomials of the
generators, $\mathcal{A}_{\infty },$which could be different from $\mathcal{A%
}_{finite}.$ In the following $\mathcal{A}$ will denote $\mathcal{A}%
_{finite} $ unless stated otherwise. We assume that the algebras are unital
i.e. $I_{\mathcal{A}}\in \mathcal{A}_{finite}.$

Note that in general we are limiting consideration to algebras where the
generators satisfy certain relationships, e.g. in the CAR/Clifford case $%
\left\{ I_{\mathcal{A}},\left\{ \left. x_{j_{1}}\cdots x_{j_{p}}\right\vert
1\leq j_{1}<\cdots <j_{p}\leq 2r\right\} \right\} $ is a complete basis. We
also use the set of formal linear maps (ignoring continuity and boundness) $%
T\in \mathcal{L}\left( \mathcal{A}\right) $ acting in $\mathcal{A}$ i.e. 
\begin{align}
T& :\mathcal{A}\longrightarrow \mathcal{A} \\
T(\alpha A+\beta B)& =\alpha T(A)+\beta T(B);\alpha ,\beta \in \mathbb{C}%
,A,B\in \mathcal{A}.
\end{align}

\begin{remark}
Complex algebras can always be generated by even dimensional real agebras of
twice the generator dimension and the introduction of a complex structure,
so we don't have to always consider complex algebras.
\end{remark}

\begin{remark}
We \emph{sometimes} assume or limit to the special case where there exists a
unique bounded linear functional $\mathit{\limfunc{tr}}\in \mathcal{A}^{d}$
that is a \emph{normalized faithful tracial} state.
\end{remark}

\begin{remark}
We also in general consider Clifford/CAR algebras -though some relationships
do not depend on this.
\end{remark}

\begin{remark}
If $\mathcal{A}\ $is a $w^{\ast }$-algebra and a factor then it must be a
Type $II_{1}$ algebra for a normalized trace to exist.
\end{remark}

\begin{remark}
\begin{enumerate}
\item A \emph{factor} is a von Neumann algebra with trivial center, i.e. a
center consisting only of scalar operators.

\item A finite von Neumann algebra is one which is the direct integral of
finite factors, meaning that the von Neumann algebra has a faithful normal
tracial state 
\begin{equation}
\U{3c4} :\mathcal{A}\rightarrow \mathbb{C}.
\end{equation}

\item Similarly, properly infinite von Neumann algebras are the direct
integral of properly infinite factors.

\item A von Neumann algebra that acts on a separable Hilbert space is called
separable. Note that such algebras are rarely separable in the norm topology.
\end{enumerate}
\end{remark}

\begin{remark}
A von Neumann algebra is simple precisely when it is either a factor of type 
$I_{n}$ for $n<\infty $, a factor of type $II_{1}$, or a separable factor of
type $III$.
\end{remark}

\begin{remark}
A von Neumann algebra that acts on a separable Hilbert space is called
separable.
\end{remark}

\paragraph{Digression on Tracial States}

Consider normalized traces on the finite dimensional matrix algebras $%
\left\{ \mathcal{A}_{j}\right\} $ given by 
\begin{equation}
\left. \mathit{\limfunc{tr}}\right. _{j}=\left( \dim \left\{ \mathcal{A}%
_{j}\right\} \right) ^{\text{-}1}\left. \func{Tr}\right. _{j},
\end{equation}%
and the algebraic direct sum of these algebras 
\begin{equation}
\mathcal{A}_{dir}=\bigoplus\limits_{1\leq j\leq m}\mathcal{A}_{j},
\end{equation}%
where $\left. \func{Tr}\right. _{j}$ is the standard trace.

The infinite case could be handled by taking limits e.g. 
\begin{equation}
\left. \mathit{\limfunc{tr}}\right. _{j}\left\{ I_{j}\right\}
=\lim\limits_{r\rightarrow \infty }\left( \dim \left\{ \mathcal{A}%
_{j}\right\} \right) ^{\text{-}1}\left. \func{Tr}\right. _{j}\left\{
I_{j}\right\} =1,
\end{equation}%
where 
\begin{equation}
r=\dim \left\{ \mathcal{A}_{j}\right\} .
\end{equation}%
This does not imply that the normalized trace is finite in the limit for all
elements of the algebra only that is normalized, thus it is possible that

\begin{equation}
\lim\limits_{r\rightarrow \infty }\left( \dim \left\{ \mathcal{A}%
_{j}\right\} \right) ^{\text{-}1}\left. \func{Tr}\right. _{j}\left\{
A_{j}\right\} =\infty ,
\end{equation}%
for some $A$ where 
\begin{equation}
A=\lim\limits_{r\rightarrow \infty }A_{j}\Leftrightarrow
\lim\limits_{r\rightarrow \infty }\left\Vert A-A_{j}\right\Vert _{\mathcal{A}%
_{j}}=0.
\end{equation}%
Other limits such as the inductive limit can also be considered.

Clearly $\left. \mathit{\limfunc{tr}}\right. _{j}$ are states of $\mathcal{A}%
_{j}$ as they are postive linear functionals and 
\begin{equation}
\left. \mathit{\limfunc{tr}}\right. _{j}\left\{ I_{j}\right\} =\left( \dim 
\mathcal{A}_{j}\right) ^{\text{-}1}\left. \func{Tr}\right. _{j}\left\{
I_{j}\right\} =1.
\end{equation}

\emph{Note that direct sums of algebras are different to direct sums of
vector spaces as the full }$\left( \sum_{1\leq j\leq m}\dim V_{j}\right) $ 
\emph{dimensional vector space }$V$ \emph{can be expressed as the vector
space direct sum } \emph{\ }%
\begin{equation}
V=V_{dir}=\bigoplus\limits_{1\leq j\leq m}V_{j},
\end{equation}
\emph{but the full }$\left( \sum_{1\leq j\leq m}\dim\mathcal{A}_{j}\right) $%
\emph{\ dimensional algebra }$\mathcal{A}$\emph{\ cannot be expressed as }%
\begin{equation}
\mathcal{A}_{dir}=\bigoplus\limits_{1\leq j\leq m}\mathcal{A}_{j}.
\end{equation}
It is easy to see that $\mathcal{A}_{dir}\subseteq\mathcal{A}$\emph{\ }as a
semi-simple subalgebra.

One can introduce the mutually orthogonal self adjoint projectors $\equiv $
self adjoint idempotents $\left\{ P_{j}\right\} $ in $\mathcal{A}_{dir}$
i.e. 
\begin{align}
P_{j}P_{k}& =P_{j}\delta _{jk}, \\
I_{\mathcal{A}_{j}}& =\left. P_{j}\right\vert _{\mathcal{A}_{j}},
\end{align}%
associated with the subalgebras $\left\{ \mathcal{A}_{j}\right\} ,$ which
are two sided ideals $\left\{ P_{j}\mathcal{A}_{dir}P_{j}\right\} $ in $%
\mathcal{A}_{dir}.$ Left and right ideals are defined by $\left\{ P_{j}%
\mathcal{A}_{dir}\right\} $ and $\left\{ \mathcal{A}_{dir}P_{j}\right\} $
respectively. Faithful normal tracial states $\left. \mathit{\limfunc{tr}}%
\right. _{j}$ can be extended to $\mathcal{A}_{dir}$ by defining in general
the \emph{non faithful normal tracial states }$f_{\mathit{\limfunc{tr}}j}$
as \emph{\ } 
\begin{equation}
f_{\mathit{\limfunc{tr}}j}\left( A\right) =\mathit{\limfunc{tr}}\left\{
AP_{j}\right\} =\left( \dim \mathcal{A}_{j}\right) ^{\text{-}1}\func{Tr}%
\left\{ AP_{j}\right\} =\left( \dim \mathcal{A}_{j}\right) ^{\text{-}%
1}\left. \func{Tr}\right. _{j}\left\{ AP_{j}\right\} ,\quad A\in \mathcal{A}%
_{dir},
\end{equation}%
such that 
\begin{equation}
f_{\mathit{\limfunc{tr}}j}\left( A\right) =\left\{ 
\begin{array}{c}
\left. \mathit{\limfunc{tr}}\right. _{j}\left\{ A\right\} =\left( \dim 
\mathcal{A}_{j}\right) ^{\text{-}1}\left. \func{Tr}\right. _{j}\left\{
A\right\} \text{ if }A\in \mathcal{A}_{j} \\ 
0\text{ if }A\notin \mathcal{A}_{j}%
\end{array}%
\right. ,
\end{equation}%
and 
\begin{align}
f_{\mathit{\limfunc{tr}}j}\left( I_{\mathcal{A}_{dir}}\right) & =f_{\mathit{%
\limfunc{tr}}j}\left( \sum_{1\leq k\leq m}P_{k}\right) =\mathit{\limfunc{tr}}%
\left\{ \left( \sum_{1\leq k\leq m}P_{k}\right) P_{j}\right\} =\func{Tr}%
\left\{ \left( \sum_{1\leq k\leq m}P_{k}\right) \left( \left( \dim \mathcal{A%
}_{j}\right) ^{\text{-}1}P_{j}\right) \right\} \\
& =\left( \dim \mathcal{A}_{j}\right) ^{\text{-}1}\func{Tr}\left\{
P_{j}\right\} =\left( \dim \mathcal{A}_{j}\right) ^{\text{-}1}\left. \func{Tr%
}\right. _{j}\left\{ I_{j}\right\} =1,
\end{align}%
where $\func{Tr}$ is the unnormalized trace on $\mathcal{A}\supset \mathcal{A%
}_{dir}.$

One can define \emph{faithful tracial} states $\mathit{\limfunc{tr}}$ as a
full convex sum of the the tracial states $\left\{ f_{\mathit{\limfunc{tr}}%
j}\right\} $ as 
\begin{equation}
\mathit{\limfunc{tr}\nolimits_{\alpha }}=\sum_{1\leq j\leq m}\alpha _{j}f_{%
\mathit{\limfunc{tr}}j};\sum_{1\leq j\leq m}\alpha _{j}=1,0<\alpha _{j}\leq 1
\end{equation}%
and 
\begin{equation}
\mathit{\limfunc{tr}\nolimits_{\alpha }}\left\{ I\right\} =\sum_{1\leq j\leq
m}\alpha _{j}f_{\mathit{\limfunc{tr}}j}\left\{ I\right\} =\sum_{1\leq j\leq
m}\alpha _{j}f_{\mathit{\limfunc{tr}}j}\left\{ \sum_{1\leq k\leq
m}P_{k}\right\} =\sum_{1\leq j,k\leq m}\alpha _{j}\delta _{jk}=\sum_{1\leq
j\leq m}\alpha _{j}=1.
\end{equation}%
The standerd tracial state is given by 
\begin{equation}
\alpha _{j}=\frac{1}{m};1\leq j\leq m.
\end{equation}%
If $m>1$ then $\mathit{\limfunc{tr}}$ is not an extreme point of the convex
set of states, $\mathcal{S}\left( \mathcal{A}_{dir}\right) ,$ of $\mathcal{A}%
_{dir},$ i.e. not a pure state, though it is a faithful normal tracial state$%
.$

Every element of $\mathcal{A}_{dir}$ can be expanded as 
\begin{equation}
A=\sum_{1\leq j\leq m}P_{j}AP_{j}.
\end{equation}%
In particular a normal state, $f_{D_{j}},$ can be defined as 
\begin{align}
f_{D_{j}}\left( A\right) & =\mathit{\limfunc{tr}}\left\{ A\left( \dim 
\mathcal{A}_{j}\right) D_{j}\right\} =\mathit{\limfunc{tr}}\left\{
P_{j}AP_{j}\left( \dim \mathcal{A}_{j}\right) D_{j}\right\} =f_{\mathit{%
\limfunc{tr}}j}\left( P_{j}AP_{j}\left( \dim \mathcal{A}_{j}\right)
D_{j}\right) \\
& =\left( \dim \mathcal{A}_{j}\right) \left. \mathit{\limfunc{tr}}\right.
_{j}\left\{ P_{j}AP_{j}D_{j}\right\} =\left. \func{Tr}\right. _{j}\left\{
P_{j}AP_{j}D_{j}\right\} ,
\end{align}%
where 
\begin{equation}
D_{j}=P_{j}D_{j}P_{j}=P_{j}D_{j}=D_{j}P_{j},
\end{equation}%
and 
\begin{equation}
f_{\mathit{\limfunc{tr}}j}\left\{ D_{j}\right\} =\mathit{\limfunc{tr}}%
\left\{ \left( \dim \mathcal{A}_{j}\right) D_{j}\right\} =\left( \dim 
\mathcal{A}_{j}\right) \left. \mathit{\limfunc{tr}}\right. _{j}\left\{
D_{j}\right\} =\func{Tr}\left\{ D_{j}\right\} =1.
\end{equation}%
$\lceil $%
\begin{gather}
f_{D}\left( A\right) =\mathit{\limfunc{tr}}\left\{ A\left( \dim \mathcal{A}%
\right) D\right\} =\mathit{\limfunc{tr}}\left\{ A\mathfrak{d}\right\}
=\left( \dim \mathcal{A}\right) ^{\text{-}1}\func{Tr}\left\{ A\left( \dim 
\mathcal{A}\right) D\right\} =\func{Tr}\left\{ AD\right\} \\
f_{D}\left( I_{\mathcal{A}}\right) =1
\end{gather}%
$\rfloor $

\paragraph{End of Digression.}

\subsubsection{Trace in Clifford Algebras}

\begin{definition}
Any element $X$ of the Clifford algebra $\mathcal{A}$ can be expanded as 
\begin{equation}
X=\left\langle \left\langle X\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq j\leq 2^{2r}}X_{j}=\left\langle \left\langle X\right\rangle
\right\rangle _{0}I_{\mathcal{A}}+\sum_{1\leq n\leq 2^{2r}}\left\langle
X\right\rangle _{n},
\end{equation}%
where $\left\langle \left\langle X\right\rangle \right\rangle _{0}\in 
\mathbb{C}$ and 
\begin{equation}
X_{n}=\sum_{1\leq j_{1}<\cdots <j_{n}\leq 2r}x_{j_{1}}\cdots x_{j_{n}}%
\mathcal{R}_{x}\left( X_{n}\right) _{j_{1}\cdots j_{n}}.
\end{equation}
\end{definition}

\begin{remark}
\begin{equation}
\left\langle X\right\rangle _{n}=\left\langle X_{n}\right\rangle ,\quad
0\leq n\leq 2r.
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left\langle X_{n}\right\rangle _{0}=\left\langle \left\langle
X_{n}\right\rangle \right\rangle _{0}=0,\quad 1\leq n\leq 2r.
\end{equation}
\end{remark}

\begin{remark}
Let $r=\infty $ then

\begin{enumerate}
\item 
\begin{equation}
XY=\left\langle \left\langle XY\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq n\leq \infty }\left\langle XY\right\rangle _{n},
\end{equation}

\item 
\begin{equation}
YX=\left\langle \left\langle YX\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq n\leq \infty }\left\langle YX\right\rangle _{n},
\end{equation}

\item Is $\left\langle \left\langle {}\right\rangle \right\rangle _{0}$
tracial i.e. 
\begin{equation}
\left\langle \left\langle XY\right\rangle \right\rangle _{0}\overset{?}{=}%
\left\langle \left\langle YX\right\rangle \right\rangle _{0}
\end{equation}%
This equality depends on the limiting process and the continuity of operator
multiplication wrt this process. If the equality is not true $\left\langle
\left\langle {}\right\rangle \right\rangle _{0}$ is not a trace (nor a
weight) but still gives the coefficent of an operator wrt $I_{\mathcal{A}}.$

\item If $\mathcal{A}$ is a $w^{\ast }$-algebra the operator multiplication
is continuous wrt to the $\lim_{n\rightarrow \infty }$ 
\begin{eqnarray}
X &=&w^{\ast }\text{-}\lim_{n\rightarrow \infty }\left\{ X^{n}\right\} \\
Y &=&w^{\ast }\text{-}\lim_{n\rightarrow \infty }\left\{ Y^{n}\right\}
\end{eqnarray}%
if 
\begin{equation}
XY=w^{\ast }\text{-}\lim_{n\rightarrow \infty }\left\{ X^{n}Y^{n}\right\} .
\end{equation}

\item Is $\left\langle \left\langle {}\right\rangle \right\rangle _{0}$
discontnuous wrt the $w^{\ast }$ topology i.e. 
\begin{equation}
\left\langle \left\langle X\right\rangle \right\rangle _{0}=w^{\ast }\text{-}%
\lim_{n\rightarrow \infty }\left\{ \left\langle \left\langle
X^{n}\right\rangle \right\rangle _{0}\right\} \neq \left\langle \left\langle
X\right\rangle \right\rangle _{0}=\left\langle \left\langle w^{\ast }\text{-}%
\lim_{n\rightarrow \infty }\left\{ X\right\} \right\rangle \right\rangle
_{0},
\end{equation}%
which leads to 
\begin{equation}
\left\langle \left\langle XY\right\rangle \right\rangle _{0}=w^{\ast }\text{-%
}\lim_{n\rightarrow \infty }\left\{ \left\langle \left\langle
X^{n}Y^{n}\right\rangle \right\rangle _{0}\right\} \neq \left\langle
\left\langle XY\right\rangle \right\rangle _{0}=\left\langle \left\langle
w^{\ast }\text{-}\lim_{n\rightarrow \infty }\left\{ X^{n}Y^{n}\right\}
\right\rangle \right\rangle _{0}.
\end{equation}

\item The trace functional $\limfunc{Tr}$%
\begin{equation}
\limfunc{Tr}:\mathcal{B}\left( \mathcal{H}\right) \rightarrow \mathbb{C}
\end{equation}%
is discontinuous $\Leftrightarrow $ unbounded when $\dim \left\{ \mathcal{H}%
\right\} =\infty $ hence it is possible that 
\begin{equation}
\limfunc{Tr}\left\{ \lim_{n\rightarrow \infty }\left\{ X^{n}\right\}
\right\} \neq \lim_{n\rightarrow \infty }\left\{ \limfunc{Tr}\left\{
X^{n}\right\} \right\}
\end{equation}%
wrt the operator norm $\left\Vert {}\right\Vert _{\mathcal{B}\left( \mathcal{%
H}\right) }$ limits.
\end{enumerate}
\end{remark}

\begin{remark}
If $\mathcal{A}$ is a \emph{factor} then its centre only contains scalar
multiples of the identity.
\end{remark}

\begin{remark}
For a general algebra $\mathcal{A}$ the Jacobson radical $\func{rad}\left\{
A\right\} $ is defined as the ideal of all elements 
\begin{equation}
\func{rad}\left\{ A\right\} =\{\left. r\in \mathcal{A}\right\vert r\mathcal{M%
}=0,\text{ where }\mathcal{M}\text{ is a simple sub algebra}\}.
\end{equation}
\end{remark}

\begin{remark}
Simple Algebra an algebra with no nontrivial ideals.
\end{remark}

\begin{remark}
The \emph{Center} of unital simple $c^{\ast }$-algebra is $\mathbb{C}.$
\end{remark}

\begin{theorem}
If $\mathcal{A}$ is a $c^{\ast }$-algebra, then $\func{rad}\left\{ \mathcal{A%
}\right\} =\{0\}$, i.e. $\mathcal{A}$ is semi-simple.
\end{theorem}

\begin{remark}
If $\mathcal{A}$ is a $w^{\ast }$-algebra then it has a predual $\mathcal{A}%
_{d}$ and dual $\mathcal{A}^{d}$ so that $\mathcal{A}^{d}\supseteq \mathcal{A%
}_{d}.$

\begin{enumerate}
\item Let $X\in \mathcal{A}$ and $p\in \mathcal{A}_{d}$ then 
\begin{equation}
X\left( p\right) =f_{p}\left( X\right) \in \mathbb{C}
\end{equation}%
where $f_{p}\in \mathcal{A}^{d}.$

\item The $w^{\ast }$ topology is also denoted by $\sigma \left( \mathcal{A}%
_{d},\mathcal{A}\right) $ and on $\mathcal{A}$ is called the weak or $\sigma 
$ topology any element $X\in \mathcal{A}$ is the $w^{\ast }$ limit of a
sequence of elements $\left\{ X_{n}\right\} $ 
\begin{equation}
X=\lim \left\{ X_{n}\right\} \Leftrightarrow w^{\ast }\text{-}%
\lim_{n\rightarrow \infty }\left\{ \left\vert X\left( p\right) -X_{n}\left(
p\right) \right\vert \right\} =0,\quad \forall p\in \mathcal{A}_{d}
\end{equation}

\item 
\begin{equation}
X=\lim \left\{ X_{n}\right\} \Leftrightarrow w\text{-}\lim_{n\rightarrow
\infty }\left\{ \left\vert f\left( X\right) -f\left( X_{n}\right)
\right\vert \right\} =0,\quad \forall f\in \mathcal{A}^{d}
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
The \emph{ultraweak topology}, also called the \emph{weak-}$\ast $\emph{\
topology}, or \emph{weak-}$\ast $\emph{\ operator topology} or $\U{3c3} $%
\emph{-weak topology}, on $\mathcal{A}$ is the \emph{weak-}$\ast $\emph{\
topology} obtained from the predual $\mathcal{A}_{d}$ of $\mathcal{A}$. In
other words it is the weakest topology such that all elements of the predual
are continuous (when considered as functions on $\mathcal{A}$).
\end{remark}

\begin{remark}
A normalized trace $\tau \left( I_{\mathcal{A}}\right) $ $=1$ exists for
Type $I_{r}$ Von Neumann algebras $\equiv $ $w^{\ast }$-algebras, when $%
r<\infty $.
\end{remark}

\begin{remark}
When $r=\infty $

\begin{enumerate}
\item The zero grade component $X_{0}=\left\langle X\right\rangle _{0}$
always exists and belongs to $\mathcal{A}.$

\item A normalized trace $\tau \left( I_{\mathcal{A}}\right) $ $=1$ only
exists for Type $II_{1}$ and Type $I_{r},r<\infty $ Von Neumann algebras $%
\equiv $ $w^{\ast }$-algebras.

\item If a normalized trace $\tau $ exists 
\begin{equation}
\tau \left( X\right) =\left\langle \left\langle X\right\rangle \right\rangle
_{0}\tau \left( I_{\mathcal{A}}\right) =\left\langle \left\langle
X\right\rangle \right\rangle _{0}.
\end{equation}

\item If $\mathcal{A}$ is not a Type $II_{1}$ nor Type $I_{r},r<\infty $ Von
Neumann algebra then the above expansion of $X$ exists but the coefficient $%
\left\langle \left\langle X\right\rangle \right\rangle _{0}$ cannot be
identified with a normalized trace.

\item Let $X\in \mathcal{A}$ then one has the $w^{\ast }$\emph{-convergent
expansions}

\begin{enumerate}
\item Majorana Expansion%
\begin{equation}
X=\left\langle \left\langle X\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{1\leq n\leq \infty }\sum_{1\leq j_{1}<\cdots <j_{n}\leq \infty
}x_{j_{1}}\cdots x_{j_{n}}\mathcal{R}_{x}\left( X_{n}\right) _{j_{1}\cdots
j_{n}},
\end{equation}%
where

\begin{enumerate}
\item 
\begin{equation}
X_{n}=\left\langle X\right\rangle _{n}=\sum_{1\leq j_{1}<\cdots <j_{n}\leq
\infty }x_{j_{1}}\cdots x_{j_{n}}\mathcal{R}_{x}\left( X_{n}\right)
_{j_{1}\cdots j_{n}}
\end{equation}

\item 
\begin{equation}
X_{0}=\left\langle X\right\rangle _{0}=\left\langle \left\langle
X\right\rangle \right\rangle _{0}I_{\mathcal{A}}
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{x}\left( X_{n}\right) _{j_{1}\cdots j_{n}}=\left[
x_{j_{1}}^{d}\cdots x_{j_{n}}^{d}\right] \left( X_{n}\right) =\left[
x_{j_{1}}^{d}\cdots x_{j_{n}}^{d}\right] \left( X\right) .
\end{equation}

and
\end{enumerate}

\item Normal Creation/Annihilation Expansion 
\begin{equation}
X=\sum_{0\leq m,n\leq \infty }\sum_{\substack{ 1\leq j_{1}<\cdots <j_{m}\leq
\infty  \\ 1\leq k_{1}<\cdots <k_{n}\leq \infty }}a_{j_{1}}^{\dagger }\cdots
a_{j_{m}}^{\dagger }a_{k_{n}}\cdots a_{k_{1}}\mathcal{R}_{a}\left( X\right)
_{j_{1}\cdots j_{m}k_{1}\cdots k_{n}},
\end{equation}%
where 
\begin{equation}
\mathcal{R}_{a}\left( X\right) _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}=\left[
a_{j_{1}}^{d\dagger }\cdots a_{j_{m}}^{d\dagger }a_{k_{n}}^{d}\cdots
a_{k_{1}}^{d}\right] \left( X\right) .
\end{equation}
\end{enumerate}

\item 
\begin{gather}
XY=\left\langle \left\langle XY\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{0\leq n\leq \infty }\sum_{1\leq j_{1}<\cdots <j_{n}\leq \infty
}x_{j_{1}}\cdots x_{j_{n}}\mathcal{R}_{x}\left( \left\langle XY\right\rangle
_{n}\right) _{j_{1}\cdots j_{n}} \\
YX=\left\langle \left\langle YX\right\rangle \right\rangle _{0}I_{\mathcal{A}%
}+\sum_{0\leq n\leq \infty }\sum_{1\leq j_{1}<\cdots <j_{n}\leq \infty
}x_{j_{1}}\cdots x_{j_{n}}\mathcal{R}_{x}\left( \left\langle YX\right\rangle
_{n}\right) _{j_{1}\cdots j_{n}} \\
\left\langle XY\right\rangle _{0}=\left\langle \left\langle XY\right\rangle
\right\rangle _{0}I_{\mathcal{A}} \\
\left\langle YX\right\rangle _{0}=\left\langle \left\langle YX\right\rangle
\right\rangle _{0}I_{\mathcal{A}}.
\end{gather}%
In general in the case of non Type $II_{1}$ nor Type $I_{r},r<\infty $
factors 
\begin{equation}
\left\langle \left\langle XY\right\rangle \right\rangle _{0}\neq
\left\langle \left\langle YX\right\rangle \right\rangle _{0}\Leftrightarrow
\left\langle XY\right\rangle _{0}\neq \left\langle YX\right\rangle _{0}
\end{equation}%
and thus $\left\langle \left\langle {}\right\rangle \right\rangle _{0}$ is
not a normalized trace.

\item By definition 
\begin{equation}
\left\langle \left\langle I_{\mathcal{A}}\right\rangle \right\rangle _{0}=1
\end{equation}%
for both finite and infinite dimensions. If $r<\infty $ then 
\begin{equation}
\left\langle \left\langle XY\right\rangle \right\rangle _{0}=\left\langle
\left\langle YX\right\rangle \right\rangle _{0}
\end{equation}%
thus in finite dimenions

\begin{definition}
Of the normalized trace 
\begin{equation}
\limfunc{tr}\left\{ X\right\} =\left\langle \left\langle X\right\rangle
\right\rangle _{0}
\end{equation}%
but does not define a trace in infinite dimensions.
\end{definition}

\begin{theorem}
If $r<\infty $ then%
\begin{equation}
\left\langle \left\langle X\right\rangle \right\rangle _{0}=\limfunc{tr}%
