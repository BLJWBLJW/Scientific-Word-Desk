_{j_{2}j_{3}}x_{j_{2}}x_{j_{3}}x_{j_{1}}+\frac{1}{6}\sum_{1\leq
j_{1},j_{2},j_{3},j_{4}\leq 2r}\overline{\xi }_{j_{1}}\xi
_{j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\frac{1}{6}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq 2r}\xi _{j_{1}}\bar{\xi%
}_{j_{2}j_{3}j_{4}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{1}} \\
& =\lambda _{0}I_{\mathcal{A}}+\sum_{1\leq j_{1}\leq 2r}\lambda
_{j_{1}}x_{j_{1}}+\sum_{1\leq j_{1}<j_{2}\leq 2r}\lambda
_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}\leq 2r}\lambda
_{j_{1}j_{2}j_{3}}x_{j_{1}}x_{j_{2}}x_{j_{3}} \\
& +\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq 2r}\lambda
_{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}.
\end{align}%
In general one has 
\begin{equation}
A^{\dagger }A=\sum_{0\leq m,n\leq 2r}A_{m}^{\dagger }A_{n}=\sum_{0\leq
m,n\leq 2r}\sum_{j=0}^{\min \left( m,n\right) }\left\langle A_{m}^{\dagger
}A_{n}\right\rangle _{\left\vert m-n\right\vert +2j}
\end{equation}

Need to consider 
\begin{equation}
A_{0}^{\dagger }A_{4},A_{4}^{\dagger }A_{0},A_{1}^{\dagger
}A_{3},A_{3}^{\dagger }A_{1},A_{2}^{\dagger }A_{2},\cdots
\end{equation}%
e.g.%
\begin{eqnarray}
&&A_{2}^{\dagger }A_{2}=\sum_{\substack{ 1\leq j_{1}<j_{2}\leq 2r  \\ 1\leq
j_{3}<j_{4}\leq 2r}}\bar{A}_{2j_{1}j_{2}}A_{2j_{3}j_{4}}\left\{ \overset{}{%
x_{j_{2}}\wedge x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}-\Delta
_{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}}\right.  \notag \\
&&\qquad \qquad +\left. \overset{}{\Delta _{j_{2}j_{4}}x_{j_{1}}\wedge
x_{j_{3}}+\Delta _{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}-\Delta
_{j_{1}j_{4}}x_{j_{2}}\wedge x_{j_{3}}+\Delta _{j_{2}j_{4}}\Delta
_{j_{1}j_{3}}I_{\mathcal{F}}-\Delta _{j_{2}j_{3}}\Delta _{j_{1}j_{4}}I_{%
\mathcal{F}}}\right\} .
\end{eqnarray}%
Products of higher order terms can only occur if they cannot cancel out,
consider 
\begin{align}
A_{4}^{\dagger }A_{4}& =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq
2r  \\ 1\leq j_{5}<j_{6}\,<j_{7}<j_{8}\leq 2r}}\bar{A}%
_{4j_{1}j_{2}j_{3}j_{4}}A_{4j_{5}j_{6}j_{7}j_{8}}\left\{ \overset{}{%
x_{j_{4}}\wedge x_{j_{3}}\wedge x_{j_{2}}\wedge x_{j_{1}}\wedge
x_{j_{5}}\wedge x_{j_{6}}\wedge x_{j_{7}}\wedge x_{j_{8}}}\right. \\
& +\sum_{\sigma \in S_{8}/\left( S_{2}\times S_{6}\right) }\pi \left( \sigma
\right) \Delta _{j_{\sigma \left( 1\right) }j_{\sigma \left( 2\right)
}}x_{j_{\sigma \left( 3\right) }}\wedge x_{j_{\sigma \left( 4\right)
}}\wedge x_{j_{\sigma \left( 5\right) }}\wedge x_{j_{\sigma \left( 6\right)
}}\wedge x_{j_{\sigma \left( 7\right) }}\wedge x_{j_{\sigma \left( 8\right)
}} \\
& +\sum_{\sigma \in S_{8}/\left( S_{4}\times S_{4}\right) }\pi \left( \sigma
\right) \limfunc{Pf}\left( \mathbf{\Delta }_{j_{\sigma \left( 1\right)
}j_{\sigma \left( 2\right) }j_{\sigma \left( 3\right) }j_{\sigma \left(
4\right) }}\right) x_{j_{\sigma \left( 5\right) }}\wedge x_{j_{\sigma \left(
6\right) }}\wedge x_{j_{\sigma \left( 7\right) }}\wedge x_{j_{\sigma \left(
8\right) }} \\
& +\left. \sum_{\sigma \in S_{8}/\left( S_{6}\times S_{2}\right) }\pi \left(
\sigma \right) \limfunc{Pf}\left( \mathbf{\Delta }_{j_{\sigma \left(
1\right) }j_{\sigma \left( 2\right) }j_{\sigma \left( 3\right) }j_{\sigma
\left( 4\right) }j_{\sigma \left( 5\right) }j_{\sigma \left( 6\right)
}}\right) x_{j_{\sigma \left( 7\right) }}\wedge x_{j_{\sigma \left( 8\right)
}}+\limfunc{Pf}\left( \mathbf{\Delta }%
_{j_{1}j_{2}j_{3}j_{4}j_{5}j_{6}j_{7}j_{8}}\right) I_{\mathcal{F}}\right\} .
\end{align}%
\begin{align}
A_{4}^{\dagger }A_{2}& =\sum_{\substack{ 1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq
2r  \\ 1\leq j_{5}<j_{6}\leq 2r}}\bar{A}%
_{4j_{1}j_{2}j_{3}j_{4}}A_{2j_{5}j_{6}}\left\{ \overset{}{x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\wedge x_{j_{6}}}%
