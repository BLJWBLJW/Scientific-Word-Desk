\varphi }\right) -\mathfrak{s}\left( \mathbf{\varphi }\right) \right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{a}^{\dagger } & \mathbf{a}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
\mathbf{x}_{<} & \mathbf{x}_{>}%
\end{array}%
\right) \frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbb{I}_{r} & i\mathbb{I}_{r} \\ 
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}%
\right) =\frac{1}{\sqrt{2}}\left( 
\begin{array}{cc}
\mathbf{x}_{<}-i\mathbf{x}_{>} & \mathbf{x}_{<}+i\mathbf{x}_{>}%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{cc}
\mathfrak{s}^{\dagger }\left( \mathbf{\varphi }\right) & \mathfrak{s}\left( 
