j_{1}\leq 2r}}\overline{\xi }_{j_{1}}\xi
_{j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}+\frac{1}{6}\sum 
_{\substack{ 1\leq j_{2},j_{3},j_{4}\leq 2r  \\ 1\leq j_{1}\leq 2r}}\xi
_{j_{1}}\bar{\xi}_{j_{2}j_{3}j_{4}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{1}}
\end{align}%
\begin{equation}
\xi _{k_{1}\cdots k_{q}}=0\text{ if }k_{m}=k_{l}\text{ for any }1\leq m\neq
l\leq q
\end{equation}%
\begin{align}
