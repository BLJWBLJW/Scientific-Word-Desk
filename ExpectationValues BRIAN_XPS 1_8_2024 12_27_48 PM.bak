\begin{definition}
$f\in \mathcal{S}\left( \mathcal{A}\right) $ is a Fock state if 
\begin{equation}
\Phi _{f}\left( a_{j_{1}}\cdots a_{j_{n}}\right) =0,\quad 1\leq j_{1}<\cdots
<j_{n}\leq r,1\leq n\leq r,
\end{equation}%
\textbf{Equivalently }
\end{definition}

\begin{definition}
$f\in \mathcal{S}\left( \mathcal{A}\right) $ is a Fock state if 
\begin{equation}
\Phi _{f}\left( \left( \widetilde{x}_{j_{1}}+i\widetilde{x}_{j_{1}+r}\right)
\cdots \left( \widetilde{x}_{j_{n}}+i\widetilde{x}_{j_{n}+r}\right) \right)
=0,\quad 1\leq j_{1}<\cdots <j_{n}\leq r,1\leq n\leq r.
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
\prod\limits_{1\leq k\leq n}\left( \widetilde{x}_{j_{k}}+i\widetilde{x}%
_{r+j_{k}}\right) =\sum_{1\leq \sigma _{1},\cdots ,\sigma _{n}\leq
2}i^{\tsum\limits_{1\leq k\leq n}\epsilon \left( \sigma _{k}\right)
}\prod\limits_{1\leq k\leq n}\widetilde{x}_{\lambda \left( \sigma
_{k}\right) +j_{k}}
\end{equation}
\end{lemma}

\begin{example}
$n=2$
\end{example}

