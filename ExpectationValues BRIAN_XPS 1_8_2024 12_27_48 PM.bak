_{j_{1}j_{2}j_{3}j_{4}}\right) x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
& +\sum_{1\leq j_{1},j_{2}\leq 2r}\overline{\xi }_{j_{1}}\xi
_{j_{2}}x_{j_{1}}x_{j_{2}}+\frac{1}{4}\sum_{\substack{ 1\leq j_{1}\neq
j_{2}\leq 2r  \\ 1\leq j_{3}\neq j_{4}\leq 2r}}\overline{\xi }%
_{j_{1}j_{2}}\xi _{j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}} \\
