$p^{th}$ order reduced density operators associated with $N$-electron states
by
\begin{equation}
\left[  \gamma\right]  _{Np}=\left\{  \left.  D^{p}\right\vert D^{p}=\binom
{N}{p}L_{p}\left(  D^{N}\right)  ;\quad D^{N}\in\left[  \gamma\right]
_{N}\right\}  ,
\end{equation}
and general $p^{th}$ order reduced density operators that might be associated
with incoherent mixtures of states of different number of electrons and even
coherent mixtures of states associated with indeterminate numbers of
electrons
\begin{equation}
\left[  \gamma\right]  _{\left\langle N\right\rangle p}=\left\{  \left.
D^{p}\right\vert D^{p}=\binom{N}{p}L_{p}\left(  D\right)  ;\quad D\in\left[
\gamma\right]  _{\left\langle N\right\rangle }\right\}  .
\end{equation}


Even though the explicit form of the functional $\mathcal{F}_{HK}\left(
\gamma\right)  $ is not known one can define it implicitly \cite{LevyLieb}
\begin{equation}
\mathcal{F}_{HK}\left(  \gamma\right)  =\operatorname{Tr}\left\{
\overset{}{\left\{  KD_{\ast}^{1}\left(  \gamma\right)  +V_{2}D_{\ast}%
^{2}\left(  \gamma\right)  \right\}  }\right\}  =\min_{\substack{D^{2}%
\in\left[  \mathbf{\gamma}\right]  _{N2}\\D^{1}=\frac{2}{N-1}L_{2}^{1}\left(
D^{2}\right)  }}\operatorname{Tr}\left\{  \overset{}{\left\{  KD^{1}%
+V_{2}D^{2}\right\}  }\right\}  , \label{HK}%
\end{equation}
where the kinetic energy operator $K$ is
\begin{equation}
K=\int\left\langle \mathbf{r}^{\prime}\mathbf{,\xi}\left\vert \left(
-\frac{1}{2}\nabla_{\mathbf{r}}^{2}\right)  \mathbf{r,\xi}\right.
\right\rangle \left\vert \mathbf{r,\xi}\right\rangle \left\langle
\mathbf{r}^{\prime}\mathbf{,\xi}\right\vert d\mathbf{r}d\mathbf{r}^{\prime
}d\mathbf{\xi}%
\end{equation}
and the coulomb operator
\begin{equation}
V_{2}=\frac{1}{4}\int\frac{1}{\left\Vert \mathbf{r-r}^{\prime}\right\Vert
}\left\vert \mathbf{r,\mathbf{r}^{\prime},\xi,\xi}^{\prime}\right\rangle
\left\langle \mathbf{r,\mathbf{r}^{\prime},\xi,\xi}^{\prime}\right\vert
d\mathbf{r}d\mathbf{r}^{\prime}d\mathbf{\xi}d\mathbf{\xi}^{\prime}.
\end{equation}
which is contained in the set
\begin{equation}
\left[  \gamma\right]  _{\left\langle N\right\rangle }=\left\{  \left.
D\right\vert \Xi^{0}\left(  D\right)  =\gamma;D\in S\subset\mathcal{B}%
_{1}\left(  \mathcal{H}_{\mathcal{F}}\right)  \right\}  .
\end{equation}%
\begin{equation}
D^{1}=\frac{2}{N-1}L_{2}^{1}\left(  D^{2}\right)
\end{equation}%
\begin{equation}
K=\int\left\langle \mathbf{r}^{\prime}\mathbf{,\xi}\left\vert \left(
-\frac{1}{2}\nabla_{\mathbf{r}}^{2}\right)  \mathbf{r,\xi}\right.
\right\rangle \Phi\left(  \mathbf{r}^{\prime}\mathbf{,\xi}\right)  ^{\dagger
}\Phi\left(  \mathbf{r,\xi}\right)  d\mathbf{r}d\mathbf{r}^{\prime
}d\mathbf{\xi}%
\end{equation}%
\begin{equation}
V_{2}=\frac{1}{4}\int\frac{1}{\left\Vert \mathbf{r-r}^{\prime}\right\Vert
}\Phi\left(  \mathbf{r,\xi}\right)  ^{\dagger}\Phi\left(  \mathbf{r}^{\prime
}\mathbf{,\xi}^{\prime}\right)  ^{\dagger}\Phi\left(  \mathbf{r}^{\prime
}\mathbf{,\xi}^{\prime}\right)  \Phi\left(  \mathbf{r,\xi}\right)
d\mathbf{r}d\mathbf{r}^{\prime}d\mathbf{\xi}d\mathbf{\xi}^{\prime}.
\end{equation}
In the case of degeneracies there is not a unique $D_{\ast}^{N}\left(
\gamma\right)  $ but rather a convex set $D_{\ast}^{N}\left(  \gamma
,\mathbf{\alpha}\right)  $
\begin{equation}
D_{\ast}^{N}\left(  \gamma,\mathbf{\alpha}\right)  =\sum_{1\leq\lambda\leq
d_{\gamma}}\alpha_{\lambda}D_{\ast\lambda}^{N}\left(  \gamma\right)
\end{equation}
even if $D_{\ast}^{2}\left(  \gamma\right)  $ is unique $D_{\ast}^{N}\left(
\gamma\right)  $ may not be. One could choose
\begin{equation}
d\geq d_{\gamma}\forall\gamma
\end{equation}
and set
\begin{equation}
D_{\ast}^{N}\left(  \gamma,\mathbf{\alpha}\right)  =\sum_{1\leq\lambda\leq
d}\alpha_{\lambda}D_{\ast\lambda}^{N}\left(  \gamma\right)  .
\end{equation}
In the second optimization one finds minima of $\mathcal{E}_{O}\left(
\boldsymbol{\varphi}\left(  \boldsymbol{N}\right)  \boldsymbol{,}%
\mathrm{v}\right)  $ with respect to a constrained variation of the
normalization control parameters $\boldsymbol{N}$ for a fixed $N$. The
constraint on the control parameters can be expressed as
\begin{equation}
\sum_{1\leq j\leq r}N_{j}=N\sum_{1\leq j\leq r}\eta_{j}^{2}=N
\end{equation}
where
\begin{equation}
\boldsymbol{N}=N\left(  \eta_{1}^{2},\cdots,\eta_{r}^{2}\right)
\end{equation}
and $\boldsymbol{\eta}=\left(  \eta_{1},\cdots,\eta_{r}\right)  $ lie on the
unit hypersphere
\begin{equation}
\left\Vert \boldsymbol{\eta}\right\Vert ^{2}=\sum_{1\leq j\leq r}\eta_{j}%
^{2}=1.
\end{equation}
$\lceil$If we restrict attention to control parameters $\nu\left(
\boldsymbol{N}\right)  \geq N$ and $0\leq N_{j}\leq1,1\leq j\leq r$, i.e. that
can be interpretted as occupation numbers$\rfloor$ using\ $r$-dimensional
hyperspherical coordinates $\boldsymbol{\theta}$ one obtains $\boldsymbol{\eta
=\eta}\left(  \boldsymbol{\theta}\right)  ,$ where
\begin{align}
\eta_{1}\left(  \boldsymbol{\theta}\right)   &  =\cos\theta_{1}\nonumber\\
\eta_{2}\left(  \boldsymbol{\theta}\right)   &  =\sin\theta_{1}\cos\theta
_{2}\nonumber\\
\eta_{3}\left(  \boldsymbol{\theta}\right)   &  =\sin\theta_{1}\sin\theta
_{2}\cos\theta_{3}\nonumber\\
&  \vdots\nonumber\\
\eta_{r-1}\left(  \boldsymbol{\theta}\right)   &  =\sin\theta_{1}\cdots
\sin\theta_{r-2}\cos\theta_{r-1}\nonumber\\
\eta_{r}\left(  \boldsymbol{\theta}\right)   &  =\sin\theta_{1}\cdots
\sin\theta_{r-1}\sin\theta_{r}\nonumber\\
0  &  \leq\theta_{j}\leq\pi;\quad1\leq j\leq r
\end{align}
leading to%
\begin{align}
N_{1}\left(  \boldsymbol{\theta}\right)   &  =N\cos^{2}\theta_{1}\nonumber\\
N_{2}\left(  \boldsymbol{\theta}\right)   &  =N\sin^{2}\theta_{1}\cos
^{2}\theta_{2}\nonumber\\
N_{3}\left(  \boldsymbol{\theta}\right)   &  =N\sin^{2}\theta_{1}\sin
^{2}\theta_{2}\cos^{2}\theta_{3}\nonumber\\
&  \vdots\nonumber\\
N_{r-1}\left(  \boldsymbol{\theta}\right)   &  =N\sin^{2}\theta_{1}\cdots
\sin^{2}\theta_{r-2}\cos^{2}\theta_{r-1}\nonumber\\
N_{r}\left(  \boldsymbol{\theta}\right)   &  =N\sin^{2}\theta_{1}\cdots
\sin^{2}\theta_{r-1}\sin^{2}\theta_{r}\nonumber\\
0  &  \leq\theta_{j}\leq\pi;\quad1\leq j\leq r.
\end{align}
$\lceil$This allows points $\boldsymbol{N}=\left(  N,0,\cdots,0\right)  $.
What about $\boldsymbol{N}=\left(  1,1,1,0,\cdots,0\right)  $ for $N=3?:$%
\begin{align*}
\cos\theta_{1}  &  =\frac{1}{\sqrt{3}}\Rightarrow\sin\theta_{1}=\sqrt{\frac
{2}{3}}\\
\cos\theta_{2}  &  =\frac{1}{\sin\theta_{1}\sqrt{3}}=\frac{1}{\sqrt{2}}\\
\cos\theta_{3}  &  =1
\end{align*}%
\[
\boldsymbol{\theta}=\left(  \theta_{1},\theta_{2},\theta_{3},0,\cdots
,0\right)
\]
leading to an unconstrained optimization over $\boldsymbol{\theta}$.
Stationary points $\boldsymbol{\theta}_{\#}\left(  N\right)  $ are determined
by
\begin{equation}
\frac{\partial\mathcal{E}_{O}\left(  \boldsymbol{\varphi}\left(
\boldsymbol{\theta}_{\#}\left(  N\right)  \right)  \boldsymbol{,}%
\mathrm{v}\right)  }{\partial\theta_{k}}=\sum\limits_{1\leq j\leq r}%
\frac{\partial\mathcal{E}_{O}\left(  \boldsymbol{\varphi}\left(
\boldsymbol{N}\right)  \boldsymbol{,}\mathrm{v}\right)  }{\partial N_{j}}%
\frac{\partial N_{j}}{\partial\theta_{k}}=0;1\leq k\leq r. \label{ThetaDer}%
\end{equation}
Using eq. $\left(  \ref{ThetaDer}\right)  $ and observing that
\begin{equation}
\frac{\partial N_{j}}{\partial\theta_{k}}=\left\{
\begin{array}
[c]{c}%
N\sin^{2}\theta_{1}\cdots\sin2\theta_{k}\cdots\cos^{2}\theta_{j};1\leq k<j\\
-N\sin^{2}\theta_{1}\cdots\sin2\theta_{k}\cdots\cos^{2}\theta_{j};k=j\\
0;k>j
\end{array}
\right.
\end{equation}
and
\begin{equation}
\frac{\partial\mathcal{E}_{O}\left(  \boldsymbol{\varphi}\left(
\boldsymbol{N}\right)  \boldsymbol{,}\mathrm{v}\right)  }{\partial N_{j}%
}=\varepsilon_{jj}\boldsymbol{N}\left(  \boldsymbol{\theta}\right)
-\mu\left(  N\right)
\end{equation}
this can be developed to give
\begin{equation}
\frac{\partial\mathcal{E}_{O}\left(  \boldsymbol{\varphi}\left(
\boldsymbol{\theta}_{\#}\right)  \boldsymbol{,}\mathrm{v}\right)  }%
{\partial\theta_{k}}=\sum\limits_{1\leq j\leq r}\left\{  \varepsilon
_{jj}\left(  \boldsymbol{N}\left(  \boldsymbol{\theta}_{\#}\right)  \right)
-\mu\left(  N\right)  \right\}  \frac{\partial N_{j}}{\partial\theta_{k}}=0.
\label{theta}%
\end{equation}
i.e.
\begin{equation}
\sin2\theta_{\#k}=0\text{ } \label{Con1}%
\end{equation}
If $\sin2\theta_{\#k}=0$ ($N_{k}\left(  \boldsymbol{\theta}_{\#}\right)  =1$
or $0)$ then $\varepsilon_{kk}$ can equal anything (including $\alpha)$, while
if $\sin2\theta_{\#k}\neq0$ (which corresponds non integer occupation) then
$\varepsilon_{kk}=$ $\alpha$ i.e. the Lagrange parameters are degenerate. If
$\varepsilon_{kk}=$ $\alpha$ then $\sin2\theta_{\#k}$ does not have to be zero
though it can.

\bigskip

leading to
\begin{align}
&  \int_{\boldsymbol{\Delta}_{A}}f\left(  \boldsymbol{r}\right)
\operatorname{Tr}\left\{  YA\Phi\left(  \boldsymbol{r}\right)  ^{\dagger}%
\Phi\left(  \boldsymbol{r}\right)  \right\}  d\boldsymbol{r}=\nonumber\\
&  \sum_{1\leq j\leq r_{N}}\alpha_{j}\int_{\boldsymbol{\Delta}_{A}}f\left(
\boldsymbol{r}\right)  \left\langle \Psi_{j}\left\vert \Phi\left(
\boldsymbol{r}\right)  ^{\dagger}\Phi\left(  \boldsymbol{r}\right)  Y\Psi
_{j}\right.  \right\rangle d\boldsymbol{r}=0.
\end{align}%
\begin{equation}
\sum_{1\leq j\leq r_{N}}\alpha_{j}\int_{\boldsymbol{\Delta}_{A}}f\left(
\boldsymbol{r}\right)  \left\{  \left\langle \Psi_{k}\left\vert \Psi
_{j}\right.  \right\rangle \left\langle \Psi_{j}\left\vert \Phi\left(
\boldsymbol{r}\right)  ^{\dagger}\Phi\left(  \boldsymbol{r}\right)  \Psi
_{l}\right.  \right\rangle \right\}  d\boldsymbol{r}=0;\,1\leq k,l\leq
r_{N},\nonumber
\end{equation}
which gives

\bigskip Choosing
\begin{equation}
Y=\left\vert \Psi_{k}\right\rangle \left\langle \Psi_{l}\right\vert ;\,1\leq
k,l\leq r_{N}%
\end{equation}
one obtains that
\begin{equation}
\alpha_{k}\left\langle \Psi_{k}\left\vert \mathfrak{f}\Psi_{l}\right.
\right\rangle =0;\,1\leq k,l\leq r_{N}.\nonumber
\end{equation}%
\begin{align}
P_{\ker A^{\bot}}\mathfrak{f}P_{\ker A^{\bot}} &  =0\\
P_{\ker A^{\bot}}\mathfrak{f}P_{\ker A} &  =0\\
P_{\ker A}\mathfrak{f}P_{\ker A^{\bot}} &  =0\\
P_{\ker A}\mathfrak{f}P_{\ker A} &  =,
\end{align}
where%
\begin{align}
P_{\ker A} &  =\sum_{\substack{1\leq j\leq r_{N}\\\alpha_{j}=0}}\left\vert
\Psi_{j}\right\rangle \left\langle \Psi_{j}\right\vert \\
P_{\ker A^{\bot}} &  =\sum_{\substack{1\leq j\leq r_{N}\\\alpha_{j}\neq
0}}\left\vert \Psi_{j}\right\rangle \left\langle \Psi_{j}\right\vert
\end{align}
Thus either (i) $\alpha_{k}=0$ or (ii) $\left\langle \Psi_{k}\left\vert
\mathfrak{f}\Psi_{l}\right.  \right\rangle =0$ or (iii) both $\alpha_{k}=0$
and $\left\langle \Psi_{k}\left\vert \mathfrak{f}\Psi_{l}\right.
\right\rangle =0$ for each $k$ and all $l.$ As $A\neq0$ one can rule out
(iii). So either $\alpha_{k}=0$ or $\left\langle \Psi_{k}\mathfrak{f}%
\right\vert $ $=$ $0,$one only needs to consider when $\alpha_{k}\neq0$ then
$\left\langle \Psi_{k}\mathfrak{f}\right\vert $ $=$ $0$ . Thus $\mathfrak{f}$
is the zero operator (as $\alpha_{k}\neq0\,\forall k)$ hence
\begin{equation}
f\left(  \boldsymbol{r}\right)  \overset{a.e}{=}0.
\end{equation}


\section{Notes}%

\begin{align}
\left\langle \Psi_{1}\left\vert a_{1}^{\dagger}a_{1}\Psi_{1}\right.
\right\rangle  & =\alpha\\
\left\langle \Psi_{2}\left\vert a_{1}^{\dagger}a_{1}\Psi_{2}\right.
\right\rangle  & =\alpha
\end{align}%
\begin{equation}
\operatorname*{Tr}\left\{  a_{1}^{\dagger}a_{1}\left\vert \Psi_{2}%
\right\rangle \left\langle \Psi_{2}\right\vert \right\}  =\operatorname*{Tr}%
\left\{  a_{1}^{\dagger}a_{1}\left\vert \Psi_{1}\right\rangle \left\langle
\Psi_{1}\right\vert \right\}  =\alpha
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\left\vert \Psi_{2}%
\right\rangle \left\langle \Psi_{2}\right\vert \right\}  =\operatorname*{Tr}%
\left\{  a_{j}^{\dagger}a_{j}\left\vert \Psi_{1}\right\rangle \left\langle
\Psi_{1}\right\vert \right\}  =0,j>6
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\left\{  c_{2}\left\vert
\Psi_{2}\right\rangle \left\langle \Psi_{2}\right\vert +c_{1}\left\vert
\Psi_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right\}  \right\}
=0,j>6
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\left\vert \Psi_{2}%
\right\rangle \left\langle \Psi_{2}\right\vert \right\}  \neq
\operatorname*{Tr}\left\{  a_{j}^{\dagger}a_{j}\left\vert \Psi_{1}%
\right\rangle \left\langle \Psi_{1}\right\vert \right\}  \neq0;2\leq j\leq5
\end{equation}%
\begin{equation}
\operatorname*{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert \Psi
_{2}\right\rangle \left\langle \Psi_{2}\right\vert -\left\vert \Psi
_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)  \right\}  =0
\end{equation}
so trace class lc can give zero outside zero set.
\begin{equation}
\left(  \left\vert \Psi_{2}\right\rangle \left\langle \Psi_{2}\right\vert
-\left\vert \Psi_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)
=\left(  \left\vert \Psi_{2}\right\rangle \left\langle \Psi_{2}\right\vert
-\left\vert \Psi_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)
^{\dagger}%
\end{equation}%
\begin{align}
& \operatorname*{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert \Psi
_{2}\right\rangle \left\langle \Psi_{2}\right\vert -\left\vert \Psi
_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)  ^{2}\right\}  =\\
& \operatorname*{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert \Psi
_{2}\right\rangle \left\langle \Psi_{2}\right\vert -\left\vert \Psi
_{1}\right\rangle \left\langle \Psi_{2}\right\vert -\left\vert \Psi
_{2}\right\rangle \left\langle \Psi_{1}\right\vert +\left\vert \Psi
_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)  \right\}  \neq0
\end{align}%
\begin{align}
& \operatorname*{Tr}\left\{  a_{1}^{\dagger}a_{1}\left(  \left\vert \Psi
_{2}\right\rangle \left\langle \Psi_{2}\right\vert -\left\vert \Psi
_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)  \left(  \left\vert
\Psi_{2}\right\rangle \left\langle \Psi_{2}\right\vert -\left\vert \Psi
_{1}\right\rangle \left\langle \Psi_{1}\right\vert \right)  a_{1}^{\dagger
}a_{1}\right\}  =0\\
& \Leftrightarrow\left(  \left\vert \Psi_{2}\right\rangle \left\langle
\Psi_{2}\right\vert -\left\vert \Psi_{1}\right\rangle \left\langle \Psi
_{1}\right\vert \right)  a_{1}^{\dagger}a_{1}=0
\end{align}%
\begin{align}
a_{1}^{\dagger}a_{1}\left\vert \Psi_{1}\right\rangle \left\langle \Psi
_{1}\right\vert  & \neq\alpha\left\vert \Psi_{1}\right\rangle \left\langle
\Psi_{1}\right\vert \\
a_{1}^{\dagger}a_{1}\left\vert \Psi_{2}\right\rangle \left\langle \Psi
_{2}\right\vert  & \neq\alpha\left\vert \Psi_{2}\right\rangle \left\langle
\Psi_{2}\right\vert
\end{align}



