\right.  \\
&  \qquad\quad\quad+\left.  i\left(
\begin{array}
[c]{c}%
\overset{}{x_{j}x_{k}x_{l}x_{m+r}+x_{j}x_{k}x_{m}x_{l+r}+x_{j}x_{l}%
x_{m}x_{k+r}+x_{j}x_{k+r}x_{l+r}x_{m+r}}\\
+\overset{}{x_{k}x_{l}x_{m}x_{j+r}+x_{k}x_{j+r}x_{l+r}x_{m+r}+x_{l}%
x_{j+r}x_{k+r}x_{m+r}+x_{m}x_{j+r}x_{k+r}x_{l+r}}%
\end{array}
\right)  \right)
\end{align}
%

\begin{equation}
\parallel
\end{equation}%
\begin{align}
&  \frac{1}{16}\sum_{j\neq k\neq l\neq m}\left(
\begin{array}
[c]{c}%
O_{jklm}\overset{}{x_{j}x_{k}x_{l}x_{m}+O_{jklm}x_{j}x_{k}x_{l+r}%
x_{m+r}+O_{jlkm}x_{j}x_{k}x_{l+r}x_{m+r}+O_{jlmk}x_{j}x_{k}x_{l+r}x_{m+r}}\\
+\overset{}{O_{ljmk}x_{j}x_{k}x_{l+r}x_{m+r}+O_{ljkm}x_{j}x_{k}x_{l+r}%
x_{m+r}+O_{lmjl}x_{j}x_{k}x_{l+r}x_{m+r}+O_{jklm}x_{j+r}x_{k+r}x_{l+r}x_{m+r}}%
\end{array}
\right.  \\
&  \qquad\quad\quad+\left.  i\left(
\begin{array}
[c]{c}%
O_{jklm}\overset{}{x_{j}x_{k}x_{l}x_{m+r}+O_{jkml}x_{j}x_{k}x_{l}%
x_{m+r}+O_{jmkl}x_{j}x_{k}x_{l}x_{m+r}+O_{jklm}x_{j}x_{k+r}x_{l+r}x_{m+r}}\\
+\overset{}{O_{mjkl}x_{j}x_{k}x_{l}x_{m+r}+O_{kjlm}x_{j}x_{k+r}x_{l+r}%
x_{m+r}+O_{kljm}x_{j}x_{k+r}x_{l+r}x_{m+r}+O_{klmj}x_{j}x_{k+r}x_{l+r}x_{m+r}}%
\end{array}
\right)  \right)
\end{align}%
\begin{equation}
\parallel
\end{equation}%
\begin{align}
&  \frac{1}{16}\sum_{j\neq k\neq l\neq m}\left(  O_{jklm}x_{j}x_{k}x_{l}%
x_{m}+\left(  \overset{}{O_{jklm}+O_{jlkm}+O_{jlmk}+O_{ljmk}+O_{ljkm}%
+O_{lmjl}}\right)  x_{j}x_{k}x_{l+r}x_{m+r}+O_{jklm}x_{j+r}x_{k+r}%
x_{l+r}x_{m+r}\right.  \\
&  \qquad\quad\quad+\left.  i\left(  \overset{}{\left(  O_{jklm}%
+O_{jkml}+O_{jmkl}+O_{mjkl}\right)  x_{j}x_{k}x_{l}x_{m+r}+\left(
O_{jklm}+O_{kjlm}+O_{kljm}+O_{klmj}\right)  x_{j}x_{k+r}x_{l+r}x_{m+r}%
}\right)  \right)  .
\end{align}


\subsubsection*{Degree 0 (Constant Term)}%

\[
CI_{\mathcal{H}_{\mathcal{F}}}=\operatorname*{Tr}(\hat{O})I_{\mathcal{H}%
_{\mathcal{F}}}=\frac{1}{2^{r}}\operatorname*{Tr}(\hat{O})I_{\mathcal{H}%
_{\mathcal{F}}}=\frac{1}{8}\sum_{i,j}O_{ijji}I_{\mathcal{H}_{\mathcal{F}}}.
\]


\subsubsection*{Degree 2 (Quadratic Terms)}

After full antisymmetrization and index relabeling:
\begin{equation}
\hat{O}_{2}=\sum_{j<k}\alpha_{jk}x_{j}x_{k},
\end{equation}
where
\[
\alpha_{jk}=\frac{1}{4}\sum_{r,s}%
\begin{cases}
\;\,\operatorname*{Re}(O_{jrsk}-O_{jsrk}) & \text{if }j=2m-1,k=2n-1\\
\;\,\operatorname*{Re}(O_{jrsk}+O_{jsrk}) & \text{if }j=2m,k=2n\\
-i\operatorname*{Im}(O_{jrsk}-O_{jsrk}) & \text{if }j=2m-1,k=2n\\
+i\operatorname*{Im}(O_{jrsk}+O_{jsrk}) & \text{if }j=2m,k=2n-1
\end{cases}
.
\]


\subsubsection*{Degree 4 (Quartic Terms)}

Fully uncontracted products of four Majorana operators:
\[
\hat{O}_{4}=\sum_{i<j<k<l}\beta_{ijkl}\,x_{i}x_{j}x_{k}x_{l},
\]
where the coefficients $\beta_{ijkl}$ are given by the fully antisymmetrized
expression becomes:
\[
\beta_{ijkl}=\frac{1}{16}\sum_{\substack{\sigma\in S_{4}\\\text{distinct
}i,j,k,l}}\text{sgn}(\sigma)\tilde{O}_{\sigma(p)\sigma(q)\sigma(r)\sigma(s)},
\]
where $\tilde{O}_{pqrs}$ maps fermionic indices to Majorana indices:
\[
\tilde{O}_{pqrs}=%
\begin{cases}
\;\,O_{pqrs} & \text{even }x\text{-parity}\\
-iO_{pqrs} & \text{odd }x\text{-parity}%
\end{cases}
\]
The quartic coefficient $\beta_{ijkl}$ in the Majorana expansion is given by
the fully antisymmetrized combination:%

\[
\beta_{ijkl}=\frac{1}{16}\sum_{\sigma\in S_{4}}\text{sgn}(\sigma)\tilde
{O}_{\sigma(p)\sigma(q)\sigma(r)\sigma(s)}%
\]


where:

\begin{itemize}
\item $S_{4}$ is the symmetric group of all permutations of 4 elements

\item $\text{sgn}(\sigma)$ is the sign of the permutation ($+1$ for even, $-1$
for odd)

\item The indices $(i,j,k,l)$ correspond to the Majorana operator ordering

\item $(p,q,r,s)$ are the original fermionic mode indices mapped to
$(2p-1,2p,2q-1,2q)$.
\end{itemize}

This represents the sum over all 24 possible permutations of the four indices
with appropriate sign factors.

\subsection*{4. Final Majorana Expansion}

\begin{remark}
The expansion of two particle operators in terms of the corresponding Majorana
operators can organized into homogeneous terms of zeroth, second and fourth
degree, but these terms are \textbf{not} linearly independent.
\end{remark}

Combining all terms, the operator $\hat{O}$ becomes:
\[
\hat{O} = \sum_{i < j} \alpha_{ij} \, x_{i} x_{j} + \sum_{i < j < k < l}
\beta_{ijkl} \, x_{i} x_{j} x_{k} x_{l}.
\]


\subsection*{5. Key Observations}

\begin{itemize}
\item Quadratic terms ($\alpha_{ij}$) depend on off-diagonal elements of
$O_{ijkl}$.

\item Quartic terms ($\beta_{ijkl}$) are fully antisymmetrized four-Majorana
interactions.Consistency Checks
\end{itemize}

\begin{enumerate}
\item \textbf{Antisymmetry Preservation}: All coefficients satisfy:
\[
\alpha_{pq} = -\alpha_{qp}, \quad\beta_{ijkl} = \text{totally antisymmetric}.
\]


\item \textbf{Trace Conditions}:
\[
\text{Tr}(x_{i}x_{j}) = 0, \quad\text{Tr}(x_{i}x_{j}x_{k}x_{l}) = 0
\quad\Rightarrow\quad\text{Tr}(\hat{O}) = 2^{N} C.
\]


\item \textbf{Example: Hubbard Interaction}: For $U\sum_{i}n_{i\uparrow
}n_{i\downarrow}$:
\[
C=\frac{UN}{8},\quad\alpha_{2i-1,2i}=\frac{U}{4},\quad\text{other }%
\alpha,\beta=0.
\]

\end{enumerate}


