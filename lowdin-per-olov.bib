  title = {Research on cohesive properties of solids in the {Uppsala} quantum
          chemistry group},
  journal = {4th Nordic solid state conference (abstracts)},
  volume = {},
  number = {},
  pages = 17,
  abstract = {Abstract only given substantially as follows. The following are
             presented: Study of the correlation energy in alkali metals: The
             alternant molecular orbital method is used in a set of
             exploratory calculations of the cohesive energy of the lithium
             metal. The occupation of the AMO's --- the shape of the `Fermi
             surface' --- is discussed, in particular with respect to its
             influence on the density and the cohesive energy. The internal
             pressure in alkali halides: The concept of internal pressure is
             treated with reference to existing theoretical models and
             calculations. A generalization of Borelius' equation of state is
             proposed. Cohesive energies and elastic constants of the silver
             halides: These are calculated from free ion Hartree-Fock orbitals
             by means of L{\"o}wdin's method. Construction of an orthonormal
             basis set suitable for crystals: A combination of various types
             of orthogonalization procedures is used to construct an
             orthonormal set of LCAO functions},
  bibdate = {Sat Dec 16 10:40:43 2000},
  bibsource = {IEEE INSPEC database (1968--2000)}
}
