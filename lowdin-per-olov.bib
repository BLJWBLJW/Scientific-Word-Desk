@ARTICLE{Lowdin:1982:PTP,
  author = {Per-Olov L{\"o}wdin},
  month = {????},
  year = 1982,
  title = {Partitioning Technique, Perturbation Theory, and Rational
          Approximations},
  journal = j-IJQC,
  volume = 21,
  number = 1,
  pages = {69--92},
  abstract = {Instead of the Schr{\"o}dinger equation $H \Psi =E \Psi$ subject
             to the boundary condition $( \phi \bmod \Psi )=1$, where $\phi$
             is a normalized reference function in the Hilbert space, one
             studies the inhomogeneous equation $(H-E) \Psi_E=a \phi$, where
             $E$ is a complex variable, with the same boundary condition,
             which gives $a=( \phi \bmod H \bmod \Psi_E)-E=E_1-E$. Introducing
             the projector $P=1- \bmod \phi )( \phi \bmod$ for the complement
             to $O= \bmod \phi )( \phi \bmod$, one finds easily the explicit
             solution $\Psi_E=(1-PH/E)^{-1} \phi =(1+T_EH) \phi$, where
             $T_E=(E-PH)^{-1}P=P(E-PHP)^{-1}P$ is the reduced resolvent
             associated with the auxiliary Hamiltonian $H=PHP$. The existence
             of these operators is discussed. It is shown that, if the
             parameter $E$ is real in the `discrete part' of the spectrum to
             $H$, then $E$ and $E_1=(\phi \bmod H \bmod \Psi_E)=(
             \phi \bmod H+HT_E/H \bmod \Phi)$ identical to $f(E)$ bracket a
             true eigenvalue $E$ satisfying the relation $E=f(E)$. The
             Newton-Raphson solution to the equation $F(E)=E-f(E)=0$ is
             related to the variation principle. Putting $H=H_0+V$ and
             expanding the inverse $(E-PH_0-PV)^{-1}$ in terms of powers of
             $V$ or $(V-\alpha)$, one gets various expansion relating to
             finite-order perturbation theory. Exact expressions for the
             ordinary wave and reaction operators are obtained},
  coden = {IJQCB2},
  issn = {0020-7608 (print), 1097-461X (electronic)},
  bibdate = {Sat Dec 16 10:40:43 2000},
