@ARTICLE{Lowdin:1991:ITF,
  author = {Per-Olov L{\"o}wdin},
  month = may,
  year = 1991,
  title = {On the Importance of Theory in the Future Development of Chemistry},
  journal = j-J-MOL-STRUCT,
  volume = 230,
  pages = {1--3},
  note = {Also as Theochem, vol. 76. Proceedings of the 2nd World Condensed of
         Theoretical Organic Chemistry (WATOC), July 9--14, 1990, University
         of Toronto, Toronto, Ontario, Canada.},
  annote = {This volume is complete in a single issue, so no issue number is
           assigned. Theochem volumes appear irregularly co-titled as Journal
           of Molecular Structure volumes, sigh\ldots{}.},
  abstract = {Quantum chemistry deals particularly with the electronic
             structure of atoms, molecules, and condensed matter, and
             describes it in terms of electronic-wave patterns of standing
             waves. It deals also with collisions between atoms and molecules
             and with the study of chemical reactivity. In the very beginning
             it was considered as a rather sophisticated subject which
             required a great deal of higher mathematics and group theory, and
             for some time the new field could boast more of its conceptual
             framework than of its numerical accomplishments. With the
             development of modern electronic computers, this situation has
             changed, and-with the parallel development in such fields as, for
             instance, crystallography-chemists in general have become much
             more accustomed to the use of high-brow mathematics and
             large-scale computations. Today many chemists undertake both
             experimental and theoretical work, and many computational
             programs based on quantum theory are now used both to interpret
             the experimental results obtained and to predict new ones. Theory
             has hence become a powerful tool in many chemical laboratories as
             well as in the chemical and pharmaceutical industry},
  coden = {JMOSB4},
  issn = {0022-2860},
  bibdate = {Mon Dec 18 11:01:52 2000},
  bibsource = {http://falcon.kvac.uu.se/swe/personal/PerOlovLowdinPub.html;
