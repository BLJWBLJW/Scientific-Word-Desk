@ARTICLE{Lowdin:1989:SPB,
  author = {Per-Olov L{\"o}wdin and Piotr Froelich and Manoj Mishra},
  month = aug,
  year = 1989,
  title = {Some Properties of the Bivariational {Hartree-Fock} Scheme for
          Complex Symmetric Many-particle Operators},
  journal = j-IJQC,
  volume = 36,
  number = 2,
  pages = {93--103},
  abstract = {The bivariational Hartree-Fock scheme for a general many-body
             operator $T$ is discussed with particular reference to the
             complex symmetric case: $T^{\dagger }=T*$. It is shown that, even
             in the case when the complex symmetric operator $T$ is real and
             hence also self-adjoint, the complex symmetric Hartree-Fock
             scheme does not reduce to the conventional real form, unless one
             introduces the constraint that the $N$-dimensional space spanned
             by the Hartree-Fock functions \Psi should be stable under complex
             conjugation, so that $\Psi* = \Psi \alpha$. If one omits this
             constraint, one gets a complex symmetric formulation of the
             Hartree-Fock scheme for a real $N$-electron Hamiltonian having
             the properties $H=H*=H^{\dagger}$, in which the effective
             Hamiltonian $H_{\hbox{eff}}(1)$ may have complex eigenvalues
             $\epsilon_k$. By using the method of complex scaling, it is
             indicated that these complex eigenvalues-at least for certain
             systems-may be related to the existence of so-called physical
             resonance states, and a simple example is given. Full details
             will be given elsewhere},
  coden = {IJQCB2},
  issn = {0020-7608 (print), 1097-461X (electronic)},
  bibdate = {Sat Dec 16 10:40:43 2000},
  bibsource = {http://falcon.kvac.uu.se/swe/personal/PerOlovLowdinPub.html;
              IEEE INSPEC database (1968--2000); Science Citation Index
              database (1980--2000)},
  acknowledgement = ack-nhfb,
  journalabr = {Int J Quantum Chem}
}
