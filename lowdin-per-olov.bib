@ARTICLE{Lowdin:1983:SPP,
  author = {Per-Olov L{\"o}wdin},
  month = jan,
  year = 1983,
  title = {On the Stability Problem of a Pair of Adjoint Operators},
  journal = j-J-MATH-PHYS,
  volume = 24,
  number = 1,
  pages = {70--87},
  abstract = {As an introduction, the eigenvalue problem for a linear operator
             $T$ having a discrete point spectrum and a complete set of
             eigenfunctions is studied. The bivariational principle for $T$
             and its adjoint operator $T^{\dag}$ is derived, and the
             biorthogonal properties of their eigenfunctions are discussed.
             The main part of the paper is then concerned with the problem
             whether these features can be extended also to a general pair of
             adjoint operators, $T$ and $T^{\dag}$, in which case the
             eigenvalue problem is replaced by the more general stability
             problem. The stability problem for a pair of adjoint operators
             --- $T$ and $T^{\dag}$ --- is first formulated in terms of
             nonorthogonal projectors $\phi$ and $\phi^{\dag}$ --- which
             decompose these operators and satisfy the commutation relations
             $T\phi =\phi T$ and $T^{\dag}\phi^{\dag}=\phi^{\dag}T^{\dag}$. In
             the case of finite space, these skew-projectors may be explicitly
             expressed in product forms derived from the reduced
             Cayley-Hamilton equation for the operator $T$. It is shown that,
             if the stable subspaces defined by these projectors are properly
             classified by their Segre characteristics, one may explicitly
             derive the form of the projectors for the irreducible stable
             subspaces associated with the individual Jordan blocks of the
             so-called classical canonical forms of the matrix representations
             of $T$ and $T^{\dag}$. It is further shown that, in such a case,
             the biorthonormality property of the generalized eigenfunctions
             is still valid, and that a bivariational principle may be
             derived. The extension of these results to infinite spaces is
             finally briefly discussed.},
  coden = {JMAPAQ},
  issn = {0022-2488},
  bibdate = {Sat Dec 16 10:40:43 2000},
  bibsource = {ftp://ftp.math.utah.edu/pub/tex/bib/jmathphys1980.bib;
              http://falcon.kvac.uu.se/swe/personal/PerOlovLowdinPub.html;
              IEEE INSPEC database (1968--2000); MathSciNet database; Science
              Citation Index database (1980--2000); Zentralblatt Math database},
  acknowledgement = ack-nhfb,
  mrclass = {47A70 (47A10 49G20 81C12 81H10)},
  mrnumber = {85b:47020a},
  mrreviewer = {I. Gottlieb},
  journalabr = {J Math Phys Ny},
  zmnumber = {541.47015},
  zmreviewer = {Ch. Swartz}
}
