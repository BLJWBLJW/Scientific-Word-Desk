@ARTICLE{Lowdin:1972:SCT,
  author = {P.-O. L{\"o}wdin and P. K. Mukherjee},
  year = 1972,
  title = {Some Comments on the Time-Dependent Variation Principle},
  journal = j-CHEM-PHYS-LETT,
  volume = 14,
  number = 1,
  pages = {1--7},
  abstract = {The time-dependent variation principle due to Frenkel is
             discussed from a new standpoint based on the assumption that the
             norm of the variational function Phi exists. By studying the
             expectation value of the frequency operator $j=i \delta /
             \delta t$, one may introduce the conventional normalization and a
             `phase normalization' through a special gauge transformation
             leading to the result $J=(H-j)=0$. It is shown that the condition
             $\delta J=0$ leads to Frenkel's variation principle, which is
             further discussed by studying the error function $\Theta =(H-i
             delta / delta t) Phi$.},
  coden = {CHPLBC},
  issn = {0009-2614},
