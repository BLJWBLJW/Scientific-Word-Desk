@ARTICLE{Lowdin:1989:SRP,
  author = {Per-Olov L{\"o}wdin and Bengt Nagel},
  month = {Spring},
  year = 1989,
  title = {Some Remarks on the Perturbation and Variation Perturbation
          Calculations of the Free Energy for Quantum Systems},
  journal = j-IJQC,
  volume = 35,
  number = 6,
  pages = {839--850},
  note = {Ivar Waller issue.},
  abstract = {A generalization of the Gibbs-Bogoliubov inequality
             $F\leq F_0+(H-H_0)_0$ for the free energy $F$ is studied which
             leads to a variation principle for this quantity that may be of
             importance in certain computational applications to quantum
             systems. This approach is coupled with a study of the
             perturbation expansion of the free energy for a canonical
             ensemble with $H_0+ lambda V$ in the general case when $H_0$ and
             $V$ do not commute. The second- and high-order derivatives of the
             free energy with respect to the perturbation parameter lambda are
             calculated. From the second-order term is finally obtained a
             second-order correction to the previous variational minimum for
             the free energy},
  coden = {IJQCB2},
