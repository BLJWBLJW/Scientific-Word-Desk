  abstract = {Every Slater determinant $D$ may be uniquely analyzed in terms
             of spin components $D_l=O_lD$ which are pure spin eigenfunctions,
             so that $S^2D_l=l(l+1)D$. Every component $Dl=O_lD$ may in turn
             be written as a sum of symmetric combinations of Slater
             determinants, $T_k=( \alpha^{\mu - \kappa} \beta^k
             \bmod \alpha^\kappa \beta^{\nu - \kappa})$, and the coefficients
             $c_k^{(l)}$ in the expansion $O_lD=
             \Sigma_{\kappa }c_{\kappa }^{(l)}T_{\kappa }$ are known as the
             `Sanibel coefficients.' By using the relation $S^2D_{
             l}=l(l+1)D$, a recursion formula for the coefficient $c_k^{(kl)}$
             is derived, which is then explicitly solved in the special case
             when $S_z$ has the pure quantum number $m=0$.},
  coden = {IJQCB2},
  issn = {0020-7608 (print), 1097-461X (electronic)},
