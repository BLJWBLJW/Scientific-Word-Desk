@ARTICLE{Lowdin:1986:RAW,
  author = {Per-Olov L{\"o}wdin},
  year = 1986,
  title = {Remarks about the wave-function representability of the first-order
          reduced density matrices},
  journal = j-IJQC-QC-SYMP,
  volume = 20,
  pages = {769--771},
  abstract = {It is pointed out that, if $(\Gamma_{\gamma})$ is the set of
