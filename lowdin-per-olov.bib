              http://www3.interscience.wiley.com/journalfinder.html; IEEE
              INSPEC database (1968--2000); Science Citation Index database
              (1980--2000)},
  acknowledgement = ack-nhfb,
  url = {http://www3.interscience.wiley.com/cgi-bin/abstract?ID=60513},
  journalabr = {Int J Quantum Chem}
}
