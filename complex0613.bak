\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right\vert \right\} \\
&  \leftrightarrow\left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
-1 & 2
\end{array}
\right)  +\left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
4 & -7
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)
\end{align}%
\begin{align}
\left\{  \left\vert f_{1}^{d}\right)  \left(  f_{1}\right\vert +\left\vert
f_{2}^{d}\right)  \left(  f_{2}\right\vert \right\}   &  =\left\{  \left\vert
\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert \right\} \\
&  \leftrightarrow\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
7 & 4
\end{array}
\right)  +\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 1
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
1 & 0\\
0 & 1
\end{array}
\right)
\end{align}
$\rfloor$

These bases
\begin{equation}
f_{1}^{d}=\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  ,f_{2}^{d}=\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  ;f_{1}=\left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  ^{\prime}f_{2}=\left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)
\end{equation}
allows one to form the complexification
\begin{align}
tJ_{e}t^{t}  &  =\left\vert te_{1}\right)  \left(  te_{2}\right\vert
-\left\vert te_{2}\right)  \left(  te_{1}\right\vert =\left\vert f_{2}\right)
\left(  f_{1}\right\vert -\left\vert f_{1}\right)  \left(  f_{2}\right\vert
=J_{f}\\
&  =\left\vert \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert -\left\vert \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert
\end{align}%
\begin{align}
J_{e}f_{1}^{d}  &  =f_{2}\\
-J_{e}f_{2}^{d}  &  =f_{1}%
\end{align}%
\begin{equation}
J_{f}=\left\vert f_{2}\right)  \left(  f_{1}\right\vert -\left\vert
f_{1}\right)  \left(  f_{2}\right\vert =\left\vert J_{e}f_{1}^{d}\right)
\left(  f_{2}\right\vert +\left\vert J_{e}f_{2}^{d}\right)  \left(
f_{1}\right\vert =J_{e}\left(  \left\vert f_{1}^{d}\right)  \left(
f_{2}\right\vert +\left\vert f_{2}^{d}\right)  \left(  f_{1}\right\vert
\right)
\end{equation}%
\begin{align}
&  \left(  \left\vert f_{1}^{d}\right)  \left(  f_{2}\right\vert -\left\vert
f_{2}^{d}\right)  \left(  f_{1}\right\vert \right)  \left(  \left\vert
f_{1}^{d}\right)  \left(  f_{2}\right\vert -\left\vert f_{2}^{d}\right)
\left(  f_{1}\right\vert \right)  =\left\vert f_{1}^{d}\right)  \left(
f_{2}\right\vert \left\vert f_{1}^{d}\right)  \left(  f_{2}\right\vert
-\left\vert f_{1}^{d}\right)  \left(  f_{2}\right\vert \left\vert f_{2}%
^{d}\right)  \left(  f_{1}\right\vert -\left\vert f_{2}^{d}\right)  \left(
f_{1}\right\vert \left\vert f_{1}^{d}\right)  \left(  f_{2}\right\vert
+\left\vert f_{2}^{d}\right)  \left(  f_{1}\right\vert \left\vert f_{2}%
^{d}\right)  \left(  f_{1}\right\vert \\
&  =-\left\vert f_{1}^{d}\right)  \left(  f_{1}\right\vert -\left\vert
f_{2}^{d}\right)  \left(  f_{2}\right\vert =-\left(  \left\vert f_{1}%
^{d}\right)  \left(  f_{1}\right\vert +\left\vert f_{2}^{d}\right)  \left(
f_{2}\right\vert \right)  =-I_{2}%
\end{align}%
\begin{equation}
\left(  \left\vert f_{1}^{d}\right)  \left(  f_{2}\right\vert -\left\vert
f_{2}^{d}\right)  \left(  f_{1}\right\vert \right)  ^{t}=\left\vert
f_{2}\right)  \left(  f_{1}^{d}\right\vert -\left\vert f_{1}\right)  \left(
f_{2}^{d}\right\vert \neq-\left(  \left\vert f_{1}^{d}\right)  \left(
f_{2}\right\vert -\left\vert f_{2}^{d}\right)  \left(  f_{1}\right\vert
\right)
\end{equation}
$\lceil$%
\begin{align}
&  \left\vert f_{1}^{d}\right)  \left(  f_{2}\right\vert -\left\vert f_{2}%
^{d}\right)  \left(  f_{1}\right\vert =\left\vert \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert -\left\vert \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert \\
&  \leftrightarrow\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
2 & 1
\end{array}
\right)  -\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
7 & 4
\end{array}
\right) \\
&  \left(  \left\vert \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert -\left\vert \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert \right)  \left(  \left\vert \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert -\left\vert \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert \right) \\
&  =-\left(  \left\vert \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert +\left\vert \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert \right)
\end{align}
$\rfloor$

The basis
\begin{equation}
\left\{  f_{1}^{d}=\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  ,f_{2}^{d}=\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right\}  ,\left\{  f_{1}=\left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  ,f_{2}=\left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\}
\end{equation}
of $\mathbb{R}^{2}$ could be used to form the direct sum
\begin{equation}
\mathcal{V}=V_{1}\oplus V_{2}=\mathbb{R}^{2}\oplus\mathbb{R}^{2}=V_{1}\oplus
V_{1}^{d}=\mathcal{V}_{1}+\mathcal{V}_{1}^{d}\cong\mathbb{R}^{4},
\end{equation}
but it is more interesting to consider them as two non orthogonal and
unnormalized basis of $V,$ that are biorthogonal to each other, where
\begin{align}
V  &  =\mathbb{R}-\operatorname*{linspan}\left\{  f_{1}^{d},f_{2}^{d}\right\}
=\mathbb{R}-\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right\}  =V_{1}\\
&  =\mathbb{R}-\operatorname*{linspan}\left\{  f_{1},f_{2}\right\}
=\mathbb{R}-\operatorname*{linspan}\left\{  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  ,\left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\}  =V_{2}=V_{1}^{d}.
\end{align}
Of course
\begin{equation}
V=V_{1}=V_{2}=V_{1}^{d}\cong\mathbb{R}^{2}.
\end{equation}
One can consider the complexification
\begin{equation}
J_{V_{1}}=\left\vert f_{1}\right)  \left(  f_{2}^{d}\right\vert -\left\vert
f_{2}\right)  \left(  f_{1}^{d}\right\vert
\end{equation}
that satisfies the two complexifiction conditions
\begin{equation}
\left(  \left\vert f_{1}\right)  \left(  f_{2}^{d}\right\vert -\left\vert
f_{2}\right)  \left(  f_{1}^{d}\right\vert \right)  \left(  \left\vert
f_{1}\right)  \left(  f_{2}^{d}\right\vert -\left\vert f_{2}\right)  \left(
f_{1}^{d}\right\vert \right)  =-\left\vert f_{1}\right)  \left(  f_{1}%
^{d}\right\vert -\left\vert f_{2}\right)  \left(  f_{2}^{d}\right\vert
=-I_{2r}%
\end{equation}
and%
\begin{equation}
\left\{  f_{1}^{d}=\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  ,f_{2}^{d}=\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right\}  ,\left\{  f_{1}=\left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  ,f_{2}=\left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\}
\end{equation}
\begin{align}
J_{V_{1}}  &  \in\mathcal{L}\left(  V_{1}\right)  ,\mathcal{L}\left(
V_{1},V_{1}^{d}\right) \\
J_{V_{1}}^{t}  &  \in\mathcal{L}\left(  V_{1}\right)  ,\mathcal{L}\left(
V_{1}^{d},V_{1}\right)  .
\end{align}
The transpose gives
\begin{equation}
\left(  \left\vert f_{1}\right)  \left(  f_{2}^{d}\right\vert -\left\vert
f_{2}\right)  \left(  f_{1}^{d}\right\vert \right)  ^{t}=\left\vert f_{2}%
^{d}\right)  \left(  f_{1}\right\vert -\left\vert f_{1}^{d}\right)  \left(
f_{2}\right\vert =-\left(  \left\vert f_{1}\right)  \left(  f_{2}%
^{d}\right\vert -\left\vert f_{2}\right)  \left(  f_{1}^{d}\right\vert
\right)  .
\end{equation}
$\lceil$%
\begin{equation}
\left(  \left\vert \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right\vert -\left\vert \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right\vert \right)  ^{t}=\left\vert \left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  \right\vert -\left\vert \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right\vert
\end{equation}
$\rfloor$

The complexification of $V$ to give $V_{\mathbb{C}},$given by $J_{V_{1}}$
(i.e. based on $V_{1})$ is based on
\begin{equation}
V_{1}^{d}=J_{V_{1}}V_{1}%
\end{equation}


e.g.
\begin{align}
f_{1}^{d}  &  =\left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  =-\left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  =-J_{V_{1}}f_{2}=-J_{V_{1}}te_{2}\\
f_{2}^{d}  &  =\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  =J_{V_{1}}f_{1}=J_{V_{1}}te_{1}%
\end{align}%
\begin{align}
f_{2}  &  =te_{2}=-J_{V_{1}}f_{1}^{d}=-\left(
\begin{array}
[c]{cc}%
0 & 1\\
-1 & 0
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right) \\
f_{1}  &  =te_{1}=-J_{V_{1}}f_{2}^{d}=\left(
\begin{array}
[c]{c}%
4\\
-7
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
7\\
4
\end{array}
\right)  .
\end{align}
The complexification is explicitly given by
\begin{equation}
V_{\mathbb{C}}\cong V_{1}+J_{V_{1}}V_{1}%
\end{equation}
that corresponds to $V_{1}$ and $J_{V_{1}}V_{1}$ being disjoint spaces and
\begin{equation}
V_{\mathbb{C}}=V_{1}\oplus J_{V_{1}}V_{1}%
\end{equation}
and making identiifications using the natural isomorphisms. $V_{1}$ and
$J_{V_{1}}V_{1}$ are \emph{always disjoint subspaces }by construction and
definition although they are isomorphic.

\paragraph{Summary}

We consider the complexification
\begin{align}
J_{f}  &  =\left\vert \left(
\begin{array}
[c]{c}%
2\\
1
\end{array}
\right)  \right)  \left(  \left(
