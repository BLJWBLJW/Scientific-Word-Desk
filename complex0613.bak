[c]{c}%
2\\
1
\end{array}
\right)  \right\vert \right)  =-I_{2}%
\end{align}%
\begin{align}
&  \left(  \left\vert \left(
\begin{array}
[c]{c}%
-1\\
2
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
