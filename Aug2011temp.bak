\begin{align}
& \left(  \sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda
_{1jkl}\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi
_{k}\right\vert +\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}%
}\lambda_{jk1l}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{l}\right\vert +\sum_{2\leq j,k\leq r}\lambda_{1j1k}\left\vert
\psi_{1}\psi_{j}\right\rangle \left\langle \psi_{1}\psi_{k}\right\vert
\right)  \\
& \left(  \sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda
_{1jkl}\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi
_{k}\right\vert +\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}%
}\lambda_{jk1l}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{l}\right\vert +\sum_{2\leq j,k\leq r}\lambda_{1j1k}\left\vert
\psi_{1}\psi_{j}\right\rangle \left\langle \psi_{1}\psi_{k}\right\vert
\right)
\end{align}
aa%
\begin{equation}
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{1ljk}\left\vert
\psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{1ljk}\left\vert
\psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert =0
\end{equation}
ab%
\begin{equation}
\sum_{\substack{2\leq j<k\leq r\\2\leq l,m\leq r}}\lambda_{1ljk}%
\lambda_{jk1l^{\prime}}\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle
\psi_{1}\psi_{m}\right\vert
\end{equation}
ac%
\begin{equation}
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{1ljk}\left\vert
\psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
\sum_{2\leq j,k\leq r}\lambda_{1j1k}\left\vert \psi_{1}\psi_{j}\right\rangle
\left\langle \psi_{1}\psi_{k}\right\vert =0
\end{equation}
ba%
\begin{equation}
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{jk1l}\left\vert
\psi_{j}\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{l}\right\vert
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{1ljk}\left\vert
\psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi_{k}\right\vert
=\sum_{\substack{2\leq j<k\leq r\\2\leq m<n\leq r}}\lambda_{jk1l}%
\lambda_{1lmn}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{m}\psi_{n}\right\vert
\end{equation}
bb%
\begin{equation}
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{jk1l}\left\vert
\psi_{j}\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{l}\right\vert
\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{jk1l}\left\vert
\psi_{j}\psi_{k}\right\rangle \left\langle \psi_{1}\psi_{l}\right\vert =0
\end{equation}
bc%
\begin{equation}
\sum_{\substack{2\leq j<k\leq r\\2\leq l,m\leq r}}\lambda_{jk1l}\lambda
_{1l1m}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi_{1}\psi
_{m}\right\vert
\end{equation}
ca%
\begin{equation}
\sum_{2\leq j,k\leq r}\lambda_{1j1k}\left\vert \psi_{1}\psi_{j}\right\rangle
\left\langle \psi_{1}\psi_{k}\right\vert \sum_{\substack{2\leq j<k\leq
r\\2\leq l\leq r}}\lambda_{1ljk}\left\vert \psi_{1}\psi_{l}\right\rangle
\left\langle \psi_{j}\psi_{k}\right\vert =\sum_{\substack{2\leq j,l\leq
r\\2\leq m<n\leq r}}\lambda_{1j1l}\lambda_{1lmn}\left\vert \psi_{1}\psi
_{j}\right\rangle \left\langle \psi_{m}\psi_{n}\right\vert
\end{equation}
cb%
\begin{equation}
\sum_{2\leq j,k\leq r}\lambda_{1j1k}\left\vert \psi_{1}\psi_{j}\right\rangle
\left\langle \psi_{1}\psi_{k}\right\vert \sum_{\substack{2\leq j<k\leq
r\\2\leq l\leq r}}\lambda_{jk1l}\left\vert \psi_{j}\psi_{k}\right\rangle
\left\langle \psi_{1}\psi_{l}\right\vert =0
\end{equation}
cc%
\begin{equation}
\sum_{2\leq j,k\leq r}\lambda_{1j1k}^{2}\left\vert \psi_{1}\psi_{j}%
\right\rangle \left\langle \psi_{1}\psi_{l}\right\vert
\end{equation}%
\begin{align}
& \sum_{\substack{2\leq j<k\leq r\\2\leq m<n\leq r\\2\leq l\leq r}%
}\lambda_{jk1l}\lambda_{1lmn}\left\vert \psi_{j}\psi_{k}\right\rangle
\left\langle \psi_{m}\psi_{n}\right\vert +\sum_{\substack{2\leq j<k\leq
r\\2\leq l,m\leq r}}\lambda_{jk1l}\lambda_{1l1m}\left\vert \psi_{j}\psi
_{k}\right\rangle \left\langle \psi_{1}\psi_{m}\right\vert \\
& +\sum_{\substack{2\leq j,l\leq r\\2\leq m<n\leq r}}\lambda_{1j1l}%
\lambda_{1lmn}\left\vert \psi_{1}\psi_{j}\right\rangle \left\langle \psi
_{m}\psi_{n}\right\vert +\sum_{2\leq j,k\leq r}\lambda_{1j1m}^{2}\left\vert
\psi_{1}\psi_{j}\right\rangle \left\langle \psi_{1}\psi_{m}\right\vert
+\sum_{\substack{2\leq j<k\leq r\\2\leq l,m\leq r}}\lambda_{1ljk}%
\lambda_{jk1m}\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle \psi
_{1}\psi_{m}\right\vert
\end{align}%
\begin{equation}
=\quad-\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}}\lambda_{1jkl}%
\left\vert \psi_{1}\psi_{l}\right\rangle \left\langle \psi_{j}\psi
_{k}\right\vert -\sum_{\substack{2\leq j<k\leq r\\2\leq l\leq r}%
}\lambda_{jk1l}\left\vert \psi_{j}\psi_{k}\right\rangle \left\langle \psi
_{1}\psi_{l}\right\vert -\sum_{2\leq j,k\leq r}\lambda_{1j1m}\left\vert
\psi_{1}\psi_{j}\right\rangle \left\langle \psi_{1}\psi_{m}\right\vert
\end{equation}



