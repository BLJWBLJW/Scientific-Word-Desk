_{2}\right)  =\hat{\lambda}_{2}+3\Gamma_{2}^{3}\left(  \hat{\lambda}%
_{2}\right)  +6\Gamma_{2}^{4}\left(  \hat{\lambda}_{2}\right)
\end{align}
