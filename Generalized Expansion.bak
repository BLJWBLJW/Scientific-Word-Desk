Note
\begin{equation}
\Gamma_{1}^{N}\left(  P_{1\nu}\right)  =\,P_{N1\nu},
\end{equation}
where
\begin{align}
P_{1\nu}  & =\sum_{1\leq j\leq\nu}\left\vert \psi_{j}\right\rangle
\left\langle \psi_{j}\right\vert \\
P_{N1\nu}  & =\sum_{1\leq j\leq\nu}\sum_{1\leq j_{1}<\cdots<j_{N-1\leq r}%
}\left\vert \psi_{j}\psi_{j_{1}}\cdots\psi_{j_{N-1}}\right\rangle \left\langle
\psi_{j}\psi_{j_{1}}\cdots\psi_{j_{N-1}}\right\vert .
\end{align}


\bigskip%

\begin{equation}
\Gamma_{2}^{N}\left(  P_{2\nu}\right)  =P_{N2\nu},
\end{equation}
where
\begin{align}
P_{2\nu}  & =\sum_{1\leq j<k\leq\nu}\left\vert \psi_{j}\psi_{k}\right\rangle
\left\langle \psi_{j}\psi_{k}\right\vert \\
P_{N2\nu}  & =\sum_{1\leq j<k\leq\nu}\sum_{1\leq j_{1}<\cdots<j_{N-1\leq r}%
}\left\vert \psi_{j}\psi_{k}\psi_{j_{1}}\cdots\psi_{j_{N-2}}\right\rangle
\left\langle \psi_{j}\psi_{k}\psi_{j_{1}}\cdots\psi_{j_{N-2}}\right\vert .
\end{align}


\bigskip

r=3: The SQ of $\hat{\lambda}_{1}$
\begin{align}
\Gamma\left(  \hat{\lambda}_{1}\right)    & =\sum_{0\leq N\leq r}\Gamma
_{N}\left(  \hat{\lambda}_{1}\right)  =\sum_{1\leq N\leq r}\sum_{1\leq P\leq
N}\binom{N}{P}\Gamma_{P}^{N}\left(  \hat{\lambda}_{1}\right)  \nonumber\\
& =\sum_{1\leq N\leq3}\binom{N}{1}\Gamma_{1}^{N}\left(  \hat{\lambda}%
_{1}\right)  =\hat{\lambda}_{1}+2\Gamma_{1}^{2}\left(  \hat{\lambda}%
_{1}\right)  +3\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)
\end{align}%
\begin{align}
a_{1}^{\dagger}a_{1}  & =\Gamma\left(  \left\vert 1\right\rangle \left\langle
1\right\vert \right)  =\left\vert 1\right\rangle \left\langle 1\right\vert
+2\Gamma_{1}^{2}\left(  \left\vert 1\right\rangle \left\langle 1\right\vert
\right)  +3\Gamma_{1}^{3}\left(  \left\vert 1\right\rangle \left\langle
1\right\vert \right)  \nonumber\\
& =\left\vert 1\right\rangle \left\langle 1\right\vert +\left\vert
12\right\rangle \left\langle 12\right\vert +\left\vert 13\right\rangle
\left\langle 13\right\vert +\left\vert 123\right\rangle \left\langle
123\right\vert
\end{align}%
\[
\parallel
\]
%

\begin{align}
& \lambda_{111}\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\lambda_{122}\left\vert \psi_{2}\right\rangle \left\langle
\psi_{2}\right\vert +\lambda_{133}\left\vert \psi_{3}\right\rangle
\left\langle \psi_{3}\right\vert +\lambda_{111}\left\vert \psi_{1}\psi
_{2}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\lambda
_{111}\left\vert \psi_{1}\psi_{3}\right\rangle \left\langle \psi_{1}\psi
_{3}\right\vert \nonumber\\
& +\lambda_{122}\left\vert \psi_{2}\psi_{1}\right\rangle \left\langle \psi
_{2}\psi_{1}\right\vert +\lambda_{122}\left\vert \psi_{2}\psi_{3}\right\rangle
\left\langle \psi_{2}\psi_{3}\right\vert +\lambda_{133}\left\vert \psi_{3}%
\psi_{1}\right\rangle \left\langle \psi_{3}\psi_{1}\right\vert +\lambda
_{133}\left\vert \psi_{3}\psi_{2}\right\rangle \left\langle \psi_{3}\psi
_{2}\right\vert \nonumber\\
& +\lambda_{111}\left\vert \psi_{1}\psi_{2}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{2}\psi_{3}\right\vert +\lambda_{122}\left\vert \psi_{1}\psi
_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\psi_{3}\right\vert
+\lambda_{133}\left\vert \psi_{1}\psi_{2}\psi_{3}\right\rangle \left\langle
\psi_{1}\psi_{2}\psi_{3}\right\vert
\end{align}%
\[
\parallel
\]%
\begin{align}
& \lambda_{111}\left\vert \psi_{1}\right\rangle \left\langle \psi
_{1}\right\vert +\lambda_{122}\left\vert \psi_{2}\right\rangle \left\langle
\psi_{2}\right\vert +\lambda_{133}\left\vert \psi_{3}\right\rangle
\left\langle \psi_{3}\right\vert \nonumber\\
& +\left(  \lambda_{111}+\lambda_{122}\right)  \left\vert \psi_{1}\psi
_{2}\right\rangle \left\langle \psi_{1}\psi_{2}\right\vert +\left(
\lambda_{111}+\lambda_{133}\right)  \left\vert \psi_{1}\psi_{3}\right\rangle
\left\langle \psi_{1}\psi_{3}\right\vert +\left(  \lambda_{122}+\lambda
_{133}\right)  \left\vert \psi_{2}\psi_{3}\right\rangle \left\langle \psi
_{2}\psi_{3}\right\vert \nonumber\\
& +\left(  \lambda_{111}+\lambda_{122}+\lambda_{133}\right)  \left\vert
\psi_{1}\psi_{2}\psi_{3}\right\rangle \left\langle \psi_{1}\psi_{2}\psi
_{3}\right\vert
\end{align}


\bigskip%

\begin{align}
\Gamma\left(  \hat{\lambda}_{2}\right)    & =\sum_{0\leq N\leq r}\Gamma
_{N}\left(  \hat{\lambda}_{2}\right)  =\sum_{1\leq N\leq r}\sum_{1\leq P\leq
N}\binom{N}{P}\Gamma_{P}^{N}\left(  \hat{\lambda}_{2}\right)  \nonumber\\
& =\sum_{2\leq N\leq3}\binom{N}{2}\Gamma_{2}^{N}\left(  \hat{\lambda}%
_{2}\right)  =\hat{\lambda}_{2}+3\Gamma_{2}^{3}\left(  \hat{\lambda}%
_{2}\right)
\end{align}%
