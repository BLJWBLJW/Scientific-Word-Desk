\bigskip The square of the SQ of $\hat{\lambda}_{1}$ %

\begin{align}
\Gamma\left(  \hat{\lambda}_{1}\right)  \Gamma\left(  \hat{\lambda}%
_{1}\right)    & =\left(  \hat{\lambda}_{1}+2\Gamma_{1}^{2}\left(
\hat{\lambda}_{1}\right)  +3\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)
\right)  \left(  \hat{\lambda}_{1}+2\Gamma_{1}^{2}\left(  \hat{\lambda}%
_{1}\right)  +3\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  \right)
\nonumber\\
& =\left(  \hat{\lambda}_{1}\right)  ^{2}+4\Gamma_{1}^{2}\left(  \hat{\lambda
}_{1}\right)  ^{2}+9\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  ^{2}%
\end{align}
$\lceil$ consider $\lambda_{1}=a_{1}^{\dagger}a_{1}$ then
\begin{align}
a_{1}^{\dagger}a_{1}  & =\Gamma\left(  \left\vert 1\right\rangle \left\langle
1\right\vert \right)  =\left\vert 1\right\rangle \left\langle 1\right\vert
+2\Gamma_{1}^{2}\left(  \left\vert 1\right\rangle \left\langle 1\right\vert
\right)  +3\Gamma_{1}^{3}\left(  \left\vert 1\right\rangle \left\langle
1\right\vert \right)  \nonumber\\
& =\left\vert 1\right\rangle \left\langle 1\right\vert +\left\vert
12\right\rangle \left\langle 12\right\vert +\left\vert 13\right\rangle
\left\langle 13\right\vert +\left\vert 123\right\rangle \left\langle
123\right\vert
\end{align}
so
\begin{equation}
P_{213}=\left\vert 12\right\rangle \left\langle 12\right\vert +\left\vert
13\right\rangle \left\langle 13\right\vert =\frac{1}{2}\Gamma_{1}^{2}\left(
P_{13}\right)
\end{equation}
and
\begin{align}
\lambda_{1}^{2}  & =\left(  \left\vert 1\right\rangle \left\langle
1\right\vert +\left\vert 12\right\rangle \left\langle 12\right\vert
+\left\vert 13\right\rangle \left\langle 13\right\vert +\left\vert
123\right\rangle \left\langle 123\right\vert \right)  \left(  \left\vert
1\right\rangle \left\langle 1\right\vert +\left\vert 12\right\rangle
\left\langle 12\right\vert +\left\vert 13\right\rangle \left\langle
13\right\vert +\left\vert 123\right\rangle \left\langle 123\right\vert
\right)  \nonumber\\
& =\left\vert 1\right\rangle \left\langle 1\right\vert +\left\vert
12\right\rangle \left\langle 12\right\vert +\left\vert 13\right\rangle
\left\langle 13\right\vert +\left\vert 123\right\rangle \left\langle
123\right\vert =\lambda_{1}%
\end{align}
$\rfloor$%
