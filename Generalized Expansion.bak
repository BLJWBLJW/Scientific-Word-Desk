\begin{equation}
\Delta_{1}=0\Rightarrow\hat{\lambda}_{1}=P_{1\nu}%
\end{equation}%
\begin{align}
\Delta_{2}  & =0\Rightarrow\nonumber\\
\left(  \hat{\lambda}_{2}\right)  ^{2}+P_{21\nu}+P_{21\nu}\hat{\lambda}%
_{2}+\hat{\lambda}_{2}P_{21\nu}-P_{21\nu}-\hat{\lambda}_{2}  & =\nonumber\\
\left(  \hat{\lambda}_{2}\right)  ^{2}+P_{21\nu}\hat{\lambda}_{2}+\hat
{\lambda}_{2}P_{21\nu}-\hat{\lambda}_{2}  & =0\Rightarrow\nonumber\\
P_{21\nu}\left(  \hat{\lambda}_{2}\right)  ^{2}P_{21\nu}+P_{21\nu}\hat
{\lambda}_{2}P_{21\nu}  & =0;\\
P_{21\nu}^{\perp}\left(  \hat{\lambda}_{2}\right)  ^{2}P_{21\nu}^{\perp
}-P_{21\nu}^{\perp}\left(  \hat{\lambda}_{2}\right)  P_{21\nu}^{\perp}  &
=0;\\
P_{21\nu}^{\perp}\left(  \hat{\lambda}_{2}\right)  ^{2}P_{21\nu}+P_{21\nu
}^{\perp}\hat{\lambda}_{2}P_{21\nu}  & =0
\end{align}
as%
\begin{equation}
P_{21\nu}=\frac{1}{2}\Gamma_{1}^{2}\left(  P_{1\nu}\right)
\end{equation}%
\begin{equation}
9\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  \Gamma_{2}^{3}\left(
\hat{\lambda}_{2}\right)  +9\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  +9\Gamma_{2}^{3}\left(
\hat{\lambda}_{2}\right)  ^{2}-3\Gamma_{1}^{3}\left(  \hat{\lambda}%
_{1}\right)  -3\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
\end{equation}%
\begin{align}
\Delta_{3}  & =0\Rightarrow\nonumber\\
P_{31\nu}\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)  +\Gamma_{2}%
^{3}\left(  \hat{\lambda}_{2}\right)  P_{31\nu}+3\Gamma_{2}^{3}\left(
\hat{\lambda}_{2}\right)  ^{2}-\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
-P_{31\nu}  & =0\Rightarrow\nonumber
\end{align}


