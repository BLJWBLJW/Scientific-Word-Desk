\begin{align}
\Gamma\left(  \hat{\lambda}_{1}\right)    & =\sum_{0\leq N\leq r}\Gamma
_{N}\left(  \hat{\lambda}_{1}\right)  =\sum_{1\leq N\leq r}\sum_{1\leq P\leq
N}\binom{N}{P}\Gamma_{P}^{N}\left(  \hat{\lambda}_{1}\right)  \nonumber\\
& =\sum_{1\leq N\leq4}\binom{N}{1}\Gamma_{1}^{N}\left(  \hat{\lambda}%
_{1}\right)  =\hat{\lambda}_{1}+2\Gamma_{1}^{2}\left(  \hat{\lambda}%
_{1}\right)  +3\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  +4\Gamma
_{1}^{4}\left(  \hat{\lambda}_{1}\right)
\end{align}%
