The difference operator, $\Delta,$ is
\begin{align}
\Delta=  & \Gamma\left(  \hat{\lambda}_{1}+\hat{\lambda}_{2}\right)
^{2}-\Gamma\left(  \hat{\lambda}_{1}+\hat{\lambda}_{2}\right)  =\Gamma\left(
\hat{\lambda}_{1}\right)  ^{2}+\Gamma\left(  \hat{\lambda}_{1}\right)
\Gamma\left(  \hat{\lambda}_{2}\right)  +\Gamma\left(  \hat{\lambda}%
_{2}\right)  \Gamma\left(  \hat{\lambda}_{1}\right)  +\Gamma\left(
\hat{\lambda}_{2}\right)  ^{2}-\Gamma\left(  \hat{\lambda}_{1}\right)
-\Gamma\left(  \hat{\lambda}_{2}\right)  \nonumber\\
& =\left(  \hat{\lambda}_{1}\right)  ^{2}+4\Gamma_{1}^{2}\left(  \hat{\lambda
}_{1}\right)  ^{2}+9\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)
^{2}+2\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  \hat{\lambda}%
_{2}+9\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  \Gamma_{2}^{3}\left(
\hat{\lambda}_{2}\right)  +2\hat{\lambda}_{2}\Gamma_{1}^{2}\left(
\hat{\lambda}_{1}\right)  +9\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  \nonumber\\
& +\left(  \hat{\lambda}_{2}\right)  ^{2}+9\Gamma_{2}^{3}\left(  \hat{\lambda
}_{2}\right)  ^{2}-\hat{\lambda}_{1}-2\Gamma_{1}^{2}\left(  \hat{\lambda}%
_{1}\right)  -3\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  -\hat{\lambda
}_{2}-3\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
\end{align}%
\begin{align}
\Delta & =\left(  \hat{\lambda}_{1}\right)  ^{2}-\hat{\lambda}_{1}\nonumber\\
& +\left(  \hat{\lambda}_{2}\right)  ^{2}+4\Gamma_{1}^{2}\left(  \hat{\lambda
}_{1}\right)  ^{2}+2\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)
\hat{\lambda}_{2}+2\hat{\lambda}_{2}\Gamma_{1}^{2}\left(  \hat{\lambda}%
_{1}\right)  -2\Gamma_{1}^{2}\left(  \hat{\lambda}_{1}\right)  -\hat{\lambda
}_{2}\nonumber\\
& +9\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  \Gamma_{2}^{3}\left(
\hat{\lambda}_{2}\right)  +9\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
\Gamma_{1}^{3}\left(  \hat{\lambda}_{1}\right)  +9\Gamma_{2}^{3}\left(
\hat{\lambda}_{2}\right)  ^{2}-3\Gamma_{1}^{3}\left(  \hat{\lambda}%
_{1}\right)  -3\Gamma_{2}^{3}\left(  \hat{\lambda}_{2}\right)
\end{align}


