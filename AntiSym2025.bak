\begin{theorem}
If a matrix ${\cal A\in M}\left( 2r,2r,{\Bbb C}\right) $ is antisymmetric
and normal then it can be brought to complex antisymmetric canonical form by
a {\em real orthogonal} transformation.

\begin{proof}
\begin{equation}
{\cal A}=i{\cal M}+{\cal N}.,
\end{equation}%
where
\end{proof}
\end{theorem}

\begin{enumerate}
\item ${\cal M}$ and ${\cal N}$ commute%
\begin{equation}
\left[ {\cal M},{\cal N}\right] =0
\end{equation}

\item ${\cal M}$ and ${\cal N}$ are real

\begin{enumerate}
\item 
\begin{equation}
{\cal M}={\cal M}^{\ast }
\end{equation}

\item 
\begin{equation}
{\cal N}={\cal N}^{\ast }
\end{equation}
\end{enumerate}

\item ${\cal M}$ and ${\cal N}$ are antisymmetric

\begin{enumerate}
\item 
\begin{equation}
{\cal M}=-{\cal M}^{t}
\end{equation}

\item 
\begin{equation}
{\cal N}=-{\cal N}^{t}
\end{equation}
\end{enumerate}

\item Thus can be simultaneously diagonalized by a real orthogonal
transformation.

\begin{remark}
Note that the real part ${\cal N}$ of ${\cal A}$ is related to self adjoint 
{\em imaginary} part of ${\cal A}$ while the imaginary part ${\cal M}$ of $%
{\cal A}$ is related to self adjoint {\em real} part of ${\cal A}$!.
\end{remark}

\item $%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}$ and $%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}$ can be simultaneously diagonalized to give 
\begin{eqnarray}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A} &=&i{\cal M}=\sum_{1\leq j\leq s}\mu _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad \mu
_{j}\in {\Bbb R}  \nonumber \\
&\Rightarrow &{\cal M}={\cal -}\sum_{1\leq j\leq s}i\mu _{j}\left\{
\left\vert v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert
v_{j}^{\ast }\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\}
\end{eqnarray}%
and 
\begin{eqnarray}
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A} &=&-i{\cal N}=\sum_{1\leq j\leq s}\upsilon _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad
\upsilon _{j}\in {\Bbb R}  \nonumber \\
&\Rightarrow &{\cal N}=\sum_{1\leq j\leq s}i\upsilon _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} .
\end{eqnarray}
\end{enumerate}

Then we can use the theory for real antisymmetric matrices to obtain 
\begin{equation}
{\cal M}=\sum_{1\leq j\leq s}\mu _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert 
\stackrel{}{s_{j}}\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert
\right\}
\end{equation}%
and 
\begin{equation}
{\cal N}=\sum_{1\leq j\leq s}\left( -\upsilon _{j}\right) \left\{ \left\vert 
\stackrel{}{s_{j}}\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert
-\left\vert \stackrel{}{s_{_{j+s}}}\right\rangle \left\langle \stackrel{}{%
s_{j}}\right\vert \right\}
\end{equation}%
which gives using 
\begin{equation}
{\cal A}=%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
{\cal A}+i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal A}={\cal N}+i{\cal M}
\end{equation}%
the {\em canonical} expansion 
\begin{eqnarray}
{\cal A} &=&\sum_{1\leq j\leq s}\left( -\upsilon _{j}+i\mu _{j}\right)
\left\{ \left\vert s_{j}\right\rangle \left\langle s_{j+s}\right\vert
-\left\vert s_{_{j+s}}\right\rangle \left\langle s_{j}\right\vert \right\} 
\nonumber \\
&\equiv &\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert 
\stackrel{}{s_{_{j+s}}}\right\rangle \left\langle \stackrel{}{s_{j}}%
\right\vert \right\} ,
\end{eqnarray}%
where $\eta _{j}=-\upsilon _{j}+i\mu _{j}$. This gives the matrix
representation 
\begin{equation}
{\cal A}\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle
\cdots \left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \eta _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\eta _{s} & 0%
\end{array}%
\right)
\end{equation}%
and the expansion 
\begin{equation}
{\cal A}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \eta _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\eta _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle s_{1}\right\vert \\ 
\left\langle s_{1+s}\right\vert \\ 
\vdots \\ 
\left\langle s_{s}\right\vert \\ 
\left\langle s_{s+s}\right\vert%
\end{array}%
\right)
\end{equation}%
We can also observe that ${\cal A}$ has the {\em spectral expansion} 
\begin{equation}
{\cal A}=-i\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{v_{j}}%
\right\rangle \left\langle \stackrel{}{v_{j}}\right\vert -\left\vert 
\stackrel{}{v_{j}^{\ast }}\right\rangle \left\langle \stackrel{}{v_{j}^{\ast
}}\right\vert \right\} .
\end{equation}%
This gives the matrix representation 
\begin{equation}
{\cal A}\left( \left\vert \left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle \right\rangle \right) =\left( \left\vert
\left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots
\left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle
\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\eta _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\eta _{s}%
\end{array}%
\right)
\end{equation}%
and the expansion%
\begin{equation}
{\cal A}=\left( \left\vert \left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle \right\rangle \right) \left( 
\begin{array}{ccccc}
-i\eta _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\eta _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\eta _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\eta _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\langle v_{1}^{\ast }\right\vert \\ 
\left\langle v_{1}\right\vert \\ 
\vdots \\ 
\left\langle v_{s}^{\ast }\right\vert \\ 
\left\langle v_{s}\right\vert%
\end{array}%
\right) .
\end{equation}

The bases $\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right) $ and $\left( \left\vert s_{1}\right\rangle
\left\vert s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle
\left\vert s_{s+s}\right\rangle \right) $ can be viewed as transformations
of a fixed {\em real }starting basis $\left( \left\vert e_{1}\right\rangle
\cdots \left\vert e_{2s}\right\rangle \right) $ i.e.%
\begin{eqnarray}
\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
&=&\left( \left\vert e_{1}\right\rangle \cdots \left\vert
e_{2s}\right\rangle \right) {\Bbb S}  \nonumber \\
\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle
\cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle
\right) &=&\left( \left\vert e_{1}\right\rangle \cdots \left\vert
e_{2s}\right\rangle \right) {\Bbb V}
\end{eqnarray}%
where ${\Bbb S}$ is a real orthogonal matrix and ${\Bbb V}$ is unitary
matrix. If we are solely working with matrices we can set 
\begin{equation}
\left\vert e_{j}\right\rangle =\left( 
\begin{array}{c}
0 \\ 
\vdots \\ 
0 \\ 
1 \\ 
0 \\ 
\vdots \\ 
0%
\end{array}%
\right) \leftarrow \text{j'th position}
\end{equation}%
and the matrix ${\Bbb S}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) $ and ${\Bbb V}=$ $\left( \left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle \right) $ where $%
\left\vert s_{j}\right\rangle $ and $\left\vert v_{j}\right\rangle $ are
numerical column vectors, while if we are considering abstract operators we
can consider $\left\{ \left\vert e_{j}\right\rangle \right\} $ to be a given
fixed real basis of ${\cal H}$.

\section{Symmetry}

There is a 1-1 correspondence between antisymmetric operators acting on a
Hilbert space ${\cal H}$ (i.e. mixed contra and covariant tensors of rank $%
\left( 1,1\right) $) and contravariant tensors of rank $\left( 0,2\right) $
and also covariant tensors of rank $\left( 2,0\right) $. The first
correspondence is given by 
\begin{equation}
{\cal A}=\sum_{1\leq j\leq s}\eta _{j}\left\{ \left\vert \stackrel{}{s_{j}}%
\right\rangle \left\langle \stackrel{}{s_{j+s}}\right\vert -\left\vert
s_{_{j+s}}\right\rangle \left\langle \stackrel{}{s_{j}}\right\vert \right\}
\leftrightarrow 2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle  \label{contra}
\end{equation}%
where $\left\vert s_{j}s_{j+s}\right\rangle $ is the normalized
antisymmetric tensor product of the {\em real }basis elements $\left\{
\left\vert s_{j}\right\rangle ,\left\vert s_{_{j+s}}\right\rangle \right\} $
and $\eta _{j}=\eta _{jj+s}$.

The expansions of ${\cal A}$ are not unique and we have from the preceeding
that%
\begin{eqnarray}
{\cal A} &=&\sum\Sb 1\leq j\leq s  \\ 1\leq j^{\prime }\leq 2s  \\ 1\leq
j^{\prime \prime }\leq 2s  \endSb \eta _{j}\left\{ \left\vert e_{j^{\prime
}}S_{j^{\prime }2j-1}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j}\right\vert -\left\vert e_{j^{\prime
}}S_{j^{\prime }2j}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j-1}\right\vert \right\}  \nonumber \\
&=&\sum\Sb 1\leq j\leq s  \\ 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime
\prime }\leq 2s  \endSb \left\{ \eta _{j}\left\vert e_{j^{\prime
}}S_{j^{\prime }2j-1}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j}\right\vert +\eta _{j+s}\left\vert e_{j^{\prime
}}S_{j^{\prime }2j}\right\rangle \left\langle e_{j^{\prime \prime
}}S_{j^{\prime \prime }2j-1}\right\vert \right\}  \nonumber \\
&=&\sum\Sb 1\leq j\leq 2s  \\ 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime
\prime }\leq 2s  \endSb S_{j^{\prime }j}\eta _{j}S_{j^{\prime \prime
}j}\left\vert e_{j^{\prime }}\right\rangle \left\langle e_{j^{\prime \prime
}}\right\vert  \nonumber \\
&=&\sum\Sb 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime \prime }\leq 2s 
\endSb \left( {\Bbb S}{\bf \eta }{\Bbb S}^{t}\right) _{_{j^{\prime
}j^{\prime \prime }}}\left\vert e_{j^{\prime }}\right\rangle \left\langle
e_{j^{\prime \prime }}\right\vert
\end{eqnarray}%
and 
\begin{eqnarray}
{\cal A} &=&2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle =\sum_{1\leq j\leq s}\left\{ \eta
_{jj+s}\left\vert s_{j}s_{j+s}\right\rangle +\eta _{j+sj}\left\vert
s_{j+s}s_{j}\right\rangle \right\}  \nonumber \\
&=&\sum\Sb 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime \prime }\leq 2s 
\endSb \left( {\Bbb S}{\bf \eta }{\Bbb S}^{t}\right) _{_{j^{\prime
}j^{\prime \prime }}}\left\vert e_{j^{\prime }}e_{j^{\prime \prime
}}\right\rangle =\sum\Sb 1\leq j^{\prime }\leq 2s  \\ 1\leq j^{\prime \prime
}\leq 2s  \endSb {\Bbb A}_{_{j^{\prime }j^{\prime \prime }}}\left\vert
e_{j^{\prime }}e_{j^{\prime \prime }}\right\rangle
\end{eqnarray}%
Eq. $\left( \ref{contra}\right) $ shows that 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Os_{j}Os_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
O\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb O}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb O}_{\left( j\right) }=1
\end{equation}%
i.e. $O\in SO(2,{\Bbb R)}$ and $O{\cal A}O^{t}={\cal A}.$ If we have some
degeneracies i.e. $\eta _{j_{1}}=\cdots =\eta _{j_{d}}$ then $O\in SO(2d,%
{\Bbb R)}$ and $O{\cal A}O^{t}={\cal A}$ also produce different but
equivalent expansions of ${\cal A}$ in terms of a real basis.

We can also observe that 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
U\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb U}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb U}_{\left( j\right) }=1
\end{equation}%
i.e. $U\in SU(2,{\Bbb C)}$ and $U{\cal A}U^{t}={\cal A}.$ If we have some
degeneracies i.e. $\eta _{j_{1}}=\cdots =\eta _{j_{d}}$ then $U\in SU(2d,%
{\Bbb C)}$ and $U{\cal A}U^{t}={\cal A}$ also produce different but
equivalent expansions of ${\cal A}$ in terms of a complex basis.

We can further observe more generally that 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left( \det {\Bbb U}_{\left( j\right)
}\right) ^{-1}\left\vert Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq
s}\eta _{j}\left\vert s_{j}s_{j+s}\right\rangle
\end{equation}%
if 
\begin{equation}
U\left( \left\vert s_{j}\right\rangle ,\left\vert s_{j+s}\right\rangle
\right) =\left( \left\vert s_{j}\right\rangle ,\left\vert
s_{j+s}\right\rangle \right) {\Bbb U}_{\left( j\right) }
\end{equation}%
and 
\begin{equation}
\det {\Bbb U}_{\left( j\right) }=e^{i\sigma }
\end{equation}%
A special case of this is 
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left( \det {\Bbb U}_{\left( j\right)
}\right) ^{-1}\left\vert Us_{j}Us_{j+s}\right\rangle =2\sum_{1\leq j\leq
s}\left\vert \eta _{j}\right\vert \left\vert Us_{j}Us_{j+s}\right\rangle
\end{equation}%
where 
\begin{equation}
\eta _{j}=\left\vert \eta _{j}\right\vert e^{i\sigma }
\end{equation}%
Thus one can conclude that the expansion of ${\cal A}$ in terms of a
canonical complex basis {\em does not }lead to {\em unique }canonical
coefficients!! In this case canonical coefficients are only uniquely defined
up to a complex phase factor and the value of the canonical coefficients
depends on the canonical basis used. However the absolute values $\left\{
\left. \left\vert \eta _{j}\right\vert \right\vert 1\leq j\leq s\right\} $
are unique.

Expansions in terms of canonical real bases as $\det {\Bbb O}_{\left(
j\right) }=-1$ (the only other possible value for $\det {\Bbb O}_{\left(
j\right) })$ leads to%
\begin{equation}
{\cal A}=2\sum_{1\leq j\leq s}\eta _{j}\left( -1\right) \left\vert
Os_{j}Os_{j+s}\right\rangle =2\sum_{1\leq j\leq s}\eta _{j}\left\vert
Os_{j+s}Os_{j}\right\rangle ,
\end{equation}%
which corresponds to $\eta _{j}\rightarrow -\eta _{j}$. Thus canonical
coefficients in this case are uniquely defined up to sign. The eigenvalues
of ${\cal A}$ are however {\em uniquely} defined as $\left\{ \pm i\eta
_{j};1\leq j\leq s\right\} $.

\section{Complex Conjugation\label{star}}

A complex conjugation map, $\sigma _{e}$, is a antilinear involution
determined by any representative,$\left\{ \left\vert {\bf e}\right\rangle
\right\} $, of an equivalence class of bases $\left[ \left\vert {\bf e}%
\right\rangle \right] $ of ${\cal H}$ by

\begin{definition}
\begin{equation}
\sigma _{e}\left\vert v\right\rangle =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq n}\left\vert e_{j}\right\rangle \left( \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( v\right) _{j}\right) -i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( v\right) _{j}\right) }\right) =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq n}\left\vert e_{j}\right\rangle {\cal R}_{e}\left( v\right)
_{j}^{\ast },\quad \forall \left\vert v\right\rangle \in {\cal H}.
\end{equation}%
where 
\begin{equation}
\left\vert v\right\rangle =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq n}\left\vert e_{j}\right\rangle {\cal R}_{e}\left( v\right)
_{j}.
\end{equation}
\end{definition}

\begin{definition}
Any vector that satisfies 
\begin{equation}
\sigma _{e}\left\vert w\right\rangle =\left\vert w\right\rangle
\end{equation}%
is called $\sigma _{e}$-{\em real} wrt the complex conjugation $\sigma _{e}$%
, in particular the basis elements $\left\{ \left\vert e_{j}\right\rangle
\right\} $ are real vectors.
\end{definition}

\begin{definition}
\bigskip The complex conjugate $\widehat{\sigma _{e}}\left( B\right) $ of an
operator $B$ is defined by 
\begin{equation}
{\cal B}^{\ast }=\widehat{\sigma _{e}}\left( B\right) =\sigma _{e}B\sigma
_{e},
\end{equation}%
i.e. 
\begin{equation}
{\cal B}^{\ast }\left\vert v\right\rangle =\widehat{\sigma _{e}}\left(
B\right) \left\vert v\right\rangle =\sigma _{e}B\sigma _{e}\left\vert
v\right\rangle =\sigma _{e}B\left( \sigma _{e}\left\vert v\right\rangle
\right) =\sigma _{e}\left( \stackrel{}{B\left( \sigma _{e}\left\vert
v\right\rangle \right) }\right) ,\quad \forall \left\vert v\right\rangle \in 
{\cal H}.
\end{equation}
\end{definition}

\begin{remark}
This leads to 
\begin{equation}
B^{\ast }\left\vert {\bf e}\right\rangle =\widehat{\sigma _{e}}\left(
B\right) \left( \left\vert {\bf e}\right\rangle \right) =\sigma _{e}B\sigma
_{e}\left( \left\vert {\bf e}\right\rangle \right) =\sigma _{e}B\left(
\left\vert {\bf e}\right\rangle \right) =\sigma _{e}\left( \left\vert {\bf e}%
\right\rangle \right) {\cal R}_{e}\left( B\right) =\left( \left\vert {\bf e}%
\right\rangle \right) {\cal R}_{e}\left( B\right) ^{\ast }.
\end{equation}
\end{remark}

\begin{definition}
The $\sigma _{e}$-transpose $B^{t_{e}}$ of an operator $B$ is defined by 
\begin{equation}
B^{t_{e}}\left( \left\vert {\bf e}\right\rangle \right) =\left( \left\vert 
{\bf e}\right\rangle \right) {\cal R}_{e}\left( B^{t_{e}}\right) =\left(
\left\vert {\bf e}\right\rangle \right) {\cal R}_{e}\left( B\right)
^{t},\quad \left\vert {\bf e}\right\rangle \in {\frak B}_{e}\left( {\cal H}%
\right) .
\end{equation}
\end{definition}

\begin{remark}
The transpose $B^{t_{e}}$ can then be defined in terms of $\sigma _{e}$ and
the adjoint operation as 
\begin{equation}
B^{t_{e}}=\left( B^{\dagger }\right) ^{\ast }=\left( \widehat{\sigma _{e}}%
\left( B^{\dagger }\right) \right) ^{t_{e}}.
\end{equation}
\end{remark}
