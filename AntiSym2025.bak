&=&-\frac{i}{4}\left[ {\cal A},{\cal A}\right] +\frac{i}{4}\left[ {\cal A},%
{\cal A}^{\dagger }\right] -\frac{i}{4}\left[ {\cal A}^{\dagger },{\cal A}%
\right] +\frac{i}{4}\left[ {\cal A}^{\dagger },{\cal A}^{\dagger }\right]  \\
&=&\frac{i}{2}\left[ {\cal A},{\cal A}^{\dagger }\right] 
\end{eqnarray}%
hence 
