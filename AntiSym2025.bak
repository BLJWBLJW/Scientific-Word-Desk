\mathop{\rm Im}%
%EndExpansion
}\left( {\cal A}\right)
\end{equation}%
and 
\begin{equation}
{\cal A}={\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( {\cal R}_{e}\left( {\cal A}\right) \right) +i{\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( {\cal R}_{e}\left( {\cal A}\right) \right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
{\frak 
%TCIMACRO{\func{Re}}%
