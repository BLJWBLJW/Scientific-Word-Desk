\section{ Antisymmetric Operators $\in {\cal B}\left( {\cal H}\right) $}

${\cal H}$ is a complex Hilbert space of dimension $r.$

\subsection{Conjugations}

\begin{definition}
The $\sigma _{e}$-complex conjugate of the vector $v\in {\cal H}$ is defined
by 
\begin{equation}
\sigma _{e}\left( v\right) =\left\vert \QTR{bs}{e}\right\rangle \left( {\cal %
R}_{e}\left( v\right) \right) ^{\ast }.
\end{equation}
\end{definition}

\begin{definition}
The $\sigma _{e}$-complex conjugate of an operator $A\in {\cal B}\left( 
{\cal H}\right) $ is defined by 
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =\left\vert \QTR{bs}{e}\right\rangle 
{\cal R}_{e}\left( A\right) ^{\ast }\left\langle \QTR{bs}{e}\right\vert .
\end{equation}
\end{definition}

\begin{definition}
The $t_{e}$-transpose of an operator $A\in {\cal B}\left( {\cal H}\right) $
is defined by 
\begin{equation}
A^{t_{e}}=\left\vert \QTR{bs}{e}\right\rangle {\cal R}_{e}\left( A\right)
^{t}\left\langle \QTR{bs}{e}\right\vert .
\end{equation}
\end{definition}

\begin{lemma}
$t_{e}$ corresponds to a non degenerate symmetric bilinear form 
\begin{equation}
s_{e}:{\cal H}\times {\cal H}\rightarrow {\Bbb C}
\end{equation}%
given by 
\begin{equation}
\left( \left. \stackrel{}{v}\right\vert w\right) _{e}=s_{e}\left( v,w\right)
=\left( \sum_{1\leq j\leq k\leq r}e_{j}\vee e_{k}\right) \left( \stackrel{}{%
v,w}\right) =\sum_{1\leq j\leq k\leq r}\left\langle \left. \stackrel{}{%
e_{j}\vee e_{k}}\right\vert v\vee w\right\rangle _{{\cal H}\vee {\cal H}}
\end{equation}%
and defined by 
\begin{equation}
\left( \left. \stackrel{}{A^{t_{e}}v}\right\vert Aw\right) _{e}=\left(
\left. \stackrel{}{v}\right\vert Aw\right) _{e}\quad \forall v,w\in {\cal H}.
\end{equation}
\end{lemma}

\begin{definition}
A vector $v$ ${\cal \in }V$ is

\begin{enumerate}
\item $\sigma _{e}$-{\em real if }%
\begin{equation}
\sigma _{e}\left( v\right) =v.
\end{equation}

\item $\sigma _{e}$-{\em imaginary if }%
\begin{equation}
\sigma _{e}\left( v\right) =-v.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
An operator $A\in {\cal B}\left( {\cal H}\right) $ is

\begin{enumerate}
\item $\sigma _{e}$-{\em real if }%
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =A.
\end{equation}

\item $\sigma _{e}$-{\em imaginary if }%
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =-A.
\end{equation}
\end{enumerate}
\end{definition}

\begin{definition}
An operator $A\in {\cal B}\left( {\cal H}\right) $ is

\begin{enumerate}
\item $e$-symmetric{\em \ if }%
\begin{equation}
A^{t_{e}}=A.
\end{equation}

\item $e$-anti symmetric{\em \ if }%
\begin{equation}
A^{t_{e}}=-A.
\end{equation}
\end{enumerate}
\end{definition}

\begin{lemma}
\begin{equation}
\widehat{\sigma _{e}}\left( A\right) =\sigma _{e}A\sigma _{e}
\end{equation}

\begin{proof}
\begin{equation}
\left[ \widehat{\sigma _{e}}\left( A\right) \right] \left( v\right) =\sigma
_{e}\left( \stackrel{}{A\sigma _{e}\left( \stackrel{}{v}\right) }\right) ,
\end{equation}
\end{proof}
\end{lemma}

\begin{lemma}
Any vector $\left\vert v\right\rangle \in {\cal H}$ has a real positive
representation.

\begin{proof}
Let $\left( \QTR{bs}{e}\right) $ be a conb of ${\cal H}$ then 
\begin{equation}
\left\vert v\right\rangle =\left\vert \QTR{bs}{e}\right\rangle {\cal R}%
_{e}\left( v\right) =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle {\cal %
R}_{e}\left( v\right) _{j},\quad {\cal R}_{e}\left( v\right) _{j}\in {\Bbb C}%
.
\end{equation}%
${\cal R}_{e}\left( v\right) _{j}$ can be expresses in polar form as 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}=\left\vert {\cal R}_{e}\left( v\right)
_{j}\right\vert e^{i\theta \left( {\cal R}_{e}\left( v\right) _{j}\right)
},\quad \left\vert {\cal R}_{e}\left( v\right) _{j}\right\vert \in {\Bbb R}
\end{equation}%
hence one obtains the real expansion given by   
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle
\left\vert {\cal R}_{e}\left( v\right) _{j}\right\vert e^{i\theta \left( 
{\cal R}_{e}\left( v\right) _{j}\right) }=%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq r}\left\vert e^{i\theta \left( {\cal R}_{e}\left( v\right)
_{j}\right) }\stackrel{}{e_{j}}\right\rangle \left\vert {\cal R}_{e}\left(
v\right) _{j}\right\vert =%
%TCIMACRO{\dsum}%
%BeginExpansion
\mathop{\displaystyle\sum}%
%EndExpansion
_{1\leq j\leq r}\left\vert \stackrel{}{f_{j}}\right\rangle \left\vert {\cal R%
}_{e}\left( v\right) _{j}\right\vert 
\end{equation}%
and 
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle 
{\cal R}_{f}\left( v\right) _{j},
\end{equation}%
where 
\begin{equation}
\left\vert \stackrel{}{f_{j}}\right\rangle =\left\vert e^{i\theta \left( 
{\cal R}_{e}\left( v\right) _{j}\right) }\stackrel{}{e_{j}}\right\rangle 
\end{equation}%
and 
\begin{equation}
{\cal R}_{f}\left( v\right) _{j}=\left\vert {\cal R}_{e}\left( v\right)
_{j}\right\vert \in {\Bbb R}_{+}.
\end{equation}
\end{proof} Let $\left( \QTR{bs}{e}\right) \,\equiv \left\{ \left.
\left\vert e_{j}\right\rangle \right\vert 1\leq j\leq r\right\} $ be a conb
then  
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert e_{j}\right\rangle 
{\cal R}_{e}\left( v\right) _{j},\,
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}\in {\Bbb C},\,1\leq j\leq r.
\end{equation}%
Each coefficient ${\cal R}_{e}\left( v\right) _{j}$ can be expanded in polar
form as 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}=\left\vert {\cal R}_{e}\left( v\right)
_{j}\right\vert \exp \left\{ i\theta \left( {\cal R}_{e}\left( v\right)
_{j}\right) \right\} ,\,1\leq j\leq r
\end{equation}%
leading to a new conb 
\begin{equation}
\left\vert f_{j}\right\rangle =\left\vert e_{j}\right\rangle \exp \left\{
i\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) \right\} ,\,1\leq
j\leq r
\end{equation}%
that leads to a a real positive expansion 
\begin{equation}
\left\vert v\right\rangle =\sum_{1\leq j\leq r}\left\vert f_{j}\right\rangle
\left\vert {\cal R}_{e}\left( v\right) _{j}\right\vert =\sum_{1\leq j\leq
r}\left\vert f_{j}\right\rangle {\cal R}_{f}\left( v\right) _{j}.\,
\end{equation}
\end{lemma}

\begin{remark}
The complex coefficient ${\cal R}_{e}\left( v\right) _{j}$ can be also be
expressed as 
\begin{equation}
{\cal R}_{e}\left( v\right) _{j}=\left\vert \stackrel{}{\stackrel{}{{\cal R}%
_{e}\left( v\right) _{j}}}\right\vert \left( \stackrel{}{\cos \left( 
\stackrel{}{\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) }\right)
+i\sin \left( \stackrel{}{\theta \left( {\cal R}_{e}\left( v\right)
_{j}\right) }\right) }\right) .
\end{equation}
\end{remark}

\begin{remark}
The transformation 
\begin{equation}
u=\left\vert \QTR{bs}{f}\right\rangle \left\langle \QTR{bs}{e}\right\vert 
\end{equation}%
is unitary and has a representation ${\cal R}_{e}\left( u\right) $ given by 
\begin{equation}
{\cal R}_{e}\left( u\right) ={\cal R}_{e}\left( \left\vert \QTR{bs}{f}%
\right\rangle \left\langle \QTR{bs}{e}\right\vert \right) =\left( 
\begin{array}{cccc}
e^{i\theta \left( {\cal R}_{e}\left( v\right) _{1}\right) } & 0 & \cdots  & 0
\\ 
0 & \ddots  & \cdots  & \vdots  \\ 
\vdots  & \vdots  & \ddots  & 0 \\ 
0 & \cdots  & 0 & e^{i\theta \left( {\cal R}_{e}\left( v\right) _{r}\right) }%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{lemma}
The unjitary group $U\left( r\right) $ has a coset factoriztion 
\begin{equation}
U\left( r\right) =\left( \left. \stackrel{}{U\left( r\right) }\right/
O\left( r,{\Bbb R}\right) \right) O\left( r,{\Bbb R}\right) 
\end{equation}%
and the preceding unitary operator $u$ belongs to the coset generated by the
real orthogonal group $O\left( r\right) $ i.e.  
\begin{equation}
u\in \left. \stackrel{}{U\left( r\right) }\right/ O\left( r,{\Bbb R}\right) .
\end{equation}

\begin{proof}
Clearly $u$ does not transform real expansion coeficients to real expansion
coefficients unless   
\begin{equation}
e^{i\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) }=\pm 1
\end{equation}%
i.e.%
\begin{equation}
\theta \left( {\cal R}_{e}\left( v\right) _{j}\right) =2n\pi .
\end{equation}
\end{proof} 
\end{lemma}

\begin{enumerate}
\item The action of group $O\left( r,{\Bbb R}\right) $ conserves the reality
of the $\left( \QTR{bs}{f}\right) $ expansion of $\left\vert v\right\rangle .
$ 

\item The unitary operator $u$%
\begin{equation}
u=\exp \left\{ -i\sum_{1\leq j\leq r}\left\vert \stackrel{}{e_{j}}%
\right\rangle \left\langle \stackrel{}{e_{j}}\right\vert \theta \left( {\cal %
R}_{e}\left( v\right) _{jj}\right) \right\} 
\end{equation}%
does not conserve the reality of the $\left( \QTR{bs}{f}\right) $ expansion
of $\left\vert v\right\rangle .$
\end{enumerate}

\begin{remark}
Polar decomposition of $u\in U\left( r\right) $ 
\begin{equation}
u=\exp \left\{ \eta \right\} \exp \left\{ i\lambda \right\} ,
\end{equation}%
where 
\begin{equation}
\eta =\eta ^{\dagger }
\end{equation}%
and 
\begin{equation}
\widehat{\sigma _{e}}\left( \lambda \right) =\lambda .
\end{equation}
\end{remark}

\begin{remark}
In second quantization%
\begin{equation}
u=\exp \left\{ \frac{1}{2}\sum_{1\leq j<k\leq r}\left( a_{j}^{\dagger
}a_{k}+a_{k}^{\dagger }a_{j}\right) {\cal R}_{a}\left( \lambda _{1}\right)
_{jk}\right\} \exp \left\{ \sum_{1\leq j\leq r}a_{j}^{\dagger }a_{j}{\cal R}%
_{a}\left( \lambda _{0}\right) _{j}\right\} \exp \left\{ \frac{1}{2}%
i\sum_{1\leq j<k\leq r}\left( a_{j}^{\dagger }a_{k}-a_{k}^{\dagger
}a_{j}\right) {\cal R}_{a}\left( \lambda _{-1}\right) _{jk}\right\} .
\end{equation}
\end{remark}

\begin{corollary}
$\left\vert v\right\rangle $ is $\sigma _{f}$-real i.e. 
\begin{equation}
\sigma _{f}\left( v\right) =v.
\end{equation}
\end{corollary}

Let $A$ be a $\sigma _{e}$-{\em real} {\em compact} {\em antisymmetric}
operator $\in {\cal B}_{0}\left( {\cal H}\right) $, then

\begin{enumerate}
\item 
\begin{equation}
A^{t_{e}}=-A
\end{equation}

and

\item 
\begin{equation}
A=\widehat{\sigma _{e}}\left( A\right) ,
\end{equation}%
where ${\cal H}$ is a complex Hilbert space then

\item it has the canonical expansion 
\begin{equation}
A=\sum_{1\leq j\leq s}\left\{ \left\vert e_{j}\right\rangle \left\langle
e_{j+s}\right\vert -\left\vert e_{_{j+s}}\right\rangle \left\langle
e_{j}\right\vert \right\} {\cal R}_{s}\left( A\right) _{jj}=\sum_{1\leq
j\leq s}\left\{ \left\vert e_{j}\right\rangle \left\langle
e_{j+s}\right\vert -\left\vert e_{_{j+s}}\right\rangle \left\langle
e_{j}\right\vert \right\} \alpha _{j},\,{\cal R}_{s}\left( A\right)
_{jj}=\alpha _{j}\in {\Bbb R},\,1\leq j\leq s.  \label{anti}
\end{equation}
\end{enumerate}

\begin{lemma}
Every $\sigma _{e}$-{\em real} {\em compact} {\em antisymmetric} operator $%
A\in {\cal B}\left( {\cal H}\right) $ determines a self adjoint operator $%
H\in {\cal B}\left( {\cal H}\right) $ defined by 
\begin{equation}
H=iA.
\end{equation}

\begin{proof}
\begin{equation}
H^{\dagger }=\widehat{\sigma _{e}}\left( H\right) ^{t_{e}}=-iH^{t_{e}}=iA=H
\end{equation}
\end{proof}
\end{lemma}

This is true as the operator is real $A=\widehat{\sigma _{e}}\left( A\right) 
$, (see Appendix \ref{star} for the definition of complex conjugation $%
\widehat{\sigma _{s}}$) and it determines a {\em compact self adjoint }$%
\sigma _{s}$-{\em imaginary} {\em operator}, $H$, 
\begin{equation}
H=iA
\end{equation}%
with the properties 
\begin{eqnarray}
\widehat{\sigma _{e}}\left( H\right) &=&-iA=iA^{t_{e}}\,=H^{t_{e}}  \nonumber
\\
\widehat{\sigma _{e}}\left( H\right) &=&-H
\end{eqnarray}%
and 
\begin{equation}
H=iA=\sum_{1\leq j\leq s}\left\{ \left\vert v_{j}\right\rangle \left\langle
v_{j}\right\vert -\left\vert \sigma _{e}\left( v_{j}\right) \right\rangle
\left\langle \sigma _{e}\left( v_{j}\right) \right\vert \right\} \alpha
_{j};\qquad \alpha _{j}\in {\Bbb R},  \label{sa}
\end{equation}%
where $\left\{ \left\vert v_{j}\right\rangle ,\left\vert \sigma _{e}\left(
v_{j}\right) \right\rangle ;1\leq j\leq s\right\} $ is a conb for ${\cal H}$.

In finite dimensions we must consider even dimensional spaces or even
dimensional subspaces of codimension 1. Eq. $\left( \ref{sa}\right) $ which
is seen by observing that 
\begin{equation}
H\left\vert v\right\rangle =\alpha \left\vert v\right\rangle \Rightarrow 
\widehat{\sigma _{e}}\left( H\right) \left\vert \sigma _{e}\left(
v_{j}\right) \right\rangle =\alpha \left\vert \sigma _{e}\left( v_{j}\right)
\right\rangle \Rightarrow H^{t_{e}}\left\vert \sigma _{s}\left( v_{j}\right)
\right\rangle =\alpha \left\vert \sigma _{e}\left( v_{j}\right)
\right\rangle \Rightarrow H\left\vert \sigma _{e}\left( v_{j}\right)
\right\rangle =-\alpha \left\vert \sigma _{e}\left( v_{j}\right)
\right\rangle .
\end{equation}

\begin{lemma}
A real antisymmetric operator $A$ is determined by a self adjoint operator $%
H $ that has paired eigenvalues and complex conjugate eigenvectors. 
\begin{equation}
A=-iH
\end{equation}
\end{lemma}

\begin{lemma}
Real antisymmetric operators $A$ and $B$ only commute if they can be
simultaneously diagonalized.
\end{lemma}

\begin{lemma}
If ${\cal A}$ is \underline{$\sigma _{s}$-{\em real}} and $t_{s}$%
-antisymmetric then it is normal i.e. 
\begin{equation}
\left[ A,A^{\dagger }\right] =0
\end{equation}

\begin{proof}
Noting that 
\begin{equation}
{\cal R}_{e}\left( H\right) =i{\cal R}_{e}\left( A\right) ,
\end{equation}%
where 
\begin{equation}
{\cal R}_{e}\left( A\right) \in {\cal B}\left( {\Bbb R}^{r}\right) 
\end{equation}%
then 
\begin{equation}
{\cal R}_{e}\left( H\right) ^{\dagger }=-i{\cal R}_{e}\left( A\right) ^{t}=i%
{\cal R}_{e}\left( A\right) ={\cal R}_{e}\left( H\right) .
\end{equation}%
In the case $A$ is a $\sigma _{e}$-{\em real} {\em antisymmetric} operator
one thus obtains that 
\begin{eqnarray}
\left[ A,A^{\dagger }\right]  &=&AA^{\dagger }-A^{\dagger }A \\
&=&\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\left( \stackrel{}{{\cal R}_{e}\left( A\right) {\cal R}_{e}\left( A\right)
^{\dagger }-{\cal R}_{e}\left( A\right) ^{\dagger }{\cal R}_{e}\left(
A\right) }\right)  \\
&=&\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\left( \stackrel{}{{\cal R}_{e}\left( iH\right) {\cal R}_{e}\left( iH\right)
^{\dagger }-{\cal R}_{e}\left( iH\right) ^{\dagger }{\cal R}_{e}\left(
iH\right) }\right)  \\
&=&\left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}\right\vert
\left( \stackrel{}{{\cal R}_{e}\left( H\right) {\cal R}_{e}\left( H\right) -%
{\cal R}_{e}\left( H\right) {\cal R}_{e}\left( H\right) }\right)  \\
&=&0.
\end{eqnarray}
\end{proof}
\end{lemma}

{\em It is important to note} that the orthonormal eigenvectors of $H$ are
only defined up to an overall phase factors $e^{i\varphi _{j}}$ which {\em %
do not} preserve the complex conjugate relationship between eigenvectors
associated with paired eigenvalues of opposite sign. These different bases
are related to each other by 
\begin{equation}
\left( \left\vert v_{1}^{\prime }\right\rangle \cdots \left\vert
v_{2s}^{\prime }\right\rangle \right) =\left( \left\vert v_{1}\right\rangle
\cdots \left\vert v_{2s}\right\rangle \right) \left( 
\begin{array}{ccc}
e^{i\varphi _{1}} & {\bf 0} & {\bf 0} \\ 
{\bf 0} & \ddots & {\bf 0} \\ 
{\bf 0} & {\bf 0} & e^{i\varphi _{2s}}%
\end{array}%
\right) .
\end{equation}%
Using a basis with complex conjugate symmetry we obtain 
\begin{equation}
A={\cal -}\sum_{1\leq j\leq s}i\alpha _{j}\left\{ \left\vert
v_{j}\right\rangle \left\langle v_{j}\right\vert -\left\vert v_{j}^{\ast
}\right\rangle \left\langle v_{j}^{\ast }\right\vert \right\} ;\qquad \alpha
_{i}\in {\Bbb R}
\end{equation}%
We can then define a {\em real} conb $\left\{ \left\vert s_{j}\right\rangle
;1\leq j\leq \infty \right\} $ i.e. $\left\vert s_{j}\right\rangle
=\left\vert s_{j}^{\ast }\right\rangle $ as 
\begin{eqnarray}
\left\vert s_{j}\right\rangle &=&\frac{1}{\sqrt{2}}\left( \left\vert
v_{j}\right\rangle +\left\vert v_{j}^{\ast }\right\rangle \right) =\sqrt{2}%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left\vert v_{j}\right\rangle  \nonumber \\
\left\vert s_{j+s}\right\rangle &=&\frac{-i}{\sqrt{2}}\left( \left(
\left\vert v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right)
\right) =\sqrt{2}%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left\vert v_{j}\right\rangle
\end{eqnarray}%
so that 
\begin{eqnarray}
A\left\{ \frac{1}{\sqrt{2}}\left( \left\vert v_{j}\right\rangle +\left\vert
v_{j}^{\ast }\right\rangle \right) \right\} &=&-i\alpha _{j}\frac{1}{\sqrt{2}%
}\left( \left\vert v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle
\right)  \nonumber \\
&=&\alpha _{j}\left\{ \frac{-i}{\sqrt{2}}\left( \left( \left\vert
v_{j}\right\rangle -\left\vert v_{j}^{\ast }\right\rangle \right) \right)
\right\}
\end{eqnarray}%
and 
\begin{eqnarray}
A\left\{ \frac{-i}{\sqrt{2}}\left( \left( \left\vert v_{j}\right\rangle
-\left\vert v_{j}^{\ast }\right\rangle \right) \right) \right\} &=&\frac{%
-\alpha _{j}}{\sqrt{2}}\left\vert v_{j}\right\rangle -\frac{\alpha _{j}}{%
\sqrt{2}}\left\vert v_{j}^{\ast }\right\rangle  \nonumber \\
&=&-\alpha _{j}\left\{ \frac{1}{\sqrt{2}}\left( \left\vert
v_{j}\right\rangle +\left\vert v_{j}^{\ast }\right\rangle \right) \right\}
\end{eqnarray}%
thus 
\begin{equation}
A=\sum_{1\leq j\leq s}\alpha _{j}\left\{ \left\vert s_{j}\right\rangle
\left\langle s_{j+s}\right\vert -\left\vert s_{j+s}\right\rangle
\left\langle s_{j}\right\vert \right\}
\end{equation}%
which justifies the expansion in eq. $\left( \ref{anti}\right) $. Using the
bases $\left\{ \left\vert s_{j}\right\rangle ;1\leq j\leq \infty \right\} $
we can produce the canonical matrix representation of $A$ 
\begin{equation}
A\left( \left\vert {\bf s}\right\rangle \right) =\left\vert {\bf s}%
\right\rangle \left( 
\begin{array}{cc}
{\Bbb O} & {\bf \alpha } \\ 
-{\bf \alpha } & {\Bbb O}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
{\bf \alpha =}\left( 
\begin{array}{ccc}
\alpha _{1} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & \ddots & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \alpha _{s}%
\end{array}%
\right) .
\end{equation}%
One can reorder this basis to obtain 
\begin{equation}
{\cal A}\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle
\cdots \left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right)
=\left( \left\vert s_{1}\right\rangle \left\vert s_{1+s}\right\rangle \cdots
\left\vert s_{s}\right\rangle \left\vert s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right)
\end{equation}%
and the expansion 
\begin{equation}
{\cal A}=\left( \left\vert s_{1}\right\rangle \left\vert
s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle \left\vert
s_{s+s}\right\rangle \right) \left( 
\begin{array}{ccccc}
0 & \alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
-\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & \alpha _{s} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -\alpha _{s} & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\vert s_{1}\right\rangle \\ 
\left\vert s_{1+s}\right\rangle \\ 
\vdots \\ 
\left\vert s_{s}\right\rangle \\ 
\left\vert s_{s+s}\right\rangle%
\end{array}%
\right)  \label{reex}
\end{equation}%
The row vector of basis vectors, $\left( \left\vert s_{1}\right\rangle
\left\vert s_{1+s}\right\rangle \cdots \left\vert s_{s}\right\rangle
\left\vert s_{s+s}\right\rangle \right) $, can be viewed as a real
orthogonal matrix whose columns are the real basis vectors $\left\{ \cdots
,\left\vert s_{j}\right\rangle ,\left\vert s_{s+j}\right\rangle ,\cdots
\right\} $.

The complex basis $\left\{ \left\vert v_{j}\right\rangle ,\left\vert
v_{j}^{\ast }\right\rangle ;1\leq j\leq \infty \right\} $ diagonalizes $%
{\cal A}$ to give 
\begin{equation}
{\cal A}\left( \left\vert {\bf v}\right\rangle ,\left\vert {\bf v}^{\ast
}\right\rangle \right) =\left( \left\vert {\bf v}\right\rangle ,\left\vert 
{\bf v}^{\ast }\right\rangle \right) \left( 
\begin{array}{cc}
-i{\bf \alpha } & {\Bbb O} \\ 
{\Bbb O} & i{\bf \alpha }%
\end{array}%
\right)
\end{equation}%
this basis can also be reordered to produce 
\begin{equation}
{\cal A}\left( \left\vert \left\vert v_{1}\right\rangle \left\vert
v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert
v_{s}^{\ast }\right\rangle \right\rangle \right) =\left( \left\vert
v_{1}\right\rangle \left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert
v_{s}\right\rangle \left\vert v_{s}^{\ast }\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right)
\end{equation}%
and the expansion%
\begin{equation}
{\cal A}=\left( \left\vert v_{1}\right\rangle \left\vert v_{1}^{\ast
}\right\rangle \cdots \left\vert v_{s}\right\rangle \left\vert v_{s}^{\ast
}\right\rangle \right) \left( 
\begin{array}{ccccc}
-i\alpha _{1} & 0 & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
0 & i\alpha _{1} & {\Bbb O} & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & \ddots & {\Bbb O} & {\Bbb O} \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & -i\alpha _{s} & 0 \\ 
{\Bbb O} & {\Bbb O} & {\Bbb O} & 0 & i\alpha _{s}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left\vert v_{1}\right\rangle \\ 
\left\vert v_{1}^{\ast }\right\rangle \\ 
\vdots \\ 
\left\vert v_{s}\right\rangle \\ 
\left\vert v_{s}^{\ast }\right\rangle%
\end{array}%
\right) .  \label{ccex}
\end{equation}%
The row vector of basis vectors, $\left( \left\vert v_{1}\right\rangle
\left\vert v_{1}^{\ast }\right\rangle \cdots \left\vert v_{s}\right\rangle
\left\vert v_{s}^{\ast }\right\rangle \right) $, can be viewed as an unitary
matrix whose columns are the basis vectors $\left\{ \cdots ,\left\vert
v_{j}\right\rangle ,\left\vert v_{j}^{\ast }\right\rangle ,\cdots \right\} $%
. Note that the expansions of eqs $\left( \ref{reex}\right) $ and $\left( %
\ref{ccex}\right) $ both give ${\cal A}$ thus in eq $\left( \ref{reex}%
\right) $ all the imaginary terms cancel.

\subsection{Complex Antisymmetric Operator and Matrices}

\begin{definition}
An operator ${\cal A}$ is normal if 
\begin{equation}
\left[ {\cal A},{\cal A}^{\dagger }\right] =0,
\end{equation}
\end{definition}

\begin{remark}
Representations ${\cal R}_{e}\left( {\cal A}\right) \in $ ${\cal B}\left( 
{\Bbb C}^{n}\right) $ of an operator ${\cal A}\in {\cal B}\left( {\cal H}%
\right) $ wrt a conb $\left( \QTR{bs}{e}\right) $ are produced by the
expansions

\begin{enumerate}
\item 
\begin{equation}
{\cal A}=\left( \left\vert \QTR{bs}{e}\right\rangle \left\langle \QTR{bs}{e}%
\right\vert \right) {\cal R}_{e}\left( {\cal A}\right) =\left\vert \QTR{bs}{e%
}\right\rangle {\cal R}_{e}\left( {\cal A}\right) \left\langle \QTR{bs}{e}%
\right\vert
\end{equation}%
and

\item decomposed into real and imaginary {\em number} parts by 
\begin{equation}
{\cal R}_{e}\left( {\cal A}\right) =%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,
\end{equation}%
where 
\begin{equation}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) \in {\cal B}\left( {\Bbb R}%
^{n}\right) .
\end{equation}

\item If ${\cal R}_{e}\left( {\cal A}\right) $ is complex antisymmetric i.e. 
\begin{equation}
{\cal R}_{e}\left( {\cal A}\right) ^{t}=-{\cal R}_{e}\left( {\cal A}\right)
\end{equation}%
then 
\begin{equation}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}=-%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) -i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right)
\end{equation}%
showing that its real and imaginary parts are real antisymmetric i.e. 
\begin{equation}
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}=-%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right)
\end{equation}%
and 
\begin{equation}
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}=-%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{theorem}
${\cal R}_{e}\left( {\cal A}\right) $ is a normal matrix $%
%TCIMACRO{\limfunc{Iff}}%
%BeginExpansion
\mathop{\rm Iff}%
%EndExpansion
$ the real and imaginary {\em number} parts of ${\cal R}_{e}\left( {\cal A}%
\right) $ commute i.e. 
\begin{equation}
\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] =0.
\end{equation}

\begin{proof}
The commutator of the representation ${\cal R}_{e}\left( {\cal A}\right) $
and its adjoint gives 
\begin{eqnarray*}
\left[ {\cal R}_{e}\left( {\cal A}\right) ,{\cal R}_{e}\left( {\cal A}%
\right) ^{\dagger }\right]  &=&\left[ \left( \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) +i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) }\right) \,,\,\left( \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) -i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right) ^{t}\right]  \\
&=&\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}}\right] -i\left[ 
\stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}}\right]  \\
&&+\left[ \stackrel{}{i%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}}\right] +\left[ 
\stackrel{}{%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ^{t}}\right] 
\end{eqnarray*}%
\begin{gather*}
\parallel  \\
-\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] +i\left[ \stackrel%
{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right]  \\
-i\left[ \stackrel{}{%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] -\left[ \stackrel{%
}{%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right]  \\
\parallel  \\
i\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] -i\left[ \stackrel%
{}{%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) ,%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right]  \\
\parallel  \\
i\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] +i\left[ \stackrel%
{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
{\cal R}_{e}\left( {\cal A}\right) }\right]  \\
\parallel  \\
2i\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] .
\end{gather*}%
Hence%
\begin{equation}
\left[ \stackrel{}{%
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) ,%
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
\left( {\cal R}_{e}\left( {\cal A}\right) \right) }\right] =0\Leftrightarrow %
\left[ {\cal R}_{e}\left( {\cal A}\right) ,{\cal R}_{e}\left( {\cal A}%
\right) ^{\dagger }\right] =0.
\end{equation}
\end{proof}
\end{theorem}

\begin{theorem}
In general real antisymmetric operators $A$,$B{\cal \in B}\left( {\Bbb R}%
^{2s}\right) $ do not commute.

\begin{proof}
\end{proof}
\end{theorem}

\begin{definition}
The real and imaginary \underline{{\em operator}} parts ${\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) $ and ${\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( {\cal A}\right) $ of an operator ${\cal A\in B}\left( {\cal H}%
\right) $ are {\em self adjoint and are defined} as

\begin{enumerate}
\item 
\begin{equation}
{\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) =\frac{1}{2}\left( A+A^{\dagger }\right) ={\frak 
%TCIMACRO{\func{Re}}%
%BeginExpansion
\mathop{\rm Re}%
%EndExpansion
}\left( A\right) ^{\dagger }
\end{equation}

\item 
\begin{equation}
{\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) =-\frac{i}{2}\left( A-A^{\dagger }\right) ={\frak 
%TCIMACRO{\func{Im}}%
%BeginExpansion
\mathop{\rm Im}%
%EndExpansion
}\left( A\right) ^{\dagger }.
\end{equation}
\end{enumerate}
\end{definition}

\begin{remark}
This {\em definition is valid in both the operator and matrix representation}
cases and gives 
\begin{equation}
{\cal A}={\frak 
%TCIMACRO{\func{Re}}%
