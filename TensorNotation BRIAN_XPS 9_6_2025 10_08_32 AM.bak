\part{Tensor Notation}

\section{Representation indices }

\begin{enumerate}
\item 

\begin{enumerate}
\item Contravariant coordinate indices are superscripts  

\item Contravariant vector indices are subscripts

\item Representation of a Contravariant vector
\begin{equation}
v=\left(  \boldsymbol{e}\right)  ^{t}\mathcal{R}_{e}\left(  v\right)  =\left(
%
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)
\end{equation}

\end{enumerate}

\item 

\begin{enumerate}
\item Covariant coordinate indices are subscripts

\item Covariant vector indices are superscripts

\item Representation of a Covariant vector%
\begin{equation}
w_{d}=\left(  \boldsymbol{e}_{d}\right)  ^{t}\mathcal{R}_{e_{d}}\left(
w_{d}\right)  =\left(
\begin{array}
[c]{ccc}%
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1}\\
\vdots\\
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{r}%
\end{array}
\right)
\end{equation}

\end{enumerate}
\end{enumerate}

\begin{definition}


\begin{enumerate}
\item 

\begin{enumerate}
\item Repeated index notation implies sums and correspons to scalar products
i.e.%
\begin{equation}
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{j}\mathcal{R}_{e}\left(  v\right)
^{j}=\sum_{1\leq j\leq r}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{j}\mathcal{R}_{e}\left(  v\right)  ^{j}=\left(  \mathcal{R}_{e_{d}}\left(
w_{d}\right)  \right)  ^{t}\mathcal{R}_{e}\left(  v\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  =z\in\mathbb{C}%
\end{equation}


\item The order of the coordinates does not matter%
\begin{equation}
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{j}=\sum_{1\leq j\leq r}\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}%
_{e_{d}}\left(  w_{d}\right)  _{j}=\left(  \mathcal{R}_{e_{d}}\left(
w_{d}\right)  \right)  ^{t}\mathcal{R}_{e}\left(  v\right)  =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  =z\in\mathbb{C}%
\end{equation}

\end{enumerate}

\item 

\begin{enumerate}
\item Unpaired indices implies increased rank i.e corresponds to tensor
product i.e.
\begin{align}
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{k}  & =\mathcal{R}_{e}\left(  v\right)  \left(  \mathcal{R}_{e_{d}}\left(
w_{d}\right)  \right)  ^{t}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \\
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{k}  & =\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{1}\mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}\\
\vdots & \ddots & \vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{1} & \cdots & \mathcal{R}_{e}\left(  v\right)  ^{r}\mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  =\mathcal{R}_{e_{d}e}\left(  vw_{d}^{t}\right)  _{k}^{j}%
\equiv\mathcal{R}_{e_{d}e}\left(  vw_{d}^{t}\right)  \in\mathcal{L}\left(
V\right)  =\mathcal{M}_{e_{d}e}\left(  vw_{d}^{t}\right)  \in\mathcal{M}%
\left(  r,r,\mathbb{C}\right)
\end{align}


\item The order of the coordinates does not matter%
\begin{equation}
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{k}\mathcal{R}_{e}\left(  v\right)
^{j}=\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{d}}\left(
w_{d}\right)  _{k}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)
\end{equation}

\end{enumerate}
\end{enumerate}
\end{definition}

\begin{definition}
Natural Ordering: Products of vectore can always be rearranged so that
\begin{align}
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{k}  & =\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{k}\mathcal{R}_{e}\left(
v\right)  ^{j}=\left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \\
\mathcal{R}_{e}\left(  v\right)  ^{j}\mathcal{R}_{e_{d}}\left(  w_{d}\right)
_{j}  & =\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{j}\mathcal{R}_{e}\left(
v\right)  ^{j}=\left(
\begin{array}
[c]{ccc}%
\mathcal{R}_{e_{d}}\left(  w_{d}\right)  _{1} & \cdots & \mathcal{R}_{e_{d}%
}\left(  w_{d}\right)  _{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  ^{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  ^{r}%
\end{array}
\right)
\end{align}

\end{definition}

\begin{definition}


\begin{enumerate}
\item \emph{Contravariant} vector $v$ representations $\mathcal{R}_{e}\left(
v\right)  $ transform as $\mathcal{R}_{e}\left(  A\right)  ^{-1}%
\mathcal{R}_{e}\left(  v\right)  $, where $A\in GL\left(  V\right)  $ is the
transformation of the basis.

\item \emph{Covariant} vector $v_{d}$ representations $\mathcal{R}_{e}\left(
v_{d}\right)  $ transform as $\mathcal{R}_{e}\left(  A_{d}\right)
\mathcal{R}_{e}\left(  v_{d}\right)  $, where $A_{d}\in GL\left(
V_{d}\right)  $
\end{enumerate}
\end{definition}

