\begin{document}

\title{The Algebraic Foundations of Quantum Mechanics: From Vector Spaces to
Hilbert Spaces}
\author{Assistant}
\date{\today}

\begin{abstract}
This manuscript explores the fundamental mathematical structures underlying
quantum mechanics, demonstrating how Hilbert space structures emerge
naturally from complex vector spaces through tensor products with their
conjugate spaces. We show that the inner product, observables, and quantum
states can all be derived from purely algebraic constructions, suggesting
that the traditional Hilbert space formulation may be emergent rather than
fundamental.
\end{abstract}

\maketitle

\section{Hilbert Space Inner Product as a Linear Functional}

\subsection{The Riesz Representation Theorem}

\begin{remark}
The \textbf{Riesz Representation Theorem}, establishes that in a Hilbert
space $\mathcal{H}$, every continuous linear functional $\varphi :\mathcal{H}%
\rightarrow \mathbb{C}$ is uniquely represented by an inner product with a
specific vector i.e. for every continuous \emph{linear }functional $\varphi
\in \mathcal{H}^{d}$, there exists a unique vector $y_{\varphi }\in \mathcal{%
H}$ such that: 
\begin{equation}
\varphi (x)=\left\langle \left. y_{\varphi }\right\vert x\right\rangle _{%
\mathcal{H}}\quad \text{for all }x\in \mathcal{H}.
\end{equation}
\end{remark}

\section{Complex Conjugate Vector Spaces}

\subsection{Definition and Structure}

For any complex vector space $V$, its \textbf{complex conjugate space} $%
\overline{V}$ is defined as:

\begin{enumerate}
\item Same underlying set as $V$

\item Same vector addition: 
\begin{equation}
u+_{\overline{V}}v=u+_{V}v
\end{equation}

\item \emph{Conjugate scalar multiplication: }%
\begin{equation}
\alpha \cdot _{\overline{V}}v=\overline{\alpha }\cdot _{V}v
\end{equation}
i.e. scalar multiplication is anti linear.
\end{enumerate}

\subsection{Tensor Product Construction of Hilbert Space Inner Product}

The inner product map $\left\langle \left. \cdot \right\vert \cdot
\right\rangle _{\mathcal{H}}:\mathcal{H}\times \mathcal{H}\rightarrow 
\mathbb{C}$ is a sesquilinear map that can be expressed as a single linear
functional by packaging the two input vectors into the tensor product $%
\overline{\mathcal{H}}\otimes \mathcal{H}$, where $\overline{\mathcal{H}}$
denotes the conjugate Hilbert space.

Define a linear functional 
\begin{equation}
F:\overline{\mathcal{H}}\otimes \mathcal{H}\rightarrow \mathbb{C}
\end{equation}%
on simple tensors by: 
\begin{equation}
F(\overline{\overline{x}}\otimes y)=\left\langle \left. x\right\vert
y\right\rangle _{\mathcal{H}},
\end{equation}%
extended linearly to all of $\overline{\mathcal{H}}\otimes \mathcal{H}$,
where $\overline{\overline{x}}\in \overline{\mathcal{H}}$ and $\overline{%
\overline{x}}_{e}=\sigma _{e}\left( x\right) $ for some basis $\left( 
\boldsymbol{e}\right) $.

\begin{remark}
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=\sum_{1\leq
j\leq r}\overline{\mathcal{R}_{e}\left( x\right) }\mathcal{R}_{e}\left(
y\right) =\sum_{1\leq j\leq r}\mathcal{R}_{e}\left( \sigma _{e}\left(
x\right) \right) \mathcal{R}_{e}\left( y\right) =\sum_{1\leq j\leq r}%
\mathcal{R}_{f}\left( \sigma _{f}\left( x\right) \right) \mathcal{R}%
_{f}\left( y\right) .
\end{equation}
\end{remark}

\begin{remark}
Conjugations from different equivalence classes produce different $\overline{%
\overline{x}}_{e},$ but $\left\langle x\right\vert \equiv \left\langle
\left. x\right\vert \cdot \right\rangle _{\mathcal{H}}=\digamma \left(
\left\vert x\right\rangle \right) \in \mathcal{H}^{d},$ where%
\begin{equation}
\digamma :\mathcal{H\rightarrow H}^{d}
\end{equation}%
is unique.
\end{remark}

\begin{remark}
This construction successfully expresses the inner product as: 
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=F(\overline{%
\overline{x}}\otimes y)=F(\sigma _{e}\left( x\right) \otimes y)=F(\digamma
\left( x\right) \otimes y).
\end{equation}
\end{remark}

\begin{remark}
For \emph{every basis} $\left( \boldsymbol{e}\right) $%
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=\left\langle
\left. x\right\vert I_{\mathcal{H}}y\right\rangle _{\mathcal{H}%
}=\left\langle \left. \overset{\overset{}{}}{x}\right\vert \sum_{1\leq k\leq
r}\left\vert e_{k}\right\rangle \left\langle e_{k}\right\vert y\right\rangle
_{\mathcal{H}}=\sum_{1\leq k\leq r}\left\langle \left. x\right\vert
e_{k}\right\rangle _{\mathcal{H}}\left\langle \left. e_{k}\right\vert
y\right\rangle _{\mathcal{H}}=\sum_{1\leq k\leq r}\overline{\left\langle
\left. e_{k}\right\vert x\right\rangle }_{\mathcal{H}}\left\langle \left.
e_{k}\right\vert y\right\rangle _{\mathcal{H}}=\sum_{1\leq k\leq r}\overline{%
\mathcal{R}_{e}\left( x\right) _{k}}\mathcal{R}_{e}\left( y\right)
_{k}=\sum_{1\leq k\leq r}\mathcal{R}_{e}\left( \sigma _{e}\left( x\right)
\right) _{k}\mathcal{R}_{e}\left( y\right) _{k}=F(\sigma _{e}\left( x\right)
\otimes y)
\end{equation}%
thus one can choose any $\sigma _{e}$ and thus $\overline{\overline{x}}%
_{e}=\sigma _{e}\left( x\right) $ produces the same $\left\langle
x\right\vert $ i.e. 
\begin{equation}
\sigma :\mathfrak{B}\left( \mathcal{H}\right) \times \mathcal{H}\rightarrow 
\overline{\mathcal{H}}
\end{equation}%
and%
\begin{equation}
\sigma _{e}\left( x\right) =\sigma \left( \left( \overset{}{\boldsymbol{e}}%
\right) ,\left\vert \overset{}{x}\right\rangle \right) =\sigma _{f}\left(
x\right) =\sigma \left( \left( \overset{}{\boldsymbol{f}}\right) ,\left\vert 
\overset{}{x}\right\rangle \right) =\left\langle x\right\vert
\end{equation}%
hence%
\begin{equation}
\ker \left\{ \sigma \right\} =\left\{ \sigma _{e}\left( x\right) -\sigma
_{f}\left( x\right) \right\} \times \left\vert x\right\rangle ,\,\left( 
\boldsymbol{e}\right) ,\left( \boldsymbol{f}\right) \in \mathfrak{B}\left( 
\mathcal{H}\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left\langle \left. x\right\vert y\right\rangle _{\mathcal{H}}=\left( \left.
\sigma _{e}\left( x\right) \right\vert y\right) =\left( \left. y\right\vert
\sigma _{e}\left( x\right) \right) .
\end{equation}
\end{remark}

\subsection{Dirac Bra-Ket Notation}

This mathematical structure is precisely formalized in Dirac's bra-ket
notation:

\begin{itemize}
\item Vectors $y\in \mathcal{H}$ are%
\begin{equation}
\emph{\ kets:}|y\rangle
\end{equation}

\item Continuous linear functionals on $\mathcal{H}$ are 
\begin{equation}
\emph{bras}:\langle \varphi |
\end{equation}

\item The inner product is 
\begin{equation}
\langle x|y\rangle =\left\langle \left. x\right\vert y\right\rangle _{%
\mathcal{H}}
\end{equation}

\item The operator $|x\rangle \langle y|$ corresponds to the tensor product 
\begin{equation}
\overline{x}\otimes \overline{y}\in \mathcal{H}\otimes \overline{\mathcal{H}}%
,
\end{equation}
by 
\begin{equation}
\Xi _{\mathcal{H}\overline{\mathcal{H}}}:\mathcal{H\otimes \overline{%
\mathcal{H}}\rightarrow L}\left( \mathcal{H}\right)
\end{equation}

\begin{equation}
\Xi _{\mathcal{H}\overline{\mathcal{H}}}\left( \overline{x}\otimes \overline{%
y}\right) =|x\rangle \langle y|.
\end{equation}
\end{itemize}

\subsection{Key Mathematical Properties}

While $V$ and $\overline{V}$ share the same dimension and are isomorphic as
real vector spaces, they \emph{differ fundamentally} as complex vector
spaces:

\begin{itemize}
\item The identity map $\text{id}:V\rightarrow \overline{V}$ is \emph{%
conjugate-linear}, not $\mathbb{C}$-linear

\item Natural conjugate-linear isomorphism: $V^{d}\cong V^{\sigma _{e}},$
note that a complex conjugate space $V^{\sigma _{e}}$ \emph{is not} a
complex vector space as

\begin{itemize}
\item $\left\{ \sigma _{e}\right\} $ are complex conjugations defined in $V$
associated with bases $\left( \mathbf{e}\right) $ off $V,$ a complex
cojugation of the vector space $V$ is given by 
\begin{equation}
V^{\sigma _{e}}=\sigma _{e}\left( V\right) .
\end{equation}

\item $V^{\sigma _{e}}$ is \emph{not} a complex cojugate space as it is
complex linear.
\end{itemize}

\item Tensor product behavior: $\overline{V}\otimes W\cong \overline{%
V\otimes \overline{W}}$

\item Functorial properties make this an involutive functor on the category
of complex vector spaces
\end{itemize}

\subsection{Isomorphism Conditions}

$V\cong \overline{V}$ as complex vector spaces if and only if there exists a
conjugate-linear automorphism $\mathcal{J}:V\rightarrow V$ with $\mathcal{J}%
^{2}=\,$id. Important cases include:

\begin{itemize}
\item Real vector spaces (trivial complex structure)

\item The Canonical Complexifications of real spaces: 
\begin{equation}
V_{\mathbb{C}}=W\otimes _{\mathbb{R}}\mathbb{C}=W\otimes _{\mathbb{R}%
}\left\{ 1,i\right\} =W\oplus _{\mathbb{R}}iW.
\end{equation}

\item All Hilbert spaces (via Riesz representation)\thinspace .
\end{itemize}

\section{Dual Tensors $b\in V^{d}\otimes V^{d}$}

\subsection{SVD and Dyadic Expansions of Operators}

\begin{enumerate}
\item The components of a general second rank dual tensor $b_{\rho \sigma }$
is given by in terms of a biorthogonal bases $\left\{ \left( \boldsymbol{e}%
_{b}\right) ,\left( \boldsymbol{e}\right) \right\} $ are

\begin{enumerate}
\item 
\begin{equation}
\rho _{bj}\otimes \sigma _{bj}=\sum_{1\leq k,l\leq r}e_{bk}\otimes e_{bl}%
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k}\mathcal{R}_{e_{b}}\left(
\sigma _{bj}\right) _{l}=\sum_{1\leq k,l\leq r}e_{bk}\otimes e_{bl}\mathcal{R%
}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right) _{kl}=\sum_{1\leq
k,l\leq r}e_{bk}\otimes e_{bl}\left( \overset{}{\mathcal{R}_{e_{b}}\left(
\rho _{bj}\right) \otimes \mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) }%
\right) _{kl},
\end{equation}%
where

\item 
\begin{eqnarray}
\rho _{bj} &=&\sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e_{b}}\left( \rho
_{bj}\right) _{kj} \\
\sigma _{bj} &=&\sum_{1\leq l\leq r}e_{bl}\mathcal{R}_{e_{b}}\left( \sigma
_{bj}\right) _{lj}
\end{eqnarray}%
they
\end{enumerate}

\item combine together to form a dual tensor $b_{\rho \sigma }\in
V^{d}\otimes V^{d}$

\begin{enumerate}
\item $b_{\rho \sigma }$ can be expanded as 
\begin{gather}
b_{\rho \sigma }=\sum_{1\leq l\leq r}\rho _{bj}\otimes \sigma
_{bj}=\sum_{1\leq j\leq p\leq r}\left( \sum_{1\leq k,l\leq r}e_{bk}\otimes
e_{bl}\mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{kl}\right) =\sum_{1\leq j\leq p\leq r}\left( \sum_{1\leq k,l\leq
r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k}%
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{l}\right) \\
=\sum_{1\leq j\leq p\leq r}\left( \sum_{1\leq k,l\leq r}e_{bk}\otimes
e_{bl}\left( \overset{}{\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) \otimes 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) }\right) _{kl}\right)
=\sum_{1\leq k,l\leq r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}}\left( b_{\rho
\sigma }\right) _{kl}=\left( 
\begin{array}{ccc}
e_{b1}\otimes e_{b1} & \cdots & e_{br}\otimes e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) _{rr}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
e_{b1}\otimes e_{b1} & \cdots & e_{br}\otimes e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sum_{1\leq j\leq p\leq r}\mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma
_{bj}\right) _{11} \\ 
\vdots \\ 
\sum_{1\leq j\leq p\leq r}\mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma
_{bj}\right) _{rr}%
\end{array}%
\right) =\sum_{1\leq j\leq p\leq r}\left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{r}%
\end{array}%
\right) \right) \otimes \left( \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{r}%
\end{array}%
\right) \right)
\end{gather}

\item $b_{\rho \sigma }$ can also be expanded as%
\begin{eqnarray}
b_{\rho \sigma } &=&\sum_{1\leq l\leq r}\rho _{bj}\otimes \sigma
_{bj}=\left( 
\begin{array}{ccc}
\rho _{b1} & \cdots & \rho _{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{1} & 
\cdots & \sum_{1\leq k\leq r}e_{bk}\mathcal{R}_{e_{b}}\left( \rho
_{bj}\right) _{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
\sum_{1\leq l\leq r}e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{1}
\\ 
\vdots \\ 
\sum_{1\leq l\leq r}e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{r}%
\end{array}%
\right) \\
&=&\sum_{1\leq k,l\leq r}\left( 
\begin{array}{ccc}
e_{bk}\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k1} & \cdots & e_{bk}%
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{kr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{c}
e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{l1} \\ 
\vdots \\ 
e_{bl}\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{lr}%
\end{array}%
\right) \\
&=&\sum_{1\leq k,l\leq r}\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{11} & \cdots & \mathcal{R}%
_{e_{b}}\left( \rho _{bj}\right) _{r1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{r1} & \cdots & \mathcal{R}%
_{e_{b}}\left( \rho _{bj}\right) _{rr}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{11} & \cdots & \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{l1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \sigma _{bj}\right) _{lr} & \cdots & \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{rr}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right) _{11} & 
\cdots & \mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{kl} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right) _{kl} & 
\cdots & \mathcal{R}_{e_{b}}\left( \rho _{bj}\otimes \sigma _{bj}\right)
_{rr}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{1}\otimes \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{1} & \cdots & \mathcal{R}_{e_{b}}\left(
\rho _{bj}\right) _{1}\otimes \mathcal{R}_{e_{b}}\left( \sigma _{bj}\right)
_{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{r}\otimes \mathcal{R}%
_{e_{b}}\left( \sigma _{bj}\right) _{1} & \cdots & \mathcal{R}_{e_{b}}\left(
\rho _{bj}\right) _{r}\otimes \mathcal{R}_{e_{b}}\left( \sigma _{bj}\right)
_{r}%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}

\item $b_{\rho \sigma }$ can be mapped into an operator $\Xi _{VV^{d}}\left(
b_{\rho \sigma }\right) \in \mathcal{L}\left( V\right) $ by 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\Xi _{VV^{d}}\left( \sum_{1\leq
k,l\leq r}e_{bk}\otimes e_{bl}\mathcal{R}_{e_{b}}\left( b_{\rho \sigma
}\right) _{kl}\right) =\sum_{1\leq k,l\leq r}e_{k}\otimes \left[ e_{bl}%
\right] \mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) _{kl}=\sum_{1\leq
k,l\leq r}e_{k}\otimes \left[ e_{bl}\right] \mathcal{R}_{e_{b}}\left(
\sum_{1\leq j\leq p}\rho _{bj}\otimes \sigma _{bj}\right) _{kl},
\end{equation}

\item where 
\begin{equation}
\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) _{kl}=\sum_{1\leq j\leq p}%
\mathcal{R}_{e_{b}}\left( \rho _{bj}\right) _{k}\mathcal{R}_{e_{b}}\left(
\sigma _{bj}\right) _{l}=\sum_{1\leq j\leq p}\mathcal{R}_{e_{b}}\left( \rho
_{bj}\otimes \sigma _{bj}\right) _{kl}.
\end{equation}

\item The operator $\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) $ has the
expansion 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\left( \boldsymbol{e}%
_{b}\right) ^{t}\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) \left[
\left( \boldsymbol{e}\right) \right] .
\end{equation}

\item The matrix $\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) $ can
always be brought to SVD form i.e 
\begin{equation}
\mathcal{R}_{e_{b}}\left( b_{\rho \sigma }\right) =\mathbb{U}_{\rho \sigma }%
\U{3a3} _{\rho \sigma }\mathbb{V}_{\rho \sigma }^{\dagger },
\end{equation}%
where

\begin{enumerate}
\item $\mathbb{U}$ is an $m\times m$ unitary matrix, which can be enlarged
by 
\begin{equation}
\left( 
\begin{array}{cc}
\mathbb{U} & \mathbb{O}_{m\left( n-m\right) } \\ 
\mathbb{O}_{\left( n-m\right) m} & \mathbb{U}^{c}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
\mathbb{UU}^{\dagger }=\mathbb{I}_{m}
\end{equation}%
and 
\begin{equation}
\mathbb{U}^{c}\mathbb{U}^{c\dagger }=\mathbb{I}_{\left( n-m\right) },
\end{equation}%
where obviously $\mathbb{U}^{c}$ is non unique.

\item $\U{3a3} $ is an $m\times n$ rectangular diagonal matrix with the
singular values $\lambda _{i}\geq 0$ on its diagonal. $\U{3a3} $ can be
enlarged to a $n\times n$ matrix by adding zero entries.

\item $\mathbb{V}$ is an $n\times n$ unitary matrix.

\item $n\geq m$ as $n=\dim \left\{ \limfunc{Dom}\left( \Xi _{VV^{d}}\left(
b_{\rho \sigma }\right) \right) \right\} $ and $m=\dim \left\{ \limfunc{Ran}%
\left( \Xi _{VV^{d}}\left( b_{\rho \sigma }\right) \right) \right\} .$
\end{enumerate}

\item Hence using the expanded matrices 
\begin{equation}
\mathcal{R}_{e_{b}}\left( \overset{}{\Xi _{VV^{d}}\left( b_{\rho \sigma
}\right) }\right) =\mathcal{R}_{e_{b}}\left( \overset{}{\left( \boldsymbol{e}%
\right) ^{t}\mathbb{U}_{\rho }\U{3a3} _{\rho \sigma }\mathbb{V}_{\sigma
}^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right] }\right) =%
\mathcal{R}_{e_{b}}\left( \overset{}{\left( \boldsymbol{u}_{\rho }\right)
^{t}\U{3a3} _{\rho \sigma }\left[ \left( \boldsymbol{v}_{\sigma b}\right) %
\right] }\right) =\mathcal{R}_{e_{b}}\left( \overset{}{\left( \rho \right)
^{t}\left[ \left( \boldsymbol{\sigma }_{b}\right) \right] }\right) ,
\end{equation}%
one obtains the operator 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\left( \boldsymbol{e}\right)
^{t}\mathbb{U}_{\rho }\U{3a3} _{\rho \sigma }\mathbb{V}_{\sigma }^{\dagger }%
\left[ \left( \boldsymbol{e}_{b}\right) \right] =\left( \boldsymbol{u}_{\rho
}\right) ^{t}\U{3a3} _{\rho \sigma }\left[ \left( \boldsymbol{v}_{\sigma
b}\right) \right] =\left( \rho \right) ^{t}\left[ \left( \boldsymbol{\sigma }%
_{b}\right) \right] ,
\end{equation}%
where the unitary transformations define $\left( \boldsymbol{u}_{\rho
}\right) $ and $\left( \boldsymbol{v}_{\sigma b}\right) $ by 
\begin{equation}
\left( \boldsymbol{u}_{\rho }\right) ^{t}=\left( \boldsymbol{e}\right) ^{t}%
\mathbb{U}_{\rho }
\end{equation}%
and 
\begin{equation}
\left[ \left( \boldsymbol{v}_{\sigma b}\right) \right] =\mathbb{V}_{\sigma
}^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right] .
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\left( \boldsymbol{u}_{\rho }\right) ^{t}\left[ \left( \boldsymbol{v}%
_{b}\right) \right] =\left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }%
\mathbb{V}_{\sigma }^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) %
\right]
\end{equation}%
\begin{equation}
\left[ \left( \boldsymbol{v}_{b}\right) \right] \left( \boldsymbol{u}_{\rho
}\right) ^{t}=\mathbb{V}_{\sigma }^{\dagger }\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }
\end{equation}

\item 
\begin{eqnarray}
\left( \boldsymbol{u}_{\rho }\right) ^{t} &=&\left( \boldsymbol{e}\right)
^{t}\mathbb{U}_{\rho }\Leftrightarrow \left( \boldsymbol{u}_{\rho }\right) =%
\mathbb{U}_{\rho }^{t}\left( \boldsymbol{e}\right) \\
\left( \boldsymbol{v}_{\sigma b}\right) &=&\mathbb{V}_{\sigma }^{\dagger
}\left( \boldsymbol{e}_{b}\right) \Leftrightarrow \left( \boldsymbol{v}%
_{\sigma b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\overline{%
\mathbb{V}_{\sigma }}
\end{eqnarray}

\item $\left\{ \left( \boldsymbol{u}\right) ,\left( \boldsymbol{u}%
_{b}\right) \right\} $ and $\left\{ \left( \boldsymbol{v}\right) ,\left( 
\boldsymbol{v}_{b}\right) \right\} $ \emph{are biorthogonal bases} i.e. 
\begin{eqnarray}
\left( \boldsymbol{u}_{\rho }\right) ^{t}\left[ \left( \boldsymbol{u}_{\rho
b}\right) \right] &=&\left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }%
\mathbb{U}_{\rho }^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right]
=\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =I_{n} \\
\left( \boldsymbol{v}_{\sigma }\right) ^{t}\left[ \left( \boldsymbol{v}%
_{\sigma b}\right) \right] &=&\left( \boldsymbol{e}\right) ^{t}\mathbb{V}%
_{\sigma }\mathbb{V}_{\sigma }^{\dagger }\left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( \boldsymbol{e}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{b}\right) \right] =I_{n}
\end{eqnarray}%
and 
\begin{eqnarray}
\left[ \left( \boldsymbol{u}_{\rho b}\right) \right] \left( \boldsymbol{u}%
_{\rho }\right) ^{t} &=&\left( \boldsymbol{e}\right) ^{t}\mathbb{U}_{\rho }%
\mathbb{U}_{\rho }^{\dagger }\left[ \left( \boldsymbol{e}_{b}\right) \right]
=\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =\mathbb{I}_{n} \\
\left[ \left( \boldsymbol{v}_{\sigma b}\right) \right] \left( \boldsymbol{v}%
_{\sigma }\right) ^{t} &=&\mathbb{V}_{\sigma }^{\dagger }\left[ \left( 
\boldsymbol{e}_{b}\right) \right] \left( \boldsymbol{e}\right) ^{t}\mathbb{V}%
_{\sigma }=\left[ \left( \boldsymbol{e}_{b}\right) \right] \left( 
\boldsymbol{e}\right) ^{t}=\mathbb{I}_{n}.
\end{eqnarray}
\end{enumerate}

\item 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =U\lambda V=\left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( U\right) \mathcal{R}_{e}\left( \lambda
\right) \mathcal{R}_{e}\left( V\right) \left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{m}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathbb{U}_{\rho 11} & \cdots & \mathbb{U}_{\rho 1m} \\ 
\vdots & \ddots & \vdots \\ 
\mathbb{U}_{\rho m1} & \cdots & \mathbb{U}_{\rho mm}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\boldsymbol{\lambda }_{\left( m,m\right) } & \mathbb{O}_{m\left( n-m\right) }
\\ 
\mathbb{O}_{\left( n-m\right) n} & \mathbb{O}_{n-m},_{n-m}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathbb{V}_{\sigma 11} & \cdots & \mathbb{V}_{\sigma 1n} \\ 
\vdots & \ddots & \vdots \\ 
\mathbb{V}_{\sigma n1} & \cdots & \mathbb{V}_{\sigma nn}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{bn}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
\boldsymbol{\lambda }_{\left( m,m\right) }=\left( 
\begin{array}{cccc}
\lambda _{1} & 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \cdots & 0 \\ 
0 & \cdots & 0 & \lambda _{m}%
\end{array}%
\right) .
\end{equation}

\item This SVD expression can be extended to singular operators by 
\begin{equation}
\Xi _{VV^{d}}\left( b_{\rho \sigma }\right) =\left( 
\begin{array}{ccc}
u_{\rho 1} & \cdots & u_{\rho n}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\boldsymbol{\lambda }_{\left( m,m\right) } & \mathbb{O}_{m\left( n-m\right) }
\\ 
\mathbb{O}_{\left( n-m\right) n} & \mathbb{O}_{n-m},_{n-m}%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{\sigma b1} \\ 
\vdots \\ 
v_{\sigma bn}%
\end{array}%
\right) =\left( \boldsymbol{u}_{\rho }\right) ^{t}\mathcal{R}_{e}\left(
\lambda \right) \left[ \left( \boldsymbol{v}_{\sigma b}\right) \right]
=\left( \rho \right) ^{t}\left[ \left( \boldsymbol{\sigma }_{b}\right) %
\right] ,
\end{equation}%
where we have enlarged the range space by appending the vectors $\left\{
u_{\rho m+1,\cdots ,}u_{\rho n}\right\} .$
\end{enumerate}

\section{Transpose}

Let $V$ be a complex $r$-dimensional vector space where 
\begin{equation}
\dim \left\{ V\right\} =r.
\end{equation}

\begin{remark}
\label{10/26/2025}

\begin{enumerate}
\item The embeding (injection) $\mathfrak{i}_{V^{dd}V}$ of $V$ into $V^{dd}$
through the basis $\left( \boldsymbol{e}\right) $ is given by 
\begin{equation}
e_{bbj}\left( y_{bk}\right) \overset{\Delta }{=}y_{bk}\left( e_{j}\right)
,\quad 1\leq j,k\leq r.
\end{equation}

\item The embeding $\mathfrak{i}_{V^{ddd}V^{dd}}$ of $V^{d}$ into $V^{ddd}$
through the basis $\left( \boldsymbol{e}\right) $ is given by 
\begin{equation}
e_{bbbj}\left( y_{bbk}\right) \overset{\Delta }{=}y_{bbk}\left(
e_{bj}\right) ,\quad 1\leq j,k\leq r.
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
e_{bj}\left( x_{k}\right) \overset{?}{=}x_{bk}\left( e_{j}\right)
\end{equation}%
\begin{equation}
e_{bj}\left( \sum_{1\leq l\leq r}e_{bj}\left( e_{l}\right) \mathcal{R}%
_{e}\left( x_{k}\right) _{l}\right) =\mathcal{R}_{e}\left( x_{k}\right)
_{j}=e_{bj}\left( x_{k}\right)
\end{equation}%
\begin{equation}
x_{bk}\left( e_{j}\right) =\left( \sum_{1\leq l\leq r}x_{bk}\left(
e_{l}\right) \mathcal{R}_{e}\left( e_{j}\right) _{l}\right) =\left(
\sum_{1\leq l\leq r}x_{bk}\left( e_{l}\right) e_{bl}\left( e_{j}\right)
\right) =x_{bk}\left( e_{j}\right) =e_{bbj}\left( x_{bk}\right)
\end{equation}
\end{remark}

\begin{remark}
By Greubs theorem for $A\in \mathcal{L}\left( V\right) $ one obtains the
dyadic expansion 
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{br}%
\end{array}%
\right) \right] .
\end{equation}
\end{remark}

\begin{definition}
\textbf{of the} \textbf{Transpose} $A^{t}\in \mathcal{L}\left( V\right) $ of 
$A\ $is 
\begin{equation}
A^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] =\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] .
\end{equation}%
The matrix representations of $A$ and $A^{t}$ are wrt a basis $\left( 
\boldsymbol{e}\right) $ of $V$ are
\end{definition}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right)
\end{equation}%
and

\item 
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( y_{1}\right) & \cdots & e_{br}\left( y_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{br}\left( e_{1}\right) & \cdots & x_{br}\left( e_{r}\right)%
\end{array}%
\right) .
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{br}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{r}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{br}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{r}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) .
\end{equation}

\item This gives 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( y_{1}\right) & \cdots & e_{br}\left( y_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{br}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{r}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{br}\left( e_{1}\right) & \cdots & x_{br}\left( e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right)
\end{equation}%
giving

\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{br}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{r}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( y_{1}\right) & \cdots & e_{br}\left( y_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{br}\left( e_{1}\right) & \cdots & x_{br}\left( e_{r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A^{t}\right) ???
\end{equation}
\end{enumerate}

\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( x_{1}\right) & \cdots & e_{br}\left( x_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{br}\left( e_{1}\right) & \cdots & y_{br}\left( e_{r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right]
\end{equation}
\end{enumerate}

Let $W$ be a real even dimensional vector space where 
\begin{equation}
\dim \left\{ W\right\} =2r.
\end{equation}%
By Greubs theorem for $A\in \mathcal{L}\left( W\right) $ one obtains the
dyadic expansion 
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] .
\end{equation}

\begin{definition}
\textbf{of the} \textbf{Transpose} $A^{t}\in \mathcal{L}\left( W\right) $ of 
$A\ $is 
\begin{equation}
A^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] =\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] .
\end{equation}
\end{definition}

\begin{remark}
If $A\in \mathcal{L}\left( W_{2},W_{1}\right) $ then 
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] ,
\end{equation}%
and $A^{t}\in \mathcal{L}\left( W_{1},W_{2}\right) $ 
\begin{equation}
A^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] =\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] ,
\end{equation}%
where 
\begin{equation}
W_{1}=\mathbb{R}\text{-}\func{linspan}\left\{ \left. y_{j}\right\vert 1\leq
j\leq 2r\right\}
\end{equation}%
and 
\begin{equation}
W_{2}=\mathbb{R}\text{-}\func{linspan}\left\{ \left. x_{j}\right\vert 1\leq
j\leq 2r\right\} .
\end{equation}
\end{remark}

\subsection{The dualizing map $d$}

\begin{definition}
\textbf{The dualizing map \label{The dualizing map} }$"d"\in \mathcal{L}%
\left( \mathcal{L}\left( W^{d}\right) ,\mathcal{L}\left( W\right) \right) $ 
\begin{equation}
d:\mathcal{L}\left( W\right) \rightarrow \mathcal{L}\left( W^{d}\right)
\end{equation}%
produces the dual $d\left( T\right) $ of the transformation of $T\in 
\mathcal{L}\left( W\right) $ \label{The dual transformation} $d\left(
T\right) \in \mathcal{L}\left( W^{d}\right) $ by 
\begin{equation}
d\left( T\right) \rho \left( v\right) =\rho \left( Tv\right) \,\quad \forall
v\in W,\forall \rho \in W^{d},\quad T\in \mathcal{L}\left( W\right)
\end{equation}
\end{definition}

\begin{definition}
Duals $v_{d\rho \sigma }=d_{\rho \sigma }\left( v\right) $ of vectors $v$ 
\textbf{wrt the bilinear form} $b_{\rho \sigma }\in W^{d}\otimes W^{d}$ are
defined by 
\begin{equation}
v_{d\rho \sigma }\left( w\right) =b_{\rho \sigma }\left( v,w\right) \quad
\forall w\in W,\,v\in W
\end{equation}

\begin{remark}
If $T\in \mathcal{L}\left( W_{2},W_{1}\right) $ i.e. 
\begin{equation}
T:W_{1}\rightarrow W_{2}
\end{equation}%
then 
\begin{equation}
d\left( T\right) :W_{2}^{d}\rightarrow W_{1}^{d}.
\end{equation}
\end{remark}
\end{definition}

\begin{remark}
The dual mappings $d\left( A\right) $ and $d\left( A\right) ^{t}$ can be
expanded as 
\begin{equation}
d\left( A\right) =\sum_{1\leq j\leq 2r}y_{bj}\left[ x_{bbj}\right]
\rightarrow \sum_{1\leq j\leq 2r}y_{bj}\left[ x_{j}\right]
\end{equation}%
and 
\begin{equation}
d\left( A\right) ^{t}=\sum_{1\leq j\leq 2r}x_{bj}\left[ y_{bbj}\right]
\rightarrow \sum_{1\leq j\leq 2r}x_{bj}\left[ y_{j}\right]
\end{equation}%
which should be compared to the expansions of $A$ and $A^{t}$%
\begin{equation}
A=\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right]
\end{equation}
\end{remark}

and 
\begin{equation}
A^{t}=\sum_{1\leq j\leq 2r}y_{j}\left[ x_{bj}\right] ,
\end{equation}%
which are general unequal.

The matrix represenations $\mathcal{R}_{e}\left( A\right) $ and $\mathcal{R}%
_{e}\left( A^{t}\right) $ of the operators $A$ and $A^{t}$ wrt a basis $%
\left( \boldsymbol{e}\right) $ of $W$ are

\begin{enumerate}
\item $\mathcal{R}_{e}\left( A\right) $%
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\item $\mathcal{R}_{e}\left( A^{t}\right) $%
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{b2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\item Compare to $\mathcal{R}_{e}\left( A\right) ^{t}$ 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) .
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( A\right) ^{t}=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

The matrix represenations $\mathcal{R}_{e}\left( d\left( A\right) \right) $
and $\mathcal{R}_{e}\left( d\left( A\right) ^{t}\right) $ of the operators $%
d\left( A\right) $ and $d\left( A\right) ^{t}$ wrt a basis $\left( 
\boldsymbol{e}\right) $ of $W$ are

\begin{enumerate}
\item $\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) $%
\begin{gather}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bb2r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
y_{b1} & \cdots & y_{b2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{bb1} \\ 
\vdots \\ 
x_{bb2r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{b2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( y_{b1}\right) & \cdots & e_{bb1}\left( y_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{bb2r}\left( y_{b1}\right) & \cdots & e_{bb2r}\left( y_{b2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{bb1}\left( e_{b1}\right) & \cdots & x_{bb1}\left( e_{b2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{bb2r}\left( e_{b1}\right) & \cdots & x_{bb2r}\left( e_{b2r}\right)%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2r}\right)%
