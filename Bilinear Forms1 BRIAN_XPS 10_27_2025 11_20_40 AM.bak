\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) .
\end{equation}
\end{enumerate}
\end{enumerate}

\subsection{Bilinear forms $\left( \left. {}\right\vert \right) _{\protect%
\rho \protect\sigma }$ on $W$}

One can equip $W$ with a \emph{non degenerate} bilinear forms $\left( \left.
{}\right\vert \right) _{\rho \sigma }\equiv \left( \left. {}\right\vert
\right) \in W^{d}\otimes W^{d}$ for $\rho _{b}$,$\sigma _{b}\in W^{d}$ 
\begin{equation}
\left( \left. {}\right\vert \right) \equiv \left( \left. {}\right\vert
\right) _{\rho \sigma }:W\times W\rightarrow \mathbb{R}
\end{equation}%
that in general \emph{do not} have any symmetry i.e. $\left( \left.
v\right\vert w\right) $ is unrelated to $\left( \left. w\right\vert v\right)
.$

\begin{notation}
\begin{equation}
\left( \left. {}\right\vert \right) _{\rho \sigma }\equiv \left( \left.
{}\right\vert \right) .
\end{equation}
\end{notation}

\begin{definition}
\textbf{\ }A form $\left( \left. {}\right\vert \right) _{\rho \sigma }$ is
non degenerate if 
\begin{equation}
\left( \left. v\right\vert w\right) _{\rho \sigma }=0\quad \forall w\in
W\Leftrightarrow v=0.
\end{equation}
\end{definition}

\begin{theorem}
A non degenrate bilinear form $\left( \left. {}\right\vert \right) _{\rho
\sigma }\in W^{d}\otimes W^{d}$ can be expanded as 
\begin{equation}
\left( \left. {}\right\vert \right) =\left( \left. {}\right\vert \right)
_{\rho \sigma }=\sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj},
\end{equation}%
whose action is defined by 
\begin{equation}
\left( \left. v\right\vert w\right) =\left( \left. v\right\vert w\right)
_{\rho \sigma }=\sum_{1\leq j\leq 2r}\left[ \overset{}{\rho _{bj}\otimes
\sigma _{bj}}\right] \left( v\otimes w\right) =\sum_{1\leq j\leq 2r}\rho
_{bj}\left( v\right) \sigma _{bj}\left( w\right) .
\end{equation}
\end{theorem}

\begin{remark}
\begin{equation}
\sum_{1\leq j\leq 2r}\rho _{bj}\left( v\right) \sigma _{bj}\left( w\right)
=\left( \left. \rho \right\vert v\right) _{\rho \sigma }\left( \left. \sigma
\right\vert w\right) _{\rho \sigma }.
\end{equation}
\end{remark}

\begin{remark}
Note that $\left( \left. {}\right\vert \right) _{\rho \sigma }$ being non
degenerate still allows in particular 
\begin{equation}
\left( \left. v\right\vert v\right) _{\rho \sigma }=0
\end{equation}%
and in general 
\begin{equation}
\left( \left. v\right\vert v\right) _{\rho \sigma }=\left\{ 
\begin{array}{c}
>0 \\ 
=0 \\ 
<0%
\end{array}%
\right. .
\end{equation}
\end{remark}

\begin{lemma}
Non degenerate bilineear forms define inner products in $W.$
\end{lemma}

\begin{definition}
Dual vectors in terms of the inner product $\left( \left. {}\right\vert
\right) _{\rho \sigma }$ 
\begin{equation}
v_{d}=\left( v\right\vert _{\rho \sigma }
\end{equation}%
by 
\begin{equation}
\left( v\right\vert _{\rho \sigma }\left( w\right) =v_{d}\left( w\right)
=\left( \left. v\right\vert w\right) _{\rho \sigma },\quad \forall w\in W.
\end{equation}
\end{definition}

\begin{definition}
\textbf{\ }The orthogonal compliment to the vector $v$ is the subspace $%
W_{\left( \left. {}\right\vert \right) }^{\bot _{v}}$ which is defined as 
\begin{equation}
W_{\left( \left. {}\right\vert \right) }^{\bot _{v}}=\left\{ \left. \overset{%
}{w}\right\vert \left( \left. \overset{}{v}\right\vert w\right) _{\rho
\sigma }=0,w\in W\right\} .
\end{equation}
\end{definition}

\begin{remark}
Direct sum decomposition of $W$ in terms of orthogonal subspaces to a vector 
\begin{equation}
W=W_{\left( \left. {}\right\vert \right) }^{\bot _{v}}\oplus \left\{
v\right\}
\end{equation}
\end{remark}

\begin{definition}
The Invariance Group $G_{\rho \sigma }\subset $ $GL\left( W\right) $ of a
form $\left( \left. {}\right\vert \right) _{\rho \sigma }$ is defined by 
\begin{equation}
G_{\rho \sigma }=\left\{ \left. \overset{}{T\in GL\left( W\right) }%
\right\vert \left( \left. Tv\right\vert Tw\right) _{\rho \sigma }=\left(
\left. v\right\vert w\right) _{\rho \sigma }\right\} .
\end{equation}
\end{definition}

\begin{remark}
\begin{eqnarray}
\left( \left. Tv\right\vert Tw\right) _{\rho \sigma } &=&\sum_{1\leq j\leq
2r}\rho _{bj}\left( Tv\right) \sigma _{bj}\left( Tw\right) =\sum_{1\leq
j\leq 2r}d\left( T\right) \rho _{bj}\left( v\right) d\left( T\right) \sigma
_{bj}\left( w\right) \\
&=&\left( \overset{}{d\left( T\right) \otimes d\left( T\right) }\right)
\left( \sum_{1\leq j\leq 2r}\rho _{bj}\left( v\right) \sigma _{bj}\left(
w\right) \right) =\left( \left( \overset{}{d\left( T\right) \otimes d\left(
T\right) }\right) \left( \sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma
_{bj}\right) \right) \left( v\otimes w\right) =\left( \left. v\right\vert
w\right) _{\rho \sigma }
\end{eqnarray}%
i.e. 
\begin{equation}
\left( \overset{}{d\left( T\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj}\right) =\sum_{1\leq
j\leq 2r}\rho _{bj}\otimes \sigma _{bj},
\end{equation}%
so $a_{2d}=\sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj}$ is an
eigenvector of $\left( \overset{}{d\left( T\right) \otimes d\left( T\right) }%
\right) $ with eigenvalue $+1.$
\end{remark}

\begin{remark}
General transformations $\mathfrak{T}_{AB}\in \mathcal{L}\left( W^{d}\otimes
W^{d}\right) $ 
\begin{equation}
\mathfrak{T}_{AB}\mathfrak{:}W^{d}\otimes W^{d}\rightarrow W^{d}\otimes W^{d}
\end{equation}%
between dual tensors \label{transformation between dual tensors}%
\begin{equation}
b_{\mathbf{\rho \sigma }}=\mathbf{\rho }^{t}\mathbf{\sigma }=\left( 
\begin{array}{ccc}
\rho _{b1} & \cdots & \rho _{b2r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\sigma _{b1} \\ 
\vdots \\ 
\sigma _{b2r}%
\end{array}%
\right)
\end{equation}
is given by 
\begin{equation}
T_{\widetilde{\mathbf{\rho \sigma }}}=\widetilde{b_{\mathbf{\rho \sigma }}}=%
\mathfrak{T}_{AB}\left( b_{\mathbf{\rho \sigma }}\right) =\mathfrak{T}%
_{AB}\left( \sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma _{bj}\right)
=\sum_{1\leq j\leq 2r}A_{j}\rho _{bj}\otimes B_{j}\sigma _{bj}=\sum_{1\leq
j\leq 2r}\left( A_{j}\otimes B_{j}\right) \left( \rho _{bj}\otimes \sigma
_{bj}\right) .
\end{equation}
\end{remark}

\begin{remark}
All tensors $a_{2d}\in W^{d}\times $ $W^{d}$ can be expressed as 
\begin{equation}
a_{2d}=\sum_{1\leq j\leq \limfunc{Rank}\left( A_{2d}\right) }\rho
_{bj}\otimes \sigma _{bj}
\end{equation}%
for some $\left\{ \left. \rho _{bj},\sigma _{bj}\right\vert 1\leq j\leq 
\limfunc{Rank}\left( a_{2d}\right) \leq 2r\right\} $
\end{remark}

\begin{lemma}
If 
\begin{equation}
\limfunc{Rank}\left( a_{2d}\right) =2r
\end{equation}%
then $a_{2d}$ is \emph{non degenerate.}
\end{lemma}

\begin{remark}
The transformation 
\begin{equation}
\left( \left. T\cdot \right\vert T\cdot \right) _{\rho \sigma }=\left( 
\overset{}{d\left( T\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\left( \cdot \right) \sigma _{bj}\left( \cdot
\right) \right)
\end{equation}%
is a special case of the general transformation.
\end{remark}

\begin{remark}
$\left( \left. {}\right\vert \right) _{\rho \sigma }$-normalized vectors $v$
are given by 
\begin{equation}
\left( \left. v\right\vert v\right) _{\rho \sigma }=1,
\end{equation}%
where 
\begin{equation}
v=\frac{\left\vert \widetilde{v}\right) _{\rho \sigma }}{\sqrt{\left( \left. 
\widetilde{v}\right\vert \widetilde{v}\right) _{\rho \sigma }}}.
\end{equation}
\end{remark}

\begin{remark}
$\left( \left. {}\right\vert \right) _{\rho \sigma }$-normalized $v_{b}$ are
given by 
\begin{equation}
v_{b}=\frac{\left( \widetilde{v}\right\vert _{\rho \sigma }}{\sqrt{\left(
\left. \widetilde{v}\right\vert \widetilde{v}\right) _{\rho \sigma }}}.
\end{equation}
\end{remark}

\begin{lemma}
Let $T\in \mathcal{L}\left( W\right) $ then 
\begin{equation}
\left( \left. \cdot \right\vert \cdot \right) _{d\left( T\right) \left( \rho
\right) d\left( T\right) \left( \sigma \right) }=\left( \left. T\cdot
\right\vert T\cdot \right) _{\rho \sigma }.
\end{equation}

\begin{proof}
\begin{equation}
\left( \left. T\cdot \right\vert T\cdot \right) _{\rho \sigma }=\left( 
\overset{}{d\left( T\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\left( \cdot \right) \sigma _{bj}\left( \cdot
\right) \right) =\sum_{1\leq j\leq 2r}\left( \overset{}{d\left( T\right)
\left( \rho _{bj}\right) }\right) \left( \cdot \right) \left( \overset{}{%
d\left( T\right) \left( \sigma _{bj}\right) }\right) \left( \cdot \right)
=\sum_{1\leq j\leq 2r}\rho _{bj}\left( T\cdot \right) \sigma _{bj}\left(
T\cdot \right) .
\end{equation}
\end{proof}
\end{lemma}

\begin{definition}
The equivalence class of inner products $\left[ \left( \left. \cdot
\right\vert \cdot \right) _{\rho \sigma }\right] $ generated by the inner
product $\left( \left. \cdot \right\vert \cdot \right) _{\rho \sigma }$ is
defined by 
\begin{equation}
\left[ \left( \left. \cdot \right\vert \cdot \right) _{\rho \sigma }\right]
=\left\{ \left. \left( \left. \cdot \right\vert \cdot \right) _{\rho \sigma
}=\,\overset{}{\left( \left. T\cdot \right\vert T\cdot \right) _{\rho \sigma
}}\right\vert T\in \mathcal{L}\left( W\right) \right\}
\end{equation}%
so that 
\begin{equation}
\left( \left. \cdot \right\vert \cdot \right) _{\rho _{1}\sigma
_{1}}\thicksim \left( \left. \cdot \right\vert \cdot \right) _{\rho
_{2}\sigma _{2}}
\end{equation}%
if $\exists T\in \mathcal{L}\left( W\right) $ such that 
\begin{equation}
\left( \left. \cdot \right\vert \cdot \right) _{\rho _{2}\sigma _{2}}=\left(
\left. T\cdot \right\vert T\cdot \right) _{\rho _{2}\sigma _{2}}.
\end{equation}
\end{definition}

\begin{theorem}
All inner products on $W$ are given by 
\begin{equation}
\left( A\mathbf{\rho }\right) ^{t}\otimes \left( B\mathbf{\sigma }\right)
\equiv \left( A\mathbf{\rho }\right) ^{t}\left( B\mathbf{\sigma }\right) =%
\mathfrak{T}_{AB}\left( \sum_{1\leq j\leq 2r}\rho _{bj}\otimes \sigma
_{bj}\right) =\sum_{1\leq j\leq 2r}A_{j}\rho _{bj}\otimes B_{j}\sigma
_{bj}=\sum_{1\leq j\leq 2r}\left( A_{j}\otimes B_{j}\right) \left( \rho
_{bj}\otimes \sigma _{bj}\right) =\sum_{1\leq j\leq 2r}A_{j}\rho
_{bj}\otimes B_{j}\sigma _{bj}=\sum_{1\leq j\leq 2r}\left( A\rho \right)
_{bj}\otimes \left( B\sigma \right) _{bj}=\left( \left. \cdot \right\vert
\cdot \right) _{\left( A\rho \right) \left( B\sigma \right) },
\end{equation}%
where $A_{j},B_{j}\in \mathcal{L}\left( W^{d}\right) $
\end{theorem}

\begin{remark}
In particular transformations generated by \emph{decomposable elements} of $%
W^{d}\otimes W^{d}$ are given by 
\begin{equation}
\left( \left. S\cdot \right\vert T\cdot \right) _{\rho \sigma }=\left( 
\overset{}{d\left( S\right) \otimes d\left( T\right) }\right) \left(
\sum_{1\leq j\leq 2r}\rho _{bj}\left( \cdot \right) \sigma _{bj}\left( \cdot
\right) \right) =\sum_{1\leq j\leq 2r}\rho _{bj}\left( S\cdot \right) \sigma
_{bj}\left( T\cdot \right) .
\end{equation}
\end{remark}

\subsection{Biorthogonal Bases}

Let $\left\{ \left. e_{j}\right\vert 1\leq j\leq 2r\right\} $ be a basis of $%
W$ then the overlap matrix $\mathbb{S}_{ee}$ of the overlap operator $S_{ee}$
\begin{equation}
S_{ee}=\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right)
\end{equation}%
is 
\begin{equation}
\mathbb{S}_{ee}=\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}%
\right) _{\rho \sigma }=\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) .
\end{equation}

\begin{remark}
\begin{enumerate}
\item Using an inner product $\left( \left. \boldsymbol{\cdot }\right\vert 
\boldsymbol{\cdot }\right) $ the dual basis $\left( \boldsymbol{e}%
_{d}\right) $ to $\left( \boldsymbol{e}\right) $ is given by 
\begin{equation*}
\left( d\left( \boldsymbol{e}\right) \right) ^{t}=\left( \boldsymbol{e}%
\right\vert =\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \in \mathfrak{B}\left( W^{d}\right) .
\end{equation*}

\item The biorthogonal dual basis $\left( \boldsymbol{e}_{b}\right) $ wrt $%
\left( \left. \boldsymbol{\cdot }\right\vert \boldsymbol{\cdot }\right) $ is
given by%
\begin{equation*}
\left( b\left( \boldsymbol{e}\right) \right) ^{t}=\left( b\left( \boldsymbol{%
e}\right) \right\vert =\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}%
\right) ^{-1}\left( \boldsymbol{e}\right\vert =\left( 
\begin{array}{c}
\left( b\left( e\right) _{1}\right\vert \\ 
\vdots \\ 
\left( b\left( e\right) _{2r}\right\vert%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) .
\end{equation*}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation*}
\left\vert b\left( \boldsymbol{e}\right) \right) =\left\vert \boldsymbol{e}%
\right) \left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right)
^{-t}=\left( 
\begin{array}{ccc}
\left\vert b\left( e\right) _{1}\right) & \cdots & \left\vert b\left(
e\right) _{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) ^{\boldsymbol{-}t}
\end{equation*}
\end{remark}

\begin{remark}
The bases $\left( \boldsymbol{e}_{b}\right) $ and $\left( \boldsymbol{e}%
\right) $ are $\left( \left. \boldsymbol{\cdot }\right\vert \boldsymbol{%
\cdot }\right) $-biorthogonal as

\begin{enumerate}
\item 
\begin{equation}
\mathbb{I}_{2r}=\left( \left. \boldsymbol{e}_{b}\right\vert \boldsymbol{e}%
\right) =\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right)
^{-1}\left( \left. \boldsymbol{e}\right\vert \boldsymbol{e}\right)
\end{equation}%
and

\item 
\begin{equation*}
I_{2r}=\left\vert \boldsymbol{e}\right) \left( b\left( \boldsymbol{e}\right)
\right\vert =\left\vert \boldsymbol{e}\right) \left( \left. \boldsymbol{e}%
\right\vert \boldsymbol{e}\right) ^{-1}\left( \boldsymbol{e}\right\vert
\left( \boldsymbol{e}\right\vert =\left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) ^{\boldsymbol{-}1}\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right)
\end{equation*}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
\mathcal{R}_{e}\left( S_{ee}\right) =\mathcal{R}_{e}\left( \sum_{1\leq j\leq
2r}e_{j}\left[ d\left( e\right) _{j}\right] \right) =\left( \boldsymbol{e}%
_{b}\right\vert \left( \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \right] \right) \left\vert \boldsymbol{e}\right) =\left( \left. 
\boldsymbol{e}\right\vert \boldsymbol{e}\right) =\mathbb{S}_{ee}.
\end{equation}
\end{remark}

Using the bilinear form $\left( \left. {}\right\vert \right) $ one obtains
the following expansions for an operator $A\in \mathcal{L}\left( W\right) $

\begin{enumerate}
\item 
\begin{eqnarray}
A &=&\left\vert \boldsymbol{x}\right) \left( \boldsymbol{y}\right\vert
=\sum_{1\leq j\leq 2r}\left\vert x_{j}\right) \left( y_{j}\right\vert
=\left( 
\begin{array}{ccc}
\left\vert x_{1}\right) & \cdots & \left\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( y_{1}\right\vert \\ 
\vdots \\ 
\left( y_{2r}\right\vert%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) &=&\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
\left\vert x_{1}\right) & \cdots & \left\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( y_{1}\right\vert \\ 
\vdots \\ 
\left( y_{2r}\right\vert%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert x_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right)
\end{eqnarray}%
and the transpose $A^{t}$

\item 
\begin{eqnarray}
A^{t} &=&\left\vert \boldsymbol{y}\right) \left( \boldsymbol{x}\right\vert
=\sum_{1\leq j\leq 2r}\left\vert y_{j}\right) \left( x_{j}\right\vert
=\left( 
\begin{array}{ccc}
\left\vert y_{1}\right) & \cdots & \left\vert y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( x_{1}\right\vert \\ 
\vdots \\ 
\left( x_{2r}\right\vert%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A^{t}\right) &=&\left( 
\begin{array}{c}
\left( e_{1}\right\vert \\ 
\vdots \\ 
\left( e_{2r}\right\vert%
\end{array}%
\right) \left( \left( 
\begin{array}{ccc}
\left\vert y_{1}\right) & \cdots & \left\vert y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( x_{1}\right\vert \\ 
\vdots \\ 
\left( x_{2r}\right\vert%
\end{array}%
\right) \right) \left( 
\begin{array}{ccc}
\left\vert e_{1}\right) & \cdots & \left\vert e_{2r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert x_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right)
\end{eqnarray}

\item The representations are 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right)
\end{equation}

\begin{eqnarray}
\mathcal{R}_{e}\left( A^{t}\right) &=&\left( 
\begin{array}{ccc}
e_{b1}\left( y_{1}\right) & \cdots & e_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b2r}\left( y_{1}\right) & \cdots & e_{b2r}\left( y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
x_{b1}\left( e_{1}\right) & \cdots & x_{b1}\left( e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( e_{1}\right) & \cdots & x_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b1}\left( e_{2r}\right) & \cdots & y_{b2r}\left( e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e_{b1}\left( x_{1}\right) & \cdots & e_{b2r}\left( x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{b1}\left( x_{2r}\right) & \cdots & e_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) ,
\end{eqnarray}%
which can be recast as

\item 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{1}\right\vert x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{2r}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{1}\right\vert e_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{2r}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right)
\end{equation}%
\begin{eqnarray}
\mathcal{R}_{e}\left( A^{t}\right) &=&\left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert y_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert y_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert y_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert y_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. x_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
x_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. x_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
x_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \\
\mathcal{R}_{e}\left( A\right) ^{t} &=&\left( 
\begin{array}{ccc}
\left( \left. y_{1}\right\vert e_{1}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. y_{1}\right\vert e_{2r}\right) & \cdots & \left( \left.
y_{2r}\right\vert e_{2r}\right)%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left( \left. e_{1}\right\vert x_{1}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{1}\right) \\ 
\vdots & \ddots & \vdots \\ 
\left( \left. e_{1}\right\vert x_{2r}\right) & \cdots & \left( \left.
e_{2r}\right\vert x_{2r}\right)%
\end{array}%
\right) ,
\end{eqnarray}

\item \textbf{If the inner product is symmetric} then \textbf{\ }%
\begin{equation}
\mathbb{S}_{ee}=\mathbb{S}_{ee}^{t}
\end{equation}%
and \textbf{\ }%
\begin{equation}
\mathcal{R}_{e}\left( A^{t}\right) =\mathcal{R}_{e}\left( A\right) ^{t}
\end{equation}

\item \textbf{If the inner product is antisymmetric }then%
\begin{equation}
\mathbb{S}_{ee}=-\mathbb{S}_{ee}^{t}
\end{equation}%
\textbf{\ }
\end{enumerate}

\subsection{Symmetric and Antisymmetric Inner Products in $W$}

\subsubsection{\textbf{Symmetric Inner Products}}

\begin{theorem}
\begin{equation*}
s_{d}=\sum_{1\leq j,k\leq 2r}e_{bj}\otimes e_{bk}\mathcal{R}_{e_{b}}\left(
s_{d}\right) _{jk}=\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right)
_{j}b\left( u\right) _{j}\otimes b\left( u\right) _{j}=\sum_{1\leq j\leq
2r}\sigma \left( s_{d}\right) _{j}\left( u_{j}\right\vert \otimes \left(
u_{j}\right\vert ,
\end{equation*}%
where 
\begin{equation}
\mathcal{R}_{e_{b}}\left( s_{d}\right) _{jk}=\mathcal{R}_{e_{b}}\left(
s_{d}\right) _{kj},\quad 1\leq j,k\leq 2r
\end{equation}%
and 
\begin{equation}
\sigma \left( s_{d}\right) _{j}\neq 0\in \mathbb{R},\quad 1\leq j\leq 2r.
\end{equation}

\begin{proof}
This can be deduced as $\mathcal{R}_{e_{b}}\left( s_{d}\right) $ is a real
symmetric which can be transformed to a diagonal matrix $\mathbb{\mathcal{R}}%
_{\sigma \left( s_{d}\right) }\left( s_{d}\right) $ 
\begin{equation}
\mathbb{U}^{t}\mathcal{R}_{e_{b}}\left( s_{d}\right) \mathbb{U}\,\,\mathbb{=%
\mathcal{R}}_{\sigma \left( s_{d}\right) }\left( s_{d}\right) =\left( 
\begin{array}{cccc}
\mathbb{\mathcal{R}}_{\sigma \left( s_{d}\right) }\left( s_{d}\right) _{11}
& \cdots & 0 & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & \mathbb{\mathcal{R}}_{\sigma \left( s_{d}\right) }\left(
s_{d}\right) _{2r2r}%
\end{array}%
\right) .
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
s_{d}\left( v,w\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right)
_{j}b\left( u\right) _{j}\otimes b\left( u\right) _{j}\left( v\otimes
w\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}b\left(
u\right) _{j}\left( v\right) \otimes b\left( u\right) _{j}\left( w\right)
=\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}\left( \left.
u_{j}\right\vert v\right) \left( \left. u_{j}\right\vert w\right)
\end{equation}

\item 
\begin{equation}
s_{d}\left( w,v\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right)
_{j}b\left( u\right) _{j}\otimes b\left( u\right) _{j}\left( w\otimes
v\right) =\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}b\left(
u\right) _{j}\left( w\right) \otimes b\left( u\right) _{j}\left( v\right)
=\sum_{1\leq j\leq 2r}\sigma \left( s_{d}\right) _{j}\left( \left.
u_{j}\right\vert w\right) \left( \left. u_{j}\right\vert v\right) ,
\end{equation}%
which confirms $\left( \left. {}\right\vert \right) $ is symmetric i.e.%
\begin{equation}
s_{d}\left( v,w\right) =s_{d}\left( w,v\right) .
\end{equation}
\end{enumerate}
\end{remark}

\subsubsection{\textbf{Antisymmetric Inner Products}}

\begin{theorem}
\begin{eqnarray*}
a_{d} &=&\sum_{1\leq j,k\leq 2r}e_{bj}\otimes e_{bk}\mathcal{R}%
_{e_{b}}\left( a_{d}\right) _{jk}=\sum_{1\leq j\leq r}\sigma \left(
a_{d}\right) _{j}b\left( v\right) _{j}\wedge b\left( v\right) _{j+r} \\
&=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}%
\left\{ b\left( v\right) _{j}\otimes b\left( v\right) _{j+r}-b\left(
v\right) _{j+r}\otimes b\left( v\right) _{j}\right\} =\sum_{1\leq j\leq
r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}\left\{ \left(
v_{j}\right\vert \otimes \left( v_{j+r}\right\vert -\left(
v_{j+r}\right\vert \otimes \left( v_{j}\right\vert \right\} ,
\end{eqnarray*}%
where 
\begin{equation}
\mathcal{R}_{e_{b}}\left( a_{d}\right) _{jk}=-\mathcal{R}_{e_{b}}\left(
a_{d}\right) _{kj};\quad 1\leq j,k\leq 2r
\end{equation}%
and 
\begin{equation}
\sigma \left( a_{d}\right) _{j}\neq 0\in \mathbb{R},\quad 1\leq j\leq r.
\end{equation}
\end{theorem}

\begin{proof}
This can be deduced as $\mathcal{R}_{e_{b}}\left( a_{d}\right) $ is an even
dimensional real antisymmetric matrix which can be transformed to a
canonical antisymmetric matrix $\mathbb{\mathcal{R}}_{\sigma \left(
a_{d}\right) }\left( a_{d}\right) $ 
\begin{equation}
\mathbb{V}^{t}\mathcal{R}_{e_{b}}\left( a_{d}\right) \mathbb{V}\,\,\mathbb{=%
\mathcal{R}}_{\sigma \left( a_{d}\right) }\left( a_{d}\right) =\left( 
\begin{array}{cc}
\mathbb{O} & \left( 
\begin{array}{cccc}
\mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left( a_{d}\right) _{11}
& 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & \mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left(
a_{d}\right) _{rr}%
\end{array}%
\right) \\ 
\left( 
\begin{array}{cccc}
-\mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left( a_{d}\right) _{11}
& 0 & \cdots & 0 \\ 
0 & \ddots & \vdots & \vdots \\ 
\vdots & \cdots & \ddots & 0 \\ 
0 & \cdots & 0 & -\mathbb{\mathcal{R}}_{\sigma \left( a_{d}\right) }\left(
a_{d}\right) _{rr}%
\end{array}%
\right) & \mathbb{O}%
\end{array}%
\right)
\end{equation}
\end{proof}

These dual bilinear forms define inner products in $W.$

\begin{remark}
\begin{enumerate}
\item 
\begin{eqnarray}
a_{d}\left( v,w\right) &=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}%
\frac{1}{\sqrt{2}}\left\{ b\left( u\right) _{j}\otimes b\left( u\right)
_{j+r}-b\left( u\right) _{j+r}\otimes b\left( u\right) _{j}\right\} \left(
v\otimes w\right) \\
&=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}%
\left\{ b\left( u\right) _{j}\left( v\right) b\left( u\right) _{j+r}\left(
w\right) -b\left( u\right) _{j+r}\left( w\right) b\left( u\right) _{j}\left(
v\right) \right\} =\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1%
}{\sqrt{2}}\left\{ \left( \left. u_{j}\right\vert v\right) \left( \left.
u_{j+r}\right\vert w\right) -\left( \left. u_{j+r}\right\vert v\right)
\left( \left. u_{j}\right\vert w\right) \right\}
\end{eqnarray}

\item 
\begin{eqnarray}
a_{d}\left( w,v\right) &=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}%
\frac{1}{\sqrt{2}}\left\{ b\left( u\right) _{j}\otimes b\left( u\right)
_{j+r}-b\left( u\right) _{j+r}\otimes b\left( u\right) _{j}\right\} \left(
w\otimes v\right) \\
&=&\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1}{\sqrt{2}}%
\left\{ b\left( u\right) _{j}\left( w\right) b\left( u\right) _{j+r}\left(
v\right) -b\left( u\right) _{j+r}\left( v\right) b\left( u\right) _{j}\left(
w\right) \right\} =\sum_{1\leq j\leq r}\sigma \left( a_{d}\right) _{j}\frac{1%
}{\sqrt{2}}\left\{ \left( \left. u_{j}\right\vert w\right) \left( \left.
u_{j+r}\right\vert v\right) -\left( \left. u_{j+r}\right\vert w\right)
\left( \left. u_{j}\right\vert v\right) \right\}
\end{eqnarray}%
which confirms $\left( \left. {}\right\vert \right) $ is antisymmetric i.e.%
\begin{equation}
a_{d}\left( v,w\right) =-a_{d}\left( w,v\right) .
\end{equation}
\end{enumerate}
\end{remark}

\subsubsection{\textbf{Inner products in} $W$}

\begin{definition}
Symmetric Inner Products 
\begin{equation}
\left( \left. v\right\vert w\right) _{s}=s_{d}\left( v\otimes w\right)
=s_{d}\left( v,w\right)
\end{equation}
\end{definition}

\begin{definition}
Antisymmetric Inner Products 
\begin{equation}
\left\{ \left. v\right\vert w\right\} _{a}=a_{d}\left( v\otimes w\right)
=a_{d}\left( v,w\right)
\end{equation}
\end{definition}

\begin{definition}
Positive Definite Inner Products 
\begin{equation}
\left( \left. v\right\vert v\right) _{p}=s_{d}\left( v\otimes v\right)
=s_{d}\left( v,v\right) >0\,\forall v\in W
\end{equation}
\end{definition}

\begin{theorem}
$\left( \left. v\right\vert v\right) _{p}>0\,\forall v\in W$ $\Rightarrow
\left( \left. v\right\vert w\right) _{p}\neq 0\,\forall ,w\in W,v\in W.$
\end{theorem}

\begin{theorem}
Any inner product can be expressed as a sum of a symmetric and antisymmetric
inner products i.e. 
\begin{equation}
\left( \left. {}\right\vert \right) =\left( \left. {}\right\vert \right)
_{s}+\left( \left. {}\right\vert \right) _{a}.
\end{equation}
\end{theorem}

\begin{theorem}
An inner product $\left( \left. {}\right\vert \right) $ can have \textbf{no}
symmetry but still be positive.

\begin{proof}
Any second rank tensor can be expressed as a unique sum of a symmetric and
an antisymmetric tensor. thus 
\begin{equation}
\left( \left. {}\right\vert \right) =\left( \left. {}\right\vert \right)
_{s}+\left( \left. {}\right\vert \right) _{a}.
\end{equation}%
and observe that 
\begin{equation}
\left( \left. v\right\vert v\right) =\left( \left. v\right\vert v\right)
_{s}+\left( \left. v\right\vert v\right) _{a}=\left( \left. v\right\vert
v\right) _{s}\geq 0.
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
\begin{equation}
\left( 
\begin{array}{cc}
\mathbf{v} & \mathbf{v}%
\end{array}%
\right) \left( 
\begin{array}{cc}
\mathbb{O}_{r} & \mathbb{I}_{r} \\ 
-\mathbb{I}_{r} & \mathbb{O}_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{v} \\ 
\mathbf{v}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-\mathbf{v} & \mathbf{v}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathbf{v} \\ 
\mathbf{v}%
\end{array}%
\right) =0
\end{equation}
\end{remark}

\begin{remark}
The symmetric and antisymmetric parts of the matrix $\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) $ are 
\begin{eqnarray}
\frac{1}{2}\left( \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) +\left( 
\begin{array}{cc}
1 & 0 \\ 
2 & 1%
\end{array}%
\right) \right) &=&\left( 
\begin{array}{cc}
1 & 1 \\ 
1 & 1%
\end{array}%
\right) \\
\frac{1}{2}\left( \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) -\left( 
\begin{array}{cc}
1 & 0 \\ 
2 & 1%
\end{array}%
\right) \right) &=&\left( 
\begin{array}{cc}
0 & 1 \\ 
-1 & 0%
\end{array}%
\right) .
\end{eqnarray}
\end{remark}

\begin{example}
Consider the matrix 
\begin{equation}
\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right)
\end{equation}%
generated by the symmetric and antisymmetric parts 
\begin{equation}
\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) =\left( 
\begin{array}{cc}
1 & 1 \\ 
1 & 1%
\end{array}%
\right) +\left( 
\begin{array}{cc}
0 & 1 \\ 
-1 & 0%
\end{array}%
\right) .
\end{equation}%
as%
\begin{equation}
\left( 
\begin{array}{cc}
v_{1} & v_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
1 & 1 \\ 
1 & 1%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
v_{1}+v_{2} & v_{1}+v_{2}%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( v_{1}+v_{2}\right) ^{2}.
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{cc}
v_{1} & v_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
0 & 2 \\ 
-2 & 0%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( 
\begin{array}{cc}
-2v_{2} & 2v_{1}%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =0
\end{equation}%
hence 
\begin{equation}
\left( 
\begin{array}{cc}
v_{1} & v_{2}%
\end{array}%
\right) \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) \left( 
\begin{array}{c}
v_{1} \\ 
v_{2}%
\end{array}%
\right) =\left( v_{1}+v_{2}\right) ^{2}.
\end{equation}
\end{example}

\begin{example}
Even though $\left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) $ is\emph{\ positive definate} the determinant is negative!! i.e. 
\begin{equation}
\det \left\{ \left( 
\begin{array}{cc}
1 & 2 \\ 
0 & 1%
\end{array}%
\right) \right\} =-1.
\end{equation}
\end{example}

\begin{remark}
~For a real symmetric $n\times n$ matrix $A$, the following are equivalent:

\begin{enumerate}
\item $A$ is positive semidefinite:%
\begin{equation}
x^{t}Ax\geq 0\forall x\in \mathbb{R}^{n}
\end{equation}%
.

\item All eigenvalues of $A$ are $\geq 0$.

\item All principal minors of $A$ are $\geq 0$.
\end{enumerate}
\end{remark}

\begin{remark}
Sylvester's criterion does not apply to non-symmetric matrices. The
criterion requires a matrix to be symmetric (or Hermitian) to determine if
it is positive definite by checking that all of its leading principal minors
are positive. For a non-symmetric matrix, the condition for positive
definiteness is equivalent to its symmetric part 
\begin{equation}
A+A^{t}
\end{equation}
being positive definite, and this symmetric part can then be tested with
Sylvester's criterion.~
\end{remark}

\begin{theorem}
If $A$ is a real non symmetric matrix then $A$ is positive semidefinite $%
\limfunc{Iff}$ all the principal minors of the symmetric part of the $A$ are
positive.
\end{theorem}

\begin{theorem}
If $A$ is a real symmetric matrix then $A$ is positive semidefinite $%
\limfunc{Iff}$ the \textbf{leading }principal minors of $A$ are positive.
\end{theorem}

\subsection{Complex Units}

\begin{conjecture}
Any antisymmetric bilinear form $J_{d}\in W^{d}\otimes W^{d}$ thus belongs
to $W^{d}\wedge W^{d}$ and defines a complex unit $J\in \mathcal{L}\left(
W\right) $ by the mapping $W^{d}\otimes W^{d}\rightarrow W\otimes
W^{d}\rightarrow \mathcal{L}\left( W\right) .$
\end{conjecture}

Let $W$ be a real even dimensional vector spaces such that 
\begin{equation}
\dim \left\{ V\right\} =2r
\end{equation}%
and let $J\in \mathcal{L}\left( W\right) $ such that 
\begin{equation}
J^{2}=-I_{W}
\end{equation}%
then $J$ is called an imaginary unit.

Recall the resolutions of the identity 
\begin{gather}
I_{W}=\sum_{1\leq j\leq 2r}x_{j}\left[ x_{bj}\right] =\sum_{1\leq j\leq
2r}y_{j}\left[ y_{bj}\right] \\
\parallel \\
\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \\
\parallel \\
\left( \boldsymbol{x}\right) ^{t}\left( \left[ \boldsymbol{x}_{b}\right]
\right) =\left( \boldsymbol{y}\right) ^{t}\left( \left[ \boldsymbol{y}_{b}%
\right] \right) ,
\end{gather}%
where $\left\{ \left. x_{j}\right\vert 1\leq j\leq 2r\right\} $ and $\left\{
\left. y_{j}\right\vert 1\leq j\leq 2r\right\} $ are linearly independent
set of vectors belonging to $V$ and $\left\{ \left. x_{bj}\right\vert 1\leq
j\leq 2r\right\} $ and $\left\{ \left. y_{bj}\right\vert 1\leq j\leq
2r\right\} $ are linearly independent set of vectors belonging to $V^{d}.$

\subsubsection{\textbf{Representations}}

\begin{enumerate}
\item The change of basis $\left( \boldsymbol{x}\right) \rightarrow \left( 
\boldsymbol{y}\right) $ operator $S_{yx}$ is given by%
\begin{equation}
S_{yx}=\left( \boldsymbol{y}\right) ^{t}\left( \left[ \boldsymbol{x}_{b}%
\right] \right) ,
\end{equation}%
which has a matrix representation $\mathcal{R}_{x}\left( S_{yx}\right) $ wrt
the $\left( \boldsymbol{x}\right) $ basis given by 
\begin{equation}
\mathcal{R}_{x}\left( S_{yx}\right) =\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{y}\right) ^{t}\left( %
\left[ \boldsymbol{x}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( y_{1}\right) & \cdots & x_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( y_{1}\right) & \cdots & x_{b2r}\left( y_{2e}\right)%
\end{array}%
\right) .
\end{equation}

\item The change of basis $\left( \boldsymbol{y}\right) \rightarrow \left( 
\boldsymbol{x}\right) $ operator $S_{xy}$ is given by%
\begin{equation}
S_{xy}=\left( \boldsymbol{x}\right) ^{t}\left( \left[ \boldsymbol{y}_{b}%
\right] \right) ,
\end{equation}%
which has a matrix representation $\mathcal{R}_{y}\left( S_{xy}\right) $ wrt
the $\left( \boldsymbol{y}\right) $ basis given by 
\begin{equation}
\mathcal{R}_{y}\left( S_{xy}\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{x}\right) ^{t}\left( %
\left[ \boldsymbol{y}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
y_{b1}\left( x_{1}\right) & \cdots & y_{b1}\left( x_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
y_{b2r}\left( x_{1}\right) & \cdots & y_{b2r}\left( x_{2e}\right)%
\end{array}%
\right) .
\end{equation}

\item Note that 
\begin{eqnarray}
\mathcal{R}_{x}\left( S_{yx}\right) &=&\left[ \left( 
\begin{array}{c}
x_{b1} \\ 
\vdots \\ 
x_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{y}\right) ^{t}\left( %
\left[ \boldsymbol{x}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( y_{1}\right) & \cdots & x_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( y_{1}\right) & \cdots & x_{b2r}\left( y_{2e}\right)%
\end{array}%
\right) \\
\mathcal{R}_{y}\left( S_{yx}\right) &=&\left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{y}\right) ^{t}\left( %
\left[ \boldsymbol{x}_{b}\right] \right) }\right) \left( 
\begin{array}{ccc}
y_{1} & \cdots & y_{2r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
x_{b1}\left( y_{1}\right) & \cdots & x_{b1}\left( y_{2r}\right) \\ 
\vdots & \ddots & \vdots \\ 
x_{b2r}\left( y_{1}\right) & \cdots & x_{b2r}\left( y_{2e}\right)%
\end{array}%
\right)
\end{eqnarray}

i.e. the representations wrt the two bases are the same. 
\begin{equation}
\mathcal{R}_{x}\left( S_{yx}\right) =\mathcal{R}_{y}\left( S_{yx}\right) .
\end{equation}

\item These transformations are inverses of each other i.e. 
\begin{equation}
S_{yx}^{-1}=S_{xy}
\end{equation}

\item Recall 
\begin{equation}
S_{yx}\left( \boldsymbol{x}\right) ^{t}=\left( \boldsymbol{x}\right) ^{t}%
\mathcal{R}_{x}\left( S_{yx}\right)
\end{equation}%
and 
\begin{equation}
S_{xy}\left( \boldsymbol{y}\right) ^{t}=\left( \boldsymbol{y}\right) ^{t}%
\mathcal{R}_{y}\left( S_{xy}\right) .
\end{equation}
\end{enumerate}

\subsection{\textbf{Properties of Complex Units}}

\subsubsection{Negative Involutions Imply Antisymmetry}

\begin{enumerate}
\item By Greubs theorem $J$ can be expressed in Dyadic and SVD form as 
\begin{gather}
J=\left( \boldsymbol{x}\right) ^{t}\left[ \left( \boldsymbol{y}_{b}\right) %
\right] =\sum_{1\leq j\leq 2r}x_{j}\left[ y_{bj}\right] =\left( \boldsymbol{u%
}_{x}\right) ^{t}\mathcal{R}_{e}\left( \lambda _{xy}\right) \left[ \left( 
\boldsymbol{v}_{yb}\right) \right] =\sum_{1\leq j\leq 2r}u_{j}\mathcal{R}%
_{e}\left( \lambda _{xy}\right) _{j}\left[ v_{bj}\right] =\Xi
_{VV^{d}}\left( b_{\rho \sigma }\right) =U\lambda V=\left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( U_{x}\right) \mathcal{R}_{e}\left( \lambda
_{xy}\right) \mathcal{R}_{e}\left( V_{y}\right) \left[ \left( \boldsymbol{e}%
_{b}\right) \right] \\
\parallel \\
\left( 
\begin{array}{ccc}
x_{1} & \cdots & x_{2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
y_{b1} \\ 
\vdots \\ 
y_{b2r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
u_{x1} & \cdots & u_{x2r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( \lambda _{xy}\right) _{11} & \cdots & \mathbb{O} \\ 
\vdots & \ddots & \vdots \\ 
\mathbb{O} & \cdots & \mathcal{R}_{e}\left( \lambda _{xy}\right) _{2r2r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
v_{yb1} \\ 
\vdots \\ 
v_{yb2r}%
\end{array}%
\right) \right]
\end{gather}%
and

\item the representations of $J$ wrt the $\left( \boldsymbol{x}\right) $ and 
