\begin{enumerate}
\item Dual mappings produce transposed matrices \label{Dual mappings produce
transposed matrices} 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d\left( A\right) \right) =\left( 
\begin{array}{ccc}
y_{b1}\left( e_{1}\right) & \cdots & y_{b2r}\left( e_{1}\right) \\ 
