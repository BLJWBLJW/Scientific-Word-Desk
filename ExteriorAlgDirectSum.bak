\part{Exterior Algebra Over a Direct Sum}

The \emph{exterior algebra} $\mathcal{H}_{\mathcal{F}}={\huge \wedge}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  $ generated by the direct sum
$\mathcal{H}_{1}^{1}=\mathcal{H}^{1}\oplus\mathcal{H}^{1d}$ of the dual
Hilbert spaces $\mathcal{H}^{1},\mathcal{H}^{1d}$ is defined as
\begin{equation}
\mathcal{H}_{\mathcal{F}}={\huge \wedge}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
\left(
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq r}}
%EndExpansion
\left(
%TCIMACRO{\tbigwedge \nolimits^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \wedge%
%TCIMACRO{\tbigwedge \nolimits^{n-p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n-p}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  \right)  ,
\end{equation}
where
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left(
%TCIMACRO{\tbigwedge \nolimits^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  \wedge%
%TCIMACRO{\tbigwedge \nolimits^{n-p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n-p}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  \right)  .
\end{equation}
The exterior product "$\wedge$"
\begin{equation}
\wedge:\mathcal{H}_{\mathcal{F}}\times\mathcal{H}_{\mathcal{F}}\rightarrow
\mathcal{H}_{\mathcal{F}}%
\end{equation}
endowers the Hilbert space $\mathcal{H}_{\mathcal{F}}$ with an algebraic
structure and is the same as the exterior product in the exterior algebras
${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and ${\huge \wedge}\left(
\mathcal{H}^{1d}\right)  .$

\begin{notation}%
\begin{equation}
\mathcal{H}_{m}^{n}=\mathcal{H}^{n}\oplus\mathcal{H}^{md},\,0\leq n.m\leq r.
\end{equation}

\end{notation}

\begin{remark}
On homogeneous elements
\begin{equation}
w_{1}\wedge w_{2}=\left(  -1\right)  ^{pq}w_{2}\wedge w_{1},
\end{equation}
where
\begin{align}
p  &  =\deg\left(  w_{1}\right) \\
q  &  =\deg\left(  w_{2}\right)  .
\end{align}

\end{remark}

\begin{definition}
The tensor product of the exterior algebras ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  $ and ${\huge \wedge}\left(  \mathcal{H}^{1d}\right)
$
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ={\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)
\end{equation}
equipped with the mixed exterior product "$\cdot$" is the \emph{mixed exterior
algebra} ${\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  .$
\end{definition}

\subsubsection{Mixed Exterior Product}

\begin{definition}
\bigskip The mixed exterior product "$\cdot$"
\begin{equation}
\cdot:\left[  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \right]  \times\left[
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \right]  \rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
is defined by
\begin{equation}
\left(  A\otimes B^{d}\right)  \cdot\left(  C\otimes D^{d}\right)  =\left(
A\wedge C\right)  \otimes\left(  B^{d}\wedge D^{d}\right)  ,\quad
A,C\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)  ;\,B^{d},D^{d}%
\in{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{definition}

\begin{remark}
The mixed exterior algebra ${\huge \wedge}\left(  \mathcal{H}^{1}%
,\mathcal{H}^{1d}\right)  ={\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ is a graded algebra
that can be decomposed as
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ={\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits_{m}^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{m}^{n}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ,
\end{equation}
where
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits_{m}^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{m}^{n}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{n}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{n}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{m}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{m}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{remark}

\begin{definition}
On homogeneous elements the product "$\cdot"$ is defined by
\begin{equation}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes
y_{q_{2}}\right)  =\left(  x_{p_{1}}\wedge x_{p_{2}}\right)  \otimes\left(
y_{q_{1}}\wedge y_{q_{2}}\right)  ,
\end{equation}
where
\begin{gather}
p_{1}=\deg\left(  x_{p_{1}}\right) \\
p_{2}=\deg\left(  x_{p_{2}}\right) \\
q_{1}=\deg\left(  y_{q_{1}}\right) \\
q_{2}=\deg\left(  y_{q_{2}}\right)  ,
\end{gather}
which can be trivially extended to inhomogeneous elements.
\end{definition}

\begin{remark}%
\begin{equation}
\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert
\cdot\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}}\right\vert
=\left\vert x_{p_{1}}\wedge x_{p_{2}}\right\rangle \left\langle y_{q_{1}%
}\wedge y_{q_{2}}\right\vert ,
\end{equation}
where
\end{remark}

\begin{notation}%
\begin{align}
\left\vert A\right\rangle \left\langle B\right\vert  &  \equiv\left\vert
A\right\rangle \otimes\left\langle B\right\vert ,\\
\left\vert A\right\rangle  &  \in\mathcal{H}_{\mathcal{F}},\,\left\langle
B\right\vert \in\mathcal{H}_{\mathcal{F}}^{d}.
\end{align}

\end{notation}

\begin{remark}
As $\mathcal{H}_{\mathcal{F}}$ is a Hilbert space it is self dual i.e.
$\mathcal{H}_{\mathcal{F}}$ and $\mathcal{H}_{\mathcal{F}}^{d}$ are
isometrically isomorphic through the conjugate linear isomorphisms
\begin{align}
\mathcal{D}  &  :\mathcal{H}_{\mathcal{F}}\rightarrow\mathcal{H}_{\mathcal{F}%
}^{d}\\
\left\vert A^{d}\right\rangle  &  =\,\left\langle A^{{}}\right\vert
=\mathcal{D}\left(  \left\vert A^{{}}\right\rangle \right)  .
\end{align}
and
\begin{align}
\mathcal{D}^{-1}  &  :\mathcal{H}_{\mathcal{F}}^{d}\rightarrow\mathcal{H}%
_{\mathcal{F}}\\
\,\left\langle A^{{}}\right\vert  &  =\left\vert A^{d}\right\rangle
=\mathcal{D}^{-1}\left(  \left\vert A^{d}\right\rangle \right)  .
\end{align}

\end{remark}

In particular let
\begin{gather}
p_{2}=\deg\left(  x_{p_{2}}\right)  =1\\
q_{1}=\deg\left(  y_{q_{1}}\right)  =1\\
p_{1}=q_{2}=0
\end{gather}
then
\begin{equation}
\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \cdot\left\vert
x_{2}\right\rangle \left\langle \phi\right\vert =\left\vert \phi\wedge
x_{2}\right\rangle \left\langle y_{1}\wedge\phi\right\vert =\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert
\end{equation}
and
\begin{equation}
\left\vert x_{2}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert =\left\vert x_{2}\wedge
\phi\right\rangle \left\langle \phi\wedge y_{1}\ \right\vert =\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert .
\end{equation}


\begin{lemma}
For \emph{homogeneous} $w_{1}$ and $w_{2}$%
\begin{equation}
w_{1}\cdot w_{2}=\left(  -1\right)  ^{p_{1}p_{2}+q_{1}q_{2}}w_{2}\cdot w_{1},
\end{equation}
where
\begin{align}
w_{1}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{p_{2}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{2}}^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right) \\
w_{2}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{q_{2}}^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{2}}^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{q_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{align}

\end{lemma}

\begin{example}%
\begin{align}
w_{1}  &  =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert \in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{1}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right) \\
w_{2}  &  =\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \in%
%TCIMACRO{\tbigwedge \nolimits_{1}^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{1}^{0}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{1}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{1}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)
\end{align}
then
\begin{equation}
w_{1}\cdot w_{2}=\left(  -1\right)  ^{0+0}w_{2}\cdot w_{1}=w_{2}\cdot w_{1}%
\end{equation}
and
\begin{equation}
\left\vert x_{1}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert =\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert \cdot\left\vert x_{1}\right\rangle \left\langle
\phi\right\vert =\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert ,
\end{equation}
i.e.%
\begin{equation}
\left[  \left\vert x_{1}\right\rangle \left\langle \phi\right\vert ,\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert \right]  _{\cdot}=0.
\end{equation}

\end{example}

\begin{example}%
\begin{align}
w_{1}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left\langle \phi\right\vert \\
w_{2}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{0}^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{0}^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left\langle \phi\right\vert .
\end{align}
then
\begin{equation}
w_{1}\cdot w_{2}=\left(  -1\right)  ^{p_{1}p_{2}}w_{2}\cdot w_{1}=w_{2}\cdot
w_{1}.
\end{equation}
gives
\begin{align}
\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p_{1}}}\right\rangle
\left\langle \phi\right\vert \cdot\left\vert \psi_{k_{1}}\wedge\cdots
\wedge\psi_{k_{p_{2}}}\right\rangle \left\langle \phi\right\vert  &  =\left(
-1\right)  ^{p_{1}p_{2}}\left\vert \psi_{k_{1}}\wedge\cdots\wedge
\psi_{k_{p_{2}}}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p_{1}}}\right\rangle \left\langle
\phi\right\vert \\
&  \parallel\\
\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p_{1}}}\wedge
\psi_{k_{1}}\wedge\cdots\wedge\psi_{k_{p_{2}}}\right\rangle \left\langle
\phi\right\vert  &  =\left(  -1\right)  ^{p_{1}p_{2}}\left\vert \psi_{k_{1}%
}\wedge\cdots\wedge\psi_{k_{p_{2}}}\wedge\varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{p_{1}}}\right\rangle \left\langle \phi\right\vert \ .
\end{align}

\end{example}

\begin{example}%
\begin{align}
w_{1}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{p_{1}}^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{1}}^{0}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =\left\vert \phi
\right\rangle
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right) \\
w_{2}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{p_{2}}^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{2}}^{0}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =\left\vert \phi
\right\rangle
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)
\end{align}
then
\begin{equation}
w_{1}\cdot w_{2}=\left(  -1\right)  ^{p_{1}p_{2}}w_{2}\cdot w_{1}=w_{2}\cdot
w_{1}.
\end{equation}
gives
\begin{align}
\left\vert \phi\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{p_{1}}}\right\vert \cdot\left\vert \phi\right\rangle
\left\langle \psi_{k_{1}}\wedge\cdots\wedge\psi_{k_{p_{2}}}\right\vert  &
=\left(  -1\right)  ^{p_{1}p_{2}}\left\vert \phi\right\rangle \left\langle
\psi_{k_{1}}\wedge\cdots\wedge\psi_{k_{p_{2}}}\right\vert \cdot\left\vert
\phi\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{p_{1}}}\right\vert \\
&  \parallel\\
\left\vert \phi\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{p_{1}}}\wedge\psi_{k_{1}}\wedge\cdots\wedge\psi_{k_{p_{2}}%
}\right\vert  &  =\left(  -1\right)  ^{p_{1}p_{2}}\left\vert \phi\right\rangle
\left\langle \psi_{k_{1}}\wedge\cdots\wedge\psi_{k_{p_{2}}}\wedge
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p_{1}}}\right\vert \ .
\end{align}

\end{example}

\begin{lemma}
$%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  $ is generated by $\left\vert
\phi\right\rangle
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  $ and $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left\langle \phi\right\vert $
\end{lemma}

\begin{proof}%
\begin{gather}
\left\vert \phi\right\rangle \left\langle \varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{p_{1}}}\right\vert \cdot\left\vert \psi_{k_{1}}\wedge
\cdots\wedge\psi_{k_{p_{2}}}\right\rangle \left\langle \phi\right\vert
=\left\vert \psi_{k_{1}}\wedge\cdots\wedge\psi_{k_{p_{2}}}\right\rangle
\left\langle \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p_{1}}}\right\vert
\\
1\leq j_{1}<\cdots<j_{p_{1}}\leq r,1\leq k_{1}<\cdots<k_{p_{2}}\leq r,0\leq
p_{1}\leq r,0\leq p_{2}\leq r.
\end{gather}

\end{proof}

\begin{remark}
This shows $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  $ and thus $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  $ \emph{can be injected} into the
\emph{tensor product} $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  \equiv{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
$ and the injections \emph{generate} $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  $ by the "$\cdot"$ product$.$
\end{remark}

\begin{remark}
$%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)  $ and $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1d}\ \right)  $ can be injected into the \emph{direct
sum} ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \oplus{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  $ by first
\end{remark}

\begin{enumerate}
\item considering the injections $i_{\mathcal{H}^{1}},i_{\mathcal{H}^{1d}}$ of
each of the summands into the \emph{direct sum}%
\begin{align}
i_{\mathcal{H}^{1}}  &  :\mathcal{H}^{1}\rightarrow\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\\
i_{\mathcal{H}^{1d}}  &  :\mathcal{H}^{1d}\rightarrow\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}.
\end{align}


\item Then these injections can be extended to injections from the exterior
algebras generated by the dual subspaces to the exterior algebra generated by
the direct sum of these dual subspaces
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }  &  :{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\subset{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right) \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }  &  :{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\subset{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,
\end{align}
which are defined by the
\end{enumerate}

\begin{definition}
The action of the injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
},i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$ on basis elements
\begin{gather}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \right)  =\left(  \left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle ,0\right)
=\left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p}}\right\rangle +0=\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)  =\left(  0,\left\langle \varphi_{k_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \right)
=0+\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle
\varphi_{k_{q}}\right\vert =\left\langle \varphi_{k_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \\
1\leq j_{1}<\cdots<j_{p}\leq r;1\leq k_{1}<\cdots<k_{q}\leq r;0\leq p,q\leq r.
\end{gather}

\end{definition}

\begin{definition}
The induced map $\boxtimes\eta$
\begin{equation}
\boxtimes\eta:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \oplus
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)
\end{equation}
the extension of the map $\eta$%
\begin{equation}
\eta:\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
and injects the subspaces ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
,{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ into the tensor product
${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  $ 
\end{definition}

\begin{definition}
The linear injection $\eta$
\begin{equation}
\eta:\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
is defined by
\begin{equation}
\eta\left(  z\right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d},
\end{equation}
where, the projections $\pi_{\mathcal{H}^{1}}$ and $\pi_{\mathcal{H}^{1d}}$
\begin{align}
\pi_{\mathcal{H}^{1}} &  :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow
\mathcal{H}^{1}\\
\pi_{\mathcal{H}^{1d}} &  :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\rightarrow\mathcal{H}^{1d}%
\end{align}
are given by
\begin{align}
\pi_{\mathcal{H}^{1}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1}}\\
\pi_{\mathcal{H}^{1d}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1d}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1d}}.
\end{align}

\end{definition}

\begin{remark}%
\begin{gather}
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }=\left\vert \phi
\right\rangle \\
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }=\left\vert \phi
^{d}\right\rangle =\left\langle \phi\right\vert .
\end{gather}

\end{remark}

\begin{definition}
The injection $\eta$ from the direct sum $\mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}$ to the tensor product ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ extends to the map
$\boxtimes\eta$
\begin{equation}
\boxtimes\eta:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \oplus
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)
\end{equation}
from the dirct sum ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ of the exterior
algebras ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  ,{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  $ generated by the dual subspaces $\mathcal{H}%
^{1},\mathcal{H}^{1d}$ into their tensor product ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
$ by the
\end{definition}

\begin{definition}%
\begin{gather}
\boxtimes\eta\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge
\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  =\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \otimes\left\langle \phi\right\vert \equiv\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \left\langle \phi\right\vert \\
\boxtimes\eta\left(  \left\langle \varphi_{k_{1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \right)  =\left\vert
\phi\right\rangle \otimes\left\langle \varphi_{k_{1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \equiv\left\vert
\phi\right\rangle \left\langle \varphi_{k_{1}}\wedge\cdots\wedge\varphi
_{k_{q}}\right\vert \\
1\leq j_{1}<\cdots<j_{p}\leq r;1\leq k_{1}<\cdots<k_{q}\leq r;\,0\leq p,q\leq
r.
\end{gather}

\end{definition}

\begin{remark}
In particular%
\begin{align}
\boxtimes\eta\left(  \left\vert \varphi_{j}\right\rangle \right)   &
=\left\vert \varphi_{j}\right\rangle \otimes I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\equiv\left\vert \varphi_{j}\right\rangle
\left\langle \phi\right\vert \\
\boxtimes\eta\left(  \left\langle \varphi_{j}\right\vert \right)   &
=I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\otimes\left\langle
\varphi_{j}\right\vert \equiv\left\vert \phi\right\rangle \left\langle
\varphi_{j}\right\vert \\
1  &  \leq j\leq r.
\end{align}

\end{remark}

\begin{remark}
The linear injections $\eta$ and $\boxtimes\eta$ have \emph{different ranges
to} $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and $i_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }$.
\end{remark}

\begin{remark}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and
$i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }$ are linear maps into the
direct sum of the dual exterior algebras ${\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  {\normalsize \oplus}\left(  \mathcal{H}^{1d}\right)  $ i.e
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }  &  :{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  {\normalsize \oplus}\left(  \mathcal{H}^{1d}\right) \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }  &  :{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  {\normalsize \oplus}\left(  \mathcal{H}^{1d}\right)  .
\end{align}
\emph{ }
\end{remark}

\begin{lemma}
The injections $i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ and
$i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }$ are \emph{algebra
homomorphisms} wrt the product "$\wedge"$ in ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  ${\normalsize  and } ${\huge \wedge}\left(
\mathcal{H}^{1d}\right)  $ and the product "$\wedge"$ in ${\huge \wedge
}\left(  \mathcal{H}^{1}\right)  {\normalsize \oplus}\left(  \mathcal{H}%
^{1d}\right)  $ i.e.
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  A_{1}\wedge
\cdots\wedge A_{n}\right)  =\left(  i_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\left(  A_{1}\right)  \right)  \wedge\cdots\wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  A_{n}\right)
\right)
\end{equation}
and
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  A_{1}^{d}%
\wedge\cdots\wedge A_{n}^{d}\right)   &  =\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  A_{1}^{d}\right)  \right)  \wedge
\cdots\wedge\left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(
A_{n}^{d}\right)  \right)  \\
A_{1},\cdots,A_{n} &  \in\mathcal{H}^{1}\text{ and }A_{1}^{d},\cdots,A_{n}%
^{d}\in\mathcal{H}^{1d}.
\end{align}

\end{lemma}

\begin{proof}%
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \right)  =\left(  \left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  =\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{1}}\right\rangle \right)  \right)  \wedge\cdots\wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  \left\vert
\varphi_{j_{p}}\right\rangle \right)  \right)
\end{equation}
andn
\begin{equation}
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)  =\left\vert \phi\right\rangle \left(  \left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert \right)  =\left(  i_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\left(  \left\langle \varphi_{k_{1}}\right\vert \right)
\right)  \wedge\cdots\wedge\left(  i_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\left(  \left\langle \varphi_{k_{q}}\right\vert \right)
\right)  .
\end{equation}

\end{proof}

\begin{definition}
One can linearly inject the direct sum $\mathcal{H}^{1}\oplus\mathcal{H}^{1d}$
into the mixed exterior algebra ${\huge \wedge}\left(  \mathcal{H}%
^{1},\mathcal{H}^{1d}\right)  \equiv{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ by a map
$\eta$ defined by
\begin{equation}
\eta:\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\subset{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)
\end{equation}
given by
\begin{equation}
\eta\left(  z\right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d},
\end{equation}
where the projections $\pi_{\mathcal{H}^{1}}$ and $\pi_{\mathcal{H}^{1d}}$
\begin{align}
\pi_{\mathcal{H}^{1}}  &  :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\rightarrow\mathcal{H}^{1}\\
\pi_{\mathcal{H}^{1d}}  &  :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\rightarrow\mathcal{H}^{1d}%
\end{align}
are given by
\begin{align}
\pi_{\mathcal{H}^{1}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1}}\\
\pi_{\mathcal{H}^{1d}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1d}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1d}}.
\end{align}

\end{definition}

\begin{remark}%
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{H}^{p}\wedge\mathcal{H}^{\left(  n-p\right)  d}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{align}
\mathcal{H}^{0}\wedge\mathcal{H}^{nd}  &  =\mathcal{H}^{nd}\\
\mathcal{H}^{n}\wedge\mathcal{H}^{0d}  &  =\mathcal{H}^{n}.
\end{align}

\end{remark}

\begin{example}%
\begin{align}
{\huge \wedge}^{1}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq1}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq1}}
%EndExpansion
\mathcal{H}^{p}\wedge\mathcal{H}^{\left(  1-p\right)  d}=\mathcal{H}^{0}%
\wedge\mathcal{H}^{1d}\oplus\mathcal{H}^{1}\wedge\mathcal{H}^{0d}%
=\mathcal{H}^{1d}\oplus\mathcal{H}^{1}\\
{\huge \wedge}^{2}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)   &  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq2}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq2}}
%EndExpansion
\mathcal{H}^{p}\wedge\mathcal{H}^{\left(  2-p\right)  d}=\mathcal{H}^{0}%
\wedge\mathcal{H}^{2d}\oplus\mathcal{H}^{1}\wedge\mathcal{H}^{1d}%
\oplus\mathcal{H}^{2}\wedge\mathcal{H}^{0d}=\left[  \mathcal{H}^{2d}\right]
\oplus\left[  \mathcal{H}^{1}\wedge\mathcal{H}^{1d}\right]  \oplus\left[
\mathcal{H}^{2}\right]  .
\end{align}

\end{example}

\begin{definition}
One can extend the projections $\pi_{\mathcal{H}^{1}}$ and $\pi_{\mathcal{H}%
^{1d}}$ to projections $\left\{  \pi_{\mathcal{H}^{n}\mathcal{H}^{d0}}%
,\pi_{\mathcal{H}^{n-1}\mathcal{H}^{d1}},\cdots,\pi_{\mathcal{H}%
^{n-p}\mathcal{H}^{dp}},,\cdots,\pi_{\mathcal{H}^{0}\mathcal{H}^{dn}}\right\}
,$ where
\begin{equation}
\pi_{\mathcal{H}^{n-p}\mathcal{H}^{dp}}:{\huge \wedge}^{n}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow\mathcal{H}%
^{n-p}\wedge\mathcal{H}^{dp}%
\end{equation}
for
\begin{equation}
0\leq p\leq n,
\end{equation}
defined on conb's by
\begin{align}
\pi_{\mathcal{H}^{n-p}\mathcal{H}^{dp}}\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{m-p}}\right\rangle
\wedge\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle
\varphi_{k_{p}}\right\vert \right)   &  =\left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{n-p}}\right\rangle
\wedge\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle
\varphi_{k_{p}}\right\vert \delta_{mn}\\
0  &  \leq p\leq n,0\leq m,n\leq r.
\end{align}

\end{definition}

\begin{remark}
The injection $\eta$ from the direct sum $\mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}$ to the mixed exterior algebra ${\huge \wedge}\left(  \mathcal{H}%
^{1},\mathcal{H}^{1d}\right)  $ can be extended to the map $\boxtimes\eta$
\begin{equation}
\boxtimes\eta:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \oplus
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)
\end{equation}
from the dirct sum ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ of the exterior
algebras generated by the dual subspaces $\mathcal{H}^{1},\mathcal{H}^{1d}$
into the exterior algebra ${\huge \wedge}\left(  \mathcal{H}^{1}%
,\mathcal{H}^{1d}\right)  $ defined by
\end{remark}

\begin{definition}%
\begin{gather}
\boxtimes\eta\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge
\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  =\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \otimes\left\langle \phi\right\vert \equiv\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \left\langle \phi\right\vert \\
\boxtimes\eta\left(  \left\langle \varphi_{k_{1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \right)  =\left\vert
\phi\right\rangle \otimes\left\langle \varphi_{k_{1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \equiv\left\vert
\phi\right\rangle \left\langle \varphi_{k_{1}}\wedge\cdots\wedge\varphi
_{k_{q}}\right\vert \\
1\leq j_{1}<\cdots<j_{p}\leq r;1\leq k_{1}<\cdots<k_{q}\leq r;\,0\leq p,q\leq
r.
\end{gather}

\end{definition}

\begin{lemma}
The set $\left\{  \left.  \overset{}{\left\vert \varphi_{j_{1}}\right\rangle
\left\langle \phi\right\vert ,\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\right\vert }\right\vert 1\leq j_{1},k_{1}\leq r\right\}  $
generates ${\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  $
through exterior multiplication $"\cdot".$
\end{lemma}

\begin{proof}%
\begin{gather}
\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle
\left\langle \phi\right\vert \cdot\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert =\left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \left\langle
\varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert \\
1\leq j_{1}<\cdots<j_{p}\leq r;1\leq k_{1}<\cdots<k_{q}\leq r;\,0\leq p,q\leq
r.
\end{gather}

\end{proof}

\begin{lemma}
$\boxtimes\eta$ is an algebra homomorphism \emph{when}\underline{\emph{
restricted to}} ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and
${\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ wrt the product "$\wedge"$
in ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and ${\huge \wedge}\left(
\mathcal{H}^{1d}\right)  $ and the product "$\cdot"$ in ${\huge \wedge}\left(
\mathcal{H}^{1},\mathcal{H}^{1d}\right)  .$
\end{lemma}

\begin{proof}%
\begin{align}
\boxtimes\eta\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge
\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)   &  =\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \otimes\left\langle \phi\right\vert \equiv\left\vert
\varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \left\langle
\phi\right\vert =\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\phi\right\vert \cdot\cdots\cdot\left\vert \varphi_{j_{p}}\right\rangle
\left\langle \phi\right\vert \\
&  =\eta\left(  \left\vert \varphi_{j_{1}}\right\rangle \right)  \cdot
\cdots\cdot\eta\left(  \left\vert \varphi_{j_{p}}\right\rangle \right)
=\boxtimes\eta\left(  \left\vert \varphi_{j_{1}}\right\rangle \right)
\cdot\cdots\cdot\boxtimes\eta\left(  \left\vert \varphi_{j_{p}}\right\rangle
\right)
\end{align}
and
\begin{align}
\boxtimes\eta\left(  \left\langle \varphi_{k_{1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \right)   &  =\left\vert
\phi\right\rangle \otimes\left\langle \varphi_{k_{1}}\wedge\cdots\wedge
\varphi_{k_{q}}\right\vert \equiv\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert =\left\vert
\phi\right\rangle \left\langle \varphi_{k_{1}}\right\vert \cdot\cdots
\cdot\left\vert \phi\right\rangle \left\langle \varphi_{k_{q}}\right\vert \\
&  =\eta\left(  \left\langle \varphi_{k_{1}}\right\vert \right)  \cdot
\cdots\cdot\eta\left(  \left\langle \varphi_{k_{q}}\right\vert \right)
=\boxtimes\eta\left(  \left\langle \varphi_{k_{1}}\right\vert \right)
\cdot\cdots\cdot\boxtimes\eta\left(  \left\langle \varphi_{k_{q}}\right\vert
\right)
\end{align}
for
\begin{equation}
1\leq j_{1}<\cdots<j_{p}\leq r;1\leq k_{1}<\cdots<k_{q}\leq r;\,0\leq p,q\leq
r.
\end{equation}

\end{proof}

\begin{definition}%
\begin{equation}
\boxtimes\eta:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \oplus
{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)
\end{equation}
by%
\begin{align}
&  \left.  \boxtimes\eta\left(  Z_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }+Z_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)
\right.  =\boxtimes\eta\left(  Z_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\right)  +\boxtimes\eta\left(  Z_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right) \\
&  \left.  =\right.  \boxtimes\eta\left(  \sum_{0\leq p\leq r}\sum_{1\leq
j_{1}<\cdots<j_{p}\leq r}Z_{j_{1}\cdots j_{p}}\left\vert \varphi_{j_{1}}%
\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \right)  +\boxtimes\eta\left(
\sum_{0\leq q\leq r}\sum_{1\leq k_{1}<\cdots<k_{q}\leq r}Z^{k_{1}\cdots k_{q}%
}\left\langle \varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert
\right) \\
&  \left.  =\right.  \left(  \sum_{0\leq p\leq r}\sum_{1\leq j_{1}%
<\cdots<j_{p}\leq r}Z_{j_{1}\cdots j_{p}}\left\vert \eta\left(  \varphi
_{j_{1}}\right)  \cdot\cdots\cdot\eta\left(  \varphi_{j_{p}}\right)
\right\rangle \right)  +\left(  \sum_{0\leq q\leq r}\sum_{1\leq k_{1}%
<\cdots<k_{q}\leq r}Z^{k_{1}\cdots k_{q}}\left\langle \eta\left(
\varphi_{k_{1}}\right)  \cdot\cdots\cdot\eta\left(  \varphi_{k_{q}}\right)
\right\vert \right)  .
\end{align}

\end{definition}

\begin{remark}
$\boxtimes\eta$ \emph{is an algebra homomorphism} on ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  \oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
.$
\end{remark}

\begin{remark}
$\boxtimes\eta$ \emph{is NOT an algebra homomorphism} on ${\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .$
\end{remark}

\subsubsection{Skew Product}

\begin{definition}
The tensor algebras $%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  $ and $%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  $ can be equipped with a \emph{skew product}
"$@$" i.e.
\begin{align}
@  &  :%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \times%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right)  \rightarrow%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{1}\right) \\
@  &  :%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  \times%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)  \rightarrow%
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion
\left(  \mathcal{H}^{d1}\right)
\end{align}
defined by
\begin{align}
x_{p_{1}}@x_{p_{2}}  &  =\left(  -1\right)  ^{p_{1}p_{2}}x_{p_{2}}\otimes
x_{p_{1}},\quad x_{p_{1}}\in\mathcal{H}^{p_{1}},\quad x_{p_{2}}\in
\mathcal{H}^{p_{2}}\\
x_{p_{1}}^{d}@x_{p_{2}}^{d}  &  =\left(  -1\right)  ^{p_{1}p_{2}}x_{p_{2}}%
^{d}\otimes x_{p_{1}}^{d},\quad x_{p_{1}}^{d}\in\mathcal{H}^{dp_{1}},\quad
x_{p_{2}}^{d}\in\mathcal{H}^{dp_{2}}.
\end{align}

\end{definition}

\begin{definition}
\emph{Skew Tensor Product: }The tensor product space
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  ={\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)
\end{equation}
of the dual exterior algebras ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $
and ${\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ can be equipped with a
\emph{skew product} "$@$"%
\begin{equation}
@:\left[  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  \right]  \times\left[  {\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\right]  \rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  ,
\end{equation}
defined on \emph{homogeneous} elements by
\begin{equation}
\left(  x_{p_{1}}\wedge y_{q_{1}}^{d}\right)  @\left(  x_{p_{2}}\wedge
y_{q_{2}}^{d}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge
x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  ,
\end{equation}
to produce the \emph{Skew Tensor} product mixed exterior algebra
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{definition}

\begin{lemma}
In ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $
\begin{equation}
w_{1}@w_{2}=\left(  -1\right)  ^{\left(  p_{1}+p_{2}\right)  \left(
q_{1}+q_{2}\right)  }w_{2}@w_{1},
\end{equation}
where
\begin{align}
w_{1}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{p_{2}}^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{p_{2}}^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{p_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right) \\
w_{2}  &  \in%
%TCIMACRO{\tbigwedge \nolimits_{q_{2}}^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{q_{2}}^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigwedge \nolimits^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\ \right)
%TCIMACRO{\tbigotimes }%
%BeginExpansion
{\textstyle\bigotimes}
%EndExpansion%
%TCIMACRO{\tbigwedge \nolimits^{q_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1d}\right)  .
\end{align}

\end{lemma}

\begin{remark}
If $\left(  p_{1}+p_{2}\right)  $ or $\left(  q_{1}+q_{2}\right)  $ are even
then
\begin{equation}
w_{1}@w_{2}=w_{2}@w_{1}.
\end{equation}

\end{remark}

\begin{example}%
\begin{equation}
\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}}\right\vert
@\left\vert x_{p_{2}}\right\rangle \left\langle y_{q_{2}}\right\vert =\left(
-1\right)  ^{p_{2}q_{1}}\left\vert x_{p_{1}}\wedge x_{p_{2}}\right\rangle
\left\langle y_{q_{1}}\wedge y_{q_{2}}\right\vert
\end{equation}
in particular let
\begin{gather}
p_{2}=\deg\left(  x_{p_{2}}\right)  =1\\
q_{1}=\deg\left(  y_{q_{1}}\right)  =1\\
p_{1}=q_{2}=0
\end{gather}
then
\begin{equation}
\left\vert \phi\right\rangle \left\langle y_{1}\right\vert @\left\vert
x_{2}\right\rangle \left\langle \phi\right\vert =-\left\vert \phi\wedge
x_{2}\right\rangle \left\langle y_{1}\wedge\phi\right\vert =-\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert
\end{equation}
and
\begin{equation}
\left\vert x_{2}\right\rangle \left\langle \phi\right\vert @\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert =\left\vert x_{2}\wedge
\phi\right\rangle \left\langle \phi\wedge y_{1}\ \right\vert =\left\vert
x_{2}\right\rangle \left\langle y_{1}\right\vert ,
\end{equation}
hence
\begin{equation}
\left\{  \left\vert x_{2}\right\rangle \left\langle \phi\right\vert
,\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \right\}  _{@}=0.
\end{equation}

\end{example}

\begin{remark}
On \emph{homogeneous elements} the \emph{skew product} "$@$" and the exterior
algebra product "$\cdot$" in ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ are related by
\begin{equation}
\left(  \overset{}{x_{p_{1}}\wedge y_{q_{1}}}\right)  @\left(
\overset{}{x_{p_{2}}\wedge y_{q_{2}}}\right)  =\left(  -1\right)  ^{p_{2}%
q_{1}}\left(  \overset{}{x_{p_{1}}\wedge y_{q_{1}}}\right)  \cdot\left(
\overset{}{x_{p_{2}}\wedge y_{q_{2}}}\right)  .
\end{equation}

\end{remark}

\begin{remark}
Due to the $\left(  -1\right)  ^{p_{2}q_{1}}$ factor associated with the
product "$\cdot$" $\boxtimes\eta$ is not an algebra homomorphism
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)
\end{equation}
(though it is a linear injection) \emph{but it is an algebra homomorphism}
\begin{equation}
\boxtimes\eta:{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
wrt the products "$\wedge"$ and "@" in ${\huge \wedge}\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  $ and ${\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $
respectively. 
\end{remark}

\subsubsection{The inverse $\digamma=\left(  \boxtimes\eta\right)  ^{-1}$ of
$\boxtimes\eta$}

\begin{definition}
A linear map $\digamma$ from the skew tensor product of the dual exterior
algebras ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and ${\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  $
\begin{equation}
\digamma:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
can be defined as
\begin{equation}
\digamma\left(  u\otimes v^{d}\right)  =\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  v^{d}\right)
\right)  ;\quad u\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)  ,v^{d}%
\in{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{definition}

\begin{lemma}
The map $\digamma$
\begin{equation}
\digamma:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,
\end{equation}
\emph{is an algebra homomorphism} wrt the products "$\wedge"$ and "@" in
${\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  $ and
${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes}{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  $ respectively i.e.%
\begin{equation}
\digamma\left(  X@Y\right)  =\digamma\left(  X\right)  \wedge\digamma\left(
Y\right)  ,\quad X,Y\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}

\end{lemma}

\begin{proof}
Noting

\begin{enumerate}
\item The connection between the "@" and "$\cdot"$products
\begin{equation}
\left(  x_{p_{1}}\wedge y_{q_{1}}\right)  @\left(  x_{p_{2}}\wedge y_{q_{2}%
}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge x_{p_{2}%
}\right)  \cdot\left(  y_{q_{1}}\wedge y_{q_{2}}\right)  .
\end{equation}


\item The commutation properties of $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  $
\begin{equation}
y_{q_{1}}\wedge x_{p_{2}}=\left(  -1\right)  ^{p_{2}q_{1}}x_{p_{2}}\wedge
y_{q_{1}},\quad x_{p_{2}}\in%
%TCIMACRO{\tbigwedge \nolimits^{p_{2}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p_{2}}}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  ,\,y_{q_{1}}\in%
%TCIMACRO{\tbigwedge \nolimits^{q_{1}}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q_{1}}}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}


\item The injections of ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  $ and
${\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ into ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  \oplus{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
$
\begin{align}
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x\wedge y\right)
&  =i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x\right)  \wedge
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  y\right)
;\,\,x,y\in{\huge \wedge}\left(  \mathcal{H}^{1}\right) \\
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  x^{d}\wedge
y^{d}\right)   &  =i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(
x^{d}\right)  \wedge i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\left(  y^{d}\right)  ;\,\,x^{d},y^{d}\in{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  .
\end{align}


\item The injection of ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ into ${\huge \wedge
}\left(  \mathcal{H}^{1}\right)  \wedge{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  \subset{\huge \wedge}\left(  \mathcal{H}^{1}\oplus
\mathcal{H}^{1d}\right)  $%
\begin{equation}
\digamma\left(  u\otimes v^{d}\right)  =\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  u\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  v^{d}\right)
\right)  .
\end{equation}


\item $\digamma$ is an algebra homomorphism
\begin{equation}
\digamma:{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\end{equation}
wrt "$@"$ and "$\wedge"$ as
\begin{gather}
\digamma\left(  \overset{}{\left(  x_{p_{1}}\otimes y_{q_{1}}^{d}\right)
@\left(  x_{p_{2}}\otimes y_{q_{2}}^{d}\right)  }\right)  =\digamma\left(
\overset{}{\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge x_{p_{2}%
}\right)  \otimes\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  }\right) \\
\parallel\\
\left(  -1\right)  ^{p_{2}q_{1}}\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  x_{p_{1}}\wedge x_{p_{2}}\right)  \right)
{\Large \wedge}\left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  \right) \\
=\left(  -1\right)  ^{p_{2}q_{1}}\left(  \left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\left(  x_{p_{1}}\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(  x_{p_{2}}\right)
\right)  \right)  {\Large \wedge}\left(  \left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  y_{q_{1}}^{d}\right)  \right)  \wedge\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  y_{q_{2}}%
^{d}\right)  \right)  \right) \\
=\left(  \left(  i_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\left(
x_{p_{1}}\right)  \right)  {\Large \wedge}\left(  i_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\left(  y_{q_{1}}^{d}\right)  \right)  \right)
{\Large \wedge}\left(  \left(  i_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\left(  x_{p_{2}}\right)  \right)  {\Large \wedge}\left(
i_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\left(  y_{q_{2}}%
^{d}\right)  \right)  \right) \\
\parallel\\
\digamma\left(  x_{p_{1}}@y_{q_{1}}^{d}\right)  {\Large \wedge}\digamma\left(
x_{p_{2}}@y_{q_{2}}^{d}\right) \\
\quad x_{p_{1}}\in{\huge \wedge}^{p_{1}}\left(  \mathcal{H}^{1}\right)
,x_{p_{2}}\in{\huge \wedge}^{p_{2}}\left(  \mathcal{H}^{1}\right)  ,\quad
y_{q_{1}}^{d}\in{\huge \wedge}^{q_{1}}\left(  \mathcal{H}^{1d}\right)
,y_{q_{2}}^{d}\in{\huge \wedge}^{q_{2}}\left(  \mathcal{H}^{1d}\right)  ,
\end{gather}
i.e.
\begin{equation}
\digamma\left(  \overset{}{\left(  x_{p_{1}}\otimes y_{q_{1}}^{d}\right)
@\left(  x_{p_{2}}\otimes y_{q_{2}}^{d}\right)  }\right)  =\digamma\left(
\overset{}{x_{p_{1}}@y_{q_{1}}^{d}}\right)  {\Large \wedge}\digamma\left(
\overset{}{x_{p_{2}}@y_{q_{2}}^{d}}\right)  .
\end{equation}


\item Recall the
\end{enumerate}
\end{proof}

\begin{definition}
of the linear injection $\eta$
\begin{equation}
\eta:\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \,\widehat{\otimes}\,{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  \overset{linear}{\cong}{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\end{equation}
given by
\begin{equation}
\eta\left(  z\right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d},
\end{equation}
where the projections $\pi_{\mathcal{H}^{1}}$ and $\pi_{\mathcal{H}^{1d}}$
\begin{align}
\pi_{\mathcal{H}^{1}}  &  :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\rightarrow\mathcal{H}^{1}\\
\pi_{\mathcal{H}^{1d}}  &  :\mathcal{H}^{1}\oplus\mathcal{H}^{1d}%
\rightarrow\mathcal{H}^{1d}%
\end{align}
are given by
\begin{align}
\pi_{\mathcal{H}^{1}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1}}\\
\pi_{\mathcal{H}^{1d}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1d}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1d}}.
\end{align}

\end{definition}

\begin{example}%
\begin{align}
\eta\left(  x_{1}+y_{1}^{d}\right)   &  =x_{1}\otimes I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes y_{1}^{d}\\
&  =\left\vert x_{1}\right\rangle \otimes\left\langle \phi\right\vert
+\left\vert \phi\right\rangle \otimes\left\langle y_{1}\right\vert \\
&  =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert .
\end{align}

\end{example}

The action of the induced map $\boxtimes\left(  \eta\right)  $ on

\begin{example}
\begin{enumerate}
\item the "$@"$ product
\begin{align}
&  \eta\left(  x_{1}+y_{1}^{d}\right)  @\eta\left(  x_{1}+y_{1}^{d}\right)
=\left(  \left\vert x_{1}\right\rangle \left\langle \phi\right\vert
+\left\vert \phi\right\rangle \left\langle y_{1}\right\vert \right)  @\left(
\left\vert x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert \right) \\
&  =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert @\left\vert
x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert @\left\vert x_{1}\right\rangle \left\langle
\phi\right\vert +\left\vert x_{1}\right\rangle \left\langle \phi\right\vert
@\left\vert \phi\right\rangle \left\langle y_{1}\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert @\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert =-\left\vert x_{1}\right\rangle \left\langle
y_{1}\right\vert +\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert
=0.
\end{align}


\item the "$\cdot"$ product%
\begin{align}
&  \eta\left(  x_{1}+y_{1}^{d}\right)  \cdot\eta\left(  x_{1}+y_{1}%
^{d}\right)  =\left(  \left\vert x_{1}\right\rangle \left\langle
\phi\right\vert +\left\vert \phi\right\rangle \left\langle y_{1}\right\vert
\right)  \cdot\left(  \left\vert x_{1}\right\rangle \left\langle
\phi\right\vert +\left\vert \phi\right\rangle \left\langle y_{1}\right\vert
\right) \\
&  =\left\vert x_{1}\right\rangle \left\langle \phi\right\vert \cdot\left\vert
x_{1}\right\rangle \left\langle \phi\right\vert +\left\vert \phi\right\rangle
\left\langle y_{1}\right\vert \cdot\left\vert x_{1}\right\rangle \left\langle
\phi\right\vert +\left\vert x_{1}\right\rangle \left\langle \phi\right\vert
\cdot\left\vert \phi\right\rangle \left\langle y_{1}\right\vert +\left\vert
\phi\right\rangle \left\langle y_{1}\right\vert \cdot\left\vert \phi
\right\rangle \left\langle y_{1}\right\vert \\
&  =\left\vert x_{1}\right\rangle \left\langle y_{1}\right\vert +\left\vert
x_{1}\right\rangle \left\langle y_{1}\right\vert =2\left(  \left\vert
x_{1}\right\rangle \left\langle y_{1}\right\vert +\left\vert x_{1}%
\right\rangle \left\langle y_{1}\right\vert \right)  .
\end{align}

\end{enumerate}
\end{example}

\begin{lemma}%
\begin{equation}
\eta\left(  z\right)  @\eta\left(  z\right)  =0,\quad z\in\mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}.
\end{equation}

\end{lemma}

\begin{proof}%
\begin{align}
\eta\left(  z\right)  @\eta\left(  z\right)   &  =\left(  \overset{}{\pi
_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)
}\right)  @\left(  \overset{}{\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}+I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z\right)  }\right) \\
&  =\left[  \overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)
@\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]  +\left[
\overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  @\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z\right)  \right)  }\right] \\
&  +\left[  \overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)
\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]  +\left[
\overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }%
\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \right)  @\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z\right)  \right)  }\right] \\
&  =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \right)  \otimes\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z\right)  \wedge I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right)  \otimes\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(
z\right)  \right) \\
&  -\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z\right)  \right)  \otimes\left(
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\wedge I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\right)  \otimes\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z\right)  \wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z\right)  \right) \\
&  =0
\end{align}

\end{proof}

\begin{remark}%
\begin{equation}
z\wedge z=\left(  -1\right)  ^{1}z\wedge z=0,\quad z\in\mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}.
\end{equation}

\end{remark}

\begin{remark}
The tensor product of the exterior algebras ${\huge \wedge}\left(
\mathcal{H}^{1}\right)  $ and ${\huge \wedge}\left(  \mathcal{H}^{d1}\right)
$ can be expanded as
\begin{align}
&  {\huge \wedge}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(
\mathcal{H}^{d1}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq m\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m\leq r}}
%EndExpansion
{\huge \wedge}^{m}\mathcal{H}\otimes%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\huge \wedge}^{n}\mathcal{H}^{d1}=%
%TCIMACRO{\tbigoplus \limits_{0\leq m,n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq m,n\leq r}}
%EndExpansion
\left(  {\huge \wedge}^{m}\mathcal{H}\otimes{\huge \wedge}^{n}\mathcal{H}%
^{d1}\right) \\
&  =\left[  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right]  \oplus\left[
{\huge \wedge}^{1}\mathcal{H}\otimes I_{{\huge \wedge}\left(  \mathcal{H}%
^{1d}\right)  }\right]  \oplus\left[  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes{\huge \wedge}^{1}\mathcal{H}^{d1}\right]  \oplus
\cdots\oplus{\huge \wedge}^{r}\mathcal{H}\otimes{\huge \wedge}^{r}%
\mathcal{H}^{dr}.
\end{align}

\end{remark}

\begin{remark}%
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\left(  {\huge \wedge}^{p}\left(  \mathcal{H}^{1}\right)  \otimes
{\huge \wedge}^{n-p}\left(  \mathcal{H}^{1d}\right)  \right)  \equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
\mathcal{H}^{p}\otimes\mathcal{H}^{\left(  n-p\right)  d}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\eta\left(  z\right)  \in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}\left(  \mathcal{H}^{d1}\right)
\end{equation}
thus by definition
\begin{equation}
\eta\left(  z\right)  \in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
\,\widehat{\otimes}\,{\huge \wedge}\left(  \mathcal{H}^{d1}\right)  .
\end{equation}
Recall
\end{remark}

\begin{definition}
$\eta$ extends to a linear homomorphism
\begin{equation}
{\large \boxtimes}\left(  \eta\right)  :{\huge \wedge}\left(  \mathcal{H}%
^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{d1}\right)
.
\end{equation}
defined by
\begin{equation}
{\large \boxtimes}\left(  \eta\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq r}}
%EndExpansion
{\large \boxtimes}^{n}\left(  \eta\right)  ,
\end{equation}
where
\begin{equation}
{\large \boxtimes}^{n}\left(  \eta\right)  :{\huge \wedge}^{n}\left(
\mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq p}}
%EndExpansion
\left(  \overset{}{{\huge \wedge}^{p}\left(  \mathcal{H}^{1}\right)
\otimes{\huge \wedge}^{n-p}\left(  \mathcal{H}^{d1}\right)  }\right)  \equiv%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq p}}
%EndExpansion
\left(  \overset{}{\mathcal{H}^{p}\otimes\mathcal{H}^{d\left(  n-p\right)  }%
}\right)
\end{equation}
and
\begin{equation}
{\large \boxtimes}^{n}\left(  \eta\right)  =%
%TCIMACRO{\tbigoplus \limits_{0\leq n\leq p}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq n\leq p}}
%EndExpansion
{\large \boxtimes}_{p}^{n-p}\left(  \eta\right)
\end{equation}
is defined by its action on basis elements%
\begin{gather}
\left(  {\large \boxtimes}_{p}^{n-p}\left(  \eta\right)  \right)  \left(
\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p}}\right\rangle \right)  \wedge\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  \right)  =\eta\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \right)  \wedge\cdots\wedge\eta\left(  \left\vert
\varphi_{j_{p}}\right\rangle \right)  \wedge\eta\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \right)  \wedge\cdots\wedge\eta\left(
\left\langle \varphi_{j_{n}}\right\vert \right) \\
0\leq p\leq n,1\leq j_{1}<\cdots<j_{p}\leq r,1\leq j_{p+1}<\cdots<j_{n}\leq r.
\end{gather}

\end{definition}

\begin{remark}%
\begin{gather}
\left(  {\large \boxtimes}_{p}^{n-p}\left(  \eta\right)  \right)  \left(
\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p}}\right\rangle \right)  \wedge\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  \right)  =\left(  \eta\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \right)  \wedge\cdots\wedge\eta\left(  \left\vert
\varphi_{j_{p}}\right\rangle \right)  \right)  \cdot\left(  \eta\left(
\left\langle \varphi_{j_{p+1}}\right\vert \right)  \wedge\cdots\wedge
\eta\left(  \left\langle \varphi_{j_{n}}\right\vert \right)  \right) \\
0\leq p\leq n,1\leq j_{1}<\cdots<j_{p}\leq r,1\leq j_{p+1}<\cdots<j_{n}\leq r,
\end{gather}

\end{remark}

\begin{remark}%
\begin{equation}
Z_{n}=\sum_{0\leq p\leq n}\sum_{\substack{1\leq j_{1}<\cdots<j_{p}\leq
r\\1\leq j_{p+1}<\cdots<j_{n}\leq r}}Z_{nj_{1}\cdots j_{p}j_{p+1}\cdots j_{n}%
}\left(  \left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots
\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  \wedge\left(
\left\langle \varphi_{j_{p+1}}\right\vert \wedge\cdots\wedge\left\langle
\varphi_{j_{n}}\right\vert \right)  \right)  =\sum_{0\leq p\leq n}%
Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}=%
%TCIMACRO{\tbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion
Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
Z=\sum_{0\leq n\leq r}Z_{n}.
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
{\large \boxtimes}^{n}\left(  \eta\right)  \left(  Z\right)  =\sum_{0\leq
p\leq n}{\large \boxtimes}_{p}^{n-p}\left(  \eta\right)  \left(
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  Z\right)
\right)  ,\quad Z\in{\huge \wedge}\left(  \mathcal{H}^{1}\oplus\mathcal{H}%
^{1d}\right)  .
\end{equation}

\end{remark}

\begin{remark}
In ${\huge \wedge}^{p_{1}+p_{2}}\left(  \mathcal{H}^{1}\right)  \wedge
{\huge \wedge}^{q_{1}+q_{2}}\left(  \mathcal{H}^{1d}\right)  $ with product
"$\wedge"$%
\begin{equation}
\left(  \overset{}{\left\vert x_{p_{1}}\right\rangle \wedge\left\langle
y_{q_{1}}\right\vert }\right)  \wedge\left(  \overset{}{\left\vert x_{p_{2}%
}\right\rangle \wedge\left\langle y_{q_{2}}\right\vert }\right)  =\left(
-1\right)  ^{p_{2}q_{1}}\left(  \overset{}{\left\vert x_{p_{1}}\right\rangle
\wedge\left\vert x_{p_{2}}\right\rangle }\right)  \wedge\left(
\overset{}{\left\langle y_{q_{1}}\right\vert \wedge\left\langle y_{q_{2}%
}\right\vert }\right)  .
\end{equation}

\end{remark}

\begin{remark}
This generalizes to
\begin{align}
&  \left(  \left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots
\wedge\left\vert \varphi_{j_{p-q}}\right\rangle \wedge\overbrace{\left\vert
\varphi_{j_{p-q+1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle }\right)  \wedge\left(  \overbrace{\left\langle \varphi
_{j_{p+1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{p+l}%
}\right\vert }\wedge\left\langle \varphi_{j_{p+l+1}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  \right) \\
&  \left.  \qquad\qquad\qquad\qquad=\right.  \left(  -1\right)  ^{ql}\left(
\left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert
\varphi_{j_{p-q}}\right\rangle \wedge\overbrace{\left\langle \varphi_{j_{p+1}%
}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{p+l}}\right\vert
}\right)  \wedge\left(  \overbrace{\left\vert \varphi_{j_{p-q+1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle }\wedge\left\langle
\varphi_{j_{p+l+1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  \right)  .
\end{align}

\end{remark}

\begin{remark}
In ${\huge \wedge}\left(  \mathcal{H}^{1}\right)  {\normalsize \otimes}\left(
\mathcal{H}^{1d}\right)  $ connection between the products "$@"$ and
"$\cdot"$
\begin{equation}
\left(  \overset{}{\left\vert x_{p_{1}}\right\rangle \wedge\left\langle
y_{q_{1}}\right\vert }\right)  @\left(  \overset{}{\left\vert x_{p_{2}%
}\right\rangle \wedge\left\langle y_{q_{2}}\right\vert }\right)  =\left(
-1\right)  ^{p_{2}q_{1}}\left(  \overset{}{\left\vert x_{p_{1}}\right\rangle
\wedge\left\langle y_{q_{1}}\right\vert }\right)  \cdot\left(
\overset{}{\left\vert x_{p_{2}}\right\rangle \wedge\left\langle y_{q_{2}%
}\right\vert }\right)  .
\end{equation}

\end{remark}

\begin{remark}
In ${\huge \wedge}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  =\left(
\mathcal{H}^{1}\right)  {\normalsize \otimes}\left(  \mathcal{H}^{1d}\right)
$ with product "$\cdot"$%
\begin{equation}
\left(  \overset{}{\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}%
}\right\vert }\right)  \cdot\left(  \overset{}{\left\vert x_{p_{2}%
}\right\rangle \left\langle y_{q_{2}}\right\vert }\right)  =\left\vert
x_{p_{1}}\wedge x_{p_{2}}\right\rangle \left\langle y_{q_{1}}\wedge y_{q_{2}%
}\right\vert .
\end{equation}

\end{remark}

\begin{remark}
In ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{{\normalsize \otimes}}\left(  \mathcal{H}^{1d}\right)  $ with product
"$@"$%
\begin{equation}
\left(  \overset{}{\left\vert x_{p_{1}}\right\rangle \left\langle y_{q_{1}%
}\right\vert }\right)  @\left(  \overset{}{\left\vert x_{p_{2}}\right\rangle
\left\langle y_{q_{2}}\right\vert }\right)  =\left(  -1\right)  ^{p_{2}q_{1}%
}\left\vert x_{p_{1}}\wedge x_{p_{2}}\right\rangle \left\langle y_{q_{1}%
}\wedge y_{q_{2}}\right\vert .
\end{equation}

\end{remark}

\begin{remark}
The "$\wedge"$ product in ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\wedge{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  $ \underline{\emph{does
not map}}\emph{ algebraically} into the "$\cdot"$product in ${\huge \wedge
}\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  .$
\end{remark}

\begin{remark}
The "$@"$ product in ${\huge \wedge}\left(  \mathcal{H}^{1}\right)
\widehat{{\normalsize \otimes}}\left(  \mathcal{H}^{1d}\right)  $
\underline{\emph{does map}}\emph{ algebraically} into the "$\cdot"$product in
${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \wedge{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  .$
\end{remark}

\begin{example}%
\begin{align}
&  \left(  \left(  \left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots
\wedge\left\vert \varphi_{j_{p-1}}\right\rangle \wedge\left\vert
\varphi_{j_{p}}\right\rangle \right)  \wedge\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \wedge\left\langle \varphi_{j_{p+2}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  \right) \\
&  \left.  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad
\qquad=\right.  -\left(  \left(  \left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle \wedge\left\vert
\varphi_{j_{p+1}}\right\rangle \right)  \wedge\left(  \left\langle
\varphi_{j_{p}}\right\vert \wedge\left\langle \varphi_{j_{p+2}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  \right)
\end{align}
and
\begin{gather}
\boxtimes\eta\left(  \overset{}{\left(  \left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle
\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  {\Large \wedge}\left(
\left\langle \varphi_{j_{p+1}}\right\vert \wedge\left\langle \varphi_{j_{p+2}%
}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert
\right)  \right)  }\right) \\
=\boxtimes\eta\left(  -\overset{}{\left(  \left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle
\wedge\left\vert \varphi_{j_{p+1}}\right\rangle \right)  {\Large \wedge
}\left(  \left\langle \varphi_{j_{p}}\right\vert \wedge\left\langle
\varphi_{j_{p+2}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  \right)  }\right) \\
\shortparallel\\
\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle
\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  }\right)  \right)
@\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\langle \varphi
_{j_{p+1}}\right\vert \wedge\left\langle \varphi_{j_{p+2}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  }\right)
\right) \\
=-\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle
\wedge\left\vert \varphi_{j_{p+1}}\right\rangle \right)  }\right)  \right)
@\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\langle \varphi_{j_{p}%
}\right\vert \wedge\left\langle \varphi_{j_{p+2}}\right\vert \wedge
\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  }\right)  \right)
\\
\shortparallel\\
\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle
\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)  }\right)  \right)
\cdot\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\langle
\varphi_{j_{p+1}}\right\vert \wedge\left\langle \varphi_{j_{p+2}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  }\right)
\right) \\
=\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p-1}}\right\rangle
\wedge\left\vert \varphi_{j_{p+1}}\right\rangle \right)  }\right)  \right)
\cdot\left(  \boxtimes\eta\left(  \overset{}{\left(  \left\langle
\varphi_{j_{p}}\right\vert \wedge\left\langle \varphi_{j_{p+2}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  }\right)
\right)  .
\end{gather}

\end{example}

\begin{remark}%
\begin{equation}
\left(  w_{p-q}\wedge x_{q}\right)  \wedge\left(  y_{l}\wedge z_{n-l}\right)
=\left(  -1\right)  ^{ql}\left(  w_{p-q}\wedge y_{l}\right)  \wedge\left(
x_{q}\wedge z_{n-l}\right)
\end{equation}
In particular
\begin{equation}
w_{p-q}\in\mathcal{H}^{\left(  p-q\right)  },\,x_{q}\in\mathcal{H}^{q}%
,\,y_{l}\in\mathcal{H}^{dl},\,z_{n-l}\in\mathcal{H}^{d\left(  n-l\right)  }.
\end{equation}

\end{remark}

\begin{lemma}%
\begin{equation}
\boxtimes\left(  \eta\right)  :\mathcal{H}^{p}\wedge\mathcal{H}^{d\left(
n-p\right)  }\rightarrow\mathcal{H}^{p}\otimes\mathcal{H}^{d\left(
n-p\right)  }%
\end{equation}
and
\begin{equation}
\left.  \boxtimes\left(  \eta\right)  \right\vert _{\mathcal{H}^{p}%
\wedge\mathcal{H}^{d\left(  n-p\right)  }}={\large \boxtimes}_{p}^{n-p}\left(
\eta\right)  .
\end{equation}

\end{lemma}

\begin{notation}
The projections
\begin{equation}
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}:{\huge \wedge}%
^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \rightarrow
\mathcal{H}^{p}\wedge\mathcal{H}^{d\left(  n-p\right)  };\quad0\leq p\leq n
\end{equation}
are given by
\begin{equation}
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  Z_{n}\right)
=\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  \sum_{0\leq
p\leq n}Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\right)
=Z_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}.
\end{equation}

\end{notation}

\begin{remark}%
\begin{align}
\pi_{\mathcal{H}^{1}}  &  =\pi_{\mathcal{H}^{1}\mathcal{H}^{0d}}\\
\pi_{\mathcal{H}^{1d}}  &  =\pi_{\mathcal{H}^{0}\mathcal{H}^{1d}}.
\end{align}

\end{remark}

\begin{example}
The projections
\begin{align}
\pi_{\mathcal{H}^{1}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1}}\\
\pi_{\mathcal{H}^{1d}}\left(  z\right)   &  =\pi_{\mathcal{H}^{1d}}\left(
z_{\mathcal{H}^{1}}+z_{\mathcal{H}^{1d}}\right)  =z_{\mathcal{H}^{1d}}.
\end{align}
can be extended by%
\begin{gather}
\pi_{\mathcal{H}^{n}\mathcal{H}^{d0}}\left(  Z\right)  =\pi_{\mathcal{H}%
^{n}\mathcal{H}^{d0}}\left(  Z_{n}\right)  =\pi_{\mathcal{H}^{n}%
\mathcal{H}^{d0}}\left(  \sum_{0\leq p\leq n}Z_{np}\right) \\
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(  Z_{n}\right)
=\sum_{0\leq p\leq n}\sum_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq
j_{p+1}<\cdots<j_{n}\leq r}}Z_{npj_{1}\cdots j_{p}j_{p+1}\cdots j_{n}}%
\pi_{\mathcal{H}^{p}\mathcal{H}^{d\left(  n-p\right)  }}\left(
\overset{}{\left(  \left(  \left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)
\wedge\left(  \left\langle \varphi_{j_{p+1}}\right\vert \wedge\cdots
\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  \right)  }\right) \\
=\sum_{0\leq p\leq n}\sum_{\substack{1\leq j_{1}<\cdots<j_{p}\leq r\\1\leq
j_{p+1}<\cdots<j_{n}\leq r}}Z_{npj_{1}\cdots j_{p}j_{p+1}\cdots j_{n}%
}\overset{}{\left(  \left(  \left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle \right)
\wedge\left(  \left\langle \varphi_{j_{p+1}}\right\vert \wedge\cdots
\wedge\left\langle \varphi_{j_{n}}\right\vert \right)  \right)  }.
\end{gather}

\end{example}

\begin{example}
$n=2,p=1$%
\begin{align}
\pi_{\mathcal{H}^{n}\mathcal{H}^{d1}}\left(  Z\right)   &  =\pi_{\mathcal{H}%
^{n}\mathcal{H}^{d1}}\left(  Z_{2}\right)  =\pi_{\mathcal{H}^{n}%
\mathcal{H}^{d1}}\left(  Z_{2}\right) \\
&  =\sum_{1\leq j_{1}\leq r}Z_{2j_{1}1}\overset{}{\left(  \left\vert
\varphi_{j_{1}}\right\rangle \wedge\left\langle \phi\right\vert \right)  \in
}\mathcal{H}^{1}\wedge\mathcal{H}^{d0}\\
\pi_{\mathcal{H}^{0}\mathcal{H}^{dn}}\left(  Z\right)   &  =\\
&  =\sum_{1\leq j_{1}<\cdots<j_{n}\leq r}Z_{n0j_{1}\cdots j_{n}}%
\overset{}{\left(  \left\vert \phi\right\rangle \wedge\left(  \left\langle
\varphi_{j_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{j_{n}%
}\right\vert \right)  \right)  \in\mathcal{H}^{0}\wedge\mathcal{H}^{dn1}.}%
\end{align}

\end{example}

\begin{lemma}
$\boxtimes\left(  \eta\right)  $ is {\Large not }an algebra algebra homorphism
wrt "$\wedge$" and "$\cdot$"%
\begin{equation}
\boxtimes\left(  \eta\right)  :{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  \rightarrow%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1},\mathcal{H}^{1d}\right)  \equiv{\huge \wedge}\left(
\mathcal{H}^{1}\right)  \otimes{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
,
\end{equation}
i.e.
\begin{gather}
\boxtimes\left(  \eta\right)  \left(  \overset{}{\left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \wedge\left\langle
\varphi_{j_{p+1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\vert }\right)
\overset{\text{in general }}{\neq}\left(  \boxtimes\left(  \eta\right)
\left(  \overset{}{\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}%
}\right\rangle }\right)  \right)  \cdot\left(  \boxtimes\left(  \eta\right)
\left(  \overset{}{\left\langle \varphi_{j_{p+1}}\wedge\cdots\wedge
\varphi_{j_{n}}\right\vert }\right)  \right) \\
0\leq p\leq n,1\leq j_{1}<\cdots<j_{p}\leq r,1\leq j_{p+1}<\cdots<j_{n}\leq r
\end{gather}

\end{lemma}

\begin{proof}%
\begin{gather}
\boxtimes\left(  \eta\right)  \left(  \overset{}{\left\vert \varphi_{j_{1}%
}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle \wedge\left\langle
\varphi_{j_{p+1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\vert }\right)
=\sum_{0\leq p\leq n}\boxtimes^{n}\left(  \eta\right)  \left(
\overset{}{\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}%
}\right\rangle \wedge\left\langle \varphi_{j_{p+1}}\wedge\cdots\wedge
\varphi_{j_{n}}\right\vert }\right) \\
=\sum_{0\leq p\leq n}\boxtimes_{0}^{p}\left(  \eta\right)  \overset{}{\left(
\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle
\right)  \wedge\left(  \boxtimes_{0}^{n-p}\left(  \eta\right)  \right)
^{\dagger}\left(  \left\langle \varphi_{j_{p+1}}\wedge\cdots\wedge
\varphi_{j_{n}}\right\vert \right)  }\\
\neq\sum_{0\leq p\leq n}\left(  \boxtimes_{0}^{p}\left(  \eta\right)  \left(
\overset{}{\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}%
}\right\rangle }\right)  \right)  \cdot\left(  \left(  \boxtimes_{0}%
^{n-p}\left(  \eta\right)  \right)  ^{\dagger}\left(  \overset{}{\left\langle
\varphi_{j_{p+1}}\wedge\cdots\wedge\varphi_{j_{n}}\right\vert }\right)
\right) \\
=\left(  \left\vert \overset{}{\varphi_{j_{1}}\wedge\cdots\wedge\varphi
_{j_{p}}}\right\rangle \left\langle \overset{}{\phi}\right\vert \right)
\cdot\left(  \left\vert \overset{}{\phi}\right\rangle \left\langle
\overset{}{\varphi_{j_{p+1}}\wedge\cdots\wedge\varphi_{j_{n}}}\right\vert
\right)  =\left\vert \overset{}{\varphi_{j_{1}}\wedge\cdots\wedge
\varphi_{j_{p}}}\right\rangle \left\langle \overset{}{\varphi_{j_{p+1}}%
\wedge\cdots\wedge\varphi_{j_{n}}}\right\vert .
\end{gather}
\emph{However}
\end{proof}

\begin{theorem}
$\boxtimes\left(  \eta\right)  $ \emph{is an algebra homorphism wrt "}$\wedge
$\emph{" and "}$@"$\emph{ i.e.}
\begin{equation}
\boxtimes\left(  \eta\right)  \left(  \ Z_{a}\wedge\ Z_{b}\right)  =\left(
\boxtimes\left(  \eta\right)  \left(  \ Z_{a}\right)  \right)  @\left(
\boxtimes\left(  \eta\right)  \left(  \ Z_{b}\right)  \right)  .
\end{equation}

\end{theorem}

\begin{proof}
recall%
\begin{equation}
\left(  x_{p_{1}}\wedge y_{q_{1}}^{d}\right)  @\left(  x_{p_{2}}\wedge
y_{q_{2}}^{d}\right)  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge
x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}^{d}\wedge y_{q_{2}}^{d}\right)  ,
\end{equation}
then
\begin{align}
&  \left(  \boxtimes\left(  \eta\right)  \left(  \left\vert
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge
\left\vert \varphi_{j_{p}}\right\rangle }\right\rangle \right)  \right)
@\left(  \boxtimes\left(  \eta\right)  \left(  \left\langle
\overset{}{\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge
\left\langle \varphi_{k_{q}}\right\vert }\right\vert \right)  \right) \\
=  &  \left(  \left\vert \overset{}{\left\vert \varphi_{j_{1}}\right\rangle
\wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle }\right\rangle
\left\langle \overset{}{\phi}\right\vert \right)  @\left(  \left\vert
\overset{}{\phi}\right\rangle \left\langle \overset{}{\left\langle
\varphi_{k_{1}}\right\vert \wedge\cdots\wedge\left\langle \varphi_{k_{q}%
}\right\vert }\right\vert \right) \\
&  =\left(  -1\right)  ^{pq}\left(  \left\vert \overset{}{\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle }\right\rangle \wedge\left\langle \overset{}{\phi^{d}%
}\right\vert \right)  \otimes\left(  \left\vert \overset{}{\phi}\right\rangle
\wedge\left\langle \overset{}{\left\langle \varphi_{k_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert }\right\vert \right)
\\
&  =\left(  -1\right)  ^{pq}\left(  \left\vert \overset{}{\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle \wedge\left\vert \phi^{d}\right\rangle }\right\rangle \right)
\otimes\left(  \left\vert \phi\right\rangle \wedge\left\langle
\overset{}{\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge
\left\langle \varphi_{k_{q}}\right\vert }\right\vert \right) \\
&  =\left(  -1\right)  ^{pq}\left(  \left\vert \overset{}{\left\vert
\varphi_{j_{1}}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}%
}\right\rangle }\right\rangle \right)  \otimes\left(  \left\langle
\overset{}{\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge
\left\langle \varphi_{k_{q}}\right\vert }\right\vert \right) \\
&  =\left(  -1\right)  ^{pq}\left\vert \varphi_{j_{1}}\wedge\cdots
\wedge\varphi_{j_{p}}\right\rangle \left\langle \varphi_{k_{1}}\wedge
\cdots\wedge\varphi_{k_{q}}\right\vert ,
\end{align}
i.e%
\begin{align}
\boxtimes\left(  \eta\right)  \left(  \left\vert \left\vert \varphi_{j_{1}%
}\right\rangle \wedge\cdots\wedge\left\vert \varphi_{j_{p}}\right\rangle
\right\rangle \wedge\left\langle \left\langle \varphi_{k_{1}}\right\vert
\wedge\cdots\wedge\left\langle \varphi_{k_{q}}\right\vert \right\vert \right)
&  =\left(  -1\right)  \left\vert \boxtimes\left(  \eta\right)  \left(
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \wedge\cdots\wedge
\left\vert \varphi_{j_{p}}\right\rangle }\right)  \right\rangle \wedge
\left\langle \boxtimes\left(  \eta\right)  ^{\dagger}\left(
\overset{}{\left\langle \varphi_{k_{1}}\right\vert \wedge\cdots\wedge
\left\langle \varphi_{k_{q}}\right\vert }\right)  \right\vert \\
&  =\left\vert \varphi_{j_{1}}\wedge\cdots\wedge\varphi_{j_{p}}\right\rangle
\left\langle \phi\right\vert \wedge\left\vert \phi\right\rangle \left\langle
\varphi_{k_{1}}\wedge\cdots\wedge\varphi_{k_{q}}\right\vert .
\end{align}

\end{proof}

\begin{lemma}
$\boxtimes\left(  \eta\right)  $ is an algebra homorphism i.e.
\begin{equation}
\left(  \boxtimes\left(  \eta\right)  \left(  \ Z_{a}\right)  \right)
@\left(  \boxtimes\left(  \eta\right)  \left(  \ Z_{b}\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  \ Z_{a}\wedge\ Z_{b}\right)  .
\end{equation}

\end{lemma}

\begin{proof}
Let $z_{1},z_{2}\in\mathcal{H}^{1}\oplus$ $\mathcal{H}^{1d}$ then

\begin{enumerate}
\item By definition
\begin{equation}
\left(  \overset{}{\boxtimes\left(  \eta\right)  }\right)  \left(
\ z_{1}\wedge z_{2}\right)  =\eta\left(  z_{1}\right)  \wedge\eta\left(
z_{2}\right)  ,
\end{equation}


\item which gives
\begin{equation}
\eta\left(  z\right)  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d}.
\end{equation}


\item
\begin{equation}
\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(  z_{1}\right)
}\right)  @\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(
z_{2}\right)  }\right)  =\eta\left(  z_{1}\right)  @\eta\left(  z_{2}\right)
.
\end{equation}


\item
\begin{equation}
\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(  z_{1}\right)
}\right)  \cdot\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(
z_{2}\right)  }\right)  =\eta\left(  z_{1}\right)  \cdot\eta\left(
z_{2}\right)  .
\end{equation}


\item
\begin{align}
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}%
}\right)   &  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\wedge
x_{p_{2}}\right)  \otimes\left(  y_{q_{1}}\wedge y_{q_{2}}\right)  \ \\
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes
y_{q_{2}}\right)   &  =\left(  x_{p_{1}}\wedge x_{p_{2}}\right)
\otimes\left(  y_{q_{1}}\wedge y_{q_{2}}\right) \\
\left(  x_{p_{1}}\otimes y_{q_{1}}\right)  @\left(  x_{p_{2}}\otimes y_{q_{2}%
}\right)   &  =\left(  -1\right)  ^{p_{2}q_{1}}\left(  x_{p_{1}}\otimes
y_{q_{1}}\right)  \cdot\left(  x_{p_{2}}\otimes y_{q_{2}}\right)  .
\end{align}


\item This gives
\begin{equation}
\left(  \boxtimes\left(  \eta\right)  \left(  x_{11}\otimes x_{12}\right)
\right)  \cdot\left(  \boxtimes\left(  \eta\right)  \left(  y_{11}\otimes
y_{21}\right)  \right)  =-\eta\left(  x_{11}\otimes x_{12}\right)
@\eta\left(  y_{11}\otimes y_{21}\right)  =-\left(  x_{11}\wedge
x_{12}\right)  \otimes\left(  y_{11}\wedge y_{21}\right)  .
\end{equation}


\item
\begin{align}
&  \left(  \overset{}{\boxtimes\left(  \eta\right)  \left(  z_{1}\right)
}\right)  @\left(  \overset{}{\boxtimes\left(  \left(  \eta\right)  \left(
z_{2}\right)  \right)  }\right)  =\left(  \overset{}{\pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z_{1}\right)  \otimes I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes\pi_{\mathcal{H}^{1d}}\left(  z_{1}\right)  }\right)  @\left(
\overset{}{\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z_{2}\right)
}\right) \\
&  =\left[  \overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{1}\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)
\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]
+\left[  \overset{}{\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{1}\right)  \otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\right)  @\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }%
\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)
}\right] \\
&  +\left[  \overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)
\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)
\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  }\right]
+\left[  \overset{}{\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\otimes\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)
@\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)  }\right] \\
&  =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)  \right)  \otimes\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\right)  \otimes\left(  I_{{\huge \wedge}\left(
\mathcal{H}^{1d}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(
z_{2}\right)  \right) \\
&  -\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \right)  \otimes\left(
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  +\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1}\right)  }\right)  \otimes\left(  \pi_{\mathcal{H}%
^{1}\mathcal{\ }}\left(  z_{2}\right)  \wedge\pi_{\mathcal{H}^{1d}%
\mathcal{\ }}\left(  z_{2}\right)  \right)
\end{align}


\item
\begin{align}
&  \left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)  \right)  \otimes\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right) \\
&  =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  @\left(
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)  \wedge I_{{\huge \wedge
}\left(  \mathcal{H}^{1d}\right)  }\right) \\
&  \left.  +\right.  \left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(
z_{1}\right)  \wedge I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\right)  \otimes\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
}\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right) \\
&  =\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  @\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\wedge\pi_{\mathcal{H}%
^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right) \\
&  -\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)  \right)  \otimes\left(
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)  \wedge
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right) \\
&  =-\left(  -1\right)  \left(  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{1}\right)
\right)  @\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{1}\right)
\wedge I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right) \\
&  \left.  +\right.  \left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)
}\wedge I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\right)
\otimes\left(  \pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)
\wedge\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right) \\
&  =\left(  -1\right)  \left(  I_{{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  }\wedge\pi_{\mathcal{H}^{1}\mathcal{\ }}\left(  z_{2}\right)
\right)  @\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\wedge
\pi_{\mathcal{H}^{1d}\mathcal{\ }}\left(  z_{2}\right)  \right)  .
\end{align}

\end{enumerate}
\end{proof}

\begin{theorem}
$\bigskip\digamma$ is a linear injection (in finite dimension it is a
\emph{linear isomorphism}) and it is the inverse of $\boxtimes\left(
\eta\right)  $
\begin{gather}
x=\digamma\left(  \overset{}{\boxtimes\left(  \eta\right)  \left(  x\right)
}\right)  \equiv\left(  \digamma\circ\boxtimes\left(  \eta\right)  \right)
\left(  x\right)  ,\quad x\in{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  \\
A=\left(  \overset{}{\boxtimes\left(  \eta\right)  }\right)  \left(
\overset{}{\digamma\left(  A\right)  }\right)  \equiv\left(  \boxtimes\left(
\eta\right)  ^{-1}\circ\digamma^{-1}\right)  \left(  A\right)  \equiv\left(
\digamma\circ\boxtimes\left(  \eta\right)  \right)  ^{-1}\left(  A\right)
,\quad A\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{gather}

\end{theorem}

\begin{lemma}
\begin{proof}
\begin{enumerate}
\item
\begin{gather}
\left(  \overset{}{\boxtimes\left(  \eta\right)  \circ\digamma}\right)
\left(  x\otimes I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)
=\boxtimes\left(  \eta\right)  \left(  \digamma\left(  x\otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  i_{1\wedge}\left(  x\otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }\right)  \right)
=\boxtimes\left(  \eta\right)  \left(  i_{1\wedge}\left(  x\right)  \right)
=\eta\left(  i_{1\wedge}\left(  x\right)  \right)  =x,\\
\quad x\in\mathcal{H}^{1}%
\end{gather}


\item
\begin{gather}
\left(  \overset{}{\boxtimes\left(  \eta\right)  \circ\digamma}\right)
\left(  I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes
y^{d}\right)  =\boxtimes\left(  \eta\right)  \left(  \digamma\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes y^{d}\right)
\right)  =\boxtimes\left(  \eta\right)  \left(  i_{1d\wedge}\left(
I_{{\huge \wedge}\left(  \mathcal{H}^{1}\right)  }\otimes y^{d}\right)
\right)  =\boxtimes\left(  \eta\right)  \left(  i_{1d\wedge}\left(
y^{d}\right)  \right)  =\eta\left(  i_{1d\wedge}\left(  y^{d}\right)  \right)
=y^{d},\\
\quad y^{d}\in\mathcal{H}^{1d}.
\end{gather}

\end{enumerate}
\end{proof}
\end{lemma}

\begin{remark}
Recall
\begin{align}
\digamma &  :{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \widehat{\otimes
}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge
}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  \\
\digamma\left(  u\otimes v^{d}\right)   &  =i_{1\wedge}\left(  u\right)
\wedge i_{1d\wedge}\left(  v^{d}\right)  \\
\quad z &  \in\mathcal{H}^{1}\oplus\mathcal{H}^{1d};u\in{\huge \wedge}\left(
\mathcal{H}^{1}\right)  ,v\in{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{align}
and
\begin{align}
\boxtimes\left(  \eta\right)   &  :{\huge \wedge}\left(  \mathcal{H}^{1}%
\oplus\mathcal{H}^{1d}\right)  \rightarrow{\huge \wedge}\left(  \mathcal{H}%
^{1}\right)  \widehat{\otimes}{\huge \wedge}\left(  \mathcal{H}^{1d}\right)
\\
\boxtimes\left(  \eta\right)  \left(  Z\right)   &  =%
%TCIMACRO{\tsum \limits_{0\leq n\leq r}}%
%BeginExpansion
{\textstyle\sum\limits_{0\leq n\leq r}}
%EndExpansion%
%TCIMACRO{\tsum \limits_{0\leq p\leq n}}%
%BeginExpansion
{\textstyle\sum\limits_{0\leq p\leq n}}
%EndExpansion
\boxtimes^{n}\left(  \eta\right)  \left(  \pi_{\mathcal{H}^{p}\mathcal{H}%
^{d\left(  n-p\right)  }}\left(  Z\right)  \right)  \ \\
\eta\left(  z\right)   &  =\pi_{\mathcal{H}^{1}}\left(  z\right)  \otimes
I_{{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  }+I_{{\huge \wedge}\left(
\mathcal{H}^{1}\right)  }\otimes\pi_{\mathcal{H}^{1d}}\left(  z\right)  ;\quad
z\in\mathcal{H}^{1}\oplus\mathcal{H}^{1d}.
\end{align}

\end{remark}

\begin{corollary}
$\digamma$ and $\boxtimes\left(  \eta\right)  $ are algebra isomorphisms wrt
"$@"$ and "$\wedge"$ i.e.

\begin{enumerate}
\item
\begin{equation}
\digamma\left(  \left(  u\otimes v^{d}\right)  @\left(  w\otimes x^{d}\right)
\right)  =\digamma\left(  u\otimes v^{d}\right)  \wedge\digamma\left(
w\otimes x^{d}\right)  ;u,w\in{\huge \wedge}\left(  \mathcal{H}^{1}\right)
;v^{d},x^{d}\in{\huge \wedge}\left(  \mathcal{H}^{1d}\right)  .
\end{equation}


\item
\begin{equation}
\boxtimes\left(  \eta\right)  \left(  A\wedge B\right)  =\left(
\overset{}{\boxtimes\left(  \eta\right)  \left(  A\right)  }\right)  @\left(
\overset{}{\boxtimes\left(  \eta\right)  \left(  B\right)  }\right)  .
\end{equation}

\end{enumerate}
\end{corollary}

\begin{example}%
\begin{equation}
\left(  x_{1_{1}}\otimes y_{1_{1}}\right)  @\left(  x_{1_{2}}\otimes y_{1_{2}%
}\right)  =-\left(  x_{1_{1}}\wedge x_{1_{2}}\right)  \otimes\left(  y_{1_{1}%
}\wedge y_{1_{2}}\right)
\end{equation}

\end{example}

\begin{remark}%
\begin{equation}
{\huge \wedge}^{n}\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)
\supset%
%TCIMACRO{\tbigoplus \limits_{0\leq p+q=n\leq r}}%
%BeginExpansion
{\textstyle\bigoplus\limits_{0\leq p+q=n\leq r}}
%EndExpansion
{\huge \wedge}^{p}\left(  \mathcal{H}^{1}\right)  \otimes{\huge \wedge}%
^{q}\left(  \mathcal{H}^{d1}\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
\mathcal{H}_{1}^{1}=\mathcal{H}^{1}\oplus\mathcal{H}^{1d}.
\end{equation}

\end{remark}

\begin{theorem}
${\huge \wedge}\left(  \mathcal{H}^{1}\right)  \,\widehat{\otimes
}\,{\huge \wedge}\left(  \mathcal{H}^{d1}\right)  $ is algebraically
isomorphic to $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  $ wrt the products "$@"$
and "$\wedge"$
\begin{equation}
{\huge \wedge}\left(  \mathcal{H}^{1}\right)  \,\widehat{\otimes
}\,{\huge \wedge}\left(  \mathcal{H}^{d1}\right)  \cong%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}_{1}^{1}\right)  \equiv%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  \mathcal{H}^{1}\oplus\mathcal{H}^{1d}\right)  .
\end{equation}

\end{theorem}

\begin{proof}
same as the previous theorem. 
\end{proof}

\begin{remark}%
\begin{equation}
\left\vert X\right\rangle @\left\langle Y\right\vert \rightarrow\left\vert
X\right\rangle \left\langle \phi\right\vert \left\vert \phi\right\rangle
\left\langle Y\right\vert -\left\vert Y\right\rangle \left\langle
\phi\right\vert \left\vert \phi\right\rangle \left\langle X\right\vert
\end{equation}

\end{remark}


