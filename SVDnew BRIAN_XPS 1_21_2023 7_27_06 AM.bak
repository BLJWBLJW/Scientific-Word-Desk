\section{SVDnew}

\subparagraph{Resolution of the Identities}

\begin{enumerate}
\item For the space $V$ the dot product of the dual (biorthogonal) super
vectors $\left(  \boldsymbol{e}\right)  $ and $\left(  \boldsymbol{e}%
^{d}\right)  $ produce the resolution of the identity
\begin{equation}
\left(  \boldsymbol{e}\right)  \cdot\left(  \boldsymbol{e}^{d}\right)
^{t}\equiv\left(  \boldsymbol{e}\right)  \left(  \boldsymbol{e}^{d}\right)
^{t}=\left(  e_{1},\cdots,e_{n}\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  =\sum_{1\leq j\leq n}e_{j}e_{j}^{d}=\sum_{1\leq j\leq n}\left[
e_{j}e_{j}^{d}\right]  =\sum_{1\leq j\leq n}E_{e_{j}e_{j}^{d}}=I_{V}%
\in\mathcal{B}\left(  V,V\right)  .
\end{equation}
giving
\begin{equation}
Tv=\left(  \left(  \boldsymbol{e}\right)  \left(  \boldsymbol{e}^{d}\right)
^{t}\right)  \left(  T\right)  \left(  \left(  \boldsymbol{e}\right)  \left(
\boldsymbol{e}^{d}\right)  ^{t}\right)  v=\sum_{1\leq k\leq n}E_{e_{k}%
e_{k}^{d}}T\sum_{1\leq j\leq n}E_{e_{j}e_{j}^{d}}v=\sum_{\substack{1\leq k\leq
n\\1\leq j\leq n}}e_{k}e_{k}^{d}\left(  Te_{j}\right)  e_{j}^{d}\left(
v\right)  =\sum_{\substack{1\leq k\leq n\\1\leq j\leq n}}e_{k}\mathcal{R}%
_{ee}\left(  T\right)  _{kj}\mathcal{R}_{e}\left(  v\right)  _{j}.
\end{equation}


\item For the space $W$ this becomes
\begin{equation}
\left(  \boldsymbol{f}\right)  \left(  \boldsymbol{f}^{d}\right)  ^{t}=\left(
f_{1},\cdots,f_{m}\right)  \left(
\begin{array}
[c]{c}%
f_{1}^{d}\\
\vdots\\
f_{m}^{d}%
\end{array}
\right)  =\sum_{1\leq j\leq m}f_{j}f_{j}^{d}=\sum_{1\leq j\leq m}\left[
f_{j}f_{j}^{d}\right]  =\sum_{1\leq j\leq m}E_{f_{j}f_{j}^{d}}=I_{W}%
\in\mathcal{B}\left(  W,W\right)  .
\end{equation}


\item The action of elemnray operators is given by
\begin{align}
\sum_{1\leq j\leq n}\left[  e_{j}e_{j}^{d}\right]  \left(  v\right)   &
=\sum_{1\leq j\leq n}e_{j}e_{j}^{d}\left(  v\right)  =\sum_{1\leq j\leq
n}e_{j}\mathcal{R}_{e}\left(  v\right)  _{j}=\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  _{1}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\left(  v\right) \\
\vdots\\
e_{n}^{d}\left(  v\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  \left(  v\right)  =\left(  \left(  \boldsymbol{e}\right)  \left(
\boldsymbol{e}^{d}\right)  ^{t}\right)  \left(  v\right)  .
\end{align}

\end{enumerate}

\subparagraph{Elementary Operators}

\begin{definition}
The action of the Elementary Operators $\left\{  \left.  \left[  e_{j}%
e_{k}^{d}\right]  \right\vert 1\leq j,k\leq n\right\}  $ are defined by
\begin{equation}
\left[  e_{j}e_{k}^{d}\right]  \left(  v\right)  =E_{e_{j}e_{k}^{d}}\left(
v\right)  =\sum_{1\leq j_{1}\leq n}e_{j}e_{k}^{d}\left(  e_{j_{1}}\right)
\mathcal{R}_{e}\left(  v\right)  _{j_{1}}=e_{j}\mathcal{R}_{e}\left(
v\right)  _{k}.
\end{equation}

\end{definition}

\begin{enumerate}
\item The basis $\left(  \boldsymbol{e}\right)  $ can be transformed into the
basis $\left(  \boldsymbol{g}\right)  $ by $T\in GL\left(  V\right)  $
\begin{equation}
g_{j}=T_{ge}e_{j}=\sum_{1\leq j_{1}\leq n}e_{j_{1}}\mathcal{R}_{ee}\left(
T_{ge}\right)  _{j_{1}j}.
\end{equation}


\item The dual basis transforms as
\begin{equation}
g_{j}^{d}=T_{ge}^{d}e_{j}^{d}=\sum_{1\leq j_{1}\leq n}e_{j_{1}}^{d}%
\mathcal{R}_{e^{d}e^{d}}\left(  T_{ge}^{d}\right)  _{j_{1}j}.
\end{equation}


\item The dual transformation is given by
\begin{equation}
\mathcal{R}_{e^{d}e^{d}}\left(  T^{d}\right)  =\mathcal{R}_{ee}\left(
T\right)  ^{t}.
\end{equation}


\item The action of the operator $\left[  g_{j}e_{k}^{d}\right]  $ is given
by
\begin{align}
\left[  g_{j}e_{k}^{d}\right]  \left(  v\right)   &  =E_{g_{j}e_{k}^{d}%
}\left(  v\right)  =\sum_{1\leq j_{1}\leq n}g_{j}e_{k}^{d}\left(  e_{j_{1}%
}\right)  \mathcal{R}_{e}\left(  v\right)  _{j_{1}}=\sum_{1\leq j_{1}\leq
n}\sum_{1\leq j_{2}\leq n}e_{j_{2}}\mathcal{R}_{ee}\left(  T_{ge}\right)
_{j_{2}j}e_{k}^{d}\left(  e_{j_{1}}\right)  \mathcal{R}_{e}\left(  v\right)
_{j_{1}}\\
&  =\sum_{1\leq j_{2}\leq n}e_{j_{2}}\mathcal{R}_{ee}\left(  T_{ge}\right)
_{j_{2}j}\mathcal{R}_{e}\left(  v\right)  _{k}=\sum_{1\leq j_{2}\leq
n}\mathcal{R}_{ee}\left(  T_{ge}\right)  _{j_{2}j_{1}}\left[  e_{j_{2}%
}e_{j_{1}}^{d}\right]  \left(  v\right)
\end{align}
by using
\begin{equation}
\left[  e_{j_{2}}e_{k}^{d}\right]  \left(  v\right)  =e_{j_{2}}\mathcal{R}%
_{e}\left(  v\right)  _{k},
\end{equation}
i.e.
\begin{equation}
\left[  g_{j}e_{k}^{d}\right]  \left(  v\right)  =\sum_{1\leq j_{2}\leq
n}\mathcal{R}_{ee}\left(  T_{ge}\right)  _{j_{2}j_{1}}\left[  e_{j_{2}%
}e_{j_{1}}^{d}\right]  \left(  v\right)  =\sum_{1\leq j_{2}\leq n}%
\mathcal{R}_{ee}\left(  T_{ge}\right)  _{j_{1}j_{2}}^{t}\left[  e_{j_{2}%
}e_{j_{1}}^{d}\right]  \left(  v\right)  .
\end{equation}


\item The action of the operator $\left[  e_{j}g_{k}^{d}\right]  $ is given
by
\begin{align}
\left[  e_{j}g_{k}^{d}\right]  \left(  v\right)   &  =E_{e_{j}g_{k}^{d}%
}\left(  v\right)  =\sum_{1\leq j_{1}\leq n}e_{j}g_{k}^{d}\left(  e_{j_{1}%
}\right)  \mathcal{R}_{e}\left(  v\right)  _{j_{1}}=\sum_{1\leq j_{1}\leq
n}\sum_{1\leq k_{1}\leq n}e_{j}e_{k_{1}}^{d}\left(  e_{j_{1}}\right)
\mathcal{R}_{e^{d}e^{d}}\left(  T_{ge}^{d}\right)  _{k_{1}k}\mathcal{R}%
_{e}\left(  v\right)  _{j_{1}}\\
&  =\sum_{1\leq j_{1}\leq n}e_{j}\mathcal{R}_{e^{d}e^{d}}\left(  T_{ge}%
^{d}\right)  _{j_{1}k}\mathcal{R}_{e}\left(  v\right)  _{j_{1}}=\sum_{1\leq
j_{1}\leq n}\left[  e_{j}e_{j_{1}}^{d}\right]  \left(  v\right)
\mathcal{R}_{ee}\left(  T_{ge}\right)  _{j_{1}k}%
\end{align}
by using
\begin{equation}
\left[  e_{j}e_{j_{1}}^{d}\right]  \left(  v\right)  =e_{j}\mathcal{R}%
_{e}\left(  v\right)  _{j_{1}},
\end{equation}
i.e.
\begin{equation}
\left[  e_{j}g_{k}^{d}\right]  \left(  v\right)  =\sum_{1\leq j_{1}\leq
n}\left[  e_{j}e_{j_{1}}^{d}\right]  \left(  v\right)  \mathcal{R}_{ee}\left(
T_{ge}\right)  _{j_{1}k}.
\end{equation}


\item The action of the operator $\left[  g_{j}g_{k}^{d}\right]  $ is given by%
\begin{equation}
\left[  g_{j}g_{k}^{d}\right]  \left(  v\right)  =\sum_{1\leq j_{1},k_{1}\leq
n}\mathcal{R}_{ee}\left(  T_{ge}\right)  _{kj_{1}}^{t}\left[  e_{j_{1}%
}e_{k_{1}}^{d}\right]  \left(  v\right)  \mathcal{R}_{ee}\left(
T_{ge}\right)  _{k_{1}k}%
\end{equation}%
\begin{equation}
\shortparallel
\end{equation}%
\begin{equation}
E_{g_{j}g_{k}}\left(  v\right)  =\sum_{1\leq j_{1},k_{1}\leq n}\mathcal{R}%
_{ee}\left(  T_{ge}\right)  _{kj_{1}}^{t}E_{e_{j_{1}}e_{k_{1}}}e\left(
v\right)  \mathcal{R}_{ee}\left(  T_{ge}\right)  _{k_{1}k}%
\end{equation}


\item The transformation between elementary operators induced by basis
transformation is
\begin{equation}
\left[  \boldsymbol{gg}^{d}\right]  =T_{ge}^{t}\left[  \boldsymbol{ee}%
^{d}\right]  T_{ge}%
\end{equation}%
\begin{equation}
\shortparallel
\end{equation}%
\begin{equation}
E_{\boldsymbol{gg}}=T_{ge}^{t}E_{\boldsymbol{ee}}T_{ge}%
\end{equation}


\item
\begin{align}
\left[  \boldsymbol{ee}^{d}\right]  \left(  v\right)   &  =\left(
\boldsymbol{e}\right)  \cdot\left(  \boldsymbol{e}^{d}\right)  ^{t}\left(
v\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\\
\vdots\\
e_{n}^{d}%
\end{array}
\right)  \left(  v\right)  =\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
e_{1}^{d}\left(  v\right)  \\
\vdots\\
e_{n}^{d}\left(  v\right)
\end{array}
\right)  \\
&  =\left(  \sum_{1\leq j\leq n}e_{j}e_{j}^{d}\right)  \left(  v\right)
=\sum_{1\leq j\leq n}\left[  e_{j}e_{j}^{d}\right]  \left(  v\right)  =\left(
%
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{n}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\mathcal{R}_{e}\left(  v\right)  _{1}\\
\vdots\\
\mathcal{R}_{e}\left(  v\right)  _{n}%
\end{array}
\right)  .
\end{align}

\end{enumerate}

\subparagraph{Real and imaginary parts of a vector}

Let $V$ be a complex vectore space with bases $\left(  \boldsymbol{e}\right)
=\left\{  \left.  e_{j}\right\vert 1\leq j\leq r\right\}  $ then any vector
$v$ can be expanded as
\begin{equation}
v=I_{V}v=\sum_{1\leq j\leq r}\left[  e_{j}e_{j}^{d}\right]  v=\sum_{1\leq
j\leq r}e_{j}e_{j}^{d}\left(  v\right)  =\sum_{1\leq j\leq r}e_{j}%
\mathcal{R}_{e}\left(  v\right)  _{j},
\end{equation}
where $\mathcal{R}_{e}\left(  v\right)  =\boldsymbol{e}^{d}\left(  v\right)
^{t}\in\mathbb{C}^{r}=\mathcal{M}\left(  r,1,\mathbb{C}\right)  $ is the
representation of $v$ wrt the basis $\left(  \boldsymbol{e}\right)  ,$ which
can be resloved into real and imaginary parts
\begin{equation}
v=\sum_{1\leq j\leq r}\operatorname{Re}\left(  \mathcal{R}_{e}\left(
v\right)  _{j}\right)  e_{j}+i\sum_{1\leq j\leq r}\operatorname{Im}\left(
\mathcal{R}_{e}\left(  v\right)  _{j}\right)  e_{j}.
\end{equation}


\begin{definition}
The real $e$-part of the vector $v$%
\begin{equation}
\operatorname{Re}_{e}\left(  v\right)  =\sum_{1\leq j\leq r}\operatorname{Re}%
\left(  \mathcal{R}_{e}\left(  v\right)  _{j}\right)  e_{j}%
\end{equation}
and the imaginary $e$-part of the vector $v$
\begin{equation}
\operatorname{Im}_{e}\left(  v\right)  =\sum_{1\leq j\leq r}\operatorname{Im}%
\left(  \mathcal{R}_{e}\left(  v\right)  _{j}\right)  e_{j}.
\end{equation}

\end{definition}

\begin{remark}
The maps producing these parts are real linear maps i.e.
\begin{equation}
\operatorname{Re}_{e},\operatorname{Im}_{e}\in\mathcal{B}_{\mathbb{R}}\left(
V\right)  .
\end{equation}

\end{remark}

\begin{remark}%
\begin{equation}
v=\operatorname{Re}_{e}\left(  v\right)  +i\operatorname{Im}_{e}\left(
v\right)  =\operatorname{Re}_{f\ }\left(  v\right)  +i\operatorname{Im}%
_{f}\left(  v\right)  ,
\end{equation}
i.e.
\begin{equation}
\operatorname{Re}_{e}+i\operatorname{Im}_{e}=I_{V}.
\end{equation}
Obviously the real and imaginary parts of a vector are only invariant to real
transformations $T\in GL\left(  V,\mathbb{R}\right)  $ and depend on
equivalence classes of bases.
\end{remark}

\subparagraph{Representations}

Consider vector spaces $V$ and $W$ with bases $\left(  \boldsymbol{e}\right)
=\left\{  \left.  e_{j}\right\vert 1\leq j\leq n\right\}  ,\left(
\boldsymbol{v}\right)  =\left\{  \left.  v_{j}\right\vert 1\leq j\leq
n\right\}  $ and $\left(  \boldsymbol{f}\right)  =\left\{  \left.
f_{j}\right\vert 1\leq j\leq m\right\}  ,\left(  \boldsymbol{w}\right)
=\left\{  \left.  w_{j}\right\vert 1\leq j\leq m\right\}  :$

\begin{enumerate}
\item Where the dimensions of the spaces are
\begin{align}
\dim\left\{  V\right\}   &  =n\\
\dim\left\{  W\right\}   &  =m.
\end{align}


\item Consider linear maps $A\in\mathcal{B}_{00}\left(  W,V\right)  \ $that
have the effect%
\begin{align}
Av_{j}  &  =w_{j},\quad1\leq j\leq n\\
Ae_{j}  &  =f_{j},\quad1\leq j\leq n,
\end{align}


\item where
\begin{align}
\ker\left\{  A\right\}   &  =\left\{  \left.  e_{j}\right\vert m+1\leq j\leq
n\right\} \\
\ker\left\{  A\right\}  ^{\bot}  &  =\left\{  \left.  e_{j}\right\vert 1\leq
j\leq m\right\} \\
\operatorname*{range}\left\{  A\right\}   &  =\left\{  \left.  f_{j}%
\right\vert 1\leq j\leq m\right\}  .
\end{align}


\item The $\mathcal{R}_{ee}$ representation of the map $A$ wrt the basis
$\left(  \boldsymbol{e}\right)  $ is given by
\begin{align}
A\left(  \boldsymbol{e}\right)   &  =\left(  \boldsymbol{e}\right)
\mathcal{R}_{ee}\left(  A\right) \\
\boldsymbol{e}^{d}\left(  A\left(  \boldsymbol{e}\right)  \right)   &
=\boldsymbol{e}^{d}\left(  \boldsymbol{e}\right)  \mathcal{R}_{ee}\left(
A\right)  =\mathcal{R}_{ee}\left(  A\right)  .
\end{align}


\item As
\begin{equation}
A\left(  \boldsymbol{e}\right)  =\left(  \boldsymbol{f}\right)  =\left(
\boldsymbol{e}\right)  \mathcal{R}_{ee}\left(  A\right)
\end{equation}
and the columns of $\mathcal{R}_{ee}\left(  A\right)  $ are the $\mathcal{R}%
_{e}$ representations $\left\{  \left.  \mathcal{R}_{e}\left(  f_{j}\right)
\right\vert 1\leq j\leq m\right\}  $ of the vectors $\left\{  \left.
f_{j}\right\vert 1\leq j\leq m\right\}  .$

\item One can see that
\begin{align}
\boldsymbol{f}^{d}\left(  \boldsymbol{f}\right)    & =\boldsymbol{f}%
^{d}\left(  A\left(  \boldsymbol{e}\right)  \right)  =\left(
\begin{array}
[c]{c}%
f_{1}^{d}\\
\vdots\\
f_{m}^{d}%
\end{array}
\right)  A\left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{m}%
\end{array}
\right)  =\left(
\begin{array}
[c]{c}%
f_{1}^{d}\\
\vdots\\
f_{m}^{d}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
Ae_{1} & \cdots & Ae_{m}%
\end{array}
\right)  \\
& =\boldsymbol{f}^{d}\left(  \boldsymbol{e}\right)  \mathcal{R}_{ee}\left(
A\right)  =\left(
\begin{array}
[c]{c}%
f_{1}^{d}\\
\vdots\\
f_{m}^{d}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
e_{1} & \cdots & e_{m}%
\end{array}
\right)  \mathcal{R}_{ee}\left(  A\right)  =\mathbb{P}_{m}%
\end{align}
and hence
\begin{equation}
\boldsymbol{f}^{d}\left(  \boldsymbol{e}\right)  =\mathcal{R}_{ee}\left(
A\right)  ^{-1}.
\end{equation}


\item The linear map $A$ can be expanded as%
\[
A=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  e_{j}e_{k}^{d}\right]
\mathcal{R}_{ee}\left(  A\right)  _{jk}=\sum_{\substack{1\leq j\leq m\\1\leq
k\leq n}}E_{e_{j}e_{k}^{d}}\mathcal{R}_{ee}\left(  A\right)  _{jk}%
\]
giving its action as
\begin{equation}
Ae_{l}=\sum_{1\leq j,k\leq n}\left[  e_{j}e_{k}^{d}\right]  \mathcal{R}%
_{ee}\left(  A\right)  _{jk}\left(  e_{l}\right)  =\sum_{1\leq j\leq m}%
e_{j}\mathcal{R}_{ee}\left(  A\right)  _{jl}%
\end{equation}
and
\begin{equation}
Ae_{l}=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}\left[  f_{j}e_{k}%
^{d}\right]  \mathcal{R}_{fe}\left(  A\right)  _{jk}\left(  e_{l}\right)
=\sum_{\substack{1\leq j\leq m\\1\leq k\leq n}}E_{f_{j}e_{k}^{d}}\left(
e_{l}\right)  \mathcal{R}_{fe}\left(  A\right)  _{jk}=\sum_{1\leq j\leq
m}f_{j}\mathcal{R}_{fe}\left(  A\right)  _{jl}.
\end{equation}


\begin{enumerate}
\item The dual linear map $A^{d}$ has the representations
\begin{equation}
\left(  f_{l}A\right)  ^{d}\left(  e_{j}\right)  =\left[  A^{d}f_{l}%
^{d}\right]  \left(  e_{j}\right)  =f_{l}^{d}\left(  Ae_{j}\right)
=\mathcal{R}_{fe}\left(  A\right)  _{lj}%
\end{equation}
and
\begin{equation}
\left(  e_{l}A\right)  ^{d}\left(  e_{j}\right)  =\left[  A^{d}e_{l}%
^{d}\right]  \left(  e_{j}\right)  =e_{l}^{d}\left(  Ae_{j}\right)
=\mathcal{R}_{ee}\left(  A\right)  _{lj}%
\end{equation}
giving
\begin{equation}
\left(  A^{d}e_{l}^{d}\right)  \left(  e_{j}\right)  =\sum_{1\leq k\leq
n}e_{k}^{d}\left(  e_{j}\right)  \mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)
_{jl}=\mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)  _{jl}=e_{c}^{d}\left(
Ae_{j}\right)  =\sum_{1\leq k\leq n}e_{l}^{d}\left(  e_{k}\right)
\mathcal{R}_{ee}\left(  A\right)  _{kj}=\mathcal{R}_{ee}\left(  A\right)
_{kj}%
\end{equation}
that leads to
\begin{align}
\mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)  _{jl} &  =\mathcal{R}%
_{ee}\left(  A\right)  _{lj}\\
\text{i.e. }\mathcal{R}_{e^{d}e^{d}}\left(  A^{d}\right)   &  =\mathcal{R}%
_{ee}\left(  A\right)  ^{t}.
\end{align}


\item The transformation between the vectors $\left\{  f_{j}\right\}  $ and
$\left\{  h_{j}\right\}  $%
\begin{equation}
\ \ f_{_{j}}=\sum_{1\leq k\leq m}h_{k}\mathcal{R}_{hh}\left(  T_{fh}\right)
_{kj},\quad1\leq j\leq m
\end{equation}
the transformation between the vectors $\left\{  e_{j}\right\}  $ and
$\left\{  g_{j}\right\}  $%
\begin{equation}
e_{_{j}}=\sum_{1\leq k\leq m}g_{k}\mathcal{R}_{gg}\left(  T_{eg}\right)
_{kj},\quad1\leq k\leq n
\end{equation}
gives the transformation between the elementary operators%
\begin{equation}
\left[  g_{j}g_{k}^{d}\right]  \left(  v\right)  =\sum_{1\leq j_{1},k_{1}\leq
n}\mathcal{R}_{ee}\left(  T_{ge}\right)  _{kj_{1}}^{t}\left[  e_{j_{1}%
}e_{k_{1}}^{d}\right]  \left(  v\right)  \mathcal{R}_{ee}\left(
T_{ge}\right)  _{k_{1}k}.
\end{equation}
\begin{equation}
E_{f_{j}e_{k}^{d}}=E_{\left(  \sum_{1\leq k\leq m}h_{k}\mathcal{R}_{hh}\left(
T_{fh}\right)  _{kj}\right)  \left(  \sum_{1\leq k\leq m}g_{k}\mathcal{R}%
_{gg}\left(  T_{eg}\right)  _{kj}\right)  }=\sum_{1\leq j\leq n}%
\mathcal{R}_{hh}\left(  T_{fh}\right)  _{kj}E_{g_{j}h_{k}^{d}}%
\end{equation}

\end{enumerate}

\item Representations of $v$ and $w$ are given by
\begin{align}
v &  =I_{V}v=\sum_{1\leq j\leq n}\left[  e_{j}e_{j}^{d}\right]  v=\sum_{1\leq
j\leq n}E_{e_{j}e_{j}^{d}}v=\sum_{1\leq j\leq n}e_{j}e_{j}^{d}\left(
v\right)  =\sum_{1\leq j\leq n}e_{j}\mathcal{R}_{e}\left(  v\right)
_{j}=\left(  \boldsymbol{e}\right)  \mathcal{R}_{e}\left(  v\right)  \\
w &  =I_{W}w=\sum_{1\leq j\leq m}\left[  f_{j}f_{j}^{d}\right]  w=\sum_{1\leq
j\leq n}E_{f_{j}f_{j}^{d}}w=\sum_{1\leq j\leq m}f_{j}f_{j}^{d}\left(
w\right)  =\sum_{1\leq j\leq m}f_{j}\mathcal{R}_{f}\left(  w\right)
_{j}=\left(  \boldsymbol{f}\right)  \mathcal{R}_{f}\left(  w\right)  .
\end{align}


\item
\begin{align}
\mathcal{R}_{e}\left(  v\right)   &  \in\mathcal{M}\left(  n,1,\mathbb{C}%
\right)  \\
\mathcal{R}_{f}\left(  v\right)   &  \in\mathcal{M}\left(  m,1,\mathbb{C}%
\right)
\end{align}


\begin{enumerate}
\item
\begin{gather}
A\left(  \boldsymbol{e}\right)  =\left(  \boldsymbol{f}\right)  =\left(
\boldsymbol{e}\right)  \mathcal{R}_{ee}\left(  A\right)  \\
\left(  \boldsymbol{e}^{d}\right)  ^{t}\cdot A\left(  \boldsymbol{e}\right)
=\left(  \boldsymbol{e}^{d}\right)  ^{t}\cdot\left(  \boldsymbol{f}\right)
=\left(  \boldsymbol{e}^{d}\right)  ^{t}\cdot\left(  \boldsymbol{e}\right)
\mathcal{R}_{ee}\left(  A\right)  =\mathcal{R}_{ee}\left(  A\right)  \\
