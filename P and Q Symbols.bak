\end{align}%
\begin{align}
&  D_{2}=\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}D_{2j_{1}j_{2}k_{1}k_{2}%
}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \nonumber\\
&  D_{1}=\frac{1}{2}\sum_{1\leq j,k,l\leq r}D_{1jlkl}\left\vert \varphi
_{j}\right\rangle \left\langle \varphi_{k}\right\vert \nonumber\\
&  \Gamma_{1}^{2}\left(  D_{1}\right)  =\Gamma_{1}^{2}\circ L_{1}\left(
D\right)  =\sum_{1\leq j,k,l\leq r}D_{1jk}\left\vert \varphi_{k}\varphi
_{l}\right\rangle \left\langle \varphi_{j}\varphi_{l}\right\vert
\,=\sum_{1\leq j,k,l,m\leq r}D_{1jk}\delta_{lm}\left\vert \varphi_{k}%
\varphi_{l}\right\rangle \left\langle \varphi_{j}\varphi_{m}\right\vert
\,=\nonumber\\
&  \sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}\left\{
D_{1j_{1}k_{1}}\delta_{j_{2}k_{2}}-D_{1j_{1}k_{2}}\delta_{j_{2}k_{1}%
}-D_{1j_{2}k_{1}}\delta_{j_{1}k_{2}}+D_{1j_{2}k_{2}}\delta_{j_{1}k_{1}%
}\right\}  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert .
\end{align}
The Q-symbol of $\Gamma_{1}^{2}\circ L_{1}\left(  D\right)  $ is
\begin{equation}
Q_{\Gamma_{1}^{2}\circ L_{1}\left(  D\right)  }\left(  \mathbf{z}\right)
