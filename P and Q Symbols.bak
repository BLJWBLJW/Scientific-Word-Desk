r,1\leq q_{1}<q_{2}\leq r\\1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq
r}}A_{j_{1}j_{2}k_{1}k_{2}}P_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}^{\prime
}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}}^{-1}\left\vert
\left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.  \right\rangle
\right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right) \nonumber\\
&  =\int\Upsilon_{A}\left(  \mathbf{z}^{\prime}\right)  \left\vert
\left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.  \right\rangle
\right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right) \nonumber\\
\Upsilon_{A}\left(  \mathbf{z}^{\prime}\right)   &  =\sum_{\substack{1\leq
p_{1}<p_{2}\leq r,1\leq q_{1}<q_{2}\leq r\\1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}}A_{j_{1}j_{2}k_{1}k_{2}}P_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{z}^{\prime}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}%
}^{-1}.\rfloor
\end{align}
As%
\begin{equation}
P_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}\right)  =\sum_{1\leq j_{1}%
<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}Q_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  \Delta_{j_{1}j_{2}k_{1}k_{2}p_{1}p_{2}q_{1}q_{2}}%
^{-1}\nonumber
