\section{Operator Kernels}

The Thouless parameterization of two particle IPS\
\begin{align}
\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert  &
\equiv\left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\vert
=\widehat{c\left(  \mathbf{z}\right)  }\left(  \left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right)  =c\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert c\left(
\mathbf{z}\right)  ^{\dagger}\nonumber\\
&  =u\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert u\left(  \mathbf{z}\right)
^{\dagger}\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
=\widehat{u\left(  \mathbf{z}\right)  }\left(  \left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right)  \det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
\end{align}
can be used to obtain the resolution of the projector onto $\mathcal{H}^{2}$
\begin{equation}
P_{\mathcal{H}^{2}}=\int\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  =\int\frac{\left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert }{\left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle }d\tilde{\mu}\left(
\mathbf{z}\right)  =\int\widetilde{\left\vert \mathbf{z}\right\rangle
}\widetilde{\left\langle \mathbf{z}\right\vert }d\tilde{\mu}\left(
\mathbf{z}\right)  ,
\end{equation}
where
\begin{equation}
d\tilde{\mu}\left(  \mathbf{z}\right)  =\left\langle \mathbf{z}\left\vert
\mathbf{z}\right.  \right\rangle d\mu\left(  \mathbf{z}\right)  .
\end{equation}
Note that
\begin{align}
\widehat{u\left(  \mathbf{z}\right)  }\left(  A\right)   &  =u\left(
\mathbf{z}\right)  Au\left(  \mathbf{z}\right)  ^{\dagger}\nonumber\\
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  A\right)   &
=u\left(  \mathbf{z}\right)  ^{\dagger}Au\left(  \mathbf{z}\right)  .
\end{align}
Observing that if $A\in\mathcal{B}\left(  \mathcal{H}^{2}\right)  $ then
\begin{equation}
A=P_{\mathcal{H}^{2}}AP_{\mathcal{H}^{2}}%
\end{equation}
and one can then construct a biholomorphic representation of operators $A$ wrt
to the measures $\mu$ and $\tilde{\mu}$ by
\begin{align}
A &  =\int\left\vert \mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}%
_{1}\right\vert A\left\vert \mathbf{z}_{2}\right\rangle \left\langle
\mathbf{z}_{2}\right\vert d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(
\mathbf{z}_{2}\right)  \nonumber\\
&  =\int\frac{\left\vert \mathbf{z}_{1}\right\rangle }{\sqrt{\left\langle
\mathbf{z}_{1}\left\vert \mathbf{z}_{1}\right.  \right\rangle }}%
\frac{\left\langle \mathbf{z}_{1}\left\vert A\mathbf{z}_{2}\right.
\right\rangle }{\sqrt{\left\langle \mathbf{z}_{1}\left\vert \mathbf{z}%
_{1}\right.  \right\rangle \left\langle \mathbf{z}_{2}\left\vert
\mathbf{z}_{2}\right.  \right\rangle }}\frac{\left\langle \mathbf{z}%
_{2}\right\vert }{\sqrt{\left\langle \mathbf{z}_{2}\left\vert \mathbf{z}%
_{2}\right.  \right\rangle }}d\tilde{\mu}\left(  \mathbf{z}_{1}\right)
d\tilde{\mu}\left(  \mathbf{z}_{2}\right)  \nonumber\\
&  =\int A\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  \left\vert
\mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}_{2}\right\vert d\mu\left(
\mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}_{2}\right)  \nonumber\\
&  =\int\tilde{A}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)
\frac{\left\vert \mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}%
_{2}\right\vert }{\sqrt{\left\langle \mathbf{z}_{1}\left\vert \mathbf{z}%
_{1}\right.  \right\rangle \left\langle \mathbf{z}_{2}\left\vert
\mathbf{z}_{2}\right.  \right\rangle }}d\tilde{\mu}\left(  \mathbf{z}%
_{1}\right)  d\tilde{\mu}\left(  \mathbf{z}_{2}\right)  ,
\end{align}
where
\begin{subequations}
\label{Q-Symbols}%
\begin{align}
A\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)   &  =\left\langle
\mathbf{z}_{1}\left\vert A\mathbf{z}_{2}\right.  \right\rangle =\left\langle
\varphi_{1}\varphi_{2}\left\vert c\left(  \mathbf{z}_{1}\right)  ^{\dagger
}Ac\left(  \mathbf{z}_{2}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle
\nonumber\\
\tilde{A}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)   &
=\frac{\left\langle \mathbf{z}_{1}\left\vert A\mathbf{z}_{2}\right.
\right\rangle }{\sqrt{\left\langle \mathbf{z}_{1}\left\vert \mathbf{z}%
_{1}\right.  \right\rangle \left\langle \mathbf{z}_{2}\left\vert
\mathbf{z}_{2}\right.  \right\rangle }}=\left\langle \varphi_{1}\varphi
_{2}\left\vert u\left(  \mathbf{z}_{1}\right)  ^{\dagger}Au\left(
\mathbf{z}_{2}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle .
\end{align}
These representations have the following action on a holomorphic wavefunction
\end{subequations}
\begin{align}
A\left\vert g\right\rangle  &  =\left\vert Ag\right\rangle =\nonumber\\
\int\left\vert \mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}%
_{1}\right\vert A\left\vert \mathbf{z}_{2}\right\rangle \left\langle
\mathbf{z}_{2}\right\vert \left\vert g\right\rangle d\mu\left(  \mathbf{z}%
_{1}\right)  d\mu\left(  \mathbf{z}_{2}\right)   &  =\int A\left(
\mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  \left\vert \mathbf{z}%
_{1}\right\rangle \left\langle \mathbf{z}_{2}\right\vert \left\vert
g\right\rangle d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}%
_{2}\right)  \nonumber\\
&  =\int\left(  A\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)
\left\langle \mathbf{z}_{2}\right\vert \left\vert g\right\rangle d\mu\left(
\mathbf{z}_{2}\right)  \right)  \left\vert \mathbf{z}_{1}\right\rangle
d\mu\left(  \mathbf{z}_{1}\right)  \nonumber\\
&  =\int A\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  g\left(
\mathbf{\bar{z}}_{2}\right)  d\mu\left(  \mathbf{z}_{2}\right)  \left\vert
\mathbf{z}_{1}\right\rangle d\mu\left(  \mathbf{z}_{1}\right)  \nonumber\\
\left[  Ag\right]  \left(  \mathbf{\bar{z}}_{1}\right)   &  =\int A\left(
\mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  g\left(  \mathbf{\bar{z}}%
_{2}\right)  d\mu\left(  \mathbf{z}_{2}\right)
\end{align}
and%
\begin{align}
A\left\vert g\right\rangle = &  \int\frac{\left\vert \mathbf{z}_{1}%
\right\rangle }{\sqrt{\left\langle \mathbf{z}_{1}\left\vert \mathbf{z}%
_{1}\right.  \right\rangle }}\frac{\left\langle \mathbf{z}_{1}\left\vert
A\mathbf{z}_{2}\right.  \right\rangle }{\sqrt{\left\langle \mathbf{z}%
_{1}\left\vert \mathbf{z}_{1}\right.  \right\rangle \left\langle
\mathbf{z}_{2}\left\vert \mathbf{z}_{2}\right.  \right\rangle }}%
\frac{\left\langle \mathbf{z}_{2}\right\vert }{\sqrt{\left\langle
\mathbf{z}_{2}\left\vert \mathbf{z}_{2}\right.  \right\rangle }}\left\vert
g\right\rangle d\tilde{\mu}\left(  \mathbf{z}_{1}\right)  d\tilde{\mu}\left(
\mathbf{z}_{2}\right)  \nonumber\\
&  =\int\left(  \tilde{A}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)
\tilde{g}\left(  \mathbf{\bar{z}}_{2}\right)  d\tilde{\mu}\left(
\mathbf{z}_{2}\right)  \right)  \frac{\left\vert \mathbf{z}_{1}\right\rangle
}{\sqrt{\left\langle \mathbf{z}_{1}\left\vert \mathbf{z}_{1}\right.
\right\rangle }}d\tilde{\mu}\left(  \mathbf{z}_{1}\right)  \nonumber\\
\widetilde{\left[  Ag\right]  }\left(  \mathbf{\bar{z}}_{1}\right)   &
=\int\tilde{A}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  \tilde
{g}\left(  \mathbf{\bar{z}}_{2}\right)  d\tilde{\mu}\left(  \mathbf{z}%
_{2}\right)  .
\end{align}


The ket-bra expansion of an operator $A$ in the reference basis $\left\{
\left.  \left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \right\vert 1\leq j_{1}<j_{2}\leq
r,1\leq k_{1}<k_{2}\leq r\right\}  $ is
\begin{align}
A  &  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert A\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}%
}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert ,
\end{align}
where
\begin{align}
A_{j_{1}j_{2}k_{1}k_{2}}  &  =\operatorname*{Tr}\left\{  \left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert A\right\}  =\operatorname*{Tr}\left\{  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert ^{\dagger}A\right\} \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}\right\vert A\right)
\end{align}
The biholomorphic integral kernel $A$ can thus be expanded as
\begin{align}
A\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)   &  =\sum_{1\leq
j_{1}<j_{2},k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}}\left\langle
\mathbf{z}_{1}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right.  \right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\left\vert \mathbf{z}_{2}\right.
\right\rangle \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}%
}\mathcal{T}_{k_{1}k_{2}j_{1}j_{2}}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}%
_{2}\right) \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}%
}\mathcal{\tilde{T}}_{k_{1}k_{2}j_{1}j_{2}}\left(  \mathbf{\bar{z}}%
_{1},\mathbf{z}_{2}\right)  \sqrt{\left\langle \mathbf{z}_{1}\left\vert
\mathbf{z}_{1}\right.  \right\rangle \left\langle \mathbf{z}_{2}\left\vert
\mathbf{z}_{2}\right.  \right\rangle },
\end{align}
where the biholomorphic integral kernels of the bases are related by
\begin{equation}
\mathcal{T}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}%
_{2}\right)  =\mathcal{\tilde{T}}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{\bar
{z}}_{1},\mathbf{z}_{2}\right)  \sqrt{\left\langle \mathbf{z}_{1}\left\vert
\mathbf{z}_{1}\right.  \right\rangle \left\langle \mathbf{z}_{2}\left\vert
\mathbf{z}_{2}\right.  \right\rangle }%
\end{equation}
and
\begin{subequations}
\label{Q-Sym}%
\begin{align}
\mathcal{\tilde{T}}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{\bar{z}}%
_{1},\mathbf{z}_{2}\right)   &  =\frac{\operatorname*{Tr}\left\{  \left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert \left\vert \mathbf{z}_{2}\right\rangle
\left\langle \mathbf{z}_{1}\right\vert \right\}  }{\sqrt{\left\langle
\mathbf{z}_{1}\left\vert \mathbf{z}_{1}\right.  \right\rangle \left\langle
\mathbf{z}_{2}\left\vert \mathbf{z}_{2}\right.  \right\rangle }}\nonumber\\
\mathcal{T}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{\bar{z}}_{1},\mathbf{z}%
_{2}\right)   &  =\operatorname*{Tr}\left\{  \left\vert \varphi_{k_{1}}%
\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \left\vert \mathbf{z}_{2}\right\rangle \left\langle
\mathbf{z}_{1}\right\vert \right\}  .
\end{align}


The kernels $\left\{  \left.  \mathcal{T}_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  \right\vert 1\leq j_{1}%
<j_{2},k_{1}<k_{2}\leq r\right\}  $ form a biholomorphic conb for
$\mathfrak{F}_{op}=\mathcal{R}_{hol}\left(  \mathcal{B}_{2}\left(
\mathcal{H}^{2}\right)  \right)  \subset L_{2}\left(  \mathbb{C}^{4\left(
r-2\right)  },\mu\right)  $ as%
\end{subequations}
\begin{align}
&  \int\overline{\mathcal{T}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{\bar{z}%
}_{1},\mathbf{z}_{2}\right)  }\mathcal{T}_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  d\mu\left(  \mathbf{z}_{1}\right)
d\mu\left(  \mathbf{z}_{2}\right)  \nonumber\\
&  =\int\overline{\left\langle \mathbf{z}_{1}\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right.  \right\rangle \left\langle \varphi_{k_{1}}%
\varphi_{k_{2}}\left\vert \mathbf{z}_{2}\right.  \right\rangle }\left\langle
\mathbf{z}_{1}\left\vert \varphi_{p_{1}}\varphi_{p_{2}}\right.  \right\rangle
\left\langle \varphi_{q_{1}}\varphi_{q_{2}}\left\vert \mathbf{z}_{2}\right.
\right\rangle d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}%
_{2}\right)  \nonumber\\
&  =\int\left\langle \varphi_{q_{1}}\varphi_{q_{2}}\left\vert \mathbf{z}%
_{2}\right.  \right\rangle \left\langle \mathbf{z}_{2}\left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right.  \right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\left\vert \mathbf{z}_{1}\right.  \right\rangle
\left\langle \mathbf{z}_{1}\left\vert \varphi_{p_{1}}\varphi_{p_{2}}\right.
\right\rangle d\mu\left(  \mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}%
_{2}\right)  \nonumber\\
&  =\left\langle \varphi_{q_{1}}\varphi_{q_{2}}\left\vert \varphi_{k_{1}%
}\varphi_{k_{2}}\right.  \right\rangle \left\langle \varphi_{j_{1}}%
\varphi_{j_{2}}\left\vert \varphi_{p_{1}}\varphi_{p_{2}}\right.  \right\rangle
=\delta_{\left(  q_{1}q_{2}\right)  \left(  k_{1}k_{2}\right)  }%
\delta_{\left(  j_{1}j_{2}\right)  \left(  p_{1}p_{2}\right)  }%
\end{align}
and are also bases for $\mathcal{R}_{hol}\left(  \mathcal{B}_{1}\left(
\mathcal{H}^{2}\right)  \right)  $ and $\mathcal{R}_{hol}\left(
\mathcal{B}\left(  \mathcal{H}^{2}\right)  \right)  .$ $\lceil$ needs to be
checked$\rfloor$

\subsection{Q-Symbols}

The Q-symbols, $\left\{  Q_{j_{1}j_{2}k_{1}k_{2}}\right\}  $ and $\left\{
\tilde{Q}_{j_{1}j_{2}k_{1}k_{2}}\right\}  ,$ wrt the measures $\mu$ and
$\tilde{\mu}$ of the ket-bra basis elements are given by
\begin{align}
Q_{k_{1}k_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)   &  =\operatorname*{Tr}%
\left\{  \left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right\}  =\left(  \left.
\overset{}{\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert }\right\vert \overset{}{\left\vert \varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
}\right)  ,\nonumber\\
\tilde{Q}_{k_{1}k_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)   &
=\operatorname*{Tr}\left\{  \widetilde{\left\vert \mathbf{z}\right\rangle
}\widetilde{\left\langle \mathbf{z}\right\vert }\left\vert \varphi_{k_{1}%
}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \right\}  =\left(  \left.  \overset{}{\widetilde{\left\vert
\mathbf{z}\right\rangle }\widetilde{\left\langle \mathbf{z}\right\vert }%
}\right\vert \overset{}{\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert }\right)  ,
\end{align}
i.e.
\begin{align}
Q_{k_{1}k_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)   &  =\operatorname*{Tr}%
\left\{  \left\vert \varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \varphi_{1}\left(
\mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\vert
\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right\}  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{1}\left(  \mathbf{z}%
\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert }\right\vert \overset{}{\left\vert \varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
}\right)  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert }\right\vert c\left(
\mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert c\left(
\mathbf{z}\right)  \right)  \nonumber\\
&  =\gamma_{2}\left(  \mathbf{z}\right)  _{j_{1}j_{2k_{1}k_{2}}}\det\left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  =\widehat{u\left(
\mathbf{z}\right)  }^{\dagger}\left(  \left\vert \varphi_{k_{1}}\varphi
_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
\right)  \det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
,\nonumber\\
\tilde{Q}_{k_{1}k_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)   &
=\operatorname*{Tr}\left\{  \left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert \left\vert \varphi_{k_{1}}%
\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \right\}  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \tilde{\varphi}_{1}\left(
\mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert }\right\vert \overset{}{\left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert }\right)  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert }\right\vert
\overset{}{u\left(  \mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{k_{1}%
}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert }u\left(  \mathbf{z}\right)  \right)  \nonumber\\
&  =\gamma_{2}\left(  \mathbf{z}\right)  _{j_{1}j_{2k_{1}k_{2}}}%
=\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  \left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert \right)  .
\end{align}
\emph{Note that}
\begin{equation}
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  \left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert \right)  \neq\left\vert \varphi_{k_{1}}\left(
\mathbf{z}\right)  \varphi_{k_{2}}\left(  \mathbf{z}\right)  \right\rangle
\left\langle \varphi_{j_{1}}\left(  \mathbf{z}\right)  \varphi_{j_{2}}\left(
\mathbf{z}\right)  \right\vert =\widehat{u\left(  \mathbf{z}\right)  }\left(
\left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle
\varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right)  .
\end{equation}
Thus the Q-symbol, $Q_{A}\left(  \mathbf{z}\right)  $ and $\tilde{Q}%
_{A}\left(  \mathbf{z}\right)  ,$ of any bounded operator $A$ is given by
\begin{equation}
Q_{A}\left(  \mathbf{z}\right)  =\tilde{Q}_{A}\left(  \mathbf{z}\right)
\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
=\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}}\tilde
{Q}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  \left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle .
\end{equation}
Clearly
\begin{equation}
\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert \left\vert \varphi
_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}%
\varphi_{k_{2}}\right\vert \right)  \left(  \left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \right\vert =P_{\mathcal{B}\left(  \mathcal{H}^{2}\right)  },
\end{equation}
as for any $X\in\mathcal{B}\left(  \mathcal{H}^{2}\right)  $
\begin{align}
\left\vert X\right)   &  =\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \right)  \left(  \left.  \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \right\vert X\right)  \nonumber\\
&  =\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert \left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \right)  \operatorname*{Tr}\left\{  \left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert X\right\}  \nonumber\\
&  =\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \operatorname*{Tr}\left\{  \left\vert \varphi_{k_{1}}%
\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert X\right\}  \nonumber\\
&  =\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}X_{j_{1}j_{2}k_{1}k_{2}%
}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert =X,
\end{align}
thus%
\begin{align}
&  \sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left(  \left.
\overset{}{\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert }\right\vert \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}\right)  \left(  \left.  \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}\right\vert X\right)  \nonumber\\
&  \quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad
\quad\quad\quad\quad\quad\quad\quad\quad\left.  =\right.  Q_{X}\left(
\mathbf{z}\right)  =X\left(  \mathbf{z}\right)  _{1212},
\end{align}
as
\begin{align}
& \sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left(  \left.
\overset{}{\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert }\right\vert \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}\right)  \left(  \left.  \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}\right\vert X\right)  \nonumber\\
& =\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left(  \left.
\overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert }\right\vert \overset{}{\widehat{u\left(
\mathbf{z}\right)  }^{\dagger}\left(  X\right)  }\right)  =\sum_{1\leq
j_{1},j_{2},k_{1},k_{2}\leq r}\left(  \left.  \overset{}{\left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert }\right\vert \overset{}{\widehat{c\left(  \mathbf{z}\right)
}^{\dagger}\left(  X\right)  }\right)  =X\left(  \mathbf{z}\right)  _{1212},
\end{align}
which should be compared to
\begin{align}
&  \int\left(  \left.  \overset{}{\left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert }\right\vert \frac{\left\vert
\mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}_{2}\right\vert }%
{\sqrt{\left\langle \mathbf{z}_{1}\left\vert \mathbf{z}_{1}\right.
\right\rangle \left\langle \mathbf{z}_{2}\left\vert \mathbf{z}_{2}\right.
\right\rangle }}\right)  \left(  \left.  \frac{\left\vert \mathbf{z}%
_{1}\right\rangle \left\langle \mathbf{z}_{2}\right\vert }{\sqrt{\left\langle
\mathbf{z}_{1}\left\vert \mathbf{z}_{1}\right.  \right\rangle \left\langle
\mathbf{z}_{2}\left\vert \mathbf{z}_{2}\right.  \right\rangle }}\right\vert
X\right)  d\tilde{\mu}\left(  \mathbf{z}_{1}\right)  d\tilde{\mu}\left(
\mathbf{z}_{2}\right)  \nonumber\\
&  =Q_{X}\left(  \mathbf{z}\right)  =X\left(  \mathbf{z}\right)  _{1212}.
\end{align}


\subsubsection{Transformation of Q-Symbols}

The Q-symbol of a two particle operator is given as
\begin{align}
Q_{X}\left(  \mathbf{z}\right)   &  =\tilde{Q}_{X}\left(  \mathbf{z}\right)
\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
=\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}X_{j_{1}j_{2}k_{1}k_{2}}\tilde
{Q}_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  \left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}X_{j_{1}j_{2}k_{1}k_{2}}%
Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =\operatorname*{Tr}\left\{
\left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert
\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}X_{j_{1}j_{2}k_{1}k_{2}}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \right\}  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{1}\left(  \mathbf{z}%
\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert }\right\vert \sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}%
X_{j_{1}j_{2}k_{1}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert \right)  \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}X_{j_{1}j_{2}k_{1}k_{2}}\left(
\left.  \overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert }\right\vert \overset{}{c\left(
\mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}c\left(  \mathbf{z}\right)  \right)  \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}X_{j_{1}j_{2}k_{1}k_{2}}\left(
\left.  \overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert }\right\vert \overset{}{u\left(
\mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}u\left(  \mathbf{z}\right)  \right)  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{1}\left(  \mathbf{z}%
\right)  \varphi_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\varphi_{1}\left(  \mathbf{z}\right)  \varphi_{2}\left(  \mathbf{z}\right)
\right\vert }\right\vert X\right)  =X\left(  \mathbf{z}\right)  _{1212}%
\end{align}
and
\begin{align}
\tilde{Q}_{D_{2}}\left(  \mathbf{z}\right)   &  =\sum_{1\leq j_{1}<j_{2}%
,k_{1}<k_{2}\leq r}D_{2j_{1}j_{2}k_{1}k_{2}}\left(  \left.
\overset{}{\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert }\right\vert \overset{}{u\left(
\mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert u\left(
\mathbf{z}\right)  }\right)  \nonumber\\
&  =D_{2}\left(  \mathbf{z}\right)  _{1212}\left\langle \mathbf{z}\left\vert
\mathbf{z}\right.  \right\rangle ,
\end{align}
where \emph{it should be noted that }
\begin{equation}
X\left(  \mathbf{z}\right)  =u\left(  \mathbf{z}\right)  ^{\dagger}Xu\left(
\mathbf{z}\right)  =\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(
X\right)  .
\end{equation}
One can recover $X$ from $Q_{X}$ by
\begin{align}
X &  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}X{}_{j_{1}%
j_{2}k_{1}k_{2}}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}\left\{  \left.
Q_{X}\right\vert P_{j_{1}j_{2}k_{1}k_{2}}\right\}  \left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \nonumber\\
&  \equiv\sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}\left\{
\left.  \overset{}{Q_{X}}\right\vert \overset{}{P_{j_{1}j_{2}k_{1}k_{2}}%
}\right\}  \left\vert \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
}\right)  =\left\vert X\right)  .
\end{align}
The FORDO $D_{1}$ is then given by
\begin{equation}
D_{1}=\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},k_{1}\leq r}\left\{
Q_{D_{2}}\left\vert \sum_{1\leq l\leq r}P_{j_{1}lk_{1}l}\right.  \right\}
\left\vert \overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert }\right)  =\left\vert D_{1}\right)  .
\end{equation}
The SORDO $D_{2}\left(  \mathbf{z}\right)  $ of $D\left(  \mathbf{z}\right)
=\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  D\right)  $ is
defined by%
\begin{equation}
D_{2}\left(  \mathbf{z}\right)  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}D_{2}\left(  \mathbf{z}\right)  {}_{j_{1}j_{2}k_{1}k_{2}%
}\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert ,
\end{equation}
where%
\begin{align}
&  f_{D}\left(  \Phi\left(  \tilde{\varphi}_{j_{1}}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{j_{2}}\left(  \mathbf{z}%
\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{k_{2}}\left(
\mathbf{z}\right)  \right)  \Phi\left(  \tilde{\varphi}_{k_{1}}\left(
\mathbf{z}\right)  \right)  \right)  =f_{D}\left(  \widehat{u\left(
\mathbf{z}\right)  }\left(  a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{2}%
}a_{k_{1}}\right)  \right)  \nonumber\\
&  =\left(  \left.  \overset{}{\widehat{u\left(  \mathbf{z}\right)  }\left(
a_{k_{1}}^{\dagger}a_{k_{2}}^{\dagger}a_{j_{2}}a_{j_{1}}\right)  }\right\vert
D\right)  =\left(  \left.  \overset{}{\widehat{u\left(  \mathbf{z}\right)
}\left(  \Gamma\left(  \left\vert \varphi_{k_{1}}\varphi_{k_{2}}\right\rangle
\left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert \right)  \right)
}\right\vert D\right)  \nonumber\\
&  =\left(  \left.  \overset{}{\Gamma\left(  \left\vert \varphi_{k_{1}}%
\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}%
}\right\vert \right)  }\right\vert \widehat{u\left(  \mathbf{z}\right)
}^{\dagger}\left(  D\right)  \right)  =\left(  \left.  \overset{}{\left\vert
\varphi_{k_{1}}\varphi_{k_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert }\right\vert L_{2}\left(  \widehat{u\left(
\mathbf{z}\right)  }^{\dagger}\left(  D\right)  \right)  \right)  \nonumber\\
&  =\left(  \left.  \overset{}{\left\vert \varphi_{k_{1}}\varphi_{k_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
}\right\vert \widehat{u\left(  \mathbf{z}\right)  }^{\dagger}L_{2}\left(
\left(  D\right)  \right)  \right)  =D_{2}\left(  \mathbf{z}\right)
_{j_{1}j_{2}k_{1}k_{2}}.
\end{align}
The Q-symbol of $D_{2}$ is given as
\begin{equation}
Q_{D_{2}}\left(  \mathbf{z}\right)  =D_{2}\left(  \mathbf{z}\right)  _{1212},
\end{equation}
i.e. it is the $\left(  12,12\right)  $ matrix element of the SORDO
$\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  D_{2}\right)  $ and
as $\mathbf{z\in}\mathbb{C}^{2\left(  r-2\right)  }$ varies \emph{all
}possible $\left(  12,12\right)  $ matrix elements are generated for every
SORDO Thus
\begin{align}
&  \widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  D_{2}\right)
\nonumber\\
&  \equiv\sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}\left\{
\left.  \overset{}{Q_{D_{2}}}\right\vert \overset{}{P_{j_{1}j_{2}k_{1}k_{2}}%
}\right\}  \left\vert \widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(
\overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert }\right)  \right)  =\left\vert
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  D_{2}\right)  \right)
\end{align}
and
\begin{align}
Q_{D_{2}}\left(  \mathbf{z}\right)   &  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}\left\{  \left.  \overset{}{Q_{D_{2}}}\right\vert
\overset{}{P_{j_{1}j_{2}k_{1}k_{2}}}\right\}  \left(  \left\vert \varphi
_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\left\vert \widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(
\overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert }\right)  \right.  \right)
\nonumber\\
&  =\left(  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert \left\vert \widehat{u\left(  \mathbf{z}%
\right)  }^{\dagger}\left(  D_{2}\right)  \right.  \right)  .
\end{align}
The FORDO $D_{1}\left(  \mathbf{z}\right)  $ is given by
\begin{equation}
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  D_{1}\right)
=\frac{1}{2\left(  N-1\right)  }\sum_{1\leq j_{1},k_{1}\leq r}\left\{
Q_{D_{2}}\left\vert \sum_{1\leq l\leq r}P_{j_{1}lk_{1}l}\right.  \right\}
\left\vert \widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi
_{k_{1}}\right\vert }\right)  \right)  =\left\vert \widehat{u\left(
\mathbf{z}\right)  }^{\dagger}\left(  D_{1}\right)  \right)  ,
\end{equation}
the FORDM\ by
\begin{equation}
D_{1}\left(  \mathbf{z}\right)  _{j_{1}k_{1}}=\frac{1}{2\left(  N-1\right)
}\left\{  Q_{D_{2}}\left\vert \sum_{1\leq m,n,l\leq r}P_{j_{1}lk_{1}l}\right.
\right\}  \left(  \left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert \left\vert \widehat{u\left(  \mathbf{z}\right)
}^{\dagger}\left(  \overset{}{\left\vert \varphi_{m}\right\rangle \left\langle
\varphi_{n}\right\vert }\right)  \right.  \right)
\end{equation}
and in particular
\begin{align}
D_{1}\left(  \mathbf{z}\right)  _{11} &  =\left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert \left\vert
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  D_{1}\right)  \right.
\right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\left\{  Q_{D_{2}}\left\vert \sum_{1\leq
m,n,l\leq r}P_{j_{1}lk_{1}l}\right.  \right\}  \left(  \left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert \left\vert
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  \overset{}{\left\vert
\varphi_{m}\right\rangle \left\langle \varphi_{n}\right\vert }\right)
\right.  \right)  .
\end{align}
Thus one can observe that $D_{1}\left(  \mathbf{z}\right)  _{11}$ is a linear
functional of $Q_{D_{2}}$ i.e.
\begin{equation}
D_{1}\left(  \mathbf{z}\right)  _{11}=\left[  \mathcal{L}_{11}\left(
Q_{D_{2}}\right)  \right]  \left(  \mathbf{z}\right)  =\int\mathcal{L}%
_{11}\left(  \mathbf{z,z}^{\prime}\right)  Q_{D_{2}}\left(  \mathbf{z}%
^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)
\end{equation}
and $D_{1}\left(  \mathbf{z}\right)  _{11}$ is a Q-symbol$.$ Examining the
relationships
\begin{align}
&  D_{1}\left(  \mathbf{z}\right)  _{11}=\left(  \left\vert \tilde{\varphi
}_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \right\vert \left\vert D_{1}\right.  \right)
\nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\left\{  Q_{D_{2}}\left\vert \sum_{1\leq
j_{1},k_{1},l\leq r}P_{j_{1}lk_{1}l}\right.  \right\}  \left(  \left\vert
\varphi_{1}\right\rangle \left\langle \varphi_{1}\right\vert \left\vert
\widehat{u\left(  \mathbf{z}\right)  }^{\dagger}\left(  \overset{}{\left\vert
\varphi_{j_{1}}\right\rangle \left\langle \varphi_{k_{1}}\right\vert }\right)
\right.  \right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\int\sum_{1\leq j_{1},k_{1},l\leq
r}P_{j_{1}lk_{1}l}\left(  \mathbf{z}^{\prime}\right)  \operatorname*{Tr}%
\left\{  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert }\right\}  Q_{D_{2}}\left(  \mathbf{z}^{\prime
}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\int\sum_{1\leq j_{1},k_{1},l\leq
r}P_{j_{1}lk_{1}l}\left(  \mathbf{z}^{\prime}\right)  \operatorname*{Tr}%
\left\{  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert \overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}^{\prime
}\right)  Q_{D_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(
\mathbf{z}^{\prime}\right)
\end{align}
one can then see that
\[
\mathcal{L}_{11}\left(  \mathbf{z,z}^{\prime}\right)  =\frac{1}{2\left(
N-1\right)  }\sum_{1\leq j_{1},k_{1},l\leq r}P_{j_{1}lk_{1}l}\left(
\mathbf{z}^{\prime}\right)  \operatorname*{Tr}\left\{  \left\vert
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right\vert
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi
_{k_{1}}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}^{\prime}\right)  .
\]
$\lceil$%
\begin{align}
&  \sum_{1\leq j\leq r}D_{1}\left(  \mathbf{z}\right)  _{jj}=\nonumber\\
&  \frac{1}{2\left(  N-1\right)  }\int\sum_{1\leq j,j_{1},k_{1},l\leq
r}P_{j_{1}lk_{1}l}\left(  \mathbf{z}^{\prime}\right)  \operatorname*{Tr}%
\left\{  \left\vert \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\right\vert \overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle
\varphi_{k_{1}}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}^{\prime
}\right)  Q_{D_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(
\mathbf{z}^{\prime}\right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\int\sum_{1\leq j_{1},l\leq r}%
P_{j_{1}lj_{1}l}\left(  \mathbf{z}^{\prime}\right)  K_{Q}\left(
\mathbf{z,z}^{\prime}\right)  Q_{D_{2}}\left(  \mathbf{z}^{\prime}\right)
d\mu\left(  \mathbf{z}^{\prime}\right)  \nonumber\\
&  =\frac{1}{2\left(  N-1\right)  }\int K_{Q}\left(  \mathbf{z,z}^{\prime
}\right)  Q_{D_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(
\mathbf{z}^{\prime}\right)  =\frac{1}{\left(  N-1\right)  }Q_{D_{2}}\left(
\mathbf{z}\right)  \nonumber\\
&  \int\frac{1}{\left(  N-1\right)  }Q_{D_{2}}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  =\frac{1}{2\left(  N-1\right)  }\frac{N\left(
N-1\right)  }{2}=N\rfloor
\end{align}


$\lceil$%
\begin{equation}
\mathcal{L}_{jk}\left(  \mathbf{z,z}^{\prime}\right)  =\frac{1}{2\left(
N-1\right)  }\sum_{1\leq j_{1},k_{1},l\leq r}P_{j_{1}lk_{1}l}\left(
\mathbf{z}^{\prime}\right)  \operatorname*{Tr}\left\{  \left\vert
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right\vert
\overset{}{\left\vert \varphi_{j_{1}}\right\rangle \left\langle \varphi
_{k_{1}}\right\vert }\right\}  K_{Q}\left(  \mathbf{z,z}^{\prime}\right)
\rfloor
\end{equation}


One can construct a "FORDO" $D_{1}\left(  \mathbf{z}\right)  $ by considering
the values of the linear functional $f$ on $\Lambda_{1}$ that can be expressed
in the following ways
\begin{align}
&  f\left(  \Phi\left(  \tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right)
\right)  =\left(  \left.  \Phi\left(  \tilde{\varphi}_{k}\left(
\mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{j}\left(
\mathbf{z}\right)  \right)  \right\vert D\right)  =\left(  \left.
\Gamma\left(  \left\vert \tilde{\varphi}_{k}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\right\vert \right)  \right\vert D\right)  =\nonumber\\
&  \left(  \left\vert \tilde{\varphi}_{k}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\right\vert \left\vert \overset{}{L\left(  D\right)  }\right.  \right)
=\left(  \left\vert \tilde{\varphi}_{k}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{j}\left(  \mathbf{z}\right)
\right\vert \left\vert \overset{}{L_{1}\left(  D\right)  }\right.  \right)
=\left(  \left.  \overset{}{\left\vert \varphi_{k}\right\rangle \left\langle
\varphi_{j}\right\vert }\right\vert \widehat{u\left(  \mathbf{z}\right)
}^{\dagger}\left(  L_{1}\left(  D\right)  \right)  \right)
\end{align}
and defining these values as
\begin{align}
f\left(  \Phi\left(  \tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right)
\right)   &  \overset{\Delta}{=}\left(  N-1\right)  ^{-1}f\left(  \Phi\left(
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right)  ^{\dagger}%
\mathcal{N}_{1}\Phi\left(  \tilde{\varphi}_{k}\left(  \mathbf{z}\right)
\right)  \right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\left(  \left.  \Gamma\left(
\left\vert \tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \tilde{\varphi}%
_{l}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{j}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)
\right\vert \right)  \right\vert D\right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\left(  \left.  \left\vert
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{j}\left(
\mathbf{z}\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right\vert
\right\vert L_{2}\left(  D\right)  \right)  \nonumber\\
&  =2\left(  N-1\right)  ^{-1}\left(  \left.  \Gamma_{1}^{2}\left(  \left\vert
\tilde{\varphi}_{k}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{j}\left(  \mathbf{z}\right)  \right\vert \right)  \right\vert
L_{2}\left(  D\right)  \right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \sum_{1\leq l\leq r}%
\overset{}{\left\vert \varphi_{k}\varphi_{l}\right\rangle \left\langle
\varphi_{j}\varphi_{l}\right\vert }\right\vert D_{2}\left(  \mathbf{z}\right)
\right)  .
\end{align}
$\lceil$The transformed FORDO and SORDO are
\begin{align}
D_{1}\left(  \mathbf{z}\right)   &  =\sum_{1\leq j,k\leq r}D_{1}\left(
\mathbf{z}\right)  _{jk}\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert =\sum_{1\leq j,k\leq r}D_{1}{}_{jk}u\left(
\mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{j}\right\rangle \left\langle
\varphi_{k}\right\vert u\left(  \mathbf{z}\right)  \nonumber\\
&  =\sum_{1\leq j,k,p,q\leq r}D_{1}{}_{jk}\bar{u}\left(  \mathbf{z}\right)
_{jp}\left\vert \varphi_{p}\right\rangle \left\langle \varphi_{q}\right\vert
u\left(  \mathbf{z}\right)  _{qk}=\sum_{1\leq j,k,p,q\leq r}\bar{u}\left(
\mathbf{z}\right)  _{jp}D_{1}{}_{jk}u\left(  \mathbf{z}\right)  _{qk}%
\left\vert \varphi_{p}\right\rangle \left\langle \varphi_{q}\right\vert
\nonumber\\
&  =\sum_{1\leq p,q\leq r}\left(  \bar{u}\left(  \mathbf{z}\right)  ^{\dagger
}D_{1}{}u\left(  \mathbf{z}\right)  \right)  _{pq}\left\vert \varphi
_{p}\right\rangle \left\langle \varphi_{q}\right\vert ,\nonumber\\
D_{2}\left(  \mathbf{z}\right)   &  =\sum_{1\leq j_{1}<j_{2},1\leq k_{1}%
<k_{2}\leq r}D_{2}\left(  \mathbf{z}\right)  _{j_{1}j_{2}k_{1}k_{2}}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert \nonumber\\
&  =\sum_{1\leq j_{1}<j_{2},1\leq k_{1}<k_{2}\leq r}D_{2}{}_{j_{1}j_{2}%
k_{1}k_{2}}u\left(  \mathbf{z}\right)  ^{\dagger}\left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert u\left(  \mathbf{z}\right)  .
\end{align}


In particular
\begin{align}
&  f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
\right)  =D_{1}\left(  \mathbf{z}\right)  _{11}=\left(  \left.
\overset{}{\left\vert \varphi_{1}\right\rangle \left\langle \varphi
_{1}\right\vert }\right\vert D_{1}\left(  \mathbf{z}\right)  \right)  =\left(
\left.  \overset{}{\left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\right\vert }\right\vert D_{1}\right)  \nonumber\\
&  =\left(  \left.  L_{1}\overset{}{\left(  \left\vert \tilde{\varphi}%
_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right\rangle \left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\vert \right)
}\right\vert D_{1}\right)  -\left(  \left.  \overset{}{\left\vert
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\vert }\right\vert
D_{1}\right)  \nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\vert \Gamma^{2}\left(  D_{1}\right)
\right)  -\left(  \left.  \overset{}{\left\vert \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert }\right\vert D_{1}\right)  \nonumber\\
&  =\left(  \left.  \left\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(
\mathbf{z}\right)  \right\vert \right\vert \Gamma^{2}\circ L_{1}\left(
D_{2}\right)  \right)  -\left(  \left.  \overset{}{\left\vert \tilde{\varphi
}_{2}\left(  \mathbf{z}\right)  \right\rangle \left\langle \tilde{\varphi}%
_{2}\left(  \mathbf{z}\right)  \right\vert }\right\vert D_{1}\right)
\end{align}%
\begin{align}
&  f\left(  \Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \right)
\right)  =D_{1}\left(  \mathbf{z}\right)  _{11}=\left(  N-1\right)
^{-1}\left(  \left.  \overset{}{\sum_{1\leq l\leq r}\left\vert \varphi
_{1}\right\rangle \left\langle \varphi_{1}\right\vert }\right\vert
D_{1}\left(  \mathbf{z}\right)  \right)  =\nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}D_{2}\left(  \mathbf{z}%
\right)  _{1l1l}=\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\left\langle
\tilde{\varphi}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{l}\left(
\mathbf{z}\right)  \left\vert D_{2}\tilde{\varphi}_{1}\left(  \mathbf{z}%
\right)  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right.  \right\rangle
\nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\left\langle \tilde{\varphi
}_{1}\left(  \mathbf{z}\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\left\vert \Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)
D_{2}\left.  \Phi\left(  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)
\right)  ^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)
\right)  \right\vert \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle
\nonumber\\
&  =\sum_{1\leq l\leq r}\left\langle \tilde{\varphi}_{1}\left(  \mathbf{z}%
\right)  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \left\vert X_{2}\left(
\mathbf{z}\right)  \tilde{\varphi}_{1}\left(  \mathbf{z}\right)
\tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right.  \right\rangle ,
\end{align}
where
\begin{equation}
X_{2}\left(  \mathbf{z}\right)  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq
r}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)
D_{2}\Phi\left(  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right)  .
\end{equation}
Setting $\mathbf{z=0}$ one obtains
\begin{align}
&  D_{1}{}_{11}=\left(  N-1\right)  ^{-1}\left(  \left.  \sum_{1\leq l\leq
r}\overset{}{\left\vert \varphi_{1}\varphi_{l}\right\rangle \left\langle
\varphi_{1}\varphi_{l}\right\vert }\right\vert D_{2}\right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}D_{2}{}_{1l1l}=\left(
N-1\right)  ^{-1}\sum_{1\leq l\leq r}\left\langle \varphi_{1}\varphi
_{l}\left\vert D_{2}\varphi_{1}\varphi_{l}\right.  \right\rangle \nonumber\\
&  =\left(  N-1\right)  ^{-1}\left\langle \varphi_{1}\varphi_{2}\left\vert
\sum_{1\leq l\leq r}\Phi\left(  \varphi_{2}\right)  ^{\dagger}\Phi\left(
\varphi_{l}\right)  D_{2}\left.  \Phi\left(  \varphi_{l}\right)  ^{\dagger
}\Phi\left(  \varphi_{2}\right)  \right\vert \right.  \varphi_{1}\varphi
_{2}\right\rangle \nonumber\\
&  =\left\langle \varphi_{1}\varphi_{2}\left\vert \left.  X_{2}\right\vert
\varphi_{1}\varphi_{2}\right.  \right\rangle ,
\end{align}
where
\begin{equation}
X_{2}=\sum_{1\leq l\leq r}\Phi\left(  \varphi_{2}\right)  ^{\dagger}%
\Phi\left(  \varphi_{l}\right)  D_{2}\Phi\left(  \varphi_{l}\right)
^{\dagger}\Phi\left(  \varphi_{2}\right)  =\sum_{1\leq l\leq r}a_{2}^{\dagger
}a_{l}D_{2}a_{l}^{\dagger}a_{2}.
\end{equation}
The action of $u\left(  \mathbf{z}\right)  $ is then given by
\begin{align}
X_{2}\left(  \mathbf{z}\right)   &  =u\left(  \mathbf{z}\right)  ^{\dagger
}X_{2}u\left(  \mathbf{z}\right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}u\left(  \mathbf{z}\right)
^{\dagger}\Phi\left(  \varphi_{2}\right)  ^{\dagger}\Phi\left(  \varphi
_{l}\right)  D_{2}\Phi\left(  \varphi_{l}\right)  ^{\dagger}\Phi\left(
\varphi_{2}\right)  u\left(  \mathbf{z}\right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\Phi\left(  \tilde{\varphi
}_{2}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi
}_{l}\left(  \mathbf{z}\right)  \right)  D_{2}\Phi\left(  \tilde{\varphi}%
_{l}\left(  \mathbf{z}\right)  \right)  ^{\dagger}\Phi\left(  \tilde{\varphi
}_{2}\left(  \mathbf{z}\right)  \right)  \nonumber\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}u\left(  \mathbf{z}\right)
\Phi\left(  \varphi_{2}\right)  ^{\dagger}\Phi\left(  \varphi_{l}\right)
u\left(  \mathbf{z}\right)  ^{\dagger}D_{2}u\left(  \mathbf{z}\right)
\Phi\left(  \varphi_{l}\right)  ^{\dagger}\Phi\left(  \varphi_{2}\right)
u\left(  \mathbf{z}\right)  ^{\dagger},
\end{align}%
\begin{equation}
X_{2}\left(  \mathbf{z}\right)  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq
r}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)
D_{2}\Phi\left(  \tilde{\varphi}_{l}\left(  \mathbf{z}\right)  \right)
^{\dagger}\Phi\left(  \tilde{\varphi}_{2}\left(  \mathbf{z}\right)  \right)  .
\end{equation}
hence
\begin{align}
D_{1}\left(  \mathbf{z}\right)  _{11} &  =\left(  N-1\right)  ^{-1}\left(
\left.  \sum_{1\leq l\leq r}\overset{}{\left\vert \varphi_{1}\varphi
_{l}\right\rangle \left\langle \varphi_{1}\varphi_{l}\right\vert }\right\vert
D_{2}\left(  \mathbf{z}\right)  \right)  _{\mathcal{B}\left(  \mathcal{H}%
^{2}\right)  }\\
&  =\left(  N-1\right)  ^{-1}\sum_{1\leq l\leq r}\operatorname*{Tr}\left\{
a_{2}^{\dagger}a_{l}\left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert a_{l}^{\dagger}a_{2}u\left(
\mathbf{z}\right)  D_{2}u\left(  \mathbf{z}\right)  ^{\dagger}\right\}  \\
&  =\left(  N-1\right)  ^{-1}\left(  \left.  \sum_{1\leq l\leq r}%
\overset{}{u\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\varphi
_{l}\right\rangle \left\langle \varphi_{1}\varphi_{l}\right\vert u\left(
\mathbf{z}\right)  ^{\dagger}}\right\vert D_{2}\right)  _{\mathcal{B}\left(
\mathcal{H}^{2}\right)  }\\
&  =\left(  N-1\right)  ^{-1}\sum_{2\leq l\leq r}\operatorname*{Tr}\left\{
u\left(  \mathbf{z}\right)  a_{2}^{\dagger}a_{l}u\left(  \mathbf{z}\right)
^{\dagger}u\left(  \mathbf{z}\right)  \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert u\left(
\mathbf{z}\right)  ^{\dagger}u\left(  \mathbf{z}\right)  a_{l}^{\dagger}%
a_{2}u\left(  \mathbf{z}\right)  ^{\dagger}D_{2}\right\}  \\
&  =\left(  N-1\right)  ^{-1}\sum_{2\leq l\leq r}\operatorname*{Tr}\left\{
u\left(  \mathbf{z}\right)  a_{l}^{\dagger}a_{2}u\left(  \mathbf{z}\right)
^{\dagger}D_{2}u\left(  \mathbf{z}\right)  a_{2}^{\dagger}a_{l}u\left(
\mathbf{z}\right)  ^{\dagger}u\left(  \mathbf{z}\right)  \left\vert
\varphi_{1}\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi
_{2}\right\vert u\left(  \mathbf{z}\right)  ^{\dagger}\right\}  \\
&  =\operatorname*{Tr}\left\{  X_{2}\left(  \mathbf{z}\right)  u\left(
\mathbf{z}\right)  \left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert u\left(  \mathbf{z}\right)  ^{\dagger
}\right\}  .
\end{align}%
\begin{equation}
\left(  N-1\right)  ^{-1}\sum_{2\leq l\leq r}\operatorname*{Tr}\left\{
u\left(  \mathbf{z}\right)  a_{2}^{\dagger}a_{l}\left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
a_{l}^{\dagger}a_{2}u\left(  \mathbf{z}\right)  ^{\dagger}D_{2}\right\}
.\rfloor
\end{equation}


The set $\left\{  \left.  Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)
\right\vert 1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r\right\}  $ is
linearly independent and forms a basis for the space, $\mathfrak{F}_{Q}\subset
L_{2}\left(  \mathbb{C}^{2\left(  r-2\right)  },\mu\right)  ,$ of Q-symbols,
whose dimension is $\binom{r}{2}^{2}$. However, in general these functions are
not holomorphic, biholomorphic, normalized nor orthogonal and their metric
matrix is given by
\begin{align}
&  \Delta_{l_{1}l_{2}m_{1}m_{2}j_{1}j_{2}k_{1}k_{2}}=\left\{  Q_{l_{1}%
l_{2}m_{1}m_{2}}\left\vert Q_{j_{1}j_{2}k_{1}k_{2}}\right.  \right\}
_{\mathfrak{F}}=\nonumber\\
&  =\int\overline{\operatorname*{Tr}\left\{  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert \left\vert \varphi_{l_{1}%
}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}%
}\right\vert \right\}  }\operatorname*{Tr}\left\{  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert \left\vert \varphi_{j_{1}%
}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert \right\}  d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int_{\mathbb{C}^{2\left(  r-2\right)  }}\overline{\gamma_{2}\left(
\mathbf{z}\right)  }_{m_{1}m_{2}l_{1}l_{2}}\gamma_{2}\left(  \mathbf{z}%
\right)  _{j_{1}j_{2}k_{1}k_{2}}S\left(  \mathbf{z}\right)  ^{2}d\mu\left(
\mathbf{z}\right) \nonumber\\
&  =\int_{\mathbb{C}^{2\left(  r-2\right)  }}\left(  \left.
\overset{}{\left\vert \varphi_{l_{1}}\varphi_{l_{2}}\right\rangle \left\langle
\varphi_{m_{1}}\varphi_{m_{2}}\right\vert }\right\vert \left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert \right)  \left(
\left.  \overset{}{\left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert }\right\vert \left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert \right)
d\mu\left(  \mathbf{z}\right)  .
\end{align}
Note how the inner product $\left\{  \cdot\left\vert \cdot\right.  \right\}  $
is defined in terms of $\left(  \left.  \cdot\right\vert \cdot\right)  .$ In
the finite dimensional case this basis can be orthonormalized to give the
basis
\begin{equation}
\Delta^{-\frac{1}{2}}\left\{  Q\right\vert =\left\{  Q\right\vert
\boldsymbol{\Delta}^{-\frac{1}{2}}%
\end{equation}
i.e.%
\begin{equation}
I_{\mathfrak{F}_{Q}}=\left\vert Q\right\}  \boldsymbol{\Delta}^{-1}\left\{
Q\right\vert .
\end{equation}


\subsection{P-Symbols}

One can form a (in general non unique) biorthogonal basis $\left\{  \left.
P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  \right\vert 1\leq
j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r\right\}  $ to $\left\{  \left.
Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  \right\vert 1\leq
j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r\right\}  $ that that spans
$\mathfrak{F}_{P},$ i.e.
\begin{align}
\left\{  Q_{j_{1}j_{2}k_{1}k_{2}}\left\vert P_{l_{1}l_{2}m_{1}m_{2}}\right.
\right\}   &  =\int\overline{Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}%
\right)  }P_{l_{1}l_{2}m_{1}m_{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right) \nonumber\\
&  =\delta_{\left(  j_{1}j_{2}\right)  \left(  l_{1}l_{2}\right)  }%
\delta_{\left(  k_{1}k_{2}\right)  \left(  m_{1}m_{2}\right)  }.
\end{align}
In infinite dimensions
\begin{equation}
\mathfrak{F}_{P}\subset\mathfrak{F}_{Q}\subset\mathfrak{F}^{d},
\end{equation}
while in finite dimensions
\begin{equation}
\mathfrak{F}_{P}=\mathfrak{F}_{Q}=\mathfrak{F}%
\end{equation}
and the $\left\{  P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  \right\}
$ basis can be expanded in terms of the $\left\{  Q_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  \right\}  $ basis as
\begin{equation}
P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =\sum_{1\leq p_{1}%
<p_{2}\leq r,1\leq q_{1}<q_{2}\leq r}Q_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{z}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}}%
^{-1}\nonumber
\end{equation}
i.e.
\begin{equation}
\left\vert P\right\}  =\left\vert Q\right\}  \Delta^{-1}.
\end{equation}
This leads to%
\begin{equation}
\left\{  \left.  P\right\vert P\right\}  =\Delta^{-1}\left\{  \left.
Q\right\vert Q\right\}  \Delta^{-1}=\Delta^{-1},
\end{equation}%
\begin{align}
\left\vert Q\right\}   &  =\left\vert P\right\}  \Delta,\nonumber\\
\left\vert P\right\}   &  =\left\vert Q\right\}  \Delta^{-1}%
\end{align}
and in finite dimensions
\begin{equation}
I_{\mathfrak{F}}=\left\vert Q\right\}  \Delta^{-1}\left\{  Q\right\vert
=\left\vert P\right\}  \Delta\left\{  P\right\vert =\left\vert P\right\}
\left\{  Q\right\vert =\left\vert Q\right\}  \left\{  P\right\vert =\left\vert
P\right\}  \left\{  Q\right\vert .
\end{equation}
In infinite dimensions
\begin{align}
I_{\mathfrak{F}_{Q}}  &  :\mathfrak{F}_{Q}\rightarrow\mathfrak{F}%
_{Q}\nonumber\\
I_{\mathfrak{F}_{Q}}  &  =\left\vert Q\right\}  \left\{  P\right\vert
=\left\vert Q\right\}  \Delta^{-1}\left\{  Q\right\vert
\end{align}
and
\begin{align}
I_{\mathfrak{F}_{P}}  &  :\mathfrak{F}_{P}\rightarrow\mathfrak{F}%
_{P}\nonumber\\
I_{\mathfrak{F}_{P}}  &  =\left\vert P\right\}  \left\{  Q\right\vert
=\left\vert P\right\}  \Delta\left\{  P\right\vert .
\end{align}


The biorthogonality condition can be reexpressed as
\begin{align}
\delta_{\left(  l_{1}l_{2}\right)  \left(  j_{1}j_{2}\right)  }\delta_{\left(
m_{1}m_{2}\right)  \left(  k_{1}k_{2}\right)  }  &  =\int\overline
{Q_{l_{1}l_{2}m_{1}m_{2}}\left(  \mathbf{z}\right)  }P_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int\overline{\operatorname*{Tr}\left\{  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert \left\vert \varphi_{l_{1}%
}\varphi_{l_{2}}\right\rangle \left\langle \varphi_{m_{1}}\varphi_{m_{2}%
}\right\vert \right\}  }P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\operatorname*{Tr}\left\{  \left(  \int\left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  \right)  \left\vert
\varphi_{m_{1}}\varphi_{m_{2}}\right\rangle \left\langle \varphi_{l_{1}%
}\varphi_{l_{2}}\right\vert \right\}  ,
\end{align}
\emph{which shows that the integral defines the following operator identity}
\begin{equation}
\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert \equiv\int P_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)
\end{equation}
\emph{and} \emph{that }$P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  $
\emph{is the P}$\emph{-symbol}$ \emph{of} $\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert $, i.e.
\begin{equation}
P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =P_{\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}%
}\varphi_{k_{2}}\right\vert }\left(  \mathbf{z}\right)  ,
\end{equation}
note that P-symbols are not unique.%
\begin{align}
\lceil &  \operatorname*{Tr}\left\{  \left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert
\right\}  \equiv\int P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)
\operatorname*{Tr}\left\{  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \right\}  d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  S\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  =\delta_{j_{1}k_{1}}%
\delta_{j_{2}k_{2}}\nonumber\\
&  \sum_{1\leq j_{1}<j_{2}\leq r}\left\vert \varphi_{j_{1}}\varphi_{j_{2}%
}\right\rangle \left\langle \varphi_{j_{1}}\varphi_{j_{2}}\right\vert
=P_{\mathcal{H}^{2}}=\int\sum_{1\leq j_{1}<j_{2}\leq r}P_{j_{1}j_{2}j_{1}%
j_{2}}\left(  \mathbf{z}\right)  \left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right) \nonumber\\
&  \sum_{1\leq j_{1}<j_{2}\leq r}P_{j_{1}j_{2}j_{1}j_{2}}\left(
\mathbf{z}\right)  =1\rfloor
\end{align}


The P-symbol, $P_{A}\left(  \mathbf{z}\right)  ,$ of any operator $A$ can then
be expressed as%
\begin{equation}
P_{A}\left(  \mathbf{z}\right)  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}}P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  ,
\end{equation}
in particular
\begin{align}
P_{\mathcal{H}^{2}}  &  =\sum_{1\leq j_{1}<j_{2}\leq r}\left\vert
\varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{j_{1}%
}\varphi_{j_{2}}\right\vert =\sum_{1\leq j_{1}<j_{2}\leq r}\int P_{j_{1}%
j_{2}j_{1}j_{2}}\left(  \mathbf{z}\right)  \left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right) \nonumber\\
&  =\int\sum_{1\leq j_{1}<j_{2}\leq r}P_{j_{1}j_{2}j_{1}j_{2}}\left(
\mathbf{z}\right)  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  =\int P_{P_{\mathcal{H}%
^{2}}}\left(  \mathbf{z}\right)  \left\vert \mathbf{z}\right\rangle
\left\langle \mathbf{z}\right\vert d\mu\left(  \mathbf{z}\right)  ,
\end{align}
thus%
\begin{equation}
P_{P_{\mathcal{H}^{2}}}\left(  \mathbf{z}\right)  \equiv P_{\mathcal{H}^{2}%
}\left(  \mathbf{z}\right)  =\sum_{1\leq j_{1}<j_{2}\leq r}P_{j_{1}j_{2}%
j_{1}j_{2}}\left(  \mathbf{z}\right)  =1,
\end{equation}
and is a partition of unity. This gives%
\begin{equation}
\left\langle \mathbf{z}^{\prime\prime}\left\vert \mathbf{z}^{\prime}\right.
\right\rangle =\int\left\langle \mathbf{z}^{\prime\prime}\left\vert
\mathbf{z}\right.  \right\rangle \left\langle \mathbf{z}\left\vert
\mathbf{z}^{\prime}\right.  \right\rangle d\mu\left(  \mathbf{z}\right)
\end{equation}
and that the Q-symbol of the projector onto $\mathcal{H}^{2}$ is
\begin{equation}
Q_{P_{\mathcal{H}^{2}}}\left(  \mathbf{z}^{\prime}\right)  =\int\left\vert
\left\langle \mathbf{z}^{\prime}\left\vert \mathbf{z}\right.  \right\rangle
\right\vert ^{2}d\mu\left(  \mathbf{z}\right)  .
\end{equation}


\subsubsection{Reproducing Kernel}

The reproducing kernel $K_{Q}\left(  \mathbf{z,z}^{\prime}\right)  $ of
$\mathfrak{F}_{Q}$ is
\begin{align}
\left\{  \mathbf{z}\left\vert Q\right.  \right\}  \left\{  P\left\vert
\mathbf{z}^{\prime}\right.  \right\}   &  =K_{Q}\left(  \mathbf{z,z}^{\prime
}\right)  =\sum_{1\leq j_{1}<j_{2},k_{1}<k_{2}\leq r}Q_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  \overline{P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}^{\prime}\right)  }\nonumber\\
&  =\sum_{\substack{1\leq p_{1}<p_{2}\leq r,1\leq q_{1}<q_{2}\leq r\\1\leq
j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}}\overline{Q_{p_{1}p_{2}q_{1}q_{2}%
}\left(  \mathbf{z}^{\prime}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}%
j_{2}k_{1}k_{2}}^{-1}}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  ,
\end{align}
and is the integral kernel of the projector, $P_{\mathfrak{F}_{Q}},$ onto
$\mathfrak{F}_{Q}$ i.e.
\begin{equation}
\left[  P_{\mathfrak{F}_{Q}}\left(  Q_{X}\right)  \right]  \left(
\mathbf{z}\right)  =\int K_{Q}\left(  \mathbf{z,z}^{\prime}\right)
Q_{X}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime
}\right)  =Q_{X}\left(  \mathbf{z}\right)  =\left\{  K_{Q}\left(
\mathbf{z}\right)  \left\vert Q_{X}\right.  \right\}  \equiv\left\{
\mathbf{z}\left\vert Q_{X}\right.  \right\}  ,
\end{equation}
while the reproducing kernel $K_{P}\left(  \mathbf{z,z}^{\prime}\right)  $ of
$\mathfrak{F}_{P}$
\begin{align}
\left\{  \mathbf{z}\left\vert P\right.  \right\}  \left\{  Q\left\vert
\mathbf{z}^{\prime}\right.  \right\}   &  =K_{P}\left(  \mathbf{z,z}^{\prime
}\right)  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}P_{j_{1}%
j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  \overline{Q_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}^{\prime}\right)  }\nonumber\\
&  =\sum_{\substack{1\leq p_{1}<p_{2}\leq r,1\leq q_{1}<q_{2}\leq r\\1\leq
j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}}Q_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{z}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}}%
^{-1}\overline{Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  }%
\end{align}
is the integral kernel of the projector, $P_{\mathfrak{F}_{P}},$ onto
$\mathfrak{F}_{P}$ i.e., which has the action
\begin{equation}
\left[  P_{\mathfrak{F}_{P}}\left(  P_{X}\right)  \right]  \left(
\mathbf{z}\right)  =\int K_{P}\left(  \mathbf{z,z}^{\prime}\right)
P_{X}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime
}\right)  =P_{X}\left(  \mathbf{z}\right)  =\left\{  K_{P}\left(
\mathbf{z}\right)  \left\vert Q_{X}\right.  \right\}  \equiv\left\{
\mathbf{z}\left\vert P_{X}\right.  \right\}  .
\end{equation}


\subsubsection{Berezin Transform}

The Berezin Transformation that transforms P-symbols to Q-symbols
\begin{equation}
\mathfrak{Be}:\mathfrak{F}_{P}\rightarrow\mathfrak{F}_{Q}%
\end{equation}
is given by
\begin{equation}
\mathfrak{Be}=\left\vert Q\right\}  \left\{  Q\right\vert
\end{equation}
(a norm increasing tranformation) which leads to
\begin{equation}
\left\vert Q_{j_{1}j_{2}k_{1}k_{2}}\right\}  =\mathfrak{Be}\left(
P_{j_{1}j_{2}k_{1}k_{2}}\right)  =\sum_{\substack{1\leq p_{1}<p_{2}\leq
r,\\1\leq q_{1}<q_{2}\leq r}}\left\vert Q_{p_{1}p_{2}q_{1}q_{2}}\right\}
\left\{  \left.  Q_{p_{1}p_{2}q_{1}q_{2}}\right\vert P_{j_{1}j_{2}k_{1}k_{2}%
}\right\}  .
\end{equation}
The Kernel of this transform is determined by
\begin{align}
&  Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =\left[  \mathfrak{Be}%
\left(  P_{j_{1}j_{2}k_{1}k_{2}}\right)  \right]  \left(  \mathbf{z}\right)
\nonumber\\
&  =\int\mathfrak{Be}\left(  \mathbf{z,z}^{\prime}\right)  P_{j_{1}j_{2}%
k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime
}\right)  =\int Q_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}\right)
\overline{Q_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}^{\prime}\right)
}P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(
\mathbf{z}^{\prime}\right) \nonumber\\
&  =\int\sum_{\substack{1\leq p_{1}<p_{2}\leq r,\\1\leq q_{1}<q_{2}\leq
r}}\left(  \left\vert \mathbf{z}\right\rangle \left\langle \mathbf{z}%
\right\vert \left\vert \overset{}{\left\vert \varphi_{p_{1}}\varphi_{p_{2}%
}\right\rangle \left\langle \varphi_{q_{1}}\varphi_{q_{2}}\right\vert
}\right.  \right)  \left(  \left.  \overset{}{\left\vert \varphi_{p_{1}%
}\varphi_{p_{2}}\right\rangle \left\langle \varphi_{q_{1}}\varphi_{q_{2}%
}\right\vert }\right\vert \left\vert \mathbf{z}^{\prime}\right\rangle
\left\langle \mathbf{z}^{\prime}\right\vert \right)  P_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)
\nonumber\\
&  =\int\mathfrak{Be}\left(  \mathbf{z,z}^{\prime}\right)  P_{j_{1}j_{2}%
k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime
}\right)  ,
\end{align}
which gives
\begin{align}
\mathfrak{Be}\left(  \mathbf{z,z}^{\prime}\right)   &  =\sum_{\substack{1\leq
p_{1}<p_{2}\leq r,\\1\leq q_{1}<q_{2}\leq r}}\left(  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert \left\vert
\overset{}{\left\vert \varphi_{p_{1}}\varphi_{p_{2}}\right\rangle \left\langle
\varphi_{q_{1}}\varphi_{q_{2}}\right\vert }\right.  \right)  \left(  \left.
\overset{}{\left\vert \varphi_{p_{1}}\varphi_{p_{2}}\right\rangle \left\langle
\varphi_{q_{1}}\varphi_{q_{2}}\right\vert }\right\vert \left\vert
\mathbf{z}^{\prime}\right\rangle \left\langle \mathbf{z}^{\prime}\right\vert
\right) \nonumber\\
&  =\left\vert \left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.
\right\rangle \right\vert ^{2}.
\end{align}


The inverse Berezin Transformation that transforms Q-symbols to P-symbols
\begin{equation}
\mathfrak{Be}^{-1}:\mathfrak{F}_{Q}\rightarrow\mathfrak{F}_{P}%
\end{equation}
can be obtained by using the identity%
\begin{equation}
\mathfrak{Be}^{-1}=\left\vert P\right\}  \left\{  P\right\vert =\left\vert
Q\right\}  \Delta^{-2}\left\{  Q\right\vert ,
\end{equation}
(a norm reducing tranformation) which gives%
\begin{equation}
\left\vert P_{j_{1}j_{2}k_{1}k_{2}}\right\}  =\mathfrak{Be}^{-1}\left(
Q_{j_{1}j_{2}k_{1}k_{2}}\right)  =\sum_{\substack{1\leq p_{1}<p_{2}\leq
r,\\1\leq q_{1}<q_{2}\leq r}}\left\vert P_{p_{1}p_{2}q_{1}q_{2}}\right\}
\left\{  \left.  P_{p_{1}p_{2}q_{1}q_{2}}\right\vert Q_{j_{1}j_{2}k_{1}k_{2}%
}\right\}
\end{equation}
and thus%
\begin{align}
&  P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =\left[  \mathfrak{Be}%
^{-1}\left(  Q_{j_{1}j_{2}k_{1}k_{2}}\right)  \right]  \left(  \mathbf{z}%
\right) \nonumber\\
&  =\int\mathfrak{Be}^{-1}\left(  \mathbf{z,z}^{\prime}\right)  Q_{j_{1}%
j_{2}k_{1}k_{2}}d\mu\left(  \mathbf{z}^{\prime}\right)  =\int P_{p_{1}%
p_{2}q_{1}q_{2}}\left(  \mathbf{z}\right)  \overline{P_{p_{1}p_{2}q_{1}q_{2}%
}\left(  \mathbf{z}^{\prime}\right)  }Q_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right) \nonumber\\
&  =\int\sum_{\substack{1\leq p_{1}<p_{2}\leq r,\\1\leq q_{1}<q_{2}\leq
r}}P_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}\right)  \overline{P_{p_{1}%
p_{2}q_{1}q_{2}}\left(  \mathbf{z}^{\prime}\right)  }\left(  \left\vert
\mathbf{z}^{\prime}\right\rangle \left\langle \mathbf{z}^{\prime}\right\vert
\left\vert \overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle
\left\langle \varphi_{k_{1}}\varphi_{k_{2}}\right\vert }\right.  \right)
d\mu\left(  \mathbf{z}^{\prime}\right) \nonumber\\
&  =\int\sum_{\substack{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r\\1\leq
p_{1}<p_{2}\leq r,1\leq q_{1}<q_{2}\leq r}}\left(  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert \left\vert
\overset{}{\left\vert \varphi_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle
\varphi_{k_{1}}\varphi_{k_{2}}\right\vert }\right.  \right)  \Delta
_{j_{1}j_{2}k_{1}k_{2}p_{1}p_{2}q_{1}q_{2}}^{-2}\left(  \left.
\overset{}{\left\vert \varphi_{p_{1}}\varphi_{p_{2}}\right\rangle \left\langle
\varphi_{q_{1}}\varphi_{q_{2}}\right\vert }\right\vert \left\vert
\mathbf{z}^{\prime}\right\rangle \left\langle \mathbf{z}^{\prime}\right\vert
\right) \nonumber\\
&  \times\left(  \left\vert \mathbf{z}^{\prime}\right\rangle \left\langle
\mathbf{z}^{\prime}\right\vert \left\vert \overset{}{\left\vert \varphi
_{j_{1}}\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}%
\varphi_{k_{2}}\right\vert }\right.  \right)  d\mu\left(  \mathbf{z}^{\prime
}\right) \nonumber\\
&  =\int\mathfrak{Be}^{-1}\left(  \mathbf{z,z}^{\prime}\right)  Q_{j_{1}%
j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}%
^{\prime}\right)  ,
\end{align}
where
\begin{equation}
\mathfrak{Be}^{-1}\left(  \mathbf{z,z}^{\prime}\right)  =\sum_{\substack{1\leq
j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r\\1\leq p_{1}<p_{2}\leq r,1\leq
q_{1}<q_{2}\leq r}}\left(  \left\vert \mathbf{z}\right\rangle \left\langle
\mathbf{z}\right\vert \left\vert \overset{}{\left\vert \varphi_{j_{1}}%
\varphi_{j_{2}}\right\rangle \left\langle \varphi_{k_{1}}\varphi_{k_{2}%
}\right\vert }\right.  \right)  \Delta_{j_{1}j_{2}k_{1}k_{2}p_{1}p_{2}%
q_{1}q_{2}}^{-2}\left(  \left.  \overset{}{\left\vert \varphi_{p_{1}}%
\varphi_{p_{2}}\right\rangle \left\langle \varphi_{q_{1}}\varphi_{q_{2}%
}\right\vert }\right\vert \left\vert \mathbf{z}^{\prime}\right\rangle
\left\langle \mathbf{z}^{\prime}\right\vert \right)  .
\end{equation}


$\lceil$The Berezin Transform gives
\begin{equation}
Q_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}\right)  =\int P_{p_{1}p_{2}%
q_{1}q_{2}}\left(  \mathbf{z}^{\prime}\right)  \left\vert \left\langle
\mathbf{z}\left\vert \mathbf{z}^{\prime}\right.  \right\rangle \right\vert
^{2}d\mu\left(  \mathbf{z}^{\prime}\right)  ,
\end{equation}
which leads to (using the biorthogonality relationships)
\begin{align}
&  \sum_{1\leq j_{1}<j_{2}\leq r,1\leq k_{1}<k_{2}\leq r}P_{j_{1}j_{2}%
k_{1}k_{2}}\left(  \mathbf{z}\right)  \Delta_{j_{1}j_{2}k_{1}k_{2}p_{1}%
p_{2}q_{1}q_{2}}=\int P_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}^{\prime
}\right)  \left\vert \left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime
}\right.  \right\rangle \right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right)
\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\left.  \Downarrow\right.
\nonumber\\
&  P_{l_{1}l_{2}m_{1}m_{2}}\left(  \mathbf{z}\right)  =\int\sum_{1\leq
j_{1}<j_{2},k_{1}<k_{2}\leq r}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}%
^{\prime}\right)  \Delta_{j_{1}j_{2}k_{1}k_{2}l_{1}l_{2}m_{1}m_{2}}%
^{-2}\left\vert \left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.
\right\rangle \right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right)
\end{align}
and
\begin{equation}
Q_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}\right)  =\int\sum_{1\leq
j_{1}<j_{2},k_{1}<k_{2}\leq r}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}%
^{\prime}\right)  \Delta_{j_{1}j_{2}k_{1}k_{2}p_{1}p_{2}q_{1}q_{2}}%
^{-1}\left\vert \left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.
\right\rangle \right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right)  .
\end{equation}
$\rfloor$

The Q and P-symbols of any operator are
\begin{equation}
Q_{A}\left(  \mathbf{z}\right)  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}}Q_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  ,
\end{equation}%
\begin{equation}
P_{A}\left(  \mathbf{z}\right)  =\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}A_{j_{1}j_{2}k_{1}k_{2}}P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  ,
\end{equation}
where
\begin{equation}
A_{j_{1}j_{2}k_{1}k_{2}}=\int\overline{P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  }Q_{A}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}%
\right)  =\int\overline{Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)
}P_{A}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  .
\end{equation}
Hence
\begin{equation}
Q_{A}\left(  \mathbf{z}\right)  =\int\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)
\overline{P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  }%
Q_{A}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime
}\right)  ,
\end{equation}
giving that
\begin{equation}
K_{Q}\left(  \mathbf{z,z}^{\prime}\right)  =\sum_{1\leq j_{1}<j_{2}\leq
r,1\leq k_{1}<k_{2}\leq r}Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)
\overline{P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)  }%
\end{equation}
and
\begin{equation}
\delta_{\left(  l_{1}l_{2}\right)  \left(  j_{1}j_{2}\right)  }\delta_{\left(
m_{1}m_{2}\right)  \left(  k_{1}k_{2}\right)  }=\int Q_{l_{1}l_{2}m_{1}m_{2}%
}\left(  \mathbf{z}\right)  \overline{P_{j_{1}j_{2}k_{1}k_{2}}\left(
\mathbf{z}\right)  }d\mu\left(  \mathbf{z}\right)  ,
\end{equation}
while
\begin{equation}
P_{A}\left(  \mathbf{z}\right)  =\int\sum_{1\leq j_{1}<j_{2}\leq r,1\leq
k_{1}<k_{2}\leq r}P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)
\overline{Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  }P_{A}\left(
\mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime}\right)  ,
\end{equation}
giving that
\begin{equation}
K_{P}\left(  \mathbf{z,z}^{\prime}\right)  =\sum_{1\leq j_{1}<j_{2}\leq
r,1\leq k_{1}<k_{2}\leq r}P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime
}\right)  \overline{Q_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  }%
\end{equation}
and
\begin{equation}
\delta_{\left(  l_{1}l_{2}\right)  \left(  j_{1}j_{2}\right)  }\delta_{\left(
m_{1}m_{2}\right)  \left(  k_{1}k_{2}\right)  }=\int P_{j_{1}j_{2}k_{1}k_{2}%
}\left(  \mathbf{z}\right)  \overline{Q_{l_{1}l_{2}m_{1}m_{2}}\left(
\mathbf{z}\right)  }d\mu\left(  \mathbf{z}\right)  ,
\end{equation}


\subsection{Dual Spaces of P and Q-Symbols}

In finite dimensions the space $\mathfrak{F}$ is spanned by both $\left\{
Q_{j_{1}j_{2}k_{1}k_{2}}\right\}  $ and $\left\{  P_{j_{1}j_{2}k_{1}k_{2}%
}\right\}  $ and is complete in the norms $\left\Vert {}\right\Vert _{\infty
},\left\Vert {}\right\Vert _{1}$ and $\left\Vert {}\right\Vert _{2}$ where
\begin{subequations}
\begin{align}
\left\Vert Q_{A}\right\Vert _{\infty} &  =\sup\left\{  \left\vert Q\left(
\mathbf{z}\right)  \right\vert \right\}  =\sup\left\{  \left\vert \left\langle
\mathbf{z}\left\vert A\mathbf{z}\right.  \right\rangle \right\vert \right\}
,\nonumber\\
\left\Vert Q_{A}\right\Vert _{1} &  =\int\left\vert Q\left(  \mathbf{z}%
\right)  \right\vert d\mu\left(  \mathbf{z}\right)  =\int\left\vert
\left\langle \mathbf{z}\left\vert A\mathbf{z}\right.  \right\rangle
\right\vert d\mu\left(  \mathbf{z}\right)  ,\nonumber\\
\left\Vert Q_{A}\right\Vert _{2} &  =\left\{  \int\left\vert Q\left(
\mathbf{z}\right)  \right\vert ^{2}d\mu\left(  \mathbf{z}\right)  \right\}
^{\frac{1}{2}}=\left\{  \int\left\vert \left\langle \mathbf{z}\left\vert
A\mathbf{z}\right.  \right\rangle \right\vert ^{2}d\mu\left(  \mathbf{z}%
\right)  \right\}  ^{\frac{1}{2}}.
\end{align}
If $A\geq0$ then
\end{subequations}
\begin{equation}
\left\Vert Q_{A}\right\Vert _{1}=\int\left\langle \mathbf{z}\left\vert
A\mathbf{z}\right.  \right\rangle d\mu\left(  \mathbf{z}\right)
=\operatorname*{Tr}\left\{  A\right\}  .
\end{equation}
If $A$ is a bounded operator then
\begin{equation}
\left\vert \left\langle \Psi\left\vert A\Psi\right.  \right\rangle \right\vert
\leq M\left\langle \Psi\left\vert \Psi\right.  \right\rangle =\left\Vert
A\right\Vert \left\langle \Psi\left\vert \Psi\right.  \right\rangle
\forall\Psi\in\mathcal{H}%
\end{equation}
and in particular%
\begin{equation}
\left\vert \left\langle \mathbf{z}\left\vert A\mathbf{z}\right.  \right\rangle
\right\vert \leq\left\Vert A\right\Vert \left\langle \mathbf{z}\left\vert
\mathbf{z}\right.  \right\rangle \forall\mathbf{z}%
\end{equation}
and thus
\begin{equation}
\left\Vert Q_{A}\right\Vert _{\infty}<\infty.
\end{equation}
However one should note that
\begin{equation}
\left\Vert Q_{A}\right\Vert _{\infty}<\infty\nRightarrow\left\Vert
A\right\Vert <\infty.
\end{equation}
One should observe that
\begin{equation}
\operatorname*{Tr}\left\{  A\right\}  =\int Q_{A}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)  =\int P_{A}\left(  \mathbf{z}\right)  S\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)
\end{equation}
and if $P_{B}$ exists
\begin{equation}
\operatorname*{Tr}\left\{  A^{\dagger}B\right\}  =\int\overline{Q_{A}\left(
\mathbf{z}\right)  }P_{B}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}%
\right)  =\left\{  \left.  Q_{A}\right\vert P_{B}\right\}  .
\end{equation}
As
\begin{equation}
\operatorname*{Tr}\left\{  A^{\dagger}B\right\}  =\operatorname*{Tr}\left\{
A^{\dagger}\int P_{B}\left(  \mathbf{z}\right)  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert d\mu\left(  \mathbf{z}%
\right)  \right\}  =\int\overline{\left\langle \mathbf{z}\left\vert
A\mathbf{z}\right.  \right\rangle }P_{B}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  .
\end{equation}
$\lceil$%
\begin{equation}
\operatorname*{Tr}\left\{  A^{\dagger}A\right\}  =\int\left\langle
\mathbf{z}\left\vert A^{\dagger}A\mathbf{z}\right.  \right\rangle d\mu\left(
\mathbf{z}\right)  =\left\{  \left.  Q_{A}\right\vert P_{A}\right\}  \rfloor
\end{equation}


\subsection{Algebraic Structure}

\paragraph{P-Symbol products}%

\begin{align}
&  \int P_{A}\left(  \mathbf{z}_{1}\right)  \left\vert \mathbf{z}%
_{1}\right\rangle \left\langle \mathbf{z}_{1}\right\vert d\mu\left(
\mathbf{z}_{1}\right)  \int P_{B}\left(  \mathbf{z}_{1}\right)  \left\vert
\mathbf{z}_{2}\right\rangle \left\langle \mathbf{z}_{2}\right\vert d\mu\left(
\mathbf{z}_{2}\right)  \nonumber\\
&  =\int P_{A}\left(  \mathbf{z}_{1}\right)  P_{B}\left(  \mathbf{z}%
_{2}\right)  S\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  \left\vert
\mathbf{z}_{1}\right\rangle \left\langle \mathbf{z}_{2}\right\vert d\mu\left(
\mathbf{z}_{1}\right)  d\mu\left(  \mathbf{z}_{2}\right)  \nonumber\\
&  =\int P_{AB}\left(  \mathbf{z}_{1}\right)  \left\vert \mathbf{z}%
_{1}\right\rangle \left\langle \mathbf{z}_{1}\right\vert d\mu\left(
\mathbf{z}_{1}\right)  \nonumber\\
P_{AB}\left(  \mathbf{z}_{1}\right)   &  =\int P_{A}\left(  \mathbf{z}%
_{1}\right)  S\left(  \mathbf{\bar{z}}_{1},\mathbf{z}_{2}\right)  P_{B}\left(
\mathbf{z}_{2}\right)  d\mu\left(  \mathbf{z}_{2}\right)  .
\end{align}


\paragraph{Q-Symbol products}

Pointwise product produces a commutative $w^{\ast}$- algebra
\begin{equation}
Q_{A\cdot B}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =Q_{A}\left(
\mathbf{\bar{z}},\mathbf{z}\right)  Q_{B}\left(  \mathbf{\bar{z}}%
,\mathbf{z}\right)
\end{equation}
this product is distinct from non commutative products such as
\begin{equation}
Q_{A\circ B}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\left\langle
\mathbf{z}\left\vert AB\mathbf{z}\right.  \right\rangle ,
\end{equation}%
\begin{equation}
Q_{AB_{+}}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\frac{1}{2}\left\langle
\mathbf{z}\left\vert \left(  AB+BA\right)  \mathbf{z}\right.  \right\rangle
=\frac{1}{2}\left(  Q_{A\circ B}\left(  \mathbf{\bar{z}},\mathbf{z}\right)
+Q_{B\circ A}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  \right)  .
\end{equation}


\subsection{Independent Particle Example}

Let the ground state of a non interacting two particle system be
\begin{equation}
D_{IPS}^{2}=\left\vert \varphi_{1}\varphi_{2}\right\rangle \left\langle
\varphi_{1}\varphi_{2}\right\vert
\end{equation}
then%

\begin{align}
Q_{\gamma_{2\varphi}}\left(  \mathbf{z}\right)   &  =\left\langle
\mathbf{z}\left\vert \left\vert \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right.  \mathbf{z}%
\right\rangle =\left\langle \varphi_{1}\varphi_{2}\left\vert \left\vert
\mathbf{z}\right\rangle \left\langle \mathbf{z}\right\vert \right.
\varphi_{1}\varphi_{2}\right\rangle =\gamma_{2\varphi}\left(  \mathbf{z}%
\right)  _{1212}\left\langle \mathbf{z}\left\vert \mathbf{z}\right.
\right\rangle \equiv\gamma_{2}\left(  \mathbf{z}\right)  _{1212}\left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle \nonumber\\
&  =\left\{  \gamma_{1}\left(  \mathbf{z}\right)  _{11}\gamma_{1}\left(
\mathbf{z}\right)  _{22}-\gamma_{1}\left(  \mathbf{z}\right)  _{12}\gamma
_{1}\left(  \mathbf{z}\right)  _{21}\right\}  \left\langle \mathbf{z}%
\left\vert \mathbf{z}\right.  \right\rangle =\left\vert
\begin{array}
[c]{cc}%
\gamma_{1}\left(  \mathbf{z}\right)  _{11} & \gamma_{1}\left(  \mathbf{z}%
\right)  _{12}\\
\gamma_{1}\left(  \mathbf{z}\right)  _{21} & \gamma_{1}\left(  \mathbf{z}%
\right)  _{22}%
\end{array}
\right\vert \left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
\nonumber\\
&  =\left\vert
\begin{array}
[c]{cc}%
\left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\right]  _{11} & \left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger
}\mathbf{z}\right)  ^{-1}\right]  _{12}\\
\left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\right]  _{21} & \left[  \left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger
}\mathbf{z}\right)  ^{-1}\right]  _{22}%
\end{array}
\right\vert \left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle
=\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)
^{-1}\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle =1
\end{align}
and%
\begin{align}
\left\langle \varphi_{1}\varphi_{2}\left\vert \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert \right.  \varphi_{1}%
\varphi_{2}\right\rangle  &  =\left\langle \varphi_{1}\varphi_{2}\left\vert
\left\vert c\left(  \mathbf{z}\right)  \varphi_{1}\varphi_{2}\right\rangle
\left\langle \varphi_{1}\varphi_{2}\right\vert \right.  c\left(
\mathbf{z}\right)  ^{\dagger}\varphi_{1}\varphi_{2}\right\rangle \nonumber\\
&  =\left\vert \left\langle \varphi_{1}\varphi_{2}\left\vert c\left(
\mathbf{z}\right)  \varphi_{1}\varphi_{2}\right.  \right\rangle \right\vert
^{2}=1.
\end{align}
Note that%
\begin{equation}
\det\left(  \mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  =\det\left(
%
\begin{array}
[c]{cc}%
1+\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)  _{11} & \left(
\mathbf{z}^{\dagger}\mathbf{z}\right)  _{12}\\
\left(  \mathbf{z}^{\dagger}\mathbf{z}\right)  _{21} & 1+\left(
\mathbf{z}^{\dagger}\mathbf{z}\right)  _{22}%
\end{array}
\right)  ,
\end{equation}%
\begin{equation}
\gamma_{1}\left(  \mathbf{z}\right)  _{hh^{\prime}}=\left[  \left(
\mathbb{I}_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-1}\right]
_{hh^{\prime}}%
\end{equation}
and
\begin{align}
1  &  =\left\langle \mathbf{z}\left\vert \left\vert \varphi_{1}\varphi
_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert \right.
\mathbf{z}\right\rangle =\left\vert \left\langle \left.  \mathbf{z}\right\vert
\varphi_{1}\varphi_{2}\right\rangle \right\vert ^{2}=\left\vert \left\langle
\left.  \varphi_{1}\varphi_{2}\right\vert c\left(  \mathbf{z}\right)
\varphi_{1}\varphi_{2}\right\rangle \right\vert ^{2}\nonumber\\
&  =\left\vert \left\langle \varphi_{1}\varphi_{2}\left\vert \exp\left\{
\sum\limits_{\substack{1\leq h\leq2\\3\leq p\leq r}}z_{ph}a_{p}^{\dagger}%
a_{h}\right\}  \varphi_{1}\varphi_{2}\right.  \right\rangle \right\vert ^{2},
\end{align}
thus
\begin{equation}
Q_{\gamma_{2\varphi}}\left(  \mathbf{z}\right)  =1\quad\forall\mathbf{z\in
}\mathbb{C}^{2\left(  r-2\right)  }.
\end{equation}
In this case
\begin{align}
&  1=\int Q_{\gamma_{2\varphi}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  =\operatorname*{Tr}\left\{  \left\vert \varphi_{1}%
\varphi_{2}\right\rangle \left\langle \varphi_{1}\varphi_{2}\right\vert
\right\} \nonumber\\
&  =\int d\mu\left(  \mathbf{z}\right)  =\int\det\left(  \mathbb{I}%
_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-\left(  r+1\right)  }\left(
-2\pi i\right)  ^{-2\left(  r-2\right)  }d\mathbf{\bar{z}}d\mathbf{z.}%
\end{align}
The energy functional is
\begin{equation}
E_{N}\left(  D^{2}\right)  =\int P_{K_{2N}}\left(  \mathbf{z}\right)
Q_{D^{2}}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  =\int
Q_{K_{2N}}\left(  \mathbf{z}\right)  P_{D^{2}}\left(  \mathbf{z}\right)
d\mu\left(  \mathbf{z}\right)
\end{equation}
$\lceil$%
\begin{equation}
\operatorname*{Tr}\left\{  K_{2N}D\right\}  =\int P_{K_{2N}}\left(
\mathbf{z}\right)  \operatorname*{Tr}\left\{  \left\vert \mathbf{z}%
\right\rangle \left\langle \mathbf{z}\right\vert D\right\}  d\mu\left(
\mathbf{z}\right)  =\int P_{K_{2N}}\left(  \mathbf{z}\right)  Q_{D^{2}}\left(
\mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)  \rfloor
\end{equation}
and the minimum value is%
\begin{equation}
E_{N}\left(  D_{\ast}^{2}\right)  =K_{\varphi1212}=\int P_{K_{22}}\left(
\mathbf{z}\right)  Q_{D_{\ast}^{2}}\left(  \mathbf{z}\right)  d\mu\left(
\mathbf{z}\right)  ,
\end{equation}
where the Q-symbol of the Reduced hamiltonian is given by
\begin{align}
&  Q_{K_{22}}\left(  \mathbf{\bar{z}},\mathbf{z}\right)  =\frac{1}{2}%
\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}K_{\varphi j_{1}j_{2}k_{1}k_{2}%
}\left\langle \mathbf{z}\left\vert a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}a_{k_{2}}a_{k_{1}}\mathbf{z}\right.  \right\rangle \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2},k_{1},k_{2}\leq r}\left\{  \eta\left(
\delta_{j_{1}k_{1}}\delta_{j_{2}k_{2}}-\delta_{j_{1}k_{2}}\delta_{j_{2}k_{1}%
}\right)  +\left(  h_{1jk}\delta_{lm}+h_{1lm}\delta_{jk}\right)  \right\}
\nonumber\\
&  \times K_{\varphi j_{1}j_{2}k_{1}k_{2}}\left\{  \gamma_{1}\left(
\mathbf{z}\right)  _{j_{1}k_{1}}\gamma_{1}\left(  \mathbf{z}\right)
_{j_{2}k_{2}}-\gamma_{1}\left(  \mathbf{z}\right)  _{j_{1}k_{2}}\gamma
_{1}\left(  \mathbf{z}\right)  _{j_{2}k_{1}}\right\}  \left\langle
\mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle ,
\end{align}
and its P-symbol $P_{K_{22}}\left(  \mathbf{z}\right)  $ has to be found via
the inverse Berezin transform
\begin{equation}
P_{K_{22}}\left(  \mathbf{z}\right)  =\left[  \mathfrak{Be}^{-1}\left(
Q_{K_{22}}\left(  \mathbf{z}\right)  \right)  \right]  \left(  \mathbf{z}%
\right)  =\int\mathfrak{Be}^{-1}\left(  \mathbf{\bar{z},z}^{\prime}\right)
Q_{K_{22}}\left(  \mathbf{z}^{\prime}\right)  d\mu\left(  \mathbf{z}^{\prime
}\right)  ,
\end{equation}
and in the IPS case%
\begin{align}
Q_{D_{\ast}^{2}}\left(  \mathbf{z}\right)   &  =\left[  D_{\ast2}\right]
_{1212}\gamma_{2}\left(  \mathbf{z}\right)  _{1212}\left\langle \mathbf{z}%
\left\vert \mathbf{z}\right.  \right\rangle \nonumber\\
&  =\left[  D_{\ast2}\right]  _{1212}\left\{  \gamma_{1}\left(  \mathbf{z}%
\right)  _{11}\gamma_{1}\left(  \mathbf{z}\right)  _{22}-\gamma_{1}\left(
\mathbf{z}\right)  _{12}\gamma_{1}\left(  \mathbf{z}\right)  _{21}\right\}
\left\langle \mathbf{z}\left\vert \mathbf{z}\right.  \right\rangle \nonumber\\
&  =\left\{  \gamma_{1}\left(  \mathbf{z}\right)  _{11}\gamma_{1}\left(
\mathbf{z}\right)  _{22}-\gamma_{1}\left(  \mathbf{z}\right)  _{12}\gamma
_{1}\left(  \mathbf{z}\right)  _{21}\right\}  \left\langle \mathbf{z}%
\left\vert \mathbf{z}\right.  \right\rangle =\det\left(  \mathbb{I}%
_{2}+\mathbf{z}^{\dagger}\mathbf{z}\right)  ^{-1}\left\langle \mathbf{z}%
\left\vert \mathbf{z}\right.  \right\rangle =1.
\end{align}
The energy is given as
\begin{align}
E\left(  D_{\ast}^{2}\right)   &  =\inf_{D^{2}\in S_{22}=S_{2}}%
\operatorname*{Tr}\left\{  K_{22}D^{2}\right\} \nonumber\\
&  \parallel\nonumber\\
E\left(  Q_{D_{\ast}^{2}}\right)   &  =\inf_{Q\in\mathfrak{Q}_{12}}\left\{
\int P_{K_{22}}\left(  \mathbf{z}\right)  d\mu\left(  \mathbf{z}\right)
\right\} \nonumber\\
&  =K_{\varphi1212},
\end{align}
where%
\begin{equation}
K_{22}=\int P_{K_{22}\varphi}\left(  \mathbf{z}\right)  \left\vert c\left(
\mathbf{z}\right)  \varphi_{1}\varphi_{2}\right\rangle \left\langle c\left(
\mathbf{z}\right)  \varphi_{1}\varphi_{2}\right\vert d\mu\left(
\mathbf{z}\right)  .
\end{equation}


\subsection{BiOrthogonal Basis}%

\begin{align}
A\left\vert \mathbf{\varphi}\right\rangle  &  =\left\vert \mathbf{\varphi
}\right\rangle \mathbb{A}\nonumber\\
\left\langle \left.  \mathbf{\psi}\right\vert \mathbf{\varphi}\right\rangle
&  =\mathbb{I}\nonumber\\
\Delta_{\psi}  &  =\left\langle \left.  \mathbf{\psi}\right\vert \mathbf{\psi
}\right\rangle \Rightarrow\left\langle \left.  \mathbf{\psi}\right\vert
\mathbf{\psi}\right\rangle \mathbf{\Delta}_{\psi}^{-1}=\left\langle \left.
\mathbf{\psi}\right\vert \Delta_{\psi}^{-1}\mathbf{\psi}\right\rangle
=\mathbb{I}\Rightarrow\left\vert \mathbf{\varphi}\right\rangle =\left\vert
\Delta_{\psi}^{-1}\mathbf{\psi}\right\rangle \nonumber\\
P  &  =\left\vert \mathbf{\varphi}\right\rangle \mathbf{\Delta}_{\varphi}%
^{-1}\left\langle \mathbf{\varphi}\right\vert =\left\vert \mathbf{\psi
}\right\rangle \mathbf{\Delta}_{\psi}^{-1}\left\langle \mathbf{\psi
}\right\vert =\left\vert \mathbf{\varphi}\right\rangle \left\langle
\mathbf{\psi}\right\vert =\left\vert \mathbf{\varphi}\right\rangle
\left\langle \mathbf{\psi}\right\vert
\end{align}


\section{Extra}%

\begin{equation}
\sum_{1\leq p_{1}<p_{2},q_{1}<q_{2}\leq r}P_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{z}^{\prime}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}%
}^{-1}%
\end{equation}
%

\begin{align}
&  =\int\Upsilon_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)
\left\vert \left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.
\right\rangle \right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right)
\nonumber\\
\Upsilon_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)   &
=\sum_{1\leq p_{1}<p_{2},q_{1}<q_{2}\leq r}P_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{z}^{\prime}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}%
}^{-1}.
\end{align}
this gives%
\begin{equation}
\Upsilon_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}^{\prime}\right)
=\sum_{1\leq p_{1}<p_{2},q_{1}<q_{2}\leq r}Q_{p_{1}p_{2}q_{1}q_{2}}\left(
\mathbf{z}\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}}^{-2}%
\end{equation}
and
\begin{equation}
P_{j_{1}j_{2}k_{1}k_{2}}\left(  \mathbf{z}\right)  =\int\sum_{1\leq
p_{1}<p_{2},q_{1}<q_{2}\leq r}Q_{p_{1}p_{2}q_{1}q_{2}}\left(  \mathbf{z}%
\right)  \Delta_{p_{1}p_{2}q_{1}q_{2}j_{1}j_{2}k_{1}k_{2}}^{-2}\left\vert
\left\langle \mathbf{z}\left\vert \mathbf{z}^{\prime}\right.  \right\rangle
\right\vert ^{2}d\mu\left(  \mathbf{z}^{\prime}\right)  .
\end{equation}
As%
\begin{equation}
