	volume = {52},
	number = {10},
	pages = {5387-94},
	month = {15 May 1970},
	year = {1970},
	keywords = {Inorganic molecule electronic structure; Nitrogen compounds; Spectra of diatomic inorganic molecules; },
	language = {English},
	abstract = {A method of CI calculations for ground and excited electronic states using a limited natural-orbital basis is described. Applications to full potential-energy curves for NH in the clamped nuclei approximation yield good splittings and spectral parameters. Two new excited states are predicted to be weakly bound.}
}

@article{Gruninger70,
	author = {J. Gruninger and Y. Ohrn and Per-Olov Lowdin},
	title = {Comments on the analysis of atomic correlation energies},
	journal = {Journal of Chemical Physics},
	volume = {52},
	number = {11},
	pages = {5551-4},
	month = {1 June 1970},
	year = {1970},
	keywords = {Atomic structure; },
	language = {English},
	abstract = {Analysis of correlation energies is advocated in terms of average values of electronic kinetic energy, electron-nuclear attraction energy, and electron-electron repulsion energy, rather than pair energies. Exploratory calculations on the two-electron and three-electron isoelectronic sequences are reported.}
}

@article{Born80,
	author = {G. Born and Y. Ohrn},
	title = {Electron propagator theory for the calculation of molecular electron binding energies and photoionization intensities},
	journal = {Physica Scripta},
	volume = {21},
	number = {3-4},
	pages = {378-84},
	location = {Gothenburg, Sweden},
	note = {From conference: Many-body Theory of Atomic Systems. Proceedings of the Nobel Symposium 46, 11-16 June 1979},
	year = {1980},
	keywords = {Algebra; Binding energy; Green's function methods; Ionisation of molecules; Organic compounds; Perturbation theory; Photoelectron spectra; Photoionisation; Water; Molecular electron binding energies; Photoionization intensities; Green's function method; Algebraic method; Superoperators; Outer projection; Fermionlike electron field operator products; Partitioning; Perturbation theory; Molecular electron binding energies; Photoelectron spectra; Water; Acetylene; Electron propagator theory; Inner projection; Self energy matrix diagonalisation},
	language = {English},
	abstract = {Electron propagator or Green's function methods are discussed using the algebraic methods of superoperators, inner and outer projections on a linear space of fermionlike electron field operator products, partitioning, and perturbation theory. The problems of accurate determination of molecular electron binding energies from the core through the valence region are addressed. The complications of diagonalization of very large matrices in the self-energy expressions are pointed out and various diagonal approximations are discussed with the use of renormalization theory. Simple applications to the photoelectron spectra of water and acetylene are presented for illustrative purposes.}
}

@article{Ohrn79,
	author = {Y. Ohrn and J. Linderberg},
	title = {Characteristics of the consistent ground state of the random phase approximation},
	journal = {International Journal of Quantum Chemistry},
	volume = {15},
	number = {3},
	pages = {343-53},
	month = {March 1979},
	year = {1979},
	keywords = {Molecular orbitals calculations; RPA calculations; Consistent ground state; Random phase approximation; Generator coordinate representation; Unitary group parameter space; Correlated pair structure},
	language = {English},
	abstract = {Detailed considerations of the ground-state vector derived for the random phase approximation obtained earlier (see ibid., vol.12, p.161 (1977)), in a generator coordinate representation employing the unitary group parameter space reveal a particular correlated pair structure. The results of explicit calculations of ground-state averages are discussed.}
}

@article{Kurtz79,
	author = {H.A. Kurtz and Y. Ohrn},
	title = {Calculation of /sup 2/P shape resonances in Be and Mg},
	journal = {Physical Review A [General Physics]},
	volume = {19},
	number = {1},
	pages = {43-8},
	month = {Jan. 1979},
	year = {1979},
	keywords = {Atomic resonant states; Beryllium; Elastic scattering of electrons by atoms and molecules; Magnesium; /Sup 2/P shape resonances; Be; Mg; Electron scattering; Ad hoc polarization potential; Resonance energies; Resonance width},
	language = {English},
	abstract = {Shape resonances of /sup 2/P type are calculated for electron scattering with Be and Mg target atoms using the Harris method with an ad hoc polarization potential. Good agreements are obtained for resonance energies and widths.}
}

@article{Born,
	author = {G. Born and Y. Ohrn},
	title = {Alternative inner projections of the superoperator resolvent},
	journal = {International Journal of Quantum Chemistry, Quantum Chemistry Symposia},
	number = {no.12},
	pages = {143-51},
	location = {Flagler Beach, FL, USA},
	note = {From conference: Proceedings of the International Symposium on Atomic, Molecular, and Solid-State Theory, Collision Phenomena, and Computational Methods, 12-18 March 1978},
	keywords = {Atomic electron correlations; Molecular electron correlations; Inner projections; Superoperator resolvent; Electron propagator; Diagram conserving decoupling; Self energy contribution; Hartree Fock reference state; H/sub 2/O molecule},
	language = {English},
	abstract = {A diagram-conserving decoupling of the electron propagator is derived using the superoperator formalism. The self-energy contribution is derived through third order using a HF reference state and is shown to avoid the large matrix dimensions inherent in previously used decouplings. Applications to the water molecule are reported.}
}

@article{Born79,
	author = {G. Born and Y. Ohrn},
	title = {A superoperator derivation of the 2p-h TDA equations},
	journal = {Chemical Physics Letters},
	volume = {61},
	number = {2},
	pages = {307-12},
	month = {15 Feb. 1979},
	year = {1979},
	keywords = {Atomic orbitals calculations; Atomic structure; Superoperator derivation; 2P-h TDA equations; Superoperator formalism; Effective interaction; Two particle one hole Tamm Dancoff approximation; Atomic orbitals; Atomic structure},
	language = {English},
	abstract = {The authors present an alternative derivation of the two particle-one hole Tamm-Dancoff approximation (2p-h TDA) using the superoperator formalism. This approximation is shown to follow from the use of an effective interaction which is logically obtained as a projection of the perturbation superoperator on the 2p-h subspace of the full vector space of all Fermion-like field operators. The diagonal 2p-h TDA derived and employed in previous work is shown to neglect terms which, in fact, are diagonal and lead to an overcounting of all diagrams containing diagonal ladder parts.}
}

@article{Linderberg77,
	author = {J. Linderberg and Y. Ohrn},
	title = {State vectors and propagators in many-electron theory. A unified approach},
	journal = {International Journal of Quantum Chemistry},
	volume = {12},
	number = {1},
	pages = {161-91},
	month = {July 1977},
	year = {1977},
	keywords = {Atomic structure; Molecular energy level calculations; Propagators; Unified approach; Unitary group formulation; State vectors; Ground state representatives; Variational upper bound; Ground state energy; Many electron theory; RPA; Atoms; Molecules},
	language = {English},
	abstract = {A unitary group formulation of the many-electron problem is employed to give explicit representations of state vectors which are convenient for the discussion of properties derived from propagator calculations. New results are obtained concerning the nature of various random-phase-like approximations and ground state representatives are generated from consistency requirements for the spectral resolution of the polarization propagator. The explicit solution admits the calculation of ground state average values for arbitrary operators and a variational upper bound to the ground state energy.}
}

@article{Kurtz78,
	author = {H.A. Kurtz and Y. Ohrn},
	title = {On the calculation of electron binding energies},
	journal = {Journal of Chemical Physics},
	volume = {69},
	number = {3},
	pages = {1162-7},
	month = {1 Aug. 1978},
	year = {1978},
	keywords = {Binding energy; Lithium; Lithium compounds; Neon; Water; Electron binding energies; Electron affinities; Valence region; Ne; H/sub 2/O; LiH; Li/sub 2/; Atomic system; Molecular system; Ionisation potential; Core region},
	language = {English},
	abstract = {Theoretical determination of atomic and molecular electron binding energies (ionization potentials and electron affinities) is discussed and expressions derived which apply for the core as well as the valence region. Applications to Ne, H/sub 2/O, LiH, and Li/sub 2/ are used as indicators of the quality of the results.}
}

@article{Born78,
	author = {G. Born and H.A. Kurtz and Y. Ohrn},
	title = {Elementary finite order perturbation theory for vertical ionization energies},
	journal = {Journal of Chemical Physics},
	volume = {68},
	number = {1},
	pages = {74-85},
	month = {1 Jan. 1978},
	year = {1978},
	keywords = {Ionisation potential; Perturbation theory; Finite order perturbation theory; Vertical ionization energies; Propagator theory; Transition operator method; Atoms; Molecules},
	language = {English},
	abstract = {A theoretical analysis is developed for the ionization energies in Rayleigh-Schrodinger perturbation theory and in propagator theory. An analysis via the transition operator method shows these two approaches to be equivalent. The Delta E/sub SCF/ contributions have also been calculated and rules for their construction from the electron propagator diagram formulated. The analysis is extended to include correlation time calculation.}
}

