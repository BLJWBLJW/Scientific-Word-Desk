	keywords = {Ionisation potential; Molecular energy levels; Nitrogen; Water; Full 2p-h TDA electron propagator matrix; Overlap amplitudes; N/sub 2/; H/sub 2/O; Self energy approximants; Super operator formulation; Symmetry block decoupling; Orbital exclusion; Relative ionisation energy; Ionisation potential; Ionisation cross section; Tamm Dancoff approximation},
	language = {English},
	abstract = {A super-operator formulation for decoupling symmetry blocks of the full 2p-h TDA electron propagator matrix is presented; accuracy is explored using the full 2p-h TDA overlap amplitudes to calculate relative ionization intensities for N/sub 2/ and H/sub 2/O. The effect of excluding orbitals on IPs and relative ionization cross sections is reported.}
}

@article{Kouba70a,
	author = {J. Kouba and Y. Ohrn},
	title = {Natural-orbital valence-shell CI studies of diatomic molecules. I. Potential-energy curves and spectra of imidogen},
