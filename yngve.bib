  number = 12,
  pages = {2660-7},
  publisher = {ACS},
  abstract = {The electron nuclear dynamics (END) theory is a time-dependent,
             nonadiabatic approach to molecular processes. It has been
             implemented in the ENDyne code at the level of approximation that
             treats the nuclei as classical particles and represents the
             electrons with a single complex spin unrestricted determinant.
             This level of theory has been successfully applied to a wide
