	year = {1997},
	keywords = {Configuration interactions; Eigenvalues and eigenfunctions; Electronic density of states; Hermitian matrices; Iterative methods; Polymers; PPP calculations; Tight-binding calculations; Density of states; Alternant cyclic polyenes; Direct Lanczos method; Direct full configuration interaction approach; Low-lying eigenvalues; Iterative Lanczos calculations; Large Hermitean Hamiltonian matrices; Random start vectors; Statistical approximations; Correlated tight-binding Pariser-Parr-Pople Hamiltonians},
	language = {English},
	abstract = {A direct full configuration interaction approach, previously used for studying individual low-lying eigenvalues, is combined with iterative Lanczos calculations, in order to obtain global properties of large Hermitean Hamiltonian matrices. To this effect systematic generation of random start vectors is used to compute statistical approximations to the density of states (DOS). Applications for cyclic polyenes in older to illustrate the viability of the scheme modeled by correlated, tight-binding Pariser-Parr-Pople (PPP) Hamiltonians of increasing complexity are presented. The degree of correlation in the solutions is controlled by the parameter beta . Convergence properties of the DOS for N=10 and N=14 are studied varying the extent of correlation.}
}

@article{Goscinski96,
	author = {O. Goscinski and L. Hagg},
	title = {The maximum entropy method and relaxation for multiple collisions involving highly charged ions},
	journal = {International Journal of Quantum Chemistry},
	volume = {58},
	number = {6},
	pages = {689-98},
	publisher = {Wiley},
	location = {Copenhagen, Denmark},
	note = {From conference: Symposium on `The Chemical Bond`, 27-29 July 1994},
	month = {15 June 1996},
	year = {1996},
	keywords = {Atom-ion collisions; Beam-foil spectra; Entropy; Fokker-Planck equation; Ion-molecule collisions; Relaxation; Maximum entropy method; Relaxation; Multiple collisions; Highly charged ions; Time evolution; Finite intervals; Infinite intervals; Finite charge-state distribution intervals; Beam-foil spectroscopy; NonGaussian case; Static case; Nonpositive definiteness; Hessian matrices; Characteristic functions; Marcinkiewicz theorem; Moment expansions; Truncation; Positivity tests; Charge state distribution; Fokker-Planck equations},
	language = {English},
	abstract = {Advantages and disadvantages of the maximum entropy method (MEM) in application to the theory of relaxation are studied. The time evolution of distributions and of associated moments must obey stringent conditions for both finite and infinite intervals. The theoretical considerations are illustrated with examples from charge-state distributions arising in beam-foil spectroscopy. The examples indicate that the possibility to include more than two moments (extension to non-Gaussian case) is severely limited (though feasible) in the static case due to nonpositive definiteness as well as stiffness of the Hessian matrices appearing in the computations. This takes place already for the finite charge-state distribution intervals. For infinite intervals, this is a severe problem as required by the Marcinkiewicz theorem, affecting characteristic functions and, hence, the description of the time evolution of distributions.}
}

@article{Karlsson95,
	author = {H.O. Karlsson and O. Goscinski},
	title = {Autocorrelation functions in the photoionization of hydrogen in electric and magnetic fields},
	journal = {Physical Review A [Atomic, Molecular, and Optical Physics]},
	volume = {51},
	number = {2},
	pages = {1154-8},
	month = {Feb. 1995},
	year = {1995},
	keywords = {Chaos; Electric field effects; Hydrogen neutral atoms; Magnetic field effects; Photoionisation; Autocorrelation functions; Photoionization cross section; Electric fields; Magnetic fields; Recursive residue generation method; Complex dilation; Discretization; Fano-type profiles; Perpendicular fields; Field-induced resonances; Initial Lorentzian shape; Oscillatory structures; Chaotic ionization; H},
	language = {English},
	abstract = {The photoionization (PI) cross section of hydrogen in external electric and magnetic fields was studied by a direct version of the recursive residue generation method, combined with complex dilation and discretization. The PI cross section was computed for three different combinations of fields: an electric field only, perpendicular electric and magnetic fields, and, finally, an, electric field with an angle of 80 degrees to the magnetic field. The field-induced resonances were shown to have Fano-type profiles, with a shape depending on the field combination. The fluctuations of the base line were studied using an autocorrelation function C( epsilon ). For the field combinations studied here, C( epsilon ) has, for small epsilon an initial Lorentzian shape. With increasing epsilon different oscillatory structures in C( epsilon ) were observed. The correlation functions were studied for several energy ranges, achieving a common Lorentzian shape for the highest range, independent of the field combinations. A simple interpretation of the behavior for all cases in terms of chaotic ionization is possible.}
}

@article{Sjoqvist94,
	author = {E. Sjoqvist and O. Goscinski},
	title = {The molecular Aharonov-Bohm effect in bound states beyond the adiabatic approximation},
	journal = {Chemical Physics},
	volume = {186},
	number = {1},
	pages = {17-26},
	month = {15 Aug. 1994},
	year = {1994},
	keywords = {Eigenvalues and eigenfunctions; Harmonic oscillators; Jahn-Teller effect; Molecular vibronic states; Quantum theory; Molecular Aharonov-Bohm effect; Bound states; Adiabatic approximation; Jahn-Teller model; Extrinsic Aharonov-Bohm solenoid; Vibronic case; Energies; Eigenfunctions; Full vibronic Hamiltonian; Two-dimensional harmonic oscillator; Oscillating spin densities; Concomitant Ham's reduction factors; Diagonal vector potentials; Reduction factors; Vibronic angular momentum; Partitioning technique; Adiabatic regime; Vibronic spectra; Vibronic coupling strengths; Hidden dynamical symmetry},
	language = {English},
	abstract = {The linear E(X) in Jahn-Teller model with an 'extrinsic' Aharonov-Bohm solenoid of strength alpha , previously studied by Mead (1980) at the adiabatic level, is generalized to the vibronic case. Energies and eigenfunctions of the full vibronic Hamiltonian are calculated using eigenfunctions of a two-dimensional harmonic oscillator with the solenoid added at the origin. Oscillating spin densities and concomitant Ham's reduction factors (Ham, 1968) are evaluated. The neglect of the diagonal vector potentials is equivalent to alpha =1/2 and, in this case, the reduction factors vanish for vibronic angular momentum j=1/2. The symmetries of the model are studied by partitioning technique. In the adiabatic regime, vibronic spectra with alpha =0 and 1/2 are compared to adiabatic calculations showing that the neglect of the diagonal vector potentials influences the spectra more than the adiabatic approximation. Finally, with alpha =1/2, degeneracies in the spectra show up at some vibronic coupling strengths, indicating a hidden dynamical symmetry.}
}

@article{Karlsson94,
	author = {H.O. Karlsson and O. Goscinski},
	title = {A direct recursive residue generation method: application to photoionization of hydrogen in static electric fields},
	journal = {Journal of Physics B [Atomic, Molecular and Optical Physics]},
	volume = {27},
	number = {6},
	pages = {1061-72},
	month = {28 March 1994},
	year = {1994},
	keywords = {Atomic photoionisation; Electric field effects; Field ionisation; Hydrogen neutral atoms; Matrix algebra; Vectors; Photoionization; H atom; Static electric fields; Direct recursive residue generation method; Hydrogenic systems; Matrix vector product; Hamiltonian matrix; Lanczos vector; Highly excited states; Strong perturbations; Large Hamiltonian matrices; Analytical properties; Laguerre basis; Unperturbed hydrogenic Hamiltonian; Radial functions; Parallel processing; Cross section; Density of states; Tridiagonal Lanczos matrix; Pi polarization; Sigma polarization; H},
	language = {English},
	abstract = {In studies of hydrogenic systems via the recursive residue generation method (RRGM) the major bottleneck is the matrix vector product HC, between the Hamiltonian matrix H and a Lanczos vector C. For highly excited states and/or strong perturbations the size of H grows fast leading to storage problems. By making use of direct methods, i.e. avoidance of explicit construction of large Hamiltonian matrices, such problems can be overcome. Utilizing the underlying analytical properties of the Laguerre basis e/sup - lambda r/L/sub k//sup 2l+2/(2 lambda r) a direct RRGM (D-RRGM) for the unperturbed hydrogenic Hamiltonian is derived, changing the storage needs from scaling as N/sup 2/ to 4N where N is the number of radial functions for each factorized H/sub 0/(l,m) block with the possibility of parallel processing. A further computational simplification is introduced by putting the expression for the photoionization (PI) cross section in the rational form conventionally used in the representation of density of states (DOS). This allows the construction of the PI cross section directly from the tridiagonal Lanczos matrix avoiding the explicit calculation of individual eigenvalues and eigenvectors. To illustrate and verify the method the PI cross section for a hydrogen atom in a static electric field, for both pi and sigma polarization, was calculated for an electric field strength of F=5714 V cm/sup -1/. Sufficiently large basis sets could be employed so that good comparison with experiment and other theoretical work was obtained, including the field-induced modulations near the zero-field ionization limit.}
}

@article{Hagg94,
	author = {L. Hagg and O. Goscinski},
	title = {Gaussian approximations to equilibrium charge-state distributions with the maximum entropy method},
	journal = {Journal of Physics B [Atomic, Molecular and Optical Physics]},
	volume = {27},
	number = {1},
	pages = {81-95},
	month = {14 Jan. 1994},
	year = {1994},
	keywords = {Atom-ion collisions; Beam-foil spectra; Bismuth; Calcium; Copper; Electron capture; Holmium; Ionisation of atoms; Rhodium; Yttrium; Gaussian approximations; Equilibrium charge-state distributions; Maximum entropy method; Ions; Beam-foil experiments; Symmetric distributions; Asymmetric distributions; Shell effect; Fermi Dirac statistics; Interpolation procedure; Cu; Ca; Ti; Y; Rh; Ho; Bi},
	language = {English},
	abstract = {Charge-state distributions for ions in beam-foil experiments are discussed in detail and analysed using the maximum entropy method (MEM). The symmetric distributions can be well described by one Gaussian in the whole charge-state interval. It is found that asymmetric distributions, exhibiting the shell effect can be treated using two disjoint Gaussians, in two separate intervals. The relative weights of these Gaussians are interpreted by using Fermi Dirac statistics. Physically this corresponds to varying occupancy of some of the shells in the ions. The fact that no more than two moments, in one interval or two, is sufficient is of significant importance in the analysis of charge-state distributions in general. An interpolation procedure to obtain the charge-state distribution for an energy is developed and tested. The procedure, which is made possible by the Gaussian character, uses MEM and experimental information. It is only possible to predict distributions in energy regions where experimentally measured values for other energies exist. The method is tested on asymmetric distributions of copper ions in the energy range 0.902-1.505 MeV u/sup -1/ and symmetric distributions for calcium, titanium, yttrium, rhodium, holmium and bismuth ions for energies from 0.191 to 3.184 MeV u/sup -1/.}
}

@article{Goscinski93,
	author = {O. Goscinski and L. Hagg},
	title = {Dimensional scaling of local pseudopotentials},
	journal = {THEOCHEM},
	volume = {106},
	pages = {17-21},
	location = {Merida, Venezuela},
	note = {From conference: Theoretical Chemistry 1992. XXth International Congress of Theoretical Chemists of Latin Expression, 12-17 Oct. 1992},
	month = {14 Nov. 1993},
	year = {1993},
	keywords = {Atomic excited states; Integral equations; Dimensional scaling; Local pseudopotentials; Integral equations; Modified local potential; Coulombic potential; Lowest state; Spectrum; Excited states; Ground state; Valence states},
	language = {English},
	abstract = {The integral equations of Gelfand and Levitan were previously used by Abraham and Moses (1980) to construct a modified local potential V/sub pert/(r), which in this work is added to a coulombic potential in order to remove the lowest state from the spectrum. The total modified potential V/sub new/(r), for excited states is used in conjunction with the shifted 1/D expansions of dimensional scaling. It is verified that it is feasible to find the lowest energies and the mean radius for V/sub new/, treating it now as a ground state problem. This indicates that a potential for excited states can be generated by the procedure, with the possibility of using it in the study of excited states and valence states. The potentials applied can be considered as local pseudopotentials.}
}

@article{Hagg93,
	author = {L. Hagg and O. Goscinski},
	title = {Maximum entropy method and equilibrium charge state distributions},
	journal = {Journal of Physics B [Atomic, Molecular and Optical Physics]},
	volume = {26},
	number = {15},
	pages = {2345-58},
	month = {14 Aug. 1993},
	year = {1993},
	keywords = {Beam-foil spectra; Copper; Entropy; Equilibrium charge state distributions; Maximum entropy method; Beam-foil spectroscopy; Moment conditions; Lagrange interpolation polynomials; Chebyshev polynomials; C foil; Cu foil},
	language = {English},
	abstract = {The maximum entropy method is implemented in order to describe equilibrium distributions arising in beam-foil spectroscopy. Since there are very few charge states involved, the usual moment conditions, based on simple powers x/sup i/, give rise to severe numerical difficulties already for three moments and cannot be applied in these systems. Earlier devised methods, based on Lagrange interpolation polynomials Q/sub i/(x) with abscissae chosen as zeros of Chebyshev polynomials in the interval being studied, are adapted and implemented for the present problems of charge state distributions. A reduced variable x=(q-(q))/(q), where q is the charge and (q) the mean charge, is chosen. Using the method described above calculations of equilibrium charge state distributions for copper ions (exit energy range 0.559-2.304 MeV u/sup -1/) colliding with carbon foils are carried out in order to exhibit the usability of the method. The new moment conditions associated to the Q/sub i/(x) provide a framework for a systematic analysis of equilibrium distributions.}
}

@article{Goscinski72,
	author = {O. Goscinski},
	title = {Outer vibrational turning points near dissociation in the B(/sup 3/ Pi /sub 0u//sup +/) state of Br/sub 2/ and Cl/sub 2/},
	journal = {Molecular Physics},
	volume = {24},
	number = {3},
	pages = {655-9},
	month = {Sept. 1972},
	year = {1972},
	keywords = {Bromine; Chlorine; Molecular collision processes; Molecular dissociation; Molecular vibration; Outer vibrational turning points; Dissociation; Br/sub 2/; Cl/sub 2/; Pade approximant; Distribution of vibrational energy levels; B(/sup 3/Pi/sub 0u//sup +/) state; Long range interaction energy; Rydberg Klein Rees curve},
	language = {English},
	abstract = {A (1, 0) Pade approximant to the long-range interaction energy is used to describe the outer limb of the Rydberg-Klein-Rees curve of the state B (/sup 3/ Pi /sub 0u//sup +/) of Br/sub 2/ and Cl/sub 2/. Empirical values of C/sub 5/ and C/sub 6/ are obtained.}
}

@article{Goscinski72a,
	author = {O. Goscinski and O. Tapia},
	title = {Predissociation by rotation and long-range interactions},
	journal = {Molecular Physics},
	volume = {24},
	number = {3},
	pages = {641-54},
	month = {Sept. 1972},
	year = {1972},
	keywords = {Molecular collision processes; Molecular dissociation; Molecular rotation; Predissociation; Rotation; Limiting curve of dissociation; Interaction potential; Dispersion region; Pade approximant; Multipole expansion; Energy; Asymptotic properties; H/sub 2/; Long range interactions},
	language = {English},
	abstract = {A formula of Bernstein (1966) for the limiting curve of dissociation is generalized to the case where the interaction potential in the dispersion region is represented by the (1, 0) Pade approximant to the multipole expansion of the energy. The determination of the asymptotic properties of the potential from pre-dissociation data is discussed. Data of Herzberg (1970) for the state B' /sup 1/ Sigma /sub u//sup +/ of H/sub 2/ indicate that the Pade approximant gives a consistent representation of the potential. The classical example of pre-dissociation by rotation (HgH) is studied and for the state X /sup 2/ Sigma /sup +/ a value of C/sub 6/ similar to Bernstein is obtained. In addition C/sub 8/ is estimated to be 89 a.u.}
}

@article{Ohrn93,
	author = {Y. Ohrn and O. Goscinski},
	title = {Analysis of the Thouless coherent state using the 1/K expansion},
	journal = {Physical Review A [Atomic, Molecular, and Optical Physics]},
	volume = {48},
	number = {2},
	pages = {1093-7},
	month = {Aug. 1993},
	year = {1993},
	keywords = {Atomic structure; Molecular energy level calculations; Spin-orbit interactions; Thouless coherent state; 1/K expansion; Many-electron problem; Spin-orbital basis; Hamiltonian; Unitary group; Coherence group; Global symmetry; Dynamical variables; Complex state parameters; Flat generalized phase space; Energy functional; Power series},
	language = {English},
	abstract = {The many-electron problem in a spin-orbital basis of rank K, with a Hamiltonian exhibiting the unitary group U(K) (the coherence group), global symmetry is treated as a detailed example of the technique often referred to as the 1/K expansion. This approach introduces a free parameter K, which is a measure of the number of dynamical variables and usually also invokes coherent states associated with the coherence group. The authors choose the Thouless coherent state, transform the complex state parameters so that they exhibit the structure of a flat generalized phase space, and analyze the corresponding energy functional as a power series in 1/K. The limit of large K and that of a large number of electrons are discussed and compared to the expected classical limit.}
}

@article{Karlsson92,
	author = {H.O. Karlsson and O. Goscinski},
	title = {Perturbed hydrogenic manifolds studied by the recursive residue generation method},
	journal = {Journal of Physics B [Atomic, Molecular and Optical Physics]},
	volume = {25},
	number = {23},
	pages = {5015-28},
	month = {14 Dec. 1992},
	year = {1992},
	keywords = {Atomic structure; Hydrogen neutral atoms; Stark effect; Zeeman effect; Hydrogenic manifolds; Recursive residue generation method; Perturbation; Bound states; Complex dilation; Orthonormal Laguerre basis; Lanczos algorithm; Sum rules; Stark resonance; Zeeman effect},
	language = {English},
	abstract = {A method for calculating the perturbation of hydrogenic manifolds, the emerging bound states and resonances, for arbitrary combinations of external fields, is presented. It requires the combined use of complex dilation, an orthonormal Laguerre basis e/sup - lambda r/L/sup 2l+2//sub k/( lambda r) rather than the non-orthogonal Sturmians e/sup - lambda r/L/sup 2l+1//sub k/( lambda r), and the recursive residue generation method (RRGM) version of the Lanczos algorithm. Generalized eigenvalue problems are avoided. Furthermore, direct computation of the residues of resolvents, transition amplitudes and sum rules is achieved. Comparison with other methods and with previous calculations, suitable for one perturbation at a time, indicates that high accuracy is achieved separately both for the 1s Stark resonance and for the 1s Zeeman effect. Accurate results for the 1s Stark-Zeeman resonance, for various combinations of fields, are given.}
}

@article{Springborg91,
	author = {M. Springborg and J.-L. Calais and O. Goscinski and L.A. Eriksson},
	title = {Linear-muffin-tin-orbital method for helical polymers: a detailed study of trans-polyacetylene},
	journal = {Physical Review B [Condensed Matter]},
	volume = {44},
	number = {23},
	pages = {12713-36},
	month = {15 Dec. 1991},
	year = {1991},
	keywords = {Ab initio calculations; Bond lengths; Compton effect; Conducting polymers; Density functional theory; Electron energy states of amorphous solids; Electronic density of states; Localised electron states; Losses; Muffin-tin potential; Photoelectron spectra; Polarons; Solitons; First-principles calculations; Density-functional method; Localized electron density; Localized spin density; Trans-polyacetylene; Full-potential linear-muffin-tin-orbital method; Helical polymers; Total energy; Bond lengths; Band structures; Densities of states; Photoelectron cross sections; Optical spectra; Loss function; Electron-energy-loss spectra; Compton-scattering; Mulliken populations; Su-Schrieffer-Heeger model; Solitons; Polarons; Gap levels; Lattice distortion},
	language = {English},
	abstract = {Results of a detailed theoretical study of trans-polyacetylene are reported. In the first part, the authors present results on periodic chains which have been obtained with the first-principles, density-functional, full-potential linear-muffin-tin-orbital method for helical polymers. The lowest total energy is found for a structure with alternating carbon-carbon bond lengths in good agreement with experimental findings. Electronic band structures and densities of states are also presented. Moreover, photoelectron cross sections are determined and are used in calculating optical spectra, which are shown to agree well with experiments. A qualitative loss function is used in comparison with experimental electron-energy-loss spectra, and the results of Compton-scattering experiments are predicted. In the second part they use the band structures, total energy, and Mulliken populations as functions of the structure in deriving a generalized, single-particle, Su-Schrieffer-Heeger model, which subsequently is used in studying solitons and polarons. It is found that solitons are stable distortions for the charged chains, and that the gap levels are placed about 0.1 eV from the midgap position. The lattice distortion, but not the electron or spin density, is more localized within the present model than with the Su-Schrieffer-Heeger model. Polarons, on the other hand, are found to be very shallow and most likely not stable.}
}

@article{Li Yin; Goscinski90,
	author = {Li Yin and O. Goscinski},
	title = {Differentiability of degenerate electronic wave functions with respect to parametric variables},
	journal = {International Journal of Quantum Chemistry},
	volume = {37},
	number = {3},
	pages = {249-56},
	month = {March 1990},
	year = {1990},
	keywords = {Molecular energy level calculations; Wave functions; Discontinuous functions; Degenerate electronic wave functions; Parametric variables; Differentiability; Parameter space; Berry's formula; Geometric phase},
	language = {English},
	abstract = {The paper is aimed at differentiability of electronic wave functions, with respect to parametric variables, in the presence of electronic degeneracy. An analysis is made of a wave function, constructed so that it has the largest domain of parameter space in which it is differentiable, with the help of Berry's formula for the geometric phase. In particular, the electronic wave functions, in presence of a double degeneracy in two- and three-dimensional parameter spaces, are studied in detail. The three-parameter-dependent wave function is differentiable everywhere except along an axis starting from the degenerate point where it is discontinuous. The two-parameter-dependent wave function is differentiable everywhere except at the degenerate point where it is discontinuous. These singularities are expected to have consequences on wave functions having parametric variables as arguments.}
}

@article{Li Yin; Goscinski90a,
	author = {Li Yin and O. Goscinski},
	title = {Separation of slow motion in E(X) epsilon vibronic states},
	journal = {Chemical Physics},
	volume = {140},
	number = {3},
	pages = {363-72},
	month = {1 Feb. 1990},
	year = {1990},
	keywords = {Eigenvalues and eigenfunctions; Jahn-Teller effect; Molecular vibronic states; Born-Huang approximations; Nuclear radial coordinates; Vibronic states; Angular coordinates; Radial nuclear coordinate; Eigenstates; Born-Oppenheimer approximations},
	language = {English},
	abstract = {A new separation of slow motion is introduced to describe linear as well as linear-plus-quadratic E(X) epsilon vibronic states. Instead of separating the nuclear radial and angular coordinates altogether, only the radial nuclear coordinate is separated as the parametric variable. It is shown that eigenstates of the new Hamiltonian are no longer involved in a degeneracy, and therefore the Born-Huang and Born-Oppenheimer approximations work well.}
}

@article{Yin89,
	author = {L. Yin and O. Goscinski},
	title = {Non-adiabaticity in terms of dynamic potentials. An analysis of linear E(X) in vibronic states},
	journal = {Chemical Physics},
	volume = {137},
	number = {1-3},
	pages = {67-75},
	month = {15 Oct. 1989},
	year = {1989},
	keywords = {Eigenvalues and eigenfunctions; Molecular vibronic states; Potential energy functions; Dynamic potentials; Linear E(X) in vibronic states; State-dependent nonadiabatic potentials; Conventional adiabatic potentials; Conditional probability factorization; Kinetic energy contribution; Degenerate point; Nuclear radial motion; Nuclear azimuthal; Electronic motion; Vibronic coupling; Eigenvalues},
	language = {English},
	abstract = {Nonadiabaticity of the linear E(X) in vibronic states is studied in terms of the difference between state-dependent nonadiabatic potentials and conventional adiabatic potentials. The former are obtained by constructing the nonadiabatic equation based on the conditional probability factorization of nonadiabatic states and formally similar to their adiabatic counterparts. The authors found that nonadiabaticity is mainly due to a kinetic energy contribution. Even in a region of strong nonadiabaticity (i.e. near the degenerate point), the nuclear radial motion is well separated from the nuclear azimuthal and the electronic motion. In the case of strong vibronic coupling, though the adiabatic potential gives a good approximation to the eigenvalues, their result shows that nonadiabaticity remains.}
}

@article{Goscinski89,
	author = {O. Goscinski and J. Delhalle},
	title = {Hyperpolarizability approximations},
	journal = {International Journal of Quantum Chemistry},
	volume = {35},
	number = {6},
	pages = {761-7},
	month = {June 1989},
	year = {1989},
	keywords = {Molecular polarisability; Nonlinear optics; Optical materials; Organic compounds; Nonlinear optics; Optical materials; Organic compounds; Approximations; Approximation; Hyperpolarizabilities; Operator inequalities; Ordinary polarizabilities; Moments; Oscillator strength distributions; Sum rules; Ground state properties},
	language = {English},
	abstract = {The approximation of hyperpolarizabilities through the use of operator inequalities is sketched. Previously applied methods to ordinary polarizabilities are extended. They lead to expressions involving moments of oscillator strength distributions related through sum rules to ground state properties. Systematic applications of new formulae are suggested.}
}

@article{Helenelund87,
	author = {K. Helenelund and S. Hedman and L. Asplund and U. Gelius and K. Siegbahn and P. Froelich and O. Goscinski},
	title = {Post-collision interaction in the photoexcited electron spectrum of selenium},
	journal = {Singapore Journal of Physics},
	volume = {4},
	number = {1},
	pages = {67-79},
	month = {Jan. 1987},
	year = {1987},
	keywords = {Auger effect; Photoemission; Selenium; Photoexcited electron spectrum; Post-collision interaction; Photoelectron spectrum; Auger lines; Deep lying Se 2p core holes; Spin orbit splitting; 40.81 EV; Se},
	language = {English},
	abstract = {Evidence for a post-collision interaction (PCI) in the photoelectron spectrum of the selenium 2p/sub 3/2/ level is reported. The Auger lines corresponding to the decay of the deep lying Se 2p core holes are also shown to be affected by PCI. The Se 2p/sub 3/2/ photo-electron and Auger line-shapes are well described by the semi-classical PCI energy distribution derived from the 'shake-down' model. Furthermore, the nominal Se 2p spin orbit splitting is determined to 40.81(5) eV.}
}

@article{Mujica87,
	author = {V. Mujica and Y. Li and O. Goscinski},
	title = {Dynamic coordinate separation and state-dependent potentials. An analysis of localization in helium},
	journal = {Chemical Physics},
	volume = {112},
	number = {2},
	pages = {159-72},
	month = {1 March 1987},
	year = {1987},
	keywords = {Atomic structure; Helium atoms; Potential energy functions; Wave functions; Nonadiabaticity; State-dependent potentials; Localization; Wavefunction; Marginal probability amplitudes; Kinetic energy operator; Curvilinear coordinates; Conditional amplitude; Localized wavefunctions; Hylleraas coordinates; Ground state; Adiabatic breakup; Hartree-like one-electron potential; He},
	language = {English},
	abstract = {The authors have examined in detail the construction of state-dependent dynamic potentials (SDPs) based on an exact separation scheme of the wavefunction as a product of coupled conditional and marginal probability amplitudes. For particles of equal mass and for rather general forms of the kinetic energy operator in curvilinear coordinates, it is proven that the SDP becomes the expectation value of the total hamiltonian with respect to the conditional amplitude obtained from an assumed real wavefunction. The use of these SDPs for the description of localized wavefunctions is also discussed. As an example the authors have undertaken the analysis of SDPs arising from various separation schemes of Hylleraas coordinates for two simple wavefunctions approximating the ground state of helium. The separation of s=r/sub 1/+r/sub 2/, t=r/sub 2/-r/sub 1/ and r/sub 12/ leads to SDPs exhibiting minima in the regions where localization of the wavefunction takes place. The possibility of an adiabatic breakup, Born-Oppenheimer type, of the problem is also considered. The results show that strong 'non-adiabaticity' is a distinct feature of all the separations the authors considered. The separation of r/sub 1/ is treated too as an example of a non-collective variable and the corresponding SDP resembles an effective Hartree-like one-electron potential. The authors finally sketch some possible applications of the present approach for the analysis of localization and non-adiabaticity in more complex situations in atomic and molecular cases.}
}

@article{Goscinski85,
	author = {O. Goscinski},
	title = {Are localized broken symmetry solutions acceptable in molecular calculations?},
	journal = {International Journal of Quantum Chemistry, Quantum Chemistry Symposia},
	number = {no.19},
	pages = {51-9},
	location = {Marineland, FL, USA},
	note = {From conference: Proceedings of the International Symposium on Atomic, Molecular and Solid-State Theory, Scattering Problems, Many Body Phenomena, and Computational Quantum Chemistry, 18-23 March 1985},
	year = {1985},
	keywords = {Molecular energy level calculations; Reviews; Localized broken symmetry solutions; Molecular calculations; Nonlocalized broken symmetry; Excited states; Overall symmetry; Broken-symmetry solutions; Core-ionization},
	language = {English},
	abstract = {The question of localized versus nonlocalized broken symmetry core-hole and low-lying excited states is reviewed with particular emphasis on the role of the overall symmetry. The broken-symmetry solutions, which yield for core-ionization very good results for the energy, if symmetrized give a splitting and perhaps a worse energy. It is argued that when the splitting is smaller than the experimental resolution the appropriate description of the physical state is not a wave function, but a density matrix (statistical ensemble) of broken-symmetry states with correct overall symmetry.}
}

@proceedings{Aberg85,
	author = {T. Aberg and A. Blomberg and O. Goscinski},
	editor = {M.J. Coggiola and D.L. Huestis and R.P. Saxon},
	title = {Theory of equilibrium charge-state distributions},
	journal = {Electronic and Atomic Collisions. Fourteenth International Conference on the Physics of Electronic and Atomic Collisions. Abstracts of Contributed Papers},
	pages = {456},
	organization = {North-Holland},
	location = {Palo Alto, CA, USA},
	note = {Date of conference: 24-30 July 1985},
	year = {1985},
	isbn = {0 444 86984 0},
	keywords = {Charge exchange; Electron capture; Kinetic theory of gases; Master equation; Electron loss; Equilibrium charge-state distributions; Charge distribution; Ions; Gases; Master equations; Cross-sections; Equilibrium distribution; Information-theoretical arguments; Statistical analysis; Gamma-distribution; Multiple electron capture; Microscopic processes},
	language = {English},
	abstract = {The variation of the charge distribution of ions penetrating through gases is usually described by a system of master equations involving cross-sections of all relevant charge-changing processes (1972). Since information on these quantities for many-electron atoms is scarce, this approach does not allow for a derivation of the equilibrium distribution P(q). Previously, using information-theoretical arguments (1982) and a statistical analysis P(q) has been shown to be well described by either a distribution normal in 1n(q+2) (the lognormal distribution) or the gamma-distribution in the q+2, the X/sup 2/-distribution also used by Baudinet-Robinet et al. (1982). The former corresponds to cases with heavy projectiles and targets in which both multiple electron capture and loss are appreciable. For a better understanding of the origin and implications of these distributions the authors study the underlying microscopic processes in more detail than considered previously.}
}

@article{Goscinski71,
	author = {O. Goscinski},
	title = {Density of states in narrow energy bands},
	journal = {Chemical Physics Letters},
	volume = {9},
	number = {4},
	pages = {293-5},
	month = {15 May 1971},
	year = {1971},
	keywords = {Atomic structure; Crystal electron states; Molecular electronic structure; Energy bands; Narrow; Density of states; Hubbard's model; Decoupling schemes},
	language = {English},
	abstract = {The density of states in the one-band short-range interaction model approximated with Hubbard's decoupling is equal to the I-independent band theoretical result at E=T/sub O/ and E=T/sub O/+I. Improved decoupling procedures remove this anomaly.}
}

@article{Blomberg86,
	author = {A. Blomberg and T. Aberg and O. Goscinski},
	title = {Stochastic theory of equilibrium charge-state distributions of heavy ions in gases},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {19},
	number = {7},
	pages = {1063-74},
	month = {14 April 1986},
	year = {1986},
	keywords = {Atom-ion collisions; Charge exchange; Kinetic theory of gases; Stochastic processes; Equilibrium charge-state distributions; Heavy ions; Gases; Stochastic theory; Single ion-atom collision; Statistical analysis; Gamma distributions; Scaling law},
	language = {English},
	abstract = {A stochastic theory of equilibrium charge-state distributions is presented and its explicit relation to the underlying single ion-atom collision is shown. In this approach each individual collisions is regarded as a stochastic process in which either loss or capture of one or several electrons occurs. The result is a universal representation of charge-state distributions which reproduces the observed asymmetries in terms of a single energy-independent parameter. A statistical analysis shows that this parameter, which is related to a correlation function in single collisions, assumes essentially two values only, leading to the log normal and gamma distributions, respectively. Furthermore the theory predicts a scaling law for single collisions which was fulfilled by the recent cross section measurements of Astner and co-workers (1984).}
}

@article{Goscinski86,
	author = {O. Goscinski and V. Mujica},
	title = {Adiabatic coordinate separation and large N-dimensional limit in two-electron ions},
	journal = {International Journal of Quantum Chemistry},
	volume = {29},
	number = {4},
	pages = {897-908},
	location = {Montreal, Que., Canada},
	note = {From conference: Proceedings of the Fifth International Congress in Quantum Chemistry, 18-24 Aug. 1985},
	month = {April 1986},
	year = {1986},
	keywords = {Potential energy curves and surfaces of molecules; Adiabatic coordinate separation; N-dimensional limit; 1/ N expansion; Semiclassical effective potentials; Two-electron ions; Two-electron coulomb potential; Quantum mechanical effects; Effective potentials; Broken symmetry solutions; Geometric localization; Kinetic energy; Effective mass},
	language = {English},
	abstract = {The 1/N expansion is used to generate semiclassical effective potentials for two-electron ions. These potentials can be considered an improvement over the conventional ones computed by Lin and Fano (1983) for the full two-electron coulomb potential, insofar as they incorporate some of the quantum mechanical effects. No falling into the nucleus is allowed. Furthermore, the minima of these effective potentials are in surprising agreement with those computed by Fano (1983), Macek (1968), and Lin (1983). This would indicate that the collective variable R, associated with N=6, leads to a much smaller expansion parameter N, making the adiabatic separation more justified. The role and significance of these broken symmetry solutions with geometric localization are discussed as well as generalizations. The procedure is semiclassical in the sense that the kinetic energy becomes negligible by having a large effective mass.}
}

@article{Froelich86,
	author = {P. Froelich and O. Goscinski and U. Gelius and K. Helenelund},
	title = {Electron impact induced post-collisional Auger decay. A two-potential complex coordinate treatment},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {19},
	number = {4},
	pages = {387-99},
	month = {28 Feb. 1986},
	year = {1986},
	keywords = {Atomic electron impact excitation; Atomic electron impact ionisation; Atomic resonant states; Auger effect; Molecular electron impact excitation; Molecular electron impact ionisation; Molecular resonant states; Electron impact induced post collisional Auger decay; Atomic resonance theory; Two-potential complex coordinate treatment; Post-collisional Auger decay; Excitation threshold; Molecular resonance theory; Electron Compton scattering; Compton defect; Gell-Mann-Goldberger two-potential formulation; Complex coordinate method},
	language = {English},
	abstract = {The process of post-collisional Auger decay induced by electron impact is discussed. Close to the excitation threshold the situation is framed within the atomic and molecular resonance theory, and discussed from the point of view of electron Compton scattering. The connection between post-collisional effects in Auger decay and the Compton defect is indicated. For restricted classes of processes, the scattering amplitudes is derived. The derivation is based on the Gell-Mann-Goldberger two-potential formulation combined with the complex coordinate method, and provides an extension of the treatment recently proposed by us for photon-induced Auger decay.}
}

@article{Helenelund86,
	author = {K. Helenelund and U. Gelius and P. Froelich and O. Goscinski},
	title = {Photon-induced post-collisional Auger decay: a modified 'shake-down' model},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {19},
	number = {4},
	pages = {379-86},
	month = {28 Feb. 1986},
	year = {1986},
	keywords = {Atomic spectral line breadth; Auger effect; Molecular spectral line breadth; Optical pumping; Photoelectron spectra; Wave functions; Modified shake down model; Photon induced post collisional Auger decay final state; Photoelectron lineshapes; Post-collision interaction; Photon impact; Photoelectron energies; Photoelectron wavefunctions; Smeared intermediate states},
	language = {English},
	abstract = {A modified 'shake-down' model describing both Auger and photoelectron lineshapes is derived from the two-potential formulation of post-collision interaction following photon impact. The model gives the correct expression for the lineshapes at high photoelectron energies and finite Auger energies. The distortion of the lineshapes is shown to be given by the overlap between the photoelectron wavefunctions in the final and smeared intermediate states, for which a construction is explicitly given.}
}

@article{Froelich86a,
	author = {P. Froelich and O. Goscinski and N. Moiseyev},
	title = {Resonances from the complex dilated Hamiltonians in a dilation-adapted basis set with a new stabilization parameter},
	journal = {Journal of Chemical Physics},
	volume = {84},
	number = {7},
	pages = {3931-6},
	month = {1 April 1986},
	year = {1986},
	keywords = {Atomic structure; Molecular energy level calculations; Resonances; Dilation-adapted basis set; Stabilization parameter; Dilated Hamiltonian; Matrix representation; L/sup 2/ basis; Dilation angle; Complex stabilization method},
	language = {English},
	abstract = {Explicit consideration of the analytic properties of the solutions to the dilated Hamiltonian is taken into account in the construction of the matrix representation of the latter in an L/sup 2/ basis. The total dilated matrix is blocked according to division of the basis into 'bound' and 'scattering' subspaces, which are interacting via the off-diagonal blocks, leading to a coupling maintaining the adequacy of the bound part of the basis throughout the wide range of the dilation angle. The size of the bound subspace, M, becomes a new stabilization parameter; its variation covers the entire range of situations between a real stabilization calculation and the conventional complex-scaling calculation. This construction allows for a systematic analysis of the dilated Hamiltonian, bringing forward the physical interpretation of the configuration interaction while suppressing the disadvantageous effects of the dilation transformation, manifested by poor convergence. The connections to Junker's complex stabilization method (1980) are discussed.}
}

@article{Moiseyev85,
	author = {N. Moiseyev and O. Goscinski},
	title = {Effective potentials and the Gel'fand-Levitan equation},
	journal = {Chemical Physics Letters},
	volume = {120},
	number = {6},
	pages = {520-3},
	month = {25 Oct. 1985},
	year = {1985},
	keywords = {Molecular electronic states; Molecular energy level calculations; Gel'fand-Levitan equation; Particle box; Harmonic oscillator; Coulomb potentials; Effective potentials; Hamiltonians; Predissociation resonances; Excited states},
	language = {English},
	abstract = {Moses et al. (1980) have derived an algorithm using the Gel'fand-Levitan equation (1951) for generating exactly solvable potentials for a particle box, harmonic oscillator, and Coulomb potentials by adding or subtracting a finite number of eigenvalues. The authors propose that their algorithm can be used to evaluate effective potentials for non exactly soluble molecular model Hamiltonians. They show that the algorithm can be used to remove bound states from the spectrum and to obtain an effective potential which supports predissociation resonances only. It can also be used to remove a specific resonance state from the spectrum, and to facilitate evaluations of excited states.}
}

@article{Moiseyev85a,
	author = {N. Moiseyev and R. Schatzberger and O. Goscinski and P. Froelich},
	title = {Study of mode specificity by the natural expansion analysis},
	journal = {Journal of Chemical Physics},
	volume = {83},
	number = {8},
	pages = {3924-31},
	month = {15 Oct. 1985},
	year = {1985},
	keywords = {Carbon compounds; Chemical reactions; Molecular dissociation; Molecular rotational-vibrational energy transfer; Organic compounds; Reaction kinetics; SCF calculations; SCF method; Natural expansion analysis; Stable states; Natural expansion analysis; Local modes; Unimolecular reaction; Metastable vibrational states; SCF approximation; Optimal molecular modes; Vibrational energy; Internal coordinates; Hamiltonian; Unimolecular decomposition; CO/sub 2/; Formaldehyde},
	language = {English},
	abstract = {The self-consistent field (SCF) method beyond its computational advantage lends meaning to the concept of local modes and its applicability implies mode specificity in the unimolecular reaction being studied. The natural expansion (NE) analysis of stable or metastable vibrational states is presented. The NE analysis enables one to determine the applicability of the SCF approximation, the optimal molecular modes for any given vibrational energy and therefore provides a positive test for mode specificity. Moreover, it is shown that even when the internal coordinates of the Hamiltonian are not optimized and there are several dominant configurations in the NE, mode specificity can be indicated by analyzing these configurations. As examples, the mode specificity in the unimolecular decomposition of CO/sub 2/ to CO+O and in the dissociation of formaldehyde to H/sub 2/+CO are studied by the NE analysis.}
}

@article{Mujica85,
	author = {V. Mujica and N. Correia and O. Goscinski},
	title = {Fermion-propagator calculations of excitations in polyenes with the use of a Heisenberg (XYZ) Hamiltonian. II. Applications to large systems},
	journal = {Physical Review B [Condensed Matter]},
	volume = {32},
	number = {6},
	pages = {4186-91},
	month = {15 Sept. 1985},
	year = {1985},
	keywords = {Heisenberg model; Polymers; Spin Hamiltonians; Fermion propagator calculations; Heisenberg Hamiltonian; Large systems; Excitation energies; Polyenes; Effective-spin Hamiltonian; Diagonalization; Local spin flippings; Doublet exciton gap; Electronic correlation; Local ground-state spin densities},
	language = {English},
	abstract = {For pt.I see ibid., vol.32, no.6, p.4178 (1985). A previously developed formalism for calculating excitation energies in polyenes using an effective-spin Hamiltonian is applied to large systems. The method involves only diagonalization of N*N matrices (N being the number of sites). A description of the excitation process in terms of local spin flippings is given and values of the triplet and doublet exciton gap for finite polyenes can be estimated. When applied to deformed chains with odd N, midgap states appear. Introduction of electronic correlation renders local ground-state spin densities which are in qualitative agreement with electron-nuclear double-resonance measurements. Excited-state spin densities are also discussed in some cases.}
}

@article{Mujica85a,
	author = {V. Mujica and N. Correia and O. Goscinski},
	title = {Fermion-propagator calculations in excitations in polyenes with the use of Heisenberg (XYZ) Hamiltonian. I. Formalism and parametrization},
	journal = {Physical Review B [Condensed Matter]},
	volume = {32},
	number = {6},
	pages = {4178-85},
	month = {15 Sept. 1985},
	year = {1985},
	keywords = {Heisenberg model; Polymers; Spin Hamiltonians; Effective spin operator; Heisenberg; Low-lying excitation spectrum; Linear polyenes; Jordan-Wigner transformation; Spin Hamiltonian; Fermion operators; Single-fermion propagator; Excitation energies; Neutral valence-bond fermion configurations},
	language = {English},
	abstract = {An effective spin operator of the Heisenberg type is used for studying the low-lying excitation spectrum of linear polyenes. A Jordan-Wigner transformation allows one to write the spin Hamiltonian in terms of fermion operators and a single-fermion propagator is employed for calculating the excitation energies of the system. The correlated reference states for the propagator are expressed in terms of neutral valence-bond fermion configurations. Results are given for small linear polyenes with N sites. Some results for small rings are also given.}
}

@article{Sangfelt85,
	author = {E. Sangfelt and O. Goscinski},
	title = {A generalization of the AGP model propagator to a reference state including different geminals},
	journal = {Journal of Chemical Physics},
	volume = {82},
	number = {9},
	pages = {4187-93},
	month = {1 May 1985},
	year = {1985},
	keywords = {Atomic structure; Molecular energy level calculations; SCF calculations; Wave functions; MCSCF calculation; Antisymmetrised geminal power reference state; AGP model propagator; Reference state; Ground state; Factorization; Wave function; Multiconfigurational expansion; Excitation operators},
	language = {English},
	abstract = {A geminal product (GP) of two different geminals g'(1,2)g'(3,4) is compared to other GPs of type g(1,2)g(3,4) and u(1)u(2)g(3,4) in an application to the ground state of Be. The factorization g'g' is remarkable since it gives, within the basis sets employed, the same total energy as a multiconfigurational self consistent field (MCSCF) calculation using the same configurations. A model wave function is chosen as an antisymmetrized product of an independent particle function and a correlated four-electron part. The latter consists of a multiconfigurational expansion restricted to pair substitutions of which the product of different geminals is a special case. The authors construct excitation operators that satisfy certain vacuum conditions for this reference state. In the case of four electrons this leads to a model propagator which is a direct generalization of a recently reported model propagator based on an antisymmetrized geminal power (AGP) reference state.}
}

@article{Sangfelt84,
	author = {E. Sangfelt and H.A. Kurtz and N. Elander and O. Goscinski},
	title = {Excited states via the AGP polarization propagator. I. Application to Li/sub 2/},
	journal = {Journal of Chemical Physics},
	volume = {81},
	number = {9},
	pages = {3976-86},
	month = {1 Nov. 1984},
	year = {1984},
	keywords = {Lithium; Molecular electronic states; Potential energy curves and surfaces of molecules; Radiative lifetimes; SCF calculations; Transition moments; Wave functions; Optimised antisymmetrised geminal power wave function; Multiconfiguration SCF type calculations; Transition moments; Excited states; AGP polarization propagator; Li/sub 2/; Potential energy curves; Spectroscopic constants; Low-lying electronic states; Radiative lifetimes},
	language = {English},
	abstract = {An approximation to the polarization propagator using an optimized antisymmetrized geminal power (AGP) wave function as a reference state is discussed. As an application, potential energy curves and spectroscopic constants for some of the low-lying electronic states in Li/sub 2/ are given. Transition moments and radiative lifetimes for the experimentally observed B /sup 1/ Pi /sub u/-X /sup 1/ Sigma /sub g//sup +/ and A 1 Sigma /sub u//sup +/-X /sup 1/ Sigma /sub g//sup +/ transitions are also presented. Excellent agreement with experiment and theoretical calculations of multiconfigurational self-consistent field (MCSCF) type is obtained.}
}

@article{Goscinski70,
	author = {O. Goscinski and B. Lukman},
	title = {Moment conserving decoupling of Green functions via Pade approximants},
	journal = {Chemical Physics Letters},
	volume = {7},
	number = {6},
	pages = {573-6},
	month = {15 Dec. 1970},
	year = {1970},
	keywords = {Green's function methods; Pade approximants; Approximate Green functions; Moment conserving decoupling; Inner projection technique},
	language = {English},
	abstract = {A generalization of the Pade approximant technique obtained by inner projections leads to approximate Green functions whose spectral densities satisfy a certain number of frequency moments. This approach contains decoupling schemes previously given and their explicit representation in terms of the moments.}
}

@article{Lindner71,
	author = {P. Lindner and O. Goscinski},
	title = {Generalized polarizabilities and energy expressions},
	journal = {International Journal of Quantum Chemistry},
	number = {no.4},
	pages = {251-5},
	location = {Sanibel Island, FL, USA},
	note = {From conference: 1970 international symposium on atomic, molecular, and solid-state theory and quantum biology, 19-24 Jan. 1970},
	year = {1971},
	keywords = {Polarisability; },
	language = {English},
	abstract = {That part of the total potential energy of a many-electron system which is expressible in terms of a generalized polarizability function is identified with the 'non-classical' part of the total energy, of crucial importance since it is proportional to the volume. A configuration-space derivation of a pair-function formula is presented.}
}

@article{Mujica84,
	author = {V. Mujica and O. Goscinski and E. Sangfelt},
	title = {Electron correlation in doubly excited states of helium and extensions to beryllium and magnesium},
	journal = {Chemical Physics},
	volume = {87},
	number = {3},
	pages = {473-84},
	month = {1 July 1984},
	year = {1984},
	keywords = {Atomic electron correlations; Atomic excited states; Beryllium; Helium atoms; Magnesium; Wave functions; Electron correlations; Doubly excited states; He; Hyperspherical coordinates; Two particles on a sphere; Dynamical group theory; Wavefunctions; Antisymmetrized geminal power; Separated pair approximation; Valence geminal; Be; Mg},
	language = {English},
	abstract = {Connections are established between the treatment of doubly excited states in He, using hyperspherical coordinates and the model of two particles on a sphere related to the use of dynamical group theory. The relevance of this for model wavefunctions of the type antisymmetrized geminal power (AGP) or separated pair approximation (SPA) is shown through the analysis and numerical applications of an effective equation for the valence geminal in Be and Mg.}
}

@article{Aberg84,
	author = {T. Aberg and A. Blomberg and J. Tulkki and O. Goscinski},
	title = {Maximum entropy theory of recoil charge distributions in electron-capture collisions},
	journal = {Physical Review Letters},
	volume = {52},
	number = {14},
	pages = {1207-10},
	month = {2 April 1984},
	year = {1984},
	keywords = {Atom-ion collisions; Electron capture; Inert gases; Ionisation of atoms; Multiphoton spectra; Photoionisation; Double-electron capture; Atom-ion collisions; Entropy theory; Recoil charge distributions; Electron-capture collisions; Generalized Fermi-Dirac distribution; Charge-state distributions; Rare-gas atoms; Multiple electron loss; Single-electron capture; Multiple ionization; Multiphoton absorption; Inner-shell vacancy formation; Triple-electron capture},
	language = {English},
	abstract = {A generalized Fermi-Dirac distribution is derived and applied to charge-state distributions in single collisions between multiply charged ions and rare-gas atoms. It relates multiple electron loss in single-electron capture to multiple ionization in multiphoton absorption and discloses inner-shell vacancy formation in double- and triple-electron capture.}
}

@article{Froelich84,
	author = {P. Froelich and O. Goscinski and U. Gelius and K. Helenelund},
	title = {Photon-induced post-collisional Auger decay. A two-potential complex coordinate formalism},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {17},
	number = {6},
	pages = {979-91},
	month = {28 March 1984},
	year = {1984},
	keywords = {Auger effect; Photon-induced; Post-collisional Auger decay processes; Excitation threshold; Gell-Mann-Goldberger two-potential formalism; Transition amplitudes; Two-potential formalism; Complex coordinate method; Final-state interactions; Scattering amplitude; Sudden impulse arguments},
	language = {English},
	abstract = {Photon-induced, post-collisional Auger decay processes are studied near to excitation threshold situation. The Gell-Mann-Goldberger two-potential formalism is applied for deriving the transition amplitudes which are shown to be dominated by the second-order terms. The combination of the two-potential formalism with the spectral analysis following from the complex coordinate method has been shown to be applicable in the treatment of the final-state interactions. Expressions for the scattering amplitude are derived without sudden impulse arguments. As the result of the complex coordinate treatment, the scattering amplitude distinctly separates into direct, background and resonant parts.}
}

@article{Mishra83,
	author = {M. Mishra and O. Goscinski and Y. Ohrn},
	title = {Application of the second order dilated electron propagator to the treatment of Auger and shape resonances of Be},
	journal = {Journal of Chemical Physics},
	volume = {79},
	number = {11},
	pages = {5505-11},
	month = {1 Dec. 1983},
	year = {1983},
	keywords = {Atomic spectral line breadth; Auger effect; Beryllium; SCF calculations; Bivariational SCF method; Second order dilated electron propagator; Electron resonances; N-electron target; Auger resonances; Be},
	language = {English},
	abstract = {The adequacy of the bi-variational SCF based second order dilated electron propagator in the treatment of (N+1) and (N-1) electron resonances through calculations on the N-electron target is examined by using it to study the /sup 2/P shape and (1s/sup -1/) Auger resonances of Be.}
}

@article{Mishra83a,
	author = {M. Mishra and O. Goscinski and Y. Ohrn},
	title = {Numerical study of the bi-variational SCF method as a zeroth order dilated electron propagator},
	journal = {Journal of Chemical Physics},
	volume = {79},
	number = {11},
	pages = {5494-504},
	month = {1 Dec. 1983},
	year = {1983},
	keywords = {Beryllium; Eigenvalues and eigenfunctions; Iterative methods; SCF calculations; Variational techniques; Eigenvalues; Bi-variational SCF method; Effective Hamiltonian; Resonance energies; Iterative solution; Dilated electron propagator equations; Be},
	language = {English},
	abstract = {Eigenvalues of a bi-variationally obtained effective Hamiltonian are studied as the poles of a zeroth order dilated electron propagator. Their role as the zeroth order estimate of resonance energies and widths in the iterative solution of the dilated electron propagator equations is stressed. Applications to the Be atom are presented.}
}

@article{Mishra83b,
	author = {M. Mishra and H.A. Kurtz and O. Goscinski and Y. Ohrn},
	title = {Treatment of resonances with the dilated electron propagator: the /sup 2/P shape resonance in e-Mg scattering},
	journal = {Journal of Chemical Physics},
	volume = {79},
	number = {4},
	pages = {1896-902},
	month = {15 Aug. 1983},
	year = {1983},
	keywords = {Atomic electron impact excitation; Atomic resonant states; Magnesium; SCF calculations; Mg; Electron scattering; Dilated electron propagator; /Sup 2/P shape resonance; Bivariational SCF; Second order self-energy},
	language = {English},
	abstract = {The dilated electron propagator technique based on an underlying bivariational SCF and a second order self-energy is applied to study the /sup 2/P shape resonance in e-Mg scattering. Basis set effects are studied and comparisons with the results from an alternative construction of the second order dilated electron propagator are made.}
}

@article{Elander83,
	author = {N. Elander and E. Sangfelt and H. Kurtz and O. Goscinski},
	title = {Application of AGP wave functions to the ground states of Li/sub 2/ and CH/sup +/},
	journal = {International Journal of Quantum Chemistry},
	volume = {23},
	number = {3},
	pages = {1047-56},
	location = {Uppsala, Sweden},
	note = {From conference: Proceedings of the Fourth International Congress in Quantum Chemistry, 13-20 June 1982},
	month = {March 1983},
	year = {1983},
	keywords = {Lithium; Organic compounds; Potential energy curves and surfaces of molecules; Wave functions; Antisymmetrised geminal power wave function; Ground states; Li/sub 2/; CH/sup +/; AGP wave function; Potential energy curves},
	language = {English},
	abstract = {The AGP wave function is used to describe the ground state potential energy curves of Li/sub 2/ and CH/sup +/. Moderate size basis sets are used. The computational aspects of the AGP optimization are discussed and the nature of the AGP wave function versus internuclear separation is examined.}
}

@article{Aberg82,
	author = {T. Aberg and O. Goscinski},
	title = {Information-theoretical description of heavy-ion-atom collisions},
	journal = {AIP Conference Proceedings},
	number = {no.94},
	pages = {121-32},
	location = {Eugene, OR, USA},
	note = {From conference: International Conference on X-Ray and Atomic Inner-Shell Physics, 'X-82', 23-27 Aug. 1982},
	year = {1982},
	keywords = {Atom-ion collisions; Auger effect; X-ray production; Heavy ion; Excitation processes; Minimum cross entropy principle; Electronic density matrices; Atomic structure; X-ray; Auger electron distributions},
	language = {English},
	abstract = {In the keV/u to meV/u range most experimental studies of inelasticity have provided limited resolution of the accessible final states. In this work the information content regarding excitation processes in such measurements has been analyzed from a stochastic point of view using the minimum cross entropy principle in the construction of electronic density matrices. The final nonstatistical distribution of the observed radiation or fragments is obtained by minimizing the cross entropy with respect to a prior distribution and subject to constraints imposed by the experimental arrangement and by the atomic structure of the projectile-target system. Application to equilibrium charge-state distributions is made. Observed asymmetries are related to a single energy-independent parameter characterizing the rate of charge formation. An information-theoretical interpretation of the frequently observed binomial KL/sup n/ X-ray and Auger electron distributions is given and contrasted with conventional derivations.}
}

@article{Goscinski82,
	author = {O. Goscinski},
	title = {Antisymmetrized geminal power (AGP) wave-functions in finite and extended systems},
	journal = {International Journal of Quantum Chemistry, Quantum Chemistry Symposia},
	number = {no.16},
	pages = {591-603},
	location = {Flagler Beach, FL, USA},
	note = {From conference: Proceedings of the International Symposium on Quantum Chemistry, Theory of Condensed Matter, and Propagator Methods in the Quantum Theory of Matter, 1-13 March 1982},
	year = {1982},
	keywords = {Atomic electron correlations; BCS theory; Molecular electron correlations; Wave functions; Atomic systems; Antisymmetrised geminal power wavefunctions; Extended systems; Electron-electron interaction; Bound electron pairs; Cooper pairs; BCS wave function; Finite systems; Molecular systems; Correlation effects; Internuclear distance; Natural-orbital occupation numbers},
	language = {English},
	abstract = {In extended systems, where the effective electron-electron interaction is attractive upon certain conditions, the formation of bound electron pairs has utmost importance. The Cooper pairs are, in turn, related to the geminal appearing in the BCS wave function in a simple way. For finite systems the relationship is not so apparent. An approximate one can be obtained, and used, for analyzing AGP wave functions for atomic and molecular systems. This allows for a detailed picture of the correlation effects involved, their basis-set dependence as well as of the variation with internuclear distance. The picture is more detailed than the one displayed by the natural-orbital occupation numbers and is a unique feature of AGP wave functions.}
}

@article{Weiner83,
	author = {B. Weiner and O. Goscinski},
	title = {Excitation operators associated with antisymmetrized geminal-power states},
	journal = {Physical Review A [General Physics]},
	volume = {27},
	number = {1},
	pages = {57-71},
	month = {Jan. 1983},
	year = {1983},
	keywords = {Quantum theory; Antisymmetrized geminal-power states; Degeneracy; Density matrix},
	language = {English},
	abstract = {Various expressions for antisymmetrized geminal-power (AGP) states are reviewed. With the use of a simple relationship for creation and annihilation operators of BCS (Bardeen, Cooper, and Schrieffer)-type states, such operators are characterized for AGP and GAGP (generalized AGP) schemes. The effect of degeneracy in the first-order reduced density matrix on these operators is displayed.}
}

@article{Goscinski68,
	author = {O. Goscinski and E. Branda},
	title = {Dispersion forces, second- and third-order energies},
	journal = {Chemical Physics Letters},
	volume = {2},
	number = {5},
	pages = {299-302},
	month = {Sept. 1968},
	year = {1968},
	keywords = {Atoms; Molecules; Quantum theory; },
	language = {English},
	abstract = {The properly symmetrized second order energy, epsilon /sub 2//sup Q/, has been observed to approach one half of the correct dispersion energy epsilon /sub 2/ for large interatomic distances. It is contended that the proper quantity to be examined is epsilon /sub 2//sup Q/ lambda /sup Q/. lambda /sup Q/ approaches epsilon /sub 2//sup Q//( epsilon /sub 2//sup Q/- epsilon /sub 3//sup Q/) approximately=2 at R=8a/sub O/ for H/sub 2/ and E/sub 2//sup Q// epsilon /sub 3//sup Q/ approximately=2. Hence E/sub O/+ epsilon /sub 1//sup Q/+ epsilon /sub 2//sup Q/ is a bad approximation.}
}

@article{Goscinski82a,
	author = {O. Goscinski and B. Weiner and N. Elander},
	title = {Oscillator strength anomalies as described by the AGP model},
	journal = {Journal of Chemical Physics},
	volume = {77},
	number = {5},
	pages = {2445-7},
	month = {1 Sept. 1982},
	year = {1982},
	keywords = {Oscillator strengths; Transition moments; Oscillator strength anomalies; Antisymmetrized geminal power wave function; Excited states; Transition moments; Geminal expansion coefficients},
	language = {English},
	abstract = {The antisymmetrized geminal power wave function (AGP) used together with excited states generated by operators satisfying the vacuum condition leads to simple forms for the transition moments. The variation and possible vanishing of the transition moments can be expressed exclusively in terms of the geminal expansion coefficients.}
}

@article{Goscinski82b,
	author = {O. Goscinski and T. Aberg and M. Peltonen},
	title = {Information-theoretical description of charge-state distributions in heavy ion-atom collisions},
	journal = {Physics Letters A},
	volume = {90A},
	number = {9},
	pages = {464-6},
	month = {9 Aug. 1982},
	year = {1982},
	keywords = {Atom-ion collisions; Bromine; Chlorine; Iodine; Cl; Br; I; Universal equations; Charge-state distributions; Heavy ion-atom collisions; Maximum-entropy principle; Single energy-independent parameter; Rate of charge formation; Asymmetries},
	language = {English},
	abstract = {Universal equations for asymmetric equilibrium charge-state distributions are derived using the maximum-entropy principle. They are tested on chlorine, bromine, and iodine projectiles in several gases at various incident energies. A single energy-independent parameter relates the rate of charge formation to the observed asymmetries.}
}

@article{Bendazzoli70,
	author = {G.L. Bendazzoli and O. Goscinski and G. Orlandi},
	title = {Pade approximants and inner projections in the Brillouin-Wigner perturbation scheme for He-like ions},
	journal = {Physical Review A [General Physics]},
	volume = {2},
	number = {1},
	pages = {2-7},
	month = {July 1970},
	year = {1970},
	keywords = {Atomic structure; Helium; Ions; },
	language = {English},
	abstract = {The continued-fraction expansions in terms of Brillouin-Wigner perturbation energies are evaluated for the He-like series. They show remarkable convergence and stability properties. Both Pade approximants and perturbation energies are computed with formulas derived by the inner-projection technique.}
}

@article{Kurtz81,
	author = {H.A. Kurtz and N. Elander and O. Goscinski and E. Sangfelt},
	title = {On the energy optimization of the AGP wavefunction. The ground state of the Be atom},
	journal = {International Journal of Quantum Chemistry, Quantum Chemistry Symposia},
	number = {no.15},
	pages = {143-9},
	location = {Flagler Beach, FL, USA},
	note = {From conference: Proceedings of the International Symposium on Atomic, Molecular, and Solid-State Theory, Collision Phenomena, and Computational Quantum Chemistry, 8-14 March 1981},
	year = {1981},
	keywords = {Atomic structure; Beryllium; Antisymmetrised geminal power function; Energy optimization; Be atom; Optimal AGP states; AGP function},
	language = {English},
	abstract = {The theory of the antisymmetrized geminal power (AGP) function is briefly discussed and a procedure is developed for obtaining optimal AGP states. This procedure is then applied to the /sup 1/S ground state of beryllium and the nature of the AGP function is examined. The quality of the AGP function is found to be considerably better than previously estimated.}
}

@article{Sangfelt81,
	author = {E. Sangfelt and O. Goscinski and N. Elander and H. Kurtz},
	title = {An analysis of the AGP and projected AGP wavefunctions},
	journal = {International Journal of Quantum Chemistry, Quantum Chemistry Symposia},
	number = {no.15},
	pages = {133-41},
	location = {Flagler Beach, FL, USA},
	note = {From conference: Proceedings of the International Symposium on Atomic, Molecular, and Solid-State Theory, Collision Phenomena, and Computational Quantum Chemistry, 8-14 March 1981},
	year = {1981},
	keywords = {Molecular energy level calculations; Quantum theory; First order reduced density matrices; Second-order reduced density matrices; Occupation numbers},
	language = {English},
	abstract = {A discussion is given on some of the properties of the first- and second-order reduced density matrices and their occupation numbers for antisymmetrized geminal power (AGP) wavefunctions. Improvements on this type of functions are discussed in terms of a project AGP.}
}

@article{Weiner82,
	author = {B. Weiner and O. Goscinski},
	title = {Superoperator approach to propagator approximations},
	journal = {International Journal of Quantum Chemistry},
	volume = {21},
	number = {2},
	pages = {369-98},
	month = {Feb. 1982},
	year = {1982},
	keywords = {Perturbation theory; Quantum theory; Propagator approximations; Matrix propagators; Equation of motion; Particle-hole propagator; Self-consistent approximations},
	language = {English},
	abstract = {The superoperator formalism for matrix propagators is reviewed, with special attention to the validity of superoperator resolution of the identity. The equation of motion for the particle-hole propagator is discussed. Decoupling procedures based on inner projections and partitioning are examined showing the desirability to self-consistent approximations. The conditions under which a state can be a vacuum for a given linear manifold of operators are analyzed.}
}

@article{Goscinski82c,
	author = {O. Goscinski and B. Weiner},
	title = {Excitation spectrum associated with a generalized antisymmetrized geminal power ground state},
	journal = {Physical Review A [General Physics]},
	volume = {25},
	number = {2},
	pages = {650-7},
	month = {Feb. 1982},
	year = {1982},
	keywords = {Atomic spectra; Atomic structure; Molecular electronic states; Molecular spectra; Generalized antisymmetrized geminal power ground state; Polarization-propagator approximations; Hartree-Fock-random-phase-approximation; F-sum rule; Oscillator-strength},
	language = {English},
	abstract = {Self-consistent polarization-propagator approximations (i.e. those based on a proper vacuum) are compared with conventional time-dependent Hartree-Fock-random-phase-approximation ones, with special attention to the fulfilment of the f-sum rule. The effect on the properties of the consistent propagator, based on a general-antisymmetrized-geminal-power vacuum, when degeneracies occurring in the first-order reduced-density matrix of this vacuum are examined. The foregoing analysis shows that low-lying electronic states can be expected to become degenerate with the vacuum in conjunction with superphenomena in extended systems and oscillator-strength anomalies in finite ones.}
}

@article{Sangfelt81a,
	author = {E. Sangfelt and O. Goscinski and J.-L. Calais},
	title = {Electronegativities and transition densities in the theory of metal-semiconductor interfaces},
	journal = {Physica Scripta},
	volume = {24},
	number = {2},
	pages = {461-4},
	month = {Aug. 1981},
	year = {1981},
	keywords = {Chemical shift; Electronegativity; Schottky effect; Semiconductor-metal boundaries; Transition densities; Metal-semiconductor interfaces; Electronegativity; Band bending potentials; Schottky barriers; ESCA chemical shifts; Semiconductor sites; Transition charge densities; Local density of states},
	language = {English},
	abstract = {A heuristic derivation of the relationship between electronegativity differences, band bending potentials and Schottky barriers is given as well as a formula relating shifts in Schottky barriers (for fixed semi-conductor and for various metals) with ESCA chemical shifts or semiconductor sites at the interface. These are further related to transition charge densities and local density of states (for pseudo system including both initial and final states).}
}

@article{Aberg81,
	author = {T. Aberg and O. Goscinski},
	title = {Information-theoretical interpretation of level populations and charge distribution in beam-foil spectroscopy},
	journal = {Physical Review A [General Physics]},
	volume = {24},
	number = {2},
	pages = {801-11},
	month = {Aug. 1981},
	year = {1981},
	keywords = {Beam-foil spectroscopy; Level populations; Charge distribution; Beam-foil spectroscopy; Maximum entropy principle; Time-resolved intensity; Electromagnetic radiation; Multiplet population density matrix; Foil excitation mechanisms; Rydberg series; Level population functions; Factorized representation; He/sup +/ ions; Surprisal analysis; Information theory; Randomly excited emerging ions},
	language = {English},
	abstract = {The consequences of the assumption that, under prescribed experimental conditions, the ions emerge randomly excited from the foil are examined using the maximum entropy principle. For that purpose constraints are identified by examining the time-resolved intensity of the electromagnetic radiation emitted by the ions after the foil. This leads to the most likely level or multiplet population density matrix compatible with the experimental information. The main consequences of the foil excitation mechanisms are accounted for by incorporating the framework of atomic structure into the authors' information-theoretical approach. In the case of transitions in individual Rydberg series it is shown that for large n and a given l the level population functions decrease as n/sup *-3/ and depend universally on the kinetic energy of the incoming beam. It is also shown that the identification of the radiation from the emerging ions in terms of one-electron states leads, according to the maximum entropy principle, to a unique factorized representation of the probability that an ion has a given configuration immediately after the foil. This representation is used for a derivation of the charge distribution which for heavy ions is shown to be approximately Gaussian or chi-squared in accordance with experiments. The passage of He/sup +/ ions through the foil is treated as an example of a consistency test based on the information-theoretical derivation of the charge distribution. Following Levine and coworkers (1977, 1979) a surprisal analysis of level population functions is suggested as a well-established alternative to detailed models of foil excitation which usually invoke perturbation theory and consequently often have an ill-defined range of validity.}
}

@article{Berrondo81,
	author = {M. Berrondo and O. Goscinski},
	title = {The Coulomb hole and the correlation energy for the electron gas at intermediate densities},
	journal = {Chemical Physics Letters},
	volume = {81},
	number = {1},
	pages = {75-8},
	month = {1 July 1981},
	year = {1981},
	keywords = {Electron gas; Correlation energy; Intermediate densities; Electron gas; Coulomb hole},
	language = {English},
	abstract = {An approximation for the correlation energy of the electron gas is derived (employing a direct modelling of the Coulomb hole) for the pair distribution function: epsilon /sub c/(r/sub s/)=-0.303/(r/sub s/+1.108) Rydberg. It is of the same form as the expressions of Wigner (1934) and of McWeeny (1976).}
}

@article{Canuto81,
	author = {S. Canuto and J.-L. Calais and O. Goscinski},
	title = {Alternating polarity and Friedel oscillations},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {14},
	number = {9},
	pages = {1409-22},
	month = {14 May 1981},
	year = {1981},
	keywords = {Reaction kinetics theory; Friedel oscillations; Alternating polarity; Organic chemical reactions; Metallic alloys; Localised perturbation},
	language = {English},
	abstract = {A discussion of the law of alternating polarity originating in organic chemical reactions and the Friedel (1952) oscillations in metallic alloys is made. These are manifestations of the response of the system to a localised perturbation, leading to an oscillation period related to the density and not to atomic positions.}
}

@article{Weiner80,
	author = {B. Weiner and O. Goscinski},
	title = {Calculation of optimal generalized antisymmetrized geminal-power (projected-Bardeen-Cooper-Schrieffer) functions and their associated excitation spectrum},
	journal = {Physical Review A [General Physics]},
	volume = {22},
	number = {6},
	pages = {2374-91},
	month = {Dec. 1980},
	year = {1980},
	keywords = {Atomic spectra; Molecular energy level calculations; Molecular spectra; Excitation spectrum; Reduced density matrices; Unitary transformations; Stability properties; Self consistent one particle hole propagator; Optimal generalised antisymmetrised geminal power; Molecular energy level calculations},
	language = {English},
	abstract = {The generalized antisymmetrized geminal-power (GAGP) function, shown to be the ground state for the one-particle-hole propagator, can be computed using the rather simple properties of its reduced density matrices and the properties of unitary transformations. The practical procedure involves limited storage notwithstanding the rather large number of configurations with which the GAGP function can be associated. Using the stability properties previously derived for this function, the authors construct the self-consistent one-particle-hole propagator.}
}

@article{Weiner80a,
	author = {B. Weiner and O. Goscinski},
	title = {Self-consistent approximation to the polarization propagator},
	journal = {International Journal of Quantum Chemistry},
	volume = {18},
	number = {4},
	pages = {1109-31},
	month = {Oct. 1980},
	year = {1980},
	keywords = {Atomic structure; Molecular energy level calculations; Polarization propagator; Approximate states; Truncated operator manifolds; Hermiticity; Stationarity; Nonredundance; Operator manifolds; Model time evolution; Vacuum condition; Algorithms; Self consistent approximation},
	language = {English},
	abstract = {A theorem is presented that characterizes approximate states and truncated operator manifolds associated with self-consistent approximate propagators. This theorem establishes a natural relationship between Hermiticity, stationarity, nonredundance and completeness of operator manifolds, model time evolution, and the vacuum condition. For the case of the polarization propagator the authors describe algorithms by which they can construct states and manifolds that satisfy this theorem and the vacuum condition.}
}

@article{Palma80,
	author = {A. Palma and E. Gonzalez and O. Goscinski},
	title = {ESCA peak intensities for small molecules in the sudden approximation},
	journal = {International Journal of Quantum Chemistry},
	volume = {18},
	number = {1},
	pages = {237-41},
	location = {Kyoto, Japan},
	note = {From conference: Proceedings of the Third International Congress of Quantum Chemistry, 29 Oct.-3 Nov. 1979},
	month = {July 1980},
	year = {1980},
	keywords = {Carbon compounds; Organic compounds; Radiative lifetimes; Water; X-ray photoelectron spectra; Sudden approximation; Transition probability; Core hole ionization; CO; ESCA spectra; Water; Methane; H/sub 2/O},
	language = {English},
	abstract = {A simple transition probability formula is applied to the core hole ionization in CO, satisfactorily predicting the ratio between the intensity of the two inner-shell peaks. The formula is also applied to the full ESCA spectra of water and methane; the theoretical results agree reasonably well with the experiment.}
}

@article{Calles79,
	author = {A. Calles and O. Goscinski},
	title = {The use of Green functions for the calculation of dynamic Jahn-Teller effect in electron spin resonance spectra},
	journal = {Revista Mexicana de Fisica},
	volume = {26},
	number = {1},
	pages = {23-32},
	year = {1979},
	keywords = {EPR line breadth; Green's function methods; Jahn-Teller effect; Paramagnetic resonance of ions and impurities; Green functions; Electron spin resonance spectra; Paramagnetic ion; Vibrating octahedron field; Geometric approximation; Line shape; Dynamic Jahn Teller effect},
	language = {English},
	abstract = {With the use of the Green function techniques at finite temperature the electron spin resonance spectra is calculated in a system that presents a dynamic Jahn-Teller effect. The system is a paramagnetic ion with total spin 1 situated in the site of a vibrating octahedron field. The state of the ion transforms as the T/sub 1g/ of O/sub n/ and is coupled to the epsilon /sub g/ and tau /sub 2g/ vibrational modes. The problem is used as an example when a simple linearisation cannot be used to decouple the Green function. The geometric approximation, however, can be used giving appropriate results for the line shape.}
}

@article{Muller80,
	author = {J. Muller and E. Poulain and O. Goscinski and L. Karlsson},
	title = {Role of symmetry restrictions on valence electron binding energies of CF/sub 4/},
	journal = {Journal of Chemical Physics},
	volume = {72},
	number = {4},
	pages = {2587-90},
	month = {15 Feb. 1980},
	year = {1980},
	keywords = {Binding energy; HF calculations; LCAO calculations; Molecular electronic states; Organic compounds; Symmetry restrictions; Valence electron binding energies; CF/sub 4/; Ionized states; Molecular symmetry restrictions; Hole state energies; Core holes; Excited levels; Inner valence levels; Hartree Fock formalism; Ab initio LCAO MO calculations},
	language = {English},
	abstract = {Ab initio LCAO MO calculations within the Hartree-Fock formalism have been carried out on all ionized states of CF/sub 4/ and the effects of molecular symmetry restrictions on computed hole state energies are closely examined. It is emphasized that localization, which ordinarily affects core holes, is also of importance for describing inner valence and excited levels with both Hartree-Fock and correlated calculations.}
}

@article{Goscinski80,
	author = {O. Goscinski and B. Weiner},
	title = {The role of algebraic formulations of approximate Green's functions for systems with a finite number of electrons},
	journal = {Physica Scripta},
	volume = {21},
	number = {3-4},
	pages = {385-93},
	location = {Gothenburg, Sweden},
	note = {From conference: Many-body Theory of Atomic Systems. Proceedings of the Nobel Symposium 46, 11-16 June 1979},
	year = {1980},
	keywords = {Algebra; Green's function methods; Orbital calculation methods; Algebraic formulation; Approximate Green's functions; Computation; Antisymmetrized geminal power; Hermiticity; Completeness; Stationarity; Killer condition; Finite electron number system; Self consistent polarisation propagator; Excited states manifold generation; Operator manifold nonredundance},
	language = {English},
	abstract = {Some of the difficulties encountered in the approximation of Green's functions are reviewed with particular emphasis on the self-consistent polarization propagator. Some new basic theorems are presented, involving a general procedure, which lead to both a derivation and alternate prescriptions for the computations. As demonstrated by Linderberg and Ohrn (1977) the ground state is an AGP (antisymmetrized geminal power). An energy optimized AGP (E/sub AGP/) in a Brueckner orbital representation can be used to generate a manifold of excited states mod K>=O/sub K//sup +/ mod AGP>, O/sub K/ mod AGP>=0 with the excitation operators, O/sub K//sup +/, and killers, O/sub K/, being combinations of particle-hole and hole-particle operators. The authors' results establish a natural relationship between hermiticity, completeness, non-redundance of operator manifolds with stationarity and Killer conditions.}
}

@article{Kelfve80,
	author = {P. Kelfve and B. Blomster and H. Siegbahn and K. Siegbahn and E. Sanhueza and O. Goscinski},
	title = {Chemical shifts of Auger electron lines and electron binding energies in free molecules. Silicon compounds},
	journal = {Physica Scripta},
	volume = {21},
	number = {1},
	pages = {75-88},
	year = {1980},
	keywords = {Auger effect; Binding energy; Chemical shift; CNDO calculations; HMO calculations; Organic compounds; Silicon compounds; Auger electron lines; Electron binding energies; Free molecules; Gas phase; Group shift model; Chemical shifts; Transition potential model; Holes; CNDO/2; EWMO; Modified iterative extended Huckel method; Valence charge densities; Core ionization; Semi empirical calculation; Organic Si compounds},
	language = {English},
	abstract = {The silicon KL/sub 2,3/L/sub 2,3/(/sup 1/D/sub 2/) Auger energies and the silicon 2p/sub 3/2/ binding energies have been measured for more than twenty organic silicon compounds in the gas phase. The group shift model has been applied to the Auger energy data as well as the binding energy data. Approximate proportionality between these two types of chemical shifts was found for some sub-series of the type SiR/sub 4-n/T/sub n/. The transition potential model for the transition from one to two holes in the silicon core has been developed to take into account the difference between the 1s and 2p binding energy shifts. Semi-empirical calculations have been performed for most of the compounds, CNDO/2 and EWMO (a modified iterative extended Huckel method. It was found that EWMO provides a more satisfactory description of the valence charge densities and their changes upon core ionization than does CNDO/2. The correlation with the experimental data was also found to be better applying the transition potential models to the EWMO calculated charges than to the CNDO/2 charges.}
}

@article{Canuto79,
	author = {S. Canuto and O. Goscinski and M. Zerner},
	title = {Broken orbital symmetry study of low-lying excited and N/sub 1s/ ionized states of pyrazine},
	journal = {Chemical Physics Letters},
	volume = {68},
	number = {1},
	pages = {232-6},
	month = {1 Dec. 1979},
	year = {1979},
	keywords = {Ab initio calculations; Molecular fluorescence; Molecular orbitals calculations; Nonradiative transitions; Organic compounds; Organic molecule configurations; Phosphorescence; SCF calculations; N/sub 1s/; Ionized states; Pyrazine; C/sub 2v/ symmetry; Molecular orbitals; Broken orbital symmetry; Emission properties; Ab initio calculation; SCF calculations; N-pi* transitions; Pi-pi* transitions; D/sub 2h/ symmetry; Fluorescence; Phosphorescence},
	language = {English},
	abstract = {Ab initio Delta E/sub SCF/ calculations of the low-lying n- pi * and pi -n* transitions in pyrazine are reported with D/sub 2h/ and C/sub 2v/ symmetry adapted molecular orbitals. The use of broken orbital symmetry is essential for interpreting the emission properties of pyrazine at the computational level used. The energy of the N/sub 1s/ orbital is calculated using these two symmetry constraints with the C/sub 2v/ orbitals again leading to results in better agreement with experiment.}
}

@article{Canuto79a,
	author = {S. Canuto and O. Goscinski},
	title = {Continuum contribution to polarizabilities and scaling},
	journal = {International Journal of Quantum Chemistry},
	volume = {16},
	number = {5},
	pages = {985-91},
	month = {Nov. 1979},
	year = {1979},
	keywords = {Atomic excited states; Atomic polarisability; Atomic spectra; Oscillator strengths; Polarizabilities; Scaling; Continuum; Polarizabilities; Negative moments; Oscillator strength; Eigenfunction expansion; Wave function; Ground state; Excited states},
	language = {English},
	abstract = {The role of the continuum so important in ground-state properties, is known to be less important and may even be negligible in the computation of polarizabilities and other higher negative moments of the oscillator strength distribution. This can be rationalized in terms of the solutions of the inhomogeneous equation generating the moments as an alternative to the dominating first term in an eigenfunction expansion. This leads in a natural form to the approximation F phi /sub 0/(1+w(r)) for the perturbed wave function where 1+w(r) represents a nonuniform scaling of the unperturbed function phi /sub 0/.}
}

@article{Goscinski70a,
	author = {O. Goscinski and P. Lindner},
	title = {Natural spin-orbitals and generalized overlap amplitudes},
	journal = {Journal of Mathematical Physics},
	volume = {11},
	number = {4},
	pages = {1313-17},
	month = {April 1970},
	year = {1970},
	keywords = {Atomic structure; Green's function methods; Orbital calculation methods; },
	language = {English},
	abstract = {The generalized overlap amplitudes for 'hole' states which appear in the one-particle Green's function are, in general, not linearly independent. The authors show that canonical orthonormalization of them yields the natural spin-orbitals (eigenfunctions of the first-order reduced density matrix.).}
}

@article{Muller79,
	author = {J. Muller and H. Agren and O. Goscinski},
	title = {Role of localization in the prediction of core ESCA lineshapes on N/sub 2/, O/sub 2/ and NO},
	journal = {Chemical Physics},
	volume = {38},
	number = {3},
	pages = {349-59},
	month = {1 May 1979},
	year = {1979},
	keywords = {Ab initio calculations; HF calculations; Molecular spectral line breadth; Nitrogen; Oxygen; Potential energy curves and surfaces of molecules; X-ray photoelectron spectra; Core ESCA lineshape; NO; Ab initio calculations; Electronic energy surfaces; Core hole photoionization; Photoelectron spectra; X-ray photoelectron spectra; N/sub 2/; O/sub 2/; Spectral line shape; Hartree Fock calculation},
	language = {English},
	abstract = {Hartree-Fock ab initio calculations have been performed on electronic energy surfaces of the ground and the core hole state species in order to investigate vibrational structure of their high resolution ESCA spectra. The importance of relaxation effects in predicting geometry changes following core hole photoionization is known and was verified here. As a new feature the influence of relaxation on lineshapes is studied. Both the conventional Franck-Condon analysis and a method for calculating linewidths of photoelectron spectra from the gradient of the hole state energy curve are employed. Two major conclusions are made: (i) agreement with experiment using the Hartree-Fock scheme can be obtained only if the core holes are treated localized; (ii) the vibrational effects for the two multiplet split components in the paramagnetic core hole ions NO/sup +/ and O/sub 2//sup +/ are different, and these effects are reflected in the ESCA linewidths.}
}

@article{Goscinski79,
	author = {O. Goscinski and A. Palma},
	title = {Electron and nuclear density matrices and the separation of electronic and nuclear motion},
	journal = {International Journal of Quantum Chemistry},
	volume = {15},
	number = {2},
	pages = {197-205},
	month = {Feb. 1979},
	year = {1979},
	keywords = {Ionisation of molecules; Molecular orbitals calculations; Photoionisation; Wave functions; Nuclear density matrices; Parametric dependency; Nonparametric dependency; Reduced density matrices; Electron density matrix; Optical excitation; Photoionisation; Nuclear electronic motions separation; Born Oppenheimer approximation},
	language = {English},
	abstract = {The so-called parametric dependency of the electronic wave function in the Born-Oppenheimer approximation is discussed. Considering a function beyond this approximation, a new set of equations is derived with parametric and nonparametric dependency. Nuclear and electron reduced density matrices are introduced in this derivation. They are used in a formulation of the problem of separation of nuclear and electronic motion.}
}

@article{Palma79,
	author = {A. Palma and O. Goscinski},
	title = {ESCA peak intensities in water in the sudden approximation},
	journal = {Chemical Physics Letters},
	volume = {63},
	number = {1},
	pages = {72-6},
	month = {1 May 1979},
	year = {1979},
	keywords = {Photoelectron spectra; Water; ESCA peak intensities; Sudden approximation; Transition probability; Transition operator technique; Relaxation energy; Molecule; H/sub 2/O; Photoelectron spectra; 10 To 40 eV; ESCA spectra},
	language = {English},
	abstract = {A derivation of the transition probability formula within the scheme of the sudden approximation and the transition operator technique is given. The relationship between relaxation energy and transition probabilities with the norms of generalized overlap amplitudes is discussed. Applications to ESCA peak intensities in the water molecule is made.}
}

@article{Lozes79,
	author = {R.L. Lozes and O. Goscinski and U.I. Wahlgren},
	title = {Core hole localization in N/sub 2//sup +/},
	journal = {Chemical Physics Letters},
	volume = {63},
	number = {1},
	pages = {77-81},
	month = {1 May 1979},
	year = {1979},
	keywords = {Molecular orbitals calculations; Nitrogen; N/sub 2//sup +/; Hole state; Diatom; N/sub 2/; Core hole localisation; Molecular orbital; Molecule},
	language = {English},
	abstract = {The question of localized treatments of hole states of diatomics is considered. The effective interaction between localization sites is discussed in relation to system parameters such as internuclear distance. Computations are performed on those states of N/sub 2//sup +/ involving holes in the molecular orbitals arising from the 1s and 2s.}
}

@article{Brandas70,
	author = {E. Brandas and O. Goscinski},
	title = {Variation-perturbation expansions and Pade approximants to the energy},
	journal = {Physical Review A [General Physics]},
	volume = {1},
	number = {3},
	pages = {552-60},
	month = {March 1970},
	year = {1970},
	keywords = {Quantum theory applications; Wave equations; },
	language = {English},
	abstract = {The variational solutions to the Rayleigh-Schrodinger inhomogeneous equations are derived by simple matrix algebra. It is shown how the approximate perturbation energies and wave functions obtained in this way obey the same type of equations as the exact ones. This permits for formulation of a variation-iteration theory convenient for numerical applications. Results for the He-like ions show that the conventional linear series is less suitable than the present method in obtaining accurate energies. The use of inner projection techniques leads to an efficient calculation of Pade approximants to the energy series, which show remarkable convergence properties.}
}

@article{Palma79a,
	author = {A. Palma and E. Poulain and O. Goscinski and U. Wahlgren},
	title = {Vibrational structure in inner-shell ionization of CO calculated with the sudden approximation},
	journal = {Chemical Physics Letters},
	volume = {62},
	number = {2},
	pages = {368-73},
	month = {1 April 1979},
	year = {1979},
	keywords = {Bond lengths; Carbon compounds; Electron spectra; Franck-Condon factors; Ionisation of molecules; Molecular force constants; Molecular vibration; Potential energy curves and surfaces of molecules; Sudden approximation; ESCA spectrum; Force constants; Bond length; Transition operator; Vibrational structure; Inner shell ionisation; Potential energy curves; Franck Condon factors},
	language = {English},
	abstract = {The vibrational structure of the inner-shell ionization ESCA spectrum of CO is studied. Potential energy curves, force constants Franck-Condon factors and bond length changes are calculated. Results are discussed within the framework of the transition operator and sudden approximation formalisms.}
}

@article{Berrondo79,
	author = {M. Berrondo and J.P. Daudey and O. Goscinski},
	title = {Effective one-body Hamiltonian for electrons in atoms},
	journal = {Chemical Physics Letters},
	volume = {62},
	number = {1},
	pages = {34-7},
	month = {15 March 1979},
	year = {1979},
	keywords = {Atomic excited states; Atomic structure; Helium atoms; Atoms; Asymptotic behaviour; Electron density; Ground state; First excited state; He; Effective one-body Hamiltonian; Exchange potential local approximation},
	language = {English},
	abstract = {An effective one-body potential with correct asymptotic behaviour is derived from a simplified functional form of the electron density. The exchange part of this potential is obtained from a local approximation. Preliminary results are presented for the ground state and first excited state of He.}
}

@article{Berrondo79a,
	author = {M. Berrondo and O. Goscinski},
	title = {Local exchange potential for atomic systems},
	journal = {Chemical Physics Letters},
	volume = {62},
	number = {1},
	pages = {31-3},
	month = {15 March 1979},
	year = {1979},
	keywords = {Atomic structure; Atomic systems; Approximate local potential; Density matrix; Nuclear attraction; Idempotency condition; Asymptotic behaviour; Local exchange potential},
	language = {English},
	abstract = {An approximate local potential for the exchange term is found for atomic systems. A functional form for the density matrix as a real exponential is assumed, in order to account for the nuclear attraction. The potential is obtained as the functional derivative of the exchange energy, imposing the idempotency condition on the density matrix. The resulting local potential has the correct asymptotic behaviour without the need of ad-hoc cut-off procedures, or additional assumptions.}
}

@article{Goscinski70b,
	author = {O. Goscinski and P. Lindner},
	title = {Asymptotic properties of atomic form factors and incoherent scattering functions},
	journal = {Journal of Chemical Physics},
	volume = {52},
	number = {5},
	pages = {2539-40},
	month = {1 March 1970},
	year = {1970},
	keywords = {Atomic electron scattering; Atomic structure; },
	language = {English},
	abstract = {By use of the cusp condition for electronic wavefunctions the exact asymptotic behaviour of the atomic form factor is determined. The relation between the pair distribution function and the incoherent scattering function for large wave vector is pointed out.}
}

@article{Canuto78,
	author = {S. Canuto and O. Goscinski},
	title = {Stationarity of resonant pole trajectories in complex scaling},
	journal = {International Journal of Quantum Chemistry},
	volume = {14},
	number = {4},
	pages = {383-91},
	month = {Oct. 1978},
	year = {1978},
	keywords = {Atomic resonant states; Hydrogen neutral atoms; Scaling phenomena; Schrodinger equation; Stark effect; Resonant pole trajectories; Reciprocity theorem; Complex scaling transformation; Resonant states; Virial theorem; Stationarity; Pole trajectory; Stark broadening; H atom; Rayleigh Schrodinger perturbation theory},
	language = {English},
	abstract = {A reciprocity theorem relating the real parameters eta and alpha that define the complex scaling transformation r to eta re/sup i alpha / in the theory of complex scaling for resonant states is demonstrated. The virial theorem is used in connection with the stationarity of the pole trajectory. The Stark broadening in the hydrogen atom using a basis set generated by Rayleigh-Schrodinger perturbation theory is treated as an example.}
}

@article{Howat77,
	author = {G. Howat and M. Trsic and O. Goscinski},
	title = {Differential scaling of sigma and pi orbitals, and the geometric approximation for molecular polarizabilities},
	journal = {International Journal of Quantum Chemistry},
	volume = {12},
	number = {5},
	pages = {963-5},
	month = {Nov. 1977},
	year = {1977},
	keywords = {Molecular orbitals calculations; Molecular polarisability; Pi orbitals; Geometric approximation; Molecular orbitals; Sigma orbitals; Molecular polarisability},
	language = {English},
	abstract = {In a recent article concerning the calculation of molecular polarizabilities Howat et al. (1977) steps towards the generalisation of the geometric approximation were indicated although no numerical studies were presented. To complement the previous investigation, some polarizability calculations are now reported which employ one such generalisation.}
}

@article{Goscinski78,
	author = {O. Goscinski and J. Muller and E. Poulain and H. Siegbahn},
	title = {Fluorine core ESCA linewidths in CH/sub 3/F and CF/sub 4/},
	journal = {Chemical Physics Letters},
	volume = {55},
	number = {3},
	pages = {407-12},
	month = {1 May 1978},
	year = {1978},
	keywords = {Ab initio calculations; HF calculations; Molecular spectral line breadth; Organic compounds; X-ray photoelectron spectra; ESCA linewidths; Potential energy surfaces; F/sub 1S/ hole states; ESCA spectra; Koopmans' energies; Tetrafluoromethane; Monofluoromethane; Hartree Fock formalism; Relaxation energy; Ground state; X-ray photoelectron spectra},
	language = {English},
	abstract = {Ab initio calculations within the Hartree-Fock formalism have been carried out on potential energy surfaces of the ground and the F/sub 1S/ hole states of CH/sub 3/F and CF/sub 4/ in order to investigate linewidths of their ESCA spectra. The calculations show that potential energy surfaces of both hole states have dissociative character and can be approximated by straight lines in the region of interest. A simple formula for the ESCA fwhm linewidth is derived which yields results in good agreement with experiment. Theoretically derived relaxation and Koopmans' energies have been investigated as a function of geometry.}
}

@article{Howat78,
	author = {G. Howat and T. Aberg and O. Goscinski},
	title = {Relaxation and final-state channel mixing in the Auger effect},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {11},
	number = {9},
	pages = {1575-88},
	month = {14 May 1978},
	year = {1978},
	keywords = {Auger effect; Neon; Auger effect; Relaxation; KLL Auger rates; LS coupling; Continuum orbital; Doubly ionised residual ion; Full exchange; Slater integrals; Ne; Final state channel mixing; Bound state orbitals; SCF method; Orbital relaxation},
	language = {English},
	abstract = {The conventional theory of the Auger effect, based on Wentzel's ansatz (1927), is generalised to incorporate relaxation and final-state channel mixing. An application to neon KLL Auger rates in LS coupling is made. The bound-state orbitals are generated by alternative self-consistent-field methods and the continuum orbital is solved in the field of the doubly ionised residual ion including full exchange. In accordance with Kelly's many-body-perturbation-theory calculation (1975), it is found that the mixing between the final /sup 2/S channels affects the various partial rates by 10 to 40%. The effect of the non-orthogonal overlap elements is found to be of importance for the KL/sub 1/L/sub 1//sup 1/S and KL/sub 1/L/sub 2,3//sup 3/P transitions. Since the Slater integrals involved are shown to be sensitive to the relevant orbitals, the importance of incorporating correlation effects in a systematic fashion is stressed.}
}

@article{Howat77a,
	author = {G. Howat and M. Trsic and O. Goscinski},
	title = {Geometric approximation for molecular polarizabilities},
	journal = {International Journal of Quantum Chemistry},
	volume = {11},
	number = {2},
	pages = {283-92},
	month = {Feb. 1977},
	year = {1977},
	keywords = {CNDO calculations; Molecular polarisability; Perturbation theory; Finite field calculations; Anisotropies; Small molecules; Pi contributions; CNDO scheme; Planar conjugated systems; Geometric approximation; Molecular polarisability; Sigma contributions},
	language = {English},
	abstract = {Molecular polarizabilities calculated with the geometric approximation are shown to be independent of the type of perturbation theory used. Agreement with finite field calculations, including anisotropies, is obtained for small molecules. A modified procedure for including sigma and pi contributions in a differentiated way is developed within the CNDO scheme. Applications to planar conjugated systems are displayed.}
}

@article{Goscinski77,
	author = {O. Goscinski and H. Siegbahn},
	title = {Equivalent cores and transition potentials for ESCA shifts and Auger electron spectra},
	journal = {Chemical Physics Letters},
	volume = {48},
	number = {3},
	pages = {568-70},
	month = {15 June 1977},
	year = {1977},
	keywords = {Auger effect; Binding energy; Electron spectra; Spectral line shift; Transition potentials; ESCA shifts; Auger electron spectra; Equivalent cores; Hellmann Feynman theorem},
	language = {English},
	abstract = {A simple derivation of transition potentials, based on equivalent cores and the Hellmann-Feynman theorem, is given. It relates to previously given transition potential models with the potential at the ionisation site, which has a modified nuclear charge, thus including relaxation.}
}

@article{Goscinski77a,
	author = {O. Goscinski and A. Palma},
	title = {Relaxation effects accompanying core ionization in diatomic molecules},
	journal = {Chemical Physics Letters},
	volume = {47},
	number = {2},
	pages = {322-6},
	month = {15 April 1977},
	year = {1977},
	keywords = {Binding energy; Bond lengths; Carbon compounds; Ionisation of molecules; Nitrogen; Photoelectron spectra; Diatomic molecules; Electronic relaxation; Bond length changes; Inner shell ionisation; CO; N/sub 2/; Relaxation energy surfaces; Transition operator; Renormalised vibrational coupling constants; Reorganisation effects; Koopman's theorem},
	language = {English},
	abstract = {The influence of electronic relaxation on the bond length changes following inner shell ionisation in diatomic molecules is studied. CO and N/sub 2/ are treated explicitly. Transition operators are used for predicting renormalized vibrational coupling constants and slopes of relaxation energy surfaces.}
}

@article{Howat77b,
	author = {G. Howat and T. Aberg and O. Goscinski and S.C. Soong and C.P. Bhalla and M. Ahmed},
	title = {Effect of interchannel interaction on the neon KLL Auger transition rates},
	journal = {Physics Letters A},
	volume = {60A},
	number = {5},
	pages = {404-6},
	month = {21 March 1977},
	year = {1977},
	keywords = {Auger effect; Neon; Interchannel interaction; KLL Auger transition rates; Ne},
	language = {English},
	abstract = {Calculations of neon KLL Auger rates which include the mixing between the final /sup 2/S channels are reported. The results are compared with Kelly's recent many-body-perturbation calculations (see Phys. Rev. A. vol.22, p.556 (1975)) and with absolute rates, obtained from experiments of Gelius et al. (1974) and Krause et al. (1970).}
}

@proceedings{Howat76,
	author = {G. Howat and T. Aberg and O. Goscinski},
	title = {Orbital non-orthogonality and the Wentzel Ansatz},
	journal = {2nd International Conference on Inner Shell Ionization Phenomena. (Abstracts of contributed papers)},
	pages = {126-8},
	organization = {Univ. Freiburg},
	location = {Freiburg, West Germany},
	note = {Date of conference: 29 March-2 April 1976},
	year = {1976},
	keywords = {Atomic electron correlations; Atomic orbitals calculations; Auger effect; HF calculations; Variational techniques; Auger decay theory; Continuum orbitals; Wentzel Ansatz; Variational configuration; Hartree Fock KL/sub 1/L/sub 1/ rates; Orbital nonorthogonality},
	language = {English},
	abstract = {Summary form only given substantially as follows. The problem posed by using separately optimised orbitals for initial and final states in the Auger decay theory is discussed. By calculating the Hartree-Fock KL/sub 1/L/sub 1/ rates using continuum orbitals which are orthogonal and non-orthogonal to the 2s orbital, it is demonstrated that the Wentzel Ansatz cannot be generalised to the many-electron case involving non-orthogonal orbitals by using the familiar rate expression W=2 pi mod ( Phi /sub iEa/ mod /sub i/ Sigma /sub <j/ gamma /sub ij//sup -1/ mod Phi /sub a/) mod /sup 2/. It is contended that the variational configuration approach of Fano (1961) and Mies (1968) provides a more consistent theoretical framework within which to treat the non-orthogonality problem.}
}

