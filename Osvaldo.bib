}

@article{Goscinski01,
	author = {O. Goscinski},
	title = {Calculation of dispersion energy shifts in molecular electronic spectra using sum rules},
	journal = {International Journal of Quantum Chemistry},
	volume = {81},
	number = {3},
	pages = {202-5},
	publisher = {Wiley},
	month = {20 Jan. 2001},
	year = {2001},
	keywords = {Molecular electronic states; Spectra; Sum rules; Van der Waals forces; Dispersion energy shifts; Molecular electronic spectra; Thomas-Reiche-Kuhn sum rules; Casimir-Polder factorization formulas; Van der Waals energies; Dynamic properties; Subsystems; Rational fractions; Polarizabilities; Oscillator strength distributions; Pade approximants; Solute; Solvent},
	language = {English},
	abstract = {The use of factorization formulas due to Casimir and Polder (1948) gives exact expressions for van der Waals energies in terms of the dynamic properties of the subsystems. It is natural to approximate the appearing polarizabilities in terms of rational fractions involving moments of the oscillator strength distributions as previously derived by the present author. The validity of sum rules justifies the procedure. In this work results using the simplest Pade approximants are presented for the dispersion energy associated to two subsystems with the goal of comparing with results of Zerner and co-workers (Canuto et al., 2000) for a solute in the presence of a solvent.}
}

@article{Ahlberg74,
	author = {R. Ahlberg and O. Goscinski},
	title = {Van der Waals constants},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {7},
	number = {10},
	pages = {1194-203},
	month = {11 July 1974},
	year = {1974},
	keywords = {Atomic collision processes; Atomic forces; Intermolecular forces; Molecular collision processes; Van der Waals forces; Van der Waals constants; Long range forces; Intermolecular forces; Atomic forces; Molecular collision processes; Atomic structure; Slater Kirkwood approximation; Atomic collision processes},
	language = {English},
	abstract = {A combined local linear response and inner projection approach to Van der Waals constants is reported. Lower bound formulae are given together with relationships to previous combination rules. For comparison parameters used are also employed in the Slater-Kirkwood approximation. For both symmetric and asymmetric molecules the lower bounds are quite good. Further, anisotropy effects in atom-molecule interactions are estimated.}
