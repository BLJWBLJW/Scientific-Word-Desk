@article{Goscinski69,
	author = {O. Goscinski and E. Brandas},
	title = {Geometric approximation in perturbation theory},
	journal = {Physical Review},
	volume = {182},
	number = {1},
	pages = {43-7},
	month = {June 1969},
	year = {1969},
	keywords = {Atoms; Quantum theory; },
	language = {English},
	abstract = {Even if the terms in a perturbation expansion show geometric behavior only in exceptional cases, e.g., the Hartree-Fock hydrogen atom, the geometrical sum rule leads to remarkable numerical accuracy in a number of cases beyond the apparent prerequisites for its applicability. The rule is here derived by variational perturbation theory and it is seen that it holds, whenever the norm of the first-order wave function is negligible with respect to unity. In other cases it holds in a modified form.}
}

@article{Berrondo69,
	author = {M. Berrondo and O. Goscinski},
	title = {Local exchange approximation and the virial theorem},
	journal = {Physical Review},
	volume = {184},
	number = {1},
	pages = {10-17},
	month = {Aug. 1969},
	year = {1969},
	keywords = {Orbital calculation methods; },
	language = {English},
	abstract = {Whereas the determinantal wave functions constructed from the solutions of the Hartree-Fock equations satisfy the virial theorem, those constructed from self-consistent-field schemes with a local exchange approximation do not necessarily. A scaling procedure, which goes back to Fock, allows considerable improvement and good agreement with the Hartree-Fock results. The virial theorem criterion agrees with previous empirically based assertions that Slater's potential 'overestimates' exchange effects. In addition, and also in an ab initio way, it can be added that Kohn and Sham's potential 'underestimates' them, at least for light atoms. Numerical results and comparison of various methods are presented. A Slater-type local exchange potential is suggested, V/sub HFS/'=-X6(/sup 3///sub 8/ pi ) rho ())/sup 1/3/, where X is determined by the virial theorem. Applications to solid-state physics are discussed.}
}

@article{Andersson02a,
	author = {L.M. Andersson and F. Burmeister and H.O. Karlsson and O. Goscinski},
	title = {Nonadiabatic effects in the photoelectron spectra of HCl and DCl. II. Theory},
	journal = {Physical Review A [Atomic, Molecular, and Optical Physics]},
	volume = {65},
	number = {1},
	pages = {012705/1-6},
	publisher = {APS through AIP},
	month = {Jan. 2002},
	year = {2002},
	keywords = {Bound states; Deuterium compounds; Hydrogen compounds; Photoelectron spectra; Potential energy surfaces; Vibrational states; Nonadiabatic effects; HCl; DCl; Vibrationally resolved photoelectron spectra; Time-dependent approach; Nuclear dynamics; Nonadiabatic coupling; Dissociative 3 /sup 2/ Sigma /sup +/ state; Bound 4 /sup 2/ Sigma /sup +/ state; Adiabatic picture; Diabatic picture; Dissociative two -hole-one-particle state; Bound one-hole state; Molecular system; Intermediate coupling strength; Bound state; Dissociative state; Fano resonances; Broad background; Modified potential energy curves; Fano lifetimes; Simulations; 25 To 28 eV},
	language = {English},
	abstract = {The vibrationally resolved photoelectron spectra of HCl and DCl in the 25-28 eV region were computed using a time-dependent approach for the nuclear dynamics. The spectral features cannot be understood without including a nonadiabatic coupling between the dissociative 3/sup 2/ Sigma /sup +/ state and the bound 4 /sup 2/ Sigma /sup +/ state in the adiabatic picture. Alternatively, in the diabatic picture a dissociative two-hole-one-particle state interacts with a bound one-hole state. The molecular system is of intermediate coupling strength, i.e., it cannot be described by a single potential-energy curve. The interaction between a bound and a dissociative state leads to Fano resonances superimposed on a broad background, as observed in the experimental spectra [Burmeister et al., Phys. Rev. A 65, 012704 (2001)]. From modified potential-energy curves, all features of the experimental spectra, including Fano resonance parameters and lifetimes, were reproduced. From the simulations we observe that two additional peaks in the experimental DCl spectra should appear if the resolution were to be enhanced to around 10 meV.}
}

@article{Fornes74,
