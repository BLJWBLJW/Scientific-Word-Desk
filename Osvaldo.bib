@article{Carlsen99,
	author = {H. Carlsen and E. Sjoqvist and O. Goscinski},
	title = {Quantal trajectories for adiabatic and nonadiabatic regimes of vibronic systems},
	journal = {International Journal of Quantum Chemistry},
	volume = {75},
	number = {4-5},
	pages = {409-16},
	publisher = {Wiley},
	location = {St Augustine, FL, USA},
	note = {From conference: International Symposium on Atomic, Molecular, and Condensed Matter Theory, 27 Feb.-5 March 1999},
	month = {15 Nov.-5 Dec. 1999},
	year = {1999},
	keywords = {Vibronic states; Quantal trajectories; Adiabatic regime; Nonadiabatic regime; Vibronic systems; Nuclear pseudorotational quantal trajectories; Vibronic states; Longuet-Higgins Jahn-Teller model; Electronic motion; Ergodicity; Born-Oppenheimer factorization; Ergodic hypothesis; Quantitative separation; Electronic time-scale; Nuclear time-scales; Global drift; Nuclear motion},
	language = {English},
	abstract = {Exact and averaged nuclear pseudorotational quantal trajectories are compared for various adiabatic and vibronic states of the Longuet-Higgins E(X)Jahn-Teller model. It is argued that the usual averaging over the electronic motion could be understood as being a consequence of ergodicity. The failure of the Born-Oppenheimer factorization to obey the ergodic hypothesis was examined. A quantitative separation of the electronic and nuclear time-scales is, nevertheless, achieved for all regimes. It is shown that the short-time deviations from the global 'drift' of the electronic and nuclear motions are perfectly correlated.}
}

@article{Andersson99,
	author = {L.M. Andersson and H.O. Karlsson and O. Goscinski and L.-E. Berg and M. Beutter and T. Hansson},
	title = {Vibrational wave packet dynamics in NaK: the A /sup 1/ Sigma /sup +/ state},
	journal = {Chemical Physics},
	volume = {241},
	number = {1},
	pages = {43-54},
	publisher = {Elsevier},
	month = {1 Feb. 1999},
	year = {1999},
	keywords = {Digital simulation; Infrared spectra; Molecular electronic states; Optical pumping; Sodium compounds; Time resolved spectra; Vibrational states; Vibrational wave packet dynamics; NaK; A /sup 1/ Sigma /sup +/ state; One-colour femtosecond pump-probe scheme; Dissociation pathway; 3 /Sup 1/ Pi /sup +/ state; Na(3p)+K(4s) product channel; Collisionally mediated processes; Molecular cascading process; 4 /Sup 1/ Sigma /sup +/ state; Na(3p)+K(4s) limit; Time-dependent quantum mechanical calculations; Simulations; Vibrational temperature effects; Rotational temperature effects; Signal shape; Vibrational period; Time-dependent wave packet; Ultrafast time-resolved spectroscopy; Femtosecond spectroscopy; Photodissociation; Temperature effects; IR spectra; 790 Nm; 766 Nm},
	language = {English},
	abstract = {A combined experimental and theoretical study of the vibrational wave packet dynamics for the NaK molecule in the A /sup 1/ Sigma /sup +/ state is presented. The experiment utilises a 790 nm one-colour femtosecond pump-probe scheme with detection of a previously not reported dissociation pathway of the 3 /sup 1/ Pi /sup +/ state, leading to the Na(3p)+K(4s) product channel. The dissociation is suggested to proceed via either collisionally mediated processes or a molecular cascading process via the 4 /sup 1/ Sigma /sup +/ state, which crosses several states correlating to the Na(3p)+K(4s) limit. Time-dependent quantum mechanical calculations are used for studying the dynamics in detail. Simulations are performed both for 790 nm and for 766 nm, to relate also to earlier studies, The previous interpretations of the probe processes are revised. Inclusion of vibrational and rotational temperature effects are shown to be crucial for explaining the shape of the signal and the vibrational period, and leads to excellent agreement with the experiments.}
}

