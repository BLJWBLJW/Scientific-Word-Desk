@article{Asplund76,
	author = {L. Asplund and P. Kelfve and H. Siegbahn and O. Goscinski and H. Fellner-Feldegg and K. Hamrin and B. Blomster and K. Siegbahn},
	title = {Chemical shifts of Auger electron lines and electron binding energies in free molecules. Sulfur compounds},
	journal = {Chemical Physics Letters},
	volume = {40},
	number = {3},
	pages = {353-6},
	month = {15 June 1976},
	year = {1976},
	keywords = {Auger effect; Binding energy; Chemical shift; Sulphur compounds; Auger electron lines; Electron binding energies; Free molecules; ESCA instrument; KL/sub 2/L/sub 3/ Auger electron line; Ne; Core photoelectron spectra; Transition potential model; Relaxation energies; Auger transitions; Single photoionization; S compounds; Chemical shift; COS; Electron impact excitation; SO/sub 2/; SF/sub 6/; H/sub 2/S; CS/sub 2/; Kr; Ne calibration},
	language = {English},
	abstract = {A description of a series of systematic investigations of various free molecules is presented. Excitation is performed by means of a fine focus electron beam. The Auger electrons are retarded in a four component lens system and recorded at high resolution in a new multidetector system placed in the focal plane of the ESCA instrument. A calibration procedure against the KL/sub 2/L/sub 3/ Auger electron line of Ne is described. The first study concerns Auger electron line shifts for sulphur in some small molecules and the results are compared to the corresponding chemical shifts in the core photoelectron spectra. A formalism based on a transition potential model is briefly presented which takes account of the relaxation energies involved in Auger transitions as well as in single photoionization.}
}

@article{Siegbahn76,
	author = {H. Siegbahn and O. Goscinski},
	title = {Transition potential models for Auger electron spectra},
	journal = {Physica Scripta},
	volume = {13},
	number = {4},
	pages = {225-8},
	month = {April 1976},
	year = {1976},
	keywords = {Auger effect; Chemical shift; Auger electron spectra; Chemical shifts; Binding energy chemical shifts; Auger shifts; Relaxation energy; Photoionization; Equivalent cores potential models; Transition potential models},
	language = {English},
	abstract = {Three models for predicting chemical shifts of Auger electron lines are presented. A relation between binding energy chemical shifts and Auger shifts is deduced. The difference in relaxation energy between the Auger and ordinary photoionization process is explicitly included in the analysis. Ambiguities in the use of equivalent cores potential models are pointed out and removed. Computational schemes are proposed and illustrated.}
}

