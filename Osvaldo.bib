@article{Ahlberg75,
	author = {R. Ahlberg and O. Goscinski},
	title = {On the optimization of local linear response calculations of atomic properties},
	journal = {Journal of Physics B [Atomic and Molecular Physics]},
	volume = {8},
	number = {13},
	pages = {2149-59},
	month = {11 Sept. 1975},
	year = {1975},
	keywords = {Atomic polarisability; Atomic structure; Optimization of local linear response calculations; Atomic properties; Ad hoc functional; Slater exchange potential; Equations of motion; Scaling procedures; F-sum rule; Shielding tensors; Frequency dependent polarisability; Cut off potential},
	language = {English},
	abstract = {It is shown that several relationships valid for exact or variational-perturbation theories hold also, under quite general conditions, for much simpler (local potential) theories based on variations of an ad hoc functional. Equations of motion, formulae for the f-sum rule, frequency-dependent polarizability- and shielding-tensors are derived. Scaling procedures are discussed. Numerical examples, with a Slater exchange potential, are given. It is shown that the use of a cut-off potential, as in previous calculations, is detrimental to the optimization procedure.}
}

