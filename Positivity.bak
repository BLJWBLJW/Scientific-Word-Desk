\section{Positivity}

\section{Exterior Algebra}

\subsection{ Basic Definition}

The exterior algebra $%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\left(  V\right)  $ is a graded tensor algebra based on the vector space $V$
is given by%

\begin{equation}%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  \mathcal{=}%
%TCIMACRO{\dbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion%
%TCIMACRO{\dbigwedge \nolimits^{p}}%
%BeginExpansion
{\displaystyle\bigwedge\nolimits^{p}}
%EndExpansion
V
\end{equation}
where exterior multiplication is defined by
\begin{equation}
a\wedge b=a\otimes b-b\otimes a
\end{equation}
that gives for $A\in%
%TCIMACRO{\tbigwedge \nolimits^{p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{p}}
%EndExpansion
V$ and $B\in%
%TCIMACRO{\tbigwedge \nolimits^{q}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{q}}
%EndExpansion
V$
\begin{equation}
A\wedge B=\left(  -1\right)  ^{p+q}B\wedge A.
\end{equation}


\begin{remark}
The unit of this algebra is $\left\vert \phi\right\rangle \in%
%TCIMACRO{\tbigwedge \nolimits^{0}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{0}}
%EndExpansion
V,$ the algebra is associative but no inverses exist.
\end{remark}

\subsection{Fock Algebra}

\begin{remark}
The Fock algebra $\mathcal{F\cong B}\left(  \mathcal{H}_{\mathcal{F}}\right)
$ has an exterior algebra structure wrt the product wedge product defined as
\begin{equation}
A\wedge B=\left[  A,B\right]  .
\end{equation}

\end{remark}

\begin{remark}
The transformation $K$ between a creation/annihilation basis $\left(
\boldsymbol{a}^{\dagger},\boldsymbol{a}\right)  $ and the corresponding
Majorano basis $\left(  \boldsymbol{x}\right)  $ is
\begin{equation}
\left(  \boldsymbol{x}\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{x}_{1} & \boldsymbol{x}_{2}%
\end{array}
\right)  =K\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  \mathbb{K}=\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  \frac{1}{\sqrt{2}}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  .
\end{equation}
thus
\begin{equation}
x_{j}^{2}=\frac{1}{2}\left(  a_{j}^{\dagger}+a_{j}\right)  \left(
a_{j}^{\dagger}+a_{j}\right)  =\frac{1}{2}\left(  a_{j}^{\dagger}%
a_{j}^{\dagger}+a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}+a_{j}a_{j}\right)
=\frac{1}{2}\left(  a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}\right)
=\frac{1}{2}\left(  a_{j}^{\dagger}a_{j}+I_{\mathcal{F}}-a_{j}^{\dagger}%
a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}%
\end{equation}
and
\begin{equation}
x_{j+r}^{2}=-\frac{1}{2}\left(  a_{j}^{\dagger}-a_{j}\right)  \left(
a_{j}^{\dagger}-a_{j}\right)  =-\frac{1}{2}\left(  a_{j}^{\dagger}%
a_{j}^{\dagger}-a_{j}^{\dagger}a_{j}-a_{j}a_{j}^{\dagger}+a_{j}a_{j}\right)
=\frac{1}{2}\left(  a_{j}^{\dagger}a_{j}+a_{j}a_{j}^{\dagger}\right)
=\frac{1}{2}\left(  a_{j}^{\dagger}a_{j}+I_{\mathcal{F}}-a_{j}^{\dagger}%
a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}.
\end{equation}

\end{remark}

\begin{remark}
The expansion of $A\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
in a creation/annihilation basis is
\begin{equation}
A=I_{\mathcal{F}}\mathcal{R}_{a}\left(  A\right)  _{0}+\sum_{0\leq m,n\leq
r}\sum_{\substack{1\leq j_{1}<\cdots<j_{m}\leq r\\1\leq k_{1}<\cdots<k_{m}\leq
r}}a_{j_{1}}^{\dagger}\cdots a_{j_{r}}^{\dagger}a_{k_{1}}\cdots a_{k_{r}%
}\mathcal{R}_{a}\left(  A\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{n}}.
\end{equation}

\end{remark}

\begin{remark}
The expansion of $A\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  $
in the corresponding Majorano basis is
\begin{equation}
A=I_{\mathcal{F}}\mathcal{R}_{x}\left(  A\right)  _{0}+\sum_{0\leq n\leq
2r}\sum_{1\leq j_{1}<\cdots<j_{m}\leq2r}x_{j_{1}}\wedge\cdots\wedge x_{j_{n}%
}\mathcal{R}_{x}\left(  A\right)  _{j_{1}\cdots j_{n}}.
\end{equation}

\end{remark}

\begin{example}
$r=2,2^{2}=4,2^{4}=16$

\begin{enumerate}
\item $v\in\mathcal{H}_{\mathcal{F}}\cong\mathbb{C}^{4}$%
\begin{equation}
v=\left\vert \phi\right\rangle \mathcal{R}_{0\varphi}+\left\vert \varphi
_{1}\right\rangle \mathcal{R}_{1\varphi}\left(  v\right)  _{1}+\left\vert
\varphi_{2}\right\rangle \mathcal{R}_{1\varphi}\left(  v\right)
_{2}+\left\vert \varphi_{1}\varphi_{2}\right\rangle \mathcal{R}_{2\varphi
}\left(  v\right)  _{12}%
\end{equation}


\item $A\in\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  \cong%
\mathcal{B}\left(  \mathbb{C}^{4}\right)  $%
\begin{gather}
A\\
\parallel\\
I_{4}\mathcal{R}_{a}\left(  A\right)  _{0}+\sum_{1\leq j_{1}\leq2}a_{j_{1}%
}^{\dagger}\mathcal{R}_{a}\left(  A\right)  _{j_{1}}\ +\sum_{1\leq k_{1}\leq
2}a_{k_{1}}\mathcal{R}_{a}\left(  A\right)  _{j_{1}}\\
+\sum_{1\leq j_{1}<j_{2}\leq2}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger
}\mathcal{R}_{a}\left(  A\right)  _{j_{1}j_{2}}+\sum_{1\leq k_{1}<k_{2}\leq
2}a_{k_{1}}a_{k_{2}}\mathcal{R}_{a}\left(  A\right)  _{k_{1}k_{2}}%
+\sum_{\substack{1\leq j_{1}<j_{2}\leq2\\1\leq k_{1}\leq2}}a_{j_{1}}^{\dagger
}a_{j_{2}}^{\dagger}a_{k_{1}}\mathcal{R}_{a}\left(  A\right)  _{j_{1}%
j_{2}k_{1}}+\sum_{\substack{1\leq j_{1}\leq2\\1\leq k_{1}<k_{2}\leq2}%
}a_{j_{1}}^{\dagger}a_{k_{1}}a_{k_{2}}\mathcal{R}_{a}\left(  A\right)
_{j_{1}k_{1}k_{2}}+\sum_{\substack{1\leq j_{1}<j_{2}\leq2\\1\leq k_{1}%
<k_{2}\leq2}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{k_{1}}a_{k_{2}%
}\mathcal{R}_{a}\left(  A\right)  _{j_{1}j_{2}k_{1}k_{2}}\\
\parallel\\
I_{4}\mathcal{R}_{a}\left(  A\right)  _{0}+a_{1}^{\dagger}\mathcal{R}%
_{a}\left(  A\right)  _{1000}\ +a_{2}^{\dagger}\mathcal{R}_{a}\left(
A\right)  _{2000}+a_{1}\mathcal{R}_{a}\left(  A\right)  _{0010}\ +a_{2}%
\mathcal{R}_{01a}\left(  A\right)  _{0020}\\
+a_{1}^{\dagger}a_{2}^{\dagger}\mathcal{R}_{a\ }\left(  A\right)
_{1200}+a_{1}a_{2}\mathcal{R}_{a}\left(  A\right)  _{0012}+a_{1}^{\dagger
}a_{1}\mathcal{R}_{a}\left(  A\right)  _{1010}+a_{1}^{\dagger}a_{2}%
\mathcal{R}_{a}\left(  A\right)  _{1020}+a_{2}^{\dagger}a_{1}\mathcal{R}%
_{a}\left(  A\right)  _{2010}+a_{2}^{\dagger}a_{2}\mathcal{R}_{a}\left(
A\right)  _{2020}\\
+a_{1}^{\dagger}a_{2}^{\dagger}a_{1}\mathcal{R}_{a}\left(  A\right)
_{1210\ }+a_{1}^{\dagger}a_{2}^{\dagger}a_{2}\mathcal{R}_{a}\left(  A\right)
_{1220}+a_{1}^{\dagger}a_{1}a_{2}\mathcal{R}_{a}\left(  A\right)
_{1012}+a_{2}^{\dagger}a_{1}a_{2}\mathcal{R}_{a}\left(  A\right)
_{2012}+a_{1}^{\dagger}a_{2}^{\dagger}a_{1}a_{2}\mathcal{R}_{a}\left(
A\right)  _{1212}%
\end{gather}


\item
\begin{gather}
A\\
\parallel\\
I_{\mathcal{F}}\mathcal{R}_{x}\left(  A\right)  _{0}\\
+x_{1}\mathcal{R}_{x}\left(  A\right)  _{1}+x_{2}\mathcal{R}_{x}\left(
A\right)  _{2}+x_{3}\mathcal{R}_{x}\left(  A\right)  _{3}+x_{4}\mathcal{R}%
_{x}\left(  A\right)  _{4}\\
+x_{1}\wedge x_{2}\mathcal{R}_{x}\left(  A\right)  _{12}+x_{1}\wedge
x_{3}\mathcal{R}_{x}\left(  A\right)  _{13}++x_{1}\wedge x_{4}\mathcal{R}%
_{x}\left(  A\right)  _{14}+x_{2}\wedge x_{3}\mathcal{R}_{x}\left(  A\right)
_{23}+x_{2}\wedge x_{4}\mathcal{R}_{x}\left(  A\right)  _{24}+x_{3}\wedge
x_{4}\mathcal{R}_{x}\left(  A\right)  _{34}\\
+x_{1}\wedge x_{2}\wedge x_{3}\mathcal{R}_{x}\left(  A\right)  _{123}%
+x_{1}\wedge x_{2}\wedge x_{4}\mathcal{R}_{x}\left(  A\right)  _{124}%
+x_{1}\wedge x_{3}\wedge x_{4}\mathcal{R}_{x}\left(  A\right)  _{134}%
+x_{2}\wedge x_{3}\wedge x_{4}\mathcal{R}_{x}\left(  A\right)  _{234}\\
+x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}\mathcal{R}_{x}\left(  A\right)
_{1234}%
\end{gather}

\end{enumerate}
\end{example}

\subsection{Even Exterior Subalgebra $%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\protect\bigwedge}
%EndExpansion
\left(  V\right)  _{even}$}

\begin{definition}
The even exterior subalgebra is defined as
\begin{equation}%
%TCIMACRO{\dbigwedge }%
%BeginExpansion
{\displaystyle\bigwedge}
%EndExpansion
\left(  \overset{}{V}\right)  _{even}=%
%TCIMACRO{\dbigoplus \limits_{0\leq p\leq n}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq p\leq n}}
%EndExpansion%
%TCIMACRO{\dbigwedge \nolimits^{2p}}%
%BeginExpansion
{\displaystyle\bigwedge\nolimits^{2p}}
%EndExpansion
V.
\end{equation}
It is a\textbf{ commutative }sub algebra wrt the multiplication $"\wedge"$ as
\begin{equation}
A\in%
%TCIMACRO{\tbigwedge \nolimits^{2p}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2p}}
%EndExpansion
V\text{ and }B\in%
%TCIMACRO{\tbigwedge \nolimits^{2q}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits^{2q}}
%EndExpansion
V
\end{equation}
and
\begin{equation}
A\wedge B=\left(  -1\right)  ^{2p+2q}B\wedge A=B\wedge A,\quad0\leq p,q\leq n.
\end{equation}

\end{definition}

\begin{enumerate}
\item
\begin{equation}
\left(  e_{1}\wedge e_{2}\right)  \wedge\left(  e_{3}\wedge e_{4}\right)
=\left(  e_{3}\wedge e_{4}\right)  \wedge\left(  e_{1}\wedge e_{2}\right)
\end{equation}


\item
\begin{equation}
e_{1}\wedge e_{2}\wedge\left(  e_{3}\wedge e_{4}\wedge e_{5}\wedge
e_{6}\right)  =\left(  e_{3}\wedge e_{4}\wedge e_{5}\wedge e_{6}\right)
\wedge e_{1}\wedge e_{2}%
\end{equation}


\item If there any repeat subscripts the terms are zero.
\end{enumerate}

\begin{remark}
The even subalgebra $%
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\bigwedge_{even}}
%EndExpansion
\left(  V\right)  $ is generated by $%
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\bigwedge_{even}}
%EndExpansion
\left(  V\right)  _{2}=%
%TCIMACRO{\tbigwedge ^{2}}%
%BeginExpansion
{\textstyle\bigwedge^{2}}
%EndExpansion
V$ where

\begin{enumerate}
\item
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits_{even}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{even}}
%EndExpansion
\left(  V\right)  _{2}=\mathbb{C}\text{-}\operatorname{linspan}\left\{
\left.  e_{jk}\right\vert 1\leq j<k\leq n\right\}
\end{equation}


\item
\begin{equation}
\left[  e_{jk},e_{lm}\right]  _{\wedge}=0
\end{equation}


\item
\begin{equation}%
%TCIMACRO{\tbigwedge \nolimits_{even}}%
%BeginExpansion
{\textstyle\bigwedge\nolimits_{even}}
%EndExpansion
\left(  V\right)  _{4}=\mathbb{C}\text{-}\operatorname{linspan}\left\{
\left.  e_{jk}\wedge e_{lm}\right\vert 1\leq j<k<l<m\leq n\right\}
\end{equation}

\end{enumerate}
\end{remark}

\subsection{Functions $F\left(
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\protect\bigwedge_{even}}
%EndExpansion
\left(  V\right)  ,%
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\protect\bigwedge_{even}}
%EndExpansion
\left(  V\right)  \right)  $ Defined on $%
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\protect\bigwedge_{even}}
%EndExpansion
\left(  V\right)  $}

\begin{definition}
Exponential Function $\exp_{\wedge}\in F\left(
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\bigwedge_{even}}
%EndExpansion
\left(  V\right)  ,%
%TCIMACRO{\tbigwedge _{even}}%
%BeginExpansion
{\textstyle\bigwedge_{even}}
%EndExpansion
\left(  V\right)  \right)  $%
\begin{gather}
\exp_{\wedge}\left(  A\right) \\
\parallel\\
I_{\mathcal{F}}+\frac{1}{n!}\sum_{1\leq n\leq r}A\wedge\overset{\longleftarrow
n\longrightarrow}{\cdots}\wedge A\\
\parallel\\
\exp_{\wedge}\left(  I_{\mathcal{F}}\mathcal{R}_{0x}\left(  A\right)
+\sum_{1\leq j_{1}<j_{2}\leq2n}e_{j_{1}j_{2}}\mathcal{R}_{2X}\left(  A\right)
_{j_{1}j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2n}e_{j_{1}j_{2}}\wedge
e_{j_{3}j_{4}}\mathcal{R}_{4X}\left(  A\right)  _{j_{1}j_{2}j_{3}j_{4}}%
+\cdots+\sum_{1\leq j_{1}<j_{2}<\cdots\,j_{2n-1}<j_{2n}\leq2n}e_{j_{1}j_{2}%
}\wedge\cdots\wedge e_{j_{2n-1}j_{2n}}\mathcal{R}_{4X}\left(  A\right)
_{j_{1}j_{2}\cdots j_{2n-1}j_{2n}}\right)  .
\end{gather}

\end{definition}

\section{Two Particle Operators}

The exponential of self adjoint operators are non singular positive operators.
As they are non singular they cannot be trace class thus cannot be normalized
to be density operators.

\subsubsection{Self Adjoint Two Particle Operators}

\begin{enumerate}
\item In creation / annihilation operator form
\begin{equation}
A_{2}=\sum_{1\leq j\leq r}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{3}%
}a_{j_{44}}\mathcal{R}_{a}\left(  A\right)  _{j_{1}j_{2}j_{3}j_{4}}%
=A_{2}^{\dagger}%
\end{equation}
where
\begin{equation}
\mathcal{R}_{a}\left(  A\right)  =\mathcal{R}_{a}\left(  A\right)  ^{\dagger}.
\end{equation}


\item The exponential $e^{A}$ is a generating function for the operators
$a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{3}}a_{j_{4}},1\leq j_{1}%
<j_{2}<j_{3}<j_{4}\leq r$
\begin{equation}
\left.  \frac{{\Large \partial}}{{\Large \partial}\mathcal{R}_{a}\left(
A\right)  _{j_{1}j_{2}j_{3}j_{4}}}\left(  \exp\left(  \sum_{\substack{1\leq
j_{1}<j_{2}\leq r\\1\leq jj_{3}<j_{4}\leq r}}a_{j_{1}}^{\dagger}a_{j_{2}%
}^{\dagger}a_{j_{3}}a_{j_{44}}\mathcal{R}_{a}\left(  A\right)  _{j_{1}%
j_{2}j_{3}j_{4}}\right)  \right)  \right\vert _{\mathbf{x=0}}=a_{j_{1}%
}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{3}}a_{j_{4}}%
\end{equation}


\item In Majorano operator form%
\begin{align}
A_{2}  &  =I_{\mathcal{F}}\mathcal{R}_{x}\left(  A\right)  +i\sum_{1\leq
j_{1}<j_{2}\leq2r}x_{j_{1}}x_{j_{2}}\mathcal{R}_{x}\left(  A\right)
_{j_{1}j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}x_{j_{1}}x_{j_{2}%
}x_{j_{3}}x_{j_{4}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}j_{3}j_{4}}\\
&  =I_{\mathcal{F}}\mathcal{R}_{0x}\left(  A\right)  +i\sum_{1\leq j_{1}%
<j_{2}\leq2r}x_{j_{1}}\wedge x_{j_{2}}\mathcal{R}_{x}\left(  A\right)
_{j_{1}j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\mathcal{R}_{x}\left(  A\right)
_{j_{1}j_{2}j_{3}j_{4}}=A_{2}^{\dagger},
\end{align}
where
\begin{equation}
x_{j_{1}j_{2}j_{3}j_{4}}\in\mathbb{R},\,1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r.
\end{equation}


\item In even Majorano operator form (which is commutative wrt $\wedge)$
\begin{align}
A_{2}  &  =I_{\mathcal{F}}\mathcal{R}_{x}\left(  A\right)  +i\sum_{1\leq
j_{1}<j_{2}\leq2r}X_{j_{1}j_{2}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}%
}+\sum_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq j_{3}<j_{4}\leq2r}%
}X_{j_{1}j_{2}}X_{j_{3}j_{4}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}%
j_{2}j_{3}j_{4}}\\
&  =I_{\mathcal{F}}\mathcal{R}_{x}\left(  A\right)  +i\sum_{1\leq j_{1}%
<j_{2}\leq2r}X_{j_{1}j_{2}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}}%
+\sum_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq j_{3}<j_{4}\leq2r}%
}X_{j_{1}j_{2}}\wedge X_{j_{3}j_{4}}\mathcal{R}_{x}\left(  A\right)
_{j_{1}j_{2}j_{3}j_{4}}%
\end{align}


\item The exponential $e^{A}$ is a generating function for the operators
$X_{j_{1}j_{2}}\cdots X_{j_{2m-1}j_{2m}},1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq r$%
\begin{equation}
\left.  \frac{{\Large \partial}}{{\Large \partial}\mathcal{R}_{x}\left(
A\right)  _{j_{1}j_{2}\cdots j_{2m}}}\left(  \exp\left(  I_{\mathcal{F}%
}\mathcal{R}_{x}\left(  A\right)  +i\sum_{1\leq j_{1}<j_{2}\leq2r}%
X_{j_{1}j_{2}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}}+\sum
_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq j_{3}<j_{4}\leq2r}}X_{j_{1}j_{2}%
}X_{j_{3}j_{4}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}j_{3}j_{4}%
}\right)  \right)  \right\vert _{\mathcal{R}_{2X}\left(  A\right)
\mathbf{=0}}=X_{j_{1}j_{2}}\cdots X_{j_{2m-1}j_{2m}}%
\end{equation}


\begin{enumerate}
\item
\begin{equation}
x_{j_{2}}x_{j_{1}}=\frac{1}{2}\left\{  x_{j_{1}},x_{j_{2}}\right\}  +\frac
{1}{2}\left[  x_{j_{1}},x_{j_{2}}\right]  =\left(  \left.  x_{j_{1}%
}\right\vert x_{j_{2}}\right)  I_{\mathcal{F}}+x_{j_{1}}\wedge x_{j_{2}}%
\end{equation}
if $j_{2}\neq$  $j_{1}$
\begin{equation}
x_{j_{2}}x_{j_{1}}=x_{j_{1}}\wedge x_{j_{2}}%
\end{equation}
so
\begin{equation}
\left(  \left.  x_{j_{1}}\right\vert x_{j_{2}}\right)  =0.
\end{equation}
if $j_{2}=$ $j_{1}$
\begin{equation}
x_{j_{2}}^{2}=\frac{1}{2}I_{\mathcal{F}}%
\end{equation}
so
\begin{equation}
\left(  \left.  x_{j_{1}}\right\vert x_{j_{1}}\right)  =\frac{1}{2}.
\end{equation}


\item
\begin{align}
\left[  x_{1}x_{2},x_{1}x_{2}\right]   &  =0\\
\left[  x_{1}x_{2},x_{3}x_{4}\right]   &  =0
\end{align}


\item
\begin{equation}
2a_{j}^{\dagger}\wedge a_{k}=\left[  a_{j}^{\dagger},a_{k}\right]
=a_{j}^{\dagger}a_{k}-a_{k}a_{j}^{\dagger}=a_{j}^{\dagger}a_{k}-\left(
\delta_{jk}I_{\mathcal{F}}-a_{j}^{\dagger}a_{k}\right)  =2a_{j}^{\dagger}%
a_{k}-\delta_{jk}I_{\mathcal{F}}%
\end{equation}
i.e
\begin{equation}
a_{j}^{\dagger}\wedge a_{k}=a_{j}^{\dagger}a_{k}-\frac{1}{2}I_{\mathcal{F}%
}\delta_{jk}%
\end{equation}


\item
\begin{equation}
a_{j}\wedge a_{k}=\left[  a_{j},a_{k}\right]  =a_{j}a_{k}-a_{k}a_{j}%
=2a_{j}a_{k}%
\end{equation}


\item
\begin{align}
\left[  X_{12},X_{12}\right]   &  =X_{12}X_{12}-X_{12}X_{12}=\left[
x_{1}x_{2},x_{1}x_{3}\right]  =x_{1}x_{2}x_{1}x_{3}-x_{1}x_{3}x_{1}%
x_{2}=-x_{1}x_{1}x_{2}x_{3}+x_{1}x_{1}x_{3}x_{2}\\
\  &  =x_{1}x_{1}\left(  x_{3}x_{2}-x_{2}x_{3}\right)  =\frac{1}{2}\left(
x_{3}x_{2}-x_{2}x_{3}\right)  =-x_{2}x_{3}=-X_{23}%
\end{align}


\item
\begin{align}
\left[  X_{45},X_{34}\right]   &  =X_{45}X_{34}-X_{34}X_{45}==\left[
x_{4}x_{5},x_{3}x_{4}\right]  =x_{4}x_{5}x_{3}x_{4}-x_{3}x_{4}x_{4}x_{5}%
=x_{4}x_{4}x_{5}x_{3}-x_{4}x_{4}x_{3}x_{5}\\
&  =x_{4}x_{4}\left(  x_{5}x_{3}-x_{3}x_{5}\right)  =\frac{1}{2}\ \left(
x_{5}x_{3}-x_{3}x_{5}\right)  \ =-x_{3}x_{5}=-X_{35}%
\end{align}
where
\begin{equation}
1\leq j_{1},j_{2},j_{3},j_{4}\leq r
\end{equation}


\begin{enumerate}
\item
\[
\left[  X_{j_{1}j_{2}},X_{j_{1}j_{2}}\right]  =0
\]


\item
\begin{equation}
\lbrack X_{ij}{},X_{il{}}]=-2X_{jl}{}.
\end{equation}


\item
\[
\left[  X_{j_{1}j_{2}},X_{j_{3}j_{4}}\right]  =0
\]


\item
\[
\left[  X_{j_{1}j_{2}},X_{j_{3}j_{4}}\right]  _{\wedge}=0
\]

\end{enumerate}
\end{enumerate}

\item
\begin{gather}
\exp_{\wedge}\left(  I_{\mathcal{F}}\mathcal{R}_{x}\left(  A\right)
+i\sum_{1\leq j_{1}<j_{2}\leq2r}X_{j_{1}j_{2}}\mathcal{R}_{x}\left(  A\right)
_{j_{1}j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq2r}X_{j_{1}j_{2}}%
X_{j_{3}j_{4}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}j_{3}j_{4}}\right)
\\
\parallel\\
\exp\left(  \overset{\overset{}{}}{I_{\mathcal{F}}\mathcal{R}_{x}\left(
A\right)  }\right)  \wedge\exp_{\wedge}\left(  i\sum_{1\leq j_{1}<j_{2}\leq
2r}X_{j_{1}j_{2}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}}+\sum
_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq jj_{3}<j_{4}\leq2r}}X_{j_{1}j_{2}%
}\wedge X_{j_{3}j_{4}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}j_{3}j_{4}%
}\right)  \\
\not \parallel \\
\exp\left(  \overset{\overset{}{}}{I_{\mathcal{F}}\mathcal{R}_{x}\left(
A\right)  }\right)  \wedge\exp\left(  i\sum_{1\leq j_{1}<j_{2}\leq2r}%
X_{j_{1}j_{2}}\mathcal{R}_{x}\left(  A\right)  _{j_{1}j_{2}}\right)
\wedge\exp\left(  \sum_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq jj_{3}%
<j_{4}\leq2r}}X_{j_{1}j_{2}}X_{j_{3}j_{4}}\mathcal{R}_{x}\left(  A\right)
_{j_{1}j_{2}j_{3}j_{4}}\right)
\end{gather}

\end{enumerate}


