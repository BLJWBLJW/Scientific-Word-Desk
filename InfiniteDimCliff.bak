\section{Infinite Dimensional Clifford Algebras.}

\subsection{CAR and Clifford Algebras}

An abstract CAR\ algebra $\mathcal{A}\left(  \mathfrak{H}\right)  $ over a
Hilbert space $\mathfrak{H}$ is defined to be a unital complex c$^{\ast}%
$-algebra generated by the elements $\left\{  b\left(  v\right)  \right\}  $
that satisfy%
\begin{align}
\left\{  b\left(  v\right)  ,b\left(  w\right)  \right\}   &  =0\\
\left\{  b\left(  v\right)  ,b\left(  w\right)  ^{\dagger}\right\}   &
=\left\langle \left.  v\right\vert w\right\rangle I\\
b^{\dagger}\left(  w\right)   &  \triangleq b\left(  w\right)  ^{\dagger}\\
v,w &  \in\mathfrak{H.}%
\end{align}
$\mathcal{A}\left(  \mathfrak{H}\right)  $ is a simple (no non trivial
\emph{closed} two sided ideals) c$^{\ast}$-algebra.

An abstract complex Clifford algebra $\mathcal{CL}\left(  \mathfrak{H}\right)
$ over $\mathfrak{H}$ is defined to be a unital c$^{\ast}$-algebra generated
by the the self adjoint elements
\begin{align}
\left\{  x\left(  v\right)  ,x\left(  w\right)  \right\}   &  =\frac{1}%
{2}\operatorname{Re}\left\langle \left.  v\right\vert w\right\rangle I\\
v,w  &  \in\mathfrak{H.}%
\end{align}
$\mathcal{CL}\left(  \mathfrak{H}\right)  $ is a simple c$^{\ast}$-algebra$.$
$\mathcal{\ }a,a^{\dagger}$ and $x$ are real linear maps over $\mathfrak{H.}$
The space $\mathfrak{H}$ can be considered either as the real space
\begin{equation}
\mathfrak{H=S}\oplus\mathfrak{S}%
\end{equation}
or the complex space
\begin{equation}
\mathfrak{H=S}\oplus i\mathfrak{S}=\mathfrak{S}_{\mathbb{C}}.
\end{equation}


$\mathcal{A}\left(  \mathfrak{H}\right)  $ and $\mathcal{CL}\left(
\mathfrak{H}\right)  $ are isomorphic as $\mathbb{C}$-algebras through the
isometric isomorphism $J$ given by
\begin{align}
\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)   &  =J\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
J\left(  \mathbf{b}^{\dagger}\right)  & J\left(  \mathbf{b}\right)
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \mathbb{J}\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  ,
\end{align}
the homomorpic property is given by
\begin{equation}
J\left(  b_{j_{1}}^{\dagger}\cdots b_{j_{p}}^{\dagger}b_{k_{1}}\cdots
b_{k_{q}}\right)  =J\left(  b_{j_{1}}^{\dagger}\right)  \cdots J\left(
b_{j_{p}}^{\dagger}\right)  J\left(  b_{k_{1}}\right)  \cdots J\left(
b_{k_{q}}\right)  =x_{j_{1}}\cdots x_{j_{p}}x_{k_{1+r}}\cdots x_{k_{p+r}}%
\end{equation}
the isomorphic property by (note that $J$ \emph{is not} a unitary
transformation)
\begin{align}
J^{-1}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathbb{J}^{\dagger}=\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \mathbb{JJ}^{\dagger}=\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)
\end{align}
and isometric property by observing that
\begin{equation}
\left\Vert b_{j}^{\dagger}\right\Vert =\left\Vert b_{j}\right\Vert =\left\Vert
J\left(  b_{j}^{\dagger}\right)  \right\Vert =\left\Vert J\left(
b_{j}\right)  \right\Vert =1,
\end{equation}
where the norm is defined by the following. As $\left\{  b_{j}^{\dagger}%
b_{j},b_{j}b_{j}^{\dagger}\right\}  $ are partial isometries one has
\begin{equation}
\left\Vert b_{j}^{\dagger}\right\Vert =\left\Vert b_{j}\right\Vert =\left\Vert
b_{j}^{\dagger}b_{j}\right\Vert ^{\frac{1}{2}}=\left\Vert b_{j}b_{j}^{\dagger
}\right\Vert ^{\frac{1}{2}}=\left(  \operatorname*{rad}\left(  \sigma\left(
b_{j}^{\dagger}b_{j}\right)  \right)  \right)  ^{\frac{1}{2}}=\left(
\operatorname*{rad}\left(  \sigma\left(  b_{j}b_{j}^{\dagger}\right)  \right)
\right)  ^{\frac{1}{2}}=\lim\limits_{n\rightarrow\infty}\left(
\operatorname*{tr}\left\{  \left(  b_{j}^{\dagger}b_{j}\right)  ^{n}\right\}
\right)  ^{\frac{1}{2n}}=1,
\end{equation}
where the spectrum $\sigma\left(  A\right)  $ of $A$ is given by
\begin{equation}
\sigma\left(  A\right)  =\left\{  \left.  \lambda\right\vert \left(  A-\lambda
I\right)  ^{-1}\,\nexists\right\}  ,
\end{equation}
$\operatorname*{rad}\left(  A\right)  $ is the spectral radius of $A$ and the
unique normalized trace defined by
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\left\langle \left\langle
A\right\rangle \right\rangle _{0}.
\end{equation}
The basis elements have norms given by
\begin{align}
\left\Vert J\left(  b_{j}^{\dagger}\right)  \right\Vert  &  =\left\Vert
x_{j}\right\Vert =\left\Vert x_{j}^{2}\right\Vert ^{\frac{1}{2}}=1\\
\left\Vert J\left(  b_{j}\right)  \right\Vert  &  =\left\Vert x_{j+s}%
\right\Vert =\left\Vert x_{j+r}^{2}\right\Vert ^{\frac{1}{2}}=1,
\end{align}
as
\begin{equation}
x_{j}^{2}=x_{j+r}^{2}=1.
\end{equation}
The transformation\emph{ }$J$ \emph{is NOT a c}$^{\ast}$-algebra isomorphism
as
\begin{equation}
\mathbf{x}_{1}=J\left(  \mathbf{b}^{\dagger}\right)  \neq J\left(
\mathbf{b}\right)  ^{\dagger}=\mathbf{x}_{2}^{\dagger}=\mathbf{x}_{2}%
\end{equation}
as%
\begin{equation}
\mathbf{x}_{2}=J\left(  \mathbf{b}\right)  .
\end{equation}


\subsection{Left Regular Representation}

First we need a Hilbert space for the representation to act in. This is formed
by considering the unique normalized scalar valued trace $\operatorname*{tr}$
\begin{equation}
\operatorname*{tr}\left\{  A\right\}  =\left\langle \left\langle
A\right\rangle \right\rangle _{0}%
\end{equation}
that produces the hermitian scalar product
\begin{equation}
\left\langle \left\langle A\left\vert B\right.  \right\rangle \right\rangle
=\left\langle \left\langle A^{\dagger}B\right\rangle \right\rangle
_{0}=\operatorname*{tr}\left\{  A^{\dagger}B\right\}
\end{equation}
and thus a Hilbert space norm
\begin{equation}
\left\Vert A\right\Vert _{Hil}=\left\langle \left\langle A\left\vert B\right.
\right\rangle \right\rangle ^{\frac{1}{2}}=\left(  \operatorname*{tr}\left\{
A^{\dagger}A\right\}  \right)  ^{\frac{1}{2}}.
\end{equation}
The Hilbert space is then the completion of finite polynomials in
$\mathcal{A}\left(  \mathfrak{H}\right)  $ wrt this norm. \emph{One should
note that in general }$\left\Vert A\right\Vert _{Hil}\geq\left\Vert
A\right\Vert $ and thus
\begin{equation}
\mathcal{A}\left(  \mathfrak{H}\right)  \supseteq\mathcal{A}\left(
\mathfrak{H}\right)  _{Hil}.
\end{equation}
The set $\mathcal{A}\left(  \mathfrak{H}\right)  _{Hil}$ is an \emph{open} (in
c*-norm) two sided ideal of $\mathcal{A}\left(  \mathfrak{H}\right)  .$There
are many other Schatten-Von Neuman ideals contained in $\mathcal{A}\left(
\mathfrak{H}\right)  $ corresponding to the $l_{p}$ spaces.

The left regular representation
\begin{equation}
\Pi_{l}:\mathcal{A}\left(  \mathfrak{H}\right)  \rightarrow\mathcal{B}\left(
\mathcal{A}\left(  \mathfrak{H}\right)  _{Hil}\right)
\end{equation}
is defined by
\begin{equation}
\Pi_{l}\left(  A\right)  B=AB
\end{equation}
and the right anti regular representation as
\begin{equation}
\Pi_{r}\left(  A\right)  B=BA.
\end{equation}
One can show that%
\begin{equation}
\Pi_{l}\left(  \mathcal{A}\left(  \mathfrak{H}\right)  \right)  ^{\prime}%
=\Pi_{r}\left(  \mathcal{A}\left(  \mathfrak{H}\right)  \right)
\end{equation}
and $\Pi_{l}\left(  \mathcal{A}\left(  \mathfrak{H}\right)  \right)
^{\prime\prime}$ is a von neuman algebra.

Clearly left ideals, (ideals are sub algebras, but sub algebras not
necessarily ideals), produce sub representations of $\Pi_{l}$ as they form
invariant subspaces of $\mathcal{A}\left(  \mathfrak{H}\right)  _{Hil}.$ Any
left ideal $I_{e}$ can be associated with an idempotent $e$ that projects onto
the ideal and thus%
\begin{equation}
I_{e}=\left\{  \left.  eAe\right\vert e^{2}=e;A\in\mathcal{A}\left(
\mathfrak{H}\right)  \right\}
\end{equation}
In an algebra ideals have a linear structure i.e.
\begin{equation}
A,B\in I_{e}\Leftrightarrow A+B\in I_{e}.
\end{equation}
Thus the algebra $\mathcal{A}\left(  \mathfrak{H}\right)  $ can be decomposed
as
\begin{equation}
\mathcal{A}\left(  \mathfrak{H}\right)  =%
%TCIMACRO{\dbigoplus \limits_{e}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{e}}
%EndExpansion
e\mathcal{A}\left(  \mathfrak{H}\right)  e,
\end{equation}
where
\begin{equation}%
%TCIMACRO{\dsum }%
%BeginExpansion
{\displaystyle\sum}
%EndExpansion
e=I,ef=0.
\end{equation}
Primitive idempotents produce irreducible representations.

\subsubsection{Operator Norm}%

\begin{equation}
\left\Vert A\right\Vert =\sup\limits_{\left\Vert x\right\Vert =1}\left(
\operatorname*{tr}\left\{  x^{\dagger}A^{\dagger}Ax\right\}  \right)
^{\frac{1}{2}}=\operatorname*{rad}\left(  \sigma\left(  A^{\dagger}A\right)
\right)  =\lim\limits_{n\rightarrow\infty}\left(  \operatorname*{tr}\left\{
\left(  A^{\dagger}A\right)  ^{n}\right\}  \right)  ^{\frac{1}{2n}}.
\end{equation}
Consider the self adjoint operator
\begin{equation}
X=i\sum_{1\leq j\leq r}x_{j}x_{j+r},
\end{equation}
which is unbounded when $r=\infty,$ but densly defined. One can express it in
diagonal form by noting
\begin{align}
x_{j}  &  =v_{j}+v_{j}^{\dagger}\nonumber\\
x_{j+r}  &  =-i\left(  v_{j}-v_{j}^{\dagger}\right) \\
v_{j}  &  =\frac{1}{2}\left(  x_{j}+ix_{j+r}\right) \\
v_{j}^{2}  &  =\frac{1}{4}\left(  x_{j}+ix_{j+r}\right)  \left(
x_{j}+ix_{j+r}\right)  =x_{j}^{2}+i\left(  x_{j+r}x_{j}+x_{j}x_{j+r}\right)
-x_{j+r}^{2}=0\\
v_{j}v_{j}^{\dagger}  &  =\frac{1}{4}\left(  x_{j}+ix_{j+r}\right)  \left(
x_{j}-ix_{j+r}\right)  =\frac{1}{4}\left(  x_{j}^{2}+x_{j+r}^{2}+i\left(
x_{j+r}x_{j}-x_{j}x_{j+r}\right)  \right)  =\frac{1}{2}I+\frac{1}{2}%
ix_{j+r}x_{j}\\
v_{j}^{\dagger}v_{j}  &  =\frac{1}{4}\left(  x_{j}-ix_{j+r}\right)  \left(
x_{j}+ix_{j+r}\right)  =\frac{1}{4}\left(  x_{j}^{2}+x_{j+r}^{2}+i\left(
x_{j}x_{j+r}-x_{j}x_{j+r}x_{j+r}x_{j}\right)  \right)  =\frac{1}{2}I-\frac
{1}{2}ix_{j+r}x_{j}\\
v_{j}^{\dagger}v_{j}+v_{j}v_{j}^{\dagger}  &  =I\\
v_{j}^{\dagger}v_{k}+v_{k}v_{j}^{\dagger}  &  =0
\end{align}
Then%
\begin{align}
&  X=\sum_{1\leq j\leq r}\left(  v_{j}+v_{j}^{\dagger}\right)  \left(
v_{j}-v_{j}^{\dagger}\right)  =\sum_{1\leq j\leq r}\left(  v_{j}^{2}%
-v_{j}v_{j}^{\dagger}+v_{j}^{\dagger}v_{j}-v_{j}^{^{\dagger}2}\right)
=\sum_{1\leq j\leq r}\left(  v_{j}^{\dagger}v_{j}-v_{j}v_{j}^{\dagger}\right)
=\sum_{1\leq j\leq r}\left(  v_{j}^{\dagger}v_{j}+w_{j}^{\dagger}w_{j}\right)
\\
&  \left[  v_{j}^{\dagger}v_{j},v_{k}v_{k}^{\dagger}\right]  =0\\
&  w_{j}=iv_{j}^{\dagger}=ix_{j}+x_{j+r}%
\end{align}%
\begin{equation}
X^{\dagger}X=-\sum_{1\leq j\neq k\leq r}x_{j+r}x_{j}x_{k}x_{k+r}-\sum_{1\leq
j\leq r}x_{j+r}x_{j}x_{j}x_{j+r}%
\end{equation}%
\begin{equation}
\left\langle \left\langle x_{j_{1}}\cdots x_{j_{p}}\left\vert \left(
i\sum_{1\leq j\leq r}x_{j}x_{j+r}\right)  \right.  x_{k_{1}}\cdots x_{k_{q}%
}\right\rangle \right\rangle
\end{equation}%
\begin{align}
\left\langle \left\langle I\left\vert \left(  i\sum_{1\leq j\leq r}%
x_{j}x_{j+r}\right)  \right.  I\right\rangle \right\rangle  &  =\left\langle
\left\langle i\sum_{1\leq j\leq r}x_{j}x_{j+r}\right\rangle \right\rangle
_{0}=0\\
\left\langle \left\langle A_{n}\left\vert \left(  i\sum_{1\leq j\leq r}%
x_{j}x_{j+r}\right)  \right.  I\right\rangle \right\rangle  &  =\left\langle
\left\langle A_{n}^{\dagger}i\sum_{1\leq j\leq r}x_{j}x_{j+r}\right\rangle
\right\rangle _{0}=0;n\neq2
\end{align}


\subsection{GNS Representation}

The normalized trace defines a tracial state $\omega$ i.e.
\begin{align}
\omega\left(  A\right)   &  =\operatorname*{tr}\left\{  A\right\} \\
\omega\left(  AB\right)   &  =\omega\left(  BA\right)  =\operatorname*{tr}%
\left\{  AB\right\}  =\operatorname*{tr}\left\{  BA\right\} \\
\omega\left(  ABC\right)   &  =\omega\left(  CAB\right)  =\omega\left(
BCA\right)  =\operatorname*{tr}\left\{  ABC\right\}  =\operatorname*{tr}%
\left\{  CAB\right\}  =\operatorname*{tr}\left\{  BCA\right\} \\
\omega\left(  I\right)   &  =\operatorname*{tr}\left\{  I\right\}  =1\\
\omega\left(  A^{\dagger}A\right)   &  =\operatorname*{tr}\left\{  A^{\dagger
}A\right\}  >0\\
\omega\left(  0\right)   &  =\operatorname*{tr}\left\{  0\right\}  =0.
\end{align}
The GNS Hilbert space is defined to be constituted by the equivalence classes
\begin{equation}
\Phi_{\omega}\left(  A\right)  =\left\{  \left.  A+\eta\right\vert
\omega\left(  \eta^{\dagger}\eta\right)  =0\right\}
\end{equation}
and has a hermitian inner product
\begin{equation}
\left\langle \left.  \Phi_{\omega}\left(  A\right)  \right\vert \Phi_{\omega
}\left(  B\right)  \right\rangle =\omega\left(  A^{\dagger}B\right)
=\operatorname*{tr}\left\{  A^{\dagger}B\right\}  .
\end{equation}
The zero vector is given by
\begin{equation}
0=\Phi_{\omega}\left(  \eta\right)  =\left\{  \left.  \eta\right\vert
\omega\left(  \eta^{\dagger}\eta\right)  =0\right\}  ,
\end{equation}
which in this case is zero element of $\mathcal{A}\left(  \mathfrak{H}\right)
$ as
\begin{equation}
\operatorname*{tr}\left\{  \eta^{\dagger}\eta\right\}  =0\Leftrightarrow
\eta=0.
\end{equation}


The GNS representation $\Pi_{\omega}$ is given by
\begin{equation}
\Pi_{\omega}\left(  A\right)  \Phi_{\omega}\left(  B\right)  =\Phi_{\omega
}\left(  AB\right)  ,
\end{equation}
which in this case is identical to the left regular representation $\Pi_{l}$
and the Hilbert space $\Phi_{\omega}\left(  \mathcal{A}\left(  \mathfrak{H}%
\right)  \right)  $ is $\mathcal{A}\left(  \mathfrak{H}\right)  _{Hil}.$

In order to accomodate the concept of state one needs to constrain the
c$^{\ast}$-algebras to be a w$^{\ast}$-algebras.

The Hilbert space $\mathfrak{H}$ can be decomposed as
\begin{equation}
\mathfrak{H=}%
%TCIMACRO{\dbigoplus _{n=1}^{\infty}}%
%BeginExpansion
{\displaystyle\bigoplus_{n=1}^{\infty}}
%EndExpansion
\mathfrak{M}_{n}.
\end{equation}
Let
\begin{equation}
T=\sum_{1\leq n\leq\infty}\lambda_{n}E_{n},
\end{equation}
where $\left\{  E_{n}\right\}  $ are the orthogonal projectors onto $\left\{
\mathfrak{M}_{n}\right\}  .$ A state $\omega$ is called a product state if
\begin{equation}
\omega\left(  XY\right)  =\omega\left(  X\right)  \omega\left(  Y\right)
\,\forall X\in\mathfrak{C}_{\mathfrak{M}_{n}},\forall Y\in\mathfrak{C}%
_{\mathfrak{M}_{m}},m\neq n.
\end{equation}
One can define a product state $\omega_{T}$ by
\begin{equation}
\omega_{T}\left(  v_{1},\cdots,v_{n};w_{1},\cdots,w_{m}\right)  =\omega
_{T}\left(  b\left(  v_{1}\right)  ^{\dagger}\cdots b\left(  v_{n}\right)
^{\dagger}b\left(  w_{1}\right)  \cdots b\left(  w_{m}\right)  \right)
=\det\left\{  \left\langle \left.  Tv_{j}\right\vert w_{k}\right\rangle
\right\}  \delta_{nm},
\end{equation}
where
\begin{equation}
I\geq T\geq0.
\end{equation}


\begin{itemize}
One can then form GNS\ representations $\Pi_{T}$ corresponding to

\item $T=0$ $\Rightarrow$ Fock Representation of the Clifford Algebra, which
is a Von Neumann-algebra type $I$ factor.

\item $T=\frac{1}{2}I\Rightarrow$ Pauli Representation of the Clifford
Algebra, which is a Von Neumann-algebra type $II_{1}$ factor.

\item $\frac{1}{2}I>T>0\Rightarrow$ Von Neumann type $III_{\lambda}$ factors,
where $\lambda=\frac{\mu}{1-\mu},$ $\frac{1}{2}\geq\mu\geq0$.

As the algebra is unique one can take the canonical infinite abstract
CAR\ algebra to be defined by
\end{itemize}

%

\begin{align}
\mathfrak{C}  &  =%
%TCIMACRO{\dbigotimes \limits_{N=0}^{N=\infty}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{N=0}^{N=\infty}}
%EndExpansion
M\left(  2,\mathbb{C}\right)  \equiv M\left(  2^{\infty},\mathbb{C}\right)
=\lim_{N\rightarrow\infty}%
%TCIMACRO{\dbigotimes \limits_{r=0}^{r=N}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{r=0}^{r=N}}
%EndExpansion
M\left(  2^{r},\mathbb{C}\right) \\
\mathfrak{H}  &  =\lim_{N\rightarrow\infty}%
%TCIMACRO{\dbigotimes \limits_{r=1}^{r=N}}%
%BeginExpansion
{\displaystyle\bigotimes\limits_{r=1}^{r=N}}
%EndExpansion
\mathbb{C}^{2},
\end{align}
where the limit is taken in the sense of Takesaki, \textit{Theory of Operator
Algebras III, }p91. (Different limits give different results for
$\mathfrak{H.)}$


