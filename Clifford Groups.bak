\section{Groups}

The commutator defines the \emph{Commutator Product}
\begin{equation}
A\times B=\frac{1}{2}\left[  A,B\right]  \,\forall A,B\in\mathcal{F}.
\end{equation}


\emph{Grade Involution} is defined as
\begin{equation}
\widehat{A_{k}}=\left(  -1\right)  ^{k}A_{k}.
\end{equation}


The \emph{Clifford }group action is defined as
\begin{align}
\vartheta\left[  A\right]   &  :\mathcal{F\longrightarrow F}\\
\vartheta\left[  A\right]  \left(  B\right)   &  =\widehat{A}BA^{-1}%
\end{align}
and the \emph{Clifford }group $\mathcal{CG}\left(  \mathcal{F}\right)  $ by
\begin{equation}
\left\{  \left.  A\right\vert \vartheta\left[  A\right]  :\mathcal{F}%
_{1}\mathcal{\longrightarrow F}_{1}\right\}  .
\end{equation}
$g\in\mathcal{CG}\left(  \mathcal{F}\right)  $ Iff it is a versor i.e.
\begin{equation}
g=v_{1}\cdots v_{k},v_{j}\in\mathcal{F}_{1}.
\end{equation}
The following important subgroups of the Clifford group are

\subsubsection{Pin}%

\begin{equation}
\operatorname*{Pin}\left(  \mathcal{F}\right)  =\left\{  \left.
A\in\mathcal{CG}\left(  \mathcal{F}\right)  \right\vert \left\Vert
A\right\Vert =1\right\}
\end{equation}


If $g\in\operatorname*{Pin}\left(  \mathcal{F}\right)  $ then it is a versor
i.e.
\begin{equation}
g=v_{1}\cdots v_{k},v_{j}\in\mathcal{F}_{1}.
\end{equation}


\subsubsection{Spin}%

\begin{equation}
\operatorname*{Spin}\left(  \mathcal{F}\right)  =\left\{  \left.
A\in\operatorname*{Pin}\left(  \mathcal{F}\right)  \right\vert A\in
\mathcal{F}_{even}\right\}
\end{equation}


The Pin group is a double cover of $O(2r),$ while the Spin group is a double
cover of $SO(2r).$

\subsection{Groups Generated by $\mathcal{F}_{2}$}

The Pin and Spin groups can be generated by \emph{real} geminal operators
$g\in\mathcal{F}_{2}$
\begin{align}
\widehat{u}\left(  g\right)   &  :\mathcal{F\longrightarrow F}\\
\widehat{u}\left(  g\right)   &  =e^{\widehat{g}}\\
\widehat{u}\left(  g\right)  \left(  A\right)   &  =e^{g}Ae^{-g}\\
\widehat{g}\left(  A\right)   &  =\left[  g,A\right] \\
e^{g}\left(  e^{g}\right)  ^{\dagger}  &  =\left(  e^{g}\right)  ^{\dagger
}e^{g}=I_{\mathcal{F}}\\
\left(  e^{g}\right)  ^{\dagger}  &  =e^{-g},
\end{align}


where
\begin{equation}%
%TCIMACRO{\tsum \limits_{1\leq j_{1}<j_{2}\leq2r}}%
%BeginExpansion
{\textstyle\sum\limits_{1\leq j_{1}<j_{2}\leq2r}}
%EndExpansion
\mathit{g}_{j_{1}j_{2}}x_{j_{1}}x_{j_{2}};\mathit{g}_{1j_{1}j_{2}}%
\in\mathbb{R}%
\end{equation}
i.e.
\begin{equation}
g=\left(  x_{1}x_{2},\cdots,x_{j_{1}}x_{j_{2}},\cdots,x_{2r-1}x_{2r}\right)
\mathit{g}=\left(  \mathbf{x}_{2}\right)  \mathit{g}=\left(  x_{1}x_{2}%
,\cdots,x_{j_{1}}x_{j_{2}},\cdots,x_{2r-1}x_{2r}\right)  \mathcal{R}%
_{\mathbf{x}_{2}}\left(  g\right)  ,g\in\mathcal{F}_{2}.
\end{equation}
The preceding expression is valid for any element of $\mathcal{F}$ i.e.
\begin{equation}
A=\left(  \mathbf{x}_{0},\mathbf{x}_{1},\cdots,\mathbf{x}_{2r}\right)
\mathit{A}=\left(  \mathbf{x}_{0},\mathbf{x}_{1},\cdots,\mathbf{x}%
_{2r}\right)  \mathcal{R}_{\mathbf{x}}\left(  A\right)  .
\end{equation}
The Pin group acts on $\mathcal{F}_{1}$ in the following manner
\begin{equation}
\widehat{u}\left(  g\right)  \left(  x_{k}\right)  =e^{g}x_{k}e^{-g}%
=\sum_{1\leq j\leq2r}x_{j}\left(  e^{\mathit{g}}\right)  _{jk}=\sum_{1\leq
j\leq2r}x_{j}\mathcal{R}_{\mathbf{x}_{1}}\left(  \widehat{u}\left(  g\right)
\right)  _{jk}=\widetilde{x}_{k},
\end{equation}
i.e.
\begin{equation}
\mathcal{R}_{\mathbf{x}_{1}}\left(  \widehat{u}\left(  g\right)  \right)
_{jk}=\left(  e^{\mathit{g}}\right)  _{jk},
\end{equation}
thus for $k_{1}<\cdots<k_{m}$ one has
\begin{align}
\widehat{u}\left(  g\right)  \left(  x_{k_{1}}\cdots x_{k_{m}}\right)    &
=\widehat{u}\left(  g\right)  \left(  x_{k_{1}}\wedge\cdots\wedge x_{k_{m}%
}\right)  =\widehat{u}\left(  g\right)  \left(  x_{k_{1}}\right)  \wedge
\cdots\wedge\widehat{u}\left(  g\right)  \left(  x_{k_{m}}\right)  \\
& =e^{g}x_{k_{1}}e^{-g}\wedge\cdots\wedge e^{g}x_{k_{m}}e^{-g}=e^{g}x_{k_{1}%
}e^{-g}e^{g}x_{k_{2}}e^{-g}\cdots e^{g}x_{k_{m-1}}e^{-g}e^{g}x_{k_{m}}%
e^{-g}\\
& =e^{g}x_{k_{1}}x_{k_{2}}\cdots x_{k_{m-1}}x_{k_{m}}e^{-g},
\end{align}
which extends its action to all of $\mathcal{F}=%
%TCIMACRO{\tbigwedge }%
%BeginExpansion
{\textstyle\bigwedge}
%EndExpansion
\mathcal{F}_{1}.$

The action of  $\widehat{u}\left(  g\right)  \in\mathcal{B}\left(
\mathcal{F}_{HS}\right)  $ can thus be expressed as
\begin{equation}
\widehat{u}\left(  g\right)  \left(  x_{k_{1}}\cdots x_{k_{m}}\right)
=\overset{\text{m times }}{\overbrace{\left(  \widehat{u}\left(  g\right)
\wedge\cdots\wedge\widehat{u}\left(  g\right)  \right)  }}x_{k_{1}}%
\wedge\cdots\wedge x_{k_{m}}=\sum_{1\leq j_{1}j_{2}<\cdots<j_{m}\leq
2r}x_{j_{1}}\wedge\cdots\wedge x_{j_{m}}\left(  \mathcal{R}_{\mathbf{x}_{1}%
}\left(  \widehat{u}\left(  g\right)  \right)  \wedge\cdots\wedge
\mathcal{R}_{\mathbf{x}_{1}}\left(  \widehat{u}\left(  g\right)  \right)
\right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{m}}%
\end{equation}
and we have the remarkable identity
\begin{equation}
e^{g}x_{k_{1}}x_{k_{2}}\cdots x_{k_{m-1}}x_{k_{m}}e^{-g}=\sum_{1\leq
j_{1}j_{2}<\cdots<j_{m}\leq2r}x_{j_{1}}\wedge\cdots\wedge x_{j_{m}}\left(
\left(  e^{\mathit{g}}\right)  \wedge\cdots\wedge\left(  e^{\mathit{g}%
}\right)  \right)  _{j_{1}\cdots j_{m}k_{1}\cdots k_{m}}.
\end{equation}
\begin{align}
\frac{d}{dt}\widehat{u}\left(  gt\right)  \left(  x_{k_{1}}\right)    &
=\frac{d}{dt}\left\{  e^{gt}x_{k_{1}}e^{-gt}\right\}  =\left(  \frac{d}%
{dt}e^{gt}\right)  x_{k_{1}}e^{-gt}+e^{gt}x_{k_{1}}\left(  \frac{d}{dt}%
e^{-gt}\right)  \\
& =ge^{gt}x_{k_{1}}e^{-gt}-e^{gt}x_{k_{1}}e^{-gt}g=\left[  g,x_{k_{1}}\left(
t\right)  \right]
\end{align}%
\begin{align}
\frac{d}{dt}\widehat{u}\left(  gt\right)  \left(  x_{k_{1}}x_{k_{2}}\right)
& =\left(  \frac{d}{dt}\left\{  e^{gt}x_{k_{1}}e^{-gt}\right\}  \right)
e^{gt}x_{k_{2}}e^{-gt}+e^{gt}x_{k_{1}}e^{-gt}\left(  \frac{d}{dt}\left\{
e^{gt}x_{k_{2}}e^{-gt}\right\}  \right)  \\
& =\left[  g,x_{k_{1}}\left(  t\right)  \right]  x_{k_{2}}\left(  t\right)
+x_{k_{1}}\left(  t\right)  \left[  g,x_{k_{2}}\left(  t\right)  \right]
\end{align}
If $g=x_{k_{1}}x_{k_{2}}$ then
\begin{align}
\left.  \frac{d}{dt}\widehat{u}\left(  gt\right)  \left(  x_{k_{1}}x_{k_{2}%
}\right)  \right\vert _{t=0}  & =\left[  x_{k_{1}}x_{k_{2}},x_{k_{1}}\right]
x_{k_{2}}+x_{k_{1}}\left[  x_{k_{1}}x_{k_{2}},x_{k_{2}}\right]  =x_{k_{1}%
}x_{k_{2}}x_{k_{1}}x_{k_{2}}-x_{k_{1}}x_{k_{1}}x_{k_{2}}x_{k_{2}}+x_{k_{1}%
}x_{k_{1}}x_{k_{2}}x_{k_{2}}-x_{k_{1}}x_{k_{2}}x_{k_{1}}x_{k_{2}}\\
& =-I_{\mathcal{F}}-I_{\mathcal{F}}+I_{\mathcal{F}}+I_{\mathcal{F}}=0.
\end{align}


\bigskip

$\lceil$%
\begin{equation}
u_{m}\left(  t\right)  \left\vert \varphi_{1}\wedge\cdots\wedge\varphi
_{m}\right\rangle =\left\vert u_{1}\left(  t\right)  \varphi_{1}\wedge
\cdots\wedge u_{1}\left(  t\right)  \varphi_{m}\right\rangle =u_{1}\left(
t\right)  \wedge\cdots\wedge u_{1}\left(  t\right)  \left\vert \varphi
_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle
\end{equation}%
\begin{align}
& \left.  \frac{d}{dt}u_{m}\left(  t\right)  \right\vert _{t=0}\left\vert
\varphi_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle =\left.  \left\vert
\frac{d}{dt}\left\{  u_{1}\left(  t\right)  \varphi_{1}\wedge\cdots\wedge
u_{1}\left(  t\right)  \right\}  \varphi_{m}\right\rangle \right\vert
_{t=0}\\
& =\left\vert \left.  \frac{d}{dt}u_{1}\left(  t\right)  \right\vert
_{t=0}\varphi_{1}\wedge\cdots\wedge u_{1}\left(  t\right)  \varphi
_{m}\right\rangle +\cdots+\left\vert \varphi_{1}\wedge\cdots\wedge\left.
\frac{d}{dt}u_{1}\left(  t\right)  \right\vert _{t=0}\varphi_{m}\right\rangle
\\
& =\left.  \frac{d}{dt}\left\{  u_{1}\left(  t\right)  \wedge\cdots\wedge
u_{1}\left(  t\right)  \right\}  \right\vert _{t=0}\left\vert \varphi
_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle
\end{align}
Thus
\begin{equation}
A_{m}\left\vert \varphi_{1}\wedge\cdots\wedge\varphi_{m}\right\rangle
=\left\vert A_{1}\varphi_{1}\wedge\cdots\wedge u_{1}\left(  t\right)
\varphi_{m}\right\rangle +\cdots+\left\vert \varphi_{1}\wedge\cdots\wedge
A_{1}\varphi_{m}\right\rangle ,
\end{equation}
where
\begin{align}
A_{m}  & =\left.  \frac{d}{dt}u_{m}\left(  t\right)  \right\vert _{t=0}\\
A_{1}  & =\left.  \frac{d}{dt}u_{1}\left(  t\right)  \right\vert _{t=0}.
\end{align}
