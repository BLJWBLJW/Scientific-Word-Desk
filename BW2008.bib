keywords = {HF calculations;nuclear structure theory;RPA calculations;SO groups;},
note = {Hartree-Fock-Bogoliubov;isospin-spin orbitals;coherent states;antisymmetrized geminal power;charge-projected coherent states;HFB coherent state;SO(2 r);random phase approximation;group theoretical approaches;time-dependent Hartree-Fock theory;},
