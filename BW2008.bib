volume = { 372},
number = { 6506},
year = {1994/12/08},
pages = {535 - 7},
issn = {0028-0836},
abstract = {The growth of many crystalline materials occurs through lateral propagation of steps over the surface. A stepped texture is also characteristic of diamond grown by chemical vapour deposition (CVD). Diffusion of atoms on the surface is usually held responsible for the stepped growth of metals, but it has been thought that the stronger bonding of adatoms should prevent this mechanism from operating in the case of diamond. Recent experiments have, however, indicated that surface diffusion can take place during diamond growth. We have recently shown theoretically that bridging methylene (CH<sub>2</sub>) groups on the {100} plane of diamond growing in the presence of hydrogen can migrate in a manner equivalent to surface diffusion. Here we show that this theoretical picture can be developed into an atomistic model that accounts for stepped growth of diamond. The stepped pattern can be understood in terms of the formation of surface-bound species from the gaseous precursors, followed by their migration by means of a series of surface chemical reactions involving covalent bond breaking and formation},
keywords = {chemical vapour deposition;diamond;surface chemistry;surface diffusion;surface texture;},
note = {stepped diamond growth;atomistic model;lateral propagation;stepped texture;CVD;stepped growth;surface diffusion;gaseous precursors;surface chemical reactions;covalent bond breaking;C;},
} 


