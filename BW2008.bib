@article{6664457 ,
language = {English},
copyright = {Copyright 2000, IEE},
title = {State energy functionals and variational equations in density functional theory},
journal = {THEOCHEM},
journal = {THEOCHEM (Netherlands)},
author = {Weiner, B. and Trickey, S.B.},
volume = { 501-502},
year = {1999/04/28},
pages = {65 - 83},
issn = {0166-1280},
abstract = {To resolve certain physical and mathematical problems in the customary Levy-Lieb constrained search formulation of Density Functional Theory (DFT), especially its spin-polarized form, we have presented elsewhere a reformulation of both time-independent and time-dependent DFT. The analysis is based on the full space-spin density and some of its implications are most accessible via expansions in terms of General Spin Orbitals (CTSOs). The approach defines universal energy functional on equivalence classes of N-fermion states labelled by those full space-spin densities via the constrained search technique. Here we apply theorems from constrained optimization theory to show that such a universal functional is well defined (not multi-valued) on paths of N-particle states as long as certain first and second derivative conditions are satisfied. These, we demonstrate, are equivalent to V-representability conditions. Two types of one-particle GSO equations are derived for the ground state density, one involving model states in the spirit of Kohn-Sham, the other not involving model states. The relationship between DFT based upon the space-spin density with the more common forms based on the spatial density alone is examined with respect to symmetry breaking solutions of the one-particle equations},
keywords = {density functional theory;optimisation;},
note = {state energy functionals;variational equations;density functional theory;Levy-Lieb constrained search formulation;spin-polarized form;space-spin density;expansions;general spin orbitals;universal energy functional;equivalence classes;N-fermion states;space-spin densities;constrained search technique;constrained optimization theory;universal functional;N-particle states;derivative conditions;V-representability conditions;ground state density;model states;symmetry breaking solutions;one-particle equations;},
URL = {http://dx.doi.org/10.1016/S0166-1280(99)00415-7},
} 


@article{4496108 ,
language = {English},
copyright = {Copyright 1993, IEE},
title = {Molecular dynamics with combined quantum and empirical potentials: C<sub>2</sub>H<sub>2</sub> adsorption on Si(100)},
journal = {Journal of Chemical Physics},
journal = {J. Chem. Phys. (USA)},
author = {Carmer, C.S. and Weiner, B. and Frenklach, M.},
volume = { 99},
number = { 2},
year = {1993/07/15},
pages = {1356 - 72},
issn = {0021-9606},
abstract = {Classical trajectory calculations were employed to study the reaction of acetylene with dimer sites on the Si(100) surface at 105 K. Two types of potential energy functions were combined to describe interactions for different regions of the model surface. A quantum mechanical potential based on the semiempirical AM1 Hamiltonian was used to describe interactions between C<sub>2</sub>H<sub>2</sub> and a portion of the silicon surface, while an empirically parametrized potential was developed to extend the size of the surface and simulate the dynamics of the surrounding silicon atoms. Reactions of acetylene approaching different sites were investigated, directly above a surface dimer, and between atoms from separate dimers. In all cases, the outcome of C<sub>2</sub>H<sub>2</sub> surface collisions was controlled by the amount of translational energy possessed by the incoming molecule. Acetylene molecules with high translational energy reacted with silicon dimers to form surface species with either one or two Si-C bonds. Those molecules with low translational energy either rebounded away from the surface or became trapped in a physisorbed state as evidenced by their bouncing motion above the surface. The reaction of C<sub>2</sub>H<sub>2</sub> to form a bridge between dimers within the same dimer row was found to occur, while bridging between adjacent dimer rows appeared to be unlikely, the C<sub>2</sub>H<sub>2</sub> molecule preferring to migrate to either of the dimers for direct reaction. A mechanism is proposed for chemisorption in which C<sub>2</sub>H<sub>2</sub> first bonds to a dimer site in a mono-&sigma; structure, subsequently attaining the more stable di-&sigma; bonded state through radical-radical recombination. The simulations are consistent with C<sub>2</sub>H<sub>2</sub> adsorption on Si(100) occurring through a mobile precursor mechanism},
keywords = {adsorption;chemisorption;molecular dynamics method;organic compounds;potential energy functions;silicon;},
note = {acetylene;molecular dynamics;classical trajectory calculations;empirical potentials;adsorption;reaction;dimer sites;Si(100);potential energy functions;quantum mechanical potential;semiempirical AM1 Hamiltonian;empirically parametrized potential;surface dimer;surface collisions;translational energy;Si-C bonds;physisorbed state;chemisorption;radical-radical recombination;105 K;Si;},
URL = {http://dx.doi.org/10.1063/1.465381},
} 


@article{4844551 ,
