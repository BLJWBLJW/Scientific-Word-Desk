\subsection{Types of Tensors}

\subsubsection{Rank 1 Tensors $\equiv $ vectors}

\begin{enumerate}
\item Contravariant 
\begin{equation}
v=t_{1}^{0}=\sum_{1\leq j\leq r}c^{j}e_{j}=\sum_{1\leq j\leq r}e_{j}\mathcal{%
R}_{e}\left( t_{1}^{0}\right) ^{j}=t_{1}=\left( \boldsymbol{e}\right) 
\mathcal{R}_{e}\left( t_{1}^{0}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( t_{0}^{1}\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( t_{0}^{1}\right) ^{r}%
\end{array}%
\right)
\end{equation}

\item Covariant 
\begin{eqnarray}
w_{d} &=&t_{0}^{1}=\sum_{1\leq j\leq r}c_{j}e_{b}^{j}=\sum_{1\leq j\leq r}%
\mathcal{R}_{e}\left( t_{0}^{1}\right) _{j}e_{b}^{j}=t^{1} \\
&=&\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}_{e_{d}}\left(
t_{1}^{0}\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( t_{1}^{0}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( t_{1}^{0}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( t_{1}^{0}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( t_{1}^{0}\right) _{r}%
\end{array}%
\right) \\
&=&\mathcal{R}_{e}\left( t_{1}^{0}\right) ^{t}\left( \boldsymbol{e}%
_{b}\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( t_{1}^{0}\right) _{1} & \cdots & \mathcal{R}_{e}\left(
t_{1}^{0}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( t_{1}^{0}\right) _{1} & \cdots & \mathcal{R}_{e}\left(
t_{1}^{0}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right)
\end{eqnarray}
\end{enumerate}

\subsubsection{Rank 2 Tensors}

\begin{enumerate}
\item Covariant $V^{d}\otimes V^{d}$ 
\begin{eqnarray}
b &=&t_{0}^{2}=\sum_{1\leq j,k\leq r}e^{j}\otimes e^{k}c_{jk}=\sum_{1\leq
j,k\leq r}e^{j}\otimes e^{k}\mathcal{R}_{e_{d}e_{d}}\left( t_{0}^{2}\right)
_{jk} \\
&=&\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( t_{0}^{2}\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right)
\end{eqnarray}

\item Contravaiant $V\otimes V$ 
\begin{eqnarray}
b_{d} &=&t_{2}^{0}=\sum_{1\leq j,k\leq r}e_{j}\otimes
e_{k}c^{jk}=\sum_{1\leq j,k\leq r}e_{j}\otimes e_{k}\mathcal{R}_{ee}\left(
t_{2}^{0}\right) ^{jk} \\
&=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( t_{0}^{2}\right) ^{11} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( t_{0}^{2}\right) ^{rr}%
\end{array}%
\right)
\end{eqnarray}

\item Mixed Contravaiant/Covariant $V\otimes V^{d}$ 
\begin{eqnarray}
A &=&t_{1}^{1}=\sum_{1\leq j,k\leq r}e_{j}\otimes e^{k}A_{k}^{j}=\sum_{1\leq
j,k\leq r}e_{j}\otimes e^{k}\mathcal{R}_{ee_{b}}\left( t_{1}^{1}\right)
_{k}^{j} \\
&=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{ee_{b}}\left( t_{1}^{1}\right) _{1}^{1} \\ 
\vdots \\ 
\mathcal{R}_{ee_{b}}\left( t_{1}^{1}\right) _{r}^{r}%
\end{array}%
\right) \longleftrightarrow \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{ee_{b}}\left( t_{1}^{1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{ee_{b}}\left( t_{1}^{1}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{ee_{b}}\left( t_{1}^{1}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{ee_{b}}\left( t_{1}^{1}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right)
\end{eqnarray}

\item Mixed Covariant/Contravaiant $V^{d}\otimes V$%
\begin{equation}
d\left( A\right) =\left( t_{d}\right) _{1}^{1}=\sum e^{j}\otimes
e_{k}A_{dj}^{k}=\sum_{1\leq j,k\leq r}e^{j}\otimes e_{k}\mathcal{R}%
_{e_{b}e}\left( \left( t_{d}\right) _{1}^{1}\right) _{j}^{k}
\end{equation}
\end{enumerate}

\subsection{Maps Transforming Tensor Types}

\subsubsection{Transfromation of Basis}

General bases transformations $S_{fe}\in GL\left( V\right) \subset \mathcal{L%
}\left( V\right) $ 
\begin{equation}
S_{fe}:V\rightarrow V
\end{equation}%
are given by 
\begin{gather}
S_{fe}\left( \boldsymbol{e}\right) ^{t}=\left( \boldsymbol{f}\right)
^{t}=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( S_{fe}\right) \\
\Updownarrow \\
S_{fe}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( S_{fe}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right)
\end{gather}%
and can be expressed in dyadic form as 
\begin{equation}
S_{fe}=\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] .
\end{equation}

\begin{remark}
\begin{enumerate}
\item The representation matrix $\mathcal{R}_{e}\left( S_{fe}\right) $ of $%
S_{fe}$ wrt to the $\boldsymbol{e}$-basis of $V$ is given b 
\begin{equation}
\mathcal{R}_{e}\left( S_{fe}\right) =\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( \left( \boldsymbol{f}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{b}\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) .
\end{equation}

\item The inverse transformation $S_{fe}^{-1}=S_{ef}$ has matrix
repsentation wrt the $\boldsymbol{e}$-basis of $V$ 
\begin{equation}
\mathcal{R}_{e}\left( S_{fe}^{-1}\right) =\mathcal{R}_{e}\left(
S_{fe}\right) ^{-1}=\mathcal{R}_{e}\left( S_{ef}\right) =\left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) ^{-1}.
\end{equation}
\end{enumerate}
\end{remark}

\subsubsection{Making Bases Biorthogonal}

Consider the bases $\left( \boldsymbol{f}_{d}\right) \,$ and $\left( 
\boldsymbol{e}\right) $ of $V^{d}$ and $V$ where

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
\left( \boldsymbol{e}\right) ^{t}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right)
\end{equation}

and

\item 
\begin{equation}
\left( \boldsymbol{f}_{d}\right) ^{t}=\left( 
\begin{array}{ccc}
f_{b1} & \cdots & f_{br}%
\end{array}%
\right) .
\end{equation}
\end{enumerate}

\item The overlap matrix between these bases is 
\begin{equation}
\left( \boldsymbol{f}_{d}\right) \left( \boldsymbol{e}\right) ^{t}=\left[
\left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) .
\end{equation}

\item By definitiion the inverse of the overlap matrix has the property 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}

\item One can construct a transforms the basis $\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) $ to a basis $\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) $ by 
\begin{gather}
\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}^{r}%
\end{array}%
\right) \right] \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1} & \cdots & f_{dr}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-t}
\end{gather}%
then

\item the basis $\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) $ is biorthogonal to the basis $\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) $ i.e. 
\begin{equation}
\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\mathbb{I}_{r},
\end{equation}%
as

\item 
\begin{equation}
\left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}%
and it follows that

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
f_{d1} \\ 
\vdots \\ 
f_{dr}^{r}%
\end{array}%
\right) \right] =I_{r}.
\end{equation}
\end{enumerate}

\begin{remark}
The biorthogonaliztion transformation matrix $\left( 
\begin{array}{ccc}
f_{d1}\left( e_{1}\right) & \cdots & f_{d1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f_{dr}\left( e_{1}\right) & \cdots & f_{dr}\left( e_{r}\right)%
\end{array}%
\right) ^{-1}$ is thus the matrix of the basis transformation 
\begin{equation}
S_{fe}:\boldsymbol{e}\rightarrow \boldsymbol{f.}
\end{equation}
\end{remark}

\subsubsection{Scalar Products}

We consider a dual vector $w_{d}$ to be expanded in terms of the basis $%
\left( \boldsymbol{f}_{b}\right) $ of $V^{d}$ and a vector $v$ expanded in
terms of the basis $\left( \boldsymbol{e}\right) $ of $V$ then

\begin{gather}
w_{d}\left( v\right) =\left( \mathcal{R}_{f_{b}}\left( w\right) \right)
^{t}\left( \boldsymbol{f}_{b}\right) ^{t}\left( \boldsymbol{e}\right) 
\mathcal{R}_{e}\left( v\right) \\
=\left( 
\begin{array}{ccc}
w_{1} & \cdots & w_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
w_{1} & \cdots & w_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
w_{1} & \cdots & w_{r}%
\end{array}%
\right) \mathbb{G}_{fe}\left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
w_{1} & \cdots & w_{r}%
\end{array}%
\right) \mathbb{S}_{fe}^{-1}\left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
w_{1} & \cdots & w_{r}%
\end{array}%
\right) \mathbb{S}_{ef}\left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) \\
=\sum_{1\leq j,k\leq r}w_{j}\left( S_{ef}\right) _{k}^{j}v^{k}=\sum_{1\leq
j,k\leq r}\left( S_{ef}\right) _{k}^{j}w_{j}v^{k}=\sum_{1\leq j,k\leq
r}\left( G_{fe}\right) _{k}^{j}w_{j}v^{k}
\end{gather}

\subsubsection{Traditional Tensor Expressions induced by change of basis of $%
V$ \label{3}\newline
}

\begin{enumerate}
\item Contravariant to contravariant change of basis $G_{fe}\in \mathcal{L}%
\left( V\right) $ 
\begin{equation}
G_{fe}=\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] :\left( \boldsymbol{e}\right) ^{t}\rightarrow \left( 
\boldsymbol{f}\right) ^{t}
\end{equation}

\begin{enumerate}
\item The coordinates of $w$ wrt the basis $\left( \boldsymbol{f}\right) $
of $V$ expanded in terms of the basis $\left( \boldsymbol{e}\right) $ of $V$
as 
\begin{equation}
\mathcal{R}_{f}\left( w\right) ^{j}=\sum_{1\leq k\leq r}\left( G_{fe}\right)
_{k}^{j}\mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq k\leq r}\left(
G_{fe}\right) _{k}^{j}e^{k}\left( v\right)
\end{equation}

\item The vector $w$ expanded wrt the bases $\left( \boldsymbol{f}\right) $
and $\left( \boldsymbol{e}\right) $ of $V$ 
\begin{equation}
w=\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( w\right) =\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{f}_{b}\right) \right]
\left( w\right) =G_{fe}\mathbf{e}_{b}\left( v\right) =\left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( G_{fe}\right) \mathcal{R}_{e}\left(
v\right)
\end{equation}

\item The basis $\left( \boldsymbol{f}\right) $ in terms of the basis $%
\left( \boldsymbol{e}\right) $ 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=G_{fe}\left( \boldsymbol{e}\right)
^{t}=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( G_{fe}\right)
\end{equation}

\item The overlap matrix between the bases $\left( \boldsymbol{f}\right) $
and $\left( \boldsymbol{e}\right) $ is defined as the matrix 
\begin{equation}
\left[ \left( \boldsymbol{e}_{b}\right) \right] \left( \boldsymbol{f}\right)
^{t}=\left[ \left( \boldsymbol{e}_{b}\right) \right] \left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( G_{fe}\right) =\mathcal{R}_{e}\left(
G_{fe}\right)
\end{equation}

\item The matrix of the basis transformation operator $\left( \boldsymbol{f}%
\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] $ wrt the basis $%
\left( \boldsymbol{e}\right) $ is $\left[ \left( \boldsymbol{e}_{b}\right) %
\right] \left( \boldsymbol{f}\right) ^{t}$ which is identical to the matrix
of the basis transformation operator $\left( \boldsymbol{f}\right) ^{t}\left[
\left( \boldsymbol{e}_{b}\right) \right] $ wrt the basis $\left( \boldsymbol{%
f}\right) $ as 
\begin{equation}
\left[ \left( \boldsymbol{e}_{b}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] }%
\right) \left( \boldsymbol{e}\right) ^{t}=\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{f}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\left[ \left( \boldsymbol{f}_{b}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] }%
\right) \left( \boldsymbol{f}\right) ^{t}=\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{f}\right) ^{t}.
\end{equation}
\end{enumerate}

\item Contravariant to covariant change of basis $G_{f_{b}e}\in \mathcal{L}%
\left( V^{d},V\right) $ 
\begin{equation}
G_{f_{b}e}=\left( \boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] :\left( \boldsymbol{e}\right) ^{t}\rightarrow \left( 
\boldsymbol{f}_{b}\right) ^{t}
\end{equation}

\begin{enumerate}
\item The coordinates of $w_{d}$ wrt the basis $\left( \boldsymbol{f}%
_{b}\right) $ of $V^{d}$ expanded in terms of the basis $\left( \boldsymbol{e%
}\right) $ of $V$ as%
\begin{equation}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{j}=\sum_{1\leq k\leq r}\left(
G_{f_{b}e}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq k\leq
r}\left( G_{f_{b}e}\right) _{jk}e^{k}\left( v\right)
\end{equation}

\item The vector $w_{d}$ expanded wrt the bases $\left( \boldsymbol{f}%
_{b}\right) $ of $V^{d}$ and the basis $\left( \boldsymbol{e}\right) $ of $V$%
\begin{equation}
w_{d}=\left( \boldsymbol{f}_{b}\right) ^{t}\mathcal{R}_{f_{b}}\left(
w_{d}\right) =\left( \left( \boldsymbol{f}_{b}\right) ^{t}\left[ \left( 
\boldsymbol{f}_{bb}\right) \right] \right) \left( w_{d}\right) =G_{f_{b}e}%
\mathbf{e}\left( v\right) =\left( \boldsymbol{f}_{b}\right) ^{t}\mathcal{R}%
_{f_{e}}\left( G_{f_{b}e}\right) \mathcal{R}_{e}\left( v\right)
\end{equation}

\item The basis $\left( \boldsymbol{f}_{b}\right) $ in terms of the basis $%
\left( \boldsymbol{e}\right) $ 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=\left( \left( \boldsymbol{f}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] \right)
\left( \boldsymbol{e}\right) ^{t}=\left( G_{f_{b}e}\right) \left( 
\boldsymbol{e}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e}\left( G_{f_{b}e}\right)
\end{equation}

\item The overlap matrix between the bases $\left( \boldsymbol{f}_{b}\right) 
$ and $\left( \boldsymbol{e}\right) $ is defined as the matrix 
\begin{equation}
\mathcal{R}_{e}\left( G_{f_{b}e}\right) =\left[ \left( \boldsymbol{f}%
_{b}\right) \right] \left( \boldsymbol{e}\right)
\end{equation}

\item The matrix of the basis transformation operator $\left( \boldsymbol{f}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] $ wrt the
basis $\left( \boldsymbol{e}\right) $ is $\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}$ which is
identical to the matrix of the basis transformation operator $\left( 
\boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right]
$ wrt the basis $\left( \boldsymbol{f}\right) $ as 
\begin{equation}
\left[ \left( \boldsymbol{e}_{bb}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right]
}\right) \left( \boldsymbol{e}\right) ^{t}=\left[ \left( \boldsymbol{e}%
_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\left[ \left( \boldsymbol{f}_{bb}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right]
}\right) \left( \boldsymbol{f}\right) ^{t}=\left[ \left( \boldsymbol{e}%
_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}.
\end{equation}
\end{enumerate}

\item Covariant to contravariant change of basis $G_{e_{bb}f_{b}}\in 
\mathcal{L}\left( V,V^{d}\right) $ where $V\hookrightarrow V^{dd}$ 
\begin{equation}
G_{e_{bb}f_{b}}=G_{ef_{b}}=\left( \boldsymbol{f}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{bb}\right) \right] :\left( \boldsymbol{e}_{b}\right)
^{t}\rightarrow \left( \boldsymbol{f}\right) ^{t}
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{f_{bb}}\left( x_{dd}\right) ^{j}=\sum_{1\leq k\leq r}\left(
G_{ef_{b}}\right) ^{jk}\mathcal{R}_{e_{bb}}\left( x_{dd}\right)
_{k}=\sum_{1\leq k\leq r}\mathcal{R}_{e_{bb}e_{b}}\left( G_{ef_{b}}\right)
^{jk}\mathcal{R}_{e}\left( v_{d}\right) _{k}
\end{equation}

\item 
\begin{equation}
x_{dd}=\left( \boldsymbol{f}_{bb}\right) ^{t}\mathcal{R}_{f_{bb}}\left(
x_{dd}\right) =\left( \boldsymbol{f}_{bb}\right) ^{t}\left[ \left( 
\boldsymbol{f}_{bbb}\right) \right] \left( w_{d}\right) =\left( \boldsymbol{f%
}_{bb}\right) ^{t}\left[ \left( \boldsymbol{f}_{b}\right) \right] \left(
w_{d}\right) =G_{ef_{b}}w_{d}\left( \boldsymbol{f}_{b}\right) =\left( 
\boldsymbol{f}\right) \mathcal{R}_{f}\left( G_{ef_{b}}\right) \mathcal{R}%
_{f_{b}}\left( w_{d}\right)
\end{equation}

\item The basis $\left( \boldsymbol{f}\right) $ in terms of the basis $%
\left( \boldsymbol{e}\right) $ 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=\left( \left( \boldsymbol{f}\right) ^{t}%
\left[ \left( \boldsymbol{e}_{bb}\right) \right] \right) \left( \boldsymbol{e%
}_{b}\right) ^{t}=\left( G_{ef_{b}}\right) \left( \boldsymbol{e}_{b}\right)
^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}_{e_{bb}e_{b}}\left(
G_{ef_{b}}\right)
\end{equation}

\item The overlap matrix between the bases $\left( \boldsymbol{f}_{b}\right) 
$ and $\left( \boldsymbol{e}\right) $ is defined as the matrix 
\begin{equation}
\mathcal{R}_{e_{bb}e_{b}}\left( G_{ef_{b}}\right) =\left( \boldsymbol{f}%
\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right]
\end{equation}

\item The matrix of the basis transformation operator $\left( \boldsymbol{f}%
\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right] $ wrt the basis 
$\left( \boldsymbol{e}\right) $ is $\left[ \left( \boldsymbol{e}_{b}\right) %
\right] \left( \boldsymbol{f}_{b}\right) ^{t}$ which is identical to the
matrix of the basis transformation operator $\left( \boldsymbol{f}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] $ wrt the
basis $\left( \boldsymbol{f}_{b}\right) $ as 
\begin{equation}
\left[ \left( \boldsymbol{e}_{bb}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right] }%
\right) \left( \boldsymbol{e}_{b}\right) ^{t}=\left[ \left( \boldsymbol{e}%
_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\left[ \left( \boldsymbol{f}_{bb}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right] }%
\right) \left( \boldsymbol{f}_{b}\right) ^{t}=\left[ \left( \boldsymbol{e}%
_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}.
\end{equation}
\end{enumerate}

\item Covariant to covariant change of basis $G_{e_{b}f_{b}}\in \mathcal{L}%
\left( V^{d}\right) $ 
\begin{equation}
G_{e_{b}f_{b}}=\left( \boldsymbol{f}_{b}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{bb}\right) \right] :\left( \boldsymbol{e}_{b}\right)
^{t}\rightarrow \left( \boldsymbol{f}_{b}\right) ^{t}
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
\mathcal{R}_{f}\left( y_{d}\right) _{j}=\sum_{1\leq k\leq r}\left(
G_{e_{b}f_{b}}\right) _{j}^{k}\mathcal{R}_{e}\left( w_{d}\right)
_{k}=\sum_{1\leq k\leq r}\mathcal{R}_{e_{b}}\left( G_{e_{b}f_{b}}\right)
_{j}^{k}\mathcal{R}_{e}\left( w_{d}\right) _{k}
\end{equation}

\item 
\begin{equation}
y_{d}=\left( \boldsymbol{f}_{bbb}\right) ^{t}\mathcal{R}_{f_{bb}}\left(
y_{d}\right) =\left( \boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{%
f}_{bb}\right) \right] \left( w_{d}\right) =G_{e_{b}f_{b}}w_{d}\left( 
\boldsymbol{f}_{b}\right) =\left( \boldsymbol{f}_{b}\right) ^{t}\mathcal{R}%
_{f_{b}}\left( G_{e_{b}f_{b}}\right) \mathcal{R}_{f_{b}}\left( w_{d}\right)
\end{equation}

\item The basis $\left( \boldsymbol{f}\right) $ in terms of the basis $%
\left( \boldsymbol{e}\right) $ 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=\left( \left( \boldsymbol{f}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right] \right)
\left( \boldsymbol{e}_{b}\right) ^{t}=\left( G_{e_{b}f_{b}}\right) \left( 
\boldsymbol{e}_{b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{%
R}_{e_{bb}e_{b}}\left( G_{e_{b}f_{b}}\right)
\end{equation}

\item The overlap matrix between the bases $\left( \boldsymbol{f}_{b}\right) 
$ and $\left( \boldsymbol{e}_{b}\right) $ is defined as the matrix 
\begin{equation}
\mathcal{R}_{f_{b}}\left( G_{e_{b}f_{b}}\right) =\left[ \left( \boldsymbol{e}%
_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}
\end{equation}

\item The matrix of the basis transformation operator $\left( \boldsymbol{f}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right] $ wrt the
basis $\left( \boldsymbol{e}_{b}\right) $ is $\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}$ which is
identical to the matrix of the basis transformation operator $\left( 
\boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right]
$ wrt the basis $\left( \boldsymbol{f}_{b}\right) $ as 
\begin{equation}
\left[ \left( \boldsymbol{e}_{bb}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) %
\right] }\right) \left( \boldsymbol{e}_{b}\right) ^{t}=\left[ \left( 
\boldsymbol{e}_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\left[ \left( \boldsymbol{f}_{bb}\right) \right] \left( \overset{}{\left( 
\boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) %
\right] }\right) \left( \boldsymbol{f}_{b}\right) ^{t}=\left[ \left( 
\boldsymbol{e}_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}.
\end{equation}
\end{enumerate}
\end{enumerate}

\subsubsection{Maps Transforming Rank 1 Tensors \label{Maps Transforming
Rank 1 Tensors}}

\begin{enumerate}
\item \emph{Contravariant to covariant transformations}

\begin{enumerate}
\item Tensors $t_{0}^{2}\in V^{d}\otimes V^{d}$ define bilinear forms $b\in 
\mathcal{BI}\left( V\right) $ defined on $V$ 
\begin{equation}
b:V\times V\rightarrow \mathbb{C}
\end{equation}%
by 
\begin{equation}
b\left( v_{1},v_{2}\right) =t_{0}^{2}\left( v_{1}\otimes v_{2}\right)
\end{equation}

\item these tensors $t_{0}^{2}\in V^{d}\otimes V^{d}$ can be expanded wrt a
bases $\left( \boldsymbol{f}_{b}\otimes \boldsymbol{f}_{b}\right) $ as%
\begin{gather}
t_{0}^{2}=\left( \boldsymbol{f}_{b}\otimes \boldsymbol{f}_{b}\right) ^{t}%
\mathcal{R}_{f_{d}f_{d}}\left( t_{0}^{2}\right) =\sum_{1\leq j,k\leq
r}\left( f^{j}\otimes f^{k}\right) \mathcal{R}_{f_{b}f_{b}}\left(
t_{0}^{2}\right) _{jk}=\left( 
\begin{array}{ccccc}
f^{1}\otimes f^{1} & \cdots & f^{j}\otimes f^{k} & \cdots & f^{r}\otimes
f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{jk} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right) \\
=\left( \overset{}{\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) }\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{jk} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right) ,
\end{gather}%
where 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{11} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{jk} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}f_{b}}\left( t_{0}^{2}\right) _{rr}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \overset{}{f_{bb1}\otimes f_{bb1}}\right) \left( \overset{}{t_{0}^{2}}%
\right) \\ 
\vdots \\ 
\left( \overset{}{f_{bbj}\otimes f_{bbk}}\right) \left( \overset{}{t_{0}^{2}}%
\right) \\ 
\vdots \\ 
\left( \overset{}{f_{bbr}\otimes f_{bbr}}\right) \left( \overset{}{t_{0}^{2}}%
\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
t_{0}^{2}\left( f_{1}\otimes f_{1}\right) \\ 
\vdots \\ 
t_{0}^{2}\left( f_{j}\otimes f_{k}\right) \\ 
\vdots \\ 
t_{0}^{2}\left( f_{r}\otimes f_{r}\right)%
\end{array}%
\right) .
\end{equation}%
This produces maps

\item $\left[ t_{0}^{2}\right] \in \mathcal{L}\left( V^{d},V\right) $ that
are contravariant to covariant transformations 
\begin{equation}
\left[ t_{0}^{2}\right] :V\rightarrow V^{d}
\end{equation}%
defined by%
\begin{equation}
f^{j}\left[ f^{k}\right] \left( e_{l}\right) =\left[ f^{j}\otimes f^{k}%
\right] \left( e_{l}\right) =\left( f^{j}\right) \left( f^{k}\left(
e_{l}\right) \right) ,\quad 1\leq j,k\leq r
\end{equation}%
giving the maps

\item 
\begin{equation}
\left[ t_{0}^{2}\right] =\boldsymbol{f}_{d}\left[ \boldsymbol{f}_{d}\right] 
\mathcal{R}_{f_{d}f_{d}}\left( \left[ t_{0}^{2}\right] \right) =\sum_{1\leq
j,k\leq r}f^{j}\left[ f^{k}\right] \mathcal{R}_{f_{d}f_{d}}\left( \left[
t_{0}^{2}\right] \right) _{jk}
\end{equation}%
that produce dual functionals $v_{d}=\left[ t_{0}^{2}\right] \left( v\right)
\in V^{d}$ that are covariant and are the images of contravariant vectors $v$
and have the action

\begin{enumerate}
\item the image covariant vector $v_{d}$ can be expressed as 
\begin{equation}
v_{d}=\left[ t_{0}^{2}\right] \left( v\right) =b\left( \cdot ,v\right) ,
\end{equation}%
and have a detailed expansion

\item 
\begin{eqnarray}
v_{d} &=&\left[ t_{0}^{2}\right] \left( v\right) =b\left( \cdot ,v\right)
=\left( \boldsymbol{f}_{b}\overset{}{\left[ \boldsymbol{f}_{b}\right] 
\mathcal{R}_{f_{b}f_{b}}\left( \left[ b\right] \right) }\right) \left( 
\overset{}{v}\right) =\left( \sum_{1\leq j,k\leq r}f^{j}\left[ f^{k}\right] 
\mathcal{R}_{f_{b}f_{b}}\left( \left[ b\right] \right) _{jk}\right) \left(
\sum_{1\leq l\leq r}f_{l}\mathcal{R}_{f}\left( v\right) ^{l}\right) \\
&=&\sum_{1\leq j\leq r}f^{j}\left( \sum_{1\leq k,l\leq r}f^{k}\left(
f_{l}\right) \mathcal{R}_{f_{b}f_{b}}\left( \left[ b\right] \right) _{jk}%
\mathcal{R}_{f}\left( v\right) ^{l}\right) =\sum_{1\leq j\leq r}f^{j}\left(
\sum_{1\leq k,l\leq r}\delta _{l}^{k}\mathcal{R}_{f_{b}f_{b}}\left( \left[ b%
\right] \right) _{jk}\mathcal{R}_{f}\left( v\right) ^{l}\right) \\
&=&\sum_{1\leq j,k\leq r}f^{j}\left( \mathcal{R}_{f_{b}f_{b}}\left( \left[ b%
\right] \right) _{jk}\mathcal{R}_{f}\left( v\right) ^{k}\right) =\sum_{1\leq
j\leq r}f^{j}\left( \sum_{1\leq k\leq r}\mathcal{R}_{f_{b}f_{b}}\left( \left[
b\right] \right) _{jk}\mathcal{R}_{f}\left( v\right) ^{k}\right)
=\sum_{1\leq j\leq r}f^{j}\mathcal{R}_{f_{d}}\left( \overset{}{\left[ b%
\right] \left( v\right) }\right) _{j},
\end{eqnarray}

\item where 
\begin{equation}
\left( \mathcal{R}_{f_{b}}\left( \left[ b\right] \right) \left( \overset{}{%
\mathcal{R}_{f_{b}}\left( v\right) }\right) \right) _{j}=\sum_{1\leq k\leq r}%
\mathcal{R}_{f_{b}f_{b}}\left( \left[ b\right] \right) _{jk}\mathcal{R}%
_{f}\left( v\right) ^{k}=\left( \overset{}{\mathcal{R}_{f_{b}}\left( \left[ b%
\right] v\right) }\right) _{j}.
\end{equation}

\item The coordinate transformation 
\begin{equation}
\mathcal{R}_{e}\left( v\right) ^{j}\rightarrow \mathcal{R}_{f_{b}}\left(
v_{d}\right) _{j}=\sum_{1\leq k\leq r}\mathcal{R}_{f_{b}f_{b}}\left(
b\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq k\leq r}\left(
S_{fe}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}
\end{equation}%
is produced by the matrix 
\begin{equation}
\left( S_{fe}\right) _{jk}=\mathcal{R}_{f_{b}f_{b}}\left( b_{d}\right) _{jk}
\end{equation}

\item If one expands $v$ wrt the bases $\left( \boldsymbol{e}\right) $ one
obtains a more general expression of the conversion of contravariant
coordinates to covariant coordinates as 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) _{j}=\sum_{1\leq j\leq r}f_{jb}\left(
e_{k}\right) \mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq j\leq r}\left(
S_{fe}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}.
\end{equation}

\item \label{09/22/1}%
\begin{eqnarray}
\left( \boldsymbol{f}_{b}\right) ^{t}\left[ \left( \boldsymbol{f}_{b}\right) %
\right] \left( v\right) &=&\left( \boldsymbol{f}_{b}\right) ^{t}\left[
\left( \boldsymbol{f}_{b}\right) \right] \left( \overset{}{\boldsymbol{e}_{b}%
}\right) ^{t}\left[ \left( \overset{}{\boldsymbol{e}_{b}}\right) \right]
\left( \overset{}{v}\right) \\
&=&\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \left( \overset{}{v}\right)
\end{eqnarray}%
i.e.%
\begin{gather}
\mathcal{R}_{f_{b}}\left( v_{d}\right) _{j}=\sum_{1\leq k\leq r}S_{fejk}%
\mathcal{R}_{e}\left( v\right) ^{k} \\
\parallel \\
f_{bbj}\left( v_{d}\right) =\sum_{1\leq k\leq r}S_{fejk}e^{k}\left( v\right)
\\
\parallel \\
f_{bbj}\left( v_{d}\right) =\sum_{1\leq k\leq r}\left[ f^{j}e^{k}\right]
\left( v\right) =\sum_{1\leq k\leq r}f^{j}e^{k}\left( v\right) =\sum_{1\leq
k\leq r}\left( S_{fe}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}.
\end{gather}

\item In terms of the metric tensor representation matrix $S_{fe}$ 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) _{j}=\sum_{1\leq j\leq r}f_{bj}\left(
e_{k}\right) \mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq j\leq r}\left(
S_{fe}\right) _{jk}\mathcal{R}_{e}\left( v\right) ^{k}.
\end{equation}

\item 
\begin{equation}
h_{d}\in V^{d},\,v\in V,\quad \left[ t_{0}^{2}\right] \equiv b_{d}\in
\otimes ^{2}V^{d}.
\end{equation}
\end{enumerate}
\end{enumerate}

\item \emph{Contravariant to contravariant maps}

\begin{enumerate}
\item Tensors $t_{1}^{1}\in V\otimes V^{d}$ define bilinear forms $b\in 
\mathcal{BI}\left( V,V^{d}\right) $ defined on $V^{d}\otimes V$ 
\begin{equation}
b:V\otimes V^{d}\rightarrow \mathbb{C}
\end{equation}%
by 
\begin{equation}
b\left( v_{1},v_{d2}\right) =t_{1}^{1}\left( v_{1}\otimes v_{d2}\right)
\end{equation}

\item these tensors $t_{1}^{1}\in V\otimes V^{d}$ can be expanded wrt a
bases $\left( \boldsymbol{f}\otimes \boldsymbol{f}_{b}\right) $ as%
\begin{gather}
t_{1}^{1}\in V\otimes V^{d}=\left( \boldsymbol{f}\otimes \boldsymbol{f}%
_{b}\right) ^{t}\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) =\sum_{1\leq
j,k\leq r}\left( f_{j}\otimes f^{k}\right) \mathcal{R}_{ff_{b}}\left(
t_{1}^{1}\right) t_{k}^{j}=\left( 
\begin{array}{ccccc}
f_{1}\otimes f^{1} & \cdots & f_{j}\otimes f^{k} & \cdots & fk\otimes f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{1}^{1} \\ 
\vdots \\ 
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{k}^{j} \\ 
\vdots \\ 
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{r}^{r}%
\end{array}%
\right) \\
=\left( \overset{}{\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \otimes \left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) }\right) \left( 
\begin{array}{c}
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{1}^{1} \\ 
\vdots \\ 
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{k}^{j} \\ 
\vdots \\ 
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{r}^{r}%
\end{array}%
\right) ,
\end{gather}%
where 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{1}^{1} \\ 
\vdots \\ 
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{k}^{j} \\ 
\vdots \\ 
\mathcal{R}_{ff_{b}}\left( t_{1}^{1}\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \overset{}{f_{b1}\otimes f_{1}}\right) \left( \overset{}{t_{1}^{1}}%
\right) \\ 
\vdots \\ 
\left( \overset{}{f_{bj}\otimes f_{k}}\right) \left( \overset{}{t_{1}^{1}}%
\right) \\ 
\vdots \\ 
\left( \overset{}{f_{br}\otimes f_{r}}\right) \left( \overset{}{t_{1}^{1}}%
\right)%
\end{array}%
\right) =\left( 
\begin{array}{c}
t_{1}^{1}\left( f^{1}\otimes f_{1}\right) \\ 
\vdots \\ 
t_{1}^{1}\left( f^{j}\otimes f_{k}\right) \\ 
\vdots \\ 
t_{1}^{1}\left( f^{r}\otimes f_{r}\right)%
\end{array}%
\right) .
\end{equation}

\item This produce the maps \label{09/22} 
\begin{equation}
\left[ t_{1}^{1}\right] :V\rightarrow V
\end{equation}%
defined by 
\begin{equation}
\left[ t_{1}^{1}\right] =\boldsymbol{e}\left[ \boldsymbol{e}_{b}\right] 
\mathcal{R}_{ee_{b}}\left( \left[ t_{1}^{1}\right] \right)
\end{equation}%
that transform contravariant to contravariant tensors%
\begin{eqnarray}
w &=&\left[ t_{1}^{1}\right] \left( v\right) =A\left( v\right) =\sum_{1\leq
j,k\leq r}e_{j}\left[ e^{k}\right] \mathcal{R}_{ee_{d}}\left( A\right)
_{k}^{j}\left( \sum_{1\leq l\leq r}e_{l}\mathcal{R}_{e}\left( v\right)
^{l}\right) \\
&=&\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}e^{k}\left( e_{l}\right) 
\mathcal{R}_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left( v\right)
^{l}=\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}\delta _{l}^{k}\mathcal{R%
}_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left( v\right) ^{l} \\
&=&\sum_{1\leq j,k\leq r}e_{j}\mathcal{R}_{ee_{d}}\left( A\right) _{k}^{j}%
\mathcal{R}_{e}\left( v\right) ^{k}=\sum_{1\leq j\leq r}e^{j}\sum_{1\leq
k\leq r}\mathcal{R}_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left(
v\right) ^{k}=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( \overset{}{%
A\left( v\right) }\right) ^{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{ee_{d}}\left( A\right) \mathcal{R}%
_{e_{d}}\left( v\right) }\right) ^{j}=\sum_{1\leq k\leq r}\mathcal{R}%
_{ee_{d}}\left( A\right) _{k}^{j}\mathcal{R}_{e}\left( v\right) ^{k}=\left( 
\overset{}{\mathcal{R}_{e}\left( Av\right) }\right) ^{j}.
\end{equation}

\item 
\begin{eqnarray}
\left( \overset{}{\boldsymbol{f}}\right) ^{t}\left[ \left( \overset{}{%
\boldsymbol{f}_{b}}\right) \right] \left( v\right) &=&\left( \overset{}{%
\boldsymbol{f}}\right) ^{t}\left[ \left( \overset{}{\boldsymbol{f}_{b}}%
\right) \right] \left( \overset{}{\boldsymbol{e}}\right) ^{t}\left[ \left( 
\overset{}{\boldsymbol{e}_{b}}\right) \right] \left( \overset{}{v}\right) \\
&=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \left( \overset{}{v}\right) .
\end{eqnarray}

\item One can inject tensors $t_{1}^{1}$ into nuclear operators belonging to 
$\mathcal{L}_{\text{nuclear}}\left( V\right) $ 
\begin{equation}
w\in V,\quad \left[ t_{1}^{1}\right] \equiv A\in V\otimes
V^{d}\hookrightarrow \mathcal{L}_{\text{nuclear}}\left( V\right) .
\end{equation}
\end{enumerate}

\item \emph{Covariant to contravariant transformations}

\begin{enumerate}
\item The maps 
\begin{equation}
\left[ t_{2}^{0}\right] :V^{d}\rightarrow V
\end{equation}%
defined by 
\begin{equation}
\left[ t_{2}^{0}\right] =\left[ \boldsymbol{ee}\right] \mathcal{R}%
_{ee}\left( \left[ t_{2}^{0}\right] \right)
\end{equation}%
produce covariant to contravariant transformations 
\begin{eqnarray}
w &=&\left[ t_{2}^{0}\right] \left( h_{d}\right) =b\left( ,h_{d}\right)
=\sum_{1\leq j,k\leq r}\left[ e_{j}e_{k}\right] \mathcal{R}_{ee}\left(
h_{d}\right) ^{jk}\left( \sum_{1\leq l\leq r}e_{dl}\mathcal{R}_{e_{d}}\left(
h_{d}\right) _{l}\right) \\
&=&\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}e_{k}\left( e^{l}\right) 
\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}\mathcal{R}_{e}\left( v_{d}\right)
_{l}=\sum_{1\leq j\leq r}e_{j}\sum_{1\leq k,l\leq r}\delta _{k}^{l}\mathcal{R%
}_{ee}\left( h_{d}\right) ^{jk}\mathcal{R}_{e_{d}}\left( h_{d}\right) _{l} \\
&=&\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}%
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{l}=\sum_{1\leq j\leq
r}e_{j}\sum_{1\leq k\leq r}\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}\mathcal{%
R}_{e_{d}}\left( v_{d}\right) _{l}=\sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( \overset{}{\left[ h_{d}\right] \left( v_{d}\right) }\right) ^{j},
\end{eqnarray}%
recall%
\begin{eqnarray}
h_{d} &=&\left[ t_{0}^{2}\right] \left( v\right) =b\left( \cdot ,v\right)
=\sum_{1\leq j,k\leq r}\left[ e^{j}e^{k}\right] \mathcal{R}%
_{e_{b}e_{b}}\left( b\right) _{jk}\left( \sum_{1\leq l\leq r}e_{l}\mathcal{R}%
_{e}\left( v\right) ^{l}\right) \\
&=&\sum_{1\leq j\leq r}e^{j}\left( \sum_{1\leq k,l\leq r}e^{k}\left(
e_{l}\right) \mathcal{R}_{e_{b}e_{b}}\left( b\right) _{jk}\mathcal{R}%
_{e}\left( v\right) ^{l}\right) =\sum_{1\leq j\leq r}e^{j}\left( \sum_{1\leq
k,l\leq r}\delta _{l}^{k}\mathcal{R}_{e_{b}e_{b}}\left( b\right) _{jk}%
\mathcal{R}_{e}\left( v\right) ^{l}\right) \\
&=&\sum_{1\leq j,k\leq r}e^{j}\left( \mathcal{R}_{e_{b}e_{b}}\left( b\right)
_{jk}\mathcal{R}_{e}\left( v\right) ^{k}\right) =\sum_{1\leq j\leq
r}e^{j}\left( \sum_{1\leq k\leq r}\mathcal{R}_{e_{b}e_{b}}\left( b\right)
_{jk}\mathcal{R}_{e}\left( v\right) ^{k}\right) =\sum_{1\leq j\leq r}e^{j}%
\mathcal{R}_{e_{b}}\left( \overset{}{\left[ b\right] \left( v\right) }%
\right) _{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{e_{b}}\left( \left[ h_{d}\right] \right) 
\mathcal{R}_{e_{b}}\left( v_{d}\right) }\right) ^{j}=\sum_{1\leq k\leq r}%
\mathcal{R}_{ee}\left( h_{d}\right) ^{jk}\mathcal{R}_{e_{b}}\left(
v_{d}\right) _{k}=\left( \mathcal{R}_{e_{b}}\left( \overset{}{\left[ h_{d}%
\right] v_{d}}\right) \right) ^{j}
\end{equation}

\begin{remark}
\begin{equation}
w\in V,\,h_{d}\in V^{d},\quad \left[ t_{2}^{0}\right] \equiv b\in \otimes
^{2}V.
\end{equation}
\end{remark}

\item \emph{Covariant to covariant transformations}

The maps 
\begin{equation}
\left[ \left( t_{d}\right) _{1}^{1}\right] =\left[ \boldsymbol{e}_{d}%
\boldsymbol{e}\right] \mathcal{R}_{e_{d}e}\left( \left[ \left( t_{d}\right)
_{1}^{1}\right] \right)
\end{equation}%
produce covariant to covariant transformations 
\begin{eqnarray}
w_{d} &=&\left[ \left( t_{d}\right) _{1}^{1}\right] \left( v_{d}\right)
=d\left( A\right) \left( v_{d}\right) =\sum_{1\leq j,k\leq r}\left[
e^{j}e_{k}\right] \mathcal{R}_{e_{b}e}\left( d\left( A\right) \right)
_{j}^{k}\left( \sum_{1\leq l\leq r}e^{l}\mathcal{R}_{e_{d}}\left(
v_{d}\right) _{l}\right) \\
&=&\sum_{1\leq j\leq r}e^{j}\sum_{1\leq k,l\leq r}e_{k}\left( e^{l}\right) 
\mathcal{R}_{e_{d}e}\left( d\left( A\right) \right) _{j}^{k}\mathcal{R}%
_{e_{b}}\left( v_{d}\right) _{l}=\sum_{1\leq j\leq r}e^{j}\sum_{1\leq
k,l\leq r}\delta _{k}^{l}\mathcal{R}_{e_{b}e}\left( d\left( A\right) \right)
_{j}^{k}\mathcal{R}_{e_{b}}\left( v_{d}\right) _{l} \\
&=&\sum_{1\leq j\leq r}e^{j}\mathcal{R}_{e_{b}e}\left( d\left( A\right)
\right) _{j}^{k}\mathcal{R}_{e_{b}}\left( v_{d}\right) _{k}=\sum_{1\leq
j\leq r}e^{j}\sum_{1\leq k\leq r}\mathcal{R}_{e_{b}e}\left( d\left( A\right)
\right) _{j}^{k}\mathcal{R}_{eb}\left( v_{d}\right) _{k}=\sum_{1\leq j\leq
r}e^{j}\mathcal{R}_{e_{b}}\left( \overset{}{\left[ d\left( A\right) \right]
\left( v\right) }\right) _{j},
\end{eqnarray}%
where 
\begin{equation}
\left( \overset{}{\mathcal{R}_{e_{b}}\left( \left[ d\left( A\right) \right]
\right) \mathcal{R}_{e_{d}}\left( v_{d}\right) }\right) _{j}=\sum_{1\leq
k\leq r}\mathcal{R}_{e_{b}e}\left( d\left( A\right) \right) _{j}^{k}\mathcal{%
R}_{e_{d}}\left( v_{d}\right) _{k}=\left( \mathcal{R}_{e_{b}}\left( \left[ 
\overset{}{d\left( A\right) v_{d}}\right] \right) \right) _{j}
\end{equation}
\end{enumerate}
\end{enumerate}

\subsubsection{Types of Rank 2 Tensors \label{Types of Rank 2 Tensors}}

\begin{enumerate}
\item Second rank covaraint tensors (bilinear forms on $V)$ 
\begin{equation}
t_{0}^{2}=\sum_{1\leq j,k\leq r}c_{jk}e^{j}\otimes e^{k}=\sum_{1\leq j,k\leq
r}e^{j}\otimes e^{k}\mathcal{R}_{e_{d}e_{d}}\left( t_{0}^{2}\right) _{jk}.
\end{equation}

\item Second rank contravaraint tensors%
\begin{equation}
t_{2}^{0}=\sum_{1\leq j,k\leq r}c^{jk}e_{j}\otimes e_{k}=\sum_{1\leq j,k\leq
r}e_{j}\otimes e_{k}\mathcal{R}_{ee}\left( t_{2}^{0}\right) ^{jk}.
\end{equation}

\item Second rank mixed contravariant-covariant tensors%
\begin{equation*}
t_{1}^{1}=\sum_{1\leq j,k\leq r}c_{k}^{j}e_{j}\otimes e^{k}=\sum_{1\leq
j,k\leq r}c_{k}^{j}e_{j}\otimes e^{k}\mathcal{R}_{ee_{d}}\left(
t_{1}^{1}\right) _{k}^{j}.
\end{equation*}

\item Second rank covariant-contravariant tensors%
\begin{equation}
\left( t_{d}\right) _{1}^{1}=\sum c_{j}^{k}e^{j}\otimes e_{k}=\sum_{1\leq
j,k\leq r}c_{k}^{j}e^{j}\otimes e_{k}\mathcal{R}_{e_{d}e}\left( \left(
t_{d}\right) _{1}^{1}\right) _{j}^{k}.
\end{equation}
\end{enumerate}

\subsection{Change of Tensor Type}

\begin{enumerate}
\item Rank $1$ spaces%
\begin{gather}
\left( \boldsymbol{f}\right) \left[ \left( \mathbf{e}_{b}\right) ^{t}\right]
\left( \mathbf{e}\right) =\left( \mathbf{e}_{b}\right) \left( \boldsymbol{f}%
\right) \\
\left( \mathbf{e}_{b}\right) \left( \boldsymbol{f}\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{gather}

\begin{enumerate}
\item 
\begin{gather}
\left( \boldsymbol{f}\right) \left[ \left( \mathbf{e}_{b}\right) ^{t}\right]
:V\rightarrow V \\
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( v\right) =w \\
=\sum f_{j}\left[ e^{j}\right] \left( v\right) =\sum f_{j}\mathcal{R}%
_{e}\left( v\right) _{j}
\end{gather}

\item 
\begin{gather}
\left( \boldsymbol{f}_{b}\right) \left[ \left( \mathbf{e}_{b}\right) ^{t}%
\right] :V\rightarrow V^{d} \\
\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( v\right) =w_{d}
\end{gather}

