\begin{remark}
In general%
\begin{equation}
\left\vert \boldsymbol{b}\right\rangle =\left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right)
\left\vert \boldsymbol{f}\right\rangle =\left\vert \boldsymbol{f}%
\right\rangle \mathcal{R}_{f}\left( u_{fe}\right) =\left\vert \boldsymbol{f}%
\right\rangle \left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}%
\right\rangle =\left\vert \boldsymbol{e}\right\rangle \left\langle \left. 
\boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle \left\langle \left. 
\boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle =\left\vert 
\boldsymbol{e}\right\rangle \left\langle \left. \boldsymbol{e}\right\vert 
\boldsymbol{f}\right\rangle ^{2}=\left\vert \boldsymbol{e}\right\rangle 
\mathcal{R}_{e}\left( u_{fe}\right) ^{2}
\end{equation}%
in his case 
\begin{equation}
\left\vert \boldsymbol{b}\right\rangle =-\left\vert \boldsymbol{e}%
\right\rangle .
\end{equation}
\end{remark}

\begin{remark}
The representations of $u_{fe}$ on the bases $\left\vert \boldsymbol{e}%
\right\rangle $ and $\left\vert \boldsymbol{f}\right\rangle $ are
\end{remark}

\begin{enumerate}
\item The bases are conbs thus the matrices of the transformations wrt these
bases are the equal to the representation matrices showing that 
\begin{eqnarray}
\mathcal{M}_{e}\left( u_{fe}\right) &=&\mathcal{R}_{e}\left( u_{fe}\right)
=\left\langle \boldsymbol{e}\right\vert \left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert \left\vert \boldsymbol{e%
}\right\rangle =\left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}%
\right\rangle \\
\mathcal{M}_{f}\left( u_{fe}\right) &=&\mathcal{R}_{f}\left( u_{fe}\right)
=\left\langle \boldsymbol{f}\right\vert \left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert \left\vert \boldsymbol{f%
}\right\rangle =\left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}%
\right\rangle
\end{eqnarray}

and 
\begin{eqnarray}
\mathcal{M}_{e}\left( u_{fe}^{\dagger }\right) &=&\mathcal{R}_{e}\left(
u_{fe}^{\dagger }\right) =\left\langle \boldsymbol{e}\right\vert \left\vert 
\boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}\right\vert
\left\vert \boldsymbol{e}\right\rangle =\left\langle \left. \boldsymbol{f}%
\right\vert \boldsymbol{e}\right\rangle \\
\mathcal{M}_{f}\left( u_{fe}^{\dagger }\right) &=&\mathcal{R}_{f}\left(
u_{fe}^{\dagger }\right) =\left\langle \boldsymbol{f}\right\vert \left\vert 
\boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}\right\vert
\left\vert \boldsymbol{f}\right\rangle =\left\langle \left. \boldsymbol{f}%
\right\vert \boldsymbol{e}\right\rangle .
\end{eqnarray}

\item This unitary operator $u_{fe}$ has the properties%
\begin{equation}
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert =\left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left(
u_{fe}\right) \left\langle \boldsymbol{e}\right\vert =\left\vert \boldsymbol{%
e}\right\rangle \left\langle \left. \overset{}{\boldsymbol{e}}\right\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert
\end{equation}%
and 
\begin{equation}
\left( \left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert \right) ^{2}=\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert \left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert =\left\vert \boldsymbol{e}%
\right\rangle \mathcal{R}_{e}\left( u_{fe}\right) ^{2}\left\langle 
\boldsymbol{e}\right\vert =\left\vert \boldsymbol{f}\right\rangle
\left\langle \left. \overset{}{\boldsymbol{e}}\right\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert
\end{equation}%
so 
\begin{equation}
\left( \left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert \right) ^{2}\neq \left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert .
\end{equation}

\item 
\begin{eqnarray}
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \boldsymbol{f}\right\rangle
&=&\left\vert \boldsymbol{f}\right\rangle \mathcal{R}_{f}\left(
u_{fe}\right) =\left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left(
u_{fe}\right) \mathcal{R}_{f}\left( u_{fe}\right) =\left\vert \boldsymbol{e}%
\right\rangle \mathcal{R}_{e}\left( u_{fe}\right) ^{2} \\
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \boldsymbol{f}\right\rangle
&=&\left\vert \boldsymbol{f}\right\rangle \left\langle \left. \overset{}{%
\boldsymbol{e}}\right\vert \boldsymbol{f}\right\rangle =\left\vert 
\boldsymbol{e}\right\rangle \left\langle \left. \overset{}{\boldsymbol{e}}%
\right\vert \boldsymbol{f}\right\rangle \left\langle \left. \overset{}{%
\boldsymbol{e}}\right\vert \boldsymbol{f}\right\rangle =\left\vert 
\boldsymbol{e}\right\rangle \left\langle \left. \overset{}{\boldsymbol{e}}%
\right\vert \boldsymbol{f}\right\rangle ^{2}
\end{eqnarray}

\item 
\begin{equation}
\mathcal{R}_{e}\left( u_{fe}\right) =\mathcal{M}_{e}\left( u_{fe}\right)
=\left\langle \boldsymbol{e}\right\vert \left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right)
\left\vert \boldsymbol{e}\right\rangle =\left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle =\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right)
\end{equation}%
and%
\begin{equation}
\mathcal{R}_{f}\left( u_{fe}\right) =\mathcal{M}_{f}\left( u_{fe}\right)
=\left\langle \boldsymbol{f}\right\vert \left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right)
\left\vert \boldsymbol{f}\right\rangle =\left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle =\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
u_{fe}=\left\vert \boldsymbol{e}\right\rangle \left( \overset{}{\left\langle 
\boldsymbol{e}\right\vert \left\vert \boldsymbol{f}\right\rangle }\right)
\left\langle \boldsymbol{e}\right\vert =\left\vert \boldsymbol{f}%
\right\rangle \left( \overset{}{\left\langle \boldsymbol{e}\right\vert
\left\vert \boldsymbol{f}\right\rangle }\right) \left\langle \boldsymbol{f}%
\right\vert .
\end{equation}
\end{enumerate}

\subparagraph{Hilbert Space Scalar Product \label{Hilbert Space Scalar
Product}}

\begin{enumerate}
\item 
\begin{enumerate}
\item The basis transformation 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( \left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert \right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert \right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( \left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert \right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert \right) _{r}^{r}%
\end{array}%
\right)
\end{equation}

\item The vector wrt to the $\left\vert \boldsymbol{e}\right\rangle $ and $%
\left\vert \boldsymbol{f}\right\rangle $ bases 
\begin{equation}
\left\vert w\right\rangle =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( w\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( w\right) ^{r}%
\end{array}%
\right)
\end{equation}

\item Te representations on the $\left\vert \boldsymbol{e}\right\rangle $
and $\left\vert \boldsymbol{f}\right\rangle $ bases are related by 
\begin{eqnarray}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) ^{r}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( w\right) ^{r}%
\end{array}%
\right) \\
\left( 
\begin{array}{c}
\mathcal{R}_{f}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( w\right) ^{r}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) ^{\dagger }\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( w\right) ^{r}%
\end{array}%
\right) .
\end{eqnarray}
\end{enumerate}

\item The scalar = inner product $\left\langle \left. w\right\vert
v\right\rangle $ is given by

\begin{enumerate}
\item 
\begin{equation}
\left\langle \left. w\right\vert v\right\rangle =\left\langle \left. \overset%
{}{\left\vert \boldsymbol{f}\right\rangle \mathcal{R}_{f}\left( w\right) }%
\right\vert \left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left(
v\right) \right\rangle =\mathcal{R}_{f}\left( w\right) ^{\dagger
}\left\langle \left. \boldsymbol{f}\right\vert \boldsymbol{e}\right\rangle 
\mathcal{R}_{e}\left( v\right) =\mathcal{R}_{f}\left( w\right) ^{\dagger
}\left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle
^{\dagger }\mathcal{R}_{e}\left( v\right) =\mathcal{R}_{f}\left( w\right)
^{\dagger }\mathcal{R}_{e}\left( \overset{}{\left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert }\right) ^{\dagger }%
\mathcal{R}_{e}\left( v\right) =\mathcal{R}_{f}\left( w\right) ^{\dagger }%
\mathcal{R}_{e}\left( u_{fe}\right) ^{\dagger }\mathcal{R}_{e}\left(
v\right) .
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f}\left( w\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( w\right) ^{r}%
\end{array}%
\right) ^{\dagger }=\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{f}\left( w\right) ^{1}} & \cdots & \overline{\mathcal{%
R}_{f}\left( w\right) ^{r}}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{e}\left( w\right) ^{1}} & \cdots & \overline{\mathcal{%
R}_{e}\left( w\right) ^{r}}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right)
\end{equation}

\item 
\begin{eqnarray}
\left\langle \left. w\right\vert v\right\rangle &=&\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{f}\left( w\right) ^{1}} & \cdots & \overline{\mathcal{%
R}_{f}\left( w\right) ^{r}}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) ^{\dagger }\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{e}\left( w\right) ^{1}} & \cdots & \overline{\mathcal{%
R}_{e}\left( w\right) ^{r}}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) ^{\dagger }\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\overline{\mathcal{R}_{e}\left( w\right) ^{1}} & \cdots & \overline{\mathcal{%
R}_{e}\left( w\right) ^{r}}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) .
\end{eqnarray}

\begin{remark}
The matrix 
\begin{equation}
\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. e_{r}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) ^{\dagger }=\left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. f_{r}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right)
\end{equation}%
is the metric matrix.
\end{remark}

\item 
\begin{equation}
\left( \left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert \right) \left\vert \boldsymbol{e}\right\rangle =\left\vert 
\boldsymbol{f}\right\rangle \mathcal{R}_{e}\left( u_{fe}\right)
\end{equation}

\item 
\begin{equation}
\left\langle \boldsymbol{e}\right\vert \left( \left( \left\vert \boldsymbol{f%
}\right\rangle \left\langle \boldsymbol{e}\right\vert \right) \right)
\left\vert \boldsymbol{e}\right\rangle =\mathcal{M}_{e}\left( u_{fe}\right)
=\left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( u_{fe}\right) =\left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle
\end{equation}

\item 
\begin{equation}
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert =\left\vert \boldsymbol{e}\right\rangle \mathcal{M}_{e}\left(
u_{fe}\right) \left\langle \boldsymbol{e}\right\vert
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( u_{fe}\right) =\mathcal{R}_{f}\left( u_{fe}\right)
=\left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle
\end{equation}

\item 
\begin{equation}
\left( \left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert \right) ^{-1}=\left\vert \boldsymbol{e}\right\rangle
\left\langle \boldsymbol{f}\right\vert =\left( \left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert \right) ^{\dagger }
\end{equation}
\end{enumerate}
\end{enumerate}

\subsection{Generalization of the Hilbert Space Case \label{Generalization
of Hilbert Space Case}}

In the general case of TVS's 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{r}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \equiv \left( \boldsymbol{f}\right) ^{t}=\left( \boldsymbol{e}%
\right) ^{t}\mathcal{R}_{e}\left( A\right)
\end{equation}

\begin{definition}
\label{Definition of induced biorthogonality preseving transformation} The
basis $\left( \boldsymbol{f}_{b}\right) $ is the dual biorthogonal basis to $%
\left( \boldsymbol{f}\right) ^{t}=$ $\left( A\boldsymbol{e}\right) ^{t}$ can
be generated by the induced transformation $A_{b}=b\left( A\right) \in
GL\left( V^{d}\right) $ of the basis $\left( \boldsymbol{e}_{b}\right) $ by
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{gather}
\left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{r}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}
\end{gather}%
which gives the following relationships between the resolution of the
identities

\item 
\begin{gather}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( \boldsymbol{f}_{b}\right) \right] \left( \boldsymbol{f}\right)
^{t}=\mathcal{R}_{e}\left( A\right) ^{-1}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left(
A\right) \\
\parallel \\
\mathbb{I}_{r}.
\end{gather}
\end{enumerate}
\end{remark}

\begin{remark}
\textbf{IMPORTANT the duality map }$d$ \textbf{gives }%
\begin{equation}
f_{dj}=d\left( Ae_{j}\right)
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}_{d}\right) =d\left( A\boldsymbol{e}\right)
\end{equation}%
but the biorthogonality preserving map $b$ gives 
\begin{equation}
f_{bj}\neq d\left( A^{-1}e_{j}\right)
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) =b\left( A\boldsymbol{e}\right)
\end{equation}%
$\left( \boldsymbol{f}_{d}\right) $ is \emph{not }biorthogonal to $%
\boldsymbol{f}$ but $\left( \boldsymbol{f}_{b}\right) $ is.
\end{remark}

\begin{remark}
\begin{enumerate}
\item The basis transformation $S_{fe}$ can be expressed as 
\begin{equation}
S_{fe}=\left( \boldsymbol{f}\right) ^{t}\left( \boldsymbol{e}_{b}\right)
=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left(
S\right) \left( \boldsymbol{e}_{b}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
S\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S\right) _{r}^{1} & \cdots & \mathcal{R}_{e}\left(
S\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] .
\end{equation}

\item The inverse transformation is given by 
\begin{equation}
S_{fe}^{-1}=\left( \boldsymbol{e}\right) \left( \boldsymbol{f}_{b}\right)
^{t}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left(
S_{fe}\right) \left( \boldsymbol{e}_{b}\right) ^{t}=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] ,
\end{equation}%
which can also be expressed by 
\begin{equation}
S_{fe}^{-1}=\left( \boldsymbol{e}\right) ^{t}\left( \boldsymbol{f}%
_{b}\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left(
S_{fe}\right) \left( \boldsymbol{f}\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{f}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{f}\left( S_{fe}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{f}\left( S_{fe}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{f}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] .
\end{equation}

\item 
\begin{eqnarray}
\left( \boldsymbol{f}\right) ^{t}\left( \boldsymbol{e}_{b}\right) \left( 
\boldsymbol{e}\right) ^{t}\left( \boldsymbol{f}_{b}\right) &=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \\
&=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathbb{I}_{r}\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =I_{r}
\end{eqnarray}
\end{enumerate}
\end{remark}

\begin{remark}
The basis transformation $S_{fe}$ 
\begin{equation}
S_{fe}=\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}%
is the \emph{Overlap Operator }$\equiv $\emph{\ Metric Operator} $S_{fe}$ as 
$\mathcal{R}_{e}$ representation is 
\begin{gather}
\mathcal{R}_{e}\left( S_{fe}\right) = \\
=\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
=\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A_{fe}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A_{fe}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e}\left( A_{fe}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A_{fe}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A_{fe}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e}\left( A_{fe}\right) _{r}^{r}%
\end{array}%
\right) =\mathbb{S}_{fe},
\end{gather}%
while the $\mathcal{R}_{f}$ representation is 
\begin{equation}
\mathcal{R}_{f}\left( S_{fe}\right) =\mathcal{R}_{f}\left( A_{fe}\right) =%
\mathcal{R}_{f}\left( \overset{}{\left( \boldsymbol{f}\right) ^{t}\left[
\left( \boldsymbol{e}_{b}\right) \right] }\right) =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) ,
\end{equation}%
and the $\mathcal{R}_{f}$ representation is%
\begin{equation}
\mathcal{R}_{e}\left( S_{fe}\right) =\mathcal{R}_{e}\left( A_{fe}\right) =%
\mathcal{R}_{e}\left( \overset{}{\left( \boldsymbol{f}\right) ^{t}\left[
\left( \boldsymbol{e}_{b}\right) \right] }\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right)
\end{equation}%
showing that 
\begin{equation}
\mathcal{R}_{e}\left( A_{fe}\right) =\mathbb{S}_{fe}=\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
The dual $d\left( \left( S_{fe}\boldsymbol{e}\right) \right) =\left( S_{fe}%
\boldsymbol{e}\right) _{d}$ of the basis $\left( u_{fe}\boldsymbol{e}\right) 
$ is given by 
\begin{eqnarray}
d\left( \left( S_{fe}\boldsymbol{e}\right) \right) &=&\left( 
\begin{array}{ccc}
\left( S_{fe}e_{1}\right) _{d} & \cdots & \left( S_{fe}e_{r}\right) _{d}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( S_{fed}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( S_{fed}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( S_{fed}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( S_{fed}\right) _{r}^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) .
\end{eqnarray}%
hence the transformed \emph{overlap }$\equiv $\emph{\ metric matrix} $%
\mathbb{S}_{f}$ can be expressed as 
\begin{gather}
\left[ \left( 
\begin{array}{c}
f_{d}^{1} \\ 
\vdots \\ 
f_{d}^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{ccc}
\left( S_{fe}e_{1}\right) _{d} & \cdots & \left( S_{fe}e_{r}\right) _{d}%
\end{array}%
\right) ^{t}\right] \left( 
\begin{array}{ccc}
\left( S_{fe}e\right) _{1} & \cdots & \left( S_{fe}e\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \right) ^{t}\right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \\
\parallel \\
\left[ \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right)
\end{gather}

\begin{enumerate}
\item Thus $f_{d}=f_{b}$ if only if 
\begin{equation}
\mathcal{R}_{e}\left( S_{fe}\right) ^{t}\mathcal{R}_{e}\left( S_{fe}\right)
=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}%
i.e. 
\begin{equation}
A\in O\left( r,\mathbb{C}\right) .
\end{equation}%
However

\item 
\begin{equation}
\mathbb{I}_{r}=\mathcal{R}_{e}\left( A\right) ^{-t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e}\left( A\right)
^{-1}\left( 
\begin{array}{ccc}
e^{1}\left( e_{1}\right) & \cdots & e^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( e_{1}\right) & \cdots & e^{r}\left( e_{r}\right)%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
\left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \overset{\limfunc{def}}{=}\left( 
\begin{array}{c}
f_{b}^{1} \\ 
\vdots \\ 
f_{b}^{r}%
\end{array}%
\right) ,
\end{equation}%
is true for any $A\in GL\left( V\right) .$
\end{enumerate}
\end{remark}

\begin{remark}
The coordinates $\left\{ \left. \mathcal{R}_{e}\left( v\right)
^{j}\right\vert 1\leq j\leq r\right\} $ are \underline{\emph{contravariant
coordinates}}\emph{\ }as they transform in an \underline{inverse} manner
compared to transformations of the basis $\left( \boldsymbol{e}\right)
\equiv \left\{ \left. e_{j}\right\vert 1\leq j\leq r\right\} $ as can be
seen from 
\begin{equation}
v=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( S_{fe}\right) 
\mathcal{R}_{e}\left( S_{fe}\right) ^{-1}\mathcal{R}_{e}\left( v\right)
=\left( S_{fe}\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( v\right) =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}%
_{e}\left( S_{fe}\right) ^{-1}\mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{f}\right) ^{t}\mathcal{R}_{f}\left( v\right) ,
\end{equation}%
where 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=\left( S_{fe}\boldsymbol{e}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( S_{fe}\right) ^{-1}%
\mathcal{R}_{e}\left( v\right) ,
\end{equation}%
i.e. 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{remark}
The coordinates $\left\{ \left. \mathcal{R}_{e_{b}}\left( h_{d}\right)
_{j}\right\vert 1\leq j\leq r\right\} $ are \underline{\emph{covariant
coordinates}}\emph{\ }as they transform in the \underline{same} manner as
the transformations of the basis $\left( \boldsymbol{e}\right) \equiv
\left\{ \left. e_{j}\right\vert 1\leq j\leq r\right\} ,$ as can be seen from 
\begin{equation}
h_{d}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}_{e}\left(
S_{fe}\right) ^{-1}\mathcal{R}_{e}\left( S_{fe}\right) \mathcal{R}%
_{e_{d}}\left( h_{d}\right) =\left( b\left( S_{fe}\right) \boldsymbol{e}%
_{b}\right) ^{t}\mathcal{R}_{e}\left( S_{fe}\right) \mathcal{R}%
_{e_{d}}\left( h_{d}\right) =\left( \boldsymbol{f}_{b}\right) ^{t}\mathcal{R}%
_{f_{b}}\left( h_{d}\right) ,
\end{equation}%
where 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=\left( \left( S_{fe}\boldsymbol{e}%
\right) _{b}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{f_{b}}\left( h_{d}\right) =\mathcal{R}_{e_{b}}\left(
S_{fe}\right) \mathcal{R}_{e_{b}}\left( h_{d}\right) ,
\end{equation}%
i.e. 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( h_{d}\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( h_{d}\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( S_{fe}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( S_{fe}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) ^{r}%
\end{array}%
\right) .
\end{equation}
\end{remark}

\subparagraph{Metric Matrices and Operators \label{Metric Matrices and
Operators}}

\begin{definition}
In general the overlap \emph{matrix} $\equiv $ metric matrix $\mathbb{S}%
_{fe} $ between two bases $\left\{ \left( \boldsymbol{f}_{b}\right) ,\left( 
\boldsymbol{e}\right) \right\} $ is 
\begin{equation}
\mathbb{S}_{fe}=\left[ \left( \boldsymbol{f}_{b}\right) \right] \left( 
\boldsymbol{e}\right) ^{t}=\left( 
\begin{array}{c}
\left[ e^{1}\right] \\ 
\vdots \\ 
\left[ e^{r}\right]%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) .
\end{equation}
\end{definition}

\begin{definition}
The metric \emph{operator} is defined as 
\begin{equation}
S_{fe}=\left( \boldsymbol{f}\right) ^{t}\left( \boldsymbol{e}_{b}\right)
=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}f_{j}e^{j}
\end{equation}%
which changes the bases $\left( \boldsymbol{e}\right) $ to the bases $\left( 
\boldsymbol{f}\right) .$
\end{definition}

\begin{example}
\begin{enumerate}
\item 
\begin{equation}
S_{fe}e_{k}=\sum_{1\leq j\leq r}f_{j}e^{j}\left( e_{k}\right) =f_{k}
\end{equation}

\item 
\begin{equation}
\left( S_{fe}\boldsymbol{e}\right) ^{t}=\left( \boldsymbol{f}\right)
^{t}=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( S_{fe}\right)
\end{equation}

\item 
\begin{equation}
S_{fe}=\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( S_{fe}\right)
\left( \boldsymbol{e}_{b}\right)
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e}\left( S_{fe}\right) =\left( \boldsymbol{e}_{b}\right)
S_{fe}e_{k}\left( \boldsymbol{e}\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] S_{fe}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \sum_{1\leq j\leq r}f_{j}e^{j}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{equation}
\mathbb{S}_{fe}=\mathcal{R}_{e}\left( S_{fe}\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
S_{fe}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}
\end{enumerate}
\end{example}

\subparagraph{Resolutions of the identity \label{Resolutions of the Identity}%
}

\begin{enumerate}
\item 
\begin{equation}
I_{V}=\sum_{1\leq j\leq r}\left[ e_{i}e^{i}\right] .
\end{equation}

\item 
\begin{equation}
P_{V^{d}}=\sum_{1\leq j\leq r}\left[ e_{bj}e_{bbi}\right] =\sum_{1\leq j\leq
r}\left[ e^{i}e_{i}\right] ,
\end{equation}%
where 
\begin{equation}
e_{bbi}\left( h_{d}\right) =h_{d}\left( e_{i}\right) .
\end{equation}
\end{enumerate}

\subparagraph{Scalar Product \label{Scalar Product 2}}

The scalar product between $w_{d}\in V^{d}$ 
\begin{equation}
w_{d}=\left( \boldsymbol{f}_{b}\right) ^{t}\mathcal{R}_{f_{b}}\left(
w_{d}\right) =\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
f_{1bb}\left( w_{d}\right) \\ 
\vdots \\ 
f_{rbb}\left( w_{d}\right)%
\end{array}%
\right) =\sum_{1\leq j\leq r}f^{j}\mathcal{R}_{f_{b}}\left( w_{d}\right) _{j}
\end{equation}%
and $v\in V$ 
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right)
=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}
\end{equation}%
recall that 
\begin{gather}
\left[ \left( \boldsymbol{f}_{b}\right) \right] =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left[ \left( \overset{}{\left( \boldsymbol{e}_{b}\right) 
\mathcal{R}_{e_{b}}\left( A\right) ^{-1}}\right) \right] =\left[ \left( 
\overset{}{\mathcal{R}_{e_{b}}\left( A\right) ^{-t}}\left( \boldsymbol{e}%
_{b}\right) ^{t}\right) \right] =\mathcal{R}_{e_{b}}\left( A\right) ^{-t}%
\left[ \left( \boldsymbol{e}_{b}\right) ^{t}\right] =\mathcal{R}_{e}\left(
A\right) ^{-t}\left[ \left( \boldsymbol{e}_{b}\right) ^{t}\right] \\
=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{gather}%
then the scalar product is given by%
\begin{gather}
w_{d}\left( v\right) =w_{d}^{t}v \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel
\end{gather}%
\begin{gather}
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{gather}%
which can be recast using resolutions of the identity as 
\begin{gather}
w_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
f_{bb1}\left( w_{d}\right) & \cdots & f_{bbr}\left( w_{d}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) \\
\parallel \\
\left( \left[ \left( 
\begin{array}{ccc}
\left[ f^{1}\right] & \cdots & \left[ f^{r}\right]%
\end{array}%
\right) \right] \left( 
\begin{array}{c}
f_{bb1}\left( w_{d}\right) \\ 
\vdots \\ 
f_{bbr}\left( w_{d}\right)%
\end{array}%
\right) \right) ^{t}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( \left( \sum_{1\leq j\leq r}\left[ f^{j}\right] f_{bbj}\right) \left(
w_{d}\right) \right) ^{t}\left( \sum_{1\leq j\leq r}e_{j}e^{j}\right) \left(
v\right) =w_{d}\left( v\right) .
\end{gather}

\begin{remark}
\label{Scalar product metric matrix}%
\begin{equation}
\mathcal{R}_{e}\left( A_{fe}\right) =\mathbb{S}_{fe}=\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{e}\left( A_{fe}\right) ^{-1}=\mathcal{R}_{e}\left(
A_{ef}\right) ^{-1}=\mathbb{S}_{fe}^{-1}=\mathbb{S}_{ef}=\left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right)
\end{equation}%
hence the metric matrix in the scalar product is 
\begin{equation}
\mathbb{G}_{fe}=\left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A_{fe}\right) ^{-1}=\mathbb{S}%
_{fe}^{-1}=\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) ^{-1}.
\end{equation}
\end{remark}

\begin{remark}
The \emph{triple dual} $V^{ddd}$ of the vector space $V$ and the \emph{dual
vector} space $V^{d}$ are isomorphic i.e. 
\begin{equation}
V^{ddd}\cong V^{d}
\end{equation}%
in \emph{both} infinite and finite cases, while the vector space $V$ can be
only in general be injected into the double dual $V^{dd}$ i.e. $%
V\hookrightarrow V^{dd}.$

\begin{enumerate}
\item The action of the dual space $V^{d}$ of linear functionals produces a
complex number i.e. 
\begin{equation}
h_{d}\left( v\right) \in \mathbb{C\quad }\forall v\in V.
\end{equation}

\item The injection%
\begin{equation}
\iota _{V^{dd}V}:V\hookrightarrow V^{dd}
\end{equation}
is given by 
\begin{equation}
v_{dd}=\iota _{V^{dd}V}\left( v\right) ,
\end{equation}%
where 
\begin{equation}
v_{dd}\left( h_{d}\right) =h_{d}\left( v\right) \in \mathbb{C\quad }\forall
h_{d}\in V^{d}.
\end{equation}

\item The isomorphism $V^{ddd}\cong V^{d}$ is given by 
\begin{equation}
h_{ddd}\left( f_{dd}\right) =f_{dd}\left( h_{d}\right) \in \mathbb{C\quad }%
\forall f_{dd}\in V^{dd}.
\end{equation}

\item If $f_{dd}=\iota _{V^{dd}V}\left( v\right) $ this gives 
\begin{equation}
h_{ddd}\left( \iota _{V^{dd}V}\left( v\right) \right) =\iota
_{V^{dd}V}\left( v\right) \left( h_{d}\right) =h_{d}\left( v\right) \in 
\mathbb{C\quad }\forall v\in V.
\end{equation}
\end{enumerate}
\end{remark}

\begin{remark}
\begin{equation}
\begin{array}{ccccccc}
V & \overset{d}{\hookrightarrow } & V^{d} & \overset{d}{\hookrightarrow } & 
V^{dd} & \overset{d}{\hookrightarrow } & V^{ddd} \\ 
&  & \bigcap &  & \bigcup &  & \parallel \\ 
&  & V^{dd} & \overset{d}{\hookleftarrow } & V & \overset{d}{\hookrightarrow 
} & V^{d}%
\end{array}%
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
V\subseteq V^{d}\subseteq V^{dd}
\end{equation}%
and 
\begin{equation}
V^{ddd}=V^{d}.
\end{equation}
\end{remark}

\begin{remark}
The metric tensor $G_{f_{bb}e_{b}}$ 
\begin{equation}
G_{f_{bb}e_{b}}=\left( \boldsymbol{f}_{bb}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{b}\right) \right] \left( v\right) =\sum f_{bbj}e_{bj}\left(
\sum e_{j}\mathcal{R}_{e}\left( v\right) \right) ^{j}.
\end{equation}
\end{remark}

\subparagraph{Expansions of Vectors \label{Expansion of vectors} \label{2}}

We further analyse representations of vectors and linear functionals:

\begin{definition}
The $\mathbb{C}$-linear duality maps $d_{e}\in \mathcal{L}\left(
V^{d},V\right) $ are denoted by $d_{e}$ showing
\end{definition}

\begin{definition}
The basis dependent duality maps $d_{e}$ 
\begin{equation}
d_{e}:V\rightarrow V^{d}
\end{equation}%
are defined by 
\begin{equation}
d_{e}\left( v\right) =d_{e}\left( \sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( v\right) ^{j}\right) =\sum_{1\leq j\leq r}e^{j}\mathcal{R}%
_{e_{d}}\left( v^{d}\right) _{j}=v_{d_{e}},
\end{equation}%
where 
\begin{equation}
\mathcal{R}_{e_{d_{e}}}\left( v_{d_{e}}\right) _{j}=\mathcal{R}_{e}\left(
v\right) ^{j},\quad 1\leq j\leq r.
\end{equation}%
Recall
\end{definition}

\begin{notation}
\begin{equation}
d_{e}\left( \boldsymbol{e}\right) =\left( \boldsymbol{e}_{d}\right) =\left( 
\boldsymbol{e}_{b}\right) .
\end{equation}
\end{notation}

\begin{remark}
The action on basis elements is 
\begin{equation}
e_{d_{e}j}=d_{e}\left( e_{j}\right) =e^{j},\,1\leq j\leq r,\quad \forall
\left( \boldsymbol{e}\right) \in \mathfrak{B}\left( V\right) .
\end{equation}
\end{remark}

\begin{notation}
\begin{equation}
d_{e}\left( e_{j}\right) =e^{j},\,1\leq j\leq r.
\end{equation}
\end{notation}

\begin{definition}
The $\mathbb{C}$-linear duality maps $d_{e_{b}}\in \mathcal{L}\left(
V^{dd},V^{d}\right) $ 
\begin{equation}
d_{e_{b}}:V^{d}\rightarrow V^{dd}
\end{equation}%
are defined by 
\begin{equation}
w_{dd}=d_{e_{b}}\left( h_{d}\right) =\sum_{1\leq j\leq r}e_{bbj}\mathcal{R}%
_{e_{bb}}\left( w_{dd}\right) ^{j}=\sum_{1\leq j\leq r}e_{bbj}\mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{j},
\end{equation}%
where 
\begin{equation}
\mathcal{R}_{e_{bb}}\left( w_{dd}\right) ^{j}=\mathcal{R}_{e_{b}}\left(
h_{d}\right) _{j},\quad 1\leq j\leq r.
\end{equation}%
The definition on basis elements is 
\begin{equation}
e_{bbj}=d_{e_{b}}\left( e_{bj}\right) ,\,1\leq j\leq r,\quad \forall \left( 
\boldsymbol{e}_{b}\right) \in \mathfrak{B}\left( V^{d}\right) .
\end{equation}
\end{definition}

\begin{definition}
The $\mathbb{C}$-linear duality maps $d\in \mathcal{L}\left( V^{dd},V\right) 
$ 
\begin{equation}
d:V\rightarrow V^{dd}
\end{equation}%
are defined by 
\begin{equation}
d\left( v\right) \left( h_{d}\right) =h_{d}\left( v\right) \quad \forall
v\in V
\end{equation}
\end{definition}

\begin{lemma}
\begin{equation}
w_{dd}=d\left( v\right) =\sum_{1\leq j\leq r}e_{bbj}\mathcal{R}%
_{e_{bb}}\left( w_{dd}\right) ^{j}=\sum_{1\leq j\leq r}e_{bbj}\mathcal{R}%
_{e}\left( v\right) ^{j}.
\end{equation}
\end{lemma}

\subparagraph{Super Vector Expressions \label{Super Vector Expressions}}

\begin{enumerate}
\item Vectors $v\in V$ (contravariant vectors) can be expanded as

\begin{enumerate}
\item 
\begin{gather}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
v^{1} \\ 
\vdots \\ 
v^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1}\left( v\right) \\ 
\vdots \\ 
e_{br}\left( v\right)%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1}\left( v\right) \\ 
\vdots \\ 
e^{r}\left( v\right)%
\end{array}%
\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right)
=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j},
\end{gather}%
which gives the resolution of the identity, if $\left( \boldsymbol{e}%
_{b}\right) $ exists, on $V$ as

\item 
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}=\left[
\sum_{1\leq j\leq r}e_{j}e_{bj}\right] \left( v\right) =\left[ \sum_{1\leq
j\leq r}e_{j}e^{j}\right] \left( v\right) ,
\end{equation}%
where 
\begin{equation}
\left[ e_{j}e_{bj}\right] =e_{j}\left[ e_{bj}\right]
\end{equation}%
and one can define resolutions of the identity $I_{V}\in \mathcal{L}\left(
V\right) $ as

\begin{definition}
\begin{equation}
I_{V}\overset{\limfunc{def}}{=}\left[ \boldsymbol{ee}_{b}\right] =\left( 
\boldsymbol{e}\right) ^{t}\left( \boldsymbol{e}_{b}\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \equiv \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}\left[ e^{j}\right] \equiv
\sum_{1\leq j\leq r}e_{j}e^{j}.
\end{equation}
\end{definition}
\end{enumerate}

Linear functionals $h_{d}\in V^{d}$ (covariant vectors or dual vectors) can
be expanded as

\item 
\begin{eqnarray}
h_{d} &=&\mathcal{R}_{e_{b}{}_{b}}\left( h_{d}\right) ^{t}\left( \boldsymbol{%
e}_{b}\right) =\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e_{b}{}_{b}}\left( h_{d}\right) \\
&=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}{}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}{}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{bb1}\left( h_{d}\right) & \cdots & e_{bbr}\left( h_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e_{bb1}\left( h_{d}\right) & \cdots & e_{bbr}\left( h_{d}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
h_{d}\left( e_{1}\right) & \cdots & h_{d}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\mathcal{R}_{e_{b}{}}\left( h_{d}\right) \left( \boldsymbol{e}%
_{b}\right) =\sum_{1\leq j\leq r}\mathcal{R}_{e_{b}{}_{b}}\left(
h_{d}\right) _{j}e^{j},
\end{eqnarray}%
which

\begin{enumerate}
\item gives the resolution of the identity 
\begin{equation}
I_{V^{d}}=\sum_{1\leq j\leq r}e_{bj}\left[ e_{bbj}\right] =\sum_{1\leq j\leq
r}e^{j}\left[ e_{bbj}\right] \in \mathcal{L}\left( V^{d}\right)
\end{equation}%
on $V^{d}$ as 
\begin{equation}
h_{d}=\sum_{1\leq j\leq r}e^{j}\mathcal{R}_{e}\left( h_{d}\right)
_{j}=\sum_{1\leq j\leq r}e^{j}e_{bbj}\left( h_{d}\right) =\sum_{1\leq j\leq
r}e^{j}\left[ e_{bbj}\right] \left( h_{d}\right) ,
\end{equation}%
that can also be expressed as

\item 
\begin{equation}
I_{V^{d}}\overset{\limfunc{def}}{=}\left[ \boldsymbol{e}_{bbb}\boldsymbol{e}%
_{bb}\right] =\left[ \boldsymbol{e}_{b}\boldsymbol{e}\right] =\left( 
\boldsymbol{e}_{b}\right) ^{t}\left[ \left( \boldsymbol{e}\right) \right]
=\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{bj}e_{j}=\sum_{1\leq j\leq
r}e^{j}e_{j}
\end{equation}%
if $\left( \boldsymbol{e}_{b}\right) $ exists.
\end{enumerate}
\end{enumerate}

\begin{remark}
\begin{eqnarray}
\left( \boldsymbol{e}_{bbb}\right) ^{t}\left( \boldsymbol{e}_{bb}\right)
&=&\left( \boldsymbol{e}_{b}\right) ^{t}\left( \boldsymbol{e}\right) \in 
\mathcal{L}\left( V^{ddd},V^{dd}\right) \\
\left( \boldsymbol{e}_{b}\right) ^{t}\left( \boldsymbol{e}\right) &=&\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{bj}e_{j}=\sum_{1\leq j\leq
r}e^{j}e_{j},
\end{eqnarray}%
which can be compared to 
\begin{equation}
\left( \boldsymbol{e}_{b}\right) \left( \boldsymbol{e}\right) ^{t}=\left[
\left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1}\left( e_{1}\right) & \cdots & e_{b1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e_{br}\left( e_{1}\right) & \cdots & e_{br}\left( e_{r}\right)%
\end{array}%
\right) \in \mathcal{M}\left( r,r,\mathbb{C}\right) .
\end{equation}
\end{remark}

\begin{remark}
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) ^{t}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{bb}}\left( v_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{bb}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \overset{\text{as }v_{d}\text{ is the dual of }v}{=}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) ^{1} & \cdots & \mathcal{R}_{e}\left(
v\right) ^{r}%
\end{array}%
\right)
\end{equation}
\end{remark}

\begin{remark}
The general form of the scalar product $\label{The general form of the
scalar product}$ is 
\begin{align}
w_{d}\left( v\right) & =\left( \left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \right) ^{t}\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
& =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
& =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
& =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \mathbb{S}_{fe}^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
& =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( w_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( w_{d}\right) _{r}%
\end{array}%
\right) \mathbb{G}_{fe}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) .
\end{align}
\end{remark}

\begin{remark}
Recall

\begin{enumerate}
\item 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=A\left( \boldsymbol{e}\right) ^{t}=\left( 
\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right) =\left( \boldsymbol{%
e}\right) ^{t}\mathcal{R}_{e}\left( A\right)
\end{equation}

\item 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=b\left( A\right) \left( \boldsymbol{e}%
_{b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e_{b}}\left( b\left( A\right) \right) =\left( \boldsymbol{e}_{b}\right)
^{t}\mathcal{R}_{e_{b}}\left( A\right) ^{-1}
\end{equation}

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) =b\left( A\right) \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( b\left( A\right) \right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( A\right) ^{-1}
\end{equation}

\item 
\begin{equation}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}

\item 
\begin{equation}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}
\end{enumerate}
\end{remark}

\section{Changing Tensor Type}

\section{Mappings Between Vector Spaces}

Let $A\in \mathcal{L}\left( X,Y\right) $ then it can be expressed in dyadic
form as 
\begin{equation}
A=\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left( A\right) \left( 
\boldsymbol{e}\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] ,
\end{equation}%
where $\left( \boldsymbol{f}\right) $ is a basis of $X$ and $\left( 
\boldsymbol{e}\right) $ is a basis of $Y.$

In particular one can consider \label{09/23}

\begin{enumerate}
\item 
\begin{eqnarray}
X &=&V \\
Y &=&V
\end{eqnarray}

\begin{enumerate}
\item A general transformation $A\in \mathcal{L}\left( V\right) $ is given
by 
\begin{gather}
A=\left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right]  \\
\parallel  \\
\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left( A\right) \left( 
\boldsymbol{e}\right) 
\end{gather}

\item The representation of this operator wrt the basis $\left( \boldsymbol{e%
}\right) $ of $V$ is given by 
\begin{equation}
A\left( \boldsymbol{e}\right) ^{t}=\left( \boldsymbol{e}\right) ^{t}\mathcal{%
R}_{e}\left( A\right) 
\end{equation}

\item The matrix $\mathcal{M}_{e}\left( A\right) $ of this transformation
wrt the basis $\left( \boldsymbol{e}\right) $ is given by and \emph{is equal
to the} representation matrix 
\begin{equation}
\mathcal{M}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) =\left[ \left( \boldsymbol{e}_{b}\right) \right] A\left( \boldsymbol{%
e}\right) ^{t}=\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\left[ \left( \boldsymbol{e}\right) %
\right] \left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right) =%
\mathcal{R}_{e}\left( A\right) 
\end{equation}

\item 
\begin{gather}
\mathcal{M}_{e}\left( A\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) =\left[ \left( \boldsymbol{e}_{b}\right) \right] A\left( \boldsymbol{%
e}\right) ^{t}=\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right)  \\
=\left[ \left( \boldsymbol{e}_{b}\right) \right] \left( \boldsymbol{f}%
\right) ^{t}\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right)  & \cdots  & e^{1}\left( f_{r}\right)  \\ 
\vdots  & \ddots  & \vdots  \\ 
e^{r}\left( f_{1}\right)  & \cdots  & e^{r}\left( f_{r}\right) 
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) 
\end{gather}

\item The matrix $\mathcal{M}_{fe}\left( A\right) $ of this transformation
wrt the bases $\left( \boldsymbol{f}\right) $ and $\left( \boldsymbol{e}%
\right) $ and is given by 
\begin{equation}
\mathcal{M}_{fe}\left( A\right) =\left[ \left( \boldsymbol{f}_{b}\right) %
\right] A\left( \boldsymbol{e}\right) ^{t}=\left[ \left( \boldsymbol{f}%
\right) \right] \left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left(
A\right) \left( \boldsymbol{e}\right) \left( \boldsymbol{e}\right) ^{t}=%
\mathcal{R}_{e}\left( A\right) 
\end{equation}

\item The representation $\mathcal{R}_{e}\left( A\right) $ can be produced
by resolutions of the identity by  
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots  \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) 
\end{equation}

\item In particular when the matrix $\mathcal{R}_{e}\left( A\right) $ is the
identity matric $\mathbb{I}_{r}$ producing the change of basis
transformation  
\begin{equation}
S_{fe}=\left( \boldsymbol{f}\right) ^{t}\left( \boldsymbol{e}\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
1 & \cdots  & 0 \\ 
\vdots  & \ddots  & \vdots  \\ 
0 & \cdots  & 1%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}f_{j}e^{j}.
\end{equation}
\end{enumerate}

\item 
\begin{eqnarray}
X &=&V \\
Y &=&V^{d}
\end{eqnarray}

\begin{enumerate}
\item A general transformation $A\in \mathcal{L}\left( V^{d},V\right) $ is
given by 
\begin{equation}
A=\left( 
\begin{array}{ccc}
f^{1} & \cdots  & f^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] =\left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left(
A\right) \left( \boldsymbol{e}\right) 
\end{equation}

\item The representation of this operator wrt the basis $\left( \boldsymbol{e%
}\right) $ of $V$ is given by 
\begin{equation}
A\left( \boldsymbol{e}\right) ^{t}=\left( \boldsymbol{f}_{b}\right) ^{t}%
\mathcal{R}_{e}\left( A\right) 
\end{equation}

\item The matrix of this transformation wrt the bases $\left( \boldsymbol{f}%
\right) $ and $\left( \boldsymbol{e}\right) $ is given by and is equal to
the representation matrix 
\begin{equation}
\mathcal{M}_{fe}\left( A\right) =\left[ \left( \boldsymbol{f}_{bb}\right) %
\right] A\left( \boldsymbol{e}\right) ^{t}=\left[ \left( \boldsymbol{f}%
_{bb}\right) \right] \left( \boldsymbol{f}_{b}\right) ^{t}\mathcal{R}%
_{e}\left( A\right) =\mathcal{R}_{e}\left( A\right) 
\end{equation}

\item The matrix of this transformation wrt the bases $\left( \boldsymbol{f}%
\right) $ and $\left( \boldsymbol{e}\right) $ and is given by 
\begin{equation}
\mathcal{M}_{fe}\left( A\right) =\left[ \left( \boldsymbol{f}\right) \right]
A\left( \boldsymbol{e}\right) ^{t}=\left[ \left( \boldsymbol{f}\right) %
\right] \left( \boldsymbol{f}\right) ^{t}\mathcal{R}_{e}\left( A\right)
\left( \boldsymbol{e}\right) \left( \boldsymbol{e}\right) ^{t}=\mathcal{R}%
_{e}\left( A\right) 
\end{equation}

\item The representation $\mathcal{R}_{e}\left( A\right) $ can be produced
by resolutions of the identity by 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots  \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots  & \ddots  & \vdots  \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots  & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots  & e_{r}%
\end{array}%
\right) 
\end{equation}

\item In particular when the matrix $\mathcal{R}_{e}\left( A\right) $ is the
identity matric $\mathbb{I}_{r}$ producing the change of basis
transformation 
\begin{equation}
S_{fe}=\left( \boldsymbol{f}\right) ^{t}\left( \boldsymbol{e}\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
1 & \cdots  & 0 \\ 
\vdots  & \ddots  & \vdots  \\ 
0 & \cdots  & 1%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}f_{j}e^{j}.
\end{equation}
\end{enumerate}

\item 
\begin{eqnarray}
X &=&V^{d} \\
Y &=&V
\end{eqnarray}%
\begin{equation}
A=\left( 
\begin{array}{ccc}
f_{1} & \cdots  & f_{r}%
