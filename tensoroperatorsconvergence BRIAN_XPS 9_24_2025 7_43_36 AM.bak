\part{Tensor Products and Operator Topologies}

\section{Vector Spaces and Dual Vector Spaces}

\subsection{Definitions and Notation}

\begin{definition}
$V$ is a complex Topological Vector Space.
\end{definition}

\begin{definition}
The dual vector space $V^{d}$ is the vector space of bounded $\equiv $
continuous linear functionals defined on $V$, $V^{d}$ depends on topology on 
$V.$
\end{definition}

\begin{definition}
\emph{Contravariant} vector $v$ representations $\mathcal{R}_{e}\left(
v\right) $ transform as $\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}%
_{e}\left( v\right) $, where $A\in GL\left( V\right) $ is the transformation
of the basis of $V$.
\end{definition}

\begin{definition}
\emph{Covariant} vector $v_{d}$ representations $\mathcal{R}_{e}\left(
v_{d}\right) $ transform as $\mathcal{R}_{e}\left( A_{d}\right) \mathcal{R}%
_{e}\left( v_{d}\right) $, where $A_{d}\in GL\left( V_{d}\right) $
\end{definition}

\begin{notation}
\emph{Contravariant} tensor representation indices are superscripts i.e.
contravariant coordinates are labelled by superscripts.
\end{notation}

\begin{notation}
\emph{conversely contravariant }tensors are labelled by subscripts.
\end{notation}

\begin{notation}
\emph{Covariant} tensor representation indices are subscripts i.e. covariant
coordinates are labelled by subscripts.
\end{notation}

\begin{notation}
\emph{conversely covariant} tensors are labelled by superscripts.
\end{notation}

\begin{notation}
Both covariant and contravariant coordinates can be displayed as either
column vectors or as row vectors.
\end{notation}

\begin{remark}
\textbf{We take columns of entries to be standard form and thus rows of
entries to be transposes of columns of entries}
\end{remark}

\begin{notation}
Representations of mixed second rank tensors can be arranged as matrices $%
\mathbb{A}\in \mathcal{M}\left( r,r,\mathbb{C}\right) $ with matrix elements 
$A_{\func{row},\func{col}}$ that are denoted by subscripts that refer to
rows and columns depending on whether they are acting on row or column
vectors in the following fashion i.e.

\begin{enumerate}
\item 
\begin{equation}
\mathcal{M}_{e}\left( A\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e}\left( A\right) _{\func{col}}^{\func{row}}.
\end{equation}

\item 
\begin{equation}
\mathcal{M}_{e}\left( A\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{\func{row}}^{\func{col}},
\end{equation}%
hence covariant and contravariant indices \emph{can either refer to} columns
or rows of a matrix.
\end{enumerate}
\end{notation}

\begin{enumerate}
\item Supervectors constituted by \emph{bases }of vector and dual vector
spaces are displayed as \emph{row }vectors.

\item This gives
\end{enumerate}

\begin{gather}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( v\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( v\right) ^{1} & \cdots & \mathcal{R}_{e}\left(
v\right) ^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e_{1} \\ 
\vdots \\ 
e_{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( v\right) ^{t}\left( \boldsymbol{e}\right)
\end{gather}%
and 
\begin{gather}
v_{d}=\left( 
\begin{array}{ccc}
e_{d}^{1} & \cdots & e_{d}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{r}%
\end{array}%
\right) =\left( \boldsymbol{e}_{d}\right) ^{t}\mathcal{R}_{e_{d}}\left(
v_{d}\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) =\mathcal{R}_{e_{d}}\left( v\right) ^{t}\left( \boldsymbol{e}%
_{d}\right) .
\end{gather}

\subparagraph{Matrix Transformation of Covariant and Contravariant vectors}

\begin{enumerate}
\item 
\begin{enumerate}
\item \emph{Contravariant} vector transformations $T\in \mathcal{L}\left(
V\right) $ are given by%
\begin{equation}
\mathcal{R}_{e}\left( Tv\right) ^{j}=\sum_{1\leq k\leq r}\mathcal{R}%
_{e}\left( T\right) _{k}^{j}\mathcal{R}_{e}\left( v\right) ^{k},
\end{equation}%
i.e. 
\begin{equation}
T\left( \boldsymbol{e}\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}%
_{e}\left( T\right) \equiv A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( T\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
T\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( T\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
T\right) _{r}^{r}%
\end{array}%
\right) .
\end{equation}

\item \emph{Contravariant} basis transformations $A\in GL\left( V\right) $
produce coordinate transformations $\mathcal{R}_{e}\left( A^{-1}\right) $ 
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( Ae\right) _{1} & \cdots & \left( Ae\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{Ae}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{Ae}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( Ae\right) _{1} & \cdots & \left( Ae\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( \mathcal{R}_{e}\left( A^{-1}\right) \mathcal{R}_{e}\left( v\right)
\right) ^{1} \\ 
\vdots \\ 
\left( \mathcal{R}_{e}\left( A^{-1}\right) \mathcal{R}_{e}\left( v\right)
\right) ^{r}%
\end{array}%
\right)
\end{equation}%
where 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{Ae}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{Ae}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \mathcal{R}_{e}\left( A^{-1}\right) \mathcal{R}_{e}\left( v\right)
\right) ^{1} \\ 
\vdots \\ 
\left( \mathcal{R}_{e}\left( A^{-1}\right) \mathcal{R}_{e}\left( v\right)
\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{equation}%
showing 
\begin{equation}
\mathcal{M}_{e}\left( A^{-1}\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e}\left( A^{-1}\right) _{\func{col}}^{\func{row}}.
\end{equation}
\end{enumerate}

\begin{enumerate}
\item \emph{Covariant} vector transformation $W_{d}\in \mathcal{L}\left(
V^{d}\right) $ are given by%
\begin{equation}
\mathcal{R}_{e_{b}}\left( W_{d}v_{d}\right) _{j}=\sum_{1\leq k\leq r}%
\mathcal{R}_{e_{b}}\left( W_{d}\right) _{j}^{k}\mathcal{R}_{e_{b}}\left(
v_{d}\right) _{k},
\end{equation}%
i.e. 
\begin{equation}
W_{d}\left( \boldsymbol{e}_{b}\right) =\left( \boldsymbol{e}_{b}\right) 
\mathcal{R}_{e_{b}}\left( W_{d}\right) \equiv W_{d}\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{b1} & \cdots & e_{br}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( W_{d}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( W_{d}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( W_{d}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e_{b}}\left( W_{d}\right) _{r}^{r}%
\end{array}%
\right)
\end{equation}

\item \emph{Covariant} basis transformation $A_{b}\in GL\left( V^{d}\right) $
produce coordinate transformations $\mathcal{R}_{e_{b}}\left(
A_{b}^{-1}\right) $ (note this is NOT the representation of the \emph{induced%
} contravariant transformation of the coordinates of a vector wrt to the $%
\left( \boldsymbol{e}\right) $ basis produced by $A$) 
\begin{eqnarray}
v_{d} &=&\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}_{e_{b}}\left(
v_{d}\right) =\left( A_{b}\boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{A_{b}e_{b}}\left( v_{d}\right) =\left( \boldsymbol{e}_{b}\right) ^{t}%
\mathcal{R}_{e_{b}}\left( A_{b}\right) ^{-1}\mathcal{R}_{e_{b}}\left(
A_{b}\right) \mathcal{R}_{e_{b}}\left( v_{d}\right) \\
&\parallel & \\
v_{d} &=&\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( A_{b}e_{b}\right) ^{1} & \cdots & \left( A_{b}e_{b}\right) ^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{A_{b}e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{A_{b}e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left( A_{b}e_{b}\right) ^{1} & \cdots & \left( A_{b}e_{b}\right) ^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\left( \mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) \mathcal{R}%
_{e_{b}}\left( v_{d}\right) \right) _{1} \\ 
\vdots \\ 
\left( \mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) \mathcal{R}%
_{e_{b}}\left( v_{d}\right) \right) _{r}%
\end{array}%
\right)
\end{eqnarray}%
where 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{c}
\left( \mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) \mathcal{R}%
_{e_{b}}\left( v_{d}\right) \right) _{1} \\ 
\vdots \\ 
\left( \mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) \mathcal{R}%
_{e_{b}}\left( v_{d}\right) \right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) _{1}^{1} & \cdots & 
\mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) _{r}^{1} & \cdots & 
\mathcal{R}_{A_{b}e_{b}}\left( A_{b}^{-1}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right)
\end{equation}%
showing 
\begin{equation}
\mathcal{M}_{e_{b}}\left( A_{b}\right) _{\func{row},\func{col}}=\mathcal{R}%
_{A_{b}e_{b}}\left( A_{b}\right) _{\func{row}}^{\func{col}}.
\end{equation}

\item Thia shows that the matrix $\mathcal{M}_{e_{b}}\left( A_{b}\right) $
of the \emph{covariant} basis transformation $A_{b}$ is the transpose of the
matrix $\mathcal{M}_{e}\left( A\right) $ of the contravariant basis
transformation $A$ 
\begin{equation}
\mathcal{R}_{e_{b}}\left( A_{b}^{-1}\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( A_{b}^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( A_{b}^{-1}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( A_{b}^{-1}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( A_{b}^{-1}\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}=\mathcal{R}_{e}\left( A\right) ^{-t}.
\end{equation}
\end{enumerate}

\item Noting that%
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{equation}%
where 
\begin{equation}
\left( \boldsymbol{f}\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right)
\end{equation}%
gives that 
\begin{equation}
v=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right)
\end{equation}%
showing 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{equation}%
i.e. produces transformation of the contravariant coordinates 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right) .
\end{equation}

\item The biorthogonality condition gives 
\begin{eqnarray*}
\mathbb{I}_{r} &=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \left( A_{b}\right) ^{t}\right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
&=&\left[ \mathcal{R}_{e_{b}}\left( A_{b}\right) ^{t}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e_{b}}\left(
A_{b}\right) ^{t}\mathcal{R}_{e}\left( A\right)
\end{eqnarray*}%
showing that 
\begin{equation}
\mathcal{R}_{e_{b}}\left( A_{b}\right) ^{t}=\mathcal{R}_{e}\left( A\right)
^{-1}\equiv \mathcal{R}_{e_{b}}\left( A_{b}\right) =\mathcal{R}_{e}\left(
A\right) ^{-t}
\end{equation}%
in agreement with the preceding.
\end{enumerate}

\section{Covariant and Contravariant Tensors in Dual Spaces}

\subsubsection{Dual Spaces}

\begin{enumerate}
\item \bigskip Let $V$ be a vector space over $\mathbb{C}$ then%
\begin{equation}
V=\mathbb{C}\text{-}\func{linspan}\left\{ \left. e_{j}\right\vert 1\leq
j\leq r\right\} ,
\end{equation}%
where $\left( \boldsymbol{e}\right) =\left\{ \left. e_{j}\right\vert 1\leq
j\leq r\right\} $ is a $\mathbb{C}$-linearily independent basis of $V,$ that
are populated by \emph{contravariant vectors.}

\item The dual space $V^{d}$ of $\mathbb{C}$-linear functionals defined on $%
V $ is produced by 
\begin{equation}
V^{d}=\mathbb{C}\text{-}\func{linspan}\left\{ \left. h_{d}^{j}\right\vert
1\leq j\leq r\right\} ,
\end{equation}%
where $\left( \boldsymbol{h}_{d}\right) =\left\{ \left. h_{d}^{j}\right\vert
1\leq j\leq r\right\} $ is a $\mathbb{C}$-linearily independent basis of $%
V^{d},$\emph{\ }that are populated by \emph{covariant} vectors.
\end{enumerate}

\begin{definition}
Two bases $\left( \boldsymbol{e}\right) \in V$ 
\begin{equation}
\left( \boldsymbol{e}\right) =\left\{ \left. e_{j}\right\vert 1\leq j\leq
r\right\} \equiv \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right)
\end{equation}%
and $\left( \boldsymbol{e}_{b}\right) \in V^{d}$ 
\begin{equation}
\left( \boldsymbol{e}_{b}\right) =\left\{ \left. e^{j}\right\vert 1\leq
j\leq r\right\} \equiv \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right)
\end{equation}%
are \emph{biorthogonal} bases of the pair $\left\{ V^{d},V\right\} $ if the
scalar products between the bases vectors have the property%
\begin{equation}
e^{j}\left( e_{k}\right) =\delta _{k}^{j}=\delta _{jk},\quad 1\leq j,k\leq r.
\end{equation}
\end{definition}

\begin{remark}
The biorthogonality condition can be expressed as 
\begin{equation}
\mathbb{I}_{r}=\left( \boldsymbol{e}_{b}\right) ^{t}\left( \boldsymbol{e}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( e_{1}\right) & \cdots & e^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( e_{1}\right) & \cdots & e^{r}\left( e_{r}\right)%
\end{array}%
\right) ,
\end{equation}%
where the square brackets explicitly state that the components of the
transpose $\left( \boldsymbol{e}_{b}\right) ^{t}$ of the dual super vector $%
\left( \boldsymbol{e}_{b}\right) $ act as linear functionals on $V$ and are
evaluated on the super vector $\left( \boldsymbol{e}\right) .$
\end{remark}

\begin{definition}
\label{Biorthogonality Map} The biorthogonality map $b\in \mathcal{L}\left(
V^{d},V\right) $ 
\begin{equation}
b:V\rightarrow V^{d}
\end{equation}%
produces a linear functional $v_{b}$ biorthogonal to $v$ is defined by 
\begin{equation}
b\left( v\right) =v_{b},
\end{equation}%
where%
\begin{equation}
v_{b}\left( v\right) =\left[ b\left( v\right) \right] \left( v\right) =1
\end{equation}%
and%
\begin{equation}
v_{b}\left( v^{c}\right) =0,
\end{equation}%
where%
\begin{equation}
V=V_{v}\oplus V_{v}^{c}
\end{equation}%
and 
\begin{eqnarray}
v &\in &V_{v} \\
v^{c} &\in &V_{v}^{c}.
\end{eqnarray}
\end{definition}

\begin{remark}
\begin{equation}
\left( \boldsymbol{e}_{b}\right) =b\left( \boldsymbol{e}\right)
\end{equation}%
i.e. 
\begin{equation}
e^{j}=b\left( e_{j}\right) ,\quad 1\leq j\leq r.
\end{equation}
\end{remark}

\begin{theorem}
The action of $b$ is bases independent.

\begin{proof}
From the definition.
\end{proof}
\end{theorem}

\begin{remark}
If $V^{d}$ has a basis $\left( \boldsymbol{e}_{d}\right) $ that is
biorthogonal to a basis $\left( \boldsymbol{e}\right) $ of $V$ i.e. $\left( 
\boldsymbol{e}_{d}\right) =b\left( \boldsymbol{e}\right) =\left( \boldsymbol{%
e}_{b}\right) $ then the representation of a vector $v\in V$ is given by 
\begin{equation}
\mathcal{R}_{e}\left( v\right) =\left[ \left( \boldsymbol{e}_{d}\right) %
\right] \left( v\right)
\end{equation}%
i.e. 
\begin{equation}
\mathcal{R}_{e}\left( v\right) ^{j}=e^{j}\left( v\right) ,\quad 1\leq j\leq r
\end{equation}%
and any vector $v\in V$ can be expanded as 
\begin{equation}
v=\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}=\sum_{1\leq
j\leq r}e_{j}e^{j}\left( v\right) =\left( \boldsymbol{e}\right) \left[
\left( \boldsymbol{e}_{b}\right) ^{t}\right] \left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( v\right) .
\end{equation}
\end{remark}

\begin{remark}
\label{Resolution of Identity} Thus $\left( \boldsymbol{e}\right) \left[
\left( \boldsymbol{e}_{b}\right) ^{t}\right] $ is a resolution of the
identity $I_{V}$ of $V$ i.e. 
\begin{equation}
I_{V}=\left( \boldsymbol{e}\right) \left[ \left( \boldsymbol{e}_{b}\right)
^{t}\right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e_{b1} \\ 
\vdots \\ 
e_{br}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}e_{j}e_{bj}=\sum_{1\leq j\leq
r}e_{j}e^{j}.
\end{equation}
\end{remark}

\begin{notation}
\begin{equation}
\left( \boldsymbol{e}\right) \left[ \left( \boldsymbol{e}_{b}\right) ^{t}%
\right] =\left[ \boldsymbol{ee}_{b}\right] .
\end{equation}
\end{notation}

\begin{remark}
Representations, $\mathcal{R}_{e}\left( v\right) \in \mathbb{C}^{r},$ of
vectors $v\in V$ are given by the expansions 
\begin{equation}
v=\left[ \boldsymbol{ee}_{b}\right] \left( v\right) =\left( \boldsymbol{e}%
\right) \mathcal{R}_{e}\left( v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{j}\mathcal{R}_{e}\left( v\right) ^{j}.
\end{equation}
\end{remark}

\begin{theorem}
\label{Contravariant Theorem} Let $A\in GL\left( V\right) $ then under
change of basis 
\begin{equation}
A:\left( \boldsymbol{e}\right) \rightarrow \left( \boldsymbol{f}\right)
=\left( A\boldsymbol{e}\right)
\end{equation}%
the coordinates of the representation $\mathcal{R}_{e}\left( v\right) $ of
the vector $v$ transform by the the inverse $\mathcal{R}_{e}\left( A\right)
^{-1}$ of the matrix representation $\mathcal{R}_{e}\left( A\right) $ of $A$
wrt the basis $\left( \boldsymbol{e}\right) $ i.e. 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right)
\end{equation}

\begin{proof}
\begin{eqnarray}
Av &=&\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( v\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left(
A\right) ^{-1}\mathcal{R}_{e}\left( v\right) \\
&=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{eqnarray}%
hence 
\begin{equation}
\mathcal{R}_{f}\left( v\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{%
R}_{e}\left( v\right) .\blacksquare
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
The reason why $v$ are called \emph{contravariant }vectors is that their
coordinates transform "contra" to the bases vectors i.e the basis transforms
via a transformation matrix $\mathcal{R}_{e}\left( A\right) $ and the
coordinates via transformation matrix $\mathcal{R}_{e}\left( A\right) ^{-1}.$
\end{remark}

\begin{remark}
Representations, $\mathcal{R}_{e_{b}}\left( h_{d}\right) \in \mathbb{C}$ of
vectors $h_{d}\in V^{d}$ are given by the expansions%
\begin{gather}
h_{d}=\left[ \boldsymbol{e}_{b}\boldsymbol{e}\right] \left( h_{d}\right)
=\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e_{d}}\left( h_{d}\right)
=\left( 
\begin{array}{ccc}
e_{1b} & \cdots & e_{rb}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e_{jb}\mathcal{R}_{e_{b}}\left( v\right) _{j} \\
=\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\sum_{1\leq j\leq r}e^{j}\mathcal{R}_{e_{b}}\left( v\right) _{j}.
\end{gather}
\end{remark}

\subparagraph{Duality Maps \label{Duality Maps}}

\begin{definition}
\label{Injections into dual space} Biorthogonal bases $\left\{ \left( 
\boldsymbol{e}_{b}\right) ,\left( \boldsymbol{e}\right) \right\} $ of the
pair $\left\{ V^{d},V\right\} $ define injections $d_{e}\in \mathcal{L}%
\left( V^{d},V\right) $ called Duality Maps 
\begin{equation}
d_{e}:V\hookrightarrow V^{d}
\end{equation}%
given by 
\begin{equation}
d_{e}\left( v\right) =d_{e}\left( \sum_{1\leq j\leq r}e_{j}\mathcal{R}%
_{e}\left( v\right) ^{j}\right) =\sum_{1\leq j\leq r}d_{e}\left(
e_{j}\right) \mathcal{R}_{e}\left( v\right) ^{j}=\sum_{1\leq j\leq r}e^{j}%
\mathcal{R}_{e_{b}}\left( d_{e}\left( v\right) \right) _{j}.
\end{equation}
\end{definition}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
d_{e}\left( e_{j}\right) =e_{bj}=e^{j},\quad 1\leq j\leq r.
\end{equation}

\item 
\begin{equation}
\mathcal{R}_{e_{b}}\left( d_{e}\left( v\right) \right) _{j}=\mathcal{R}%
_{e}\left( v\right) ^{j},\quad 1\leq j\leq r
\end{equation}

\item 
\begin{equation}
d_{e}\left( e_{j}\right) =e_{dj}=e^{j}=b\left( e_{j}\right) ,\quad 1\leq
j\leq r,
\end{equation}

\item The duality injection $d_{e}$ gives%
\begin{equation}
d_{e}\left( \boldsymbol{e}\right) =b\left( \boldsymbol{e}\right)
\end{equation}%
and in general

\item 
\begin{gather}
d_{e}\left( v\right) =\left( \boldsymbol{e}_{d_{e}}\right) \mathcal{R}%
_{e_{d_{e}}}\left( d_{e}\left( v\right) \right) =\left( 
\begin{array}{ccc}
e_{d_{e}1} & \cdots & e_{d_{e}r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( d_{e}\left( v\right) \right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( d_{e}\left( v\right) \right) _{r}%
\end{array}%
\right) =\left( \boldsymbol{e}_{d_{e}}\right) \mathcal{R}_{e}\left( v\right)
\\
=\left( 
\begin{array}{ccc}
e_{b_{e}1} & \cdots & e_{b_{e}r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) .
\end{gather}
\end{enumerate}
\end{remark}

\begin{notation}
\begin{equation}
v_{d_{e}}=d_{e}\left( v\right) .
\end{equation}
\end{notation}

\begin{remark}
By biorthogonality $V$ can be injected into $V^{d}$ i.e. $V\hookrightarrow
V^{d}.$ But different basis determine different biorthogonal bases
(obviously) more \emph{crucially} they can determine \emph{different}
injections i.e. consider $\left\{ \left( \boldsymbol{e}\right) ,\left( 
\boldsymbol{e}_{d}\right) \right\} $ and $\left\{ \left( \boldsymbol{f}%
\right) ,\left( \boldsymbol{f}_{d}\right) \right\} $ then in general 
\begin{equation}
d_{e}:V\rightarrow V^{d}
\end{equation}%
and 
\begin{equation}
d_{f}:V\rightarrow V^{d}
\end{equation}%
\emph{but in general}%
\begin{equation}
d_{e}\left( v\right) \neq d_{f}\left( v\right) !
\end{equation}
\end{remark}

\begin{remark}
Unless otherwise stated we limit ourselves to a fixed equivalence class of
biorthogonal bases that produce the same duality injection " $d$".
\end{remark}

\begin{lemma}
If there exists a basis $\left( \boldsymbol{e}_{b}\right) $ biorthogonal to
the basis $\left( \boldsymbol{e}\right) $ of $V$ a transformation $A\in 
\mathcal{L}\left( V\right) $ induces a dual transformation $A_{b}\in 
\mathcal{L}\left( V^{d}\right) $ whose representation 
\begin{equation}
\mathcal{R}_{e_{b}}\left( A_{b}\right) \in \mathcal{M}\left( r,r,\mathbb{C}%
\right) ,
\end{equation}%
is the matrix representation $\mathcal{R}_{e}\left( A\right) $ of $A,$ i.e. 
\begin{equation}
\mathcal{R}_{e_{b}}\left( A_{b}\right) =\mathcal{R}_{e}\left( A\right) .
\end{equation}
\end{lemma}

\begin{corollary}
In SVD form \label{spectral resolution form} 
\begin{equation}
d\left( A\right) =\left( \boldsymbol{e}_{b}\right) \mathcal{R}_{e}\left(
A\right) \left( \boldsymbol{e}_{bb}\right) ,
\end{equation}%
where 
\begin{equation}
A=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \left( 
\boldsymbol{e}_{b}\right) .
\end{equation}
\end{corollary}

\begin{proof}
Transformations of vectors belonging to $V$ 
\begin{equation}
Av=\left( \boldsymbol{e}\right) \mathcal{R}_{e}\left( Av\right) =\left( 
\boldsymbol{e}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left(
v\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{equation}%
i.e. in this case 
\begin{equation}
\mathcal{M}_{e}\left( A\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e}\left( A\right) _{\func{col}}^{\func{row}}.
\end{equation}
\end{proof}

The induced transformations of linear functionals belonging $V^{d}$ is given
by 
\begin{equation}
A_{b}v_{d}\overset{\limfunc{def}}{=}\left( Av\right) _{d}=\left( \boldsymbol{%
e}_{d}\right) \mathcal{R}_{e_{d}}\left( A_{b}v_{d}\right) =\left( 
\boldsymbol{e}_{d}\right) \mathcal{R}_{e_{d}}\left( A_{b}\right) \mathcal{R}%
_{e_{d}}\left( v_{d}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}%
_{e_{d}}\left( d\left( Av\right) \right) =\left( \boldsymbol{e}_{d}\right) 
\mathcal{R}_{e}\left( Av\right)
\end{equation}%
hence using the duality injection $d$ gives 
\begin{gather}
A_{b}v_{d} \\
\parallel \\
\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( A_{b}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{b}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( A_{b}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{b}\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{d}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right)
\end{gather}%
showing that 
\begin{equation}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{d}}\left( A_{d}\right) _{r}^{1} & \cdots & \mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ,
\end{equation}%
i.e. that \label{09/11} 
\begin{equation}
\mathcal{M}_{e_{d}}\left( A_{d}\right) _{\func{row},\func{col}}=\mathcal{R}%
_{e_{d}}\left( A_{d}\right) _{\func{row}}^{\func{col}}.\blacksquare
\end{equation}

\begin{definition}
Biorthogonality Preserving Map $b\in \mathcal{L}\left( \overset{}{\mathcal{L}%
\left( V^{d}\right) ,\mathcal{L}\left( V\right) }\right) :$ Let $A\in
GL\left( V\right) $ then $A$ induces a transformation $b\left( A\right) \in 
\mathcal{L}\left( V^{d}\right) $, where $b\in \mathcal{L}\left( \overset{}{%
\mathcal{L}\left( V^{d}\right) ,\mathcal{L}\left( V\right) }\right) $,
(which is not the dual transformation map $d_{e}$),\label{biorthogonality
preserving map}%
\begin{equation}
b:\mathcal{L}\left( V\right) \rightarrow \mathcal{L}\left( V^{d}\right)
\end{equation}%
i.e. 
\begin{equation}
b\left( A\right) =A_{b}\in \mathcal{L}\left( V^{d}\right)
\end{equation}%
is defined by 
\begin{equation}
b\left( A\right) \left( \boldsymbol{e}_{d}\right) =A_{b}\left( \boldsymbol{e}%
_{d}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left(
A_{b}\right) =\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left(
A\right) ^{-t}=\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ^{-t}.
\end{equation}
\end{definition}

\begin{theorem}
\label{Biorthogonality Theorem} Let $A\in GL\left( V\right) $ be a basis
transformation defined by 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=A\left( \boldsymbol{e}\right) ^{t}=\left( 
\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right)
\end{equation}%
then the transformation $b\left( A\right) $ produces a transformation of the
basis $\left( \boldsymbol{e}_{b}\right) $ 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=b\left( A\right) \left( \boldsymbol{e}%
_{b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e_{b}}\left( b\left( A\right) \right)
\end{equation}%
such that $\left( \boldsymbol{f}_{b}\right) $ is biorthogonal to the basis $%
\left( \boldsymbol{f}\right) $ and is given by 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=b\left( A\right) \left( \boldsymbol{e}%
_{b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e_{b}}\left( b\left( A\right) \right) =\left( \boldsymbol{e}_{b}\right)
^{t}\mathcal{R}_{e}\left( A\right) ^{-t}
\end{equation}%
and has a SVD 
\begin{equation}
b\left( A\right) =\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e_{b}}\left( A\right) ^{-t}\left( \boldsymbol{e}_{bb}\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}\left[ \left( 
\begin{array}{c}
e_{bb1} \\ 
\vdots \\ 
e_{bbr}%
\end{array}%
\right) \right] ,
\end{equation}%
where $\left( \boldsymbol{e}_{bb}\right) =\left( 
\begin{array}{ccc}
e_{bb1} & \cdots & e_{bbr}%
\end{array}%
\right) $ is a biorthogonal basis to $\left( \boldsymbol{e}_{b}\right) $ and
the identification 
\begin{equation}
e_{j}\rightarrow \boldsymbol{e}_{bbj},\quad 1\leq j\leq r
\end{equation}%
defines an injection 
\begin{equation}
V\hookrightarrow V^{dd}.
\end{equation}
\end{theorem}

\begin{proof}
\begin{enumerate}
\item 
\begin{eqnarray}
\left[ \left( \boldsymbol{f}_{b}\right) \right] &=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left[ \left( \overset{}{\left( \boldsymbol{e}_{b}\right)
^{t}\mathcal{R}_{e}\left( A\right) ^{-t}}\right) ^{t}\right] =\left[ \left( 
\overset{}{\mathcal{R}_{e}\left( A\right) ^{-1}}\left( \boldsymbol{e}%
_{b}\right) \right) \right] =\mathcal{R}_{e}\left( A\right) ^{-1}\left[
\left( \boldsymbol{e}_{b}\right) \right] =\mathcal{R}_{e}\left( A\right)
^{-1}\left[ \left( \boldsymbol{e}_{b}\right) \right] \\
&=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] .
\end{eqnarray}

\item 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right)
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) .
\end{equation}

\item 
\begin{eqnarray}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
f^{1}\left( f_{1}\right) & \cdots & f^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( f_{1}\right) & \cdots & f^{r}\left( f_{r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left(
A\right) \\
&=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{r}%
\end{array}%
\right) \mathbb{I}_{r}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
&=&\mathbb{I}_{r}.\blacksquare
\end{eqnarray}
\end{enumerate}
\end{proof}

\begin{theorem}
Biorthogonality Theorem version 2 \label{Biorthogonality Theorem copy(1)}
Let $A\in GL\left( V\right) $ and $\left\{ \left( \boldsymbol{e}_{b}\right)
,\left( \boldsymbol{e}\right) \right\} $ be biorthogonal bases of $\left\{
V^{d},V\right\} $ then the bases $\left\{ \left( \boldsymbol{f}_{d}\right)
,\left( \boldsymbol{f}\right) \right\} ,$ defined by 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=\left( A\boldsymbol{e}\right) ^{t}
\end{equation}%
and 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=\left( A_{b}\boldsymbol{e}_{b}\right)
^{t}=b\left( A\right) \left( \boldsymbol{e}_{b}\right) ^{t}
\end{equation}%
are biorthogonal.
\end{theorem}

\begin{proof}
\begin{enumerate}
\item 
\begin{equation}
A_{b}\left( \boldsymbol{e}\right) _{b}=A_{b}\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( A_{b}\right)
\end{equation}

\item 
\begin{equation}
\left( A_{b}\left( \boldsymbol{e}\right) _{b}\right) ^{t}=\left( A_{b}\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \right) ^{t}=\left( \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \mathcal{R}_{e_{b}}\left( A_{b}\right) \right) ^{t}=\mathcal{R}%
_{e_{b}}\left( A_{b}\right) ^{t}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right)
\end{equation}

\item 
\begin{eqnarray}
\left[ \left( \boldsymbol{f}_{b}\right) ^{t}\right] \left( \boldsymbol{f}%
\right) &=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\left[ \left( A_{b}\left( \boldsymbol{e}\right) _{b}\right) ^{t}\right]
\left( A\left( \boldsymbol{e}\right) \right) &=&\mathcal{R}_{e_{b}}\left(
A_{b}\right) ^{t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \\
&=&\mathcal{R}_{e_{b}}\left( A_{b}\right) ^{t}\left[ \overset{}{\left( 
\boldsymbol{e}_{b}\right) ^{t}}\right] \left( \overset{}{\boldsymbol{e}}%
\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e_{b}}\left(
A_{b}\right) ^{t}\mathcal{R}_{e}\left( A\right)
\end{eqnarray}

\item If $\left\{ \left( \boldsymbol{f}_{b}\right) ,\left( \boldsymbol{f}%
\right) \right\} $ are biorthogonal then 
\begin{equation}
\mathcal{R}_{e_{d}}\left( A_{b}\right) ^{t}\mathcal{R}_{e}\left( A\right) =%
\mathbb{I}_{r}\Leftrightarrow \mathcal{R}_{e_{b}}\left( A_{b}\right) ^{t}=%
\mathcal{R}_{e}\left( A\right) ^{-1}\Leftrightarrow \mathcal{R}%
_{e_{b}}\left( A_{b}\right) =\mathcal{R}_{e}\left( A\right) ^{-t}\blacksquare
\end{equation}
\end{enumerate}
\end{proof}

\begin{theorem}
\label{Covariant Theorem} Let $A\in GL\left( V\right) $ then the induced
basis change $b\left( A\right) $ of $V^{d}$ 
\begin{equation}
b\left( A\right) :\left( \boldsymbol{e}_{b}\right) ^{t}\rightarrow \left( 
\boldsymbol{f}_{b}\right) ^{t}=\left( \overset{}{b\left( A\right) 
\boldsymbol{e}_{b}}\right) ^{t}
\end{equation}%
the coordinates of the representation $\mathcal{R}_{e_{b}}\left(
v_{d}\right) $ of the vector $v_{d}$ transform by the matrix representation $%
\mathcal{R}_{e}\left( A\right) $ of $A$ wrt the basis $\left( \boldsymbol{e}%
\right) $ i.e. 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) =\mathcal{R}_{e_{b}}\left( b\left(
A\right) \right) \mathcal{R}_{e}\left( v_{d}\right) =\mathcal{R}_{e}\left(
A\right) \mathcal{R}_{e}\left( v_{d}\right) .
\end{equation}

\begin{proof}
\begin{enumerate}
\item 
\begin{eqnarray}
\left[ \left( \boldsymbol{f}_{b}\right) \right] \left( \boldsymbol{f}\right)
^{t} &=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
\left[ \left( b\left( A\right) \left( \boldsymbol{e}\right) _{b}\right) ^{t}%
\right] \left( A\left( \boldsymbol{e}\right) \right) &=&\mathcal{R}%
_{e_{b}}\left( b\left( A\right) \right) ^{t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \\
&=&\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) ^{t}\left[ \overset{}{%
\left( \boldsymbol{e}_{b}\right) ^{t}}\right] \left( \overset{}{\boldsymbol{e%
}}\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e_{b}}\left( b\left(
A\right) \right) ^{t}\mathcal{R}_{e}\left( A\right) =\mathbb{I}_{r}
\end{eqnarray}%
hence%
\begin{equation}
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) ^{t}=\mathcal{R}%
_{e}\left( A\right) ^{-1}.
\end{equation}

\item 
\begin{eqnarray}
b\left( A\right) v_{d} &=&\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}%
_{e_{b}}\left( \overset{}{b\left( A\right) }\right) \mathcal{R}%
_{e_{b}}\left( \overset{}{v_{d}}\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{1}^{1} & \cdots & 
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{r}^{1} & \cdots & 
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \\
&=&\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( A\right) \mathcal{R}_{e_{b}}\left( \overset{}{v_{d}}%
\right) \\
&=&\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( v_{d}\right) _{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( v\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( v\right) _{r}%
\end{array}%
\right) ,
\end{eqnarray}%
hence 
\begin{equation}
\mathcal{R}_{f_{b}}\left( v_{d}\right) =\mathcal{R}_{e}\left( A\right) 
\mathcal{R}_{e_{b}}\left( v_{d}\right) .\blacksquare
\end{equation}
\end{enumerate}
\end{proof}
\end{theorem}

\begin{remark}
The reason why $v_{d}\in V^{d}$ are called \emph{covariant} vectors is that
their coordinates transform in the same way as the bases vectors $\left( 
\boldsymbol{e}\right) $ of $V$ i.e the basis transforms via a transformation
matrix $\mathcal{R}_{e}\left( A\right) $ and the coordinates of $v_{d}$ wrt
a biorthogonal basis $\left( \boldsymbol{e}_{b}\right) $ of $V^{d}$ by the
same transformation matrix $\mathcal{R}_{e}\left( A\right) $ thus they
transform in covariant manner to the bases of $V.$
\end{remark}

\begin{remark}
The Duality and Biorthogonality maps have the properties

\begin{enumerate}
\item 
\begin{enumerate}
\item 
\begin{equation}
d_{e}\left( \boldsymbol{e}\right) =\boldsymbol{e}_{d}
\end{equation}

\item 
\begin{equation}
b\left( \boldsymbol{e}\right) =\boldsymbol{e}_{b}
\end{equation}

\item 
\begin{equation}
b\left( \boldsymbol{e}\right) =d_{e}\left( \boldsymbol{e}\right)
\end{equation}

\item 
\begin{equation}
\boldsymbol{e}_{d}=\boldsymbol{e}_{b}
\end{equation}
\end{enumerate}

\item 
\begin{equation}
d_{e}\left( v\right) =\left( d_{e}\left( \boldsymbol{e}\right) \right) 
\mathcal{R}_{e_{d}}\left( v_{d_{e}}\right) =\left( d_{e}\left( \boldsymbol{e}%
\right) \right) \mathcal{R}_{e_{d}}\left( v_{d_{e}}\right) =\left(
d_{e}\left( \boldsymbol{e}\right) \right) \mathcal{R}_{e}\left( v\right)
=\left( b\left( \boldsymbol{e}\right) \right) \mathcal{R}_{e}\left( v\right)
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
b\left( v\right) =\left( b_{e}\left( \boldsymbol{e}\right) \right) \mathcal{R%
}_{e_{b}}\left( v_{d_{e}}\right) =\left( b\left( \boldsymbol{e}\right)
\right) \mathcal{R}_{e_{b}}\left( v_{d_{e}}\right) =\left( b\left( 
\boldsymbol{e}\right) \right) \mathcal{R}_{e}\left( v\right)
\end{equation}

\item 
\begin{equation}
d\left( Av\right) =d\left( A\right) d\left( v\right) =A^{d}d\left( v\right)
=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}%
_{e}\left( v\right)
\end{equation}

\item 
\begin{equation}
b\left( Av\right) =b\left( A\right) b\left( v\right) =A_{b}b\left( v\right)
=\left( \boldsymbol{e}_{d}\right) \mathcal{R}_{e}\left( A\right) ^{-1}%
\mathcal{R}_{e}\left( v\right)
\end{equation}
\end{enumerate}

\item 
\begin{equation}
\mathcal{R}_{e_{d}}\left( d\left( Av\right) \right) =\mathcal{R}_{e}\left(
A\right)
\end{equation}%
and 
\begin{equation}
\mathcal{R}_{e_{b}}\left( b\left( A\right) \right) =\mathcal{R}_{e}\left(
A^{-1}\right) .
\end{equation}
\end{enumerate}
\end{remark}

\begin{lemma}
\label{Scalar Product} The scalar product $h_{d}\left( v\right) $ between $%
h_{d}$ and $v$ is invariant to biorthogonal bases used in the expansions of $%
h_{d}$ and $v.$
\end{lemma}

\begin{proof}
The scalar product $h_{d}\left( v\right) $ can be expanded as

\begin{enumerate}
\item 
\begin{enumerate}
\item The transformation of the vector space basis $\left( \boldsymbol{e}%
\right) $ is 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=A\left( \boldsymbol{e}\right) ^{t}=\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right]
\left( \boldsymbol{e}\right) ^{t}\equiv \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right)
\end{equation}

\item The transformation $b\left( A\right) $ of the dual vector space basis $%
\left( \boldsymbol{e}_{b}\right) $ induced by $A$ that preserves
biorthogonaliy is 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=\left( \overset{}{b\left( A\right) }%
\right) \left( \boldsymbol{e}_{b}\right) ^{t}=\left( \boldsymbol{f}%
_{b}\right) ^{t}\left[ \left( \boldsymbol{e}_{bb}\right) \right] \left( 
\boldsymbol{e}_{b}\right) ^{t}\equiv \left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}=\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right)
\end{equation}%
after noting that 
\begin{equation}
\left( 
\begin{array}{ccc}
e_{bb1} & \cdots & e_{bbr}%
\end{array}%
\right) \leftrightarrow \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right)
\end{equation}%
as 
\begin{equation}
e_{bbj}\left( e_{bk}\right) =e_{bb}^{j}\left( e^{k}\right) =e_{bk}\left(
e_{j}\right) =e^{k}\left( e_{j}\right) ,
\end{equation}%
so that 
\begin{equation}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] .
\end{equation}

\item This confirmed by 
\begin{equation}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}
\end{enumerate}

\item The biorthogonality condition is \label{biorthogonality condition}

\begin{enumerate}
\item 
\begin{equation}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\mathbb{I}_{r}
\end{equation}%
can be analyzed in detail by

\item 
\begin{eqnarray}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) &=&b\left( A\right) ^{t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( b\left( A\right) \right) _{1}^{1} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( b\left( A\right) \right) _{r}^{1} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{r}^{r}%
\end{array}%
\right) ^{t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
&=&\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( b\left( A\right) \right) _{1}^{1} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{1}^{r} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( b\left( A\right) \right) _{r}^{1} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( b\left( A\right) \right) _{1}^{1} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( b\left( A\right) \right) _{1}^{r} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \\
&=&\mathbb{I}_{r}
\end{eqnarray}

\item Hence 
\begin{equation}
\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( b\left( A\right) \right) _{1}^{1} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( b\left( A\right) \right) _{1}^{r} & \cdots & \mathcal{R%
}_{e}\left( b\left( A\right) \right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}=\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{1} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A^{-1}\right) _{1}^{r} & \cdots & \mathcal{R}%
_{e}\left( A^{-1}\right) _{r}^{r}%
\end{array}%
\right) ,
\end{equation}

\item where 
\begin{equation}
A=\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}%
and

\item 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=A\left( \boldsymbol{e}\right) ^{t}=\left( 
\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right) \equiv \left( 
\overset{}{\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] }\right) \left( \boldsymbol{e}\right) ^{t}=\left( 
\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] }%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) .
\end{equation}

\item 
\begin{equation}
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =b\left( A\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) ^{-1}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}
\end{enumerate}

\item The \emph{scalar product} $h_{d}\left( v\right) $ is given by 
\begin{gather}
h_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \\
\parallel \\
\left( \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left( A\right) ^{-1}%
\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \right) \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left( A\right)
^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \right) \\
\parallel \\
\left( \left[ \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \right] \mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}_{e}\left(
A\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \right) ^{t}\left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \mathcal{R}_{e}\left( A\right)
^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \right)
\end{gather}%
\begin{gather}
\parallel \\
\left( \left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t}\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-t}\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \right) \times \\
\times \left( \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) \right) .
\end{gather}%
Showing that

\item 
\begin{equation}
h_{d}\left( v\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( h_{d}\right) _{1}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) ,
\end{equation}%
where the coordinates of linear functionals i.e. dual vectors $h_{d}$
transform as 
\begin{gather}
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{t} \\
\parallel \\
\left( 
\begin{array}{ccc}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} & \cdots & \mathcal{R}%
_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\mathcal{R}_{e_{b}}\left( h_{b}\right) ^{t}\mathcal{R}_{e}\left(
A\right) ^{t} \\
\Updownarrow \\
\left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left( 
\begin{array}{c}
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{e_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) \\
\parallel \\
\left( 
\begin{array}{c}
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{1} \\ 
\vdots \\ 
\mathcal{R}_{f_{b}}\left( h_{d}\right) _{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) \mathcal{R}_{e_{b}}\left(
h_{d}\right)
\end{gather}%
and the coordinates of vectors $v$ transform as

\item 
\begin{equation}
\left( 
\begin{array}{c}
\mathcal{R}_{f}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{f}\left( v\right) ^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) ^{-1}\left( 
\begin{array}{c}
\mathcal{R}_{e}\left( v\right) ^{1} \\ 
\vdots \\ 
\mathcal{R}_{e}\left( v\right) ^{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) ^{-1}\mathcal{R}_{e}\left( v\right) .
\end{equation}

\item 
\begin{gather}
b\left( A\right) \left( \boldsymbol{e}\right) =\left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right) ^{-t}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \\
\Updownarrow \\
\left( 
\begin{array}{ccc}
f^{1} & \cdots & f^{r}%
\end{array}%
\right) =b\left( A\right) \left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1} & \cdots & e^{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ^{-1},
\end{gather}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}_{b}\right) ^{t}=b\left( A\right) ^{-1}\left( 
\boldsymbol{e}_{b}\right) ^{t}=\left( \boldsymbol{e}_{b}\right) ^{t}\mathcal{%
R}_{e}\left( A\right) ^{-1}
\end{equation}%
where

\item 
\begin{equation}
\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) ,
\end{equation}%
i.e. 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=A\left( \boldsymbol{e}\right) ^{t}=\left( 
\boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left( A\right) .
\end{equation}
\end{enumerate}
\end{proof}

\begin{remark}
Thus 
\begin{equation}
\left[ \left( \boldsymbol{f}_{b}\right) \right] \left( \boldsymbol{f}\right)
^{t}=\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \mathcal{R}_{e}\left( A\right) ^{-1}\left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\mathbb{I}_{r}.\blacksquare
\end{equation}
\end{remark}

\subparagraph{Transformation of Bases \label{Transformation of Bases} \label%
{1}}

\begin{remark}
\begin{enumerate}
\item Let $A\in GL\left( V\right) $ and $\left\{ \left( \boldsymbol{e}%
\right) ,\left( \boldsymbol{f}\right) \right\} $ be two bases of $V$ then 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}=A\left( \boldsymbol{e}\right) ^{t}
\end{equation}%
and $A\ $can be expressed as 
\begin{equation}
A=\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] ,
\end{equation}%
which gives 
\begin{equation}
A=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}%
as 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] =A\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( \boldsymbol{e}\right) ^{t}\mathcal{R}_{e}\left(
A\right) \left[ \left( \boldsymbol{e}_{b}\right) \right] .
\end{equation}%
The representations of $A$ are given by 
\begin{equation}
A\left( \boldsymbol{e}\right) ^{t}=\left( \boldsymbol{e}\right) ^{t}\mathcal{%
R}_{e}\left( A\right) ,
\end{equation}%
where%
\begin{equation}
A\left( \boldsymbol{e}\right) ^{t}=\left( \boldsymbol{e}\right) ^{t}\mathcal{%
R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right)
\end{equation}%
$\lceil $ Note that 
\begin{equation}
\mathcal{R}_{e}\left( A\right) _{\func{col}}^{\func{row}}
\end{equation}%
$\rfloor $

\item and 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e}\left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] }%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( \overset{}{\left( \boldsymbol{f}\right) ^{t}\left[
\left( \boldsymbol{e}_{b}\right) \right] }\right) \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right)
\end{equation}

\item 
\begin{eqnarray}
\mathcal{R}_{e}\left( A\right) &=&\mathcal{M}_{e}\left( A\right) =\left( 
\boldsymbol{e}_{b}\right) A\left( \boldsymbol{e}\right) ^{t}=\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
&=&\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right)
\end{eqnarray}%
as 
\begin{equation}
\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\mathbb{I}_{r}.
\end{equation}

\item The preceding gives 
\begin{equation}
\mathcal{R}_{e}\left( A\right) =\left( \boldsymbol{e}_{b}\right) \left( 
\overset{}{\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] }\right) \left( \boldsymbol{e}\right) =\left( 
\boldsymbol{e}_{b}\right) \left( \boldsymbol{f}\right) ^{y}=\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right)
\end{equation}%
and 
\begin{gather}
A=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
\mathcal{R}_{e}\left( A\right) _{1}^{1} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{1} \\ 
\vdots & \ddots & \vdots \\ 
\mathcal{R}_{e}\left( A\right) _{1}^{r} & \cdots & \mathcal{R}_{e}\left(
A\right) _{r}^{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \\
=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] .
\end{gather}
\end{enumerate}
\end{remark}

\begin{remark}
The representation of $A$ on the $\left( \boldsymbol{f}\right) $ basis is
given by 
\begin{eqnarray}
\mathcal{R}_{f}\left( A\right) &=&\mathcal{R}_{f}\left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] }%
\right) =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
&=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \\
&=&\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right)
\end{eqnarray}%
i.e. 
\begin{equation}
\mathcal{R}_{f}\left( A\right) =\mathcal{R}_{f}\left( \overset{}{\left( 
\boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) \right] }%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) .
\end{equation}
\end{remark}

\begin{lemma}
\begin{equation}
\mathcal{R}_{f}\left( A\right) =\mathcal{R}_{e}\left( A\right)
\end{equation}
\end{lemma}

\begin{proof}
\begin{enumerate}
\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}

\begin{enumerate}
\item 
\begin{equation}
A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( A\right)
\end{equation}

\item 
\begin{eqnarray}
\mathcal{M}_{e}\left( A\right) &=&\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \\
&=&\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) =\mathcal{R}_{e}\left( A\right)
\end{eqnarray}%
and
\end{enumerate}

\begin{enumerate}
\item 
\begin{equation}
A\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( A\right)
\end{equation}

\item 
\begin{eqnarray}
\mathcal{M}_{f}\left( A\right) &=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( A\right) =\mathcal{R}_{f}\left( A\right) \\
&=&\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) =\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( A\right) =\left( 
\begin{array}{ccc}
e^{1}\left( f_{1}\right) & \cdots & e^{1}\left( f_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
e^{r}\left( f_{1}\right) & \cdots & e^{r}\left( f_{r}\right)%
\end{array}%
\right) \mathcal{R}_{f}\left( A\right) \blacksquare
\end{eqnarray}
\end{enumerate}
\end{enumerate}
\end{proof}

\begin{remark}
The definition of representations gives 
\begin{eqnarray}
A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) &=&\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \\
\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) &=&\left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\mathcal{R}_{e}\left( A\right) \\
\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) &=&\left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] \left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) =\left( 
\begin{array}{ccc}
f^{1}\left( e_{1}\right) & \cdots & f^{1}\left( e_{r}\right) \\ 
\vdots & \ddots & \vdots \\ 
f^{r}\left( e_{1}\right) & \cdots & f^{r}\left( e_{r}\right)%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right)
\end{eqnarray}
\end{remark}

\begin{remark}
\begin{enumerate}
\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{e}\left( A\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}

\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{f}\left( A\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right]
\end{equation}

\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \mathcal{R}_{fe}\left( A\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right]
\end{equation}

\item 
\begin{equation}
A=\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left( \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] A\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \mathcal{R}_{ef}\left( A\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right]
\end{equation}
\end{enumerate}
\end{remark}

\begin{theorem}
$\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{f}_{b}\right) %
\right] $ is the inverse of $\left( \boldsymbol{f}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{b}\right) \right] $ i.e. 
\begin{equation}
\left( \overset{}{\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{%
e}_{b}\right) \right] }\right) ^{-1}=\left( \boldsymbol{e}\right) ^{t}\left[
\left( \boldsymbol{f}_{b}\right) \right] .
\end{equation}

\begin{proof}
\begin{equation}
\left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{f}_{b}\right) %
\right] \left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}%
_{b}\right) \right] =\left( \boldsymbol{e}\right) ^{t}\left[ \left( 
\boldsymbol{e}_{b}\right) \right] =\left( 
\begin{array}{ccc}
e_{1} & \cdots & e_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots \\ 
e^{r}%
\end{array}%
\right) \right] =I_{r}
\end{equation}%
and 
\begin{equation}
\left( \boldsymbol{f}\right) ^{t}\left[ \left( \boldsymbol{e}_{b}\right) %
\right] \left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{b}\right) \right] =\left( \boldsymbol{f}\right) ^{t}\left[ \left( 
\boldsymbol{f}_{b}\right) \right] =\left( 
\begin{array}{ccc}
f_{1} & \cdots & f_{r}%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
f^{1} \\ 
\vdots \\ 
f^{r}%
\end{array}%
\right) \right] =I_{r}
\end{equation}
\end{proof}
\end{theorem}

\begin{remark}
\begin{equation}
\left( \left( \boldsymbol{e}\right) ^{t}\left[ \left( \boldsymbol{f}%
_{b}\right) \right] \right) ^{t}=\left( \boldsymbol{f}_{b}\right) ^{t}\left[ 
\overset{}{\left( \boldsymbol{e}_{bb}\right) }\right]
\end{equation}
\end{remark}

\subsection{Hilbert Space Example \label{Hilbert Space Example}}

Consider the unitary transformation $u_{fe}$ between conbs $\left\vert 
\boldsymbol{e}\right\rangle $ and $\left\vert \boldsymbol{f}\right\rangle $

\begin{equation}
\left\vert \boldsymbol{f}\right\rangle =u_{fe}\left\vert \boldsymbol{e}%
\right\rangle =\left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left(
u_{fe}\right) ,
\end{equation}%
where 
\begin{equation}
\left\vert \boldsymbol{a}\right\rangle =\left( 
\begin{array}{ccc}
\left\vert a_{1}\right\rangle & \cdots & \left\vert a_{r}\right\rangle%
\end{array}%
\right)
\end{equation}%
and 
\begin{equation}
\left\langle \boldsymbol{a}\right\vert =\left( 
\begin{array}{c}
\left\langle a_{1}\right\vert \\ 
\vdots \\ 
\left\langle a_{r}\right\vert%
\end{array}%
\right)
\end{equation}%
which can be represented in a ket-bra form as 
\begin{equation*}
u_{fe}\left\vert \boldsymbol{e}\right\rangle =\left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right)
\left\vert \boldsymbol{e}\right\rangle =\left\vert \boldsymbol{f}%
\right\rangle =\left\vert \boldsymbol{e}\right\rangle \left\langle \left. 
\boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle =I_{r}\left\vert 
\boldsymbol{f}\right\rangle ,
\end{equation*}%
The inverse of this transformation $u_{fe}^{-1}$, which is the adjoint $%
u_{fe}^{\dagger },$ can be represented in ket-bra form as 
\begin{equation*}
u_{fe}^{\dagger }\left\vert \boldsymbol{f}\right\rangle =\left( \overset{}{%
\left\vert \boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}%
\right\vert }\right) \left\vert \boldsymbol{f}\right\rangle =\left\vert 
\boldsymbol{f}\right\rangle \left\langle \left. \boldsymbol{f}\right\vert 
\boldsymbol{e}\right\rangle =I_{r}\left\vert \boldsymbol{e}\right\rangle .
\end{equation*}%
Hence 
\begin{eqnarray}
\left\vert \boldsymbol{f}\right\rangle &=&\left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right)
\left\vert \boldsymbol{e}\right\rangle =\left\vert \boldsymbol{e}%
\right\rangle \mathcal{R}_{e}\left( \overset{}{\left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert }\right) =\left\vert 
\boldsymbol{e}\right\rangle \left\langle \left. \boldsymbol{e}\right\vert 
\boldsymbol{f}\right\rangle \\
\left\vert \boldsymbol{e}\right\rangle &=&\left( \overset{}{\left\vert 
\boldsymbol{e}\right\rangle \left\langle \boldsymbol{f}\right\vert }\right)
\left\vert \boldsymbol{f}\right\rangle =\left\vert \boldsymbol{f}%
\right\rangle \mathcal{R}_{f}\left( \overset{}{\left\vert \boldsymbol{e}%
\right\rangle \left\langle \boldsymbol{f}\right\vert }\right) =\left\vert 
\boldsymbol{f}\right\rangle \left\langle \left. \boldsymbol{f}\right\vert 
\boldsymbol{e}\right\rangle ,
\end{eqnarray}%
where 
\begin{equation}
\left\langle \left. \boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle
=\left( 
\begin{array}{ccc}
\left\langle \left. e_{1}\right\vert f_{1}\right\rangle & \cdots & 
\left\langle \left. e_{1}\right\vert f_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. er\right\vert f_{1}\right\rangle & \cdots & \left\langle
\left. e_{r}\right\vert f_{r}\right\rangle%
\end{array}%
\right) =\left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. fr\right\vert e_{1}\right\rangle & \cdots & \left\langle
\left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right) ^{\dagger }=\left( 
\begin{array}{ccc}
\left\langle \left. f_{1}\right\vert e_{1}\right\rangle & \cdots & 
\left\langle \left. f_{1}\right\vert e_{r}\right\rangle \\ 
\vdots & \ddots & \vdots \\ 
\left\langle \left. fr\right\vert e_{1}\right\rangle & \cdots & \left\langle
\left. f_{r}\right\vert e_{r}\right\rangle%
\end{array}%
\right) ^{-1}
\end{equation}

\begin{remark}
As the bases $\left\vert \boldsymbol{e}\right\rangle $ and $\left\vert 
\boldsymbol{f}\right\rangle $ are conbs:

\begin{enumerate}
\item The representation of $\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert $ wrt the $\left\vert \boldsymbol{e}%
\right\rangle $ basis is 
\begin{equation}
\mathcal{R}_{e}\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert }\right) =\left\langle \left. 
\boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle ,
\end{equation}%
which is by definition 
\begin{equation}
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \boldsymbol{e}\right\rangle
=\left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{e}\left( \overset{}{%
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right)
\end{equation}
as 
\begin{equation}
\mathcal{R}_{e}\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert }\right) =\mathcal{M}_{e}\left( 
\overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) =\left\langle \overset{}{\boldsymbol{e}}\right\vert
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \overset{}{\boldsymbol{e}}%
\right\rangle .
\end{equation}

\item The representation of $\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert $ wrt the $\left\vert \boldsymbol{f}%
\right\rangle $ basis i\emph{s the same, as} 
\begin{equation}
\mathcal{R}_{f}\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert }\right) =\left\langle \left. 
\boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle ,
\end{equation}%
which is by definition 
\begin{equation}
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \boldsymbol{f}\right\rangle
=\left\vert \boldsymbol{f}\right\rangle \mathcal{R}_{f}\left( \overset{}{%
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) ,
\end{equation}%
as 
\begin{equation}
\mathcal{R}_{f}\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert }\right) =\mathcal{M}_{f}\left( 
\overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) =\left\langle \overset{}{\boldsymbol{f}}\right\vert
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \overset{}{\boldsymbol{f}}%
\right\rangle .
\end{equation}

\item In SVD type form 
\begin{equation}
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert =\left\vert \boldsymbol{f}\right\rangle \mathcal{R}_{f}\left( 
\overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) \left\langle \boldsymbol{f}\right\vert =\left\vert 
\boldsymbol{e}\right\rangle \mathcal{R}_{e}\left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right)
\left\langle \boldsymbol{e}\right\vert .
\end{equation}

\item The representation of the {\large action} of $\left\vert \boldsymbol{f}%
\right\rangle \left\langle \boldsymbol{e}\right\vert $ on the $\left\vert 
\boldsymbol{f}\right\rangle $ basis in terms of vectors expanded in the $%
\left\vert \boldsymbol{e}\right\rangle $ basis is 
\begin{equation}
\mathcal{R}_{fe}\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert }\right) =\left\langle \left. 
\boldsymbol{e}\right\vert \boldsymbol{f}\right\rangle ^{2},
\end{equation}%
and is defined by 
\begin{equation}
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \boldsymbol{f}\right\rangle
=\left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{fe}\left( \overset{}{%
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) ,
\end{equation}%
which shows that 
\begin{eqnarray}
\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle 
\boldsymbol{e}\right\vert }\right) \left\vert \boldsymbol{f}\right\rangle
&=&\left\vert \boldsymbol{f}\right\rangle \left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle \\
&=&\left\vert \boldsymbol{e}\right\rangle \left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle \left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle \\
&=&\left\vert \boldsymbol{e}\right\rangle \left\langle \left. \boldsymbol{e}%
\right\vert \boldsymbol{f}\right\rangle ^{2}.
\end{eqnarray}%
and 
\begin{equation}
\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert =\left\vert \boldsymbol{f}\right\rangle \mathcal{R}_{f}\left( 
\overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) \left\langle \boldsymbol{f}\right\vert =\left\vert 
\boldsymbol{e}\right\rangle \mathcal{R}_{f}\left( \overset{}{\left\vert 
\boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}\right\vert }\right) 
\mathcal{R}_{f}\left( \overset{}{\left\vert \boldsymbol{f}\right\rangle
\left\langle \boldsymbol{e}\right\vert }\right) \left\langle \boldsymbol{f}%
\right\vert =\left\vert \boldsymbol{e}\right\rangle \mathcal{R}_{f}\left( 
\overset{}{\left\vert \boldsymbol{f}\right\rangle \left\langle \boldsymbol{e}%
\right\vert }\right) ^{2}\left\langle \boldsymbol{f}\right\vert .
\end{equation}
\end{enumerate}
\end{remark}

