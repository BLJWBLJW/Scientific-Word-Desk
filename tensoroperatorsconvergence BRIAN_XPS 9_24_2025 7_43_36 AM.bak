f_{1} & \cdots  & f_{r}%
\end{array}%
\right) \left( 
\begin{array}{ccc}
1 & \cdots  & 0 \\ 
\vdots  & \ddots  & \vdots  \\ 
0 & \cdots  & 1%
\end{array}%
\right) \left[ \left( 
\begin{array}{c}
e^{1} \\ 
\vdots  \\ 
e^{r}%
\end{array}%
\right) \right] =\sum_{1\leq j\leq r}f_{j}e^{j}.
\end{equation}
\end{enumerate}

\item 
\begin{eqnarray}
X &=&V^{d} \\
