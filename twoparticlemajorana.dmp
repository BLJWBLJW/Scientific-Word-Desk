\section{Majorana Expansion of a Two-Particle Operator}

\subsection*{1. Majorana Operator Basis}

\begin{enumerate}
\item The Majorana operators $\gamma_{i}$ are Hermitian and satisfy the
Clifford algebra:
\[
\{\gamma_{i},\gamma_{j}\}=2\delta_{ij}I_{\mathcal{H}_{\mathcal{F}}}%
\]
hence
\begin{equation}
\gamma_{i}^{2}=I_{\mathcal{H}_{\mathcal{F}}}%
\end{equation}
and
\begin{equation}
\gamma_{i}\gamma_{j}=-\gamma_{j}\gamma_{i}.
\end{equation}
For a system with $r$ fermionic modes, we define $2r$ Majorana operators in
terms of creation ($a_{i}^{\dagger}$) and annihilation ($a_{i}$) operators:
\[
\gamma_{2i-1}=a_{i}+a_{i}^{\dagger},\quad\gamma_{2i}=-i(a_{i}-a_{i}^{\dagger
}).
\]
giving
\begin{equation}
\left(  \boldsymbol{\gamma}\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1} & \boldsymbol{\gamma}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  .
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{1}\\
\boldsymbol{\gamma}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
i\mathbb{I}_{r} & -i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{a}^{\dagger}\\
\boldsymbol{a}%
\end{array}
\right)  .
\end{equation}


\item The inverse relations are:
\[
a_{i}=\frac{1}{2}(\gamma_{2i-1}+i\gamma_{2i}),\quad a_{i}^{\dagger}=\frac
{1}{2}(\gamma_{2i-1}-i\gamma_{2i})
\]
giving
\begin{equation}
\left(  \boldsymbol{a}^{\dagger},\boldsymbol{a}\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1} & \boldsymbol{\gamma}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{I}_{r}\\
-i\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)  .
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{c}%
\boldsymbol{a}^{\dagger}\\
\boldsymbol{a}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & -i\mathbb{I}_{r}\\
\mathbb{I}_{r} & i\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{1}\\
\boldsymbol{\gamma}_{2}%
\end{array}
\right)  .
\end{equation}


\item
\begin{align}
\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{0}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1} & \boldsymbol{\gamma}_{2}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}\\
-i\mathbb{I}_{r} & \mathbb{O}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2} & \boldsymbol{0}%
\end{array}
\right) \\
\left(
\begin{array}
[c]{c}%
\boldsymbol{a}\\
\boldsymbol{0}%
\end{array}
\right)   &  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & i\mathbb{I}_{r}\\
\mathbb{O} & \mathbb{O}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{1}\\
\boldsymbol{\gamma}_{2}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{1}+i\boldsymbol{\gamma}_{2}\\
\boldsymbol{0}%
\end{array}
\right)
\end{align}


\item
\begin{align}
\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}\right)   &  =\left(
\begin{array}
[c]{cc}%
\boldsymbol{a}^{\dagger} & \boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{a}\\
\boldsymbol{0}%
\end{array}
\right)  =\frac{1}{2}\left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2} & \boldsymbol{0}%
\end{array}
\right)  \frac{1}{2}\left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{1}+i\boldsymbol{\gamma}_{2}\\
\boldsymbol{0}%
\end{array}
\right)  =\frac{1}{4}\left(  \boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}%
_{2}\right)  \left(  \boldsymbol{\gamma}_{1}+i\boldsymbol{\gamma}_{2}\right)
\\
&  =\frac{1}{4}\left(  \boldsymbol{\gamma}_{1}\boldsymbol{\gamma}%
_{1}+i\boldsymbol{\gamma}_{1}\boldsymbol{\gamma}_{2}-i\boldsymbol{\gamma}%
_{2}\boldsymbol{\gamma}_{1}+\boldsymbol{\gamma}_{2}\boldsymbol{\gamma}%
_{2}\right)  =\frac{1}{4}\left(  \boldsymbol{\gamma}_{1}\boldsymbol{\gamma
}_{1}+\boldsymbol{\gamma}_{2}\boldsymbol{\gamma}_{2}+i\left(
\boldsymbol{\gamma}_{1}\boldsymbol{\gamma}_{2}-\boldsymbol{\gamma}%
_{2}\boldsymbol{\gamma}_{1}\right)  \right)
\end{align}
giving
\begin{equation}
a_{j}^{\dagger}a_{k}=\frac{1}{4}\left(  \boldsymbol{\gamma}_{j}%
\boldsymbol{\gamma}_{k}+i\boldsymbol{\gamma}_{j}\boldsymbol{\gamma}%
_{k+r}-i\boldsymbol{\gamma}_{j+r}\boldsymbol{\gamma}_{k}+\boldsymbol{\gamma
}_{j+r}\boldsymbol{\gamma}_{k+r}\right)  =\frac{1}{4}\left(
\boldsymbol{\gamma}_{j}\boldsymbol{\gamma}_{k}+\boldsymbol{\gamma}%
_{j+r}\boldsymbol{\gamma}_{k+r}+i\left(  \boldsymbol{\gamma}_{j}%
\boldsymbol{\gamma}_{k+r}-\boldsymbol{\gamma}_{j+r}\boldsymbol{\gamma}%
_{k}\right)  \right)  ,\quad1\leq j,k\leq r.
\end{equation}


\item
\begin{align}
&  \left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}^{\dagger}\boldsymbol{aa}%
\right)  =\left(  \boldsymbol{a}^{\dagger}\right)  \left(  \boldsymbol{a}%
^{\dagger}\right)  \left(  \boldsymbol{a}\right)  \left(  \boldsymbol{a}%
\right)  =\left(  \left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger} & \cdots & a_{r}^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger} & \cdots & a_{r}^{\dagger}%
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
a_{1}\\
\vdots\\
a_{r}%
\end{array}
\right)  \right)  \\
&  =\frac{1}{16}\left(  \left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2} & \boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2} & \boldsymbol{0}%
\end{array}
\right)  \right)  \left(  \left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{3}+i\boldsymbol{\gamma}_{4}\\
\boldsymbol{0}%
\end{array}
\right)  \left(
\begin{array}
[c]{c}%
\boldsymbol{\gamma}_{3}+i\boldsymbol{\gamma}_{4}\\
\boldsymbol{0}%
\end{array}
\right)  \right)  \\
&  =\frac{1}{16}\left(  \left(
\begin{array}
[c]{cccc}%
\left(  \boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2}\right)  \left(
\boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2}\right)   & \boldsymbol{0} &
\boldsymbol{0} & \boldsymbol{0}%
\end{array}
\right)  \right)  \left(
\begin{array}
[c]{c}%
\left(  \boldsymbol{\gamma}_{3}+i\boldsymbol{\gamma}_{4}\right)  \left(
\boldsymbol{\gamma}_{3}+i\boldsymbol{\gamma}_{4}\right)  \\
\boldsymbol{0}\\
\boldsymbol{0}\\
\boldsymbol{0}%
\end{array}
\right)  \\
&  =\frac{1}{16}\left(  \left(  \boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma
}_{2}\right)  \left(  \boldsymbol{\gamma}_{1}-i\boldsymbol{\gamma}_{2}\right)
\left(  \boldsymbol{\gamma}_{3}+i\boldsymbol{\gamma}_{4}\right)  \left(
\boldsymbol{\gamma}_{3}+i\boldsymbol{\gamma}_{4}\right)  \right)
\end{align}
This gives
\begin{align*}
a_{j}^{\dagger}a_{k}^{\dagger}a_{l}a_{m} &  =\frac{1}{16}(\gamma
_{2j-1}-i\gamma_{2j})(\gamma_{2k-1}-i\gamma_{2k})(\gamma_{2l-1}+i\gamma
_{2l})(\gamma_{2m-1}+i\gamma_{2m}),\\
\quad1 &  \leq j<k\leq r,1\leq l<m\leq r
\end{align*}
in particular
\[
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{j}=n_{j}n_{k}=\frac{1}{2}\left(
I_{\mathcal{H}_{\mathcal{F}}}+i\gamma_{2j-1}\gamma_{2j}\right)  \frac{1}%
{2}\left(  I_{\mathcal{H}_{\mathcal{F}}}+i\gamma_{2k-1}\gamma_{2k}\right)
=\frac{1}{4}\left(  I_{\mathcal{H}_{\mathcal{F}}}+i\gamma_{2j-1}\gamma
_{2j}+i\gamma_{2k-1}\gamma_{2k}-\gamma_{2j-1}\gamma_{2j}\gamma_{2k-1}%
\gamma_{2k}\right)  .
\]


\item
\begin{align}
a_{j}^{\dagger}a_{k}^{\dagger}a_{k}a_{l}  & =\frac{1}{8}\left\{  \gamma
_{2j-1}\gamma_{2l-1}\gamma_{2k-1}\gamma_{2k}+i\gamma_{2j-1}\gamma_{2l}%
\gamma_{2k-1}\gamma_{2k}-i\gamma_{2j}\gamma_{2l-1}\gamma_{2k-1}\gamma
_{2k}+\gamma_{2j}\gamma_{2l}\gamma_{2k-1}\gamma_{2k}\right.  \\
& +\left.  i\gamma_{2j-1}\gamma_{2l-1}\gamma_{2k-1}\gamma_{2k}-\gamma
_{2j-1}\gamma_{2l}\gamma_{2k-1}\gamma_{2k}+\gamma_{2j}\gamma_{2l-1}%
\gamma_{2k-1}\gamma_{2k}+i\gamma_{2j}\gamma_{2l}\gamma_{2k-1}\gamma
_{2k}\right\}
\end{align}

\end{enumerate}

\subsection*{2. General Two-Particle Operator in Second Quantization}

A general two-particle operator $\hat{O}$ is written as:
\[
\hat{O}=\sum_{i,j,k,l}O_{ijkl}\,a_{i}^{\dagger}a_{j}^{\dagger}a_{k}a_{l}%
=\frac{1}{4}\sum_{i<j<k<l}O_{ijkl}\,a_{i}^{\dagger}a_{j}^{\dagger}a_{k}a_{l},
\]
where $O_{ijkl}$ are antisymmetric under $i\leftrightarrow j$ or
$k\leftrightarrow l$.

\begin{example}
Coulomb Interaction
\end{example}

For electrons in a basis $\{\phi_{j}(\mathbf{r})\}$:
\[
O_{jklm}=V_{jklm}=\int d\mathbf{r}_{1}d\mathbf{r}_{2}\phi_{j}^{\ast
}(\mathbf{r}_{1})\phi_{k}^{\ast}(\mathbf{r}_{2})\frac{e^{2}}{|\mathbf{r}%
_{1}-\mathbf{r}_{2}|}\phi_{l}(\mathbf{r}_{1})\phi_{m}(\mathbf{r}_{2}).
\]


\subsection*{Basis Construction}

The field operator basis for second degree particle conserving operators is
\begin{equation}
\left(  \boldsymbol{a}^{\dagger}\boldsymbol{a}^{\dagger}\boldsymbol{aa}%
\right)  =\left(
\begin{array}
[c]{ccc}%
a_{1}^{\dagger}a_{2}^{\dagger}a_{1}a_{2} & \cdots & a_{r-1}^{\dagger}%
a_{r}^{\dagger}a_{r-1}a_{r}%
\end{array}
\right)
\end{equation}


which transforms into the Majorana basis
\begin{equation}%
\begin{array}
[c]{ccc}%
\left\{  \overset{}{\left.  \frac{1}{4}\left(  I_{\mathcal{H}_{\mathcal{F}}%
}+i\gamma_{2j-1}\gamma_{2j}+i\gamma_{2k-1}\gamma_{2k}-\gamma_{2j-1}\gamma
_{2j}\gamma_{2k-1}\gamma_{2k}\right)  \right\vert }1\leq j<k\leq r\right\}  &
\left\{  \overset{}{\left.  \gamma_{j}\gamma_{k}\right\vert 1\leq j<k\leq
2r}\right\}  & \left\{  \overset{}{\left.  \gamma_{j}\gamma_{k}\gamma
_{l}\gamma_{m}\right\vert 1\leq j<k<l<m\leq2r}\right\}
\end{array}
\end{equation}%
\begin{equation}
\#m=\binom{r}{2}+\binom{2r}{2}+\binom{2r}{4}=\binom{12}{2}+\binom{12}%
{2}+\binom{12}{4}=\left(  12\right)  \left(  11\right)
\end{equation}
let $r=3$%
\begin{equation}
12,13,23
\end{equation}%
\begin{equation}
\binom{6}{2}=15
\end{equation}%
\begin{equation}
12,13,14,15,16,23,24,25,26,34,35,36,45,46,56
\end{equation}%
\begin{equation}
\binom{6}{4}=15
\end{equation}%
\begin{equation}
1234,1235,1236,1245,1246,1256,1345,1346,1356,1456,2345,2346,2356,2456,3456
\end{equation}%
\begin{equation}
\#m=\left(  12\right)  \left(  11\right)  +\frac{30}{2}=45
\end{equation}%
\begin{equation}
\#_{a}=\binom{r}{2}^{2}=\frac{3^{2}\left(  2\right)  ^{2}}{4}=9
\end{equation}


\subsection*{Key Properties}

\begin{itemize}
\item \textbf{No identity term}: The coupled $I_{\mathcal{H}_{\mathcal{F}}}$
in $a_{j}^{\ast}a_{k}^{\ast}a_{j}a_{k}$ is absorbed into the coefficients of
$\mathcal{B}_{4}$

\item \textbf{Linear independence}: No linear combination of $\mathcal{B}%
_{2}\cup\mathcal{B}_{4}$ can produce $I_{\mathcal{H}_{\mathcal{F}}}$

\item \textbf{Physical interpretation}: The identity would represent a vacuum
energy shift, but normal-ordered $a_{j}^{\ast}a_{k}^{\ast}a_{l}a_{m}$
annihilates the vacuum $|0\rangle$
\end{itemize}

\subsection*{}

\subsection*{Conclusion}

For operators with two repeated indices (e.g., $a_{j}^{\dagger}a_{k}^{\dagger
}a_{j}a_{k}$):

\begin{itemize}
\item They map to a sum of $I_{\mathcal{H}_{\mathcal{F}}}$ and a degree-4
term, but the identity is not separable

\item The image space is spanned by:
\[
\mathcal{B=B}_{2}\cup\mathcal{B}_{4}=\{c_{\mu}c_{\nu}\mid\mu<\nu\}\cup
\{c_{\mu}c_{\nu}c_{\rho}c_{\sigma}\mid\mu<\nu<\rho<\sigma\}
\]
with no $I_{\mathcal{H}_{\mathcal{F}}}$ in the basis.
\end{itemize}

\subsection*{3. Expansion in Majorana Operators}

Substituting $a_{i}, a_{i}^{\dagger}$ in terms of $\gamma_{i}$, we expand
$\hat{O}$ into products of up to four Majorana operators, grouped by degree:

\subsubsection*{Degree 0 (Constant Term)}%

\[
CI_{\mathcal{H}_{\mathcal{F}}}=\operatorname*{Tr}(\hat{O})I_{\mathcal{H}%
_{\mathcal{F}}}=\frac{1}{2^{N}}\operatorname*{Tr}(\hat{O})I_{\mathcal{H}%
_{\mathcal{F}}}=\frac{1}{8}\sum_{i,j}O_{ijji}I_{\mathcal{H}_{\mathcal{F}}%
}\quad\text{(as previously derived)}.
\]


\subsubsection*{Degree 2 (Quadratic Terms)}

After full antisymmetrization and index relabeling:
\begin{equation}
\hat{O}_{2}=\sum_{j<k}\alpha_{jk}\gamma_{j}\gamma_{k},
\end{equation}
where
\[
\alpha_{jk}=\frac{1}{4}\sum_{r,s}%
\begin{cases}
\;\,\operatorname*{Re}(O_{jrsk}-O_{jsrk}) & \text{if }j=2m-1,k=2n-1\\
\;\,\operatorname*{Re}(O_{jrsk}+O_{jsrk}) & \text{if }j=2m,k=2n\\
-i\operatorname*{Im}(O_{jrsk}-O_{jsrk}) & \text{if }j=2m-1,k=2n\\
+i\operatorname*{Im}(O_{jrsk}+O_{jsrk}) & \text{if }j=2m,k=2n-1
\end{cases}
.
\]


\subsubsection*{Degree 4 (Quartic Terms)}

Fully uncontracted products of four Majorana operators:
\[
\hat{O}_{4}=\sum_{i<j<k<l}\beta_{ijkl}\,\gamma_{i}\gamma_{j}\gamma_{k}%
\gamma_{l},
\]
where the coefficients $\beta_{ijkl}$ are given by the fully antisymmetrized
expression becomes:
\[
\beta_{ijkl}=\frac{1}{16}\sum_{\substack{\sigma\in S_{4}\\\text{distinct
}i,j,k,l}}\text{sgn}(\sigma)\tilde{O}_{\sigma(p)\sigma(q)\sigma(r)\sigma(s)},
\]
where $\tilde{O}_{pqrs}$ maps fermionic indices to Majorana indices:
\[
\tilde{O}_{pqrs}=%
\begin{cases}
\;\,O_{pqrs} & \text{even }\gamma\text{-parity}\\
-iO_{pqrs} & \text{odd }\gamma\text{-parity}%
\end{cases}
\]
The quartic coefficient $\beta_{ijkl}$ in the Majorana expansion is given by
the fully antisymmetrized combination:%

\[
\beta_{ijkl}=\frac{1}{16}\sum_{\sigma\in S_{4}}\text{sgn}(\sigma)\tilde
{O}_{\sigma(p)\sigma(q)\sigma(r)\sigma(s)}%
\]


where:

\begin{itemize}
\item $S_{4}$ is the symmetric group of all permutations of 4 elements

\item $\text{sgn}(\sigma)$ is the sign of the permutation ($+1$ for even, $-1$
for odd)

\item The indices $(i,j,k,l)$ correspond to the Majorana operator ordering

\item $(p,q,r,s)$ are the original fermionic mode indices mapped to
$(2p-1,2p,2q-1,2q)$.
\end{itemize}

This represents the sum over all 24 possible permutations of the four indices
with appropriate sign factors.

\subsection*{4. Final Majorana Expansion}

Combining all terms, the operator $\hat{O}$ becomes:
\[
\hat{O} = \sum_{i < j} \alpha_{ij} \, \gamma_{i} \gamma_{j} + \sum_{i < j < k
< l} \beta_{ijkl} \, \gamma_{i} \gamma_{j} \gamma_{k} \gamma_{l}.
\]


\subsection*{5. Key Observations}

\begin{itemize}
\item Quadratic terms ($\alpha_{ij}$) depend on off-diagonal elements of
$O_{ijkl}$.

\item Quartic terms ($\beta_{ijkl}$) are fully antisymmetrized four-Majorana
interactions.Consistency Checks
\end{itemize}

\begin{enumerate}
\item \textbf{Antisymmetry Preservation}: All coefficients satisfy:
\[
\alpha_{pq} = -\alpha_{qp}, \quad\beta_{ijkl} = \text{totally antisymmetric}.
\]


\item \textbf{Trace Conditions}:
\[
\text{Tr}(\gamma_{i}\gamma_{j}) = 0, \quad\text{Tr}(\gamma_{i}\gamma_{j}%
\gamma_{k}\gamma_{l}) = 0 \quad\Rightarrow\quad\text{Tr}(\hat{O}) = 2^{N} C.
\]


\item \textbf{Example: Hubbard Interaction}: For $U\sum_{i}n_{i\uparrow
}n_{i\downarrow}$:
\[
C=\frac{UN}{8},\quad\alpha_{2i-1,2i}=\frac{U}{4},\quad\text{other }%
\alpha,\beta=0.
\]

\end{enumerate}


