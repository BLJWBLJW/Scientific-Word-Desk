@ARTICLE{Frenklach94,
  author = {M. Frenklach and S. Skokov and B. Weiner},
  month = {8 Dec.},
  year = 1994,
  title = {An atomistic model for stepped diamond growth},
  journal = {Nature},
  volume = 372,
  number = 6506,
  pages = {535-7},
  abstract = {The growth of many crystalline materials occurs through lateral
             propagation of steps over the surface. A stepped texture is also
             characteristic of diamond grown by chemical vapour deposition
             (CVD). Diffusion of atoms on the surface is usually held
             responsible for the stepped growth of metals, but it has been
             thought that the stronger bonding of adatoms should prevent this
             mechanism from operating in the case of diamond. Recent
             experiments have, however, indicated that surface diffusion can
             take place during diamond growth. We have recently shown
             theoretically that bridging methylene (CH/sub 2/) groups on the
             (100) plane of diamond growing in the presence of hydrogen can
             migrate in a manner equivalent to surface diffusion. Here we show
             that this theoretical picture can be developed into an atomistic
             model that accounts for stepped growth of diamond. The stepped
             pattern can be understood in terms of the formation of
             surface-bound species from the gaseous precursors, followed by
             their migration by means of a series of surface chemical
             reactions involving covalent bond breaking and formation.},
  keywords = {Chemical vapour deposition; Diamond; Surface chemistry; Surface
             diffusion; Surface texture; Stepped diamond growth; Atomistic
             model; Lateral propagation; Stepped texture; CVD; Stepped growth;
             Surface diffusion; Gaseous precursors; Surface chemical
             reactions; Covalent bond breaking; C},
  language = {English}
}
