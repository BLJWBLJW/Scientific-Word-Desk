@ARTICLE{Weiner99,
  author = {B. Weiner and S.B. Trickey},
  month = {28 April},
  year = 1999,
  title = {State energy functionals and variational equations in density
          functional theory},
  journal = {THEOCHEM},
  volume = {501-502},
  pages = {65-83},
  publisher = {Elsevier},
  abstract = {To resolve certain physical and mathematical problems in the
             customary Levy-Lieb constrained search formulation of Density
             Functional Theory (DFT), especially its spin-polarized form, we
             have presented elsewhere a reformulation of both time-independent
             and time-dependent DFT. The analysis is based on the full
             space-spin density and some of its implications are most
             accessible via expansions in terms of General Spin Orbitals
             (CTSOs). The approach defines universal energy functional on
             equivalence classes of N-fermion states labelled by those full
             space-spin densities via the constrained search technique. Here
             we apply theorems from constrained optimization theory to show
             that such a universal functional is well defined (not
             multi-valued) on paths of N-particle states as long as certain
             first and second derivative conditions are satisfied. These, we
             demonstrate, are equivalent to V-representability conditions. Two
             types of one-particle GSO equations are derived for the ground
             state density, one involving model states in the spirit of
             Kohn-Sham, the other not involving model states. The relationship
             between DFT based upon the space-spin density with the more
             common forms based on the spatial density alone is examined with
             respect to symmetry breaking solutions of the one-particle
             equations.},
  keywords = {Density functional theory; Optimisation; State energy
             functionals; Variational equations; Density functional theory;
             Levy-Lieb constrained search formulation; Spin-polarized form;
             Space-spin density; Expansions; General spin orbitals; Universal
             energy functional; Equivalence classes; N-fermion states;
             Space-spin densities; Constrained search technique; Constrained
             optimization theory; Universal functional; N-particle states;
             Derivative conditions; V-representability conditions; Ground
             state density; Model states; Symmetry breaking solutions;
             One-particle equations},
  language = {English}
}
@ARTICLE{Weiner98,
  author = {B. Weiner and S.B. Trickey},
  month = {5 Sept.},
  year = 1998,
  title = {Fukutome symmetry classification of the Kohn-Sham auxiliary
          one-matrix and its associated state or ensemble},
  journal = {Int. J. Quantum Chem.},
  volume = 69,
  number = 4,
  pages = {451-60},
  note = {From conference: Symposium on Density Functional Theory and
         Applications, 3-7 June 1997},
  publisher = {Wiley},
  abstract = {The Kohn-Sham (KS) procedure for variational minimization of the
             Hohenberg-Kohn density functional utilizes a one-particle reduced
             density matrix of assumed diagonal form, hence depends implicitly
             on a set of auxiliary states. Originally, the auxiliary state was
             assumed to be a single determinant with doubly occupied spin
             orbitals, i.e., of the same form as in 'restricted' Hartree-Fock
             theory. The pragmatic and formal extension of the KS procedure to
             noninteger occupation numbers requires extension to more general
             forms of the auxiliary state or even its replacement by an
             auxiliary ensemble. Though attention has been given to the
             symmetry properties of the KS one-matrix, its spin and
             time-reversal symmetries have not been classified along the lines
             of Fukutome's treatment of the generalized Hartree-Fock problem.
             Here we show that, in the context of constrained search density
             functional theory (DFT), Fukutome's analysis goes through
             essentially unaltered. We then consider the broken symmetry
             consequences for the case that the KS one-matrix is restricted to
             a single-determinantal KS auxiliary state.},
  keywords = {Density functional theory; Orbital calculations; Symmetry;
             Fukutome symmetry classification; Kohn-Sham auxiliary one-matrix;
             Associated state; Auxiliary ensemble; Variational minimization;
             Hohenberg-Kohn density functional; One-particle reduced density
             matrix; Diagonal form; Auxiliary state; Single determinant;
             Doubly occupied spin orbitals; Restricted Hartree-Fock theory;
             Noninteger occupation numbers; Spin symmetries; Time-reversal
             symmetries; Generalized Hartree-Fock problem; Constrained search
             density functional theory; Broken symmetry; Single-determinantal
             Kohn-Sham auxiliary state; General spin orbitals; Spin symmetry},
  language = {English},
  location = {Durham, NC, USA}
}
