@ARTICLE{Weiner85a,
  author = {B. Weiner},
  month = {July},
  year = 1985,
  title = {Consistent propagator approximations},
  journal = {Int. J. Quantum Chem.},
  volume = 28,
  number = 1,
  pages = {61-84},
  abstract = {A propagator approximation scheme is presented in the context of
             an abstract*-algebra approach. The representation theory of such
             algebras is shown to play a crucial role in the definition of
             consistent approximations, i.e., approximate propagators based on
             model time evolutions and states. This procedure places
             superoperator methods of approximation on a sound Hilbert space
             footing. A generalization of the Fock vacuum property is
             introduced which leads to a simplification in the form of the
