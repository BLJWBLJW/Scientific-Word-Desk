@ARTICLE{Mechtly89,
  author = {B. Mechtly and P.B. Shaw and B. Weiner},
  month = {15 Dec.},
  year = 1989,
  title = {Variational evolution on a Davydov lattice using generalized
          coherent trial states},
  journal = {Phys. Rev. A},
  volume = 40,
  number = 12,
  pages = {7275-85},
  abstract = {A time-dependent variational principle (TDVP) is used to
             describe the evolution of a molecular exciton on a Davydov
             lattice at T=0. The variational trial state is taken as a linear
             combination of generalized coherent states with variational
             parameters given by a set of time-dependent exciton probability
             amplitudes phi /sub n/, lattice-displacement amplitudes d/sub
             kn/, and phonon-pair amplitudes g/sub kk'n/ (n labels the exciton
             sites and k the phonon modes). Previous applications of the TDVP
             to the Davydov lattice have ignored pair contributions (g/sub
             kk'n/=0) and have either (1) set d/sub kn/=d/sub k/ (the
             mean-displacement approximation of standard Davydov theory) or
             (2) left d/sub kn/ unrestricted. The authors obtain new evolution
             equations that provide a basis for testing the adequacy of case
             (2) above. They have integrated these equations numerically and
             find that the mean-pair corrections to case (2) are quite small
             over the range of exciton-phonon coupling constant considered.},
  keywords = {Lattice phonons; Phonon-exciton interactions; Davydov lattice;
             Generalized coherent trial states; Time-dependent variational
             principle; Molecular exciton; Variational trial state;
             Time-dependent exciton probability amplitudes;
             Lattice-displacement amplitudes; Phonon-pair amplitudes;
             Exciton-phonon coupling constant},
  language = {English}
}
@ARTICLE{Weiner89,
  author = {B. Weiner},
  month = {Sept.},
  year = 1989,
  title = {Coherent state approach to the N-representability problem},
  journal = {THEOCHEM},
  volume = 58,
  pages = {119-35},
  abstract = {The N-representability problem is reviewed and formulated in the
             context of group-related coherent states. The particular family
             of states chosen is based on the group of special unitary
             transformations of one particle space. Density operators are
             analyzed in terms of their P and Q symbols associated with these
             states, and the holomorphic representations of quantum mechanics
             that they induce. The time-independent Schrodinger equation for
             the ground state of an electronic system is expressed as a
             variational problem over a set of positive distributions. This
             set of distributions solves in an abstract sense the
             N-representability problem. The computational feasibility of the
             solution is discussed.},
  keywords = {Molecular energy level calculations; Schrodinger equation;
             Variational techniques; Density operators; Molecule models;
             N-representability problem; Group-related coherent states;
             Unitary transformations; One particle space; Q symbols;
             Holomorphic representations; Time-independent Schrodinger
             equation; Ground state; Electronic system; Variational problem;
             Positive distributions; Distributions},
  language = {English}
}
@ARTICLE{Head88,
  author = {J. D. Head and B. Weiner and M. C. Zerner},
  month = {March 1988},
  year = 1988,
  title = {A survey of optimization procedures for stable structures and
          transition states},
  journal = {Int. J. Quantum Chem.},
  volume = 33,
  number = 3,
  pages = {177-86},
  abstract = {The authors examine a variety of methods for obtaining the
             stable geometry of molecules and the transition states of simple
             systems and summarize some of the findings. They find the most
             efficient methods for optimizing structure to be those based on
             calculated gradients and estimated second derivative (Hessian)
             matrices, the later obtained either from the
             Broyden-Fletcher-Goldfarb-Shanno (BFGS) quasi-Newton update
             method (R. Fletcher 1970) or from approximations to the coupled
             perturbed Hartree-Fock method. For uncovering transition states
             the authors find particularly useful a variety of the augmented
             Hessian theory used to uncover regions of the potential energy
             hypersurface with one and only one negative eigenvalue of the
             Hessian matrix characterizing the catchment region of the
             transition state. Once this region is found they minimize the
             norm of the gradient vector to catch the nearest extreme point of
             the surface. Examples of these procedures are given.},
  keywords = {HF calculations; Molecular configurations; Potential energy
             curves and surfaces of molecules; Gradients calculation; Second
             derivative Hessian matrices; Optimization procedures; Structures;
             Transition states; Stable geometry; Quasi-Newton update method;
             Coupled perturbed Hartree-Fock method; Potential energy
             hypersurface},
  language = {English}
}
@ARTICLE{Weiner88,
  author = {B. Weiner},
  year = 1988,
  title = {The Lie algebraic structure of the set of one-particle fermion
          operators},
  journal = {Int. J. Quantum Chem., Quantum Chemistry
            Symposia},
  volume = {S22},
  pages = {407-24},
  note = {From conference: International Symposium on Quantum Chemistry,
         Solid-State Theory, and Computational Methods, Marineland, FL, USA,
         12-19 March 1988},
  abstract = {The manifold of one-particle operators has a rich group
             structure. It is the Lie algebra of the complex Lie group GL(2s,
             C), (2s=dimension of one-particle spin orbital basis) realized as
             second-quantized operators acting in fermion fock space. This
             representation is reduced by the subspaces referring to N
             particles (N=0, 1, 2, . . .). One can associate families of
             coherent states within each of these subspaces with real forms,
             G/sub r/, of GL(2s, C). These families have isotropy groups,
             H/sub r/, which are associated with subgroups of these real forms
             (isotropy groups are the groups of transformations that leave a
             state invariant). The cosets GL(2s, C)/H/sub r/ can be given an
             exponential parameterization that labels the coherent states.
             This label space is a complex vector space which is in
             correspondence with the nonlinear manifold of coherent states in
             the Hilbert space H/sup N/. These complex variables can be made
             time dependent, and by utilizing the time-dependent variation
             principle one can obtain a nonlinear approximation to the
             time-dependent Schrodinger equation which has the form of
             classical equations of motion in a generalized phase space
             P=G/sub r//sup c//H/sub r//sup c/. This classical dynamics can be
             given a Hilbert space description, which the Hilbert space is a
             subspace of square integrable holomorphic functions f:P to C and
             is isomorphic with H/sup N/. Different pairs (G/sub r/, H/sub r/)
             are associated with different families of coherent states. Some
             examples of these constructions are given, and the structure of
             the approximate time evolution is discussed and related to
             time-dependent approximation schemes and generalized random phase
             approximations (RPA).},
  keywords = {Algebra; Fermion systems; Lie groups; Nonlinear differential
             equations; Lie algebraic structure; One-particle fermion
             operators; Manifold; Group structure; Spin orbital basis;
             Second-quantized operators; Fermion fock space; Isotropy groups;
             Exponential parameterization; Complex vector space; Hilbert
             space; Time-dependent variation principle; Nonlinear
             approximation; Time-dependent Schrodinger equation; Equations of
             motion; Square integrable holomorphic functions; Random phase
             approximations},
  language = {English},
  location = {Marineland, FL, USA}
}
@ARTICLE{Deumens87,
  author = {E. Deumens and B. Weiner and Y. {\"O}hrn},
  month = {27 April 1987},
  year = 1987,
  title = {Time-dependent variational principle on the group SO(2r):
          generalizations of time-dependent Hartree-Fock},
  journal = {Nuc. Phys. A},
  volume = {A466},
  number = 1,
  pages = {85-108},
  abstract = {The family of all Hartree-Fock-Bogoliubov (HFB) states for a
             given set of r isospin-spin orbitals form a set of coherent
             states. The set of antisymmetrized geminal power (AGP) states for
             a given set of r isospin-spin orbitals form a set of
             charge-projected coherent states, with the number of particles n
             as the 'charge' and the HFB coherent state as the generating
             function. Both these coherent states are associated with the
             group SO(2r). The approximate time evolution of the system
             generated by restricting the quantum mechanical evolution to the
             family of HFB and AGP coherent states is described as a classical
             dynamics with the energy of the coherent state as hamiltonian
             function. The phase space is isomorphic to the coset space
             SO(2r)/U(r). The random phase approximation based on HFB and AGP
             states is derived by considering the harmonic approximation to
             the hamiltonian function. This work generalizes the group
             theoretical approaches to Hartree-Fock, and time-dependent
             Hartree-Fock theory by the use of non-number-conserving (HFB) and
             correlated (AGP) states.},
  keywords = {HF calculations; Nuclear structure theory; RPA calculations; SO
             groups; Hartree-Fock-Bogoliubov; Isospin-spin orbitals; Coherent
             states; Antisymmetrized geminal power; Charge-projected coherent
             states; HFB coherent state; SO(2 r); Random phase approximation;
             Group theoretical approaches; Time-dependent Hartree-Fock theory},
  language = {English}
}
@ARTICLE{Froelich87,
  author = {P. Froelich and E. Sangfelt and B. Weiner},
  month = {May 1987},
  year = 1987,
  title = {Implementation of the complex coordinate method for resonances and
          photoionization cross sections by means of matrix element
          extrapolation},
  journal = {Int. J. Quantum Chem.},
  volume = 31,
  number = 5,
  pages = {823-31},
  abstract = {A new implementation of the complex coordinate method for
             calculation of molecular resonances and photoionization cross
             sections is presented. The method originates from the idea of
             analytic continuation of stabilization graphs, but instead all
             matrix elements are numerically continued. Exterior scaling is
             invoked in conjunction with the use of dilationally adapted basis
             sets. It is operationally equivalent to the bivariational method
             in the Feshbach-partitioned manifold of complex basis functions,
             but no complex integrals are calculated. Instead, the complex
             eigenvalue problem arises from the analytical continuation of the
             real-valued matrix elements pertinent to any atomic or molecular
             structure code in its standard (real) form. That includes the
             possibility of using numerical basis sets. Since the method does
             not require modification of existing numerical codes, it can
             serve as a complement to any large scale CI or MCSCF molecular
             structure calculation.},
  keywords = {Ionisation of molecules; Molecular resonant states;
             Photoionisation; CI calculations; MCSCF calculations; Numerical
             continuation; Complex coordinate method; Photoionization cross
             sections; Matrix element extrapolation; Molecular resonances;
             Analytic continuation; Stabilization graphs},
  language = {English}
}
@ARTICLE{Sangfelt87,
  author = {E. Sangfelt and R.R. Chowdhury and B. Weiner and Y. {\"O}hrn},
  month = {15 April 1987},
  year = 1987,
  title = {Generalized Tamm-Dancoff approximation (GTDA) and random-phase
          approximation (GRPA) calculations on LiH, Be, and Li/sub 2/},
  journal = {J. Chem. Phys.},
  volume = 86,
  number = 8,
  pages = {4523-30},
  abstract = {The theory for polarization propagator calculations based on a
             correlated reference state in the form of a spin singlet
             restricted antisymmetrized geminal power (AGP) is discussed.
             Particular attention is paid to the calculation of excitation
             energies and transition moments for the molecules over all
             internuclear separations, i.e., not just single point vertical
             energies, which is done in standard RPA or in higher-order
             treatments using perturbation methods. Simple applications to the
             Be atom, and the LiH and Li/sub 2/ molecules are used to
             illustrate how this simple correlated state, which completely
             determined by the choice of orbital basis (i.e., no choice of
