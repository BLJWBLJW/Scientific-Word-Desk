  note = {Date of conference: 21-26 May 1995},
  organization = {Electrochem. Soc},
  abstract = {Growth of diamond has usually been discussed without invoking
             any form of surface diffusion. We present new theoretical results
             which clearly show the feasibility of a mechanism based on the
             migration of CH/sub 2/ and C=CH/sub 2/ groups on diamond [100]
             surfaces. This mechanism neither requires a particular order of
