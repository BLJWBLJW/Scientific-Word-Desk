\section{Canonical Anti Commutation Relationship}

The Canonical Anticommutation Relationships are for a given conb $\left\{
\left.  \left\vert \varphi_{j}\right\rangle \right\vert 1\leq j\leq r\right\}
$ of $\mathcal{H}^{1}$
\begin{subequations}
\label{CAR}%
\begin{align}
\left\{  a_{j},a_{k}^{\dagger}\right\}   &  =\delta_{jk}I_{\mathcal{F}%
}\label{CAR1}\\
\left\{  a_{j}^{\dagger},a_{k}^{\dagger}\right\}   &  =\left\{  a_{j}%
,a_{k}\right\}  =0\label{CAR2}\\
1  &  \leq j\leq r,
\end{align}
where
\end{subequations}
\begin{equation}
\left\{  A,B\right\}  =AB+BA,
\end{equation}
the creation operators $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq
j\leq r\right\}  $ are defined by their action on \emph{normalized} vectors
$\left\vert \Psi\right\rangle \in\mathcal{H}_{\mathcal{F}}$ by
\begin{equation}
a_{j}^{\dagger}\left\vert \Psi\right\rangle =\left\vert \varphi_{j}\wedge
\Psi\right\rangle \label{CREAT}%
\end{equation}
and the annihilation operators $\left\{  \left.  a_{j}\right\vert 1\leq j\leq
r\right\}  $ are defined as their adjoints i.e.
\begin{equation}
a_{j}=\left(  a_{j}^{\dagger}\right)  ^{\dagger},\,1\leq j\leq r.
\end{equation}


\subsubsection{Comments}

\begin{itemize}
\item The operators $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq j\leq
r\right\}  $ are bounded so have bounded adjoints $\left\{  \left.
a_{j}\right\vert 1\leq j\leq r\right\}  $ and hence
\begin{equation}
a_{j}^{\dagger}=\left(  a_{j}\right)  ^{\dagger}.
\end{equation}


\item In particular it follows from the definition eq. $\left(  \ref{CREAT}%
\right)  $ and eq. $\left(  \ref{CAR1}\right)  $ that
\begin{align}
a_{j}^{\dagger}\left\vert \phi\right\rangle  &  =\left\vert \varphi
_{j}\right\rangle \nonumber\\
a_{j}\left\vert \phi\right\rangle  &  =0\nonumber\\
1  &  \leq j\leq r.
\end{align}


This follows from
\begin{equation}
\left\langle \left.  \phi\right\vert a_{j}^{\dagger}a_{j}\phi\right\rangle
=\left\langle \phi\left\vert \left(  I_{\mathcal{F}}-a_{j}a_{j}^{\dagger
}\right)  \right.  \phi\right\rangle =0,
\end{equation}
which implies that
\begin{equation}
a_{j}\left\vert \phi\right\rangle =0.
\end{equation}


\item $a_{j}^{\dagger}$ and $a_{j}$ are partial isometries. (and generate the
Fermion Fock) algebra as
\begin{equation}
a_{j}^{\dagger}a_{j}\text{ and }a_{j}a_{j}^{\dagger}%
\end{equation}
are projectors and equivalently
\begin{equation}
a_{j}a_{j}^{\dag}a_{j}=a_{j}\left(  1-a_{j}a_{j}^{\dag}\right)  =a_{j}.
\end{equation}
In this particular case
\begin{align}
a_{j}^{\dag}a_{j}+a_{j}a_{j}^{\dag}  &  =I_{F},\\
a_{j}^{\dag}a_{j}a_{j}a_{j}^{\dag}  &  =0\\
a_{j}a_{j}^{\dag}a_{j}^{\dag}a_{j}  &  =0,
\end{align}
the projectors a $a_{j}^{\dag}a_{j}$ and $a_{j}a_{j}^{\dag}$ are orthogonal
as
\begin{equation}
a_{j}^{\dag}a_{j}a_{j}a_{j}^{\dag}=a_{j}^{\dag}a_{j}\left(  1-a_{j}^{\dag
}a_{j}\right)  =a_{j}^{\dag}a_{j}-a_{j}^{\dag}a_{j}=0.
\end{equation}
and are also infinite dimensional.
\end{itemize}

One can set the operators $\left\{  \left.  a_{j}^{\dagger}\right\vert 1\leq
j\leq r\right\}  $ as the values of the map
\begin{equation}
\Phi^{\dagger}:\mathcal{H}^{1}\rightarrow\mathcal{B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)
\end{equation}
i.e.
\begin{equation}
a_{j}^{\dagger}=\Phi^{\dagger}\left(  \left\vert \varphi_{j}\right\rangle
\right)  ,
\end{equation}
which leads to a more general (basis free) form of the CAR
\begin{subequations}
\begin{align}
\left\{  \Phi\left(  \left\vert u\right\rangle \right)  ,\Phi^{\dagger}\left(
\left\vert v\right\rangle \right)  \right\}   &  =\left\langle \left.
u\right\vert v\right\rangle I_{\mathcal{F}}\\
\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}   &
=\left\{  \Phi\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  =0\\
\forall\left\vert u\right\rangle ,\left\vert v\right\rangle  &  \in
\mathcal{H}^{1}.
\end{align}
The field operator $\Phi^{\dagger}$ is the restriction of the second
quantization map, $\Gamma,$ to $\mathcal{H}^{1}$ i.e.
\end{subequations}
\begin{equation}
\Phi^{\dagger}=\left.  \Gamma\right\vert _{\mathcal{H}^{1}}.
\end{equation}


The $c^{\ast}$-algebra $\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)
,$ (which is actually a $w^{\ast}$-algebra), is generated by the basis
$\left\{  \left.  a_{j},a_{j}^{\dagger}\right\vert 1\leq j\leq r\right\}  .$ A
map $T$ is a $c^{\ast}$-algebra isomorphism if
\begin{align}
T  &  \in\mathcal{B}\left(  \mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  \right) \\
T\left(  XY\right)   &  =T\left(  X\right)  T\left(  Y\right) \\
T\left(  X^{\dagger}\right)   &  =T\left(  X\right)  ^{\dagger}\\
T^{-1}T  &  =Id,
\end{align}
where the norm of $T$ is defined by
\begin{equation}
\left\Vert T\right\Vert =\sup_{\left\Vert X\right\Vert _{\mathcal{B}\left(
\mathcal{H}_{\mathcal{F}}\right)  }=1}\left\Vert T\left(  X\right)
\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}}\right)  }.
\end{equation}
In particular one can see that
\begin{equation}
T\left(  I_{\mathcal{F}}\right)  =I_{\mathcal{F}}%
\end{equation}
and
\begin{subequations}
\label{CAR}%
\begin{align}
\left\{  T\left(  a_{j}\right)  ,T\left(  a_{k}^{\dagger}\right)  \right\}
&  =T\left(  \left\{  a_{j},a_{k}^{\dagger}\right\}  \right)  =\delta
_{jk}T\left(  I_{\mathcal{F}}\right) \\
T\left(  \left\{  a_{j}^{\dagger},a_{k}^{\dagger}\right\}  \right)   &
=T\left(  \left\{  a_{j},a_{k}\right\}  \right)  =0\\
1  &  \leq j,k\leq r.
\end{align}
One can note that
\end{subequations}
\begin{equation}
\left\Vert a_{j}\right\Vert =\left\Vert a_{j}^{\dagger}\right\Vert =1.
\end{equation}


\section{Clifford Algebra}

One can define self adjoint operators
\begin{align}
x_{j}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
=x_{j}^{\dagger}\\
x_{j+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
=x_{j+r}^{\dagger}%
\end{align}
noting that
\begin{equation}
-ix_{j+r}=\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
\end{equation}
one obtains the inverse relationships
\begin{align}
a_{j}^{\dagger}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right) \\
a_{j}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right)  .
\end{align}
This can be checked by
\begin{align}
\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)   &  =\frac{1}%
{2}\left(  \left(  x_{j}-ix_{j+r}\right)  +\left(  x_{j}+ix_{j+r}\right)
\right)  =x_{j}\\
\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)   &  =\frac{i}%
{2}\left(  \left(  x_{j}-ix_{j+r}\right)  -\left(  x_{j}+ix_{j+r}\right)
\right)  =x_{j+s}.
\end{align}


The squares of the self adjoint operators $\left\{  \left.  x_{j}\right\vert
1\leq j\leq2r\right\}  $ are multiples of the identity i.e.%
\begin{equation}
x_{j}^{2}=\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  \frac
{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}%
\end{equation}%
\begin{equation}
x_{j+r}^{2}=\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)  \frac
{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}%
\end{equation}
Thus
\begin{equation}
\left\Vert x_{j}\right\Vert _{\mathcal{B}\left(  \mathcal{H}_{\mathcal{F}%
}\right)  }=\frac{1}{\sqrt{2}},1\leq j\leq2r.
\end{equation}


The products for $1\leq j\neq k\leq r$ are
\begin{align}
x_{j}x_{k}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
\frac{1}{\sqrt{2}}\left(  a_{k}^{\dagger}+a_{k}\right)  =\frac{1}{2}\left(
a_{j}^{\dagger}a_{k}+a_{j}a_{k}+a_{j}^{\dagger}a_{k}^{\dagger}+a_{j}%
a_{k}^{\dagger}\right) \\
x_{k}x_{j}  &  =\frac{1}{\sqrt{2}}\left(  a_{k}^{\dagger}+a_{k}\right)
\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  =\frac{1}{2}\left(
a_{k}^{\dagger}a_{j}+a_{k}a_{j}+a_{k}^{\dagger}a_{j}^{\dagger}+a_{k}%
a_{j}^{\dagger}\right)
\end{align}
hence
\begin{equation}
x_{j}x_{k}=-x_{k}x_{j}.
\end{equation}


The products for $r+1\leq j+r\neq k+r\leq2r$ are%
\begin{align}
x_{j+r}x_{k+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)
\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)  =\frac{1}{2}\left(
-a_{j}^{\dagger}a_{k}^{\dagger}+a_{j}^{\dagger}a_{k}+a_{j}a_{k}^{\dagger
}-a_{j}a_{k}\right) \\
x_{k+r}x_{j+r}  &  =\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)
\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right)  =\frac{1}{2}\left(
-a_{k}^{\dagger}a_{j}^{\dagger}+a_{k}^{\dagger}a_{j}+a_{k}a_{j}^{\dagger
}-a_{k}a_{j}\right)
\end{align}
hence
\begin{equation}
x_{j+r}x_{k+r}=-x_{k+r}x_{j+r}.
\end{equation}


The products for $1\leq j\leq r;$ $r+1\leq k+r\leq2r$ are
\begin{align}
x_{j}x_{k+r}  &  =\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)  =\frac{1}{2}\left(
ia_{j}^{\dagger}a_{k}^{\dagger}-ia_{j}^{\dagger}a_{k}+ia_{j}a_{k}^{\dagger
}-ia_{j}a_{k}\right) \\
x_{k+r}x_{j}  &  =\frac{i}{\sqrt{2}}\left(  a_{k}^{\dagger}-a_{k}\right)
\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)  =\left(  x_{j}%
x_{k+s}\right)  ^{\dagger}=\frac{1}{2}\left(  ia_{k}^{\dagger}a_{j}^{\dagger
}+ia_{k}^{\dagger}a_{j}-ia_{k}a_{j}^{\dagger}-ia_{k}a_{j}\right)
\end{align}
hence $x_{j}x_{k+r}=-x_{k+r}x_{j}.$

The squares for $1\leq j\leq r$ are%

\begin{align}
x_{j}^{2}  &  =x_{j}x_{j}=\frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}%
+a_{j}\right)  \frac{1}{\sqrt{2}}\left(  a_{j}^{\dagger}+a_{j}\right)
=\frac{1}{2}\left(  a_{j}a_{j}^{\dagger}+a_{j}a_{j}+a_{j}^{\dagger}%
a_{j}^{\dagger}+a_{j}^{\dagger}a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}\\
x_{j+r}^{2}  &  =x_{j+r}x_{j+r}=\frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger
}-a_{j}\right)  \frac{i}{\sqrt{2}}\left(  a_{j}^{\dagger}-a_{j}\right) \\
&  =-\frac{1}{2}\left(  a_{j}^{\dagger}a_{j}^{\dagger}-a_{j}^{\dagger}%
a_{j}-a_{j}a_{j}^{\dagger}+a_{j}a_{j}\right)  =\frac{1}{2}I_{\mathcal{F}}.
\end{align}


Thus the self adjoint operators $\left\{  \left.  x_{j}\right\vert 1\leq
j\leq2r\right\}  $ satisfy the CAR's
\begin{equation}
\left\{  x_{j},x_{k}\right\}  =\delta_{jk}I_{\mathcal{F}};\,1\leq i,j\leq2r.
\end{equation}


The Fermi Fock algebra $\mathcal{F},$ which is representation of a CAR
algebra, is generated by \emph{complex} polynomials of the generators
$\left\{  \left.  x_{j}\right\vert 1\leq j\leq2r\right\}  $ that satisfy the
conditions
\begin{align}
x_{j}x_{k}  &  =-x_{k}x_{j},\,1\leq j<k\leq2r\\
x_{j}^{2}  &  =\frac{1}{2}I_{\mathcal{F}},\,1\leq j\leq2r
\end{align}
or equivalently
\begin{equation}
\left\{  x_{j},x_{k}\right\}  =\delta_{jk}I_{\mathcal{F}};\,1\leq i,j\leq2r,
\end{equation}
thus is a \emph{Clifford Algebra}. This is a graded algebra and be expressed
as the vector space direct sum
\begin{equation}
\mathcal{F=}%
%TCIMACRO{\dbigoplus \limits_{0\leq n\leq2r}}%
%BeginExpansion
{\displaystyle\bigoplus\limits_{0\leq n\leq2r}}
%EndExpansion
\mathcal{F}_{n},
\end{equation}
where $\mathcal{F}_{n}$ are multilinear homogeneous polynomials of degree $n$
and
\begin{equation}
\mathcal{F}_{0}=\left\{  \left.  zI_{\mathcal{F}}\right\vert z\in
\mathbb{C}\right\}  .
\end{equation}


\subsubsection{Products}

The product $CD$ of two grade 1 operators (vectors) can be expressed as the
sum of a symmetric and antisymmetric part i.e.
\begin{equation}
CD=\frac{1}{2}\left\{  CD+DC\right\}  +\frac{1}{2}\left\{  CD-DC\right\}
=C\vee D+C\wedge D,
\end{equation}
which allows one to define a scalar product $(\cdot|\cdot)$ as
\begin{equation}
(C|D)=C\vee D.
\end{equation}
The basis $\left\{  \left.  x_{j}\right\vert \,1\leq j\leq2r\right\}  $ is
orthogonal with respect to this scalar product i.e.
\begin{equation}
(x_{j}|x_{k})=x_{j}\vee x_{k}=\frac{1}{2}\left\{  x_{j}x_{k}+x_{k}%
x_{j}\right\}  =\frac{1}{2}\delta_{jk}I_{\mathcal{F}};1\leq j\leq2r.
\end{equation}
One can expand any two vectors $C$ and $D$ in terms of this basis
\begin{align}
C  &  =\sum_{1\leq j\leq2r}c_{j}x_{j}\\
D  &  =\sum_{1\leq j\leq2r}d_{j}x_{j}%
\end{align}
and obtain
\begin{equation}
(C|D)=(D|C)=\frac{1}{2}\sum_{1\leq j\leq2r}c_{j}d_{j}I_{\mathcal{F}}.
\end{equation}


The CAR's can then be expressed in terms of this scalar product as
\begin{equation}
\left\{  C,D\right\}  =\sum_{1\leq j,k\leq2r}c_{j}d_{k}\left\{  x_{j}%
,x_{k}\right\}  I_{\mathcal{F}}=\sum_{1\leq j\leq2r}c_{j}d_{j}I_{\mathcal{F}%
}=2(C|D).
\end{equation}
The invariance group of the scalar product $(\cdot|\cdot)$ is $O\left(
2r,\mathbb{C}\right)  .$ One can define a quadratic function $Q$ in terms of
this scalar product by
\begin{equation}
Q\left(  C\right)  =\left(  C\left\vert C\right.  \right)
\end{equation}
and then one can recover the scalar product by using the polarization
identity
\begin{equation}
\left(  C\left\vert D\right.  \right)  =\frac{1}{2}\left(  Q\left(
C+D\right)  -Q\left(  C\right)  -Q\left(  D\right)  \right)  .
\end{equation}


The product of vectors $CD$ can be expressed as
\begin{equation}
CD=(C|D)+C\wedge D
\end{equation}
and in particular the second order product as
\begin{equation}
x_{i}x_{j}=\left(  x_{i}\left\vert x_{j}\right.  \right)  +x_{i}\wedge x_{j}.
\end{equation}


The third order product is
\begin{equation}
x_{j_{1}}x_{j_{2}}x_{j_{3}}=x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}+\left(
\left.  x_{j_{2}}\right\vert x_{j_{3}}\right)  x_{j_{1}}-\left(  \left.
x_{j_{1}}\right\vert x_{j_{3}}\right)  x_{j_{2}}+\left(  \left.  x_{j_{1}%
}\right\vert x_{j}\right)  x_{j_{3}}.
\end{equation}


The fourth order is given by
\begin{align}
&  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}\nonumber\\
&  +\left(  \left.  x_{j_{1}}\right\vert x_{j_{2}}\right)  x_{j_{3}}\wedge
x_{j_{4}}-\left(  \left.  x_{j_{1}}\right\vert x_{j_{3}}\right)  x_{j_{2}%
}\wedge x_{j_{4}}+\left(  \left.  x_{j_{1}}\right\vert x_{j_{4}}\right)
x_{j_{2}}\wedge x_{j_{3}}\nonumber\\
&  +\left(  \left.  x_{j_{2}}\right\vert x_{j_{3}}\right)  x_{j_{1}}\wedge
x_{j_{4}}-\left(  \left.  x_{j_{2}}\right\vert x_{j_{4}}\right)  x_{j_{1}%
}\wedge x_{j_{3}}+\left(  \left.  x_{j_{3}}\right\vert x_{j_{4}}\right)
x_{j_{1}}\wedge x_{j_{2}}\nonumber\\
&  +\left(  \left.  x_{j_{1}}\right\vert x_{j}\right)  \left(  \left.
x_{j_{3}}\right\vert x_{j_{4}}\right)  -\left(  \left.  x_{j_{1}}\right\vert
x_{j_{3}}\right)  \left(  \left.  x_{j_{2}}\right\vert x_{j_{4}}\right)
+\left(  \left.  x_{j_{1}}\right\vert x_{j_{4}}\right)  \left(  \left.
x_{j_{2}}\right\vert x_{j_{3}}\right)  .
\end{align}
$\lceil$To check we derive this again by
\begin{align}
&  x_{i}x_{j}x_{k}x_{l}=\left\{  \left(  x_{i}\left\vert x_{j}\right.
\right)  +x_{i}\wedge x_{j}\right\}  \left\{  \left(  x_{k}\left\vert
x_{l}\right.  \right)  +x_{k}\wedge x_{l}\right\} \nonumber\\
&  =\left(  x_{i}\left\vert x_{j}\right.  \right)  \left(  x_{k}\left\vert
x_{l}\right.  \right)  +\left(  x_{i}\left\vert x_{j}\right.  \right)
x_{k}\wedge x_{l}+\left(  x_{k}\left\vert x_{l}\right.  \right)  x_{i}\wedge
x_{j}+\left(  x_{i}\wedge x_{j}\right)  \left(  x_{k}\wedge x_{l}\right)
\nonumber\\
&  =\left(  x_{i}\left\vert x_{j}\right.  \right)  \left(  x_{k}\left\vert
x_{l}\right.  \right)  +\left(  x_{i}\left\vert x_{j}\right.  \right)
x_{k}\wedge x_{l}+\left(  x_{k}\left\vert x_{l}\right.  \right)  x_{i}\wedge
x_{j}\nonumber\\
&  -\left(  \left.  x_{i}\right\vert x_{k}\right)  x_{j}\wedge x_{l}+\left(
\left.  x_{i}\right\vert x_{l}\right)  x_{j}\wedge x_{k}+\left(  \left.
x_{j}\right\vert x_{k}\right)  x_{i}\wedge x_{l}-\left(  \left.
x_{j}\right\vert x_{l}\right)  x_{i}\wedge x_{k}\nonumber\\
&  +x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}%
\end{align}
$\rfloor$

The fifth order by
\begin{align}
x_{i}x_{j}x_{k}x_{l}x_{m}  &  =\left\{  x_{i}\wedge x_{j}\wedge x_{k}\wedge
x_{l}+\left(  \left.  x_{i}\right\vert x_{j}\right)  x_{k}\wedge x_{l}-\left(
\left.  x_{i}\right\vert x_{k}\right)  x_{j}\wedge x_{l}+\left(  \left.
x_{i}\right\vert x_{l}\right)  x_{j}\wedge x_{k}\right. \nonumber\\
&  +\left(  \left.  x_{j}\right\vert x_{k}\right)  x_{i}\wedge x_{l}-\left(
\left.  x_{j}\right\vert x_{l}\right)  x_{i}\wedge x_{k}+\left(  \left.
x_{k}\right\vert x_{l}\right)  x_{i}\wedge x_{j}\nonumber\\
&  +\left.  \left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.
x_{k}\right\vert x_{l}\right)  -\left(  \left.  x_{i}\right\vert x_{k}\right)
\left(  \left.  x_{j}\right\vert x_{l}\right)  +\left(  \left.  x_{i}%
\right\vert x_{l}\right)  \left(  \left.  x_{j}\right\vert x_{k}\right)
\right\}  x_{m}.
\end{align}
$\lceil$%
\begin{align}
\left\{  x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\right\}  x_{m}  &
=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge x_{m}+x_{i}\wedge x_{j}\wedge
x_{k}\left(  \left.  x_{l}\right\vert x_{m}\right)  -x_{i}\wedge x_{j}\wedge
x_{l}\left(  \left.  x_{k}\right\vert x_{m}\right) \nonumber\\
&  +x_{i}\wedge x_{k}\wedge x_{l}\left(  \left.  x_{j}\right\vert
x_{m}\right)  -x_{j}\wedge x_{k}\wedge x_{l}\left(  \left.  x_{i}\right\vert
x_{m}\right) \nonumber\\
\left\{  \left(  \left.  x_{i}\right\vert x_{j}\right)  x_{k}\wedge
x_{l}\right\}  x_{m}  &  =\left(  \left.  x_{i}\right\vert x_{j}\right)
\left\{  x_{k}\wedge x_{l}\wedge x_{m}+\left(  \left.  x_{l}\right\vert
x_{m}\right)  x_{k}-\left(  \left.  x_{k}\right\vert x_{m}\right)
x_{l}\right\} \nonumber\\
&  =\left(  \left.  x_{i}\right\vert x_{j}\right)  x_{k}\wedge x_{l}\wedge
x_{m}+\left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.
x_{l}\right\vert x_{m}\right)  x_{k}-\left(  \left.  x_{i}\right\vert
x_{j}\right)  \left(  \left.  x_{k}\right\vert x_{m}\right)  x_{l}\nonumber\\
\left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.  x_{k}%
\right\vert x_{l}\right)  x_{m}  &  =\left(  \left.  x_{i}\right\vert
x_{j}\right)  \left(  \left.  x_{k}\right\vert x_{l}\right)  x_{m}%
\end{align}
$\rfloor$%
\begin{align}
&  x_{i}x_{j}x_{k}x_{l}x_{m}=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge
x_{m}\nonumber\\
&  +\left(  \left.  x_{i}\right\vert x_{j}\right)  x_{k}\wedge x_{l}\wedge
x_{m}-\left(  \left.  x_{i}\right\vert x_{k}\right)  x_{j}\wedge x_{l}\wedge
x_{m}+\left(  \left.  x_{i}\right\vert x_{l}\right)  x_{j}\wedge x_{k}\wedge
x_{m}\\
&  +\left(  \left.  x_{j}\right\vert x_{k}\right)  x_{i}\wedge x_{l}\wedge
x_{m}-\left(  \left.  x_{j}\right\vert x_{l}\right)  x_{i}\wedge x_{k}\wedge
x_{m}+\left(  \left.  x_{k}\right\vert x_{l}\right)  x_{i}\wedge x_{j}\wedge
x_{m}\\
&  +\left(  \left.  x_{l}\right\vert x_{m}\right)  x_{i}\wedge x_{j}\wedge
x_{k}-\left(  \left.  x_{k}\right\vert x_{m}\right)  x_{i}\wedge x_{j}\wedge
x_{l}+\left(  \left.  x_{j}\right\vert x_{m}\right)  x_{i}\wedge x_{k}\wedge
x_{l}-\left(  \left.  x_{i}\right\vert x_{m}\right)  x_{j}\wedge x_{k}\wedge
x_{l}\\
&  +\left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.
x_{l}\right\vert x_{m}\right)  x_{k}-\left(  \left.  x_{i}\right\vert
x_{j}\right)  \left(  \left.  x_{k}\right\vert x_{m}\right)  x_{l}\nonumber\\
&  -\left(  \left.  x_{i}\right\vert x_{k}\right)  \left(  \left.
x_{l}\right\vert x_{m}\right)  x_{j}+\left(  \left.  x_{i}\right\vert
x_{k}\right)  \left(  \left.  x_{j}\right\vert x_{m}\right)  x_{l}\nonumber\\
&  -\left(  \left.  x_{i}\right\vert x_{l}\right)  \left(  \left.
x_{j}\right\vert x_{m}\right)  x_{k}+\left(  \left.  x_{i}\right\vert
x_{l}\right)  \left(  \left.  x_{k}\right\vert x_{m}\right)  x_{j}\nonumber\\
&  +\left(  \left.  x_{j}\right\vert x_{k}\right)  \left(  \left.
x_{l}\right\vert x_{m}\right)  x_{i}-\left(  \left.  x_{j}\right\vert
x_{k}\right)  \left(  \left.  x_{i}\right\vert x_{m}\right)  x_{l}\nonumber\\
&  -\left(  \left.  x_{j}\right\vert x_{l}\right)  \left(  \left.
x_{k}\right\vert x_{m}\right)  x_{i}+\left(  \left.  x_{j}\right\vert
x_{l}\right)  \left(  \left.  x_{k}\right\vert x_{m}\right)  x_{k}\nonumber\\
&  +\left(  \left.  x_{k}\right\vert x_{l}\right)  \left(  \left.
x_{j}\right\vert x_{m}\right)  x_{i}-\left(  \left.  x_{k}\right\vert
x_{l}\right)  \left(  \left.  x_{i}\right\vert x_{m}\right)  x_{j}\nonumber\\
&  +\left\{  \left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.
x_{k}\right\vert x_{l}\right)  -\left(  \left.  x_{i}\right\vert x_{k}\right)
\left(  \left.  x_{j}\right\vert x_{l}\right)  +\left(  \left.  x_{i}%
\right\vert x_{l}\right)  \left(  \left.  x_{j}\right\vert x_{k}\right)
\right\}  x_{m}.
\end{align}%
\begin{align}
&  x_{i}x_{j}x_{k}x_{l}x_{m}=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge
x_{m}\nonumber\\
&  +\left(  \left.  x_{i}\right\vert x_{j}\right)  x_{k}\wedge x_{l}\wedge
x_{m}-\left(  \left.  x_{i}\right\vert x_{k}\right)  x_{j}\wedge x_{l}\wedge
x_{m}+\left(  \left.  x_{i}\right\vert x_{l}\right)  x_{j}\wedge x_{k}\wedge
x_{m}\\
&  +\left(  \left.  x_{j}\right\vert x_{k}\right)  x_{i}\wedge x_{l}\wedge
x_{m}-\left(  \left.  x_{j}\right\vert x_{l}\right)  x_{i}\wedge x_{k}\wedge
x_{m}+\left(  \left.  x_{k}\right\vert x_{l}\right)  x_{i}\wedge x_{j}\wedge
x_{m}\\
&  +\left(  \left.  x_{l}\right\vert x_{m}\right)  x_{i}\wedge x_{j}\wedge
x_{k}-\left(  \left.  x_{k}\right\vert x_{m}\right)  x_{i}\wedge x_{j}\wedge
x_{l}+\left(  \left.  x_{j}\right\vert x_{m}\right)  x_{i}\wedge x_{k}\wedge
x_{l}-\left(  \left.  x_{i}\right\vert x_{m}\right)  x_{j}\wedge x_{k}\wedge
x_{l}\nonumber\\
&  +\left\{  \left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.
x_{l}\right\vert x_{m}\right)  -\left(  \left.  x_{i}\right\vert x_{l}\right)
\left(  \left.  x_{j}\right\vert x_{m}\right)  +\left(  \left.  x_{j}%
\right\vert x_{l}\right)  \left(  \left.  x_{k}\right\vert x_{m}\right)
\right\}  x_{k}\nonumber\\
&  +\left\{  \left(  \left.  x_{i}\right\vert x_{k}\right)  \left(  \left.
x_{j}\right\vert x_{m}\right)  -\left(  \left.  x_{j}\right\vert x_{k}\right)
\left(  \left.  x_{i}\right\vert x_{m}\right)  -\left(  \left.  x_{i}%
\right\vert x_{j}\right)  \left(  \left.  x_{k}\right\vert x_{m}\right)
\right\}  x_{l}\nonumber\\
&  +\left\{  \left(  \left.  x_{i}\right\vert x_{l}\right)  \left(  \left.
x_{k}\right\vert x_{m}\right)  -\left(  \left.  x_{k}\right\vert x_{l}\right)
\left(  \left.  x_{i}\right\vert x_{m}\right)  -\left(  \left.  x_{i}%
\right\vert x_{k}\right)  \left(  \left.  x_{l}\right\vert x_{m}\right)
\right\}  x_{j}\nonumber\\
&  +\left\{  \left(  \left.  x_{j}\right\vert x_{k}\right)  \left(  \left.
x_{l}\right\vert x_{m}\right)  -\left(  \left.  x_{j}\right\vert x_{l}\right)
\left(  \left.  x_{k}\right\vert x_{m}\right)  +\left(  \left.  x_{k}%
\right\vert x_{l}\right)  \left(  \left.  x_{j}\right\vert x_{m}\right)
\right\}  x_{i}\nonumber\\
&  +\left\{  \left(  \left.  x_{i}\right\vert x_{j}\right)  \left(  \left.
x_{k}\right\vert x_{l}\right)  -\left(  \left.  x_{i}\right\vert x_{k}\right)
\left(  \left.  x_{j}\right\vert x_{l}\right)  +\left(  \left.  x_{i}%
\right\vert x_{l}\right)  \left(  \left.  x_{j}\right\vert x_{k}\right)
\right\}  x_{m}.
\end{align}
Thus%
\begin{align}
&  x_{i}x_{j}x_{k}x_{l}x_{m}=x_{i}\wedge x_{j}\wedge x_{k}\wedge x_{l}\wedge
x_{m}\nonumber\\
&  +\Delta_{ij}x_{k}\wedge x_{l}\wedge x_{m}-\Delta_{ik}x_{j}\wedge
x_{l}\wedge x_{m}+\Delta_{il}x_{j}\wedge x_{k}\wedge x_{m}+\Delta_{jk}%
x_{i}\wedge x_{l}\wedge x_{m}-\Delta_{jl}x_{i}\wedge x_{k}\wedge
x_{m}\nonumber\\
&  +\Delta_{kl}x_{i}\wedge x_{j}\wedge x_{m}+\Delta_{lm}x_{i}\wedge
x_{j}\wedge x_{k}-\Delta_{km}x_{i}\wedge x_{j}\wedge x_{l}+\Delta_{jm}%
x_{i}\wedge x_{k}\wedge x_{l}-\Delta_{im}x_{j}\wedge x_{k}\wedge
x_{l}\nonumber\\
&  +\left\{  \Delta_{ij}\Delta_{lm}-\Delta_{il}\Delta_{jm}+\Delta_{jl}%
\Delta_{km}\right\}  x_{k}\nonumber\\
&  +\left\{  \Delta_{ik}\Delta_{jm}-\Delta_{jk}\Delta_{im}-\Delta_{ij}%
\Delta_{km}\right\}  x_{l}\nonumber\\
&  +\left\{  \Delta_{il}\Delta_{km}-\Delta_{kl}\Delta_{im}-\Delta_{ik}%
\Delta_{lm}\right\}  x_{j}\nonumber\\
&  +\left\{  \Delta_{lm}\Delta_{jk}-\Delta_{jl}\Delta_{km}+\Delta_{kl}%
\Delta_{jm}\right\}  x_{i}\nonumber\\
&  +\left\{  \Delta_{ij}\Delta_{kl}-\Delta_{ik}\Delta_{jl}+\Delta_{il}%
\Delta_{jk}\right\}  x_{m}.
\end{align}
Hence the fifth order products are%
\begin{align}
&  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}x_{j_{5}}=x_{j_{1}}\wedge x_{j_{2}%
}\wedge x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}\nonumber\\
&  +\Delta_{j_{1}j_{2}}x_{j_{3}}\wedge x_{j_{4}}\wedge x_{j_{5}}-\Delta
_{j_{1}j_{3}}x_{j_{2}}\wedge x_{j_{4}}\wedge x_{j_{5}}+\Delta_{j_{1}j_{4}%
}x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{5}}\nonumber\\
&  +\Delta_{j_{2}j_{3}}x_{j_{1}}\wedge x_{j_{4}}\wedge x_{j_{5}}-\Delta
_{j_{2}j_{4}}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{5}}+\Delta_{j_{3}j_{4}%
}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{5}}\nonumber\\
&  +\Delta_{j_{4}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{3}}-\Delta
_{j_{3}j_{5}}x_{j_{1}}\wedge x_{j_{2}}\wedge x_{j_{4}}+\Delta_{j_{2}j_{5}%
}x_{j_{1}}\wedge x_{j_{3}}\wedge x_{j_{4}}-\Delta_{j_{1}j_{5}}x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}\nonumber\\
&  +\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{j_{2}j_{3}j_{4}j_{5}%
}x_{j_{1}}-\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{j_{1}j_{3}%
j_{4}j_{5}}x_{j}+\operatorname*{Pf}\left(  \mathbf{\Delta}\right)
_{j_{1}j_{2}j_{4}j_{5}}x_{j_{3}}-\operatorname*{Pf}\left(  \mathbf{\Delta
}\right)  _{j_{1}j_{2}j_{3}j_{5}}x_{j_{4}}+\operatorname*{Pf}\left(
\mathbf{\Delta}\right)  _{j_{1}j_{2}j_{3}j_{4}}x_{j_{5}},
\end{align}
where the extended pfaffian (diagonal terms allowed) is given by
\begin{equation}
\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{j_{1}j_{2}j_{3}j_{4}%
}=\Delta_{j_{1}j_{2}}\Delta_{j_{3}j_{4}}-\Delta_{j_{1}j_{3}}\Delta_{j_{2}%
j_{4}}+\Delta_{j_{1}j_{4}}\Delta_{j_{2}j_{3}}.
\end{equation}


The sixth order products are given by
\begin{align}
&  x_{i}x_{j}x_{k}x_{l}x_{m}x_{n}=\left\{  x_{i}\wedge x_{j}\wedge x_{k}\wedge
x_{l}\wedge x_{m}\right.  \nonumber\\
&  +\Delta_{ij}x_{k}\wedge x_{l}\wedge x_{m}-\Delta_{ik}x_{j}\wedge
x_{l}\wedge x_{m}+\Delta_{il}x_{j}\wedge x_{k}\wedge x_{m}+\Delta_{jk}%
x_{i}\wedge x_{l}\wedge x_{m}-\Delta_{jl}x_{i}\wedge x_{k}\wedge
x_{m}\nonumber\\
&  +\Delta_{kl}x_{i}\wedge x_{j}\wedge x_{m}+\Delta_{lm}x_{i}\wedge
x_{j}\wedge x_{k}-\Delta_{km}x_{i}\wedge x_{j}\wedge x_{l}+\Delta_{jm}%
x_{i}\wedge x_{k}\wedge x_{l}-\Delta_{im}x_{j}\wedge x_{k}\wedge
x_{l}\nonumber\\
&  +\left.  \operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{jklm}%
x_{i}-\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{iklm}x_{j}%
+\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{ijlm}x_{k}%
-\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{ijkm}x_{l}%
+\operatorname*{Pf}\left(  \mathbf{\Delta}\right)  _{ijkl}x_{m}\right\}  x_{n}%
\end{align}
\begin{align}
&  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}=x_{j_{1}}\wedge x_{j_{2}}\wedge
x_{j_{3}}\wedge x_{j_{4}}\nonumber\\
&  +\left(  \left.  x_{j_{1}}\right\vert x_{j_{2}}\right)  x_{j_{3}}\wedge
x_{j_{4}}-\left(  \left.  x_{j_{1}}\right\vert x_{j_{3}}\right)  x_{j_{2}%
}\wedge x_{j_{4}}+\left(  \left.  x_{j_{1}}\right\vert x_{j_{4}}\right)
x_{j_{2}}\wedge x_{j_{3}}\nonumber\\
&  +\left(  \left.  x_{j_{2}}\right\vert x_{j_{3}}\right)  x_{j_{1}}\wedge
x_{j_{4}}-\left(  \left.  x_{j_{2}}\right\vert x_{j_{4}}\right)  x_{j_{1}%
}\wedge x_{j_{3}}+\left(  \left.  x_{j_{3}}\right\vert x_{j_{4}}\right)
x_{j_{1}}\wedge x_{j_{2}}\nonumber\\
&  +\left(  \left.  x_{j_{1}}\right\vert x_{j_{2}}\right)  \left(  \left.
x_{j_{3}}\right\vert x_{j_{4}}\right)  -\left(  \left.  x_{j_{1}}\right\vert
x_{j_{3}}\right)  \left(  \left.  x_{j_{2}}\right\vert x_{j_{4}}\right)
+\left(  \left.  x_{j_{1}}\right\vert x_{j_{4}}\right)  \left(  \left.
x_{j_{2}}\right\vert x_{j_{3}}\right)  ,
\end{align}
one obtains
\begin{align}
&  \left(  A_{2}\right)  ^{2}=\sum_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq
j_{3}<j_{4}\leq2r}}\left\{  A_{2j_{1}j_{2}}A_{2j_{3}j_{4}}x_{j_{1}}\wedge
x_{j_{2}}\wedge x_{j_{3}}\wedge x_{j_{4}}\right.  \nonumber\\
&  -\Delta_{j_{1}j_{3}}A_{2j_{1}j_{2}}A_{2j_{3}j_{4}}x_{j_{2}}\wedge x_{j_{4}%
}+\Delta_{j_{1}j_{4}}A_{2j_{1}j_{2}}A_{2j_{3}j_{4}}x_{j_{2}}\wedge x_{j_{3}%
}\nonumber\\
&  +\Delta_{j_{2}j_{3}}A_{2j_{1}j_{2}}A_{2j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{4}%
}-\Delta_{j_{2}j_{4}}A_{2j_{1}j_{2}}A_{2j_{3}j_{4}}x_{j_{1}}\wedge x_{j_{3}%
}\nonumber\\
&  +\left.  A_{2j_{1}j_{2}}\Delta_{j_{1}j_{4}}A_{2j_{3}j_{4}}\Delta
_{j_{2}j_{3}}I_{\mathcal{F}}-A_{2j_{1}j_{2}}\Delta_{j_{1}j_{3}}A_{2j_{3}j_{4}%
}\Delta_{j_{2}j_{4}}I_{\mathcal{F}}\right\}  .
\end{align}
The "scaler" term is easily seen to be
\begin{equation}
-\sum_{1\leq j_{1}<j_{2}\leq2r}A_{2j_{1}j_{2}}\Delta_{j_{1}j_{1}}%
A_{2j_{1}j_{2}}\Delta_{j_{2}j_{2}}=-\sum_{1\leq j_{1}<j_{2}\leq2r}\left(
A_{2j_{1}j_{2}}\right)  ^{2}I_{\mathcal{F}},
\end{equation}
while one can examine the two vector term by considering $r=2$ leading to the
terms
\begin{align}
&  A_{212}A_{213}x_{1}x_{2}x_{1}x_{3}+A_{212}A_{214}x_{1}x_{2}x_{1}%
x_{4}+A_{212}A_{223}x_{1}x_{2}x_{2}x_{3}\nonumber\\
&  +A_{212}A_{224}x_{1}x_{2}x_{2}x_{4}+A_{213}A_{212}x_{1}x_{3}x_{1}%
x_{2}+A_{213}A_{214}x_{1}x_{3}x_{1}x_{4}\nonumber\\
&  +A_{213}A_{223}x_{1}x_{3}x_{2}x_{3}+A_{213}A_{234}x_{1}x_{3}x_{3}%
x_{4}+A_{214}A_{212}x_{1}x_{4}x_{1}x_{2}\nonumber\\
&  +A_{214}A_{213}x_{1}x_{4}x_{1}x_{3}+A_{214}A_{214}x_{1}x_{4}x_{1}%
x_{4}+A_{214}A_{224}x_{1}x_{4}x_{2}x_{4}\nonumber\\
&  +A_{214}A_{234}x_{1}x_{4}x_{3}x_{4}+A_{223}A_{212}x_{2}x_{3}x_{1}%
x_{2}+A_{223}A_{213}x_{2}x_{3}x_{1}x_{3}\nonumber\\
&  +A_{223}A_{224}x_{2}x_{3}x_{2}x_{4}+A_{223}A_{234}x_{2}x_{3}x_{3}%
x_{4}+A_{224}A_{212}x_{2}x_{4}x_{1}x_{2}\nonumber\\
&  +A_{224}A_{213}x_{2}x_{4}x_{1}x_{3}+A_{224}A_{214}x_{2}x_{4}x_{1}%
x_{4}+A_{224}A_{223}x_{2}x_{4}x_{2}x_{3}\nonumber\\
&  +A_{224}A_{224}x_{2}x_{4}x_{2}x_{4}+A_{224}A_{234}x_{2}x_{4}x_{3}%
x_{4}+A_{234}A_{213}x_{3}x_{4}x_{1}x_{3}\nonumber\\
&  +A_{234}A_{214}x_{3}x_{4}x_{1}x_{4}+A_{234}A_{223}x_{3}x_{4}x_{2}%
x_{3}+A_{234}A_{224}x_{3}x_{4}x_{2}x_{4}%
\end{align}
and see that the term involving $x_{2}\wedge x_{3}$ is given by
\begin{align}
& -\Delta_{11}A_{212}A_{213}x_{2}\wedge x_{3}-\Delta_{11}A_{213}A_{212}%
x_{3}\wedge x_{2}-\Delta_{44}A_{224}A_{234}x_{2}\wedge x_{3}\nonumber\\
& -\Delta_{44}A_{234}A_{224}x_{3}\wedge x_{2}\left.  =\right.  0,
\end{align}
thus the entire two vector term must be zero. The four vector term in this
case is %

\begin{align}
&  A_{212}A_{234}x_{1}x_{2}x_{3}x_{4}+A_{213}A_{224}x_{1}x_{3}x_{2}%
x_{4}+A_{214}A_{223}x_{1}x_{4}x_{2}x_{3}\nonumber\\
&  +A_{223}A_{214}x_{2}x_{3}x_{1}x_{4}+A_{224}A_{213}x_{2}x_{4}x_{1}%
x_{3}+A_{234}A_{212}x_{3}x_{4}x_{1}x_{2}\nonumber\\
&  =2\left(  A_{212}A_{234}-A_{213}A_{224}+A_{214}A_{223}\right)  x_{1}%
x_{2}x_{3}x_{4}\nonumber\\
&  =2\operatorname*{Pf}\left\{  \mathbb{A}_{2}\right\}  _{1234}x_{1}x_{2}%
x_{3}x_{4}=2\operatorname*{Pf}\left\{  \mathbb{A}_{2}\right\}  _{1234}%
x_{1}\wedge x_{2}\wedge x_{3}\wedge x_{4}=A_{2}\wedge A_{2}.
\end{align}
Hence
\begin{equation}
\left(  A_{2}\right)  ^{2}=\frac{1}{8}\operatorname*{Tr}\left\{
\mathbb{A}_{2}^{t}\mathbb{A}_{2}\right\}  I_{\mathcal{F}}+A_{2}\wedge A_{2}.
\end{equation}


\subsection{Canonical Transformations}

The transformation
\begin{equation}
T:\mathcal{F\rightarrow F}%
\end{equation}
given by
\begin{equation}
T\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathbb{T}=\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)
\end{equation}
that preserves the CAR's is called a \emph{canonical transformation}. Thus
\begin{align}
b_{k}^{\dagger}  &  =\sum_{1\leq j\leq r}\left(  a_{j}^{\dagger}U_{jk}%
+a_{j}V_{jk}\right) \\
b_{k}  &  =\sum_{1\leq j\leq r}\left(  a_{j}^{\dagger}\bar{V}_{jk}+a_{j}%
\bar{U}_{jk}\right)
\end{align}
and
\begin{align}
\delta_{kl}  &  =\left\{  b_{k}^{\dagger},b_{l}\right\}  =\left\{  \sum_{1\leq
j\leq r}\left(  a_{j}^{\dagger}U_{jk}+a_{j}V_{jk}\right)  ,\sum_{1\leq j\leq
r}\left(  a_{m}^{\dagger}\bar{V}_{ml}+a_{m}\bar{U}_{ml}\right)  \right\}
\nonumber\\
&  =\sum_{1\leq j,m\leq r}\left(  \left\{  a_{j}^{\dagger}U_{jk}%
,a_{m}^{\dagger}\bar{V}_{ml}\right\}  +\left\{  a_{j}^{\dagger}U_{jk}%
,a_{m}\bar{U}_{ml}\right\}  +\left\{  a_{j}V_{jk},a_{m}^{\dagger}\bar{V}%
_{ml}\right\}  +\left\{  a_{j}V_{jk},a_{m}\bar{U}_{mk}\right\}  \right)
\nonumber\\
&  =\sum_{1\leq j,m\leq r}\left(  U_{jk}\left\{  a_{j}^{\dagger}%
,a_{m}^{\dagger}\right\}  \bar{V}_{ml}+U_{jk}\left\{  a_{j}^{\dagger}%
,a_{m}\right\}  \bar{U}_{ml}+V_{jk}\left\{  a_{j},a_{m}^{\dagger}\right\}
\bar{V}_{ml}+V_{jk}\left\{  a_{j},a_{m}\right\}  \bar{U}_{mk}\right)
\nonumber\\
&  =\sum_{1\leq j,m\leq r}\left(  U_{jk}\delta_{jm}\bar{U}_{ml}+V_{jk}%
\delta_{jm}\bar{V}_{ml}\right)  =\sum_{1\leq j\leq r}\left(  U_{jk}\bar
{U}_{jl}+V_{jk}\bar{V}_{jl}\right)  =\sum_{1\leq j\leq r}\left(
U_{lj}^{\dagger}U_{jk}+V_{lj}^{\dagger}V_{jk}\right) \nonumber\\
&  =\left(  U^{\dagger}U\right)  _{lk}+\left(  V^{\dagger}V\right)  _{lk}.
\end{align}
In the same way
\begin{equation}
\delta_{lk}=\left\{  b_{k},b_{l}^{\dagger}\right\}  =\left(  U^{\dagger
}U\right)  _{kl}+\left(  V^{\dagger}V\right)  _{kl},
\end{equation}%
\begin{align}
0  &  =\left\{  b_{k}^{\dagger},b_{l}^{\dagger}\right\}  =\left\{  \sum_{1\leq
j\leq r}\left(  a_{j}^{\dagger}U_{jk}+a_{j}V_{jk}\right)  ,\sum_{1\leq j\leq
r}\left(  a_{m}^{\dagger}U_{ml}+a_{m}V_{ml}\right)  \right\} \nonumber\\
&  =\sum_{1\leq j,m\leq r}\left(  U_{jk}\delta_{jm}V_{ml}+V_{jk}\delta
_{jm}U_{ml}\right)  =\sum_{1\leq j\leq r}\left(  V_{lj}^{t}U_{jk}+U_{lj}%
^{t}V_{jk}\right) \nonumber\\
&  =\left(  V^{t}U\right)  _{lk}+\left(  U^{t}V\right)  _{lk}%
\end{align}
and
\begin{equation}
0=\left\{  b_{k},b_{l}\right\}  =\left(  V^{\dagger}\bar{U}\right)
_{lk}+\left(  U^{\dagger}\bar{V}\right)  _{lk}.
\end{equation}
In matrix notation this gives%
\[
\left\{  \left(
\begin{array}
[c]{c}%
\mathbf{b}\\
\mathbf{b}^{\dagger}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \right\}  =\left(
\begin{array}
[c]{cc}%
\left\{  \mathbf{b},\mathbf{b}^{\dagger}\right\}  & \left\{  \mathbf{b}%
,\mathbf{b}\right\} \\
\left\{  \mathbf{b}^{\dagger},\mathbf{b}^{\dagger}\right\}  & \left\{
\mathbf{b}^{\dagger},\mathbf{b}\right\}
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}_{r}\\
\mathbb{O}_{r} & \mathbb{I}_{r}%
\end{array}
\right)
\]
and
\begin{align}
&  \left\{  \left(
\begin{array}
[c]{c}%
\mathbf{b}\\
\mathbf{b}^{\dagger}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \right\} \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  ^{\dagger}\left\{  \left(
\begin{array}
[c]{c}%
\mathbf{a}\\
\mathbf{a}^{\dagger}%
\end{array}
\right)  ,\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \right\}  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right) \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\left\{  \mathbf{a},\mathbf{a}^{\dagger}\right\}  & \left\{  \mathbf{a}%
,\mathbf{a}\right\} \\
\left\{  \mathbf{a}^{\dagger},\mathbf{a}^{\dagger}\right\}  & \left\{
\mathbf{a}^{\dagger},\mathbf{a}\right\}
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right) \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}_{r}\\
\mathbb{O}_{r} & \mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right) \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{U}^{\dagger} & \mathbb{V}^{\dagger}\\
\overline{\mathbb{V}}^{\dagger} & \overline{\mathbb{U}}^{\dagger}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}_{r}\\
\mathbb{O}_{r} & \mathbb{I}_{r}%
\end{array}
\right)  .
\end{align}


Hence $\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  $ is a unitary matrix $\in U\left(  2r,\mathbb{R}\right)  $ $($but
\emph{is not }contained in $O\left(  2r,\mathbb{C}\right)  $ --its
complexification is $GL(2r,C))$ and
\begin{equation}
\mathbb{U}^{\dagger}\mathbb{U+V}^{\dagger}\mathbb{V\,=I}_{r}%
\end{equation}%
\begin{equation}
\mathbb{U}^{\dagger}\overline{\mathbb{V}}+\mathbb{V}^{\dagger}\overline
{\mathbb{U}}=\mathbb{O}_{r}.
\end{equation}


\subsection{Real Basis of the CAR Fock Algebra}

The transformation between the $\left\{  \left.  a_{j},a_{j}^{\dagger
}\right\vert 1\leq j\leq r\right\}  $ and $\left\{  \left.  x_{j}\right\vert
1\leq j\leq2r\right\}  $ bases is given by
\begin{align}
\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)   &  =J\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathbb{J}\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ,
\end{align}
where
\begin{equation}
\mathbb{J=}\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  \in U\left(  2r,\mathbb{R}\right)
\end{equation}
i.e.
\begin{align}
\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)   &  =\\
\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{1}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{-i}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbb{I}_{r} & \mathbb{O}_{r}\\
\mathbb{O}_{r} & \mathbb{I}_{r}%
\end{array}
\right)  ,
\end{align}
\emph{but is NOT a canonical transformation. }One can set
\begin{align}
J\left(  a_{j}^{\dagger}\right)   &  =x_{j}\\
J\left(  a_{j}\right)   &  =x_{j+r}.
\end{align}


The real basis produced by the canonically transformed $\left\{  \left.
a_{j}^{\dagger},a_{j}\right\vert 1\leq j\leq r\right\}  $ is
\begin{align*}
\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)   &  =J\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)
\end{align*}


\bigskip%
\begin{align}
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{1}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{-i}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right) \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{U+}\frac{1}{\sqrt{2}}\mathbb{V} & \frac{1}{\sqrt{2}%
}\overline{\mathbb{V}}+\frac{1}{\sqrt{2}}\overline{\mathbb{U}}\\
\frac{-i}{\sqrt{2}}\mathbb{U+}\frac{i}{\sqrt{2}}\mathbb{V} & \frac{-i}%
{\sqrt{2}}\overline{\mathbb{V}}+\frac{i}{\sqrt{2}}\overline{\mathbb{U}}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right) \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\frac{1}{2}\mathbb{U+}\frac{1}{2}\mathbb{V+}\frac{1}{2}\overline{\mathbb{V}%
}+\frac{1}{2}\overline{\mathbb{U}} & \frac{i}{2}\mathbb{U-}\frac{i}%
{2}\mathbb{V+}\frac{i}{2}\overline{\mathbb{V}}-\frac{i}{2}\overline
{\mathbb{U}}\\
\frac{-i}{2}\mathbb{U+}\frac{i}{2}\mathbb{V-}\frac{i}{2}\overline{\mathbb{V}%
}+\frac{i}{2}\overline{\mathbb{U}} & \frac{1}{2}\mathbb{U+}\frac{1}%
{2}\mathbb{V-}\frac{1}{2}\overline{\mathbb{V}}+\frac{1}{2}\overline
{\mathbb{U}}%
\end{array}
\right) \nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  .
\end{align}


i.e.
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  .
\end{equation}
Thus as
\begin{align}
\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)   &  =J\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathbb{J}\\
\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)   &  =J\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{b}^{\dagger} & \mathbf{b}%
\end{array}
\right)  \mathbb{J}%
\end{align}
one obtains
\begin{align}
\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)   &  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right) \\
&  =\left(
\begin{array}
[c]{cc}%
\mathbf{a}^{\dagger} & \mathbf{a}%
\end{array}
\right)  \mathbb{JJ}^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \mathbb{J}%
\end{align}
and hence
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  =\mathbb{J}^{\dagger}\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  \mathbb{J}.
\end{equation}
As both $\left(
\begin{array}
[c]{cc}%
\mathbb{U} & \overline{\mathbb{V}}\\
\mathbb{V} & \overline{\mathbb{U}}%
\end{array}
\right)  $ and $\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  $ are unitary one has that
\begin{align}
&  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  ^{\dagger}\nonumber\\
&  =\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  ^{\dagger}\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right) \nonumber\\
&  =\mathbb{I}_{2r}%
\end{align}
and as $\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  $ is a real matrix
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  ^{\dagger}=\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  ^{t}%
\end{equation}
and
\begin{equation}
\left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right)  \in O\left(  2r,\mathbb{R}\right)  ,
\end{equation}
i.e. \emph{the group of canonical transformations is }$O\left(  2r,\mathbb{R}%
\right)  \subset U\left(  2r,\mathbb{R}\right)  .$ There are other
transformation of $\mathcal{F}_{1}$ that preserve the CAR's that are not
canonical in particular $\left(
\begin{array}
[c]{cc}%
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & \frac{i}{\sqrt{2}}\mathbb{I}_{r}\\
\frac{1}{\sqrt{2}}\mathbb{I}_{r} & -\frac{i}{\sqrt{2}}\mathbb{I}_{r}%
\end{array}
\right)  .$ In fact one can see that any transformation belonging to $O\left(
2r,\mathbb{C}\right)  $ preserve the CAR's, but does not in general preserve
the relationships%
\begin{equation}
x_{j}=x_{j}^{\dagger}.
\end{equation}


The action of $O\left(  2r,\mathbb{R}\right)  $ on $\mathcal{F}$ can be
expressed in terms of inner automorphisms i.e.%

\begin{equation}
y_{j}=\hat{O}\left(  x_{j}\right)  =O\left(  \mathbf{\lambda}\right)
x_{j}O\left(  \mathbf{\lambda}\right)  ^{t}=\exp\left\{  \sum_{1\leq
k<l\leq2r}\lambda_{kl}x_{k}x_{l}\right\}  x_{j}\exp\left\{  -\sum_{1\leq
k<l\leq2r}\lambda_{kl}x_{k}x_{l}\right\}  ,
\end{equation}
where
\begin{equation}
\mathbf{\lambda=-\lambda}^{t},
\end{equation}
thus
\begin{align}
\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)   &  =\widehat{O\left(  \mathbf{\lambda}\right)  }\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \mathbb{T=}\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \left(
\begin{array}
[c]{cc}%
\operatorname{Re}\left(  \mathbb{U+V}\right)  & \operatorname{Im}\left(
\mathbb{V+U}\right) \\
\operatorname{Im}\left(  \mathbb{V}-\mathbb{U}\right)  & \operatorname{Re}%
\left(  \mathbb{U-V}\right)
\end{array}
\right) \\
\left(
\begin{array}
[c]{cc}%
\mathbf{y}_{1} & \mathbf{y}_{2}%
\end{array}
\right)   &  =\widehat{O\left(  \mathbf{\lambda}\right)  }\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
O\left(  \mathbf{\lambda}\right)  \mathbf{x}_{1}O\left(  \mathbf{\lambda
}\right)  ^{t} & O\left(  \mathbf{\lambda}\right)  \mathbf{x}_{2}O\left(
\mathbf{\lambda}\right)  ^{t}%
\end{array}
\right)  =\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \widehat{\mathbb{O}}=\left(
\begin{array}
[c]{cc}%
\mathbf{x}_{1} & \mathbf{x}_{2}%
\end{array}
\right)  \exp\left\{  \operatorname*{adj}\left(  \boldsymbol{\lambda}\right)
\right\}  .
\end{align}


\subsection{General Self Adjoint Field Operators}

In general
\begin{align}
X\left(  \left\vert u\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  +\Phi\left(
\left\vert u\right\rangle \right)  \right) \\
Y\left(  \left\vert u\right\rangle \right)   &  =\frac{i}{\sqrt{2}}\left(
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  -\Phi\left(
\left\vert u\right\rangle \right)  \right)
\end{align}%
\begin{align}
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)   &  =\frac{1}%
{\sqrt{2}}\left(  X\left(  \left\vert u\right\rangle \right)  -iY\left(
\left\vert u\right\rangle \right)  \right) \\
\Phi\left(  \left\vert u\right\rangle \right)   &  =\frac{1}{\sqrt{2}}\left(
X\left(  \left\vert u\right\rangle \right)  +iY\left(  \left\vert
u\right\rangle \right)  \right)  .
\end{align}
Hence
\begin{align}
&  \left\{  X\left(  \left\vert u\right\rangle \right)  ,X\left(  \left\vert
v\right\rangle \right)  \right\}  =\frac{1}{2}\left\{  \left(  \Phi^{\dagger
}\left(  \left\vert u\right\rangle \right)  +\Phi\left(  \left\vert
u\right\rangle \right)  \right)  ,\left(  \Phi^{\dagger}\left(  \left\vert
v\right\rangle \right)  +\Phi\left(  \left\vert v\right\rangle \right)
\right)  \right\} \nonumber\\
&  =\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}  +\left\{
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  +\left\{  \Phi\left(  \left\vert
u\right\rangle \right)  ,\Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  \right\}  +\left\{  \Phi\left(  \left\vert u\right\rangle \right)
,\Phi\left(  \left\vert v\right\rangle \right)  \right\} \nonumber\\
&  =0+\overline{\left\langle \left.  u\right\vert v\right\rangle
}I_{\mathcal{F}}+\left\langle \left.  u\right\vert v\right\rangle
I_{\mathcal{F}}+0=\operatorname{Re}\left\langle \left.  u\right\vert
v\right\rangle I_{\mathcal{F}}\\
&  \left\{  X\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
v\right\rangle \right)  \right\}  =\left\{  \left(  \Phi^{\dagger}\left(
\left\vert u\right\rangle \right)  +\Phi\left(  \left\vert u\right\rangle
\right)  \right)  ,i\left(  \Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  -\Phi\left(  \left\vert v\right\rangle \right)  \right)  \right\}
\nonumber\\
&  =i\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}  -i\left\{
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  +i\left\{  \Phi\left(  \left\vert
u\right\rangle \right)  ,\Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  \right\}  -i\left\{  \Phi\left(  \left\vert u\right\rangle \right)
,\Phi\left(  \left\vert v\right\rangle \right)  \right\} \nonumber\\
&  =0-i\overline{\left\langle \left.  u\right\vert v\right\rangle
}I_{\mathcal{F}}+i\left\langle \left.  u\right\vert v\right\rangle
I_{\mathcal{F}}=\operatorname{Im}\left\langle \left.  u\right\vert
v\right\rangle I_{\mathcal{F}}\\
&  \left\{  Y\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
v\right\rangle \right)  \right\}  =\left\{  i\left(  \Phi^{\dagger}\left(
\left\vert u\right\rangle \right)  -\Phi\left(  \left\vert u\right\rangle
\right)  \right)  ,i\left(  \Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  -\Phi\left(  \left\vert v\right\rangle \right)  \right)  \right\}
\nonumber\\
&  =-\left\{  \Phi^{\dagger}\left(  \left\vert u\right\rangle \right)
,\Phi^{\dagger}\left(  \left\vert v\right\rangle \right)  \right\}  +\left\{
\Phi^{\dagger}\left(  \left\vert u\right\rangle \right)  ,\Phi\left(
\left\vert v\right\rangle \right)  \right\}  +\left\{  \Phi\left(  \left\vert
u\right\rangle \right)  ,\Phi^{\dagger}\left(  \left\vert v\right\rangle
\right)  \right\}  -\left\{  \Phi\left(  \left\vert u\right\rangle \right)
,\Phi\left(  \left\vert v\right\rangle \right)  \right\} \nonumber\\
&  =0+\overline{\left\langle \left.  u\right\vert v\right\rangle
}I_{\mathcal{F}}+\left\langle \left.  u\right\vert v\right\rangle
I_{\mathcal{F}}+0=\operatorname{Re}\left\langle \left.  u\right\vert
v\right\rangle I_{\mathcal{F}}%
\end{align}
and
\begin{align}
\left\{  X\left(  \left\vert u\right\rangle \right)  ,X\left(  \left\vert
u\right\rangle \right)  \right\}   &  =\left\langle \left.  u\right\vert
u\right\rangle I_{\mathcal{F}}\\
\left\{  X\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
u\right\rangle \right)  \right\}   &  =0\\
\left\{  Y\left(  \left\vert u\right\rangle \right)  ,Y\left(  \left\vert
u\right\rangle \right)  \right\}   &  =\left\langle \left.  u\right\vert
u\right\rangle I_{\mathcal{F}}.
\end{align}
In particular for an conb $\left\{  \left.  \left\vert u_{i}\right\rangle
\right\vert 1\leq j\leq r\right\}  $%
\begin{align}
\left\{  X\left(  \left\vert u_{i}\right\rangle \right)  ,X\left(  \left\vert
u_{j}\right\rangle \right)  \right\}   &  =\delta_{ij}I_{\mathcal{F}}\\
\left\{  X\left(  \left\vert u_{i}\right\rangle \right)  ,Y\left(  \left\vert
u_{j}\right\rangle \right)  \right\}   &  =0\\
\left\{  Y\left(  \left\vert u_{i}\right\rangle \right)  ,Y\left(  \left\vert
u_{j}\right\rangle \right)  \right\}   &  =\delta_{ij}I_{\mathcal{F}}.
\end{align}


\section{Geometric Algebra}

The operator and Clifford products in $\mathcal{F=B}\left(  \mathcal{H}%
_{\mathcal{F}}\right)  $ are the same and are also known as the
\emph{geometric product. }Thus $\mathcal{F}$ can be thought of as an operator
algebra, Clifford algebra or Geometric algebra. The product of two grade 1
operators (vectors)
\begin{equation}
A=\sum_{1\leq j\leq2r}\alpha_{j}x_{j}\text{ and }\,B=\sum_{1\leq j\leq2r}%
\beta_{j}x_{j}%
\end{equation}
is given by
\begin{align}
AB  &  =\sum_{1\leq j,k\leq2r}\alpha_{j}\beta_{k}x_{j}x_{k}=\sum_{1\leq
j\leq2r}\alpha_{j}\beta_{j}x_{j}^{2}+\sum_{1\leq j\neq k\leq2r}\alpha_{j}%
\beta_{k}x_{j}x_{k}\nonumber\\
&  =\frac{1}{2}\sum_{1\leq j\leq2r}\alpha_{j}\beta_{j}+\sum_{1\leq j<k\leq
2r}\left(  \alpha_{j}\beta_{k}-\alpha_{k}\beta_{j}\right)  x_{j}%
x_{k}\nonumber\\
&  =\frac{1}{2}\left(  \left.  A\right\vert B\right)  I_{\mathcal{F}}+A\wedge
B
\end{align}
and the product $AB$ expressed in this fashion is called the \emph{geometric
product }of the \emph{vectors} $A$ and $B.$

\subsection{Degree of Operators}

$N^{th}$ degree operators are defined to be $N^{th}$ degree polynomials in the
generators of the Clifford algebra and are of the form
\begin{equation}
A_{N}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq M\leq N}\sum_{1\leq j_{1}%
<\cdots<j_{M}\leq2r}\alpha_{Mj_{1}\cdots j_{M}}x_{j_{1}}\cdots x_{j_{M}}%
\end{equation}
and grade $N$ operators are homogeneous of degree $N$ i.e.
\begin{equation}
B_{N}=\sum_{1\leq j_{1}<\cdots<j_{N}\leq2r}\alpha_{Nj_{1}\cdots j_{N}}%
x_{j_{1}}\cdots x_{j_{N}}.
\end{equation}


\subsubsection{First Degree Operators}

First degree operators are first degree polynomials in the generators of the
Clifford algebra
\begin{equation}
A_{1}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq2r}\alpha_{1j}x_{j}.\nonumber
\end{equation}
Grade 1 operators are homogeneous of degree 1 and can be expressed in terms of
a non a self adjoint basis as
\begin{align}
A_{1}  &  =\sum_{1\leq j\leq2r}\alpha_{j}x_{j}=\sum_{1\leq j\leq r}\left\{
\alpha_{j}x_{j}+\alpha_{j+r}x_{j+r}\right\}  =\sum_{1\leq j\leq r}\left\{
\alpha_{j}\left(  a_{j}^{\dagger}+a_{j}\right)  +\alpha_{j+r}i\left(
a_{j}^{\dagger}-a_{j}\right)  \right\} \nonumber\\
&  =\sum_{1\leq j\leq r}\left\{  \alpha_{j}a_{j}^{\dagger}+\alpha_{j}%
a_{j}+i\alpha_{j+r}a_{j}^{\dagger}-i\alpha_{j+r}a_{j}\right\}  =\sum_{1\leq
j\leq r}\left\{  \left(  \alpha_{j}+i\alpha_{j+r}\right)  a_{j}^{\dagger
}+\left(  \alpha_{j}-i\alpha_{j+r}\right)  a_{j}\right\}  .
\end{align}


\subsubsection{Second Degree Operators}

Second degree operators are second degree polynomials in the generators of the
Clifford algebra
\begin{equation}
A_{2}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq j\leq2r}\alpha_{1j}x_{j}%
+\sum_{1\leq j<k\leq2r}\alpha_{2jk}x_{j}x_{k}.\nonumber
\end{equation}
Homogeneous second degree operators of degree 2 can be expressed in terms of a
non self adjoint basis as
\begin{align}
A_{2}  &  =\sum_{1\leq j<k\leq2r}\alpha_{jk}x_{j}x_{k}\nonumber\\
&  =2\sum_{1\leq j<k\leq r}\left(  \alpha_{jk}-\alpha_{kj}\right)  \left(
a_{j}^{\dagger}+a_{j}\right)  \left(  a_{k}^{\dagger}+a_{k}\right)
+\nonumber\\
&  +i\sum_{1\leq j\leq r,r+1\leq k\leq2r}\left(  \alpha_{jk}-\alpha
_{kj}\right)  \left(  a_{j}^{\dagger}+a_{j}\right)  \left(  a_{k}^{\dagger
}-a_{k}\right)  -2\sum_{r+1\leq j<k\leq2r}\left(  \alpha_{jk}-\alpha
_{kj}\right)  \left(  a_{j}^{\dagger}-a_{j}\right)  \left(  a_{k}^{\dagger
}-a_{k}\right) \nonumber\\
&  =2\sum_{1\leq j<k\leq r}\left(  \alpha_{jk}-\alpha_{kj}\right)  \left(
a_{j}^{\dagger}a_{k}^{\dagger}+a_{j}^{\dagger}a_{k}+a_{j}a_{k}^{\dagger}%
+a_{j}a_{k}\right) \nonumber\\
&  +i\sum_{1\leq j\leq r,r+1\leq k\leq2r}\left(  \alpha_{jk}-\alpha
_{kj}\right)  \left(  a_{j}^{\dagger}a_{k}^{\dagger}-a_{j}^{\dagger}%
a_{k}+a_{j}a_{k}^{\dagger}-a_{j}a_{k}\right) \nonumber\\
&  -2\sum_{r+1\leq j<k\leq2r}\left(  \alpha_{jk}-\alpha_{kj}\right)  \left(
a_{j}^{\dagger}a_{k}^{\dagger}-a_{j}^{\dagger}a_{k}-a_{j}a_{k}^{\dagger}%
+a_{j}a_{k}\right)  .
\end{align}
Grade $2$ operators are homogeneous of degree $2$ i.e.
\begin{equation}
B_{2}=\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}}x_{j_{1}}x_{j_{2}}.
\end{equation}


\section{One Particle Operators}

One can first consider one particle operators of

\subsubsection{Diagonal form}

Diagonal one particle operators expressed in terms of the generators of the
Clifford algebra are%
\begin{align}
\lambda_{1}  &  =\sum_{1\leq j\leq r}\beta_{1j}b_{j}^{\dagger}b_{j}=\frac
{1}{2}\sum_{1\leq j,k\leq r}\beta_{1j}\left(  y_{j}-iy_{j+r}\right)  \left(
y_{j}+iy_{j+r}\right) \\
&  =\frac{1}{2}\sum_{1\leq j\leq r}\beta_{1j}\left\{  y_{j}y_{j}%
+y_{j+r}y_{j+r}+iy_{j}y_{j+r}-iy_{j+r}y_{j}\right\} \\
&  =\frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)  I_{\mathcal{F}%
}+\frac{i}{2}\sum_{1\leq j\leq r}\beta_{1j}\left\{  \left(  y_{j}%
y_{j+r}-y_{j+r}y_{j}\right)  \right\} \\
&  =\frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)  I_{\mathcal{F}%
}+i\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r},
\end{align}
which is quite general as any normal one particle operator can be
diagonalized. If the operator is self adjoint $\left\{  \left.  \beta_{1j}%
\in\mathbb{R}\right\vert 1\leq j\leq r\right\}  .$ One can observe from the
preceding that a one particle operator has both grade zero and one components
and is a first degree polynomial.

We can find the square of the diagonal form of a normal one particle operator
when $r=2$ as%
\begin{align}
&  \left(  \frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)
I_{\mathcal{F}}+i\left(  \beta_{11}y_{1}y_{3}+\beta_{12}y_{2}y_{4}\right)
\right)  ^{2}\nonumber\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(
\beta_{11}y_{1}y_{3}+\beta_{12}y_{2}y_{4}\right)  -\left(  \beta_{11}%
y_{1}y_{3}+\beta_{12}y_{2}y_{4}\right)  \left(  \beta_{11}y_{1}y_{3}%
+\beta_{12}y_{2}y_{4}\right) \nonumber\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(
\beta_{11}y_{1}y_{3}+\beta_{12}y_{2}y_{4}\right)  +\frac{1}{4}\beta_{11}%
^{2}I_{\mathcal{F}}+\frac{1}{4}\beta_{12}^{2}I_{\mathcal{F}}\nonumber\\
&  \qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+\beta_{11}\beta
_{12}y_{1}y_{3}y_{2}y_{4}+\beta_{11}\beta_{12}y_{2}y_{4}y_{1}y_{3}\nonumber\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(
\beta_{11}y_{1}y_{3}+\beta_{12}y_{2}y_{4}\right)  +\frac{1}{4}\beta_{11}%
^{2}I_{\mathcal{F}}+\frac{1}{4}\beta_{12}^{2}I_{\mathcal{F}}-2\beta_{11}%
\beta_{12}y_{1}y_{2}y_{3}y_{4}\nonumber\\
&  =\frac{1}{4}\left\{  \left(  \operatorname*{Tr}\lambda_{1}\right)
^{2}+\beta_{11}^{2}+\beta_{12}^{2}\right\}  I_{\mathcal{F}}+i\left(
\operatorname*{Tr}\lambda_{1}\right)  \left(  \beta_{11}y_{1}y_{3}+\beta
_{12}y_{2}y_{4}\right)  -2\beta_{11}\beta_{12}y_{1}y_{2}y_{3}y_{4}\nonumber\\
&  =\frac{1}{4}\left\{  \left(  \operatorname*{Tr}\lambda_{1}\right)
^{2}+\operatorname*{Tr}\lambda_{1}^{2}\right\}  I_{\mathcal{F}}+i\left(
\operatorname*{Tr}\lambda_{1}\right)  \left(  \beta_{11}y_{1}y_{3}+\beta
_{12}y_{2}y_{4}\right)  -2\beta_{11}\beta_{12}y_{1}y_{2}y_{3}y_{4}%
\end{align}
Thus the idempotency condition gives
\begin{align}
&  \frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\left(  \frac{1}%
{2}\operatorname*{Tr}\lambda_{1}-1\right)  +\frac{1}{2}\left(  \beta_{11}%
^{2}+\beta_{12}^{2}\right)  \right)  I_{\mathcal{F}}+i\left(
\operatorname*{Tr}\lambda_{1}-1\right)  \left(  \beta_{11}y_{1}y_{3}%
+\beta_{12}y_{2}y_{4}\right) \nonumber\\
&  -2\beta_{11}\beta_{12}y_{1}y_{2}y_{3}y_{4}=0\Longrightarrow\nonumber\\
&  \frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\left(  \frac{1}%
{2}\operatorname*{Tr}\lambda_{1}-1\right)  +\frac{1}{2}\operatorname*{Tr}%
\lambda_{1}^{2}\right)  I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda
_{1}-1\right)  \left(  \beta_{11}y_{1}y_{3}+\beta_{12}y_{2}y_{4}\right)
\nonumber\\
&  -2\beta_{11}\beta_{12}y_{1}y_{2}y_{3}y_{4}=0.
\end{align}
One can express this more transparently as%
\begin{align}
\left(  \operatorname*{Tr}\lambda_{1}^{2}\right)  I_{\mathcal{F}}  &
=2\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(  \left(
\operatorname*{Tr}\lambda_{1}\right)  -\frac{1}{2}\right)  I_{\mathcal{F}}\\
i\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(  \beta_{11}y_{1}%
y_{3}+\beta_{12}y_{2}y_{4}\right)   &  =i\left(  \beta_{11}y_{1}y_{3}%
+\beta_{12}y_{2}y_{4}\right) \\
2\beta_{11}\beta_{12}y_{1}y_{2}y_{3}y_{4}  &  =0\\
\operatorname*{Tr}\lambda_{1}  &  =\beta_{11}+\beta_{12}%
\end{align}
Noting%
\begin{align}
y_{1}y_{2}y_{3}y_{4}  &  =-\frac{1}{4}\left(  a_{1}^{\dagger}+a_{1}\right)
\left(  a_{2}^{\dagger}+a_{2}\right)  \left(  a_{3}^{\dagger}-a_{3}\right)
\left(  a_{4}^{\dagger}-a_{4}\right) \nonumber\\
&  =-\frac{1}{4}\left(  a_{1}^{\dagger}a_{2}^{\dagger}+a_{1}^{\dagger}%
a_{2}+a_{1}a_{2}^{\dagger}+a_{1}a_{2}\right)  \left(  a_{3}^{\dagger}%
a_{4}^{\dagger}-a_{3}^{\dagger}a_{4}-a_{3}a_{4}^{\dagger}+a_{3}a_{4}\right)
\neq0
\end{align}
one can deduce that either or both $\beta_{11},\beta_{12}=0$ thus
\begin{align}
\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(  \beta_{11}y_{1}%
y_{3}\right)   &  =\beta_{11}y_{1}y_{3}\nonumber\\
&  \Rightarrow\operatorname*{Tr}\lambda_{1}=\beta_{11}=1.
\end{align}
For any $r$ one obtains
\begin{align}
&  \left(  \frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)
I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r}\right)
^{2}\nonumber\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \sum_{1\leq
j\leq r}\beta_{1j}y_{j}y_{j+r}-\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r}%
\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r}\nonumber\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \sum_{1\leq
j\leq r}\beta_{1j}y_{j}y_{j+r}+\frac{1}{4}\sum_{1\leq j\leq r}\beta_{1j}%
^{2}I_{\mathcal{F}}+2\sum_{1\leq j_{1}<j_{2}\leq r}\beta_{1j_{1}}\beta
_{1j_{2}}y_{j_{1}}y_{j_{1}+r}y_{j_{2}}y_{j_{2}+r}\nonumber\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \sum_{1\leq
j\leq r}\beta_{1j}y_{j}y_{j+r}+\frac{1}{4}\sum_{1\leq j\leq r}\beta_{1j}%
^{2}I_{\mathcal{F}}-2\sum_{1\leq j_{1}<j_{2}\leq r}\beta_{1j_{1}}\beta
_{1j_{2}}y_{j_{1}}y_{j_{2}}y_{j_{1}+r}y_{j_{2}+r}\nonumber\\
&  =\frac{1}{4}\left\{  \left(  \operatorname*{Tr}\lambda_{1}\right)
^{2}+\sum_{1\leq j\leq r}\beta_{1j}^{2}I_{\mathcal{F}}\right\}  I_{\mathcal{F}%
}+i\left(  \operatorname*{Tr}\lambda_{1}\right)  \sum_{1\leq j\leq r}%
\beta_{1j}y_{j}y_{j+r}-2\sum_{1\leq j_{1}<j_{2}\leq r}\beta_{1j_{1}}%
\beta_{1j_{2}}y_{j_{1}}y_{j_{2}}y_{j_{1}+r}y_{j_{2}+r}\nonumber\\
&  =\frac{1}{4}\left\{  \left(  \operatorname*{Tr}\lambda_{1}\right)
^{2}+\left(  \operatorname*{Tr}\lambda_{1}^{2}\right)  I_{\mathcal{F}%
}\right\}  I_{\mathcal{F}}+i\left(  \operatorname*{Tr}\lambda_{1}\right)
\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r}-2\sum_{1\leq j_{1}<j_{2}\leq
r}\beta_{1j_{1}}\beta_{1j_{2}}y_{j_{1}}y_{j_{2}}y_{j_{1}+r}y_{j_{2}+r}%
\end{align}
The idempotency condition
\begin{equation}
\left(  \frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)
I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r}\right)
^{2}-\left(  \frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)
I_{\mathcal{F}}+i\sum_{1\leq j\leq r}\beta_{1j}y_{j}y_{j+r}\right)  =\,0
\end{equation}
gives%
\begin{align}
&  \frac{1}{4}\left\{  \left(  \operatorname*{Tr}\lambda_{1}\right)  \left(
\left(  \operatorname*{Tr}\lambda_{1}\right)  -2\right)  +\left(
\operatorname*{Tr}\lambda_{1}^{2}\right)  \right\}  I_{\mathcal{F}}+i\left(
\operatorname*{Tr}\lambda_{1}-1\right)  \sum_{1\leq j\leq r}\beta_{1j}%
y_{j}y_{j+r}\nonumber\\
&  \left.  -\right.  2\sum_{1\leq j_{1}<j_{2}\leq r}\beta_{1j_{1}}%
\beta_{1j_{2}}y_{j_{1}}y_{j_{2}}y_{j_{1}+r}y_{j_{2}+r}=0.
\end{align}
One can apply the same reasoning as above to deduce that $\operatorname*{Tr}%
\lambda_{1}=\beta_{11}=1$ and all other $\beta_{1j}$ 's are zero

\subsubsection{General form}

Any one particle operator $\lambda_{1}$ can be expressed as
\begin{align}
\lambda_{1}  &  =\sum_{1\leq j,k\leq r}\lambda_{1jk}a_{j}^{\dagger}a_{k}%
=\frac{1}{2}\sum_{1\leq j,k\leq r}\lambda_{1jk}\left(  x_{j}-ix_{j+r}\right)
\left(  x_{k}+ix_{k+r}\right) \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j,k\leq r}\lambda_{1jk}\left\{  x_{j}x_{k}%
+x_{j+r}x_{k+r}+ix_{j}x_{k+r}-ix_{j+r}x_{k}\right\}  ,
\end{align}
which can be further developed as
\begin{align}
\lambda_{1}  &  =\frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)
I_{\mathcal{F}}+\frac{1}{2}\sum_{1\leq j<k\leq r}\left(  \lambda_{1jk}%
-\lambda_{1kj}\right)  \left\{  x_{j}x_{k}+x_{j+r}x_{k+r}+i\left(
x_{j}x_{k+r}-x_{j+r}x_{k}\right)  \right\} \nonumber\\
&  =\frac{1}{2}\left(  \operatorname*{Tr}\lambda_{1}\right)  I_{\mathcal{F}%
}+\sum_{1\leq j<k\leq2r}\eta_{jk}x_{j}x_{k},
\end{align}
where the coefficients $\eta_{jk}$ are antisymmetric and given by
\begin{align}
\eta_{jk}  &  =\frac{1}{2}\left(  \lambda_{1jk}-\lambda_{1kj}\right)
;\quad1\leq j<k\leq r;r+1\leq j<k\leq2r\\
\eta_{jk}  &  =-\frac{i}{2}\left(  \lambda_{1jk}-\lambda_{1kj}\right)
;\quad1\leq j\leq r;r+1\leq k\leq2r\\
\eta_{jj}  &  =0;\quad1\leq j\leq2r.
\end{align}


One can compute the square of $\lambda_{1}$ when $r=2$ i.e.
\begin{align*}
\left(  \lambda_{1}\right)  ^{2}  &  =\left(  \frac{1}{2}\left(
\operatorname*{Tr}\lambda_{1}\right)  I_{\mathcal{F}}+\eta_{12}x_{1}x_{2}%
+\eta_{13}x_{1}x_{3}+\eta_{14}x_{1}x_{4}+\eta_{23}x_{2}x_{3}+\eta_{24}%
x_{2}x_{4}+\eta_{34}x_{3}x_{4}\right)  ^{2}\\
&  =\frac{1}{4}\left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}%
I_{\mathcal{F}}+\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(
\eta_{12}x_{1}x_{2}+\eta_{13}x_{1}x_{3}+\eta_{14}x_{1}x_{4}+\eta_{23}%
x_{2}x_{3}+\eta_{24}x_{2}x_{4}+\eta_{34}x_{3}x_{4}\right) \\
&  -\frac{1}{4}\left(  \eta_{12}^{2}+\eta_{13}^{2}+\eta_{14}^{2}+\eta_{23}%
^{2}+\eta_{24}^{2}+\eta_{34}^{2}\right)  I_{\mathcal{F}}\\
&  +\eta_{12}\eta_{13}x_{1}x_{2}x_{1}x_{3}+\eta_{12}\eta_{14}x_{1}x_{2}%
x_{1}x_{4}+\eta_{12}\eta_{23}x_{1}x_{2}x_{2}x_{3}+\eta_{12}\eta_{24}x_{1}%
x_{2}x_{2}x_{4}\\
&  +\eta_{13}\eta_{12}x_{1}x_{3}x_{1}x_{2}+\eta_{13}\eta_{14}x_{1}x_{3}%
x_{1}x_{4}+\eta_{13}x_{1}x_{3}\eta_{23}x_{2}x_{3}+\eta_{13}\eta_{34}x_{1}%
x_{3}x_{3}x_{4}\\
&  +\eta_{14}\eta_{12}x_{1}x_{4}x_{1}x_{2}+\eta_{14}\eta_{13}x_{1}x_{4}%
x_{1}x_{3}+\eta_{14}x_{1}x_{4}\eta_{24}x_{2}x_{4}+\eta_{14}\eta_{34}x_{1}%
x_{4}x_{3}x_{4}\\
&  +\eta_{23}\eta_{12}x_{2}x_{3}x_{1}x_{2}+\eta_{23}\eta_{13}x_{2}x_{3}%
x_{1}x_{3}+\eta_{23}\eta_{24}x_{2}x_{3}x_{2}x_{4}+\eta_{23}\eta_{34}x_{2}%
x_{3}x_{3}x_{4}\\
&  +\eta_{24}\eta_{12}x_{2}x_{4}x_{1}x_{2}+\eta_{24}\eta_{14}x_{2}x_{4}%
x_{1}x_{4}+\eta_{24}\eta_{23}x_{2}x_{4}x_{2}x_{3}+\eta_{24}\eta_{34}x_{2}%
x_{4}x_{3}x_{4}\\
&  +\eta_{34}\eta_{13}x_{3}x_{4}x_{1}x_{3}+\eta_{34}\eta_{14}x_{3}x_{4}%
x_{1}x_{4}+\eta_{34}\eta_{23}x_{3}x_{4}x_{2}x_{3}+\eta_{34}\eta_{24}x_{3}%
x_{4}x_{2}x_{4}\\
&  +\eta_{12}\eta_{34}x_{1}x_{2}x_{3}x_{4}+\eta_{13}\eta_{24}x_{1}x_{3}%
x_{2}x_{4}+\eta_{14}\eta_{23}x_{1}x_{4}x_{2}x_{3}+\eta_{23}\eta_{14}x_{2}%
x_{3}x_{1}x_{4}\\
&  +\eta_{24}x\eta_{132}x_{4}x_{1}x_{3}+\eta_{34}\eta_{12}x_{3}x_{4}x_{1}x_{2}%
\end{align*}%
\begin{align*}
&  =\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}-\frac{1}%
{4}\left(  \eta_{12}^{2}+\eta_{13}^{2}+\eta_{14}^{2}+\eta_{23}^{2}+\eta
_{24}^{2}+\eta_{34}^{2}\right)  \right)  I_{\mathcal{F}}\\
&  +\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  \eta_{23}+\eta
_{34}\eta_{24}-\eta_{12}\eta_{13}+\eta_{13}\eta_{12}-\eta_{24}\eta
_{34}\right)  x_{2}x_{3}\\
&  +\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  \eta_{24}+\eta
_{23}\eta_{34}-\eta_{12}\eta_{14}+\eta_{14}\eta_{12}-\eta_{34}\eta
_{23}\right)  x_{2}x_{4}\\
&  +\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  \eta_{13}+\eta
_{12}\eta_{23}-\eta_{14}\eta_{34}-\eta_{23}\eta_{12}+\eta_{34}\eta
_{143}\right)  x_{1}x_{3}\\
&  +\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  \eta_{14}+\eta
_{12}\eta_{24}-\eta_{24}\eta_{12}+\eta_{13}\eta_{34}-\eta_{34}\eta
_{13}\right)  x_{1}x_{4}\\
&  +\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  \eta_{34}+\eta
_{14}\eta_{13}-\eta_{13}\eta_{14}-\eta_{23}\eta_{24}+\eta_{24}\eta
_{23}\right)  x_{3}x_{4}\\
&  +\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  \eta_{12}+\eta
_{23}\eta_{13}-\eta_{13}\eta_{23}-\eta_{14}\eta_{24}+\eta_{24}\eta
_{14}\right)  x_{1}x_{2}\\
&  +2\left(  \eta_{12}\eta_{34}-\eta_{13}\eta_{24}+\eta_{14}\eta_{23}\right)
x_{1}x_{2}x_{3}x_{4}%
\end{align*}%
\begin{align*}
&  =\left(  \left(  \operatorname*{Tr}\lambda_{1}\right)  ^{2}-\frac{1}%
{4}\left(  \eta_{12}^{2}+\eta_{13}^{2}+\eta_{14}^{2}+\eta_{23}^{2}+\eta
_{24}^{2}+\eta_{34}^{2}\right)  \right)  I_{\mathcal{F}}\\
&  +\left(  \operatorname*{Tr}\lambda_{1}\right)  \left(  \eta_{23}x_{2}%
x_{3}+\eta_{24}x_{2}x_{4}+\eta_{13}x_{1}x_{3}+\eta_{14}x_{1}x_{4}+\eta
_{34}x_{3}x_{4}+\eta_{12}x_{1}x_{2}\right) \\
&  +2\left(  \eta_{12}\eta_{34}-\eta_{13}\eta_{24}+\eta_{14}\eta_{23}\right)
x_{1}x_{2}x_{3}x_{4}%
\end{align*}%
\begin{align}
&  =\left(  \operatorname*{Tr}\lambda_{1}\left(  \operatorname*{Tr}\lambda
_{1}-1\right)  -\left(  \eta_{12}^{2}+\eta_{13}^{2}+\eta_{14}^{2}+\eta
_{23}^{2}+\eta_{24}^{2}+\eta_{34}^{2}\right)  \right)  I_{\mathcal{F}%
}\nonumber\\
&  +\left(  \operatorname*{Tr}\lambda_{1}-1\right)  \left(  \eta_{23}%
x_{2}x_{3}+\eta_{24}x_{2}x_{4}+\eta_{13}x_{1}x_{3}+\eta_{14}x_{1}x_{4}%
+\eta_{34}x_{3}x_{4}+\eta_{12}x_{1}x_{2}\right) \nonumber\\
&  \left.  +\right.  2\left(  \eta_{12}\eta_{34}-\eta_{13}\eta_{24}+\eta
_{14}\eta_{23}\right)  x_{1}x_{2}x_{3}x_{4}=0.
\end{align}
recall%
\begin{align}
\eta_{jk}  &  =\frac{1}{2}\left(  \lambda_{1jk}-\lambda_{1kj}\right)
;\quad1\leq j<k\leq r;r+1\leq j<k\leq2r\\
\eta_{jk}  &  =-\frac{i}{2}\left(  \lambda_{1jk}-\lambda_{1kj}\right)
;\quad1\leq j\leq r;r+1\leq k\leq2r.
\end{align}
This gives in general for any $r$
\begin{align}
&  \left(  \operatorname*{Tr}\lambda_{1}\left(  \operatorname*{Tr}\lambda
_{1}-1\right)  -\sum_{1\leq j<k\leq r}\eta_{jk}^{2}\right)  I_{\mathcal{F}%
}+\left(  \operatorname*{Tr}\lambda_{1}-1\right)  \sum_{1\leq j<k\leq r}%
\eta_{jk}x_{j}x_{k}\nonumber\\
&  \left.  +\right.  2\sum_{1\leq j_{1}<j_{2}<j_{3}<j_{4}\leq r}%
\operatorname*{Pf}\left(  \eta\right)  _{j_{1}j_{2}j_{3}j_{4}}x_{j_{1}%
}x_{j_{2}}x_{j_{3}}x_{j_{4}}=0.
\end{align}


\subsubsection{}

\subsubsection{One Particle and One Hole Idempotents}

The creators and annihilators
\begin{align}
a_{j}^{\dagger}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}-ix_{j+r}\right) \\
a_{j}  &  =\frac{1}{\sqrt{2}}\left(  x_{j}+ix_{j+r}\right)
\end{align}
produce the one particle operators%
\begin{align}
a_{j}^{\dagger}a_{k}  &  =\frac{1}{2}\left(  x_{j}-ix_{j+r}\right)  \left(
x_{k}+ix_{k+r}\right)  =\frac{1}{2}\left(  x_{j}x_{k}+ix_{j}x_{k+r}%
-ix_{j+r}x_{k}+x_{j+r}x_{k+r}\right) \\
&  =\frac{1}{2}\left\{  \left(  x_{j}x_{k}+x_{j+r}x_{k+r}\right)  +i\left(
x_{j}x_{k+r}-x_{j+r}x_{k}\right)  \right\}  .
\end{align}
One particle idempotents are given by%
\begin{align}
n_{j}  &  =a_{j}^{\dagger}a_{j}=\frac{1}{2}\left(  x_{j}-ix_{j+r}\right)
\left(  x_{j}+ix_{j+r}\right)  =\frac{1}{2}\left(  x_{j}^{2}+ix_{j}%
x_{j+r}-ix_{j+r}x_{j}+x_{j+r}^{2}\right) \\
&  =\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\\
\left(  n_{j}\right)  ^{2}  &  =\left(  \frac{1}{2}I_{\mathcal{F}}%
+ix_{j}x_{j+r}\right)  ^{2}=\left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}%
x_{j+r}\right)  \left(  \frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}\right) \\
&  =\frac{1}{4}I_{\mathcal{F}}+\frac{1}{2}ix_{j}x_{j+r}+\frac{1}{2}%
ix_{j}x_{j+r}-x_{j}x_{j+r}x_{j}x_{j+r}\\
&  =\frac{1}{4}I_{\mathcal{F}}+ix_{j}x_{j+r}+\frac{1}{4}I_{\mathcal{F}}%
=\frac{1}{2}I_{\mathcal{F}}+ix_{j}x_{j+r}=n_{j}.
\end{align}
and one hole idempotents are given by
\begin{align}
h_{j}  &  =a_{j}a_{j}^{\dagger}=\frac{1}{2}\left(  x_{j}+ix_{j+r}\right)
\left(  x_{j}-ix_{j+r}\right)  =\frac{1}{2}\left(  x_{j}^{2}-ix_{j}%
x_{j+r}+ix_{j+r}x_{j}+x_{j+r}^{2}\right) \\
&  =\frac{1}{2}I_{\mathcal{F}}-ix_{j}x_{j+r}.
\end{align}


The projectors $\left\{  n_{j},h_{j}\right\}  $ are infinite dimensional when
$r=\infty$ showing that in this case there are \emph{no} finite one particle
operator projections!

\section{Two Particle Operators}

One can first consider two particle operators of

\subsubsection{Decomposable Diagonal form}

This type of particle operators can be expanded as%
\begin{align}
\lambda_{2}  &  =\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{2}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{2}}a_{j_{1}%
}\nonumber\\
&  =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left(  x_{j_{1}}-ix_{j_{1}+r}\right)  \left(  x_{j_{2}}-ix_{j_{2}+r}\right)
\left(  x_{j_{2}}+ix_{j_{2}+r}\right)  \left(  x_{j_{1}}+ix_{j_{1}+r}\right)
\nonumber\\
&  =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left(  x_{j_{1}}x_{j_{2}}-ix_{j_{1}+r}x_{j_{2}}-ix_{j_{1}}x_{j_{2}%
+r}-x_{j_{1}+r}x_{j_{2}+r}\right)  \times\nonumber\\
&  \left(  x_{j_{2}}x_{j_{1}}+ix_{j_{2}+r}x_{j_{1}}+ix_{j_{2}}x_{j_{1}%
+r}-x_{j_{2}+r}x_{j_{1}+r}\right) \nonumber\\
&  =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left\{  {}\right. \nonumber\\
&  +x_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}}x_{j_{2}%
}x_{j_{1}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{2}}x_{j_{1}}-x_{j_{1}+r}x_{j_{2}%
+r}x_{j_{2}}x_{j_{1}}\nonumber\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{2}+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}%
+r}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}%
+r}x_{j_{2}+r}x_{j_{1}}\nonumber\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}%
}x_{j_{1}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}}x_{j_{1}+r}-ix_{j_{1}+r}x_{j_{2}%
+r}x_{j_{2}}x_{j_{1}+r}\nonumber\\
&  -\left.  x_{j_{1}}x_{j_{2}}x_{j_{2}+r}x_{j_{1}+r}+ix_{j_{1}+r}x_{j_{2}%
}x_{j_{2}+r}x_{j_{1}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}%
+x_{j_{1}+r}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}+r}\right\}
\end{align}
The zeroth degree terms are%
\begin{align}
&  \frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}%
+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}%
+r}x_{j_{2}+r}x_{j_{1}+r}\right\} \nonumber\\
&  =\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}I_{\mathcal{F}}=\frac{1}{4}\operatorname*{Tr}\left\{  \lambda_{2}\right\}
I_{\mathcal{F}}%
\end{align}
The second degree terms are
\begin{align*}
&  =\frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left\{  -ix_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}}-ix_{j_{1}}x_{j_{2}%
+r}x_{j_{2}}x_{j_{1}}\right. \\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{2}+r}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{2}%
+r}x_{j_{1}}+ix_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}\\
&  -\left.  ix_{j_{1}+r}x_{j_{2}}x_{j_{2}+r}x_{j_{1}+r}-ix_{j_{1}+r}%
x_{j_{2}+r}x_{j_{2}}x_{j_{1}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{2}+r}x_{j_{1}%
+r}\right\}
\end{align*}%
\begin{align}
&  =\frac{1}{16}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left\{  -ix_{j_{1}+r}x_{j_{1}}-ix_{j_{2}+r}x_{j_{2}}\right. \nonumber\\
&  +ix_{j_{2}}x_{j_{2}+r}-ix_{j_{1}+r}x_{j_{1}}+ix_{j_{1}}x_{j_{1}%
+r}-ix_{j_{2}+r}x_{j_{2}}-\left.  ix_{j_{2}+r}x_{j_{2}}+ix_{j_{1}}x_{j_{1}%
+r}\right\} \nonumber\\
&  =\frac{i}{2}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}x_{j_{1}}x_{j_{1}+r}=\frac{i}{2}\sum_{1\leq j_{1}\leq r}L_{2}^{1}\left(
\lambda_{2}\right)  _{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}.
\end{align}
The fourth degree terms are
\begin{align}
&  \frac{1}{8}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}+x_{j_{1}}x_{j_{2}}%
x_{j_{1}+r}x_{j_{2}+r}+x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}+x_{j_{1}%
}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}\right\} \nonumber\\
&  =\frac{1}{2}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}=\sum_{1\leq j_{1}<j_{2}\leq
r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{2}}x_{j_{1}+r}x_{j_{2}+r}%
\end{align}


Hence
\begin{align}
\lambda_{2}  &  =\frac{1}{4}\operatorname*{Tr}\left\{  \lambda_{2}\right\}
I_{\mathcal{F}}+\frac{i}{2}\sum_{1\leq j_{1}\leq r}L_{2}^{1}\left(
\lambda_{2}\right)  _{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}+\sum_{1\leq j_{1}%
<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{2}}x_{j_{1}%
+r}x_{j_{2}+r}\nonumber\\
&  =\frac{1}{4}L_{2}^{0}\left(  \lambda_{2}\right)  I_{\mathcal{F}}+\frac
{i}{2}\sum_{1\leq j_{1}\leq r}L_{2}^{1}\left(  \lambda_{2}\right)
_{j_{1}j_{1}}x_{j_{1}}x_{j_{1}+r}+\sum_{1\leq j_{1}<j_{2}\leq r}L_{2}%
^{2}\left(  \lambda_{2}\right)  _{j_{1}j_{2}j_{1}j_{2}}x_{j_{1}}x_{j_{2}%
}x_{j_{1}+r}x_{j_{2}+r}%
\end{align}


\subsubsection{General form}

General two particle operators can be expanded as
\begin{align}
\lambda_{2}  &  =\frac{1}{4}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq r}%
\lambda_{2j_{1}j_{2}j_{3}j_{4}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{4}%
}a_{j_{3}}\nonumber\\
&  =\frac{1}{16}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq r}\lambda_{2j_{1}%
j_{2}j_{3}j_{4}}\left(  x_{j_{1}}-ix_{j_{1}+r}\right)  \left(  x_{j_{2}%
}-ix_{j_{2}+r}\right)  \left(  x_{j_{4}}+ix_{j_{4}+r}\right)  \left(
x_{j_{3}}+ix_{j_{3}+r}\right) \nonumber\\
&  =\frac{1}{16}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq r}\lambda_{2j_{1}%
j_{2}j_{3}j_{4}}\left(  x_{j_{1}}x_{j_{2}}-ix_{j_{1}+r}x_{j_{2}}-ix_{j_{1}%
}x_{j_{2}+r}-x_{j_{1}+r}x_{j_{2}+r}\right) \nonumber\\
&  \times\left(  x_{j_{4}}x_{j_{3}}+ix_{j_{4}+r}x_{j_{3}}+ix_{j_{4}}%
x_{j_{3}+r}-x_{j_{4}+r}x_{j_{3}+r}\right) \\
&  =\frac{1}{16}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq r}\lambda_{2j_{1}%
j_{2}j_{3}j_{4}}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}}-ix_{j_{1}%
+r}x_{j_{2}}x_{j_{4}}x_{j_{3}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}%
}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}\right. \nonumber\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
+r}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}%
+r}x_{j_{4}+r}x_{j_{3}}\nonumber\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
}x_{j_{3}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}+r}-ix_{j_{1}+r}x_{j_{2}%
+r}x_{j_{4}}x_{j_{3}+r}\nonumber\\
&  \left.  -x_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}+ix_{j_{1}+r}x_{j_{2}%
}x_{j_{4}+r}x_{j_{3}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}%
+x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}\right\}  .
\end{align}
Let $r=4$ then
\begin{align}
\lambda_{2}  &  =\sum_{1\leq j_{1}<j_{2}\leq4;1\leq,j_{3}<j_{4}\leq4}%
\lambda_{2j_{1}j_{2}j_{3}j_{4}}a_{j_{1}}^{\dagger}a_{j_{2}}^{\dagger}a_{j_{4}%
}a_{j_{3}}\nonumber\\
&  =\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq4;1\leq,j_{3}<j_{4}\leq4}%
\lambda_{2j_{1}j_{2}j_{3}j_{4}}\left(  x_{j_{1}}-ix_{j_{1}+r}\right)  \left(
x_{j_{2}}-ix_{j_{2}+r}\right)  \left(  x_{j_{4}}+ix_{j_{4}+r}\right)  \left(
x_{j_{3}}+ix_{j_{3}+r}\right) \nonumber
\end{align}%
\begin{align}
&  =\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq4;1\leq,j_{3}<j_{4}\leq4}%
\lambda_{2j_{1}j_{2}j_{3}j_{4}}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}%
}-ix_{j_{1}+r}x_{j_{2}}x_{j_{4}}x_{j_{3}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{4}%
}x_{j_{3}}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}\right. \nonumber\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
+r}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}%
+r}x_{j_{4}+r}x_{j_{3}}\nonumber\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
}x_{j_{3}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}+r}-ix_{j_{1}+r}x_{j_{2}%
+r}x_{j_{4}}x_{j_{3}+r}\nonumber\\
&  \left.  -x_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}+ix_{j_{1}+r}x_{j_{2}%
}x_{j_{4}+r}x_{j_{3}+r}+ix_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}%
+x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}\right\}  .
\end{align}


\bigskip

$\lceil$Zero differences%
\begin{align}
&  =\frac{1}{4}\lambda_{21212}\left\{  x_{1}x_{2}x_{2}x_{1}-ix_{5}x_{2}%
x_{2}x_{1}-ix_{1}x_{6}x_{2}x_{1}-x_{5}x_{6}x_{2}x_{1}\right. \nonumber\\
&  +ix_{1}x_{2}x_{6}x_{1}+x_{5}x_{2}x_{6}x_{1}+x_{1}x_{6}x_{6}x_{1}%
-ix_{5}x_{6}x_{6}x_{1}\nonumber\\
&  +ix_{1}x_{2}x_{2}x_{5}+x_{5}x_{2}x_{2}x_{5}+x_{1}x_{6}x_{2}x_{5}%
-ix_{5}x_{6}x_{2}x_{5}\nonumber\\
&  \left.  -x_{1}x_{2}x_{6}x_{5}+ix_{5}x_{2}x_{6}x_{5}+ix_{1}x_{6}x_{6}%
x_{5}+x_{5}x_{6}x_{6}x_{5}\right\}  .
\end{align}
%

\begin{align}
&  =\frac{1}{4}\lambda_{21212}\left\{  \frac{1}{4}I_{\mathcal{F}}+i\frac{1}%
{2}x_{1}x_{5}+i\frac{1}{2}x_{2}x_{6}+x_{5}x_{2}x_{6}x_{1}\right. \nonumber\\
&  +i\frac{1}{2}x_{2}x_{6}+x_{5}x_{2}x_{6}x_{1}+\frac{1}{4}I_{\mathcal{F}%
}+i\frac{1}{2}x_{1}x_{5}\nonumber\\
&  +i\frac{1}{2}x_{1}x_{5}+\frac{1}{4}I_{\mathcal{F}}+x_{5}x_{2}x_{6}%
x_{1}+i\frac{1}{2}x_{2}x_{6}\nonumber\\
&  +\left.  x_{5}x_{2}x_{1}x_{6}+i\frac{1}{2}x_{2}x_{6}+i\frac{1}{2}x_{1}%
x_{5}+\frac{1}{4}I_{\mathcal{F}}\right\}  .
\end{align}%
\begin{equation}
=\lambda_{21212}\left\{  \frac{1}{4}I_{\mathcal{F}}+\frac{i}{2}x_{1}%
x_{5}+\frac{i}{2}ix_{2}x_{6}+x_{1}x_{2}x_{5}x_{6}\right\}
\end{equation}


\bigskip One difference%

\begin{align}
&  =\frac{1}{4}\lambda_{21213}\left\{  x_{1}x_{2}x_{3}x_{1}-ix_{5}x_{2}%
x_{3}x_{1}-ix_{1}x_{6}x_{3}x_{1}-x_{5}x_{6}x_{3}x_{1}\right. \nonumber\\
&  +ix_{1}x_{2}x_{7}x_{1}+x_{5}x_{2}x_{7}x_{1}+x_{1}x_{6}x_{7}x_{1}%
-ix_{5}x_{6}x_{7}x_{1}\nonumber\\
&  +ix_{1}x_{2}x_{3}x_{5}+x_{5}x_{2}x_{3}x_{5}+x_{1}x_{6}x_{3}x_{5}%
-ix_{5}x_{6}x_{3}x_{5}\nonumber\\
&  \left.  -x_{1}x_{2}x_{7}x_{5}+ix_{5}x_{2}x_{7}x_{5}+ix_{1}x_{6}x_{7}%
x_{5}+x_{5}x_{6}x_{7}x_{5}\right\}  .
\end{align}
%

\begin{align}
&  =\frac{1}{4}\lambda_{21213}\left\{  \frac{1}{2}x_{2}x_{3}-ix_{5}x_{2}%
x_{3}x_{1}-i\frac{1}{2}x_{6}x_{3}-x_{5}x_{6}x_{3}x_{1}\right. \nonumber\\
&  +i\frac{1}{2}x_{2}x_{7}+x_{5}x_{2}x_{7}x_{1}+\frac{1}{2}x_{6}x_{7}%
-ix_{5}x_{6}x_{7}x_{1}\nonumber\\
&  +ix_{1}x_{2}x_{3}x_{5}+\frac{1}{2}x_{2}x_{3}+x_{1}x_{6}x_{3}x_{5}-i\frac
{1}{2}x_{6}x_{3}\nonumber\\
&  \left.  -x_{1}x_{2}x_{7}x_{5}+i\frac{1}{2}x_{2}x_{7}+ix_{1}x_{6}x_{7}%
x_{5}+\frac{1}{2}x_{6}x_{7}\right\}  .
\end{align}
%

\begin{align}
&  =\frac{1}{4}\lambda_{21213}\left\{  x_{2}x_{3}+x_{6}x_{7}+2x_{1}x_{3}%
x_{5}x_{6}+2x_{1}x_{2}x_{5}x_{7}+ix_{3}x_{6}\right. \nonumber\\
&  +ix_{2}x_{7}-ix_{1}x_{2}x_{3}x_{5}-ix_{1}x_{5}x_{6}x_{7}+ix_{1}x_{2}%
x_{3}x_{5}+\left.  ix_{1}x_{5}x_{6}x_{7}\right\}  .\nonumber
\end{align}


\bigskip Two differences%

\begin{align}
&  =\frac{1}{4}\lambda_{21243}\left\{  x_{1}x_{2}x_{3}x_{4}-ix_{5}x_{2}%
x_{3}x_{4}-ix_{1}x_{6}x_{3}x_{4}-x_{5}x_{6}x_{3}x_{4}\right. \nonumber\\
&  +ix_{1}x_{2}x_{8}x_{3}+x_{5}x_{2}x_{8}x_{3}+x_{1}x_{6}x_{8}x_{3}%
-ix_{5}x_{6}x_{8}x_{3}\nonumber\\
&  +ix_{1}x_{2}x_{4}x_{8}+x_{5}x_{2}x_{4}x_{8}+x_{1}x_{6}x_{4}x_{8}%
-ix_{5}x_{6}x_{4}x_{8}\nonumber\\
&  \left.  -x_{1}x_{2}x_{7}x_{8}+ix_{5}x_{2}x_{7}x_{8}+ix_{1}x_{6}x_{7}%
x_{8}+x_{5}x_{6}x_{7}x_{8}\right\}  .
\end{align}
%

\begin{align}
&  =\frac{1}{4}\lambda_{21243}\left\{  x_{1}x_{2}x_{3}x_{4}-x_{3}x_{4}%
x_{5}x_{6}-x_{2}x_{3}x_{5}x_{8}+x_{1}x_{3}x_{6}x_{8}\right. \nonumber\\
&  +x_{2}x_{4}x_{5}x_{8}-x_{1}x_{4}x_{6}x_{8}-x_{1}x_{2}x_{7}x_{8}+x_{5}%
x_{6}x_{7}x_{8}\nonumber\\
&  +ix_{2}x_{3}x_{4}x_{5}-ix_{1}x_{3}x_{4}x_{6}-ix_{1}x_{2}x_{3}x_{8}%
+ix_{3}x_{5}x_{6}x_{8}\\
&  +ix_{1}x_{2}x_{4}x_{8}-ix_{4}x_{5}x_{6}x_{8}\left.  -ix_{2}x_{5}x_{7}%
x_{8}+ix_{1}x_{6}x_{7}x_{8}\right\}  .\nonumber
\end{align}
$\rfloor$

The zeroth degree terms are%
\begin{align}
&  \frac{1}{16}\sum_{1\leq j_{1},j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{2}}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{2}%
+r}x_{j_{1}}+x_{j_{1}+r}x_{j_{2}}x_{j_{2}}x_{j_{1}+r}+x_{j_{1}+r}x_{j_{2}%
+r}x_{j_{2}+r}x_{j_{1}+r}\right\} \nonumber\\
&  =\frac{1}{4}\sum_{1\leq j_{1}<j_{2}\leq r}\lambda_{2j_{1}j_{2}j_{1}j_{2}%
}I_{\mathcal{F}}=\frac{1}{4}\operatorname*{Tr}\left\{  \lambda_{2}\right\}
I_{\mathcal{F}}.
\end{align}


The second degree terms are after setting $j_{3}=j_{1},j_{3}=j_{2},j_{4}%
=j_{1},$ and $j_{4}=j_{2},$ then $j_{4}=j_{3}$ and interchanging $j_{1}$ and
$j_{2}$ (in the following sums we can consider $\left(  j_{2},j_{2}+r\right)
$ but not $\left(  j_{2},j_{2}\right)  )$
\begin{align*}
&  \frac{1}{16}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{3}}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{1}}+x_{j_{1}%
}x_{j_{2}}x_{j_{3}}x_{j_{1}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{3}}x_{j_{1}}\right. \\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{3}+r}x_{j_{1}}+x_{j_{1}}x_{j_{2}+r}x_{j_{3}%
+r}x_{j_{1}}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{3}}x_{j_{1}+r}\\
+  &  \left.  ix_{j_{1}+r}x_{j_{2}}x_{j_{3}+r}x_{j_{1}+r}+x_{j_{1}+r}%
x_{j_{2}+r}x_{j_{3}+r}x_{j_{1}+r}\right\}
\end{align*}%
\begin{align*}
-  &  \frac{1}{16}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{3}}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{1}}x_{j_{3}}-ix_{j_{1}%
}x_{j_{2}+r}x_{j_{1}}x_{j_{3}}\right. \\
&  +x_{j_{1}+r}x_{j_{2}}x_{j_{1}+r}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}+r}%
x_{j_{1}+r}x_{j_{3}}\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{1}}x_{j_{3}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{1}%
}x_{j_{3}+r}\\
&  +\left.  ix_{j_{1}+r}x_{j_{2}}x_{j_{1}+r}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}%
+r}x_{j_{1}+r}x_{j_{3}+r}\right\}
\end{align*}%
\begin{align*}
-  &  \frac{1}{16}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{3}}\left\{  x_{j_{2}}x_{j_{1}}x_{j_{3}}x_{j_{2}}-ix_{j_{2}%
+r}x_{j_{1}}x_{j_{3}}x_{j_{1}}\right. \\
&  +ix_{j_{1}}x_{j_{1}}x_{j_{3}+r}x_{j_{1}}+x_{j_{2}+r}x_{j_{1}}x_{j_{3}%
+r}x_{j_{1}}\\
&  +x_{j_{2}}x_{j_{1}+r}x_{j_{3}}x_{j_{1}+r}-ix_{j_{2}+r}x_{j_{1}+r}x_{j_{3}%
}x_{j_{1}+r}\\
&  +\left.  ix_{j_{2}}x_{j_{1}+r}x_{j_{3}+r}x_{j_{1}+r}+x_{j_{2}+r}x_{j_{1}%
+r}x_{j_{3}+r}x_{j_{1}+r}\right\}
\end{align*}%
\begin{align*}
+  &  \frac{1}{16}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{3}}\left\{  x_{j_{2}}x_{j_{1}}x_{j_{1}}x_{j_{3}}-ix_{j_{2}%
+r}x_{j_{1}}x_{j_{1}}x_{j_{3}}\right. \\
&  +x_{j_{2}}x_{j_{1}+r}x_{j_{1}+r}x_{j_{3}}-ix_{j_{2}+r}x_{j_{1}+r}%
x_{j_{1}+r}x_{j_{3}}\\
&  +ix_{j_{2}}x_{j_{1}}x_{j_{1}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{1}}x_{j_{1}%
}x_{j_{3}+r}\\
&  +\left.  ix_{j_{2}}x_{j_{1}+r}x_{j_{1}+r}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{1}%
+r}x_{j_{1}+r}x_{j_{3}+r}\right\}
\end{align*}%
\begin{align*}
=  &  \frac{1}{32}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{3}}\left\{  x_{j_{2}}x_{j_{3}}-ix_{j_{2}+r}x_{j_{3}}\right. \\
&  +ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{3}+r}-ix_{j_{2}+r}x_{j_{3}}+\left.
ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{3}+r}\right\}
\end{align*}%
\begin{align*}
&  +\frac{1}{32}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\lambda_{2j_{1}%
j_{2}j_{1}j_{3}}\left\{  x_{j_{2}}x_{j_{3}}-ix_{j_{2}+r}x_{j_{3}}\right. \\
&  +x_{j_{2}}x_{j_{3}}-ix_{j_{2}+r}x_{j_{3}}+ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}%
+r}x_{j_{3}+r}+\left.  ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{3}+r}\right\}
\end{align*}%
\begin{align*}
+  &  \frac{1}{32}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\left\{  x_{j_{2}%
}x_{j_{3}}-ix_{j_{2}+r}x_{j_{3}}\right. \\
&  +ix_{j_{1}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{3}+r}+x_{j_{2}}x_{j_{3}}%
-ix_{j_{2}+r}x_{j_{3}}+\left.  ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{3}%
+r}\right\}
\end{align*}%
\begin{align*}
+  &  \frac{1}{32}\sum_{1\leq j_{1},j_{2}\neq j_{3}\leq r}\left\{  x_{j_{2}%
}x_{j_{3}}-ix_{j_{2}+r}x_{j_{3}}\right. \\
&  +x_{j_{2}}x_{j_{3}}-ix_{j_{2}+r}x_{j_{3}}+ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}%
+r}x_{j_{3}+r}+\left.  ix_{j_{2}}x_{j_{3}+r}+x_{j_{2}+r}x_{j_{3}+r}\right\}
\end{align*}%
\[
=\frac{1}{4}\sum_{1\leq j_{2}\neq j_{3}\leq r}L_{2}^{1}\left(  \lambda
_{2}\right)  _{j_{2}j_{3}}\left\{  x_{j_{2}}x_{j_{3}}+x_{j_{2}+r}x_{j_{3}%
+r}+ix_{j_{3}}x_{j_{2}+r}+ix_{j_{2}}x_{j_{3}+r}\right\}
\]
as the products are antisymmetric this gives that the second degree terms are
\begin{equation}
\frac{1}{2}\sum_{1\leq j_{2}<j_{3}\leq r}\left(  L_{2}^{1}\left(  \lambda
_{2}\right)  _{j_{2}j_{3}}-L_{2}^{1}\left(  \lambda_{2}\right)  _{j_{3}j_{2}%
}\right)  \left\{  x_{j_{2}}x_{j_{3}}+x_{j_{2}+r}x_{j_{3}+r}+i\left(
x_{j_{3}}x_{j_{2}+r}+x_{j_{2}}x_{j_{3}+r}\right)  \right\}  .
\end{equation}
$\lceil$
\begin{equation}
\frac{1}{2}\left(  L_{2}^{1}\left(  \lambda_{2}\right)  _{12}-L_{2}^{1}\left(
\lambda_{2}\right)  _{21}\right)  \left\{  x_{1}x_{2}+x_{3}x_{4}+i\left(
x_{2}x_{3}+x_{2}x_{4}\right)  \right\}
\end{equation}
$\rfloor$

The fourth degree terms are
\begin{align*}
&  \frac{1}{16}\sum_{1\leq j_{1}\neq j_{2}\neq j_{3}\neq j_{4}\leq r}%
\lambda_{2j_{1}j_{2}j_{3}j_{4}}\left\{  x_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}%
}-x_{j_{1}+r}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
+r}x_{j_{3}}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}\right. \\
&  -x_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}}x_{j_{4}%
}x_{j_{3}+r}+x_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}+r}+x_{j_{1}+r}x_{j_{2}%
+r}x_{j_{4}+r}x_{j_{3}+r}\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}+r}x_{j_{3}}-ix_{j_{1}+r}x_{j_{2}}x_{j_{4}%
}x_{j_{3}}-ix_{j_{1}}x_{j_{2}+r}x_{j_{4}}x_{j_{3}}\\
&  +ix_{j_{1}}x_{j_{2}}x_{j_{4}}x_{j_{3}+r}-ix_{j_{1}+r}x_{j_{2}+r}x_{j_{4}%
}x_{j_{3}+r}+\left.  ix_{j_{1}}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}+r}-ix_{j_{1}%
+r}x_{j_{2}+r}x_{j_{4}+r}x_{j_{3}}+ix_{j_{1}+r}x_{j_{2}}x_{j_{4}+r}x_{j_{3}%
+r}\right\}  .
\end{align*}


\subsubsection{Contraction}

The contraction of any operator is zero e.g.%
\begin{align}
L_{1}^{0}\left(  \sum_{1\leq j_{1}<j_{2}\leq2r}\alpha_{2j_{1}j_{2}}x_{j_{1}%
}x_{j_{2}}\right)   &  =0\\
L_{2}^{0}\left(  \frac{1}{24}\sum_{1\leq j_{1},j_{2},j_{3},j_{4}\leq2r}%
\alpha_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}\right)   &
=0.
\end{align}


\subsubsection{General Even Fourth Degree Operators}

Two particle operators are a special form of \emph{even }fourth degree
operators, which are fourth degree polynomials in the generators of the
Clifford algebra
\begin{equation}
A_{2}=\alpha_{0}I_{\mathcal{F}}+\sum_{1\leq j_{1}<j_{2}\leq2r}\alpha
_{2j_{1}j_{2}}x_{j_{1}}x_{j_{2}}+\sum_{1\leq j_{1}<j_{2}<j_{3}\leq2r}%
\alpha_{4j_{1}j_{2}j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}}x_{j_{4}}.
\end{equation}
The square of such operators is
\begin{align}
\left(  A_{2}\right)  ^{2}  &  =\left(  A_{20}+A_{22}+A_{24}\right)
^{2}=\left(  A_{20}+A_{22}+A_{24}\right)  \left(  A_{20}+A_{22}+A_{24}\right)
\\
&  =A_{20}A_{20}+A_{20}A_{22}+A_{20}A_{24}+A_{22}A_{20}+A_{22}A_{22}%
+A_{22}A_{24}+A_{24}A_{20}+A_{24}A_{22}+A_{24}A_{24}\\
&  =\alpha_{0}^{2}I_{\mathcal{F}}+2\alpha_{0}A_{22}+2\alpha_{0}A_{24}%
+A_{22}A_{22}+A_{22}A_{24}+A_{24}A_{22}+A_{24}A_{24}.
\end{align}


\bigskip%
\begin{align}
\left(  A_{20}\right)  ^{2}  &  =\alpha_{0}^{2}I_{\mathcal{F}}\\
A_{20}A_{22}  &  =\alpha_{0}A_{22}\\
A_{20}A_{24}  &  =\alpha_{0}A_{24}%
\end{align}


\bigskip%

\begin{equation}
A_{22}A_{22}=\sum_{\substack{1\leq j_{1}<j_{2}\leq2r\\1\leq j_{3}<j_{4}\leq
2r}}\alpha_{2j_{1}j_{2}}\alpha_{2j_{3}j_{4}}x_{j_{1}}x_{j_{2}}x_{j_{3}%
}x_{j_{4}}%
\end{equation}
$\lceil$In the case $r=2$ one has
\begin{align}
&  \alpha_{212}\alpha_{212}x_{1}x_{2}x_{1}x_{2}+\alpha_{212}\alpha_{213}%
x_{1}x_{2}x_{1}x_{3}+\alpha_{212}\alpha_{214}x_{1}x_{2}x_{1}x_{4}\nonumber\\
&  +\alpha_{212}\alpha_{223}x_{1}x_{2}x_{2}x_{3}+\alpha_{212}\alpha_{224}%
x_{1}x_{2}x_{2}x_{4}+\alpha_{212}\alpha_{234}x_{1}x_{2}x_{3}x_{4}\nonumber\\
&  +\alpha_{213}\alpha_{212}x_{1}x_{3}x_{1}x_{2}+\alpha_{213}\alpha_{213}%
x_{1}x_{3}x_{1}x_{3}+\alpha_{213}\alpha_{214}x_{1}x_{3}x_{1}x_{4}\nonumber\\
&  +\alpha_{213}\alpha_{223}x_{1}x_{3}x_{2}x_{3}+\alpha_{213}\alpha_{224}%
x_{1}x_{3}x_{2}x_{4}+\alpha_{213}\alpha_{234}x_{1}x_{3}x_{3}x_{4}\nonumber\\
&  +\alpha_{214}\alpha_{212}x_{1}x_{4}x_{1}x_{2}+\alpha_{214}\alpha_{213}%
x_{1}x_{4}x_{1}x_{3}+\alpha_{214}\alpha_{214}x_{1}x_{4}x_{1}x_{4}\nonumber\\
